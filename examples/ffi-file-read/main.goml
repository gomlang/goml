package main;

use std::bytes;
use std::ffi;
use std::utf8;
use utf8::BytesUtf8;

#[go_type("os", "File")]
extern type File;

#[go_ffi("os", "Open")]
extern fn open(name: ffi::String) -> (ffi::Ptr[File], ffi::Error);

#[go_ffi("io", "ReadFull")]
extern fn read_full(file: ffi::Ptr[File], buffer: ffi::RawSlice[byte]) -> (isize, ffi::Error);

#[go_method("Read")]
extern fn read(file: ffi::Ptr[File], buffer: ffi::RawSlice[byte]) -> (isize, ffi::Error);

#[go_method("Close")]
extern fn close(file: ffi::Ptr[File]) -> ffi::Error;

#[go_ffi("example.com/goml-file-read/shim", "EchoFile")]
extern fn echo_file(file: ffi::Ptr[File]) -> ffi::Ptr[File];

#[go_ffi("example.com/goml-file-read/shim", "EchoRead")]
extern fn echo_read(count: isize, error: ffi::Error) -> (isize, ffi::Error);

#[go_ffi("example.com/goml-file-read/shim", "IsPartialRead")]
extern fn is_partial_read(count: isize, error: ffi::Error) -> bool;

fn main() -> () {
    let (file, error) = open(ffi::string_from_text("data.txt"));
    if let Some(error) = ffi::NonNilError::from_error(error) {
        println("open failed: " + error.message().unwrap_or("non-UTF-8 error"));
        return
    }
    let alias = echo_file(file);
    let buffer: Vec[byte] = Vec::from_array([0, 0, 0, 0]);
    let shared = ffi::slice_shared(buffer);
    let (count, error) = read_full(file, shared);
    let outcome = ffi::Outcome::new(count, error);
    let close_error = close(alias);
    let data = bytes::Bytes::from_vec(ffi::slice_to_vec_copy(mut_slice(buffer, 0, outcome.value)));
    println("read: " + outcome.value.to_string());
    match data.to_string_utf8() {
        Ok(text) => println("partial data: " + text),
        Err(_) => println("partial data is not UTF-8"),
    }
    let (count, error) = outcome.into_tuple();
    let (count, error) = echo_read(count, error);
    println("Go round-trip preserved partial read: " + is_partial_read(count, error).to_string());
    if let Some(error) = ffi::NonNilError::from_error(error) {
        println("read error: " + error.message().unwrap_or("non-UTF-8 error"));
    }
    println("explicit close succeeded: " + ffi::error_is_nil(close_error).to_string());
    let (count, error) = read(file, shared);
    println("original handle is closed: " + (count == 0 && !ffi::error_is_nil(error)).to_string());
}
