{
  "version": 1,
  "backend": "dynamic",
  "libraries": ["libLLVM-18.so"],
  "package": "llvm",
  "output": "llvm/generated.gom",
  "go_package": "native",
  "go_output": "native/generated.go",
  "headers": ["llvm-c/Core.h", "llvm-c/Analysis.h"],
  "include_dirs": ["/usr/lib/llvm-18/include"],
  "types": [
    {"name": "Context", "c_type": "LLVMContextRef"},
    {"name": "Module", "c_type": "LLVMModuleRef"},
    {"name": "Type", "c_type": "LLVMTypeRef"},
    {"name": "TypeArray", "c_type": "LLVMTypeRef *"},
    {"name": "Value", "c_type": "LLVMValueRef"},
    {"name": "Block", "c_type": "LLVMBasicBlockRef"},
    {"name": "Builder", "c_type": "LLVMBuilderRef"}
  ],
  "constants": [{"name": "RETURN_STATUS", "symbol": "LLVMReturnStatusAction"}],
  "functions": [
    {"name": "context_create", "symbol": "LLVMContextCreate"},
    {"name": "context_dispose", "symbol": "LLVMContextDispose"},
    {"name": "module_create", "symbol": "LLVMModuleCreateWithNameInContext", "parameters": [{"name": "name", "kind": "cstring"}, {"name": "context"}]},
    {"name": "module_dispose", "symbol": "LLVMDisposeModule"},
    {"name": "int32_type", "symbol": "LLVMInt32TypeInContext"},
    {"name": "function_type", "symbol": "LLVMFunctionType"},
    {"name": "add_function", "symbol": "LLVMAddFunction", "parameters": [{"name": "module_value"}, {"name": "name", "kind": "cstring"}, {"name": "function_type"}]},
    {"name": "append_block", "symbol": "LLVMAppendBasicBlockInContext", "parameters": [{"name": "context"}, {"name": "function"}, {"name": "name", "kind": "cstring"}]},
    {"name": "builder_create", "symbol": "LLVMCreateBuilderInContext"},
    {"name": "builder_dispose", "symbol": "LLVMDisposeBuilder"},
    {"name": "position_at_end", "symbol": "LLVMPositionBuilderAtEnd"},
    {"name": "constant_int", "symbol": "LLVMConstInt"},
    {"name": "build_return", "symbol": "LLVMBuildRet"},
    {"name": "verify", "symbol": "LLVMVerifyModule", "parameters": [{"name": "module_value"}, {"name": "action"}, {"name": "message", "kind": "out_string", "release": "LLVMDisposeMessage"}]},
    {"name": "print_module", "symbol": "LLVMPrintModuleToString", "return": {"kind": "cstring", "release": "LLVMDisposeMessage"}}
  ]
}
