#[go_ffi("example.com/c-llvm-example/native", "GomlC_verify")]
extern fn goml_c_verify(a0: GomlCModule, a1: i64) -> (i32, ffi::String, bool, ffi::Error);

pub fn verify(module_value: Module, action: i64) -> Result[(i32, Option[c::CString]), c::Error] {
    let (r0, r1, r2, error) = goml_c_verify(module_value.raw, action);
    c::check_error(error)?;
    Result::Ok(
        (
            r0,
            if r2 {
                Option::Some(c::CString::from_raw(r1)?)
            } else {
                Option::None
            },
        ),
    )
}

#[go_ffi("example.com/c-llvm-example/native", "GomlC_print_module")]
extern fn goml_c_print_module(a0: GomlCModule) -> (ffi::String, bool, ffi::Error);

pub fn print_module(arg0: Module) -> Result[Option[c::CString], c::Error] {
    let (r0, r1, error) = goml_c_print_module(arg0.raw);
    c::check_error(error)?;
    Result::Ok(
        if r1 {
            Option::Some(c::CString::from_raw(r0)?)
        } else {
            Option::None
        },
    )
}

pub const RETURN_STATUS: i32 = 2;
