#[go_type("example.com/c-llvm-example/native", "Context")]
extern type GomlCContext;

pub struct Context {
    raw: GomlCContext,
}

#[go_ffi("example.com/c-llvm-example/native", "GomlC_NullContext")]
extern fn goml_c_null_Context() -> GomlCContext;

#[go_ffi("example.com/c-llvm-example/native", "GomlC_IsNullContext")]
extern fn goml_c_is_null_Context(value: GomlCContext) -> bool;

#[go_ffi("example.com/c-llvm-example/native", "GomlC_EqualContext")]
extern fn goml_c_equal_Context(left: GomlCContext, right: GomlCContext) -> bool;

impl Context {
    pub fn null() -> Context {
        Context { raw: goml_c_null_Context() }
    }

    pub fn is_null(self: Context) -> bool {
        goml_c_is_null_Context(self.raw)
    }

    pub fn same_as(self: Context, other: Context) -> bool {
        goml_c_equal_Context(self.raw, other.raw)
    }
}

