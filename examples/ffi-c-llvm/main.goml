package main;

use module::llvm;
use std::c;
use std::testing;

const NAME: string = c::literal("answer");

fn ok[T, E](value: Result[T, E]) -> T {
    testing::expect_ok(value, "LLVM operation")
}

fn build_ir() -> string {
    let context = ok(llvm::context_create());
    defer {
        let _ = llvm::context_dispose(context);
    };
    let module_value = ok(llvm::module_create(ok(c::CString::new(NAME)), context));
    defer {
        let _ = llvm::module_dispose(module_value);
    };
    let integer = ok(llvm::int32_type(context));
    let signature = ok(llvm::function_type(integer, llvm::TypeArray::null(), 0, 0));
    let function = ok(llvm::add_function(module_value, ok(c::CString::new(NAME)), signature));
    let block = ok(llvm::append_block(context, function, ok(c::CString::new("entry"))));
    let builder = ok(llvm::builder_create(context));
    defer {
        let _ = llvm::builder_dispose(builder);
    };
    ok(llvm::position_at_end(builder, block));
    let value = ok(llvm::constant_int(integer, 42, 0));
    let _ = ok(llvm::build_return(builder, value));
    let (status, message) = ok(llvm::verify(module_value, llvm::RETURN_STATUS.to_i64()));
    testing::assert_eq(status, 0);
    ok(testing::expect_some(ok(llvm::print_module(module_value)), "module IR").text())
}

fn main() -> () {
    println(build_ir());
}
