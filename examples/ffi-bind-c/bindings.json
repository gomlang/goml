{
  "version": 1,
  "package": "bindings",
  "output": "bindings/generated.gom",
  "go_package": "native",
  "go_output": "native/generated.go",
  "headers": ["sample.h"],
  "types": [{"name": "Counter", "c_type": "SampleCounter"}],
  "constants": [{"name": "sample_mask", "symbol": "SAMPLE_MASK"}],
  "functions": [
    {"name": "signed", "symbol": "sample_signed"},
    {"name": "unsigned", "symbol": "sample_unsigned"},
    {"name": "floating", "symbol": "sample_float"},
    {"name": "boolean", "symbol": "sample_bool"},
    {"name": "mode", "symbol": "sample_mode"},
    {"name": "create", "symbol": "sample_create", "parameters": [{"name": "initial"}]},
    {"name": "destroy", "symbol": "sample_destroy"},
    {"name": "read", "symbol": "sample_read"},
    {"name": "open", "symbol": "sample_open", "parameters": [{"name": "counter", "kind": "out", "type": "Counter"}]},
    {"name": "divide", "symbol": "sample_divide", "parameters": [{"name": "number"}, {"name": "quotient", "kind": "out"}, {"name": "remainder", "kind": "out"}]},
    {"name": "invert", "symbol": "sample_invert", "parameters": [{"name": "data", "kind": "inout_bytes"}, {"name": "size", "kind": "length", "of": "data"}]},
    {"name": "sum", "symbol": "sample_sum", "parameters": [{"name": "data", "kind": "bytes"}, {"name": "size", "kind": "length", "of": "data"}]},
    {"name": "greet", "symbol": "sample_greet", "parameters": [{"name": "name", "kind": "cstring"}], "return": {"kind": "cstring", "release": "sample_free"}},
    {"name": "null_text", "symbol": "sample_null_text", "return": {"kind": "cstring"}},
    {"name": "raw_text", "symbol": "sample_raw_text", "return": {"kind": "cstring"}},
    {"name": "long_text", "symbol": "sample_long_text", "return": {"kind": "cstring", "release": "sample_free", "max_bytes": 2}},
    {"name": "out_text", "symbol": "sample_out_text", "parameters": [{"name": "text", "kind": "out_string", "release": "sample_free"}]},
    {"name": "two_texts", "symbol": "sample_two_texts", "parameters": [{"name": "text", "kind": "out_string", "release": "sample_free", "max_bytes": 2}], "return": {"kind": "cstring", "release": "sample_free"}},
    {"name": "allocations", "symbol": "sample_allocations"}
  ]
}
