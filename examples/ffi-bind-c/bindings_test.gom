package main;

use module::bindings;
use std::bytes::{Bytes};
use std::c;
use std::testing;

#[test]
fn scalar_widths_and_enum_bounds() -> () {
    testing::assert_eq(ok(bindings::signed(-9223372036854775808)), -9223372036854775808);
    testing::assert_eq(ok(bindings::unsigned(18446744073709551615)), 18446744073709551615);
    testing::assert_eq(ok(bindings::floating(1.25)), 1.25);
    testing::assert(ok(bindings::boolean(true)));
    testing::assert(!ok(bindings::boolean(false)));
    testing::assert_eq(ok(bindings::mode(1)), 1);
    testing::assert(bindings::mode(1099511627776).is_err());
}

#[test]
fn handles_and_out_parameters() -> () {
    testing::assert(bindings::Counter::null().is_null());
    let (status, counter) = ok(bindings::open());
    testing::assert_eq(status, 0);
    testing::assert(!counter.is_null());
    defer {
        let _ = bindings::destroy(counter);
    };
    testing::assert(counter.same_as(counter));
    testing::assert_eq(ok(bindings::read(counter)), 42);
    testing::assert(ok(bindings::divide(11)) == (3, 2));
}

#[test]
fn copied_strings_and_release_on_error() -> () {
    testing::assert(c::CString::from_bytes(Bytes::from_vec(Vec::from_array([65, 0, 66]))).is_err());
    testing::assert_eq(ok(some(ok(bindings::greet(ok(c::CString::new("hello"))))).text()), "hello");
    testing::assert(ok(bindings::null_text()).is_none());
    let raw = some(ok(bindings::raw_text()));
    testing::assert(raw.text().is_err());
    testing::assert(raw.bytes().to_vec() == Vec::from_array([255]));
    testing::assert(bindings::long_text().is_err());
    testing::assert(bindings::two_texts().is_err());
    testing::assert_eq(ok(some(ok(bindings::greet(ok(c::CString::new(""))))).text()), "");
    let (status, output) = ok(bindings::out_text());
    testing::assert_eq(status, 7);
    testing::assert_eq(ok(some(output).text()), "output");
    testing::assert_eq(ok(bindings::allocations()), 0);
}

#[test]
fn copied_buffers_and_checked_lengths() -> () {
    let original = Bytes::from_vec(Vec::from_array([0, 1, 255]));
    testing::assert_eq(ok(bindings::sum(original)), 256);
    testing::assert(ok(bindings::invert(original)).to_vec() == Vec::from_array([255, 254, 0]));
    testing::assert(original.to_vec() == Vec::from_array([0, 1, 255]));
    let empty = Bytes::from_vec(Vec::new());
    testing::assert_eq(ok(bindings::sum(empty)), 0);
    testing::assert_eq(ok(bindings::invert(empty)).len(), 0);
    let large: Vec[u8] = Vec::new();
    for index in 0..256 {
        large.push(1);
    }
    testing::assert(bindings::sum(Bytes::from_vec(large)).is_err());
    testing::assert_eq(LOWER_MASK, 255);
}
