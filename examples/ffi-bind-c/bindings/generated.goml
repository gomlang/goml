package bindings;

use std::ffi;
use std::c;
use std::bytes::{Bytes};

#[go_type("example.com/bind-c-example/native", "Counter")]
extern type GomlCCounter;

pub struct Counter {
    raw: GomlCCounter,
}

#[go_ffi("example.com/bind-c-example/native", "GomlC_NullCounter")]
extern fn goml_c_null_Counter() -> GomlCCounter;

#[go_ffi("example.com/bind-c-example/native", "GomlC_IsNullCounter")]
extern fn goml_c_is_null_Counter(value: GomlCCounter) -> bool;

#[go_ffi("example.com/bind-c-example/native", "GomlC_EqualCounter")]
extern fn goml_c_equal_Counter(left: GomlCCounter, right: GomlCCounter) -> bool;

impl Counter {
    pub fn null() -> Counter {
        Counter { raw: goml_c_null_Counter() }
    }

    pub fn is_null(self: Counter) -> bool {
        goml_c_is_null_Counter(self.raw)
    }

    pub fn same_as(self: Counter, other: Counter) -> bool {
        goml_c_equal_Counter(self.raw, other.raw)
    }
}

#[go_ffi("example.com/bind-c-example/native", "GomlC_signed")]
extern fn goml_c_signed(a0: i64) -> (i64, ffi::Error);

pub fn signed(arg0: i64) -> Result[i64, c::Error] {
    let (r0, error) = goml_c_signed(arg0);
    c::check_error(error)?;
    Result::Ok(r0)
}

