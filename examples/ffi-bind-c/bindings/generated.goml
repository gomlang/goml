#[go_ffi("example.com/bind-c-example/native", "GomlC_greet")]
extern fn goml_c_greet(a0: ffi::String) -> (ffi::String, bool, ffi::Error);

pub fn greet(name: c::CString) -> Result[Option[c::CString], c::Error] {
    let (r0, r1, error) = goml_c_greet(name.as_raw());
    c::check_error(error)?;
    Result::Ok(
        if r1 {
            Option::Some(c::CString::from_raw(r0)?)
        } else {
            Option::None
        },
    )
}

