#[go_ffi("example.com/bind-c-example/native", "GomlC_invert")]
extern fn goml_c_invert(a0: ffi::RawSlice[u8]) -> (ffi::RawSlice[u8], ffi::Error);

pub fn invert(data: Bytes) -> Result[Bytes, c::Error] {
    let (r0, error) = goml_c_invert(ffi::slice_from_vec_copy(data.to_vec()));
    c::check_error(error)?;
    Result::Ok(Bytes::from_vec(ffi::slice_to_vec_copy(r0)))
}

