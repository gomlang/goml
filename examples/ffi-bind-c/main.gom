package main;

use module::bindings;
use std::c;
use std::testing;

const GREETING: string = c::literal("GoML calls C");

const LOWER_MASK: u64 = bindings::sample_mask & 255;

fn ok[T, E](value: Result[T, E]) -> T {
    testing::expect_ok(value, "C operation")
}

fn some[T](value: Option[T]) -> T {
    testing::expect_some(value, "C string must be non-null")
}

fn main() -> () {
    let counter = ok(bindings::create(42));
    testing::assert(!counter.is_null());
    defer {
        let _ = bindings::destroy(counter);
    };
    println(ok(bindings::read(counter)));
    let greeting = some(ok(bindings::greet(ok(c::CString::new(GREETING)))));
    println(ok(greeting.text()));
    println(LOWER_MASK);
}
