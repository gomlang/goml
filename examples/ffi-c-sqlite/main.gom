package main;

use module::sqlite;
use std::c;
use std::testing;

const MEMORY: string = c::literal(":memory:");

const QUERY: string = c::literal("SELECT 6 * 7");

fn ok[T, E](value: Result[T, E]) -> T {
    testing::expect_ok(value, "SQLite operation")
}

fn query() -> i64 {
    let (status, database) = ok(sqlite::open(ok(c::CString::new(MEMORY))));
    testing::assert_eq(status, sqlite::OK);
    defer {
        let _ = sqlite::close(database);
    };
    let (status, statement, tail) = ok(sqlite::prepare(database, ok(c::CString::new(QUERY)), -1));
    testing::assert_eq(status, sqlite::OK);
    defer {
        let _ = sqlite::finalize(statement);
    };
    testing::assert_eq(ok(testing::expect_some(tail, "SQL tail").text()), "");
    testing::assert_eq(ok(sqlite::step(statement)), sqlite::ROW);
    ok(sqlite::column_int64(statement, 0))
}

fn main() -> () {
    println(query());
}
