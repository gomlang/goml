package sqlite;

use std::ffi;
use std::c;
use std::bytes::{Bytes};

#[go_type("example.com/c-sqlite-example/native", "Database")]
extern type GomlCDatabase;

pub struct Database {
    raw: GomlCDatabase,
}

#[go_ffi("example.com/c-sqlite-example/native", "GomlC_NullDatabase")]
extern fn goml_c_null_Database() -> GomlCDatabase;

#[go_ffi("example.com/c-sqlite-example/native", "GomlC_IsNullDatabase")]
extern fn goml_c_is_null_Database(value: GomlCDatabase) -> bool;

#[go_ffi("example.com/c-sqlite-example/native", "GomlC_EqualDatabase")]
extern fn goml_c_equal_Database(left: GomlCDatabase, right: GomlCDatabase) -> bool;

impl Database {
    pub fn null() -> Database {
        Database { raw: goml_c_null_Database() }
    }

    pub fn is_null(self: Database) -> bool {
        goml_c_is_null_Database(self.raw)
    }

    pub fn same_as(self: Database, other: Database) -> bool {
        goml_c_equal_Database(self.raw, other.raw)
    }
}

#[go_type("example.com/c-sqlite-example/native", "Statement")]
extern type GomlCStatement;

pub struct Statement {
    raw: GomlCStatement,
}

#[go_ffi("example.com/c-sqlite-example/native", "GomlC_NullStatement")]
extern fn goml_c_null_Statement() -> GomlCStatement;

#[go_ffi("example.com/c-sqlite-example/native", "GomlC_IsNullStatement")]
extern fn goml_c_is_null_Statement(value: GomlCStatement) -> bool;

#[go_ffi("example.com/c-sqlite-example/native", "GomlC_EqualStatement")]
extern fn goml_c_equal_Statement(left: GomlCStatement, right: GomlCStatement) -> bool;

impl Statement {
    pub fn null() -> Statement {
        Statement { raw: goml_c_null_Statement() }
    }

    pub fn is_null(self: Statement) -> bool {
        goml_c_is_null_Statement(self.raw)
    }

    pub fn same_as(self: Statement, other: Statement) -> bool {
        goml_c_equal_Statement(self.raw, other.raw)
    }
}

#[go_ffi("example.com/c-sqlite-example/native", "GomlC_open")]
extern fn goml_c_open(a0: ffi::String) -> (i32, GomlCDatabase, ffi::Error);

pub fn open(filename: c::CString) -> Result[(i32, Database), c::Error] {
    let (r0, r1, error) = goml_c_open(filename.as_raw());
    c::check_error(error)?;
    Result::Ok((r0, Database { raw: r1 }))
}

#[go_ffi("example.com/c-sqlite-example/native", "GomlC_close")]
extern fn goml_c_close(a0: GomlCDatabase) -> (i32, ffi::Error);

pub fn close(arg0: Database) -> Result[i32, c::Error] {
    let (r0, error) = goml_c_close(arg0.raw);
    c::check_error(error)?;
    Result::Ok(r0)
}

#[go_ffi("example.com/c-sqlite-example/native", "GomlC_prepare")]
extern fn goml_c_prepare(a0: GomlCDatabase, a1: ffi::String, a2: i32) -> (
    i32,
    GomlCStatement,
    ffi::String,
    bool,
    ffi::Error,
);

pub fn prepare(database: Database, sql: c::CString, length: i32) -> Result[
    (i32, Statement, Option[c::CString]),
    c::Error,
] {
    let (r0, r1, r2, r3, error) = goml_c_prepare(database.raw, sql.as_raw(), length);
    c::check_error(error)?;
    Result::Ok(
        (
            r0,
            Statement { raw: r1 },
            if r3 {
                Option::Some(c::CString::from_raw(r2)?)
            } else {
                Option::None
            },
        ),
    )
}

#[go_ffi("example.com/c-sqlite-example/native", "GomlC_step")]
extern fn goml_c_step(a0: GomlCStatement) -> (i32, ffi::Error);

pub fn step(arg0: Statement) -> Result[i32, c::Error] {
    let (r0, error) = goml_c_step(arg0.raw);
    c::check_error(error)?;
    Result::Ok(r0)
}

#[go_ffi("example.com/c-sqlite-example/native", "GomlC_column_int64")]
extern fn goml_c_column_int64(a0: GomlCStatement, a1: i32) -> (i64, ffi::Error);

pub fn column_int64(arg0: Statement, arg1: i32) -> Result[i64, c::Error] {
    let (r0, error) = goml_c_column_int64(arg0.raw, arg1);
    c::check_error(error)?;
    Result::Ok(r0)
}

#[go_ffi("example.com/c-sqlite-example/native", "GomlC_finalize")]
extern fn goml_c_finalize(a0: GomlCStatement) -> (i32, ffi::Error);

pub fn finalize(arg0: Statement) -> Result[i32, c::Error] {
    let (r0, error) = goml_c_finalize(arg0.raw);
    c::check_error(error)?;
    Result::Ok(r0)
}

#[go_ffi("example.com/c-sqlite-example/native", "GomlC_error_message")]
extern fn goml_c_error_message(a0: GomlCDatabase) -> (ffi::String, bool, ffi::Error);

pub fn error_message(arg0: Database) -> Result[Option[c::CString], c::Error] {
    let (r0, r1, error) = goml_c_error_message(arg0.raw);
    c::check_error(error)?;
    Result::Ok(
        if r1 {
            Option::Some(c::CString::from_raw(r0)?)
        } else {
            Option::None
        },
    )
}

pub const OK: i32 = 0;

pub const ROW: i32 = 100;
