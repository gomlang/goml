package main;

use std::ffi;

type Unary = (i64) -> i64;

type Factory = () -> ffi::Func[Unary];

#[go_ffi("example.com/goml-callback-bench/shim", "Run")]
extern fn run(callback: ffi::Func[Unary], roundtrip: ffi::Func[Unary], factory: ffi::Func[Factory]) -> ();

#[go_ffi("example.com/goml-callback-bench/shim", "Native")]
extern fn native() -> ffi::Func[Unary];

fn main() -> () {
    let offset: i64 = 7;
    let callback: Unary = |value| value + offset;
    let Some(back) = ffi::func_to_closure(native()) else {
        return
    };
    let factory: Factory = || ffi::func_from_closure(|value| value + offset);
    run(
        ffi::func_from_closure(callback),
        ffi::func_from_closure(back),
        ffi::func_from_closure(factory),
    )
}
