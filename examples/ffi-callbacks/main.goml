package main;

use std::ffi;

type Callback = (i64) -> i64;

#[go_type("example.com/goml-callbacks/shim", "Counter")]
extern type Counter;

#[go_type("example.com/goml-callbacks/shim", "Subscription")]
extern type Subscription;

#[go_type("example.com/goml-callbacks/shim", "Batch")]
extern type Batch;

#[go_ffi("example.com/goml-callbacks/shim", "NewCounter")]
extern fn new_counter() -> ffi::Ptr[Counter];

#[go_method("Add")]
extern fn add(counter: ffi::Ptr[Counter], value: i64) -> i64;

#[go_method("Value")]
extern fn value(counter: ffi::Ptr[Counter]) -> i64;

#[go_ffi("example.com/goml-callbacks/shim", "Register")]
extern fn register(callback: ffi::Func[Callback]) -> ffi::Ptr[Subscription];

#[go_method("Unregister")]
extern fn unregister(subscription: ffi::Ptr[Subscription]) -> ();

#[go_method("Start")]
extern fn start(subscription: ffi::Ptr[Subscription], count: i64, value: i64) -> ffi::Ptr[Batch];

#[go_method("Release")]
extern fn release(batch: ffi::Ptr[Batch]) -> ();

#[go_method("Wait")]
extern fn wait(batch: ffi::Ptr[Batch]) -> i64;

#[go_ffi("example.com/goml-callbacks/shim", "Active")]
extern fn active() -> i64;

#[go_ffi("example.com/goml-callbacks/shim", "Collect")]
extern fn collect() -> ();

#[go_ffi("example.com/goml-callbacks/shim", "Reenter")]
extern fn reenter(callback: ffi::Func[Callback], value: i64) -> i64;

fn retained(counter: ffi::Ptr[Counter], base: i64) -> ffi::Ptr[Subscription] {
    let callback: Callback = |x| add(counter, x + base);
    register(ffi::func_from_closure(callback))
}

fn bounce(depth: i64) -> i64 {
    if depth == 0 {
        0
    } else {
        reenter(ffi::func_from_closure(bounce), depth - 1) + 1
    }
}

fn dispatch(subscription: ffi::Ptr[Subscription], count: i64, value: i64) -> i64 {
    let batch = start(subscription, count, value);
    release(batch);
    wait(batch)
}

fn main() -> () {
    let counter = new_counter();
    let subscription = retained(counter, 7);
    let batch = start(subscription, 64, 2);
    collect();
    println("deferred until release: " + (value(counter) == 0).to_string());
    release(batch);
    println(
        "concurrent retained callbacks: " + (wait(batch) == 64 && value(counter) == 576).to_string(),
    );
    let queued = start(subscription, 64, 2);
    unregister(subscription);
    unregister(subscription);
    release(queued);
    println(
        "unregistered callbacks stopped: "
            + (wait(queued) == 0 && dispatch(subscription, 64, 2) == 0 && value(counter) == 576).to_string(),
    );
    println("recursive reentry: " + (bounce(32) == 32).to_string());
    let holder: Ref[ffi::Ptr[Subscription]] = Ref::new(ffi::null());
    let stop: Callback = |x| {
        unregister(holder.get());
        x
    };
    let self_stopping = register(ffi::func_from_closure(stop));
    holder.set(self_stopping);
    println(
        "callback can unregister itself: "
            + (dispatch(self_stopping, 1, 0) == 1 && dispatch(self_stopping, 1, 0) == 0).to_string(),
    );
    for _ in 0..128 {
        let current = retained(counter, 1);
        let _ = dispatch(current, 2, 0);
        unregister(current);
    }
    println("registration stress balanced: " + (active() == 0 && value(counter) == 832).to_string());
}
