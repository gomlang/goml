package build;

use module::util::{absolute_from_module, sha256_text};
use module::project::{CompilerWorld, Context, source_files};
use module::build_model::{Command};
use module::failure;
use failure::DriverResult;
use std::fs;
use std::path;
use std::text;
use module::build_model;

struct CacheSpec {
    kind: string,
    args: Vec[string],
    inputs: Vec[string],
    outputs: Vec[string],
    anchor: string,
}

struct DigestCache {
    values: HashMap[string, string],
}

fn digest_cache() -> DigestCache {
    DigestCache { values: HashMap::new() }
}

fn file_digest(module_dir: string, value: string) -> Result[string, failure::Failure] {
    fs::sha256_file(absolute_from_module(module_dir, value)).map_err(
        |message| failure::convert(message).context(f"failed to read cache input {value}"),
    )
}

fn cached_file_digest(cache: DigestCache, module_dir: string, value: string) -> Result[
    string,
    failure::Failure,
] {
    let absolute = absolute_from_module(module_dir, value);
    match cache.values[absolute] {
        Some(digest) => Ok(digest),
        None => {
            let digest = file_digest(module_dir, value)?;
            cache.values[absolute] = digest;
            Ok(digest)
        },
    }
}

fn installed_world_stamp(metadata: fs::Metadata) -> string {
    "goml-installed-world-v1:" + metadata.len().to_string() + ":"
        + metadata.modified_unix_nanoseconds().to_string()
        + "\n"
}

fn cached_input_digest(cache: DigestCache, context: Context, value: string) -> Result[
    string,
    failure::Failure,
] {
    if let CompilerWorld::Installed { path: world } = context.compiler_world {
        let absolute = absolute_from_module(context.graph.module_dir, value);
        if absolute == absolute_from_module(context.graph.module_dir, world) {
            let metadata = fs::metadata(absolute).map_err(
                |error| failure::convert(error).context(
                    f"failed to read installed compiler world {value}",
                ),
            )?;
            if !metadata.file_type().is_file() {
                return Result::Err(
                    failure::convert("installed compiler world is not a file: " + value),
                )
            }
            return Result::Ok(installed_world_stamp(metadata))
        }
    }
    cached_file_digest(cache, context.graph.module_dir, value)
}

fn invalidate_output_digests(cache: DigestCache, module_dir: string, outputs: Vec[string]) -> () {
    for output in outputs {
        let _ = cache.values.remove(absolute_from_module(module_dir, output));
    }
}

fn compiler_digest(context: Context) -> Result[string, failure::Failure] {
    if fs::is_file(context.compiler) {
        file_digest(context.graph.module_dir, context.compiler)
    } else {
        Ok(sha256_text(context.compiler))
    }
}

fn cache_spec(value: Command) -> CacheSpec {
    match value {
        Compile { subcommand, input_files, interface_files, output, world, .. } => {
            let inputs: Vec[string] = Vec::new();
            for input in input_files {
                inputs.push(input)
            }
            for input in interface_files {
                inputs.push(input)
            }
            if let Some(value) = world {
                inputs.push(value)
            }
            let outputs = Vec::from_array([path::with_extension(output, "interface")]);
            if let build_model::BUILD_SUBCOMMAND | build_model::TEST_BUILD_SUBCOMMAND = subcommand {
                outputs.push(path::with_extension(output, "core"))
            }
            CacheSpec { kind: subcommand, args: value.args().1, inputs, outputs, anchor: output }
        },
        ToolchainCompile { input_files, interface_files, output, counter_output, .. } => {
            let inputs: Vec[string] = Vec::new();
            for value in input_files {
                inputs.push(value)
            }
            for value in interface_files {
                inputs.push(value)
            }
            let outputs = Vec::from_array(
                [path::with_extension(output, "interface"), path::with_extension(output, "core")],
            );
            if let Some(value) = counter_output {
                outputs.push(value)
            }
            CacheSpec {
                kind: "toolchain-build",
                args: value.args().1,
                inputs,
                outputs,
                anchor: output,
            }
        },
        PackToolchainWorld { input_packages, source_files, counter_file, output } => {
            let inputs = Vec::from_array([counter_file]);
            for value in input_packages {
                inputs.push(path::with_extension(value, "interface"));
                inputs.push(path::with_extension(value, "core"))
            }
            for value in source_files {
                inputs.push(value)
            }
            CacheSpec {
                kind: "toolchain-pack",
                args: value.args().1,
                inputs,
                outputs: Vec::from_array([output]),
                anchor: output,
            }
        },
        Link { input_cores, output, world, .. } => {
            let inputs: Vec[string] = Vec::new();
            for input in input_cores {
                inputs.push(input)
            }
            if let Some(value) = world {
                inputs.push(value)
            }
            CacheSpec {
                kind: "link",
                args: value.args().1,
                inputs,
                outputs: Vec::from_array([output]),
                anchor: output,
            }
        },
        TestLink { input_cores, output, manifest, world, .. } => {
            let inputs: Vec[string] = Vec::new();
            for input in input_cores {
                inputs.push(input)
            }
            if let Some(value) = world {
                inputs.push(value)
            }
            CacheSpec {
                kind: "test-link",
                args: value.args().1,
                inputs,
                outputs: Vec::from_array([output, manifest]),
                anchor: output,
            }
        },
        GoBuild { input, output } => CacheSpec {
            kind: "go-build",
            args: value.args().1,
            inputs: Vec::from_array([input]),
            outputs: Vec::from_array([output]),
            anchor: output,
        },
    }
}

fn cache_path(module_dir: string, spec: CacheSpec) -> string {
    absolute_from_module(module_dir, spec.anchor) + ".goml-" + spec.kind + "-fingerprint"
}

fn command_fingerprint(cache: DigestCache, context: Context, compiler: string, spec: CacheSpec) -> Result[
    string,
    failure::Failure,
] {
    let builder = text::StringBuilder::new();
    builder.write_string("goml-build-cache-v1\n");
    builder.write_string(compiler);
    builder.write_char('\n');
    builder.write_string(context.graph.module_dir);
    builder.write_char('\n');
    builder.write_string(spec.kind);
    builder.write_char('\n');
    for argument in spec.args {
        builder.write_string(argument.byte_len().to_string());
        builder.write_char(':');
        builder.write_string(argument)
    }
    builder.write_char('\n');
    for input in spec.inputs {
        let digest = cached_input_digest(cache, context, input)?;
        builder.write_string(input.byte_len().to_string());
        builder.write_char(':');
        builder.write_string(input);
        builder.write_string(digest)
    }
    Ok(sha256_text(builder.finish()))
}

fn output_digests(cache: DigestCache, module_dir: string, outputs: Vec[string]) -> Result[
    Option[Vec[string]],
    failure::Failure,
] {
    let result: Vec[string] = Vec::new();
    for output in outputs {
        if fs::is_file(absolute_from_module(module_dir, output)) {
            result.push(cached_file_digest(cache, module_dir, output)?)
        } else {
            return Ok(Option::None)
        }
    }
    Ok(Option::Some(result))
}

fn cache_is_fresh(cache: DigestCache, context: Context, spec: CacheSpec, fingerprint: string) -> Result[
    bool,
    failure::Failure,
] {
    let record_path = cache_path(context.graph.module_dir, spec);
    if !fs::is_file(record_path) {
        return Ok(false)
    }
    let source = fs::read_file_structured(record_path).driver_result()?;
    let lines = text::split(source, "\n");
    if lines.len() != spec.outputs.len() + 1 || lines[0] != fingerprint {
        return Ok(false)
    }
    let Some(actual) = output_digests(cache, context.graph.module_dir, spec.outputs)? else {
        return Ok(false);
    };
    for index in 0..actual.len() {
        if lines[index + 1] != actual[index] {
            return Ok(false)
        }
    }
    Ok(true)
}

fn remove_cache_file(value: string) -> Result[(), failure::Failure] {
    if fs::exists(value) {
        fs::remove_file(value).map_err(failure::convert)
    } else {
        Ok(())
    }
}

fn prepare_cache_execution(context: Context, spec: CacheSpec) -> Result[(), failure::Failure] {
    remove_cache_file(cache_path(context.graph.module_dir, spec))?;
    for output in spec.outputs {
        remove_cache_file(absolute_from_module(context.graph.module_dir, output))?
    }
    Ok(())
}

fn verified_cache_digests(
    cache: DigestCache,
    context: Context,
    spec: CacheSpec,
    compiler: string,
    before: string,
) -> Result[Vec[string], failure::Failure] {
    let after = command_fingerprint(digest_cache(), context, compiler, spec)?;
    if after != before {
        return Err(failure::convert("cache input changed while executing subcommand"))
    }
    output_digests(cache, context.graph.module_dir, spec.outputs)?.ok_or(
        failure::convert("subcommand succeeded without all expected outputs"),
    )
}

fn store_cache(
    cache: DigestCache,
    context: Context,
    spec: CacheSpec,
    compiler: string,
    before: string,
) -> Result[(), failure::Failure] {
    let digests = match verified_cache_digests(cache, context, spec, compiler, before) {
        Ok(value) => value,
        Err(message) => {
            let _ = prepare_cache_execution(context, spec);
            return Err(message)
        },
    };
    let builder = text::StringBuilder::new();
    builder.write_string(before);
    for digest in digests {
        builder.write_char('\n');
        builder.write_string(digest)
    }
    let record_path = cache_path(context.graph.module_dir, spec);
    match path::parent(record_path) {
        Some(parent) => fs::create_dir_all(parent).driver_result()?,
        None => return Err(failure::convert("fingerprint path has no parent directory")),
    }
    fs::write_file_structured(record_path, builder.finish()).map_err(failure::convert)
}
