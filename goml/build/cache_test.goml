package build;

use module::project::{CompilerWorld};
use module::test_support;
use std::testing;
use std::fs;

#[test]
fn output_digest_invalidation_normalizes_absolute_paths() -> () {
    let root = test_support::workspace("cache_absolute_alias");
    let file = root + "/output";
    let alias = root + "/./output";
    let cache = digest_cache();
    test_support::write_file(file, "before");
    let before = testing::expect_ok(cached_file_digest(cache, root, alias), "original digest");
    test_support::write_file(file, "after");
    invalidate_output_digests(cache, root, Vec::from_array([file]));
    let after = testing::expect_ok(cached_file_digest(cache, root, alias), "new digest");
    testing::assert(before != after);
    testing::assert_eq(after, testing::expect_ok(file_digest(root, file), "uncached digest"));
}

#[test]
fn installed_world_cache_fingerprints_track_size_and_modification_time() -> () {
    let before = fs::Metadata::from_parts(fs::FileType::File, 100, 0o644, 10);
    let changed_size = fs::Metadata::from_parts(fs::FileType::File, 101, 0o644, 10);
    let changed_time = fs::Metadata::from_parts(fs::FileType::File, 100, 0o644, 11);
    testing::assert(installed_world_stamp(before) != installed_world_stamp(changed_size));
    testing::assert(installed_world_stamp(before) != installed_world_stamp(changed_time));
    let root = test_support::workspace("installed_world_cache_stamp");
    let world = root + "/world.gaf";
    test_support::write_file(world, "before");
    let context = compiler_world_test_context(CompilerWorld::Installed { path: world });
    let cache = digest_cache();
    let before = testing::expect_ok(
        cached_input_digest(cache, context, world),
        "installed world stamp",
    );
    test_support::write_file(world, "changed size");
    let after = testing::expect_ok(
        cached_input_digest(cache, context, world),
        "changed installed world stamp",
    );
    testing::assert(before != after);
    testing::assert_eq(
        after,
        installed_world_stamp(testing::expect_ok(fs::metadata(world), "world metadata")),
    );
}

#[test]
fn external_worlds_and_other_cache_inputs_keep_content_hashes() -> () {
    let root = test_support::workspace("external_world_cache_digest");
    test_support::write_basic_project(root, "cache_input");
    let world = root + "/world.gaf";
    let source = root + "/main.goml";
    test_support::write_file(world, "world");
    let cache = digest_cache();
    let context = compiler_world_test_context(CompilerWorld::Source);
    testing::assert_eq(
        testing::expect_ok(cached_input_digest(cache, context, world), "external world digest"),
        testing::expect_ok(file_digest(root, world), "content digest"),
    );
    let context = compiler_world_test_context(CompilerWorld::Installed { path: world });
    testing::assert_eq(
        testing::expect_ok(cached_input_digest(cache, context, source), "source digest"),
        testing::expect_ok(file_digest(root, source), "source content digest"),
    );
}
