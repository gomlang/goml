package test_support;

use std::bytes;
use std::env;
use std::fs;
use std::path;
use std::process;
use std::testing;
use std::utf8;
use utf8::BytesUtf8;

fn absolute(value: string) -> string {
    if path::is_absolute(value) {
        value
    } else {
        match path::absolute_structured(value) {
            Ok(value) => value,
            Err(message) => {
                testing::fail(message.to_string());
                value
            },
        }
    }
}

pub fn module_root() -> string {
    match env::current_dir_structured() {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message.to_string());
            "."
        },
    }
}

pub fn repository_root() -> string {
    match env::var_structured("GOML_REPO") {
        Ok(value) => absolute(value),
        Err(_) => absolute(path::join(module_root(), "..")),
    }
}

pub fn goml_binary() -> string {
    match env::var_structured("GOML_TEST_GOML") {
        Ok(value) => absolute(value),
        Err(_) => path::join(repository_root(), "stage2/bin/goml"),
    }
}

pub fn gomlc_binary() -> string {
    match env::var_structured("GOML_TEST_GOMLC") {
        Ok(value) => absolute(value),
        Err(_) => path::join(repository_root(), "stage2/bin/gomlc"),
    }
}

pub fn workspace(name: string) -> string {
    let result = path::join(path::join(module_root(), "_artifact/test-work"), name);
    if fs::exists(result) {
        if let Err(message) = fs::remove_dir_all(result) {
            testing::fail(message.to_string())
        }
    }
    match fs::create_dir_all(result) {
        Ok(()) => result,
        Err(message) => {
            testing::fail(message.to_string());
            result
        },
    }
}

pub fn create_dir(value: string) -> () {
    if let Err(message) = fs::create_dir_all(value) {
        testing::fail(message.to_string())
    }
}

pub fn write_file(file: string, content: string) -> () {
    if let Some(parent) = path::parent(file) {
        create_dir(parent)
    }
    if let Err(message) = fs::write_file_structured(file, content) {
        testing::fail(message.to_string())
    }
}

pub fn read_file(file: string) -> string {
    match fs::read_file_structured(file) {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message.to_string());
            ""
        },
    }
}

fn bytes_text(value: bytes::Bytes) -> string {
    match value.to_string_utf8() {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message.to_string());
            ""
        },
    }
}

pub fn stdout(output: process::Output) -> string {
    bytes_text(process::Output::stdout(output))
}

pub fn stderr(output: process::Output) -> string {
    bytes_text(process::Output::stderr(output))
}

pub fn assert_success(output: process::Output) -> () {
    if process::ExitStatus::success(process::Output::status(output)) {} else {
        testing::fail("command failed\nstdout:\n" + stdout(output) + "\nstderr:\n" + stderr(output))
    }
}

pub fn assert_failure(output: process::Output) -> () {
    testing::assert(!process::ExitStatus::success(process::Output::status(output)))
}

pub fn assert_contains(value: string, expected: string) -> () {
    if value.contains(expected) {} else {
        testing::fail("expected text to contain:\n" + expected + "\nactual:\n" + value)
    }
}

pub fn assert_not_contains(value: string, unexpected: string) -> () {
    if value.contains(unexpected) {
        testing::fail("expected text not to contain:\n" + unexpected + "\nactual:\n" + value)
    }
}

pub fn run(args: Vec[string], directory: string) -> process::Output {
    match process::Command::new(goml_binary()).args(args).current_dir(directory).output_structured() {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message.to_string());
            process::Output {
                status_value: process::ExitStatus { code_value: -1 },
                stdout_value: bytes::Bytes::new(),
                stderr_value: bytes::Bytes::new(),
            }
        },
    }
}

pub fn project_command(command: string, target: string, extra: Vec[string], directory: string) -> process::Output {
    let args = Vec::from_array([command]);
    if command == "run" && target != "" {
        args.push(target)
    }
    args.push("--compiler");
    args.push(gomlc_binary());
    for value in extra {
        args.push(value)
    }
    let candidate = if path::is_absolute(target) {
        target
    } else {
        path::join(directory, target)
    };
    let command_directory = if command != "run" && target != ""
        && fs::is_file(path::join(candidate, "goml.toml")) {
        candidate
    } else {
        directory
    };
    run(args, command_directory)
}

pub fn write_basic_project(root: string, module_path: string) -> () {
    write_file(path::join(root, "goml.toml"), "[module]\npath = \"" + module_path + "\"\n");
    write_file(
        path::join(root, "main.goml"),
        \\package main;
        \\
        \\fn main() -> () {
        \\    println("hello")
        \\}
        \\
        ,
    )
}
