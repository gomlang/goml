package runner;

use std::testing;

fn shard_test(name: string) -> Test {
    Test {
        id: name,
        display_name: name,
        ignored: false,
        ignore_reason: Option::None,
        kind: "internal",
        executable: "runner",
    }
}

#[test]
fn test_shards_cover_every_test_once_in_name_order() -> () {
    let tests = sorted_tests(
        Vec::from_array(
            [
                shard_test("suite::d"),
                shard_test("suite::a"),
                shard_test("suite::e"),
                shard_test("suite::c"),
                shard_test("suite::b"),
            ],
        ),
    );
    let first = shard_tests(tests, 0, 3);
    let second = shard_tests(tests, 1, 3);
    let third = shard_tests(tests, 2, 3);
    testing::assert_eq(first.len() + second.len() + third.len(), tests.len());
    testing::assert_eq(first[0].id, "suite::a");
    testing::assert_eq(first[1].id, "suite::d");
    testing::assert_eq(second[0].id, "suite::b");
    testing::assert_eq(second[1].id, "suite::e");
    testing::assert_eq(third[0].id, "suite::c");
    testing::assert_eq(shard_tests(tests, 5, 6).len(), 0);
    testing::assert_eq(shard_tests(tests, 0, 1).len(), tests.len());
}

#[test]
fn parses_test_shards_and_rejects_invalid_configuration() -> () {
    let full = testing::expect_ok(parse_test_shard(""), "parse full selection");
    testing::assert_eq(full.0, 0);
    testing::assert_eq(full.1, 1);
    let first = testing::expect_ok(parse_test_shard("1/4"), "parse first shard");
    testing::assert_eq(first.0, 0);
    testing::assert_eq(first.1, 4);
    let last = testing::expect_ok(parse_test_shard("4/4"), "parse last shard");
    testing::assert_eq(last.0, 3);
    testing::assert_eq(last.1, 4);
    for value in["0/4", "5/4", "1/0", "4", "1/2/3", "-1/4", "1/a", "999999999999999999999/4"] {
        testing::assert(parse_test_shard(value).is_err());
    }
}

#[test]
fn encodes_list_json_event() -> () {
    let test = Test {
        id: "test-id",
        display_name: "suite::test",
        ignored: true,
        ignore_reason: Option::None,
        kind: "internal",
        executable: "runner",
    };
    testing::assert_eq(
        list_event_json(test),
        "{\"event\":\"test\",\"ignored\":true,\"kind\":\"internal\",\"name\":\"suite::test\",\"reason\":null}",
    )
}

#[test]
fn encodes_json_control_characters() -> () {
    testing::assert_eq(
        result_event_json("ok", "你好\b\f\u0001\n\"goml\"\\", 17),
        "{\"event\":\"ok\",\"name\":\"你好\\b\\f\\u0001\\n\\\"goml\\\"\\\\\",\"seed\":17}",
    )
}
