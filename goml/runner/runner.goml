package runner;

use module::util;
use std::bytes;
use std::cmp;
use std::collections;
use std::fs;
use std::io;
use std::json;
use std::process;
use std::task;
use std::time;
use std::utf8;
use utf8::BytesUtf8;

pub struct Options {
    pub filter: Option[string],
    pub jobs: isize,
    pub list: bool,
    pub ignored: bool,
    pub include_ignored: bool,
    pub json: bool,
    pub nocapture: bool,
    pub timeout_ms: isize,
    pub seed: isize,
}

pub struct Group {
    pub kind: string,
    pub executable: string,
    pub manifest_path: string,
}

struct Test {
    id: string,
    display_name: string,
    ignored: bool,
    ignore_reason: Option[string],
    kind: string,
    executable: string,
}

enum Status {
    Passed,
    Failed(isize),
    TimedOut,
    Ignored,
}

struct Execution {
    index: isize,
    test: Test,
    status: Status,
    stdout: string,
    stderr: string,
}

fn bytes_text(value: bytes::Bytes) -> string {
    value.to_string_utf8().unwrap_or("<non-UTF-8 output>")
}

fn required_string(value: json::Value, name: string) -> Result[string, string] {
    let field = json::field(value, name).ok_or(f"test manifest omitted {name}")?;
    json::as_string(field).ok_or(f"{name} must be a string")
}

fn required_bool(value: json::Value, name: string) -> Result[bool, string] {
    let field = json::field(value, name).ok_or(f"test manifest omitted {name}")?;
    json::as_bool(field).ok_or(f"{name} must be boolean")
}

fn load_tests(group: Group) -> Result[Vec[Test], string] {
    let source = fs::read_file_structured(group.manifest_path).map_err(|error| error.to_string())?;
    let root = json::parse(source)?;
    let Some(values) = json::as_array(root) else {
        return Result::Err("test manifest must be an array")
    };
    let result: Vec[Test] = Vec::new();
    for value in values {
        let id = required_string(value, "id")?;
        let display_name = required_string(value, "display_name")?;
        let ignored = required_bool(value, "ignored")?;
        let ignore_reason = json::field(value, "ignore_reason").and_then(
            |value| json::as_string(value),
        );
        result.push(
            Test {
                id,
                display_name,
                ignored,
                ignore_reason,
                kind: group.kind,
                executable: group.executable,
            },
        )
    }
    Result::Ok(result)
}

fn selected(test: Test, options: Options) -> bool {
    let filter_matches = match options.filter {
        Some(value) => test.display_name.contains(value),
        None => true,
    };
    filter_matches && (!options.ignored || test.ignored)
}

fn compare_tests(left: Test, right: Test) -> cmp::Ordering {
    cmp::compare(left.display_name, right.display_name)
}

fn sorted_tests(values: Vec[Test]) -> Vec[Test] {
    collections::sort_by_ordering(values, compare_tests);
    values
}

fn list_event_json(test: Test) -> string {
    let reason = match test.ignore_reason {
        Some(value) => json::Value::String(value),
        None => json::Value::Null,
    };
    json::encode(
        json::object(
            Vec::from_array(
                [
                    ("event", json::Value::String("test")),
                    ("ignored", json::Value::Bool(test.ignored)),
                    ("kind", json::Value::String(test.kind)),
                    ("name", json::Value::String(test.display_name)),
                    ("reason", reason),
                ],
            ),
        ),
    )
}

fn result_event_json(event: string, name: string, seed: isize) -> string {
    json::encode(
        json::object(
            Vec::from_array(
                [
                    ("event", json::Value::String(event)),
                    ("name", json::Value::String(name)),
                    ("seed", json::Value::Number(seed.to_string())),
                ],
            ),
        ),
    )
}

fn print_list(tests: Vec[Test], options: Options) -> () {
    for test in tests {
        if options.json {
            io::println(list_event_json(test))
        } else if test.ignored {
            io::println(f"{test.display_name}: ignored")
        } else {
            io::println(test.display_name)
        }
    }
}

fn run_one(module_dir: string, index: isize, test: Test, options: Options) -> Execution {
    if test.ignored && !options.ignored && !options.include_ignored {
        Execution { index, test, status: Status::Ignored, stdout: "", stderr: "" }
    } else {
        let command = process::Command::new(test.executable).arg(test.id).current_dir(module_dir).env(
            "TZ",
            "UTC",
        ).env("GOML_TEST_SEED", options.seed.to_string());
        if options.nocapture {
            match command.status_timeout_structured(
                time::Duration::from_milliseconds(options.timeout_ms.to_i64()),
            ) {
                Ok(status) => Execution {
                    index,
                    test,
                    status: if process::ExitStatus::success(status) {
                        Status::Passed
                    } else {
                        Status::Failed(process::ExitStatus::code(status).unwrap_or(-1))
                    },
                    stdout: "",
                    stderr: "",
                },
                Err(error) => Execution {
                    index,
                    test,
                    status: if error.kind() == io::ErrorKind::TimedOut {
                        Status::TimedOut
                    } else {
                        Status::Failed(-1)
                    },
                    stdout: "",
                    stderr: error.to_string(),
                },
            }
        } else {
            match command.output_timeout_structured(
                time::Duration::from_milliseconds(options.timeout_ms.to_i64()),
            ) {
                Ok(output) => {
                    Execution {
                        index,
                        test,
                        status: if process::ExitStatus::success(process::Output::status(output)) {
                            Status::Passed
                        } else {
                            Status::Failed(
                                process::ExitStatus::code(process::Output::status(output)).unwrap_or(
                                    -1,
                                ),
                            )
                        },
                        stdout: bytes_text(process::Output::stdout(output)),
                        stderr: bytes_text(process::Output::stderr(output)),
                    }
                },
                Err(error) => Execution {
                    index,
                    test,
                    status: if error.kind() == io::ErrorKind::TimedOut {
                        Status::TimedOut
                    } else {
                        Status::Failed(-1)
                    },
                    stdout: "",
                    stderr: error.to_string(),
                },
            }
        }
    }
}

fn worker(
    cancel: task::CancelToken,
    module_dir: string,
    options: Options,
    work: Channel[(isize, Test)],
    results: Channel[Execution],
) -> () {
    loop {
        match task::recv_with(cancel, work) {
            task::WaitResult::Completed(Some(item)) => match task::send_with(
                cancel,
                results,
                run_one(module_dir, item.0, item.1, options),
            ) {
                task::WaitResult::Completed(()) => (),
                task::WaitResult::Cancelled => break,
            },
            task::WaitResult::Completed(None) | task::WaitResult::Cancelled => break,
        }
    }
}

fn record_execution(
    executions: Vec[Execution],
    received: Option[Execution],
    completed: isize,
    total: isize,
) -> Result[isize, string] {
    let Some(value) = received else {
        return Result::Err("test result channel closed early")
    };
    executions.push(value);
    let next = completed + 1;
    util::display_progress(
        next,
        total,
        if next == total {
            "finished"
        } else {
            "running tests"
        },
        next == total,
    );
    Result::Ok(next)
}

fn compare_executions(left: Execution, right: Execution) -> cmp::Ordering {
    cmp::compare(left.index, right.index)
}

fn ordered_executions(values: Vec[Execution]) -> Vec[Execution] {
    collections::sort_by_ordering(values, compare_executions);
    values
}

fn report_text(values: Vec[Execution], seed: isize) -> isize {
    let mut passed = 0;
    let mut failed = 0;
    let mut ignored = 0;
    for value in values {
        match value.status {
            Passed => {
                passed += 1;
                io::println(f"test {value.test.display_name} ... ok")
            },
            Ignored => {
                ignored += 1;
                let status = match value.test.ignore_reason {
                    Some(reason) => f"ignored: {reason}",
                    None => "ignored",
                };
                io::println(f"test {value.test.display_name} ... {status}")
            },
            TimedOut | Failed(_) => {
                failed += 1;
                let status = match value.status {
                    TimedOut => "FAILED (timed out)",
                    Failed(code) => if code < 0 {
                        "FAILED (terminated by signal)"
                    } else {
                        f"FAILED (exit code {code})"
                    },
                    _ => "FAILED",
                };
                io::println(f"test {value.test.display_name} ... {status}");
                if value.stdout != "" {
                    io::println("---- stdout ----");
                    io::print(value.stdout)
                }
                if value.stderr != "" {
                    io::println("---- stderr ----");
                    io::print(value.stderr)
                }
            },
        }
    }
    let result = if failed == 0 {
        "ok"
    } else {
        "FAILED"
    };
    io::println(f"\ntest result: {result}. {passed} passed; {failed} failed; {ignored} ignored");
    if failed > 0 {
        io::println(f"replay seed: {seed}")
    }
    failed
}

fn report_json(values: Vec[Execution], seed: isize) -> isize {
    let mut failed = 0;
    for value in values {
        let event = match value.status {
            Passed => "ok",
            Ignored => "ignored",
            Failed(_) => {
                failed += 1;
                "failed"
            },
            TimedOut => {
                failed += 1;
                "timed_out"
            },
        };
        io::println(result_event_json(event, value.test.display_name, seed))
    }
    failed
}

pub fn run(module_dir: string, groups: Vec[Group], options: Options) -> Result[(), string] {
    let loaded: Vec[Test] = Vec::new();
    for group in groups {
        let values = load_tests(group)?;
        for value in values {
            loaded.push(value)
        }
    }
    let selected_tests: Vec[Test] = Vec::new();
    for test in sorted_tests(loaded) {
        if selected(test, options) {
            selected_tests.push(test)
        }
    }
    if options.list {
        print_list(selected_tests, options);
        return Result::Ok(())
    } else if !options.json {
        io::println(f"running {selected_tests.len()} tests\n")
    }
    if selected_tests.is_empty() {
        if !options.json {
            io::println("test result: ok. 0 passed; 0 failed; 0 ignored")
        }
        return Result::Ok(())
    }
    let executions = task::try_scope(
        |scope: task::Scope| {
            let worker_count = if options.jobs < selected_tests.len() {
                options.jobs
            } else {
                selected_tests.len()
            };
            let work = Channel::new(worker_count);
            let results = Channel::new(worker_count);
            for _ in 0..worker_count {
                let _ = scope.spawn(
                    |cancel: task::CancelToken| worker(cancel, module_dir, options, work, results),
                );
            }
            let executions: Vec[Execution] = Vec::new();
            let total = selected_tests.len();
            let mut dispatched = 0;
            let mut completed = 0;
            util::display_progress(completed, total, "running tests", false);
            while completed < total {
                if dispatched < total {
                    select {
                        send(work,(dispatched, selected_tests[dispatched])) => {
                            dispatched += 1;
                        },
                        recv(results) as received => {
                            completed = record_execution(executions, received, completed, total)?;
                        },
                    }
                } else {
                    completed = record_execution(executions, results.recv(), completed, total)?;
                };
            }
            work.close();
            results.close();
            Result::Ok(executions)
        },
    )?;
    let failures = if options.json {
        report_json(ordered_executions(executions), options.seed)
    } else {
        report_text(ordered_executions(executions), options.seed)
    };
    if failures == 0 {
        Result::Ok(())
    } else {
        Result::Err(f"{failures} test(s) failed")
    }
}
