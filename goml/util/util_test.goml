package util;

use std::testing;

#[test]
fn positive_integers_reject_overflow_and_non_decimal_forms() -> () {
    for value in Vec::from_array(
        ["", "0", "-1", "+1", " 1", "1_000", "9223372036854775808", "18446744073709551617"],
    ) {
        testing::assert(parse_positive_int(value).is_err());
    }
    testing::assert_eq(testing::expect_ok(parse_positive_int("0012"), "leading zeroes"), 12);
    testing::assert_eq(
        testing::expect_ok(parse_positive_int("9223372036854775807"), "maximum integer"),
        9223372036854775807,
    );
}
