package util;

use std::collections;
use std::io;
use std::text;

pub fn sorted(values: Vec[string]) -> Vec[string] {
    collections::sort(values);
    values
}

pub fn sorted_unique(values: Vec[string]) -> Vec[string] {
    collections::BTreeSet::from_vec(values).to_vec()
}

pub fn progress_bar(completed: isize, total: isize) -> string {
    let width = 20;
    let filled = if total == 0 {
        width
    } else {
        completed * width / total
    };
    let builder = text::StringBuilder::with_capacity(width + 2);
    builder.write_char('[');
    for index in 0..width {
        builder.write_char(
            if index < filled {
                '#'
            } else {
                '-'
            },
        )
    }
    builder.write_char(']');
    builder.finish()
}

pub fn display_progress(completed: isize, total: isize, label: string, finished: bool) -> () {
    let update = f"\r\u001b[2K{progress_bar(completed, total)} {completed}/{total} {label}";
    if finished {
        io::eprintln(update)
    } else {
        io::eprint(update)
    }
}

pub fn parse_positive_int(value: string) -> Result[isize, string] {
    let length = value.byte_len();
    if length == 0 {
        return Result::Err("expected a positive integer")
    }
    let mut result = 0;
    for index in 0..length {
        let byte = value.byte_get(index);
        if byte < b'0' || byte > b'9' {
            return Result::Err("expected a positive integer")
        } else {
            result = result * 10 + (byte - b'0').to_isize();
        }
    }
    if result > 0 {
        Result::Ok(result)
    } else {
        Result::Err("expected a positive integer")
    }
}

fn shell_plain(value: string) -> bool {
    if value.byte_len() == 0 {
        false
    } else {
        for index in 0..value.byte_len() {
            let byte = value.byte_get(index);
            if (byte >= b'0' && byte <= b'9') || (byte >= b'A' && byte <= b'Z')
                || (byte >= b'a' && byte <= b'z')
                || byte == b'-'
                || byte == b'.'
                || byte == b'/'
                || byte == b':'
                || byte == b'_' {} else {
                return false
            }
        }
        true
    }
}

pub fn shell_escape(value: string) -> string {
    if shell_plain(value) {
        return value
    }
    let builder = text::StringBuilder::with_capacity(value.byte_len() + 2);
    builder.write_char('\'');
    for character in value.chars() {
        if character == '\'' {
            builder.write_string("'\\''")
        } else {
            builder.write_char(character)
        }
    }
    builder.write_char('\'');
    builder.finish()
}
