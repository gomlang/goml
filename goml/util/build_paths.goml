package util;

use std::crypto::hash;
use std::path;
use std::bytes;

pub fn sha256_text(value: string) -> string {
    hash::sha256(bytes::Bytes::from_string(value))
}

pub fn absolute_from_module(module_dir: string, value: string) -> string {
    if path::is_absolute(value) {
        path::clean(value)
    } else {
        path::join(module_dir, value)
    }
}
