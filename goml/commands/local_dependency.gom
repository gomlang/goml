package commands;

use module::manifest;
use module::registry;
use std::fs;
use std::io;
use std::json;
use std::path;

fn add_path_dependency(args: Vec[string]) -> Result[bool, string] {
    let filtered = Vec::from_array([args[0], args[1]]);
    let mut local: Option[string] = Option::None;
    let mut index = 2;
    while index < args.len() {
        let argument = args[index];
        if argument == "--path" || argument.starts_with("--path=") {
            if local.is_some() {
                return Result::Err("--path cannot be repeated")
            }
            if argument == "--path" {
                if index + 1 >= args.len() {
                    return Result::Err("--path requires a value")
                }
                local = Option::Some(args[index + 1]);
                index += 2;
            } else {
                local = Option::Some(argument.byte_slice(7, argument.byte_len()));
                index += 1;
            }
        } else {
            filtered.push(argument);
            index += 1;
        }
    }
    let Some(local) = local else {
        return Result::Ok(false)
    };
    if local == "" {
        return Result::Err("--path requires a value")
    }
    let (spec, registry) = dependency_command_args(filtered)?;
    if registry.is_some() {
        return Result::Err("--path conflicts with --local-registry")
    }
    let parts = spec.split("@");
    if parts.len() > 2 {
        return Result::Err("invalid dependency " + spec)
    }
    let name = parts[0];
    manifest::validate_dependency_name(name)?;
    let directory = fs::canonicalize(local).map_err(|error| error.to_string())?;
    let dependency = manifest::load(path::join(directory, manifest::FILENAME))?;
    if dependency.module_path != name {
        return Result::Err("dependency " + name + " declares module path " + dependency.module_path)
    }
    let root = module_root()?;
    if root == directory {
        return Result::Err("a module cannot depend on itself")
    }
    let relative = path::relative(root, directory).map_err(|error| error.to_string())?;
    let version = if parts.len() == 2 {
        let _ = registry::parse_sem_version(parts[1])?;
        ", version = " + json::encode(json::Value::String(parts[1]))
    } else {
        ""
    };
    let entry = json::encode(json::Value::String(name)) + " = { path = "
        + json::encode(json::Value::String(relative))
        + version
        + " }";
    upsert_dependency_entry(path::join(root, manifest::FILENAME), name, entry)?;
    io::println("added " + name + " from " + relative);
    Result::Ok(true)
}
