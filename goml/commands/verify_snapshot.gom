package commands;

use module::failure;
use failure::DriverResult;
use module::manifest;
use module::project;
use module::registry;
use module::util;
use std::bytes;
use std::crypto::hash;
use std::crypto::rand;
use std::fs;
use std::json;
use std::path;
use std::text;

struct VerifyFile {
    name: string,
    content: bytes::Bytes,
}

struct VerifyModule {
    name: string,
    version: string,
    root: string,
    files: Vec[VerifyFile],
}

fn capture_verify_files(
    root: string,
    directory: string,
    artifact: string,
    files: Vec[VerifyFile],
    nested: bool,
) -> Result[(), failure::Failure] {
    if directory == artifact
        || (nested && directory != root && fs::is_file(path::join(directory, manifest::FILENAME))) {
        return Result::Ok(())
    }
    for name in util::sorted(fs::read_dir(directory).driver_result()?) {
        if name == ".git" || name == "_artifact" || name == "_bootstrap" || name == "__pycache__" {
            continue
        }
        let source = path::join(directory, name);
        let metadata = fs::symlink_metadata(source).driver_result()?;
        if metadata.file_type().is_symlink() {
            continue
        }
        if metadata.file_type().is_dir() {
            capture_verify_files(root, source, artifact, files, nested)?;
        } else if metadata.file_type().is_file() {
            files.push(
                VerifyFile {
                    name: path::relative(root, source).driver_result()?,
                    content: fs::read_bytes_structured(source).driver_result()?,
                },
            );
        }
    }
    Result::Ok(())
}

fn verify_version(modules: Vec[VerifyModule], name: string) -> Result[string, failure::Failure] {
    for value in modules {
        if value.name == name {
            return Result::Ok(value.version)
        }
    }
    Result::Err(
        failure::convert(
            "downstream dependency " + name
                + " must be declared in the library dependencies or dev-dependencies",
        ),
    )
}

fn verify_requirements(modules: Vec[VerifyModule], dependencies: Vec[manifest::Dependency]) -> Result[
    string,
    failure::Failure,
] {
    let result = text::StringBuilder::new();
    let names: Vec[string] = Vec::new();
    for dependency in dependencies {
        names.push(dependency.name)
    }
    for name in util::sorted_unique(names) {
        let version = verify_version(modules, name)?;
        result.write_string(
            json::encode(json::Value::String(name)) + " = "
                + json::encode(json::Value::String(version))
                + "\n",
        );
    }
    Result::Ok(result.finish())
}

fn verify_manifest(source: string, requirements: string) -> string {
    let result = text::StringBuilder::new();
    let mut skip = false;
    for line in manifest_edit_lines(source) {
        if let Some(section) = section_name(line) {
            skip = section == "dependencies" || section == "dev-dependencies"
                || section == "replace"
                || section == "build";
        }
        if !skip {
            result.write_string(line + "\n")
        }
    }
    result.write_string("\n[dependencies]\n" + requirements);
    result.finish()
}

fn capture_verify_module(name: string, version: string, root: string, artifact: string) -> Result[
    VerifyModule,
    failure::Failure,
] {
    registry::validate_coordinate(name)?;
    let files = Vec::new();
    let own = manifest::load_structured(path::join(root, manifest::FILENAME))?;
    capture_verify_files(root, root, path::join(root, own.target_dir), files, true)?;
    let retained = Vec::new();
    for file in files {
        let absolute = path::join(root, file.name);
        if absolute != artifact && !absolute.starts_with(artifact + "/") {
            retained.push(file)
        }
    }
    Result::Ok(VerifyModule { name, version, root, files: retained })
}

fn verify_modules(context: project::Context) -> Result[Vec[VerifyModule], failure::Failure] {
    let root = context.graph.module_dir;
    let modules = Vec::from_array(
        [capture_verify_module(context.graph.module_path, "0.0.0", root, context.artifact_root)?],
    );
    for module in registry::resolve_at_with_development(root, registry::cached_root()?, true)? {
        modules.push(
            capture_verify_module(
                module.name,
                if module.version == "local" {
                    "0.0.0"
                } else {
                    module.version
                },
                module.root,
                context.artifact_root,
            )?,
        );
    }
    Result::Ok(modules)
}

fn write_verify_files(root: string, files: Vec[VerifyFile]) -> Result[(), failure::Failure] {
    for file in files {
        let target = path::join(root, file.name);
        fs::create_dir_all(path::parent(target).unwrap_or(root)).driver_result()?;
        fs::write_bytes_structured(target, file.content).driver_result()?;
    }
    Result::Ok(())
}

fn verify_snapshot(context: project::Context, modules: Vec[VerifyModule]) -> Result[
    string,
    failure::Failure,
] {
    let identity = text::StringBuilder::new();
    identity.write_string("goml-downstream-v1\n");
    for module in modules {
        identity.write_string(module.name + "@" + module.version + "\n");
        for file in module.files {
            identity.write_string(
                file.name.byte_len().to_string() + ":" + file.name + hash::sha256(file.content),
            );
        }
    }
    let parent = path::join(context.artifact_root, "verify");
    let home = path::join(parent, hash::sha256(bytes::Bytes::from_string(identity.finish())));
    let registry_root = path::join(home, "cache/registry");
    if fs::is_file(path::join(registry_root, "index.toml")) {
        return Result::Ok(home)
    }
    fs::create_dir_all(parent).driver_result()?;
    let temporary = path::join(parent, ".staging-" + hash::sha256(rand::bytes(32).driver_result()?));
    fs::create_dir(temporary).driver_result()?;
    let staged_registry = path::join(temporary, "cache/registry");
    let index = text::StringBuilder::new();
    let publish = || {
        for module in modules {
            let target = registry::module_directory(staged_registry, module.name, module.version)?;
            write_verify_files(target, module.files)?;
            let manifest_path = path::join(target, manifest::FILENAME);
            let metadata = manifest::load_structured(manifest_path)?;
            let source = fs::read_file_structured(manifest_path).driver_result()?;
            fs::write_file_structured(
                manifest_path,
                verify_manifest(source, verify_requirements(modules, metadata.dependencies)?),
            ).driver_result()?;
            index.write_string(
                "[modules." + json::encode(json::Value::String(module.name)) + "]\nlatest = \""
                    + module.version
                    + "\"\nversions = [\""
                    + module.version
                    + "\"]\n\n",
            );
        }
        fs::write_file_structured(path::join(staged_registry, "index.toml"), index.finish()).driver_result()?;
        match fs::rename(temporary, home) {
            Ok(()) => Result::Ok(()),
            Err(error) => if fs::is_file(path::join(registry_root, "index.toml")) {
                Result::Ok(())
            } else {
                Result::Err(failure::convert(error))
            },
        }
    };
    let result = publish();
    if fs::exists(temporary) {
        fs::remove_dir_all(temporary).driver_result()?
    }
    result?;
    Result::Ok(home)
}
