package commands;

fn manifest_edit_lines(source: string) -> Vec[string] {
    let result = Vec::new();
    let mut pending = "";
    let mut depth = 0;
    let mut quote = 0.to_u8();
    let mut escaped = false;
    for line in source.lines() {
        pending += line;
        for byte in line.to_bytes() {
            if escaped {
                escaped = false;
            } else if quote == b'"' && byte == b'\\' {
                escaped = true;
            } else if quote != 0 {
                if byte == quote {
                    quote = 0;
                }
            } else if byte == b'"' || byte == b'\'' {
                quote = byte;
            } else if byte == b'#' {
                break;
            } else if byte == b'[' || byte == b'{' {
                depth += 1;
            } else if byte == b']' || byte == b'}' {
                depth -= 1;
            }
        }
        if depth == 0 {
            result.push(pending);
            pending = "";
        } else {
            pending += "\n";
        }
    }
    if pending != "" {
        result.push(pending)
    }
    result
}
