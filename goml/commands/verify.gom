package commands;

use gomlang::toolchain_manifest as config;
use module::failure;
use failure::DriverResult;
use module::manifest;
use module::project;
use module::util;
use std::bytes;
use std::crypto::hash;
use std::env;
use std::fs;
use std::io;
use std::json;
use std::path;
use std::process;
use std::text;

pub struct VerifyOptions {
    pub example: Option[string],
    pub examples_only: bool,
    pub dry_run: bool,
    pub test_arguments: Vec[string],
    pub ffi_check: string,
    pub jobs: isize,
}

struct VerifyCase {
    name: string,
    root: string,
    module_path: string,
    example: bool,
}

fn verify_cases(context: project::Context, options: VerifyOptions) -> Result[
    Vec[VerifyCase],
    failure::Failure,
] {
    let result = Vec::new();
    let names = match options.example {
        Some(name) => {
            let _ = project::example_context(context, name)?;
            Vec::from_array([name])
        },
        None => project::example_names(context)?,
    };
    for name in names {
        let selected = project::example_context(context, name)?;
        project::validate_downstream_example(selected)?;
        result.push(
            VerifyCase {
                name: "examples/" + name,
                root: path::join(context.graph.module_dir, "examples/" + name),
                module_path: context.graph.module_path + "::examples::" + name,
                example: true,
            },
        );
    }
    let fixtures = path::join(context.graph.module_dir, "testdata/downstream");
    if options.example.is_none() && !options.examples_only && fs::is_dir(fixtures) {
        for name in util::sorted(fs::read_dir(fixtures).driver_result()?) {
            let root = path::join(fixtures, name);
            let manifest_path = path::join(root, manifest::FILENAME);
            if !name.starts_with(".") && fs::is_dir(root) && fs::is_file(manifest_path) {
                let root = canonical(root)?;
                if !root.starts_with(canonical(fixtures)? + "/") {
                    return Result::Err(
                        failure::convert("downstream fixture is outside the module: " + name),
                    )
                }
                let metadata = manifest::load_structured(manifest_path)?;
                if metadata.module_path == context.graph.module_path {
                    return Result::Err(
                        failure::convert(
                            "downstream fixture must have its own module path: " + name,
                        ),
                    )
                }
                result.push(
                    VerifyCase {
                        name: "fixtures/" + name,
                        root,
                        module_path: metadata.module_path,
                        example: false,
                    },
                );
            }
        }
    }
    if result.is_empty() {
        return Result::Err(
            failure::convert(
                "no downstream cases; add examples/<name>/main.gom or testdata/downstream/<name>/goml.toml",
            ),
        )
    }
    Result::Ok(result)
}

fn materialize_verify_case(
    context: project::Context,
    modules: Vec[VerifyModule],
    home: string,
    value: VerifyCase,
) -> Result[string, failure::Failure] {
    let metadata = manifest::load_structured(
        path::join(
            if value.example {
                context.graph.module_dir
            } else {
                value.root
            },
            manifest::FILENAME,
        ),
    )?;
    let files = Vec::new();
    capture_verify_files(
        value.root,
        value.root,
        path::join(value.root, metadata.target_dir),
        files,
        true,
    )?;
    let identity = text::StringBuilder::new();
    for file in files {
        identity.write_string(file.name + ":" + hash::sha256(file.content));
    }
    let target = path::join(
        path::join(path::join(home, "projects"), value.name),
        hash::sha256(bytes::Bytes::from_string(identity.finish())),
    );
    if fs::is_file(path::join(target, manifest::FILENAME)) {
        return Result::Ok(target)
    }
    let dependencies = config::development_dependencies(
        metadata.dependencies,
        metadata.dev_dependencies,
    );
    let requirements = verify_requirements(modules, dependencies)?;
    let requirements = if value.example {
        json::encode(json::Value::String(context.graph.module_path)) + " = \"0.0.0\"\n"
            + requirements
    } else {
        requirements
    };
    let manifest_source = if value.example {
        "[module]\npath = " + json::encode(json::Value::String(value.module_path)) + "\n"
    } else {
        fs::read_file_structured(path::join(value.root, manifest::FILENAME)).driver_result()?
    };
    let retained = Vec::new();
    for file in files {
        if file.name != manifest::FILENAME {
            retained.push(file)
        }
    }
    fs::create_dir_all(target).driver_result()?;
    write_verify_files(target, retained)?;
    if !fs::is_file(path::join(target, "go.mod")) {
        fs::write_file_structured(
            path::join(target, "go.mod"),
            "module goml.local/verify\n\ngo 1.26.0\n",
        ).driver_result()?;
    }
    fs::write_file_structured(
        path::join(target, manifest::FILENAME),
        verify_manifest(manifest_source, requirements),
    ).driver_result()?;
    Result::Ok(target)
}

fn run_verify_child(
    context: project::Context,
    home: string,
    directory: string,
    module_path: string,
    args: Vec[string],
) -> Result[(), failure::Failure] {
    let segments = text::split(module_path, "::");
    let executable = path::join(directory, "_artifact/bin/" + segments[segments.len() - 1]);
    let driver = env::current_exe_structured().driver_result()?;
    let status = process::Command::new(driver).args(args).arg("--compiler").arg(context.compiler).current_dir(
        directory,
    ).env("GOML_HOME", home).env("GOML_WORKSPACE", "off").env("GOML_VERIFY_BINARY", executable).env(
        "GOML_VERIFY_DRIVER",
        driver,
    ).status_structured().driver_result()?;
    if status.success() {
        Result::Ok(())
    } else {
        Result::Err(failure::convert("downstream verification failed in " + directory))
    }
}

pub fn verify_module(context: project::Context, options: VerifyOptions) -> Result[
    (),
    failure::Failure,
] {
    let cases = verify_cases(context, options)?;
    if options.dry_run {
        for value in cases {
            io::println("verify " + value.name + " against an isolated registry snapshot");
        }
        return Result::Ok(())
    }
    let modules = verify_modules(context)?;
    let home = verify_snapshot(context, modules)?;
    for value in cases {
        io::eprintln("verifying " + value.name);
        let directory = materialize_verify_case(context, modules, home, value)?;
        run_verify_child(
            context,
            home,
            directory,
            value.module_path,
            Vec::from_array(
                ["build", "--ffi-check", options.ffi_check, "--jobs", options.jobs.to_string()],
            ),
        )?;
        let args = Vec::from_array(["test", "--ffi-check", options.ffi_check]);
        for argument in options.test_arguments {
            args.push(argument)
        }
        run_verify_child(context, home, directory, value.module_path, args)?;
    }
    io::eprintln("verified " + cases.len().to_string() + " downstream cases");
    Result::Ok(())
}
