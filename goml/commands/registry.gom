package commands;

use module::failure;
use failure::DriverResult;
use module::manifest;
use module::registry;
use std::bytes;
use std::env;
use std::error;
use error::ReportContext;
use std::fs;
use std::io;
use std::path;
use std::process;
use std::text;
use std::utf8;
use utf8::BytesUtf8;

const REGISTRY_SECTION: string = "registry";

const DEFAULT_REGISTRY_KEY: string = "default";

const LOCAL_REGISTRY_OPTION: string = "--local-registry";

fn command_output(value: bytes::Bytes) -> string {
    value.to_string_utf8().unwrap_or("<non-UTF-8 output>")
}

fn run_git(arguments: Vec[string]) -> Result[(), failure::Failure] {
    let command = process::Command::new("git");
    for argument in arguments {
        let _ = command.arg(argument);
    }
    let output = command.output_structured().driver_result().context("run git for registry")?;
    if process::ExitStatus::success(process::Output::status(output)) {
        Result::Ok(())
    } else {
        let message = text::trim(command_output(process::Output::stderr(output)));
        if message == "" {
            Result::Err(failure::convert("git command failed"))
        } else {
            Result::Err(failure::convert("git command failed: " + message))
        }
    }
}

fn config_path() -> Result[string, failure::Failure] {
    home_directory().driver_result().map(|home| path::join(home, "config.toml"))
}

fn config_registry_source() -> Result[string, failure::Failure] {
    let config = config_path()?;
    if !fs::is_file(config) {
        ensure_home_layout().driver_result()?;
        fs::write_file_structured(
            config,
            \\[registry]
            \\default = ""
            \\
            ,
        ).driver_result()?
    }
    let source = fs::read_file_structured(config).driver_result()?;
    let mut section = "";
    for original in text::lines(source) {
        let line = text::trim(original);
        if line.starts_with("[") && line.ends_with("]") {
            section = line.byte_slice(1, line.byte_len() - 1);
        } else if section == REGISTRY_SECTION && line.starts_with(DEFAULT_REGISTRY_KEY) {
            let mut equals = -1;
            for index in 0..line.byte_len() {
                if equals < 0 && line.byte_get(index) == b'=' {
                    equals = index;
                }
            }
            if equals >= 0 {
                let value = text::trim(line.byte_slice(equals + 1, line.byte_len()));
                if value.byte_len() >= 2 && value.byte_get(0) == b'"'
                    && value.byte_get(value.byte_len() - 1) == b'"' {
                    let value = value.byte_slice(1, value.byte_len() - 1);
                    if value != "" {
                        return Result::Ok(value)
                    }
                }
            }
        }
    }
    Result::Err(
        failure::convert(
            f"registry.default is not configured in {config}; set it or use --local-registry",
        ),
    )
}

fn option_local_registry(args: Vec[string], index: isize) -> Result[
    (Option[string], isize),
    failure::Failure,
] {
    let argument = args[index];
    let inline_prefix = LOCAL_REGISTRY_OPTION + "=";
    if argument == LOCAL_REGISTRY_OPTION {
        if index + 1 >= args.len() {
            Result::Err(failure::convert(LOCAL_REGISTRY_OPTION + " requires a value"))
        } else {
            let value = args[index + 1];
            Result::Ok((Option::Some(value), index + 2))
        }
    } else if argument.starts_with(inline_prefix) {
        let value = argument.byte_slice(inline_prefix.byte_len(), argument.byte_len());
        if value == "" {
            Result::Err(failure::convert(LOCAL_REGISTRY_OPTION + " requires a value"))
        } else {
            Result::Ok((Option::Some(value), index + 1))
        }
    } else {
        Result::Ok((Option::None, index))
    }
}

fn registry_argument(args: Vec[string]) -> Result[Option[string], failure::Failure] {
    let mut value: Option[string] = Option::None;
    let mut index = 2;
    while index < args.len() {
        let parsed = option_local_registry(args, index)?;
        index = parsed.1;
        match parsed.0 {
            Some(registry) => match value {
                Some(_) => return Result::Err(
                    failure::convert(LOCAL_REGISTRY_OPTION + " cannot be repeated"),
                ),
                None => {
                    value = Option::Some(registry);
                },
            },
            None => return Result::Err(failure::convert("unexpected argument " + args[index])),
        }
    }
    Result::Ok(value)
}

pub fn update_registry(args: Vec[string]) -> Result[(), failure::Failure] {
    let local = registry_argument(args)?;
    let source = match local {
        Some(value) => value,
        None => config_registry_source()?,
    };
    ensure_home_layout().driver_result()?;
    let cache = registry::cached_root()?;
    if fs::exists(cache) {
        if !fs::is_dir(path::join(cache, ".git")) {
            return Result::Err(
                failure::convert(f"cached registry path {cache} exists but is not a git repository"),
            )
        }
        run_git(Vec::from_array(["-C", cache, "remote", "set-url", "origin", source]))?;
        run_git(Vec::from_array(["-C", cache, "pull", "--ff-only"]))?
    } else {
        run_git(Vec::from_array(["clone", source, cache]))?
    }
    registry::validate(cache)?;
    io::println("updated registry cache at " + cache);
    Result::Ok(())
}

fn module_root() -> Result[string, failure::Failure] {
    let current = env::current_dir_structured().driver_result()?;
    let mut directory = current;
    loop {
        let manifest_path = path::join(directory, manifest::FILENAME);
        if fs::is_file(manifest_path) {
            if let Ok(_) = manifest::load(manifest_path) {
                return Result::Ok(directory)
            }
        }
        match path::parent(directory) {
            Some(parent) => if parent == directory {
                return Result::Err(
                    failure::convert(
                        "no goml.toml with [module] section found in ancestors of " + current,
                    ),
                )
            } else {
                directory = parent;
            },
            None => return Result::Err(
                failure::convert(
                    "no goml.toml with [module] section found in ancestors of " + current,
                ),
            ),
        }
    }
}

fn dependency_line_name(line: string) -> Option[string] {
    let line = text::trim(line);
    if line.byte_len() < 3 || (line.byte_get(0) != b'"' && line.byte_get(0) != b'\'') {
        return Option::None
    }
    for index in 1..line.byte_len() {
        if line.byte_get(index) == line.byte_get(0) {
            let rest = text::trim(line.byte_slice(index + 1, line.byte_len()));
            if rest.starts_with("=") {
                return Option::Some(line.byte_slice(1, index))
            } else {
                return Option::None
            }
        }
    }
    Option::None
}

fn section_name(line: string) -> Option[string] {
    let line = text::trim(line);
    if line.starts_with("[") {
        if let Some((name, rest)) = line.byte_slice(1, line.byte_len()).split_once("]") {
            if rest.trim() == "" || rest.trim().starts_with("#") {
                return Option::Some(name.trim())
            }
        }
    }
    Option::None
}

fn upsert_dependency(manifest_path: string, name: string, version: string) -> Result[
    (),
    failure::Failure,
] {
    upsert_dependency_entry(manifest_path, name, f"\"{name}\" = \"{version}\"")
}

fn upsert_dependency_entry(manifest_path: string, name: string, entry: string) -> Result[
    (),
    failure::Failure,
] {
    let source = fs::read_file_structured(manifest_path).driver_result()?;
    let result: Vec[string] = Vec::new();
    let mut in_dependencies = false;
    let mut inserted = false;
    let mut dependency_section_exists = false;
    let lines = manifest_edit_lines(source);
    for line in lines {
        match section_name(line) {
            Some(section) => {
                if in_dependencies && !inserted {
                    result.push(entry);
                    inserted = true;
                }
                in_dependencies = section == "dependencies";
                if in_dependencies {
                    dependency_section_exists = true;
                }
                result.push(line)
            },
            None => {
                if in_dependencies
                    && match dependency_line_name(line) {
                        Some(value) => value == name,
                        None => false,
                    } {
                    result.push(entry);
                    inserted = true;
                } else {
                    result.push(line)
                }
            },
        }
    }
    if !dependency_section_exists {
        if !result.is_empty() && result[result.len() - 1] != "" {
            result.push("")
        }
        result.push("[dependencies]");
        result.push(entry)
    } else if !inserted {
        result.push(entry)
    }
    fs::write_file_structured(manifest_path, text::join(result, "\n") + "\n").driver_result()
}

fn remove_dependency_line(manifest_path: string, name: string) -> Result[(), failure::Failure] {
    let source = fs::read_file_structured(manifest_path).driver_result()?;
    let result: Vec[string] = Vec::new();
    let buffer: Vec[string] = Vec::new();
    let mut in_dependencies = false;
    let kept = Ref::new(0);
    let flush = |result: Vec[string], buffer: Vec[string], kept: Ref[isize]| {
        if kept.get() > 0 {
            result.push("[dependencies]");
            for value in buffer {
                result.push(value)
            }
        }
        buffer.clear();
        kept.set(0)
    };
    for line in manifest_edit_lines(source) {
        match section_name(line) {
            Some(section) => {
                if in_dependencies {
                    flush(result, buffer, kept)
                }
                if section == "dependencies" {
                    in_dependencies = true;
                } else {
                    in_dependencies = false;
                    result.push(line)
                }
            },
            None => if in_dependencies {
                match dependency_line_name(line) {
                    Some(value) => if value == name {} else {
                        kept.set(kept.get() + 1);
                        buffer.push(line)
                    },
                    None => buffer.push(line),
                }
            } else {
                result.push(line)
            },
        }
    }
    if in_dependencies {
        flush(result, buffer, kept)
    }
    while result.len() > 1 && result[result.len() - 1] == "" && result[result.len() - 2] == "" {
        let _ = result.remove(result.len() - 1);
    }
    fs::write_file_structured(manifest_path, text::join(result, "\n") + "\n").driver_result()
}

fn command_registry_root(local: Option[string]) -> Result[string, failure::Failure] {
    let root = match local {
        Some(value) => value,
        None => registry::cached_root()?,
    };
    if !fs::is_dir(root) {
        return Result::Err(
            failure::convert(
                f"registry cache not found at {root}; run `goml update` or use --local-registry",
            ),
        )
    }
    match registry::validate(root) {
        Ok(()) => Result::Ok(root),
        Err(message) => Result::Err(message),
    }
}

fn dependency_command_args(args: Vec[string]) -> Result[(string, Option[string]), failure::Failure] {
    let mut dependency: Option[string] = Option::None;
    let mut local: Option[string] = Option::None;
    let mut index = 2;
    while index < args.len() {
        let parsed = option_local_registry(args, index)?;
        index = parsed.1;
        match parsed.0 {
            Some(value) => match local {
                Some(_) => return Result::Err(
                    failure::convert(LOCAL_REGISTRY_OPTION + " cannot be repeated"),
                ),
                None => {
                    local = Option::Some(value);
                },
            },
            None => {
                let argument = args[index];
                if argument.starts_with("-") {
                    return Result::Err(failure::convert("unknown option " + argument))
                } else {
                    match dependency {
                        Some(_) => return Result::Err(
                            failure::convert("unexpected argument " + argument),
                        ),
                        None => {
                            dependency = Option::Some(argument);
                            index += 1;
                        },
                    }
                }
            },
        }
    }
    dependency.map(|value| (value, local)).ok_or(failure::convert("dependency is required"))
}

pub fn add_dependency(args: Vec[string]) -> Result[(), failure::Failure] {
    if add_path_dependency(args)? {
        return Result::Ok(())
    }
    let parsed = dependency_command_args(args)?;
    let spec = parsed.0;
    let local = parsed.1;
    let parts = text::split(spec, "@");
    if parts.len() > 2 {
        return Result::Err(failure::convert("invalid dependency " + spec))
    }
    let name = parts[0];
    registry::validate_coordinate(name)?;
    let root = command_registry_root(local)?;
    let version = if parts.len() == 2 {
        registry::select_version(root, name, parts[1])?
    } else {
        registry::latest_version(root, name)?
    };
    let module = module_root()?;
    upsert_dependency(path::join(module, manifest::FILENAME), name, version)?;
    io::println(f"added {name} = {version}");
    Result::Ok(())
}

pub fn remove_dependency(args: Vec[string]) -> Result[(), failure::Failure] {
    let parsed = dependency_command_args(args)?;
    let name = text::trim(parsed.0);
    manifest::validate_dependency_name(name).driver_result()?;
    let module = module_root()?;
    remove_dependency_line(path::join(module, manifest::FILENAME), name)?;
    io::println("removed " + name);
    Result::Ok(())
}
