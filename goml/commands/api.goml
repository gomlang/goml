package commands;

use module::build;
use module::build_plan;
use module::failure;
use module::project;
use std::path;
use std::process;

pub fn api_snapshot(compiler: Option[string], target_dir: Option[string]) -> Result[
    isize,
    failure::Failure,
] {
    let context = project::load_context(target_dir, compiler)?;
    let plan = build_plan::check_plan(context, false)?;
    build::execute_plan(context, plan, false, 1)?;
    let args = Vec::from_array(["api-snapshot", "--module", context.graph.module_path]);
    for command in plan.commands {
        if let Compile { package_name, output, .. } = command {
            let mut local = false;
            for package_value in context.graph.packages {
                if package_value.name == package_name
                    && package_value.module_name == context.graph.module_path {
                    local = true;
                }
            }
            args.push(
                if local {
                    "--input"
                } else {
                    "--dependency"
                },
            );
            args.push(path::with_extension(output, "interface"));
        }
    }
    let status = process::Command::new(context.compiler).args(args).current_dir(
        context.graph.module_dir,
    ).status_structured().map_err(failure::convert)?;
    process::ExitStatus::code(status).ok_or(failure::convert("API snapshot terminated by signal"))
}

pub fn api_diff(compiler: Option[string], baseline: string, current: string) -> Result[
    isize,
    failure::Failure,
] {
    let compiler = project::compiler_path(compiler)?;
    let status = process::Command::new(compiler).args(
        Vec::from_array(["api-diff", baseline, current]),
    ).status_structured().map_err(failure::convert)?;
    process::ExitStatus::code(status).ok_or(failure::convert("API diff terminated by signal"))
}
