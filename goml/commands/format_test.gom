package commands;

use module::project;
use std::testing;

#[test]
fn formatting_graph_only_collects_owned_files() -> () {
    let graph = project::Graph {
        module_dir: "/workspace/app",
        module_path: "alice::app",
        entry_package: "alice::app",
        packages: Vec::from_array(
            [
                project::Package {
                    go_foreign: false,
                    name: "alice::app",
                    declared_name: "main",
                    module_name: "alice::app",
                    directory: "/workspace/app",
                    artifact_prefix: "pkg",
                    files: Vec::from_array(["/workspace/app/main.gom"]),
                    imports: Vec::from_array(["bob::dep"]),
                },
                project::Package {
                    go_foreign: false,
                    name: "bob::dep",
                    declared_name: "dep",
                    module_name: "bob::dep",
                    directory: "/registry/bob/dep",
                    artifact_prefix: "deps/bob/dep",
                    files: Vec::from_array(["/registry/bob/dep/dep.gom"]),
                    imports: Vec::new(),
                },
            ],
        ),
        sources: Vec::new(),
        order: Vec::from_array(["bob::dep", "alice::app"]),
    };
    let files = Vec::new();
    collect_owned_graph_files(graph, graph.module_path, files);
    testing::assert_eq(files.len(), 1);
    testing::assert_eq(files[0], "/workspace/app/main.gom")
}
