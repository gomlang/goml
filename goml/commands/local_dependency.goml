package commands;

use module::failure;
use failure::DriverResult;
use module::manifest;
use std::fs;
use std::io;
use std::json;
use std::path;

fn dependency_section_args(args: Vec[string]) -> Result[(Vec[string], string), failure::Failure] {
    let filtered = Vec::new();
    let mut development = false;
    for argument in args {
        if argument == "--dev" {
            if development {
                return Err(failure::convert("--dev cannot be repeated"))
            }
            development = true;
        } else {
            filtered.push(argument)
        }
    }
    Ok(
        (
            filtered,
            if development {
                "dev-dependencies"
            } else {
                "dependencies"
            },
        ),
    )
}

fn add_path_dependency(args: Vec[string], section: string) -> Result[bool, failure::Failure] {
    let filtered = Vec::from_array([args[0], args[1]]);
    let mut local: Option[string] = None;
    let mut index = 2;
    while index < args.len() {
        let argument = args[index];
        if argument == "--path" || argument.starts_with("--path=") {
            if local.is_some() {
                return Err(failure::convert("--path cannot be repeated"))
            }
            if argument == "--path" {
                if index + 1 >= args.len() {
                    return Err(failure::convert("--path requires a value"))
                }
                local = Some(args[index + 1]);
                index += 2;
            } else {
                local = Some(argument.byte_slice(7, argument.byte_len()));
                index += 1;
            }
        } else {
            filtered.push(argument);
            index += 1;
        }
    }
    let Some(local) = local else {
        return Ok(false)
    };
    if local == "" {
        return Err(failure::convert("--path requires a value"))
    }
    let (spec, registry) = dependency_command_args(filtered)?;
    if registry.is_some() {
        return Err(failure::convert("--path conflicts with --local-registry"))
    }
    if spec.contains("@") {
        return Err(
            failure::convert("dependencies are unversioned; use the module name without @version"),
        )
    }
    let name = spec;
    manifest::validate_dependency_name(name).driver_result()?;
    let directory = fs::canonicalize(local).driver_result()?;
    let dependency = manifest::load_structured(path::join(directory, manifest::FILENAME))?;
    if dependency.module_path != name {
        return Err(
            failure::convert(
                "dependency " + name + " declares module path " + dependency.module_path,
            ),
        )
    }
    let root = module_root()?;
    if root == directory {
        return Err(failure::convert("a module cannot depend on itself"))
    }
    let relative = path::relative(root, directory).driver_result()?;
    let entry = json::encode(json::Value::String(name)) + " = { path = "
        + json::encode(json::Value::String(relative))
        + " }";
    upsert_dependency_entry(path::join(root, manifest::FILENAME), name, entry, section)?;
    refresh_dependency_lock(root, None)?;
    io::println("added " + name + " from " + relative);
    Ok(true)
}
