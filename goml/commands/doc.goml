package commands;

use module::failure;
use failure::DriverResult;
use module::project;
use module::util;
use std::env;
use std::fs;
use std::io;
use std::path;
use std::process;
use std::text;

pub struct DocOptions {
    pub format: string,
    pub target_dir: Option[string],
    pub compiler: Option[string],
    pub documenter: Option[string],
    pub private_items: bool,
    pub dry_run: bool,
}

fn documenter_program(explicit: Option[string]) -> Result[string, failure::Failure] {
    let configured = explicit.unwrap_or(env::var_structured("GOMLDOC").unwrap_or(""));
    if configured != "" {
        return if fs::is_file(configured) {
            fs::canonicalize(configured).map_err(failure::convert)
        } else {
            process::look_path_structured(configured).map_err(failure::convert)
        }
    }
    if let Ok(executable) = env::current_exe_structured() {
        if let Some(parent) = path::parent(executable) {
            let sibling = path::join(parent, "gomldoc");
            if fs::is_file(sibling) {
                return Result::Ok(sibling)
            }
        }
    }
    if let Ok(home) = home_directory() {
        let installed = path::join(path::join(home, "bin"), "gomldoc");
        if fs::is_file(installed) {
            return Result::Ok(installed)
        }
    }
    process::look_path_structured("gomldoc").map_err(
        |error| failure::convert(error).context("failed to find gomldoc"),
    )
}

pub fn document_module(options: DocOptions) -> Result[isize, failure::Failure] {
    let context = project::load_context(options.target_dir, options.compiler)?;
    let program = documenter_program(options.documenter)?;
    let args = Vec::from_array(
        [
            context.graph.module_dir,
            "--format",
            options.format,
            "--target-dir",
            context.artifact_root,
            "--output",
            path::join(context.artifact_root, "doc"),
        ],
    );
    if options.private_items {
        args.push("--document-private-items")
    }
    if options.dry_run {
        let values = Vec::new();
        values.push(util::shell_escape(program));
        for argument in args {
            values.push(util::shell_escape(argument))
        }
        io::println(text::join(values, " "));
        return Result::Ok(0)
    }
    let command = process::Command::new(program).args(args).current_dir(context.graph.module_dir);
    let status = command.status_structured().driver_result()?;
    process::ExitStatus::code(status).ok_or(failure::convert("gomldoc terminated by signal"))
}
