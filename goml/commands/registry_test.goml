package commands;

use module::manifest;
use module::test_support;
use std::testing;

#[test]
fn local_registry_requires_nonempty_values_in_both_option_forms() -> () {
    for args in Vec::from_array(
        [
            Vec::from_array(["goml", "update", "--local-registry", ""]),
            Vec::from_array(["goml", "update", "--local-registry="]),
            Vec::from_array(["goml", "update", "--local-registry"]),
        ],
    ) {
        let error = testing::expect_err(registry_argument(args), "empty registry option");
        test_support::assert_contains(error.to_string(), "--local-registry requires a value");
    }
}

#[test]
fn dependency_edits_preserve_bare_keys_and_decode_escaped_keys() -> () {
    let root = test_support::workspace("dependency_edit_key_syntax");
    let file = root + "/goml.toml";
    test_support::write_file(
        file,
        "[module]\npath = \"demo::app\"\n[dependencies]\nlocal = true\n\"demo::\\u006ceaf\" = true\n",
    );
    testing::expect_ok(remove_dependency_line(file, "demo::leaf", "dependencies"), "remove key");
    let remaining = testing::expect_ok(manifest::load(file), "remaining manifest");
    testing::assert_eq(remaining.dependencies.len(), 1);
    testing::assert_eq(remaining.dependencies[0].name, "local");
    testing::expect_ok(upsert_dependency(file, "local", "dependencies"), "replace bare key");
    let updated = testing::expect_ok(manifest::load(file), "updated manifest");
    testing::assert_eq(updated.dependencies.len(), 1);
    testing::assert_eq(updated.dependencies[0].name, "local");
}

#[test]
fn dependency_upserts_replace_all_dotted_fields_with_one_entry() -> () {
    let root = test_support::workspace("dependency_edit_dotted_fields");
    let file = root + "/goml.toml";
    test_support::write_file(
        file,
        "[module]\npath = \"demo::app\"\n[dependencies]\nlocal.path = \"../local\"\nlocal.version = \"0.1.0\"\nother = true\n",
    );
    testing::expect_ok(upsert_dependency(file, "local", "dependencies"), "replace dotted fields");
    let updated = testing::expect_ok(manifest::load(file), "updated manifest");
    testing::assert_eq(updated.dependencies.len(), 2);
    testing::assert_eq(updated.dependencies[0].name, "local");
    testing::assert(updated.dependencies[0].path.is_none());
    testing::assert_eq(updated.dependencies[1].name, "other");
}
