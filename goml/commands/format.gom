package commands;

use module::failure;
use module::project;
use module::util;
use std::env;
use std::fs;
use std::path;
use std::process;

fn canonical(value: string) -> Result[string, failure::Failure] {
    fs::canonicalize(value).map_err(
        |error| failure::convert(error).context(f"failed to resolve {value}"),
    )
}

fn resolve_program(value: string) -> Result[string, failure::Failure] {
    if fs::is_file(value) {
        canonical(value)
    } else {
        match process::look_path_structured(value) {
            Ok(value) => canonical(value),
            Err(message) => Result::Err(failure::convert(message).context("failed to find gomlfmt")),
        }
    }
}

fn default_formatter_candidate() -> string {
    if let Ok(value) = env::current_exe_structured() {
        if let Some(parent) = path::parent(value) {
            let sibling = path::join(parent, "gomlfmt");
            if fs::is_file(sibling) {
                return sibling
            }
        }
    }
    match home_directory() {
        Ok(home) => {
            let installed = path::join(path::join(home, "bin"), "gomlfmt");
            if fs::is_file(installed) {
                installed
            } else {
                "gomlfmt"
            }
        },
        Err(_) => "gomlfmt",
    }
}

fn formatter_candidate(explicit: Option[string]) -> string {
    match explicit {
        Some(value) => value,
        None => match env::var_structured("GOMLFMT") {
            Ok(value) => if value != "" {
                value
            } else {
                default_formatter_candidate()
            },
            Err(_) => default_formatter_candidate(),
        },
    }
}

fn collect_owned_graph_files(graph: project::Graph, module_path: string, result: Vec[string]) -> () {
    for package_value in graph.packages {
        if package_value.module_name == module_path {
            for file in package_value.files {
                result.push(file)
            }
        }
    }
}

fn module_format_files(context: project::Context) -> Result[Vec[string], failure::Failure] {
    let files: Vec[string] = Vec::new();
    collect_owned_graph_files(context.graph, context.graph.module_path, files);
    let internal = project::internal_test_graphs(context)?;
    for graph in internal {
        collect_owned_graph_files(graph, context.graph.module_path, files)
    }
    let external = project::external_test_graphs(context)?;
    for test in external {
        collect_owned_graph_files(test.graph, context.graph.module_path, files)
    }
    Result::Ok(util::sorted_unique(files))
}

fn relative_path(root: string, value: string) -> string {
    if value == root {
        "."
    } else {
        value.byte_slice(root.byte_len() + 1, value.byte_len())
    }
}

pub fn format_module(check: bool, formatter_override: Option[string]) -> Result[
    isize,
    failure::Failure,
] {
    let context = project::load_context(Option::None, Option::None)?;
    let module_root = context.graph.module_dir;
    let files = module_format_files(context)?;
    if files.is_empty() {
        return Result::Ok(0)
    }
    let formatter = resolve_program(formatter_candidate(formatter_override))?;
    let command = process::Command::new(formatter).arg(
        if check {
            "--check"
        } else {
            "-w"
        },
    ).current_dir(module_root);
    for file in files {
        let _ = command.arg(relative_path(module_root, file));
    }
    match command.status_structured() {
        Ok(status) => process::ExitStatus::code(status).ok_or(
            failure::convert("gomlfmt terminated by signal"),
        ),
        Err(error) => Result::Err(failure::convert(error)),
    }
}
