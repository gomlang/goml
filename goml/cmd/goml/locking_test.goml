package main;

use module::registry;
use module::test_support;
use std::fs;
use std::testing;

fn locking_check_arguments(offline: bool) -> Vec[string] {
    let values = Vec::from_array(
        ["check", "--locked", "--dry-run", "--compiler", test_support::gomlc_binary()],
    );
    if offline {
        values.push("--offline");
    }
    values
}

#[test]
fn locking_cli_requires_matching_lock_even_without_dependencies() -> () {
    let root = test_support::workspace("locking_cli_empty");
    test_support::write_file(root + "/app/goml.toml", "[module]\npath = \"demo::app\"\n");
    test_support::write_file(root + "/app/main.goml", "package main; fn main() -> () {}\n");
    let missing = central_registry_command(root, locking_check_arguments(false));
    test_support::assert_failure(missing);
    test_support::assert_contains(test_support::stderr(missing), "goml.lock is required");
    testing::assert(!fs::exists(root + "/app/goml.lock"));
    test_support::assert_success(
        central_registry_command(root, Vec::from_array(["lock", "--offline"])),
    );
    let original = test_support::read_file(root + "/app/goml.lock");
    test_support::assert_success(central_registry_command(root, locking_check_arguments(true)));
    test_support::write_file(root + "/leaf/goml.toml", "[module]\npath = \"demo::leaf\"\n");
    test_support::write_file(
        root + "/leaf/lib.goml",
        "package leaf; pub fn value() -> isize { 1 }\n",
    );
    test_support::write_file(
        root + "/app/goml.toml",
        "[module]\npath = \"demo::app\"\n[dependencies]\n\"demo::leaf\" = { path = \"../leaf\" }\n",
    );
    let stale = central_registry_command(root, locking_check_arguments(true));
    test_support::assert_failure(stale);
    test_support::assert_contains(test_support::stderr(stale), "does not match");
    testing::assert_eq(original, test_support::read_file(root + "/app/goml.lock"));
    test_support::assert_success(
        central_registry_command(root, Vec::from_array(["lock", "--offline"])),
    );
    test_support::assert_success(central_registry_command(root, locking_check_arguments(true)));
    test_support::write_file(root + "/app/goml.toml", "[module]\npath = \"demo::app\"\n");
    test_support::assert_failure(central_registry_command(root, locking_check_arguments(true)));
}

#[test]
fn locking_cli_keeps_pins_fetches_exact_commits_and_updates_explicitly() -> () {
    let root = test_support::workspace("locking_cli_git");
    let leaf = git_module(root, "leaf", "", "package leaf; pub fn value() -> isize { 1 }");
    test_support::write_file(
        root + "/index/index.toml",
        "[modules.\"demo::leaf\"]\ngit = \"" + leaf + "\"\n",
    );
    registry_command("git", Vec::from_array(["init"]), root + "/index");
    commit_registry_fixture(root + "/index");
    test_support::write_file(
        root + "/app/goml.toml",
        "[module]\npath = \"demo::app\"\n[dependencies]\n\"demo::leaf\" = true\n",
    );
    test_support::write_file(
        root + "/app/main.goml",
        "package main; use demo::leaf; fn main() -> () { println(leaf::value()) }\n",
    );
    test_support::assert_success(central_registry_command(root, Vec::from_array(["lock"])));
    let original = test_support::read_file(root + "/app/goml.lock");
    let entry = testing::expect_some(
        testing::expect_ok(
            registry::locked_provenance(root + "/app", "demo::leaf"),
            "lock metadata",
        ),
        "leaf entry",
    );
    test_support::write_file(leaf + "/lib.goml", "package leaf; pub fn value() -> isize { 2 }");
    commit_registry_fixture(leaf);
    test_support::assert_success(central_registry_command(root, Vec::from_array(["lock"])));
    testing::assert_eq(original, test_support::read_file(root + "/app/goml.lock"));
    testing::expect_ok(
        fs::remove_dir_all(root + "/home/cache/registry/revisions"),
        "remove exact revision cache",
    );
    let absent = central_registry_command(root, locking_check_arguments(true));
    test_support::assert_failure(absent);
    test_support::assert_contains(test_support::stderr(absent), entry.revision);
    testing::assert(!fs::exists(root + "/home/cache/registry/revisions"));
    test_support::assert_success(central_registry_command(root, locking_check_arguments(false)));
    testing::assert_eq(original, test_support::read_file(root + "/app/goml.lock"));
    test_support::assert_success(central_registry_command(root, Vec::from_array(["update"])));
    let updated = testing::expect_some(
        testing::expect_ok(
            registry::locked_provenance(root + "/app", "demo::leaf"),
            "updated metadata",
        ),
        "updated leaf entry",
    );
    testing::assert(updated.revision != entry.revision);
    let update_offline = central_registry_command(root, Vec::from_array(["update", "--offline"]));
    test_support::assert_failure(update_offline);
    test_support::assert_contains(test_support::stderr(update_offline), "offline");
    test_support::assert_success(central_registry_command(root, locking_check_arguments(true)));
}
