package main;

use module::test_support;
use std::fs;
use std::json;
use std::path;
use std::process;
use std::testing;

fn project_description(root: string, source: string) -> json::Value {
    let output = testing::expect_ok(
        process::Command::new(test_support::goml_binary()).args(
            Vec::from_array(["__project-info", "--source", source]),
        ).current_dir(root).env("GOMLC", "/missing/compiler").env(
            "GOML_HOME",
            path::join(root, "home"),
        ).env("GOML_WORKSPACE", "off").output_structured(),
        "project description",
    );
    test_support::assert_success(output);
    let value = testing::expect_ok(json::parse(test_support::stdout(output)), "project JSON");
    testing::assert(json::field(value, "protocol").and_then(json::as_int) == Option::Some(1));
    value
}

#[test]
fn project_info_resolves_local_dependencies_without_compiling_or_fetching() -> () {
    let root = test_support::workspace("project_info_local");
    test_support::write_file(
        path::join(root, "goml.toml"),
        "[module]\npath = \"demo::app\"\n[dependencies]\n\"demo::leaf\" = { path = \"leaf\" }\n",
    );
    test_support::write_file(
        path::join(root, "leaf/goml.toml"),
        "[module]\npath = \"demo::leaf\"\n",
    );
    let value = project_description(root, path::join(root, "unsaved.goml"));
    let project = testing::expect_some(json::field(value, "project"), "project");
    testing::assert(
        json::field(project, "module").and_then(json::as_string) == Option::Some("demo::app"),
    );
    testing::assert(
        match json::field(project, "error") {
            Some(json::Value::Null) => true,
            _ => false,
        },
    );
    let modules = testing::expect_some(
        json::field(project, "modules").and_then(json::as_array),
        "modules",
    );
    testing::assert_eq(modules.len(), 2);
    testing::assert(!fs::exists(path::join(root, "_artifact")));
    testing::assert(!fs::exists(path::join(root, "home")));
}

#[test]
fn project_info_keeps_production_and_development_edges_separate() -> () {
    let root = test_support::workspace("project_info_development");
    test_support::write_file(
        path::join(root, "goml.toml"),
        "[module]\npath = \"demo::app\"\n[dev-dependencies]\n\"demo::helper\" = { path = \"helper\" }\n",
    );
    test_support::write_file(
        path::join(root, "helper/goml.toml"),
        "[module]\npath = \"demo::helper\"\n[dependencies]\n\"demo::app\" = { path = \"..\" }\n",
    );
    for (source, expected) in Vec::from_array(
        [("main.goml", 1), ("main_test.goml", 2), ("examples/basic/main.goml", 2)],
    ) {
        let value = project_description(root, path::join(root, source));
        let project = testing::expect_some(json::field(value, "project"), "project");
        testing::assert(
            match json::field(project, "error") {
                Some(json::Value::Null) => true,
                _ => false,
            },
        );
        let modules = testing::expect_some(
            json::field(project, "modules").and_then(json::as_array),
            "modules",
        );
        testing::assert_eq(modules.len(), expected);
        testing::assert_eq(
            testing::expect_some(
                json::field(modules[0], "dependencies").and_then(json::as_array),
                "production edges",
            ).len(),
            0,
        );
        testing::assert_eq(
            testing::expect_some(
                json::field(modules[0], "dev_dependencies").and_then(json::as_array),
                "development edges",
            ).len(),
            1,
        );
    }
}

#[test]
fn project_info_preserves_metadata_when_a_dependency_is_missing() -> () {
    let root = test_support::workspace("project_info_missing");
    test_support::write_file(
        path::join(root, "goml.toml"),
        "[module]\npath = \"demo::app\"\n[dependencies]\n\"demo::missing\" = true\n",
    );
    let value = project_description(root, path::join(root, "main.goml"));
    let project = testing::expect_some(json::field(value, "project"), "project");
    testing::assert(
        json::field(project, "module").and_then(json::as_string) == Option::Some("demo::app"),
    );
    testing::assert(json::field(project, "error").and_then(json::as_string).is_some());
    testing::assert(!fs::exists(path::join(root, "home")));
}
