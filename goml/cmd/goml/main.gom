package main;

use module::commands;
use module::project;
use module::runner;
use module::util;
use module::version;
use std::collections;
use std::env;
use std::fs;
use std::io;
use std::path;
use std::process;
use std::time;

const NEW_COMMAND: string = "new";

const CHECK_COMMAND: string = "check";

const BUILD_COMMAND: string = "build";

const BUILD_ARTIFACTS_COMMAND: string = "__build-artifacts";

const RUN_COMMAND_NAME: string = "run";

const TEST_COMMAND: string = "test";

const FMT_COMMAND: string = "fmt";

const CLEAN_COMMAND: string = "clean";

const UPDATE_COMMAND: string = "update";

const ADD_COMMAND: string = "add";

const REMOVE_COMMAND: string = "remove";

const HOME_COMMAND: string = "home";

const VERSION_COMMAND: string = "version";

const HELP_COMMAND: string = "help";

const INTERNAL_TEST_KIND: string = "internal";

const EXTERNAL_TEST_KIND: string = "external";

const ALL_TEST_KIND: string = "all";

const JSON_TEST_FORMAT: string = "json";

const TEXT_TEST_FORMAT: string = "text";

struct CliArgs {
    ffi_check: string,
    command: string,
    target: string,
    target_dir: Option[string],
    compiler: Option[string],
    dry_run: bool,
    include_tests: bool,
    program_args: Vec[string],
    test_filter: Option[string],
    build_jobs: isize,
    test_jobs: isize,
    test_list: bool,
    test_ignored: bool,
    test_include_ignored: bool,
    test_json: bool,
    test_nocapture: bool,
    test_timeout_ms: isize,
    test_seed: isize,
    test_kind: string,
}

struct FmtArgs {
    check: bool,
    formatter: Option[string],
}

fn fail(message: string) -> () {
    io::eprintln(f"error: {message}");
    process::exit(1)
}

fn top_help() -> string {
    \\Usage: goml <COMMAND>
    \\
    \\Commands:
    \\  new
    \\  check
    \\  build
    \\  bind-go
    \\  bind-c
    \\  export-go
    \\  run
    \\  test
    \\  fmt
    \\  clean
    \\  update
    \\  add
    \\  remove
    \\  home
    \\  version
    \\  help
    \\
    \\Options:
    \\  -h, --help  Print help
}

fn command_help(command: string) -> string {
    match command {
        "bind-go" => bind_go_help(),
        "bind-c" => bind_c_help(),
        EXPORT_GO_COMMAND => export_help(),
        NEW_COMMAND => "Usage: goml new [OPTIONS] <PROJECT_NAME>\n\nOptions:\n      --path <PATH>  [default: .]\n  -h, --help",
        CHECK_COMMAND => "Usage: goml check [OPTIONS]\n\nOptions:\n      --target-dir <TARGET_DIR>\n      --dry-run\n      --compiler <COMPILER>\n      --ffi-check <MODE>   [default: required] [possible values: required, off]\n      --jobs <JOBS>        [default: 16]\n      --tests\n  -h, --help",
        BUILD_COMMAND => "Usage: goml build [OPTIONS]\n\nOptions:\n      --target-dir <TARGET_DIR>\n      --dry-run\n      --compiler <COMPILER>\n      --ffi-check <MODE>   [default: required] [possible values: required, off]\n      --jobs <JOBS>        [default: 16]\n  -h, --help",
        RUN_COMMAND_NAME => "Usage: goml run [OPTIONS] [TARGET] [-- <ARGS>...]\n\nOptions:\n      --target-dir <TARGET_DIR>\n      --dry-run\n      --compiler <COMPILER>\n      --ffi-check <MODE>   [default: required] [possible values: required, off]\n      --jobs <JOBS>        [default: 16]\n  -h, --help",
        TEST_COMMAND => "Usage: goml test [OPTIONS] [FILTER]\n\nOptions:\n      --target-dir <TARGET_DIR>\n      --dry-run\n      --compiler <COMPILER>\n      --ffi-check <MODE>   [default: required] [possible values: required, off]\n      --list\n      --ignored\n      --include-ignored\n      --nocapture\n      --seed <SEED>\n      --format <FORMAT>    [default: text] [possible values: text, json]\n      --timeout <TIMEOUT>  [default: 30s]\n      --jobs <JOBS>        [default: 1]\n      --kind <KIND>        [default: all] [possible values: internal, external, all]\n  -h, --help",
        FMT_COMMAND => "Usage: goml fmt [OPTIONS]\n\nOptions:\n      --check                  exit 1 if formatting differs\n      --formatter <FORMATTER>  formatter executable\n  -h, --help",
        CLEAN_COMMAND => "Usage: goml clean [OPTIONS]\n\nOptions:\n      --target-dir <TARGET_DIR>\n  -h, --help",
        UPDATE_COMMAND => "Usage: goml update [OPTIONS]\n\nOptions:\n      --local-registry <PATH>\n  -h, --help",
        ADD_COMMAND => "Usage: goml add [OPTIONS] <DEPENDENCY>\n\nOptions:\n      --local-registry <PATH>\n  -h, --help",
        REMOVE_COMMAND => "Usage: goml remove [OPTIONS] <DEPENDENCY>\n\nOptions:\n      --local-registry <PATH>\n  -h, --help",
        _ => top_help(),
    }
}

fn inline_value(argument: string, name: string) -> Option[string] {
    let prefix = f"{name}=";
    if argument.starts_with(prefix) {
        Option::Some(argument.byte_slice(prefix.byte_len(), argument.byte_len()))
    } else {
        Option::None
    }
}

fn option_value(args: Vec[string], index: isize, argument: string, name: string) -> Result[
    (Option[string], isize),
    string,
] {
    if argument == name {
        if index + 1 >= args.len() {
            Result::Err(f"{name} requires a value")
        } else {
            let value = args[index + 1];
            Result::Ok((Option::Some(value), index + 2))
        }
    } else {
        match inline_value(argument, name) {
            Some(value) => {
                if value == "" {
                    Result::Err(f"{name} requires a value")
                } else {
                    Result::Ok((Option::Some(value), index + 1))
                }
            },
            None => Result::Ok((Option::None, index)),
        }
    }
}

fn parse_clean(args: Vec[string]) -> Result[Option[string], string] {
    let mut target_dir: Option[string] = Option::None;
    let mut index = 2;
    while index < args.len() {
        let argument = args[index];
        let parsed = option_value(args, index, argument, "--target-dir")?;
        index = parsed.1;
        match parsed.0 {
            Some(value) => match target_dir {
                Some(_) => {
                    return Result::Err("--target-dir cannot be repeated")
                },
                None => {
                    target_dir = Option::Some(value);
                },
            },
            None => if argument.starts_with("-") {
                return Result::Err(f"unknown option {argument}")
            } else {
                return Result::Err(f"unexpected argument {argument}")
            },
        }
    }
    Result::Ok(target_dir)
}

fn parse_fmt(args: Vec[string]) -> Result[FmtArgs, string] {
    let mut check = false;
    let mut formatter: Option[string] = Option::None;
    let mut index = 2;
    while index < args.len() {
        let argument = args[index];
        if argument == "-h" || argument == "--help" {
            return Result::Err(HELP_COMMAND)
        } else if argument == "--check" {
            if check {
                return Result::Err("--check cannot be repeated")
            } else {
                check = true;
                index += 1;
            }
        } else {
            let parsed = option_value(args, index, argument, "--formatter")?;
            index = parsed.1;
            match parsed.0 {
                Some(value) => match formatter {
                    Some(_) => {
                        return Result::Err("--formatter cannot be repeated")
                    },
                    None => {
                        formatter = Option::Some(value);
                    },
                },
                None => if argument.starts_with("-") {
                    return Result::Err(f"unknown option {argument}")
                } else {
                    return Result::Err(f"unexpected argument {argument}")
                },
            }
        }
    }
    Result::Ok(FmtArgs { check, formatter })
}

fn parse_duration(value: string) -> Result[isize, string] {
    let parts = if value.ends_with("ms") {
        (value.byte_slice(0, value.byte_len() - 2), 1)
    } else if value.ends_with("s") {
        (value.byte_slice(0, value.byte_len() - 1), 1000)
    } else if value.ends_with("m") {
        (value.byte_slice(0, value.byte_len() - 1), 60000)
    } else {
        return Result::Err("duration must end in ms, s, or m")
    };
    let Ok(parsed) = util::parse_positive_int(parts.0) else {
        return Result::Err(f"invalid duration `{value}`")
    };
    let duration = parsed * parts.1;
    if duration / parts.1 != parsed {
        Result::Err("duration is too large")
    } else {
        Result::Ok(duration)
    }
}

fn parse_cli(args: Vec[string]) -> Result[CliArgs, string] {
    if args.len() < 2 {
        return Result::Err(top_help())
    }
    let command = args[1];
    match command {
        CHECK_COMMAND | BUILD_COMMAND | BUILD_ARTIFACTS_COMMAND | RUN_COMMAND_NAME | TEST_COMMAND => (),
        _ => return Result::Err(f"unknown command {command}"),
    }
    let targets: Vec[string] = Vec::new();
    let mut target_dir: Option[string] = Option::None;
    let mut compiler: Option[string] = Option::None;
    let mut ffi_check: Option[string] = Option::None;
    let flags: collections::HashSet[string] = collections::HashSet::new();
    let program_args: Vec[string] = Vec::new();
    let mut test_filter: Option[string] = Option::None;
    let mut build_jobs = 16;
    let mut test_jobs = 1;
    let test_formats: Vec[string] = Vec::new();
    let mut test_timeout_ms = 30000;
    let mut test_seed = time::SystemTime::now().unix_nanoseconds().to_isize();
    let mut test_kind = ALL_TEST_KIND;
    let mut trailing = false;
    let mut index = 2;
    while index < args.len() {
        let argument = args[index];
        if trailing {
            if command == RUN_COMMAND_NAME {
                program_args.push(argument);
                index += 1;
            } else {
                return Result::Err(f"unexpected argument {argument}")
            }
        } else if argument == "--" {
            trailing = true;
            index += 1;
        } else if argument == "-h" || argument == "--help" {
            io::println(command_help(command));
            process::exit(0)
        } else if argument == "--ffi-check" || argument.starts_with("--ffi-check=") {
            if ffi_check.is_some() {
                return Result::Err("--ffi-check cannot be repeated")
            }
            let parsed = option_value(args, index, argument, "--ffi-check")?;
            index = parsed.1;
            let value = parsed.0.ok_or("--ffi-check requires a value")?;
            if value != "required" && value != "off" {
                return Result::Err("--ffi-check must be required or off")
            }
            ffi_check = Option::Some(value);
        } else if argument == "--dry-run" {
            let _ = flags.insert(argument);
            index += 1;
        } else if command == CHECK_COMMAND && argument == "--tests" {
            let _ = flags.insert(argument);
            index += 1;
        } else if command == TEST_COMMAND && argument == "--list" {
            let _ = flags.insert(argument);
            index += 1;
        } else if command == TEST_COMMAND && argument == "--ignored" {
            let _ = flags.insert(argument);
            index += 1;
        } else if command == TEST_COMMAND && argument == "--include-ignored" {
            let _ = flags.insert(argument);
            index += 1;
        } else if command == TEST_COMMAND && argument == "--nocapture" {
            let _ = flags.insert(argument);
            index += 1;
        } else if command == TEST_COMMAND
            && (argument == "--seed" || argument.starts_with("--seed=")) {
            let parsed_seed = option_value(args, index, argument, "--seed")?;
            index = parsed_seed.1;
            let Some(value) = parsed_seed.0 else {
                return Result::Err("--seed requires a value");
            };
            test_seed = util::parse_positive_int(value).map_err(
                |_| "--seed must be a positive integer",
            )?;
        } else {
            let parsed_target_dir = option_value(args, index, argument, "--target-dir")?;
            index = parsed_target_dir.1;
            if let Some(value) = parsed_target_dir.0 {
                if target_dir.is_some() {
                    return Result::Err("--target-dir cannot be repeated")
                } else {
                    target_dir = Option::Some(value);
                }
            } else {
                let parsed_compiler = option_value(args, index, argument, "--compiler")?;
                index = parsed_compiler.1;
                if let Some(value) = parsed_compiler.0 {
                    if compiler.is_some() {
                        return Result::Err("--compiler cannot be repeated")
                    } else {
                        compiler = Option::Some(value);
                    }
                } else if command == TEST_COMMAND {
                    let parsed_timeout = option_value(args, index, argument, "--timeout")?;
                    index = parsed_timeout.1;
                    if let Some(value) = parsed_timeout.0 {
                        test_timeout_ms = parse_duration(value)?;
                    } else {
                        let parsed_jobs = option_value(args, index, argument, "--jobs")?;
                        index = parsed_jobs.1;
                        if let Some(value) = parsed_jobs.0 {
                            let value = util::parse_positive_int(value)?;
                            test_jobs = value;
                            build_jobs = value;
                        } else {
                            let parsed_kind = option_value(args, index, argument, "--kind")?;
                            index = parsed_kind.1;
                            if let Some(value) = parsed_kind.0 {
                                match value {
                                    INTERNAL_TEST_KIND | EXTERNAL_TEST_KIND | ALL_TEST_KIND => {
                                        test_kind = value;
                                    },
                                    _ => return Result::Err(
                                        "--kind must be internal, external, or all",
                                    ),
                                }
                            } else {
                                let parsed_format = option_value(args, index, argument, "--format")?;
                                index = parsed_format.1;
                                match parsed_format.0 {
                                    Some(value) => match value {
                                        JSON_TEST_FORMAT | TEXT_TEST_FORMAT => {
                                            test_formats.push(value)
                                        },
                                        _ => return Result::Err("--format must be text or json"),
                                    },
                                    None => if argument.starts_with("-") {
                                        return Result::Err(f"unknown option {argument}")
                                    } else if test_filter.is_some() {
                                        return Result::Err(f"unexpected argument {argument}")
                                    } else {
                                        test_filter = Option::Some(argument);
                                        index += 1;
                                    },
                                }
                            }
                        }
                    }
                } else {
                    let parsed_jobs = option_value(args, index, argument, "--jobs")?;
                    index = parsed_jobs.1;
                    match parsed_jobs.0 {
                        Some(value) => match util::parse_positive_int(value) {
                            Ok(value) => {
                                build_jobs = value;
                            },
                            Err(message) => return Result::Err(message),
                        },
                        None => if argument.starts_with("-") {
                            return Result::Err(f"unknown option {argument}")
                        } else if (command == RUN_COMMAND_NAME || command == BUILD_ARTIFACTS_COMMAND)
                            && targets.is_empty() {
                            targets.push(argument);
                            index += 1;
                        } else {
                            return Result::Err(f"unexpected argument {argument}")
                        },
                    }
                }
            }
        }
    }
    let test_json = !test_formats.is_empty()
        && test_formats[test_formats.len() - 1] == JSON_TEST_FORMAT;
    if flags.contains("--ignored") && flags.contains("--include-ignored") {
        Result::Err("--ignored cannot be combined with --include-ignored")
    } else if test_json && flags.contains("--nocapture") {
        Result::Err("--nocapture cannot be combined with --format json")
    } else {
        Result::Ok(
            CliArgs {
                ffi_check: ffi_check.unwrap_or("required"),
                command,
                target: if !targets.is_empty() {
                    targets[0]
                } else {
                    "."
                },
                target_dir,
                compiler,
                dry_run: flags.contains("--dry-run"),
                include_tests: flags.contains("--tests"),
                program_args,
                test_filter,
                build_jobs,
                test_jobs,
                test_list: flags.contains("--list"),
                test_ignored: flags.contains("--ignored"),
                test_include_ignored: flags.contains("--include-ignored"),
                test_json,
                test_nocapture: flags.contains("--nocapture"),
                test_timeout_ms,
                test_seed,
                test_kind,
            },
        )
    }
}

fn run_project_command(args: CliArgs, context: project::Context) -> Result[(), string] {
    let plan = match args.command {
        CHECK_COMMAND => project::check_plan(context, args.include_tests),
        BUILD_COMMAND => project::build_plan(context),
        BUILD_ARTIFACTS_COMMAND => project::build_target_artifacts_plan(context),
        RUN_COMMAND_NAME => project::run_plan(context),
        _ => project::test_plan(context, args.test_kind),
    };
    let plan = plan?;
    let context = project::prepare_foreign_execution(context, plan, args.ffi_check, args.dry_run)?;
    project::execute_plan(context, plan, args.dry_run, args.build_jobs)?;
    if args.command == RUN_COMMAND_NAME {
        match plan.executable {
            Some(executable) => project::run_executable(
                context,
                executable,
                args.program_args,
                args.dry_run,
            ),
            None => Result::Err("build plan omitted executable"),
        }
    } else if args.command == TEST_COMMAND && !args.dry_run {
        let groups: Vec[runner::Group] = Vec::new();
        for group in plan.test_groups {
            groups.push(
                runner::Group {
                    kind: group.kind,
                    executable: group.runner,
                    manifest_path: group.manifest,
                },
            )
        }
        runner::run(
            context.graph.module_dir,
            groups,
            runner::Options {
                filter: args.test_filter,
                jobs: args.test_jobs,
                list: args.test_list,
                ignored: args.test_ignored,
                include_ignored: args.test_include_ignored,
                json: args.test_json,
                nocapture: args.test_nocapture,
                timeout_ms: args.test_timeout_ms,
                seed: args.test_seed,
            },
        )
    } else {
        Result::Ok(())
    }
}

fn run_command(args: CliArgs) -> Result[(), string] {
    let context_result = if args.command == RUN_COMMAND_NAME
        || args.command == BUILD_ARTIFACTS_COMMAND {
        project::load_target_context(args.target, args.target_dir, args.compiler)
    } else {
        project::load_context(args.target_dir, args.compiler)
    };
    let context = context_result?;
    if args.dry_run {
        run_project_command(args, context)
    } else {
        project::with_build_lock(context, || run_project_command(args, context))
    }
}

fn toolchain_finalize_value(args: Vec[string], name: string) -> Result[string, string] {
    let mut result: Option[string] = Option::None;
    let mut index = 2;
    while index < args.len() {
        if args[index] == name {
            if result.is_some() {
                return Result::Err(name + " cannot be repeated")
            } else if index + 1 >= args.len() {
                return Result::Err(name + " requires a value")
            } else {
                result = Option::Some(args[index + 1]);
                index += 2;
            }
        } else if args[index] == "--prefix" || args[index] == "--compiler" {
            index += 2;
        } else {
            return Result::Err("unexpected argument " + args[index])
        }
    }
    result.ok_or(name + " is required")
}

fn run_toolchain_finalize(args: Vec[string]) -> Result[(), string] {
    let prefix = fs::canonicalize(toolchain_finalize_value(args, "--prefix")?).map_err(
        |error| error.to_string(),
    )?;
    let compiler = match toolchain_finalize_value(args, "--compiler") {
        Ok(value) => value,
        Err(message) => if message == "--compiler is required" {
            path::join(path::join(prefix, "bin"), "gomlc")
        } else {
            return Result::Err(message)
        },
    };
    let compiler = fs::canonicalize(compiler).map_err(|error| error.to_string())?;
    let context = project::load_toolchain_context(prefix, compiler)?;
    project::with_build_lock(
        context,
        || {
            let compiler_dir = path::join(path::join(prefix, "lib"), "compiler");
            let output = path::join(compiler_dir, "compiler-world-v2.gaf");
            let temporary = output + ".tmp";
            if fs::is_file(temporary) {
                if let Err(error) = fs::remove_file(temporary) {
                    return Result::Err(error.to_string())
                }
            }
            let plan = project::toolchain_world_plan(context, temporary)?;
            let jobs = match env::var_structured("GOML_BUILD_JOBS") {
                Ok(value) => util::parse_positive_int(value)?,
                Err(_) => 16,
            };
            project::execute_plan(context, plan, false, jobs)?;
            match fs::replace(temporary, output) {
                Ok(()) => Result::Ok(()),
                Err(error) => Result::Err(error.to_string()),
            }
        },
    )
}

fn main() -> () {
    let args = env::args();
    if args.len() == 1 {
        io::eprintln(top_help());
        process::exit(2)
    } else if args[1] == "-h" || args[1] == "--help" {
        io::println(top_help())
    } else {
        match args[1] {
            "bind-c" => if let Err(message) = run_bind_c_cli(args) {
                fail(message);
            },
            "bind-go" => if let Err(message) = run_bind_go_cli(args) {
                fail(message);
            },
            HELP_COMMAND => if args.len() == 2 {
                io::println(top_help())
            } else {
                io::println(command_help(args[2]))
            },
            VERSION_COMMAND => io::println(f"goml {version::current()}"),
            "__toolchain-finalize" => match run_toolchain_finalize(args) {
                Ok(()) => (),
                Err(message) => fail(message),
            },
            HOME_COMMAND => if args.len() == 3 && (args[2] == "-h" || args[2] == "--help") {
                io::println(
                    \\Usage: goml home
                    \\
                    \\Options:
                    \\  -h, --help
                    ,
                )
            } else if args.len() != 2 {
                fail(f"unexpected argument {args[2]}")
            } else {
                if let Err(message) = commands::print_home() {
                    fail(message)
                }
            },
            NEW_COMMAND => if args.len() >= 3 && (args[2] == "-h" || args[2] == "--help") {
                io::println(command_help(NEW_COMMAND))
            } else {
                if let Err(message) = commands::parse_new(args) {
                    fail(message)
                }
            },
            CLEAN_COMMAND => if args.len() >= 3 && (args[2] == "-h" || args[2] == "--help") {
                io::println(command_help(CLEAN_COMMAND))
            } else {
                match parse_clean(args) {
                    Ok(target_dir) => match project::clean(target_dir) {
                        Ok(()) => (),
                        Err(message) => fail(message),
                    },
                    Err(message) => fail(message),
                }
            },
            FMT_COMMAND => match parse_fmt(args) {
                Ok(options) => match commands::format_module(options.check, options.formatter) {
                    Ok(code) => if code == 0 {} else {
                        process::exit(code)
                    },
                    Err(message) => fail(message),
                },
                Err(message) => if message == HELP_COMMAND {
                    io::println(command_help(FMT_COMMAND))
                } else {
                    fail(message)
                },
            },
            UPDATE_COMMAND | ADD_COMMAND | REMOVE_COMMAND => if args.len() >= 3
                && (args[2] == "-h" || args[2] == "--help") {
                io::println(command_help(args[1]))
            } else {
                let result = match args[1] {
                    UPDATE_COMMAND => commands::update_registry(args),
                    ADD_COMMAND => commands::add_dependency(args),
                    _ => commands::remove_dependency(args),
                };
                if let Err(message) = result {
                    fail(message)
                }
            },
            EXPORT_GO_COMMAND => if let Err(message) = run_export_cli(args) {
                fail(message)
            },
            _ => match parse_cli(args) {
                Ok(value) => match run_command(value) {
                    Ok(()) => (),
                    Err(message) => fail(message),
                },
                Err(message) => fail(message),
            },
        }
    }
}
