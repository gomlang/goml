package main;

use module::test_support;
use std::fs;
use std::json;
use std::path;
use std::testing;

#[test]
fn performance_report_build_refreshes_cached_link_and_maps_sources() -> () {
    let root = test_support::workspace("performance_report_driver");
    test_support::write_basic_project(root, "performance_report");
    let args = Vec::from_array(["--explain-performance", "--format=json", "--pgo=off"]);
    let first = test_support::project_command("build", "", args, root);
    test_support::assert_success(first);
    let report = testing::expect_ok(json::parse(test_support::stdout(first)), "performance JSON");
    testing::assert_eq(
        json::field(report, "kind").and_then(json::as_string).unwrap_or(""),
        "goml-performance-build",
    );
    let reports = json::field(report, "reports").and_then(json::as_array).unwrap_or(Vec::new());
    testing::assert_eq(reports.len(), 1);
    let generated = path::join(root, "_artifact/build/pkg/performance_report/goml_generated.go");
    testing::assert_eq(
        json::field(reports[0], "generated_source_sha256").and_then(json::as_string).unwrap_or(""),
        testing::expect_ok(fs::sha256_file(generated), "generated digest"),
    );
    let sources = json::field(reports[0], "sources").and_then(json::as_array).unwrap_or(Vec::new());
    let mut found_main = false;
    for source in sources {
        if json::field(source, "source_package").and_then(json::as_string).unwrap_or("")
            == "performance_report" {
            testing::assert_eq(
                json::field(source, "source_file").and_then(json::as_string).unwrap_or(""),
                "main.goml",
            );
            testing::assert_eq(json::field(source, "line").and_then(json::as_int).unwrap_or(0), 3);
            found_main = true;
        }
    }
    testing::assert(found_main);
    test_support::write_file(generated + ".performance.json", "stale report");
    let refreshed = test_support::project_command("build", "", args, root);
    test_support::assert_success(refreshed);
    testing::assert(json::parse(test_support::read_file(generated + ".performance.json")).is_ok());
    let human = test_support::project_command(
        "build",
        "",
        Vec::from_array(["--explain-performance"]),
        root,
    );
    test_support::assert_success(human);
    test_support::assert_contains(test_support::stdout(human), "main.goml:3");
    test_support::assert_contains(test_support::stdout(human), "generated bytes");
}
