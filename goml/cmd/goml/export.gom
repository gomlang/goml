package main;

use module::project;
use module::util;
use std::io;

const EXPORT_GO_COMMAND: string = "export-go";

fn export_help() -> string {
    "Usage: goml export-go [PACKAGE_DIR] --import-path <PATH> --out <DIRECTORY>\n\nOptions:\n      --compiler <COMPILER>\n      --target-dir <DIRECTORY>\n      --ffi-check <MODE>  [default: required] [possible values: required, off]\n      --jobs <JOBS>       [default: 16]\n      --dry-run\n  -h, --help"
}

fn run_export_cli(args: Vec[string]) -> Result[(), string] {
    let values: HashMap[string, string] = HashMap::new();
    let mut source: Option[string] = Option::None;
    let mut dry_run = false;
    let mut positional = false;
    let mut index = 2;
    while index < args.len() {
        let argument = args[index];
        if !positional && (argument == "--help" || argument == "-h") {
            io::println(export_help());
            return Result::Ok(())
        }
        if !positional && argument == "--" {
            positional = true;
            index += 1;
            continue
        }
        if !positional && argument == "--dry-run" {
            if dry_run {
                return Result::Err("repeated --dry-run")
            }
            dry_run = true;
            index += 1;
            continue
        }
        if !positional && argument.starts_with("-") {
            let mut matched = false;
            for option in Vec::from_array(
                ["--import-path", "--out", "--compiler", "--target-dir", "--ffi-check", "--jobs"],
            ) {
                let parsed = option_value(args, index, argument, option)?;
                if let Some(value) = parsed.0 {
                    if value == "" || value.starts_with("--") {
                        return Result::Err(option + " requires a value")
                    }
                    if values[option].is_some() {
                        return Result::Err("repeated " + option)
                    }
                    values[option] = value;
                    index = parsed.1;
                    matched = true;
                    break
                }
            }
            if !matched {
                return Result::Err("unknown export-go option " + argument)
            }
        } else {
            if source.is_some() {
                return Result::Err("export-go accepts one package directory")
            }
            source = Option::Some(argument);
            index += 1;
        }
    }
    let output = values["--out"].ok_or("export-go requires --out")?;
    let import_path = values["--import-path"].ok_or("export-go requires --import-path")?;
    let mode = values["--ffi-check"].unwrap_or("required");
    if mode != "required" && mode != "off" {
        return Result::Err("--ffi-check must be required or off")
    }
    let jobs = match values["--jobs"] {
        Some(value) => util::parse_positive_int(value)?,
        None => 16,
    };
    let context = project::load_context(values["--target-dir"], values["--compiler"])?;
    project::export_go(
        context,
        project::ExportOptions { source, output, import_path, ffi_check: mode, jobs, dry_run },
    )
}
