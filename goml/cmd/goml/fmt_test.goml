package main;

use module::test_support;
use std::path;
use std::process;
use std::testing;

fn fmt_status_code(output: process::Output) -> isize {
    process::ExitStatus::code(process::Output::status(output)).unwrap_or(-1)
}

fn write_fmt_project(root: string) -> () {
    test_support::write_file(
        path::join(root, "goml.toml"),
        \\[module]
        \\path = "fmt_test"
        \\
        \\[build]
        \\target-dir = "build/output"
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "main.goml"),
        \\package main;
        \\fn main( )->(){()}
        \\
        ,
    );
}

#[test]
fn fmt_formats_module_from_nested_directory() -> () {
    let root = test_support::workspace("fmt_module");
    write_fmt_project(root);
    let source = path::join(path::join(root, "src"), "lib.goml");
    test_support::write_file(
        source,
        \\package lib;
        \\pub fn value( )->isize{1}
        \\
        ,
    );
    let test_source = path::join(root, "main_test.goml");
    test_support::write_file(
        test_source,
        \\package main;
        \\fn helper( )->(){()}
        \\
        ,
    );
    let ignored = Vec::from_array(
        [
            path::join(path::join(root, "build/output"), "invalid.goml"),
            path::join(path::join(root, ".hidden"), "invalid.goml"),
            path::join(path::join(root, "testdata"), "invalid.goml"),
        ],
    );
    for file in ignored {
        test_support::write_file(file, "invalid {")
    }
    let nested_module = path::join(root, "nested");
    test_support::write_file(
        path::join(nested_module, "goml.toml"),
        \\[module]
        \\path = "nested"
        \\
        ,
    );
    test_support::write_file(path::join(nested_module, "invalid.goml"), "invalid {");
    let external_test_source = path::join(path::join(root, "tests"), "main.goml");
    test_support::write_file(
        external_test_source,
        \\package tests;
        \\fn external_helper( )->(){()}
        \\
        ,
    );
    let output = test_support::run(Vec::from_array(["fmt"]), path::join(root, "src"));
    test_support::assert_success(output);
    testing::assert_eq(
        test_support::read_file(path::join(root, "main.goml")),
        \\package main;
        \\
        \\fn main() -> () {}
        \\
        ,
    );
    testing::assert_eq(
        test_support::read_file(source),
        \\package lib;
        \\
        \\pub fn value() -> isize {
        \\    1
        \\}
        \\
        ,
    );
    testing::assert_eq(
        test_support::read_file(test_source),
        \\package main;
        \\
        \\fn helper() -> () {}
        \\
        ,
    );
    testing::assert_eq(
        test_support::read_file(external_test_source),
        \\package tests;
        \\
        \\fn external_helper() -> () {}
        \\
        ,
    );
    for file in ignored {
        testing::assert_eq(test_support::read_file(file), "invalid {")
    }
    testing::assert_eq(
        test_support::read_file(path::join(nested_module, "invalid.goml")),
        "invalid {",
    )
}

#[test]
fn fmt_check_reports_differences_without_writing() -> () {
    let root = test_support::workspace("fmt_check");
    write_fmt_project(root);
    let main = path::join(root, "main.goml");
    let original = test_support::read_file(main);
    let changed = test_support::run(Vec::from_array(["fmt", "--check"]), root);
    testing::assert_eq(fmt_status_code(changed), 1);
    testing::assert_eq(test_support::read_file(main), original);
    test_support::assert_success(test_support::run(Vec::from_array(["fmt"]), root));
    test_support::assert_success(test_support::run(Vec::from_array(["fmt", "--check"]), root))
}

#[test]
fn fmt_does_not_write_when_any_file_is_invalid() -> () {
    let root = test_support::workspace("fmt_atomic");
    write_fmt_project(root);
    let main = path::join(root, "main.goml");
    let original = test_support::read_file(main);
    test_support::write_file(
        path::join(root, "invalid.goml"),
        \\package main;
        \\fn broken( {
        ,
    );
    let output = test_support::run(Vec::from_array(["fmt"]), root);
    testing::assert_eq(fmt_status_code(output), 2);
    testing::assert_eq(test_support::read_file(main), original)
}

#[test]
fn fmt_reports_missing_formatter() -> () {
    let root = test_support::workspace("fmt_missing_formatter");
    write_fmt_project(root);
    let missing = path::join(root, "missing-gomlfmt");
    let output = test_support::run(Vec::from_array(["fmt", "--formatter", missing]), root);
    test_support::assert_failure(output);
    test_support::assert_contains(test_support::stderr(output), "failed to find gomlfmt")
}
