package main;

use module::project;
use std::io;
use std::process;

fn bind_c_help() -> string {
    "Usage: goml bind-c <CONFIG> [OPTIONS]\n\nOptions:\n      --compiler <COMPILER>\n      --dry-run  validate paths and print outputs without writing\n      --check    verify generated bindings and print C input fingerprint\n  -h, --help"
}

fn run_bind_c_cli(args: Vec[string]) -> Result[(), string] {
    let forwarded = Vec::from_array(["bind-c"]);
    let mut compiler: Option[string] = Option::None;
    let mut positional = false;
    let mut index = 2;
    while index < args.len() {
        let argument = args[index];
        if !positional && (argument == "--help" || argument == "-h") {
            io::println(bind_c_help());
            return Result::Ok(())
        }
        if !positional && argument == "--" {
            positional = true;
        }
        if !positional {
            let parsed = option_value(args, index, argument, "--compiler")?;
            if let Some(value) = parsed.0 {
                if compiler.is_some() || value == "" || value.starts_with("--") {
                    return Result::Err("bind-c: expected one --compiler value")
                }
                compiler = Option::Some(value);
                index = parsed.1;
                continue
            }
        }
        forwarded.push(argument);
        index += 1;
    }
    let compiler = project::compiler_program(compiler)?;
    let status = process::Command::new(compiler).args(forwarded).status_structured().map_err(
        |error| error.to_string(),
    )?;
    if !status.success() {
        return Result::Err("bind-c: generation failed")
    }
    Result::Ok(())
}
