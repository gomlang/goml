package main;

use module::commands;
use module::failure;
use failure::DriverResult;
use module::project;
use std::io;

fn verify_help() -> string {
    "Usage: goml verify [OPTIONS] [FILTER]\n\nBuild and test examples and testdata/downstream modules against an isolated registry.\n\nAccepts goml test options, --example <NAME>, and --examples (omit explicit fixtures)."
}

fn run_verify_cli(arguments: Vec[string]) -> Result[(), failure::Failure] {
    let parsed = Vec::from_array([arguments[0], "test"]);
    for index in 2..arguments.len() {
        if arguments[index] == "--help" || arguments[index] == "-h" {
            io::println(verify_help());
            return Result::Ok(())
        }
        parsed.push(arguments[index]);
    }
    let args = parse_cli(parsed).driver_result()?;
    let context = project::load_context_with_development(args.target_dir, args.compiler, true)?;
    let test_arguments = Vec::from_array(
        [
            "--jobs",
            args.test_jobs.to_string(),
            "--timeout",
            args.test_timeout_ms.to_string() + "ms",
            "--seed",
            args.test_seed.to_string(),
            "--kind",
            args.test_kind,
        ],
    );
    if args.test_list {
        test_arguments.push("--list")
    }
    if args.test_ignored {
        test_arguments.push("--ignored")
    }
    if args.test_include_ignored {
        test_arguments.push("--include-ignored")
    }
    if args.test_nocapture {
        test_arguments.push("--nocapture")
    }
    if args.test_json {
        test_arguments.push("--format=json")
    }
    if let Some(filter) = args.test_filter {
        test_arguments.push(filter)
    }
    let options = commands::VerifyOptions {
        example: args.example,
        examples_only: args.all_examples,
        dry_run: args.dry_run,
        test_arguments,
        ffi_check: args.ffi_check,
        jobs: args.build_jobs,
    };
    if args.dry_run {
        commands::verify_module(context, options)
    } else {
        project::with_build_lock(context, || commands::verify_module(context, options))
    }
}
