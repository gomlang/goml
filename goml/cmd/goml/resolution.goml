package main;

use module::registry;

fn resolution_command(command: string) -> bool {
    match command {
        "check" | "build" | "run" | "test" | "doc" | "export-go" | "metadata" | "architecture" | "api" | "lock" | "update" | "add" | "remove" => true,
        _ => false,
    }
}

fn parse_resolution_options(args: Vec[string]) -> Result[(Vec[string], bool, bool), string] {
    if args.len() < 2 || !resolution_command(args[1]) {
        return Ok((args, false, false))
    }
    let result = Vec::from_array([args[0], args[1]]);
    let mut locked = false;
    let mut offline = false;
    let mut index = 2;
    while index < args.len() {
        let argument = args[index];
        if argument == "--" {
            while index < args.len() {
                result.push(args[index]);
                index += 1;
            }
            break;
        } else if argument == "--locked" {
            if locked {
                return Err("--locked cannot be repeated")
            }
            locked = true;
        } else if argument == "--offline" {
            if offline {
                return Err("--offline cannot be repeated")
            }
            offline = true;
        } else {
            result.push(argument);
        }
        index += 1;
    }
    if locked
        && (args[1] == "lock" || args[1] == "update" || args[1] == "add" || args[1] == "remove") {
        return Err("--locked cannot be used with commands that change dependencies")
    }
    Ok((result, locked, offline))
}

fn configure_resolution_arguments(args: Vec[string]) -> Result[Vec[string], string] {
    let (arguments, locked, offline) = parse_resolution_options(args)?;
    registry::configure_resolution(locked, offline);
    Ok(arguments)
}

fn lock_help() -> string {
    "Usage: goml lock [OPTIONS]\n\nOptions:\n      --local-registry PATH\n      --offline\n  -h, --help"
}
