package main;

use module::metadata;
use module::architecture;
use std::env;
use std::io;
use std::json;
use std::process;

fn metadata_help() -> string {
    "Usage: goml metadata [OPTIONS]\n\nOptions:\n      --format json\n      --mode files|graph  [default: graph]\n      --compiler PROGRAM\n  -h, --help"
}

fn architecture_help() -> string {
    "Usage: goml architecture [OPTIONS]\n\nOptions:\n      --rules PATH  [default: goml.architecture.json]\n      --compiler PROGRAM\n  -h, --help"
}

fn parse_query_options(args: Vec[string], names: Vec[string]) -> Result[
    HashMap[string, string],
    string,
] {
    let values: HashMap[string, string] = HashMap::new();
    let mut index = 2;
    while index < args.len() {
        let argument = args[index];
        if argument == "--help" || argument == "-h" {
            return Err("help")
        }
        let mut found = false;
        for name in names {
            if !found {
                let (value, next) = option_value(args, index, argument, name)?;
                if let Some(value) = value {
                    if value == "" || value.starts_with("--") {
                        return Err(name + " requires a value")
                    }
                    if values.get(name).is_some() {
                        return Err(name + " cannot be repeated")
                    }
                    let _ = values.insert(name, value);
                    index = next;
                    found = true;
                }
            }
        }
        if !found {
            return Err("unexpected argument " + argument)
        }
    }
    Ok(values)
}

fn run_metadata_cli(args: Vec[string]) -> Result[(), string] {
    let options = match parse_query_options(
        args,
        Vec::from_array(["--format", "--mode", "--compiler"]),
    ) {
        Ok(options) => options,
        Err(error) => if error == "help" {
            io::println(metadata_help());
            return Ok(())
        } else {
            return Err(error)
        },
    };
    if options.get("--format").unwrap_or("json") != "json" {
        return Err("--format must be json")
    }
    let mode = options.get("--mode").unwrap_or("graph");
    if mode != "files" && mode != "graph" {
        return Err("--mode must be files or graph")
    }
    let current = env::current_dir_structured().map_err(|error| error.to_string())?;
    let value = metadata::query(current, options.get("--compiler"), mode)?;
    io::println(json::encode(value));
    if json::field(value, "complete").and_then(json::as_bool) != Option::Some(true) {
        for diagnostic in json::field(value, "diagnostics").and_then(json::as_array).unwrap_or(
            Vec::new(),
        ) {
            io::eprintln(
                json::field(diagnostic, "message").and_then(json::as_string).unwrap_or(
                    "incomplete package metadata",
                ),
            );
        }
        process::exit(1)
    }
    Ok(())
}

fn run_architecture_cli(args: Vec[string]) -> Result[(), string] {
    let options = match parse_query_options(args, Vec::from_array(["--rules", "--compiler"])) {
        Ok(options) => options,
        Err(error) => if error == "help" {
            io::println(architecture_help());
            return Ok(())
        } else {
            return Err(error)
        },
    };
    let code = architecture::check_project(options.get("--rules"), options.get("--compiler"))?;
    if code != 0 {
        process::exit(code)
    }
    Ok(())
}
