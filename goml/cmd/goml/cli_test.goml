#[test]
fn project_test_runs_private_tests_and_ignores_test_sources_in_check() -> () {
    let root = test_support::workspace("internal_tests");
    test_support::write_file(
        path::join(root, "goml.toml"),
        \\[module]
        \\path = "demo"
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "math/math.goml"),
        \\package math;
        \\
        \\fn double(value: i32) -> i32 { value * 2 }
        \\
        \\pub fn add(left: i32, right: i32) -> i32 { left + right }
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "math/math_test.goml"),
        \\package math;
        \\
        \\use std::testing;
        \\
        \\#[test]
        \\fn add_works() -> () { testing::assert_eq(add(2, 3), 5) }
        \\
        \\#[test]
        \\fn private_helper_works() -> () { testing::assert_eq(double(4), 8) }
        \\
        \\#[test]
        \\#[ignore("later")]
        \\fn ignored_case() -> () { testing::assert(true) }
        \\
        ,
    );
    let check = test_support::project_command("check", "", Vec::from_array(["--dry-run"]), root);
    test_support::assert_success(check);
    test_support::assert_not_contains(test_support::stdout(check), "math_test.goml");
    let tested = test_support::project_command("test", "", Vec::from_array(["--jobs", "2"]), root);
    test_support::assert_success(tested);
    let stdout = test_support::stdout(tested);
    test_support::assert_contains(stdout, "demo::math::add_works ... ok");
    test_support::assert_contains(stdout, "demo::math::private_helper_works ... ok");
    test_support::assert_contains(stdout, "2 passed; 0 failed; 1 ignored");
    let stderr = test_support::stderr(tested);
    test_support::assert_contains(stderr, "\r\u001b[2K[--------------------] 0/3 running tests");
    test_support::assert_not_contains(stderr, "0/3 running tests\n");
    test_support::assert_contains(stderr, "\r\u001b[2K[####################] 3/3 finished\n");
    let listed = test_support::project_command("test", "", Vec::from_array(["--list"]), root);
    test_support::assert_success(listed);
    test_support::assert_contains(test_support::stdout(listed), "demo::math::ignored_case: ignored");
    let included = test_support::project_command(
        "test",
        "",
        Vec::from_array(["--include-ignored"]),
        root,
    );
    test_support::assert_success(included);
    test_support::assert_contains(test_support::stdout(included), "3 passed; 0 failed; 0 ignored");
    let json = test_support::project_command(
        "test",
        "",
        Vec::from_array(["add_works", "--format", "json"]),
        root,
    );
    test_support::assert_success(json);
    test_support::assert_contains(
        test_support::stdout(json),
        "{\"event\":\"ok\",\"name\":\"demo::math::add_works\",\"seed\":",
    )
}

#[test]
fn project_commands_validate_incremental_fingerprints_and_outputs() -> () {
    let root = test_support::workspace("incremental_fingerprints");
    test_support::write_basic_project(root, "demo");
    test_support::assert_success(cli_check(root));
    let artifact = path::join(root, "_artifact/check/pkg/demo/demo.interface");
    let fingerprint = path::join(root, "_artifact/check/pkg/demo/demo.goml-check-fingerprint");
    testing::assert(fs::is_file(artifact));
    testing::assert(fs::is_file(fingerprint));
    let initial = test_support::read_file(fingerprint);
    test_support::assert_success(cli_check(root));
    testing::assert_eq(test_support::read_file(fingerprint), initial);
    if let Err(message) = fs::write_bytes_structured(artifact, bytes::Bytes::from_string("corrupt")) {
        testing::fail(message.to_string())
    }
    test_support::assert_success(cli_check(root));
    let restored = match fs::read_bytes_structured(artifact) {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message.to_string());
            bytes::Bytes::new()
        },
    };
    testing::assert(restored.len() > 8);
    testing::assert_eq(test_support::read_file(fingerprint), initial);
    if let Err(message) = fs::remove_file(artifact) {
        testing::fail(message.to_string())
    }
    test_support::assert_success(cli_check(root));
    testing::assert(fs::is_file(artifact));
    test_support::write_file(
        path::join(root, "main.goml"),
        \\package main;
        \\
        \\fn main() -> () { println("changed") }
        \\
        ,
    );
    test_support::assert_success(cli_check(root));
    testing::assert(test_support::read_file(fingerprint) != initial)
}

#[test]
fn sha256_file_handles_streamed_content_and_missing_files() -> () {
    let root = test_support::workspace("sha256_file");
    let file = path::join(root, "large.txt");
    let builder = text::StringBuilder::with_capacity(160000);
    for _ in 0..10000 {
        builder.write_string("0123456789abcdef")
    }
    test_support::write_file(file, builder.finish());
    match fs::sha256_file(file) {
        Ok(digest) => testing::assert_eq(
            digest,
            "48705161f98666a9d694f3b8e9d1bc5b842fa1ff0e85d710150616c433af9aae",
        ),
        Err(message) => testing::fail(message.to_string()),
    }
    if let Ok(_) = fs::sha256_file(path::join(root, "missing.txt")) {
        testing::fail("missing file produced a digest")
    }
}

#[test]
fn project_build_graph_reuses_unaffected_local_cache_nodes() -> () {
    let root = test_support::workspace("build_graph_local_cache");
    test_support::write_file(
        path::join(root, "goml.toml"),
        \\[module]
        \\path = "demo"
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "main.goml"),
        \\package main;
        \\
        \\use demo::left;
        \\
        \\fn main() -> () { let _ = left::value(); () }
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "left/left.goml"),
        \\package left;
        \\
        \\pub fn value() -> i32 { 1 }
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "right/right.goml"),
        \\package right;
        \\
        \\pub fn value() -> i32 { 2 }
        \\
        ,
    );
    test_support::assert_success(cli_check(root));
    let main_fingerprint = path::join(root, "_artifact/check/pkg/demo/demo.goml-check-fingerprint");
    let left_fingerprint = path::join(
        root,
        "_artifact/check/pkg/demo/left/left.goml-check-fingerprint",
    );
    let right_fingerprint = path::join(
        root,
        "_artifact/check/pkg/demo/right/right.goml-check-fingerprint",
    );
    let initial_main = test_support::read_file(main_fingerprint);
    let initial_left = test_support::read_file(left_fingerprint);
    let initial_right = test_support::read_file(right_fingerprint);
    test_support::assert_success(cli_check(root));
    testing::assert_eq(test_support::read_file(main_fingerprint), initial_main);
    testing::assert_eq(test_support::read_file(left_fingerprint), initial_left);
    testing::assert_eq(test_support::read_file(right_fingerprint), initial_right);
    test_support::write_file(
        path::join(root, "left/left.goml"),
        \\package left;
        \\
        \\pub fn value() -> i32 { 3 }
        \\
        ,
    );
    test_support::assert_success(cli_check(root));
    testing::assert_eq(test_support::read_file(main_fingerprint), initial_main);
    testing::assert(test_support::read_file(left_fingerprint) != initial_left);
    testing::assert_eq(test_support::read_file(right_fingerprint), initial_right)
}

#[test]
fn project_commands_report_build_progress_on_stderr() -> () {
    let root = test_support::workspace("build_progress");
    test_support::write_basic_project(root, "demo");
    let checked = cli_check(root);
    test_support::assert_success(checked);
    test_support::assert_contains(
        test_support::stderr(checked),
        "\r\u001b[2K[--------------------] 0/1 checking demo",
    );
    test_support::assert_not_contains(test_support::stderr(checked), "preparing compiler world");
    test_support::assert_contains(
        test_support::stderr(checked),
        "\r\u001b[2K[####################] 1/1 finished\n",
    );
    let built = cli_build(root);
    test_support::assert_success(built);
    test_support::assert_contains(
        test_support::stderr(built),
        "\r\u001b[2K[--------------------] 0/3 compiling demo",
    );
    test_support::assert_not_contains(test_support::stderr(built), "preparing compiler world");
    test_support::assert_contains(
        test_support::stderr(built),
        "\r\u001b[2K[####################] 3/3 finished\n",
    );
    let cached = cli_build(root);
    test_support::assert_success(cached);
    test_support::assert_contains(
        test_support::stderr(cached),
        "\r\u001b[2K[####################] 3/3 finished\n",
    );
    let dry_run = test_support::project_command("build", "", Vec::from_array(["--dry-run"]), root);
    test_support::assert_success(dry_run);
    testing::assert_eq(test_support::stderr(dry_run), "")
}

