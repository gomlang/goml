package main;

use module::test_support;
use module::version;
use std::bytes;
use std::fs;
use std::path;
use std::process;
use std::testing;
use std::text;

fn cli_deep_ref_type(depth: isize) -> string {
    let result = Ref::new("i32");
    for _ in 0..depth {
        result.set("Ref[" + result.get() + "]")
    }
    result.get()
}

fn cli_build(root: string) -> process::Output {
    test_support::project_command("build", "", Vec::new(), root)
}

fn cli_check(root: string) -> process::Output {
    test_support::project_command("check", "", Vec::new(), root)
}

fn cli_test_shard(root: string, shard: string, list: bool, filter: string) -> process::Output {
    let command = process::Command::new(test_support::goml_binary()).args(
        Vec::from_array(["test", "--compiler", test_support::gomlc_binary(), "--jobs", "2"]),
    ).env("GOML_TEST_SHARD", shard).current_dir(root);
    if list {
        let _ = command.arg("--list");
    }
    if filter != "" {
        let _ = command.arg(filter);
    }
    testing::expect_ok(command.output_structured(), "run sharded project tests")
}

#[test]
fn project_test_prebuilt_artifacts_run_without_building_or_checking_freshness() -> () {
    let root = test_support::workspace("prebuilt_tests");
    test_support::write_file(
        path::join(root, "goml.toml"),
        "[module]\npath = \"prebuilt_fixture\"\n",
    );
    let source = path::join(root, "value/value.goml");
    test_support::write_file(source, "package value; pub fn answer() -> isize { 42 }");
    test_support::write_file(
        path::join(root, "value/value_test.goml"),
        "package value; use std::testing; #[test] fn internal() -> () { testing::assert_eq(answer(), 42); }",
    );
    test_support::write_file(
        path::join(root, "value/tests/external_test.goml"),
        "package tests; use module::value; use std::testing; #[test] fn external() -> () { testing::assert_eq(value::answer(), 42); }",
    );
    let built = test_support::project_command("test", "", Vec::from_array(["--no-run"]), root);
    test_support::assert_success(built);
    test_support::assert_not_contains(test_support::stdout(built), "test result:");
    let archive = path::join(root, "tests.tar");
    let packed = testing::expect_ok(
        process::Command::new("tar").args(
            Vec::from_array(
                [
                    "-cf",
                    archive,
                    "-C",
                    path::join(root, "_artifact"),
                    "test/internal/runner",
                    "test/internal/tests.json",
                    "test/external/runner",
                    "test/external/tests.json",
                ],
            ),
        ).output_structured(),
        "pack prebuilt test artifacts",
    );
    test_support::assert_success(packed);
    let prebuilt = path::join(root, "prebuilt");
    testing::expect_ok(fs::create_dir_all(prebuilt), "create prebuilt directory");
    let unpacked = testing::expect_ok(
        process::Command::new("tar").args(Vec::from_array(["-xf", archive, "-C", prebuilt])).output_structured(),
        "unpack prebuilt test artifacts",
    );
    test_support::assert_success(unpacked);
    test_support::write_file(source, "package value; pub fn answer() -> isize { 0 }");
    let listed = test_support::project_command(
        "test",
        "",
        Vec::from_array(["--no-build", "--target-dir", "prebuilt", "--list"]),
        root,
    );
    test_support::assert_success(listed);
    test_support::assert_contains(test_support::stdout(listed), "::internal");
    test_support::assert_contains(test_support::stdout(listed), "::external");
    let run = test_support::project_command(
        "test",
        "",
        Vec::from_array(["--no-build", "--target-dir", "prebuilt"]),
        root,
    );
    test_support::assert_success(run);
    test_support::assert_contains(test_support::stdout(run), "2 passed");
    testing::assert(!fs::is_dir(path::join(root, "prebuilt/test/base")));
    for extra in["--no-run", "--dry-run"] {
        let invalid = test_support::project_command(
            "test",
            "",
            Vec::from_array(["--no-build", extra]),
            root,
        );
        test_support::assert_failure(invalid);
        test_support::assert_contains(
            test_support::stderr(invalid),
            "--no-build cannot be combined",
        );
    }
    let missing = test_support::project_command(
        "test",
        "",
        Vec::from_array(["--no-build", "--target-dir", "missing"]),
        root,
    );
    test_support::assert_failure(missing);
    testing::assert(!fs::is_dir(path::join(root, "missing/test/base")));
}

#[test]
fn project_test_shards_partition_filtered_tests_and_clear_nested_configuration() -> () {
    let root = test_support::workspace("test_shards");
    test_support::write_file(path::join(root, "goml.toml"), "[module]\npath = \"shard_fixture\"\n");
    test_support::write_file(
        path::join(root, "math/math.goml"),
        "package math; pub fn answer() -> isize { 42 }",
    );
    test_support::write_file(
        path::join(root, "math/math_test.goml"),
        \\package math;
        \\use std::env;
        \\use std::testing;
        \\#[test]
        \\fn alpha() -> () { testing::assert_eq(env::var_structured("GOML_TEST_SHARD").unwrap_or(""), ""); }
        \\#[test]
        \\fn bravo() -> () { alpha() }
        \\#[test]
        \\#[ignore("later")]
        \\fn charlie() -> () { testing::fail("ignored") }
        \\#[test_case(true)]
        \\#[test_case(false)]
        \\fn parameterized(value: bool) -> () { alpha(); testing::assert(value || !value); }
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "math/tests/external_test.goml"),
        \\package tests;
        \\use module::math;
        \\use std::env;
        \\use std::testing;
        \\#[test]
        \\fn external() -> () {
        \\    testing::assert_eq(math::answer(), 42);
        \\    testing::assert_eq(env::var_structured("GOML_TEST_SHARD").unwrap_or(""), "");
        \\}
        \\
        ,
    );
    let listed = cli_test_shard(root, "", true, "");
    test_support::assert_success(listed);
    let names = Vec::new();
    for name in text::split(test_support::stdout(listed), "\n") {
        if name != "" {
            names.push(name)
        }
    }
    testing::assert_eq(names.len(), 6);
    for index in 0..2 {
        let shard = f"{index + 1}/2";
        let listed = cli_test_shard(root, shard, true, "");
        test_support::assert_success(listed);
        let stdout = test_support::stdout(listed);
        for position in 0..names.len() {
            if position % 2 == index {
                test_support::assert_contains(stdout, names[position])
            } else {
                test_support::assert_not_contains(stdout, names[position])
            }
        }
        test_support::assert_success(cli_test_shard(root, shard, false, ""));
    }
    let filtered = cli_test_shard(root, "1/2", true, "alpha");
    test_support::assert_success(filtered);
    test_support::assert_contains(test_support::stdout(filtered), "::alpha");
    let empty = cli_test_shard(root, "2/2", true, "alpha");
    test_support::assert_success(empty);
    testing::assert_eq(test_support::stdout(empty), "");
    let invalid = cli_test_shard(root, "1/0", true, "");
    testing::assert(!process::ExitStatus::success(process::Output::status(invalid)));
    test_support::assert_contains(test_support::stderr(invalid), "GOML_TEST_SHARD");
}

#[test]
fn project_build_handles_deep_public_interface_type() -> () {
    let root = test_support::workspace("deep_public_interface");
    test_support::write_file(
        path::join(root, "goml.toml"),
        \\[module]
        \\path = "iface_deep"
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "Lib/Lib.goml"),
        "package lib;\n\npub struct Wrap { value: " + cli_deep_ref_type(200) +
            \\ }
            \\
            \\pub fn ping() -> i32 { 1 }
            \\
        ,
    );
    test_support::write_file(
        path::join(root, "main.goml"),
        \\package main;
        \\
        \\use iface_deep::Lib;
        \\
        \\fn main() -> () { println(lib::ping().to_string()) }
        \\
        ,
    );
    let output = cli_build(root);
    test_support::assert_success(output);
    testing::assert(
        fs::is_file(path::join(root, "_artifact/build/pkg/iface_deep/goml_generated.go")),
    )
}

#[test]
fn project_build_loads_transitive_public_type_interfaces() -> () {
    let root = test_support::workspace("transitive_public_types");
    test_support::write_file(
        path::join(root, "goml.toml"),
        \\[module]
        \\path = "transitive_types"
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "model/model.goml"),
        \\package model;
        \\
        \\pub struct Box { pub value: i32 }
        \\
        \\pub fn make() -> Box { Box { value: 42 } }
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "facade/facade.goml"),
        \\package facade;
        \\
        \\use transitive_types::model;
        \\
        \\pub fn make() -> model::Box { model::make() }
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "main.goml"),
        \\package main;
        \\
        \\use transitive_types::facade;
        \\
        \\fn main() -> () { println(facade::make().value.to_string()) }
        \\
        ,
    );
    let output = cli_build(root);
    test_support::assert_success(output);
    let execution = match process::Command::new(path::join(root, "_artifact/bin/transitive_types")).output_structured() {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message.to_string());
            output
        },
    };
    test_support::assert_success(execution);
    testing::assert_eq(test_support::stdout(execution), "42\n")
}

