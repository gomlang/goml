#[test]
fn project_check_dry_run_prints_compiler_check_commands() -> () {
    let root = test_support::workspace("check_dry_run");
    test_support::write_basic_project(root, "demo");
    let output = test_support::project_command("check", "", Vec::from_array(["--dry-run"]), root);
    test_support::assert_success(output);
    let stdout = test_support::stdout(output);
    test_support::assert_contains(
        stdout,
        "gomlc check --package demo --module demo --input main.goml --output _artifact/check/pkg/demo/demo",
    );
    testing::assert(!fs::exists(path::join(root, "_artifact/check/pkg/demo/demo.interface")))
}

#[test]
fn project_build_dry_run_prints_compiler_build_and_link_commands() -> () {
    let root = test_support::workspace("build_dry_run");
    test_support::write_basic_project(root, "demo");
    let output = test_support::project_command("build", "", Vec::from_array(["--dry-run"]), root);
    test_support::assert_success(output);
    let stdout = test_support::stdout(output);
    test_support::assert_contains(
        stdout,
        "gomlc build --package demo --module demo --input main.goml --output _artifact/build/pkg/demo/demo",
    );
    test_support::assert_contains(
        stdout,
        "gomlc link --input _artifact/build/pkg/demo/demo.core --output _artifact/build/pkg/demo/goml_generated.go --entry demo",
    );
    test_support::assert_contains(
        stdout,
        "go build -o _artifact/bin/demo _artifact/build/pkg/demo/goml_generated.go",
    )
}

#[test]
fn bootstrap_artifact_build_omits_the_redundant_native_build() -> () {
    let root = test_support::workspace("bootstrap_artifact_build");
    test_support::write_basic_project(root, "demo");
    let output = test_support::project_command(
        "__build-artifacts",
        ".",
        Vec::from_array(["--dry-run"]),
        root,
    );
    test_support::assert_success(output);
    let stdout = test_support::stdout(output);
    test_support::assert_contains(
        stdout,
        "gomlc link --input _artifact/build/pkg/demo/demo.core --output _artifact/build/pkg/demo/goml_generated.go --entry demo",
    );
    testing::assert(!stdout.contains("go build"))
}

