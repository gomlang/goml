fn check_and_build_complex_dependency_fixture(project_name: string) -> () {
    let root = path::join(
        path::join(test_support::repository_root(), "gomlc/testdata/module"),
        project_name,
    );
    let target = path::join(
        path::join(test_support::module_root(), "_artifact/complex-fixtures"),
        project_name,
    );
    let extra = Vec::from_array(["--target-dir", target]);
    test_support::assert_success(
        test_support::project_command("check", root, extra, test_support::module_root()),
    );
    test_support::assert_success(
        test_support::project_command("build", root, extra, test_support::module_root()),
    )
}

