#[test]
fn project_test_dry_run_and_invalid_signature_diagnostics() -> () {
    let root = test_support::workspace("invalid_test_signature");
    test_support::write_file(
        path::join(root, "goml.toml"),
        \\[module]
        \\path = "demo"
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "value/value.goml"),
        \\package value;
        \\pub fn value() -> i32 { 1 }
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "value/value_test.goml"),
        \\package value;
        \\
        \\#[test]
        \\fn invalid[T](value: T) -> bool { true }
        \\
        ,
    );
    let dry_run = test_support::project_command("test", "", Vec::from_array(["--dry-run"]), root);
    test_support::assert_success(dry_run);
    test_support::assert_contains(
        test_support::stdout(dry_run),
        "gomlc test-build --package demo::value --module demo --input value/value.goml --input value/value_test.goml",
    );
    let output = test_support::project_command("test", "", Vec::new(), root);
    test_support::assert_failure(output);
    let stderr = test_support::stderr(output);
    test_support::assert_contains(stderr, "must not have type parameters");
    test_support::assert_contains(stderr, "must not have parameters");
    test_support::assert_contains(stderr, "must return ()")
}

fn cli_wide_fields(count: isize) -> string {
    let parts = Vec::new();
    for idx in 0..count {
        parts.push(f"field{idx}: i32")
    }
    text::join(parts, ", ")
}

fn cli_wide_values(count: isize) -> string {
    let parts = Vec::new();
    for idx in 0..count {
        parts.push(f"field{idx}: {idx}")
    }
    text::join(parts, ", ")
}

fn cli_wide_pattern(count: isize) -> string {
    let parts = Vec::new();
    for idx in 0..count {
        parts.push(f"field{idx}: x{idx}")
    }
    text::join(parts, ", ")
}

fn cli_wide_sum(count: isize) -> string {
    let parts = Vec::new();
    for idx in 0..count {
        parts.push(f"x{idx}")
    }
    text::join(parts, " + ")
}

fn cli_wide_struct_program(field_count: isize, sum_count: isize) -> string {
    "package main;\n\nstruct S { " + cli_wide_fields(field_count)
        + " }\nfn main() -> () { let s = S { "
        + cli_wide_values(field_count)
        + " }; let total = match s { S { "
        + cli_wide_pattern(field_count)
        + " } => "
        + cli_wide_sum(sum_count)
        + " }; println(total.to_string()) }\n"
}

#[test]
fn project_build_handles_very_wide_struct_pattern() -> () {
    let root = test_support::workspace("wide_struct_pattern");
    test_support::write_file(
        path::join(root, "goml.toml"),
        \\[module]
        \\path = "wideproj"
        \\
        ,
    );
    test_support::write_file(path::join(root, "main.goml"), cli_wide_struct_program(128, 128));
    let output = cli_build(root);
    test_support::assert_success(output);
    testing::assert(fs::is_file(path::join(root, "_artifact/build/pkg/wideproj/goml_generated.go")))
}

#[test]
fn test_sources_cannot_repair_a_broken_normal_package() -> () {
    let root = test_support::workspace("broken_normal_package");
    test_support::write_file(
        path::join(root, "goml.toml"),
        \\[module]
        \\path = "demo"
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "value/value.goml"),
        \\package value;
        \\pub fn value() -> i32 { test_only_value() }
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "value/value_test.goml"),
        \\package value;
        \\
        \\fn test_only_value() -> i32 { 1 }
        \\
        \\#[test]
        \\fn value_works() -> () { let _ = value(); () }
        \\
