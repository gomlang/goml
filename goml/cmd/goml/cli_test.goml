#[test]
fn project_test_supports_nocapture_and_timeouts() -> () {
    let root = test_support::workspace("test_timeout");
    test_support::write_file(
        path::join(root, "goml.toml"),
        \\[module]
        \\path = "demo"
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "checks/checks.goml"),
        \\package checks;
        \\pub fn value() -> i32 { 1 }
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "checks/checks_test.goml"),
        \\package checks;
        \\
        \\use std::io;
        \\use std::testing;
        \\
        \\#[test]
        \\fn output() -> () { io::println("uncaptured marker") }
        \\
        \\#[test]
        \\fn seed() -> () { testing::assert_eq(testing::seed(), 123) }
        \\
        \\#[test]
        \\#[ignore("timeout case")]
        \\fn timeout() -> () { while true { () } }
        \\
        ,
    );
    let captured = test_support::project_command("test", "", Vec::from_array(["output"]), root);
    test_support::assert_success(captured);
    test_support::assert_not_contains(test_support::stdout(captured), "uncaptured marker");
    let uncaptured = test_support::project_command(
        "test",
        "",
        Vec::from_array(["output", "--nocapture"]),
        root,
    );
    test_support::assert_success(uncaptured);
    test_support::assert_contains(test_support::stdout(uncaptured), "uncaptured marker");
    let timed_out = test_support::project_command(
        "test",
        "",
        Vec::from_array(["timeout", "--ignored", "--timeout", "20ms"]),
        root,
    );
    test_support::assert_failure(timed_out);
    test_support::assert_contains(test_support::stdout(timed_out), "FAILED (timed out)");
    let seeded = test_support::project_command(
        "test",
        "",
        Vec::from_array(["seed", "--seed", "123", "--format", "json"]),
        root,
    );
    test_support::assert_success(seeded);
    test_support::assert_contains(test_support::stdout(seeded), "\"seed\":123");
    let invalid = test_support::project_command(
        "test",
        "",
        Vec::from_array(["--nocapture", "--format", "json"]),
        root,
    );
    test_support::assert_failure(invalid);
    test_support::assert_contains(
        test_support::stderr(invalid),
        "--nocapture cannot be combined with --format json",
    )
}

#[test]
fn project_test_preserves_selection_order_when_workers_finish_out_of_order() -> () {
    let root = test_support::workspace("test_output_order");
    test_support::write_file(
        path::join(root, "goml.toml"),
        \\[module]
        \\path = "demo"
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "checks/checks.goml"),
        \\package checks;
        \\pub fn value() -> i32 { 1 }
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "checks/checks_test.goml"),
        \\package checks;
        \\
        \\use std::time;
        \\
        \\#[test]
        \\fn a_slow() -> () { time::sleep(time::Duration::from_milliseconds(100)) }
        \\
        \\#[test]
        \\fn b_fast() -> () {}
        \\
        \\#[test]
        \\fn c_fast() -> () {}
        \\
        ,
    );
    let text_output = test_support::project_command(
        "test",
        "",
        Vec::from_array(["--jobs", "2"]),
        root,
    );
    test_support::assert_success(text_output);
    let text_stdout = test_support::stdout(text_output);
    let Some(text_slow) = text::find(text_stdout, "demo::checks::a_slow ... ok") else {
        testing::fail("text output omitted slow test");
        return
    };
    let Some(text_fast) = text::find(text_stdout, "demo::checks::b_fast ... ok") else {
        testing::fail("text output omitted fast test");
        return
    };
    let Some(text_last) = text::find(text_stdout, "demo::checks::c_fast ... ok") else {
        testing::fail("text output omitted last test");
        return
    };
    testing::assert(text_slow < text_fast);
    testing::assert(text_fast < text_last);
    let json_output = test_support::project_command(
        "test",
        "",
        Vec::from_array(["--jobs", "2", "--format", "json"]),
        root,
    );
    test_support::assert_success(json_output);
    let json_stdout = test_support::stdout(json_output);
    let Some(json_slow) = text::find(
        json_stdout,
        "{\"event\":\"ok\",\"name\":\"demo::checks::a_slow\",\"seed\":",
    ) else {
        testing::fail("json output omitted slow test");
        return
    };
    let Some(json_fast) = text::find(
        json_stdout,
        "{\"event\":\"ok\",\"name\":\"demo::checks::b_fast\",\"seed\":",
    ) else {
        testing::fail("json output omitted fast test");
        return
    };
    let Some(json_last) = text::find(
        json_stdout,
        "{\"event\":\"ok\",\"name\":\"demo::checks::c_fast\",\"seed\":",
    ) else {
        testing::fail("json output omitted last test");
        return
    };
    testing::assert(json_slow < json_fast);
    testing::assert(json_fast < json_last)
}

#[test]
fn project_test_runs_and_aggregates_tests_from_all_packages() -> () {
    let root = test_support::workspace("all_package_tests");
    test_support::write_file(
        path::join(root, "goml.toml"),
        \\[module]
        \\path = "demo"
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "a/a.goml"),
        \\package a;
        \\pub fn value() -> i32 { 1 }
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "a/a_test.goml"),
        \\package a;
        \\use std::testing;
        \\#[test]
        \\fn internal_a() -> () { testing::assert_eq(value(), 1) }
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "b/b.goml"),
        \\package b;
        \\use demo::a;
        \\pub fn value() -> i32 { a::value() + 1 }
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "b/b_test.goml"),
        \\package b;
        \\use std::testing;
        \\#[test]
        \\fn internal_b() -> () { testing::assert_eq(value(), 2) }
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "b/tests/b_test.goml"),
        \\package tests;
        \\use demo::b;
        \\use std::testing;
        \\#[test]
        \\fn external_b() -> () { testing::assert_eq(b::value(), 2) }
        \\
        ,
    );
    let planned = test_support::project_command("test", "", Vec::from_array(["--dry-run"]), root);
    test_support::assert_success(planned);
    let plan = test_support::stdout(planned);
    test_support::assert_not_contains(plan, "_artifact/check/");
    test_support::assert_contains(
        plan,
        "gomlc build --package demo::a --module demo --input a/a.goml --output _artifact/test/base/pkg/demo/a/a",
    );
    test_support::assert_contains(
        plan,
        "gomlc build --package demo::b --module demo --input b/b.goml --interface-path _artifact/test/base/pkg/demo/a/a.interface --output _artifact/test/base/pkg/demo/b/b",
    );
    test_support::assert_contains(
        plan,
        "gomlc test-link --input _artifact/test/internal/pkg/demo/a/a.core _artifact/test/internal/pkg/demo/b/b.core",
    );
    test_support::assert_contains(
        plan,
        "go build -o _artifact/test/internal/runner _artifact/test/internal/goml_generated.go",
    );
    let tested = test_support::project_command("test", "", Vec::new(), root);
    test_support::assert_success(tested);
    let stdout = test_support::stdout(tested);
    test_support::assert_contains(stdout, "demo::a::internal_a ... ok");
    test_support::assert_contains(stdout, "demo::b::internal_b ... ok");
    test_support::assert_contains(stdout, "demo::b::tests::external_b ... ok");
    test_support::assert_contains(stdout, "3 passed; 0 failed; 0 ignored")
}

#[test]
fn project_test_runs_parent_black_box_tests() -> () {
    let root = test_support::workspace("black_box_tests");
    test_support::write_file(
        path::join(root, "goml.toml"),
        \\[module]
        \\path = "demo"
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "math/math.goml"),
        \\package math;
        \\
        \\fn private_value() -> i32 { 41 }
        \\
        \\pub fn public_value() -> i32 { private_value() + 1 }
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "math/tests/math_test.goml"),
        \\package tests;
        \\
        \\use demo::math;
        \\use std::testing;
        \\
        \\#[test]
        \\fn black_box() -> () { testing::assert_eq(math::public_value(), 42) }
        \\
        ,
    );
    let checked = test_support::project_command("check", "", Vec::from_array(["--tests"]), root);
    test_support::assert_success(checked);
    let tested = test_support::project_command(
        "test",
        "",
        Vec::from_array(["--kind", "external"]),
        root,
    );
    test_support::assert_success(tested);
    test_support::assert_contains(
        test_support::stdout(tested),
        "demo::math::tests::black_box ... ok",
    )
}

#[test]
fn project_check_rejects_orphan_black_box_tests() -> () {
    let root = test_support::workspace("orphan_black_box_tests");
    test_support::write_file(
        path::join(root, "goml.toml"),
        \\[module]
        \\path = "demo"
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "main.goml"),
        \\package main;
        \\fn main() -> () { () }
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "orphan/tests/orphan_test.goml"),
        \\package tests;
        \\#[test]
        \\fn orphan() -> () { () }
        \\
        ,
    );
    let checked = test_support::project_command("check", "", Vec::new(), root);
    test_support::assert_failure(checked);
