#[test]
fn project_build_stops_when_compiler_subcommand_fails() -> () {
    let root = test_support::workspace("compiler_failure");
    test_support::write_file(
        path::join(root, "goml.toml"),
        \\[module]
        \\path = "demo"
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "main.goml"),
        \\package main;
        \\
        \\use demo::A;
        \\
        \\fn main() -> () { println(A::msg()) }
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "A/A.goml"),
        \\package A;
        \\
        \\pub fn msg() -> string { "bad" }
        \\
        ,
    );
    let output = cli_build(root);
    test_support::assert_failure(output);
    test_support::assert_contains(
        test_support::stderr(output),
        "package name must start with a lowercase letter or `_`",
    )
}

#[test]
fn project_build_preserves_entry_directory_structure() -> () {
    let root = test_support::workspace("entry_directory");
    test_support::write_file(
        path::join(root, "goml.toml"),
        \\[module]
        \\path = "demo"
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "src/main.goml"),
        \\package main;
        \\
        \\use demo::src::Lib;
        \\
        \\fn main() -> () { println(lib::msg()) }
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "src/Lib/Lib.goml"),
        \\package lib;
        \\
        \\pub fn msg() -> string { "ok" }
        \\
        ,
    );
    let output = test_support::project_command("build", "", Vec::new(), root);
    test_support::assert_success(output);
    testing::assert(fs::is_file(path::join(root, "_artifact/bin/src/src")))
}

#[test]
fn project_build_links_every_main_package() -> () {
    let root = test_support::workspace("multiple_main_packages");
    test_support::write_file(
        path::join(root, "goml.toml"),
        \\[module]
        \\path = "alice::app"
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "pkg/pkg.goml"),
        \\package pkg;
        \\pub fn value() -> i32 { 1 }
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "cmd/server/main.goml"),
        \\package main;
        \\use alice::app::pkg;
        \\fn main() -> () { println(pkg::value().to_string()) }
        \\
        ,
    );
    test_support::write_file(
        path::join(root, "cmd/client/main.goml"),
        \\package main;
        \\fn main() -> () { println("client") }
        \\
        ,
    );
    test_support::assert_success(cli_build(root));
    testing::assert(fs::is_file(path::join(root, "_artifact/build/pkg/alice/app/pkg/pkg.core")));
    testing::assert(
        fs::is_file(path::join(root, "_artifact/build/pkg/alice/app/pkg/pkg.interface")),
    );
    testing::assert(
        fs::is_file(path::join(root, "_artifact/build/pkg/alice/app/cmd/server/server.core")),
    );
    testing::assert(
        fs::is_file(path::join(root, "_artifact/build/pkg/alice/app/cmd/server/server.interface")),
    );
    testing::assert(
        fs::is_file(path::join(root, "_artifact/build/pkg/alice/app/cmd/server/goml_generated.go")),
    );
    testing::assert(
        fs::is_file(path::join(root, "_artifact/build/pkg/alice/app/cmd/client/goml_generated.go")),
    );
    let dry_run = test_support::project_command("build", "", Vec::from_array(["--dry-run"]), root);
    test_support::assert_success(dry_run);
    test_support::assert_contains(
        test_support::stdout(dry_run),
        "gomlc link --input _artifact/build/pkg/alice/app/cmd/client/client.core --output _artifact/build/pkg/alice/app/cmd/client/goml_generated.go --entry alice::app::cmd::client",
    );
    let rejected = test_support::run(
        Vec::from_array(["build", "cmd/server", "--compiler", test_support::gomlc_binary()]),
        root,
    );
    test_support::assert_failure(rejected);
    test_support::assert_contains(test_support::stderr(rejected), "unexpected argument");
    let rejected = test_support::run(
        Vec::from_array(["check", "cmd/server", "--compiler", test_support::gomlc_binary()]),
        root,
    );
    test_support::assert_failure(rejected);
    test_support::assert_contains(test_support::stderr(rejected), "unexpected argument")
}

