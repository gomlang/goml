    );
    let checked = test_support::project_command("check", "", Vec::new(), root);
    test_support::assert_failure(checked);
    test_support::assert_contains(test_support::stderr(checked), "test_only_value")
}

#[test]
fn new_creates_a_buildable_project() -> () {
    let base = test_support::workspace("new_project_command");
    let output = test_support::run(
        Vec::from_array(["new", "hello", "--path", base]),
        test_support::module_root(),
    );
    test_support::assert_success(output);
    let project = path::join(base, "hello");
    testing::assert(fs::is_file(path::join(project, "goml.toml")));
    testing::assert(fs::is_file(path::join(project, "main.goml")));
    testing::assert(fs::is_file(path::join(project, "lib/lib.goml")));
    test_support::assert_success(test_support::project_command("check", "", Vec::new(), project))
}

#[test]
fn home_creates_and_prints_the_layout() -> () {
    let root = test_support::workspace("home_command");
    let home = path::join(root, "home");
    let output = match process::Command::new(test_support::goml_binary()).arg("home").env(
        "GOML_HOME",
        home,
    ).current_dir(root).output_structured() {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message.to_string());
            process::Output {
                status_value: process::ExitStatus { code_value: -1 },
                stdout_value: bytes::Bytes::new(),
                stderr_value: bytes::Bytes::new(),
            }
        },
    };
    test_support::assert_success(output);
    test_support::assert_contains(test_support::stdout(output), "GOML_HOME=" + home);
    testing::assert(fs::is_dir(path::join(home, "bin")));
    testing::assert(fs::is_dir(path::join(home, "lib")));
    testing::assert(fs::is_dir(path::join(home, "cache")))
}

fn registry_command(program: string, arguments: Vec[string], directory: string) -> () {
    let output = match process::Command::new(program).args(arguments).current_dir(directory).output_structured() {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message.to_string());
            return
        },
    };
    test_support::assert_success(output)
}

fn local_registry(root: string) -> string {
    let registry = path::join(root, "registry");
    test_support::write_file(
        path::join(registry, "index.toml"),
        \\[modules."alice::http"]
        \\path = "alice/http"
        \\
        \\[modules."alice::appdep"]
        \\path = "alice/appdep"
        \\
        ,
    );
    test_support::write_file(
        path::join(registry, "alice/http/goml.toml"),
        \\[module]
        \\path = "alice::http"
        \\
        ,
    );
    test_support::write_file(
        path::join(registry, "alice/http/lib.goml"),
        \\package http;
        \\pub fn version() -> string { "1.2.0" }
        \\
        ,
    );
    test_support::write_file(
        path::join(registry, "alice/appdep/goml.toml"),
        \\[module]
        \\path = "alice::appdep"
        \\
        \\[dependencies]
        \\"alice::http" = "1.2.0"
        \\
        ,
    );
    test_support::write_file(
        path::join(registry, "alice/appdep/lib.goml"),
        \\package appdep;
        \\pub fn marker() -> string { "appdep" }
        \\
        ,
    );
    registry_command("git", Vec::from_array(["init"]), registry);
    registry_command(
        "git",
        Vec::from_array(
            ["-c", "user.name=goml", "-c", "user.email=goml@example.invalid", "add", "."],
        ),
        registry,
    );
    registry_command(
        "git",
        Vec::from_array(
            [
                "-c",
                "user.name=goml",
                "-c",
                "user.email=goml@example.invalid",
                "commit",
                "--allow-empty",
                "-m",
                "registry",
            ],
        ),
        registry,
    );
    registry
}

fn run_with_home(arguments: Vec[string], directory: string, home: string) -> process::Output {
    match process::Command::new(test_support::goml_binary()).args(arguments).env("GOML_HOME", home).current_dir(
        directory,
    ).output_structured() {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message.to_string());
            process::Output {
                status_value: process::ExitStatus { code_value: -1 },
                stdout_value: bytes::Bytes::new(),
                stderr_value: bytes::Bytes::new(),
            }
        },
    }
}

#[test]
fn registry_commands_update_add_and_remove() -> () {
    let root = test_support::workspace("registry_commands");
    let registry = local_registry(root);
    let home = path::join(root, "home");
    let updated = run_with_home(
        Vec::from_array(["update", "--local-registry", registry]),
        root,
        home,
    );
    test_support::assert_success(updated);
    testing::assert(fs::is_file(path::join(home, "cache/registry/index.toml")));
    let project = path::join(root, "project");
    test_support::write_basic_project(project, "demo");
    let added = run_with_home(
        Vec::from_array(["add", "alice::http", "--local-registry", registry]),
        project,
        home,
    );
    test_support::assert_success(added);
    test_support::assert_contains(
        test_support::read_file(path::join(project, "goml.toml")),
        "\"alice::http\" = true",
    );
    let removed = run_with_home(
        Vec::from_array(["remove", "alice::http", "--local-registry", registry]),
        project,
        home,
    );
    test_support::assert_success(removed);
    test_support::assert_not_contains(
        test_support::read_file(path::join(project, "goml.toml")),
        "alice::http",
    )
}

#[test]
fn cached_registry_dependencies_build_with_unversioned_layout() -> () {
    let root = test_support::workspace("registry_dependency_build");
    let registry = local_registry(root);
    let home = path::join(root, "home");
    test_support::assert_success(
        run_with_home(Vec::from_array(["update", "--local-registry", registry]), root, home),
    );
    let project = path::join(root, "project");
    test_support::write_file(
        path::join(project, "goml.toml"),
        \\[module]
        \\path = "demo"
        \\
        \\[dependencies]
        \\"alice::http" = "1.0.0"
        \\"alice::appdep" = "0.1.0"
        \\
        ,
    );
    test_support::write_file(
        path::join(project, "main.goml"),
        \\package main;
        \\use alice::http;
        \\use alice::appdep;
        \\fn main() -> () { println(http::version() + ":" + appdep::marker()) }
        \\
        ,
    );
    let built = run_with_home(
        Vec::from_array(["build", "--compiler", test_support::gomlc_binary()]),
        project,
        home,
    );
    test_support::assert_success(built);
    testing::assert(
        fs::is_file(path::join(project, "_artifact/build/deps/alice/http/pkg/alice/http/http.core")),
    );
    let execution = match process::Command::new(path::join(project, "_artifact/bin/demo")).output_structured() {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message.to_string());
            built
        },
    };
    test_support::assert_success(execution);
    testing::assert_eq(test_support::stdout(execution), "1.2.0:appdep\n")
}
