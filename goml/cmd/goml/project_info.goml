package main;

use module::project;
use std::io;
use std::json;

fn run_project_info(args: Vec[string]) -> Result[(), string] {
    let mut source: Option[string] = Option::None;
    let mut registry: Option[string] = Option::None;
    let mut index = 2;
    while index < args.len() {
        let name = args[index];
        if name != "--source" && name != "--registry-root" {
            return Result::Err("unexpected project-info argument " + name)
        }
        let (value, next) = option_value(args, index, name, name)?;
        if name == "--source" {
            if source.is_some() {
                return Result::Err("--source cannot be repeated")
            }
            source = value;
        } else {
            if registry.is_some() {
                return Result::Err("--registry-root cannot be repeated")
            }
            registry = value;
        }
        index = next;
    }
    let result = project::describe_project(source.ok_or("--source is required")?, registry)?;
    io::println(json::encode(result));
    Result::Ok(())
}
