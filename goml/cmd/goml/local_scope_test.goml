package main;

use module::test_support;
use std::path;
use std::process;
use std::testing;

#[test]
fn local_dependency_prefix_uses_the_longest_declared_module_owner() -> () {
    let root = test_support::workspace("local_dependency_prefix");
    test_support::write_file(
        root + "/app/goml.toml",
        "[module]\npath = \"demo::app\"\n[dependencies]\n\"demo::app::plugin\" = { path = \"../plugin\" }\n",
    );
    test_support::write_file(
        root + "/app/main.goml",
        "package main; use demo::app::plugin; fn main() -> () { println(plugin::value()) }",
    );
    test_support::write_file(root + "/plugin/goml.toml", "[module]\npath = \"demo::app::plugin\"\n");
    test_support::write_file(
        root + "/plugin/plugin.goml",
        "package plugin; pub fn value() -> isize { 42 }",
    );
    let output = test_support::project_command("run", "", Vec::new(), root + "/app");
    test_support::assert_success(output);
    testing::assert_eq(test_support::stdout(output), "42\n");
}

#[test]
fn local_dependency_imports_require_direct_edges_but_public_types_keep_transitive_metadata() -> () {
    let root = test_support::workspace("local_dependency_visibility");
    test_support::write_file(
        root + "/app/goml.toml",
        "[module]\npath = \"demo::app\"\n[dependencies]\n\"demo::middle\" = { path = \"../middle\" }\n",
    );
    test_support::write_file(
        root + "/middle/goml.toml",
        "[module]\npath = \"demo::middle\"\n[dependencies]\n\"demo::leaf\" = { path = \"../leaf\" }\n",
    );
    test_support::write_file(root + "/leaf/goml.toml", "[module]\npath = \"demo::leaf\"\n");
    test_support::write_file(
        root + "/leaf/leaf.goml",
        "package leaf; pub struct Value { pub number: isize } pub fn value() -> Value { Value { number: 42 } }",
    );
    test_support::write_file(
        root + "/middle/middle.goml",
        "package middle; use demo::leaf; pub fn value() -> leaf::Value { leaf::value() }",
    );
    test_support::write_file(
        root + "/app/main.goml",
        "package main; use demo::middle; use demo::leaf; fn main() -> () { println(middle::value().number + leaf::value().number) }",
    );
    let rejected = test_support::project_command("check", "", Vec::new(), root + "/app");
    test_support::assert_failure(rejected);
    test_support::assert_contains(test_support::stderr(rejected), "direct dependency on demo::leaf");
    test_support::write_file(
        root + "/app/main.goml",
        "package main; use demo::middle; fn main() -> () { println(middle::value().number) }",
    );
    let output = test_support::project_command("run", "", Vec::new(), root + "/app");
    test_support::assert_success(output);
    testing::assert_eq(test_support::stdout(output), "42\n");
}

#[test]
fn workspace_tool_paths_use_the_invoking_directory() -> () {
    let root = test_support::workspace("workspace_tool_paths");
    test_support::write_file(root + "/goml.work", "[workspace]\nmembers = [\"app\"]\n");
    test_support::write_basic_project(root + "/app", "demo::app");
    let compiler = test_support::gomlc_binary();
    let compiler_path = testing::expect_ok(path::relative(root, compiler), "relative compiler");
    test_support::assert_success(
        test_support::run(
            Vec::from_array(["check", "--workspace", "--compiler", compiler_path]),
            root,
        ),
    );
    let formatter = path::join(path::parent(compiler).unwrap_or(""), "gomlfmt");
    let formatter_path = testing::expect_ok(path::relative(root, formatter), "relative formatter");
    let formatted = testing::expect_ok(
        process::Command::new(test_support::goml_binary()).args(
            Vec::from_array(["fmt", "--workspace", "--formatter=" + formatter_path]),
        ).env("GOMLC", compiler_path).current_dir(root).output_structured(),
        "workspace formatter",
    );
    test_support::assert_success(formatted);
    let arguments = testing::expect_ok(
        workspace_child_arguments(root, Vec::from_array(["run", "--", "--compiler", "./user"])),
        "program arguments",
    );
    testing::assert_eq(arguments[3], "./user");
}
