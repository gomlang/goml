package main;

use module::test_support;
use std::testing;

#[test]
fn workspace_cli_builds_members_and_rebuilds_changed_local_dependencies() -> () {
    let root = test_support::workspace("workspace_cli");
    test_support::write_file(root + "/goml.work", "[workspace]\nmembers = [\"app\", \"leaf\"]\n");
    test_support::write_file(
        root + "/app/goml.toml",
        "[module]\npath = \"demo::app\"\n[dependencies]\n\"demo::leaf\" = \"0.1.0\"\n",
    );
    test_support::write_file(
        root + "/app/main.goml",
        "package main;\nuse demo::leaf;\nfn main() -> () { println(leaf::value()) }\n",
    );
    test_support::write_file(root + "/leaf/goml.toml", "[module]\npath = \"demo::leaf\"\n");
    test_support::write_file(
        root + "/leaf/leaf.goml",
        "package leaf;\npub fn value() -> isize { 41 }\n",
    );
    test_support::assert_success(
        test_support::project_command("check", "", Vec::from_array(["--workspace"]), root + "/app"),
    );
    let initial = test_support::project_command(
        "run",
        "",
        Vec::from_array(["-p", "demo::app"]),
        root,
    );
    test_support::assert_success(initial);
    testing::assert_eq(test_support::stdout(initial), "41\n");
    test_support::write_file(
        root + "/leaf/leaf.goml",
        "package leaf;\npub fn value() -> isize { 42 }\n",
    );
    let changed = test_support::project_command(
        "run",
        "",
        Vec::from_array(["--package=demo::app"]),
        root,
    );
    test_support::assert_success(changed);
    testing::assert_eq(test_support::stdout(changed), "42\n");
    test_support::assert_failure(test_support::project_command("run", "", Vec::new(), root));
    test_support::assert_failure(
        test_support::project_command("check", "", Vec::from_array(["-p", "missing"]), root),
    );
}

#[test]
fn local_dependency_add_validates_identity_and_writes_portable_paths() -> () {
    let root = test_support::workspace("local_dependency_add");
    test_support::write_file(root + "/app/goml.toml", "[module]\npath = \"demo::app\"\n");
    test_support::write_file(root + "/leaf/goml.toml", "[module]\npath = \"demo::leaf\"\n");
    let added = test_support::run(
        Vec::from_array(["add", "demo::leaf", "--path", "../leaf"]),
        root + "/app",
    );
    test_support::assert_success(added);
    test_support::assert_contains(
        test_support::read_file(root + "/app/goml.toml"),
        "path = \"../leaf\"",
    );
    test_support::assert_failure(
        test_support::run(
            Vec::from_array(["add", "demo::wrong", "--path", "../leaf"]),
            root + "/app",
        ),
    );
    test_support::assert_success(
        test_support::run(Vec::from_array(["remove", "demo::leaf"]), root + "/app"),
    );
    test_support::assert_not_contains(
        test_support::read_file(root + "/app/goml.toml"),
        "demo::leaf",
    );
}

#[test]
fn local_dependency_commands_edit_multiline_tables_and_nested_module_names() -> () {
    let root = test_support::workspace("local_dependency_multiline");
    test_support::write_file(
        root + "/app/goml.toml",
        "[module]\npath = \"demo::app\"\n[dependencies] # local modules\n'demo::group::leaf' = {\n path = '../leaf', # source\n version = '0.1.0'\n}\n",
    );
    test_support::write_file(root + "/leaf/goml.toml", "[module]\npath = \"demo::group::leaf\"\n");
    test_support::assert_success(
        test_support::run(
            Vec::from_array(["add", "demo::group::leaf", "--path", "../leaf"]),
            root + "/app",
        ),
    );
    test_support::assert_not_contains(test_support::read_file(root + "/app/goml.toml"), "version");
    test_support::assert_success(
        test_support::run(Vec::from_array(["remove", "demo::group::leaf"]), root + "/app"),
    );
    test_support::assert_not_contains(
        test_support::read_file(root + "/app/goml.toml"),
        "dependencies",
    );
}
