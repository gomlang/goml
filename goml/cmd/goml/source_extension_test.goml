package main;

use module::test_support;
use std::fs;
use std::process;
use std::testing;

#[test]
fn source_extensions_exclude_legacy_and_keep_tests_private() -> () {
    let root = test_support::workspace("source_extensions");
    test_support::write_file(root + "/goml.toml", "[module]\npath = \"extensions\"\n");
    test_support::write_file(
        root + "/main.goml",
        "package main; fn main() -> () { println(value()) }",
    );
    test_support::write_file(root + "/value.goml", "package main; fn value() -> isize { 42 }");
    test_support::write_file(root + "/legacy.gom", "package main; fn main() -> () { println(0) }");
    test_support::write_file(
        root + "/main_test.goml",
        "package main; use std::testing; #[test] fn modern_test() -> () { testing::assert_eq(value(), 42) }",
    );
    test_support::write_file(root + "/legacy_test.gom", "invalid legacy test");
    test_support::write_file(root + "/ignored.goml.bak", "invalid source");
    let output = test_support::project_command("run", "", Vec::new(), root);
    test_support::assert_success(output);
    testing::assert_eq(test_support::stdout(output), "42\n");
    let tests = test_support::project_command("test", "", Vec::new(), root);
    test_support::assert_success(tests);
    test_support::assert_contains(test_support::stdout(tests), "1 passed");
    for arguments in Vec::from_array(
        [
            Vec::from_array(["run-single", root + "/legacy.gom"]),
            Vec::from_array(["package-info", "--input", root + "/legacy.gom"]),
            Vec::from_array(["lex", root + "/legacy.gom"]),
        ],
    ) {
        let rejected = testing::expect_ok(
            process::Command::new(test_support::gomlc_binary()).args(arguments).current_dir(root).output_structured(),
            "check legacy source rejection",
        );
        test_support::assert_failure(rejected);
        test_support::assert_contains(
            test_support::stderr(rejected),
            "source file must use the .goml extension",
        );
    }
    test_support::write_file(root + "/main_test.goml", "broken modern test");
    test_support::assert_success(test_support::project_command("check", "", Vec::new(), root));
    test_support::assert_failure(test_support::project_command("test", "", Vec::new(), root));
    testing::assert(fs::is_file(root + "/main.goml"));
}
