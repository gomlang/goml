package main;

use module::test_support;
use std::json;
use std::path;
use std::testing;

#[test]
fn api_snapshot_is_stable_and_diff_reports_removed_facades() -> () {
    let root = test_support::workspace("api_snapshot_facade");
    test_support::write_file(path::join(root, "goml.toml"), "[module]\npath = \"api_sample\"\n");
    test_support::write_file(
        path::join(root, "main.goml"),
        "package api_sample; pub use module::inner::{value};",
    );
    test_support::write_file(
        path::join(root, "inner/value.goml"),
        "package inner; pub fn value() -> isize { 7 }",
    );
    let first = test_support::run(Vec::from_array(["api", "snapshot"]), root);
    test_support::assert_success(first);
    let value = testing::expect_ok(
        json::parse(test_support::stdout(first)),
        "snapshot stdout must be JSON",
    );
    testing::assert(
        json::field(value, "scope").and_then(json::as_string) == Option::Some("source_api"),
    );
    let symbols = json::field(value, "symbols").unwrap_or(json::Value::Null);
    let facade = json::field(symbols, "api_sample::value").unwrap_or(json::Value::Null);
    testing::assert(
        json::field(facade, "declaration").and_then(json::as_string)
            == Option::Some("api_sample::inner::value"),
    );
    test_support::write_file(path::join(root, "baseline.json"), test_support::stdout(first));
    let consumer = path::join(root, "consumer");
    test_support::write_file(
        path::join(consumer, "goml.toml"),
        "[module]\npath = \"consumer\"\n[dependencies]\napi_sample = { path = \"..\" }\n",
    );
    test_support::write_file(
        path::join(consumer, "main.goml"),
        "package main; use api_sample as api; fn main() -> () { println(api::value()) }",
    );
    test_support::assert_success(test_support::run(Vec::from_array(["check"]), consumer));
    test_support::write_file(
        path::join(root, "inner/value.goml"),
        "package inner;\n\n/// New documentation.\npub fn value() -> isize { helper() }\nfn helper() -> isize { 9 }",
    );
    let second = test_support::run(Vec::from_array(["api", "snapshot"]), root);
    test_support::assert_success(second);
    testing::assert_eq(test_support::stdout(first), test_support::stdout(second));
    test_support::write_file(path::join(root, "main.goml"), "package api_sample;");
    let third = test_support::run(Vec::from_array(["api", "snapshot"]), root);
    test_support::assert_success(third);
    test_support::write_file(path::join(root, "current.json"), test_support::stdout(third));
    let difference = test_support::run(
        Vec::from_array(["api", "diff", "baseline.json", "current.json"]),
        root,
    );
    testing::assert(!difference.status().success());
    let report = testing::expect_ok(
        json::parse(test_support::stdout(difference)),
        "diff stdout must be JSON",
    );
    testing::assert(json::field(report, "breaking_changes").and_then(json::as_int).unwrap_or(0) > 0);
    testing::assert(test_support::stdout(difference).contains("api_sample::value"));
    test_support::assert_failure(test_support::run(Vec::from_array(["check"]), consumer));
}
