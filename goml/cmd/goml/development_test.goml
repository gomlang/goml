package main;

use module::test_support;
use std::fs;
use std::testing;

fn development_fixture(name: string) -> string {
    let root = test_support::workspace(name);
    test_support::write_file(
        root + "/library/goml.toml",
        "[module]\npath = \"demo::library\"\n[dev-dependencies]\n\"demo::helper\" = { path = \"../helper\" }\n",
    );
    test_support::write_file(
        root + "/library/library.goml",
        "package library; pub fn value() -> isize { 42 }",
    );
    test_support::write_file(root + "/helper/goml.toml", "[module]\npath = \"demo::helper\"\n");
    test_support::write_file(
        root + "/helper/helper.goml",
        "package helper; pub fn expected() -> isize { 42 }",
    );
    root
}

#[test]
fn development_helpers_can_depend_on_the_current_library() -> () {
    let root = development_fixture("development_back_edge");
    test_support::write_file(
        root + "/helper/goml.toml",
        "[module]\npath = \"demo::helper\"\n[dependencies]\n\"demo::library\" = \"1.0.0\"\n",
    );
    test_support::write_file(
        root + "/helper/helper.goml",
        "package helper; use demo::library; pub fn expected() -> isize { library::value() }",
    );
    test_support::write_file(
        root + "/library/tests/api_test.goml",
        "package tests; use demo::library; use demo::helper; use std::testing; #[test] fn external() -> () { testing::assert_eq(library::value(), helper::expected()) }",
    );
    test_support::write_file(
        root + "/library/examples/basic/main.goml",
        "package main; use demo::helper; fn main() -> () { println(helper::expected()) }",
    );
    for command in Vec::from_array(["test"]) {
        test_support::assert_success(
            test_support::project_command(command, "", Vec::new(), root + "/library"),
        );
    }
}

#[test]
fn development_dependencies_are_available_to_both_test_kinds() -> () {
    let root = development_fixture("development_test_dependencies");
    test_support::write_file(
        root + "/library/library_test.goml",
        "package library; use demo::helper; use std::testing; #[test] fn internal() -> () { testing::assert_eq(value(), helper::expected()) }",
    );
    test_support::write_file(
        root + "/library/tests/api_test.goml",
        "package tests; use demo::library; use demo::helper; use std::testing; #[test] fn external() -> () { testing::assert_eq(library::value(), helper::expected()) }",
    );
    for command in Vec::from_array(["test", "check"]) {
        let arguments = if command == "check" {
            Vec::from_array(["--tests"])
        } else {
            Vec::new()
        };
        test_support::assert_success(
            test_support::project_command(command, "", arguments, root + "/library"),
        );
    }
    test_support::assert_success(
        test_support::project_command("check", "", Vec::new(), root + "/library"),
    );
}

#[test]
fn development_dependencies_do_not_leak_into_production_or_downstream_modules() -> () {
    let root = development_fixture("development_dependency_isolation");
    test_support::write_file(
        root + "/library/library.goml",
        "package library; use demo::helper; pub fn value() -> isize { helper::expected() }",
    );
    for command in Vec::from_array(["check", "test"]) {
        test_support::assert_failure(
            test_support::project_command(command, "", Vec::new(), root + "/library"),
        );
    }
    test_support::write_file(
        root + "/library/library.goml",
        "package library; pub fn value() -> isize { 42 }",
    );
    test_support::write_file(
        root + "/library/goml.toml",
        "[module]\npath = \"demo::library\"\n[dev-dependencies]\n\"demo::missing\" = { path = \"../missing\" }\n",
    );
    test_support::write_file(
        root + "/app/goml.toml",
        "[module]\npath = \"demo::app\"\n[dependencies]\n\"demo::library\" = { path = \"../library\" }\n",
    );
    test_support::write_file(
        root + "/app/main.goml",
        "package main; use demo::library; fn main() -> () { println(library::value()) }",
    );
    let output = test_support::project_command("run", "", Vec::new(), root + "/app");
    test_support::assert_success(output);
    testing::assert_eq(test_support::stdout(output), "42\n");
    test_support::assert_success(
        test_support::project_command("check", "", Vec::new(), root + "/library"),
    );
    test_support::assert_failure(
        test_support::project_command("test", "", Vec::new(), root + "/library"),
    );
}

#[test]
fn development_examples_use_root_dependencies_and_are_excluded_from_production() -> () {
    let root = development_fixture("development_examples");
    test_support::write_file(
        root + "/library/examples/basic/main.goml",
        "package main; use demo::library; use demo::helper; fn main() -> () { println(library::value() + helper::expected()) }",
    );
    test_support::write_file(
        root + "/library/examples/basic/tests/api_test.goml",
        "package tests; use demo::helper; use std::testing; #[test] fn example() -> () { testing::assert_eq(helper::expected(), 42) }",
    );
    let output = test_support::project_command(
        "run",
        "",
        Vec::from_array(["--example", "basic"]),
        root + "/library",
    );
    test_support::assert_success(output);
    testing::assert_eq(test_support::stdout(output), "84\n");
    test_support::assert_success(
        test_support::project_command("test", "", Vec::new(), root + "/library"),
    );
    test_support::assert_success(
        test_support::project_command(
            "check",
            "",
            Vec::from_array(["--examples"]),
            root + "/library",
        ),
    );
    test_support::assert_success(
        test_support::project_command(
            "build",
            "",
            Vec::from_array(["--example=basic"]),
            root + "/library",
        ),
    );
    testing::assert(fs::is_file(root + "/library/_artifact/bin/examples/basic/basic"));
    test_support::write_file(root + "/library/examples/basic/main.goml", "broken example");
    test_support::assert_success(
        test_support::project_command("check", "", Vec::new(), root + "/library"),
    );
    test_support::assert_failure(
        test_support::project_command("test", "", Vec::new(), root + "/library"),
    );
    test_support::assert_failure(
        test_support::project_command(
            "run",
            "",
            Vec::from_array(["--example", "../helper"]),
            root + "/library",
        ),
    );
}

#[test]
fn development_dependency_commands_preserve_normal_requirements() -> () {
    let root = development_fixture("development_dependency_commands");
    test_support::write_file(
        root + "/library/goml.toml",
        "[module]\npath = \"demo::library\"\n[dependencies]\n\"demo::helper\" = \"0.1.0\"\n",
    );
    test_support::assert_success(
        test_support::run(
            Vec::from_array(["add", "demo::helper", "--dev", "--path", "../helper"]),
            root + "/library",
        ),
    );
    let manifest = testing::expect_ok(
        fs::read_file_structured(root + "/library/goml.toml"),
        "manifest",
    );
    testing::assert(manifest.contains("[dev-dependencies]"));
    testing::assert(manifest.contains("\"demo::helper\" = \"0.1.0\""));
    test_support::assert_success(
        test_support::run(Vec::from_array(["remove", "demo::helper", "--dev"]), root + "/library"),
    );
    let manifest = testing::expect_ok(
        fs::read_file_structured(root + "/library/goml.toml"),
        "manifest",
    );
    testing::assert(!manifest.contains("[dev-dependencies]"));
    testing::assert(manifest.contains("\"demo::helper\" = \"0.1.0\""));
}
