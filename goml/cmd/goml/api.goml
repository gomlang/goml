package main;

use module::commands;
use std::io;
use std::process;

fn api_help() -> string {
    "Usage: goml api snapshot [--compiler PROGRAM] [--target-dir DIR]\n       goml api diff BASELINE CURRENT [--compiler PROGRAM]\n\nSnapshot builds typed interfaces and writes source API JSON. Diff exits 1 for changes requiring review. This does not check runtime behavior or binary ABI."
}

fn run_api_cli(args: Vec[string]) -> Result[(), string] {
    if args.len() < 3 {
        return Err(api_help())
    }
    if args[2] == "--help" || args[2] == "-h" {
        io::println(api_help());
        return Ok(())
    }
    let code = if args[2] == "snapshot" {
        let options_args = Vec::from_array([args[0], "api"]);
        for index in 3..args.len() {
            options_args.push(args[index]);
        }
        let options = match parse_query_options(
            options_args,
            Vec::from_array(["--compiler", "--target-dir"]),
        ) {
            Ok(value) => value,
            Err(error) => if error == "help" {
                io::println(api_help());
                return Ok(())
            } else {
                return Err(error)
            },
        };
        commands::api_snapshot(options.get("--compiler"), options.get("--target-dir")).map_err(
            |error| error.to_string(),
        )?
    } else if args[2] == "diff" {
        let files = Vec::new();
        let mut compiler: Option[string] = None;
        let mut index = 3;
        while index < args.len() {
            let argument = args[index];
            if argument == "--help" || argument == "-h" {
                io::println(api_help());
                return Ok(())
            }
            let (value, next) = option_value(args, index, argument, "--compiler")?;
            if let Some(value) = value {
                if compiler.is_some() {
                    return Err("--compiler cannot be repeated")
                }
                if value == "" || value.starts_with("--") {
                    return Err("--compiler requires a value")
                }
                compiler = Some(value);
                index = next;
            } else {
                if argument.starts_with("-") {
                    return Err("unexpected argument " + argument)
                }
                files.push(argument);
                index += 1;
            }
        }
        if files.len() != 2 {
            return Err("API diff requires BASELINE and CURRENT snapshot paths")
        }
        commands::api_diff(compiler, files[0], files[1]).map_err(|error| error.to_string())?
    } else {
        return Err("unknown API command " + args[2])
    };
    if code != 0 {
        process::exit(code)
    }
    Ok(())
}
