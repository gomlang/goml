package main;

use module::manifest;
use module::project;
use std::env;
use std::fs;
use std::path;
use std::process;

fn workspace_program_path(directory: string, value: string) -> string {
    if !path::is_absolute(value)
        && (value.contains("/") || value.contains("\\") || fs::is_file(path::join(directory, value))) {
        path::join(directory, value)
    } else {
        value
    }
}

fn workspace_child_arguments(directory: string, arguments: Vec[string]) -> Result[
    Vec[string],
    string,
] {
    let result = Vec::new();
    let mut index = 0;
    while index < arguments.len() {
        let argument = arguments[index];
        if argument == "--" {
            while index < arguments.len() {
                result.push(arguments[index]);
                index += 1;
            }
            break;
        }
        let option = if argument == "--compiler" || argument.starts_with("--compiler=") {
            Option::Some("--compiler")
        } else if argument == "--formatter" || argument.starts_with("--formatter=") {
            Option::Some("--formatter")
        } else {
            Option::None
        };
        if let Some(option) = option {
            let (value, next) = option_value(arguments, index, argument, option)?;
            result.push(option);
            result.push(workspace_program_path(directory, value.unwrap_or("")));
            index = next;
        } else {
            result.push(argument);
            index += 1;
        }
    }
    Result::Ok(result)
}

fn dispatch_workspace(args: Vec[string]) -> Result[Option[isize], string] {
    if args.len() < 2 {
        return Result::Ok(Option::None)
    }
    let command = args[1];
    match command {
        "check" | "build" | "test" | "fmt" | "doc" | "clean" | "run" => (),
        _ => return Result::Ok(Option::None),
    }
    let child = Vec::from_array([command]);
    let mut all = false;
    let mut selected: Option[string] = Option::None;
    let mut index = 2;
    while index < args.len() {
        let argument = args[index];
        if argument == "--" {
            while index < args.len() {
                child.push(args[index]);
                index += 1;
            }
            break;
        } else if argument == "--help" || argument == "-h" {
            return Result::Ok(Option::None)
        } else if argument == "--workspace" {
            if all {
                return Result::Err("--workspace cannot be repeated")
            }
            all = true;
            index += 1;
        } else if argument == "-p" || argument == "--package" || argument.starts_with("--package=") {
            if selected.is_some() {
                return Result::Err("--package cannot be repeated")
            }
            let parsed = option_value(
                args,
                index,
                argument,
                if argument == "-p" {
                    "-p"
                } else {
                    "--package"
                },
            )?;
            selected = parsed.0;
            index = parsed.1;
        } else {
            child.push(argument);
            index += 1;
        }
    }
    if all && selected.is_some() {
        return Result::Err("--workspace conflicts with --package")
    }
    let current = env::current_dir_structured().map_err(|error| error.to_string())?;
    if !all && selected.is_none() && project::find_module_root(current).is_ok() {
        return Result::Ok(Option::None)
    }
    let workspace = match manifest::find_workspace(current)? {
        Some(value) => value,
        None => if all || selected.is_some() {
            return Result::Err("could not find goml.work")
        } else {
            return Result::Ok(Option::None)
        },
    };
    let members: Vec[manifest::LocalModule] = Vec::new();
    for member in workspace.members {
        if selected.is_none() || selected == Option::Some(member.name) {
            members.push(member)
        }
    }
    if members.is_empty() {
        return Result::Err("workspace has no member " + selected.unwrap_or(""))
    }
    if command == "run" && members.len() != 1 {
        return Result::Err("goml run requires --package when the workspace has multiple members")
    }
    let executable = env::current_exe_structured().map_err(|error| error.to_string())?;
    let child = workspace_child_arguments(current, child)?;
    for member in members {
        let command = process::Command::new(executable).args(child).current_dir(member.root).env(
            "GOML_WORKSPACE",
            workspace.root,
        );
        for name in Vec::from_array(["GOMLC", "GOMLFMT"]) {
            if let Ok(value) = env::var_structured(name) {
                if value != "" {
                    command.env(name, workspace_program_path(current, value));
                }
            }
        }
        let status = command.status_structured().map_err(|error| error.to_string())?;
        let code = status.code().ok_or("workspace command terminated by signal")?;
        if code != 0 {
            return Result::Ok(Option::Some(code))
        }
    }
    Result::Ok(Option::Some(0))
}
