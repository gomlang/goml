package main;

use module::test_support;
use std::path;
use std::process;
use std::testing;

#[test]
fn native_prerequisites_fail_before_foreign_compilation() -> () {
    let root = ffi_project_fixture("native_prerequisites");
    for (configuration, variable, value, expected) in Vec::from_array(
        [
            ("cgo = \"required\"", "CGO_ENABLED", "0", "CGO_ENABLED=1 is required"),
            ("llvm-major = \"18\"", "LLVM_CONFIG", "/bin/echo", "LLVM 18 required, found"),
        ],
    ) {
        test_support::write_file(
            path::join(root, "goml.toml"),
            "[module]\npath = \"ffi_demo\"\n[native]\ngo-module = \"example.com/ffi-demo\"\n"
                + configuration
                + "\n",
        );
        let command = process::Command::new(test_support::goml_binary()).args(
            Vec::from_array(["check", "--compiler", test_support::gomlc_binary()]),
        ).current_dir(root).env(variable, value);
        let output = testing::expect_ok(command.output_structured(), "native prerequisite check");
        test_support::assert_failure(output);
        test_support::assert_contains(test_support::stderr(output), expected);
        let output = testing::expect_ok(
            command.arg("--dry-run").output_structured(),
            "native prerequisite dry run",
        );
        test_support::assert_success(output);
    }
}

#[test]
fn native_registry_adapters_support_go_export_and_cached_validation() -> () {
    let root = test_support::workspace("native_registry_export");
    let home = root + "/home";
    let adapter = home + "/cache/registry/demo/native/0.1.0";
    let project = root + "/project";
    test_support::write_file(
        home + "/cache/registry/index.toml",
        "[modules.\"demo::native\"]\nlatest = \"0.1.0\"\nversions = [\"0.1.0\"]\n",
    );
    test_support::write_file(
        adapter + "/goml.toml",
        "[module]\npath = \"demo::native\"\n[native]\ngo-module = \"example.com/native\"\n",
    );
    test_support::write_file(adapter + "/go.mod", "module example.com/native\n\ngo 1.26.0\n");
    test_support::write_file(
        adapter + "/native.go",
        "package native\nfunc Value() int64 { return 42 }\n",
    );
    test_support::write_file(
        adapter + "/lib.gom",
        "package native; #[go_ffi(\"example.com/native\", \"Value\")] pub extern fn value() -> i64;",
    );
    test_support::write_file(
        project + "/goml.toml",
        "[module]\npath = \"app\"\n[dependencies]\n\"demo::native\" = \"0.1.0\"\n",
    );
    let original = "module example.com/app\n\ngo 1.26.0\n";
    test_support::write_file(project + "/go.mod", original);
    test_support::write_file(
        project + "/api.gom",
        "package api; use demo::native; #[go_export(\"Value\")] pub fn value() -> i64 { native::value() }",
    );
    for _ in 0..2 {
        let output = run_with_home(
            Vec::from_array(
                [
                    "export-go",
                    "--out",
                    "generated",
                    "--import-path",
                    "example.com/app/generated",
                    "--compiler",
                    test_support::gomlc_binary(),
                ],
            ),
            project,
            home,
        );
        test_support::assert_success(output);
    }
    test_support::assert_contains(
        test_support::read_file(project + "/generated/goml_exports.json"),
        "-modfile=",
    );
    testing::assert_eq(test_support::read_file(project + "/go.mod"), original);
}
