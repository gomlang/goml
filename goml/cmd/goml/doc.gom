package main;

use module::commands;
use std::io;
use std::process;

fn doc_help() -> string {
    \\Usage: goml doc [OPTIONS]
    \\
    \\Options:
    \\  --format html|json        output format (default: html)
    \\  --target-dir DIR          build target directory
    \\  --document-private-items  include private API
    \\  --documenter PROGRAM      gomldoc executable
    \\  --compiler PROGRAM        gomlc executable
    \\  --dry-run                 print the command
    \\  -h, --help                print help
}

fn parse_doc(args: Vec[string]) -> Result[commands::DocOptions, string] {
    let values: HashMap[string, string] = HashMap::new();
    let mut private_items = false;
    let mut dry_run = false;
    let mut index = 2;
    while index < args.len() {
        let argument = args[index];
        if argument == "--help" || argument == "-h" {
            return Result::Err("help")
        } else if argument == "--dry-run" {
            if dry_run {
                return Result::Err("--dry-run cannot be repeated")
            }
            dry_run = true;
            index += 1;
        } else if argument == "--document-private-items" {
            if private_items {
                return Result::Err("--document-private-items cannot be repeated")
            }
            private_items = true;
            index += 1;
        } else {
            let mut found = false;
            for name in Vec::from_array(["--format", "--target-dir", "--compiler", "--documenter"]) {
                if !found {
                    let parsed = option_value(args, index, argument, name)?;
                    if let Some(value) = parsed.0 {
                        if value == "" || value.starts_with("--") {
                            return Result::Err(name + " requires a value")
                        }
                        if values.get(name).is_some() {
                            return Result::Err(name + " cannot be repeated")
                        }
                        let _ = values.insert(name, value);
                        index = parsed.1;
                        found = true;
                    }
                }
            }
            if !found {
                return Result::Err("unexpected argument " + argument)
            }
        }
    }
    let format = values.get("--format").unwrap_or("html");
    if format != "html" && format != "json" {
        return Result::Err("--format must be html or json")
    }
    Result::Ok(
        commands::DocOptions {
            format,
            target_dir: values.get("--target-dir"),
            compiler: values.get("--compiler"),
            documenter: values.get("--documenter"),
            private_items,
            dry_run,
        },
    )
}

fn run_doc_cli(args: Vec[string]) -> Result[(), string] {
    match parse_doc(args) {
        Ok(options) => {
            let code = commands::document_module(options)?;
            if code != 0 {
                process::exit(code)
            }
            Result::Ok(())
        },
        Err(error) => if error == "help" {
            io::println(doc_help());
            Result::Ok(())
        } else {
            Result::Err(error)
        },
    }
}
