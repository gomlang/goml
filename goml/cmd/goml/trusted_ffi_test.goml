package main;

use module::test_support;
use std::fs;
use std::path;
use std::process;
use std::testing;

#[test]
fn handwritten_go_adapters_work_without_toolchain_helpers() -> () {
    let root = ffi_project_fixture("ffi_without_toolchain_helpers");
    test_support::write_file(
        path::join(root, "main_test.goml"),
        "package main; use std::testing; #[test] fn adapter_is_callable() -> () { testing::assert_eq(value(41), 42); }",
    );
    let compiler = path::join(root, "toolchain/bin/gomlc");
    test_support::create_dir(path::parent(compiler).unwrap_or(""));
    test_support::assert_success(
        testing::expect_ok(
            process::Command::new("cp").args(
                Vec::from_array([test_support::gomlc_binary(), compiler]),
            ).output_structured(),
            "copy compiler without adjacent helpers",
        ),
    );
    let compiler_directory = path::parent(test_support::gomlc_binary()).unwrap_or("");
    let resources = path::join(path::parent(compiler_directory).unwrap_or(""), "lib");
    test_support::assert_success(
        testing::expect_ok(
            process::Command::new("ln").args(
                Vec::from_array(["-s", resources, path::join(root, "toolchain/lib")]),
            ).output_structured(),
            "provide compiler resources",
        ),
    );
    for command in Vec::from_array(["check", "build", "run", "test"]) {
        let args = Vec::from_array([command, "--compiler", compiler]);
        if command == "test" {
            args.push("--kind");
            args.push("internal");
        }
        let output = test_support::run(args, root);
        test_support::assert_success(output);
        if command == "run" {
            testing::assert_eq(test_support::stdout(output), "42\n");
        } else if command == "test" {
            test_support::assert_contains(
                test_support::stdout(output),
                "adapter_is_callable ... ok",
            );
            test_support::assert_contains(test_support::stdout(output), "test result: ok.");
        }
    }
    testing::assert(!fs::exists(path::join(root, "_artifact/ffi-build-context.json")));
    test_support::write_file(
        path::join(root, "exported/lib.goml"),
        "package exported; #[go_ffi(\"example.com/ffi-demo/shim\", \"Value\")] extern fn value(x: i64) -> i64; #[go_export(\"Value\")] pub fn exported_value(x: i64) -> i64 { value(x) }",
    );
    test_support::assert_success(
        test_support::run(
            Vec::from_array(
                [
                    "export-go",
                    "exported",
                    "--compiler",
                    compiler,
                    "--import-path",
                    "example.com/ffi-demo/generated",
                    "--out",
                    "generated",
                ],
            ),
            root,
        ),
    );
    testing::assert(fs::exists(path::join(root, "generated/goml_generated.go")));
}
