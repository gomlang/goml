package main;

use module::test_support;
use std::json;
use std::path;
use std::testing;

#[test]
fn documentation_driver_discovers_module_and_uses_target_directory() -> () {
    let root = test_support::workspace("documentation_driver");
    test_support::write_file(
        path::join(root, "goml.toml"),
        "[module]\npath = \"driver_docs\"\n[build]\ntarget-dir = \"build/output\"\n",
    );
    test_support::write_file(
        path::join(root, "nested/main.gom"),
        "package sample;\n/// A documented function.\npub fn answer() -> isize { 42 }\n",
    );
    let nested = path::join(root, "nested");
    let dry = test_support::run(Vec::from_array(["doc", "--dry-run"]), nested);
    test_support::assert_success(dry);
    let output = test_support::run(Vec::from_array(["doc", "--format", "json"]), nested);
    test_support::assert_success(output);
    let contents = test_support::read_file(path::join(root, "build/output/doc/module.json"));
    let value = testing::expect_ok(json::parse(contents), "documentation JSON");
    testing::assert(
        json::field(value, "module").and_then(json::as_string) == Option::Some("driver_docs"),
    );
    testing::assert(contents.contains("A documented function."));
    let repeated = test_support::run(Vec::from_array(["doc", "--format", "json"]), nested);
    test_support::assert_success(repeated);
    testing::assert_eq(
        test_support::read_file(path::join(root, "build/output/doc/module.json")),
        contents,
    );
}

#[test]
fn documentation_driver_validates_options() -> () {
    for arguments in Vec::from_array(
        [
            Vec::from_array(["goml", "doc", "--format", "xml"]),
            Vec::from_array(["goml", "doc", "--target-dir"]),
            Vec::from_array(["goml", "doc", "--documenter", "--dry-run"]),
            Vec::from_array(["goml", "doc", "--dry-run", "--dry-run"]),
            Vec::from_array(["goml", "doc", "unexpected"]),
        ],
    ) {
        testing::assert_err(parse_doc(arguments))
    }
}
