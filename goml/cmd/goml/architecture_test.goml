package main;

use module::test_support;
use std::fs;
use std::path;
use std::process;
use std::testing;

fn architecture_workspace(name: string, scope: string) -> string {
    let root = test_support::workspace(name);
    test_support::write_file(path::join(root, "goml.toml"), "[module]\npath = \"demo\"\n");
    test_support::write_file(path::join(root, "main.goml"), "package demo;\n");
    test_support::write_file(
        path::join(root, "web/value.goml"),
        "package web;\npub fn value() -> i32 { 1 }\n",
    );
    test_support::write_file(
        path::join(root, "device/value.goml"),
        "package device;\npub fn value() -> i32 { 1 }\n",
    );
    test_support::write_file(
        path::join(root, "goml.architecture.json"),
        "{\"schema_version\":1,\"rules\":[{\"name\":\"reusable-no-app\",\"from\":[{\"package\":\"demo::device\",\"subpackages\":true}],\"forbid\":[{\"package\":\"demo::web\",\"subpackages\":true}],\"scope\":\""
            + scope
            + "\"}]}",
    );
    root
}

fn architecture_command(root: string) -> process::Output {
    testing::expect_ok(
        process::Command::new(test_support::goml_binary()).args(
            Vec::from_array(["architecture", "--compiler", test_support::gomlc_binary()]),
        ).current_dir(root).env("GOML_WORKSPACE", "off").env("GOML_HOME", path::join(root, "home")).output_structured(),
        "architecture command",
    )
}

#[test]
fn architecture_cli_rejects_alias_imports_and_reexports_without_building() -> () {
    let root = architecture_workspace("architecture_alias", "production");
    test_support::write_file(
        path::join(root, "device/value.goml"),
        "package device;\nuse module::web as rendering;\npub fn value() -> i32 { rendering::value() }\n",
    );
    let alias = architecture_command(root);
    testing::assert(!process::ExitStatus::success(alias.status()));
    let message = test_support::stderr(alias);
    testing::assert(message.contains("reusable-no-app"));
    testing::assert(message.contains("demo::device -> demo::web"));
    testing::assert(message.contains("value.goml:2:"));
    test_support::write_file(
        path::join(root, "device/value.goml"),
        "package device;\npub use module::web::{value};\n",
    );
    let reexport = architecture_command(root);
    testing::assert(!process::ExitStatus::success(reexport.status()));
    testing::assert(test_support::stderr(reexport).contains("reexport"));
    testing::assert(!fs::exists(path::join(root, "_artifact")));
    testing::assert(!fs::exists(path::join(root, "home")));
}

#[test]
fn architecture_cli_applies_test_scope_and_fails_on_incomplete_graphs() -> () {
    let root = architecture_workspace("architecture_scope", "production");
    test_support::write_file(
        path::join(root, "device/value_test.goml"),
        "package device;\nuse module::web;\n#[test]\nfn reads() -> () { let _ = web::value(); }\n",
    );
    test_support::assert_success(architecture_command(root));
    let rules = test_support::read_file(path::join(root, "goml.architecture.json"));
    test_support::write_file(
        path::join(root, "goml.architecture.json"),
        rules.replace("production", "tests"),
    );
    let tests = architecture_command(root);
    testing::assert(!process::ExitStatus::success(tests.status()));
    testing::assert(test_support::stderr(tests).contains("internal_test"));
    test_support::write_file(
        path::join(root, "device/value.goml"),
        "package device;\nuse module::missing;\n",
    );
    let incomplete = architecture_command(root);
    testing::assert(!process::ExitStatus::success(incomplete.status()));
    testing::assert(test_support::stderr(incomplete).contains("incomplete"));
}
