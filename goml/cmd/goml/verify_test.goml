package main;

use module::test_support;
use std::fs;
use std::testing;

#[test]
fn development_verify_isolates_examples_and_explicit_downstream_fixtures() -> () {
    let root = development_fixture("development_verify");
    test_support::write_file(
        root + "/library/library.goml",
        "package library; use std::json; use json::Serialize; #[derive(Serialize)] pub struct Value[T] { pub value: T } pub fn value[T](value: T) -> Value[T] { Value { value } }",
    );
    test_support::write_file(
        root + "/library/examples/basic/main.goml",
        "package main; use demo::library; pub fn result() -> isize { library::value(42).value } fn main() -> () { println(result()) }",
    );
    test_support::write_file(
        root + "/library/examples/basic/tests/api_test.goml",
        "package tests; use demo::library; use demo::library::examples::basic as example; use demo::helper; use std::testing; use std::json; use std::env; use std::fs; #[test] fn boundary() -> () { testing::assert_eq(example::result(), helper::expected()); testing::assert_eq(json::try_to_string(library::value(42)).unwrap_or(\"\"), \"{\\\"value\\\":42}\"); let home = env::var_structured(\"GOML_HOME\").unwrap_or(\"\"); testing::assert(fs::is_file(home + \"/cache/registry/demo/library/0.0.0/goml.toml\")); testing::assert_eq(env::var_structured(\"GOML_WORKSPACE\").unwrap_or(\"\"), \"off\"); }",
    );
    test_support::write_file(
        root + "/library/testdata/downstream/special/goml.toml",
        "[module]\npath = \"demo::special\"\n[dependencies]\n\"demo::library\" = { path = \"../../..\" }\n[dev-dependencies]\n\"demo::helper\" = { path = \"../../../../helper\" }\n",
    );
    test_support::write_file(
        root + "/library/testdata/downstream/special/main.goml",
        "package main; use demo::library; fn main() -> () { println(library::value(42).value) }",
    );
    test_support::write_file(
        root + "/library/testdata/downstream/special/main_test.goml",
        "package main; use demo::helper; use std::testing; #[test] fn helper() -> () { testing::assert_eq(helper::expected(), 42) }",
    );
    let dry = test_support::project_command(
        "verify",
        "",
        Vec::from_array(["--dry-run"]),
        root + "/library",
    );
    test_support::assert_success(dry);
    testing::assert(!fs::exists(root + "/library/_artifact/verify"));
    for _ in 0..2 {
        let output = test_support::project_command("verify", "", Vec::new(), root + "/library");
        test_support::assert_success(output);
        test_support::assert_contains(test_support::stderr(output), "verified 2 downstream cases");
    }
    test_support::write_file(
        root + "/library/testdata/downstream/special/main.goml",
        "broken fixture",
    );
    test_support::assert_success(
        test_support::project_command(
            "verify",
            "",
            Vec::from_array(["--example", "basic"]),
            root + "/library",
        ),
    );
    test_support::assert_failure(
        test_support::project_command("verify", "", Vec::new(), root + "/library"),
    );
}

#[test]
fn development_verify_reports_missing_cases_and_module_relative_imports() -> () {
    let root = development_fixture("development_verify_diagnostics");
    let output = test_support::project_command("verify", "", Vec::new(), root + "/library");
    test_support::assert_failure(output);
    test_support::assert_contains(test_support::stderr(output), "no downstream cases");
    test_support::write_file(
        root + "/library/detail/detail.goml",
        "package detail; pub fn value() -> isize { 42 }",
    );
    test_support::write_file(
        root + "/library/examples/basic/main.goml",
        "package main; use module::detail; fn main() -> () { println(detail::value()) }",
    );
    let output = test_support::project_command("verify", "", Vec::new(), root + "/library");
    test_support::assert_failure(output);
    test_support::assert_contains(test_support::stderr(output), "must use canonical imports");
}

#[test]
fn development_verify_copies_native_adapters_and_provides_a_go_module() -> () {
    let root = development_fixture("development_verify_native");
    test_support::write_file(
        root + "/library/goml.toml",
        "[module]\npath = \"demo::library\"\n[native]\ngo-module = \"example.com/verify-library\"\n",
    );
    let go_module = "module example.com/verify-library\n\ngo 1.26.0\n";
    test_support::write_file(root + "/library/go.mod", go_module);
    test_support::write_file(
        root + "/library/native.go",
        "package library\nfunc Value() int64 { return 42 }\n",
    );
    test_support::write_file(
        root + "/library/library.goml",
        "package library; #[go_ffi(\"example.com/verify-library\", \"Value\")] pub extern fn value() -> i64;",
    );
    test_support::write_file(
        root + "/library/examples/basic/main.goml",
        "package main; use demo::library; fn main() -> () { println(library::value()) }",
    );
    test_support::write_file(
        root + "/library/examples/basic/main_test.goml",
        "package main; use demo::library; use std::testing; #[test] fn adapter() -> () { testing::assert_eq(library::value(), 42) }",
    );
    test_support::assert_success(
        test_support::project_command("verify", "", Vec::new(), root + "/library"),
    );
    testing::assert_eq(test_support::read_file(root + "/library/go.mod"), go_module);
    testing::assert(!fs::exists(root + "/library/examples/basic/go.mod"));
}
