package main;

use std::testing;

#[test]
fn parses_pgo_and_performance_options() -> () {
    let args = testing::expect_ok(
        parse_cli(
            Vec::from_array(
                ["goml", "build", "--pgo=training.pgo", "--explain-performance", "--format", "json"],
            ),
        ),
        "performance options",
    );
    testing::assert_eq(args.build_options.pgo.unwrap_or(""), "training.pgo");
    testing::assert(args.build_options.record);
    testing::assert_eq(args.build_options.explain.unwrap_or(""), "json");
    let run = testing::expect_ok(
        parse_cli(
            Vec::from_array(
                ["goml", "run", "--pgo", "off", "--build-record", "--", "--pgo=app-argument"],
            ),
        ),
        "run options",
    );
    testing::assert_eq(run.build_options.pgo.unwrap_or(""), "off");
    testing::assert_eq(run.program_args[0], "--pgo=app-argument");
    let plain = testing::expect_ok(
        parse_cli(Vec::from_array(["goml", "build"])),
        "ordinary options",
    );
    testing::assert(!plain.build_options.record);
    testing::assert(plain.build_options.pgo.is_none());
    testing::assert(plain.build_options.explain.is_none());
}

#[test]
fn rejects_invalid_performance_options() -> () {
    for options in Vec::from_array(
        [
            Vec::from_array(["goml", "build", "--pgo="]),
            Vec::from_array(["goml", "build", "--pgo"]),
            Vec::from_array(["goml", "build", "--pgo", "off", "--pgo", "auto"]),
            Vec::from_array(["goml", "build", "--build-record", "--build-record"]),
            Vec::from_array(["goml", "build", "--format=json"]),
            Vec::from_array(["goml", "build", "--explain-performance", "--format=invalid"]),
            Vec::from_array(["goml", "build", "--explain-performance", "--explain-performance"]),
            Vec::from_array(["goml", "check", "--pgo=off"]),
            Vec::from_array(["goml", "run", "--explain-performance"]),
        ],
    ) {
        testing::assert(parse_cli(options).is_err());
    }
}
