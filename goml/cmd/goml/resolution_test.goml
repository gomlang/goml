package main;

use std::testing;

#[test]
fn resolution_flags_preserve_run_program_arguments() -> () {
    let args = Vec::from_array(
        ["goml", "run", "--locked", "--offline", "main", "--", "--locked", "--offline"],
    );
    let (parsed, locked, offline) = testing::expect_ok(
        parse_resolution_options(args),
        "parse resolution options",
    );
    testing::assert(locked && offline);
    testing::assert(
        parsed == Vec::from_array(["goml", "run", "main", "--", "--locked", "--offline"]),
    );
}

#[test]
fn resolution_flags_reject_mutation_and_duplicate_options() -> () {
    for command in["lock", "update", "add", "remove"] {
        testing::assert(
            parse_resolution_options(Vec::from_array(["goml", command, "--locked"])).is_err(),
        );
    }
    for option in["--locked", "--offline"] {
        testing::assert(
            parse_resolution_options(Vec::from_array(["goml", "build", option, option])).is_err(),
        );
    }
    let (_, locked, offline) = testing::expect_ok(
        parse_resolution_options(Vec::from_array(["goml", "check", "--offline"])),
        "offline alone",
    );
    testing::assert(!locked && offline);
}
