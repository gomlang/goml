package main;

use module::manifest;
use module::project;
use module::util;
use std::json;
use std::path;
use std::testing;
use std::text;

fn project_context(entry_package: string) -> project::Context {
    project::Context {
        foreign: Option::None,
        graph: project::Graph {
            module_dir: ".",
            module_path: "alice::demo",
            entry_package,
            packages: Vec::from_array(
                [
                    project::Package {
                        go_foreign: false,
                        name: entry_package,
                        declared_name: "main",
                        module_name: "alice::demo",
                        directory: ".",
                        artifact_prefix: "pkg",
                        files: Vec::new(),
                        imports: Vec::new(),
                    },
                ],
            ),
            sources: Vec::from_array(
                [
                    project::ModuleSource {
                        name: "alice::demo",
                        directory: ".",
                        artifact_prefix: "pkg",
                        dependencies: Vec::new(),
                    },
                ],
            ),
            order: Vec::from_array([entry_package]),
        },
        compiler: "gomlc",
        compiler_world: project::CompilerWorld::Source,
        artifact_root: "_artifact",
    }
}

#[test]
fn parses_fmt_options() -> () {
    match parse_fmt(Vec::from_array(["goml", "fmt", "--check", "--formatter", "/tmp/gomlfmt"])) {
        Ok(options) => {
            testing::assert(options.check);
            match options.formatter {
                Some(value) => testing::assert_eq(value, "/tmp/gomlfmt"),
                None => testing::fail("missing formatter override"),
            }
        },
        Err(message) => testing::fail(message),
    }
    match parse_fmt(Vec::from_array(["goml", "fmt"])) {
        Ok(options) => {
            testing::assert(!options.check);
            testing::assert(options.formatter.is_none())
        },
        Err(message) => testing::fail(message),
    }
}

#[test]
fn rejects_invalid_fmt_options() -> () {
    match parse_fmt(Vec::from_array(["goml", "fmt", "--check", "--check"])) {
        Ok(_) => testing::fail("repeated --check accepted"),
        Err(message) => testing::assert_eq(message, "--check cannot be repeated"),
    }
    match parse_fmt(Vec::from_array(["goml", "fmt", "main.gom"])) {
        Ok(_) => testing::fail("fmt file target accepted"),
        Err(message) => testing::assert_eq(message, "unexpected argument main.gom"),
    }
}

#[test]
fn utility_text_operations_are_deterministic() -> () {
    testing::assert_eq(text::trim(" \tvalue\r\n"), "value");
    testing::assert("abc".starts_with("ab"));
    testing::assert("abc".ends_with("bc"));
    testing::assert("abcdef".contains("cde"));
    testing::assert(Vec::from_array(["goml", "gomlc"]).contains("gomlc"));
    testing::assert(Vec::from_array([1, 2]).contains(2));
    testing::assert_eq(
        text::join(util::sorted_unique(Vec::from_array(["b", "a", "b"])), ","),
        "a,b",
    )
}

#[test]
fn json_parser_reads_package_info_shape() -> () {
    let value = match json::parse(
        "{\"files\":[{\"package\":\"main\",\"uses\":[]}],\"protocol_version\":1}",
    ) {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            json::Value::Null
        },
    };
    match json::field(value, "protocol_version") {
        Some(Number(value)) => {
            testing::assert_eq(value, "1")
        },
        _ => testing::fail("missing protocol version"),
    }
    match json::field(value, "files") {
        Some(value) => match json::as_array(value) {
            Some(values) => testing::assert_eq(values.len(), 1),
            None => testing::fail("files was not an array"),
        },
        None => testing::fail("missing files"),
    }
}

#[test]
fn manifest_parser_reads_project_manifest() -> () {
    match manifest::load("goml.toml") {
        Ok(value) => {
            testing::assert_eq(value.module_path, "gomlang::bootstrap_goml");
            testing::assert_eq(value.target_dir, "_artifact")
        },
        Err(message) => testing::fail(message),
    }
}

#[test]
fn run_plan_places_executables_under_package_paths() -> () {
    let root = match project::run_plan(project_context("alice::demo")) {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            return ()
        },
    };
    match root.executable {
        Some(value) => testing::assert_eq(value, path::join(path::join("_artifact", "bin"), "demo")),
        None => testing::fail("missing root executable"),
    }
    let nested = match project::run_plan(project_context("alice::demo::cmd::server")) {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            return ()
        },
    };
    match nested.executable {
        Some(value) => testing::assert_eq(
            value,
            path::join(
                path::join(path::join(path::join("_artifact", "bin"), "cmd"), "server"),
                "server",
            ),
        ),
        None => testing::fail("missing nested executable"),
    }
}

#[test]
fn shell_escape_quotes_unsafe_arguments() -> () {
    testing::assert_eq(util::shell_escape("plain/path"), "plain/path");
    testing::assert_eq(util::shell_escape("two words"), "'two words'");
    testing::assert_eq(util::shell_escape("你好's goml"), "'你好'\\''s goml'")
}
