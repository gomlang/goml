package architecture;

use std::json;
use std::text;

fn object_fields(value: json::Value, allowed: Vec[string], context: string) -> Result[(), string] {
    let json::Value::Object(fields) = value else {
        return Err(context + " must be an object")
    };
    let seen: Vec[string] = Vec::new();
    for (name, _) in fields {
        if !allowed.contains(name) {
            return Err(context + ": unknown field " + name)
        }
        if seen.contains(name) {
            return Err(context + ": duplicate field " + name)
        }
        seen.push(name);
    }
    Ok(())
}

fn required_string(value: json::Value, name: string, context: string) -> Result[string, string] {
    let result = json::field(value, name).and_then(json::as_string).ok_or(
        context + ": " + name + " must be a string",
    )?;
    if result == "" {
        return Err(context + ": " + name + " must not be empty")
    }
    Ok(result)
}

fn valid_package(value: string) -> bool {
    if value == "" {
        return false
    }
    for segment in text::split(value, "::") {
        if segment == "" {
            return false
        }
        for index in 0..segment.byte_len() {
            let byte = segment.byte_get(index);
            if !((byte >= b'a' && byte <= b'z') || (byte >= b'A' && byte <= b'Z') || byte == b'_'
                || (index > 0 && byte >= b'0' && byte <= b'9')) {
                return false
            }
        }
    }
    true
}

fn selectors(value: json::Value, name: string, context: string) -> Result[
    Vec[PackageSelector],
    string,
] {
    let values = json::field(value, name).and_then(json::as_array).ok_or(
        context + ": " + name + " must be an array",
    )?;
    if values.is_empty() {
        return Err(context + ": " + name + " must not be empty")
    }
    let result: Vec[PackageSelector] = Vec::new();
    for item in values {
        let context = context + "." + name;
        object_fields(item, Vec::from_array(["package", "subpackages"]), context)?;
        let package_name = required_string(item, "package", context)?;
        if !valid_package(package_name) {
            return Err(context + ": package must be a canonical package name: " + package_name)
        }
        let subpackages = match json::field(item, "subpackages") {
            Some(value) => json::as_bool(value).ok_or(context + ": subpackages must be a boolean")?,
            None => false,
        };
        result.push(PackageSelector { package_name, subpackages });
    }
    Ok(result)
}

pub fn parse_rules(source: string) -> Result[Vec[Rule], string] {
    let value = json::parse(source)?;
    object_fields(value, Vec::from_array(["schema_version", "rules"]), "architecture rules")?;
    if json::field(value, "schema_version").and_then(json::as_int) != Option::Some(1) {
        return Err("unsupported architecture rules schema_version; expected 1")
    }
    let entries = json::field(value, "rules").and_then(json::as_array).ok_or(
        "architecture rules: rules must be an array",
    )?;
    let result: Vec[Rule] = Vec::new();
    let names: Vec[string] = Vec::new();
    for entry in entries {
        object_fields(
            entry,
            Vec::from_array(["name", "from", "forbid", "scope"]),
            "architecture rule",
        )?;
        let name = required_string(entry, "name", "architecture rule")?;
        if names.contains(name) {
            return Err("duplicate architecture rule " + name)
        }
        names.push(name);
        let scope = match json::field(entry, "scope") {
            Some(value) => json::as_string(value).ok_or("rule " + name + ": scope must be a string")?,
            None => "production",
        };
        if scope != "production" && scope != "tests" && scope != "all" {
            return Err("rule " + name + ": scope must be production, tests, or all")
        }
        result.push(
            Rule {
                name,
                from: selectors(entry, "from", name)?,
                forbid: selectors(entry, "forbid", name)?,
                scope,
            },
        );
    }
    Ok(result)
}
