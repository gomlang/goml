package architecture;

pub struct PackageSelector {
    pub package_name: string,
    pub subpackages: bool,
}

pub struct Rule {
    pub name: string,
    pub from: Vec[PackageSelector],
    pub forbid: Vec[PackageSelector],
    pub scope: string,
}

pub struct Edge {
    pub from: string,
    pub to: string,
    pub source: string,
    pub line: isize,
    pub column: isize,
    pub category: string,
    pub reexport: bool,
}

pub struct Violation {
    pub rule: string,
    pub edge: Edge,
}
