package architecture;

use module::metadata;
use module::project;
use std::env;
use std::fs;
use std::io;
use std::path;

pub fn check_project(rules_path: Option[string], compiler: Option[string]) -> Result[isize, string] {
    let current = env::current_dir_structured().map_err(|error| error.to_string())?;
    let root = project::find_module_root(current).map_err(|error| error.to_string())?;
    let filename = rules_path.unwrap_or(path::join(root, "goml.architecture.json"));
    let source = fs::read_file_structured(filename).map_err(
        |error| "failed to read architecture rules " + filename + ": " + error.to_string(),
    )?;
    let rules = parse_rules(source).map_err(|error| filename + ": " + error)?;
    let graph = metadata::query(root, compiler, "graph")?;
    let violations = check_metadata(rules, graph)?;
    for violation in violations {
        io::eprintln(render_violation(violation));
    }
    if violations.is_empty() {
        io::println("Architecture rules passed.");
        Ok(0)
    } else {
        Ok(1)
    }
}
