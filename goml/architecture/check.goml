package architecture;

use std::cmp;
use std::collections;
use std::text;

impl PackageSelector {
    pub fn matches(self: PackageSelector, package_name: string) -> bool {
        self.package_name == package_name
            || (self.subpackages && package_name.starts_with(self.package_name + "::"))
    }
}

fn selected(selectors: Vec[PackageSelector], package_name: string) -> bool {
    for selector in selectors {
        if selector.matches(package_name) {
            return true
        }
    }
    false
}

fn selected_category(scope: string, category: string) -> bool {
    scope == "all" || (scope == "production" && category == "production")
        || (scope == "tests" && (category == "internal_test" || category == "external_test"))
}

fn violation_key(value: Violation) -> string {
    value.rule + "\n" + value.edge.from + "\n" + value.edge.to + "\n" + value.edge.source + "\n"
        + value.edge.line.to_string()
        + "\n"
        + value.edge.column.to_string()
        + "\n"
        + value.edge.category
        + "\n"
        + value.edge.reexport.to_string()
}

pub fn check_edges(rules: Vec[Rule], edges: Vec[Edge], complete: bool, diagnostics: Vec[string]) -> Result[
    Vec[Violation],
    string,
] {
    if !complete || !diagnostics.is_empty() {
        let details = if diagnostics.is_empty() {
            ""
        } else {
            "\n" + text::join(diagnostics, "\n")
        };
        return Err("architecture check is unknown: package graph is incomplete" + details)
    }
    let result: Vec[Violation] = Vec::new();
    for edge in edges {
        if edge.category != "production" && edge.category != "internal_test"
            && edge.category != "external_test"
            && edge.category != "example" {
            return Err("architecture check is unknown: unsupported edge category " + edge.category)
        }
        for rule in rules {
            if selected_category(rule.scope, edge.category) && selected(rule.from, edge.from)
                && selected(rule.forbid, edge.to) {
                result.push(Violation { rule: rule.name, edge });
            }
        }
    }
    collections::sort_by_ordering(
        result,
        |left: Violation, right: Violation| cmp::compare(violation_key(left), violation_key(right)),
    );
    Ok(result)
}

pub fn render_violation(value: Violation) -> string {
    let edge = value.edge;
    let kind = if edge.reexport {
        "reexport"
    } else {
        "import"
    };
    "architecture rule " + value.rule + " violated: " + edge.from + " -> " + edge.to + "\n"
        + edge.source
        + ":"
        + edge.line.to_string()
        + ":"
        + edge.column.to_string()
        + ": "
        + edge.category
        + " "
        + kind
}
