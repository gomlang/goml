package architecture;

use std::json;

fn graph_string(value: json::Value, name: string) -> Result[string, string] {
    json::field(value, name).and_then(json::as_string).ok_or(
        "architecture check is unknown: metadata field " + name + " must be a string",
    )
}

fn graph_position(value: json::Value, name: string) -> Result[isize, string] {
    let position = json::field(value, name).and_then(json::as_int).ok_or(
        "architecture check is unknown: metadata field " + name + " must be an integer",
    )?;
    if position < 1 {
        return Err("architecture check is unknown: metadata field " + name + " must be positive")
    }
    Ok(position)
}

pub fn check_metadata(rules: Vec[Rule], graph: json::Value) -> Result[Vec[Violation], string] {
    if json::field(graph, "schema_version").and_then(json::as_int) != Option::Some(1) {
        return Err("architecture check is unknown: unsupported metadata schema_version")
    }
    let complete = json::field(graph, "complete").and_then(json::as_bool).ok_or(
        "architecture check is unknown: metadata is missing completeness information",
    )?;
    let diagnostics: Vec[string] = Vec::new();
    let entries = json::field(graph, "diagnostics").and_then(json::as_array).ok_or(
        "architecture check is unknown: metadata is missing diagnostics",
    )?;
    for entry in entries {
        diagnostics.push(graph_string(entry, "message")?);
    }
    if !complete || !diagnostics.is_empty() {
        return check_edges(rules, Vec::new(), complete, diagnostics)
    }
    let entries = json::field(graph, "edges").and_then(json::as_array).ok_or(
        "architecture check is unknown: metadata is missing edges",
    )?;
    let edges: Vec[Edge] = Vec::new();
    for entry in entries {
        edges.push(
            Edge {
                from: graph_string(entry, "from")?,
                to: graph_string(entry, "to")?,
                source: graph_string(entry, "source")?,
                line: graph_position(entry, "line")?,
                column: graph_position(entry, "column")?,
                category: graph_string(entry, "kind")?,
                reexport: json::field(entry, "reexport").and_then(json::as_bool).ok_or(
                    "architecture check is unknown: metadata edge is missing reexport information",
                )?,
            },
        );
    }
    check_edges(rules, edges, complete, diagnostics)
}
