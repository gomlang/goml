package architecture;

use std::json;
use std::testing;

fn rule(scope: string) -> Rule {
    Rule {
        name: "no-app",
        from: Vec::from_array([PackageSelector { package_name: "demo::device", subpackages: true }]),
        forbid: Vec::from_array([PackageSelector { package_name: "demo::web", subpackages: true }]),
        scope,
    }
}

fn edge(category: string, reexport: bool) -> Edge {
    Edge {
        from: "demo::device::flash",
        to: "demo::web::render",
        source: "device/flash/main.goml",
        line: 8,
        column: 1,
        category,
        reexport,
    }
}

#[test]
fn architecture_selectors_distinguish_exact_packages_and_subtrees() -> () {
    let exact = PackageSelector { package_name: "demo::web", subpackages: false };
    let tree = PackageSelector { subpackages: true, ..exact };
    testing::assert(exact.matches("demo::web"));
    testing::assert(!exact.matches("demo::web::render"));
    testing::assert(tree.matches("demo::web::render"));
    testing::assert(!tree.matches("demo::website"));
}

#[test]
fn architecture_checks_reexports_and_reports_rule_and_import_location() -> () {
    let violations = testing::expect_ok(
        check_edges(
            Vec::from_array([rule("production")]),
            Vec::from_array([edge("production", true)]),
            true,
            Vec::new(),
        ),
        "check complete graph",
    );
    testing::assert_eq(violations.len(), 1);
    let message = render_violation(violations[0]);
    testing::assert(message.contains("no-app"));
    testing::assert(message.contains("demo::device::flash -> demo::web::render"));
    testing::assert(message.contains("device/flash/main.goml:8:1"));
    testing::assert(message.contains("reexport"));
}

#[test]
fn architecture_scopes_keep_production_tests_and_examples_explicit() -> () {
    let edges = Vec::from_array(
        [
            edge("production", false),
            edge("internal_test", false),
            edge("external_test", false),
            edge("example", false),
        ],
    );
    let production = testing::expect_ok(
        check_edges(Vec::from_array([rule("production")]), edges, true, Vec::new()),
        "production",
    );
    let tests = testing::expect_ok(
        check_edges(Vec::from_array([rule("tests")]), edges, true, Vec::new()),
        "tests",
    );
    let all = testing::expect_ok(
        check_edges(Vec::from_array([rule("all")]), edges, true, Vec::new()),
        "all",
    );
    testing::assert_eq(production.len(), 1);
    testing::assert_eq(tests.len(), 2);
    testing::assert_eq(all.len(), 4);
}

#[test]
fn architecture_never_accepts_incomplete_or_unknown_graphs() -> () {
    let error = testing::expect_err(
        check_edges(Vec::new(), Vec::new(), false, Vec::from_array(["missing demo::dependency"])),
        "incomplete graph",
    );
    testing::assert(error.contains("unknown"));
    testing::assert(error.contains("missing demo::dependency"));
    testing::assert(
        check_edges(Vec::new(), Vec::from_array([edge("future", false)]), true, Vec::new()).is_err(),
    );
    testing::assert(check_metadata(Vec::new(), json::Value::Null).is_err());
    let graph = testing::expect_ok(
        json::parse(
            "{\"schema_version\":1,\"complete\":true,\"diagnostics\":[],\"edges\":[{\"from\":\"demo::device\",\"to\":null}]}",
        ),
        "metadata",
    );
    testing::assert(check_metadata(Vec::new(), graph).is_err());
}

#[test]
fn architecture_results_do_not_depend_on_edge_or_rule_order() -> () {
    let first = edge("production", false);
    let second = Edge { source: "other.goml", ..first };
    let a = rule("all");
    let b = Rule { name: "other-rule", ..a };
    let left = testing::expect_ok(
        check_edges(Vec::from_array([a, b]), Vec::from_array([first, second]), true, Vec::new()),
        "forward",
    );
    let right = testing::expect_ok(
        check_edges(Vec::from_array([b, a]), Vec::from_array([second, first]), true, Vec::new()),
        "reverse",
    );
    testing::assert_eq(left.len(), 4);
    for index in 0..left.len() {
        testing::assert_eq(render_violation(left[index]), render_violation(right[index]));
    }
}

#[test]
fn architecture_config_rejects_typos_duplicates_and_implicit_patterns() -> () {
    let valid = "{\"schema_version\":1,\"rules\":[{\"name\":\"no-app\",\"from\":[{\"package\":\"demo::device\",\"subpackages\":true}],\"forbid\":[{\"package\":\"demo::web\"}]}]}";
    let rules = testing::expect_ok(parse_rules(valid), "rules");
    testing::assert_eq(rules[0].scope, "production");
    testing::assert(rules[0].from[0].subpackages);
    testing::assert(!rules[0].forbid[0].subpackages);
    for source in[
        "{\"schema_version\":2,\"rules\":[]}",
        "{\"schema_version\":1,\"rules\":[],\"typo\":true}",
        "{\"schema_version\":1,\"schema_version\":1,\"rules\":[]}",
        "{\"schema_version\":1,\"rules\":[{\"name\":\"bad\",\"from\":[{\"package\":\"demo::*\"}],\"forbid\":[{\"package\":\"demo::web\"}]}]}",
    ] {
        testing::assert(parse_rules(source).is_err());
    }
}
