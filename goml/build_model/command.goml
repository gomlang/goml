package build_model;

use module::failure;
use failure::DriverResult;
use module::util;
use std::collections;
use std::fs;
use std::io;
use std::path;
use std::process;
use std::task;
use std::text;
use std::time;

impl Command {
    pub fn args(self) -> (string, Vec[string]) {
        match self {
            Compile {
                subcommand,
                package_name,
                module_name,
                input_files,
                interface_files,
                output,
                world,
            } => {
                let args: Vec[string] = Vec::new();
                args.push(subcommand);
                args.push("--package");
                args.push(package_name);
                args.push("--module");
                args.push(module_name);
                for input in input_files {
                    args.push("--input");
                    args.push(input)
                }
                for interface in interface_files {
                    args.push("--interface-path");
                    args.push(interface)
                }
                args.push("--output");
                args.push(output);
                if let Some(value) = world {
                    args.push("--world");
                    args.push(value)
                };
                (GOMLC_PROGRAM, args)
            },
            ToolchainCompile {
                package_name,
                module_name,
                input_files,
                interface_files,
                output,
                builtin_contract,
                without_roots,
                counter_output,
            } => {
                let args = Vec::from_array(["__toolchain-build"]);
                if builtin_contract {
                    args.push("--builtin-contract")
                }
                if without_roots {
                    args.push("--without-roots")
                }
                if let Some(value) = counter_output {
                    args.push("--counter-output");
                    args.push(value)
                }
                args.push("--package");
                args.push(package_name);
                args.push("--module");
                args.push(module_name);
                args.push("--input");
                for value in input_files {
                    args.push(value)
                }
                for value in interface_files {
                    args.push("--interface-path");
                    args.push(value)
                }
                args.push("--output");
                args.push(output);
                (GOMLC_PROGRAM, args)
            },
            PackToolchainWorld { input_packages, source_files, counter_file, output } => {
                let args = Vec::from_array(["__toolchain-pack"]);
                for value in input_packages {
                    args.push("--input");
                    args.push(value)
                }
                for value in source_files {
                    args.push("--source");
                    args.push(value)
                }
                args.push("--counter-file");
                args.push(counter_file);
                args.push("--output");
                args.push(output);
                (GOMLC_PROGRAM, args)
            },
            Link { input_cores, entry_package, output, world } => {
                let args: Vec[string] = Vec::new();
                args.push("link");
                args.push("--input");
                for input in input_cores {
                    args.push(input)
                }
                args.push("--output");
                args.push(output);
                args.push("--entry");
                args.push(entry_package);
                if let Some(value) = world {
                    args.push("--world");
                    args.push(value)
                };
                (GOMLC_PROGRAM, args)
            },
            TestLink { input_cores, packages, output, manifest, world } => {
                let args: Vec[string] = Vec::new();
                args.push("test-link");
                args.push("--input");
                for input in input_cores {
                    args.push(input)
                }
                args.push("--output");
                args.push(output);
                args.push("--manifest");
                args.push(manifest);
                for package_name in packages {
                    args.push("--package");
                    args.push(package_name)
                }
                if let Some(value) = world {
                    args.push("--world");
                    args.push(value)
                };
                (GOMLC_PROGRAM, args)
            },
            GoBuild { input, output } => (
                GO_PROGRAM,
                Vec::from_array([BUILD_SUBCOMMAND, "-o", output, input]),
            ),
        }
    }
}

impl Command {
    pub fn progress_label(self) -> string {
        match self {
            Compile { subcommand, package_name, .. } => match subcommand {
                CHECK_SUBCOMMAND => f"checking {package_name}",
                BUILD_SUBCOMMAND => f"compiling {package_name}",
                TEST_CHECK_SUBCOMMAND => f"checking tests for {package_name}",
                TEST_BUILD_SUBCOMMAND => f"compiling tests for {package_name}",
                _ => f"{subcommand} {package_name}",
            },
            ToolchainCompile { package_name, .. } => f"compiling toolchain package {package_name}",
            PackToolchainWorld { .. } => "packing compiler world",
            Link { entry_package, .. } => f"linking {entry_package}",
            TestLink { .. } => "linking test runner",
            GoBuild { .. } => "building executable",
        }
    }
}
