package build_model;

pub enum Command {
    Compile {
        subcommand: string,
        package_name: string,
        module_name: string,
        input_files: Vec[string],
        interface_files: Vec[string],
        output: string,
        world: Option[string],
    },
    ToolchainCompile {
        package_name: string,
        module_name: string,
        input_files: Vec[string],
        interface_files: Vec[string],
        output: string,
        builtin_contract: bool,
        without_roots: bool,
        counter_output: Option[string],
    },
    PackToolchainWorld {
        input_packages: Vec[string],
        source_files: Vec[string],
        counter_file: string,
        output: string,
    },
    Link {
        input_cores: Vec[string],
        entry_package: string,
        output: string,
        world: Option[string],
    },
    TestLink {
        input_cores: Vec[string],
        packages: Vec[string],
        output: string,
        manifest: string,
        world: Option[string],
    },
    GoBuild {
        input: string,
        output: string,
    },
}

pub struct TestGroup {
    pub kind: string,
    pub manifest: string,
    pub runner: string,
}

pub struct Plan {
    pub commands: Vec[Command],
    pub executable: Option[string],
    pub test_groups: Vec[TestGroup],
}
