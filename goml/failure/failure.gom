package failure;

use std::error;
use std::fs;
use std::io;
use std::path;
use std::env;
use std::process;
use std::utf8;

pub enum DriverError {
    Fs(fs::Error),
    Io(io::Error),
    Path(path::Error),
    Environment(env::VarError),
    Process(process::Error),
    Utf8(utf8::Utf8Error),
    Message(string),
}

impl ToString for DriverError {
    fn to_string(self: DriverError) -> string {
        match self {
            Fs(value) => value.to_string(),
            Io(value) => value.to_string(),
            Path(value) => value.to_string(),
            Environment(value) => value.to_string(),
            Process(value) => value.to_string(),
            Utf8(value) => value.to_string(),
            Message(value) => value.to_string(),
        }
    }
}

pub type Failure = error::Report[DriverError];

pub trait IntoFailure {
    fn into_failure(self: Self) -> Failure;
}

pub fn convert[E: IntoFailure](value: E) -> Failure {
    value.into_failure()
}

impl IntoFailure for Failure {
    fn into_failure(self: Failure) -> Failure {
        self
    }
}

impl IntoFailure for fs::Error {
    fn into_failure(self: fs::Error) -> Failure {
        error::Report::new(DriverError::Fs(self))
    }
}

impl IntoFailure for io::Error {
    fn into_failure(self: io::Error) -> Failure {
        error::Report::new(DriverError::Io(self))
    }
}

impl IntoFailure for path::Error {
    fn into_failure(self: path::Error) -> Failure {
        error::Report::new(DriverError::Path(self))
    }
}

impl IntoFailure for env::VarError {
    fn into_failure(self: env::VarError) -> Failure {
        error::Report::new(DriverError::Environment(self))
    }
}

impl IntoFailure for process::Error {
    fn into_failure(self: process::Error) -> Failure {
        error::Report::new(DriverError::Process(self))
    }
}

impl IntoFailure for utf8::Utf8Error {
    fn into_failure(self: utf8::Utf8Error) -> Failure {
        error::Report::new(DriverError::Utf8(self))
    }
}

impl IntoFailure for string {
    fn into_failure(self: string) -> Failure {
        error::Report::new(DriverError::Message(self))
    }
}

pub trait DriverResult[T] {
    fn driver_result(self: Self) -> Result[T, Failure];
}

impl[T, E: IntoFailure] DriverResult[T]for Result[T, E] {
    fn driver_result(self: Result[T, E]) -> Result[T, Failure] {
        self.map_err(convert)
    }
}

pub fn combine(primary: Failure, secondary: Failure) -> Failure {
    error::Report::join(Vec::from_array([primary, secondary]).as_slice()).unwrap_or(primary)
}
