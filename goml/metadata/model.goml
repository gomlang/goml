package metadata;

use module::manifest;
use module::util;
use std::json;

struct Module {
    name: string,
    root: string,
    origin: string,
    manifest: manifest::Manifest,
}

struct SourceFile {
    path: string,
    kind: string,
}

struct Package {
    id: string,
    module_name: string,
    directory: string,
    files: Vec[SourceFile],
}

fn strings(values: Vec[string]) -> json::Value {
    let result = Vec::new();
    for value in values {
        result.push(json::Value::String(value));
    }
    Array(result)
}

fn dependencies(values: Vec[manifest::Dependency]) -> json::Value {
    let result = Vec::new();
    for value in values {
        result.push(value.name);
    }
    strings(util::sorted_unique(result))
}

fn diagnostic(diagnostics: Vec[json::Value], message: string) -> () {
    diagnostics.push(Object(Vec::from_array([("message", json::Value::String(message))])));
}
