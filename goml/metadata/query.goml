package metadata;

use module::project;
use module::registry;
use module::util;
use module::version;
use std::fs;
use std::json;
use std::path;

fn module_json(value: Module, root: string, diagnostics: Vec[json::Value]) -> json::Value {
    let locked = match registry::locked_provenance(root, value.name) {
        Ok(Some(entry)) => json::Value::Object(
            Vec::from_array(
                [
                    ("source_kind", json::Value::String(entry.source_kind)),
                    ("source", json::Value::String(entry.source)),
                    ("revision", json::Value::String(entry.revision)),
                    ("checksum", json::Value::String(entry.checksum)),
                    ("dependencies", strings(entry.dependencies)),
                ],
            ),
        ),
        Ok(None) => json::Value::Null,
        Err(error) => {
            diagnostic(diagnostics, error.to_string());
            json::Value::Null
        },
    };
    Object(
        Vec::from_array(
            [
                ("id", json::Value::String(value.name)),
                ("root", json::Value::String(value.root)),
                ("source_kind", json::Value::String(value.origin)),
                ("locked", locked),
                ("dependencies", dependencies(value.manifest.dependencies)),
                ("dev_dependencies", dependencies(value.manifest.dev_dependencies)),
            ],
        ),
    )
}

fn package_json(value: Package, modules: Vec[Module]) -> json::Value {
    let mut root = value.directory;
    for module in modules {
        if module.name == value.module_name {
            root = module.root;
        }
    }
    let files = Vec::new();
    for file in value.files {
        files.push(
            json::Value::Object(
                Vec::from_array(
                    [
                        ("path", json::Value::String(project::relative_path(root, file.path))),
                        ("kind", json::Value::String(file.kind)),
                    ],
                ),
            ),
        );
    }
    Object(
        Vec::from_array(
            [
                ("id", json::Value::String(value.id)),
                ("module", json::Value::String(value.module_name)),
                ("directory", json::Value::String(project::relative_path(root, value.directory))),
                ("files", json::Value::Array(files)),
            ],
        ),
    )
}

pub fn query(source: string, compiler: Option[string], mode: string) -> Result[json::Value, string] {
    if mode != "files" && mode != "graph" {
        return Err("metadata mode must be files or graph")
    }
    let source = path::absolute_structured(source).map_err(|error| error.to_string())?;
    let directory = if fs::is_dir(source) {
        source
    } else {
        path::parent(source).unwrap_or(".")
    };
    let root = project::find_module_root(directory).map_err(|error| error.to_string())?;
    let root = fs::canonicalize(root).map_err(|error| error.to_string())?;
    let diagnostics = Vec::new();
    let modules = load_modules(root, diagnostics)?;
    let module_names = Vec::new();
    let package_ids = Vec::new();
    let packages = Vec::new();
    for module in modules {
        module_names.push(module.name);
        match collect_packages(module) {
            Ok(values) => for value in values {
                package_ids.push(value.id);
                packages.push(value);
            },
            Err(error) => diagnostic(diagnostics, error),
        }
    }
    let sorted_packages = Vec::new();
    let package_values = Vec::new();
    for id in util::sorted_unique(package_ids) {
        for package_value in packages {
            if package_value.id == id {
                sorted_packages.push(package_value);
                package_values.push(package_json(package_value, modules));
            }
        }
    }
    let module_values = Vec::new();
    let sorted_modules = Vec::new();
    for name in util::sorted_unique(module_names) {
        for module in modules {
            if module.name == name {
                module_values.push(module_json(module, root, diagnostics));
                sorted_modules.push(module);
            }
        }
    }
    let edges = Vec::new();
    if mode == "graph" {
        match compiler {
            Some(value) => collect_edges(value, sorted_modules, sorted_packages, edges, diagnostics),
            None => match project::compiler_path(None) {
                Ok(value) => collect_edges(
                    value,
                    sorted_modules,
                    sorted_packages,
                    edges,
                    diagnostics,
                ),
                Err(error) => diagnostic(diagnostics, error.to_string()),
            },
        }
    }
    Ok(
        Object(
            Vec::from_array(
                [
                    ("schema_version", json::Value::Number("1")),
                    ("toolchain_version", json::Value::String(version::current())),
                    ("mode", json::Value::String(mode)),
                    ("root_module", json::Value::String(modules[0].name)),
                    ("complete", json::Value::Bool(diagnostics.is_empty())),
                    ("modules", json::Value::Array(module_values)),
                    ("packages", json::Value::Array(package_values)),
                    ("edges", json::Value::Array(edges)),
                    ("diagnostics", json::Value::Array(diagnostics)),
                ],
            ),
        ),
    )
}
