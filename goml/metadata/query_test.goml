package metadata;

use module::test_support;
use module::project;
use std::fs;
use std::json;
use std::path;
use std::testing;

fn array_field(value: json::Value, name: string) -> Vec[json::Value] {
    json::field(value, name).and_then(json::as_array).unwrap_or(Vec::new())
}

#[test]
fn metadata_files_share_discovery_and_exclude_all_build_outputs() -> () {
    let root = test_support::workspace("metadata_files");
    test_support::write_file(
        path::join(root, "goml.toml"),
        "[module]\npath = \"example\"\n[build]\ntarget-dir = \"output\"\n",
    );
    test_support::write_file(path::join(root, "main.goml"), "package main; fn main() -> () {}\n");
    test_support::write_file(
        path::join(root, "main_test.goml"),
        "package main; #[test] fn works() -> () {}\n",
    );
    test_support::write_file(
        path::join(root, "nested/deep/value.goml"),
        "package deep; pub fn value() -> isize { 1 }\n",
    );
    test_support::write_file(path::join(root, "nested/deep/tests/test.goml"), "package tests;\n");
    test_support::write_file(
        path::join(root, "examples/demo/main.goml"),
        "package main; fn main() -> () {}\n",
    );
    for directory in["_artifact", "_bootstrap", "output", "testdata", ".hidden"] {
        test_support::write_file(path::join(root, directory + "/bad.goml"), "invalid source");
    }
    test_support::write_file(
        path::join(root, "separate/goml.toml"),
        "[module]\npath = \"separate\"\n",
    );
    test_support::write_file(path::join(root, "separate/value.goml"), "package separate;\n");
    let directories = testing::expect_ok(
        project::package_directories(root, path::join(root, "override-target")),
        "discover with overridden target",
    );
    testing::assert_eq(directories.len(), 2);
    let value = testing::expect_ok(query(root, None, "files"), "discover metadata");
    testing::assert(json::field(value, "complete").and_then(json::as_bool).unwrap_or(false));
    let packages = array_field(value, "packages");
    testing::assert_eq(packages.len(), 4);
    testing::assert_eq(array_field(packages[0], "files").len(), 2);
    testing::assert_eq(array_field(value, "edges").len(), 0);
    testing::assert(!fs::exists(path::join(root, "goml.lock")));
    testing::assert_eq(
        json::encode(testing::expect_ok(query(root, None, "files"), "repeat metadata")),
        json::encode(value),
    );
}

#[test]
fn metadata_missing_dependencies_report_partial_results() -> () {
    let root = test_support::workspace("metadata_missing_dependency");
    test_support::write_file(
        path::join(root, "goml.toml"),
        "[module]\npath = \"example\"\n[dependencies]\n\"missing::library\" = { path = \"absent\" }\n",
    );
    test_support::write_file(path::join(root, "value.goml"), "package example;\n");
    let value = testing::expect_ok(query(root, None, "files"), "partial metadata");
    testing::assert(!json::field(value, "complete").and_then(json::as_bool).unwrap_or(true));
    testing::assert_eq(array_field(value, "packages").len(), 1);
    testing::assert(!array_field(value, "diagnostics").is_empty());
}

#[test]
fn metadata_import_resolution_does_not_hide_missing_nested_packages() -> () {
    let root = Package {
        id: "example",
        module_name: "example",
        directory: "root",
        files: Vec::new(),
    };
    let child = Package { id: "example::nested", ..root };
    let packages = Vec::from_array([root, child]);
    testing::assert(import_package("example", "module::missing", packages).is_none());
    testing::assert(import_package("example", "module::nested::missing", packages).is_none());
    testing::assert_eq(
        import_package("example", "module::nested::Value", packages).map(|value| value.id).unwrap_or(
            "",
        ),
        "example::nested",
    );
}

#[test]
fn metadata_graph_preserves_aliases_reexports_and_test_categories() -> () {
    let root = test_support::workspace("metadata_graph");
    test_support::write_file(path::join(root, "goml.toml"), "[module]\npath = \"example\"\n");
    test_support::write_file(
        path::join(root, "value.goml"),
        "package example;\npub use module::nested::{Value};\n",
    );
    test_support::write_file(
        path::join(root, "value_test.goml"),
        "package example;\nuse module::nested as alias;\nuse alias::Value;\n",
    );
    test_support::write_file(
        path::join(root, "nested/value.goml"),
        "package nested; pub struct Value {}\n",
    );
    let value = testing::expect_ok(
        query(root, Some(test_support::gomlc_binary()), "graph"),
        "graph metadata",
    );
    testing::assert(json::field(value, "complete").and_then(json::as_bool).unwrap_or(false));
    let edges = array_field(value, "edges");
    testing::assert_eq(edges.len(), 3);
    testing::assert(json::field(edges[0], "reexport").and_then(json::as_bool).unwrap_or(false));
    testing::assert_eq(
        json::encode(json::field(edges[0], "line").unwrap_or(json::Value::Null)),
        "2",
    );
    for edge in edges {
        testing::assert_eq(
            json::field(edge, "to").and_then(json::as_string).unwrap_or(""),
            "example::nested",
        );
    }
    testing::assert_eq(
        json::field(edges[1], "kind").and_then(json::as_string).unwrap_or(""),
        "internal_test",
    );
    testing::assert(!fs::exists(path::join(root, "_artifact")));
}
