package main;

use fixture::basic::math;
use std::testing;

#[test]
fn double_is_correct() -> () {
    testing::assert_eq(math::double(4), 8)
}

#[test]
fn channel_round_trip() -> () {
    let channel = Channel::new(1);
    channel.send("ok");
    channel.close();
    match channel.recv() {
        Option::Some(value) => testing::assert_eq(value, "ok"),
        Option::None => testing::fail("channel closed early"),
    }
    if let Option::Some(_) = channel.recv() {
        testing::fail("closed channel produced a value")
    }
}

#[test]
fn arithmetic_is_correct() -> () {
    testing::assert_eq(2 + 3, 5)
}

#[test_case("left", true)]
#[test_case("right", false)]
fn parameterized_case(value: string, expected: bool) -> () {
    testing::assert_eq(value == "left", expected)
}

#[test]
#[ignore("later")]
fn ignored_case() -> () {
    testing::fail("ignored test ran")
}
