package go_export;

use module::project::{Context, apply_native_environment, prepare_native_environment, prepare_native_execution};
use module::build_plan::{compile_commands, compiler_world_path, core_outputs, reachable_packages};
use module::build_model::{Plan};
use module::build::{display_args, execute_plan, with_build_lock};
use module::failure;
use failure::DriverResult;
use std::env;
use std::fs;
use std::io;
use std::json;
use std::path;
use std::process;
use module::build_model;

pub struct ExportOptions {
    pub source: Option[string],
    pub output: string,
    pub import_path: string,
    pub jobs: isize,
    pub dry_run: bool,
}

fn export_compiler(context: Context, args: Vec[string]) -> Result[(), failure::Failure] {
    let status = apply_native_environment(
        process::Command::new(context.compiler).args(args).current_dir(context.graph.module_dir),
        context,
    ).status_structured().driver_result()?;
    if status.success() {
        Ok(())
    } else {
        Err(failure::convert("export-go: compiler command failed"))
    }
}

fn export_build_context(context: Context, output: string) -> Vec[string] {
    Vec::from_array(
        [
            "__ffi-build-context",
            "--go",
            "go",
            "--module-directory",
            context.graph.module_dir,
            "--output",
            output,
        ],
    )
}

fn export_link_args(
    context: Context,
    destination: GoExportDestination,
    cores: Vec[string],
    staging: string,
) -> Vec[string] {
    let args = Vec::from_array(
        [
            "__link-go-library",
            "--package",
            destination.source_package,
            "--go-package",
            destination.go_package,
            "--output",
            path::join(staging, "candidate.go"),
            "--api-output",
            path::join(staging, "api.json"),
        ],
    );
    for core in cores {
        args.push("--input");
        args.push(core)
    }
    if let Some(world) = compiler_world_path(context) {
        args.push("--world");
        args.push(world)
    }
    args
}

fn export_check_args(destination: GoExportDestination, staging: string, context_path: string) -> Vec[
    string,
] {
    Vec::from_array(
        [
            "__check-go-library",
            "--context",
            context_path,
            "--input",
            path::join(staging, "candidate.go"),
            "--directory",
            destination.output_directory,
            "--import-path",
            destination.import_path,
            "--overlay",
            path::join(staging, "overlay.json"),
        ],
    )
}

fn export_product(destination: GoExportDestination, staging: string, context_path: string) -> Result[
    GoExportProduct,
    failure::Failure,
] {
    let source = fs::read_file_structured(path::join(staging, "candidate.go")).driver_result()?;
    let api = json::parse(
        fs::read_file_structured(path::join(staging, "api.json")).driver_result()?,
    ).driver_result()?;
    if json::as_int(export_json_field(api, "protocol")?) != Option::Some(1) {
        return Err(failure::convert("export-go: unsupported compiler API protocol"))
    }
    let entries = json::as_array(export_json_field(api, "exports")?).ok_or(
        failure::convert("export-go: invalid compiler API"),
    )?;
    if entries.is_empty() {
        return Err(failure::convert("export-go: compiler omitted exported API"))
    }
    let build = json::parse(fs::read_file_structured(context_path).driver_result()?).driver_result()?;
    let fields: Vec[(string, json::Value)] = Vec::new();
    for name in Vec::from_array(
        ["toolchain", "goos", "goarch", "cgo_enabled", "goflags", "build_tags"],
    ) {
        fields.push((name, export_json_field(build, name)?))
    }
    Ok(
        GoExportProduct {
            source,
            package_name: destination.go_package,
            import_path: destination.import_path,
            api: entries,
            prerequisites: json::object(fields),
        },
    )
}

fn export_selected(context: Context, destination: GoExportDestination, options: ExportOptions) -> Result[
    (),
    failure::Failure,
] {
    let output_root = path::join(context.artifact_root, "export-go");
    let packages = reachable_packages(context.graph, Vec::from_array([destination.source_package]))?;
    let commands = compile_commands(
        context,
        output_root,
        build_model::BUILD_SUBCOMMAND,
        build_model::BUILD_SUBCOMMAND,
        packages,
    )?;
    let plan = Plan { commands, executable: Option::None, test_groups: Vec::new() };
    let cores = core_outputs(context, output_root, packages);
    let staging = path::join(destination.output_directory, ".goml-export-lock");
    let context_path = path::join(staging, "context.json");
    if options.dry_run {
        let _ = prepare_native_environment(context, true)?;
        io::println(display_args(context.compiler, export_build_context(context, context_path)));
        execute_plan(context, plan, true, options.jobs)?;
        io::println(
            display_args(context.compiler, export_link_args(context, destination, cores, staging)),
        );
        io::println(
            display_args(context.compiler, export_check_args(destination, staging, context_path)),
        );
        return Ok(())
    }
    with_export_output(
        destination.output_directory,
        |staging| with_build_lock(
            context,
            || {
                let prepared = prepare_native_execution(context, false)?;
                export_compiler(prepared, export_build_context(prepared, context_path))?;
                execute_plan(prepared, plan, false, options.jobs)?;
                export_compiler(prepared, export_link_args(context, destination, cores, staging))?;
                export_compiler(prepared, export_check_args(destination, staging, context_path))?;
                export_product(destination, staging, context_path)
            },
        ),
    )
}

pub fn export_go(context: Context, options: ExportOptions) -> Result[(), failure::Failure] {
    if options.jobs < 1 {
        return Err(failure::convert("export-go: jobs must be greater than zero"))
    }
    let current = env::current_dir_structured().driver_result()?;
    let source = match options.source {
        Some(value) => export_input_path(current, value)?,
        None => context.graph.module_dir,
    };
    let output = export_input_path(current, options.output)?;
    let destination = resolve_export_destination(
        context.graph,
        source,
        output,
        options.import_path,
        "go",
    )?;
    export_selected(context, destination, options)
}
