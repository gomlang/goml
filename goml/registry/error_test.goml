package registry;

use module::failure;
use module::test_support;
use std::io;
use std::testing;

fn assert_missing_file(report: failure::Failure, path: string) -> () {
    let cause = testing::expect_some(
        report.find_map(
            |value| match value {
                Fs(cause) => Some(cause),
                _ => None,
            },
        ),
        "filesystem cause",
    );
    testing::assert(cause.kind() == io::ErrorKind::NotFound);
    testing::assert(cause.raw_os_code() == Option::Some(2));
    testing::assert(cause.path() == Option::Some(path));
}

#[test]
fn registry_index_errors_preserve_filesystem_details() -> () {
    let root = test_support::workspace("registry-typed-index-error");
    let report = testing::expect_err(select_version(root, "demo::leaf", "1.0.0"), "missing index");
    assert_missing_file(report, root + "/index.toml");
}

#[test]
fn dependency_manifest_errors_survive_shared_resolution() -> () {
    let root = test_support::workspace("registry-typed-manifest-error");
    local_module(
        root,
        "app",
        "demo::app",
        "[dependencies]\n\"demo::leaf\" = { path = \"../leaf\" }\n",
    );
    test_support::create_dir(root + "/leaf");
    let report = testing::expect_err(
        resolve_at(root + "/app", root + "/registry"),
        "missing dependency manifest",
    );
    assert_missing_file(report, root + "/leaf/goml.toml");
}
