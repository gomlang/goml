package resolver;

use module::manifest::config as config;
use std::path;
use std::testing;

#[derive(Debug, PartialEq)]
enum TestError {
    Missing(string),
    Message(string),
}

struct MemoryProvider {
    manifests: HashMap[string, Manifest],
}

impl Provider for MemoryProvider {
    type Error = TestError;

    fn load(self: MemoryProvider, filename: string) -> Result[Manifest, TestError] {
        self.manifests.get(filename).ok_or(TestError::Missing(filename))
    }

    fn canonicalize(self: MemoryProvider, directory: string) -> Result[string, TestError] {
        Ok(path::clean(directory))
    }

    fn select(self: MemoryProvider, root: string, dependency: config::Dependency) -> Result[
        string,
        TestError,
    ] {
        let directory = path::join(root, dependency.name.replace("::", "/"));
        if self.manifests.get(path::join(directory, config::FILENAME)).is_none() {
            return Err(TestError::Missing(dependency.name))
        }
        Ok(directory)
    }

    fn failure(self: MemoryProvider, message: string) -> TestError {
        TestError::Message(message)
    }
}

fn memory_provider() -> MemoryProvider {
    MemoryProvider { manifests: HashMap::new() }
}

fn requirement(name: string, local: Option[string]) -> config::Dependency {
    config::Dependency { name, path: local }
}

fn store_module(
    provider: MemoryProvider,
    root: string,
    name: string,
    dependencies: Vec[config::Dependency],
) -> () {
    provider.manifests.set(
        path::join(root, config::FILENAME),
        Manifest { module_path: name, dependencies },
    );
}

#[test]
fn development_back_edges_use_the_current_module_without_allowing_production_cycles() -> () {
    let provider = memory_provider();
    let metadata = Manifest { module_path: "demo::library", dependencies: Vec::new() };
    let helper = requirement("demo::helper", Option::Some("../helper"));
    store_module(provider, "/library", "demo::library", Vec::new());
    store_module(
        provider,
        "/helper",
        "demo::helper",
        Vec::from_array([requirement("demo::library", Option::None)]),
    );
    let modules = testing::expect_ok(
        resolve_development(
            provider,
            "/library",
            metadata,
            Vec::from_array([helper]),
            Vec::new(),
            "/registry",
        ),
        "development cycle",
    );
    testing::assert_eq(modules.len(), 1);
    testing::assert_eq(modules[0].name, "demo::helper");
    let production = Manifest { dependencies: Vec::from_array([helper]), ..metadata };
    testing::assert(
        resolve_development(provider, "/library", production, Vec::new(), Vec::new(), "/registry").is_err(),
    );
    store_module(
        provider,
        "/helper",
        "demo::helper",
        Vec::from_array([requirement("demo::library", Option::Some("../wrong"))]),
    );
    testing::assert(
        resolve_development(
            provider,
            "/library",
            metadata,
            Vec::from_array([helper]),
            Vec::new(),
            "/registry",
        ).is_err(),
    );
}

#[test]
fn shared_dependencies_are_selected_once_for_normal_and_development_graphs() -> () {
    let provider = memory_provider();
    store_module(provider, "/registry/demo/dep", "demo::dep", Vec::new());
    store_module(
        provider,
        "/registry/demo/consumer",
        "demo::consumer",
        Vec::from_array([requirement("demo::dep", None)]),
    );
    let root = Manifest {
        module_path: "demo::app",
        dependencies: Vec::from_array([requirement("demo::dep", None)]),
    };
    let modules = testing::expect_ok(
        resolve_development(
            provider,
            "/app",
            root,
            Vec::from_array([requirement("demo::consumer", None), requirement("demo::dep", None)]),
            Vec::new(),
            "/registry",
        ),
        "development graph",
    );
    testing::assert_eq(modules.len(), 2);
    testing::assert_eq(modules[0].name, "demo::dep");
    testing::assert_eq(modules[1].name, "demo::consumer");
    testing::assert(!modules[0].local);
    let normal = testing::expect_ok(
        resolve(provider, "/app", root, Vec::new(), "/registry"),
        "normal graph",
    );
    testing::assert_eq(normal.len(), 1);
    testing::assert_eq(normal[0].root, modules[0].root);
}

#[test]
fn finds_transitive_local_sources_before_selecting_registry_sources() -> () {
    let provider = memory_provider();
    store_module(
        provider,
        "/middle",
        "demo::middle",
        Vec::from_array([requirement("demo::leaf", Some("../leaf"))]),
    );
    store_module(provider, "/leaf", "demo::leaf", Vec::new());
    let root = Manifest {
        module_path: "demo::app",
        dependencies: Vec::from_array(
            [requirement("demo::leaf", None), requirement("demo::middle", Some("../middle"))],
        ),
    };
    let modules = testing::expect_ok(
        resolve(provider, "/app", root, Vec::new(), "/registry"),
        "resolve local graph",
    );
    testing::assert_eq(modules.len(), 2);
    testing::assert_eq(modules[0].root, "/leaf");
    testing::assert(modules[0].local);
}

#[test]
fn retains_provider_errors_and_detects_nonroot_cycles() -> () {
    let provider = memory_provider();
    let root = Manifest {
        module_path: "demo::app",
        dependencies: Vec::from_array([requirement("demo::one", Some("../one"))]),
    };
    testing::assert_eq(
        testing::expect_err(
            resolve(provider, "/app", root, Vec::new(), "/registry"),
            "missing manifest",
        ),
        TestError::Missing("/one/goml.toml"),
    );
    store_module(
        provider,
        "/one",
        "demo::one",
        Vec::from_array([requirement("demo::two", Some("../two"))]),
    );
    store_module(
        provider,
        "/two",
        "demo::two",
        Vec::from_array([requirement("demo::one", Some("../one"))]),
    );
    testing::assert_eq(
        testing::expect_err(resolve(provider, "/app", root, Vec::new(), "/registry"), "cycle"),
        TestError::Message("dependency cycle involving demo::one"),
    );
}
