package registry;

use module::test_support;
use std::testing;

fn local_module(root: string, directory: string, name: string, dependencies: string) -> () {
    test_support::write_file(
        root + "/" + directory + "/goml.toml",
        "[module]\npath = \"" + name + "\"\n" + dependencies,
    );
}

fn resolved_local(root: string) -> Vec[ResolvedModule] {
    match resolve_at(root + "/app", root + "/missing-registry") {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            Vec::new()
        },
    }
}

#[test]
fn local_paths_resolve_transitively_without_registry_and_preserve_identity() -> () {
    let root = test_support::workspace("local_paths_transitive");
    local_module(
        root,
        "app",
        "demo::app",
        "[dependencies]\n\"demo::middle\" = { path = \"../middle\" }\n",
    );
    local_module(
        root,
        "middle",
        "demo::middle",
        "[dependencies]\n\"demo::leaf\" = { path = \"../leaf\", version = \"0.1.0\" }\n",
    );
    local_module(root, "leaf", "demo::leaf", "");
    let values = resolved_local(root);
    testing::assert_eq(values.len(), 2);
    testing::assert_eq(values[0].name, "demo::middle");
    testing::assert_eq(values[1].name, "demo::leaf");
    testing::assert_eq(values[1].version, "local");
    testing::assert_eq(values[1].root, root + "/leaf");
}

#[test]
fn local_source_selection_is_independent_of_requirement_order() -> () {
    let root = test_support::workspace("local_paths_order");
    local_module(
        root,
        "app",
        "demo::app",
        "[dependencies]\n\"demo::leaf\" = \"9.0.0\"\n\"demo::middle\" = { path = \"../middle\" }\n",
    );
    local_module(
        root,
        "middle",
        "demo::middle",
        "[dependencies]\n\"demo::leaf\" = { path = \"../leaf\" }\n",
    );
    local_module(root, "leaf", "demo::leaf", "");
    let values = resolved_local(root);
    testing::assert_eq(values.len(), 2);
    testing::assert_eq(values[0].root, root + "/leaf");
}

#[test]
fn workspace_members_and_replacements_override_registry_requirements() -> () {
    let root = test_support::workspace("workspace_replacements");
    local_module(
        root,
        "app",
        "demo::app",
        "[dependencies]\n\"demo::leaf\" = \"9.0.0\"\n[replace]\n\"demo::leaf\" = \"../alternative\"\n",
    );
    local_module(root, "leaf", "demo::leaf", "");
    local_module(root, "alternative", "demo::leaf", "");
    local_module(root, "override", "demo::leaf", "");
    test_support::write_file(
        root + "/goml.work",
        "[workspace]\nmembers = [\n \"app\", # application\n \"leaf\",\n]\n[replace]\n\"demo::leaf\" = { path = \"override\" }\n",
    );
    testing::assert_eq(resolved_local(root)[0].root, root + "/override");
    test_support::write_file(root + "/goml.work", "[workspace]\nmembers = [\"app\", \"leaf\"]\n");
    testing::assert_eq(resolved_local(root)[0].root, root + "/alternative");
    local_module(root, "app", "demo::app", "[dependencies]\n\"demo::leaf\" = \"9.0.0\"\n");
    testing::assert_eq(resolved_local(root)[0].root, root + "/leaf");
}

#[test]
fn local_dependencies_reject_identity_conflicts_and_cycles() -> () {
    let root = test_support::workspace("local_dependency_errors");
    local_module(
        root,
        "app",
        "demo::app",
        "[dependencies]\n\"demo::leaf\" = { path = \"../leaf\" }\n",
    );
    local_module(root, "leaf", "demo::wrong", "");
    testing::assert(resolve_at(root + "/app", "").is_err());
    local_module(
        root,
        "leaf",
        "demo::leaf",
        "[dependencies]\n\"demo::app\" = { path = \"../app\" }\n",
    );
    testing::assert(resolve_at(root + "/app", "").is_err());
    local_module(
        root,
        "leaf",
        "demo::leaf",
        "[dependencies]\n\"demo::leaf\" = { path = \"../other\" }\n",
    );
    local_module(root, "other", "demo::leaf", "");
    testing::assert(resolve_at(root + "/app", "").is_err());
}

#[test]
fn unrelated_workspace_does_not_override_a_nonmember() -> () {
    let root = test_support::workspace("workspace_nonmember");
    local_module(
        root,
        "app",
        "demo::app",
        "[dependencies]\n\"demo::leaf\" = { path = \"../leaf\" }\n",
    );
    local_module(root, "leaf", "demo::leaf", "");
    local_module(root, "other", "demo::other", "");
    test_support::write_file(
        root + "/goml.work",
        "[workspace]\nmembers = [\"other\"]\n[replace]\n\"demo::leaf\" = \"missing\"\n",
    );
    testing::assert_eq(resolved_local(root)[0].root, root + "/leaf");
}

#[test]
fn registry_edges_discover_transitive_replacement_paths_before_version_selection() -> () {
    let root = test_support::workspace("local_paths_registry_edges");
    local_module(
        root,
        "app",
        "demo::app",
        "[dependencies]\n\"demo::leaf\" = \"9.0.0\"\n\"demo::remote\" = \"0.1.0\"\n[replace]\n\"demo::middle\" = \"../middle\"\n",
    );
    local_module(root, "leaf", "demo::leaf", "");
    local_module(
        root,
        "middle",
        "demo::middle",
        "[dependencies]\n\"demo::leaf\" = { path = \"../leaf\" }\n",
    );
    local_module(
        root,
        "registry/demo/remote/0.1.0",
        "demo::remote",
        "[dependencies]\n\"demo::middle\" = \"0.1.0\"\n",
    );
    test_support::write_file(
        root + "/registry/index.toml",
        "[modules.\"demo::remote\"]\nlatest = \"0.1.0\"\nversions = [\"0.1.0\"]\n",
    );
    let values = testing::expect_ok(
        resolve_at(root + "/app", root + "/registry"),
        "resolve mixed graph",
    );
    testing::assert_eq(values.len(), 3);
    testing::assert_eq(values[0].root, root + "/leaf");
    testing::assert_eq(values[2].root, root + "/middle");
}

#[test]
fn local_source_prescan_discards_replaced_registry_branches_independently_of_order() -> () {
    let root = test_support::workspace("local_sources_discard_registry_branch");
    local_module(root, "base", "demo::base", "");
    local_module(
        root,
        "consumer",
        "demo::consumer",
        "[dependencies]\n\"demo::base\" = { path = \"../base\" }\n",
    );
    local_module(
        root,
        "registry/demo/base/1.0.0",
        "demo::base",
        "[dependencies]\n\"demo::discarded\" = \"1.0.0\"\n",
    );
    test_support::write_file(
        root + "/registry/index.toml",
        "[modules.\"demo::base\"]\nlatest = \"1.0.0\"\nversions = [\"1.0.0\"]\n",
    );
    for requirements in Vec::from_array(
        [
            "\"demo::base\" = \"1.0.0\"\n\"demo::consumer\" = { path = \"../consumer\" }\n",
            "\"demo::consumer\" = { path = \"../consumer\" }\n\"demo::base\" = \"1.0.0\"\n",
        ],
    ) {
        local_module(
            root,
            "app",
            "demo::app",
            "[dependencies]\n" + requirements + "[replace]\n\"demo::discarded\" = \"../missing\"\n",
        );
        let modules = testing::expect_ok(
            resolve_at(root + "/app", root + "/registry"),
            "resolve replaced registry branch",
        );
        testing::assert_eq(modules.len(), 2);
        for module in modules {
            testing::assert_eq(module.version, "local");
            if module.name == "demo::base" {
                testing::assert_eq(module.root, root + "/base");
            }
        }
    }
}
