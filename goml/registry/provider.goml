package registry;

use module::registry::resolver;
use module::manifest;
use module::failure;
use failure::DriverResult;
use std::fs;
use std::path;
use std::collections;
use module::registry::index as index;
use std::error;
use error::ReportContext;

struct RegistryProvider {
    watched: Vec[string],
    lock: Option[DependencyLock],
    lock_fetch: bool,
    lock_updates: bool,
    allow_unlocked_offline: bool,
    fetch: bool,
    refresh: bool,
    fetched: collections::HashSet[string],
    selected: HashMap[string, string],
}

fn cached_provider() -> RegistryProvider {
    RegistryProvider {
        watched: Vec::new(),
        lock: None,
        lock_fetch: false,
        lock_updates: false,
        allow_unlocked_offline: false,
        fetch: false,
        refresh: false,
        fetched: collections::HashSet::new(),
        selected: HashMap::new(),
    }
}

impl resolver::Provider for RegistryProvider {
    type Error = failure::Failure;

    fn load(self: RegistryProvider, filename: string) -> Result[
        resolver::Manifest,
        failure::Failure,
    ] {
        self.watched.push(filename);
        manifest::load_structured(filename).map(
            |value| resolver::Manifest {
                module_path: value.module_path,
                dependencies: value.dependencies,
            },
        ).with_context(|| "load dependency manifest " + filename)
    }

    fn canonicalize(self: RegistryProvider, directory: string) -> Result[string, failure::Failure] {
        self.watched.push(directory);
        fs::canonicalize(directory).driver_result().with_context(
            || "resolve dependency path " + directory,
        )
    }

    fn select(self: RegistryProvider, root: string, dependency: manifest::Dependency) -> Result[
        string,
        failure::Failure,
    ] {
        if let Some(directory) = self.selected.get(dependency.name) {
            return Ok(directory)
        }
        if let Some(lock) = self.lock {
            if let Ok(entry) = locked_module(lock, dependency.name) {
                if entry.source_kind == "git" {
                    let directory = ensure_locked_checkout(root, entry, self.lock_fetch, None)?;
                    self.selected.set(dependency.name, directory);
                    return Ok(directory)
                }
                if path::is_absolute(entry.source) {
                    return fs::canonicalize(entry.source).driver_result()
                }
            } else if !self.lock_updates {
                return Err(
                    failure::convert(
                        "goml.lock is missing module " + dependency.name + "; run `goml lock`",
                    ),
                )
            }
        }
        if resolution_options().offline && !self.allow_unlocked_offline
            && index::find(load_index(root)?, dependency.name).driver_result()?.git.is_some() {
            return Err(
                failure::convert(
                    "offline registry resolution requires goml.lock for " + dependency.name,
                ),
            )
        }
        self.watched.push(path::join(root, "index.toml"));
        if self.fetch && !self.fetched.contains(dependency.name) {
            let entry = index::find(load_index(root)?, dependency.name).driver_result()?;
            if let Some(source) = entry.git {
                sync_repository(source, index::directory(root, entry), self.refresh)?;
            }
            let _ = self.fetched.insert(dependency.name);
        }
        module_directory(root, dependency.name)
    }

    fn failure(self: RegistryProvider, message: string) -> failure::Failure {
        failure::convert(message)
    }
}
