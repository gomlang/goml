package registry;

use module::failure;
use failure::DriverResult;
use module::manifest;
use gomlang::toolchain_manifest::resolver;
use std::collections;
use std::env;
use std::error;
use error::ReportContext;
use std::fs;
use std::path;
use std::text;

pub type SemVersion = resolver::SemVersion;

struct RegistryEntry {
    name: string,
    latest: string,
    versions: Vec[string],
}

pub type ResolvedModule = resolver::ResolvedModule;

pub fn parse_sem_version(value: string) -> Result[SemVersion, failure::Failure] {
    resolver::parse_sem_version(value).ok_or(failure::convert("invalid semver `" + value + "`"))
}

fn quoted_values(value: string) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    let mut start: Option[isize] = Option::None;
    for index in 0..value.byte_len() {
        if value.byte_get(index) == b'"' {
            match start {
                Some(offset) => {
                    result.push(value.byte_slice(offset, index));
                    start = Option::None;
                },
                None => {
                    start = Option::Some(index + 1);
                },
            }
        }
    }
    result
}

fn load_index(root: string) -> Result[
    collections::IndexMap[string, RegistryEntry],
    failure::Failure,
] {
    let source = fs::read_file_structured(path::join(root, "index.toml")).driver_result().with_context(
        || "read registry index " + root,
    )?;
    let entries: collections::IndexMap[string, RegistryEntry] = collections::IndexMap::new();
    let mut current: Option[string] = Option::None;
    for original in text::lines(source) {
        let line = text::trim(original);
        if line.starts_with("[modules.") {
            let values = quoted_values(line);
            if values.len() != 1 {
                return Result::Err(failure::convert("invalid registry module table " + line))
            } else {
                let name = values[0];
                if entries.contains(name) {
                    return Result::Err(failure::convert("duplicate registry module table " + name))
                }
                current = Option::Some(name);
                let _ = entries.insert(
                    name,
                    RegistryEntry { name, latest: "", versions: Vec::new() },
                );
            }
        } else {
            if let Some(name) = current {
                if line.starts_with("latest") {
                    let values = quoted_values(line);
                    if values.len() != 1 {
                        return Result::Err(failure::convert("invalid registry latest value"))
                    } else {
                        let Some(entry) = entries.get(name) else {
                            return Result::Err(
                                failure::convert("invalid registry module table " + name),
                            )
                        };
                        let _ = entries.insert(
                            name,
                            RegistryEntry {
                                name: entry.name,
                                latest: values[0],
                                versions: entry.versions,
                            },
                        );
                    }
                } else if line.starts_with("versions") {
                    let Some(entry) = entries.get(name) else {
                        return Result::Err(
                            failure::convert("invalid registry module table " + name),
                        )
                    };
                    let _ = entries.insert(
                        name,
                        RegistryEntry {
                            name: entry.name,
                            latest: entry.latest,
                            versions: quoted_values(line),
                        },
                    );
                }
            }
        }
    }
    Result::Ok(entries)
}

fn valid_identifier(value: string) -> bool {
    if value.byte_len() == 0 {
        return false
    }
    let first = value.byte_get(0);
    if !((first >= b'A' && first <= b'Z') || (first >= b'a' && first <= b'z') || first == b'_') {
        return false
    }
    for index in 1..value.byte_len() {
        let byte = value.byte_get(index);
        if (byte >= b'0' && byte <= b'9') || (byte >= b'A' && byte <= b'Z')
            || (byte >= b'a' && byte <= b'z')
            || byte == b'_' {} else {
            return false
        }
    }
    true
}

pub fn validate_coordinate(value: string) -> Result[(), failure::Failure] {
    let parts = text::split(value, "::");
    if parts.len() != 2 || !valid_identifier(parts[0]) || !valid_identifier(parts[1]) {
        Result::Err(
            failure::convert("invalid module coordinate `" + value + "`: expected owner::module"),
        )
    } else if parts[0] == "std" {
        Result::Err(
            failure::convert("invalid module coordinate `" + value + "`: owner std is reserved"),
        )
    } else {
        Result::Ok(())
    }
}

fn module_directory_unchecked(root: string, name: string, version: string) -> string {
    let parts = text::split(name, "::");
    path::join(path::join(path::join(root, parts[0]), parts[1]), version)
}

pub fn module_directory(root: string, name: string, version: string) -> Result[
    string,
    failure::Failure,
] {
    match validate_coordinate(name) {
        Ok(()) => Result::Ok(module_directory_unchecked(root, name, version)),
        Err(message) => Result::Err(message),
    }
}

pub fn validate(root: string) -> Result[(), failure::Failure] {
    let entries = load_index(root)?;
    for (_, entry) in entries {
        validate_coordinate(entry.name)?;
        let latest = parse_sem_version(entry.latest)?;
        let mut latest_matches = false;
        for version in entry.versions {
            let parsed = parse_sem_version(version)?;
            if resolver::compare_versions(parsed, latest).is_eq() {
                latest_matches = true;
            }
            let directory = module_directory_unchecked(root, entry.name, version);
            if !fs::is_dir(directory) {
                return Result::Err(
                    failure::convert(
                        "registry index references missing module directory: " + entry.name + "@"
                            + version,
                    ),
                )
            }
        }
        if !latest_matches {
            return Result::Err(
                failure::convert(
                    "registry index latest version " + entry.latest + " for " + entry.name
                        + " is not listed in versions",
                ),
            )
        }
    }
    Result::Ok(())
}

pub fn latest_version(root: string, name: string) -> Result[string, failure::Failure] {
    validate_coordinate(name)?;
    let entries = load_index(root)?;
    match entries.get(name) {
        Some(entry) => parse_sem_version(entry.latest).map(|_| entry.latest),
        None => Result::Err(failure::convert("module " + name + " not found in registry index")),
    }
}

pub fn select_version(root: string, name: string, minimum: string) -> Result[
    string,
    failure::Failure,
] {
    validate_coordinate(name)?;
    let minimum_value = parse_sem_version(minimum)?;
    let entries = load_index(root)?;
    let Some(entry) = entries.get(name) else {
        return Result::Err(failure::convert("module " + name + " not found in registry index"))
    };
    resolver::minimum_version(
        entry.versions,
        minimum_value,
        |version| "invalid semver `" + version + "`",
    ).driver_result()?.ok_or(
        failure::convert("registry has no version for " + name + " satisfying >= " + minimum),
    )
}

pub fn cached_root() -> Result[string, failure::Failure] {
    let home = match env::var_structured("GOML_HOME") {
        Ok(value) => if value != "" {
            Option::Some(value)
        } else {
            Option::None
        },
        Err(_) => Option::None,
    };
    let home = match home {
        Some(value) => value,
        None => match env::var_structured("HOME") {
            Ok(value) => if value != "" {
                path::join(value, ".goml")
            } else {
                return Result::Err(failure::convert("failed to determine home directory"))
            },
            Err(_) => match env::var_structured("USERPROFILE") {
                Ok(value) => if value != "" {
                    path::join(value, ".goml")
                } else {
                    return Result::Err(failure::convert("failed to determine home directory"))
                },
                Err(_) => return Result::Err(failure::convert("failed to determine home directory")),
            },
        },
    };
    Result::Ok(path::join(path::join(home, "cache"), "registry"))
}

pub fn resolve_at(module_root: string, root: string) -> Result[
    Vec[ResolvedModule],
    failure::Failure,
] {
    let module_root = fs::canonicalize(module_root).driver_result()?;
    let root_manifest = manifest::load_structured(path::join(module_root, manifest::FILENAME))?;
    let overrides = manifest::local_overrides(module_root, root_manifest).driver_result()?;
    resolver::resolve(
        RegistryProvider {},
        module_root,
        resolver::Manifest {
            module_path: root_manifest.module_path,
            dependencies: root_manifest.dependencies,
        },
        overrides,
        root,
    )
}

pub fn resolve(module_root: string) -> Result[Vec[ResolvedModule], failure::Failure] {
    resolve_at(module_root, cached_root()?)
}

pub fn module_matches_package(module_name: string, package_name: string) -> bool {
    package_name == module_name || package_name.starts_with(module_name + "::")
}

pub fn package_directory(module: ResolvedModule, package_name: string) -> Option[string] {
    if package_name == module.name {
        Option::Some(module.root)
    } else if module_matches_package(module.name, package_name) {
        let mut result = module.root;
        let suffix = package_name.byte_slice(module.name.byte_len() + 2, package_name.byte_len());
        for segment in text::split(suffix, "::") {
            result = path::join(result, segment);
        }
        Option::Some(result)
    } else {
        Option::None
    }
}

pub fn artifact_prefix(module: ResolvedModule) -> string {
    let mut result = "deps";
    for part in text::split(module.name, "::") {
        result = path::join(result, part);
    }
    path::join(path::join(result, module.version), "pkg")
}
