package registry;

use module::manifest;
use std::cmp;
use std::collections;
use std::env;
use std::fs;
use std::path;
use std::text;

pub struct SemVersion {
    pub major: isize,
    pub minor: isize,
    pub patch: isize,
}

struct RegistryEntry {
    name: string,
    latest: string,
    versions: Vec[string],
}

pub struct ResolvedModule {
    pub name: string,
    pub version: string,
    pub root: string,
    pub dependencies: Vec[manifest::Dependency],
}

fn decimal_number(value: string) -> Option[isize] {
    let length = value.byte_len();
    if length == 0 {
        return Option::None
    }
    let mut result = 0;
    for index in 0..length {
        let byte = value.byte_get(index);
        if byte < b'0' || byte > b'9' {
            return Option::None
        } else {
            result = result * 10 + (byte - b'0').to_isize();
        }
    }
    Option::Some(result)
}

pub fn parse_sem_version(value: string) -> Result[SemVersion, string] {
    let parts = text::split(value, ".");
    if parts.len() != 3 {
        return Result::Err("invalid semver `" + value + "`")
    }
    let Some(major) = decimal_number(parts[0]) else {
        return Result::Err("invalid semver `" + value + "`")
    };
    let Some(minor) = decimal_number(parts[1]) else {
        return Result::Err("invalid semver `" + value + "`")
    };
    let Some(patch) = decimal_number(parts[2]) else {
        return Result::Err("invalid semver `" + value + "`")
    };
    Result::Ok(SemVersion { major, minor, patch })
}

fn version_compare(left: SemVersion, right: SemVersion) -> cmp::Ordering {
    cmp::compare(left.major, right.major).then(cmp::compare(left.minor, right.minor)).then(
        cmp::compare(left.patch, right.patch),
    )
}

fn version_less(left: SemVersion, right: SemVersion) -> bool {
    version_compare(left, right).is_lt()
}

fn version_equal(left: SemVersion, right: SemVersion) -> bool {
    version_compare(left, right).is_eq()
}

fn quoted_values(value: string) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    let mut start: Option[isize] = Option::None;
    for index in 0..value.byte_len() {
        if value.byte_get(index) == b'"' {
            match start {
                Some(offset) => {
                    result.push(value.byte_slice(offset, index));
                    start = Option::None;
                },
                None => {
                    start = Option::Some(index + 1);
                },
            }
        }
    }
    result
}

fn load_index(root: string) -> Result[collections::IndexMap[string, RegistryEntry], string] {
    let source = fs::read_file_structured(path::join(root, "index.toml")).map_err(
        |error| error.to_string(),
    )?;
    let entries: collections::IndexMap[string, RegistryEntry] = collections::IndexMap::new();
    let mut current: Option[string] = Option::None;
    for original in text::lines(source) {
        let line = text::trim(original);
        if line.starts_with("[modules.") {
            let values = quoted_values(line);
            if values.len() != 1 {
                return Result::Err("invalid registry module table " + line)
            } else {
                let name = values[0];
                if entries.contains(name) {
                    return Result::Err("duplicate registry module table " + name)
                }
                current = Option::Some(name);
                let _ = entries.insert(
                    name,
                    RegistryEntry { name, latest: "", versions: Vec::new() },
                );
            }
        } else {
            if let Some(name) = current {
                if line.starts_with("latest") {
                    let values = quoted_values(line);
                    if values.len() != 1 {
                        return Result::Err("invalid registry latest value")
                    } else {
                        let Some(entry) = entries.get(name) else {
                            return Result::Err("invalid registry module table " + name)
                        };
                        let _ = entries.insert(
                            name,
                            RegistryEntry {
                                name: entry.name,
                                latest: values[0],
                                versions: entry.versions,
                            },
                        );
                    }
                } else if line.starts_with("versions") {
                    let Some(entry) = entries.get(name) else {
                        return Result::Err("invalid registry module table " + name)
                    };
                    let _ = entries.insert(
                        name,
                        RegistryEntry {
                            name: entry.name,
                            latest: entry.latest,
                            versions: quoted_values(line),
                        },
                    );
                }
            }
        }
    }
    Result::Ok(entries)
}

fn valid_identifier(value: string) -> bool {
    if value.byte_len() == 0 {
        return false
    }
    let first = value.byte_get(0);
    if !((first >= b'A' && first <= b'Z') || (first >= b'a' && first <= b'z') || first == b'_') {
        return false
    }
    for index in 1..value.byte_len() {
        let byte = value.byte_get(index);
        if (byte >= b'0' && byte <= b'9') || (byte >= b'A' && byte <= b'Z')
            || (byte >= b'a' && byte <= b'z')
            || byte == b'_' {} else {
            return false
        }
    }
    true
}

pub fn validate_coordinate(value: string) -> Result[(), string] {
    let parts = text::split(value, "::");
    if parts.len() != 2 || !valid_identifier(parts[0]) || !valid_identifier(parts[1]) {
        Result::Err("invalid module coordinate `" + value + "`: expected owner::module")
    } else if parts[0] == "std" {
        Result::Err("invalid module coordinate `" + value + "`: owner std is reserved")
    } else {
        Result::Ok(())
    }
}

fn module_directory_unchecked(root: string, name: string, version: string) -> string {
    let parts = text::split(name, "::");
    path::join(path::join(path::join(root, parts[0]), parts[1]), version)
}

pub fn module_directory(root: string, name: string, version: string) -> Result[string, string] {
    match validate_coordinate(name) {
        Ok(()) => Result::Ok(module_directory_unchecked(root, name, version)),
        Err(message) => Result::Err(message),
    }
}

pub fn validate(root: string) -> Result[(), string] {
    let entries = load_index(root)?;
    for (_, entry) in entries {
        validate_coordinate(entry.name)?;
        let latest = parse_sem_version(entry.latest)?;
        let mut latest_matches = false;
        for version in entry.versions {
            let parsed = parse_sem_version(version)?;
            if version_equal(parsed, latest) {
                latest_matches = true;
            }
            let directory = module_directory_unchecked(root, entry.name, version);
            if !fs::is_dir(directory) {
                return Result::Err(
                    "registry index references missing module directory: " + entry.name + "@"
                        + version,
                )
            }
        }
        if !latest_matches {
            return Result::Err(
                "registry index latest version " + entry.latest + " for " + entry.name
                    + " is not listed in versions",
            )
        }
    }
    Result::Ok(())
}

pub fn latest_version(root: string, name: string) -> Result[string, string] {
    validate_coordinate(name)?;
    let entries = load_index(root)?;
    match entries.get(name) {
        Some(entry) => parse_sem_version(entry.latest).map(|_| entry.latest),
        None => Result::Err("module " + name + " not found in registry index"),
    }
}

pub fn select_version(root: string, name: string, minimum: string) -> Result[string, string] {
    validate_coordinate(name)?;
    let minimum_value = parse_sem_version(minimum)?;
    let entries = load_index(root)?;
    let Some(entry) = entries.get(name) else {
        return Result::Err("module " + name + " not found in registry index")
    };
    let mut selected: Option[string] = Option::None;
    let mut selected_value: Option[SemVersion] = Option::None;
    for version in entry.versions {
        let parsed = parse_sem_version(version)?;
        if !version_less(parsed, minimum_value)
            && match selected_value {
                Some(current) => version_less(parsed, current),
                None => true,
            } {
            selected = Option::Some(version);
            selected_value = Option::Some(parsed);
        }
    }
    selected.ok_or("registry has no version for " + name + " satisfying >= " + minimum)
}

pub fn cached_root() -> Result[string, string] {
    let home = match env::var_structured("GOML_HOME") {
        Ok(value) => if value != "" {
            Option::Some(value)
        } else {
            Option::None
        },
        Err(_) => Option::None,
    };
    let home = match home {
        Some(value) => value,
        None => match env::var_structured("HOME") {
            Ok(value) => if value != "" {
                path::join(value, ".goml")
            } else {
                return Result::Err("failed to determine home directory")
            },
            Err(_) => match env::var_structured("USERPROFILE") {
                Ok(value) => if value != "" {
                    path::join(value, ".goml")
                } else {
                    return Result::Err("failed to determine home directory")
                },
                Err(_) => return Result::Err("failed to determine home directory"),
            },
        },
    };
    Result::Ok(path::join(path::join(home, "cache"), "registry"))
}

fn override_root(overrides: Vec[manifest::LocalModule], name: string) -> Option[string] {
    for value in overrides {
        if value.name == name {
            return Option::Some(value.root)
        }
    }
    Option::None
}

fn collect_local_dependencies(
    owner: string,
    dependencies: Vec[manifest::Dependency],
    overrides: Vec[manifest::LocalModule],
    sources: HashMap[string, string],
    hints: HashMap[string, string],
    visited: collections::HashSet[string],
    registry_root: string,
) -> () {
    if !visited.insert(owner) {
        return
    }
    for dependency in dependencies {
        let replacement = override_root(overrides, dependency.name);
        let declared = replacement.is_some() || dependency.path.is_some();
        let local = match replacement {
            Some(value) => Option::Some(value),
            None => match dependency.path {
                Some(value) => Option::Some(manifest::relative_local_path(owner, value)),
                None => hints.get(dependency.name),
            },
        };
        if let Some(directory) = local {
            let Ok(directory) = fs::canonicalize(directory) else {
                continue
            };
            let Ok(manifest) = manifest::load(path::join(directory, manifest::FILENAME)) else {
                continue
            };
            if manifest.module_path != dependency.name {
                continue
            }
            if declared && sources.get(dependency.name).is_none() {
                sources.set(dependency.name, directory);
            }
            collect_local_dependencies(
                directory,
                manifest.dependencies,
                overrides,
                sources,
                hints,
                visited,
                registry_root,
            );
        } else if let Ok(version) = select_version(
            registry_root,
            dependency.name,
            dependency.version,
        ) {
            let directory = module_directory_unchecked(registry_root, dependency.name, version);
            if let Ok(manifest) = manifest::load(path::join(directory, manifest::FILENAME)) {
                if manifest.module_path == dependency.name {
                    let dependencies: Vec[manifest::Dependency] = Vec::new();
                    for requirement in manifest.dependencies {
                        if requirement.path.is_none() {
                            dependencies.push(requirement)
                        }
                    }
                    collect_local_dependencies(
                        directory,
                        dependencies,
                        overrides,
                        sources,
                        hints,
                        visited,
                        registry_root,
                    );
                }
            }
        }
    }
}

fn discover_local_sources(
    owner: string,
    dependencies: Vec[manifest::Dependency],
    overrides: Vec[manifest::LocalModule],
    registry_root: string,
) -> Result[HashMap[string, string], string] {
    let mut hints: HashMap[string, string] = HashMap::new();
    for _ in 0..128 {
        let sources: HashMap[string, string] = HashMap::new();
        collect_local_dependencies(
            owner,
            dependencies,
            overrides,
            sources,
            hints,
            collections::HashSet::new(),
            registry_root,
        );
        let mut stable = sources.len() == hints.len();
        for (name, directory) in sources.entries() {
            if hints.get(name) != Option::Some(directory) {
                stable = false;
            }
        }
        if stable {
            return Result::Ok(sources)
        }
        hints = sources;
    }
    Result::Err("local dependency source selection did not stabilize")
}

fn verify_module_dependencies(
    name: string,
    selected: collections::IndexMap[string, ResolvedModule],
    visiting: collections::HashSet[string],
    done: collections::HashSet[string],
) -> Result[(), string] {
    if done.contains(name) {
        return Result::Ok(())
    }
    if !visiting.insert(name) {
        return Result::Err("dependency cycle involving " + name)
    }
    if let Some(module) = selected.get(name) {
        for dependency in module.dependencies {
            verify_module_dependencies(dependency.name, selected, visiting, done)?;
        }
    }
    let _ = visiting.remove(name);
    let _ = done.insert(name);
    Result::Ok(())
}

pub fn resolve_at(module_root: string, root: string) -> Result[Vec[ResolvedModule], string] {
    let module_root = fs::canonicalize(module_root).map_err(|error| error.to_string())?;
    let root_manifest = manifest::load(path::join(module_root, manifest::FILENAME))?;
    let overrides = manifest::local_overrides(module_root, root_manifest)?;
    let queue: collections::Deque[(manifest::Dependency, string, bool)] = collections::Deque::new();
    for dependency in root_manifest.dependencies {
        queue.push_back((dependency, module_root, true))
    }
    let selected: collections::IndexMap[string, ResolvedModule] = collections::IndexMap::new();
    let local_sources = discover_local_sources(
        module_root,
        root_manifest.dependencies,
        overrides,
        root,
    )?;
    while !queue.is_empty() {
        let Some((requirement, owner, local_owner)) = queue.pop_front() else {
            break;
        };
        let _ = parse_sem_version(requirement.version)?;
        if requirement.name == root_manifest.module_path {
            return Result::Err("dependency cycle involving " + requirement.name)
        }
        if !local_owner && requirement.path.is_some() {
            return Result::Err(
                "registry module cannot declare a local path dependency " + requirement.name,
            )
        }
        let replacement = override_root(overrides, requirement.name);
        let local = match replacement {
            Some(value) => Option::Some(value),
            None => match requirement.path {
                Some(value) => Option::Some(manifest::relative_local_path(owner, value)),
                None => local_sources.get(requirement.name),
            },
        };
        let (version, directory) = match local {
            Some(directory) => {
                let directory = fs::canonicalize(directory).map_err(|error| error.to_string())?;
                if replacement.is_none() {
                    if let Some(previous) = local_sources.get(requirement.name) {
                        if previous != directory {
                            return Result::Err("conflicting local sources for " + requirement.name)
                        }
                    }
                }
                local_sources.set(requirement.name, directory);
                ("local", directory)
            },
            None => {
                let version = select_version(root, requirement.name, requirement.version)?;
                (version, module_directory_unchecked(root, requirement.name, version))
            },
        };
        let update = match selected.get(requirement.name) {
            Some(current) => if version == "local" {
                current.version != "local" || current.root != directory
            } else if current.version == "local" {
                false
            } else {
                version_less(parse_sem_version(current.version)?, parse_sem_version(version)?)
            },
            None => true,
        };
        if update {
            let module_manifest = manifest::load(path::join(directory, manifest::FILENAME))?;
            if module_manifest.module_path != requirement.name {
                return Result::Err(
                    "dependency " + requirement.name + " declares module path "
                        + module_manifest.module_path,
                )
            }
            let resolved = ResolvedModule {
                name: requirement.name,
                version,
                root: directory,
                dependencies: module_manifest.dependencies,
            };
            let _ = selected.insert(requirement.name, resolved);
            for dependency in module_manifest.dependencies {
                queue.push_back((dependency, directory, version == "local"))
            }
        }
    }
    let visiting = collections::HashSet::new();
    let done = collections::HashSet::new();
    for (name, _) in selected {
        verify_module_dependencies(name, selected, visiting, done)?;
    }
    Result::Ok(selected.values())
}

pub fn resolve(module_root: string) -> Result[Vec[ResolvedModule], string] {
    resolve_at(module_root, cached_root()?)
}

pub fn module_matches_package(module_name: string, package_name: string) -> bool {
    package_name == module_name || package_name.starts_with(module_name + "::")
}

pub fn package_directory(module: ResolvedModule, package_name: string) -> Option[string] {
    if package_name == module.name {
        Option::Some(module.root)
    } else if module_matches_package(module.name, package_name) {
        let mut result = module.root;
        let suffix = package_name.byte_slice(module.name.byte_len() + 2, package_name.byte_len());
        for segment in text::split(suffix, "::") {
            result = path::join(result, segment);
        }
        Option::Some(result)
    } else {
        Option::None
    }
}

pub fn artifact_prefix(module: ResolvedModule) -> string {
    let mut result = "deps";
    for part in text::split(module.name, "::") {
        result = path::join(result, part);
    }
    path::join(path::join(result, module.version), "pkg")
}
