package manifest;

use std::fs;
use std::text;

pub struct Native {
    pub go_module: Option[string],
    pub go_version: string,
    pub cgo: bool,
    pub llvm_major: Option[string],
    pub c_bindings: Option[string],
}

pub fn load_native(path: string) -> Result[Native, string] {
    let source = fs::read_file_structured(path).map_err(|error| error.to_string())?;
    let mut section = "";
    let mut go_module = Option::None;
    let mut go_version = "v0.0.0";
    let mut cgo = false;
    let mut llvm_major = Option::None;
    let mut c_bindings = Option::None;
    let seen: Vec[string] = Vec::new();
    for original in text::lines(source) {
        let line = text::trim(strip_comment(original));
        if line == "" {
            continue;
        }
        if line.starts_with("[") && line.ends_with("]") {
            section = text::trim(line.byte_slice(1, line.byte_len() - 1));
            continue;
        }
        if section != "native" {
            continue;
        }
        let parts = text::split(line, "=");
        if parts.len() < 2 {
            return Result::Err("invalid native manifest line: " + original)
        }
        let key = text::trim(parts[0]);
        if seen.contains(key) {
            return Result::Err("duplicate native manifest key: " + key)
        }
        seen.push(key);
        let value = parse_string(
            text::trim(line.byte_slice(parts[0].byte_len() + 1, line.byte_len())),
        )?;
        match key {
            "go-module" => {
                if value == "" || value.contains(" ") || value.contains("\t")
                    || value.contains("\n")
                    || value.contains("@")
                    || value.contains("=") {
                    return Result::Err("native.go-module must be a nonempty Go module path")
                }
                go_module = Option::Some(value);
            },
            "go-version" => {
                if !value.starts_with("v") || value.contains(" ") || value.contains("\t")
                    || value.contains("\n")
                    || value.contains("@") {
                    return Result::Err(
                        "native.go-version must be a Go module version starting with v",
                    )
                }
                go_version = value;
            },
            "cgo" => match value {
                "required" => {
                    cgo = true;
                },
                "optional" => {
                    cgo = false;
                },
                _ => return Result::Err("native.cgo must be required or optional"),
            },
            "c-bindings" => {
                if value == "" || value.starts_with("/") || value.contains("\\") {
                    return Result::Err(
                        "native.c-bindings must be a module-relative configuration path",
                    )
                }
                for component in text::split(value, "/") {
                    if component == ".." {
                        return Result::Err("native.c-bindings cannot traverse parent directories")
                    }
                }
                c_bindings = Option::Some(value);
            },
            "llvm-major" => {
                if value == "" || value.starts_with("0") {
                    return Result::Err("native.llvm-major must be a positive major version")
                }
                for index in 0..value.byte_len() {
                    if value.byte_get(index) < b'0' || value.byte_get(index) > b'9' {
                        return Result::Err("native.llvm-major must be a positive major version")
                    }
                }
                llvm_major = Option::Some(value);
            },
            _ => return Result::Err("unknown native manifest key: " + key),
        }
    }
    if go_module.is_none() && seen.contains("go-version") {
        return Result::Err("native.go-version requires native.go-module")
    }
    if c_bindings.is_some() && (!cgo || go_module.is_none()) {
        return Result::Err("native.c-bindings requires native.cgo = required and native.go-module")
    }
    Result::Ok(Native { go_module, go_version, cgo, llvm_major, c_bindings })
}
