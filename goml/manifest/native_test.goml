package manifest;

use module::test_support;
use std::testing;

fn native_manifest(source: string, name: string) -> Result[Native, string] {
    let root = test_support::workspace("native_manifest_" + name);
    let file = root + "/goml.toml";
    test_support::write_file(file, "[module]\npath = \"demo\"\n" + source);
    load_native(file)
}

#[test]
fn native_manifest_defaults_and_requirements() -> () {
    let empty = testing::expect_ok(native_manifest("", "defaults"), "empty native configuration");
    testing::assert(empty.go_module.is_none());
    testing::assert(!empty.cgo);
    let value = testing::expect_ok(
        native_manifest(
            "[native]\ngo-module = \"example.com/native\"\ncgo = \"required\"\nllvm-major = \"18\"\n",
            "defaults",
        ),
        "native configuration",
    );
    testing::assert_eq(value.go_module.unwrap_or(""), "example.com/native");
    testing::assert_eq(value.go_version, "v0.0.0");
    testing::assert(value.cgo);
    testing::assert_eq(value.llvm_major.unwrap_or(""), "18");
}

#[test]
fn native_manifest_rejects_invalid_requirements() -> () {
    for (source, message) in Vec::from_array(
        [
            ("go-module = \"\"", "nonempty Go module path"),
            ("go-module = \"example.com/a@v1\"", "nonempty Go module path"),
            ("go-version = \"1.2.3\"", "starting with v"),
            ("go-version = \"v1.2.3\"", "requires native.go-module"),
            ("cgo = \"yes\"", "required or optional"),
            ("cgo = \"required\"\ncgo = \"optional\"", "duplicate native manifest key"),
            ("llvm-major = \"018\"", "positive major version"),
            ("llvm-major = \"18.0\"", "positive major version"),
            ("compiler = \"cc\"", "unknown native manifest key"),
            ("c-bindings = \"../bindings.json\"", "parent directories"),
            ("c-bindings = \"/bindings.json\"", "module-relative"),
            ("c-bindings = \"bindings.json\"", "requires native.go-module"),
        ],
    ) {
        let error = testing::expect_err(
            native_manifest("[native]\n" + source + "\n", "invalid"),
            "invalid native configuration",
        );
        test_support::assert_contains(error, message);
    }
    let root = test_support::workspace("native_manifest_main_loader");
    let file = root + "/goml.toml";
    test_support::write_file(file, "[module]\npath = \"demo\"\n[native]\ncgo = \"yes\"\n");
    testing::assert(load(file).is_err());
}
