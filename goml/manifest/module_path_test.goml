package manifest;

use std::testing;

fn manifest_module_path(source: string) -> Option[string] {
    match parse_manifest("/tmp/goml.toml", source, false) {
        Ok(value) => Option::Some(value.module_path),
        Err(_) => Option::None,
    }
}

#[test]
fn parses_module_paths_and_package_names() -> () {
    match manifest_module_path(
        \\[build]
        \\target-dir = "out"
        \\
        \\[module]
        \\path = "alice::tools"
        \\
        ,
    ) {
        Some(value) => testing::assert_eq(value, "alice::tools"),
        None => testing::fail("expected module path"),
    }
}

#[test]
fn parses_module_paths_with_inline_comments() -> () {
    match manifest_module_path(
        \\[build] # output settings
        \\
        \\[module] # package identity
        \\path = "alice::tools" # canonical path
        \\
        ,
    ) {
        Some(value) => testing::assert_eq(value, "alice::tools"),
        None => testing::fail("expected module path"),
    }
}

#[test]
fn parses_only_exact_module_path_keys() -> () {
    testing::assert(
        manifest_module_path(
            \\[module]
            \\pathology = "wrong::path"
            \\
            ,
        ).is_none(),
    );
    testing::assert(
        manifest_module_path(
            \\[module]
            \\path_suffix = "wrong::suffix"
            \\
            ,
        ).is_none(),
    );
    match manifest_module_path(
        \\[module]
        \\pathology = "wrong::path"
        \\path_suffix = "wrong::suffix"
        \\path = "alice::tools" # canonical path
        \\
        ,
    ) {
        Some(value) => testing::assert_eq(value, "alice::tools"),
        None => testing::fail("expected exact module path"),
    }
}
