package config;

use std::testing;
use std::toml;

#[test]
fn dependencies_declare_presence_without_selecting_versions() -> () {
    let document = testing::expect_ok(
        parse_document(
            "[dependencies]\n\"demo::one\" = true\n\"demo::two\" = {}\n\"demo::local\" = { path = \"../local\" }\n",
        ),
        "manifest",
    );
    let dependencies = testing::expect_ok(parse_dependencies(document), "dependencies");
    testing::assert_eq(dependencies.len(), 3);
    testing::assert(dependencies[0].path.is_none());
    testing::assert(dependencies[1].path.is_none());
    testing::assert(dependencies[2].path == Option::Some("../local"));
    for value in Vec::from_array(
        ["false", "42", "[]", "\"latest\"", "\"1.0\"", "{ version = false }"],
    ) {
        let document = testing::expect_ok(
            parse_document("[dependencies]\n\"demo::one\" = " + value),
            "manifest",
        );
        testing::assert(parse_dependencies(document).is_err());
    }
}

#[test]
fn development_dependency_shapes_and_source_scopes_are_explicit() -> () {
    let document = testing::expect_ok(
        parse_document(
            "[dependencies]\n\"demo::normal\" = \"1.0.0\"\n[dev-dependencies]\n\"demo::helper\" = { path = \"../helper\" }\n",
        ),
        "manifest",
    );
    let normal = testing::expect_ok(parse_dependencies(document), "normal");
    let development = testing::expect_ok(parse_dev_dependencies(document), "development");
    testing::assert_eq(development_dependencies(normal, development).len(), 2);
    testing::assert_eq(normal.len(), 1);
    testing::assert(development[0].path == Option::Some("../helper"));
    for file in Vec::from_array(
        [
            "value_test.goml",
            "tests/value.goml",
            "nested/tests/value.goml",
            "examples/basic/main.goml",
        ],
    ) {
        testing::assert(development_source("/project", "/project/" + file));
    }
    for file in Vec::from_array(
        [
            "/project/main.goml",
            "/other/examples/basic/main.goml",
            "/project/nested/examples/main.goml",
        ],
    ) {
        testing::assert(!development_source("/project", file));
    }
    for source in Vec::from_array(
        ["dev-dependencies = []", "[dev-dependencies]\n\"demo::helper\" = { unsupported = true }"],
    ) {
        let document = testing::expect_ok(parse_document(source), "manifest");
        testing::assert(parse_dev_dependencies(document).is_err());
    }
}

#[test]
fn parses_multiline_dependencies_without_consuming_quoted_comments() -> () {
    let source = "[dependencies]\n\"alice::one\" = {\npath = \"../one#data\", # ignored\nversion = \"1.2.3\"\n}\n\"alice::two\" = \"2.0.0\"\n";
    let document = testing::expect_ok(parse_document(source), "manifest");
    let dependencies = testing::expect_ok(parse_dependencies(document), "dependencies");
    testing::assert_eq(dependencies.len(), 2);
    testing::assert_eq(dependencies[0].name, "alice::one");
    testing::assert(dependencies[0].path == Option::Some("../one#data"));
    testing::assert(dependencies[1].path.is_none());
}

#[test]
fn preserves_replacement_order_paths_and_validation_policy() -> () {
    let document = testing::expect_ok(
        parse_document(
            "[replace]\n\"alice::one\" = { path = \"../one\" }\n\"alice::two\" = \"/two\"\n",
        ),
        "manifest",
    );
    let visited = Vec::new();
    let replacements = testing::expect_ok(
        parse_replacements(
            document,
            "/work/app",
            |name| {
                visited.push(name);
                Ok(())
            },
        ),
        "replacements",
    );
    testing::assert(visited == Vec::from_array(["alice::one", "alice::two"]));
    testing::assert_eq(replacements[0].root, "/work/one");
    testing::assert_eq(replacements[1].root, "/two");
    let rejected = parse_replacements(document, "/work/app", |_| Err("rejected by consumer"));
    testing::assert_eq(testing::expect_err(rejected, "validation"), "rejected by consumer");
}

#[test]
fn rejects_invalid_manifest_shapes() -> () {
    testing::assert(parse_document("[workspace]\nmembers = [\"one\"").is_err());
    let document = testing::expect_ok(
        toml::parse("[dependencies]\n\"alice::one\" = { unknown = \"x\" }\n"),
        "TOML",
    );
    testing::assert_eq(
        testing::expect_err(parse_dependencies(document), "dependency field"),
        "unknown dependency field unknown",
    );
    let document = testing::expect_ok(
        toml::parse("[dependencies]\n\"alice::one\" = { path = \"\" }\n"),
        "TOML",
    );
    testing::assert_eq(
        testing::expect_err(parse_dependencies(document), "empty path"),
        "local dependency path cannot be empty",
    );
}
