package config;

use std::testing;

fn manifest_dependencies(source: string) -> Vec[Dependency] {
    parse_document(source).and_then(parse_dependencies).unwrap_or(Vec::new())
}

#[test]
fn ignores_commented_dependencies() -> () {
    let dependencies = manifest_dependencies(
        \\[dependencies]
        \\# "alice::unused" = "9.0.0"
        \\"alice::http" = "1.0.0" # "alice::unused" = "9.0.0"
        \\  # "alice::other" = "2.0.0"
        ,
    );
    testing::assert_eq(dependencies.len(), 1);
    testing::assert_eq(dependencies[0].name, "alice::http");
    testing::assert(dependencies[0].path.is_none())
}

#[test]
fn recognizes_dependency_sections_with_inline_comments() -> () {
    let dependencies = manifest_dependencies(
        \\[module]
        \\path = "alice::app"
        \\[dependencies] # "ignored" = "9.0.0"
        \\  "alice::http" = "1.0.0"
        \\[build] # end dependencies
        \\target-dir = "output"
        ,
    );
    testing::assert_eq(dependencies.len(), 1);
    testing::assert_eq(dependencies[0].name, "alice::http");
    testing::assert(dependencies[0].path.is_none())
}

#[test]
fn preserves_comment_characters_inside_dependency_strings() -> () {
    let dependencies = manifest_dependencies(
        \\[dependencies]
        \\"alice::http#invalid" = { path = "../http#data" } # "ignored" = "9.0.0"
        ,
    );
    testing::assert_eq(dependencies.len(), 1);
    testing::assert_eq(dependencies[0].name, "alice::http#invalid");
    testing::assert(dependencies[0].path == Option::Some("../http#data"))
}

#[test]
fn query_local_dependency_parsing_preserves_literal_paths_and_rejects_malformed_values() -> () {
    let source = "[dependencies]\n\"demo::leaf\" = { path = 'dir#name', version = \"0.1.0\" }\n";
    let dependencies = manifest_dependencies(source);
    testing::assert_eq(dependencies.len(), 1);
    testing::assert_eq(dependencies[0].path.unwrap_or(""), "dir#name");
    testing::assert(
        parse_document("[dependencies]\n\"demo::leaf\" = false\n").and_then(parse_dependencies).is_err(),
    );
}
