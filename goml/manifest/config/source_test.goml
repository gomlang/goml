package config;

use std::testing;

#[test]
fn source_suffixes_preserve_development_boundaries() -> () {
    testing::assert(is_source_file("main.goml"));
    testing::assert(!is_test_source("main.goml"));
    testing::assert(is_test_source("value_test.goml"));
    testing::assert(development_source("/project", "/project/value_test.goml"));
    testing::assert(!development_source("/project", "/project/value.goml"));
    testing::assert(!development_source("/project", "/other/value_test.goml"));
    for name in Vec::from_array(
        ["main.gom", "value_test.gom", "main.gomlx", "value_test.goml.bak", "main.go", "goml.toml"],
    ) {
        testing::assert(!is_source_file(name));
        testing::assert(!is_test_source(name));
    }
}
