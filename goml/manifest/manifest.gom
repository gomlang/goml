package manifest;

use std::fs;
use std::path;
use std::text;

pub const FILENAME: string = "goml.toml";

const MODULE_SECTION: string = "module";

const MODULE_PATH_KEY: string = "path";

const BUILD_SECTION: string = "build";

const TARGET_DIR_KEY: string = "target-dir";

const DEPENDENCIES_SECTION: string = "dependencies";

const DEFAULT_TARGET_DIR: string = "_artifact";

pub struct Dependency {
    pub name: string,
    pub version: string,
}

pub struct Manifest {
    pub module_path: string,
    pub target_dir: string,
    pub dependencies: Vec[Dependency],
}

fn strip_comment(value: string) -> string {
    let mut quoted = false;
    let mut escaped = false;
    for index in 0..value.byte_len() {
        let byte = value.byte_get(index);
        if escaped {
            escaped = false;
        } else if quoted && byte == b'\\' {
            escaped = true;
        } else if byte == b'"' {
            quoted = !quoted;
        } else if !quoted && byte == b'#' {
            return value.byte_slice(0, index)
        }
    }
    value
}

fn parse_string(value: string) -> Result[string, string] {
    let value = text::trim(value);
    if value.byte_len() < 2 || value.byte_get(0) != b'"'
        || value.byte_get(value.byte_len() - 1) != b'"' {
        return Result::Err("manifest values must be quoted strings")
    }
    let content = value.byte_slice(1, value.byte_len() - 1);
    let builder = text::StringBuilder::with_capacity(content.byte_len());
    let mut escaped = false;
    for character in content.chars() {
        if escaped {
            if character == '"' || character == '\\' {
                builder.write_char(character);
                escaped = false;
            } else {
                return Result::Err("unsupported manifest string escape")
            }
        } else if character == '\\' {
            escaped = true;
        } else {
            builder.write_char(character)
        }
    }
    if escaped {
        Result::Err("invalid manifest string escape")
    } else {
        Result::Ok(builder.finish())
    }
}

fn valid_segment(value: string) -> bool {
    if value.byte_len() == 0 {
        return false
    }
    for index in 0..value.byte_len() {
        let byte = value.byte_get(index);
        if (byte >= b'0' && byte <= b'9') || (byte >= b'A' && byte <= b'Z')
            || (byte >= b'a' && byte <= b'z')
            || byte == b'_'
            || byte == b'-' {} else {
            return false
        }
    }
    true
}

fn validate_module_path(value: string, allow_toolchain: bool) -> Result[(), string] {
    let segments = text::split(value, "::");
    if segments.is_empty() {
        return Result::Err("module.path is empty")
    }
    for segment in segments {
        if !valid_segment(segment) {
            return Result::Err("invalid module.path " + value)
        }
    }
    if !allow_toolchain && (segments[0] == "builtin" || segments[0] == "prelude") {
        Result::Err("module path " + value + " is reserved for the toolchain")
    } else {
        Result::Ok(())
    }
}

fn validate_target_dir(value: string) -> Result[(), string] {
    if value == "" || path::is_absolute(value) {
        Result::Err("build.target-dir must be a non-empty relative path")
    } else {
        for segment in text::split(value, "/") {
            if segment == ".." {
                return Result::Err("build.target-dir must stay inside the module")
            }
        }
        for segment in text::split(value, "\\") {
            if segment == ".." {
                return Result::Err("build.target-dir must stay inside the module")
            }
        }
        Result::Ok(())
    }
}

fn load_with_policy(path: string, allow_toolchain: bool) -> Result[Manifest, string] {
    let _ = load_native(path)?;
    let source = fs::read_file_structured(path).map_err(|error| error.to_string())?;
    let mut section = "";
    let mut module_path: Option[string] = Option::None;
    let mut target_dir = DEFAULT_TARGET_DIR;
    let dependencies: Vec[Dependency] = Vec::new();
    for original in text::lines(source) {
        let line = text::trim(strip_comment(original));
        if line == "" {} else if line.byte_len() >= 2 && line.byte_get(0) == b'['
            && line.byte_get(line.byte_len() - 1) == b']' {
            section = text::trim(line.byte_slice(1, line.byte_len() - 1));
        } else {
            let mut equals = -1;
            for index in 0..line.byte_len() {
                if equals < 0 && line.byte_get(index) == b'=' {
                    equals = index;
                }
            }
            if equals < 0 {
                return Result::Err("invalid manifest line: " + original)
            }
            let key = text::trim(line.byte_slice(0, equals));
            let value = parse_string(line.byte_slice(equals + 1, line.byte_len()))?;
            match (section, key) {
                (MODULE_SECTION, MODULE_PATH_KEY) => {
                    module_path = Option::Some(value);
                },
                (BUILD_SECTION, TARGET_DIR_KEY) => {
                    target_dir = value;
                },
                (DEPENDENCIES_SECTION, _) => {
                    let name = parse_string(key)?;
                    validate_module_path(name, allow_toolchain)?;
                    dependencies.push(Dependency { name, version: value })
                },
                _ => (),
            }
        }
    }
    let Some(module_path) = module_path else {
        return Result::Err("goml.toml is missing [module].path")
    };
    validate_module_path(module_path, allow_toolchain)?;
    match validate_target_dir(target_dir) {
        Ok(()) => Result::Ok(Manifest { module_path, target_dir, dependencies }),
        Err(message) => Result::Err(message),
    }
}

pub fn load(path: string) -> Result[Manifest, string] {
    load_with_policy(path, false)
}

pub fn load_toolchain(path: string) -> Result[Manifest, string] {
    load_with_policy(path, true)
}
