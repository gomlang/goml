package manifest;

use gomlang::toolchain_manifest as config;
use std::toml;

pub type LocalModule = config::LocalModule;

pub type Workspace = config::Workspace;

pub fn validate_dependency_name(value: string) -> Result[(), string] {
    validate_module_path(value, false)
}

pub fn relative_local_path(root: string, value: string) -> string {
    config::relative_local_path(root, value)
}

fn parse_replacements(document: toml::Value, root: string) -> Result[Vec[LocalModule], string] {
    config::parse_replacements(document, root, validate_dependency_name)
}

fn workspace_member(filename: string) -> Result[string, string] {
    load(filename).map(|manifest| manifest.module_path)
}

pub fn load_workspace(root: string) -> Result[Workspace, string] {
    config::load_workspace(root, workspace_member, validate_dependency_name)
}

pub fn find_workspace(start: string) -> Result[Option[Workspace], string] {
    config::find_workspace(start, workspace_member, validate_dependency_name)
}

pub fn local_overrides(module_root: string, manifest: Manifest) -> Result[Vec[LocalModule], string] {
    config::local_overrides(
        module_root,
        manifest.replacements,
        workspace_member,
        validate_dependency_name,
    )
}
