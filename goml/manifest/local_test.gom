package manifest;

use module::test_support;
use std::testing;

#[test]
fn local_dependency_manifest_validates_shapes_and_duplicate_names() -> () {
    for suffix in Vec::from_array(
        [
            "[dependencies]\n\"demo::leaf\" = { path = \"\" }\n",
            "[dependencies]\n\"demo::leaf\" = { unknown = \"x\" }\n",
            "[dependencies]\n\"demo::leaf\" = {}\n",
            "[dependencies]\n\"demo::leaf\" = \"1.0.0\"\n\"demo::leaf\" = \"2.0.0\"\n",
            "[replace]\n\"demo::leaf\" = { path = \"leaf\", version = \"1.0.0\" }\n",
        ],
    ) {
        let root = test_support::workspace("local_manifest_invalid");
        test_support::write_file(root + "/goml.toml", "[module]\npath = \"demo::app\"\n" + suffix);
        testing::assert(load(root + "/goml.toml").is_err());
    }
}

#[test]
fn workspace_rejects_duplicate_canonical_members_and_missing_modules() -> () {
    let root = test_support::workspace("workspace_invalid");
    test_support::write_file(root + "/app/goml.toml", "[module]\npath = \"demo::app\"\n");
    for members in Vec::from_array(["[]", "[\"app\", \"./app\"]", "[\"missing\"]", "\"app\""]) {
        test_support::write_file(root + "/goml.work", "[workspace]\nmembers = " + members + "\n");
        testing::assert(load_workspace(root).is_err());
    }
}
