package project;

use std::testing;

fn order_test_package(name: string, imports: Vec[string]) -> Package {
    Package {
        name,
        declared_name: name,
        module_name: "order",
        directory: "",
        artifact_prefix: "",
        files: Vec::new(),
        imports,
    }
}

#[test]
fn dependency_order_preserves_roots_import_order_and_shared_dependencies() -> () {
    let packages = Vec::from_array(
        [
            order_test_package("root", Vec::from_array(["z", "a", "z"])),
            order_test_package("a", Vec::from_array(["shared"])),
            order_test_package("z", Vec::from_array(["shared"])),
            order_test_package("shared", Vec::new()),
            order_test_package("unused", Vec::new()),
        ],
    );
    let order = testing::expect_ok(topological_order(packages, "root"), "entry order");
    testing::assert_eq(order.len(), 4);
    testing::assert_eq(order[0], "shared");
    testing::assert_eq(order[1], "z");
    testing::assert_eq(order[2], "a");
    testing::assert_eq(order[3], "root");
    let all = testing::expect_ok(topological_order_all(packages), "all packages order");
    testing::assert_eq(all.len(), 5);
    testing::assert_eq(all[0], "shared");
    testing::assert_eq(all[1], "a");
    testing::assert_eq(all[2], "z");
    testing::assert_eq(all[3], "root");
    testing::assert_eq(all[4], "unused");
}

#[test]
fn dependency_order_reports_missing_packages_and_cycles() -> () {
    let packages = Vec::from_array([order_test_package("root", Vec::from_array(["missing"]))]);
    match topological_order(packages, "root") {
        Err(error) => testing::assert_eq(error.to_string(), "missing package missing"),
        Ok(_) => testing::fail("missing dependency accepted"),
    }
    let packages = Vec::from_array(
        [
            order_test_package("a", Vec::from_array(["b"])),
            order_test_package("b", Vec::from_array(["a"])),
        ],
    );
    match topological_order_all(packages) {
        Err(error) => testing::assert_eq(error.to_string(), "package dependency cycle at a"),
        Ok(_) => testing::fail("dependency cycle accepted"),
    }
    testing::assert_eq(
        testing::expect_ok(topological_order_all(Vec::new()), "empty order").len(),
        0,
    );
}
