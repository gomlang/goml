package project;

use module::test_support;
use std::path;
use std::process;
use std::testing;

fn installed_world_compiler(root: string) -> string {
    let compiler = path::join(path::join(root, "bin"), "gomlc");
    test_support::write_file(
        compiler,
        \\#!/bin/sh
        \\printf '%s\n' '{"driver_protocol":2,"installed_world":1}'
        \\
        ,
    );
    match process::Command::new("chmod").args(Vec::from_array(["+x", compiler])).status_structured() {
        Ok(status) => testing::assert(process::ExitStatus::success(status)),
        Err(message) => testing::fail(message.to_string()),
    }
    compiler
}

#[test]
fn resolves_executable_relative_installed_world() -> () {
    let root = test_support::workspace("installed_compiler_world");
    let compiler = installed_world_compiler(root);
    let world = path::join(path::join(path::join(root, "lib"), "compiler"), "compiler-world.gaf");
    test_support::write_file(world, "world");
    match resolve_compiler(Option::Some(compiler)) {
        Ok(resolved) => match resolved.world {
            Installed { path } => testing::assert_eq(path, world),
            _ => testing::fail("compiler did not select its installed world"),
        },
        Err(message) => testing::fail(message.to_string()),
    }
}

#[test]
fn rejects_missing_installed_compiler_world() -> () {
    let root = test_support::workspace("missing_installed_compiler_world");
    let compiler = installed_world_compiler(root);
    match resolve_compiler(Option::Some(compiler)) {
        Ok(_) => testing::fail("compiler without its installed world was accepted"),
        Err(message) => {
            testing::assert(message.to_string().contains("compiler world is missing"));
            testing::assert(message.to_string().contains("__toolchain-finalize"))
        },
    }
}
