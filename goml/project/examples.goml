package project;

use module::failure;
use failure::DriverResult;
use module::manifest;
use module::util;
use std::fs;
use std::path;

fn valid_example_name(name: string) -> bool {
    if name == "" {
        return false
    }
    for byte in name.to_bytes() {
        if !((byte >= b'a' && byte <= b'z') || (byte >= b'A' && byte <= b'Z')
            || (byte >= b'0' && byte <= b'9')
            || byte == b'_'
            || byte == b'-') {
            return false
        }
    }
    true
}

pub fn example_names(context: Context) -> Result[Vec[string], failure::Failure] {
    example_names_in(context.graph.module_dir)
}

pub fn example_names_in(module_dir: string) -> Result[Vec[string], failure::Failure] {
    let directory = path::join(module_dir, "examples");
    let result = Vec::new();
    if !fs::exists(directory) {
        return Ok(result)
    }
    for name in fs::read_dir(directory).driver_result()? {
        let child = path::join(directory, name);
        if !name.starts_with(".") && fs::is_dir(child)
            && !fs::is_file(path::join(child, manifest::FILENAME))
            && !source_files(child, false)?.is_empty() {
            if !valid_example_name(name) {
                return Err(failure::convert("invalid example name " + name))
            }
            result.push(name)
        }
    }
    Ok(util::sorted(result))
}

pub fn example_context(context: Context, name: string) -> Result[Context, failure::Failure] {
    if !valid_example_name(name) {
        return Err(failure::convert("invalid example name " + name))
    }
    let directory = path::join(path::join(context.graph.module_dir, "examples"), name);
    if !example_names(context)?.contains(name) {
        return Err(failure::convert("example not found: " + name))
    }
    let directory = canonical(directory)?;
    if !path_inside(path::join(context.graph.module_dir, "examples"), directory) {
        return Err(failure::convert("example is outside the module: " + name))
    }
    let graph = discover_graph(
        context.compiler,
        context.graph.module_dir,
        context.graph.module_path,
        directory,
        false,
        context.graph.sources,
    )?;
    let entry = package_by_name(graph, graph.entry_package).ok_or(
        failure::convert("missing example package"),
    )?;
    if entry.declared_name != "main" {
        return Err(failure::convert("example " + name + " must declare package main"))
    }
    Ok(Context { graph, ..context })
}

fn owns_test_package(graph: Graph, value: Package) -> bool {
    if value.module_name != graph.module_path {
        return false
    }
    if graph.entry_package.starts_with(graph.module_path + "::examples::") {
        value.name == graph.entry_package || value.name.starts_with(graph.entry_package + "::")
    } else {
        !value.name.starts_with(graph.module_path + "::examples::")
    }
}
