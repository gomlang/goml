package project;

use module::failure;
use failure::DriverResult;
use module::manifest;
use module::util;
use std::fs;
use std::path;

fn valid_example_name(name: string) -> bool {
    if name == "" {
        return false
    }
    for byte in name.to_bytes() {
        if !((byte >= b'a' && byte <= b'z') || (byte >= b'A' && byte <= b'Z')
            || (byte >= b'0' && byte <= b'9')
            || byte == b'_'
            || byte == b'-') {
            return false
        }
    }
    true
}

pub fn example_names(context: Context) -> Result[Vec[string], failure::Failure] {
    let directory = path::join(context.graph.module_dir, "examples");
    let result = Vec::new();
    if !fs::exists(directory) {
        return Result::Ok(result)
    }
    for name in fs::read_dir(directory).driver_result()? {
        let child = path::join(directory, name);
        if !name.starts_with(".") && fs::is_dir(child)
            && !fs::is_file(path::join(child, manifest::FILENAME))
            && !source_files(child, false)?.is_empty() {
            if !valid_example_name(name) {
                return Result::Err(failure::convert("invalid example name " + name))
            }
            result.push(name)
        }
    }
    Result::Ok(util::sorted(result))
}

pub fn example_context(context: Context, name: string) -> Result[Context, failure::Failure] {
    if !valid_example_name(name) {
        return Result::Err(failure::convert("invalid example name " + name))
    }
    let directory = path::join(path::join(context.graph.module_dir, "examples"), name);
    if !example_names(context)?.contains(name) {
        return Result::Err(failure::convert("example not found: " + name))
    }
    let directory = canonical(directory)?;
    if !path_inside(path::join(context.graph.module_dir, "examples"), directory) {
        return Result::Err(failure::convert("example is outside the module: " + name))
    }
    let graph = discover_graph(
        context.compiler,
        context.graph.module_dir,
        context.graph.module_path,
        directory,
        false,
        context.graph.sources,
    )?;
    let entry = package_by_name(graph, graph.entry_package).ok_or(
        failure::convert("missing example package"),
    )?;
    if entry.declared_name != "main" {
        return Result::Err(failure::convert("example " + name + " must declare package main"))
    }
    Result::Ok(Context { graph, ..context })
}

fn owns_test_package(graph: Graph, value: Package) -> bool {
    if value.module_name != graph.module_path {
        return false
    }
    if graph.entry_package.starts_with(graph.module_path + "::examples::") {
        value.name == graph.entry_package || value.name.starts_with(graph.entry_package + "::")
    } else {
        !value.name.starts_with(graph.module_path + "::examples::")
    }
}

pub fn validate_downstream_example(context: Context) -> Result[(), failure::Failure] {
    let files = Vec::new();
    for package_value in context.graph.packages {
        if owns_test_package(context.graph, package_value) {
            for file in source_files(package_value.directory, true)? {
                files.push(file)
            }
            let tests = path::join(package_value.directory, "tests");
            if fs::is_dir(tests) {
                for file in source_files(tests, true)? {
                    files.push(file)
                }
            }
        }
    }
    for file in compiler_package_info(context.compiler, context.graph.module_dir, files)? {
        for import in file.uses {
            if import.path.starts_with("module::") {
                return Result::Err(
                    failure::convert(
                        file.path
                            + ": downstream examples must use canonical imports instead of module::; use "
                            + context.graph.module_path
                            + "::",
                    ),
                )
            }
        }
    }
    Result::Ok(())
}
