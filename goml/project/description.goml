package project;

use module::manifest;
use module::manifest::config;
use module::registry;
use std::env;
use std::fs;
use std::json;
use std::path;

fn description_strings(values: Vec[string]) -> json::Value {
    let result = Vec::new();
    for value in values {
        result.push(json::Value::String(value));
    }
    json::Value::Array(result)
}

fn description_dependencies(values: Vec[manifest::Dependency]) -> json::Value {
    let names = Vec::new();
    for value in values {
        names.push(value.name);
    }
    description_strings(names)
}

fn description_module(
    name: string,
    root: string,
    dependencies: Vec[manifest::Dependency],
    development: Vec[manifest::Dependency],
) -> json::Value {
    json::Value::Object(
        Vec::from_array(
            [
                ("name", json::Value::String(name)),
                ("root", json::Value::String(root)),
                ("dependencies", description_dependencies(dependencies)),
                ("dev_dependencies", description_dependencies(development)),
            ],
        ),
    )
}

fn description_ancestors(directory: string, watched: Vec[string]) -> () {
    let mut current = directory;
    loop {
        watched.push(path::join(current, "goml.toml"));
        watched.push(path::join(current, "goml.work"));
        let Some(parent) = path::parent(current) else {
            break
        };
        if parent == current {
            break
        }
        current = parent;
    }
}

pub fn describe_project(source: string, registry_override: Option[string]) -> Result[
    json::Value,
    string,
] {
    let source = path::absolute_structured(source).map_err(|error| error.to_string())?;
    let directory = if fs::is_dir(source) {
        source
    } else {
        path::parent(source).unwrap_or(".")
    };
    let watched: Vec[string] = Vec::from_array([directory]);
    description_ancestors(directory, watched);
    if let Ok(workspace) = env::var_structured("GOML_WORKSPACE") {
        if workspace != "" && workspace != "off" {
            watched.push(
                path::absolute_structured(path::join(workspace, "goml.work")).map_err(
                    |error| error.to_string(),
                )?,
            );
        }
    }
    let mut project = json::Value::Null;
    if let Ok(root) = find_module_root(directory) {
        let root = fs::canonicalize(root).map_err(|error| error.to_string())?;
        let manifest = manifest::load(path::join(root, manifest::FILENAME))?;
        let source_parent = path::parent(source).unwrap_or(".");
        let source = match fs::canonicalize(source_parent) {
            Ok(parent) => path::join(parent, path::file_name(source).unwrap_or("")),
            Err(_) => source,
        };
        let development = config::development_source(root, source);
        let modules = Vec::from_array(
            [
                description_module(
                    manifest.module_path,
                    root,
                    manifest.dependencies,
                    manifest.dev_dependencies,
                ),
            ],
        );
        let mut resolution_error = json::Value::Null;
        let requirements = if development {
            config::development_dependencies(manifest.dependencies, manifest.dev_dependencies)
        } else {
            manifest.dependencies
        };
        if !requirements.is_empty() {
            let cache = match registry_override {
                Some(value) => Result::Ok(value),
                None => registry::cached_root().map_err(|error| error.to_string()),
            };
            let resolved = cache.and_then(
                |cache| registry::resolve_tracked(root, cache, development, watched).map_err(
                    |error| error.to_string(),
                ),
            );
            match resolved {
                Ok(values) => for value in values {
                    modules.push(
                        description_module(value.name, value.root, value.dependencies, Vec::new()),
                    );
                },
                Err(error) => {
                    resolution_error = json::Value::String(error);
                },
            }
        }
        project = json::Value::Object(
            Vec::from_array(
                [
                    ("root", json::Value::String(root)),
                    ("module", json::Value::String(manifest.module_path)),
                    ("target", json::Value::String(path::join(root, manifest.target_dir))),
                    ("development", json::Value::Bool(development)),
                    ("modules", json::Value::Array(modules)),
                    ("error", resolution_error),
                ],
            ),
        );
    }
    Result::Ok(
        json::Value::Object(
            Vec::from_array(
                [
                    ("protocol", json::Value::Number("1")),
                    ("project", project),
                    ("watched", description_strings(watched)),
                ],
            ),
        ),
    )
}
