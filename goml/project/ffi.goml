package project;

use module::failure;

pub fn prepare_foreign_execution(context: Context, dry_run: bool) -> Result[
    Context,
    failure::Failure,
] {
    let environment = prepare_native_environment(context, dry_run)?;
    Result::Ok(
        Context {
            graph: context.graph,
            compiler: context.compiler,
            compiler_world: context.compiler_world,
            artifact_root: context.artifact_root,
            foreign: Option::Some(ForeignExecution { environment }),
        },
    )
}
