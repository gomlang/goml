package project;

use module::test_support;
use std::fs;
use std::path;
use std::testing;

fn assert_go_build_simd(input: string, expected: bool) -> () {
    match go_build_uses_simd(input) {
        Ok(value) => testing::assert_eq(value, expected),
        Err(message) => testing::fail(message),
    }
}

#[test]
fn go_build_metadata_tracks_source_contents() -> () {
    let root = test_support::workspace("go_build_metadata_contents");
    let input = path::join(root, "main.go");
    let plain = "package main\nconst _goml_simd_nativx = 1\n";
    let simd = "package main\nconst _goml_simd_native = 1\n";
    testing::assert_eq(plain.byte_len(), simd.byte_len());
    for source in Vec::from_array([plain, simd, plain, simd]) {
        test_support::write_file(input, source);
        let expected = source == simd;
        assert_go_build_simd(input, expected);
        assert_go_build_simd(input, expected)
    }
}

#[test]
fn go_build_metadata_recovers_from_invalid_records() -> () {
    let root = test_support::workspace("go_build_metadata_invalid");
    let input = path::join(root, "main.go");
    test_support::write_file(input, "package main\nconst _goml_simd_native = 1\n");
    let digest = match fs::sha256_file(input) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            ""
        },
    };
    for metadata in Vec::from_array(
        [
            "",
            "goml-go-build-metadata-v2\n" + digest + "\nplain",
            "goml-go-build-metadata-v1\nstale\nplain",
            "goml-go-build-metadata-v1\n" + digest + "\nunknown",
            "goml-go-build-metadata-v1\n" + digest + "\nplain\nextra",
        ],
    ) {
        test_support::write_file(input + ".goml-go-build-metadata-fingerprint", metadata);
        assert_go_build_simd(input, true)
    }
}

#[test]
fn go_build_metadata_is_optional_but_source_is_required() -> () {
    let root = test_support::workspace("go_build_metadata_optional");
    let input = path::join(root, "main.go");
    if let Err(error) = fs::create_dir_all(input + ".goml-go-build-metadata-fingerprint") {
        testing::fail(error.to_string())
    }
    test_support::write_file(input, "package main\n");
    assert_go_build_simd(input, false);
    assert_go_build_simd(input, false);
    testing::assert(go_build_uses_simd(path::join(root, "missing.go")).is_err())
}
