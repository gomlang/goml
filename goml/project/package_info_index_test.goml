package project;

use std::testing;

fn indexed_test_info(file: string, name: string) -> PackageInfoFile {
    PackageInfoFile { path: file, package_name: name, package_explicit: true, uses: Vec::new() }
}

#[test]
fn package_info_selection_preserves_requested_order_and_duplicate_records() -> () {
    let index = index_package_info(
        Vec::from_array(
            [
                indexed_test_info("a.goml", "first"),
                indexed_test_info("b.goml", "second"),
                indexed_test_info("a.goml", "third"),
            ],
        ),
    );
    let selected = testing::expect_ok(
        select_package_info(
            "/tmp/info",
            index,
            Vec::from_array(["/tmp/info/b.goml", "/tmp/info/a.goml", "/tmp/info/b.goml"]),
        ),
        "selected package info",
    );
    testing::assert_eq(selected.len(), 4);
    testing::assert_eq(selected[0].package_name, "second");
    testing::assert_eq(selected[1].package_name, "first");
    testing::assert_eq(selected[2].package_name, "third");
    testing::assert_eq(selected[3].package_name, "second");
    testing::assert_eq(
        testing::expect_ok(select_package_info("/tmp/info", index, Vec::new()), "empty selection").len(),
        0,
    );
}

#[test]
fn package_info_selection_reports_the_first_missing_file() -> () {
    let index = index_package_info(Vec::from_array([indexed_test_info("a.goml", "first")]));
    let error = testing::expect_err(
        select_package_info(
            "/tmp/info",
            index,
            Vec::from_array(["/tmp/info/a.goml", "/tmp/info/missing.goml", "/tmp/info/other.goml"]),
        ),
        "missing package info",
    );
    testing::assert_eq(error.to_string(), "package-info omitted missing.goml");
}
