package project;

use module::test_support;
use std::fs;
use std::path;
use std::process;
use std::testing;

fn export_path_graph(root: string) -> Graph {
    Graph {
        module_dir: root,
        module_path: "demo::calc",
        entry_package: "demo::calc",
        packages: Vec::from_array(
            [
                Package {
                    go_foreign: false,
                    name: "demo::calc",
                    declared_name: "calc",
                    module_name: "demo::calc",
                    directory: root,
                    artifact_prefix: "",
                    files: Vec::new(),
                    imports: Vec::new(),
                },
            ],
        ),
        sources: Vec::new(),
        order: Vec::from_array(["demo::calc"]),
    }
}

fn exercise_export_paths(root: string) -> Result[(), string] {
    let graph = export_path_graph(root);
    let missing = resolve_export_destination(
        graph,
        ".",
        "gen/calclib",
        "example.com/host/gen/calclib",
        "missing-go-program",
    );
    match missing {
        Err(message) => testing::assert(message.contains("existing go.mod")),
        Ok(_) => testing::fail("missing go.mod accepted"),
    }
    let manifest = "module example.com/host\n\ngo 1.25\n";
    fs::write_file_structured(path::join(root, "go.mod"), manifest).map_err(
        |error| error.to_string(),
    )?;
    let destination = resolve_export_destination(
        graph,
        ".",
        "gen/calclib",
        "example.com/host/gen/calclib",
        "go",
    )?;
    testing::assert_eq(destination.source_package, "demo::calc");
    testing::assert_eq(destination.go_package, "calclib");
    testing::assert_eq(destination.output_directory, path::join(root, "gen/calclib"));
    testing::assert(!fs::exists(destination.output_directory));
    testing::assert(
        resolve_export_destination(graph, ".", "gen/calclib", "wrong/path", "go").is_err(),
    );
    testing::assert(
        resolve_export_destination(graph, ".", "../outside", "example.com/outside", "go").is_err(),
    );
    testing::assert(
        resolve_export_destination(graph, ".", "gen/main", "example.com/host/gen/main", "go").is_err(),
    );
    testing::assert(
        resolve_export_destination(
            graph,
            ".",
            "gen/bad-name",
            "example.com/host/gen/bad-name",
            "go",
        ).is_err(),
    );
    testing::assert(
        resolve_export_destination(
            graph,
            ".",
            "bad space/calclib",
            "example.com/host/bad space/calclib",
            "go",
        ).is_err(),
    );
    fs::create_dir_all(path::join(root, "nested")).map_err(|error| error.to_string())?;
    fs::write_file_structured(path::join(root, "nested/go.mod"), "module example.com/nested\n").map_err(
        |error| error.to_string(),
    )?;
    testing::assert(
        resolve_export_destination(
            graph,
            ".",
            "nested/calclib",
            "example.com/host/nested/calclib",
            "go",
        ).is_err(),
    );
    testing::assert(
        resolve_export_destination(
            graph,
            "nested",
            "gen/calclib",
            "example.com/host/gen/calclib",
            "go",
        ).is_err(),
    );
    testing::assert_eq(
        fs::read_file_structured(path::join(root, "go.mod")).map_err(|error| error.to_string())?,
        manifest,
    );
    testing::assert(!fs::exists(path::join(root, "go.sum")));
    Result::Ok(())
}

#[test]
fn export_paths_validate_module_identity_without_creating_outputs() -> () {
    let root = test_support::workspace("export_paths");
    match exercise_export_paths(root) {
        Ok(()) => (),
        Err(error) => testing::fail(error),
    }
}

#[test]
fn export_paths_reject_symlink_escape_and_dangling_links() -> () {
    let root = test_support::workspace("export_paths_symlink");
    let outside = test_support::workspace("export_paths_outside");
    testing::assert(
        fs::write_file_structured(
            path::join(root, "go.mod"),
            "module example.com/host\n\ngo 1.25\n",
        ).is_ok(),
    );
    let link = path::join(root, "escape");
    let result = process::Command::new("ln").args(Vec::from_array(["-s", outside, link])).output_structured();
    testing::assert(result.map(|output| output.status().success()).unwrap_or(false));
    let graph = export_path_graph(root);
    testing::assert(
        resolve_export_destination(
            graph,
            ".",
            "escape/calclib",
            "example.com/host/escape/calclib",
            "go",
        ).is_err(),
    );
    testing::assert(
        resolve_export_destination(
            graph,
            "escape",
            "gen/calclib",
            "example.com/host/gen/calclib",
            "go",
        ).is_err(),
    );
    testing::assert(fs::remove_file(link).is_ok());
    let result = process::Command::new("ln").args(
        Vec::from_array(["-s", path::join(outside, "missing"), link]),
    ).output_structured();
    testing::assert(result.map(|output| output.status().success()).unwrap_or(false));
    testing::assert(export_canonical_destination(link).is_err());
    testing::assert(!fs::exists(path::join(outside, "calclib")));
}

#[test]
fn export_paths_reject_main_sources_and_invalid_import_components() -> () {
    let root = test_support::workspace("export_paths_main");
    let graph = export_path_graph(root);
    let package_value = graph.packages[0];
    let main_graph = Graph {
        module_dir: graph.module_dir,
        module_path: graph.module_path,
        entry_package: graph.entry_package,
        packages: Vec::from_array(
            [
                Package {
                    go_foreign: false,
                    name: package_value.name,
                    declared_name: "main",
                    module_name: package_value.module_name,
                    directory: package_value.directory,
                    artifact_prefix: "",
                    files: Vec::new(),
                    imports: Vec::new(),
                },
            ],
        ),
        sources: Vec::new(),
        order: graph.order,
    };
    match resolve_export_destination(
        main_graph,
        ".",
        "gen/calclib",
        "example.com/host/gen/calclib",
        "go",
    ) {
        Err(message) => testing::assert(message.contains("must not be main")),
        Ok(_) => testing::fail("main package exported"),
    }
    for component in Vec::from_array(
        ["", "bad space", "con", "Lpt9.txt", "foo~1", "bad.", "bad@version", "é"],
    ) {
        testing::assert(!export_import_component(component));
    }
    for component in Vec::from_array(["v2", "go-lib", "c++", "good_name", "foo~bar"]) {
        testing::assert(export_import_component(component));
    }
}
