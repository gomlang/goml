package project;

use std::fs;
use std::text;

fn cached_go_build_simd(source_hash: string, metadata: string) -> Option[bool] {
    let fields = text::split(metadata, "\n");
    if fields.len() != 3 || fields[0] != "goml-go-build-metadata-v1" || fields[1] != source_hash {
        return Option::None
    }
    match fields[2] {
        "simd" => Option::Some(true),
        "plain" => Option::Some(false),
        _ => Option::None,
    }
}

fn go_build_uses_simd(input: string) -> Result[bool, string] {
    let source_hash = fs::sha256_file(input).map_err(|error| error.to_string())?;
    let metadata_path = input + ".goml-go-build-metadata-fingerprint";
    if let Ok(metadata) = fs::read_file_structured(metadata_path) {
        if let Some(value) = cached_go_build_simd(source_hash, metadata) {
            return Result::Ok(value)
        }
    }
    let source = fs::read_file_structured(input).map_err(|error| error.to_string())?;
    let uses_simd = source.contains("\nconst _goml_simd_native = ");
    let after = fs::sha256_file(input).map_err(|error| error.to_string())?;
    if after != source_hash {
        return Result::Err("generated Go source changed while reading build metadata: " + input)
    }
    let value = if uses_simd {
        "simd"
    } else {
        "plain"
    };
    let _ = fs::write_file_structured(
        metadata_path,
        "goml-go-build-metadata-v1\n" + source_hash + "\n" + value,
    );
    Result::Ok(uses_simd)
}
