package project;

use module::util;
use std::collections;
use std::fs;
use std::io;
use std::path;
use std::process;
use std::task;
use std::text;
use std::time;

struct BuildNode {
    index: isize,
    command: Command,
    dependencies: collections::IndexSet[isize],
}

struct BuildGraph {
    nodes: Vec[BuildNode],
}

struct BuildLock {
    path: string,
}

fn build_lock_path(context: Context) -> string {
    path::join(context.artifact_root, ".goml-build-lock")
}

fn build_lock_is_stale(path_value: string) -> bool {
    match fs::metadata(path_value) {
        Ok(metadata) => {
            let age = time::SystemTime::now().unix_nanoseconds()
                - metadata.modified_unix_nanoseconds();
            age > 86400000000000
        },
        Err(_) => false,
    }
}

fn acquire_build_lock(context: Context) -> Result[BuildLock, string] {
    fs::create_dir_all(context.artifact_root).map_err(|error| error.to_string())?;
    let lock_path = build_lock_path(context);
    let started = time::Instant::now();
    loop {
        match fs::create_dir(lock_path) {
            Ok(()) => return Result::Ok(BuildLock { path: lock_path }),
            Err(error) => if error.kind() == io::ErrorKind::AlreadyExists {
                if build_lock_is_stale(lock_path) {
                    fs::remove_dir_all(lock_path).map_err(|error| error.to_string())?
                } else if started.elapsed().as_seconds() >= 30 {
                    return Result::Err("timed out waiting for build lock " + lock_path)
                } else {
                    time::sleep(time::Duration::from_milliseconds(1))
                }
            } else {
                return Result::Err(error.to_string())
            },
        }
    }
}

fn release_build_lock(lock: BuildLock) -> Result[(), string] {
    fs::remove_dir_all(lock.path).map_err(|error| error.to_string())
}

pub fn with_build_lock[T](context: Context, action: () -> Result[T, string]) -> Result[T, string] {
    let lock = acquire_build_lock(context)?;
    let result = action();
    match result {
        Ok(value) => match release_build_lock(lock) {
            Ok(()) => Result::Ok(value),
            Err(error) => Result::Err(error),
        },
        Err(error) => {
            let _ = release_build_lock(lock);
            Result::Err(error)
        },
    }
}

fn package_artifact_base(root: string, graph: Graph, package_name: string) -> string {
    let Some(package_value) = package_by_name(graph, package_name) else {
        return path::join(root, package_name)
    };
    let mut result = path::join(root, package_value.artifact_prefix);
    for segment in text::split(package_name, "::") {
        result = path::join(result, segment);
    }
    path::join(result, last_segment(package_name))
}

fn linked_go_output(root: string, graph: Graph, package_name: string) -> string {
    match path::parent(package_artifact_base(root, graph, package_name)) {
        Some(value) => path::join(value, "goml_generated.go"),
        None => path::join(root, "goml_generated.go"),
    }
}

fn extension(value: string, suffix: string) -> string {
    path::with_extension(value, suffix)
}

fn last_segment(value: string) -> string {
    let segments = text::split(value, "::");
    if segments.is_empty() {
        value
    } else {
        segments[segments.len() - 1]
    }
}

fn executable_path_for(context: Context, entry_package: string) -> string {
    let mut result = path::join(context.artifact_root, "bin");
    let module_segments = text::split(context.graph.module_path, "::");
    let entry_segments = text::split(entry_package, "::");
    for index in module_segments.len()..entry_segments.len() {
        result = path::join(result, entry_segments[index]);
    }
    path::join(result, last_segment(entry_package))
}

fn collect_dependencies(graph: Graph, package_name: string, result: collections::BTreeSet[string]) -> Result[
    (),
    string,
] {
    let Some(package_value) = package_by_name(graph, package_name) else {
        return Result::Err(f"missing package {package_name}")
    };
    for dependency in package_value.imports {
        if result.insert(dependency) {
            collect_dependencies(graph, dependency, result)?
        }
    }
    Result::Ok(())
}

fn mark_reachable(graph: Graph, package_name: string, seen: collections::HashSet[string]) -> Result[
    (),
    string,
] {
    if !seen.insert(package_name) {
        return Result::Ok(())
    }
    let Some(package_value) = package_by_name(graph, package_name) else {
        return Result::Err(f"missing package {package_name}")
    };
    for dependency in package_value.imports {
        mark_reachable(graph, dependency, seen)?
    }
    Result::Ok(())
}

fn reachable_packages(graph: Graph, entries: Vec[string]) -> Result[Vec[string], string] {
    let seen: collections::HashSet[string] = collections::HashSet::new();
    for entry in entries {
        mark_reachable(graph, entry, seen)?
    }
    let result: Vec[string] = Vec::new();
    for package_name in graph.order {
        if seen.contains(package_name) {
            result.push(package_name)
        }
    }
    Result::Ok(result)
}

fn dependency_interfaces(graph: Graph, package_name: string, output_root: string) -> Result[
    Vec[string],
    string,
] {
    let names: collections::BTreeSet[string] = collections::BTreeSet::new();
    collect_dependencies(graph, package_name, names)?;
    let result: Vec[string] = Vec::new();
    for name in names {
        result.push(extension(package_artifact_base(output_root, graph, name), "interface"))
    }
    Result::Ok(result)
}

fn compile_commands(
    context: Context,
    output_root: string,
    entry_command: string,
    dependency_command: string,
    packages: Vec[string],
) -> Result[Vec[Command], string] {
    let result: Vec[Command] = Vec::new();
    for package_name in packages {
        let command = if package_name == context.graph.entry_package {
            entry_command
        } else {
            dependency_command
        };
        let compiled = compile_package_command(
            context.graph,
            context.graph.module_dir,
            package_name,
            output_root,
            output_root,
            command,
            compiler_world_path(context),
        )?;
        result.push(compiled)
    }
    Result::Ok(result)
}

fn compiler_world_path(context: Context) -> Option[string] {
    match context.compiler_world {
        Source => Option::None,
        Installed { path } => Option::Some(path),
    }
}

fn compile_package_command(
    graph: Graph,
    module_dir: string,
    package_name: string,
    interface_root: string,
    output_root: string,
    command: string,
    world: Option[string],
) -> Result[Command, string] {
    let Some(package_value) = package_by_name(graph, package_name) else {
        return Result::Err(f"missing package {package_name}")
    };
    let inputs: Vec[string] = Vec::new();
    for file in package_value.files {
        inputs.push(module_relative(module_dir, file))
    }
    let interfaces = dependency_interfaces(graph, package_name, interface_root)?;
    let relative_interfaces: Vec[string] = Vec::new();
    for value in interfaces {
        relative_interfaces.push(module_relative(module_dir, value))
    }
    Result::Ok(
        Command::Compile {
            subcommand: command,
            package_name,
            module_name: package_value.module_name,
            input_files: util::sorted(inputs),
            interface_files: relative_interfaces,
            output: module_relative(
                module_dir,
                package_artifact_base(output_root, graph, package_name),
            ),
            world,
        },
    )
}

fn compile_test_package_command(
    graph: Graph,
    module_dir: string,
    package_name: string,
    dependency_root: string,
    output_root: string,
    production_interface: bool,
    world: Option[string],
) -> Result[Command, string] {
    let compiled = compile_package_command(
        graph,
        module_dir,
        package_name,
        dependency_root,
        output_root,
        TEST_BUILD_SUBCOMMAND,
        world,
    )?;
    match compiled {
        Compile {
            subcommand,
            package_name,
            module_name,
            input_files,
            interface_files,
            output,
            world,
        } => {
            if production_interface {
                interface_files.push(
                    module_relative(
                        module_dir,
                        extension(
                            package_artifact_base(dependency_root, graph, package_name),
                            "interface",
                        ),
                    ),
                )
            }
            Result::Ok(
                Command::Compile {
                    subcommand,
                    package_name,
                    module_name,
                    input_files,
                    interface_files,
                    output,
                    world,
                },
            )
        },
        _ => Result::Err("test package did not produce a compile command"),
    }
}

fn core_outputs(context: Context, output_root: string, packages: Vec[string]) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    for package_name in packages {
        result.push(
            module_relative(
                context.graph.module_dir,
                extension(package_artifact_base(output_root, context.graph, package_name), "core"),
            ),
        )
    }
    result
}

pub fn check_plan(context: Context, include_tests: bool) -> Result[Plan, string] {
    let output_root = path::join(context.artifact_root, CHECK_SUBCOMMAND);
    let commands = compile_commands(
        context,
        output_root,
        CHECK_SUBCOMMAND,
        CHECK_SUBCOMMAND,
        context.graph.order,
    )?;
    if include_tests {
        let internal = internal_test_graphs(context)?;
        for graph in internal {
            let target = Context {
                foreign: Option::None,
                graph,
                compiler: context.compiler,
                compiler_world: context.compiler_world,
                artifact_root: context.artifact_root,
            };
            let values = compile_commands(
                target,
                output_root,
                TEST_CHECK_SUBCOMMAND,
                CHECK_SUBCOMMAND,
                target.graph.order,
            )?;
            for value in values {
                commands.push(value)
            }
        }
        let external = external_test_graphs(context)?;
        for test in external {
            let target = Context {
                foreign: Option::None,
                graph: test.graph,
                compiler: context.compiler,
                compiler_world: context.compiler_world,
                artifact_root: context.artifact_root,
            };
            let values = compile_commands(
                target,
                output_root,
                TEST_CHECK_SUBCOMMAND,
                CHECK_SUBCOMMAND,
                target.graph.order,
            )?;
            for value in values {
                commands.push(value)
            }
        }
    }
    Result::Ok(Plan { commands, executable: Option::None, test_groups: Vec::new() })
}

pub fn build_plan(context: Context) -> Result[Plan, string] {
    let output_root = path::join(context.artifact_root, BUILD_SUBCOMMAND);
    let entries: Vec[string] = Vec::new();
    for package_name in context.graph.order {
        let Some(package_value) = package_by_name(context.graph, package_name) else {
            return Result::Err(f"missing package {package_name}")
        };
        if package_value.declared_name == "main" {
            entries.push(package_name)
        }
    }
    let packages = if entries.is_empty() {
        context.graph.order
    } else {
        reachable_packages(context.graph, entries)?
    };
    let commands = compile_commands(
        context,
        output_root,
        BUILD_SUBCOMMAND,
        BUILD_SUBCOMMAND,
        packages,
    )?;
    for entry_package in util::sorted(entries) {
        let main_go = linked_go_output(output_root, context.graph, entry_package);
        let packages = reachable_packages(context.graph, Vec::from_array([entry_package]))?;
        commands.push(
            Command::Link {
                input_cores: core_outputs(context, output_root, packages),
                entry_package,
                output: module_relative(context.graph.module_dir, main_go),
                world: compiler_world_path(context),
            },
        );
        let executable = executable_path_for(context, entry_package);
        commands.push(
            Command::GoBuild {
                input: module_relative(context.graph.module_dir, main_go),
                output: module_relative(context.graph.module_dir, executable),
            },
        )
    }
    Result::Ok(Plan { commands, executable: Option::None, test_groups: Vec::new() })
}

pub fn load_toolchain_context(prefix: string, compiler: string) -> Result[Context, string] {
    let lib_dir = path::join(prefix, "lib");
    let artifact_root = path::join(path::join(lib_dir, "compiler"), "build");
    let graph = discover_toolchain_graph(compiler, lib_dir, artifact_root)?;
    Result::Ok(
        Context {
            foreign: Option::None,
            graph,
            compiler,
            compiler_world: CompilerWorld::Source,
            artifact_root,
        },
    )
}

pub fn toolchain_world_plan(context: Context, output: string) -> Result[Plan, string] {
    let commands: Vec[Command] = Vec::new();
    let package_outputs: Vec[string] = Vec::new();
    let source_files: Vec[string] = Vec::new();
    let counter_output = path::join(context.artifact_root, "builtin-counter");
    for package_name in context.graph.order {
        let Some(package_value) = package_by_name(context.graph, package_name) else {
            return Result::Err("missing toolchain package " + package_name)
        };
        let output = package_artifact_base(context.artifact_root, context.graph, package_name);
        let inputs: Vec[string] = Vec::new();
        for value in package_value.files {
            let value = module_relative(context.graph.module_dir, value);
            inputs.push(value);
            source_files.push(value)
        }
        let interfaces = dependency_interfaces(context.graph, package_name, context.artifact_root)?;
        let relative_interfaces: Vec[string] = Vec::new();
        for value in interfaces {
            relative_interfaces.push(module_relative(context.graph.module_dir, value))
        }
        commands.push(
            Command::ToolchainCompile {
                package_name,
                module_name: package_value.module_name,
                input_files: util::sorted(inputs),
                interface_files: relative_interfaces,
                output: module_relative(context.graph.module_dir, output),
                builtin_contract: package_value.module_name == "builtin",
                without_roots: package_value.module_name == "prelude",
                counter_output: if package_value.module_name == "builtin" {
                    Option::Some(module_relative(context.graph.module_dir, counter_output))
                } else {
                    Option::None
                },
            },
        );
        package_outputs.push(module_relative(context.graph.module_dir, output))
    }
    commands.push(
        Command::PackToolchainWorld {
            input_packages: package_outputs,
            source_files: util::sorted_unique(source_files),
            counter_file: module_relative(context.graph.module_dir, counter_output),
            output: module_relative(context.graph.module_dir, output),
        },
    );
    Result::Ok(Plan { commands, executable: Option::None, test_groups: Vec::new() })
}

fn target_build_plan(context: Context, build_executable: bool) -> Result[Plan, string] {
    let output_root = path::join(context.artifact_root, BUILD_SUBCOMMAND);
    let packages = reachable_packages(context.graph, Vec::from_array([context.graph.entry_package]))?;
    let commands = compile_commands(
        context,
        output_root,
        BUILD_SUBCOMMAND,
        BUILD_SUBCOMMAND,
        packages,
    )?;
    let main_go = linked_go_output(output_root, context.graph, context.graph.entry_package);
    let packages = reachable_packages(context.graph, Vec::from_array([context.graph.entry_package]))?;
    commands.push(
        Command::Link {
            input_cores: core_outputs(context, output_root, packages),
            entry_package: context.graph.entry_package,
            output: module_relative(context.graph.module_dir, main_go),
            world: compiler_world_path(context),
        },
    );
    let executable = executable_path_for(context, context.graph.entry_package);
    if build_executable {
        commands.push(
            Command::GoBuild {
                input: module_relative(context.graph.module_dir, main_go),
                output: module_relative(context.graph.module_dir, executable),
            },
        )
    }
    Result::Ok(
        Plan {
            commands,
            executable: if build_executable {
                Option::Some(executable)
            } else {
                Option::None
            },
            test_groups: Vec::new(),
        },
    )
}

pub fn build_target_artifacts_plan(context: Context) -> Result[Plan, string] {
    target_build_plan(context, false)
}

pub fn run_plan(context: Context) -> Result[Plan, string] {
    target_build_plan(context, true)
}

fn append_test_package(
    context: Context,
    graph: Graph,
    dependency_root: string,
    output_root: string,
    compiled_dependencies: collections::HashSet[string],
    commands: Vec[Command],
) -> Result[(), string] {
    for package_name in graph.order {
        if package_name == graph.entry_package || compiled_dependencies.contains(package_name) {} else {
            let compiled = compile_package_command(
                graph,
                context.graph.module_dir,
                package_name,
                dependency_root,
                dependency_root,
                BUILD_SUBCOMMAND,
                compiler_world_path(context),
            )?;
            commands.push(compiled);
            let _ = compiled_dependencies.insert(package_name);
        }
    }
    let compiled = compile_test_package_command(
        graph,
        context.graph.module_dir,
        graph.entry_package,
        dependency_root,
        output_root,
        compiled_dependencies.contains(graph.entry_package),
        compiler_world_path(context),
    )?;
    commands.push(compiled);
    Result::Ok(())
}

fn append_test_group(
    context: Context,
    graphs: Vec[Graph],
    dependency_root: string,
    output_root: string,
    kind: string,
    packages: Vec[string],
    commands: Vec[Command],
    groups: Vec[TestGroup],
) -> () {
    let test_packages: collections::HashSet[string] = collections::HashSet::new();
    for graph in graphs {
        let _ = test_packages.insert(graph.entry_package);
    }
    let input_cores: Vec[string] = Vec::new();
    let added: collections::HashSet[string] = collections::HashSet::new();
    for package_name in context.graph.order {
        let root = if test_packages.contains(package_name) {
            output_root
        } else {
            dependency_root
        };
        input_cores.push(
            module_relative(
                context.graph.module_dir,
                extension(package_artifact_base(root, context.graph, package_name), "core"),
            ),
        );
        let _ = added.insert(package_name);
    }
    for graph in graphs {
        for package_name in graph.order {
            if added.contains(package_name) {} else {
                let root = if test_packages.contains(package_name) {
                    output_root
                } else {
                    dependency_root
                };
                input_cores.push(
                    module_relative(
                        context.graph.module_dir,
                        extension(package_artifact_base(root, graph, package_name), "core"),
                    ),
                );
                let _ = added.insert(package_name);
            }
        }
    }
    let main_go = path::join(output_root, "goml_generated.go");
    let manifest = path::join(output_root, "tests.json");
    commands.push(
        Command::TestLink {
            input_cores,
            packages,
            output: module_relative(context.graph.module_dir, main_go),
            manifest: module_relative(context.graph.module_dir, manifest),
            world: compiler_world_path(context),
        },
    );
    let runner = path::join(output_root, "runner");
    commands.push(
        Command::GoBuild {
            input: module_relative(context.graph.module_dir, main_go),
            output: module_relative(context.graph.module_dir, runner),
        },
    );
    groups.push(TestGroup { kind, manifest, runner });
}

pub fn test_plan(context: Context, kind: string) -> Result[Plan, string] {
    let dependency_root = path::join(path::join(context.artifact_root, "test"), "base");
    let commands = compile_commands(
        context,
        dependency_root,
        BUILD_SUBCOMMAND,
        BUILD_SUBCOMMAND,
        context.graph.order,
    )?;
    let compiled_dependencies: collections::HashSet[string] = collections::HashSet::new();
    for package_name in context.graph.order {
        let _ = compiled_dependencies.insert(package_name);
    }
    let groups: Vec[TestGroup] = Vec::new();
    let internal: Vec[Graph] = match kind {
        INTERNAL_TEST_KIND | ALL_TEST_KIND => internal_test_graphs(context)?,
        _ => Vec::new(),
    };
    let internal_root = path::join(path::join(context.artifact_root, "test"), INTERNAL_TEST_KIND);
    let internal_graphs: Vec[Graph] = Vec::new();
    let internal_packages: Vec[string] = Vec::new();
    for graph in internal {
        let package_name = graph.entry_package;
        append_test_package(
            context,
            graph,
            dependency_root,
            internal_root,
            compiled_dependencies,
            commands,
        )?;
        internal_graphs.push(graph);
        internal_packages.push(package_name)
    }
    if !internal_graphs.is_empty() {
        append_test_group(
            context,
            internal_graphs,
            dependency_root,
            internal_root,
            INTERNAL_TEST_KIND,
            internal_packages,
            commands,
            groups,
        )
    }
    let external: Vec[ExternalTest] = match kind {
        EXTERNAL_TEST_KIND | ALL_TEST_KIND => external_test_graphs(context)?,
        _ => Vec::new(),
    };
    let external_root = path::join(path::join(context.artifact_root, "test"), EXTERNAL_TEST_KIND);
    let external_graphs: Vec[Graph] = Vec::new();
    let external_packages: Vec[string] = Vec::new();
    for test in external {
        let package_name = test.graph.entry_package;
        append_test_package(
            context,
            test.graph,
            dependency_root,
            external_root,
            compiled_dependencies,
            commands,
        )?;
        external_graphs.push(test.graph);
        external_packages.push(package_name);
        external_packages.push(test.target_package)
    }
    if !external_graphs.is_empty() {
        append_test_group(
            context,
            external_graphs,
            dependency_root,
            external_root,
            EXTERNAL_TEST_KIND,
            external_packages,
            commands,
            groups,
        )
    }
    Result::Ok(Plan { commands, executable: Option::None, test_groups: groups })
}

fn display_args(program: string, args: Vec[string]) -> string {
    let builder = text::StringBuilder::new();
    builder.write_string(program);
    for argument in args {
        builder.write_char(' ');
        builder.write_string(util::shell_escape(argument))
    }
    builder.finish()
}

fn command_args(value: Command) -> (string, Vec[string]) {
    match value {
        Compile {
            subcommand,
            package_name,
            module_name,
            input_files,
            interface_files,
            output,
            world,
        } => {
            let args: Vec[string] = Vec::new();
            args.push(subcommand);
            args.push("--package");
            args.push(package_name);
            args.push("--module");
            args.push(module_name);
            for input in input_files {
                args.push("--input");
                args.push(input)
            }
            for interface in interface_files {
                args.push("--interface-path");
                args.push(interface)
            }
            args.push("--output");
            args.push(output);
            if let Some(value) = world {
                args.push("--world");
                args.push(value)
            };
            (GOMLC_PROGRAM, args)
        },
        ToolchainCompile {
            package_name,
            module_name,
            input_files,
            interface_files,
            output,
            builtin_contract,
            without_roots,
            counter_output,
        } => {
            let args = Vec::from_array(["__toolchain-build"]);
            if builtin_contract {
                args.push("--builtin-contract")
            }
            if without_roots {
                args.push("--without-roots")
            }
            if let Some(value) = counter_output {
                args.push("--counter-output");
                args.push(value)
            }
            args.push("--package");
            args.push(package_name);
            args.push("--module");
            args.push(module_name);
            args.push("--input");
            for value in input_files {
                args.push(value)
            }
            for value in interface_files {
                args.push("--interface-path");
                args.push(value)
            }
            args.push("--output");
            args.push(output);
            (GOMLC_PROGRAM, args)
        },
        PackToolchainWorld { input_packages, source_files, counter_file, output } => {
            let args = Vec::from_array(["__toolchain-pack"]);
            for value in input_packages {
                args.push("--input");
                args.push(value)
            }
            for value in source_files {
                args.push("--source");
                args.push(value)
            }
            args.push("--counter-file");
            args.push(counter_file);
            args.push("--output");
            args.push(output);
            (GOMLC_PROGRAM, args)
        },
        Link { input_cores, entry_package, output, world } => {
            let args: Vec[string] = Vec::new();
            args.push("link");
            args.push("--input");
            for input in input_cores {
                args.push(input)
            }
            args.push("--output");
            args.push(output);
            args.push("--entry");
            args.push(entry_package);
            if let Some(value) = world {
                args.push("--world");
                args.push(value)
            };
            (GOMLC_PROGRAM, args)
        },
        TestLink { input_cores, packages, output, manifest, world } => {
            let args: Vec[string] = Vec::new();
            args.push("test-link");
            args.push("--input");
            for input in input_cores {
                args.push(input)
            }
            args.push("--output");
            args.push(output);
            args.push("--manifest");
            args.push(manifest);
            for package_name in packages {
                args.push("--package");
                args.push(package_name)
            }
            if let Some(value) = world {
                args.push("--world");
                args.push(value)
            };
            (GOMLC_PROGRAM, args)
        },
        GoBuild { input, output } => (
            GO_PROGRAM,
            Vec::from_array([BUILD_SUBCOMMAND, "-o", output, input]),
        ),
    }
}

pub fn display_command(value: Command) -> string {
    let command = command_args(value);
    display_args(command.0, command.1)
}

fn progress_label(value: Command) -> string {
    match value {
        Compile { subcommand, package_name, .. } => match subcommand {
            CHECK_SUBCOMMAND => f"checking {package_name}",
            BUILD_SUBCOMMAND => f"compiling {package_name}",
            TEST_CHECK_SUBCOMMAND => f"checking tests for {package_name}",
            TEST_BUILD_SUBCOMMAND => f"compiling tests for {package_name}",
            _ => f"{subcommand} {package_name}",
        },
        ToolchainCompile { package_name, .. } => f"compiling toolchain package {package_name}",
        PackToolchainWorld { .. } => "packing compiler world",
        Link { entry_package, .. } => f"linking {entry_package}",
        TestLink { .. } => "linking test runner",
        GoBuild { .. } => "building executable",
    }
}

fn ensure_output_parent(value: Command, module_dir: string) -> Result[(), string] {
    let output = match value {
        Compile { output, .. } | ToolchainCompile { output, .. } | PackToolchainWorld { output, .. } | Link {
            output,
            ..,
        } | TestLink { output, .. } | GoBuild { output, .. } => output,
    };
    let absolute = if path::is_absolute(output) {
        output
    } else {
        path::join(module_dir, output)
    };
    match path::parent(absolute) {
        Some(parent) => fs::create_dir_all(parent).map_err(|error| error.to_string()),
        None => Result::Ok(()),
    }
}

fn execute_command(cancel: task::CancelToken, context: Context, value: Command) -> Result[
    (),
    string,
] {
    ensure_output_parent(value, context.graph.module_dir)?;
    if let Link { .. } | TestLink { .. } = value {
        verify_foreign_command_artifacts(cancel, context, value)?;
    }
    let mut command = foreign_command_args(context, value);
    if command.0 == GO_PROGRAM {
        if let GoBuild { input, output } = value {
            let source = fs::read_file_structured(
                absolute_from_module(context.graph.module_dir, input),
            ).map_err(|error| error.to_string())?;
            if source.contains("\nconst _goml_simd_native = ") {
                command = (
                    GOMLC_PROGRAM,
                    Vec::from_array(["__simd-go-build", "--input", input, "--output", output]),
                );
            }
        }
    }
    let program = match command.0 {
        GOMLC_PROGRAM => context.compiler,
        _ => command.0,
    };
    let process = process::Command::new(program).args(command.1).current_dir(
        context.graph.module_dir,
    );
    if command.0 == GO_PROGRAM {
        let _ = process.env("GOWORK", "off");
        if !fs::is_file(path::join(context.graph.module_dir, "go.mod")) {
            let _ = process.env("GO111MODULE", "off");
        } else {
            let _ = process.env("GO111MODULE", "on");
        }
    }
    match process.status_cancel_structured(cancel) {
        Ok(status) => if process::ExitStatus::success(status) {
            Result::Ok(())
        } else {
            Result::Err(f"{display_command(value)} failed")
        },
        Err(error) => if error.kind() == io::ErrorKind::Interrupted {
            Result::Err("build cancelled")
        } else {
            Result::Err(error.to_string())
        },
    }
}

struct PreparedCache {
    spec: CacheSpec,
    fingerprint: string,
}

enum CachePreparation {
    Fresh,
    Execute(Option[PreparedCache]),
}

fn prepare_cached_command(
    digests: DigestCache,
    context: Context,
    command: Command,
    identity: string,
) -> Result[CachePreparation, string] {
    match command {
        GoBuild { .. } if context.foreign.is_some() => return Result::Ok(
            CachePreparation::Execute(Option::None),
        ),
        GoBuild { .. } if fs::is_file(path::join(context.graph.module_dir, "go.mod")) => {
            return Result::Ok(CachePreparation::Execute(Option::None))
        },
        _ => (),
    }
    if let GoBuild { input, .. } = command {
        let source = fs::read_file_structured(absolute_from_module(context.graph.module_dir, input)).map_err(
            |error| error.to_string(),
        )?;
        if source.contains("\nconst _goml_simd_native = ") {
            return Result::Ok(CachePreparation::Execute(Option::None))
        }
    }
    match cache_spec(command) {
        Some(spec) => {
            let fingerprint = command_fingerprint(digests, context, identity, spec)?;
            let fresh = cache_is_fresh(digests, context, spec, fingerprint)?;
            if fresh {
                Result::Ok(CachePreparation::Fresh)
            } else {
                invalidate_output_digests(digests, context.graph.module_dir, spec.outputs);
                prepare_cache_execution(context, spec)?;
                Result::Ok(
                    CachePreparation::Execute(Option::Some(PreparedCache { spec, fingerprint })),
                )
            }
        },
        None => Result::Ok(CachePreparation::Execute(Option::None)),
    }
}

fn execute_prepared_command(
    cancel: task::CancelToken,
    context: Context,
    command: Command,
    cache: Option[PreparedCache],
) -> Result[(), string] {
    match execute_command(cancel, context, command) {
        Ok(()) => Result::Ok(()),
        Err(message) => {
            if let Some(value) = cache {
                let _ = prepare_cache_execution(context, value.spec);
            }
            Result::Err(message)
        },
    }
}

fn finish_prepared_command(
    digests: DigestCache,
    context: Context,
    identity: string,
    cache: Option[PreparedCache],
) -> Result[(), string] {
    match cache {
        Some(value) => store_cache(digests, context, value.spec, identity, value.fingerprint),
        None => Result::Ok(()),
    }
}

fn abandon_prepared_command(context: Context, cache: Option[PreparedCache]) -> () {
    if let Some(value) = cache {
        let _ = prepare_cache_execution(context, value.spec);
    }
}

fn build_graph(commands: Vec[Command]) -> Result[BuildGraph, string] {
    let producers: HashMap[string, Vec[isize]] = HashMap::new();
    for index in 0..commands.len() {
        if let Some(spec) = cache_spec(commands[index]) {
            for output in spec.outputs {
                producers.entry(output).or_insert_with(|| Vec::new()).push(index)
            }
        }
    }
    let result: Vec[BuildNode] = Vec::new();
    for index in 0..commands.len() {
        let command = commands[index];
        let dependencies: collections::IndexSet[isize] = collections::IndexSet::new();
        if let Some(spec) = cache_spec(command) {
            for input in spec.inputs {
                let mut previous = -1;
                let mut following = -1;
                if let Some(values) = producers[input] {
                    for candidate in values {
                        if candidate < index && candidate > previous {
                            previous = candidate;
                        } else if candidate > index && following < 0 {
                            following = candidate;
                        }
                    }
                }
                let producer = if previous >= 0 {
                    previous
                } else {
                    following
                };
                if producer >= 0 {
                    let _ = dependencies.insert(producer);
                }
            }
            for output in spec.outputs {
                let mut previous = -1;
                if let Some(values) = producers[output] {
                    for candidate in values {
                        if candidate < index && candidate > previous {
                            previous = candidate;
                        }
                    }
                }
                if previous >= 0 {
                    let _ = dependencies.insert(previous);
                }
            }
        }
        result.push(BuildNode { index, command, dependencies })
    }
    Result::Ok(BuildGraph { nodes: result })
}

fn build_node(nodes: Vec[BuildNode], index: isize) -> Option[BuildNode] {
    if index >= 0 && index < nodes.len() {
        Option::Some(nodes[index])
    } else {
        Option::None
    }
}

fn build_node_ready(node: BuildNode, completed: collections::BitSet) -> bool {
    for dependency in node.dependencies {
        if !completed.contains(dependency) {
            return false
        }
    }
    true
}

fn take_ready_build_node(nodes: Vec[BuildNode], pending: Vec[isize], completed: collections::BitSet) -> Result[
    Option[BuildNode],
    string,
] {
    let mut position = 0;
    while position < pending.len() {
        let index = pending[position];
        let Some(node) = build_node(nodes, index) else {
            return Result::Err(f"build graph omitted node {index}")
        };
        if build_node_ready(node, completed) {
            let _ = pending.remove(position);
            return Result::Ok(Option::Some(node))
        } else {
            position += 1;
        }
    }
    Result::Ok(Option::None)
}

struct BuildWork {
    index: isize,
    command: Command,
    cache: Option[PreparedCache],
}

struct BuildWorkResult {
    index: isize,
    cache: Option[PreparedCache],
    result: Result[(), string],
    completion: Option[Channel[bool]],
}

fn accept_build_result(
    scope: task::Scope,
    digests: DigestCache,
    context: Context,
    identity: string,
    received: Option[BuildWorkResult],
    completed_nodes: collections::BitSet,
    completed: Ref[isize],
) -> Result[(), string] {
    let Some(value) = received else {
        scope.cancel();
        return Result::Err("build result channel closed early")
    };
    completed.set(completed.get() + 1);
    match value.result {
        Ok(()) => match finish_prepared_command(digests, context, identity, value.cache) {
            Ok(()) => {
                if let Some(completion) = value.completion {
                    completion.send(true)
                }
                let _ = completed_nodes.insert(value.index);
                Result::Ok(())
            },
            Err(message) => {
                if let Some(completion) = value.completion {
                    completion.send(false)
                }
                scope.cancel();
                Result::Err(message)
            },
        },
        Err(message) => {
            scope.cancel();
            Result::Err(message)
        },
    }
}

fn execute_plan_worker(
    cancel: task::CancelToken,
    context: Context,
    work: Channel[BuildWork],
    results: Channel[BuildWorkResult],
) -> Result[(), string] {
    loop {
        match task::recv_with(cancel, work) {
            task::WaitResult::Completed(Some(value)) => {
                let result = execute_prepared_command(cancel, context, value.command, value.cache);
                let completion: Channel[bool] = Channel::new(1);
                results.send(
                    BuildWorkResult {
                        index: value.index,
                        cache: value.cache,
                        result,
                        completion: if result.is_ok() {
                            Option::Some(completion)
                        } else {
                            Option::None
                        },
                    },
                );
                result?;
                match task::recv_with(cancel, completion) {
                    task::WaitResult::Completed(Some(true)) => (),
                    task::WaitResult::Completed(Some(false)) | task::WaitResult::Completed(None) | task::WaitResult::Cancelled => abandon_prepared_command(
                        context,
                        value.cache,
                    ),
                }
            },
            task::WaitResult::Completed(None) | task::WaitResult::Cancelled => break,
        }
    }
    Result::Ok(())
}

fn execute_plan_concurrently(
    scope: task::Scope,
    digests: DigestCache,
    context: Context,
    graph: BuildGraph,
    identity: string,
    total: isize,
    jobs: isize,
    completed: Ref[isize],
) -> Result[(), string] {
    let initial: Vec[isize] = Vec::new();
    for node in graph.nodes {
        initial.push(node.index)
    }
    let mut pending = initial;
    let completed_nodes = collections::BitSet::new();
    let mut running = 0;
    let worker_count = if jobs < total {
        jobs
    } else {
        total
    };
    let work: Channel[BuildWork] = Channel::new(0);
    let results: Channel[BuildWorkResult] = Channel::new(worker_count);
    for _ in 0..worker_count {
        let _ = scope.spawn_try(
            |cancel: task::CancelToken| execute_plan_worker(cancel, context, work, results),
        );
    }
    let mut prepared: Option[BuildWork] = Option::None;
    while !pending.is_empty() || prepared.is_some() || running > 0 {
        while prepared.is_none() && running < worker_count {
            let next = match take_ready_build_node(graph.nodes, pending, completed_nodes) {
                Ok(value) => value,
                Err(message) => {
                    scope.cancel();
                    return Result::Err(message)
                },
            };
            let Some(node) = next else {
                break
            };
            util::display_progress(completed.get(), total, progress_label(node.command), false);
            match prepare_cached_command(digests, context, node.command, identity) {
                Ok(Fresh) => {
                    if let Err(message) = verify_foreign_cached_command(
                        scope.token(),
                        context,
                        node.command,
                    ) {
                        scope.cancel();
                        return Result::Err(message)
                    }
                    let _ = completed_nodes.insert(node.index);
                    completed.set(completed.get() + 1);
                },
                Ok(Execute(cache)) => {
                    prepared = Option::Some(
                        BuildWork { index: node.index, command: node.command, cache },
                    );
                },
                Err(message) => {
                    scope.cancel();
                    return Result::Err(message)
                },
            }
        }
        match prepared {
            Some(value) => if running == 0 {
                match task::send_with(scope.token(), work, value) {
                    task::WaitResult::Completed(()) => {
                        prepared = Option::None;
                        running += 1;
                    },
                    task::WaitResult::Cancelled => {
                        abandon_prepared_command(context, value.cache);
                        return Result::Err("build cancelled")
                    },
                }
            } else if scope.token().is_cancelled() {
                match accept_build_result(
                    scope,
                    digests,
                    context,
                    identity,
                    results.recv(),
                    completed_nodes,
                    completed,
                ) {
                    Ok(()) => {
                        running -= 1;
                    },
                    Err(message) => {
                        abandon_prepared_command(context, value.cache);
                        return Result::Err(message)
                    },
                }
            } else {
                select {
                    send(work, value) => {
                        prepared = Option::None;
                        running += 1;
                    },
                    recv(results) as received => match accept_build_result(
                        scope,
                        digests,
                        context,
                        identity,
                        received,
                        completed_nodes,
                        completed,
                    ) {
                        Ok(()) => {
                            running -= 1;
                        },
                        Err(message) => {
                            abandon_prepared_command(context, value.cache);
                            return Result::Err(message)
                        },
                    },
                }
            },
            None => if running > 0 {
                accept_build_result(
                    scope,
                    digests,
                    context,
                    identity,
                    results.recv(),
                    completed_nodes,
                    completed,
                )?;
                running -= 1;
            } else if !pending.is_empty() {
                scope.cancel();
                return Result::Err("build plan contains a dependency cycle")
            },
        }
    }
    work.close();
    results.close();
    Result::Ok(())
}

pub fn execute_plan(context: Context, plan: Plan, dry_run: bool, jobs: isize) -> Result[(), string] {
    if !dry_run && jobs < 1 {
        return Result::Err("build jobs must be greater than zero")
    }
    let total = plan.commands.len();
    let completed = Ref::new(0);
    let identity = if dry_run {
        ""
    } else {
        compiler_digest(context)?
    };
    if dry_run {
        for command in plan.commands {
            let invocation = foreign_command_args(context, command);
            io::println(display_args(invocation.0, invocation.1))
        }
    } else {
        let graph = build_graph(plan.commands)?;
        let digests = digest_cache();
        let execution = task::try_scope(
            |scope: task::Scope| execute_plan_concurrently(
                scope,
                digests,
                context,
                graph,
                identity,
                total,
                jobs,
                completed,
            ),
        );
        if let Err(message) = execution {
            return Result::Err(message)
        }
    }
    if dry_run {} else {
        util::display_progress(completed.get(), total, "finished", true)
    }
    Result::Ok(())
}

pub fn run_executable(context: Context, executable: string, args: Vec[string], dry_run: bool) -> Result[
    (),
    string,
] {
    let relative = module_relative(context.graph.module_dir, executable);
    if dry_run {
        io::println(display_args(relative, args));
        Result::Ok(())
    } else {
        match process::Command::new(executable).args(args).current_dir(context.graph.module_dir).status_structured() {
            Ok(status) => if process::ExitStatus::success(status) {
                Result::Ok(())
            } else {
                match process::ExitStatus::code(status) {
                    Some(code) => Result::Err(f"program exited with status {code}"),
                    None => Result::Err("program terminated by signal"),
                }
            },
            Err(error) => Result::Err(error.to_string()),
        }
    }
}
