package project;

use module::failure;
use std::path;

fn standard_library_test_plan(context: Context, kind: string) -> Result[Plan, failure::Failure] {
    if kind == INTERNAL_TEST_KIND || kind == ALL_TEST_KIND {
        if !internal_test_graphs(context)?.is_empty() {
            return Result::Err(
                failure::convert(
                    "standard-library tests must use package tests in a direct tests/ directory; internal tests are not supported",
                ),
            )
        }
    }
    let external = if kind == EXTERNAL_TEST_KIND || kind == ALL_TEST_KIND {
        external_test_graphs(context)?
    } else {
        Vec::new()
    };
    if external.is_empty() {
        return Result::Ok(
            Plan { commands: Vec::new(), executable: Option::None, test_groups: Vec::new() },
        )
    }
    let Some(lib_dir) = path::parent(context.graph.module_dir) else {
        return Result::Err(failure::convert("standard-library module has no library root"))
    };
    let test_root = path::join(context.artifact_root, "test");
    let world_root = path::join(test_root, "world");
    let world = module_relative(
        context.graph.module_dir,
        path::join(world_root, "compiler-world-v2.gaf"),
    );
    let discovered = discover_toolchain_graph(
        context.compiler,
        lib_dir,
        path::join(world_root, "build"),
    )?;
    let graph = Graph { module_dir: context.graph.module_dir, ..discovered };
    let world_context = Context {
        foreign: Option::None,
        graph,
        compiler: context.compiler,
        compiler_world: CompilerWorld::Source,
        artifact_root: path::join(world_root, "build"),
    };
    let commands = toolchain_world_plan(
        world_context,
        path::join(world_root, "compiler-world-v2.gaf"),
    )?.commands;
    let output_root = path::join(test_root, EXTERNAL_TEST_KIND);
    let input_cores: Vec[string] = Vec::new();
    let packages: Vec[string] = Vec::new();
    for test in external {
        let Some(package_value) = package_by_name(test.graph, test.graph.entry_package) else {
            return Result::Err(
                failure::convert(
                    "missing standard-library test package " + test.graph.entry_package,
                ),
            )
        };
        let input_files: Vec[string] = Vec::new();
        for file in package_value.files {
            input_files.push(module_relative(context.graph.module_dir, file));
        }
        let output = module_relative(
            context.graph.module_dir,
            package_artifact_base(output_root, test.graph, package_value.name),
        );
        commands.push(
            Command::Compile {
                subcommand: TEST_BUILD_SUBCOMMAND,
                package_name: package_value.name,
                module_name: package_value.module_name,
                input_files,
                interface_files: Vec::new(),
                output,
                world: Option::Some(world),
            },
        );
        input_cores.push(path::with_extension(output, "core"));
        packages.push(package_value.name);
    }
    let main_go = module_relative(
        context.graph.module_dir,
        path::join(output_root, "goml_generated.go"),
    );
    let manifest = path::join(output_root, "tests.json");
    let runner = path::join(output_root, "runner");
    commands.push(
        Command::TestLink {
            input_cores,
            packages,
            output: main_go,
            manifest: module_relative(context.graph.module_dir, manifest),
            world: Option::Some(world),
        },
    );
    commands.push(
        Command::GoBuild {
            input: main_go,
            output: module_relative(context.graph.module_dir, runner),
        },
    );
    Result::Ok(
        Plan {
            commands,
            executable: Option::None,
            test_groups: Vec::from_array([TestGroup { kind: EXTERNAL_TEST_KIND, manifest, runner }]),
        },
    )
}
