package project;

pub struct PackageInfoFile {
    pub path: string,
    pub package_name: string,
    pub package_explicit: bool,
    pub uses: Vec[string],
}

pub struct Package {
    pub name: string,
    pub declared_name: string,
    pub module_name: string,
    pub directory: string,
    pub artifact_prefix: string,
    pub files: Vec[string],
    pub imports: Vec[string],
}

pub struct ModuleSource {
    pub name: string,
    pub directory: string,
    pub artifact_prefix: string,
    pub dependencies: Vec[string],
    pub dev_dependencies: Vec[string],
}

pub struct Graph {
    pub module_dir: string,
    pub module_path: string,
    pub entry_package: string,
    pub packages: Vec[Package],
    pub sources: Vec[ModuleSource],
    pub order: Vec[string],
}

pub enum CompilerWorld {
    Source,
    Installed { path: string },
}

pub struct BuildOptions {
    pub pgo: Option[string],
    pub record: bool,
    pub explain: Option[string],
}

pub fn default_build_options() -> BuildOptions {
    BuildOptions { pgo: None, record: false, explain: None }
}

pub struct Context {
    pub build_options: BuildOptions,
    pub native_environment: Vec[(string, string)],
    pub graph: Graph,
    pub compiler: string,
    pub compiler_world: CompilerWorld,
    pub artifact_root: string,
}

pub struct ExternalTest {
    pub graph: Graph,
    pub target_package: string,
}
