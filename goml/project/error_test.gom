package project;

use module::failure;
use module::test_support;
use std::fs;
use std::io;
use std::testing;

#[test]
fn cache_error_keeps_filesystem_cause_and_context() -> () {
    let root = test_support::workspace("typed-cache-error");
    let report = testing::expect_err(file_digest(root, "missing"), "missing input");
    let cause = testing::expect_some(
        report.find_map(
            |value| match value {
                Fs(cause) => Some(cause),
                _ => None,
            },
        ),
        "filesystem cause",
    );
    let original = testing::expect_err(fs::sha256_file(root + "/missing"), "original cause");
    testing::assert_eq(cause, original);
    testing::assert_eq(report.message().unwrap_or(""), "failed to read cache input missing");
}

#[test]
fn export_error_keeps_filesystem_classification_and_os_code() -> () {
    let root = test_support::workspace("typed-export-error");
    let report = testing::expect_err(export_go_module_path("go", root), "missing manifest");
    let cause = testing::expect_some(
        report.find_map(
            |value| match value {
                Fs(cause) => Some(cause),
                _ => None,
            },
        ),
        "filesystem cause",
    );
    testing::assert(cause.kind() == io::ErrorKind::NotFound);
    testing::assert(cause.raw_os_code() == Option::Some(2));
    testing::assert(cause.path() == Option::Some(root + "/go.mod"));
    testing::assert_eq(
        report.message().unwrap_or(""),
        "export-go: GoML module root must contain an existing go.mod",
    );
}

#[test]
fn driver_report_keeps_primary_and_cleanup_causes() -> () {
    let cause = fs::Error::new(
        io::ErrorKind::PermissionDenied,
        "remove",
        Some("cache"),
        Some(13),
        "denied",
    );
    let report = failure::combine(
        failure::convert("build failed"),
        failure::convert(cause).context("cleanup"),
    );
    testing::assert_eq(report.causes().len(), 2);
    let found = testing::expect_some(
        report.find_map(
            |value| match value {
                Fs(cause) => Some(cause),
                _ => None,
            },
        ),
        "cleanup cause",
    );
    testing::assert(found.raw_os_code() == Option::Some(13));
    testing::assert(found.path() == Option::Some("cache"));
    testing::assert_eq(report.causes()[1].message().unwrap_or(""), "cleanup");
}
