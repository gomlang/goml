package project;

use std::path;
use std::testing;

#[test]
fn foreign_callers_follow_every_link_using_a_shared_package() -> () {
    let context = compiler_world_test_context(CompilerWorld::Source);
    let commands = Vec::from_array(
        [
            compile_command("shared", Vec::new(), "out/shared"),
            compile_command("unused", Vec::new(), "out/unused"),
            Command::Link {
                input_cores: Vec::from_array(["out/shared.core"]),
                entry_package: "first",
                output: "first/generated.go",
                world: Option::None,
            },
            Command::TestLink {
                input_cores: Vec::from_array(["out/shared.core"]),
                packages: Vec::new(),
                output: "second/generated.go",
                manifest: "second/tests.json",
                world: Option::None,
            },
        ],
    );
    let callers = foreign_plan_callers(
        context,
        Plan { commands, executable: Option::None, test_groups: Vec::new() },
    );
    let shared = callers["out/shared.interface"].unwrap_or(Vec::new());
    testing::assert_eq(shared.len(), 2);
    testing::assert(shared.contains(path::join(context.graph.module_dir, "first")));
    testing::assert(shared.contains(path::join(context.graph.module_dir, "second")));
    let unused = callers["out/unused.interface"].unwrap_or(Vec::new());
    testing::assert_eq(unused.len(), 1);
    testing::assert_eq(unused[0], path::join(context.graph.module_dir, "out"));
}
