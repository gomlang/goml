package project;

use std::fs;
use std::path;
use std::testing;

#[test]
fn foreign_execution_keeps_native_modules_without_metadata_helpers() -> () {
    let context = native_test_context("foreign_native_without_helpers");
    let prepared = testing::expect_ok(
        prepare_foreign_execution(context, false),
        "prepare handwritten native modules",
    );
    let execution = testing::expect_some(prepared.foreign, "native execution context");
    testing::assert_eq(execution.environment.len(), 1);
    testing::assert_eq(execution.environment[0].0, "GOFLAGS");
    testing::assert(!fs::exists(path::join(context.artifact_root, "ffi-build-context.json")));
    let build = command_args(Command::GoBuild { input: "generated.go", output: "program" });
    testing::assert_eq(build.0, GO_PROGRAM);
    testing::assert_eq(build.1[0], "build");
}

#[test]
fn ordinary_compiler_commands_omit_legacy_foreign_arguments() -> () {
    for command in Vec::from_array(
        [
            compile_command("shared", Vec::new(), "out/shared"),
            Command::Link {
                input_cores: Vec::from_array(["out/shared.core"]),
                entry_package: "main",
                output: "generated.go",
                world: Option::None,
            },
        ],
    ) {
        let invocation = command_args(command);
        testing::assert(!invocation.1.contains("--ffi-check"));
        testing::assert(!invocation.1.contains("--context"));
        testing::assert(!invocation.1.contains("--caller-directory"));
    }
}
