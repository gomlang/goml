package project;

use module::build_model::{Command};
use std::fs;
use std::path;
use std::testing;
use module::build_model;

#[test]
fn native_execution_prepares_handwritten_modules() -> () {
    let context = native_test_context("native_execution_modules");
    let prepared = testing::expect_ok(
        prepare_native_execution(context, false),
        "prepare handwritten native modules",
    );
    testing::assert_eq(prepared.native_environment.len(), 1);
    testing::assert_eq(prepared.native_environment[0].0, "GOFLAGS");
    testing::assert(!fs::exists(path::join(context.artifact_root, "ffi-build-context.json")));
    let build = Command::GoBuild { input: "generated.go", output: "program" }.args();
    testing::assert_eq(build.0, build_model::GO_PROGRAM);
    testing::assert_eq(build.1[0], "build");
}
