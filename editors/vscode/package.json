{
    "name": "goml",
    "displayName": "GoML Language Support",
    "description": "Language support for GoML (.gom files)",
    "version": "0.1.52",
    "publisher": "goml",
    "repository": {
        "type": "git",
        "url": "https://github.com/lijunchen/goml.git",
        "directory": "editors/vscode"
    },
    "vsce": {
        "baseContentUrl": "https://github.com/lijunchen/goml/blob/main/editors/vscode",
        "baseImagesUrl": "https://github.com/lijunchen/goml/raw/main/editors/vscode",
        "skipLicense": true
    },
    "engines": {
        "vscode": "^1.91.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:goml",
        "onCommand:goml.runTest",
        "onCommand:goml.showExpandedDerive",
        "onCommand:goml.showLspOutput"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "goml.runTest",
                "title": "GoML: Run Test"
            },
            {
                "command": "goml.showExpandedDerive",
                "title": "GoML: Show Expanded Derive"
            },
            {
                "command": "goml.showLspOutput",
                "title": "GoML: Show Language Server Output"
            }
        ],
        "languages": [
            {
                "id": "goml",
                "aliases": [
                    "GoML",
                    "goml"
                ],
                "extensions": [
                    ".gom"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/goml.svg",
                    "dark": "./icons/goml.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "goml",
                "scopeName": "source.goml",
                "path": "./syntaxes/goml.tmLanguage.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "GoML",
            "properties": {
                "goml.serverPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to a GoML language server executable. If empty, uses the selected bundled server or searches PATH."
                },
                "goml.trace.server": {
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Traces the communication between VS Code and the GoML language server."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src",
        "pretest": "npm run compile",
        "test": "node ./out/test/runTest.js",
        "package": "vsce package"
    },
    "dependencies": {
        "vscode-languageclient": "^10.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/mocha": "^10.0.6",
        "@types/node": "^20.10.0",
        "@types/vscode": "^1.91.0",
        "@vscode/test-electron": "^2.3.8",
        "@vscode/vsce": "^3.9.2",
        "eslint": "^10.8.0",
        "glob": "^13.0.6",
        "globals": "^17.8.0",
        "mocha": "^11.7.6",
        "typescript": "^5.3.2",
        "typescript-eslint": "^8.65.0"
    },
    "overrides": {
        "mocha": {
            "diff": "^8.0.3",
            "glob": "^13.0.6",
            "minimatch": "^10.2.6",
            "serialize-javascript": "^7.0.5"
        }
    },
    "pnpm": {
        "overrides": {
            "mocha>diff": "^8.0.3",
            "mocha>glob": "^13.0.6",
            "mocha>minimatch": "^10.2.6",
            "mocha>serialize-javascript": "^7.0.5"
        }
    }
}
