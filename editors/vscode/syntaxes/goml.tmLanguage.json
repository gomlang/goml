{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "GoML",
    "scopeName": "source.goml",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#attributes"
        },
        {
            "include": "#interpolated-strings"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#labels"
        },
        {
            "include": "#chars"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#declarations"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#namespaces"
        },
        {
            "include": "#associated-type-bindings"
        },
        {
            "include": "#types"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.goml",
                    "match": "//.*$"
                }
            ]
        },
        "attributes": {
            "patterns": [
                {
                    "name": "meta.attribute.goml",
                    "begin": "#!?\\[",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.attribute.begin.goml"
                        }
                    },
                    "end": "\\]",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.attribute.end.goml"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#quoted-strings"
                        },
                        {
                            "include": "#numbers"
                        },
                        {
                            "include": "#attribute-brackets"
                        },
                        {
                            "name": "entity.other.attribute-name.goml",
                            "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
                        }
                    ]
                }
            ]
        },
        "attribute-brackets": {
            "name": "meta.attribute.arguments.goml",
            "begin": "\\[",
            "end": "\\]",
            "patterns": [
                {
                    "include": "#quoted-strings"
                },
                {
                    "include": "#numbers"
                },
                {
                    "include": "#attribute-brackets"
                },
                {
                    "name": "entity.other.attribute-name.goml",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.raw.byte.goml",
                    "begin": "\\bbr(#{0,})\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.goml"
                        }
                    },
                    "end": "\"\\1",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.goml"
                        }
                    }
                },
                {
                    "name": "string.quoted.double.raw.goml",
                    "begin": "\\br(#{0,})\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.goml"
                        }
                    },
                    "end": "\"\\1",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.goml"
                        }
                    }
                },
                {
                    "name": "string.quoted.double.byte.goml",
                    "begin": "\\bb\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.goml"
                        }
                    },
                    "end": "\"|(?=$)",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.goml"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.goml",
                            "match": "\\\\([\"\\\\0bnfrt/]|x[a-fA-F0-9]{2})"
                        },
                        {
                            "name": "invalid.illegal.escape.goml",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.unquoted.multiline.goml",
                    "begin": "\\\\\\\\",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.goml"
                        }
                    },
                    "while": "^(\\s*)(\\\\\\\\)",
                    "whileCaptures": {
                        "2": {
                            "name": "punctuation.definition.string.begin.goml"
                        }
                    }
                },
                {
                    "include": "#quoted-strings"
                }
            ]
        },
        "interpolated-strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.interpolated.goml",
                    "begin": "\\bf\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.goml"
                        }
                    },
                    "end": "\"|(?=$)",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.goml"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.goml",
                            "match": "\\\\([\"\\\\bnfrt/]|u[a-fA-F0-9]{4})|\\{\\{|\\}\\}"
                        },
                        {
                            "name": "invalid.illegal.escape.goml",
                            "match": "\\\\."
                        },
                        {
                            "include": "#interpolation-expression"
                        }
                    ]
                }
            ]
        },
        "interpolation-expression": {
            "name": "meta.interpolation.goml",
            "begin": "\\{",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.section.embedded.begin.goml"
                }
            },
            "end": "(\\})",
            "endCaptures": {
                "1": {
                    "name": "punctuation.section.embedded.end.goml"
                }
            },
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "include": "#attributes"
                },
                {
                    "include": "#interpolated-strings"
                },
                {
                    "include": "#strings"
                },
                {
                    "include": "#labels"
                },
                {
                    "include": "#chars"
                },
                {
                    "include": "#numbers"
                },
                {
                    "include": "#declarations"
                },
                {
                    "include": "#keywords"
                },
                {
                    "include": "#namespaces"
                },
                {
                    "include": "#associated-type-bindings"
                },
                {
                    "include": "#types"
                },
                {
                    "include": "#functions"
                },
                {
                    "include": "#operators"
                },
                {
                    "include": "#nested-braces"
                }
            ]
        },
        "nested-braces": {
            "name": "meta.brace.block.goml",
            "begin": "\\{",
            "end": "\\}",
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "include": "#attributes"
                },
                {
                    "include": "#interpolated-strings"
                },
                {
                    "include": "#strings"
                },
                {
                    "include": "#labels"
                },
                {
                    "include": "#chars"
                },
                {
                    "include": "#numbers"
                },
                {
                    "include": "#declarations"
                },
                {
                    "include": "#keywords"
                },
                {
                    "include": "#namespaces"
                },
                {
                    "include": "#associated-type-bindings"
                },
                {
                    "include": "#types"
                },
                {
                    "include": "#functions"
                },
                {
                    "include": "#operators"
                },
                {
                    "include": "#nested-braces"
                }
            ]
        },
        "quoted-strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.goml",
                    "begin": "\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.goml"
                        }
                    },
                    "end": "\"|(?=$)",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.goml"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.goml",
                            "match": "\\\\([\"\\\\bnfrt/]|u[a-fA-F0-9]{4})"
                        },
                        {
                            "name": "invalid.illegal.escape.goml",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "labels": {
            "patterns": [
                {
                    "match": "(')([A-Za-z_][A-Za-z0-9_]*)(\\s*)(:)",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.label.goml"
                        },
                        "2": {
                            "name": "entity.name.label.goml"
                        },
                        "4": {
                            "name": "punctuation.separator.label.goml"
                        }
                    }
                },
                {
                    "match": "\\b(break|continue)(\\s+)(')([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.goml"
                        },
                        "3": {
                            "name": "punctuation.definition.label.goml"
                        },
                        "4": {
                            "name": "variable.other.label.goml"
                        }
                    }
                }
            ]
        },
        "chars": {
            "patterns": [
                {
                    "name": "string.quoted.single.byte.goml",
                    "begin": "\\bb'",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.goml"
                        }
                    },
                    "end": "'|(?=$)",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.goml"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.goml",
                            "match": "\\\\(['\\\\0bnfrt]|x[a-fA-F0-9]{2})"
                        },
                        {
                            "name": "invalid.illegal.escape.goml",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.goml",
                    "begin": "'",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.goml"
                        }
                    },
                    "end": "'|(?=$)",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.goml"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.goml",
                            "match": "\\\\(['\\\\bnfrt/]|u[a-fA-F0-9]{4})"
                        },
                        {
                            "name": "invalid.illegal.escape.goml",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.integer.hex.goml",
                    "match": "\\b0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*(?![A-Za-z0-9_])"
                },
                {
                    "name": "constant.numeric.integer.binary.goml",
                    "match": "\\b0[bB][01](?:_?[01])*(?![A-Za-z0-9_])"
                },
                {
                    "name": "constant.numeric.integer.octal.goml",
                    "match": "\\b0[oO][0-7](?:_?[0-7])*(?![A-Za-z0-9_])"
                },
                {
                    "name": "constant.numeric.float.goml",
                    "match": "\\b[0-9](?:_?[0-9])*\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?(?![A-Za-z0-9_])"
                },
                {
                    "name": "constant.numeric.float.goml",
                    "match": "\\b[0-9](?:_?[0-9])*[eE][+-]?[0-9](?:_?[0-9])*(?![A-Za-z0-9_])"
                },
                {
                    "name": "constant.numeric.integer.goml",
                    "match": "\\b[0-9](?:_?[0-9])*(?![A-Za-z0-9_])"
                }
            ]
        },
        "declarations": {
            "patterns": [
                {
                    "match": "\\b(?:(pub)(\\s+))?(use)\\b",
                    "captures": {
                        "1": {
                            "name": "storage.modifier.visibility.goml"
                        },
                        "3": {
                            "name": "keyword.control.import.goml"
                        }
                    }
                },
                {
                    "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.function.goml"
                        },
                        "2": {
                            "name": "entity.name.function.goml"
                        }
                    }
                },
                {
                    "match": "\\b(struct|enum|trait|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.type.goml"
                        },
                        "2": {
                            "name": "entity.name.type.goml"
                        }
                    }
                },
                {
                    "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.goml"
                        },
                        "2": {
                            "name": "constant.other.goml"
                        }
                    }
                },
                {
                    "match": "\\b(static)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.goml"
                        },
                        "2": {
                            "name": "variable.other.goml"
                        }
                    }
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.concurrency.goml",
                    "match": "\\b(scope)(?=\\s*\\{)|\\b(spawn)(?=\\s*\\|)|\\b(select)(?=\\s+(?:priority\\s+)?\\{)|\\b(priority)(?=\\s*\\{)"
                },
                {
                    "name": "keyword.control.concurrency.goml",
                    "match": "\\b(recv)(?=\\s*\\([^\\r\\n]*\\)\\s*(?:when\\s+[^\\r\\n]+?\\s+)?(?:as\\s+(?:[A-Za-z_][A-Za-z0-9_]*|_)\\s*=>|match\\s*\\{))|\\b(send)(?=\\s*\\([^\\r\\n]*\\)\\s*(?:when\\s+[^\\r\\n]+?\\s+)?=>)|\\b(when)(?=[^\\r\\n]*(?:as\\s+(?:[A-Za-z_][A-Za-z0-9_]*|_)\\s*=>|match\\s*\\{|=>))|\\b(as)(?=\\s+(?:[A-Za-z_][A-Za-z0-9_]*|_)\\s*=>)|\\b(match)(?=\\s*\\{)|\\b(default)(?=\\s*=>)"
                },
                {
                    "name": "keyword.control.comptime.goml",
                    "match": "\\b(comptime)(?=\\s*\\{)"
                },
                {
                    "name": "keyword.control.goml",
                    "match": "\\b(if|else|match|while|loop|for|in|return|break|continue|go|defer)\\b"
                },
                {
                    "name": "keyword.declaration.goml",
                    "match": "\\b(fn|let|struct|enum|trait|impl|type|const|static|use|package|extern)\\b"
                },
                {
                    "name": "storage.modifier.dyn.goml",
                    "match": "\\bdyn\\b"
                },
                {
                    "name": "storage.modifier.goml",
                    "match": "\\b(mut|pub)\\b"
                },
                {
                    "name": "keyword.other.goml",
                    "match": "\\b(as|where)\\b"
                },
                {
                    "name": "constant.language.boolean.goml",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "variable.language.self.goml",
                    "match": "\\bSelf\\b"
                },
                {
                    "name": "variable.language.wildcard.goml",
                    "match": "(?<![A-Za-z0-9_])_(?![A-Za-z0-9_])"
                }
            ]
        },
        "associated-type-bindings": {
            "patterns": [
                {
                    "name": "entity.name.type.associated.goml",
                    "match": "\\b[A-Z][A-Za-z0-9_]*(?=\\s*=)"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.primitive.goml",
                    "match": "\\b(bool|isize|i8|i16|i32|i64|usize|u8|u16|u32|u64|f32|f64|string|char|byte|never)\\b"
                },
                {
                    "name": "entity.name.type.goml",
                    "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
                }
            ]
        },
        "namespaces": {
            "patterns": [
                {
                    "name": "entity.name.namespace.goml",
                    "match": "\\b[a-z_][A-Za-z0-9_]*(?=::(?!\\s*\\[))"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.goml",
                    "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*(?:::\\s*\\[|\\())"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.goml",
                    "match": "(\\.\\.=|<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|\\.\\.|->|=>|::|<<|>>|==|!=|<=|>=|&&|\\|\\||\\+|-|\\*|/|%|<|>|=|!|&|\\||\\^|~|\\?|@|\\.)"
                }
            ]
        }
    }
}
