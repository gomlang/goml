package scanner_diff;

use gomlgo::differential;
use gomlgo::scanner;
use gomlgo::token;
use std::collections;
use std::fs;
use std::path;

pub struct Summary {
    pub files: isize,
    pub tokens: isize,
}

fn collect_go_files(directory: string, files: Vec[string]) -> Result[(), string] {
    let names = fs::read_dir(directory).map_err(|error| error.to_string())?;
    collections::sort(names);
    for name in names {
        let entry = path::join(directory, name);
        if fs::is_dir(entry) {
            collect_go_files(entry, files)?
        } else if fs::is_file(entry) && path::extension(entry) == Option::Some("go") {
            files.push(entry)
        }
    }
    Result::Ok(())
}

fn render_actual(value: token::Token) -> string {
    token::name(value.kind)
        + f" literal={value.literal} range={value.start}..{value.end} synthetic={value.synthetic}"
}

fn render_expected(value: differential::OracleToken) -> string {
    f"{value.kind} literal={value.literal} range={value.start}..{value.end} synthetic={value.synthetic}"
}

fn compare_file(file: string) -> Result[isize, string] {
    let source = fs::read_bytes_structured(file).map_err(|error| error.to_string())?;
    let actual = scanner::scan_bytes(source);
    let expected = differential::run_oracle("scan", source)?;
    let shared = if actual.tokens.len() < expected.tokens.len() {
        actual.tokens.len()
    } else {
        expected.tokens.len()
    };
    for index in 0..shared {
        let actual_token = actual.tokens[index];
        let expected_token = expected.tokens[index];
        if token::name(actual_token.kind) != expected_token.kind
            || actual_token.literal != expected_token.literal
            || actual_token.start != expected_token.start
            || actual_token.end != expected_token.end
            || actual_token.synthetic != expected_token.synthetic {
            return Result::Err(
                f"{file}: token {index} mismatch\nactual: " + render_actual(actual_token)
                    + "\nexpected: "
                    + render_expected(expected_token),
            )
        }
    }
    if actual.tokens.len() != expected.tokens.len() {
        Result::Err(
            f"{file}: token count mismatch: actual {actual.tokens.len()}, expected {expected.tokens.len()}",
        )
    } else {
        Result::Ok(actual.tokens.len())
    }
}

pub fn compare_tree(root: string) -> Result[Summary, string] {
    let files: Vec[string] = Vec::new();
    if fs::is_file(root) {
        files.push(root)
    } else {
        collect_go_files(root, files)?
    }
    let mut token_count = 0;
    for file in files {
        token_count += compare_file(file)?;
    }
    Result::Ok(Summary { files: files.len(), tokens: token_count })
}
