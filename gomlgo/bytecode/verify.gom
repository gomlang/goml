package bytecode;

use gomlgo::types as go_types;
use std::collections;

struct SignatureShape {
    receiver: Option[go_types::TypeId],
    parameters: Vec[go_types::TypeId],
    results: Vec[go_types::TypeId],
    variadic: bool,
}

fn int_slots(count: isize, value: isize) -> Vec[isize] {
    let result: Vec[isize] = Vec::with_capacity(count);
    for _ in 0..count {
        result.push(value)
    }
    result
}

fn report(
    diagnostics: Vec[VerifyDiagnostic],
    function: Option[FunctionId],
    block: Option[BlockId],
    instruction: isize,
    message: string,
) -> () {
    diagnostics.push(VerifyDiagnostic { function, block, instruction, message })
}

fn valid_type(program: BytecodeProgram, type_id: go_types::TypeId) -> bool {
    type_id.value >= 0 && type_id.value < program.world.types.len()
}

fn type_contains_parameter_inner(
    program: BytecodeProgram,
    type_id: go_types::TypeId,
    marks: Vec[isize],
    generation: isize,
) -> bool {
    if !valid_type(program, type_id) || marks[type_id.value] == generation {
        return false
    }
    marks[type_id.value] = generation;
    match go_types::type_data(program.world, type_id) {
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::TypeParam { object: _, constraint: _, index: _ },
        } => true,
        go_types::TypeData { id: _, kind: go_types::TypeKind::Array { length: _, element } } | go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Slice { element } | go_types::TypeKind::Pointer { element } | go_types::TypeKind::Chan {
                direction: _,
                element,
            },
        } => type_contains_parameter_inner(program, element, marks, generation),
        go_types::TypeData { id: _, kind: go_types::TypeKind::Struct { fields } } => {
            for field in fields {
                if type_contains_parameter_inner(program, field.variable.type_id, marks, generation) {
                    return true
                }
            }
            false
        },
        go_types::TypeData { id: _, kind: go_types::TypeKind::Tuple { variables } } => {
            for variable in variables {
                if type_contains_parameter_inner(program, variable.type_id, marks, generation) {
                    return true
                }
            }
            false
        },
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver,
                receiver_type_params,
                type_params,
                params,
                results,
                variadic: _,
            },
        } => {
            if !receiver_type_params.is_empty() || !type_params.is_empty() {
                return true
            }
            match receiver {
                Some(value) => if type_contains_parameter_inner(
                    program,
                    value.type_id,
                    marks,
                    generation,
                ) {
                    return true
                },
                None => {},
            }
            type_contains_parameter_inner(program, params, marks, generation)
                || type_contains_parameter_inner(program, results, marks, generation)
        },
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Interface { methods, embeddeds, comparable: _, implicit: _ },
        } => {
            for method in methods {
                if valid_object(program, method)
                    && type_contains_parameter_inner(
                        program,
                        program.world.objects[method.value].type_id,
                        marks,
                        generation,
                    ) {
                    return true
                }
            }
            for embedded in embeddeds {
                if type_contains_parameter_inner(program, embedded, marks, generation) {
                    return true
                }
            }
            false
        },
        go_types::TypeData { id: _, kind: go_types::TypeKind::Map { key, value } } => {
            type_contains_parameter_inner(program, key, marks, generation)
                || type_contains_parameter_inner(program, value, marks, generation)
        },
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object: _,
                underlying,
                type_params,
                type_args,
                methods: _,
            },
        } => {
            if !type_params.is_empty() && type_args.is_empty() {
                return true
            }
            for argument in type_args {
                if type_contains_parameter_inner(program, argument, marks, generation) {
                    return true
                }
            }
            type_contains_parameter_inner(program, underlying, marks, generation)
        },
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Alias { object: _, rhs, type_params, type_args },
        } => {
            if !type_params.is_empty() && type_args.is_empty() {
                return true
            }
            for argument in type_args {
                if type_contains_parameter_inner(program, argument, marks, generation) {
                    return true
                }
            }
            type_contains_parameter_inner(program, rhs, marks, generation)
        },
        go_types::TypeData { id: _, kind: go_types::TypeKind::Union { terms } } => {
            for term in terms {
                if type_contains_parameter_inner(program, term.type_id, marks, generation) {
                    return true
                }
            }
            false
        },
        _ => false,
    }
}

fn type_contains_parameter(
    program: BytecodeProgram,
    type_id: go_types::TypeId,
    cache: Vec[isize],
    marks: Vec[isize],
    next_generation: Ref[isize],
) -> bool {
    if !valid_type(program, type_id) {
        return false
    }
    let cached = cache[type_id.value];
    if cached >= 0 {
        cached == 1
    } else {
        let generation = next_generation.get() + 1;
        next_generation.set(generation);
        let result = type_contains_parameter_inner(program, type_id, marks, generation);
        cache[type_id.value] = if result {
            1
        } else {
            0
        };
        result
    }
}

fn valid_object(program: BytecodeProgram, object: go_types::ObjectId) -> bool {
    object.value >= 0 && object.value < program.world.objects.len()
}

fn valid_package(program: BytecodeProgram, package_id: go_types::PackageId) -> bool {
    package_id.value >= 0 && package_id.value < program.world.packages.len()
}

fn register_valid(function: BytecodeFunction, register: RegisterId) -> bool {
    register.value >= 0 && register.value < function.register_types.len()
}

fn place_valid(function: BytecodeFunction, place: PlaceId) -> bool {
    place.value >= 0 && place.value < function.place_count
}

fn local_valid(function: BytecodeFunction, local: LocalId) -> bool {
    local.value >= 0 && local.value < function.locals.len()
}

fn function_valid(program: BytecodeProgram, function: FunctionId) -> bool {
    function.value >= 0 && function.value < program.functions.len()
}

fn global_valid(program: BytecodeProgram, global: GlobalId) -> bool {
    global.value >= 0 && global.value < program.globals.len()
}

fn native_call_valid(program: BytecodeProgram, call: NativeCallId) -> bool {
    call.value >= 0 && call.value < program.native_calls.len()
}

fn check_register(
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    block: BlockId,
    instruction: isize,
    register: RegisterId,
) -> () {
    if !register_valid(function, register) {
        report(
            diagnostics,
            Option::Some(function.id),
            Option::Some(block),
            instruction,
            f"invalid register {register.value}",
        )
    }
}

fn check_registers(
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    block: BlockId,
    instruction: isize,
    registers: Vec[RegisterId],
) -> () {
    for register in registers {
        check_register(function, diagnostics, block, instruction, register)
    }
}

fn check_optional_register(
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    block: BlockId,
    instruction: isize,
    register: Option[RegisterId],
) -> () {
    if let Some(value) = register {
        check_register(function, diagnostics, block, instruction, value)
    }
}

fn check_place(
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    block: BlockId,
    instruction: isize,
    place: PlaceId,
) -> () {
    if !place_valid(function, place) {
        report(
            diagnostics,
            Option::Some(function.id),
            Option::Some(block),
            instruction,
            f"invalid place {place.value}",
        )
    }
}

fn check_local(
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    block: BlockId,
    instruction: isize,
    local: LocalId,
) -> () {
    if !local_valid(function, local) {
        report(
            diagnostics,
            Option::Some(function.id),
            Option::Some(block),
            instruction,
            f"invalid local {local.value}",
        )
    }
}

fn check_locals(
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    block: BlockId,
    instruction: isize,
    locals: Vec[LocalId],
) -> () {
    for local in locals {
        check_local(function, diagnostics, block, instruction, local)
    }
}

fn verified_register_type(function: BytecodeFunction, register: RegisterId) -> Option[
    go_types::TypeId,
] {
    if register_valid(function, register) {
        Option::Some(function.register_types[register.value])
    } else {
        Option::None
    }
}

fn verified_tuple_types(program: BytecodeProgram, type_id: go_types::TypeId) -> Option[
    Vec[go_types::TypeId],
] {
    match go_types::type_data(program.world, type_id) {
        go_types::TypeData { id: _, kind: go_types::TypeKind::Tuple { variables } } => {
            let result: Vec[go_types::TypeId] = Vec::with_capacity(variables.len());
            for variable in variables {
                result.push(variable.type_id)
            }
            Option::Some(result)
        },
        _ => Option::None,
    }
}

fn verified_signature_shape(program: BytecodeProgram, type_id: go_types::TypeId) -> Option[
    SignatureShape,
] {
    match go_types::type_data(program.world, go_types::underlying(program.world, type_id)) {
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver,
                receiver_type_params: _,
                type_params: _,
                params,
                results,
                variadic,
            },
        } => match (verified_tuple_types(program, params), verified_tuple_types(program, results)) {
            (Some(parameters), Some(results)) => Option::Some(
                SignatureShape {
                    receiver: receiver.map(|value| value.type_id),
                    parameters,
                    results,
                    variadic,
                },
            ),
            _ => Option::None,
        },
        _ => Option::None,
    }
}

fn verified_map_types(program: BytecodeProgram, type_id: go_types::TypeId) -> Option[
    (go_types::TypeId, go_types::TypeId),
] {
    match go_types::type_data(program.world, go_types::underlying(program.world, type_id)) {
        go_types::TypeData { id: _, kind: go_types::TypeKind::Map { key, value } } => {
            Option::Some((key, value))
        },
        _ => Option::None,
    }
}

fn verified_pointer_element(program: BytecodeProgram, type_id: go_types::TypeId) -> Option[
    go_types::TypeId,
] {
    match go_types::type_data(program.world, go_types::underlying(program.world, type_id)) {
        go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } } => {
            Option::Some(element)
        },
        _ => Option::None,
    }
}

fn verified_bool_type(program: BytecodeProgram, type_id: go_types::TypeId) -> bool {
    match go_types::basic_kind(program.world, type_id) {
        Some(go_types::BasicKind::Bool | go_types::BasicKind::UntypedBool) => true,
        _ => false,
    }
}

fn check_register_type(
    program: BytecodeProgram,
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    block: BlockId,
    instruction: isize,
    register: RegisterId,
    expected: go_types::TypeId,
    message: string,
) -> () {
    match verified_register_type(function, register) {
        Some(actual) => if !go_types::identical(program.world, actual, expected) {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::Some(block),
                instruction,
                message,
            )
        },
        None => {},
    }
}

fn check_bool_register(
    program: BytecodeProgram,
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    block: BlockId,
    instruction: isize,
    register: RegisterId,
    message: string,
) -> () {
    match verified_register_type(function, register) {
        Some(type_id) => if !verified_bool_type(program, type_id) {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::Some(block),
                instruction,
                message,
            )
        },
        None => {},
    }
}

fn check_integer_register(
    program: BytecodeProgram,
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    block: BlockId,
    instruction: isize,
    register: RegisterId,
    message: string,
) -> () {
    match verified_register_type(function, register) {
        Some(type_id) => if !go_types::is_integer(program.world, type_id) {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::Some(block),
                instruction,
                message,
            )
        },
        None => {},
    }
}

fn check_optional_bool_register(
    program: BytecodeProgram,
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    block: BlockId,
    instruction: isize,
    register: Option[RegisterId],
    message: string,
) -> () {
    match register {
        Some(value) => check_bool_register(
            program,
            function,
            diagnostics,
            block,
            instruction,
            value,
            message,
        ),
        None => {},
    }
}

fn checked_map_register(
    program: BytecodeProgram,
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    block: BlockId,
    instruction: isize,
    register: RegisterId,
) -> Option[(go_types::TypeId, go_types::TypeId)] {
    match verified_register_type(function, register) {
        Some(type_id) => match verified_map_types(program, type_id) {
            Some(value) => Option::Some(value),
            None => {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    "map instruction source is not map typed",
                );
                Option::None
            },
        },
        None => Option::None,
    }
}

fn check_call_target(
    program: BytecodeProgram,
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    block: BlockId,
    instruction: isize,
    target: CallTarget,
) -> () {
    match target {
        CallTarget::Static(value) => if !function_valid(program, value) {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::Some(block),
                instruction,
                f"invalid function {value.value}",
            )
        },
        CallTarget::Method { function: value, receiver } => {
            if !function_valid(program, value) {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    f"invalid method function {value.value}",
                )
            }
            check_register(function, diagnostics, block, instruction, receiver)
        },
        CallTarget::InterfaceMethod { method, receiver } => {
            if !valid_object(program, method) {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    f"invalid interface method {method.value}",
                )
            }
            check_register(function, diagnostics, block, instruction, receiver)
        },
        CallTarget::Dynamic(value) => {
            check_register(function, diagnostics, block, instruction, value)
        },
        CallTarget::Native(value) => if !native_call_valid(program, value) {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::Some(block),
                instruction,
                f"invalid native call {value.value}",
            )
        },
        CallTarget::NativeMethod { call, receiver } => {
            if !native_call_valid(program, call) {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    f"invalid native method {call.value}",
                )
            }
            check_register(function, diagnostics, block, instruction, receiver)
        },
        CallTarget::Builtin(_) => {},
    }
}

fn verified_slice_element(program: BytecodeProgram, type_id: go_types::TypeId) -> Option[
    go_types::TypeId,
] {
    match go_types::type_data(program.world, go_types::underlying(program.world, type_id)) {
        go_types::TypeData { id: _, kind: go_types::TypeKind::Slice { element } } => {
            Option::Some(element)
        },
        _ => Option::None,
    }
}

fn verified_channel_element(program: BytecodeProgram, type_id: go_types::TypeId) -> Option[
    go_types::TypeId,
] {
    match go_types::type_data(program.world, go_types::underlying(program.world, type_id)) {
        go_types::TypeData { id: _, kind: go_types::TypeKind::Chan { direction: _, element } } => Option::Some(
            element,
        ),
        _ => Option::None,
    }
}

fn verified_channel_type(program: BytecodeProgram, type_id: go_types::TypeId) -> Option[
    (isize, go_types::TypeId),
] {
    match go_types::type_data(program.world, go_types::underlying(program.world, type_id)) {
        go_types::TypeData { id: _, kind: go_types::TypeKind::Chan { direction, element } } => Option::Some(
            (direction, element),
        ),
        _ => Option::None,
    }
}

fn checked_channel_register(
    program: BytecodeProgram,
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    block: BlockId,
    instruction: isize,
    register: RegisterId,
) -> Option[(isize, go_types::TypeId)] {
    match verified_register_type(function, register) {
        Some(type_id) => match verified_channel_type(program, type_id) {
            Some(value) => Option::Some(value),
            None => {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    "channel instruction source is not channel typed",
                );
                Option::None
            },
        },
        None => Option::None,
    }
}

fn check_channel_send(
    program: BytecodeProgram,
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    block: BlockId,
    instruction: isize,
    channel: RegisterId,
    value: RegisterId,
) -> () {
    match checked_channel_register(program, function, diagnostics, block, instruction, channel) {
        Some((direction, element)) => {
            if direction == 2 {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    "channel send source is receive-only",
                )
            }
            check_register_type(
                program,
                function,
                diagnostics,
                block,
                instruction,
                value,
                element,
                "channel send value type does not match channel element type",
            )
        },
        None => {},
    }
}

fn check_channel_receive(
    program: BytecodeProgram,
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    block: BlockId,
    instruction: isize,
    channel: RegisterId,
    value: RegisterId,
    ok: Option[RegisterId],
) -> () {
    match checked_channel_register(program, function, diagnostics, block, instruction, channel) {
        Some((direction, element)) => {
            if direction == 1 {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    "channel receive source is send-only",
                )
            }
            check_register_type(
                program,
                function,
                diagnostics,
                block,
                instruction,
                value,
                element,
                "channel receive value type does not match channel element type",
            )
        },
        None => {},
    }
    check_optional_bool_register(
        program,
        function,
        diagnostics,
        block,
        instruction,
        ok,
        "channel receive ok register is not bool typed",
    )
}

fn function_local_types(function: BytecodeFunction, locals: Vec[LocalId], start: isize) -> Vec[
    go_types::TypeId,
] {
    let result: Vec[go_types::TypeId] = Vec::new();
    for index in start..locals.len() {
        let local = locals[index];
        if local_valid(function, local) {
            result.push(function.locals[local.value].type_id)
        }
    }
    result
}

fn check_call_arguments(
    program: BytecodeProgram,
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    block: BlockId,
    instruction: isize,
    arguments: Vec[RegisterId],
    parameters: Vec[go_types::TypeId],
    variadic: bool,
    target_name: string,
) -> () {
    let fixed = if variadic && !parameters.is_empty() {
        parameters.len() - 1
    } else {
        parameters.len()
    };
    if (!variadic && arguments.len() != parameters.len()) || (variadic && arguments.len() < fixed) {
        report(
            diagnostics,
            Option::Some(function.id),
            Option::Some(block),
            instruction,
            f"call to {target_name} in {function.name} has {arguments.len()} arguments, expected {parameters.len()}",
        );
        return
    }
    for index in 0..fixed {
        if index < arguments.len() {
            check_register_type(
                program,
                function,
                diagnostics,
                block,
                instruction,
                arguments[index],
                parameters[index],
                "call argument type does not match target signature",
            )
        }
    }
    if !variadic {
        return
    }
    let slice_type = parameters[parameters.len() - 1];
    if arguments.len() == parameters.len() {
        match verified_register_type(function, arguments[arguments.len() - 1]) {
            Some(actual) => if go_types::identical(program.world, actual, slice_type) {
                return
            },
            None => return,
        }
    }
    match verified_slice_element(program, slice_type) {
        Some(element) => for index in fixed..arguments.len() {
            check_register_type(
                program,
                function,
                diagnostics,
                block,
                instruction,
                arguments[index],
                element,
                "variadic call argument type does not match target signature",
            )
        },
        None => report(
            diagnostics,
            Option::Some(function.id),
            Option::Some(block),
            instruction,
            "variadic target has a non-slice final parameter",
        ),
    }
}

fn check_call_results(
    program: BytecodeProgram,
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    block: BlockId,
    instruction: isize,
    results: Vec[RegisterId],
    expected: Vec[go_types::TypeId],
    target_name: string,
) -> () {
    if results.len() != expected.len() {
        report(
            diagnostics,
            Option::Some(function.id),
            Option::Some(block),
            instruction,
            "call result count does not match target signature",
        );
        return
    }
    for index in 0..results.len() {
        match verified_register_type(function, results[index]) {
            Some(actual) => if !go_types::identical(program.world, actual, expected[index]) {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    f"call to {target_name} in {function.name} result {index} has type "
                        + go_types::format_type(program.world, actual)
                        + ", expected "
                        + go_types::format_type(program.world, expected[index]),
                )
            },
            None => {},
        }
    }
}

fn interface_has_method(
    program: BytecodeProgram,
    interface_type: go_types::TypeId,
    method: go_types::ObjectId,
) -> bool {
    if !valid_object(program, method) {
        return false
    }
    let expected = program.world.objects[method.value];
    for candidate in go_types::interface_methods(program.world, interface_type) {
        if valid_object(program, candidate) {
            let value = program.world.objects[candidate.value];
            if go_types::method_name_identical(
                value.name,
                value.owner,
                expected.name,
                expected.owner,
            )
                && go_types::identical(program.world, value.type_id, expected.type_id) {
                return true
            }
        }
    }
    false
}

fn check_call_shape(
    program: BytecodeProgram,
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    block: BlockId,
    instruction: isize,
    target: CallTarget,
    arguments: Vec[RegisterId],
    results: Option[Vec[RegisterId]],
) -> () {
    let mut shape: Option[SignatureShape] = Option::None;
    let mut parameters: Option[Vec[go_types::TypeId]] = Option::None;
    let mut expected_results: Option[Vec[go_types::TypeId]] = Option::None;
    let target_name = match target {
        CallTarget::Static(value) | CallTarget::Method { function: value, receiver: _ } => if function_valid(
            program,
            value,
        ) {
            program.functions[value.value].name
        } else {
            "invalid"
        },
        CallTarget::InterfaceMethod { method, receiver: _ } => if valid_object(program, method) {
            program.world.objects[method.value].name
        } else {
            "invalid"
        },
        CallTarget::Dynamic(_) => "dynamic",
        CallTarget::Native(value) | CallTarget::NativeMethod { call: value, receiver: _ } => if native_call_valid(
            program,
            value,
        ) {
            program.native_calls[value.value].import_path + "."
                + program.native_calls[value.value].symbol
        } else {
            "invalid"
        },
        CallTarget::Builtin(_) => "builtin",
    };
    match target {
        CallTarget::Static(target_function) => if function_valid(program, target_function) {
            let value = program.functions[target_function.value];
            parameters = Option::Some(function_local_types(value, value.parameters, 0));
            expected_results = Option::Some(function_local_types(value, value.results, 0));
            shape = verified_signature_shape(program, value.signature);
        },
        CallTarget::Method { function: target_function, receiver } => if function_valid(
            program,
            target_function,
        ) {
            let value = program.functions[target_function.value];
            let local_types = function_local_types(value, value.parameters, 0);
            if local_types.is_empty() {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    "method target has no receiver parameter",
                )
            } else {
                check_register_type(
                    program,
                    function,
                    diagnostics,
                    block,
                    instruction,
                    receiver,
                    local_types[0],
                    "method receiver type does not match target signature",
                );
                let remaining: Vec[go_types::TypeId] = Vec::new();
                for index in 1..local_types.len() {
                    remaining.push(local_types[index])
                }
                parameters = Option::Some(remaining);
            }
            expected_results = Option::Some(function_local_types(value, value.results, 0));
            shape = verified_signature_shape(program, value.signature);
        },
        CallTarget::InterfaceMethod { method, receiver } => {
            match verified_register_type(function, receiver) {
                Some(receiver_type) => if !go_types::is_interface(program.world, receiver_type) {
                    report(
                        diagnostics,
                        Option::Some(function.id),
                        Option::Some(block),
                        instruction,
                        "interface method receiver is not interface typed",
                    )
                } else if !interface_has_method(program, receiver_type, method) {
                    report(
                        diagnostics,
                        Option::Some(function.id),
                        Option::Some(block),
                        instruction,
                        "interface method does not belong to receiver interface",
                    )
                },
                None => {},
            }
            if valid_object(program, method) {
                shape = verified_signature_shape(
                    program,
                    program.world.objects[method.value].type_id,
                );
            }
        },
        CallTarget::Dynamic(target) => match verified_register_type(function, target) {
            Some(type_id) => {
                shape = verified_signature_shape(program, type_id);
                if shape.is_none() {
                    report(
                        diagnostics,
                        Option::Some(function.id),
                        Option::Some(block),
                        instruction,
                        f"dynamic call target is not function typed: register {target.value} has type "
                            + go_types::format_type(program.world, type_id)
                            + f" ({type_id.value})",
                    )
                }
            },
            None => {},
        },
        CallTarget::Native(call) => if native_call_valid(program, call) {
            let value = program.native_calls[call.value];
            parameters = Option::Some(value.parameter_types);
            expected_results = Option::Some(value.result_types);
            shape = Option::Some(
                SignatureShape {
                    receiver: Option::None,
                    parameters: value.parameter_types,
                    results: value.result_types,
                    variadic: value.variadic,
                },
            );
        },
        CallTarget::NativeMethod { call, receiver } => if native_call_valid(program, call) {
            let value = program.native_calls[call.value];
            if value.parameter_types.is_empty() {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    "native method has no receiver parameter",
                )
            } else {
                check_register_type(
                    program,
                    function,
                    diagnostics,
                    block,
                    instruction,
                    receiver,
                    value.parameter_types[0],
                    "native method receiver type does not match target signature",
                );
                let remaining: Vec[go_types::TypeId] = Vec::new();
                for index in 1..value.parameter_types.len() {
                    remaining.push(value.parameter_types[index])
                }
                parameters = Option::Some(remaining);
                expected_results = Option::Some(value.result_types);
                shape = Option::Some(
                    SignatureShape {
                        receiver: Option::Some(value.parameter_types[0]),
                        parameters: remaining,
                        results: value.result_types,
                        variadic: value.variadic,
                    },
                );
            };
        },
        CallTarget::Builtin(_) => {},
    }
    match shape {
        Some(value) => {
            if parameters.is_none() {
                parameters = Option::Some(value.parameters);
            }
            if expected_results.is_none() {
                expected_results = Option::Some(value.results);
            }
            match parameters {
                Some(values) => check_call_arguments(
                    program,
                    function,
                    diagnostics,
                    block,
                    instruction,
                    arguments,
                    values,
                    value.variadic,
                    target_name,
                ),
                None => {},
            }
            match (results, expected_results) {
                (Some(actual), Some(expected)) => check_call_results(
                    program,
                    function,
                    diagnostics,
                    block,
                    instruction,
                    actual,
                    expected,
                    target_name,
                ),
                _ => {},
            }
        },
        None => {},
    }
}

fn check_location(
    program: BytecodeProgram,
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    block: BlockId,
    instruction: isize,
    location: CodeLocation,
) -> () {
    if location.file.value < -1 {
        report(
            diagnostics,
            Option::Some(function.id),
            Option::Some(block),
            instruction,
            f"invalid source file {location.file.value}",
        )
    } else if location.file.value >= 0 {
        let mut found = false;
        for source in program.source_files {
            if source.package_id.value == function.package_id.value
                && source.file.value == location.file.value {
                found = true;
            }
        }
        if !found {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::Some(block),
                instruction,
                "source location refers to an unknown package-local file",
            )
        }
    }
    if location.start < -1 || location.end < location.start {
        report(
            diagnostics,
            Option::Some(function.id),
            Option::Some(block),
            instruction,
            "invalid source span",
        )
    }
}

fn check_target_type(
    program: BytecodeProgram,
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    block: BlockId,
    instruction: isize,
    target: RegisterId,
    type_id: go_types::TypeId,
) -> () {
    check_register(function, diagnostics, block, instruction, target);
    if !valid_type(program, type_id) {
        report(
            diagnostics,
            Option::Some(function.id),
            Option::Some(block),
            instruction,
            f"invalid type {type_id.value}",
        )
    } else if register_valid(function, target)
        && !go_types::identical(program.world, function.register_types[target.value], type_id) {
        report(
            diagnostics,
            Option::Some(function.id),
            Option::Some(block),
            instruction,
            "target register type does not match instruction type",
        )
    }
}

fn check_instruction(
    program: BytecodeProgram,
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    block: BlockId,
    instruction: isize,
    value: Instruction,
) -> () {
    check_location(program, function, diagnostics, block, instruction, value.location);
    match value.kind {
        InstructionKind::Constant { target, type_id, constant_kind: _, exact: _ } => {
            check_target_type(program, function, diagnostics, block, instruction, target, type_id)
        },
        InstructionKind::Zero { target, type_id } => {
            check_target_type(program, function, diagnostics, block, instruction, target, type_id)
        },
        InstructionKind::Move { target, source } | InstructionKind::Copy { target, source } => {
            check_register(function, diagnostics, block, instruction, target);
            check_register(function, diagnostics, block, instruction, source);
            if register_valid(function, target) && register_valid(function, source)
                && !go_types::identical(
                    program.world,
                    function.register_types[target.value],
                    function.register_types[source.value],
                ) {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    "move register types do not match",
                )
            }
        },
        InstructionKind::LocalPlace { target, local } => {
            check_place(function, diagnostics, block, instruction, target);
            check_local(function, diagnostics, block, instruction, local)
        },
        InstructionKind::GlobalPlace { target, global } => {
            check_place(function, diagnostics, block, instruction, target);
            if !global_valid(program, global) {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    f"invalid global {global.value}",
                )
            }
        },
        InstructionKind::NativeGlobalLoad { target, object } => {
            check_register(function, diagnostics, block, instruction, target);
            if !valid_object(program, object) {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    "invalid native global object",
                )
            } else {
                let value = program.world.objects[object.value];
                if value.kind != go_types::ObjectKind::Var || !register_valid(function, target)
                    || !go_types::identical(
                        program.world,
                        value.type_id,
                        function.register_types[target.value],
                    ) {
                    report(
                        diagnostics,
                        Option::Some(function.id),
                        Option::Some(block),
                        instruction,
                        "native global load type is inconsistent",
                    )
                }
            }
        },
        InstructionKind::FieldPlace { target, base, index } => {
            check_place(function, diagnostics, block, instruction, target);
            check_place(function, diagnostics, block, instruction, base);
            if index.is_empty() {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    "field path is empty",
                )
            } else {
                for field in index {
                    if field < 0 {
                        report(
                            diagnostics,
                            Option::Some(function.id),
                            Option::Some(block),
                            instruction,
                            "field path contains a negative index",
                        )
                    }
                }
            }
        },
        InstructionKind::IndexPlace { target, base, index } => {
            check_place(function, diagnostics, block, instruction, target);
            check_place(function, diagnostics, block, instruction, base);
            check_register(function, diagnostics, block, instruction, index)
        },
        InstructionKind::DereferencePlace { target, pointer } => {
            check_place(function, diagnostics, block, instruction, target);
            check_register(function, diagnostics, block, instruction, pointer)
        },
        InstructionKind::Load { target, source } => {
            check_register(function, diagnostics, block, instruction, target);
            check_place(function, diagnostics, block, instruction, source)
        },
        InstructionKind::Store { target, value } => {
            check_place(function, diagnostics, block, instruction, target);
            check_register(function, diagnostics, block, instruction, value)
        },
        InstructionKind::AddressOf { target, source } => {
            check_register(function, diagnostics, block, instruction, target);
            check_place(function, diagnostics, block, instruction, source)
        },
        InstructionKind::Unary { target, op: _, operand } => {
            check_register(function, diagnostics, block, instruction, target);
            check_register(function, diagnostics, block, instruction, operand)
        },
        InstructionKind::Binary { target, op: _, left, right } => {
            check_register(function, diagnostics, block, instruction, target);
            check_register(function, diagnostics, block, instruction, left);
            check_register(function, diagnostics, block, instruction, right)
        },
        InstructionKind::Convert { target, source, type_id } => {
            check_target_type(program, function, diagnostics, block, instruction, target, type_id);
            check_register(function, diagnostics, block, instruction, source)
        },
        InstructionKind::TypeAssert { target, ok, source, type_id } => {
            check_target_type(program, function, diagnostics, block, instruction, target, type_id);
            check_optional_register(function, diagnostics, block, instruction, ok);
            check_register(function, diagnostics, block, instruction, source);
            check_optional_bool_register(
                program,
                function,
                diagnostics,
                block,
                instruction,
                ok,
                "type assertion ok register is not bool typed",
            );
            match verified_register_type(function, source) {
                Some(source_type) => if !go_types::is_interface(program.world, source_type) {
                    report(
                        diagnostics,
                        Option::Some(function.id),
                        Option::Some(block),
                        instruction,
                        "type assertion source is not interface typed",
                    )
                } else if valid_type(program, type_id)
                    && !go_types::assertable_to(program.world, source_type, type_id) {
                    report(
                        diagnostics,
                        Option::Some(function.id),
                        Option::Some(block),
                        instruction,
                        "type assertion target is not assertable from source interface",
                    )
                },
                None => {},
            }
        },
        InstructionKind::MakeAggregate { target, type_id, elements, length } => {
            check_target_type(program, function, diagnostics, block, instruction, target, type_id);
            if length < 0 {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    "aggregate literal length is negative",
                )
            }
            for element in elements {
                if element.index < 0 {
                    report(
                        diagnostics,
                        Option::Some(function.id),
                        Option::Some(block),
                        instruction,
                        "aggregate literal index is negative",
                    )
                }
                check_register(function, diagnostics, block, instruction, element.value)
            }
        },
        InstructionKind::FieldValue { target, base, index } => {
            check_register(function, diagnostics, block, instruction, target);
            check_register(function, diagnostics, block, instruction, base);
            if index.is_empty() {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    "field path is empty",
                )
            }
        },
        InstructionKind::IndexValue { target, base, index, ok } => {
            check_register(function, diagnostics, block, instruction, target);
            check_register(function, diagnostics, block, instruction, base);
            check_register(function, diagnostics, block, instruction, index);
            check_optional_register(function, diagnostics, block, instruction, ok)
        },
        InstructionKind::DecodeRune { rune, width, source, offset } => {
            check_register(function, diagnostics, block, instruction, rune);
            check_register(function, diagnostics, block, instruction, width);
            check_register(function, diagnostics, block, instruction, source);
            check_register(function, diagnostics, block, instruction, offset)
        },
        InstructionKind::SliceValue { target, base, low, high, maximum } => {
            check_register(function, diagnostics, block, instruction, target);
            check_register(function, diagnostics, block, instruction, base);
            check_optional_register(function, diagnostics, block, instruction, low);
            check_optional_register(function, diagnostics, block, instruction, high);
            check_optional_register(function, diagnostics, block, instruction, maximum)
        },
        InstructionKind::SlicePlace { target, base, element_type, low, high, maximum } => {
            check_register(function, diagnostics, block, instruction, target);
            check_place(function, diagnostics, block, instruction, base);
            if !valid_type(program, element_type) {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    f"invalid slice element type {element_type.value}",
                )
            }
            check_optional_register(function, diagnostics, block, instruction, low);
            check_optional_register(function, diagnostics, block, instruction, high);
            check_optional_register(function, diagnostics, block, instruction, maximum)
        },
        InstructionKind::Allocate { target, type_id, value } => {
            check_register(function, diagnostics, block, instruction, target);
            if !valid_type(program, type_id) {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    f"invalid allocated type {type_id.value}",
                )
            }
            check_optional_register(function, diagnostics, block, instruction, value);
            match verified_register_type(function, target) {
                Some(target_type) => match verified_pointer_element(program, target_type) {
                    Some(element) => if valid_type(program, type_id)
                        && !go_types::identical(program.world, element, type_id) {
                        report(
                            diagnostics,
                            Option::Some(function.id),
                            Option::Some(block),
                            instruction,
                            "allocated pointer element does not match instruction type",
                        )
                    },
                    None => report(
                        diagnostics,
                        Option::Some(function.id),
                        Option::Some(block),
                        instruction,
                        "allocate target is not pointer typed",
                    ),
                },
                None => {},
            }
            match value {
                Some(source) => check_register_type(
                    program,
                    function,
                    diagnostics,
                    block,
                    instruction,
                    source,
                    type_id,
                    "allocated value type does not match instruction type",
                ),
                None => {},
            }
        },
        InstructionKind::MakeSlice { target, type_id, length, capacity } => {
            check_target_type(program, function, diagnostics, block, instruction, target, type_id);
            check_register(function, diagnostics, block, instruction, length);
            check_register(function, diagnostics, block, instruction, capacity);
            if verified_slice_element(program, type_id).is_none() {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    "make slice type is not slice typed",
                )
            }
            check_integer_register(
                program,
                function,
                diagnostics,
                block,
                instruction,
                length,
                "make slice length is not integer typed",
            );
            check_integer_register(
                program,
                function,
                diagnostics,
                block,
                instruction,
                capacity,
                "make slice capacity is not integer typed",
            )
        },
        InstructionKind::MakeMap { target, type_id, capacity } => {
            check_target_type(program, function, diagnostics, block, instruction, target, type_id);
            check_optional_register(function, diagnostics, block, instruction, capacity);
            if verified_map_types(program, type_id).is_none() {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    "make map type is not map typed",
                )
            }
            match capacity {
                Some(value) => check_integer_register(
                    program,
                    function,
                    diagnostics,
                    block,
                    instruction,
                    value,
                    "make map capacity is not integer typed",
                ),
                None => {},
            }
        },
        InstructionKind::MakeChannel { target, type_id, capacity } => {
            check_target_type(program, function, diagnostics, block, instruction, target, type_id);
            check_register(function, diagnostics, block, instruction, capacity);
            if verified_channel_element(program, type_id).is_none() {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    "make channel type is not channel typed",
                )
            }
            check_integer_register(
                program,
                function,
                diagnostics,
                block,
                instruction,
                capacity,
                "make channel capacity is not integer typed",
            )
        },
        InstructionKind::MakeClosure { target, function: target_function, captures } => {
            check_register(function, diagnostics, block, instruction, target);
            if !function_valid(program, target_function) {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    f"invalid closure function {target_function.value}",
                )
            } else {
                let target_value = program.functions[target_function.value];
                check_target_type(
                    program,
                    function,
                    diagnostics,
                    block,
                    instruction,
                    target,
                    target_value.signature,
                );
                if captures.len() != target_value.captures.len() {
                    report(
                        diagnostics,
                        Option::Some(function.id),
                        Option::Some(block),
                        instruction,
                        "closure capture count does not match target function",
                    )
                } else {
                    for index in 0..captures.len() {
                        if local_valid(function, captures[index])
                            && local_valid(target_value, target_value.captures[index])
                            && !go_types::identical(
                                program.world,
                                function.locals[captures[index].value].type_id,
                                target_value.locals[target_value.captures[index].value].type_id,
                            ) {
                            report(
                                diagnostics,
                                Option::Some(function.id),
                                Option::Some(block),
                                instruction,
                                "closure capture type does not match target function",
                            )
                        }
                    }
                }
            }
            check_locals(function, diagnostics, block, instruction, captures)
        },
        InstructionKind::MakeMethodValue { target, function: target_function, receiver } => {
            check_register(function, diagnostics, block, instruction, target);
            check_register(function, diagnostics, block, instruction, receiver);
            if !function_valid(program, target_function) {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    f"invalid method value function {target_function.value}",
                )
            }
        },
        InstructionKind::MakeMethodExpression {
            target,
            function: target_function,
            receiver_type,
            index: _,
        } => {
            check_register(function, diagnostics, block, instruction, target);
            if !function_valid(program, target_function) {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    f"invalid method expression function {target_function.value}",
                )
            }
            if !valid_type(program, receiver_type) {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    "invalid method expression receiver type",
                )
            }
        },
        InstructionKind::MakeInterfaceMethodValue { target, method, receiver } => {
            check_register(function, diagnostics, block, instruction, target);
            if let Some(value) = receiver {
                check_register(function, diagnostics, block, instruction, value)
            }
            if method.value < 0 || method.value >= program.world.objects.len() {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::Some(block),
                    instruction,
                    "invalid interface method object",
                )
            }
        },
        InstructionKind::RenewLocal { local } | InstructionKind::CloneLocal { local } => {
            check_local(function, diagnostics, block, instruction, local)
        },
        InstructionKind::Call { results, target, arguments, variadic: _ } => {
            check_registers(function, diagnostics, block, instruction, results);
            check_call_target(program, function, diagnostics, block, instruction, target);
            check_registers(function, diagnostics, block, instruction, arguments);
            check_call_shape(
                program,
                function,
                diagnostics,
                block,
                instruction,
                target,
                arguments,
                Option::Some(results),
            )
        },
        InstructionKind::Defer { target, arguments, variadic: _ } | InstructionKind::Spawn {
            target,
            arguments,
            variadic: _,
        } => {
            check_call_target(program, function, diagnostics, block, instruction, target);
            check_registers(function, diagnostics, block, instruction, arguments);
            check_call_shape(
                program,
                function,
                diagnostics,
                block,
                instruction,
                target,
                arguments,
                Option::None,
            )
        },
        InstructionKind::Panic { value } => {
            check_register(function, diagnostics, block, instruction, value)
        },
        InstructionKind::Recover { target } => {
            check_register(function, diagnostics, block, instruction, target);
            match verified_register_type(function, target) {
                Some(type_id) => if !go_types::is_interface(program.world, type_id) {
                    report(
                        diagnostics,
                        Option::Some(function.id),
                        Option::Some(block),
                        instruction,
                        "recover target is not interface typed",
                    )
                },
                None => {},
            }
        },
        InstructionKind::MapSet { map, key, value } => {
            check_register(function, diagnostics, block, instruction, map);
            check_register(function, diagnostics, block, instruction, key);
            check_register(function, diagnostics, block, instruction, value);
            match checked_map_register(program, function, diagnostics, block, instruction, map) {
                Some(types) => {
                    check_register_type(
                        program,
                        function,
                        diagnostics,
                        block,
                        instruction,
                        key,
                        types.0,
                        "map key register type does not match map type",
                    );
                    check_register_type(
                        program,
                        function,
                        diagnostics,
                        block,
                        instruction,
                        value,
                        types.1,
                        "map value register type does not match map type",
                    )
                },
                None => {},
            }
        },
        InstructionKind::MapDelete { map, key } => {
            check_register(function, diagnostics, block, instruction, map);
            check_register(function, diagnostics, block, instruction, key);
            match checked_map_register(program, function, diagnostics, block, instruction, map) {
                Some(types) => check_register_type(
                    program,
                    function,
                    diagnostics,
                    block,
                    instruction,
                    key,
                    types.0,
                    "map delete key type does not match map type",
                ),
                None => {},
            }
        },
        InstructionKind::MapIterInit { target, map } => {
            check_register(function, diagnostics, block, instruction, target);
            check_register(function, diagnostics, block, instruction, map);
            let _ = checked_map_register(program, function, diagnostics, block, instruction, map);
            check_integer_register(
                program,
                function,
                diagnostics,
                block,
                instruction,
                target,
                "map iterator register is not integer typed",
            )
        },
        InstructionKind::MapIterNext { key, value, ok, iterator } => {
            check_register(function, diagnostics, block, instruction, key);
            check_optional_register(function, diagnostics, block, instruction, value);
            check_register(function, diagnostics, block, instruction, ok);
            check_register(function, diagnostics, block, instruction, iterator);
            check_bool_register(
                program,
                function,
                diagnostics,
                block,
                instruction,
                ok,
                "map iterator ok register is not bool typed",
            );
            check_integer_register(
                program,
                function,
                diagnostics,
                block,
                instruction,
                iterator,
                "map iterator source is not integer typed",
            )
        },
        InstructionKind::Send { channel, value } => {
            check_register(function, diagnostics, block, instruction, channel);
            check_register(function, diagnostics, block, instruction, value);
            check_channel_send(program, function, diagnostics, block, instruction, channel, value)
        },
        InstructionKind::Receive { value, ok, channel } => {
            check_register(function, diagnostics, block, instruction, value);
            check_optional_register(function, diagnostics, block, instruction, ok);
            check_register(function, diagnostics, block, instruction, channel);
            check_channel_receive(
                program,
                function,
                diagnostics,
                block,
                instruction,
                channel,
                value,
                ok,
            )
        },
        InstructionKind::Close { channel } => {
            check_register(function, diagnostics, block, instruction, channel);
            match checked_channel_register(
                program,
                function,
                diagnostics,
                block,
                instruction,
                channel,
            ) {
                Some((direction, _)) => if direction == 2 {
                    report(
                        diagnostics,
                        Option::Some(function.id),
                        Option::Some(block),
                        instruction,
                        "channel close source is receive-only",
                    )
                },
                None => {},
            }
        },
        InstructionKind::Select { chosen, cases } => {
            check_register(function, diagnostics, block, instruction, chosen);
            check_integer_register(
                program,
                function,
                diagnostics,
                block,
                instruction,
                chosen,
                "select chosen register is not integer typed",
            );
            let mut default_seen = false;
            for case_value in cases {
                match case_value.operation {
                    SelectOperation::Send { channel, value } => {
                        check_register(function, diagnostics, block, instruction, channel);
                        check_register(function, diagnostics, block, instruction, value);
                        check_channel_send(
                            program,
                            function,
                            diagnostics,
                            block,
                            instruction,
                            channel,
                            value,
                        )
                    },
                    SelectOperation::Receive { channel, value, ok } => {
                        check_register(function, diagnostics, block, instruction, channel);
                        check_register(function, diagnostics, block, instruction, value);
                        check_optional_register(function, diagnostics, block, instruction, ok);
                        check_channel_receive(
                            program,
                            function,
                            diagnostics,
                            block,
                            instruction,
                            channel,
                            value,
                            ok,
                        )
                    },
                    SelectOperation::Default => if default_seen {
                        report(
                            diagnostics,
                            Option::Some(function.id),
                            Option::Some(block),
                            instruction,
                            "select has multiple default cases",
                        )
                    } else {
                        default_seen = true;
                    },
                }
                check_edge(
                    program,
                    function,
                    diagnostics,
                    block,
                    instruction,
                    case_value.target,
                    case_value.arguments,
                )
            }
        },
    }
}

fn check_edge(
    program: BytecodeProgram,
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    block: BlockId,
    instruction: isize,
    target: BlockId,
    arguments: Vec[RegisterId],
) -> () {
    check_registers(function, diagnostics, block, instruction, arguments);
    if target.value < 0 || target.value >= function.blocks.len() {
        report(
            diagnostics,
            Option::Some(function.id),
            Option::Some(block),
            instruction,
            f"invalid block {target.value}",
        );
        return
    }
    let parameters = function.blocks[target.value].parameters;
    if arguments.len() != parameters.len() {
        report(
            diagnostics,
            Option::Some(function.id),
            Option::Some(block),
            instruction,
            "block argument count does not match parameter count",
        );
        return
    }
    for index in 0..arguments.len() {
        if register_valid(function, arguments[index]) && register_valid(function, parameters[index])
            && !go_types::identical(
                program.world,
                function.register_types[arguments[index].value],
                function.register_types[parameters[index].value],
            ) {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::Some(block),
                instruction,
                "block argument type does not match parameter type",
            )
        }
    }
}

fn check_return(
    program: BytecodeProgram,
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    block: BlockId,
    values: Vec[RegisterId],
) -> () {
    check_registers(function, diagnostics, block, -1, values);
    if values.len() != function.results.len() {
        report(
            diagnostics,
            Option::Some(function.id),
            Option::Some(block),
            -1,
            "return value count does not match result count",
        );
        return
    }
    for index in 0..values.len() {
        let result = function.results[index];
        if register_valid(function, values[index]) && local_valid(function, result)
            && !go_types::identical(
                program.world,
                function.register_types[values[index].value],
                function.locals[result.value].type_id,
            ) {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::Some(block),
                -1,
                "return value type does not match result type",
            )
        }
    }
}

fn check_terminator(
    program: BytecodeProgram,
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    block: BlockId,
    value: Terminator,
) -> () {
    check_location(program, function, diagnostics, block, -1, value.location);
    match value.kind {
        TerminatorKind::Jump { target, arguments } => {
            check_edge(program, function, diagnostics, block, -1, target, arguments)
        },
        TerminatorKind::Branch {
            condition,
            then_target,
            then_arguments,
            else_target,
            else_arguments,
        } => {
            check_register(function, diagnostics, block, -1, condition);
            check_bool_register(
                program,
                function,
                diagnostics,
                block,
                -1,
                condition,
                "branch condition is not bool typed",
            );
            check_edge(program, function, diagnostics, block, -1, then_target, then_arguments);
            check_edge(program, function, diagnostics, block, -1, else_target, else_arguments)
        },
        TerminatorKind::Switch { value, arms, default_target, default_arguments } => {
            check_register(function, diagnostics, block, -1, value);
            for arm in arms {
                check_registers(function, diagnostics, block, -1, arm.comparisons);
                match verified_register_type(function, value) {
                    Some(type_id) => for comparison in arm.comparisons {
                        check_register_type(
                            program,
                            function,
                            diagnostics,
                            block,
                            -1,
                            comparison,
                            type_id,
                            "switch comparison type does not match switch value",
                        )
                    },
                    None => {},
                }
                check_edge(program, function, diagnostics, block, -1, arm.target, arm.arguments)
            }
            check_edge(program, function, diagnostics, block, -1, default_target, default_arguments)
        },
        TerminatorKind::Return { values } => {
            check_return(program, function, diagnostics, block, values)
        },
        TerminatorKind::Unreachable => {},
    }
}

fn check_signature(
    program: BytecodeProgram,
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
) -> () {
    match verified_signature_shape(program, function.signature) {
        Some(shape) => {
            let parameters: Vec[go_types::TypeId] = Vec::new();
            if let Some(receiver) = shape.receiver {
                parameters.push(receiver)
            }
            for parameter in shape.parameters {
                parameters.push(parameter)
            }
            if function.parameters.len() != parameters.len() {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::None,
                    -1,
                    "function parameter count does not match signature",
                )
            } else {
                for index in 0..parameters.len() {
                    let local = function.parameters[index];
                    if local_valid(function, local)
                        && !go_types::identical(
                            program.world,
                            function.locals[local.value].type_id,
                            parameters[index],
                        ) {
                        report(
                            diagnostics,
                            Option::Some(function.id),
                            Option::None,
                            -1,
                            "function parameter type does not match signature",
                        )
                    }
                }
            }
            if function.results.len() != shape.results.len() {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::None,
                    -1,
                    "function result count does not match signature",
                )
            } else {
                for index in 0..shape.results.len() {
                    let local = function.results[index];
                    if local_valid(function, local)
                        && !go_types::identical(
                            program.world,
                            function.locals[local.value].type_id,
                            shape.results[index],
                        ) {
                        report(
                            diagnostics,
                            Option::Some(function.id),
                            Option::None,
                            -1,
                            "function result type does not match signature",
                        )
                    }
                }
            }
        },
        _ => report(
            diagnostics,
            Option::Some(function.id),
            Option::None,
            -1,
            "function signature is not a signature type",
        ),
    }
}

fn check_function(
    program: BytecodeProgram,
    function: BytecodeFunction,
    diagnostics: Vec[VerifyDiagnostic],
    type_parameter_cache: Vec[isize],
    type_parameter_marks: Vec[isize],
    next_type_parameter_generation: Ref[isize],
) -> () {
    if !valid_package(program, function.package_id) {
        report(diagnostics, Option::Some(function.id), Option::None, -1, "invalid function package")
    }
    if !valid_object(program, function.object) {
        report(diagnostics, Option::Some(function.id), Option::None, -1, "invalid function object")
    } else {
        let object = program.world.objects[function.object.value];
        if object.kind != go_types::ObjectKind::Func {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::None,
                -1,
                "function object is not a function",
            )
        } else if !go_types::identical(program.world, object.type_id, function.signature) {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::None,
                -1,
                "function object type does not match signature",
            )
        }
        match object.owner {
            Some(owner) => if owner.value != function.package_id.value {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::None,
                    -1,
                    "function object owner does not match function package",
                )
            },
            None => report(
                diagnostics,
                Option::Some(function.id),
                Option::None,
                -1,
                "function object has no package owner",
            ),
        }
    }
    if valid_type(program, function.signature)
        && type_contains_parameter(
            program,
            function.signature,
            type_parameter_cache,
            type_parameter_marks,
            next_type_parameter_generation,
        ) {
        report(
            diagnostics,
            Option::Some(function.id),
            Option::None,
            -1,
            "function signature contains a type parameter",
        )
    }
    for type_id in function.register_types {
        if !valid_type(program, type_id) {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::None,
                -1,
                "function has an invalid register type",
            )
        } else if type_contains_parameter(
            program,
            type_id,
            type_parameter_cache,
            type_parameter_marks,
            next_type_parameter_generation,
        ) {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::None,
                -1,
                f"function register type contains a type parameter: register {type_id.value} has type "
                    + go_types::format_type(program.world, type_id),
            )
        }
    }
    if function.place_count < 0 {
        report(
            diagnostics,
            Option::Some(function.id),
            Option::None,
            -1,
            "function has a negative place count",
        )
    }
    for index in 0..function.locals.len() {
        let local = function.locals[index];
        if local.id.value != index {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::None,
                -1,
                "local id does not match local index",
            )
        } else if type_contains_parameter(
            program,
            local.type_id,
            type_parameter_cache,
            type_parameter_marks,
            next_type_parameter_generation,
        ) {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::None,
                -1,
                "function local " + local.name + " has type containing a type parameter: "
                    + go_types::format_type(program.world, local.type_id)
                    + f" ({local.type_id.value})",
            )
        }
        if !valid_type(program, local.type_id) {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::None,
                -1,
                "local has an invalid type",
            )
        }
        match local.object {
            Some(object) => if !valid_object(program, object) {
                report(
                    diagnostics,
                    Option::Some(function.id),
                    Option::None,
                    -1,
                    "local has an invalid object",
                )
            },
            None => {},
        }
    }
    for index in 0..function.parameters.len() {
        let local = function.parameters[index];
        if !local_valid(function, local) {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::None,
                -1,
                f"invalid parameter local {local.value}",
            )
        } else if local.value != function.captures.len() + index {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::None,
                -1,
                "parameter local does not match parameter index",
            )
        }
    }
    let seen_captures = collections::BitSet::new();
    for index in 0..function.captures.len() {
        let local = function.captures[index];
        if !local_valid(function, local) {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::None,
                -1,
                f"invalid capture local {local.value}",
            )
        } else if local.value != index {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::None,
                -1,
                "capture local does not match capture index",
            )
        } else if seen_captures.contains(local.value) {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::None,
                -1,
                f"duplicate capture local {local.value}",
            )
        } else {
            let _ = seen_captures.insert(local.value);
        }
    }
    for local in function.parameters {
        if local_valid(function, local) && seen_captures.contains(local.value) {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::None,
                -1,
                "capture local overlaps parameter local",
            )
        }
    }
    for local in function.results {
        if !local_valid(function, local) {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::None,
                -1,
                f"invalid result local {local.value}",
            )
        } else if seen_captures.contains(local.value) {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::None,
                -1,
                "capture local overlaps result local",
            )
        }
    }
    check_signature(program, function, diagnostics);
    if function.entry.value < 0 || function.entry.value >= function.blocks.len() {
        report(diagnostics, Option::Some(function.id), Option::None, -1, "invalid entry block")
    }
    for index in 0..function.blocks.len() {
        let block = function.blocks[index];
        if block.id.value != index {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::Some(block.id),
                -1,
                "block id does not match block index",
            )
        }
        check_registers(function, diagnostics, block.id, -1, block.parameters);
        for instruction in 0..block.instructions.len() {
            check_instruction(
                program,
                function,
                diagnostics,
                block.id,
                instruction,
                block.instructions[instruction],
            )
        }
        check_terminator(program, function, diagnostics, block.id, block.terminator)
    }
}

pub fn verify(program: BytecodeProgram) -> Vec[VerifyDiagnostic] {
    let diagnostics: Vec[VerifyDiagnostic] = Vec::new();
    let type_parameter_cache = int_slots(program.world.types.len(), -1);
    let type_parameter_marks = int_slots(program.world.types.len(), 0);
    let next_type_parameter_generation = Ref::new(0);
    if !function_valid(program, program.main) {
        report(diagnostics, Option::None, Option::None, -1, "invalid main function")
    } else {
        let main = program.functions[program.main.value];
        if main.name != "main" || !main.parameters.is_empty() || !main.results.is_empty()
            || !main.captures.is_empty() {
            report(
                diagnostics,
                Option::Some(main.id),
                Option::None,
                -1,
                "main function has an invalid entry signature",
            )
        }
    }
    if program.object_functions.len() != program.world.objects.len() {
        report(
            diagnostics,
            Option::None,
            Option::None,
            -1,
            "function object index has the wrong length",
        )
    }
    if program.object_globals.len() != program.world.objects.len() {
        report(
            diagnostics,
            Option::None,
            Option::None,
            -1,
            "global object index has the wrong length",
        )
    }
    if program.object_native_calls.len() != program.world.objects.len() {
        report(
            diagnostics,
            Option::None,
            Option::None,
            -1,
            "native call object index has the wrong length",
        )
    }
    for index in 0..program.functions.len() {
        let function = program.functions[index];
        if function.id.value != index {
            report(
                diagnostics,
                Option::Some(function.id),
                Option::None,
                -1,
                "function id does not match function index",
            )
        }
        check_function(
            program,
            function,
            diagnostics,
            type_parameter_cache,
            type_parameter_marks,
            next_type_parameter_generation,
        )
    }
    for index in 0..program.globals.len() {
        let global = program.globals[index];
        if global.id.value != index {
            report(
                diagnostics,
                Option::None,
                Option::None,
                -1,
                "global id does not match global index",
            )
        }
        if !valid_package(program, global.package_id) || !valid_object(program, global.object)
            || !valid_type(program, global.type_id) {
            report(diagnostics, Option::None, Option::None, -1, "global metadata is invalid")
        } else {
            let object = program.world.objects[global.object.value];
            if object.kind != go_types::ObjectKind::Var {
                report(
                    diagnostics,
                    Option::None,
                    Option::None,
                    -1,
                    "global object is not a variable",
                )
            }
            if !go_types::identical(program.world, object.type_id, global.type_id) {
                report(
                    diagnostics,
                    Option::None,
                    Option::None,
                    -1,
                    "global object type does not match global type",
                )
            }
            match object.owner {
                Some(owner) => if owner.value != global.package_id.value {
                    report(
                        diagnostics,
                        Option::None,
                        Option::None,
                        -1,
                        "global object owner does not match global package",
                    )
                },
                None => report(
                    diagnostics,
                    Option::None,
                    Option::None,
                    -1,
                    "global object has no package owner",
                ),
            }
        }
    }
    for index in 0..program.native_calls.len() {
        let call = program.native_calls[index];
        if call.id.value != index {
            report(
                diagnostics,
                Option::None,
                Option::None,
                -1,
                "native call id does not match native call index",
            )
        }
        if !valid_package(program, call.package_id) || !valid_object(program, call.object)
            || !valid_type(program, call.signature) {
            report(diagnostics, Option::None, Option::None, -1, "native call metadata is invalid")
        } else {
            let object = program.world.objects[call.object.value];
            if object.kind != go_types::ObjectKind::Func || object.name != call.symbol {
                report(
                    diagnostics,
                    Option::None,
                    Option::None,
                    -1,
                    "native call object does not match its symbol",
                )
            }
            match object.owner {
                Some(owner) => if !valid_package(program, owner)
                    || owner.value != call.package_id.value
                    || program.world.packages[call.package_id.value].path != call.import_path {
                    report(
                        diagnostics,
                        Option::None,
                        Option::None,
                        -1,
                        "native call object owner does not match its package",
                    )
                },
                None => report(
                    diagnostics,
                    Option::None,
                    Option::None,
                    -1,
                    "native call object has no package owner",
                ),
            }
            if !go_types::identical(program.world, object.type_id, call.signature) {
                report(
                    diagnostics,
                    Option::None,
                    Option::None,
                    -1,
                    "native call object type does not match its signature",
                )
            }
            if call.object.value < program.object_native_calls.len()
                && program.object_native_calls[call.object.value] != Option::Some(call.id) {
                report(
                    diagnostics,
                    Option::None,
                    Option::None,
                    -1,
                    "native call object index is inconsistent",
                )
            }
            if call.object.value < program.object_functions.len()
                && program.object_functions[call.object.value].is_some() {
                report(
                    diagnostics,
                    Option::None,
                    Option::None,
                    -1,
                    "native call object also has an interpreted body",
                )
            }
        }
        if call.parameter_types.len() != call.parameter_type_keys.len()
            || call.result_types.len() != call.result_type_keys.len() {
            report(
                diagnostics,
                Option::None,
                Option::None,
                -1,
                "native call type metadata has inconsistent lengths",
            )
        }
        match verified_signature_shape(program, call.signature) {
            Some(signature) => match signature.receiver {
                Some(receiver) => if call.receiver_name == "" || call.parameter_types.is_empty()
                    || !go_types::identical(program.world, call.parameter_types[0], receiver) {
                    report(
                        diagnostics,
                        Option::None,
                        Option::None,
                        -1,
                        "native method receiver metadata is inconsistent",
                    )
                },
                None => if call.receiver_name != "" || call.receiver_pointer {
                    report(
                        diagnostics,
                        Option::None,
                        Option::None,
                        -1,
                        "native function has method receiver metadata",
                    )
                },
            },
            None => {},
        }
        for type_id in call.parameter_types {
            if !valid_type(program, type_id) {
                report(
                    diagnostics,
                    Option::None,
                    Option::None,
                    -1,
                    "native call has an invalid parameter type",
                )
            }
        }
        for type_id in call.result_types {
            if !valid_type(program, type_id) {
                report(
                    diagnostics,
                    Option::None,
                    Option::None,
                    -1,
                    "native call has an invalid result type",
                )
            }
        }
    }
    for index in 0..program.native_types.len() {
        let value = program.native_types[index];
        if !valid_type(program, value.type_id) || !valid_package(program, value.package_id)
            || value.key == ""
            || value.name == ""
            || program.world.packages[value.package_id.value].path != value.import_path {
            report(diagnostics, Option::None, Option::None, -1, "native type metadata is invalid")
        } else if index > 0 && program.native_types[index - 1].key >= value.key {
            report(
                diagnostics,
                Option::None,
                Option::None,
                -1,
                "native types are not sorted and unique",
            )
        }
    }
    for index in 0..program.object_functions.len() {
        match program.object_functions[index] {
            Some(function) => if !function_valid(program, function)
                || program.functions[function.value].object.value != index {
                report(
                    diagnostics,
                    Option::None,
                    Option::None,
                    -1,
                    "function object index is inconsistent",
                )
            },
            None => {},
        }
    }
    for index in 0..program.object_globals.len() {
        match program.object_globals[index] {
            Some(global) => if !global_valid(program, global)
                || program.globals[global.value].object.value != index {
                report(
                    diagnostics,
                    Option::None,
                    Option::None,
                    -1,
                    "global object index is inconsistent",
                )
            },
            None => {},
        }
    }
    for index in 0..program.object_native_calls.len() {
        match program.object_native_calls[index] {
            Some(call) => if !native_call_valid(program, call)
                || program.native_calls[call.value].object.value != index {
                report(
                    diagnostics,
                    Option::None,
                    Option::None,
                    -1,
                    "native call object index is inconsistent",
                )
            },
            None => {},
        }
    }
    for index in 0..program.native_initialization_packages.len() {
        let value = program.native_initialization_packages[index];
        if value == "" {
            report(
                diagnostics,
                Option::None,
                Option::None,
                -1,
                "native initialization package is empty",
            )
        } else if index > 0 && program.native_initialization_packages[index - 1] >= value {
            report(
                diagnostics,
                Option::None,
                Option::None,
                -1,
                "native initialization packages are not sorted and unique",
            )
        }
    }
    let seen_packages = collections::BitSet::new();
    for package_value in program.packages {
        if !valid_package(program, package_value.package_id) {
            report(diagnostics, Option::None, Option::None, -1, "invalid bytecode package")
        } else if seen_packages.contains(package_value.package_id.value) {
            report(diagnostics, Option::None, Option::None, -1, "duplicate bytecode package")
        } else {
            let _ = seen_packages.insert(package_value.package_id.value);
        }
        let seen_functions = collections::BitSet::new();
        for function in package_value.functions {
            if !function_valid(program, function)
                || program.functions[function.value].package_id.value
                    != package_value.package_id.value {
                report(
                    diagnostics,
                    Option::None,
                    Option::None,
                    -1,
                    "package function index is inconsistent",
                )
            } else if seen_functions.contains(function.value) {
                report(
                    diagnostics,
                    Option::None,
                    Option::None,
                    -1,
                    "package contains a duplicate function",
                )
            } else {
                let _ = seen_functions.insert(function.value);
            }
        }
        let seen_globals = collections::BitSet::new();
        for global in package_value.globals {
            if !global_valid(program, global)
                || program.globals[global.value].package_id.value != package_value.package_id.value {
                report(
                    diagnostics,
                    Option::None,
                    Option::None,
                    -1,
                    "package global index is inconsistent",
                )
            } else if seen_globals.contains(global.value) {
                report(
                    diagnostics,
                    Option::None,
                    Option::None,
                    -1,
                    "package contains a duplicate global",
                )
            } else {
                let _ = seen_globals.insert(global.value);
            }
        }
        match package_value.initializer {
            Some(function) => if !function_valid(program, function) {
                report(
                    diagnostics,
                    Option::None,
                    Option::None,
                    -1,
                    "package initializer is invalid",
                )
            } else {
                let initializer = program.functions[function.value];
                if initializer.package_id.value != package_value.package_id.value
                    || initializer.name != "$init"
                    || !initializer.parameters.is_empty()
                    || !initializer.results.is_empty()
                    || !initializer.captures.is_empty() {
                    report(
                        diagnostics,
                        Option::Some(function),
                        Option::None,
                        -1,
                        "package initializer has invalid metadata",
                    )
                }
            },
            None => {},
        }
    }
    let seen_initialization = collections::BitSet::new();
    for package_id in program.initialization_order {
        if !valid_package(program, package_id) {
            report(
                diagnostics,
                Option::None,
                Option::None,
                -1,
                "initialization order contains an invalid package",
            )
        } else if seen_initialization.contains(package_id.value) {
            report(
                diagnostics,
                Option::None,
                Option::None,
                -1,
                "initialization order contains a duplicate package",
            )
        } else {
            let _ = seen_initialization.insert(package_id.value);
        }
    }
    diagnostics
}
