package bytecode;

use gomlgo::types as go_types;
use gomlgo::syntax;

#[derive(PartialEq, Eq, ToString)]
pub struct RegisterId {
    pub value: isize,
}

#[derive(PartialEq, Eq, ToString)]
pub struct PlaceId {
    pub value: isize,
}

#[derive(PartialEq, Eq, ToString)]
pub struct LocalId {
    pub value: isize,
}

#[derive(PartialEq, Eq, ToString)]
pub struct GlobalId {
    pub value: isize,
}

#[derive(PartialEq, Eq, ToString)]
pub struct BlockId {
    pub value: isize,
}

#[derive(PartialEq, Eq, ToString)]
pub struct FunctionId {
    pub value: isize,
}

#[derive(PartialEq, Eq, ToString)]
pub struct NativeCallId {
    pub value: isize,
}

pub fn register_id(value: isize) -> RegisterId {
    RegisterId { value }
}

pub fn place_id(value: isize) -> PlaceId {
    PlaceId { value }
}

pub fn local_id(value: isize) -> LocalId {
    LocalId { value }
}

pub fn global_id(value: isize) -> GlobalId {
    GlobalId { value }
}

pub fn block_id(value: isize) -> BlockId {
    BlockId { value }
}

pub fn function_id(value: isize) -> FunctionId {
    FunctionId { value }
}

pub fn native_call_id(value: isize) -> NativeCallId {
    NativeCallId { value }
}

pub struct SourceLocation {
    pub package_id: go_types::PackageId,
    pub file: syntax::FileId,
    pub start: isize,
    pub end: isize,
    pub function: FunctionId,
}

pub struct CodeLocation {
    pub file: syntax::FileId,
    pub start: isize,
    pub end: isize,
}

pub fn expand_location(
    package_id: go_types::PackageId,
    function: FunctionId,
    location: CodeLocation,
) -> SourceLocation {
    SourceLocation {
        package_id,
        file: location.file,
        start: location.start,
        end: location.end,
        function,
    }
}

#[derive(PartialEq, Eq, ToString)]
pub enum UnaryOp {
    Positive,
    Negative,
    Not,
    Complement,
}

#[derive(PartialEq, Eq, ToString)]
pub enum BinaryOp {
    Add,
    Subtract,
    Multiply,
    Divide,
    Remainder,
    BitAnd,
    BitOr,
    BitXor,
    AndNot,
    ShiftLeft,
    ShiftRight,
    Equal,
    NotEqual,
    Less,
    LessEqual,
    Greater,
    GreaterEqual,
}

#[derive(PartialEq, Eq, ToString)]
pub enum BuiltinKind {
    Append,
    SliceGrow,
    Cap,
    Clear,
    Close,
    Complex,
    Copy,
    Delete,
    Imag,
    Len,
    Make,
    Max,
    Min,
    New,
    Panic,
    Print,
    Println,
    Real,
    Recover,
}

pub enum CallTarget {
    Static(FunctionId),
    Method {
        function: FunctionId,
        receiver: RegisterId,
    },
    InterfaceMethod {
        method: go_types::ObjectId,
        receiver: RegisterId,
    },
    Dynamic(RegisterId),
    Native(NativeCallId),
    NativeMethod {
        call: NativeCallId,
        receiver: RegisterId,
    },
    Builtin(BuiltinKind),
}

pub enum SelectOperation {
    Send {
        channel: RegisterId,
        value: RegisterId,
    },
    Receive {
        channel: RegisterId,
        value: RegisterId,
        ok: Option[RegisterId],
    },
    Default,
}

pub struct SelectCase {
    pub operation: SelectOperation,
    pub target: BlockId,
    pub arguments: Vec[RegisterId],
}

pub enum InstructionKind {
    Constant {
        target: RegisterId,
        type_id: go_types::TypeId,
        constant_kind: string,
        exact: string,
    },
    Zero {
        target: RegisterId,
        type_id: go_types::TypeId,
    },
    Move {
        target: RegisterId,
        source: RegisterId,
    },
    LocalPlace {
        target: PlaceId,
        local: LocalId,
    },
    GlobalPlace {
        target: PlaceId,
        global: GlobalId,
    },
    NativeGlobalLoad {
        target: RegisterId,
        object: go_types::ObjectId,
    },
    FieldPlace {
        target: PlaceId,
        base: PlaceId,
        index: Vec[isize],
    },
    IndexPlace {
        target: PlaceId,
        base: PlaceId,
        index: RegisterId,
    },
    DereferencePlace {
        target: PlaceId,
        pointer: RegisterId,
    },
    Load {
        target: RegisterId,
        source: PlaceId,
    },
    Store {
        target: PlaceId,
        value: RegisterId,
    },
    Copy {
        target: RegisterId,
        source: RegisterId,
    },
    AddressOf {
        target: RegisterId,
        source: PlaceId,
    },
    Unary {
        target: RegisterId,
        op: UnaryOp,
        operand: RegisterId,
    },
    Binary {
        target: RegisterId,
        op: BinaryOp,
        left: RegisterId,
        right: RegisterId,
    },
    Convert {
        target: RegisterId,
        source: RegisterId,
        type_id: go_types::TypeId,
    },
    TypeAssert {
        target: RegisterId,
        ok: Option[RegisterId],
        source: RegisterId,
        type_id: go_types::TypeId,
    },
    MakeAggregate {
        target: RegisterId,
        type_id: go_types::TypeId,
        elements: Vec[AggregateElement],
        length: isize,
    },
    FieldValue {
        target: RegisterId,
        base: RegisterId,
        index: Vec[isize],
    },
    IndexValue {
        target: RegisterId,
        base: RegisterId,
        index: RegisterId,
        ok: Option[RegisterId],
    },
    DecodeRune {
        rune: RegisterId,
        width: RegisterId,
        source: RegisterId,
        offset: RegisterId,
    },
    SliceValue {
        target: RegisterId,
        base: RegisterId,
        low: Option[RegisterId],
        high: Option[RegisterId],
        maximum: Option[RegisterId],
    },
    SlicePlace {
        target: RegisterId,
        base: PlaceId,
        element_type: go_types::TypeId,
        low: Option[RegisterId],
        high: Option[RegisterId],
        maximum: Option[RegisterId],
    },
    Allocate {
        target: RegisterId,
        type_id: go_types::TypeId,
        value: Option[RegisterId],
    },
    MakeSlice {
        target: RegisterId,
        type_id: go_types::TypeId,
        length: RegisterId,
        capacity: RegisterId,
    },
    MakeMap {
        target: RegisterId,
        type_id: go_types::TypeId,
        capacity: Option[RegisterId],
    },
    MakeChannel {
        target: RegisterId,
        type_id: go_types::TypeId,
        capacity: RegisterId,
    },
    MakeClosure {
        target: RegisterId,
        function: FunctionId,
        captures: Vec[LocalId],
    },
    MakeMethodValue {
        target: RegisterId,
        function: FunctionId,
        receiver: RegisterId,
    },
    MakeMethodExpression {
        target: RegisterId,
        function: FunctionId,
        receiver_type: go_types::TypeId,
        index: Vec[isize],
    },
    MakeInterfaceMethodValue {
        target: RegisterId,
        method: go_types::ObjectId,
        receiver: Option[RegisterId],
    },
    RenewLocal {
        local: LocalId,
    },
    CloneLocal {
        local: LocalId,
    },
    Call {
        results: Vec[RegisterId],
        target: CallTarget,
        arguments: Vec[RegisterId],
        variadic: bool,
    },
    Defer {
        target: CallTarget,
        arguments: Vec[RegisterId],
        variadic: bool,
    },
    Panic {
        value: RegisterId,
    },
    Recover {
        target: RegisterId,
    },
    MapSet {
        map: RegisterId,
        key: RegisterId,
        value: RegisterId,
    },
    MapDelete {
        map: RegisterId,
        key: RegisterId,
    },
    MapIterInit {
        target: RegisterId,
        map: RegisterId,
    },
    MapIterNext {
        key: RegisterId,
        value: Option[RegisterId],
        ok: RegisterId,
        iterator: RegisterId,
    },
    Spawn {
        target: CallTarget,
        arguments: Vec[RegisterId],
        variadic: bool,
    },
    Send {
        channel: RegisterId,
        value: RegisterId,
    },
    Receive {
        value: RegisterId,
        ok: Option[RegisterId],
        channel: RegisterId,
    },
    Close {
        channel: RegisterId,
    },
    Select {
        chosen: RegisterId,
        cases: Vec[SelectCase],
    },
}

pub struct AggregateElement {
    pub index: isize,
    pub value: RegisterId,
}

pub struct Instruction {
    pub kind: InstructionKind,
    pub location: CodeLocation,
}

pub struct SwitchArm {
    pub comparisons: Vec[RegisterId],
    pub target: BlockId,
    pub arguments: Vec[RegisterId],
}

pub enum TerminatorKind {
    Jump {
        target: BlockId,
        arguments: Vec[RegisterId],
    },
    Branch {
        condition: RegisterId,
        then_target: BlockId,
        then_arguments: Vec[RegisterId],
        else_target: BlockId,
        else_arguments: Vec[RegisterId],
    },
    Switch {
        value: RegisterId,
        arms: Vec[SwitchArm],
        default_target: BlockId,
        default_arguments: Vec[RegisterId],
    },
    Return {
        values: Vec[RegisterId],
    },
    Unreachable,
}

pub struct Terminator {
    pub kind: TerminatorKind,
    pub location: CodeLocation,
}

pub struct BasicBlock {
    pub id: BlockId,
    pub parameters: Vec[RegisterId],
    pub instructions: Vec[Instruction],
    pub terminator: Terminator,
}

pub struct Local {
    pub id: LocalId,
    pub object: Option[go_types::ObjectId],
    pub name: string,
    pub type_id: go_types::TypeId,
}

pub struct BytecodeFunction {
    pub id: FunctionId,
    pub package_id: go_types::PackageId,
    pub object: go_types::ObjectId,
    pub name: string,
    pub signature: go_types::TypeId,
    pub register_types: Vec[go_types::TypeId],
    pub place_count: isize,
    pub locals: Vec[Local],
    pub captures: Vec[LocalId],
    pub parameters: Vec[LocalId],
    pub results: Vec[LocalId],
    pub blocks: Vec[BasicBlock],
    pub entry: BlockId,
}

pub struct Global {
    pub id: GlobalId,
    pub package_id: go_types::PackageId,
    pub object: go_types::ObjectId,
    pub name: string,
    pub type_id: go_types::TypeId,
}

pub struct NativeCall {
    pub id: NativeCallId,
    pub package_id: go_types::PackageId,
    pub object: go_types::ObjectId,
    pub import_path: string,
    pub symbol: string,
    pub receiver_name: string,
    pub receiver_pointer: bool,
    pub type_argument_keys: Vec[string],
    pub signature: go_types::TypeId,
    pub parameter_types: Vec[go_types::TypeId],
    pub result_types: Vec[go_types::TypeId],
    pub parameter_type_keys: Vec[string],
    pub result_type_keys: Vec[string],
    pub variadic: bool,
    pub exit: bool,
}

pub struct NativeType {
    pub type_id: go_types::TypeId,
    pub package_id: go_types::PackageId,
    pub import_path: string,
    pub name: string,
    pub key: string,
}

pub struct BytecodePackage {
    pub package_id: go_types::PackageId,
    pub path: string,
    pub functions: Vec[FunctionId],
    pub globals: Vec[GlobalId],
    pub initializer: Option[FunctionId],
}

pub struct BytecodeSourceFile {
    pub package_id: go_types::PackageId,
    pub file: syntax::FileId,
    pub name: string,
}

pub struct BytecodeProgram {
    pub world: go_types::World,
    pub packages: Vec[BytecodePackage],
    pub functions: Vec[BytecodeFunction],
    pub globals: Vec[Global],
    pub object_functions: Vec[Option[FunctionId]],
    pub object_globals: Vec[Option[GlobalId]],
    pub native_calls: Vec[NativeCall],
    pub native_types: Vec[NativeType],
    pub object_native_calls: Vec[Option[NativeCallId]],
    pub native_initialization_packages: Vec[string],
    pub source_files: Vec[BytecodeSourceFile],
    pub initialization_order: Vec[go_types::PackageId],
    pub main: FunctionId,
}

pub struct LowerDiagnostic {
    pub package_id: Option[go_types::PackageId],
    pub function: Option[go_types::ObjectId],
    pub file: Option[syntax::FileId],
    pub start: isize,
    pub end: isize,
    pub message: string,
}

pub struct LowerResult {
    pub program: Option[BytecodeProgram],
    pub diagnostics: Vec[LowerDiagnostic],
}

pub struct VerifyDiagnostic {
    pub function: Option[FunctionId],
    pub block: Option[BlockId],
    pub instruction: isize,
    pub message: string,
}
