package bytecode;

use gomlgo::checker;
use gomlgo::execution;
use gomlgo::native as native_api;
use gomlgo::syntax;
use gomlgo::types as go_types;
use std::collections;
use std::text;

struct NativeSignature {
    parameter_types: Vec[go_types::TypeId],
    result_types: Vec[go_types::TypeId],
    parameter_type_keys: Vec[string],
    result_type_keys: Vec[string],
    variadic: bool,
}

struct NativeCandidate {
    source_package: execution::ExecutionPackage,
    node: syntax::NodeId,
    package_id: go_types::PackageId,
    object: go_types::ObjectId,
    import_path: string,
    symbol: string,
    receiver_name: string,
    receiver_pointer: bool,
    type_argument_keys: Vec[string],
    signature: go_types::TypeId,
    shape: NativeSignature,
    exit: bool,
}

struct NativeLinkResult {
    calls: Vec[NativeCall],
    types: Vec[NativeType],
    object_calls: Vec[Option[NativeCallId]],
    initialization_packages: Vec[string],
    diagnostics: Vec[LowerDiagnostic],
}

struct NativeReceiver {
    type_id: go_types::TypeId,
    package_id: go_types::PackageId,
    import_path: string,
    name: string,
    pointer: bool,
}

fn native_option_slots(count: isize) -> Vec[Option[NativeCallId]] {
    let result: Vec[Option[NativeCallId]] = Vec::with_capacity(count);
    for _ in 0..count {
        result.push(Option::None)
    }
    result
}

fn execution_package_index(program: execution::ExecutionProgram, package_id: go_types::PackageId) -> isize {
    if package_id.value < 0 || package_id.value >= program.package_indices.len() {
        return -1
    }
    match program.package_indices[package_id.value] {
        Some(index) => if index >= 0 && index < program.packages.len() {
            index
        } else {
            -1
        },
        None => -1,
    }
}

fn native_basic_key(basic: go_types::BasicKind, untyped: bool) -> Result[string, string] {
    if untyped {
        return Result::Err("untyped values are not supported")
    }
    match basic {
        go_types::BasicKind::Bool => Result::Ok("bool"),
        go_types::BasicKind::Int => Result::Ok("int"),
        go_types::BasicKind::Int8 => Result::Ok("int8"),
        go_types::BasicKind::Int16 => Result::Ok("int16"),
        go_types::BasicKind::Int32 => Result::Ok("int32"),
        go_types::BasicKind::Int64 => Result::Ok("int64"),
        go_types::BasicKind::Uint => Result::Ok("uint"),
        go_types::BasicKind::Uint8 => Result::Ok("uint8"),
        go_types::BasicKind::Uint16 => Result::Ok("uint16"),
        go_types::BasicKind::Uint32 => Result::Ok("uint32"),
        go_types::BasicKind::Uint64 => Result::Ok("uint64"),
        go_types::BasicKind::Uintptr => Result::Ok("uintptr"),
        go_types::BasicKind::Float32 => Result::Ok("float32"),
        go_types::BasicKind::Float64 => Result::Ok("float64"),
        go_types::BasicKind::Complex64 => Result::Ok("complex64"),
        go_types::BasicKind::Complex128 => Result::Ok("complex128"),
        go_types::BasicKind::String => Result::Ok("string"),
        _ => Result::Err("basic type is not supported"),
    }
}

fn native_type_key(world: go_types::World, type_id: go_types::TypeId) -> Result[string, string] {
    let canonical = go_types::unalias(world, type_id);
    match go_types::type_data(world, canonical) {
        go_types::TypeData { id: _, kind: go_types::TypeKind::Basic { basic, name: _, untyped } } => native_basic_key(
            basic,
            untyped,
        ),
        go_types::TypeData { id: _, kind: go_types::TypeKind::Slice { element } } => Result::Ok(
            "[]" + native_type_key(world, element)?,
        ),
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named { object, underlying, type_params, type_args, .. },
        } => if go_types::is_interface(world, underlying) {
            let value = world.objects[object.value];
            if value.name == "error" {
                Result::Ok("error")
            } else {
                Result::Ok("interface")
            }
        } else if type_params.is_empty() && type_args.is_empty()
            && native_opaque_underlying(world, underlying) {
            let value = world.objects[object.value];
            let owner = value.owner.ok_or("native opaque type has no package owner")?;
            Result::Ok("native:" + world.packages[owner.value].path + "." + value.name)
        } else {
            native_type_key(world, underlying)
        },
        go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } } => {
            let key = native_type_key(world, element)?;
            if key.starts_with("native:") {
                Result::Ok("native:*" + key.byte_slice(7, key.byte_len()))
            } else {
                Result::Err("pointer target is not a native opaque type")
            }
        },
        go_types::TypeData { id: _, kind: go_types::TypeKind::Interface { .. } } => {
            Result::Ok("interface")
        },
        go_types::TypeData { id: _, kind: go_types::TypeKind::Chan { direction: _, element: _ } } => Result::Ok(
            "channel",
        ),
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: None,
                receiver_type_params,
                type_params,
                params,
                results,
                variadic,
            },
        } => {
            if !receiver_type_params.is_empty() || !type_params.is_empty() {
                return Result::Err("generic callback functions are not supported")
            }
            let parameters = native_tuple(world, params)?;
            let result_values = native_tuple(world, results)?;
            if variadic {
                if parameters.0.is_empty() {
                    return Result::Err("variadic callback has no final parameter")
                }
                parameters.1[parameters.1.len() - 1] = native_variadic_key(
                    world,
                    parameters.0[parameters.0.len() - 1],
                )?;
            }
            Result::Ok(
                "func(" + text::join(parameters.1, ",") + ")(" + text::join(result_values.1, ",")
                    + ")",
            )
        },
        _ => Result::Err("type " + go_types::format_type(world, type_id) + " is not supported"),
    }
}

fn native_intrinsic(import_path: string, symbol: string) -> bool {
    import_path == "slices" && symbol == "Grow"
}

fn native_proxy_method(world: go_types::World, object: go_types::ObjectId) -> Result[
    native_api::NativeProxyMethodSpec,
    string,
] {
    let value = world.objects[object.value];
    match go_types::get_type(world, go_types::unalias(world, value.type_id)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: _,
                receiver_type_params,
                type_params,
                params,
                results,
                variadic,
            },
        }) => {
            if !receiver_type_params.is_empty() || !type_params.is_empty() || variadic {
                return Result::Err("generic or variadic interface methods are not supported")
            }
            let parameter_type_keys = native_tuple(world, params)?.1;
            let result_type_keys = native_tuple(world, results)?.1;
            for key in parameter_type_keys {
                if !native_proxy_type_key_supported(key) {
                    return Result::Err("interface method parameter is not proxyable")
                }
            }
            for key in result_type_keys {
                if !native_proxy_type_key_supported(key) {
                    return Result::Err("interface method result is not proxyable")
                }
            }
            Result::Ok(
                native_api::NativeProxyMethodSpec {
                    name: value.name,
                    parameter_type_keys,
                    result_type_keys,
                },
            )
        },
        _ => Result::Err("interface method has no signature"),
    }
}

fn native_proxy_type_key_supported(value: string) -> bool {
    if value.starts_with("[]") {
        native_proxy_type_key_supported(value.byte_slice(2, value.byte_len()))
    } else {
        value == "bool" || value == "int" || value == "int8" || value == "int16" || value == "int32"
            || value == "int64"
            || value == "uint"
            || value == "uint8"
            || value == "uint16"
            || value == "uint32"
            || value == "uint64"
            || value == "uintptr"
            || value == "float32"
            || value == "float64"
            || value == "complex64"
            || value == "complex128"
            || value == "string"
            || value == "error"
            || value == "interface"
    }
}

fn native_proxy_spec(world: go_types::World, type_id: go_types::TypeId) -> Result[
    Option[native_api::NativeProxySpec],
    string,
] {
    let canonical = go_types::unalias(world, type_id);
    match go_types::get_type(world, canonical) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named { object, underlying, .. },
        }) => match go_types::get_type(world, go_types::underlying(world, underlying)) {
            Some(go_types::TypeData {
                id: _,
                kind: go_types::TypeKind::Interface {
                    methods,
                    embeddeds: _,
                    comparable: _,
                    implicit: _,
                },
            }) => {
                let value = world.objects[object.value];
                let owner = value.owner.ok_or("native interface has no package owner")?;
                let path = world.packages[owner.value].path;
                let specs: Vec[native_api::NativeProxyMethodSpec] = Vec::with_capacity(
                    methods.len(),
                );
                for method in methods {
                    specs.push(native_proxy_method(world, method)?)
                }
                Result::Ok(
                    Option::Some(
                        native_api::NativeProxySpec {
                            import_path: path,
                            name: value.name,
                            methods: specs,
                        },
                    ),
                )
            },
            _ => Result::Ok(Option::None),
        },
        _ => Result::Ok(Option::None),
    }
}

fn same_proxy(left: native_api::NativeProxySpec, right: native_api::NativeProxySpec) -> bool {
    left.import_path == right.import_path && left.name == right.name
}

fn native_aggregate_key(type_id: go_types::TypeId) -> string {
    f"gomlgo-type-{type_id.value}"
}

fn native_aggregate_field_key_supported(value: string) -> bool {
    if value.starts_with("[]") {
        native_aggregate_field_key_supported(value.byte_slice(2, value.byte_len()))
    } else {
        value == "bool" || value == "int" || value == "int8" || value == "int16" || value == "int32"
            || value == "int64"
            || value == "uint"
            || value == "uint8"
            || value == "uint16"
            || value == "uint32"
            || value == "uint64"
            || value == "uintptr"
            || value == "float32"
            || value == "float64"
            || value == "complex64"
            || value == "complex128"
            || value == "string"
    }
}

fn interpreted_package(program: BytecodeProgram, package_id: go_types::PackageId) -> bool {
    for package_value in program.packages {
        if package_value.package_id.value == package_id.value {
            return true
        }
    }
    false
}

fn native_aggregate_specs(program: BytecodeProgram) -> Vec[native_api::NativeAggregateSpec] {
    let result: Vec[native_api::NativeAggregateSpec] = Vec::new();
    for type_value in program.world.types {
        match type_value.kind {
            go_types::TypeKind::Named { object, underlying, type_params, type_args, methods: _ } => if type_params.is_empty()
                && type_args.is_empty() {
                let value = program.world.objects[object.value];
                match value.owner {
                    Some(owner) => if value.exported && interpreted_package(program, owner) {
                        match go_types::get_type(
                            program.world,
                            go_types::underlying(program.world, underlying),
                        ) {
                            Some(go_types::TypeData {
                                id: _,
                                kind: go_types::TypeKind::Struct { fields },
                            }) => {
                                let specs: Vec[native_api::NativeAggregateFieldSpec] = Vec::from_array(
                                    [],
                                );
                                let mut supported = !fields.is_empty();
                                for field in fields {
                                    match native_type_key(program.world, field.variable.type_id) {
                                        Ok(key) => if !native_aggregate_field_key_supported(key) {
                                            supported = false;
                                        } else {
                                            specs.push(
                                                native_api::NativeAggregateFieldSpec {
                                                    name: field.variable.name,
                                                    type_key: key,
                                                    tag: field.tag,
                                                },
                                            )
                                        },
                                        Err(_) => {
                                            supported = false;
                                        },
                                    };
                                }
                                if supported {
                                    result.push(
                                        native_api::NativeAggregateSpec {
                                            key: native_aggregate_key(type_value.id),
                                            name: value.name,
                                            fields: specs,
                                        },
                                    )
                                }
                            },
                            _ => {},
                        }
                    },
                    None => {},
                }
            },
            _ => {},
        }
    }
    result
}

fn native_tuple(world: go_types::World, tuple: go_types::TypeId) -> Result[
    (Vec[go_types::TypeId], Vec[string]),
    string,
] {
    match go_types::get_type(world, go_types::unalias(world, tuple)) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Tuple { variables } }) => {
            let types: Vec[go_types::TypeId] = Vec::with_capacity(variables.len());
            let keys: Vec[string] = Vec::with_capacity(variables.len());
            for variable in variables {
                types.push(variable.type_id);
                keys.push(native_type_key(world, variable.type_id)?)
            }
            Result::Ok((types, keys))
        },
        _ => Result::Err("function parameter or result list is not a tuple"),
    }
}

fn native_variadic_key(world: go_types::World, type_id: go_types::TypeId) -> Result[string, string] {
    match go_types::get_type(world, go_types::unalias(world, type_id)) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Slice { element } }) => Result::Ok(
            "..." + native_type_key(world, element)?,
        ),
        _ => Result::Err("variadic parameter is not a slice"),
    }
}

fn native_signature(world: go_types::World, signature: go_types::TypeId) -> Result[
    NativeSignature,
    string,
] {
    match go_types::get_type(world, go_types::unalias(world, signature)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: Option::None,
                receiver_type_params,
                type_params,
                params,
                results,
                variadic,
            },
        }) => {
            if !receiver_type_params.is_empty() || !type_params.is_empty() {
                return Result::Err("generic functions are not supported")
            }
            let parameters = native_tuple(world, params)?;
            let result_values = native_tuple(world, results)?;
            if variadic {
                if parameters.0.is_empty() {
                    return Result::Err("variadic function has no final parameter")
                }
                parameters.1[parameters.1.len() - 1] = native_variadic_key(
                    world,
                    parameters.0[parameters.0.len() - 1],
                )?;
            }
            Result::Ok(
                NativeSignature {
                    parameter_types: parameters.0,
                    result_types: result_values.0,
                    parameter_type_keys: parameters.1,
                    result_type_keys: result_values.1,
                    variadic,
                },
            )
        },
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature { receiver: Some(_), .. },
        }) => Result::Err("methods are not package-level functions"),
        _ => Result::Err("function object has no signature"),
    }
}

fn native_receiver(world: go_types::World, receiver: go_types::TypeId) -> Result[
    NativeReceiver,
    string,
] {
    let resolved = go_types::unalias(world, receiver);
    let (named, pointer) = match go_types::get_type(world, resolved) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) => {
            (go_types::unalias(world, element), true)
        },
        _ => (resolved, false),
    };
    match go_types::get_type(world, named) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named { object, type_params, type_args, .. },
        }) => {
            if !type_params.is_empty() || !type_args.is_empty() {
                return Result::Err("generic native method receivers are not supported")
            }
            let value = world.objects[object.value];
            let package_id = value.owner.ok_or("native method receiver has no package owner")?;
            Result::Ok(
                NativeReceiver {
                    type_id: receiver,
                    package_id,
                    import_path: world.packages[package_id.value].path,
                    name: value.name,
                    pointer,
                },
            )
        },
        _ => Result::Err("native method receiver is not a named type"),
    }
}

fn native_callable_signature(world: go_types::World, signature: go_types::TypeId) -> Result[
    (NativeSignature, Option[NativeReceiver]),
    string,
] {
    match go_types::get_type(world, go_types::unalias(world, signature)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: Some(receiver),
                receiver_type_params,
                type_params,
                params,
                results,
                variadic,
            },
        }) => {
            if !receiver_type_params.is_empty() || !type_params.is_empty() {
                return Result::Err("generic native methods are not supported")
            }
            let receiver = native_receiver(world, receiver.type_id)?;
            let parameters = native_tuple(world, params)?;
            let result_values = native_tuple(world, results)?;
            let parameter_types = Vec::from_array([receiver.type_id]);
            let parameter_type_keys = Vec::from_array([native_type_key(world, receiver.type_id)?]);
            for value in parameters.0 {
                parameter_types.push(value)
            }
            for value in parameters.1 {
                parameter_type_keys.push(value)
            }
            if variadic {
                if parameter_types.len() < 2 {
                    return Result::Err("variadic method has no final parameter")
                }
                parameter_type_keys[parameter_type_keys.len() - 1] = native_variadic_key(
                    world,
                    parameter_types[parameter_types.len() - 1],
                )?;
            }
            Result::Ok(
                (
                    NativeSignature {
                        parameter_types,
                        result_types: result_values.0,
                        parameter_type_keys,
                        result_type_keys: result_values.1,
                        variadic,
                    },
                    Option::Some(receiver),
                ),
            )
        },
        _ => Result::Ok((native_signature(world, signature)?, Option::None)),
    }
}

fn generic_function_signature(world: go_types::World, signature: go_types::TypeId) -> bool {
    match go_types::type_data(world, go_types::unalias(world, signature)) {
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: None,
                receiver_type_params,
                type_params,
                params: _,
                results: _,
                variadic: _,
            },
        } => !receiver_type_params.is_empty() || !type_params.is_empty(),
        _ => false,
    }
}

fn native_type_has_parameter(world: go_types::World, type_id: go_types::TypeId) -> bool {
    let value = go_types::unalias(world, type_id);
    if go_types::is_type_parameter(world, value) {
        return true
    }
    match go_types::get_type(world, value) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Slice { element } }) => {
            native_type_has_parameter(world, element)
        },
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named { underlying, type_args, .. },
        }) => {
            if native_type_has_parameter(world, underlying) {
                return true
            }
            for argument in type_args {
                if native_type_has_parameter(world, argument) {
                    return true
                }
            }
            false
        },
        _ => false,
    }
}

fn native_candidate_compare(left: NativeCandidate, right: NativeCandidate) -> isize {
    if left.import_path < right.import_path {
        -1
    } else if left.import_path > right.import_path {
        1
    } else if left.symbol < right.symbol {
        -1
    } else if left.symbol > right.symbol {
        1
    } else if left.receiver_name < right.receiver_name {
        -1
    } else if left.receiver_name > right.receiver_name {
        1
    } else if !left.receiver_pointer && right.receiver_pointer {
        -1
    } else if left.receiver_pointer && !right.receiver_pointer {
        1
    } else if text::join(left.type_argument_keys, ",") < text::join(right.type_argument_keys, ",") {
        -1
    } else if text::join(left.type_argument_keys, ",") > text::join(right.type_argument_keys, ",") {
        1
    } else {
        0
    }
}

fn native_opaque_underlying(world: go_types::World, type_id: go_types::TypeId) -> bool {
    match go_types::get_type(world, go_types::underlying(world, type_id)) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Struct { .. } }) => true,
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Array { .. } }) => true,
        _ => false,
    }
}

fn native_path_included(paths: Vec[string], path: string) -> bool {
    for value in paths {
        if value == path {
            return true
        }
    }
    false
}

fn collect_native_type(
    program: execution::ExecutionProgram,
    paths: Vec[string],
    seen: collections::BitSet,
    values: Vec[NativeType],
    type_id: go_types::TypeId,
) -> () {
    if type_id.value < 0 || type_id.value >= program.world.types.len()
        || seen.contains(type_id.value) {
        return
    }
    let _ = seen.insert(type_id.value);
    match program.world.types[type_id.value].kind {
        go_types::TypeKind::Array { length: _, element } | go_types::TypeKind::Slice { element } | go_types::TypeKind::Pointer {
            element,
        } | go_types::TypeKind::Chan { direction: _, element } => {
            collect_native_type(program, paths, seen, values, element)
        },
        go_types::TypeKind::Struct { fields } => {
            for field in fields {
                collect_native_type(program, paths, seen, values, field.variable.type_id)
            }
        },
        go_types::TypeKind::Tuple { variables } => {
            for variable in variables {
                collect_native_type(program, paths, seen, values, variable.type_id)
            }
        },
        go_types::TypeKind::Signature {
            receiver,
            receiver_type_params: _,
            type_params: _,
            params,
            results,
            variadic: _,
        } => {
            if let Some(value) = receiver {
                collect_native_type(program, paths, seen, values, value.type_id)
            }
            collect_native_type(program, paths, seen, values, params);
            collect_native_type(program, paths, seen, values, results)
        },
        go_types::TypeKind::Interface { methods, embeddeds, comparable: _, implicit: _ } => {
            for method in methods {
                if method.value >= 0 && method.value < program.world.objects.len() {
                    collect_native_type(
                        program,
                        paths,
                        seen,
                        values,
                        program.world.objects[method.value].type_id,
                    )
                }
            }
            for embedded in embeddeds {
                collect_native_type(program, paths, seen, values, embedded)
            }
        },
        go_types::TypeKind::Map { key, value } => {
            collect_native_type(program, paths, seen, values, key);
            collect_native_type(program, paths, seen, values, value)
        },
        go_types::TypeKind::Named { object, underlying, type_params, type_args, .. } => {
            for argument in type_args {
                collect_native_type(program, paths, seen, values, argument)
            }
            if type_params.is_empty() && type_args.is_empty() && object.value >= 0
                && object.value < program.world.objects.len()
                && native_opaque_underlying(program.world, underlying) {
                let object_value = program.world.objects[object.value];
                match object_value.owner {
                    Some(package_id) => {
                        let package_index = execution_package_index(program, package_id);
                        if package_index >= 0 {
                            let package_value = program.packages[package_index];
                            if package_value.mode == execution::ExecutionMode::Native
                                && object_value.exported
                                && native_path_included(paths, package_value.path) {
                                values.push(
                                    NativeType {
                                        type_id,
                                        package_id,
                                        import_path: package_value.path,
                                        name: object_value.name,
                                        key: "native:" + package_value.path + "."
                                            + object_value.name,
                                    },
                                )
                            }
                        }
                    },
                    None => {},
                }
            } else {
                collect_native_type(program, paths, seen, values, underlying)
            }
        },
        go_types::TypeKind::Alias { object: _, rhs, type_params: _, type_args } => {
            for argument in type_args {
                collect_native_type(program, paths, seen, values, argument)
            }
            collect_native_type(program, paths, seen, values, rhs)
        },
        _ => {},
    }
}

fn collect_native_types(program: execution::ExecutionProgram) -> Vec[NativeType] {
    let values: Vec[NativeType] = Vec::new();
    let paths = direct_native_packages(program);
    let seen = collections::BitSet::new();
    for package_value in program.packages {
        if package_value.mode == execution::ExecutionMode::Interpreted {
            for fact in package_value.info.types {
                collect_native_type(program, paths, seen, values, fact.type_id)
            }
            for fact in package_value.info.defs {
                match fact.object {
                    Some(object) => if object.value >= 0
                        && object.value < program.world.objects.len() {
                        collect_native_type(
                            program,
                            paths,
                            seen,
                            values,
                            program.world.objects[object.value].type_id,
                        )
                    },
                    None => {},
                }
            }
            for fact in package_value.info.uses {
                match fact.object {
                    Some(object) => if object.value >= 0
                        && object.value < program.world.objects.len() {
                        collect_native_type(
                            program,
                            paths,
                            seen,
                            values,
                            program.world.objects[object.value].type_id,
                        )
                    },
                    None => {},
                }
            }
            for fact in package_value.info.selections {
                collect_native_type(program, paths, seen, values, fact.receiver_type);
                collect_native_type(program, paths, seen, values, fact.type_id)
            }
            for fact in package_value.info.instances {
                collect_native_type(program, paths, seen, values, fact.type_id);
                for argument in fact.type_args {
                    collect_native_type(program, paths, seen, values, argument)
                }
            }
        }
    }
    collections::sort_by(
        values,
        |left: NativeType, right: NativeType| if left.key < right.key {
            -1
        } else if left.key > right.key {
            1
        } else {
            left.type_id.value - right.type_id.value
        },
    );
    let result: Vec[NativeType] = Vec::new();
    for value in values {
        if result.is_empty() || result[result.len() - 1].key != value.key {
            result.push(value)
        }
    }
    result
}

fn native_diagnostic(
    package_value: execution::ExecutionPackage,
    node: syntax::NodeId,
    object: go_types::ObjectId,
    message: string,
) -> LowerDiagnostic {
    match package_value.syntax {
        Some(package_syntax) => match syntax::get_node(package_syntax.arena, node) {
            Some(value) => LowerDiagnostic {
                package_id: Option::Some(package_value.package_id),
                function: Option::Some(object),
                file: Option::Some(value.file),
                start: value.span.start,
                end: value.span.end,
                message,
            },
            None => LowerDiagnostic {
                package_id: Option::Some(package_value.package_id),
                function: Option::Some(object),
                file: Option::None,
                start: -1,
                end: -1,
                message,
            },
        },
        None => LowerDiagnostic {
            package_id: Option::Some(package_value.package_id),
            function: Option::Some(object),
            file: Option::None,
            start: -1,
            end: -1,
            message,
        },
    }
}

fn direct_native_packages(program: execution::ExecutionProgram) -> Vec[string] {
    let paths: collections::BTreeSet[string] = collections::BTreeSet::new();
    for package_value in program.packages {
        if package_value.mode == execution::ExecutionMode::Interpreted {
            for dependency in package_value.dependencies {
                let dependency_index = execution_package_index(program, dependency);
                if dependency_index >= 0 {
                    let value = program.packages[dependency_index];
                    if value.mode == execution::ExecutionMode::Native && value.path != "unsafe" {
                        let _ = paths.insert(value.path);
                    }
                }
            }
        }
    }
    paths.to_vec()
}

fn link_native_calls(program: execution::ExecutionProgram) -> NativeLinkResult {
    let candidates: Vec[NativeCandidate] = Vec::new();
    let diagnostics: Vec[LowerDiagnostic] = Vec::new();
    let selected = collections::BitSet::new();
    for source_package in program.packages {
        if source_package.mode == execution::ExecutionMode::Interpreted {
            for value in source_package.index.uses {
                match value.object {
                    Some(object_id) => if object_id.value >= 0
                        && object_id.value < program.world.objects.len() {
                        let object = program.world.objects[object_id.value];
                        let generic = generic_function_signature(program.world, object.type_id);
                        if !generic && selected.contains(object_id.value) {
                            continue
                        }
                        match object.owner {
                            Some(owner) => {
                                let owner_index = execution_package_index(program, owner);
                                if owner_index >= 0 {
                                    let owner_package = program.packages[owner_index];
                                    if owner_package.mode == execution::ExecutionMode::Native
                                        && object.kind == go_types::ObjectKind::Func {
                                        if native_intrinsic(owner_package.path, object.name) {
                                            continue
                                        }
                                        if !generic {
                                            let _ = selected.insert(object_id.value);
                                        }
                                        if !object.exported {
                                            diagnostics.push(
                                                native_diagnostic(
                                                    source_package,
                                                    value.node,
                                                    object_id,
                                                    "native link " + owner_package.path + "."
                                                        + object.name
                                                        + ": symbol is not exported",
                                                ),
                                            )
                                        } else {
                                            let mut signature = object.type_id;
                                            let mut candidate_object = object_id;
                                            let type_argument_keys: Vec[string] = Vec::from_array(
                                                [],
                                            );
                                            if generic {
                                                let instance = match execution::require_instance(
                                                    source_package.index,
                                                    value.node,
                                                ) {
                                                    Ok(instance) => Option::Some(instance),
                                                    Err(_) => Option::None,
                                                };
                                                match instance {
                                                    Some(instance) => {
                                                        signature = instance.type_id;
                                                        let mut deferred = false;
                                                        for argument in instance.type_args {
                                                            if native_type_has_parameter(
                                                                program.world,
                                                                argument,
                                                            ) {
                                                                deferred = true;
                                                                continue
                                                            }
                                                            match native_type_key(
                                                                program.world,
                                                                argument,
                                                            ) {
                                                                Ok(key) => type_argument_keys.push(
                                                                    key,
                                                                ),
                                                                Err(message) => diagnostics.push(
                                                                    native_diagnostic(
                                                                        source_package,
                                                                        value.node,
                                                                        object_id,
                                                                        "native link "
                                                                            + owner_package.path
                                                                            + "."
                                                                            + object.name
                                                                            + ": type argument "
                                                                            + message,
                                                                    ),
                                                                ),
                                                            }
                                                        }
                                                        if deferred {
                                                            continue
                                                        }
                                                        candidate_object = go_types::add_object(
                                                            program.world,
                                                            go_types::ObjectKind::Func,
                                                            object.name,
                                                            object.owner,
                                                            object.file,
                                                            object.node,
                                                            object.position,
                                                            signature,
                                                        );
                                                        execution::set_use(
                                                            source_package.index,
                                                            checker::ObjectFact {
                                                                node: value.node,
                                                                object: Option::Some(
                                                                    candidate_object,
                                                                ),
                                                            },
                                                        );
                                                    },
                                                    None => diagnostics.push(
                                                        native_diagnostic(
                                                            source_package,
                                                            value.node,
                                                            object_id,
                                                            "native link " + owner_package.path
                                                                + "."
                                                                + object.name
                                                                + ": generic call has no concrete instance",
                                                        ),
                                                    ),
                                                }
                                            }
                                            match native_callable_signature(
                                                program.world,
                                                signature,
                                            ) {
                                                Ok((shape, receiver)) => {
                                                    let (
                                                        package_id,
                                                        import_path,
                                                        receiver_name,
                                                        receiver_pointer,
                                                    ) = match receiver {
                                                        Some(receiver_value) => (
                                                            receiver_value.package_id,
                                                            receiver_value.import_path,
                                                            receiver_value.name,
                                                            receiver_value.pointer,
                                                        ),
                                                        None => (
                                                            owner,
                                                            owner_package.path,
                                                            "",
                                                            false,
                                                        ),
                                                    };
                                                    candidates.push(
                                                        NativeCandidate {
                                                            source_package,
                                                            node: value.node,
                                                            package_id,
                                                            object: candidate_object,
                                                            import_path,
                                                            symbol: object.name,
                                                            receiver_name,
                                                            receiver_pointer,
                                                            type_argument_keys,
                                                            signature,
                                                            shape,
                                                            exit: owner_package.path == "os"
                                                                && object.name == "Exit",
                                                        },
                                                    )
                                                },
                                                Err(message) => diagnostics.push(
                                                    native_diagnostic(
                                                        source_package,
                                                        value.node,
                                                        object_id,
                                                        "native link " + owner_package.path + "."
                                                            + object.name
                                                            + ": "
                                                            + message,
                                                    ),
                                                ),
                                            }
                                        }
                                    }
                                }
                            },
                            None => {},
                        }
                    },
                    None => {},
                }
            }
        }
    }
    collections::sort_by(candidates, native_candidate_compare);
    let calls: Vec[NativeCall] = Vec::with_capacity(candidates.len());
    let object_calls = native_option_slots(program.world.objects.len());
    for candidate in candidates {
        if !calls.is_empty() && calls[calls.len() - 1].import_path == candidate.import_path
            && calls[calls.len() - 1].symbol == candidate.symbol
            && calls[calls.len() - 1].receiver_name == candidate.receiver_name
            && calls[calls.len() - 1].receiver_pointer == candidate.receiver_pointer
            && calls[calls.len() - 1].type_argument_keys == candidate.type_argument_keys {
            let existing = calls[calls.len() - 1];
            execution::set_use(
                candidate.source_package.index,
                checker::ObjectFact { node: candidate.node, object: Option::Some(existing.object) },
            );
            continue
        }
        let id = native_call_id(calls.len());
        object_calls[candidate.object.value] = Option::Some(id);
        calls.push(
            NativeCall {
                id,
                package_id: candidate.package_id,
                object: candidate.object,
                import_path: candidate.import_path,
                symbol: candidate.symbol,
                receiver_name: candidate.receiver_name,
                receiver_pointer: candidate.receiver_pointer,
                type_argument_keys: candidate.type_argument_keys,
                signature: candidate.signature,
                parameter_types: candidate.shape.parameter_types,
                result_types: candidate.shape.result_types,
                parameter_type_keys: candidate.shape.parameter_type_keys,
                result_type_keys: candidate.shape.result_type_keys,
                variadic: candidate.shape.variadic,
                exit: candidate.exit,
            },
        )
    }
    NativeLinkResult {
        calls,
        types: collect_native_types(program),
        object_calls,
        initialization_packages: direct_native_packages(program),
        diagnostics,
    }
}

pub fn native_manifest(program: BytecodeProgram) -> Result[native_api::Manifest, string] {
    let calls: Vec[native_api::NativeCallSpec] = Vec::with_capacity(program.native_calls.len());
    let proxies: Vec[native_api::NativeProxySpec] = Vec::new();
    for call in program.native_calls {
        if call.id.value < 0 {
            return Result::Err("native call ID is negative")
        } else if call.exit {
            calls.push(native_api::exit_call(call.id.value.to_u32()))
        } else {
            if call.receiver_name != "" {
                calls.push(
                    native_api::method_call(
                        call.id.value.to_u32(),
                        call.import_path,
                        call.receiver_name,
                        call.receiver_pointer,
                        call.symbol,
                        call.parameter_type_keys,
                        call.result_type_keys,
                        call.variadic,
                    ),
                )
            } else if call.type_argument_keys.is_empty() {
                calls.push(
                    native_api::function_call(
                        call.id.value.to_u32(),
                        call.import_path,
                        call.symbol,
                        call.parameter_type_keys,
                        call.result_type_keys,
                        call.variadic,
                    ),
                )
            } else {
                calls.push(
                    native_api::generic_function_call(
                        call.id.value.to_u32(),
                        call.import_path,
                        call.symbol,
                        call.type_argument_keys,
                        call.parameter_type_keys,
                        call.result_type_keys,
                        call.variadic,
                    ),
                )
            }
        }
        let first_parameter = if call.receiver_name == "" {
            0
        } else {
            1
        };
        for parameter_index in first_parameter..call.parameter_types.len() {
            match native_proxy_spec(program.world, call.parameter_types[parameter_index]) {
                Ok(Some(proxy)) => {
                    let mut exists = false;
                    for current in proxies {
                        if same_proxy(current, proxy) {
                            exists = true;
                        }
                    }
                    if !exists {
                        proxies.push(proxy)
                    }
                },
                Ok(None) | Err(_) => {},
            };
        }
    }
    let manifest = native_api::new_manifest(program.native_initialization_packages, calls);
    for value in program.native_types {
        manifest.types.push(
            native_api::NativeTypeSpec {
                key: value.key,
                import_path: value.import_path,
                name: value.name,
            },
        )
    }
    let selected = collections::BitSet::new();
    for function in program.functions {
        for block in function.blocks {
            for instruction in block.instructions {
                match instruction.kind {
                    InstructionKind::NativeGlobalLoad { target: _, object } => if !selected.contains(
                        object.value,
                    ) {
                        let _ = selected.insert(object.value);
                        let value = program.world.objects[object.value];
                        let owner = value.owner.ok_or("native global has no package owner")?;
                        let import_path = program.world.packages[owner.value].path;
                        if import_path != "os" || value.name != "Args" {
                            manifest.globals.push(
                                native_api::NativeGlobalSpec {
                                    object_id: object.value,
                                    import_path,
                                    name: value.name,
                                },
                            )
                        }
                    },
                    _ => {},
                }
            }
        }
    }
    manifest.proxies = proxies;
    manifest.aggregates = native_aggregate_specs(program);
    native_api::canonical_manifest(manifest)
}
