}

#[test]
fn lowers_generic_functions_and_receiver_methods_on_demand() -> () {
    let result = lowered_fixture("generics");
    if !result.diagnostics.is_empty() {
        testing::fail(result.diagnostics[0].message);
        return
    }
    let program = testing::expect_some(result.program, "bytecode program is missing");
