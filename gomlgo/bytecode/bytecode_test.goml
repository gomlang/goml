package bytecode;

use gomlgo::syntax;
use gomlgo::types as go_types;
use gomlgo::execution;
use std::env;
use std::path;
use std::testing;

fn execution_fixture(name: string) -> string {
    path::join(
        path::join(env::current_dir_structured().unwrap_or("."), "testdata/execute/pure"),
        name,
    )
}

fn minimal_program() -> BytecodeProgram {
    let world = go_types::new_world();
    let package_id = go_types::add_package(world, "example.com/main", "main", world.universe, true);
    let empty_tuple = go_types::add_type(world, go_types::TypeKind::Tuple { variables: Vec::new() });
    let signature = go_types::add_type(
        world,
        go_types::TypeKind::Signature {
            receiver: Option::None,
            receiver_type_params: Vec::new(),
            type_params: Vec::new(),
            params: empty_tuple,
            results: empty_tuple,
            variadic: false,
        },
    );
    let object = go_types::add_object(
        world,
        go_types::ObjectKind::Func,
        "main",
        Option::Some(package_id),
        Option::Some(syntax::file_id(0)),
        Option::None,
        0,
        signature,
    );
    let _ = go_types::insert(world, world.packages[package_id.value].scope, "main", object);
    let function = function_id(0);
    let location = CodeLocation { file: syntax::file_id(0), start: 0, end: 0 };
    let object_functions: Vec[Option[FunctionId]] = Vec::with_capacity(world.objects.len());
    let object_globals: Vec[Option[GlobalId]] = Vec::with_capacity(world.objects.len());
    for index in 0..world.objects.len() {
        object_functions.push(
            if index == object.value {
                Option::Some(function)
            } else {
                Option::None
            },
        );
        object_globals.push(Option::None)
    }
    BytecodeProgram {
        world,
        packages: Vec::from_array(
            [
                BytecodePackage {
                    package_id,
                    path: "example.com/main",
                    functions: Vec::from_array([function]),
                    globals: Vec::new(),
                    initializer: Option::None,
                },
            ],
        ),
        functions: Vec::from_array(
            [
                BytecodeFunction {
                    id: function,
                    package_id,
                    object,
                    name: "main",
                    signature,
                    register_types: Vec::new(),
                    place_count: 0,
                    locals: Vec::new(),
                    captures: Vec::new(),
                    parameters: Vec::new(),
                    results: Vec::new(),
                    blocks: Vec::from_array(
                        [
                            BasicBlock {
                                id: block_id(0),
                                parameters: Vec::new(),
                                instructions: Vec::new(),
                                terminator: Terminator {
                                    kind: TerminatorKind::Return { values: Vec::new() },
                                    location,
                                },
                            },
                        ],
                    ),
                    entry: block_id(0),
                },
            ],
        ),
        globals: Vec::new(),
        object_functions,
        object_globals,
        native_calls: Vec::new(),
        native_types: Vec::new(),
        object_native_calls: native_option_slots(world.objects.len()),
        native_initialization_packages: Vec::new(),
        source_files: Vec::from_array(
            [BytecodeSourceFile { package_id, file: syntax::file_id(0), name: "main.go" }],
        ),
        initialization_order: Vec::from_array([package_id]),
        main: function,
    }
}

fn contains_message(diagnostics: Vec[VerifyDiagnostic], message: string) -> bool {
    for diagnostic in diagnostics {
        if diagnostic.message.contains(message) {
            return true
        }
    }
    false
}

#[test]
fn verifies_a_minimal_typed_function() -> () {
    testing::assert_eq(verify(minimal_program()).len(), 0)
}

#[test]
fn reports_invalid_control_flow_without_indexing_the_target() -> () {
    let program = minimal_program();
    program.functions[0].blocks[0].terminator.kind = TerminatorKind::Jump {
        target: block_id(50),
        arguments: Vec::new(),
    };
    let diagnostics = verify(program);
    testing::assert(contains_message(diagnostics, "invalid block 50"))
}

#[test]
fn reports_instruction_type_and_location_errors() -> () {
    let program = minimal_program();
    let bool_type = testing::expect_some(
        go_types::basic_type(program.world, "bool"),
        "missing bool type",
    );
    let int_type = testing::expect_some(
        go_types::basic_type(program.world, "int"),
        "missing int type",
    );
    program.functions[0].register_types.push(bool_type);
    let location = CodeLocation { file: syntax::file_id(-2), start: 0, end: 1 };
    program.functions[0].blocks[0].instructions.push(
        Instruction {
            kind: InstructionKind::Constant {
                target: register_id(0),
                type_id: int_type,
                constant_kind: "Int",
                exact: "1",
            },
            location,
        },
    );
    let diagnostics = verify(program);
    testing::assert(contains_message(diagnostics, "target register type"));
    testing::assert(contains_message(diagnostics, "invalid source file"))
}

#[test]
fn reports_malformed_allocate_assertion_map_and_dynamic_call() -> () {
    let program = minimal_program();
    let bool_type = testing::expect_some(
        go_types::basic_type(program.world, "bool"),
        "missing bool type",
    );
    let int_type = testing::expect_some(
        go_types::basic_type(program.world, "int"),
        "missing int type",
    );
    let string_type = testing::expect_some(
        go_types::basic_type(program.world, "string"),
        "missing string type",
    );
    let pointer_type = go_types::add_type(
        program.world,
        go_types::TypeKind::Pointer { element: int_type },
    );
    let map_type = go_types::add_type(
        program.world,
        go_types::TypeKind::Map { key: int_type, value: string_type },
    );
    let comparable_interface = go_types::add_type(
        program.world,
        go_types::TypeKind::Interface {
            methods: Vec::new(),
            embeddeds: Vec::new(),
            comparable: true,
            implicit: false,
        },
    );
    let slice_type = go_types::add_type(
        program.world,
        go_types::TypeKind::Slice { element: int_type },
    );
    program.functions[0].register_types = Vec::from_array(
        [pointer_type, bool_type, map_type, bool_type, int_type, comparable_interface, slice_type],
    );
    let location = program.functions[0].blocks[0].terminator.location;
    program.functions[0].blocks[0].instructions = Vec::from_array(
        [
            Instruction {
                kind: InstructionKind::Allocate {
                    target: register_id(0),
                    type_id: int_type,
                    value: Option::Some(register_id(1)),
                },
                location,
            },
            Instruction {
                kind: InstructionKind::TypeAssert {
                    target: register_id(4),
                    ok: Option::Some(register_id(4)),
                    source: register_id(1),
                    type_id: int_type,
                },
                location,
            },
            Instruction {
                kind: InstructionKind::TypeAssert {
                    target: register_id(6),
                    ok: Option::Some(register_id(3)),
                    source: register_id(5),
                    type_id: slice_type,
                },
                location,
            },
            Instruction {
                kind: InstructionKind::MapSet {
                    map: register_id(2),
                    key: register_id(3),
                    value: register_id(4),
                },
                location,
            },
            Instruction {
                kind: InstructionKind::Call {
                    results: Vec::new(),
                    target: CallTarget::Dynamic(register_id(1)),
                    arguments: Vec::new(),
                    variadic: false,
                },
                location,
            },
        ],
    );
    let diagnostics = verify(program);
    testing::assert(contains_message(diagnostics, "allocated value type"));
    testing::assert(contains_message(diagnostics, "type assertion ok register"));
    testing::assert(contains_message(diagnostics, "type assertion source"));
    testing::assert(contains_message(diagnostics, "type assertion target is not assertable"));
    testing::assert(contains_message(diagnostics, "map key register type"));
    testing::assert(contains_message(diagnostics, "map value register type"));
    testing::assert(contains_message(diagnostics, "dynamic call target"))
}

#[test]
fn reports_malformed_channel_and_select_instructions() -> () {
    let program = minimal_program();
    let bool_type = testing::expect_some(
        go_types::basic_type(program.world, "bool"),
        "missing bool type",
    );
    let int_type = testing::expect_some(
        go_types::basic_type(program.world, "int"),
        "missing int type",
    );
    let string_type = testing::expect_some(
        go_types::basic_type(program.world, "string"),
        "missing string type",
    );
    let send_channel = go_types::add_type(
        program.world,
        go_types::TypeKind::Chan { direction: 1, element: int_type },
    );
    let receive_channel = go_types::add_type(
        program.world,
        go_types::TypeKind::Chan { direction: 2, element: int_type },
    );
    program.functions[0].register_types = Vec::from_array(
        [receive_channel, send_channel, string_type, int_type, bool_type],
    );
    let location = program.functions[0].blocks[0].terminator.location;
    program.functions[0].blocks[0].instructions = Vec::from_array(
        [
            Instruction {
                kind: InstructionKind::Send { channel: register_id(0), value: register_id(2) },
                location,
            },
            Instruction {
                kind: InstructionKind::Receive {
                    value: register_id(2),
                    ok: Option::Some(register_id(3)),
                    channel: register_id(1),
                },
                location,
            },
            Instruction { kind: InstructionKind::Close { channel: register_id(0) }, location },
            Instruction {
                kind: InstructionKind::Select {
                    chosen: register_id(4),
                    cases: Vec::from_array(
                        [
                            SelectCase {
                                operation: SelectOperation::Default,
                                target: block_id(0),
                                arguments: Vec::new(),
                            },
                            SelectCase {
                                operation: SelectOperation::Default,
                                target: block_id(0),
                                arguments: Vec::new(),
                            },
                        ],
                    ),
                },
                location,
            },
        ],
    );
    let diagnostics = verify(program);
    testing::assert(contains_message(diagnostics, "channel send source is receive-only"));
    testing::assert(
        contains_message(diagnostics, "channel send value type does not match channel element"),
    );
    testing::assert(contains_message(diagnostics, "channel receive source is send-only"));
    testing::assert(
        contains_message(diagnostics, "channel receive value type does not match channel element"),
    );
    testing::assert(contains_message(diagnostics, "channel receive ok register is not bool"));
    testing::assert(contains_message(diagnostics, "channel close source is receive-only"));
    testing::assert(contains_message(diagnostics, "select chosen register is not integer"));
    testing::assert(contains_message(diagnostics, "select has multiple default cases"))
}

#[test]
fn reports_invalid_global_and_duplicate_initialization_metadata() -> () {
    let program = minimal_program();
    let function = program.functions[0];
    program.globals.push(
        Global {
            id: global_id(0),
            package_id: function.package_id,
            object: function.object,
            name: "bad",
            type_id: function.signature,
        },
    );
    program.object_globals[function.object.value] = Option::Some(global_id(0));
    program.packages[0].globals.push(global_id(0));
    program.initialization_order.push(function.package_id);
    let diagnostics = verify(program);
    testing::assert(contains_message(diagnostics, "global object is not a variable"));
    testing::assert(contains_message(diagnostics, "duplicate package"))
}

#[test]
fn rejects_runtime_types_with_unsubstituted_type_parameters() -> () {
    let program = minimal_program();
    let function = program.functions[0];
    let parameter = go_types::add_type(
        program.world,
        go_types::TypeKind::TypeParam {
            object: function.object,
            constraint: program.world.invalid,
            index: 0,
        },
    );
    program.functions[0].register_types.push(parameter);
    let diagnostics = verify(program);
    testing::assert(contains_message(diagnostics, "register type contains a type parameter"))
}

#[test]
fn detects_type_parameters_after_recursive_type_edges() -> () {
    let program = minimal_program();
    let function = program.functions[0];
    let recursive = go_types::add_type(program.world, go_types::TypeKind::Invalid);
    let pointer = go_types::add_type(
        program.world,
        go_types::TypeKind::Pointer { element: recursive },
    );
    let parameter = go_types::add_type(
        program.world,
        go_types::TypeKind::TypeParam {
            object: function.object,
            constraint: program.world.invalid,
            index: 0,
        },
    );
    testing::assert(
        go_types::set_type(
            program.world,
            recursive,
            go_types::TypeKind::Tuple {
                variables: Vec::from_array(
                    [
                        go_types::Variable {
                            name: "recursive",
                            owner: Option::None,
                            type_id: pointer,
                        },
                        go_types::Variable {
                            name: "parameter",
                            owner: Option::None,
                            type_id: parameter,
                        },
                    ],
                ),
            },
        ),
    );
    program.functions[0].register_types.push(recursive);
    let diagnostics = verify(program);
    testing::assert(contains_message(diagnostics, "register type contains a type parameter"))
}

#[test]
fn lowers_typed_functions_assignments_and_control_flow() -> () {
    let file = path::join(execution_fixture("control"), "main.go");
    let loaded = testing::expect_ok(
        execution::load_files(execution::default_config(), Vec::from_array([file])),
        "execution loading failed",
    );
    if !loaded.diagnostics.is_empty() {
        testing::fail(loaded.diagnostics[0].message);
        return
    }
    let result = lower(testing::expect_some(loaded.program, "execution program is missing"));
    if !result.diagnostics.is_empty() {
        testing::fail(result.diagnostics[0].message);
        return
    }
    let program = testing::expect_some(result.program, "bytecode program is missing");
    testing::assert_eq(program.functions.len(), 3);
    let verification = verify(program);
    if !verification.is_empty() {
        testing::fail(verification[0].message)
    }
    testing::assert(program.functions[program.main.value].blocks.len() >= 8)
}

fn lowered_fixture(name: string) -> LowerResult {
    let file = path::join(execution_fixture(name), "main.go");
    let loaded = testing::expect_ok(
        execution::load_files(execution::default_config(), Vec::from_array([file])),
        "execution loading failed",
    );
    if !loaded.diagnostics.is_empty() {
        testing::fail(loaded.diagnostics[0].message);
        return LowerResult { program: Option::None, diagnostics: Vec::new() }
    }
    lower(testing::expect_some(loaded.program, "execution program is missing"))
}

fn lowered_file(file: string) -> LowerResult {
    let loaded = testing::expect_ok(
        execution::load_files(execution::default_config(), Vec::from_array([file])),
        "execution loading failed",
    );
    if !loaded.diagnostics.is_empty() {
        testing::fail(loaded.diagnostics[0].message);
        return LowerResult { program: Option::None, diagnostics: Vec::new() }
    }
    lower(testing::expect_some(loaded.program, "execution program is missing"))
}

#[test]
fn lowers_type_switches_with_typed_case_bindings() -> () {
    let result = lowered_fixture("type_switch");
    if !result.diagnostics.is_empty() {
        testing::fail(result.diagnostics[0].message);
        return
    }
    let program = testing::expect_some(result.program, "bytecode program is missing");
