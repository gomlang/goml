#[test]
fn omits_unsupported_compiler_generated_aggregate_shells() -> () {
    let result = lowered_fixture("generated_iterator_shell");
    if !result.diagnostics.is_empty() {
        testing::fail(result.diagnostics[0].message);
        return
    }
    let program = testing::expect_some(result.program, "bytecode program is missing");
    let manifest = testing::expect_ok(native_manifest(program), "native manifest failed");
    testing::assert(manifest.aggregates.is_empty())
}

#[test]
fn lowers_gomlc_lexical_task_scope_product_with_native_methods() -> () {
    let root = env::current_dir_structured().unwrap_or(".");
    let repository = path::parent(root).unwrap_or(root);
    let file = path::join(repository, "gomlc/testdata/pipeline/242_lexical_task_scope/main.goml.go");
    let result = lowered_file(file);
    if !result.diagnostics.is_empty() {
        testing::fail(result.diagnostics[0].message);
        return
    }
    let program = testing::expect_some(result.program, "bytecode program is missing");
    let verification = verify(program);
    if !verification.is_empty() {
        testing::fail(verification[0].message)
    }
    let methods = Ref::new(0);
    let mutex = Ref::new(false);
    let wait_group = Ref::new(false);
    for call in program.native_calls {
        if call.receiver_name != "" {
            methods.set(methods.get() + 1)
        }
    }
    for type_value in program.native_types {
        if type_value.import_path == "sync" && type_value.name == "Mutex" {
            mutex.set(true)
        } else if type_value.import_path == "sync" && type_value.name == "WaitGroup" {
            wait_group.set(true)
        }
    }
    if methods.get() < 5 {
        testing::fail(f"native method count is {methods.get()}")
    } else if !mutex.get() {
        testing::fail("sync.Mutex native type is missing")
    } else if !wait_group.get() {
        testing::fail("sync.WaitGroup native type is missing")
    }
    let manifest = testing::expect_ok(native_manifest(program), "native manifest failed");
    if manifest.calls.len() < methods.get() {
        testing::fail("native manifest omitted method calls")
    } else if manifest.types.len() < 2 {
        testing::fail("native manifest omitted native types")
    }
}

fn native_call_instruction_count(program: BytecodeProgram) -> isize {
    let count = Ref::new(0);
    for function in program.functions {
        for block in function.blocks {
            for instruction in block.instructions {
                match instruction.kind {
                    InstructionKind::Call {
                        results: _,
                        target: CallTarget::Native(_),
                        arguments: _,
                        variadic: _,
                    } => count.set(count.get() + 1),
                    _ => {},
                }
            }
        }
    }
    count.get()
}

#[test]
#[ignore("loads four Go 1.26 standard-library packages")]
fn links_used_standard_library_functions_to_a_deterministic_manifest() -> () {
    let result = lowered_fixture("native_calls");
    if !result.diagnostics.is_empty() {
        testing::fail(result.diagnostics[0].message);
        return
    }
    let program = testing::expect_some(result.program, "bytecode program is missing");
    testing::assert_eq(program.packages.len(), 1);
    testing::assert_eq(program.native_calls.len(), 4);
    testing::assert_eq(program.native_calls[0].id.value, 0);
    testing::assert_eq(program.native_calls[0].import_path, "math");
    testing::assert_eq(program.native_calls[0].symbol, "Sqrt");
    testing::assert_eq(program.native_calls[0].parameter_type_keys.len(), 1);
    testing::assert_eq(program.native_calls[0].parameter_type_keys[0], "float64");
    testing::assert_eq(program.native_calls[0].result_type_keys.len(), 1);
    testing::assert_eq(program.native_calls[0].result_type_keys[0], "float64");
    testing::assert_eq(program.native_calls[1].id.value, 1);
    testing::assert_eq(program.native_calls[1].import_path, "path");
    testing::assert_eq(program.native_calls[1].symbol, "Join");
    testing::assert(program.native_calls[1].variadic);
    testing::assert_eq(program.native_calls[2].id.value, 2);
    testing::assert_eq(program.native_calls[2].import_path, "strconv");
    testing::assert_eq(program.native_calls[2].symbol, "Itoa");
    testing::assert_eq(program.native_calls[3].id.value, 3);
    testing::assert_eq(program.native_calls[3].import_path, "strings");
    testing::assert_eq(program.native_calls[3].symbol, "ToUpper");
    testing::assert_eq(native_call_instruction_count(program), 4);
    for call in program.native_calls {
        testing::assert(program.object_functions[call.object.value].is_none());
        testing::assert_eq(
            testing::expect_some(
                program.object_native_calls[call.object.value],
                "native object mapping is missing",
            ).value,
            call.id.value,
        )
    }
    let manifest = testing::expect_ok(native_manifest(program), "native manifest failed");
    testing::assert_eq(manifest.calls.len(), 4);
    testing::assert_eq(manifest.calls[0].call_id, 0.to_u32());
    testing::assert_eq(manifest.calls[1].call_id, 1.to_u32());
    testing::assert_eq(manifest.calls[2].call_id, 2.to_u32());
    testing::assert_eq(manifest.calls[3].call_id, 3.to_u32())
}

#[test]
#[ignore("loads the Go 1.26 slices package")]
fn links_and_deduplicates_concrete_standard_library_generic_instances() -> () {
    let result = lowered_fixture("native_generics");
    if !result.diagnostics.is_empty() {
        testing::fail(result.diagnostics[0].message);
        return
    }
    let program = testing::expect_some(result.program, "bytecode program is missing");
    testing::assert_eq(verify(program).len(), 0);
    testing::assert_eq(program.native_calls.len(), 2);
    testing::assert_eq(program.native_calls[0].import_path, "slices");
    testing::assert_eq(program.native_calls[0].symbol, "Clone");
    testing::assert_eq(program.native_calls[0].type_argument_keys.len(), 2);
    testing::assert_eq(program.native_calls[0].type_argument_keys[0], "[]int");
    testing::assert_eq(program.native_calls[0].type_argument_keys[1], "int");
    testing::assert_eq(program.native_calls[1].type_argument_keys.len(), 2);
    testing::assert_eq(program.native_calls[1].type_argument_keys[0], "[]string");
    testing::assert_eq(program.native_calls[1].type_argument_keys[1], "string");
    testing::assert_eq(native_call_instruction_count(program), 4);
    let manifest = testing::expect_ok(native_manifest(program), "native manifest failed");
    testing::assert_eq(manifest.calls.len(), 2);
    testing::assert_eq(manifest.calls[0].type_argument_keys.len(), 2);
    testing::assert_eq(manifest.calls[0].type_argument_keys[0], "[]int");
    testing::assert_eq(manifest.calls[0].type_argument_keys[1], "int");
    testing::assert_eq(manifest.calls[1].type_argument_keys.len(), 2);
    testing::assert_eq(manifest.calls[1].type_argument_keys[0], "[]string");
    testing::assert_eq(manifest.calls[1].type_argument_keys[1], "string")
}

#[test]
fn supports_native_opaque_pointer_results() -> () {
    let result = lowered_fixture("native_unsupported");
    if !result.diagnostics.is_empty() {
        testing::fail(result.diagnostics[0].message);
        return
    }
    let program = testing::expect_some(result.program, "bytecode program is missing");
    testing::assert_eq(program.native_calls.len(), 1);
    testing::assert_eq(program.native_calls[0].result_type_keys.len(), 1);
    testing::assert_eq(program.native_calls[0].result_type_keys[0], "native:*bytes.Buffer");
    let found = Ref::new(false);
    for value in program.native_types {
        if value.key == "native:bytes.Buffer" {
            found.set(true)
        }
    }
    testing::assert(found.get())
}

#[test]
fn registers_referenced_native_globals() -> () {
    let result = lowered_fixture("native_globals");
    if !result.diagnostics.is_empty() {
        testing::fail(result.diagnostics[0].message);
        return
    }
    let program = testing::expect_some(result.program, "bytecode program is missing");
    let manifest = testing::expect_ok(native_manifest(program), "native manifest failed");
    testing::assert_eq(manifest.globals.len(), 2);
    let unexpected_eof = Ref::new(false);
    let stderr = Ref::new(false);
    for value in manifest.globals {
        if value.import_path == "io" && value.name == "ErrUnexpectedEOF" {
            unexpected_eof.set(true)
        } else if value.import_path == "os" && value.name == "Stderr" {
            stderr.set(true)
        }
    }
    testing::assert(unexpected_eof.get());
    testing::assert(stderr.get())
}
