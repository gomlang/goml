package bytecode;

use gomlgo::execution;
use gomlgo::checker;
use gomlgo::syntax;
use gomlgo::types as go_types;
use std::collections;
use std::num;

struct FunctionSource {
    template: isize,
    package_index: isize,
    declaration: syntax::NodeId,
    receiver: Option[syntax::NodeId],
    name: syntax::NodeId,
    type_node: syntax::NodeId,
    body: syntax::NodeId,
    object: go_types::ObjectId,
    function: FunctionId,
    type_parameters: Vec[go_types::TypeParameter],
    type_arguments: Vec[go_types::TypeId],
    signature: go_types::TypeId,
    literal: bool,
}

struct FunctionInstance {
    object: go_types::ObjectId,
    type_arguments: Vec[go_types::TypeId],
    function: FunctionId,
}

struct FunctionCaptures {
    objects: Vec[go_types::ObjectId],
}

struct CaptureUse {
    file: syntax::FileId,
    start: isize,
    end: isize,
    object: go_types::ObjectId,
}

struct FunctionSourceRange {
    source: isize,
    package_index: isize,
    file: isize,
    start: isize,
    end: isize,
    literal: bool,
}

fn compare_function_source_range(left: FunctionSourceRange, right: FunctionSourceRange) -> isize {
    if left.package_index != right.package_index {
        left.package_index - right.package_index
    } else if left.file != right.file {
        left.file - right.file
    } else if left.start != right.start {
        left.start - right.start
    } else if left.literal != right.literal {
        if left.literal {
            1
        } else {
            -1
        }
    } else if left.end != right.end {
        right.end - left.end
    } else {
        left.source - right.source
    }
}

fn compare_capture_use(left: CaptureUse, right: CaptureUse) -> isize {
    if left.file.value != right.file.value {
        left.file.value - right.file.value
    } else if left.start != right.start {
        left.start - right.start
    } else if left.end != right.end {
        left.end - right.end
    } else {
        left.object.value - right.object.value
    }
}

fn first_capture_use_at_or_after(uses: Vec[CaptureUse], file: syntax::FileId, start: isize) -> isize {
    let mut low = 0;
    let mut high = uses.len();
    while low < high {
        let middle = low + (high - low) / 2;
        let usage = uses[middle];
        if usage.file.value < file.value || (usage.file.value == file.value && usage.start < start) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    low
}

struct IndexedRangeSource {
    source_type: go_types::TypeId,
    source: RegisterId,
    int_type: go_types::TypeId,
    bool_type: go_types::TypeId,
    rune_type: go_types::TypeId,
    integer: bool,
    string_value: bool,
    element_type: Option[go_types::TypeId],
    source_place: Option[PlaceId],
    fixed_length: isize,
}

enum LoweredRangeSource {
    Indexed(IndexedRangeSource),
    Map {
        source: RegisterId,
        key_type: go_types::TypeId,
        value_type: go_types::TypeId,
    },
    Channel {
        source: RegisterId,
        element_type: go_types::TypeId,
    },
}

struct RangeBound {
    index_type: go_types::TypeId,
    value: RegisterId,
}

struct RangeIterationValue {
    width: Option[RegisterId],
    value: Option[RegisterId],
}

struct OpenBlock {
    id: BlockId,
    parameters: Vec[RegisterId],
    instructions: Vec[Instruction],
    terminator: Option[Terminator],
}

struct FunctionBuilder {
    world: go_types::World,
    syntax: syntax::PackageSyntax,
    index: execution::TypeInfoIndex,
    package_id: go_types::PackageId,
    object: go_types::ObjectId,
    function: FunctionId,
    signature: go_types::TypeId,
    object_functions: Vec[Option[FunctionId]],
    object_globals: Vec[Option[GlobalId]],
    object_native_calls: Vec[Option[NativeCallId]],
    native_calls: Vec[NativeCall],
    function_templates: Vec[FunctionSource],
    function_template_indices: HashMap[isize, isize],
    function_instances: Vec[FunctionInstance],
    function_instance_indices: Vec[Vec[isize]],
    pending_functions: Vec[FunctionSource],
    next_function: Ref[isize],
    literal_functions: HashMap[string, isize],
    template_capture_objects: Vec[FunctionCaptures],
    function_capture_objects: Vec[FunctionCaptures],
    type_parameters: Vec[go_types::TypeParameter],
    type_arguments: Vec[go_types::TypeId],
    register_types: Vec[go_types::TypeId],
    place_count: Ref[isize],
    locals: Vec[Local],
    object_locals: HashMap[isize, LocalId],
    captures: Vec[LocalId],
    parameters: Vec[LocalId],
    results: Vec[LocalId],
    blocks: Vec[OpenBlock],
    current: Ref[BlockId],
    break_targets: Vec[BlockId],
    continue_targets: Vec[BlockId],
    fallthrough_targets: Vec[BlockId],
    break_labels: HashMap[string, BlockId],
    continue_labels: HashMap[string, BlockId],
    labels: HashMap[string, BlockId],
}

struct SwitchClause {
    node: syntax::NodeId,
    expressions: Vec[syntax::NodeId],
    body: Vec[syntax::NodeId],
    target: BlockId,
}

struct TypeSwitchBinding {
    local: LocalId,
    parameter: RegisterId,
}

struct TypeSwitchClause {
    node: syntax::NodeId,
    expressions: Vec[syntax::NodeId],
    body: Vec[syntax::NodeId],
    entry: BlockId,
    target: BlockId,
    binding: Option[TypeSwitchBinding],
}

struct SelectReceiveBinding {
    left: Vec[syntax::NodeId],
    token: string,
    value: RegisterId,
    ok: Option[RegisterId],
}

struct SelectClause {
    node: syntax::NodeId,
    communication: Option[syntax::NodeId],
    body: Vec[syntax::NodeId],
    target: BlockId,
    receive: Ref[Option[SelectReceiveBinding]],
}

enum AssignmentTarget {
    Place(Option[PlaceId]),
    Map {
        map: RegisterId,
        key: RegisterId,
    },
}

fn option_slots[T](count: isize) -> Vec[Option[T]] {
    let result: Vec[Option[T]] = Vec::with_capacity(count);
    for _ in 0..count {
        result.push(Option::None)
    }
    result
}

fn int_vector_slots(count: isize) -> Vec[Vec[isize]] {
    let result: Vec[Vec[isize]] = Vec::with_capacity(count);
    for _ in 0..count {
        result.push(Vec::new())
    }
    result
}

fn lower_diagnostic(
    package_id: Option[go_types::PackageId],
    function: Option[go_types::ObjectId],
    node: Option[syntax::SyntaxNode],
    message: string,
) -> LowerDiagnostic {
    match node {
        Some(value) => LowerDiagnostic {
            package_id,
            function,
            file: Option::Some(value.file),
            start: value.span.start,
            end: value.span.end,
            message,
        },
        None => LowerDiagnostic {
            package_id,
            function,
            file: Option::None,
            start: -1,
            end: -1,
            message,
        },
    }
}

fn package_node(package_value: execution::ExecutionPackage, node: syntax::NodeId) -> Option[
    syntax::SyntaxNode,
] {
    package_value.syntax.and_then(|value| syntax::get_node(value.arena, node))
}

fn signature_type_parameters(world: go_types::World, signature: go_types::TypeId) -> Vec[
    go_types::TypeParameter,
] {
    let result: Vec[go_types::TypeParameter] = Vec::new();
    match go_types::type_data(world, go_types::unalias(world, signature)) {
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: _,
                receiver_type_params,
                type_params,
                params: _,
                results: _,
                variadic: _,
            },
        } => {
            for parameter in receiver_type_params {
                result.push(parameter)
            }
            for parameter in type_params {
                result.push(parameter)
            }
        },
        _ => {},
    }
    result
}

fn collect_function_sources(
    program: execution::ExecutionProgram,
    object_functions: Vec[Option[FunctionId]],
    object_globals: Vec[Option[GlobalId]],
    literal_functions: HashMap[string, isize],
    diagnostics: Vec[LowerDiagnostic],
) -> Vec[FunctionSource] {
    let sources: Vec[FunctionSource] = Vec::new();
    for package_index in 0..program.packages.len() {
        let package_value = program.packages[package_index];
        if package_value.mode == execution::ExecutionMode::Interpreted {
            match package_value.syntax {
                Some(package_syntax) => for file in package_syntax.files {
                    match syntax::get_node(package_syntax.arena, file.root) {
                        Some(syntax::SyntaxNode {
                            id: _,
                            file: _,
                            span: _,
                            path: _,
                            kind: syntax::SyntaxKind::File {
                                package_pos: _,
                                name: _,
                                declarations,
                                imports: _,
                                go_version: _,
                            },
                        }) => for declaration in declarations {
                            match syntax::get_node(package_syntax.arena, declaration) {
                                Some(syntax::SyntaxNode {
                                    id: _,
                                    file: _,
                                    span: _,
                                    path: _,
                                    kind: syntax::SyntaxKind::FuncDecl {
                                        receiver,
                                        name,
                                        type_node,
                                        body: Some(body),
                                    },
                                }) => match execution::require_definition_index(
                                    package_value.index,
                                    name,
                                ) {
                                    Ok(fact_index) => match package_value.index.definitions[fact_index].object {
                                        Some(object) => if object.value >= 0
                                            && object.value < object_functions.len() {
                                            if object_functions[object.value].is_some() {
                                                diagnostics.push(
                                                    lower_diagnostic(
                                                        Option::Some(package_value.package_id),
                                                        Option::Some(object),
                                                        package_node(package_value, declaration),
                                                        "function object has multiple bodies",
                                                    ),
                                                )
                                            } else {
                                                let function = function_id(-1);
                                                object_functions[object.value] = Option::Some(
                                                    function,
                                                );
                                                let signature = program.world.objects[object.value].type_id;
                                                sources.push(
                                                    FunctionSource {
                                                        template: sources.len(),
                                                        package_index,
                                                        declaration,
                                                        receiver,
                                                        name,
                                                        type_node,
                                                        body,
                                                        object,
                                                        function,
                                                        type_parameters: signature_type_parameters(
                                                            program.world,
                                                            signature,
                                                        ),
                                                        type_arguments: Vec::new(),
                                                        signature,
                                                        literal: false,
                                                    },
                                                )
                                            }
                                        } else {
                                            diagnostics.push(
                                                lower_diagnostic(
                                                    Option::Some(package_value.package_id),
                                                    Option::Some(object),
                                                    package_node(package_value, declaration),
                                                    "function object is outside the world",
                                                ),
                                            )
                                        },
                                        None => diagnostics.push(
                                            lower_diagnostic(
                                                Option::Some(package_value.package_id),
                                                Option::None,
                                                package_node(package_value, name),
                                                "function declaration has no object",
                                            ),
                                        ),
                                    },
                                    Err(message) => diagnostics.push(
                                        lower_diagnostic(
                                            Option::Some(package_value.package_id),
                                            Option::None,
                                            package_node(package_value, name),
                                            message,
                                        ),
                                    ),
                                },
                                _ => {},
                            }
                        },
                        _ => diagnostics.push(
                            lower_diagnostic(
                                Option::Some(package_value.package_id),
                                Option::None,
                                Option::None,
                                "package file has no syntax root",
                            ),
                        ),
                    }
                },
                None => diagnostics.push(
                    lower_diagnostic(
                        Option::Some(package_value.package_id),
                        Option::None,
                        Option::None,
                        "interpreted package has no syntax",
                    ),
                ),
            }
            match package_value.syntax {
                Some(package_syntax) => for node_value in package_syntax.arena.nodes {
                    let Some(node) = node_value else {
                        continue
                    };
                    match node.kind {
                        syntax::SyntaxKind::FuncLit { type_node, body } => match execution::require_node_type_index(
                            package_value.index,
                            node.id,
                        ) {
                            Ok(fact_index) => {
                                let fact = package_value.index.types[fact_index];
                                let function = function_id(-1);
                                let object = go_types::add_object(
                                    program.world,
                                    go_types::ObjectKind::Func,
                                    f"$func_lit_{node.id.value}",
                                    Option::Some(package_value.package_id),
                                    Option::Some(node.file),
                                    Option::Some(node.id),
                                    node.span.start,
                                    fact.type_id,
                                );
                                object_functions.push(Option::Some(function));
                                object_globals.push(Option::None);
                                literal_functions[f"{package_value.package_id.value}:{node.id.value}"] = sources.len();
                                sources.push(
                                    FunctionSource {
                                        template: sources.len(),
                                        package_index,
                                        declaration: node.id,
                                        receiver: Option::None,
                                        name: node.id,
                                        type_node,
                                        body,
                                        object,
                                        function,
                                        type_parameters: signature_type_parameters(
                                            program.world,
                                            fact.type_id,
                                        ),
                                        type_arguments: Vec::new(),
                                        signature: fact.type_id,
                                        literal: true,
                                    },
                                )
                            },
                            Err(message) => diagnostics.push(
                                lower_diagnostic(
                                    Option::Some(package_value.package_id),
                                    Option::None,
                                    Option::Some(node),
                                    message,
                                ),
                            ),
                        },
                        _ => {},
                    }
                },
                None => {},
            }
        }
    }
    sources
}

fn inherit_literal_type_parameters(
    program: execution::ExecutionProgram,
    sources: Vec[FunctionSource],
) -> () {
    let ranges: Vec[FunctionSourceRange] = Vec::with_capacity(sources.len());
    for index in 0..sources.len() {
        let source = sources[index];
        let package_value = program.packages[source.package_index];
        let Some(package_syntax) = package_value.syntax else {
            continue;
        };
        let node = if source.literal {
            source.declaration
        } else {
            source.body
        };
        match syntax::get_node(package_syntax.arena, node) {
            Some(value) => ranges.push(
                FunctionSourceRange {
                    source: index,
                    package_index: source.package_index,
                    file: value.file.value,
                    start: value.span.start,
                    end: value.span.end,
                    literal: source.literal,
                },
            ),
            None => {},
        }
    }
    collections::sort_by(ranges, compare_function_source_range);
    let active: Vec[FunctionSourceRange] = Vec::new();
    let mut current_package = -1;
    let mut current_file = -1;
    for value in ranges {
        if value.package_index != current_package || value.file != current_file {
            while !active.is_empty() {
                let _ = active.pop();
            }
            current_package = value.package_index;
            current_file = value.file;
        }
        while !active.is_empty() && active[active.len() - 1].end < value.start {
            let _ = active.pop();
        }
        if value.literal {
            let mut owner = -1;
            let mut owner_width = 0;
            for candidate in active {
                if candidate.end >= value.end {
                    let width = candidate.end - candidate.start;
                    if owner < 0 || width < owner_width {
                        owner = candidate.source;
                        owner_width = width;
                    }
                }
            }
            if owner >= 0 {
                sources[value.source].type_parameters = sources[owner].type_parameters;
            }
        } else {
            active.push(value)
        }
    }
}

fn nearest_function_scope(world: go_types::World, scope: go_types::ScopeId) -> Option[
    go_types::ScopeId,
] {
    let mut current = Option::Some(scope);
    while let Some(value) = current {
        if value.value < 0 || value.value >= world.scopes.len() {
            return Option::None
        } else if world.scopes[value.value].kind == go_types::ScopeKind::Function {
            return Option::Some(value)
        } else {
            current = world.scopes[value.value].parent;
        }
    }
    Option::None
}

fn scope_is_ancestor(
    world: go_types::World,
    ancestor: go_types::ScopeId,
    descendant: go_types::ScopeId,
) -> bool {
    let mut current = Option::Some(descendant);
    while let Some(value) = current {
        if value.value == ancestor.value {
            return true
        } else if value.value < 0 || value.value >= world.scopes.len() {
            return false
        } else {
            current = world.scopes[value.value].parent;
        }
    }
    false
}

fn analyze_function_capture_objects(
    program: execution::ExecutionProgram,
    sources: Vec[FunctionSource],
    object_globals: Vec[Option[GlobalId]],
) -> Result[Vec[FunctionCaptures], string] {
    let object_scopes: Vec[Option[go_types::ScopeId]] = option_slots(program.world.objects.len());
    for scope in program.world.scopes {
        for entry in scope.entries {
            if entry.object.value >= 0 && entry.object.value < object_scopes.len()
                && object_scopes[entry.object.value].is_none() {
                object_scopes[entry.object.value] = Option::Some(scope.id);
            }
        }
    }
    let package_uses: Vec[Vec[CaptureUse]] = Vec::with_capacity(program.packages.len());
    for package_value in program.packages {
        let uses: Vec[CaptureUse] = Vec::new();
        match package_value.syntax {
            Some(package_syntax) => for fact in package_value.index.uses {
                match fact.object {
                    Some(object) => if object.value >= 0
                        && object.value < program.world.objects.len()
                        && fact.node.value >= 0
                        && fact.node.value < package_syntax.arena.nodes.len()
                        && program.world.objects[object.value].kind == go_types::ObjectKind::Var
                        && object_globals[object.value].is_none() {
                        let node = syntax::node_at(package_syntax.arena, fact.node.value);
                        uses.push(
                            CaptureUse {
                                file: node.file,
                                start: node.span.start,
                                end: node.span.end,
                                object,
                            },
                        )
                    },
                    None => {},
                }
            },
            None => {},
        }
        collections::sort_by(uses, compare_capture_use);
        package_uses.push(uses)
    }
    let result: Vec[FunctionCaptures] = Vec::with_capacity(sources.len());
    for source in sources {
        let captures: Vec[go_types::ObjectId] = Vec::new();
        if source.literal {
            let package_value = program.packages[source.package_index];
            let package_syntax = package_value.syntax.ok_or(
                "function literal package has no syntax",
            )?;
            let body = syntax::get_node(package_syntax.arena, source.body).ok_or(
                "function literal body is missing",
            )?;
            let function_scope = execution::require_scope(package_value.index, source.type_node)?.scope;
            let selected = collections::BitSet::new();
            let uses = package_uses[source.package_index];
            let mut usage_index = first_capture_use_at_or_after(uses, body.file, body.span.start);
            while usage_index < uses.len() {
                let usage = uses[usage_index];
                if usage.file.value != body.file.value || usage.start > body.span.end {
                    break
                }
                if usage.end <= body.span.end {
                    match object_scopes[usage.object.value] {
                        Some(scope) => match nearest_function_scope(program.world, scope) {
                            Some(owner) => if owner.value != function_scope.value
                                && scope_is_ancestor(program.world, owner, function_scope)
                                && !selected.contains(usage.object.value) {
                                let _ = selected.insert(usage.object.value);
                                captures.push(usage.object);
                            },
                            None => {},
                        },
                        None => {},
                    }
                }
                usage_index += 1;
            }
        }
        result.push(FunctionCaptures { objects: captures })
    }
    Result::Ok(result)
}

fn collect_globals(program: execution::ExecutionProgram, object_globals: Vec[Option[GlobalId]]) -> Vec[
    Global,
] {
    let globals: Vec[Global] = Vec::new();
    for package_value in program.packages {
        if package_value.mode == execution::ExecutionMode::Interpreted
            && package_value.package_id.value >= 0
            && package_value.package_id.value < program.world.packages.len() {
            let package_scope = program.world.packages[package_value.package_id.value].scope;
            if package_scope.value >= 0 && package_scope.value < program.world.scopes.len() {
                for entry in program.world.scopes[package_scope.value].entries {
                    if entry.object.value >= 0 && entry.object.value < program.world.objects.len() {
                        let object = program.world.objects[entry.object.value];
                        if object.kind == go_types::ObjectKind::Var && object.name != "_" {
                            let id = global_id(globals.len());
                            globals.push(
                                Global {
                                    id,
                                    package_id: package_value.package_id,
                                    object: object.id,
                                    name: object.name,
                                    type_id: object.type_id,
                                },
                            );
                            object_globals[object.id.value] = Option::Some(id);
                        }
                    }
                }
            }
        }
    }
    globals
}

fn node_kind(builder: FunctionBuilder, node: syntax::NodeId) -> syntax::SyntaxKind {
    syntax::node_at(builder.syntax.arena, node.value).kind
}

fn substitute_type(builder: FunctionBuilder, type_id: go_types::TypeId) -> go_types::TypeId {
    go_types::substitute(builder.world, type_id, builder.type_parameters, builder.type_arguments)
}

fn runtime_type(builder: FunctionBuilder, type_id: go_types::TypeId) -> go_types::TypeId {
    let value = substitute_type(builder, type_id);
    match go_types::type_data(builder.world, go_types::unalias(builder.world, value)) {
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: _,
                receiver_type_params: _,
                type_params: _,
                params,
                results,
                variadic,
            },
        } => go_types::add_type(
            builder.world,
            go_types::TypeKind::Signature {
                receiver: Option::None,
                receiver_type_params: Vec::new(),
                type_params: Vec::new(),
                params,
                results,
                variadic,
            },
        ),
        _ => value,
    }
}

fn object_type(builder: FunctionBuilder, object: go_types::ObjectId) -> Option[go_types::TypeId] {
    if object.value >= 0 && object.value < builder.world.objects.len() {
        Option::Some(runtime_type(builder, builder.world.objects[object.value].type_id))
    } else {
        Option::None
    }
}

fn selection_receiver_type(builder: FunctionBuilder, selection: checker::SelectionFact) -> go_types::TypeId {
    substitute_type(builder, selection.receiver_type)
}

fn node_fact(builder: FunctionBuilder, node: syntax::NodeId) -> Result[checker::TypeFact, string] {
    let fact = builder.index.types[execution::require_node_type_index(builder.index, node)?];
    Result::Ok(
        checker::TypeFact {
            node: fact.node,
            type_id: runtime_type(builder, fact.type_id),
            extra: fact.extra,
            void: fact.void,
            type_expr: fact.type_expr,
            builtin: fact.builtin,
            value_expr: fact.value_expr,
            nil: fact.nil,
            addressable: fact.addressable,
            assignable: fact.assignable,
            comma_ok: fact.comma_ok,
        },
    )
}

fn node_type(builder: FunctionBuilder, node: syntax::NodeId) -> Result[go_types::TypeId, string] {
    match node_fact(builder, node) {
        Ok(value) => Result::Ok(value.type_id),
        Err(message) => {
            let definition_type = match execution::require_definition_index(builder.index, node) {
                Ok(fact_index) => builder.index.definitions[fact_index].object.and_then(
                    |object| object_type(builder, object),
                ),
                Err(_) => Option::None,
            };
            match definition_type {
                Some(value) => Result::Ok(value),
                None => {
                    let use_type = match execution::require_use_index(builder.index, node) {
                        Ok(fact_index) => builder.index.uses[fact_index].object.and_then(
                            |object| object_type(builder, object),
                        ),
                        Err(_) => Option::None,
                    };
                    use_type.ok_or(
                        message + " at "
                            + syntax::node_key(builder.syntax, node).unwrap_or("unknown node"),
                    )
                },
            }
        },
    }
}

fn definition_object(builder: FunctionBuilder, node: syntax::NodeId) -> Result[
    Option[go_types::ObjectId],
    string,
] {
    Result::Ok(
        builder.index.definitions[execution::require_definition_index(builder.index, node)?].object,
    )
}

fn use_object(builder: FunctionBuilder, node: syntax::NodeId) -> Result[go_types::ObjectId, string] {
    builder.index.uses[execution::require_use_index(builder.index, node)?].object.ok_or(
        f"use fact has no object for node {node.value}",
    )
}

fn identifier(builder: FunctionBuilder, node: syntax::NodeId) -> Result[string, string] {
    match node_kind(builder, node) {
        syntax::SyntaxKind::Ident { name_pos: _, name } => Result::Ok(name),
        _ => Result::Err(f"expected identifier at node {node.value}"),
    }
}

fn new_register(builder: FunctionBuilder, type_id: go_types::TypeId) -> RegisterId {
    let result = register_id(builder.register_types.len());
    builder.register_types.push(type_id);
    result
}

fn new_place(builder: FunctionBuilder) -> PlaceId {
    let result = place_id(builder.place_count.get());
    builder.place_count.set(builder.place_count.get() + 1);
    result
}

fn new_block(builder: FunctionBuilder) -> BlockId {
    let result = block_id(builder.blocks.len());
    builder.blocks.push(
        OpenBlock {
            id: result,
            parameters: Vec::new(),
            instructions: Vec::new(),
            terminator: Option::None,
        },
    );
    result
}

fn new_block_parameter(builder: FunctionBuilder, block: BlockId, type_id: go_types::TypeId) -> RegisterId {
    let result = new_register(builder, type_id);
    builder.blocks[block.value].parameters.push(result);
    result
}

fn block_terminated(builder: FunctionBuilder, block: BlockId) -> bool {
    builder.blocks[block.value].terminator.is_some()
}

fn current_terminated(builder: FunctionBuilder) -> bool {
    block_terminated(builder, builder.current.get())
}

fn emit(builder: FunctionBuilder, node: syntax::NodeId, kind: InstructionKind) -> Result[(), string] {
    if current_terminated(builder) {
        let description = match syntax::get_node(builder.syntax.arena, node) {
            Some(value) => syntax::syntax_kind_name(value.kind) + " " + value.path.to_string(),
            None => node.value.to_string(),
        };
        return Result::Err(
            f"cannot emit {description} after block {builder.current.get().value} was terminated",
        )
    }
    let Some(value) = syntax::get_node(builder.syntax.arena, node) else {
        return Result::Err(f"invalid syntax node {node.value}");
    };
    let location = CodeLocation { file: value.file, start: value.span.start, end: value.span.end };
    builder.blocks[builder.current.get().value].instructions.push(Instruction { kind, location });
    Result::Ok(())
}

fn terminate(builder: FunctionBuilder, node: syntax::NodeId, kind: TerminatorKind) -> Result[
    (),
    string,
] {
    if current_terminated(builder) {
        return Result::Err("basic block already has a terminator")
    }
    let Some(value) = syntax::get_node(builder.syntax.arena, node) else {
        return Result::Err(f"invalid syntax node {node.value}");
    };
    let location = CodeLocation { file: value.file, start: value.span.start, end: value.span.end };
    builder.blocks[builder.current.get().value].terminator = Option::Some(
        Terminator { kind, location },
    );
    Result::Ok(())
}

fn switch_to(builder: FunctionBuilder, block: BlockId) -> () {
    builder.current.set(block)
}

fn ensure_local(
    builder: FunctionBuilder,
    object: Option[go_types::ObjectId],
    name: string,
    type_id: go_types::TypeId,
) -> Result[LocalId, string] {
    match object {
        Some(value) => if value.value < 0 || value.value >= builder.world.objects.len() {
            Result::Err("local object is outside the world")
        } else {
            match builder.object_locals[value.value] {
                Some(local) => Result::Ok(local),
                None => {
                    let local = local_id(builder.locals.len());
                    builder.locals.push(Local { id: local, object, name, type_id });
                    builder.object_locals[value.value] = local;
                    Result::Ok(local)
                },
            }
        },
        None => {
            let local = local_id(builder.locals.len());
            builder.locals.push(Local { id: local, object, name, type_id });
            Result::Ok(local)
        },
    }
}

fn object_local(builder: FunctionBuilder, object: go_types::ObjectId) -> Result[LocalId, string] {
    if object.value < 0 || object.value >= builder.world.objects.len() {
        return Result::Err("object is outside the world")
    }
    match builder.object_locals[object.value] {
        Some(local) => Result::Ok(local),
        None => {
            let value = builder.world.objects[object.value];
            ensure_local(
                builder,
                Option::Some(object),
                value.name,
                runtime_type(builder, value.type_id),
            )
        },
    }
}

fn local_place(builder: FunctionBuilder, node: syntax::NodeId, local: LocalId) -> Result[
    PlaceId,
    string,
] {
    let target = new_place(builder);
    emit(builder, node, InstructionKind::LocalPlace { target, local })?;
    Result::Ok(target)
}

fn global_place(builder: FunctionBuilder, node: syntax::NodeId, global: GlobalId) -> Result[
    PlaceId,
    string,
] {
    let target = new_place(builder);
    emit(builder, node, InstructionKind::GlobalPlace { target, global })?;
    Result::Ok(target)
}

fn emit_load(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    source: PlaceId,
    type_id: go_types::TypeId,
) -> Result[RegisterId, string] {
    let target = new_register(builder, type_id);
    emit(builder, node, InstructionKind::Load { target, source })?;
    Result::Ok(target)
}

fn emit_zero(builder: FunctionBuilder, node: syntax::NodeId, type_id: go_types::TypeId) -> Result[
    RegisterId,
    string,
] {
    let target = new_register(builder, type_id);
    emit(builder, node, InstructionKind::Zero { target, type_id })?;
    Result::Ok(target)
}

fn emit_constant(builder: FunctionBuilder, node: syntax::NodeId) -> Result[RegisterId, string] {
    let fact = node_fact(builder, node)?;
    let exact = checker::type_fact_constant(fact).ok_or("expression has no constant value")?;
    let target = new_register(builder, fact.type_id);
    emit(
        builder,
        node,
        InstructionKind::Constant {
            target,
            type_id: fact.type_id,
            constant_kind: checker::type_fact_constant_kind(fact),
            exact,
        },
    )?;
    Result::Ok(target)
}

fn coerce_register(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    source: RegisterId,
    target_type: go_types::TypeId,
) -> Result[RegisterId, string] {
    if source.value < 0 || source.value >= builder.register_types.len() {
        return Result::Err("coercion source register is invalid")
    }
    let source_type = builder.register_types[source.value];
    if go_types::basic_kind(builder.world, source_type)
        == Option::Some(go_types::BasicKind::UntypedNil)
        && go_types::is_nilable_type(builder.world, target_type) {
        emit_zero(builder, node, target_type)
    } else if go_types::identical(builder.world, source_type, target_type) {
        Result::Ok(source)
    } else if go_types::is_interface(builder.world, target_type)
        || match go_types::get_type(builder.world, go_types::underlying(builder.world, target_type)) {
            Some(go_types::TypeData {
                id: _,
                kind: go_types::TypeKind::Chan { direction: _, element: _ },
            }) => go_types::assignable_types(builder.world, source_type, target_type),
            _ => false,
        } {
        let target = new_register(builder, target_type);
        emit(builder, node, InstructionKind::Convert { target, source, type_id: target_type })?;
        Result::Ok(target)
    } else {
        Result::Ok(source)
    }
}

fn unary_operator(value: string) -> Result[UnaryOp, string] {
    match value {
        "+" => Result::Ok(UnaryOp::Positive),
        "-" => Result::Ok(UnaryOp::Negative),
        "!" => Result::Ok(UnaryOp::Not),
        "^" => Result::Ok(UnaryOp::Complement),
        _ => Result::Err("unsupported unary operator " + value),
    }
}

fn binary_operator(value: string) -> Result[BinaryOp, string] {
    match value {
        "+" => Result::Ok(BinaryOp::Add),
        "-" => Result::Ok(BinaryOp::Subtract),
        "*" => Result::Ok(BinaryOp::Multiply),
        "/" => Result::Ok(BinaryOp::Divide),
        "%" => Result::Ok(BinaryOp::Remainder),
        "&" => Result::Ok(BinaryOp::BitAnd),
        "|" => Result::Ok(BinaryOp::BitOr),
        "^" => Result::Ok(BinaryOp::BitXor),
        "&^" => Result::Ok(BinaryOp::AndNot),
        "<<" => Result::Ok(BinaryOp::ShiftLeft),
        ">>" => Result::Ok(BinaryOp::ShiftRight),
        "==" => Result::Ok(BinaryOp::Equal),
        "!=" => Result::Ok(BinaryOp::NotEqual),
        "<" => Result::Ok(BinaryOp::Less),
        "<=" => Result::Ok(BinaryOp::LessEqual),
        ">" => Result::Ok(BinaryOp::Greater),
        ">=" => Result::Ok(BinaryOp::GreaterEqual),
        _ => Result::Err("unsupported binary operator " + value),
    }
}

fn compound_operator(value: string) -> Result[BinaryOp, string] {
    match value {
        "+=" => Result::Ok(BinaryOp::Add),
        "-=" => Result::Ok(BinaryOp::Subtract),
        "*=" => Result::Ok(BinaryOp::Multiply),
        "/=" => Result::Ok(BinaryOp::Divide),
        "%=" => Result::Ok(BinaryOp::Remainder),
        "&=" => Result::Ok(BinaryOp::BitAnd),
        "|=" => Result::Ok(BinaryOp::BitOr),
        "^=" => Result::Ok(BinaryOp::BitXor),
        "&^=" => Result::Ok(BinaryOp::AndNot),
        "<<=" => Result::Ok(BinaryOp::ShiftLeft),
        ">>=" => Result::Ok(BinaryOp::ShiftRight),
        _ => Result::Err("unsupported compound assignment " + value),
    }
}

fn builtin_kind(value: string) -> Result[BuiltinKind, string] {
    match value {
        "append" => Result::Ok(BuiltinKind::Append),
        "cap" => Result::Ok(BuiltinKind::Cap),
        "clear" => Result::Ok(BuiltinKind::Clear),
        "close" => Result::Ok(BuiltinKind::Close),
        "complex" => Result::Ok(BuiltinKind::Complex),
        "copy" => Result::Ok(BuiltinKind::Copy),
        "delete" => Result::Ok(BuiltinKind::Delete),
        "imag" => Result::Ok(BuiltinKind::Imag),
        "len" => Result::Ok(BuiltinKind::Len),
        "make" => Result::Ok(BuiltinKind::Make),
        "max" => Result::Ok(BuiltinKind::Max),
        "min" => Result::Ok(BuiltinKind::Min),
        "new" => Result::Ok(BuiltinKind::New),
        "panic" => Result::Ok(BuiltinKind::Panic),
        "print" => Result::Ok(BuiltinKind::Print),
        "println" => Result::Ok(BuiltinKind::Println),
        "real" => Result::Ok(BuiltinKind::Real),
        "recover" => Result::Ok(BuiltinKind::Recover),
        _ => Result::Err("unsupported builtin " + value),
    }
}

fn expression_result_types(builder: FunctionBuilder, node: syntax::NodeId) -> Result[
    Vec[go_types::TypeId],
    string,
] {
    let fact = node_fact(builder, node)?;
    let result: Vec[go_types::TypeId] = Vec::new();
    if fact.void {
        return Result::Ok(result)
    }
    let underlying = go_types::underlying(builder.world, fact.type_id);
    match go_types::type_data(builder.world, underlying) {
        go_types::TypeData { id: _, kind: go_types::TypeKind::Tuple { variables } } => {
            for variable in variables {
                result.push(substitute_type(builder, variable.type_id))
            }
        },
        _ => result.push(fact.type_id),
    }
    Result::Ok(result)
}

fn pointer_to_array(builder: FunctionBuilder, type_id: go_types::TypeId) -> bool {
    let underlying = go_types::underlying(builder.world, type_id);
    match go_types::get_type(builder.world, underlying) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) => {
            let element = go_types::underlying(builder.world, element);
            match go_types::get_type(builder.world, element) {
                Some(go_types::TypeData {
                    id: _,
                    kind: go_types::TypeKind::Array { length: _, element: _ },
                }) => true,
                _ => false,
            }
        },
        _ => false,
    }
}

fn lower_place(builder: FunctionBuilder, node: syntax::NodeId) -> Result[Option[PlaceId], string] {
    match node_kind(builder, node) {
        syntax::SyntaxKind::Ident { name_pos: _, name } => if name == "_" {
            Result::Ok(Option::None)
        } else {
            let object = match execution::require_use_index(builder.index, node) {
                Ok(fact_index) => builder.index.uses[fact_index].object,
                Err(_) => definition_object(builder, node)?,
            }.ok_or("identifier has no variable object")?;
            if object.value < 0 || object.value >= builder.world.objects.len() {
                return Result::Err("identifier object is outside the world")
            }
            if builder.world.objects[object.value].kind != go_types::ObjectKind::Var {
                return Result::Err("identifier is not a variable")
            }
            match builder.object_globals[object.value] {
                Some(global) => Result::Ok(Option::Some(global_place(builder, node, global)?)),
                None => {
                    let local = object_local(builder, object)?;
                    Result::Ok(Option::Some(local_place(builder, node, local)?))
                },
            }
        },
        syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ } => {
            lower_place(builder, expression)
        },
        syntax::SyntaxKind::StarExpr { star: _, expression } => {
            let pointer = lower_single_expression(builder, expression)?;
            let target = new_place(builder);
            emit(builder, node, InstructionKind::DereferencePlace { target, pointer })?;
            Result::Ok(Option::Some(target))
        },
        syntax::SyntaxKind::SelectorExpr { expression, selector: _ } => {
            let selection = execution::require_selection(builder.index, node)?;
            let expression_type = node_type(builder, expression)?;
            let underlying = go_types::underlying(builder.world, expression_type);
            let base = match go_types::get_type(builder.world, underlying) {
                Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element: _ } }) => {
                    let pointer = lower_single_expression(builder, expression)?;
                    let place = new_place(builder);
                    emit(
                        builder,
                        expression,
                        InstructionKind::DereferencePlace { target: place, pointer },
                    )?;
                    place
                },
                _ => lower_place(builder, expression)?.ok_or("selector base is not addressable")?,
            };
            let target = new_place(builder);
            emit(
                builder,
                node,
                InstructionKind::FieldPlace { target, base, index: selection.index },
            )?;
            Result::Ok(Option::Some(target))
        },
        syntax::SyntaxKind::IndexExpr { expression, lbrack: _, index, rbrack: _ } => {
            let expression_type = node_type(builder, expression)?;
            if map_type(builder, expression_type) {
                return Result::Err("map index is not addressable")
            }
            let base = if pointer_to_array(builder, expression_type) {
                let pointer = lower_single_expression(builder, expression)?;
                let place = new_place(builder);
                emit(
                    builder,
                    expression,
                    InstructionKind::DereferencePlace { target: place, pointer },
                )?;
                place
            } else {
                match lower_place(builder, expression) {
                    Ok(Some(place)) => place,
                    _ => match go_types::get_type(
                        builder.world,
                        go_types::underlying(builder.world, expression_type),
                    ) {
                        Some(go_types::TypeData {
                            id: _,
                            kind: go_types::TypeKind::Slice { element: _ },
                        }) => {
                            let value = lower_single_expression(builder, expression)?;
                            let pointer_type = go_types::add_type(
                                builder.world,
                                go_types::TypeKind::Pointer { element: expression_type },
                            );
                            let pointer = new_register(builder, pointer_type);
                            emit(
                                builder,
                                expression,
                                InstructionKind::Allocate {
                                    target: pointer,
                                    type_id: expression_type,
                                    value: Option::Some(value),
                                },
                            )?;
                            let place = new_place(builder);
                            emit(
                                builder,
                                expression,
                                InstructionKind::DereferencePlace { target: place, pointer },
                            )?;
                            place
                        },
                        _ => return Result::Err("indexed value is not addressable"),
                    },
                }
            };
            let index = lower_single_expression(builder, index)?;
            let target = new_place(builder);
            emit(builder, node, InstructionKind::IndexPlace { target, base, index })?;
            Result::Ok(Option::Some(target))
        },
        _ => Result::Err("expression is not assignable"),
    }
}

fn lower_short_circuit(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    left_node: syntax::NodeId,
    right_node: syntax::NodeId,
    and_operator: bool,
) -> Result[RegisterId, string] {
    let left = lower_single_expression(builder, left_node)?;
    let right_block = new_block(builder);
    let join_block = new_block(builder);
    let result = new_block_parameter(builder, join_block, node_type(builder, node)?);
    terminate(
        builder,
        node,
        if and_operator {
            TerminatorKind::Branch {
                condition: left,
                then_target: right_block,
                then_arguments: Vec::new(),
                else_target: join_block,
                else_arguments: Vec::from_array([left]),
            }
        } else {
            TerminatorKind::Branch {
                condition: left,
                then_target: join_block,
                then_arguments: Vec::from_array([left]),
                else_target: right_block,
                else_arguments: Vec::new(),
            }
        },
    )?;
    switch_to(builder, right_block);
    let right = lower_single_expression(builder, right_node)?;
    terminate(
        builder,
        node,
        TerminatorKind::Jump { target: join_block, arguments: Vec::from_array([right]) },
    )?;
    switch_to(builder, join_block);
    Result::Ok(result)
}

fn literal_function_key(package_id: go_types::PackageId, node: syntax::NodeId) -> string {
    f"{package_id.value}:{node.value}"
}

fn function_instance_matches(
    world: go_types::World,
    value: FunctionInstance,
    arguments: Vec[go_types::TypeId],
) -> bool {
    if value.type_arguments.len() != arguments.len() {
        return false
    }
    for index in 0..arguments.len() {
        if !go_types::identical(world, value.type_arguments[index], arguments[index]) {
            return false
        }
    }
    true
}

fn copied_type_arguments(values: Vec[go_types::TypeId]) -> Vec[go_types::TypeId] {
    let result: Vec[go_types::TypeId] = Vec::with_capacity(values.len());
    for value in values {
        result.push(value)
    }
    result
}

fn instantiated_arguments(builder: FunctionBuilder, node: syntax::NodeId) -> Vec[go_types::TypeId] {
    let result: Vec[go_types::TypeId] = Vec::new();
    match execution::require_instance(builder.index, node) {
        Ok(instance) => for argument in instance.type_args {
            result.push(substitute_type(builder, argument))
        },
        Err(_) => {},
    }
    result
}

fn canonical_instance_node(builder: FunctionBuilder, node: syntax::NodeId) -> Option[syntax::NodeId] {
    match node_kind(builder, node) {
        syntax::SyntaxKind::Ident { name_pos: _, name: _ } => Option::Some(node),
        syntax::SyntaxKind::SelectorExpr { expression: _, selector } => {
            Option::Some(selector)
        },
        syntax::SyntaxKind::IndexExpr { expression, lbrack: _, index: _, rbrack: _ } | syntax::SyntaxKind::IndexListExpr {
            expression,
            lbrack: _,
            indices: _,
            rbrack: _,
        } => canonical_instance_node(builder, expression),
        _ => Option::None,
    }
}

fn has_instance(builder: FunctionBuilder, node: syntax::NodeId) -> bool {
    match canonical_instance_node(builder, node) {
        Some(value) => execution::require_instance(builder.index, value).is_ok(),
        None => false,
    }
}

fn receiver_type_arguments(builder: FunctionBuilder, type_id: go_types::TypeId) -> Vec[
    go_types::TypeId,
] {
    let mut value = substitute_type(builder, type_id);
    match go_types::get_type(builder.world, go_types::unalias(builder.world, value)) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) => {
            value = element;
        },
        _ => {},
    }
    match go_types::get_type(builder.world, go_types::unalias(builder.world, value)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object: _,
                underlying: _,
                type_params: _,
                type_args,
                methods: _,
            } | go_types::TypeKind::Alias { object: _, rhs: _, type_params: _, type_args },
        }) => type_args,
        _ => Vec::new(),
    }
}

fn source_object(builder: FunctionBuilder, object: go_types::ObjectId) -> go_types::ObjectId {
    if object.value < 0 || object.value >= builder.world.objects.len() {
        return object
    }
    let value = builder.world.objects[object.value];
    match value.owner {
        Some(owner) => if owner.value != builder.package_id.value {
            return object
        },
        None => {},
    }
    match value.node {
        Some(node) => match execution::require_definition_index(builder.index, node) {
            Ok(fact_index) => builder.index.definitions[fact_index].object.unwrap_or(object),
            Err(_) => object,
        },
        None => object,
    }
}

fn find_function_template(builder: FunctionBuilder, object: go_types::ObjectId) -> Option[isize] {
    let source = source_object(builder, object);
    builder.function_template_indices[source.value]
}

fn concrete_signature(
    world: go_types::World,
    source: go_types::TypeId,
    parameters: Vec[go_types::TypeParameter],
    arguments: Vec[go_types::TypeId],
) -> go_types::TypeId {
    let value = go_types::substitute(world, source, parameters, arguments);
    match go_types::type_data(world, go_types::unalias(world, value)) {
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver,
                receiver_type_params: _,
                type_params: _,
                params,
                results,
                variadic,
            },
        } => go_types::add_type(
            world,
            go_types::TypeKind::Signature {
                receiver,
                receiver_type_params: Vec::new(),
                type_params: Vec::new(),
                params,
                results,
                variadic,
            },
        ),
        _ => value,
    }
}

fn instantiate_function(
    builder: FunctionBuilder,
    object: go_types::ObjectId,
    arguments: Vec[go_types::TypeId],
) -> Result[FunctionId, string] {
    let template = find_function_template(builder, object).ok_or(
        "function object has no interpreted template",
    )?;
    let source = builder.function_templates[template];
    if source.type_parameters.len() != arguments.len() {
        return Result::Err(
            f"function instance has {arguments.len()} type arguments but requires {source.type_parameters.len()}",
        )
    }
    for instance_index in builder.function_instance_indices[template] {
        let instance = builder.function_instances[instance_index];
        if function_instance_matches(builder.world, instance, arguments) {
            return Result::Ok(instance.function)
        }
    }
    let function = function_id(builder.next_function.get());
    builder.next_function.set(builder.next_function.get() + 1);
    let signature = concrete_signature(
        builder.world,
        source.signature,
        source.type_parameters,
        arguments,
    );
    let instance_object = if arguments.is_empty() {
        source.object
    } else {
        let origin = builder.world.objects[source.object.value];
        go_types::add_object(
            builder.world,
            go_types::ObjectKind::Func,
            origin.name,
            origin.owner,
            origin.file,
            origin.node,
            origin.position,
            signature,
        )
    };
    while builder.object_functions.len() < builder.world.objects.len() {
        builder.object_functions.push(Option::None)
    }
    while builder.object_globals.len() < builder.world.objects.len() {
        builder.object_globals.push(Option::None)
    }
    while builder.object_native_calls.len() < builder.world.objects.len() {
        builder.object_native_calls.push(Option::None)
    }
    builder.object_functions[instance_object.value] = Option::Some(function);
    if arguments.is_empty() {
        builder.object_functions[source.object.value] = Option::Some(function);
    }
    let instance_index = builder.function_instances.len();
    builder.function_instances.push(
        FunctionInstance {
            object: instance_object,
            type_arguments: copied_type_arguments(arguments),
            function,
        },
    );
    builder.function_instance_indices[template].push(instance_index);
    let captures = if source.template >= 0
        && source.template < builder.template_capture_objects.len() {
        builder.template_capture_objects[source.template]
    } else {
        FunctionCaptures { objects: Vec::new() }
    };
    builder.function_capture_objects.push(captures);
    builder.pending_functions.push(
        FunctionSource {
            template: source.template,
            package_index: source.package_index,
            declaration: source.declaration,
            receiver: source.receiver,
            name: source.name,
            type_node: source.type_node,
            body: source.body,
            object: instance_object,
            function,
            type_parameters: source.type_parameters,
            type_arguments: copied_type_arguments(arguments),
            signature,
            literal: source.literal,
        },
    );
    Result::Ok(function)
}

fn function_for_node(builder: FunctionBuilder, node: syntax::NodeId, object: go_types::ObjectId) -> Result[
    FunctionId,
    string,
] {
    let template = find_function_template(builder, object).ok_or(
        "function object has no interpreted template",
    )?;
    let source = builder.function_templates[template];
    let arguments = instantiated_arguments(builder, node);
    if source.type_parameters.is_empty() {
        instantiate_function(builder, object, Vec::new())
    } else if arguments.len() == source.type_parameters.len() {
        instantiate_function(builder, object, arguments)
    } else {
        Result::Err("generic function has no complete instance at this expression")
    }
}

fn function_for_selection(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    selection: checker::SelectionFact,
) -> Result[FunctionId, string] {
    let template = find_function_template(builder, selection.object).ok_or(
        "method object has no interpreted template",
    )?;
    let source = builder.function_templates[template];
    let arguments = receiver_type_arguments(builder, selection.receiver_type);
    for argument in instantiated_arguments(builder, node) {
        arguments.push(argument)
    }
    if arguments.len() == source.type_parameters.len() {
        instantiate_function(builder, selection.object, arguments)
    } else {
        Result::Err("generic receiver method has no complete instance at this expression")
    }
}

fn emit_function_value(builder: FunctionBuilder, node: syntax::NodeId, function: FunctionId) -> Result[
    RegisterId,
    string,
] {
    if function.value < 0 || function.value >= builder.function_capture_objects.len() {
        return Result::Err("function value target is outside the program")
    }
    let captures: Vec[LocalId] = Vec::with_capacity(
        builder.function_capture_objects[function.value].objects.len(),
    );
    for object in builder.function_capture_objects[function.value].objects {
        captures.push(object_local(builder, object)?)
    }
    let target = new_register(builder, node_type(builder, node)?);
    emit(builder, node, InstructionKind::MakeClosure { target, function, captures })?;
    Result::Ok(target)
}

fn native_call_for_node(builder: FunctionBuilder, node: syntax::NodeId, object: go_types::ObjectId) -> Result[
    NativeCallId,
    string,
] {
    let value = builder.world.objects[object.value];
    let owner = value.owner.ok_or("native function has no package owner")?;
    let package_value = builder.world.packages[owner.value];
    let mut signature = substitute_type(builder, value.type_id);
    let type_argument_keys: Vec[string] = Vec::new();
    let instance_node = canonical_instance_node(builder, node).unwrap_or(node);
    match execution::require_instance(builder.index, instance_node) {
        Ok(instance) => {
            let arguments: Vec[go_types::TypeId] = Vec::new();
            for argument in instance.type_args {
                let concrete = substitute_type(builder, argument);
                arguments.push(concrete);
                type_argument_keys.push(native_type_key(builder.world, concrete)?)
            }
            match go_types::get_type(builder.world, go_types::unalias(builder.world, value.type_id)) {
                Some(go_types::TypeData {
                    id: _,
                    kind: go_types::TypeKind::Signature {
                        receiver: _,
                        receiver_type_params,
                        type_params,
                        params: _,
                        results: _,
                        variadic: _,
                    },
                }) => {
                    let parameters: Vec[go_types::TypeParameter] = Vec::new();
                    for parameter in receiver_type_params {
                        parameters.push(parameter)
                    }
                    for parameter in type_params {
                        parameters.push(parameter)
                    }
                    signature = concrete_signature(
                        builder.world,
                        value.type_id,
                        parameters,
                        arguments,
                    );
                },
                _ => return Result::Err("native function has no signature"),
            };
        },
        Err(_) => {},
    }
    for call in builder.native_calls {
        if call.import_path == package_value.path && call.symbol == value.name
            && call.type_argument_keys == type_argument_keys
            && go_types::identical(builder.world, call.signature, signature) {
            return Result::Ok(call.id)
        }
    }
    let shape = native_signature(builder.world, signature)?;
    let clone = go_types::add_object(
        builder.world,
        go_types::ObjectKind::Func,
        value.name,
        value.owner,
        value.file,
        value.node,
        value.position,
        signature,
    );
    while builder.object_native_calls.len() < builder.world.objects.len() {
        builder.object_native_calls.push(Option::None)
    }
    while builder.object_functions.len() < builder.world.objects.len() {
        builder.object_functions.push(Option::None)
    }
    while builder.object_globals.len() < builder.world.objects.len() {
        builder.object_globals.push(Option::None)
    }
    let id = native_call_id(builder.native_calls.len());
    builder.object_native_calls[clone.value] = Option::Some(id);
    builder.native_calls.push(
        NativeCall {
            id,
            package_id: owner,
            object: clone,
            import_path: package_value.path,
            symbol: value.name,
            receiver_name: "",
            receiver_pointer: false,
            type_argument_keys,
            signature,
            parameter_types: shape.parameter_types,
            result_types: shape.result_types,
            parameter_type_keys: shape.parameter_type_keys,
            result_type_keys: shape.result_type_keys,
            variadic: shape.variadic,
            exit: package_value.path == "os" && value.name == "Exit",
        },
    );
    Result::Ok(id)
}

fn native_method_call_for_node(builder: FunctionBuilder, object: go_types::ObjectId) -> Result[
    NativeCallId,
    string,
] {
    let value = builder.world.objects[object.value];
    let (shape, receiver) = native_callable_signature(builder.world, value.type_id)?;
    let receiver = receiver.ok_or("native method has no receiver")?;
    if receiver.package_id.value == builder.package_id.value {
        return Result::Err("method receiver package is interpreted")
    }
    for call in builder.native_calls {
        if call.import_path == receiver.import_path && call.symbol == value.name
            && call.receiver_name == receiver.name
            && call.receiver_pointer == receiver.pointer
            && go_types::identical(builder.world, call.signature, value.type_id) {
            return Result::Ok(call.id)
        }
    }
    let clone = go_types::add_object(
        builder.world,
        go_types::ObjectKind::Func,
        value.name,
        Option::Some(receiver.package_id),
        value.file,
        value.node,
        value.position,
        value.type_id,
    );
    while builder.object_native_calls.len() < builder.world.objects.len() {
        builder.object_native_calls.push(Option::None)
    }
    while builder.object_functions.len() < builder.world.objects.len() {
        builder.object_functions.push(Option::None)
    }
    while builder.object_globals.len() < builder.world.objects.len() {
        builder.object_globals.push(Option::None)
    }
    let id = native_call_id(builder.native_calls.len());
    builder.object_native_calls[clone.value] = Option::Some(id);
    builder.native_calls.push(
        NativeCall {
            id,
            package_id: receiver.package_id,
            object: clone,
            import_path: receiver.import_path,
            symbol: value.name,
            receiver_name: receiver.name,
            receiver_pointer: receiver.pointer,
            type_argument_keys: Vec::new(),
            signature: value.type_id,
            parameter_types: shape.parameter_types,
            result_types: shape.result_types,
            parameter_type_keys: shape.parameter_type_keys,
            result_type_keys: shape.result_type_keys,
            variadic: shape.variadic,
            exit: false,
        },
    );
    Result::Ok(id)
}

fn lower_call_target(builder: FunctionBuilder, node: syntax::NodeId) -> Result[CallTarget, string] {
    let kind = node_kind(builder, node);
    match kind {
        syntax::SyntaxKind::IndexExpr { expression, lbrack: _, index: _, rbrack: _ } => if has_instance(
            builder,
            node,
        ) {
            return lower_call_target(builder, expression)
        } else {
            return Result::Ok(CallTarget::Dynamic(lower_single_expression(builder, node)?))
        },
        syntax::SyntaxKind::IndexListExpr { expression, lbrack: _, indices: _, rbrack: _ } => return lower_call_target(
            builder,
            expression,
        ),
        syntax::SyntaxKind::SelectorExpr { expression, selector: _ } => {
            let type_expression = match node_fact(builder, expression) {
                Ok(value) => value.type_expr,
                Err(_) => false,
            };
            if type_expression {
                return Result::Ok(CallTarget::Dynamic(lower_single_expression(builder, node)?))
            }
        },
        _ => {},
    }
    let object = match kind {
        syntax::SyntaxKind::Ident { name_pos: _, name: _ } => use_object(builder, node)?,
        syntax::SyntaxKind::SelectorExpr { expression: _, selector } => use_object(
            builder,
            selector,
        )?,
        _ => return Result::Ok(CallTarget::Dynamic(lower_single_expression(builder, node)?)),
    };
    if object.value < 0 || object.value >= builder.world.objects.len() {
        return Result::Err("call target object is outside the world")
    }
    let value = builder.world.objects[object.value];
    match value.owner {
        Some(owner) => if builder.world.packages[owner.value].path == "slices"
            && value.name == "Grow" {
            return Result::Ok(CallTarget::Builtin(BuiltinKind::SliceGrow))
        },
        None => {},
    }
    match value.kind {
        go_types::ObjectKind::Builtin => Result::Ok(CallTarget::Builtin(builtin_kind(value.name)?)),
        go_types::ObjectKind::Func => match kind {
            syntax::SyntaxKind::SelectorExpr { expression, selector: _ } => match execution::require_selection(
                builder.index,
                node,
            ) {
                Ok(selection) => {
                    let native_call = builder.object_native_calls[object.value];
                    if go_types::is_interface(
                        builder.world,
                        selection_receiver_type(builder, selection),
                    ) {
                        let native_call = match native_call {
                            Some(call) => Option::Some(call),
                            None => match native_method_call_for_node(builder, object) {
                                Ok(call) => Option::Some(call),
                                Err(_) => Option::None,
                            },
                        };
                        match native_call {
                            Some(call) => Result::Ok(
                                CallTarget::NativeMethod {
                                    call,
                                    receiver: lower_method_receiver(
                                        builder,
                                        node,
                                        expression,
                                        object,
                                        selection.index,
                                    )?,
                                },
                            ),
                            None => Result::Ok(
                                CallTarget::InterfaceMethod {
                                    method: object,
                                    receiver: lower_single_expression(builder, expression)?,
                                },
                            ),
                        }
                    } else {
                        match function_for_selection(builder, node, selection) {
                            Ok(function) => Result::Ok(
                                CallTarget::Method {
                                    function,
                                    receiver: lower_method_receiver(
                                        builder,
                                        node,
                                        expression,
                                        object,
                                        selection.index,
                                    )?,
                                },
                            ),
                            Err(_) => match native_call {
                                Some(call) => Result::Ok(
                                    CallTarget::NativeMethod {
                                        call,
                                        receiver: lower_method_receiver(
                                            builder,
                                            node,
                                            expression,
                                            object,
                                            selection.index,
                                        )?,
                                    },
                                ),
                                None => match native_method_call_for_node(builder, object) {
                                    Ok(call) => Result::Ok(
                                        CallTarget::NativeMethod {
                                            call,
                                            receiver: lower_method_receiver(
                                                builder,
                                                node,
                                                expression,
                                                object,
                                                selection.index,
                                            )?,
                                        },
                                    ),
                                    Err(message) => Result::Err(
                                        "method " + value.name + " requires a native bridge: "
                                            + message,
                                    ),
                                },
                            },
                        }
                    }
                },
                Err(_) => match function_for_node(builder, node, object) {
                    Ok(function) => Result::Ok(CallTarget::Static(function)),
                    Err(_) => match builder.object_native_calls[object.value] {
                        Some(call) => Result::Ok(CallTarget::Native(call)),
                        None => Result::Ok(
                            CallTarget::Native(native_call_for_node(builder, node, object)?),
                        ),
                    },
                },
            },
            _ => match function_for_node(builder, node, object) {
                Ok(function) => Result::Ok(CallTarget::Static(function)),
                Err(_) => match builder.object_native_calls[object.value] {
                    Some(call) => Result::Ok(CallTarget::Native(call)),
                    None => Result::Ok(
                        CallTarget::Native(native_call_for_node(builder, node, object)?),
                    ),
                },
            },
        },
        go_types::ObjectKind::Var => Result::Ok(
            CallTarget::Dynamic(lower_single_expression(builder, node)?),
        ),
        _ => Result::Err("expression is not a callable function"),
    }
}

fn method_receiver_type(builder: FunctionBuilder, object: go_types::ObjectId) -> Result[
    go_types::TypeId,
    string,
] {
    let method = builder.world.objects[object.value];
    match go_types::get_type(builder.world, go_types::unalias(builder.world, method.type_id)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: Some(receiver),
                receiver_type_params: _,
                type_params: _,
                params: _,
                results: _,
                variadic: _,
            },
        }) => Result::Ok(receiver.type_id),
        _ => Result::Err("method has no receiver type"),
    }
}

fn pointer_element(builder: FunctionBuilder, type_id: go_types::TypeId) -> Option[go_types::TypeId] {
    match go_types::get_type(builder.world, go_types::underlying(builder.world, type_id)) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) => {
            Option::Some(element)
        },
        _ => Option::None,
    }
}

fn lower_method_receiver(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    expression: syntax::NodeId,
    object: go_types::ObjectId,
    selection_index: Vec[isize],
) -> Result[RegisterId, string] {
    let expected = method_receiver_type(builder, object)?;
    if selection_index.is_empty() {
        return Result::Err("method selection has an empty path")
    }
    let fields: Vec[isize] = Vec::with_capacity(selection_index.len() - 1);
    for index in 0..selection_index.len() - 1 {
        fields.push(selection_index[index])
    }
    let source_type = node_type(builder, expression)?;
    let actual = field_path_type(builder, source_type, fields)?;
    if go_types::identical(builder.world, actual, expected) {
        return lower_receiver_value(builder, node, expression, fields, actual)
    }
    match (pointer_element(builder, expected), pointer_element(builder, actual)) {
        (Some(element), None) if go_types::identical(builder.world, element, actual) => {
            let place = lower_receiver_place(builder, node, expression, fields)?.0.ok_or(
                "pointer method receiver is not addressable",
            )?;
            let target = new_register(builder, expected);
            emit(builder, node, InstructionKind::AddressOf { target, source: place })?;
            Result::Ok(target)
        },
        (None, Some(element)) if go_types::identical(builder.world, element, expected) => {
            let receiver = lower_receiver_value(builder, node, expression, fields, actual)?;
            let place = new_place(builder);
            emit(
                builder,
                node,
                InstructionKind::DereferencePlace { target: place, pointer: receiver },
            )?;
            emit_load(builder, node, place, expected)
        },
        _ => Result::Err("method receiver cannot be adjusted to its declared type"),
    }
}

fn field_path_type(builder: FunctionBuilder, source: go_types::TypeId, fields: Vec[isize]) -> Result[
    go_types::TypeId,
    string,
] {
    let mut current = source;
    for field in fields {
        current = pointer_element(builder, current).unwrap_or(current);
        match go_types::get_type(builder.world, go_types::underlying(builder.world, current)) {
            Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Struct { fields } }) => if field
                < 0
                || field >= fields.len() {
                return Result::Err("method receiver field index is out of range")
            } else {
                current = substitute_type(builder, fields[field].variable.type_id);
            },
            _ => return Result::Err("method receiver path crosses a non-struct type"),
        }
    }
    Result::Ok(current)
}

fn lower_receiver_value(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    expression: syntax::NodeId,
    fields: Vec[isize],
    type_id: go_types::TypeId,
) -> Result[RegisterId, string] {
    if fields.is_empty() {
        return lower_single_expression(builder, expression)
    }
    let base = lower_single_expression(builder, expression)?;
    let target = new_register(builder, type_id);
    emit(builder, node, InstructionKind::FieldValue { target, base, index: fields })?;
    Result::Ok(target)
}

fn lower_receiver_place(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    expression: syntax::NodeId,
    fields: Vec[isize],
) -> Result[(Option[PlaceId], go_types::TypeId), string] {
    let mut current_type = node_type(builder, expression)?;
    let mut current_place = match pointer_element(builder, current_type) {
        Some(element) => {
            let pointer = lower_single_expression(builder, expression)?;
            let place = new_place(builder);
            emit(builder, node, InstructionKind::DereferencePlace { target: place, pointer })?;
            current_type = element;
            Option::Some(place)
        },
        None => lower_place(builder, expression)?,
    };
    for field in fields {
        match pointer_element(builder, current_type) {
            Some(element) => {
                let pointer_place = current_place.ok_or("method receiver is not addressable")?;
                let pointer = emit_load(builder, node, pointer_place, current_type)?;
                let place = new_place(builder);
                emit(builder, node, InstructionKind::DereferencePlace { target: place, pointer })?;
                current_place = Option::Some(place);
                current_type = element;
            },
            None => {},
        }
        let fields = match go_types::get_type(
            builder.world,
            go_types::underlying(builder.world, current_type),
        ) {
            Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Struct { fields } }) => fields,
            _ => return Result::Err("method receiver path crosses a non-struct type"),
        };
        if field < 0 || field >= fields.len() {
            return Result::Err("method receiver field index is out of range")
        }
        let base = current_place.ok_or("method receiver is not addressable")?;
        let place = new_place(builder);
        emit(
            builder,
            node,
            InstructionKind::FieldPlace { target: place, base, index: Vec::from_array([field]) },
        )?;
        current_place = Option::Some(place);
        current_type = substitute_type(builder, fields[field].variable.type_id);
    }
    Result::Ok((current_place, current_type))
}

fn lower_conversion(builder: FunctionBuilder, node: syntax::NodeId, arguments: Vec[syntax::NodeId]) -> Result[
    Vec[RegisterId],
    string,
] {
    if arguments.len() != 1 {
        return Result::Err("conversion requires one argument")
    }
    let source = lower_single_expression(builder, arguments[0])?;
    let type_id = node_type(builder, node)?;
    let target = new_register(builder, type_id);
    emit(builder, node, InstructionKind::Convert { target, source, type_id })?;
    Result::Ok(Vec::from_array([target]))
}

fn lower_new_builtin(builder: FunctionBuilder, node: syntax::NodeId, arguments: Vec[syntax::NodeId]) -> Result[
    Vec[RegisterId],
    string,
] {
    if arguments.len() != 1 {
        return Result::Err("new requires one argument")
    }
    let argument_fact = node_fact(builder, arguments[0])?;
    let value = if argument_fact.type_expr {
        Option::None
    } else {
        Option::Some(lower_single_expression(builder, arguments[0])?)
    };
    let target = new_register(builder, node_type(builder, node)?);
    emit(builder, node, InstructionKind::Allocate { target, type_id: argument_fact.type_id, value })?;
    Result::Ok(Vec::from_array([target]))
}

fn lower_make_builtin(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    arguments: Vec[syntax::NodeId],
) -> Result[Vec[RegisterId], string] {
    if arguments.is_empty() {
        return Result::Err("make has an invalid argument count")
    }
    let type_fact = node_fact(builder, arguments[0])?;
    if !type_fact.type_expr {
        return Result::Err("make first argument is not a type")
    }
    let type_id = node_type(builder, node)?;
    let underlying = go_types::underlying(builder.world, type_id);
    match go_types::get_type(builder.world, underlying) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Slice { element: _ } }) => {
            if arguments.len() < 2 || arguments.len() > 3 {
                return Result::Err("make slice has an invalid argument count")
            }
            let length = lower_single_expression(builder, arguments[1])?;
            let capacity = if arguments.len() == 3 {
                lower_single_expression(builder, arguments[2])?
            } else {
                length
            };
            let target = new_register(builder, type_id);
            emit(builder, node, InstructionKind::MakeSlice { target, type_id, length, capacity })?;
            Result::Ok(Vec::from_array([target]))
        },
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Map { key: _, value: _ } }) => {
            if arguments.len() > 2 {
                return Result::Err("make map has an invalid argument count")
            }
            let capacity = if arguments.len() == 2 {
                Option::Some(lower_single_expression(builder, arguments[1])?)
            } else {
                Option::None
            };
            let target = new_register(builder, type_id);
            emit(builder, node, InstructionKind::MakeMap { target, type_id, capacity })?;
            Result::Ok(Vec::from_array([target]))
        },
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Chan { direction: _, element: _ },
        }) => {
            if arguments.len() > 2 {
                return Result::Err("make channel has an invalid argument count")
            }
            let int_type = go_types::basic_type(builder.world, "int").ok_or("world has no int type")?;
            let capacity = if arguments.len() == 2 {
                lower_single_expression(builder, arguments[1])?
            } else {
                emit_zero(builder, node, int_type)?
            };
            let target = new_register(builder, type_id);
            emit(builder, node, InstructionKind::MakeChannel { target, type_id, capacity })?;
            Result::Ok(Vec::from_array([target]))
        },
        _ => Result::Err("make target is not supported yet"),
    }
}

fn callable_parameters(builder: FunctionBuilder, node: syntax::NodeId) -> Result[
    (Vec[go_types::TypeId], bool),
    string,
] {
    let signature = node_type(builder, node)?;
    match go_types::type_data(builder.world, go_types::underlying(builder.world, signature)) {
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: _,
                receiver_type_params: _,
                type_params: _,
                params,
                results: _,
                variadic,
            },
        } => {
            let result: Vec[go_types::TypeId] = Vec::new();
            match go_types::type_data(builder.world, params) {
                go_types::TypeData { id: _, kind: go_types::TypeKind::Tuple { variables } } => for variable in variables {
                    result.push(substitute_type(builder, variable.type_id))
                },
                _ => return Result::Err("callable parameter list is not a tuple"),
            }
            Result::Ok((result, variadic))
        },
        _ => Result::Err("call target has no signature"),
    }
}

fn lower_call_arguments(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    function_node: syntax::NodeId,
    arguments: Vec[syntax::NodeId],
    ellipsis: isize,
    target: CallTarget,
) -> Result[Vec[RegisterId], string] {
    let raw_arguments: Vec[RegisterId] = Vec::new();
    for argument in arguments {
        let values = lower_expression(builder, argument)?;
        for value in values {
            raw_arguments.push(value)
        }
    }
    let callable = match target {
        CallTarget::Builtin(_) => (Vec::new(), false),
        _ => callable_parameters(builder, function_node)?,
    };
    let parameter_types = callable.0;
    let variadic_call = callable.1;
    let argument_values: Vec[RegisterId] = Vec::new();
    if variadic_call && ellipsis < 0 {
        let fixed = parameter_types.len() - 1;
        for index in 0..fixed {
            argument_values.push(
                coerce_register(builder, node, raw_arguments[index], parameter_types[index])?,
            )
        }
        let slice_type = parameter_types[fixed];
        let element_type = match go_types::get_type(
            builder.world,
            go_types::underlying(builder.world, slice_type),
        ) {
            Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Slice { element } }) => {
                element
            },
            _ => return Result::Err("variadic parameter is not a slice"),
        };
        if raw_arguments.len() == fixed {
            argument_values.push(emit_zero(builder, node, slice_type)?)
        } else {
            let elements: Vec[AggregateElement] = Vec::with_capacity(raw_arguments.len() - fixed);
            for index in fixed..raw_arguments.len() {
                elements.push(
                    AggregateElement {
                        index: index - fixed,
                        value: coerce_register(builder, node, raw_arguments[index], element_type)?,
                    },
                )
            }
            let packed = new_register(builder, slice_type);
            emit(
                builder,
                node,
                InstructionKind::MakeAggregate {
                    target: packed,
                    type_id: slice_type,
                    elements,
                    length: raw_arguments.len() - fixed,
                },
            )?;
            argument_values.push(packed)
        }
    } else {
        for index in 0..raw_arguments.len() {
            let target_type = if index < parameter_types.len() {
                parameter_types[index]
            } else {
                builder.register_types[raw_arguments[index].value]
            };
            argument_values.push(coerce_register(builder, node, raw_arguments[index], target_type)?)
        }
    }
    Result::Ok(argument_values)
}

fn lower_call(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    function_node: syntax::NodeId,
    arguments: Vec[syntax::NodeId],
    ellipsis: isize,
) -> Result[Vec[RegisterId], string] {
    let function_fact = node_fact(builder, function_node)?;
    if function_fact.type_expr {
        return lower_conversion(builder, node, arguments)
    }
    let target = lower_call_target(builder, function_node)?;
    match target {
        CallTarget::Builtin(BuiltinKind::New) => return lower_new_builtin(builder, node, arguments),
        CallTarget::Builtin(BuiltinKind::Make) => return lower_make_builtin(
            builder,
            node,
            arguments,
        ),
        _ => {},
    }
    let argument_values = lower_call_arguments(
        builder,
        node,
        function_node,
        arguments,
        ellipsis,
        target,
    )?;
    let results: Vec[RegisterId] = Vec::new();
    for type_id in expression_result_types(builder, node)? {
        results.push(new_register(builder, type_id))
    }
    match target {
        CallTarget::Builtin(BuiltinKind::Panic) => if argument_values.len() == 1 {
            emit(builder, node, InstructionKind::Panic { value: argument_values[0] })?;
        } else {
            return Result::Err("panic requires one argument")
        },
        CallTarget::Builtin(BuiltinKind::Recover) => if results.len() == 1
            && argument_values.is_empty() {
            emit(builder, node, InstructionKind::Recover { target: results[0] })?;
        } else {
            return Result::Err("recover has an invalid call shape")
        },
        CallTarget::Builtin(BuiltinKind::Close) => if results.is_empty()
            && argument_values.len() == 1 {
            emit(builder, node, InstructionKind::Close { channel: argument_values[0] })?;
        } else {
            return Result::Err("close has an invalid call shape")
        },
        _ => emit(
            builder,
            node,
            InstructionKind::Call {
                results,
                target,
                arguments: argument_values,
                variadic: ellipsis >= 0,
            },
        )?,
    }
    Result::Ok(results)
}

fn lower_composite_literal(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    elements: Vec[syntax::NodeId],
) -> Result[Vec[RegisterId], string] {
    let type_id = node_type(builder, node)?;
    let underlying = go_types::underlying(builder.world, type_id);
    if !go_types::has_type(builder.world, underlying) {
        return Result::Err("composite literal has an invalid type")
    }
    let type_kind = go_types::type_data(builder.world, underlying).kind;
    match type_kind {
        go_types::TypeKind::Map { key: _, value: _ } => {
            let target = new_register(builder, type_id);
            emit(
                builder,
                node,
                InstructionKind::MakeMap { target, type_id, capacity: Option::None },
            )?;
            let map_types = match type_kind {
                go_types::TypeKind::Map { key, value } => (key, value),
                _ => return Result::Err("map literal has a non-map type"),
            };
            for element in elements {
                match node_kind(builder, element) {
                    syntax::SyntaxKind::KeyValueExpr { key, colon: _, value } => {
                        let lowered_key = lower_single_expression(builder, key)?;
                        let lowered_value = lower_single_expression(builder, value)?;
                        let coerced_key = coerce_register(builder, key, lowered_key, map_types.0)?;
                        let coerced_value = coerce_register(
                            builder,
                            value,
                            lowered_value,
                            map_types.1,
                        )?;
                        emit(
                            builder,
                            element,
                            InstructionKind::MapSet {
                                map: target,
                                key: coerced_key,
                                value: coerced_value,
                            },
                        )?
                    },
                    _ => return Result::Err("map literal element has no key"),
                }
            }
            return Result::Ok(Vec::from_array([target]))
        },
        _ => {},
    }
    let values: Vec[AggregateElement] = Vec::new();
    let mut length = elements.len();
    for position in 0..elements.len() {
        let element = elements[position];
        match node_kind(builder, element) {
            syntax::SyntaxKind::KeyValueExpr { key, colon: _, value } => {
                let index = match type_kind {
                    go_types::TypeKind::Struct { fields } => {
                        let name = match node_kind(builder, key) {
                            syntax::SyntaxKind::Ident { name_pos: _, name } => name,
                            _ => return Result::Err("struct literal key is not a field name"),
                        };
                        let mut found = -1;
                        for field_index in 0..fields.len() {
                            if fields[field_index].variable.name == name {
                                found = field_index;
                            }
                        }
                        if found < 0 {
                            return Result::Err("struct literal field was not found")
                        } else {
                            found
                        }
                    },
                    go_types::TypeKind::Array { length: _, element: _ } | go_types::TypeKind::Slice {
                        element: _,
                    } => {
                        let fact = node_fact(builder, key)?;
                        let exact = checker::type_fact_constant(fact).ok_or(
                            "composite literal index is not constant",
                        )?;
                        let index = num::parse_int_structured(exact).map_err(
                            |error| error.to_string(),
                        )?;
                        if index < 0 {
                            return Result::Err("composite literal index is negative")
                        } else if index + 1 > length {
                            length = index + 1;
                        }
                        index
                    },
                    _ => return Result::Err("keyed literal type is not supported"),
                };
                let target_type = match type_kind {
                    go_types::TypeKind::Struct { fields } => substitute_type(
                        builder,
                        fields[index].variable.type_id,
                    ),
                    go_types::TypeKind::Array { length: _, element } | go_types::TypeKind::Slice {
                        element,
                    } => element,
                    _ => return Result::Err("aggregate literal type is not supported"),
                };
                let lowered = lower_single_expression(builder, value)?;
                values.push(
                    AggregateElement {
                        index,
                        value: coerce_register(builder, value, lowered, target_type)?,
                    },
                )
            },
            _ => {
                let target_type = match type_kind {
                    go_types::TypeKind::Struct { fields } => substitute_type(
                        builder,
                        fields[position].variable.type_id,
                    ),
                    go_types::TypeKind::Array { length: _, element } | go_types::TypeKind::Slice {
                        element,
                    } => element,
                    _ => return Result::Err("aggregate literal type is not supported"),
                };
                let lowered = lower_single_expression(builder, element)?;
                values.push(
                    AggregateElement {
                        index: position,
                        value: coerce_register(builder, element, lowered, target_type)?,
                    },
                )
            },
        }
    }
    let target = new_register(builder, type_id);
    emit(
        builder,
        node,
        InstructionKind::MakeAggregate { target, type_id, elements: values, length },
    )?;
    Result::Ok(Vec::from_array([target]))
}

fn generic_function_origin(builder: FunctionBuilder, node: syntax::NodeId) -> Option[
    (syntax::NodeId, go_types::ObjectId),
] {
    match node_kind(builder, node) {
        syntax::SyntaxKind::Ident { name_pos: _, name: _ } => match use_object(builder, node) {
            Ok(object) => if object.value >= 0 && object.value < builder.world.objects.len()
                && builder.world.objects[object.value].kind == go_types::ObjectKind::Func
                && find_function_template(builder, object).is_some() {
                Option::Some((node, object))
            } else {
                Option::None
            },
            Err(_) => Option::None,
        },
        syntax::SyntaxKind::SelectorExpr { expression: _, selector } => match use_object(
            builder,
            selector,
        ) {
            Ok(object) => if object.value >= 0 && object.value < builder.world.objects.len()
                && builder.world.objects[object.value].kind == go_types::ObjectKind::Func
                && find_function_template(builder, object).is_some() {
                Option::Some((node, object))
            } else {
                Option::None
            },
            Err(_) => Option::None,
        },
        syntax::SyntaxKind::IndexExpr { expression, lbrack: _, index: _, rbrack: _ } | syntax::SyntaxKind::IndexListExpr {
            expression,
            lbrack: _,
            indices: _,
            rbrack: _,
        } => generic_function_origin(builder, expression),
        _ => Option::None,
    }
}

fn lower_generic_function_value(builder: FunctionBuilder, node: syntax::NodeId) -> Result[
    Option[RegisterId],
    string,
] {
    match generic_function_origin(builder, node) {
        Some((origin, object)) => {
            let function = function_for_node(builder, origin, object)?;
            Result::Ok(Option::Some(emit_function_value(builder, node, function)?))
        },
        None => Result::Ok(Option::None),
    }
}

fn lower_expression(builder: FunctionBuilder, node: syntax::NodeId) -> Result[
    Vec[RegisterId],
    string,
] {
    match node_kind(builder, node) {
        syntax::SyntaxKind::BasicLit { value_pos: _, value_end: _, token: _, value: _ } => {
            Result::Ok(Vec::from_array([emit_constant(builder, node)?]))
        },
        syntax::SyntaxKind::Ident { name_pos: _, name } => {
            let fact = node_fact(builder, node)?;
            if checker::type_fact_has_constant(fact) {
                Result::Ok(Vec::from_array([emit_constant(builder, node)?]))
            } else if fact.nil {
                Result::Ok(Vec::from_array([emit_zero(builder, node, fact.type_id)?]))
            } else {
                let object = use_object(builder, node)?;
                if object.value < 0 || object.value >= builder.world.objects.len() {
                    return Result::Err("identifier object is outside the world")
                }
                match builder.world.objects[object.value].kind {
                    go_types::ObjectKind::Var => {
                        let place = lower_place(builder, node)?.ok_or(
                            "blank identifier has no value",
                        )?;
                        Result::Ok(
                            Vec::from_array([emit_load(builder, node, place, fact.type_id)?]),
                        )
                    },
                    go_types::ObjectKind::Const => Result::Ok(
                        Vec::from_array([emit_constant(builder, node)?]),
                    ),
                    go_types::ObjectKind::Func => {
                        let function = function_for_node(builder, node, object)?;
                        Result::Ok(Vec::from_array([emit_function_value(builder, node, function)?]))
                    },
                    _ => Result::Err("identifier " + name + " has no runtime value"),
                }
            }
        },
        syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ } => {
            lower_expression(builder, expression)
        },
        syntax::SyntaxKind::UnaryExpr { op_pos: _, op, expression } => if op == "&" {
            match lower_place(builder, expression) {
                Ok(Some(source)) => {
                    let target = new_register(builder, node_type(builder, node)?);
                    emit(builder, node, InstructionKind::AddressOf { target, source })?;
                    Result::Ok(Vec::from_array([target]))
                },
                _ => {
                    let value = lower_single_expression(builder, expression)?;
                    let target = new_register(builder, node_type(builder, node)?);
                    emit(
                        builder,
                        node,
                        InstructionKind::Allocate {
                            target,
                            type_id: node_type(builder, expression)?,
                            value: Option::Some(value),
                        },
                    )?;
                    Result::Ok(Vec::from_array([target]))
                },
            }
        } else if op == "*" {
            let place = lower_place(builder, node)?.ok_or("dereference is not addressable")?;
            Result::Ok(
                Vec::from_array([emit_load(builder, node, place, node_type(builder, node)?)?]),
            )
        } else if op == "<-" {
            let channel = lower_single_expression(builder, expression)?;
            let types = expression_result_types(builder, node)?;
            if types.is_empty() || types.len() > 2 {
                return Result::Err("channel receive has an invalid result shape")
            }
            let value = new_register(builder, types[0]);
            let ok = if types.len() == 2 {
                Option::Some(new_register(builder, types[1]))
            } else {
                Option::None
            };
            emit(builder, node, InstructionKind::Receive { value, ok, channel })?;
            let result = Vec::from_array([value]);
            if let Some(register) = ok {
                result.push(register)
            }
            Result::Ok(result)
        } else {
            let operand = lower_single_expression(builder, expression)?;
            let target = new_register(builder, node_type(builder, node)?);
            emit(builder, node, InstructionKind::Unary { target, op: unary_operator(op)?, operand })?;
            Result::Ok(Vec::from_array([target]))
        },
        syntax::SyntaxKind::BinaryExpr { left, op_pos: _, op, right } => if op == "&&" {
            Result::Ok(Vec::from_array([lower_short_circuit(builder, node, left, right, true)?]))
        } else if op == "||" {
            Result::Ok(Vec::from_array([lower_short_circuit(builder, node, left, right, false)?]))
        } else {
            let left = lower_single_expression(builder, left)?;
            let right = lower_single_expression(builder, right)?;
            let target = new_register(builder, node_type(builder, node)?);
            emit(
                builder,
                node,
                InstructionKind::Binary { target, op: binary_operator(op)?, left, right },
            )?;
            Result::Ok(Vec::from_array([target]))
        },
        syntax::SyntaxKind::CallExpr { function, lparen: _, arguments, ellipsis, rparen: _ } => {
            lower_call(builder, node, function, arguments, ellipsis)
        },
        syntax::SyntaxKind::StarExpr { star: _, expression: _ } => {
            let place = lower_place(builder, node)?.ok_or("dereference is not addressable")?;
            Result::Ok(
                Vec::from_array([emit_load(builder, node, place, node_type(builder, node)?)?]),
            )
        },
        syntax::SyntaxKind::SelectorExpr { expression, selector: _ } => {
            match execution::require_selection(builder.index, node) {
                Ok(selection) => if selection.object.value < 0
                    || selection.object.value >= builder.world.objects.len() {
                    Result::Err("selector object is outside the world")
                } else if builder.world.objects[selection.object.value].kind
                    != go_types::ObjectKind::Func {
                    let base = lower_single_expression(builder, expression)?;
                    let target = new_register(builder, node_type(builder, node)?);
                    emit(
                        builder,
                        node,
                        InstructionKind::FieldValue { target, base, index: selection.index },
                    )?;
                    Result::Ok(Vec::from_array([target]))
                } else {
                    let target = new_register(builder, node_type(builder, node)?);
                    let type_expression = node_fact(builder, expression)?.type_expr;
                    if go_types::is_interface(
                        builder.world,
                        selection_receiver_type(builder, selection),
                    ) {
                        let receiver = if type_expression {
                            Option::None
                        } else {
                            Option::Some(lower_single_expression(builder, expression)?)
                        };
                        emit(
                            builder,
                            node,
                            InstructionKind::MakeInterfaceMethodValue {
                                target,
                                method: selection.object,
                                receiver,
                            },
                        )?;
                    } else {
                        let function = function_for_selection(builder, node, selection)?;
                        if type_expression {
                            emit(
                                builder,
                                node,
                                InstructionKind::MakeMethodExpression {
                                    target,
                                    function,
                                    receiver_type: selection_receiver_type(builder, selection),
                                    index: selection.index,
                                },
                            )?;
                        } else {
                            let receiver = lower_method_receiver(
                                builder,
                                node,
                                expression,
                                selection.object,
                                selection.index,
                            )?;
                            emit(
                                builder,
                                node,
                                InstructionKind::MakeMethodValue { target, function, receiver },
                            )?;
                        }
                    }
                    Result::Ok(Vec::from_array([target]))
                },
                Err(_) => {
                    let object = match node_kind(builder, node) {
                        syntax::SyntaxKind::SelectorExpr { expression: _, selector } => {
                            use_object(builder, selector)?
                        },
                        _ => return Result::Err("selector expression shape changed"),
                    };
                    if object.value < 0 || object.value >= builder.world.objects.len() {
                        return Result::Err("selector object is outside the world")
                    }
                    match builder.world.objects[object.value].kind {
                        go_types::ObjectKind::Const => {
                            Result::Ok(Vec::from_array([emit_constant(builder, node)?]))
                        },
                        go_types::ObjectKind::Func => {
                            let function = function_for_node(builder, node, object)?;
                            Result::Ok(
                                Vec::from_array([emit_function_value(builder, node, function)?]),
                            )
                        },
                        go_types::ObjectKind::Var => {
                            let target = new_register(builder, node_type(builder, node)?);
                            emit(
                                builder,
                                node,
                                InstructionKind::NativeGlobalLoad { target, object },
                            )?;
                            Result::Ok(Vec::from_array([target]))
                        },
                        _ => Result::Err("package selector has no supported runtime value"),
                    }
                },
            }
        },
        syntax::SyntaxKind::IndexExpr { expression, lbrack: _, index, rbrack: _ } => {
            if let Some(value) = lower_generic_function_value(builder, node)? {
                return Result::Ok(Vec::from_array([value]))
            }
            let expression_type = node_type(builder, expression)?;
            if pointer_to_array(builder, expression_type) {
                let place = lower_place(builder, node)?.ok_or("indexed pointer is not addressable")?;
                return Result::Ok(
                    Vec::from_array([emit_load(builder, node, place, node_type(builder, node)?)?]),
                )
            }
            let base = lower_single_expression(builder, expression)?;
            let index_value = lower_single_expression(builder, index)?;
            let coerced_index = match go_types::get_type(
                builder.world,
                go_types::underlying(builder.world, expression_type),
            ) {
                Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Map { key, value: _ } }) => coerce_register(
                    builder,
                    index,
                    index_value,
                    key,
                )?,
                _ => index_value,
            };
            let result_types = expression_result_types(builder, node)?;
            if result_types.is_empty() || result_types.len() > 2 {
                return Result::Err("index expression has an invalid result shape")
            }
            let target = new_register(builder, result_types[0]);
            let ok = if result_types.len() == 2 {
                Option::Some(new_register(builder, result_types[1]))
            } else {
                Option::None
            };
            emit(
                builder,
                node,
                InstructionKind::IndexValue { target, base, index: coerced_index, ok },
            )?;
            let result = Vec::from_array([target]);
            if let Some(value) = ok {
                result.push(value)
            }
            Result::Ok(result)
        },
        syntax::SyntaxKind::SliceExpr {
            expression,
            lbrack: _,
            low,
            high,
            max,
            slice3: _,
            rbrack: _,
        } => {
            let base_type = node_type(builder, expression)?;
            let base_underlying = go_types::underlying(builder.world, base_type);
            let mut base_place: Option[PlaceId] = Option::None;
            let mut base_value: Option[RegisterId] = Option::None;
            match go_types::get_type(builder.world, base_underlying) {
                Some(go_types::TypeData {
                    id: _,
                    kind: go_types::TypeKind::Array { length: _, element: _ },
                }) => {
                    base_place = Option::Some(
                        lower_place(builder, expression)?.ok_or("sliced array is not addressable")?,
                    );
                },
                Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) => {
                    let element = go_types::underlying(builder.world, element);
                    match go_types::get_type(builder.world, element) {
                        Some(go_types::TypeData {
                            id: _,
                            kind: go_types::TypeKind::Array { length: _, element: _ },
                        }) => {
                            let pointer = lower_single_expression(builder, expression)?;
                            let place = new_place(builder);
                            emit(
                                builder,
                                expression,
                                InstructionKind::DereferencePlace { target: place, pointer },
                            )?;
                            base_place = Option::Some(place);
                        },
                        _ => {
                            base_value = Option::Some(lower_single_expression(builder, expression)?);
                        },
                    }
                },
                _ => {
                    base_value = Option::Some(lower_single_expression(builder, expression)?);
                },
            }
            let low = match low {
                Some(value) => Option::Some(lower_single_expression(builder, value)?),
                None => Option::None,
            };
            let high = match high {
                Some(value) => Option::Some(lower_single_expression(builder, value)?),
                None => Option::None,
            };
            let maximum = match max {
                Some(value) => Option::Some(lower_single_expression(builder, value)?),
                None => Option::None,
            };
            let type_id = node_type(builder, node)?;
            let target = new_register(builder, type_id);
            match base_place {
                Some(base) => {
                    let underlying = go_types::underlying(builder.world, type_id);
                    let element_type = match go_types::get_type(builder.world, underlying) {
                        Some(go_types::TypeData {
                            id: _,
                            kind: go_types::TypeKind::Slice { element },
                        }) => element,
                        _ => return Result::Err("array slice result is not a slice"),
                    };
                    emit(
                        builder,
                        node,
                        InstructionKind::SlicePlace {
                            target,
                            base,
                            element_type,
                            low,
                            high,
                            maximum,
                        },
                    )?
                },
                None => emit(
                    builder,
                    node,
                    InstructionKind::SliceValue {
                        target,
                        base: base_value.ok_or("slice base was not lowered")?,
                        low,
                        high,
                        maximum,
                    },
                )?,
            }
            Result::Ok(Vec::from_array([target]))
        },
        syntax::SyntaxKind::CompositeLit {
            type_node: _,
            lbrace: _,
            elements,
            rbrace: _,
            incomplete: _,
        } => lower_composite_literal(builder, node, elements),
        syntax::SyntaxKind::IndexListExpr { expression: _, lbrack: _, indices: _, rbrack: _ } => match lower_generic_function_value(
            builder,
            node,
        )? {
            Some(value) => Result::Ok(Vec::from_array([value])),
            None => Result::Err("index list expression has no runtime value"),
        },
        syntax::SyntaxKind::FuncLit { type_node: _, body: _ } => {
            let template = builder.literal_functions[literal_function_key(builder.package_id, node)].ok_or(
                "function literal has no bytecode template",
            )?;
            let object = builder.function_templates[template].object;
            let arguments: Vec[go_types::TypeId] = Vec::new();
            for argument in builder.type_arguments {
                arguments.push(argument)
            }
            let function = instantiate_function(builder, object, arguments)?;
            Result::Ok(Vec::from_array([emit_function_value(builder, node, function)?]))
        },
        syntax::SyntaxKind::TypeAssertExpr { expression, lparen: _, type_node, rparen: _ } => {
            let type_node = type_node.ok_or(".(type) is only valid in a type switch")?;
            let fact = node_fact(builder, type_node)?;
            if !fact.type_expr {
                return Result::Err("type assertion target is not a type")
            }
            let source = lower_single_expression(builder, expression)?;
            let result_types = expression_result_types(builder, node)?;
            if result_types.is_empty() || result_types.len() > 2 {
                return Result::Err("type assertion has an invalid result shape")
            }
            let target = new_register(builder, result_types[0]);
            let ok = if result_types.len() == 2 {
                Option::Some(new_register(builder, result_types[1]))
            } else {
                Option::None
            };
            emit(
                builder,
                node,
                InstructionKind::TypeAssert { target, ok, source, type_id: result_types[0] },
            )?;
            let values = Vec::from_array([target]);
            if let Some(value) = ok {
                values.push(value)
            }
            Result::Ok(values)
        },
        _ => Result::Err("syntax node is not a runtime expression"),
    }
}

fn lower_single_expression(builder: FunctionBuilder, node: syntax::NodeId) -> Result[
    RegisterId,
    string,
] {
    let values = lower_expression(builder, node)?;
    if values.len() == 1 {
        Result::Ok(values[0])
    } else {
        Result::Err(f"expression produced {values.len()} values where one was required")
    }
}

fn lower_expression_list(builder: FunctionBuilder, nodes: Vec[syntax::NodeId]) -> Result[
    Vec[RegisterId],
    string,
] {
    let result: Vec[RegisterId] = Vec::new();
    for node in nodes {
        for value in lower_expression(builder, node)? {
            result.push(value)
        }
    }
    Result::Ok(result)
}

fn lower_place_list(builder: FunctionBuilder, nodes: Vec[syntax::NodeId]) -> Result[
    Vec[Option[PlaceId]],
    string,
] {
    let result: Vec[Option[PlaceId]] = Vec::new();
    for node in nodes {
        result.push(lower_place(builder, node)?)
    }
    Result::Ok(result)
}

fn map_type(builder: FunctionBuilder, type_id: go_types::TypeId) -> bool {
    match go_types::get_type(builder.world, go_types::underlying(builder.world, type_id)) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Map { key: _, value: _ } }) => {
            true
        },
        _ => false,
    }
}

fn lower_assignment_target(builder: FunctionBuilder, node: syntax::NodeId) -> Result[
    AssignmentTarget,
    string,
] {
    match node_kind(builder, node) {
        syntax::SyntaxKind::IndexExpr { expression, lbrack: _, index, rbrack: _ } => {
            let type_id = node_type(builder, expression)?;
            if map_type(builder, type_id) {
                let key_type = match go_types::get_type(
                    builder.world,
                    go_types::underlying(builder.world, type_id),
                ) {
                    Some(go_types::TypeData {
                        id: _,
                        kind: go_types::TypeKind::Map { key, value: _ },
                    }) => key,
                    _ => return Result::Err("map assignment has a non-map base"),
                };
                let map = lower_single_expression(builder, expression)?;
                let key_value = lower_single_expression(builder, index)?;
                Result::Ok(
                    AssignmentTarget::Map {
                        map,
                        key: coerce_register(builder, index, key_value, key_type)?,
                    },
                )
            } else {
                Result::Ok(AssignmentTarget::Place(lower_place(builder, node)?))
            }
        },
        _ => Result::Ok(AssignmentTarget::Place(lower_place(builder, node)?)),
    }
}

fn lower_assignment_targets(builder: FunctionBuilder, nodes: Vec[syntax::NodeId]) -> Result[
    Vec[AssignmentTarget],
    string,
] {
    let result: Vec[AssignmentTarget] = Vec::new();
    for node in nodes {
        result.push(lower_assignment_target(builder, node)?)
    }
    Result::Ok(result)
}

fn store_assignment_values(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    target_nodes: Vec[syntax::NodeId],
    targets: Vec[AssignmentTarget],
    values: Vec[RegisterId],
) -> Result[(), string] {
    if targets.len() != values.len() {
        return Result::Err(f"assignment has {targets.len()} targets and {values.len()} values")
    }
    for index in 0..targets.len() {
        match targets[index] {
            AssignmentTarget::Place(Some(place)) => {
                let value = coerce_register(
                    builder,
                    target_nodes[index],
                    values[index],
                    node_type(builder, target_nodes[index])?,
                )?;
                emit(builder, node, InstructionKind::Store { target: place, value })?
            },
            AssignmentTarget::Place(None) => {},
            AssignmentTarget::Map { map, key } => {
                let value = coerce_register(
                    builder,
                    target_nodes[index],
                    values[index],
                    node_type(builder, target_nodes[index])?,
                )?;
                emit(builder, node, InstructionKind::MapSet { map, key, value })?
            },
        }
    }
    Result::Ok(())
}

fn store_values(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    places: Vec[Option[PlaceId]],
    values: Vec[RegisterId],
) -> Result[(), string] {
    if places.len() != values.len() {
        return Result::Err(f"assignment has {places.len()} targets and {values.len()} values")
    }
    for index in 0..places.len() {
        match places[index] {
            Some(place) => emit(
                builder,
                node,
                InstructionKind::Store { target: place, value: values[index] },
            )?,
            None => {},
        }
    }
    Result::Ok(())
}

fn renew_definition_local(builder: FunctionBuilder, node: syntax::NodeId) -> Result[(), string] {
    match definition_object(builder, node) {
        Ok(Some(object)) => if object.value >= 0 && object.value < builder.object_globals.len()
            && builder.object_globals[object.value].is_none() {
            let local = object_local(builder, object)?;
            emit(builder, node, InstructionKind::RenewLocal { local })
        } else {
            Result::Ok(())
        },
        _ => Result::Ok(()),
    }
}

fn lower_assignment(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    left: Vec[syntax::NodeId],
    token: string,
    right: Vec[syntax::NodeId],
) -> Result[(), string] {
    if token == ":=" {
        for target in left {
            renew_definition_local(builder, target)?
        }
    }
    let targets = lower_assignment_targets(builder, left)?;
    if token == "=" || token == ":=" {
        let values = lower_expression_list(builder, right)?;
        store_assignment_values(builder, node, left, targets, values)
    } else {
        if targets.len() != 1 || right.len() != 1 {
            return Result::Err("compound assignment requires one target and one value")
        }
        let type_id = node_type(builder, left[0])?;
        let current = match targets[0] {
            AssignmentTarget::Place(Some(place)) => emit_load(builder, left[0], place, type_id)?,
            AssignmentTarget::Place(None) => {
                return Result::Err("compound assignment cannot target the blank identifier")
            },
            AssignmentTarget::Map { map, key } => {
                let target = new_register(builder, type_id);
                emit(
                    builder,
                    left[0],
                    InstructionKind::IndexValue { target, base: map, index: key, ok: Option::None },
                )?;
                target
            },
        };
        let operand = lower_single_expression(builder, right[0])?;
        let result = new_register(builder, type_id);
        emit(
            builder,
            node,
            InstructionKind::Binary {
                target: result,
                op: compound_operator(token)?,
                left: current,
                right: operand,
            },
        )?;
        match targets[0] {
            AssignmentTarget::Place(Some(place)) => {
                emit(builder, node, InstructionKind::Store { target: place, value: result })
            },
            AssignmentTarget::Map { map, key } => {
                emit(builder, node, InstructionKind::MapSet { map, key, value: result })
            },
            AssignmentTarget::Place(None) => Result::Err(
                "compound assignment cannot target the blank identifier",
            ),
        }
    }
}

fn lower_value_spec(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    names: Vec[syntax::NodeId],
    values: Vec[syntax::NodeId],
) -> Result[(), string] {
    for name in names {
        renew_definition_local(builder, name)?
    }
    let places = lower_place_list(builder, names)?;
    let initializers = if values.is_empty() {
        let result: Vec[RegisterId] = Vec::new();
        for name in names {
            let object = definition_object(builder, name)?.ok_or(
                "variable declaration has no object",
            )?;
            if object.value < 0 || object.value >= builder.world.objects.len() {
                return Result::Err("variable object is outside the world")
            }
            result.push(emit_zero(builder, name, builder.world.objects[object.value].type_id)?)
        }
        result
    } else {
        lower_expression_list(builder, values)?
    };
    let coerced: Vec[RegisterId] = Vec::with_capacity(initializers.len());
    if names.len() != initializers.len() {
        return Result::Err("variable initializer count does not match names")
    }
    for index in 0..initializers.len() {
        coerced.push(
            coerce_register(
                builder,
                names[index],
                initializers[index],
                node_type(builder, names[index])?,
            )?,
        )
    }
    store_values(builder, node, places, coerced)
}

fn lower_declaration(builder: FunctionBuilder, node: syntax::NodeId) -> Result[(), string] {
    match node_kind(builder, node) {
        syntax::SyntaxKind::GenDecl { token_pos: _, token, lparen: _, specs, rparen: _ } => {
            if token == "var" {
                for spec in specs {
                    match node_kind(builder, spec) {
                        syntax::SyntaxKind::ValueSpec { names, type_node: _, values } => {
                            lower_value_spec(builder, spec, names, values)?
                        },
                        _ => return Result::Err("var declaration contains a non-value spec"),
                    }
                }
            } else if token == "const" || token == "type" {} else {
                return Result::Err("unsupported declaration " + token)
            }
            Result::Ok(())
        },
        _ => Result::Err("statement declaration is not a general declaration"),
    }
}

fn ensure_open_block(builder: FunctionBuilder) -> () {
    if current_terminated(builder) {
        switch_to(builder, new_block(builder))
    }
}

fn lower_return(builder: FunctionBuilder, node: syntax::NodeId, expressions: Vec[syntax::NodeId]) -> Result[
    (),
    string,
] {
    let values = if expressions.is_empty() {
        let result: Vec[RegisterId] = Vec::new();
        for local in builder.results {
            let place = local_place(builder, node, local)?;
            result.push(emit_load(builder, node, place, builder.locals[local.value].type_id)?)
        }
        result
    } else {
        lower_expression_list(builder, expressions)?
    };
    if values.len() != builder.results.len() {
        return Result::Err("return value count does not match results")
    }
    let coerced: Vec[RegisterId] = Vec::with_capacity(values.len());
    for index in 0..values.len() {
        coerced.push(
            coerce_register(
                builder,
                node,
                values[index],
                builder.locals[builder.results[index].value].type_id,
            )?,
        )
    }
    terminate(builder, node, TerminatorKind::Return { values: coerced })
}

fn lower_if(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    initialization: Option[syntax::NodeId],
    condition: syntax::NodeId,
    body: syntax::NodeId,
    else_branch: Option[syntax::NodeId],
) -> Result[(), string] {
    if let Some(value) = initialization {
        lower_statement(builder, value)?
    }
    let condition = lower_single_expression(builder, condition)?;
    let then_block = new_block(builder);
    let else_block = new_block(builder);
    let join_block = new_block(builder);
    terminate(
        builder,
        node,
        TerminatorKind::Branch {
            condition,
            then_target: then_block,
            then_arguments: Vec::new(),
            else_target: else_block,
            else_arguments: Vec::new(),
        },
    )?;
    switch_to(builder, then_block);
    lower_statement(builder, body)?;
    if !current_terminated(builder) {
        terminate(builder, node, TerminatorKind::Jump { target: join_block, arguments: Vec::new() })?
    }
    switch_to(builder, else_block);
    if let Some(value) = else_branch {
        lower_statement(builder, value)?
    }
    if !current_terminated(builder) {
        terminate(builder, node, TerminatorKind::Jump { target: join_block, arguments: Vec::new() })?
    }
    switch_to(builder, join_block);
    Result::Ok(())
}

fn for_definition_locals(builder: FunctionBuilder, initialization: Option[syntax::NodeId]) -> Result[
    Vec[LocalId],
    string,
] {
    let result: Vec[LocalId] = Vec::new();
    match initialization {
        Some(node) => match node_kind(builder, node) {
            syntax::SyntaxKind::AssignStmt { left, token_pos: _, token, right: _ } if token == ":=" => for target in left {
                match definition_object(builder, target)? {
                    Some(object) => if object.value >= 0
                        && object.value < builder.object_globals.len()
                        && builder.object_globals[object.value].is_none() {
                        result.push(object_local(builder, object)?)
                    },
                    None => {},
                }
            },
            _ => {},
        },
        None => {},
    }
    Result::Ok(result)
}

fn lower_for(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    initialization: Option[syntax::NodeId],
    condition: Option[syntax::NodeId],
    post: Option[syntax::NodeId],
    body: syntax::NodeId,
    label: Option[string],
) -> Result[(), string] {
    let iteration_locals = for_definition_locals(builder, initialization)?;
    if let Some(value) = initialization {
        lower_statement(builder, value)?
    }
    let condition_block = new_block(builder);
    let body_block = new_block(builder);
    let post_block = new_block(builder);
    let exit_block = new_block(builder);
    terminate(
        builder,
        node,
        TerminatorKind::Jump { target: condition_block, arguments: Vec::new() },
    )?;
    switch_to(builder, condition_block);
    match condition {
        Some(value) => {
            let condition = lower_single_expression(builder, value)?;
            terminate(
                builder,
                node,
                TerminatorKind::Branch {
                    condition,
                    then_target: body_block,
                    then_arguments: Vec::new(),
                    else_target: exit_block,
                    else_arguments: Vec::new(),
                },
            )?
        },
        None => terminate(
            builder,
            node,
            TerminatorKind::Jump { target: body_block, arguments: Vec::new() },
        )?,
    }
    builder.break_targets.push(exit_block);
    builder.continue_targets.push(post_block);
    match label {
        Some(name) => {
            builder.break_labels[name] = exit_block;
            builder.continue_labels[name] = post_block;
        },
        None => {},
    }
    switch_to(builder, body_block);
    lower_statement(builder, body)?;
    if !current_terminated(builder) {
        terminate(builder, node, TerminatorKind::Jump { target: post_block, arguments: Vec::new() })?
    }
    switch_to(builder, post_block);
    for local in iteration_locals {
        emit(builder, node, InstructionKind::CloneLocal { local })?
    }
    if let Some(value) = post {
        lower_statement(builder, value)?
    }
    if !current_terminated(builder) {
        terminate(
            builder,
            node,
            TerminatorKind::Jump { target: condition_block, arguments: Vec::new() },
        )?
    }
    let _ = builder.break_targets.pop();
    let _ = builder.continue_targets.pop();
    match label {
        Some(name) => {
            let _ = builder.break_labels.remove(name);
            let _ = builder.continue_labels.remove(name);
        },
        None => {},
    }
    switch_to(builder, exit_block);
    Result::Ok(())
}

fn renew_range_definition_locals(
    builder: FunctionBuilder,
    key: Option[syntax::NodeId],
    value: Option[syntax::NodeId],
    define: bool,
) -> Result[(), string] {
    if !define {
        return Result::Ok(())
    }
    if let Some(target) = key {
        renew_definition_local(builder, target)?
    }
    if let Some(target) = value {
        renew_definition_local(builder, target)?
    }
    Result::Ok(())
}

fn lower_range_place(builder: FunctionBuilder, target: Option[syntax::NodeId]) -> Result[
    Option[PlaceId],
    string,
] {
    match target {
        Some(target) => lower_place(builder, target),
        None => Result::Ok(Option::None),
    }
}

fn store_range_value(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    target: Option[PlaceId],
    value: Option[RegisterId],
) -> Result[(), string] {
    match (target, value) {
        (Some(target), Some(value)) => {
            emit(builder, node, InstructionKind::Store { target, value })
        },
        _ => Result::Ok(()),
    }
}

fn install_range_label(
    builder: FunctionBuilder,
    label: Option[string],
    break_target: BlockId,
    continue_target: BlockId,
) -> () {
    match label {
        Some(name) => {
            builder.break_labels[name] = break_target;
            builder.continue_labels[name] = continue_target;
        },
        None => {},
    }
}

fn remove_range_label(builder: FunctionBuilder, label: Option[string]) -> () {
    match label {
        Some(name) => {
            let _ = builder.break_labels.remove(name);
            let _ = builder.continue_labels.remove(name);
        },
        None => {},
    }
}

fn lower_map_range(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    key: Option[syntax::NodeId],
    value: Option[syntax::NodeId],
    source: RegisterId,
    key_type: go_types::TypeId,
    value_type: go_types::TypeId,
    define: bool,
    body: syntax::NodeId,
    label: Option[string],
) -> Result[(), string] {
    let int_type = go_types::basic_type(builder.world, "int").ok_or("world has no int type")?;
    let bool_type = go_types::basic_type(builder.world, "bool").ok_or("world has no bool type")?;
    let iterator = new_register(builder, int_type);
    emit(builder, node, InstructionKind::MapIterInit { target: iterator, map: source })?;
    let condition_block = new_block(builder);
    let body_block = new_block(builder);
    let exit_block = new_block(builder);
    terminate(
        builder,
        node,
        TerminatorKind::Jump { target: condition_block, arguments: Vec::new() },
    )?;
    switch_to(builder, condition_block);
    let iteration_key = new_register(builder, key_type);
    let iteration_value = value.map(|_| new_register(builder, value_type));
    let ok = new_register(builder, bool_type);
    emit(
        builder,
        node,
        InstructionKind::MapIterNext { key: iteration_key, value: iteration_value, ok, iterator },
    )?;
    terminate(
        builder,
        node,
        TerminatorKind::Branch {
            condition: ok,
            then_target: body_block,
            then_arguments: Vec::new(),
            else_target: exit_block,
            else_arguments: Vec::new(),
        },
    )?;
    builder.break_targets.push(exit_block);
    builder.continue_targets.push(condition_block);
    install_range_label(builder, label, exit_block, condition_block);
    switch_to(builder, body_block);
    renew_range_definition_locals(builder, key, value, define)?;
    let key_place = lower_range_place(builder, key)?;
    let value_place = lower_range_place(builder, value)?;
    store_range_value(builder, node, key_place, Option::Some(iteration_key))?;
    store_range_value(builder, node, value_place, iteration_value)?;
    lower_statement(builder, body)?;
    if !current_terminated(builder) {
        terminate(
            builder,
            node,
            TerminatorKind::Jump { target: condition_block, arguments: Vec::new() },
        )?
    }
    let _ = builder.break_targets.pop();
    let _ = builder.continue_targets.pop();
    remove_range_label(builder, label);
    switch_to(builder, exit_block);
    Result::Ok(())
}

fn lower_channel_range(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    key: Option[syntax::NodeId],
    value: Option[syntax::NodeId],
    source: RegisterId,
    element_type: go_types::TypeId,
    define: bool,
    body: syntax::NodeId,
    label: Option[string],
) -> Result[(), string] {
    if value.is_some() {
        return Result::Err("channel range has more than one iteration variable")
    }
    let bool_type = go_types::basic_type(builder.world, "bool").ok_or("world has no bool type")?;
    let receive_block = new_block(builder);
    let body_block = new_block(builder);
    let exit_block = new_block(builder);
    terminate(builder, node, TerminatorKind::Jump { target: receive_block, arguments: Vec::new() })?;
    switch_to(builder, receive_block);
    let received = new_register(builder, element_type);
    let ok = new_register(builder, bool_type);
    emit(
        builder,
        node,
        InstructionKind::Receive { value: received, ok: Option::Some(ok), channel: source },
    )?;
    terminate(
        builder,
        node,
        TerminatorKind::Branch {
            condition: ok,
            then_target: body_block,
            then_arguments: Vec::new(),
            else_target: exit_block,
            else_arguments: Vec::new(),
        },
    )?;
    builder.break_targets.push(exit_block);
    builder.continue_targets.push(receive_block);
    install_range_label(builder, label, exit_block, receive_block);
    switch_to(builder, body_block);
    renew_range_definition_locals(builder, key, Option::None, define)?;
    let key_place = lower_range_place(builder, key)?;
    store_range_value(builder, node, key_place, Option::Some(received))?;
    lower_statement(builder, body)?;
    if !current_terminated(builder) {
        terminate(
            builder,
            node,
            TerminatorKind::Jump { target: receive_block, arguments: Vec::new() },
        )?
    }
    let _ = builder.break_targets.pop();
    let _ = builder.continue_targets.pop();
    remove_range_label(builder, label);
    switch_to(builder, exit_block);
    Result::Ok(())
}

fn indexed_range_source(
    builder: FunctionBuilder,
    source_type: go_types::TypeId,
    source: RegisterId,
    integer: bool,
    string_value: bool,
    element_type: Option[go_types::TypeId],
    source_place: Option[PlaceId],
    fixed_length: isize,
) -> Result[LoweredRangeSource, string] {
    let int_type = go_types::basic_type(builder.world, "int").ok_or("world has no int type")?;
    let bool_type = go_types::basic_type(builder.world, "bool").ok_or("world has no bool type")?;
    let rune_type = go_types::basic_type(builder.world, "int32").ok_or("world has no int32 type")?;
    Result::Ok(
        LoweredRangeSource::Indexed(
            IndexedRangeSource {
                source_type,
                source,
                int_type,
                bool_type,
                rune_type,
                integer,
                string_value,
                element_type,
                source_place,
                fixed_length,
            },
        ),
    )
}

fn checked_range_length(length: i64) -> Result[isize, string] {
    if length < 0.to_i64() || length > 9223372036854775807.to_i64() {
        Result::Err("range array length is outside the host integer range")
    } else {
        Result::Ok(length.to_isize())
    }
}

fn lower_range_source(builder: FunctionBuilder, expression: syntax::NodeId) -> Result[
    LoweredRangeSource,
    string,
] {
    let source_type = node_type(builder, expression)?;
    let source = lower_single_expression(builder, expression)?;
    if go_types::is_integer(builder.world, source_type) {
        return indexed_range_source(
            builder,
            source_type,
            source,
            true,
            false,
            Option::None,
            Option::None,
            -1,
        )
    }
    let underlying = go_types::underlying(builder.world, source_type);
    match go_types::get_type(builder.world, underlying) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Basic {
                basic: go_types::BasicKind::String | go_types::BasicKind::UntypedString,
                name: _,
                untyped: _,
            },
        }) => indexed_range_source(
            builder,
            source_type,
            source,
            false,
            true,
            Option::None,
            Option::None,
            -1,
        ),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Array { length, element } }) => indexed_range_source(
            builder,
            source_type,
            source,
            false,
            false,
            Option::Some(element),
            Option::None,
            checked_range_length(length)?,
        ),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Slice { element } }) => indexed_range_source(
            builder,
            source_type,
            source,
            false,
            false,
            Option::Some(element),
            Option::None,
            -1,
        ),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Map { key, value } }) => Result::Ok(
            LoweredRangeSource::Map { source, key_type: key, value_type: value },
        ),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Chan { direction: _, element } }) => Result::Ok(
            LoweredRangeSource::Channel { source, element_type: element },
        ),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) => {
            let array = go_types::underlying(builder.world, element);
            match go_types::get_type(builder.world, array) {
                Some(go_types::TypeData {
                    id: _,
                    kind: go_types::TypeKind::Array { length, element },
                }) => {
                    let place = new_place(builder);
                    emit(
                        builder,
                        expression,
                        InstructionKind::DereferencePlace { target: place, pointer: source },
                    )?;
                    indexed_range_source(
                        builder,
                        source_type,
                        source,
                        false,
                        false,
                        Option::Some(element),
                        Option::Some(place),
                        checked_range_length(length)?,
                    )
                },
                _ => Result::Err("range source is not supported yet"),
            }
        },
        _ => Result::Err("range source is not supported yet"),
    }
}

fn lower_range_bound(
    builder: FunctionBuilder,
    expression: syntax::NodeId,
    source: IndexedRangeSource,
) -> Result[RangeBound, string] {
    if source.integer {
        return Result::Ok(RangeBound { index_type: source.source_type, value: source.source })
    }
    if source.fixed_length >= 0 {
        let result = new_register(builder, source.int_type);
        emit(
            builder,
            expression,
            InstructionKind::Constant {
                target: result,
                type_id: source.int_type,
                constant_kind: "Int",
                exact: source.fixed_length.to_string(),
            },
        )?;
        Result::Ok(RangeBound { index_type: source.int_type, value: result })
    } else {
        let result = new_register(builder, source.int_type);
        emit(
            builder,
            expression,
            InstructionKind::Call {
                results: Vec::from_array([result]),
                target: CallTarget::Builtin(BuiltinKind::Len),
                arguments: Vec::from_array([source.source]),
                variadic: false,
            },
        )?;
        Result::Ok(RangeBound { index_type: source.int_type, value: result })
    }
}

fn lower_range_iteration_value(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    value: Option[syntax::NodeId],
    source: IndexedRangeSource,
    index: RegisterId,
) -> Result[RangeIterationValue, string] {
    if source.string_value {
        let rune = new_register(builder, source.rune_type);
        let width = new_register(builder, source.int_type);
        emit(
            builder,
            node,
            InstructionKind::DecodeRune { rune, width, source: source.source, offset: index },
        )?;
        return Result::Ok(
            RangeIterationValue { width: Option::Some(width), value: Option::Some(rune) },
        )
    }
    match value {
        Some(_) => {
            let target = new_register(
                builder,
                source.element_type.ok_or("range value has no element type")?,
            );
            match source.source_place {
                Some(base) => {
                    let indexed = new_place(builder);
                    emit(
                        builder,
                        node,
                        InstructionKind::IndexPlace { target: indexed, base, index },
                    )?;
                    emit(builder, node, InstructionKind::Load { target, source: indexed })?
                },
                None => emit(
                    builder,
                    node,
                    InstructionKind::IndexValue {
                        target,
                        base: source.source,
                        index,
                        ok: Option::None,
                    },
                )?,
            }
            Result::Ok(RangeIterationValue { width: Option::None, value: Option::Some(target) })
        },
        None => Result::Ok(RangeIterationValue { width: Option::None, value: Option::None }),
    }
}

fn lower_range_step(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    width: Option[RegisterId],
    index_type: go_types::TypeId,
) -> Result[RegisterId, string] {
    match width {
        Some(value) => Result::Ok(value),
        None => {
            let one = new_register(builder, index_type);
            emit(
                builder,
                node,
                InstructionKind::Constant {
                    target: one,
                    type_id: index_type,
                    constant_kind: "Int",
                    exact: "1",
                },
            )?;
            Result::Ok(one)
        },
    }
}

fn lower_indexed_range(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    key: Option[syntax::NodeId],
    value: Option[syntax::NodeId],
    define: bool,
    expression: syntax::NodeId,
    body: syntax::NodeId,
    label: Option[string],
    source: IndexedRangeSource,
) -> Result[(), string] {
    let bound = lower_range_bound(builder, expression, source)?;
    let initial = emit_zero(builder, node, bound.index_type)?;
    let condition_block = new_block(builder);
    let index = new_block_parameter(builder, condition_block, bound.index_type);
    let body_block = new_block(builder);
    let post_block = new_block(builder);
    let exit_block = new_block(builder);
    terminate(
        builder,
        node,
        TerminatorKind::Jump { target: condition_block, arguments: Vec::from_array([initial]) },
    )?;
    switch_to(builder, condition_block);
    let condition = new_register(builder, source.bool_type);
    emit(
        builder,
        node,
        InstructionKind::Binary {
            target: condition,
            op: BinaryOp::Less,
            left: index,
            right: bound.value,
        },
    )?;
    terminate(
        builder,
        node,
        TerminatorKind::Branch {
            condition,
            then_target: body_block,
            then_arguments: Vec::new(),
            else_target: exit_block,
            else_arguments: Vec::new(),
        },
    )?;
    builder.break_targets.push(exit_block);
    builder.continue_targets.push(post_block);
    install_range_label(builder, label, exit_block, post_block);
    switch_to(builder, body_block);
    renew_range_definition_locals(builder, key, value, define)?;
    let key_place = lower_range_place(builder, key)?;
    let value_place = lower_range_place(builder, value)?;
    let iteration = lower_range_iteration_value(builder, node, value, source, index)?;
    store_range_value(builder, node, key_place, Option::Some(index))?;
    store_range_value(builder, node, value_place, iteration.value)?;
    lower_statement(builder, body)?;
    if !current_terminated(builder) {
        terminate(builder, node, TerminatorKind::Jump { target: post_block, arguments: Vec::new() })?
    }
    switch_to(builder, post_block);
    let step = lower_range_step(builder, node, iteration.width, bound.index_type)?;
    let next = new_register(builder, bound.index_type);
    emit(
        builder,
        node,
        InstructionKind::Binary { target: next, op: BinaryOp::Add, left: index, right: step },
    )?;
    terminate(
        builder,
        node,
        TerminatorKind::Jump { target: condition_block, arguments: Vec::from_array([next]) },
    )?;
    let _ = builder.break_targets.pop();
    let _ = builder.continue_targets.pop();
    remove_range_label(builder, label);
    switch_to(builder, exit_block);
    Result::Ok(())
}

fn lower_range(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    key: Option[syntax::NodeId],
    value: Option[syntax::NodeId],
    token: string,
    expression: syntax::NodeId,
    body: syntax::NodeId,
    label: Option[string],
) -> Result[(), string] {
    let define = token == ":=";
    match lower_range_source(builder, expression)? {
        LoweredRangeSource::Map { source, key_type, value_type } => lower_map_range(
            builder,
            node,
            key,
            value,
            source,
            key_type,
            value_type,
            define,
            body,
            label,
        ),
        LoweredRangeSource::Channel { source, element_type } => lower_channel_range(
            builder,
            node,
            key,
            value,
            source,
            element_type,
            define,
            body,
            label,
        ),
        LoweredRangeSource::Indexed(source) => lower_indexed_range(
            builder,
            node,
            key,
            value,
            define,
            expression,
            body,
            label,
            source,
        ),
    }
}

fn switch_clauses(builder: FunctionBuilder, body: syntax::NodeId) -> Result[
    Vec[SwitchClause],
    string,
] {
    let statements = match node_kind(builder, body) {
        syntax::SyntaxKind::BlockStmt { lbrace: _, list, rbrace: _ } => list,
        _ => return Result::Err("switch body is not a block"),
    };
    let result: Vec[SwitchClause] = Vec::new();
    for statement in statements {
        match node_kind(builder, statement) {
            syntax::SyntaxKind::CaseClause { case_pos: _, list, colon: _, body } => result.push(
                SwitchClause {
                    node: statement,
                    expressions: list,
                    body,
                    target: new_block(builder),
                },
            ),
            _ => return Result::Err("switch body contains a non-case statement"),
        }
    }
    Result::Ok(result)
}

fn true_register(builder: FunctionBuilder, node: syntax::NodeId) -> Result[RegisterId, string] {
    let type_id = go_types::basic_type(builder.world, "bool").ok_or("world has no bool type")?;
    let target = new_register(builder, type_id);
    emit(
        builder,
        node,
        InstructionKind::Constant { target, type_id, constant_kind: "Bool", exact: "true" },
    )?;
    Result::Ok(target)
}

fn lower_switch(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    initialization: Option[syntax::NodeId],
    tag: Option[syntax::NodeId],
    body: syntax::NodeId,
    label: Option[string],
) -> Result[(), string] {
    if let Some(value) = initialization {
        lower_statement(builder, value)?
    }
    let tag_value = match tag {
        Some(value) => lower_single_expression(builder, value)?,
        None => true_register(builder, node)?,
    };
    let clauses = switch_clauses(builder, body)?;
    let exit = new_block(builder);
    let mut default_target = exit;
    for clause in clauses {
        if clause.expressions.is_empty() {
            default_target = clause.target;
        }
    }
    let bool_type = go_types::basic_type(builder.world, "bool").ok_or("world has no bool type")?;
    for clause in clauses {
        for expression in clause.expressions {
            let comparison = lower_single_expression(builder, expression)?;
            let condition = new_register(builder, bool_type);
            emit(
                builder,
                expression,
                InstructionKind::Binary {
                    target: condition,
                    op: BinaryOp::Equal,
                    left: tag_value,
                    right: comparison,
                },
            )?;
            let next = new_block(builder);
            terminate(
                builder,
                expression,
                TerminatorKind::Branch {
                    condition,
                    then_target: clause.target,
                    then_arguments: Vec::new(),
                    else_target: next,
                    else_arguments: Vec::new(),
                },
            )?;
            switch_to(builder, next)
        }
    }
    terminate(builder, node, TerminatorKind::Jump { target: default_target, arguments: Vec::new() })?;
    builder.break_targets.push(exit);
    match label {
        Some(name) => {
            builder.break_labels[name] = exit;
        },
        None => {},
    }
    for index in 0..clauses.len() {
        let clause = clauses[index];
        switch_to(builder, clause.target);
        builder.fallthrough_targets.push(
            if index + 1 < clauses.len() {
                clauses[index + 1].target
            } else {
                exit
            },
        );
        lower_statement_list(builder, clause.body)?;
        let _ = builder.fallthrough_targets.pop();
        if !current_terminated(builder) {
            terminate(
                builder,
                clause.node,
                TerminatorKind::Jump { target: exit, arguments: Vec::new() },
            )?
        }
    }
    let _ = builder.break_targets.pop();
    match label {
        Some(name) => {
            let _ = builder.break_labels.remove(name);
        },
        None => {},
    }
    switch_to(builder, exit);
    Result::Ok(())
}

fn type_switch_guard(builder: FunctionBuilder, node: syntax::NodeId) -> Result[
    (syntax::NodeId, Option[syntax::NodeId]),
    string,
] {
    match node_kind(builder, node) {
        syntax::SyntaxKind::ExprStmt { expression } => match node_kind(builder, expression) {
            syntax::SyntaxKind::TypeAssertExpr { expression, lparen: _, type_node: None, rparen: _ } => Result::Ok(
                (expression, Option::None),
            ),
            _ => Result::Err("invalid type switch guard"),
        },
        syntax::SyntaxKind::AssignStmt { left, token_pos: _, token, right } => {
            if token != ":=" || left.len() != 1 || right.len() != 1 {
                return Result::Err("invalid type switch assignment")
            }
            match node_kind(builder, right[0]) {
                syntax::SyntaxKind::TypeAssertExpr {
                    expression,
                    lparen: _,
                    type_node: None,
                    rparen: _,
                } => Result::Ok((expression, Option::Some(left[0]))),
                _ => Result::Err("invalid type switch guard"),
            }
        },
        _ => Result::Err("invalid type switch guard"),
    }
}

fn type_switch_binding(
    builder: FunctionBuilder,
    clause: syntax::NodeId,
    variable: Option[syntax::NodeId],
    target: BlockId,
) -> Result[(BlockId, Option[TypeSwitchBinding]), string] {
    let Some(variable) = variable else {
        return Result::Ok((target, Option::None));
    };
    if identifier(builder, variable)? == "_" {
        return Result::Ok((target, Option::None))
    }
    let object = execution::require_implicit(builder.index, clause)?.object.ok_or(
        "type switch clause has no implicit variable object",
    )?;
    let local = object_local(builder, object)?;
    let entry = new_block(builder);
    let parameter = new_block_parameter(builder, entry, builder.locals[local.value].type_id);
    Result::Ok((entry, Option::Some(TypeSwitchBinding { local, parameter })))
}

fn type_switch_clauses(
    builder: FunctionBuilder,
    body: syntax::NodeId,
    variable: Option[syntax::NodeId],
) -> Result[Vec[TypeSwitchClause], string] {
    let statements = match node_kind(builder, body) {
        syntax::SyntaxKind::BlockStmt { lbrace: _, list, rbrace: _ } => list,
        _ => return Result::Err("type switch body is not a block"),
    };
    let result: Vec[TypeSwitchClause] = Vec::new();
    for statement in statements {
        match node_kind(builder, statement) {
            syntax::SyntaxKind::CaseClause { case_pos: _, list, colon: _, body } => {
                let target = new_block(builder);
                let binding = type_switch_binding(builder, statement, variable, target)?;
                result.push(
                    TypeSwitchClause {
                        node: statement,
                        expressions: list,
                        body,
                        entry: binding.0,
                        target,
                        binding: binding.1,
                    },
                )
            },
            _ => return Result::Err("type switch body contains a non-case statement"),
        }
    }
    Result::Ok(result)
}

fn type_switch_case_type(builder: FunctionBuilder, node: syntax::NodeId) -> Result[
    Option[go_types::TypeId],
    string,
] {
    let fact = node_fact(builder, node)?;
    if fact.nil {
        Result::Ok(Option::None)
    } else {
        Result::Ok(Option::Some(fact.type_id))
    }
}

fn type_switch_arguments(binding: Option[TypeSwitchBinding], value: RegisterId) -> Vec[RegisterId] {
    match binding {
        Some(_) => Vec::from_array([value]),
        None => Vec::new(),
    }
}

fn lower_type_switch(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    initialization: Option[syntax::NodeId],
    assignment: syntax::NodeId,
    body: syntax::NodeId,
    label: Option[string],
) -> Result[(), string] {
    if let Some(value) = initialization {
        lower_statement(builder, value)?
    }
    let guard = type_switch_guard(builder, assignment)?;
    let source = lower_single_expression(builder, guard.0)?;
    let source_type = builder.register_types[source.value];
    if !go_types::is_interface(builder.world, source_type) {
        return Result::Err("type switch source is not interface typed")
    }
    let clauses = type_switch_clauses(builder, body, guard.1)?;
    let exit = new_block(builder);
    let bool_type = go_types::basic_type(builder.world, "bool").ok_or("world has no bool type")?;
    let mut default_clause: Option[isize] = Option::None;
    for clause_index in 0..clauses.len() {
        let clause = clauses[clause_index];
        if clause.expressions.is_empty() {
            default_clause = Option::Some(clause_index);
        } else {
            for expression in clause.expressions {
                let case_type = type_switch_case_type(builder, expression)?;
                let matched = match case_type {
                    Some(type_id) => {
                        let asserted = new_register(builder, type_id);
                        let ok = new_register(builder, bool_type);
                        emit(
                            builder,
                            expression,
                            InstructionKind::TypeAssert {
                                target: asserted,
                                ok: Option::Some(ok),
                                source,
                                type_id,
                            },
                        )?;
                        (
                            ok,
                            if clause.expressions.len() == 1 {
                                asserted
                            } else {
                                source
                            },
                        )
                    },
                    None => {
                        let zero = emit_zero(builder, expression, source_type)?;
                        let equal = new_register(builder, bool_type);
                        emit(
                            builder,
                            expression,
                            InstructionKind::Binary {
                                target: equal,
                                op: BinaryOp::Equal,
                                left: source,
                                right: zero,
                            },
                        )?;
                        (equal, source)
                    },
                };
                let next = new_block(builder);
                terminate(
                    builder,
                    expression,
                    TerminatorKind::Branch {
                        condition: matched.0,
                        then_target: clause.entry,
                        then_arguments: type_switch_arguments(clause.binding, matched.1),
                        else_target: next,
                        else_arguments: Vec::new(),
                    },
                )?;
                switch_to(builder, next)
            }
        }
    }
    match default_clause {
        Some(index) => terminate(
            builder,
            node,
            TerminatorKind::Jump {
                target: clauses[index].entry,
                arguments: type_switch_arguments(clauses[index].binding, source),
            },
        )?,
        None => terminate(
            builder,
            node,
            TerminatorKind::Jump { target: exit, arguments: Vec::new() },
        )?,
    }
    builder.break_targets.push(exit);
    match label {
        Some(name) => {
            builder.break_labels[name] = exit;
        },
        None => {},
    }
    for clause in clauses {
        match clause.binding {
            Some(binding) => {
                switch_to(builder, clause.entry);
                emit(builder, clause.node, InstructionKind::RenewLocal { local: binding.local })?;
                let target = local_place(builder, clause.node, binding.local)?;
                emit(
                    builder,
                    clause.node,
                    InstructionKind::Store { target, value: binding.parameter },
                )?;
                terminate(
                    builder,
                    clause.node,
                    TerminatorKind::Jump { target: clause.target, arguments: Vec::new() },
                )?
            },
            None => {},
        }
        switch_to(builder, clause.target);
        lower_statement_list(builder, clause.body)?;
        if !current_terminated(builder) {
            terminate(
                builder,
                clause.node,
                TerminatorKind::Jump { target: exit, arguments: Vec::new() },
            )?
        }
    }
    let _ = builder.break_targets.pop();
    match label {
        Some(name) => {
            let _ = builder.break_labels.remove(name);
        },
        None => {},
    }
    switch_to(builder, exit);
    Result::Ok(())
}

fn select_receive_source(builder: FunctionBuilder, node: syntax::NodeId) -> Result[
    syntax::NodeId,
    string,
] {
    match node_kind(builder, node) {
        syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ } => {
            select_receive_source(builder, expression)
        },
        syntax::SyntaxKind::UnaryExpr { op_pos: _, op, expression } => if op == "<-" {
            Result::Ok(expression)
        } else {
            Result::Err("select expression is not a receive")
        },
        _ => Result::Err("select expression is not a receive"),
    }
}

fn select_channel_element(builder: FunctionBuilder, node: syntax::NodeId) -> Result[
    go_types::TypeId,
    string,
] {
    match go_types::get_type(
        builder.world,
        go_types::underlying(builder.world, node_type(builder, node)?),
    ) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Chan { direction: _, element } }) => Result::Ok(
            element,
        ),
        _ => Result::Err("select operation source is not channel typed"),
    }
}

fn select_clauses(builder: FunctionBuilder, body: syntax::NodeId) -> Result[
    Vec[SelectClause],
    string,
] {
    let statements = match node_kind(builder, body) {
        syntax::SyntaxKind::BlockStmt { lbrace: _, list, rbrace: _ } => list,
        _ => return Result::Err("select body is not a block"),
    };
    let clauses: Vec[SelectClause] = Vec::new();
    for statement in statements {
        match node_kind(builder, statement) {
            syntax::SyntaxKind::CommClause { case_pos: _, communication, colon: _, body } => clauses.push(
                SelectClause {
                    node: statement,
                    communication,
                    body,
                    target: new_block(builder),
                    receive: Ref::new(Option::None),
                },
            ),
            _ => return Result::Err("select body contains a non-communication clause"),
        }
    }
    Result::Ok(clauses)
}

fn lower_select_operation(builder: FunctionBuilder, clause: SelectClause) -> Result[
    SelectOperation,
    string,
] {
    let Some(communication) = clause.communication else {
        return Result::Ok(SelectOperation::Default);
    };
    match node_kind(builder, communication) {
        syntax::SyntaxKind::SendStmt { channel, arrow: _, value } => {
            let element_type = select_channel_element(builder, channel)?;
            let channel_value = lower_single_expression(builder, channel)?;
            let sent = lower_single_expression(builder, value)?;
            Result::Ok(
                SelectOperation::Send {
                    channel: channel_value,
                    value: coerce_register(builder, value, sent, element_type)?,
                },
            )
        },
        syntax::SyntaxKind::ExprStmt { expression } => {
            let source = select_receive_source(builder, expression)?;
            let element_type = select_channel_element(builder, source)?;
            let channel = lower_single_expression(builder, source)?;
            let value = new_register(builder, element_type);
            clause.receive.set(
                Option::Some(
                    SelectReceiveBinding { left: Vec::new(), token: "", value, ok: Option::None },
                ),
            );
            Result::Ok(SelectOperation::Receive { channel, value, ok: Option::None })
        },
        syntax::SyntaxKind::AssignStmt { left, token_pos: _, token, right } => {
            if right.len() != 1 || left.is_empty() || left.len() > 2 {
                return Result::Err("select receive assignment has an invalid shape")
            }
            let source = select_receive_source(builder, right[0])?;
            let element_type = select_channel_element(builder, source)?;
            let bool_type = go_types::basic_type(builder.world, "bool").ok_or(
                "world has no bool type",
            )?;
            let channel = lower_single_expression(builder, source)?;
            let value = new_register(builder, element_type);
            let ok = if left.len() == 2 {
                Option::Some(new_register(builder, bool_type))
            } else {
                Option::None
            };
            clause.receive.set(Option::Some(SelectReceiveBinding { left, token, value, ok }));
            Result::Ok(SelectOperation::Receive { channel, value, ok })
        },
        _ => Result::Err("select case is not a channel operation"),
    }
}

fn lower_select_binding(builder: FunctionBuilder, clause: SelectClause) -> Result[(), string] {
    match clause.receive.get() {
        Some(binding) => if !binding.left.is_empty() {
            if binding.token == ":=" {
                for target in binding.left {
                    renew_definition_local(builder, target)?
                }
            }
            let targets = lower_assignment_targets(builder, binding.left)?;
            let values = Vec::from_array([binding.value]);
            if let Some(value) = binding.ok {
                values.push(value)
            }
            store_assignment_values(builder, clause.node, binding.left, targets, values)
        } else {
            Result::Ok(())
        },
        None => Result::Ok(()),
    }
}

fn lower_select(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    body: syntax::NodeId,
    label: Option[string],
) -> Result[(), string] {
    let clauses = select_clauses(builder, body)?;
    let cases: Vec[SelectCase] = Vec::new();
    for clause in clauses {
        cases.push(
            SelectCase {
                operation: lower_select_operation(builder, clause)?,
                target: clause.target,
                arguments: Vec::new(),
            },
        )
    }
    let int_type = go_types::basic_type(builder.world, "int").ok_or("world has no int type")?;
    let chosen = new_register(builder, int_type);
    emit(builder, node, InstructionKind::Select { chosen, cases })?;
    terminate(builder, node, TerminatorKind::Unreachable)?;
    let exit = new_block(builder);
    builder.break_targets.push(exit);
    match label {
        Some(name) => {
            builder.break_labels[name] = exit;
        },
        None => {},
    }
    for clause in clauses {
        switch_to(builder, clause.target);
        lower_select_binding(builder, clause)?;
        lower_statement_list(builder, clause.body)?;
        if !current_terminated(builder) {
            terminate(
                builder,
                clause.node,
                TerminatorKind::Jump { target: exit, arguments: Vec::new() },
            )?
        }
    }
    let _ = builder.break_targets.pop();
    match label {
        Some(name) => {
            let _ = builder.break_labels.remove(name);
        },
        None => {},
    }
    switch_to(builder, exit);
    Result::Ok(())
}

fn lower_branch(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    token: string,
    label: Option[syntax::NodeId],
) -> Result[(), string] {
    let target = if token == "break" {
        match label {
            Some(value) => {
                let name = identifier(builder, value)?;
                builder.break_labels[name].ok_or("break label " + name + " is not active")?
            },
            None => {
                if builder.break_targets.is_empty() {
                    return Result::Err("break has no enclosing target")
                }
                builder.break_targets[builder.break_targets.len() - 1]
            },
        }
    } else if token == "continue" {
        match label {
            Some(value) => {
                let name = identifier(builder, value)?;
                builder.continue_labels[name].ok_or("continue label " + name + " is not active")?
            },
            None => {
                if builder.continue_targets.is_empty() {
                    return Result::Err("continue has no enclosing target")
                }
                builder.continue_targets[builder.continue_targets.len() - 1]
            },
        }
    } else if token == "fallthrough" {
        if builder.fallthrough_targets.is_empty() {
            return Result::Err("fallthrough has no following case")
        }
        builder.fallthrough_targets[builder.fallthrough_targets.len() - 1]
    } else if token == "goto" {
        let label = identifier(builder, label.ok_or("goto has no label")?)?;
        builder.labels[label].ok_or("goto target " + label + " was not collected")?
    } else {
        return Result::Err("unsupported branch " + token)
    };
    terminate(builder, node, TerminatorKind::Jump { target, arguments: Vec::new() })
}

fn lower_call_statement(
    builder: FunctionBuilder,
    node: syntax::NodeId,
    call: syntax::NodeId,
    deferred: bool,
) -> Result[(), string] {
    match node_kind(builder, call) {
        syntax::SyntaxKind::CallExpr { function, lparen: _, arguments, ellipsis, rparen: _ } => {
            let target = lower_call_target(builder, function)?;
            let values = lower_call_arguments(builder, node, function, arguments, ellipsis, target)?;
            emit(
                builder,
                node,
                if deferred {
                    InstructionKind::Defer { target, arguments: values, variadic: ellipsis >= 0 }
                } else {
                    InstructionKind::Spawn { target, arguments: values, variadic: ellipsis >= 0 }
                },
            )
        },
        _ => Result::Err("go or defer operand is not a call"),
    }
}

fn lower_statement_list(builder: FunctionBuilder, statements: Vec[syntax::NodeId]) -> Result[
    (),
    string,
] {
    for statement in statements {
        ensure_open_block(builder);
        lower_statement(builder, statement)?
    }
    Result::Ok(())
}

fn lower_statement(builder: FunctionBuilder, node: syntax::NodeId) -> Result[(), string] {
    match node_kind(builder, node) {
        syntax::SyntaxKind::BlockStmt { lbrace: _, list, rbrace: _ } => {
            lower_statement_list(builder, list)
        },
        syntax::SyntaxKind::EmptyStmt { semicolon: _, implicit: _ } => Result::Ok(()),
        syntax::SyntaxKind::ExprStmt { expression } => {
            let _ = lower_expression(builder, expression)?;
            Result::Ok(())
        },
        syntax::SyntaxKind::DeclStmt { declaration } => lower_declaration(builder, declaration),
        syntax::SyntaxKind::AssignStmt { left, token_pos: _, token, right } => {
            lower_assignment(builder, node, left, token, right)
        },
        syntax::SyntaxKind::IncDecStmt { expression, token_pos: _, token } => {
            let assignment = lower_assignment_target(builder, expression)?;
            let type_id = node_type(builder, expression)?;
            let current = match assignment {
                AssignmentTarget::Place(Some(place)) => {
                    emit_load(builder, expression, place, type_id)?
                },
                AssignmentTarget::Map { map, key } => {
                    let value = new_register(builder, type_id);
                    emit(
                        builder,
                        expression,
                        InstructionKind::IndexValue {
                            target: value,
                            base: map,
                            index: key,
                            ok: Option::None,
                        },
                    )?;
                    value
                },
                AssignmentTarget::Place(None) => {
                    return Result::Err("increment target is blank")
                },
            };
            let one = new_register(builder, type_id);
            emit(
                builder,
                node,
                InstructionKind::Constant { target: one, type_id, constant_kind: "Int", exact: "1" },
            )?;
            let result = new_register(builder, type_id);
            emit(
                builder,
                node,
                InstructionKind::Binary {
                    target: result,
                    op: if token == "++" {
                        BinaryOp::Add
                    } else {
                        BinaryOp::Subtract
                    },
                    left: current,
                    right: one,
                },
            )?;
            match assignment {
                AssignmentTarget::Place(Some(place)) => {
                    emit(builder, node, InstructionKind::Store { target: place, value: result })
                },
                AssignmentTarget::Map { map, key } => {
                    emit(builder, node, InstructionKind::MapSet { map, key, value: result })
                },
                AssignmentTarget::Place(None) => Result::Err("increment target is blank"),
            }
        },
        syntax::SyntaxKind::ReturnStmt { return_pos: _, results } => {
            lower_return(builder, node, results)
        },
        syntax::SyntaxKind::IfStmt { if_pos: _, init, condition, body, else_branch } => {
            lower_if(builder, node, init, condition, body, else_branch)
        },
        syntax::SyntaxKind::ForStmt { for_pos: _, init, condition, post, body } => {
            lower_for(builder, node, init, condition, post, body, Option::None)
        },
        syntax::SyntaxKind::SwitchStmt { switch_pos: _, init, tag, body } => {
            lower_switch(builder, node, init, tag, body, Option::None)
        },
        syntax::SyntaxKind::BranchStmt { token_pos: _, token, label } => {
            lower_branch(builder, node, token, label)
        },
        syntax::SyntaxKind::LabeledStmt { label, colon: _, statement } => {
            let name = identifier(builder, label)?;
            let target = builder.labels[name].ok_or("label " + name + " was not collected")?;
            if !current_terminated(builder) {
                terminate(builder, node, TerminatorKind::Jump { target, arguments: Vec::new() })?
            }
            switch_to(builder, target);
            match node_kind(builder, statement) {
                syntax::SyntaxKind::ForStmt { for_pos: _, init, condition, post, body } => lower_for(
                    builder,
                    statement,
                    init,
                    condition,
                    post,
                    body,
                    Option::Some(name),
                ),
                syntax::SyntaxKind::SwitchStmt { switch_pos: _, init, tag, body } => lower_switch(
                    builder,
                    statement,
                    init,
                    tag,
                    body,
                    Option::Some(name),
                ),
                syntax::SyntaxKind::TypeSwitchStmt { switch_pos: _, init, assignment, body } => lower_type_switch(
                    builder,
                    statement,
                    init,
                    assignment,
                    body,
                    Option::Some(name),
                ),
                syntax::SyntaxKind::SelectStmt { select_pos: _, body } => {
                    lower_select(builder, statement, body, Option::Some(name))
                },
                syntax::SyntaxKind::RangeStmt {
                    for_pos: _,
                    key,
                    value,
                    token_pos: _,
                    token,
                    range_pos: _,
                    expression,
                    body,
                } => lower_range(
                    builder,
                    statement,
                    key,
                    value,
                    token,
                    expression,
                    body,
                    Option::Some(name),
                ),
                _ => lower_statement(builder, statement),
            }
        },
        syntax::SyntaxKind::DeferStmt { defer_pos: _, call } => {
            lower_call_statement(builder, node, call, true)
        },
        syntax::SyntaxKind::GoStmt { go_pos: _, call } => {
            lower_call_statement(builder, node, call, false)
        },
        syntax::SyntaxKind::SendStmt { channel, arrow: _, value } => {
            let element_type = match go_types::get_type(
                builder.world,
                go_types::underlying(builder.world, node_type(builder, channel)?),
            ) {
                Some(go_types::TypeData {
                    id: _,
                    kind: go_types::TypeKind::Chan { direction: _, element },
                }) => element,
                _ => return Result::Err("send target is not channel typed"),
            };
            let channel = lower_single_expression(builder, channel)?;
            let value = lower_single_expression(builder, value)?;
            let value = coerce_register(builder, node, value, element_type)?;
            emit(builder, node, InstructionKind::Send { channel, value })
        },
        syntax::SyntaxKind::RangeStmt {
            for_pos: _,
            key,
            value,
            token_pos: _,
            token,
            range_pos: _,
            expression,
            body,
        } => lower_range(builder, node, key, value, token, expression, body, Option::None),
        syntax::SyntaxKind::TypeSwitchStmt { switch_pos: _, init, assignment, body } => {
            lower_type_switch(builder, node, init, assignment, body, Option::None)
        },
        syntax::SyntaxKind::SelectStmt { select_pos: _, body } => {
            lower_select(builder, node, body, Option::None)
        },
        _ => Result::Err("syntax node is not an executable statement"),
    }
}

fn collect_labels(builder: FunctionBuilder, node: syntax::NodeId) -> Result[(), string] {
    match node_kind(builder, node) {
        syntax::SyntaxKind::LabeledStmt { label, colon: _, statement } => {
            let name = identifier(builder, label)?;
            if builder.labels[name].is_some() {
                return Result::Err("duplicate label " + name)
            }
            builder.labels[name] = new_block(builder);
            collect_labels(builder, statement)
        },
        syntax::SyntaxKind::BlockStmt { lbrace: _, list, rbrace: _ } => {
            for statement in list {
                collect_labels(builder, statement)?
            }
            Result::Ok(())
        },
        syntax::SyntaxKind::IfStmt { if_pos: _, init, condition: _, body, else_branch } => {
            if let Some(value) = init {
                collect_labels(builder, value)?
            }
            collect_labels(builder, body)?;
            match else_branch {
                Some(value) => collect_labels(builder, value),
                None => Result::Ok(()),
            }
        },
        syntax::SyntaxKind::ForStmt { for_pos: _, init, condition: _, post, body } => {
            if let Some(value) = init {
                collect_labels(builder, value)?
            }
            if let Some(value) = post {
                collect_labels(builder, value)?
            }
            collect_labels(builder, body)
        },
        syntax::SyntaxKind::RangeStmt {
            for_pos: _,
            key: _,
            value: _,
            token_pos: _,
            token: _,
            range_pos: _,
            expression: _,
            body,
        } => collect_labels(builder, body),
        syntax::SyntaxKind::SwitchStmt { switch_pos: _, init, tag: _, body } | syntax::SyntaxKind::TypeSwitchStmt {
            switch_pos: _,
            init,
            assignment: _,
            body,
        } => {
            if let Some(value) = init {
                collect_labels(builder, value)?
            }
            collect_labels(builder, body)
        },
        syntax::SyntaxKind::SelectStmt { select_pos: _, body } => collect_labels(builder, body),
        syntax::SyntaxKind::CaseClause { case_pos: _, list: _, colon: _, body } | syntax::SyntaxKind::CommClause {
            case_pos: _,
            communication: _,
            colon: _,
            body,
        } => {
            for statement in body {
                collect_labels(builder, statement)?
            }
            Result::Ok(())
        },
        _ => Result::Ok(()),
    }
}

fn field_objects(builder: FunctionBuilder, field_list: syntax::NodeId) -> Result[
    Vec[Option[go_types::ObjectId]],
    string,
] {
    let fields = match node_kind(builder, field_list) {
        syntax::SyntaxKind::FieldList { opening: _, list, closing: _ } => list,
        _ => return Result::Err("function parameter list is not a field list"),
    };
    let result: Vec[Option[go_types::ObjectId]] = Vec::new();
    for field in fields {
        match node_kind(builder, field) {
            syntax::SyntaxKind::Field { names, type_node: _, tag: _ } => if names.is_empty() {
                result.push(Option::None)
            } else {
                for name in names {
                    result.push(definition_object(builder, name)?)
                }
            },
            _ => return Result::Err("function field list contains a non-field node"),
        }
    }
    Result::Ok(result)
}

fn signature_tuple_variables(builder: FunctionBuilder, type_id: go_types::TypeId) -> Result[
    Vec[go_types::Variable],
    string,
] {
    match go_types::type_data(builder.world, type_id) {
        go_types::TypeData { id: _, kind: go_types::TypeKind::Tuple { variables } } => {
            Result::Ok(variables)
        },
        _ => Result::Err("signature component is not a tuple"),
    }
}

fn append_parameter_local(
    builder: FunctionBuilder,
    object: Option[go_types::ObjectId],
    variable: go_types::Variable,
) -> Result[(), string] {
    let local = ensure_local(
        builder,
        object,
        variable.name,
        runtime_type(builder, variable.type_id),
    )?;
    builder.parameters.push(local);
    Result::Ok(())
}

fn append_result_local(
    builder: FunctionBuilder,
    object: Option[go_types::ObjectId],
    variable: go_types::Variable,
) -> Result[(), string] {
    let local = ensure_local(
        builder,
        object,
        variable.name,
        runtime_type(builder, variable.type_id),
    )?;
    builder.results.push(local);
    Result::Ok(())
}

fn initialize_signature_locals(
    builder: FunctionBuilder,
    receiver_node: Option[syntax::NodeId],
    type_node: syntax::NodeId,
) -> Result[(), string] {
    let (params_node, results_node) = match node_kind(builder, type_node) {
        syntax::SyntaxKind::FuncType { func_pos: _, type_params: _, params, results } => {
            (params, results)
        },
        _ => return Result::Err("function declaration type is not a function type"),
    };
    let signature = match go_types::type_data(builder.world, builder.signature) {
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver,
                receiver_type_params: _,
                type_params: _,
                params,
                results,
                variadic: _,
            },
        } => (receiver, params, results),
        _ => return Result::Err("function object does not have a signature"),
    };
    match signature.0 {
        Some(receiver) => {
            let receiver_list = receiver_node.ok_or("method signature has no receiver syntax")?;
            let objects = field_objects(builder, receiver_list)?;
            if objects.len() != 1 {
                return Result::Err("method receiver does not have one binding")
            }
            append_parameter_local(builder, objects[0], receiver)?
        },
        None => if receiver_node.is_some() {
            return Result::Err("function syntax has an unexpected receiver")
        },
    }
    let parameter_variables = signature_tuple_variables(builder, signature.1)?;
    let parameter_objects = field_objects(builder, params_node)?;
    if parameter_variables.len() != parameter_objects.len() {
        return Result::Err("parameter syntax does not match function signature")
    }
    for index in 0..parameter_variables.len() {
        append_parameter_local(builder, parameter_objects[index], parameter_variables[index])?
    }
    let result_variables = signature_tuple_variables(builder, signature.2)?;
    let result_objects = match results_node {
        Some(value) => field_objects(builder, value)?,
        None => {
            let values: Vec[Option[go_types::ObjectId]] = Vec::new();
            values
        },
    };
    if result_variables.len() != result_objects.len() {
        return Result::Err("result syntax does not match function signature")
    }
    for index in 0..result_variables.len() {
        append_result_local(builder, result_objects[index], result_variables[index])?
    }
    Result::Ok(())
}

fn finalize_blocks(builder: FunctionBuilder, source: syntax::NodeId) -> Result[
    Vec[BasicBlock],
    string,
] {
    if !current_terminated(builder) {
        if builder.results.is_empty() {
            terminate(builder, source, TerminatorKind::Return { values: Vec::new() })?
        } else {
            terminate(builder, source, TerminatorKind::Unreachable)?
        }
    }
    let result: Vec[BasicBlock] = Vec::new();
    let Some(value) = syntax::get_node(builder.syntax.arena, source) else {
        return Result::Err(f"invalid syntax node {source.value}");
    };
    let fallback_location = CodeLocation {
        file: value.file,
        start: value.span.start,
        end: value.span.end,
    };
    for block in builder.blocks {
        result.push(
            BasicBlock {
                id: block.id,
                parameters: block.parameters,
                instructions: block.instructions,
                terminator: block.terminator.unwrap_or(
                    Terminator { kind: TerminatorKind::Unreachable, location: fallback_location },
                ),
            },
        )
    }
    Result::Ok(result)
}

fn lower_function(
    program: execution::ExecutionProgram,
    source: FunctionSource,
    object_functions: Vec[Option[FunctionId]],
    object_globals: Vec[Option[GlobalId]],
    object_native_calls: Vec[Option[NativeCallId]],
    native_calls: Vec[NativeCall],
    function_templates: Vec[FunctionSource],
    function_template_indices: HashMap[isize, isize],
    function_instances: Vec[FunctionInstance],
    function_instance_indices: Vec[Vec[isize]],
    pending_functions: Vec[FunctionSource],
    next_function: Ref[isize],
    literal_functions: HashMap[string, isize],
    template_capture_objects: Vec[FunctionCaptures],
    function_capture_objects: Vec[FunctionCaptures],
) -> Result[BytecodeFunction, string] {
    let package_value = program.packages[source.package_index];
    let package_syntax = package_value.syntax.ok_or("interpreted package has no syntax")?;
    if source.object.value < 0 || source.object.value >= program.world.objects.len() {
        return Result::Err("function object is outside the world")
    }
    let object = program.world.objects[source.object.value];
    let blocks: Vec[OpenBlock] = Vec::new();
    blocks.push(
        OpenBlock {
            id: block_id(0),
            parameters: Vec::new(),
            instructions: Vec::new(),
            terminator: Option::None,
        },
    );
    let builder = FunctionBuilder {
        world: program.world,
        syntax: package_syntax,
        index: package_value.index,
        package_id: package_value.package_id,
        object: source.object,
        function: source.function,
        signature: source.signature,
        object_functions,
        object_globals,
        object_native_calls,
        native_calls,
        function_templates,
        function_template_indices,
        function_instances,
        function_instance_indices,
        pending_functions,
        next_function,
        literal_functions,
        template_capture_objects,
        function_capture_objects,
        type_parameters: source.type_parameters,
        type_arguments: source.type_arguments,
        register_types: Vec::new(),
        place_count: Ref::new(0),
        locals: Vec::new(),
        object_locals: HashMap::new(),
        captures: Vec::new(),
        parameters: Vec::new(),
        results: Vec::new(),
        blocks,
        current: Ref::new(block_id(0)),
        break_targets: Vec::new(),
        continue_targets: Vec::new(),
        fallthrough_targets: Vec::new(),
        break_labels: HashMap::new(),
        continue_labels: HashMap::new(),
        labels: HashMap::new(),
    };
    for capture in function_capture_objects[source.function.value].objects {
        builder.captures.push(object_local(builder, capture)?)
    }
    initialize_signature_locals(builder, source.receiver, source.type_node)?;
    collect_labels(builder, source.body)?;
    lower_statement(builder, source.body)?;
    Result::Ok(
        BytecodeFunction {
            id: source.function,
            package_id: package_value.package_id,
            object: source.object,
            name: object.name,
            signature: source.signature,
            register_types: builder.register_types,
            place_count: builder.place_count.get(),
            locals: builder.locals,
            captures: builder.captures,
            parameters: builder.parameters,
            results: builder.results,
            blocks: finalize_blocks(builder, source.body)?,
            entry: block_id(0),
        },
    )
}

fn lower_package_initializer(
    program: execution::ExecutionProgram,
    source: FunctionSource,
    initializer: FunctionId,
    init_functions: Vec[FunctionId],
    object_functions: Vec[Option[FunctionId]],
    object_globals: Vec[Option[GlobalId]],
    object_native_calls: Vec[Option[NativeCallId]],
    native_calls: Vec[NativeCall],
    function_templates: Vec[FunctionSource],
    function_template_indices: HashMap[isize, isize],
    function_instances: Vec[FunctionInstance],
    function_instance_indices: Vec[Vec[isize]],
    pending_functions: Vec[FunctionSource],
    next_function: Ref[isize],
    literal_functions: HashMap[string, isize],
    template_capture_objects: Vec[FunctionCaptures],
    function_capture_objects: Vec[FunctionCaptures],
) -> Result[BytecodeFunction, string] {
    let package_value = program.packages[source.package_index];
    let package_syntax = package_value.syntax.ok_or("interpreted package has no syntax")?;
    if source.object.value < 0 || source.object.value >= program.world.objects.len() {
        return Result::Err("initializer object is outside the world")
    }
    let object = program.world.objects[source.object.value];
    let blocks: Vec[OpenBlock] = Vec::new();
    blocks.push(
        OpenBlock {
            id: block_id(0),
            parameters: Vec::new(),
            instructions: Vec::new(),
            terminator: Option::None,
        },
    );
    let builder = FunctionBuilder {
        world: program.world,
        syntax: package_syntax,
        index: package_value.index,
        package_id: package_value.package_id,
        object: source.object,
        function: initializer,
        signature: object.type_id,
        object_functions,
        object_globals,
        object_native_calls,
        native_calls,
        function_templates,
        function_template_indices,
        function_instances,
        function_instance_indices,
        pending_functions,
        next_function,
        literal_functions,
        template_capture_objects,
        function_capture_objects,
        type_parameters: Vec::new(),
        type_arguments: Vec::new(),
        register_types: Vec::new(),
        place_count: Ref::new(0),
        locals: Vec::new(),
        object_locals: HashMap::new(),
        captures: Vec::new(),
        parameters: Vec::new(),
        results: Vec::new(),
        blocks,
        current: Ref::new(block_id(0)),
        break_targets: Vec::new(),
        continue_targets: Vec::new(),
        fallthrough_targets: Vec::new(),
        break_labels: HashMap::new(),
        continue_labels: HashMap::new(),
        labels: HashMap::new(),
    };
    for fact in package_value.index.initialization_order {
        let values = lower_expression(builder, fact.right)?;
        if values.len() != fact.left.len() {
            return Result::Err("package initializer value count does not match variables")
        }
        for index in 0..fact.left.len() {
            let object_id = fact.left[index];
            if object_id.value < 0 || object_id.value >= program.world.objects.len() {
                return Result::Err("package initializer object is outside the world")
            }
            let target_object = program.world.objects[object_id.value];
            if target_object.name != "_" {
                let global = object_globals[object_id.value].ok_or(
                    "package initializer variable has no global",
                )?;
                let place = global_place(builder, fact.right, global)?;
                let value = coerce_register(
                    builder,
                    fact.right,
                    values[index],
                    target_object.type_id,
                )?;
                emit(builder, fact.right, InstructionKind::Store { target: place, value })?
            }
        }
    }
    for function in init_functions {
        emit(
            builder,
            source.declaration,
            InstructionKind::Call {
                results: Vec::new(),
                target: CallTarget::Static(function),
                arguments: Vec::new(),
                variadic: false,
            },
        )?
    }
    terminate(builder, source.declaration, TerminatorKind::Return { values: Vec::new() })?;
    Result::Ok(
        BytecodeFunction {
            id: initializer,
            package_id: package_value.package_id,
            object: source.object,
            name: "$init",
            signature: object.type_id,
            register_types: builder.register_types,
            place_count: builder.place_count.get(),
            locals: builder.locals,
            captures: builder.captures,
            parameters: builder.parameters,
            results: builder.results,
            blocks: finalize_blocks(builder, source.declaration)?,
            entry: block_id(0),
        },
    )
}

fn package_bytecode(
    program: execution::ExecutionProgram,
    bytecode_functions: Vec[BytecodeFunction],
    globals: Vec[Global],
    initializer: Option[FunctionId],
) -> Vec[BytecodePackage] {
    let result: Vec[BytecodePackage] = Vec::new();
    for package_value in program.packages {
        if package_value.mode == execution::ExecutionMode::Interpreted {
            let functions: Vec[FunctionId] = Vec::new();
            let package_globals: Vec[GlobalId] = Vec::new();
            for function in bytecode_functions {
                if function.package_id.value == package_value.package_id.value {
                    functions.push(function.id)
                }
            }
            for global in globals {
                if global.package_id.value == package_value.package_id.value {
                    package_globals.push(global.id)
                }
            }
            result.push(
                BytecodePackage {
                    package_id: package_value.package_id,
                    path: package_value.path,
                    functions,
                    globals: package_globals,
                    initializer: if package_value.package_id.value == program.main_package.value {
                        initializer
                    } else {
                        Option::None
                    },
                },
            )
        }
    }
    result
}

fn bytecode_source_files(program: execution::ExecutionProgram) -> Vec[BytecodeSourceFile] {
    let result: Vec[BytecodeSourceFile] = Vec::new();
    for package_value in program.packages {
        match package_value.syntax {
            Some(package_syntax) => for file in package_syntax.files {
                result.push(
                    BytecodeSourceFile {
                        package_id: package_value.package_id,
                        file: file.id,
                        name: file.name,
                    },
                )
            },
            None => {},
        }
    }
    result
}

fn verifier_lower_diagnostic(value: VerifyDiagnostic) -> LowerDiagnostic {
    let function = match value.function {
        Some(function) => function.value.to_string(),
        None => "-".to_string(),
    };
    let block = match value.block {
        Some(block) => block.value.to_string(),
        None => "-".to_string(),
    };
    LowerDiagnostic {
        package_id: Option::None,
        function: Option::None,
        file: Option::None,
        start: -1,
        end: -1,
        message: f"bytecode verification failed at function {function}, block {block}, instruction {value.instruction}: {value.message}",
    }
}

fn seed_function_instances(
    program: execution::ExecutionProgram,
    templates: Vec[FunctionSource],
    captures: Vec[FunctionCaptures],
    object_functions: Vec[Option[FunctionId]],
    instances: Vec[FunctionInstance],
    instance_indices: Vec[Vec[isize]],
    pending: Vec[FunctionSource],
    instance_captures: Vec[FunctionCaptures],
    next_function: Ref[isize],
) -> () {
    for template in templates {
        if template.type_parameters.is_empty() {
            let function = function_id(next_function.get());
            next_function.set(next_function.get() + 1);
            object_functions[template.object.value] = Option::Some(function);
            let instance_index = instances.len();
            instances.push(
                FunctionInstance { object: template.object, type_arguments: Vec::new(), function },
            );
            instance_indices[template.template].push(instance_index);
            instance_captures.push(captures[template.template]);
            pending.push(
                FunctionSource {
                    template: template.template,
                    package_index: template.package_index,
                    declaration: template.declaration,
                    receiver: template.receiver,
                    name: template.name,
                    type_node: template.type_node,
                    body: template.body,
                    object: template.object,
                    function,
                    type_parameters: template.type_parameters,
                    type_arguments: Vec::new(),
                    signature: concrete_signature(
                        program.world,
                        template.signature,
                        Vec::new(),
                        Vec::new(),
                    ),
                    literal: template.literal,
                },
            )
        } else {
            object_functions[template.object.value] = Option::None;
        }
    }
}

fn lower_pending_functions(
    program: execution::ExecutionProgram,
    object_functions: Vec[Option[FunctionId]],
    object_globals: Vec[Option[GlobalId]],
    object_native_calls: Vec[Option[NativeCallId]],
    native_calls: Vec[NativeCall],
    templates: Vec[FunctionSource],
    template_indices: HashMap[isize, isize],
    instances: Vec[FunctionInstance],
    instance_indices: Vec[Vec[isize]],
    pending: Vec[FunctionSource],
    next_function: Ref[isize],
    literal_functions: HashMap[string, isize],
    template_captures: Vec[FunctionCaptures],
    instance_captures: Vec[FunctionCaptures],
    functions: Vec[BytecodeFunction],
    lowered: Ref[isize],
    diagnostics: Vec[LowerDiagnostic],
) -> () {
    while lowered.get() < pending.len() {
        let source = pending[lowered.get()];
        lowered.set(lowered.get() + 1);
        match lower_function(
            program,
            source,
            object_functions,
            object_globals,
            object_native_calls,
            native_calls,
            templates,
            template_indices,
            instances,
            instance_indices,
            pending,
            next_function,
            literal_functions,
            template_captures,
            instance_captures,
        ) {
            Ok(function) => functions.push(function),
            Err(message) => {
                let package_value = program.packages[source.package_index];
                let function_name = if source.object.value >= 0
                    && source.object.value < program.world.objects.len() {
                    program.world.objects[source.object.value].name
                } else {
                    source.object.value.to_string()
                };
                diagnostics.push(
                    lower_diagnostic(
                        Option::Some(package_value.package_id),
                        Option::Some(source.object),
                        package_node(package_value, source.declaration),
                        "lowering " + function_name + ": " + message,
                    ),
                )
            },
        }
    }
}

fn lower_with_verification(program: execution::ExecutionProgram, validate: bool) -> LowerResult {
    let diagnostics: Vec[LowerDiagnostic] = Vec::new();
    let native_link = link_native_calls(program);
    for diagnostic in native_link.diagnostics {
        diagnostics.push(diagnostic)
    }
    if !diagnostics.is_empty() {
        return LowerResult { program: Option::None, diagnostics }
    }
    let object_functions: Vec[Option[FunctionId]] = option_slots(program.world.objects.len());
    let object_globals: Vec[Option[GlobalId]] = option_slots(program.world.objects.len());
    let literal_functions: HashMap[string, isize] = HashMap::new();
    let templates = collect_function_sources(
        program,
        object_functions,
        object_globals,
        literal_functions,
        diagnostics,
    );
    let template_indices: HashMap[isize, isize] = HashMap::new();
    for index in 0..templates.len() {
        template_indices[templates[index].object.value] = index;
    }
    inherit_literal_type_parameters(program, templates);
    let globals = collect_globals(program, object_globals);
    while native_link.object_calls.len() < program.world.objects.len() {
        native_link.object_calls.push(Option::None)
    }
    let template_captures: Vec[FunctionCaptures] = match analyze_function_capture_objects(
        program,
        templates,
        object_globals,
    ) {
        Ok(value) => value,
        Err(message) => {
            diagnostics.push(
                lower_diagnostic(
                    Option::Some(program.main_package),
                    Option::None,
                    Option::None,
                    "closure analysis: " + message,
                ),
            );
            let values: Vec[FunctionCaptures] = Vec::with_capacity(templates.len());
            for _ in templates {
                values.push(FunctionCaptures { objects: Vec::new() })
            }
            values
        },
    };
    let instances: Vec[FunctionInstance] = Vec::new();
    let instance_indices = int_vector_slots(templates.len());
    let pending: Vec[FunctionSource] = Vec::new();
    let instance_captures: Vec[FunctionCaptures] = Vec::new();
    let next_function = Ref::new(0);
    seed_function_instances(
        program,
        templates,
        template_captures,
        object_functions,
        instances,
        instance_indices,
        pending,
        instance_captures,
        next_function,
    );
    let functions: Vec[BytecodeFunction] = Vec::new();
    let lowered = Ref::new(0);
    lower_pending_functions(
        program,
        object_functions,
        object_globals,
        native_link.object_calls,
        native_link.calls,
        templates,
        template_indices,
        instances,
        instance_indices,
        pending,
        next_function,
        literal_functions,
        template_captures,
        instance_captures,
        functions,
        lowered,
        diagnostics,
    );
    let initializer = if program.main_function.value >= 0
        && program.main_function.value < object_functions.len() {
        match object_functions[program.main_function.value] {
            Some(_) => {
                let mut main_source: Option[FunctionSource] = Option::None;
                let init_functions: Vec[FunctionId] = Vec::new();
                for source in pending {
                    if source.object.value == program.main_function.value {
                        main_source = Option::Some(source);
                    } else if program.packages[source.package_index].package_id.value
                        == program.main_package.value
                        && source.object.value >= 0
                        && source.object.value < program.world.objects.len()
                        && program.world.objects[source.object.value].name == "init"
                        && source.receiver.is_none() {
                        init_functions.push(source.function)
                    }
                }
                match main_source {
                    Some(source) => {
                        let function = function_id(next_function.get());
                        next_function.set(next_function.get() + 1);
                        match lower_package_initializer(
                            program,
                            source,
                            function,
                            init_functions,
                            object_functions,
                            object_globals,
                            native_link.object_calls,
                            native_link.calls,
                            templates,
                            template_indices,
                            instances,
                            instance_indices,
                            pending,
                            next_function,
                            literal_functions,
                            template_captures,
                            instance_captures,
                        ) {
                            Ok(value) => {
                                functions.push(value);
                                Option::Some(function)
                            },
                            Err(message) => {
                                diagnostics.push(
                                    lower_diagnostic(
                                        Option::Some(program.main_package),
                                        Option::Some(program.main_function),
                                        package_node(
                                            program.packages[source.package_index],
                                            source.declaration,
                                        ),
                                        "lowering package initializer: " + message,
                                    ),
                                );
                                Option::None
                            },
                        }
                    },
                    None => Option::None,
                }
            },
            None => Option::None,
        }
    } else {
        Option::None
    };
    lower_pending_functions(
        program,
        object_functions,
        object_globals,
        native_link.object_calls,
        native_link.calls,
        templates,
        template_indices,
        instances,
        instance_indices,
        pending,
        next_function,
        literal_functions,
        template_captures,
        instance_captures,
        functions,
        lowered,
        diagnostics,
    );
    while object_functions.len() < program.world.objects.len() {
        object_functions.push(Option::None)
    }
    while object_globals.len() < program.world.objects.len() {
        object_globals.push(Option::None)
    }
    while native_link.object_calls.len() < program.world.objects.len() {
        native_link.object_calls.push(Option::None)
    }
    let main = if program.main_function.value >= 0
        && program.main_function.value < object_functions.len() {
        object_functions[program.main_function.value]
    } else {
        Option::None
    };
    if main.is_none() {
        diagnostics.push(
            lower_diagnostic(
                Option::Some(program.main_package),
                Option::Some(program.main_function),
                Option::None,
                "main.main has no interpreted body",
            ),
        )
    }
    if !diagnostics.is_empty() {
        return LowerResult { program: Option::None, diagnostics }
    }
    let bytecode = BytecodeProgram {
        world: program.world,
        packages: package_bytecode(program, functions, globals, initializer),
        functions,
        globals,
        object_functions,
        object_globals,
        native_calls: native_link.calls,
        native_types: native_link.types,
        object_native_calls: native_link.object_calls,
        native_initialization_packages: native_link.initialization_packages,
        source_files: bytecode_source_files(program),
        initialization_order: program.initialization_order,
        main: main.unwrap_or(function_id(-1)),
    };
    if validate {
        let verification = verify(bytecode);
        for diagnostic in verification {
            diagnostics.push(verifier_lower_diagnostic(diagnostic))
        }
    }
    LowerResult {
        program: if diagnostics.is_empty() {
            Option::Some(bytecode)
        } else {
            Option::None
        },
        diagnostics,
    }
}

pub fn lower(program: execution::ExecutionProgram) -> LowerResult {
    lower_with_verification(program, true)
}

pub fn lower_unverified(program: execution::ExecutionProgram) -> LowerResult {
    lower_with_verification(program, false)
}
