package token;

const BREAK_KEYWORD: string = "break";

const DEFAULT_KEYWORD: string = "default";

const FUNC_KEYWORD: string = "func";

const INTERFACE_KEYWORD: string = "interface";

const SELECT_KEYWORD: string = "select";

const CASE_KEYWORD: string = "case";

const DEFER_KEYWORD: string = "defer";

const GO_KEYWORD: string = "go";

const MAP_KEYWORD: string = "map";

const STRUCT_KEYWORD: string = "struct";

const CHAN_KEYWORD: string = "chan";

const ELSE_KEYWORD: string = "else";

const GOTO_KEYWORD: string = "goto";

const PACKAGE_KEYWORD: string = "package";

const SWITCH_KEYWORD: string = "switch";

const CONST_KEYWORD: string = "const";

const FALLTHROUGH_KEYWORD: string = "fallthrough";

const IF_KEYWORD: string = "if";

const RANGE_KEYWORD: string = "range";

const TYPE_KEYWORD: string = "type";

const CONTINUE_KEYWORD: string = "continue";

const FOR_KEYWORD: string = "for";

const IMPORT_KEYWORD: string = "import";

const RETURN_KEYWORD: string = "return";

const VAR_KEYWORD: string = "var";

#[derive(PartialEq, Eq, ToString)]
pub enum Kind {
    Illegal,
    Eof,
    Comment,
    Ident,
    Int,
    Float,
    Imag,
    Char,
    String,
    Add,
    Sub,
    Mul,
    Quo,
    Rem,
    And,
    Or,
    Xor,
    Shl,
    Shr,
    AndNot,
    AddAssign,
    SubAssign,
    MulAssign,
    QuoAssign,
    RemAssign,
    AndAssign,
    OrAssign,
    XorAssign,
    ShlAssign,
    ShrAssign,
    AndNotAssign,
    Land,
    Lor,
    Arrow,
    Inc,
    Dec,
    Eql,
    Lss,
    Gtr,
    Assign,
    Not,
    Neq,
    Leq,
    Geq,
    Define,
    Ellipsis,
    Lparen,
    Lbrack,
    Lbrace,
    Comma,
    Period,
    Semicolon,
    Colon,
    Rparen,
    Rbrack,
    Rbrace,
    Break,
    Default,
    Func,
    Interface,
    Select,
    Case,
    Defer,
    Go,
    Map,
    Struct,
    Chan,
    Else,
    Goto,
    Package,
    Switch,
    Const,
    Fallthrough,
    If,
    Range,
    Type,
    Continue,
    For,
    Import,
    Return,
    Var,
    Tilde,
}

pub struct Token {
    pub literal: string,
    pub start: isize,
    pub end: isize,
    pub kind: Kind,
    pub synthetic: bool,
}

pub fn make(kind: Kind, literal: string, start: isize, end: isize, synthetic: bool) -> Token {
    Token { kind, literal, start, end, synthetic }
}

pub fn equal(left: Kind, right: Kind) -> bool {
    left == right
}

pub fn name(kind: Kind) -> string {
    match kind {
        Illegal => "ILLEGAL",
        Eof => "EOF",
        Comment => "COMMENT",
        Ident => "IDENT",
        Int => "INT",
        Float => "FLOAT",
        Imag => "IMAG",
        Char => "CHAR",
        String => "STRING",
        Add => "+",
        Sub => "-",
        Mul => "*",
        Quo => "/",
        Rem => "%",
        And => "&",
        Or => "|",
        Xor => "^",
        Shl => "<<",
        Shr => ">>",
        AndNot => "&^",
        AddAssign => "+=",
        SubAssign => "-=",
        MulAssign => "*=",
        QuoAssign => "/=",
        RemAssign => "%=",
        AndAssign => "&=",
        OrAssign => "|=",
        XorAssign => "^=",
        ShlAssign => "<<=",
        ShrAssign => ">>=",
        AndNotAssign => "&^=",
        Land => "&&",
        Lor => "||",
        Arrow => "<-",
        Inc => "++",
        Dec => "--",
        Eql => "==",
        Lss => "<",
        Gtr => ">",
        Assign => "=",
        Not => "!",
        Neq => "!=",
        Leq => "<=",
        Geq => ">=",
        Define => ":=",
        Ellipsis => "...",
        Lparen => "(",
        Lbrack => "[",
        Lbrace => "{",
        Comma => ",",
        Period => ".",
        Semicolon => ";",
        Colon => ":",
        Rparen => ")",
        Rbrack => "]",
        Rbrace => "}",
        Break => BREAK_KEYWORD,
        Default => DEFAULT_KEYWORD,
        Func => FUNC_KEYWORD,
        Interface => INTERFACE_KEYWORD,
        Select => SELECT_KEYWORD,
        Case => CASE_KEYWORD,
        Defer => DEFER_KEYWORD,
        Go => GO_KEYWORD,
        Map => MAP_KEYWORD,
        Struct => STRUCT_KEYWORD,
        Chan => CHAN_KEYWORD,
        Else => ELSE_KEYWORD,
        Goto => GOTO_KEYWORD,
        Package => PACKAGE_KEYWORD,
        Switch => SWITCH_KEYWORD,
        Const => CONST_KEYWORD,
        Fallthrough => FALLTHROUGH_KEYWORD,
        If => IF_KEYWORD,
        Range => RANGE_KEYWORD,
        Type => TYPE_KEYWORD,
        Continue => CONTINUE_KEYWORD,
        For => FOR_KEYWORD,
        Import => IMPORT_KEYWORD,
        Return => RETURN_KEYWORD,
        Var => VAR_KEYWORD,
        Tilde => "~",
    }
}

pub fn lookup(identifier: string) -> Kind {
    match identifier {
        BREAK_KEYWORD => Kind::Break,
        DEFAULT_KEYWORD => Kind::Default,
        FUNC_KEYWORD => Kind::Func,
        INTERFACE_KEYWORD => Kind::Interface,
        SELECT_KEYWORD => Kind::Select,
        CASE_KEYWORD => Kind::Case,
        DEFER_KEYWORD => Kind::Defer,
        GO_KEYWORD => Kind::Go,
        MAP_KEYWORD => Kind::Map,
        STRUCT_KEYWORD => Kind::Struct,
        CHAN_KEYWORD => Kind::Chan,
        ELSE_KEYWORD => Kind::Else,
        GOTO_KEYWORD => Kind::Goto,
        PACKAGE_KEYWORD => Kind::Package,
        SWITCH_KEYWORD => Kind::Switch,
        CONST_KEYWORD => Kind::Const,
        FALLTHROUGH_KEYWORD => Kind::Fallthrough,
        IF_KEYWORD => Kind::If,
        RANGE_KEYWORD => Kind::Range,
        TYPE_KEYWORD => Kind::Type,
        CONTINUE_KEYWORD => Kind::Continue,
        FOR_KEYWORD => Kind::For,
        IMPORT_KEYWORD => Kind::Import,
        RETURN_KEYWORD => Kind::Return,
        VAR_KEYWORD => Kind::Var,
        _ => Kind::Ident,
    }
}

pub fn inserts_semicolon(kind: Kind) -> bool {
    equal(kind, Kind::Ident) || equal(kind, Kind::Int) || equal(kind, Kind::Float)
        || equal(kind, Kind::Imag)
        || equal(kind, Kind::Char)
        || equal(kind, Kind::String)
        || equal(kind, Kind::Break)
        || equal(kind, Kind::Continue)
        || equal(kind, Kind::Fallthrough)
        || equal(kind, Kind::Return)
        || equal(kind, Kind::Inc)
        || equal(kind, Kind::Dec)
        || equal(kind, Kind::Rparen)
        || equal(kind, Kind::Rbrack)
        || equal(kind, Kind::Rbrace)
}
