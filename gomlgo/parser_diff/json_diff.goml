package parser_diff;

use std::json;

pub const PARSE_ACCEPTANCE_MODE: string = "parse-acceptance";

pub const AST_SHAPE_MODE: string = "ast-shape";

pub const AST_POSITION_MODE: string = "ast-position";

pub const AST_COMMENTS_MODE: string = "ast-comments";

pub const DIAGNOSTIC_STRICT_MODE: string = "diagnostic-strict";

#[derive(PartialEq, Eq)]
pub enum Mode {
    Acceptance,
    Shape,
    Position,
    Comments,
    Diagnostics,
}

pub struct Difference {
    pub path: string,
    pub expected: string,
    pub actual: string,
    pub offset: isize,
}

pub fn mode_from_string(value: string) -> Option[Mode] {
    match value {
        PARSE_ACCEPTANCE_MODE => Option::Some(Mode::Acceptance),
        AST_SHAPE_MODE => Option::Some(Mode::Shape),
        AST_POSITION_MODE => Option::Some(Mode::Position),
        AST_COMMENTS_MODE => Option::Some(Mode::Comments),
        DIAGNOSTIC_STRICT_MODE => Option::Some(Mode::Diagnostics),
        _ => Option::None,
    }
}

pub fn mode_name(value: Mode) -> string {
    match value {
        Acceptance => PARSE_ACCEPTANCE_MODE,
        Shape => AST_SHAPE_MODE,
        Position => AST_POSITION_MODE,
        Comments => AST_COMMENTS_MODE,
        Diagnostics => DIAGNOSTIC_STRICT_MODE,
    }
}

fn ignored_field(mode: Mode, name: string) -> bool {
    (mode == Mode::Shape || mode == Mode::Position)
        && (name == "doc" || name == "comment" || name == "comments" || name == "go_version")
}

fn difference(path: string, expected: json::Value, actual: json::Value, offset: isize) -> Difference {
    Difference { path, expected: json::encode(expected), actual: json::encode(actual), offset }
}

fn compare_object(
    actual: Vec[(string, json::Value)],
    expected: Vec[(string, json::Value)],
    path: string,
    mode: Mode,
    parent_offset: isize,
) -> Option[Difference] {
    let actual_value = json::Value::Object(actual);
    let expected_value = json::Value::Object(expected);
    let offset = match json::field(expected_value, "start") {
        Some(value) => json::as_int(value).unwrap_or(parent_offset),
        None => parent_offset,
    };
    for entry in expected {
        if !ignored_field(mode, entry.0) {
            match json::field(actual_value, entry.0) {
                Some(value) => if let Some(value) = compare_json(
                    value,
                    entry.1,
                    path + "." + entry.0,
                    entry.0,
                    mode,
                    offset,
                ) {
                    return Option::Some(value)
                },
                None => return Option::Some(
                    Difference {
                        path: path + "." + entry.0,
                        expected: json::encode(entry.1),
                        actual: "<missing>",
                        offset,
                    },
                ),
            }
        }
    }
    for entry in actual {
        if !ignored_field(mode, entry.0) && json::field(expected_value, entry.0).is_none() {
            return Option::Some(
                Difference {
                    path: path + "." + entry.0,
                    expected: "<missing>",
                    actual: json::encode(entry.1),
                    offset,
                },
            )
        }
    }
    Option::None
}

fn compare_array(
    actual: Vec[json::Value],
    expected: Vec[json::Value],
    path: string,
    key: string,
    mode: Mode,
    offset: isize,
) -> Option[Difference] {
    if actual.len() != expected.len() {
        Option::Some(
            Difference {
                path: path + ".len",
                expected: expected.len().to_string(),
                actual: actual.len().to_string(),
                offset,
            },
        )
    } else {
        for index in 0..expected.len() {
            if let Some(value) = compare_json(
                actual[index],
                expected[index],
                f"{path}[{index}]",
                key,
                mode,
                offset,
            ) {
                return Option::Some(value)
            }
        }
        Option::None
    }
}

fn compare_json(
    actual: json::Value,
    expected: json::Value,
    path: string,
    key: string,
    mode: Mode,
    offset: isize,
) -> Option[Difference] {
    match (actual, expected) {
        (json::Value::Object(actual), json::Value::Object(expected)) => {
            compare_object(actual, expected, path, mode, offset)
        },
        (json::Value::Array(actual), json::Value::Array(expected)) => {
            compare_array(actual, expected, path, key, mode, offset)
        },
        (json::Value::String(actual), json::Value::String(expected)) => if actual == expected {
            Option::None
        } else {
            Option::Some(
                difference(path, json::Value::String(expected), json::Value::String(actual), offset),
            )
        },
        (json::Value::Number(actual), json::Value::Number(expected)) => if mode == Mode::Shape
            && key != "dir" {
            Option::None
        } else if actual == expected {
            Option::None
        } else {
            Option::Some(
                difference(path, json::Value::Number(expected), json::Value::Number(actual), offset),
            )
        },
        (json::Value::Bool(actual), json::Value::Bool(expected)) => if actual == expected {
            Option::None
        } else {
            Option::Some(
                difference(path, json::Value::Bool(expected), json::Value::Bool(actual), offset),
            )
        },
        (json::Value::Null, json::Value::Null) => Option::None,
        (actual, expected) => Option::Some(difference(path, expected, actual, offset)),
    }
}

pub fn compare_ast(actual: json::Value, expected: json::Value, mode: Mode) -> Option[Difference] {
    compare_json(actual, expected, "$", "", mode, -1)
}
