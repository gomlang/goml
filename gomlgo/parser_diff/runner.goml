package parser_diff;

use gomlgo::ast;
use gomlgo::differential;
use gomlgo::parser;
use std::collections;
use std::fs;
use std::path;

pub struct Summary {
    pub files: isize,
    pub accepted: isize,
}

fn collect_go_files(directory: string, files: Vec[string]) -> Result[(), string] {
    let names = fs::read_dir(directory).map_err(|error| error.to_string())?;
    collections::sort(names);
    for name in names {
        let entry = path::join(directory, name);
        if fs::is_dir(entry) {
            collect_go_files(entry, files)?
        } else if fs::is_file(entry) && path::extension(entry) == Option::Some("go") {
            files.push(entry)
        }
    }
    Result::Ok(())
}

fn compare_diagnostics(
    file: string,
    actual: parser::ParseResult,
    expected: differential::OracleResponse,
) -> Result[(), string] {
    if actual.diagnostics.len() != expected.diagnostics.len() {
        Result::Err(
            f"{file}: diagnostic count mismatch\nexpected={expected.diagnostics.len()}\nactual={actual.diagnostics.len()}",
        )
    } else {
        for index in 0..expected.diagnostics.len() {
            if actual.diagnostics[index].offset != expected.diagnostics[index].offset
                || actual.diagnostics[index].message != expected.diagnostics[index].message {
                return Result::Err(
                    f"{file}: diagnostic mismatch at index {index}\nexpected={expected.diagnostics[index].offset}: {expected.diagnostics[index].message}\nactual={actual.diagnostics[index].offset}: {actual.diagnostics[index].message}",
                )
            }
        }
        Result::Ok(())
    }
}

fn compare_file(file: string, mode: Mode) -> Result[bool, string] {
    let source = fs::read_bytes_structured(file).map_err(|error| error.to_string())?;
    let actual = parser::parse_file_bytes(source);
    let expected = differential::run_oracle("parse-file", source)?;
    let actual_ok = actual.diagnostics.is_empty();
    if actual_ok != expected.ok {
        let actual_diagnostic = if actual.diagnostics.is_empty() {
            "none"
        } else {
            f"{actual.diagnostics[0].offset}: {actual.diagnostics[0].message}"
        };
        let expected_diagnostic = if expected.diagnostics.is_empty() {
            "none"
        } else {
            f"{expected.diagnostics[0].offset}: {expected.diagnostics[0].message}"
        };
        return Result::Err(
            f"{file}: parse acceptance mismatch\nactual ok={actual_ok} first diagnostic={actual_diagnostic}\nexpected ok={expected.ok} first diagnostic={expected_diagnostic}",
        )
    }
    if mode == Mode::Diagnostics {
        compare_diagnostics(file, actual, expected)?
    } else if mode != Mode::Acceptance && actual_ok {
        let actual_ast = match actual.root {
            Some(root) => ast::to_json(root),
            None => return Result::Err(file + ": missing GoML AST"),
        };
        if let Some(value) = compare_ast(actual_ast, expected.ast, mode) {
            return Result::Err(
                file + ": " + mode_name(mode)
                    + f" mismatch\npath={value.path}\noffset={value.offset}\nexpected={value.expected}\nactual={value.actual}",
            )
        }
    }
    Result::Ok(actual_ok)
}

pub fn compare_tree(root: string, mode: Mode) -> Result[Summary, string] {
    let files: Vec[string] = Vec::new();
    if fs::is_file(root) {
        files.push(root)
    } else {
        collect_go_files(root, files)?
    }
    let mut accepted = 0;
    for file in files {
        if compare_file(file, mode)? {
            accepted += 1;
        }
    }
    Result::Ok(Summary { files: files.len(), accepted })
}
