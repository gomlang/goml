package checker;

use gomlgo::constant;
use gomlgo::syntax;
use gomlgo::types as go_types;
use std::text;
use std::unicode;

fn import_character_code(value: char) -> string {
    let digits = "0123456789ABCDEF";
    let mut number = value.to_u32();
    let mut result = "";
    while number > 0 {
        let digit = (number % 16).to_isize();
        result = digits.byte_slice(digit, digit + 1) + result;
        number /= 16;
    }
    while result.byte_len() < 4 {
        result = "0" + result;
    }
    result
}

fn invalid_import_character(value: string) -> Option[string] {
    let illegal = "!\"#$%&'()*,:;<=>?[\\]^{|}`�";
    for character in value.chars() {
        if unicode::is_control(character) || unicode::is_whitespace(character)
            || illegal.contains(character.to_string()) {
            return Option::Some(
                "invalid character U+" + import_character_code(character) + f" '{character}'",
            )
        }
    }
    Option::None
}

fn import_path(state: CheckState, node: syntax::NodeId) -> Option[string] {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::BasicLit { value_pos: _, value_end: _, token: _, value }) => if value.contains(
            "\\xff",
        )
            || value.contains("\\xFF") {
            diagnostic(state, node, "invalid import path (invalid character U+FFFD '�')", false);
            Option::None
        } else {
            match constant::parse_string_literal(value) {
                Ok(constant::ConstValue::String(value)) => if value == "" {
                    diagnostic(state, node, "invalid import path (empty string)", false);
                    Option::None
                } else {
                    match invalid_import_character(value) {
                        Some(message) => {
                            diagnostic(state, node, "invalid import path (" + message + ")", false);
                            Option::None
                        },
                        None => Option::Some(value),
                    }
                },
                _ => {
                    diagnostic(state, node, "invalid import path", false);
                    Option::None
                },
            }
        },
        _ => Option::None,
    }
}

fn package_by_path(state: CheckState, path: string) -> Option[go_types::PackageId] {
    for pkg in state.world.packages {
        if pkg.path == path || pkg.path == "vendor/" + path || pkg.path == "cmd/vendor/" + path {
            return Option::Some(pkg.id)
        }
    }
    Option::None
}

fn available_import_name(state: CheckState, path: string) -> Option[string] {
    if path == "unsafe" {
        return Option::Some("unsafe")
    } else if path == "C" && state.config.fake_import_c {
        return Option::Some("C")
    }
    if let Some(package_id) = package_by_path(state, path) {
        return Option::Some(state.world.packages[package_id.value].name)
    }
    for available in state.config.available_imports {
        if available.path == path {
            return Option::Some(available.name)
        }
    }
    Option::None
}

fn import_error_message(state: CheckState, path: string) -> string {
    for value in state.config.import_errors {
        if value.path == path {
            return " (" + value.message + ")"
        }
    }
    ""
}

fn imported_package(state: CheckState, path: string, name: string) -> go_types::PackageId {
    package_by_path(state, path).unwrap_or_else(
        || go_types::add_package(state.world, path, name, state.world.universe, true),
    )
}

fn incomplete_imported_package(state: CheckState, path: string, name: string) -> go_types::PackageId {
    package_by_path(state, path).unwrap_or_else(
        || go_types::add_package(state.world, path, name, state.world.universe, false),
    )
}

fn ignored_import(state: CheckState, path: string) -> bool {
    for value in state.config.ignored_imports {
        if value == path {
            return true
        }
    }
    false
}

fn insert_dot_import(
    state: CheckState,
    file_scope: go_types::ScopeId,
    package_id: go_types::PackageId,
    node: syntax::NodeId,
) -> () {
    let package_scope = state.world.packages[package_id.value].scope;
    for entry in state.world.scopes[package_scope.value].entries {
        match go_types::get_object(state.world, entry.object) {
            Some(object) => if object.exported {
                match go_types::insert(state.world, file_scope, entry.name, entry.object) {
                    Some(_) => diagnostic(
                        state,
                        node,
                        entry.name + " redeclared in this block",
                        false,
                    ),
                    None => {},
                }
            },
            None => {},
        }
    }
}

fn bind_import(
    state: CheckState,
    file_scope: go_types::ScopeId,
    node: syntax::NodeId,
    name: Option[syntax::NodeId],
    package_id: go_types::PackageId,
    default_name: string,
    ignored: bool,
) -> () {
    let binding_name = match name {
        Some(name) => identifier(state, name).unwrap_or(""),
        None => default_name,
    };
    let object_node = name.unwrap_or(node);
    let implicitly_used = state.config.fake_import_c
        && state.world.packages[package_id.value].path == "C";
    if binding_name == "init" {
        diagnostic(state, object_node, "cannot import package as init - init must be a func", false);
        return
    }
    let object = go_types::add_object(
        state.world,
        go_types::ObjectKind::PackageName,
        binding_name,
        Option::Some(state.package_id),
        node_file(state, node),
        Option::Some(object_node),
        node_start(state, object_node),
        state.world.invalid,
    );
    let _ = go_types::set_object_imported_package(state.world, object, package_id);
    match name {
        Some(name_node) => state.info.defs.push(
            ObjectFact { node: name_node, object: Option::Some(object) },
        ),
        None => state.info.implicits.push(ObjectFact { node, object: Option::Some(object) }),
    }
    if binding_name == "." {
        insert_dot_import(state, file_scope, package_id, node);
        let index = state.imports.len();
        state.imports.push(ImportBinding { object, node, used: implicitly_used, ignored });
        match state.dot_import_indices[package_id.value] {
            Some(indices) => indices.push(index),
            None => {
                state.dot_import_indices[package_id.value] = Vec::from_array([index]);
            },
        }
    } else if binding_name == "_" {} else {
        match go_types::insert(state.world, file_scope, binding_name, object) {
            Some(_) => diagnostic(
                state,
                object_node,
                binding_name + " redeclared in this block",
                false,
            ),
            None => state.imports.push(
                ImportBinding { object, node, used: implicitly_used, ignored },
            ),
        }
    }
}

fn process_import_spec(state: CheckState, file_scope: go_types::ScopeId, node: syntax::NodeId) -> () {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::ImportSpec { name, path, end_pos: _ }) => match import_path(
            state,
            path,
        ) {
            Some(import_path_value) => if state.config.exported_api_only
                && ignored_import(state, import_path_value) {} else if import_path_value
                == state.world.packages[state.package_id.value].path {
                diagnostic(state, path, "import cycle not allowed", false)
            } else if import_path_value == "C" && state.config.fake_import_c && name.is_some() {
                diagnostic(state, name.unwrap_or(node), "cannot rename import \"C\"", false)
            } else {
                match available_import_name(state, import_path_value) {
                    Some(default_name) => {
                        let package_id = imported_package(state, import_path_value, default_name);
                        bind_import(state, file_scope, node, name, package_id, default_name, false)
                    },
                    None => {
                        diagnostic(
                            state,
                            path,
                            "could not import " + import_path_value
                                + import_error_message(state, import_path_value),
                            false,
                        );
                        let parts = text::split(import_path_value, "/");
                        let default_name = parts[parts.len() - 1];
                        let package_id = incomplete_imported_package(
                            state,
                            import_path_value,
                            default_name,
                        );
                        bind_import(state, file_scope, node, name, package_id, default_name, true)
                    },
                }
            },
            None => {},
        },
        _ => diagnostic(state, node, "invalid import declaration", false),
    }
}

fn process_file_imports(state: CheckState, file_index: isize) -> () {
    let file = state.syntax.files[file_index];
    let file_scope = state.file_scopes[file_index];
    match syntax::get_kind(state.syntax.arena, file.root) {
        Some(syntax::SyntaxKind::File {
            package_pos: _,
            name: _,
            declarations: _,
            imports,
            go_version: _,
        }) => for import in imports {
            process_import_spec(state, file_scope, import)
        },
        _ => {},
    }
}

fn mark_import_used(state: CheckState, object: go_types::ObjectId) -> () {
    for index in 0..state.imports.len() {
        if state.imports[index].object.value == object.value {
            state.imports[index].used = true;
        }
    }
}

fn mark_dot_import_used(state: CheckState, object: go_types::ObjectId) -> () {
    let owner = if object.value >= 0 && object.value < state.world.objects.len() {
        state.world.objects[object.value].owner
    } else {
        Option::None
    };
    match owner {
        Some(package_id) => match state.dot_import_indices[package_id.value] {
            Some(indices) => for index in indices {
                state.imports[index].used = true;
            },
            None => {},
        },
        None => {},
    }
}

fn imported_package_description(state: CheckState, package_id: go_types::PackageId) -> string {
    let imported_package = state.world.packages[package_id.value];
    "package " + imported_package.name + " (\"" + imported_package.path + "\")"
}

fn check_package_import_conflicts(state: CheckState) -> () {
    let package_scope = state.world.packages[state.package_id.value].scope;
    for file_scope in state.file_scopes {
        for entry in state.world.scopes[file_scope.value].entries {
            match go_types::lookup_local(state.world, package_scope, entry.name) {
                Some(package_object_id) => match (
                    go_types::get_object(state.world, package_object_id),
                    go_types::get_object(state.world, entry.object),
                ) {
                    (Some(package_object), Some(file_object)) => match package_object.node {
                        Some(node) => if file_object.kind == go_types::ObjectKind::PackageName {
                            match file_object.imported_package {
                                Some(imported) => {
                                    diagnostic(
                                        state,
                                        node,
                                        package_object.name + " already declared through import of "
                                            + imported_package_description(state, imported),
                                        false,
                                    );
                                    match file_object.node {
                                        Some(other) => secondary_diagnostic(
                                            state,
                                            other,
                                            "\tother declaration of " + package_object.name,
                                        ),
                                        None => {},
                                    }
                                },
                                None => {},
                            }
                        } else {
                            match file_object.owner {
                                Some(imported) => {
                                    diagnostic(
                                        state,
                                        node,
                                        package_object.name
                                            + " already declared through dot-import of "
                                            + imported_package_description(state, imported),
                                        false,
                                    );
                                    state.diagnostics.push(
                                        CheckDiagnostic {
                                            file: "",
                                            start: 0,
                                            end: 0,
                                            message: "\tother declaration of " + package_object.name,
                                            soft: false,
                                            secondary: true,
                                        },
                                    );
                                },
                                None => {},
                            }
                        },
                        None => {},
                    },
                    _ => {},
                },
                None => {},
            }
        }
    }
}

fn check_unused_imports(state: CheckState) -> () {
    if state.config.disable_unused_import_check {
        return
    }
    for import in state.imports {
        if !import.used && !import.ignored {
            match go_types::get_object(state.world, import.object) {
                Some(object) => match object.imported_package {
                    Some(package_id) => {
                        let import_path = state.world.packages[package_id.value].path;
                        let parts = text::split(import_path, "/");
                        let default_name = parts[parts.len() - 1];
                        diagnostic(
                            state,
                            import.node,
                            "\"" + import_path + "\" imported"
                                + if object.name == "" || object.name == "."
                                    || object.name == default_name {
                                    ""
                                } else {
                                    " as " + object.name
                                }
                                + " and not used",
                            true,
                        )
                    },
                    None => {},
                },
                None => {},
            }
        }
    }
}
