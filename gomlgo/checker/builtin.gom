package checker;

use gomlgo::constant;
use gomlgo::syntax;
use gomlgo::types as go_types;
use std::num;
use std::text;

struct BuiltinReference {
    name: string,
    object: go_types::ObjectId,
    node: syntax::NodeId,
    fact_node: syntax::NodeId,
}

fn builtin_reference(state: CheckState, scope: go_types::ScopeId, node: syntax::NodeId) -> Option[
    BuiltinReference,
] {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::Ident { name_pos: _, name }) => match go_types::lookup(
            state.world,
            scope,
            name,
        ) {
            Some(object) => {
                let index = checked_object_index(state, object);
                if index >= 0 && state.world.objects[index].kind == go_types::ObjectKind::Builtin {
                    Option::Some(BuiltinReference { name, object, node, fact_node: node })
                } else {
                    Option::None
                }
            },
            None => Option::None,
        },
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => builtin_reference(
            state,
            scope,
            expression,
        ).map(
            |reference| BuiltinReference {
                name: reference.name,
                object: reference.object,
                node: reference.node,
                fact_node: node,
            },
        ),
        Some(syntax::SyntaxKind::SelectorExpr { expression, selector }) => match identifier(
            state,
            expression,
        ) {
            Some(package_name) => match go_types::lookup(state.world, scope, package_name) {
                Some(package_object) => {
                    let package_index = checked_object_index(state, package_object);
                    if package_index < 0 {
                        return Option::None
                    }
                    match state.world.objects[package_index].imported_package {
                        Some(package_id) => {
                            let name = identifier(state, selector).unwrap_or("");
                            match go_types::lookup_local(
                                state.world,
                                state.world.packages[package_id.value].scope,
                                name,
                            ) {
                                Some(object) => {
                                    let index = checked_object_index(state, object);
                                    if index >= 0
                                        && state.world.objects[index].kind
                                            == go_types::ObjectKind::Builtin {
                                        mark_import_used(state, package_object);
                                        record_use(state, expression, package_object);
                                        Option::Some(
                                            BuiltinReference {
                                                name,
                                                object,
                                                node: selector,
                                                fact_node: node,
                                            },
                                        )
                                    } else {
                                        Option::None
                                    }
                                },
                                None => Option::None,
                            }
                        },
                        None => Option::None,
                    }
                },
                None => Option::None,
            },
            None => Option::None,
        },
        _ => Option::None,
    }
}

fn record_builtin_fact_nodes(state: CheckState, node: syntax::NodeId) -> () {
    if type_fact_index(state, node).is_none() {
        index_type_fact(state, node, state.info.types.len());
        state.info.types.push(
            TypeFact {
                node,
                type_id: state.world.invalid,
                extra: Option::None,
                void: false,
                type_expr: false,
                builtin: true,
                value_expr: false,
                nil: false,
                addressable: false,
                assignable: false,
                comma_ok: false,
            },
        )
    }
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => record_builtin_fact_nodes(
            state,
            expression,
        ),
        _ => {},
    }
}

fn record_builtin_reference(state: CheckState, reference: BuiltinReference) -> () {
    record_use(state, reference.node, reference.object);
    record_builtin_fact_nodes(state, reference.fact_node)
}

fn update_builtin_signature(state: CheckState, node: syntax::NodeId, signature: go_types::TypeId) -> () {
    match type_fact_index(state, node) {
        Some(index) => {
            state.info.types[index].type_id = signature;
        },
        None => {},
    }
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => update_builtin_signature(
            state,
            expression,
            signature,
        ),
        _ => {},
    }
}

fn builtin_signature_tuple(state: CheckState, values: Vec[go_types::TypeId]) -> go_types::TypeId {
    let variables: Vec[go_types::Variable] = Vec::new();
    for value in values {
        variables.push(go_types::Variable { name: "", owner: Option::None, type_id: value })
    }
    go_types::add_type(state.world, go_types::TypeKind::Tuple { variables })
}

fn builtin_empty_interface(state: CheckState) -> go_types::TypeId {
    if !state.config.enable_alias {
        return go_types::add_type(
            state.world,
            go_types::TypeKind::Interface {
                methods: Vec::new(),
                embeddeds: Vec::new(),
                comparable: false,
                implicit: false,
            },
        )
    }
    match go_types::lookup(state.world, state.world.universe, "any") {
        Some(object) => {
            let index = checked_object_index(state, object);
            if index >= 0 {
                go_types::unalias(state.world, state.world.objects[index].type_id)
            } else {
                state.world.invalid
            }
        },
        None => state.world.invalid,
    }
}

fn record_builtin_signature(
    state: CheckState,
    reference: BuiltinReference,
    arguments: Vec[syntax::NodeId],
    result: Operand,
    ellipsis: isize,
) -> () {
    let parameter_types: Vec[go_types::TypeId] = Vec::new();
    let expanded = if arguments.len() == 1 {
        match recorded_type_fact(state, arguments[0]) {
            Some(fact) => tuple_variables(state, fact.type_id),
            None => Vec::new(),
        }
    } else {
        Vec::new()
    };
    if result.type_id.value != state.world.invalid.value && expanded.len() > 1 {
        if reference.name == APPEND_BUILTIN {
            let slice_type = expanded[0].type_id;
            parameter_types.push(slice_type);
            parameter_types.push(
                match slice_element_type(state, slice_type) {
                    Some(element) => go_types::add_type(
                        state.world,
                        go_types::TypeKind::Slice { element },
                    ),
                    None => state.world.invalid,
                },
            )
        } else {
            for variable in expanded {
                parameter_types.push(variable.type_id)
            }
        }
    } else if reference.name == PANIC_BUILTIN {
        parameter_types.push(builtin_empty_interface(state))
    } else if reference.name == UNSAFE_SLICE_DATA_BUILTIN && arguments.len() == 1 {
        let argument_type = match recorded_type_fact(state, arguments[0]) {
            Some(fact) => fact.type_id,
            None => state.world.invalid,
        };
        parameter_types.push(
            match slice_element_type(state, argument_type) {
                Some(element) => go_types::add_type(
                    state.world,
                    go_types::TypeKind::Slice { element },
                ),
                None => argument_type,
            },
        )
    } else if reference.name == UNSAFE_SLICE_BUILTIN && !arguments.is_empty() {
        let argument_type = match recorded_type_fact(state, arguments[0]) {
            Some(fact) => fact.type_id,
            None => state.world.invalid,
        };
        parameter_types.push(
            match underlying_kind(state, argument_type) {
                Some(go_types::TypeKind::Pointer { element }) => go_types::add_type(
                    state.world,
                    go_types::TypeKind::Pointer { element },
                ),
                _ => argument_type,
            },
        );
        for index in 1..arguments.len() {
            parameter_types.push(
                match recorded_type_fact(state, arguments[index]) {
                    Some(fact) => fact.type_id,
                    None => state.world.invalid,
                },
            )
        }
    } else if reference.name == UNSAFE_STRING_BUILTIN && arguments.len() == 2 {
        parameter_types.push(
            go_types::add_type(
                state.world,
                go_types::TypeKind::Pointer { element: basic_type_id(state, "byte") },
            ),
        );
        parameter_types.push(
            match recorded_type_fact(state, arguments[1]) {
                Some(fact) => fact.type_id,
                None => state.world.invalid,
            },
        )
    } else if reference.name == COPY_BUILTIN && arguments.len() == 2 {
        for index in 0..arguments.len() {
            let argument_type = match recorded_type_fact(state, arguments[index]) {
                Some(fact) => fact.type_id,
                None => state.world.invalid,
            };
            parameter_types.push(
                if index == 1
                    && basic_kind(state, argument_type) == go_types::BasicKind::UntypedString {
                    basic_type_id(state, "string")
                } else {
                    argument_type
                },
            )
        }
    } else if reference.name == DELETE_BUILTIN && arguments.len() == 2 {
        let map_type = match recorded_type_fact(state, arguments[0]) {
            Some(fact) => fact.type_id,
            None => state.world.invalid,
        };
        parameter_types.push(map_type);
        parameter_types.push(
            match underlying_kind(state, map_type) {
                Some(go_types::TypeKind::Map { key, value: _ }) => key,
                _ => match recorded_type_fact(state, arguments[1]) {
                    Some(fact) => fact.type_id,
                    None => state.world.invalid,
                },
            },
        )
    } else if reference.name == APPEND_BUILTIN && !arguments.is_empty() {
        let slice_type = match recorded_type_fact(state, arguments[0]) {
            Some(fact) => fact.type_id,
            None => state.world.invalid,
        };
        parameter_types.push(slice_type);
        let argument_type = if arguments.len() > 1 {
            match recorded_type_fact(state, arguments[1]) {
                Some(fact) => fact.type_id,
                None => state.world.invalid,
            }
        } else {
            state.world.invalid
        };
        parameter_types.push(
            if ellipsis >= 0 && go_types::is_type_parameter(state.world, slice_type) {
                match slice_element_type(state, slice_type) {
                    Some(element) => go_types::add_type(
                        state.world,
                        go_types::TypeKind::Slice { element },
                    ),
                    None => state.world.invalid,
                }
            } else if ellipsis >= 0 && go_types::is_type_parameter(state.world, argument_type)
                && append_byte_sequence_type(state, argument_type) {
                argument_type
            } else if ellipsis >= 0 && is_string_type(state, argument_type) {
                if basic_kind(state, argument_type) == go_types::BasicKind::UntypedString {
                    basic_type_id(state, "string")
                } else {
                    argument_type
                }
            } else {
                match slice_element_type(state, slice_type) {
                    Some(element) => go_types::add_type(
                        state.world,
                        go_types::TypeKind::Slice { element },
                    ),
                    None => state.world.invalid,
                }
            },
        )
    } else {
        for argument in arguments {
            match recorded_type_fact(state, argument) {
                Some(fact) => {
                    let variables = tuple_variables(state, fact.type_id);
                    if state.invalid_builtin_parameter_nodes.contains(argument.value) {
                        parameter_types.push(state.world.invalid)
                    } else if variables.len() > 1 {
                        for variable in variables {
                            parameter_types.push(variable.type_id)
                        }
                    } else {
                        parameter_types.push(fact.type_id)
                    }
                },
                None => parameter_types.push(state.world.invalid),
            }
        }
    }
    let result_types: Vec[go_types::TypeId] = Vec::new();
    if result.type_id.value != state.world.invalid.value {
        result_types.push(result.type_id)
    }
    let signature = go_types::add_type(
        state.world,
        go_types::TypeKind::Signature {
            receiver: Option::None,
            receiver_type_params: Vec::new(),
            type_params: Vec::new(),
            params: builtin_signature_tuple(state, parameter_types),
            results: builtin_signature_tuple(state, result_types),
            variadic: reference.name == APPEND_BUILTIN,
        },
    );
    update_builtin_signature(state, reference.fact_node, signature)
}

fn builtin_operand(type_id: go_types::TypeId) -> Operand {
    Operand { type_id, value: Option::None, addressable: false, assignable: false }
}

fn mark_void_node(state: CheckState, node: syntax::NodeId) -> () {
    let _ = state.omitted_type_fact_nodes.remove(node.value);
    if state.void_node_indices.contains(node.value) {
        return
    }
    let _ = state.void_node_indices.insert(node.value);
    state.void_nodes.push(node)
}

fn node_is_void(state: CheckState, node: syntax::NodeId) -> bool {
    state.void_node_indices.contains(node.value)
}

fn void_operand(state: CheckState, node: syntax::NodeId) -> Operand {
    mark_void_node(state, node);
    builtin_operand(state.world.invalid)
}

fn check_builtin_count(
    state: CheckState,
    node: syntax::NodeId,
    actual: isize,
    minimum: isize,
    maximum: isize,
) -> bool {
    if actual < minimum || (maximum >= 0 && actual > maximum) {
        let (position, call) = match syntax::get_kind(state.syntax.arena, node) {
            Some(syntax::SyntaxKind::CallExpr {
                function: _,
                lparen: _,
                arguments: _,
                ellipsis: _,
                rparen,
            }) => {
                let text = expression_source_text(state, node);
                let call = if text == "" {
                    "builtin call"
                } else {
                    text
                };
                (rparen, call)
            },
            _ => (-1, "builtin call"),
        };
        let expected = if actual < minimum {
            minimum
        } else {
            maximum
        };
        let amount = if actual < minimum {
            "not enough"
        } else {
            "too many"
        };
        diagnostic_at_position(
            state,
            node,
            position,
            f"invalid operation: {amount} arguments for {call} (expected {expected}, found {actual})",
            false,
        );
        false
    } else {
        true
    }
}

fn check_builtin_raw_arity(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    name: string,
    arguments: Vec[syntax::NodeId],
) -> bool {
    if let MAKE_BUILTIN | NEW_BUILTIN | UNSAFE_OFFSETOF_BUILTIN = name {
        return true
    }
    let minimum = match name {
        APPEND_BUILTIN | MAKE_BUILTIN | MIN_BUILTIN | MAX_BUILTIN => 1,
        PRINT_BUILTIN | PRINTLN_BUILTIN | RECOVER_BUILTIN => 0,
        DELETE_BUILTIN | COPY_BUILTIN | COMPLEX_BUILTIN | UNSAFE_ADD_BUILTIN | UNSAFE_SLICE_BUILTIN | UNSAFE_STRING_BUILTIN => 2,
        _ => 1,
    };
    let maximum = match name {
        APPEND_BUILTIN | MIN_BUILTIN | MAX_BUILTIN | PRINT_BUILTIN | PRINTLN_BUILTIN => -1,
        _ => minimum,
    };
    if maximum < 0 || arguments.len() <= maximum {
        true
    } else {
        let mut valid = true;
        let mut effective_count = arguments.len();
        for argument in arguments {
            let value = check_expression(state, scope, argument);
            let has_value = require_value(state, argument);
            if arguments.len() == 1 {
                let expanded = tuple_variables(state, value.type_id);
                if !expanded.is_empty() {
                    effective_count = expanded.len();
                }
            }
            if !has_value || value.type_id.value == state.world.invalid.value {
                valid = false;
            }
        }
        if valid {
            let _ = check_builtin_count(state, node, effective_count, minimum, maximum);
        }
        false
    }
}

fn underlying_kind(state: CheckState, value: go_types::TypeId) -> Option[go_types::TypeKind] {
    let resolved = core_type_id(state, value);
    if go_types::has_type(state.world, resolved) {
        Option::Some(go_types::type_data(state.world, resolved).kind)
    } else {
        Option::None
    }
}

fn integer_builtin_argument(state: CheckState, scope: go_types::ScopeId, node: syntax::NodeId) -> () {
    let operand = check_expression(state, scope, node);
    if !go_types::is_integer(state.world, operand.type_id) {
        diagnostic(state, node, "builtin argument must be integer", false)
    } else if go_types::is_untyped(state.world, operand.type_id) {
        update_contextual_operand_fact(state, node, operand, default_operand_type(state, operand))
    }
}

fn length_builtin_argument(state: CheckState, scope: go_types::ScopeId, node: syntax::NodeId) -> bool {
    let operand = check_expression(state, scope, node);
    if operand.type_id.value == state.world.invalid.value {
        return false
    }
    match operand.value {
        Some(value) => match constant::convert_constant(
            value,
            go_types::BasicKind::Int,
            state.config.sizes,
        ) {
            Some(converted) => {
                let contextual = Operand {
                    type_id: basic_type_id(state, "int"),
                    value: Option::Some(converted),
                    addressable: false,
                    assignable: false,
                };
                if go_types::is_untyped(state.world, operand.type_id) {
                    update_operand_fact(state, node, contextual.type_id, contextual.value)
                }
                match converted {
                    constant::ConstValue::Int(value) => if value.sign < 0 {
                        diagnostic(
                            state,
                            node,
                            "invalid argument: length " + operand_string(state, node, contextual)
                                + " must not be negative",
                            false,
                        );
                        false
                    } else {
                        true
                    },
                    _ => true,
                }
            },
            None => {
                diagnostic(
                    state,
                    node,
                    if go_types::is_numeric(state.world, operand.type_id) {
                        operand_string(state, node, operand)
                            + if go_types::is_integer(state.world, operand.type_id) {
                                " overflows int"
                            } else {
                                " truncated to int"
                            }
                    } else {
                        "cannot convert " + operand_string(state, node, operand) + " to type int"
                    },
                    false,
                );
                false
            },
        },
        None => if go_types::is_integer(state.world, operand.type_id) {
            true
        } else {
            diagnostic(
                state,
                node,
                "invalid argument: length " + operand_string(state, node, operand)
                    + " must be integer",
                false,
            );
            false
        },
    }
}

fn len_cap_classification(state: CheckState, name: string, value: go_types::TypeId) -> i64 {
    match underlying_kind(state, value) {
        Some(go_types::TypeKind::Array { length, element: _ }) => length,
        Some(go_types::TypeKind::Pointer { element }) => match underlying_kind(state, element) {
            Some(go_types::TypeKind::Array { length, element: _ }) => length,
            _ => -2,
        },
        Some(go_types::TypeKind::Slice { element: _ }) | Some(go_types::TypeKind::Chan {
            direction: _,
            element: _,
        }) => -1,
        Some(go_types::TypeKind::Map { key: _, value: _ }) => if name == LEN_BUILTIN {
            -1
        } else {
            -2
        },
        Some(go_types::TypeKind::Basic {
            basic: go_types::BasicKind::String | go_types::BasicKind::UntypedString,
            name: _,
            untyped: _,
        }) => if name == LEN_BUILTIN {
            -1
        } else {
            -2
        },
        _ => -2,
    }
}

fn expression_has_nonconstant_call_or_receive(state: CheckState, node: syntax::NodeId) -> bool {
    let Some(outer) = syntax::get_node(state.syntax.arena, node) else {
        return false;
    };
    let mut low = 0;
    let mut high = state.effect_expression_nodes.len();
    while low < high {
        let middle = low + (high - low) / 2;
        let candidate_id = state.effect_expression_nodes[middle];
        let candidate = syntax::node_at(state.syntax.arena, candidate_id.value);
        if candidate.file.value < outer.file.value
            || (candidate.file.value == outer.file.value && candidate.span.start < outer.span.start) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    let mut index = low;
    while index < state.effect_expression_nodes.len() {
        let candidate_id = state.effect_expression_nodes[index];
        let candidate = syntax::node_at(state.syntax.arena, candidate_id.value);
        if candidate.file.value != outer.file.value || candidate.span.start > outer.span.end {
            return false
        }
        if candidate.span.end <= outer.span.end {
            match candidate.kind {
                syntax::SyntaxKind::UnaryExpr { op_pos: _, op, expression: _ } => if op
                    == RECEIVE_OPERATOR {
                    return true
                },
                syntax::SyntaxKind::CallExpr {
                    function,
                    lparen: _,
                    arguments: _,
                    ellipsis: _,
                    rparen: _,
                } => {
                    let constant_call = match recorded_type_fact(state, candidate.id) {
                        Some(fact) => type_fact_has_constant(fact),
                        None => false,
                    };
                    let conversion = match recorded_type_fact(state, function) {
                        Some(fact) => fact.type_expr,
                        None => false,
                    };
                    if !constant_call && !conversion {
                        return true
                    }
                },
                _ => {},
            }
        }
        index += 1;
    }
    false
}

fn check_len_cap(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    name: string,
    arguments: Vec[syntax::NodeId],
) -> Operand {
    if !check_builtin_count(state, node, arguments.len(), 1, 1) {
        return invalid_operand(state)
    }
    let argument = check_expression(state, scope, arguments[0]);
    if !require_value(state, arguments[0]) {
        return invalid_operand(state)
    }
    if argument.type_id.value == state.world.invalid.value {
        return invalid_operand(state)
    }
    let expanded = tuple_variables(state, argument.type_id);
    if expanded.len() > 1 {
        let _ = check_builtin_count(state, node, expanded.len(), 1, 1);
        return invalid_operand(state)
    }
    let mut valid = false;
    let mut constant_length: Option[i64] = Option::None;
    match underlying_kind(state, argument.type_id) {
        Some(go_types::TypeKind::Array { length, element: _ }) => {
            valid = true;
            constant_length = Option::Some(length);
        },
        Some(go_types::TypeKind::Pointer { element }) => match underlying_kind(state, element) {
            Some(go_types::TypeKind::Array { length, element: _ }) => {
                valid = true;
                constant_length = Option::Some(length);
            },
            _ => {},
        },
        Some(go_types::TypeKind::Slice { element: _ }) | Some(go_types::TypeKind::Chan {
            direction: _,
            element: _,
        }) => {
            valid = true;
        },
        Some(go_types::TypeKind::Map { key: _, value: _ }) => if name == LEN_BUILTIN {
            valid = true;
        },
        Some(go_types::TypeKind::Basic {
            basic: go_types::BasicKind::String | go_types::BasicKind::UntypedString,
            name: _,
            untyped: _,
        }) => if name == LEN_BUILTIN {
            valid = true;
            match argument.value {
                Some(constant::ConstValue::String(value)) => {
                    constant_length = Option::Some(value.byte_len().to_i64());
                },
                _ => {},
            }
        },
        _ => {},
    }
    if !valid && go_types::is_type_parameter(state.world, argument.type_id) {
        let terms = go_types::type_set_specific_types(state.world, argument.type_id);
        if !terms.is_empty() {
            valid = true;
            for term in terms {
                let classification = len_cap_classification(state, name, term);
                if classification == -2 {
                    valid = false;
                }
            }
        }
    }
    if go_types::is_type_parameter(state.world, argument.type_id) {
        constant_length = Option::None;
    }
    if constant_length.is_some() && expression_has_nonconstant_call_or_receive(state, arguments[0]) {
        constant_length = Option::None;
    }
    if !valid {
        if core_type_id(state, argument.type_id).value == state.world.invalid.value
            && !go_types::is_type_parameter(state.world, argument.type_id) {
            return invalid_operand(state)
        }
        if state.array_length_depth > 0 && !state.active_type_objects.is_empty() {
            let object = state.active_type_objects[state.active_type_objects.len() - 1];
            if !invalid_type_object_seen(state, object) && !type_value_cycle_contains(state, object) {
                state.deferred_direct_type_cycles.push(object)
            }
            return Operand {
                type_id: basic_type_id(state, "int"),
                value: Option::Some(constant::ConstValue::Int(constant::integer_from_int64(0))),
                addressable: false,
                assignable: false,
            }
        }
        diagnostic(
            state,
            arguments[0],
            "invalid argument: " + operand_string(state, arguments[0], argument) + " for built-in "
                + name,
            false,
        );
        invalid_operand(state)
    } else {
        Operand {
            type_id: basic_type_id(state, "int"),
            value: constant_length.map(
                |value| constant::ConstValue::Int(constant::integer_from_int64(value)),
            ),
            addressable: false,
            assignable: false,
        }
    }
}

fn check_new_builtin(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    arguments: Vec[syntax::NodeId],
) -> Operand {
    if !check_builtin_count(state, node, arguments.len(), 1, 1) {
        return invalid_operand(state)
    }
    let element = match conversion_target(state, scope, arguments[0]) {
        Some(type_id) => type_id,
        None => {
            let version_allowed = go_version_at_least(state, node, 26);
            let diagnostic_start = state.diagnostics.len();
            let value = check_expression(state, scope, arguments[0]);
            if node_is_void(state, arguments[0]) {
                diagnostic(
                    state,
                    arguments[0],
                    expression_source_text(state, arguments[0])
                        + " (no value) used as value or type",
                    false,
                );
                return invalid_operand(state)
            }
            if value.type_id.value == state.world.invalid.value {
                return invalid_operand(state)
            }
            if basic_kind(state, value.type_id) == go_types::BasicKind::UntypedNil {
                diagnostic(state, arguments[0], "use of untyped nil in argument to new", false);
                return invalid_operand(state)
            }
            match underlying_kind(state, value.type_id) {
                Some(go_types::TypeKind::Tuple { variables }) => if variables.len() > 1 {
                    diagnostic(
                        state,
                        arguments[0],
                        "multiple-value " + operand_string(state, arguments[0], value)
                            + " in single-value context",
                        false,
                    );
                    return invalid_operand(state)
                },
                _ => {},
            }
            let result = default_operand_type(state, value);
            match value.value {
                Some(constant_value) => if constant::constant_kind(constant_value)
                    != constant::ConstantKind::Unknown
                    && constant::round_constant(
                        constant_value,
                        basic_kind(state, result),
                        state.config.sizes,
                    ).is_none() {
                    diagnostic(
                        state,
                        arguments[0],
                        "cannot use " + operand_string(state, arguments[0], value) + " as "
                            + diagnostic_type_string(state, result)
                            + " value in argument to new (overflows)",
                        false,
                    );
                    return invalid_operand(state)
                },
                None => {},
            }
            if go_types::is_untyped(state.world, value.type_id) {
                update_contextual_operand_fact(state, arguments[0], value, result)
            }
            if !version_allowed && state.diagnostics.len() == diagnostic_start {
                diagnostic(
                    state,
                    node,
                    "new(" + expression_source_text(state, arguments[0])
                        + ") requires go1.26 or later",
                    false,
                )
            }
            result
        },
    };
    if element.value == state.world.invalid.value {
        invalid_operand(state)
    } else {
        let checked = reject_constraint_type(
            state,
            arguments[0],
            expression_source_text(state, arguments[0]),
            element,
        );
        builtin_operand(
            go_types::add_type(
                state.world,
                go_types::TypeKind::Pointer {
                    element: if checked.value == state.world.invalid.value {
                        element
                    } else {
                        checked
                    },
                },
            ),
        )
    }
}

fn go_version_at_least(state: CheckState, node: syntax::NodeId, required_minor: isize) -> bool {
    let file = node_file(state, node);
    let mut version = state.config.go_version;
    for fact in state.info.file_versions {
        match file {
            Some(file) => if fact.file.value == file.value {
                version = fact.version;
            },
            None => {},
        }
    }
    if !version.starts_with("go1.") {
        return true
    }
    match num::parse_int_structured(version.byte_slice(4, version.byte_len())) {
        Ok(value) => value >= required_minor,
        Err(_) => true,
    }
}

fn make_type_parameter_kind(state: CheckState, value: go_types::TypeId) -> Result[
    go_types::TypeKind,
    string,
] {
    let terms = go_types::type_set_specific_types(state.world, value);
    if terms.is_empty() {
        return Result::Err("type must be slice, map, or channel")
    }
    let first_type = terms[0];
    let mut selected = underlying_kind(state, first_type).ok_or(
        "type must be slice, map, or channel",
    )?;
    match selected {
        go_types::TypeKind::Slice { element: _ } | go_types::TypeKind::Map { key: _, value: _ } | go_types::TypeKind::Chan {
            direction: _,
            element: _,
        } => {},
        _ => return Result::Err("type must be slice, map, or channel"),
    }
    for index in 1..terms.len() {
        let candidate_type = terms[index];
        let candidate = underlying_kind(state, candidate_type).ok_or(
            "type must be slice, map, or channel",
        )?;
        match (selected, candidate) {
            (
                go_types::TypeKind::Slice { element: left },
                go_types::TypeKind::Slice { element: right },
            ) => if !go_types::identical(state.world, left, right) {
                return Result::Err(
                    diagnostic_type_string(state, first_type) + " and "
                        + diagnostic_type_string(state, candidate_type)
                        + " have different underlying types",
                )
            },
            (
                go_types::TypeKind::Map { key: left_key, value: left_value },
                go_types::TypeKind::Map { key: right_key, value: right_value },
            ) => if !go_types::identical(state.world, left_key, right_key)
                || !go_types::identical(state.world, left_value, right_value) {
                return Result::Err(
                    diagnostic_type_string(state, first_type) + " and "
                        + diagnostic_type_string(state, candidate_type)
                        + " have different underlying types",
                )
            },
            (
                go_types::TypeKind::Chan { direction: left_direction, element: left_element },
                go_types::TypeKind::Chan { direction: right_direction, element: right_element },
            ) => if !go_types::identical(state.world, left_element, right_element) {
                return Result::Err(
                    "channels " + diagnostic_type_string(state, first_type) + " and "
                        + diagnostic_type_string(state, candidate_type)
                        + " have different element types",
                )
            } else if (left_direction == 1 && right_direction == 2)
                || (left_direction == 2 && right_direction == 1) {
                return Result::Err(
                    "channels " + diagnostic_type_string(state, first_type) + " and "
                        + diagnostic_type_string(state, candidate_type)
                        + " have conflicting directions",
                )
            } else {
                selected = go_types::TypeKind::Chan {
                    direction: if left_direction == 3 {
                        right_direction
                    } else {
                        left_direction
                    },
                    element: left_element,
                };
            },
            (
                go_types::TypeKind::Slice { element: _ } | go_types::TypeKind::Map {
                    key: _,
                    value: _,
                } | go_types::TypeKind::Chan { direction: _, element: _ },
                go_types::TypeKind::Slice { element: _ } | go_types::TypeKind::Map {
                    key: _,
                    value: _,
                } | go_types::TypeKind::Chan { direction: _, element: _ },
            ) => return Result::Err(
                diagnostic_type_string(state, first_type) + " and "
                    + diagnostic_type_string(state, candidate_type)
                    + " have different underlying types",
            ),
            _ => return Result::Err("type must be slice, map, or channel"),
        }
    }
    Result::Ok(selected)
}

fn check_make_builtin(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    arguments: Vec[syntax::NodeId],
) -> Operand {
    if arguments.is_empty() {
        let _ = check_builtin_count(state, node, arguments.len(), 1, -1);
        return invalid_operand(state)
    }
    let target = match conversion_target(state, scope, arguments[0]) {
        Some(value) => value,
        None => {
            let _ = check_expression(state, scope, arguments[0]);
            match syntax::get_kind(state.syntax.arena, arguments[0]) {
                Some(syntax::SyntaxKind::CallExpr {
                    function: _,
                    lparen: _,
                    arguments: _,
                    ellipsis: _,
                    rparen: _,
                }) => record_invalid_type_expression(state, arguments[0]),
                _ => {},
            }
            diagnostic(
                state,
                arguments[0],
                expression_source_text(state, arguments[0]) + " is not a type",
                false,
            );
            return invalid_operand(state)
        },
    };
    let make_kind = if go_types::is_type_parameter(state.world, target) {
        match make_type_parameter_kind(state, target) {
            Ok(kind) => Option::Some(kind),
            Err(message) => {
                diagnostic(
                    state,
                    arguments[0],
                    "invalid argument: cannot make " + diagnostic_type_string(state, target) + ": "
                        + message,
                    false,
                );
                return invalid_operand(state)
            },
        }
    } else {
        underlying_kind(state, target)
    };
    let (minimum, maximum) = match make_kind {
        Some(go_types::TypeKind::Slice { element: _ }) => (2, 3),
        Some(go_types::TypeKind::Map { key: _, value: _ }) | Some(go_types::TypeKind::Chan {
            direction: _,
            element: _,
        }) => (1, 2),
        _ => {
            diagnostic(
                state,
                arguments[0],
                "invalid argument: cannot make " + diagnostic_type_string(state, target)
                    + ": type must be slice, map, or channel",
                false,
            );
            return invalid_operand(state)
        },
    };
    if arguments.len() < minimum || arguments.len() > maximum {
        diagnostic(
            state,
            node,
            "invalid operation: " + expression_source_text(state, node)
                + f" expects {minimum} or {maximum} arguments; found {arguments.len()}",
            false,
        );
        return invalid_operand(state)
    }
    let indices: Vec[Operand] = Vec::new();
    let mut valid = true;
    for index in 1..arguments.len() {
        let operand = check_expression(state, scope, arguments[index]);
        if operand.type_id.value == state.world.invalid.value {
            valid = false;
            let _ = state.invalid_builtin_parameter_nodes.insert(arguments[index].value);
        } else {
            match operand.value {
                Some(value) => match constant::convert_constant(
                    value,
                    go_types::BasicKind::Int,
                    state.config.sizes,
                ) {
                    Some(converted) => {
                        let converted_operand = Operand {
                            type_id: basic_type_id(state, "int"),
                            value: Option::Some(converted),
                            addressable: false,
                            assignable: false,
                        };
                        if go_types::is_untyped(state.world, operand.type_id) {
                            update_operand_fact(
                                state,
                                arguments[index],
                                converted_operand.type_id,
                                converted_operand.value,
                            )
                        }
                        match converted {
                            constant::ConstValue::Int(value) => if value.sign < 0 {
                                diagnostic(
                                    state,
                                    arguments[index],
                                    "invalid argument: index "
                                        + operand_string(state, arguments[index], converted_operand)
                                        + " must not be negative",
                                    false,
                                );
                                valid = false;
                                let _ = state.invalid_builtin_parameter_nodes.insert(
                                    arguments[index].value,
                                );
                            },
                            _ => {},
                        }
                        indices.push(converted_operand)
                    },
                    None => {
                        if go_types::is_numeric(state.world, operand.type_id) {
                            diagnostic(
                                state,
                                arguments[index],
                                operand_string(state, arguments[index], operand)
                                    + if go_types::is_integer(state.world, operand.type_id) {
                                        " overflows int"
                                    } else {
                                        " truncated to int"
                                    },
                                false,
                            )
                        } else {
                            diagnostic(
                                state,
                                arguments[index],
                                "cannot convert " + operand_string(state, arguments[index], operand)
                                    + " to type int",
                                false,
                            )
                        }
                        valid = false;
                        let _ = state.invalid_builtin_parameter_nodes.insert(arguments[index].value);
                    },
                },
                None => if go_types::is_untyped(state.world, operand.type_id)
                    && go_types::is_numeric(state.world, operand.type_id) {
                    let contextual = Operand {
                        type_id: basic_type_id(state, "int"),
                        value: Option::None,
                        addressable: false,
                        assignable: false,
                    };
                    let diagnostic_count = state.diagnostics.len();
                    update_contextual_operand_fact(
                        state,
                        arguments[index],
                        operand,
                        contextual.type_id,
                    );
                    if state.diagnostics.len() > diagnostic_count {
                        valid = false;
                    } else {
                        indices.push(contextual)
                    }
                } else if !go_types::is_integer(state.world, operand.type_id) {
                    diagnostic(
                        state,
                        arguments[index],
                        "invalid argument: index "
                            + operand_string(state, arguments[index], operand)
                            + " must be integer",
                        false,
                    );
                    valid = false;
                    let _ = state.invalid_builtin_parameter_nodes.insert(arguments[index].value);
                } else {
                    indices.push(operand)
                },
            }
        }
    }
    if valid && indices.len() == 2 {
        match (indices[0].value, indices[1].value) {
            (Some(left), Some(right)) => match constant::constant_compare(left, right) {
                Some(compared) => if compared > 0 {
                    diagnostic(
                        state,
                        arguments[1],
                        "invalid argument: length and capacity swapped",
                        false,
                    );
                    valid = false;
                },
                None => {},
            },
            _ => {},
        }
    }
    builtin_operand(target)
}

fn expression_is_shift(state: CheckState, node: syntax::NodeId) -> bool {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::BinaryExpr { left: _, op_pos: _, op, right: _ }) => shift_operator(
            op,
        ),
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => expression_is_shift(
            state,
            expression,
        ),
        _ => false,
    }
}

fn slice_element_type(state: CheckState, value: go_types::TypeId) -> Option[go_types::TypeId] {
    match underlying_kind(state, value) {
        Some(go_types::TypeKind::Slice { element }) => Option::Some(element),
        _ => Option::None,
    }
}

fn mismatched_slice_element_types(state: CheckState, value: go_types::TypeId) -> Option[
    (go_types::TypeId, go_types::TypeId),
] {
    if !go_types::is_type_parameter(state.world, value) {
        return Option::None
    }
    let terms = go_types::type_set_specific_types(state.world, value);
    let mut first: Option[go_types::TypeId] = Option::None;
    for term in terms {
        let Some(element) = slice_element_type(state, term) else {
            return Option::None;
        };
        match first {
            Some(first) => if !go_types::identical(state.world, first, element) {
                return Option::Some((first, element))
            },
            None => {
                first = Option::Some(element);
            },
        }
    }
    Option::None
}

fn copy_element_type(state: CheckState, value: go_types::TypeId, allow_string: bool) -> Option[
    go_types::TypeId,
] {
    let terms = if go_types::is_type_parameter(state.world, value) {
        go_types::type_set_specific_types(state.world, value)
    } else {
        Vec::from_array([value])
    };
    if terms.is_empty() {
        return Option::None
    }
    let mut result: Option[go_types::TypeId] = Option::None;
    for term in terms {
        let element = match slice_element_type(state, term) {
            Some(element) => element,
            None => if allow_string && is_string_type(state, term) {
                basic_type_id(state, "byte")
            } else {
                return Option::None
            },
        };
        match result {
            Some(previous) => if !go_types::identical(state.world, previous, element) {
                return Option::None
            },
            None => {
                result = Option::Some(element);
            },
        }
    }
    result
}

fn append_byte_sequence_type(state: CheckState, value: go_types::TypeId) -> bool {
    if is_string_type(state, value) {
        return true
    }
    let candidates = go_types::type_set_specific_types(state.world, value);
    if candidates.is_empty() {
        return false
    }
    for candidate in candidates {
        if is_string_type(state, candidate) {} else {
            match slice_element_type(state, candidate) {
                Some(element) => if basic_kind(state, element) != go_types::BasicKind::Uint8 {
                    return false
                },
                None => return false,
            }
        }
    }
    true
}

fn diagnostic_type_string(state: CheckState, value: go_types::TypeId) -> string {
    let rendered = go_types::format_type(state.world, value);
    let package_prefix = state.world.packages[state.package_id.value].path + ".";
    rendered = text::replace(rendered, package_prefix, "");
    for binding in state.imports {
        match go_types::get_object(state.world, binding.object) {
            Some(object) => match object.imported_package {
                Some(package_id) => match go_types::get_package(state.world, package_id) {
                    Some(package_data) => {
                        let mut ambiguous = false;
                        for other_binding in state.imports {
                            match go_types::get_object(state.world, other_binding.object) {
                                Some(other_object) => match other_object.imported_package {
                                    Some(other_id) => if other_id.value != package_id.value {
                                        match go_types::get_package(state.world, other_id) {
                                            Some(other_package) => if other_package.name
                                                == package_data.name {
                                                ambiguous = true;
                                            },
                                            None => {},
                                        }
                                    },
                                    None => {},
                                },
                                None => {},
                            }
                        }
                        if !ambiguous {
                            rendered = text::replace(
                                rendered,
                                package_data.path + ".",
                                package_data.name + ".",
                            );
                        } else {
                            rendered = text::replace(
                                rendered,
                                package_data.path + ".",
                                "\"" + package_data.path + "\".",
                            );
                        }
                    },
                    None => {},
                },
                None => {},
            },
            None => {},
        }
    }
    rendered
}

fn operand_type_kind(state: CheckState, value: go_types::TypeId) -> string {
    match go_types::get_type(state.world, go_types::underlying(state.world, value)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Basic { basic: _, name, untyped: _ },
        }) => name,
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Array { length: _, element: _ } }) => "array",
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Slice { element: _ } }) => "slice",
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Struct { fields: _ } }) => "struct",
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element: _ } }) => "pointer",
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: _,
                receiver_type_params: _,
                type_params: _,
                params: _,
                results: _,
                variadic: _,
            },
        }) => "func",
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Interface {
                methods: _,
                embeddeds: _,
                comparable: _,
                implicit: _,
            },
        }) => "interface",
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Map { key: _, value: _ } }) => "map",
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Chan { direction: _, element: _ },
        }) => "chan",
        _ => "",
    }
}

fn operand_type_description(state: CheckState, value: go_types::TypeId) -> string {
    let alias = match go_types::get_type(state.world, value) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Alias { object: _, rhs: _, type_params: _, type_args: _ },
        }) => true,
        _ => false,
    };
    match go_types::get_type(state.world, go_types::unalias(state.world, value)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::TypeParam { object: _, constraint, index: _ },
        }) => "type " + diagnostic_type_string(state, value) + " constrained by "
            + diagnostic_type_string(state, constraint)
            + if go_types::type_set_is_empty(state.world, constraint) {
                " with empty type set"
            } else {
                ""
            },
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object: _,
                underlying,
                type_params: _,
                type_args: _,
                methods: _,
            },
        }) => {
            let _ = underlying;
            let kind = operand_type_kind(state, value);
            if kind == "" {
                "type " + diagnostic_type_string(state, value)
            } else {
                kind + " type " + diagnostic_type_string(state, value)
            }
        },
        _ => if alias {
            let kind = operand_type_kind(state, value);
            if kind == "" {
                "type " + diagnostic_type_string(state, value)
            } else {
                kind + " type " + diagnostic_type_string(state, value)
            }
        } else {
            "type " + diagnostic_type_string(state, value)
        },
    }
}

fn diagnostic_constant_string(state: CheckState, node: syntax::NodeId, value: constant::ConstValue) -> string {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::BasicLit {
            value_pos: _,
            value_end: _,
            token: literal_token,
            value: literal,
        }) => {
            let exact = constant::constant_exact_string(value);
            if literal_token == FLOAT_LITERAL_TOKEN && exact.byte_len() > 128 {
                for index in 0..literal.byte_len() {
                    let byte = literal.byte_get(index);
                    if byte == b'e' || byte == b'E' || byte == b'p' || byte == b'P' {
                        if index + 1 < literal.byte_len() && literal.byte_get(index + 1) != b'+'
                            && literal.byte_get(index + 1) != b'-' {
                            return literal.byte_slice(0, index + 1) + "+"
                                + literal.byte_slice(index + 1, literal.byte_len())
                        } else {
                            return literal
                        }
                    }
                }
            }
            return if literal_token != IMAG_LITERAL_TOKEN && exact.contains("/") {
                expression_source_text(state, node)
            } else {
                exact
            }
        },
        Some(syntax::SyntaxKind::CallExpr { function, lparen: _, arguments, ellipsis: _, rparen: _ }) => if identifier(
            state,
            function,
        ).unwrap_or("")
            == COMPLEX_BUILTIN
            && arguments.len() == 2 {
            let real = expression_source_text(state, arguments[0]);
            let imaginary = expression_source_text(state, arguments[1]);
            if imaginary.starts_with("-") {
                return "(" + real + " - " + imaginary.byte_slice(1, imaginary.byte_len()) + "i)"
            } else {
                return "(" + real + " + " + imaginary + "i)"
            }
        } else if identifier(state, function).unwrap_or("") == MIN_BUILTIN
            || identifier(state, function).unwrap_or("") == MAX_BUILTIN {
            let exact = constant::constant_exact_string(value);
            for argument in arguments {
                match recorded_type_fact(state, argument) {
                    Some(fact) => match type_fact_constant(fact) {
                        Some(candidate) => if candidate == exact {
                            return expression_source_text(state, argument)
                        },
                        None => {},
                    },
                    None => {},
                }
            }
        },
        _ => {},
    }
    constant::constant_string(value)
}

fn operand_string(state: CheckState, node: syntax::NodeId, operand: Operand) -> string {
    let expression = expression_source_text(state, node);
    if basic_kind(state, operand.type_id) == go_types::BasicKind::UntypedNil {
        return "nil"
    }
    match operand.value {
        Some(value) => {
            let exact = diagnostic_constant_string(state, node, value);
            let detail = if go_types::is_untyped(state.world, operand.type_id) {
                go_types::format_type(state.world, operand.type_id) + " constant"
            } else {
                "constant"
            };
            if exact != expression {
                detail += " " + exact;
            }
            if !go_types::is_untyped(state.world, operand.type_id) {
                detail += " of " + operand_type_description(state, operand.type_id);
            }
            expression + " (" + detail + ")"
        },
        None => {
            let map_index = match syntax::get_kind(state.syntax.arena, node) {
                Some(syntax::SyntaxKind::IndexExpr { expression, lbrack: _, index: _, rbrack: _ }) => match recorded_type_fact(
                    state,
                    expression,
                ) {
                    Some(fact) => match go_types::get_type(
                        state.world,
                        go_types::underlying(state.world, fact.type_id),
                    ) {
                        Some(go_types::TypeData {
                            id: _,
                            kind: go_types::TypeKind::Map { key: _, value: _ },
                        }) => true,
                        _ => match indexed_type(state, fact.type_id) {
                            Some((_, _, _, Some(_))) => true,
                            _ => false,
                        },
                    },
                    None => false,
                },
                _ => false,
            };
            let mode = if map_index {
                "map index expression"
            } else if operand.addressable {
                "variable"
            } else {
                "value"
            };
            if go_types::is_untyped(state.world, operand.type_id) {
                expression + " (" + go_types::format_type(state.world, operand.type_id) + " " + mode
                    + ")"
            } else {
                expression + " (" + mode + " of " + operand_type_description(state, operand.type_id)
                    + ")"
            }
        },
    }
}

fn require_value(state: CheckState, node: syntax::NodeId) -> bool {
    if node_is_void(state, node) {
        diagnostic(
            state,
            node,
            expression_source_text(state, node) + " (no value) used as value",
            false,
        );
        false
    } else {
        true
    }
}

fn call_argument_type_string(state: CheckState, operand: Operand) -> string {
    match basic_kind(state, operand.type_id) {
        go_types::BasicKind::UntypedInt | go_types::BasicKind::UntypedRune | go_types::BasicKind::UntypedFloat | go_types::BasicKind::UntypedComplex => "number",
        go_types::BasicKind::UntypedBool => "bool",
        go_types::BasicKind::UntypedString => "string",
        _ => diagnostic_type_string(state, operand.type_id),
    }
}

fn check_append_builtin(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    arguments: Vec[syntax::NodeId],
    ellipsis: isize,
) -> Operand {
    if !check_builtin_count(state, node, arguments.len(), 1, -1) {
        return invalid_operand(state)
    }
    if arguments.len() == 1 && ellipsis >= 0 {
        let value = check_expression(state, scope, arguments[0]);
        let values = tuple_variables(state, value.type_id);
        if values.len() > 1 {
            diagnostic_at_position(
                state,
                node,
                ellipsis,
                f"cannot use ... with {values.len()}-valued "
                    + expression_source_text(state, arguments[0]),
                false,
            );
            return builtin_operand(values[0].type_id)
        }
    }
    let mut slice = check_expression(state, scope, arguments[0]);
    if !require_value(state, arguments[0]) {
        return invalid_operand(state)
    }
    if slice.type_id.value == state.world.invalid.value {
        for index in 1..arguments.len() {
            let _ = check_expression(state, scope, arguments[index]);
        }
        return invalid_operand(state)
    }
    let expanded_values: Vec[Operand] = Vec::new();
    let mut valid_result = true;
    if arguments.len() == 1 && ellipsis < 0 {
        let values = tuple_variables(state, slice.type_id);
        if values.len() > 1 {
            slice = builtin_operand(values[0].type_id);
            for index in 1..values.len() {
                expanded_values.push(builtin_operand(values[index].type_id))
            }
        }
    }
    let element = match slice_element_type(state, slice.type_id) {
        Some(value) => value,
        None => {
            let description = if basic_kind(state, slice.type_id) == go_types::BasicKind::UntypedNil {
                "untyped nil"
            } else {
                operand_string(state, arguments[0], slice)
            };
            match mismatched_slice_element_types(state, slice.type_id) {
                Some((left, right)) => diagnostic(
                    state,
                    arguments[0],
                    "invalid append: mismatched slice element types "
                        + diagnostic_type_string(state, left)
                        + " and "
                        + diagnostic_type_string(state, right)
                        + " in "
                        + description,
                    false,
                ),
                None => diagnostic(
                    state,
                    arguments[0],
                    "invalid append: argument must be a slice; have " + description,
                    false,
                ),
            }
            for index in 1..arguments.len() {
                let _ = check_expression(state, scope, arguments[index]);
            }
            return invalid_operand(state)
        },
    };
    if ellipsis >= 0 {
        if arguments.len() < 2 {
            let rparen = match syntax::get_kind(state.syntax.arena, node) {
                Some(syntax::SyntaxKind::CallExpr {
                    function: _,
                    lparen: _,
                    arguments: _,
                    ellipsis: _,
                    rparen,
                }) => rparen,
                _ => -1,
            };
            diagnostic_at_position(
                state,
                node,
                rparen,
                "not enough arguments in call to append\n\thave ("
                    + go_types::format_type(state.world, slice.type_id)
                    + "...)\n\twant ("
                    + go_types::format_type(state.world, slice.type_id)
                    + ", ..."
                    + go_types::format_type(state.world, element)
                    + ")",
                false,
            )
        } else if arguments.len() != 2 {
            let have = "(" + go_types::format_type(state.world, slice.type_id);
            for index in 1..arguments.len() {
                let value = check_expression(state, scope, arguments[index]);
                have += ", " + call_argument_type_string(state, value);
                if index == arguments.len() - 1 {
                    have += "...";
                }
            }
            have += ")";
            diagnostic(
                state,
                arguments[2],
                "too many arguments in call to append\n\thave " + have + "\n\twant ("
                    + go_types::format_type(state.world, slice.type_id)
                    + ", ..."
                    + go_types::format_type(state.world, element)
                    + ")",
                false,
            )
        } else {
            let source = check_expression(state, scope, arguments[1]);
            if tuple_arity(state, source.type_id) > 1 {
                diagnostic(
                    state,
                    arguments[1],
                    "multiple-value " + expression_source_text(state, arguments[1])
                        + " (value of type "
                        + diagnostic_type_string(state, source.type_id)
                        + ") in single-value context",
                    false,
                );
                valid_result = false;
            } else {
                match slice_element_type(state, source.type_id) {
                    Some(source_element) => if !go_types::identical(
                        state.world,
                        source_element,
                        element,
                    ) {
                        diagnostic(state, arguments[1], "append slice element types differ", false)
                    },
                    None => if basic_kind(state, source.type_id) == go_types::BasicKind::UntypedNil {} else if go_types::identical(
                        state.world,
                        element,
                        basic_type_id(state, "byte"),
                    )
                        && append_byte_sequence_type(state, source.type_id) {} else if go_types::is_type_parameter(
                        state.world,
                        source.type_id,
                    ) {
                        diagnostic(
                            state,
                            arguments[1],
                            "cannot use " + operand_string(state, arguments[1], source) + " as "
                                + diagnostic_type_string(state, slice.type_id)
                                + " value in argument to append",
                            false,
                        )
                    } else {
                        diagnostic(
                            state,
                            arguments[1],
                            "append ... argument must be a slice",
                            false,
                        )
                    },
                }
            }
        }
    } else {
        for value in expanded_values {
            if !argument_assignable(state, value, element) {
                diagnostic(
                    state,
                    arguments[0],
                    "cannot use " + operand_string(state, arguments[0], value) + " as "
                        + diagnostic_type_string(state, element)
                        + " value in argument to append",
                    false,
                )
            }
        }
        for index in 1..arguments.len() {
            let diagnostic_count = state.diagnostics.len();
            let previous_target_inference_context = state.target_inference_context.get();
            let previous_target_inference_call = state.target_inference_call.get();
            state.target_inference_context.set(1);
            state.target_inference_call.set(APPEND_BUILTIN);
            let value = expression_with_target(state, scope, arguments[index], element);
            state.target_inference_context.set(previous_target_inference_context);
            state.target_inference_call.set(previous_target_inference_call);
            update_contextual_operand_fact(state, arguments[index], value, element);
            if tuple_arity(state, value.type_id) > 1 {
                diagnostic(
                    state,
                    arguments[index],
                    "multiple-value " + expression_source_text(state, arguments[index])
                        + " (value of type "
                        + diagnostic_type_string(state, value.type_id)
                        + ") in single-value context",
                    false,
                );
                valid_result = false;
            } else if state.diagnostics.len() > diagnostic_count {
                valid_result = false;
            } else if !argument_assignable(state, value, element) {
                diagnostic(
                    state,
                    arguments[index],
                    "cannot use " + operand_string(state, arguments[index], value) + " as "
                        + go_types::format_type(state.world, element)
                        + " value in argument to append",
                    false,
                )
            }
        }
    }
    if valid_result {
        builtin_operand(slice.type_id)
    } else {
        invalid_operand(state)
    }
}

fn check_delete_builtin(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    arguments: Vec[syntax::NodeId],
) -> Operand {
    if arguments.is_empty() || arguments.len() > 2 {
        let _ = check_builtin_count(state, node, arguments.len(), 2, 2);
        return invalid_operand(state)
    }
    let map_node = arguments[0];
    let key_node = if arguments.len() == 2 {
        arguments[1]
    } else {
        arguments[0]
    };
    let (map, key_value) = if arguments.len() == 1 {
        let value = check_expression(state, scope, arguments[0]);
        if !require_value(state, arguments[0]) {
            return invalid_operand(state)
        }
        let expanded = tuple_variables(state, value.type_id);
        if expanded.len() != 2 {
            let actual = if expanded.is_empty() {
                1
            } else {
                expanded.len()
            };
            let _ = check_builtin_count(state, node, actual, 2, 2);
            return invalid_operand(state)
        };
        (builtin_operand(expanded[0].type_id), builtin_operand(expanded[1].type_id))
    } else {
        (check_expression(state, scope, arguments[0]), check_expression(state, scope, arguments[1]))
    };
    let terms = if go_types::is_type_parameter(state.world, map.type_id) {
        go_types::type_set_specific_types(state.world, map.type_id)
    } else {
        Vec::from_array([map.type_id])
    };
    let mut all_maps = !terms.is_empty();
    let mut identical_keys = true;
    let mut valid = true;
    let mut key_type: Option[go_types::TypeId] = Option::None;
    for term in terms {
        match underlying_kind(state, term) {
            Some(go_types::TypeKind::Map { key, value: _ }) => match key_type {
                Some(previous) => if !go_types::identical(state.world, previous, key) {
                    identical_keys = false;
                },
                None => {
                    key_type = Option::Some(key);
                },
            },
            _ => {
                all_maps = false;
            },
        }
    }
    if !all_maps {
        valid = false;
        diagnostic(
            state,
            map_node,
            "invalid argument: " + operand_string(state, map_node, map) + " is not a map",
            false,
        )
    } else if !identical_keys {
        valid = false;
        diagnostic(
            state,
            map_node,
            "invalid argument: maps of " + operand_string(state, map_node, map)
                + " must have identical key types",
            false,
        )
    } else {
        match key_type {
            Some(key) => {
                let adjusted_key = if key_value.value.is_none()
                    && go_types::is_untyped(state.world, key_value.type_id)
                    && go_types::is_integer(state.world, key)
                    && match syntax::get_kind(state.syntax.arena, key_node) {
                        Some(syntax::SyntaxKind::BinaryExpr { left: _, op_pos: _, op, right: _ }) => shift_operator(
                            op,
                        ),
                        _ => false,
                    } {
                    contextualize_untyped_expression(state, key_node, key, true);
                    Operand {
                        type_id: key,
                        value: Option::None,
                        addressable: key_value.addressable,
                        assignable: key_value.assignable,
                    }
                } else {
                    key_value
                };
                if !argument_assignable(state, adjusted_key, key) {
                    valid = false;
                    diagnostic(
                        state,
                        key_node,
                        "cannot use " + operand_string(state, key_node, adjusted_key) + " as "
                            + diagnostic_type_string(state, key)
                            + " value in argument to delete",
                        false,
                    )
                } else {
                    update_contextual_operand_fact(state, key_node, key_value, key)
                }
            },
            None => {},
        }
    }
    if valid {
        void_operand(state, node)
    } else {
        invalid_operand(state)
    }
}

fn check_clear_builtin(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    arguments: Vec[syntax::NodeId],
) -> Operand {
    if !go_version_at_least(state, node, 21) {
        diagnostic(state, node, "clear requires go1.21 or later", false)
    }
    if !check_builtin_count(state, node, arguments.len(), 1, 1) {
        return invalid_operand(state)
    }
    let value = check_expression(state, scope, arguments[0]);
    if !require_value(state, arguments[0]) {
        return invalid_operand(state)
    }
    let expanded = tuple_variables(state, value.type_id);
    if expanded.len() > 1 {
        let _ = check_builtin_count(state, node, expanded.len(), 1, 1);
        return invalid_operand(state)
    }
    let mut valid = match underlying_kind(state, value.type_id) {
        Some(go_types::TypeKind::Map { key: _, value: _ }) | Some(go_types::TypeKind::Slice {
            element: _,
        }) => true,
        _ => false,
    };
    if go_types::is_type_parameter(state.world, value.type_id) {
        let terms = go_types::type_set_specific_types(state.world, value.type_id);
        valid = !terms.is_empty();
        for term in terms {
            match underlying_kind(state, term) {
                Some(go_types::TypeKind::Map { key: _, value: _ }) | Some(go_types::TypeKind::Slice {
                    element: _,
                },) => {},
                _ => {
                    valid = false;
                },
            }
        }
    }
    if !valid {
        diagnostic(
            state,
            arguments[0],
            "invalid argument: cannot clear " + operand_string(state, arguments[0], value)
                + ": argument must be (or constrained by) map or slice",
            false,
        );
        invalid_operand(state)
    } else {
        void_operand(state, node)
    }
}

fn check_close_builtin(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    arguments: Vec[syntax::NodeId],
) -> Operand {
    if !check_builtin_count(state, node, arguments.len(), 1, 1) {
        return invalid_operand(state)
    }
    let value = check_expression(state, scope, arguments[0]);
    if !require_value(state, arguments[0]) {
        return invalid_operand(state)
    }
    let expanded = tuple_variables(state, value.type_id);
    if expanded.len() > 1 {
        let _ = check_builtin_count(state, node, expanded.len(), 1, 1);
        return invalid_operand(state)
    }
    let mut non_channel = false;
    let mut receive_only = false;
    let terms = if go_types::is_type_parameter(state.world, value.type_id) {
        go_types::type_set_specific_types(state.world, value.type_id)
    } else {
        Vec::from_array([value.type_id])
    };
    if terms.is_empty() {
        non_channel = true;
    }
    for term in terms {
        match underlying_kind(state, term) {
            Some(go_types::TypeKind::Chan { direction, element: _ }) => if direction == 2 {
                receive_only = true;
            },
            _ => {
                non_channel = true;
            },
        }
    }
    if non_channel {
        diagnostic(
            state,
            arguments[0],
            "invalid operation: cannot close non-channel "
                + operand_string(state, arguments[0], value),
            false,
        );
        invalid_operand(state)
    } else if receive_only {
        diagnostic(
            state,
            arguments[0],
            "invalid operation: cannot close receive-only channel "
                + operand_string(state, arguments[0], value),
            false,
        );
        invalid_operand(state)
    } else {
        void_operand(state, node)
    }
}

fn check_copy_builtin(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    arguments: Vec[syntax::NodeId],
) -> Operand {
    if arguments.is_empty() || arguments.len() > 2 {
        let _ = check_builtin_count(state, node, arguments.len(), 2, 2);
        return invalid_operand(state)
    }
    let target_node = arguments[0];
    let source_node = if arguments.len() == 2 {
        arguments[1]
    } else {
        arguments[0]
    };
    let (target, source) = if arguments.len() == 1 {
        let value = check_expression(state, scope, arguments[0]);
        if !require_value(state, arguments[0]) {
            return invalid_operand(state)
        }
        let expanded = tuple_variables(state, value.type_id);
        if expanded.len() != 2 {
            let actual = if expanded.is_empty() {
                1
            } else {
                expanded.len()
            };
            let _ = check_builtin_count(state, node, actual, 2, 2);
            return invalid_operand(state)
        };
        (builtin_operand(expanded[0].type_id), builtin_operand(expanded[1].type_id))
    } else {
        (check_expression(state, scope, arguments[0]), check_expression(state, scope, arguments[1]))
    };
    match copy_element_type(state, target.type_id, false) {
        Some(target_element) => match copy_element_type(state, source.type_id, true) {
            Some(source_element) => if !go_types::identical(
                state.world,
                target_element,
                source_element,
            ) {
                diagnostic(
                    state,
                    target_node,
                    "invalid copy: arguments " + operand_string(state, target_node, target)
                        + " and "
                        + operand_string(state, source_node, source)
                        + " have different element types "
                        + diagnostic_type_string(state, target_element)
                        + " and "
                        + diagnostic_type_string(state, source_element),
                    false,
                );
                return invalid_operand(state)
            },
            None => if is_string_type(state, source.type_id) {
                if basic_kind(state, target_element) != go_types::BasicKind::Uint8 {
                    diagnostic(
                        state,
                        target_node,
                        "invalid copy: arguments " + operand_string(state, target_node, target)
                            + " and "
                            + operand_string(state, source_node, source)
                            + " have different element types "
                            + diagnostic_type_string(state, target_element)
                            + " and byte",
                        false,
                    );
                    return invalid_operand(state)
                }
            } else {
                let description = if basic_kind(state, source.type_id)
                    == go_types::BasicKind::UntypedNil {
                    "untyped nil"
                } else {
                    operand_string(state, source_node, source)
                };
                diagnostic(
                    state,
                    source_node,
                    "invalid copy: argument must be a slice; have " + description,
                    false,
                );
                return invalid_operand(state)
            },
        },
        None => {
            let description = if basic_kind(state, target.type_id)
                == go_types::BasicKind::UntypedNil {
                "untyped nil"
            } else {
                operand_string(state, target_node, target)
            };
            diagnostic(
                state,
                target_node,
                "invalid copy: argument must be a slice; have " + description,
                false,
            );
            return invalid_operand(state)
        },
    }
    builtin_operand(basic_type_id(state, "int"))
}

fn untyped_float_argument(state: CheckState, value: Operand) -> bool {
    match basic_kind(state, value.type_id) {
        go_types::BasicKind::UntypedInt | go_types::BasicKind::UntypedRune | go_types::BasicKind::UntypedFloat => true,
        go_types::BasicKind::UntypedComplex => match value.value {
            Some(value) => constant::constant_to_rational(value).is_some(),
            None => false,
        },
        _ => false,
    }
}

fn typed_float_kind(state: CheckState, value: Operand) -> Option[go_types::BasicKind] {
    match basic_kind(state, value.type_id) {
        go_types::BasicKind::Float32 => Option::Some(go_types::BasicKind::Float32),
        go_types::BasicKind::Float64 => Option::Some(go_types::BasicKind::Float64),
        _ => Option::None,
    }
}

fn complex_argument_type_name(state: CheckState, value: Operand) -> string {
    if untyped_float_argument(state, value) {
        "untyped float"
    } else {
        diagnostic_type_string(state, value.type_id)
    }
}

fn complex_common_type(state: CheckState, left: Operand, right: Operand) -> Option[go_types::TypeId] {
    if go_types::identical(state.world, left.type_id, right.type_id) {
        Option::Some(left.type_id)
    } else if untyped_float_argument(state, left)
        && !go_types::is_untyped(state.world, right.type_id)
        && go_types::is_numeric(state.world, right.type_id) {
        Option::Some(right.type_id)
    } else if untyped_float_argument(state, right)
        && !go_types::is_untyped(state.world, left.type_id)
        && go_types::is_numeric(state.world, left.type_id) {
        Option::Some(left.type_id)
    } else if untyped_float_argument(state, left) && untyped_float_argument(state, right) {
        Option::Some(basic_type_id(state, "untyped float"))
    } else {
        Option::None
    }
}

fn report_unsupported_type_parameter_builtin(
    state: CheckState,
    node: syntax::NodeId,
    operand: Operand,
    name: string,
) -> () {
    diagnostic(
        state,
        node,
        operand_string(state, node, operand) + " not supported as argument to built-in " + name
            + " for go1.18 (see go.dev/issue/50937)",
        true,
    )
}

fn synthetic_builtin_type_parameter(state: CheckState, source: go_types::TypeId) -> go_types::TypeId {
    let parameter = match go_types::get_type(state.world, go_types::unalias(state.world, source)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::TypeParam { object, constraint, index },
        }) => (object, constraint, index),
        _ => return source,
    };
    let object = match go_types::get_object(state.world, parameter.0) {
        Some(source_object) => go_types::add_object(
            state.world,
            go_types::ObjectKind::TypeName,
            source_object.name,
            source_object.owner,
            Option::None,
            Option::None,
            -1,
            state.world.invalid,
        ),
        None => return source,
    };
    let result = go_types::add_type(
        state.world,
        go_types::TypeKind::TypeParam { object, constraint: parameter.1, index: parameter.2 },
    );
    let _ = go_types::set_object_type(state.world, object, result);
    result
}

fn check_complex_builtin(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    arguments: Vec[syntax::NodeId],
) -> Operand {
    if arguments.is_empty() || arguments.len() > 2 {
        let _ = check_builtin_count(state, node, arguments.len(), 2, 2);
        return invalid_operand(state)
    }
    let real_node = arguments[0];
    let imaginary_node = if arguments.len() == 2 {
        arguments[1]
    } else {
        arguments[0]
    };
    let (real, imaginary) = if arguments.len() == 1 {
        let value = check_expression(state, scope, arguments[0]);
        if !require_value(state, arguments[0]) {
            return invalid_operand(state)
        }
        let expanded = tuple_variables(state, value.type_id);
        if expanded.len() != 2 {
            let actual = if expanded.is_empty() {
                1
            } else {
                expanded.len()
            };
            let _ = check_builtin_count(state, node, actual, 2, 2);
            return invalid_operand(state)
        };
        (builtin_operand(expanded[0].type_id), builtin_operand(expanded[1].type_id))
    } else {
        (check_expression(state, scope, arguments[0]), check_expression(state, scope, arguments[1]))
    };
    if real.type_id.value == state.world.invalid.value
        || imaginary.type_id.value == state.world.invalid.value {
        return invalid_operand(state)
    }
    let common = match complex_common_type(state, real, imaginary) {
        Some(value) => value,
        None => {
            diagnostic(
                state,
                real_node,
                "invalid operation: " + expression_source_text(state, node) + " (mismatched types "
                    + complex_argument_type_name(state, real)
                    + " and "
                    + complex_argument_type_name(state, imaginary)
                    + ")",
                false,
            );
            return invalid_operand(state)
        },
    };
    if go_types::is_type_parameter(state.world, common) {
        update_contextual_operand_fact(state, real_node, real, common);
        update_contextual_operand_fact(state, imaginary_node, imaginary, common);
        report_unsupported_type_parameter_builtin(
            state,
            real_node,
            Operand {
                type_id: common,
                value: real.value,
                addressable: real.addressable,
                assignable: real.assignable,
            },
            COMPLEX_BUILTIN,
        );
        return builtin_operand(synthetic_builtin_type_parameter(state, common))
    }
    if !go_types::is_untyped(state.world, common) {
        update_contextual_operand_fact(state, real_node, real, common);
        update_contextual_operand_fact(state, imaginary_node, imaginary, common)
    }
    let mut component_kind = match basic_kind(state, common) {
        go_types::BasicKind::Float32 => go_types::BasicKind::Float32,
        go_types::BasicKind::Float64 => go_types::BasicKind::Float64,
        go_types::BasicKind::UntypedInt | go_types::BasicKind::UntypedRune | go_types::BasicKind::UntypedFloat | go_types::BasicKind::UntypedComplex => go_types::BasicKind::UntypedFloat,
        _ => {
            diagnostic(
                state,
                real_node,
                "invalid argument: arguments have type " + diagnostic_type_string(state, common)
                    + ", expected floating-point",
                false,
            );
            return invalid_operand(state)
        },
    };
    if component_kind == go_types::BasicKind::UntypedFloat
        && (real.value.is_none() || imaginary.value.is_none()) {
        let float64_type = basic_type_id(state, "float64");
        update_contextual_operand_fact(state, real_node, real, float64_type);
        update_contextual_operand_fact(state, imaginary_node, imaginary, float64_type);
        component_kind = go_types::BasicKind::Float64;
    }
    let result_kind = if component_kind == go_types::BasicKind::Float32 {
        go_types::BasicKind::Complex64
    } else if component_kind == go_types::BasicKind::Float64 {
        go_types::BasicKind::Complex128
    } else {
        go_types::BasicKind::UntypedComplex
    };
    let result_type = find_basic_kind(state, result_kind);
    let value = match (real.value, imaginary.value) {
        (Some(real), Some(imaginary)) => match (
            constant::round_constant(real, component_kind, state.config.sizes),
            constant::round_constant(imaginary, component_kind, state.config.sizes),
        ) {
            (Some(real), Some(imaginary)) => match (
                constant::component_from_constant(real),
                constant::component_from_constant(imaginary),
            ) {
                (Some(real), Some(imaginary)) => {
                    let result = constant::ConstValue::Complex { real, imaginary };
                    match constant::round_constant(result, result_kind, state.config.sizes) {
                        Some(value) => Option::Some(value),
                        None => {
                            diagnostic(state, node, "complex constant overflows result type", false);
                            Option::Some(constant::ConstValue::Unknown)
                        },
                    }
                },
                _ => Option::Some(constant::ConstValue::Unknown),
            },
            _ => Option::Some(constant::ConstValue::Unknown),
        },
        _ => Option::None,
    };
    Operand { type_id: result_type, value, addressable: false, assignable: false }
}

fn check_real_imag_builtin(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    arguments: Vec[syntax::NodeId],
    imaginary_part: bool,
) -> Operand {
    if !check_builtin_count(state, node, arguments.len(), 1, 1) {
        return invalid_operand(state)
    }
    let argument = check_expression(state, scope, arguments[0]);
    if !require_value(state, arguments[0]) {
        return invalid_operand(state)
    }
    let expanded = tuple_variables(state, argument.type_id);
    if expanded.len() > 1 {
        let _ = check_builtin_count(state, node, expanded.len(), 1, 1);
        return invalid_operand(state)
    }
    if go_types::is_type_parameter(state.world, argument.type_id) {
        report_unsupported_type_parameter_builtin(
            state,
            arguments[0],
            argument,
            if imaginary_part {
                IMAG_BUILTIN
            } else {
                REAL_BUILTIN
            },
        );
        return builtin_operand(synthetic_builtin_type_parameter(state, argument.type_id))
    }
    let mut result_kind = match basic_kind(state, argument.type_id) {
        go_types::BasicKind::Complex64 => go_types::BasicKind::Float32,
        go_types::BasicKind::Complex128 => go_types::BasicKind::Float64,
        go_types::BasicKind::UntypedInt | go_types::BasicKind::UntypedRune | go_types::BasicKind::UntypedFloat | go_types::BasicKind::UntypedComplex => go_types::BasicKind::UntypedFloat,
        _ => {
            diagnostic(
                state,
                arguments[0],
                "invalid argument: argument has type "
                    + diagnostic_type_string(state, argument.type_id)
                    + ", expected complex type",
                false,
            );
            return invalid_operand(state)
        },
    };
    if result_kind == go_types::BasicKind::UntypedFloat && argument.value.is_none() {
        update_contextual_operand_fact(
            state,
            arguments[0],
            argument,
            basic_type_id(state, "complex128"),
        );
        result_kind = go_types::BasicKind::Float64;
    }
    let value = match argument.value {
        Some(value) => match constant::constant_to_numeric_complex(value) {
            Some(parts) => Option::Some(
                constant::component_to_constant(
                    if imaginary_part {
                        parts.1
                    } else {
                        parts.0
                    },
                ),
            ),
            None => Option::Some(constant::ConstValue::Unknown),
        },
        None => Option::None,
    };
    Operand {
        type_id: find_basic_kind(state, result_kind),
        value,
        addressable: false,
        assignable: false,
    }
}

fn unsafe_constant_operand(state: CheckState, value: i64) -> Operand {
    Operand {
        type_id: basic_type_id(state, "uintptr"),
        value: Option::Some(constant::ConstValue::Int(constant::integer_from_int64(value))),
        addressable: false,
        assignable: false,
    }
}

fn common_type_parameter_size(state: CheckState, value: go_types::TypeId, alignment: bool) -> Option[
    i64,
] {
    let terms = go_types::type_set_specific_types(state.world, value);
    if terms.is_empty() {
        return Option::None
    }
    let mut result: Option[i64] = Option::None;
    for term in terms {
        let candidate = if alignment {
            go_types::alignof(state.world, term, state.config.sizes)
        } else {
            go_types::sizeof(state.world, term, state.config.sizes)
        };
        if candidate < 0 {
            return Option::None
        }
        match result {
            Some(value) => if value != candidate {
                return Option::None
            },
            None => {
                result = Option::Some(candidate);
            },
        }
    }
    result
}

fn type_has_variable_size(
    state: CheckState,
    value: go_types::TypeId,
    visited: Vec[go_types::TypeId],
) -> bool {
    let resolved = go_types::unalias(state.world, value);
    for previous in visited {
        if previous.value == resolved.value {
            return false
        }
    }
    visited.push(resolved);
    match go_types::get_type(state.world, resolved) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::TypeParam { object: _, constraint: _, index: _ },
        }) => true,
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object: _,
                underlying,
                type_params: _,
                type_args: _,
                methods: _,
            },
        }) => type_has_variable_size(state, underlying, visited),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Array { length: _, element } }) => type_has_variable_size(
            state,
            element,
            visited,
        ),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Struct { fields } }) => {
            for field in fields {
                if type_has_variable_size(state, field.variable.type_id, visited) {
                    return true
                }
            }
            false
        },
        _ => false,
    }
}

fn invalid_recursive_generic_instance_in_type(
    state: CheckState,
    value: go_types::TypeId,
    visited: Vec[isize],
) -> Option[go_types::ObjectId] {
    let resolved = go_types::unalias(state.world, value);
    for existing in visited {
        if existing == resolved.value {
            return Option::None
        }
    }
    visited.push(resolved.value);
    match go_types::get_type(state.world, resolved) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object,
                underlying,
                type_params: _,
                type_args,
                methods: _,
            },
        }) => {
            let mut concrete = !type_args.is_empty();
            for argument in type_args {
                if go_types::is_type_parameter(state.world, argument) {
                    concrete = false;
                }
            }
            if concrete && invalid_named_type_cycle(state, underlying, resolved, Vec::new()) {
                Option::Some(object)
            } else {
                invalid_recursive_generic_instance_in_type(state, underlying, visited)
            }
        },
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Array { length: _, element } }) => invalid_recursive_generic_instance_in_type(
            state,
            element,
            visited,
        ),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Struct { fields } }) => {
            for field in fields {
                match invalid_recursive_generic_instance_in_type(
                    state,
                    field.variable.type_id,
                    visited,
                ) {
                    Some(object) => return Option::Some(object),
                    None => {},
                }
            }
            Option::None
        },
        _ => Option::None,
    }
}

fn invalid_recursive_generic_instance(state: CheckState, value: go_types::TypeId) -> Option[
    go_types::ObjectId,
] {
    invalid_recursive_generic_instance_in_type(state, value, Vec::new())
}

fn check_size_align_initializer_function_body(
    state: CheckState,
    node: syntax::NodeId,
    signature: go_types::TypeId,
    value: i64,
) -> () {
    if state.active_value_objects.is_empty() {
        return
    }
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::FuncLit { type_node, body }) => {
            let object = state.active_value_objects[state.active_value_objects.len() - 1];
            match pending_value_index(state, object) {
                Some(index) => if !state.pending_values[index].constant_declaration {
                    return
                },
                None => return,
            }
            let constant_value = constant::ConstValue::Int(constant::integer_from_int64(value));
            let _ = go_types::set_object_type(state.world, object, basic_type_id(state, "uintptr"));
            save_constant(state, object, constant_value);
            let _ = go_types::set_object_constant(
                state.world,
                object,
                constant::constant_kind_name(constant_value),
                constant::constant_exact_string(constant_value),
            );
            check_deferred_function_body_early(
                state,
                type_node,
                signature,
                body,
                state.current_iota,
            )
        },
        _ => {},
    }
}

fn incomplete_function_reference_type(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
) -> Option[go_types::TypeId] {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::Ident { name_pos: _, name }) => match go_types::lookup(
            state.world,
            scope,
            name,
        ) {
            Some(object) => match pending_function_index(state, object) {
                Some(index) => if state.pending_functions[index].status == 1 {
                    go_types::get_object(state.world, object).map(|object| object.type_id)
                } else {
                    Option::None
                },
                None => Option::None,
            },
            None => Option::None,
        },
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ } | syntax::SyntaxKind::IndexExpr {
            expression,
            lbrack: _,
            index: _,
            rbrack: _,
        } | syntax::SyntaxKind::IndexListExpr { expression, lbrack: _, indices: _, rbrack: _ }) => incomplete_function_reference_type(
            state,
            scope,
            expression,
        ),
        _ => Option::None,
    }
}

fn check_unsafe_size_align(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    arguments: Vec[syntax::NodeId],
    alignment: bool,
) -> Operand {
    if !check_builtin_count(state, node, arguments.len(), 1, 1) {
        return invalid_operand(state)
    }
    match incomplete_function_reference_type(state, scope, arguments[0]) {
        Some(type_id) => {
            match syntax::get_kind(state.syntax.arena, arguments[0]) {
                Some(syntax::SyntaxKind::IndexExpr { expression: _, lbrack: _, index: _, rbrack: _ } | syntax::SyntaxKind::IndexListExpr {
                    expression: _,
                    lbrack: _,
                    indices: _,
                    rbrack: _,
                }) => record_operand(
                    state,
                    arguments[0],
                    builtin_operand(snapshot_signature_type(state, type_id)),
                ),
                _ => {},
            }
            state.deferred_type_info_expressions.push(
                DeferredTypeInfoExpression { scope, node: arguments[0] },
            );
            return unsafe_constant_operand(state, state.config.sizes.word_size)
        },
        None => {},
    }
    let cycle_depth = state.type_cycle_depth;
    let type_value_cycle_count = state.deferred_type_value_cycles.len();
    state.type_cycle_depth = 0;
    let mut argument = check_expression(state, scope, arguments[0]);
    state.type_cycle_depth = cycle_depth;
    if state.deferred_type_value_cycles.len() > type_value_cycle_count {
        let mut recover = active_type_object_for_value(state, argument.type_id, false).is_none();
        for index in type_value_cycle_count..state.deferred_type_value_cycles.len() {
            let cycle = state.deferred_type_value_cycles[index];
            if cycle.objects.len() < 2 {
                recover = false;
            } else if cycle.objects.len() <= state.active_type_objects.len() {
                recover = false;
            }
            for object in cycle.objects {
                match go_types::get_object(state.world, object) {
                    Some(object) => if object.kind != go_types::ObjectKind::TypeName {
                        recover = false;
                    },
                    None => {
                        recover = false;
                    },
                }
            }
        }
        if recover {
            let mut omit = false;
            for index in type_value_cycle_count..state.deferred_type_value_cycles.len() {
                let cycle = state.deferred_type_value_cycles[index];
                if !cycle.objects.is_empty()
                    && type_has_expression_array_length(state, cycle.objects[0]) {
                    omit = true;
                }
            }
            if omit {
                let _ = state.omitted_type_fact_nodes.insert(node.value);
                let _ = state.omitted_type_fact_nodes.insert(arguments[0].value);
            }
            return unsafe_constant_operand(state, state.config.sizes.word_size)
        } else {
            let _ = state.omitted_type_fact_nodes.insert(node.value);
            return invalid_operand(state)
        }
    }
    if !require_value(state, arguments[0]) {
        return invalid_operand(state)
    }
    if basic_kind(state, argument.type_id) == go_types::BasicKind::UntypedNil {
        diagnostic(
            state,
            arguments[0],
            "use of untyped nil in argument to unsafe."
                + if alignment {
                    UNSAFE_ALIGNOF_BUILTIN
                } else {
                    UNSAFE_SIZEOF_BUILTIN
                },
            false,
        );
        return invalid_operand(state)
    }
    if go_types::is_untyped(state.world, argument.type_id) {
        let default = default_operand_type(state, argument);
        update_contextual_operand_fact(state, arguments[0], argument, default);
        argument.type_id = default;
    }
    match underlying_kind(state, argument.type_id) {
        Some(go_types::TypeKind::Tuple { variables }) => if variables.len() != 1 {
            let _ = check_builtin_count(state, node, variables.len(), 1, 1);
            return invalid_operand(state)
        },
        _ => {},
    }
    if argument.type_id.value == state.world.invalid.value {
        return invalid_operand(state)
    }
    let invalid_recursive = invalid_recursive_generic_instance(state, argument.type_id);
    match invalid_recursive {
        Some(object) => {
            if state.function_ids.is_empty() && !invalid_type_object_seen(state, object) {
                match go_types::get_object(state.world, object) {
                    Some(object) => diagnostic(
                        state,
                        arguments[0],
                        "invalid recursive type: " + object.name + " refers to itself",
                        false,
                    ),
                    None => {},
                }
            }
            let _ = state.omitted_type_fact_nodes.insert(arguments[0].value);
            return invalid_operand(state)
        },
        None => {},
    }
    let variable_size = type_has_variable_size(state, argument.type_id, Vec::new());
    let value = if alignment {
        go_types::alignof(state.world, argument.type_id, state.config.sizes)
    } else {
        go_types::sizeof(state.world, argument.type_id, state.config.sizes)
    };
    if variable_size {
        builtin_operand(basic_type_id(state, "uintptr"))
    } else if value < 0 {
        diagnostic(
            state,
            arguments[0],
            operand_string(state, arguments[0], argument) + " is too large",
            false,
        );
        invalid_operand(state)
    } else {
        check_size_align_initializer_function_body(state, arguments[0], argument.type_id, value);
        unsafe_constant_operand(state, value)
    }
}

fn check_deferred_type_info_expressions(state: CheckState) -> () {
    for pending in state.deferred_type_info_expressions {
        let operand = check_expression(state, pending.scope, pending.node);
        let instance_type = match recorded_type_fact(state, pending.node) {
            Some(fact) => fact.type_id,
            None => operand.type_id,
        };
        match syntax::get_kind(state.syntax.arena, pending.node) {
            Some(syntax::SyntaxKind::IndexExpr { expression, lbrack: _, index: _, rbrack: _ } | syntax::SyntaxKind::IndexListExpr {
                expression,
                lbrack: _,
                indices: _,
                rbrack: _,
            }) => for index in 0..state.info.instances.len() {
                if state.info.instances[index].node.value == expression.value {
                    state.info.instances[index].type_id = instance_type;
                }
            },
            _ => {},
        };
    }
}

fn selection_fact(state: CheckState, node: syntax::NodeId) -> Option[SelectionFact] {
    recorded_selection_index(state, node).map(|index| state.info.selections[index])
}

fn record_offsetof_selection(state: CheckState, node: syntax::NodeId, receiver: go_types::TypeId) -> () {
    let base = match go_types::get_type(state.world, core_type_id(state, receiver)) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) => element,
        _ => receiver,
    };
    match recorded_selection_index(state, node) {
        Some(index) => {
            state.info.selections[index].receiver_type = base;
            state.info.selections[index].indirect = false;
        },
        None => {},
    }
}

fn field_path_offset(state: CheckState, receiver: go_types::TypeId, path: Vec[isize]) -> Option[i64] {
    let mut current = receiver;
    let mut offset = 0.to_i64();
    let mut first = true;
    for index in path {
        match go_types::get_type(state.world, core_type_id(state, current)) {
            Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) => if first {
                current = element;
            } else {
                return Option::None
            },
            _ => {},
        }
        match go_types::get_type(state.world, core_type_id(state, current)) {
            Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Struct { fields } }) => if index
                < 0
                || index >= fields.len() {
                return Option::None
            } else {
                let offsets = go_types::offsets_of(state.world, fields, state.config.sizes);
                if offsets[index] < 0 || offset > 9223372036854775807.to_i64() - offsets[index] {
                    return Option::None
                } else {
                    offset += offsets[index];
                    current = fields[index].variable.type_id;
                    first = false;
                }
            },
            _ => return Option::None,
        }
    }
    Option::Some(offset)
}

fn unparenthesized_expression(state: CheckState, node: syntax::NodeId) -> syntax::NodeId {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => unparenthesized_expression(
            state,
            expression,
        ),
        _ => node,
    }
}

fn omit_selector_result(state: CheckState, argument: syntax::NodeId, selector: syntax::NodeId) -> () {
    let _ = state.omitted_type_fact_nodes.insert(argument.value);
    let _ = state.omitted_type_fact_nodes.insert(selector.value);
    match syntax::get_kind(state.syntax.arena, selector) {
        Some(syntax::SyntaxKind::SelectorExpr { expression: _, selector }) => {
            let _ = state.omitted_use_fact_nodes.insert(selector.value);
        },
        _ => {},
    }
}

fn omit_selector_wrappers(state: CheckState, argument: syntax::NodeId, selector: syntax::NodeId) -> () {
    if argument.value == selector.value {
        return
    }
    let _ = state.omitted_type_fact_nodes.insert(argument.value);
    match syntax::get_kind(state.syntax.arena, argument) {
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => omit_selector_wrappers(
            state,
            expression,
            selector,
        ),
        _ => {},
    }
}

fn check_unsafe_offsetof(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    arguments: Vec[syntax::NodeId],
) -> Operand {
    if !check_builtin_count(state, node, arguments.len(), 1, 1) {
        return invalid_operand(state)
    }
    let argument = arguments[0];
    let selector_argument = unparenthesized_expression(state, argument);
    match syntax::get_kind(state.syntax.arena, selector_argument) {
        Some(syntax::SyntaxKind::SelectorExpr { expression, selector: _ }) => {
            let _ = check_expression(state, scope, argument);
            omit_selector_wrappers(state, argument, selector_argument);
            match (recorded_type_fact(state, expression), selection_fact(state, selector_argument)) {
                (Some(receiver), Some(selection)) => match go_types::get_object(
                    state.world,
                    selection.object,
                ) {
                    Some(object) => if object.kind != go_types::ObjectKind::Var {
                        omit_selector_result(state, argument, selector_argument);
                        diagnostic(
                            state,
                            argument,
                            "invalid argument: " + expression_source_text(state, argument)
                                + " is a method value",
                            false,
                        );
                        invalid_operand(state)
                    } else {
                        match field_path_offset(state, receiver.type_id, selection.index) {
                            Some(value) => {
                                record_offsetof_selection(
                                    state,
                                    selector_argument,
                                    receiver.type_id,
                                );
                                unsafe_constant_operand(state, value)
                            },
                            None => {
                                if !type_has_variable_size(state, receiver.type_id, Vec::new())
                                    && go_types::sizeof(
                                        state.world,
                                        receiver.type_id,
                                        state.config.sizes,
                                    )
                                        < 0 {
                                    diagnostic(
                                        state,
                                        expression,
                                        operand_string(
                                            state,
                                            expression,
                                            Operand {
                                                type_id: receiver.type_id,
                                                value: Option::None,
                                                addressable: receiver.addressable,
                                                assignable: receiver.assignable,
                                            },
                                        )
                                            + " is too large",
                                        false,
                                    )
                                } else {
                                    omit_selector_result(state, argument, selector_argument);
                                    diagnostic(
                                        state,
                                        argument,
                                        "invalid argument: field " + object.name
                                            + " is embedded via a pointer in "
                                            + diagnostic_type_string(state, receiver.type_id),
                                        false,
                                    )
                                }
                                invalid_operand(state)
                            },
                        }
                    },
                    None => invalid_operand(state),
                },
                _ => {
                    diagnostic(state, argument, "invalid expression for unsafe.Offsetof", false);
                    invalid_operand(state)
                },
            }
        },
        _ => {
            match conversion_target(state, scope, argument) {
                Some(_) => {},
                None => {
                    let _ = check_expression(state, scope, argument);
                },
            }
            diagnostic(
                state,
                argument,
                "invalid argument: " + expression_source_text(state, argument)
                    + " is not a selector expression",
                false,
            );
            invalid_operand(state)
        },
    }
}

fn check_unsafe_add(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    arguments: Vec[syntax::NodeId],
) -> Operand {
    if !check_builtin_count(state, node, arguments.len(), 2, 2) {
        return invalid_operand(state)
    }
    let pointer = check_expression(state, scope, arguments[0]);
    integer_builtin_argument(state, scope, arguments[1]);
    if basic_kind(state, pointer.type_id) != go_types::BasicKind::UnsafePointer {
        diagnostic(
            state,
            arguments[0],
            "first argument to unsafe.Add must be unsafe.Pointer",
            false,
        )
    }
    builtin_operand(basic_type_id(state, "Pointer"))
}

fn check_unsafe_slice(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    arguments: Vec[syntax::NodeId],
) -> Operand {
    if !check_builtin_count(state, node, arguments.len(), 2, 2) {
        return invalid_operand(state)
    }
    let pointer = check_expression(state, scope, arguments[0]);
    match underlying_kind(state, pointer.type_id) {
        Some(go_types::TypeKind::Pointer { element }) => if length_builtin_argument(
            state,
            scope,
            arguments[1],
        ) {
            builtin_operand(go_types::add_type(state.world, go_types::TypeKind::Slice { element }))
        } else {
            invalid_operand(state)
        },
        _ => {
            let _ = check_expression(state, scope, arguments[1]);
            diagnostic(
                state,
                arguments[0],
                "invalid argument: " + operand_string(state, arguments[0], pointer)
                    + " is not a pointer",
                false,
            );
            invalid_operand(state)
        },
    }
}

fn check_unsafe_slice_data(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    arguments: Vec[syntax::NodeId],
) -> Operand {
    if !check_builtin_count(state, node, arguments.len(), 1, 1) {
        return invalid_operand(state)
    }
    let slice = check_expression(state, scope, arguments[0]);
    match slice_element_type(state, slice.type_id) {
        Some(element) => builtin_operand(
            go_types::add_type(state.world, go_types::TypeKind::Pointer { element }),
        ),
        None => {
            diagnostic(
                state,
                arguments[0],
                "invalid argument: " + operand_string(state, arguments[0], slice)
                    + " is not a slice",
                false,
            );
            invalid_operand(state)
        },
    }
}

fn check_unsafe_string(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    arguments: Vec[syntax::NodeId],
) -> Operand {
    if !check_builtin_count(state, node, arguments.len(), 2, 2) {
        return invalid_operand(state)
    }
    let pointer = check_expression(state, scope, arguments[0]);
    let byte_pointer = go_types::add_type(
        state.world,
        go_types::TypeKind::Pointer { element: basic_type_id(state, "byte") },
    );
    if !argument_assignable(state, pointer, byte_pointer) {
        let _ = check_expression(state, scope, arguments[1]);
        diagnostic(
            state,
            arguments[0],
            "cannot use " + operand_string(state, arguments[0], pointer)
                + " as *byte value in argument to unsafe.String",
            false,
        );
        invalid_operand(state)
    } else if length_builtin_argument(state, scope, arguments[1]) {
        builtin_operand(basic_type_id(state, "string"))
    } else {
        invalid_operand(state)
    }
}

fn check_unsafe_string_data(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    arguments: Vec[syntax::NodeId],
) -> Operand {
    if !check_builtin_count(state, node, arguments.len(), 1, 1) {
        return invalid_operand(state)
    }
    let value = check_expression(state, scope, arguments[0]);
    let direct_string = match go_types::get_type(
        state.world,
        go_types::unalias(state.world, value.type_id),
    ) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Basic {
                basic: go_types::BasicKind::String | go_types::BasicKind::UntypedString,
                name: _,
                untyped: _,
            },
        }) => true,
        _ => false,
    };
    if !direct_string {
        diagnostic(
            state,
            arguments[0],
            "cannot use " + operand_string(state, arguments[0], value)
                + " as string value in argument to unsafe.StringData",
            false,
        );
        invalid_operand(state)
    } else {
        if go_types::is_untyped(state.world, value.type_id) {
            update_contextual_operand_fact(
                state,
                arguments[0],
                value,
                basic_type_id(state, "string"),
            )
        }
        builtin_operand(
            go_types::add_type(
                state.world,
                go_types::TypeKind::Pointer { element: basic_type_id(state, "byte") },
            ),
        )
    }
}

fn min_max_constant(name: string, current: constant::ConstValue, candidate: constant::ConstValue) -> constant::ConstValue {
    match constant::constant_compare(current, candidate) {
        Some(order) => if (order > 0 && name == MIN_BUILTIN) || (order < 0 && name == MAX_BUILTIN) {
            constant::constant_copy(candidate)
        } else {
            constant::constant_copy(current)
        },
        None => constant::ConstValue::Unknown,
    }
}

fn check_min_max_builtin(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    name: string,
    arguments: Vec[syntax::NodeId],
) -> Operand {
    if !check_builtin_count(state, node, arguments.len(), 1, -1) {
        return invalid_operand(state)
    }
    let first = check_expression(state, scope, arguments[0]);
    let argument_operands: Vec[Operand] = Vec::from_array([first]);
    if !go_types::is_ordered(state.world, first.type_id) {
        diagnostic(
            state,
            arguments[0],
            "invalid argument: " + operand_string(state, arguments[0], first) + " cannot be ordered",
            false,
        );
        return invalid_operand(state)
    }
    let mut result_type = first.type_id;
    let mut result_value = first.value.map(|value| constant::constant_copy(value));
    let mut valid = true;
    for index in 1..arguments.len() {
        let value = check_expression(state, scope, arguments[index]);
        argument_operands.push(value);
        let mut contextual_failed = false;
        if go_types::is_ordered(state.world, value.type_id)
            && go_types::is_untyped(state.world, result_type)
            && go_types::is_type_parameter(state.world, value.type_id) {
            let mut compatible = true;
            for prior in 0..index {
                if !argument_assignable(state, argument_operands[prior], value.type_id) {
                    compatible = false;
                }
            }
            if compatible {
                result_type = value.type_id;
                result_value = Option::None;
            }
        } else if go_types::is_ordered(state.world, value.type_id)
            && go_types::is_untyped(state.world, result_type)
            && !go_types::is_untyped(state.world, value.type_id) {
            for prior in 0..index {
                let previous = argument_operands[prior];
                match previous.value {
                    Some(constant_value) => if constant::convert_constant(
                        constant_value,
                        basic_kind(state, value.type_id),
                        state.config.sizes,
                    ).is_none() {
                        diagnostic(
                            state,
                            arguments[prior],
                            operand_string(state, arguments[prior], previous)
                                + if go_types::is_numeric(state.world, previous.type_id)
                                    && go_types::is_integer(state.world, value.type_id) {
                                    if go_types::is_integer(state.world, previous.type_id) {
                                        " overflows " + diagnostic_type_string(state, value.type_id)
                                    } else {
                                        " truncated to "
                                            + diagnostic_type_string(state, value.type_id)
                                    }
                                } else {
                                    " cannot be represented by "
                                        + diagnostic_type_string(state, value.type_id)
                                },
                            false,
                        );
                        contextual_failed = true;
                    },
                    None => {},
                }
            }
            if !contextual_failed {
                result_value = match result_value {
                    Some(constant_value) => constant::convert_constant(
                        constant_value,
                        basic_kind(state, value.type_id),
                        state.config.sizes,
                    ),
                    None => Option::None,
                };
                result_type = value.type_id;
            }
        }
        let combined = binary_operand_type(
            state,
            Operand {
                type_id: result_type,
                value: result_value,
                addressable: false,
                assignable: false,
            },
            value,
        );
        if contextual_failed {
            valid = false;
        } else if !go_types::is_ordered(state.world, value.type_id) {
            diagnostic(
                state,
                arguments[index],
                "invalid argument: " + operand_string(state, arguments[index], value)
                    + " cannot be ordered",
                false,
            );
            valid = false;
        } else if combined.value == state.world.invalid.value {
            diagnostic(
                state,
                arguments[index],
                "invalid argument: mismatched types " + diagnostic_type_string(state, result_type)
                    + " (previous argument) and "
                    + diagnostic_type_string(state, value.type_id)
                    + " (type of "
                    + expression_source_text(state, arguments[index])
                    + ")",
                false,
            );
            valid = false;
        } else if !go_types::is_ordered(state.world, combined) {
            diagnostic(
                state,
                arguments[index],
                "invalid argument: " + operand_string(state, arguments[index], value)
                    + " cannot be ordered",
                false,
            );
            valid = false;
        } else {
            for prior in 0..index + 1 {
                update_contextual_operand_fact(
                    state,
                    arguments[prior],
                    argument_operands[prior],
                    combined,
                )
            }
            result_type = combined;
            result_value = match (result_value, value.value) {
                (Some(current), Some(candidate)) => Option::Some(
                    min_max_constant(name, current, candidate),
                ),
                _ => Option::None,
            };
        };
    }
    if !valid {
        invalid_operand(state)
    } else {
        if result_value.is_none() && go_types::is_untyped(state.world, result_type) {
            result_type = default_operand_type(
                state,
                Operand {
                    type_id: result_type,
                    value: Option::None,
                    addressable: false,
                    assignable: false,
                },
            );
        }
        if !go_types::is_untyped(state.world, result_type) {
            for index in 0..arguments.len() {
                update_contextual_operand_fact(
                    state,
                    arguments[index],
                    argument_operands[index],
                    result_type,
                )
            }
        }
        let rounded = match result_value {
            Some(value) => if go_types::is_untyped(state.world, result_type) {
                Option::Some(constant::constant_copy(value))
            } else {
                constant::round_constant(value, basic_kind(state, result_type), state.config.sizes)
            },
            None => Option::None,
        };
        Operand { type_id: result_type, value: rounded, addressable: false, assignable: false }
    }
}

fn check_print_builtin(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    name: string,
    arguments: Vec[syntax::NodeId],
) -> Operand {
    let mut valid = true;
    for argument in arguments {
        let value = check_expression(state, scope, argument);
        if value.type_id.value == state.world.invalid.value {
            let _ = require_value(state, argument);
            valid = false;
        } else if basic_kind(state, value.type_id) == go_types::BasicKind::UntypedNil {
            diagnostic(state, argument, "use of untyped nil in argument to built-in " + name, false);
            valid = false;
        } else {
            update_contextual_operand_fact(
                state,
                argument,
                value,
                default_operand_type(state, value),
            );
            if !require_value(state, argument) {
                valid = false;
            }
        };
    }
    if valid {
        void_operand(state, node)
    } else {
        invalid_operand(state)
    }
}

fn check_panic_builtin(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    arguments: Vec[syntax::NodeId],
) -> Operand {
    if !check_builtin_count(state, node, arguments.len(), 1, 1) {
        return invalid_operand(state)
    }
    let argument = check_expression(state, scope, arguments[0]);
    if !require_value(state, arguments[0]) {
        return invalid_operand(state)
    }
    match underlying_kind(state, argument.type_id) {
        Some(go_types::TypeKind::Tuple { variables }) => if variables.len() != 1 {
            let _ = check_builtin_count(state, node, variables.len(), 1, 1);
            return invalid_operand(state)
        },
        _ => {},
    }
    update_contextual_operand_fact(state, arguments[0], argument, builtin_empty_interface(state));
    void_operand(state, node)
}

fn check_recover_builtin(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    arguments: Vec[syntax::NodeId],
) -> Operand {
    let mut actual = arguments.len();
    if arguments.len() == 1 {
        let argument = check_expression(state, scope, arguments[0]);
        if !require_value(state, arguments[0]) {
            return invalid_operand(state)
        }
        match underlying_kind(state, argument.type_id) {
            Some(go_types::TypeKind::Tuple { variables }) => {
                actual = variables.len();
            },
            _ => {},
        }
    } else {
        for argument in arguments {
            let _ = check_expression(state, scope, argument);
        }
    }
    if !check_builtin_count(state, node, actual, 0, 0) {
        invalid_operand(state)
    } else {
        builtin_operand(builtin_empty_interface(state))
    }
}

fn check_builtin_call(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    reference: BuiltinReference,
    arguments: Vec[syntax::NodeId],
    ellipsis: isize,
) -> Operand {
    record_builtin_reference(state, reference);
    if ellipsis >= 0 && reference.name != APPEND_BUILTIN {
        for index in 0..arguments.len() {
            if index == 0
                && match reference.name {
                    MAKE_BUILTIN | NEW_BUILTIN => true,
                    _ => false,
                } {
                let _ = resolve_type(state, scope, arguments[index]);
            } else {
                let _ = check_expression(state, scope, arguments[index]);
            }
        }
        diagnostic_at_position(
            state,
            node,
            ellipsis,
            "invalid operation: invalid use of ... with built-in " + reference.name,
            false,
        );
        return invalid_operand(state)
    }
    if !check_builtin_raw_arity(state, scope, node, reference.name, arguments) {
        return invalid_operand(state)
    }
    let result = match reference.name {
        LEN_BUILTIN | CAP_BUILTIN => {
            check_len_cap(state, scope, node, reference.name, arguments)
        },
        NEW_BUILTIN => check_new_builtin(state, scope, node, arguments),
        MAKE_BUILTIN => check_make_builtin(state, scope, node, arguments),
        APPEND_BUILTIN => check_append_builtin(state, scope, node, arguments, ellipsis),
        DELETE_BUILTIN => check_delete_builtin(state, scope, node, arguments),
        CLEAR_BUILTIN => check_clear_builtin(state, scope, node, arguments),
        CLOSE_BUILTIN => check_close_builtin(state, scope, node, arguments),
        COPY_BUILTIN => check_copy_builtin(state, scope, node, arguments),
        COMPLEX_BUILTIN => check_complex_builtin(state, scope, node, arguments),
        REAL_BUILTIN => check_real_imag_builtin(state, scope, node, arguments, false),
        IMAG_BUILTIN => check_real_imag_builtin(state, scope, node, arguments, true),
        UNSAFE_SIZEOF_BUILTIN => check_unsafe_size_align(state, scope, node, arguments, false),
        UNSAFE_ALIGNOF_BUILTIN => check_unsafe_size_align(state, scope, node, arguments, true),
        UNSAFE_OFFSETOF_BUILTIN => check_unsafe_offsetof(state, scope, node, arguments),
        UNSAFE_ADD_BUILTIN => check_unsafe_add(state, scope, node, arguments),
        UNSAFE_SLICE_BUILTIN => check_unsafe_slice(state, scope, node, arguments),
        UNSAFE_SLICE_DATA_BUILTIN => check_unsafe_slice_data(state, scope, node, arguments),
        UNSAFE_STRING_BUILTIN => check_unsafe_string(state, scope, node, arguments),
        UNSAFE_STRING_DATA_BUILTIN => check_unsafe_string_data(state, scope, node, arguments),
        MIN_BUILTIN | MAX_BUILTIN => {
            check_min_max_builtin(state, scope, node, reference.name, arguments)
        },
        PRINT_BUILTIN | PRINTLN_BUILTIN => {
            check_print_builtin(state, scope, node, reference.name, arguments)
        },
        PANIC_BUILTIN => check_panic_builtin(state, scope, node, arguments),
        RECOVER_BUILTIN => check_recover_builtin(state, scope, node, arguments),
        _ => {
            diagnostic(state, node, "builtin " + reference.name + " is not implemented yet", false);
            invalid_operand(state)
        },
    };
    let record_signature = if result.value.is_some() {
        false
    } else {
        match reference.name {
            UNSAFE_SIZEOF_BUILTIN | UNSAFE_ALIGNOF_BUILTIN => {
                result.type_id.value != state.world.invalid.value && result.value.is_none()
            },
            UNSAFE_OFFSETOF_BUILTIN => false,
            _ => true,
        }
    };
    if record_signature {
        record_builtin_signature(state, reference, arguments, result, ellipsis)
    }
    result
}
