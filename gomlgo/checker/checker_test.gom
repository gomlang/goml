}

#[test]
fn checks_generic_function_explicit_arguments_and_basic_inference() -> () {
    let source = "package p\ntype Seq[E any] func(func(E) bool)\ntype Reader interface { Read() int }\ntype Integer interface { ~int | ~int64 }\nfunc Identity[T any](value T) T { return value }\nfunc First[A, B any](left A, right B) A { return left }\nfunc Append[Slice ~[]E, E any](slice Slice, sequence Seq[E]) Slice { return slice }\nfunc Collect[E any](sequence Seq[E]) []E { return Append([]E(nil), sequence) }\nfunc Accept[E any](left []E, right []E) {}\nfunc Forward[Slice ~[]E, E any](slice Slice) { Accept(slice, []E(nil)) }\nfunc ForwardReader[T Reader](value T) Reader { return value }\nfunc Nonpositive[T Integer](value T) bool { return value <= 0 }\nfunc Pair() (string, error) { return \"value\", nil }\nfunc Capture[T any](value T, err error) T { return value }\nfunc Sink(values ...any) {}\nfunc Shift(index uint) { Sink(1 << index) }\nvar A = Identity(42)\nvar B = Identity[string](\"value\")\nvar C = First(7, \"ignored\")\nvar D = Capture(Pair())\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "A").type_id),
        "int",
    );
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "B").type_id),
        "string",
    );
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "C").type_id),
        "int",
    );
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "D").type_id),
        "string",
    );
    testing::assert(result.info.instances.len() >= 3);
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok)
}

