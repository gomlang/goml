#[test]
fn evaluates_local_const_iota_and_inherited_expressions() -> () {
    let source = "package p\nfunc Use() int {\n    const (\n        A = iota\n        B\n        C int = iota * 2\n        D\n    )\n    return A + B + C + D\n}\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    let expected_names = Vec::from_array(["A", "B", "C", "D"]);
    let expected_values = Vec::from_array(["0", "1", "4", "6"]);
    let mut found = 0;
    for object in result.world.objects {
        if object.kind == go_types::ObjectKind::Const {
            for index in 0..expected_names.len() {
                if object.name == expected_names[index] {
                    testing::assert_eq(object.constant.unwrap_or(""), expected_values[index]);
                    found += 1;
                }
            }
        }
    }
    testing::assert_eq(found, 4);
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok)
}

#[test]
fn checks_labels_branches_and_switch_fallthrough() -> () {
    let source = "package p\nfunc Use(limit int) int {\n    value := 0\nLoop:\n    for value < limit {\n        value++\n        if value < limit { continue Loop }\n        break Loop\n    }\n    switch value {\n    case 0:\n        value = 1\n        fallthrough\n    default:\n        value++\n    }\n    if value > 100 { goto Done }\nDone:\n    return value\n}\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    let mut labels = 0;
    for object in result.world.objects {
        if object.kind == go_types::ObjectKind::Label {
            labels += 1;
        }
    }
    testing::assert_eq(labels, 2);
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok)
}

