#[test]
fn checks_composite_index_slice_assertion_and_function_literal_expressions() -> () {
    let source = "package p\ntype Pair struct { A int; B string }\nconst Digits = \"0123456789\"\nfunc Containers(m map[string]int, input any) int {\n    pair := Pair{A: 1, B: \"value\"}\n    array := [...]int{1, 2, 3}\n    view := array[1:]\n    m[\"value\"] = pair.A + view[0]\n    apply := func(value int) int { return value + 1 }\n    return apply(m[\"value\"]) + input.(int)\n}\nfunc Assert[E error](input error) (E, bool) { value, ok := input.(E); return value, ok }\nfunc SliceConstant(index int) string { return Digits[index:index+1] }\n";
    let result = check_source(source);
