#[test]
fn deduplicates_type_facts_by_source_span() -> () {
    let source = "package p\ntype Item struct { Value int }\nvar Values = []Item{{Value: 1}, {Value: 2}, {Value: 3}}\nconst ( First = iota; Second; Third )\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    let positions: HashMap[string, bool] = HashMap::new();
    for fact in result.info.types {
        match syntax::get_node(result.syntax.arena, fact.node) {
            Some(node) => {
                let key = f"{node.file.value}:{node.span.start}:{node.span.end}";
                testing::assert(!positions.contains(key));
                positions[key] = true;
            },
            None => {},
        }
    }
}

#[test]
fn attaches_value_and_pointer_receiver_methods_to_named_types() -> () {
    let source = "package p\ntype Box struct { Value int }\nfunc (b Box) Get() int { return b.Value }\nfunc (b *Box) Set(value int) { b.Value = value }\n";
    let config = default_config();
    config.ignore_func_bodies = true;
    let result = check(
        config,
        PackageInput { path: "example/p", files: Vec::from_array([source_file("a.go", source)]) },
    );
    testing::assert_eq(result.diagnostics.len(), 0);
    let box_type = package_object(result, "Box").type_id;
    match result.world.types[box_type.value].kind {
        go_types::TypeKind::Named {
            object: _,
            underlying: _,
            type_params: _,
            type_args: _,
            methods,
        } => {
            testing::assert_eq(methods.len(), 2);
            testing::assert_eq(result.world.objects[methods[0].value].name, "Get");
            testing::assert_eq(result.world.objects[methods[1].value].name, "Set");
            match result.world.types[result.world.objects[methods[0].value].type_id.value].kind {
                go_types::TypeKind::Signature {
                    receiver,
                    receiver_type_params: _,
                    type_params: _,
                    params: _,
                    results: _,
                    variadic: _,
                } => match receiver {
                    Some(receiver) => testing::assert_eq(receiver.type_id.value, box_type.value),
                    None => testing::fail("Get has no receiver"),
                },
                _ => testing::fail("Get does not have signature type"),
            }
        },
        _ => testing::fail("Box is not a named type"),
    }
    let oracle_request = typecheck_diff::request(
        "example/p",
        Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
    );
    oracle_request.config.ignore_func_bodies = true;
    let oracle = expect_oracle(typecheck_diff::run_check(oracle_request));
    testing::assert(oracle.ok);
    testing::assert_eq(oracle.package_scope.len(), 1)
}

#[test]
fn checks_constant_conversions_and_function_calls() -> () {
    let source = "package p\ntype Small int8\nconst A = Small(127)\nconst B = string(65)\nvar X = int16(5)\nfunc Add(left int, right int) int { return left + right }\nvar Z = Add(1, 2)\n";
    let config = default_config();
    config.ignore_func_bodies = true;
    let result = check(
        config,
        PackageInput { path: "example/p", files: Vec::from_array([source_file("a.go", source)]) },
    );
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(package_object(result, "A").constant.unwrap_or(""), "127");
    testing::assert_eq(package_object(result, "B").constant.unwrap_or(""), "\"A\"");
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "X").type_id),
        "int16",
    );
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "Z").type_id),
        "int",
    );
    let oracle_request = typecheck_diff::request(
        "example/p",
        Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
    );
    oracle_request.config.ignore_func_bodies = true;
    let oracle = expect_oracle(typecheck_diff::run_check(oracle_request));
    testing::assert(oracle.ok);
    testing::assert_eq(oracle_object_exact(oracle, "A"), "127");
    testing::assert_eq(
        oracle_object_exact(oracle, "B"),
        package_object(result, "B").constant.unwrap_or(""),
    )
}

