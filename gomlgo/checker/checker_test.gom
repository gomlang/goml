package checker;

use gomlgo::typecheck_diff;
use gomlgo::constant;
use gomlgo::types as go_types;
use gomlgo::syntax;
use std::bytes;
use std::json;
use std::testing;

fn source_file(name: string, source: string) -> SourceFile {
    SourceFile { name, source: bytes::Bytes::from_string(source) }
}

fn check_source(source: string) -> CheckResult {
    check(
        default_config(),
        PackageInput { path: "example/p", files: Vec::from_array([source_file("a.go", source)]) },
    )
}

#[test]
fn fake_import_c_is_implicitly_used() -> () {
    let config = default_config();
    config.fake_import_c = true;
    let result = check(
        config,
        PackageInput {
            path: "example/p",
            files: Vec::from_array([source_file("a.go", "package p\nimport \"C\"\n")]),
        },
    );
    testing::assert_eq(result.diagnostics.len(), 0)
}

fn json_string_field(value: json::Value, name: string) -> string {
    json::as_string(json::field(value, name).unwrap_or(json::Value::Null)).unwrap_or("")
}

fn expect_oracle(value: Result[typecheck_diff::CheckResponse, string]) -> typecheck_diff::CheckResponse {
    match value {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            loop {}
        },
    }
}

#[test]
fn checks_explicit_package_variable_and_matches_oracle_facts() -> () {
    let source = "package p\nvar X int\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    let pkg = result.world.packages[result.package_id.value];
    testing::assert_eq(pkg.path, "example/p");
    testing::assert_eq(pkg.name, "p");
    testing::assert(pkg.complete);
    let package_scope = result.world.scopes[pkg.scope.value];
    testing::assert_eq(package_scope.entries.len(), 1);
    let object = result.world.objects[package_scope.entries[0].object.value];
    testing::assert_eq(object.name, "X");
    testing::assert(object.kind == go_types::ObjectKind::Var);
    testing::assert_eq(go_types::format_type(result.world, object.type_id), "int");
    testing::assert_eq(result.info.defs.len(), 2);
    testing::assert_eq(result.info.uses.len(), 1);
    testing::assert_eq(result.info.types.len(), 1);
    testing::assert_eq(result.info.scopes.len(), 1);
    testing::assert_eq(result.info.file_versions.len(), 1);
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok);
    testing::assert_eq(
        oracle.universe_scope.len(),
        result.world.scopes[result.world.universe.value].entries.len(),
    );
    let unsafe_scope = result.world.packages[result.world.unsafe_package.value].scope;
    testing::assert_eq(
        oracle.unsafe_scope.len(),
        result.world.scopes[unsafe_scope.value].entries.len(),
    );
    testing::assert_eq(oracle.package_scope.len(), 1);
    testing::assert_eq(json_string_field(oracle.package_scope[0], "name"), object.name);
    testing::assert_eq(json_string_field(oracle.package_scope[0], "kind"), "Var");
    let oracle_type = json::field(oracle.package_scope[0], "type").unwrap_or(json::Value::Null);
    testing::assert_eq(json_string_field(oracle_type, "text"), "int");
    testing::assert_eq(oracle.defs.len(), result.info.defs.len());
    testing::assert_eq(oracle.uses.len(), result.info.uses.len());
    testing::assert_eq(oracle.types.len(), result.info.types.len());
    let variable_key = testing::expect_some(
        syntax_key_for_object(result, object.id),
        "missing variable node key",
    );
    testing::assert_eq(variable_key, "a.go:$.fields.decls[0].fields.specs[0].fields.names[0]")
}

#[test]
fn extracts_exported_api_without_checking_initializers_or_bodies() -> () {
    let config = default_config();
    config.ignore_func_bodies = true;
    config.exported_api_only = true;
    config.disable_unused_import_check = true;
    let result = check(
        config,
        PackageInput {
            path: "example/p",
            files: Vec::from_array(
                [
                    source_file(
                        "a.go",
                        "package p\nvar Exported = map[string]int{\"bad\": missing}\nvar private = []int{missing}\nfunc Visible() int { return missing }\nfunc hidden() Unknown { return missing }\n",
                    ),
                ],
            ),
        },
    );
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "Exported").type_id),
        "map[string]int",
    );
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "Visible").type_id),
        "func() int",
    )
}

fn syntax_key_for_object(result: CheckResult, object: go_types::ObjectId) -> Option[string] {
    result.world.objects[object.value].node.and_then(|node| syntax::node_key(result.syntax, node))
}

fn package_object(result: CheckResult, name: string) -> go_types::Object {
    let pkg = result.world.packages[result.package_id.value];
    let scope = result.world.scopes[pkg.scope.value];
    for entry in scope.entries {
        if entry.name == name {
            return result.world.objects[entry.object.value]
        }
    }
    testing::fail("missing package object " + name);
    loop {}
}

fn first_file_scope(result: CheckResult) -> go_types::ScopeId {
    for scope in result.world.scopes {
        if scope.kind == go_types::ScopeKind::File {
            return scope.id
        }
    }
    testing::fail("missing file scope");
    loop {}
}

fn oracle_scope_object(response: typecheck_diff::CheckResponse, name: string) -> json::Value {
    for object in response.package_scope {
        if json_string_field(object, "name") == name {
            return object
        }
    }
    testing::fail("missing oracle package object " + name);
    loop {}
}

fn oracle_object_exact(response: typecheck_diff::CheckResponse, name: string) -> string {
    let object = oracle_scope_object(response, name);
    let value = json::field(object, "value").unwrap_or(json::Value::Null);
    json_string_field(value, "exact")
}

#[test]
fn checks_multiple_files_in_one_package() -> () {
    let result = check(
        default_config(),
        PackageInput {
            path: "example/p",
            files: Vec::from_array(
                [
                    source_file("a.go", "package p\nvar X int\n"),
                    source_file("b.go", "package p\nvar Y string\n"),
                ],
            ),
        },
    );
    testing::assert_eq(result.diagnostics.len(), 0);
    let pkg = result.world.packages[result.package_id.value];
    testing::assert_eq(result.world.scopes[pkg.scope.value].entries.len(), 2);
    testing::assert_eq(result.info.scopes.len(), 2);
    testing::assert_eq(result.info.file_versions.len(), 2)
}

#[test]
fn accepts_multiple_init_functions_outside_package_scope() -> () {
    let source = "package p\nvar Count int\nfunc init() { Count++ }\nfunc init() { Count++ }\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    let pkg = result.world.packages[result.package_id.value];
    testing::assert(go_types::lookup_local(result.world, pkg.scope, "init").is_none());
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok)
}

#[test]
fn rejects_type_parameters_and_arguments_on_main() -> () {
    let source = "package main\nfunc main[T any](value T) int { return 0 }\n";
    let result = check(
        default_config(),
        PackageInput { path: "example/main", files: Vec::from_array([source_file("a.go", source)]) },
    );
    testing::assert(result.diagnostics.len() >= 2);
    testing::assert(result.diagnostics[0].message.contains("no type parameters"));
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/main",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(!oracle.ok)
}

#[test]
fn formats_grouped_and_separate_type_parameter_constraints() -> () {
    let source = "package p\ntype Left interface { ~int }\ntype Right interface { ~int }\nfunc Grouped[A, B any]() {}\nfunc Separate[A any, B any]() {}\nfunc Distinct[A Left, B Right]() {}\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "Grouped").type_id),
        "func[A, B any]()",
    );
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "Separate").type_id),
        "func[A, B any]()",
    );
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "Distinct").type_id),
        "func[A example/p.Left, B example/p.Right]()",
    );
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok)
}

#[test]
fn checks_constant_expressions_and_initialized_variables() -> () {
    let source = "package p\nconst A = (1 << 100) + 3\nconst B = A + 2\nconst C float32 = 0.1\nvar X = 7\nvar Y int8 = 127\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    let a = package_object(result, "A");
    let b = package_object(result, "B");
    let c = package_object(result, "C");
    let x = package_object(result, "X");
    let y = package_object(result, "Y");
    testing::assert(a.kind == go_types::ObjectKind::Const);
    testing::assert_eq(a.constant.unwrap_or(""), "1267650600228229401496703205379");
    testing::assert_eq(b.constant.unwrap_or(""), "1267650600228229401496703205381");
    testing::assert_eq(c.constant.unwrap_or(""), "13421773/134217728");
    testing::assert_eq(go_types::format_type(result.world, c.type_id), "float32");
    testing::assert_eq(go_types::format_type(result.world, x.type_id), "int");
    testing::assert_eq(go_types::format_type(result.world, y.type_id), "int8");
    testing::assert_eq(result.info.init_order.len(), 2);
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok);
    testing::assert_eq(oracle_object_exact(oracle, "A"), a.constant.unwrap_or(""));
    testing::assert_eq(oracle_object_exact(oracle, "B"), b.constant.unwrap_or(""));
    testing::assert_eq(oracle_object_exact(oracle, "C"), c.constant.unwrap_or(""))
}

#[test]
fn masks_bitwise_complement_for_typed_unsigned_constants() -> () {
    let source = "package p\nconst Byte = ^uint8(0)\nconst Word = ^uintptr(0)\nconst PointerSize = 4 << (Word >> 63)\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(package_object(result, "Byte").constant.unwrap_or(""), "255");
    testing::assert_eq(
        package_object(result, "Word").constant.unwrap_or(""),
        "18446744073709551615",
    );
    testing::assert_eq(package_object(result, "PointerSize").constant.unwrap_or(""), "8");
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok);
    testing::assert_eq(
        oracle_object_exact(oracle, "Word"),
        package_object(result, "Word").constant.unwrap_or(""),
    )
}

#[test]
fn preserves_nonconstant_shift_operands_through_conversions() -> () {
    let source = "package p\nfunc High(value uint16) byte { return byte(value >> 8) }\nfunc Dynamic(value uint64, amount uint) uint64 { return value << amount }\nfunc Mask(value uint32, left int, right int) uint32 { return value & ((1 << (right - left + 1)) - 1) }\nfunc Untyped(left uint, right uint) int { return (1 << left) + (2 << right) }\nfunc Compound(value uint64, amount uint) uint64 { value <<= amount; value &^= 1; return value }\nfunc Declared(amount uint) uint { var mask uint = (1 << amount) - 1; return mask }\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok)
}

#[test]
fn replaces_provisional_typed_constant_values() -> () {
    let source = "package p\ntype ctrl uint8\nconst (\n    empty ctrl = 0b10000000\n    bits = uint64(empty)\n)\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    let empty = package_object(result, "empty");
    let bits = package_object(result, "bits");
    testing::assert_eq(empty.constant_kind, "Int");
    testing::assert_eq(empty.constant.unwrap_or(""), "128");
    testing::assert_eq(bits.constant_kind, "Int");
    testing::assert_eq(bits.constant.unwrap_or(""), "128");
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok)
}

#[test]
fn checks_elided_nested_composite_literal_types() -> () {
    let source = "package p\ntype Point struct { X int; Y int }\nvar Values = []Point{{X: 1, Y: 2}}\nvar Pointers = []*Point{{3, 4}}\nvar Nested = map[string][]Point{\"p\": {{5, 6}}}\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok)
}

#[test]
fn reports_constant_overflow_and_unrepresentable_initializers() -> () {
    let shifted = check_source("package p\nconst X = 1 << 512\n");
    testing::assert(!shifted.diagnostics.is_empty());
    testing::assert(shifted.diagnostics[0].message.contains("overflow"));
    let narrowed = check_source("package p\nvar X int8 = 128\n");
    testing::assert(!narrowed.diagnostics.is_empty());
    testing::assert(narrowed.diagnostics[0].message.contains("overflows"));
    let divided = check_source("package p\nconst X = 1 / 0\n");
    testing::assert(!divided.diagnostics.is_empty())
}

#[test]
fn resolves_forward_declaration_dependencies_across_files() -> () {
    let result = check(
        default_config(),
        PackageInput {
            path: "example/p",
            files: Vec::from_array(
                [
                    source_file("a.go", "package p\nconst A = B + 1\nvar X = Y\n"),
                    source_file("b.go", "package p\nconst B = 41\nvar Y = 2\n"),
                ],
            ),
        },
    );
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(package_object(result, "A").constant.unwrap_or(""), "42");
    testing::assert_eq(package_object(result, "B").constant.unwrap_or(""), "41");
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "X").type_id),
        "int",
    );
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "Y").type_id),
        "int",
    );
    testing::assert_eq(result.info.init_order.len(), 2)
}

#[test]
fn reports_initialization_cycles_recoverably() -> () {
    let result = check_source("package p\nconst A = B\nconst B = A\n");
    testing::assert(!result.diagnostics.is_empty());
    testing::assert(result.diagnostics[0].message.contains("initialization cycle"));
    testing::assert(result.world.packages[result.package_id.value].complete)
}

#[test]
fn omits_invalid_operands_from_partial_type_info() -> () {
    let result = check_source("package p\nfunc f0() {}\nfunc f() { close(f0()) }\n");
    testing::assert_eq(result.diagnostics.is_empty(), false);
    let mut invalid_facts = 0;
    for fact in result.info.types {
        if fact.value_expr && fact.type_id.value == result.world.invalid.value {
            invalid_facts += 1;
        }
    }
    testing::assert_eq(invalid_facts, 0)
}

#[test]
fn reports_initialization_cycles_through_static_function_and_method_bodies() -> () {
    let source = "package p\ntype Direct struct{}\nfunc (Direct) Value() int { return DirectY }\nvar DirectX = Direct{}\nvar DirectY = DirectX.Value()\nfunc Function() int { return FunctionY }\nvar FunctionY = Function()\ntype Dynamic struct{}\nfunc (Dynamic) Value() int { return DynamicY }\nvar DynamicX interface { Value() int } = Dynamic{}\nvar DynamicY = DynamicX.Value()\n";
    let result = check_source(source);
    let mut cycles = 0;
    for diagnostic in result.diagnostics {
        if diagnostic.message.contains("initialization cycle") {
            cycles += 1;
        }
    }
    testing::assert_eq(cycles, 2);
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(!oracle.ok)
}

#[test]
fn checks_named_alias_and_recursive_slice_types() -> () {
    let source = "package p\ntype Count int\ntype Alias = Count\ntype List []List\nvar C Count\nvar A Alias\nvar L List\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    let count = package_object(result, "Count");
    let alias = package_object(result, "Alias");
    let list = package_object(result, "List");
    testing::assert(count.kind == go_types::ObjectKind::TypeName);
    testing::assert_eq(go_types::format_type(result.world, count.type_id), "example/p.Count");
    testing::assert_eq(go_types::format_type(result.world, alias.type_id), "example/p.Alias");
    testing::assert_eq(go_types::format_type(result.world, list.type_id), "example/p.List");
    match result.world.types[count.type_id.value].kind {
        go_types::TypeKind::Named {
            object: _,
            underlying,
            type_params: _,
            type_args: _,
            methods: _,
        } => {
            testing::assert_eq(go_types::format_type(result.world, underlying), "int")
        },
        _ => testing::fail("Count is not a named type"),
    }
    match result.world.types[alias.type_id.value].kind {
        go_types::TypeKind::Alias { object: _, rhs, type_params: _, type_args: _ } => {
            testing::assert_eq(go_types::format_type(result.world, rhs), "example/p.Count")
        },
        _ => testing::fail("Alias is not an alias type"),
    }
    match result.world.types[list.type_id.value].kind {
        go_types::TypeKind::Named {
            object: _,
            underlying,
            type_params: _,
            type_args: _,
            methods: _,
        } => match result.world.types[underlying.value].kind {
            go_types::TypeKind::Slice { element } => testing::assert_eq(
                element.value,
                list.type_id.value,
            ),
            _ => testing::fail("List does not have slice underlying type"),
        },
        _ => testing::fail("List is not a named type"),
    }
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok);
    testing::assert_eq(oracle.package_scope.len(), 6)
}

#[test]
fn rejects_direct_named_and_array_type_cycles() -> () {
    let direct = check_source("package p\ntype A B\ntype B A\n");
    testing::assert(!direct.diagnostics.is_empty());
    testing::assert(direct.diagnostics[0].message.contains("recursive type"));
    let array = check_source("package p\ntype A [1]A\n");
    testing::assert(!array.diagnostics.is_empty());
    testing::assert(array.diagnostics[0].message.contains("recursive type"))
}

#[test]
fn rejects_recursive_types_exposed_by_unsafe_sizeof() -> () {
    let source = "package p\nimport \"unsafe\"\ntype U interface { V }\ntype V interface { Method() [unsafe.Sizeof(value)]int }\nvar value U\n";
    let result = check_source(source);
    testing::assert(!result.diagnostics.is_empty());
    testing::assert(result.diagnostics[0].message.contains("recursive type"));
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(!oracle.ok)
}

#[test]
fn checks_struct_interface_and_function_declarations_when_bodies_are_ignored() -> () {
    let source = "package p\ntype Node struct { Value int; Next *Node `json:\"next\"` }\ntype Reader interface { Read([]byte) (int, error) }\ntype Callback func(x int, values ...string) (result bool)\nfunc F(x int, y string) (bool, error) { return true, nil }\n";
    let config = default_config();
    config.ignore_func_bodies = true;
    let result = check(
        config,
        PackageInput { path: "example/p", files: Vec::from_array([source_file("a.go", source)]) },
    );
    testing::assert_eq(result.diagnostics.len(), 0);
    let node = package_object(result, "Node");
    let reader = package_object(result, "Reader");
    let callback = package_object(result, "Callback");
    let function = package_object(result, "F");
    testing::assert_eq(go_types::format_type(result.world, node.type_id), "example/p.Node");
    testing::assert_eq(go_types::format_type(result.world, reader.type_id), "example/p.Reader");
    testing::assert_eq(go_types::format_type(result.world, callback.type_id), "example/p.Callback");
    testing::assert_eq(
        go_types::format_type(result.world, function.type_id),
        "func(x int, y string) (bool, error)",
    );
    match result.world.types[node.type_id.value].kind {
        go_types::TypeKind::Named {
            object: _,
            underlying,
            type_params: _,
            type_args: _,
            methods: _,
        } => match result.world.types[underlying.value].kind {
            go_types::TypeKind::Struct { fields } => {
                testing::assert_eq(fields.len(), 2);
                testing::assert_eq(fields[1].tag, "json:\"next\"")
            },
            _ => testing::fail("Node does not have struct underlying type"),
        },
        _ => testing::fail("Node is not named"),
    }
    let oracle_request = typecheck_diff::request(
        "example/p",
        Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
    );
    oracle_request.config.ignore_func_bodies = true;
    let oracle = expect_oracle(typecheck_diff::run_check(oracle_request));
    testing::assert(oracle.ok);
    testing::assert_eq(oracle.package_scope.len(), 4)
}

#[test]
fn rejects_direct_recursive_struct_fields() -> () {
    let result = check_source("package p\ntype Bad struct { value Bad }\n");
    testing::assert(!result.diagnostics.is_empty());
    testing::assert(result.diagnostics[0].message.contains("recursive type"))
}

#[test]
fn resolves_unsafe_import_alias_and_qualified_type() -> () {
    let source = "package p\nimport u \"unsafe\"\nvar X u.Pointer\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    let unsafe_scope = result.world.packages[result.world.unsafe_package.value].scope;
    let pointer = testing::expect_some(
        go_types::lookup_local(result.world, unsafe_scope, "Pointer"),
        "missing unsafe.Pointer",
    );
    testing::assert_eq(
        package_object(result, "X").type_id.value,
        result.world.objects[pointer.value].type_id.value,
    );
    testing::assert_eq(result.info.defs.len(), 3);
    testing::assert_eq(result.info.uses.len(), 2);
    let oracle_request = typecheck_diff::request(
        "example/p",
        Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
    );
    oracle_request.config.ignore_func_bodies = true;
    let oracle = expect_oracle(typecheck_diff::run_check(oracle_request));
    testing::assert(oracle.ok);
    testing::assert_eq(oracle.defs.len(), result.info.defs.len());
    testing::assert_eq(oracle.uses.len(), result.info.uses.len())
}

#[test]
fn reports_unused_imports_and_accepts_blank_imports() -> () {
    let unused = check_source("package p\nimport \"unsafe\"\nvar X int\n");
    testing::assert_eq(unused.diagnostics.len(), 1);
    testing::assert(unused.diagnostics[0].message.contains("not used"));
    testing::assert(unused.diagnostics[0].soft);
    let blank = check_source("package p\nimport _ \"unsafe\"\nvar X int\n");
    testing::assert_eq(blank.diagnostics.len(), 0)
}

#[test]
fn imports_configured_package_identities() -> () {
    let config = default_config();
    config.available_imports.push(AvailableImport { path: "example/q", name: "q" });
    config.disable_unused_import_check = true;
    let result = check(
        config,
        PackageInput {
            path: "example/p",
            files: Vec::from_array(
                [source_file("a.go", "package p\nimport renamed \"example/q\"\n")],
            ),
        },
    );
    testing::assert_eq(result.diagnostics.len(), 0);
    let file_scope = first_file_scope(result);
    let object = testing::expect_some(
        go_types::lookup_local(result.world, file_scope, "renamed"),
        "missing import binding",
    );
    let imported = testing::expect_some(
        result.world.objects[object.value].imported_package,
        "missing imported package identity",
    );
    testing::assert_eq(result.world.packages[imported.value].path, "example/q")
}

#[test]
fn checks_imported_packages_in_a_shared_type_world() -> () {
    let world = go_types::new_world();
    let dependency = check_package_in_world(
        default_config(),
        PackageInput {
            path: "example/q",
            files: Vec::from_array(
                [
                    source_file(
                        "q.go",
                        "package q\ntype Number int\nconst Value Number = 1\nvar Mutable Number\nfunc Identity(value Number) Number { return value }\n",
                    ),
                ],
            ),
        },
        world,
    );
    testing::assert_eq(dependency.diagnostics.len(), 0);
    let source = "package p\nimport \"example/q\"\nvar Value = q.Identity(q.Value)\nconst Sum = q.Value + 1\nfunc Set() { q.Mutable = q.Value }\n";
    let result = check_package_in_world(
        default_config(),
        PackageInput { path: "example/p", files: Vec::from_array([source_file("p.go", source)]) },
        dependency.world,
    );
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "Value").type_id),
        "example/q.Number",
    );
    testing::assert_eq(package_object(result, "Sum").constant.unwrap_or(""), "2");
    let q = testing::expect_some(
        {
            let mut result_id: Option[go_types::PackageId] = Option::None;
            for pkg in result.world.packages {
                if pkg.path == "example/q" {
                    result_id = Option::Some(pkg.id);
                }
            }
            result_id
        },
        "missing dependency package",
    );
    testing::assert(result.world.packages[q.value].complete)
}

#[test]
fn evaluates_iota_and_inherited_const_expressions() -> () {
    let source = "package p\nconst (\nA = iota\nB\nC = 1 << iota\nD\nE int8 = iota\nF\n)\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(package_object(result, "A").constant.unwrap_or(""), "0");
    testing::assert_eq(package_object(result, "B").constant.unwrap_or(""), "1");
    testing::assert_eq(package_object(result, "C").constant.unwrap_or(""), "4");
    testing::assert_eq(package_object(result, "D").constant.unwrap_or(""), "8");
    testing::assert_eq(package_object(result, "E").constant.unwrap_or(""), "4");
    testing::assert_eq(package_object(result, "F").constant.unwrap_or(""), "5");
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "F").type_id),
        "int8",
    );
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok);
    for name in Vec::from_array(["A", "B", "C", "D", "E", "F"]) {
        testing::assert_eq(
            oracle_object_exact(oracle, name),
            package_object(result, name).constant.unwrap_or(""),
        )
    }
}

