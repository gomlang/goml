#[test]
fn checks_type_set_operations_intersections_and_comparability() -> () {
    let source = "package p\ntype MyInt int\ntype MyString string\ntype E0 interface { ~int | ~bool | ~string }\ntype E1 interface { ~int | ~float64 | ~string }\nfunc AddOne[T interface { MyInt }](value T) T { return value + 1 }\nfunc Double[T interface { MyInt | MyString }](value T) T { return value + value }\nfunc Shared[T interface { E0; E1 }](value T) T { return value }\nfunc Equal[T interface { ~int | ~string }](left T, right T) bool { return left == right }\nfunc EqualAny[T comparable](left T, right T) bool { return left == right }\nfunc Nonzero[T interface { ~float32 | ~float64 }](value T) bool { return value != 0 }\nvar A = AddOne(MyInt(2))\nvar B = Double(MyString(\"go\"))\nvar C = Shared(3)\nvar D = Shared(\"text\")\nvar E = Equal(1, 2)\nvar F = EqualAny(1, 2)\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "A").type_id),
        "example/p.MyInt",
    );
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "B").type_id),
        "example/p.MyString",
    );
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok)
}

#[test]
fn checks_core_types_for_generic_containers_and_channels() -> () {
    let source = "package p\nfunc First[S ~[]E, E any](values S) E { return values[0] }\nfunc Tail[S ~[]E, E any](values S) S { return values[1:] }\nfunc NilSlice[S ~[]E, E any]() S { return nil }\nfunc Count[S ~[]E, E any](values S) int { return len(values) }\nfunc Length[T string | []byte](value T) int { return len(value) }\nfunc ByteAt[T string | []byte](value T, index int) byte { return value[index] }\nfunc Prefix[T string | []byte](value T, end int) string { return string(value[:end]) }\nfunc ForwardLength[T string | []byte](value T) int { return Length(value) }\nfunc Capacity[T ~[3]int | ~[3]byte](value T) int { return cap(value) }\nfunc DynamicCapacity[T ~chan int | ~[]int](value T) int { return cap(value) }\nfunc Last[S ~[]E, E any](values S) E { var result E; for _, value := range values { result = value }; return result }\nfunc Lookup[M ~map[K]V, K comparable, V any](values M, key K) (V, bool) { value, ok := values[key]; return value, ok }\nfunc Send[C ~chan E, E any](channel C, value E) { channel <- value }\nfunc Receive[C ~chan E, E any](channel C) E { return <-channel }\nfunc Mixed[A, B, C any](A, B, C) {}\nfunc UseChannel(channel chan int) int { Send(channel, 1); return Receive(channel) }\nfunc UsePartial() { Mixed[int, string](0, \"\", false); Mixed[int](0, \"\", false); _ = First[[]int] }\nvar Values = []int{1, 2, 3}\nvar Mapping = map[string]int{\"one\": 1}\nvar A = First(Values)\nvar B = Tail(Values)\nvar C = Count(Values)\nvar D = Last(Values)\nvar E, OK = Lookup(Mapping, \"one\")\nvar Partial = First[[]int](Values)\nvar PartialValue, PartialOK = Lookup[map[string]int](Mapping, \"one\")\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "A").type_id),
        "int",
    );
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "B").type_id),
        "[]int",
    );
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok)
}

#[test]
fn infers_generic_functions_from_assignment_return_and_argument_contexts() -> () {
    let source = "package p\nfunc F1[P any](P) {}\nfunc F2[P any]() P { var value P; return value }\nfunc F3[P, Q any](P) Q { var value Q; return value }\nfunc F5[P any](P) []P { return nil }\nvar V1 func(int) = F1\nvar V2 func() int = F2\nvar V3 func(int) string = F3\nvar V4 func(string) []string = F5\nfunc Returned() func(int) { return F1 }\nfunc Apply(function func(int), value int) { function(value) }\nfunc Use() { Apply(F1, 1); var local func(string) []string = F5; _ = local(\"x\") }\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "V3").type_id),
        "func(int) string",
    );
    testing::assert(result.info.instances.len() >= 6);
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok);
    let old_config = default_config();
    old_config.go_version = "go1.20";
    let old = check(
        old_config,
        PackageInput { path: "example/p", files: Vec::from_array([source_file("a.go", source)]) },
    );
    testing::assert(!old.diagnostics.is_empty())
}

