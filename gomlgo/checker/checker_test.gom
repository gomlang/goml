#[test]
fn permits_repeated_blank_declarations_without_scope_bindings() -> () {
    let source = "package p\ntype _ = int\ntype _[P any] = int\nvar _ = 1\nvar _ = 2\nfunc _() {}\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    let pkg = result.world.packages[result.package_id.value];
    testing::assert(go_types::lookup_local(result.world, pkg.scope, "_").is_none());
    let mut blanks = 0;
    for fact in result.info.defs {
        match fact.object {
            Some(object) => if result.world.objects[object.value].name == "_" {
                blanks += 1;
            },
            None => {},
        }
    }
    testing::assert_eq(blanks, 5);
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok)
}

