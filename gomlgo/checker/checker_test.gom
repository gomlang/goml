#[test]
fn checks_generic_receiver_methods_and_instantiated_method_selection() -> () {
    let source = "package p\ntype Box[T any] struct { Value T }\ntype Wrapper[T any] struct { Box[T] }\nfunc (box Box[T]) Get() T { return box.Value }\nfunc (box *Box[T]) Set(value T) { box.Value = value }\nvar Number = Box[int]{Value: 4}.Get()\nvar Wrapped = Wrapper[int]{Box: Box[int]{Value: 5}}.Get()\nfunc Use() int {\n    box := Box[int]{Value: 1}\n    box.Set(9)\n    return box.Get()\n}\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "Number").type_id),
        "int",
    );
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "Wrapped").type_id),
        "int",
    );
    testing::assert(result.info.selections.len() >= 5);
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok)
}

#[test]
fn checks_value_and_pointer_method_expressions() -> () {
    let source = "package p\ntype Counter int\nfunc (value Counter) Add(other int) int { return int(value) + other }\nfunc (value *Counter) Set(other int) { *value = Counter(other) }\nfunc (value *Counter) Reset() { *value = 0 }\nvar Add = Counter.Add\nvar Set = (*Counter).Set\nvar Reset = (*Counter).Reset\nfunc Use() int {\n    value := Counter(1)\n    Set(&value, 4)\n    Reset(&value)\n    return Add(value, 2)\n}\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, UNSAFE_ADD_BUILTIN).type_id),
        "func(value example/p.Counter, other int) int",
    );
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "Set").type_id),
        "func(value *example/p.Counter, other int)",
    );
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "Reset").type_id),
        "func(*example/p.Counter)",
    );
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok)
}

