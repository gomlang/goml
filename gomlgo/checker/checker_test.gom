#[test]
fn checks_multi_value_calls_and_comma_ok_assignments() -> () {
    let source = "package p\nfunc Pair() (int, string) { return 1, \"one\" }\nfunc Consume(number int, text string) {}\nfunc Use(values map[string]int, channel chan int, input any) {\n    number, text := Pair()\n    Consume(number, text)\n    Consume(Pair())\n    mapped, mapOk := values[\"one\"]\n    received, receiveOk := <-channel\n    asserted, assertOk := input.(int)\n    var other, otherOk = values[\"two\"]\n    _, _, _, _, _, _, _, _ = mapped, mapOk, received, receiveOk, asserted, assertOk, other, otherOk\n}\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    let mut comma_ok = 0;
    for fact in result.info.types {
        if fact.comma_ok {
            comma_ok += 1;
            match go_types::get_type(result.world, fact.type_id) {
                Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Tuple { variables } }) => {
                    testing::assert_eq(variables.len(), 2);
                    testing::assert_eq(
                        go_types::format_type(result.world, variables[1].type_id),
                        "bool",
                    )
                },
                _ => testing::assert(false),
            }
        }
    }
    testing::assert(comma_ok >= 4);
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok)
}

#[test]
fn checks_package_multi_value_initializers() -> () {
    let source = "package p\nfunc Pair() (int, string) { return 1, \"one\" }\nvar Number, Text = Pair()\nvar Values = map[string]int{\"one\": 1}\nvar Mapped, Present = Values[\"one\"]\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "Number").type_id),
        "int",
    );
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "Text").type_id),
        "string",
    );
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "Mapped").type_id),
        "int",
    );
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "Present").type_id),
        "bool",
    );
    testing::assert_eq(result.info.init_order.len(), 3);
    testing::assert_eq(result.info.init_order[0].left.len(), 2);
    testing::assert_eq(result.info.init_order[2].left.len(), 2);
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok);
    testing::assert_eq(oracle.init_order.len(), result.info.init_order.len())
}

#[test]
fn orders_initializers_by_dependencies_and_source_position() -> () {
    let source = "package p\nvar A = value()\nvar B = 1\nvar C = 2\nfunc value() int { return C }\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(result.info.init_order.len(), 3);
    let expected = Vec::from_array(["B", "C", "A"]);
    for index in 0..expected.len() {
        let object = go_types::get_object(result.world, result.info.init_order[index].left[0]);
        testing::assert_eq(
            match object {
                Some(value) => value.name,
                None => "",
            },
            expected[index],
        )
    }
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok);
    testing::assert_eq(oracle.init_order.len(), result.info.init_order.len())
}

#[test]
fn checks_pointer_slice_map_and_channel_type_expressions() -> () {
    let result = check_source(
        "package p\nvar A *int\nvar B []string\nvar C map[string]int\nvar D chan int\n",
    );
    testing::assert_eq(result.diagnostics.len(), 0);
    let pkg = result.world.packages[result.package_id.value];
    let scope = result.world.scopes[pkg.scope.value];
    testing::assert_eq(scope.entries.len(), 4);
    let expected = Vec::from_array(["*int", "[]string", "map[string]int", "chan int"]);
    for index in 0..scope.entries.len() {
        let object = result.world.objects[scope.entries[index].object.value];
        testing::assert_eq(go_types::format_type(result.world, object.type_id), expected[index])
    }
}

#[test]
fn checks_goto_block_and_variable_declaration_restrictions() -> () {
    let valid_source = "package p\nfunc Valid(flag bool) {\n    if flag { goto Done }\n    { goto Done }\n    if value := 1; value > 0 {}\n    switch value := 1; value {}\n    for value := 0; value < 1; value++ {}\nDone:\n}\n";
    let valid = check_source(valid_source);
    testing::assert_eq(valid.diagnostics.len(), 0);
    let valid_oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source: valid_source }]),
            ),
        ),
    );
    testing::assert(valid_oracle.ok);
    let invalid_source = "package p\nfunc Skip() {\n    goto Label\n    value := 1\nLabel:\n    _ = value\n}\nfunc Enter() {\n    goto Inside\n    {\nInside:\n    }\n}\n";
    let invalid = check_source(invalid_source);
    let mut skipped_declaration = false;
    let mut entered_block = false;
    for diagnostic in invalid.diagnostics {
        if diagnostic.message.contains("jumps over variable declaration") {
            skipped_declaration = true;
        } else if diagnostic.message.contains("jumps into block") {
            entered_block = true;
        }
    }
    testing::assert(skipped_declaration);
    testing::assert(entered_block);
    let invalid_oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array(
                    [typecheck_diff::SourceFile { name: "a.go", source: invalid_source }],
                ),
            ),
        ),
    );
    testing::assert(!invalid_oracle.ok)
}

#[test]
fn reports_package_name_mismatch_and_duplicate_declaration() -> () {
    let result = check(
        default_config(),
        PackageInput {
            path: "example/p",
            files: Vec::from_array(
                [
                    source_file("a.go", "package p\nvar X int\n"),
                    source_file("b.go", "package q\nvar X int\n"),
                ],
            ),
        },
    );
    testing::assert_eq(result.diagnostics.len(), 3);
    testing::assert(result.diagnostics[0].message.contains("expected package p"));
    testing::assert(result.diagnostics[1].message.contains("redeclared"));
    testing::assert(result.diagnostics[2].secondary);
    testing::assert(result.world.packages[result.package_id.value].complete)
}

#[test]
fn rejects_blank_package_names() -> () {
