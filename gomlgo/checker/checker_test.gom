#[test]
fn reports_unused_locals_independently_in_nested_functions() -> () {
    let source = "package p\nfunc Bad() {\n    outer := 1\n    var other string\n    _ = func() { inner := 2 }\n}\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 3);
    let mut outer = false;
    let mut other = false;
    let mut inner = false;
    for diagnostic in result.diagnostics {
        if diagnostic.message.contains("outer") {
            outer = true;
        } else if diagnostic.message.contains("other") {
            other = true;
        } else if diagnostic.message.contains("inner") {
            inner = true;
        }
    }
    testing::assert(outer && other && inner);
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(!oracle.ok)
}

