#[test]
fn preserves_typed_constant_sequence_indices() -> () {
    let source = "package p\ntype Index int\nconst First Index = 1\nvar Values = []int{First: 10}\nvar Slice = make([]int, First)\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    let mut found = false;
    let mut make_found = false;
    for fact in result.info.types {
        let key = syntax::node_key(result.syntax, fact.node).unwrap_or("");
        if key.ends_with(".fields.elts[0].fields.key") {
            testing::assert_eq(go_types::format_type(result.world, fact.type_id), "example/p.Index");
            found = true;
        } else if key.ends_with(".fields.decls[3].fields.specs[0].fields.values[0].fields.args[1]") {
            testing::assert_eq(go_types::format_type(result.world, fact.type_id), "example/p.Index");
            make_found = true;
        }
    }
    testing::assert(found);
    testing::assert(make_found)
}

#[test]
fn checks_unsafe_builtins_and_gc_layout_constants() -> () {
    let source = "package p\nimport \"unsafe\"\ntype Layout struct { Flag byte; Count int64; Empty struct{} }\ntype StringPointer *byte\nvar Value Layout\nconst Size = unsafe.Sizeof(Value)\nconst Alignment = unsafe.Alignof(Value)\nconst Offset = unsafe.Offsetof(Value.Count)\nvar Bytes = []byte{1, 2}\nvar BytePointer = unsafe.SliceData(Bytes)\nvar Text = unsafe.String(BytePointer, len(Bytes))\nvar TextPointer = unsafe.StringData(Text)\nvar Raw unsafe.Pointer\nvar IsNil = Raw == nil\nvar Next = unsafe.Add(Raw, 1)\nvar View = unsafe.Slice(BytePointer, 2)\nfunc ByteAt(pointer unsafe.Pointer) *uint8 { return &(*[8]uint8)(pointer)[0] }\nfunc NamedString(pointer StringPointer, length uint64) string { return unsafe.String(pointer, length) }\nfunc GenericSize[T any](value T) uintptr { return unsafe.Sizeof(value) }\nfunc Recursive[T any](_ [unsafe.Sizeof(Recursive[int])]T) {}\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(package_object(result, "Size").constant.unwrap_or(""), "24");
    testing::assert_eq(package_object(result, "Alignment").constant.unwrap_or(""), "8");
    testing::assert_eq(package_object(result, "Offset").constant.unwrap_or(""), "8");
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "View").type_id),
        "[]byte",
    );
    let mut invalid_builtins = 0;
    let mut generic_size = false;
    for fact in result.info.types {
        if fact.builtin && fact.type_id.value == result.world.invalid.value {
            invalid_builtins += 1;
        } else if fact.builtin
            && go_types::format_type(result.world, fact.type_id) == "func(T) uintptr" {
            generic_size = true;
        }
    }
    if invalid_builtins < 4 {
        testing::fail("invalid unsafe builtin facts not found")
    }
    if !generic_size {
        testing::fail("generic unsafe.Sizeof signature not found")
    }
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok)
}

#[test]
fn checks_nonconstant_slice_unsafe_and_type_set_conversions() -> () {
    let source = "package p\nimport \"unsafe\"\ntype Small interface { ~int8 | ~int16 }\ntype Source interface { ~int | ~string }\ntype Text interface { ~string }\nfunc Constant[P Small]() P { return P(1) }\nfunc Runtime[P Small](value int) P { return P(value) }\nfunc Cross[S Source, T Text](value S) T { return T(value) }\nfunc ToAny[P any](value P) any { return any(value) }\nvar Dynamic = any(1)\nvar Bytes = []byte(\"go\")\nvar TextValue = string([]rune{'g', 'o'})\nvar Array = [2]byte(Bytes)\nvar ArrayPointer = (*[2]byte)(Bytes)\nfunc Pointers(pointer *int, word uintptr) (unsafe.Pointer, *int, uintptr) {\n    raw := unsafe.Pointer(pointer)\n    return raw, (*int)(raw), uintptr(raw)\n}\n";
    let result = check_source(source);
    if !result.diagnostics.is_empty() {
        testing::fail(result.diagnostics[0].message)
    }
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "Dynamic").type_id),
        "any",
    );
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "Array").type_id),
        "[2]byte",
    );
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    if !oracle.ok {
        testing::fail(oracle.diagnostics[0].message)
    }
    testing::assert(oracle.ok);
    let invalid_source = "package p\ntype Mixed interface { ~int | ~[]byte }\nfunc Bad[P Mixed]() P { return P(1) }\n";
    let invalid = check_source(invalid_source);
    testing::assert(!invalid.diagnostics.is_empty());
    let invalid_oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array(
                    [typecheck_diff::SourceFile { name: "a.go", source: invalid_source }],
                ),
            ),
        ),
    );
    testing::assert(!invalid_oracle.ok)
}

#[test]
fn gates_slice_array_conversions_by_go_version() -> () {
    let array_source = "package p\nfunc Convert(values []int) [2]int { return [2]int(values) }\n";
    let array_config = default_config();
    array_config.go_version = "go1.19";
    let array_result = check(
        array_config,
        PackageInput {
            path: "example/p",
            files: Vec::from_array([source_file("a.go", array_source)]),
        },
    );
    testing::assert(!array_result.diagnostics.is_empty());
    testing::assert(array_result.diagnostics[0].message.contains("go1.20"));
    let pointer_source = "package p\nfunc Convert(values []int) *[2]int { return (*[2]int)(values) }\n";
    let pointer_config = default_config();
    pointer_config.go_version = "go1.16";
    let pointer_result = check(
        pointer_config,
        PackageInput {
            path: "example/p",
            files: Vec::from_array([source_file("a.go", pointer_source)]),
        },
    );
    testing::assert(!pointer_result.diagnostics.is_empty());
    testing::assert(pointer_result.diagnostics[0].message.contains("go1.17"));
    let tagged_source = "//go:build go1.19\npackage p\ntype Slice []byte\ntype Array [8]byte\nvar Value = Array(Slice(nil))\n";
    let tagged = check_source(tagged_source);
    testing::assert_eq(tagged.diagnostics.len(), 0);
    testing::assert_eq(tagged.info.file_versions[0].version, "go1.21");
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array(
                    [typecheck_diff::SourceFile { name: "a.go", source: tagged_source }],
                ),
            ),
        ),
    );
    testing::assert(oracle.ok)
}

#[test]
fn gates_go126_new_expression_by_effective_file_version() -> () {
    let source = "package p\nvar Pointer = new(1)\n";
    let current = check_source(source);
    testing::assert_eq(current.diagnostics.len(), 0);
    testing::assert_eq(
        go_types::format_type(current.world, package_object(current, "Pointer").type_id),
        "*int",
    );
    let old_config = default_config();
    old_config.go_version = "go1.25";
    let old = check(
        old_config,
        PackageInput { path: "example/p", files: Vec::from_array([source_file("a.go", source)]) },
    );
    testing::assert_eq(old.diagnostics.len(), 1);
    testing::assert(old.diagnostics[0].message.contains("requires go1.26"))
}

#[test]
fn checks_range_channel_send_receive_go_and_defer_statements() -> () {
    let source = "package p\nfunc Flow(values []int, channel chan int) int {\n    total := 0\n    for index, value := range values {\n        total += index + value\n    }\n    for index := range 3 {\n        total += index\n    }\n    channel <- total\n    received := <-channel\n    go println(received)\n    defer close(channel)\n    defer copy(values, values)\n    return received\n}\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok)
}

