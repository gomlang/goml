#[test]
fn checks_range_over_function_yield_signatures() -> () {
    let source = "package p\nfunc Iterate(yield func(int, string) bool) {\n    if !yield(1, \"one\") { return }\n    yield(2, \"two\")\n}\nfunc Empty(yield func() bool) { yield() }\nfunc Use() int {\n    total := 0\n    for number, text := range Iterate {\n        total += number + len(text)\n    }\n    for range Empty { total++ }\n    return total\n}\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
