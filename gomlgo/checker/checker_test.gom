}

#[test]
fn checks_container_memory_and_side_effect_builtins() -> () {
    let source = "package p\nfunc Builtins(values []int, items map[string]int, channel chan int) (*int, int) {\n    values = append(values, 1, 2)\n    copied := make([]int, len(values))\n    count := copy(copied, values)\n    delete(items, \"missing\")\n    clear(items)\n    close(channel)\n    pointer := new(count)\n    println(count)\n    return pointer, cap(copied)\n}\nfunc AppendText(buffer []byte, text string) []byte {\n    buffer = append(buffer, \"prefix\"...)\n    return append(buffer, text...)\n}\nfunc AppendGeneric[Bytes []byte | string](buffer []byte, values Bytes) []byte { return append(buffer, values...) }\nfunc AppendSlice[S ~[]E, E any](slice S, values S) S { return append(slice, values...) }\nfunc CopyText(buffer []byte) int { return copy(buffer, \"text\") }\nfunc DeleteAny(items map[any]int, pointer *int) { delete(items, pointer) }\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    let mut delete_found = false;
    let mut generic_append_found = false;
    let mut slice_append_found = false;
    for fact in result.info.types {
        if fact.builtin
            && go_types::format_type(result.world, fact.type_id) == "func(map[any]int, any)" {
            delete_found = true;
        } else if fact.builtin
            && go_types::format_type(result.world, fact.type_id) == "func([]byte, Bytes...) []byte" {
            generic_append_found = true;
        } else if fact.builtin
            && go_types::format_type(result.world, fact.type_id) == "func(S, ...E) S" {
            slice_append_found = true;
        }
    }
    if !delete_found {
        testing::fail("delete builtin signature not found")
    }
    if !generic_append_found {
        testing::fail("generic append builtin signature not found")
    }
    if !slice_append_found {
        testing::fail("slice append builtin signature not found")
    }
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok)
}

#[test]
fn permits_slicing_pointer_to_array_values() -> () {
    let source = "package p\nfunc Slice(pointer *[4]int) []int { return pointer[:] }\nfunc Array() [4]int { return [4]int{} }\nfunc Invalid() []int { return Array()[:] }\n";
    let result = check_source(source);
    let mut unaddressable = false;
    for diagnostic in result.diagnostics {
        if diagnostic.message.contains("slice of unaddressable array") {
            unaddressable = true;
        }
    }
    testing::assert(unaddressable);
    let valid_source = "package p\nfunc Slice(pointer *[4]int) []int { return pointer[:] }\n";
    let valid = check_source(valid_source);
    testing::assert_eq(valid.diagnostics.len(), 0);
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source: valid_source }]),
            ),
        ),
    );
    testing::assert(oracle.ok)
}

#[test]
fn checks_complex_real_and_imag_builtins() -> () {
    let source = "package p\nconst Value = complex(1.5, 2)\nconst Real = real(Value)\nconst Imaginary = imag(Value)\nvar Small = complex(float32(1), float32(2))\nvar Component = real(Small)\nfunc Runtime(value float64) complex128 { return complex(value, 0) }\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "Value").type_id),
        "untyped complex",
    );
    testing::assert_eq(package_object(result, "Real").constant.unwrap_or(""), "3/2");
    testing::assert_eq(package_object(result, "Imaginary").constant.unwrap_or(""), "2");
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "Small").type_id),
        "complex64",
    );
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "Component").type_id),
        "float32",
    );
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok)
}

#[test]
fn folds_constant_min_and_max_builtins() -> () {
    let source = "package p\nconst Smallest = min(9, -3, 4)\nconst Largest = max(\"a\", \"z\", \"m\")\nconst Rounded = max(float32(1), 1.25)\nvar Input int\nvar Dynamic = min(Input, Smallest)\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(package_object(result, "Smallest").constant.unwrap_or(""), "-3");
    testing::assert_eq(package_object(result, "Largest").constant.unwrap_or(""), "\"z\"");
    testing::assert_eq(package_object(result, "Rounded").constant.unwrap_or(""), "5/4");
    testing::assert_eq(
        go_types::format_type(result.world, package_object(result, "Rounded").type_id),
        "float32",
    );
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok)
}

#[test]
fn checks_nil_comparisons_and_type_info_operand_modes() -> () {
    let source = "package p\nfunc Sink() {}\nfunc Nil(pointer *int, slice []int, mapping map[string]int, channel chan int, function func(), value any) bool { Sink(); println(pointer); return pointer == nil && nil != slice && mapping == nil && channel != nil && function == nil && value != nil }\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    let mut nil_values = 0;
    let mut void_values = 0;
    for fact in result.info.types {
        if fact.nil {
            nil_values += 1;
        }
        if fact.void {
            void_values += 1;
        }
    }
    testing::assert_eq(nil_values, 6);
    testing::assert_eq(void_values, 2);
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok)
}

#[test]
fn defaults_untyped_print_arguments() -> () {
    let source = "package p\nfunc Print() { println(\"text\", 1, 'r') }\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    let actual: Vec[string] = Vec::new();
    for fact in result.info.types {
        let key = syntax::node_key(result.syntax, fact.node).unwrap_or("");
        if key.contains(".fields.args[") && !fact.builtin {
            actual.push(go_types::format_type(result.world, fact.type_id))
        }
    }
    testing::assert_eq(actual.len(), 3);
    testing::assert_eq(actual[0], "string");
    testing::assert_eq(actual[1], "int");
    testing::assert_eq(actual[2], "rune")
}

#[test]
fn checks_interface_and_concrete_comparisons() -> () {
