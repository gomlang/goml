}

#[test]
fn checks_expression_type_switch_and_select_scopes() -> () {
    let source = "package p\nfunc Choose(input any, number int, channel chan int) int {\n    switch number {\n    case 0:\n        number = 1\n    case 1, 2:\n        number = 2\n    default:\n        number = 3\n    }\n    switch value := input.(type) {\n    case int:\n        number += value\n    case string:\n        number += len(value)\n    case nil:\n        number = 0\n    default:\n        number = -1\n    }\n    select {\n    case channel <- number:\n    case received := <-channel:\n        number = received\n    default:\n    }\n    return number\n}\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    let mut nil_facts = 0;
    for fact in result.info.types {
        if fact.nil {
            nil_facts += 1;
        }
    }
    testing::assert_eq(nil_facts, 1);
    let mut guard_definition = false;
    for fact in result.info.defs {
        let key = syntax::node_key(result.syntax, fact.node).unwrap_or("");
        if key.ends_with(".fields.assign.fields.lhs[0]") {
            testing::assert(fact.object.is_none());
            guard_definition = true;
        }
    }
    testing::assert(guard_definition);
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok)
}

#[test]
fn checks_generic_named_type_instantiation_substitution_and_union_constraints() -> () {
    let source = "package p\ntype Pair[A, B any] struct { First A; Second B }\ntype Numbers[T ~int | ~int64] []T\nvar PairValue = Pair[int, string]{First: 1, Second: \"value\"}\nvar Values = Numbers[int]{1, 2, 3}\n";
