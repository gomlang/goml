            ),
        ),
    );
    testing::assert(oracle.ok)
}

#[test]
fn preserves_constant_kinds_during_contextual_typing_and_string_conversion() -> () {
    let source = "package p\nconst RuneError = 65533\nvar ErrorRune = []byte(string(RuneError))\nfunc Nanoseconds(ts int64) int64 { const ticks = 1e7; return (1e9 / ticks) * (ts % ticks) }\nconst Rounded = float32(16777217)\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    let mut division_found = false;
    let mut rune_found = false;
    let mut conversion_found = false;
    for fact in result.info.types {
        let key = syntax::node_key(result.syntax, fact.node).unwrap_or("");
        if key.ends_with(
            ".fields.decls[2].fields.body.fields.list[1].fields.results[0].fields.x.fields.x",
        ) {
            testing::assert_eq(go_types::format_type(result.world, fact.type_id), "int64");
            testing::assert_eq(type_fact_constant_kind(fact), "Float");
            testing::assert_eq(type_fact_constant(fact).unwrap_or(""), "100");
            division_found = true;
        } else if key.ends_with(
            ".fields.decls[1].fields.specs[0].fields.values[0].fields.args[0].fields.args[0]",
        ) {
            testing::assert_eq(go_types::format_type(result.world, fact.type_id), "untyped int");
            testing::assert_eq(type_fact_constant_kind(fact), "Int");
            rune_found = true;
        } else if key.ends_with(".fields.decls[3].fields.specs[0].fields.values[0].fields.args[0]") {
            testing::assert_eq(go_types::format_type(result.world, fact.type_id), "float32");
            testing::assert_eq(type_fact_constant_kind(fact), "Int");
            testing::assert_eq(type_fact_constant(fact).unwrap_or(""), "16777217");
            conversion_found = true;
        }
    }
    testing::assert(division_found);
    testing::assert(rune_found);
    testing::assert(conversion_found)
}

#[test]
fn preserves_explicit_integer_complex_constant_values() -> () {
    let source = "package p\nfunc Use() { const Value int = complex(1, 0); const _ int = complex(1, 0); _ = Value }\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    let mut found = 0;
    for object in result.world.objects {
        if object.kind == go_types::ObjectKind::Const
            && (object.name == "Value" || object.name == "_") {
            testing::assert_eq(object.constant_kind, "Int");
            testing::assert_eq(object.constant.unwrap_or(""), "1");
            found += 1;
        }
    }
    testing::assert_eq(found, 2)
}

#[test]
fn promotes_untyped_binary_operands_to_the_common_numeric_type() -> () {
    let source = "package p\nconst Rune = 'a' - 26\nconst Float = 1 + 2.5\nconst Shifted = 1.0 / (1 << 28)\nconst NamedInt = 1\nconst Nested = 1.0 + (NamedInt + NamedInt)\nfunc RoundedBinary() float64 { return float64(1 << 47) / 1e9 }\n";
    let result = check_source(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    let mut rune_found = false;
    let mut float_found = false;
    for fact in result.info.types {
        let key = syntax::node_key(result.syntax, fact.node).unwrap_or("");
        if key.ends_with(".fields.decls[0].fields.specs[0].fields.values[0].fields.y") {
            testing::assert_eq(go_types::format_type(result.world, fact.type_id), "untyped rune");
            rune_found = true;
        } else if key.ends_with(".fields.decls[1].fields.specs[0].fields.values[0].fields.x") {
            testing::assert_eq(go_types::format_type(result.world, fact.type_id), "untyped float");
            float_found = true;
        }
    }
    testing::assert(rune_found);
    testing::assert(float_found);
    let oracle = expect_oracle(
        typecheck_diff::run_check(
            typecheck_diff::request(
                "example/p",
                Vec::from_array([typecheck_diff::SourceFile { name: "a.go", source }]),
            ),
        ),
    );
    testing::assert(oracle.ok)
}

