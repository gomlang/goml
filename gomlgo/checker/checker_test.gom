#[test]
fn preserves_parser_diagnostics_and_partial_semantic_facts() -> () {
    let result = check_source("package p\nvar X int\nvar Y\n");
    testing::assert(!result.diagnostics.is_empty());
    let pkg = result.world.packages[result.package_id.value];
    testing::assert(result.world.scopes[pkg.scope.value].entries.len() >= 1);
    testing::assert(pkg.complete)
}

#[test]
fn type_fact_source_index_preserves_first_values_across_growth() -> () {
    let index = empty_type_fact_source_index();
    for value in 0..256 {
        let key = TypeFactSourceKey { file: 0, start: value.to_i32(), end: (value + 1).to_i32() };
        insert_type_fact_source(index, key, value);
        insert_type_fact_source(index, key, -1)
    }
    let negative_start = TypeFactSourceKey { file: 0, start: -1, end: 0 };
    let negative_end = TypeFactSourceKey { file: 0, start: 0, end: -1 };
    insert_type_fact_source(index, negative_start, 1001);
    insert_type_fact_source(index, negative_end, 1002);
    testing::assert_eq(find_type_fact_source(index, negative_start).unwrap_or(-1), 1001);
    testing::assert_eq(find_type_fact_source(index, negative_end).unwrap_or(-1), 1002);
    let other_file = TypeFactSourceKey { file: 1, start: 0, end: 1 };
    insert_type_fact_source(index, other_file, 999);
    for value in 0..256 {
        let key = TypeFactSourceKey { file: 0, start: value.to_i32(), end: (value + 1).to_i32() };
        testing::assert_eq(find_type_fact_source(index, key).unwrap_or(-1), value)
    }
    testing::assert_eq(find_type_fact_source(index, other_file).unwrap_or(-1), 999);
    testing::assert(
        find_type_fact_source(index, TypeFactSourceKey { file: 2, start: 0, end: 1 }).is_none(),
    )
}

#[test]
fn type_fact_constants_preserve_independent_values() -> () {
    let original = constant::integer_from_int64(123);
    let extra = type_fact_value_extra(constant::ConstValue::Int(original));
    let fact = TypeFact {
        node: syntax::node_id(0),
        type_id: go_types::type_id(0),
        extra,
        void: false,
        type_expr: false,
        builtin: false,
        value_expr: true,
        nil: false,
        addressable: false,
        assignable: false,
        comma_ok: false,
    };
    original.magnitude.limbs[0] = 456.to_u32();
    testing::assert(type_fact_has_constant(fact));
    testing::assert_eq(type_fact_constant_kind(fact), "Int");
    testing::assert_eq(type_fact_constant(fact).unwrap_or(""), "123");
    let value = testing::expect_some(type_fact_value(fact), "missing constant");
    match value {
        constant::ConstValue::Int(integer) => {
            integer.magnitude.limbs[0] = 789.to_u32();
        },
        _ => testing::fail("expected integer"),
    }
    testing::assert_eq(type_fact_constant(fact).unwrap_or(""), "123");
}

#[test]
fn orders_independent_initializers_across_files_and_omits_zero_values() -> () {
    let result = check(
        default_config(),
        PackageInput {
            path: "example/p",
            files: Vec::from_array(
                [
                    source_file("z.go", "package p\nvar Z = 0\n"),
                    source_file(
                        "a.go",
                        "package p\nvar A int\nvar B, C = pair()\nvar D = 3\nfunc pair() (int, int) { return 1, 2 }\n",
                    ),
                ],
            ),
        },
    );
    testing::assert_eq(result.diagnostics.len(), 0);
    let expected = Vec::from_array(["B", "D", "Z"]);
    testing::assert_eq(result.info.init_order.len(), expected.len());
    testing::assert_eq(result.info.init_order[0].left.len(), 2);
    for index in 0..expected.len() {
        let object = testing::expect_some(
            go_types::get_object(result.world, result.info.init_order[index].left[0]),
            "missing initialized object",
        );
        testing::assert_eq(object.name, expected[index])
    }
}

#[test]
fn checks_labels_without_gotos_and_gotos_without_labels() -> () {
    let valid = check_source("package p\nfunc F() { Outer: for { break Outer } }\n");
    testing::assert_eq(valid.diagnostics.len(), 0);
    let unused = check_source("package p\nfunc F() { Unused: for { return } }\n");
    testing::assert_eq(unused.diagnostics.len(), 1);
    testing::assert(unused.diagnostics[0].message.contains("declared and not used"));
    let missing = check_source("package p\nfunc F() { goto Missing }\n");
    testing::assert_eq(missing.diagnostics.len(), 1);
    testing::assert(missing.diagnostics[0].message.contains("not declared"))
}
