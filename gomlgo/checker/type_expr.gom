package checker;

use gomlgo::constant;
use gomlgo::syntax;
use gomlgo::types as go_types;

struct TypeParameterBinding {
    object: go_types::ObjectId,
    type_id: go_types::TypeId,
    constraint_node: syntax::NodeId,
    index: isize,
    grouped: bool,
}

struct InterfaceMethodOccurrence {
    method: go_types::ObjectId,
    node: syntax::NodeId,
}

struct ParameterBinding {
    node: syntax::NodeId,
    name: string,
    type_id: go_types::TypeId,
}

fn field_list_nodes(state: CheckState, node: syntax::NodeId) -> Vec[syntax::NodeId] {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::FieldList { opening: _, list, closing: _ }) => list,
        _ => {
            diagnostic(state, node, "invalid field list", false);
            Vec::new()
        },
    }
}

fn field_data(state: CheckState, node: syntax::NodeId) -> Option[
    (Vec[syntax::NodeId], syntax::NodeId, Option[syntax::NodeId]),
] {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::Field { names, type_node, tag }) => Option::Some(
            (names, type_node, tag),
        ),
        _ => {
            diagnostic(state, node, "invalid field", false);
            Option::None
        },
    }
}

fn embedded_name(state: CheckState, node: syntax::NodeId) -> string {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::Ident { name_pos: _, name }) => name,
        Some(syntax::SyntaxKind::StarExpr { star: _, expression }) => embedded_name(
            state,
            expression,
        ),
        Some(syntax::SyntaxKind::SelectorExpr { expression: _, selector }) => identifier(
            state,
            selector,
        ).unwrap_or(""),
        Some(syntax::SyntaxKind::IndexExpr { expression, lbrack: _, index: _, rbrack: _ }) => embedded_name(
            state,
            expression,
        ),
        Some(syntax::SyntaxKind::IndexListExpr { expression, lbrack: _, indices: _, rbrack: _ }) => embedded_name(
            state,
            expression,
        ),
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => embedded_name(
            state,
            expression,
        ),
        _ => "",
    }
}

fn embedded_definition_node(state: CheckState, node: syntax::NodeId) -> syntax::NodeId {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => match syntax::get_kind(
            state.syntax.arena,
            expression,
        ) {
            Some(syntax::SyntaxKind::StarExpr { star: _, expression: _ }) => expression,
            _ => node,
        },
        Some(syntax::SyntaxKind::StarExpr { star: _, expression }) => match syntax::get_kind(
            state.syntax.arena,
            expression,
        ) {
            Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression: _, rparen: _ }) => expression,
            _ => embedded_definition_node(state, expression),
        },
        Some(syntax::SyntaxKind::IndexExpr { expression, lbrack: _, index: _, rbrack: _ } | syntax::SyntaxKind::IndexListExpr {
            expression,
            lbrack: _,
            indices: _,
            rbrack: _,
        }) => embedded_definition_node(state, expression),
        Some(syntax::SyntaxKind::SelectorExpr { expression: _, selector }) => selector,
        _ => node,
    }
}

fn embedded_source_node(state: CheckState, node: syntax::NodeId) -> syntax::NodeId {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::StarExpr { star: _, expression } | syntax::SyntaxKind::ParenExpr {
            lparen: _,
            expression,
            rparen: _,
        } | syntax::SyntaxKind::IndexExpr { expression, lbrack: _, index: _, rbrack: _ } | syntax::SyntaxKind::IndexListExpr {
            expression,
            lbrack: _,
            indices: _,
            rbrack: _,
        }) => embedded_source_node(state, expression),
        Some(syntax::SyntaxKind::SelectorExpr { expression: _, selector }) => selector,
        _ => node,
    }
}

fn field_tag(state: CheckState, node: Option[syntax::NodeId]) -> string {
    match node {
        Some(node) => match syntax::get_kind(state.syntax.arena, node) {
            Some(syntax::SyntaxKind::BasicLit { value_pos: _, value_end: _, token: _, value }) => match constant::parse_string_literal(
                value,
            ) {
                Ok(constant::ConstValue::String(value)) => value,
                _ => "",
            },
            _ => "",
        },
        None => "",
    }
}

fn field_name_exists(fields: Vec[go_types::StructField], name: string) -> bool {
    if name == "_" {
        return false
    }
    for field in fields {
        if field.variable.name == name {
            return true
        }
    }
    false
}

fn report_field_redeclaration(
    state: CheckState,
    fields: Vec[go_types::StructField],
    node: syntax::NodeId,
    name: string,
) -> () {
    diagnostic(state, node, name + " redeclared", false);
    for field in fields {
        if field.variable.name == name {
            match field.object {
                Some(object) => match go_types::get_object(state.world, object) {
                    Some(object) => match object.node {
                        Some(existing) => secondary_diagnostic(
                            state,
                            existing,
                            "\tother declaration of " + name,
                        ),
                        None => {},
                    },
                    None => {},
                },
                None => {},
            }
            return
        }
    }
}

fn add_field_object(
    state: CheckState,
    node: syntax::NodeId,
    source_node: syntax::NodeId,
    name: string,
    type_id: go_types::TypeId,
    implicit: bool,
) -> go_types::ObjectId {
    let object = go_types::add_object(
        state.world,
        go_types::ObjectKind::Var,
        name,
        Option::Some(state.package_id),
        node_file(state, source_node),
        Option::Some(source_node),
        node_start(state, source_node),
        type_id,
    );
    if implicit {
        state.info.implicits.push(ObjectFact { node, object: Option::Some(object) })
    } else {
        state.info.defs.push(ObjectFact { node, object: Option::Some(object) })
    }
    object
}

fn embedded_unsafe_pointer(state: CheckState, type_id: go_types::TypeId) -> bool {
    match go_types::get_type(state.world, go_types::underlying(state.world, type_id)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Basic {
                basic: go_types::BasicKind::UnsafePointer,
                name: _,
                untyped: _,
            },
        }) => true,
        _ => false,
    }
}

fn collapse_parenthesized_embedded_fact(
    state: CheckState,
    node: syntax::NodeId,
    expression: syntax::NodeId,
) -> () {
    if let Some(fact) = recorded_type_fact(state, expression) {
        update_operand_fact(state, node, fact.type_id, Option::None)
    }
    let _ = state.omitted_type_fact_nodes.insert(expression.value);
    let mut object: Option[go_types::ObjectId] = Option::None;
    for fact in state.info.uses {
        if fact.node.value == expression.value {
            object = fact.object;
        }
    }
    match object {
        Some(object) => {
            let _ = state.omitted_use_fact_nodes.insert(expression.value);
            record_use(state, node, object)
        },
        None => {},
    }
}

fn report_parenthesized_embedded_type(state: CheckState, node: syntax::NodeId) -> () {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => {
            diagnostic(state, node, "cannot parenthesize embedded type", false);
            match syntax::get_kind(state.syntax.arena, expression) {
                Some(syntax::SyntaxKind::StarExpr { star: _, expression: inner }) => collapse_parenthesized_embedded_fact(
                    state,
                    expression,
                    inner,
                ),
                _ => collapse_parenthesized_embedded_fact(state, node, expression),
            }
        },
        Some(syntax::SyntaxKind::StarExpr { star: _, expression }) => match syntax::get_kind(
            state.syntax.arena,
            expression,
        ) {
            Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression: inner, rparen: _ }) => {
                diagnostic(state, expression, "cannot parenthesize embedded type", false);
                collapse_parenthesized_embedded_fact(state, expression, inner)
            },
            _ => {},
        },
        _ => {},
    }
}

fn validate_embedded_field_type(state: CheckState, node: syntax::NodeId, type_id: go_types::TypeId) -> () {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => validate_embedded_field_type(
            state,
            expression,
            type_id,
        ),
        Some(syntax::SyntaxKind::StarExpr { star: _, expression }) => {
            match go_types::get_type(state.world, go_types::unalias(state.world, type_id)) {
                Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) => if go_types::is_type_parameter(
                    state.world,
                    element,
                ) {
                    diagnostic(
                        state,
                        node,
                        "embedded field type cannot be a (pointer to a) type parameter",
                        false,
                    )
                } else if go_types::is_interface(state.world, element) {
                    diagnostic(
                        state,
                        node,
                        "embedded field type cannot be a pointer to an interface",
                        false,
                    )
                } else if embedded_unsafe_pointer(state, element) {
                    diagnostic(state, node, "embedded field type cannot be unsafe.Pointer", false)
                } else {
                    match go_types::get_type(
                        state.world,
                        go_types::underlying(state.world, element),
                    ) {
                        Some(go_types::TypeData {
                            id: _,
                            kind: go_types::TypeKind::Pointer { element: _ },
                        }) => diagnostic(
                            state,
                            node,
                            "embedded field type cannot be a pointer",
                            false,
                        ),
                        _ => {},
                    }
                },
                _ => {},
            }
        },
        _ => if go_types::is_type_parameter(state.world, type_id) {
            diagnostic(
                state,
                node,
                "embedded field type cannot be a (pointer to a) type parameter",
                false,
            )
        } else if embedded_unsafe_pointer(state, type_id) {
            diagnostic(state, node, "embedded field type cannot be unsafe.Pointer", false)
        } else if match go_types::get_type(state.world, type_id) {
            Some(go_types::TypeData {
                id: _,
                kind: go_types::TypeKind::Alias { object: _, rhs: _, type_params: _, type_args: _ },
            }) => true,
            _ => false,
        } {} else {
            match go_types::get_type(state.world, go_types::underlying(state.world, type_id)) {
                Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element: _ } }) => diagnostic(
                    state,
                    node,
                    "embedded field type cannot be a pointer",
                    false,
                ),
                _ => {},
            }
        },
    }
}

fn resolve_struct_type(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    fields_node: syntax::NodeId,
) -> go_types::TypeId {
    let fields: Vec[go_types::StructField] = Vec::new();
    let embedded_fields: Vec[(syntax::NodeId, go_types::TypeId)] = Vec::new();
    state.type_cycle_depth += 1;
    state.type_fact_recovery_depth += 1;
    for field_node in field_list_nodes(state, fields_node) {
        match field_data(state, field_node) {
            Some((names, type_node, tag_node)) => {
                let field_type = recovered_constraint_type(
                    state,
                    type_node,
                    resolve_type(state, scope, type_node),
                );
                let tag = field_tag(state, tag_node);
                if names.is_empty() {
                    report_parenthesized_embedded_type(state, type_node);
                    embedded_fields.push((type_node, field_type));
                    let name = embedded_name(state, type_node);
                    if name == "" {
                        diagnostic(state, field_node, "invalid embedded field", false)
                    } else if field_name_exists(fields, name) {
                        report_field_redeclaration(
                            state,
                            fields,
                            embedded_definition_node(state, type_node),
                            name,
                        )
                    } else {
                        let object = add_field_object(
                            state,
                            embedded_definition_node(state, type_node),
                            embedded_source_node(state, type_node),
                            name,
                            field_type,
                            false,
                        );
                        fields.push(
                            go_types::StructField {
                                object: Option::Some(object),
                                variable: go_types::Variable {
                                    name,
                                    owner: Option::Some(state.package_id),
                                    type_id: field_type,
                                },
                                embedded: true,
                                tag,
                            },
                        )
                    }
                } else {
                    for name_node in names {
                        let name = identifier(state, name_node).unwrap_or("");
                        if name == "" {
                            diagnostic(state, name_node, "invalid field name", false)
                        } else if field_name_exists(fields, name) {
                            report_field_redeclaration(state, fields, name_node, name)
                        } else {
                            let object = add_field_object(
                                state,
                                name_node,
                                name_node,
                                name,
                                field_type,
                                false,
                            );
                            fields.push(
                                go_types::StructField {
                                    object: Option::Some(object),
                                    variable: go_types::Variable {
                                        name,
                                        owner: Option::Some(state.package_id),
                                        type_id: field_type,
                                    },
                                    embedded: false,
                                    tag,
                                },
                            )
                        }
                    }
                }
            },
            None => {},
        }
    }
    for embedded in embedded_fields {
        validate_embedded_field_type(state, embedded.0, embedded.1)
    }
    state.type_cycle_depth -= 1;
    state.type_fact_recovery_depth -= 1;
    let result = go_types::add_type(state.world, go_types::TypeKind::Struct { fields });
    record_type_expression(state, node, result);
    result
}

fn add_parameter(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    name: string,
    type_id: go_types::TypeId,
) -> () {
    if name == "" {
        return
    }
    let object = go_types::add_object(
        state.world,
        go_types::ObjectKind::Var,
        name,
        Option::Some(state.package_id),
        node_file(state, node),
        Option::Some(node),
        node_start(state, node),
        type_id,
    );
    if name == "_" {
        state.info.defs.push(ObjectFact { node, object: Option::Some(object) });
        return
    }
    match go_types::insert(state.world, scope, name, object) {
        Some(existing) => {
            diagnostic(state, node, name + " redeclared in this block", false);
            match go_types::get_object(state.world, existing) {
                Some(existing) => match existing.node {
                    Some(existing) => secondary_diagnostic(
                        state,
                        existing,
                        "\tother declaration of " + name,
                    ),
                    None => {},
                },
                None => {},
            }
        },
        None => state.info.defs.push(ObjectFact { node, object: Option::Some(object) }),
    }
}

fn parameter_type(state: CheckState, scope: go_types::ScopeId, node: syntax::NodeId) -> (
    go_types::TypeId,
    bool,
) {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::Ellipsis { ellipsis: _, element }) => match element {
            Some(element) => {
                let element_type = recovered_constraint_type(
                    state,
                    element,
                    resolve_type(state, scope, element),
                );
                let result = go_types::add_type(
                    state.world,
                    go_types::TypeKind::Slice { element: element_type },
                );
                record_type_expression(state, node, result);
                (result, true)
            },
            None => (state.world.invalid, true),
        },
        Some(syntax::SyntaxKind::BadExpr { from: _, to: _ }) => {
            record_invalid_type_expression(state, node);
            (state.world.invalid, false)
        },
        _ => (recovered_constraint_type(state, node, resolve_type(state, scope, node)), false),
    }
}

fn resolve_parameter_list(
    state: CheckState,
    scope: go_types::ScopeId,
    list_node: syntax::NodeId,
    allow_variadic: bool,
    bindings: Vec[ParameterBinding],
) -> (go_types::TypeId, bool) {
    let variables: Vec[go_types::Variable] = Vec::new();
    let fields = field_list_nodes(state, list_node);
    let mut variadic = false;
    for field_index in 0..fields.len() {
        match field_data(state, fields[field_index]) {
            Some((names, type_node, _)) => {
                let resolved = parameter_type(state, scope, type_node);
                if resolved.1 {
                    if !allow_variadic || field_index + 1 != fields.len() {
                        diagnostic(state, type_node, "can only use ... with final parameter", false)
                    } else {
                        variadic = true;
                    }
                }
                if names.is_empty() {
                    let position = match syntax::get_kind(state.syntax.arena, type_node) {
                        Some(syntax::SyntaxKind::Ellipsis { ellipsis: _, element }) => match element {
                            Some(element) => node_start(state, element),
                            None => node_start(state, fields[field_index]),
                        },
                        _ => node_start(state, fields[field_index]),
                    };
                    let object = go_types::add_object(
                        state.world,
                        go_types::ObjectKind::Var,
                        "",
                        Option::Some(state.package_id),
                        node_file(state, fields[field_index]),
                        Option::Some(fields[field_index]),
                        position,
                        resolved.0,
                    );
                    let mut recorded = false;
                    for fact in state.info.implicits {
                        if fact.node.value == fields[field_index].value {
                            recorded = true;
                        }
                    }
                    if !recorded {
                        state.info.implicits.push(
                            ObjectFact { node: fields[field_index], object: Option::Some(object) },
                        )
                    }
                    variables.push(
                        go_types::Variable {
                            name: "",
                            owner: Option::Some(state.package_id),
                            type_id: resolved.0,
                        },
                    )
                } else {
                    for name_index in 0..names.len() {
                        let name_node = names[name_index];
                        let name = identifier(state, name_node).unwrap_or("");
                        bindings.push(
                            ParameterBinding { node: name_node, name, type_id: resolved.0 },
                        );
                        variables.push(
                            go_types::Variable {
                                name,
                                owner: Option::Some(state.package_id),
                                type_id: resolved.0,
                            },
                        )
                    }
                }
            },
            None => {},
        }
    };
    (go_types::add_type(state.world, go_types::TypeKind::Tuple { variables }), variadic)
}

fn declare_type_parameters(
    state: CheckState,
    scope: go_types::ScopeId,
    list_node: Option[syntax::NodeId],
) -> Vec[TypeParameterBinding] {
    let bindings: Vec[TypeParameterBinding] = Vec::new();
    match list_node {
        Some(list_node) => for field_node in field_list_nodes(state, list_node) {
            match field_data(state, field_node) {
                Some((names, constraint_node, _)) => for name_index in 0..names.len() {
                    let name_node = names[name_index];
                    let name = identifier(state, name_node).unwrap_or("");
                    if name == "" {
                        diagnostic(state, name_node, "invalid type parameter name", false)
                    } else {
                        let object = go_types::add_object(
                            state.world,
                            go_types::ObjectKind::TypeName,
                            name,
                            Option::Some(state.package_id),
                            node_file(state, name_node),
                            Option::Some(name_node),
                            node_start(state, name_node),
                            state.world.invalid,
                        );
                        let type_id = go_types::add_type(
                            state.world,
                            go_types::TypeKind::TypeParam {
                                object,
                                constraint: state.world.invalid,
                                index: bindings.len(),
                            },
                        );
                        let _ = go_types::set_object_type(state.world, object, type_id);
                        if name == "_" {
                            state.info.defs.push(
                                ObjectFact { node: name_node, object: Option::Some(object) },
                            );
                            bindings.push(
                                TypeParameterBinding {
                                    object,
                                    type_id,
                                    constraint_node,
                                    index: bindings.len(),
                                    grouped: name_index + 1 < names.len(),
                                },
                            )
                        } else {
                            match go_types::insert(state.world, scope, name, object) {
                                Some(existing) => {
                                    diagnostic(
                                        state,
                                        name_node,
                                        name + " redeclared in this block",
                                        false,
                                    );
                                    match go_types::get_object(state.world, existing) {
                                        Some(existing) => match existing.node {
                                            Some(existing) => secondary_diagnostic(
                                                state,
                                                existing,
                                                "\tother declaration of " + name,
                                            ),
                                            None => {},
                                        },
                                        None => {},
                                    }
                                    bindings.push(
                                        TypeParameterBinding {
                                            object,
                                            type_id,
                                            constraint_node,
                                            index: bindings.len(),
                                            grouped: name_index + 1 < names.len(),
                                        },
                                    )
                                },
                                None => {
                                    state.info.defs.push(
                                        ObjectFact { node: name_node, object: Option::Some(object) },
                                    );
                                    bindings.push(
                                        TypeParameterBinding {
                                            object,
                                            type_id,
                                            constraint_node,
                                            index: bindings.len(),
                                            grouped: name_index + 1 < names.len(),
                                        },
                                    )
                                },
                            }
                        }
                    }
                },
                None => {},
            }
        },
        None => {},
    }
    bindings
}

fn provisional_type_parameters(bindings: Vec[TypeParameterBinding], invalid: go_types::TypeId) -> Vec[
    go_types::TypeParameter,
] {
    let result: Vec[go_types::TypeParameter] = Vec::new();
    for binding in bindings {
        result.push(
            go_types::TypeParameter {
                object: binding.object,
                constraint: invalid,
                grouped: binding.grouped,
            },
        )
    }
    result
}

fn incomplete_constraint_requires_interface(state: CheckState, value: go_types::TypeId) -> bool {
    match go_types::get_type(state.world, go_types::unalias(state.world, value)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object,
                underlying: _,
                type_params: _,
                type_args: _,
                methods: _,
            },
        }) => match pending_type_index(state, object) {
            Some(index) => !direct_interface_type_syntax(state, state.pending_types[index].rhs),
            None => false,
        },
        _ => false,
    }
}

fn implicit_constraint_interface(state: CheckState, embedded: go_types::TypeId) -> go_types::TypeId {
    go_types::add_type(
        state.world,
        go_types::TypeKind::Interface {
            methods: Vec::new(),
            embeddeds: Vec::from_array([embedded]),
            comparable: false,
            implicit: true,
        },
    )
}

fn resolve_type_parameter_constraint(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
) -> (go_types::TypeId, bool) {
    let deferred_instance_start = state.deferred_instances.len();
    state.type_parameter_cycle_depth += 1;
    state.constraint_type_depth += 1;
    let resolved_constraint = resolve_type(state, scope, node);
    state.constraint_type_depth -= 1;
    state.type_parameter_cycle_depth -= 1;
    let mut invalid_instantiation = false;
    let mut deferred_instantiation = false;
    for index in deferred_instance_start..state.deferred_instances.len() {
        if state.deferred_instances[index].count_only {
            invalid_instantiation = true;
        } else {
            deferred_instantiation = true;
        }
    }
    if resolved_constraint.value == state.world.invalid.value {
        (state.world.invalid, false)
    } else if go_types::underlying(state.world, resolved_constraint).value
        == state.world.invalid.value {
        if deferred_instantiation || invalid_instantiation {
            (
                if incomplete_constraint_requires_interface(state, resolved_constraint) {
                    implicit_constraint_interface(state, resolved_constraint)
                } else {
                    resolved_constraint
                },
                false,
            )
        } else {
            (state.world.invalid, false)
        }
    } else if go_types::is_type_parameter(state.world, resolved_constraint) {
        diagnostic(state, node, "cannot use a type parameter as constraint", false);
        (state.world.invalid, false)
    } else {
        if invalid_instantiation {
            go_types::mark_invalid_type_set(state.world, resolved_constraint)
        }
        match go_types::get_type(state.world, go_types::unalias(state.world, resolved_constraint)) {
            Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Union { terms } }) => {
                let embedded = go_types::add_type(state.world, go_types::TypeKind::Union { terms });
                (
                    go_types::add_type(
                        state.world,
                        go_types::TypeKind::Interface {
                            methods: Vec::new(),
                            embeddeds: Vec::from_array([embedded]),
                            comparable: false,
                            implicit: true,
                        },
                    ),
                    true,
                )
            },
            _ => if go_types::is_interface(state.world, resolved_constraint) {
                (resolved_constraint, false)
            } else {
                (
                    go_types::add_type(
                        state.world,
                        go_types::TypeKind::Interface {
                            methods: Vec::new(),
                            embeddeds: Vec::from_array([resolved_constraint]),
                            comparable: false,
                            implicit: true,
                        },
                    ),
                    false,
                )
            },
        }
    }
}

fn complete_type_parameters(
    state: CheckState,
    scope: go_types::ScopeId,
    bindings: Vec[TypeParameterBinding],
) -> Vec[go_types::TypeParameter] {
    let result: Vec[go_types::TypeParameter] = Vec::new();
    let mut previous_node = -1;
    let mut previous_constraint = state.world.invalid;
    for binding in bindings {
        let resolved = if binding.constraint_node.value == previous_node {
            (previous_constraint, false)
        } else {
            let value = resolve_type_parameter_constraint(state, scope, binding.constraint_node);
            previous_node = binding.constraint_node.value;
            previous_constraint = value.0;
            value
        };
        let constraint = resolved.0;
        if resolved.1 {
            state.info.types.push(
                TypeFact {
                    node: syntax::node_id(-1),
                    type_id: constraint,
                    extra: type_fact_extra(
                        Option::Some(
                            f":$unknown[*ast.InterfaceType:-1:{node_end(state, binding.constraint_node)}]",
                        ),
                        "",
                        Option::None,
                    ),
                    void: false,
                    type_expr: true,
                    builtin: false,
                    value_expr: false,
                    nil: false,
                    addressable: false,
                    assignable: false,
                    comma_ok: false,
                },
            )
        }
        let _ = go_types::set_type(
            state.world,
            binding.type_id,
            go_types::TypeKind::TypeParam {
                object: binding.object,
                constraint,
                index: binding.index,
            },
        );
        result.push(
            go_types::TypeParameter { object: binding.object, constraint, grouped: binding.grouped },
        )
    }
    result
}

fn resolve_type_parameters(
    state: CheckState,
    scope: go_types::ScopeId,
    list_node: Option[syntax::NodeId],
) -> Vec[go_types::TypeParameter] {
    complete_type_parameters(state, scope, declare_type_parameters(state, scope, list_node))
}

fn resolved_interface_constraint(state: CheckState, constraint: go_types::TypeId) -> go_types::TypeId {
    match go_types::get_type(state.world, go_types::unalias(state.world, constraint)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Interface { methods, embeddeds, comparable, implicit },
        }) => if implicit && methods.is_empty() && embeddeds.len() == 1 && !comparable
            && go_types::is_interface(state.world, embeddeds[0]) {
            embeddeds[0]
        } else {
            constraint
        },
        _ => constraint,
    }
}

fn normalize_named_type_parameter_constraints(state: CheckState, named: go_types::TypeId) -> () {
    let data = match go_types::get_type(state.world, named) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object,
                underlying: _,
                type_params,
                type_args: _,
                methods: _,
            },
        }) => (object, type_params),
        _ => return,
    };
    let parameters: Vec[go_types::TypeParameter] = Vec::new();
    let mut changed = false;
    for index in 0..data.1.len() {
        let constraint = resolved_interface_constraint(state, data.1[index].constraint);
        if constraint.value != data.1[index].constraint.value {
            changed = true;
            match go_types::get_object(state.world, data.1[index].object) {
                Some(object) => {
                    let _ = go_types::set_type(
                        state.world,
                        object.type_id,
                        go_types::TypeKind::TypeParam {
                            object: data.1[index].object,
                            constraint,
                            index,
                        },
                    );
                },
                None => {},
            }
        }
        parameters.push(
            go_types::TypeParameter {
                object: data.1[index].object,
                constraint,
                grouped: data.1[index].grouped,
            },
        )
    }
    if !changed {
        return
    }
    let count = state.world.types.len();
    for index in 0..count {
        let type_id = go_types::type_id(index);
        match go_types::get_type(state.world, type_id) {
            Some(go_types::TypeData {
                id: _,
                kind: go_types::TypeKind::Named {
                    object,
                    underlying,
                    type_params: _,
                    type_args,
                    methods,
                },
            }) => if object.value == data.0.value {
                let _ = go_types::set_type(
                    state.world,
                    type_id,
                    go_types::TypeKind::Named {
                        object,
                        underlying,
                        type_params: parameters,
                        type_args,
                        methods,
                    },
                );
            },
            _ => {},
        }
    }
}

fn resolve_function_type(
    state: CheckState,
    parent_scope: go_types::ScopeId,
    node: syntax::NodeId,
    type_params: Option[syntax::NodeId],
    params: syntax::NodeId,
    results: Option[syntax::NodeId],
) -> go_types::TypeId {
    let mut scope_end = node_end(state, node);
    match state.function_scope_ends[node.value] {
        Some(value) => {
            scope_end = value;
        },
        None => {},
    }
    let function_scope = go_types::add_scope(
        state.world,
        go_types::ScopeKind::Function,
        Option::Some(parent_scope),
        node_file(state, node),
        node_start(state, node),
        scope_end,
    );
    if !state.scope_fact_indices.contains(node.value) {
        record_scope_fact(state, node, function_scope)
    }
    let resolved_type_params = if state.ignore_function_type_params {
        Vec::new()
    } else {
        resolve_type_parameters(state, function_scope, type_params)
    };
    let parameter_bindings: Vec[ParameterBinding] = Vec::new();
    let resolved_params = resolve_parameter_list(
        state,
        function_scope,
        params,
        true,
        parameter_bindings,
    );
    let resolved_results = match results {
        Some(results) => match syntax::get_kind(state.syntax.arena, results) {
            Some(syntax::SyntaxKind::FieldList { opening: _, list: _, closing: _ }) => resolve_parameter_list(
                state,
                function_scope,
                results,
                false,
                parameter_bindings,
            ).0,
            _ => {
                let result_type = recovered_constraint_type(
                    state,
                    results,
                    resolve_type(state, function_scope, results),
                );
                go_types::add_type(
                    state.world,
                    go_types::TypeKind::Tuple {
                        variables: Vec::from_array(
                            [
                                go_types::Variable {
                                    name: "",
                                    owner: Option::Some(state.package_id),
                                    type_id: result_type,
                                },
                            ],
                        ),
                    },
                )
            },
        },
        None => go_types::add_type(state.world, go_types::TypeKind::Tuple { variables: Vec::new() }),
    };
    for binding in parameter_bindings {
        add_parameter(state, function_scope, binding.node, binding.name, binding.type_id)
    }
    let result = go_types::add_type(
        state.world,
        go_types::TypeKind::Signature {
            receiver: Option::None,
            receiver_type_params: Vec::new(),
            type_params: resolved_type_params,
            params: resolved_params.0,
            results: resolved_results,
            variadic: resolved_params.1,
        },
    );
    result
}

fn resolve_function_signature(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    record: bool,
) -> go_types::TypeId {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::FuncType { func_pos: _, type_params, params, results }) => {
            state.type_cycle_depth += 1;
            let diagnostic_start = state.diagnostics.len();
            let result = resolve_function_type(state, scope, node, type_params, params, results);
            let signature_diagnostics = take_diagnostics_from(state, diagnostic_start);
            for diagnostic in signature_diagnostics {
                if diagnostic.message.starts_with("embedded field type cannot") {
                    state.deferred_function_type_diagnostics.push(
                        DeferredFunctionTypeDiagnostic {
                            signature_node: node,
                            diagnostic,
                            emitted: false,
                        },
                    )
                } else {
                    state.diagnostics.push(diagnostic)
                }
            }
            state.type_cycle_depth -= 1;
            if record {
                record_type_expression(state, node, result)
            }
            result
        },
        _ => state.world.invalid,
    }
}

fn interface_method_exists(state: CheckState, methods: Vec[go_types::ObjectId], name: string) -> bool {
    for method in methods {
        match go_types::get_object(state.world, method) {
            Some(value) => if value.name == name {
                return true
            },
            None => {},
        }
    }
    false
}

fn interface_method_object(state: CheckState, methods: Vec[go_types::ObjectId], name: string) -> Option[
    go_types::ObjectId,
] {
    for method in methods {
        match go_types::get_object(state.world, method) {
            Some(value) => if value.name == name {
                return Option::Some(method)
            },
            None => {},
        }
    }
    Option::None
}

fn interface_method_name(state: CheckState, method: go_types::ObjectId) -> string {
    match go_types::get_object(state.world, method) {
        Some(object) => object.name,
        None => "",
    }
}

fn interface_method_occurrence(
    state: CheckState,
    methods: Vec[InterfaceMethodOccurrence],
    method: go_types::ObjectId,
) -> Option[InterfaceMethodOccurrence] {
    let Some(value) = go_types::get_object(state.world, method) else {
        return Option::None;
    };
    for existing in methods {
        match go_types::get_object(state.world, existing.method) {
            Some(existing_object) => if go_types::method_name_identical(
                value.name,
                value.owner,
                existing_object.name,
                existing_object.owner,
            ) {
                return Option::Some(existing)
            },
            None => {},
        }
    }
    Option::None
}

fn report_interface_overlap(
    state: CheckState,
    node: syntax::NodeId,
    other: syntax::NodeId,
    name: string,
) -> () {
    if state.defer_constraint_checks && !state.active_type_objects.is_empty() {
        state.deferred_interface_overlap_diagnostics.push(
            DeferredInterfaceOverlapDiagnostic {
                object: state.active_type_objects[state.active_type_objects.len() - 1],
                node,
                other,
                name,
                emitted: false,
            },
        )
    } else {
        diagnostic(state, node, "duplicate method " + name, false);
        secondary_diagnostic(state, other, "\tother declaration of method " + name)
    }
}

fn sort_interface_methods(state: CheckState, methods: Vec[go_types::ObjectId]) -> () {
    for index in 1..methods.len() {
        let mut current = index;
        while current > 0
            && interface_method_name(state, methods[current])
                < interface_method_name(state, methods[current - 1]) {
            let previous = methods[current - 1];
            methods[current - 1] = methods[current];
            methods[current] = previous;
            current -= 1;
        }
    }
}

fn set_interface_method_receivers(
    state: CheckState,
    interface_type: go_types::TypeId,
    receiver_type: go_types::TypeId,
) -> () {
    match go_types::get_type(state.world, go_types::unalias(state.world, interface_type)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Interface {
                methods,
                embeddeds: _,
                comparable: _,
                implicit: _,
            },
        }) => for method in methods {
            match go_types::get_object(state.world, method) {
                Some(object) => match go_types::get_type(state.world, object.type_id) {
                    Some(go_types::TypeData {
                        id,
                        kind: go_types::TypeKind::Signature {
                            receiver: _,
                            receiver_type_params,
                            type_params,
                            params,
                            results,
                            variadic,
                        },
                    }) => {
                        let _ = go_types::set_type(
                            state.world,
                            id,
                            go_types::TypeKind::Signature {
                                receiver: Option::Some(
                                    go_types::Variable {
                                        name: "",
                                        owner: Option::Some(state.package_id),
                                        type_id: receiver_type,
                                    },
                                ),
                                receiver_type_params,
                                type_params,
                                params,
                                results,
                                variadic,
                            },
                        );
                    },
                    _ => {},
                },
                None => {},
            }
        },
        _ => {},
    }
}

fn clone_interface_with_method_receivers(
    state: CheckState,
    interface_type: go_types::TypeId,
    receiver_type: go_types::TypeId,
) -> go_types::TypeId {
    match go_types::get_type(state.world, go_types::unalias(state.world, interface_type)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Interface { methods, embeddeds, comparable, implicit },
        }) => {
            let cloned_methods: Vec[go_types::ObjectId] = Vec::new();
            for method in methods {
                match go_types::get_object(state.world, method) {
                    Some(object) => match go_types::get_type(state.world, object.type_id) {
                        Some(go_types::TypeData {
                            id: _,
                            kind: go_types::TypeKind::Signature {
                                receiver: _,
                                receiver_type_params,
                                type_params,
                                params,
                                results,
                                variadic,
                            },
                        }) => {
                            let signature = go_types::add_type(
                                state.world,
                                go_types::TypeKind::Signature {
                                    receiver: Option::Some(
                                        go_types::Variable {
                                            name: "",
                                            owner: Option::Some(state.package_id),
                                            type_id: receiver_type,
                                        },
                                    ),
                                    receiver_type_params,
                                    type_params,
                                    params,
                                    results,
                                    variadic,
                                },
                            );
                            cloned_methods.push(
                                go_types::add_object(
                                    state.world,
                                    object.kind,
                                    object.name,
                                    object.owner,
                                    object.file,
                                    object.node,
                                    object.position,
                                    signature,
                                ),
                            )
                        },
                        _ => cloned_methods.push(method),
                    },
                    None => {},
                }
            }
            go_types::add_type(
                state.world,
                go_types::TypeKind::Interface {
                    methods: cloned_methods,
                    embeddeds,
                    comparable,
                    implicit,
                },
            )
        },
        _ => interface_type,
    }
}

fn direct_interface_type_syntax(state: CheckState, node: syntax::NodeId) -> bool {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::InterfaceType { interface_pos: _, methods: _, incomplete: _ }) => true,
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => direct_interface_type_syntax(
            state,
            expression,
        ),
        _ => false,
    }
}

fn interface_element_requires_generics(state: CheckState, node: syntax::NodeId) -> bool {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::UnaryExpr { op_pos: _, op, expression: _ }) => op == TILDE_OPERATOR,
        Some(syntax::SyntaxKind::BinaryExpr { left: _, op_pos: _, op, right: _ }) => op
            == BIT_OR_OPERATOR,
        _ => false,
    }
}

fn resolve_interface_type(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    methods_node: syntax::NodeId,
) -> go_types::TypeId {
    let methods: Vec[go_types::ObjectId] = Vec::new();
    let method_occurrences: Vec[InterfaceMethodOccurrence] = Vec::new();
    let embeddeds: Vec[go_types::TypeId] = Vec::new();
    let mut comparable = false;
    let mut invalid_type_set = false;
    for field_node in field_list_nodes(state, methods_node) {
        match field_data(state, field_node) {
            Some((names, type_node, _)) => if names.is_empty() {
                state.constraint_type_depth += 1;
                let deferred_instance_start = state.deferred_instances.len();
                let embedded = resolve_type(state, scope, type_node);
                state.constraint_type_depth -= 1;
                let mut deferred_instantiation = false;
                for index in deferred_instance_start..state.deferred_instances.len() {
                    if !state.deferred_instances[index].count_only {
                        deferred_instantiation = true;
                    }
                }
                if embedded.value == state.world.invalid.value
                    || (go_types::underlying(state.world, embedded).value
                        == state.world.invalid.value
                        && !deferred_instantiation) {
                    invalid_type_set = true;
                }
                let generic_element = interface_element_requires_generics(state, type_node);
                if generic_element && !go_version_at_least(state, type_node, 18) {
                    invalid_type_set = true;
                    if state.defer_constraint_checks && !state.active_type_objects.is_empty() {
                        state.deferred_interface_version_diagnostics.push(
                            DeferredInterfaceVersionDiagnostic {
                                object: state.active_type_objects[state.active_type_objects.len()
                                    - 1],
                                node: type_node,
                                type_id: embedded,
                                generic_element: true,
                                emitted: false,
                            },
                        )
                    } else {
                        diagnostic(
                            state,
                            type_node,
                            "embedding interface element " + diagnostic_type_string(state, embedded)
                                + " requires go1.18 or later",
                            false,
                        )
                    }
                }
                let embedded_type_parameter = match go_types::type_data(
                    state.world,
                    go_types::unalias(state.world, embedded),
                ) {
                    go_types::TypeData {
                        id: _,
                        kind: go_types::TypeKind::TypeParam { object: _, constraint: _, index: _ },
                    } => {
                        invalid_type_set = true;
                        diagnostic(state, type_node, "term cannot be a type parameter", false);
                        true
                    },
                    _ => false,
                };
                if embedded.value != state.world.invalid.value
                    && go_types::underlying(state.world, embedded).value
                        != state.world.invalid.value
                    && !go_types::is_interface(state.world, embedded)
                    && !generic_element
                    && !go_version_at_least(state, type_node, 18) {
                    invalid_type_set = true;
                    if state.defer_constraint_checks && !state.active_type_objects.is_empty() {
                        state.deferred_interface_version_diagnostics.push(
                            DeferredInterfaceVersionDiagnostic {
                                object: state.active_type_objects[state.active_type_objects.len()
                                    - 1],
                                node: type_node,
                                type_id: embedded,
                                generic_element: false,
                                emitted: false,
                            },
                        )
                    } else {
                        diagnostic(
                            state,
                            type_node,
                            "embedding non-interface type "
                                + diagnostic_type_string(state, embedded)
                                + " requires go1.18 or later",
                            false,
                        )
                    }
                }
                if embedded_name(state, type_node) == "comparable"
                    && embedded.value != state.world.invalid.value {
                    comparable = true;
                } else {
                    for method in go_types::interface_methods(state.world, embedded) {
                        match interface_method_occurrence(state, method_occurrences, method) {
                            Some(existing) => {
                                let same_signature = match (
                                    go_types::get_object(state.world, existing.method),
                                    go_types::get_object(state.world, method),
                                ) {
                                    (Some(left), Some(right)) => go_types::identical(
                                        state.world,
                                        left.type_id,
                                        right.type_id,
                                    ),
                                    _ => true,
                                };
                                if !go_version_at_least(state, type_node, 14) || !same_signature {
                                    report_interface_overlap(
                                        state,
                                        type_node,
                                        existing.node,
                                        interface_method_name(state, method),
                                    )
                                }
                            },
                            None => method_occurrences.push(
                                InterfaceMethodOccurrence { method, node: type_node },
                            ),
                        }
                    }
                }
                embeddeds.push(
                    if embedded_type_parameter {
                        state.world.invalid
                    } else {
                        embedded
                    },
                )
            } else {
                let mut has_non_blank_name = false;
                for name_node in names {
                    let name = identifier(state, name_node).unwrap_or("");
                    if name == "_" {
                        diagnostic(
                            state,
                            name_node,
                            "methods must have a unique non-blank name",
                            false,
                        )
                    } else {
                        has_non_blank_name = true;
                    }
                }
                if has_non_blank_name {
                    let previous = state.ignore_function_type_params;
                    state.ignore_function_type_params = true;
                    let signature = resolve_type(state, scope, type_node);
                    state.ignore_function_type_params = previous;
                    discard_method_type_parameters(state, signature);
                    for name_node in names {
                        let name = identifier(state, name_node).unwrap_or("");
                        if name != "_" {
                            let existing_method = interface_method_object(state, methods, name);
                            match existing_method {
                                Some(existing) => if state.active_type_objects.is_empty() {
                                    diagnostic(state, name_node, "duplicate method " + name, false);
                                    match go_types::get_object(state.world, existing) {
                                        Some(existing) => match existing.node {
                                            Some(existing) => secondary_diagnostic(
                                                state,
                                                existing,
                                                "\tother declaration of method " + name,
                                            ),
                                            None => {},
                                        },
                                        None => {},
                                    }
                                } else {
                                    state.deferred_interface_method_diagnostics.push(
                                        DeferredInterfaceMethodDiagnostic {
                                            object: state.active_type_objects[state.active_type_objects.len()
                                                - 1],
                                            node: name_node,
                                            existing,
                                            emitted: false,
                                        },
                                    )
                                },
                                None => {},
                            }
                            let object = go_types::add_object(
                                state.world,
                                go_types::ObjectKind::Func,
                                name,
                                Option::Some(state.package_id),
                                node_file(state, name_node),
                                Option::Some(name_node),
                                node_start(state, name_node),
                                signature,
                            );
                            methods.push(object);
                            match existing_method {
                                Some(_) => {},
                                None => {
                                    match interface_method_occurrence(
                                        state,
                                        method_occurrences,
                                        object,
                                    ) {
                                        Some(existing) => {
                                            let same_signature = match go_types::get_object(
                                                state.world,
                                                existing.method,
                                            ) {
                                                Some(existing) => go_types::identical(
                                                    state.world,
                                                    existing.type_id,
                                                    signature,
                                                ),
                                                None => true,
                                            };
                                            if !go_version_at_least(state, name_node, 14)
                                                || !same_signature {
                                                report_interface_overlap(
                                                    state,
                                                    existing.node,
                                                    name_node,
                                                    name,
                                                )
                                            }
                                        },
                                        None => method_occurrences.push(
                                            InterfaceMethodOccurrence {
                                                method: object,
                                                node: name_node,
                                            },
                                        ),
                                    };
                                },
                            }
                            state.info.defs.push(
                                ObjectFact { node: name_node, object: Option::Some(object) },
                            );
                        }
                    }
                }
            },
            None => {},
        }
    }
    sort_interface_methods(state, methods);
    let result = go_types::add_type(
        state.world,
        go_types::TypeKind::Interface { methods, embeddeds, comparable, implicit: false },
    );
    if invalid_type_set {
        go_types::mark_invalid_type_set(state.world, result)
    }
    set_interface_method_receivers(state, result, result);
    record_type_expression(state, node, result);
    reject_constraint_type(state, node, go_types::format_type(state.world, result), result)
}
