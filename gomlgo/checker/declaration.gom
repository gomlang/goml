struct PendingValue {
    object: go_types::ObjectId,
    file_scope: go_types::ScopeId,
    type_node: Option[syntax::NodeId],
    declaration_node: syntax::NodeId,
    value_nodes: Vec[syntax::NodeId],
    value_index: isize,
    value_count: isize,
    constant_declaration: bool,
    iota_value: isize,
    inherited_initializer: bool,
    invalid_constant_type: bool,
    status: isize,
}

struct ValueCycle {
    objects: Vec[go_types::ObjectId],
    declaration: bool,
    reported: bool,
}

struct TypeValueCycle {
    objects: Vec[go_types::ObjectId],
}

struct DeferredInterfaceMethodDiagnostic {
    object: go_types::ObjectId,
    node: syntax::NodeId,
    existing: go_types::ObjectId,
    emitted: bool,
}

struct DeferredInterfaceVersionDiagnostic {
    object: go_types::ObjectId,
    node: syntax::NodeId,
    type_id: go_types::TypeId,
    generic_element: bool,
    emitted: bool,
}

struct DeferredInterfaceOverlapDiagnostic {
    object: go_types::ObjectId,
    node: syntax::NodeId,
    other: syntax::NodeId,
    name: string,
    emitted: bool,
}

struct PendingType {
    object: go_types::ObjectId,
    type_id: go_types::TypeId,
    file_scope: go_types::ScopeId,
    rhs: syntax::NodeId,
    declaration_node: syntax::NodeId,
    type_params_node: Option[syntax::NodeId],
    alias: bool,
    status: isize,
}

struct PendingFunction {
    object: go_types::ObjectId,
    file_scope: go_types::ScopeId,
    type_node: syntax::NodeId,
    status: isize,
}

struct PendingMethod {
    object: go_types::ObjectId,
    placeholder: go_types::TypeId,
    file_scope: go_types::ScopeId,
    receiver_node: syntax::NodeId,
    receiver_name_node: Option[syntax::NodeId],
    type_node: syntax::NodeId,
    resolution: ReceiverResolution,
}

struct ImportBinding {
    object: go_types::ObjectId,
    node: syntax::NodeId,
    used: bool,
    ignored: bool,
}

struct LabelBinding {
    name: string,
    object: go_types::ObjectId,
    node: syntax::NodeId,
    used: bool,
}

struct ActiveLabel {
    name: string,
    breakable: bool,
    continuable: bool,
}

struct LocalBinding {
    object: go_types::ObjectId,
    node: syntax::NodeId,
    scope: go_types::ScopeId,
    function_id: isize,
}

struct DeferredInstanceCheck {
    node: syntax::NodeId,
    origin: go_types::TypeId,
    arguments: Vec[go_types::TypeId],
    count_only: bool,
    emitted: bool,
}

struct DeferredTypeInfoExpression {
    scope: go_types::ScopeId,
    node: syntax::NodeId,
}

struct DeferredConstraintTypeUse {
    node: syntax::NodeId,
    type_id: go_types::TypeId,
}

struct DeferredFunctionBody {
    signature_node: syntax::NodeId,
    signature: go_types::TypeId,
    body: syntax::NodeId,
    start: isize,
    iota_value: isize,
    body_checked: bool,
    emitted: bool,
    diagnostics: Vec[CheckDiagnostic],
}

struct DeferredFunctionTypeDiagnostic {
    signature_node: syntax::NodeId,
    diagnostic: CheckDiagnostic,
    emitted: bool,
}

struct PartialInstance {
    type_id: go_types::TypeId,
    origin: go_types::TypeId,
    explicit_arguments: Vec[go_types::TypeId],
    inferred_arguments: Vec[go_types::TypeId],
}

struct TypeFactSourceKey {
    file: i32,
    start: i32,
    end: i32,
}

type TypeFactSourceIndex = HashMap[i32, collections::IndexMap[u64, isize]];

struct ActiveInstantiation {
    origin: go_types::TypeId,
    parameters: Vec[go_types::TypeParameter],
    diagnostic_parameters: Vec[go_types::TypeParameter],
}

