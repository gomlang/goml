    invalid_builtin_parameter_nodes: collections::BitSet,
    used_objects: collections::BitSet,
    constants: HashMap[isize, constant::ConstValue],
    declared_objects: HashMap[isize, go_types::ObjectId],
    pending_values: Vec[PendingValue],
    pending_value_indices: HashMap[isize, isize],
    active_value_objects: Vec[go_types::ObjectId],
    active_initialization_objects: Vec[go_types::ObjectId],
    initialization_dependencies: Vec[(go_types::ObjectId, go_types::ObjectId)],
    function_initialization_dependencies: Vec[(go_types::ObjectId, go_types::ObjectId)],
    value_cycles: Vec[ValueCycle],
    pending_types: Vec[PendingType],
    pending_type_indices: HashMap[isize, isize],
    active_type_objects: Vec[go_types::ObjectId],
    deferred_type_validations: Vec[go_types::TypeId],
    invalid_type_objects: Vec[go_types::ObjectId],
    deferred_direct_type_cycles: Vec[go_types::ObjectId],
    deferred_type_value_cycles: Vec[TypeValueCycle],
    deferred_alias_type_cycles: Vec[TypeValueCycle],
    deferred_receiver_cycle_diagnostics: Vec[CheckDiagnostic],
    deferred_interface_method_diagnostics: Vec[DeferredInterfaceMethodDiagnostic],
    deferred_interface_overlap_diagnostics: Vec[DeferredInterfaceOverlapDiagnostic],
    deferred_interface_version_diagnostics: Vec[DeferredInterfaceVersionDiagnostic],
    deferred_union_diagnostics: Vec[CheckDiagnostic],
    deferred_local_type_validations: Vec[go_types::TypeId],
    deferred_local_type_validation_nodes: Vec[syntax::NodeId],
    local_type_declaration_depth: isize,
    local_type_alias_depth: isize,
    active_local_type_objects: Vec[go_types::ObjectId],
    deferred_local_alias_cycles: Vec[go_types::ObjectId],
    deferred_local_alias_body_objects: Vec[go_types::ObjectId],
    deferred_local_alias_bodies: Vec[syntax::NodeId],
    pending_functions: Vec[PendingFunction],
    pending_function_indices: HashMap[isize, isize],
    pending_methods: Vec[PendingMethod],
    receiver_validation_nodes: Vec[syntax::NodeId],
    active_function_objects: Vec[go_types::ObjectId],
    reported_recursive_calls: collections::BitSet,
    type_cycle_depth: isize,
    type_fact_recovery_depth: isize,
    array_length_depth: isize,
    array_length_type_cycle_depth: isize,
    named_type_depth: isize,
    type_parameter_cycle_depth: isize,
    generic_type_origin_depth: isize,
    generic_type_short_diagnostic: bool,
    generic_function_context_depth: Ref[isize],
    generic_argument_inference_depth: isize,
