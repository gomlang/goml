fn type_fact_source_key(state: CheckState, node: syntax::NodeId) -> TypeFactSourceKey {
    let value = syntax::node_at(state.syntax.arena, node.value);
    TypeFactSourceKey {
        file: value.file.value.to_i32(),
        start: value.span.start.to_i32(),
        end: value.span.end.to_i32(),
    }
}

fn type_fact_span_key(key: TypeFactSourceKey) -> u64 {
    (key.start.to_u32().to_u64() << 32) | key.end.to_u32().to_u64()
}

fn empty_type_fact_source_index() -> TypeFactSourceIndex {
    HashMap::new()
}

fn package_type_fact_source_index(package_syntax: syntax::PackageSyntax) -> TypeFactSourceIndex {
    let result = empty_type_fact_source_index();
    let mut previous_end = 0;
    for file in package_syntax.files {
        let end = file.root.value + 1;
        result[file.id.value.to_i32()] = collections::IndexMap::with_capacity(end - previous_end);
        previous_end = end;
    }
    result
}

fn insert_type_fact_source(index: TypeFactSourceIndex, key: TypeFactSourceKey, value: isize) -> () {
    let entries = index.get_or_insert_with(key.file, || collections::IndexMap::new());
    let span = type_fact_span_key(key);
    if entries.get(span).is_none() {
        let _ = entries.insert(span, value);
    }
}

fn find_type_fact_source(index: TypeFactSourceIndex, key: TypeFactSourceKey) -> Option[isize] {
    let entries = index[key.file]?;
    entries.get(type_fact_span_key(key))
}

fn fact_index_slots(count: isize) -> Vec[i32] {
    let result: Vec[i32] = Vec::with_capacity(count);
    for _ in 0..count {
        result.push(-1)
    }
    result
}

fn type_fact_index(state: CheckState, node: syntax::NodeId) -> Option[isize] {
    if node.value < 0 || node.value >= state.type_fact_indices.len() {
        return Option::None
    }
    let index = state.type_fact_indices[node.value].to_isize();
    if index >= 0 {
        Option::Some(index)
    } else {
        Option::None
    }
}

fn set_type_fact_index(state: CheckState, node: syntax::NodeId, index: isize) -> () {
    if node.value >= 0 && node.value < state.type_fact_indices.len() {
        state.type_fact_indices[node.value] = index.to_i32();
    }
}

fn index_type_fact(state: CheckState, node: syntax::NodeId, index: isize) -> () {
    set_type_fact_index(state, node, index);
    let key = type_fact_source_key(state, node);
    if key.file >= 0 {
        insert_type_fact_source(state.type_fact_source_indices, key, index);
    }
}

fn record_implicit_fact(state: CheckState, fact: ObjectFact) -> () {
    if !state.implicit_fact_nodes.insert(fact.node.value) {
        let count = state.duplicate_implicit_facts[fact.node.value].unwrap_or(0);
        state.duplicate_implicit_facts[fact.node.value] = count + 1;
    }
    state.info.implicits.push(fact)
}

fn pop_implicit_fact(state: CheckState) -> () {
    if let Some(fact) = state.info.implicits.pop() {
        match state.duplicate_implicit_facts[fact.node.value] {
            Some(count) => if count > 1 {
                state.duplicate_implicit_facts[fact.node.value] = count - 1;
            } else {
                let _ = state.duplicate_implicit_facts.remove(fact.node.value);
            },
            None => {
                let _ = state.implicit_fact_nodes.remove(fact.node.value);
            },
        }
    }
}

fn record_scope_fact(state: CheckState, node: syntax::NodeId, scope: go_types::ScopeId) -> () {
    let index = state.info.scopes.len();
    state.scope_fact_previous_indices.push(state.scope_fact_indices[node.value]);
    state.scope_fact_indices[node.value] = index;
    state.info.scopes.push(ScopeFact { node, scope })
}

fn pop_scope_fact(state: CheckState) -> () {
    match state.info.scopes.pop() {
        Some(fact) => match state.scope_fact_previous_indices.pop() {
            Some(previous) => match previous {
                Some(index) => {
                    state.scope_fact_indices[fact.node.value] = index;
                },
                None => {
                    let _ = state.scope_fact_indices.remove(fact.node.value);
                },
            },
            None => {
                let _ = state.scope_fact_indices.remove(fact.node.value);
            },
        },
        None => {},
    }
}

fn find_scope_fact(state: CheckState, node: syntax::NodeId) -> Option[ScopeFact] {
    match state.scope_fact_indices[node.value] {
        Some(index) => if index >= 0 && index < state.info.scopes.len() {
            Option::Some(state.info.scopes[index])
        } else {
            Option::None
        },
        None => Option::None,
    }
}

fn index_operand_fact(state: CheckState, node: syntax::NodeId) -> bool {
    let index = state.info.types.len();
    let key = type_fact_source_key(state, node);
    if key.file >= 0 {
        let entries = state.type_fact_source_indices.get_or_insert_with(
            key.file,
            || collections::IndexMap::new(),
        );
        let span = type_fact_span_key(key);
        match entries.get(span) {
            Some(existing) => {
                set_type_fact_index(state, node, existing);
                return true
            },
            None => {
                let _ = entries.insert(span, index);
            },
        }
    }
    set_type_fact_index(state, node, index);
    false
}

fn record_type_expression(state: CheckState, node: syntax::NodeId, type_id: go_types::TypeId) -> () {
    if type_fact_index(state, node).is_some() {
        return
    }
    index_type_fact(state, node, state.info.types.len());
    state.info.types.push(
        TypeFact {
            node,
            type_id,
            extra: Option::None,
            void: false,
            type_expr: true,
            builtin: false,
            value_expr: false,
            nil: false,
            addressable: false,
            assignable: false,
            comma_ok: false,
        },
    )
}

fn record_invalid_type_expression(state: CheckState, node: syntax::NodeId) -> () {
    match type_fact_index(state, node) {
        Some(index) => {
            state.info.types[index].type_id = state.world.invalid;
            state.info.types[index].extra = Option::None;
            state.info.types[index].void = false;
            state.info.types[index].type_expr = true;
            state.info.types[index].builtin = false;
            state.info.types[index].value_expr = false;
            state.info.types[index].nil = false;
            state.info.types[index].addressable = false;
            state.info.types[index].assignable = false;
            state.info.types[index].comma_ok = false;
        },
        None => record_type_expression(state, node, state.world.invalid),
    }
}

fn omit_invalid_operand_facts(state: CheckState) -> () {
    let mut retained_type_count = 0;
    let type_count = state.info.types.len();
    for index in 0..type_count {
        let fact = state.info.types[index];
        if !(fact.value_expr && fact.type_id.value == state.world.invalid.value
            && !state.retained_invalid_type_fact_nodes.contains(fact.node.value))
            && !state.omitted_type_fact_nodes.contains(fact.node.value) {
            state.info.types[retained_type_count] = fact;
            retained_type_count += 1;
        }
    }
    state.info.types.truncate(retained_type_count);
    let mut retained_use_count = 0;
    let use_count = state.info.uses.len();
    for index in 0..use_count {
        let fact = state.info.uses[index];
        if !state.omitted_use_fact_nodes.contains(fact.node.value) {
            state.info.uses[retained_use_count] = fact;
            retained_use_count += 1;
        }
    }
    state.info.uses.truncate(retained_use_count);
    let mut retained_selection_count = 0;
    let selection_count = state.info.selections.len();
    for index in 0..selection_count {
        let fact = state.info.selections[index];
        if !state.omitted_type_fact_nodes.contains(fact.node.value) {
            state.info.selections[retained_selection_count] = fact;
            retained_selection_count += 1;
        }
    }
    state.info.selections.truncate(retained_selection_count);
    rebuild_selection_indices(state)
}

fn refresh_cycle_identifier_facts(state: CheckState) -> () {
    for use_fact in state.info.uses {
        match (type_fact_index(state, use_fact.node), use_fact.object) {
            (Some(index), Some(object_id)) => if state.info.types[index].value_expr
                && state.info.types[index].type_id.value == state.world.invalid.value {
                match go_types::get_object(state.world, object_id) {
                    Some(object) => if object.kind == go_types::ObjectKind::Var
                        && object.type_id.value != state.world.invalid.value
                        && !type_contains_invalid(state, object.type_id) {
                        state.info.types[index].type_id = object.type_id;
                        state.info.types[index].extra = Option::None;
                        state.info.types[index].void = false;
                        state.info.types[index].type_expr = false;
                        state.info.types[index].builtin = false;
                        state.info.types[index].value_expr = true;
                        state.info.types[index].nil = false;
                        state.info.types[index].addressable = true;
                        state.info.types[index].assignable = true;
                        state.info.types[index].comma_ok = false;
                    },
                    None => {},
                }
            },
            _ => {},
        }
    }
}

fn record_use(state: CheckState, node: syntax::NodeId, object: go_types::ObjectId) -> () {
    let _ = state.used_objects.insert(object.value);
    if node.value < 0 || node.value >= state.use_fact_indices.len() {
        return
    }
    let index = state.use_fact_indices[node.value].to_isize();
    if index >= 0 && index < state.info.uses.len() {
        state.info.uses[index].object = Option::Some(object);
        return
    }
    state.use_fact_indices[node.value] = state.info.uses.len().to_i32();
    state.info.uses.push(ObjectFact { node, object: Option::Some(object) })
}

fn diagnostic_at_position(
    state: CheckState,
    node: syntax::NodeId,
    position: isize,
    message: string,
    soft: bool,
) -> () {
    let effective_node = state.diagnostic_override.unwrap_or(node);
    let effective_position = match state.diagnostic_override {
        Some(_) => node_start(state, effective_node),
        None => position,
    };
    match syntax::get_node(state.syntax.arena, effective_node) {
        Some(value) => {
            let file = if value.file.value >= 0 && value.file.value < state.syntax.files.len() {
                state.syntax.files[value.file.value].name
            } else {
                ""
            };
            state.diagnostics.push(
                CheckDiagnostic {
                    file,
                    start: effective_position,
                    end: effective_position,
                    message,
                    soft,
                    secondary: false,
                },
            )
        },
        None => state.diagnostics.push(
            CheckDiagnostic { file: "", start: -1, end: -1, message, soft, secondary: false },
        ),
    }
}

fn diagnostic(state: CheckState, node: syntax::NodeId, message: string, soft: bool) -> () {
    match syntax::get_node(state.syntax.arena, node) {
        Some(value) => diagnostic_at_position(state, node, value.span.start, message, soft),
        None => diagnostic_at_position(state, node, -1, message, soft),
    }
}

fn secondary_diagnostic(state: CheckState, node: syntax::NodeId, message: string) -> () {
    diagnostic(state, node, message, false);
    state.diagnostics[state.diagnostics.len() - 1].secondary = true;
}

fn node_source_text(state: CheckState, node: syntax::NodeId) -> string {
    match syntax::get_node(state.syntax.arena, node) {
        Some(value) => if value.file.value >= 0 && value.file.value < state.syntax.files.len() {
            let name = state.syntax.files[value.file.value].name;
            for source in state.source_texts {
                if source.0 == name && value.span.start >= 0
                    && value.span.end <= source.1.byte_len() {
                    return source.1.byte_slice(value.span.start, value.span.end)
                }
            }
        },
        None => {},
    }
    ""
}

fn struct_type_source_text(state: CheckState, fields: syntax::NodeId) -> string {
    let result = "struct{";
    let values = field_list_nodes(state, fields);
    for index in 0..values.len() {
        if index > 0 {
            result += "; ";
        }
        match field_data(state, values[index]) {
            Some((names, type_node, tag)) => {
                for name_index in 0..names.len() {
                    if name_index > 0 {
                        result += ", ";
                    }
                    result += expression_source_text(state, names[name_index]);
                }
                if !names.is_empty() {
                    result += " ";
                }
                result += expression_source_text(state, type_node);
                match tag {
                    Some(tag) => {
                        result += " " + expression_source_text(state, tag);
                    },
                    None => {},
                }
            },
            None => {
                result += expression_source_text(state, values[index]);
            },
        }
    }
    result + "}"
}

fn expression_source_text(state: CheckState, node: syntax::NodeId) -> string {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::BadExpr { from: _, to: _ }) => return "(ast: *ast.BadExpr)",
        Some(syntax::SyntaxKind::Ident { name_pos: _, name }) => return name,
        Some(syntax::SyntaxKind::BasicLit { value_pos: _, value_end: _, token: _, value }) => return value,
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => return "("
            + expression_source_text(state, expression)
            + ")",
        Some(syntax::SyntaxKind::SelectorExpr { expression, selector }) => return expression_source_text(
            state,
            expression,
        )
            + "."
            + expression_source_text(state, selector),
        Some(syntax::SyntaxKind::IndexExpr { expression, lbrack: _, index, rbrack: _ }) => return expression_source_text(
            state,
            expression,
        )
            + "["
            + expression_source_text(state, index)
            + "]",
        Some(syntax::SyntaxKind::IndexListExpr { expression, lbrack: _, indices, rbrack: _ }) => {
            let result = expression_source_text(state, expression) + "[";
            for index in 0..indices.len() {
                if index > 0 {
                    result += ", ";
                }
                result += expression_source_text(state, indices[index]);
            }
            return result + "]"
        },
        Some(syntax::SyntaxKind::SliceExpr {
            expression,
            lbrack: _,
            low,
            high,
            max,
            slice3,
            rbrack: _,
        }) => {
            let result = expression_source_text(state, expression) + "[";
            match low {
                Some(value) => {
                    result += expression_source_text(state, value);
                },
                None => {},
            }
            result += ":";
            match high {
                Some(value) => {
                    result += expression_source_text(state, value);
                },
                None => {},
            }
            if slice3 {
                result += ":";
                match max {
                    Some(value) => {
                        result += expression_source_text(state, value);
                    },
                    None => {},
                }
            }
            return result + "]"
        },
        Some(syntax::SyntaxKind::CallExpr { function, lparen: _, arguments, ellipsis, rparen: _ }) => {
            let result = expression_source_text(state, function) + "(";
            for index in 0..arguments.len() {
                if index > 0 {
                    result += ", ";
                }
                result += expression_source_text(state, arguments[index]);
                if ellipsis >= 0 && index == arguments.len() - 1 {
                    result += "...";
                }
            }
            return result + ")"
        },
        Some(syntax::SyntaxKind::TypeAssertExpr { expression, lparen: _, type_node, rparen: _ }) => return expression_source_text(
            state,
            expression,
        )
            + ".("
            + match type_node {
                Some(value) => expression_source_text(state, value),
                None => "(ast: <nil>)",
            }
            + ")",
        Some(syntax::SyntaxKind::StructType { struct_pos: _, fields, incomplete: _ }) => return struct_type_source_text(
            state,
            fields,
        ),
        Some(syntax::SyntaxKind::CompositeLit {
            type_node,
            lbrace: _,
            elements,
            rbrace: _,
            incomplete: _,
        }) => {
            let prefix = match type_node {
                Some(value) => expression_source_text(state, value),
                None => "",
            };
            return prefix
                + if elements.is_empty() {
                    "{}"
                } else {
                    "{…}"
                }
        },
        Some(syntax::SyntaxKind::StarExpr { star: _, expression }) => return "*"
            + expression_source_text(state, expression),
        Some(syntax::SyntaxKind::UnaryExpr { op_pos: _, op, expression }) => return op
            + expression_source_text(state, expression),
        Some(syntax::SyntaxKind::BinaryExpr { left, op_pos: _, op, right }) => return expression_source_text(
            state,
            left,
        )
            + " "
            + op
            + " "
            + expression_source_text(state, right),
        Some(syntax::SyntaxKind::ChanType { begin: _, arrow: _, direction, value }) => return if direction
            == 1 {
            "chan<- " + expression_source_text(state, value)
        } else if direction == 2 {
            "<-chan " + expression_source_text(state, value)
        } else {
            "chan " + expression_source_text(state, value)
        },
        _ => {},
    }
    let source = node_source_text(state, node);
    if source == "" {
        return ""
    }
    let result = "";
    for item in scanner::scan(source).tokens {
        if token::equal(item.kind, token::Kind::Comment)
            || token::equal(item.kind, token::Kind::Semicolon)
            || token::equal(item.kind, token::Kind::Eof) {} else if token::equal(
            item.kind,
            token::Kind::Comma,
        ) {
            result += ", ";
        } else if token::equal(item.kind, token::Kind::Add)
            || token::equal(item.kind, token::Kind::Sub)
            || token::equal(item.kind, token::Kind::Mul)
            || token::equal(item.kind, token::Kind::Quo)
            || token::equal(item.kind, token::Kind::Rem)
            || token::equal(item.kind, token::Kind::And)
            || token::equal(item.kind, token::Kind::Or)
            || token::equal(item.kind, token::Kind::Xor)
            || token::equal(item.kind, token::Kind::Shl)
            || token::equal(item.kind, token::Kind::Shr)
            || token::equal(item.kind, token::Kind::AndNot)
            || token::equal(item.kind, token::Kind::Land)
            || token::equal(item.kind, token::Kind::Lor)
            || token::equal(item.kind, token::Kind::Eql)
            || token::equal(item.kind, token::Kind::Lss)
            || token::equal(item.kind, token::Kind::Gtr)
            || token::equal(item.kind, token::Kind::Neq)
            || token::equal(item.kind, token::Kind::Leq)
            || token::equal(item.kind, token::Kind::Geq)
            || token::equal(item.kind, token::Kind::Assign)
            || token::equal(item.kind, token::Kind::Define)
            || token::equal(item.kind, token::Kind::AddAssign)
            || token::equal(item.kind, token::Kind::SubAssign)
            || token::equal(item.kind, token::Kind::MulAssign)
            || token::equal(item.kind, token::Kind::QuoAssign)
            || token::equal(item.kind, token::Kind::RemAssign)
            || token::equal(item.kind, token::Kind::AndAssign)
            || token::equal(item.kind, token::Kind::OrAssign)
            || token::equal(item.kind, token::Kind::XorAssign)
            || token::equal(item.kind, token::Kind::ShlAssign)
            || token::equal(item.kind, token::Kind::ShrAssign)
            || token::equal(item.kind, token::Kind::AndNotAssign) {
            result += " " + item.literal + " ";
        } else {
            result += item.literal;
        }
    }
    result
}

fn void_expression_source_text(state: CheckState, node: syntax::NodeId) -> string {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::CallExpr { function, lparen: _, arguments, ellipsis, rparen: _ }) => match syntax::get_kind(
            state.syntax.arena,
            function,
        ) {
            Some(syntax::SyntaxKind::FuncLit { type_node, body: _ }) => {
                let result = "(" + expression_source_text(state, type_node) + " literal)(";
                for index in 0..arguments.len() {
                    if index > 0 {
                        result += ", ";
                    }
                    result += expression_source_text(state, arguments[index]);
                    if ellipsis >= 0 && index + 1 == arguments.len() {
                        result += "...";
                    }
                }
                result + ")"
            },
            _ => expression_source_text(state, node),
        },
        _ => expression_source_text(state, node),
    }
}

fn identifier(state: CheckState, node: syntax::NodeId) -> Option[string] {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::Ident { name_pos: _, name }) => Option::Some(name),
        _ => Option::None,
    }
}

fn node_file(state: CheckState, node: syntax::NodeId) -> Option[syntax::FileId] {
    if node.value >= 0 && node.value < state.syntax.arena.nodes.len() {
        Option::Some(syntax::node_at(state.syntax.arena, node.value).file)
    } else {
        Option::None
    }
}

fn node_start(state: CheckState, node: syntax::NodeId) -> isize {
    syntax::node_at(state.syntax.arena, node.value).span.start
}

fn effective_file_version(package_version: string, file_version: string) -> string {
    if file_version == "" {
        return package_version
    } else if !file_version.starts_with("go1.") {
        return package_version
    }
    match num::parse_int_structured(file_version.byte_slice(4, file_version.byte_len())) {
        Ok(value) => if value < 21 {
            "go1.21"
        } else {
            file_version
        },
        Err(_) => package_version,
    }
}

fn pending_type_index(state: CheckState, object: go_types::ObjectId) -> Option[isize] {
    state.pending_type_indices[object.value]
}

fn constraint_definition_node(state: CheckState, node: syntax::NodeId) -> bool {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::Ident { name_pos: _, name: _ } | syntax::SyntaxKind::SelectorExpr {
            expression: _,
            selector: _,
        } | syntax::SyntaxKind::InterfaceType { interface_pos: _, methods: _, incomplete: _ }) => true,
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => constraint_definition_node(
            state,
            expression,
        ),
        Some(syntax::SyntaxKind::IndexExpr { expression, lbrack: _, index: _, rbrack: _ } | syntax::SyntaxKind::IndexListExpr {
            expression,
            lbrack: _,
            indices: _,
            rbrack: _,
        }) => constraint_definition_node(state, expression),
        _ => false,
    }
}

fn report_constraint_type_use(
    state: CheckState,
    node: syntax::NodeId,
    name: string,
    type_id: go_types::TypeId,
) -> () {
    diagnostic(
        state,
        node,
        "cannot use type " + name + " outside a type constraint: "
            + if go_types::interface_requires_comparable(state.world, type_id) {
                if go_types::type_set_terms(state.world, type_id).is_empty() {
                    "interface is (or embeds) comparable"
                } else {
                    "interface contains type constraints"
                }
            } else {
                "interface contains type constraints"
            },
        true,
    )
}

fn reject_constraint_type(
    state: CheckState,
    node: syntax::NodeId,
    name: string,
    type_id: go_types::TypeId,
) -> go_types::TypeId {
    if state.constraint_type_depth > 0 || !go_types::is_constraint_interface(state.world, type_id) {
        return type_id
    }
    let invalid = type_contains_invalid(state, type_id);
    if invalid && !go_types::is_named(state.world, type_id) {
        return type_id
    }
    report_constraint_type_use(state, node, name, type_id);
    if invalid {
        type_id
    } else {
        state.world.invalid
    }
}

fn recovered_constraint_type(state: CheckState, node: syntax::NodeId, type_id: go_types::TypeId) -> go_types::TypeId {
    if type_id.value != state.world.invalid.value {
        return type_id
    }
    match recorded_type_fact(state, node) {
        Some(fact) => if go_types::is_constraint_interface(state.world, fact.type_id) {
            fact.type_id
        } else {
            type_id
        },
        None => type_id,
    }
}

fn same_named_origin(state: CheckState, left: go_types::TypeId, right: go_types::TypeId) -> bool {
    match (go_types::get_type(state.world, left), go_types::get_type(state.world, right)) {
        (
            Some(go_types::TypeData {
                id: _,
                kind: go_types::TypeKind::Named {
                    object: left,
                    underlying: _,
                    type_params: _,
                    type_args: _,
                    methods: _,
                },
            }),
            Some(go_types::TypeData {
                id: _,
                kind: go_types::TypeKind::Named {
                    object: right,
                    underlying: _,
                    type_params: _,
                    type_args: _,
                    methods: _,
                },
            }),
        ) => left.value == right.value,
        _ => false,
    }
}

fn invalid_named_type_cycle(
    state: CheckState,
    value: go_types::TypeId,
    target: go_types::TypeId,
    visited: Vec[go_types::TypeId],
) -> bool {
    if value.value == target.value || same_named_origin(state, value, target) {
        return true
    }
    for existing in visited {
        if existing.value == value.value {
            return false
        }
    }
    visited.push(value);
    match go_types::get_type(state.world, go_types::unalias(state.world, value)) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Array { length: _, element } }) => invalid_named_type_cycle(
            state,
            element,
            target,
            visited,
        ),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Struct { fields } }) => {
            for field in fields {
                if invalid_named_type_cycle(state, field.variable.type_id, target, visited) {
                    return true
                }
            }
            false
        },
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object: _,
                underlying,
                type_params: _,
                type_args: _,
                methods: _,
            },
        }) => invalid_named_type_cycle(state, underlying, target, visited),
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Interface {
                methods: _,
                embeddeds,
                comparable: _,
                implicit: _,
            },
        }) => {
            for embedded in embeddeds {
                if invalid_named_type_cycle(state, embedded, target, visited) {
                    return true
                }
            }
            false
        },
        _ => false,
    }
}

fn alias_rhs_is_own_type_parameter(
    state: CheckState,
    rhs: go_types::TypeId,
    type_params: Vec[go_types::TypeParameter],
) -> bool {
    match go_types::get_type(state.world, go_types::unalias(state.world, rhs)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::TypeParam { object, constraint: _, index: _ },
        }) => {
            for parameter in type_params {
                if parameter.object.value == object.value {
                    return true
                }
            }
            false
        },
        _ => false,
    }
}

fn report_type_cycle(state: CheckState, object: go_types::ObjectId) -> () {
    let mut start = -1;
    for index in 0..state.active_type_objects.len() {
        if state.active_type_objects[index].value == object.value {
            start = index;
        }
    }
    if start < 0 {
        return
    }
    let cycle: Vec[go_types::ObjectId] = Vec::new();
    for index in start..state.active_type_objects.len() {
        cycle.push(state.active_type_objects[index])
    }
    for existing in state.deferred_alias_type_cycles {
        if existing.objects.len() == cycle.len() {
            let mut same = true;
            for index in 0..cycle.len() {
                if existing.objects[index].value != cycle[index].value {
                    same = false;
                }
            }
            if same {
                return
            }
        }
    }
    state.deferred_alias_type_cycles.push(TypeValueCycle { objects: cycle })
}

fn direct_alias_cycle_rhs(state: CheckState, node: syntax::NodeId) -> bool {
    if identifier(state, node).is_some() {
        true
    } else {
        match syntax::get_kind(state.syntax.arena, node) {
            Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => direct_alias_cycle_rhs(
                state,
                expression,
            ),
            _ => false,
        }
    }
}

fn direct_alias_cycle(state: CheckState, objects: Vec[go_types::ObjectId]) -> bool {
    if objects.len() < 2 {
        return false
    }
    for object in objects {
        match pending_type_index(state, object) {
            Some(index) => if !state.pending_types[index].alias
                || !direct_alias_cycle_rhs(state, state.pending_types[index].rhs) {
                return false
            },
            None => return false,
        }
    }
    true
}

fn invalidate_direct_alias_cycle(state: CheckState, objects: Vec[go_types::ObjectId]) -> () {
    let mut first = 0;
    for index in 1..objects.len() {
        if object_position(state, objects[index]) < object_position(state, objects[first]) {
            first = index;
        }
    }
    for index in 0..objects.len() {
        match pending_type_index(state, objects[index]) {
            Some(pending_index) => {
                let pending = state.pending_types[pending_index];
                if index == first {
                    if !type_object_used_as_receiver(state, pending.object) {
                        let _ = state.omitted_type_fact_nodes.insert(pending.rhs.value);
                        let _ = state.omitted_use_fact_nodes.insert(pending.rhs.value);
                    }
                    let _ = go_types::set_type(
                        state.world,
                        pending.type_id,
                        go_types::TypeKind::Invalid,
                    );
                    let _ = go_types::set_object_type(
                        state.world,
                        pending.object,
                        state.world.invalid,
                    );
                }
            },
            None => {},
        }
    }
}

fn invalid_type_object_seen(state: CheckState, object: go_types::ObjectId) -> bool {
    for existing in state.invalid_type_objects {
        if existing.value == object.value {
            return true
        }
    }
    false
}

fn type_value_cycle_contains(state: CheckState, object: go_types::ObjectId) -> bool {
    for cycle in state.deferred_type_value_cycles {
        for existing in cycle.objects {
            if existing.value == object.value {
                return true
            }
        }
    }
    false
}

fn record_type_value_cycle(state: CheckState, object: go_types::ObjectId) -> () {
    if state.array_length_depth <= 0 || state.active_type_objects.is_empty() {
        return
    }
    let object_type = match go_types::get_object(state.world, object) {
        Some(value) => if value.kind == go_types::ObjectKind::Var {
            go_types::unalias(state.world, value.type_id)
        } else {
            return
        },
        None => return,
    };
    let recursive_object = match go_types::get_type(state.world, object_type) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object,
                underlying: _,
                type_params: _,
                type_args: _,
                methods: _,
            },
        }) => object,
        _ => return,
    };
    let mut start = -1;
    for index in 0..state.active_type_objects.len() {
        if state.active_type_objects[index].value == recursive_object.value && start < 0 {
            start = index;
        }
    }
    if start < 0 {
        return
    }
    let objects: Vec[go_types::ObjectId] = Vec::new();
    for index in start..state.active_type_objects.len() {
        objects.push(state.active_type_objects[index])
    }
    objects.push(object);
    for cycle in state.deferred_type_value_cycles {
        if cycle.objects.len() == objects.len() {
            let mut same = true;
            for index in 0..objects.len() {
                if cycle.objects[index].value != objects[index].value {
                    same = false;
                }
            }
            if same {
                return
            }
        }
    }
    state.deferred_type_value_cycles.push(TypeValueCycle { objects })
}

fn record_active_type_dependency_cycle(
    state: CheckState,
    object: go_types::ObjectId,
    value_dependency: bool,
) -> () {
    if state.array_length_depth <= 0
        || (!value_dependency && state.array_length_type_cycle_depth > 0)
        || !state.active_value_objects.is_empty() {
        return
    }
    let mut start = -1;
    for index in 0..state.active_type_objects.len() {
        if state.active_type_objects[index].value == object.value && start < 0 {
            start = index;
        }
    }
    if start < 0 {
        return
    }
    let objects: Vec[go_types::ObjectId] = Vec::new();
    for index in start..state.active_type_objects.len() {
        objects.push(state.active_type_objects[index])
    }
    for cycle in state.deferred_type_value_cycles {
        if cycle.objects.len() == objects.len() {
            let mut same = true;
            for index in 0..objects.len() {
                if cycle.objects[index].value != objects[index].value {
                    same = false;
                }
            }
            if same {
                return
            }
        }
    }
    state.deferred_type_value_cycles.push(TypeValueCycle { objects })
}

fn active_type_object_for_value(state: CheckState, value: go_types::TypeId, indirect: bool) -> Option[
    go_types::ObjectId,
] {
    match go_types::get_type(state.world, go_types::unalias(state.world, value)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object,
                underlying: _,
                type_params: _,
                type_args: _,
                methods: _,
            },
        }) => {
            for active in state.active_type_objects {
                if active.value == object.value {
                    return Option::Some(object)
                }
            }
            Option::None
        },
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) => if indirect {
            active_type_object_for_value(state, element, false)
        } else {
            Option::None
        },
        _ => Option::None,
    }
}

fn record_active_value_type_cycle(state: CheckState, value: go_types::TypeId, indirect: bool) -> bool {
    if state.array_length_depth <= 0 {
        return false
    }
    match active_type_object_for_value(state, value, indirect) {
        Some(object) => {
            record_active_type_dependency_cycle(state, object, true);
            true
        },
        None => false,
    }
}

fn record_call_result_type_cycle(
    state: CheckState,
    object: go_types::ObjectId,
    function: Option[go_types::ObjectId],
) -> bool {
    if state.array_length_depth <= 0 {
        return false
    }
    let mut start = -1;
    for index in 0..state.active_type_objects.len() {
        if state.active_type_objects[index].value == object.value && start < 0 {
            start = index;
        }
    }
    if start < 0 {
        return false
    }
    let objects: Vec[go_types::ObjectId] = Vec::new();
    for index in start..state.active_type_objects.len() {
        objects.push(state.active_type_objects[index])
    }
    for value in state.active_value_objects {
        objects.push(value)
    }
    if !state.active_value_objects.is_empty() {
        if let Some(value) = function {
            objects.push(value)
        }
    }
    let omit = state.active_value_objects.is_empty();
    state.deferred_type_value_cycles.push(TypeValueCycle { objects });
    omit
}

fn local_alias_cycle_seen(state: CheckState, object: go_types::ObjectId) -> bool {
    for existing in state.deferred_local_alias_cycles {
        if existing.value == object.value {
            return true
        }
    }
    false
}

fn suppress_deferred_local_alias_bodies(state: CheckState, object: go_types::ObjectId) -> () {
    for association_index in 0..state.deferred_local_alias_bodies.len() {
        if state.deferred_local_alias_body_objects[association_index].value == object.value {
            match state.deferred_function_body_indices[state.deferred_local_alias_bodies[association_index].value] {
                Some(deferred_index) => {
                    state.deferred_function_bodies[deferred_index].emitted = true;
                },
                None => {},
            }
        }
    }
}

fn type_contains_alias_cycle(
    state: CheckState,
    value: go_types::TypeId,
    target: go_types::ObjectId,
    visited: Vec[go_types::TypeId],
) -> bool {
    for existing in visited {
        if existing.value == value.value {
            return false
        }
    }
    visited.push(value);
    match go_types::get_type(state.world, value) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Alias { object, rhs, type_params: _, type_args: _ },
        }) => object.value == target.value || type_contains_alias_cycle(state, rhs, target, visited),
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object,
                underlying,
                type_params: _,
                type_args: _,
                methods: _,
            },
        }) => object.value == target.value
            || type_contains_alias_cycle(state, underlying, target, visited),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Array { length: _, element } }) | Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Slice { element },
        }) | Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) | Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Chan { direction: _, element },
        }) => type_contains_alias_cycle(state, element, target, visited),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Tuple { variables } }) => {
            for variable in variables {
                if type_contains_alias_cycle(state, variable.type_id, target, visited) {
                    return true
                }
            }
            false
        },
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: _,
                receiver_type_params: _,
                type_params: _,
                params,
                results,
                variadic: _,
            },
        }) => type_contains_alias_cycle(state, params, target, visited)
            || type_contains_alias_cycle(state, results, target, visited),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Struct { fields } }) => {
            for field in fields {
                if type_contains_alias_cycle(state, field.variable.type_id, target, visited) {
                    return true
                }
            }
            false
        },
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Map { key, value } }) => type_contains_alias_cycle(
            state,
            key,
            target,
            visited,
        )
            || type_contains_alias_cycle(state, value, target, visited),
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Interface {
                methods: _,
                embeddeds,
                comparable: _,
                implicit: _,
            },
        }) => {
            for embedded in embeddeds {
                if type_contains_alias_cycle(state, embedded, target, visited) {
                    return true
                }
            }
            false
        },
        _ => false,
    }
}

fn type_syntax_contains_named_object(
    state: CheckState,
    type_id: go_types::TypeId,
    target: go_types::ObjectId,
    visited: Vec[isize],
) -> bool {
    for existing in visited {
        if existing == type_id.value {
            return false
        }
    }
    visited.push(type_id.value);
    match go_types::get_type(state.world, type_id) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object,
                underlying: _,
                type_params: _,
                type_args,
                methods: _,
            },
        }) => {
            if object.value == target.value {
                return true
            }
            for argument in type_args {
                if type_syntax_contains_named_object(state, argument, target, visited) {
                    return true
                }
            }
            false
        },
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Alias { object: _, rhs, type_params: _, type_args },
        }) => {
            if type_syntax_contains_named_object(state, rhs, target, visited) {
                return true
            }
            for argument in type_args {
                if type_syntax_contains_named_object(state, argument, target, visited) {
                    return true
                }
            }
            false
        },
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Array { length: _, element } | go_types::TypeKind::Slice {
                element,
            } | go_types::TypeKind::Pointer { element } | go_types::TypeKind::Chan {
                direction: _,
                element,
            },
        }) => type_syntax_contains_named_object(state, element, target, visited),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Map { key, value } }) => type_syntax_contains_named_object(
            state,
            key,
            target,
            visited,
        )
            || type_syntax_contains_named_object(state, value, target, visited),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Tuple { variables } }) => {
            for variable in variables {
                if type_syntax_contains_named_object(state, variable.type_id, target, visited) {
                    return true
                }
            }
            false
        },
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Struct { fields } }) => {
            for field in fields {
                if type_syntax_contains_named_object(state, field.variable.type_id, target, visited) {
                    return true
                }
            }
            false
        },
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver,
                receiver_type_params: _,
                type_params: _,
                params,
                results,
                variadic: _,
            },
        }) => {
            match receiver {
                Some(receiver) => if type_syntax_contains_named_object(
                    state,
                    receiver.type_id,
                    target,
                    visited,
                ) {
                    return true
                },
                None => {},
            }
            type_syntax_contains_named_object(state, params, target, visited)
                || type_syntax_contains_named_object(state, results, target, visited)
        },
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Interface {
                methods: _,
                embeddeds,
                comparable: _,
                implicit: _,
            },
        }) => {
            for embedded in embeddeds {
                if type_syntax_contains_named_object(state, embedded, target, visited) {
                    return true
                }
            }
            false
        },
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Union { terms } }) => {
            for term in terms {
                if type_syntax_contains_named_object(state, term.type_id, target, visited) {
                    return true
                }
            }
            false
        },
        _ => false,
    }
}

fn unresolved_disabled_alias(state: CheckState, object: go_types::ObjectId) -> bool {
    if state.config.enable_alias {
        return false
    }
    if state.active_type_objects.len() == 1 && state.active_type_objects[0].value == object.value {
        return false
    }
    match pending_type_index(state, object) {
        Some(index) => state.pending_types[index].alias && state.pending_types[index].status == 1,
        None => false,
    }
}

fn copied_object_ids(values: Vec[go_types::ObjectId]) -> Vec[go_types::ObjectId] {
    let result: Vec[go_types::ObjectId] = Vec::new();
    for value in values {
        result.push(value)
    }
    result
}

fn named_type_reference_after(
    state: CheckState,
    rhs: syntax::NodeId,
    target: go_types::ObjectId,
    after: isize,
) -> Option[syntax::NodeId] {
    let start = node_start(state, rhs);
    let end = node_end(state, rhs);
    let mut result: Option[syntax::NodeId] = Option::None;
    let mut result_position = end + 1;
    for fact in state.info.uses {
        match fact.object {
            Some(used) => if used.value == target.value {
                let position = node_start(state, fact.node);
                if position >= start && position <= end && position > after
                    && position < result_position {
                    result = Option::Some(fact.node);
                    result_position = position;
                }
            },
            None => {},
        }
    }
    if result.is_some() {
        return result
    }
    let target_name = go_types::get_object(state.world, target)?.name;
    let file = syntax::get_node(state.syntax.arena, rhs)?.file;
    for candidate in state.syntax.arena.nodes {
        if candidate.file.value == file.value && candidate.span.start >= start
            && candidate.span.end <= end
            && candidate.span.start > after
            && candidate.span.start < result_position {
            match candidate.kind {
                syntax::SyntaxKind::Ident { name_pos: _, name } => if name == target_name {
                    result = Option::Some(candidate.id);
                    result_position = candidate.span.start;
                },
                _ => {},
            }
        }
    }
    result
}

fn named_type_reference_in_rhs(
    state: CheckState,
    owner: go_types::ObjectId,
    target: go_types::ObjectId,
    fallback: syntax::NodeId,
) -> syntax::NodeId {
    let pending_index = match pending_type_index(state, owner) {
        Some(index) => state.pending_types[index],
        None => {
            let Some(owner_object) = go_types::get_object(state.world, owner) else {
                return fallback;
            };
            let mut found = Option::None;
            for index in 0..state.pending_types.len() {
                match go_types::get_object(state.world, state.pending_types[index].object) {
                    Some(candidate) => if candidate.name == owner_object.name
                        && match (candidate.owner, owner_object.owner) {
                            (Some(left), Some(right)) => left.value == right.value,
                            (None, None) => true,
                            _ => false,
                        } {
                        found = Option::Some(index);
                    },
                    None => {},
                }
            }
            match found {
                Some(index) => state.pending_types[index],
                None => return fallback,
            }
        },
    };
    let pending = pending_index;
    named_type_reference_after(state, pending.rhs, target, node_start(state, pending.rhs) - 1).unwrap_or(
        fallback,
    )
}

fn named_type_rhs_reference(state: CheckState, object: go_types::ObjectId, fallback: syntax::NodeId) -> syntax::NodeId {
    named_type_reference_in_rhs(state, object, object, fallback)
}

fn report_named_type_cycle(state: CheckState, values: Vec[go_types::ObjectId], preserve_start: bool) -> () {
    let instantiation_root = if values.is_empty() {
        go_types::object_id(-1)
    } else {
        values[0]
    };
    let rotate_instantiated_cycle = preserve_start && values.len() > 1
        && !generic_parameters(
            state,
            match go_types::get_object(state.world, values[0]) {
                Some(object) => object.type_id,
                None => state.world.invalid,
            },
        ).is_empty();
    let mut first = 0;
    if rotate_instantiated_cycle {
        first = 1;
    } else if !preserve_start {
        for index in 1..values.len() {
            if object_position(state, values[index]) < object_position(state, values[first]) {
                first = index;
            }
        }
    }
    let cycle: Vec[go_types::ObjectId] = Vec::new();
    for index in 0..values.len() {
        cycle.push(values[(first + index) % values.len()])
    }
    let cycle_nodes: Vec[Option[syntax::NodeId]] = Vec::new();
    let root_rhs = if preserve_start {
        pending_type_index(state, instantiation_root).map(|index| state.pending_types[index].rhs)
    } else {
        Option::None
    };
    let mut root_position = match root_rhs {
        Some(rhs) => node_start(state, rhs) - 1,
        None => -1,
    };
    for index in 0..cycle.len() {
        let mut selected = go_types::get_object(state.world, cycle[index]).and_then(
            |object| object.node,
        );
        if preserve_start && (index > 0 || rotate_instantiated_cycle) {
            let root_selected = root_rhs.and_then(
                |rhs| named_type_reference_after(state, rhs, cycle[index], root_position),
            );
            match root_selected {
                Some(node) => {
                    selected = Option::Some(node);
                    root_position = node_start(state, node);
                },
                None => match selected {
                    Some(fallback) => {
                        selected = Option::Some(
                            named_type_reference_in_rhs(
                                state,
                                if index == 0 {
                                    instantiation_root
                                } else {
                                    cycle[index - 1]
                                },
                                cycle[index],
                                fallback,
                            ),
                        );
                    },
                    None => {},
                },
            };
        }
        cycle_nodes.push(selected)
    }
    match go_types::get_object(state.world, cycle[0]) {
        Some(first_object) => match first_object.node {
            Some(node) => if cycle.len() == 1 {
                let diagnostic_node = if generic_parameter_count(state, first_object.type_id) == 0 {
                    node
                } else {
                    named_type_rhs_reference(state, cycle[0], node)
                };
                diagnostic(
                    state,
                    diagnostic_node,
                    "invalid recursive type: " + first_object.name + " refers to itself",
                    false,
                )
            } else {
                diagnostic(
                    state,
                    if preserve_start {
                        cycle_nodes[0].unwrap_or(node)
                    } else {
                        node
                    },
                    if first_object.kind == go_types::ObjectKind::TypeName {
                        "invalid recursive type " + first_object.name
                    } else {
                        "invalid cycle in declaration of " + first_object.name
                    },
                    false,
                );
                for index in 0..cycle.len() {
                    match (
                        go_types::get_object(state.world, cycle[index]),
                        go_types::get_object(state.world, cycle[(index + 1) % cycle.len()]),
                    ) {
                        (Some(current), Some(next)) => match cycle_nodes[index] {
                            Some(current_node) => secondary_diagnostic(
                                state,
                                current_node,
                                "\t" + current.name + " refers to " + next.name,
                            ),
                            None => {},
                        },
                        _ => {},
                    }
                }
            },
            None => {},
        },
        None => {},
    }
    for index in 0..cycle.len() {
        if (!preserve_start || index == 0) && !invalid_type_object_seen(state, cycle[index]) {
            state.invalid_type_objects.push(cycle[index])
        }
    }
}

fn validate_named_type_inner(
    state: CheckState,
    value: go_types::TypeId,
    nest: Vec[go_types::TypeId],
    path: Vec[go_types::ObjectId],
) -> bool {
    let resolved = go_types::unalias(state.world, value);
    match go_types::get_type(state.world, resolved) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object,
                underlying,
                type_params: _,
                type_args: _,
                methods: _,
            },
        }) => {
            for index in 0..nest.len() {
                if go_types::identical(state.world, nest[index], resolved) {
                    let cycle: Vec[go_types::ObjectId] = Vec::new();
                    for path_index in index..path.len() {
                        cycle.push(path[path_index])
                    }
                    let mut instantiated = false;
                    for nest_index in index..nest.len() {
                        match go_types::get_type(state.world, nest[nest_index]) {
                            Some(go_types::TypeData {
                                id: _,
                                kind: go_types::TypeKind::Named {
                                    object: _,
                                    underlying: _,
                                    type_params: _,
                                    type_args,
                                    methods: _,
                                },
                            }) => if !type_args.is_empty() {
                                instantiated = true;
                            },
                            _ => {},
                        }
                    }
                    report_named_type_cycle(state, cycle, instantiated);
                    return false
                }
            }
            if invalid_type_object_seen(state, object) {
                return false
            }
            let next_nest = copied_type_ids(nest);
            next_nest.push(resolved);
            let next_path = copied_object_ids(path);
            next_path.push(object);
            validate_named_type_inner(state, underlying, next_nest, next_path)
        },
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Array { length: _, element } }) => validate_named_type_inner(
            state,
            element,
            nest,
            path,
        ),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Struct { fields } }) => {
            let mut valid = true;
            for field in fields {
                if !validate_named_type_inner(state, field.variable.type_id, nest, path) {
                    valid = false;
                }
            }
            valid
        },
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Interface {
                methods: _,
                embeddeds,
                comparable: _,
                implicit: _,
            },
        }) => {
            let mut valid = true;
            for embedded in embeddeds {
                if !validate_named_type_inner(state, embedded, nest, path) {
                    valid = false;
                }
            }
            valid
        },
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Union { terms } }) => {
            let mut valid = true;
            for term in terms {
                if !validate_named_type_inner(state, term.type_id, nest, path) {
                    valid = false;
                }
            }
            valid
        },
        _ => true,
    }
}

fn direct_named_dependency(state: CheckState, object: go_types::ObjectId) -> Option[
    go_types::ObjectId,
] {
    let index = pending_type_index(state, object)?;
    match identifier(state, state.pending_types[index].rhs) {
        Some(name) => match go_types::lookup(
            state.world,
            state.pending_types[index].file_scope,
            name,
        ) {
            Some(value) => pending_type_index(state, value).map(|_| value),
            None => Option::None,
        },
        None => Option::None,
    }
}

fn check_direct_named_type_cycles(state: CheckState) -> () {
    for pending in state.pending_types {
        if pending.alias || invalid_type_object_seen(state, pending.object) {} else {
            let path: Vec[go_types::ObjectId] = Vec::new();
            let mut current = pending.object;
            let mut done = false;
            while !done {
                let mut cycle_start = -1;
                for index in 0..path.len() {
                    if path[index].value == current.value {
                        cycle_start = index;
                    }
                }
                if cycle_start >= 0 {
                    let cycle: Vec[go_types::ObjectId] = Vec::new();
                    for index in cycle_start..path.len() {
                        cycle.push(path[index])
                    }
                    report_named_type_cycle(state, cycle, false);
                    if !cycle.is_empty() {
                        match pending_type_index(state, cycle[0]) {
                            Some(first) => {
                                let rhs = state.pending_types[first].rhs;
                                let _ = state.omitted_type_fact_nodes.insert(rhs.value);
                                let _ = state.omitted_use_fact_nodes.insert(rhs.value);
                            },
                            None => {},
                        }
                        if cycle.len() > 1 {
                            match pending_type_index(state, cycle[cycle.len() - 1]) {
                                Some(last) => record_invalid_type_expression(
                                    state,
                                    state.pending_types[last].rhs,
                                ),
                                None => {},
                            }
                        }
                        let affected: Vec[syntax::NodeId] = Vec::new();
                        for fact in state.info.types {
                            if fact.type_expr
                                && type_syntax_contains_named_object(
                                    state,
                                    fact.type_id,
                                    cycle[0],
                                    Vec::new(),
                                )
                                && match syntax::get_kind(state.syntax.arena, fact.node) {
                                    Some(syntax::SyntaxKind::StarExpr { star: _, expression: _ }) => true,
                                    _ => false,
                                } {
                                affected.push(fact.node)
                            }
                        }
                        let _ = go_types::set_object_type(
                            state.world,
                            cycle[0],
                            state.world.invalid,
                        );
                        match pending_type_index(state, cycle[0]) {
                            Some(index) => match go_types::get_type(
                                state.world,
                                state.pending_types[index].type_id,
                            ) {
                                Some(go_types::TypeData {
                                    id: _,
                                    kind: go_types::TypeKind::Named {
                                        object: _,
                                        underlying: _,
                                        type_params: _,
                                        type_args: _,
                                        methods: _,
                                    },
                                }) => {
                                    let _ = go_types::set_type(
                                        state.world,
                                        state.pending_types[index].type_id,
                                        go_types::TypeKind::Invalid,
                                    );
                                },
                                _ => {},
                            },
                            None => {},
                        }
                        for node in affected {
                            record_invalid_type_expression(state, node)
                        }
                        if !state.config.enable_alias {
                            for member in cycle {
                                match pending_type_index(state, member) {
                                    Some(index) => if state.pending_types[index].alias {
                                        let _ = go_types::set_object_type(
                                            state.world,
                                            member,
                                            state.world.invalid,
                                        );
                                    },
                                    None => {},
                                }
                            }
                        }
                    }
                    done = true;
                } else if invalid_type_object_seen(state, current) {
                    done = true;
                } else {
                    path.push(current);
                    match direct_named_dependency(state, current) {
                        Some(next) => {
                            current = next;
                        },
                        None => {
                            done = true;
                        },
                    }
                }
            }
        }
    }
}

fn check_map_keys_in_type_node(state: CheckState, node: syntax::NodeId) -> () {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::MapType { map_pos: _, key, value }) => {
            match recorded_type_fact(state, key) {
                Some(fact) => if !go_types::comparable(state.world, fact.type_id) {
                    diagnostic(
                        state,
                        key,
                        "invalid map key type " + diagnostic_type_string(state, fact.type_id)
                            + if go_types::is_type_parameter(state.world, fact.type_id) {
                                " (missing comparable constraint)"
                            } else {
                                ""
                            },
                        false,
                    )
                },
                None => {},
            }
            check_map_keys_in_type_node(state, key);
            check_map_keys_in_type_node(state, value)
        },
        Some(syntax::SyntaxKind::ArrayType { lbrack: _, length: _, element }) => check_map_keys_in_type_node(
            state,
            element,
        ),
        Some(syntax::SyntaxKind::StarExpr { star: _, expression }) => check_map_keys_in_type_node(
            state,
            expression,
        ),
        Some(syntax::SyntaxKind::ChanType { begin: _, arrow: _, direction: _, value }) => check_map_keys_in_type_node(
            state,
            value,
        ),
        Some(syntax::SyntaxKind::StructType { struct_pos: _, fields, incomplete: _ }) => for field in field_list_nodes(
            state,
            fields,
        ) {
            if let Some((_, type_node, _)) = field_data(state, field) {
                check_map_keys_in_type_node(state, type_node)
            }
        },
        Some(syntax::SyntaxKind::FieldList { opening: _, list, closing: _ }) => for field in list {
            if let Some((_, type_node, _)) = field_data(state, field) {
                check_map_keys_in_type_node(state, type_node)
            }
        },
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => check_map_keys_in_type_node(
            state,
            expression,
        ),
        _ => {},
    }
}

fn check_deferred_map_keys(state: CheckState, type_id: go_types::TypeId) -> () {
    let object = match go_types::get_type(state.world, go_types::unalias(state.world, type_id)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object,
                underlying: _,
                type_params: _,
                type_args: _,
                methods: _,
            },
        }) => object,
        _ => return,
    };
    let Some(pending_index) = pending_type_index(state, object) else {
        return;
    };
    check_map_keys_in_type_node(state, state.pending_types[pending_index].rhs)
}

fn type_object_used_as_receiver(state: CheckState, object: go_types::ObjectId) -> bool {
    let name = match go_types::get_object(state.world, object) {
        Some(object) => object.name,
        None => return false,
    };
    for node in state.syntax.arena.nodes {
        match node.kind {
            syntax::SyntaxKind::FuncDecl {
                receiver: Some(receiver),
                name: _,
                type_node: _,
                body: _,
            } => {
                let fields = field_list_nodes(state, receiver);
                if fields.len() == 1 {
                    match field_data(state, fields[0]) {
                        Some((_, type_node, _)) => if identifier(
                            state,
                            receiver_type_parts(state, type_node).0,
                        ).unwrap_or("")
                            == name {
                            return true
                        },
                        None => {},
                    }
                }
            },
            _ => {},
        }
    }
    false
}

fn report_deferred_declaration_cycles(state: CheckState) -> () {
    check_direct_named_type_cycles(state);
    let cycles: Vec[TypeValueCycle] = Vec::new();
    for object in state.deferred_direct_type_cycles {
        cycles.push(TypeValueCycle { objects: Vec::from_array([object]) })
    }
    for cycle in state.deferred_type_value_cycles {
        cycles.push(cycle)
    }
    for index in 1..cycles.len() {
        let mut current = index;
        while current > 0 && !cycles[current].objects.is_empty()
            && !cycles[current - 1].objects.is_empty()
            && object_position(state, cycles[current].objects[0])
                < object_position(state, cycles[current - 1].objects[0]) {
            let previous = cycles[current - 1];
            cycles[current - 1] = cycles[current];
            cycles[current] = previous;
            current -= 1;
        }
    }
    for cycle in cycles {
        if !cycle.objects.is_empty() && !invalid_type_object_seen(state, cycle.objects[0]) {
            report_named_type_cycle(state, cycle.objects, false);
            if type_has_expression_array_length(state, cycle.objects[0]) {
                match pending_type_index(state, cycle.objects[0]) {
                    Some(index) => record_invalid_type_expression(
                        state,
                        state.pending_types[index].rhs,
                    ),
                    None => {},
                }
            }
        }
    }
    for cycle in state.deferred_type_value_cycles {
        let mut value_object = false;
        for object in cycle.objects {
            match go_types::get_object(state.world, object) {
                Some(object) => if object.kind != go_types::ObjectKind::TypeName {
                    value_object = true;
                },
                None => {},
            }
        }
        if value_object {
            for object in cycle.objects {
                let invalidate = match go_types::get_object(state.world, object) {
                    Some(value) => (value.kind != go_types::ObjectKind::TypeName
                        && value.kind != go_types::ObjectKind::Func)
                        || object.value == cycle.objects[0].value,
                    None => false,
                };
                if !invalidate {
                    continue
                }
                let omit_uses = match go_types::get_object(state.world, object) {
                    Some(object) => object.kind != go_types::ObjectKind::TypeName,
                    None => false,
                };
                if omit_uses {
                    for fact in state.info.uses {
                        match fact.object {
                            Some(used) => if used.value == object.value {
                                let _ = state.omitted_type_fact_nodes.insert(fact.node.value);
                            },
                            None => {},
                        }
                    }
                }
                match go_types::get_object(state.world, object) {
                    Some(value) => match go_types::get_type(state.world, value.type_id) {
                        Some(go_types::TypeData {
                            id: _,
                            kind: go_types::TypeKind::Named {
                                object: _,
                                underlying,
                                type_params: _,
                                type_args: _,
                                methods: _,
                            },
                        }) => {
                            set_interface_method_receivers(state, underlying, underlying);
                            let affected: Vec[syntax::NodeId] = Vec::new();
                            for fact in state.info.types {
                                if fact.type_expr && fact.type_id.value == value.type_id.value {
                                    affected.push(fact.node)
                                }
                            }
                            for node in affected {
                                record_invalid_type_expression(state, node)
                            }
                            let _ = go_types::set_type(
                                state.world,
                                value.type_id,
                                go_types::TypeKind::Invalid,
                            );
                        },
                        _ => {},
                    },
                    None => {},
                }
                let _ = go_types::set_object_type(state.world, object, state.world.invalid);
            }
        }
    }
    for cycle in state.deferred_alias_type_cycles {
        if !cycle.objects.is_empty() && !invalid_type_object_seen(state, cycle.objects[0]) {
            if type_object_used_as_receiver(state, cycle.objects[0]) {
                let start = state.diagnostics.len();
                report_named_type_cycle(state, cycle.objects, false);
                let diagnostics = take_diagnostics_from(state, start);
                for value in diagnostics {
                    state.deferred_receiver_cycle_diagnostics.push(value)
                }
            } else {
                report_named_type_cycle(state, cycle.objects, false)
            }
        }
        if state.config.enable_alias && direct_alias_cycle(state, cycle.objects) {
            invalidate_direct_alias_cycle(state, cycle.objects)
        } else if !state.config.enable_alias {
            for object in cycle.objects {
                match pending_type_index(state, object) {
                    Some(index) => if state.pending_types[index].alias {
                        match syntax::get_kind(state.syntax.arena, state.pending_types[index].rhs) {
                            Some(syntax::SyntaxKind::StarExpr { star: _, expression }) => {
                                record_invalid_type_expression(state, expression);
                                record_invalid_type_expression(
                                    state,
                                    state.pending_types[index].rhs,
                                )
                            },
                            _ => {},
                        }
                        match go_types::get_object(state.world, object) {
                            Some(value) => match go_types::get_type(state.world, value.type_id) {
                                Some(go_types::TypeData {
                                    id: _,
                                    kind: go_types::TypeKind::Interface {
                                        methods: _,
                                        embeddeds: _,
                                        comparable: _,
                                        implicit: _,
                                    },
                                }) => {
                                    let _ = go_types::set_type(
                                        state.world,
                                        state.pending_types[index].type_id,
                                        go_types::TypeKind::Invalid,
                                    );
                                    set_interface_method_receivers(
                                        state,
                                        value.type_id,
                                        value.type_id,
                                    )
                                },
                                _ => {
                                    let _ = go_types::set_object_type(
                                        state.world,
                                        object,
                                        state.world.invalid,
                                    );
                                },
                            },
                            None => {},
                        }
                    },
                    None => {},
                }
            }
        } else if cycle.objects.len() == 1 {
            let object = cycle.objects[0];
            match pending_type_index(state, object) {
                Some(index) => {
                    if direct_alias_cycle_rhs(state, state.pending_types[index].rhs) {
                        let rhs = state.pending_types[index].rhs;
                        let _ = state.omitted_type_fact_nodes.insert(rhs.value);
                        let _ = state.omitted_use_fact_nodes.insert(rhs.value);
                    }
                    match syntax::get_kind(state.syntax.arena, state.pending_types[index].rhs) {
                        Some(syntax::SyntaxKind::StarExpr { star: _, expression: _ }) => record_invalid_type_expression(
                            state,
                            state.pending_types[index].rhs,
                        ),
                        _ => {},
                    }
                    let _ = go_types::set_type(
                        state.world,
                        state.pending_types[index].type_id,
                        go_types::TypeKind::Invalid,
                    );
                    let _ = go_types::set_object_type(state.world, object, state.world.invalid);
                },
                None => {},
            }
        }
    }
}

fn omit_expression_array_cycle_composite_facts(state: CheckState) -> () {
    for cycle in state.deferred_type_value_cycles {
        if cycle.objects.len() < 2 || !type_has_expression_array_length(state, cycle.objects[0]) {
            continue
        }
        for fact in state.info.types {
            let composite = match syntax::get_kind(state.syntax.arena, fact.node) {
                Some(syntax::SyntaxKind::CompositeLit {
                    type_node: _,
                    lbrace: _,
                    elements: _,
                    rbrace: _,
                    incomplete: _,
                }) => fact.value_expr,
                _ => false,
            };
            if composite {
                match go_types::get_type(state.world, go_types::unalias(state.world, fact.type_id)) {
                    Some(go_types::TypeData {
                        id: _,
                        kind: go_types::TypeKind::Named {
                            object,
                            underlying: _,
                            type_params: _,
                            type_args: _,
                            methods: _,
                        },
                    }) => for member in cycle.objects {
                        if member.value == object.value {
                            let _ = state.omitted_type_fact_nodes.insert(fact.node.value);
                        }
                    },
                    _ => {},
                }
            }
        }
    }
}

fn check_deferred_type_validations(state: CheckState) -> () {
    for type_id in state.deferred_type_validations {
        check_deferred_map_keys(state, type_id);
        let _ = validate_named_type_inner(state, type_id, Vec::new(), Vec::new());
        match go_types::type_data(state.world, go_types::unalias(state.world, type_id)) {
            go_types::TypeData {
                id: _,
                kind: go_types::TypeKind::Named {
                    object,
                    underlying: _,
                    type_params: _,
                    type_args: _,
                    methods: _,
                },
            } => {
                report_deferred_interface_method_diagnostics(state, object);
                report_deferred_interface_overlap_diagnostics(state, object);
                report_deferred_interface_version_diagnostics(state, object)
            },
            _ => {},
        }
    }
}

fn report_deferred_interface_overlap_diagnostics(state: CheckState, object: go_types::ObjectId) -> () {
    for index in 0..state.deferred_interface_overlap_diagnostics.len() {
        let deferred = state.deferred_interface_overlap_diagnostics[index];
        if deferred.object.value == object.value && !deferred.emitted {
            state.deferred_interface_overlap_diagnostics[index].emitted = true;
            diagnostic(state, deferred.node, "duplicate method " + deferred.name, false);
            secondary_diagnostic(
                state,
                deferred.other,
                "\tother declaration of method " + deferred.name,
            )
        }
    }
}

fn report_deferred_interface_version_diagnostics(state: CheckState, object: go_types::ObjectId) -> () {
    for index in 0..state.deferred_interface_version_diagnostics.len() {
        let deferred = state.deferred_interface_version_diagnostics[index];
        if deferred.object.value == object.value && !deferred.emitted {
            state.deferred_interface_version_diagnostics[index].emitted = true;
            diagnostic(
                state,
                deferred.node,
                if deferred.generic_element {
                    "embedding interface element "
                } else {
                    "embedding non-interface type "
                }
                    + diagnostic_type_string(state, deferred.type_id)
                    + " requires go1.18 or later",
                false,
            )
        }
    }
}

fn report_deferred_constraint_type_uses(state: CheckState) -> () {
    for pending in state.deferred_constraint_type_uses {
        if go_types::is_constraint_interface(state.world, pending.type_id) {
            report_constraint_type_use(
                state,
                pending.node,
                diagnostic_type_string(state, pending.type_id),
                pending.type_id,
            )
        }
    }
}

fn report_deferred_interface_method_diagnostics(state: CheckState, object: go_types::ObjectId) -> () {
    for index in 0..state.deferred_interface_method_diagnostics.len() {
        let deferred = state.deferred_interface_method_diagnostics[index];
        if deferred.object.value == object.value && !deferred.emitted {
            state.deferred_interface_method_diagnostics[index].emitted = true;
            let name = identifier(state, deferred.node).unwrap_or("");
            diagnostic(state, deferred.node, "duplicate method " + name, false);
            match go_types::get_object(state.world, deferred.existing) {
                Some(existing) => match existing.node {
                    Some(existing) => secondary_diagnostic(
                        state,
                        existing,
                        "\tother declaration of method " + name,
                    ),
                    None => {},
                },
                None => {},
            }
        }
    }
}

fn take_diagnostics_from(state: CheckState, start: isize) -> Vec[CheckDiagnostic] {
    let result: Vec[CheckDiagnostic] = Vec::new();
    for index in start..state.diagnostics.len() {
        result.push(state.diagnostics[index])
    }
    while state.diagnostics.len() > start {
        let _ = state.diagnostics.pop();
    }
    result
}

fn diagnostics_share_method_receiver(
    state: CheckState,
    left: CheckDiagnostic,
    right: CheckDiagnostic,
) -> bool {
    if left.file != right.file {
        return false
    }
    for node in state.syntax.arena.nodes {
        match node.kind {
            syntax::SyntaxKind::FuncDecl {
                receiver: Some(receiver),
                name: _,
                type_node: _,
                body: _,
            } => if syntax::has_node(state.syntax.arena, receiver) {
                let receiver = syntax::node_at(state.syntax.arena, receiver.value);
                if left.start >= receiver.span.start && left.start < receiver.span.end
                    && right.start >= receiver.span.start
                    && right.start < receiver.span.end {
                    return true
                }
            },
            _ => {},
        }
    }
    false
}

fn direct_alias_rhs(state: CheckState, node: syntax::NodeId) -> bool {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::Ident { name_pos: _, name: _ }) => true,
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => direct_alias_rhs(
            state,
            expression,
        ),
        _ => false,
    }
}

fn direct_alias_cycle_diagnostic(state: CheckState, value: CheckDiagnostic) -> bool {
    if !value.message.starts_with("invalid recursive type")
        && !value.message.contains(" refers to ") {
        return false
    }
    for pending in state.pending_types {
        if pending.alias && direct_alias_rhs(state, pending.rhs) {
            match go_types::get_object(state.world, pending.object) {
                Some(object) => if object.position == value.start {
                    match object.file {
                        Some(file) => if file.value >= 0 && file.value < state.syntax.files.len()
                            && state.syntax.files[file.value].name == value.file {
                            return true
                        },
                        None => {},
                    }
                },
                None => {},
            }
        }
    }
    false
}

fn diagnostic_type_object(state: CheckState, value: CheckDiagnostic) -> Option[go_types::ObjectId] {
    for pending in state.pending_types {
        match go_types::get_object(state.world, pending.object) {
            Some(object) => if object.position == value.start
                && match object.file {
                    Some(file) => file.value >= 0 && file.value < state.syntax.files.len()
                        && state.syntax.files[file.value].name == value.file,
                    None => false,
                } {
                return Option::Some(pending.object)
            },
            None => {},
        }
    }
    Option::None
}

fn type_has_expression_array_length(state: CheckState, object: go_types::ObjectId) -> bool {
    let pending = match pending_type_index(state, object) {
        Some(index) => state.pending_types[index],
        None => return false,
    };
    match syntax::get_kind(state.syntax.arena, pending.rhs) {
        Some(syntax::SyntaxKind::ArrayType { lbrack: _, length: Some(length), element: _ }) => match syntax::get_kind(
            state.syntax.arena,
            length,
        ) {
            Some(syntax::SyntaxKind::BasicLit { value_pos: _, value_end: _, token: _, value: _ }) => false,
            _ => true,
        },
        _ => false,
    }
}

fn recursive_cycle_diagnostic_rank(state: CheckState, value: CheckDiagnostic) -> isize {
    if value.message.starts_with("invalid use of type alias") {
        return 1
    }
    if !value.message.starts_with("invalid recursive type") {
        return -1
    }
    let Some(object) = diagnostic_type_object(state, value) else {
        return 3;
    };
    if type_object_used_as_receiver(state, object) {
        return -1
    }
    if direct_named_dependency(state, object).is_some() {
        return 0
    } else if type_has_expression_array_length(state, object) {
        return 1
    }
    for cycle in state.deferred_type_value_cycles {
        for member in cycle.objects {
            if member.value == object.value {
                return 1
            }
        }
    }
    for member in state.deferred_direct_type_cycles {
        if member.value == object.value {
            return 1
        }
    }
    3
}

fn diagnostic_before(state: CheckState, left: CheckDiagnostic, right: CheckDiagnostic) -> bool {
    let left_cycle_rank = recursive_cycle_diagnostic_rank(state, left);
    let right_cycle_rank = recursive_cycle_diagnostic_rank(state, right);
    if (left_cycle_rank >= 0) != (right_cycle_rank >= 0)
        && diagnostic_in_type_declaration(state, left)
        && diagnostic_in_type_declaration(state, right)
        && if left_cycle_rank >= 0 {
            left_cycle_rank > 0
        } else {
            right_cycle_rank > 0
        } {
        diagnostic_declaration_position(state, left) < diagnostic_declaration_position(state, right)
    } else if (type_argument_count_diagnostic(left) && right_cycle_rank >= 0)
        || (left_cycle_rank >= 0 && type_argument_count_diagnostic(right)) {
        diagnostic_declaration_position(state, left) < diagnostic_declaration_position(state, right)
    } else if left_cycle_rank >= 0 && right_cycle_rank >= 0 {
        if left_cycle_rank != right_cycle_rank {
            left_cycle_rank < right_cycle_rank
        } else {
            left.start < right.start
        }
    } else if left_cycle_rank >= 0 {
        true
    } else if right_cycle_rank >= 0 {
        false
    } else {
        diagnostic_declaration_position(state, left) < diagnostic_declaration_position(state, right)
    }
}

fn sort_diagnostics_by_position(state: CheckState, values: Vec[CheckDiagnostic]) -> () {
    let mut index = 0;
    while index < values.len() {
        let mut end = index + 1;
        while end < values.len() && values[end].secondary {
            end += 1;
        }
        if values[index].secondary {
            index = end;
            continue
        }
        let mut target = index;
        let mut candidate = 0;
        while candidate < index {
            if diagnostic_before(state, values[index], values[candidate])
                && !diagnostics_share_method_receiver(state, values[index], values[candidate]) {
                if values[index].soft && values[candidate].soft
                    && values[index].message.contains(" does not satisfy ")
                    && values[candidate].message.contains(" does not satisfy ")
                    && diagnostic_in_type_declaration(state, values[index])
                    && diagnostic_in_type_declaration(state, values[candidate]) {
                    break
                } else {
                    target = candidate;
                    break
                }
            }
            candidate += 1;
            while candidate < index && values[candidate].secondary {
                candidate += 1;
            }
        }
        if target < index {
            for offset in 0..end - index {
                let mut source = index + offset;
                while source > target + offset {
                    let previous = values[source - 1];
                    values[source - 1] = values[source];
                    values[source] = previous;
                    source -= 1;
                }
            }
        }
        index = end;
    }
}

fn reorder_duplicate_method_diagnostics(state: CheckState, values: Vec[CheckDiagnostic]) -> () {
    let mut index = 0;
    while index < values.len() {
        let mut end = index + 1;
        while end < values.len() && values[end].secondary {
            end += 1;
        }
        if !values[index].secondary && values[index].message.contains("duplicate method") {
            let mut target = index;
            let mut candidate = 0;
            while candidate < index {
                if !values[candidate].secondary
                    && diagnostic_declaration_position(state, values[index])
                        < diagnostic_declaration_position(state, values[candidate]) {
                    target = candidate;
                    break
                }
                candidate += 1;
                while candidate < index && values[candidate].secondary {
                    candidate += 1;
                }
            }
            if target < index {
                for offset in 0..end - index {
                    let mut source = index + offset;
                    while source > target + offset {
                        let previous = values[source - 1];
                        values[source - 1] = values[source];
                        values[source] = previous;
                        source -= 1;
                    }
                }
                index = target + end - index;
            } else {
                index = end;
            }
        } else {
            index = end;
        }
    }
}

fn deferred_interface_overlap_diagnostic(state: CheckState, value: CheckDiagnostic) -> bool {
    for deferred in state.deferred_interface_overlap_diagnostics {
        let node = if value.secondary {
            deferred.other
        } else {
            deferred.node
        };
        if node_start(state, node) == value.start {
            return true
        }
    }
    false
}

fn type_argument_count_diagnostic(value: CheckDiagnostic) -> bool {
    value.message.starts_with("not enough type arguments for type ")
        || value.message.starts_with("too many type arguments for type ")
}

fn sort_type_argument_count_runs(values: Vec[CheckDiagnostic]) -> () {
    let mut start = 0;
    while start < values.len() {
        if !type_argument_count_diagnostic(values[start]) {
            start += 1;
        } else {
            let mut end = start + 1;
            while end < values.len() && type_argument_count_diagnostic(values[end]) {
                end += 1;
            }
            for index in start + 1..end {
                let mut current = index;
                while current > start && values[current].start < values[current - 1].start {
                    let previous = values[current - 1];
                    values[current - 1] = values[current];
                    values[current] = previous;
                    current -= 1;
                }
            }
            start = end;
        }
    }
}

fn reorder_type_argument_cycle_diagnostics(state: CheckState, values: Vec[CheckDiagnostic]) -> () {
    for index in 0..values.len() {
        if type_argument_count_diagnostic(values[index]) {
            let mut current = index;
            while current > 0 && recursive_cycle_diagnostic_rank(state, values[current - 1]) >= 0
                && diagnostic_declaration_position(state, values[current])
                    < diagnostic_declaration_position(state, values[current - 1]) {
                let previous = values[current - 1];
                values[current - 1] = values[current];
                values[current] = previous;
                current -= 1;
            }
        }
    }
}

fn diagnostic_declaration_position(state: CheckState, value: CheckDiagnostic) -> isize {
    for file in state.syntax.files {
        if file.name == value.file {
            match syntax::get_kind(state.syntax.arena, file.root) {
                Some(syntax::SyntaxKind::File {
                    package_pos: _,
                    name: _,
                    declarations,
                    imports: _,
                    go_version: _,
                }) => for declaration in declarations {
                    if syntax::has_node(state.syntax.arena, declaration) {
                        let node = syntax::node_at(state.syntax.arena, declaration.value);
                        if value.start >= node.span.start && value.start <= node.span.end {
                            match node.kind {
                                syntax::SyntaxKind::FuncDecl {
                                    receiver: None,
                                    name,
                                    type_node: _,
                                    body: _,
                                } => match declared_object(state, name) {
                                    Some(object) => {
                                        let mut position = node.span.start;
                                        for fact in state.info.uses {
                                            match fact.object {
                                                Some(used) => if used.value == object.value {
                                                    let use_position = node_start(state, fact.node);
                                                    for other_file in state.syntax.files {
                                                        match syntax::get_kind(
                                                            state.syntax.arena,
                                                            other_file.root,
                                                        ) {
                                                            Some(syntax::SyntaxKind::File {
                                                                package_pos: _,
                                                                name: _,
                                                                declarations: other_declarations,
                                                                imports: _,
                                                                go_version: _,
                                                            }) => for other in other_declarations {
                                                                if syntax::has_node(
                                                                    state.syntax.arena,
                                                                    other,
                                                                ) {
                                                                    let other_node = syntax::node_at(
                                                                        state.syntax.arena,
                                                                        other.value,
                                                                    );
                                                                    if use_position
                                                                        >= other_node.span.start
                                                                        && use_position
                                                                            <= other_node.span.end
                                                                        && other_node.span.start
                                                                            < position {
                                                                        position = other_node.span.start;
                                                                    }
                                                                }
                                                            },
                                                            _ => {},
                                                        }
                                                    }
                                                },
                                                None => {},
                                            }
                                        }
                                        return position
                                    },
                                    None => {},
                                },
                                _ => {},
                            }
                            return node.span.start
                        }
                    }
                },
                _ => {},
            }
        }
    }
    value.start
}

fn diagnostic_in_type_declaration(state: CheckState, value: CheckDiagnostic) -> bool {
    for file in state.syntax.files {
        if file.name == value.file {
            match syntax::get_kind(state.syntax.arena, file.root) {
                Some(syntax::SyntaxKind::File {
                    package_pos: _,
                    name: _,
                    declarations,
                    imports: _,
                    go_version: _,
                }) => for declaration in declarations {
                    match syntax::get_kind(state.syntax.arena, declaration) {
                        Some(syntax::SyntaxKind::GenDecl {
                            token_pos: _,
                            token,
                            lparen: _,
                            specs,
                            rparen: _,
                        }) => if token == TYPE_KEYWORD {
                            for spec in specs {
                                match syntax::get_node(state.syntax.arena, spec) {
                                    Some(node) => if value.start >= node.span.start
                                        && value.start <= node.span.end {
                                        return true
                                    },
                                    None => {},
                                }
                            }
                        },
                        _ => {},
                    }
                },
                _ => {},
            }
        }
    }
    false
}

fn evaluate_type_object(state: CheckState, object: go_types::ObjectId) -> bool {
    let Some(index) = pending_type_index(state, object) else {
        return true;
    };
    if state.pending_types[index].status == 2 {
        return true
    } else if state.pending_types[index].status == 3 {
        return false
    } else if state.pending_types[index].status == 1 {
        if !state.pending_types[index].alias || state.type_parameter_cycle_depth > 0
            || (state.pending_types[index].alias && state.type_cycle_depth > 0
                && state.named_type_depth > 0) {
            record_active_type_dependency_cycle(state, object, false);
            return true
        } else {
            report_type_cycle(state, object);
            return false
        }
    }
    state.pending_types[index].status = 1;
    let pending = state.pending_types[index];
    state.active_type_objects.push(pending.object);
    let existing_methods = match go_types::get_type(state.world, pending.type_id) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object: _,
                underlying: _,
                type_params: _,
                type_args: _,
                methods,
            },
        }) => methods,
        _ => Vec::new(),
    };
    let type_scope = match pending.type_params_node {
        Some(_) => {
            let scope = go_types::add_scope(
                state.world,
                go_types::ScopeKind::Block,
                Option::Some(pending.file_scope),
                node_file(state, pending.declaration_node),
                node_start(state, pending.declaration_node),
                node_end(state, pending.declaration_node),
            );
            record_scope_fact(state, pending.declaration_node, scope);
            scope
        },
        None => pending.file_scope,
    };
    let type_parameter_bindings = declare_type_parameters(
        state,
        type_scope,
        pending.type_params_node,
    );
    if !type_parameter_bindings.is_empty() {
        match go_types::get_object(state.world, type_parameter_bindings[0].object) {
            Some(object) => match object.node {
                Some(node) => if pending.alias && !go_version_at_least(state, node, 23) {
                    diagnostic(state, node, "generic type alias requires go1.23 or later", false)
                } else if !go_version_at_least(state, node, 18) {
                    diagnostic(state, node, "type parameter requires go1.18 or later", false)
                },
                None => {},
            },
            None => {},
        }
    }
    let provisional_type_params = provisional_type_parameters(
        type_parameter_bindings,
        state.world.invalid,
    );
    let placeholder_kind = if pending.alias {
        go_types::TypeKind::Alias {
            object: pending.object,
            rhs: state.world.invalid,
            type_params: provisional_type_params,
            type_args: Vec::new(),
        }
    } else {
        go_types::TypeKind::Named {
            object: pending.object,
            underlying: state.world.invalid,
            type_params: provisional_type_params,
            type_args: Vec::new(),
            methods: existing_methods,
        }
    };
    let _ = go_types::set_type(state.world, pending.type_id, placeholder_kind);
    let type_params = complete_type_parameters(state, type_scope, type_parameter_bindings);
    let _ = go_types::set_type(
        state.world,
        pending.type_id,
        if pending.alias {
            go_types::TypeKind::Alias {
                object: pending.object,
                rhs: state.world.invalid,
                type_params,
                type_args: Vec::new(),
            }
        } else {
            go_types::TypeKind::Named {
                object: pending.object,
                underlying: state.world.invalid,
                type_params,
                type_args: Vec::new(),
                methods: existing_methods,
            }
        },
    );
    if !pending.alias {
        state.named_type_depth += 1;
    }
    let constraint_definition = constraint_definition_node(state, pending.rhs);
    if constraint_definition {
        state.constraint_type_depth += 1;
    }
    let rhs = resolve_type(state, type_scope, pending.rhs);
    if constraint_definition {
        state.constraint_type_depth -= 1;
    }
    if !pending.alias {
        state.named_type_depth -= 1;
    }
    if rhs.value == state.world.invalid.value {
        if pending.alias {
            let _ = state.omitted_type_fact_nodes.remove(pending.rhs.value);
            record_invalid_type_expression(state, pending.rhs)
        }
        if pending.alias && !state.config.enable_alias {
            let _ = go_types::set_object_type(state.world, pending.object, state.world.invalid);
        }
        state.active_type_objects.pop();
        state.pending_types[index].status = 3;
        false
    } else if pending.alias && alias_rhs_is_own_type_parameter(state, rhs, type_params) {
        diagnostic(
            state,
            pending.rhs,
            "cannot use type parameter declared in alias declaration as RHS",
            false,
        );
        state.active_type_objects.pop();
        state.pending_types[index].status = 3;
        false
    } else {
        if !pending.alias && alias_rhs_is_own_type_parameter(state, rhs, type_params) {
            diagnostic(
                state,
                pending.rhs,
                "cannot use a type parameter as RHS in type declaration",
                false,
            )
        }
        let completed_rhs = if !pending.alias && go_types::is_interface(state.world, rhs) {
            if direct_interface_type_syntax(state, pending.rhs) {
                set_interface_method_receivers(state, rhs, pending.type_id);
                rhs
            } else {
                clone_interface_with_method_receivers(state, rhs, pending.type_id)
            }
        } else {
            rhs
        };
        let kind = if pending.alias {
            go_types::TypeKind::Alias {
                object: pending.object,
                rhs,
                type_params,
                type_args: Vec::new(),
            }
        } else {
            go_types::TypeKind::Named {
                object: pending.object,
                underlying: completed_rhs,
                type_params,
                type_args: Vec::new(),
                methods: existing_methods,
            }
        };
        let _ = go_types::set_type(state.world, pending.type_id, kind);
        if pending.alias && !state.config.enable_alias {
            let _ = go_types::set_object_type(state.world, pending.object, rhs);
        }
        if !pending.alias {
            go_types::refresh_named_instances(state.world, pending.type_id);
            normalize_named_type_parameter_constraints(state, pending.type_id);
            state.deferred_type_validations.push(pending.type_id)
        }
        state.active_type_objects.pop();
        state.pending_types[index].status = 2;
        true
    }
}

fn pending_function_index(state: CheckState, object: go_types::ObjectId) -> Option[isize] {
    state.pending_function_indices[object.value]
}

fn evaluate_function_object(state: CheckState, object: go_types::ObjectId) -> bool {
    let Some(index) = pending_function_index(state, object) else {
        return true;
    };
    if state.pending_functions[index].status == 2 {
        return true
    } else if state.pending_functions[index].status == 3 {
        return false
    } else if state.pending_functions[index].status == 1 {
        return true
    }
    state.pending_functions[index].status = 1;
    let pending = state.pending_functions[index];
    let empty = go_types::add_type(state.world, go_types::TypeKind::Tuple { variables: Vec::new() });
    let provisional = go_types::add_type(
        state.world,
        go_types::TypeKind::Signature {
            receiver: Option::None,
            receiver_type_params: Vec::new(),
            type_params: Vec::new(),
            params: empty,
            results: empty,
            variadic: false,
        },
    );
    let _ = go_types::set_object_type(state.world, pending.object, provisional);
    state.active_function_objects.push(pending.object);
    let signature = resolve_function_signature(state, pending.file_scope, pending.type_node, false);
    state.active_function_objects.pop();
    if signature.value == state.world.invalid.value {
        let _ = go_types::set_object_type(state.world, pending.object, state.world.invalid);
        state.pending_functions[index].status = 3;
        false
    } else {
        match go_types::type_data(state.world, signature) {
            go_types::TypeData {
                id: _,
                kind: go_types::TypeKind::Signature {
                    receiver,
                    receiver_type_params,
                    type_params,
                    params,
                    results,
                    variadic,
                },
            } => {
                let _ = go_types::set_type(
                    state.world,
                    provisional,
                    go_types::TypeKind::Signature {
                        receiver,
                        receiver_type_params,
                        type_params,
                        params,
                        results,
                        variadic,
                    },
                );
            },
            _ => {},
        }
        let _ = go_types::set_object_type(state.world, pending.object, provisional);
        state.pending_functions[index].status = 2;
        true
    }
}

fn check_init_function_signatures(state: CheckState) -> () {
    for pending in state.pending_functions {
        match go_types::get_object(state.world, pending.object) {
            Some(object) => if object.name == "init" {
                match syntax::get_kind(state.syntax.arena, pending.type_node) {
                    Some(syntax::SyntaxKind::FuncType {
                        func_pos: _,
                        type_params: _,
                        params,
                        results,
                    }) => if !field_list_nodes(state, params).is_empty()
                        || match results {
                            Some(results) => match syntax::get_kind(state.syntax.arena, results) {
                                Some(syntax::SyntaxKind::FieldList { opening: _, list, closing: _ }) => !list.is_empty(),
                                _ => true,
                            },
                            None => false,
                        } {
                        match object.node {
                            Some(node) => diagnostic(
                                state,
                                node,
                                "func init must have no arguments and no return values",
                                true,
                            ),
                            None => {},
                        }
                    },
                    _ => {},
                }
            },
            None => {},
        }
    }
}

fn check_main_function_signature(state: CheckState, name: syntax::NodeId, type_node: syntax::NodeId) -> () {
    if state.world.packages[state.package_id.value].name != "main"
        || identifier(state, name).unwrap_or("") != "main" {
        return
    }
    match syntax::get_kind(state.syntax.arena, type_node) {
        Some(syntax::SyntaxKind::FuncType { func_pos: _, type_params, params, results }) => {
            match type_params {
                Some(type_params) => if !field_list_nodes(state, type_params).is_empty() {
                    diagnostic(
                        state,
                        field_list_nodes(state, type_params)[0],
                        "func main must have no type parameters",
                        true,
                    )
                },
                None => {},
            }
            if !field_list_nodes(state, params).is_empty()
                || match results {
                    Some(results) => !field_list_nodes(state, results).is_empty(),
                    None => false,
                } {
                diagnostic(
                    state,
                    name,
                    "func main must have no arguments and no return values",
                    true,
                )
            }
        },
        _ => {},
    }
}

fn non_type_object_name(state: CheckState, object_id: go_types::ObjectId, object: go_types::Object) -> string {
    if object.name == "nil" && basic_kind(state, object.type_id) == go_types::BasicKind::UntypedNil {
        "nil (untyped nil)"
    } else if object.kind == go_types::ObjectKind::Func {
        object.name + " (function)"
    } else if object.kind == go_types::ObjectKind::Var
        && pending_value_index(state, object_id).is_some() {
        object.name + " (package-level variable)"
    } else if object.kind == go_types::ObjectKind::Var {
        object.name + " (local variable)"
    } else if object.kind == go_types::ObjectKind::Const {
        object.name + " (constant)"
    } else if object.kind == go_types::ObjectKind::PackageName {
        object.name + " (package name)"
    } else {
        object.name
    }
}

fn qualified_non_type_object_name(state: CheckState, qualifier: string, object: go_types::Object) -> string {
    let name = qualifier + "." + object.name;
    if object.kind == go_types::ObjectKind::Const {
        match object.constant {
            Some(value) => {
                let rendered = match constant::constant_from_exact(object.constant_kind, value) {
                    Some(value) => constant::constant_string(value),
                    None => value,
                };
                if go_types::is_untyped(state.world, object.type_id) {
                    name + " (" + diagnostic_type_string(state, object.type_id) + " constant "
                        + rendered
                        + ")"
                } else {
                    name + " (constant " + rendered + " of type "
                        + diagnostic_type_string(state, object.type_id)
                        + ")"
                }
            },
            None => name + " (constant)",
        }
    } else if object.kind == go_types::ObjectKind::Var {
        name + " (variable of type " + diagnostic_type_string(state, object.type_id) + ")"
    } else {
        name + " (value of type " + diagnostic_type_string(state, object.type_id) + ")"
    }
}

fn resolve_array_length(state: CheckState, scope: go_types::ScopeId, length_node: syntax::NodeId) -> Option[
    i64,
] {
    match syntax::get_kind(state.syntax.arena, length_node) {
        Some(syntax::SyntaxKind::Ellipsis { ellipsis: _, element: _ }) => {
            diagnostic(
                state,
                length_node,
                "invalid use of [...] array (outside a composite literal)",
                false,
            );
            return Option::None
        },
        _ => {},
    }
    match identifier(state, length_node) {
        Some(name) => match go_types::lookup(state.world, scope, name) {
            Some(object) => match go_types::get_object(state.world, object) {
                Some(object) => if object.kind != go_types::ObjectKind::Const {
                    diagnostic(state, length_node, "invalid array length " + name, false);
                    return Option::None
                },
                None => {},
            },
            None => {
                diagnostic(
                    state,
                    length_node,
                    "undefined array length " + name + " or missing type constraint",
                    false,
                );
                return Option::None
            },
        },
        None => {},
    }
    let previous_type_cycle_depth = state.array_length_type_cycle_depth;
    if state.array_length_depth == 0 {
        let semantic_depth = state.type_cycle_depth - state.type_fact_recovery_depth;
        state.array_length_type_cycle_depth = if semantic_depth > 0 {
            semantic_depth
        } else {
            0
        };
    }
    state.array_length_depth += 1;
    let operand = check_expression(state, scope, length_node);
    state.array_length_depth -= 1;
    state.array_length_type_cycle_depth = previous_type_cycle_depth;
    if node_is_void(state, length_node) {
        diagnostic(
            state,
            length_node,
            void_expression_source_text(state, length_node) + " (no value) used as value",
            false,
        );
        return Option::None
    } else if operand.type_id.value == state.world.invalid.value {
        return Option::None
    } else if !go_types::is_untyped(state.world, operand.type_id)
        && !go_types::is_integer(state.world, operand.type_id) {
        diagnostic(
            state,
            length_node,
            "array length " + operand_string(state, length_node, operand) + " must be integer",
            false,
        );
        return Option::None
    }
    match operand.value {
        Some(value) => match constant::constant_to_integer(value) {
            Some(value) => if value.sign < 0 {
                diagnostic(
                    state,
                    length_node,
                    "invalid array length " + operand_string(state, length_node, operand),
                    false,
                );
                Option::None
            } else {
                match constant::round_constant(
                    constant::ConstValue::Int(value),
                    go_types::BasicKind::Int,
                    state.config.sizes,
                ) {
                    Some(_) => match num::parse_int_structured(constant::integer_to_string(value)) {
                        Ok(length) => Option::Some(length.to_i64()),
                        Err(_) => {
                            diagnostic(
                                state,
                                length_node,
                                "invalid array length "
                                    + operand_string(state, length_node, operand),
                                false,
                            );
                            Option::None
                        },
                    },
                    None => {
                        diagnostic(
                            state,
                            length_node,
                            "invalid array length " + operand_string(state, length_node, operand),
                            false,
                        );
                        Option::None
                    },
                }
            },
            None => {
                diagnostic(
                    state,
                    length_node,
                    "array length " + operand_string(state, length_node, operand)
                        + " must be integer",
                    false,
                );
                Option::None
            },
        },
        None => {
            diagnostic(
                state,
                length_node,
                "array length " + operand_string(state, length_node, operand) + " must be constant",
                false,
            );
            Option::None
        },
    }
}

fn valid_world_object(state: CheckState, object: go_types::ObjectId) -> bool {
    object.value >= 0 && object.value < state.world.objects.len()
}

fn resolve_type(state: CheckState, scope: go_types::ScopeId, node: syntax::NodeId) -> go_types::TypeId {
    if state.diagnostic_override.is_none() {
        match recorded_type_fact(state, node) {
            Some(fact) => if fact.type_expr && fact.type_id.value != state.world.invalid.value
                && match go_types::get_type(state.world, fact.type_id) {
                    Some(go_types::TypeData {
                        id: _,
                        kind: go_types::TypeKind::Signature {
                            receiver: _,
                            receiver_type_params: _,
                            type_params: _,
                            params: _,
                            results: _,
                            variadic: _,
                        },
                    }) => !type_contains_invalid(state, fact.type_id),
                    _ => true,
                } {
                return fact.type_id
            },
            None => {},
        }
    }
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::BadExpr { from: _, to: _ }) => {
            record_invalid_type_expression(state, node);
            state.world.invalid
        },
        Some(syntax::SyntaxKind::Ident { name_pos: _, name }) => if name == "_" {
            diagnostic(state, node, "cannot use _ as value or type", false);
            record_invalid_type_expression(state, node);
            state.world.invalid
        } else {
            match go_types::lookup(state.world, scope, name) {
                Some(object_id) => if unresolved_disabled_alias(state, object_id) {
                    record_use(state, node, object_id);
                    diagnostic(
                        state,
                        node,
                        "invalid use of type alias " + name
                            + " in recursive type (see go.dev/issue/50729)",
                        false,
                    );
                    record_invalid_type_expression(state, node);
                    state.world.invalid
                } else if !evaluate_type_object(state, object_id) {
                    if valid_world_object(state, object_id) {
                        let object = state.world.objects[object_id.value];
                        if object.kind == go_types::ObjectKind::TypeName
                            && object.type_id.value != state.world.invalid.value {
                            mark_dot_import_used(state, object_id);
                            record_use(state, node, object_id);
                            record_type_expression(state, node, object.type_id);
                            if state.generic_type_origin_depth == 0
                                && generic_parameter_count(state, object.type_id) > 0 {
                                diagnostic(
                                    state,
                                    node,
                                    "cannot use generic type "
                                        + if state.generic_type_short_diagnostic {
                                            name
                                        } else {
                                            diagnostic_type_string(state, object.type_id)
                                        }
                                        + " without instantiation",
                                    false,
                                );
                                if state.type_cycle_depth > 0 {
                                    record_invalid_type_expression(state, node)
                                } else {
                                    let _ = state.omitted_type_fact_nodes.insert(node.value);
                                }
                                state.world.invalid
                            } else {
                                object.type_id
                            }
                        } else {
                            state.world.invalid
                        }
                    } else {
                        state.world.invalid
                    }
                } else {
                    if valid_world_object(state, object_id) {
                        let object = state.world.objects[object_id.value];
                        if object.kind == go_types::ObjectKind::TypeName {
                            mark_dot_import_used(state, object_id);
                            record_use(state, node, object_id);
                            record_type_expression(state, node, object.type_id);
                            if object.owner.is_none() && (name == "any" || name == "comparable")
                                && !go_version_at_least(state, node, 18) {
                                diagnostic(
                                    state,
                                    node,
                                    "predeclared " + name + " requires go1.18 or later",
                                    false,
                                );
                                record_invalid_type_expression(state, node);
                                let _ = state.omitted_use_fact_nodes.insert(node.value);
                                state.world.invalid
                            } else if state.generic_type_origin_depth == 0
                                && generic_parameter_count(state, object.type_id) > 0 {
                                diagnostic(
                                    state,
                                    node,
                                    "cannot use generic type "
                                        + if state.generic_type_short_diagnostic {
                                            name
                                        } else {
                                            diagnostic_type_string(state, object.type_id)
                                        }
                                        + " without instantiation",
                                    false,
                                );
                                if state.type_cycle_depth > 0 {
                                    record_invalid_type_expression(state, node)
                                } else {
                                    let _ = state.omitted_type_fact_nodes.insert(node.value);
                                }
                                state.world.invalid
                            } else {
                                reject_constraint_type(state, node, name, object.type_id)
                            }
                        } else {
                            record_use(state, node, object_id);
                            let repeated_empty_declaration = if state.active_value_objects.is_empty() {
                                false
                            } else {
                                match pending_value_index(
                                    state,
                                    state.active_value_objects[state.active_value_objects.len() - 1],
                                ) {
                                    Some(index) => state.pending_values[index].value_nodes.is_empty(),
                                    None => false,
                                }
                            };
                            let already_reported = match recorded_type_fact(state, node) {
                                Some(fact) => fact.type_expr
                                    && fact.type_id.value == state.world.invalid.value
                                    && !repeated_empty_declaration,
                                None => false,
                            };
                            if !already_reported {
                                diagnostic(
                                    state,
                                    node,
                                    non_type_object_name(state, object_id, object)
                                        + " is not a type",
                                    false,
                                )
                            }
                            record_type_expression(state, node, state.world.invalid);
                            state.world.invalid
                        }
                    } else {
                        diagnostic(state, node, "invalid type object " + name, false);
                        state.world.invalid
                    }
                },
                None => {
                    diagnostic(state, node, "undefined: " + name, false);
                    record_invalid_type_expression(state, node);
                    state.world.invalid
                },
            }
        },
        Some(syntax::SyntaxKind::IndexExpr { expression, lbrack: _, index, rbrack: _ }) => resolve_instantiated_type(
            state,
            scope,
            node,
            expression,
            Vec::from_array([index]),
        ),
        Some(syntax::SyntaxKind::IndexListExpr { expression, lbrack: _, indices, rbrack: _ }) => resolve_instantiated_type(
            state,
            scope,
            node,
            expression,
            indices,
        ),
        Some(syntax::SyntaxKind::BinaryExpr { left, op_pos: _, op, right }) => if op
            == BIT_OR_OPERATOR {
            resolve_union_type(state, scope, node, left, right)
        } else {
            diagnostic(state, node, "invalid binary type expression", false);
            state.world.invalid
        },
        Some(syntax::SyntaxKind::UnaryExpr { op_pos: _, op, expression }) => if op == TILDE_OPERATOR {
            resolve_tilde_type(state, scope, node, expression)
        } else {
            diagnostic(state, node, "invalid unary type expression", false);
            state.world.invalid
        },
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => {
            let result = resolve_type(state, scope, expression);
            record_type_expression(state, node, result);
            result
        },
        Some(syntax::SyntaxKind::SelectorExpr { expression, selector }) => {
            let result = match identifier(state, expression) {
                Some(package_name) => match go_types::lookup(state.world, scope, package_name) {
                    Some(package_object_id) => match go_types::get_object(
                        state.world,
                        package_object_id,
                    ) {
                        Some(package_object) => if package_object.kind
                            == go_types::ObjectKind::PackageName {
                            mark_import_used(state, package_object_id);
                            record_use(state, expression, package_object_id);
                            match package_object.imported_package {
                                Some(package_id) => {
                                    let member_name = identifier(state, selector).unwrap_or("");
                                    if state.config.fake_import_c
                                        && state.world.packages[package_id.value].path == "C" {
                                        record_type_expression(state, node, state.world.invalid);
                                        return state.world.invalid
                                    } else if !state.world.packages[package_id.value].complete {
                                        record_type_expression(state, node, state.world.invalid);
                                        return state.world.invalid
                                    }
                                    let package_scope = state.world.packages[package_id.value].scope;
                                    match go_types::lookup_local(
                                        state.world,
                                        package_scope,
                                        member_name,
                                    ) {
                                        Some(member) => match go_types::get_object(
                                            state.world,
                                            member,
                                        ) {
                                            Some(object) => if !object.exported {
                                                diagnostic(
                                                    state,
                                                    selector,
                                                    "name " + member_name
                                                        + " not exported by package "
                                                        + package_name,
                                                    false,
                                                );
                                                record_use(state, selector, member);
                                                if object.kind == go_types::ObjectKind::TypeName {
                                                    record_type_expression(
                                                        state,
                                                        node,
                                                        object.type_id,
                                                    );
                                                    object.type_id
                                                } else {
                                                    state.world.invalid
                                                }
                                            } else if object.kind == go_types::ObjectKind::TypeName {
                                                record_use(state, selector, member);
                                                record_type_expression(state, node, object.type_id);
                                                if state.generic_type_origin_depth == 0
                                                    && generic_parameter_count(
                                                        state,
                                                        object.type_id,
                                                    )
                                                        > 0 {
                                                    diagnostic(
                                                        state,
                                                        node,
                                                        "cannot use generic type "
                                                            + if state.generic_type_short_diagnostic {
                                                                member_name
                                                            } else {
                                                                diagnostic_type_string(
                                                                    state,
                                                                    object.type_id,
                                                                )
                                                            }
                                                            + " without instantiation",
                                                        false,
                                                    );
                                                    if state.type_cycle_depth > 0 {
                                                        record_invalid_type_expression(state, node)
                                                    } else {
                                                        let _ = state.omitted_type_fact_nodes.insert(
                                                            node.value,
                                                        );
                                                    }
                                                    state.world.invalid
                                                } else {
                                                    reject_constraint_type(
                                                        state,
                                                        node,
                                                        member_name,
                                                        object.type_id,
                                                    )
                                                }
                                            } else {
                                                record_use(state, selector, member);
                                                diagnostic(
                                                    state,
                                                    node,
                                                    qualified_non_type_object_name(
                                                        state,
                                                        package_name,
                                                        object,
                                                    )
                                                        + " is not a type",
                                                    false,
                                                );
                                                state.world.invalid
                                            },
                                            None => state.world.invalid,
                                        },
                                        None => {
                                            let similar = similar_package_member(
                                                state,
                                                package_id,
                                                member_name,
                                            );
                                            diagnostic(
                                                state,
                                                selector,
                                                "undefined: " + package_name + "." + member_name
                                                    + if similar == "" {
                                                        ""
                                                    } else {
                                                        " (but have " + similar + ")"
                                                    },
                                                false,
                                            );
                                            state.world.invalid
                                        },
                                    }
                                },
                                None => state.world.invalid,
                            }
                        } else if package_object.kind == go_types::ObjectKind::TypeName {
                            record_use(state, expression, package_object_id);
                            record_invalid_type_expression(state, node);
                            let mut local_recursive = false;
                            for active in state.active_local_type_objects {
                                if active.value == package_object_id.value {
                                    local_recursive = true;
                                }
                            }
                            let recursive = match pending_type_index(state, package_object_id) {
                                Some(index) => state.pending_types[index].status == 1,
                                None => false,
                            };
                            if local_recursive {
                                if !invalid_type_object_seen(state, package_object_id) {
                                    report_named_type_cycle(
                                        state,
                                        Vec::from_array([package_object_id]),
                                        false,
                                    )
                                }
                            } else if recursive {
                                if !invalid_type_object_seen(state, package_object_id) {
                                    state.deferred_direct_type_cycles.push(package_object_id)
                                }
                            } else {
                                let previous = state.generic_type_short_diagnostic;
                                state.generic_type_short_diagnostic = true;
                                let resolved = resolve_type(state, scope, expression);
                                state.generic_type_short_diagnostic = previous;
                                if resolved.value != state.world.invalid.value {
                                    diagnostic(
                                        state,
                                        selector,
                                        package_name + "."
                                            + identifier(state, selector).unwrap_or("")
                                            + " is not a type",
                                        false,
                                    )
                                }
                            }
                            state.world.invalid
                        } else {
                            let member_name = identifier(state, selector).unwrap_or("");
                            if package_object.kind == go_types::ObjectKind::Const
                                || package_object.kind == go_types::ObjectKind::Var
                                || package_object.kind == go_types::ObjectKind::Func
                                || package_object.kind == go_types::ObjectKind::Nil {
                                let _ = check_expression(state, scope, expression);
                            }
                            let mut local_recursive = false;
                            for active in state.active_local_type_objects {
                                if active.value == package_object_id.value {
                                    local_recursive = true;
                                }
                            }
                            let recursive = match pending_type_index(state, package_object_id) {
                                Some(index) => state.pending_types[index].status == 1,
                                None => false,
                            };
                            if local_recursive {
                                if !invalid_type_object_seen(state, package_object_id) {
                                    report_named_type_cycle(
                                        state,
                                        Vec::from_array([package_object_id]),
                                        false,
                                    )
                                }
                            } else if recursive {
                                if !invalid_type_object_seen(state, package_object_id) {
                                    state.deferred_direct_type_cycles.push(package_object_id)
                                }
                            } else {
                                diagnostic(
                                    state,
                                    selector,
                                    package_name + "." + member_name + " is not a type",
                                    false,
                                )
                            }
                            state.world.invalid
                        },
                        None => state.world.invalid,
                    },
                    None => {
                        diagnostic(state, expression, "undefined: " + package_name, false);
                        state.world.invalid
                    },
                },
                None => {
                    diagnostic(state, expression, "invalid package selector", false);
                    state.world.invalid
                },
            };
            if result.value == state.world.invalid.value {
                record_invalid_type_expression(state, node)
            }
            result
        },
        Some(syntax::SyntaxKind::StarExpr { star: _, expression }) => {
            state.type_cycle_depth += 1;
            let element = recovered_constraint_type(
                state,
                expression,
                resolve_type(state, scope, expression),
            );
            state.type_cycle_depth -= 1;
            if state.constraint_type_depth > 0 {
                if go_types::is_constraint_interface(state.world, element) {
                    report_constraint_type_use(
                        state,
                        expression,
                        diagnostic_type_string(state, element),
                        element,
                    )
                } else {
                    match go_types::get_type(state.world, go_types::unalias(state.world, element)) {
                        Some(go_types::TypeData {
                            id: _,
                            kind: go_types::TypeKind::Named {
                                object,
                                underlying: _,
                                type_params: _,
                                type_args: _,
                                methods: _,
                            },
                        }) => for active in state.active_type_objects {
                            if active.value == object.value {
                                state.deferred_constraint_type_uses.push(
                                    DeferredConstraintTypeUse { node: expression, type_id: element },
                                )
                            }
                        },
                        _ => {},
                    }
                }
            }
            let result = if element.value == state.world.invalid.value {
                state.world.invalid
            } else {
                go_types::add_type(state.world, go_types::TypeKind::Pointer { element })
            };
            if result.value == state.world.invalid.value {
                record_invalid_type_expression(state, node)
            } else {
                record_type_expression(state, node, result)
            }
            result
        },
        Some(syntax::SyntaxKind::ArrayType { lbrack: _, length, element }) => {
            let result = match length {
                None => {
                    state.type_cycle_depth += 1;
                    let element_type = recovered_constraint_type(
                        state,
                        element,
                        resolve_type(state, scope, element),
                    );
                    state.type_cycle_depth -= 1;
                    go_types::add_type(
                        state.world,
                        go_types::TypeKind::Slice { element: element_type },
                    )
                },
                Some(length_node) => {
                    let length_value = resolve_array_length(state, scope, length_node);
                    state.type_cycle_depth += 1;
                    let element_type = recovered_constraint_type(
                        state,
                        element,
                        resolve_type(state, scope, element),
                    );
                    state.type_cycle_depth -= 1;
                    match length_value {
                        Some(length_value) => go_types::add_type(
                            state.world,
                            go_types::TypeKind::Array {
                                length: length_value,
                                element: element_type,
                            },
                        ),
                        None => state.world.invalid,
                    }
                },
            };
            if result.value == state.world.invalid.value {
                record_invalid_type_expression(state, node)
            } else {
                record_type_expression(state, node, result)
            }
            result
        },
        Some(syntax::SyntaxKind::StructType { struct_pos: _, fields, incomplete: _ }) => resolve_struct_type(
            state,
            scope,
            node,
            fields,
        ),
        Some(syntax::SyntaxKind::FuncType { func_pos: _, type_params, params, results }) => {
            let _ = type_params;
            let _ = params;
            let _ = results;
            resolve_function_signature(state, scope, node, true)
        },
        Some(syntax::SyntaxKind::InterfaceType { interface_pos: _, methods, incomplete: _ }) => resolve_interface_type(
            state,
            scope,
            node,
            methods,
        ),
        Some(syntax::SyntaxKind::MapType { map_pos: _, key, value }) => {
            state.type_cycle_depth += 1;
            let key_type = recovered_constraint_type(state, key, resolve_type(state, scope, key));
            let value_type = recovered_constraint_type(
                state,
                value,
                resolve_type(state, scope, value),
            );
            state.type_cycle_depth -= 1;
            let result = go_types::add_type(
                state.world,
                go_types::TypeKind::Map { key: key_type, value: value_type },
            );
            record_type_expression(state, node, result);
            result
        },
        Some(syntax::SyntaxKind::ChanType { begin: _, arrow: _, direction, value }) => {
            state.type_cycle_depth += 1;
            let element = recovered_constraint_type(state, value, resolve_type(state, scope, value));
            state.type_cycle_depth -= 1;
            let result = go_types::add_type(
                state.world,
                go_types::TypeKind::Chan { direction, element },
            );
            record_type_expression(state, node, result);
            result
        },
        Some(syntax::SyntaxKind::Ellipsis { ellipsis: _, element: _ }) => {
            diagnostic(state, node, "invalid syntax tree: invalid use of ...", false);
            state.world.invalid
        },
        Some(syntax::SyntaxKind::TypeAssertExpr {
            expression: _,
            lparen: _,
            type_node: _,
            rparen: _,
        }) => {
            diagnostic(state, node, expression_source_text(state, node) + " is not a type", false);
            let _ = check_expression(state, scope, node);
            state.world.invalid
        },
        Some(_) => {
            diagnostic(state, node, expression_source_text(state, node) + " is not a type", false);
            state.world.invalid
        },
        None => state.world.invalid,
    }
}

fn declare_object(
    state: CheckState,
    package_scope: go_types::ScopeId,
    node: syntax::NodeId,
    kind: go_types::ObjectKind,
    object_type: go_types::TypeId,
) -> Option[go_types::ObjectId] {
    match identifier(state, node) {
        Some(name) => {
            if name == "init" && kind != go_types::ObjectKind::Func {
                diagnostic(state, node, "cannot declare init - must be func", false);
                return Option::None
            } else if name == "main" && kind != go_types::ObjectKind::Func
                && state.world.packages[state.package_id.value].name == "main" {
                diagnostic(state, node, "cannot declare main - must be func", false);
                return Option::None
            }
            let object = go_types::add_object(
                state.world,
                kind,
                name,
                Option::Some(state.package_id),
                node_file(state, node),
                Option::Some(node),
                node_start(state, node),
                object_type,
            );
            if name == "_" || (name == "init" && kind == go_types::ObjectKind::Func) {
                state.info.defs.push(ObjectFact { node, object: Option::Some(object) });
                return Option::Some(object)
            }
            match go_types::insert(state.world, package_scope, name, object) {
                Some(existing) => {
                    diagnostic(state, node, name + " redeclared in this block", false);
                    match go_types::get_object(state.world, existing) {
                        Some(existing) => match existing.node {
                            Some(existing_node) => secondary_diagnostic(
                                state,
                                existing_node,
                                "\tother declaration of " + name,
                            ),
                            None => {},
                        },
                        None => {},
                    }
                    Option::None
                },
                None => {
                    state.info.defs.push(ObjectFact { node, object: Option::Some(object) });
                    Option::Some(object)
                },
            }
        },
        None => {
            diagnostic(state, node, "declaration name is not an identifier", false);
            Option::None
        },
    }
}

fn save_declared_object(state: CheckState, node: syntax::NodeId, object: Option[go_types::ObjectId]) -> () {
    if let Some(object) = object {
        if state.declared_objects[node.value].is_none() {
            state.declared_objects[node.value] = object;
        }
    }
}

fn declared_object(state: CheckState, node: syntax::NodeId) -> Option[go_types::ObjectId] {
    state.declared_objects[node.value]
}

fn report_value_arity(
    state: CheckState,
    declaration: syntax::NodeId,
    names: Vec[syntax::NodeId],
    values: Vec[syntax::NodeId],
    inherited_from: Option[syntax::NodeId],
) -> bool {
    if names.len() < values.len() {
        match inherited_from {
            Some(provider) => diagnostic(
                state,
                declaration,
                "extra init expr at " + source_position_string(state, provider),
                false,
            ),
            None => {
                let extra = values[names.len()];
                diagnostic(
                    state,
                    extra,
                    "extra init expr " + expression_source_text(state, extra),
                    false,
                )
            },
        }
        true
    } else if names.len() > values.len() && (inherited_from.is_some() || values.len() != 1) {
        let missing = names[values.len()];
        diagnostic(
            state,
            missing,
            "missing init expr for " + identifier(state, missing).unwrap_or("_"),
            false,
        );
        true
    } else {
        false
    }
}

fn source_position_string(state: CheckState, node: syntax::NodeId) -> string {
    match syntax::get_node(state.syntax.arena, node) {
        Some(value) => if value.file.value >= 0 && value.file.value < state.syntax.files.len() {
            let name = state.syntax.files[value.file.value].name;
            for source in state.sources {
                if source.name == name {
                    let mut line = 1;
                    let mut column = 1;
                    let end = if value.span.start < source.source.len() {
                        value.span.start
                    } else {
                        source.source.len()
                    };
                    for index in 0..end {
                        if source.source.get(index) == b'\n' {
                            line += 1;
                            column = 1;
                        } else {
                            column += 1;
                        }
                    }
                    return f"{name}:{line}:{column}"
                }
            }
            name
        } else {
            ""
        },
        None => "",
    }
}

fn predeclare_value_spec(
    state: CheckState,
    file_scope: go_types::ScopeId,
    package_scope: go_types::ScopeId,
    node: syntax::NodeId,
    kind: go_types::ObjectKind,
    inherited_type: Option[syntax::NodeId],
    inherited_values: Vec[syntax::NodeId],
    inherited_spec: Option[syntax::NodeId],
    iota_value: isize,
) -> () {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::ValueSpec { names, type_node, values }) => {
            let inherits = values.is_empty() && type_node.is_none()
                && kind == go_types::ObjectKind::Const;
            let effective_values = if inherits {
                inherited_values
            } else {
                values
            };
            let effective_type = if inherits {
                inherited_type
            } else {
                type_node
            };
            if kind == go_types::ObjectKind::Const || !effective_values.is_empty() {
                let _ = report_value_arity(
                    state,
                    node,
                    names,
                    effective_values,
                    if inherits {
                        inherited_spec
                    } else {
                        Option::None
                    },
                );
            }
            for index in 0..names.len() {
                let declared = declare_object(
                    state,
                    package_scope,
                    names[index],
                    kind,
                    state.world.invalid,
                );
                save_declared_object(state, names[index], declared);
                match declared {
                    Some(object) => {
                        if kind == go_types::ObjectKind::Const && effective_values.len() != 1
                            && index >= effective_values.len() {
                            let value = constant::ConstValue::Unknown;
                            save_constant(state, object, value);
                            let _ = go_types::set_object_constant(
                                state.world,
                                object,
                                constant::constant_kind_name(value),
                                constant::constant_exact_string(value),
                            );
                        }
                        state.pending_value_indices[object.value] = state.pending_values.len();
                        state.pending_values.push(
                            PendingValue {
                                object,
                                file_scope,
                                type_node: effective_type,
                                declaration_node: node,
                                value_nodes: effective_values,
                                value_index: index,
                                value_count: names.len(),
                                constant_declaration: kind == go_types::ObjectKind::Const,
                                iota_value: if kind == go_types::ObjectKind::Const {
                                    iota_value
                                } else {
                                    -1
                                },
                                inherited_initializer: inherits,
                                invalid_constant_type: false,
                                status: 0,
                            },
                        )
                    },
                    None => {},
                }
            }
        },
        _ => diagnostic(state, node, "invalid value declaration", false),
    }
}

fn predeclare_type_spec(
    state: CheckState,
    file_scope: go_types::ScopeId,
    package_scope: go_types::ScopeId,
    node: syntax::NodeId,
) -> () {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::TypeSpec { name, type_params, assign, type_node }) => {
            let object = declare_object(
                state,
                package_scope,
                name,
                go_types::ObjectKind::TypeName,
                state.world.invalid,
            );
            match object {
                Some(object) => {
                    let placeholder = go_types::add_type(
                        state.world,
                        if assign > 0 {
                            go_types::TypeKind::Alias {
                                object,
                                rhs: state.world.invalid,
                                type_params: Vec::new(),
                                type_args: Vec::new(),
                            }
                        } else {
                            go_types::TypeKind::Named {
                                object,
                                underlying: state.world.invalid,
                                type_params: Vec::new(),
                                type_args: Vec::new(),
                                methods: Vec::new(),
                            }
                        },
                    );
                    let _ = go_types::set_object_type(state.world, object, placeholder);
                    save_declared_object(state, name, Option::Some(object));
                    state.pending_type_indices[object.value] = state.pending_types.len();
                    state.pending_types.push(
                        PendingType {
                            object,
                            type_id: placeholder,
                            file_scope,
                            rhs: type_node,
                            declaration_node: node,
                            type_params_node: type_params,
                            alias: assign > 0,
                            status: 0,
                        },
                    );
                },
                None => {},
            }
        },
        _ => diagnostic(state, node, "invalid type declaration", false),
    }
}

fn predeclare_declaration(
    state: CheckState,
    file_scope: go_types::ScopeId,
    package_scope: go_types::ScopeId,
    node: syntax::NodeId,
) -> () {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::GenDecl { token_pos: _, token, lparen: _, specs, rparen: _ }) => if value_declaration_keyword(
            token,
        ) {
            let kind = if token == CONST_KEYWORD {
                go_types::ObjectKind::Const
            } else {
                go_types::ObjectKind::Var
            };
            let mut inherited_type: Option[syntax::NodeId] = Option::None;
            let mut inherited_values: Vec[syntax::NodeId] = Vec::new();
            let mut inherited_spec: Option[syntax::NodeId] = Option::None;
            for index in 0..specs.len() {
                match syntax::get_kind(state.syntax.arena, specs[index]) {
                    Some(syntax::SyntaxKind::ValueSpec { names: _, type_node, values }) => if !values.is_empty() {
                        inherited_type = type_node;
                        inherited_values = values;
                        inherited_spec = Option::Some(specs[index]);
                    },
                    _ => {},
                }
                predeclare_value_spec(
                    state,
                    file_scope,
                    package_scope,
                    specs[index],
                    kind,
                    inherited_type,
                    inherited_values,
                    inherited_spec,
                    index,
                )
            }
        } else if token == TYPE_KEYWORD {
            for spec in specs {
                predeclare_type_spec(state, file_scope, package_scope, spec)
            }
        },
        Some(syntax::SyntaxKind::FuncDecl { receiver, name, type_node, body }) => if receiver.is_none() {
            let function_name = identifier(state, name).unwrap_or("");
            match syntax::get_kind(state.syntax.arena, type_node) {
                Some(syntax::SyntaxKind::FuncType {
                    func_pos: _,
                    type_params: Some(type_params),
                    params: _,
                    results: _,
                }) => {
                    let fields = field_list_nodes(state, type_params);
                    if !fields.is_empty() {
                        if function_name == "init" {
                            diagnostic(
                                state,
                                fields[0],
                                "func init must have no type parameters",
                                true,
                            )
                        } else if !go_version_at_least(state, fields[0], 18) {
                            diagnostic(
                                state,
                                fields[0],
                                "type parameter requires go1.18 or later",
                                false,
                            )
                        }
                    }
                },
                _ => {},
            }
            if identifier(state, name).unwrap_or("") == "init" && body.is_none() {
                diagnostic(state, name, "func init must have a body", true)
            }
            if body.is_none()
                && match syntax::get_kind(state.syntax.arena, type_node) {
                    Some(syntax::SyntaxKind::FuncType {
                        func_pos: _,
                        type_params: Some(type_params),
                        params: _,
                        results: _,
                    }) => !field_list_nodes(state, type_params).is_empty(),
                    _ => false,
                } {
                diagnostic(state, name, "generic function is missing function body", true)
            }
            check_main_function_signature(state, name, type_node);
            let declared = declare_object(
                state,
                package_scope,
                name,
                go_types::ObjectKind::Func,
                state.world.invalid,
            );
            save_declared_object(state, name, declared);
            match declared {
                Some(object) => {
                    state.pending_function_indices[object.value] = state.pending_functions.len();
                    state.pending_functions.push(
                        PendingFunction { object, file_scope, type_node, status: 0 },
                    )
                },
                None => {},
            }
        },
        _ => {},
    }
}

fn predeclare_file(state: CheckState, file_index: isize) -> () {
    let file = state.syntax.files[file_index];
    let file_scope = state.file_scopes[file_index];
    let package_scope = state.world.packages[state.package_id.value].scope;
    match syntax::get_kind(state.syntax.arena, file.root) {
        Some(syntax::SyntaxKind::File {
            package_pos: _,
            name: _,
            declarations,
            imports: _,
            go_version: _,
        }) => for declaration in declarations {
            predeclare_declaration(state, file_scope, package_scope, declaration)
        },
        _ => {},
    }
}

fn find_basic_kind(state: CheckState, kind: go_types::BasicKind) -> go_types::TypeId {
    for entry in state.world.basics {
        match go_types::type_data(state.world, entry.type_id).kind {
            go_types::TypeKind::Basic { basic, name: _, untyped: _ } => if basic == kind {
                return entry.type_id
            },
            _ => {},
        }
    }
    state.world.invalid
}

fn declaration_value(
    state: CheckState,
    file_scope: go_types::ScopeId,
    node: syntax::NodeId,
    explicit_type: Option[go_types::TypeId],
    constant_declaration: bool,
) -> (go_types::TypeId, Option[constant::ConstValue]) {
    let operand = check_expression(state, file_scope, node);
    declaration_operand(state, node, operand, explicit_type, constant_declaration, false)
}

fn valid_constant_declaration_type(state: CheckState, type_id: go_types::TypeId) -> bool {
    match go_types::get_type(state.world, go_types::unalias(state.world, type_id)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::TypeParam { object: _, constraint: _, index: _ },
        }) => false,
        _ => match go_types::get_type(state.world, go_types::underlying(state.world, type_id)) {
            Some(go_types::TypeData {
                id: _,
                kind: go_types::TypeKind::Basic { basic, name: _, untyped: _ },
            }) => basic != go_types::BasicKind::Invalid
                && basic != go_types::BasicKind::UnsafePointer
                && basic != go_types::BasicKind::UntypedNil,
            _ => false,
        },
    }
}

fn declaration_type(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    constant_declaration: bool,
) -> go_types::TypeId {
    let resolved = resolve_type(state, scope, node);
    if resolved.value == state.world.invalid.value {
        match recorded_type_fact(state, node) {
            Some(fact) => if generic_parameter_count(state, fact.type_id) > 0 {
                let _ = state.omitted_type_fact_nodes.remove(node.value);
                record_invalid_type_expression(state, node)
            },
            None => {},
        }
        match syntax::get_kind(state.syntax.arena, node) {
            Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => match recorded_type_fact(
                state,
                expression,
            ) {
                Some(fact) => if generic_parameter_count(state, fact.type_id) > 0 {
                    let _ = state.omitted_type_fact_nodes.remove(expression.value);
                    record_invalid_type_expression(state, expression)
                },
                None => {},
            },
            _ => {},
        }
    }
    let type_id = if constant_declaration {
        resolved
    } else {
        recovered_constraint_type(state, node, resolved)
    };
    if constant_declaration && type_id.value != state.world.invalid.value
        && !type_contains_invalid(state, type_id)
        && !valid_constant_declaration_type(state, type_id) {
        diagnostic(
            state,
            node,
            "invalid constant type " + diagnostic_type_string(state, type_id),
            false,
        );
        state.world.invalid
    } else {
        type_id
    }
}

fn declaration_operand(
    state: CheckState,
    node: syntax::NodeId,
    operand: Operand,
    explicit_type: Option[go_types::TypeId],
    constant_declaration: bool,
    assignment_context: bool,
) -> (go_types::TypeId, Option[constant::ConstValue]) {
    if operand.type_id.value == state.world.invalid.value {
        return (
            explicit_type.unwrap_or(state.world.invalid),
            if constant_declaration {
                Option::Some(constant::ConstValue::Unknown)
            } else {
                Option::None
            },
        )
    }
    if state.failed_inference_nodes.contains(node.value) {
        return (
            explicit_type.unwrap_or(
                if state.omitted_type_fact_nodes.contains(node.value) {
                    state.world.invalid
                } else {
                    operand.type_id
                },
            ),
            Option::None,
        )
    }
    match explicit_type {
        Some(type_id) => if type_id.value == state.world.invalid.value {
            return (state.world.invalid, Option::None)
        },
        None => {},
    }
    if constant_declaration && operand.value.is_none()
        && operand.type_id.value != state.world.invalid.value {
        diagnostic(state, node, operand_string(state, node, operand) + " is not constant", false);
        return (state.world.invalid, Option::Some(constant::ConstValue::Unknown))
    }
    let declaration_context = if constant_declaration {
        "constant declaration"
    } else if assignment_context {
        "assignment"
    } else {
        "variable declaration"
    };
    let result = match explicit_type {
        Some(type_id) => match operand.value {
            Some(value) => if constant::constant_kind(value) == constant::ConstantKind::Unknown {
                (type_id, Option::Some(value))
            } else if !constant_declaration && go_types::is_type_parameter(state.world, type_id) {
                if argument_assignable(state, operand, type_id) {
                    (type_id, Option::Some(value))
                } else {
                    diagnostic(
                        state,
                        node,
                        "cannot use " + operand_string(state, node, operand) + " as "
                            + diagnostic_type_string(state, type_id)
                            + " value in "
                            + declaration_context,
                        false,
                    );
                    (type_id, Option::Some(constant::ConstValue::Unknown))
                }
            } else {
                match basic_kind(state, type_id) {
                    go_types::BasicKind::Invalid => if !constant_declaration
                        && go_types::is_interface(state.world, type_id) {
                        let source_type = match default_type_for_kind(
                            state,
                            basic_kind(state, operand.type_id),
                        ) {
                            Some(type_id) => type_id,
                            None => operand.type_id,
                        };
                        if go_types::implements(state.world, source_type, type_id) {
                            (type_id, Option::Some(value))
                        } else {
                            let implementation_detail = interface_implementation_detail(
                                state,
                                source_type,
                                type_id,
                            );
                            diagnostic(
                                state,
                                node,
                                "cannot use " + operand_string(state, node, operand) + " as "
                                    + diagnostic_type_string(state, type_id)
                                    + " value in "
                                    + declaration_context
                                    + if implementation_detail == "" {
                                        ""
                                    } else {
                                        ": " + implementation_type_string(state, source_type)
                                            + " does not implement "
                                            + implementation_type_string(state, type_id)
                                            + " "
                                            + implementation_detail
                                    },
                                false,
                            );
                            (type_id, Option::Some(constant::ConstValue::Unknown))
                        }
                    } else {
                        diagnostic(
                            state,
                            node,
                            "cannot use " + operand_string(state, node, operand) + " as "
                                + diagnostic_type_string(state, type_id)
                                + " value in "
                                + declaration_context,
                            false,
                        );
                        (type_id, Option::Some(constant::ConstValue::Unknown))
                    },
                    kind => match constant::round_constant(value, kind, state.config.sizes) {
                        Some(value) => (type_id, Option::Some(value)),
                        None => {
                            diagnostic(
                                state,
                                node,
                                "cannot use " + operand_string(state, node, operand) + " as "
                                    + diagnostic_type_string(state, type_id)
                                    + " value in "
                                    + declaration_context
                                    + if basic_kind(state, type_id) == go_types::BasicKind::String {
                                        ""
                                    } else if go_types::is_integer(state.world, type_id)
                                        && constant::constant_to_integer(value).is_none() {
                                        " (truncated)"
                                    } else {
                                        " (overflows)"
                                    },
                                false,
                            );
                            (type_id, Option::Some(constant::ConstValue::Unknown))
                        },
                    },
                }
            },
            None => if argument_assignable(state, operand, type_id) {
                (type_id, Option::None)
            } else {
                let needs_type_assertion = go_types::is_interface(state.world, operand.type_id)
                    && !go_types::is_interface(state.world, type_id);
                let type_parameter_detail = type_parameter_assignment_failure(
                    state,
                    operand.type_id,
                    type_id,
                );
                let implementation_detail = interface_implementation_detail(
                    state,
                    operand.type_id,
                    type_id,
                );
                diagnostic(
                    state,
                    node,
                    "cannot use " + operand_string(state, node, operand) + " as "
                        + diagnostic_type_string(state, type_id)
                        + " value in "
                        + declaration_context
                        + if needs_type_assertion {
                            ": need type assertion"
                        } else if type_parameter_detail != "" {
                            ": " + type_parameter_detail
                        } else if implementation_detail == "" {
                            ""
                        } else {
                            ": " + implementation_type_string(state, operand.type_id)
                                + " does not implement "
                                + implementation_type_string(state, type_id)
                                + " "
                                + implementation_detail
                        },
                    false,
                );
                (type_id, Option::None)
            },
        },
        None => if constant_declaration {
            (operand.type_id, operand.value)
        } else if basic_kind(state, operand.type_id) == go_types::BasicKind::UntypedNil {
            diagnostic(state, node, "use of untyped nil in variable declaration", false);
            (state.world.invalid, Option::None)
        } else {
            let type_id = default_type_for_kind(state, basic_kind(state, operand.type_id)).unwrap_or(
                operand.type_id,
            );
            match operand.value {
                Some(value) => match constant::round_constant(
                    value,
                    basic_kind(state, type_id),
                    state.config.sizes,
                ) {
                    Some(value) => (type_id, Option::Some(value)),
                    None => {
                        diagnostic(
                            state,
                            node,
                            if go_types::is_untyped(state.world, operand.type_id) {
                                "cannot use " + operand_string(state, node, operand) + " as "
                                    + diagnostic_type_string(state, type_id)
                                    + " value in "
                                    + declaration_context
                                    + " (overflows)"
                            } else {
                                operand_string(state, node, operand) + " overflows "
                                    + diagnostic_type_string(state, type_id)
                            },
                            false,
                        );
                        (type_id, Option::Some(constant::ConstValue::Unknown))
                    },
                },
                None => (type_id, Option::None),
            }
        },
    };
    if !assignment_context {
        match operand.value {
            Some(source_value) => {
                let fact_type = match explicit_type {
                    Some(type_id) => if !constant_declaration
                        && go_types::is_interface(state.world, type_id) {
                        default_type_for_kind(state, basic_kind(state, operand.type_id)).unwrap_or(
                            operand.type_id,
                        )
                    } else {
                        type_id
                    },
                    None => if constant_declaration {
                        operand.type_id
                    } else {
                        result.0
                    },
                };
                let failed_conversion = constant::constant_kind(source_value)
                    != constant::ConstantKind::Unknown
                    && match result.1 {
                        Some(value) => constant::constant_kind(value)
                            == constant::ConstantKind::Unknown,
                        None => false,
                    };
                if !failed_conversion {
                    update_operand_fact(state, node, fact_type, result.1)
                }
            },
            None => update_contextual_operand_fact(state, node, operand, result.0),
        }
    }
    result
}

fn pending_value_index(state: CheckState, object: go_types::ObjectId) -> Option[isize] {
    state.pending_value_indices[object.value]
}

fn publish_active_initializer_root_type(
    state: CheckState,
    node: syntax::NodeId,
    type_id: go_types::TypeId,
) -> () {
    if state.active_value_objects.is_empty() || type_id.value == state.world.invalid.value {
        return
    }
    let object = state.active_value_objects[state.active_value_objects.len() - 1];
    match pending_value_index(state, object) {
        Some(index) => if !state.pending_values[index].constant_declaration
            && state.pending_values[index].value_nodes.len() == 1
            && state.pending_values[index].value_count == 1 {
            let root = state.pending_values[index].value_nodes[0];
            let published_type = if root.value == node.value {
                Option::Some(type_id)
            } else {
                match syntax::get_kind(state.syntax.arena, root) {
                    Some(syntax::SyntaxKind::CallExpr {
                        function,
                        lparen: _,
                        arguments: _,
                        ellipsis: _,
                        rparen: _,
                    }) => if function.value == node.value {
                        let results = signature_results(state, type_id);
                        if results.len() == 1 {
                            Option::Some(results[0].type_id)
                        } else {
                            Option::None
                        }
                    } else {
                        Option::None
                    },
                    _ => Option::None,
                }
            };
            match (go_types::get_object(state.world, object), published_type) {
                (Some(value), Some(published_type)) => if value.type_id.value
                    == state.world.invalid.value {
                    let _ = go_types::set_object_type(state.world, object, published_type);
                },
                _ => {},
            }
        },
        None => {},
    }
}

fn pending_initializer_objects(state: CheckState, pending: PendingValue) -> Vec[go_types::ObjectId] {
    let result: Vec[go_types::ObjectId] = Vec::new();
    if pending.value_nodes.len() != 1 || pending.value_count == 1 {
        result.push(pending.object);
        return result
    }
    for candidate in state.pending_values {
        if candidate.declaration_node.value == pending.declaration_node.value {
            result.push(candidate.object)
        }
    }
    result
}

fn initialization_function_object(state: CheckState, object: go_types::ObjectId) -> bool {
    if pending_function_index(state, object).is_some() {
        return true
    }
    for pending in state.pending_methods {
        if pending.object.value == object.value {
            return true
        }
    }
    false
}

fn save_initialization_dependency_for_active(state: CheckState, object: go_types::ObjectId) -> () {
    let mut active_value = Option::None;
    for active in state.active_initialization_objects {
        match pending_value_index(state, active) {
            Some(active_index) => if !state.pending_values[active_index].constant_declaration {
                active_value = Option::Some(active);
            },
            None => if initialization_function_object(state, active) {
                let mut present = false;
                for dependency in state.function_initialization_dependencies {
                    if dependency.0.value == active.value && dependency.1.value == object.value {
                        present = true;
                    }
                }
                if !present {
                    state.function_initialization_dependencies.push((active, object));
                }
            },
        };
    }
    for active in state.active_function_objects {
        let mut present = false;
        for dependency in state.function_initialization_dependencies {
            if dependency.0.value == active.value && dependency.1.value == object.value {
                present = true;
            }
        }
        if !present {
            state.function_initialization_dependencies.push((active, object));
        }
    }
    match active_value {
        Some(active) => {
            let mut present = false;
            for dependency in state.initialization_dependencies {
                if dependency.0.value == active.value && dependency.1.value == object.value {
                    present = true;
                }
            }
            if !present {
                state.initialization_dependencies.push((active, object));
            }
        },
        None => {},
    };
}

fn record_initialization_dependency(state: CheckState, object: go_types::ObjectId) -> () {
    match pending_value_index(state, object) {
        Some(target) => if !state.pending_values[target].constant_declaration {
            save_initialization_dependency_for_active(state, object)
        },
        None => {},
    }
}

fn evaluate_object(state: CheckState, object: go_types::ObjectId) -> () {
    if let Some(index) = pending_value_index(state, object) {
        evaluate_pending_value(state, index)
    }
    let _ = evaluate_function_object(state, object);
}

fn initializer_contains_object(fact: InitializerFact, object: go_types::ObjectId) -> bool {
    for candidate in fact.left {
        if candidate.value == object.value {
            return true
        }
    }
    false
}

fn initializer_dependency_count(
    dependencies: Vec[isize],
    emitted: Vec[bool],
    cycle_dependency: bool,
) -> isize {
    let mut count = 0;
    for dependency in dependencies {
        if !emitted[dependency] {
            count += 1;
        }
    }
    if count == 0 && cycle_dependency {
        1
    } else {
        count
    }
}

fn initializer_dependency_indices(state: CheckState, facts: Vec[InitializerFact]) -> Vec[Vec[isize]] {
    let object_facts: HashMap[isize, isize] = HashMap::new();
    let dependencies: Vec[Vec[isize]] = Vec::new();
    for index in 0..facts.len() {
        dependencies.push(Vec::new());
        for object in facts[index].left {
            object_facts[object.value] = index;
        }
    }
    for dependency in state.initialization_dependencies {
        match (object_facts[dependency.0.value], object_facts[dependency.1.value]) {
            (Some(source), Some(target)) => if source != target || facts[source].left.len() == 1 {
                let mut present = false;
                for existing in dependencies[source] {
                    if existing == target {
                        present = true;
                    }
                }
                if !present {
                    dependencies[source].push(target)
                }
            },
            _ => {},
        }
    }
    dependencies
}

fn initializer_cycle_dependencies(state: CheckState, facts: Vec[InitializerFact]) -> Vec[bool] {
    let cycle_objects = collections::BitSet::new();
    for cycle in state.value_cycles {
        for object in cycle.objects {
            let _ = cycle_objects.insert(object.value);
        }
    }
    let result: Vec[bool] = Vec::new();
    for fact in facts {
        let mut present = false;
        if fact.left.len() > 1 {
            for object in fact.left {
                if cycle_objects.contains(object.value) {
                    present = true;
                }
            }
        }
        result.push(present);
    }
    result
}

fn initializer_order_node(state: CheckState, fact: InitializerFact) -> syntax::NodeId {
    if fact.left.is_empty() {
        fact.right
    } else {
        let object = fact.left[0];
        if object.value >= 0 && object.value < state.world.objects.len() {
            state.world.objects[object.value].node.unwrap_or(fact.right)
        } else {
            fact.right
        }
    }
}

fn sort_independent_initializers(
    facts: Vec[InitializerFact],
    visible: Vec[bool],
    order_files: Vec[string],
    order_starts: Vec[isize],
    sorted: Vec[InitializerFact],
) -> () {
    let indices: Vec[isize] = Vec::with_capacity(facts.len());
    for index in 0..facts.len() {
        indices.push(index)
    }
    collections::stable_sort_by(
        indices,
        |left, right| {
            if order_files[left] < order_files[right] {
                -1
            } else if order_files[left] > order_files[right] {
                1
            } else if order_starts[left] < order_starts[right] {
                -1
            } else if order_starts[left] > order_starts[right] {
                1
            } else {
                0
            }
        },
    );
    for index in indices {
        if visible[index] {
            sorted.push(facts[index])
        }
    }
}

fn sort_initializers(state: CheckState) -> () {
    let facts: Vec[InitializerFact] = Vec::new();
    let visible: Vec[bool] = Vec::new();
    for fact in state.info.init_order {
        facts.push(fact);
        visible.push(true);
    }
    for pending in state.pending_values {
        if !pending.constant_declaration && pending.value_nodes.is_empty() {
            let mut present = false;
            for fact in facts {
                if fact.right.value == pending.declaration_node.value {
                    present = true;
                }
            }
            if !present {
                let left: Vec[go_types::ObjectId] = Vec::new();
                for candidate in state.pending_values {
                    if !candidate.constant_declaration && candidate.value_nodes.is_empty()
                        && candidate.declaration_node.value == pending.declaration_node.value {
                        left.push(candidate.object);
                    }
                }
                facts.push(InitializerFact { left, right: pending.declaration_node });
                visible.push(false);
            }
        }
    }
    let emitted: Vec[bool] = Vec::new();
    for _ in facts {
        emitted.push(false);
    }
    let dependencies = initializer_dependency_indices(state, facts);
    let cycle_dependencies = initializer_cycle_dependencies(state, facts);
    let order_files: Vec[string] = Vec::with_capacity(facts.len());
    let order_starts: Vec[isize] = Vec::with_capacity(facts.len());
    for fact in facts {
        let node = initializer_order_node(state, fact);
        if node.value >= 0 && node.value < state.syntax.arena.nodes.len() {
            let value = syntax::node_at(state.syntax.arena, node.value);
            if value.file.value >= 0 && value.file.value < state.syntax.files.len() {
                order_files.push(state.syntax.files[value.file.value].name)
            } else {
                order_files.push("")
            }
            order_starts.push(value.span.start)
        } else {
            order_files.push("");
            order_starts.push(-1)
        }
    }
    let sorted: Vec[InitializerFact] = Vec::with_capacity(facts.len());
    let mut independent = true;
    for index in 0..facts.len() {
        if !dependencies[index].is_empty() || cycle_dependencies[index] {
            independent = false;
            break
        }
    }
    if independent {
        sort_independent_initializers(facts, visible, order_files, order_starts, sorted)
    } else {
        let mut completed = 0;
        while completed < facts.len() {
            let mut selected = -1;
            let mut selected_dependencies = -1;
            for index in 0..facts.len() {
                if !emitted[index] {
                    let dependency_count = initializer_dependency_count(
                        dependencies[index],
                        emitted,
                        cycle_dependencies[index],
                    );
                    if selected < 0 || dependency_count < selected_dependencies
                        || (dependency_count == selected_dependencies
                            && (order_files[index] < order_files[selected]
                                || (order_files[index] == order_files[selected]
                                    && order_starts[index] < order_starts[selected]))) {
                        selected = index;
                        selected_dependencies = dependency_count;
                    }
                }
            }
            if selected < 0 {
                return
            }
            emitted[selected] = true;
            completed += 1;
            if visible[selected] {
                sorted.push(facts[selected]);
            }
        }
    }
    while !state.info.init_order.is_empty() {
        let _ = state.info.init_order.pop();
    }
    for fact in sorted {
        state.info.init_order.push(fact);
    }
}

fn function_body(state: CheckState, object: go_types::ObjectId) -> Option[
    (syntax::NodeId, syntax::NodeId),
] {
    for file in state.syntax.files {
        match syntax::get_kind(state.syntax.arena, file.root) {
            Some(syntax::SyntaxKind::File {
                package_pos: _,
                name: _,
                declarations,
                imports: _,
                go_version: _,
            }) => for declaration in declarations {
                match syntax::get_kind(state.syntax.arena, declaration) {
                    Some(syntax::SyntaxKind::FuncDecl { receiver: _, name, type_node, body }) => match (
                        declared_object(state, name),
                        body,
                    ) {
                        (Some(candidate), Some(body)) => if candidate.value == object.value {
                            return Option::Some((type_node, body))
                        },
                        _ => {},
                    },
                    _ => {},
                }
            },
            _ => {},
        }
    }
    Option::None
}

fn evaluate_function_dependency(state: CheckState, object: go_types::ObjectId) -> () {
    if state.initialization_depth <= 0 || !state.function_dependencies_enabled {
        return
    }
    let dependencies: Vec[go_types::ObjectId] = Vec::new();
    for dependency in state.function_initialization_dependencies {
        if dependency.0.value == object.value {
            dependencies.push(dependency.1)
        }
    }
    for dependency in dependencies {
        save_initialization_dependency_for_active(state, dependency)
    }
    if record_function_dependency_cycle(state, object) {
        return
    }
    match (go_types::get_object(state.world, object), function_body(state, object)) {
        (Some(function), Some((signature_node, body))) => {
            state.active_initialization_objects.push(object);
            check_deferred_function_body_early(state, signature_node, function.type_id, body, -1);
            state.active_initialization_objects.pop();
        },
        _ => {},
    }
}

fn object_position(state: CheckState, object: go_types::ObjectId) -> isize {
    match go_types::get_object(state.world, object) {
        Some(object) => object.position,
        None => -1,
    }
}

fn save_value_cycle(state: CheckState, objects: Vec[go_types::ObjectId], declaration: bool) -> () {
    if objects.is_empty() {
        return
    }
    for existing in state.value_cycles {
        if existing.declaration == declaration && existing.objects.len() == objects.len() {
            let mut same = true;
            for index in 0..objects.len() {
                if existing.objects[index].value != objects[index].value {
                    same = false;
                }
            }
            if same {
                return
            }
        }
    }
    state.value_cycles.push(ValueCycle { objects, declaration, reported: false })
}

fn record_function_dependency_cycle(state: CheckState, object: go_types::ObjectId) -> bool {
    let mut start = -1;
    for index in 0..state.active_initialization_objects.len() {
        if state.active_initialization_objects[index].value == object.value && start < 0 {
            start = index;
        }
    }
    if start < 0 {
        return false
    }
    let cycle: Vec[go_types::ObjectId] = Vec::new();
    for index in start..state.active_initialization_objects.len() {
        cycle.push(state.active_initialization_objects[index])
    }
    let mut value_start = -1;
    for index in 0..cycle.len() {
        if pending_value_index(state, cycle[index]).is_some() {
            value_start = index;
        }
    }
    if value_start >= 0 {
        let normalized: Vec[go_types::ObjectId] = Vec::new();
        for index in 0..cycle.len() {
            normalized.push(cycle[(value_start + index) % cycle.len()])
        }
        save_value_cycle(state, normalized, false)
    }
    true
}

fn record_value_cycle(state: CheckState, object: go_types::ObjectId) -> () {
    let mut start = -1;
    for index in 0..state.active_initialization_objects.len() {
        if state.active_initialization_objects[index].value == object.value && start < 0 {
            start = index;
        }
    }
    if start < 0 {
        return
    }
    let cycle: Vec[go_types::ObjectId] = Vec::new();
    for index in start..state.active_initialization_objects.len() {
        cycle.push(state.active_initialization_objects[index])
    }
    for function in state.active_function_objects {
        let mut present = false;
        for existing in cycle {
            if existing.value == function.value {
                present = true;
            }
        }
        if !present {
            cycle.push(function)
        }
    }
    save_value_cycle(state, cycle, !state.active_function_objects.is_empty())
}

fn value_cycle_is_constant(state: CheckState, cycle: ValueCycle) -> bool {
    if cycle.objects.is_empty() {
        false
    } else {
        match pending_value_index(state, cycle.objects[0]) {
            Some(index) => state.pending_values[index].constant_declaration,
            None => false,
        }
    }
}

fn value_cycle_is_suppressed(state: CheckState, cycle: ValueCycle) -> bool {
    if cycle.objects.is_empty() {
        false
    } else {
        match pending_value_index(state, cycle.objects[0]) {
            Some(index) => state.pending_values[index].invalid_constant_type,
            None => false,
        }
    }
}

fn report_value_cycles(state: CheckState, declaration: bool) -> () {
    loop {
        let mut selected = -1;
        for index in 0..state.value_cycles.len() {
            if !state.value_cycles[index].reported
                && state.value_cycles[index].declaration == declaration
                && (selected < 0
                    || (!declaration && value_cycle_is_constant(state, state.value_cycles[index])
                        && !value_cycle_is_constant(state, state.value_cycles[selected]))
                    || (value_cycle_is_constant(state, state.value_cycles[index])
                        == value_cycle_is_constant(state, state.value_cycles[selected])
                        && object_position(state, state.value_cycles[index].objects[0])
                            < object_position(state, state.value_cycles[selected].objects[0]))) {
                selected = index;
            }
        }
        if selected < 0 {
            return
        }
        state.value_cycles[selected].reported = true;
        if !declaration && value_cycle_is_suppressed(state, state.value_cycles[selected]) {
            continue
        }
        let objects = state.value_cycles[selected].objects;
        if objects.is_empty() {
            continue
        }
        let first = go_types::get_object(state.world, objects[0]);
        match first {
            Some(first) => match first.node {
                Some(node) => if objects.len() == 1 {
                    diagnostic(
                        state,
                        node,
                        if declaration {
                            "invalid cycle in declaration of " + first.name
                        } else {
                            "initialization cycle: " + first.name + " refers to itself"
                        },
                        false,
                    )
                } else {
                    diagnostic(
                        state,
                        node,
                        if declaration {
                            "invalid cycle in declaration of " + first.name
                        } else {
                            "initialization cycle for " + first.name
                        },
                        false,
                    );
                    for index in 0..objects.len() {
                        match (
                            go_types::get_object(state.world, objects[index]),
                            go_types::get_object(state.world, objects[(index + 1) % objects.len()]),
                        ) {
                            (Some(current), Some(next)) => match current.node {
                                Some(current_node) => secondary_diagnostic(
                                    state,
                                    current_node,
                                    "\t" + current.name + " refers to " + next.name,
                                ),
                                None => {},
                            },
                            _ => {},
                        }
                    }
                },
                None => {},
            },
            None => {},
        }
    }
}

fn evaluate_pending_value(state: CheckState, index: isize) -> () {
    if index < 0 || index >= state.pending_values.len() {
        return
    } else if state.pending_values[index].status == 2 {
        return
    } else if state.pending_values[index].status == 1 {
        record_value_cycle(state, state.pending_values[index].object);
        return
    }
    state.pending_values[index].status = 1;
    let pending = state.pending_values[index];
    state.active_value_objects.push(pending.object);
    state.active_initialization_objects.push(pending.object);
    let previous_iota = state.current_iota;
    let previous_diagnostic_override = state.diagnostic_override;
    state.current_iota = pending.iota_value;
    if pending.inherited_initializer {
        state.diagnostic_override = go_types::get_object(state.world, pending.object).and_then(
            |object| object.node,
        );
    }
    let explicit_type = pending.type_node.map(
        |node| declaration_type(state, pending.file_scope, node, pending.constant_declaration),
    );
    state.pending_values[index].invalid_constant_type = pending.constant_declaration
        && match explicit_type {
            Some(type_id) => !valid_constant_declaration_type(state, type_id),
            None => false,
        };
    if state.pending_values[index].invalid_constant_type {
        let value = constant::ConstValue::Unknown;
        let _ = go_types::set_object_type(state.world, pending.object, state.world.invalid);
        save_constant(state, pending.object, value);
        let _ = go_types::set_object_constant(
            state.world,
            pending.object,
            constant::constant_kind_name(value),
            constant::constant_exact_string(value),
        );
        state.current_iota = previous_iota;
        state.diagnostic_override = previous_diagnostic_override;
        state.active_value_objects.pop();
        state.active_initialization_objects.pop();
        state.pending_values[index].status = 2;
        return
    }
    match explicit_type {
        Some(type_id) => {
            let _ = go_types::set_object_type(state.world, pending.object, type_id);
            if pending.constant_declaration {
                let value = constant::ConstValue::Unknown;
                save_constant(state, pending.object, value);
                let _ = go_types::set_object_constant(
                    state.world,
                    pending.object,
                    constant::constant_kind_name(value),
                    constant::constant_exact_string(value),
                );
            }
        },
        None => {},
    }
    if !pending.value_nodes.is_empty() {
        state.initialization_depth += 1;
        let direct_value = pending.value_nodes.len() == pending.value_count
            && pending.value_nodes.len() > 1;
        let operand_nodes = if direct_value {
            Vec::from_array([pending.value_nodes[pending.value_index]])
        } else if pending.value_nodes.len() > pending.value_count && pending.value_nodes.len() != 1 {
            let result: Vec[syntax::NodeId] = Vec::new();
            for index in 0..pending.value_count {
                result.push(pending.value_nodes[index])
            }
            result
        } else {
            pending.value_nodes
        };
        let operands = assignment_operands(
            state,
            pending.file_scope,
            operand_nodes,
            if direct_value {
                1
            } else {
                pending.value_count
            },
            !pending.constant_declaration,
            match explicit_type {
                Some(type_id) => if pending.value_nodes.len() == 1 && pending.value_count > 1 {
                    Vec::new()
                } else {
                    let result: Vec[go_types::TypeId] = Vec::new();
                    for _ in operand_nodes {
                        result.push(type_id)
                    }
                    result
                },
                None => Vec::new(),
            },
            {
                let result: Vec[string] = Vec::new();
                let description = match go_types::get_object(state.world, pending.object) {
                    Some(object) => object.name,
                    None => "_",
                };
                for _ in operand_nodes {
                    result.push(description)
                }
                result
            },
        );
        let assignment_arity_mismatch = !pending.constant_declaration
            && operands.len() != pending.value_count
            && pending.value_nodes.len() == 1;
        if assignment_arity_mismatch && !operands.is_empty()
            && operands[0].type_id.value != state.world.invalid.value
            && (pending.value_index == 0 || state.active_initialization_objects.len() > 1) {
            let source = pending.value_nodes[0];
            if pending.value_count == 1 {
                let types: Vec[string] = Vec::new();
                for operand in operands {
                    types.push(diagnostic_type_string(state, operand.type_id))
                }
                let value_type = match recorded_type_fact(state, source) {
                    Some(fact) => match go_types::get_type(
                        state.world,
                        go_types::unalias(state.world, fact.type_id),
                    ) {
                        Some(go_types::TypeData {
                            id: _,
                            kind: go_types::TypeKind::Tuple { variables: _ },
                        }) => diagnostic_type_string(state, fact.type_id),
                        _ => "(" + text::join(types, ", ") + ")",
                    },
                    None => "(" + text::join(types, ", ") + ")",
                };
                diagnostic(
                    state,
                    source,
                    "multiple-value " + expression_source_text(state, source) + " (value of type "
                        + value_type
                        + ") in single-value context",
                    false,
                )
            } else {
                let value_count = operands.len().to_string()
                    + if operands.len() == 1 {
                        " value"
                    } else {
                        " values"
                    };
                let value_description = match syntax::get_kind(state.syntax.arena, source) {
                    Some(syntax::SyntaxKind::CallExpr {
                        function,
                        lparen: _,
                        arguments: _,
                        ellipsis: _,
                        rparen: _,
                    }) => expression_source_text(state, function) + " returns " + value_count,
                    _ => value_count,
                };
                diagnostic(
                    state,
                    source,
                    f"assignment mismatch: {pending.value_count} variables but {value_description}",
                    false,
                )
            }
        }
        state.initialization_depth -= 1;
        let operand_index = if direct_value {
            0
        } else {
            pending.value_index
        };
        if operand_index < operands.len() {
            let node = if direct_value {
                pending.value_nodes[pending.value_index]
            } else if pending.value_nodes.len() == 1 {
                pending.value_nodes[0]
            } else {
                pending.value_nodes[pending.value_index]
            };
            let checked = declaration_operand(
                state,
                node,
                operands[operand_index],
                explicit_type,
                pending.constant_declaration,
                pending.value_nodes.len() == 1 && pending.value_count > 1,
            );
            if assignment_arity_mismatch && explicit_type.is_none()
                && go_types::is_untyped(state.world, operands[operand_index].type_id) {
                update_operand_fact(
                    state,
                    node,
                    operands[operand_index].type_id,
                    operands[operand_index].value,
                )
            }
            let declared_type = if assignment_arity_mismatch && explicit_type.is_none() {
                state.world.invalid
            } else {
                checked.0
            };
            let _ = go_types::set_object_type(state.world, pending.object, declared_type);
            if pending.constant_declaration {
                match checked.1 {
                    Some(value) => {
                        save_constant(state, pending.object, value);
                        let _ = go_types::set_object_constant(
                            state.world,
                            pending.object,
                            constant::constant_kind_name(value),
                            constant::constant_exact_string(value),
                        );
                    },
                    None => {
                        let value = constant::ConstValue::Unknown;
                        save_constant(state, pending.object, value);
                        let _ = go_types::set_object_constant(
                            state.world,
                            pending.object,
                            constant::constant_kind_name(value),
                            constant::constant_exact_string(value),
                        );
                    },
                }
            } else if pending.value_nodes.len() != 1 || pending.value_index == 0 {
                state.info.init_order.push(
                    InitializerFact {
                        left: pending_initializer_objects(state, pending),
                        right: node,
                    },
                )
            }
        } else if pending.constant_declaration {
            let value = constant::ConstValue::Unknown;
            save_constant(state, pending.object, value);
            let _ = go_types::set_object_constant(
                state.world,
                pending.object,
                constant::constant_kind_name(value),
                constant::constant_exact_string(value),
            );
        } else if assignment_arity_mismatch {
            let declared_type = explicit_type.unwrap_or(state.world.invalid);
            let _ = go_types::set_object_type(state.world, pending.object, declared_type);
        }
    } else {
        match explicit_type {
            Some(type_id) => {
                let _ = go_types::set_object_type(state.world, pending.object, type_id);
            },
            None => {},
        }
        if pending.constant_declaration {
            let value = constant::ConstValue::Unknown;
            save_constant(state, pending.object, value);
            let _ = go_types::set_object_constant(
                state.world,
                pending.object,
                constant::constant_kind_name(value),
                constant::constant_exact_string(value),
            );
        }
    }
    state.current_iota = previous_iota;
    state.diagnostic_override = previous_diagnostic_override;
    state.active_value_objects.pop();
    state.active_initialization_objects.pop();
    state.pending_values[index].status = 2;
}

fn check_value_spec(
    state: CheckState,
    file_scope: go_types::ScopeId,
    package_scope: go_types::ScopeId,
    node: syntax::NodeId,
    constant_declaration: bool,
) -> () {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::ValueSpec { names, type_node, values }) => {
            if values.is_empty() {
                if constant_declaration {
                    for name in names {
                        match declared_object(state, name) {
                            Some(object) => if !state.config.exported_api_only
                                || state.world.objects[object.value].exported {
                                evaluate_object(state, object)
                            },
                            None => {},
                        }
                    }
                } else if type_node.is_none() {} else {
                    for name in names {
                        match declared_object(state, name) {
                            Some(object) => if !state.config.exported_api_only
                                || state.world.objects[object.value].exported {
                                evaluate_object(state, object)
                            },
                            None => {},
                        }
                    }
                }
            } else if names.len() != values.len() && values.len() != 1 {
                for name in names {
                    match declared_object(state, name) {
                        Some(object) => if !state.config.exported_api_only
                            || state.world.objects[object.value].exported {
                            evaluate_object(state, object)
                        },
                        None => {},
                    }
                }
            } else {
                for name in names {
                    match declared_object(state, name) {
                        Some(object) => if !state.config.exported_api_only
                            || state.world.objects[object.value].exported {
                            evaluate_object(state, object)
                        },
                        None => {},
                    }
                }
            }
        },
        _ => diagnostic(state, node, "invalid variable declaration", false),
    }
}

fn check_type_spec(state: CheckState, node: syntax::NodeId) -> () {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::TypeSpec { name, type_params, assign, type_node }) => {
            match declared_object(state, name) {
                Some(object) => {
                    let unchecked = match pending_type_index(state, object) {
                        Some(index) => state.pending_types[index].status == 0,
                        None => false,
                    };
                    if unchecked && assign > 0 && type_params.is_none()
                        && !go_version_at_least(state, node, 9) {
                        diagnostic_at_position(
                            state,
                            node,
                            assign,
                            "type alias requires go1.9 or later",
                            false,
                        )
                    }
                    let _ = evaluate_type_object(state, object);
                },
                None => {
                    let declaration_name = identifier(state, name).unwrap_or("");
                    let invalid_special_name = declaration_name == "init"
                        || (declaration_name == "main"
                            && state.world.packages[state.package_id.value].name == "main");
                    if !invalid_special_name {
                        match node_file(state, node) {
                            Some(file) => {
                                let _ = resolve_type(
                                    state,
                                    state.file_scopes[file.value],
                                    type_node,
                                );
                            },
                            None => {},
                        }
                    }
                },
            }
        },
        _ => diagnostic(state, node, "invalid type declaration", false),
    }
}

fn check_declaration(
    state: CheckState,
    file_scope: go_types::ScopeId,
    package_scope: go_types::ScopeId,
    node: syntax::NodeId,
) -> () {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::GenDecl { token_pos: _, token, lparen: _, specs, rparen: _ }) => if value_declaration_keyword(
            token,
        ) {
            for spec in specs {
                check_value_spec(state, file_scope, package_scope, spec, token == CONST_KEYWORD)
            }
        } else if token == TYPE_KEYWORD {
            for spec in specs {
                check_type_spec(state, spec)
            }
        } else if token == IMPORT_KEYWORD {} else {
            diagnostic(state, node, token + " declarations are not implemented yet", false)
        },
        Some(syntax::SyntaxKind::FuncDecl { receiver, name, type_node, body }) => match receiver {
            Some(_) => if !state.config.ignore_func_bodies {
                match (declared_object(state, name), body) {
                    (Some(object), Some(body)) => if let Some(object) = go_types::get_object(
                        state.world,
                        object,
                    ) {
                        check_function_body(state, type_node, object.type_id, body)
                    },
                    _ => {},
                }
            },
            None => {
                match declared_object(state, name) {
                    Some(object) => {
                        if !state.config.exported_api_only
                            || state.world.objects[object.value].exported {
                            let _ = evaluate_function_object(state, object);
                        }
                        if !state.config.ignore_func_bodies {
                            match (go_types::get_object(state.world, object), body) {
                                (Some(object), Some(body)) => check_function_body(
                                    state,
                                    type_node,
                                    object.type_id,
                                    body,
                                ),
                                _ => {},
                            }
                        }
                    },
                    None => {
                        let _ = resolve_function_signature(state, file_scope, type_node, false);
                    },
                }
            },
        },
        Some(syntax::SyntaxKind::BadDecl { from: _, to: _ }) => {},
        Some(_) => diagnostic(state, node, "declaration is not implemented yet", false),
        None => diagnostic(state, node, "missing declaration node", false),
    }
}

fn prepare_file_methods(state: CheckState, file_index: isize) -> () {
    let file = state.syntax.files[file_index];
    let file_scope = state.file_scopes[file_index];
    match syntax::get_kind(state.syntax.arena, file.root) {
        Some(syntax::SyntaxKind::File {
            package_pos: _,
            name: _,
            declarations,
            imports: _,
            go_version: _,
        }) => for declaration in declarations {
            match syntax::get_kind(state.syntax.arena, declaration) {
                Some(syntax::SyntaxKind::FuncDecl { receiver, name, type_node, body: _ }) => match receiver {
                    Some(receiver) => predeclare_method_declaration(
                        state,
                        file_scope,
                        receiver,
                        name,
                        type_node,
                    ),
                    None => {},
                },
                _ => {},
            }
        },
        _ => {},
    }
}

fn check_file_missing_method_receivers(state: CheckState, file_index: isize) -> () {
    let file = state.syntax.files[file_index];
    match syntax::get_kind(state.syntax.arena, file.root) {
        Some(syntax::SyntaxKind::File {
            package_pos: _,
            name: _,
            declarations,
            imports: _,
            go_version: _,
        }) => for declaration in declarations {
            match syntax::get_kind(state.syntax.arena, declaration) {
                Some(syntax::SyntaxKind::FuncDecl {
                    receiver: Some(receiver),
                    name: _,
                    type_node: _,
                    body: _,
                }) => check_missing_method_receiver(state, receiver),
                _ => {},
            }
        },
        _ => {},
    }
}

fn initialize_file(state: CheckState, file_index: isize, expected_name: string) -> () {
    let file = state.syntax.files[file_index];
    let file_scope = state.file_scopes[file_index];
    let package_scope = state.world.packages[state.package_id.value].scope;
    match syntax::get_kind(state.syntax.arena, file.root) {
        Some(syntax::SyntaxKind::File {
            package_pos: _,
            name,
            declarations: _,
            imports: _,
            go_version,
        }) => {
            state.info.defs.push(ObjectFact { node: name, object: Option::None });
            match identifier(state, name) {
                Some(actual_name) => if actual_name == "_" {
                    diagnostic(state, name, "invalid package name _", false)
                } else if actual_name != expected_name {
                    diagnostic(
                        state,
                        name,
                        "package " + actual_name + "; expected package " + expected_name,
                        false,
                    )
                },
                None => diagnostic(state, name, "invalid package name", false),
            }
            record_scope_fact(state, file.root, file_scope);
            state.info.file_versions.push(
                FileVersionFact {
                    file: file.id,
                    version: effective_file_version(state.config.go_version, go_version),
                },
            );
        },
        _ => diagnostic(state, file.root, "syntax root is not a file", false),
    }
}

fn check_file_declarations(state: CheckState, file_index: isize) -> () {
    let file = state.syntax.files[file_index];
    let file_scope = state.file_scopes[file_index];
    let package_scope = state.world.packages[state.package_id.value].scope;
    match syntax::get_kind(state.syntax.arena, file.root) {
        Some(syntax::SyntaxKind::File {
            package_pos: _,
            name: _,
            declarations,
            imports: _,
            go_version: _,
        }) => for declaration in declarations {
            check_declaration(state, file_scope, package_scope, declaration)
        },
        _ => {},
    }
}

fn check_file_type_declarations(state: CheckState, file_index: isize, aliases: bool) -> () {
    let file = state.syntax.files[file_index];
    match syntax::get_kind(state.syntax.arena, file.root) {
        Some(syntax::SyntaxKind::File {
            package_pos: _,
            name: _,
            declarations,
            imports: _,
            go_version: _,
        }) => for declaration in declarations {
            match syntax::get_kind(state.syntax.arena, declaration) {
                Some(syntax::SyntaxKind::GenDecl {
                    token_pos: _,
                    token,
                    lparen: _,
                    specs,
                    rparen: _,
                }) => if token == TYPE_KEYWORD {
                    for spec in specs {
                        match syntax::get_kind(state.syntax.arena, spec) {
                            Some(syntax::SyntaxKind::TypeSpec {
                                name: _,
                                type_params: _,
                                assign,
                                type_node: _,
                            }) => if (assign > 0) == aliases {
                                check_type_spec(state, spec)
                            },
                            _ => {},
                        }
                    }
                },
                _ => {},
            }
        },
        _ => {},
    }
}

fn check_file_function_bodies(state: CheckState, file_index: isize) -> () {
    let file = state.syntax.files[file_index];
    match syntax::get_kind(state.syntax.arena, file.root) {
        Some(syntax::SyntaxKind::File {
            package_pos: _,
            name: _,
            declarations,
            imports: _,
            go_version: _,
        }) => for declaration in declarations {
            match syntax::get_kind(state.syntax.arena, declaration) {
                Some(syntax::SyntaxKind::FuncDecl { receiver: _, name, type_node, body }) => match (
                    declared_object(state, name),
                    body,
                ) {
                    (Some(object), Some(body)) => match go_types::get_object(state.world, object) {
                        Some(object) => defer_function_body(
                            state,
                            type_node,
                            object.type_id,
                            body,
                            -1,
                        ),
                        None => {},
                    },
                    _ => {},
                },
                _ => {},
            }
        },
        _ => {},
    }
}

fn deferred_function_body_before(state: CheckState, left: isize, right: isize) -> bool {
    state.deferred_function_bodies[left].start < state.deferred_function_bodies[right].start
        || (state.deferred_function_bodies[left].start
            == state.deferred_function_bodies[right].start
            && left < right)
}

fn push_deferred_function_body(state: CheckState, index: isize) -> () {
    state.deferred_function_body_queue.push(index);
    let mut position = state.deferred_function_body_queue.len() - 1;
    while position > 0 {
        let parent = (position - 1) / 2;
        if !deferred_function_body_before(
            state,
            state.deferred_function_body_queue[position],
            state.deferred_function_body_queue[parent],
        ) {
            return
        }
        let value = state.deferred_function_body_queue[position];
        state.deferred_function_body_queue[position] = state.deferred_function_body_queue[parent];
        state.deferred_function_body_queue[parent] = value;
        position = parent;
    }
}

fn pop_deferred_function_body(state: CheckState) -> Option[isize] {
    if state.deferred_function_body_queue.is_empty() {
        return Option::None
    }
    let result = state.deferred_function_body_queue[0];
    let last = state.deferred_function_body_queue.pop().unwrap_or(result);
    if state.deferred_function_body_queue.is_empty() {
        return Option::Some(result)
    }
    state.deferred_function_body_queue[0] = last;
    let mut position = 0;
    loop {
        let left = position * 2 + 1;
        if left >= state.deferred_function_body_queue.len() {
            return Option::Some(result)
        }
        let right = left + 1;
        let selected = if right < state.deferred_function_body_queue.len()
            && deferred_function_body_before(
                state,
                state.deferred_function_body_queue[right],
                state.deferred_function_body_queue[left],
            ) {
            right
        } else {
            left
        };
        if !deferred_function_body_before(
            state,
            state.deferred_function_body_queue[selected],
            state.deferred_function_body_queue[position],
        ) {
            return Option::Some(result)
        }
        let value = state.deferred_function_body_queue[position];
        state.deferred_function_body_queue[position] = state.deferred_function_body_queue[selected];
        state.deferred_function_body_queue[selected] = value;
        position = selected;
    }
}

fn defer_function_body(
    state: CheckState,
    signature_node: syntax::NodeId,
    signature: go_types::TypeId,
    body: syntax::NodeId,
    iota_value: isize,
) -> () {
    if state.deferred_function_body_indices.contains(body.value) {
        return
    }
    let index = state.deferred_function_bodies.len();
    state.deferred_function_body_indices[body.value] = index;
    state.deferred_function_bodies.push(
        DeferredFunctionBody {
            signature_node,
            signature,
            body,
            start: node_start(state, body),
            iota_value,
            body_checked: false,
            emitted: false,
            diagnostics: Vec::new(),
        },
    );
    push_deferred_function_body(state, index)
}

fn check_deferred_function_body_early(
    state: CheckState,
    signature_node: syntax::NodeId,
    signature: go_types::TypeId,
    body: syntax::NodeId,
    iota_value: isize,
) -> () {
    defer_function_body(state, signature_node, signature, body, iota_value);
    let Some(deferred_index) = state.deferred_function_body_indices[body.value] else {
        return
    };
    if state.deferred_function_bodies[deferred_index].body_checked {
        return
    }
    if !state.function_dependencies_enabled {
        return
    }
    let pending_statuses: Vec[isize] = Vec::new();
    for pending in state.pending_values {
        pending_statuses.push(pending.status)
    }
    let diagnostics_start = state.diagnostics.len();
    check_function_body(state, signature_node, signature, body);
    for index in 0..state.pending_values.len() {
        if state.pending_values[index].constant_declaration && pending_statuses[index] == 0
            && state.pending_values[index].status != 0 {
            state.pending_values[index].status = 0;
        }
    }
    let captured: Vec[CheckDiagnostic] = Vec::new();
    for index in diagnostics_start..state.diagnostics.len() {
        captured.push(state.diagnostics[index])
    }
    while state.diagnostics.len() > diagnostics_start {
        let _ = state.diagnostics.pop();
    }
    state.deferred_function_bodies[deferred_index].body_checked = true;
    state.deferred_function_bodies[deferred_index].diagnostics = captured;
}

fn check_deferred_function_bodies(state: CheckState) -> () {
    loop {
        let Some(selected) = pop_deferred_function_body(state) else {
            return
        };
        if state.deferred_function_bodies[selected].emitted {
            continue
        }
        state.deferred_function_bodies[selected].emitted = true;
        let deferred = state.deferred_function_bodies[selected];
        if deferred.body_checked {
            for diagnostic in deferred.diagnostics {
                state.diagnostics.push(diagnostic)
            }
        } else {
            let previous_iota = state.current_iota;
            state.current_iota = deferred.iota_value;
            check_function_body(state, deferred.signature_node, deferred.signature, deferred.body);
            state.current_iota = previous_iota;
        }
    }
}

fn refresh_deferred_function_body_facts(state: CheckState) -> () {
    for deferred in state.deferred_function_bodies {
        let mut local_alias_body = false;
        for body in state.deferred_local_alias_bodies {
            if body.value == deferred.body.value {
                local_alias_body = true;
            }
        }
        if deferred.body_checked && !local_alias_body {
            let diagnostics_start = state.diagnostics.len();
            let scopes_start = state.info.scopes.len();
            let defs_start = state.info.defs.len();
            let uses_start = state.info.uses.len();
            let implicits_start = state.info.implicits.len();
            let selections_start = state.info.selections.len();
            let instances_start = state.info.instances.len();
            let init_order_start = state.info.init_order.len();
            let previous_iota = state.current_iota;
            let _ = state.checked_function_bodies.remove(deferred.body.value);
            state.current_iota = deferred.iota_value;
            check_function_body(state, deferred.signature_node, deferred.signature, deferred.body);
            state.current_iota = previous_iota;
            while state.diagnostics.len() > diagnostics_start {
                let _ = state.diagnostics.pop();
            }
            while state.info.scopes.len() > scopes_start {
                pop_scope_fact(state)
            }
            while state.info.defs.len() > defs_start {
                let _ = state.info.defs.pop();
            }
            while state.info.uses.len() > uses_start {
                let _ = state.info.uses.pop();
            }
            while state.info.implicits.len() > implicits_start {
                pop_implicit_fact(state);
            }
            while state.info.selections.len() > selections_start {
                match state.info.selections.pop() {
                    Some(fact) => {
                        let _ = state.selection_indices.remove(fact.node.value);
                    },
                    None => {},
                }
            }
            while state.info.instances.len() > instances_start {
                pop_instance(state);
            }
            while state.info.init_order.len() > init_order_start {
                let _ = state.info.init_order.pop();
            }
        }
    }
}

fn first_package_name(value: syntax::PackageSyntax) -> string {
    if value.files.is_empty() {
        return ""
    }
    match syntax::get_kind(value.arena, value.files[0].root) {
        Some(syntax::SyntaxKind::File {
            package_pos: _,
            name,
            declarations: _,
            imports: _,
            go_version: _,
        }) => match syntax::get_kind(value.arena, name) {
            Some(syntax::SyntaxKind::Ident { name_pos: _, name }) => if name == "_" {
                ""
            } else {
                name
            },
            _ => "",
        },
        _ => "",
    }
}

pub fn check_package_in_world(config: CheckConfig, input: PackageInput, world: go_types::World) -> CheckResult {
    go_types::set_alias_enabled(world, config.enable_alias);
    let diagnostics: Vec[CheckDiagnostic] = Vec::new();
    let syntax_sources: Vec[syntax::SourceFile] = Vec::new();
    let source_lengths: Vec[(string, isize)] = Vec::new();
    let source_texts: Vec[(string, string)] = Vec::new();
    for file in input.files {
        source_lengths.push((file.name, file.source.len()));
        if let Ok(text) = file.source.to_string_utf8() {
            source_texts.push((file.name, text))
        }
        let parsed = if config.exported_api_only {
            parser::parse_file_bytes_without_bodies(file.source)
        } else {
            parser::parse_file_bytes_without_comments(file.source)
        };
        for value in parsed.diagnostics {
            diagnostics.push(
                CheckDiagnostic {
                    file: file.name,
                    start: value.offset,
                    end: value.offset,
                    message: value.message,
                    soft: false,
                    secondary: false,
                },
            )
        }
        if let Some(root) = parsed.root {
            syntax_sources.push(syntax::SourceFile { name: file.name, root })
        }
    }
    let syntax_package = if !config.retain_syntax_paths
        || (config.ignore_func_bodies && config.disable_unused_import_check) {
        syntax::lower_package_without_paths(syntax_sources)
    } else {
        syntax::lower_package(syntax_sources)
    };
    for value in syntax_package.diagnostics {
        diagnostics.push(
            CheckDiagnostic {
                file: value.file,
                start: value.start,
                end: value.end,
                message: value.message,
                soft: false,
                secondary: false,
            },
        )
    }
    let package_name = first_package_name(syntax_package);
    let package_id = go_types::add_package(world, input.path, package_name, world.universe, false);
    let package_scope = world.packages[package_id.value].scope;
    let file_scopes: Vec[go_types::ScopeId] = Vec::new();
    for file in syntax_package.files {
        let root = syntax::get_node(syntax_package.arena, file.root);
        let start = 0;
        let mut end = match root {
            Some(value) => value.span.end,
            None => -1,
        };
        for entry in source_lengths {
            if entry.0 == file.name {
                end = entry.1;
            }
        }
        file_scopes.push(
            go_types::add_scope(
                world,
                go_types::ScopeKind::File,
                Option::Some(package_scope),
                Option::Some(file.id),
                start,
                end,
            ),
        )
    }
    let function_dependencies_enabled = !config.ignore_func_bodies;
    let function_scope_ends: HashMap[isize, isize] = HashMap::new();
    let statement_labels: HashMap[isize, string] = HashMap::new();
    let mut has_goto_statements = false;
    let effect_expression_nodes: Vec[syntax::NodeId] = Vec::new();
    let mut identifier_count = 0;
    for candidate in syntax_package.arena.nodes {
        match candidate.kind {
            syntax::SyntaxKind::Ident { name_pos: _, name: _ } => {
                identifier_count += 1;
            },
            syntax::SyntaxKind::FuncDecl { receiver: _, name: _, type_node, body: _ } | syntax::SyntaxKind::FuncLit {
                type_node,
                body: _,
            } => {
                function_scope_ends[type_node.value] = candidate.span.end;
            },
            syntax::SyntaxKind::LabeledStmt { label, colon: _, statement } => match syntax::get_kind(
                syntax_package.arena,
                label,
            ) {
                Some(syntax::SyntaxKind::Ident { name_pos: _, name }) => {
                    statement_labels[statement.value] = name;
                },
                _ => {},
            },
            syntax::SyntaxKind::BranchStmt { token_pos: _, token, label: _ } => if token
                == GOTO_KEYWORD {
                has_goto_statements = true;
            },
            syntax::SyntaxKind::CallExpr {
                function: _,
                lparen: _,
                arguments: _,
                ellipsis: _,
                rparen: _,
            } => effect_expression_nodes.push(candidate.id),
            syntax::SyntaxKind::UnaryExpr { op_pos: _, op, expression: _ } => if op
                == RECEIVE_OPERATOR {
                effect_expression_nodes.push(candidate.id)
            },
            _ => {},
        }
    }
    world.objects.reserve(identifier_count);
    collections::sort_by(
        effect_expression_nodes,
        |left: syntax::NodeId, right: syntax::NodeId| {
            let left_node = syntax::node_at(syntax_package.arena, left.value);
            let right_node = syntax::node_at(syntax_package.arena, right.value);
            if left_node.file.value < right_node.file.value {
                -1
            } else if left_node.file.value > right_node.file.value {
                1
            } else if left_node.span.start < right_node.span.start {
                -1
            } else if left_node.span.start > right_node.span.start {
                1
            } else if left_node.span.end < right_node.span.end {
                -1
            } else if left_node.span.end > right_node.span.end {
                1
            } else {
                left.value - right.value
            }
        },
    );
    let info = empty_info();
    info.types.reserve(syntax_package.arena.nodes.len());
    let state = CheckState {
        config,
        world,
        syntax: syntax_package,
        sources: input.files,
        source_texts,
        package_id,
        file_scopes,
        info,
        function_scope_ends,
        statement_labels,
        has_goto_statements,
        effect_expression_nodes,
        implicit_fact_nodes: collections::BitSet::new(),
        duplicate_implicit_facts: HashMap::new(),
        scope_fact_indices: HashMap::new(),
        scope_fact_previous_indices: Vec::new(),
        selection_indices: HashMap::new(),
        instance_nodes: collections::BitSet::new(),
        type_fact_indices: fact_index_slots(syntax_package.arena.nodes.len()),
        type_fact_source_indices: package_type_fact_source_index(syntax_package),
        type_visit_marks: Vec::new(),
        type_visit_generation: Ref::new(0),
        type_invalid_cache: Vec::new(),
        omitted_type_fact_nodes: collections::BitSet::new(),
        preserved_type_fact_nodes: collections::BitSet::new(),
        retained_invalid_type_fact_nodes: collections::BitSet::new(),
        failed_inference_nodes: collections::BitSet::new(),
        ignore_function_type_params: false,
        use_fact_indices: fact_index_slots(syntax_package.arena.nodes.len()),
        omitted_use_fact_nodes: collections::BitSet::new(),
        invalid_builtin_parameter_nodes: collections::BitSet::new(),
        used_objects: collections::BitSet::new(),
        constants: HashMap::new(),
        declared_objects: HashMap::new(),
        pending_values: Vec::new(),
        pending_value_indices: HashMap::new(),
        active_value_objects: Vec::new(),
        active_initialization_objects: Vec::new(),
        initialization_dependencies: Vec::new(),
        function_initialization_dependencies: Vec::new(),
        value_cycles: Vec::new(),
        pending_types: Vec::new(),
        pending_type_indices: HashMap::new(),
        active_type_objects: Vec::new(),
        deferred_type_validations: Vec::new(),
        invalid_type_objects: Vec::new(),
        deferred_direct_type_cycles: Vec::new(),
        deferred_type_value_cycles: Vec::new(),
        deferred_alias_type_cycles: Vec::new(),
        deferred_receiver_cycle_diagnostics: Vec::new(),
        deferred_interface_method_diagnostics: Vec::new(),
        deferred_interface_overlap_diagnostics: Vec::new(),
        deferred_interface_version_diagnostics: Vec::new(),
        deferred_union_diagnostics: Vec::new(),
        deferred_local_type_validations: Vec::new(),
        deferred_local_type_validation_nodes: Vec::new(),
        local_type_declaration_depth: 0,
        local_type_alias_depth: 0,
        active_local_type_objects: Vec::new(),
        deferred_local_alias_cycles: Vec::new(),
        deferred_local_alias_body_objects: Vec::new(),
        deferred_local_alias_bodies: Vec::new(),
        pending_functions: Vec::new(),
        pending_function_indices: HashMap::new(),
        pending_methods: Vec::new(),
        receiver_validation_nodes: Vec::new(),
        active_function_objects: Vec::new(),
        reported_recursive_calls: collections::BitSet::new(),
        type_cycle_depth: 0,
        type_fact_recovery_depth: 0,
        array_length_depth: 0,
        array_length_type_cycle_depth: 0,
        named_type_depth: 0,
        type_parameter_cycle_depth: 0,
        generic_type_origin_depth: 0,
        generic_type_short_diagnostic: false,
        generic_function_context_depth: Ref::new(0),
        generic_argument_inference_depth: 0,
        target_inference_context: Ref::new(0),
        target_inference_description: Ref::new(""),
        target_inference_call: Ref::new(""),
        constraint_type_depth: 0,
        imports: Vec::new(),
        dot_import_indices: HashMap::new(),
        labels: Vec::new(),
        label_starts: Vec::new(),
        active_labels: Vec::new(),
        active_label_starts: Vec::new(),
        loop_depth: 0,
        breakable_depth: 0,
        fallthrough_allowed: false,
        fallthrough_context: 0,
        locals: Vec::new(),
        function_ids: Vec::new(),
        active_instantiations: Vec::new(),
        next_function_id: 0,
        initialization_depth: 0,
        function_dependencies_enabled,
        checked_function_bodies: collections::BitSet::new(),
        defer_constraint_checks: false,
        deferred_instances: Vec::new(),
        checked_deferred_instances: 0,
        deferred_type_info_expressions: Vec::new(),
        deferred_constraint_type_uses: Vec::new(),
        deferred_function_bodies: Vec::new(),
        deferred_function_body_indices: HashMap::new(),
        deferred_function_body_queue: Vec::new(),
        deferred_function_type_diagnostics: Vec::new(),
        partial_instances: Vec::new(),
        void_nodes: Vec::new(),
        void_node_indices: collections::BitSet::new(),
        current_iota: -1,
        diagnostic_override: Option::None,
        diagnostics,
    };
    if state.syntax.files.is_empty() {
        state.diagnostics.push(
            CheckDiagnostic {
                file: "",
                start: -1,
                end: -1,
                message: "package has no parseable files",
                soft: false,
                secondary: false,
            },
        )
    } else {
        for index in 0..state.syntax.files.len() {
            initialize_file(state, index, package_name)
        }
        for index in 0..state.syntax.files.len() {
            process_file_imports(state, index)
        }
        for index in 0..state.syntax.files.len() {
            check_file_missing_method_receivers(state, index)
        }
        for index in 0..state.syntax.files.len() {
            predeclare_file(state, index)
        }
        check_package_import_conflicts(state);
        let method_diagnostic_start = state.diagnostics.len();
        state.defer_constraint_checks = true;
        for index in 0..state.syntax.files.len() {
            prepare_file_methods(state, index)
        }
        complete_method_declarations(state);
        let method_diagnostics = take_diagnostics_from(state, method_diagnostic_start);
        let early_type_dependency_diagnostics: Vec[CheckDiagnostic] = Vec::new();
        let remaining_method_diagnostics: Vec[CheckDiagnostic] = Vec::new();
        for value in method_diagnostics {
            if diagnostic_in_type_declaration(state, value) {
                early_type_dependency_diagnostics.push(value)
            } else {
                remaining_method_diagnostics.push(value)
            }
        }
        check_init_function_signatures(state);
        state.defer_constraint_checks = false;
        check_deferred_instances(state);
        let ignore_func_bodies = state.config.ignore_func_bodies;
        state.config.ignore_func_bodies = true;
        state.defer_constraint_checks = true;
        let type_diagnostic_start = state.diagnostics.len();
        for index in 0..state.syntax.files.len() {
            check_file_type_declarations(state, index, false)
        }
        let type_diagnostics = take_diagnostics_from(state, type_diagnostic_start);
        for value in early_type_dependency_diagnostics {
            type_diagnostics.push(value)
        }
        let early_cycle_diagnostic_start = state.diagnostics.len();
        report_deferred_declaration_cycles(state);
        let early_cycle_diagnostics = take_diagnostics_from(state, early_cycle_diagnostic_start);
        for value in early_cycle_diagnostics {
            type_diagnostics.push(value)
        }
        sort_diagnostics_by_position(state, type_diagnostics);
        let deferred_type_constraint_diagnostics: Vec[CheckDiagnostic] = Vec::new();
        for value in type_diagnostics {
            if value.soft && value.message.contains("outside a type constraint") {
                deferred_type_constraint_diagnostics.push(value)
            } else {
                state.diagnostics.push(value)
            }
        }
        let alias_diagnostic_start = state.diagnostics.len();
        for index in 0..state.syntax.files.len() {
            check_file_type_declarations(state, index, true)
        }
        let alias_diagnostics = take_diagnostics_from(state, alias_diagnostic_start);
        let remaining_alias_diagnostics: Vec[CheckDiagnostic] = Vec::new();
        for value in alias_diagnostics {
            if direct_alias_cycle_diagnostic(state, value) {
                state.diagnostics.push(value)
            } else if value.message.starts_with("predeclared ")
                && value.message.contains(" requires go1.18 or later") {
                state.diagnostics.push(value)
            } else {
                remaining_alias_diagnostics.push(value)
            }
        }
        let declaration_diagnostic_start = state.diagnostics.len();
        for index in 0..state.syntax.files.len() {
            check_file_declarations(state, index)
        }
        let declaration_diagnostics = take_diagnostics_from(state, declaration_diagnostic_start);
        for value in remaining_alias_diagnostics {
            declaration_diagnostics.push(value)
        }
        report_deferred_declaration_cycles(state);
        let value_cycle_diagnostic_start = state.diagnostics.len();
        report_value_cycles(state, true);
        let value_cycle_diagnostics = take_diagnostics_from(state, value_cycle_diagnostic_start);
        for value in value_cycle_diagnostics {
            declaration_diagnostics.push(value)
        }
        for value in remaining_method_diagnostics {
            declaration_diagnostics.push(value)
        }
        for value in state.deferred_receiver_cycle_diagnostics {
            declaration_diagnostics.push(value)
        }
        sort_diagnostics_by_position(state, declaration_diagnostics);
        let deferred_constraint_use_diagnostics: Vec[CheckDiagnostic] = Vec::new();
        for value in deferred_type_constraint_diagnostics {
            deferred_constraint_use_diagnostics.push(value)
        }
        for value in declaration_diagnostics {
            if value.soft && value.message.contains("outside a type constraint") {
                deferred_constraint_use_diagnostics.push(value)
            } else {
                state.diagnostics.push(value)
            }
        }
        check_deferred_instance_counts(state);
        let late_soft_diagnostic_start = state.diagnostics.len();
        check_deferred_type_validations(state);
        check_field_method_collisions(state);
        let receiver_validation_diagnostic_start = state.diagnostics.len();
        check_receiver_validations(state);
        let receiver_validation_diagnostics = take_diagnostics_from(
            state,
            receiver_validation_diagnostic_start,
        );
        for value in state.deferred_union_diagnostics {
            state.diagnostics.push(value)
        }
        let late_diagnostics = take_diagnostics_from(state, late_soft_diagnostic_start);
        let late_soft_diagnostics: Vec[CheckDiagnostic] = Vec::new();
        let final_overlap_diagnostics: Vec[CheckDiagnostic] = Vec::new();
        reorder_duplicate_method_diagnostics(state, late_diagnostics);
        for value in late_diagnostics {
            if deferred_interface_overlap_diagnostic(state, value) {
                final_overlap_diagnostics.push(value)
            } else if value.soft && value.message.contains("outside a type constraint") {
                late_soft_diagnostics.push(value)
            } else {
                state.diagnostics.push(value)
            }
        }
        let deferred_instance_diagnostic_start = state.diagnostics.len();
        state.defer_constraint_checks = false;
        check_deferred_instances(state);
        check_deferred_type_info_expressions(state);
        let deferred_instance_diagnostics = take_diagnostics_from(
            state,
            deferred_instance_diagnostic_start,
        );
        for value in late_soft_diagnostics {
            deferred_instance_diagnostics.push(value)
        }
        for value in deferred_constraint_use_diagnostics {
            deferred_instance_diagnostics.push(value)
        }
        let deferred_constraint_type_use_start = state.diagnostics.len();
        report_deferred_constraint_type_uses(state);
        let deferred_constraint_type_use_diagnostics = take_diagnostics_from(
            state,
            deferred_constraint_type_use_start,
        );
        for value in deferred_constraint_type_use_diagnostics {
            deferred_instance_diagnostics.push(value)
        }
        for value in receiver_validation_diagnostics {
            deferred_instance_diagnostics.push(value)
        }
        sort_diagnostics_by_position(state, deferred_instance_diagnostics);
        state.config.ignore_func_bodies = ignore_func_bodies;
        let body_diagnostic_start = state.diagnostics.len();
        if !ignore_func_bodies {
            for index in 0..state.syntax.files.len() {
                check_file_function_bodies(state, index)
            }
            check_deferred_function_bodies(state)
        }
        let body_diagnostics = take_diagnostics_from(state, body_diagnostic_start);
        let mut deferred_index = 0;
        for value in body_diagnostics {
            while deferred_index < deferred_instance_diagnostics.len()
                && deferred_instance_diagnostics[deferred_index].start <= value.start {
                state.diagnostics.push(deferred_instance_diagnostics[deferred_index]);
                deferred_index += 1;
            }
            state.diagnostics.push(value)
        }
        while deferred_index < deferred_instance_diagnostics.len() {
            state.diagnostics.push(deferred_instance_diagnostics[deferred_index]);
            deferred_index += 1;
        }
        sort_type_argument_count_runs(state.diagnostics);
        reorder_type_argument_cycle_diagnostics(state, state.diagnostics);
        report_value_cycles(state, false);
        check_unused_imports(state);
        for value in final_overlap_diagnostics {
            state.diagnostics.push(value)
        }
    }
    sort_initializers(state);
    refresh_deferred_function_body_facts(state);
    omit_expression_array_cycle_composite_facts(state);
    refresh_cycle_identifier_facts(state);
    omit_invalid_operand_facts(state);
    state.world.packages[state.package_id.value].complete = true;
    CheckResult {
        world: state.world,
        syntax: state.syntax,
        package_id: state.package_id,
        info: state.info,
        diagnostics: state.diagnostics,
    }
}

pub fn check_package(config: CheckConfig, input: PackageInput) -> CheckResult {
    check_package_in_world(config, input, go_types::new_world())
}
