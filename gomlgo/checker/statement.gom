package checker;

use gomlgo::constant;
use gomlgo::syntax;
use gomlgo::types as go_types;

fn node_end(state: CheckState, node: syntax::NodeId) -> isize {
    syntax::node_at(state.syntax.arena, node.value).span.end
}

fn new_node_scope(
    state: CheckState,
    parent: go_types::ScopeId,
    node: syntax::NodeId,
    kind: go_types::ScopeKind,
) -> go_types::ScopeId {
    let result = go_types::add_scope(
        state.world,
        kind,
        Option::Some(parent),
        node_file(state, node),
        node_start(state, node),
        node_end(state, node),
    );
    record_scope_fact(state, node, result);
    result
}

fn default_operand_type(state: CheckState, operand: Operand) -> go_types::TypeId {
    default_type_for_kind(state, basic_kind(state, operand.type_id)).unwrap_or(operand.type_id)
}

fn default_type_for_kind(state: CheckState, kind: go_types::BasicKind) -> Option[go_types::TypeId] {
    if kind == go_types::BasicKind::UntypedRune {
        go_types::lookup(state.world, state.world.universe, "rune").and_then(
            |object| go_types::get_object(state.world, object).map(|object| object.type_id),
        )
    } else {
        constant::default_type(kind).map(|kind| find_basic_kind(state, kind))
    }
}

fn track_local_variable(
    state: CheckState,
    object: go_types::ObjectId,
    node: syntax::NodeId,
    scope: go_types::ScopeId,
) -> () {
    if state.function_ids.is_empty() {
        return
    }
    state.locals.push(
        LocalBinding {
            object,
            node,
            scope,
            function_id: state.function_ids[state.function_ids.len() - 1],
        },
    )
}

fn declare_local(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    kind: go_types::ObjectKind,
    type_id: go_types::TypeId,
    value: Option[constant::ConstValue],
) -> Option[go_types::ObjectId] {
    let name = identifier(state, node).unwrap_or("");
    if name == "" {
        diagnostic(state, node, "declaration name is not an identifier", false);
        return Option::None
    }
    let object = go_types::add_object(
        state.world,
        kind,
        name,
        Option::Some(state.package_id),
        node_file(state, node),
        Option::Some(node),
        node_start(state, node),
        type_id,
    );
    if name == "_" {
        state.info.defs.push(ObjectFact { node, object: Option::Some(object) });
        match value {
            Some(value) => {
                save_constant(state, object, value);
                let _ = go_types::set_object_constant(
                    state.world,
                    object,
                    constant::constant_kind_name(value),
                    constant::constant_exact_string(value),
                );
            },
            None => {},
        }
        return Option::Some(object)
    }
    match go_types::insert(state.world, scope, name, object) {
        Some(existing) => {
            diagnostic(state, node, name + " redeclared in this block", false);
            match go_types::get_object(state.world, existing) {
                Some(existing) => match existing.node {
                    Some(declaration) => secondary_diagnostic(
                        state,
                        declaration,
                        "\tother declaration of " + name,
                    ),
                    None => {},
                },
                None => {},
            }
            state.info.defs.push(ObjectFact { node, object: Option::Some(object) });
            Option::None
        },
        None => {
            state.info.defs.push(ObjectFact { node, object: Option::Some(object) });
            if kind == go_types::ObjectKind::Var {
                track_local_variable(state, object, node, scope)
            }
            match value {
                Some(value) => {
                    save_constant(state, object, value);
                    let _ = go_types::set_object_constant(
                        state.world,
                        object,
                        constant::constant_kind_name(value),
                        constant::constant_exact_string(value),
                    );
                },
                None => {},
            }
            Option::Some(object)
        },
    }
}

fn check_local_value_spec(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    constant_declaration: bool,
    inherited_type: Option[syntax::NodeId],
    inherited_values: Vec[syntax::NodeId],
    inherited_spec: Option[syntax::NodeId],
) -> () {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::ValueSpec { names, type_node, values }) => {
            let inherits = constant_declaration && values.is_empty() && type_node.is_none();
            let effective_values = if inherits {
                inherited_values
            } else {
                values
            };
            let effective_type = if inherits {
                inherited_type
            } else {
                type_node
            };
            let previous_diagnostic_override = state.diagnostic_override;
            let arity_reported = if constant_declaration || !effective_values.is_empty() {
                report_value_arity(
                    state,
                    node,
                    names,
                    effective_values,
                    if inherits {
                        inherited_spec
                    } else {
                        Option::None
                    },
                )
            } else {
                false
            };
            if inherits {
                state.diagnostic_override = if names.is_empty() {
                    Option::Some(node)
                } else {
                    Option::Some(names[0])
                };
            }
            let explicit_type = effective_type.map(
                |type_node| declaration_type(state, scope, type_node, constant_declaration),
            );
            if constant_declaration
                && match explicit_type {
                    Some(type_id) => type_id.value == state.world.invalid.value,
                    None => false,
                } {
                for name in names {
                    let _ = declare_local(
                        state,
                        scope,
                        name,
                        go_types::ObjectKind::Const,
                        state.world.invalid,
                        Option::Some(constant::ConstValue::Unknown),
                    );
                }
                state.diagnostic_override = previous_diagnostic_override;
                return
            }
            let operand_values = if effective_values.len() > names.len()
                && effective_values.len() != 1 {
                let result: Vec[syntax::NodeId] = Vec::new();
                for index in 0..names.len() {
                    result.push(effective_values[index])
                }
                result
            } else {
                effective_values
            };
            let operands = if operand_values.is_empty() {
                Vec::new()
            } else {
                assignment_operands(
                    state,
                    scope,
                    operand_values,
                    names.len(),
                    !constant_declaration,
                    match explicit_type {
                        Some(type_id) => {
                            let result: Vec[go_types::TypeId] = Vec::new();
                            for _ in names {
                                result.push(type_id)
                            }
                            result
                        },
                        None => Vec::new(),
                    },
                    {
                        let result: Vec[string] = Vec::new();
                        for name in names {
                            result.push(expression_source_text(state, name))
                        }
                        result
                    },
                )
            };
            if !arity_reported && !effective_values.is_empty() && operands.len() != names.len() {
                diagnostic(state, node, "assignment count mismatch", false)
            } else if !arity_reported && effective_values.is_empty()
                && (constant_declaration || explicit_type.is_none()) {
                diagnostic(state, node, "missing initializer", false)
            }
            for index in 0..names.len() {
                let checked = if index < operands.len() {
                    declaration_operand(
                        state,
                        if effective_values.len() == 1 {
                            effective_values[0]
                        } else {
                            effective_values[index]
                        },
                        operands[index],
                        explicit_type,
                        constant_declaration,
                        effective_values.len() == 1 && names.len() > 1,
                    )
                } else {
                    (
                        explicit_type.unwrap_or(state.world.invalid),
                        if constant_declaration {
                            Option::Some(constant::ConstValue::Unknown)
                        } else {
                            Option::None
                        },
                    )
                };
                let _ = declare_local(
                    state,
                    scope,
                    names[index],
                    if constant_declaration {
                        go_types::ObjectKind::Const
                    } else {
                        go_types::ObjectKind::Var
                    },
                    checked.0,
                    if constant_declaration {
                        checked.1
                    } else {
                        Option::None
                    },
                );
            }
            state.diagnostic_override = previous_diagnostic_override;
        },
        _ => diagnostic(state, node, "invalid local value declaration", false),
    }
}

fn local_type_cycle(
    state: CheckState,
    value: go_types::TypeId,
    target: go_types::TypeId,
    through_indirection: bool,
    visited: Vec[go_types::TypeId],
) -> bool {
    if value.value == target.value {
        return true
    }
    for existing in visited {
        if existing.value == value.value {
            return false
        }
    }
    visited.push(value);
    match go_types::get_type(state.world, go_types::unalias(state.world, value)) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Array { length: _, element } }) => local_type_cycle(
            state,
            element,
            target,
            through_indirection,
            visited,
        ),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Struct { fields } }) => {
            for field in fields {
                if local_type_cycle(
                    state,
                    field.variable.type_id,
                    target,
                    through_indirection,
                    visited,
                ) {
                    return true
                }
            }
            false
        },
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Alias { object: _, rhs, type_params: _, type_args: _ },
        }) => local_type_cycle(state, rhs, target, through_indirection, visited),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) | Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Slice { element },
        }) | Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Chan { direction: _, element },
        }) => if through_indirection {
            local_type_cycle(state, element, target, true, visited)
        } else {
            false
        },
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Map { key, value } }) => if through_indirection {
            local_type_cycle(state, key, target, true, visited)
                || local_type_cycle(state, value, target, true, visited)
        } else {
            false
        },
        _ => false,
    }
}

fn check_local_type_spec(state: CheckState, scope: go_types::ScopeId, node: syntax::NodeId) -> () {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::TypeSpec { name, type_params, assign, type_node }) => {
            let type_scope = match type_params {
                Some(_) => {
                    let value = go_types::add_scope(
                        state.world,
                        go_types::ScopeKind::Block,
                        Option::Some(scope),
                        node_file(state, node),
                        node_start(state, node),
                        node_end(state, node),
                    );
                    record_scope_fact(state, node, value);
                    value
                },
                None => scope,
            };
            let type_parameter_bindings = declare_type_parameters(state, type_scope, type_params);
            let provisional_type_params = provisional_type_parameters(
                type_parameter_bindings,
                state.world.invalid,
            );
            let type_name = identifier(state, name).unwrap_or("");
            let object = go_types::add_object(
                state.world,
                go_types::ObjectKind::TypeName,
                type_name,
                Option::Some(state.package_id),
                node_file(state, name),
                Option::Some(name),
                node_start(state, name),
                state.world.invalid,
            );
            let placeholder = go_types::add_type(
                state.world,
                if assign > 0 {
                    go_types::TypeKind::Alias {
                        object,
                        rhs: state.world.invalid,
                        type_params: provisional_type_params,
                        type_args: Vec::new(),
                    }
                } else {
                    go_types::TypeKind::Named {
                        object,
                        underlying: state.world.invalid,
                        type_params: provisional_type_params,
                        type_args: Vec::new(),
                        methods: Vec::new(),
                    }
                },
            );
            let _ = go_types::set_object_type(state.world, object, placeholder);
            let declared_type_params = complete_type_parameters(
                state,
                type_scope,
                type_parameter_bindings,
            );
            let _ = go_types::set_type(
                state.world,
                placeholder,
                if assign > 0 {
                    go_types::TypeKind::Alias {
                        object,
                        rhs: state.world.invalid,
                        type_params: declared_type_params,
                        type_args: Vec::new(),
                    }
                } else {
                    go_types::TypeKind::Named {
                        object,
                        underlying: state.world.invalid,
                        type_params: declared_type_params,
                        type_args: Vec::new(),
                        methods: Vec::new(),
                    }
                },
            );
            if type_name == "_" {
                state.info.defs.push(ObjectFact { node: name, object: Option::Some(object) });
                let constraint_definition = constraint_definition_node(state, type_node);
                if constraint_definition {
                    state.constraint_type_depth += 1;
                }
                let rhs = resolve_type(state, type_scope, type_node);
                if constraint_definition {
                    state.constraint_type_depth -= 1;
                }
                if assign <= 0 {
                    set_interface_method_receivers(state, rhs, placeholder)
                }
                let _ = go_types::set_type(
                    state.world,
                    placeholder,
                    if assign > 0 {
                        go_types::TypeKind::Alias {
                            object,
                            rhs,
                            type_params: declared_type_params,
                            type_args: Vec::new(),
                        }
                    } else {
                        go_types::TypeKind::Named {
                            object,
                            underlying: rhs,
                            type_params: declared_type_params,
                            type_args: Vec::new(),
                            methods: Vec::new(),
                        }
                    },
                );
                return
            }
            match go_types::insert(state.world, scope, type_name, object) {
                Some(_) => {
                    diagnostic(state, name, type_name + " redeclared in this block", false);
                    state.info.defs.push(ObjectFact { node: name, object: Option::None })
                },
                None => {
                    state.info.defs.push(ObjectFact { node: name, object: Option::Some(object) });
                    let constraint_definition = constraint_definition_node(state, type_node);
                    if constraint_definition {
                        state.constraint_type_depth += 1;
                    }
                    state.local_type_declaration_depth += 1;
                    if assign > 0 {
                        state.local_type_alias_depth += 1;
                    }
                    state.active_local_type_objects.push(object);
                    let rhs = resolve_type(state, type_scope, type_node);
                    let _ = state.active_local_type_objects.pop();
                    if rhs.value == state.world.invalid.value
                        && recorded_type_fact(state, type_node).is_none() {
                        record_invalid_type_expression(state, type_node)
                    }
                    if assign > 0 {
                        state.local_type_alias_depth -= 1;
                    }
                    state.local_type_declaration_depth -= 1;
                    if constraint_definition {
                        state.constraint_type_depth -= 1;
                    }
                    if assign > 0
                        && (type_contains_alias_cycle(state, rhs, object, Vec::new())
                            || local_alias_cycle_seen(state, object)) {
                        report_named_type_cycle(state, Vec::from_array([object]), false);
                        let _ = go_types::set_type(
                            state.world,
                            placeholder,
                            go_types::TypeKind::Invalid,
                        );
                    } else if assign > 0
                        && alias_rhs_is_own_type_parameter(state, rhs, declared_type_params) {
                        diagnostic(
                            state,
                            type_node,
                            "cannot use type parameter declared in alias declaration as RHS",
                            false,
                        )
                    } else {
                        if assign <= 0
                            && alias_rhs_is_own_type_parameter(state, rhs, declared_type_params) {
                            diagnostic(
                                state,
                                type_node,
                                "cannot use a type parameter as RHS in type declaration",
                                false,
                            )
                        }
                        if assign <= 0 {
                            set_interface_method_receivers(state, rhs, placeholder)
                        }
                        let _ = go_types::set_type(
                            state.world,
                            placeholder,
                            if assign > 0 {
                                go_types::TypeKind::Alias {
                                    object,
                                    rhs,
                                    type_params: declared_type_params,
                                    type_args: Vec::new(),
                                }
                            } else {
                                go_types::TypeKind::Named {
                                    object,
                                    underlying: rhs,
                                    type_params: declared_type_params,
                                    type_args: Vec::new(),
                                    methods: Vec::new(),
                                }
                            },
                        );
                        if assign <= 0 {
                            state.deferred_local_type_validations.push(placeholder);
                            state.deferred_local_type_validation_nodes.push(type_node)
                        }
                    }
                },
            }
        },
        _ => diagnostic(state, node, "invalid local type declaration", false),
    }
}

fn check_local_declaration(state: CheckState, scope: go_types::ScopeId, node: syntax::NodeId) -> () {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::GenDecl { token_pos: _, token, lparen: _, specs, rparen: _ }) => if value_declaration_keyword(
            token,
        ) {
            let previous_iota = state.current_iota;
            let mut inherited_type: Option[syntax::NodeId] = Option::None;
            let mut inherited_values: Vec[syntax::NodeId] = Vec::new();
            let mut inherited_spec: Option[syntax::NodeId] = Option::None;
            for index in 0..specs.len() {
                state.current_iota = if token == CONST_KEYWORD {
                    index
                } else {
                    previous_iota
                };
                match syntax::get_kind(state.syntax.arena, specs[index]) {
                    Some(syntax::SyntaxKind::ValueSpec { names: _, type_node, values }) => if !values.is_empty() {
                        inherited_type = type_node;
                        inherited_values = values;
                        inherited_spec = Option::Some(specs[index]);
                    },
                    _ => {},
                }
                check_local_value_spec(
                    state,
                    scope,
                    specs[index],
                    token == CONST_KEYWORD,
                    inherited_type,
                    inherited_values,
                    inherited_spec,
                )
            }
            state.current_iota = previous_iota;
        } else if token == TYPE_KEYWORD {
            let validation_start = state.deferred_local_type_validations.len();
            for spec in specs {
                check_local_type_spec(state, scope, spec)
            }
            for index in validation_start..state.deferred_local_type_validations.len() {
                check_map_keys_in_type_node(
                    state,
                    state.deferred_local_type_validation_nodes[index],
                );
                let _ = validate_named_type_inner(
                    state,
                    state.deferred_local_type_validations[index],
                    Vec::new(),
                    Vec::new(),
                );
            }
        } else {
            diagnostic(
                state,
                node,
                "local " + token + " declarations are not implemented yet",
                false,
            )
        },
        _ => diagnostic(state, node, "invalid local declaration", false),
    }
}

fn update_comma_ok_operand_fact(state: CheckState, node: syntax::NodeId, tuple: go_types::TypeId) -> () {
    update_operand_fact(state, node, tuple, Option::None);
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => update_comma_ok_operand_fact(
            state,
            expression,
            tuple,
        ),
        _ => {},
    }
}

fn assignment_operands(
    state: CheckState,
    scope: go_types::ScopeId,
    nodes: Vec[syntax::NodeId],
    expected: isize,
    allow_comma_ok: bool,
    targets: Vec[go_types::TypeId],
    target_descriptions: Vec[string],
) -> Vec[Operand] {
    let result: Vec[Operand] = Vec::new();
    for node_index in 0..nodes.len() {
        let node = nodes[node_index];
        let previous_target_inference_description = state.target_inference_description.get();
        if node_index < target_descriptions.len() {
            state.target_inference_description.set(target_descriptions[node_index]);
        }
        let mut operand = if node_index < targets.len() {
            expression_with_target(state, scope, node, targets[node_index])
        } else {
            check_expression(state, scope, node)
        };
        state.target_inference_description.set(previous_target_inference_description);
        if node_is_void(state, node) {
            diagnostic(
                state,
                node,
                expression_source_text(state, node) + " (no value) used as value",
                false,
            )
        }
        if node_index < targets.len() {
            let diagnostic_count = state.diagnostics.len();
            update_contextual_operand_fact(state, node, operand, targets[node_index]);
            if state.diagnostics.len() > diagnostic_count {
                operand = invalid_operand(state);
            }
        }
        if nodes.len() == 1 {
            let variables = tuple_variables(state, operand.type_id);
            if variables.len() > 1 {
                for variable in variables {
                    result.push(
                        Operand {
                            type_id: variable.type_id,
                            value: Option::None,
                            addressable: false,
                            assignable: false,
                        },
                    )
                }
            } else if expected == 2 && allow_comma_ok && expression_has_comma_ok(state, node) {
                let untyped_bool = basic_type_id(state, "untyped bool");
                let bool_operand = Operand {
                    type_id: untyped_bool,
                    value: Option::None,
                    addressable: false,
                    assignable: false,
                };
                let bool_type = if targets.len() > 1
                    && targets[1].value != state.world.invalid.value
                    && argument_assignable(state, bool_operand, targets[1]) {
                    targets[1]
                } else {
                    basic_type_id(state, "bool")
                };
                let mut valid_comma_context = true;
                if targets.is_empty() && target_descriptions.len() == expected {
                    for description in target_descriptions {
                        match go_types::lookup(state.world, scope, description) {
                            Some(object) => match go_types::get_object(state.world, object) {
                                Some(object) => if object.type_id.value == state.world.invalid.value {
                                    valid_comma_context = false;
                                },
                                None => {},
                            },
                            None => {},
                        }
                    }
                } else {
                    for index in 0..targets.len() {
                        if targets[index].value == state.world.invalid.value
                            && (index >= target_descriptions.len()
                                || target_descriptions[index] != "_") {
                            valid_comma_context = false;
                        }
                    }
                }
                if valid_comma_context {
                    let tuple = go_types::add_type(
                        state.world,
                        go_types::TypeKind::Tuple {
                            variables: Vec::from_array(
                                [
                                    go_types::Variable {
                                        name: "",
                                        owner: Option::Some(state.package_id),
                                        type_id: operand.type_id,
                                    },
                                    go_types::Variable {
                                        name: "",
                                        owner: Option::Some(state.package_id),
                                        type_id: bool_type,
                                    },
                                ],
                            ),
                        },
                    );
                    update_comma_ok_operand_fact(state, node, tuple)
                }
                result.push(operand);
                result.push(
                    Operand {
                        type_id: bool_type,
                        value: Option::None,
                        addressable: false,
                        assignable: false,
                    },
                )
            } else {
                result.push(operand)
            }
        } else {
            result.push(operand)
        }
    }
    result
}

fn assignment_blank_identifier(state: CheckState, node: syntax::NodeId) -> bool {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::Ident { name_pos: _, name }) => name == "_",
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => assignment_blank_identifier(
            state,
            expression,
        ),
        _ => false,
    }
}

fn assignment_identifier_node(state: CheckState, node: syntax::NodeId) -> syntax::NodeId {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => assignment_identifier_node(
            state,
            expression,
        ),
        _ => node,
    }
}

fn assignment_identifier_name(state: CheckState, node: syntax::NodeId) -> Option[string] {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::Ident { name_pos: _, name }) => Option::Some(name),
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => assignment_identifier_name(
            state,
            expression,
        ),
        _ => Option::None,
    }
}

fn expression_is_map_index(state: CheckState, node: syntax::NodeId) -> bool {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::IndexExpr { expression, lbrack: _, index: _, rbrack: _ }) => match recorded_type_fact(
            state,
            expression,
        ) {
            Some(fact) => match go_types::get_type(state.world, core_type_id(state, fact.type_id)) {
                Some(go_types::TypeData {
                    id: _,
                    kind: go_types::TypeKind::Map { key: _, value: _ },
                }) => true,
                _ => false,
            },
            None => false,
        },
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => expression_is_map_index(
            state,
            expression,
        ),
        _ => false,
    }
}

fn assignment_is_map_struct_field(state: CheckState, node: syntax::NodeId) -> bool {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::SelectorExpr { expression, selector: _ }) => expression_is_map_index(
            state,
            expression,
        )
            || assignment_is_map_struct_field(state, expression),
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => assignment_is_map_struct_field(
            state,
            expression,
        ),
        _ => false,
    }
}

fn assign_checked(
    state: CheckState,
    node: syntax::NodeId,
    source_node: syntax::NodeId,
    source: Operand,
    target: Operand,
) -> () {
    if assignment_blank_identifier(state, node) {
        state.info.defs.push(
            ObjectFact { node: assignment_identifier_node(state, node), object: Option::None },
        );
        return
    }
    if node_is_void(state, node) {
        diagnostic(
            state,
            node,
            expression_source_text(state, node) + " (no value) used as value",
            false,
        )
    } else if target.type_id.value == state.world.invalid.value
        || source.type_id.value == state.world.invalid.value {} else if !target.assignable {
        diagnostic(
            state,
            node,
            if assignment_is_map_struct_field(state, node) {
                "cannot assign to struct field " + expression_source_text(state, node) + " in map"
            } else {
                "cannot assign to " + expression_source_text(state, node)
                    + " (neither addressable nor a map index expression)"
            },
            false,
        )
    } else if !argument_assignable(state, source, target.type_id) {
        let type_parameter_detail = type_parameter_assignment_failure(
            state,
            source.type_id,
            target.type_id,
        );
        let implementation_detail = interface_implementation_detail(
            state,
            source.type_id,
            target.type_id,
        );
        let needs_type_assertion = go_types::is_interface(state.world, source.type_id)
            && !go_types::is_interface(state.world, target.type_id);
        diagnostic(
            state,
            source_node,
            "cannot use " + operand_string(state, source_node, source) + " as "
                + diagnostic_type_string(state, target.type_id)
                + " value in assignment"
                + if needs_type_assertion {
                    ": need type assertion"
                } else if type_parameter_detail != "" {
                    ": " + type_parameter_detail
                } else if implementation_detail == "" {
                    ""
                } else {
                    ": " + implementation_type_string(state, source.type_id)
                        + " does not implement "
                        + implementation_type_string(state, target.type_id)
                        + " "
                        + implementation_detail
                },
            false,
        )
    }
}

fn assign_existing(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    source_node: syntax::NodeId,
    source: Operand,
) -> () {
    let assignment_object = assignment_identifier_name(state, node).and_then(
        |name| go_types::lookup(state.world, scope, name),
    );
    let assignment_object_used = match assignment_object {
        Some(object) => local_object_used(state, object),
        None => false,
    };
    let target = if assignment_blank_identifier(state, node) {
        invalid_operand(state)
    } else {
        check_expression(state, scope, node)
    };
    match assignment_object {
        Some(object) => if !assignment_object_used {
            let _ = state.used_objects.remove(object.value);
        },
        None => {},
    }
    assign_checked(state, node, source_node, source, target)
}

fn assignment_count_text(count: isize, singular: string, plural: string) -> string {
    let value = if count == 1 {
        singular
    } else {
        plural
    };
    f"{count} {value}"
}

fn report_assignment_count(
    state: CheckState,
    node: syntax::NodeId,
    left_count: isize,
    right_nodes: Vec[syntax::NodeId],
    right_count: isize,
) -> () {
    let position = if right_nodes.is_empty() {
        node
    } else {
        right_nodes[0]
    };
    let values = assignment_count_text(right_count, "value", "values");
    let description = if right_nodes.len() == 1 {
        match syntax::get_kind(state.syntax.arena, right_nodes[0]) {
            Some(syntax::SyntaxKind::CallExpr {
                function,
                lparen: _,
                arguments: _,
                ellipsis: _,
                rparen: _,
            }) => expression_source_text(state, function) + " returns " + values,
            _ => values,
        }
    } else {
        values
    };
    diagnostic(
        state,
        position,
        "assignment mismatch: " + assignment_count_text(left_count, "variable", "variables")
            + " but "
            + description,
        false,
    )
}

fn check_short_declaration(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    left: Vec[syntax::NodeId],
    right: Vec[Operand],
) -> () {
    if left.len() != right.len() {
        let invalid_values: Vec[Operand] = Vec::new();
        for _ in left {
            invalid_values.push(invalid_operand(state))
        }
        check_short_declaration(state, scope, node, left, invalid_values);
        return
    }
    while right.len() < left.len() {
        right.push(invalid_operand(state))
    }
    let mut new_variables = 0;
    let mut invalid_left = false;
    let seen_names: Vec[string] = Vec::new();
    for index in 0..left.len() {
        let name = identifier(state, left[index]).unwrap_or("");
        if name == "" {
            invalid_left = true;
            let _ = check_expression(state, scope, left[index]);
            diagnostic(
                state,
                left[index],
                "non-name " + expression_source_text(state, left[index]) + " on left side of :=",
                false,
            )
        } else if name == "_" {
            let _ = declare_local(
                state,
                scope,
                left[index],
                go_types::ObjectKind::Var,
                default_operand_type(state, right[index]),
                Option::None,
            );
        } else {
            let mut repeated = false;
            for seen in seen_names {
                if seen == name {
                    repeated = true;
                }
            }
            if repeated {
                invalid_left = true;
                diagnostic(state, left[index], name + " repeated on left side of :=", false);
                continue
            } else {
                seen_names.push(name)
            }
            match go_types::lookup_local(state.world, scope, name) {
                Some(object) => {
                    record_use(state, left[index], object);
                    match go_types::get_object(state.world, object) {
                        Some(object) => if object.kind != go_types::ObjectKind::Var {
                            diagnostic(state, left[index], "cannot assign to " + name, false)
                        } else if !argument_assignable(state, right[index], object.type_id) {
                            diagnostic(
                                state,
                                left[index],
                                "cannot assign value in short variable declaration",
                                false,
                            )
                        },
                        None => {},
                    }
                },
                None => {
                    new_variables += 1;
                    let _ = declare_local(
                        state,
                        scope,
                        left[index],
                        go_types::ObjectKind::Var,
                        default_operand_type(state, right[index]),
                        Option::None,
                    );
                },
            }
        }
    }
    if new_variables == 0 && !invalid_left {
        let position = match syntax::get_kind(state.syntax.arena, node) {
            Some(syntax::SyntaxKind::AssignStmt { left: _, token_pos, token: _, right: _ } | syntax::SyntaxKind::RangeStmt {
                for_pos: _,
                key: _,
                value: _,
                token_pos,
                token: _,
                range_pos: _,
                expression: _,
                body: _,
            }) => token_pos,
            _ => node_start(state, node),
        };
        diagnostic_at_position(state, node, position, "no new variables on left side of :=", true)
    }
}

fn check_assignment(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    left: Vec[syntax::NodeId],
    token: string,
    right_nodes: Vec[syntax::NodeId],
) -> () {
    if !assignment_operator(token) {
        if left.len() != 1 || right_nodes.len() != 1 {
            diagnostic(state, node, "assignment count mismatch", false);
            return
        }
        let target = check_expression(state, scope, left[0]);
        let result = check_binary(
            state,
            scope,
            node,
            left[0],
            token.byte_slice(0, token.byte_len() - 1),
            right_nodes[0],
        );
        if !target.assignable {
            diagnostic(
                state,
                left[0],
                if assignment_is_map_struct_field(state, left[0]) {
                    "cannot assign to struct field " + expression_source_text(state, left[0])
                        + " in map"
                } else {
                    "cannot assign to " + expression_source_text(state, left[0])
                        + " (neither addressable nor a map index expression)"
                },
                false,
            )
        } else if result.type_id.value != state.world.invalid.value
            && !argument_assignable(state, result, target.type_id) {
            diagnostic(state, left[0], "invalid compound assignment", false)
        }
        return
    }
    let targets: Vec[go_types::TypeId] = Vec::new();
    let target_operands: Vec[Operand] = Vec::new();
    if token != DEFINE_OPERATOR {
        for target_node in left {
            if assignment_blank_identifier(state, target_node) {
                targets.push(state.world.invalid);
                target_operands.push(invalid_operand(state))
            } else {
                let assignment_object = assignment_identifier_name(state, target_node).and_then(
                    |name| go_types::lookup(state.world, scope, name),
                );
                let assignment_object_used = match assignment_object {
                    Some(object) => local_object_used(state, object),
                    None => false,
                };
                let target = check_expression(state, scope, target_node);
                match assignment_object {
                    Some(object) => if !assignment_object_used {
                        let _ = state.used_objects.remove(object.value);
                    },
                    None => {},
                }
                targets.push(
                    if target.assignable {
                        target.type_id
                    } else {
                        state.world.invalid
                    },
                );
                target_operands.push(target)
            }
        }
    }
    let target_descriptions: Vec[string] = Vec::new();
    for target_node in left {
        target_descriptions.push(expression_source_text(state, target_node))
    }
    let right = assignment_operands(
        state,
        scope,
        right_nodes,
        left.len(),
        true,
        if right_nodes.len() == left.len() || right_nodes.len() == 1 {
            targets
        } else {
            Vec::new()
        },
        if right_nodes.len() == left.len() || right_nodes.len() == 1 {
            target_descriptions
        } else {
            Vec::new()
        },
    );
    if token == DEFINE_OPERATOR {
        if left.len() != right.len()
            && (right.is_empty() || right[0].type_id.value != state.world.invalid.value) {
            report_assignment_count(state, node, left.len(), right_nodes, right.len())
        }
        if left.len() == right.len() && right_nodes.len() == right.len() {
            for index in 0..right.len() {
                update_contextual_operand_fact(
                    state,
                    right_nodes[index],
                    right[index],
                    default_operand_type(state, right[index]),
                )
            }
        }
        check_short_declaration(state, scope, node, left, right);
        return
    } else if left.len() != right.len() {
        if right.is_empty() || right[0].type_id.value != state.world.invalid.value {
            report_assignment_count(state, node, left.len(), right_nodes, right.len())
        }
        return
    }
    for index in 0..left.len() {
        if assignment_blank_identifier(state, left[index]) && index < right_nodes.len() {
            if basic_kind(state, right[index].type_id) == go_types::BasicKind::UntypedNil {
                diagnostic(
                    state,
                    right_nodes[index],
                    "use of untyped nil in assignment to _ identifier",
                    false,
                )
            } else {
                update_contextual_operand_fact(
                    state,
                    right_nodes[index],
                    right[index],
                    default_operand_type(state, right[index]),
                )
            }
        }
        assign_checked(
            state,
            left[index],
            if right_nodes.len() == right.len() {
                right_nodes[index]
            } else {
                right_nodes[0]
            },
            right[index],
            target_operands[index],
        )
    }
}

fn signature_results(state: CheckState, signature: go_types::TypeId) -> Vec[go_types::Variable] {
    match go_types::type_data(state.world, go_types::unalias(state.world, signature)).kind {
        go_types::TypeKind::Signature {
            receiver: _,
            receiver_type_params: _,
            type_params: _,
            params: _,
            results,
            variadic: _,
        } => tuple_variables(state, results),
        _ => Vec::new(),
    }
}

fn report_return_count(
    state: CheckState,
    node: syntax::NodeId,
    result_nodes: Vec[syntax::NodeId],
    actual: Vec[Operand],
    expected: Vec[go_types::Variable],
) -> () {
    let too_few = actual.len() < expected.len();
    let position = if result_nodes.is_empty() {
        node
    } else if too_few || result_nodes.len() == 1 {
        result_nodes[result_nodes.len() - 1]
    } else if expected.len() < result_nodes.len() {
        result_nodes[expected.len()]
    } else {
        result_nodes[result_nodes.len() - 1]
    };
    diagnostic(
        state,
        position,
        if too_few {
            "not enough return values"
        } else {
            "too many return values"
        }
            + "\n\thave "
            + call_have_types(state, result_nodes, actual, -1)
            + "\n\twant "
            + call_want_types(state, expected, false),
        false,
    )
}

fn check_return(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    result_nodes: Vec[syntax::NodeId],
    signature: go_types::TypeId,
) -> () {
    let expected = signature_results(state, signature);
    if result_nodes.is_empty() {
        if !expected.is_empty() {
            let mut named = true;
            for variable in expected {
                if variable.name == "" {
                    named = false;
                }
            }
            if !named {
                report_return_count(state, node, result_nodes, Vec::new(), expected)
            } else {
                let mut function_scope = scope;
                while state.world.scopes[function_scope.value].kind != go_types::ScopeKind::Function {
                    match state.world.scopes[function_scope.value].parent {
                        Some(parent) => {
                            function_scope = parent;
                        },
                        None => break,
                    }
                }
                for variable in expected {
                    if variable.name != "" && variable.name != "_" {
                        match (
                            go_types::lookup_local(state.world, function_scope, variable.name),
                            go_types::lookup(state.world, scope, variable.name),
                        ) {
                            (Some(result_object), Some(visible)) => if result_object.value
                                != visible.value {
                                diagnostic(
                                    state,
                                    node,
                                    "result parameter " + variable.name + " not in scope at return",
                                    false,
                                );
                                match go_types::get_object(state.world, visible) {
                                    Some(object) => match object.node {
                                        Some(declaration) => secondary_diagnostic(
                                            state,
                                            declaration,
                                            "\tinner declaration of var " + variable.name + " "
                                                + diagnostic_type_string(
                                                    state,
                                                    if object.kind == go_types::ObjectKind::TypeName {
                                                        go_types::underlying(
                                                            state.world,
                                                            object.type_id,
                                                        )
                                                    } else {
                                                        object.type_id
                                                    },
                                                ),
                                        ),
                                        None => {},
                                    },
                                    None => {},
                                }
                            },
                            _ => {},
                        }
                    }
                }
            }
        }
        return
    }
    let targets: Vec[go_types::TypeId] = Vec::new();
    for variable in expected {
        targets.push(variable.type_id)
    }
    let target_descriptions: Vec[string] = Vec::new();
    for variable in expected {
        target_descriptions.push(
            if variable.name == "" {
                "result variable"
            } else {
                variable.name
            },
        )
    }
    let actual = assignment_operands(
        state,
        scope,
        result_nodes,
        expected.len(),
        false,
        if result_nodes.len() == expected.len() {
            targets
        } else {
            Vec::new()
        },
        if result_nodes.len() == expected.len() {
            target_descriptions
        } else {
            Vec::new()
        },
    );
    if actual.len() != expected.len() {
        report_return_count(state, node, result_nodes, actual, expected);
        return
    }
    for index in 0..actual.len() {
        if actual[index].type_id.value != state.world.invalid.value
            && expected[index].type_id.value != state.world.invalid.value
            && !argument_assignable(state, actual[index], expected[index].type_id) {
            let implementation_detail = interface_implementation_detail(
                state,
                actual[index].type_id,
                expected[index].type_id,
            );
            diagnostic(
                state,
                result_nodes[index],
                "cannot use " + operand_string(state, result_nodes[index], actual[index]) + " as "
                    + diagnostic_type_string(state, expected[index].type_id)
                    + " value in return statement"
                    + if implementation_detail == "" {
                        ""
                    } else {
                        ": " + implementation_type_string(state, actual[index].type_id)
                            + " does not implement "
                            + implementation_type_string(state, expected[index].type_id)
                            + " "
                            + implementation_detail
                    },
                false,
            );
            let mut current = state.diagnostics.len() - 1;
            while current > 0 && type_argument_count_diagnostic(state.diagnostics[current - 1])
                && state.diagnostics[current].start < state.diagnostics[current - 1].start {
                let previous = state.diagnostics[current - 1];
                state.diagnostics[current - 1] = state.diagnostics[current];
                state.diagnostics[current] = previous;
                current -= 1;
            }
        }
    }
}

fn check_condition(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    statement: string,
) -> () {
    let condition = check_expression(state, scope, node);
    if type_contains_invalid(state, condition.type_id)
        && !type_contains_active_type(state, condition.type_id) {} else if !is_boolean_type(
        state,
        condition.type_id,
    ) {
        diagnostic(state, node, "non-boolean condition in " + statement + " statement", false)
    }
}

fn label_start(state: CheckState) -> isize {
    if state.label_starts.is_empty() {
        state.labels.len()
    } else {
        state.label_starts[state.label_starts.len() - 1]
    }
}

fn active_label_start(state: CheckState) -> isize {
    if state.active_label_starts.is_empty() {
        state.active_labels.len()
    } else {
        state.active_label_starts[state.active_label_starts.len() - 1]
    }
}

fn label_index(state: CheckState, name: string) -> Option[isize] {
    let start = label_start(state);
    for index in start..state.labels.len() {
        if state.labels[index].name == name {
            return Option::Some(index)
        }
    }
    Option::None
}

fn declare_label(state: CheckState, node: syntax::NodeId) -> () {
    let name = identifier(state, node).unwrap_or("");
    if name == "_" {
        return
    } else if name == "" {
        diagnostic(state, node, "invalid label", false);
        return
    }
    match label_index(state, name) {
        Some(index) => {
            diagnostic(state, node, "label " + name + " already declared", true);
            secondary_diagnostic(state, state.labels[index].node, "\tother declaration of " + name);
            state.diagnostics[state.diagnostics.len() - 1].soft = true;
            return
        },
        None => {},
    }
    let object = go_types::add_object(
        state.world,
        go_types::ObjectKind::Label,
        name,
        Option::Some(state.package_id),
        node_file(state, node),
        Option::Some(node),
        node_start(state, node),
        state.world.invalid,
    );
    state.labels.push(LabelBinding { name, object, node, used: false });
    state.info.defs.push(ObjectFact { node, object: Option::Some(object) })
}

fn collect_labels(state: CheckState, node: syntax::NodeId) -> () {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::LabeledStmt { label, colon: _, statement }) => {
            declare_label(state, label);
            collect_labels(state, statement)
        },
        Some(syntax::SyntaxKind::BlockStmt { lbrace: _, list, rbrace: _ }) => for statement in list {
            collect_labels(state, statement)
        },
        Some(syntax::SyntaxKind::IfStmt { if_pos: _, init: _, condition: _, body, else_branch }) => {
            collect_labels(state, body);
            if let Some(value) = else_branch {
                collect_labels(state, value)
            }
        },
        Some(syntax::SyntaxKind::ForStmt { for_pos: _, init: _, condition: _, post: _, body }) | Some(syntax::SyntaxKind::RangeStmt {
            for_pos: _,
            key: _,
            value: _,
            token_pos: _,
            token: _,
            range_pos: _,
            expression: _,
            body,
        }) | Some(syntax::SyntaxKind::SwitchStmt { switch_pos: _, init: _, tag: _, body }) | Some(syntax::SyntaxKind::TypeSwitchStmt {
            switch_pos: _,
            init: _,
            assignment: _,
            body,
        }) | Some(syntax::SyntaxKind::SelectStmt { select_pos: _, body }) => collect_labels(
            state,
            body,
        ),
        Some(syntax::SyntaxKind::CaseClause { case_pos: _, list: _, colon: _, body }) | Some(syntax::SyntaxKind::CommClause {
            case_pos: _,
            communication: _,
            colon: _,
            body,
        }) => for statement in body {
            collect_labels(state, statement)
        },
        _ => {},
    }
}

fn labeled_statement_context(state: CheckState, node: syntax::NodeId) -> ActiveLabel {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::ForStmt { for_pos: _, init: _, condition: _, post: _, body: _ } | syntax::SyntaxKind::RangeStmt {
            for_pos: _,
            key: _,
            value: _,
            token_pos: _,
            token: _,
            range_pos: _,
            expression: _,
            body: _,
        }) => ActiveLabel { name: "", breakable: true, continuable: true },
        Some(syntax::SyntaxKind::SwitchStmt { switch_pos: _, init: _, tag: _, body: _ } | syntax::SyntaxKind::TypeSwitchStmt {
            switch_pos: _,
            init: _,
            assignment: _,
            body: _,
        } | syntax::SyntaxKind::SelectStmt { select_pos: _, body: _ }) => ActiveLabel {
            name: "",
            breakable: true,
            continuable: false,
        },
        _ => ActiveLabel { name: "", breakable: false, continuable: false },
    }
}

fn use_branch_label(state: CheckState, token: string, node: syntax::NodeId, name: string) -> () {
    let binding = match label_index(state, name) {
        Some(index) => index,
        None => {
            diagnostic(
                state,
                node,
                if token == GOTO_KEYWORD {
                    "label " + name + " not declared"
                } else {
                    "invalid " + token + " label " + name
                },
                false,
            );
            return
        },
    };
    if token == GOTO_KEYWORD {
        record_use(state, node, state.labels[binding].object);
        state.labels[binding].used = true;
        return
    }
    let mut allowed = false;
    let start = active_label_start(state);
    for index in start..state.active_labels.len() {
        if state.active_labels[index].name == name {
            allowed = if token == CONTINUE_KEYWORD {
                state.active_labels[index].continuable
            } else {
                state.active_labels[index].breakable
            };
        }
    }
    if !allowed {
        diagnostic(state, node, "invalid " + token + " label " + name, false)
    } else {
        record_use(state, node, state.labels[binding].object);
        state.labels[binding].used = true;
    }
}

fn check_branch_statement(
    state: CheckState,
    node: syntax::NodeId,
    token: string,
    label: Option[syntax::NodeId],
) -> bool {
    match label {
        Some(label) => use_branch_label(state, token, label, identifier(state, label).unwrap_or("")),
        None => if token == BREAK_KEYWORD && state.breakable_depth == 0 {
            diagnostic(state, node, "break not in for, switch, or select statement", false)
        } else if token == CONTINUE_KEYWORD && state.loop_depth == 0 {
            diagnostic(state, node, "continue not in for statement", false)
        } else if token == GOTO_KEYWORD {
            diagnostic(state, node, "goto requires a label", false)
        } else if token == FALLTHROUGH_KEYWORD && !state.fallthrough_allowed {
            diagnostic(
                state,
                node,
                if state.fallthrough_context == 1 {
                    "cannot fallthrough final case in switch"
                } else if state.fallthrough_context == 2 {
                    "cannot fallthrough in type switch"
                } else {
                    "fallthrough statement out of place"
                },
                false,
            )
        },
    }
    token == GOTO_KEYWORD || token == FALLTHROUGH_KEYWORD
}

fn check_block(
    state: CheckState,
    parent: go_types::ScopeId,
    node: syntax::NodeId,
    signature: go_types::TypeId,
) -> bool {
    let scope = new_node_scope(state, parent, node, go_types::ScopeKind::Block);
    let previous_fallthrough = state.fallthrough_allowed;
    let previous_fallthrough_context = state.fallthrough_context;
    state.fallthrough_allowed = false;
    state.fallthrough_context = 0;
    let result = match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::BlockStmt { lbrace: _, list, rbrace: _ }) => {
            let mut terminating = false;
            for statement in list {
                if check_statement(state, scope, statement, signature) {
                    terminating = true;
                }
            }
            terminating
        },
        _ => {
            diagnostic(state, node, "invalid function body", false);
            false
        },
    };
    state.fallthrough_allowed = previous_fallthrough;
    state.fallthrough_context = previous_fallthrough_context;
    result
}

fn check_if_statement(
    state: CheckState,
    parent: go_types::ScopeId,
    node: syntax::NodeId,
    init: Option[syntax::NodeId],
    condition: syntax::NodeId,
    body: syntax::NodeId,
    else_branch: Option[syntax::NodeId],
    signature: go_types::TypeId,
) -> bool {
    let scope = new_node_scope(state, parent, node, go_types::ScopeKind::Block);
    match init {
        Some(init) => {
            let _ = check_statement(state, scope, init, signature);
        },
        None => {},
    }
    check_condition(state, scope, condition, "if");
    let then_terminates = check_block(state, scope, body, signature);
    let else_terminates = match else_branch {
        Some(else_branch) => match syntax::get_kind(state.syntax.arena, else_branch) {
            Some(syntax::SyntaxKind::BlockStmt { lbrace: _, list: _, rbrace: _ }) => check_block(
                state,
                scope,
                else_branch,
                signature,
            ),
            Some(syntax::SyntaxKind::IfStmt {
                if_pos: _,
                init,
                condition,
                body,
                else_branch: nested_else,
            }) => check_if_statement(
                state,
                scope,
                else_branch,
                init,
                condition,
                body,
                nested_else,
                signature,
            ),
            _ => {
                diagnostic(state, else_branch, "invalid else branch", false);
                false
            },
        },
        None => false,
    };
    then_terminates && else_terminates
}

fn check_for_statement(
    state: CheckState,
    parent: go_types::ScopeId,
    node: syntax::NodeId,
    init: Option[syntax::NodeId],
    condition: Option[syntax::NodeId],
    post: Option[syntax::NodeId],
    body: syntax::NodeId,
    signature: go_types::TypeId,
) -> bool {
    let scope = new_node_scope(state, parent, node, go_types::ScopeKind::Block);
    match init {
        Some(init) => {
            let _ = check_statement(state, scope, init, signature);
        },
        None => {},
    }
    if let Some(condition) = condition {
        check_condition(state, scope, condition, "for")
    }
    match post {
        Some(post) => match syntax::get_kind(state.syntax.arena, post) {
            Some(syntax::SyntaxKind::AssignStmt {
                left,
                token_pos: _,
                token: DEFINE_OPERATOR,
                right: _,
            }) => {
                diagnostic(
                    state,
                    if left.is_empty() {
                        post
                    } else {
                        left[0]
                    },
                    "cannot declare in post statement",
                    true,
                );
                let _ = check_statement(state, scope, post, signature);
                for target in left {
                    let _ = check_expression(state, scope, target);
                }
            },
            _ => {
                let _ = check_statement(state, scope, post, signature);
            },
        },
        None => {},
    }
    state.loop_depth += 1;
    state.breakable_depth += 1;
    let _ = check_block(state, scope, body, signature);
    state.breakable_depth -= 1;
    state.loop_depth -= 1;
    condition.is_none() && !loop_body_breaks(state, node, body)
}

fn loop_label_name(state: CheckState, loop_node: syntax::NodeId) -> string {
    state.statement_labels[loop_node.value].unwrap_or("")
}

fn node_breaks_loop(state: CheckState, node: syntax::NodeId, label: string, nested_breakable: isize) -> bool {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::BranchStmt { token_pos: _, token: BREAK_KEYWORD, label: target }) => match target {
            Some(target) => label != "" && identifier(state, target).unwrap_or("") == label,
            None => nested_breakable == 0,
        },
        Some(syntax::SyntaxKind::BlockStmt { lbrace: _, list, rbrace: _ }) => {
            for statement in list {
                if node_breaks_loop(state, statement, label, nested_breakable) {
                    return true
                }
            }
            false
        },
        Some(syntax::SyntaxKind::LabeledStmt { label: _, colon: _, statement }) => node_breaks_loop(
            state,
            statement,
            label,
            nested_breakable,
        ),
        Some(syntax::SyntaxKind::IfStmt { if_pos: _, init, condition: _, body, else_branch }) => {
            match init {
                Some(init) => if node_breaks_loop(state, init, label, nested_breakable) {
                    return true
                },
                None => {},
            }
            if node_breaks_loop(state, body, label, nested_breakable) {
                return true
            }
            match else_branch {
                Some(else_branch) => node_breaks_loop(state, else_branch, label, nested_breakable),
                None => false,
            }
        },
        Some(syntax::SyntaxKind::ForStmt { for_pos: _, init: _, condition: _, post: _, body } | syntax::SyntaxKind::RangeStmt {
            for_pos: _,
            key: _,
            value: _,
            token_pos: _,
            token: _,
            range_pos: _,
            expression: _,
            body,
        } | syntax::SyntaxKind::SwitchStmt { switch_pos: _, init: _, tag: _, body } | syntax::SyntaxKind::TypeSwitchStmt {
            switch_pos: _,
            init: _,
            assignment: _,
            body,
        } | syntax::SyntaxKind::SelectStmt { select_pos: _, body }) => node_breaks_loop(
            state,
            body,
            label,
            nested_breakable + 1,
        ),
        Some(syntax::SyntaxKind::CaseClause { case_pos: _, list: _, colon: _, body } | syntax::SyntaxKind::CommClause {
            case_pos: _,
            communication: _,
            colon: _,
            body,
        }) => {
            for statement in body {
                if node_breaks_loop(state, statement, label, nested_breakable) {
                    return true
                }
            }
            false
        },
        _ => false,
    }
}

fn loop_body_breaks(state: CheckState, loop_node: syntax::NodeId, body: syntax::NodeId) -> bool {
    node_breaks_loop(state, body, loop_label_name(state, loop_node), 0)
}

fn range_operands(state: CheckState, source: Operand) -> Vec[Operand] {
    let result: Vec[Operand] = Vec::new();
    let mut resolved = core_type_id(state, source.type_id);
    match go_types::get_type(state.world, resolved) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) => {
            resolved = core_type_id(state, element);
        },
        _ => {},
    }
    match go_types::get_type(state.world, resolved) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Array { length: _, element } }) | Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Slice { element },
        }) => {
            result.push(builtin_operand(basic_type_id(state, "int")));
            result.push(builtin_operand(element));
        },
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Map { key, value } }) => {
            result.push(builtin_operand(key));
            result.push(builtin_operand(value));
        },
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Chan { direction: 1, element: _ },
        }) => {},
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Chan { direction: _, element } }) => result.push(
            builtin_operand(element),
        ),
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Basic {
                basic: go_types::BasicKind::String | go_types::BasicKind::UntypedString,
                name: _,
                untyped: _,
            },
        }) => {
            result.push(builtin_operand(basic_type_id(state, "int")));
            result.push(builtin_operand(basic_type_id(state, "rune")));
        },
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Basic {
                basic: go_types::BasicKind::Int | go_types::BasicKind::Int8 | go_types::BasicKind::Int16 | go_types::BasicKind::Int32 | go_types::BasicKind::Int64 | go_types::BasicKind::Uint | go_types::BasicKind::Uint8 | go_types::BasicKind::Uint16 | go_types::BasicKind::Uint32 | go_types::BasicKind::Uint64 | go_types::BasicKind::Uintptr | go_types::BasicKind::UntypedInt | go_types::BasicKind::UntypedRune,
                name: _,
                untyped: _,
            },
        }) => result.push(
            builtin_operand(
                if source.value.is_some() {
                    default_operand_type(state, source)
                } else {
                    source.type_id
                },
            ),
        ),
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: _,
                receiver_type_params: _,
                type_params: _,
                params,
                results,
                variadic: false,
            },
        }) => {
            let source_params = tuple_variables(state, params);
            let source_results = tuple_variables(state, results);
            if source_params.len() == 1 && source_results.is_empty() {
                match go_types::get_type(state.world, core_type_id(state, source_params[0].type_id)) {
                    Some(go_types::TypeData {
                        id: _,
                        kind: go_types::TypeKind::Signature {
                            receiver: _,
                            receiver_type_params: _,
                            type_params: _,
                            params: yield_params,
                            results: yield_results,
                            variadic: false,
                        },
                    }) => {
                        let yield_params = tuple_variables(state, yield_params);
                        let yield_results = tuple_variables(state, yield_results);
                        if yield_params.len() <= 2 && yield_results.len() == 1
                            && go_types::identical(
                                state.world,
                                yield_results[0].type_id,
                                basic_type_id(state, "bool"),
                            ) {
                            for parameter in yield_params {
                                result.push(builtin_operand(parameter.type_id))
                            }
                        }
                    },
                    _ => {},
                }
            }
        },
        _ => {},
    }
    result
}

fn range_type_parameter_failure(state: CheckState, value: go_types::TypeId) -> string {
    if !go_types::is_type_parameter(state.world, value) {
        return ""
    }
    let terms = go_types::type_set_specific_types(state.world, value);
    if terms.is_empty() {
        return "no specific type"
    }
    let first = terms[0];
    let first_underlying = go_types::underlying(state.world, first);
    for index in 1..terms.len() {
        if !go_types::identical(
            state.world,
            first_underlying,
            go_types::underlying(state.world, terms[index]),
        ) {
            return diagnostic_type_string(state, first) + " and "
                + diagnostic_type_string(state, terms[index])
                + " have different underlying types"
        }
    }
    ""
}

fn range_channel_type_string(state: CheckState, value: go_types::TypeId) -> string {
    if go_types::is_type_parameter(state.world, value) {
        let terms = go_types::type_set_specific_types(state.world, value);
        if !terms.is_empty() {
            return diagnostic_type_string(state, terms[0])
        }
    }
    diagnostic_type_string(state, value)
}

fn valid_range_function(state: CheckState, value: go_types::TypeId) -> bool {
    match go_types::get_type(state.world, core_type_id(state, value)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: _,
                receiver_type_params: _,
                type_params: _,
                params,
                results,
                variadic: false,
            },
        }) => {
            let params = tuple_variables(state, params);
            if params.len() != 1 || tuple_arity(state, results) != 0 {
                return false
            }
            match go_types::get_type(state.world, core_type_id(state, params[0].type_id)) {
                Some(go_types::TypeData {
                    id: _,
                    kind: go_types::TypeKind::Signature {
                        receiver: _,
                        receiver_type_params: _,
                        type_params: _,
                        params,
                        results,
                        variadic: false,
                    },
                }) => {
                    let params = tuple_variables(state, params);
                    let results = tuple_variables(state, results);
                    params.len() <= 2 && results.len() == 1
                        && go_types::identical(
                            state.world,
                            results[0].type_id,
                            basic_type_id(state, "bool"),
                        )
                },
                _ => false,
            }
        },
        _ => false,
    }
}

fn range_function_failure(state: CheckState, value: go_types::TypeId) -> string {
    let signature = match go_types::get_type(state.world, core_type_id(state, value)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: _,
                receiver_type_params: _,
                type_params: _,
                params,
                results,
                variadic: _,
            },
        }) => (params, results),
        _ => return "",
    };
    let params = tuple_variables(state, signature.0);
    let results = tuple_variables(state, signature.1);
    let prefix = "func must be func(yield func(...) bool): ";
    if params.len() != 1 {
        return prefix + "wrong argument count"
    } else if !results.is_empty() {
        return prefix + "unexpected results"
    }
    let yield_signature = match go_types::get_type(
        state.world,
        core_type_id(state, params[0].type_id),
    ) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: _,
                receiver_type_params: _,
                type_params: _,
                params,
                results,
                variadic: _,
            },
        }) => (params, results),
        _ => {
            let failure = range_type_parameter_failure(state, params[0].type_id);
            return prefix
                + if failure == "" {
                    "argument is not func"
                } else {
                    "in yield type, " + failure
                }
        },
    };
    let yield_params = tuple_variables(state, yield_signature.0);
    let yield_results = tuple_variables(state, yield_signature.1);
    if yield_params.len() > 2 {
        prefix + "yield func has too many parameters"
    } else if yield_results.len() != 1
        || !go_types::identical(state.world, yield_results[0].type_id, basic_type_id(state, "bool")) {
        prefix
            + if yield_results.len() == 1 && is_boolean_type(state, yield_results[0].type_id) {
                "yield func returns user-defined boolean, not bool"
            } else {
                "yield func does not return bool"
            }
    } else {
        ""
    }
}

fn range_operand_string(state: CheckState, node: syntax::NodeId, operand: Operand) -> string {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::FuncLit { type_node: _, body: _ }) => "("
            + diagnostic_type_string(state, operand.type_id)
            + " literal) (value of type "
            + diagnostic_type_string(state, operand.type_id)
            + ")",
        _ => operand_string(state, node, operand),
    }
}

fn check_range_declaration(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    left: Vec[syntax::NodeId],
    operands: Vec[Operand],
) -> () {
    let mut named = 0;
    for index in 0..left.len() {
        let name = identifier(state, left[index]).unwrap_or("");
        if name == "" {
            diagnostic(
                state,
                left[index],
                "non-name " + expression_source_text(state, left[index]) + " on left side of :=",
                false,
            )
        } else {
            if name != "_" {
                named += 1;
            }
            let _ = declare_local(
                state,
                scope,
                left[index],
                go_types::ObjectKind::Var,
                default_operand_type(state, operands[index]),
                Option::None,
            );
        }
    }
    if named == 0 {
        let position = match syntax::get_kind(state.syntax.arena, node) {
            Some(syntax::SyntaxKind::RangeStmt {
                for_pos: _,
                key: _,
                value: _,
                token_pos,
                token: _,
                range_pos: _,
                expression: _,
                body: _,
            }) => token_pos,
            _ => node_start(state, node),
        };
        diagnostic_at_position(state, node, position, "no new variables on left side of :=", false)
    }
}

fn integer_range_value_assignable(state: CheckState, source: Operand, target: go_types::TypeId) -> bool {
    if source.value.is_some() && !go_types::is_untyped(state.world, source.type_id) {
        go_types::assignable_types(state.world, source.type_id, target)
    } else {
        argument_assignable(state, source, target)
    }
}

fn check_integer_range_value(
    state: CheckState,
    expression: syntax::NodeId,
    source: Operand,
    target: go_types::TypeId,
) -> bool {
    if integer_range_value_assignable(state, source, target) {
        update_contextual_operand_fact(state, expression, source, target);
        return true
    }
    let overflow = match source.value {
        Some(value) => !constant::constant_representable(
            value,
            basic_kind(state, target),
            state.config.sizes,
        ),
        None => false,
    };
    diagnostic(
        state,
        expression,
        "cannot use " + operand_string(state, expression, source) + " as "
            + diagnostic_type_string(state, target)
            + " value in range clause"
            + if overflow {
                " (overflows)"
            } else {
                ""
            },
        false,
    );
    false
}

fn assign_integer_range_value(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    expression: syntax::NodeId,
    source: Operand,
    contextualize_source: bool,
) -> () {
    if !contextualize_source {
        return
    }
    let assignment_object = assignment_identifier_name(state, node).and_then(
        |name| go_types::lookup(state.world, scope, name),
    );
    let assignment_object_used = match assignment_object {
        Some(object) => local_object_used(state, object),
        None => false,
    };
    let blank = assignment_blank_identifier(state, node);
    if blank {
        state.info.defs.push(ObjectFact { node, object: Option::None })
    }
    let target = if blank {
        Operand {
            type_id: default_operand_type(state, source),
            value: Option::None,
            addressable: true,
            assignable: true,
        }
    } else {
        check_expression(state, scope, node)
    };
    match assignment_object {
        Some(object) => if !assignment_object_used {
            let _ = state.used_objects.remove(object.value);
        },
        None => {},
    }
    if target.type_id.value == state.world.invalid.value
        || source.type_id.value == state.world.invalid.value {
        return
    } else if !target.assignable {
        diagnostic(
            state,
            node,
            "cannot assign to " + expression_source_text(state, node)
                + " (neither addressable nor a map index expression)",
            false,
        );
        return
    }
    if check_integer_range_value(state, expression, source, target.type_id) {
        let inferred = if go_types::is_untyped(state.world, source.type_id) {
            target.type_id
        } else {
            source.type_id
        };
        if !go_types::is_integer(state.world, inferred) {
            diagnostic(
                state,
                node,
                "cannot use iteration variable of type " + diagnostic_type_string(state, inferred),
                true,
            )
        }
    }
}

fn check_range_statement(
    state: CheckState,
    parent: go_types::ScopeId,
    node: syntax::NodeId,
    key: Option[syntax::NodeId],
    value: Option[syntax::NodeId],
    token: string,
    expression: syntax::NodeId,
    body: syntax::NodeId,
    signature: go_types::TypeId,
) -> bool {
    let file_name = match node_file(state, node) {
        Some(file) => if file.value >= 0 && file.value < state.syntax.files.len() {
            state.syntax.files[file.value].name
        } else {
            ""
        },
        None => "",
    };
    let mut parser_arity_error = false;
    for value in state.diagnostics {
        if value.file == file_name && value.message == "expected at most 2 expressions"
            && value.start >= node_start(state, node)
            && value.start <= node_end(state, node) {
            parser_arity_error = true;
        }
    }
    if parser_arity_error {
        return false
    }
    let range_scope = new_node_scope(state, parent, node, go_types::ScopeKind::Block);
    let source = check_expression(state, parent, expression);
    let available = range_operands(state, source);
    let function_range = valid_range_function(state, source.type_id);
    let integer_range = go_types::is_integer(state.world, source.type_id);
    let send_only = match go_types::get_type(state.world, core_type_id(state, source.type_id)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Chan { direction: 1, element: _ },
        }) => true,
        _ => false,
    };
    let channel_range = match go_types::get_type(state.world, core_type_id(state, source.type_id)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Chan { direction: _, element: _ },
        }) => true,
        _ => false,
    };
    if integer_range && !go_version_at_least(state, node, 22) {
        diagnostic(
            state,
            expression,
            "cannot range over " + range_operand_string(state, expression, source)
                + ": requires go1.22 or later",
            true,
        )
    } else if function_range && !go_version_at_least(state, node, 23) {
        diagnostic(
            state,
            expression,
            "cannot range over " + range_operand_string(state, expression, source)
                + ": requires go1.23 or later",
            true,
        )
    }
    let left: Vec[syntax::NodeId] = Vec::new();
    if let Some(key) = key {
        left.push(key)
    }
    if let Some(value) = value {
        left.push(value)
    }
    if source.type_id.value == state.world.invalid.value {
        if token == DEFINE_OPERATOR {
            let locals_start = state.locals.len();
            let operands: Vec[Operand] = Vec::new();
            for _ in left {
                operands.push(invalid_operand(state))
            }
            check_range_declaration(state, range_scope, node, left, operands);
            for index in locals_start..state.locals.len() {
                let _ = state.used_objects.insert(state.locals[index].object.value);
            }
        }
    } else if available.is_empty() && !function_range {
        let failure = range_type_parameter_failure(state, source.type_id);
        let function_failure = range_function_failure(state, source.type_id);
        diagnostic(
            state,
            expression,
            "cannot range over " + range_operand_string(state, expression, source)
                + if send_only {
                    ": receive from send-only channel "
                        + range_channel_type_string(state, source.type_id)
                } else if function_failure != "" {
                    ": " + function_failure
                } else if failure != "" {
                    ": " + failure
                } else {
                    ""
                },
            true,
        );
        if token == DEFINE_OPERATOR {
            let locals_start = state.locals.len();
            let operands: Vec[Operand] = Vec::new();
            for _ in left {
                operands.push(invalid_operand(state))
            }
            check_range_declaration(state, range_scope, node, left, operands);
            for index in locals_start..state.locals.len() {
                let _ = state.used_objects.insert(state.locals[index].object.value);
            }
        }
    } else if left.len() > available.len() {
        if integer_range && go_version_at_least(state, node, 22) {
            let _ = check_integer_range_value(
                state,
                expression,
                source,
                default_operand_type(state, source),
            );
        }
        diagnostic(
            state,
            if available.len() < left.len() {
                left[available.len()]
            } else {
                node
            },
            if channel_range || integer_range || function_range {
                "range over " + operand_string(state, expression, source)
                    + if available.is_empty() {
                        " permits no iteration variables"
                    } else {
                        " permits only one iteration variable"
                    }
            } else {
                "too many iteration variables"
            },
            true,
        );
        if token == DEFINE_OPERATOR {
            let operands: Vec[Operand] = Vec::new();
            for index in 0..left.len() {
                if index < available.len() {
                    operands.push(available[index])
                } else {
                    operands.push(invalid_operand(state))
                }
            }
            check_range_declaration(state, range_scope, node, left, operands)
        } else if token == ASSIGN_OPERATOR {
            for index in 0..available.len() {
                assign_existing(state, range_scope, left[index], left[index], available[index])
            }
        }
    } else if token == DEFINE_OPERATOR {
        let operands: Vec[Operand] = Vec::new();
        if integer_range && go_version_at_least(state, node, 22) && !left.is_empty() {
            let target = default_operand_type(state, source);
            let _ = check_integer_range_value(state, expression, source, target);
            operands.push(
                Operand {
                    type_id: target,
                    value: source.value,
                    addressable: false,
                    assignable: false,
                },
            )
        } else {
            for index in 0..left.len() {
                operands.push(available[index])
            }
        }
        check_range_declaration(state, range_scope, node, left, operands)
    } else if token == ASSIGN_OPERATOR {
        if integer_range && !left.is_empty() {
            assign_integer_range_value(
                state,
                range_scope,
                left[0],
                expression,
                source,
                go_version_at_least(state, node, 22),
            )
        } else {
            for index in 0..left.len() {
                assign_existing(state, range_scope, left[index], left[index], available[index])
            }
        }
    } else if !left.is_empty() {
        diagnostic(state, node, "invalid range assignment", false)
    }
    if integer_range && left.is_empty() {
        let _ = check_integer_range_value(
            state,
            expression,
            source,
            default_operand_type(state, source),
        );
    }
    state.loop_depth += 1;
    state.breakable_depth += 1;
    let _ = check_block(state, range_scope, body, signature);
    state.breakable_depth -= 1;
    state.loop_depth -= 1;
    false
}

fn check_send_statement(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    channel: syntax::NodeId,
    arrow: isize,
    value: syntax::NodeId,
) -> () {
    let channel_operand = check_expression(state, scope, channel);
    let sent = check_expression(state, scope, value);
    let type_parameter_failure = channel_type_parameter_failure(
        state,
        channel_operand.type_id,
        false,
    );
    if type_parameter_failure != "" {
        diagnostic_at_position(
            state,
            node,
            arrow,
            "invalid operation: cannot send to " + operand_string(state, channel, channel_operand)
                + ": "
                + type_parameter_failure,
            false,
        );
        return
    }
    match go_types::get_type(state.world, core_type_id(state, channel_operand.type_id)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Chan { direction: 2, element: _ },
        }) => diagnostic_at_position(
            state,
            node,
            arrow,
            "invalid operation: cannot send to receive-only channel "
                + diagnostic_type_string(state, channel_operand.type_id)
                + " "
                + operand_string(state, channel, channel_operand),
            false,
        ),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Chan { direction: _, element } }) => {
            if sent.type_id.value != state.world.invalid.value
                && !argument_assignable(state, sent, element) {
                let implementation_detail = interface_implementation_detail(
                    state,
                    sent.type_id,
                    element,
                );
                diagnostic(
                    state,
                    value,
                    "cannot use " + operand_string(state, value, sent) + " as "
                        + diagnostic_type_string(state, element)
                        + " value in send"
                        + if implementation_detail == "" {
                            ""
                        } else {
                            ": " + implementation_type_string(state, sent.type_id)
                                + " does not implement "
                                + implementation_type_string(state, element)
                                + " "
                                + implementation_detail
                        },
                    false,
                )
            } else if sent.type_id.value != state.world.invalid.value {
                update_contextual_operand_fact(state, value, sent, element)
            }
        },
        _ => if channel_operand.type_id.value != state.world.invalid.value {
            diagnostic_at_position(
                state,
                node,
                arrow,
                "invalid operation: cannot send to non-channel "
                    + diagnostic_type_string(state, channel_operand.type_id)
                    + " "
                    + operand_string(state, channel, channel_operand),
                false,
            )
        },
    }
}

fn check_go_or_defer(
    state: CheckState,
    scope: go_types::ScopeId,
    call: syntax::NodeId,
    statement: string,
) -> () {
    match syntax::get_kind(state.syntax.arena, call) {
        Some(syntax::SyntaxKind::CallExpr {
            function,
            lparen: _,
            arguments: _,
            ellipsis: _,
            rparen: _,
        }) => {
            let conversion = conversion_target(state, scope, function).is_some();
            let operand = check_expression(state, scope, call);
            if conversion && operand.type_id.value != state.world.invalid.value {
                diagnostic(
                    state,
                    function,
                    statement + " requires function call, not conversion "
                        + operand_string(state, call, operand),
                    false,
                )
            } else if operand.type_id.value != state.world.invalid.value
                && !node_is_void(state, call)
                && expression_statement_uses_value(state, scope, call) {
                diagnostic(
                    state,
                    function,
                    statement + " discards result of " + operand_string(state, call, operand),
                    false,
                )
            }
        },
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => {
            let operand = check_expression(state, scope, expression);
            if node_is_void(state, expression) {
                mark_void_node(state, call)
            }
            record_operand(state, call, operand)
        },
        _ => {},
    }
}

fn check_statement_list(
    state: CheckState,
    scope: go_types::ScopeId,
    statements: Vec[syntax::NodeId],
    signature: go_types::TypeId,
) -> bool {
    let mut terminating = false;
    for statement in statements {
        if check_statement(state, scope, statement, signature) {
            terminating = true;
        }
    }
    terminating
}

fn switch_case_compatible(state: CheckState, case_value: Operand, tag: Operand) -> bool {
    let nil_comparison = (basic_kind(state, case_value.type_id) == go_types::BasicKind::UntypedNil
        && go_types::is_nilable_type(state.world, tag.type_id))
        || (basic_kind(state, tag.type_id) == go_types::BasicKind::UntypedNil
            && go_types::is_nilable_type(state.world, case_value.type_id));
    if nil_comparison {
        return true
    }
    let mut common = binary_operand_type(state, case_value, tag);
    if common.value == state.world.invalid.value {
        if go_types::assignable_types(state.world, case_value.type_id, tag.type_id) {
            common = tag.type_id;
        } else if go_types::assignable_types(state.world, tag.type_id, case_value.type_id) {
            common = case_value.type_id;
        }
    }
    common.value != state.world.invalid.value
        && go_types::comparable(state.world, case_value.type_id)
        && go_types::comparable(state.world, tag.type_id)
}

struct SwitchCaseValue {
    value: constant::ConstValue,
    type_id: go_types::TypeId,
    node: syntax::NodeId,
}

fn switch_case_operand_string(state: CheckState, node: syntax::NodeId, operand: Operand) -> string {
    let expression = expression_source_text(state, node);
    let exact = match operand.value {
        Some(value) => constant::constant_string(value),
        None => "",
    };
    expression + " (constant"
        + if exact != expression {
            " " + exact
        } else {
            ""
        }
        + " of "
        + operand_type_description(state, operand.type_id)
        + ")"
}

fn record_switch_case_value(
    state: CheckState,
    node: syntax::NodeId,
    operand: Operand,
    target: go_types::TypeId,
    seen: Vec[SwitchCaseValue],
) -> () {
    if basic_kind(state, operand.type_id) == go_types::BasicKind::UntypedNil {
        return
    }
    let Some(value) = operand.value else {
        return
    };
    if constant::constant_kind(value) == constant::ConstantKind::Unknown {
        return
    }
    let effective_type = if go_types::is_interface(state.world, target) {
        default_operand_type(state, operand)
    } else {
        target
    };
    let effective_value = match constant::convert_constant(
        value,
        basic_kind(state, effective_type),
        state.config.sizes,
    ) {
        Some(converted) => converted,
        None => return,
    };
    for previous in seen {
        if go_types::identical(state.world, previous.type_id, effective_type)
            && constant::constant_equal(previous.value, effective_value) {
            let typed = Operand {
                type_id: effective_type,
                value: Option::Some(effective_value),
                addressable: false,
                assignable: false,
            };
            diagnostic(
                state,
                node,
                "duplicate case " + switch_case_operand_string(state, node, typed)
                    + " in expression switch",
                false,
            );
            secondary_diagnostic(state, previous.node, "\tprevious case");
            return
        }
    }
    seen.push(
        SwitchCaseValue {
            value: constant::constant_copy(effective_value),
            type_id: effective_type,
            node,
        },
    )
}

fn check_expression_case(
    state: CheckState,
    parent: go_types::ScopeId,
    clause: syntax::NodeId,
    list: Vec[syntax::NodeId],
    body: Vec[syntax::NodeId],
    tag: Option[Operand],
    tag_node: Option[syntax::NodeId],
    seen_cases: Vec[SwitchCaseValue],
    signature: go_types::TypeId,
    allow_fallthrough: bool,
) -> (bool, bool) {
    let case_scope = new_node_scope(state, parent, clause, go_types::ScopeKind::Block);
    for expression in list {
        let value = check_expression(state, case_scope, expression);
        if tuple_arity(state, value.type_id) > 1 {
            diagnostic(
                state,
                expression,
                "multiple-value " + operand_string(state, expression, value)
                    + " in single-value context",
                false,
            );
            continue
        }
        match tag {
            Some(tag) => if !switch_case_compatible(state, value, tag) {
                if value.type_id.value != state.world.invalid.value
                    && tag.type_id.value != state.world.invalid.value {
                    let detail = if go_types::is_nilable_type(state.world, value.type_id)
                        && go_types::is_nilable_type(state.world, tag.type_id)
                        && go_types::identical(state.world, value.type_id, tag.type_id) {
                        noncomparable_reason(state, value.type_id)
                    } else {
                        "mismatched types " + diagnostic_type_string(state, value.type_id) + " and "
                            + diagnostic_type_string(state, tag.type_id)
                    };
                    diagnostic(
                        state,
                        expression,
                        "invalid case " + expression_source_text(state, expression)
                            + " in switch on "
                            + match tag_node {
                                Some(tag_node) => expression_source_text(state, tag_node),
                                None => "true",
                            }
                            + " ("
                            + detail
                            + ")",
                        false,
                    )
                }
            } else if !go_types::is_interface(state.world, tag.type_id)
                && report_binary_operand_overflow(state, expression, value, tag.type_id) {} else {
                update_contextual_operand_fact(state, expression, value, tag.type_id);
                record_switch_case_value(state, expression, value, tag.type_id, seen_cases)
            },
            None => if value.type_id.value != state.world.invalid.value
                && !argument_assignable(state, value, basic_type_id(state, "bool")) {
                if go_types::is_untyped(state.world, value.type_id) {
                    diagnostic(
                        state,
                        expression,
                        "cannot convert " + operand_string(state, expression, value)
                            + " to type bool",
                        false,
                    )
                } else {
                    diagnostic(
                        state,
                        expression,
                        "invalid case " + expression_source_text(state, expression)
                            + " in switch on true (mismatched types "
                            + diagnostic_type_string(state, value.type_id)
                            + " and bool)",
                        false,
                    )
                }
            } else if value.type_id.value != state.world.invalid.value {
                update_contextual_operand_fact(
                    state,
                    expression,
                    value,
                    basic_type_id(state, "bool"),
                )
            },
        }
    }
    let previous_fallthrough = state.fallthrough_allowed;
    let previous_fallthrough_context = state.fallthrough_context;
    let mut terminating = false;
    for index in 0..body.len() {
        let trailing = remaining_statements_empty(state, body, index + 1);
        state.fallthrough_allowed = allow_fallthrough && trailing;
        state.fallthrough_context = if !allow_fallthrough && trailing {
            1
        } else {
            0
        };
        if check_statement(state, case_scope, body[index], signature) {
            terminating = true;
        }
    }
    state.fallthrough_allowed = previous_fallthrough;
    state.fallthrough_context = previous_fallthrough_context;
    (list.is_empty(), terminating)
}

fn remaining_statements_empty(state: CheckState, statements: Vec[syntax::NodeId], start: isize) -> bool {
    for index in start..statements.len() {
        match syntax::get_kind(state.syntax.arena, statements[index]) {
            Some(syntax::SyntaxKind::EmptyStmt { semicolon: _, implicit: _ }) => {},
            _ => return false,
        }
    }
    true
}

fn check_switch_tag(state: CheckState, scope: go_types::ScopeId, node: syntax::NodeId) -> Operand {
    let mut value = check_expression(state, scope, node);
    if value.type_id.value == state.world.invalid.value {
        return value
    }
    if tuple_arity(state, value.type_id) > 1 {
        diagnostic(
            state,
            node,
            "multiple-value " + operand_string(state, node, value) + " in single-value context",
            false,
        );
        return invalid_operand(state)
    } else if basic_kind(state, value.type_id) == go_types::BasicKind::UntypedNil {
        diagnostic(state, node, "use of untyped nil in switch expression", false);
        return invalid_operand(state)
    }
    if go_types::is_untyped(state.world, value.type_id) {
        let target = default_operand_type(state, value);
        match value.value {
            Some(constant_value) => if !constant::constant_representable(
                constant_value,
                basic_kind(state, target),
                state.config.sizes,
            ) {
                diagnostic(
                    state,
                    node,
                    "cannot use " + operand_string(state, node, value) + " as "
                        + diagnostic_type_string(state, target)
                        + " value in switch expression (overflows)",
                    false,
                );
                return invalid_operand(state)
            },
            None => {},
        }
        update_contextual_operand_fact(state, node, value, target);
        value.type_id = target;
    }
    if !go_types::comparable(state.world, value.type_id)
        && !go_types::is_nilable_type(state.world, value.type_id) {
        diagnostic(
            state,
            node,
            "cannot switch on " + operand_string(state, node, value) + " ("
                + diagnostic_type_string(state, value.type_id)
                + " is not comparable)",
            false,
        );
        return invalid_operand(state)
    }
    value
}

fn check_switch_statement(
    state: CheckState,
    parent: go_types::ScopeId,
    node: syntax::NodeId,
    init: Option[syntax::NodeId],
    tag_node: Option[syntax::NodeId],
    body_node: syntax::NodeId,
    signature: go_types::TypeId,
) -> bool {
    let switch_scope = new_node_scope(state, parent, node, go_types::ScopeKind::Block);
    match init {
        Some(init) => {
            let _ = check_statement(state, switch_scope, init, signature);
        },
        None => {},
    }
    let tag = tag_node.map(|tag| check_switch_tag(state, switch_scope, tag));
    let mut first_default: Option[syntax::NodeId] = Option::None;
    let mut all_terminate = true;
    let seen_cases: Vec[SwitchCaseValue] = Vec::new();
    match syntax::get_kind(state.syntax.arena, body_node) {
        Some(syntax::SyntaxKind::BlockStmt { lbrace: _, list, rbrace: _ }) => {
            state.breakable_depth += 1;
            for clause_index in 0..list.len() {
                let clause = list[clause_index];
                let allow_fallthrough = clause_index + 1 < list.len();
                match syntax::get_kind(state.syntax.arena, clause) {
                    Some(syntax::SyntaxKind::CaseClause { case_pos: _, list, colon: _, body }) => {
                        let checked = check_expression_case(
                            state,
                            switch_scope,
                            clause,
                            list,
                            body,
                            tag,
                            tag_node,
                            seen_cases,
                            signature,
                            allow_fallthrough,
                        );
                        if checked.0 {
                            match first_default {
                                Some(first) => diagnostic(
                                    state,
                                    clause,
                                    "multiple defaults (first at "
                                        + source_position_string(state, first)
                                        + ")",
                                    false,
                                ),
                                None => {
                                    first_default = Option::Some(clause);
                                },
                            }
                        }
                        if !checked.1 {
                            all_terminate = false;
                        }
                    },
                    _ => diagnostic(state, clause, "invalid switch case", false),
                }
            }
            state.breakable_depth -= 1;
        },
        _ => diagnostic(state, body_node, "invalid switch body", false),
    }
    first_default.is_some() && all_terminate && !loop_body_breaks(state, node, body_node)
}

fn type_switch_guard(state: CheckState, node: syntax::NodeId) -> Option[
    (syntax::NodeId, Option[syntax::NodeId], string),
] {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::ExprStmt { expression }) => match syntax::get_kind(
            state.syntax.arena,
            expression,
        ) {
            Some(syntax::SyntaxKind::TypeAssertExpr {
                expression,
                lparen: _,
                type_node: None,
                rparen: _,
            }) => Option::Some((expression, Option::None, "")),
            _ => Option::None,
        },
        Some(syntax::SyntaxKind::AssignStmt { left, token_pos: _, token, right }) => if left.len()
            == 1
            && right.len() == 1 {
            match syntax::get_kind(state.syntax.arena, right[0]) {
                Some(syntax::SyntaxKind::TypeAssertExpr {
                    expression,
                    lparen: _,
                    type_node: None,
                    rparen: _,
                }) => Option::Some((expression, Option::Some(left[0]), token)),
                _ => Option::None,
            }
        } else {
            Option::None
        },
        _ => Option::None,
    }
}

struct TypeSwitchCaseValue {
    type_id: go_types::TypeId,
    node: syntax::NodeId,
}

fn type_switch_nil_identifier(state: CheckState, scope: go_types::ScopeId, node: syntax::NodeId) -> Option[
    syntax::NodeId,
] {
    match syntax::get_node(state.syntax.arena, node) {
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ },
        }) => type_switch_nil_identifier(state, scope, expression),
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::Ident { name_pos: _, name },
        }) if name == "nil" => match go_types::lookup(state.world, scope, name) {
            Some(object_id) => match go_types::get_object(state.world, object_id) {
                Some(object) => if object.kind == go_types::ObjectKind::Nil {
                    Option::Some(node)
                } else {
                    Option::None
                },
                None => Option::None,
            },
            None => Option::None,
        },
        _ => Option::None,
    }
}

fn check_type_switch_case(
    state: CheckState,
    parent: go_types::ScopeId,
    clause: syntax::NodeId,
    list: Vec[syntax::NodeId],
    body: Vec[syntax::NodeId],
    source: Operand,
    source_node: syntax::NodeId,
    variable_node: Option[syntax::NodeId],
    signature: go_types::TypeId,
    seen_types: Vec[TypeSwitchCaseValue],
    guard_objects: Vec[go_types::ObjectId],
) -> (bool, bool) {
    let case_scope = new_node_scope(state, parent, clause, go_types::ScopeKind::Block);
    let case_types: Vec[go_types::TypeId] = Vec::new();
    for type_node in list {
        let nil_identifier = type_switch_nil_identifier(state, parent, type_node);
        if nil_identifier.is_some() {
            let nil_type = check_expression(state, parent, type_node).type_id;
            let mut duplicate: Option[syntax::NodeId] = Option::None;
            for seen in seen_types {
                if go_types::identical(state.world, seen.type_id, nil_type) {
                    duplicate = Option::Some(seen.node);
                }
            }
            match duplicate {
                Some(previous) => {
                    diagnostic(state, type_node, "duplicate case nil in type switch", false);
                    secondary_diagnostic(state, previous, "\tprevious case")
                },
                None => seen_types.push(TypeSwitchCaseValue { type_id: nil_type, node: type_node }),
            }
        } else {
            let case_type = resolve_type(state, parent, type_node);
            let valid_case_type = case_type.value != state.world.invalid.value
                && !type_contains_invalid(state, case_type);
            if !valid_case_type {
                match syntax::get_kind(state.syntax.arena, type_node) {
                    Some(syntax::SyntaxKind::Ident { name_pos: _, name }) => match go_types::lookup(
                        state.world,
                        parent,
                        name,
                    ) {
                        Some(object_id) => match go_types::get_object(state.world, object_id) {
                            Some(object) => if object.kind == go_types::ObjectKind::TypeName
                                && generic_parameter_count(state, object.type_id) > 0 {
                                let _ = state.omitted_type_fact_nodes.remove(type_node.value);
                                record_invalid_type_expression(state, type_node)
                            },
                            None => {},
                        },
                        None => {},
                    },
                    _ => {},
                }
                match syntax::get_kind(state.syntax.arena, type_node) {
                    Some(syntax::SyntaxKind::BasicLit {
                        value_pos: _,
                        value_end: _,
                        token: _,
                        value: _,
                    }) => {
                        let _ = check_expression(state, parent, type_node);
                    },
                    _ => {},
                }
            }
            if valid_case_type && go_types::is_interface(state.world, source.type_id)
                && !go_types::assertable_to(state.world, source.type_id, case_type) {
                let detail = interface_implementation_detail(state, case_type, source.type_id);
                diagnostic(
                    state,
                    type_node,
                    "impossible type switch case: " + diagnostic_type_string(state, case_type)
                        + "\n\t"
                        + operand_string(state, source_node, source)
                        + " cannot have dynamic type "
                        + diagnostic_type_string(state, case_type)
                        + if detail == "" {
                            ""
                        } else {
                            " " + detail
                        },
                    false,
                )
            }
            if valid_case_type {
                let mut duplicate: Option[syntax::NodeId] = Option::None;
                for seen in seen_types {
                    if go_types::identical(state.world, seen.type_id, case_type) {
                        duplicate = Option::Some(seen.node);
                    }
                }
                match duplicate {
                    Some(previous) => {
                        diagnostic(
                            state,
                            type_node,
                            "duplicate case " + go_types::format_type(state.world, case_type)
                                + " in type switch",
                            false,
                        );
                        secondary_diagnostic(state, previous, "\tprevious case")
                    },
                    None => seen_types.push(
                        TypeSwitchCaseValue { type_id: case_type, node: type_node },
                    ),
                }
            }
            case_types.push(case_type)
        }
    }
    match variable_node {
        Some(variable_node) => {
            let variable_type = if case_types.len() == 1 && list.len() == 1 {
                case_types[0]
            } else {
                source.type_id
            };
            let name = identifier(state, variable_node).unwrap_or("");
            if name != "_" && name != "" {
                let object = go_types::add_object(
                    state.world,
                    go_types::ObjectKind::Var,
                    name,
                    Option::Some(state.package_id),
                    node_file(state, variable_node),
                    Option::Some(variable_node),
                    node_start(state, variable_node),
                    variable_type,
                );
                let _ = go_types::insert(state.world, case_scope, name, object);
                guard_objects.push(object);
                state.info.implicits.push(ObjectFact { node: clause, object: Option::Some(object) })
            }
        },
        None => {},
    }
    let previous_fallthrough = state.fallthrough_allowed;
    let previous_fallthrough_context = state.fallthrough_context;
    let mut terminating = false;
    for index in 0..body.len() {
        state.fallthrough_allowed = false;
        state.fallthrough_context = if remaining_statements_empty(state, body, index + 1) {
            2
        } else {
            0
        };
        if check_statement(state, case_scope, body[index], signature) {
            terminating = true;
        }
    }
    state.fallthrough_allowed = previous_fallthrough;
    state.fallthrough_context = previous_fallthrough_context;
    (list.is_empty(), terminating)
}

fn check_type_switch_statement(
    state: CheckState,
    parent: go_types::ScopeId,
    node: syntax::NodeId,
    init: Option[syntax::NodeId],
    assignment: syntax::NodeId,
    body_node: syntax::NodeId,
    signature: go_types::TypeId,
) -> bool {
    let switch_scope = new_node_scope(state, parent, node, go_types::ScopeKind::Block);
    match init {
        Some(init) => {
            let _ = check_statement(state, switch_scope, init, signature);
        },
        None => {},
    }
    let guard = match type_switch_guard(state, assignment) {
        Some(value) => value,
        None => {
            diagnostic(state, assignment, "invalid type switch guard", false);
            return false
        },
    };
    if guard.2 != "" && guard.2 != DEFINE_OPERATOR {
        diagnostic(state, assignment, "invalid type switch assignment", false)
    }
    match guard.1 {
        Some(variable) => if guard.2 == DEFINE_OPERATOR
            && identifier(state, variable).unwrap_or("") != "_" {
            state.info.defs.push(ObjectFact { node: variable, object: Option::None })
        },
        None => {},
    }
    let source = check_expression(state, switch_scope, guard.0);
    if go_types::is_type_parameter(state.world, source.type_id) {
        diagnostic(
            state,
            guard.0,
            "cannot use type switch on type parameter value "
                + operand_string(state, guard.0, source),
            false,
        )
    } else if source.type_id.value != state.world.invalid.value
        && !go_types::is_interface(state.world, source.type_id) {
        diagnostic(
            state,
            guard.0,
            operand_string(state, guard.0, source) + " is not an interface",
            false,
        )
    }
    let case_source = if source.type_id.value != state.world.invalid.value
        && !go_types::is_type_parameter(state.world, source.type_id)
        && go_types::is_interface(state.world, source.type_id) {
        source
    } else {
        invalid_operand(state)
    };
    let mut first_default: Option[syntax::NodeId] = Option::None;
    let mut all_terminate = true;
    let seen_types: Vec[TypeSwitchCaseValue] = Vec::new();
    let guard_objects: Vec[go_types::ObjectId] = Vec::new();
    match syntax::get_kind(state.syntax.arena, body_node) {
        Some(syntax::SyntaxKind::BlockStmt { lbrace: _, list, rbrace: _ }) => {
            state.breakable_depth += 1;
            for clause in list {
                match syntax::get_kind(state.syntax.arena, clause) {
                    Some(syntax::SyntaxKind::CaseClause { case_pos: _, list, colon: _, body }) => {
                        let checked = check_type_switch_case(
                            state,
                            switch_scope,
                            clause,
                            list,
                            body,
                            case_source,
                            guard.0,
                            guard.1,
                            signature,
                            seen_types,
                            guard_objects,
                        );
                        if checked.0 {
                            match first_default {
                                Some(first) => diagnostic(
                                    state,
                                    clause,
                                    "multiple defaults (first at "
                                        + source_position_string(state, first)
                                        + ")",
                                    false,
                                ),
                                None => {
                                    first_default = Option::Some(clause);
                                },
                            }
                        }
                        if !checked.1 {
                            all_terminate = false;
                        }
                    },
                    _ => diagnostic(state, clause, "invalid type switch case", false),
                }
            }
            state.breakable_depth -= 1;
        },
        _ => diagnostic(state, body_node, "invalid type switch body", false),
    }
    match guard.1 {
        Some(variable) => if guard.2 == DEFINE_OPERATOR {
            let name = identifier(state, variable).unwrap_or("");
            if name == "_" {
                diagnostic(state, variable, "no new variable on left side of :=", true)
            } else if name != "" {
                let mut used = false;
                for object in guard_objects {
                    if local_object_used(state, object) {
                        used = true;
                    }
                }
                if !used {
                    diagnostic(state, variable, name + " declared and not used", true)
                }
            }
        },
        None => {},
    }
    first_default.is_some() && all_terminate && !loop_body_breaks(state, node, body_node)
}

fn valid_select_communication(state: CheckState, node: syntax::NodeId) -> bool {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::ExprStmt { expression }) => select_receive_expression(
            state,
            expression,
        ),
        Some(syntax::SyntaxKind::AssignStmt { left, token_pos: _, token, right }) => assignment_operator(
            token,
        )
            && (left.len() == 1 || left.len() == 2)
            && right.len() == 1
            && select_receive_expression(state, right[0]),
        Some(syntax::SyntaxKind::SendStmt { channel: _, arrow: _, value: _ }) => true,
        _ => false,
    }
}

fn check_select_statement(
    state: CheckState,
    parent: go_types::ScopeId,
    node: syntax::NodeId,
    body_node: syntax::NodeId,
    signature: go_types::TypeId,
) -> bool {
    let select_scope = parent;
    let mut first_default: Option[syntax::NodeId] = Option::None;
    let mut all_terminate = true;
    match syntax::get_kind(state.syntax.arena, body_node) {
        Some(syntax::SyntaxKind::BlockStmt { lbrace: _, list, rbrace: _ }) => {
            state.breakable_depth += 1;
            for clause in list {
                match syntax::get_kind(state.syntax.arena, clause) {
                    Some(syntax::SyntaxKind::CommClause {
                        case_pos: _,
                        communication,
                        colon: _,
                        body,
                    }) => {
                        let case_scope = if match communication {
                            Some(communication) => valid_select_communication(state, communication),
                            None => true,
                        } {
                            new_node_scope(state, select_scope, clause, go_types::ScopeKind::Block)
                        } else {
                            select_scope
                        };
                        match communication {
                            Some(communication) => match syntax::get_kind(
                                state.syntax.arena,
                                communication,
                            ) {
                                Some(syntax::SyntaxKind::ExprStmt { expression }) => if select_receive_expression(
                                    state,
                                    expression,
                                ) {
                                    let _ = check_expression(state, case_scope, expression);
                                } else {
                                    diagnostic(
                                        state,
                                        communication,
                                        "select case must be send or receive (possibly with assignment)",
                                        false,
                                    )
                                },
                                Some(syntax::SyntaxKind::AssignStmt {
                                    left,
                                    token_pos: _,
                                    token,
                                    right,
                                }) => if assignment_operator(token)
                                    && (left.len() == 1 || left.len() == 2)
                                    && right.len() == 1
                                    && select_receive_expression(state, right[0]) {
                                    let _ = check_statement(
                                        state,
                                        case_scope,
                                        communication,
                                        signature,
                                    );
                                } else {
                                    diagnostic(
                                        state,
                                        communication,
                                        "select case must be send or receive (possibly with assignment)",
                                        false,
                                    )
                                },
                                Some(syntax::SyntaxKind::SendStmt { channel: _, arrow: _, value: _ }) => {
                                    let _ = check_statement(
                                        state,
                                        case_scope,
                                        communication,
                                        signature,
                                    );
                                },
                                _ => diagnostic(
                                    state,
                                    communication,
                                    "select case must be send or receive (possibly with assignment)",
                                    false,
                                ),
                            },
                            None => match first_default {
                                Some(first) => diagnostic(
                                    state,
                                    clause,
                                    "multiple defaults (first at "
                                        + source_position_string(state, first)
                                        + ")",
                                    false,
                                ),
                                None => {
                                    first_default = Option::Some(clause);
                                },
                            },
                        }
                        if !check_statement_list(state, case_scope, body, signature) {
                            all_terminate = false;
                        }
                    },
                    _ => diagnostic(state, clause, "invalid select case", false),
                }
            }
            state.breakable_depth -= 1;
        },
        _ => diagnostic(state, body_node, "invalid select body", false),
    }
    all_terminate && !loop_body_breaks(state, node, body_node)
}

fn select_receive_expression(state: CheckState, node: syntax::NodeId) -> bool {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => select_receive_expression(
            state,
            expression,
        ),
        Some(syntax::SyntaxKind::UnaryExpr { op_pos: _, op, expression: _ }) => op
            == RECEIVE_OPERATOR,
        _ => false,
    }
}

fn expression_is_terminating_panic(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
) -> bool {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => expression_is_terminating_panic(
            state,
            scope,
            expression,
        ),
        Some(syntax::SyntaxKind::CallExpr {
            function,
            lparen: _,
            arguments: _,
            ellipsis: _,
            rparen: _,
        }) => match builtin_reference(state, scope, function) {
            Some(reference) => reference.name == PANIC_BUILTIN,
            None => false,
        },
        _ => false,
    }
}

fn expression_statement_uses_value(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
) -> bool {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::CallExpr {
            function,
            lparen: _,
            arguments: _,
            ellipsis: _,
            rparen: _,
        }) => match builtin_reference(state, scope, function) {
            Some(reference) => match reference.name {
                APPEND_BUILTIN | CAP_BUILTIN | LEN_BUILTIN | COMPLEX_BUILTIN | REAL_BUILTIN | IMAG_BUILTIN | MAKE_BUILTIN | NEW_BUILTIN | MIN_BUILTIN | MAX_BUILTIN | UNSAFE_SIZEOF_BUILTIN | UNSAFE_ALIGNOF_BUILTIN | UNSAFE_OFFSETOF_BUILTIN | UNSAFE_ADD_BUILTIN | UNSAFE_SLICE_BUILTIN | UNSAFE_SLICE_DATA_BUILTIN | UNSAFE_STRING_BUILTIN | UNSAFE_STRING_DATA_BUILTIN => true,
                _ => false,
            },
            None => match recorded_type_fact(state, function) {
                Some(fact) => fact.type_expr,
                None => false,
            },
        },
        Some(syntax::SyntaxKind::UnaryExpr { op_pos: _, op, expression: _ }) => op
            != RECEIVE_OPERATOR,
        _ => true,
    }
}

fn recover_void_call_fact(state: CheckState, node: syntax::NodeId) -> () {
    let function = match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::CallExpr {
            function,
            lparen: _,
            arguments: _,
            ellipsis: _,
            rparen: _,
        }) => function,
        _ => return,
    };
    if state.failed_inference_nodes.contains(function.value) {
        return
    }
    let selected = recorded_selection_index(state, function).map(
        |index| method_value_type(state, state.info.selections[index].type_id),
    );
    let signature = match recorded_type_fact(state, function) {
        Some(fact) => if fact.type_id.value != state.world.invalid.value
            && !type_contains_invalid(state, fact.type_id) {
            Option::Some(fact.type_id)
        } else {
            selected
        },
        None => selected,
    };
    let known_void = match signature {
        Some(type_id) => match go_types::get_type(
            state.world,
            go_types::unalias(state.world, type_id),
        ) {
            Some(go_types::TypeData {
                id: _,
                kind: go_types::TypeKind::Signature {
                    receiver: _,
                    receiver_type_params: _,
                    type_params: _,
                    params: _,
                    results,
                    variadic: _,
                },
            }) => tuple_arity(state, results) == 0,
            _ => false,
        },
        None => false,
    };
    if !known_void {
        return
    }
    let _ = state.omitted_type_fact_nodes.remove(function.value);
    match signature {
        Some(type_id) => if type_id.value != state.world.invalid.value
            && !type_contains_invalid(state, type_id) {
            record_operand(state, function, builtin_operand(type_id))
        },
        None => {},
    }
    mark_void_node(state, node);
    match type_fact_index(state, node) {
        Some(index) => {
            state.info.types[index].type_id = go_types::add_type(
                state.world,
                go_types::TypeKind::Tuple { variables: Vec::new() },
            );
            state.info.types[index].extra = Option::None;
            state.info.types[index].void = true;
            state.info.types[index].type_expr = false;
            state.info.types[index].builtin = false;
            state.info.types[index].value_expr = false;
            state.info.types[index].nil = false;
            state.info.types[index].addressable = false;
            state.info.types[index].assignable = false;
            state.info.types[index].comma_ok = false;
        },
        None => record_operand(
            state,
            node,
            Operand {
                type_id: state.world.invalid,
                value: Option::None,
                addressable: false,
                assignable: false,
            },
        ),
    }
}

fn check_statement(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    signature: go_types::TypeId,
) -> bool {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::EmptyStmt { semicolon: _, implicit: _ }) => false,
        Some(syntax::SyntaxKind::ExprStmt { expression }) => {
            let operand = check_expression(state, scope, expression);
            if operand.type_id.value == state.world.invalid.value {
                recover_void_call_fact(state, expression)
            }
            if operand.type_id.value != state.world.invalid.value
                && expression_statement_uses_value(state, scope, expression) {
                diagnostic(
                    state,
                    expression,
                    operand_string(state, expression, operand) + " is not used",
                    false,
                )
            }
            expression_is_terminating_panic(state, scope, expression)
        },
        Some(syntax::SyntaxKind::DeclStmt { declaration }) => {
            check_local_declaration(state, scope, declaration);
            false
        },
        Some(syntax::SyntaxKind::AssignStmt { left, token_pos: _, token, right }) => {
            check_assignment(state, scope, node, left, token, right);
            false
        },
        Some(syntax::SyntaxKind::IncDecStmt { expression, token_pos: _, token }) => {
            let operand = check_expression(state, scope, expression);
            let one = constant::ConstValue::Int(constant::integer_from_int64(1));
            let fact_one = if go_types::is_untyped(state.world, operand.type_id) {
                one
            } else {
                constant::convert_constant(
                    one,
                    basic_kind(state, operand.type_id),
                    state.config.sizes,
                ).unwrap_or(one)
            };
            let file = match node_file(state, expression) {
                Some(file) => if file.value >= 0 && file.value < state.syntax.files.len() {
                    state.syntax.files[file.value].name
                } else {
                    ""
                },
                None => "",
            };
            if operand.type_id.value != state.world.invalid.value
                && go_types::is_numeric(state.world, operand.type_id) {
                let key = f"{file}:$unknown[*ast.BasicLit:{node_start(state, expression)}:{node_start(state, expression) + 1}]";
                let mut exists = false;
                for fact in state.info.types {
                    match type_fact_key(fact) {
                        Some(existing) => if existing == key {
                            exists = true;
                        },
                        None => {},
                    }
                }
                if !exists {
                    state.info.types.push(
                        TypeFact {
                            node: syntax::node_id(-1),
                            type_id: operand.type_id,
                            extra: type_fact_extra(
                                Option::Some(key),
                                constant::constant_kind_name(fact_one),
                                Option::Some(constant::constant_exact_string(fact_one)),
                            ),
                            void: false,
                            type_expr: false,
                            builtin: false,
                            value_expr: true,
                            nil: false,
                            addressable: false,
                            assignable: false,
                            comma_ok: false,
                        },
                    )
                }
            }
            if operand.type_id.value == state.world.invalid.value {} else if !operand.assignable {
                diagnostic(
                    state,
                    expression,
                    "cannot assign to " + expression_source_text(state, expression)
                        + " (neither addressable nor a map index expression)",
                    false,
                )
            } else if !go_types::is_numeric(state.world, operand.type_id) {
                diagnostic(
                    state,
                    expression,
                    "invalid operation: " + expression_source_text(state, expression) + token
                        + " (non-numeric type "
                        + diagnostic_type_string(state, operand.type_id)
                        + ")",
                    false,
                )
            }
            false
        },
        Some(syntax::SyntaxKind::ReturnStmt { return_pos: _, results }) => {
            check_return(state, scope, node, results, signature);
            true
        },
        Some(syntax::SyntaxKind::SendStmt { channel, arrow, value }) => {
            check_send_statement(state, scope, node, channel, arrow, value);
            false
        },
        Some(syntax::SyntaxKind::GoStmt { go_pos: _, call }) => {
            check_go_or_defer(state, scope, call, "go");
            false
        },
        Some(syntax::SyntaxKind::DeferStmt { defer_pos: _, call }) => {
            check_go_or_defer(state, scope, call, "defer");
            false
        },
        Some(syntax::SyntaxKind::LabeledStmt { label, colon: _, statement }) => {
            let context = labeled_statement_context(state, statement);
            state.active_labels.push(
                ActiveLabel {
                    name: identifier(state, label).unwrap_or(""),
                    breakable: context.breakable,
                    continuable: context.continuable,
                },
            );
            let result = check_statement(state, scope, statement, signature);
            let _ = state.active_labels.pop();
            result
        },
        Some(syntax::SyntaxKind::BranchStmt { token_pos: _, token, label }) => check_branch_statement(
            state,
            node,
            token,
            label,
        ),
        Some(syntax::SyntaxKind::BlockStmt { lbrace: _, list: _, rbrace: _ }) => check_block(
            state,
            scope,
            node,
            signature,
        ),
        Some(syntax::SyntaxKind::IfStmt { if_pos: _, init, condition, body, else_branch }) => check_if_statement(
            state,
            scope,
            node,
            init,
            condition,
            body,
            else_branch,
            signature,
        ),
        Some(syntax::SyntaxKind::ForStmt { for_pos: _, init, condition, post, body }) => check_for_statement(
            state,
            scope,
            node,
            init,
            condition,
            post,
            body,
            signature,
        ),
        Some(syntax::SyntaxKind::RangeStmt {
            for_pos: _,
            key,
            value,
            token_pos: _,
            token,
            range_pos: _,
            expression,
            body,
        }) => check_range_statement(
            state,
            scope,
            node,
            key,
            value,
            token,
            expression,
            body,
            signature,
        ),
        Some(syntax::SyntaxKind::SwitchStmt { switch_pos: _, init, tag, body }) => check_switch_statement(
            state,
            scope,
            node,
            init,
            tag,
            body,
            signature,
        ),
        Some(syntax::SyntaxKind::TypeSwitchStmt { switch_pos: _, init, assignment, body }) => check_type_switch_statement(
            state,
            scope,
            node,
            init,
            assignment,
            body,
            signature,
        ),
        Some(syntax::SyntaxKind::SelectStmt { select_pos: _, body }) => check_select_statement(
            state,
            scope,
            node,
            body,
            signature,
        ),
        Some(_) => {
            diagnostic(state, node, "statement is not implemented yet", false);
            false
        },
        None => false,
    }
}

fn local_object_used(state: CheckState, object: go_types::ObjectId) -> bool {
    state.used_objects.contains(object.value)
}

fn local_scope_depth(state: CheckState, scope: go_types::ScopeId) -> isize {
    state.world.scopes[scope.value].depth
}

fn report_unused_locals(state: CheckState, function_id: isize, start: isize) -> () {
    let mut root_depth = state.world.scopes.len();
    for index in start..state.locals.len() {
        let local = state.locals[index];
        let depth = local_scope_depth(state, local.scope);
        if local.function_id == function_id && depth < root_depth {
            root_depth = depth;
        }
    }
    for root in Vec::from_array([true, false]) {
        for index in start..state.locals.len() {
            let local = state.locals[index];
            let root_local = local_scope_depth(state, local.scope) == root_depth;
            if local.function_id == function_id && root_local == root
                && !local_object_used(state, local.object) {
                match go_types::get_object(state.world, local.object) {
                    Some(object) => diagnostic(
                        state,
                        local.node,
                        "declared and not used: " + object.name,
                        true,
                    ),
                    None => {},
                }
            }
        }
    }
}

struct FlowLabel {
    name: string,
    node: syntax::NodeId,
    position: isize,
    blocks: Vec[syntax::NodeId],
}

struct FlowGoto {
    name: string,
    node: syntax::NodeId,
    position: isize,
    blocks: Vec[syntax::NodeId],
}

struct FlowDeclaration {
    node: syntax::NodeId,
    position: isize,
    blocks: Vec[syntax::NodeId],
}

fn copied_node_ids(values: Vec[syntax::NodeId]) -> Vec[syntax::NodeId] {
    let result: Vec[syntax::NodeId] = Vec::new();
    for value in values {
        result.push(value)
    }
    result
}

fn nested_flow_blocks(values: Vec[syntax::NodeId], block: syntax::NodeId) -> Vec[syntax::NodeId] {
    let result = copied_node_ids(values);
    result.push(block);
    result
}

fn record_flow_declaration(
    state: CheckState,
    declaration: syntax::NodeId,
    blocks: Vec[syntax::NodeId],
    declarations: Vec[FlowDeclaration],
) -> () {
    match syntax::get_kind(state.syntax.arena, declaration) {
        Some(syntax::SyntaxKind::GenDecl { token_pos: _, token, lparen: _, specs, rparen: _ }) => if token
            == VAR_KEYWORD {
            for spec in specs {
                declarations.push(
                    FlowDeclaration {
                        node: spec,
                        position: node_end(state, spec),
                        blocks: copied_node_ids(blocks),
                    },
                )
            }
        },
        _ => {},
    }
}

fn collect_flow_points(
    state: CheckState,
    node: syntax::NodeId,
    blocks: Vec[syntax::NodeId],
    labels: Vec[FlowLabel],
    gotos: Vec[FlowGoto],
    declarations: Vec[FlowDeclaration],
) -> () {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::BlockStmt { lbrace: _, list, rbrace: _ }) => {
            let nested = nested_flow_blocks(blocks, node);
            for statement in list {
                collect_flow_points(state, statement, nested, labels, gotos, declarations)
            }
        },
        Some(syntax::SyntaxKind::LabeledStmt { label, colon: _, statement }) => {
            let name = identifier(state, label).unwrap_or("");
            let mut duplicate = false;
            for existing in labels {
                if existing.name == name {
                    duplicate = true;
                }
            }
            if !duplicate {
                labels.push(
                    FlowLabel {
                        name,
                        node: label,
                        position: node_start(state, label),
                        blocks: copied_node_ids(blocks),
                    },
                )
            }
            collect_flow_points(state, statement, blocks, labels, gotos, declarations)
        },
        Some(syntax::SyntaxKind::BranchStmt { token_pos: _, token, label }) => if token
            == GOTO_KEYWORD {
            match label {
                Some(label) => gotos.push(
                    FlowGoto {
                        name: identifier(state, label).unwrap_or(""),
                        node: label,
                        position: node_start(state, node),
                        blocks: copied_node_ids(blocks),
                    },
                ),
                None => {},
            }
        },
        Some(syntax::SyntaxKind::DeclStmt { declaration }) => record_flow_declaration(
            state,
            declaration,
            blocks,
            declarations,
        ),
        Some(syntax::SyntaxKind::AssignStmt { left: _, token_pos: _, token, right: _ }) => if token
            == DEFINE_OPERATOR {
            declarations.push(
                FlowDeclaration {
                    node,
                    position: node_end(state, node),
                    blocks: copied_node_ids(blocks),
                },
            )
        },
        Some(syntax::SyntaxKind::IfStmt { if_pos: _, init, condition: _, body, else_branch }) => {
            let init_blocks = nested_flow_blocks(blocks, node);
            match init {
                Some(value) => collect_flow_points(
                    state,
                    value,
                    init_blocks,
                    labels,
                    gotos,
                    declarations,
                ),
                None => {},
            }
            collect_flow_points(state, body, blocks, labels, gotos, declarations);
            match else_branch {
                Some(value) => collect_flow_points(
                    state,
                    value,
                    blocks,
                    labels,
                    gotos,
                    declarations,
                ),
                None => {},
            }
        },
        Some(syntax::SyntaxKind::ForStmt { for_pos: _, init, condition: _, post, body }) => {
            let init_blocks = nested_flow_blocks(blocks, node);
            match init {
                Some(value) => collect_flow_points(
                    state,
                    value,
                    init_blocks,
                    labels,
                    gotos,
                    declarations,
                ),
                None => {},
            }
            match post {
                Some(value) => collect_flow_points(
                    state,
                    value,
                    blocks,
                    labels,
                    gotos,
                    declarations,
                ),
                None => {},
            }
            collect_flow_points(state, body, blocks, labels, gotos, declarations)
        },
        Some(syntax::SyntaxKind::RangeStmt {
            for_pos: _,
            key: _,
            value: _,
            token_pos: _,
            token: _,
            range_pos: _,
            expression: _,
            body,
        }) => collect_flow_points(state, body, blocks, labels, gotos, declarations),
        Some(syntax::SyntaxKind::SwitchStmt { switch_pos: _, init, tag: _, body }) | Some(syntax::SyntaxKind::TypeSwitchStmt {
            switch_pos: _,
            init,
            assignment: _,
            body,
        }) => {
            let init_blocks = nested_flow_blocks(blocks, node);
            match init {
                Some(value) => collect_flow_points(
                    state,
                    value,
                    init_blocks,
                    labels,
                    gotos,
                    declarations,
                ),
                None => {},
            }
            collect_flow_points(state, body, blocks, labels, gotos, declarations)
        },
        Some(syntax::SyntaxKind::SelectStmt { select_pos: _, body }) => collect_flow_points(
            state,
            body,
            blocks,
            labels,
            gotos,
            declarations,
        ),
        Some(syntax::SyntaxKind::CaseClause { case_pos: _, list: _, colon: _, body }) | Some(syntax::SyntaxKind::CommClause {
            case_pos: _,
            communication: _,
            colon: _,
            body,
        }) => {
            let nested = nested_flow_blocks(blocks, node);
            for statement in body {
                collect_flow_points(state, statement, nested, labels, gotos, declarations)
            }
        },
        _ => {},
    }
}

fn flow_blocks_prefix(prefix: Vec[syntax::NodeId], value: Vec[syntax::NodeId]) -> bool {
    if prefix.len() > value.len() {
        return false
    }
    for index in 0..prefix.len() {
        if prefix[index].value != value[index].value {
            return false
        }
    }
    true
}

fn source_line(state: CheckState, node: syntax::NodeId) -> isize {
    match syntax::get_node(state.syntax.arena, node) {
        Some(value) => if value.file.value < 0 || value.file.value >= state.syntax.files.len() {
            0
        } else {
            let name = state.syntax.files[value.file.value].name;
            for source in state.sources {
                if source.name == name {
                    let mut line = 1;
                    let end = if value.span.start < source.source.len() {
                        value.span.start
                    } else {
                        source.source.len()
                    };
                    for index in 0..end {
                        if source.source.get(index) == b'\n' {
                            line += 1;
                        }
                    }
                    return line
                }
            }
            0
        },
        None => 0,
    }
}

fn check_goto_restrictions(state: CheckState, body: syntax::NodeId) -> () {
    let labels: Vec[FlowLabel] = Vec::new();
    let gotos: Vec[FlowGoto] = Vec::new();
    let declarations: Vec[FlowDeclaration] = Vec::new();
    collect_flow_points(state, body, Vec::new(), labels, gotos, declarations);
    for value in gotos {
        for label in labels {
            if value.name == label.name {
                if !flow_blocks_prefix(label.blocks, value.blocks) {
                    let _ = state.omitted_use_fact_nodes.insert(value.node.value);
                    diagnostic(state, value.node, "goto " + value.name + " jumps into block", false)
                } else if value.position < label.position {
                    let mut crossed: Option[FlowDeclaration] = Option::None;
                    for declaration in declarations {
                        if value.position < declaration.position
                            && declaration.position < label.position
                            && flow_blocks_prefix(declaration.blocks, label.blocks) {
                            crossed = Option::Some(declaration);
                        }
                    }
                    match crossed {
                        Some(declaration) => {
                            diagnostic(
                                state,
                                value.node,
                                f"goto {value.name} jumps over variable declaration at line {source_line(state, declaration.node)}",
                                true,
                            );
                        },
                        None => {},
                    }
                }
            }
        }
    }
}

fn check_function_block(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    signature: go_types::TypeId,
) -> bool {
    let previous_fallthrough = state.fallthrough_allowed;
    let previous_fallthrough_context = state.fallthrough_context;
    state.fallthrough_allowed = false;
    state.fallthrough_context = 0;
    let result = match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::BlockStmt { lbrace: _, list, rbrace: _ }) => check_statement_list(
            state,
            scope,
            list,
            signature,
        ),
        _ => {
            diagnostic(state, node, "invalid function body", false);
            false
        },
    };
    state.fallthrough_allowed = previous_fallthrough;
    state.fallthrough_context = previous_fallthrough_context;
    result
}

fn check_function_body(
    state: CheckState,
    signature_node: syntax::NodeId,
    signature: go_types::TypeId,
    body: syntax::NodeId,
) -> () {
    if state.checked_function_bodies.contains(body.value) {
        return
    }
    let _ = state.checked_function_bodies.insert(body.value);
    for index in 0..state.deferred_function_type_diagnostics.len() {
        let deferred = state.deferred_function_type_diagnostics[index];
        if !deferred.emitted && deferred.signature_node.value == signature_node.value {
            state.diagnostics.push(deferred.diagnostic);
            state.deferred_function_type_diagnostics[index].emitted = true;
        }
    }
    match syntax::get_kind(state.syntax.arena, signature_node) {
        Some(syntax::SyntaxKind::FuncType { func_pos: _, type_params: _, params, results }) => {
            check_map_keys_in_type_node(state, params);
            if let Some(results) = results {
                check_map_keys_in_type_node(state, results)
            }
        },
        _ => {},
    }
    match signature_scope(state, signature_node) {
        Some(scope) => {
            let function_id = state.next_function_id;
            state.next_function_id += 1;
            state.function_ids.push(function_id);
            let locals_start = state.locals.len();
            let function_parameters = generic_parameters(state, signature);
            state.active_instantiations.push(
                ActiveInstantiation {
                    origin: signature,
                    parameters: function_parameters,
                    diagnostic_parameters: function_parameters,
                },
            );
            let labels_start = state.labels.len();
            let active_start = state.active_labels.len();
            state.label_starts.push(labels_start);
            state.active_label_starts.push(active_start);
            if state.statement_labels.len() > 0 {
                collect_labels(state, body);
                if state.has_goto_statements {
                    check_goto_restrictions(state, body)
                }
            }
            let previous_loop_depth = state.loop_depth;
            let previous_breakable_depth = state.breakable_depth;
            let previous_fallthrough = state.fallthrough_allowed;
            let previous_fallthrough_context = state.fallthrough_context;
            state.loop_depth = 0;
            state.breakable_depth = 0;
            state.fallthrough_allowed = false;
            state.fallthrough_context = 0;
            let terminating = check_function_block(state, scope, body, signature);
            if !signature_results(state, signature).is_empty() && !terminating {
                let position = match syntax::get_kind(state.syntax.arena, body) {
                    Some(syntax::SyntaxKind::BlockStmt { lbrace: _, list: _, rbrace }) => rbrace,
                    _ => node_end(state, body),
                };
                diagnostic_at_position(state, body, position, "missing return", false)
            }
            for index in labels_start..state.labels.len() {
                if !state.labels[index].used {
                    diagnostic(
                        state,
                        state.labels[index].node,
                        "label " + state.labels[index].name + " declared and not used",
                        true,
                    )
                }
            }
            report_unused_locals(state, function_id, locals_start);
            state.loop_depth = previous_loop_depth;
            state.breakable_depth = previous_breakable_depth;
            state.fallthrough_allowed = previous_fallthrough;
            state.fallthrough_context = previous_fallthrough_context;
            let _ = state.label_starts.pop();
            let _ = state.active_label_starts.pop();
            let _ = state.active_instantiations.pop();
            let _ = state.function_ids.pop();
        },
        None => diagnostic(state, body, "missing function scope", false),
    }
}
