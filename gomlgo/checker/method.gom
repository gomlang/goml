package checker;

use gomlgo::syntax;
use gomlgo::types as go_types;

struct ReceiverResolution {
    receiver_type: go_types::TypeId,
    base: go_types::TypeId,
    scope: go_types::ScopeId,
    type_params: Vec[go_types::TypeParameter],
}

fn signature_scope(state: CheckState, node: syntax::NodeId) -> Option[go_types::ScopeId] {
    find_scope_fact(state, node).map(|fact| fact.scope)
}

fn receiver_base(state: CheckState, type_id: go_types::TypeId) -> Option[go_types::TypeId] {
    match go_types::get_type(state.world, go_types::unalias(state.world, type_id)) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) => receiver_base(
            state,
            element,
        ),
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object,
                underlying: _,
                type_params: _,
                type_args: _,
                methods: _,
            },
        }) => go_types::get_object(state.world, object).map(|object| object.type_id),
        _ => Option::None,
    }
}

fn receiver_type_seen(values: Vec[go_types::TypeId], value: go_types::TypeId) -> bool {
    for existing in values {
        if existing.value == value.value {
            return true
        }
    }
    false
}

fn receiver_instantiated_target_inner(
    state: CheckState,
    type_id: go_types::TypeId,
    visited: Vec[go_types::TypeId],
) -> Option[go_types::TypeId] {
    if receiver_type_seen(visited, type_id) {
        return Option::None
    }
    visited.push(type_id);
    match go_types::get_type(state.world, type_id) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Alias { object: _, rhs, type_params: _, type_args },
        }) => if type_args.is_empty() {
            receiver_instantiated_target_inner(state, rhs, visited)
        } else {
            Option::Some(type_id)
        },
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) => receiver_instantiated_target_inner(
            state,
            element,
            visited,
        ),
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object: _,
                underlying: _,
                type_params: _,
                type_args,
                methods: _,
            },
        }) => if type_args.is_empty() {
            Option::None
        } else {
            Option::Some(type_id)
        },
        _ => Option::None,
    }
}

fn receiver_instantiated_target(state: CheckState, type_id: go_types::TypeId) -> Option[
    go_types::TypeId,
] {
    receiver_instantiated_target_inner(state, type_id, Vec::new())
}

fn existing_method(state: CheckState, type_id: go_types::TypeId, name: string) -> Option[
    go_types::ObjectId,
] {
    if name == "_" {
        return Option::None
    }
    match go_types::get_type(state.world, type_id) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object: _,
                underlying: _,
                type_params: _,
                type_args: _,
                methods,
            },
        }) => for method in methods {
            match go_types::get_object(state.world, method) {
                Some(value) => if value.name == name {
                    return Option::Some(method)
                },
                None => {},
            }
        },
        _ => {},
    }
    Option::None
}

fn duplicate_method_diagnostic(
    state: CheckState,
    node: syntax::NodeId,
    base: go_types::TypeId,
    name: string,
    existing: go_types::ObjectId,
) -> () {
    let receiver_name = match go_types::get_type(state.world, base) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object,
                underlying: _,
                type_params: _,
                type_args: _,
                methods: _,
            },
        }) => match go_types::get_object(state.world, object) {
            Some(object) => object.name,
            None => go_types::format_type(state.world, base),
        },
        _ => go_types::format_type(state.world, base),
    };
    let location = match go_types::get_object(state.world, existing) {
        Some(object) => match object.node {
            Some(node) => source_position_string(state, node),
            None => "",
        },
        None => "",
    };
    diagnostic(
        state,
        node,
        "method " + receiver_name + "." + name + " already declared"
            + if location == "" {
                ""
            } else {
                " at " + location
            },
        false,
    )
}

fn add_named_method(state: CheckState, type_id: go_types::TypeId, method: go_types::ObjectId) -> () {
    match go_types::get_object(state.world, method) {
        Some(method) => if method.name == "_" {
            return
        },
        None => return,
    }
    match go_types::get_type(state.world, type_id) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named { object, underlying, type_params, type_args, methods },
        }) => {
            methods.push(method);
            let _ = go_types::set_type(
                state.world,
                type_id,
                go_types::TypeKind::Named { object, underlying, type_params, type_args, methods },
            );
        },
        _ => {},
    }
}

fn set_signature_receiver(
    state: CheckState,
    signature: go_types::TypeId,
    receiver: go_types::Variable,
    receiver_type_params: Vec[go_types::TypeParameter],
) -> () {
    match go_types::get_type(state.world, signature) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: _,
                receiver_type_params: _,
                type_params,
                params,
                results,
                variadic,
            },
        }) => {
            let _ = go_types::set_type(
                state.world,
                signature,
                go_types::TypeKind::Signature {
                    receiver: Option::Some(receiver),
                    receiver_type_params,
                    type_params,
                    params,
                    results,
                    variadic,
                },
            );
        },
        _ => {},
    }
}

fn discard_method_type_parameters(state: CheckState, signature: go_types::TypeId) -> () {
    match go_types::get_type(state.world, signature) {
        Some(go_types::TypeData {
            id,
            kind: go_types::TypeKind::Signature {
                receiver,
                receiver_type_params,
                type_params: _,
                params,
                results,
                variadic,
            },
        }) => {
            let _ = go_types::set_type(
                state.world,
                id,
                go_types::TypeKind::Signature {
                    receiver,
                    receiver_type_params,
                    type_params: Vec::new(),
                    params,
                    results,
                    variadic,
                },
            );
        },
        _ => {},
    }
}

fn resolve_method_signature(state: CheckState, scope: go_types::ScopeId, node: syntax::NodeId) -> go_types::TypeId {
    let previous = state.ignore_function_type_params;
    state.ignore_function_type_params = true;
    let result = resolve_function_signature(state, scope, node, false);
    state.ignore_function_type_params = previous;
    result
}

fn receiver_type_parts(state: CheckState, node: syntax::NodeId) -> (
    syntax::NodeId,
    Vec[syntax::NodeId],
    bool,
) {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::StarExpr { star: _, expression }) => {
            let inner = receiver_type_parts(state, expression);
            (inner.0, inner.1, true)
        },
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => receiver_type_parts(
            state,
            expression,
        ),
        Some(syntax::SyntaxKind::IndexExpr { expression, lbrack: _, index, rbrack: _ }) => (
            expression,
            Vec::from_array([index]),
            false,
        ),
        Some(syntax::SyntaxKind::IndexListExpr { expression, lbrack: _, indices, rbrack: _ }) => (
            expression,
            indices,
            false,
        ),
        _ => (node, Vec::new(), false),
    }
}

fn record_receiver_type_syntax(state: CheckState, node: syntax::NodeId, type_id: go_types::TypeId) -> () {
    record_type_expression(state, node, type_id);
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ }) => record_receiver_type_syntax(
            state,
            expression,
            type_id,
        ),
        Some(syntax::SyntaxKind::StarExpr { star: _, expression }) => {
            let element = match go_types::get_type(state.world, type_id) {
                Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) => element,
                _ => state.world.invalid,
            };
            record_receiver_type_syntax(state, expression, element)
        },
        _ => {},
    }
}

fn unresolved_receiver_origin(state: CheckState, scope: go_types::ScopeId, node: syntax::NodeId) -> Option[
    go_types::TypeId,
] {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::Ident { name_pos: _, name }) => match go_types::lookup(
            state.world,
            scope,
            name,
        ) {
            Some(object_id) => match pending_type_index(state, object_id) {
                Some(index) => if state.pending_types[index].type_params_node.is_none() {
                    match go_types::get_object(state.world, object_id) {
                        Some(object) => if object.kind == go_types::ObjectKind::TypeName {
                            record_use(state, node, object_id);
                            record_type_expression(state, node, object.type_id);
                            Option::Some(object.type_id)
                        } else {
                            Option::None
                        },
                        None => Option::None,
                    }
                } else {
                    Option::None
                },
                None => Option::None,
            },
            None => Option::None,
        },
        _ => Option::None,
    }
}

fn recover_invalid_receiver_parameters(
    state: CheckState,
    file_scope: go_types::ScopeId,
    receiver_node: syntax::NodeId,
    nodes: Vec[syntax::NodeId],
) -> (go_types::ScopeId, Vec[go_types::TypeParameter]) {
    let scope = go_types::add_scope(
        state.world,
        go_types::ScopeKind::Block,
        Option::Some(file_scope),
        node_file(state, receiver_node),
        node_start(state, receiver_node),
        node_end(state, receiver_node),
    );
    let parameters: Vec[go_types::TypeParameter] = Vec::new();
    for index in 0..nodes.len() {
        let node = nodes[index];
        let name = identifier(state, node).unwrap_or("");
        let object = go_types::add_object(
            state.world,
            go_types::ObjectKind::TypeName,
            name,
            Option::Some(state.package_id),
            node_file(state, node),
            Option::Some(node),
            node_start(state, node),
            state.world.invalid,
        );
        let type_id = go_types::add_type(
            state.world,
            go_types::TypeKind::TypeParam { object, constraint: state.world.invalid, index },
        );
        let _ = go_types::set_object_type(state.world, object, type_id);
        record_type_expression(state, node, type_id);
        record_use(state, node, object);
        if name == "_" {
            state.info.defs.push(ObjectFact { node, object: Option::Some(object) })
        } else {
            match go_types::insert(state.world, scope, name, object) {
                Some(_) => {},
                None => state.info.defs.push(ObjectFact { node, object: Option::Some(object) }),
            }
        }
        parameters.push(
            go_types::TypeParameter { object, constraint: state.world.invalid, grouped: false },
        )
    };
    (scope, parameters)
}

fn resolve_receiver(
    state: CheckState,
    file_scope: go_types::ScopeId,
    receiver_node: syntax::NodeId,
    receiver_type_node: syntax::NodeId,
) -> Option[ReceiverResolution] {
    let parts = receiver_type_parts(state, receiver_type_node);
    if !parts.1.is_empty() && !go_version_at_least(state, parts.0, 18) {
        diagnostic(state, parts.0, "type instantiation requires go1.18 or later", false)
    }
    let declared_origin = match identifier(state, parts.0) {
        Some(name) => match go_types::lookup(state.world, file_scope, name) {
            Some(object) => match go_types::get_object(state.world, object) {
                Some(object) => if object.kind == go_types::ObjectKind::TypeName {
                    Option::Some(object.type_id)
                } else {
                    Option::None
                },
                None => Option::None,
            },
            None => Option::None,
        },
        None => Option::None,
    };
    let origin = match unresolved_receiver_origin(state, file_scope, parts.0) {
        Some(value) => value,
        None => {
            state.generic_type_origin_depth += 1;
            let value = resolve_type(state, file_scope, parts.0);
            state.generic_type_origin_depth -= 1;
            value
        },
    };
    match go_types::get_type(state.world, origin) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Alias { object, rhs: _, type_params: _, type_args: _ },
        }) => {
            let _ = evaluate_type_object(state, object);
        },
        _ => {},
    }
    let diagnostic_origin = if origin.value == state.world.invalid.value {
        declared_origin.unwrap_or(origin)
    } else {
        origin
    };
    let origin_parameters = generic_parameters(state, diagnostic_origin);
    let invalid_alias_origin = match go_types::get_type(state.world, origin) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Alias { object: _, rhs: _, type_params: _, type_args: _ },
        }) => type_contains_invalid(state, origin),
        _ => false,
    };
    if origin.value == state.world.invalid.value
        || go_types::unalias(state.world, origin).value == state.world.invalid.value
        || invalid_alias_origin {
        if parts.1.is_empty() && !origin_parameters.is_empty() {
            diagnostic(
                state,
                receiver_type_node,
                "cannot use generic type " + diagnostic_type_string(state, diagnostic_origin)
                    + " without instantiation",
                false,
            );
            record_type_expression(state, parts.0, diagnostic_origin)
        }
        for index in 0..parts.1.len() {
            let name = identifier(state, parts.1[index]).unwrap_or("");
            if name != "_" {
                for previous in 0..index {
                    if identifier(state, parts.1[previous]).unwrap_or("") == name {
                        diagnostic(state, parts.1[index], name + " redeclared in this block", false);
                        secondary_diagnostic(
                            state,
                            parts.1[previous],
                            "\tother declaration of " + name,
                        )
                    }
                }
            }
        }
        let recovered_alias = match go_types::get_type(state.world, origin) {
            Some(go_types::TypeData {
                id: _,
                kind: go_types::TypeKind::Alias { object: _, rhs: _, type_params: _, type_args: _ },
            }) => true,
            _ => false,
        };
        let receiver_type = if invalid_alias_origin && !parts.1.is_empty() {
            state.world.invalid
        } else if recovered_alias && parts.2 {
            go_types::add_type(state.world, go_types::TypeKind::Pointer { element: origin })
        } else if recovered_alias {
            origin
        } else {
            state.world.invalid
        };
        record_receiver_type_syntax(state, receiver_type_node, receiver_type);
        let recovered_parameters = if invalid_alias_origin && !parts.1.is_empty() {
            recover_invalid_receiver_parameters(state, file_scope, receiver_node, parts.1)
        } else {
            (file_scope, Vec::new())
        };
        if invalid_alias_origin && !parts.1.is_empty() {
            omit_incomplete_method_receiver_facts(state, receiver_type_node)
        }
        return Option::Some(
            ReceiverResolution {
                receiver_type,
                base: if parts.1.is_empty() && !origin_parameters.is_empty() {
                    diagnostic_origin
                } else {
                    state.world.invalid
                },
                scope: recovered_parameters.0,
                type_params: recovered_parameters.1,
            },
        )
    }
    let instantiated_alias = receiver_instantiated_target(state, origin);
    if parts.1.is_empty() && instantiated_alias.is_some() {
        let receiver_type = if parts.2 {
            go_types::add_type(state.world, go_types::TypeKind::Pointer { element: origin })
        } else {
            origin
        };
        record_receiver_type_syntax(state, receiver_type_node, receiver_type);
        diagnostic(
            state,
            parts.0,
            "cannot define new methods on instantiated type "
                + diagnostic_type_string(state, instantiated_alias.unwrap_or(state.world.invalid)),
            false,
        );
        return Option::Some(
            ReceiverResolution {
                receiver_type: state.world.invalid,
                base: state.world.invalid,
                scope: file_scope,
                type_params: Vec::new(),
            },
        )
    }
    if parts.1.is_empty() {
        if !origin_parameters.is_empty() {
            diagnostic(
                state,
                receiver_type_node,
                "cannot use generic type " + diagnostic_type_string(state, origin)
                    + " without instantiation",
                false,
            );
            record_invalid_type_expression(state, receiver_type_node);
            return Option::Some(
                ReceiverResolution {
                    receiver_type: state.world.invalid,
                    base: origin,
                    scope: file_scope,
                    type_params: Vec::new(),
                },
            )
        }
        let receiver_type = if parts.2 {
            go_types::add_type(state.world, go_types::TypeKind::Pointer { element: origin })
        } else {
            origin
        };
        record_receiver_type_syntax(state, receiver_type_node, receiver_type);
        return match receiver_base(state, receiver_type) {
            Some(base) => Option::Some(
                ReceiverResolution {
                    receiver_type,
                    base,
                    scope: file_scope,
                    type_params: Vec::new(),
                },
            ),
            None => Option::Some(
                ReceiverResolution {
                    receiver_type,
                    base: state.world.invalid,
                    scope: file_scope,
                    type_params: Vec::new(),
                },
            ),
        }
    } else if match go_types::get_type(state.world, origin) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Alias { object: _, rhs: _, type_params, type_args: _ },
        }) => !type_params.is_empty(),
        _ => false,
    } {
        diagnostic(
            state,
            parts.0,
            "cannot define new methods on generic alias type "
                + diagnostic_type_string(state, origin),
            false,
        );
        let recovered = recover_invalid_receiver_parameters(
            state,
            file_scope,
            receiver_node,
            parts.1,
        );
        return Option::Some(
            ReceiverResolution {
                receiver_type: state.world.invalid,
                base: state.world.invalid,
                scope: recovered.0,
                type_params: recovered.1,
            },
        )
    } else if origin_parameters.is_empty() && !parts.1.is_empty() {
        diagnostic(
            state,
            parts.0,
            diagnostic_type_string(state, origin) + " is not a generic type",
            false,
        );
        let receiver_scope = go_types::add_scope(
            state.world,
            go_types::ScopeKind::Block,
            Option::Some(file_scope),
            node_file(state, receiver_node),
            node_start(state, receiver_node),
            node_end(state, receiver_node),
        );
        let receiver_parameters: Vec[go_types::TypeParameter] = Vec::new();
        for index in 0..parts.1.len() {
            let name_node = parts.1[index];
            let name = identifier(state, name_node).unwrap_or("");
            let constraint = state.world.invalid;
            let object = go_types::add_object(
                state.world,
                go_types::ObjectKind::TypeName,
                name,
                Option::Some(state.package_id),
                node_file(state, name_node),
                Option::Some(name_node),
                node_start(state, name_node),
                state.world.invalid,
            );
            let type_id = go_types::add_type(
                state.world,
                go_types::TypeKind::TypeParam { object, constraint, index },
            );
            let _ = go_types::set_object_type(state.world, object, type_id);
            record_type_expression(state, name_node, type_id);
            record_use(state, name_node, object);
            if name == "_" {
                state.info.defs.push(ObjectFact { node: name_node, object: Option::Some(object) })
            } else {
                match go_types::insert(state.world, receiver_scope, name, object) {
                    Some(_) => {},
                    None => state.info.defs.push(
                        ObjectFact { node: name_node, object: Option::Some(object) },
                    ),
                }
            }
            receiver_parameters.push(go_types::TypeParameter { object, constraint, grouped: false })
        }
        record_invalid_type_expression(state, parts.0);
        return Option::Some(
            ReceiverResolution {
                receiver_type: state.world.invalid,
                base: origin,
                scope: receiver_scope,
                type_params: receiver_parameters,
            },
        )
    }
    let receiver_arity_mismatch = origin_parameters.len() != parts.1.len();
    if receiver_arity_mismatch {
        let parameter_text = if parts.1.len() == 1 {
            "type parameter"
        } else {
            "type parameters"
        };
        diagnostic(
            state,
            receiver_type_node,
            f"receiver declares {parts.1.len()} {parameter_text}, but receiver base type declares {origin_parameters.len()}",
            false,
        )
    }
    let receiver_scope = go_types::add_scope(
        state.world,
        go_types::ScopeKind::Block,
        Option::Some(file_scope),
        node_file(state, receiver_node),
        node_start(state, receiver_node),
        node_end(state, receiver_node),
    );
    let receiver_parameters: Vec[go_types::TypeParameter] = Vec::new();
    let receiver_arguments: Vec[go_types::TypeId] = Vec::new();
    for index in 0..parts.1.len() {
        let name_node = parts.1[index];
        let mut name = identifier(state, name_node).unwrap_or("");
        let synthetic = name == "";
        if synthetic {
            diagnostic(
                state,
                name_node,
                "receiver type parameter " + expression_source_text(state, name_node)
                    + " must be an identifier",
                false,
            );
            name = "_";
        }
        let info_node = if synthetic {
            match syntax::get_node(state.syntax.arena, name_node) {
                Some(source) => {
                    let id = syntax::node_id(state.syntax.arena.nodes.len());
                    state.syntax.arena.nodes.push(
                        syntax::SyntaxNode {
                            id,
                            file: source.file,
                            span: source.span,
                            path: syntax::text_path(
                                f"$unknown[*ast.Ident:{node_start(state, name_node)}:{node_start(state, name_node) + 1}]",
                            ),
                            kind: syntax::SyntaxKind::Ident {
                                name_pos: node_start(state, name_node),
                                name,
                            },
                        },
                    );
                    id
                },
                None => name_node,
            }
        } else {
            name_node
        };
        let object = go_types::add_object(
            state.world,
            go_types::ObjectKind::TypeName,
            name,
            Option::Some(state.package_id),
            node_file(state, info_node),
            Option::Some(info_node),
            node_start(state, info_node),
            state.world.invalid,
        );
        let constraint = if !receiver_arity_mismatch && index < origin_parameters.len() {
            origin_parameters[index].constraint
        } else {
            state.world.invalid
        };
        let type_id = go_types::add_type(
            state.world,
            go_types::TypeKind::TypeParam { object, constraint, index },
        );
        let _ = go_types::set_object_type(state.world, object, type_id);
        record_type_expression(state, info_node, type_id);
        record_use(state, info_node, object);
        if name == "_" {
            state.info.defs.push(ObjectFact { node: info_node, object: Option::Some(object) })
        } else {
            match go_types::insert(state.world, receiver_scope, name, object) {
                Some(existing) => {
                    diagnostic(state, name_node, name + " redeclared in this block", false);
                    match go_types::get_object(state.world, existing) {
                        Some(existing) => match existing.node {
                            Some(existing) => secondary_diagnostic(
                                state,
                                existing,
                                "\tother declaration of " + name,
                            ),
                            None => {},
                        },
                        None => {},
                    }
                },
                None => state.info.defs.push(
                    ObjectFact { node: info_node, object: Option::Some(object) },
                ),
            }
        }
        receiver_arguments.push(type_id);
        receiver_parameters.push(
            go_types::TypeParameter {
                object,
                constraint,
                grouped: if !receiver_arity_mismatch && index < origin_parameters.len() {
                    origin_parameters[index].grouped
                } else {
                    false
                },
            },
        )
    }
    for index in 0..receiver_parameters.len() {
        let constraint = go_types::substitute(
            state.world,
            receiver_parameters[index].constraint,
            origin_parameters,
            receiver_arguments,
        );
        receiver_parameters[index] = go_types::TypeParameter {
            object: receiver_parameters[index].object,
            constraint,
            grouped: receiver_parameters[index].grouped,
        };
        let _ = go_types::set_type(
            state.world,
            receiver_arguments[index],
            go_types::TypeKind::TypeParam {
                object: receiver_parameters[index].object,
                constraint,
                index,
            },
        );
    }
    let instantiated = go_types::instantiate_receiver(state.world, origin, receiver_arguments).unwrap_or(
        state.world.invalid,
    );
    record_instance(
        state,
        InstanceFact { node: parts.0, type_args: receiver_arguments, type_id: instantiated },
    );
    let receiver_type = if parts.2 {
        go_types::add_type(state.world, go_types::TypeKind::Pointer { element: instantiated })
    } else {
        instantiated
    };
    record_receiver_type_syntax(state, receiver_type_node, receiver_type);
    Option::Some(
        ReceiverResolution {
            receiver_type,
            base: origin,
            scope: receiver_scope,
            type_params: receiver_parameters,
        },
    )
}

fn receiver_field(state: CheckState, node: syntax::NodeId) -> Option[
    (Option[syntax::NodeId], syntax::NodeId),
] {
    let fields = field_list_nodes(state, node);
    if fields.is_empty() {
        return Option::None
    }
    if fields.len() > 1 {
        diagnostic(state, fields[fields.len() - 1], "method has multiple receivers", false);
    }
    match field_data(state, fields[0]) {
        Some((names, type_node, _)) => Option::Some(
            (
                if names.is_empty() {
                    Option::None
                } else {
                    Option::Some(names[0])
                },
                type_node,
            ),
        ),
        None => Option::None,
    }
}

fn invalid_receiver_cardinality_after_resolution(state: CheckState, node: syntax::NodeId) -> bool {
    let fields = field_list_nodes(state, node);
    if fields.len() > 1 {
        true
    } else if fields.len() == 1 {
        match field_data(state, fields[0]) {
            Some((names, _, _)) => if names.len() > 1 {
                diagnostic(state, names[names.len() - 1], "method has multiple receivers", false);
                true
            } else {
                false
            },
            None => false,
        }
    } else {
        true
    }
}

fn defer_receiver_validation(state: CheckState, node: syntax::NodeId) -> () {
    let base_node = receiver_type_parts(state, node).0;
    for existing in state.receiver_validation_nodes {
        if existing.value == base_node.value {
            return
        }
    }
    state.receiver_validation_nodes.push(base_node)
}

fn receiver_declared_base(state: CheckState, type_id: go_types::TypeId) -> go_types::TypeId {
    let resolved = go_types::unalias(state.world, type_id);
    match go_types::get_type(state.world, resolved) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) => go_types::unalias(
            state.world,
            element,
        ),
        _ => resolved,
    }
}

fn receiver_may_declare_method(state: CheckState, node: syntax::NodeId) -> bool {
    let base_node = receiver_type_parts(state, node).0;
    let type_id = match recorded_type_fact(state, base_node) {
        Some(fact) => fact.type_id,
        None => return false,
    };
    let resolved = receiver_declared_base(state, type_id);
    match go_types::get_type(state.world, resolved) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object,
                underlying: _,
                type_params: _,
                type_args: _,
                methods: _,
            },
        }) => {
            let local = match go_types::get_object(state.world, object) {
                Some(object) => match object.owner {
                    Some(owner) => owner.value == state.package_id.value,
                    None => false,
                },
                None => false,
            };
            if !local {
                return false
            }
            match go_types::get_type(state.world, go_types::underlying(state.world, resolved)) {
                Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element: _ } }) | Some(go_types::TypeData {
                    id: _,
                    kind: go_types::TypeKind::Interface {
                        methods: _,
                        embeddeds: _,
                        comparable: _,
                        implicit: _,
                    },
                }) | Some(go_types::TypeData {
                    id: _,
                    kind: go_types::TypeKind::Basic {
                        basic: go_types::BasicKind::UnsafePointer,
                        name: _,
                        untyped: _,
                    },
                }) => false,
                _ => true,
            }
        },
        _ => false,
    }
}

fn check_receiver_validation(state: CheckState, node: syntax::NodeId) -> () {
    let type_id = match recorded_type_fact(state, node) {
        Some(fact) => fact.type_id,
        None => return,
    };
    let resolved = receiver_declared_base(state, type_id);
    match go_types::get_type(state.world, resolved) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Invalid }) => return,
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Basic { basic: _, name: _, untyped: _ },
        }) => diagnostic(
            state,
            node,
            "cannot define new methods on non-local type " + diagnostic_type_string(state, type_id),
            false,
        ),
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object,
                underlying: _,
                type_params: _,
                type_args: _,
                methods: _,
            },
        }) => {
            let local = match go_types::get_object(state.world, object) {
                Some(object) => match object.owner {
                    Some(owner) => owner.value == state.package_id.value,
                    None => false,
                },
                None => false,
            };
            if !local {
                diagnostic(
                    state,
                    node,
                    "cannot define new methods on non-local type "
                        + diagnostic_type_string(state, type_id),
                    false,
                )
            } else {
                let underlying = go_types::underlying(state.world, resolved);
                match go_types::get_type(state.world, underlying) {
                    Some(go_types::TypeData {
                        id: _,
                        kind: go_types::TypeKind::Pointer { element: _ },
                    }) | Some(go_types::TypeData {
                        id: _,
                        kind: go_types::TypeKind::Interface {
                            methods: _,
                            embeddeds: _,
                            comparable: _,
                            implicit: _,
                        },
                    }) => diagnostic(
                        state,
                        node,
                        "invalid receiver type " + diagnostic_type_string(state, type_id)
                            + " (pointer or interface type)",
                        false,
                    ),
                    Some(go_types::TypeData {
                        id: _,
                        kind: go_types::TypeKind::Basic {
                            basic: go_types::BasicKind::UnsafePointer,
                            name: _,
                            untyped: _,
                        },
                    }) => diagnostic(
                        state,
                        node,
                        "invalid receiver type " + diagnostic_type_string(state, type_id)
                            + " (unsafe.Pointer)",
                        false,
                    ),
                    _ => {},
                }
            }
        },
        _ => diagnostic(
            state,
            node,
            "invalid receiver type " + diagnostic_type_string(state, type_id),
            false,
        ),
    }
}

fn check_receiver_validations(state: CheckState) -> () {
    for node in state.receiver_validation_nodes {
        check_receiver_validation(state, node)
    }
}

fn check_field_method_collisions(state: CheckState) -> () {
    for type_id in state.deferred_type_validations {
        let methods = match go_types::type_data(state.world, type_id) {
            go_types::TypeData {
                id: _,
                kind: go_types::TypeKind::Named {
                    object: _,
                    underlying: _,
                    type_params: _,
                    type_args: _,
                    methods,
                },
            } => methods,
            _ => Vec::new(),
        };
        let fields = match go_types::type_data(
            state.world,
            go_types::underlying(state.world, type_id),
        ) {
            go_types::TypeData { id: _, kind: go_types::TypeKind::Struct { fields } } => fields,
            _ => Vec::new(),
        };
        for method in methods {
            match go_types::get_object(state.world, method) {
                Some(method) => if method.name != "_" {
                    for field in fields {
                        match field.object {
                            Some(field_object) => match go_types::get_object(
                                state.world,
                                field_object,
                            ) {
                                Some(field_object) => if field.variable.name == method.name {
                                    match method.node {
                                        Some(node) => diagnostic(
                                            state,
                                            node,
                                            "field and method with the same name " + method.name,
                                            false,
                                        ),
                                        None => {},
                                    }
                                    match field_object.node {
                                        Some(node) => secondary_diagnostic(
                                            state,
                                            node,
                                            "\tother declaration of " + method.name,
                                        ),
                                        None => {},
                                    }
                                },
                                None => {},
                            },
                            None => {},
                        }
                    }
                },
                None => {},
            }
        }
    }
}

fn check_missing_method_receiver(state: CheckState, node: syntax::NodeId) -> () {
    if field_list_nodes(state, node).is_empty() {
        diagnostic(state, node, "method has no receiver", false)
    }
}

fn empty_method_signature(state: CheckState, receiver_name: string, resolution: ReceiverResolution) -> go_types::TypeId {
    let empty = go_types::add_type(state.world, go_types::TypeKind::Tuple { variables: Vec::new() });
    go_types::add_type(
        state.world,
        go_types::TypeKind::Signature {
            receiver: Option::Some(
                go_types::Variable {
                    name: receiver_name,
                    owner: Option::Some(state.package_id),
                    type_id: resolution.receiver_type,
                },
            ),
            receiver_type_params: resolution.type_params,
            type_params: Vec::new(),
            params: empty,
            results: empty,
            variadic: false,
        },
    )
}

fn record_implicit_receiver(
    state: CheckState,
    receiver_node: syntax::NodeId,
    receiver_type: go_types::TypeId,
) -> () {
    let fields = field_list_nodes(state, receiver_node);
    if !fields.is_empty() {
        let object = go_types::add_object(
            state.world,
            go_types::ObjectKind::Var,
            "",
            Option::Some(state.package_id),
            node_file(state, fields[0]),
            Option::Some(fields[0]),
            node_start(state, fields[0]),
            receiver_type,
        );
        state.info.implicits.push(ObjectFact { node: fields[0], object: Option::Some(object) })
    }
}

fn predeclare_method_declaration(
    state: CheckState,
    file_scope: go_types::ScopeId,
    receiver_node: syntax::NodeId,
    name_node: syntax::NodeId,
    type_node: syntax::NodeId,
) -> () {
    match receiver_field(state, receiver_node) {
        Some((receiver_name_node, receiver_type_node)) => match resolve_receiver(
            state,
            file_scope,
            receiver_node,
            receiver_type_node,
        ) {
            Some(resolution) => {
                let method_name = identifier(state, name_node).unwrap_or("");
                let invalid_cardinality = invalid_receiver_cardinality_after_resolution(
                    state,
                    receiver_node,
                );
                if !invalid_cardinality
                    && resolution.receiver_type.value != state.world.invalid.value {
                    defer_receiver_validation(state, receiver_type_node)
                }
                let can_declare = !invalid_cardinality
                    && (receiver_may_declare_method(state, receiver_type_node)
                        || (resolution.receiver_type.value == state.world.invalid.value
                            && resolution.base.value != state.world.invalid.value));
                let duplicate = if can_declare && resolution.base.value != state.world.invalid.value {
                    match existing_method(state, resolution.base, method_name) {
                        Some(existing) => {
                            duplicate_method_diagnostic(
                                state,
                                name_node,
                                resolution.base,
                                method_name,
                                existing,
                            );
                            true
                        },
                        None => false,
                    }
                } else {
                    false
                };
                let receiver_name = match receiver_name_node {
                    Some(value) => identifier(state, value).unwrap_or(""),
                    None => "",
                };
                let method_resolution = if invalid_cardinality {
                    ReceiverResolution {
                        receiver_type: state.world.invalid,
                        base: state.world.invalid,
                        scope: file_scope,
                        type_params: Vec::new(),
                    }
                } else {
                    resolution
                };
                let placeholder = empty_method_signature(state, receiver_name, method_resolution);
                let method = go_types::add_object(
                    state.world,
                    go_types::ObjectKind::Func,
                    method_name,
                    Option::Some(state.package_id),
                    node_file(state, name_node),
                    Option::Some(name_node),
                    node_start(state, name_node),
                    placeholder,
                );
                state.info.defs.push(ObjectFact { node: name_node, object: Option::Some(method) });
                save_declared_object(state, name_node, Option::Some(method));
                if can_declare && !duplicate {
                    add_named_method(state, resolution.base, method)
                }
                if receiver_name_node.is_none() {
                    record_implicit_receiver(state, receiver_node, method_resolution.receiver_type)
                }
                state.pending_methods.push(
                    PendingMethod {
                        object: method,
                        placeholder,
                        file_scope,
                        receiver_node,
                        receiver_name_node,
                        type_node,
                        resolution: method_resolution,
                    },
                )
            },
            None => if !invalid_receiver_cardinality_after_resolution(state, receiver_node) {
                defer_receiver_validation(state, receiver_type_node)
            },
        },
        None => if field_list_nodes(state, receiver_node).is_empty() {
            let signature = resolve_method_signature(state, file_scope, type_node);
            let method = go_types::add_object(
                state.world,
                go_types::ObjectKind::Func,
                identifier(state, name_node).unwrap_or(""),
                Option::Some(state.package_id),
                node_file(state, name_node),
                Option::Some(name_node),
                node_start(state, name_node),
                signature,
            );
            state.info.defs.push(ObjectFact { node: name_node, object: Option::Some(method) });
            save_declared_object(state, name_node, Option::Some(method))
        },
    }
}

fn complete_method_declarations(state: CheckState) -> () {
    for pending in state.pending_methods {
        let diagnostic_parameters = generic_parameters(state, pending.resolution.base);
        state.active_instantiations.push(
            ActiveInstantiation {
                origin: pending.resolution.base,
                parameters: pending.resolution.type_params,
                diagnostic_parameters,
            },
        );
        let signature = resolve_method_signature(state, pending.resolution.scope, pending.type_node);
        discard_method_type_parameters(state, signature);
        let _ = state.active_instantiations.pop();
        if pending.resolution.scope.value != pending.file_scope.value {
            match signature_scope(state, pending.type_node) {
                Some(scope) => {
                    for entry in state.world.scopes[pending.resolution.scope.value].entries {
                        let _ = go_types::insert(state.world, scope, entry.name, entry.object);
                    }
                    let _ = go_types::set_scope_parent(state.world, scope, pending.file_scope);
                },
                None => {},
            }
        }
        let receiver_name = match pending.receiver_name_node {
            Some(value) => identifier(state, value).unwrap_or(""),
            None => "",
        };
        set_signature_receiver(
            state,
            signature,
            go_types::Variable {
                name: receiver_name,
                owner: Option::Some(state.package_id),
                type_id: pending.resolution.receiver_type,
            },
            pending.resolution.type_params,
        );
        match (pending.receiver_name_node, signature_scope(state, pending.type_node)) {
            (Some(receiver_name_node), Some(scope)) => add_parameter(
                state,
                scope,
                receiver_name_node,
                receiver_name,
                pending.resolution.receiver_type,
            ),
            _ => {},
        }
        match go_types::get_type(state.world, signature) {
            Some(value) => {
                let _ = go_types::set_type(state.world, pending.placeholder, value.kind);
            },
            None => {},
        }
    }
}

fn check_method_declaration(
    state: CheckState,
    file_scope: go_types::ScopeId,
    receiver_node: syntax::NodeId,
    name_node: syntax::NodeId,
    type_node: syntax::NodeId,
) -> () {
    match receiver_field(state, receiver_node) {
        Some((receiver_name_node, receiver_type_node)) => {
            match resolve_receiver(state, file_scope, receiver_node, receiver_type_node) {
                Some(resolution) => {
                    let method_name = identifier(state, name_node).unwrap_or("");
                    let invalid_cardinality = invalid_receiver_cardinality_after_resolution(
                        state,
                        receiver_node,
                    );
                    if !invalid_cardinality
                        && resolution.receiver_type.value != state.world.invalid.value {
                        defer_receiver_validation(state, receiver_type_node)
                    }
                    if invalid_cardinality {} else if !receiver_may_declare_method(
                        state,
                        receiver_type_node,
                    ) {} else if resolution.base.value == state.world.invalid.value {} else if match existing_method(
                        state,
                        resolution.base,
                        method_name,
                    ) {
                        Some(existing) => {
                            duplicate_method_diagnostic(
                                state,
                                name_node,
                                resolution.base,
                                method_name,
                                existing,
                            );
                            true
                        },
                        None => false,
                    } {} else {
                        let signature = resolve_method_signature(state, resolution.scope, type_node);
                        if resolution.scope.value != file_scope.value {
                            match signature_scope(state, type_node) {
                                Some(scope) => {
                                    for entry in state.world.scopes[resolution.scope.value].entries {
                                        let _ = go_types::insert(
                                            state.world,
                                            scope,
                                            entry.name,
                                            entry.object,
                                        );
                                    }
                                    let _ = go_types::set_scope_parent(
                                        state.world,
                                        scope,
                                        file_scope,
                                    );
                                },
                                None => {},
                            }
                        }
                        let receiver_name = match receiver_name_node {
                            Some(value) => identifier(state, value).unwrap_or(""),
                            None => "",
                        };
                        let receiver = go_types::Variable {
                            name: receiver_name,
                            owner: Option::Some(state.package_id),
                            type_id: resolution.receiver_type,
                        };
                        set_signature_receiver(state, signature, receiver, resolution.type_params);
                        if receiver_name_node.is_none() {
                            let fields = field_list_nodes(state, receiver_node);
                            if !fields.is_empty() {
                                let object = go_types::add_object(
                                    state.world,
                                    go_types::ObjectKind::Var,
                                    "",
                                    Option::Some(state.package_id),
                                    node_file(state, fields[0]),
                                    Option::Some(fields[0]),
                                    node_start(state, fields[0]),
                                    resolution.receiver_type,
                                );
                                state.info.implicits.push(
                                    ObjectFact { node: fields[0], object: Option::Some(object) },
                                )
                            }
                        }
                        match (receiver_name_node, signature_scope(state, type_node)) {
                            (Some(receiver_name_node), Some(scope)) => add_parameter(
                                state,
                                scope,
                                receiver_name_node,
                                receiver_name,
                                resolution.receiver_type,
                            ),
                            _ => {},
                        }
                        let method = go_types::add_object(
                            state.world,
                            go_types::ObjectKind::Func,
                            method_name,
                            Option::Some(state.package_id),
                            node_file(state, name_node),
                            Option::Some(name_node),
                            node_start(state, name_node),
                            signature,
                        );
                        state.info.defs.push(
                            ObjectFact { node: name_node, object: Option::Some(method) },
                        );
                        save_declared_object(state, name_node, Option::Some(method));
                        add_named_method(state, resolution.base, method);
                    }
                },
                None => if !invalid_receiver_cardinality_after_resolution(state, receiver_node) {
                    defer_receiver_validation(state, receiver_type_node)
                },
            }
        },
        None => {},
    }
}
