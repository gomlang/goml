package checker;

const LEN_BUILTIN: string = "len";

const CAP_BUILTIN: string = "cap";

const NEW_BUILTIN: string = "new";

const MAKE_BUILTIN: string = "make";

const APPEND_BUILTIN: string = "append";

const DELETE_BUILTIN: string = "delete";

const CLEAR_BUILTIN: string = "clear";

const CLOSE_BUILTIN: string = "close";

const COPY_BUILTIN: string = "copy";

const COMPLEX_BUILTIN: string = "complex";

const REAL_BUILTIN: string = "real";

const IMAG_BUILTIN: string = "imag";

const MIN_BUILTIN: string = "min";

const MAX_BUILTIN: string = "max";

const PRINT_BUILTIN: string = "print";

const PRINTLN_BUILTIN: string = "println";

const PANIC_BUILTIN: string = "panic";

const RECOVER_BUILTIN: string = "recover";

const UNSAFE_SIZEOF_BUILTIN: string = "Sizeof";

const UNSAFE_ALIGNOF_BUILTIN: string = "Alignof";

const UNSAFE_OFFSETOF_BUILTIN: string = "Offsetof";

const UNSAFE_ADD_BUILTIN: string = "Add";

const UNSAFE_SLICE_BUILTIN: string = "Slice";

const UNSAFE_SLICE_DATA_BUILTIN: string = "SliceData";

const UNSAFE_STRING_BUILTIN: string = "String";

const UNSAFE_STRING_DATA_BUILTIN: string = "StringData";

const ADD_OPERATOR: string = "+";

const SUBTRACT_OPERATOR: string = "-";

const MULTIPLY_OPERATOR: string = "*";

const DIVIDE_OPERATOR: string = "/";

const REMAINDER_OPERATOR: string = "%";

const BIT_AND_OPERATOR: string = "&";

const BIT_AND_NOT_OPERATOR: string = "&^";

const BIT_OR_OPERATOR: string = "|";

const BIT_XOR_OPERATOR: string = "^";

const SHIFT_LEFT_OPERATOR: string = "<<";

const SHIFT_RIGHT_OPERATOR: string = ">>";

const LOGICAL_AND_OPERATOR: string = "&&";

const LOGICAL_OR_OPERATOR: string = "||";

const EQUAL_OPERATOR: string = "==";

const NOT_EQUAL_OPERATOR: string = "!=";

const LESS_OPERATOR: string = "<";

const LESS_EQUAL_OPERATOR: string = "<=";

const GREATER_OPERATOR: string = ">";

const GREATER_EQUAL_OPERATOR: string = ">=";

const LOGICAL_NOT_OPERATOR: string = "!";

const TILDE_OPERATOR: string = "~";

const RECEIVE_OPERATOR: string = "<-";

const ASSIGN_OPERATOR: string = "=";

const DEFINE_OPERATOR: string = ":=";

const VAR_KEYWORD: string = "var";

const CONST_KEYWORD: string = "const";

const TYPE_KEYWORD: string = "type";

const IMPORT_KEYWORD: string = "import";

const BREAK_KEYWORD: string = "break";

const CONTINUE_KEYWORD: string = "continue";

const GOTO_KEYWORD: string = "goto";

const FALLTHROUGH_KEYWORD: string = "fallthrough";

const INT_LITERAL_TOKEN: string = "INT";

const FLOAT_LITERAL_TOKEN: string = "FLOAT";

const IMAG_LITERAL_TOKEN: string = "IMAG";

const CHAR_LITERAL_TOKEN: string = "CHAR";

const STRING_LITERAL_TOKEN: string = "STRING";

fn shift_operator(value: string) -> bool {
    match value {
        SHIFT_LEFT_OPERATOR | SHIFT_RIGHT_OPERATOR => true,
        _ => false,
    }
}

fn equality_operator(value: string) -> bool {
    match value {
        EQUAL_OPERATOR | NOT_EQUAL_OPERATOR => true,
        _ => false,
    }
}

fn comparison_operator(value: string) -> bool {
    match value {
        EQUAL_OPERATOR | NOT_EQUAL_OPERATOR | LESS_OPERATOR | LESS_EQUAL_OPERATOR | GREATER_OPERATOR | GREATER_EQUAL_OPERATOR => true,
        _ => false,
    }
}

fn logical_operator(value: string) -> bool {
    match value {
        LOGICAL_AND_OPERATOR | LOGICAL_OR_OPERATOR => true,
        _ => false,
    }
}

fn value_declaration_keyword(value: string) -> bool {
    match value {
        VAR_KEYWORD | CONST_KEYWORD => true,
        _ => false,
    }
}

fn assignment_operator(value: string) -> bool {
    match value {
        ASSIGN_OPERATOR | DEFINE_OPERATOR => true,
        _ => false,
    }
}

fn numeric_literal_token(value: string) -> bool {
    match value {
        INT_LITERAL_TOKEN | FLOAT_LITERAL_TOKEN | IMAG_LITERAL_TOKEN => true,
        _ => false,
    }
}

fn floating_literal_token(value: string) -> bool {
    match value {
        FLOAT_LITERAL_TOKEN | IMAG_LITERAL_TOKEN => true,
        _ => false,
    }
}
