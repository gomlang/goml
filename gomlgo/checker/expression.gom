package checker;

use gomlgo::constant;
use gomlgo::syntax;
use gomlgo::types as go_types;
use std::num;
use std::unicode;

fn key_value_nodes(state: CheckState, node: syntax::NodeId) -> Option[
    (syntax::NodeId, syntax::NodeId),
] {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::KeyValueExpr { key, colon: _, value }) => Option::Some(
            (key, value),
        ),
        _ => Option::None,
    }
}

fn struct_field_by_name(fields: Vec[go_types::StructField], name: string) -> Option[
    go_types::StructField,
] {
    for field in fields {
        if field.variable.name == name {
            return Option::Some(field)
        }
    }
    Option::None
}

fn similar_struct_field(state: CheckState, fields: Vec[go_types::StructField], name: string) -> Option[
    go_types::StructField,
] {
    for field in fields {
        match field.object {
            Some(object) => match go_types::get_object(state.world, object) {
                Some(object) => if similar_selector_object(state, object, name) {
                    return Option::Some(field)
                },
                None => {},
            },
            None => if unicode::lowercase(field.variable.name) == unicode::lowercase(name) {
                return Option::Some(field)
            },
        }
    }
    Option::None
}

fn unknown_struct_field_message(
    state: CheckState,
    literal_type: go_types::TypeId,
    fields: Vec[go_types::StructField],
    name: string,
) -> string {
    let base = "unknown field " + name + " in struct literal of type "
        + diagnostic_type_string(state, literal_type);
    match similar_struct_field(state, fields, name) {
        Some(field) => base + ", but does have "
            + if struct_field_accessible(state, field) {
                ""
            } else {
                "unexported "
            }
            + field.variable.name,
        None => base,
    }
}

fn check_composite_element(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    target: go_types::TypeId,
    context: string,
    allow_elided: bool,
) -> Operand {
    let operand = match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::CompositeLit {
            type_node: None,
            lbrace: _,
            elements,
            rbrace: _,
            incomplete: _,
        }) => if allow_elided {
            let element_target = match go_types::get_type(state.world, core_type_id(state, target)) {
                Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) => element,
                _ => target,
            };
            check_composite_literal_elements(state, scope, node, element_target, elements);
            if go_types::is_type_parameter(state.world, target)
                && core_type_id(state, target).value == state.world.invalid.value {
                let _ = state.omitted_type_fact_nodes.insert(node.value);
            } else if target.value == state.world.invalid.value {
                let _ = state.retained_invalid_type_fact_nodes.insert(node.value);
            }
            Operand { type_id: target, value: Option::None, addressable: false, assignable: false }
        } else {
            check_expression(state, scope, node)
        },
        _ => check_expression(state, scope, node),
    };
    record_operand(state, node, operand);
    update_contextual_operand_fact(state, node, operand, target);
    if operand.type_id.value == state.world.invalid.value {} else if !argument_assignable(
        state,
        operand,
        target,
    ) {
        let truncated = match operand.value {
            Some(_) => go_types::is_numeric(state.world, operand.type_id)
                && go_types::is_integer(state.world, target)
                && !go_types::is_integer(state.world, operand.type_id),
            None => false,
        };
        let implementation_detail = interface_implementation_detail(state, operand.type_id, target);
        diagnostic(
            state,
            node,
            "cannot use " + operand_string(state, node, operand) + " as "
                + diagnostic_type_string(state, target)
                + " value in "
                + context
                + if truncated {
                    " (truncated)"
                } else {
                    ""
                }
                + if implementation_detail == "" {
                    ""
                } else {
                    ": " + implementation_type_string(state, operand.type_id)
                        + " does not implement "
                        + implementation_type_string(state, target)
                        + " "
                        + implementation_detail
                },
            false,
        )
    }
    operand
}

fn check_invalid_composite_element(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
) -> () {
    match key_value_nodes(state, node) {
        Some((key, value)) => {
            match identifier(state, key) {
                Some(_) => {},
                None => check_invalid_composite_element(state, scope, key),
            }
            check_invalid_composite_element(state, scope, value)
        },
        None => match syntax::get_kind(state.syntax.arena, node) {
            Some(syntax::SyntaxKind::CompositeLit {
                type_node: None,
                lbrace: _,
                elements,
                rbrace: _,
                incomplete: _,
            }) => for element in elements {
                check_invalid_composite_element(state, scope, element)
            },
            _ => {
                let _ = check_expression(state, scope, node);
            },
        },
    }
}

fn check_composite_literal_elements(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    type_id: go_types::TypeId,
    elements: Vec[syntax::NodeId],
) -> () {
    let literal_type = type_id;
    if literal_type.value == state.world.invalid.value {
        for element in elements {
            check_invalid_composite_element(state, scope, element)
        }
        return
    }
    match go_types::type_data(state.world, core_type_id(state, literal_type)) {
        go_types::TypeData { id: _, kind: go_types::TypeKind::Struct { fields } } => check_struct_literal(
            state,
            scope,
            node,
            literal_type,
            fields,
            elements,
        ),
        go_types::TypeData { id: _, kind: go_types::TypeKind::Array { length, element } } => {
            let _ = check_sequence_literal(
                state,
                scope,
                node,
                element,
                Option::Some(length),
                elements,
            );
        },
        go_types::TypeData { id: _, kind: go_types::TypeKind::Slice { element } } => {
            let _ = check_sequence_literal(state, scope, node, element, Option::None, elements);
        },
        go_types::TypeData { id: _, kind: go_types::TypeKind::Map { key, value } } => check_map_literal(
            state,
            scope,
            node,
            key,
            value,
            elements,
        ),
        _ => if state.array_length_depth > 0 && !state.active_type_objects.is_empty() {
            for element in elements {
                match key_value_nodes(state, element) {
                    Some((_, value)) => check_invalid_composite_element(state, scope, value),
                    None => check_invalid_composite_element(state, scope, element),
                }
            }
            let object = state.active_type_objects[state.active_type_objects.len() - 1];
            if !invalid_type_object_seen(state, object) && !type_value_cycle_contains(state, object) {
                state.deferred_direct_type_cycles.push(object)
            }
        } else {
            let element_type = match syntax::get_kind(state.syntax.arena, node) {
                Some(syntax::SyntaxKind::CompositeLit {
                    type_node: None,
                    lbrace: _,
                    elements: _,
                    rbrace: _,
                    incomplete: _,
                }) => true,
                _ => false,
            };
            diagnostic(
                state,
                node,
                "invalid composite literal "
                    + if element_type {
                        "element type "
                    } else {
                        "type "
                    }
                    + diagnostic_type_string(state, literal_type)
                    + if go_types::is_type_parameter(state.world, literal_type)
                        && core_type_id(state, literal_type).value == state.world.invalid.value {
                        " (no common underlying type)"
                    } else {
                        ""
                    },
                false,
            )
        },
    }
}

fn composite_literal_rbrace(state: CheckState, node: syntax::NodeId) -> isize {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::CompositeLit {
            type_node: _,
            lbrace: _,
            elements: _,
            rbrace,
            incomplete: _,
        }) => rbrace,
        _ => node_start(state, node),
    }
}

fn struct_field_accessible(state: CheckState, field: go_types::StructField) -> bool {
    match field.object {
        Some(object) => {
            let index = checked_object_index(state, object);
            if index < 0 {
                true
            } else {
                let object = state.world.objects[index];
                object.exported
                    || match object.owner {
                        Some(owner) => owner.value == state.package_id.value,
                        None => true,
                    }
            }
        },
        None => true,
    }
}

fn check_struct_literal(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    literal_type: go_types::TypeId,
    fields: Vec[go_types::StructField],
    elements: Vec[syntax::NodeId],
) -> () {
    let mut keyed = false;
    let mut unkeyed = false;
    let mut mixed = false;
    let names: Vec[string] = Vec::new();
    for index in 0..elements.len() {
        match key_value_nodes(state, elements[index]) {
            Some((key, value)) => {
                if unkeyed && !mixed {
                    diagnostic(
                        state,
                        elements[index],
                        "mixture of field:value and value elements in struct literal",
                        false,
                    );
                    mixed = true;
                    continue
                }
                keyed = true;
                match identifier(state, key) {
                    Some(name) => match struct_field_by_name(fields, name) {
                        Some(field) => if struct_field_accessible(state, field) {
                            let mut duplicate = false;
                            for existing in names {
                                if existing == name {
                                    duplicate = true;
                                }
                            }
                            if duplicate {
                                diagnostic(
                                    state,
                                    key,
                                    "duplicate field name " + name + " in struct literal",
                                    false,
                                )
                            } else {
                                names.push(name)
                            }
                            match field.object {
                                Some(object) => if !incomplete_named_instance(state, literal_type) {
                                    record_use(state, key, object)
                                },
                                None => {},
                            }
                            let _ = check_composite_element(
                                state,
                                scope,
                                value,
                                field.variable.type_id,
                                "struct literal",
                                false,
                            );
                        } else {
                            diagnostic(
                                state,
                                key,
                                "cannot refer to unexported field " + name
                                    + " in struct literal of type "
                                    + diagnostic_type_string(state, literal_type),
                                false,
                            );
                            let _ = check_expression(state, scope, value);
                        },
                        _ => {
                            diagnostic(
                                state,
                                key,
                                unknown_struct_field_message(state, literal_type, fields, name),
                                false,
                            );
                            let _ = check_expression(state, scope, value);
                        },
                    },
                    None => {
                        diagnostic(
                            state,
                            key,
                            "invalid field name " + expression_source_text(state, key)
                                + " in struct literal",
                            false,
                        );
                        let _ = check_expression(state, scope, value);
                    },
                }
            },
            None => {
                if keyed && !mixed {
                    diagnostic(
                        state,
                        elements[index],
                        "mixture of field:value and value elements in struct literal",
                        false,
                    );
                    mixed = true;
                    continue
                }
                unkeyed = true;
                if index >= fields.len() {
                    diagnostic(
                        state,
                        elements[index],
                        "too many values in struct literal of type "
                            + diagnostic_type_string(state, literal_type),
                        false,
                    );
                    let _ = check_expression(state, scope, elements[index]);
                } else if !struct_field_accessible(state, fields[index]) {
                    diagnostic(
                        state,
                        elements[index],
                        "implicit assignment to unexported field " + fields[index].variable.name
                            + " in struct literal of type "
                            + diagnostic_type_string(state, literal_type),
                        false,
                    );
                    let _ = check_expression(state, scope, elements[index]);
                } else {
                    let _ = check_composite_element(
                        state,
                        scope,
                        elements[index],
                        fields[index].variable.type_id,
                        "struct literal",
                        false,
                    );
                }
            },
        }
    }
    if unkeyed && !keyed && elements.len() < fields.len() {
        diagnostic_at_position(
            state,
            node,
            composite_literal_rbrace(state, node),
            "too few values in struct literal of type "
                + diagnostic_type_string(state, literal_type),
            false,
        )
    }
}

fn constant_index(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    require_constant: bool,
) -> Option[isize] {
    let operand = check_expression(state, scope, node);
    if operand.type_id.value == state.world.invalid.value {
        return Option::None
    }
    match operand.value {
        Some(value) => if constant::constant_kind(value) == constant::ConstantKind::Unknown {
            if go_types::is_untyped(state.world, operand.type_id)
                && go_types::is_numeric(state.world, operand.type_id) {
                update_contextual_operand_fact(state, node, operand, basic_type_id(state, "int"));
            }
            Option::None
        } else {
            match constant::constant_to_integer(value) {
                Some(value) => {
                    let int_type = basic_type_id(state, "int");
                    update_contextual_operand_fact(state, node, operand, int_type);
                    match num::parse_int_structured(constant::integer_to_string(value)) {
                        Ok(value) => if value < 0 {
                            diagnostic(
                                state,
                                node,
                                "invalid argument: index "
                                    + operand_string(
                                        state,
                                        node,
                                        operand_with_type(operand, int_type),
                                    )
                                    + " must not be negative",
                                false,
                            );
                            Option::None
                        } else {
                            Option::Some(value)
                        },
                        Err(_) => {
                            diagnostic(
                                state,
                                node,
                                operand_string(state, node, operand) + " overflows int",
                                false,
                            );
                            Option::None
                        },
                    }
                },
                None => {
                    let message = if go_types::is_numeric(state.world, operand.type_id) {
                        operand_string(state, node, operand) + " truncated to int"
                    } else {
                        "cannot convert " + operand_string(state, node, operand) + " to type int"
                    };
                    diagnostic(state, node, message, false);
                    Option::None
                },
            }
        },
        None => {
            if go_types::is_untyped(state.world, operand.type_id)
                && go_types::is_numeric(state.world, operand.type_id) {
                update_contextual_operand_fact(state, node, operand, basic_type_id(state, "int"));
                if require_constant {
                    diagnostic(
                        state,
                        node,
                        "index " + expression_source_text(state, node) + " must be integer constant",
                        false,
                    )
                }
            } else if !go_types::is_integer(state.world, operand.type_id) {
                diagnostic(
                    state,
                    node,
                    "invalid argument: index " + operand_string(state, node, operand)
                        + " must be integer",
                    false,
                )
            } else if require_constant {
                diagnostic(
                    state,
                    node,
                    "index " + expression_source_text(state, node) + " must be integer constant",
                    false,
                )
            }
            Option::None
        },
    }
}

fn report_index_out_of_bounds(state: CheckState, node: syntax::NodeId, value: isize, length: i64) -> () {
    diagnostic(state, node, f"invalid argument: index {value} out of bounds [0:{length}]", false)
}

fn check_sequence_literal(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    element_type: go_types::TypeId,
    length: Option[i64],
    elements: Vec[syntax::NodeId],
) -> isize {
    let mut next_index = 0;
    let mut maximum = -1;
    let used: Vec[isize] = Vec::new();
    for element in elements {
        let mut valid_index = true;
        let mut explicit = false;
        let value_node = match key_value_nodes(state, element) {
            Some((key, value)) => {
                explicit = true;
                match constant_index(state, scope, key, true) {
                    Some(value) => {
                        next_index = value;
                    },
                    None => {
                        valid_index = false;
                    },
                }
                value
            },
            None => element,
        };
        let mut in_bounds = true;
        if valid_index {
            match length {
                Some(length) => if next_index.to_i64() >= length {
                    match key_value_nodes(state, element) {
                        Some((key, _)) => report_index_out_of_bounds(
                            state,
                            key,
                            next_index,
                            next_index.to_i64(),
                        ),
                        None => diagnostic(
                            state,
                            element,
                            f"index {next_index} is out of bounds (>= {length})",
                            false,
                        ),
                    }
                    in_bounds = false;
                },
                None => {},
            }
        } else {
            let mut occupied = false;
            for existing in used {
                if existing == next_index {
                    occupied = true;
                }
            }
            if !occupied {
                used.push(next_index)
            }
            if next_index > maximum {
                maximum = next_index;
            }
        }
        if valid_index && in_bounds {
            let mut duplicate = false;
            for existing in used {
                if existing == next_index {
                    duplicate = true;
                }
            }
            if duplicate {
                diagnostic(
                    state,
                    if explicit {
                        match key_value_nodes(state, element) {
                            Some((key, _)) => key,
                            None => element,
                        }
                    } else {
                        element
                    },
                    f"duplicate index {next_index} in array or slice literal",
                    false,
                )
            } else {
                used.push(next_index)
            }
            if next_index > maximum {
                maximum = next_index;
            }
        }
        let _ = check_composite_element(
            state,
            scope,
            value_node,
            element_type,
            "array or slice literal",
            true,
        );
        next_index += 1;
    }
    maximum + 1
}

fn check_map_literal(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    key_type: go_types::TypeId,
    value_type: go_types::TypeId,
    elements: Vec[syntax::NodeId],
) -> () {
    let constant_keys: Vec[constant::ConstValue] = Vec::new();
    let constant_key_types: Vec[go_types::TypeId] = Vec::new();
    for element in elements {
        match key_value_nodes(state, element) {
            Some((key, value)) => {
                let checked_key = check_composite_element(
                    state,
                    scope,
                    key,
                    key_type,
                    "map literal",
                    true,
                );
                let key_valid = checked_key.type_id.value != state.world.invalid.value
                    && argument_assignable(state, checked_key, key_type);
                let mut duplicate = false;
                match checked_key.value {
                    Some(constant::ConstValue::Unknown) | None => {},
                    Some(candidate) => {
                        let candidate_type = if go_types::is_interface(state.world, key_type) {
                            default_operand_type(state, checked_key)
                        } else {
                            key_type
                        };
                        for index in 0..constant_keys.len() {
                            if go_types::identical(
                                state.world,
                                constant_key_types[index],
                                candidate_type,
                            )
                                && constant::constant_equal(constant_keys[index], candidate) {
                                duplicate = true;
                            }
                        }
                        if duplicate {
                            diagnostic(
                                state,
                                key,
                                "duplicate key " + constant::constant_string(candidate)
                                    + " in map literal",
                                false,
                            )
                        } else {
                            constant_keys.push(candidate);
                            constant_key_types.push(candidate_type);
                        }
                    },
                }
                if !duplicate && key_valid {
                    let _ = check_composite_element(
                        state,
                        scope,
                        value,
                        value_type,
                        "map literal",
                        true,
                    );
                }
            },
            None => diagnostic(state, element, "missing key in map literal", false),
        }
    }
}

fn ellipsis_array_element(state: CheckState, scope: go_types::ScopeId, node: syntax::NodeId) -> Option[
    go_types::TypeId,
] {
    match syntax::get_kind(state.syntax.arena, node) {
        Some(syntax::SyntaxKind::ArrayType { lbrack: _, length, element }) => match length {
            Some(length) => match syntax::get_kind(state.syntax.arena, length) {
                Some(syntax::SyntaxKind::Ellipsis { ellipsis: _, element: _ }) => Option::Some(
                    recovered_constraint_type(state, element, resolve_type(state, scope, element)),
                ),
                _ => Option::None,
            },
            None => Option::None,
        },
        _ => Option::None,
    }
}

fn check_composite_literal(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    type_node: Option[syntax::NodeId],
    elements: Vec[syntax::NodeId],
) -> Operand {
    let type_node = match type_node {
        Some(value) => value,
        None => {
            diagnostic(state, node, "missing type in composite literal", false);
            let _ = state.retained_invalid_type_fact_nodes.insert(node.value);
            return Operand {
                type_id: state.world.invalid,
                value: Option::None,
                addressable: false,
                assignable: false,
            }
        },
    };
    let ellipsis_element = ellipsis_array_element(state, scope, type_node);
    let type_id = match ellipsis_element {
        Some(element) => {
            let length = check_sequence_literal(state, scope, node, element, Option::None, elements);
            let result = go_types::add_type(
                state.world,
                go_types::TypeKind::Array { length: length.to_i64(), element },
            );
            record_type_expression(state, type_node, result);
            result
        },
        None => {
            let resolved = resolve_type(state, scope, type_node);
            let valid_literal_type = match go_types::type_data(
                state.world,
                core_type_id(state, resolved),
            ) {
                go_types::TypeData {
                    id: _,
                    kind: go_types::TypeKind::Struct { fields: _ } | go_types::TypeKind::Array {
                        length: _,
                        element: _,
                    } | go_types::TypeKind::Slice { element: _ } | go_types::TypeKind::Map {
                        key: _,
                        value: _,
                    },
                } => true,
                _ => false,
            };
            let invalid_core = resolved.value != state.world.invalid.value
                && core_type_id(state, resolved).value == state.world.invalid.value;
            let invalid_type_parameter_literal = invalid_core
                && go_types::is_type_parameter(state.world, resolved);
            let suppress_invalid_literal = invalid_core && !invalid_type_parameter_literal;
            let track_type_cycle = state.array_length_depth > 0
                && !state.active_type_objects.is_empty();
            if !state.config.exported_api_only || state.initialization_depth == 0 {
                check_composite_literal_elements(
                    state,
                    scope,
                    node,
                    if suppress_invalid_literal && !track_type_cycle {
                        state.world.invalid
                    } else {
                        resolved
                    },
                    elements,
                )
            }
            if resolved.value != state.world.invalid.value && !valid_literal_type
                && !track_type_cycle
                && !invalid_core {
                let _ = state.omitted_type_fact_nodes.insert(node.value);
            } else if invalid_type_parameter_literal {
                let _ = state.omitted_type_fact_nodes.insert(node.value);
            }
            if invalid_core && (track_type_cycle || invalid_type_parameter_literal) {
                state.world.invalid
            } else {
                resolved
            }
        },
    };
    if type_id.value == state.world.invalid.value
        && !(state.array_length_depth > 0 && !state.active_type_objects.is_empty())
        && !state.omitted_type_fact_nodes.contains(node.value) {
        let _ = state.retained_invalid_type_fact_nodes.insert(node.value);
    }
    Operand { type_id, value: Option::None, addressable: false, assignable: false }
}

fn indexed_concrete_type(state: CheckState, value: go_types::TypeId) -> Option[
    (go_types::TypeId, bool, Option[i64], Option[go_types::TypeId]),
] {
    let mut resolved = core_type_id(state, value);
    match go_types::get_type(state.world, resolved) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) => {
            if go_types::is_type_parameter(state.world, element) {
                return Option::None
            }
            resolved = core_type_id(state, element);
        },
        _ => {},
    }
    match go_types::get_type(state.world, resolved) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Array { length, element } }) => Option::Some(
            (element, true, Option::Some(length), Option::None),
        ),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Slice { element } }) => {
            Option::Some((element, true, Option::None, Option::None))
        },
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Map { key, value } }) => Option::Some(
            (value, false, Option::None, Option::Some(key)),
        ),
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Basic {
                basic: go_types::BasicKind::String,
                name: _,
                untyped: _,
            },
        }) | Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Basic {
                basic: go_types::BasicKind::UntypedString,
                name: _,
                untyped: _,
            },
        }) => Option::Some((basic_type_id(state, "byte"), false, Option::None, Option::None)),
        _ => Option::None,
    }
}

fn indexed_type(state: CheckState, value: go_types::TypeId) -> Option[
    (go_types::TypeId, bool, Option[i64], Option[go_types::TypeId]),
] {
    if let Some(value) = indexed_concrete_type(state, value) {
        return Option::Some(value)
    }
    if !go_types::is_type_parameter(state.world, value) {
        return Option::None
    }
    let terms = go_types::type_set_specific_types(state.world, value);
    if terms.is_empty() {
        return Option::None
    }
    let mut element: Option[go_types::TypeId] = Option::None;
    let mut addressable = true;
    let mut length: Option[i64] = Option::None;
    let mut map_key: Option[go_types::TypeId] = Option::None;
    let mut map_kind: Option[bool] = Option::None;
    for term in terms {
        let Some((candidate, candidate_addressable, candidate_length, candidate_key)) = indexed_concrete_type(
            state,
            term,
        ) else {
            return Option::None;
        };
        let candidate_map = candidate_key.is_some();
        match map_kind {
            Some(existing) => if existing != candidate_map {
                return Option::None
            },
            None => {
                map_kind = Option::Some(candidate_map);
            },
        }
        match (map_key, candidate_key) {
            (Some(existing), Some(candidate)) => if !go_types::identical(
                state.world,
                existing,
                candidate,
            ) {
                return Option::None
            },
            (None, Some(candidate)) => {
                map_key = Option::Some(candidate);
            },
            _ => {},
        }
        match element {
            Some(element) => if !go_types::identical(state.world, element, candidate) {
                return Option::None
            },
            None => {
                element = Option::Some(candidate);
            },
        }
        if !candidate_addressable {
            addressable = false;
        }
        match candidate_length {
            Some(candidate_length) => match length {
                Some(existing) => if candidate_length < existing {
                    length = Option::Some(candidate_length);
                },
                None => {
                    length = Option::Some(candidate_length);
                },
            },
            None => {},
        }
    }
    element.map(|element| (element, addressable, length, map_key))
}

fn pointer_to_array_type(state: CheckState, value: go_types::TypeId) -> bool {
    match go_types::get_type(state.world, core_type_id(state, value)) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) => match go_types::get_type(
            state.world,
            core_type_id(state, element),
        ) {
            Some(go_types::TypeData {
                id: _,
                kind: go_types::TypeKind::Array { length: _, element: _ },
            }) => true,
            _ => false,
        },
        _ => false,
    }
}

fn omit_indirect_cycle_facts(state: CheckState, node: syntax::NodeId, expression: syntax::NodeId) -> () {
    let _ = state.omitted_type_fact_nodes.insert(expression.value);
    let _ = state.omitted_type_fact_nodes.insert(node.value);
    match syntax::get_kind(state.syntax.arena, expression) {
        Some(syntax::SyntaxKind::CallExpr { function, lparen: _, arguments, ellipsis: _, rparen: _ }) => if identifier(
            state,
            function,
        ).unwrap_or("")
            == NEW_BUILTIN {
            for argument in arguments {
                let omitted: Vec[syntax::NodeId] = Vec::new();
                for fact in state.info.types {
                    if node_start(state, fact.node) >= node_start(state, argument)
                        && node_end(state, fact.node) <= node_end(state, argument) {
                        omitted.push(fact.node)
                    }
                }
                for omitted_node in omitted {
                    let _ = state.omitted_type_fact_nodes.insert(omitted_node.value);
                }
            }
            match type_fact_index(state, function) {
                Some(index) => {
                    state.info.types[index].type_id = state.world.invalid;
                    state.info.types[index].extra = Option::None;
                },
                None => {},
            }
        },
        _ => {},
    }
}

fn check_index_expression(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    expression: syntax::NodeId,
    index: syntax::NodeId,
) -> Operand {
    let base = check_expression(state, scope, expression);
    let recursive = record_active_value_type_cycle(state, base.type_id, true);
    if recursive {
        omit_indirect_cycle_facts(state, node, expression)
    }
    match go_types::get_type(state.world, core_type_id(state, base.type_id)) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Map { key, value } }) => {
            let index_operand = check_expression(state, scope, index);
            if index_operand.type_id.value == state.world.invalid.value {} else if !argument_assignable(
                state,
                index_operand,
                key,
            ) {
                diagnostic(
                    state,
                    index,
                    "cannot use " + operand_string(state, index, index_operand) + " as "
                        + diagnostic_type_string(state, key)
                        + " value in map index",
                    false,
                )
            } else {
                update_contextual_operand_fact(state, index, index_operand, key)
            }
            return Operand {
                type_id: value,
                value: Option::None,
                addressable: false,
                assignable: true,
            }
        },
        _ => {},
    }
    let pointer_to_array = pointer_to_array_type(state, base.type_id);
    let indexed = indexed_type(state, base.type_id);
    let index_value = if recursive {
        let _ = check_expression(state, scope, index);
        Option::None
    } else {
        match indexed {
            Some((_, _, _, Some(key))) => {
                let index_operand = check_expression(state, scope, index);
                if index_operand.type_id.value == state.world.invalid.value {} else if !argument_assignable(
                    state,
                    index_operand,
                    key,
                ) {
                    diagnostic(
                        state,
                        index,
                        "cannot use " + operand_string(state, index, index_operand) + " as "
                            + diagnostic_type_string(state, key)
                            + " value in map index",
                        false,
                    )
                } else {
                    update_contextual_operand_fact(state, index, index_operand, key)
                }
                Option::None
            },
            Some(_) => constant_index(state, scope, index, false),
            None => {
                let _ = check_expression(state, scope, index);
                Option::None
            },
        }
    };
    match indexed {
        Some((element, addressable, length, map_key)) => {
            let length = match (length, base.value) {
                (Some(length), _) => Option::Some(length),
                (None, Some(constant::ConstValue::String(value))) => Option::Some(
                    value.len().to_i64(),
                ),
                _ => Option::None,
            };
            match (index_value, length) {
                (Some(index_value), Some(length)) => if index_value.to_i64() >= length {
                    report_index_out_of_bounds(state, index, index_value, length)
                },
                _ => {},
            }
            Operand {
                type_id: element,
                value: Option::None,
                addressable: addressable
                    && (pointer_to_array || base.addressable || length.is_none()),
                assignable: map_key.is_some()
                    || (addressable && (pointer_to_array || base.addressable || length.is_none())),
            }
        },
        None => {
            if base.type_id.value != state.world.invalid.value && !recursive {
                diagnostic(
                    state,
                    expression,
                    "cannot index " + operand_string(state, expression, base),
                    false,
                )
            }
            invalid_operand(state)
        },
    }
}

fn check_slice_index(state: CheckState, scope: go_types::ScopeId, value: Option[syntax::NodeId]) -> Option[
    isize,
] {
    value.and_then(|value| constant_index(state, scope, value, false))
}

fn check_slice_bounds(
    state: CheckState,
    low_node: Option[syntax::NodeId],
    low: Option[isize],
    high_node: Option[syntax::NodeId],
    high: Option[isize],
    max_node: Option[syntax::NodeId],
    max: Option[isize],
    length: Option[i64],
) -> () {
    let mut out_of_bounds = false;
    match length {
        Some(length) => {
            match (low_node, low) {
                (Some(node), Some(value)) => if value.to_i64() > length {
                    report_index_out_of_bounds(state, node, value, value.to_i64());
                    out_of_bounds = true;
                },
                _ => {},
            }
            match (high_node, high) {
                (Some(node), Some(value)) => if value.to_i64() > length {
                    report_index_out_of_bounds(state, node, value, value.to_i64());
                    out_of_bounds = true;
                },
                _ => {},
            }
            match (max_node, max) {
                (Some(node), Some(value)) => if value.to_i64() > length {
                    report_index_out_of_bounds(state, node, value, value.to_i64());
                    out_of_bounds = true;
                },
                _ => {},
            }
        },
        None => {},
    }
    if out_of_bounds {
        return
    }
    match (low, high_node, high) {
        (Some(low), Some(node), Some(high)) => if high < low {
            diagnostic(state, node, f"invalid slice indices: {high} < {low}", false)
        },
        _ => {},
    }
    match (high, max_node, max) {
        (Some(high), Some(node), Some(max)) => if max < high {
            diagnostic(state, node, f"invalid slice indices: {max} < {high}", false)
        },
        _ => {},
    }
}

fn sliceable_type(state: CheckState, value: go_types::TypeId, slice3: bool) -> isize {
    let mut resolved = core_type_id(state, value);
    match go_types::get_type(state.world, resolved) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) => {
            resolved = core_type_id(state, element);
            match go_types::get_type(state.world, resolved) {
                Some(go_types::TypeData {
                    id: _,
                    kind: go_types::TypeKind::Array { length: _, element: _ },
                }) => return 2,
                _ => return 0,
            }
        },
        _ => {},
    }
    match go_types::get_type(state.world, resolved) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Array { length: _, element: _ } }) => 1,
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Slice { element: _ } }) => 2,
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Basic {
                basic: go_types::BasicKind::String | go_types::BasicKind::UntypedString,
                name: _,
                untyped: _,
            },
        }) => if slice3 {
            0
        } else {
            2
        },
        _ => 0,
    }
}

fn is_byte_slice_type(state: CheckState, value: go_types::TypeId) -> bool {
    match slice_element_type(state, value) {
        Some(element) => basic_kind(state, element) == go_types::BasicKind::Uint8,
        None => false,
    }
}

fn type_parameter_slice_indices_valid(state: CheckState, value: go_types::TypeId, slice3: bool) -> bool {
    let terms = go_types::type_set_specific_types(state.world, value);
    if terms.is_empty() {
        return false
    }
    let mut first: Option[go_types::TypeId] = Option::None;
    for term in terms {
        if sliceable_type(state, term, false) == 0 || (slice3 && is_string_type(state, term)) {
            return false
        }
        match first {
            Some(previous) => {
                let same = go_types::identical(
                    state.world,
                    go_types::underlying(state.world, previous),
                    go_types::underlying(state.world, term),
                );
                let string_bytes = (is_string_type(state, previous)
                    && is_byte_slice_type(state, term))
                    || (is_string_type(state, term) && is_byte_slice_type(state, previous));
                if !same && !string_bytes {
                    return false
                }
            },
            None => {
                first = Option::Some(term);
            },
        }
    }
    true
}

fn check_slice_expression(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    expression: syntax::NodeId,
    low: Option[syntax::NodeId],
    high: Option[syntax::NodeId],
    max: Option[syntax::NodeId],
    slice3: bool,
) -> Operand {
    let base = check_expression(state, scope, expression);
    if type_contains_invalid(state, base.type_id) && !type_contains_active_type(state, base.type_id) {
        match low {
            Some(value) => {
                let _ = check_expression(state, scope, value);
            },
            None => {},
        }
        match high {
            Some(value) => {
                let _ = check_expression(state, scope, value);
            },
            None => {},
        }
        match max {
            Some(value) => {
                let _ = check_expression(state, scope, value);
            },
            None => {},
        }
        return invalid_operand(state)
    }
    let recursive = record_active_value_type_cycle(state, base.type_id, true);
    if recursive {
        omit_indirect_cycle_facts(state, node, expression)
    }
    let check_indices = sliceable_type(state, base.type_id, slice3) > 0
        || (go_types::is_type_parameter(state.world, base.type_id)
            && type_parameter_slice_indices_valid(state, base.type_id, slice3));
    let low_value = if check_indices {
        check_slice_index(state, scope, low)
    } else {
        Option::None
    };
    let high_value = if check_indices {
        check_slice_index(state, scope, high)
    } else {
        Option::None
    };
    let max_value = if check_indices {
        check_slice_index(state, scope, max)
    } else {
        Option::None
    };
    let mut resolved = core_type_id(state, base.type_id);
    let mut pointer_to_array = false;
    match go_types::get_type(state.world, resolved) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) => {
            resolved = core_type_id(state, element);
            pointer_to_array = true;
        },
        _ => {},
    }
    match go_types::get_type(state.world, resolved) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Array { length, element } }) => if !base.addressable
            && !pointer_to_array {
            diagnostic(state, node, "slice of unaddressable array", false);
            invalid_operand(state)
        } else {
            check_slice_bounds(
                state,
                low,
                low_value,
                high,
                high_value,
                max,
                max_value,
                Option::Some(length),
            );
            Operand {
                type_id: go_types::add_type(state.world, go_types::TypeKind::Slice { element }),
                value: Option::None,
                addressable: false,
                assignable: false,
            }
        },
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Slice { element: _ } }) => {
            check_slice_bounds(
                state,
                low,
                low_value,
                high,
                high_value,
                max,
                max_value,
                Option::None,
            );
            Operand {
                type_id: base.type_id,
                value: Option::None,
                addressable: false,
                assignable: false,
            }
        },
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Basic {
                basic: go_types::BasicKind::String | go_types::BasicKind::UntypedString,
                name: _,
                untyped: _,
            },
        }) => if slice3 {
            diagnostic(
                state,
                max.unwrap_or(node),
                "invalid operation: 3-index slice of string",
                false,
            );
            invalid_operand(state)
        } else {
            let length = match base.value {
                Some(constant::ConstValue::String(value)) => Option::Some(value.len().to_i64()),
                _ => Option::None,
            };
            check_slice_bounds(state, low, low_value, high, high_value, max, max_value, length);
            Operand {
                type_id: if basic_kind(state, base.type_id) == go_types::BasicKind::UntypedString {
                    basic_type_id(state, "string")
                } else {
                    base.type_id
                },
                value: Option::None,
                addressable: false,
                assignable: false,
            }
        },
        _ if go_types::is_type_parameter(state.world, base.type_id) => {
            let terms = go_types::type_set_specific_types(state.world, base.type_id);
            let mut valid = !terms.is_empty();
            let mut requires_addressable = false;
            let mut has_string = false;
            let mut first_type: Option[go_types::TypeId] = Option::None;
            let mut mismatch: Option[(go_types::TypeId, go_types::TypeId)] = Option::None;
            for term in terms {
                let classification = sliceable_type(state, term, false);
                if classification == 0 {
                    valid = false;
                } else if classification == 1 {
                    requires_addressable = true;
                }
                if is_string_type(state, term) {
                    has_string = true;
                }
                match first_type {
                    Some(first) => {
                        let same = go_types::identical(
                            state.world,
                            go_types::underlying(state.world, first),
                            go_types::underlying(state.world, term),
                        );
                        let string_bytes = (is_string_type(state, first)
                            && is_byte_slice_type(state, term))
                            || (is_string_type(state, term) && is_byte_slice_type(state, first));
                        if !same && !string_bytes && mismatch.is_none() {
                            mismatch = Option::Some((first, term));
                            valid = false;
                        }
                    },
                    None => {
                        first_type = Option::Some(term);
                    },
                }
            }
            match mismatch {
                Some((left, right)) => {
                    diagnostic(
                        state,
                        expression,
                        "cannot slice " + operand_string(state, expression, base) + ": "
                            + diagnostic_type_string(state, left)
                            + " and "
                            + diagnostic_type_string(state, right)
                            + " have different underlying types",
                        false,
                    );
                    return invalid_operand(state)
                },
                None => {},
            }
            if !valid {
                diagnostic(
                    state,
                    expression,
                    "cannot slice " + operand_string(state, expression, base),
                    false,
                );
                invalid_operand(state)
            } else if slice3 && has_string {
                diagnostic(
                    state,
                    max.unwrap_or(node),
                    "invalid operation: 3-index slice of string",
                    false,
                );
                invalid_operand(state)
            } else if requires_addressable && !base.addressable {
                diagnostic(state, node, "slice of unaddressable array", false);
                invalid_operand(state)
            } else {
                let result = match first_type {
                    Some(first) => match underlying_kind(state, first) {
                        Some(go_types::TypeKind::Array { length: _, element }) => go_types::add_type(
                            state.world,
                            go_types::TypeKind::Slice { element },
                        ),
                        _ => base.type_id,
                    },
                    None => base.type_id,
                };
                Operand {
                    type_id: result,
                    value: Option::None,
                    addressable: false,
                    assignable: false,
                }
            }
        },
        _ => {
            if !recursive {
                diagnostic(
                    state,
                    expression,
                    "cannot slice " + operand_string(state, expression, base),
                    false,
                )
            }
            invalid_operand(state)
        },
    }
}

fn check_type_assertion(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    expression: syntax::NodeId,
    type_node: Option[syntax::NodeId],
) -> Operand {
    let source = check_expression(state, scope, expression);
    if type_node.is_none() {
        diagnostic(state, node, "use of .(type) outside type switch", false);
        return invalid_operand(state)
    } else if go_types::is_type_parameter(state.world, source.type_id) {
        diagnostic(
            state,
            expression,
            "invalid operation: cannot use type assertion on type parameter value "
                + operand_string(state, expression, source),
            false,
        );
        return invalid_operand(state)
    } else if !go_types::is_interface(state.world, source.type_id) {
        diagnostic(
            state,
            expression,
            "invalid operation: " + operand_string(state, expression, source)
                + " is not an interface",
            false,
        );
        return invalid_operand(state)
    }
    match type_node {
        Some(type_node) => {
            let target = resolve_type(state, scope, type_node);
            let result_target = if target.value == state.world.invalid.value {
                match recorded_type_fact(state, type_node) {
                    Some(fact) => if go_types::is_constraint_interface(state.world, fact.type_id) {
                        fact.type_id
                    } else {
                        target
                    },
                    None => target,
                }
            } else {
                target
            };
            let recursive = record_active_value_type_cycle(state, target, false);
            if recursive {
                let _ = state.omitted_type_fact_nodes.insert(node.value);
            }
            if !recursive && !type_contains_invalid(state, target)
                && !go_types::assertable_to(state.world, source.type_id, target) {
                let detail = interface_implementation_detail(state, target, source.type_id);
                diagnostic(
                    state,
                    expression,
                    "impossible type assertion: " + expression_source_text(state, node) + "\n\t"
                        + implementation_type_string(state, target)
                        + " does not implement "
                        + implementation_type_string(state, source.type_id)
                        + if detail == "" {
                            ""
                        } else {
                            " " + detail
                        },
                    false,
                )
            }
            Operand {
                type_id: result_target,
                value: Option::None,
                addressable: false,
                assignable: false,
            }
        },
        None => {
            diagnostic(state, node, "use of .(type) outside type switch", false);
            invalid_operand(state)
        },
    }
}

fn check_function_literal(
    state: CheckState,
    scope: go_types::ScopeId,
    type_node: syntax::NodeId,
    body: syntax::NodeId,
) -> Operand {
    let signature = resolve_type(state, scope, type_node);
    if state.local_type_alias_depth > 0 && !state.active_local_type_objects.is_empty() {
        let object = state.active_local_type_objects[state.active_local_type_objects.len() - 1];
        state.deferred_local_alias_body_objects.push(object);
        state.deferred_local_alias_bodies.push(body);
        if type_contains_alias_cycle(state, signature, object, Vec::new())
            && !local_alias_cycle_seen(state, object) {
            state.deferred_local_alias_cycles.push(object)
        }
    }
    if state.initialization_depth > 0 {
        check_deferred_function_body_early(state, type_node, signature, body, state.current_iota)
    } else if !state.active_type_objects.is_empty() || state.local_type_declaration_depth > 0 {
        defer_function_body(state, type_node, signature, body, state.current_iota)
    } else if state.config.ignore_func_bodies {
        check_deferred_function_body_early(state, type_node, signature, body, state.current_iota)
    } else {
        check_function_body(state, type_node, signature, body)
    }
    Operand { type_id: signature, value: Option::None, addressable: false, assignable: false }
}
