package checker;

use gomlgo::syntax;
use gomlgo::constant;
use gomlgo::types as go_types;
use std::bytes;

pub struct CheckConfig {
    pub go_version: string,
    pub sizes: go_types::TargetSizes,
    pub ignore_func_bodies: bool,
    pub exported_api_only: bool,
    pub fake_import_c: bool,
    pub disable_unused_import_check: bool,
    pub retain_syntax_paths: bool,
    pub enable_alias: bool,
    pub available_imports: Vec[AvailableImport],
    pub ignored_imports: Vec[string],
    pub import_errors: Vec[ImportFailure],
}

pub struct AvailableImport {
    pub path: string,
    pub name: string,
}

pub struct ImportFailure {
    pub path: string,
    pub message: string,
}

pub struct SourceFile {
    pub name: string,
    pub source: bytes::Bytes,
}

pub struct PackageInput {
    pub path: string,
    pub files: Vec[SourceFile],
}

pub struct CheckDiagnostic {
    pub file: string,
    pub start: isize,
    pub end: isize,
    pub message: string,
    pub soft: bool,
    pub secondary: bool,
}

pub enum FactConstant {
    SmallInt(i64),
    Exact(string),
    Value(constant::ConstValue),
}

pub struct TypeFactExtra {
    pub key: Option[string],
    pub constant_kind: string,
    pub constant: Option[FactConstant],
}

pub struct TypeFact {
    pub node: syntax::NodeId,
    pub type_id: go_types::TypeId,
    pub extra: Option[TypeFactExtra],
    pub void: bool,
    pub type_expr: bool,
    pub builtin: bool,
    pub value_expr: bool,
    pub nil: bool,
    pub addressable: bool,
    pub assignable: bool,
    pub comma_ok: bool,
}

pub fn type_fact_extra(key: Option[string], constant_kind: string, constant: Option[string]) -> Option[
    TypeFactExtra,
] {
    if key.is_none() && constant.is_none() {
        Option::None
    } else {
        Option::Some(
            TypeFactExtra {
                key,
                constant_kind,
                constant: constant.map(|value| FactConstant::Exact(value)),
            },
        )
    }
}

pub fn type_fact_key(value: TypeFact) -> Option[string] {
    value.extra.and_then(|extra| extra.key)
}

pub fn type_fact_constant_kind(value: TypeFact) -> string {
    match value.extra {
        Some(extra) => extra.constant_kind,
        None => "",
    }
}

pub fn type_fact_constant(value: TypeFact) -> Option[string] {
    let extra = value.extra?;
    match extra.constant? {
        SmallInt(value) => Option::Some(value.to_string()),
        Exact(value) => Option::Some(value),
        Value(value) => Option::Some(constant::constant_exact_string(value)),
    }
}

pub fn type_fact_has_constant(value: TypeFact) -> bool {
    match value.extra {
        Some(extra) => extra.constant.is_some(),
        None => false,
    }
}

fn type_fact_value(value: TypeFact) -> Option[constant::ConstValue] {
    let extra = value.extra?;
    match extra.constant? {
        SmallInt(value) => Option::Some(
            constant::ConstValue::Int(constant::integer_from_int64(value)),
        ),
        Exact(value) => constant::constant_from_exact(extra.constant_kind, value),
        Value(value) => Option::Some(constant::constant_copy(value)),
    }
}

fn small_fact_integer(value: constant::BigInt) -> Option[i64] {
    let limbs = value.magnitude.limbs;
    if limbs.len() > 2 {
        return Option::None
    }
    let mut magnitude = 0.to_u64();
    if limbs.len() > 0 {
        magnitude = limbs[0].to_u64();
    }
    if limbs.len() > 1 {
        magnitude = magnitude | (limbs[1].to_u64() << 32);
    }
    let limit = 9223372036854775807.to_u64();
    if value.sign < 0 {
        if magnitude == 0 {
            return Option::None
        }
        if magnitude == limit + 1 {
            Option::Some(-9223372036854775807.to_i64() - 1)
        } else if magnitude <= limit {
            Option::Some(-magnitude.to_i64())
        } else {
            Option::None
        }
    } else if magnitude <= limit {
        Option::Some(magnitude.to_i64())
    } else {
        Option::None
    }
}

fn fact_constant_snapshot(value: constant::ConstValue) -> FactConstant {
    if let constant::ConstValue::Int(integer) = value {
        if let Some(small) = small_fact_integer(integer) {
            return FactConstant::SmallInt(small)
        }
    }
    FactConstant::Value(constant::constant_copy(value))
}

fn type_fact_value_extra(value: constant::ConstValue) -> Option[TypeFactExtra] {
    Option::Some(
        TypeFactExtra {
            key: Option::None,
            constant_kind: constant::constant_kind_name(value),
            constant: Option::Some(fact_constant_snapshot(value)),
        },
    )
}

pub struct ObjectFact {
    pub node: syntax::NodeId,
    pub object: Option[go_types::ObjectId],
}

pub struct SelectionFact {
    pub node: syntax::NodeId,
    pub receiver_type: go_types::TypeId,
    pub object: go_types::ObjectId,
    pub type_id: go_types::TypeId,
    pub index: Vec[isize],
    pub indirect: bool,
}

pub struct ScopeFact {
    pub node: syntax::NodeId,
    pub scope: go_types::ScopeId,
}

pub struct InstanceFact {
    pub node: syntax::NodeId,
    pub type_args: Vec[go_types::TypeId],
    pub type_id: go_types::TypeId,
}

pub struct InitializerFact {
    pub left: Vec[go_types::ObjectId],
    pub right: syntax::NodeId,
}

pub struct FileVersionFact {
    pub file: syntax::FileId,
    pub version: string,
}

pub struct TypeInfo {
    pub types: Vec[TypeFact],
    pub defs: Vec[ObjectFact],
    pub uses: Vec[ObjectFact],
    pub implicits: Vec[ObjectFact],
    pub selections: Vec[SelectionFact],
    pub scopes: Vec[ScopeFact],
    pub instances: Vec[InstanceFact],
    pub init_order: Vec[InitializerFact],
    pub file_versions: Vec[FileVersionFact],
}

pub struct CheckResult {
    pub world: go_types::World,
    pub syntax: syntax::PackageSyntax,
    pub package_id: go_types::PackageId,
    pub info: TypeInfo,
    pub diagnostics: Vec[CheckDiagnostic],
}

pub fn default_config() -> CheckConfig {
    CheckConfig {
        go_version: "go1.26",
        sizes: go_types::TargetSizes { word_size: 8, max_align: 8 },
        ignore_func_bodies: false,
        exported_api_only: false,
        fake_import_c: false,
        disable_unused_import_check: false,
        retain_syntax_paths: true,
        enable_alias: true,
        available_imports: Vec::new(),
        ignored_imports: Vec::new(),
        import_errors: Vec::new(),
    }
}

pub fn empty_info() -> TypeInfo {
    TypeInfo {
        types: Vec::new(),
        defs: Vec::new(),
        uses: Vec::new(),
        implicits: Vec::new(),
        selections: Vec::new(),
        scopes: Vec::new(),
        instances: Vec::new(),
        init_order: Vec::new(),
        file_versions: Vec::new(),
    }
}

pub fn check(config: CheckConfig, input: PackageInput) -> CheckResult {
    check_package(config, input)
}
