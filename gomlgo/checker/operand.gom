package checker;

use gomlgo::constant;
use gomlgo::syntax;
use gomlgo::types as go_types;
use std::num;
use std::text;
use std::unicode;

struct Operand {
    type_id: go_types::TypeId,
    value: Option[constant::ConstValue],
    addressable: bool,
    assignable: bool,
}

fn invalid_operand(state: CheckState) -> Operand {
    Operand {
        type_id: state.world.invalid,
        value: Option::Some(constant::ConstValue::Unknown),
        addressable: false,
        assignable: false,
    }
}

fn selector_object_accessible(state: CheckState, object: go_types::Object) -> bool {
    object.exported
        || match object.owner {
            Some(owner) => owner.value == state.package_id.value,
            None => true,
        }
}

fn exported_spelling(name: string) -> string {
    let mut result = "";
    let mut first = true;
    for character in name.chars() {
        result += if first {
            unicode::to_uppercase(character).to_string()
        } else {
            character.to_string()
        };
        first = false;
    }
    result
}

fn similar_selector_object(state: CheckState, object: go_types::Object, name: string) -> bool {
    if unicode::lowercase(object.name) != unicode::lowercase(name) {
        false
    } else if selector_object_accessible(state, object) {
        match object.owner {
            Some(owner) => if owner.value == state.package_id.value {
                true
            } else {
                go_types::is_exported(name) || unicode::lowercase(object.name) == name
            },
            None => true,
        }
    } else {
        name == exported_spelling(object.name)
    }
}

fn similar_package_member(state: CheckState, package_id: go_types::PackageId, name: string) -> string {
    let scope = state.world.packages[package_id.value].scope;
    for entry in state.world.scopes[scope.value].entries {
        match go_types::get_object(state.world, entry.object) {
            Some(object) => if object.exported
                && unicode::lowercase(object.name) == unicode::lowercase(name) {
                return object.name
            },
            None => {},
        }
    }
    ""
}

fn similar_field_in_type_inner(
    state: CheckState,
    type_id: go_types::TypeId,
    name: string,
    visited: Vec[isize],
) -> Option[go_types::ObjectId] {
    let resolved = go_types::unalias(state.world, type_id);
    for existing in visited {
        if existing == resolved.value {
            return Option::None
        }
    }
    visited.push(resolved.value);
    go_types::ensure_named_instance_methods(state.world, resolved);
    match go_types::get_type(state.world, resolved) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object: _,
                underlying,
                type_params: _,
                type_args: _,
                methods: _,
            },
        }) => similar_field_in_type_inner(state, underlying, name, visited),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) => similar_field_in_type_inner(
            state,
            element,
            name,
            visited,
        ),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Struct { fields } }) => {
            for field in fields {
                match field.object {
                    Some(object_id) => match go_types::get_object(state.world, object_id) {
                        Some(object) => if similar_selector_object(state, object, name) {
                            return Option::Some(object_id)
                        },
                        None => {},
                    },
                    None => {},
                }
            }
            for field in fields {
                if field.embedded {
                    if let Some(object) = similar_field_in_type_inner(
                        state,
                        field.variable.type_id,
                        name,
                        visited,
                    ) {
                        return Option::Some(object)
                    }
                }
            }
            Option::None
        },
        _ => Option::None,
    }
}

fn similar_field_in_type(state: CheckState, type_id: go_types::TypeId, name: string) -> Option[
    go_types::ObjectId,
] {
    match similar_field_in_type_inner(state, type_id, name, Vec::new()) {
        Some(object_id) => match go_types::get_object(state.world, object_id) {
            Some(object) => match go_types::lookup_field_or_method_detailed(
                state.world,
                type_id,
                false,
                object.name,
            ) {
                go_types::FieldOrMethodLookup::Found(selection) => match go_types::get_object(
                    state.world,
                    selection.object,
                ) {
                    Some(selected) => if selected.kind == go_types::ObjectKind::Var {
                        Option::Some(selection.object)
                    } else {
                        Option::None
                    },
                    None => Option::None,
                },
                _ => Option::None,
            },
            None => Option::None,
        },
        None => Option::None,
    }
}

fn similar_method_object_in_type(
    state: CheckState,
    type_id: go_types::TypeId,
    name: string,
    addressable: bool,
) -> Option[go_types::ObjectId] {
    let mut result: Option[go_types::ObjectId] = Option::None;
    for selection in go_types::method_set(state.world, type_id) {
        match go_types::get_object(state.world, selection.object) {
            Some(object) => if object.name != name && similar_selector_object(state, object, name)
                && selector_object_accessible(state, object) {
                result = Option::Some(selection.object);
            },
            None => {},
        }
    }
    if addressable {
        let pointer = go_types::add_type(
            state.world,
            go_types::TypeKind::Pointer { element: type_id },
        );
        for selection in go_types::method_set(state.world, pointer) {
            match go_types::get_object(state.world, selection.object) {
                Some(object) => if object.name != name
                    && similar_selector_object(state, object, name)
                    && selector_object_accessible(state, object) {
                    result = Option::Some(selection.object);
                },
                None => {},
            }
        }
    }
    result
}

fn similar_method_in_type(
    state: CheckState,
    type_id: go_types::TypeId,
    name: string,
    addressable: bool,
) -> string {
    match similar_method_object_in_type(state, type_id, name, addressable) {
        Some(object) => match go_types::get_object(state.world, object) {
            Some(object) => object.name,
            None => "",
        },
        None => "",
    }
}

fn basic_type_id(state: CheckState, name: string) -> go_types::TypeId {
    go_types::basic_type(state.world, name).unwrap_or(state.world.invalid)
}

fn basic_kind(state: CheckState, type_id: go_types::TypeId) -> go_types::BasicKind {
    go_types::basic_kind(state.world, type_id).unwrap_or(go_types::BasicKind::Invalid)
}

fn diagnostic_method_string(state: CheckState, object_id: go_types::ObjectId) -> string {
    match go_types::get_object(state.world, object_id) {
        Some(object) => match go_types::get_type(state.world, object.type_id) {
            Some(go_types::TypeData {
                id: _,
                kind: go_types::TypeKind::Signature {
                    receiver: _,
                    receiver_type_params: _,
                    type_params: _,
                    params,
                    results,
                    variadic,
                },
            }) => {
                let parameter_types: Vec[string] = Vec::new();
                for variable in tuple_variables(state, params) {
                    let mut type_string = diagnostic_type_string(state, variable.type_id);
                    if variadic && parameter_types.len() + 1 == tuple_arity(state, params) {
                        match go_types::get_type(
                            state.world,
                            go_types::unalias(state.world, variable.type_id),
                        ) {
                            Some(go_types::TypeData {
                                id: _,
                                kind: go_types::TypeKind::Slice { element },
                            }) => {
                                type_string = "..." + diagnostic_type_string(state, element);
                            },
                            _ => {},
                        }
                    }
                    parameter_types.push(type_string)
                }
                let result_types: Vec[string] = Vec::new();
                for variable in tuple_variables(state, results) {
                    result_types.push(diagnostic_type_string(state, variable.type_id))
                }
                let result_string = if result_types.is_empty() {
                    ""
                } else if result_types.len() == 1 {
                    " " + result_types[0]
                } else {
                    " (" + text::join(result_types, ", ") + ")"
                };
                object.name + "(" + text::join(parameter_types, ", ") + ")" + result_string
            },
            _ => object.name,
        },
        None => "?",
    }
}

fn incomplete_named_instance(state: CheckState, value: go_types::TypeId) -> bool {
    match go_types::type_data(state.world, go_types::unalias(state.world, value)).kind {
        go_types::TypeKind::Named { object: _, underlying: _, type_params, type_args, methods: _ } | go_types::TypeKind::Alias {
            object: _,
            rhs: _,
            type_params,
            type_args,
        } => type_params.len() != type_args.len(),
        go_types::TypeKind::Pointer { element } => incomplete_named_instance(state, element),
        _ => false,
    }
}

fn interface_implementation_detail(
    state: CheckState,
    source: go_types::TypeId,
    target: go_types::TypeId,
) -> string {
    if !go_types::is_interface(state.world, target) {
        return ""
    } else if incomplete_named_instance(state, source) || incomplete_named_instance(state, target) {
        return ""
    }
    for required_id in go_types::interface_methods(state.world, target) {
        match go_types::get_object(state.world, required_id) {
            Some(required) => match go_types::lookup_field_or_method_detailed(
                state.world,
                source,
                false,
                required.name,
            ) {
                go_types::FieldOrMethodLookup::Found(actual) => match go_types::get_object(
                    state.world,
                    actual.object,
                ) {
                    Some(actual_object) => if actual_object.kind != go_types::ObjectKind::Func {
                        return "(" + diagnostic_type_string(state, source) + "." + required.name
                            + " is a field, not a method)"
                    } else if !go_types::identical(
                        state.world,
                        actual_object.type_id,
                        required.type_id,
                    ) {
                        let have = diagnostic_method_string(state, actual.object);
                        let want = diagnostic_method_string(state, required_id);
                        return "(wrong type for method " + required.name + ")"
                            + if have == want {
                                ""
                            } else {
                                "\n\t\thave " + have + "\n\t\twant " + want
                            }
                    },
                    None => return "(missing method " + required.name + ")",
                },
                go_types::FieldOrMethodLookup::Ambiguous => return "(ambiguous selector "
                    + diagnostic_type_string(state, source)
                    + "."
                    + required.name
                    + ")",
                go_types::FieldOrMethodLookup::Missing => {
                    match similar_method_object_in_type(state, source, required.name, false) {
                        Some(actual) => return "(missing method " + required.name + ")\n\t\thave "
                            + diagnostic_method_string(state, actual)
                            + "\n\t\twant "
                            + diagnostic_method_string(state, required_id),
                        None => {},
                    }
                    let pointer = go_types::add_type(
                        state.world,
                        go_types::TypeKind::Pointer { element: source },
                    );
                    match go_types::lookup_field_or_method_detailed(
                        state.world,
                        pointer,
                        false,
                        required.name,
                    ) {
                        go_types::FieldOrMethodLookup::Found(actual) => match go_types::get_object(
                            state.world,
                            actual.object,
                        ) {
                            Some(actual_object) => if go_types::identical(
                                state.world,
                                actual_object.type_id,
                                required.type_id,
                            ) {
                                return "(method " + required.name + " has pointer receiver)"
                            },
                            None => {},
                        },
                        _ => {},
                    }
                    return "(missing method " + required.name + ")"
                },
            },
            None => {},
        }
    }
    ""
}

fn implementation_type_string(state: CheckState, value: go_types::TypeId) -> string {
    diagnostic_type_string(state, go_types::unalias(state.world, value))
}

fn core_type_id(state: CheckState, value: go_types::TypeId) -> go_types::TypeId {
    go_types::core_type(state.world, value).unwrap_or(state.world.invalid)
}

fn checked_object_index(state: CheckState, object: go_types::ObjectId) -> isize {
    if object.value >= 0 && object.value < state.world.objects.len() {
        object.value
    } else {
        -1
    }
}

fn pointer_to_interface_type(state: CheckState, value: go_types::TypeId) -> bool {
    match go_types::type_data(state.world, core_type_id(state, value)) {
        go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } } => go_types::is_interface(
            state.world,
            element,
        ),
        _ => false,
    }
}

fn type_contains_invalid_inner(state: CheckState, type_id: go_types::TypeId, generation: isize) -> bool {
    if !go_types::has_type(state.world, type_id) {
        return true
    }
    if state.type_visit_marks.len() <= type_id.value {
        state.type_visit_marks.reserve(type_id.value + 1 - state.type_visit_marks.len());
        while state.type_visit_marks.len() <= type_id.value {
            state.type_visit_marks.push(0)
        }
    }
    if state.type_visit_marks[type_id.value] == generation {
        return false
    }
    state.type_visit_marks[type_id.value] = generation;
    match go_types::type_data(state.world, type_id) {
        go_types::TypeData { id: _, kind: go_types::TypeKind::Invalid } => true,
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Array { length: _, element } | go_types::TypeKind::Slice {
                element,
            } | go_types::TypeKind::Pointer { element } | go_types::TypeKind::Chan {
                direction: _,
                element,
            },
        } => type_contains_invalid_inner(state, element, generation),
        go_types::TypeData { id: _, kind: go_types::TypeKind::Map { key, value } } => type_contains_invalid_inner(
            state,
            key,
            generation,
        )
            || type_contains_invalid_inner(state, value, generation),
        go_types::TypeData { id: _, kind: go_types::TypeKind::Tuple { variables } } => {
            for variable in variables {
                if type_contains_invalid_inner(state, variable.type_id, generation) {
                    return true
                }
            }
            false
        },
        go_types::TypeData { id: _, kind: go_types::TypeKind::Struct { fields } } => {
            for field in fields {
                if type_contains_invalid_inner(state, field.variable.type_id, generation) {
                    return true
                }
            }
            false
        },
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Interface { methods, embeddeds, comparable: _, implicit: _ },
        } => {
            for method in methods {
                if method.value < 0 || method.value >= state.world.objects.len() {
                    return true
                }
                if type_contains_invalid_inner(
                    state,
                    state.world.objects[method.value].type_id,
                    generation,
                ) {
                    return true
                }
            }
            for embedded in embeddeds {
                if type_contains_invalid_inner(state, embedded, generation) {
                    return true
                }
            }
            false
        },
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver,
                receiver_type_params: _,
                type_params: _,
                params,
                results,
                variadic: _,
            },
        } => {
            match receiver {
                Some(receiver) => if type_contains_invalid_inner(
                    state,
                    receiver.type_id,
                    generation,
                ) {
                    return true
                },
                None => {},
            }
            type_contains_invalid_inner(state, params, generation)
                || type_contains_invalid_inner(state, results, generation)
        },
        go_types::TypeData { id: _, kind: go_types::TypeKind::Union { terms } } => {
            for term in terms {
                if type_contains_invalid_inner(state, term.type_id, generation) {
                    return true
                }
            }
            false
        },
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object: _,
                underlying,
                type_params: _,
                type_args: _,
                methods: _,
            },
        } | go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Alias {
                object: _,
                rhs: underlying,
                type_params: _,
                type_args: _,
            },
        } => type_contains_invalid_inner(state, underlying, generation),
        _ => false,
    }
}

fn type_contains_invalid(state: CheckState, type_id: go_types::TypeId) -> bool {
    if !go_types::has_type(state.world, type_id) {
        return true
    }
    if state.type_invalid_cache.len() <= type_id.value {
        state.type_invalid_cache.reserve(type_id.value + 1 - state.type_invalid_cache.len());
        while state.type_invalid_cache.len() <= type_id.value {
            state.type_invalid_cache.push(0.to_i32())
        }
    }
    let revision = go_types::type_revision(state.world);
    let cached = state.type_invalid_cache[type_id.value];
    if cached == revision {
        return false
    } else if cached == -revision {
        return true
    }
    let generation = state.type_visit_generation.get() + 1;
    state.type_visit_generation.set(generation);
    let result = type_contains_invalid_inner(state, type_id, generation);
    state.type_invalid_cache[type_id.value] = if result {
        -revision
    } else {
        revision
    };
    result
}

fn type_contains_active_type_inner(
    state: CheckState,
    type_id: go_types::TypeId,
    visited: Vec[isize],
) -> bool {
    for existing in visited {
        if existing == type_id.value {
            return false
        }
    }
    visited.push(type_id.value);
    match go_types::get_type(state.world, type_id) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object,
                underlying,
                type_params: _,
                type_args: _,
                methods: _,
            },
        }) => {
            for active in state.active_type_objects {
                if active.value == object.value {
                    return true
                }
            }
            type_contains_active_type_inner(state, underlying, visited)
        },
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Array { length: _, element } | go_types::TypeKind::Slice {
                element,
            } | go_types::TypeKind::Pointer { element } | go_types::TypeKind::Chan {
                direction: _,
                element,
            },
        }) => type_contains_active_type_inner(state, element, visited),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Map { key, value } }) => type_contains_active_type_inner(
            state,
            key,
            visited,
        )
            || type_contains_active_type_inner(state, value, visited),
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Alias { object: _, rhs, type_params: _, type_args: _ },
        }) => type_contains_active_type_inner(state, rhs, visited),
        _ => false,
    }
}

fn type_contains_active_type(state: CheckState, type_id: go_types::TypeId) -> bool {
    type_contains_active_type_inner(state, type_id, Vec::new())
}

fn invalid_source_assignment_recoverable(state: CheckState, type_id: go_types::TypeId) -> bool {
    match go_types::type_data(state.world, go_types::unalias(state.world, type_id)) {
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: _,
                receiver_type_params: _,
                type_params: _,
                params: _,
                results: _,
                variadic: _,
            },
        } => false,
        _ => true,
    }
}

fn recorded_type_fact(state: CheckState, node: syntax::NodeId) -> Option[TypeFact] {
    type_fact_index(state, node).map(|index| state.info.types[index])
}

fn snapshot_signature_type(state: CheckState, type_id: go_types::TypeId) -> go_types::TypeId {
    match go_types::type_data(state.world, type_id).kind {
        go_types::TypeKind::Signature {
            receiver,
            receiver_type_params,
            type_params,
            params,
            results,
            variadic,
        } => go_types::add_type(
            state.world,
            go_types::TypeKind::Signature {
                receiver,
                receiver_type_params,
                type_params,
                params,
                results,
                variadic,
            },
        ),
        _ => type_id,
    }
}

fn expression_has_comma_ok(state: CheckState, node: syntax::NodeId) -> bool {
    match syntax::get_node(state.syntax.arena, node) {
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::IndexExpr { expression, lbrack: _, index: _, rbrack: _ },
        }) => match recorded_type_fact(state, expression) {
            Some(fact) => match go_types::type_data(state.world, core_type_id(state, fact.type_id)).kind {
                go_types::TypeKind::Map { key: _, value: _ } => true,
                _ => false,
            },
            None => false,
        },
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::IndexListExpr { expression, lbrack: _, indices: _, rbrack: _ },
        }) => match recorded_type_fact(state, expression) {
            Some(fact) => match go_types::type_data(state.world, core_type_id(state, fact.type_id)).kind {
                go_types::TypeKind::Map { key: _, value: _ } => true,
                _ => false,
            },
            None => false,
        },
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::TypeAssertExpr {
                expression: _,
                lparen: _,
                type_node: Some(_),
                rparen: _,
            },
        }) => true,
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::UnaryExpr { op_pos: _, op, expression: _ },
        }) => op == RECEIVE_OPERATOR,
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ },
        }) => match recorded_type_fact(state, expression) {
            Some(fact) => fact.comma_ok,
            None => false,
        },
        _ => false,
    }
}

fn failed_inherited_initializer_operand(state: CheckState, node: syntax::NodeId, operand: Operand) -> bool {
    if operand.type_id.value != state.world.invalid.value || state.active_value_objects.is_empty() {
        return false
    }
    match pending_value_index(
        state,
        state.active_value_objects[state.active_value_objects.len() - 1],
    ) {
        Some(index) => if state.pending_values[index].inherited_initializer {
            for value_node in state.pending_values[index].value_nodes {
                if value_node.value == node.value {
                    return true
                }
            }
            false
        } else {
            false
        },
        None => false,
    }
}

fn record_operand(state: CheckState, node: syntax::NodeId, operand: Operand) -> () {
    match type_fact_index(state, node) {
        Some(index) => {
            if state.preserved_type_fact_nodes.contains(node.value)
                || failed_inherited_initializer_operand(state, node, operand) {
                return
            }
            let fact = state.info.types[index];
            if fact.type_expr || fact.builtin {
                return
            }
            if (fact.type_id.value == state.world.invalid.value
                && operand.type_id.value != state.world.invalid.value)
                || state.current_iota >= 0 {
                let extra = match operand.value {
                    Some(value) => type_fact_value_extra(value),
                    None => Option::None,
                };
                state.info.types[index] = TypeFact {
                    node: fact.node,
                    type_id: operand.type_id,
                    extra,
                    void: fact.void,
                    type_expr: fact.type_expr,
                    builtin: fact.builtin,
                    value_expr: true,
                    nil: basic_kind(state, operand.type_id) == go_types::BasicKind::UntypedNil,
                    addressable: operand.addressable,
                    assignable: operand.assignable,
                    comma_ok: fact.comma_ok,
                };
            }
            return
        },
        None => {},
    }
    match source_type_fact_index(state, node) {
        Some(index) => {
            set_type_fact_index(state, node, index);
            return
        },
        None => {},
    }
    index_type_fact(state, node, state.info.types.len());
    let void = node_is_void(state, node);
    let fact_type = if void {
        go_types::add_type(state.world, go_types::TypeKind::Tuple { variables: Vec::new() })
    } else {
        operand.type_id
    };
    state.info.types.push(
        TypeFact {
            node,
            type_id: fact_type,
            extra: operand.value.and_then(|value| type_fact_value_extra(value)),
            void,
            type_expr: false,
            builtin: false,
            value_expr: !void,
            nil: basic_kind(state, operand.type_id) == go_types::BasicKind::UntypedNil,
            addressable: operand.addressable,
            assignable: operand.assignable,
            comma_ok: operand.type_id.value != state.world.invalid.value
                && expression_has_comma_ok(state, node),
        },
    )
}

fn preserve_inherited_type_fact(state: CheckState, node: syntax::NodeId) -> () {
    if state.current_iota < 0 {
        return
    }
    match recorded_type_fact(state, node) {
        Some(fact) => if fact.type_id.value != state.world.invalid.value {
            let _ = state.preserved_type_fact_nodes.insert(node.value);
        },
        None => {},
    }
}

fn update_operand_fact(
    state: CheckState,
    node: syntax::NodeId,
    type_id: go_types::TypeId,
    value: Option[constant::ConstValue],
) -> () {
    match type_fact_index(state, node) {
        Some(index) => {
            let fact = state.info.types[index];
            let extra = match value {
                Some(value) => type_fact_value_extra(value),
                None => fact.extra,
            };
            state.info.types[index] = TypeFact {
                node: fact.node,
                type_id,
                extra,
                void: fact.void,
                type_expr: fact.type_expr,
                builtin: fact.builtin,
                value_expr: fact.value_expr,
                nil: fact.nil,
                addressable: fact.addressable,
                assignable: fact.assignable,
                comma_ok: fact.comma_ok,
            };
        },
        None => {},
    }
}

fn contextualize_untyped_component(
    state: CheckState,
    node: syntax::NodeId,
    target: go_types::TypeId,
) -> () {
    match recorded_type_fact(state, node) {
        Some(fact) => match fact.extra.and_then(|extra| extra.constant) {
            Some(_) => match type_fact_value(fact) {
                Some(value) => if (go_types::is_type_parameter(state.world, target)
                    && constant_assignable_to_type_parameter(state, value, target))
                    || (!go_types::is_type_parameter(state.world, target)
                        && constant::convert_constant(
                            value,
                            basic_kind(state, target),
                            state.config.sizes,
                        ).is_some()) {
                    contextualize_untyped_expression(state, node, target, false)
                },
                None => {},
            },
            None => contextualize_untyped_expression(state, node, target, false),
        },
        None => {},
    }
}

fn contextualize_untyped_expression(
    state: CheckState,
    node: syntax::NodeId,
    target: go_types::TypeId,
    convert_value: bool,
) -> () {
    match recorded_type_fact(state, node) {
        Some(fact) => if go_types::is_untyped(state.world, fact.type_id)
            && (go_types::is_numeric(state.world, fact.type_id)
                || basic_kind(state, fact.type_id) == go_types::BasicKind::UntypedBool)
            && !go_types::is_untyped(state.world, target) {
            let paren_expression = match syntax::get_node(state.syntax.arena, node) {
                Some(syntax::SyntaxNode {
                    id: _,
                    file: _,
                    span: _,
                    path: _,
                    kind: syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ },
                }) => Option::Some(expression),
                _ => Option::None,
            };
            match paren_expression {
                Some(expression) => contextualize_untyped_expression(
                    state,
                    expression,
                    target,
                    false,
                ),
                None => {},
            }
            let mut valid = true;
            match fact.extra.and_then(|extra| extra.constant) {
                Some(_) => match type_fact_value(fact) {
                    Some(value) => if go_types::is_type_parameter(state.world, target)
                        && constant_assignable_to_type_parameter(state, value, target) {
                        update_operand_fact(state, node, target, Option::Some(value))
                    } else {
                        match constant::convert_constant(
                            value,
                            basic_kind(state, target),
                            state.config.sizes,
                        ) {
                            Some(converted) => update_operand_fact(
                                state,
                                node,
                                target,
                                Option::Some(
                                    if convert_value {
                                        converted
                                    } else {
                                        value
                                    },
                                ),
                            ),
                            None => {
                                let operand = Operand {
                                    type_id: fact.type_id,
                                    value: Option::Some(value),
                                    addressable: false,
                                    assignable: false,
                                };
                                diagnostic(
                                    state,
                                    node,
                                    if go_types::is_numeric(state.world, fact.type_id)
                                        && !go_types::is_integer(state.world, fact.type_id)
                                        && go_types::is_integer(state.world, target) {
                                        operand_string(state, node, operand) + " truncated to "
                                            + diagnostic_type_string(state, target)
                                    } else if go_types::is_type_parameter(state.world, target) {
                                        "cannot convert " + operand_string(state, node, operand)
                                            + " to type "
                                            + diagnostic_type_string(state, target)
                                    } else if go_types::is_integer(state.world, fact.type_id)
                                        && go_types::is_integer(state.world, target) {
                                        operand_string(state, node, operand) + " overflows "
                                            + diagnostic_type_string(state, target)
                                    } else {
                                        "cannot convert " + operand_string(state, node, operand)
                                            + " to type "
                                            + diagnostic_type_string(state, target)
                                    },
                                    false,
                                );
                                valid = false;
                                if !convert_value {
                                    let _ = state.omitted_type_fact_nodes.insert(node.value);
                                }
                            },
                        }
                    },
                    None => {},
                },
                None => update_operand_fact(state, node, target, Option::None),
            }
            if valid && !type_fact_has_constant(fact)
                && (go_types::is_numeric(state.world, fact.type_id)
                    || basic_kind(state, fact.type_id) == go_types::BasicKind::UntypedBool) {
                match syntax::get_node(state.syntax.arena, node) {
                    Some(syntax::SyntaxNode {
                        id: _,
                        file: _,
                        span: _,
                        path: _,
                        kind: syntax::SyntaxKind::BinaryExpr { left, op_pos: _, op, right },
                    }) => {
                        if shift_operator(op) && !type_fact_has_constant(fact)
                            && !go_types::is_integer(state.world, target) {
                            diagnostic(
                                state,
                                left,
                                "invalid operation: shifted operand "
                                    + expression_source_text(state, left)
                                    + " (type "
                                    + diagnostic_type_string(state, target)
                                    + ") must be integer",
                                false,
                            );
                            let _ = state.omitted_type_fact_nodes.insert(left.value);
                        }
                        contextualize_untyped_expression(state, left, target, false);
                        if !shift_operator(op) {
                            contextualize_untyped_expression(state, right, target, false)
                        }
                    },
                    Some(syntax::SyntaxNode {
                        id: _,
                        file: _,
                        span: _,
                        path: _,
                        kind: syntax::SyntaxKind::ParenExpr { lparen: _, expression: _, rparen: _ },
                    }) => {},
                    Some(syntax::SyntaxNode {
                        id: _,
                        file: _,
                        span: _,
                        path: _,
                        kind: syntax::SyntaxKind::UnaryExpr { op_pos: _, op: _, expression },
                    }) => contextualize_untyped_expression(state, expression, target, false),
                    _ => {},
                }
            }
        },
        None => {},
    }
}

fn update_contextual_operand_fact(
    state: CheckState,
    node: syntax::NodeId,
    operand: Operand,
    target: go_types::TypeId,
) -> () {
    if target.value == state.world.invalid.value
        || operand.type_id.value == state.world.invalid.value
        || !go_types::is_untyped(state.world, operand.type_id) {
        return
    }
    if go_types::is_untyped(state.world, target) {
        retag_untyped_expression(state, node, target);
        return
    }
    if !go_types::is_interface(state.world, target)
        && !go_types::is_type_parameter(state.world, target)
        && ((is_string_type(state, operand.type_id) || is_string_type(state, target))
            && !(is_string_type(state, operand.type_id) && is_string_type(state, target))
            || (is_boolean_type(state, operand.type_id) || is_boolean_type(state, target))
                && !(is_boolean_type(state, operand.type_id) && is_boolean_type(state, target))) {
        return
    }
    match operand.value {
        Some(value) => {
            if constant::constant_kind(value) == constant::ConstantKind::Unknown {
                update_operand_fact(
                    state,
                    node,
                    if go_types::is_interface(state.world, target) {
                        default_operand_type(state, operand)
                    } else {
                        target
                    },
                    Option::Some(value),
                )
            } else if go_types::is_type_parameter(state.world, target) {
                if constant_assignable_to_type_parameter(state, value, target) {
                    contextualize_untyped_expression(state, node, target, true)
                }
            } else {
                let target_kind = basic_kind(state, target);
                if target_kind != go_types::BasicKind::Invalid
                    && target_kind != go_types::BasicKind::UnsafePointer {
                    match constant::convert_constant(value, target_kind, state.config.sizes) {
                        Some(converted) => {
                            match syntax::get_node(state.syntax.arena, node) {
                                Some(syntax::SyntaxNode {
                                    id: _,
                                    file: _,
                                    span: _,
                                    path: _,
                                    kind: syntax::SyntaxKind::ParenExpr {
                                        lparen: _,
                                        expression,
                                        rparen: _,
                                    },
                                }) => contextualize_untyped_component(state, expression, target),
                                _ => {},
                            }
                            update_operand_fact(state, node, target, Option::Some(converted))
                        },
                        None => {},
                    }
                } else if go_types::is_interface(state.world, target) {
                    match default_type_for_kind(state, basic_kind(state, operand.type_id)) {
                        Some(type_id) => {
                            let rounded = constant::round_constant(
                                value,
                                basic_kind(state, type_id),
                                state.config.sizes,
                            ).unwrap_or(value);
                            update_operand_fact(state, node, type_id, Option::Some(rounded))
                        },
                        None => {},
                    }
                }
            }
        },
        None => if go_types::is_untyped(state.world, operand.type_id)
            && (go_types::is_numeric(state.world, operand.type_id)
                || basic_kind(state, operand.type_id) == go_types::BasicKind::UntypedBool)
            && !go_types::is_untyped(state.world, target) {
            contextualize_untyped_expression(
                state,
                node,
                if go_types::is_interface(state.world, target) {
                    default_operand_type(state, operand)
                } else {
                    target
                },
                true,
            )
        },
    }
}

fn retag_untyped_expression(state: CheckState, node: syntax::NodeId, target: go_types::TypeId) -> () {
    match type_fact_index(state, node) {
        Some(index) => if go_types::is_untyped(state.world, state.info.types[index].type_id) {
            state.info.types[index].type_id = target;
        },
        None => {},
    }
}

fn save_constant(state: CheckState, object: go_types::ObjectId, value: constant::ConstValue) -> () {
    state.constants[object.value] = constant::constant_copy(value);
}

fn find_constant(state: CheckState, object: go_types::ObjectId) -> Option[constant::ConstValue] {
    if let Some(value) = state.constants[object.value] {
        return Option::Some(constant::constant_copy(value))
    }
    let index = checked_object_index(state, object);
    if index < 0 {
        return Option::None
    }
    let value = state.world.objects[index];
    if value.name == "iota" {
        Option::Some(
            constant::ConstValue::Int(constant::integer_from_int64(state.current_iota.to_i64())),
        )
    } else {
        match value.constant {
            Some(exact) => constant::constant_from_exact(value.constant_kind, exact),
            None => if value.name == "true" {
                Option::Some(constant::ConstValue::Bool(true))
            } else if value.name == "false" {
                Option::Some(constant::ConstValue::Bool(false))
            } else {
                Option::None
            },
        }
    }
}

fn literal_operand(state: CheckState, node: syntax::NodeId, token: string, value: string) -> Operand {
    if numeric_literal_token(token) && !go_version_at_least(state, node, 13) {
        if value.contains("_") {
            diagnostic(state, node, "underscore in numeric literal requires go1.13 or later", false)
        } else if value.starts_with("0b") || value.starts_with("0B") {
            diagnostic(state, node, "binary literal requires go1.13 or later", false)
        } else if value.starts_with("0o") || value.starts_with("0O") {
            diagnostic(state, node, "0o/0O-style octal literal requires go1.13 or later", false)
        } else if floating_literal_token(token)
            && (value.starts_with("0x") || value.starts_with("0X")) {
            diagnostic(
                state,
                node,
                "hexadecimal floating-point literal requires go1.13 or later",
                false,
            )
        }
    }
    let parsed = match token {
        INT_LITERAL_TOKEN => constant::parse_integer_literal(value),
        FLOAT_LITERAL_TOKEN => constant::parse_float_literal(value),
        IMAG_LITERAL_TOKEN => constant::parse_imaginary_literal(value),
        CHAR_LITERAL_TOKEN => constant::parse_rune_literal(value),
        STRING_LITERAL_TOKEN => constant::parse_string_literal(value),
        _ => Result::Err("unsupported literal kind " + token),
    };
    let type_id = match token {
        INT_LITERAL_TOKEN => basic_type_id(state, "untyped int"),
        FLOAT_LITERAL_TOKEN => basic_type_id(state, "untyped float"),
        IMAG_LITERAL_TOKEN => basic_type_id(state, "untyped complex"),
        CHAR_LITERAL_TOKEN => basic_type_id(state, "untyped rune"),
        STRING_LITERAL_TOKEN => basic_type_id(state, "untyped string"),
        _ => state.world.invalid,
    };
    match parsed {
        Ok(value) => if token == INT_LITERAL_TOKEN
            && constant::constant_exceeds_integer_precision(value, 512) {
            diagnostic(state, node, "constant overflow", false);
            Operand {
                type_id,
                value: Option::Some(constant::ConstValue::Unknown),
                addressable: false,
                assignable: false,
            }
        } else {
            Operand { type_id, value: Option::Some(value), addressable: false, assignable: false }
        },
        Err(message) => {
            diagnostic(
                state,
                node,
                "malformed constant: "
                    + if message == "exponent is too large" {
                        value
                    } else {
                        message
                    },
                false,
            );
            invalid_operand(state)
        },
    }
}

fn signed_integer_type(state: CheckState, value: go_types::TypeId) -> bool {
    match basic_kind(state, value) {
        go_types::BasicKind::Int | go_types::BasicKind::Int8 | go_types::BasicKind::Int16 | go_types::BasicKind::Int32 | go_types::BasicKind::Int64 => true,
        _ => false,
    }
}

fn identifier_operand(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    name: string,
) -> Operand {
    match go_types::lookup(state.world, scope, name) {
        Some(object_id) => {
            record_initialization_dependency(state, object_id);
            evaluate_object(state, object_id);
            record_type_value_cycle(state, object_id);
            if object_id.value < 0 || object_id.value >= state.world.objects.len() {
                return invalid_operand(state)
            }
            let object = state.world.objects[object_id.value];
            mark_dot_import_used(state, object_id);
            record_use(state, node, object_id);
            if object.owner.is_none() && (name == "any" || name == "comparable")
                && !go_version_at_least(state, node, 18) {
                diagnostic(state, node, "predeclared " + name + " requires go1.18 or later", false);
                invalid_operand(state)
            } else if object.kind == go_types::ObjectKind::Const {
                if object.name == "iota" && state.current_iota < 0 {
                    diagnostic(state, node, "cannot use iota outside constant declaration", false);
                    invalid_operand(state)
                } else {
                    Operand {
                        type_id: object.type_id,
                        value: find_constant(state, object_id),
                        addressable: false,
                        assignable: false,
                    }
                }
            } else if object.kind == go_types::ObjectKind::Var {
                if state.active_type_objects.is_empty()
                    && type_value_cycle_contains(state, object_id) {
                    invalid_operand(state)
                } else {
                    Operand {
                        type_id: if go_types::has_type(state.world, object.type_id)
                            && match go_types::type_data(state.world, object.type_id).kind {
                                go_types::TypeKind::Invalid => true,
                                _ => false,
                            } {
                            state.world.invalid
                        } else {
                            object.type_id
                        },
                        value: Option::None,
                        addressable: true,
                        assignable: true,
                    }
                }
            } else if object.kind == go_types::ObjectKind::Func {
                publish_active_initializer_root_type(state, node, object.type_id);
                evaluate_function_dependency(state, object_id);
                if state.generic_function_context_depth.get() == 0
                    && !generic_parameters(state, object.type_id).is_empty() {
                    diagnostic(
                        state,
                        node,
                        "cannot use generic function " + name + " without instantiation",
                        false,
                    );
                    invalid_operand(state)
                } else {
                    Operand {
                        type_id: object.type_id,
                        value: Option::None,
                        addressable: false,
                        assignable: false,
                    }
                }
            } else if object.kind == go_types::ObjectKind::Nil {
                Operand {
                    type_id: object.type_id,
                    value: Option::None,
                    addressable: false,
                    assignable: false,
                }
            } else if object.kind == go_types::ObjectKind::TypeName {
                record_type_expression(state, node, object.type_id);
                diagnostic(state, node, name + " (type) is not an expression", false);
                invalid_operand(state)
            } else if object.kind == go_types::ObjectKind::PackageName {
                diagnostic(state, node, "use of package " + name + " not in selector", false);
                invalid_operand(state)
            } else if object.kind == go_types::ObjectKind::Builtin {
                record_builtin_reference(
                    state,
                    BuiltinReference { name, object: object_id, node, fact_node: node },
                );
                diagnostic(state, node, name + " (built-in) must be called", false);
                invalid_operand(state)
            } else {
                diagnostic(state, node, name + " is not a value", false);
                invalid_operand(state)
            }
        },
        None => {
            diagnostic(state, node, "undefined: " + name, false);
            invalid_operand(state)
        },
    }
}

fn builtin_expression(state: CheckState, scope: go_types::ScopeId, node: syntax::NodeId) -> Option[
    (go_types::ObjectId, string),
] {
    match builtin_reference(state, scope, node) {
        Some(reference) => {
            record_builtin_reference(state, reference);
            Option::Some((reference.object, reference.name))
        },
        _ => Option::None,
    }
}

fn resolve_conversion_type(state: CheckState, scope: go_types::ScopeId, node: syntax::NodeId) -> go_types::TypeId {
    state.constraint_type_depth += 1;
    let result = resolve_type(state, scope, node);
    state.constraint_type_depth -= 1;
    result
}

fn recovered_conversion_target(
    state: CheckState,
    resolved: go_types::TypeId,
    declared: go_types::TypeId,
) -> go_types::TypeId {
    if resolved.value != state.world.invalid.value || declared.value == state.world.invalid.value {
        return resolved
    }
    if !generic_parameters(state, declared).is_empty() {
        resolved
    } else {
        declared
    }
}

fn conversion_target(state: CheckState, scope: go_types::ScopeId, node: syntax::NodeId) -> Option[
    go_types::TypeId,
] {
    match syntax::get_node(state.syntax.arena, node) {
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::Ident { name_pos: _, name },
        }) => match go_types::lookup(state.world, scope, name) {
            Some(object) => {
                let index = checked_object_index(state, object);
                if index >= 0 && state.world.objects[index].kind == go_types::ObjectKind::TypeName {
                    let declared = state.world.objects[index].type_id;
                    let previous = state.generic_type_short_diagnostic;
                    state.generic_type_short_diagnostic = true;
                    let result = resolve_conversion_type(state, scope, node);
                    state.generic_type_short_diagnostic = previous;
                    Option::Some(recovered_conversion_target(state, result, declared))
                } else {
                    Option::None
                }
            },
            None => Option::None,
        },
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::SelectorExpr { expression, selector },
        }) => match identifier(state, expression) {
            Some(name) => match go_types::lookup(state.world, scope, name) {
                Some(object) => {
                    let object_index = checked_object_index(state, object);
                    if object_index < 0 {
                        return Option::None
                    }
                    match state.world.objects[object_index].imported_package {
                        Some(pkg) => {
                            let member = identifier(state, selector).unwrap_or("");
                            if state.config.fake_import_c
                                && state.world.packages[pkg.value].path == "C" {
                                mark_import_used(state, object);
                                record_use(state, expression, object);
                                return Option::None
                            }
                            match go_types::lookup_local(
                                state.world,
                                state.world.packages[pkg.value].scope,
                                member,
                            ) {
                                Some(member) => {
                                    let member_index = checked_object_index(state, member);
                                    if member_index >= 0
                                        && state.world.objects[member_index].kind
                                            == go_types::ObjectKind::TypeName {
                                        let declared = state.world.objects[member_index].type_id;
                                        let previous = state.generic_type_short_diagnostic;
                                        state.generic_type_short_diagnostic = true;
                                        let result = resolve_conversion_type(state, scope, node);
                                        state.generic_type_short_diagnostic = previous;
                                        Option::Some(
                                            recovered_conversion_target(state, result, declared),
                                        )
                                    } else {
                                        Option::None
                                    }
                                },
                                None => Option::None,
                            }
                        },
                        None => Option::None,
                    }
                },
                None => Option::None,
            },
            None => Option::None,
        },
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ },
        }) => conversion_target(state, scope, expression).map(
            |_| resolve_conversion_type(state, scope, node),
        ),
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::StarExpr { star: _, expression },
        }) => conversion_target(state, scope, expression).map(
            |_| resolve_conversion_type(state, scope, node),
        ),
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::ArrayType { lbrack: _, length: _, element: _ } | syntax::SyntaxKind::StructType {
                struct_pos: _,
                fields: _,
                incomplete: _,
            } | syntax::SyntaxKind::FuncType { func_pos: _, type_params: _, params: _, results: _ } | syntax::SyntaxKind::InterfaceType {
                interface_pos: _,
                methods: _,
                incomplete: _,
            } | syntax::SyntaxKind::MapType { map_pos: _, key: _, value: _ } | syntax::SyntaxKind::ChanType {
                begin: _,
                arrow: _,
                direction: _,
                value: _,
            },
        }) => Option::Some(resolve_conversion_type(state, scope, node)),
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::IndexExpr { expression, lbrack: _, index: _, rbrack: _ } | syntax::SyntaxKind::IndexListExpr {
                expression,
                lbrack: _,
                indices: _,
                rbrack: _,
            },
        }) => {
            state.generic_type_origin_depth += 1;
            let origin = conversion_target(state, scope, expression);
            state.generic_type_origin_depth -= 1;
            origin.map(|_| resolve_conversion_type(state, scope, node))
        },
        _ => Option::None,
    }
}

fn check_conversion(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    target: go_types::TypeId,
    arguments: Vec[syntax::NodeId],
    ellipsis: isize,
) -> Operand {
    if target.value == state.world.invalid.value {
        let uninstantiated_generic = match syntax::get_node(state.syntax.arena, node) {
            Some(syntax::SyntaxNode {
                id: _,
                file: _,
                span: _,
                path: _,
                kind: syntax::SyntaxKind::CallExpr {
                    function,
                    lparen: _,
                    arguments: _,
                    ellipsis: _,
                    rparen: _,
                },
            }) => match recorded_type_fact(state, function) {
                Some(fact) => !generic_parameters(state, fact.type_id).is_empty(),
                None => false,
            },
            _ => false,
        };
        if uninstantiated_generic {
            match syntax::get_node(state.syntax.arena, node) {
                Some(syntax::SyntaxNode {
                    id: _,
                    file: _,
                    span: _,
                    path: _,
                    kind: syntax::SyntaxKind::CallExpr {
                        function,
                        lparen: _,
                        arguments: _,
                        ellipsis: _,
                        rparen: _,
                    },
                }) => {
                    let _ = state.omitted_type_fact_nodes.remove(function.value);
                },
                _ => {},
            }
        }
        let retain_invalid = match syntax::get_node(state.syntax.arena, node) {
            Some(syntax::SyntaxNode {
                id: _,
                file: _,
                span: _,
                path: _,
                kind: syntax::SyntaxKind::CallExpr {
                    function,
                    lparen: _,
                    arguments: _,
                    ellipsis: _,
                    rparen: _,
                },
            }) => match syntax::get_node(state.syntax.arena, function) {
                Some(syntax::SyntaxNode {
                    id: _,
                    file: _,
                    span: _,
                    path: _,
                    kind: syntax::SyntaxKind::ArrayType {
                        lbrack: _,
                        length: Some(length),
                        element: _,
                    },
                }) => match syntax::get_node(state.syntax.arena, length) {
                    Some(syntax::SyntaxNode {
                        id: _,
                        file: _,
                        span: _,
                        path: _,
                        kind: syntax::SyntaxKind::Ellipsis { ellipsis: _, element: _ },
                    }) => true,
                    _ => false,
                },
                _ => false,
            },
            _ => false,
        };
        if retain_invalid {
            let _ = state.retained_invalid_type_fact_nodes.insert(node.value);
        }
        if !uninstantiated_generic {
            for argument in arguments {
                let operand = check_expression(state, scope, argument);
                if retain_invalid {
                    update_contextual_operand_fact(
                        state,
                        argument,
                        operand,
                        default_operand_type(state, operand),
                    )
                }
            }
        }
        return if retain_invalid {
            Operand {
                type_id: state.world.invalid,
                value: Option::None,
                addressable: false,
                assignable: false,
            }
        } else {
            invalid_operand(state)
        }
    }
    if ellipsis >= 0 {
        diagnostic(
            state,
            arguments[0],
            "invalid use of ... in conversion to " + diagnostic_type_string(state, target),
            false,
        )
    }
    if arguments.is_empty() {
        let position = match syntax::get_node(state.syntax.arena, node) {
            Some(syntax::SyntaxNode {
                id: _,
                file: _,
                span: _,
                path: _,
                kind: syntax::SyntaxKind::CallExpr {
                    function: _,
                    lparen: _,
                    arguments: _,
                    ellipsis: _,
                    rparen,
                },
            }) => rparen,
            _ => node_start(state, node),
        };
        diagnostic_at_position(
            state,
            node,
            position,
            "missing argument in conversion to " + diagnostic_type_string(state, target),
            false,
        );
        return invalid_operand(state)
    } else if arguments.len() > 1 {
        for argument in arguments {
            let _ = check_expression(state, scope, argument);
        }
        diagnostic(
            state,
            arguments[arguments.len() - 1],
            "too many arguments in conversion to " + diagnostic_type_string(state, target),
            false,
        );
        return invalid_operand(state)
    }
    if go_types::is_constraint_interface(state.world, target) {
        let source = check_expression(state, scope, arguments[0]);
        let recovered_type = default_operand_type(state, source);
        diagnostic(
            state,
            node,
            "cannot use interface " + diagnostic_type_string(state, target)
                + " in conversion (contains specific type constraints or is comparable)",
            false,
        );
        return if source.type_id.value == state.world.invalid.value {
            invalid_operand(state)
        } else {
            Operand {
                type_id: recovered_type,
                value: source.value.map(|value| constant::constant_copy(value)),
                addressable: false,
                assignable: false,
            }
        }
    }
    let source = check_expression(state, scope, arguments[0]);
    if source.type_id.value == state.world.invalid.value
        || (!go_types::is_named(state.world, source.type_id)
            && type_contains_invalid(state, source.type_id)
            && !type_contains_active_type(state, source.type_id)) {
        return invalid_operand(state)
    }
    if ellipsis >= 0 {
        return Operand {
            type_id: default_operand_type(state, source),
            value: source.value.map(|value| constant::constant_copy(value)),
            addressable: source.addressable,
            assignable: source.assignable,
        }
    }
    if record_active_value_type_cycle(state, target, false) {
        let _ = state.omitted_type_fact_nodes.insert(node.value);
        match syntax::get_node(state.syntax.arena, node) {
            Some(syntax::SyntaxNode {
                id: _,
                file: _,
                span: _,
                path: _,
                kind: syntax::SyntaxKind::CallExpr {
                    function,
                    lparen: _,
                    arguments: _,
                    ellipsis: _,
                    rparen: _,
                },
            }) => {
                let _ = state.omitted_type_fact_nodes.insert(function.value);
            },
            _ => {},
        }
        return Operand {
            type_id: target,
            value: Option::None,
            addressable: false,
            assignable: false,
        }
    }
    let untyped_nonconstant_shift = source.value.is_none()
        && go_types::is_untyped(state.world, source.type_id)
        && go_types::is_numeric(state.world, source.type_id)
        && match syntax::get_node(state.syntax.arena, arguments[0]) {
            Some(syntax::SyntaxNode {
                id: _,
                file: _,
                span: _,
                path: _,
                kind: syntax::SyntaxKind::BinaryExpr { left: _, op_pos: _, op, right: _ },
            }) => shift_operator(op),
            _ => false,
        };
    if untyped_nonconstant_shift {
        let diagnostic_count = state.diagnostics.len();
        contextualize_untyped_expression(state, arguments[0], target, true);
        if state.diagnostics.len() > diagnostic_count {
            return Operand {
                type_id: target,
                value: Option::None,
                addressable: false,
                assignable: false,
            }
        } else if go_types::is_integer(state.world, target) {
            return Operand {
                type_id: target,
                value: Option::None,
                addressable: false,
                assignable: false,
            }
        }
    }
    if ellipsis < 0 && source.value.is_none()
        && go_types::convertible_types(state.world, source.type_id, target) {
        update_contextual_operand_fact(state, arguments[0], source, target)
    }
    let required_version = go_types::conversion_minimum_minor(state.world, source.type_id, target);
    if required_version > 0 && !go_version_at_least(state, node, required_version) {
        diagnostic(
            state,
            arguments[0],
            "cannot convert " + operand_string(state, arguments[0], source) + " to type "
                + diagnostic_type_string(state, target)
                + ": conversion of slice to array"
                + if required_version == 17 {
                    " pointer"
                } else {
                    ""
                }
                + f" requires go1.{required_version} or later",
            false,
        );
        return invalid_operand(state)
    }
    match source.value {
        Some(value) => if go_types::is_type_parameter(state.world, target) {
            let types = go_types::type_set_specific_types(state.world, target);
            if types.is_empty() {
                diagnostic(
                    state,
                    arguments[0],
                    "cannot convert " + expression_source_text(state, arguments[0]) + " ("
                        + diagnostic_type_string(state, source.type_id)
                        + " value) to type "
                        + diagnostic_type_string(state, target)
                        + ": "
                        + diagnostic_type_string(state, target)
                        + " does not contain specific types",
                    false,
                );
                return invalid_operand(state)
            }
            for type_id in types {
                let target_kind = basic_kind(state, type_id);
                let convertible = if target_kind == go_types::BasicKind::Invalid
                    || target_kind == go_types::BasicKind::UnsafePointer {
                    go_types::convertible_types(state.world, source.type_id, type_id)
                } else if (target_kind == go_types::BasicKind::String
                    || target_kind == go_types::BasicKind::UntypedString)
                    && !go_types::is_integer(state.world, source.type_id)
                    && !is_string_type(state, source.type_id) {
                    false
                } else {
                    constant::convert_constant(
                        constant::constant_copy(value),
                        target_kind,
                        state.config.sizes,
                    ).is_some()
                };
                if !convertible {
                    diagnostic(
                        state,
                        arguments[0],
                        "cannot convert " + expression_source_text(state, arguments[0]) + " ("
                            + diagnostic_type_string(state, source.type_id)
                            + " value) to type "
                            + diagnostic_type_string(state, target)
                            + if go_types::is_integer(state.world, source.type_id)
                                && go_types::is_integer(state.world, type_id) {
                                ": constant " + constant::constant_string(value) + " overflows "
                                    + diagnostic_type_string(state, type_id)
                                    + " (in "
                                    + diagnostic_type_string(state, target)
                                    + ")"
                            } else {
                                ": cannot convert " + operand_string(state, arguments[0], source)
                                    + " to type "
                                    + diagnostic_type_string(state, type_id)
                                    + " (in "
                                    + diagnostic_type_string(state, target)
                                    + ")"
                            },
                        false,
                    );
                    return invalid_operand(state)
                }
            }
            if ellipsis < 0 {
                match default_type_for_kind(state, basic_kind(state, source.type_id)) {
                    Some(type_id) => update_operand_fact(
                        state,
                        arguments[0],
                        type_id,
                        Option::Some(value),
                    ),
                    None => {},
                }
            }
            Operand { type_id: target, value: Option::None, addressable: false, assignable: false }
        } else {
            let target_kind = basic_kind(state, target);
            if target_kind != go_types::BasicKind::Invalid
                && target_kind != go_types::BasicKind::UnsafePointer {
                let converted = if (target_kind == go_types::BasicKind::String
                    || target_kind == go_types::BasicKind::UntypedString)
                    && !go_types::is_integer(state.world, source.type_id)
                    && !is_string_type(state, source.type_id) {
                    Option::None
                } else {
                    constant::convert_constant(value, target_kind, state.config.sizes)
                };
                match converted {
                    Some(value) => {
                        if ellipsis < 0 && go_types::is_untyped(state.world, source.type_id)
                            && !(go_types::is_integer(state.world, source.type_id)
                                && is_string_type(state, target)) {
                            update_operand_fact(state, arguments[0], target, source.value)
                        }
                        Operand {
                            type_id: target,
                            value: Option::Some(value),
                            addressable: false,
                            assignable: false,
                        }
                    },
                    None => {
                        if go_types::is_integer(state.world, source.type_id)
                            && go_types::is_integer(state.world, target) {
                            diagnostic(
                                state,
                                arguments[0],
                                "constant " + constant::constant_string(value) + " overflows "
                                    + diagnostic_type_string(state, target),
                                false,
                            )
                        } else {
                            diagnostic(
                                state,
                                arguments[0],
                                "cannot convert " + operand_string(state, arguments[0], source)
                                    + " to type "
                                    + diagnostic_type_string(state, target),
                                false,
                            )
                        }
                        preserve_inherited_type_fact(state, node);
                        invalid_operand(state)
                    },
                }
            } else if go_types::convertible_types(state.world, source.type_id, target) {
                if ellipsis < 0 {
                    match default_type_for_kind(state, basic_kind(state, source.type_id)) {
                        Some(type_id) => update_operand_fact(
                            state,
                            arguments[0],
                            type_id,
                            Option::Some(value),
                        ),
                        None => {},
                    }
                }
                Operand {
                    type_id: target,
                    value: Option::None,
                    addressable: false,
                    assignable: false,
                }
            } else {
                diagnostic(
                    state,
                    arguments[0],
                    "cannot convert " + operand_string(state, arguments[0], source) + " to type "
                        + diagnostic_type_string(state, target),
                    false,
                );
                invalid_operand(state)
            }
        },
        None => if state.array_length_depth > 0 && !state.active_type_objects.is_empty()
            && match go_types::get_type(state.world, go_types::unalias(state.world, target)) {
                Some(go_types::TypeData {
                    id: _,
                    kind: go_types::TypeKind::Named {
                        object,
                        underlying: _,
                        type_params: _,
                        type_args: _,
                        methods: _,
                    },
                }) => object.value
                    == state.active_type_objects[state.active_type_objects.len() - 1].value,
                _ => false,
            } {
            let object = state.active_type_objects[state.active_type_objects.len() - 1];
            state.deferred_direct_type_cycles.push(object);
            Operand { type_id: target, value: Option::None, addressable: false, assignable: false }
        } else if go_types::convertible_types(state.world, source.type_id, target) {
            Operand { type_id: target, value: Option::None, addressable: false, assignable: false }
        } else {
            let implementation_detail = interface_implementation_detail(
                state,
                source.type_id,
                target,
            );
            let type_parameter_detail = type_parameter_conversion_failure(
                state,
                source.type_id,
                target,
            );
            let assignment_detail = type_parameter_assignment_failure(state, source.type_id, target);
            diagnostic(
                state,
                arguments[0],
                "cannot convert " + operand_string(state, arguments[0], source) + " to type "
                    + diagnostic_type_string(state, target)
                    + if type_parameter_detail != "" {
                        ": " + type_parameter_detail
                            + if assignment_detail == "" {
                                ""
                            } else {
                                "\n\t" + assignment_detail
                            }
                    } else if implementation_detail == "" {
                        ""
                    } else {
                        ": " + implementation_type_string(state, source.type_id)
                            + " does not implement "
                            + implementation_type_string(state, target)
                            + " "
                            + implementation_detail
                    },
                false,
            );
            invalid_operand(state)
        },
    }
}

fn tuple_variables(state: CheckState, node: go_types::TypeId) -> Vec[go_types::Variable] {
    match go_types::type_data(state.world, node) {
        go_types::TypeData { id: _, kind: go_types::TypeKind::Tuple { variables } } => variables,
        _ => Vec::new(),
    }
}

fn tuple_arity(state: CheckState, type_id: go_types::TypeId) -> isize {
    match go_types::type_data(state.world, type_id) {
        go_types::TypeData { id: _, kind: go_types::TypeKind::Tuple { variables } } => variables.len(),
        _ => 0,
    }
}

fn constant_assignable_to_type_parameter(
    state: CheckState,
    value: constant::ConstValue,
    target: go_types::TypeId,
) -> bool {
    let terms = go_types::type_set_specific_types(state.world, target);
    if terms.is_empty() {
        return false
    }
    for term in terms {
        if !constant::constant_representable(
            constant::constant_copy(value),
            basic_kind(state, term),
            state.config.sizes,
        ) {
            return false
        }
    }
    true
}

fn type_parameter_assignment_failure(
    state: CheckState,
    source: go_types::TypeId,
    target: go_types::TypeId,
) -> string {
    let source_parameter = go_types::is_type_parameter(state.world, source);
    let target_parameter = go_types::is_type_parameter(state.world, target);
    if !source_parameter && !target_parameter {
        return ""
    } else if source_parameter && target_parameter {
        return ""
    } else if source_parameter && go_types::is_named(state.world, target) {
        return ""
    } else if target_parameter && go_types::is_named(state.world, source) {
        return ""
    }
    let source_types = if source_parameter {
        go_types::type_set_specific_types(state.world, source)
    } else {
        Vec::from_array([source])
    };
    let target_types = if target_parameter {
        go_types::type_set_specific_types(state.world, target)
    } else {
        Vec::from_array([target])
    };
    if source_types.is_empty() || target_types.is_empty() {
        return ""
    }
    for source_type in source_types {
        for target_type in target_types {
            if !go_types::assignable_types(state.world, source_type, target_type) {
                return "cannot assign " + diagnostic_type_string(state, source_type)
                    + if source_parameter {
                        " (in " + diagnostic_type_string(state, source) + ")"
                    } else {
                        ""
                    }
                    + " to "
                    + diagnostic_type_string(state, target_type)
                    + if target_parameter {
                        " (in " + diagnostic_type_string(state, target) + ")"
                    } else {
                        ""
                    }
            }
        }
    }
    ""
}

fn type_parameter_conversion_failure(
    state: CheckState,
    source: go_types::TypeId,
    target: go_types::TypeId,
) -> string {
    let source_parameter = go_types::is_type_parameter(state.world, source);
    let target_parameter = go_types::is_type_parameter(state.world, target);
    if !source_parameter && !target_parameter {
        return ""
    }
    let source_types = if source_parameter {
        go_types::type_set_specific_types(state.world, source)
    } else {
        Vec::from_array([source])
    };
    let target_types = if target_parameter {
        go_types::type_set_specific_types(state.world, target)
    } else {
        Vec::from_array([target])
    };
    if source_types.is_empty() || target_types.is_empty() {
        return ""
    }
    for source_type in source_types {
        for target_type in target_types {
            if !go_types::convertible_types(state.world, source_type, target_type) {
                return "cannot convert " + diagnostic_type_string(state, source_type)
                    + if source_parameter {
                        " (in " + diagnostic_type_string(state, source) + ")"
                    } else {
                        ""
                    }
                    + " to type "
                    + diagnostic_type_string(state, target_type)
                    + if target_parameter {
                        " (in " + diagnostic_type_string(state, target) + ")"
                    } else {
                        ""
                    }
            }
        }
    }
    ""
}

fn argument_assignable(state: CheckState, source: Operand, target: go_types::TypeId) -> bool {
    if target.value == state.world.invalid.value {
        return true
    } else if type_contains_invalid(state, source.type_id)
        && !type_contains_active_type(state, source.type_id)
        && invalid_source_assignment_recoverable(state, source.type_id) {
        return true
    }
    match source.value {
        Some(value) => if go_types::is_type_parameter(state.world, target) {
            constant_assignable_to_type_parameter(state, value, target)
        } else if go_types::is_interface(state.world, target) {
            let source_type = default_type_for_kind(state, basic_kind(state, source.type_id)).unwrap_or(
                source.type_id,
            );
            go_types::implements(state.world, source_type, target)
        } else if !go_types::is_untyped(state.world, source.type_id) {
            go_types::assignable_types(state.world, source.type_id, target)
        } else if (go_types::is_numeric(state.world, source.type_id)
            && go_types::is_numeric(state.world, target))
            || (is_boolean_type(state, source.type_id) && is_boolean_type(state, target))
            || (is_string_type(state, source.type_id) && is_string_type(state, target)) {
            constant::constant_representable(value, basic_kind(state, target), state.config.sizes)
        } else {
            false
        },
        None => if go_types::assignable_types(state.world, source.type_id, target) {
            true
        } else if go_types::is_type_parameter(state.world, target) {
            match basic_kind(state, source.type_id) {
                go_types::BasicKind::UntypedInt | go_types::BasicKind::UntypedRune => go_types::is_integer(
                    state.world,
                    target,
                ),
                go_types::BasicKind::UntypedBool => {
                    let types = go_types::type_set_specific_types(state.world, target);
                    if types.is_empty() {
                        false
                    } else {
                        let mut valid = true;
                        for type_id in types {
                            if basic_kind(state, type_id) != go_types::BasicKind::Bool {
                                valid = false;
                            }
                        }
                        valid
                    }
                },
                _ => if go_types::is_named(state.world, source.type_id) {
                    false
                } else {
                    let types = go_types::type_set_specific_types(state.world, target);
                    if types.is_empty() {
                        false
                    } else {
                        let mut assignable = true;
                        for type_id in types {
                            if !go_types::assignable_types(state.world, source.type_id, type_id) {
                                assignable = false;
                            }
                        }
                        assignable
                    }
                },
            }
        } else if go_types::is_type_parameter(state.world, source.type_id) {
            if go_types::is_named(state.world, target) {
                false
            } else {
                let types = go_types::type_set_specific_types(state.world, source.type_id);
                if types.is_empty() {
                    false
                } else {
                    let mut assignable = true;
                    for type_id in types {
                        if !go_types::assignable_types(state.world, type_id, target) {
                            assignable = false;
                        }
                    }
                    assignable
                }
            }
        } else {
            match basic_kind(state, source.type_id) {
                go_types::BasicKind::UntypedInt | go_types::BasicKind::UntypedRune => go_types::is_integer(
                    state.world,
                    target,
                ),
                go_types::BasicKind::UntypedBool => if go_types::is_type_parameter(
                    state.world,
                    target,
                ) {
                    let types = go_types::type_set_specific_types(state.world, target);
                    if types.is_empty() {
                        false
                    } else {
                        let mut valid = true;
                        for type_id in types {
                            if basic_kind(state, type_id) != go_types::BasicKind::Bool {
                                valid = false;
                            }
                        }
                        valid
                    }
                } else {
                    basic_kind(state, target) == go_types::BasicKind::Bool
                },
                _ => false,
            }
        },
    }
}

fn variadic_element(state: CheckState, value: go_types::TypeId) -> go_types::TypeId {
    match go_types::get_type(state.world, core_type_id(state, value)) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Slice { element } }) => element,
        _ => value,
    }
}

fn call_type_description(state: CheckState, value: go_types::TypeId) -> string {
    if value.value == state.world.invalid.value {
        "unknown type"
    } else {
        match basic_kind(state, value) {
            go_types::BasicKind::UntypedInt | go_types::BasicKind::UntypedRune | go_types::BasicKind::UntypedFloat | go_types::BasicKind::UntypedComplex => "number",
            go_types::BasicKind::UntypedBool => "bool",
            go_types::BasicKind::UntypedString => "string",
            _ => diagnostic_type_string(state, value),
        }
    }
}

fn void_call_function_type(state: CheckState, node: syntax::NodeId) -> Option[go_types::TypeId] {
    match syntax::get_node(state.syntax.arena, node) {
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::CallExpr {
                function,
                lparen: _,
                arguments: _,
                ellipsis: _,
                rparen: _,
            },
        }) => recorded_type_fact(state, function).map(|fact| fact.type_id),
        _ => Option::None,
    }
}

fn call_have_types(
    state: CheckState,
    arguments: Vec[syntax::NodeId],
    checked: Vec[Operand],
    ellipsis: isize,
) -> string {
    let values: Vec[string] = Vec::new();
    for index in 0..checked.len() {
        let mut value = if checked[index].type_id.value == state.world.invalid.value
            && arguments.len() == checked.len()
            && node_is_void(state, arguments[index]) {
            match void_call_function_type(state, arguments[index]) {
                Some(type_id) => diagnostic_type_string(state, type_id),
                None => diagnostic_type_string(state, checked[index].type_id),
            }
        } else {
            call_type_description(state, checked[index].type_id)
        };
        if ellipsis >= 0 && index + 1 == checked.len() {
            value = value + "...";
        }
        values.push(value)
    }
    "(" + text::join(values, ", ") + ")"
}

fn call_want_types(state: CheckState, parameters: Vec[go_types::Variable], variadic: bool) -> string {
    let values: Vec[string] = Vec::new();
    for index in 0..parameters.len() {
        if variadic && index + 1 == parameters.len() {
            values.push(
                "..."
                    + call_type_description(
                        state,
                        variadic_element(state, parameters[index].type_id),
                    ),
            )
        } else {
            values.push(call_type_description(state, parameters[index].type_id))
        }
    }
    "(" + text::join(values, ", ") + ")"
}

fn call_rparen(state: CheckState, node: syntax::NodeId) -> isize {
    match syntax::get_node(state.syntax.arena, node) {
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::CallExpr {
                function: _,
                lparen: _,
                arguments: _,
                ellipsis: _,
                rparen,
            },
        }) => rparen,
        _ => node_start(state, node),
    }
}

fn report_call_arity(
    state: CheckState,
    node: syntax::NodeId,
    function_node: syntax::NodeId,
    arguments: Vec[syntax::NodeId],
    checked: Vec[Operand],
    parameters: Vec[go_types::Variable],
    variadic: bool,
    ellipsis: isize,
    too_few: bool,
) -> () {
    let message = if too_few {
        "not enough arguments in call to "
    } else {
        "too many arguments in call to "
    }
        + expression_source_text(state, function_node)
        + "\n\thave "
        + call_have_types(state, arguments, checked, ellipsis)
        + "\n\twant "
        + call_want_types(state, parameters, variadic);
    if too_few {
        diagnostic_at_position(state, node, call_rparen(state, node), message, false)
    } else {
        let extra = if arguments.is_empty() {
            node
        } else if parameters.len() < arguments.len() {
            arguments[parameters.len()]
        } else {
            arguments[arguments.len() - 1]
        };
        diagnostic(state, extra, message, false)
    }
}

fn recovered_call_result(state: CheckState, node: syntax::NodeId, results: go_types::TypeId) -> Operand {
    let values = tuple_variables(state, results);
    if values.is_empty() {
        mark_void_node(state, node)
    }
    let result_type = if values.len() == 1 {
        values[0].type_id
    } else {
        results_type(state, values)
    };
    let result_type = if incomplete_named_instance(state, result_type) {
        state.world.invalid
    } else {
        result_type
    };
    if result_type.value == state.world.invalid.value {
        let _ = state.retained_invalid_type_fact_nodes.insert(node.value);
    }
    Operand { type_id: result_type, value: Option::None, addressable: false, assignable: false }
}

fn recovered_signature_call_result(
    state: CheckState,
    node: syntax::NodeId,
    signature: go_types::TypeId,
) -> Operand {
    match go_types::get_type(state.world, core_type_id(state, signature)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: _,
                receiver_type_params: _,
                type_params: _,
                params: _,
                results,
                variadic: _,
            },
        }) => recovered_call_result(state, node, results),
        _ => invalid_operand(state),
    }
}

fn direct_signature_type(state: CheckState, type_id: go_types::TypeId) -> bool {
    match go_types::type_data(state.world, go_types::unalias(state.world, type_id)) {
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: _,
                receiver_type_params: _,
                type_params: _,
                params: _,
                results: _,
                variadic: _,
            },
        } => true,
        _ => false,
    }
}

fn recovered_generic_call_result(
    state: CheckState,
    node: syntax::NodeId,
    signature: go_types::TypeId,
) -> Operand {
    let recovered = recovered_signature_call_result(state, node, signature);
    for parameter in generic_parameters(state, signature) {
        if type_contains_parameter(state, recovered.type_id, parameter.object, Vec::new()) {
            let _ = state.omitted_type_fact_nodes.insert(node.value);
        }
    }
    recovered
}

fn call_argument_may_expand(state: CheckState, node: syntax::NodeId) -> bool {
    match syntax::get_node(state.syntax.arena, node) {
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::CallExpr {
                function: _,
                lparen: _,
                arguments: _,
                ellipsis: _,
                rparen: _,
            },
        }) => true,
        _ => false,
    }
}

fn check_call(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    function_node: syntax::NodeId,
    arguments: Vec[syntax::NodeId],
    ellipsis: isize,
) -> Operand {
    match builtin_reference(state, scope, function_node) {
        Some(reference) => return check_builtin_call(
            state,
            scope,
            node,
            reference,
            arguments,
            ellipsis,
        ),
        None => {},
    }
    state.generic_function_context_depth.set(state.generic_function_context_depth.get() + 1);
    let function = check_expression(state, scope, function_node);
    state.generic_function_context_depth.set(state.generic_function_context_depth.get() - 1);
    let incomplete_named_selection = match recorded_selection_index(state, function_node) {
        Some(index) => incomplete_named_instance(state, state.info.selections[index].type_id),
        None => false,
    };
    if incomplete_named_selection {
        for argument in arguments {
            let _ = check_expression(state, scope, argument);
        }
        let _ = state.omitted_type_fact_nodes.insert(node.value);
        return invalid_operand(state)
    }
    if state.failed_inference_nodes.contains(function_node.value) {
        let _ = state.omitted_type_fact_nodes.insert(node.value);
        for argument in arguments {
            match syntax::get_node(state.syntax.arena, argument) {
                Some(syntax::SyntaxNode {
                    id: _,
                    file: _,
                    span: _,
                    path: _,
                    kind: syntax::SyntaxKind::CompositeLit {
                        type_node,
                        lbrace: _,
                        elements,
                        rbrace: _,
                        incomplete: _,
                    },
                }) => {
                    let type_id = match type_node {
                        Some(type_node) => resolve_type(state, scope, type_node),
                        None => state.world.invalid,
                    };
                    record_operand(state, argument, builtin_operand(type_id));
                    let element_type = match underlying_kind(state, type_id) {
                        Some(go_types::TypeKind::Array { length: _, element }) | Some(go_types::TypeKind::Slice {
                            element,
                        }) => Option::Some(element),
                        _ => Option::None,
                    };
                    for element in elements {
                        match element_type {
                            Some(target) => {
                                let operand = check_expression(state, scope, element);
                                update_contextual_operand_fact(state, element, operand, target)
                            },
                            None => {
                                let _ = check_expression(state, scope, element);
                            },
                        }
                    }
                },
                _ => {
                    let _ = check_expression(state, scope, argument);
                },
            }
        }
        return invalid_operand(state)
    }
    let function_object = match identifier(state, function_node) {
        Some(name) => match go_types::lookup(state.world, scope, name) {
            Some(object_id) => {
                let index = checked_object_index(state, object_id);
                if index >= 0 && state.world.objects[index].kind == go_types::ObjectKind::Func {
                    Option::Some(object_id)
                } else {
                    Option::None
                }
            },
            None => Option::None,
        },
        None => Option::None,
    };
    if function.type_id.value == state.world.invalid.value && function_object.is_none() {
        for argument in arguments {
            let _ = check_expression(state, scope, argument);
        }
        match recorded_selection_index(state, function_node) {
            Some(index) => {
                let selection = state.info.selections[index];
                if direct_signature_type(state, selection.type_id)
                    && selection_type_contains_direct_invalid(state, selection.type_id) {
                    return recovered_signature_call_result(state, node, selection.type_id)
                }
            },
            None => {},
        }
        return invalid_operand(state)
    }
    if !generic_parameters(state, function.type_id).is_empty()
        && !go_version_at_least(state, node, 18) {
        let position = match syntax::get_node(state.syntax.arena, node) {
            Some(syntax::SyntaxNode {
                id: _,
                file: _,
                span: _,
                path: _,
                kind: syntax::SyntaxKind::CallExpr {
                    function: _,
                    lparen,
                    arguments: _,
                    ellipsis: _,
                    rparen: _,
                },
            }) => lparen,
            _ => node_start(state, node),
        };
        diagnostic_at_position(
            state,
            node,
            position,
            "implicit function instantiation requires go1.18 or later",
            false,
        )
    }
    match go_types::type_data(state.world, core_type_id(state, function.type_id)) {
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: _,
                receiver_type_params: _,
                type_params,
                params,
                results: _,
                variadic,
            },
        } => if !type_params.is_empty() {
            let parameters = tuple_variables(state, params);
            let minimum = if variadic && !parameters.is_empty() {
                parameters.len() - 1
            } else {
                parameters.len()
            };
            let too_few = arguments.len() < minimum;
            let too_many = (!variadic && arguments.len() > parameters.len())
                || (variadic && ellipsis >= 0 && arguments.len() > parameters.len());
            if too_few || too_many {
                let checked = assignment_operands(
                    state,
                    scope,
                    arguments,
                    minimum,
                    false,
                    Vec::new(),
                    Vec::new(),
                );
                if checked.len() < minimum || too_many {
                    report_call_arity(
                        state,
                        node,
                        function_node,
                        arguments,
                        checked,
                        parameters,
                        variadic,
                        ellipsis,
                        too_few,
                    );
                    let _ = state.failed_inference_nodes.insert(node.value);
                    return recovered_generic_call_result(state, node, function.type_id)
                }
            }
        },
        _ => {},
    }
    let function_type = infer_signature(
        state,
        scope,
        function_node,
        function.type_id,
        arguments,
        ellipsis,
    );
    if function_type.value == state.world.invalid.value
        && function.type_id.value != state.world.invalid.value {
        let _ = state.failed_inference_nodes.insert(node.value);
        for argument in arguments {
            if state.failed_inference_nodes.contains(argument.value) {
                let _ = state.omitted_type_fact_nodes.insert(node.value);
                return invalid_operand(state)
            }
        }
        return recovered_generic_call_result(state, node, function.type_id)
    }
    match go_types::type_data(state.world, core_type_id(state, function_type)) {
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: _,
                receiver_type_params,
                type_params: _,
                params,
                results,
                variadic,
            },
        } => {
            let parameters = tuple_variables(state, params);
            let minimum = if variadic && !parameters.is_empty() {
                parameters.len() - 1
            } else {
                parameters.len()
            };
            let obvious_too_few = arguments.len() < minimum
                && (arguments.len() != 1 || !call_argument_may_expand(state, arguments[0]));
            let obvious_too_many = (!variadic && arguments.len() > parameters.len())
                || (variadic && ellipsis >= 0 && arguments.len() > parameters.len());
            if obvious_too_few || obvious_too_many {
                let checked_arguments = assignment_operands(
                    state,
                    scope,
                    arguments,
                    parameters.len(),
                    false,
                    Vec::new(),
                    Vec::new(),
                );
                report_call_arity(
                    state,
                    node,
                    function_node,
                    arguments,
                    checked_arguments,
                    parameters,
                    variadic,
                    ellipsis,
                    obvious_too_few,
                );
                return recovered_call_result(state, node, results)
            }
            if variadic && arguments.len() == 1 && ellipsis >= 0 {
                let value = check_expression(state, scope, arguments[0]);
                let values = tuple_variables(state, value.type_id);
                if values.len() > 1 {
                    diagnostic_at_position(
                        state,
                        node,
                        ellipsis,
                        f"cannot use ... with {values.len()}-valued "
                            + expression_source_text(state, arguments[0]),
                        false,
                    );
                    return recovered_call_result(state, node, results)
                }
            }
            let previous_target_inference_context = state.target_inference_context.get();
            let previous_target_inference_call = state.target_inference_call.get();
            state.target_inference_context.set(1);
            state.target_inference_call.set(expression_source_text(state, function_node));
            let checked_arguments = assignment_operands(
                state,
                scope,
                arguments,
                parameters.len(),
                false,
                {
                    let result: Vec[go_types::TypeId] = Vec::new();
                    for index in 0..arguments.len() {
                        if parameters.is_empty() {
                            result.push(state.world.invalid)
                        }
                        let parameter_index = if parameters.is_empty() {
                            0
                        } else if index < parameters.len() {
                            index
                        } else {
                            parameters.len() - 1
                        };
                        if !parameters.is_empty() {
                            let mut target = parameters[parameter_index].type_id;
                            if variadic && parameter_index + 1 == parameters.len() && ellipsis < 0 {
                                target = variadic_element(state, target);
                            }
                            result.push(target)
                        }
                    }
                    result
                },
                Vec::new(),
            );
            state.target_inference_context.set(previous_target_inference_context);
            state.target_inference_call.set(previous_target_inference_call);
            if ellipsis >= 0 && !variadic {
                diagnostic_at_position(
                    state,
                    node,
                    ellipsis,
                    "cannot use ... in call to non-variadic "
                        + expression_source_text(state, function_node),
                    false,
                );
                return recovered_call_result(state, node, results)
            }
            let too_few = checked_arguments.len() < minimum
                || (variadic && ellipsis >= 0 && checked_arguments.len() < parameters.len());
            let too_many = (!variadic && checked_arguments.len() > parameters.len())
                || (variadic && ellipsis >= 0 && checked_arguments.len() > parameters.len());
            if (variadic && parameters.is_empty()) || too_few || too_many {
                report_call_arity(
                    state,
                    node,
                    function_node,
                    arguments,
                    checked_arguments,
                    parameters,
                    variadic,
                    ellipsis,
                    too_few,
                );
                return recovered_call_result(state, node, results)
            }
            for index in 0..checked_arguments.len() {
                let argument_node = if arguments.len() == 1 {
                    arguments[0]
                } else {
                    arguments[index]
                };
                let parameter_index = if index < parameters.len() {
                    index
                } else {
                    parameters.len() - 1
                };
                let mut target = parameters[parameter_index].type_id;
                if variadic && parameter_index + 1 == parameters.len()
                    && (ellipsis < 0 || index + 1 < checked_arguments.len()) {
                    target = variadic_element(state, target);
                }
                let multiple = tuple_arity(state, checked_arguments[index].type_id) > 1;
                if multiple {
                    diagnostic(
                        state,
                        argument_node,
                        "multiple-value "
                            + operand_string(state, argument_node, checked_arguments[index])
                            + " in single-value context",
                        false,
                    )
                } else if checked_arguments[index].type_id.value != state.world.invalid.value
                    && target.value != state.world.invalid.value
                    && !argument_assignable(state, checked_arguments[index], target) {
                    let implementation_detail = interface_implementation_detail(
                        state,
                        checked_arguments[index].type_id,
                        target,
                    );
                    let constant_detail = match checked_arguments[index].value {
                        Some(value) => if go_types::is_numeric(
                            state.world,
                            checked_arguments[index].type_id,
                        )
                            && go_types::is_numeric(state.world, target)
                            && constant::round_constant(
                                value,
                                basic_kind(state, target),
                                state.config.sizes,
                            ).is_none() {
                            if go_types::is_integer(state.world, target)
                                && constant::constant_to_integer(value).is_none() {
                                " (truncated)"
                            } else {
                                " (overflows)"
                            }
                        } else {
                            ""
                        },
                        None => "",
                    };
                    diagnostic(
                        state,
                        argument_node,
                        "cannot use "
                            + operand_string(state, argument_node, checked_arguments[index])
                            + " as "
                            + diagnostic_type_string(state, target)
                            + " value in argument to "
                            + expression_source_text(state, function_node)
                            + constant_detail
                            + if implementation_detail == "" {
                                ""
                            } else {
                                ": "
                                    + implementation_type_string(
                                        state,
                                        checked_arguments[index].type_id,
                                    )
                                    + " does not implement "
                                    + implementation_type_string(state, target)
                                    + " "
                                    + implementation_detail
                            },
                        false,
                    )
                }
            }
            let results = tuple_variables(state, results);
            if results.is_empty() && state.array_length_depth > 0 {
                let mut active_function = Option::None;
                match function_object {
                    Some(object) => for active in state.active_function_objects {
                        if active.value == object.value {
                            active_function = Option::Some(object);
                        }
                    },
                    None => {},
                }
                match active_function {
                    Some(object) => match go_types::get_object(state.world, object) {
                        Some(object) => {
                            if !state.reported_recursive_calls.contains(function_node.value) {
                                let _ = state.reported_recursive_calls.insert(function_node.value);
                                diagnostic(
                                    state,
                                    function_node,
                                    object.name + "() (no value) used as value or type",
                                    false,
                                )
                            }
                            mark_void_node(state, node);
                            return Operand {
                                type_id: state.world.invalid,
                                value: Option::None,
                                addressable: false,
                                assignable: false,
                            }
                        },
                        None => {},
                    },
                    None => {},
                }
            }
            if results.is_empty() {
                mark_void_node(state, node)
            }
            let mut recursive_result = false;
            for result in results {
                match go_types::get_type(
                    state.world,
                    go_types::unalias(state.world, result.type_id),
                ) {
                    Some(go_types::TypeData {
                        id: _,
                        kind: go_types::TypeKind::Named {
                            object,
                            underlying: _,
                            type_params: _,
                            type_args: _,
                            methods: _,
                        },
                    }) => if record_call_result_type_cycle(state, object, function_object) {
                        recursive_result = true;
                    },
                    _ => {},
                }
            }
            if recursive_result {
                let _ = state.omitted_type_fact_nodes.insert(node.value);
            }
            let result_type = if results.len() == 1 {
                results[0].type_id
            } else {
                results_type(state, results)
            };
            let result_type = if incomplete_named_instance(state, result_type) {
                state.world.invalid
            } else {
                result_type
            };
            if result_type.value == state.world.invalid.value {
                let _ = state.retained_invalid_type_fact_nodes.insert(node.value);
            }
            Operand {
                type_id: result_type,
                value: Option::None,
                addressable: false,
                assignable: false,
            }
        },
        _ => {
            let mut active_function = Option::None;
            match function_object {
                Some(object) => for active in state.active_function_objects {
                    if active.value == object.value {
                        active_function = Option::Some(object);
                    }
                },
                None => {},
            }
            match active_function {
                Some(object) => match go_types::get_object(state.world, object) {
                    Some(object) => if !state.reported_recursive_calls.contains(function_node.value) {
                        let _ = state.reported_recursive_calls.insert(function_node.value);
                        diagnostic(
                            state,
                            function_node,
                            object.name + "() (no value) used as value or type",
                            false,
                        )
                    },
                    None => {},
                },
                None => if function.type_id.value != state.world.invalid.value {
                    let core = core_type_id(state, function.type_id);
                    let call_failure = if core.value == state.world.invalid.value
                        && go_types::is_type_parameter(state.world, function.type_id) {
                        let types = go_types::type_set_specific_types(state.world, function.type_id);
                        if types.is_empty() {
                            "no specific type"
                        } else {
                            diagnostic_type_string(state, types[0]) + " is not a function"
                        }
                    } else {
                        diagnostic_type_string(state, core) + " is not a function"
                    };
                    diagnostic(
                        state,
                        function_node,
                        "invalid operation: cannot call "
                            + operand_string(state, function_node, function)
                            + ": "
                            + call_failure,
                        false,
                    )
                },
            }
            invalid_operand(state)
        },
    }
}

fn results_type(state: CheckState, values: Vec[go_types::Variable]) -> go_types::TypeId {
    if values.is_empty() {
        state.world.invalid
    } else {
        go_types::add_type(state.world, go_types::TypeKind::Tuple { variables: values })
    }
}

fn numeric_rank(kind: go_types::BasicKind) -> isize {
    match kind {
        go_types::BasicKind::UntypedInt => 1,
        go_types::BasicKind::UntypedRune => 2,
        go_types::BasicKind::UntypedFloat => 3,
        go_types::BasicKind::UntypedComplex => 4,
        _ => 0,
    }
}

fn common_numeric_type(state: CheckState, left: Operand, right: Operand) -> go_types::TypeId {
    let left_rank = numeric_rank(basic_kind(state, left.type_id));
    let right_rank = numeric_rank(basic_kind(state, right.type_id));
    if left_rank == 0 || right_rank == 0 {
        state.world.invalid
    } else if left_rank >= right_rank {
        left.type_id
    } else {
        right.type_id
    }
}

fn constant_binary_value(op: string, left: constant::ConstValue, right: constant::ConstValue) -> constant::ConstValue {
    match op {
        ADD_OPERATOR => constant::constant_add(left, right),
        SUBTRACT_OPERATOR => constant::constant_sub(left, right),
        MULTIPLY_OPERATOR => constant::constant_mul(left, right),
        DIVIDE_OPERATOR => constant::constant_div(left, right),
        REMAINDER_OPERATOR => constant::constant_rem(left, right),
        BIT_AND_OPERATOR => constant::constant_bit_and(left, right),
        BIT_AND_NOT_OPERATOR => constant::constant_bit_and_not(left, right),
        BIT_OR_OPERATOR => constant::constant_bit_or(left, right),
        BIT_XOR_OPERATOR => constant::constant_bit_xor(left, right),
        _ => constant::ConstValue::Unknown,
    }
}

fn comparison_value(op: string, left: constant::ConstValue, right: constant::ConstValue) -> Option[
    constant::ConstValue,
] {
    match op {
        EQUAL_OPERATOR => {
            Option::Some(constant::ConstValue::Bool(constant::constant_equal(left, right)))
        },
        NOT_EQUAL_OPERATOR => {
            Option::Some(constant::ConstValue::Bool(!constant::constant_equal(left, right)))
        },
        _ => match constant::constant_compare(left, right) {
            Some(compared) => match op {
                LESS_OPERATOR => Option::Some(constant::ConstValue::Bool(compared < 0)),
                LESS_EQUAL_OPERATOR => Option::Some(constant::ConstValue::Bool(compared <= 0)),
                GREATER_OPERATOR => Option::Some(constant::ConstValue::Bool(compared > 0)),
                GREATER_EQUAL_OPERATOR => {
                    Option::Some(constant::ConstValue::Bool(compared >= 0))
                },
                _ => Option::None,
            },
            None => Option::None,
        },
    }
}

fn shift_amount(value: constant::ConstValue) -> Option[isize] {
    match constant::constant_to_integer(value) {
        Some(value) => if value.sign < 0 {
            Option::None
        } else {
            match num::parse_int_structured(constant::integer_to_string(value)) {
                Ok(value) => Option::Some(value),
                Err(_) => Option::None,
            }
        },
        None => Option::None,
    }
}

fn addressable_composite_literal(state: CheckState, node: syntax::NodeId) -> bool {
    match syntax::get_node(state.syntax.arena, node) {
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::CompositeLit {
                type_node: _,
                lbrace: _,
                elements: _,
                rbrace: _,
                incomplete: _,
            },
        }) => true,
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ },
        }) => addressable_composite_literal(state, expression),
        _ => false,
    }
}

fn channel_type_parameter_failure(state: CheckState, value: go_types::TypeId, receive: bool) -> string {
    if !go_types::is_type_parameter(state.world, value) {
        return ""
    }
    let terms = go_types::type_set_specific_types(state.world, value);
    if terms.is_empty() {
        return "no specific channel type"
    }
    let mut common_type = terms[0];
    let mut common_underlying = go_types::underlying(state.world, common_type);
    for term in terms {
        let underlying = go_types::underlying(state.world, term);
        match go_types::get_type(state.world, underlying) {
            Some(go_types::TypeData {
                id: _,
                kind: go_types::TypeKind::Chan { direction: 1, element: _ },
            }) if receive => return "send-only channel " + diagnostic_type_string(state, term),
            Some(go_types::TypeData {
                id: _,
                kind: go_types::TypeKind::Chan { direction: 2, element: _ },
            }) if !receive => return "receive-only channel " + diagnostic_type_string(state, term),
            Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Chan { direction, element } }) => match go_types::get_type(
                state.world,
                common_underlying,
            ) {
                Some(go_types::TypeData {
                    id: _,
                    kind: go_types::TypeKind::Chan {
                        direction: common_direction,
                        element: common_element,
                    },
                }) => if !go_types::identical(state.world, common_element, element) {
                    return "channels " + diagnostic_type_string(state, common_type) + " and "
                        + diagnostic_type_string(state, term)
                        + " have different element types"
                } else if common_direction != direction {
                    if common_direction == 3 {
                        common_type = term;
                        common_underlying = underlying;
                    } else if direction != 3 {
                        return "channels " + diagnostic_type_string(state, common_type) + " and "
                            + diagnostic_type_string(state, term)
                            + " have conflicting directions"
                    }
                },
                _ => {},
            },
            _ => return "non-channel " + diagnostic_type_string(state, term),
        }
    }
    ""
}

fn check_unary(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    op: string,
    expression: syntax::NodeId,
) -> Operand {
    let source = check_expression(state, scope, expression);
    let recover_addressable_literal = op == BIT_AND_OPERATOR
        && addressable_composite_literal(state, expression);
    if source.type_id.value == state.world.invalid.value
        || (!go_types::is_named(state.world, source.type_id)
            && type_contains_invalid(state, source.type_id)
            && !type_contains_active_type(state, source.type_id)
            && !recover_addressable_literal) {
        return invalid_operand(state)
    } else if tuple_arity(state, source.type_id) > 1 {
        diagnostic(
            state,
            expression,
            "multiple-value " + operand_string(state, expression, source)
                + " in single-value context",
            false,
        );
        return invalid_operand(state)
    }
    if op == TILDE_OPERATOR {
        diagnostic(
            state,
            node,
            "cannot use ~ outside of interface or type constraint"
                + if go_types::is_integer(state.world, source.type_id) {
                    " (use ^ for bitwise complement)"
                } else {
                    ""
                },
            false,
        );
        return if go_types::is_integer(state.world, source.type_id) {
            let recovered_value = match source.value {
                Some(value) => {
                    let bits = match basic_kind(state, source.type_id) {
                        go_types::BasicKind::Uint8 => 8,
                        go_types::BasicKind::Uint16 => 16,
                        go_types::BasicKind::Uint32 => 32,
                        go_types::BasicKind::Uint64 => 64,
                        go_types::BasicKind::Uint | go_types::BasicKind::Uintptr => {
                            (state.config.sizes.word_size * 8).to_isize()
                        },
                        _ => 0,
                    };
                    Option::Some(constant::constant_bit_not_width(value, bits))
                },
                None => Option::None,
            };
            Operand {
                type_id: source.type_id,
                value: recovered_value,
                addressable: false,
                assignable: false,
            }
        } else {
            invalid_operand(state)
        }
    } else if op == BIT_AND_OPERATOR {
        let composite_literal = addressable_composite_literal(state, expression);
        if !source.addressable && !composite_literal {
            diagnostic(
                state,
                expression,
                "invalid operation: cannot take address of "
                    + operand_string(state, expression, source),
                false,
            );
            return invalid_operand(state)
        }
        if state.array_length_depth > 0 && type_contains_active_type(state, source.type_id) {
            let _ = state.omitted_type_fact_nodes.insert(node.value);
        }
        return Operand {
            type_id: go_types::add_type(
                state.world,
                go_types::TypeKind::Pointer { element: source.type_id },
            ),
            value: Option::None,
            addressable: false,
            assignable: false,
        }
    } else if op == RECEIVE_OPERATOR {
        let type_parameter_failure = channel_type_parameter_failure(state, source.type_id, true);
        if type_parameter_failure != "" {
            diagnostic(
                state,
                expression,
                "invalid operation: cannot receive from "
                    + operand_string(state, expression, source)
                    + ": "
                    + type_parameter_failure,
                false,
            );
            return invalid_operand(state)
        }
        match go_types::get_type(state.world, core_type_id(state, source.type_id)) {
            Some(go_types::TypeData {
                id: _,
                kind: go_types::TypeKind::Chan { direction: 1, element: _ },
            }) => {
                diagnostic(
                    state,
                    expression,
                    "invalid operation: cannot receive from send-only channel "
                        + diagnostic_type_string(state, source.type_id)
                        + " "
                        + operand_string(state, expression, source),
                    false,
                );
                return invalid_operand(state)
            },
            Some(go_types::TypeData {
                id: _,
                kind: go_types::TypeKind::Chan { direction: _, element },
            }) => {
                if record_active_value_type_cycle(state, element, false) {
                    let _ = state.omitted_type_fact_nodes.insert(node.value);
                }
                return Operand {
                    type_id: element,
                    value: Option::None,
                    addressable: false,
                    assignable: false,
                }
            },
            _ => {
                diagnostic(
                    state,
                    expression,
                    "invalid operation: cannot receive from non-channel "
                        + diagnostic_type_string(state, source.type_id)
                        + " "
                        + operand_string(state, expression, source),
                    false,
                );
                return invalid_operand(state)
            },
        }
    }
    let result = match source.value {
        Some(value) => match op {
            ADD_OPERATOR => constant::constant_copy(value),
            SUBTRACT_OPERATOR => constant::constant_neg(value),
            LOGICAL_NOT_OPERATOR => constant::constant_not(value),
            BIT_XOR_OPERATOR => {
                let bits = match basic_kind(state, source.type_id) {
                    go_types::BasicKind::Uint8 => 8,
                    go_types::BasicKind::Uint16 => 16,
                    go_types::BasicKind::Uint32 => 32,
                    go_types::BasicKind::Uint64 => 64,
                    go_types::BasicKind::Uint | go_types::BasicKind::Uintptr => {
                        (state.config.sizes.word_size * 8).to_isize()
                    },
                    _ => 0,
                };
                constant::constant_bit_not_width(value, bits)
            },
            _ => constant::ConstValue::Unknown,
        },
        None => constant::ConstValue::Unknown,
    };
    let valid = match op {
        ADD_OPERATOR | SUBTRACT_OPERATOR => go_types::is_numeric(state.world, source.type_id),
        BIT_XOR_OPERATOR => go_types::is_integer(state.world, source.type_id),
        LOGICAL_NOT_OPERATOR => is_boolean_type(state, source.type_id),
        _ => false,
    };
    if !valid {
        diagnostic(
            state,
            expression,
            "invalid operation: operator " + op + " not defined on "
                + operand_string(state, expression, source),
            false,
        );
        return invalid_operand(state)
    }
    if source.value.is_some() && !go_types::is_untyped(state.world, source.type_id)
        && constant::constant_kind(result) != constant::ConstantKind::Unknown
        && constant::round_constant(result, basic_kind(state, source.type_id), state.config.sizes).is_none() {
        let failed = Operand {
            type_id: source.type_id,
            value: Option::Some(result),
            addressable: false,
            assignable: false,
        };
        diagnostic(
            state,
            node,
            operand_string(state, node, failed) + " overflows "
                + diagnostic_type_string(state, source.type_id),
            false,
        );
        let _ = state.omitted_type_fact_nodes.insert(node.value);
        return invalid_operand(state)
    }
    if valid && op == BIT_XOR_OPERATOR
        && basic_kind(state, source.type_id) == go_types::BasicKind::UntypedInt
        && constant::constant_exceeds_integer_precision(result, 512) {
        let position = match syntax::get_node(state.syntax.arena, node) {
            Some(syntax::SyntaxNode {
                id: _,
                file: _,
                span: _,
                path: _,
                kind: syntax::SyntaxKind::UnaryExpr { op_pos, op: _, expression: _ },
            }) => op_pos,
            _ => node_start(state, node),
        };
        diagnostic_at_position(state, node, position, "constant bitwise complement overflow", false);
        return Operand {
            type_id: source.type_id,
            value: Option::Some(constant::ConstValue::Unknown),
            addressable: false,
            assignable: false,
        }
    }
    Operand {
        type_id: source.type_id,
        value: source.value.map(|_| result),
        addressable: false,
        assignable: false,
    }
}

fn is_boolean_type(state: CheckState, value: go_types::TypeId) -> bool {
    match basic_kind(state, value) {
        go_types::BasicKind::Bool | go_types::BasicKind::UntypedBool => true,
        _ => false,
    }
}

fn is_string_type(state: CheckState, value: go_types::TypeId) -> bool {
    match basic_kind(state, value) {
        go_types::BasicKind::String | go_types::BasicKind::UntypedString => true,
        _ => false,
    }
}

fn untyped_binary_operand_compatible(state: CheckState, source: Operand, target: go_types::TypeId) -> bool {
    match basic_kind(state, source.type_id) {
        go_types::BasicKind::UntypedInt | go_types::BasicKind::UntypedRune | go_types::BasicKind::UntypedFloat | go_types::BasicKind::UntypedComplex => go_types::is_numeric(
            state.world,
            target,
        ),
        go_types::BasicKind::UntypedBool => basic_kind(state, target) == go_types::BasicKind::Bool,
        go_types::BasicKind::UntypedString => basic_kind(state, target)
            == go_types::BasicKind::String,
        _ => false,
    }
}

fn report_binary_operand_overflow(
    state: CheckState,
    node: syntax::NodeId,
    operand: Operand,
    target: go_types::TypeId,
) -> bool {
    if !go_types::is_untyped(state.world, operand.type_id) {
        return false
    }
    match operand.value {
        Some(value) => if !(if go_types::is_type_parameter(state.world, target) {
            constant_assignable_to_type_parameter(state, value, target)
        } else if go_types::is_interface(state.world, target) {
            match default_type_for_kind(state, basic_kind(state, operand.type_id)) {
                Some(type_id) => go_types::implements(state.world, type_id, target),
                None => false,
            }
        } else {
            constant::constant_representable(value, basic_kind(state, target), state.config.sizes)
        }) {
            let integer_source = go_types::is_integer(state.world, operand.type_id);
            let diagnostic_target = if integer_source {
                target
            } else {
                find_basic_kind(state, basic_kind(state, target))
            };
            diagnostic(
                state,
                node,
                if go_types::is_type_parameter(state.world, target) {
                    "cannot convert " + operand_string(state, node, operand) + " to type "
                        + diagnostic_type_string(state, target)
                } else {
                    operand_string(state, node, operand)
                        + if integer_source {
                            " overflows "
                        } else {
                            " truncated to "
                        }
                        + diagnostic_type_string(state, diagnostic_target)
                },
                false,
            );
            true
        } else {
            false
        },
        None => false,
    }
}

fn binary_operand_type(state: CheckState, left: Operand, right: Operand) -> go_types::TypeId {
    if go_types::identical(state.world, left.type_id, right.type_id) {
        left.type_id
    } else if basic_kind(state, left.type_id) == go_types::BasicKind::UntypedNil
        && go_types::is_nilable_type(state.world, right.type_id) {
        right.type_id
    } else if basic_kind(state, right.type_id) == go_types::BasicKind::UntypedNil
        && go_types::is_nilable_type(state.world, left.type_id) {
        left.type_id
    } else if go_types::is_untyped(state.world, left.type_id)
        && !go_types::is_untyped(state.world, right.type_id)
        && untyped_binary_operand_compatible(state, left, right.type_id) {
        right.type_id
    } else if go_types::is_untyped(state.world, right.type_id)
        && !go_types::is_untyped(state.world, left.type_id)
        && untyped_binary_operand_compatible(state, right, left.type_id) {
        left.type_id
    } else if go_types::is_untyped(state.world, left.type_id)
        && go_types::is_untyped(state.world, right.type_id)
        && go_types::is_numeric(state.world, left.type_id)
        && go_types::is_numeric(state.world, right.type_id) {
        common_numeric_type(state, left, right)
    } else {
        state.world.invalid
    }
}

fn promote_untyped_expression_fact(
    state: CheckState,
    node: syntax::NodeId,
    target: go_types::TypeId,
) -> () {
    match recorded_type_fact(state, node) {
        Some(fact) => if go_types::is_untyped(state.world, fact.type_id)
            && go_types::is_numeric(state.world, fact.type_id)
            && go_types::is_untyped(state.world, target)
            && go_types::is_numeric(state.world, target) {
            update_operand_fact(state, node, target, Option::None);
            match syntax::get_node(state.syntax.arena, node) {
                Some(syntax::SyntaxNode {
                    id: _,
                    file: _,
                    span: _,
                    path: _,
                    kind: syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ },
                }) => promote_untyped_expression_fact(state, expression, target),
                _ => {},
            }
        },
        None => {},
    }
}

fn update_binary_operand_fact(
    state: CheckState,
    node: syntax::NodeId,
    operand: Operand,
    target: go_types::TypeId,
) -> () {
    if target.value == state.world.invalid.value {
        return
    } else if go_types::is_untyped(state.world, target) {
        if go_types::is_untyped(state.world, operand.type_id)
            && !go_types::identical(state.world, operand.type_id, target) {
            update_operand_fact(state, node, target, operand.value);
            promote_untyped_expression_fact(state, node, target)
        }
    } else {
        update_contextual_operand_fact(state, node, operand, target)
    }
}

fn valid_binary_operator(state: CheckState, op: string, value: go_types::TypeId) -> bool {
    match op {
        ADD_OPERATOR => go_types::supports_add(state.world, value),
        SUBTRACT_OPERATOR | MULTIPLY_OPERATOR | DIVIDE_OPERATOR => {
            go_types::is_numeric(state.world, value)
        },
        REMAINDER_OPERATOR | BIT_AND_OPERATOR | BIT_OR_OPERATOR | BIT_XOR_OPERATOR | BIT_AND_NOT_OPERATOR => go_types::is_integer(
            state.world,
            value,
        ),
        _ => false,
    }
}

fn operand_with_type(operand: Operand, type_id: go_types::TypeId) -> Operand {
    Operand {
        type_id,
        value: operand.value,
        addressable: operand.addressable,
        assignable: operand.assignable,
    }
}

fn binary_constant_value(state: CheckState, operand: Operand, result_type: go_types::TypeId) -> Option[
    constant::ConstValue,
] {
    match operand.value {
        Some(value) => if go_types::is_untyped(state.world, operand.type_id)
            && !go_types::is_untyped(state.world, result_type) {
            constant::convert_constant(value, basic_kind(state, result_type), state.config.sizes)
        } else {
            Option::Some(value)
        },
        None => Option::None,
    }
}

fn comparison_type_label(state: CheckState, value: go_types::TypeId) -> string {
    match go_types::get_type(state.world, go_types::underlying(state.world, value)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Basic { basic: _, name: _, untyped: _ },
        }) => diagnostic_type_string(state, value),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Array { length: _, element: _ } }) => "array",
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Slice { element: _ } }) => "slice",
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Struct { fields: _ } }) => "struct",
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element: _ } }) => "pointer",
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: _,
                receiver_type_params: _,
                type_params: _,
                params: _,
                results: _,
                variadic: _,
            },
        }) => "func",
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Interface {
                methods: _,
                embeddeds: _,
                comparable: _,
                implicit: _,
            },
        }) => "interface",
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Map { key: _, value: _ } }) => "map",
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Chan { direction: _, element: _ },
        }) => "chan",
        _ => diagnostic_type_string(state, value),
    }
}

fn noncomparable_reason(state: CheckState, value: go_types::TypeId) -> string {
    if go_types::is_type_parameter(state.world, value) {
        return "incomparable types in type set"
    }
    match go_types::get_type(state.world, go_types::underlying(state.world, value)) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Slice { element: _ } }) => "slice can only be compared to nil",
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Map { key: _, value: _ } }) => "map can only be compared to nil",
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: _,
                receiver_type_params: _,
                type_params: _,
                params: _,
                results: _,
                variadic: _,
            },
        }) => "func can only be compared to nil",
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Struct { fields } }) => {
            let mut contained = value;
            for field in fields {
                if contained.value == value.value
                    && !go_types::comparable(state.world, field.variable.type_id) {
                    contained = field.variable.type_id;
                }
            }
            "struct containing " + diagnostic_type_string(state, contained) + " cannot be compared"
        },
        _ => diagnostic_type_string(state, value) + " cannot be compared",
    }
}

fn report_unsupported_comparison(
    state: CheckState,
    node: syntax::NodeId,
    diagnostic_node: syntax::NodeId,
    op: string,
    value: go_types::TypeId,
) -> () {
    let message = "invalid operation: " + expression_source_text(state, node)
        + if go_types::is_type_parameter(state.world, value) {
            " (type parameter " + diagnostic_type_string(state, value) + " cannot use operator "
                + op
                + ")"
        } else {
            " (operator " + op + " not defined on " + comparison_type_label(state, value) + ")"
        };
    diagnostic(state, diagnostic_node, message, false)
}

fn selector_operand(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    expression: syntax::NodeId,
    selector: syntax::NodeId,
) -> Operand {
    let name = identifier(state, selector).unwrap_or("");
    match builtin_expression(state, scope, expression) {
        Some((_, builtin)) => {
            diagnostic(
                state,
                selector,
                "invalid use of " + builtin + " (built-in) in selector expression",
                false,
            );
            return invalid_operand(state)
        },
        None => {},
    }
    if let Some(receiver) = conversion_target(state, scope, expression) {
        return method_expression_operand(state, node, selector, receiver, name)
    }
    match identifier(state, expression) {
        Some(package_name) => match go_types::lookup(state.world, scope, package_name) {
            Some(package_object) => match go_types::get_object(state.world, package_object) {
                Some(object) => if object.kind == go_types::ObjectKind::PackageName {
                    mark_import_used(state, package_object);
                    record_use(state, expression, package_object);
                    match object.imported_package {
                        Some(package_id) => if state.config.fake_import_c
                            && state.world.packages[package_id.value].path == "C" {
                            invalid_operand(state)
                        } else if !state.world.packages[package_id.value].complete {
                            invalid_operand(state)
                        } else {
                            match go_types::lookup_local(
                                state.world,
                                state.world.packages[package_id.value].scope,
                                name,
                            ) {
                                Some(member) => match go_types::get_object(state.world, member) {
                                    Some(member_object) => {
                                        if !member_object.exported {
                                            diagnostic(
                                                state,
                                                selector,
                                                "name " + name + " not exported by package "
                                                    + package_name,
                                                false,
                                            )
                                        }
                                        record_use(state, selector, member);
                                        Operand {
                                            type_id: member_object.type_id,
                                            value: if member_object.kind
                                                == go_types::ObjectKind::Const {
                                                find_constant(state, member)
                                            } else {
                                                Option::None
                                            },
                                            addressable: member_object.kind
                                                == go_types::ObjectKind::Var,
                                            assignable: member_object.kind
                                                == go_types::ObjectKind::Var,
                                        }
                                    },
                                    None => invalid_operand(state),
                                },
                                None => {
                                    let similar = similar_package_member(state, package_id, name);
                                    diagnostic(
                                        state,
                                        selector,
                                        "undefined: " + package_name + "." + name
                                            + if similar == "" {
                                                ""
                                            } else {
                                                " (but have " + similar + ")"
                                            },
                                        false,
                                    );
                                    invalid_operand(state)
                                },
                            }
                        },
                        None => invalid_operand(state),
                    }
                } else {
                    value_selector_operand(state, scope, node, expression, selector, name)
                },
                None => invalid_operand(state),
            },
            None => value_selector_operand(state, scope, node, expression, selector, name),
        },
        None => value_selector_operand(state, scope, node, expression, selector, name),
    }
}

fn method_expression_type(
    state: CheckState,
    receiver_type: go_types::TypeId,
    method_type: go_types::TypeId,
) -> go_types::TypeId {
    match go_types::get_type(state.world, go_types::unalias(state.world, method_type)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver,
                receiver_type_params,
                type_params,
                params,
                results,
                variadic,
            },
        }) => {
            let parameter_variables = tuple_variables(state, params);
            let variables: Vec[go_types::Variable] = match receiver {
                Some(value) => Vec::from_array(
                    [
                        go_types::Variable {
                            name: if value.name == "" {
                                if !parameter_variables.is_empty()
                                    && parameter_variables[0].name != "" {
                                    "_"
                                } else {
                                    ""
                                }
                            } else {
                                value.name
                            },
                            owner: value.owner,
                            type_id: receiver_type,
                        },
                    ],
                ),
                None => Vec::from_array(
                    [go_types::Variable { name: "", owner: Option::None, type_id: receiver_type }],
                ),
            };
            for variable in parameter_variables {
                variables.push(variable)
            }
            let parameters = go_types::add_type(
                state.world,
                go_types::TypeKind::Tuple { variables },
            );
            go_types::add_type(
                state.world,
                go_types::TypeKind::Signature {
                    receiver: Option::None,
                    receiver_type_params,
                    type_params,
                    params: parameters,
                    results,
                    variadic,
                },
            )
        },
        _ => state.world.invalid,
    }
}

fn method_expression_selection_type(
    state: CheckState,
    type_id: go_types::TypeId,
    method_type: go_types::TypeId,
) -> go_types::TypeId {
    let synthetic_receiver_name = match go_types::get_type(
        state.world,
        go_types::unalias(state.world, method_type),
    ) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver,
                receiver_type_params: _,
                type_params: _,
                params: _,
                results: _,
                variadic: _,
            },
        }) => match receiver {
            Some(value) => value.name == "",
            None => false,
        },
        _ => false,
    };
    match go_types::get_type(state.world, go_types::unalias(state.world, type_id)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver,
                receiver_type_params,
                type_params,
                params,
                results,
                variadic,
            },
        }) => {
            let source_variables = tuple_variables(state, params);
            let variables: Vec[go_types::Variable] = Vec::new();
            for index in 0..source_variables.len() {
                variables.push(
                    go_types::Variable {
                        name: if index == 0 && source_variables[index].name == "_"
                            && synthetic_receiver_name {
                            ""
                        } else {
                            source_variables[index].name
                        },
                        owner: source_variables[index].owner,
                        type_id: source_variables[index].type_id,
                    },
                )
            }
            go_types::add_type(
                state.world,
                go_types::TypeKind::Signature {
                    receiver,
                    receiver_type_params,
                    type_params,
                    params: go_types::add_type(state.world, go_types::TypeKind::Tuple { variables }),
                    results,
                    variadic,
                },
            )
        },
        _ => type_id,
    }
}

fn without_receiver_type_parameters(state: CheckState, type_id: go_types::TypeId) -> go_types::TypeId {
    match go_types::get_type(state.world, go_types::unalias(state.world, type_id)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver,
                receiver_type_params: _,
                type_params,
                params,
                results,
                variadic,
            },
        }) => {
            let source_variables = tuple_variables(state, params);
            let variables: Vec[go_types::Variable] = Vec::new();
            for index in 0..source_variables.len() {
                variables.push(
                    go_types::Variable {
                        name: if index == 0
                            && (source_variables.len() == 1 || source_variables[1].name == "") {
                            ""
                        } else {
                            source_variables[index].name
                        },
                        owner: source_variables[index].owner,
                        type_id: source_variables[index].type_id,
                    },
                )
            }
            go_types::add_type(
                state.world,
                go_types::TypeKind::Signature {
                    receiver,
                    receiver_type_params: Vec::new(),
                    type_params,
                    params: go_types::add_type(state.world, go_types::TypeKind::Tuple { variables }),
                    results,
                    variadic,
                },
            )
        },
        _ => type_id,
    }
}

fn method_value_type(state: CheckState, method_type: go_types::TypeId) -> go_types::TypeId {
    match go_types::get_type(state.world, go_types::unalias(state.world, method_type)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: _,
                receiver_type_params,
                type_params,
                params,
                results,
                variadic,
            },
        }) => go_types::add_type(
            state.world,
            go_types::TypeKind::Signature {
                receiver: Option::None,
                receiver_type_params,
                type_params,
                params,
                results,
                variadic,
            },
        ),
        _ => method_type,
    }
}

fn selection_type_contains_direct_invalid(state: CheckState, type_id: go_types::TypeId) -> bool {
    match go_types::type_data(state.world, go_types::unalias(state.world, type_id)).kind {
        go_types::TypeKind::Signature {
            receiver: _,
            receiver_type_params: _,
            type_params: _,
            params,
            results,
            variadic: _,
        } => {
            for variable in tuple_variables(state, params) {
                if variable.type_id.value == state.world.invalid.value {
                    return true
                }
            }
            for variable in tuple_variables(state, results) {
                if variable.type_id.value == state.world.invalid.value {
                    return true
                }
            }
            false
        },
        _ => type_contains_invalid(state, type_id),
    }
}

fn recovered_field_selection_type(state: CheckState, type_id: go_types::TypeId) -> go_types::TypeId {
    if incomplete_named_instance(state, type_id) {
        return state.world.invalid
    }
    match go_types::type_data(state.world, go_types::unalias(state.world, type_id)) {
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver,
                receiver_type_params,
                type_params,
                params,
                results,
                variadic,
            },
        } => {
            let parameter_variables: Vec[go_types::Variable] = Vec::new();
            let result_variables: Vec[go_types::Variable] = Vec::new();
            let mut changed = false;
            for variable in tuple_variables(state, params) {
                let recovered = if incomplete_named_instance(state, variable.type_id) {
                    changed = true;
                    state.world.invalid
                } else {
                    variable.type_id
                };
                parameter_variables.push(
                    go_types::Variable {
                        name: variable.name,
                        owner: variable.owner,
                        type_id: recovered,
                    },
                )
            }
            for variable in tuple_variables(state, results) {
                let recovered = if incomplete_named_instance(state, variable.type_id) {
                    changed = true;
                    state.world.invalid
                } else {
                    variable.type_id
                };
                result_variables.push(
                    go_types::Variable {
                        name: variable.name,
                        owner: variable.owner,
                        type_id: recovered,
                    },
                )
            }
            if changed {
                go_types::add_type(
                    state.world,
                    go_types::TypeKind::Signature {
                        receiver,
                        receiver_type_params,
                        type_params,
                        params: go_types::add_type(
                            state.world,
                            go_types::TypeKind::Tuple { variables: parameter_variables },
                        ),
                        results: go_types::add_type(
                            state.world,
                            go_types::TypeKind::Tuple { variables: result_variables },
                        ),
                        variadic,
                    },
                )
            } else {
                type_id
            }
        },
        _ => type_id,
    }
}

fn method_value_selection_type(
    state: CheckState,
    receiver_type: go_types::TypeId,
    method_type: go_types::TypeId,
) -> go_types::TypeId {
    match go_types::get_type(state.world, go_types::unalias(state.world, method_type)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver,
                receiver_type_params,
                type_params,
                params,
                results,
                variadic,
            },
        }) => go_types::add_type(
            state.world,
            go_types::TypeKind::Signature {
                receiver: Option::Some(
                    match receiver {
                        Some(value) => go_types::Variable {
                            name: value.name,
                            owner: value.owner,
                            type_id: receiver_type,
                        },
                        None => go_types::Variable {
                            name: "",
                            owner: Option::Some(state.package_id),
                            type_id: receiver_type,
                        },
                    },
                ),
                receiver_type_params,
                type_params,
                params,
                results,
                variadic,
            },
        ),
        _ => method_type,
    }
}

fn recorded_selection_index(state: CheckState, node: syntax::NodeId) -> Option[isize] {
    match state.selection_indices[node.value] {
        Some(index) => if index >= 0 && index < state.info.selections.len()
            && state.info.selections[index].node.value == node.value {
            Option::Some(index)
        } else {
            Option::None
        },
        None => Option::None,
    }
}

fn rebuild_selection_indices(state: CheckState) -> () {
    for entry in state.selection_indices.entries() {
        let _ = state.selection_indices.remove(entry.0);
    }
    for index in 0..state.info.selections.len() {
        state.selection_indices[state.info.selections[index].node.value] = index;
    }
}

fn record_selection(state: CheckState, fact: SelectionFact) -> () {
    if recorded_selection_index(state, fact.node).is_some() {
        return
    }
    state.selection_indices[fact.node.value] = state.info.selections.len();
    state.info.selections.push(fact)
}

fn omit_incomplete_method_receiver_facts(state: CheckState, node: syntax::NodeId) -> () {
    let _ = state.omitted_type_fact_nodes.insert(node.value);
    match syntax::get_node(state.syntax.arena, node) {
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ } | syntax::SyntaxKind::StarExpr {
                star: _,
                expression,
            },
        }) => omit_incomplete_method_receiver_facts(state, expression),
        _ => {},
    }
}

fn method_expression_operand(
    state: CheckState,
    node: syntax::NodeId,
    selector: syntax::NodeId,
    receiver: go_types::TypeId,
    name: string,
) -> Operand {
    if state.array_length_depth > 0 && type_contains_active_type(state, receiver) {
        match syntax::get_node(state.syntax.arena, node) {
            Some(syntax::SyntaxNode {
                id: _,
                file: _,
                span: _,
                path: _,
                kind: syntax::SyntaxKind::SelectorExpr { expression, selector: _ },
            }) => {
                let _ = state.omitted_type_fact_nodes.insert(expression.value);
            },
            _ => {},
        }
    }
    if incomplete_named_instance(state, receiver) {
        let _ = state.omitted_type_fact_nodes.insert(node.value);
        match syntax::get_node(state.syntax.arena, node) {
            Some(syntax::SyntaxNode {
                id: _,
                file: _,
                span: _,
                path: _,
                kind: syntax::SyntaxKind::SelectorExpr { expression, selector: _ },
            }) => omit_incomplete_method_receiver_facts(state, expression),
            _ => {},
        }
        return invalid_operand(state)
    }
    if receiver.value == state.world.invalid.value
        || (!go_types::is_named(state.world, receiver) && type_contains_invalid(state, receiver)
            && !type_contains_active_type(state, receiver)) {
        return invalid_operand(state)
    }
    if pointer_to_interface_type(state, receiver) {
        diagnostic(
            state,
            selector,
            expression_source_text(state, node) + " undefined (type "
                + diagnostic_type_string(state, receiver)
                + " is pointer to interface, not interface)",
            false,
        );
        return invalid_operand(state)
    }
    match go_types::lookup_field_or_method_detailed(state.world, receiver, false, name) {
        go_types::FieldOrMethodLookup::Found(selection) => match go_types::get_object(
            state.world,
            selection.object,
        ) {
            Some(object) => if object.kind == go_types::ObjectKind::Func {
                let selection_type = method_expression_type(state, receiver, object.type_id);
                let type_id = without_receiver_type_parameters(state, selection_type);
                publish_active_initializer_root_type(state, node, type_id);
                evaluate_function_dependency(state, selection.object);
                record_use(state, selector, selection.object);
                record_selection(
                    state,
                    SelectionFact {
                        node,
                        receiver_type: receiver,
                        object: selection.object,
                        type_id: method_expression_selection_type(
                            state,
                            selection_type,
                            object.type_id,
                        ),
                        index: selection.index,
                        indirect: selection.indirect,
                    },
                );
                Operand { type_id, value: Option::None, addressable: false, assignable: false }
            } else {
                diagnostic(
                    state,
                    selector,
                    expression_source_text(state, node) + " undefined (type "
                        + diagnostic_type_string(state, receiver)
                        + " has no method "
                        + name
                        + ")",
                    false,
                );
                invalid_operand(state)
            },
            None => invalid_operand(state),
        },
        go_types::FieldOrMethodLookup::Ambiguous => {
            diagnostic(
                state,
                selector,
                "ambiguous selector " + expression_source_text(state, node),
                false,
            );
            invalid_operand(state)
        },
        go_types::FieldOrMethodLookup::Missing => {
            let pointer_method = match go_types::get_type(
                state.world,
                go_types::underlying(state.world, receiver),
            ) {
                Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element: _ } }) => false,
                _ => {
                    let pointer = go_types::add_type(
                        state.world,
                        go_types::TypeKind::Pointer { element: receiver },
                    );
                    match go_types::lookup_field_or_method_detailed(
                        state.world,
                        pointer,
                        false,
                        name,
                    ) {
                        go_types::FieldOrMethodLookup::Found(selection) => match go_types::get_object(
                            state.world,
                            selection.object,
                        ) {
                            Some(object) => object.kind == go_types::ObjectKind::Func,
                            None => false,
                        },
                        _ => false,
                    }
                },
            };
            if pointer_method {
                diagnostic(
                    state,
                    selector,
                    "invalid method expression " + expression_source_text(state, node)
                        + " (needs pointer receiver (*"
                        + diagnostic_type_string(state, receiver)
                        + ")."
                        + name
                        + ")",
                    false,
                );
                return invalid_operand(state)
            }
            let recursive = if state.array_length_depth > 0 && !state.active_type_objects.is_empty() {
                match go_types::get_type(state.world, go_types::unalias(state.world, receiver)) {
                    Some(go_types::TypeData {
                        id: _,
                        kind: go_types::TypeKind::Named {
                            object,
                            underlying: _,
                            type_params: _,
                            type_args: _,
                            methods: _,
                        },
                    }) => object.value
                        == state.active_type_objects[state.active_type_objects.len() - 1].value,
                    _ => false,
                }
            } else {
                false
            };
            if recursive {
                state.deferred_direct_type_cycles.push(
                    state.active_type_objects[state.active_type_objects.len() - 1],
                )
            } else {
                diagnostic(
                    state,
                    selector,
                    expression_source_text(state, node) + " undefined (type "
                        + diagnostic_type_string(state, receiver)
                        + " has no field or method "
                        + name
                        + ")",
                    false,
                )
            }
            invalid_operand(state)
        },
    }
}

fn value_selector_operand(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    expression: syntax::NodeId,
    selector: syntax::NodeId,
    name: string,
) -> Operand {
    let mut base = check_expression(state, scope, expression);
    if base.type_id.value == state.world.invalid.value {
        match recorded_selection_index(state, expression) {
            Some(index) => {
                let fact = state.info.selections[index];
                if fact.type_id.value != state.world.invalid.value
                    && go_types::is_named(state.world, fact.type_id) {
                    base = Operand {
                        type_id: fact.type_id,
                        value: Option::None,
                        addressable: base.addressable,
                        assignable: base.assignable,
                    };
                    record_operand(state, expression, base);
                }
            },
            None => {},
        }
    }
    let pointer_to_named = match go_types::type_data(
        state.world,
        go_types::unalias(state.world, base.type_id),
    ).kind {
        go_types::TypeKind::Pointer { element } => go_types::is_named(state.world, element),
        _ => false,
    };
    let invalid_struct = match underlying_kind(state, base.type_id) {
        Some(go_types::TypeKind::Struct { fields: _ }) => true,
        _ => false,
    };
    if base.type_id.value == state.world.invalid.value
        || (!go_types::is_named(state.world, base.type_id) && !pointer_to_named
            && type_contains_invalid(state, base.type_id)
            && !type_contains_active_type(state, base.type_id)
            && !invalid_struct) {
        return invalid_operand(state)
    }
    if pointer_to_interface_type(state, base.type_id) {
        diagnostic(
            state,
            selector,
            expression_source_text(state, node) + " undefined (type "
                + diagnostic_type_string(state, base.type_id)
                + " is pointer to interface, not interface)",
            false,
        );
        return invalid_operand(state)
    }
    let indirect_recursive = record_active_value_type_cycle(state, base.type_id, true);
    if indirect_recursive {
        omit_indirect_cycle_facts(state, node, expression)
    }
    match go_types::lookup_field_or_method_detailed(
        state.world,
        base.type_id,
        base.addressable,
        name,
    ) {
        go_types::FieldOrMethodLookup::Found(selection) => match go_types::get_object(
            state.world,
            selection.object,
        ) {
            Some(object) => {
                if go_types::is_type_parameter(state.world, base.type_id)
                    && object.kind != go_types::ObjectKind::Func {
                    diagnostic(
                        state,
                        selector,
                        expression_source_text(state, node) + " undefined (type "
                            + diagnostic_type_string(state, base.type_id)
                            + " has no field or method "
                            + name
                            + ")",
                        false,
                    );
                    return invalid_operand(state)
                }
                if !selector_object_accessible(state, object) {
                    let similar_method = similar_method_in_type(
                        state,
                        base.type_id,
                        name,
                        base.addressable,
                    );
                    if similar_method == "" {
                        diagnostic(
                            state,
                            selector,
                            expression_source_text(state, node)
                                + " undefined (cannot refer to unexported "
                                + if object.kind == go_types::ObjectKind::Func {
                                    "method "
                                } else {
                                    "field "
                                }
                                + object.name
                                + ")",
                            false,
                        )
                    } else {
                        diagnostic(
                            state,
                            selector,
                            expression_source_text(state, node) + " undefined (type "
                                + diagnostic_type_string(state, base.type_id)
                                + " has no field or method "
                                + name
                                + ", but does have method "
                                + similar_method
                                + ")",
                            false,
                        )
                    }
                    return invalid_operand(state)
                }
                let field_type = if object.kind == go_types::ObjectKind::Func {
                    object.type_id
                } else {
                    recovered_field_selection_type(state, object.type_id)
                };
                let recovered_field_type = field_type.value != object.type_id.value;
                if recovered_field_type {
                    let _ = go_types::set_object_type(state.world, selection.object, field_type);
                }
                let selected_type = if object.kind == go_types::ObjectKind::Func {
                    method_value_type(state, object.type_id)
                } else {
                    field_type
                };
                publish_active_initializer_root_type(state, node, selected_type);
                if object.kind == go_types::ObjectKind::Func {
                    evaluate_function_dependency(state, selection.object)
                }
                let selection_type = if object.kind == go_types::ObjectKind::Func {
                    method_value_selection_type(state, base.type_id, object.type_id)
                } else {
                    field_type
                };
                let incomplete_field = object.kind != go_types::ObjectKind::Func
                    && incomplete_named_instance(state, base.type_id);
                if incomplete_field {
                    let _ = state.omitted_type_fact_nodes.insert(node.value);
                    let _ = state.omitted_use_fact_nodes.insert(selector.value);
                }
                record_use(state, selector, selection.object);
                record_selection(
                    state,
                    SelectionFact {
                        node,
                        receiver_type: base.type_id,
                        object: selection.object,
                        type_id: selection_type,
                        index: selection.index,
                        indirect: selection.indirect,
                    },
                );
                let operand_type = if incomplete_field {
                    state.world.invalid
                } else if recovered_field_type {
                    if selected_type.value == state.world.invalid.value {
                        let _ = state.retained_invalid_type_fact_nodes.insert(node.value);
                    }
                    selected_type
                } else if selection_type_contains_direct_invalid(state, selected_type) {
                    let _ = state.retained_invalid_type_fact_nodes.insert(node.value);
                    state.world.invalid
                } else {
                    selected_type
                };
                Operand {
                    type_id: operand_type,
                    value: Option::None,
                    addressable: object.kind == go_types::ObjectKind::Var
                        && (base.addressable || selection.indirect),
                    assignable: object.kind == go_types::ObjectKind::Var
                        && (base.addressable || selection.indirect),
                }
            },
            None => invalid_operand(state),
        },
        go_types::FieldOrMethodLookup::Ambiguous => {
            diagnostic(
                state,
                selector,
                "ambiguous selector " + expression_source_text(state, node),
                false,
            );
            invalid_operand(state)
        },
        go_types::FieldOrMethodLookup::Missing => {
            let pointer_to_type_parameter = match go_types::get_type(
                state.world,
                go_types::unalias(state.world, base.type_id),
            ) {
                Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) => go_types::is_type_parameter(
                    state.world,
                    element,
                ),
                _ => false,
            };
            if pointer_to_type_parameter {
                diagnostic(
                    state,
                    selector,
                    expression_source_text(state, node) + " undefined (type "
                        + diagnostic_type_string(state, base.type_id)
                        + " is pointer to type parameter, not type parameter)",
                    false,
                );
                return invalid_operand(state)
            }
            if !base.addressable {
                let pointer = go_types::add_type(
                    state.world,
                    go_types::TypeKind::Pointer { element: base.type_id },
                );
                match go_types::lookup_field_or_method_detailed(state.world, pointer, false, name) {
                    go_types::FieldOrMethodLookup::Found(selection) => match go_types::get_object(
                        state.world,
                        selection.object,
                    ) {
                        Some(object) => if object.kind == go_types::ObjectKind::Func {
                            diagnostic(
                                state,
                                selector,
                                "cannot call pointer method " + name + " on "
                                    + diagnostic_type_string(state, base.type_id),
                                false,
                            );
                            return invalid_operand(state)
                        },
                        None => {},
                    },
                    _ => {},
                }
            }
            let recursive_type = if state.array_length_depth > 0
                && !state.active_type_objects.is_empty() {
                match go_types::get_type(state.world, go_types::unalias(state.world, base.type_id)) {
                    Some(go_types::TypeData {
                        id: _,
                        kind: go_types::TypeKind::Named {
                            object,
                            underlying: _,
                            type_params: _,
                            type_args: _,
                            methods: _,
                        },
                    }) => object.value
                        == state.active_type_objects[state.active_type_objects.len() - 1].value,
                    _ => false,
                }
            } else {
                false
            };
            if recursive_type || indirect_recursive {
                let active = state.active_type_objects[state.active_type_objects.len() - 1];
                if !type_value_cycle_contains(state, active) {
                    state.deferred_direct_type_cycles.push(active)
                }
            } else {
                let similar_method = similar_method_in_type(
                    state,
                    base.type_id,
                    name,
                    base.addressable,
                );
                let similar_field = similar_field_in_type(state, base.type_id, name);
                let suggestion = match similar_field {
                    Some(object_id) => match go_types::get_object(state.world, object_id) {
                        Some(object) => if selector_object_accessible(state, object) {
                            ", but does have field " + object.name
                        } else if similar_method != "" {
                            ", but does have method " + similar_method
                        } else {
                            ", but does have unexported field " + object.name
                        },
                        None => "",
                    },
                    None => if similar_method == "" {
                        ""
                    } else {
                        ", but does have method " + similar_method
                    },
                };
                diagnostic(
                    state,
                    selector,
                    expression_source_text(state, node) + " undefined (type "
                        + diagnostic_type_string(state, base.type_id)
                        + " has no field or method "
                        + name
                        + suggestion
                        + ")",
                    false,
                )
            }
            invalid_operand(state)
        },
    }
}

fn dereference_operand(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    expression: syntax::NodeId,
) -> Operand {
    match builtin_expression(state, scope, expression) {
        Some((_, builtin)) => {
            diagnostic(
                state,
                expression,
                "invalid operation: cannot indirect " + builtin + " (built-in)",
                false,
            );
            return invalid_operand(state)
        },
        None => {},
    }
    let source = check_expression(state, scope, expression);
    if type_contains_invalid(state, source.type_id)
        && !type_contains_active_type(state, source.type_id) {
        return invalid_operand(state)
    }
    if go_types::is_type_parameter(state.world, source.type_id) {
        let terms = go_types::type_set_specific_types(state.world, source.type_id);
        let mut element: Option[go_types::TypeId] = Option::None;
        let mut all_pointers = !terms.is_empty();
        let mut identical_elements = true;
        for term in terms {
            match go_types::get_type(state.world, core_type_id(state, term)) {
                Some(go_types::TypeData {
                    id: _,
                    kind: go_types::TypeKind::Pointer { element: candidate },
                }) => match element {
                    Some(existing) => if !go_types::identical(state.world, existing, candidate) {
                        identical_elements = false;
                    },
                    None => {
                        element = Option::Some(candidate);
                    },
                },
                _ => {
                    all_pointers = false;
                },
            }
        }
        if all_pointers && !identical_elements {
            diagnostic(
                state,
                expression,
                "invalid operation: pointers of " + operand_string(state, expression, source)
                    + " must have identical base types",
                false,
            );
            return invalid_operand(state)
        } else if all_pointers {
            match element {
                Some(element) => return Operand {
                    type_id: element,
                    value: Option::None,
                    addressable: true,
                    assignable: true,
                },
                None => {},
            }
        }
    }
    match go_types::get_type(state.world, core_type_id(state, source.type_id)) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element } }) => {
            if record_active_value_type_cycle(state, element, false) {
                let _ = state.omitted_type_fact_nodes.insert(node.value);
            }
            Operand { type_id: element, value: Option::None, addressable: true, assignable: true }
        },
        _ => {
            diagnostic(
                state,
                expression,
                "invalid operation: cannot indirect " + operand_string(state, expression, source),
                false,
            );
            invalid_operand(state)
        },
    }
}

fn anonymous_empty_type_parameter(state: CheckState, value: go_types::TypeId) -> bool {
    match go_types::type_data(state.world, go_types::unalias(state.world, value)) {
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::TypeParam { object: _, constraint, index: _ },
        } => !go_types::is_named(state.world, constraint)
            && go_types::type_set_is_empty(state.world, constraint),
        _ => false,
    }
}

fn type_parameter_constraint_contains_invalid(state: CheckState, value: go_types::TypeId) -> bool {
    match go_types::type_data(state.world, go_types::unalias(state.world, value)) {
        go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::TypeParam { object: _, constraint, index: _ },
        } => type_contains_invalid(state, constraint),
        _ => false,
    }
}

fn check_binary(
    state: CheckState,
    scope: go_types::ScopeId,
    node: syntax::NodeId,
    left_node: syntax::NodeId,
    op: string,
    right_node: syntax::NodeId,
) -> Operand {
    let left = check_expression(state, scope, left_node);
    let right = check_expression(state, scope, right_node);
    if left.type_id.value == state.world.invalid.value
        || right.type_id.value == state.world.invalid.value {
        return invalid_operand(state)
    }
    let left_multiple = tuple_arity(state, left.type_id) > 1;
    let right_multiple = tuple_arity(state, right.type_id) > 1;
    if left_multiple {
        diagnostic(
            state,
            left_node,
            "multiple-value " + operand_string(state, left_node, left) + " in single-value context",
            false,
        )
    }
    if right_multiple {
        diagnostic(
            state,
            right_node,
            "multiple-value " + operand_string(state, right_node, right)
                + " in single-value context",
            false,
        )
    }
    if left_multiple || right_multiple {
        return invalid_operand(state)
    }
    if !go_types::identical(state.world, left.type_id, right.type_id)
        && (type_parameter_constraint_contains_invalid(state, left.type_id)
            || type_parameter_constraint_contains_invalid(state, right.type_id)) {
        return if comparison_operator(op) {
            if go_types::is_untyped(state.world, left.type_id)
                && !go_types::is_untyped(state.world, right.type_id) {
                update_operand_fact(state, left_node, right.type_id, left.value)
            } else if go_types::is_untyped(state.world, right.type_id)
                && !go_types::is_untyped(state.world, left.type_id) {
                update_operand_fact(state, right_node, left.type_id, right.value)
            }
            Operand {
                type_id: basic_type_id(state, "untyped bool"),
                value: Option::None,
                addressable: false,
                assignable: false,
            }
        } else {
            invalid_operand(state)
        }
    }
    let empty_type_set = if equality_operator(op)
        && anonymous_empty_type_parameter(state, left.type_id) {
        Option::Some(left_node)
    } else if equality_operator(op) && anonymous_empty_type_parameter(state, right.type_id) {
        Option::Some(right_node)
    } else {
        Option::None
    };
    match empty_type_set {
        Some(diagnostic_node) => {
            diagnostic(
                state,
                diagnostic_node,
                "invalid operation: " + expression_source_text(state, node) + " (empty type set)",
                false,
            );
            return invalid_operand(state)
        },
        None => {},
    }
    if shift_operator(op) {
        let valid_untyped_left = go_types::is_untyped(state.world, left.type_id)
            && match left.value {
                Some(value) => constant::constant_to_integer(value).is_some(),
                None => false,
            };
        if !go_types::is_integer(state.world, left.type_id) && !valid_untyped_left {
            diagnostic(
                state,
                left_node,
                "invalid operation: shifted operand " + operand_string(state, left_node, left)
                    + " must be integer",
                false,
            );
            return invalid_operand(state)
        }
        match right.value {
            Some(value) => match constant::constant_to_integer(value) {
                Some(_) => if constant::constant_sign(value).unwrap_or(0) < 0 {
                    diagnostic(
                        state,
                        right_node,
                        "invalid operation: negative shift count "
                            + operand_string(state, right_node, right),
                        false,
                    );
                    return invalid_operand(state)
                } else if !constant::constant_representable(
                    value,
                    go_types::BasicKind::Uint,
                    state.config.sizes,
                ) {
                    diagnostic(
                        state,
                        right_node,
                        operand_string(state, right_node, right) + " overflows uint",
                        false,
                    );
                    return invalid_operand(state)
                },
                None => {
                    diagnostic(
                        state,
                        right_node,
                        if go_types::is_numeric(state.world, right.type_id) {
                            operand_string(state, right_node, right) + " truncated to uint"
                        } else {
                            "cannot convert " + operand_string(state, right_node, right)
                                + " to type uint"
                        },
                        false,
                    );
                    return invalid_operand(state)
                },
            },
            None => if go_types::is_untyped(state.world, right.type_id)
                && go_types::is_numeric(state.world, right.type_id) {
                if basic_kind(state, right.type_id) != go_types::BasicKind::UntypedInt {
                    update_contextual_operand_fact(
                        state,
                        right_node,
                        right,
                        basic_type_id(state, "uint"),
                    )
                }
            } else if !go_types::is_integer(state.world, right.type_id) {
                diagnostic(
                    state,
                    right_node,
                    "invalid operation: shift count " + operand_string(state, right_node, right)
                        + " must be integer",
                    false,
                );
                return invalid_operand(state)
            },
        }
        if right.value.is_none() && signed_integer_type(state, right.type_id)
            && !go_version_at_least(state, node, 13) {
            diagnostic(
                state,
                right_node,
                "invalid operation: signed shift count " + operand_string(state, right_node, right)
                    + " requires go1.13 or later",
                false,
            );
            return invalid_operand(state)
        }
        let value: Option[constant::ConstValue] = match (left.value, right.value) {
            (Some(left_value), Some(right_value)) => match shift_amount(right_value) {
                Some(amount) => if amount > 1074 {
                    diagnostic(
                        state,
                        right_node,
                        "invalid operation: invalid shift count "
                            + operand_string(state, right_node, right),
                        false,
                    );
                    return invalid_operand(state)
                } else {
                    Option::Some(
                        if op == SHIFT_LEFT_OPERATOR {
                            constant::constant_shift_left(left_value, amount)
                        } else {
                            constant::constant_shift_right(left_value, amount)
                        },
                    )
                },
                None => {
                    diagnostic(
                        state,
                        right_node,
                        "invalid operation: invalid shift count "
                            + operand_string(state, right_node, right),
                        false,
                    );
                    return invalid_operand(state)
                },
            },
            _ => Option::None,
        };
        if basic_kind(state, left.type_id) == go_types::BasicKind::UntypedInt
            && match value {
                Some(value) => constant::constant_exceeds_integer_precision(value, 512),
                None => false,
            } {
            let position = match syntax::get_node(state.syntax.arena, node) {
                Some(syntax::SyntaxNode {
                    id: _,
                    file: _,
                    span: _,
                    path: _,
                    kind: syntax::SyntaxKind::BinaryExpr { left: _, op_pos, op: _, right: _ },
                }) => op_pos,
                _ => node_start(state, node),
            };
            diagnostic_at_position(state, node, position, "constant shift overflow", false);
            return Operand {
                type_id: left.type_id,
                value: Option::Some(constant::ConstValue::Unknown),
                addressable: false,
                assignable: false,
            }
        }
        let result_type = if left.value.is_some() && right.value.is_some()
            && !go_types::is_integer(state.world, left.type_id) {
            basic_type_id(state, "untyped int")
        } else {
            left.type_id
        };
        if !go_types::is_untyped(state.world, result_type)
            && match value {
                Some(value) => !constant::constant_representable(
                    value,
                    basic_kind(state, result_type),
                    state.config.sizes,
                ),
                None => false,
            } {
            let shifted = Operand {
                type_id: result_type,
                value,
                addressable: false,
                assignable: false,
            };
            diagnostic(
                state,
                node,
                operand_string(state, node, shifted) + " overflows "
                    + diagnostic_type_string(state, result_type),
                false,
            );
            return invalid_operand(state)
        }
        return Operand { type_id: result_type, value, addressable: false, assignable: false }
    }
    if logical_operator(op) {
        if !is_boolean_type(state, left.type_id) || !is_boolean_type(state, right.type_id) {
            diagnostic(state, node, "invalid boolean operation", false);
            return invalid_operand(state)
        }
        let result_type = binary_operand_type(state, left, right);
        if result_type.value == state.world.invalid.value {
            diagnostic(
                state,
                node,
                "invalid operation: " + expression_source_text(state, node) + " (mismatched types "
                    + diagnostic_type_string(state, left.type_id)
                    + " and "
                    + diagnostic_type_string(state, right.type_id)
                    + ")",
                false,
            );
            return invalid_operand(state)
        }
        if result_type.value != state.world.invalid.value
            && !go_types::is_untyped(state.world, result_type) {
            update_contextual_operand_fact(state, left_node, left, result_type);
            update_contextual_operand_fact(state, right_node, right, result_type)
        }
        let value = match (left.value, right.value) {
            (Some(constant::ConstValue::Bool(left)), Some(constant::ConstValue::Bool(right))) => Option::Some(
                constant::ConstValue::Bool(
                    if op == LOGICAL_AND_OPERATOR {
                        left && right
                    } else {
                        left || right
                    },
                ),
            ),
            _ => Option::None,
        };
        return match value {
            Some(value) => Operand {
                type_id: basic_type_id(state, "untyped bool"),
                value: Option::Some(value),
                addressable: false,
                assignable: false,
            },
            None => Operand {
                type_id: result_type,
                value: Option::None,
                addressable: false,
                assignable: false,
            },
        }
    }
    if comparison_operator(op) {
        let equality = equality_operator(op);
        let mut operand_type = binary_operand_type(state, left, right);
        if operand_type.value == state.world.invalid.value
            && (equality || go_types::is_interface(state.world, left.type_id)
                || go_types::is_interface(state.world, right.type_id)) {
            if go_types::assignable_types(state.world, left.type_id, right.type_id) {
                operand_type = right.type_id;
            } else if go_types::assignable_types(state.world, right.type_id, left.type_id) {
                operand_type = left.type_id;
            }
        }
        let nil_comparison = (basic_kind(state, left.type_id) == go_types::BasicKind::UntypedNil
            && go_types::is_nilable_type(state.world, right.type_id))
            || (basic_kind(state, right.type_id) == go_types::BasicKind::UntypedNil
                && go_types::is_nilable_type(state.world, left.type_id));
        if nil_comparison && operand_type.value == state.world.invalid.value {
            operand_type = if basic_kind(state, left.type_id) == go_types::BasicKind::UntypedNil {
                right.type_id
            } else {
                left.type_id
            };
        }
        if go_types::is_untyped(state.world, operand_type)
            && (left.value.is_none() || right.value.is_none()) {
            let contextual_type = default_operand_type(
                state,
                Operand {
                    type_id: operand_type,
                    value: Option::None,
                    addressable: false,
                    assignable: false,
                },
            );
            let diagnostic_count = state.diagnostics.len();
            update_contextual_operand_fact(state, left_node, left, contextual_type);
            update_contextual_operand_fact(state, right_node, right, contextual_type);
            match left.value {
                Some(value) => update_operand_fact(
                    state,
                    left_node,
                    contextual_type,
                    Option::Some(value),
                ),
                None => {},
            }
            match right.value {
                Some(value) => update_operand_fact(
                    state,
                    right_node,
                    contextual_type,
                    Option::Some(value),
                ),
                None => {},
            }
            if state.diagnostics.len() > diagnostic_count {
                return Operand {
                    type_id: basic_type_id(state, "untyped bool"),
                    value: Option::None,
                    addressable: false,
                    assignable: false,
                }
            }
            operand_type = contextual_type;
        }
        if operand_type.value != state.world.invalid.value
            && !go_types::is_untyped(state.world, operand_type)
            && (report_binary_operand_overflow(state, left_node, left, operand_type)
                || report_binary_operand_overflow(state, right_node, right, operand_type)) {
            return invalid_operand(state)
        }
        let valid = operand_type.value != state.world.invalid.value
            && if equality {
                nil_comparison
                    || (go_types::comparable(state.world, left.type_id)
                        && go_types::comparable(state.world, right.type_id))
            } else {
                go_types::is_ordered(state.world, operand_type)
            };
        if !valid {
            if operand_type.value == state.world.invalid.value && !equality
                && ((go_types::is_type_parameter(state.world, left.type_id)
                    && !go_types::is_ordered(state.world, left.type_id))
                    || (go_types::is_type_parameter(state.world, right.type_id)
                        && !go_types::is_ordered(state.world, right.type_id))) {
                let (unsupported_node, unsupported) = if go_types::is_type_parameter(
                    state.world,
                    left.type_id,
                )
                    && !go_types::is_ordered(state.world, left.type_id) {
                    (left_node, left.type_id)
                } else {
                    (right_node, right.type_id)
                };
                report_unsupported_comparison(state, node, unsupported_node, op, unsupported)
            } else if operand_type.value == state.world.invalid.value {
                diagnostic(
                    state,
                    right_node,
                    "invalid operation: " + expression_source_text(state, node)
                        + " (mismatched types "
                        + diagnostic_type_string(state, left.type_id)
                        + " and "
                        + diagnostic_type_string(state, right.type_id)
                        + ")",
                    false,
                )
            } else if equality && basic_kind(state, left.type_id) == go_types::BasicKind::UntypedNil
                && basic_kind(state, right.type_id) == go_types::BasicKind::UntypedNil {
                report_unsupported_comparison(state, node, right_node, op, left.type_id)
            } else if equality {
                let (bad_node, bad_type) = if !go_types::comparable(state.world, left.type_id) {
                    (left_node, left.type_id)
                } else {
                    (right_node, right.type_id)
                };
                diagnostic(
                    state,
                    bad_node,
                    "invalid operation: " + expression_source_text(state, node) + " ("
                        + noncomparable_reason(state, bad_type)
                        + ")",
                    false,
                )
            } else {
                let (unsupported_node, unsupported) = if !go_types::is_ordered(
                    state.world,
                    left.type_id,
                ) {
                    (left_node, left.type_id)
                } else {
                    (right_node, right.type_id)
                };
                report_unsupported_comparison(state, node, unsupported_node, op, unsupported)
            }
            return invalid_operand(state)
        }
        update_binary_operand_fact(state, left_node, left, operand_type);
        update_binary_operand_fact(state, right_node, right, operand_type);
        return match (left.value, right.value) {
            (Some(left), Some(right)) => match comparison_value(op, left, right) {
                Some(value) => Operand {
                    type_id: basic_type_id(state, "untyped bool"),
                    value: Option::Some(value),
                    addressable: false,
                    assignable: false,
                },
                None => {
                    diagnostic(state, node, "invalid comparison", false);
                    invalid_operand(state)
                },
            },
            _ => Operand {
                type_id: basic_type_id(state, "untyped bool"),
                value: Option::None,
                addressable: false,
                assignable: false,
            },
        }
    }
    let result_type = binary_operand_type(state, left, right);
    if result_type.value == state.world.invalid.value {
        diagnostic(
            state,
            node,
            "invalid operation: " + expression_source_text(state, node) + " (mismatched types "
                + diagnostic_type_string(state, left.type_id)
                + " and "
                + diagnostic_type_string(state, right.type_id)
                + ")",
            false,
        );
        return invalid_operand(state)
    }
    if !go_types::is_untyped(state.world, result_type)
        && (report_binary_operand_overflow(state, left_node, left, result_type)
            || report_binary_operand_overflow(state, right_node, right, result_type)) {
        return invalid_operand(state)
    }
    update_binary_operand_fact(state, left_node, left, result_type);
    update_binary_operand_fact(state, right_node, right, result_type);
    if !valid_binary_operator(state, op, result_type) {
        diagnostic(
            state,
            left_node,
            "invalid operation: operator " + op + " not defined on "
                + operand_string(state, left_node, operand_with_type(left, result_type)),
            false,
        );
        return invalid_operand(state)
    }
    if (op == DIVIDE_OPERATOR || op == REMAINDER_OPERATOR)
        && (go_types::is_integer(state.world, result_type) || left.value.is_some())
        && match right.value {
            Some(value) => constant::constant_sign(value).unwrap_or(1) == 0,
            None => false,
        } {
        diagnostic(state, right_node, "invalid operation: division by zero", false);
        return invalid_operand(state)
    }
    let value: Option[constant::ConstValue] = match (
        binary_constant_value(state, left, result_type),
        binary_constant_value(state, right, result_type),
    ) {
        (Some(left), Some(right)) => Option::Some(constant_binary_value(op, left, right)),
        _ => Option::None,
    };
    if match value {
        Some(value) => constant::constant_kind(value) == constant::ConstantKind::Unknown
            && match (left.value, right.value) {
                (Some(left), Some(right)) => constant::constant_kind(left)
                    != constant::ConstantKind::Unknown
                    && constant::constant_kind(right) != constant::ConstantKind::Unknown,
                _ => false,
            },
        None => false,
    } {
        let position = match syntax::get_node(state.syntax.arena, node) {
            Some(syntax::SyntaxNode {
                id: _,
                file: _,
                span: _,
                path: _,
                kind: syntax::SyntaxKind::BinaryExpr { left: _, op_pos, op: _, right: _ },
            }) => op_pos,
            _ => node_start(state, node),
        };
        diagnostic_at_position(state, node, position, "constant result is not representable", false);
        return Operand {
            type_id: result_type,
            value: Option::Some(constant::ConstValue::Unknown),
            addressable: false,
            assignable: false,
        }
    }
    if !go_types::is_untyped(state.world, result_type)
        && match value {
            Some(value) => constant::constant_kind(value) != constant::ConstantKind::Unknown
                && !constant::constant_representable(
                    value,
                    basic_kind(state, result_type),
                    state.config.sizes,
                ),
            None => false,
        } {
        let result = Operand { type_id: result_type, value, addressable: false, assignable: false };
        diagnostic(
            state,
            node,
            operand_string(state, node, result) + " overflows "
                + diagnostic_type_string(state, result_type),
            false,
        );
        invalid_operand(state)
    } else if match value {
        Some(value) => constant::constant_kind(value) == constant::ConstantKind::Unknown,
        None => false,
    } {
        Operand { type_id: result_type, value, addressable: false, assignable: false }
    } else if basic_kind(state, result_type) == go_types::BasicKind::UntypedInt
        && match value {
            Some(value) => constant::constant_exceeds_integer_precision(value, 512),
            None => false,
        } {
        let position = match syntax::get_node(state.syntax.arena, node) {
            Some(syntax::SyntaxNode {
                id: _,
                file: _,
                span: _,
                path: _,
                kind: syntax::SyntaxKind::BinaryExpr { left: _, op_pos, op: _, right: _ },
            }) => op_pos,
            _ => node_start(state, node),
        };
        let operation = match op {
            ADD_OPERATOR => "addition",
            SUBTRACT_OPERATOR => "subtraction",
            BIT_XOR_OPERATOR => "bitwise XOR",
            MULTIPLY_OPERATOR => "multiplication",
            _ => op,
        };
        diagnostic_at_position(state, node, position, "constant " + operation + " overflow", false);
        Operand {
            type_id: result_type,
            value: Option::Some(constant::ConstValue::Unknown),
            addressable: false,
            assignable: false,
        }
    } else {
        let rounded = if go_types::is_untyped(state.world, result_type) {
            value
        } else {
            match value {
                Some(value) => match constant::round_constant(
                    constant::constant_copy(value),
                    basic_kind(state, result_type),
                    state.config.sizes,
                ) {
                    Some(value) => Option::Some(value),
                    None => Option::Some(value),
                },
                None => Option::None,
            }
        };
        Operand { type_id: result_type, value: rounded, addressable: false, assignable: false }
    }
}

fn check_expression(state: CheckState, scope: go_types::ScopeId, node: syntax::NodeId) -> Operand {
    let result = match syntax::get_node(state.syntax.arena, node) {
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::BadExpr { from: _, to: _ },
        }) => invalid_operand(state),
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::BasicLit { value_pos: _, value_end: _, token, value },
        }) => literal_operand(state, node, token, value),
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::Ident { name_pos: _, name },
        }) => identifier_operand(state, scope, node, name),
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::ParenExpr { lparen: _, expression, rparen: _ },
        }) => {
            let inner = check_expression(state, scope, expression);
            if node_is_void(state, expression) {
                mark_void_node(state, node)
            }
            Operand {
                type_id: inner.type_id,
                value: inner.value.map(|value| constant::constant_copy(value)),
                addressable: inner.addressable,
                assignable: inner.assignable,
            }
        },
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::SelectorExpr { expression, selector },
        }) => selector_operand(state, scope, node, expression, selector),
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::IndexExpr { expression, lbrack: _, index, rbrack: _ },
        }) => match builtin_expression(state, scope, expression) {
            Some((_, builtin)) => {
                let _ = check_expression(state, scope, index);
                diagnostic(state, expression, "cannot index " + builtin + " (built-in)", false);
                invalid_operand(state)
            },
            None => match check_explicit_instance(
                state,
                scope,
                node,
                expression,
                Vec::from_array([index]),
            ) {
                Some(value) => value,
                None => check_index_expression(state, scope, node, expression, index),
            },
        },
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::IndexListExpr { expression, lbrack: _, indices, rbrack: _ },
        }) => match check_explicit_instance(state, scope, node, expression, indices) {
            Some(value) => value,
            None => if indices.len() > 1 {
                diagnostic(state, indices[1], "invalid operation: more than one index", false);
                check_index_expression(state, scope, node, expression, indices[0])
            } else if indices.len() == 1 {
                check_index_expression(state, scope, node, expression, indices[0])
            } else {
                let base = check_expression(state, scope, expression);
                if base.type_id.value != state.world.invalid.value
                    && indexed_type(state, base.type_id).is_none() {
                    diagnostic(
                        state,
                        expression,
                        "cannot index " + operand_string(state, expression, base),
                        false,
                    )
                }
                invalid_operand(state)
            },
        },
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::SliceExpr {
                expression,
                lbrack: _,
                low,
                high,
                max,
                slice3,
                rbrack: _,
            },
        }) => check_slice_expression(state, scope, node, expression, low, high, max, slice3),
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::TypeAssertExpr { expression, lparen: _, type_node, rparen: _ },
        }) => check_type_assertion(state, scope, node, expression, type_node),
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::CompositeLit {
                type_node,
                lbrace: _,
                elements,
                rbrace: _,
                incomplete: _,
            },
        }) => check_composite_literal(state, scope, node, type_node, elements),
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::FuncLit { type_node, body },
        }) => check_function_literal(state, scope, type_node, body),
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::StarExpr { star: _, expression },
        }) => dereference_operand(state, scope, node, expression),
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::UnaryExpr { op_pos: _, op, expression },
        }) => check_unary(state, scope, node, op, expression),
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::BinaryExpr { left, op_pos: _, op, right },
        }) => check_binary(state, scope, node, left, op, right),
        Some(syntax::SyntaxNode {
            id: _,
            file: _,
            span: _,
            path: _,
            kind: syntax::SyntaxKind::CallExpr {
                function,
                lparen: _,
                arguments,
                ellipsis,
                rparen: _,
            },
        }) => match conversion_target(state, scope, function) {
            Some(target) => check_conversion(state, scope, node, target, arguments, ellipsis),
            None => check_call(state, scope, node, function, arguments, ellipsis),
        },
        Some(_) => {
            diagnostic(state, node, "expression is not implemented yet", false);
            invalid_operand(state)
        },
        None => invalid_operand(state),
    };
    record_operand(state, node, result);
    result
}
