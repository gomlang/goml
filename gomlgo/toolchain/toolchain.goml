package toolchain;

use std::env;
use std::fs;
use std::json;
use std::path;
use std::process;
use std::text;
use std::utf8;
use utf8::BytesUtf8;

pub fn default_binary() -> string {
    match env::var_structured("GOMLGO_GO") {
        Ok(value) => if value == "" {
            "go"
        } else {
            value
        },
        Err(_) => if fs::is_file("/usr/lib/go-1.26/bin/go") {
            "/usr/lib/go-1.26/bin/go"
        } else {
            "go"
        },
    }
}

pub fn compatible_version(value: string) -> bool {
    value == "go1.26" || value.starts_with("go1.26.")
}

pub fn source_root() -> Result[string, string] {
    let output = process::Command::new(default_binary()).args(
        Vec::from_array(["env", "-json", "GOROOT", "GOVERSION"]),
    ).env("GOTOOLCHAIN", "local").output_structured().map_err(|error| error.to_string())?;
    if !process::ExitStatus::success(process::Output::status(output)) {
        return Result::Err(
            "go env failed: "
                + text::trim(
                    process::Output::stderr(output).to_string_utf8().unwrap_or("<non-UTF-8 output>"),
                ),
        )
    }
    let value = json::parse(
        process::Output::stdout(output).to_string_utf8().map_err(|error| error.to_string())?,
    )?;
    let version = json::field(value, "GOVERSION").and_then(|field| json::as_string(field)).ok_or(
        "go env omitted GOVERSION",
    )?;
    if !compatible_version(version) {
        return Result::Err("gomlgo requires Go 1.26.x, found " + version)
    }
    let root = json::field(value, "GOROOT").and_then(|field| json::as_string(field)).ok_or(
        "go env omitted GOROOT",
    )?;
    if root == "" {
        return Result::Err("go env returned an empty GOROOT")
    }
    Result::Ok(path::join(root, "src"))
}
