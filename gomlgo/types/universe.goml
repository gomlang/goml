package types;

fn add_basic(
    world: World,
    scope: ScopeId,
    owner: Option[PackageId],
    basic: BasicKind,
    name: string,
    untyped: bool,
    visible: bool,
) -> TypeId {
    let result = add_type(world, TypeKind::Basic { basic, name, untyped });
    world.basics.push(BasicTypeEntry { name, type_id: result });
    if visible {
        let object = add_object(
            world,
            ObjectKind::TypeName,
            name,
            owner,
            Option::None,
            Option::None,
            -1,
            result,
        );
        let _ = insert(world, scope, name, object);
    }
    result
}

fn add_type_name(
    world: World,
    scope: ScopeId,
    owner: Option[PackageId],
    name: string,
    value: TypeId,
) -> ObjectId {
    let object = add_object(
        world,
        ObjectKind::TypeName,
        name,
        owner,
        Option::None,
        Option::None,
        -1,
        value,
    );
    let _ = insert(world, scope, name, object);
    object
}

fn add_constant(world: World, name: string, kind: string, value: string, value_type: TypeId) -> () {
    let object = add_object(
        world,
        ObjectKind::Const,
        name,
        Option::None,
        Option::None,
        Option::None,
        -1,
        value_type,
    );
    let _ = set_object_constant(world, object, kind, value);
    let _ = insert(world, world.universe, name, object);
}

fn add_builtin(world: World, scope: ScopeId, owner: Option[PackageId], name: string) -> () {
    let object = add_object(
        world,
        ObjectKind::Builtin,
        name,
        owner,
        Option::None,
        Option::None,
        -1,
        world.invalid,
    );
    let _ = insert(world, scope, name, object);
}

fn add_error_type(world: World, string_type: TypeId) -> () {
    let object = add_object(
        world,
        ObjectKind::TypeName,
        "error",
        Option::None,
        Option::None,
        Option::None,
        -1,
        world.invalid,
    );
    let named = add_type(
        world,
        TypeKind::Named {
            object,
            underlying: world.invalid,
            type_params: Vec::new(),
            type_args: Vec::new(),
            methods: Vec::new(),
        },
    );
    let _ = set_object_type(world, object, named);
    let empty = add_type(world, TypeKind::Tuple { variables: Vec::new() });
    let results = add_type(
        world,
        TypeKind::Tuple {
            variables: Vec::from_array(
                [Variable { name: "", owner: Option::None, type_id: string_type }],
            ),
        },
    );
    let signature = add_type(
        world,
        TypeKind::Signature {
            receiver: Option::Some(Variable { name: "", owner: Option::None, type_id: named }),
            receiver_type_params: Vec::new(),
            type_params: Vec::new(),
            params: empty,
            results,
            variadic: false,
        },
    );
    let method = add_object(
        world,
        ObjectKind::Func,
        "Error",
        Option::None,
        Option::None,
        Option::None,
        -1,
        signature,
    );
    let interface_type = add_type(
        world,
        TypeKind::Interface {
            methods: Vec::from_array([method]),
            embeddeds: Vec::new(),
            comparable: false,
            implicit: false,
        },
    );
    let _ = set_type(
        world,
        named,
        TypeKind::Named {
            object,
            underlying: interface_type,
            type_params: Vec::new(),
            type_args: Vec::new(),
            methods: Vec::new(),
        },
    );
    let _ = insert(world, world.universe, "error", object);
}

fn add_comparable_type(world: World) -> () {
    let object = add_object(
        world,
        ObjectKind::TypeName,
        "comparable",
        Option::None,
        Option::None,
        Option::None,
        -1,
        world.invalid,
    );
    let interface_type = add_type(
        world,
        TypeKind::Interface {
            methods: Vec::new(),
            embeddeds: Vec::new(),
            comparable: true,
            implicit: false,
        },
    );
    let named = add_type(
        world,
        TypeKind::Named {
            object,
            underlying: interface_type,
            type_params: Vec::new(),
            type_args: Vec::new(),
            methods: Vec::new(),
        },
    );
    let _ = set_object_type(world, object, named);
    let _ = insert(world, world.universe, "comparable", object);
}

fn add_any_type(world: World) -> () {
    let interface_type = add_type(
        world,
        TypeKind::Interface {
            methods: Vec::new(),
            embeddeds: Vec::new(),
            comparable: false,
            implicit: false,
        },
    );
    let object = add_object(
        world,
        ObjectKind::TypeName,
        "any",
        Option::None,
        Option::None,
        Option::None,
        -1,
        world.invalid,
    );
    let alias = add_type(
        world,
        TypeKind::Alias {
            object,
            rhs: interface_type,
            type_params: Vec::new(),
            type_args: Vec::new(),
        },
    );
    let _ = set_object_type(world, object, alias);
    let _ = insert(world, world.universe, "any", object);
}

pub fn set_alias_enabled(world: World, enabled: bool) -> () {
    let Some(object) = lookup_local(world, world.universe, "any") else {
        return;
    };
    let object_type = match get_object(world, object) {
        Some(value) => value.type_id,
        None => return,
    };
    if enabled {
        match get_type(world, object_type) {
            Some(TypeData {
                id: _,
                kind: TypeKind::Alias { object: _, rhs: _, type_params: _, type_args: _ },
            }) => return,
            _ => {},
        }
        for value in world.types {
            match value.kind {
                TypeKind::Alias { object: alias_object, rhs: _, type_params: _, type_args: _ } => if alias_object.value
                    == object.value {
                    let _ = set_object_type(world, object, value.id);
                    return
                },
                _ => {},
            }
        }
    } else {
        match get_type(world, object_type) {
            Some(TypeData {
                id: _,
                kind: TypeKind::Alias { object: _, rhs, type_params: _, type_args: _ },
            }) => {
                let _ = set_object_type(world, object, rhs);
            },
            _ => {},
        }
    }
}

pub fn new_world() -> World {
    let world = empty_world();
    world.universe = add_scope(world, ScopeKind::Universe, Option::None, Option::None, -1, -1);
    world.unsafe_package = add_package(world, "unsafe", "unsafe", world.universe, true);
    let unsafe_scope = world.packages[world.unsafe_package.value].scope;
    let bool_type = add_basic(
        world,
        world.universe,
        Option::None,
        BasicKind::Bool,
        "bool",
        false,
        true,
    );
    let _ = add_basic(world, world.universe, Option::None, BasicKind::Int, "int", false, true);
    let _ = add_basic(world, world.universe, Option::None, BasicKind::Int8, "int8", false, true);
    let _ = add_basic(world, world.universe, Option::None, BasicKind::Int16, "int16", false, true);
    let int32_type = add_basic(
        world,
        world.universe,
        Option::None,
        BasicKind::Int32,
        "int32",
        false,
        true,
    );
    let _ = add_basic(world, world.universe, Option::None, BasicKind::Int64, "int64", false, true);
    let _ = add_basic(world, world.universe, Option::None, BasicKind::Uint, "uint", false, true);
    let uint8_type = add_basic(
        world,
        world.universe,
        Option::None,
        BasicKind::Uint8,
        "uint8",
        false,
        true,
    );
    let _ = add_basic(world, world.universe, Option::None, BasicKind::Uint16, "uint16", false, true);
    let _ = add_basic(world, world.universe, Option::None, BasicKind::Uint32, "uint32", false, true);
    let _ = add_basic(world, world.universe, Option::None, BasicKind::Uint64, "uint64", false, true);
    let _ = add_basic(
        world,
        world.universe,
        Option::None,
        BasicKind::Uintptr,
        "uintptr",
        false,
        true,
    );
    let _ = add_basic(
        world,
        world.universe,
        Option::None,
        BasicKind::Float32,
        "float32",
        false,
        true,
    );
    let _ = add_basic(
        world,
        world.universe,
        Option::None,
        BasicKind::Float64,
        "float64",
        false,
        true,
    );
    let _ = add_basic(
        world,
        world.universe,
        Option::None,
        BasicKind::Complex64,
        "complex64",
        false,
        true,
    );
    let _ = add_basic(
        world,
        world.universe,
        Option::None,
        BasicKind::Complex128,
        "complex128",
        false,
        true,
    );
    let string_type = add_basic(
        world,
        world.universe,
        Option::None,
        BasicKind::String,
        "string",
        false,
        true,
    );
    let byte_type = add_type(
        world,
        TypeKind::Basic { basic: BasicKind::Uint8, name: "byte", untyped: false },
    );
    world.basics.push(BasicTypeEntry { name: "byte", type_id: byte_type });
    let _ = add_type_name(world, world.universe, Option::None, "byte", byte_type);
    let rune_type = add_type(
        world,
        TypeKind::Basic { basic: BasicKind::Int32, name: "rune", untyped: false },
    );
    world.basics.push(BasicTypeEntry { name: "rune", type_id: rune_type });
    let _ = add_type_name(world, world.universe, Option::None, "rune", rune_type);
    let untyped_bool = add_basic(
        world,
        world.universe,
        Option::None,
        BasicKind::UntypedBool,
        "untyped bool",
        true,
        false,
    );
    let untyped_int = add_basic(
        world,
        world.universe,
        Option::None,
        BasicKind::UntypedInt,
        "untyped int",
        true,
        false,
    );
    let _ = add_basic(
        world,
        world.universe,
        Option::None,
        BasicKind::UntypedRune,
        "untyped rune",
        true,
        false,
    );
    let _ = add_basic(
        world,
        world.universe,
        Option::None,
        BasicKind::UntypedFloat,
        "untyped float",
        true,
        false,
    );
    let _ = add_basic(
        world,
        world.universe,
        Option::None,
        BasicKind::UntypedComplex,
        "untyped complex",
        true,
        false,
    );
    let _ = add_basic(
        world,
        world.universe,
        Option::None,
        BasicKind::UntypedString,
        "untyped string",
        true,
        false,
    );
    let untyped_nil = add_basic(
        world,
        world.universe,
        Option::None,
        BasicKind::UntypedNil,
        "untyped nil",
        true,
        false,
    );
    add_any_type(world);
    add_error_type(world, string_type);
    add_comparable_type(world);
    add_constant(world, "true", "Bool", "true", untyped_bool);
    add_constant(world, "false", "Bool", "false", untyped_bool);
    add_constant(world, "iota", "Int", "0", untyped_int);
    let nil_object = add_object(
        world,
        ObjectKind::Nil,
        "nil",
        Option::None,
        Option::None,
        Option::None,
        -1,
        untyped_nil,
    );
    let _ = insert(world, world.universe, "nil", nil_object);
    for name in Vec::from_array(
        [
            "append",
            "cap",
            "clear",
            "close",
            "complex",
            "copy",
            "delete",
            "imag",
            "len",
            "make",
            "max",
            "min",
            "new",
            "panic",
            "print",
            "println",
            "real",
            "recover",
        ],
    ) {
        add_builtin(world, world.universe, Option::None, name)
    }
    let _ = add_basic(
        world,
        unsafe_scope,
        Option::Some(world.unsafe_package),
        BasicKind::UnsafePointer,
        "Pointer",
        false,
        true,
    );
    for name in Vec::from_array(
        ["Add", "Alignof", "Offsetof", "Sizeof", "Slice", "SliceData", "String", "StringData"],
    ) {
        add_builtin(world, unsafe_scope, Option::Some(world.unsafe_package), name)
    }
    let _ = bool_type;
    let _ = int32_type;
    let _ = uint8_type;
    world
}
