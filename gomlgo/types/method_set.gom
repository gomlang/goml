package types;

pub struct Selection {
    pub object: ObjectId,
    pub index: Vec[isize],
    pub indirect: bool,
}

pub enum FieldOrMethodLookup {
    Found(Selection),
    Ambiguous,
    Missing,
}

struct SearchNode {
    type_id: TypeId,
    index: Vec[isize],
    indirect: bool,
}

fn append_index(values: Vec[isize], value: isize) -> Vec[isize] {
    let result: Vec[isize] = Vec::new();
    for existing in values {
        result.push(existing)
    }
    result.push(value);
    result
}

fn type_seen(values: Vec[TypeId], value: TypeId) -> bool {
    for existing in values {
        if existing.value == value.value {
            return true
        }
    }
    false
}

fn object_seen(values: Vec[ObjectId], value: ObjectId) -> bool {
    for existing in values {
        if existing.value == value.value {
            return true
        }
    }
    false
}

fn valid_object_id(world: World, value: ObjectId) -> bool {
    value.value >= 0 && value.value < world.objects.len()
}

fn pointer_indirection_forbidden(world: World, value: TypeId) -> bool {
    match type_data(world, unalias(world, value)).kind {
        TypeKind::Pointer { element } => is_type_parameter(world, element)
            || is_interface(world, element),
        _ => false,
    }
}

fn name_seen(world: World, values: Vec[ObjectId], name: string, owner: Option[PackageId]) -> bool {
    for object_id in values {
        if valid_object_id(world, object_id) {
            let object = world.objects[object_id.value];
            if method_name_identical(object.name, object.owner, name, owner) {
                return true
            }
        }
    }
    false
}

pub fn method_name_identical(
    left_name: string,
    left_owner: Option[PackageId],
    right_name: string,
    right_owner: Option[PackageId],
) -> bool {
    left_name == right_name && (is_exported(left_name) || same_package(left_owner, right_owner))
}

fn interface_methods_inner(world: World, value: TypeId, visited: Vec[TypeId], result: Vec[ObjectId]) -> () {
    let resolved = underlying(world, value);
    if type_seen(visited, resolved) {
        return
    }
    visited.push(resolved);
    match type_data(world, resolved).kind {
        TypeKind::Interface { methods, embeddeds, comparable: _, implicit: _ } => {
            for method in methods {
                if valid_object_id(world, method) {
                    let object = world.objects[method.value];
                    if !name_seen(world, result, object.name, object.owner) {
                        result.push(method)
                    }
                }
            }
            for embedded in embeddeds {
                interface_methods_inner(world, embedded, visited, result)
            }
        },
        _ => {},
    }
}

fn interface_method_order_key(world: World, value: ObjectId) -> string {
    if valid_object_id(world, value) {
        let object = world.objects[value.value];
        if is_exported(object.name) {
            object.name
        } else {
            match object.owner {
                Some(owner) => match get_package(world, owner) {
                    Some(pkg) => pkg.path + "." + object.name,
                    None => object.name,
                },
                None => object.name,
            }
        }
    } else {
        ""
    }
}

pub fn interface_methods(world: World, value: TypeId) -> Vec[ObjectId] {
    let result: Vec[ObjectId] = Vec::new();
    interface_methods_inner(world, value, Vec::new(), result);
    for index in 1..result.len() {
        let mut current = index;
        while current > 0
            && interface_method_order_key(world, result[current])
                < interface_method_order_key(world, result[current - 1]) {
            let previous = result[current - 1];
            result[current - 1] = result[current];
            result[current] = previous;
            current -= 1;
        }
    }
    result
}

pub fn is_interface(world: World, value: TypeId) -> bool {
    match type_data(world, underlying(world, value)).kind {
        TypeKind::Interface { methods: _, embeddeds: _, comparable: _, implicit: _ } => true,
        _ => false,
    }
}

fn receiver_is_pointer(world: World, method: ObjectId) -> bool {
    if valid_object_id(world, method) {
        let object = world.objects[method.value];
        match type_data(world, unalias(world, object.type_id)).kind {
            TypeKind::Signature {
                receiver,
                receiver_type_params: _,
                type_params: _,
                params: _,
                results: _,
                variadic: _,
            } => match receiver {
                Some(receiver) => match type_data(world, unalias(world, receiver.type_id)).kind {
                    TypeKind::Pointer { element: _ } => true,
                    _ => false,
                },
                None => false,
            },
            _ => false,
        }
    } else {
        false
    }
}

fn add_method_candidate(
    world: World,
    result: Vec[Selection],
    method: ObjectId,
    method_index: isize,
    path: Vec[isize],
    indirect: bool,
    allow_pointer: bool,
    name: string,
) -> () {
    if valid_object_id(world, method) {
        let object = world.objects[method.value];
        if object.name == name && (allow_pointer || !receiver_is_pointer(world, method)) {
            result.push(
                Selection { object: method, index: append_index(path, method_index), indirect },
            )
        }
    }
}

fn dereference(world: World, value: TypeId) -> (TypeId, bool) {
    match type_data(world, unalias(world, value)).kind {
        TypeKind::Pointer { element } => (unalias(world, element), true),
        _ => (unalias(world, value), false),
    }
}

fn search_node(
    world: World,
    node: SearchNode,
    addressable: bool,
    name: string,
    matches: Vec[Selection],
    next: Vec[SearchNode],
) -> () {
    let dereferenced = dereference(world, node.type_id);
    let value = dereferenced.0;
    let indirect = node.indirect || dereferenced.1;
    ensure_named_instance_methods(world, value);
    match type_data(world, value).kind {
        TypeKind::Named {
            object: _,
            underlying: named_underlying,
            type_params: _,
            type_args: _,
            methods,
        } => {
            for method_index in 0..methods.len() {
                add_method_candidate(
                    world,
                    matches,
                    methods[method_index],
                    method_index,
                    node.index,
                    indirect,
                    indirect || addressable,
                    name,
                )
            }
            search_underlying(
                world,
                named_underlying,
                node.index,
                indirect,
                addressable,
                name,
                matches,
                next,
            )
        },
        TypeKind::Interface { methods: _, embeddeds: _, comparable: _, implicit: _ } => {
            let methods = interface_methods(world, value);
            for method_index in 0..methods.len() {
                add_method_candidate(
                    world,
                    matches,
                    methods[method_index],
                    method_index,
                    node.index,
                    indirect,
                    true,
                    name,
                )
            }
        },
        TypeKind::TypeParam { object: _, constraint, index: _ } => {
            let methods = interface_methods(world, constraint);
            for method_index in 0..methods.len() {
                add_method_candidate(
                    world,
                    matches,
                    methods[method_index],
                    method_index,
                    node.index,
                    indirect,
                    true,
                    name,
                )
            }
        },
        _ => search_underlying(world, value, node.index, indirect, addressable, name, matches, next),
    }
}

fn search_underlying(
    world: World,
    value: TypeId,
    path: Vec[isize],
    indirect: bool,
    addressable: bool,
    name: string,
    matches: Vec[Selection],
    next: Vec[SearchNode],
) -> () {
    let _ = addressable;
    match type_data(world, underlying(world, value)).kind {
        TypeKind::Pointer { element } => search_underlying(
            world,
            element,
            path,
            true,
            addressable,
            name,
            matches,
            next,
        ),
        TypeKind::Struct { fields } => {
            for field_index in 0..fields.len() {
                let field = fields[field_index];
                let field_path = append_index(path, field_index);
                if field.variable.name == name {
                    match field.object {
                        Some(object) => matches.push(
                            Selection { object, index: field_path, indirect },
                        ),
                        None => {},
                    }
                }
                if field.embedded {
                    next.push(
                        SearchNode { type_id: field.variable.type_id, index: field_path, indirect },
                    )
                }
            }
        },
        TypeKind::Interface { methods: _, embeddeds: _, comparable: _, implicit: _ } => {
            let methods = interface_methods(world, value);
            for method_index in 0..methods.len() {
                add_method_candidate(
                    world,
                    matches,
                    methods[method_index],
                    method_index,
                    path,
                    indirect,
                    true,
                    name,
                )
            }
        },
        _ => {},
    }
}

pub fn lookup_field_or_method_detailed(world: World, value: TypeId, addressable: bool, name: string) -> FieldOrMethodLookup {
    if pointer_indirection_forbidden(world, value) {
        return FieldOrMethodLookup::Missing
    }
    let mut current: Vec[SearchNode] = Vec::from_array(
        [SearchNode { type_id: value, index: Vec::new(), indirect: false }],
    );
    let visited: Vec[TypeId] = Vec::new();
    while !current.is_empty() {
        let matches: Vec[Selection] = Vec::new();
        let next: Vec[SearchNode] = Vec::new();
        for node in current {
            let key = dereference(world, node.type_id).0;
            if !type_seen(visited, key) {
                search_node(world, node, addressable, name, matches, next)
            }
        }
        if matches.len() == 1 {
            return FieldOrMethodLookup::Found(matches[0])
        } else if matches.len() > 1 {
            return FieldOrMethodLookup::Ambiguous
        }
        for node in current {
            let key = dereference(world, node.type_id).0;
            if !type_seen(visited, key) {
                visited.push(key)
            }
        }
        current = next;
    }
    FieldOrMethodLookup::Missing
}

pub fn lookup_field_or_method(world: World, value: TypeId, addressable: bool, name: string) -> Option[
    Selection,
] {
    match lookup_field_or_method_detailed(world, value, addressable, name) {
        FieldOrMethodLookup::Found(selection) => Option::Some(selection),
        FieldOrMethodLookup::Ambiguous | FieldOrMethodLookup::Missing => Option::None,
    }
}

fn collect_method_names_inner(
    world: World,
    value: TypeId,
    visited: Vec[TypeId],
    result: Vec[ObjectId],
) -> () {
    if pointer_indirection_forbidden(world, value) {
        return
    }
    let dereferenced = dereference(world, value).0;
    if type_seen(visited, dereferenced) {
        return
    }
    visited.push(dereferenced);
    ensure_named_instance_methods(world, dereferenced);
    match type_data(world, dereferenced).kind {
        TypeKind::Named {
            object: _,
            underlying: named_underlying,
            type_params: _,
            type_args: _,
            methods,
        } => {
            for method in methods {
                if !object_seen(result, method) {
                    result.push(method)
                }
            }
            collect_method_names_inner(world, named_underlying, visited, result)
        },
        TypeKind::Struct { fields } => for field in fields {
            if field.embedded {
                collect_method_names_inner(world, field.variable.type_id, visited, result)
            }
        },
        TypeKind::Interface { methods: _, embeddeds: _, comparable: _, implicit: _ } => for method in interface_methods(
            world,
            dereferenced,
        ) {
            if !object_seen(result, method) {
                result.push(method)
            }
        },
        TypeKind::TypeParam { object: _, constraint, index: _ } => for method in interface_methods(
            world,
            constraint,
        ) {
            if !object_seen(result, method) {
                result.push(method)
            }
        },
        _ => {},
    }
}

pub fn method_set(world: World, value: TypeId) -> Vec[Selection] {
    let names: Vec[ObjectId] = Vec::new();
    collect_method_names_inner(world, value, Vec::new(), names);
    let result: Vec[Selection] = Vec::new();
    for name_object in names {
        if valid_object_id(world, name_object) {
            let object = world.objects[name_object.value];
            match lookup_field_or_method(world, value, false, object.name) {
                Some(selection) => if !object_seen_selection(result, selection.object) {
                    result.push(selection)
                },
                None => {},
            }
        }
    }
    result
}

fn object_seen_selection(values: Vec[Selection], value: ObjectId) -> bool {
    for selection in values {
        if selection.object.value == value.value {
            return true
        }
    }
    false
}

fn method_objects_identical(world: World, left: ObjectId, right: ObjectId) -> bool {
    if valid_object_id(world, left) && valid_object_id(world, right) {
        let left = world.objects[left.value];
        let right = world.objects[right.value];
        left.kind == ObjectKind::Func && right.kind == ObjectKind::Func
            && method_name_identical(left.name, left.owner, right.name, right.owner)
            && identical(world, left.type_id, right.type_id)
    } else {
        false
    }
}

fn interface_comparable_inner(world: World, value: TypeId, visited: Vec[TypeId]) -> bool {
    let resolved = unalias(world, value);
    if type_seen(visited, resolved) {
        return false
    }
    visited.push(resolved);
    match type_data(world, resolved).kind {
        TypeKind::TypeParam { object: _, constraint, index: _ } => return interface_comparable_inner(
            world,
            constraint,
            visited,
        ),
        _ => {},
    }
    match type_data(world, underlying(world, value)).kind {
        TypeKind::Interface { methods: _, embeddeds, comparable, implicit: _ } => {
            if comparable {
                return true
            }
            for embedded in embeddeds {
                if interface_comparable_inner(world, embedded, visited) {
                    return true
                }
            }
            false
        },
        _ => false,
    }
}

fn interface_comparable(world: World, value: TypeId) -> bool {
    interface_comparable_inner(world, value, Vec::new())
}

pub fn interface_requires_comparable(world: World, value: TypeId) -> bool {
    interface_comparable(world, value)
}

fn constraint_interface_inner(world: World, value: TypeId, visited: Vec[TypeId]) -> bool {
    let resolved = underlying(world, value);
    if type_seen(visited, resolved) {
        return false
    }
    visited.push(resolved);
    match type_data(world, resolved).kind {
        TypeKind::Interface { methods: _, embeddeds, comparable, implicit: _ } => {
            if comparable {
                return true
            }
            for embedded in embeddeds {
                match type_data(world, underlying(world, embedded)).kind {
                    TypeKind::Interface { methods: _, embeddeds: _, comparable: _, implicit: _ } => if constraint_interface_inner(
                        world,
                        embedded,
                        visited,
                    ) {
                        return true
                    },
                    _ => return true,
                }
            }
            false
        },
        _ => false,
    }
}

pub fn is_constraint_interface(world: World, value: TypeId) -> bool {
    is_interface(world, value) && constraint_interface_inner(world, value, Vec::new())
}

pub fn implements(world: World, value: TypeId, interface_type: TypeId) -> bool {
    if !is_interface(world, interface_type) {
        return false
    } else if interface_comparable(world, interface_type) && !comparable(world, value) {
        return false
    }
    for required in interface_methods(world, interface_type) {
        if !valid_object_id(world, required) {
            return false
        }
        let required_object = world.objects[required.value];
        match lookup_field_or_method(world, value, false, required_object.name) {
            Some(actual) => if !method_objects_identical(world, actual.object, required) {
                return false
            },
            None => return false,
        }
    }
    true
}

pub fn assertable_to(world: World, interface_type: TypeId, target: TypeId) -> bool {
    is_interface(world, interface_type)
        && (is_type_parameter(world, target) || is_interface(world, target)
            || implements(world, target, interface_type))
}
