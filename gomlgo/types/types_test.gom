package types;

use gomlgo::syntax;
use std::testing;

fn required_object(world: World, scope: ScopeId, name: string) -> ObjectId {
    testing::expect_some(lookup(world, scope, name), "missing object " + name)
}

fn required_type(world: World, name: string) -> TypeId {
    testing::expect_some(basic_type(world, name), "missing type " + name)
}

#[test]
fn universe_matches_go_126_predeclared_objects() -> () {
    let world = new_world();
    testing::assert_eq(world.scopes[world.universe.value].entries.len(), 44);
    for name in Vec::from_array(
        [
            "any",
            "append",
            "bool",
            "byte",
            "clear",
            "comparable",
            "complex128",
            "error",
            "false",
            "int",
            "iota",
            "max",
            "min",
            "new",
            "nil",
            "recover",
            "rune",
            "string",
            "true",
            "uint64",
            "uintptr",
        ],
    ) {
        let _ = required_object(world, world.universe, name);
    }
    let unsafe_package = testing::expect_some(
        get_package(world, world.unsafe_package),
        "missing unsafe package",
    );
    testing::assert(unsafe_package.complete);
    testing::assert_eq(unsafe_package.path, "unsafe");
    testing::assert_eq(world.scopes[unsafe_package.scope.value].entries.len(), 9);
    for name in Vec::from_array(
        [
            "Add",
            "Alignof",
            "Offsetof",
            "Pointer",
            "Sizeof",
            "Slice",
            "SliceData",
            "String",
            "StringData",
        ],
    ) {
        let _ = required_object(world, unsafe_package.scope, name);
    }
}

#[test]
fn universe_materializes_alias_named_and_basic_types() -> () {
    let world = new_world();
    testing::assert_eq(format_type(world, required_type(world, "byte")), "byte");
    testing::assert_eq(format_type(world, required_type(world, "rune")), "rune");
    let any_object = required_object(world, world.universe, "any");
    match testing::expect_some(
        get_type(world, world.objects[any_object.value].type_id),
        "missing any",
    ).kind {
        TypeKind::Alias { object: _, rhs: _, type_params: _, type_args: _ } => (),
        _ => testing::fail("any is not an alias"),
    }
    let error_object = required_object(world, world.universe, "error");
    let error_type = world.objects[error_object.value].type_id;
    testing::assert_eq(format_type(world, error_type), "error");
    match testing::expect_some(get_type(world, error_type), "missing error type").kind {
        TypeKind::Named { object: _, underlying, type_params: _, type_args: _, methods: _ } => {
            match testing::expect_some(get_type(world, underlying), "missing error interface").kind {
                TypeKind::Interface { methods, embeddeds: _, comparable: _, implicit: _ } => {
                    testing::assert_eq(methods.len(), 1);
                    testing::assert_eq(world.objects[methods[0].value].name, "Error")
                },
                _ => testing::fail("error underlying type is not an interface"),
            }
        },
        _ => testing::fail("error is not a named type"),
    }
}

#[test]
fn scopes_support_shadowing_and_position_sensitive_lookup() -> () {
    let world = new_world();
    let pkg = add_package(world, "example/p", "p", world.universe, false);
    let package_scope = world.packages[pkg.value].scope;
    let file_scope = add_scope(
        world,
        ScopeKind::File,
        Option::Some(package_scope),
        Option::Some(syntax::file_id(0)),
        0,
        100,
    );
    let int_type = required_type(world, "int");
    let outer = add_object(
        world,
        ObjectKind::Var,
        "value",
        Option::Some(pkg),
        Option::Some(syntax::file_id(0)),
        Option::None,
        2,
        int_type,
    );
    testing::assert_none(insert(world, package_scope, "value", outer));
    let inner = add_object(
        world,
        ObjectKind::Var,
        "value",
        Option::Some(pkg),
        Option::Some(syntax::file_id(0)),
        Option::None,
        20,
        int_type,
    );
    testing::assert_none(insert(world, file_scope, "value", inner));
    testing::assert_eq(
        testing::expect_some(lookup_at(world, file_scope, "value", 10), "missing outer").value,
        outer.value,
    );
    testing::assert_eq(
        testing::expect_some(lookup_at(world, file_scope, "value", 30), "missing inner").value,
        inner.value,
    );
    let duplicate = add_object(
        world,
        ObjectKind::Var,
        "value",
        Option::Some(pkg),
        Option::Some(syntax::file_id(0)),
        Option::None,
        40,
        int_type,
    );
    testing::assert_eq(
        testing::expect_some(insert(world, file_scope, "value", duplicate), "missing duplicate").value,
        inner.value,
    )
}

#[test]
fn scope_depths_follow_parent_changes() -> () {
    let world = new_world();
    let outer = add_scope(
        world,
        ScopeKind::Block,
        Option::Some(world.universe),
        Option::None,
        0,
        100,
    );
    let inner = add_scope(world, ScopeKind::Block, Option::Some(outer), Option::None, 10, 90);
    let function = add_scope(world, ScopeKind::Function, Option::Some(inner), Option::None, 20, 80);
    let body = add_scope(world, ScopeKind::Block, Option::Some(function), Option::None, 30, 70);
    testing::assert_eq(world.scopes[world.universe.value].depth, 1);
    testing::assert_eq(world.scopes[function.value].depth, 4);
    testing::assert_eq(world.scopes[body.value].depth, 5);
    testing::assert(set_scope_parent(world, function, world.universe));
    testing::assert_eq(world.scopes[function.value].depth, 2);
    testing::assert_eq(world.scopes[body.value].depth, 3);
    testing::assert_eq(world.scopes[inner.value].children.len(), 0);
    testing::assert(!set_scope_parent(world, scope_id(-1), world.universe))
}

#[test]
fn recursive_named_types_use_ids_and_format_stably() -> () {
    let world = new_world();
    let pkg = add_package(world, "example/p", "p", world.universe, false);
    let object = add_object(
        world,
        ObjectKind::TypeName,
        "Node",
        Option::Some(pkg),
        Option::None,
        Option::None,
        0,
        world.invalid,
    );
    let named = add_type(
        world,
        TypeKind::Named {
            object,
            underlying: world.invalid,
            type_params: Vec::new(),
            type_args: Vec::new(),
            methods: Vec::new(),
        },
    );
    let _ = set_object_type(world, object, named);
    let pointer = add_type(world, TypeKind::Pointer { element: named });
    let underlying = add_type(
        world,
        TypeKind::Struct {
            fields: Vec::from_array(
                [
                    StructField {
                        object: Option::None,
                        variable: Variable {
                            name: "Next",
                            owner: Option::Some(pkg),
                            type_id: pointer,
                        },
                        embedded: false,
                        tag: "",
                    },
                ],
            ),
        },
    );
    testing::assert(
        set_type(
            world,
            named,
            TypeKind::Named {
                object,
                underlying,
                type_params: Vec::new(),
                type_args: Vec::new(),
                methods: Vec::new(),
            },
        ),
    );
    testing::assert_eq(format_type(world, named), "example/p.Node");
    testing::assert_eq(format_type(world, pointer), "*example/p.Node")
}

#[test]
fn type_revision_tracks_graph_mutations() -> () {
    let world = empty_world();
    let initial = type_revision(world);
    let placeholder = add_type(world, TypeKind::Pointer { element: world.invalid });
    testing::assert_eq(type_revision(world), initial);
    testing::assert(set_type(world, placeholder, TypeKind::Slice { element: world.invalid }));
    let type_changed = type_revision(world);
    testing::assert_eq(type_changed, initial + 1);
    testing::assert(!set_type(world, type_id(-1), TypeKind::Invalid));
    testing::assert_eq(type_revision(world), type_changed);
    let object = add_object(
        world,
        ObjectKind::Var,
        "value",
        Option::None,
        Option::None,
        Option::None,
        -1,
        world.invalid,
    );
    testing::assert_eq(type_revision(world), type_changed);
    testing::assert(set_object_type(world, object, placeholder));
    let object_changed = type_revision(world);
    testing::assert_eq(object_changed, type_changed + 1);
    testing::assert(set_object_type(world, object, placeholder));
    testing::assert_eq(type_revision(world), object_changed);
    testing::assert(!set_object_type(world, object_id(-1), world.invalid));
    testing::assert_eq(type_revision(world), object_changed)
}

#[test]
fn exported_names_and_gc_sizes_match_target_rules() -> () {
    testing::assert(is_exported("Exported"));
    testing::assert(is_exported("Éclair"));
    testing::assert(!is_exported("private"));
    testing::assert(!is_exported(""));
    let amd64 = testing::expect_some(gc_sizes("amd64"), "missing amd64 sizes");
    testing::assert_eq(amd64.word_size, 8.to_i64());
    testing::assert_eq(amd64.max_align, 8.to_i64());
    let wasm = testing::expect_some(gc_sizes("wasm"), "missing wasm sizes");
    testing::assert_eq(wasm.word_size, 8.to_i64());
    testing::assert_none(gc_sizes("unknown"))
}

#[test]
fn gc_sizes_compute_composite_alignment_offsets_and_trailing_padding() -> () {
    let world = new_world();
    let sizes = testing::expect_some(gc_sizes("amd64"), "missing amd64 sizes");
    let int8_type = testing::expect_some(basic_type(world, "int8"), "missing int8");
    let int64_type = testing::expect_some(basic_type(world, "int64"), "missing int64");
    let empty = add_type(world, TypeKind::Struct { fields: Vec::new() });
    let fields = Vec::from_array(
        [
            StructField {
                object: Option::None,
                variable: Variable { name: "a", owner: Option::None, type_id: int8_type },
                embedded: false,
                tag: "",
            },
            StructField {
                object: Option::None,
                variable: Variable { name: "b", owner: Option::None, type_id: int64_type },
                embedded: false,
                tag: "",
            },
            StructField {
                object: Option::None,
                variable: Variable { name: "c", owner: Option::None, type_id: empty },
                embedded: false,
                tag: "",
            },
        ],
    );
    let structure = add_type(world, TypeKind::Struct { fields });
    let offsets = offsets_of(world, fields, sizes);
    testing::assert_eq(offsets.len(), 3);
    testing::assert_eq(offsets[0], 0.to_i64());
    testing::assert_eq(offsets[1], 8.to_i64());
    testing::assert_eq(offsets[2], 16.to_i64());
    testing::assert_eq(alignof(world, structure, sizes), 8.to_i64());
    testing::assert_eq(sizeof(world, structure, sizes), 24.to_i64());
    let array = add_type(world, TypeKind::Array { length: 2, element: structure });
    testing::assert_eq(sizeof(world, array, sizes), 48.to_i64())
}

fn named_test_type(world: World, pkg: PackageId, name: string, rhs: TypeId) -> TypeId {
    let object = add_object(
        world,
        ObjectKind::TypeName,
        name,
        Option::Some(pkg),
        Option::None,
        Option::None,
        -1,
        world.invalid,
    );
    let result = add_type(
        world,
        TypeKind::Named {
            object,
            underlying: rhs,
            type_params: Vec::new(),
            type_args: Vec::new(),
            methods: Vec::new(),
        },
    );
    let _ = set_object_type(world, object, result);
    result
}

#[test]
fn type_identity_distinguishes_named_types_and_unaliases() -> () {
    let world = new_world();
    let pkg = add_package(world, "example/p", "p", world.universe, true);
    let int_type = required_type(world, "int");
    let first = named_test_type(world, pkg, "First", int_type);
    let second = named_test_type(world, pkg, "Second", int_type);
    testing::assert(identical(world, first, first));
    testing::assert(!identical(world, first, second));
    testing::assert_eq(underlying(world, first).value, int_type.value);
    let alias_object = add_object(
        world,
        ObjectKind::TypeName,
        "Alias",
        Option::Some(pkg),
        Option::None,
        Option::None,
        -1,
        world.invalid,
    );
    let alias = add_type(
        world,
        TypeKind::Alias {
            object: alias_object,
            rhs: first,
            type_params: Vec::new(),
            type_args: Vec::new(),
        },
    );
    testing::assert(identical(world, alias, first));
    testing::assert_eq(unalias(world, alias).value, first.value)
}

#[test]
fn type_resolution_rejects_alias_and_named_cycles() -> () {
    let world = new_world();
    let first_alias = add_type(
        world,
        TypeKind::Alias {
            object: object_id(-1),
            rhs: world.invalid,
            type_params: Vec::new(),
            type_args: Vec::new(),
        },
    );
    let second_alias = add_type(
        world,
        TypeKind::Alias {
            object: object_id(-1),
            rhs: first_alias,
            type_params: Vec::new(),
            type_args: Vec::new(),
        },
    );
    testing::assert(
        set_type(
            world,
            first_alias,
            TypeKind::Alias {
                object: object_id(-1),
                rhs: second_alias,
                type_params: Vec::new(),
                type_args: Vec::new(),
            },
        ),
    );
    testing::assert_eq(unalias(world, first_alias).value, world.invalid.value);
    let first_named = add_type(
        world,
        TypeKind::Named {
            object: object_id(-1),
            underlying: world.invalid,
            type_params: Vec::new(),
            type_args: Vec::new(),
            methods: Vec::new(),
        },
    );
    let second_named = add_type(
        world,
        TypeKind::Named {
            object: object_id(-1),
            underlying: first_named,
            type_params: Vec::new(),
            type_args: Vec::new(),
            methods: Vec::new(),
        },
    );
    testing::assert(
        set_type(
            world,
            first_named,
            TypeKind::Named {
                object: object_id(-1),
                underlying: second_named,
                type_params: Vec::new(),
                type_args: Vec::new(),
                methods: Vec::new(),
            },
        ),
    );
    testing::assert_eq(underlying(world, first_named).value, world.invalid.value);
    testing::assert(
        set_type(
            world,
            first_alias,
            TypeKind::Alias {
                object: object_id(-1),
                rhs: first_named,
                type_params: Vec::new(),
                type_args: Vec::new(),
            },
        ),
    );
    testing::assert(
        set_type(
            world,
            first_named,
            TypeKind::Named {
                object: object_id(-1),
                underlying: first_alias,
                type_params: Vec::new(),
                type_args: Vec::new(),
                methods: Vec::new(),
            },
        ),
    );
    testing::assert_eq(underlying(world, first_alias).value, world.invalid.value);
    testing::assert_eq(underlying(world, first_named).value, world.invalid.value)
}

#[test]
fn structural_identity_handles_recursive_composite_types() -> () {
    let world = new_world();
    let int_type = required_type(world, "int");
    let left = add_type(world, TypeKind::Slice { element: int_type });
    let right = add_type(world, TypeKind::Slice { element: int_type });
    testing::assert(identical(world, left, right));
    let left_array = add_type(world, TypeKind::Array { length: 2, element: left });
    let right_array = add_type(world, TypeKind::Array { length: 2, element: right });
    testing::assert(identical(world, left_array, right_array));
    let different = add_type(world, TypeKind::Array { length: 3, element: right });
    testing::assert(!identical(world, left_array, different))
}

#[test]
fn comparability_follows_go_composite_rules() -> () {
    let world = new_world();
    let int_type = required_type(world, "int");
    let string_type = required_type(world, "string");
    let slice = add_type(world, TypeKind::Slice { element: int_type });
    let array = add_type(world, TypeKind::Array { length: 2, element: int_type });
    let comparable_struct = add_type(
        world,
        TypeKind::Struct {
            fields: Vec::from_array(
                [
                    StructField {
                        object: Option::None,
                        variable: Variable { name: "A", owner: Option::None, type_id: int_type },
                        embedded: false,
                        tag: "",
                    },
                    StructField {
                        object: Option::None,
                        variable: Variable { name: "B", owner: Option::None, type_id: string_type },
                        embedded: false,
                        tag: "",
                    },
                ],
            ),
        },
    );
    let non_comparable_struct = add_type(
        world,
        TypeKind::Struct {
            fields: Vec::from_array(
                [
                    StructField {
                        object: Option::None,
                        variable: Variable { name: "A", owner: Option::None, type_id: slice },
                        embedded: false,
                        tag: "",
                    },
                ],
            ),
        },
    );
    testing::assert(comparable(world, int_type));
    testing::assert(comparable(world, array));
    testing::assert(comparable(world, comparable_struct));
    testing::assert(!comparable(world, slice));
    testing::assert(!comparable(world, non_comparable_struct))
}

#[test]
fn assignability_handles_underlying_and_channel_rules() -> () {
    let world = new_world();
    let pkg = add_package(world, "example/p", "p", world.universe, true);
    let int_type = required_type(world, "int");
    let named = named_test_type(world, pkg, "Number", int_type);
    testing::assert(!assignable_types(world, int_type, named));
    testing::assert(!assignable_types(world, named, int_type));
    let other = named_test_type(world, pkg, "Other", int_type);
    testing::assert(!assignable_types(world, named, other));
    let bidirectional = add_type(world, TypeKind::Chan { direction: 3, element: int_type });
    let receive_only = add_type(world, TypeKind::Chan { direction: 2, element: int_type });
    testing::assert(assignable_types(world, bidirectional, receive_only));
    testing::assert(!assignable_types(world, receive_only, bidirectional));
    let nil_type = required_type(world, "untyped nil");
    let pointer = add_type(world, TypeKind::Pointer { element: int_type });
    testing::assert(assignable_types(world, nil_type, pointer))
}

fn test_named_type(world: World, package_id: PackageId, name: string, underlying: TypeId) -> TypeId {
    let object = add_object(
        world,
        ObjectKind::TypeName,
        name,
        Option::Some(package_id),
        Option::None,
        Option::None,
        -1,
        world.invalid,
    );
    let result = add_type(
        world,
        TypeKind::Named {
            object,
            underlying,
            type_params: Vec::new(),
            type_args: Vec::new(),
            methods: Vec::new(),
        },
    );
    let _ = set_object_type(world, object, result);
    result
}

fn test_method(
    world: World,
    package_id: PackageId,
    name: string,
    receiver_type: TypeId,
    result_type: TypeId,
) -> ObjectId {
    let params = add_type(world, TypeKind::Tuple { variables: Vec::new() });
    let results = add_type(
        world,
        TypeKind::Tuple {
            variables: Vec::from_array(
                [Variable { name: "", owner: Option::None, type_id: result_type }],
            ),
        },
    );
    let signature = add_type(
        world,
        TypeKind::Signature {
            receiver: Option::Some(
                Variable { name: "", owner: Option::Some(package_id), type_id: receiver_type },
            ),
            receiver_type_params: Vec::new(),
            type_params: Vec::new(),
            params,
            results,
            variadic: false,
        },
    );
    add_object(
        world,
        ObjectKind::Func,
        name,
        Option::Some(package_id),
        Option::None,
        Option::None,
        -1,
        signature,
    )
}

fn set_named_methods(world: World, value: TypeId, methods: Vec[ObjectId]) -> () {
    match world.types[value.value].kind {
        TypeKind::Named { object, underlying, type_params, type_args, methods: _ } => {
            let _ = set_type(
                world,
                value,
                TypeKind::Named { object, underlying, type_params, type_args, methods },
            );
        },
        _ => testing::fail("expected named type"),
    }
}

fn test_interface_method(world: World, package_id: PackageId, name: string, result_type: TypeId) -> ObjectId {
    let params = add_type(world, TypeKind::Tuple { variables: Vec::new() });
    let results = add_type(
        world,
        TypeKind::Tuple {
            variables: Vec::from_array(
                [Variable { name: "", owner: Option::None, type_id: result_type }],
            ),
        },
    );
    let signature = add_type(
        world,
        TypeKind::Signature {
            receiver: Option::None,
            receiver_type_params: Vec::new(),
            type_params: Vec::new(),
            params,
            results,
            variadic: false,
        },
    );
    add_object(
        world,
        ObjectKind::Func,
        name,
        Option::Some(package_id),
        Option::None,
        Option::None,
        -1,
        signature,
    )
}

#[test]
fn method_sets_distinguish_value_pointer_and_promoted_methods() -> () {
    let world = new_world();
    let package_id = add_package(world, "example/p", "p", world.universe, false);
    let int_type = required_type(world, "int");
    let empty_struct = add_type(world, TypeKind::Struct { fields: Vec::new() });
    let inner = test_named_type(world, package_id, "Inner", empty_struct);
    let inner_pointer = add_type(world, TypeKind::Pointer { element: inner });
    let value_method = test_method(world, package_id, "Value", inner, int_type);
    let pointer_method = test_method(world, package_id, "Pointer", inner_pointer, int_type);
    set_named_methods(world, inner, Vec::from_array([value_method, pointer_method]));
    testing::assert_eq(method_set(world, inner).len(), 1);
    testing::assert_eq(method_set(world, inner_pointer).len(), 2);
    let field_object = add_object(
        world,
        ObjectKind::Var,
        "Inner",
        Option::Some(package_id),
        Option::None,
        Option::None,
        -1,
        inner,
    );
    let outer_struct = add_type(
        world,
        TypeKind::Struct {
            fields: Vec::from_array(
                [
                    StructField {
                        object: Option::Some(field_object),
                        variable: Variable {
                            name: "Inner",
                            owner: Option::Some(package_id),
                            type_id: inner,
                        },
                        embedded: true,
                        tag: "",
                    },
                ],
            ),
        },
    );
    let outer = test_named_type(world, package_id, "Outer", outer_struct);
    let outer_pointer = add_type(world, TypeKind::Pointer { element: outer });
    let promoted = testing::expect_some(
        lookup_field_or_method(world, outer, false, "Value"),
        "missing promoted value method",
    );
    testing::assert_eq(promoted.index.len(), 2);
    testing::assert(lookup_field_or_method(world, outer, false, "Pointer").is_none());
    testing::assert(lookup_field_or_method(world, outer_pointer, false, "Pointer").is_some())
}

#[test]
fn interface_implementation_uses_completed_embedded_method_sets() -> () {
    let world = new_world();
    let package_id = add_package(world, "example/p", "p", world.universe, false);
    let int_type = required_type(world, "int");
    let empty_struct = add_type(world, TypeKind::Struct { fields: Vec::new() });
    let concrete = test_named_type(world, package_id, "Concrete", empty_struct);
    let concrete_pointer = add_type(world, TypeKind::Pointer { element: concrete });
    let read = test_method(world, package_id, "Read", concrete, int_type);
    let write = test_method(world, package_id, "Write", concrete_pointer, int_type);
    set_named_methods(world, concrete, Vec::from_array([read, write]));
    let read_requirement = test_interface_method(world, package_id, "Read", int_type);
    let write_requirement = test_interface_method(world, package_id, "Write", int_type);
    let reader = add_type(
        world,
        TypeKind::Interface {
            methods: Vec::from_array([read_requirement]),
            embeddeds: Vec::new(),
            comparable: false,
            implicit: false,
        },
    );
    let read_writer = add_type(
        world,
        TypeKind::Interface {
            methods: Vec::from_array([write_requirement]),
            embeddeds: Vec::from_array([reader]),
            comparable: false,
            implicit: false,
        },
    );
    testing::assert(implements(world, concrete, reader));
    testing::assert(!implements(world, concrete, read_writer));
    testing::assert(implements(world, concrete_pointer, read_writer));
    testing::assert(assignable_types(world, concrete, reader));
    testing::assert_eq(interface_methods(world, read_writer).len(), 2);
    let selected = testing::expect_some(
        lookup_field_or_method(world, read_writer, false, "Write"),
        "missing interface method",
    );
    testing::assert_eq(selected.index[0], 1)
}

#[test]
fn named_instance_refresh_handles_new_instances_and_type_revisions() -> () {
    let world = new_world();
    let package_id = add_package(world, "example/p", "p", world.universe, false);
    let int_type = required_type(world, "int");
    let origin = test_named_type(world, package_id, "Number", int_type);
    let incomplete = TypeKind::Named {
        object: object_id(world.named_type_objects[origin.value]),
        underlying: world.invalid,
        type_params: Vec::new(),
        type_args: Vec::from_array([int_type]),
        methods: Vec::new(),
    };
    let first = add_type(world, incomplete);
    refresh_named_instances(world, origin);
    testing::assert_eq(underlying(world, first).value, int_type.value);
    refresh_named_instances(world, origin);
    let second = add_type(world, incomplete);
    refresh_named_instances(world, origin);
    testing::assert_eq(underlying(world, second).value, int_type.value);
    testing::assert(set_type(world, first, incomplete));
    refresh_named_instances(world, origin);
    testing::assert_eq(underlying(world, first).value, int_type.value)
}

#[test]
fn arena_queries_reject_out_of_range_ids() -> () {
    let world = new_world();
    testing::assert(get_type(world, type_id(-1)).is_none());
    testing::assert(get_type(world, type_id(world.types.len())).is_none());
    testing::assert(get_type(world, world.invalid).is_some());
    testing::assert(!has_type(world, type_id(-1)));
    testing::assert(!has_type(world, type_id(world.types.len())));
    testing::assert(has_type(world, world.invalid));
    testing::assert(get_object(world, object_id(-1)).is_none());
    testing::assert(get_object(world, object_id(world.objects.len())).is_none());
    testing::assert(get_object(world, object_id(0)).is_some());
    testing::assert(get_package(world, package_id(-1)).is_none());
    testing::assert(get_package(world, package_id(world.packages.len())).is_none());
    testing::assert(get_package(world, world.unsafe_package).is_some())
}
