package types;

struct TypeTerms {
    all: bool,
    terms: Vec[UnionTerm],
}

fn copy_union_term(value: UnionTerm) -> UnionTerm {
    UnionTerm { tilde: value.tilde, type_id: value.type_id }
}

fn copy_type_terms(value: TypeTerms) -> TypeTerms {
    let terms: Vec[UnionTerm] = Vec::new();
    for term in value.terms {
        terms.push(copy_union_term(term))
    }
    TypeTerms { all: value.all, terms }
}

fn type_in_list(values: Vec[TypeId], value: TypeId) -> bool {
    for existing in values {
        if existing.value == value.value {
            return true
        }
    }
    false
}

pub fn mark_invalid_type_set(world: World, value: TypeId) -> () {
    if !type_in_list(world.invalid_type_sets, value) {
        world.invalid_type_sets.push(value)
    }
}

pub fn type_set_is_invalid(world: World, value: TypeId) -> bool {
    type_set_contains_invalid(world, value, Vec::new())
}

fn copied_type_ids(values: Vec[TypeId]) -> Vec[TypeId] {
    let result: Vec[TypeId] = Vec::new();
    for value in values {
        result.push(value)
    }
    result
}

fn term_intersection(world: World, left: UnionTerm, right: UnionTerm) -> Option[UnionTerm] {
    if left.tilde && right.tilde {
        if identical(world, left.type_id, right.type_id) {
            Option::Some(copy_union_term(left))
        } else {
            Option::None
        }
    } else if left.tilde {
        if identical(world, left.type_id, underlying(world, right.type_id)) {
            Option::Some(copy_union_term(right))
        } else {
            Option::None
        }
    } else if right.tilde {
        if identical(world, underlying(world, left.type_id), right.type_id) {
            Option::Some(copy_union_term(left))
        } else {
            Option::None
        }
    } else if identical(world, left.type_id, right.type_id) {
        Option::Some(copy_union_term(left))
    } else {
        Option::None
    }
}

fn term_equivalent(world: World, left: UnionTerm, right: UnionTerm) -> bool {
    left.tilde == right.tilde && identical(world, left.type_id, right.type_id)
}

fn push_unique_term(world: World, result: Vec[UnionTerm], value: UnionTerm) -> () {
    for existing in result {
        if term_equivalent(world, existing, value) {
            return
        }
    }
    result.push(copy_union_term(value))
}

fn intersect_type_terms(world: World, left: TypeTerms, right: TypeTerms) -> TypeTerms {
    if left.all {
        copy_type_terms(right)
    } else if right.all {
        copy_type_terms(left)
    } else {
        let terms: Vec[UnionTerm] = Vec::new();
        for left_term in left.terms {
            for right_term in right.terms {
                if let Some(value) = term_intersection(world, left_term, right_term) {
                    push_unique_term(world, terms, value)
                }
            }
        }
        TypeTerms { all: false, terms }
    }
}

fn union_type_terms(world: World, left: TypeTerms, right: TypeTerms) -> TypeTerms {
    if left.all || right.all {
        TypeTerms { all: true, terms: Vec::new() }
    } else {
        let terms: Vec[UnionTerm] = Vec::new();
        for term in left.terms {
            push_unique_term(world, terms, term)
        }
        for term in right.terms {
            push_unique_term(world, terms, term)
        }
        TypeTerms { all: false, terms }
    }
}

fn invalid_tilde_type_set(world: World, value: TypeId) -> bool {
    if !type_in_list(world.invalid_type_sets, value) {
        return false
    }
    match get_type(world, value) {
        Some(TypeData { id: _, kind: TypeKind::Union { terms } }) => terms.len() == 1
            && terms[0].tilde,
        _ => false,
    }
}

fn constraint_type_terms(world: World, value: TypeId, visited: Vec[TypeId]) -> TypeTerms {
    let resolved = unalias(world, value);
    if type_in_list(visited, resolved) {
        return TypeTerms { all: true, terms: Vec::new() }
    } else if invalid_tilde_type_set(world, resolved) {
        return TypeTerms { all: false, terms: Vec::new() }
    }
    visited.push(resolved);
    match get_type(world, resolved) {
        Some(TypeData { id: _, kind: TypeKind::TypeParam { object: _, constraint, index: _ } }) => constraint_type_terms(
            world,
            constraint,
            visited,
        ),
        Some(TypeData {
            id: _,
            kind: TypeKind::Named {
                object: _,
                underlying,
                type_params: _,
                type_args: _,
                methods: _,
            },
        }) => if is_interface(world, underlying) {
            constraint_type_terms(world, underlying, visited)
        } else {
            TypeTerms {
                all: false,
                terms: Vec::from_array([UnionTerm { tilde: false, type_id: resolved }]),
            }
        },
        Some(TypeData {
            id: _,
            kind: TypeKind::Interface { methods: _, embeddeds, comparable, implicit: _ },
        }) => {
            let mut result = TypeTerms { all: true, terms: Vec::new() };
            for embedded in embeddeds {
                result = intersect_type_terms(
                    world,
                    result,
                    constraint_type_terms(world, embedded, copied_type_ids(visited)),
                );
            }
            if comparable && !result.all {
                let filtered: Vec[UnionTerm] = Vec::new();
                for term in result.terms {
                    let candidate = if term.tilde {
                        term.type_id
                    } else {
                        term.type_id
                    };
                    if strictly_comparable_type(world, candidate) {
                        filtered.push(copy_union_term(term))
                    }
                }
                result = TypeTerms { all: false, terms: filtered };
            }
            result
        },
        Some(TypeData { id: _, kind: TypeKind::Union { terms } }) => {
            let mut result = TypeTerms { all: false, terms: Vec::new() };
            for term in terms {
                let item = if !term.tilde && is_interface(world, term.type_id) {
                    constraint_type_terms(world, term.type_id, copied_type_ids(visited))
                } else {
                    TypeTerms { all: false, terms: Vec::from_array([copy_union_term(term)]) }
                };
                result = union_type_terms(world, result, item);
            }
            result
        },
        _ => TypeTerms {
            all: false,
            terms: Vec::from_array([UnionTerm { tilde: false, type_id: resolved }]),
        },
    }
}

pub fn type_set_terms(world: World, value: TypeId) -> Vec[UnionTerm] {
    copy_type_terms(constraint_type_terms(world, value, Vec::new())).terms
}

pub fn type_set_is_empty(world: World, value: TypeId) -> bool {
    let result = constraint_type_terms(world, value, Vec::new());
    !result.all && result.terms.is_empty()
}

fn comparable_type_inner(world: World, value: TypeId, visited: Vec[TypeId]) -> bool {
    let resolved = unalias(world, value);
    if type_in_list(visited, resolved) {
        return true
    }
    visited.push(resolved);
    match get_type(world, underlying(world, resolved)) {
        Some(TypeData { id: _, kind: TypeKind::Invalid }) | None => true,
        Some(TypeData {
            id: _,
            kind: TypeKind::Basic { basic: BasicKind::UntypedNil, name: _, untyped: _ },
        }) => false,
        Some(TypeData { id: _, kind: TypeKind::Basic { basic: _, name: _, untyped: _ } }) => true,
        Some(TypeData { id: _, kind: TypeKind::Array { length: _, element } }) => {
            comparable_type_inner(world, element, visited)
        },
        Some(TypeData { id: _, kind: TypeKind::Struct { fields } }) => {
            for field in fields {
                if !comparable_type_inner(world, field.variable.type_id, visited) {
                    return false
                }
            }
            true
        },
        Some(TypeData { id: _, kind: TypeKind::TypeParam { object: _, constraint: _, index: _ } }) => type_set_comparable_inner(
            world,
            resolved,
            visited,
        ),
        Some(TypeData { id: _, kind: TypeKind::Pointer { element: _ } }) | Some(TypeData {
            id: _,
            kind: TypeKind::Chan { direction: _, element: _ },
        }) | Some(TypeData {
            id: _,
            kind: TypeKind::Interface { methods: _, embeddeds: _, comparable: _, implicit: _ },
        }) => true,
        _ => false,
    }
}

fn comparable_type(world: World, value: TypeId) -> bool {
    comparable_type_inner(world, value, Vec::new())
}

fn constraint_reaches_types(world: World, value: TypeId, targets: Vec[TypeId], visited: Vec[TypeId]) -> bool {
    let resolved = unalias(world, value);
    if type_in_list(targets, resolved) {
        return true
    } else if type_in_list(visited, resolved) {
        return false
    }
    visited.push(resolved);
    match get_type(world, resolved) {
        Some(TypeData {
            id: _,
            kind: TypeKind::Named {
                object: _,
                underlying,
                type_params: _,
                type_args: _,
                methods: _,
            },
        }) => constraint_reaches_types(world, underlying, targets, visited),
        Some(TypeData {
            id: _,
            kind: TypeKind::Interface { methods: _, embeddeds, comparable: _, implicit: _ },
        }) => {
            for embedded in embeddeds {
                if constraint_reaches_types(world, embedded, targets, copied_type_ids(visited)) {
                    return true
                }
            }
            false
        },
        Some(TypeData { id: _, kind: TypeKind::Union { terms } }) => {
            for term in terms {
                if constraint_reaches_types(world, term.type_id, targets, copied_type_ids(visited)) {
                    return true
                }
            }
            false
        },
        Some(TypeData { id: _, kind: TypeKind::TypeParam { object: _, constraint, index: _ } }) => constraint_reaches_types(
            world,
            constraint,
            targets,
            visited,
        ),
        _ => false,
    }
}

fn union_terms_comparable(world: World, terms: Vec[UnionTerm], visited: Vec[TypeId]) -> bool {
    let mut found = false;
    for term in terms {
        if is_interface(world, term.type_id) {
            if !type_set_is_invalid(world, term.type_id)
                && !constraint_reaches_types(world, term.type_id, visited, Vec::new()) {
                return false
            }
        } else {
            match get_type(world, unalias(world, term.type_id)) {
                Some(TypeData { id: _, kind: TypeKind::Invalid }) | None => {},
                _ => {
                    found = true;
                    if !comparable_type_inner(world, term.type_id, copied_type_ids(visited)) {
                        return false
                    }
                },
            }
        }
    }
    found
}

fn type_set_contains_invalid(world: World, value: TypeId, visited: Vec[TypeId]) -> bool {
    if type_in_list(world.invalid_type_sets, value) {
        return true
    }
    if type_in_list(visited, value) {
        return false
    }
    visited.push(value);
    match get_type(world, value) {
        Some(TypeData { id: _, kind: TypeKind::Invalid }) => false,
        None => true,
        Some(TypeData {
            id: _,
            kind: TypeKind::Named {
                object: _,
                underlying,
                type_params: _,
                type_args: _,
                methods: _,
            },
        }) => type_set_contains_invalid(world, underlying, visited),
        Some(TypeData {
            id: _,
            kind: TypeKind::Alias { object: _, rhs, type_params: _, type_args: _ },
        }) => type_set_contains_invalid(world, rhs, visited),
        Some(TypeData {
            id: _,
            kind: TypeKind::Array { length: _, element } | TypeKind::Slice { element } | TypeKind::Pointer {
                element,
            } | TypeKind::Chan { direction: _, element },
        }) => type_set_contains_invalid(world, element, visited),
        Some(TypeData { id: _, kind: TypeKind::Map { key, value } }) => type_set_contains_invalid(
            world,
            key,
            copied_type_ids(visited),
        )
            || type_set_contains_invalid(world, value, visited),
        Some(TypeData { id: _, kind: TypeKind::Struct { fields } }) => {
            for field in fields {
                if type_set_contains_invalid(
                    world,
                    field.variable.type_id,
                    copied_type_ids(visited),
                ) {
                    return true
                }
            }
            false
        },
        Some(TypeData { id: _, kind: TypeKind::Tuple { variables } }) => {
            for variable in variables {
                if type_set_contains_invalid(world, variable.type_id, copied_type_ids(visited)) {
                    return true
                }
            }
            false
        },
        Some(TypeData {
            id: _,
            kind: TypeKind::Signature {
                receiver: _,
                receiver_type_params: _,
                type_params: _,
                params,
                results,
                variadic: _,
            },
        }) => type_set_contains_invalid(world, params, copied_type_ids(visited))
            || type_set_contains_invalid(world, results, visited),
        Some(TypeData {
            id: _,
            kind: TypeKind::Interface { methods, embeddeds, comparable: _, implicit: _ },
        }) => {
            for method in methods {
                match get_object(world, method) {
                    Some(object) => if type_set_contains_invalid(
                        world,
                        object.type_id,
                        copied_type_ids(visited),
                    ) {
                        return true
                    },
                    None => return true,
                }
            }
            for embedded in embeddeds {
                if type_set_contains_invalid(world, embedded, copied_type_ids(visited)) {
                    return true
                }
            }
            false
        },
        Some(TypeData { id: _, kind: TypeKind::Union { terms } }) => {
            for term in terms {
                if type_set_contains_invalid(world, term.type_id, copied_type_ids(visited)) {
                    return true
                }
            }
            false
        },
        Some(TypeData { id: _, kind: TypeKind::TypeParam { object: _, constraint, index: _ } }) => type_set_contains_invalid(
            world,
            constraint,
            visited,
        ),
        _ => false,
    }
}

fn structural_type_set_comparable_inner(world: World, value: TypeId, visited: Vec[TypeId]) -> bool {
    let resolved = unalias(world, value);
    if type_in_list(visited, resolved) {
        return true
    }
    visited.push(resolved);
    match get_type(world, resolved) {
        Some(TypeData { id: _, kind: TypeKind::Invalid }) | None => false,
        Some(TypeData { id: _, kind: TypeKind::TypeParam { object: _, constraint, index: _ } }) => structural_type_set_comparable_inner(
            world,
            constraint,
            visited,
        ),
        Some(TypeData {
            id: _,
            kind: TypeKind::Named {
                object: _,
                underlying,
                type_params: _,
                type_args: _,
                methods: _,
            },
        }) => if is_interface(world, underlying) {
            structural_type_set_comparable_inner(world, underlying, visited)
        } else {
            comparable_type_inner(world, resolved, visited)
        },
        Some(TypeData {
            id: _,
            kind: TypeKind::Interface { methods: _, embeddeds, comparable, implicit: _ },
        }) => {
            if comparable {
                return true
            } else if embeddeds.is_empty() {
                return false
            }
            for embedded in embeddeds {
                let embedded_comparable = match get_type(world, unalias(world, embedded)) {
                    Some(TypeData { id: _, kind: TypeKind::Invalid }) | None => false,
                    Some(TypeData { id: _, kind: TypeKind::Union { terms } }) => union_terms_comparable(
                        world,
                        terms,
                        copied_type_ids(visited),
                    ),
                    _ => if is_interface(world, embedded) {
                        structural_type_set_comparable_inner(
                            world,
                            embedded,
                            copied_type_ids(visited),
                        )
                    } else {
                        comparable_type_inner(world, embedded, copied_type_ids(visited))
                    },
                };
                if !embedded_comparable {
                    return false
                }
            }
            true
        },
        Some(TypeData { id: _, kind: TypeKind::Union { terms } }) => union_terms_comparable(
            world,
            terms,
            visited,
        ),
        _ => comparable_type_inner(world, resolved, visited),
    }
}

fn has_direct_union_type_set(world: World, value: TypeId) -> bool {
    match get_type(world, unalias(world, value)) {
        Some(TypeData {
            id: _,
            kind: TypeKind::Interface { methods: _, embeddeds, comparable: _, implicit: _ },
        }) => {
            for embedded in embeddeds {
                match get_type(world, unalias(world, embedded)) {
                    Some(TypeData { id: _, kind: TypeKind::Union { terms: _ } }) => return true,
                    _ => {},
                }
            }
            false
        },
        _ => false,
    }
}

fn type_set_comparable_inner(world: World, value: TypeId, visited: Vec[TypeId]) -> bool {
    if type_set_is_empty(world, value) {
        return false
    } else if type_set_contains_invalid(world, value, Vec::new()) {
        return has_direct_union_type_set(world, value)
            && structural_type_set_comparable_inner(world, value, visited)
    }
    let terms = constraint_type_terms(world, value, Vec::new());
    if terms.all {
        interface_requires_comparable(world, value)
            || (has_direct_union_type_set(world, value)
                && structural_type_set_comparable_inner(world, value, visited))
    } else if terms.terms.is_empty() {
        false
    } else if !has_direct_union_type_set(world, value) {
        for term in terms.terms {
            if !strictly_comparable_type_inner(world, term.type_id, copied_type_ids(visited)) {
                return false
            }
        }
        true
    } else {
        union_terms_comparable(world, terms.terms, visited)
    }
}

pub fn type_set_comparable(world: World, value: TypeId) -> bool {
    type_set_comparable_inner(world, value, Vec::new())
}

fn strictly_comparable_type_inner(world: World, value: TypeId, visited: Vec[TypeId]) -> bool {
    let resolved = unalias(world, value);
    if type_in_list(visited, resolved) {
        return true
    }
    visited.push(resolved);
    match get_type(world, underlying(world, resolved)) {
        Some(TypeData { id: _, kind: TypeKind::Invalid }) | None => true,
        Some(TypeData {
            id: _,
            kind: TypeKind::Basic { basic: BasicKind::UntypedNil, name: _, untyped: _ },
        }) => false,
        Some(TypeData { id: _, kind: TypeKind::Basic { basic: _, name: _, untyped: _ } }) => true,
        Some(TypeData { id: _, kind: TypeKind::Array { length: _, element } }) => {
            strictly_comparable_type_inner(world, element, visited)
        },
        Some(TypeData { id: _, kind: TypeKind::Struct { fields } }) => {
            for field in fields {
                if !strictly_comparable_type_inner(world, field.variable.type_id, visited) {
                    return false
                }
            }
            true
        },
        Some(TypeData { id: _, kind: TypeKind::TypeParam { object: _, constraint: _, index: _ } }) => type_set_strictly_comparable_inner(
            world,
            resolved,
            visited,
        ),
        Some(TypeData {
            id: _,
            kind: TypeKind::Interface { methods: _, embeddeds: _, comparable: _, implicit: _ },
        }) => type_set_is_invalid(world, resolved),
        Some(TypeData { id: _, kind: TypeKind::Pointer { element: _ } }) | Some(TypeData {
            id: _,
            kind: TypeKind::Chan { direction: _, element: _ },
        }) => true,
        _ => false,
    }
}

fn strictly_comparable_type(world: World, value: TypeId) -> bool {
    strictly_comparable_type_inner(world, value, Vec::new())
}

fn type_set_strictly_comparable_inner(world: World, value: TypeId, visited: Vec[TypeId]) -> bool {
    if type_set_contains_invalid(world, value, Vec::new()) {
        return false
    }
    let terms = constraint_type_terms(world, value, Vec::new());
    if terms.all {
        interface_requires_comparable(world, value)
    } else if terms.terms.is_empty() {
        false
    } else {
        for term in terms.terms {
            if !strictly_comparable_type_inner(world, term.type_id, visited) {
                return false
            }
        }
        true
    }
}

pub fn type_set_strictly_comparable(world: World, value: TypeId) -> bool {
    type_set_strictly_comparable_inner(world, value, Vec::new())
}

fn concrete_basic_kind(world: World, value: TypeId) -> Option[BasicKind] {
    match get_type(world, underlying(world, value)) {
        Some(TypeData { id: _, kind: TypeKind::Basic { basic, name: _, untyped: _ } }) => {
            Option::Some(basic)
        },
        _ => Option::None,
    }
}

fn integer_basic_kind(value: BasicKind) -> bool {
    match value {
        BasicKind::Int | BasicKind::Int8 | BasicKind::Int16 | BasicKind::Int32 | BasicKind::Int64 | BasicKind::Uint | BasicKind::Uint8 | BasicKind::Uint16 | BasicKind::Uint32 | BasicKind::Uint64 | BasicKind::Uintptr | BasicKind::UntypedInt | BasicKind::UntypedRune => true,
        _ => false,
    }
}

fn numeric_basic_kind(value: BasicKind) -> bool {
    integer_basic_kind(value)
        || match value {
            BasicKind::Float32 | BasicKind::Float64 | BasicKind::Complex64 | BasicKind::Complex128 | BasicKind::UntypedFloat | BasicKind::UntypedComplex => true,
            _ => false,
        }
}

fn ordered_basic_kind(value: BasicKind) -> bool {
    match value {
        BasicKind::String | BasicKind::UntypedString => true,
        BasicKind::Complex64 | BasicKind::Complex128 | BasicKind::UntypedComplex => false,
        _ => numeric_basic_kind(value),
    }
}

fn addable_basic_kind(value: BasicKind) -> bool {
    numeric_basic_kind(value)
        || match value {
            BasicKind::String | BasicKind::UntypedString => true,
            _ => false,
        }
}

fn type_set_basic_property(world: World, value: TypeId, property: isize) -> bool {
    let terms = constraint_type_terms(world, value, Vec::new());
    if terms.all || terms.terms.is_empty() {
        return false
    }
    for term in terms.terms {
        let Some(kind) = concrete_basic_kind(world, term.type_id) else {
            return false;
        };
        let valid = if property == 1 {
            integer_basic_kind(kind)
        } else if property == 2 {
            numeric_basic_kind(kind)
        } else if property == 3 {
            ordered_basic_kind(kind)
        } else {
            addable_basic_kind(kind)
        };
        if !valid {
            return false
        }
    }
    true
}

pub fn type_set_is_integer(world: World, value: TypeId) -> bool {
    type_set_basic_property(world, value, 1)
}

pub fn type_set_is_numeric(world: World, value: TypeId) -> bool {
    type_set_basic_property(world, value, 2)
}

pub fn type_set_is_ordered(world: World, value: TypeId) -> bool {
    type_set_basic_property(world, value, 3)
}

pub fn type_set_supports_add(world: World, value: TypeId) -> bool {
    type_set_basic_property(world, value, 4)
}

pub fn type_set_specific_types(world: World, value: TypeId) -> Vec[TypeId] {
    let result: Vec[TypeId] = Vec::new();
    let terms = constraint_type_terms(world, value, Vec::new());
    if terms.all {
        return result
    }
    for term in terms.terms {
        result.push(term.type_id)
    }
    result
}

fn term_contains(world: World, target: UnionTerm, source: UnionTerm) -> bool {
    if target.tilde {
        identical(world, underlying(world, target.type_id), underlying(world, source.type_id))
    } else {
        !source.tilde && identical(world, target.type_id, source.type_id)
    }
}

pub fn type_set_subset(world: World, source: TypeId, target: TypeId) -> bool {
    let source_terms = constraint_type_terms(world, source, Vec::new());
    let target_terms = constraint_type_terms(world, target, Vec::new());
    if target_terms.all {
        return true
    } else if source_terms.all {
        return false
    }
    for source_term in source_terms.terms {
        let mut contained = false;
        for target_term in target_terms.terms {
            if term_contains(world, target_term, source_term) {
                contained = true;
            }
        }
        if !contained {
            return false
        }
    }
    true
}

fn common_channel_type(world: World, left: TypeId, right: TypeId) -> Option[TypeId] {
    match (get_type(world, left), get_type(world, right)) {
        (
            Some(TypeData {
                id: _,
                kind: TypeKind::Chan { direction: left_direction, element: left_element },
            }),
            Some(TypeData {
                id: _,
                kind: TypeKind::Chan { direction: right_direction, element: right_element },
            }),
        ) => if !identical(world, left_element, right_element) {
            Option::None
        } else if left_direction == right_direction || right_direction == 3 {
            Option::Some(left)
        } else if left_direction == 3 {
            Option::Some(right)
        } else {
            Option::None
        },
        _ => Option::None,
    }
}

pub fn core_type(world: World, value: TypeId) -> Option[TypeId] {
    let resolved = unalias(world, value);
    match type_data(world, resolved) {
        TypeData { id: _, kind: TypeKind::TypeParam { object: _, constraint, index: _ } } => {
            let terms = constraint_type_terms(world, constraint, Vec::new());
            if terms.all || terms.terms.is_empty() {
                return Option::None
            }
            let mut result = underlying(world, terms.terms[0].type_id);
            for index in 1..terms.terms.len() {
                let candidate = underlying(world, terms.terms[index].type_id);
                if !identical(world, result, candidate) {
                    result = common_channel_type(world, result, candidate)?;
                }
            }
            Option::Some(result)
        },
        TypeData {
            id: _,
            kind: TypeKind::Named {
                object: _,
                underlying: _,
                type_params: _,
                type_args: _,
                methods: _,
            },
        } => Option::Some(underlying(world, resolved)),
        _ => Option::Some(resolved),
    }
}
