package types;

struct TypePair {
    left: TypeId,
    right: TypeId,
}

fn pair_seen(values: Vec[TypePair], left: TypeId, right: TypeId) -> bool {
    for value in values {
        if value.left.value == left.value && value.right.value == right.value {
            return true
        }
    }
    false
}

fn same_package(left: Option[PackageId], right: Option[PackageId]) -> bool {
    match (left, right) {
        (Some(left), Some(right)) => left.value == right.value,
        (None, None) => true,
        _ => false,
    }
}

pub fn unalias(world: World, value: TypeId) -> TypeId {
    let mut current = value;
    let mut remaining = world.types.len();
    loop {
        if remaining <= 0 {
            return world.invalid
        }
        remaining -= 1;
        match type_data(world, current) {
            TypeData {
                id: _,
                kind: TypeKind::Alias { object: _, rhs, type_params: _, type_args: _ },
            } => {
                current = rhs;
            },
            _ => return current,
        }
    }
}

pub fn underlying(world: World, value: TypeId) -> TypeId {
    let mut current = value;
    let mut remaining = world.types.len();
    while remaining > 0 {
        remaining -= 1;
        match type_data(world, current).kind {
            TypeKind::Alias { object: _, rhs, type_params: _, type_args: _ } => {
                current = rhs;
            },
            TypeKind::Named { object: _, underlying, type_params: _, type_args: _, methods: _ } => {
                current = underlying;
            },
            _ => return current,
        }
    }
    world.invalid
}

pub fn is_named(world: World, value: TypeId) -> bool {
    match type_data(world, unalias(world, value)).kind {
        TypeKind::Named { object: _, underlying: _, type_params: _, type_args: _, methods: _ } | TypeKind::Basic {
            basic: _,
            name: _,
            untyped: _,
        } | TypeKind::TypeParam { object: _, constraint: _, index: _ } => true,
        _ => false,
    }
}

pub fn basic_kind(world: World, value: TypeId) -> Option[BasicKind] {
    let resolved = core_type(world, value).unwrap_or(world.invalid);
    match type_data(world, resolved) {
        TypeData { id: _, kind: TypeKind::Basic { basic, name: _, untyped: _ } } => {
            Option::Some(basic)
        },
        _ => Option::None,
    }
}

pub fn is_untyped(world: World, value: TypeId) -> bool {
    match type_data(world, unalias(world, value)) {
        TypeData { id: _, kind: TypeKind::Basic { basic: _, name: _, untyped } } => untyped,
        _ => false,
    }
}

pub fn is_type_parameter(world: World, value: TypeId) -> bool {
    match type_data(world, unalias(world, value)) {
        TypeData { id: _, kind: TypeKind::TypeParam { object: _, constraint: _, index: _ } } => true,
        _ => false,
    }
}

fn identical_variables(
    world: World,
    left: Vec[Variable],
    right: Vec[Variable],
    visited: Vec[TypePair],
    compare_tags: bool,
) -> bool {
    if left.len() != right.len() {
        return false
    }
    for index in 0..left.len() {
        if !identical_inner_mode(
            world,
            left[index].type_id,
            right[index].type_id,
            visited,
            compare_tags,
        ) {
            return false
        }
    }
    true
}

fn identical_type_parameters(
    world: World,
    left: Vec[TypeParameter],
    right: Vec[TypeParameter],
    visited: Vec[TypePair],
    compare_tags: bool,
) -> bool {
    if left.len() != right.len() {
        return false
    }
    for index in 0..left.len() {
        if !identical_inner_mode(
            world,
            left[index].constraint,
            right[index].constraint,
            visited,
            compare_tags,
        ) {
            return false
        }
    }
    true
}

fn identical_structs(
    world: World,
    left: Vec[StructField],
    right: Vec[StructField],
    visited: Vec[TypePair],
    compare_tags: bool,
) -> bool {
    if left.len() != right.len() {
        return false
    }
    for index in 0..left.len() {
        let left_field = left[index];
        let right_field = right[index];
        if !method_name_identical(
            left_field.variable.name,
            left_field.variable.owner,
            right_field.variable.name,
            right_field.variable.owner,
        )
            || left_field.embedded != right_field.embedded
            || (compare_tags && left_field.tag != right_field.tag)
            || !identical_inner_mode(
                world,
                left_field.variable.type_id,
                right_field.variable.type_id,
                visited,
                compare_tags,
            ) {
            return false
        }
    }
    true
}

fn method_identity(
    world: World,
    left: ObjectId,
    right: ObjectId,
    visited: Vec[TypePair],
    compare_tags: bool,
) -> bool {
    match (get_object(world, left), get_object(world, right)) {
        (Some(left), Some(right)) => method_name_identical(
            left.name,
            left.owner,
            right.name,
            right.owner,
        )
            && identical_inner_mode(world, left.type_id, right.type_id, visited, compare_tags),
        _ => false,
    }
}

fn identical_interfaces(
    world: World,
    left_type: TypeId,
    right_type: TypeId,
    left_methods: Vec[ObjectId],
    right_methods: Vec[ObjectId],
    left_embeddeds: Vec[TypeId],
    right_embeddeds: Vec[TypeId],
    left_comparable: bool,
    right_comparable: bool,
    visited: Vec[TypePair],
    compare_tags: bool,
) -> bool {
    if left_comparable != right_comparable {
        return false
    }
    let mut ordinary = true;
    for embedded in left_embeddeds {
        if !is_interface(world, embedded) {
            ordinary = false;
        }
    }
    for embedded in right_embeddeds {
        if !is_interface(world, embedded) {
            ordinary = false;
        }
    }
    if ordinary {
        let left_set = interface_methods(world, left_type);
        let right_set = interface_methods(world, right_type);
        if left_set.len() != right_set.len() {
            return false
        }
        for left_method in left_set {
            let mut found = false;
            for right_method in right_set {
                if method_identity(world, left_method, right_method, visited, compare_tags) {
                    found = true;
                }
            }
            if !found {
                return false
            }
        }
        return true
    } else if left_methods.len() != right_methods.len()
        || left_embeddeds.len() != right_embeddeds.len() {
        return false
    }
    for index in 0..left_methods.len() {
        if !method_identity(world, left_methods[index], right_methods[index], visited, compare_tags) {
            return false
        }
    }
    for index in 0..left_embeddeds.len() {
        if !identical_inner_mode(
            world,
            left_embeddeds[index],
            right_embeddeds[index],
            visited,
            compare_tags,
        ) {
            return false
        }
    }
    true
}

fn identical_inner_mode(
    world: World,
    left: TypeId,
    right: TypeId,
    visited: Vec[TypePair],
    compare_tags: bool,
) -> bool {
    let left = unalias(world, left);
    let right = unalias(world, right);
    if left.value == right.value {
        return true
    } else if pair_seen(visited, left, right) {
        return true
    }
    let next = visited;
    next.push(TypePair { left, right });
    match (type_data(world, left).kind, type_data(world, right).kind) {
        (
            TypeKind::Basic { basic: left, name: _, untyped: _ },
            TypeKind::Basic { basic: right, name: _, untyped: _ },
        ) => left == right,
        (
            TypeKind::Array { length: left_length, element: left_element },
            TypeKind::Array { length: right_length, element: right_element },
        ) => left_length == right_length
            && identical_inner_mode(world, left_element, right_element, next, compare_tags),
        (TypeKind::Slice { element: left }, TypeKind::Slice { element: right }) | (
            TypeKind::Pointer { element: left },
            TypeKind::Pointer { element: right },
        ) => identical_inner_mode(world, left, right, next, compare_tags),
        (TypeKind::Struct { fields: left }, TypeKind::Struct { fields: right }) => identical_structs(
            world,
            left,
            right,
            next,
            compare_tags,
        ),
        (TypeKind::Tuple { variables: left }, TypeKind::Tuple { variables: right }) => identical_variables(
            world,
            left,
            right,
            next,
            compare_tags,
        ),
        (
            TypeKind::Signature {
                receiver: _,
                receiver_type_params: _,
                type_params: left_parameters,
                params: left_params,
                results: left_results,
                variadic: left_variadic,
            },
            TypeKind::Signature {
                receiver: _,
                receiver_type_params: _,
                type_params: right_parameters,
                params: right_params,
                results: right_results,
                variadic: right_variadic,
            },
        ) => left_variadic == right_variadic
            && identical_type_parameters(
                world,
                left_parameters,
                right_parameters,
                next,
                compare_tags,
            )
            && identical_inner_mode(world, left_params, right_params, next, compare_tags)
            && identical_inner_mode(world, left_results, right_results, next, compare_tags),
        (
            TypeKind::Interface {
                methods: left_methods,
                embeddeds: left_embeddeds,
                comparable: left_comparable,
                implicit: _,
            },
            TypeKind::Interface {
                methods: right_methods,
                embeddeds: right_embeddeds,
                comparable: right_comparable,
                implicit: _,
            },
        ) => identical_interfaces(
            world,
            left,
            right,
            left_methods,
            right_methods,
            left_embeddeds,
            right_embeddeds,
            left_comparable,
            right_comparable,
            next,
            compare_tags,
        ),
        (
            TypeKind::Map { key: left_key, value: left_value },
            TypeKind::Map { key: right_key, value: right_value },
        ) => identical_inner_mode(world, left_key, right_key, next, compare_tags)
            && identical_inner_mode(world, left_value, right_value, next, compare_tags),
        (
            TypeKind::Chan { direction: left_direction, element: left_element },
            TypeKind::Chan { direction: right_direction, element: right_element },
        ) => left_direction == right_direction
            && identical_inner_mode(world, left_element, right_element, next, compare_tags),
        (
            TypeKind::Named {
                object: left_object,
                underlying: _,
                type_params: _,
                type_args: left_arguments,
                methods: _,
            },
            TypeKind::Named {
                object: right_object,
                underlying: _,
                type_params: _,
                type_args: right_arguments,
                methods: _,
            },
        ) => left_object.value == right_object.value
            && identical_type_arguments(world, left_arguments, right_arguments, next, compare_tags),
        (
            TypeKind::TypeParam { object: left, constraint: _, index: _ },
            TypeKind::TypeParam { object: right, constraint: _, index: _ },
        ) => left.value == right.value,
        (TypeKind::Union { terms: left }, TypeKind::Union { terms: right }) => identical_terms(
            world,
            left,
            right,
            next,
            compare_tags,
        ),
        _ => false,
    }
}

fn identical_type_arguments(
    world: World,
    left: Vec[TypeId],
    right: Vec[TypeId],
    visited: Vec[TypePair],
    compare_tags: bool,
) -> bool {
    if left.len() != right.len() {
        return false
    }
    for index in 0..left.len() {
        if !identical_inner_mode(world, left[index], right[index], visited, compare_tags) {
            return false
        }
    }
    true
}

fn identical_terms(
    world: World,
    left: Vec[UnionTerm],
    right: Vec[UnionTerm],
    visited: Vec[TypePair],
    compare_tags: bool,
) -> bool {
    if left.len() != right.len() {
        return false
    }
    for index in 0..left.len() {
        if left[index].tilde != right[index].tilde
            || !identical_inner_mode(
                world,
                left[index].type_id,
                right[index].type_id,
                visited,
                compare_tags,
            ) {
            return false
        }
    }
    true
}

pub fn identical(world: World, left: TypeId, right: TypeId) -> bool {
    identical_inner_mode(world, left, right, Vec::new(), true)
}

pub fn is_integer(world: World, value: TypeId) -> bool {
    if is_type_parameter(world, value) {
        return type_set_is_integer(world, value)
    }
    match basic_kind(world, value) {
        Some(BasicKind::Int | BasicKind::Int8 | BasicKind::Int16 | BasicKind::Int32 | BasicKind::Int64 | BasicKind::Uint | BasicKind::Uint8 | BasicKind::Uint16 | BasicKind::Uint32 | BasicKind::Uint64 | BasicKind::Uintptr | BasicKind::UntypedInt | BasicKind::UntypedRune,) => true,
        _ => false,
    }
}

pub fn is_numeric(world: World, value: TypeId) -> bool {
    if is_type_parameter(world, value) {
        return type_set_is_numeric(world, value)
    }
    is_integer(world, value)
        || match basic_kind(world, value) {
            Some(BasicKind::Float32 | BasicKind::Float64 | BasicKind::Complex64 | BasicKind::Complex128 | BasicKind::UntypedFloat | BasicKind::UntypedComplex,) => true,
            _ => false,
        }
}

pub fn is_ordered(world: World, value: TypeId) -> bool {
    if is_type_parameter(world, value) {
        return type_set_is_ordered(world, value)
    }
    match basic_kind(world, value) {
        Some(BasicKind::String | BasicKind::UntypedString) => true,
        Some(BasicKind::Complex64 | BasicKind::Complex128 | BasicKind::UntypedComplex) => false,
        _ => is_numeric(world, value),
    }
}

pub fn supports_add(world: World, value: TypeId) -> bool {
    if is_type_parameter(world, value) {
        type_set_supports_add(world, value)
    } else {
        is_numeric(world, value)
            || match basic_kind(world, value) {
                Some(BasicKind::String | BasicKind::UntypedString) => true,
                _ => false,
            }
    }
}

pub fn comparable(world: World, value: TypeId) -> bool {
    match type_data(world, unalias(world, value)) {
        TypeData { id: _, kind: TypeKind::TypeParam { object: _, constraint: _, index: _ } } => return type_set_strictly_comparable(
            world,
            value,
        ),
        _ => {},
    }
    match type_data(world, underlying(world, value)) {
        TypeData { id: _, kind: TypeKind::Invalid } => true,
        TypeData {
            id: _,
            kind: TypeKind::Basic { basic: BasicKind::UntypedNil, name: _, untyped: _ },
        } => {
            false
        },
        TypeData { id: _, kind: TypeKind::Basic { basic: _, name: _, untyped: _ } } => true,
        TypeData { id: _, kind: TypeKind::Array { length: _, element } } => {
            comparable(world, element)
        },
        TypeData { id: _, kind: TypeKind::Struct { fields } } => {
            for field in fields {
                if !comparable(world, field.variable.type_id) {
                    return false
                }
            }
            true
        },
        TypeData { id: _, kind: TypeKind::Pointer { element: _ } } | TypeData {
            id: _,
            kind: TypeKind::Chan { direction: _, element: _ },
        } | TypeData {
            id: _,
            kind: TypeKind::Interface { methods: _, embeddeds: _, comparable: _, implicit: _ },
        } => true,
        TypeData { id: _, kind: TypeKind::TypeParam { object: _, constraint, index: _ } } => match type_data(
            world,
            underlying(world, constraint),
        ) {
            TypeData {
                id: _,
                kind: TypeKind::Interface { methods: _, embeddeds: _, comparable, implicit: _ },
            } => comparable,
            _ => false,
        },
        _ => false,
    }
}

fn is_nilable(world: World, value: TypeId) -> bool {
    match get_type(world, underlying(world, value)) {
        Some(TypeData {
            id: _,
            kind: TypeKind::Basic { basic: BasicKind::UnsafePointer, name: _, untyped: _ },
        }) | Some(TypeData { id: _, kind: TypeKind::Slice { element: _ } }) | Some(TypeData {
            id: _,
            kind: TypeKind::Pointer { element: _ },
        }) | Some(TypeData {
            id: _,
            kind: TypeKind::Signature {
                receiver: _,
                receiver_type_params: _,
                type_params: _,
                params: _,
                results: _,
                variadic: _,
            },
        }) | Some(TypeData {
            id: _,
            kind: TypeKind::Interface { methods: _, embeddeds: _, comparable: _, implicit: _ },
        }) | Some(TypeData { id: _, kind: TypeKind::Map { key: _, value: _ } }) | Some(TypeData {
            id: _,
            kind: TypeKind::Chan { direction: _, element: _ },
        }) => true,
        _ => false,
    }
}

pub fn is_nilable_type(world: World, value: TypeId) -> bool {
    if is_type_parameter(world, value) {
        let types = type_set_specific_types(world, value);
        if types.is_empty() {
            false
        } else {
            for type_id in types {
                if !is_nilable(world, type_id) {
                    return false
                }
            }
            true
        }
    } else {
        is_nilable(world, value)
    }
}

fn is_untyped_nil(world: World, value: TypeId) -> bool {
    match basic_kind(world, value) {
        Some(BasicKind::UntypedNil) => true,
        _ => false,
    }
}

pub fn assignable_types(world: World, source: TypeId, target: TypeId) -> bool {
    if identical(world, source, target) {
        true
    } else if is_interface(world, target) && implements(world, source, target) {
        true
    } else if is_untyped_nil(world, source) && is_nilable_type(world, target) {
        true
    } else if is_type_parameter(world, source) || is_type_parameter(world, target) {
        false
    } else {
        let source_underlying = underlying(world, source);
        let target_underlying = underlying(world, target);
        if identical(world, source_underlying, target_underlying)
            && (!is_named(world, source) || !is_named(world, target)) {
            true
        } else {
            match (type_data(world, source_underlying), type_data(world, target_underlying)) {
                (
                    TypeData {
                        id: _,
                        kind: TypeKind::Chan { direction: 3, element: source_element },
                    },
                    TypeData {
                        id: _,
                        kind: TypeKind::Chan { direction: _, element: target_element },
                    },
                ) => identical(world, source_element, target_element)
                    && (!is_named(world, source) || !is_named(world, target)),
                _ => false,
            }
        }
    }
}

fn is_string_type(world: World, value: TypeId) -> bool {
    match basic_kind(world, value) {
        Some(BasicKind::String | BasicKind::UntypedString) => true,
        _ => false,
    }
}

fn slice_element(world: World, value: TypeId) -> Option[TypeId] {
    match get_type(world, underlying(world, value)) {
        Some(TypeData { id: _, kind: TypeKind::Slice { element } }) => Option::Some(element),
        _ => Option::None,
    }
}

fn string_slice_element(world: World, value: TypeId) -> bool {
    match slice_element(world, value) {
        Some(element) => match basic_kind(world, element) {
            Some(BasicKind::Uint8 | BasicKind::Int32) => true,
            _ => false,
        },
        None => false,
    }
}

fn identical_structs_ignoring_tags(world: World, left: TypeId, right: TypeId) -> bool {
    identical_inner_mode(
        world,
        underlying(world, left),
        underlying(world, right),
        Vec::new(),
        false,
    )
}

fn copied_type_pairs(values: Vec[TypePair]) -> Vec[TypePair] {
    let result: Vec[TypePair] = Vec::new();
    for value in values {
        result.push(TypePair { left: value.left, right: value.right })
    }
    result
}

fn is_unsafe_pointer_type(world: World, value: TypeId) -> bool {
    match basic_kind(world, value) {
        Some(BasicKind::UnsafePointer) => true,
        _ => false,
    }
}

fn is_uintptr_type(world: World, value: TypeId) -> bool {
    match basic_kind(world, value) {
        Some(BasicKind::Uintptr) => true,
        _ => false,
    }
}

fn is_complex_type(world: World, value: TypeId) -> bool {
    match basic_kind(world, value) {
        Some(BasicKind::Complex64 | BasicKind::Complex128 | BasicKind::UntypedComplex) => true,
        _ => false,
    }
}

fn is_pointer_type(world: World, value: TypeId) -> bool {
    match get_type(world, underlying(world, value)) {
        Some(TypeData { id: _, kind: TypeKind::Pointer { element: _ } }) => true,
        _ => false,
    }
}

fn slice_array_conversion_minor(world: World, source: TypeId, target: TypeId) -> isize {
    let source_element = match get_type(world, underlying(world, source)) {
        Some(TypeData { id: _, kind: TypeKind::Slice { element } }) => element,
        _ => return 0,
    };
    match get_type(world, underlying(world, target)) {
        Some(TypeData { id: _, kind: TypeKind::Array { length: _, element } }) => if identical(
            world,
            source_element,
            element,
        ) {
            20
        } else {
            0
        },
        Some(TypeData { id: _, kind: TypeKind::Pointer { element } }) => match get_type(
            world,
            underlying(world, element),
        ) {
            Some(TypeData { id: _, kind: TypeKind::Array { length: _, element } }) => if identical(
                world,
                source_element,
                element,
            ) {
                17
            } else {
                0
            },
            _ => 0,
        },
        _ => 0,
    }
}

fn convertible_concrete(world: World, source: TypeId, target: TypeId, visited: Vec[TypePair]) -> bool {
    if pair_seen(visited, source, target) {
        return true
    }
    let next = copied_type_pairs(visited);
    next.push(TypePair { left: source, right: target });
    if assignable_types(world, source, target) {
        true
    } else if identical_structs_ignoring_tags(world, source, target) {
        true
    } else if is_numeric(world, source) && is_numeric(world, target)
        && is_complex_type(world, source) == is_complex_type(world, target) {
        true
    } else if match basic_kind(world, source) {
        Some(BasicKind::UntypedBool) => true,
        _ => false,
    }
        && match basic_kind(world, target) {
            Some(BasicKind::Bool) => true,
            _ => false,
        } {
        true
    } else if match basic_kind(world, source) {
        Some(BasicKind::UntypedString) => true,
        _ => false,
    }
        && match basic_kind(world, target) {
            Some(BasicKind::String) => true,
            _ => false,
        } {
        true
    } else if is_integer(world, source) && is_string_type(world, target) {
        true
    } else if (is_string_type(world, source) && string_slice_element(world, target))
        || (string_slice_element(world, source) && is_string_type(world, target)) {
        true
    } else if (is_pointer_type(world, source) || is_uintptr_type(world, source))
        && is_unsafe_pointer_type(world, target) {
        true
    } else if is_unsafe_pointer_type(world, source)
        && (is_pointer_type(world, target) || is_uintptr_type(world, target)) {
        true
    } else if slice_array_conversion_minor(world, source, target) > 0 {
        true
    } else {
        match (
            get_type(world, underlying(world, source)),
            get_type(world, underlying(world, target)),
        ) {
            (
                Some(TypeData { id: _, kind: TypeKind::Pointer { element: source_element } }),
                Some(TypeData { id: _, kind: TypeKind::Pointer { element: target_element } }),
            ) => !is_named(world, source) && !is_named(world, target)
                && identical_inner_mode(
                    world,
                    underlying(world, source_element),
                    underlying(world, target_element),
                    Vec::new(),
                    false,
                ),
            _ => false,
        }
    }
}

fn convertible_inner(world: World, source: TypeId, target: TypeId, visited: Vec[TypePair]) -> bool {
    let source_parameter = is_type_parameter(world, source);
    let target_parameter = is_type_parameter(world, target);
    if source_parameter && is_interface(world, target) && implements(world, source, target) {
        true
    } else if source_parameter {
        let source_types = type_set_specific_types(world, source);
        if source_types.is_empty() {
            return false
        }
        for source_type in source_types {
            if target_parameter {
                let target_types = type_set_specific_types(world, target);
                if target_types.is_empty() {
                    return false
                }
                for target_type in target_types {
                    if !convertible_concrete(world, source_type, target_type, visited) {
                        return false
                    }
                }
            } else if !convertible_concrete(world, source_type, target, visited) {
                return false
            }
        }
        true
    } else if target_parameter {
        let target_types = type_set_specific_types(world, target);
        if target_types.is_empty() {
            return false
        }
        for target_type in target_types {
            if !convertible_concrete(world, source, target_type, visited) {
                return false
            }
        }
        true
    } else {
        convertible_concrete(world, source, target, visited)
    }
}

pub fn convertible_types(world: World, source: TypeId, target: TypeId) -> bool {
    convertible_inner(world, source, target, Vec::new())
}

pub fn conversion_minimum_minor(world: World, source: TypeId, target: TypeId) -> isize {
    let source_types = if is_type_parameter(world, source) {
        type_set_specific_types(world, source)
    } else {
        Vec::from_array([source])
    };
    let target_types = if is_type_parameter(world, target) {
        type_set_specific_types(world, target)
    } else {
        Vec::from_array([target])
    };
    let mut result = 0;
    for source_type in source_types {
        for target_type in target_types {
            let required = slice_array_conversion_minor(world, source_type, target_type);
            if required > result {
                result = required;
            }
        }
    }
    result
}
