package types;

use gomlgo::syntax;
use std::unicode;

pub fn empty_world() -> World {
    let invalid = type_id(0);
    World {
        types: Vec::from_array([TypeData { id: invalid, kind: TypeKind::Invalid }]),
        type_revision: Ref::new(1),
        named_instances: HashMap::new(),
        named_instance_revisions: HashMap::new(),
        named_type_objects: Vec::from_array([-1]),
        objects: Vec::new(),
        scopes: Vec::new(),
        packages: Vec::new(),
        basics: Vec::new(),
        universe: scope_id(-1),
        unsafe_package: package_id(-1),
        invalid,
        invalid_type_sets: Vec::new(),
    }
}

fn advance_type_revision(world: World) -> () {
    world.type_revision.set(world.type_revision.get() + 1)
}

pub fn type_revision(world: World) -> i32 {
    world.type_revision.get()
}

fn named_type_object(kind: TypeKind) -> isize {
    match kind {
        TypeKind::Named { object, underlying: _, type_params: _, type_args: _, methods: _ } => {
            object.value
        },
        _ => -1,
    }
}

fn register_named_type(world: World, id: TypeId, object: isize) -> () {
    match world.named_instances[object] {
        Some(instances) => instances.push(id),
        None => {
            world.named_instances[object] = Vec::from_array([id]);
        },
    }
}

pub fn add_type(world: World, kind: TypeKind) -> TypeId {
    let id = type_id(world.types.len());
    let object = named_type_object(kind);
    world.types.push(TypeData { id, kind });
    world.named_type_objects.push(object);
    if object >= 0 {
        register_named_type(world, id, object)
    }
    id
}

pub fn set_type(world: World, id: TypeId, kind: TypeKind) -> bool {
    if id.value >= 0 && id.value < world.types.len() {
        let object = named_type_object(kind);
        if object >= 0 && world.named_type_objects[id.value] != object {
            register_named_type(world, id, object)
        }
        world.named_type_objects[id.value] = object;
        world.types[id.value] = TypeData { id, kind };
        advance_type_revision(world);
        true
    } else {
        false
    }
}

pub fn get_type(world: World, id: TypeId) -> Option[TypeData] {
    if id.value.to_usize() < world.types.len().to_usize() {
        Option::Some(world.types[id.value])
    } else {
        Option::None
    }
}

pub fn has_type(world: World, id: TypeId) -> bool {
    id.value.to_usize() < world.types.len().to_usize()
}

pub fn type_data(world: World, id: TypeId) -> TypeData {
    if id.value.to_usize() < world.types.len().to_usize() {
        world.types[id.value]
    } else {
        world.types[world.invalid.value]
    }
}

fn valid_scope(world: World, scope: ScopeId) -> bool {
    scope.value >= 0 && scope.value < world.scopes.len()
}

fn parent_scope_depth(world: World, parent: Option[ScopeId]) -> isize {
    match parent {
        Some(scope) => if valid_scope(world, scope) {
            world.scopes[scope.value].depth + 1
        } else {
            1
        },
        None => 1,
    }
}

fn update_scope_depth(world: World, scope: ScopeId, depth: isize) -> () {
    if valid_scope(world, scope) {
        world.scopes[scope.value].depth = depth;
        for child in world.scopes[scope.value].children {
            update_scope_depth(world, child, depth + 1)
        }
    }
}

fn remove_scope_child(world: World, parent: ScopeId, child: ScopeId) -> () {
    if valid_scope(world, parent) {
        let children: Vec[ScopeId] = Vec::with_capacity(world.scopes[parent.value].children.len());
        for candidate in world.scopes[parent.value].children {
            if candidate.value != child.value {
                children.push(candidate)
            }
        }
        world.scopes[parent.value].children = children;
    }
}

pub fn set_scope_parent(world: World, scope: ScopeId, parent: ScopeId) -> bool {
    if !valid_scope(world, scope) || !valid_scope(world, parent) {
        return false
    }
    let previous = world.scopes[scope.value].parent;
    let unchanged = match previous {
        Some(value) => value.value == parent.value,
        None => false,
    };
    if unchanged {
        return true
    }
    if let Some(value) = previous {
        remove_scope_child(world, value, scope)
    }
    world.scopes[scope.value].parent = Option::Some(parent);
    world.scopes[parent.value].children.push(scope);
    update_scope_depth(world, scope, world.scopes[parent.value].depth + 1);
    true
}

pub fn add_scope(
    world: World,
    kind: ScopeKind,
    parent: Option[ScopeId],
    file: Option[syntax::FileId],
    start: isize,
    end: isize,
) -> ScopeId {
    let id = scope_id(world.scopes.len());
    let depth = parent_scope_depth(world, parent);
    world.scopes.push(
        Scope {
            id,
            kind,
            parent,
            depth,
            file,
            start,
            end,
            entries: Vec::new(),
            entry_objects: HashMap::new(),
            children: Vec::new(),
        },
    );
    match parent {
        Some(parent_id) => if parent_id.value >= 0 && parent_id.value < world.scopes.len() {
            world.scopes[parent_id.value].children.push(id)
        },
        None => {},
    }
    id
}

pub fn add_package(world: World, path: string, name: string, parent: ScopeId, complete: bool) -> PackageId {
    let scope = add_scope(world, ScopeKind::Package, Option::Some(parent), Option::None, -1, -1);
    let id = package_id(world.packages.len());
    world.packages.push(Package { id, path, name, scope, complete });
    id
}

pub fn get_package(world: World, id: PackageId) -> Option[Package] {
    if id.value.to_usize() < world.packages.len().to_usize() {
        Option::Some(world.packages[id.value])
    } else {
        Option::None
    }
}

pub fn is_exported(name: string) -> bool {
    for character in name.chars() {
        return unicode::is_uppercase(character)
    }
    false
}

pub fn add_object(
    world: World,
    kind: ObjectKind,
    name: string,
    owner: Option[PackageId],
    file: Option[syntax::FileId],
    node: Option[syntax::NodeId],
    position: isize,
    object_type: TypeId,
) -> ObjectId {
    let id = object_id(world.objects.len());
    world.objects.push(
        Object {
            id,
            kind,
            name,
            owner,
            file,
            node,
            position,
            type_id: object_type,
            exported: is_exported(name),
            constant_kind: "",
            constant: Option::None,
            imported_package: Option::None,
        },
    );
    id
}

pub fn get_object(world: World, id: ObjectId) -> Option[Object] {
    if id.value.to_usize() < world.objects.len().to_usize() {
        Option::Some(world.objects[id.value])
    } else {
        Option::None
    }
}

pub fn set_object_type(world: World, id: ObjectId, object_type: TypeId) -> bool {
    if id.value >= 0 && id.value < world.objects.len() {
        if world.objects[id.value].type_id.value != object_type.value {
            world.objects[id.value].type_id = object_type;
            advance_type_revision(world)
        }
        true
    } else {
        false
    }
}

pub fn set_object_constant(world: World, id: ObjectId, kind: string, value: string) -> bool {
    if id.value >= 0 && id.value < world.objects.len() {
        world.objects[id.value].constant_kind = kind;
        world.objects[id.value].constant = Option::Some(value);
        true
    } else {
        false
    }
}

pub fn set_object_imported_package(world: World, id: ObjectId, imported: PackageId) -> bool {
    if id.value >= 0 && id.value < world.objects.len() {
        world.objects[id.value].imported_package = Option::Some(imported);
        true
    } else {
        false
    }
}

pub fn insert(world: World, scope: ScopeId, name: string, object: ObjectId) -> Option[ObjectId] {
    if scope.value < 0 || scope.value >= world.scopes.len() {
        return Option::Some(object)
    }
    if let Some(existing) = world.scopes[scope.value].entry_objects[name] {
        return Option::Some(existing)
    }
    world.scopes[scope.value].entries.push(ScopeEntry { name, object });
    world.scopes[scope.value].entry_objects[name] = object;
    Option::None
}

pub fn lookup(world: World, scope: ScopeId, name: string) -> Option[ObjectId] {
    let mut current = Option::Some(scope);
    while let Some(scope_id_value) = current {
        if scope_id_value.value < 0 || scope_id_value.value >= world.scopes.len() {
            return Option::None
        }
        if let Some(object) = world.scopes[scope_id_value.value].entry_objects[name] {
            return Option::Some(object)
        }
        current = world.scopes[scope_id_value.value].parent;
    }
    Option::None
}

pub fn lookup_local(world: World, scope: ScopeId, name: string) -> Option[ObjectId] {
    if scope.value < 0 || scope.value >= world.scopes.len() {
        return Option::None
    }
    world.scopes[scope.value].entry_objects[name]
}

pub fn lookup_at(world: World, scope: ScopeId, name: string, position: isize) -> Option[ObjectId] {
    let mut current = Option::Some(scope);
    while let Some(scope_id_value) = current {
        if scope_id_value.value < 0 || scope_id_value.value >= world.scopes.len() {
            return Option::None
        }
        match world.scopes[scope_id_value.value].entry_objects[name] {
            Some(entry_object) => match get_object(world, entry_object) {
                Some(object) => if object.position < 0 || object.position <= position {
                    return Option::Some(entry_object)
                },
                None => {},
            },
            None => {},
        }
        current = world.scopes[scope_id_value.value].parent;
    }
    Option::None
}

pub fn basic_type(world: World, name: string) -> Option[TypeId] {
    for entry in world.basics {
        if entry.name == name {
            return Option::Some(entry.type_id)
        }
    }
    Option::None
}
