package types;

use std::collections;

type SubstitutionEntries = collections::IndexMap[isize, TypeId];

fn substitution_argument(value: ObjectId, parameters: Vec[TypeParameter], arguments: Vec[TypeId]) -> Option[
    TypeId,
] {
    for index in 0..parameters.len() {
        if parameters[index].object.value == value.value && index < arguments.len() {
            return Option::Some(arguments[index])
        }
    }
    Option::None
}

fn substituted_entry(entries: SubstitutionEntries, source: TypeId) -> Option[TypeId] {
    entries.get(source.value)
}

fn substitute_variables(
    world: World,
    values: Vec[Variable],
    parameters: Vec[TypeParameter],
    arguments: Vec[TypeId],
    entries: SubstitutionEntries,
) -> Vec[Variable] {
    let result: Vec[Variable] = Vec::new();
    for value in values {
        result.push(
            Variable {
                name: value.name,
                owner: value.owner,
                type_id: substitute_inner(world, value.type_id, parameters, arguments, entries),
            },
        )
    }
    result
}

fn clone_object_with_type(world: World, source: ObjectId, type_id: TypeId) -> ObjectId {
    match get_object(world, source) {
        Some(object) => {
            let result = add_object(
                world,
                object.kind,
                object.name,
                object.owner,
                object.file,
                object.node,
                object.position,
                type_id,
            );
            world.objects[result.value].exported = object.exported;
            world.objects[result.value].constant = object.constant;
            world.objects[result.value].imported_package = object.imported_package;
            result
        },
        None => object_id(-1),
    }
}

fn instantiate_method_object(
    world: World,
    source: ObjectId,
    parameters: Vec[TypeParameter],
    arguments: Vec[TypeId],
    receiver_arguments: Vec[TypeId],
    receiver_type: TypeId,
) -> ObjectId {
    let Some(object) = get_object(world, source) else {
        return object_id(-1);
    };
    match get_type(world, object.type_id) {
        Some(TypeData {
            id: _,
            kind: TypeKind::Signature {
                receiver,
                receiver_type_params,
                type_params,
                params,
                results,
                variadic,
            },
        }) => {
            let signature_parameters: Vec[TypeParameter] = Vec::new();
            for parameter in parameters {
                signature_parameters.push(parameter)
            }
            let signature_arguments: Vec[TypeId] = Vec::new();
            for argument in arguments {
                signature_arguments.push(argument)
            }
            for index in 0..receiver_type_params.len() {
                if index < receiver_arguments.len() {
                    signature_parameters.push(receiver_type_params[index]);
                    signature_arguments.push(receiver_arguments[index]);
                }
            }
            let entries: SubstitutionEntries = collections::IndexMap::new();
            let signature = add_type(
                world,
                TypeKind::Signature {
                    receiver: receiver.map(
                        |receiver| Variable {
                            name: receiver.name,
                            owner: receiver.owner,
                            type_id: match get_type(world, unalias(world, receiver.type_id)) {
                                Some(TypeData { id: _, kind: TypeKind::Pointer { element: _ } }) => add_type(
                                    world,
                                    TypeKind::Pointer { element: receiver_type },
                                ),
                                _ => receiver_type,
                            },
                        },
                    ),
                    receiver_type_params,
                    type_params,
                    params: substitute_inner(
                        world,
                        params,
                        signature_parameters,
                        signature_arguments,
                        entries,
                    ),
                    results: substitute_inner(
                        world,
                        results,
                        signature_parameters,
                        signature_arguments,
                        entries,
                    ),
                    variadic,
                },
            );
            clone_object_with_type(world, source, signature)
        },
        _ => clone_object_with_type(
            world,
            source,
            substitute_inner(
                world,
                object.type_id,
                parameters,
                arguments,
                collections::IndexMap::new(),
            ),
        ),
    }
}

fn instantiate_method_objects(
    world: World,
    methods: Vec[ObjectId],
    parameters: Vec[TypeParameter],
    arguments: Vec[TypeId],
    receiver_arguments: Vec[TypeId],
    receiver_type: TypeId,
) -> Vec[ObjectId] {
    let result: Vec[ObjectId] = Vec::new();
    for method in methods {
        result.push(
            instantiate_method_object(
                world,
                method,
                parameters,
                arguments,
                receiver_arguments,
                receiver_type,
            ),
        )
    }
    result
}

fn substitute_objects(
    world: World,
    values: Vec[ObjectId],
    parameters: Vec[TypeParameter],
    arguments: Vec[TypeId],
    entries: SubstitutionEntries,
) -> Vec[ObjectId] {
    let result: Vec[ObjectId] = Vec::new();
    for value in values {
        match get_object(world, value) {
            Some(object) => result.push(
                clone_object_with_type(
                    world,
                    value,
                    substitute_inner(world, object.type_id, parameters, arguments, entries),
                ),
            ),
            None => {},
        }
    }
    result
}

fn substitute_type_parameters(
    world: World,
    values: Vec[TypeParameter],
    parameters: Vec[TypeParameter],
    arguments: Vec[TypeId],
    entries: SubstitutionEntries,
) -> Vec[TypeParameter] {
    let result: Vec[TypeParameter] = Vec::new();
    for value in values {
        result.push(
            TypeParameter {
                object: value.object,
                constraint: substitute_inner(
                    world,
                    value.constraint,
                    parameters,
                    arguments,
                    entries,
                ),
                grouped: value.grouped,
            },
        )
    }
    result
}

fn substitute_inner(
    world: World,
    value: TypeId,
    parameters: Vec[TypeParameter],
    arguments: Vec[TypeId],
    entries: SubstitutionEntries,
) -> TypeId {
    if let Some(value) = substituted_entry(entries, value) {
        return value
    }
    match type_data(world, value) {
        TypeData { id: _, kind: TypeKind::TypeParam { object, constraint: _, index: _ } } => substitution_argument(
            object,
            parameters,
            arguments,
        ).unwrap_or(value),
        TypeData { id: _, kind: TypeKind::Array { length, element } } => add_type(
            world,
            TypeKind::Array {
                length,
                element: substitute_inner(world, element, parameters, arguments, entries),
            },
        ),
        TypeData { id: _, kind: TypeKind::Slice { element } } => add_type(
            world,
            TypeKind::Slice {
                element: substitute_inner(world, element, parameters, arguments, entries),
            },
        ),
        TypeData { id: _, kind: TypeKind::Pointer { element } } => add_type(
            world,
            TypeKind::Pointer {
                element: substitute_inner(world, element, parameters, arguments, entries),
            },
        ),
        TypeData { id: _, kind: TypeKind::Map { key, value: map_value } } => add_type(
            world,
            TypeKind::Map {
                key: substitute_inner(world, key, parameters, arguments, entries),
                value: substitute_inner(world, map_value, parameters, arguments, entries),
            },
        ),
        TypeData { id: _, kind: TypeKind::Chan { direction, element } } => add_type(
            world,
            TypeKind::Chan {
                direction,
                element: substitute_inner(world, element, parameters, arguments, entries),
            },
        ),
        TypeData { id: _, kind: TypeKind::Tuple { variables } } => add_type(
            world,
            TypeKind::Tuple {
                variables: substitute_variables(world, variables, parameters, arguments, entries),
            },
        ),
        TypeData { id: _, kind: TypeKind::Struct { fields } } => {
            let result: Vec[StructField] = Vec::new();
            for field in fields {
                let field_type = substitute_inner(
                    world,
                    field.variable.type_id,
                    parameters,
                    arguments,
                    entries,
                );
                result.push(
                    StructField {
                        object: field.object.map(
                            |object| clone_object_with_type(world, object, field_type),
                        ),
                        variable: Variable {
                            name: field.variable.name,
                            owner: field.variable.owner,
                            type_id: field_type,
                        },
                        embedded: field.embedded,
                        tag: field.tag,
                    },
                )
            }
            add_type(world, TypeKind::Struct { fields: result })
        },
        TypeData {
            id: _,
            kind: TypeKind::Signature {
                receiver,
                receiver_type_params,
                type_params,
                params,
                results,
                variadic,
            },
        } => {
            let signature_parameters: Vec[TypeParameter] = Vec::new();
            for parameter in parameters {
                signature_parameters.push(parameter)
            }
            let signature_arguments: Vec[TypeId] = Vec::new();
            for argument in arguments {
                signature_arguments.push(argument)
            }
            for index in 0..receiver_type_params.len() {
                if index < arguments.len() {
                    signature_parameters.push(receiver_type_params[index]);
                    signature_arguments.push(arguments[index]);
                }
            }
            add_type(
                world,
                TypeKind::Signature {
                    receiver: receiver.map(
                        |receiver| Variable {
                            name: receiver.name,
                            owner: receiver.owner,
                            type_id: match type_data(world, unalias(world, receiver.type_id)) {
                                TypeData {
                                    id: _,
                                    kind: TypeKind::Named {
                                        object: receiver_object,
                                        underlying: _,
                                        type_params: receiver_parameters,
                                        type_args: receiver_arguments,
                                        methods: _,
                                    },
                                } => if receiver_arguments.is_empty()
                                    && !receiver_parameters.is_empty() {
                                    let arguments: Vec[TypeId] = Vec::new();
                                    let mut complete = true;
                                    for parameter in receiver_parameters {
                                        match substitution_argument(
                                            parameter.object,
                                            signature_parameters,
                                            signature_arguments,
                                        ) {
                                            Some(argument) => arguments.push(argument),
                                            None => {
                                                complete = false;
                                            },
                                        }
                                    }
                                    if complete {
                                        add_type(
                                            world,
                                            TypeKind::Named {
                                                object: receiver_object,
                                                underlying: world.invalid,
                                                type_params: receiver_parameters,
                                                type_args: arguments,
                                                methods: Vec::new(),
                                            },
                                        )
                                    } else {
                                        receiver.type_id
                                    }
                                } else {
                                    substitute_inner(
                                        world,
                                        receiver.type_id,
                                        signature_parameters,
                                        signature_arguments,
                                        entries,
                                    )
                                },
                                _ => substitute_inner(
                                    world,
                                    receiver.type_id,
                                    signature_parameters,
                                    signature_arguments,
                                    entries,
                                ),
                            },
                        },
                    ),
                    receiver_type_params,
                    type_params,
                    params: substitute_inner(
                        world,
                        params,
                        signature_parameters,
                        signature_arguments,
                        entries,
                    ),
                    results: substitute_inner(
                        world,
                        results,
                        signature_parameters,
                        signature_arguments,
                        entries,
                    ),
                    variadic,
                },
            )
        },
        TypeData { id: _, kind: TypeKind::Interface { methods, embeddeds, comparable, implicit } } => {
            if methods.is_empty() && embeddeds.is_empty() {
                return value
            }
            let result = add_type(world, TypeKind::Invalid);
            let _ = entries.insert(value.value, result);
            let result_embeddeds: Vec[TypeId] = Vec::new();
            for embedded in embeddeds {
                result_embeddeds.push(
                    substitute_inner(world, embedded, parameters, arguments, entries),
                )
            }
            let _ = set_type(
                world,
                result,
                TypeKind::Interface {
                    methods: substitute_objects(world, methods, parameters, arguments, entries),
                    embeddeds: result_embeddeds,
                    comparable,
                    implicit,
                },
            );
            result
        },
        TypeData {
            id: _,
            kind: TypeKind::Named { object, underlying, type_params, type_args, methods },
        } => if type_args.is_empty() {
            value
        } else {
            let result = add_type(world, TypeKind::Invalid);
            let _ = entries.insert(value.value, result);
            let next_arguments: Vec[TypeId] = Vec::new();
            for argument in type_args {
                next_arguments.push(
                    substitute_inner(world, argument, parameters, arguments, entries),
                )
            }
            let next_underlying = match get_object(world, object) {
                Some(origin_object) => match type_data(world, origin_object.type_id) {
                    TypeData {
                        id: _,
                        kind: TypeKind::Named {
                            object: _,
                            underlying: origin_underlying,
                            type_params: origin_parameters,
                            type_args: _,
                            methods: _,
                        },
                    } => substitute_inner(
                        world,
                        origin_underlying,
                        origin_parameters,
                        next_arguments,
                        entries,
                    ),
                    _ => substitute_inner(world, underlying, parameters, arguments, entries),
                },
                None => substitute_inner(world, underlying, parameters, arguments, entries),
            };
            let _ = set_type(
                world,
                result,
                TypeKind::Named {
                    object,
                    underlying: next_underlying,
                    type_params,
                    type_args: next_arguments,
                    methods: Vec::new(),
                },
            );
            result
        },
        TypeData { id: _, kind: TypeKind::Alias { object, rhs, type_params, type_args } } => {
            let next_arguments: Vec[TypeId] = Vec::new();
            for argument in type_args {
                next_arguments.push(
                    substitute_inner(world, argument, parameters, arguments, entries),
                )
            }
            add_type(
                world,
                TypeKind::Alias {
                    object,
                    rhs: substitute_inner(world, rhs, parameters, arguments, entries),
                    type_params,
                    type_args: next_arguments,
                },
            )
        },
        TypeData { id: _, kind: TypeKind::Union { terms } } => {
            let result: Vec[UnionTerm] = Vec::new();
            for term in terms {
                result.push(
                    UnionTerm {
                        tilde: term.tilde,
                        type_id: substitute_inner(
                            world,
                            term.type_id,
                            parameters,
                            arguments,
                            entries,
                        ),
                    },
                )
            }
            add_type(world, TypeKind::Union { terms: result })
        },
        _ => value,
    }
}

pub fn substitute(
    world: World,
    value: TypeId,
    parameters: Vec[TypeParameter],
    arguments: Vec[TypeId],
) -> TypeId {
    substitute_inner(world, value, parameters, arguments, collections::IndexMap::new())
}

fn instantiate_inner(
    world: World,
    origin: TypeId,
    arguments: Vec[TypeId],
    include_methods: bool,
    require_complete: bool,
) -> Option[TypeId] {
    match get_type(world, origin) {
        Some(TypeData {
            id: _,
            kind: TypeKind::Named { object, underlying, type_params, type_args: _, methods },
        }) => if require_complete && type_params.len() != arguments.len() {
            Option::None
        } else {
            let result = add_type(world, TypeKind::Invalid);
            let _ = set_type(
                world,
                result,
                TypeKind::Named {
                    object,
                    underlying: substitute(world, underlying, type_params, arguments),
                    type_params,
                    type_args: arguments,
                    methods: if include_methods {
                        instantiate_method_objects(
                            world,
                            methods,
                            type_params,
                            arguments,
                            arguments,
                            result,
                        )
                    } else {
                        Vec::new()
                    },
                },
            );
            Option::Some(result)
        },
        Some(TypeData { id: _, kind: TypeKind::Alias { object, rhs, type_params, type_args: _ } }) => if require_complete
            && type_params.len() != arguments.len() {
            Option::None
        } else {
            Option::Some(
                add_type(
                    world,
                    TypeKind::Alias {
                        object,
                        rhs: substitute(world, rhs, type_params, arguments),
                        type_params,
                        type_args: arguments,
                    },
                ),
            )
        },
        Some(TypeData {
            id: _,
            kind: TypeKind::Signature {
                receiver,
                receiver_type_params,
                type_params,
                params,
                results,
                variadic,
            },
        }) => if require_complete && type_params.len() != arguments.len() {
            Option::None
        } else {
            Option::Some(
                add_type(
                    world,
                    TypeKind::Signature {
                        receiver,
                        receiver_type_params,
                        type_params: Vec::new(),
                        params: substitute(world, params, type_params, arguments),
                        results: substitute(world, results, type_params, arguments),
                        variadic,
                    },
                ),
            )
        },
        _ => Option::None,
    }
}

pub fn instantiate(world: World, origin: TypeId, arguments: Vec[TypeId]) -> Option[TypeId] {
    instantiate_inner(world, origin, arguments, true, true)
}

pub fn instantiate_receiver(world: World, origin: TypeId, arguments: Vec[TypeId]) -> Option[TypeId] {
    instantiate_inner(world, origin, arguments, false, false)
}

pub fn instantiate_incomplete(world: World, origin: TypeId, arguments: Vec[TypeId]) -> Option[
    TypeId,
] {
    instantiate_inner(world, origin, arguments, true, false)
}

fn object_name(world: World, value: ObjectId) -> string {
    match get_object(world, value) {
        Some(object) => object.name,
        None => "",
    }
}

pub fn ensure_named_instance_methods(world: World, instance: TypeId) -> () {
    let instance_data = match type_data(world, instance) {
        TypeData {
            id: _,
            kind: TypeKind::Named { object, underlying, type_params, type_args, methods },
        } => (object, underlying, type_params, type_args, methods),
        _ => return,
    };
    if instance_data.3.is_empty() {
        return
    }
    let origin = match get_object(world, instance_data.0) {
        Some(object) => object.type_id,
        None => return,
    };
    let origin_data = match type_data(world, origin) {
        TypeData {
            id: _,
            kind: TypeKind::Named { object: _, underlying, type_params, type_args: _, methods },
        } => (underlying, type_params, methods),
        _ => return,
    };
    let _ = set_type(
        world,
        instance,
        TypeKind::Named {
            object: instance_data.0,
            underlying: substitute(world, origin_data.0, origin_data.1, instance_data.3),
            type_params: instance_data.2,
            type_args: instance_data.3,
            methods: instance_data.4,
        },
    );
    let methods = instance_data.4;
    for method in origin_data.2 {
        let name = object_name(world, method);
        let mut existing_index = -1;
        for index in 0..methods.len() {
            if object_name(world, methods[index]) == name {
                existing_index = index;
            }
        }
        let instantiated = instantiate_method_object(
            world,
            method,
            origin_data.1,
            instance_data.3,
            instance_data.3,
            instance,
        );
        if existing_index < 0 {
            methods.push(instantiated);
        } else {
            methods[existing_index] = instantiated;
        }
    }
    let _ = set_type(
        world,
        instance,
        TypeKind::Named {
            object: instance_data.0,
            underlying: substitute(world, origin_data.0, origin_data.1, instance_data.3),
            type_params: instance_data.2,
            type_args: instance_data.3,
            methods,
        },
    );
}

fn incomplete_type_parameters(world: World, values: Vec[TypeParameter]) -> bool {
    for value in values {
        if value.constraint.value == world.invalid.value {
            return true
        } else if value.constraint.value < 0 || value.constraint.value >= world.types.len() {
            return true
        }
        match world.types[value.constraint.value].kind {
            TypeKind::Invalid => return true,
            _ => {},
        }
    }
    false
}

pub fn refresh_named_instances(world: World, origin: TypeId) -> () {
    if origin.value < 0 || origin.value >= world.types.len() {
        return
    }
    let origin_data = match world.types[origin.value].kind {
        TypeKind::Named { object, underlying, type_params, type_args: _, methods } => {
            (object, underlying, type_params, methods)
        },
        _ => return,
    };
    let Some(instances) = world.named_instances[origin_data.0.value] else {
        return;
    };
    let instance_count = instances.len();
    if let Some(cached) = world.named_instance_revisions[origin.value] {
        if cached.0 == type_revision(world) && cached.1 == instance_count {
            return
        }
    }
    for instance in instances {
        if instance.value >= 0 && instance.value < world.types.len() {
            match world.types[instance.value].kind {
                TypeKind::Named { object, underlying, type_params, type_args, methods: _ } => if instance.value
                    != origin.value
                    && object.value == origin_data.0.value
                    && (underlying.value == world.invalid.value || underlying.value < 0
                        || underlying.value >= world.types.len()
                        || match world.types[underlying.value].kind {
                            TypeKind::Invalid => true,
                            _ => false,
                        }
                        || incomplete_type_parameters(world, type_params)) {
                    let _ = set_type(
                        world,
                        instance,
                        TypeKind::Named {
                            object,
                            underlying: substitute(world, origin_data.1, origin_data.2, type_args),
                            type_params: origin_data.2,
                            type_args,
                            methods: substitute_objects(
                                world,
                                origin_data.3,
                                origin_data.2,
                                type_args,
                                collections::IndexMap::new(),
                            ),
                        },
                    );
                },
                _ => {},
            }
        }
    }
    world.named_instance_revisions[origin.value] = (type_revision(world), instance_count);
}
