package types;

use gomlgo::syntax;

#[derive(PartialEq, Eq, ToString)]
pub enum BasicKind {
    Invalid,
    Bool,
    Int,
    Int8,
    Int16,
    Int32,
    Int64,
    Uint,
    Uint8,
    Uint16,
    Uint32,
    Uint64,
    Uintptr,
    Float32,
    Float64,
    Complex64,
    Complex128,
    String,
    UnsafePointer,
    UntypedBool,
    UntypedInt,
    UntypedRune,
    UntypedFloat,
    UntypedComplex,
    UntypedString,
    UntypedNil,
}

pub struct Variable {
    pub name: string,
    pub owner: Option[PackageId],
    pub type_id: TypeId,
}

pub struct StructField {
    pub object: Option[ObjectId],
    pub variable: Variable,
    pub embedded: bool,
    pub tag: string,
}

pub struct TypeParameter {
    pub object: ObjectId,
    pub constraint: TypeId,
    pub grouped: bool,
}

pub struct UnionTerm {
    pub tilde: bool,
    pub type_id: TypeId,
}

pub enum TypeKind {
    Invalid,
    Basic {
        basic: BasicKind,
        name: string,
        untyped: bool,
    },
    Array {
        length: i64,
        element: TypeId,
    },
    Slice {
        element: TypeId,
    },
    Struct {
        fields: Vec[StructField],
    },
    Pointer {
        element: TypeId,
    },
    Tuple {
        variables: Vec[Variable],
    },
    Signature {
        receiver: Option[Variable],
        receiver_type_params: Vec[TypeParameter],
        type_params: Vec[TypeParameter],
        params: TypeId,
        results: TypeId,
        variadic: bool,
    },
    Interface {
        methods: Vec[ObjectId],
        embeddeds: Vec[TypeId],
        comparable: bool,
        implicit: bool,
    },
    Map {
        key: TypeId,
        value: TypeId,
    },
    Chan {
        direction: isize,
        element: TypeId,
    },
    Named {
        object: ObjectId,
        underlying: TypeId,
        type_params: Vec[TypeParameter],
        type_args: Vec[TypeId],
        methods: Vec[ObjectId],
    },
    Alias {
        object: ObjectId,
        rhs: TypeId,
        type_params: Vec[TypeParameter],
        type_args: Vec[TypeId],
    },
    TypeParam {
        object: ObjectId,
        constraint: TypeId,
        index: isize,
    },
    Union {
        terms: Vec[UnionTerm],
    },
}

pub struct TypeData {
    pub id: TypeId,
    pub kind: TypeKind,
}

#[derive(PartialEq, Eq, ToString)]
pub enum ObjectKind {
    PackageName,
    Const,
    TypeName,
    Var,
    Func,
    Label,
    Builtin,
    Nil,
}

pub struct Object {
    pub id: ObjectId,
    pub kind: ObjectKind,
    pub name: string,
    pub owner: Option[PackageId],
    pub file: Option[syntax::FileId],
    pub node: Option[syntax::NodeId],
    pub position: isize,
    pub type_id: TypeId,
    pub exported: bool,
    pub constant_kind: string,
    pub constant: Option[string],
    pub imported_package: Option[PackageId],
}

#[derive(PartialEq, Eq)]
pub enum ScopeKind {
    Universe,
    Package,
    File,
    Function,
    Block,
}

pub struct ScopeEntry {
    pub name: string,
    pub object: ObjectId,
}

pub struct Scope {
    pub id: ScopeId,
    pub kind: ScopeKind,
    pub parent: Option[ScopeId],
    pub depth: isize,
    pub file: Option[syntax::FileId],
    pub start: isize,
    pub end: isize,
    pub entries: Vec[ScopeEntry],
    pub entry_objects: HashMap[string, ObjectId],
    pub children: Vec[ScopeId],
}

pub struct Package {
    pub id: PackageId,
    pub path: string,
    pub name: string,
    pub scope: ScopeId,
    pub complete: bool,
}

pub struct BasicTypeEntry {
    pub name: string,
    pub type_id: TypeId,
}

pub struct World {
    pub types: Vec[TypeData],
    pub type_revision: Ref[i32],
    pub named_instances: HashMap[isize, Vec[TypeId]],
    pub named_instance_revisions: HashMap[isize, (i32, isize)],
    pub named_type_objects: Vec[isize],
    pub objects: Vec[Object],
    pub scopes: Vec[Scope],
    pub packages: Vec[Package],
    pub basics: Vec[BasicTypeEntry],
    pub universe: ScopeId,
    pub unsafe_package: PackageId,
    pub invalid: TypeId,
    pub invalid_type_sets: Vec[TypeId],
}
