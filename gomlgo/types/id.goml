package types;

pub struct TypeId {
    pub value: isize,
}

pub struct ObjectId {
    pub value: isize,
}

pub struct ScopeId {
    pub value: isize,
}

pub struct PackageId {
    pub value: isize,
}

pub fn type_id(value: isize) -> TypeId {
    TypeId { value }
}

pub fn object_id(value: isize) -> ObjectId {
    ObjectId { value }
}

pub fn scope_id(value: isize) -> ScopeId {
    ScopeId { value }
}

pub fn package_id(value: isize) -> PackageId {
    PackageId { value }
}
