package types;

const GOARCH_386: string = "386";

const GOARCH_AMD64: string = "amd64";

const GOARCH_AMD64P32: string = "amd64p32";

const GOARCH_ARM: string = "arm";

const GOARCH_ARM64: string = "arm64";

const GOARCH_LOONG64: string = "loong64";

const GOARCH_MIPS: string = "mips";

const GOARCH_MIPS64: string = "mips64";

const GOARCH_MIPS64LE: string = "mips64le";

const GOARCH_MIPSLE: string = "mipsle";

const GOARCH_PPC64: string = "ppc64";

const GOARCH_PPC64LE: string = "ppc64le";

const GOARCH_RISCV64: string = "riscv64";

const GOARCH_S390X: string = "s390x";

const GOARCH_SPARC64: string = "sparc64";

const GOARCH_WASM: string = "wasm";

pub struct TargetSizes {
    pub word_size: i64,
    pub max_align: i64,
}

pub fn gc_sizes(arch: string) -> Option[TargetSizes] {
    match arch {
        GOARCH_386 | GOARCH_ARM | GOARCH_MIPS | GOARCH_MIPSLE => {
            Option::Some(TargetSizes { word_size: 4, max_align: 4 })
        },
        GOARCH_AMD64 | GOARCH_AMD64P32 | GOARCH_ARM64 | GOARCH_LOONG64 | GOARCH_MIPS64 | GOARCH_MIPS64LE | GOARCH_PPC64 | GOARCH_PPC64LE | GOARCH_RISCV64 | GOARCH_S390X | GOARCH_SPARC64 | GOARCH_WASM => Option::Some(
            TargetSizes {
                word_size: match arch {
                    GOARCH_AMD64P32 => 4,
                    _ => 8,
                },
                max_align: 8,
            },
        ),
        _ => Option::None,
    }
}

fn aligned_offset(value: i64, alignment: i64) -> i64 {
    if value < 0 || alignment < 1 || value > 9223372036854775807.to_i64() - alignment + 1 {
        -1
    } else {
        let remainder = value % alignment;
        if remainder == 0 {
            value
        } else {
            value + alignment - remainder
        }
    }
}

fn basic_size(kind: BasicKind, sizes: TargetSizes) -> i64 {
    match kind {
        BasicKind::Bool | BasicKind::Int8 | BasicKind::Uint8 => 1,
        BasicKind::Int16 | BasicKind::Uint16 => 2,
        BasicKind::Int32 | BasicKind::Uint32 | BasicKind::Float32 => 4,
        BasicKind::Int64 | BasicKind::Uint64 | BasicKind::Float64 | BasicKind::Complex64 => 8,
        BasicKind::Complex128 => 16,
        BasicKind::String => sizes.word_size * 2,
        _ => sizes.word_size,
    }
}

fn sync_atomic_align64(world: World, value: TypeId) -> bool {
    match get_type(world, unalias(world, value)) {
        Some(TypeData {
            id: _,
            kind: TypeKind::Named {
                object,
                underlying: _,
                type_params: _,
                type_args: _,
                methods: _,
            },
        }) => match get_object(world, object) {
            Some(object) => match object.owner {
                Some(owner) => object.name == "align64"
                    && (world.packages[owner.value].path == "sync/atomic"
                        || world.packages[owner.value].path == "internal/runtime/atomic"),
                None => false,
            },
            None => false,
        },
        _ => false,
    }
}

fn copied_size_types(values: Vec[TypeId]) -> Vec[TypeId] {
    let result: Vec[TypeId] = Vec::new();
    for value in values {
        result.push(value)
    }
    result
}

fn size_type_seen(values: Vec[TypeId], value: TypeId) -> bool {
    for existing in values {
        if existing.value == value.value {
            return true
        }
    }
    false
}

fn alignof_inner(world: World, value: TypeId, sizes: TargetSizes, visited: Vec[TypeId]) -> i64 {
    match get_type(world, underlying(world, value)) {
        Some(TypeData { id: _, kind: TypeKind::Array { length: _, element } }) => {
            let key = unalias(world, value);
            if size_type_seen(visited, key) {
                sizes.word_size
            } else {
                let next = copied_size_types(visited);
                next.push(key);
                alignof_inner(world, element, sizes, next)
            }
        },
        Some(TypeData { id: _, kind: TypeKind::Struct { fields } }) => {
            let key = unalias(world, value);
            if size_type_seen(visited, key) {
                sizes.word_size
            } else if fields.is_empty() && sync_atomic_align64(world, value) {
                8
            } else {
                let next = copied_size_types(visited);
                next.push(key);
                let mut result = 1.to_i64();
                for field in fields {
                    let alignment = alignof_inner(world, field.variable.type_id, sizes, next);
                    if alignment > result {
                        result = alignment;
                    }
                }
                result
            }
        },
        Some(TypeData { id: _, kind: TypeKind::Slice { element: _ } }) | Some(TypeData {
            id: _,
            kind: TypeKind::Interface { methods: _, embeddeds: _, comparable: _, implicit: _ },
        }) => sizes.word_size,
        Some(TypeData {
            id: _,
            kind: TypeKind::Basic { basic: BasicKind::String, name: _, untyped: _ },
        }) => sizes.word_size,
        Some(TypeData {
            id: _,
            kind: TypeKind::TypeParam { object: _, constraint: _, index: _ } | TypeKind::Union {
                terms: _,
            },
        }) => 1,
        _ => {
            let size = sizeof_inner(world, value, sizes, visited);
            if size < 1 {
                1
            } else {
                let adjusted = match basic_kind(world, value) {
                    Some(BasicKind::Complex64) | Some(BasicKind::Complex128) => size / 2,
                    _ => size,
                };
                if adjusted > sizes.max_align {
                    sizes.max_align
                } else {
                    adjusted
                }
            }
        },
    }
}

pub fn alignof(world: World, value: TypeId, sizes: TargetSizes) -> i64 {
    alignof_inner(world, value, sizes, Vec::new())
}

fn offsets_of_inner(
    world: World,
    fields: Vec[StructField],
    sizes: TargetSizes,
    visited: Vec[TypeId],
) -> Vec[i64] {
    let result: Vec[i64] = Vec::new();
    let mut offset = 0.to_i64();
    for field in fields {
        offset = aligned_offset(
            offset,
            alignof_inner(world, field.variable.type_id, sizes, visited),
        );
        result.push(offset);
        let size = sizeof_inner(world, field.variable.type_id, sizes, visited);
        if offset < 0 || size < 0 || offset > 9223372036854775807.to_i64() - size {
            offset = -1;
        } else {
            offset += size;
        }
    }
    result
}

pub fn offsets_of(world: World, fields: Vec[StructField], sizes: TargetSizes) -> Vec[i64] {
    offsets_of_inner(world, fields, sizes, Vec::new())
}

fn sizeof_inner(world: World, value: TypeId, sizes: TargetSizes, visited: Vec[TypeId]) -> i64 {
    match get_type(world, underlying(world, value)) {
        Some(TypeData { id: _, kind: TypeKind::Basic { basic, name: _, untyped: _ } }) => basic_size(
            basic,
            sizes,
        ),
        Some(TypeData { id: _, kind: TypeKind::Array { length, element } }) => {
            let key = unalias(world, value);
            if size_type_seen(visited, key) {
                sizes.word_size
            } else if length <= 0 {
                0
            } else {
                let next = copied_size_types(visited);
                next.push(key);
                let element_size = sizeof_inner(world, element, sizes, next);
                if element_size < 0
                    || (element_size > 0 && length > 9223372036854775807.to_i64() / element_size) {
                    -1
                } else {
                    element_size * length
                }
            }
        },
        Some(TypeData { id: _, kind: TypeKind::Slice { element: _ } }) => sizes.word_size * 3,
        Some(TypeData { id: _, kind: TypeKind::Struct { fields } }) => {
            let key = unalias(world, value);
            if size_type_seen(visited, key) {
                sizes.word_size
            } else if fields.is_empty() {
                0
            } else {
                let next = copied_size_types(visited);
                next.push(key);
                let offsets = offsets_of_inner(world, fields, sizes, next);
                let last = fields.len() - 1;
                let offset = offsets[last];
                let mut field_size = sizeof_inner(world, fields[last].variable.type_id, sizes, next);
                if offset < 0 || field_size < 0 {
                    -1
                } else {
                    if offset > 0 && field_size == 0 {
                        field_size = 1;
                    }
                    aligned_offset(offset + field_size, alignof_inner(world, value, sizes, visited))
                }
            }
        },
        Some(TypeData {
            id: _,
            kind: TypeKind::Interface { methods: _, embeddeds: _, comparable: _, implicit: _ },
        }) => sizes.word_size * 2,
        Some(TypeData {
            id: _,
            kind: TypeKind::TypeParam { object: _, constraint: _, index: _ } | TypeKind::Union {
                terms: _,
            },
        }) => -1,
        _ => sizes.word_size,
    }
}

pub fn sizeof(world: World, value: TypeId, sizes: TargetSizes) -> i64 {
    sizeof_inner(world, value, sizes, Vec::new())
}
