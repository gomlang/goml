package types;

use std::text;

#[go_ffi("strconv", "Quote")]
extern fn quote_string(value: string) -> string;

fn contains_id(values: Vec[isize], value: isize) -> bool {
    for item in values {
        if item == value {
            return true
        }
    }
    false
}

fn predeclared_any_type(world: World, id: TypeId) -> bool {
    let Some(object) = lookup_local(world, world.universe, "any") else {
        return false;
    };
    match get_object(world, object) {
        Some(value) => if value.type_id.value != id.value {
            false
        } else {
            match get_type(world, id) {
                Some(TypeData {
                    id: _,
                    kind: TypeKind::Alias { object: _, rhs: _, type_params: _, type_args: _ },
                }) => false,
                _ => true,
            }
        },
        None => false,
    }
}

fn package_prefix(world: World, owner: Option[PackageId]) -> string {
    match owner {
        Some(id) => match get_package(world, id) {
            Some(value) => value.path + ".",
            None => "",
        },
        None => "",
    }
}

fn variable_text(world: World, value: Variable, visited: Vec[isize]) -> string {
    let rendered = format_type_inner(world, value.type_id, visited);
    if value.name == "" {
        rendered
    } else {
        value.name + " " + rendered
    }
}

fn tuple_parts(world: World, id: TypeId, visited: Vec[isize]) -> Vec[string] {
    match get_type(world, id) {
        Some(TypeData { id: _, kind: TypeKind::Tuple { variables } }) => {
            let result: Vec[string] = Vec::with_capacity(variables.len());
            for variable in variables {
                result.push(variable_text(world, variable, visited))
            }
            result
        },
        _ => Vec::from_array([format_type_inner(world, id, visited)]),
    }
}

fn parameter_parts(world: World, id: TypeId, visited: Vec[isize], variadic: bool) -> Vec[string] {
    match get_type(world, id) {
        Some(TypeData { id: _, kind: TypeKind::Tuple { variables } }) => {
            let result: Vec[string] = Vec::with_capacity(variables.len());
            for index in 0..variables.len() {
                let variable = variables[index];
                if variadic && index + 1 == variables.len() {
                    match get_type(world, unalias(world, variable.type_id)) {
                        Some(TypeData { id: _, kind: TypeKind::Slice { element } }) => result.push(
                            if variable.name == "" {
                                "..." + format_type_inner(world, element, visited)
                            } else {
                                variable.name + " ..." + format_type_inner(world, element, visited)
                            },
                        ),
                        _ => result.push(
                            if variable.name == "" {
                                format_type_inner(world, variable.type_id, visited) + "..."
                            } else {
                                variable.name + " "
                                    + format_type_inner(world, variable.type_id, visited)
                                    + "..."
                            },
                        ),
                    }
                } else {
                    result.push(variable_text(world, variable, visited))
                }
            }
            result
        },
        _ => tuple_parts(world, id, visited),
    }
}

fn tuple_has_single_named(world: World, id: TypeId) -> bool {
    match get_type(world, id) {
        Some(TypeData { id: _, kind: TypeKind::Tuple { variables } }) => {
            variables.len() == 1 && variables[0].name != ""
        },
        _ => false,
    }
}

fn type_parameter_is_grouped(parameters: Vec[TypeParameter], index: isize) -> bool {
    parameters[index].grouped
        || (index + 1 < parameters.len()
            && parameters[index].constraint.value == parameters[index + 1].constraint.value)
}

fn type_parameter_name(world: World, object: ObjectId) -> string {
    match get_object(world, object) {
        Some(value) => value.name
            + if lookup_local(world, world.universe, value.name).is_some() {
                "/* type parameter */"
            } else {
                ""
            },
        None => "invalid type parameter",
    }
}

fn format_type_inner(world: World, id: TypeId, visited: Vec[isize]) -> string {
    if predeclared_any_type(world, id) {
        return "any"
    }
    if contains_id(visited, id.value) {
        return "<cycle>"
    }
    let next: Vec[isize] = Vec::with_capacity(visited.len() + 1);
    for value in visited {
        next.push(value)
    }
    next.push(id.value);
    match get_type(world, id) {
        None => "invalid type",
        Some(TypeData { id: _, kind }) => match kind {
            TypeKind::Invalid => "invalid type",
            TypeKind::Basic { basic, name, untyped: _ } => if basic == BasicKind::UnsafePointer {
                "unsafe.Pointer"
            } else {
                name
            },
            TypeKind::Array { length, element } => {
                f"[{length}]" + format_type_inner(world, element, next)
            },
            TypeKind::Slice { element } => "[]" + format_type_inner(world, element, next),
            TypeKind::Struct { fields } => {
                let values: Vec[string] = Vec::with_capacity(fields.len());
                for field in fields {
                    let mut value = if field.embedded {
                        format_type_inner(world, field.variable.type_id, next)
                    } else {
                        variable_text(world, field.variable, next)
                    };
                    if field.tag != "" {
                        value += " " + quote_string(field.tag);
                    }
                    values.push(value)
                }
                "struct{" + text::join(values, "; ") + "}"
            },
            TypeKind::Pointer { element } => "*" + format_type_inner(world, element, next),
            TypeKind::Tuple { variables } => {
                let values: Vec[string] = Vec::with_capacity(variables.len());
                for variable in variables {
                    values.push(variable_text(world, variable, next))
                }
                "(" + text::join(values, ", ") + ")"
            },
            TypeKind::Signature {
                receiver: _,
                receiver_type_params: _,
                type_params,
                params,
                results,
                variadic,
            } => {
                let parameter_values = parameter_parts(world, params, next, variadic);
                let result_values = tuple_parts(world, results, next);
                let type_parameter_values: Vec[string] = Vec::new();
                for index in 0..type_params.len() {
                    let parameter = type_params[index];
                    match get_object(world, parameter.object) {
                        Some(_) => type_parameter_values.push(
                            if type_parameter_is_grouped(type_params, index) {
                                type_parameter_name(world, parameter.object)
                            } else {
                                type_parameter_name(world, parameter.object) + " "
                                    + format_type_inner(world, parameter.constraint, next)
                            },
                        ),
                        None => type_parameter_values.push("?"),
                    }
                }
                let type_parameters = if type_parameter_values.is_empty() {
                    ""
                } else {
                    "[" + text::join(type_parameter_values, ", ") + "]"
                };
                let result = if result_values.is_empty() {
                    ""
                } else if result_values.len() == 1 && !tuple_has_single_named(world, results) {
                    " " + result_values[0]
                } else {
                    " (" + text::join(result_values, ", ") + ")"
                };
                "func" + type_parameters + "(" + text::join(parameter_values, ", ") + ")" + result
            },
            TypeKind::Interface { methods, embeddeds, comparable, implicit } => {
                let values: Vec[string] = Vec::new();
                for method in methods {
                    match get_object(world, method) {
                        Some(object) => values.push(
                            object.name
                                + format_type_inner(world, object.type_id, next).byte_slice(
                                    4,
                                    format_type_inner(world, object.type_id, next).byte_len(),
                                ),
                        ),
                        None => {},
                    }
                }
                let mut has_comparable = false;
                for embedded in embeddeds {
                    let value = format_type_inner(world, embedded, next);
                    if value == "comparable" {
                        has_comparable = true;
                    }
                    values.push(value)
                }
                if comparable && !has_comparable {
                    values.push("comparable")
                }
                if implicit {
                    text::join(values, "; ")
                } else {
                    "interface{" + text::join(values, "; ") + "}"
                }
            },
            TypeKind::Map { key, value } => "map[" + format_type_inner(world, key, next) + "]"
                + format_type_inner(world, value, next),
            TypeKind::Chan { direction, element } => {
                let prefix = if direction == 1 {
                    "chan<- "
                } else if direction == 2 {
                    "<-chan "
                } else {
                    "chan "
                };
                prefix + format_type_inner(world, element, next)
            },
            TypeKind::Named { object, underlying: _, type_params, type_args, methods: _ } | TypeKind::Alias {
                object,
                rhs: _,
                type_params,
                type_args,
            } => match get_object(world, object) {
                Some(value) => {
                    let arguments: Vec[string] = Vec::new();
                    for argument in type_args {
                        arguments.push(format_type_inner(world, argument, next))
                    }
                    if arguments.is_empty() {
                        for index in 0..type_params.len() {
                            let parameter = type_params[index];
                            match get_object(world, parameter.object) {
                                Some(_) => arguments.push(
                                    if type_parameter_is_grouped(type_params, index) {
                                        type_parameter_name(world, parameter.object)
                                    } else {
                                        type_parameter_name(world, parameter.object) + " "
                                            + format_type_inner(world, parameter.constraint, next)
                                    },
                                ),
                                None => arguments.push("?"),
                            }
                        }
                    }
                    package_prefix(world, value.owner) + value.name
                        + if arguments.is_empty() {
                            ""
                        } else {
                            "[" + text::join(arguments, ", ") + "]"
                        }
                },
                None => "invalid type",
            },
            TypeKind::TypeParam { object, constraint: _, index: _ } => type_parameter_name(
                world,
                object,
            ),
            TypeKind::Union { terms } => {
                let values: Vec[string] = Vec::new();
                for term in terms {
                    values.push(
                        if term.tilde {
                            "~"
                        } else {
                            ""
                        }
                            + format_type_inner(world, term.type_id, next),
                    )
                }
                text::join(values, " | ")
            },
        },
    }
}

pub fn format_type(world: World, id: TypeId) -> string {
    format_type_inner(world, id, Vec::new())
}

pub fn object_kind_name(value: ObjectKind) -> string {
    let rendered = value.to_string();
    rendered.byte_slice(12, rendered.byte_len())
}
