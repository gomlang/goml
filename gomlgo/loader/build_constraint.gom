package loader;

use std::num;
use std::text;

const GOOS_AIX: string = "aix";

const GOOS_ANDROID: string = "android";

const GOOS_DARWIN: string = "darwin";

const GOOS_DRAGONFLY: string = "dragonfly";

const GOOS_FREEBSD: string = "freebsd";

const GOOS_HURD: string = "hurd";

const GOOS_ILLUMOS: string = "illumos";

const GOOS_IOS: string = "ios";

const GOOS_JS: string = "js";

const GOOS_LINUX: string = "linux";

const GOOS_NETBSD: string = "netbsd";

const GOOS_OPENBSD: string = "openbsd";

const GOOS_PLAN9: string = "plan9";

const GOOS_SOLARIS: string = "solaris";

const GOOS_WASIP1: string = "wasip1";

const GOOS_WINDOWS: string = "windows";

const GOOS_ZOS: string = "zos";

const GOARCH_386: string = "386";

const GOARCH_AMD64: string = "amd64";

const GOARCH_ARM: string = "arm";

const GOARCH_ARM64: string = "arm64";

const GOARCH_LOONG64: string = "loong64";

const GOARCH_MIPS: string = "mips";

const GOARCH_MIPS64: string = "mips64";

const GOARCH_MIPS64LE: string = "mips64le";

const GOARCH_MIPSLE: string = "mipsle";

const GOARCH_PPC64: string = "ppc64";

const GOARCH_PPC64LE: string = "ppc64le";

const GOARCH_RISCV64: string = "riscv64";

const GOARCH_S390X: string = "s390x";

const GOARCH_SPARC64: string = "sparc64";

const GOARCH_WASM: string = "wasm";

const GC_BUILD_TAG: string = "gc";

const CGO_BUILD_TAG: string = "cgo";

const UNIX_BUILD_TAG: string = "unix";

struct ConstraintParser {
    input: string,
    index: Ref[isize],
    valid: Ref[bool],
    goos: string,
    goarch: string,
    cgo: bool,
    go_version: string,
    tags: Vec[string],
}

fn constraint_space(value: byte) -> bool {
    value == b' ' || value == b'\t' || value == b'\r' || value == b'\n'
}

fn skip_constraint_space(parser: ConstraintParser) -> () {
    while parser.index.get() < parser.input.byte_len()
        && constraint_space(parser.input.byte_get(parser.index.get())) {
        parser.index.set(parser.index.get() + 1)
    }
}

fn consume_constraint(parser: ConstraintParser, value: string) -> bool {
    skip_constraint_space(parser);
    let start = parser.index.get();
    if start + value.byte_len() <= parser.input.byte_len()
        && parser.input.byte_slice(start, start + value.byte_len()) == value {
        parser.index.set(start + value.byte_len());
        true
    } else {
        false
    }
}

fn version_minor(value: string) -> isize {
    if value.starts_with("go1.") && value.byte_len() > 4 {
        num::parse_int_structured(value.byte_slice(4, value.byte_len())).unwrap_or(-1)
    } else if value == "go1" {
        0
    } else {
        -1
    }
}

fn unix_goos(value: string) -> bool {
    match value {
        GOOS_AIX | GOOS_ANDROID | GOOS_DARWIN | GOOS_DRAGONFLY | GOOS_FREEBSD | GOOS_HURD | GOOS_ILLUMOS | GOOS_IOS | GOOS_LINUX | GOOS_NETBSD | GOOS_OPENBSD | GOOS_SOLARIS => true,
        _ => false,
    }
}

fn string_tag(values: Vec[string], value: string) -> bool {
    for candidate in values {
        if candidate == value {
            return true
        }
    }
    false
}

fn platform_tag(goos: string, goarch: string, cgo: bool, tags: Vec[string], value: string) -> bool {
    if value == goos || value == goarch {
        true
    } else {
        match (goos, value) {
            (_, GC_BUILD_TAG) => true,
            (_, CGO_BUILD_TAG) => cgo,
            (GOOS_ANDROID, GOOS_LINUX) | (GOOS_ILLUMOS, GOOS_SOLARIS) | (GOOS_IOS, GOOS_DARWIN) => true,
            (_, UNIX_BUILD_TAG) => unix_goos(goos),
            _ => string_tag(tags, value),
        }
    }
}

fn constraint_tag(parser: ConstraintParser, value: string) -> bool {
    if platform_tag(parser.goos, parser.goarch, parser.cgo, parser.tags, value) {
        true
    } else {
        let required = version_minor(value);
        required >= 0 && version_minor(parser.go_version) >= required
    }
}

fn read_constraint_tag(parser: ConstraintParser) -> bool {
    skip_constraint_space(parser);
    let start = parser.index.get();
    while parser.index.get() < parser.input.byte_len() {
        let value = parser.input.byte_get(parser.index.get());
        if constraint_space(value) || value == b'!' || value == b'&' || value == b'|'
            || value == b'('
            || value == b')' {
            break
        } else {
            parser.index.set(parser.index.get() + 1)
        }
    }
    if parser.index.get() == start {
        parser.valid.set(false);
        false
    } else {
        constraint_tag(parser, parser.input.byte_slice(start, parser.index.get()))
    }
}

fn parse_constraint_atom(parser: ConstraintParser) -> bool {
    if consume_constraint(parser, "!") {
        !parse_constraint_atom(parser)
    } else if consume_constraint(parser, "(") {
        let result = parse_constraint_or(parser);
        if !consume_constraint(parser, ")") {
            parser.valid.set(false)
        }
        result
    } else {
        read_constraint_tag(parser)
    }
}

fn parse_constraint_and(parser: ConstraintParser) -> bool {
    let mut result = parse_constraint_atom(parser);
    while consume_constraint(parser, "&&") {
        let right = parse_constraint_atom(parser);
        result = result && right;
    }
    result
}

fn parse_constraint_or(parser: ConstraintParser) -> bool {
    let mut result = parse_constraint_and(parser);
    while consume_constraint(parser, "||") {
        let right = parse_constraint_and(parser);
        result = result || right;
    }
    result
}

fn evaluate_constraint_with_tags(
    value: string,
    goos: string,
    goarch: string,
    cgo: bool,
    go_version: string,
    tags: Vec[string],
) -> bool {
    let expression = text::trim(value);
    let parser = ConstraintParser {
        input: expression,
        index: Ref::new(0),
        valid: Ref::new(true),
        goos,
        goarch,
        cgo,
        go_version,
        tags,
    };
    let result = parse_constraint_or(parser);
    skip_constraint_space(parser);
    parser.valid.get() && parser.index.get() == parser.input.byte_len() && result
}

fn evaluate_plus_build_option(
    value: string,
    goos: string,
    goarch: string,
    cgo: bool,
    go_version: string,
    tags: Vec[string],
) -> bool {
    let terms = text::split(value, ",");
    if terms.is_empty() {
        return false
    }
    for term in terms {
        let term = text::trim(term);
        if term == "" {
            return false
        }
        let negated = term.starts_with("!");
        let name = if negated {
            term.byte_slice(1, term.byte_len())
        } else {
            term
        };
        let selected = platform_tag(goos, goarch, cgo, tags, name)
            || {
                let required = version_minor(name);
                required >= 0 && version_minor(go_version) >= required
            };
        if selected == negated {
            return false
        }
    }
    true
}

fn evaluate_plus_build_constraint(
    value: string,
    goos: string,
    goarch: string,
    cgo: bool,
    go_version: string,
    tags: Vec[string],
) -> bool {
    for option in text::split(text::trim(value), " ") {
        if text::trim(option) != ""
            && evaluate_plus_build_option(option, goos, goarch, cgo, go_version, tags) {
            return true
        }
    }
    false
}
