package loader;

use gomlgo::checker;
use gomlgo::differential;
use gomlgo::types as go_types;
use std::bytes;
use std::env;
use std::path;
use std::testing;

fn source_named(values: Vec[checker::SourceFile], name: string) -> bool {
    for value in values {
        if path::file_name(value.name) == Option::Some(name) {
            return true
        }
    }
    false
}

#[test]
fn imports_sources_from_the_oracle_toolchain() -> () {
    let oracle = testing::expect_ok(
        differential::run_oracle("version", bytes::Bytes::new()),
        "oracle version failed",
    );
    let config = default_config();
    testing::assert_eq(config.source_root_error, "");
    testing::assert_eq(config.source_roots.len(), 1);
    testing::assert_eq(config.source_roots[0], path::join(oracle.goroot, "src"));
    let sources = testing::expect_ok(selected_sources(config, "math"), "standard import failed");
    testing::assert(!sources.is_empty());
    for source in sources {
        testing::assert(source.name.starts_with(path::join(oracle.goroot, "src")))
    }
}

#[test]
fn reports_captured_toolchain_failure_for_missing_imports() -> () {
    let config = default_config();
    config.source_roots = Vec::new();
    config.source_root_error = "gomlgo requires Go 1.26.x, found go1.25.7";
    let result = testing::expect_ok(
        check_sources_with_diagnostics(
            config,
            "example/p",
            Vec::from_array(
                [
                    checker::SourceFile {
                        name: "p.go",
                        source: bytes::Bytes::from_string(
                            "package p\nimport \"math\"\nvar X = math.Pi\n",
                        ),
                    },
                ],
            ),
        ),
        "toolchain failure must produce diagnostics",
    );
    testing::assert(!result.diagnostics.is_empty());
    testing::assert(result.diagnostics[0].message.contains(config.source_root_error));
    testing::assert_eq(
        testing::expect_err(check_import_path(config, "math"), "missing toolchain must fail"),
        config.source_root_error,
    )
}

#[test]
fn loads_source_dependencies_with_platform_selection() -> () {
    let config = default_config();
    config.source_roots = Vec::from_array(
        [path::join(env::current_dir_structured().unwrap_or("."), "testdata/loader")],
    );
    let result = testing::expect_ok(check_import_path(config, "example/p"), "source import failed");
    testing::assert_eq(result.diagnostics.len(), 0);
    let mut dependency: Option[go_types::PackageId] = Option::None;
    for pkg in result.world.packages {
        if pkg.path == "example/q" {
            dependency = Option::Some(pkg.id);
        }
    }
    let dependency = testing::expect_some(dependency, "missing source dependency");
    testing::assert(result.world.packages[dependency.value].complete);
    for pkg in result.world.packages {
        testing::assert(pkg.path != "example/r")
    }
    testing::assert(
        go_types::lookup_local(result.world, result.world.packages[dependency.value].scope, "Linux").is_some(),
    );
    testing::assert(
        go_types::lookup_local(
            result.world,
            result.world.packages[dependency.value].scope,
            "Windows",
        ).is_none(),
    )
}

#[test]
fn evaluates_go_build_boolean_constraints() -> () {
    testing::assert(
        evaluate_constraint("linux && amd64 && !cgo && go1.26", "linux", "amd64", false, "go1.26"),
    );
    testing::assert(
        !evaluate_constraint("windows || cgo || go1.27", "linux", "amd64", false, "go1.26"),
    )
}

#[test]
fn evaluates_plus_build_and_custom_constraints() -> () {
    testing::assert(
        evaluate_plus_build_constraint(
            "linux,amd64 windows",
            "linux",
            "amd64",
            false,
            "go1.26",
            Vec::new(),
        ),
    );
    testing::assert(
        !evaluate_plus_build_constraint(
            "linux,!amd64 windows",
            "linux",
            "amd64",
            false,
            "go1.26",
            Vec::new(),
        ),
    );
    testing::assert(
        evaluate_constraint_with_tags(
            "android && linux && custom",
            "android",
            "arm64",
            false,
            "go1.26",
            Vec::from_array(["custom"]),
        ),
    );
    let config = default_config();
    let mut randomized = false;
    let mut green_tea = false;
    for tag in config.tags {
        if tag == "goexperiment.randomizedheapbase64" {
            randomized = true;
        } else if tag == "goexperiment.greenteagc" {
            green_tea = true;
        }
    }
    testing::assert(randomized);
    testing::assert(green_tea)
}

#[test]
fn selects_target_cgo_and_test_package_variants() -> () {
    let config = default_config();
    config.source_roots = Vec::from_array(
        [path::join(env::current_dir_structured().unwrap_or("."), "testdata/loader")],
    );
    let linux_amd64 = testing::expect_ok(
        selected_sources(config, "example/q"),
        "linux amd64 selection failed",
    );
    testing::assert(source_named(linux_amd64, "q_linux.go"));
    testing::assert(source_named(linux_amd64, "q_linux_amd64.go"));
    testing::assert(!source_named(linux_amd64, "q_linux_arm64.go"));
    testing::assert(!source_named(linux_amd64, "q_cgo.go"));
    testing::assert(!source_named(linux_amd64, "q_internal_test.go"));
    config.goarch = "arm64";
    config.checker_config.sizes = testing::expect_some(
        go_types::gc_sizes("arm64"),
        "missing arm64 sizes",
    );
    let linux_arm64 = testing::expect_ok(
        selected_sources(config, "example/q"),
        "linux arm64 selection failed",
    );
    testing::assert(source_named(linux_arm64, "q_linux_arm64.go"));
    testing::assert(!source_named(linux_arm64, "q_linux_amd64.go"));
    config.goarch = "amd64";
    config.cgo = true;
    let cgo = testing::expect_ok(selected_sources(config, "example/q"), "cgo selection failed");
    testing::assert(source_named(cgo, "q_cgo.go"));
    config.cgo = false;
    config.include_tests = true;
    let internal = testing::expect_ok(
        selected_sources(config, "example/q"),
        "internal test selection failed",
    );
    testing::assert(source_named(internal, "q_internal_test.go"));
    testing::assert(!source_named(internal, "q_external_test.go"));
    config.external_tests = true;
    let external = testing::expect_ok(
        selected_sources(config, "example/q"),
        "external test selection failed",
    );
    testing::assert_eq(external.len(), 1);
    testing::assert(source_named(external, "q_external_test.go"))
}

#[test]
fn checks_internal_and_external_test_packages_separately() -> () {
    let selection = default_config();
    selection.source_roots = Vec::from_array(
        [path::join(env::current_dir_structured().unwrap_or("."), "testdata/loader")],
    );
    selection.include_tests = true;
    let internal_sources = testing::expect_ok(
        selected_sources(selection, "example/q"),
        "internal sources failed",
    );
    let check_config = default_config();
    check_config.source_roots = selection.source_roots;
    let internal = testing::expect_ok(
        check_sources(check_config, "example/q", internal_sources),
        "internal test package failed",
    );
    testing::assert_eq(internal.diagnostics.len(), 0);
    selection.external_tests = true;
    let external_sources = testing::expect_ok(
        selected_sources(selection, "example/q"),
        "external sources failed",
    );
    let external = testing::expect_ok(
        check_sources(check_config, "example/q_test", external_sources),
        "external test package failed",
    );
    testing::assert_eq(external.diagnostics.len(), 0);
    testing::assert_eq(external.world.packages[external.package_id.value].name, "q_test")
}
