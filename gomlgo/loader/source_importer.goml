package loader;

use gomlgo::checker;
use gomlgo::constant;
use gomlgo::scanner;
use gomlgo::syntax;
use gomlgo::toolchain;
use gomlgo::types as go_types;
use std::bytes;
use std::collections;
use std::env;
use std::fs;
use std::path;
use std::text;
use std::unicode;
use std::utf8;
use utf8::BytesUtf8;

pub struct LoadConfig {
    pub checker_config: checker::CheckConfig,
    pub source_roots: Vec[string],
    pub source_root_error: string,
    pub goos: string,
    pub goarch: string,
    pub cgo: bool,
    pub tags: Vec[string],
    pub include_tests: bool,
    pub external_tests: bool,
    pub root_path: string,
    pub root_directory: string,
    pub root_sources: Vec[checker::SourceFile],
}

struct LoadState {
    config: LoadConfig,
    world: go_types::World,
    loading: Vec[string],
    loaded: collections::IndexMap[string, LoadedPackage],
    retain_info: bool,
    source_cache: HashMap[string, Vec[checker::SourceFile]],
}

struct LoadedPackage {
    failure: string,
    info: Option[LoadedInfo],
}

struct LoadedInfo {
    syntax: syntax::PackageSyntax,
    package_id: go_types::PackageId,
    info: checker::TypeInfo,
    diagnostics: Vec[checker::CheckDiagnostic],
}

pub struct LoadSession {
    state: LoadState,
}

pub fn default_config() -> LoadConfig {
    let source_root = toolchain::source_root();
    LoadConfig {
        checker_config: checker::default_config(),
        source_roots: match source_root {
            Ok(root) => Vec::from_array([root]),
            Err(_) => Vec::new(),
        },
        source_root_error: match source_root {
            Ok(_) => "",
            Err(message) => message,
        },
        goos: GOOS_LINUX,
        goarch: GOARCH_AMD64,
        cgo: false,
        tags: Vec::from_array(
            [
                "goexperiment.dwarf5",
                "goexperiment.greenteagc",
                "goexperiment.randomizedheapbase64",
                "goexperiment.regabiargs",
                "goexperiment.regabiwrappers",
            ],
        ),
        include_tests: false,
        external_tests: false,
        root_path: "",
        root_directory: "",
        root_sources: Vec::new(),
    }
}

fn known_goos(value: string) -> bool {
    match value {
        GOOS_AIX | GOOS_ANDROID | GOOS_DARWIN | GOOS_DRAGONFLY | GOOS_FREEBSD | GOOS_HURD | GOOS_ILLUMOS | GOOS_IOS | GOOS_JS | GOOS_LINUX | GOOS_NETBSD | GOOS_OPENBSD | GOOS_PLAN9 | GOOS_SOLARIS | GOOS_WASIP1 | GOOS_WINDOWS | GOOS_ZOS => true,
        _ => false,
    }
}

fn known_goarch(value: string) -> bool {
    match value {
        GOARCH_386 | GOARCH_AMD64 | GOARCH_ARM | GOARCH_ARM64 | GOARCH_LOONG64 | GOARCH_MIPS | GOARCH_MIPS64 | GOARCH_MIPS64LE | GOARCH_MIPSLE | GOARCH_PPC64 | GOARCH_PPC64LE | GOARCH_RISCV64 | GOARCH_S390X | GOARCH_SPARC64 | GOARCH_WASM => true,
        _ => false,
    }
}

fn filename_selected(name: string, config: LoadConfig) -> bool {
    if name.starts_with(".") || name.starts_with("_")
        || (!config.include_tests && name.ends_with("_test.go"))
        || path::extension(name) != Option::Some("go") {
        return false
    }
    let stem = name.byte_slice(0, name.byte_len() - 3);
    let parts = text::split(stem, "_");
    if parts.len() >= 2 {
        let last = parts[parts.len() - 1];
        if known_goos(last)
            && !platform_tag(config.goos, config.goarch, config.cgo, config.tags, last) {
            return false
        } else if known_goarch(last) && last != config.goarch {
            return false
        }
    }
    if parts.len() >= 3 {
        let system = parts[parts.len() - 2];
        let architecture = parts[parts.len() - 1];
        if known_goos(system) && known_goarch(architecture)
            && (!platform_tag(config.goos, config.goarch, config.cgo, config.tags, system)
                || architecture != config.goarch) {
            return false
        }
    }
    true
}

fn source_constraint_selected(source: bytes::Bytes, config: LoadConfig) -> bool {
    let mut go_build: Option[string] = Option::None;
    let plus_build_constraints: Vec[string] = Vec::new();
    for value in scanner::leading_comments(source) {
        if value.starts_with("//go:build") {
            let start = "//go:build".byte_len();
            go_build = Option::Some(value.byte_slice(start, value.byte_len()));
        } else if value.starts_with("// +build") {
            let start = "// +build".byte_len();
            plus_build_constraints.push(value.byte_slice(start, value.byte_len()));
        }
    }
    match go_build {
        Some(value) => evaluate_constraint_with_tags(
            value,
            config.goos,
            config.goarch,
            config.cgo,
            config.checker_config.go_version,
            config.tags,
        ),
        None => {
            for value in plus_build_constraints {
                if !evaluate_plus_build_constraint(
                    value,
                    config.goos,
                    config.goarch,
                    config.cgo,
                    config.checker_config.go_version,
                    config.tags,
                ) {
                    return false
                }
            }
            true
        },
    }
}

fn source_package_name(source: checker::SourceFile) -> string {
    scanner::package_name_bytes(source.source)
}

fn test_source(value: checker::SourceFile) -> bool {
    path::file_name(value.name).unwrap_or("").ends_with("_test.go")
}

fn package_directory(config: LoadConfig, import_path: string) -> Option[string] {
    if import_path == config.root_path && config.root_directory != "" {
        return Option::Some(config.root_directory)
    }
    for root in config.source_roots {
        let directory = path::join(root, import_path);
        if fs::is_dir(directory) {
            return Option::Some(directory)
        }
        let vendor_directory = path::join(path::join(root, "vendor"), import_path);
        if fs::is_dir(vendor_directory) {
            return Option::Some(vendor_directory)
        }
        let command_vendor_directory = path::join(
            path::join(path::join(root, "cmd"), "vendor"),
            import_path,
        );
        if fs::is_dir(command_vendor_directory) {
            return Option::Some(command_vendor_directory)
        }
    }
    Option::None
}

fn resolved_package_path(config: LoadConfig, import_path: string) -> string {
    for root in config.source_roots {
        if fs::is_dir(path::join(root, import_path)) {
            return import_path
        } else if fs::is_dir(path::join(path::join(root, "vendor"), import_path)) {
            return "vendor/" + import_path
        } else if fs::is_dir(path::join(path::join(path::join(root, "cmd"), "vendor"), import_path)) {
            return "cmd/vendor/" + import_path
        }
    }
    import_path
}

fn missing_import_message(config: LoadConfig, import_path: string) -> string {
    if import_path.starts_with("/") {
        return "can't find import: \"" + import_path + "\": stat " + import_path
            + ".a: no such file or directory"
    }
    let goroot_source = if config.source_roots.is_empty() {
        ""
    } else {
        config.source_roots[0]
    };
    let gopath = env::var_structured("GOPATH").unwrap_or(
        path::join(env::var_structured("HOME").unwrap_or(""), "go"),
    );
    "can't find import: \"" + import_path + "\": cannot find package \"" + import_path
        + "\" in any of:\n\t"
        + path::join(goroot_source, import_path)
        + " (from $GOROOT)\n\t"
        + path::join(path::join(gopath, "src"), import_path)
        + " (from $GOPATH)"
}

pub fn selected_sources(config: LoadConfig, import_path: string) -> Result[
    Vec[checker::SourceFile],
    string,
] {
    if import_path == config.root_path && !config.root_sources.is_empty() {
        return Result::Ok(config.root_sources)
    }
    let directory = package_directory(config, import_path).ok_or(
        if config.source_roots.is_empty() && config.source_root_error != "" {
            config.source_root_error
        } else {
            "package not found: " + import_path
        },
    )?;
    let names = fs::read_dir(directory).map_err(|error| error.to_string())?;
    collections::sort(names);
    let selected: Vec[checker::SourceFile] = Vec::new();
    for name in names {
        if filename_selected(name, config) {
            let file = path::join(directory, name);
            let source = fs::read_bytes_structured(file).map_err(|message| message.to_string())?;
            if source_constraint_selected(source, config) {
                selected.push(checker::SourceFile { name: file, source })
            }
        }
    }
    let result: Vec[checker::SourceFile] = Vec::new();
    if config.include_tests {
        let mut package_name = "";
        for source in selected {
            if !test_source(source) && package_name == "" {
                package_name = source_package_name(source);
            }
        }
        for source in selected {
            let test = test_source(source);
            let external = test && source_package_name(source) != package_name;
            if (config.external_tests && external)
                || (!config.external_tests && (!test || !external)) {
                result.push(source)
            }
        }
    } else {
        for source in selected {
            result.push(source)
        }
    }
    if result.is_empty() {
        Result::Err("no buildable Go source files for " + import_path)
    } else {
        Result::Ok(result)
    }
}

fn source_imports(source: checker::SourceFile) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    for literal in scanner::import_literals(source.source) {
        match constant::parse_string_literal(literal) {
            Ok(constant::ConstValue::String(value)) => if valid_import_dependency(value) {
                result.push(value)
            },
            _ => {},
        }
    }
    result
}

fn selected_sources_cached(state: LoadState, import_path: string) -> Result[
    Vec[checker::SourceFile],
    string,
] {
    match state.source_cache[import_path] {
        Some(sources) => Result::Ok(sources),
        None => {
            let sources = selected_sources(state.config, import_path)?;
            state.source_cache[import_path] = sources;
            Result::Ok(sources)
        },
    }
}

fn package_name_from_sources(sources: Vec[checker::SourceFile], import_path: string) -> string {
    for source in sources {
        let name = source_package_name(source);
        if name != "" {
            return name
        }
    }
    let parts = text::split(import_path, "/");
    parts[parts.len() - 1]
}

fn discovered_import_used(result: checker::CheckResult, import_path: string) -> bool {
    for fact in result.info.uses {
        match fact.object {
            Some(object_id) => {
                let object = result.world.objects[object_id.value];
                match object.imported_package {
                    Some(package_id) => if object.kind == go_types::ObjectKind::PackageName
                        && result.world.packages[package_id.value].path == import_path {
                        return true
                    },
                    None => {},
                }
            },
            None => {},
        }
    }
    for fact in result.info.defs {
        match fact.object {
            Some(object_id) => {
                let object = result.world.objects[object_id.value];
                match object.imported_package {
                    Some(package_id) => if object.kind == go_types::ObjectKind::PackageName
                        && object.name == "."
                        && result.world.packages[package_id.value].path == import_path {
                        return true
                    },
                    None => {},
                }
            },
            None => {},
        }
    }
    false
}

fn discover_api_imports(
    state: LoadState,
    import_path: string,
    sources: Vec[checker::SourceFile],
    imports: collections::IndexSet[string],
) -> Result[collections::IndexSet[string], string] {
    let config = state.config.checker_config;
    config.go_version = "go1.26";
    config.ignore_func_bodies = true;
    config.exported_api_only = true;
    config.disable_unused_import_check = true;
    config.available_imports = Vec::new();
    config.ignored_imports = Vec::new();
    config.import_errors = Vec::new();
    for dependency in imports {
        if dependency != "unsafe"
            && !(dependency == "C" && state.config.checker_config.fake_import_c) {
            let dependency_sources = selected_sources_cached(state, dependency)?;
            config.available_imports.push(
                checker::AvailableImport {
                    path: dependency,
                    name: package_name_from_sources(dependency_sources, dependency),
                },
            )
        }
    }
    let checked = checker::check_package(
        config,
        checker::PackageInput {
            path: resolved_package_path(state.config, import_path),
            files: sources,
        },
    );
    let result: collections::IndexSet[string] = collections::IndexSet::new();
    for dependency in imports {
        if discovered_import_used(checked, dependency) {
            let _ = result.insert(dependency);
        }
    }
    Result::Ok(result)
}

fn valid_import_dependency(value: string) -> bool {
    let illegal = "!\"#$%&'()*,:;<=>?[\\]^{|}`�";
    if value == "" {
        return false
    }
    for character in value.chars() {
        if unicode::is_control(character) || unicode::is_whitespace(character)
            || illegal.contains(character.to_string()) {
            return false
        }
    }
    true
}

fn string_in(values: Vec[string], value: string) -> bool {
    for existing in values {
        if existing == value {
            return true
        }
    }
    false
}

fn checker_failure(result: checker::CheckResult) -> string {
    if result.diagnostics.is_empty() {
        "type checking failed"
    } else {
        f"{result.diagnostics[0].file}:{result.diagnostics[0].start}: {result.diagnostics[0].message}"
    }
}

fn load_package(state: LoadState, import_path: string, allow_diagnostics: bool) -> Result[
    checker::CheckResult,
    string,
] {
    if string_in(state.loading, import_path) {
        return Result::Err("import cycle not allowed: " + import_path)
    } else if import_path == "unsafe" {
        return Result::Err("unsafe is built in")
    }
    state.loading.push(import_path);
    let sources = selected_sources_cached(state, import_path)?;
    let imports: collections::IndexSet[string] = collections::IndexSet::new();
    for source in sources {
        for dependency in source_imports(source) {
            if dependency != "unsafe"
                && !(dependency == "C" && state.config.checker_config.fake_import_c)
                && imports.insert(dependency) {}
        }
    }
    let api_only = state.config.root_path != "" && import_path != state.config.root_path;
    let selected_imports = if api_only {
        discover_api_imports(state, import_path, sources, imports)?
    } else {
        imports
    };
    for dependency in selected_imports {
        if !state.loaded.contains(dependency) {
            match load_package(state, dependency, false) {
                Ok(checked) => {
                    state.world = checked.world;
                },
                Err(message) => if !allow_diagnostics {
                    return Result::Err(message)
                } else {
                    state.config.checker_config.import_errors.push(
                        checker::ImportFailure {
                            path: dependency,
                            message: if message.starts_with("package not found: ") {
                                missing_import_message(state.config, dependency)
                            } else {
                                message
                            },
                        },
                    )
                },
            }
        }
    }
    let checker_config = state.config.checker_config;
    if api_only {
        checker_config.go_version = "go1.26";
        checker_config.ignore_func_bodies = true;
        checker_config.exported_api_only = true;
        checker_config.disable_unused_import_check = true;
        checker_config.ignored_imports = Vec::new();
        for dependency in imports {
            if !selected_imports.contains(dependency) {
                checker_config.ignored_imports.push(dependency)
            }
        }
    }
    let result = checker::check_package_in_world(
        checker_config,
        checker::PackageInput {
            path: resolved_package_path(state.config, import_path),
            files: sources,
        },
        state.world,
    );
    state.world = result.world;
    let _ = state.loading.pop();
    let failure = if result.diagnostics.is_empty() {
        ""
    } else {
        checker_failure(result)
    };
    let _ = state.loaded.insert(
        import_path,
        LoadedPackage {
            failure,
            info: if state.retain_info {
                Option::Some(
                    LoadedInfo {
                        syntax: result.syntax,
                        package_id: result.package_id,
                        info: result.info,
                        diagnostics: result.diagnostics,
                    },
                )
            } else {
                Option::None
            },
        },
    );
    if result.diagnostics.is_empty() || allow_diagnostics {
        Result::Ok(result)
    } else {
        Result::Err(checker_failure(result))
    }
}

pub fn new_load_session(config: LoadConfig) -> LoadSession {
    LoadSession {
        state: LoadState {
            config,
            world: go_types::new_world(),
            loading: Vec::new(),
            loaded: collections::IndexMap::new(),
            retain_info: false,
            source_cache: HashMap::new(),
        },
    }
}

pub fn new_info_load_session(config: LoadConfig) -> LoadSession {
    LoadSession {
        state: LoadState {
            config,
            world: go_types::new_world(),
            loading: Vec::new(),
            loaded: collections::IndexMap::new(),
            retain_info: true,
            source_cache: HashMap::new(),
        },
    }
}

pub fn check_import_path_acceptance_in_session(session: LoadSession, import_path: string) -> Result[
    (),
    string,
] {
    match session.state.loaded.get(import_path) {
        Some(package_value) => if package_value.failure == "" {
            Result::Ok(())
        } else {
            Result::Err(package_value.failure)
        },
        None => load_package(session.state, import_path, false).map(|_| ()),
    }
}

pub fn check_import_path_info_in_session(session: LoadSession, import_path: string) -> Result[
    checker::CheckResult,
    string,
] {
    match session.state.loaded.get(import_path) {
        None => load_package(session.state, import_path, false),
        Some(package_value) => match package_value.info {
            Some(info) => if info.diagnostics.is_empty() {
                Result::Ok(
                    checker::CheckResult {
                        world: session.state.world,
                        syntax: info.syntax,
                        package_id: info.package_id,
                        info: info.info,
                        diagnostics: info.diagnostics,
                    },
                )
            } else {
                Result::Err(package_value.failure)
            },
            None => Result::Err("package info not retained: " + import_path),
        },
    }
}

pub fn check_import_path(config: LoadConfig, import_path: string) -> Result[
    checker::CheckResult,
    string,
] {
    if config.root_path == "" {
        config.root_path = import_path;
    }
    let state = LoadState {
        config,
        world: go_types::new_world(),
        loading: Vec::new(),
        loaded: collections::IndexMap::new(),
        retain_info: false,
        source_cache: HashMap::new(),
    };
    load_package(state, import_path, false)
}

pub fn check_sources_with_diagnostics(
    config: LoadConfig,
    import_path: string,
    sources: Vec[checker::SourceFile],
) -> Result[checker::CheckResult, string] {
    for source in sources {
        match source.source.to_string_utf8() {
            Ok(value) => {
                if value.contains("// -fakeImportC") {
                    config.checker_config.fake_import_c = true;
                }
                if value.contains("// -gotypesalias=0") {
                    config.checker_config.enable_alias = false;
                } else if value.contains("// -gotypesalias=1") {
                    config.checker_config.enable_alias = true;
                }
                for line in text::split(value, "\n") {
                    if line.starts_with("// -lang=") {
                        config.checker_config.go_version = text::split(
                            line.byte_slice(9, line.byte_len()),
                            " ",
                        )[0];
                    }
                }
            },
            Err(_) => {},
        }
    }
    config.root_path = import_path;
    config.root_sources = sources;
    let state = LoadState {
        config,
        world: go_types::new_world(),
        loading: Vec::new(),
        loaded: collections::IndexMap::new(),
        retain_info: false,
        source_cache: HashMap::new(),
    };
    load_package(state, import_path, true)
}

pub fn check_sources(config: LoadConfig, import_path: string, sources: Vec[checker::SourceFile]) -> Result[
    checker::CheckResult,
    string,
] {
    config.root_path = import_path;
    config.root_sources = sources;
    check_import_path(config, import_path)
}

pub fn check_directory(config: LoadConfig, import_path: string, directory: string) -> Result[
    checker::CheckResult,
    string,
] {
    config.root_path = import_path;
    config.root_directory = directory;
    check_import_path(config, import_path)
}
