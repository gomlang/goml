package main;

use gomlgo::scanner_diff;
use gomlgo::toolchain;
use std::env;
use std::process;

fn main() -> () {
    let arguments = env::args();
    let root = if arguments.len() == 2 {
        arguments[1]
    } else {
        match toolchain::source_root() {
            Ok(root) => root,
            Err(message) => {
                println(message);
                process::exit(1);
                ""
            },
        }
    };
    match scanner_diff::compare_tree(root) {
        Ok(summary) => println(f"scanner zero diff: files={summary.files} tokens={summary.tokens}"),
        Err(message) => {
            println(message);
            process::exit(1)
        },
    }
}
