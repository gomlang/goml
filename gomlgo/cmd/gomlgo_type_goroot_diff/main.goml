package main;

use gomlgo::goroot_compare;
use gomlgo::toolchain;
use std::env;
use std::num;
use std::process;

const CGO_ENABLED: string = "1";

const CGO_DISABLED: string = "0";

fn main() -> () {
    let arguments = env::args();
    let mode = if arguments.len() >= 2 {
        goroot_compare::mode_from_string(arguments[1]).unwrap_or(
            goroot_compare::CompareMode::Acceptance,
        )
    } else {
        goroot_compare::CompareMode::Acceptance
    };
    let scope = if arguments.len() >= 3 {
        arguments[2]
    } else {
        goroot_compare::STD_SCOPE
    };
    if !goroot_compare::valid_scope(scope) {
        println("scope must be std, cmd, or all");
        process::exit(1)
    }
    let limit = if arguments.len() >= 4 {
        match num::parse_int_structured(arguments[3]) {
            Ok(value) => value,
            Err(message) => {
                println(message);
                process::exit(1);
                -1
            },
        }
    } else {
        -1
    };
    let root = if arguments.len() >= 5 {
        arguments[4]
    } else {
        match toolchain::source_root() {
            Ok(root) => root,
            Err(message) => {
                println(message);
                process::exit(1);
                ""
            },
        }
    };
    let start = if arguments.len() >= 6 {
        arguments[5]
    } else {
        ""
    };
    let goos = if arguments.len() >= 7 {
        arguments[6]
    } else {
        "linux"
    };
    let goarch = if arguments.len() >= 8 {
        arguments[7]
    } else {
        "amd64"
    };
    let cgo = if arguments.len() >= 9 {
        match arguments[8] {
            CGO_ENABLED => true,
            CGO_DISABLED => false,
            _ => {
                println("CGO_ENABLED must be 0 or 1");
                process::exit(1);
                false
            },
        }
    } else {
        false
    };
    let test_mode = if arguments.len() >= 10 {
        arguments[9]
    } else {
        goroot_compare::NO_TEST_MODE
    };
    if !goroot_compare::valid_test_mode(test_mode) {
        println("test mode must be none, internal, or external");
        process::exit(1)
    }
    if arguments.len() > 10 {
        println(
            "usage: gomlgo_type_goroot_diff [acceptance|info] [std|cmd|all] [LIMIT] [GOROOT_SRC] [START] [GOOS] [GOARCH] [CGO_ENABLED] [none|internal|external]",
        );
        process::exit(1)
    }
    match goroot_compare::compare(root, scope, limit, start, mode, goos, goarch, cgo, test_mode) {
        Ok(summary) => println(
            f"GOROOT type-check differential: packages={summary.packages}"
                + f" accepted={summary.accepted} rejected={summary.rejected} info_compared={summary.info_compared}",
        ),
        Err(message) => {
            println(message);
            process::exit(1)
        },
    }
}
