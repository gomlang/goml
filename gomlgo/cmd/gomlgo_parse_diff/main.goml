package main;

use gomlgo::parser_diff;
use gomlgo::toolchain;
use std::env;
use std::process;

fn main() -> () {
    let arguments = env::args();
    let mode = if arguments.len() >= 2 {
        parser_diff::mode_from_string(arguments[1]).unwrap_or(parser_diff::Mode::Acceptance)
    } else {
        parser_diff::Mode::Acceptance
    };
    let root = if arguments.len() == 3 {
        arguments[2]
    } else if arguments.len() == 2 && parser_diff::mode_from_string(arguments[1]).is_none() {
        arguments[1]
    } else {
        match toolchain::source_root() {
            Ok(root) => root,
            Err(message) => {
                println(message);
                process::exit(1);
                ""
            },
        }
    };
    if arguments.len() > 3 {
        println(
            "usage: gomlgo_parse_diff [parse-acceptance|ast-shape|ast-position|ast-comments|diagnostic-strict] [ROOT]",
        );
        process::exit(1)
    }
    match parser_diff::compare_tree(root, mode) {
        Ok(summary) => println(
            parser_diff::mode_name(mode)
                + f" zero diff: files={summary.files} accepted={summary.accepted}",
        ),
        Err(message) => {
            println(message);
            process::exit(1)
        },
    }
}
