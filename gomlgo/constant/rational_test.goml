package constant;

use std::testing;

fn make_rational(numerator: string, denominator: string) -> BigRat {
    testing::expect_ok(
        rational_new(parse_integer(numerator), parse_natural(denominator)),
        "failed to construct rational",
    )
}

#[test]
fn rational_values_are_normalized() -> () {
    testing::assert_eq(rational_to_string(make_rational("42", "126")), "1/3");
    testing::assert_eq(rational_to_string(make_rational("-42", "126")), "-1/3")
}

#[test]
fn rational_arithmetic_is_exact() -> () {
    let one_sixth = make_rational("1", "6");
    let one_third = make_rational("1", "3");
    testing::assert_eq(rational_to_string(rational_add(one_sixth, one_third)), "1/2");
    testing::assert_eq(rational_to_string(rational_sub(one_sixth, one_third)), "-1/6");
    testing::assert_eq(rational_to_string(rational_mul(one_sixth, one_third)), "1/18");
    testing::assert_eq(
        rational_to_string(
            testing::expect_ok(rational_div(one_sixth, one_third), "rational division failed"),
        ),
        "1/2",
    )
}

#[test]
fn rational_comparison_cross_multiplies_exactly() -> () {
    testing::assert(rational_compare(make_rational("1", "3"), make_rational("2", "5")) < 0);
    testing::assert_eq(rational_compare(make_rational("6", "9"), make_rational("2", "3")), 0)
}
