package constant;

use gomlgo::typecheck_diff;
use std::testing;

fn exact(value: Result[ConstValue, string]) -> string {
    constant_exact_string(testing::expect_ok(value, "failed to parse literal"))
}

fn oracle_exact(expression: string) -> string {
    let response = testing::expect_ok(
        typecheck_diff::run_constant(
            typecheck_diff::ConstantRequest { expression, go_version: "go1.26" },
        ),
        "constant oracle failed",
    );
    if !response.ok {
        testing::fail("constant oracle rejected expression");
    }
    match response.value {
        Some(value) => value.exact,
        None => {
            testing::fail("constant oracle omitted its value");
            loop {}
        },
    }
}

#[test]
fn parses_decimal_and_hexadecimal_floats_exactly() -> () {
    testing::assert_eq(exact(parse_float_literal("1.25")), "5/4");
    testing::assert_eq(exact(parse_float_literal("12.5e-1")), "5/4");
    testing::assert_eq(exact(parse_float_literal("1e3")), "1000");
    testing::assert_eq(exact(parse_float_literal("1e-3")), "1/1000");
    testing::assert_eq(exact(parse_float_literal("0x1.fp3")), "31/2");
    testing::assert_eq(exact(parse_float_literal("0X.8P-1")), "1/4")
}

#[test]
fn numeric_literals_match_the_go_constant_oracle() -> () {
    testing::assert_eq(exact(parse_float_literal("1.25")), oracle_exact("1.25"));
    testing::assert_eq(exact(parse_float_literal("0x1.fp3")), oracle_exact("0x1.fp3"));
    testing::assert_eq(exact(parse_imaginary_literal("1.5i")), oracle_exact("1.5i"))
}

#[test]
fn integer_based_imaginary_literals_match_the_go_constant_oracle() -> () {
    for value in Vec::from_array(["0b111i", "0o567i", "0xabci"]) {
        testing::assert_eq(exact(parse_imaginary_literal(value)), oracle_exact(value))
    }
}

#[test]
fn parses_large_floats_with_go_constant_precision() -> () {
    for value in Vec::from_array(
        ["1e5000", "1e-5000", "1.23456789e5000", "0x1p5000", "1e646456992", "1e-646456992"],
    ) {
        let parsed = match parse_float_literal(value) {
            Ok(value) => value,
            Err(error) => {
                testing::fail(value + ": " + error);
                loop {}
            },
        };
        testing::assert_eq(constant_exact_string(parsed), oracle_exact(value))
    }
}

#[test]
fn parses_interpreted_and_raw_strings() -> () {
    match testing::expect_ok(
        parse_string_literal("\"a\\n\\x42\\u4e16\""),
        "interpreted string failed",
    ) {
        ConstValue::String(value) => testing::assert_eq(value, "a\nB世"),
        _ => testing::fail("expected string constant"),
    }
    match testing::expect_ok(parse_string_literal("`a\r\nb`"), "raw string failed") {
        ConstValue::String(value) => testing::assert_eq(value, "a\nb"),
        _ => testing::fail("expected string constant"),
    }
    match testing::expect_ok(parse_string_literal("\"\\xff\\x00\""), "byte string failed") {
        ConstValue::String(value) => {
            testing::assert_eq(value.byte_len(), 2);
            testing::assert_eq(value.byte_get(0), 255.to_u8());
            testing::assert_eq(value.byte_get(1), 0.to_u8());
        },
        _ => testing::fail("expected string constant"),
    }
    testing::assert_eq(exact(parse_string_literal("\"\\xff\\x00\"")), "\"\\xff\\x00\"")
}

#[test]
fn parses_rune_literals_as_integer_constants() -> () {
    testing::assert_eq(exact(parse_rune_literal("'世'")), "19990");
    testing::assert_eq(exact(parse_rune_literal("'\\xFF'")), "255");
    testing::assert_eq(exact(parse_rune_literal("'\\U0001F600'")), "128512")
}

#[test]
fn rejects_malformed_literal_values_without_panicking() -> () {
    testing::assert(parse_float_literal("0x1.2").is_err());
    testing::assert(parse_float_literal("1e1000001").is_ok());
    testing::assert(parse_float_literal("1e2147483648").is_err());
    testing::assert(parse_string_literal("\"\\q\"").is_err());
    testing::assert(parse_rune_literal("'ab'").is_err())
}
