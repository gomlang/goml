package constant;

use std::math;
use std::num;
use std::text;

const UNKNOWN_EXACT_KIND: string = "Unknown";

const BOOL_EXACT_KIND: string = "Bool";

const STRING_EXACT_KIND: string = "String";

const INT_EXACT_KIND: string = "Int";

const FLOAT_EXACT_KIND: string = "Float";

const COMPLEX_EXACT_KIND: string = "Complex";

const TRUE_EXACT_VALUE: string = "true";

const FALSE_EXACT_VALUE: string = "false";

#[go_ffi("strconv", "Quote")]
extern fn quote_string(value: string) -> string;

#[go_ffi("strconv", "FormatFloat")]
extern fn format_float(value: f64, format: u8, precision: isize, bits: isize) -> string;

#[derive(PartialEq, Eq, ToString, Debug)]
pub enum ConstantKind {
    Unknown,
    Bool,
    String,
    Int,
    Float,
    Complex,
}

pub enum NumericComponent {
    Integer(BigInt),
    Rational(BigRat),
    Float(BinaryFloat),
}

pub enum ConstValue {
    Unknown,
    Bool(bool),
    String(string),
    Int(BigInt),
    Rat(BigRat),
    LargeFloat(BinaryFloat),
    Complex {
        real: NumericComponent,
        imaginary: NumericComponent,
    },
}

pub fn rational_component(value: BigRat) -> NumericComponent {
    NumericComponent::Rational(value)
}

pub fn component_to_constant(value: NumericComponent) -> ConstValue {
    match value {
        NumericComponent::Integer(value) => ConstValue::Int(value),
        NumericComponent::Rational(value) => ConstValue::Rat(value),
        NumericComponent::Float(value) => ConstValue::LargeFloat(value),
    }
}

pub fn component_from_constant(value: ConstValue) -> Option[NumericComponent] {
    match value {
        ConstValue::Int(value) => Option::Some(NumericComponent::Integer(value)),
        ConstValue::Rat(value) => Option::Some(NumericComponent::Rational(value)),
        ConstValue::LargeFloat(value) => Option::Some(NumericComponent::Float(value)),
        ConstValue::Complex { real, imaginary } => if component_is_zero(imaginary) {
            Option::Some(real)
        } else {
            Option::None
        },
        _ => Option::None,
    }
}

pub fn component_is_zero(value: NumericComponent) -> bool {
    match value {
        NumericComponent::Integer(value) => value.sign == 0,
        NumericComponent::Rational(value) => value.numerator.sign == 0,
        NumericComponent::Float(_) => false,
    }
}

fn component_copy(value: NumericComponent) -> NumericComponent {
    match value {
        NumericComponent::Integer(value) => NumericComponent::Integer(integer_copy(value)),
        NumericComponent::Rational(value) => NumericComponent::Rational(
            BigRat {
                numerator: integer_copy(value.numerator),
                denominator: natural_copy(value.denominator),
            },
        ),
        NumericComponent::Float(value) => NumericComponent::Float(binary_float_copy(value)),
    }
}

pub fn constant_kind(value: ConstValue) -> ConstantKind {
    match value {
        ConstValue::Unknown => ConstantKind::Unknown,
        ConstValue::Bool(_) => ConstantKind::Bool,
        ConstValue::String(_) => ConstantKind::String,
        ConstValue::Int(_) => ConstantKind::Int,
        ConstValue::Rat(_) => ConstantKind::Float,
        ConstValue::LargeFloat(_) => ConstantKind::Float,
        ConstValue::Complex { real: _, imaginary: _ } => ConstantKind::Complex,
    }
}

pub fn constant_kind_name(value: ConstValue) -> string {
    match constant_kind(value) {
        ConstantKind::Unknown => UNKNOWN_EXACT_KIND,
        ConstantKind::Bool => BOOL_EXACT_KIND,
        ConstantKind::String => STRING_EXACT_KIND,
        ConstantKind::Int => INT_EXACT_KIND,
        ConstantKind::Float => FLOAT_EXACT_KIND,
        ConstantKind::Complex => COMPLEX_EXACT_KIND,
    }
}

pub fn constant_copy(value: ConstValue) -> ConstValue {
    match value {
        ConstValue::Unknown => ConstValue::Unknown,
        ConstValue::Bool(value) => ConstValue::Bool(value),
        ConstValue::String(value) => ConstValue::String(value),
        ConstValue::Int(value) => ConstValue::Int(integer_copy(value)),
        ConstValue::Rat(value) => ConstValue::Rat(
            BigRat {
                numerator: integer_copy(value.numerator),
                denominator: natural_copy(value.denominator),
            },
        ),
        ConstValue::LargeFloat(value) => ConstValue::LargeFloat(binary_float_copy(value)),
        ConstValue::Complex { real, imaginary } => ConstValue::Complex {
            real: component_copy(real),
            imaginary: component_copy(imaginary),
        },
    }
}

fn parse_exact_integer(value: string) -> Option[BigInt] {
    let negative = value.starts_with("-");
    let digits = if negative {
        value.byte_slice(1, value.byte_len())
    } else {
        value
    };
    match parse_integer_literal(digits) {
        Ok(ConstValue::Int(value)) => Option::Some(
            if negative {
                integer_neg(value)
            } else {
                value
            },
        ),
        _ => Option::None,
    }
}

fn parse_exact_rational(value: string) -> Option[BigRat] {
    match text::split_once(value, "/") {
        Some((numerator, denominator)) => match (
            parse_exact_integer(numerator),
            parse_exact_integer(denominator),
        ) {
            (Some(numerator), Some(denominator)) => match rational_new(
                numerator,
                denominator.magnitude,
            ) {
                Ok(value) => Option::Some(value),
                Err(_) => Option::None,
            },
            _ => Option::None,
        },
        None => parse_exact_integer(value).map(|value| rational_from_integer(value)),
    }
}

fn parse_exact_component(value: string) -> Option[NumericComponent] {
    match parse_exact_rational(value) {
        Some(value) => Option::Some(NumericComponent::Rational(value)),
        None => match parse_float_literal(value) {
            Ok(value) => component_from_constant(value),
            Err(_) => Option::None,
        },
    }
}

fn parse_exact_complex(value: string) -> Option[(NumericComponent, NumericComponent)] {
    if !value.starts_with("(") || !value.ends_with("i)") {
        return Option::None
    }
    let inner = value.byte_slice(1, value.byte_len() - 2);
    match text::split_once(inner, " + ") {
        Some((real, imaginary)) => match (
            parse_exact_component(real),
            parse_exact_component(imaginary),
        ) {
            (Some(real), Some(imaginary)) => Option::Some((real, imaginary)),
            _ => Option::None,
        },
        None => Option::None,
    }
}

pub fn constant_from_exact(kind: string, value: string) -> Option[ConstValue] {
    match kind {
        BOOL_EXACT_KIND => match value {
            TRUE_EXACT_VALUE => Option::Some(ConstValue::Bool(true)),
            FALSE_EXACT_VALUE => Option::Some(ConstValue::Bool(false)),
            _ => Option::None,
        },
        STRING_EXACT_KIND => match parse_string_literal(value) {
            Ok(result) => Option::Some(result),
            Err(_) => Option::None,
        },
        INT_EXACT_KIND => parse_exact_integer(value).map(|result| ConstValue::Int(result)),
        FLOAT_EXACT_KIND => match parse_exact_rational(value) {
            Some(result) => Option::Some(ConstValue::Rat(result)),
            None => match parse_float_literal(value) {
                Ok(result) => Option::Some(result),
                Err(_) => Option::None,
            },
        },
        COMPLEX_EXACT_KIND => parse_exact_complex(value).map(
            |components| ConstValue::Complex { real: components.0, imaginary: components.1 },
        ),
        _ => Option::None,
    }
}

pub fn constant_to_rational(value: ConstValue) -> Option[BigRat] {
    match value {
        ConstValue::Int(value) => Option::Some(rational_from_integer(value)),
        ConstValue::Rat(value) => Option::Some(value),
        ConstValue::Complex { real, imaginary } => if component_is_zero(imaginary) {
            constant_to_rational(component_to_constant(real))
        } else {
            Option::None
        },
        _ => Option::None,
    }
}

pub fn constant_to_integer(value: ConstValue) -> Option[BigInt] {
    match value {
        ConstValue::Int(value) => Option::Some(value),
        ConstValue::Rat(value) => rational_to_integer(value),
        ConstValue::Complex { real, imaginary } => if component_is_zero(imaginary) {
            constant_to_integer(component_to_constant(real))
        } else {
            Option::None
        },
        _ => Option::None,
    }
}

pub fn constant_to_complex(value: ConstValue) -> Option[(BigRat, BigRat)] {
    match value {
        ConstValue::Int(value) => Option::Some((rational_from_integer(value), rational_zero())),
        ConstValue::Rat(value) => Option::Some((value, rational_zero())),
        ConstValue::Complex { real, imaginary } => match (
            constant_to_rational(component_to_constant(real)),
            constant_to_rational(component_to_constant(imaginary)),
        ) {
            (Some(real), Some(imaginary)) => Option::Some((real, imaginary)),
            _ => Option::None,
        },
        _ => Option::None,
    }
}

pub fn constant_to_numeric_complex(value: ConstValue) -> Option[
    (NumericComponent, NumericComponent),
] {
    match value {
        ConstValue::Int(value) => Option::Some(
            (NumericComponent::Integer(value), NumericComponent::Integer(integer_zero())),
        ),
        ConstValue::Rat(value) => Option::Some(
            (NumericComponent::Rational(value), NumericComponent::Integer(integer_zero())),
        ),
        ConstValue::LargeFloat(value) => Option::Some(
            (NumericComponent::Float(value), NumericComponent::Integer(integer_zero())),
        ),
        ConstValue::Complex { real, imaginary } => Option::Some((real, imaginary)),
        _ => Option::None,
    }
}

pub fn constant_sign(value: ConstValue) -> Option[isize] {
    match value {
        ConstValue::Int(value) => Option::Some(value.sign),
        ConstValue::Rat(value) => Option::Some(value.numerator.sign),
        ConstValue::LargeFloat(value) => Option::Some(
            if value.negative {
                -1
            } else {
                1
            },
        ),
        ConstValue::Complex { real, imaginary } => if component_is_zero(imaginary) {
            constant_sign(component_to_constant(real))
        } else {
            Option::None
        },
        _ => Option::None,
    }
}

pub fn constant_exact_string(value: ConstValue) -> string {
    match value {
        ConstValue::Unknown => "unknown",
        ConstValue::Bool(value) => value.to_string(),
        ConstValue::String(value) => quote_string(value),
        ConstValue::Int(value) => integer_to_string(value),
        ConstValue::Rat(value) => rational_to_string(value),
        ConstValue::LargeFloat(value) => binary_float_exact_string(value),
        ConstValue::Complex { real, imaginary } => {
            "(" + constant_exact_string(component_to_constant(real)) + " + "
                + constant_exact_string(component_to_constant(imaginary))
                + "i)"
        },
    }
}

fn trim_decimal_zeros(value: string) -> string {
    let mut result = value;
    if !result.contains(".") {
        return result
    }
    while result.ends_with("0") {
        result = result.byte_slice(0, result.byte_len() - 1);
    }
    if result.ends_with(".") {
        result = result.byte_slice(0, result.byte_len() - 1);
    }
    result
}

fn manual_rational_short_string(value: BigRat) -> string {
    if value.numerator.sign == 0 {
        return "0"
    }
    let numerator = value.numerator.magnitude;
    let denominator = value.denominator;
    let numerator_digits = natural_to_string(numerator);
    let denominator_digits = natural_to_string(denominator);
    let mut exponent = numerator_digits.byte_len() - denominator_digits.byte_len();
    if exponent >= 0 {
        let scaled_denominator = natural_mul(denominator, natural_pow_small(10, exponent));
        if natural_compare(numerator, scaled_denominator) < 0 {
            exponent -= 1;
        }
    } else {
        let scaled_numerator = natural_mul(numerator, natural_pow_small(10, -exponent));
        if natural_compare(scaled_numerator, denominator) < 0 {
            exponent -= 1;
        }
    }
    let shift = 5 - exponent;
    let scaled_numerator = if shift >= 0 {
        natural_mul(numerator, natural_pow_small(10, shift))
    } else {
        numerator
    };
    let scaled_denominator = if shift < 0 {
        natural_mul(denominator, natural_pow_small(10, -shift))
    } else {
        denominator
    };
    let divided = natural_div_rem(scaled_numerator, scaled_denominator).unwrap_or(
        (natural_zero(), natural_zero()),
    );
    let mut rounded = divided.0;
    let doubled_remainder = natural_mul_small(divided.1, 2);
    let comparison = natural_compare(doubled_remainder, scaled_denominator);
    if comparison > 0 || (comparison == 0 && rounded.limbs[0] % 2 == 1) {
        rounded = natural_add_small(rounded, 1);
    }
    let mut digits = natural_to_string(rounded);
    if digits.byte_len() > 6 {
        rounded = natural_div_rem_small(rounded, 10).unwrap_or((rounded, 0.to_u32())).0;
        digits = natural_to_string(rounded);
        exponent += 1;
    }
    while digits.byte_len() < 6 {
        digits = "0" + digits;
    }
    let magnitude = if exponent < -4 || exponent >= 6 {
        let mantissa = trim_decimal_zeros(
            digits.byte_slice(0, 1) + "." + digits.byte_slice(1, digits.byte_len()),
        );
        mantissa + "e"
            + if exponent >= 0 {
                f"+{exponent}"
            } else {
                exponent.to_string()
            }
    } else {
        let point = exponent + 1;
        if point <= 0 {
            trim_decimal_zeros("0." + text::repeat("0", -point) + digits)
        } else if point >= digits.byte_len() {
            digits + text::repeat("0", point - digits.byte_len())
        } else {
            trim_decimal_zeros(
                digits.byte_slice(0, point) + "." + digits.byte_slice(point, digits.byte_len()),
            )
        }
    };
    if value.numerator.sign < 0 {
        "-" + magnitude
    } else {
        magnitude
    }
}

fn rational_short_string(value: BigRat) -> string {
    match (
        num::parse_float64_structured(integer_to_string(value.numerator)),
        num::parse_float64_structured(natural_to_string(value.denominator)),
    ) {
        (Ok(numerator), Ok(denominator)) => {
            let approximate = numerator / denominator;
            if !math::is_finite(approximate) || (approximate == 0.0 && value.numerator.sign != 0) {
                manual_rational_short_string(value)
            } else {
                let short = format_float(approximate, 103, 6, 64);
                if !rational_is_integer(value) && !short.contains(".") && !short.contains("e") {
                    format_float(approximate, 103, -1, 64)
                } else {
                    short
                }
            }
        },
        _ => manual_rational_short_string(value),
    }
}

fn complex_component_string(value: NumericComponent) -> string {
    match value {
        NumericComponent::Integer(value) => integer_to_string(value),
        NumericComponent::Rational(value) => if rational_is_integer(value) {
            rational_to_string(value)
        } else {
            rational_short_string(value)
        },
        NumericComponent::Float(value) => binary_float_exact_string(value),
    }
}

pub fn constant_string(value: ConstValue) -> string {
    match value {
        ConstValue::Unknown => "unknown",
        ConstValue::Bool(value) => value.to_string(),
        ConstValue::String(value) => quote_string(value),
        ConstValue::Int(value) => integer_to_string(value),
        ConstValue::Rat(value) => rational_short_string(value),
        ConstValue::LargeFloat(value) => binary_float_exact_string(value),
        ConstValue::Complex { real, imaginary } => {
            "(" + complex_component_string(real) + " + " + complex_component_string(imaginary)
                + "i)"
        },
    }
}

pub fn constant_equal(left: ConstValue, right: ConstValue) -> bool {
    match (left, right) {
        (ConstValue::Complex { real: left_real, imaginary: left_imaginary }, right) => match constant_to_numeric_complex(
            right,
        ) {
            Some((right_real, right_imaginary)) => return constant_equal(
                component_to_constant(left_real),
                component_to_constant(right_real),
            )
                && constant_equal(
                    component_to_constant(left_imaginary),
                    component_to_constant(right_imaginary),
                ),
            None => return false,
        },
        (left, ConstValue::Complex { real: right_real, imaginary: right_imaginary }) => match constant_to_numeric_complex(
            left,
        ) {
            Some((left_real, left_imaginary)) => return constant_equal(
                component_to_constant(left_real),
                component_to_constant(right_real),
            )
                && constant_equal(
                    component_to_constant(left_imaginary),
                    component_to_constant(right_imaginary),
                ),
            None => return false,
        },
        _ => {},
    }
    let binary = match (left, right) {
        (ConstValue::LargeFloat(_), _) | (_, ConstValue::LargeFloat(_)) => match (
            constant_to_binary_float(left, binary_float_default_precision()),
            constant_to_binary_float(right, binary_float_default_precision()),
        ) {
            (Some(left), Some(right)) => Option::Some(binary_float_compare(left, right) == 0),
            _ => Option::Some(false),
        },
        _ => Option::None,
    };
    if let Some(value) = binary {
        return value
    }
    match (left, right) {
        (ConstValue::Unknown, ConstValue::Unknown) => true,
        (ConstValue::Bool(left), ConstValue::Bool(right)) => left == right,
        (ConstValue::String(left), ConstValue::String(right)) => left == right,
        (ConstValue::LargeFloat(left), ConstValue::LargeFloat(right)) => binary_float_compare(
            left,
            right,
        )
            == 0,
        (left, right) => match (constant_to_complex(left), constant_to_complex(right)) {
            (Some(left), Some(right)) => rational_compare(left.0, right.0) == 0
                && rational_compare(left.1, right.1) == 0,
            _ => false,
        },
    }
}

pub fn constant_exceeds_integer_precision(value: ConstValue, precision: isize) -> bool {
    match value {
        ConstValue::Int(value) => natural_bit_len(value.magnitude) > precision,
        _ => false,
    }
}
