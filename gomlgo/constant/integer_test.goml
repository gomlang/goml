package constant;

use std::testing;

fn parse_integer(value: string) -> BigInt {
    testing::expect_ok(integer_parse(value), "failed to parse integer")
}

#[test]
fn parses_and_formats_integer_literal_radices() -> () {
    testing::assert_eq(
        integer_to_string(parse_integer("0x1_0000_0000_0000_0001")),
        "18446744073709551617",
    );
    testing::assert_eq(integer_to_string(parse_integer("-0b101010")), "-42");
    testing::assert_eq(integer_to_string(parse_integer("0777")), "511")
}

#[test]
fn integer_arithmetic_exceeds_machine_width() -> () {
    let shifted = integer_shift_left(integer_one(), 100);
    let value = integer_add(shifted, integer_from_int64(3.to_i64()));
    testing::assert_eq(integer_to_string(value), "1267650600228229401496703205379");
    testing::assert_eq(
        integer_to_string(integer_mul(value, parse_integer("4294967297"))),
        "5444517872002666015642223120417879490563",
    )
}

#[test]
fn integer_division_uses_go_truncation() -> () {
    let divided = testing::expect_ok(
        integer_quo_rem(parse_integer("-1267650600228229401496703205379"), parse_integer("7")),
        "integer division failed",
    );
    testing::assert_eq(integer_to_string(divided.0), "-181092942889747057356671886482");
    testing::assert_eq(integer_to_string(divided.1), "-5")
}

#[test]
fn negative_shift_and_bitwise_operations_use_infinite_twos_complement() -> () {
    testing::assert_eq(integer_to_string(integer_shift_right(parse_integer("-5"), 1)), "-3");
    testing::assert_eq(integer_to_string(integer_not(parse_integer("5"))), "-6");
    testing::assert_eq(integer_to_string(integer_and(parse_integer("-5"), parse_integer("3"))), "3");
    testing::assert_eq(integer_to_string(integer_or(parse_integer("-5"), parse_integer("3"))), "-5");
    testing::assert_eq(
        integer_to_string(integer_xor(parse_integer("-5"), parse_integer("3"))),
        "-8",
    );
    let high = integer_shift_left(integer_one(), 100);
    testing::assert_eq(
        integer_to_string(
            integer_and(
                integer_add(high, parse_integer("3")),
                integer_add(high, parse_integer("1")),
            ),
        ),
        "1267650600228229401496703205377",
    )
}
