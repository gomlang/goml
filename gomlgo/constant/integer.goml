package constant;

pub struct BigInt {
    pub sign: isize,
    pub magnitude: Natural,
}

pub fn integer_from_parts(sign: isize, magnitude: Natural) -> BigInt {
    if natural_is_zero(magnitude) {
        BigInt { sign: 0, magnitude: natural_zero() }
    } else if sign < 0 {
        BigInt { sign: -1, magnitude }
    } else {
        BigInt { sign: 1, magnitude }
    }
}

pub fn integer_zero() -> BigInt {
    integer_from_parts(0, natural_zero())
}

pub fn integer_one() -> BigInt {
    integer_from_parts(1, natural_one())
}

pub fn integer_from_int64(value: i64) -> BigInt {
    if value == 0.to_i64() {
        integer_zero()
    } else if value > 0.to_i64() {
        integer_from_parts(1, natural_from_uint64(value.to_u64()))
    } else if value == -9223372036854775807.to_i64() - 1.to_i64() {
        integer_from_parts(-1, natural_shift_left(natural_one(), 63))
    } else {
        integer_from_parts(-1, natural_from_uint64((-value).to_u64()))
    }
}

pub fn integer_copy(value: BigInt) -> BigInt {
    BigInt { sign: value.sign, magnitude: natural_copy(value.magnitude) }
}

pub fn integer_neg(value: BigInt) -> BigInt {
    integer_from_parts(-value.sign, natural_copy(value.magnitude))
}

pub fn integer_compare(left: BigInt, right: BigInt) -> isize {
    if left.sign < right.sign {
        -1
    } else if left.sign > right.sign {
        1
    } else if left.sign == 0 {
        0
    } else {
        let magnitude = natural_compare(left.magnitude, right.magnitude);
        if left.sign < 0 {
            -magnitude
        } else {
            magnitude
        }
    }
}

pub fn integer_add(left: BigInt, right: BigInt) -> BigInt {
    if left.sign == 0 {
        integer_copy(right)
    } else if right.sign == 0 {
        integer_copy(left)
    } else if left.sign == right.sign {
        integer_from_parts(left.sign, natural_add(left.magnitude, right.magnitude))
    } else {
        let compared = natural_compare(left.magnitude, right.magnitude);
        if compared == 0 {
            integer_zero()
        } else if compared > 0 {
            integer_from_parts(
                left.sign,
                natural_sub(left.magnitude, right.magnitude).unwrap_or(natural_zero()),
            )
        } else {
            integer_from_parts(
                right.sign,
                natural_sub(right.magnitude, left.magnitude).unwrap_or(natural_zero()),
            )
        }
    }
}

pub fn integer_sub(left: BigInt, right: BigInt) -> BigInt {
    integer_add(left, integer_neg(right))
}

pub fn integer_mul(left: BigInt, right: BigInt) -> BigInt {
    integer_from_parts(left.sign * right.sign, natural_mul(left.magnitude, right.magnitude))
}

pub fn integer_quo_rem(left: BigInt, right: BigInt) -> Result[(BigInt, BigInt), string] {
    if right.sign == 0 {
        return Result::Err("division by zero")
    }
    let divided = natural_div_rem(left.magnitude, right.magnitude)?;
    Result::Ok(
        (
            integer_from_parts(left.sign * right.sign, divided.0),
            integer_from_parts(left.sign, divided.1),
        ),
    )
}

pub fn integer_shift_left(value: BigInt, amount: isize) -> BigInt {
    integer_from_parts(value.sign, natural_shift_left(value.magnitude, amount))
}

pub fn integer_shift_right(value: BigInt, amount: isize) -> BigInt {
    if value.sign >= 0 {
        integer_from_parts(value.sign, natural_shift_right(value.magnitude, amount))
    } else if amount <= 0 {
        integer_copy(value)
    } else {
        let adjustment = natural_sub(natural_shift_left(natural_one(), amount), natural_one()).unwrap_or(
            natural_zero(),
        );
        integer_from_parts(
            -1,
            natural_shift_right(natural_add(value.magnitude, adjustment), amount),
        )
    }
}

fn minus_one_magnitude(value: BigInt) -> Natural {
    natural_sub(value.magnitude, natural_one()).unwrap_or(natural_zero())
}

pub fn integer_not(value: BigInt) -> BigInt {
    integer_sub(integer_neg(value), integer_one())
}

pub fn integer_and(left: BigInt, right: BigInt) -> BigInt {
    if left.sign >= 0 && right.sign >= 0 {
        integer_from_parts(1, natural_and(left.magnitude, right.magnitude))
    } else if left.sign < 0 && right.sign >= 0 {
        integer_from_parts(1, natural_and_not(right.magnitude, minus_one_magnitude(left)))
    } else if left.sign >= 0 && right.sign < 0 {
        integer_from_parts(1, natural_and_not(left.magnitude, minus_one_magnitude(right)))
    } else {
        integer_from_parts(
            -1,
            natural_add_small(
                natural_or(minus_one_magnitude(left), minus_one_magnitude(right)),
                1.to_u32(),
            ),
        )
    }
}

pub fn integer_and_not(left: BigInt, right: BigInt) -> BigInt {
    integer_and(left, integer_not(right))
}

pub fn integer_or(left: BigInt, right: BigInt) -> BigInt {
    if left.sign >= 0 && right.sign >= 0 {
        integer_from_parts(1, natural_or(left.magnitude, right.magnitude))
    } else if left.sign < 0 && right.sign >= 0 {
        integer_from_parts(
            -1,
            natural_add_small(
                natural_and_not(minus_one_magnitude(left), right.magnitude),
                1.to_u32(),
            ),
        )
    } else if left.sign >= 0 && right.sign < 0 {
        integer_from_parts(
            -1,
            natural_add_small(
                natural_and_not(minus_one_magnitude(right), left.magnitude),
                1.to_u32(),
            ),
        )
    } else {
        integer_from_parts(
            -1,
            natural_add_small(
                natural_and(minus_one_magnitude(left), minus_one_magnitude(right)),
                1.to_u32(),
            ),
        )
    }
}

pub fn integer_xor(left: BigInt, right: BigInt) -> BigInt {
    if left.sign >= 0 && right.sign >= 0 {
        integer_from_parts(1, natural_xor(left.magnitude, right.magnitude))
    } else if left.sign < 0 && right.sign >= 0 {
        integer_from_parts(
            -1,
            natural_add_small(natural_xor(minus_one_magnitude(left), right.magnitude), 1.to_u32()),
        )
    } else if left.sign >= 0 && right.sign < 0 {
        integer_from_parts(
            -1,
            natural_add_small(natural_xor(left.magnitude, minus_one_magnitude(right)), 1.to_u32()),
        )
    } else {
        integer_from_parts(1, natural_xor(minus_one_magnitude(left), minus_one_magnitude(right)))
    }
}

pub fn integer_parse(value: string) -> Result[BigInt, string] {
    if value == "" {
        return Result::Err("missing integer")
    }
    let mut sign = 1;
    let mut start = 0;
    if value.byte_get(0) == b'-' {
        sign = -1;
        start = 1;
    } else if value.byte_get(0) == b'+' {
        start = 1;
    }
    let mut radix = 10.to_u32();
    if start + 2 <= value.byte_len() && value.byte_get(start) == b'0' {
        let prefix = value.byte_get(start + 1);
        if prefix == b'b' || prefix == b'B' {
            radix = 2.to_u32();
            start += 2;
        } else if prefix == b'o' || prefix == b'O' {
            radix = 8.to_u32();
            start += 2;
        } else if prefix == b'x' || prefix == b'X' {
            radix = 16.to_u32();
            start += 2;
        } else if value.byte_len() > start + 1 {
            radix = 8.to_u32();
            start += 1;
        }
    }
    let magnitude = natural_parse_digits(value.byte_slice(start, value.byte_len()), radix)?;
    Result::Ok(integer_from_parts(sign, magnitude))
}

pub fn integer_to_string(value: BigInt) -> string {
    if value.sign < 0 {
        "-" + natural_to_string(value.magnitude)
    } else {
        natural_to_string(value.magnitude)
    }
}
