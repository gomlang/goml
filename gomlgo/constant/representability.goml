package constant;

use gomlgo::types as go_types;

fn integer_fits_signed(value: BigInt, bits: isize) -> bool {
    if value.sign == 0 {
        return true
    }
    let width = if bits < 1 {
        1
    } else {
        bits
    };
    let length = natural_bit_len(value.magnitude);
    if length < width {
        return true
    } else if value.sign > 0 || length != width {
        return false
    }
    let mut found = false;
    for limb in value.magnitude.limbs {
        if limb != 0.to_u32() {
            if found || (limb & (limb - 1.to_u32())) != 0.to_u32() {
                return false
            }
            found = true;
        }
    }
    found
}

fn integer_fits_unsigned(value: BigInt, bits: isize) -> bool {
    value.sign >= 0 && natural_bit_len(value.magnitude) <= bits
}

fn rational_abs(value: BigRat) -> BigRat {
    BigRat {
        numerator: integer_from_parts(1, natural_copy(value.numerator.magnitude)),
        denominator: natural_copy(value.denominator),
    }
}

fn rational_less_than_natural(value: BigRat, limit: Natural) -> bool {
    natural_compare(value.numerator.magnitude, natural_mul(limit, value.denominator)) < 0
}

fn float_overflow_threshold(precision: isize, maximum_exponent: isize) -> Natural {
    let significand = natural_sub(natural_shift_left(natural_one(), precision + 1), natural_one()).unwrap_or(
        natural_zero(),
    );
    natural_shift_left(significand, maximum_exponent - precision)
}

fn rational_fits_float(value: BigRat, precision: isize, maximum_exponent: isize) -> bool {
    if value.numerator.sign == 0 {
        true
    } else {
        rational_less_than_natural(
            rational_abs(value),
            float_overflow_threshold(precision, maximum_exponent),
        )
    }
}

fn quotient_for_scale(numerator: Natural, denominator: Natural, scale: isize) -> Result[
    (Natural, Natural, Natural),
    string,
] {
    if scale >= 0 {
        let scaled = natural_shift_left(numerator, scale);
        let divided = natural_div_rem(scaled, denominator)?;
        Result::Ok((divided.0, divided.1, denominator))
    } else {
        let scaled_denominator = natural_shift_left(denominator, -scale);
        let divided = natural_div_rem(numerator, scaled_denominator)?;
        Result::Ok((divided.0, divided.1, scaled_denominator))
    }
}

fn round_quotient(quotient: Natural, remainder: Natural, denominator: Natural) -> Natural {
    let doubled = natural_shift_left(remainder, 1);
    let compared = natural_compare(doubled, denominator);
    if compared > 0 || (compared == 0 && natural_bit(quotient, 0)) {
        natural_add_small(quotient, 1.to_u32())
    } else {
        quotient
    }
}

fn rational_binary_exponent(value: BigRat) -> isize {
    let mut exponent = natural_bit_len(value.numerator.magnitude)
        - natural_bit_len(value.denominator);
    let compared = if exponent >= 0 {
        natural_compare(value.numerator.magnitude, natural_shift_left(value.denominator, exponent))
    } else {
        natural_compare(natural_shift_left(value.numerator.magnitude, -exponent), value.denominator)
    };
    if compared < 0 {
        exponent -= 1;
    }
    exponent
}

fn rounded_rational(
    value: BigRat,
    precision: isize,
    minimum_exponent: isize,
    maximum_exponent: isize,
) -> Option[BigRat] {
    if value.numerator.sign == 0 {
        return Option::Some(rational_zero())
    } else if !rational_fits_float(value, precision, maximum_exponent) {
        return Option::None
    }
    let absolute = rational_abs(value);
    let exponent = rational_binary_exponent(absolute);
    let scale = if exponent < minimum_exponent {
        precision - 1 - minimum_exponent
    } else {
        precision - 1 - exponent
    };
    let divided = match quotient_for_scale(
        absolute.numerator.magnitude,
        absolute.denominator,
        scale,
    ) {
        Ok(value) => value,
        Err(_) => return Option::None,
    };
    let rounded = round_quotient(divided.0, divided.1, divided.2);
    let result = if scale >= 0 {
        rational_new(
            integer_from_parts(value.numerator.sign, rounded),
            natural_shift_left(natural_one(), scale),
        )
    } else {
        rational_new(
            integer_from_parts(value.numerator.sign, natural_shift_left(rounded, -scale)),
            natural_one(),
        )
    };
    match result {
        Ok(value) => Option::Some(value),
        Err(_) => Option::None,
    }
}

fn rounded_float_constant(
    value: ConstValue,
    precision: isize,
    minimum_exponent: isize,
    maximum_exponent: isize,
) -> Option[ConstValue] {
    match value {
        ConstValue::LargeFloat(value) => binary_float_round_rational(
            value,
            precision,
            minimum_exponent,
            maximum_exponent,
        ).map(|value| ConstValue::Rat(value)),
        value => match constant_to_rational(value) {
            Some(value) => rounded_rational(value, precision, minimum_exponent, maximum_exponent).map(
                |value| ConstValue::Rat(value),
            ),
            None => Option::None,
        },
    }
}

fn integer_width(kind: go_types::BasicKind, sizes: go_types::TargetSizes) -> Option[(isize, bool)] {
    match kind {
        go_types::BasicKind::Int => Option::Some(((sizes.word_size * 8).to_isize(), true)),
        go_types::BasicKind::Int8 => Option::Some((8, true)),
        go_types::BasicKind::Int16 => Option::Some((16, true)),
        go_types::BasicKind::Int32 => Option::Some((32, true)),
        go_types::BasicKind::Int64 => Option::Some((64, true)),
        go_types::BasicKind::Uint => Option::Some(((sizes.word_size * 8).to_isize(), false)),
        go_types::BasicKind::Uint8 => Option::Some((8, false)),
        go_types::BasicKind::Uint16 => Option::Some((16, false)),
        go_types::BasicKind::Uint32 => Option::Some((32, false)),
        go_types::BasicKind::Uint64 => Option::Some((64, false)),
        go_types::BasicKind::Uintptr => Option::Some(((sizes.word_size * 8).to_isize(), false)),
        _ => Option::None,
    }
}

pub fn round_constant(value: ConstValue, kind: go_types::BasicKind, sizes: go_types::TargetSizes) -> Option[
    ConstValue,
] {
    match integer_width(kind, sizes) {
        Some((bits, signed)) => match constant_to_integer(value) {
            Some(integer) => if (signed && integer_fits_signed(integer, bits))
                || (!signed && integer_fits_unsigned(integer, bits)) {
                Option::Some(
                    match value {
                        ConstValue::Int(_) => value,
                        _ => ConstValue::Int(integer),
                    },
                )
            } else {
                Option::None
            },
            None => Option::None,
        },
        None => match kind {
            go_types::BasicKind::UntypedInt | go_types::BasicKind::UntypedRune => match constant_to_integer(
                value,
            ) {
                Some(integer) => Option::Some(
                    match value {
                        ConstValue::Int(_) => value,
                        _ => ConstValue::Int(integer),
                    },
                ),
                None => Option::None,
            },
            go_types::BasicKind::Float32 => rounded_float_constant(value, 24, -126, 127),
            go_types::BasicKind::Float64 => rounded_float_constant(value, 53, -1022, 1023),
            go_types::BasicKind::UntypedFloat => match value {
                ConstValue::LargeFloat(_) => Option::Some(value),
                value => constant_to_rational(value).map(|value| ConstValue::Rat(value)),
            },
            go_types::BasicKind::Complex64 | go_types::BasicKind::Complex128 => match constant_to_numeric_complex(
                value,
            ) {
                Some((real, imaginary)) => {
                    let float_kind = if kind == go_types::BasicKind::Complex64 {
                        go_types::BasicKind::Float32
                    } else {
                        go_types::BasicKind::Float64
                    };
                    match (
                        round_constant(component_to_constant(real), float_kind, sizes),
                        round_constant(component_to_constant(imaginary), float_kind, sizes),
                    ) {
                        (Some(ConstValue::Rat(real)), Some(ConstValue::Rat(imaginary))) => Option::Some(
                            ConstValue::Complex {
                                real: rational_component(real),
                                imaginary: rational_component(imaginary),
                            },
                        ),
                        _ => Option::None,
                    }
                },
                None => Option::None,
            },
            go_types::BasicKind::UntypedComplex => constant_to_numeric_complex(value).map(
                |components| ConstValue::Complex { real: components.0, imaginary: components.1 },
            ),
            go_types::BasicKind::Bool | go_types::BasicKind::UntypedBool => match value {
                ConstValue::Bool(_) => Option::Some(value),
                _ => Option::None,
            },
            go_types::BasicKind::String | go_types::BasicKind::UntypedString => match value {
                ConstValue::String(_) => Option::Some(value),
                _ => Option::None,
            },
            _ => Option::None,
        },
    }
}

pub fn constant_representable(
    value: ConstValue,
    kind: go_types::BasicKind,
    sizes: go_types::TargetSizes,
) -> bool {
    match value {
        ConstValue::Unknown => true,
        _ => round_constant(value, kind, sizes).is_some(),
    }
}

pub fn default_type(kind: go_types::BasicKind) -> Option[go_types::BasicKind] {
    match kind {
        go_types::BasicKind::UntypedBool => Option::Some(go_types::BasicKind::Bool),
        go_types::BasicKind::UntypedInt => Option::Some(go_types::BasicKind::Int),
        go_types::BasicKind::UntypedRune => Option::Some(go_types::BasicKind::Int32),
        go_types::BasicKind::UntypedFloat => Option::Some(go_types::BasicKind::Float64),
        go_types::BasicKind::UntypedComplex => Option::Some(go_types::BasicKind::Complex128),
        go_types::BasicKind::UntypedString => Option::Some(go_types::BasicKind::String),
        _ => Option::None,
    }
}

fn integer_codepoint(value: BigInt) -> u32 {
    if value.sign < 0 || value.magnitude.limbs.len() > 1 {
        0xfffd.to_u32()
    } else {
        let result = if value.magnitude.limbs.is_empty() {
            0.to_u32()
        } else {
            value.magnitude.limbs[0]
        };
        if result > 0x10ffff.to_u32() || (result >= 0xd800.to_u32() && result < 0xe000.to_u32()) {
            0xfffd.to_u32()
        } else {
            result
        }
    }
}

pub fn convert_constant(value: ConstValue, kind: go_types::BasicKind, sizes: go_types::TargetSizes) -> Option[
    ConstValue,
] {
    if kind == go_types::BasicKind::String || kind == go_types::BasicKind::UntypedString {
        match value {
            ConstValue::String(value) => Option::Some(ConstValue::String(value)),
            value => match constant_to_integer(value) {
                Some(value) => match char_from_u32(integer_codepoint(value)) {
                    Some(value) => Option::Some(ConstValue::String(value.to_string())),
                    None => Option::Some(ConstValue::String("�")),
                },
                None => Option::None,
            },
        }
    } else {
        round_constant(value, kind, sizes)
    }
}
