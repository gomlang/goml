package constant;

use gomlgo::types as go_types;
use std::testing;

fn amd64_sizes() -> go_types::TargetSizes {
    match go_types::gc_sizes("amd64") {
        Some(value) => value,
        None => {
            testing::fail("missing amd64 sizes");
            loop {}
        },
    }
}

#[test]
fn integer_representability_observes_signedness_and_word_size() -> () {
    let sizes = amd64_sizes();
    testing::assert(
        constant_representable(integer_constant("127"), go_types::BasicKind::Int8, sizes),
    );
    testing::assert(
        constant_representable(integer_constant("-128"), go_types::BasicKind::Int8, sizes),
    );
    testing::assert(
        !constant_representable(integer_constant("128"), go_types::BasicKind::Int8, sizes),
    );
    testing::assert(
        !constant_representable(integer_constant("-129"), go_types::BasicKind::Int8, sizes),
    );
    testing::assert(
        constant_representable(
            integer_constant("-9223372036854775808"),
            go_types::BasicKind::Int64,
            sizes,
        ),
    );
    testing::assert(
        !constant_representable(
            integer_constant("-9223372036854775809"),
            go_types::BasicKind::Int64,
            sizes,
        ),
    );
    testing::assert(
        !constant_representable(
            integer_constant("9223372036854775808"),
            go_types::BasicKind::Int64,
            sizes,
        ),
    );
    testing::assert(
        !constant_representable(integer_constant("-1"), go_types::BasicKind::Uint64, sizes),
    );
    testing::assert(
        constant_representable(
            integer_constant("18446744073709551615"),
            go_types::BasicKind::Uint64,
            sizes,
        ),
    );
    testing::assert(
        !constant_representable(
            integer_constant("18446744073709551616"),
            go_types::BasicKind::Uint64,
            sizes,
        ),
    )
}

#[test]
fn float_rounding_matches_go_constant_values() -> () {
    let sizes = amd64_sizes();
    let one_tenth = testing::expect_ok(parse_float_literal("0.1"), "float parse failed");
    let float32_value = match round_constant(one_tenth, go_types::BasicKind::Float32, sizes) {
        Some(value) => value,
        None => {
            testing::fail("float32 rounding failed");
            loop {}
        },
    };
    let float64_value = match round_constant(one_tenth, go_types::BasicKind::Float64, sizes) {
        Some(value) => value,
        None => {
            testing::fail("float64 rounding failed");
            loop {}
        },
    };
    testing::assert_eq(constant_exact_string(float32_value), oracle_exact("float32(0.1)"));
    testing::assert_eq(constant_exact_string(float64_value), oracle_exact("float64(0.1)"))
}

#[test]
fn float_representability_uses_ieee_overflow_boundary() -> () {
    let sizes = amd64_sizes();
    let below = testing::expect_ok(parse_float_literal("0x1.fffffe8p127"), "float parse failed");
    let boundary = testing::expect_ok(parse_float_literal("0x1.ffffffp127"), "float parse failed");
    testing::assert(constant_representable(below, go_types::BasicKind::Float32, sizes));
    testing::assert(!constant_representable(boundary, go_types::BasicKind::Float32, sizes))
}

#[test]
fn large_float_rounding_handles_overflow_and_underflow() -> () {
    let sizes = amd64_sizes();
    let tiny = testing::expect_ok(parse_float_literal("1e-5000"), "float parse failed");
    let huge = testing::expect_ok(parse_float_literal("1e5000"), "float parse failed");
    let rounded = match round_constant(tiny, go_types::BasicKind::Float64, sizes) {
        Some(value) => value,
        None => {
            testing::fail("float64 underflow rounding failed");
            loop {}
        },
    };
    testing::assert_eq(constant_exact_string(rounded), oracle_exact("float64(1e-5000)"));
    testing::assert(!constant_representable(huge, go_types::BasicKind::Float64, sizes));
    let tiny_imaginary = testing::expect_ok(
        parse_imaginary_literal("1e-5000i"),
        "imaginary parse failed",
    );
    let rounded_complex = match round_constant(
        tiny_imaginary,
        go_types::BasicKind::Complex128,
        sizes,
    ) {
        Some(value) => value,
        None => {
            testing::fail("complex128 underflow rounding failed");
            loop {}
        },
    };
    testing::assert_eq(constant_exact_string(rounded_complex), oracle_exact("complex128(1e-5000i)"))
}

#[test]
fn default_types_follow_go_untyped_rules() -> () {
    match default_type(go_types::BasicKind::UntypedRune) {
        Some(value) => testing::assert(value == go_types::BasicKind::Int32),
        None => testing::fail("missing rune default"),
    }
    match default_type(go_types::BasicKind::UntypedComplex) {
        Some(value) => testing::assert(value == go_types::BasicKind::Complex128),
        None => testing::fail("missing complex default"),
    }
    testing::assert(default_type(go_types::BasicKind::UntypedNil).is_none())
}

#[test]
fn rounding_preserves_requested_constant_kind() -> () {
    let sizes = amd64_sizes();
    let integer = integer_constant("127");
    let integral_float = testing::expect_ok(parse_float_literal("127.0"), "float parse failed");
    for target in[
        go_types::BasicKind::Int8,
        go_types::BasicKind::UntypedInt,
        go_types::BasicKind::UntypedRune,
    ] {
        for value in[integer, integral_float] {
            let rounded = testing::expect_some(
                round_constant(value, target, sizes),
                "integer rounding failed",
            );
            testing::assert(constant_kind(rounded) == ConstantKind::Int);
            testing::assert_eq(constant_exact_string(rounded), "127");
        }
    }
    let floating = testing::expect_some(
        round_constant(integer, go_types::BasicKind::UntypedFloat, sizes),
        "float rounding failed",
    );
    testing::assert(constant_kind(floating) == ConstantKind::Float);
    testing::assert_eq(constant_exact_string(floating), "127");
    testing::assert(
        round_constant(integer_constant("128"), go_types::BasicKind::Int8, sizes).is_none(),
    );
    let fractional = testing::expect_ok(parse_float_literal("127.5"), "float parse failed");
    testing::assert(round_constant(fractional, go_types::BasicKind::UntypedInt, sizes).is_none());
}
