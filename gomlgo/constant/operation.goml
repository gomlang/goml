package constant;

fn numeric_pair(left: ConstValue, right: ConstValue) -> Option[((BigRat, BigRat), (BigRat, BigRat))] {
    match (constant_to_complex(left), constant_to_complex(right)) {
        (Some(left), Some(right)) => Option::Some((left, right)),
        _ => Option::None,
    }
}

fn numeric_result(real: BigRat, imaginary: BigRat, complex: bool, floating: bool) -> ConstValue {
    if complex || imaginary.numerator.sign != 0 {
        ConstValue::Complex {
            real: rational_component(real),
            imaginary: rational_component(imaginary),
        }
    } else if floating {
        if natural_bit_len(real.numerator.magnitude) < 4096
            && natural_bit_len(real.denominator) < 4096 {
            ConstValue::Rat(real)
        } else {
            match binary_float_from_rational(real, binary_float_default_precision()) {
                Some(value) => ConstValue::LargeFloat(value),
                None => ConstValue::Unknown,
            }
        }
    } else {
        match rational_to_integer(real) {
            Some(value) => ConstValue::Int(value),
            None => ConstValue::Unknown,
        }
    }
}

fn has_complex(value: ConstValue) -> bool {
    match value {
        ConstValue::Complex { real: _, imaginary: _ } => true,
        _ => false,
    }
}

fn has_float(value: ConstValue) -> bool {
    match value {
        ConstValue::Rat(_) => true,
        ConstValue::LargeFloat(_) => true,
        ConstValue::Complex { real: _, imaginary: _ } => true,
        _ => false,
    }
}

fn has_large_float(value: ConstValue) -> bool {
    match value {
        ConstValue::LargeFloat(_) => true,
        ConstValue::Complex { real, imaginary } => match (real, imaginary) {
            (NumericComponent::Float(_), _) | (_, NumericComponent::Float(_)) => true,
            _ => false,
        },
        _ => false,
    }
}

fn make_complex(real: ConstValue, imaginary: ConstValue) -> ConstValue {
    match (component_from_constant(real), component_from_constant(imaginary)) {
        (Some(real), Some(imaginary)) => ConstValue::Complex { real, imaginary },
        _ => ConstValue::Unknown,
    }
}

fn complex_parts(value: ConstValue) -> Option[(ConstValue, ConstValue)] {
    match constant_to_numeric_complex(value) {
        Some((real, imaginary)) => Option::Some(
            (component_to_constant(real), component_to_constant(imaginary)),
        ),
        None => Option::None,
    }
}

fn add_complex_values(left: ConstValue, right: ConstValue) -> ConstValue {
    match (complex_parts(left), complex_parts(right)) {
        (Some(left), Some(right)) => make_complex(
            constant_add(left.0, right.0),
            constant_add(left.1, right.1),
        ),
        _ => ConstValue::Unknown,
    }
}

fn multiply_complex_values(left: ConstValue, right: ConstValue) -> ConstValue {
    match (complex_parts(left), complex_parts(right)) {
        (Some(left), Some(right)) => make_complex(
            constant_sub(constant_mul(left.0, right.0), constant_mul(left.1, right.1)),
            constant_add(constant_mul(left.0, right.1), constant_mul(left.1, right.0)),
        ),
        _ => ConstValue::Unknown,
    }
}

fn divide_complex_values(left: ConstValue, right: ConstValue) -> ConstValue {
    match (complex_parts(left), complex_parts(right)) {
        (Some(left), Some(right)) => {
            let denominator = constant_add(
                constant_mul(right.0, right.0),
                constant_mul(right.1, right.1),
            );
            if constant_sign(denominator).unwrap_or(1) == 0 {
                ConstValue::Unknown
            } else {
                make_complex(
                    constant_div(
                        constant_add(constant_mul(left.0, right.0), constant_mul(left.1, right.1)),
                        denominator,
                    ),
                    constant_div(
                        constant_sub(constant_mul(left.1, right.0), constant_mul(left.0, right.1)),
                        denominator,
                    ),
                )
            }
        },
        _ => ConstValue::Unknown,
    }
}

pub fn constant_neg(value: ConstValue) -> ConstValue {
    match value {
        ConstValue::Int(value) => ConstValue::Int(integer_neg(value)),
        ConstValue::Rat(value) => ConstValue::Rat(rational_neg(value)),
        ConstValue::LargeFloat(value) => ConstValue::LargeFloat(binary_float_neg(value)),
        ConstValue::Complex { real, imaginary } => ConstValue::Complex {
            real: component_from_constant(constant_neg(component_to_constant(real))).unwrap_or(
                rational_component(rational_zero()),
            ),
            imaginary: component_from_constant(constant_neg(component_to_constant(imaginary))).unwrap_or(
                rational_component(rational_zero()),
            ),
        },
        _ => ConstValue::Unknown,
    }
}

pub fn constant_not(value: ConstValue) -> ConstValue {
    match value {
        ConstValue::Bool(value) => ConstValue::Bool(!value),
        _ => ConstValue::Unknown,
    }
}

pub fn constant_bit_not_width(value: ConstValue, bits: isize) -> ConstValue {
    match constant_to_integer(value) {
        Some(value) => if bits > 0 {
            let mask = natural_sub(natural_shift_left(natural_one(), bits), natural_one()).unwrap_or(
                natural_zero(),
            );
            ConstValue::Int(integer_xor(value, integer_from_parts(1, mask)))
        } else {
            ConstValue::Int(integer_not(value))
        },
        None => ConstValue::Unknown,
    }
}

pub fn constant_add(left: ConstValue, right: ConstValue) -> ConstValue {
    if has_complex(left) || has_complex(right) {
        return add_complex_values(left, right)
    }
    if has_large_float(left) || has_large_float(right) {
        if constant_sign(left).unwrap_or(1) == 0 {
            return constant_copy(right)
        } else if constant_sign(right).unwrap_or(1) == 0 {
            return constant_copy(left)
        }
        match (
            constant_to_binary_float(left, binary_float_default_precision()),
            constant_to_binary_float(right, binary_float_default_precision()),
        ) {
            (Some(left), Some(right)) => {
                let cancels = left.negative != right.negative
                    && binary_float_compare(left, binary_float_neg(right)) == 0;
                return match binary_float_add(left, right, binary_float_default_precision()) {
                    Some(value) => ConstValue::LargeFloat(value),
                    None => if cancels {
                        ConstValue::Rat(rational_zero())
                    } else {
                        ConstValue::Unknown
                    },
                }
            },
            _ => {},
        }
    }
    match (left, right) {
        (ConstValue::String(left), ConstValue::String(right)) => ConstValue::String(left + right),
        (left, right) => {
            let complex = has_complex(left) || has_complex(right);
            let floating = has_float(left) || has_float(right);
            match numeric_pair(left, right) {
                Some((left, right)) => numeric_result(
                    rational_add(left.0, right.0),
                    rational_add(left.1, right.1),
                    complex,
                    floating,
                ),
                None => ConstValue::Unknown,
            }
        },
    }
}

pub fn constant_sub(left: ConstValue, right: ConstValue) -> ConstValue {
    constant_add(left, constant_neg(right))
}

pub fn constant_mul(left: ConstValue, right: ConstValue) -> ConstValue {
    if has_complex(left) || has_complex(right) {
        return multiply_complex_values(left, right)
    }
    if has_large_float(left) || has_large_float(right) {
        if constant_sign(left).unwrap_or(1) == 0 || constant_sign(right).unwrap_or(1) == 0 {
            return ConstValue::Rat(rational_zero())
        }
        match (
            constant_to_binary_float(left, binary_float_default_precision()),
            constant_to_binary_float(right, binary_float_default_precision()),
        ) {
            (Some(left), Some(right)) => return match binary_float_mul(
                left,
                right,
                binary_float_default_precision(),
            ) {
                Some(value) => ConstValue::LargeFloat(value),
                None => ConstValue::Unknown,
            },
            _ => {},
        }
    }
    let complex = has_complex(left) || has_complex(right);
    let floating = has_float(left) || has_float(right);
    match numeric_pair(left, right) {
        Some((left, right)) => numeric_result(
            rational_sub(rational_mul(left.0, right.0), rational_mul(left.1, right.1)),
            rational_add(rational_mul(left.0, right.1), rational_mul(left.1, right.0)),
            complex,
            floating,
        ),
        None => ConstValue::Unknown,
    }
}

pub fn constant_div(left: ConstValue, right: ConstValue) -> ConstValue {
    let complex = has_complex(left) || has_complex(right);
    let floating = has_float(left) || has_float(right);
    if complex {
        return divide_complex_values(left, right)
    }
    if !complex && !floating {
        return match (constant_to_integer(left), constant_to_integer(right)) {
            (Some(left), Some(right)) => match integer_quo_rem(left, right) {
                Ok(value) => ConstValue::Int(value.0),
                Err(_) => ConstValue::Unknown,
            },
            _ => ConstValue::Unknown,
        }
    }
    if !complex && (has_large_float(left) || has_large_float(right)) {
        if constant_sign(left).unwrap_or(1) == 0 {
            return if constant_sign(right).unwrap_or(0) == 0 {
                ConstValue::Unknown
            } else {
                ConstValue::Rat(rational_zero())
            }
        }
        return match (
            constant_to_binary_float(left, binary_float_default_precision()),
            constant_to_binary_float(right, binary_float_default_precision()),
        ) {
            (Some(left), Some(right)) => match binary_float_div(
                left,
                right,
                binary_float_default_precision(),
            ) {
                Some(value) => ConstValue::LargeFloat(value),
                None => ConstValue::Unknown,
            },
            _ => ConstValue::Unknown,
        }
    }
    match numeric_pair(left, right) {
        Some((left, right)) => {
            let denominator = rational_add(
                rational_mul(right.0, right.0),
                rational_mul(right.1, right.1),
            );
            if denominator.numerator.sign == 0 {
                ConstValue::Unknown
            } else {
                match (
                    rational_div(
                        rational_add(rational_mul(left.0, right.0), rational_mul(left.1, right.1)),
                        denominator,
                    ),
                    rational_div(
                        rational_sub(rational_mul(left.1, right.0), rational_mul(left.0, right.1)),
                        denominator,
                    ),
                ) {
                    (Ok(real), Ok(imaginary)) => numeric_result(real, imaginary, complex, true),
                    _ => ConstValue::Unknown,
                }
            }
        },
        None => ConstValue::Unknown,
    }
}

pub fn constant_rem(left: ConstValue, right: ConstValue) -> ConstValue {
    match (constant_to_integer(left), constant_to_integer(right)) {
        (Some(left), Some(right)) => match integer_quo_rem(left, right) {
            Ok(value) => ConstValue::Int(value.1),
            Err(_) => ConstValue::Unknown,
        },
        _ => ConstValue::Unknown,
    }
}

pub fn constant_bit_and(left: ConstValue, right: ConstValue) -> ConstValue {
    match (constant_to_integer(left), constant_to_integer(right)) {
        (Some(left), Some(right)) => ConstValue::Int(integer_and(left, right)),
        _ => ConstValue::Unknown,
    }
}

pub fn constant_bit_and_not(left: ConstValue, right: ConstValue) -> ConstValue {
    match (constant_to_integer(left), constant_to_integer(right)) {
        (Some(left), Some(right)) => ConstValue::Int(integer_and_not(left, right)),
        _ => ConstValue::Unknown,
    }
}

pub fn constant_bit_or(left: ConstValue, right: ConstValue) -> ConstValue {
    match (constant_to_integer(left), constant_to_integer(right)) {
        (Some(left), Some(right)) => ConstValue::Int(integer_or(left, right)),
        _ => ConstValue::Unknown,
    }
}

pub fn constant_bit_xor(left: ConstValue, right: ConstValue) -> ConstValue {
    match (constant_to_integer(left), constant_to_integer(right)) {
        (Some(left), Some(right)) => ConstValue::Int(integer_xor(left, right)),
        _ => ConstValue::Unknown,
    }
}

pub fn constant_shift_left(value: ConstValue, amount: isize) -> ConstValue {
    match constant_to_integer(value) {
        Some(value) => if amount >= 0 {
            ConstValue::Int(integer_shift_left(value, amount))
        } else {
            ConstValue::Unknown
        },
        None => ConstValue::Unknown,
    }
}

pub fn constant_shift_right(value: ConstValue, amount: isize) -> ConstValue {
    match constant_to_integer(value) {
        Some(value) => if amount >= 0 {
            ConstValue::Int(integer_shift_right(value, amount))
        } else {
            ConstValue::Unknown
        },
        None => ConstValue::Unknown,
    }
}

pub fn constant_compare(left: ConstValue, right: ConstValue) -> Option[isize] {
    if has_large_float(left) || has_large_float(right) {
        match (
            constant_to_binary_float(left, binary_float_default_precision()),
            constant_to_binary_float(right, binary_float_default_precision()),
        ) {
            (Some(left), Some(right)) => return Option::Some(binary_float_compare(left, right)),
            _ => {},
        }
    }
    match (left, right) {
        (ConstValue::String(left), ConstValue::String(right)) => if left < right {
            Option::Some(-1)
        } else if left > right {
            Option::Some(1)
        } else {
            Option::Some(0)
        },
        (ConstValue::Bool(left), ConstValue::Bool(right)) => if left == right {
            Option::Some(0)
        } else {
            Option::None
        },
        (left, right) => match (constant_to_rational(left), constant_to_rational(right)) {
            (Some(left), Some(right)) => Option::Some(rational_compare(left, right)),
            _ => Option::None,
        },
    }
}
