package constant;

use std::testing;

fn integer_constant(value: string) -> ConstValue {
    ConstValue::Int(parse_integer(value))
}

fn float_constant(numerator: string, denominator: string) -> ConstValue {
    ConstValue::Rat(make_rational(numerator, denominator))
}

#[test]
fn constant_operations_preserve_numeric_kinds() -> () {
    testing::assert_eq(
        constant_exact_string(constant_add(integer_constant("2"), integer_constant("3"))),
        "5",
    );
    testing::assert_eq(
        constant_exact_string(constant_div(integer_constant("5"), integer_constant("2"))),
        "2",
    );
    testing::assert_eq(
        constant_exact_string(constant_div(float_constant("5", "1"), integer_constant("2"))),
        "5/2",
    );
    testing::assert_eq(
        constant_exact_string(constant_add(ConstValue::String("go"), ConstValue::String("ml"))),
        "\"goml\"",
    );
    testing::assert_eq(
        constant_exact_string(constant_bit_and_not(integer_constant("15"), integer_constant("3"))),
        "12",
    )
}

#[test]
fn complex_arithmetic_is_exact() -> () {
    let left = ConstValue::Complex {
        real: rational_component(make_rational("1", "1")),
        imaginary: rational_component(make_rational("2", "1")),
    };
    let right = ConstValue::Complex {
        real: rational_component(make_rational("3", "1")),
        imaginary: rational_component(make_rational("-4", "1")),
    };
    testing::assert_eq(constant_exact_string(constant_mul(left, right)), "(11 + 2i)")
}

#[test]
fn constant_operations_propagate_unknown_values() -> () {
    testing::assert_eq(
        constant_kind(constant_add(ConstValue::Unknown, integer_constant("1"))),
        ConstantKind::Unknown,
    );
    testing::assert_eq(
        constant_kind(constant_div(integer_constant("1"), integer_constant("0"))),
        ConstantKind::Unknown,
    );
    testing::assert_eq(
        constant_kind(constant_shift_left(integer_constant("1"), -1)),
        ConstantKind::Unknown,
    )
}

#[test]
fn comparisons_and_large_shifts_are_exact() -> () {
    match constant_compare(float_constant("1", "3"), float_constant("2", "5")) {
        Some(value) => testing::assert_eq(value, -1),
        None => testing::fail("comparison failed"),
    }
    let shifted = constant_shift_left(integer_constant("1"), 511);
    testing::assert(!constant_exceeds_integer_precision(shifted, 512));
    testing::assert(constant_exceeds_integer_precision(constant_shift_left(shifted, 1), 512))
}

#[test]
fn large_float_arithmetic_matches_go_constant_precision() -> () {
    let value = testing::expect_ok(parse_float_literal("1e5000"), "large float failed");
    testing::assert_eq(
        constant_exact_string(constant_add(value, value)),
        oracle_exact("1e5000 + 1e5000"),
    );
    testing::assert_eq(
        constant_exact_string(constant_mul(value, integer_constant("3"))),
        oracle_exact("1e5000 * 3"),
    );
    testing::assert_eq(
        constant_exact_string(constant_div(value, integer_constant("3"))),
        oracle_exact("1e5000 / 3"),
    );
    testing::assert(
        constant_compare(
            value,
            testing::expect_ok(parse_float_literal("1.1e5000"), "large float failed"),
        ).unwrap_or(0)
            < 0,
    )
}

fn signed_float(value: string) -> ConstValue {
    if value.starts_with("-") {
        constant_neg(
            testing::expect_ok(
                parse_float_literal(value.byte_slice(1, value.byte_len())),
                "large float failed",
            ),
        )
    } else {
        testing::expect_ok(parse_float_literal(value), "large float failed")
    }
}

fn assert_large_binary(left: string, operator: string, right: string) -> () {
    let actual = if operator == "+" {
        constant_add(signed_float(left), signed_float(right))
    } else if operator == "-" {
        constant_sub(signed_float(left), signed_float(right))
    } else if operator == "*" {
        constant_mul(signed_float(left), signed_float(right))
    } else {
        constant_div(signed_float(left), signed_float(right))
    };
    testing::assert_eq(
        constant_exact_string(actual),
        oracle_exact("(" + left + ") " + operator + " (" + right + ")"),
    )
}

#[test]
fn large_float_arithmetic_differential_corpus() -> () {
    for value in Vec::from_array(
        [
            ("1e5000", "+", "1e5000"),
            ("1e5000", "+", "1e4999"),
            ("1e5000", "+", "1e4800"),
            ("1e5000", "+", "-1e5000"),
            ("-1e5000", "+", "-1e4999"),
            ("1.234567890123456789e5000", "+", "9.876543210987654321e4999"),
            ("1e5000", "-", "1e4999"),
            ("-1e5000", "-", "1e4999"),
            ("1e-5000", "-", "1e-5001"),
            ("1e5000", "*", "1e5000"),
            ("-1e5000", "*", "3.141592653589793238462643383279e-5000"),
            ("1.000000000000000000000000000001e5000", "*", "9.999999999999999999e-4000"),
            ("1e-5000", "*", "1e-5000"),
            ("1e5000", "/", "3e100"),
            ("1e5000", "/", "1e-5000"),
            ("1e-5000", "/", "1e5000"),
            ("-1.23456789e5000", "/", "9.87654321e4999"),
            ("1e646456000", "/", "1e646455999"),
        ],
    ) {
        assert_large_binary(value.0, value.1, value.2)
    }
}

#[test]
fn large_complex_arithmetic_matches_go_constant_precision() -> () {
    let imaginary = testing::expect_ok(parse_imaginary_literal("1e5000i"), "large imaginary failed");
    testing::assert_eq(constant_exact_string(imaginary), oracle_exact("1e5000i"));
    let left = constant_add(integer_constant("1"), imaginary);
    let right = constant_add(
        integer_constant("2"),
        testing::expect_ok(parse_imaginary_literal("3i"), "imaginary failed"),
    );
    testing::assert_eq(constant_exact_string(left), oracle_exact("1 + 1e5000i"));
    testing::assert_eq(
        constant_exact_string(constant_mul(left, right)),
        oracle_exact("(1 + 1e5000i) * (2 + 3i)"),
    );
    testing::assert_eq(
        constant_exact_string(constant_div(left, right)),
        oracle_exact("(1 + 1e5000i) / (2 + 3i)"),
    )
}
