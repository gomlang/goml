package constant;

use std::text;

const BINARY_FLOAT_PRECISION: isize = 512;

const BINARY_FLOAT_MAX_EXPONENT: isize = 2147483647;

const BINARY_FLOAT_MIN_EXPONENT: isize = -2147483648;

const BINARY_FLOAT_MAX_STORAGE_EXPONENT: isize = 2147487743;

const BINARY_FLOAT_MIN_STORAGE_EXPONENT: isize = -2147487744;

pub struct BinaryFloat {
    pub magnitude: Natural,
    pub exponent: isize,
    pub negative: bool,
}

pub fn binary_float_copy(value: BinaryFloat) -> BinaryFloat {
    BinaryFloat {
        magnitude: natural_copy(value.magnitude),
        exponent: value.exponent,
        negative: value.negative,
    }
}

fn exponent_add(left: isize, right: isize) -> Option[isize] {
    if right > 0 && left > BINARY_FLOAT_MAX_STORAGE_EXPONENT - right {
        Option::None
    } else if right < 0 && left < BINARY_FLOAT_MIN_STORAGE_EXPONENT - right {
        Option::None
    } else {
        Option::Some(left + right)
    }
}

fn low_bits_nonzero(value: Natural, count: isize) -> bool {
    let end = if count < natural_bit_len(value) {
        count
    } else {
        natural_bit_len(value)
    };
    for index in 0..end {
        if natural_bit(value, index) {
            return true
        }
    }
    false
}

fn valid_binary_float(value: BinaryFloat) -> bool {
    if natural_is_zero(value.magnitude) {
        return false
    }
    match exponent_add(value.exponent, natural_bit_len(value.magnitude)) {
        Some(exponent) => exponent >= BINARY_FLOAT_MIN_EXPONENT
            && exponent <= BINARY_FLOAT_MAX_EXPONENT,
        None => false,
    }
}

fn round_binary_float(magnitude: Natural, exponent: isize, negative: bool, precision: isize) -> Option[
    BinaryFloat,
] {
    if natural_is_zero(magnitude) {
        return Option::None
    }
    let bits = natural_bit_len(magnitude);
    let mut rounded = magnitude;
    let mut result_exponent = exponent;
    if bits > precision {
        let shift = bits - precision;
        let round_bit = natural_bit(rounded, shift - 1);
        let sticky = low_bits_nonzero(rounded, shift - 1);
        rounded = natural_shift_right(rounded, shift);
        result_exponent = exponent_add(result_exponent, shift)?;
        if round_bit && (sticky || natural_bit(rounded, 0)) {
            rounded = natural_add_small(rounded, 1.to_u32());
        }
        if natural_bit_len(rounded) > precision {
            rounded = natural_shift_right(rounded, 1);
            result_exponent = exponent_add(result_exponent, 1)?;
        }
    }
    let result = BinaryFloat { magnitude: rounded, exponent: result_exponent, negative };
    if valid_binary_float(result) {
        Option::Some(result)
    } else {
        Option::None
    }
}

fn rational_binary_exponent_parts(numerator: Natural, denominator: Natural) -> isize {
    let mut exponent = natural_bit_len(numerator) - natural_bit_len(denominator);
    let compared = if exponent >= 0 {
        natural_compare(numerator, natural_shift_left(denominator, exponent))
    } else {
        natural_compare(natural_shift_left(numerator, -exponent), denominator)
    };
    if compared < 0 {
        exponent -= 1;
    }
    exponent
}

fn binary_float_from_ratio(
    numerator: Natural,
    denominator: Natural,
    binary_exponent: isize,
    negative: bool,
    precision: isize,
) -> Option[BinaryFloat] {
    if natural_is_zero(numerator) || natural_is_zero(denominator) {
        return Option::None
    }
    let mantissa_exponent = rational_binary_exponent_parts(numerator, denominator) + 1;
    let scale = precision - mantissa_exponent;
    let scaled_numerator = if scale >= 0 {
        natural_shift_left(numerator, scale)
    } else {
        numerator
    };
    let scaled_denominator = if scale < 0 {
        natural_shift_left(denominator, -scale)
    } else {
        denominator
    };
    let Ok(divided) = natural_div_rem(scaled_numerator, scaled_denominator) else {
        return Option::None;
    };
    let mut magnitude = divided.0;
    let doubled_remainder = natural_mul_small(divided.1, 2.to_u32());
    let comparison = natural_compare(doubled_remainder, scaled_denominator);
    if comparison > 0 || (comparison == 0 && natural_bit(magnitude, 0)) {
        magnitude = natural_add_small(magnitude, 1.to_u32());
    }
    let mut exponent = exponent_add(exponent_add(mantissa_exponent, binary_exponent)?, -precision)?;
    if natural_bit_len(magnitude) > precision {
        magnitude = natural_shift_right(magnitude, 1);
        exponent = exponent_add(exponent, 1)?;
    }
    let result = BinaryFloat { magnitude, exponent, negative };
    if valid_binary_float(result) {
        Option::Some(result)
    } else {
        Option::None
    }
}

pub fn binary_float_from_rational(value: BigRat, precision: isize) -> Option[BinaryFloat] {
    if value.numerator.sign == 0 {
        Option::None
    } else {
        binary_float_from_ratio(
            value.numerator.magnitude,
            value.denominator,
            0,
            value.numerator.sign < 0,
            precision,
        )
    }
}

pub fn constant_to_binary_float(value: ConstValue, precision: isize) -> Option[BinaryFloat] {
    match value {
        ConstValue::Int(value) => binary_float_from_rational(
            rational_from_integer(value),
            precision,
        ),
        ConstValue::Rat(value) => binary_float_from_rational(value, precision),
        ConstValue::LargeFloat(value) => round_binary_float(
            value.magnitude,
            value.exponent,
            value.negative,
            precision,
        ),
        ConstValue::Complex { real, imaginary } => if component_is_zero(imaginary) {
            constant_to_binary_float(component_to_constant(real), precision)
        } else {
            Option::None
        },
        _ => Option::None,
    }
}

pub fn binary_float_from_natural(
    magnitude: Natural,
    exponent: isize,
    negative: bool,
    precision: isize,
) -> Option[BinaryFloat] {
    round_binary_float(magnitude, exponent, negative, precision)
}

pub fn binary_float_mantissa_exponent(value: BinaryFloat) -> isize {
    exponent_add(value.exponent, natural_bit_len(value.magnitude)).unwrap_or(
        if value.exponent < 0 {
            BINARY_FLOAT_MIN_EXPONENT
        } else {
            BINARY_FLOAT_MAX_EXPONENT
        },
    )
}

pub fn binary_float_neg(value: BinaryFloat) -> BinaryFloat {
    BinaryFloat { magnitude: value.magnitude, exponent: value.exponent, negative: !value.negative }
}

pub fn binary_float_mul(left: BinaryFloat, right: BinaryFloat, precision: isize) -> Option[
    BinaryFloat,
] {
    let exponent = exponent_add(left.exponent, right.exponent)?;
    round_binary_float(
        natural_mul(left.magnitude, right.magnitude),
        exponent,
        left.negative != right.negative,
        precision,
    )
}

pub fn binary_float_div(left: BinaryFloat, right: BinaryFloat, precision: isize) -> Option[
    BinaryFloat,
] {
    let exponent = exponent_add(left.exponent, -right.exponent)?;
    binary_float_from_ratio(
        left.magnitude,
        right.magnitude,
        exponent,
        left.negative != right.negative,
        precision,
    )
}

fn compare_binary_float_magnitude(left: BinaryFloat, right: BinaryFloat) -> isize {
    let left_top = binary_float_mantissa_exponent(left);
    let right_top = binary_float_mantissa_exponent(right);
    if left_top < right_top {
        return -1
    } else if left_top > right_top {
        return 1
    }
    if left.exponent == right.exponent {
        natural_compare(left.magnitude, right.magnitude)
    } else if left.exponent > right.exponent {
        natural_compare(
            natural_shift_left(left.magnitude, left.exponent - right.exponent),
            right.magnitude,
        )
    } else {
        natural_compare(
            left.magnitude,
            natural_shift_left(right.magnitude, right.exponent - left.exponent),
        )
    }
}

pub fn binary_float_compare(left: BinaryFloat, right: BinaryFloat) -> isize {
    if left.negative != right.negative {
        if left.negative {
            -1
        } else {
            1
        }
    } else {
        let compared = compare_binary_float_magnitude(left, right);
        if left.negative {
            -compared
        } else {
            compared
        }
    }
}

pub fn binary_float_add(left: BinaryFloat, right: BinaryFloat, precision: isize) -> Option[
    BinaryFloat,
] {
    let compared = compare_binary_float_magnitude(left, right);
    if left.negative != right.negative && compared == 0 {
        return Option::None
    }
    let left_top = binary_float_mantissa_exponent(left);
    let right_top = binary_float_mantissa_exponent(right);
    let top_difference = if left_top >= right_top {
        left_top - right_top
    } else {
        right_top - left_top
    };
    if top_difference > precision + 2 {
        return round_binary_float(
            if compared >= 0 {
                left.magnitude
            } else {
                right.magnitude
            },
            if compared >= 0 {
                left.exponent
            } else {
                right.exponent
            },
            if compared >= 0 {
                left.negative
            } else {
                right.negative
            },
            precision,
        )
    }
    let exponent = if left.exponent < right.exponent {
        left.exponent
    } else {
        right.exponent
    };
    let left_magnitude = natural_shift_left(left.magnitude, left.exponent - exponent);
    let right_magnitude = natural_shift_left(right.magnitude, right.exponent - exponent);
    let magnitude = if left.negative == right.negative {
        natural_add(left_magnitude, right_magnitude)
    } else if compared > 0 {
        natural_sub(left_magnitude, right_magnitude).unwrap_or(natural_zero())
    } else {
        natural_sub(right_magnitude, left_magnitude).unwrap_or(natural_zero())
    };
    if natural_is_zero(magnitude) {
        Option::None
    } else {
        round_binary_float(
            magnitude,
            exponent,
            if left.negative == right.negative {
                left.negative
            } else if compared > 0 {
                left.negative
            } else {
                right.negative
            },
            precision,
        )
    }
}

fn binary_float_pow5(exponent: isize, precision: isize) -> Option[BinaryFloat] {
    if exponent <= 27 {
        return binary_float_from_natural(
            natural_pow_small(5.to_u32(), exponent),
            0,
            false,
            precision,
        )
    }
    let mut result = binary_float_from_natural(
        natural_pow_small(5.to_u32(), 27),
        0,
        false,
        precision,
    )?;
    let mut power = exponent - 27;
    let mut factor = binary_float_from_natural(
        natural_from_uint64(5.to_u64()),
        0,
        false,
        precision + 64,
    )?;
    while power > 0 {
        if power % 2 == 1 {
            result = binary_float_mul(result, factor, precision)?;
        }
        power /= 2;
        if power > 0 {
            factor = binary_float_mul(factor, factor, precision + 64)?;
        }
    }
    Option::Some(result)
}

pub fn binary_float_from_decimal(magnitude: Natural, exponent: isize, precision: isize) -> Option[
    BinaryFloat,
] {
    let exact = BinaryFloat { magnitude, exponent, negative: false };
    if !valid_binary_float(exact) {
        return Option::None
    }
    if exponent == 0 {
        round_binary_float(exact.magnitude, exact.exponent, false, precision)
    } else {
        let power = binary_float_pow5(
            if exponent < 0 {
                -exponent
            } else {
                exponent
            },
            precision + 64,
        )?;
        if exponent < 0 {
            binary_float_div(exact, power, precision)
        } else {
            binary_float_mul(exact, power, precision)
        }
    }
}

fn hex_digit(value: isize) -> byte {
    if value < 10 {
        b'0' + value.to_u8()
    } else {
        b'a' + (value - 10).to_u8()
    }
}

fn binary_float_hex_magnitude(value: Natural) -> string {
    let bits = natural_bit_len(value);
    let digits = (bits + 3) / 4;
    let aligned = natural_shift_left(value, digits * 4 - bits);
    let builder = text::StringBuilder::with_capacity(digits);
    let mut index = digits;
    while index > 0 {
        index -= 1;
        let mut digit = 0;
        for bit in 0..4 {
            if natural_bit(aligned, index * 4 + bit) {
                digit += 1 << bit;
            }
        }
        builder.values.push(hex_digit(digit));
    }
    let mut result = builder.finish();
    while result.ends_with("0") {
        result = result.byte_slice(0, result.byte_len() - 1);
    }
    result
}

pub fn binary_float_exact_string(value: BinaryFloat) -> string {
    let exponent = binary_float_mantissa_exponent(value);
    if value.negative {
        "-"
    } else {
        ""
    }
        + "0x."
        + binary_float_hex_magnitude(value.magnitude)
        + "p"
        + if exponent >= 0 {
            f"+{exponent}"
        } else {
            exponent.to_string()
        }
}

fn round_natural_binary_shift(value: Natural, shift: isize) -> Natural {
    if shift >= 0 {
        natural_shift_left(value, shift)
    } else {
        let amount = -shift;
        let mut rounded = natural_shift_right(value, amount);
        if amount <= natural_bit_len(value) {
            let round_bit = natural_bit(value, amount - 1);
            let sticky = low_bits_nonzero(value, amount - 1);
            if round_bit && (sticky || natural_bit(rounded, 0)) {
                rounded = natural_add_small(rounded, 1.to_u32());
            }
        }
        rounded
    }
}

pub fn binary_float_round_rational(
    value: BinaryFloat,
    precision: isize,
    minimum_exponent: isize,
    maximum_exponent: isize,
) -> Option[BigRat] {
    let overflow = BinaryFloat {
        magnitude: natural_sub(natural_shift_left(natural_one(), precision + 1), natural_one()).unwrap_or(
            natural_zero(),
        ),
        exponent: maximum_exponent - precision,
        negative: false,
    };
    let absolute = BinaryFloat {
        magnitude: value.magnitude,
        exponent: value.exponent,
        negative: false,
    };
    if binary_float_compare(absolute, overflow) >= 0 {
        return Option::None
    }
    let exponent = binary_float_mantissa_exponent(value) - 1;
    let scale = if exponent < minimum_exponent {
        precision - 1 - minimum_exponent
    } else {
        precision - 1 - exponent
    };
    let rounded = round_natural_binary_shift(value.magnitude, value.exponent + scale);
    if natural_is_zero(rounded) {
        return Option::Some(rational_zero())
    }
    let sign = if value.negative {
        -1
    } else {
        1
    };
    let result = if scale >= 0 {
        rational_new(integer_from_parts(sign, rounded), natural_shift_left(natural_one(), scale))
    } else {
        rational_new(integer_from_parts(sign, natural_shift_left(rounded, -scale)), natural_one())
    };
    match result {
        Ok(value) => Option::Some(value),
        Err(_) => Option::None,
    }
}

pub fn binary_float_default_precision() -> isize {
    BINARY_FLOAT_PRECISION
}
