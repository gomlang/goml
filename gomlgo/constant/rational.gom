package constant;

pub struct BigRat {
    pub numerator: BigInt,
    pub denominator: Natural,
}

pub fn rational_new(numerator: BigInt, denominator: Natural) -> Result[BigRat, string] {
    if natural_is_zero(denominator) {
        return Result::Err("division by zero")
    } else if numerator.sign == 0 {
        return Result::Ok(BigRat { numerator: integer_zero(), denominator: natural_one() })
    }
    let divisor = natural_gcd(numerator.magnitude, denominator);
    let reduced_numerator = natural_div_rem(numerator.magnitude, divisor)?.0;
    let reduced_denominator = natural_div_rem(denominator, divisor)?.0;
    Result::Ok(
        BigRat {
            numerator: integer_from_parts(numerator.sign, reduced_numerator),
            denominator: reduced_denominator,
        },
    )
}

pub fn rational_from_integer(value: BigInt) -> BigRat {
    BigRat { numerator: integer_copy(value), denominator: natural_one() }
}

pub fn rational_zero() -> BigRat {
    rational_from_integer(integer_zero())
}

pub fn rational_neg(value: BigRat) -> BigRat {
    BigRat { numerator: integer_neg(value.numerator), denominator: natural_copy(value.denominator) }
}

pub fn rational_add(left: BigRat, right: BigRat) -> BigRat {
    let left_scaled = integer_mul(
        left.numerator,
        integer_from_parts(1, natural_copy(right.denominator)),
    );
    let right_scaled = integer_mul(
        right.numerator,
        integer_from_parts(1, natural_copy(left.denominator)),
    );
    rational_new(
        integer_add(left_scaled, right_scaled),
        natural_mul(left.denominator, right.denominator),
    ).unwrap_or(rational_zero())
}

pub fn rational_sub(left: BigRat, right: BigRat) -> BigRat {
    rational_add(left, rational_neg(right))
}

pub fn rational_mul(left: BigRat, right: BigRat) -> BigRat {
    rational_new(
        integer_mul(left.numerator, right.numerator),
        natural_mul(left.denominator, right.denominator),
    ).unwrap_or(rational_zero())
}

pub fn rational_div(left: BigRat, right: BigRat) -> Result[BigRat, string] {
    if right.numerator.sign == 0 {
        return Result::Err("division by zero")
    }
    let sign = left.numerator.sign * right.numerator.sign;
    let magnitude = natural_mul(left.numerator.magnitude, right.denominator);
    let denominator = natural_mul(left.denominator, right.numerator.magnitude);
    rational_new(integer_from_parts(sign, magnitude), denominator)
}

pub fn rational_compare(left: BigRat, right: BigRat) -> isize {
    integer_compare(
        integer_mul(left.numerator, integer_from_parts(1, natural_copy(right.denominator))),
        integer_mul(right.numerator, integer_from_parts(1, natural_copy(left.denominator))),
    )
}

pub fn rational_is_integer(value: BigRat) -> bool {
    natural_compare(value.denominator, natural_one()) == 0
}

pub fn rational_to_integer(value: BigRat) -> Option[BigInt] {
    if rational_is_integer(value) {
        Option::Some(integer_copy(value.numerator))
    } else {
        Option::None
    }
}

pub fn rational_to_string(value: BigRat) -> string {
    if rational_is_integer(value) {
        integer_to_string(value.numerator)
    } else {
        integer_to_string(value.numerator) + "/" + natural_to_string(value.denominator)
    }
}
