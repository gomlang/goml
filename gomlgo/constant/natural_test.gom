package constant;

use std::testing;

fn parse_natural(value: string) -> Natural {
    testing::expect_ok(natural_parse_digits(value, 10.to_u32()), "failed to parse natural")
}

#[test]
fn parses_and_formats_values_larger_than_uint64() -> () {
    let value = parse_natural("1267650600228229401496703205379");
    testing::assert_eq(natural_to_string(value), "1267650600228229401496703205379");
    testing::assert_eq(natural_bit_len(value), 101);
    testing::assert(natural_bit(value, 100));
    testing::assert(natural_bit(value, 1));
    testing::assert(natural_bit(value, 0))
}

#[test]
fn arithmetic_preserves_all_limbs() -> () {
    let left = parse_natural("18446744073709551617");
    let right = parse_natural("4294967297");
    testing::assert_eq(natural_to_string(natural_add(left, right)), "18446744078004518914");
    testing::assert_eq(
        natural_to_string(natural_sub(left, right).unwrap_or(natural_zero())),
        "18446744069414584320",
    );
    testing::assert_eq(natural_to_string(natural_mul(left, right)), "79228162532711081671548469249")
}

#[test]
fn division_round_trips_large_values() -> () {
    let numerator = parse_natural("79228162532711081671548469252");
    let denominator = parse_natural("4294967297");
    let divided = testing::expect_ok(
        natural_div_rem(numerator, denominator),
        "large division failed",
    );
    testing::assert_eq(natural_to_string(divided.0), "18446744073709551617");
    testing::assert_eq(natural_to_string(divided.1), "3");
    testing::assert_eq(
        natural_to_string(natural_gcd(parse_natural("48"), parse_natural("18"))),
        "6",
    )
}

#[test]
fn shifts_across_limb_boundaries() -> () {
    let shifted = natural_shift_left(natural_one(), 100);
    testing::assert_eq(natural_to_string(shifted), "1267650600228229401496703205376");
    testing::assert_eq(natural_to_string(natural_shift_right(shifted, 68)), "4294967296");
    testing::assert_eq(natural_to_string(natural_shift_right(shifted, 100)), "1");
    testing::assert(natural_is_zero(natural_shift_right(shifted, 101)))
}

#[test]
fn parses_binary_octal_and_hexadecimal_digits() -> () {
    testing::assert_eq(
        natural_to_string(
            testing::expect_ok(
                natural_parse_digits("ffff_ffff_ffff_ffff", 16.to_u32()),
                "hex parse failed",
            ),
        ),
        "18446744073709551615",
    );
    testing::assert_eq(
        natural_to_string(
            testing::expect_ok(natural_parse_digits("111111", 2.to_u32()), "binary parse failed"),
        ),
        "63",
    );
    testing::assert_eq(
        natural_to_string(
            testing::expect_ok(natural_parse_digits("777", 8.to_u32()), "octal parse failed"),
        ),
        "511",
    )
}

#[test]
fn division_by_single_limb_preserves_remainder_and_operands() -> () {
    let numerator = natural_add_small(natural_shift_left(natural_one(), 200), 123.to_u32());
    let original = natural_to_string(numerator);
    for divisor in Vec::from_array([1.to_u32(), 97.to_u32(), 4294967295.to_u32()]) {
        let denominator = natural_from_uint64(divisor.to_u64());
        let divided = testing::expect_ok(natural_div_rem(numerator, denominator), "division failed");
        testing::assert(natural_compare(divided.1, denominator) < 0);
        testing::assert_eq(
            natural_to_string(natural_add(natural_mul(divided.0, denominator), divided.1)),
            original,
        );
        testing::assert_eq(natural_to_string(numerator), original);
        testing::assert_eq(natural_to_string(denominator), divisor.to_string())
    }
    testing::assert(natural_div_rem(numerator, natural_zero()).is_err())
}

#[test]
fn decimal_formatting_preserves_limbs_and_zero_padded_chunks() -> () {
    for text in[
        "18446744073709551616",
        "999999999999999999999999999",
        "1000000000000000000000000000",
        "1000000000000000000000000001",
        "1606938044258990275541962092341162602522202993782792835301376",
    ] {
        let value = testing::expect_ok(natural_parse_digits(text, 10), "parse failed");
        let original = natural_copy(value);
        testing::assert_eq(natural_to_string(value), text);
        testing::assert_eq(value.limbs.len(), original.limbs.len());
        for index in 0..original.limbs.len() {
            testing::assert_eq(value.limbs[index], original.limbs[index]);
        }
        testing::assert_eq(natural_to_string(value), text);
    }
}
