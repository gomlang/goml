package ast;

use std::json;
use std::testing;

#[test]
fn typed_fields_preserve_null_and_empty_node_lists() -> () {
    let cases: Vec[Option[Vec[Node]]] = Vec::from_array([Option::None, Option::Some(Vec::new())]);
    for list in cases {
        let typed = typed_node(
            Kind::FieldList,
            10,
            20,
            Fields::FieldList { opening: 10, list, closing: 19 },
        );
        let legacy = node(
            Kind::FieldList,
            10,
            20,
            Vec::from_array(
                [
                    field("opening", int_value(10)),
                    field(
                        "list",
                        match list {
                            Some(values) => nodes(values),
                            None => null(),
                        },
                    ),
                    field("closing", int_value(19)),
                ],
            ),
        );
        testing::assert_eq(json::encode(to_json(typed)), json::encode(to_json(legacy)));
        testing::assert(get_field(typed, "list").present);
        testing::assert(!get_field(typed, "unknown").present);
    }
}
