package ast;

pub enum Fields {
    Named(Vec[(string, Value)]),
    Ident(string),
    Literal {
        token: string,
        value: string,
    },
    Comment {
        slash: isize,
        text: string,
    },
    CommentGroup {
        list: Vec[Node],
    },
    ParenExpr {
        lparen: isize,
        x: Node,
        rparen: isize,
    },
    FuncLit {
        type_node: Node,
        body: Node,
    },
    TypeAssertExpr {
        x: Node,
        lparen: isize,
        type_node: Option[Node],
        rparen: isize,
    },
    SelectorExpr {
        x: Node,
        sel: Node,
    },
    SliceExpr {
        x: Node,
        lbrack: isize,
        low: Option[Node],
        high: Option[Node],
        max: Option[Node],
        slice3: bool,
        rbrack: isize,
    },
    IndexExpr {
        x: Node,
        lbrack: isize,
        index: Node,
        rbrack: isize,
    },
    IndexListExpr {
        x: Node,
        lbrack: isize,
        indices: Vec[Node],
        rbrack: isize,
    },
    CallExpr {
        fun: Node,
        lparen: isize,
        args: Option[Vec[Node]],
        ellipsis: isize,
        rparen: isize,
    },
    KeyValueExpr {
        key: Node,
        colon: isize,
        value: Node,
    },
    CompositeLit {
        type_node: Option[Node],
        lbrace: isize,
        elts: Option[Vec[Node]],
        rbrace: isize,
        incomplete: bool,
    },
    StarExpr {
        star: isize,
        x: Node,
    },
    UnaryExpr {
        op_pos: isize,
        op: string,
        x: Node,
    },
    BinaryExpr {
        x: Node,
        op_pos: isize,
        op: string,
        y: Node,
    },
    ImportSpec {
        name: Option[Node],
        path: Node,
        end_pos: isize,
    },
    ValueSpec {
        names: Vec[Node],
        type_node: Option[Node],
        values: Option[Vec[Node]],
    },
    TypeSpec {
        name: Node,
        type_params: Option[Node],
        assign: isize,
        type_node: Node,
    },
    GenDecl {
        token_pos: isize,
        token: string,
        lparen: isize,
        specs: Option[Vec[Node]],
        rparen: isize,
    },
    FuncDecl {
        recv: Option[Node],
        name: Node,
        type_node: Node,
        body: Option[Node],
    },
    File {
        package_pos: isize,
        name: Node,
        decls: Option[Vec[Node]],
        file_start: isize,
        file_end: isize,
        imports: Option[Vec[Node]],
        comments: Option[Vec[Node]],
        go_version: string,
    },
    BadExpr {
        from: isize,
        to: isize,
    },
    BadStmt {
        from: isize,
        to: isize,
    },
    BadDecl {
        from: isize,
        to: isize,
    },
    Field {
        names: Option[Vec[Node]],
        type_node: Option[Node],
        tag: Option[Node],
    },
    FieldList {
        opening: isize,
        list: Option[Vec[Node]],
        closing: isize,
    },
    ExprStmt {
        x: Node,
    },
    BlockStmt {
        lbrace: isize,
        list: Option[Vec[Node]],
        rbrace: isize,
    },
    SendStmt {
        channel: Node,
        arrow: isize,
        value: Node,
    },
    IncDecStmt {
        x: Node,
        token_pos: isize,
        token: string,
    },
    RangeStmt {
        for_pos: isize,
        key: Option[Node],
        value: Option[Node],
        token_pos: isize,
        token: string,
        range_pos: isize,
        x: Option[Node],
        body: Option[Node],
    },
    AssignStmt {
        lhs: Vec[Node],
        token_pos: isize,
        token: string,
        rhs: Vec[Node],
    },
    EmptyStmt {
        semicolon: isize,
        implicit: bool,
    },
    ReturnStmt {
        return_pos: isize,
        results: Option[Vec[Node]],
    },
    BranchStmt {
        token_pos: isize,
        token: string,
        label: Option[Node],
    },
    IfStmt {
        if_pos: isize,
        init: Option[Node],
        cond: Node,
        body: Node,
        else_node: Option[Node],
    },
    CaseClause {
        case_pos: isize,
        list: Option[Vec[Node]],
        colon: isize,
        body: Option[Vec[Node]],
    },
    CommClause {
        case_pos: isize,
        comm: Option[Node],
        colon: isize,
        body: Option[Vec[Node]],
    },
    SelectStmt {
        select_pos: isize,
        body: Node,
    },
    ForStmt {
        for_pos: isize,
        init: Option[Node],
        cond: Option[Node],
        post: Option[Node],
        body: Node,
    },
    LabeledStmt {
        label: Node,
        colon: isize,
        stmt: Node,
    },
    DeclStmt {
        decl: Node,
    },
    Ellipsis {
        ellipsis: isize,
        elt: Option[Node],
    },
    ArrayType {
        lbrack: isize,
        len: Option[Node],
        elt: Node,
    },
    FuncType {
        func_pos: isize,
        type_params: Option[Node],
        params: Node,
        results: Option[Node],
    },
    StructType {
        struct_pos: isize,
        fields: Node,
        incomplete: bool,
    },
    InterfaceType {
        interface_pos: isize,
        methods: Node,
        incomplete: bool,
    },
    MapType {
        map_pos: isize,
        key: Node,
        value: Node,
    },
    ChanType {
        begin: isize,
        arrow: isize,
        dir: isize,
        value: Node,
    },
}

pub fn field_entries(value: Node) -> Vec[(string, Value)] {
    match value.fields {
        Named(fields) => fields,
        Ident(name) => Vec::from_array(
            [("name_pos", Value::Int(value.span.start)), ("name", Value::String(name))],
        ),
        Literal { token, value: literal } => Vec::from_array(
            [
                ("value_pos", Value::Int(value.span.start)),
                ("value_end", Value::Int(value.span.end)),
                ("token", Value::String(token)),
                ("value", Value::String(literal)),
            ],
        ),
        Fields::Comment { slash: field_slash, text: field_text } => Vec::from_array(
            [("slash", Value::Int(field_slash)), ("text", Value::String(field_text))],
        ),
        Fields::CommentGroup { list: field_list } => Vec::from_array(
            [("list", Value::Nodes(field_list))],
        ),
        Fields::ParenExpr { lparen: field_lparen, x: field_x, rparen: field_rparen } => Vec::from_array(
            [
                ("lparen", Value::Int(field_lparen)),
                ("x", Value::Node(field_x)),
                ("rparen", Value::Int(field_rparen)),
            ],
        ),
        Fields::FuncLit { type_node: field_type, body: field_body } => Vec::from_array(
            [("type", Value::Node(field_type)), ("body", Value::Node(field_body))],
        ),
        Fields::TypeAssertExpr {
            x: field_x,
            lparen: field_lparen,
            type_node: field_type,
            rparen: field_rparen,
        } => Vec::from_array(
            [
                ("x", Value::Node(field_x)),
                ("lparen", Value::Int(field_lparen)),
                ("type", optional_node(field_type)),
                ("rparen", Value::Int(field_rparen)),
            ],
        ),
        Fields::SelectorExpr { x: field_x, sel: field_sel } => Vec::from_array(
            [("x", Value::Node(field_x)), ("sel", Value::Node(field_sel))],
        ),
        Fields::SliceExpr {
            x: field_x,
            lbrack: field_lbrack,
            low: field_low,
            high: field_high,
            max: field_max,
            slice3: field_slice3,
            rbrack: field_rbrack,
        } => Vec::from_array(
            [
                ("x", Value::Node(field_x)),
                ("lbrack", Value::Int(field_lbrack)),
                ("low", optional_node(field_low)),
                ("high", optional_node(field_high)),
                ("max", optional_node(field_max)),
                ("slice3", Value::Bool(field_slice3)),
                ("rbrack", Value::Int(field_rbrack)),
            ],
        ),
        Fields::IndexExpr {
            x: field_x,
            lbrack: field_lbrack,
            index: field_index,
            rbrack: field_rbrack,
        } => Vec::from_array(
            [
                ("x", Value::Node(field_x)),
                ("lbrack", Value::Int(field_lbrack)),
                ("index", Value::Node(field_index)),
                ("rbrack", Value::Int(field_rbrack)),
            ],
        ),
        Fields::IndexListExpr {
            x: field_x,
            lbrack: field_lbrack,
            indices: field_indices,
            rbrack: field_rbrack,
        } => Vec::from_array(
            [
                ("x", Value::Node(field_x)),
                ("lbrack", Value::Int(field_lbrack)),
                ("indices", Value::Nodes(field_indices)),
                ("rbrack", Value::Int(field_rbrack)),
            ],
        ),
        Fields::CallExpr {
            fun: field_fun,
            lparen: field_lparen,
            args: field_args,
            ellipsis: field_ellipsis,
            rparen: field_rparen,
        } => Vec::from_array(
            [
                ("fun", Value::Node(field_fun)),
                ("lparen", Value::Int(field_lparen)),
                (
                    "args",
                    match field_args {
                        Some(children) => Value::Nodes(children),
                        None => Value::Null,
                    },
                ),
                ("ellipsis", Value::Int(field_ellipsis)),
                ("rparen", Value::Int(field_rparen)),
            ],
        ),
        Fields::KeyValueExpr { key: field_key, colon: field_colon, value: field_value } => Vec::from_array(
            [
                ("key", Value::Node(field_key)),
                ("colon", Value::Int(field_colon)),
                ("value", Value::Node(field_value)),
            ],
        ),
        Fields::CompositeLit {
            type_node: field_type,
            lbrace: field_lbrace,
            elts: field_elts,
            rbrace: field_rbrace,
            incomplete: field_incomplete,
        } => Vec::from_array(
            [
                ("type", optional_node(field_type)),
                ("lbrace", Value::Int(field_lbrace)),
                (
                    "elts",
                    match field_elts {
                        Some(children) => Value::Nodes(children),
                        None => Value::Null,
                    },
                ),
                ("rbrace", Value::Int(field_rbrace)),
                ("incomplete", Value::Bool(field_incomplete)),
            ],
        ),
        Fields::StarExpr { star: field_star, x: field_x } => Vec::from_array(
            [("star", Value::Int(field_star)), ("x", Value::Node(field_x))],
        ),
        Fields::UnaryExpr { op_pos: field_op_pos, op: field_op, x: field_x } => Vec::from_array(
            [
                ("op_pos", Value::Int(field_op_pos)),
                ("op", Value::String(field_op)),
                ("x", Value::Node(field_x)),
            ],
        ),
        Fields::BinaryExpr { x: field_x, op_pos: field_op_pos, op: field_op, y: field_y } => Vec::from_array(
            [
                ("x", Value::Node(field_x)),
                ("op_pos", Value::Int(field_op_pos)),
                ("op", Value::String(field_op)),
                ("y", Value::Node(field_y)),
            ],
        ),
        Fields::ImportSpec { name: field_name, path: field_path_node, end_pos: field_end_pos } => Vec::from_array(
            [
                ("doc", Value::Null),
                ("name", optional_node(field_name)),
                ("path", Value::Node(field_path_node)),
                ("comment", Value::Null),
                ("end_pos", Value::Int(field_end_pos)),
            ],
        ),
        Fields::ValueSpec { names: field_names, type_node: field_type, values: field_values } => Vec::from_array(
            [
                ("doc", Value::Null),
                ("names", Value::Nodes(field_names)),
                ("type", optional_node(field_type)),
                (
                    "values",
                    match field_values {
                        Some(children) => Value::Nodes(children),
                        None => Value::Null,
                    },
                ),
                ("comment", Value::Null),
            ],
        ),
        Fields::TypeSpec {
            name: field_name,
            type_params: field_type_params,
            assign: field_assign,
            type_node: field_type,
        } => Vec::from_array(
            [
                ("doc", Value::Null),
                ("name", Value::Node(field_name)),
                ("type_params", optional_node(field_type_params)),
                ("assign", Value::Int(field_assign)),
                ("type", Value::Node(field_type)),
                ("comment", Value::Null),
            ],
        ),
        Fields::GenDecl {
            token_pos: field_token_pos,
            token: field_token,
            lparen: field_lparen,
            specs: field_specs,
            rparen: field_rparen,
        } => Vec::from_array(
            [
                ("doc", Value::Null),
                ("token_pos", Value::Int(field_token_pos)),
                ("token", Value::String(field_token)),
                ("lparen", Value::Int(field_lparen)),
                (
                    "specs",
                    match field_specs {
                        Some(children) => Value::Nodes(children),
                        None => Value::Null,
                    },
                ),
                ("rparen", Value::Int(field_rparen)),
            ],
        ),
        Fields::FuncDecl {
            recv: field_recv,
            name: field_name,
            type_node: field_type,
            body: field_body,
        } => Vec::from_array(
            [
                ("doc", Value::Null),
                ("recv", optional_node(field_recv)),
                ("name", Value::Node(field_name)),
                ("type", Value::Node(field_type)),
                ("body", optional_node(field_body)),
            ],
        ),
        Fields::File {
            package_pos: field_package,
            name: field_name,
            decls: field_decls,
            file_start: field_file_start,
            file_end: field_file_end,
            imports: field_imports,
            comments: field_comments,
            go_version: field_go_version,
        } => Vec::from_array(
            [
                ("doc", Value::Null),
                ("package", Value::Int(field_package)),
                ("name", Value::Node(field_name)),
                (
                    "decls",
                    match field_decls {
                        Some(children) => Value::Nodes(children),
                        None => Value::Null,
                    },
                ),
                ("file_start", Value::Int(field_file_start)),
                ("file_end", Value::Int(field_file_end)),
                (
                    "imports",
                    match field_imports {
                        Some(children) => Value::Nodes(children),
                        None => Value::Null,
                    },
                ),
                (
                    "comments",
                    match field_comments {
                        Some(children) => Value::Nodes(children),
                        None => Value::Null,
                    },
                ),
                ("go_version", Value::String(field_go_version)),
            ],
        ),
        Fields::BadExpr { from: field_from, to: field_to } => Vec::from_array(
            [("from", Value::Int(field_from)), ("to", Value::Int(field_to))],
        ),
        Fields::BadStmt { from: field_from, to: field_to } => Vec::from_array(
            [("from", Value::Int(field_from)), ("to", Value::Int(field_to))],
        ),
        Fields::BadDecl { from: field_from, to: field_to } => Vec::from_array(
            [("from", Value::Int(field_from)), ("to", Value::Int(field_to))],
        ),
        Fields::Field { names: field_names, type_node: field_type, tag: field_tag } => Vec::from_array(
            [
                ("doc", Value::Null),
                (
                    "names",
                    match field_names {
                        Some(children) => Value::Nodes(children),
                        None => Value::Null,
                    },
                ),
                ("type", optional_node(field_type)),
                ("tag", optional_node(field_tag)),
                ("comment", Value::Null),
            ],
        ),
        Fields::FieldList { opening: field_opening, list: field_list, closing: field_closing } => Vec::from_array(
            [
                ("opening", Value::Int(field_opening)),
                (
                    "list",
                    match field_list {
                        Some(children) => Value::Nodes(children),
                        None => Value::Null,
                    },
                ),
                ("closing", Value::Int(field_closing)),
            ],
        ),
        Fields::ExprStmt { x: field_x } => Vec::from_array([("x", Value::Node(field_x))]),
        Fields::BlockStmt { lbrace: field_lbrace, list: field_list, rbrace: field_rbrace } => Vec::from_array(
            [
                ("lbrace", Value::Int(field_lbrace)),
                (
                    "list",
                    match field_list {
                        Some(children) => Value::Nodes(children),
                        None => Value::Null,
                    },
                ),
                ("rbrace", Value::Int(field_rbrace)),
            ],
        ),
        Fields::SendStmt { channel: field_chan, arrow: field_arrow, value: field_value } => Vec::from_array(
            [
                ("chan", Value::Node(field_chan)),
                ("arrow", Value::Int(field_arrow)),
                ("value", Value::Node(field_value)),
            ],
        ),
        Fields::IncDecStmt { x: field_x, token_pos: field_token_pos, token: field_token } => Vec::from_array(
            [
                ("x", Value::Node(field_x)),
                ("token_pos", Value::Int(field_token_pos)),
                ("token", Value::String(field_token)),
            ],
        ),
        Fields::RangeStmt {
            for_pos: field_for,
            key: field_key,
            value: field_value,
            token_pos: field_token_pos,
            token: field_token,
            range_pos: field_range,
            x: field_x,
            body: field_body,
        } => Vec::from_array(
            [
                ("for", Value::Int(field_for)),
                ("key", optional_node(field_key)),
                ("value", optional_node(field_value)),
                ("token_pos", Value::Int(field_token_pos)),
                ("token", Value::String(field_token)),
                ("range", Value::Int(field_range)),
                ("x", optional_node(field_x)),
                ("body", optional_node(field_body)),
            ],
        ),
        Fields::AssignStmt {
            lhs: field_lhs,
            token_pos: field_token_pos,
            token: field_token,
            rhs: field_rhs,
        } => Vec::from_array(
            [
                ("lhs", Value::Nodes(field_lhs)),
                ("token_pos", Value::Int(field_token_pos)),
                ("token", Value::String(field_token)),
                ("rhs", Value::Nodes(field_rhs)),
            ],
        ),
        Fields::EmptyStmt { semicolon: field_semicolon, implicit: field_implicit } => Vec::from_array(
            [("semicolon", Value::Int(field_semicolon)), ("implicit", Value::Bool(field_implicit))],
        ),
        Fields::ReturnStmt { return_pos: field_return, results: field_results } => Vec::from_array(
            [
                ("return", Value::Int(field_return)),
                (
                    "results",
                    match field_results {
                        Some(children) => Value::Nodes(children),
                        None => Value::Null,
                    },
                ),
            ],
        ),
        Fields::BranchStmt { token_pos: field_token_pos, token: field_token, label: field_label } => Vec::from_array(
            [
                ("token_pos", Value::Int(field_token_pos)),
                ("token", Value::String(field_token)),
                ("label", optional_node(field_label)),
            ],
        ),
        Fields::IfStmt {
            if_pos: field_if,
            init: field_init,
            cond: field_cond,
            body: field_body,
            else_node: field_else,
        } => Vec::from_array(
            [
                ("if", Value::Int(field_if)),
                ("init", optional_node(field_init)),
                ("cond", Value::Node(field_cond)),
                ("body", Value::Node(field_body)),
                ("else", optional_node(field_else)),
            ],
        ),
        Fields::CaseClause {
            case_pos: field_case,
            list: field_list,
            colon: field_colon,
            body: field_body,
        } => Vec::from_array(
            [
                ("case", Value::Int(field_case)),
                (
                    "list",
                    match field_list {
                        Some(children) => Value::Nodes(children),
                        None => Value::Null,
                    },
                ),
                ("colon", Value::Int(field_colon)),
                (
                    "body",
                    match field_body {
                        Some(children) => Value::Nodes(children),
                        None => Value::Null,
                    },
                ),
            ],
        ),
        Fields::CommClause {
            case_pos: field_case,
            comm: field_comm,
            colon: field_colon,
            body: field_body,
        } => Vec::from_array(
            [
                ("case", Value::Int(field_case)),
                ("comm", optional_node(field_comm)),
                ("colon", Value::Int(field_colon)),
                (
                    "body",
                    match field_body {
                        Some(children) => Value::Nodes(children),
                        None => Value::Null,
                    },
                ),
            ],
        ),
        Fields::SelectStmt { select_pos: field_select, body: field_body } => Vec::from_array(
            [("select", Value::Int(field_select)), ("body", Value::Node(field_body))],
        ),
        Fields::ForStmt {
            for_pos: field_for,
            init: field_init,
            cond: field_cond,
            post: field_post,
            body: field_body,
        } => Vec::from_array(
            [
                ("for", Value::Int(field_for)),
                ("init", optional_node(field_init)),
                ("cond", optional_node(field_cond)),
                ("post", optional_node(field_post)),
                ("body", Value::Node(field_body)),
            ],
        ),
        Fields::LabeledStmt { label: field_label, colon: field_colon, stmt: field_stmt } => Vec::from_array(
            [
                ("label", Value::Node(field_label)),
                ("colon", Value::Int(field_colon)),
                ("stmt", Value::Node(field_stmt)),
            ],
        ),
        Fields::DeclStmt { decl: field_decl } => Vec::from_array(
            [("decl", Value::Node(field_decl))],
        ),
        Fields::Ellipsis { ellipsis: field_ellipsis, elt: field_elt } => Vec::from_array(
            [("ellipsis", Value::Int(field_ellipsis)), ("elt", optional_node(field_elt))],
        ),
        Fields::ArrayType { lbrack: field_lbrack, len: field_len, elt: field_elt } => Vec::from_array(
            [
                ("lbrack", Value::Int(field_lbrack)),
                ("len", optional_node(field_len)),
                ("elt", Value::Node(field_elt)),
            ],
        ),
        Fields::FuncType {
            func_pos: field_func,
            type_params: field_type_params,
            params: field_params,
            results: field_results,
        } => Vec::from_array(
            [
                ("func", Value::Int(field_func)),
                ("type_params", optional_node(field_type_params)),
                ("params", Value::Node(field_params)),
                ("results", optional_node(field_results)),
            ],
        ),
        Fields::StructType {
            struct_pos: field_struct,
            fields: field_fields,
            incomplete: field_incomplete,
        } => Vec::from_array(
            [
                ("struct", Value::Int(field_struct)),
                ("fields", Value::Node(field_fields)),
                ("incomplete", Value::Bool(field_incomplete)),
            ],
        ),
        Fields::InterfaceType {
            interface_pos: field_interface,
            methods: field_methods,
            incomplete: field_incomplete,
        } => Vec::from_array(
            [
                ("interface", Value::Int(field_interface)),
                ("methods", Value::Node(field_methods)),
                ("incomplete", Value::Bool(field_incomplete)),
            ],
        ),
        Fields::MapType { map_pos: field_map, key: field_key, value: field_value } => Vec::from_array(
            [
                ("map", Value::Int(field_map)),
                ("key", Value::Node(field_key)),
                ("value", Value::Node(field_value)),
            ],
        ),
        Fields::ChanType {
            begin: field_begin,
            arrow: field_arrow,
            dir: field_dir,
            value: field_value,
        } => Vec::from_array(
            [
                ("begin", Value::Int(field_begin)),
                ("arrow", Value::Int(field_arrow)),
                ("dir", Value::Int(field_dir)),
                ("value", Value::Node(field_value)),
            ],
        ),
    }
}

pub fn get_field(value: Node, name: string) -> FieldLookup {
    let result = match value.fields {
        Named(fields) => {
            for entry in fields {
                if entry.0 == name {
                    return FieldLookup { value: entry.1, present: true }
                }
            }
            return FieldLookup { value: Value::Null, present: false }
        },
        Ident(text) => if name == "name_pos" {
            Value::Int(value.span.start)
        } else if name == "name" {
            Value::String(text)
        } else {
            return FieldLookup { value: Value::Null, present: false }
        },
        Literal { token, value: text } => if name == "value_pos" {
            Value::Int(value.span.start)
        } else if name == "value_end" {
            Value::Int(value.span.end)
        } else if name == "token" {
            Value::String(token)
        } else if name == "value" {
            Value::String(text)
        } else {
            return FieldLookup { value: Value::Null, present: false }
        },
        Fields::Comment { slash: field_slash, text: field_text } => match name {
            "slash" => Value::Int(field_slash),
            "text" => Value::String(field_text),
            _ => return FieldLookup { value: Value::Null, present: false },
        },
        Fields::CommentGroup { list: field_list } => match name {
            "list" => Value::Nodes(field_list),
            _ => return FieldLookup { value: Value::Null, present: false },
        },
        Fields::ParenExpr { lparen: field_lparen, x: field_x, rparen: field_rparen } => match name {
