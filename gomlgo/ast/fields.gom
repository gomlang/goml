            },
            "rparen" => Value::Int(field_rparen),
            _ => return FieldLookup { value: Value::Null, present: false },
        },
        Fields::FuncDecl {
            recv: field_recv,
            name: field_name,
            type_node: field_type,
            body: field_body,
        } => match name {
            "doc" => Value::Null,
            "recv" => optional_node(field_recv),
            "name" => Value::Node(field_name),
            "type" => Value::Node(field_type),
            "body" => optional_node(field_body),
            _ => return FieldLookup { value: Value::Null, present: false },
        },
        Fields::File {
            package_pos: field_package,
            name: field_name,
            decls: field_decls,
            file_start: field_file_start,
            file_end: field_file_end,
            imports: field_imports,
            comments: field_comments,
            go_version: field_go_version,
        } => match name {
            "doc" => Value::Null,
            "package" => Value::Int(field_package),
            "name" => Value::Node(field_name),
            "decls" => match field_decls {
                Some(children) => Value::Nodes(children),
                None => Value::Null,
            },
            "file_start" => Value::Int(field_file_start),
            "file_end" => Value::Int(field_file_end),
            "imports" => match field_imports {
                Some(children) => Value::Nodes(children),
                None => Value::Null,
            },
            "comments" => match field_comments {
                Some(children) => Value::Nodes(children),
                None => Value::Null,
            },
            "go_version" => Value::String(field_go_version),
            _ => return FieldLookup { value: Value::Null, present: false },
        },
        Fields::BadExpr { from: field_from, to: field_to } => match name {
            "from" => Value::Int(field_from),
            "to" => Value::Int(field_to),
            _ => return FieldLookup { value: Value::Null, present: false },
        },
        Fields::BadStmt { from: field_from, to: field_to } => match name {
            "from" => Value::Int(field_from),
            "to" => Value::Int(field_to),
            _ => return FieldLookup { value: Value::Null, present: false },
        },
        Fields::BadDecl { from: field_from, to: field_to } => match name {
            "from" => Value::Int(field_from),
            "to" => Value::Int(field_to),
            _ => return FieldLookup { value: Value::Null, present: false },
        },
        Fields::Field { names: field_names, type_node: field_type, tag: field_tag } => match name {
            "doc" => Value::Null,
            "names" => match field_names {
                Some(children) => Value::Nodes(children),
                None => Value::Null,
            },
            "type" => optional_node(field_type),
            "tag" => optional_node(field_tag),
            "comment" => Value::Null,
            _ => return FieldLookup { value: Value::Null, present: false },
        },
        Fields::FieldList { opening: field_opening, list: field_list, closing: field_closing } => match name {
