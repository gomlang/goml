package ast;

use std::json;

#[derive(PartialEq, Eq, ToString)]
pub enum Kind {
    Comment,
    CommentGroup,
    Field,
    FieldList,
    BadExpr,
    Ident,
    Ellipsis,
    BasicLit,
    FuncLit,
    CompositeLit,
    ParenExpr,
    SelectorExpr,
    IndexExpr,
    IndexListExpr,
    SliceExpr,
    TypeAssertExpr,
    CallExpr,
    StarExpr,
    UnaryExpr,
    BinaryExpr,
    KeyValueExpr,
    ArrayType,
    StructType,
    FuncType,
    InterfaceType,
    MapType,
    ChanType,
    BadStmt,
    DeclStmt,
    EmptyStmt,
    LabeledStmt,
    ExprStmt,
    SendStmt,
    IncDecStmt,
    AssignStmt,
    GoStmt,
    DeferStmt,
    ReturnStmt,
    BranchStmt,
    BlockStmt,
    IfStmt,
    CaseClause,
    SwitchStmt,
    TypeSwitchStmt,
    CommClause,
    SelectStmt,
    ForStmt,
    RangeStmt,
    ImportSpec,
    ValueSpec,
    TypeSpec,
    BadDecl,
    GenDecl,
    FuncDecl,
    File,
}

pub struct Span {
    pub start: isize,
    pub end: isize,
}

pub struct Node {
    pub kind: Kind,
    pub span: Span,
    pub fields: Fields,
}

pub enum Value {
    Null,
    Node(Node),
    Nodes(Vec[Node]),
    String(string),
    Int(isize),
    Bool(bool),
}

pub struct FieldLookup {
    pub value: Value,
    pub present: bool,
}

pub fn span(start: isize, end: isize) -> Span {
    Span { start, end }
}

pub fn node(kind: Kind, start: isize, end: isize, fields: Vec[(string, Value)]) -> Node {
    Node { kind, span: span(start, end), fields: Fields::Named(fields) }
}

pub fn ident(start: isize, end: isize, name: string) -> Node {
    Node { kind: Kind::Ident, span: span(start, end), fields: Fields::Ident(name) }
}

pub fn literal(start: isize, end: isize, token: string, value: string) -> Node {
    Node { kind: Kind::BasicLit, span: span(start, end), fields: Fields::Literal { token, value } }
}

pub fn kind_equal(left: Kind, right: Kind) -> bool {
    left == right
}

pub fn kind_name(kind: Kind) -> string {
    let rendered = kind.to_string();
    rendered.byte_slice(6, rendered.byte_len())
}

pub fn null() -> Value {
    Value::Null
}

pub fn node_value(value: Node) -> Value {
    Value::Node(value)
}

pub fn optional_node(value: Option[Node]) -> Value {
    match value {
        Some(value) => Value::Node(value),
        None => Value::Null,
    }
}

pub fn nodes(values: Vec[Node]) -> Value {
    Value::Nodes(values)
}

pub fn text_value(value: string) -> Value {
    Value::String(value)
}

pub fn int_value(value: isize) -> Value {
    Value::Int(value)
}

pub fn bool_value(value: bool) -> Value {
    Value::Bool(value)
}

pub fn field(name: string, value: Value) -> (string, Value) {
    (name, value)
}

pub fn get_node(value: Node, name: string) -> Option[Node] {
    let field = get_field(value, name);
    if !field.present {
        return Option::None
    }
    match field.value {
        Value::Node(node) => Option::Some(node),
        _ => Option::None,
    }
}

pub fn get_nodes(value: Node, name: string) -> Vec[Node] {
    let field = get_field(value, name);
    if !field.present {
        return Vec::new()
    }
    match field.value {
        Value::Nodes(nodes) => nodes,
        _ => Vec::new(),
    }
}

pub fn get_string(value: Node, name: string) -> Option[string] {
    let field = get_field(value, name);
    if !field.present {
        return Option::None
    }
    match field.value {
        Value::String(text) => Option::Some(text),
        _ => Option::None,
    }
}

fn value_to_json(value: Value) -> json::Value {
    match value {
        Null => json::Value::Null,
        Node(node) => to_json(node),
        Nodes(nodes) => {
            let values: Vec[json::Value] = Vec::with_capacity(nodes.len());
            for node in nodes {
                values.push(to_json(node))
            }
            json::Value::Array(values)
        },
        String(text) => json::Value::String(text),
        Int(number) => json::Value::Number(number.to_string()),
        Bool(value) => json::Value::Bool(value),
    }
}

pub fn to_json(value: Node) -> json::Value {
    let entries = field_entries(value);
    let fields: Vec[(string, json::Value)] = Vec::with_capacity(entries.len());
    for entry in entries {
        fields.push((entry.0, value_to_json(entry.1)))
    }
    json::Value::Object(
        Vec::from_array(
            [
                ("kind", json::Value::String(kind_name(value.kind))),
                ("start", json::Value::Number(value.span.start.to_string())),
                ("end", json::Value::Number(value.span.end.to_string())),
                ("fields", json::Value::Object(fields)),
            ],
        ),
    )
}

pub fn encode(value: Node) -> string {
    json::encode(to_json(value))
}

pub fn typed_node(kind: Kind, start: isize, end: isize, fields: Fields) -> Node {
    Node { kind, span: span(start, end), fields }
}
