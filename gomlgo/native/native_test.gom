package native;

use std::env;
use std::fs;
use std::path;
use std::process;
use std::testing;
use std::utf8;
use utf8::BytesUtf8;

fn repeated(value: string) -> string {
    value + value + value + value + value + value + value + value
}

fn source_hash() -> string {
    repeated("01234567")
}

fn import_hash() -> string {
    repeated("89abcdef")
}

fn example_calls() -> Vec[NativeCallSpec] {
    Vec::from_array(
        [
            function_call(
                7,
                "strings",
                "ToUpper",
                Vec::from_array(["string"]),
                Vec::from_array(["string"]),
                false,
            ),
            exit_call(2),
            function_call(
                4,
                "fmt",
                "Sprintf",
                Vec::from_array(["string", "...any"]),
                Vec::from_array(["string"]),
                true,
            ),
        ],
    )
}

fn example_manifest() -> Manifest {
    new_manifest(Vec::from_array(["time/tzdata", "os", "time/tzdata"]), example_calls())
}

fn cache_input(tags: Vec[string]) -> CacheKeyInput {
    CacheKeyInput {
        go_version: "go1.26.5",
        goos: "linux",
        goarch: "amd64",
        goamd64: "v1",
        goexperiment: "",
        cgo: false,
        tags,
        source_hash: source_hash(),
        import_manifest_hash: import_hash(),
    }
}

fn image_sources() -> Vec[GeneratedFile] {
    Vec::from_array(
        [
            GeneratedFile {
                relative_path: "main.go",
                content: "package main\n\nfunc main() {\n\t_, err := _gomlgo_install_native_registry()\n\tif err != nil {\n\t\tpanic(err)\n\t}\n}\n",
            },
        ],
    )
}

fn bridge_source() -> string {
    "package nativebridge\n\ntype CallID uint32\ntype Binding struct{}\ntype Registry struct{}\n\nfunc Bind(id CallID, function any) Binding { return Binding{} }\nfunc ExitBinding(id CallID) Binding { return Binding{} }\nfunc RegisterNativeGlobal(id int, value any) error { return nil }\nfunc InstallDefault(bindings ...Binding) (*Registry, error) { return &Registry{}, nil }\n"
}

fn bridge_sources() -> Vec[GeneratedFile] {
    Vec::from_array(
        [GeneratedFile { relative_path: "nativebridge/bridge.go", content: bridge_source() }],
    )
}

fn generated_file(files: Vec[GeneratedFile], name: string) -> Option[GeneratedFile] {
    for value in files {
        if value.relative_path == name {
            return Option::Some(value)
        }
    }
    Option::None
}

#[test]
fn generates_deterministic_exact_registry_source() -> () {
    testing::assert_eq(
        testing::expect_ok(
            generate_registry_source(example_manifest()),
            "registry generation failed",
        ),
        "package main\n\nimport (\n\t_gomlgo_nativepkg0 \"fmt\"\n\t_gomlgo_nativebridge \"gomlgo/nativebridge\"\n\t_ \"os\"\n\t_gomlgo_nativepkg1 \"strings\"\n\t_ \"time/tzdata\"\n)\n\nfunc _gomlgo_install_native_registry() (*_gomlgo_nativebridge.Registry, error) {\n\treturn _gomlgo_nativebridge.InstallDefault(\n\t\t_gomlgo_nativebridge.ExitBinding(_gomlgo_nativebridge.CallID(2)),\n\t\t_gomlgo_nativebridge.Bind(_gomlgo_nativebridge.CallID(4), _gomlgo_nativepkg0.Sprintf),\n\t\t_gomlgo_nativebridge.Bind(_gomlgo_nativebridge.CallID(7), _gomlgo_nativepkg1.ToUpper),\n\t)\n}\n\nfunc init() {\n\t_, err := _gomlgo_install_native_registry()\n\tif err != nil {\n\t\tpanic(err)\n\t}\n}\n",
    );
    let reordered = new_manifest(
        Vec::from_array(["time/tzdata", "time/tzdata"]),
        Vec::from_array([example_calls()[2], example_calls()[0], example_calls()[1]]),
    );
    testing::assert_eq(
        testing::expect_ok(
            generate_registry_source(example_manifest()),
            "registry generation failed",
        ),
        testing::expect_ok(generate_registry_source(reordered), "reordered generation failed"),
    )
}

#[test]
fn imports_a_package_once_for_function_and_exit_bindings() -> () {
    let source = testing::expect_ok(
        generate_registry_source(
            new_manifest(
                Vec::new(),
                Vec::from_array(
                    [
                        exit_call(2),
                        function_call(
                            3,
                            "os",
                            "Getenv",
                            Vec::from_array(["string"]),
                            Vec::from_array(["string"]),
                            false,
                        ),
                    ],
                ),
            ),
        ),
        "registry generation failed",
    );
    testing::assert(source.contains("_gomlgo_nativepkg0 \"os\""));
    testing::assert(!source.contains("_ \"os\""));
    testing::assert(source.contains("_gomlgo_nativepkg0.Getenv"))
}

#[test]
fn routes_program_executable_through_the_bridge() -> () {
    let source = testing::expect_ok(
        generate_registry_source(
            new_manifest(
                Vec::new(),
                Vec::from_array(
                    [
                        function_call(
                            11,
                            "os",
                            "Executable",
                            Vec::new(),
                            Vec::from_array(["string", "error"]),
                            false,
                        ),
                    ],
                ),
            ),
        ),
        "registry generation failed",
    );
    testing::assert(source.contains("_gomlgo_nativebridge.ProgramExecutable"));
    testing::assert(!source.contains("_gomlgo_nativepkg0 \"os\""))
}

#[test]
fn generates_native_method_and_type_bindings() -> () {
    let manifest = new_manifest(
        Vec::new(),
        Vec::from_array(
            [
                method_call(
                    9,
                    "sync",
                    "Mutex",
                    true,
                    "Lock",
                    Vec::from_array(["native:*sync.Mutex"]),
                    Vec::new(),
                    false,
                ),
            ],
        ),
    );
    manifest.types.push(
        NativeTypeSpec { key: "native:sync.Mutex", import_path: "sync", name: "Mutex" },
    );
    let source = testing::expect_ok(
        generate_registry_source(manifest),
        "registry generation failed",
    );
    testing::assert(source.contains("_gomlgo_nativepkg0 \"sync\""));
    testing::assert(source.contains("(*_gomlgo_nativepkg0.Mutex).Lock"));
    testing::assert(
        source.contains("RegisterNativeType(\"native:sync.Mutex\", _gomlgo_nativepkg0.Mutex{})"),
    )
}

#[test]
fn generates_concrete_generic_function_bindings() -> () {
    let source = testing::expect_ok(
        generate_registry_source(
            new_manifest(
                Vec::new(),
                Vec::from_array(
                    [
                        generic_function_call(
                            3,
                            "slices",
                            "Clone",
                            Vec::from_array(["[]int", "int"]),
                            Vec::from_array(["[]int"]),
                            Vec::from_array(["[]int"]),
                            false,
                        ),
                    ],
                ),
            ),
        ),
        "generic registry generation failed",
    );
    testing::assert(source.contains("_gomlgo_nativepkg0.Clone[[]int, int]"))
}

#[test]
fn generates_interface_proxies_and_aggregate_shells() -> () {
    let manifest = new_manifest(
        Vec::new(),
        Vec::from_array(
            [
                function_call(
                    1,
                    "io",
                    "ReadAll",
                    Vec::from_array(["interface"]),
                    Vec::from_array(["[]byte", "error"]),
                    false,
                ),
            ],
        ),
    );
    manifest.proxies.push(
        NativeProxySpec {
            import_path: "io",
            name: "Reader",
            methods: Vec::from_array(
                [
                    NativeProxyMethodSpec {
                        name: "Read",
                        parameter_type_keys: Vec::from_array(["[]byte"]),
                        result_type_keys: Vec::from_array(["int", "error"]),
                    },
                ],
            ),
        },
    );
    manifest.aggregates.push(
        NativeAggregateSpec {
            key: "gomlgo-type-7",
            name: "Person",
            fields: Vec::from_array(
                [
                    NativeAggregateFieldSpec {
                        name: "Name",
                        type_key: "string",
                        tag: "json:\"name\"",
                    },
                ],
            ),
        },
    );
    let source = testing::expect_ok(
        generate_registry_source(manifest),
        "advanced registry generation failed",
    );
    testing::assert(source.contains("type _gomlgo_nativeaggregate0 struct"));
    testing::assert(source.contains("Name string `json:\"name\"`"));
    testing::assert(source.contains("type _gomlgo_nativeproxy0 struct"));
    testing::assert(source.contains("func (_gomlgo_receiver *_gomlgo_nativeproxy0) Read"));
    testing::assert(source.contains("RegisterInterfaceProxy((*_gomlgo_nativepkg0.Reader)(nil)"));
    testing::assert(
        source.contains("RegisterAggregateType(\"gomlgo-type-7\", _gomlgo_nativeaggregate0{})"),
    )
}

#[test]
fn generates_void_interface_proxy_methods_without_unused_results() -> () {
    let manifest = new_manifest(Vec::new(), Vec::new());
    manifest.proxies.push(
        NativeProxySpec {
            import_path: "sync",
            name: "Locker",
            methods: Vec::from_array(
                [
                    NativeProxyMethodSpec {
                        name: "Lock",
                        parameter_type_keys: Vec::new(),
                        result_type_keys: Vec::new(),
                    },
                ],
            ),
        },
    );
    let source = testing::expect_ok(
        generate_registry_source(manifest),
        "void proxy registry generation failed",
    );
    testing::assert(
        source.contains("\t_gomlgo_nativebridge.InvokeCallback(_gomlgo_receiver.token, \"Lock\""),
    );
    testing::assert(!source.contains("_gomlgo_results :="))
}

#[test]
fn rejects_aggregate_fields_without_concrete_go_types() -> () {
    let manifest = new_manifest(Vec::new(), Vec::new());
    manifest.aggregates.push(
        NativeAggregateSpec {
            key: "gomlgo-type-8",
            name: "Iterator",
            fields: Vec::from_array(
                [NativeAggregateFieldSpec { name: "Next", type_key: "func()(interface)", tag: "" }],
            ),
        },
    );
    testing::assert(canonical_manifest(manifest).is_err())
}

#[test]
fn hashes_only_the_canonical_manifest() -> () {
    let reordered = new_manifest(
        Vec::from_array(["time/tzdata", "time/tzdata"]),
        Vec::from_array([example_calls()[1], example_calls()[2], example_calls()[0]]),
    );
    testing::assert_eq(
        testing::expect_ok(manifest_hash(example_manifest()), "manifest hashing failed"),
        testing::expect_ok(manifest_hash(reordered), "reordered manifest hashing failed"),
    );
    let changed = new_manifest(
        Vec::from_array(["time/tzdata"]),
        Vec::from_array(
            [
                exit_call(2),
                function_call(
                    4,
                    "fmt",
                    "Sprintf",
                    Vec::from_array(["string", "...any"]),
                    Vec::from_array(["string", "error"]),
                    true,
                ),
                example_calls()[0],
            ],
        ),
    );
    testing::assert(
        testing::expect_ok(manifest_hash(example_manifest()), "manifest hashing failed")
            != testing::expect_ok(manifest_hash(changed), "changed manifest hashing failed"),
    )
}

#[test]
fn rejects_invalid_and_duplicate_bindings() -> () {
    let duplicate = new_manifest(Vec::new(), Vec::from_array([exit_call(2), exit_call(2)]));
    testing::assert(canonical_manifest(duplicate).is_err());
    let invalid_symbol = new_manifest(
        Vec::new(),
        Vec::from_array([function_call(1, "fmt", "sprintf", Vec::new(), Vec::new(), false)]),
    );
    testing::assert(canonical_manifest(invalid_symbol).is_err());
    let invalid_exit = new_manifest(
        Vec::new(),
        Vec::from_array(
            [
                NativeCallSpec {
                    call_id: 1,
                    import_path: "os",
                    symbol: "Exit",
                    receiver_name: "",
                    receiver_pointer: false,
                    type_argument_keys: Vec::new(),
                    parameter_type_keys: Vec::from_array(["int32"]),
                    result_type_keys: Vec::new(),
                    variadic: false,
                    binding: NativeBindingKind::Exit,
                },
            ],
        ),
    );
    testing::assert(canonical_manifest(invalid_exit).is_err());
    let unsafe_exit = new_manifest(
        Vec::new(),
        Vec::from_array(
            [function_call(1, "os", "Exit", Vec::from_array(["int"]), Vec::new(), false)],
        ),
    );
    testing::assert(canonical_manifest(unsafe_exit).is_err());
    let wrong_abi = example_manifest();
    wrong_abi.abi_version = 99;
    testing::assert(canonical_manifest(wrong_abi).is_err());
    let invalid_tag = cache_input(Vec::from_array(["not-a-tag"]));
    testing::assert(cache_key(invalid_tag, example_manifest()).is_err())
}

#[test]
fn cache_key_covers_toolchain_source_imports_manifest_and_abi() -> () {
    let base = testing::expect_ok(
        cache_key(cache_input(Vec::from_array(["osusergo", "netgo"])), example_manifest()),
        "cache key failed",
    );
    testing::assert_eq(base.byte_len(), 64);
    testing::assert_eq(
        base,
        testing::expect_ok(
            cache_key(
                cache_input(Vec::from_array(["netgo", "osusergo", "netgo"])),
                example_manifest(),
            ),
            "canonical cache key failed",
        ),
    );
    let version = cache_input(Vec::from_array(["netgo", "osusergo"]));
    version.go_version = "go1.26.6";
    testing::assert(
        base != testing::expect_ok(cache_key(version, example_manifest()), "version key failed"),
    );
    let platform = cache_input(Vec::from_array(["netgo", "osusergo"]));
    platform.goarch = "arm64";
    testing::assert(
        base != testing::expect_ok(cache_key(platform, example_manifest()), "platform key failed"),
    );
    let microarchitecture = cache_input(Vec::from_array(["netgo", "osusergo"]));
    microarchitecture.goamd64 = "v3";
    testing::assert(
        base
            != testing::expect_ok(
                cache_key(microarchitecture, example_manifest()),
                "microarchitecture key failed",
            ),
    );
    let experiment = cache_input(Vec::from_array(["netgo", "osusergo"]));
    experiment.goexperiment = "greenteagc";
    testing::assert(
        base
            != testing::expect_ok(
                cache_key(experiment, example_manifest()),
                "experiment key failed",
            ),
    );
    let cgo = cache_input(Vec::from_array(["netgo", "osusergo"]));
    cgo.cgo = true;
    testing::assert(
        base != testing::expect_ok(cache_key(cgo, example_manifest()), "cgo key failed"),
    );
    let source = cache_input(Vec::from_array(["netgo", "osusergo"]));
    source.source_hash = repeated("11111111");
    testing::assert(
        base != testing::expect_ok(cache_key(source, example_manifest()), "source key failed"),
    );
    let imports = cache_input(Vec::from_array(["netgo", "osusergo"]));
    imports.import_manifest_hash = repeated("22222222");
    testing::assert(
        base != testing::expect_ok(cache_key(imports, example_manifest()), "import key failed"),
    );
    let changed_manifest = new_manifest(Vec::from_array(["embed"]), example_calls());
    testing::assert(
        base
            != testing::expect_ok(
                cache_key(cache_input(Vec::from_array(["netgo", "osusergo"])), changed_manifest),
                "manifest key failed",
            ),
    )
}

#[test]
fn creates_a_reproducible_go_build_plan() -> () {
    let plan = testing::expect_ok(
        build_plan(
            BuildRequest {
                go_binary: "/usr/lib/go-1.26/bin/go",
                cache_root: "/tmp/gomlgo-native",
                cache: cache_input(Vec::from_array(["osusergo", "netgo", "netgo"])),
                bridge_sources: bridge_sources(),
                image_sources: image_sources(),
            },
            example_manifest(),
        ),
        "build plan failed",
    );
    testing::assert_eq(plan.cache_key.byte_len(), 64);
    testing::assert_eq(plan.final_directory, "/tmp/gomlgo-native/" + plan.cache_key);
    testing::assert_eq(plan.staging_root, "/tmp/gomlgo-native/.staging/" + plan.cache_key);
    testing::assert_eq(plan.executable_relative_path, "gomlgo-execution");
    testing::assert_eq(plan.completion_relative_path, "complete");
    testing::assert(plan.completion_metadata_prefix.contains("key=" + plan.cache_key));
    testing::assert(plan.completion_metadata_prefix.ends_with("executable_sha256="));
    let executable_hash = repeated("abcdef01");
    let metadata = testing::expect_ok(
        completion_metadata(plan, executable_hash),
        "completion metadata failed",
    );
    testing::assert(completion_matches(plan, metadata, executable_hash));
    testing::assert(!completion_matches(plan, metadata + "corrupt", executable_hash));
    testing::assert(completion_metadata(plan, "invalid").is_err());
    testing::assert(
        plan.arguments
            == Vec::from_array(
                [
                    "build",
                    "-trimpath",
                    "-buildvcs=false",
                    "-o",
                    "gomlgo-execution",
                    "-tags",
                    "netgo,osusergo",
                    ".",
                ],
            ),
    );
    testing::assert(
        plan.environment
            == Vec::from_array(
                [
                    ("GOTOOLCHAIN", "local"),
                    ("GOENV", "off"),
                    ("GOWORK", "off"),
                    ("GOFLAGS", ""),
                    ("GOOS", "linux"),
                    ("GOARCH", "amd64"),
                    ("GOAMD64", "v1"),
                    ("GOEXPERIMENT", ""),
                    ("CGO_ENABLED", "0"),
                    ("GOCACHE", "/tmp/gomlgo-native/.go-build"),
                ],
            ),
    );
    testing::assert_eq(plan.files.len(), 4);
    testing::assert_eq(
        testing::expect_some(generated_file(plan.files, "go.mod"), "missing go.mod").content,
        "module gomlgo\n\ngo 1.26\n",
    );
    testing::assert(
        testing::expect_some(
            generated_file(plan.files, "gomlgo_native_registry.go"),
            "missing registry source",
        ).content.contains("\"gomlgo/nativebridge\""),
    );
    let changed_bridge = build_plan(
        BuildRequest {
            go_binary: "/usr/lib/go-1.26/bin/go",
            cache_root: "/tmp/gomlgo-native",
            cache: cache_input(Vec::from_array(["netgo", "osusergo"])),
            bridge_sources: Vec::from_array(
                [
                    GeneratedFile {
                        relative_path: "nativebridge/bridge.go",
                        content: bridge_source() + "\n",
                    },
                ],
            ),
            image_sources: image_sources(),
        },
        example_manifest(),
    );
    testing::assert(
        plan.cache_key != testing::expect_ok(changed_bridge, "changed bridge plan failed").cache_key,
    );
    let changed_image = build_plan(
        BuildRequest {
            go_binary: "/usr/lib/go-1.26/bin/go",
            cache_root: "/tmp/gomlgo-native",
            cache: cache_input(Vec::from_array(["netgo", "osusergo"])),
            bridge_sources: bridge_sources(),
            image_sources: Vec::from_array(
                [
                    GeneratedFile {
                        relative_path: "main.go",
                        content: "package main\nfunc main() {}\n",
                    },
                ],
            ),
        },
        example_manifest(),
    );
    testing::assert(
        plan.cache_key != testing::expect_ok(changed_image, "changed image plan failed").cache_key,
    )
}

#[test]
fn rejects_cgo_and_unsafe_image_paths() -> () {
    let cgo = cache_input(Vec::new());
    cgo.cgo = true;
    testing::assert(
        build_plan(
            BuildRequest {
                go_binary: "/usr/lib/go-1.26/bin/go",
                cache_root: "/tmp/gomlgo-native",
                cache: cgo,
                bridge_sources: bridge_sources(),
                image_sources: image_sources(),
            },
            example_manifest(),
        ).is_err(),
    );
    testing::assert(
        build_plan(
            BuildRequest {
                go_binary: "/usr/lib/go-1.26/bin/go",
                cache_root: "/tmp/gomlgo-native",
                cache: cache_input(Vec::new()),
                bridge_sources: bridge_sources(),
                image_sources: Vec::from_array(
                    [GeneratedFile { relative_path: "go.mod", content: "module invalid" }],
                ),
            },
            example_manifest(),
        ).is_err(),
    );
    testing::assert(
        build_plan(
            BuildRequest {
                go_binary: "/usr/lib/go-1.26/bin/go",
                cache_root: "/tmp/gomlgo-native",
                cache: cache_input(Vec::new()),
                bridge_sources: bridge_sources(),
                image_sources: Vec::from_array(
                    [GeneratedFile { relative_path: "../main.go", content: "package main" }],
                ),
            },
            example_manifest(),
        ).is_err(),
    );
    testing::assert(
        build_plan(
            BuildRequest {
                go_binary: "/usr/lib/go-1.26/bin/go",
                cache_root: "/tmp/gomlgo-native",
                cache: cache_input(Vec::new()),
                bridge_sources: bridge_sources(),
                image_sources: image_sources(),
            },
            new_manifest(
                Vec::new(),
                Vec::from_array(
                    [function_call(1, "gomlgo/nativebridge", "Bind", Vec::new(), Vec::new(), false)],
                ),
            ),
        ).is_err(),
    )
}

#[test]
fn failed_image_builds_release_the_lock_and_remove_staging_files() -> () {
    let root = path::join(
        env::current_dir_structured().unwrap_or("."),
        "_artifact/native-image-failure",
    );
    let plan = testing::expect_ok(
        build_plan(
            BuildRequest {
                go_binary: "/bin/false",
                cache_root: root,
                cache: cache_input(Vec::new()),
                bridge_sources: bridge_sources(),
                image_sources: image_sources(),
            },
            example_manifest(),
        ),
        "build plan failed",
    );
    for _ in 0..2 {
        testing::assert(build_execution_image(plan).is_err());
        testing::assert(!fs::exists(plan.staging_root));
        testing::assert(!fs::exists(plan.final_directory))
    }
}

#[test]
fn generated_registry_builds_with_go126() -> () {
    let root = env::current_dir_structured().unwrap_or(".");
    let actual_bridge = testing::expect_ok(
        fs::read_file_structured(path::join(root, "nativebridge/bridge.go")),
        "could not read bridge source",
    );
    let plan = testing::expect_ok(
        build_plan(
            BuildRequest {
                go_binary: "/usr/lib/go-1.26/bin/go",
                cache_root: path::join(root, "_artifact/native-registry-smoke"),
                cache: cache_input(Vec::new()),
                bridge_sources: Vec::from_array(
                    [
                        GeneratedFile {
                            relative_path: "nativebridge/bridge.go",
                            content: actual_bridge,
                        },
                        GeneratedFile {
                            relative_path: "nativebridge/advanced.go",
                            content: testing::expect_ok(
                                fs::read_file_structured(
                                    path::join(root, "nativebridge/advanced.go"),
                                ),
                                "could not read advanced bridge source",
                            ),
                        },
                    ],
                ),
                image_sources: Vec::from_array(
                    [
                        GeneratedFile {
                            relative_path: "main.go",
                            content: "package main\n\nimport (\n\t\"fmt\"\n\t_gomlgo_nativebridge \"gomlgo/nativebridge\"\n)\n\nfunc main() {\n\tresult := _gomlgo_nativebridge.DefaultCall(_gomlgo_nativebridge.CallID(7), _gomlgo_nativebridge.Values(\"goml\"))\n\tif result.Err != nil {\n\t\tpanic(result.Err)\n\t}\n\tfmt.Print(result.Values[0].String())\n}\n",
                        },
                    ],
                ),
            },
            example_manifest(),
        ),
        "build plan failed",
    );
    let executable = testing::expect_ok(build_execution_image(plan), "could not build image");
    let output = testing::expect_ok(
        process::Command::new(executable).output_structured(),
        "could not run native execution image",
    );
    if !output.status().success() {
        testing::fail(output.stderr().to_string_utf8().unwrap_or("native execution image failed"))
    }
    testing::assert_eq(output.stdout().to_string_utf8().unwrap_or(""), "GOML")
}
