package native;

pub trait Marker {}

pub type ValueRef = dyn Marker;

#[go_ffi("gomlgo/nativebridge", "CloneValue")]
pub extern fn clone_value(value: ValueRef) -> ValueRef;

#[go_ffi("gomlgo/nativebridge", "ValidValue")]
pub extern fn valid_value(value: ValueRef) -> bool;

#[go_ffi("gomlgo/nativebridge", "NilValue")]
pub extern fn nil_value(value: ValueRef) -> bool;

#[go_ffi("gomlgo/nativebridge", "ValueType")]
pub extern fn value_type(value: ValueRef) -> string;
