package native;

use std::fs;
use std::path;
use std::process;
use std::utf8;
use utf8::BytesUtf8;

#[go_ffi("gomlgo/nativebridge", "LockImageBuild")]
extern fn lock_image_build(path: string) -> (isize, string);

#[go_ffi("gomlgo/nativebridge", "UnlockImageBuild")]
extern fn unlock_image_build(file: isize) -> ();

fn build_directory_valid(plan: BuildPlan) -> bool {
    valid_hash(plan.cache_key)
        && path::file_name(plan.final_directory) == Option::Some(plan.cache_key)
        && path::file_name(plan.staging_root) == Option::Some(plan.cache_key)
        && plan.final_directory != plan.staging_root
}

fn image_path(plan: BuildPlan) -> string {
    path::join(plan.final_directory, plan.executable_relative_path)
}

fn completion_path(plan: BuildPlan) -> string {
    path::join(plan.final_directory, plan.completion_relative_path)
}

fn valid_cached_image(plan: BuildPlan) -> bool {
    let executable = image_path(plan);
    let metadata_file = completion_path(plan);
    if !fs::is_file(executable) || !fs::is_file(metadata_file) {
        return false
    }
    let Ok(executable_hash) = fs::sha256_file(executable) else {
        return false;
    };
    let Ok(metadata) = fs::read_file_structured(metadata_file) else {
        return false;
    };
    completion_matches(plan, metadata, executable_hash)
}

fn write_plan_files(plan: BuildPlan) -> Result[(), string] {
    for value in plan.files {
        let target = path::join(plan.staging_root, value.relative_path);
        let parent = path::parent(target).ok_or("native image target has no parent")?;
        fs::create_dir_all(parent).map_err(|error| error.to_string())?;
        fs::write_file_structured(target, value.content).map_err(|error| error.to_string())?
    }
    Result::Ok(())
}

fn build_command(plan: BuildPlan) -> process::Command {
    process::Command::new(plan.go_binary).args(plan.arguments).current_dir(plan.staging_root).env_clear().envs(
        plan.environment,
    )
}

fn build_failure(output: process::Output) -> string {
    let stderr = output.stderr().to_string_utf8().unwrap_or("");
    let stdout = output.stdout().to_string_utf8().unwrap_or("");
    if stderr != "" {
        stderr
    } else if stdout != "" {
        stdout
    } else {
        f"go build failed with exit code {output.status().code_value}"
    }
}

fn build_locked_image(plan: BuildPlan) -> Result[string, string] {
    if valid_cached_image(plan) {
        return Result::Ok(image_path(plan))
    }
    if fs::exists(plan.final_directory) {
        fs::remove_dir_all(plan.final_directory).map_err(|error| error.to_string())?
    }
    if fs::exists(plan.staging_root) {
        fs::remove_dir_all(plan.staging_root).map_err(|error| error.to_string())?
    }
    fs::create_dir_all(plan.staging_root).map_err(|error| error.to_string())?;
    write_plan_files(plan)?;
    let output = build_command(plan).output_structured().map_err(|error| error.to_string())?;
    if !output.status().success() {
        return Result::Err(build_failure(output))
    }
    let staging_executable = path::join(plan.staging_root, plan.executable_relative_path);
    if !fs::is_file(staging_executable) {
        return Result::Err("go build did not produce the native execution image")
    }
    let executable_hash = fs::sha256_file(staging_executable).map_err(|error| error.to_string())?;
    fs::write_file_structured(
        path::join(plan.staging_root, plan.completion_relative_path),
        completion_metadata(plan, executable_hash)?,
    ).map_err(|error| error.to_string())?;
    let final_parent = path::parent(plan.final_directory).ok_or(
        "native image cache directory has no parent",
    )?;
    fs::create_dir_all(final_parent).map_err(|error| error.to_string())?;
    fs::rename(plan.staging_root, plan.final_directory).map_err(|error| error.to_string())?;
    Result::Ok(image_path(plan))
}

pub fn build_execution_image(plan: BuildPlan) -> Result[string, string] {
    if !build_directory_valid(plan) {
        return Result::Err("native image build directories are invalid")
    } else if valid_cached_image(plan) {
        return Result::Ok(image_path(plan))
    }
    let parent = path::parent(plan.final_directory).ok_or(
        "native image cache directory has no parent",
    )?;
    fs::create_dir_all(parent).map_err(|error| error.to_string())?;
    let (lock, error) = lock_image_build(plan.final_directory + ".lock");
    if error != "" {
        return Result::Err(error)
    }
    let result = build_locked_image(plan);
    let _ = fs::remove_dir_all(plan.staging_root);
    unlock_image_build(lock);
    result
}
