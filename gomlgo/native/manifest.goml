package native;

use std::bytes;
use std::collections;
use std::crypto::hash;
use std::text;

pub const NATIVE_BRIDGE_ABI_VERSION: u32 = 5;

pub const NATIVE_BRIDGE_IMPORT_PATH: string = "gomlgo/nativebridge";

pub enum NativeBindingKind {
    Function,
    Method,
    Exit,
}

pub struct NativeCallSpec {
    pub call_id: u32,
    pub import_path: string,
    pub symbol: string,
    pub receiver_name: string,
    pub receiver_pointer: bool,
    pub type_argument_keys: Vec[string],
    pub parameter_type_keys: Vec[string],
    pub result_type_keys: Vec[string],
    pub variadic: bool,
    pub binding: NativeBindingKind,
}

pub struct NativeTypeSpec {
    pub key: string,
    pub import_path: string,
    pub name: string,
}

pub struct NativeGlobalSpec {
    pub object_id: isize,
    pub import_path: string,
    pub name: string,
}

pub struct NativeProxyMethodSpec {
    pub name: string,
    pub parameter_type_keys: Vec[string],
    pub result_type_keys: Vec[string],
}

pub struct NativeProxySpec {
    pub import_path: string,
    pub name: string,
    pub methods: Vec[NativeProxyMethodSpec],
}

pub struct NativeAggregateFieldSpec {
    pub name: string,
    pub type_key: string,
    pub tag: string,
}

pub struct NativeAggregateSpec {
    pub key: string,
    pub name: string,
    pub fields: Vec[NativeAggregateFieldSpec],
}

pub struct Manifest {
    pub abi_version: u32,
    pub initialization_packages: Vec[string],
    pub calls: Vec[NativeCallSpec],
    pub types: Vec[NativeTypeSpec],
    pub globals: Vec[NativeGlobalSpec],
    pub proxies: Vec[NativeProxySpec],
    pub aggregates: Vec[NativeAggregateSpec],
}

pub fn new_manifest(initialization_packages: Vec[string], calls: Vec[NativeCallSpec]) -> Manifest {
    Manifest {
        abi_version: NATIVE_BRIDGE_ABI_VERSION,
        initialization_packages,
        calls,
        types: Vec::new(),
        globals: Vec::new(),
        proxies: Vec::new(),
        aggregates: Vec::new(),
    }
}

pub fn function_call(
    call_id: u32,
    import_path: string,
    symbol: string,
    parameter_type_keys: Vec[string],
    result_type_keys: Vec[string],
    variadic: bool,
) -> NativeCallSpec {
    NativeCallSpec {
        call_id,
        import_path,
        symbol,
        receiver_name: "",
        receiver_pointer: false,
        type_argument_keys: Vec::new(),
        parameter_type_keys,
        result_type_keys,
        variadic,
        binding: NativeBindingKind::Function,
    }
}

pub fn generic_function_call(
    call_id: u32,
    import_path: string,
    symbol: string,
    type_argument_keys: Vec[string],
    parameter_type_keys: Vec[string],
    result_type_keys: Vec[string],
    variadic: bool,
) -> NativeCallSpec {
    NativeCallSpec {
        call_id,
        import_path,
        symbol,
        receiver_name: "",
        receiver_pointer: false,
        type_argument_keys,
        parameter_type_keys,
        result_type_keys,
        variadic,
        binding: NativeBindingKind::Function,
    }
}

pub fn exit_call(call_id: u32) -> NativeCallSpec {
    NativeCallSpec {
        call_id,
        import_path: "os",
        symbol: "Exit",
        receiver_name: "",
        receiver_pointer: false,
        type_argument_keys: Vec::new(),
        parameter_type_keys: Vec::from_array(["int"]),
        result_type_keys: Vec::new(),
        variadic: false,
        binding: NativeBindingKind::Exit,
    }
}

pub fn method_call(
    call_id: u32,
    import_path: string,
    receiver_name: string,
    receiver_pointer: bool,
    symbol: string,
    parameter_type_keys: Vec[string],
    result_type_keys: Vec[string],
    variadic: bool,
) -> NativeCallSpec {
    NativeCallSpec {
        call_id,
        import_path,
        symbol,
        receiver_name,
        receiver_pointer,
        type_argument_keys: Vec::new(),
        parameter_type_keys,
        result_type_keys,
        variadic,
        binding: NativeBindingKind::Method,
    }
}

fn binding_rank(value: NativeBindingKind) -> isize {
    match value {
        NativeBindingKind::Function => 0,
        NativeBindingKind::Method => 1,
        NativeBindingKind::Exit => 2,
    }
}

fn compare_call(left: NativeCallSpec, right: NativeCallSpec) -> isize {
    if left.call_id < right.call_id {
        -1
    } else if left.call_id > right.call_id {
        1
    } else if left.import_path < right.import_path {
        -1
    } else if left.import_path > right.import_path {
        1
    } else if left.symbol < right.symbol {
        -1
    } else if left.symbol > right.symbol {
        1
    } else {
        binding_rank(left.binding) - binding_rank(right.binding)
    }
}

fn compare_proxy(left: NativeProxySpec, right: NativeProxySpec) -> isize {
    if left.import_path < right.import_path {
        -1
    } else if left.import_path > right.import_path {
        1
    } else if left.name < right.name {
        -1
    } else if left.name > right.name {
        1
    } else {
        0
    }
}

fn compare_aggregate(left: NativeAggregateSpec, right: NativeAggregateSpec) -> isize {
    if left.key < right.key {
        -1
    } else if left.key > right.key {
        1
    } else {
        0
    }
}

fn compare_type(left: NativeTypeSpec, right: NativeTypeSpec) -> isize {
    if left.key < right.key {
        -1
    } else if left.key > right.key {
        1
    } else {
        0
    }
}

fn compare_global(left: NativeGlobalSpec, right: NativeGlobalSpec) -> isize {
    left.object_id - right.object_id
}

fn import_path_byte(value: byte) -> bool {
    (value >= b'a' && value <= b'z') || (value >= b'A' && value <= b'Z')
        || (value >= b'0' && value <= b'9')
        || value == b'_'
        || value == b'-'
        || value == b'.'
        || value == b'/'
}

fn valid_import_path(value: string) -> bool {
    if value == "" || value.starts_with("/") || value.ends_with("/") || value.contains("//") {
        return false
    }
    for part in text::split(value, "/") {
        if part == "." || part == ".." || part == "" {
            return false
        }
    }
    for index in 0..value.byte_len() {
        if !import_path_byte(value.byte_get(index)) {
            return false
        }
    }
    true
}

fn valid_exported_symbol(value: string) -> bool {
    if value == "" || value.byte_get(0) < b'A' || value.byte_get(0) > b'Z' {
        return false
    }
    for index in 1..value.byte_len() {
        let item = value.byte_get(index);
        if (item >= b'a' && item <= b'z') || (item >= b'A' && item <= b'Z')
            || (item >= b'0' && item <= b'9')
            || item == b'_' {} else {
            return false
        }
    }
    true
}

fn validate_types(values: Vec[string], location: string) -> Result[(), string] {
    for value in values {
        if value == "" {
            return Result::Err(location + " contains an empty Go type")
        }
    }
    Result::Ok(())
}

fn emitted_type_byte(value: byte) -> bool {
    (value >= b'a' && value <= b'z') || (value >= b'A' && value <= b'Z')
        || (value >= b'0' && value <= b'9')
        || value == b'_'
        || value == b'['
        || value == b']'
        || value == b'('
        || value == b')'
        || value == b','
        || value == b'.'
        || value == b'*'
}

fn validate_emitted_types(values: Vec[string], location: string) -> Result[(), string] {
    validate_types(values, location)?;
    for value in values {
        for index in 0..value.byte_len() {
            if !emitted_type_byte(value.byte_get(index)) {
                return Result::Err(location + " contains an unsafe Go type " + value)
            }
        }
    }
    Result::Ok(())
}

fn validate_call(value: NativeCallSpec) -> Result[(), string] {
    if !valid_import_path(value.import_path) {
        return Result::Err("native call has invalid import path " + value.import_path)
    } else if value.import_path == NATIVE_BRIDGE_IMPORT_PATH {
        return Result::Err("native calls cannot bind the native bridge package")
    } else if !valid_exported_symbol(value.symbol) {
        return Result::Err("native call has invalid exported symbol " + value.symbol)
    }
    validate_emitted_types(value.type_argument_keys, f"native call {value.call_id} type arguments")?;
    validate_types(value.parameter_type_keys, f"native call {value.call_id} parameters")?;
    validate_types(value.result_type_keys, f"native call {value.call_id} results")?;
    match value.binding {
        NativeBindingKind::Function => if value.receiver_name != "" || value.receiver_pointer {
            Result::Err("native function binding has a receiver")
        } else if value.import_path == "os" && value.symbol == "Exit" {
            Result::Err("os.Exit must use the native exit binding")
        } else {
            Result::Ok(())
        },
        NativeBindingKind::Method => if !valid_exported_symbol(value.receiver_name)
            || !value.type_argument_keys.is_empty()
            || value.parameter_type_keys.is_empty() {
            Result::Err("native method binding has an invalid receiver")
        } else {
            Result::Ok(())
        },
        NativeBindingKind::Exit => if value.receiver_name == "" && !value.receiver_pointer
            && value.import_path == "os"
            && value.symbol == "Exit"
            && value.parameter_type_keys.len() == 1
            && value.parameter_type_keys[0] == "int"
            && value.result_type_keys.is_empty()
            && value.type_argument_keys.is_empty()
            && !value.variadic {
            Result::Ok(())
        } else {
            Result::Err("exit binding must describe func os.Exit(int)")
        },
    }
}

fn validate_type(value: NativeTypeSpec) -> Result[(), string] {
    if value.key == "" || !valid_import_path(value.import_path)
        || value.import_path == NATIVE_BRIDGE_IMPORT_PATH
        || !valid_exported_symbol(value.name) {
        Result::Err("native type has an invalid identity")
    } else {
        Result::Ok(())
    }
}

fn validate_global(value: NativeGlobalSpec) -> Result[(), string] {
    if value.object_id < 0 || !valid_import_path(value.import_path)
        || value.import_path == NATIVE_BRIDGE_IMPORT_PATH
        || !valid_exported_symbol(value.name) {
        Result::Err("native global has an invalid identity")
    } else {
        Result::Ok(())
    }
}

fn validate_proxy(value: NativeProxySpec) -> Result[(), string] {
    if !valid_import_path(value.import_path) || !valid_exported_symbol(value.name) {
        return Result::Err("native proxy has invalid interface identity")
    } else if value.methods.is_empty() {
        return Result::Err("native proxy has no methods")
    }
    for method in value.methods {
        if !valid_exported_symbol(method.name) {
            return Result::Err("native proxy has invalid method " + method.name)
        }
        validate_types(method.parameter_type_keys, "native proxy parameters")?;
        validate_types(method.result_type_keys, "native proxy results")?
    }
    Result::Ok(())
}

fn aggregate_field_type_supported(value: string) -> bool {
    if value.starts_with("[]") {
        aggregate_field_type_supported(value.byte_slice(2, value.byte_len()))
    } else {
        value == "bool" || value == "int" || value == "int8" || value == "int16" || value == "int32"
            || value == "int64"
            || value == "uint"
            || value == "uint8"
            || value == "uint16"
            || value == "uint32"
            || value == "uint64"
            || value == "uintptr"
            || value == "float32"
            || value == "float64"
            || value == "complex64"
            || value == "complex128"
            || value == "string"
    }
}

fn validate_aggregate(value: NativeAggregateSpec) -> Result[(), string] {
    if value.key == "" || !valid_exported_symbol(value.name) || value.fields.is_empty() {
        return Result::Err("native aggregate has invalid identity")
    }
    for field in value.fields {
        if field.name == "" || field.type_key == "" || field.tag.contains("`") {
            return Result::Err("native aggregate has invalid field metadata")
        } else if !aggregate_field_type_supported(field.type_key) {
            return Result::Err("native aggregate has unsupported field type " + field.type_key)
        }
    }
    Result::Ok(())
}

fn call_uses_package(calls: Vec[NativeCallSpec], import_path: string) -> bool {
    for call in calls {
        if call.import_path == import_path {
            return true
        }
    }
    false
}

pub fn canonical_manifest(value: Manifest) -> Result[Manifest, string] {
    if value.abi_version != NATIVE_BRIDGE_ABI_VERSION {
        return Result::Err(f"native manifest ABI {value.abi_version} is unsupported")
    }
    let calls: Vec[NativeCallSpec] = Vec::with_capacity(value.calls.len());
    for call in value.calls {
        validate_call(call)?;
        calls.push(call)
    }
    collections::sort_by(calls, compare_call);
    for index in 1..calls.len() {
        if calls[index - 1].call_id == calls[index].call_id {
            return Result::Err(f"native call ID {calls[index].call_id} is registered twice")
        }
    }
    let types: Vec[NativeTypeSpec] = Vec::with_capacity(value.types.len());
    for type_value in value.types {
        validate_type(type_value)?;
        types.push(type_value)
    }
    collections::sort_by(types, compare_type);
    for index in 1..types.len() {
        if types[index - 1].key == types[index].key {
            return Result::Err("native type is registered twice")
        }
    }
    let globals: Vec[NativeGlobalSpec] = Vec::with_capacity(value.globals.len());
    for global in value.globals {
        validate_global(global)?;
        globals.push(global)
    }
    collections::sort_by(globals, compare_global);
    for index in 1..globals.len() {
        if globals[index - 1].object_id == globals[index].object_id {
            return Result::Err("native global is registered twice")
        }
    }
    let proxies: Vec[NativeProxySpec] = Vec::with_capacity(value.proxies.len());
    for proxy in value.proxies {
        validate_proxy(proxy)?;
        proxies.push(proxy)
    }
    collections::sort_by(proxies, compare_proxy);
    for index in 1..proxies.len() {
        if compare_proxy(proxies[index - 1], proxies[index]) == 0 {
            return Result::Err("native proxy is registered twice")
        }
    }
    let aggregates: Vec[NativeAggregateSpec] = Vec::with_capacity(value.aggregates.len());
    for aggregate in value.aggregates {
        validate_aggregate(aggregate)?;
        aggregates.push(aggregate)
    }
    collections::sort_by(aggregates, compare_aggregate);
    for index in 1..aggregates.len() {
        if aggregates[index - 1].key == aggregates[index].key {
            return Result::Err("native aggregate is registered twice")
        }
    }
    let packages: collections::BTreeSet[string] = collections::BTreeSet::new();
    for import_path in value.initialization_packages {
        if !valid_import_path(import_path) {
            return Result::Err("native manifest has invalid import path " + import_path)
        } else if import_path == NATIVE_BRIDGE_IMPORT_PATH {
            return Result::Err("native manifest cannot initialize the native bridge package")
        } else if !call_uses_package(calls, import_path) {
            let _ = packages.insert(import_path);
        }
    }
    Result::Ok(
        Manifest {
            abi_version: value.abi_version,
            initialization_packages: packages.to_vec(),
            calls,
            types,
            globals,
            proxies,
            aggregates,
        },
    )
}

fn append_field(builder: text::StringBuilder, value: string) -> () {
    builder.write_string(value.byte_len().to_string());
    builder.write_string(":");
    builder.write_string(value)
}

fn append_types(builder: text::StringBuilder, values: Vec[string]) -> () {
    append_field(builder, values.len().to_string());
    for value in values {
        append_field(builder, value)
    }
}

pub fn encode_manifest(value: Manifest) -> Result[string, string] {
    let value = canonical_manifest(value)?;
    let builder = text::StringBuilder::new();
    append_field(builder, "gomlgo-native-manifest");
    append_field(builder, value.abi_version.to_string());
    append_field(builder, value.initialization_packages.len().to_string());
    for import_path in value.initialization_packages {
        append_field(builder, import_path)
    }
    append_field(builder, value.calls.len().to_string());
    for call in value.calls {
        append_field(builder, call.call_id.to_string());
        append_field(builder, binding_rank(call.binding).to_string());
        append_field(builder, call.import_path);
        append_field(builder, call.symbol);
        append_field(builder, call.receiver_name);
        append_field(
            builder,
            if call.receiver_pointer {
                "1"
            } else {
                "0"
            },
        );
        append_types(builder, call.type_argument_keys);
        append_field(
            builder,
            if call.variadic {
                "1"
            } else {
                "0"
            },
        );
        append_types(builder, call.parameter_type_keys);
        append_types(builder, call.result_type_keys)
    }
    append_field(builder, value.types.len().to_string());
    for type_value in value.types {
        append_field(builder, type_value.key);
        append_field(builder, type_value.import_path);
        append_field(builder, type_value.name)
    }
    append_field(builder, value.globals.len().to_string());
    for global in value.globals {
        append_field(builder, global.object_id.to_string());
        append_field(builder, global.import_path);
        append_field(builder, global.name)
    }
    append_field(builder, value.proxies.len().to_string());
    for proxy in value.proxies {
        append_field(builder, proxy.import_path);
        append_field(builder, proxy.name);
        append_field(builder, proxy.methods.len().to_string());
        for method in proxy.methods {
            append_field(builder, method.name);
            append_types(builder, method.parameter_type_keys);
            append_types(builder, method.result_type_keys)
        }
    }
    append_field(builder, value.aggregates.len().to_string());
    for aggregate in value.aggregates {
        append_field(builder, aggregate.key);
        append_field(builder, aggregate.name);
        append_field(builder, aggregate.fields.len().to_string());
        for field in aggregate.fields {
            append_field(builder, field.name);
            append_field(builder, field.type_key);
            append_field(builder, field.tag)
        }
    }
    Result::Ok(builder.finish())
}

pub fn manifest_hash(value: Manifest) -> Result[string, string] {
    Result::Ok(hash::sha256(bytes::Bytes::from_string(encode_manifest(value)?)))
}
