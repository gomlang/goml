package native;

use std::bytes;
use std::collections;
use std::crypto::hash;
use std::path;
use std::text;

pub const NATIVE_CACHE_SCHEMA_VERSION: u32 = 3;

pub const NATIVE_REGISTRY_GENERATOR_VERSION: u32 = 5;

const EXECUTION_MODULE_PATH: string = "gomlgo";

const EXECUTION_BRIDGE_IMPORT_PATH: string = "gomlgo/nativebridge";

pub struct GeneratedFile {
    pub relative_path: string,
    pub content: string,
}

pub struct CacheKeyInput {
    pub go_version: string,
    pub goos: string,
    pub goarch: string,
    pub goamd64: string,
    pub goexperiment: string,
    pub cgo: bool,
    pub tags: Vec[string],
    pub source_hash: string,
    pub import_manifest_hash: string,
}

pub struct BuildRequest {
    pub go_binary: string,
    pub cache_root: string,
    pub cache: CacheKeyInput,
    pub bridge_sources: Vec[GeneratedFile],
    pub image_sources: Vec[GeneratedFile],
}

pub struct BuildPlan {
    pub cache_key: string,
    pub manifest_hash: string,
    pub final_directory: string,
    pub staging_root: string,
    pub executable_relative_path: string,
    pub completion_relative_path: string,
    pub completion_metadata_prefix: string,
    pub files: Vec[GeneratedFile],
    pub go_binary: string,
    pub arguments: Vec[string],
    pub environment: Vec[(string, string)],
}

fn valid_tag_byte(value: byte) -> bool {
    (value >= b'a' && value <= b'z') || (value >= b'A' && value <= b'Z')
        || (value >= b'0' && value <= b'9')
        || value == b'_'
        || value == b'.'
}

fn canonical_tags(values: Vec[string]) -> Result[Vec[string], string] {
    let result: collections::BTreeSet[string] = collections::BTreeSet::new();
    for value in values {
        if value == "" {
            return Result::Err("native cache build tag cannot be empty")
        }
        for index in 0..value.byte_len() {
            if !valid_tag_byte(value.byte_get(index)) {
                return Result::Err("native cache has invalid build tag " + value)
            }
        }
        let _ = result.insert(value);
    }
    Result::Ok(result.to_vec())
}

fn valid_hash(value: string) -> bool {
    if value.byte_len() != 64 {
        return false
    }
    for index in 0..value.byte_len() {
        let item = value.byte_get(index);
        if (item >= b'0' && item <= b'9') || (item >= b'a' && item <= b'f') {} else {
            return false
        }
    }
    true
}

fn valid_relative_path(value: string) -> bool {
    if value == "" || value.starts_with("/") || value.ends_with("/") || value.contains("//") {
        return false
    }
    for part in text::split(value, "/") {
        if part == "" || part == "." || part == ".." {
            return false
        }
    }
    true
}

fn compare_generated_file(left: GeneratedFile, right: GeneratedFile) -> isize {
    if left.relative_path < right.relative_path {
        -1
    } else if left.relative_path > right.relative_path {
        1
    } else {
        0
    }
}

fn canonical_image_sources(values: Vec[GeneratedFile]) -> Result[Vec[GeneratedFile], string] {
    let result: Vec[GeneratedFile] = Vec::with_capacity(values.len());
    for value in values {
        if !valid_relative_path(value.relative_path) {
            return Result::Err("native image has invalid source path " + value.relative_path)
        } else if !value.relative_path.ends_with(".go") {
            return Result::Err("native image source must be a Go file: " + value.relative_path)
        } else if value.relative_path == "go.mod"
            || value.relative_path == "gomlgo_native_registry.go"
            || value.relative_path.starts_with("nativebridge/") {
            return Result::Err("native image source uses reserved path " + value.relative_path)
        }
        result.push(value)
    }
    collections::sort_by(result, compare_generated_file);
    for index in 1..result.len() {
        if result[index - 1].relative_path == result[index].relative_path {
            return Result::Err(
                "native image source path is repeated: " + result[index].relative_path,
            )
        }
    }
    Result::Ok(result)
}

fn canonical_bridge_sources(values: Vec[GeneratedFile]) -> Result[Vec[GeneratedFile], string] {
    let result: Vec[GeneratedFile] = Vec::with_capacity(values.len());
    for value in values {
        if !valid_relative_path(value.relative_path)
            || !value.relative_path.starts_with("nativebridge/") {
            return Result::Err("native bridge has invalid source path " + value.relative_path)
        } else if !value.relative_path.ends_with(".go") {
            return Result::Err("native bridge source must be a Go file: " + value.relative_path)
        } else if value.content == "" {
            return Result::Err("native bridge source cannot be empty: " + value.relative_path)
        }
        result.push(value)
    }
    collections::sort_by(result, compare_generated_file);
    for index in 1..result.len() {
        if result[index - 1].relative_path == result[index].relative_path {
            return Result::Err(
                "native bridge source path is repeated: " + result[index].relative_path,
            )
        }
    }
    Result::Ok(result)
}

fn append_cache_field(builder: text::StringBuilder, value: string) -> () {
    builder.write_string(value.byte_len().to_string());
    builder.write_string(":");
    builder.write_string(value)
}

fn generated_files_hash(values: Vec[GeneratedFile]) -> string {
    let builder = text::StringBuilder::new();
    append_cache_field(builder, values.len().to_string());
    for value in values {
        append_cache_field(builder, value.relative_path);
        append_cache_field(builder, value.content)
    }
    hash::sha256(bytes::Bytes::from_string(builder.finish()))
}

fn cache_key_material(
    input: CacheKeyInput,
    native_manifest_hash: string,
    bridge_source_hash: string,
    image_source_hash: string,
) -> Result[string, string] {
    if input.go_version == "" || input.goos == "" || input.goarch == "" {
        return Result::Err("native cache requires Go version, GOOS, and GOARCH")
    } else if !valid_hash(input.source_hash) {
        return Result::Err("native cache source hash must be lowercase SHA-256")
    } else if !valid_hash(input.import_manifest_hash) {
        return Result::Err("native cache import manifest hash must be lowercase SHA-256")
    } else if !valid_hash(native_manifest_hash) {
        return Result::Err("native manifest hash must be lowercase SHA-256")
    }
    let tags = canonical_tags(input.tags)?;
    let builder = text::StringBuilder::new();
    append_cache_field(builder, "gomlgo-native-cache");
    append_cache_field(builder, NATIVE_CACHE_SCHEMA_VERSION.to_string());
    append_cache_field(builder, NATIVE_REGISTRY_GENERATOR_VERSION.to_string());
    append_cache_field(builder, NATIVE_BRIDGE_ABI_VERSION.to_string());
    append_cache_field(builder, input.go_version);
    append_cache_field(builder, input.goos);
    append_cache_field(builder, input.goarch);
    append_cache_field(builder, input.goamd64);
    append_cache_field(builder, input.goexperiment);
    append_cache_field(
        builder,
        if input.cgo {
            "1"
        } else {
            "0"
        },
    );
    append_cache_field(builder, tags.len().to_string());
    for tag in tags {
        append_cache_field(builder, tag)
    }
    append_cache_field(builder, input.source_hash);
    append_cache_field(builder, input.import_manifest_hash);
    append_cache_field(builder, native_manifest_hash);
    append_cache_field(builder, bridge_source_hash);
    append_cache_field(builder, image_source_hash);
    Result::Ok(builder.finish())
}

fn cache_key_with_sources(
    input: CacheKeyInput,
    value: Manifest,
    bridge_sources: Vec[GeneratedFile],
    image_sources: Vec[GeneratedFile],
) -> Result[string, string] {
    let native_manifest_hash = manifest_hash(value)?;
    let canonical_bridge = canonical_bridge_sources(bridge_sources)?;
    let canonical_sources = canonical_image_sources(image_sources)?;
    let bridge_source_hash = generated_files_hash(canonical_bridge);
    let image_source_hash = generated_files_hash(canonical_sources);
    Result::Ok(
        hash::sha256(
            bytes::Bytes::from_string(
                cache_key_material(
                    input,
                    native_manifest_hash,
                    bridge_source_hash,
                    image_source_hash,
                )?,
            ),
        ),
    )
}

pub fn cache_key(input: CacheKeyInput, value: Manifest) -> Result[string, string] {
    cache_key_with_sources(input, value, Vec::new(), Vec::new())
}

fn execution_go_mod() -> string {
    "module " + EXECUTION_MODULE_PATH + "\n\ngo 1.26\n"
}

fn completion_metadata_prefix(key: string, native_manifest_hash: string) -> string {
    f"schema={NATIVE_CACHE_SCHEMA_VERSION}\nkey={key}\nabi={NATIVE_BRIDGE_ABI_VERSION}\nmanifest={native_manifest_hash}\nexecutable_sha256="
}

pub fn completion_metadata(plan: BuildPlan, executable_hash: string) -> Result[string, string] {
    if !valid_hash(executable_hash) {
        Result::Err("native executable hash must be lowercase SHA-256")
    } else {
        Result::Ok(plan.completion_metadata_prefix + executable_hash + "\n")
    }
}

pub fn completion_matches(plan: BuildPlan, metadata: string, executable_hash: string) -> bool {
    match completion_metadata(plan, executable_hash) {
        Ok(expected) => metadata == expected,
        Err(_) => false,
    }
}

pub fn build_plan(request: BuildRequest, value: Manifest) -> Result[BuildPlan, string] {
    if request.go_binary == "" {
        return Result::Err("native build requires a Go binary")
    } else if request.cache_root == "" {
        return Result::Err("native build requires a cache root")
    } else if request.bridge_sources.is_empty() {
        return Result::Err("native build requires bridge sources")
    } else if request.cache.cgo {
        return Result::Err("native execution images do not support cgo")
    }
    let canonical = canonical_manifest(value)?;
    let bridge_sources = canonical_bridge_sources(request.bridge_sources)?;
    let sources = canonical_image_sources(request.image_sources)?;
    let native_manifest_hash = manifest_hash(canonical)?;
    let key = cache_key_with_sources(request.cache, canonical, bridge_sources, sources)?;
    let final_directory = path::join(request.cache_root, key);
    let tags = canonical_tags(request.cache.tags)?;
    let arguments: Vec[string] = Vec::from_array(
        ["build", "-trimpath", "-buildvcs=false", "-o", "gomlgo-execution"],
    );
    if !tags.is_empty() {
        arguments.push("-tags");
        arguments.push(text::join(tags, ","))
    }
    arguments.push(".");
    let files: Vec[GeneratedFile] = Vec::from_array(
        [
            GeneratedFile { relative_path: "go.mod", content: execution_go_mod() },
            GeneratedFile {
                relative_path: "gomlgo_native_registry.go",
                content: generate_registry_source_with_bridge(
                    canonical,
                    EXECUTION_BRIDGE_IMPORT_PATH,
                )?,
            },
        ],
    );
    for source in bridge_sources {
        files.push(source)
    }
    for source in sources {
        files.push(source)
    }
    Result::Ok(
        BuildPlan {
            cache_key: key,
            manifest_hash: native_manifest_hash,
            final_directory,
            staging_root: path::join(path::join(request.cache_root, ".staging"), key),
            executable_relative_path: "gomlgo-execution",
            completion_relative_path: "complete",
            completion_metadata_prefix: completion_metadata_prefix(key, native_manifest_hash),
            files,
            go_binary: request.go_binary,
            arguments,
            environment: Vec::from_array(
                [
                    ("GOTOOLCHAIN", "local"),
                    ("GOENV", "off"),
                    ("GOWORK", "off"),
                    ("GOFLAGS", ""),
                    ("GOOS", request.cache.goos),
                    ("GOARCH", request.cache.goarch),
                    ("GOAMD64", request.cache.goamd64),
                    ("GOEXPERIMENT", request.cache.goexperiment),
                    ("CGO_ENABLED", "0"),
                    ("GOCACHE", path::join(request.cache_root, ".go-build")),
                ],
            ),
        },
    )
}
