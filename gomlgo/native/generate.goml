package native;

use std::collections;
use std::text;

struct RegistryImport {
    import_path: string,
    alias: string,
}

fn bridge_function(call: NativeCallSpec) -> bool {
    match call.binding {
        NativeBindingKind::Function => call.import_path == "os" && call.symbol == "Executable",
        _ => false,
    }
}

fn function_package_paths(value: Manifest) -> Vec[string] {
    let paths: collections::BTreeSet[string] = collections::BTreeSet::new();
    for call in value.calls {
        match call.binding {
            NativeBindingKind::Function => if !bridge_function(call) {
                let _ = paths.insert(call.import_path);
            },
            NativeBindingKind::Method => {
                let _ = paths.insert(call.import_path);
            },
            NativeBindingKind::Exit => (),
        }
    }
    for type_value in value.types {
        let _ = paths.insert(type_value.import_path);
    }
    for global in value.globals {
        let _ = paths.insert(global.import_path);
    }
    for proxy in value.proxies {
        let _ = paths.insert(proxy.import_path);
    }
    paths.to_vec()
}

fn package_alias(paths: Vec[string], expected: string) -> string {
    for index in 0..paths.len() {
        if paths[index] == expected {
            return f"_gomlgo_nativepkg{index}"
        }
    }
    ""
}

fn package_paths_contain(paths: Vec[string], expected: string) -> bool {
    for value in paths {
        if value == expected {
            return true
        }
    }
    false
}

fn registry_imports(value: Manifest, function_paths: Vec[string], bridge_import_path: string) -> Vec[
    RegistryImport,
] {
    let imports: Vec[RegistryImport] = Vec::new();
    imports.push(RegistryImport { import_path: bridge_import_path, alias: "_gomlgo_nativebridge" });
    if !value.proxies.is_empty() {
        imports.push(RegistryImport { import_path: "reflect", alias: "_gomlgo_reflect" })
    }
    for index in 0..function_paths.len() {
        imports.push(
            RegistryImport {
                import_path: function_paths[index],
                alias: f"_gomlgo_nativepkg{index}",
            },
        )
    }
    let blank_paths: collections::BTreeSet[string] = collections::BTreeSet::new();
    for import_path in value.initialization_packages {
        if !package_paths_contain(function_paths, import_path) {
            let _ = blank_paths.insert(import_path);
        }
    }
    for call in value.calls {
        match call.binding {
            NativeBindingKind::Function => (),
            NativeBindingKind::Method => (),
            NativeBindingKind::Exit => if !package_paths_contain(function_paths, call.import_path) {
                let _ = blank_paths.insert(call.import_path);
            },
        }
    }
    for import_path in blank_paths {
        imports.push(RegistryImport { import_path, alias: "_" })
    }
    collections::sort_by(
        imports,
        |left: RegistryImport, right: RegistryImport| if left.import_path < right.import_path {
            -1
        } else if left.import_path > right.import_path {
            1
        } else {
            0
        },
    );
    imports
}

fn write_imports(builder: text::StringBuilder, imports: Vec[RegistryImport]) -> () {
    builder.write_string("import (\n");
    for value in imports {
        builder.write_string("\t");
        builder.write_string(value.alias);
        builder.write_string(" \"");
        builder.write_string(value.import_path);
        builder.write_string("\"\n")
    }
    builder.write_string(")\n\n")
}

fn write_binding(builder: text::StringBuilder, call: NativeCallSpec, function_paths: Vec[string]) -> () {
    builder.write_string("\t\t_gomlgo_nativebridge.");
    match call.binding {
        NativeBindingKind::Function => {
            builder.write_string("Bind(_gomlgo_nativebridge.CallID(");
            builder.write_string(call.call_id.to_string());
            builder.write_string("), ");
            if bridge_function(call) {
                builder.write_string("_gomlgo_nativebridge.ProgramExecutable")
            } else {
                builder.write_string(package_alias(function_paths, call.import_path));
                builder.write_string(".");
                builder.write_string(call.symbol)
            }
            if !call.type_argument_keys.is_empty() {
                builder.write_string("[");
                builder.write_string(text::join(call.type_argument_keys, ", "));
                builder.write_string("]")
            }
            builder.write_string("),\n")
        },
        NativeBindingKind::Method => {
            builder.write_string("Bind(_gomlgo_nativebridge.CallID(");
            builder.write_string(call.call_id.to_string());
            builder.write_string("), ");
            if call.receiver_pointer {
                builder.write_string("(*")
            }
            builder.write_string(package_alias(function_paths, call.import_path));
            builder.write_string(".");
            builder.write_string(call.receiver_name);
            if call.receiver_pointer {
                builder.write_string(")")
            }
            builder.write_string(".");
            builder.write_string(call.symbol);
            builder.write_string("),\n")
        },
        NativeBindingKind::Exit => {
            builder.write_string("ExitBinding(_gomlgo_nativebridge.CallID(");
            builder.write_string(call.call_id.to_string());
            builder.write_string(")),\n")
        },
    }
}

fn write_type_registrations(
    builder: text::StringBuilder,
    value: Manifest,
    function_paths: Vec[string],
) -> () {
    for type_value in value.types {
        builder.write_string("\tif err := _gomlgo_nativebridge.RegisterNativeType(\"");
        builder.write_string(type_value.key);
        builder.write_string("\", ");
        builder.write_string(package_alias(function_paths, type_value.import_path));
        builder.write_string(".");
        builder.write_string(type_value.name);
        builder.write_string("{}); err != nil {\n\t\treturn nil, err\n\t}\n")
    }
}

fn write_global_registrations(
    builder: text::StringBuilder,
    value: Manifest,
    function_paths: Vec[string],
) -> () {
    for global in value.globals {
        builder.write_string("\tif err := _gomlgo_nativebridge.RegisterNativeGlobal(");
        builder.write_string(global.object_id.to_string());
        builder.write_string(", ");
        builder.write_string(package_alias(function_paths, global.import_path));
        builder.write_string(".");
        builder.write_string(global.name);
        builder.write_string("); err != nil {\n\t\treturn nil, err\n\t}\n")
    }
}

fn proxy_go_type(value: string) -> string {
    if value == "interface" {
        "any"
    } else {
        value
    }
}

fn write_proxy_method(
    builder: text::StringBuilder,
    proxy_index: isize,
    method: NativeProxyMethodSpec,
) -> () {
    builder.write_string("func (_gomlgo_receiver *_gomlgo_nativeproxy");
    builder.write_string(proxy_index.to_string());
    builder.write_string(") ");
    builder.write_string(method.name);
    builder.write_string("(");
    for index in 0..method.parameter_type_keys.len() {
        if index > 0 {
            builder.write_string(", ")
        }
        builder.write_string("_gomlgo_arg");
        builder.write_string(index.to_string());
        builder.write_string(" ");
        builder.write_string(proxy_go_type(method.parameter_type_keys[index]))
    }
    builder.write_string(")");
    if !method.result_type_keys.is_empty() {
        builder.write_string(" (");
        for index in 0..method.result_type_keys.len() {
            if index > 0 {
                builder.write_string(", ")
            }
            builder.write_string(proxy_go_type(method.result_type_keys[index]))
        }
        builder.write_string(")")
    }
    builder.write_string(" {\n");
    if method.result_type_keys.is_empty() {
        builder.write_string("\t_gomlgo_nativebridge.InvokeCallback(_gomlgo_receiver.token, \"")
    } else {
        builder.write_string(
            "\t_gomlgo_results := _gomlgo_nativebridge.InvokeCallback(_gomlgo_receiver.token, \"",
        )
    }
    builder.write_string(method.name);
    builder.write_string("\", []_gomlgo_nativebridge.ValueRef{");
    for index in 0..method.parameter_type_keys.len() {
        if index > 0 {
            builder.write_string(", ")
        }
        builder.write_string("_gomlgo_reflect.ValueOf(_gomlgo_arg");
        builder.write_string(index.to_string());
        builder.write_string(")")
    }
    builder.write_string("}, []_gomlgo_reflect.Type{");
    for index in 0..method.result_type_keys.len() {
        if index > 0 {
            builder.write_string(", ")
        }
        builder.write_string("_gomlgo_reflect.TypeFor[");
        builder.write_string(proxy_go_type(method.result_type_keys[index]));
        builder.write_string("]()")
    }
    builder.write_string("})\n");
    if !method.result_type_keys.is_empty() {
        builder.write_string("\treturn ");
        for index in 0..method.result_type_keys.len() {
            if index > 0 {
                builder.write_string(", ")
            }
            builder.write_string("_gomlgo_nativebridge.CallbackValue[");
            builder.write_string(proxy_go_type(method.result_type_keys[index]));
            builder.write_string("](_gomlgo_results, ");
            builder.write_string(index.to_string());
            builder.write_string(")")
        }
        builder.write_string("\n")
    }
    builder.write_string("}\n\n")
}

fn write_proxies(builder: text::StringBuilder, value: Manifest) -> () {
    for index in 0..value.proxies.len() {
        builder.write_string("type _gomlgo_nativeproxy");
        builder.write_string(index.to_string());
        builder.write_string(" struct {\n\ttoken *_gomlgo_nativebridge.CallbackToken\n}\n\n");
        for method in value.proxies[index].methods {
            write_proxy_method(builder, index, method)
        }
    }
}

fn write_aggregates(builder: text::StringBuilder, value: Manifest) -> () {
    for index in 0..value.aggregates.len() {
        let aggregate = value.aggregates[index];
        builder.write_string("type _gomlgo_nativeaggregate");
        builder.write_string(index.to_string());
        builder.write_string(" struct {\n");
        for field in aggregate.fields {
            builder.write_string("\t");
            builder.write_string(field.name);
            builder.write_string(" ");
            builder.write_string(field.type_key);
            if field.tag != "" {
                builder.write_string(" `");
                builder.write_string(field.tag);
                builder.write_string("`")
            }
            builder.write_string("\n")
        }
        builder.write_string("}\n\n")
    }
}

fn write_aggregate_registrations(builder: text::StringBuilder, value: Manifest) -> () {
    for index in 0..value.aggregates.len() {
        let aggregate = value.aggregates[index];
        builder.write_string("\tif err := _gomlgo_nativebridge.RegisterAggregateType(\"");
        builder.write_string(aggregate.key);
        builder.write_string("\", _gomlgo_nativeaggregate");
        builder.write_string(index.to_string());
        builder.write_string("{}); err != nil {\n\t\treturn nil, err\n\t}\n")
    }
}

fn write_proxy_registrations(
    builder: text::StringBuilder,
    value: Manifest,
    function_paths: Vec[string],
) -> () {
    for index in 0..value.proxies.len() {
        let proxy = value.proxies[index];
        builder.write_string("\tif err := _gomlgo_nativebridge.RegisterInterfaceProxy((*");
        builder.write_string(package_alias(function_paths, proxy.import_path));
        builder.write_string(".");
        builder.write_string(proxy.name);
        builder.write_string(
            ")(nil), func(_gomlgo_token *_gomlgo_nativebridge.CallbackToken) (_gomlgo_nativebridge.ValueRef, error) {\n",
        );
        builder.write_string("\t\treturn _gomlgo_reflect.ValueOf(&_gomlgo_nativeproxy");
        builder.write_string(index.to_string());
        builder.write_string("{token: _gomlgo_token}), nil\n");
        builder.write_string("\t}); err != nil {\n\t\treturn nil, err\n\t}\n")
    }
}

fn validate_bridge_import(value: Manifest, bridge_import_path: string) -> Result[(), string] {
    for import_path in value.initialization_packages {
        if import_path == bridge_import_path {
            return Result::Err("native manifest cannot initialize the generated bridge package")
        }
    }
    for call in value.calls {
        if call.import_path == bridge_import_path {
            return Result::Err("native calls cannot bind the generated bridge package")
        }
    }
    Result::Ok(())
}

fn generate_registry_source_with_bridge(value: Manifest, bridge_import_path: string) -> Result[
    string,
    string,
] {
    validate_bridge_import(value, bridge_import_path)?;
    let value = canonical_manifest(value)?;
    let function_paths = function_package_paths(value);
    let imports = registry_imports(value, function_paths, bridge_import_path);
    let builder = text::StringBuilder::new();
    builder.write_string("package main\n\n");
    write_imports(builder, imports);
    write_aggregates(builder, value);
    write_proxies(builder, value);
    builder.write_string(
        "func _gomlgo_install_native_registry() (*_gomlgo_nativebridge.Registry, error) {\n",
    );
    write_aggregate_registrations(builder, value);
    write_type_registrations(builder, value, function_paths);
    write_global_registrations(builder, value, function_paths);
    write_proxy_registrations(builder, value, function_paths);
    builder.write_string("\treturn _gomlgo_nativebridge.InstallDefault(\n");
    for call in value.calls {
        write_binding(builder, call, function_paths)
    }
    builder.write_string("\t)\n");
    builder.write_string("}\n\n");
    builder.write_string("func init() {\n");
    builder.write_string("\t_, err := _gomlgo_install_native_registry()\n");
    builder.write_string("\tif err != nil {\n");
    builder.write_string("\t\tpanic(err)\n");
    builder.write_string("\t}\n");
    builder.write_string("}\n");
    Result::Ok(builder.finish())
}

pub fn generate_registry_source(value: Manifest) -> Result[string, string] {
    generate_registry_source_with_bridge(value, NATIVE_BRIDGE_IMPORT_PATH)
}
