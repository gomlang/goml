package native;

use std::text;

#[go_ffi("gomlgo/nativebridge", "ResetCatalog")]
extern fn reset_catalog() -> ();

#[go_ffi("gomlgo/nativebridge", "CatalogSupportsPackage")]
extern fn catalog_supports_package(import_path: string) -> bool;

#[go_ffi("gomlgo/nativebridge", "CatalogBind")]
extern fn catalog_bind(
    call_id: u32,
    import_path: string,
    symbol: string,
    receiver_name: string,
    receiver_pointer: bool,
    type_arguments: string,
    exit: bool,
) -> bool;

#[go_ffi("gomlgo/nativebridge", "CatalogRegisterType")]
extern fn catalog_register_type(key: string, import_path: string, name: string) -> bool;

#[go_ffi("gomlgo/nativebridge", "CatalogRegisterAggregate")]
extern fn catalog_register_aggregate(key: string, type_keys: string, tags: string) -> bool;

#[go_ffi("gomlgo/nativebridge", "CatalogRegisterGlobal")]
extern fn catalog_register_global(id: isize, import_path: string, name: string) -> bool;

#[go_ffi("gomlgo/nativebridge", "CatalogRegisterProxy")]
extern fn catalog_register_proxy(import_path: string, name: string) -> bool;

pub fn install_catalog_error(value: Manifest) -> Option[string] {
    reset_catalog();
    for import_path in value.initialization_packages {
        if !catalog_supports_package(import_path) {
            reset_catalog();
            return Option::Some("native catalog does not support package " + import_path)
        }
    }
    for aggregate in value.aggregates {
        let type_keys: Vec[string] = Vec::with_capacity(aggregate.fields.len());
        let tags: Vec[string] = Vec::with_capacity(aggregate.fields.len());
        for field in aggregate.fields {
            type_keys.push(field.type_key);
            tags.push(field.tag)
        }
        if !catalog_register_aggregate(
            aggregate.key,
            text::join(type_keys, "\n"),
            text::join(tags, "\n"),
        ) {
            reset_catalog();
            return Option::Some("native catalog does not support aggregate " + aggregate.key)
        }
    }
    for type_value in value.types {
        if !catalog_register_type(type_value.key, type_value.import_path, type_value.name) {
            reset_catalog();
            return Option::Some(
                "native catalog does not support type " + type_value.import_path + "."
                    + type_value.name,
            )
        }
    }
    for global in value.globals {
        if !catalog_register_global(global.object_id, global.import_path, global.name) {
            reset_catalog();
            return Option::Some(
                "native catalog does not support global " + global.import_path + "." + global.name,
            )
        }
    }
    for proxy in value.proxies {
        if !catalog_register_proxy(proxy.import_path, proxy.name) {
            reset_catalog();
            return Option::Some(
                "native catalog does not support interface " + proxy.import_path + "." + proxy.name,
            )
        }
    }
    for call in value.calls {
        let exit = match call.binding {
            NativeBindingKind::Exit => true,
            NativeBindingKind::Function => false,
            NativeBindingKind::Method => false,
        };
        if !catalog_bind(
            call.call_id,
            call.import_path,
            call.symbol,
            call.receiver_name,
            call.receiver_pointer,
            text::join(call.type_argument_keys, "\n"),
            exit,
        ) {
            reset_catalog();
            let receiver = if call.receiver_name == "" {
                ""
            } else {
                call.receiver_name + "."
            };
            return Option::Some(
                "native catalog does not support call " + call.import_path + "." + receiver
                    + call.symbol,
            )
        }
    }
    Option::None
}

pub fn install_catalog(value: Manifest) -> bool {
    install_catalog_error(value).is_none()
}
