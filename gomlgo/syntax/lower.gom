package syntax;

use gomlgo::ast;

struct LowerContext {
    file_id: FileId,
    file_name: string,
    nodes: Vec[Option[SyntaxNode]],
    imports: Vec[NodeId],
    diagnostics: Vec[LowerDiagnostic],
}

fn report(context: LowerContext, value: ast::Node, message: string) -> () {
    context.diagnostics.push(
        LowerDiagnostic {
            file: context.file_name,
            start: value.span.start,
            end: value.span.end,
            message,
        },
    )
}

fn int_field(context: LowerContext, value: ast::Node, name: string) -> isize {
    let field = ast::get_field(value, name);
    if !field.present {
        report(context, value, "missing integer field " + name);
        return -1
    }
    match field.value {
        ast::Value::Int(result) => result,
        _ => {
            report(context, value, "expected integer field " + name);
            -1
        },
    }
}

fn string_field(context: LowerContext, value: ast::Node, name: string) -> string {
    let field = ast::get_field(value, name);
    if !field.present {
        report(context, value, "missing string field " + name);
        return ""
    }
    match field.value {
        ast::Value::String(result) => result,
        _ => {
            report(context, value, "expected string field " + name);
            ""
        },
    }
}

fn bool_field(context: LowerContext, value: ast::Node, name: string) -> bool {
    let field = ast::get_field(value, name);
    if !field.present {
        report(context, value, "missing boolean field " + name);
        return false
    }
    match field.value {
        ast::Value::Bool(result) => result,
        _ => {
            report(context, value, "expected boolean field " + name);
            false
        },
    }
}

fn allocate(context: LowerContext, value: ast::Node, path: SyntaxPath, kind: SyntaxKind) -> NodeId {
    let id = node_id(context.nodes.len());
    context.nodes.push(
        Option::Some(SyntaxNode { id, file: context.file_id, span: value.span, path, kind }),
    );
    id
}

fn invalid_child(context: LowerContext, value: ast::Node, path: SyntaxPath, message: string) -> NodeId {
    report(context, value, message);
    allocate(context, value, path, SyntaxKind::Invalid { message })
}

fn optional_child(context: LowerContext, value: ast::Node, name: string, path: SyntaxPath) -> Option[
    NodeId,
] {
    let field = ast::get_field(value, name);
    if !field.present {
        report(context, value, "missing optional node field " + name);
        return Option::None
    }
    match field.value {
        ast::Value::Node(child) => Option::Some(lower_node(context, child, field_path(path, name))),
        ast::Value::Null => Option::None,
        _ => {
            report(context, value, "expected optional node field " + name);
            Option::None
        },
    }
}

fn required_child(context: LowerContext, value: ast::Node, name: string, path: SyntaxPath) -> NodeId {
    let field = ast::get_field(value, name);
    if !field.present {
        return invalid_child(context, value, path, "missing node field " + name)
    }
    match field.value {
        ast::Value::Node(child) => lower_node(context, child, path),
        _ => invalid_child(context, value, path, "expected node field " + name),
    }
}

fn child_list(context: LowerContext, value: ast::Node, name: string, path: SyntaxPath) -> Vec[
    NodeId,
] {
    let field = ast::get_field(value, name);
    if !field.present {
        report(context, value, "missing node list field " + name);
        return Vec::new()
    }
    match field.value {
        ast::Value::Nodes(children) => ast_children(context, children, path, name),
        ast::Value::Null => Vec::new(),
        _ => {
            report(context, value, "expected node list field " + name);
            Vec::new()
        },
    }
}

fn field_path(path: SyntaxPath, name: string) -> SyntaxPath {
    append_path(path, PathSegment::Field, name, 0)
}

fn lower_kind(context: LowerContext, value: ast::Node, path: SyntaxPath) -> SyntaxKind {
    match value.kind {
        ast::Kind::Comment => match value.fields {
            ast::Fields::Comment { slash: _, text: field_text } => SyntaxKind::Comment {
                text: field_text,
            },
            _ => SyntaxKind::Comment { text: string_field(context, value, "text") },
        },
        ast::Kind::CommentGroup => match value.fields {
            ast::Fields::CommentGroup { list: field_list } => SyntaxKind::CommentGroup {
                list: ast_children(context, field_list, path, "list"),
            },
            _ => SyntaxKind::CommentGroup { list: child_list(context, value, "list", path) },
        },
        ast::Kind::Field => match value.fields {
            ast::Fields::Field { names: field_names, type_node: field_type, tag: field_tag } => SyntaxKind::Field {
                names: optional_ast_children(context, field_names, path, "names"),
                type_node: required_ast_child(
                    context,
                    value,
                    "type",
                    field_type,
                    field_path(path, "type"),
                ),
                tag: optional_ast_child(context, field_tag, path, "tag"),
            },
            _ => SyntaxKind::Field {
                names: child_list(context, value, "names", path),
                type_node: required_child(context, value, "type", field_path(path, "type")),
                tag: optional_child(context, value, "tag", path),
            },
        },
        ast::Kind::FieldList => match value.fields {
            ast::Fields::FieldList {
                opening: field_opening,
                list: field_list,
                closing: field_closing,
            } => SyntaxKind::FieldList {
                opening: field_opening,
                list: optional_ast_children(context, field_list, path, "list"),
                closing: field_closing,
            },
            _ => SyntaxKind::FieldList {
                opening: int_field(context, value, "opening"),
                list: child_list(context, value, "list", path),
                closing: int_field(context, value, "closing"),
            },
        },
        ast::Kind::BadExpr => match value.fields {
            ast::Fields::BadExpr { from: field_from, to: field_to } => SyntaxKind::BadExpr {
                from: field_from,
                to: field_to,
            },
            _ => SyntaxKind::BadExpr {
                from: int_field(context, value, "from"),
                to: int_field(context, value, "to"),
            },
        },
        ast::Kind::Ident => match value.fields {
            ast::Fields::Ident(name) => SyntaxKind::Ident { name_pos: value.span.start, name },
            _ => SyntaxKind::Ident {
                name_pos: int_field(context, value, "name_pos"),
                name: string_field(context, value, "name"),
            },
        },
        ast::Kind::Ellipsis => match value.fields {
            ast::Fields::Ellipsis { ellipsis: field_ellipsis, elt: field_elt } => SyntaxKind::Ellipsis {
                ellipsis: field_ellipsis,
                element: optional_ast_child(context, field_elt, path, "elt"),
            },
            _ => SyntaxKind::Ellipsis {
                ellipsis: int_field(context, value, "ellipsis"),
                element: optional_child(context, value, "elt", path),
            },
        },
        ast::Kind::BasicLit => match value.fields {
            ast::Fields::Literal { token, value: literal } => SyntaxKind::BasicLit {
                value_pos: value.span.start,
                value_end: value.span.end,
                token,
                value: literal,
            },
            _ => SyntaxKind::BasicLit {
                value_pos: int_field(context, value, "value_pos"),
                value_end: int_field(context, value, "value_end"),
                token: string_field(context, value, "token"),
                value: string_field(context, value, "value"),
            },
        },
        ast::Kind::FuncLit => match value.fields {
            ast::Fields::FuncLit { type_node: field_type, body: field_body } => SyntaxKind::FuncLit {
                type_node: lower_node(context, field_type, field_path(path, "type")),
                body: lower_node(context, field_body, field_path(path, "body")),
            },
            _ => SyntaxKind::FuncLit {
                type_node: required_child(context, value, "type", field_path(path, "type")),
                body: required_child(context, value, "body", field_path(path, "body")),
            },
        },
        ast::Kind::CompositeLit => match value.fields {
            ast::Fields::CompositeLit {
                type_node: field_type,
                lbrace: field_lbrace,
                elts: field_elts,
                rbrace: field_rbrace,
                incomplete: field_incomplete,
            } => SyntaxKind::CompositeLit {
                type_node: optional_ast_child(context, field_type, path, "type"),
                lbrace: field_lbrace,
                elements: optional_ast_children(context, field_elts, path, "elts"),
                rbrace: field_rbrace,
                incomplete: field_incomplete,
            },
            _ => SyntaxKind::CompositeLit {
                type_node: optional_child(context, value, "type", path),
                lbrace: int_field(context, value, "lbrace"),
                elements: child_list(context, value, "elts", path),
                rbrace: int_field(context, value, "rbrace"),
                incomplete: bool_field(context, value, "incomplete"),
            },
        },
        ast::Kind::ParenExpr => match value.fields {
            ast::Fields::ParenExpr { lparen: field_lparen, x: field_x, rparen: field_rparen } => SyntaxKind::ParenExpr {
                lparen: field_lparen,
                expression: lower_node(context, field_x, field_path(path, "x")),
                rparen: field_rparen,
            },
            _ => SyntaxKind::ParenExpr {
                lparen: int_field(context, value, "lparen"),
                expression: required_child(context, value, "x", field_path(path, "x")),
                rparen: int_field(context, value, "rparen"),
            },
        },
        ast::Kind::SelectorExpr => match value.fields {
            ast::Fields::SelectorExpr { x: field_x, sel: field_sel } => SyntaxKind::SelectorExpr {
                expression: lower_node(context, field_x, field_path(path, "x")),
                selector: lower_node(context, field_sel, field_path(path, "sel")),
            },
            _ => SyntaxKind::SelectorExpr {
                expression: required_child(context, value, "x", field_path(path, "x")),
                selector: required_child(context, value, "sel", field_path(path, "sel")),
            },
        },
        ast::Kind::IndexExpr => match value.fields {
            ast::Fields::IndexExpr {
                x: field_x,
                lbrack: field_lbrack,
                index: field_index,
                rbrack: field_rbrack,
            } => SyntaxKind::IndexExpr {
                expression: lower_node(context, field_x, field_path(path, "x")),
                lbrack: field_lbrack,
                index: lower_node(context, field_index, field_path(path, "index")),
                rbrack: field_rbrack,
            },
            _ => SyntaxKind::IndexExpr {
                expression: required_child(context, value, "x", field_path(path, "x")),
                lbrack: int_field(context, value, "lbrack"),
                index: required_child(context, value, "index", field_path(path, "index")),
                rbrack: int_field(context, value, "rbrack"),
            },
        },
        ast::Kind::IndexListExpr => match value.fields {
            ast::Fields::IndexListExpr {
                x: field_x,
                lbrack: field_lbrack,
                indices: field_indices,
                rbrack: field_rbrack,
            } => SyntaxKind::IndexListExpr {
                expression: lower_node(context, field_x, field_path(path, "x")),
                lbrack: field_lbrack,
                indices: ast_children(context, field_indices, path, "indices"),
                rbrack: field_rbrack,
            },
            _ => SyntaxKind::IndexListExpr {
                expression: required_child(context, value, "x", field_path(path, "x")),
                lbrack: int_field(context, value, "lbrack"),
                indices: child_list(context, value, "indices", path),
                rbrack: int_field(context, value, "rbrack"),
            },
        },
        ast::Kind::SliceExpr => match value.fields {
            ast::Fields::SliceExpr {
                x: field_x,
                lbrack: field_lbrack,
                low: field_low,
                high: field_high,
                max: field_max,
                slice3: field_slice3,
                rbrack: field_rbrack,
            } => SyntaxKind::SliceExpr {
                expression: lower_node(context, field_x, field_path(path, "x")),
                lbrack: field_lbrack,
                low: optional_ast_child(context, field_low, path, "low"),
                high: optional_ast_child(context, field_high, path, "high"),
                max: optional_ast_child(context, field_max, path, "max"),
                slice3: field_slice3,
                rbrack: field_rbrack,
            },
            _ => SyntaxKind::SliceExpr {
                expression: required_child(context, value, "x", field_path(path, "x")),
                lbrack: int_field(context, value, "lbrack"),
                low: optional_child(context, value, "low", path),
                high: optional_child(context, value, "high", path),
                max: optional_child(context, value, "max", path),
                slice3: bool_field(context, value, "slice3"),
                rbrack: int_field(context, value, "rbrack"),
            },
        },
        ast::Kind::TypeAssertExpr => match value.fields {
            ast::Fields::TypeAssertExpr {
                x: field_x,
                lparen: field_lparen,
                type_node: field_type,
                rparen: field_rparen,
            } => SyntaxKind::TypeAssertExpr {
                expression: lower_node(context, field_x, field_path(path, "x")),
                lparen: field_lparen,
                type_node: optional_ast_child(context, field_type, path, "type"),
                rparen: field_rparen,
            },
            _ => SyntaxKind::TypeAssertExpr {
                expression: required_child(context, value, "x", field_path(path, "x")),
                lparen: int_field(context, value, "lparen"),
                type_node: optional_child(context, value, "type", path),
                rparen: int_field(context, value, "rparen"),
            },
        },
        ast::Kind::CallExpr => match value.fields {
            ast::Fields::CallExpr {
                fun: field_fun,
                lparen: field_lparen,
                args: field_args,
                ellipsis: field_ellipsis,
                rparen: field_rparen,
            } => SyntaxKind::CallExpr {
                function: lower_node(context, field_fun, field_path(path, "fun")),
                lparen: field_lparen,
                arguments: optional_ast_children(context, field_args, path, "args"),
                ellipsis: field_ellipsis,
                rparen: field_rparen,
            },
            _ => SyntaxKind::CallExpr {
                function: required_child(context, value, "fun", field_path(path, "fun")),
                lparen: int_field(context, value, "lparen"),
                arguments: child_list(context, value, "args", path),
                ellipsis: int_field(context, value, "ellipsis"),
                rparen: int_field(context, value, "rparen"),
            },
        },
        ast::Kind::StarExpr => match value.fields {
            ast::Fields::StarExpr { star: field_star, x: field_x } => SyntaxKind::StarExpr {
                star: field_star,
                expression: lower_node(context, field_x, field_path(path, "x")),
            },
            _ => SyntaxKind::StarExpr {
                star: int_field(context, value, "star"),
                expression: required_child(context, value, "x", field_path(path, "x")),
            },
        },
        ast::Kind::UnaryExpr => match value.fields {
            ast::Fields::UnaryExpr { op_pos: field_op_pos, op: field_op, x: field_x } => SyntaxKind::UnaryExpr {
                op_pos: field_op_pos,
                op: field_op,
                expression: lower_node(context, field_x, field_path(path, "x")),
            },
            _ => SyntaxKind::UnaryExpr {
                op_pos: int_field(context, value, "op_pos"),
                op: string_field(context, value, "op"),
                expression: required_child(context, value, "x", field_path(path, "x")),
            },
        },
        ast::Kind::BinaryExpr => match value.fields {
            ast::Fields::BinaryExpr { x: field_x, op_pos: field_op_pos, op: field_op, y: field_y } => SyntaxKind::BinaryExpr {
                left: lower_node(context, field_x, field_path(path, "x")),
                op_pos: field_op_pos,
                op: field_op,
                right: lower_node(context, field_y, field_path(path, "y")),
            },
            _ => SyntaxKind::BinaryExpr {
                left: required_child(context, value, "x", field_path(path, "x")),
                op_pos: int_field(context, value, "op_pos"),
                op: string_field(context, value, "op"),
                right: required_child(context, value, "y", field_path(path, "y")),
            },
        },
        ast::Kind::KeyValueExpr => match value.fields {
            ast::Fields::KeyValueExpr { key: field_key, colon: field_colon, value: field_value } => SyntaxKind::KeyValueExpr {
                key: lower_node(context, field_key, field_path(path, "key")),
                colon: field_colon,
                value: lower_node(context, field_value, field_path(path, "value")),
            },
            _ => SyntaxKind::KeyValueExpr {
                key: required_child(context, value, "key", field_path(path, "key")),
                colon: int_field(context, value, "colon"),
                value: required_child(context, value, "value", field_path(path, "value")),
            },
        },
        ast::Kind::ArrayType => match value.fields {
            ast::Fields::ArrayType { lbrack: field_lbrack, len: field_len, elt: field_elt } => SyntaxKind::ArrayType {
                lbrack: field_lbrack,
                length: optional_ast_child(context, field_len, path, "len"),
                element: lower_node(context, field_elt, field_path(path, "elt")),
            },
            _ => SyntaxKind::ArrayType {
                lbrack: int_field(context, value, "lbrack"),
                length: optional_child(context, value, "len", path),
                element: required_child(context, value, "elt", field_path(path, "elt")),
            },
        },
        ast::Kind::StructType => match value.fields {
            ast::Fields::StructType {
                struct_pos: field_struct,
                fields: field_fields,
                incomplete: field_incomplete,
            } => SyntaxKind::StructType {
                struct_pos: field_struct,
                fields: lower_node(context, field_fields, field_path(path, "fields")),
                incomplete: field_incomplete,
            },
            _ => SyntaxKind::StructType {
                struct_pos: int_field(context, value, "struct"),
                fields: required_child(context, value, "fields", field_path(path, "fields")),
                incomplete: bool_field(context, value, "incomplete"),
            },
        },
        ast::Kind::FuncType => match value.fields {
            ast::Fields::FuncType {
                func_pos: field_func,
                type_params: field_type_params,
                params: field_params,
                results: field_results,
            } => SyntaxKind::FuncType {
                func_pos: field_func,
                type_params: optional_ast_child(context, field_type_params, path, "type_params"),
                params: lower_node(context, field_params, field_path(path, "params")),
                results: optional_ast_child(context, field_results, path, "results"),
            },
            _ => SyntaxKind::FuncType {
                func_pos: int_field(context, value, "func"),
                type_params: optional_child(context, value, "type_params", path),
                params: required_child(context, value, "params", field_path(path, "params")),
                results: optional_child(context, value, "results", path),
            },
        },
        ast::Kind::InterfaceType => match value.fields {
            ast::Fields::InterfaceType {
                interface_pos: field_interface,
                methods: field_methods,
                incomplete: field_incomplete,
            } => SyntaxKind::InterfaceType {
                interface_pos: field_interface,
                methods: lower_node(context, field_methods, field_path(path, "methods")),
                incomplete: field_incomplete,
            },
            _ => SyntaxKind::InterfaceType {
                interface_pos: int_field(context, value, "interface"),
                methods: required_child(context, value, "methods", field_path(path, "methods")),
                incomplete: bool_field(context, value, "incomplete"),
            },
        },
        ast::Kind::MapType => match value.fields {
            ast::Fields::MapType { map_pos: field_map, key: field_key, value: field_value } => SyntaxKind::MapType {
                map_pos: field_map,
                key: lower_node(context, field_key, field_path(path, "key")),
                value: lower_node(context, field_value, field_path(path, "value")),
            },
            _ => SyntaxKind::MapType {
                map_pos: int_field(context, value, "map"),
                key: required_child(context, value, "key", field_path(path, "key")),
                value: required_child(context, value, "value", field_path(path, "value")),
            },
        },
        ast::Kind::ChanType => match value.fields {
            ast::Fields::ChanType {
                begin: field_begin,
                arrow: field_arrow,
                dir: field_dir,
                value: field_value,
            } => SyntaxKind::ChanType {
                begin: field_begin,
                arrow: field_arrow,
                direction: field_dir,
                value: lower_node(context, field_value, field_path(path, "value")),
            },
            _ => SyntaxKind::ChanType {
                begin: int_field(context, value, "begin"),
                arrow: int_field(context, value, "arrow"),
                direction: int_field(context, value, "dir"),
                value: required_child(context, value, "value", field_path(path, "value")),
            },
        },
        ast::Kind::BadStmt => match value.fields {
            ast::Fields::BadStmt { from: field_from, to: field_to } => SyntaxKind::BadStmt {
                from: field_from,
                to: field_to,
            },
            _ => SyntaxKind::BadStmt {
                from: int_field(context, value, "from"),
                to: int_field(context, value, "to"),
            },
        },
        ast::Kind::DeclStmt => match value.fields {
            ast::Fields::DeclStmt { decl: field_decl } => SyntaxKind::DeclStmt {
                declaration: lower_node(context, field_decl, field_path(path, "decl")),
            },
            _ => SyntaxKind::DeclStmt {
                declaration: required_child(context, value, "decl", field_path(path, "decl")),
            },
        },
        ast::Kind::EmptyStmt => match value.fields {
            ast::Fields::EmptyStmt { semicolon: field_semicolon, implicit: field_implicit } => SyntaxKind::EmptyStmt {
                semicolon: field_semicolon,
                implicit: field_implicit,
            },
            _ => SyntaxKind::EmptyStmt {
                semicolon: int_field(context, value, "semicolon"),
                implicit: bool_field(context, value, "implicit"),
            },
        },
        ast::Kind::LabeledStmt => match value.fields {
            ast::Fields::LabeledStmt { label: field_label, colon: field_colon, stmt: field_stmt } => SyntaxKind::LabeledStmt {
                label: lower_node(context, field_label, field_path(path, "label")),
                colon: field_colon,
                statement: lower_node(context, field_stmt, field_path(path, "stmt")),
            },
            _ => SyntaxKind::LabeledStmt {
                label: required_child(context, value, "label", field_path(path, "label")),
                colon: int_field(context, value, "colon"),
                statement: required_child(context, value, "stmt", field_path(path, "stmt")),
            },
        },
        ast::Kind::ExprStmt => match value.fields {
            ast::Fields::ExprStmt { x: field_x } => SyntaxKind::ExprStmt {
                expression: lower_node(context, field_x, field_path(path, "x")),
            },
            _ => SyntaxKind::ExprStmt {
                expression: required_child(context, value, "x", field_path(path, "x")),
            },
        },
        ast::Kind::SendStmt => match value.fields {
            ast::Fields::SendStmt { channel: field_chan, arrow: field_arrow, value: field_value } => SyntaxKind::SendStmt {
                channel: lower_node(context, field_chan, field_path(path, "chan")),
                arrow: field_arrow,
                value: lower_node(context, field_value, field_path(path, "value")),
            },
            _ => SyntaxKind::SendStmt {
                channel: required_child(context, value, "chan", field_path(path, "chan")),
                arrow: int_field(context, value, "arrow"),
                value: required_child(context, value, "value", field_path(path, "value")),
            },
        },
        ast::Kind::IncDecStmt => match value.fields {
            ast::Fields::IncDecStmt { x: field_x, token_pos: field_token_pos, token: field_token } => SyntaxKind::IncDecStmt {
                expression: lower_node(context, field_x, field_path(path, "x")),
                token_pos: field_token_pos,
                token: field_token,
            },
            _ => SyntaxKind::IncDecStmt {
                expression: required_child(context, value, "x", field_path(path, "x")),
                token_pos: int_field(context, value, "token_pos"),
                token: string_field(context, value, "token"),
            },
        },
        ast::Kind::AssignStmt => match value.fields {
            ast::Fields::AssignStmt {
                lhs: field_lhs,
                token_pos: field_token_pos,
                token: field_token,
                rhs: field_rhs,
            } => SyntaxKind::AssignStmt {
                left: ast_children(context, field_lhs, path, "lhs"),
                token_pos: field_token_pos,
                token: field_token,
                right: ast_children(context, field_rhs, path, "rhs"),
            },
            _ => SyntaxKind::AssignStmt {
                left: child_list(context, value, "lhs", path),
                token_pos: int_field(context, value, "token_pos"),
                token: string_field(context, value, "token"),
                right: child_list(context, value, "rhs", path),
            },
        },
        ast::Kind::GoStmt => SyntaxKind::GoStmt {
            go_pos: int_field(context, value, "go"),
            call: required_child(context, value, "call", field_path(path, "call")),
        },
        ast::Kind::DeferStmt => SyntaxKind::DeferStmt {
            defer_pos: int_field(context, value, "defer"),
            call: required_child(context, value, "call", field_path(path, "call")),
        },
        ast::Kind::ReturnStmt => match value.fields {
            ast::Fields::ReturnStmt { return_pos: field_return, results: field_results } => SyntaxKind::ReturnStmt {
                return_pos: field_return,
                results: optional_ast_children(context, field_results, path, "results"),
            },
            _ => SyntaxKind::ReturnStmt {
                return_pos: int_field(context, value, "return"),
                results: child_list(context, value, "results", path),
            },
        },
        ast::Kind::BranchStmt => match value.fields {
            ast::Fields::BranchStmt {
                token_pos: field_token_pos,
                token: field_token,
                label: field_label,
            } => SyntaxKind::BranchStmt {
                token_pos: field_token_pos,
                token: field_token,
                label: optional_ast_child(context, field_label, path, "label"),
            },
            _ => SyntaxKind::BranchStmt {
                token_pos: int_field(context, value, "token_pos"),
                token: string_field(context, value, "token"),
                label: optional_child(context, value, "label", path),
            },
        },
        ast::Kind::BlockStmt => match value.fields {
            ast::Fields::BlockStmt { lbrace: field_lbrace, list: field_list, rbrace: field_rbrace } => SyntaxKind::BlockStmt {
                lbrace: field_lbrace,
                list: optional_ast_children(context, field_list, path, "list"),
                rbrace: field_rbrace,
            },
            _ => SyntaxKind::BlockStmt {
                lbrace: int_field(context, value, "lbrace"),
                list: child_list(context, value, "list", path),
                rbrace: int_field(context, value, "rbrace"),
            },
        },
        ast::Kind::IfStmt => match value.fields {
            ast::Fields::IfStmt {
                if_pos: field_if,
                init: field_init,
                cond: field_cond,
                body: field_body,
                else_node: field_else,
            } => SyntaxKind::IfStmt {
                if_pos: field_if,
                init: optional_ast_child(context, field_init, path, "init"),
                condition: lower_node(context, field_cond, field_path(path, "cond")),
                body: lower_node(context, field_body, field_path(path, "body")),
                else_branch: optional_ast_child(context, field_else, path, "else"),
            },
            _ => SyntaxKind::IfStmt {
                if_pos: int_field(context, value, "if"),
                init: optional_child(context, value, "init", path),
                condition: required_child(context, value, "cond", field_path(path, "cond")),
                body: required_child(context, value, "body", field_path(path, "body")),
                else_branch: optional_child(context, value, "else", path),
            },
        },
        ast::Kind::CaseClause => match value.fields {
            ast::Fields::CaseClause {
                case_pos: field_case,
                list: field_list,
                colon: field_colon,
                body: field_body,
            } => SyntaxKind::CaseClause {
                case_pos: field_case,
                list: optional_ast_children(context, field_list, path, "list"),
                colon: field_colon,
                body: optional_ast_children(context, field_body, path, "body"),
            },
            _ => SyntaxKind::CaseClause {
                case_pos: int_field(context, value, "case"),
                list: child_list(context, value, "list", path),
                colon: int_field(context, value, "colon"),
                body: child_list(context, value, "body", path),
            },
        },
        ast::Kind::SwitchStmt => SyntaxKind::SwitchStmt {
            switch_pos: int_field(context, value, "switch"),
            init: optional_child(context, value, "init", path),
            tag: optional_child(context, value, "tag", path),
            body: required_child(context, value, "body", field_path(path, "body")),
        },
        ast::Kind::TypeSwitchStmt => SyntaxKind::TypeSwitchStmt {
            switch_pos: int_field(context, value, "switch"),
            init: optional_child(context, value, "init", path),
            assignment: required_child(context, value, "assign", field_path(path, "assign")),
            body: required_child(context, value, "body", field_path(path, "body")),
        },
        ast::Kind::CommClause => match value.fields {
            ast::Fields::CommClause {
                case_pos: field_case,
                comm: field_comm,
                colon: field_colon,
                body: field_body,
            } => SyntaxKind::CommClause {
                case_pos: field_case,
                communication: optional_ast_child(context, field_comm, path, "comm"),
                colon: field_colon,
                body: optional_ast_children(context, field_body, path, "body"),
            },
            _ => SyntaxKind::CommClause {
                case_pos: int_field(context, value, "case"),
                communication: optional_child(context, value, "comm", path),
                colon: int_field(context, value, "colon"),
                body: child_list(context, value, "body", path),
            },
        },
        ast::Kind::SelectStmt => match value.fields {
            ast::Fields::SelectStmt { select_pos: field_select, body: field_body } => SyntaxKind::SelectStmt {
                select_pos: field_select,
                body: lower_node(context, field_body, field_path(path, "body")),
            },
            _ => SyntaxKind::SelectStmt {
                select_pos: int_field(context, value, "select"),
                body: required_child(context, value, "body", field_path(path, "body")),
            },
        },
        ast::Kind::ForStmt => match value.fields {
            ast::Fields::ForStmt {
                for_pos: field_for,
                init: field_init,
                cond: field_cond,
                post: field_post,
                body: field_body,
            } => SyntaxKind::ForStmt {
                for_pos: field_for,
                init: optional_ast_child(context, field_init, path, "init"),
                condition: optional_ast_child(context, field_cond, path, "cond"),
                post: optional_ast_child(context, field_post, path, "post"),
                body: lower_node(context, field_body, field_path(path, "body")),
            },
            _ => SyntaxKind::ForStmt {
                for_pos: int_field(context, value, "for"),
                init: optional_child(context, value, "init", path),
                condition: optional_child(context, value, "cond", path),
                post: optional_child(context, value, "post", path),
                body: required_child(context, value, "body", field_path(path, "body")),
            },
        },
        ast::Kind::RangeStmt => match value.fields {
            ast::Fields::RangeStmt {
                for_pos: field_for,
                key: field_key,
                value: field_value,
                token_pos: field_token_pos,
                token: field_token,
                range_pos: field_range,
                x: field_x,
                body: field_body,
            } => SyntaxKind::RangeStmt {
                for_pos: field_for,
                key: optional_ast_child(context, field_key, path, "key"),
                value: optional_ast_child(context, field_value, path, "value"),
                token_pos: field_token_pos,
                token: field_token,
                range_pos: field_range,
                expression: required_ast_child(context, value, "x", field_x, field_path(path, "x")),
                body: required_ast_child(
                    context,
                    value,
                    "body",
                    field_body,
                    field_path(path, "body"),
                ),
            },
            _ => SyntaxKind::RangeStmt {
                for_pos: int_field(context, value, "for"),
                key: optional_child(context, value, "key", path),
                value: optional_child(context, value, "value", path),
                token_pos: int_field(context, value, "token_pos"),
                token: string_field(context, value, "token"),
                range_pos: int_field(context, value, "range"),
                expression: required_child(context, value, "x", field_path(path, "x")),
                body: required_child(context, value, "body", field_path(path, "body")),
            },
        },
        ast::Kind::ImportSpec => match value.fields {
            ast::Fields::ImportSpec {
                name: field_name,
                path: field_path_node,
                end_pos: field_end_pos,
            } => SyntaxKind::ImportSpec {
                name: optional_ast_child(context, field_name, path, "name"),
                path: lower_node(context, field_path_node, field_path(path, "path")),
                end_pos: field_end_pos,
            },
            _ => SyntaxKind::ImportSpec {
                name: optional_child(context, value, "name", path),
                path: required_child(context, value, "path", field_path(path, "path")),
                end_pos: int_field(context, value, "end_pos"),
            },
        },
        ast::Kind::ValueSpec => match value.fields {
            ast::Fields::ValueSpec {
                names: field_names,
                type_node: field_type,
                values: field_values,
            } => SyntaxKind::ValueSpec {
                names: ast_children(context, field_names, path, "names"),
                type_node: optional_ast_child(context, field_type, path, "type"),
                values: optional_ast_children(context, field_values, path, "values"),
            },
            _ => SyntaxKind::ValueSpec {
                names: child_list(context, value, "names", path),
                type_node: optional_child(context, value, "type", path),
                values: child_list(context, value, "values", path),
            },
        },
        ast::Kind::TypeSpec => match value.fields {
            ast::Fields::TypeSpec {
                name: field_name,
                type_params: field_type_params,
                assign: field_assign,
                type_node: field_type,
            } => SyntaxKind::TypeSpec {
                name: lower_node(context, field_name, field_path(path, "name")),
                type_params: optional_ast_child(context, field_type_params, path, "type_params"),
                assign: field_assign,
                type_node: lower_node(context, field_type, field_path(path, "type")),
            },
            _ => SyntaxKind::TypeSpec {
                name: required_child(context, value, "name", field_path(path, "name")),
                type_params: optional_child(context, value, "type_params", path),
                assign: int_field(context, value, "assign"),
                type_node: required_child(context, value, "type", field_path(path, "type")),
            },
        },
        ast::Kind::BadDecl => match value.fields {
            ast::Fields::BadDecl { from: field_from, to: field_to } => SyntaxKind::BadDecl {
                from: field_from,
                to: field_to,
            },
            _ => SyntaxKind::BadDecl {
                from: int_field(context, value, "from"),
                to: int_field(context, value, "to"),
            },
        },
        ast::Kind::GenDecl => match value.fields {
            ast::Fields::GenDecl {
                token_pos: field_token_pos,
                token: field_token,
                lparen: field_lparen,
                specs: field_specs,
                rparen: field_rparen,
            } => SyntaxKind::GenDecl {
                token_pos: field_token_pos,
                token: field_token,
                lparen: field_lparen,
                specs: optional_ast_children(context, field_specs, path, "specs"),
                rparen: field_rparen,
            },
            _ => SyntaxKind::GenDecl {
                token_pos: int_field(context, value, "token_pos"),
                token: string_field(context, value, "token"),
                lparen: int_field(context, value, "lparen"),
                specs: child_list(context, value, "specs", path),
                rparen: int_field(context, value, "rparen"),
            },
        },
        ast::Kind::FuncDecl => match value.fields {
            ast::Fields::FuncDecl {
                recv: field_recv,
                name: field_name,
                type_node: field_type,
                body: field_body,
            } => SyntaxKind::FuncDecl {
                receiver: optional_ast_child(context, field_recv, path, "recv"),
                name: lower_node(context, field_name, field_path(path, "name")),
                type_node: lower_node(context, field_type, field_path(path, "type")),
                body: optional_ast_child(context, field_body, path, "body"),
            },
            _ => SyntaxKind::FuncDecl {
                receiver: optional_child(context, value, "recv", path),
                name: required_child(context, value, "name", field_path(path, "name")),
                type_node: required_child(context, value, "type", field_path(path, "type")),
                body: optional_child(context, value, "body", path),
            },
        },
        ast::Kind::File => match value.fields {
            ast::Fields::File {
                package_pos: field_package,
                name: field_name,
                decls: field_decls,
                file_start: _,
                file_end: _,
                imports: _,
                comments: _,
                go_version: field_go_version,
            } => SyntaxKind::File {
                package_pos: field_package,
                name: lower_node(context, field_name, field_path(path, "name")),
                declarations: optional_ast_children(context, field_decls, path, "decls"),
                imports: context.imports,
                go_version: field_go_version,
            },
            _ => SyntaxKind::File {
                package_pos: int_field(context, value, "package"),
                name: required_child(context, value, "name", field_path(path, "name")),
                declarations: child_list(context, value, "decls", path),
                imports: context.imports,
                go_version: string_field(context, value, "go_version"),
            },
        },
    }
}

fn lower_node(context: LowerContext, value: ast::Node, path: SyntaxPath) -> NodeId {
    let kind = lower_kind(context, value, path);
    let id = allocate(context, value, path, kind);
    if ast::kind_equal(value.kind, ast::Kind::ImportSpec) {
        context.imports.push(id)
    }
    id
}

fn contains_name(values: Vec[string], name: string) -> bool {
    for value in values {
        if value == name {
            return true
        }
    }
    false
}

fn ast_list_node_count(children: Vec[ast::Node], list_count: Ref[isize]) -> isize {
    let length = children.len();
    if length == 0 {
        return 0
    }
    list_count.set(list_count.get() + 1);
    let mut count = 0;
    let mut index = 0;
    while index < length {
        count += ast_node_count(children[index], list_count);
        index += 1;
    }
    count
}

fn ast_node_count(value: ast::Node, list_count: Ref[isize]) -> isize {
    let mut count = 1;
    match value.fields {
        ast::Fields::Comment { slash: _, text: _ } => {
            return count;
        },
        ast::Fields::CommentGroup { list: field_list } => {
            count += ast_list_node_count(field_list, list_count);
            return count;
        },
        ast::Fields::ParenExpr { lparen: _, x: field_x, rparen: _ } => {
            count += ast_node_count(field_x, list_count);
            return count;
        },
        ast::Fields::FuncLit { type_node: field_type, body: field_body } => {
            count += ast_node_count(field_type, list_count);
            count += ast_node_count(field_body, list_count);
            return count;
        },
        ast::Fields::TypeAssertExpr { x: field_x, lparen: _, type_node: field_type, rparen: _ } => {
            count += ast_node_count(field_x, list_count);
            if let Some(child) = field_type {
                count += ast_node_count(child, list_count);
            }
            return count;
        },
        ast::Fields::SelectorExpr { x: field_x, sel: field_sel } => {
            count += ast_node_count(field_x, list_count);
            count += ast_node_count(field_sel, list_count);
            return count;
        },
        ast::Fields::SliceExpr {
            x: field_x,
            lbrack: _,
            low: field_low,
            high: field_high,
            max: field_max,
            slice3: _,
            rbrack: _,
        } => {
            count += ast_node_count(field_x, list_count);
            if let Some(child) = field_low {
                count += ast_node_count(child, list_count);
            }
            if let Some(child) = field_high {
                count += ast_node_count(child, list_count);
            }
            if let Some(child) = field_max {
                count += ast_node_count(child, list_count);
            }
            return count;
        },
        ast::Fields::IndexExpr { x: field_x, lbrack: _, index: field_index, rbrack: _ } => {
            count += ast_node_count(field_x, list_count);
            count += ast_node_count(field_index, list_count);
            return count;
        },
        ast::Fields::IndexListExpr { x: field_x, lbrack: _, indices: field_indices, rbrack: _ } => {
            count += ast_node_count(field_x, list_count);
            count += ast_list_node_count(field_indices, list_count);
            return count;
        },
        ast::Fields::CallExpr {
            fun: field_fun,
            lparen: _,
            args: field_args,
            ellipsis: _,
            rparen: _,
        } => {
            count += ast_node_count(field_fun, list_count);
            if let Some(children) = field_args {
                count += ast_list_node_count(children, list_count);
            }
            return count;
        },
        ast::Fields::KeyValueExpr { key: field_key, colon: _, value: field_value } => {
            count += ast_node_count(field_key, list_count);
            count += ast_node_count(field_value, list_count);
            return count;
        },
        ast::Fields::CompositeLit {
            type_node: field_type,
            lbrace: _,
            elts: field_elts,
            rbrace: _,
            incomplete: _,
        } => {
            if let Some(child) = field_type {
                count += ast_node_count(child, list_count);
            }
            if let Some(children) = field_elts {
                count += ast_list_node_count(children, list_count);
            }
            return count;
        },
        ast::Fields::StarExpr { star: _, x: field_x } => {
            count += ast_node_count(field_x, list_count);
            return count;
        },
        ast::Fields::UnaryExpr { op_pos: _, op: _, x: field_x } => {
            count += ast_node_count(field_x, list_count);
            return count;
        },
        ast::Fields::BinaryExpr { x: field_x, op_pos: _, op: _, y: field_y } => {
            count += ast_node_count(field_x, list_count);
            count += ast_node_count(field_y, list_count);
            return count;
        },
        ast::Fields::ImportSpec { name: field_name, path: field_path_node, end_pos: _ } => {
            if let Some(child) = field_name {
                count += ast_node_count(child, list_count);
            }
            count += ast_node_count(field_path_node, list_count);
            return count;
        },
        ast::Fields::ValueSpec { names: field_names, type_node: field_type, values: field_values } => {
            count += ast_list_node_count(field_names, list_count);
            if let Some(child) = field_type {
                count += ast_node_count(child, list_count);
            }
            if let Some(children) = field_values {
                count += ast_list_node_count(children, list_count);
            }
            return count;
        },
        ast::Fields::TypeSpec {
            name: field_name,
            type_params: field_type_params,
            assign: _,
            type_node: field_type,
        } => {
            count += ast_node_count(field_name, list_count);
            if let Some(child) = field_type_params {
                count += ast_node_count(child, list_count);
            }
            count += ast_node_count(field_type, list_count);
            return count;
        },
        ast::Fields::GenDecl { token_pos: _, token: _, lparen: _, specs: field_specs, rparen: _ } => {
            if let Some(children) = field_specs {
                count += ast_list_node_count(children, list_count);
            }
            return count;
        },
        ast::Fields::FuncDecl {
            recv: field_recv,
            name: field_name,
            type_node: field_type,
            body: field_body,
        } => {
            if let Some(child) = field_recv {
                count += ast_node_count(child, list_count);
            }
            count += ast_node_count(field_name, list_count);
            count += ast_node_count(field_type, list_count);
            if let Some(child) = field_body {
                count += ast_node_count(child, list_count);
            }
            return count;
        },
        ast::Fields::File {
            package_pos: _,
            name: field_name,
            decls: field_decls,
            file_start: _,
            file_end: _,
            imports: field_imports,
            comments: field_comments,
            go_version: _,
        } => {
            count += ast_node_count(field_name, list_count);
            if let Some(children) = field_decls {
                count += ast_list_node_count(children, list_count);
            }
            if let Some(children) = field_imports {
                count += ast_list_node_count(children, list_count);
            }
            if let Some(children) = field_comments {
                count += ast_list_node_count(children, list_count);
            }
            return count;
        },
        ast::Fields::BadExpr { from: _, to: _ } => {
            return count;
        },
        ast::Fields::BadStmt { from: _, to: _ } => {
            return count;
        },
        ast::Fields::BadDecl { from: _, to: _ } => {
            return count;
        },
        ast::Fields::Field { names: field_names, type_node: field_type, tag: field_tag } => {
            if let Some(children) = field_names {
                count += ast_list_node_count(children, list_count);
            }
            if let Some(child) = field_type {
                count += ast_node_count(child, list_count);
            }
            if let Some(child) = field_tag {
                count += ast_node_count(child, list_count);
            }
            return count;
        },
        ast::Fields::FieldList { opening: _, list: field_list, closing: _ } => {
            if let Some(children) = field_list {
                count += ast_list_node_count(children, list_count);
            }
            return count;
        },
        ast::Fields::ExprStmt { x: field_x } => {
            count += ast_node_count(field_x, list_count);
            return count;
        },
        ast::Fields::BlockStmt { lbrace: _, list: field_list, rbrace: _ } => {
            if let Some(children) = field_list {
                count += ast_list_node_count(children, list_count);
            }
            return count;
        },
        ast::Fields::SendStmt { channel: field_chan, arrow: _, value: field_value } => {
            count += ast_node_count(field_chan, list_count);
            count += ast_node_count(field_value, list_count);
            return count;
        },
        ast::Fields::IncDecStmt { x: field_x, token_pos: _, token: _ } => {
            count += ast_node_count(field_x, list_count);
            return count;
        },
        ast::Fields::RangeStmt {
            for_pos: _,
            key: field_key,
            value: field_value,
            token_pos: _,
            token: _,
            range_pos: _,
            x: field_x,
            body: field_body,
        } => {
            if let Some(child) = field_key {
                count += ast_node_count(child, list_count);
            }
            if let Some(child) = field_value {
                count += ast_node_count(child, list_count);
            }
            if let Some(child) = field_x {
                count += ast_node_count(child, list_count);
            }
            if let Some(child) = field_body {
                count += ast_node_count(child, list_count);
            }
            return count;
        },
        ast::Fields::AssignStmt { lhs: field_lhs, token_pos: _, token: _, rhs: field_rhs } => {
            count += ast_list_node_count(field_lhs, list_count);
            count += ast_list_node_count(field_rhs, list_count);
            return count;
        },
        ast::Fields::EmptyStmt { semicolon: _, implicit: _ } => {
            return count;
        },
        ast::Fields::ReturnStmt { return_pos: _, results: field_results } => {
            if let Some(children) = field_results {
                count += ast_list_node_count(children, list_count);
            }
            return count;
        },
        ast::Fields::BranchStmt { token_pos: _, token: _, label: field_label } => {
            if let Some(child) = field_label {
                count += ast_node_count(child, list_count);
            }
            return count;
        },
        ast::Fields::IfStmt {
            if_pos: _,
            init: field_init,
            cond: field_cond,
            body: field_body,
            else_node: field_else,
        } => {
            if let Some(child) = field_init {
                count += ast_node_count(child, list_count);
            }
            count += ast_node_count(field_cond, list_count);
            count += ast_node_count(field_body, list_count);
            if let Some(child) = field_else {
                count += ast_node_count(child, list_count);
            }
            return count;
        },
        ast::Fields::CaseClause { case_pos: _, list: field_list, colon: _, body: field_body } => {
            if let Some(children) = field_list {
                count += ast_list_node_count(children, list_count);
            }
            if let Some(children) = field_body {
                count += ast_list_node_count(children, list_count);
            }
            return count;
        },
        ast::Fields::CommClause { case_pos: _, comm: field_comm, colon: _, body: field_body } => {
            if let Some(child) = field_comm {
                count += ast_node_count(child, list_count);
            }
            if let Some(children) = field_body {
                count += ast_list_node_count(children, list_count);
            }
            return count;
        },
        ast::Fields::SelectStmt { select_pos: _, body: field_body } => {
            count += ast_node_count(field_body, list_count);
            return count;
        },
        ast::Fields::ForStmt {
            for_pos: _,
            init: field_init,
            cond: field_cond,
            post: field_post,
            body: field_body,
        } => {
            if let Some(child) = field_init {
                count += ast_node_count(child, list_count);
            }
            if let Some(child) = field_cond {
                count += ast_node_count(child, list_count);
            }
            if let Some(child) = field_post {
                count += ast_node_count(child, list_count);
            }
            count += ast_node_count(field_body, list_count);
            return count;
        },
        ast::Fields::LabeledStmt { label: field_label, colon: _, stmt: field_stmt } => {
            count += ast_node_count(field_label, list_count);
            count += ast_node_count(field_stmt, list_count);
            return count;
        },
        ast::Fields::DeclStmt { decl: field_decl } => {
            count += ast_node_count(field_decl, list_count);
            return count;
        },
        ast::Fields::Ellipsis { ellipsis: _, elt: field_elt } => {
            if let Some(child) = field_elt {
                count += ast_node_count(child, list_count);
            }
            return count;
        },
        ast::Fields::ArrayType { lbrack: _, len: field_len, elt: field_elt } => {
            if let Some(child) = field_len {
                count += ast_node_count(child, list_count);
            }
            count += ast_node_count(field_elt, list_count);
            return count;
        },
        ast::Fields::FuncType {
            func_pos: _,
            type_params: field_type_params,
            params: field_params,
            results: field_results,
        } => {
            if let Some(child) = field_type_params {
                count += ast_node_count(child, list_count);
            }
            count += ast_node_count(field_params, list_count);
            if let Some(child) = field_results {
                count += ast_node_count(child, list_count);
            }
            return count;
        },
        ast::Fields::StructType { struct_pos: _, fields: field_fields, incomplete: _ } => {
            count += ast_node_count(field_fields, list_count);
            return count;
        },
        ast::Fields::InterfaceType { interface_pos: _, methods: field_methods, incomplete: _ } => {
            count += ast_node_count(field_methods, list_count);
            return count;
        },
        ast::Fields::MapType { map_pos: _, key: field_key, value: field_value } => {
            count += ast_node_count(field_key, list_count);
            count += ast_node_count(field_value, list_count);
            return count;
        },
        ast::Fields::ChanType { begin: _, arrow: _, dir: _, value: field_value } => {
            count += ast_node_count(field_value, list_count);
            return count;
        },
        _ => {},
    }
    let ast::Fields::Named(fields) = value.fields else {
        return count;
    };
    for entry in fields {
        match entry.1 {
            ast::Value::Node(child) => {
                count += ast_node_count(child, list_count);
            },
            ast::Value::Nodes(children) => {
                count += ast_list_node_count(children, list_count);
            },
            _ => {},
        }
    }
    count
}

fn lower_package_inner(sources: Vec[SourceFile], retain_paths: bool) -> PackageSyntax {
    let mut node_count = 0;
    let list_count = Ref::new(0);
    for source in sources {
        node_count += ast_node_count(source.root, list_count);
    }
    let nodes: Vec[Option[SyntaxNode]] = Vec::with_capacity(node_count);
    let paths: Vec[PathEntry] = Vec::with_capacity(
        if retain_paths {
            node_count + list_count.get()
        } else {
            0
        },
    );
    let diagnostics: Vec[LowerDiagnostic] = Vec::new();
    let files: Vec[SyntaxFile] = Vec::with_capacity(sources.len());
    let names: Vec[string] = Vec::new();
    for index in 0..sources.len() {
        let source = sources[index];
        if contains_name(names, source.name) {
            diagnostics.push(
                LowerDiagnostic {
                    file: source.name,
                    start: source.root.span.start,
                    end: source.root.span.end,
                    message: "duplicate source file name " + source.name,
                },
            )
        } else {
            names.push(source.name)
        }
        let context = LowerContext {
            file_id: file_id(index),
            file_name: source.name,
            nodes,
            imports: Vec::new(),
            diagnostics,
        };
        let root = lower_node(
            context,
            source.root,
            if retain_paths {
                root_path(paths)
            } else {
                empty_path()
            },
        );
        files.push(SyntaxFile { id: file_id(index), name: source.name, root })
    }
    PackageSyntax { arena: SyntaxArena { nodes }, files, diagnostics }
}

pub fn lower_package(sources: Vec[SourceFile]) -> PackageSyntax {
    lower_package_inner(sources, true)
}

pub fn lower_package_without_paths(sources: Vec[SourceFile]) -> PackageSyntax {
    lower_package_inner(sources, false)
}

pub fn lower_file(name: string, root: ast::Node) -> PackageSyntax {
    lower_package(Vec::from_array([SourceFile { name, root }]))
}

fn required_ast_child(
    context: LowerContext,
    value: ast::Node,
    name: string,
    child: Option[ast::Node],
    path: SyntaxPath,
) -> NodeId {
    match child {
        Some(child) => lower_node(context, child, path),
        None => invalid_child(context, value, path, "expected node field " + name),
    }
}

fn optional_ast_child(
    context: LowerContext,
    child: Option[ast::Node],
    path: SyntaxPath,
    name: string,
) -> Option[NodeId] {
    match child {
        Some(child) => Option::Some(lower_node(context, child, field_path(path, name))),
        None => Option::None,
    }
}

fn ast_children(context: LowerContext, children: Vec[ast::Node], path: SyntaxPath, name: string) -> Vec[
    NodeId,
] {
    let result: Vec[NodeId] = Vec::with_capacity(children.len());
    if !children.is_empty() {
        let path = field_path(path, name);
        for index in 0..children.len() {
            result.push(lower_node(context, children[index], index_path(path, index)))
        }
    }
    result
}

fn optional_ast_children(
    context: LowerContext,
    children: Option[Vec[ast::Node]],
    path: SyntaxPath,
    name: string,
) -> Vec[NodeId] {
    match children {
        Some(children) => ast_children(context, children, path, name),
        None => Vec::new(),
    }
}
