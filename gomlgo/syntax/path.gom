package syntax;

use std::text;

pub enum SyntaxPath {
    Empty,
    Root,
    Text(string),
    Field {
        parent: SyntaxPath,
        name: string,
    },
    Index {
        parent: SyntaxPath,
        index: isize,
    },
}

fn write_path(value: SyntaxPath, output: text::StringBuilder) -> () {
    match value {
        Empty => {},
        Root => output.write_string("$"),
        Text(value) => output.write_string(value),
        Field { parent, name } => {
            write_path(parent, output);
            output.write_string(".fields.");
            output.write_string(name)
        },
        Index { parent, index } => {
            write_path(parent, output);
            output.write_string("[");
            output.write_string(index.to_string());
            output.write_string("]")
        },
    }
}

impl ToString for SyntaxPath {
    fn to_string(self: SyntaxPath) -> string {
        let output = text::StringBuilder::new();
        write_path(self, output);
        output.finish()
    }
}
