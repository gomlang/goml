package syntax;

use std::text;

enum PathSegment {
    Text,
    Field,
    Index,
}

struct PathEntry {
    parent: isize,
    segment: PathSegment,
    text: string,
    offset: isize,
}

pub struct SyntaxPath {
    entries: Option[Vec[PathEntry]],
    index: isize,
}

pub fn empty_path() -> SyntaxPath {
    SyntaxPath { entries: Option::None, index: -1 }
}

fn root_path(entries: Vec[PathEntry]) -> SyntaxPath {
    let index = entries.len();
    entries.push(PathEntry { parent: -1, segment: PathSegment::Text, text: "$", offset: 0 });
    SyntaxPath { entries: Option::Some(entries), index }
}

pub fn text_path(value: string) -> SyntaxPath {
    let entries = Vec::from_array(
        [PathEntry { parent: -1, segment: PathSegment::Text, text: value, offset: 0 }],
    );
    SyntaxPath { entries: Option::Some(entries), index: 0 }
}

fn append_path(path: SyntaxPath, segment: PathSegment, text: string, offset: isize) -> SyntaxPath {
    match path.entries {
        Some(entries) => {
            let index = entries.len();
            entries.push(PathEntry { parent: path.index, segment, text, offset });
            SyntaxPath { entries: Option::Some(entries), index }
        },
        None => path,
    }
}

fn index_path(path: SyntaxPath, index: isize) -> SyntaxPath {
    append_path(path, PathSegment::Index, "", index)
}

fn write_path(entries: Vec[PathEntry], index: isize, output: text::StringBuilder) -> () {
    let entry = entries[index];
    if entry.parent >= 0 {
        write_path(entries, entry.parent, output);
    }
    match entry.segment {
        Text => output.write_string(entry.text),
        Field => {
            output.write_string(".fields.");
            output.write_string(entry.text)
        },
        Index => {
            output.write_string("[");
            output.write_string(entry.offset.to_string());
            output.write_string("]")
        },
    }
}

impl ToString for SyntaxPath {
    fn to_string(self: SyntaxPath) -> string {
        let output = text::StringBuilder::new();
        if let Some(entries) = self.entries {
            write_path(entries, self.index, output);
        }
        output.finish()
    }
}
