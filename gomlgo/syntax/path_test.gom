package syntax;

use std::testing;

#[test]
fn paths_preserve_prefixes_across_arena_growth() -> () {
    let entries: Vec[PathEntry] = Vec::with_capacity(1);
    let root = root_path(entries);
    let first = index_path(field_path(root, "decls"), 0);
    let mut branch = first;
    for index in 0..100 {
        branch = index_path(field_path(branch, "子"), index);
    }
    testing::assert_eq(root.to_string(), "$");
    testing::assert_eq(first.to_string(), "$.fields.decls[0]");
    testing::assert(branch.to_string().ends_with(".fields.子[99]"));
    testing::assert_eq(index_path(field_path(root, ""), -1).to_string(), "$.fields.[-1]");
    testing::assert_eq(field_path(text_path("custom"), "x").to_string(), "custom.fields.x");
    testing::assert_eq(index_path(field_path(empty_path(), "x"), 4).to_string(), "");
    testing::assert_eq(field_path(text_path(""), "x").to_string(), ".fields.x");
    let second = root_path(entries);
    testing::assert_eq(field_path(second, "x").to_string(), "$.fields.x");
    testing::assert_eq(first.to_string(), "$.fields.decls[0]");
}
