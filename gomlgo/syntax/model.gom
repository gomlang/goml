package syntax;

use gomlgo::ast;

pub struct NodeList {
    pub values: Vec[NodeId],
}

pub enum SyntaxKind {
    Invalid {
        message: string,
    },
    Comment {
        text: string,
    },
    CommentGroup {
        list: Vec[NodeId],
    },
    Field {
        names: Vec[NodeId],
        type_node: NodeId,
        tag: Option[NodeId],
    },
    FieldList {
        opening: isize,
        list: Vec[NodeId],
        closing: isize,
    },
    BadExpr {
        from: isize,
        to: isize,
    },
    Ident {
        name_pos: isize,
        name: string,
    },
    Ellipsis {
        ellipsis: isize,
        element: Option[NodeId],
    },
    BasicLit {
        value_pos: isize,
        value_end: isize,
        token: string,
        value: string,
    },
    FuncLit {
        type_node: NodeId,
        body: NodeId,
    },
    CompositeLit {
        type_node: Option[NodeId],
        lbrace: isize,
        elements: Vec[NodeId],
        rbrace: isize,
        incomplete: bool,
    },
    ParenExpr {
        lparen: isize,
        expression: NodeId,
        rparen: isize,
    },
    SelectorExpr {
        expression: NodeId,
        selector: NodeId,
    },
    IndexExpr {
        expression: NodeId,
        lbrack: isize,
        index: NodeId,
        rbrack: isize,
    },
    IndexListExpr {
        expression: NodeId,
        lbrack: isize,
        indices: Vec[NodeId],
        rbrack: isize,
    },
    SliceExpr {
        expression: NodeId,
        lbrack: isize,
        low: Option[NodeId],
        high: Option[NodeId],
        max: Option[NodeId],
        slice3: bool,
        rbrack: isize,
    },
    TypeAssertExpr {
        expression: NodeId,
        lparen: isize,
        type_node: Option[NodeId],
        rparen: isize,
    },
    CallExpr {
        function: NodeId,
        lparen: isize,
        arguments: Vec[NodeId],
        ellipsis: isize,
        rparen: isize,
    },
    StarExpr {
        star: isize,
        expression: NodeId,
    },
    UnaryExpr {
        op_pos: isize,
        op: string,
        expression: NodeId,
    },
    BinaryExpr {
        left: NodeId,
        op_pos: isize,
        op: string,
        right: NodeId,
    },
    KeyValueExpr {
        key: NodeId,
        colon: isize,
        value: NodeId,
    },
    ArrayType {
        lbrack: isize,
        length: Option[NodeId],
        element: NodeId,
    },
    StructType {
        struct_pos: isize,
        fields: NodeId,
        incomplete: bool,
    },
    FuncType {
        func_pos: isize,
        type_params: Option[NodeId],
        params: NodeId,
        results: Option[NodeId],
    },
    InterfaceType {
        interface_pos: isize,
        methods: NodeId,
        incomplete: bool,
    },
    MapType {
        map_pos: isize,
        key: NodeId,
        value: NodeId,
    },
    ChanType {
        begin: isize,
        arrow: isize,
        direction: isize,
        value: NodeId,
    },
    BadStmt {
        from: isize,
        to: isize,
    },
    DeclStmt {
        declaration: NodeId,
    },
    EmptyStmt {
        semicolon: isize,
        implicit: bool,
    },
    LabeledStmt {
        label: NodeId,
        colon: isize,
        statement: NodeId,
    },
    ExprStmt {
        expression: NodeId,
    },
    SendStmt {
        channel: NodeId,
        arrow: isize,
        value: NodeId,
    },
    IncDecStmt {
        expression: NodeId,
        token_pos: isize,
        token: string,
    },
    AssignStmt {
        left: Vec[NodeId],
        token_pos: isize,
        token: string,
        right: Vec[NodeId],
    },
    GoStmt {
        go_pos: isize,
        call: NodeId,
    },
    DeferStmt {
        defer_pos: isize,
        call: NodeId,
    },
    ReturnStmt {
        return_pos: isize,
        results: Vec[NodeId],
    },
    BranchStmt {
        token_pos: isize,
        token: string,
        label: Option[NodeId],
    },
    BlockStmt {
        lbrace: isize,
        list: Vec[NodeId],
        rbrace: isize,
    },
    IfStmt {
        if_pos: isize,
        init: Option[NodeId],
        condition: NodeId,
        body: NodeId,
        else_branch: Option[NodeId],
    },
    CaseClause {
        case_pos: isize,
        list: Vec[NodeId],
        colon: isize,
        body: Vec[NodeId],
    },
    SwitchStmt {
        switch_pos: isize,
        init: Option[NodeId],
        tag: Option[NodeId],
        body: NodeId,
    },
    TypeSwitchStmt {
        switch_pos: isize,
        init: Option[NodeId],
        assignment: NodeId,
        body: NodeId,
    },
    CommClause {
        case_pos: isize,
        communication: Option[NodeId],
        colon: isize,
        body: Vec[NodeId],
    },
    SelectStmt {
        select_pos: isize,
        body: NodeId,
    },
    ForStmt {
        for_pos: isize,
        init: Option[NodeId],
        condition: Option[NodeId],
        post: Option[NodeId],
        body: NodeId,
    },
    RangeStmt {
        for_pos: isize,
        key: Option[NodeId],
        value: Option[NodeId],
        token_pos: isize,
        token: string,
        range_pos: isize,
        expression: NodeId,
        body: NodeId,
    },
    ImportSpec {
        name: Option[NodeId],
        path: NodeId,
        end_pos: isize,
    },
    ValueSpec {
        names: Vec[NodeId],
        type_node: Option[NodeId],
        values: Vec[NodeId],
    },
    TypeSpec {
        name: NodeId,
        type_params: Option[NodeId],
        assign: isize,
        type_node: NodeId,
    },
    BadDecl {
        from: isize,
        to: isize,
    },
    GenDecl {
        token_pos: isize,
        token: string,
        lparen: isize,
        specs: Vec[NodeId],
        rparen: isize,
    },
    FuncDecl {
        receiver: Option[NodeId],
        name: NodeId,
        type_node: NodeId,
        body: Option[NodeId],
    },
    File {
        package_pos: isize,
        name: NodeId,
        declarations: Vec[NodeId],
        imports: Vec[NodeId],
        go_version: string,
    },
}

pub struct SyntaxNode {
    pub id: NodeId,
    pub file: FileId,
    pub span: ast::Span,
    pub path: SyntaxPath,
    pub kind: SyntaxKind,
}

pub struct SyntaxFile {
    pub id: FileId,
    pub name: string,
    pub root: NodeId,
}

pub struct SyntaxArena {
    pub nodes: Vec[Option[SyntaxNode]],
}

pub struct LowerDiagnostic {
    pub file: string,
    pub start: isize,
    pub end: isize,
    pub message: string,
}

pub struct PackageSyntax {
    pub arena: SyntaxArena,
    pub files: Vec[SyntaxFile],
    pub diagnostics: Vec[LowerDiagnostic],
}

pub struct SourceFile {
    pub name: string,
    pub root: ast::Node,
}

pub fn syntax_kind_name(value: SyntaxKind) -> string {
    match value {
        Invalid { message: _ } => "Invalid",
        Comment { text: _ } => "Comment",
        CommentGroup { list: _ } => "CommentGroup",
        Field { names: _, type_node: _, tag: _ } => "Field",
        FieldList { opening: _, list: _, closing: _ } => "FieldList",
        BadExpr { from: _, to: _ } => "BadExpr",
        Ident { name_pos: _, name: _ } => "Ident",
        Ellipsis { ellipsis: _, element: _ } => "Ellipsis",
        BasicLit { value_pos: _, value_end: _, token: _, value: _ } => "BasicLit",
        FuncLit { type_node: _, body: _ } => "FuncLit",
        CompositeLit { type_node: _, lbrace: _, elements: _, rbrace: _, incomplete: _ } => {
            "CompositeLit"
        },
        ParenExpr { lparen: _, expression: _, rparen: _ } => "ParenExpr",
        SelectorExpr { expression: _, selector: _ } => "SelectorExpr",
        IndexExpr { expression: _, lbrack: _, index: _, rbrack: _ } => "IndexExpr",
        IndexListExpr { expression: _, lbrack: _, indices: _, rbrack: _ } => "IndexListExpr",
        SliceExpr { expression: _, lbrack: _, low: _, high: _, max: _, slice3: _, rbrack: _ } => {
            "SliceExpr"
        },
        TypeAssertExpr { expression: _, lparen: _, type_node: _, rparen: _ } => "TypeAssertExpr",
        CallExpr { function: _, lparen: _, arguments: _, ellipsis: _, rparen: _ } => "CallExpr",
        StarExpr { star: _, expression: _ } => "StarExpr",
        UnaryExpr { op_pos: _, op: _, expression: _ } => "UnaryExpr",
        BinaryExpr { left: _, op_pos: _, op: _, right: _ } => "BinaryExpr",
        KeyValueExpr { key: _, colon: _, value: _ } => "KeyValueExpr",
        ArrayType { lbrack: _, length: _, element: _ } => "ArrayType",
        StructType { struct_pos: _, fields: _, incomplete: _ } => "StructType",
        FuncType { func_pos: _, type_params: _, params: _, results: _ } => "FuncType",
        InterfaceType { interface_pos: _, methods: _, incomplete: _ } => "InterfaceType",
        MapType { map_pos: _, key: _, value: _ } => "MapType",
        ChanType { begin: _, arrow: _, direction: _, value: _ } => "ChanType",
        BadStmt { from: _, to: _ } => "BadStmt",
        DeclStmt { declaration: _ } => "DeclStmt",
        EmptyStmt { semicolon: _, implicit: _ } => "EmptyStmt",
        LabeledStmt { label: _, colon: _, statement: _ } => "LabeledStmt",
        ExprStmt { expression: _ } => "ExprStmt",
        SendStmt { channel: _, arrow: _, value: _ } => "SendStmt",
        IncDecStmt { expression: _, token_pos: _, token: _ } => "IncDecStmt",
        AssignStmt { left: _, token_pos: _, token: _, right: _ } => "AssignStmt",
        GoStmt { go_pos: _, call: _ } => "GoStmt",
        DeferStmt { defer_pos: _, call: _ } => "DeferStmt",
        ReturnStmt { return_pos: _, results: _ } => "ReturnStmt",
        BranchStmt { token_pos: _, token: _, label: _ } => "BranchStmt",
        BlockStmt { lbrace: _, list: _, rbrace: _ } => "BlockStmt",
        IfStmt { if_pos: _, init: _, condition: _, body: _, else_branch: _ } => "IfStmt",
        CaseClause { case_pos: _, list: _, colon: _, body: _ } => "CaseClause",
        SwitchStmt { switch_pos: _, init: _, tag: _, body: _ } => "SwitchStmt",
        TypeSwitchStmt { switch_pos: _, init: _, assignment: _, body: _ } => "TypeSwitchStmt",
        CommClause { case_pos: _, communication: _, colon: _, body: _ } => "CommClause",
        SelectStmt { select_pos: _, body: _ } => "SelectStmt",
        ForStmt { for_pos: _, init: _, condition: _, post: _, body: _ } => "ForStmt",
        RangeStmt {
            for_pos: _,
            key: _,
            value: _,
            token_pos: _,
            token: _,
            range_pos: _,
            expression: _,
            body: _,
        } => "RangeStmt",
        ImportSpec { name: _, path: _, end_pos: _ } => "ImportSpec",
        ValueSpec { names: _, type_node: _, values: _ } => "ValueSpec",
        TypeSpec { name: _, type_params: _, assign: _, type_node: _ } => "TypeSpec",
        BadDecl { from: _, to: _ } => "BadDecl",
        GenDecl { token_pos: _, token: _, lparen: _, specs: _, rparen: _ } => "GenDecl",
        FuncDecl { receiver: _, name: _, type_node: _, body: _ } => "FuncDecl",
        File { package_pos: _, name: _, declarations: _, imports: _, go_version: _ } => "File",
    }
}

pub fn get_node(value: SyntaxArena, id: NodeId) -> Option[SyntaxNode] {
    if id.value >= 0 && id.value < value.nodes.len() {
        value.nodes[id.value]
    } else {
        Option::None
    }
}

pub fn node_at(value: SyntaxArena, index: isize) -> SyntaxNode {
    match get_node(value, node_id(index)) {
        Some(node) => node,
        None => SyntaxNode {
            id: node_id(index),
            file: file_id(-1),
            span: ast::Span { start: -1, end: -1 },
            path: empty_path(),
            kind: SyntaxKind::Invalid { message: "" },
        },
    }
}

pub fn node_key(value: PackageSyntax, id: NodeId) -> Option[string] {
    match get_node(value.arena, id) {
        Some(node) => if node.file.value >= 0 && node.file.value < value.files.len() {
            Option::Some(value.files[node.file.value].name + ":" + node.path.to_string())
        } else {
            Option::None
        },
        None => Option::None,
    }
}
