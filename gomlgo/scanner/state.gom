package scanner;

use gomlgo::diagnostic;
use std::bytes;
use std::text;
use std::unicode;

const EOF: i32 = -1;

const BOM: i32 = 65279;

const RUNE_ERROR: i32 = 65533;

#[go_ffi("unicode", "IsDigit")]
extern fn go_is_digit(value: char) -> bool;

pub struct ScanResult {
    pub tokens: Vec[gomlgo::token::Token],
    pub diagnostics: Vec[diagnostic::Diagnostic],
}

pub struct Scanner {
    source: Vec[byte],
    source_string: Option[string],
    current: Ref[i32],
    offset: Ref[isize],
    read_offset: Ref[isize],
    insert_semi: Ref[bool],
    pending_newline: Ref[isize],
    diagnostics: Vec[diagnostic::Diagnostic],
}

fn decode_rune(source: Vec[byte], index: isize) -> (i32, isize, bool) {
    let first = source[index];
    if first < 128 {
        (first.to_i32(), 1, true)
    } else if first >= 194 && first <= 223 && index + 1 < source.len() {
        let second = source[index + 1];
        if second >= 128 && second <= 191 {
            ((((first & 31).to_i32()) << 6) | (second & 63).to_i32(), 2, true)
        } else {
            (RUNE_ERROR, 1, false)
        }
    } else if first >= 224 && first <= 239 && index + 2 < source.len() {
        let second = source[index + 1];
        let third = source[index + 2];
        let second_valid = if first == 224 {
            second >= 160 && second <= 191
        } else if first == 237 {
            second >= 128 && second <= 159
        } else {
            second >= 128 && second <= 191
        };
        if second_valid && third >= 128 && third <= 191 {
            (
                (((first & 15).to_i32()) << 12) | (((second & 63).to_i32()) << 6)
                    | (third & 63).to_i32(),
                3,
                true,
            )
        } else {
            (RUNE_ERROR, 1, false)
        }
    } else if first >= 240 && first <= 244 && index + 3 < source.len() {
        let second = source[index + 1];
        let third = source[index + 2];
        let fourth = source[index + 3];
        let second_valid = if first == 240 {
            second >= 144 && second <= 191
        } else if first == 244 {
            second >= 128 && second <= 143
        } else {
            second >= 128 && second <= 191
        };
        if second_valid && third >= 128 && third <= 191 && fourth >= 128 && fourth <= 191 {
            (
                (((first & 7).to_i32()) << 18) | (((second & 63).to_i32()) << 12)
                    | (((third & 63).to_i32()) << 6)
                    | (fourth & 63).to_i32(),
                4,
                true,
            )
        } else {
            (RUNE_ERROR, 1, false)
        }
    } else {
        (RUNE_ERROR, 1, false)
    }
}

fn codepoint_char(value: i32) -> Option[char] {
    if value < 0 {
        Option::None
    } else {
        char_from_u32(value.to_u32())
    }
}

fn codepoint_text(value: i32) -> string {
    match codepoint_char(value) {
        Some(character) => character.to_string(),
        None => "",
    }
}

fn source_text(source: Vec[byte], start: isize, end: isize) -> string {
    let values: Vec[byte] = Vec::with_capacity(end - start);
    for index in start..end {
        values.push(source[index])
    }
    let (valid, result) = string_from_utf8(values);
    if valid {
        result
    } else {
        let builder = text::StringBuilder::new();
        let mut index = start;
        while index < end {
            let (value, width, _) = decode_rune(source, index);
            builder.write_string(codepoint_text(value));
            index += width;
        }
        builder.finish()
    }
}

fn report(scanner: Scanner, offset: isize, message: string) -> () {
    scanner.diagnostics.push(diagnostic::make(message, offset))
}

fn next(scanner: Scanner) -> () {
    if scanner.read_offset.get() < scanner.source.len() {
        let offset = scanner.read_offset.get();
        scanner.offset.set(offset);
        let (value, width, valid) = decode_rune(scanner.source, offset);
        if value == 0 {
            report(scanner, offset, "illegal character NUL")
        } else if !valid {
            let remaining = scanner.source.len() - offset;
            if offset == 0 && remaining >= 2
                && ((scanner.source[offset] == 255 && scanner.source[offset + 1] == 254)
                    || (scanner.source[offset] == 254 && scanner.source[offset + 1] == 255)) {
                report(scanner, offset, "illegal UTF-8 encoding (got UTF-16)");
                scanner.read_offset.set(scanner.source.len())
            } else {
                report(scanner, offset, "illegal UTF-8 encoding")
            }
        } else if value == BOM && offset > 0 {
            report(scanner, offset, "illegal byte order mark")
        }
        scanner.read_offset.set(scanner.read_offset.get() + width);
        scanner.current.set(value)
    } else {
        scanner.offset.set(scanner.source.len());
        scanner.current.set(EOF)
    }
}

fn peek_byte(scanner: Scanner) -> byte {
    if scanner.read_offset.get() < scanner.source.len() {
        scanner.source[scanner.read_offset.get()]
    } else {
        0
    }
}

fn scanner_text(scanner: Scanner, start: isize, end: isize) -> string {
    match scanner.source_string {
        Some(source) => source.byte_slice(start, end),
        None => source_text(scanner.source, start, end),
    }
}

fn scanner_new(source: Vec[byte]) -> Scanner {
    let (valid, source_string) = string_from_utf8(source);
    let scanner = Scanner {
        source,
        source_string: if valid {
            Option::Some(source_string)
        } else {
            Option::None
        },
        current: Ref::new(b' '.to_i32()),
        offset: Ref::new(0),
        read_offset: Ref::new(0),
        insert_semi: Ref::new(false),
        pending_newline: Ref::new(-1),
        diagnostics: Vec::new(),
    };
    next(scanner);
    if scanner.current.get() == BOM {
        next(scanner)
    }
    scanner
}

fn ascii_lower(value: i32) -> i32 {
    if value >= b'A'.to_i32() && value <= b'Z'.to_i32() {
        value + 32
    } else {
        value
    }
}

fn is_decimal(value: i32) -> bool {
    value >= b'0'.to_i32() && value <= b'9'.to_i32()
}

fn is_hex(value: i32) -> bool {
    is_decimal(value)
        || (ascii_lower(value) >= b'a'.to_i32() && ascii_lower(value) <= b'f'.to_i32())
}

fn is_letter(value: i32) -> bool {
    (ascii_lower(value) >= b'a'.to_i32() && ascii_lower(value) <= b'z'.to_i32())
        || value == b'_'.to_i32()
        || if value >= 128 {
            match codepoint_char(value) {
                Some(character) => unicode::is_letter(character),
                None => false,
            }
        } else {
            false
        }
}

fn is_digit(value: i32) -> bool {
    is_decimal(value)
        || if value >= 128 {
            match codepoint_char(value) {
                Some(character) => go_is_digit(character),
                None => false,
            }
        } else {
            false
        }
}

fn scan_identifier(scanner: Scanner) -> string {
    let start = scanner.offset.get();
    while is_letter(scanner.current.get()) || is_digit(scanner.current.get()) {
        next(scanner)
    }
    scanner_text(scanner, start, scanner.offset.get())
}

fn skip_whitespace(scanner: Scanner) -> () {
    while scanner.current.get() == b' '.to_i32() || scanner.current.get() == b'\t'.to_i32()
        || (scanner.current.get() == b'\n'.to_i32() && !scanner.insert_semi.get())
        || scanner.current.get() == b'\r'.to_i32() {
        next(scanner)
    }
}

fn switch_two(scanner: Scanner, plain: gomlgo::token::Kind, assigned: gomlgo::token::Kind) -> gomlgo::token::Kind {
    if scanner.current.get() == b'='.to_i32() {
        next(scanner);
        assigned
    } else {
        plain
    }
}

fn switch_three(
    scanner: Scanner,
    plain: gomlgo::token::Kind,
    assigned: gomlgo::token::Kind,
    alternate_character: i32,
    alternate: gomlgo::token::Kind,
) -> gomlgo::token::Kind {
    if scanner.current.get() == b'='.to_i32() {
        next(scanner);
        assigned
    } else if scanner.current.get() == alternate_character {
        next(scanner);
        alternate
    } else {
        plain
    }
}

fn switch_four(
    scanner: Scanner,
    plain: gomlgo::token::Kind,
    assigned: gomlgo::token::Kind,
    alternate_character: i32,
    alternate: gomlgo::token::Kind,
    alternate_assigned: gomlgo::token::Kind,
) -> gomlgo::token::Kind {
    if scanner.current.get() == b'='.to_i32() {
        next(scanner);
        assigned
    } else if scanner.current.get() == alternate_character {
        next(scanner);
        if scanner.current.get() == b'='.to_i32() {
            next(scanner);
            alternate_assigned
        } else {
            alternate
        }
    } else {
        plain
    }
}

pub fn new_cursor(source: bytes::Bytes) -> Scanner {
    scanner_new(source.to_vec())
}

pub fn next_token(cursor: Scanner) -> gomlgo::token::Token {
    scan_one(cursor)
}

pub fn cursor_diagnostics(cursor: Scanner) -> Vec[diagnostic::Diagnostic] {
    cursor.diagnostics
}

pub fn scan_bytes(source: bytes::Bytes) -> ScanResult {
    let capacity = source.len() / 6 + 1;
    let scanner = scanner_new(source.to_vec());
    let tokens: Vec[gomlgo::token::Token] = Vec::with_capacity(capacity);
    let mut finished = false;
    while !finished {
        let next_token = scan_one(scanner);
        finished = gomlgo::token::equal(next_token.kind, gomlgo::token::Kind::Eof);
        if tokens.len() == tokens.capacity() {
            tokens.reserve(tokens.len())
        }
        tokens.push(next_token)
    }
    ScanResult { tokens, diagnostics: scanner.diagnostics }
}

pub fn leading_comments(source: bytes::Bytes) -> Vec[string] {
    let scanner = scanner_new(source.to_vec());
    let result: Vec[string] = Vec::new();
    let mut finished = false;
    while !finished {
        let value = scan_one(scanner);
        if gomlgo::token::equal(value.kind, gomlgo::token::Kind::Comment) {
            result.push(value.literal)
        } else if gomlgo::token::equal(value.kind, gomlgo::token::Kind::Package)
            || gomlgo::token::equal(value.kind, gomlgo::token::Kind::Eof) {
            finished = true;
        }
    }
    result
}

pub fn package_name_bytes(source: bytes::Bytes) -> string {
    let scanner = scanner_new(source.to_vec());
    let mut package_seen = false;
    while true {
        let value = scan_one(scanner);
        if package_seen && gomlgo::token::equal(value.kind, gomlgo::token::Kind::Ident) {
            return value.literal
        } else if gomlgo::token::equal(value.kind, gomlgo::token::Kind::Package) {
            package_seen = true;
        } else if gomlgo::token::equal(value.kind, gomlgo::token::Kind::Eof) {
            return ""
        }
    }
    ""
}

pub fn import_literals(source: bytes::Bytes) -> Vec[string] {
    let scanner = scanner_new(source.to_vec());
    let result: Vec[string] = Vec::new();
    let mut package_seen = false;
    let mut active = false;
    let mut grouped = false;
    let mut finished = false;
    while !finished {
        let value = scan_one(scanner);
        if gomlgo::token::equal(value.kind, gomlgo::token::Kind::Eof) {
            finished = true;
        } else if !package_seen {
            if gomlgo::token::equal(value.kind, gomlgo::token::Kind::Package) {
                package_seen = true;
            }
        } else if gomlgo::token::equal(value.kind, gomlgo::token::Kind::Import) {
            active = true;
        } else if active {
            if gomlgo::token::equal(value.kind, gomlgo::token::Kind::Lparen) {
                grouped = true;
            } else if gomlgo::token::equal(value.kind, gomlgo::token::Kind::String) {
                result.push(value.literal)
            } else if gomlgo::token::equal(value.kind, gomlgo::token::Kind::Rparen) {
                grouped = false;
                active = false;
            } else if gomlgo::token::equal(value.kind, gomlgo::token::Kind::Semicolon) && !grouped {
                active = false;
            }
        } else if gomlgo::token::equal(value.kind, gomlgo::token::Kind::Const)
            || gomlgo::token::equal(value.kind, gomlgo::token::Kind::Type)
            || gomlgo::token::equal(value.kind, gomlgo::token::Kind::Var)
            || gomlgo::token::equal(value.kind, gomlgo::token::Kind::Func) {
            finished = true;
        }
    }
    result
}

pub fn scan(source: string) -> ScanResult {
    scan_bytes(bytes::Bytes::from_string(source))
}
