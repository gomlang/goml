package scanner;

use gomlgo::token;

fn digit_value(value: i32) -> isize {
    if value >= b'0'.to_i32() && value <= b'9'.to_i32() {
        (value - b'0'.to_i32()).to_isize()
    } else if ascii_lower(value) >= b'a'.to_i32() && ascii_lower(value) <= b'f'.to_i32() {
        (ascii_lower(value) - b'a'.to_i32() + 10).to_isize()
    } else {
        16
    }
}

fn scan_digits(scanner: Scanner, base: isize, invalid: Ref[isize]) -> isize {
    let mut result = 0;
    if base <= 10 {
        let maximum = b'0'.to_i32() + base.to_i32();
        while is_decimal(scanner.current.get()) || scanner.current.get() == b'_'.to_i32() {
            if scanner.current.get() == b'_'.to_i32() {
                result |= 2;
            } else {
                result |= 1;
                if scanner.current.get() >= maximum && invalid.get() < 0 {
                    invalid.set(scanner.offset.get())
                }
            }
            next(scanner)
        }
    } else {
        while is_hex(scanner.current.get()) || scanner.current.get() == b'_'.to_i32() {
            if scanner.current.get() == b'_'.to_i32() {
                result |= 2;
            } else {
                result |= 1;
            }
            next(scanner)
        }
    }
    result
}

fn literal_name(prefix: i32) -> string {
    if prefix == b'x'.to_i32() {
        "hexadecimal literal"
    } else if prefix == b'o'.to_i32() || prefix == b'0'.to_i32() {
        "octal literal"
    } else if prefix == b'b'.to_i32() {
        "binary literal"
    } else {
        "decimal literal"
    }
}

fn invalid_separator(literal: string) -> isize {
    let mut prefix = b' ';
    let mut previous = b'.';
    let mut index = 0;
    if literal.byte_len() >= 2 && literal.byte_get(0) == b'0' {
        let next_byte = literal.byte_get(1);
        prefix = if next_byte >= b'A' && next_byte <= b'Z' {
            next_byte + 32
        } else {
            next_byte
        };
        if prefix == b'x' || prefix == b'o' || prefix == b'b' {
            previous = b'0';
            index = 2;
        }
    }
    while index < literal.byte_len() {
        let before = previous;
        let current = literal.byte_get(index);
        if current == b'_' {
            if before != b'0' {
                return index
            }
            previous = current;
        } else if current >= b'0' && current <= b'9'
            || (prefix == b'x'
                && ((current >= b'a' && current <= b'f') || (current >= b'A' && current <= b'F'))) {
            previous = b'0';
        } else {
            if before == b'_' {
                return index - 1
            }
            previous = b'.';
        }
        index += 1;
    }
    if previous == b'_' {
        literal.byte_len() - 1
    } else {
        -1
    }
}

fn scan_number(scanner: Scanner) -> (token::Kind, string) {
    let start = scanner.offset.get();
    let mut kind = token::Kind::Illegal;
    let mut base = 10;
    let mut prefix = 0.to_i32();
    let mut digit_separator = 0;
    let invalid = Ref::new(-1);
    if scanner.current.get() != b'.'.to_i32() {
        kind = token::Kind::Int;
        if scanner.current.get() == b'0'.to_i32() {
            next(scanner);
            let lowered = ascii_lower(scanner.current.get());
            if lowered == b'x'.to_i32() {
                next(scanner);
                base = 16;
                prefix = b'x'.to_i32();
            } else if lowered == b'o'.to_i32() {
                next(scanner);
                base = 8;
                prefix = b'o'.to_i32();
            } else if lowered == b'b'.to_i32() {
                next(scanner);
                base = 2;
                prefix = b'b'.to_i32();
            } else {
                base = 8;
                prefix = b'0'.to_i32();
                digit_separator = 1;
            }
        }
        digit_separator = digit_separator | scan_digits(scanner, base, invalid);
    }
    if scanner.current.get() == b'.'.to_i32() {
        kind = token::Kind::Float;
        if prefix == b'o'.to_i32() || prefix == b'b'.to_i32() {
            report(scanner, scanner.offset.get(), "invalid radix point in " + literal_name(prefix))
        }
        next(scanner);
        digit_separator = digit_separator | scan_digits(scanner, base, invalid);
    }
    if digit_separator & 1 == 0 {
        report(scanner, scanner.offset.get(), literal_name(prefix) + " has no digits")
    }
    let exponent = ascii_lower(scanner.current.get());
    if exponent == b'e'.to_i32() || exponent == b'p'.to_i32() {
        if exponent == b'e'.to_i32() && prefix != 0 && prefix != b'0'.to_i32() {
            report(scanner, scanner.offset.get(), "exponent requires decimal mantissa")
        } else if exponent == b'p'.to_i32() && prefix != b'x'.to_i32() {
            report(scanner, scanner.offset.get(), "exponent requires hexadecimal mantissa")
        }
        next(scanner);
        kind = token::Kind::Float;
        if scanner.current.get() == b'+'.to_i32() || scanner.current.get() == b'-'.to_i32() {
            next(scanner)
        }
        let exponent_invalid = Ref::new(-1);
        let exponent_digits = scan_digits(scanner, 10, exponent_invalid);
        digit_separator |= exponent_digits;
        if exponent_digits & 1 == 0 {
            report(scanner, scanner.offset.get(), "exponent has no digits")
        }
    } else if prefix == b'x'.to_i32() && token::equal(kind, token::Kind::Float) {
        report(scanner, scanner.offset.get(), "hexadecimal mantissa requires a 'p' exponent")
    }
    if scanner.current.get() == b'i'.to_i32() {
        kind = token::Kind::Imag;
        next(scanner)
    }
    let literal = scanner_text(scanner, start, scanner.offset.get());
    if token::equal(kind, token::Kind::Int) && invalid.get() >= 0 {
        report(scanner, invalid.get(), "invalid digit in " + literal_name(prefix))
    }
    if digit_separator & 2 != 0 {
        let invalid_offset = invalid_separator(literal);
        if invalid_offset >= 0 {
            report(scanner, start + invalid_offset, "'_' must separate successive digits")
        }
    };
    (kind, literal)
}
