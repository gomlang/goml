package scanner;

fn escape_simple(value: i32, quote: i32) -> bool {
    value == b'a'.to_i32() || value == b'b'.to_i32() || value == b'f'.to_i32()
        || value == b'n'.to_i32()
        || value == b'r'.to_i32()
        || value == b't'.to_i32()
        || value == b'v'.to_i32()
        || value == b'\\'.to_i32()
        || value == quote
}

fn scan_escape(scanner: Scanner, quote: i32) -> bool {
    let start = scanner.offset.get();
    if escape_simple(scanner.current.get(), quote) {
        next(scanner);
        return true
    }
    let mut digits = 0;
    let mut base = 0;
    let mut maximum = 0.to_u32();
    if scanner.current.get() >= b'0'.to_i32() && scanner.current.get() <= b'7'.to_i32() {
        digits = 3;
        base = 8;
        maximum = 255;
    } else if scanner.current.get() == b'x'.to_i32() {
        next(scanner);
        digits = 2;
        base = 16;
        maximum = 255;
    } else if scanner.current.get() == b'u'.to_i32() {
        next(scanner);
        digits = 4;
        base = 16;
        maximum = 1114111;
    } else if scanner.current.get() == b'U'.to_i32() {
        next(scanner);
        digits = 8;
        base = 16;
        maximum = 1114111;
    } else {
        report(
            scanner,
            start,
            if scanner.current.get() < 0 {
                "escape sequence not terminated"
            } else {
                "unknown escape sequence"
            },
        );
        return false
    }
    let mut value = 0.to_u32();
    while digits > 0 {
        let digit = digit_value(scanner.current.get());
        if digit >= base {
            report(
                scanner,
                scanner.offset.get(),
                if scanner.current.get() < 0 {
                    "escape sequence not terminated"
                } else {
                    "illegal character in escape sequence"
                },
            );
            return false
        }
        value = value * base.to_u32() + digit.to_u32();
        next(scanner);
        digits -= 1;
    }
    if value > maximum || (value >= 55296 && value < 57344) {
        report(scanner, start, "escape sequence is invalid Unicode code point");
        false
    } else {
        true
    }
}

fn scan_rune(scanner: Scanner) -> string {
    let start = scanner.offset.get() - 1;
    let mut valid = true;
    let mut count = 0;
    let mut finished = false;
    while !finished {
        let current = scanner.current.get();
        if current == b'\n'.to_i32() || current < 0 {
            if valid {
                report(scanner, start, "rune literal not terminated");
                valid = false;
            }
            finished = true;
        } else {
            next(scanner);
            if current == b'\''.to_i32() {
                finished = true;
            } else {
                count += 1;
                if current == b'\\'.to_i32() && !scan_escape(scanner, b'\''.to_i32()) {
                    valid = false;
                }
            }
        }
    }
    if valid && count != 1 {
        report(scanner, start, "illegal rune literal")
    }
    scanner_text(scanner, start, scanner.offset.get())
}

fn scan_string(scanner: Scanner) -> string {
    let start = scanner.offset.get() - 1;
    let mut finished = false;
    while !finished {
        let current = scanner.current.get();
        if current == b'\n'.to_i32() || current < 0 {
            report(scanner, start, "string literal not terminated");
            finished = true;
        } else {
            next(scanner);
            if current == b'"'.to_i32() {
                finished = true;
            } else if current == b'\\'.to_i32() {
                let _ = scan_escape(scanner, b'"'.to_i32());
            }
        }
    }
    scanner_text(scanner, start, scanner.offset.get())
}

fn strip_carriage_returns(source: Vec[byte], start: isize, end: isize, comment: bool) -> string {
    let output: Vec[byte] = Vec::with_capacity(end - start);
    let mut index = start;
    while index < end {
        let value = source[index];
        let preserve = value != b'\r'
            || (comment && output.len() > 2 && output[output.len() - 1] == b'*' && index + 1 < end
                && source[index + 1] == b'/');
        if preserve {
            output.push(value)
        }
        index += 1;
    }
    source_text(output, 0, output.len())
}

fn scan_raw_string(scanner: Scanner) -> string {
    let start = scanner.offset.get() - 1;
    let mut has_carriage_return = false;
    let mut finished = false;
    while !finished {
        let current = scanner.current.get();
        if current < 0 {
            report(scanner, start, "raw string literal not terminated");
            finished = true;
        } else {
            next(scanner);
            if current == b'`'.to_i32() {
                finished = true;
            } else if current == b'\r'.to_i32() {
                has_carriage_return = true;
            }
        }
    }
    if has_carriage_return {
        strip_carriage_returns(scanner.source, start, scanner.offset.get(), false)
    } else {
        scanner_text(scanner, start, scanner.offset.get())
    }
}
