package parser;

use gomlgo::ast;
use gomlgo::token;

fn literal_first(kind: token::Kind) -> bool {
    token::equal(kind, token::Kind::Int) || token::equal(kind, token::Kind::Float)
        || token::equal(kind, token::Kind::Imag)
        || token::equal(kind, token::Kind::Char)
        || token::equal(kind, token::Kind::String)
}

fn expression_first(kind: token::Kind) -> bool {
    token::equal(kind, token::Kind::Ident) || literal_first(kind)
        || token::equal(kind, token::Kind::Lparen)
        || token::equal(kind, token::Kind::Lbrack)
        || token::equal(kind, token::Kind::Func)
        || token::equal(kind, token::Kind::Struct)
        || token::equal(kind, token::Kind::Map)
        || token::equal(kind, token::Kind::Chan)
        || token::equal(kind, token::Kind::Interface)
        || unary_first(kind)
}

fn unary_first(kind: token::Kind) -> bool {
    token::equal(kind, token::Kind::Add) || token::equal(kind, token::Kind::Sub)
        || token::equal(kind, token::Kind::Not)
        || token::equal(kind, token::Kind::Xor)
        || token::equal(kind, token::Kind::Mul)
        || token::equal(kind, token::Kind::And)
        || token::equal(kind, token::Kind::Arrow)
        || token::equal(kind, token::Kind::Tilde)
}

fn parse_expression_list(parser: Parser) -> Vec[ast::Node] {
    let values: Vec[ast::Node] = Vec::from_array([parse_expression(parser)]);
    while eat(parser, token::Kind::Comma).is_some() {
        if expression_first(peek(parser)) {
            values.push(parse_expression(parser))
        } else {
            break
        }
    }
    values
}

fn parse_operand(parser: Parser) -> ast::Node {
    if at(parser, token::Kind::Ident) {
        parse_ident(parser)
    } else if literal_first(peek(parser)) {
        basic_lit_node(advance(parser))
    } else if at(parser, token::Kind::Lparen) {
        let left = advance(parser);
        let saved_level = parser.expr_level.get();
        parser.expr_level.set(saved_level + 1);
        let expression = parse_expression(parser);
        parser.expr_level.set(saved_level);
        let right = expect(parser, token::Kind::Rparen);
        ast::node(
            ast::Kind::ParenExpr,
            left.start,
            right.end,
            Vec::from_array(
                [
                    ast::field("lparen", ast::int_value(left.start)),
                    ast::field("x", ast::node_value(expression)),
                    ast::field("rparen", ast::int_value(right.start)),
                ],
            ),
        )
    } else if at(parser, token::Kind::Func) {
        let function_type = parse_func_type(parser);
        if at(parser, token::Kind::Lbrace) {
            let body = if parser.skip_function_bodies {
                skip_block_statement(parser)
            } else {
                parse_block_statement(parser)
            };
            ast::node(
                ast::Kind::FuncLit,
                function_type.span.start,
                body.span.end,
                Vec::from_array(
                    [
                        ast::field("type", ast::node_value(function_type)),
                        ast::field("body", ast::node_value(body)),
                    ],
                ),
            )
        } else {
            function_type
        }
    } else if type_first(peek(parser)) {
        parse_type(parser)
    } else {
        let start = current(parser).start;
        report(parser, start, "expected operand, found '" + token::name(current(parser).kind) + "'");
        if !eof(parser) {
            let consumed = advance(parser);
            bad_expr(start, consumed.end)
        } else {
            bad_expr(start, start)
        }
    }
}

fn parse_selector(parser: Parser, expression: ast::Node) -> ast::Node {
    let dot = expect(parser, token::Kind::Period);
    if eat(parser, token::Kind::Lparen).is_some() {
        let asserted = if at(parser, token::Kind::Type) {
            let _ = advance(parser);
            Option::None
        } else {
            Option::Some(parse_type(parser))
        };
        let right = expect(parser, token::Kind::Rparen);
        ast::node(
            ast::Kind::TypeAssertExpr,
            expression.span.start,
            right.end,
            Vec::from_array(
                [
                    ast::field("x", ast::node_value(expression)),
                    ast::field("lparen", ast::int_value(dot.end)),
                    ast::field("type", ast::optional_node(asserted)),
                    ast::field("rparen", ast::int_value(right.start)),
                ],
            ),
        )
    } else {
        let selector = parse_ident(parser);
        ast::node(
            ast::Kind::SelectorExpr,
            expression.span.start,
            selector.span.end,
            Vec::from_array(
                [
                    ast::field("x", ast::node_value(expression)),
                    ast::field("sel", ast::node_value(selector)),
                ],
            ),
        )
    }
}

fn parse_index_slice_or_instance(parser: Parser, expression: ast::Node) -> ast::Node {
    let left = expect(parser, token::Kind::Lbrack);
    let saved_level = parser.expr_level.get();
    parser.expr_level.set(saved_level + 1);
    let values: Vec[ast::Node] = Vec::new();
    let mut low: Option[ast::Node] = Option::None;
    let mut high: Option[ast::Node] = Option::None;
    let mut maximum: Option[ast::Node] = Option::None;
    let mut slice = false;
    let mut slice_three = false;
    if !at(parser, token::Kind::Colon) && !at(parser, token::Kind::Rbrack) {
        let first = parse_expression(parser);
        low = Option::Some(first);
        values.push(first)
    } else if at(parser, token::Kind::Rbrack) {
        let position = current(parser).start;
        report(
            parser,
            position,
            "expected operand, found '" + token::name(current(parser).kind) + "'",
        );
        values.push(bad_expr(position, position))
    }
    match eat(parser, token::Kind::Colon) {
        Some(first_colon) => {
            slice = true;
            if !at(parser, token::Kind::Colon) && !at(parser, token::Kind::Rbrack) {
                high = Option::Some(parse_expression(parser));
            }
            match eat(parser, token::Kind::Colon) {
                Some(second_colon) => {
                    slice_three = true;
                    if high.is_none() {
                        report(parser, first_colon.start, "middle index required in 3-index slice")
                    }
                    if !at(parser, token::Kind::Rbrack) {
                        maximum = Option::Some(parse_expression(parser));
                    } else {
                        report(parser, second_colon.start, "final index required in 3-index slice")
                    }
                },
                None => {},
            }
        },
        None => {
            while eat(parser, token::Kind::Comma).is_some() {
                if at(parser, token::Kind::Rbrack) {
                    break
                } else {
                    values.push(parse_expression(parser))
                }
            }
        },
    }
    let right = expect(parser, token::Kind::Rbrack);
    parser.expr_level.set(saved_level);
    if slice {
        ast::node(
            ast::Kind::SliceExpr,
            expression.span.start,
            right.end,
            Vec::from_array(
                [
                    ast::field("x", ast::node_value(expression)),
                    ast::field("lbrack", ast::int_value(left.start)),
                    ast::field("low", ast::optional_node(low)),
                    ast::field("high", ast::optional_node(high)),
                    ast::field("max", ast::optional_node(maximum)),
                    ast::field("slice3", ast::bool_value(slice_three)),
                    ast::field("rbrack", ast::int_value(right.start)),
                ],
            ),
        )
    } else if values.len() == 1 {
        ast::node(
            ast::Kind::IndexExpr,
            expression.span.start,
            right.end,
            Vec::from_array(
                [
                    ast::field("x", ast::node_value(expression)),
                    ast::field("lbrack", ast::int_value(left.start)),
                    ast::field("index", ast::node_value(values[0])),
                    ast::field("rbrack", ast::int_value(right.start)),
                ],
            ),
        )
    } else {
        ast::node(
            ast::Kind::IndexListExpr,
            expression.span.start,
            right.end,
            Vec::from_array(
                [
                    ast::field("x", ast::node_value(expression)),
                    ast::field("lbrack", ast::int_value(left.start)),
                    ast::field("indices", ast::nodes(values)),
                    ast::field("rbrack", ast::int_value(right.start)),
                ],
            ),
        )
    }
}

fn parse_call(parser: Parser, function: ast::Node) -> ast::Node {
    let left = expect(parser, token::Kind::Lparen);
    let saved_level = parser.expr_level.get();
    parser.expr_level.set(saved_level + 1);
    let arguments: Vec[ast::Node] = Vec::new();
    let mut ellipsis = -1;
    while !at(parser, token::Kind::Rparen) && !eof(parser) {
        let before = cursor_position(parser);
        arguments.push(parse_expression(parser));
        if eat(parser, token::Kind::Ellipsis).is_some() {
            ellipsis = parser.previous_end.get() - 3;
        }
        if eat(parser, token::Kind::Comma).is_some() {
            if at(parser, token::Kind::Rparen) {
                break
            }
        } else {
            break
        }
        let _ = ensure_progress(parser, before, "argument list");
    }
    let right = expect(parser, token::Kind::Rparen);
    parser.expr_level.set(saved_level);
    ast::node(
        ast::Kind::CallExpr,
        function.span.start,
        right.end,
        Vec::from_array(
            [
                ast::field("fun", ast::node_value(function)),
                ast::field("lparen", ast::int_value(left.start)),
                ast::field(
                    "args",
                    if arguments.is_empty() {
                        ast::null()
                    } else {
                        ast::nodes(arguments)
                    },
                ),
                ast::field("ellipsis", ast::int_value(ellipsis)),
                ast::field("rparen", ast::int_value(right.start)),
            ],
        ),
    )
}

fn parse_literal_element(parser: Parser) -> ast::Node {
    let key = if at(parser, token::Kind::Lbrace) {
        parse_composite_literal(parser, Option::None)
    } else {
        parse_expression(parser)
    };
    if let Some(colon) = eat(parser, token::Kind::Colon) {
        let value = if at(parser, token::Kind::Lbrace) {
            parse_composite_literal(parser, Option::None)
        } else {
            parse_expression(parser)
        };
        ast::node(
            ast::Kind::KeyValueExpr,
            key.span.start,
            value.span.end,
            Vec::from_array(
                [
                    ast::field("key", ast::node_value(key)),
                    ast::field("colon", ast::int_value(colon.start)),
                    ast::field("value", ast::node_value(value)),
                ],
            ),
        )
    } else {
        key
    }
}

fn parse_composite_literal(parser: Parser, type_value: Option[ast::Node]) -> ast::Node {
    let left = expect(parser, token::Kind::Lbrace);
    let saved_level = parser.expr_level.get();
    parser.expr_level.set(saved_level + 1);
    let elements: Vec[ast::Node] = Vec::new();
    let mut incomplete = false;
    while !at(parser, token::Kind::Rbrace) && !eof(parser) {
        let before = cursor_position(parser);
        if at(parser, token::Kind::Lbrace) || expression_first(peek(parser)) {
            elements.push(parse_literal_element(parser))
        } else {
            report(parser, current(parser).start, "expected composite literal element");
            incomplete = true;
            let _ = advance(parser);
        }
        if eat(parser, token::Kind::Comma).is_some() {} else if !at(parser, token::Kind::Rbrace) {
            report(parser, current(parser).start, "missing ',' in composite literal");
            incomplete = true;
        }
        let _ = ensure_progress(parser, before, "composite literal");
    }
    let right = expect(parser, token::Kind::Rbrace);
    parser.expr_level.set(saved_level);
    let start = match type_value {
        Some(value) => value.span.start,
        None => left.start,
    };
    ast::node(
        ast::Kind::CompositeLit,
        start,
        right.end,
        Vec::from_array(
            [
                ast::field("type", ast::optional_node(type_value)),
                ast::field("lbrace", ast::int_value(left.start)),
                ast::field(
                    "elts",
                    if elements.is_empty() {
                        ast::null()
                    } else {
                        ast::nodes(elements)
                    },
                ),
                ast::field("rbrace", ast::int_value(right.start)),
                ast::field("incomplete", ast::bool_value(incomplete)),
            ],
        ),
    )
}

fn parse_primary_expression(parser: Parser, initial: ast::Node) -> ast::Node {
    let mut expression = initial;
    let mut continuing = true;
    while continuing && !parser.depth_limit_hit.get() {
        if at(parser, token::Kind::Period) {
            expression = parse_selector(parser, expression);
        } else if at(parser, token::Kind::Lbrack) {
            expression = parse_index_slice_or_instance(parser, expression);
        } else if at(parser, token::Kind::Lparen) {
            expression = parse_call(parser, expression);
        } else if at(parser, token::Kind::Lbrace)
            && (parser.expr_level.get() >= 0
                || ast::kind_equal(expression.kind, ast::Kind::ArrayType)
                || ast::kind_equal(expression.kind, ast::Kind::StructType)
                || ast::kind_equal(expression.kind, ast::Kind::MapType)) {
            expression = parse_composite_literal(parser, Option::Some(expression));
        } else {
            continuing = false;
        }
    }
    expression
}

fn parse_unary_expression(parser: Parser) -> ast::Node {
    if at(parser, token::Kind::Arrow) && token::equal(nth(parser, 1).kind, token::Kind::Chan) {
        parse_type(parser)
    } else if unary_first(peek(parser)) {
        let operator = advance(parser);
        let operand = parse_unary_expression(parser);
        if token::equal(operator.kind, token::Kind::Mul) {
            ast::node(
                ast::Kind::StarExpr,
                operator.start,
                operand.span.end,
                Vec::from_array(
                    [
                        ast::field("star", ast::int_value(operator.start)),
                        ast::field("x", ast::node_value(operand)),
                    ],
                ),
            )
        } else {
            ast::node(
                ast::Kind::UnaryExpr,
                operator.start,
                operand.span.end,
                Vec::from_array(
                    [
                        ast::field("op_pos", ast::int_value(operator.start)),
                        ast::field("op", token_operator(operator)),
                        ast::field("x", ast::node_value(operand)),
                    ],
                ),
            )
        }
    } else {
        parse_primary_expression(parser, parse_operand(parser))
    }
}

fn precedence(kind: token::Kind) -> isize {
    if token::equal(kind, token::Kind::Lor) {
        1
    } else if token::equal(kind, token::Kind::Land) {
        2
    } else if token::equal(kind, token::Kind::Eql) || token::equal(kind, token::Kind::Neq)
        || token::equal(kind, token::Kind::Lss)
        || token::equal(kind, token::Kind::Leq)
        || token::equal(kind, token::Kind::Gtr)
        || token::equal(kind, token::Kind::Geq) {
        3
    } else if token::equal(kind, token::Kind::Add) || token::equal(kind, token::Kind::Sub)
        || token::equal(kind, token::Kind::Or)
        || token::equal(kind, token::Kind::Xor) {
        4
    } else if token::equal(kind, token::Kind::Mul) || token::equal(kind, token::Kind::Quo)
        || token::equal(kind, token::Kind::Rem)
        || token::equal(kind, token::Kind::Shl)
        || token::equal(kind, token::Kind::Shr)
        || token::equal(kind, token::Kind::And)
        || token::equal(kind, token::Kind::AndNot) {
        5
    } else {
        0
    }
}

fn parse_binary_expression(parser: Parser, initial: ast::Node, minimum: isize) -> ast::Node {
    let mut left = initial;
    let mut continuing = true;
    while continuing {
        let operator_precedence = precedence(peek(parser));
        if operator_precedence < minimum || operator_precedence == 0 {
            continuing = false;
        } else {
            let operator = advance(parser);
            let mut right = parse_unary_expression(parser);
            let next_precedence = precedence(peek(parser));
            if operator_precedence < next_precedence {
                right = parse_binary_expression(parser, right, operator_precedence + 1);
            }
            left = ast::node(
                ast::Kind::BinaryExpr,
                left.span.start,
                right.span.end,
                Vec::from_array(
                    [
                        ast::field("x", ast::node_value(left)),
                        ast::field("op_pos", ast::int_value(operator.start)),
                        ast::field("op", token_operator(operator)),
                        ast::field("y", ast::node_value(right)),
                    ],
                ),
            );
        }
    }
    left
}

fn parse_expression(parser: Parser) -> ast::Node {
    if !enter_nesting(parser) {
        return bad_expr(current(parser).start, current(parser).start)
    }
    let left = parse_unary_expression(parser);
    let result = parse_binary_expression(parser, left, 1);
    leave_nesting(parser);
    result
}
