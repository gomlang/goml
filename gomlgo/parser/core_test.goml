package parser;

use gomlgo::token;
use std::bytes;
use std::testing;

#[test]
fn cursor_skips_comments_and_preserves_semicolons() -> () {
    let parser = parser_new(bytes::Bytes::from_string("x /* keep */\ny"));
    testing::assert(at(parser, token::Kind::Ident));
    testing::assert_eq(advance(parser).literal, "x");
    testing::assert(at(parser, token::Kind::Semicolon));
    testing::assert(advance(parser).synthetic);
    testing::assert_eq(advance(parser).literal, "y");
    testing::assert(at(parser, token::Kind::Semicolon));
    testing::assert(at(parser, token::Kind::Semicolon));
    testing::assert(!eof(parser));
    let _ = advance(parser);
    testing::assert(eof(parser))
}

#[test]
fn expect_reports_without_consuming_unrelated_token() -> () {
    let parser = parser_new(bytes::Bytes::from_string("name"));
    let missing = expect(parser, token::Kind::Lparen);
    testing::assert(missing.synthetic);
    testing::assert_eq(missing.start, 0);
    testing::assert(at(parser, token::Kind::Ident));
    testing::assert_eq(parser.diagnostics.len(), 1)
}

#[test]
fn recovery_consumes_until_synchronization_token() -> () {
    let parser = parser_new(bytes::Bytes::from_string("a + b }"));
    recover_until(parser, Vec::from_array([token::Kind::Rbrace]));
    testing::assert(at(parser, token::Kind::Rbrace))
}
