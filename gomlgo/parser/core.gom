package parser;

use gomlgo::ast;
use gomlgo::diagnostic;
use gomlgo::scanner;
use gomlgo::token;
use std::bytes;
use std::collections;

const MAX_NESTING: isize = 10000;

const DIAGNOSTIC_LIMIT: isize = 100;

const CURSOR_FUEL: isize = 256;

pub struct ParseResult {
    pub root: Option[ast::Node],
    pub diagnostics: Vec[diagnostic::Diagnostic],
}

struct Parser {
    tokens: Vec[token::Token],
    cursor: Ref[isize],
    previous_end: Ref[isize],
    fuel: Ref[isize],
    nesting: Ref[isize],
    expr_level: Ref[isize],
    depth_limit_hit: Ref[bool],
    diagnostic_limit_hit: Ref[bool],
    diagnostics: Vec[diagnostic::Diagnostic],
    imports: Vec[ast::Node],
    comment_infos: Vec[CommentInfo],
    comment_nodes: Vec[ast::Node],
    go_version: string,
    source_len: isize,
    skip_function_bodies: bool,
}

fn parser_new_with_mode(source: bytes::Bytes, retain_comments: bool, skip_function_bodies: bool) -> Parser {
    let source_len = source.len();
    let scanned = scanner::scan_bytes(source);
    let comment_infos: Vec[CommentInfo] = Vec::new();
    let comment_nodes: Vec[ast::Node] = Vec::new();
    let (go_version, comment_limit) = token_metadata(scanned.tokens);
    if retain_comments && comment_limit > 0 {
        let comments = analyze_comments(source, scanned.tokens);
        for value in comments.infos {
            comment_infos.push(value)
        }
        for value in comments.nodes {
            comment_nodes.push(value)
        }
    }
    if comment_limit > 0 {
        let mut write_index = 0;
        for read_index in 0..scanned.tokens.len() {
            let value = scanned.tokens[read_index];
            if !token::equal(value.kind, token::Kind::Comment) {
                if write_index != read_index {
                    scanned.tokens[write_index] = value;
                }
                write_index += 1;
            }
        }
        while scanned.tokens.len() > write_index {
            let _ = scanned.tokens.pop();
        }
    }
    Parser {
        tokens: scanned.tokens,
        cursor: Ref::new(0),
        previous_end: Ref::new(0),
        fuel: Ref::new(CURSOR_FUEL),
        nesting: Ref::new(0),
        expr_level: Ref::new(0),
        depth_limit_hit: Ref::new(false),
        diagnostic_limit_hit: Ref::new(false),
        diagnostics: scanned.diagnostics,
        imports: Vec::new(),
        comment_infos,
        comment_nodes,
        go_version,
        source_len,
        skip_function_bodies,
    }
}

fn parser_new(source: bytes::Bytes) -> Parser {
    parser_new_with_mode(source, true, false)
}

fn significant_index(parser: Parser, distance: isize) -> isize {
    let index = parser.cursor.get() + distance;
    if index < parser.tokens.len() {
        index
    } else {
        parser.tokens.len()
    }
}

fn eof_token(parser: Parser) -> token::Token {
    token::make(token::Kind::Eof, "", parser.source_len, parser.source_len, false)
}

fn current(parser: Parser) -> token::Token {
    let index = significant_index(parser, 0);
    if index < parser.tokens.len() {
        parser.tokens[index]
    } else {
        eof_token(parser)
    }
}

fn nth_index(parser: Parser, distance: isize) -> isize {
    if parser.fuel.get() == 0 {
        report(parser, current(parser).start, "parser did not consume input");
        parser.tokens.len()
    } else {
        parser.fuel.set(parser.fuel.get() - 1);
        significant_index(parser, distance)
    }
}

fn nth(parser: Parser, distance: isize) -> token::Token {
    let index = nth_index(parser, distance);
    if index < parser.tokens.len() {
        parser.tokens[index]
    } else {
        eof_token(parser)
    }
}

fn peek(parser: Parser) -> token::Kind {
    let index = nth_index(parser, 0);
    if index < parser.tokens.len() {
        parser.tokens[index].kind
    } else {
        token::Kind::Eof
    }
}

fn at(parser: Parser, kind: token::Kind) -> bool {
    token::equal(peek(parser), kind)
}

fn at_any(parser: Parser, kinds: Vec[token::Kind]) -> bool {
    let found = Ref::new(false);
    let current_kind = peek(parser);
    for kind in kinds {
        if token::equal(current_kind, kind) {
            found.set(true)
        }
    }
    found.get()
}

fn eof(parser: Parser) -> bool {
    parser.depth_limit_hit.get() || at(parser, token::Kind::Eof)
}

fn advance(parser: Parser) -> token::Token {
    let index = significant_index(parser, 0);
    let result = if index < parser.tokens.len() {
        parser.tokens[index]
    } else {
        eof_token(parser)
    };
    if index < parser.tokens.len() {
        parser.cursor.set(index + 1);
        parser.previous_end.set(result.end)
    }
    parser.fuel.set(CURSOR_FUEL);
    result
}

fn eat(parser: Parser, kind: token::Kind) -> Option[token::Token] {
    if at(parser, kind) {
        Option::Some(advance(parser))
    } else {
        Option::None
    }
}

fn expect(parser: Parser, kind: token::Kind) -> token::Token {
    match eat(parser, kind) {
        Some(value) => value,
        None => {
            let found = current(parser);
            report(
                parser,
                found.start,
                "expected '" + token::name(kind) + "', found '" + token::name(found.kind) + "'",
            );
            token::make(kind, token::name(kind), found.start, found.start, true)
        },
    }
}

fn report(parser: Parser, offset: isize, message: string) -> () {
    if parser.diagnostics.len() < DIAGNOSTIC_LIMIT {
        parser.diagnostics.push(diagnostic::make(message, offset))
    } else if !parser.diagnostic_limit_hit.get() {
        parser.diagnostics.push(diagnostic::make("too many parser diagnostics", offset));
        parser.diagnostic_limit_hit.set(true)
    }
}

fn enter_nesting(parser: Parser) -> bool {
    if parser.depth_limit_hit.get() {
        false
    } else {
        parser.nesting.set(parser.nesting.get() + 1);
        if parser.nesting.get() > MAX_NESTING {
            report(parser, current(parser).start, "exceeded max nesting depth");
            parser.depth_limit_hit.set(true);
            false
        } else {
            true
        }
    }
}

fn leave_nesting(parser: Parser) -> () {
    if parser.nesting.get() > 0 {
        parser.nesting.set(parser.nesting.get() - 1)
    }
}

fn ensure_progress(parser: Parser, before: isize, context: string) -> bool {
    let after = significant_index(parser, 0);
    if after > before || eof(parser) {
        true
    } else {
        report(parser, current(parser).start, "parser made no progress while parsing " + context);
        let _ = advance(parser);
        false
    }
}

fn recover_until(parser: Parser, recovery: Vec[token::Kind]) -> () {
    let mut attempts = 0;
    while !eof(parser) && !at_any(parser, recovery) && attempts < CURSOR_FUEL {
        let _ = advance(parser);
        attempts += 1;
    }
    if attempts == CURSOR_FUEL && !eof(parser) {
        report(parser, current(parser).start, "parser recovery limit reached")
    }
}

fn consume_semicolon(parser: Parser) -> () {
    if eat(parser, token::Kind::Semicolon).is_some() {} else if !at(parser, token::Kind::Rparen)
        && !at(parser, token::Kind::Rbrace) {
        let found = current(parser);
        if token::equal(found.kind, token::Kind::Lbrack) {
            report(parser, found.start, "expected ';', found '['");
            recover_until(
                parser,
                Vec::from_array(
                    [
                        token::Kind::Semicolon,
                        token::Kind::Rparen,
                        token::Kind::Rbrace,
                        token::Kind::Eof,
                    ],
                ),
            )
        } else {
            report(parser, found.start, "expected semicolon or newline");
        }
        if !eof(parser) && !at(parser, token::Kind::Semicolon) && !at(parser, token::Kind::Rparen)
            && !at(parser, token::Kind::Rbrace) {
            let _ = advance(parser);
        }
    }
}

fn compare_diagnostic(left: diagnostic::Diagnostic, right: diagnostic::Diagnostic) -> isize {
    if left.offset < right.offset || (left.offset == right.offset && left.message < right.message) {
        -1
    } else if left.offset == right.offset && left.message == right.message {
        0
    } else {
        1
    }
}

fn result(parser: Parser, root: Option[ast::Node]) -> ParseResult {
    collections::stable_sort_by(parser.diagnostics, compare_diagnostic);
    ParseResult { root, diagnostics: parser.diagnostics }
}
