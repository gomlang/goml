package parser;

use gomlgo::ast;
use gomlgo::token;

fn ident_node(value: token::Token) -> ast::Node {
    ast::ident(value.start, value.end, value.literal)
}

fn missing_ident(offset: isize) -> ast::Node {
    ast::ident(offset, offset, "_")
}

fn parse_ident(parser: Parser) -> ast::Node {
    if at(parser, token::Kind::Ident) {
        ident_node(advance(parser))
    } else {
        let offset = current(parser).start;
        report(parser, offset, "expected identifier");
        missing_ident(offset)
    }
}

fn basic_lit_node(value: token::Token) -> ast::Node {
    ast::literal(value.start, value.end, token::name(value.kind), value.literal)
}

fn bad_expr(start: isize, end: isize) -> ast::Node {
    ast::typed_node(ast::Kind::BadExpr, start, end, ast::Fields::BadExpr { from: start, to: end })
}

fn bad_stmt(start: isize, end: isize) -> ast::Node {
    ast::typed_node(ast::Kind::BadStmt, start, end, ast::Fields::BadStmt { from: start, to: end })
}

fn bad_decl(start: isize, end: isize) -> ast::Node {
    ast::typed_node(ast::Kind::BadDecl, start, end, ast::Fields::BadDecl { from: start, to: end })
}

fn field_node(names: Vec[ast::Node], type_value: Option[ast::Node], tag: Option[ast::Node]) -> ast::Node {
    let start = if !names.is_empty() {
        names[0].span.start
    } else {
        match type_value {
            Some(value) => value.span.start,
            None => -1,
        }
    };
    let end = match tag {
        Some(value) => value.span.end,
        None => match type_value {
            Some(value) => value.span.end,
            None => if !names.is_empty() {
                names[names.len() - 1].span.end
            } else {
                -1
            },
        },
    };
    ast::typed_node(
        ast::Kind::Field,
        start,
        end,
        ast::Fields::Field {
            names: if names.is_empty() {
                Option::None
            } else {
                Option::Some(names)
            },
            type_node: type_value,
            tag: tag,
        },
    )
}

fn field_list_node(opening: isize, fields: Vec[ast::Node], closing: isize) -> ast::Node {
    let start = if opening >= 0 {
        opening
    } else if !fields.is_empty() {
        fields[0].span.start
    } else {
        -1
    };
    let end = if closing >= 0 {
        closing + 1
    } else if !fields.is_empty() {
        fields[fields.len() - 1].span.end
    } else {
        -1
    };
    ast::typed_node(
        ast::Kind::FieldList,
        start,
        end,
        ast::Fields::FieldList {
            opening: opening,
            list: if fields.is_empty() {
                Option::None
            } else {
                Option::Some(fields)
            },
            closing: closing,
        },
    )
}

fn expr_stmt_node(expression: ast::Node) -> ast::Node {
    ast::typed_node(
        ast::Kind::ExprStmt,
        expression.span.start,
        expression.span.end,
        ast::Fields::ExprStmt { x: expression },
    )
}

fn block_node(left: isize, statements: Vec[ast::Node], right: isize) -> ast::Node {
    let end = if right >= 0 {
        right + 1
    } else if !statements.is_empty() {
        statements[statements.len() - 1].span.end
    } else {
        left + 1
    };
    ast::typed_node(
        ast::Kind::BlockStmt,
        left,
        end,
        ast::Fields::BlockStmt {
            lbrace: left,
            list: if statements.is_empty() {
                Option::None
            } else {
                Option::Some(statements)
            },
            rbrace: right,
        },
    )
}
