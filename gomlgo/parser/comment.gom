package parser;

use gomlgo::ast;
use gomlgo::token;
use std::bytes;

struct CommentInfo {
    node: ast::Node,
    next_start: isize,
    previous_start: isize,
    previous_end: isize,
    previous_semicolon: bool,
    lead: bool,
    line: bool,
}

struct CommentData {
    infos: Vec[CommentInfo],
    nodes: Vec[ast::Node],
    lines: Vec[isize],
}

fn source_lines(source: bytes::Bytes) -> Vec[isize] {
    let result: Vec[isize] = Vec::from_array([0]);
    for index in 0..source.len() {
        if source.get(index) == b'\n' {
            result.push(index + 1)
        }
    }
    result
}

fn line_for(lines: Vec[isize], offset: isize) -> isize {
    let mut low = 0;
    let mut high = lines.len();
    while low + 1 < high {
        let middle = low + (high - low) / 2;
        if lines[middle] <= offset {
            low = middle;
        } else {
            high = middle;
        }
    }
    low + 1
}

fn comment_end_line(value: token::Token, start_line: isize) -> isize {
    let mut result = start_line;
    for index in 0..value.literal.byte_len() {
        if value.literal.byte_get(index) == b'\n' {
            result += 1;
        }
    }
    result
}

fn comment_node(value: token::Token) -> ast::Node {
    ast::node(
        ast::Kind::Comment,
        value.start,
        value.start + value.literal.byte_len(),
        Vec::from_array(
            [
                ast::field("slash", ast::int_value(value.start)),
                ast::field("text", ast::text_value(value.literal)),
            ],
        ),
    )
}

fn comment_group(tokens: Vec[token::Token], start: isize, end: isize) -> ast::Node {
    let values: Vec[ast::Node] = Vec::new();
    for index in start..end {
        values.push(comment_node(tokens[index]))
    }
    ast::node(
        ast::Kind::CommentGroup,
        values[0].span.start,
        values[values.len() - 1].span.end,
        Vec::from_array([ast::field("list", ast::nodes(values))]),
    )
}

fn append_comment_info(
    data: CommentData,
    tokens: Vec[token::Token],
    start: isize,
    end: isize,
    next: token::Token,
    previous: Option[token::Token],
    lead: bool,
    line: bool,
) -> () {
    let node = comment_group(tokens, start, end);
    data.nodes.push(node);
    data.infos.push(
        CommentInfo {
            node,
            next_start: next.start,
            previous_start: match previous {
                Some(value) => value.start,
                None => -1,
            },
            previous_end: match previous {
                Some(value) => value.end,
                None => -1,
            },
            previous_semicolon: match previous {
                Some(value) => token::equal(value.kind, token::Kind::Semicolon) && !value.synthetic,
                None => false,
            },
            lead,
            line,
        },
    )
}

fn analyze_comments(source: bytes::Bytes, tokens: Vec[token::Token]) -> CommentData {
    let data = CommentData { infos: Vec::new(), nodes: Vec::new(), lines: source_lines(source) };
    let mut index = 0;
    let mut previous: Option[token::Token] = Option::None;
    while index < tokens.len() {
        if !token::equal(tokens[index].kind, token::Kind::Comment) {
            previous = Option::Some(tokens[index]);
            index += 1;
        } else {
            let run_end = Ref::new(index);
            while run_end.get() < tokens.len()
                && token::equal(tokens[run_end.get()].kind, token::Kind::Comment) {
                run_end.set(run_end.get() + 1)
            }
            let previous_line = match previous {
                Some(value) => line_for(data.lines, value.start),
                None => -1,
            };
            if line_for(data.lines, tokens[index].start) == previous_line {
                let group_end = Ref::new(index + 1);
                let end_line = Ref::new(comment_end_line(tokens[index], previous_line));
                while group_end.get() < run_end.get()
                    && line_for(data.lines, tokens[group_end.get()].start) <= end_line.get() {
                    end_line.set(
                        comment_end_line(
                            tokens[group_end.get()],
                            line_for(data.lines, tokens[group_end.get()].start),
                        ),
                    );
                    group_end.set(group_end.get() + 1)
                }
                let next = tokens[group_end.get()];
                let line_comment = (line_for(data.lines, next.start) != end_line.get()
                    || token::equal(next.kind, token::Kind::Semicolon)
                    || token::equal(next.kind, token::Kind::Eof))
                    && !(token::equal(next.kind, token::Kind::Semicolon) && !next.synthetic);
                append_comment_info(
                    data,
                    tokens,
                    index,
                    group_end.get(),
                    next,
                    previous,
                    false,
                    line_comment,
                );
                index = group_end.get();
            }
            while index < run_end.get() {
                let group_end = Ref::new(index + 1);
                let end_line = Ref::new(
                    comment_end_line(tokens[index], line_for(data.lines, tokens[index].start)),
                );
                while group_end.get() < run_end.get()
                    && line_for(data.lines, tokens[group_end.get()].start) <= end_line.get() + 1 {
                    end_line.set(
                        comment_end_line(
                            tokens[group_end.get()],
                            line_for(data.lines, tokens[group_end.get()].start),
                        ),
                    );
                    group_end.set(group_end.get() + 1)
                }
                let next = tokens[group_end.get()];
                let lead = group_end.get() == run_end.get()
                    && end_line.get() + 1 == line_for(data.lines, next.start);
                append_comment_info(
                    data,
                    tokens,
                    index,
                    group_end.get(),
                    next,
                    previous,
                    lead,
                    false,
                );
                index = group_end.get();
            }
        }
    }
    data
}

fn lead_comment(parser: Parser, start: isize) -> Option[ast::Node] {
    for value in parser.comment_infos {
        if value.lead && value.next_start == start {
            return Option::Some(value.node)
        }
    }
    Option::None
}

fn line_comment(parser: Parser, end: isize) -> Option[ast::Node] {
    for value in parser.comment_infos {
        if value.line
            && (value.previous_end == end
                || (value.previous_semicolon && value.previous_start == end)) {
            return Option::Some(value.node)
        }
    }
    Option::None
}

fn attach_value(parser: Parser, value: ast::Value, fields: bool) -> ast::Value {
    match value {
        ast::Value::Node(node) => ast::Value::Node(attach_comments(parser, node, fields)),
        ast::Value::Nodes(nodes) => {
            let result: Vec[ast::Node] = Vec::with_capacity(nodes.len());
            for node in nodes {
                result.push(attach_comments(parser, node, fields))
            }
            ast::Value::Nodes(result)
        },
        other => other,
    }
}

fn attach_comments(parser: Parser, value: ast::Node, field_comments: bool) -> ast::Node {
    let ast::Fields::Named(entries) = value.fields else {
        return value;
    };
    let fields: Vec[(string, ast::Value)] = Vec::with_capacity(entries.len());
    for entry in entries {
        let nested_fields = (ast::kind_equal(value.kind, ast::Kind::StructType)
            && entry.0 == "fields")
            || (ast::kind_equal(value.kind, ast::Kind::InterfaceType) && entry.0 == "methods")
            || (ast::kind_equal(value.kind, ast::Kind::FieldList) && entry.0 == "list"
                && field_comments);
        let attached = if entry.0 == "doc"
            && (ast::kind_equal(value.kind, ast::Kind::File)
                || ast::kind_equal(value.kind, ast::Kind::GenDecl)
                || ast::kind_equal(value.kind, ast::Kind::FuncDecl)
                || ast::kind_equal(value.kind, ast::Kind::ImportSpec)
                || ast::kind_equal(value.kind, ast::Kind::ValueSpec)
                || ast::kind_equal(value.kind, ast::Kind::TypeSpec)
                || (ast::kind_equal(value.kind, ast::Kind::Field) && field_comments)) {
            ast::optional_node(lead_comment(parser, value.span.start))
        } else if entry.0 == "comment"
            && (ast::kind_equal(value.kind, ast::Kind::ImportSpec)
                || ast::kind_equal(value.kind, ast::Kind::ValueSpec)
                || ast::kind_equal(value.kind, ast::Kind::TypeSpec)
                || (ast::kind_equal(value.kind, ast::Kind::Field) && field_comments)) {
            ast::optional_node(line_comment(parser, value.span.end))
        } else {
            attach_value(parser, entry.1, nested_fields)
        };
        fields.push((entry.0, attached))
    }
    ast::node(value.kind, value.span.start, value.span.end, fields)
}
