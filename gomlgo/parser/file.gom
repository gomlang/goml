package parser;

use gomlgo::ast;
use gomlgo::token;
use std::bytes;

fn parse_identifier_list(parser: Parser) -> Vec[ast::Node] {
    let values: Vec[ast::Node] = Vec::from_array([parse_ident(parser)]);
    while eat(parser, token::Kind::Comma).is_some() {
        values.push(parse_ident(parser))
    }
    values
}

fn parse_import_spec(parser: Parser) -> ast::Node {
    let mut name: Option[ast::Node] = Option::None;
    if at(parser, token::Kind::Ident) {
        name = Option::Some(parse_ident(parser));
    } else if at(parser, token::Kind::Period) {
        name = Option::Some(ident_node(advance(parser)));
    }
    let path = if at(parser, token::Kind::String) {
        basic_lit_node(advance(parser))
    } else {
        let start = current(parser).start;
        if at(parser, token::Kind::Char) {
            report(parser, start, "import path must be a string");
            let _ = advance(parser);
        } else {
            report(parser, start, "missing import path");
            if at(parser, token::Kind::Var) || at(parser, token::Kind::Const)
                || at(parser, token::Kind::Type)
                || at(parser, token::Kind::Func) {
                recover_until(
                    parser,
                    Vec::from_array([token::Kind::Semicolon, token::Kind::Rparen, token::Kind::Eof]),
                )
            }
        }
        bad_expr(start, start)
    };
    let start = match name {
        Some(value) => value.span.start,
        None => path.span.start,
    };
    let spec = ast::node(
        ast::Kind::ImportSpec,
        start,
        path.span.end,
        Vec::from_array(
            [
                ast::field("doc", ast::null()),
                ast::field("name", ast::optional_node(name)),
                ast::field("path", ast::node_value(path)),
                ast::field("comment", ast::null()),
                ast::field("end_pos", ast::int_value(-1)),
            ],
        ),
    );
    parser.imports.push(spec);
    spec
}

fn parse_value_spec(parser: Parser, declaration_kind: token::Kind) -> ast::Node {
    let names = parse_identifier_list(parser);
    let type_value = if type_first(peek(parser)) && !at(parser, token::Kind::Assign) {
        Option::Some(parse_type(parser))
    } else {
        Option::None
    };
    let values = if eat(parser, token::Kind::Assign).is_some() {
        parse_expression_list(parser)
    } else {
        Vec::new()
    };
    let missing_type = token::equal(declaration_kind, token::Kind::Var) && type_value.is_none()
        && values.is_empty();
    if missing_type {
        report(
            parser,
            current(parser).start,
            "expected type, found '" + token::name(current(parser).kind) + "'",
        )
    }
    let effective_type = if missing_type {
        Option::Some(bad_expr(current(parser).start, current(parser).start))
    } else {
        type_value
    };
    let end = if !values.is_empty() {
        values[values.len() - 1].span.end
    } else {
        match effective_type {
            Some(value) => value.span.end,
            None => names[names.len() - 1].span.end,
        }
    };
    ast::node(
        ast::Kind::ValueSpec,
        names[0].span.start,
        end,
        Vec::from_array(
            [
                ast::field("doc", ast::null()),
                ast::field("names", ast::nodes(names)),
                ast::field("type", ast::optional_node(effective_type)),
                ast::field(
                    "values",
                    if values.is_empty() {
                        ast::null()
                    } else {
                        ast::nodes(values)
                    },
                ),
                ast::field("comment", ast::null()),
            ],
        ),
    )
}

fn parse_type_spec(parser: Parser) -> ast::Node {
    let name = parse_ident(parser);
    let type_parameters = if type_parameter_list_start(parser) {
        parse_type_parameters(parser)
    } else {
        Option::None
    };
    let assignment = match eat(parser, token::Kind::Assign) {
        Some(value) => value.start,
        None => -1,
    };
    let type_value = parse_type(parser);
    ast::node(
        ast::Kind::TypeSpec,
        name.span.start,
        type_value.span.end,
        Vec::from_array(
            [
                ast::field("doc", ast::null()),
                ast::field("name", ast::node_value(name)),
                ast::field("type_params", ast::optional_node(type_parameters)),
                ast::field("assign", ast::int_value(assignment)),
                ast::field("type", ast::node_value(type_value)),
                ast::field("comment", ast::null()),
            ],
        ),
    )
}

fn parse_spec(parser: Parser, kind: token::Kind) -> ast::Node {
    if token::equal(kind, token::Kind::Import) {
        parse_import_spec(parser)
    } else if token::equal(kind, token::Kind::Type) {
        parse_type_spec(parser)
    } else {
        parse_value_spec(parser, kind)
    }
}

fn parse_general_declaration(parser: Parser) -> ast::Node {
    let keyword = advance(parser);
    let specs: Vec[ast::Node] = Vec::new();
    let mut left = -1;
    let mut right = -1;
    if let Some(opening) = eat(parser, token::Kind::Lparen) {
        left = opening.start;
        while !at(parser, token::Kind::Rparen) && !eof(parser) {
            let before = cursor_position(parser);
            if at(parser, token::Kind::Semicolon) {
                let _ = advance(parser);
            } else {
                specs.push(parse_spec(parser, keyword.kind));
                consume_semicolon(parser)
            }
            let _ = ensure_progress(parser, before, "declaration group");
        }
        right = expect(parser, token::Kind::Rparen).start;
    } else {
        specs.push(parse_spec(parser, keyword.kind))
    }
    let end = if right >= 0 {
        right + 1
    } else if !specs.is_empty() {
        specs[specs.len() - 1].span.end
    } else {
        keyword.end
    };
    ast::node(
        ast::Kind::GenDecl,
        keyword.start,
        end,
        Vec::from_array(
            [
                ast::field("doc", ast::null()),
                ast::field("token_pos", ast::int_value(keyword.start)),
                ast::field("token", token_operator(keyword)),
                ast::field("lparen", ast::int_value(left)),
                ast::field(
                    "specs",
                    if specs.is_empty() {
                        ast::null()
                    } else {
                        ast::nodes(specs)
                    },
                ),
                ast::field("rparen", ast::int_value(right)),
            ],
        ),
    )
}

fn parse_function_declaration(parser: Parser) -> ast::Node {
    let keyword = expect(parser, token::Kind::Func);
    let receiver = if at(parser, token::Kind::Lparen) {
        Option::Some(parse_parameters(parser, false))
    } else {
        Option::None
    };
    let name = parse_ident(parser);
    let function_type = parse_func_type_after_keyword(parser, keyword.start);
    if receiver.is_some() {
        if let Some(type_parameters) = ast::get_node(function_type, "type_params") {
            if !ast::get_nodes(type_parameters, "list").is_empty() {
                report(parser, type_parameters.span.start, "method must have no type parameters")
            }
        }
    }
    let body = if at(parser, token::Kind::Lbrace) {
        Option::Some(
            if parser.skip_function_bodies {
                skip_block_statement(parser)
            } else {
                parse_block_statement(parser)
            },
        )
    } else {
        Option::None
    };
    let end = match body {
        Some(value) => value.span.end,
        None => function_type.span.end,
    };
    ast::node(
        ast::Kind::FuncDecl,
        keyword.start,
        end,
        Vec::from_array(
            [
                ast::field("doc", ast::null()),
                ast::field("recv", ast::optional_node(receiver)),
                ast::field("name", ast::node_value(name)),
                ast::field("type", ast::node_value(function_type)),
                ast::field("body", ast::optional_node(body)),
            ],
        ),
    )
}

fn declaration_first(kind: token::Kind) -> bool {
    token::equal(kind, token::Kind::Import) || token::equal(kind, token::Kind::Const)
        || token::equal(kind, token::Kind::Type)
        || token::equal(kind, token::Kind::Var)
        || token::equal(kind, token::Kind::Func)
}

fn parse_declaration(parser: Parser) -> ast::Node {
    if at(parser, token::Kind::Func) {
        parse_function_declaration(parser)
    } else if at(parser, token::Kind::Import) || at(parser, token::Kind::Const)
        || at(parser, token::Kind::Type)
        || at(parser, token::Kind::Var) {
        parse_general_declaration(parser)
    } else {
        let start = current(parser).start;
        report(parser, start, "expected declaration");
        recover_until(
            parser,
            Vec::from_array(
                [
                    token::Kind::Import,
                    token::Kind::Const,
                    token::Kind::Type,
                    token::Kind::Var,
                    token::Kind::Func,
                    token::Kind::Eof,
                ],
            ),
        );
        bad_decl(start, current(parser).start)
    }
}

fn parse_file_node(parser: Parser) -> ast::Node {
    let package_keyword = expect(parser, token::Kind::Package);
    let name = parse_ident(parser);
    consume_semicolon(parser);
    let declarations: Vec[ast::Node] = Vec::new();
    let mut non_import_seen = false;
    let mut late_import_reported = false;
    while !eof(parser) {
        let before = cursor_position(parser);
        if declaration_first(peek(parser)) {
            if at(parser, token::Kind::Import) {
                if non_import_seen && !late_import_reported {
                    report(
                        parser,
                        current(parser).start,
                        "imports must appear before other declarations",
                    );
                    late_import_reported = true;
                }
            } else {
                non_import_seen = true;
                late_import_reported = false;
            }
            declarations.push(parse_declaration(parser));
            consume_semicolon(parser)
        } else if at(parser, token::Kind::Semicolon) {
            let semicolon = advance(parser);
            if !semicolon.synthetic {
                report(parser, semicolon.start, "expected declaration")
            }
        } else {
            let start = current(parser).start;
            let stray_rbrace = at(parser, token::Kind::Rbrace);
            report(
                parser,
                start,
                if stray_rbrace {
                    "expected declaration, found '}'"
                } else {
                    "expected declaration"
                },
            );
            recover_until(
                parser,
                if stray_rbrace {
                    Vec::from_array(
                        [
                            token::Kind::Import,
                            token::Kind::Const,
                            token::Kind::Type,
                            token::Kind::Var,
                            token::Kind::Eof,
                        ],
                    )
                } else {
                    Vec::from_array(
                        [
                            token::Kind::Import,
                            token::Kind::Const,
                            token::Kind::Type,
                            token::Kind::Var,
                            token::Kind::Func,
                            token::Kind::Eof,
                        ],
                    )
                },
            );
            declarations.push(bad_decl(start, current(parser).start));
        }
        let _ = ensure_progress(parser, before, "source file");
    }
    let end = if declarations.is_empty() {
        name.span.end
    } else {
        declarations[declarations.len() - 1].span.end
    };
    ast::node(
        ast::Kind::File,
        package_keyword.start,
        end,
        Vec::from_array(
            [
                ast::field("doc", ast::null()),
                ast::field("package", ast::int_value(package_keyword.start)),
                ast::field("name", ast::node_value(name)),
                ast::field(
                    "decls",
                    if declarations.is_empty() {
                        ast::null()
                    } else {
                        ast::nodes(declarations)
                    },
                ),
                ast::field("file_start", ast::int_value(0)),
                ast::field("file_end", ast::int_value(parser.source_len)),
                ast::field(
                    "imports",
                    if parser.imports.is_empty() {
                        ast::null()
                    } else {
                        ast::nodes(parser.imports)
                    },
                ),
                ast::field(
                    "comments",
                    if parser.comment_nodes.is_empty() {
                        ast::null()
                    } else {
                        ast::nodes(parser.comment_nodes)
                    },
                ),
                ast::field("go_version", ast::text_value(parser.go_version)),
            ],
        ),
    )
}

pub fn parse_file_bytes(source: bytes::Bytes) -> ParseResult {
    let parser = parser_new(source);
    let parsed = parse_file_node(parser);
    let root = if parser.comment_infos.is_empty() {
        parsed
    } else {
        attach_comments(parser, parsed, false)
    };
    result(parser, Option::Some(root))
}

pub fn parse_file_bytes_without_comments(source: bytes::Bytes) -> ParseResult {
    let parser = parser_new_with_mode(source, false, false);
    let root = parse_file_node(parser);
    result(parser, Option::Some(root))
}

pub fn parse_file_bytes_without_bodies(source: bytes::Bytes) -> ParseResult {
    let parser = parser_new_with_mode(source, false, true);
    let root = parse_file_node(parser);
    result(parser, Option::Some(root))
}

pub fn parse_file(source: string) -> ParseResult {
    parse_file_bytes(bytes::Bytes::from_string(source))
}

pub fn parse_expr_bytes(source: bytes::Bytes) -> ParseResult {
    let parser = parser_new(source);
    let root = parse_expression(parser);
    let _ = eat(parser, token::Kind::Semicolon);
    if !eof(parser) {
        report(parser, current(parser).start, "expected end of expression")
    }
    result(parser, Option::Some(root))
}

pub fn parse_expr(source: string) -> ParseResult {
    parse_expr_bytes(bytes::Bytes::from_string(source))
}
