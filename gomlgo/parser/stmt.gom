package parser;

use gomlgo::ast;
use gomlgo::token;

fn assignment_kind(kind: token::Kind) -> bool {
    token::equal(kind, token::Kind::Assign) || token::equal(kind, token::Kind::Define)
        || token::equal(kind, token::Kind::AddAssign)
        || token::equal(kind, token::Kind::SubAssign)
        || token::equal(kind, token::Kind::MulAssign)
        || token::equal(kind, token::Kind::QuoAssign)
        || token::equal(kind, token::Kind::RemAssign)
        || token::equal(kind, token::Kind::AndAssign)
        || token::equal(kind, token::Kind::OrAssign)
        || token::equal(kind, token::Kind::XorAssign)
        || token::equal(kind, token::Kind::ShlAssign)
        || token::equal(kind, token::Kind::ShrAssign)
        || token::equal(kind, token::Kind::AndNotAssign)
}

fn parse_simple_statement(parser: Parser) -> ast::Node {
    let left = parse_expression_list(parser);
    if let Some(arrow) = eat(parser, token::Kind::Arrow) {
        let value = parse_expression(parser);
        ast::typed_node(
            ast::Kind::SendStmt,
            left[0].span.start,
            value.span.end,
            ast::Fields::SendStmt { channel: left[0], arrow: arrow.start, value: value },
        )
    } else if at(parser, token::Kind::Inc) || at(parser, token::Kind::Dec) {
        let operator = advance(parser);
        ast::typed_node(
            ast::Kind::IncDecStmt,
            left[0].span.start,
            operator.end,
            ast::Fields::IncDecStmt {
                x: left[0],
                token_pos: operator.start,
                token: token::name((operator).kind),
            },
        )
    } else if assignment_kind(peek(parser)) {
        let operator = advance(parser);
        if at(parser, token::Kind::Range) {
            let range = advance(parser);
            let source = parse_expression(parser);
            if left.len() > 2 {
                report(parser, left[left.len() - 1].span.start, "expected at most 2 expressions")
            }
            ast::typed_node(
                ast::Kind::RangeStmt,
                left[0].span.start,
                source.span.end,
                ast::Fields::RangeStmt {
                    for_pos: -1,
                    key: Option::Some(left[0]),
                    value: if left.len() > 1 {
                        Option::Some(left[1])
                    } else {
                        Option::None
                    },
                    token_pos: operator.start,
                    token: token::name((operator).kind),
                    range_pos: range.start,
                    x: Option::Some(source),
                    body: Option::None,
                },
            )
        } else {
            let right = parse_expression_list(parser);
            let end = right[right.len() - 1].span.end;
            ast::typed_node(
                ast::Kind::AssignStmt,
                left[0].span.start,
                end,
                ast::Fields::AssignStmt {
                    lhs: left,
                    token_pos: operator.start,
                    token: token::name((operator).kind),
                    rhs: right,
                },
            )
        }
    } else if left.len() == 1 {
        expr_stmt_node(left[0])
    } else {
        report(parser, left[0].span.start, "expected one expression");
        bad_stmt(left[0].span.start, left[left.len() - 1].span.end)
    }
}

fn parse_statement_list(parser: Parser, stop_at_case: bool) -> Vec[ast::Node] {
    let statements: Vec[ast::Node] = Vec::new();
    while !at(parser, token::Kind::Rbrace) && !eof(parser)
        && !(stop_at_case && (at(parser, token::Kind::Case) || at(parser, token::Kind::Default))) {
        let before = cursor_position(parser);
        if at(parser, token::Kind::Semicolon) {
            let semicolon = advance(parser);
            if !semicolon.synthetic {
                statements.push(
                    ast::typed_node(
                        ast::Kind::EmptyStmt,
                        semicolon.start,
                        semicolon.end,
                        ast::Fields::EmptyStmt { semicolon: semicolon.start, implicit: false },
                    ),
                )
            }
        } else {
            let statement = parse_statement(parser);
            let internally_terminated = if ast::kind_equal(statement.kind, ast::Kind::LabeledStmt) {
                match ast::get_node(statement, "stmt") {
                    Some(value) => ast::kind_equal(value.kind, ast::Kind::EmptyStmt),
                    None => false,
                }
            } else {
                false
            };
            statements.push(statement);
            if eat(parser, token::Kind::Semicolon).is_some() || internally_terminated
                || at(parser, token::Kind::Rbrace)
                || (stop_at_case
                    && (at(parser, token::Kind::Case) || at(parser, token::Kind::Default))) {} else {
                report(parser, current(parser).start, "expected semicolon or newline")
            }
        }
        let _ = ensure_progress(parser, before, "statement list");
    }
    statements
}

fn parse_block_statement(parser: Parser) -> ast::Node {
    let left = expect(parser, token::Kind::Lbrace);
    let statements = parse_statement_list(parser, false);
    let right = expect(parser, token::Kind::Rbrace);
    block_node(left.start, statements, right.start)
}

fn skip_block_statement(parser: Parser) -> ast::Node {
    let left = expect(parser, token::Kind::Lbrace);
    let mut depth = 1;
    let mut right = -1;
    while depth > 0 && !eof(parser) {
        let value = advance(parser);
        if token::equal(value.kind, token::Kind::Lbrace) {
            depth += 1;
        } else if token::equal(value.kind, token::Kind::Rbrace) {
            depth -= 1;
            if depth == 0 {
                right = value.start;
            }
        }
    }
    if right < 0 {
        report(parser, current(parser).start, "expected '}', found 'EOF'")
    }
    block_node(left.start, Vec::new(), right)
}

fn unparenthesized_call_expression(value: ast::Node) -> ast::Node {
    if ast::kind_equal(value.kind, ast::Kind::ParenExpr) {
        match ast::get_node(value, "x") {
            Some(inner) => unparenthesized_call_expression(inner),
            None => value,
        }
    } else {
        value
    }
}

fn parse_go_or_defer(parser: Parser, deferred: bool) -> ast::Node {
    let keyword = advance(parser);
    let parsed_call = parse_expression(parser);
    let statement = if deferred {
        "defer"
    } else {
        "go"
    };
    let call = if ast::kind_equal(parsed_call.kind, ast::Kind::ParenExpr) {
        report(
            parser,
            parsed_call.span.start,
            "expression in " + statement + " must not be parenthesized",
        );
        unparenthesized_call_expression(parsed_call)
    } else {
        parsed_call
    };
    if !ast::kind_equal(call.kind, ast::Kind::CallExpr) {
        report(parser, call.span.end, "expression in " + statement + " must be function call")
    }
    ast::node(
        if deferred {
            ast::Kind::DeferStmt
        } else {
            ast::Kind::GoStmt
        },
        keyword.start,
        call.span.end,
        Vec::from_array(
            [
                ast::field(
                    if deferred {
                        "defer"
                    } else {
                        "go"
                    },
                    ast::int_value(keyword.start),
                ),
                ast::field("call", ast::node_value(call)),
            ],
        ),
    )
}

fn parse_return_statement(parser: Parser) -> ast::Node {
    let keyword = expect(parser, token::Kind::Return);
    let results = if at(parser, token::Kind::Semicolon) || at(parser, token::Kind::Rbrace)
        || eof(parser) {
        Vec::new()
    } else {
        parse_expression_list(parser)
    };
    let end = if results.is_empty() {
        keyword.end
    } else {
        results[results.len() - 1].span.end
    };
    ast::typed_node(
        ast::Kind::ReturnStmt,
        keyword.start,
        end,
        ast::Fields::ReturnStmt {
            return_pos: keyword.start,
            results: if results.is_empty() {
                Option::None
            } else {
                Option::Some(results)
            },
        },
    )
}

fn parse_branch_statement(parser: Parser) -> ast::Node {
    let keyword = advance(parser);
    let label = if at(parser, token::Kind::Ident) {
        Option::Some(parse_ident(parser))
    } else {
        Option::None
    };
    if token::equal(keyword.kind, token::Kind::Goto) && label.is_none() {
        report(parser, current(parser).start, "expected label after goto")
    }
    let end = match label {
        Some(value) => value.span.end,
        None => keyword.end,
    };
    ast::typed_node(
        ast::Kind::BranchStmt,
        keyword.start,
        end,
        ast::Fields::BranchStmt {
            token_pos: keyword.start,
            token: token::name((keyword).kind),
            label: label,
        },
    )
}

fn expression_from_statement(value: ast::Node) -> Option[ast::Node] {
    if ast::kind_equal(value.kind, ast::Kind::ExprStmt) {
        ast::get_node(value, "x")
    } else {
        Option::None
    }
}

fn parse_if_statement(parser: Parser) -> ast::Node {
    let keyword = expect(parser, token::Kind::If);
    let saved_level = parser.expr_level.get();
    parser.expr_level.set(-1);
    let missing_first = at(parser, token::Kind::Lbrace);
    let first = if missing_first {
        bad_stmt(current(parser).start, current(parser).start)
    } else {
        parse_simple_statement(parser)
    };
    let mut initialization: Option[ast::Node] = Option::None;
    let condition = if missing_first {
        report(parser, current(parser).start, "missing condition in if statement");
        bad_expr(current(parser).start, current(parser).start)
    } else {
        match eat(parser, token::Kind::Semicolon) {
            Some(separator) => {
                initialization = Option::Some(first);
                if at(parser, token::Kind::Lbrace) {
                    report(parser, separator.start, "missing condition in if statement");
                    bad_expr(current(parser).start, current(parser).start)
                } else {
                    parse_expression(parser)
                }
            },
            None => match expression_from_statement(first) {
                Some(value) => value,
                None => {
                    report(parser, first.span.start, "expected boolean expression");
                    bad_expr(first.span.start, first.span.end)
                },
            },
        }
    };
    parser.expr_level.set(saved_level);
    let body = parse_block_statement(parser);
    let alternative = if eat(parser, token::Kind::Else).is_some() {
        if at(parser, token::Kind::If) {
            Option::Some(parse_if_statement(parser))
        } else {
            Option::Some(parse_block_statement(parser))
        }
    } else {
        Option::None
    };
    let end = match alternative {
        Some(value) => value.span.end,
        None => body.span.end,
    };
    ast::typed_node(
        ast::Kind::IfStmt,
        keyword.start,
        end,
        ast::Fields::IfStmt {
            if_pos: keyword.start,
            init: initialization,
            cond: condition,
            body: body,
            else_node: alternative,
        },
    )
}

fn parse_case_clause(parser: Parser) -> ast::Node {
    let keyword = advance(parser);
    let expressions = if token::equal(keyword.kind, token::Kind::Case) {
        parse_expression_list(parser)
    } else {
        Vec::new()
    };
    let colon = expect(parser, token::Kind::Colon);
    let body = parse_statement_list(parser, true);
    let end = if body.is_empty() {
        colon.end
    } else {
        body[body.len() - 1].span.end
    };
    ast::typed_node(
        ast::Kind::CaseClause,
        keyword.start,
        end,
        ast::Fields::CaseClause {
            case_pos: keyword.start,
            list: if expressions.is_empty() {
                Option::None
            } else {
                Option::Some(expressions)
            },
            colon: colon.start,
            body: if body.is_empty() {
                Option::None
            } else {
                Option::Some(body)
            },
        },
    )
}

fn type_switch_assertion(value: ast::Node) -> bool {
    if !ast::kind_equal(value.kind, ast::Kind::TypeAssertExpr) {
        return false
    }
    let field = ast::get_field(value, "type");
    field.present
        && match field.value {
            ast::Value::Null => true,
            _ => false,
        }
}

fn is_type_switch_guard(value: ast::Node) -> bool {
    if let Some(expression) = expression_from_statement(value) {
        type_switch_assertion(expression)
    } else if ast::kind_equal(value.kind, ast::Kind::AssignStmt) {
        let right = ast::get_nodes(value, "rhs");
        right.len() == 1 && type_switch_assertion(right[0])
    } else {
        false
    }
}

fn parse_switch_statement(parser: Parser) -> ast::Node {
    let keyword = expect(parser, token::Kind::Switch);
    let saved_level = parser.expr_level.get();
    parser.expr_level.set(-1);
    let mut initialization: Option[ast::Node] = Option::None;
    let mut tag_or_guard: Option[ast::Node] = Option::None;
    if !at(parser, token::Kind::Lbrace) {
        let first = parse_simple_statement(parser);
        if eat(parser, token::Kind::Semicolon).is_some() {
            initialization = Option::Some(first);
            if !at(parser, token::Kind::Lbrace) {
                tag_or_guard = Option::Some(parse_simple_statement(parser));
            }
        } else {
            tag_or_guard = Option::Some(first);
        }
    }
    parser.expr_level.set(saved_level);
    let left = expect(parser, token::Kind::Lbrace);
    let clauses: Vec[ast::Node] = Vec::new();
    while !at(parser, token::Kind::Rbrace) && !eof(parser) {
        if at(parser, token::Kind::Case) || at(parser, token::Kind::Default) {
            clauses.push(parse_case_clause(parser))
        } else {
            report(parser, current(parser).start, "expected case or default");
            let _ = advance(parser);
        }
    }
    let right = expect(parser, token::Kind::Rbrace);
    let body = block_node(left.start, clauses, right.start);
    let type_switch = match tag_or_guard {
        Some(value) => is_type_switch_guard(value),
        None => false,
    };
    ast::node(
        if type_switch {
            ast::Kind::TypeSwitchStmt
        } else {
            ast::Kind::SwitchStmt
        },
        keyword.start,
        body.span.end,
        if type_switch {
            Vec::from_array(
                [
                    ast::field("switch", ast::int_value(keyword.start)),
                    ast::field("init", ast::optional_node(initialization)),
                    ast::field("assign", ast::optional_node(tag_or_guard)),
                    ast::field("body", ast::node_value(body)),
                ],
            )
        } else {
            let tag = tag_or_guard.and_then(|value| expression_from_statement(value));
            Vec::from_array(
                [
                    ast::field("switch", ast::int_value(keyword.start)),
                    ast::field("init", ast::optional_node(initialization)),
                    ast::field("tag", ast::optional_node(tag)),
                    ast::field("body", ast::node_value(body)),
                ],
            )
        },
    )
}

fn parse_comm_clause(parser: Parser) -> ast::Node {
    let keyword = advance(parser);
    let communication = if token::equal(keyword.kind, token::Kind::Default) {
        Option::None
    } else {
        Option::Some(parse_simple_statement(parser))
    };
    let colon = expect(parser, token::Kind::Colon);
    let body = parse_statement_list(parser, true);
    let end = if body.is_empty() {
        colon.end
    } else {
        body[body.len() - 1].span.end
    };
    ast::typed_node(
        ast::Kind::CommClause,
        keyword.start,
        end,
        ast::Fields::CommClause {
            case_pos: keyword.start,
            comm: communication,
            colon: colon.start,
            body: if body.is_empty() {
                Option::None
            } else {
                Option::Some(body)
            },
        },
    )
}

fn parse_select_statement(parser: Parser) -> ast::Node {
    let keyword = expect(parser, token::Kind::Select);
    let left = expect(parser, token::Kind::Lbrace);
    let clauses: Vec[ast::Node] = Vec::new();
    while !at(parser, token::Kind::Rbrace) && !eof(parser) {
        if at(parser, token::Kind::Case) || at(parser, token::Kind::Default) {
            clauses.push(parse_comm_clause(parser))
        } else {
            report(parser, current(parser).start, "expected case or default");
            let _ = advance(parser);
        }
    }
    let right = expect(parser, token::Kind::Rbrace);
    let body = block_node(left.start, clauses, right.start);
    ast::typed_node(
        ast::Kind::SelectStmt,
        keyword.start,
        body.span.end,
        ast::Fields::SelectStmt { select_pos: keyword.start, body: body },
    )
}

fn complete_range_statement(range_header: ast::Node, keyword: token::Token, body: ast::Node) -> ast::Node {
    let key = ast::get_node(range_header, "key");
    let value = ast::get_node(range_header, "value");
    let source = ast::get_node(range_header, "x");
    let token_position = match ast::get_field(range_header, "token_pos").value {
        ast::Value::Int(value) => value,
        _ => -1,
    };
    let assignment = match ast::get_field(range_header, "token").value {
        ast::Value::String(value) => value,
        _ => "ILLEGAL",
    };
    let range_position = match ast::get_field(range_header, "range").value {
        ast::Value::Int(value) => value,
        _ => keyword.end,
    };
    ast::typed_node(
        ast::Kind::RangeStmt,
        keyword.start,
        body.span.end,
        ast::Fields::RangeStmt {
            for_pos: keyword.start,
            key: key,
            value: value,
            token_pos: token_position,
            token: assignment,
            range_pos: range_position,
            x: source,
            body: Option::Some(body),
        },
    )
}

fn parse_for_statement(parser: Parser) -> ast::Node {
    let keyword = expect(parser, token::Kind::For);
    let saved_level = parser.expr_level.get();
    parser.expr_level.set(-1);
    let mut initialization: Option[ast::Node] = Option::None;
    let mut condition: Option[ast::Node] = Option::None;
    let mut post: Option[ast::Node] = Option::None;
    let mut range_header: Option[ast::Node] = Option::None;
    if at(parser, token::Kind::Range) {
        let range = advance(parser);
        let source = parse_expression(parser);
        range_header = Option::Some(
            ast::typed_node(
                ast::Kind::RangeStmt,
                keyword.start,
                source.span.end,
                ast::Fields::RangeStmt {
                    for_pos: keyword.start,
                    key: Option::None,
                    value: Option::None,
                    token_pos: -1,
                    token: "ILLEGAL",
                    range_pos: range.start,
                    x: Option::Some(source),
                    body: Option::None,
                },
            ),
        );
    } else if eat(parser, token::Kind::Semicolon).is_some() {
        if !at(parser, token::Kind::Semicolon) {
            condition = Option::Some(parse_expression(parser));
        }
        let _ = expect(parser, token::Kind::Semicolon);
        if !at(parser, token::Kind::Lbrace) {
            post = Option::Some(parse_simple_statement(parser));
        }
    } else if !at(parser, token::Kind::Lbrace) {
        let first = parse_simple_statement(parser);
        if ast::kind_equal(first.kind, ast::Kind::RangeStmt) {
            range_header = Option::Some(first);
        } else if eat(parser, token::Kind::Semicolon).is_some() {
            initialization = Option::Some(first);
            if !at(parser, token::Kind::Semicolon) {
                condition = Option::Some(parse_expression(parser));
            }
            let _ = expect(parser, token::Kind::Semicolon);
            if !at(parser, token::Kind::Lbrace) {
                post = Option::Some(parse_simple_statement(parser));
            }
        } else {
            condition = expression_from_statement(first);
        }
    }
    parser.expr_level.set(saved_level);
    let body = parse_block_statement(parser);
    match range_header {
        Some(header) => complete_range_statement(header, keyword, body),
        None => ast::typed_node(
            ast::Kind::ForStmt,
            keyword.start,
            body.span.end,
            ast::Fields::ForStmt {
                for_pos: keyword.start,
                init: initialization,
                cond: condition,
                post: post,
                body: body,
            },
        ),
    }
}

fn parse_labeled_or_simple(parser: Parser) -> ast::Node {
    if at(parser, token::Kind::Ident) && token::equal(nth(parser, 1).kind, token::Kind::Colon) {
        let label = parse_ident(parser);
        let colon = expect(parser, token::Kind::Colon);
        let statement = if at(parser, token::Kind::Semicolon) {
            let semicolon = advance(parser);
            ast::typed_node(
                ast::Kind::EmptyStmt,
                semicolon.start,
                if semicolon.synthetic {
                    semicolon.start
                } else {
                    semicolon.end
                },
                ast::Fields::EmptyStmt { semicolon: semicolon.start, implicit: semicolon.synthetic },
            )
        } else if at(parser, token::Kind::Rbrace) {
            let offset = current(parser).start;
            ast::typed_node(
                ast::Kind::EmptyStmt,
                offset,
                offset,
                ast::Fields::EmptyStmt { semicolon: offset, implicit: true },
            )
        } else {
            parse_statement(parser)
        };
        ast::typed_node(
            ast::Kind::LabeledStmt,
            label.span.start,
            statement.span.end,
            ast::Fields::LabeledStmt { label: label, colon: colon.start, stmt: statement },
        )
    } else {
        parse_simple_statement(parser)
    }
}

fn parse_statement(parser: Parser) -> ast::Node {
    if at(parser, token::Kind::Const) || at(parser, token::Kind::Type)
        || at(parser, token::Kind::Var) {
        let declaration = parse_general_declaration(parser);
        ast::typed_node(
            ast::Kind::DeclStmt,
            declaration.span.start,
            declaration.span.end,
            ast::Fields::DeclStmt { decl: declaration },
        )
    } else if at(parser, token::Kind::Lbrace) {
        parse_block_statement(parser)
    } else if at(parser, token::Kind::Go) {
        parse_go_or_defer(parser, false)
    } else if at(parser, token::Kind::Defer) {
        parse_go_or_defer(parser, true)
    } else if at(parser, token::Kind::Return) {
        parse_return_statement(parser)
    } else if at(parser, token::Kind::Break) || at(parser, token::Kind::Continue)
        || at(parser, token::Kind::Goto)
        || at(parser, token::Kind::Fallthrough) {
        parse_branch_statement(parser)
    } else if at(parser, token::Kind::If) {
        parse_if_statement(parser)
    } else if at(parser, token::Kind::Switch) {
        parse_switch_statement(parser)
    } else if at(parser, token::Kind::Select) {
        parse_select_statement(parser)
    } else if at(parser, token::Kind::For) {
        parse_for_statement(parser)
    } else if expression_first(peek(parser)) {
        parse_labeled_or_simple(parser)
    } else {
        let start = current(parser).start;
        report(parser, start, "expected statement");
        let consumed = advance(parser);
        bad_stmt(start, consumed.end)
    }
}
