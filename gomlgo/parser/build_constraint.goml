package parser;

use gomlgo::token;
use std::num;
use std::text;

struct BuildParser {
    input: string,
    index: Ref[isize],
    valid: Ref[bool],
}

fn build_space(value: byte) -> bool {
    value == b' ' || value == b'\t' || value == b'\r' || value == b'\n'
}

fn build_skip_space(parser: BuildParser) -> () {
    while parser.index.get() < parser.input.byte_len()
        && build_space(parser.input.byte_get(parser.index.get())) {
        parser.index.set(parser.index.get() + 1)
    }
}

fn build_consume(parser: BuildParser, value: string) -> bool {
    build_skip_space(parser);
    let start = parser.index.get();
    if start + value.byte_len() <= parser.input.byte_len()
        && parser.input.byte_slice(start, start + value.byte_len()) == value {
        parser.index.set(start + value.byte_len());
        true
    } else {
        false
    }
}

fn build_version_tag(value: string) -> isize {
    if value == "go1" {
        0
    } else if value.starts_with("go1.") && value.byte_len() > 4 {
        num::parse_int_structured(value.byte_slice(4, value.byte_len())).unwrap_or(-1)
    } else {
        -1
    }
}

fn build_read_tag(parser: BuildParser, sign: isize) -> isize {
    build_skip_space(parser);
    let start = parser.index.get();
    while parser.index.get() < parser.input.byte_len() {
        let value = parser.input.byte_get(parser.index.get());
        if build_space(value) || value == b'!' || value == b'&' || value == b'|' || value == b'('
            || value == b')' {
            break
        } else {
            parser.index.set(parser.index.get() + 1)
        }
    }
    if parser.index.get() == start {
        parser.valid.set(false);
        -1
    } else if sign < 0 {
        -1
    } else {
        build_version_tag(parser.input.byte_slice(start, parser.index.get()))
    }
}

fn build_max(left: isize, right: isize) -> isize {
    if left > right {
        left
    } else {
        right
    }
}

fn build_min(left: isize, right: isize) -> isize {
    if left < right {
        left
    } else {
        right
    }
}

fn build_parse_atom(parser: BuildParser, sign: isize) -> isize {
    if build_consume(parser, "!") {
        build_parse_atom(parser, -sign)
    } else if build_consume(parser, "(") {
        let value = build_parse_or(parser, sign);
        if !build_consume(parser, ")") {
            parser.valid.set(false)
        }
        value
    } else {
        build_read_tag(parser, sign)
    }
}

fn build_parse_and(parser: BuildParser, sign: isize) -> isize {
    let mut result = build_parse_atom(parser, sign);
    while build_consume(parser, "&&") {
        let right = build_parse_atom(parser, sign);
        result = if sign > 0 {
            build_max(result, right)
        } else {
            build_min(result, right)
        };
    }
    result
}

fn build_parse_or(parser: BuildParser, sign: isize) -> isize {
    let mut result = build_parse_and(parser, sign);
    while build_consume(parser, "||") {
        let right = build_parse_and(parser, sign);
        result = if sign > 0 {
            build_min(result, right)
        } else {
            build_max(result, right)
        };
    }
    result
}

fn build_constraint_version(value: string) -> string {
    if !value.starts_with("//go:build") {
        ""
    } else {
        let prefix_end = "//go:build".byte_len();
        if value.byte_len() > prefix_end && !build_space(value.byte_get(prefix_end)) {
            return ""
        }
        let expression = text::trim(value.byte_slice(prefix_end, value.byte_len()));
        let parser = BuildParser { input: expression, index: Ref::new(0), valid: Ref::new(true) };
        let version = build_parse_or(parser, 1);
        build_skip_space(parser);
        if !parser.valid.get() || parser.index.get() != parser.input.byte_len() {
            ""
        } else if version < 0 {
            ""
        } else if version == 0 {
            "go1"
        } else {
            f"go1.{version}"
        }
    }
}

fn token_metadata(tokens: Vec[token::Token]) -> (string, isize) {
    let mut result = "";
    let mut index = 0;
    while index < tokens.len() && token::equal(tokens[index].kind, token::Kind::Comment) {
        let version = build_constraint_version(tokens[index].literal);
        if version != "" {
            result = version;
        }
        index += 1;
    }
    let mut comment_limit = index;
    while index < tokens.len() {
        if token::equal(tokens[index].kind, token::Kind::Comment) {
            comment_limit = index + 1;
        }
        index += 1;
    };
    (result, comment_limit)
}
