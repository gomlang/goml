package parser;

use gomlgo::ast;
use gomlgo::token;

fn type_first(kind: token::Kind) -> bool {
    token::equal(kind, token::Kind::Ident) || token::equal(kind, token::Kind::Lbrack)
        || token::equal(kind, token::Kind::Struct)
        || token::equal(kind, token::Kind::Mul)
        || token::equal(kind, token::Kind::Func)
        || token::equal(kind, token::Kind::Interface)
        || token::equal(kind, token::Kind::Map)
        || token::equal(kind, token::Kind::Chan)
        || token::equal(kind, token::Kind::Arrow)
        || token::equal(kind, token::Kind::Lparen)
}

fn bracket_followed_by_type(parser: Parser) -> bool {
    if !at(parser, token::Kind::Lbrack) {
        false
    } else {
        let mut depth = 0;
        let mut distance = 0;
        while distance < CURSOR_FUEL {
            let kind = nth(parser, distance).kind;
            if token::equal(kind, token::Kind::Lbrack) {
                depth += 1;
            } else if token::equal(kind, token::Kind::Rbrack) {
                depth -= 1;
                if depth == 0 {
                    return type_first(nth(parser, distance + 1).kind)
                }
            } else if token::equal(kind, token::Kind::Eof) {
                return false
            }
            distance += 1;
        }
        false
    }
}

fn type_parameter_list_start(parser: Parser) -> bool {
    if !at(parser, token::Kind::Lbrack) || !token::equal(nth(parser, 1).kind, token::Kind::Ident) {
        false
    } else {
        let mut bracket_depth = 0;
        let mut paren_depth = 0;
        let mut brace_depth = 0;
        let mut distance = 0;
        while distance < CURSOR_FUEL {
            let scanned = nth(parser, distance).kind;
            if token::equal(scanned, token::Kind::Lbrack) {
                bracket_depth += 1;
            } else if token::equal(scanned, token::Kind::Rbrack) {
                bracket_depth -= 1;
                if bracket_depth == 0 {
                    break
                }
            } else if token::equal(scanned, token::Kind::Lparen) {
                paren_depth += 1;
            } else if token::equal(scanned, token::Kind::Rparen) {
                paren_depth -= 1;
            } else if token::equal(scanned, token::Kind::Lbrace) {
                brace_depth += 1;
            } else if token::equal(scanned, token::Kind::Rbrace) {
                brace_depth -= 1;
            } else if token::equal(scanned, token::Kind::Comma) && bracket_depth == 1
                && paren_depth == 0
                && brace_depth == 0 {
                return true
            } else if token::equal(scanned, token::Kind::Eof) {
                break
            }
            distance += 1;
        }
        let kind = nth(parser, 2).kind;
        let pointer_element = nth(parser, 3).kind;
        (type_first(kind) && !token::equal(kind, token::Kind::Mul)
            && !token::equal(kind, token::Kind::Lparen))
            || (token::equal(kind, token::Kind::Mul)
                && (token::equal(pointer_element, token::Kind::Lbrack)
                    || token::equal(pointer_element, token::Kind::Struct)
                    || token::equal(pointer_element, token::Kind::Func)
                    || token::equal(pointer_element, token::Kind::Interface)
                    || token::equal(pointer_element, token::Kind::Map)
                    || token::equal(pointer_element, token::Kind::Chan)
                    || token::equal(pointer_element, token::Kind::Arrow)))
            || token::equal(kind, token::Kind::Tilde)
            || token::equal(kind, token::Kind::Ellipsis)
            || token::equal(kind, token::Kind::Comma)
    }
}

fn parse_type_instance(parser: Parser, expression: ast::Node) -> ast::Node {
    let left = expect(parser, token::Kind::Lbrack);
    let arguments: Vec[ast::Node] = Vec::new();
    while !at(parser, token::Kind::Rbrack) && !eof(parser) {
        arguments.push(parse_type(parser));
        if eat(parser, token::Kind::Comma).is_none() {
            break
        }
        if at(parser, token::Kind::Rbrack) {
            break
        }
    }
    let right = expect(parser, token::Kind::Rbrack);
    if arguments.is_empty() {
        report(parser, right.start, "expected type argument list");
        arguments.push(bad_expr(right.start, right.start))
    }
    if arguments.len() == 1 {
        ast::typed_node(
            ast::Kind::IndexExpr,
            expression.span.start,
            right.end,
            ast::Fields::IndexExpr {
                x: expression,
                lbrack: left.start,
                index: arguments[0],
                rbrack: right.start,
            },
        )
    } else {
        ast::typed_node(
            ast::Kind::IndexListExpr,
            expression.span.start,
            right.end,
            ast::Fields::IndexListExpr {
                x: expression,
                lbrack: left.start,
                indices: arguments,
                rbrack: right.start,
            },
        )
    }
}

fn parse_named_type(parser: Parser) -> ast::Node {
    let mut result = parse_ident(parser);
    if at(parser, token::Kind::Period) {
        let _ = advance(parser);
        let selector = parse_ident(parser);
        result = ast::typed_node(
            ast::Kind::SelectorExpr,
            result.span.start,
            selector.span.end,
            ast::Fields::SelectorExpr { x: result, sel: selector },
        );
    }
    if at(parser, token::Kind::Lbrack) && !token::equal(nth(parser, 1).kind, token::Kind::Ellipsis)
        && !bracket_followed_by_type(parser) {
        result = parse_type_instance(parser, result);
    }
    result
}

fn parse_array_type(parser: Parser) -> ast::Node {
    let left = expect(parser, token::Kind::Lbrack);
    let length = if at(parser, token::Kind::Rbrack) {
        Option::None
    } else if let Some(ellipsis) = eat(parser, token::Kind::Ellipsis) {
        Option::Some(
            ast::typed_node(
                ast::Kind::Ellipsis,
                ellipsis.start,
                ellipsis.end,
                ast::Fields::Ellipsis { ellipsis: ellipsis.start, elt: Option::None },
            ),
        )
    } else {
        Option::Some(parse_expression(parser))
    };
    let _ = expect(parser, token::Kind::Rbrack);
    let element = parse_type(parser);
    ast::typed_node(
        ast::Kind::ArrayType,
        left.start,
        element.span.end,
        ast::Fields::ArrayType { lbrack: left.start, len: length, elt: element },
    )
}

fn parse_pointer_type(parser: Parser) -> ast::Node {
    let star = expect(parser, token::Kind::Mul);
    let element = parse_type(parser);
    ast::typed_node(
        ast::Kind::StarExpr,
        star.start,
        element.span.end,
        ast::Fields::StarExpr { star: star.start, x: element },
    )
}

fn named_parameter_group_start(parser: Parser, allow_ellipsis: bool) -> bool {
    if !at(parser, token::Kind::Ident) || !token::equal(nth(parser, 1).kind, token::Kind::Comma) {
        false
    } else {
        let mut distance = 0;
        let mut names = 0;
        while distance < CURSOR_FUEL && token::equal(nth(parser, distance).kind, token::Kind::Ident) {
            names += 1;
            if token::equal(nth(parser, distance + 1).kind, token::Kind::Comma)
                && token::equal(nth(parser, distance + 2).kind, token::Kind::Ident) {
                distance += 2;
            } else {
                let following = nth(parser, distance + 1).kind;
                let array_type = if token::equal(following, token::Kind::Lbrack) {
                    let mut bracket_depth = 0;
                    let mut bracket_distance = distance + 1;
                    let found = Ref::new(false);
                    while bracket_distance < CURSOR_FUEL {
                        let scanned = nth(parser, bracket_distance).kind;
                        if token::equal(scanned, token::Kind::Lbrack) {
                            bracket_depth += 1;
                        } else if token::equal(scanned, token::Kind::Rbrack) {
                            bracket_depth -= 1;
                            if bracket_depth == 0 {
                                found.set(type_first(nth(parser, bracket_distance + 1).kind));
                                break
                            }
                        } else if token::equal(scanned, token::Kind::Eof) {
                            break
                        }
                        bracket_distance += 1;
                    }
                    found.get()
                } else {
                    true
                };
                return names > 1
                    && ((type_first(following) && array_type)
                        || (allow_ellipsis && token::equal(following, token::Kind::Ellipsis)))
            }
        }
        false
    }
}

fn parse_parameter_field(parser: Parser, allow_ellipsis: bool) -> ast::Node {
    if allow_ellipsis && at(parser, token::Kind::Ellipsis) {
        let ellipsis = advance(parser);
        let element = parse_type(parser);
        let type_value = ast::typed_node(
            ast::Kind::Ellipsis,
            ellipsis.start,
            element.span.end,
            ast::Fields::Ellipsis { ellipsis: ellipsis.start, elt: Option::Some(element) },
        );
        return field_node(Vec::new(), Option::Some(type_value), Option::None)
    }
    if named_parameter_group_start(parser, allow_ellipsis) {
        let names: Vec[ast::Node] = Vec::from_array([parse_ident(parser)]);
        while eat(parser, token::Kind::Comma).is_some() {
            names.push(parse_ident(parser))
        }
        let type_value = if allow_ellipsis && at(parser, token::Kind::Ellipsis) {
            let ellipsis = advance(parser);
            let element = parse_type(parser);
            ast::typed_node(
                ast::Kind::Ellipsis,
                ellipsis.start,
                element.span.end,
                ast::Fields::Ellipsis { ellipsis: ellipsis.start, elt: Option::Some(element) },
            )
        } else {
            parse_type(parser)
        };
        return field_node(names, Option::Some(type_value), Option::None)
    }
    let first = parse_type(parser);
    if ast::kind_equal(first.kind, ast::Kind::Ident)
        && (type_first(peek(parser)) || (allow_ellipsis && at(parser, token::Kind::Ellipsis)))
        && !at(parser, token::Kind::Comma)
        && !at(parser, token::Kind::Rparen)
        && !at(parser, token::Kind::Rbrack) {
        let type_value = if allow_ellipsis && at(parser, token::Kind::Ellipsis) {
            let ellipsis = advance(parser);
            let element = parse_type(parser);
            ast::typed_node(
                ast::Kind::Ellipsis,
                ellipsis.start,
                element.span.end,
                ast::Fields::Ellipsis { ellipsis: ellipsis.start, elt: Option::Some(element) },
            )
        } else {
            parse_type(parser)
        };
        field_node(Vec::from_array([first]), Option::Some(type_value), Option::None)
    } else {
        field_node(Vec::new(), Option::Some(first), Option::None)
    }
}

fn parse_field_list(
    parser: Parser,
    opening_kind: token::Kind,
    closing_kind: token::Kind,
    ellipsis_allowed: bool,
) -> ast::Node {
    let opening = expect(parser, opening_kind);
    let fields: Vec[ast::Node] = Vec::new();
    while !at(parser, closing_kind) && !eof(parser) {
        let before = cursor_position(parser);
        fields.push(parse_parameter_field(parser, true));
        if eat(parser, token::Kind::Comma).is_some() {} else if at(parser, token::Kind::Semicolon) {
            report(parser, current(parser).start, "missing ',' in parameter list");
            let _ = advance(parser);
        } else if !at(parser, closing_kind) {
            report(parser, current(parser).start, "missing separator in field list")
        }
        let _ = ensure_progress(parser, before, "field list");
    }
    let recovered_fields: Vec[ast::Node] = Vec::new();
    let mut ellipsis_reported = false;
    for index in 0..fields.len() {
        let field = fields[index];
        match ast::get_node(field, "type") {
            Some(type_value) => if ast::kind_equal(type_value.kind, ast::Kind::Ellipsis) {
                let names = ast::get_nodes(field, "names");
                if !ellipsis_allowed || index + 1 < fields.len() || names.len() > 1 {
                    if !ellipsis_reported {
                        report(
                            parser,
                            type_value.span.start,
                            if ellipsis_allowed {
                                "can only use ... with final parameter"
                            } else {
                                "invalid use of ..."
                            },
                        );
                        ellipsis_reported = true;
                    }
                    if names.len() > 1 {
                        for name_index in 0..names.len() {
                            let recovered_type = if ellipsis_allowed && index + 1 == fields.len()
                                && name_index + 1 == names.len() {
                                type_value
                            } else {
                                bad_expr(type_value.span.start, type_value.span.end)
                            };
                            recovered_fields.push(
                                field_node(
                                    Vec::from_array([names[name_index]]),
                                    Option::Some(recovered_type),
                                    ast::get_node(field, "tag"),
                                ),
                            )
                        }
                    } else {
                        recovered_fields.push(
                            field_node(
                                names,
                                Option::Some(bad_expr(type_value.span.start, type_value.span.end)),
                                ast::get_node(field, "tag"),
                            ),
                        )
                    }
                } else {
                    recovered_fields.push(field)
                }
            } else {
                recovered_fields.push(field)
            },
            None => recovered_fields.push(field),
        };
    }
    fields.clear();
    for field in recovered_fields {
        fields.push(field)
    }
    let has_named = Ref::new(false);
    for field in fields {
        if !ast::get_nodes(field, "names").is_empty() {
            has_named.set(true)
        }
    }
    if has_named.get() {
        let mut index = fields.len();
        let mut grouped_names_follow = false;
        while index > 0 {
            index -= 1;
            let field = fields[index];
            if !ast::get_nodes(field, "names").is_empty() {
                grouped_names_follow = true;
            } else {
                let field_type = ast::get_node(field, "type");
                if grouped_names_follow
                    && match field_type {
                        Some(value) => ast::kind_equal(value.kind, ast::Kind::Ident),
                        None => false,
                    } {} else {
                    let offset = match field_type {
                        Some(value) => value.span.start,
                        None => field.span.start,
                    };
                    report(parser, offset, "missing parameter name or type");
                    grouped_names_follow = false;
                }
            }
        }
    }
    let closing = expect(parser, closing_kind);
    field_list_node(opening.start, fields, closing.start)
}

fn parse_type_parameters(parser: Parser) -> Option[ast::Node] {
    if at(parser, token::Kind::Lbrack) {
        let opening = expect(parser, token::Kind::Lbrack);
        let fields: Vec[ast::Node] = Vec::new();
        while !at(parser, token::Kind::Rbrack) && !eof(parser) {
            let before = cursor_position(parser);
            let names: Vec[ast::Node] = Vec::from_array([parse_ident(parser)]);
            while at(parser, token::Kind::Comma)
                && token::equal(nth(parser, 1).kind, token::Kind::Ident) {
                let _ = advance(parser);
                names.push(parse_ident(parser))
            }
            let constraint = if at(parser, token::Kind::Ellipsis) {
                let ellipsis = advance(parser);
                let element = parse_type(parser);
                report(parser, ellipsis.start, "invalid use of ...");
                Option::Some(bad_expr(ellipsis.start, element.span.end))
            } else if at(parser, token::Kind::Tilde) || type_first(peek(parser)) {
                Option::Some(parse_interface_term(parser))
            } else {
                report(parser, current(parser).start, "missing type constraint");
                Option::None
            };
            fields.push(field_node(names, constraint, Option::None));
            if eat(parser, token::Kind::Comma).is_some() {} else {
                break
            }
            let _ = ensure_progress(parser, before, "type parameter list");
        }
        let closing = expect(parser, token::Kind::Rbrack);
        if fields.is_empty() {
            report(parser, closing.start, "empty type parameter list")
        }
        Option::Some(field_list_node(opening.start, fields, closing.start))
    } else {
        Option::None
    }
}

fn parse_parameters(parser: Parser, result: bool) -> ast::Node {
    parse_field_list(parser, token::Kind::Lparen, token::Kind::Rparen, !result)
}

fn parse_func_type_after_keyword(parser: Parser, function_position: isize) -> ast::Node {
    let type_parameters = parse_type_parameters(parser);
    let parameters = parse_parameters(parser, false);
    let results = if at(parser, token::Kind::Lparen) {
        Option::Some(parse_parameters(parser, true))
    } else if type_first(peek(parser)) {
        let result_type = parse_type(parser);
        Option::Some(
            field_list_node(
                -1,
                Vec::from_array([field_node(Vec::new(), Option::Some(result_type), Option::None)]),
                -1,
            ),
        )
    } else {
        Option::None
    };
    let end = match results {
        Some(value) => value.span.end,
        None => parameters.span.end,
    };
    ast::typed_node(
        ast::Kind::FuncType,
        if function_position >= 0 {
            function_position
        } else {
            parameters.span.start
        },
        end,
        ast::Fields::FuncType {
            func_pos: function_position,
            type_params: type_parameters,
            params: parameters,
            results: results,
        },
    )
}

fn parse_func_type(parser: Parser) -> ast::Node {
    let function = expect(parser, token::Kind::Func);
    parse_func_type_after_keyword(parser, function.start)
}

fn parse_struct_field(parser: Parser) -> ast::Node {
    let names: Vec[ast::Node] = Vec::new();
    let mut type_value: Option[ast::Node] = Option::None;
    if at(parser, token::Kind::Mul) {
        type_value = Option::Some(parse_pointer_type(parser));
    } else if at(parser, token::Kind::Lparen) {
        type_value = Option::Some(parse_type(parser));
    } else {
        let first = parse_named_type(parser);
        if at(parser, token::Kind::Comma) {
            names.push(first);
            while eat(parser, token::Kind::Comma).is_some() {
                names.push(parse_ident(parser))
            }
            type_value = Option::Some(parse_type(parser));
        } else if type_first(peek(parser)) {
            names.push(first);
            type_value = Option::Some(parse_type(parser));
        } else {
            type_value = Option::Some(first);
        }
    }
    let tag = if literal_first(peek(parser)) && at(parser, token::Kind::String) {
        Option::Some(basic_lit_node(advance(parser)))
    } else {
        Option::None
    };
    field_node(names, type_value, tag)
}

fn parse_struct_type(parser: Parser) -> ast::Node {
    let keyword = expect(parser, token::Kind::Struct);
    let left = expect(parser, token::Kind::Lbrace);
    let fields: Vec[ast::Node] = Vec::new();
    let mut incomplete = false;
    while !at(parser, token::Kind::Rbrace) && !eof(parser) {
        let before = cursor_position(parser);
        if at(parser, token::Kind::Ident) || at(parser, token::Kind::Mul)
            || at(parser, token::Kind::Lparen) {
            fields.push(parse_struct_field(parser));
            consume_semicolon(parser)
        } else {
            report(parser, current(parser).start, "expected field declaration");
            incomplete = true;
            recover_until(parser, Vec::from_array([token::Kind::Semicolon, token::Kind::Rbrace]));
            let _ = eat(parser, token::Kind::Semicolon);
        }
        let _ = ensure_progress(parser, before, "struct fields");
    }
    let right = expect(parser, token::Kind::Rbrace);
    let field_list = field_list_node(left.start, fields, right.start);
    ast::typed_node(
        ast::Kind::StructType,
        keyword.start,
        right.end,
        ast::Fields::StructType {
            struct_pos: keyword.start,
            fields: field_list,
            incomplete: incomplete,
        },
    )
}

fn parse_interface_term(parser: Parser) -> ast::Node {
    let mut left = if let Some(tilde) = eat(parser, token::Kind::Tilde) {
        let operand = parse_type(parser);
        ast::typed_node(
            ast::Kind::UnaryExpr,
            tilde.start,
            operand.span.end,
            ast::Fields::UnaryExpr { op_pos: tilde.start, op: "~", x: operand },
        )
    } else {
        parse_type(parser)
    };
    while let Some(operator) = eat(parser, token::Kind::Or) {
        let right = if let Some(tilde) = eat(parser, token::Kind::Tilde) {
            let operand = parse_type(parser);
            ast::typed_node(
                ast::Kind::UnaryExpr,
                tilde.start,
                operand.span.end,
                ast::Fields::UnaryExpr { op_pos: tilde.start, op: "~", x: operand },
            )
        } else {
            parse_type(parser)
        };
        left = ast::typed_node(
            ast::Kind::BinaryExpr,
            left.span.start,
            right.span.end,
            ast::Fields::BinaryExpr { x: left, op_pos: operator.start, op: "|", y: right },
        );
    }
    left
}

fn interface_method_type_parameters(parser: Parser) -> bool {
    if !at(parser, token::Kind::Ident) || !token::equal(nth(parser, 1).kind, token::Kind::Lbrack) {
        return false
    }
    let mut depth = 0;
    let mut distance = 1;
    while distance < CURSOR_FUEL {
        let kind = nth(parser, distance).kind;
        if token::equal(kind, token::Kind::Lbrack) {
            depth += 1;
        } else if token::equal(kind, token::Kind::Rbrack) {
            depth -= 1;
            if depth == 0 {
                return token::equal(nth(parser, distance + 1).kind, token::Kind::Lparen)
            }
        } else if token::equal(kind, token::Kind::Eof) {
            return false
        }
        distance += 1;
    }
    false
}

fn parse_interface_type(parser: Parser) -> ast::Node {
    let keyword = expect(parser, token::Kind::Interface);
    let left = expect(parser, token::Kind::Lbrace);
    let methods: Vec[ast::Node] = Vec::new();
    let mut incomplete = false;
    while !at(parser, token::Kind::Rbrace) && !eof(parser) {
        let before = cursor_position(parser);
        if at(parser, token::Kind::Ident)
            && (token::equal(nth(parser, 1).kind, token::Kind::Lparen)
                || interface_method_type_parameters(parser)) {
            let name = parse_ident(parser);
            if at(parser, token::Kind::Lbrack) {
                report(
                    parser,
                    current(parser).start,
                    "interface method must have no type parameters",
                )
            }
            let signature = parse_func_type_after_keyword(parser, -1);
            methods.push(field_node(Vec::from_array([name]), Option::Some(signature), Option::None))
        } else if at(parser, token::Kind::Tilde) || type_first(peek(parser)) {
            methods.push(
                field_node(Vec::new(), Option::Some(parse_interface_term(parser)), Option::None),
            )
        } else {
            report(parser, current(parser).start, "expected interface method or type term");
            incomplete = true;
            let _ = advance(parser);
        }
        consume_semicolon(parser);
        let _ = ensure_progress(parser, before, "interface methods");
    }
    let right = expect(parser, token::Kind::Rbrace);
    let field_list = field_list_node(left.start, methods, right.start);
    ast::typed_node(
        ast::Kind::InterfaceType,
        keyword.start,
        right.end,
        ast::Fields::InterfaceType {
            interface_pos: keyword.start,
            methods: field_list,
            incomplete: incomplete,
        },
    )
}

fn parse_map_type(parser: Parser) -> ast::Node {
    let keyword = expect(parser, token::Kind::Map);
    let _ = expect(parser, token::Kind::Lbrack);
    let key = parse_type(parser);
    let _ = expect(parser, token::Kind::Rbrack);
    let value = parse_type(parser);
    ast::typed_node(
        ast::Kind::MapType,
        keyword.start,
        value.span.end,
        ast::Fields::MapType { map_pos: keyword.start, key: key, value: value },
    )
}

fn parse_chan_type(parser: Parser) -> ast::Node {
    let start = current(parser).start;
    let mut arrow = -1;
    let mut direction = 3;
    if let Some(receive) = eat(parser, token::Kind::Arrow) {
        arrow = receive.start;
        direction = 2;
        let _ = expect(parser, token::Kind::Chan);
    } else {
        let _ = expect(parser, token::Kind::Chan);
        if let Some(send) = eat(parser, token::Kind::Arrow) {
            arrow = send.start;
            direction = 1;
        }
    }
    let value = parse_type(parser);
    ast::typed_node(
        ast::Kind::ChanType,
        start,
        value.span.end,
        ast::Fields::ChanType { begin: start, arrow: arrow, dir: direction, value: value },
    )
}

fn parse_parenthesized_type(parser: Parser) -> ast::Node {
    let left = expect(parser, token::Kind::Lparen);
    let type_value = parse_type(parser);
    let right = expect(parser, token::Kind::Rparen);
    ast::typed_node(
        ast::Kind::ParenExpr,
        left.start,
        right.end,
        ast::Fields::ParenExpr { lparen: left.start, x: type_value, rparen: right.start },
    )
}

fn parse_type(parser: Parser) -> ast::Node {
    if at(parser, token::Kind::Ident) {
        parse_named_type(parser)
    } else if at(parser, token::Kind::Lbrack) {
        parse_array_type(parser)
    } else if at(parser, token::Kind::Struct) {
        parse_struct_type(parser)
    } else if at(parser, token::Kind::Mul) {
        parse_pointer_type(parser)
    } else if at(parser, token::Kind::Func) {
        parse_func_type(parser)
    } else if at(parser, token::Kind::Interface) {
        parse_interface_type(parser)
    } else if at(parser, token::Kind::Map) {
        parse_map_type(parser)
    } else if at(parser, token::Kind::Chan) || at(parser, token::Kind::Arrow) {
        parse_chan_type(parser)
    } else if at(parser, token::Kind::Lparen) {
        parse_parenthesized_type(parser)
    } else {
        let found = current(parser);
        let start = found.start;
        let message = if token::equal(found.kind, token::Kind::Int)
            || token::equal(found.kind, token::Kind::Float)
            || token::equal(found.kind, token::Kind::Imag)
            || token::equal(found.kind, token::Kind::Char)
            || token::equal(found.kind, token::Kind::String) {
            "expected type, found " + found.literal
        } else {
            "expected type, found '" + token::name(found.kind) + "'"
        };
        report(parser, start, message);
        if !eof(parser) {
            let consumed = advance(parser);
            let mut end = consumed.end;
            if token::equal(found.kind, token::Kind::Lbrace) {
                recover_until(
                    parser,
                    Vec::from_array([token::Kind::Semicolon, token::Kind::Rbrace, token::Kind::Eof]),
                );
                end = current(parser).start;
            }
            bad_expr(start, end)
        } else {
            bad_expr(start, start)
        }
    }
}
