package mutation;

use gomlgo::ast;
use gomlgo::differential;
use gomlgo::parser;
use gomlgo::scanner;
use gomlgo::token;
use std::bytes;
use std::collections;
use std::fs;
use std::json;
use std::path;

pub struct Summary {
    pub seeds: isize,
    pub cases: isize,
    pub failures: isize,
}

fn collect_go_files(directory: string, files: Vec[string]) -> Result[(), string] {
    let names = fs::read_dir(directory).map_err(|error| error.to_string())?;
    collections::sort(names);
    for name in names {
        let entry = path::join(directory, name);
        if fs::is_dir(entry) {
            collect_go_files(entry, files)?
        } else if fs::is_file(entry) && path::extension(entry) == Option::Some("go") {
            files.push(entry)
        }
    }
    Result::Ok(())
}

fn copy_bytes(value: bytes::Bytes) -> bytes::Bytes {
    let result = bytes::Bytes::with_capacity(value.len());
    for index in 0..value.len() {
        result.push(value.get(index))
    }
    result
}

fn delete_range(value: bytes::Bytes, start: isize, end: isize) -> bytes::Bytes {
    let result = bytes::Bytes::with_capacity(value.len() - (end - start));
    for index in 0..value.len() {
        if index < start || index >= end {
            result.push(value.get(index))
        }
    }
    result
}

fn slice_bytes(value: bytes::Bytes, start: isize, end: isize) -> bytes::Bytes {
    let result = bytes::Bytes::with_capacity(end - start);
    for index in start..end {
        result.push(value.get(index))
    }
    result
}

fn insert_bytes(value: bytes::Bytes, offset: isize, inserted: bytes::Bytes) -> bytes::Bytes {
    let result = bytes::Bytes::with_capacity(value.len() + inserted.len());
    for index in 0..offset {
        result.push(value.get(index))
    }
    for index in 0..inserted.len() {
        result.push(inserted.get(index))
    }
    for index in offset..value.len() {
        result.push(value.get(index))
    }
    result
}

fn middle_token(source: bytes::Bytes) -> Option[token::Token] {
    let tokens = scanner::scan_bytes(source).tokens;
    let target = source.len() / 2;
    for value in tokens {
        if value.start >= target && !token::equal(value.kind, token::Kind::Eof)
            && !token::equal(value.kind, token::Kind::Comment)
            && !token::equal(value.kind, token::Kind::Semicolon) {
            return Option::Some(value)
        }
    }
    Option::None
}

fn last_token_of_kind(source: bytes::Bytes, kind: token::Kind) -> Option[token::Token] {
    let tokens = scanner::scan_bytes(source).tokens;
    let mut index = tokens.len();
    while index > 0 {
        index -= 1;
        if token::equal(tokens[index].kind, kind) {
            return Option::Some(tokens[index])
        }
    }
    Option::None
}

fn first_string_token(source: bytes::Bytes) -> Option[token::Token] {
    for value in scanner::scan_bytes(source).tokens {
        if token::equal(value.kind, token::Kind::String)
            || token::equal(value.kind, token::Kind::Char) {
            return Option::Some(value)
        }
    }
    Option::None
}

fn mutations(source: bytes::Bytes) -> Vec[bytes::Bytes] {
    let result: Vec[bytes::Bytes] = Vec::new();
    if !source.is_empty() {
        let half = copy_bytes(source);
        half.truncate(source.len() / 2);
        result.push(half);
        let tail = copy_bytes(source);
        tail.truncate(source.len() - 1);
        result.push(tail)
    }
    if let Some(value) = middle_token(source) {
        result.push(delete_range(source, value.start, value.end));
        result.push(insert_bytes(source, value.start, slice_bytes(source, value.start, value.end)));
        result.push(insert_bytes(source, value.start, bytes::Bytes::from_string(";")));
        result.push(insert_bytes(source, value.start, bytes::Bytes::from_string("\n")));
        result.push(
            insert_bytes(
                source,
                value.start,
                bytes::Bytes::from_vec(Vec::from_array([255.to_u8()])),
            ),
        )
    }
    if let Some(value) = last_token_of_kind(source, token::Kind::Rbrace) {
        result.push(delete_range(source, value.start, value.end))
    }
    if let Some(value) = last_token_of_kind(source, token::Kind::Rparen) {
        result.push(delete_range(source, value.start, value.end))
    }
    if let Some(value) = last_token_of_kind(source, token::Kind::Rbrack) {
        result.push(delete_range(source, value.start, value.end))
    }
    if let Some(value) = first_string_token(source) {
        if value.end > value.start {
            result.push(delete_range(source, value.end - 1, value.end))
        }
    }
    result
}

fn actual_json(value: parser::ParseResult) -> string {
    let diagnostics: Vec[json::Value] = Vec::new();
    for item in value.diagnostics {
        diagnostics.push(
            json::Value::Object(
                Vec::from_array(
                    [
                        ("message", json::Value::String(item.message)),
                        ("offset", json::Value::Number(item.offset.to_string())),
                    ],
                ),
            ),
        )
    }
    json::encode(
        json::Value::Object(
            Vec::from_array(
                [
                    ("ok", json::Value::Bool(value.diagnostics.is_empty())),
                    (
                        "ast",
                        match value.root {
                            Some(root) => ast::to_json(root),
                            None => json::Value::Null,
                        },
                    ),
                    ("diagnostics", json::Value::Array(diagnostics)),
                ],
            ),
        ),
    )
}

fn oracle_json(value: differential::OracleResponse) -> string {
    let diagnostics: Vec[json::Value] = Vec::new();
    for item in value.diagnostics {
        diagnostics.push(
            json::Value::Object(
                Vec::from_array(
                    [
                        ("message", json::Value::String(item.message)),
                        ("offset", json::Value::Number(item.offset.to_string())),
                    ],
                ),
            ),
        )
    }
    json::encode(
        json::Value::Object(
            Vec::from_array(
                [
                    ("ok", json::Value::Bool(value.ok)),
                    ("ast", value.ast),
                    ("diagnostics", json::Value::Array(diagnostics)),
                ],
            ),
        ),
    )
}

fn first_actual_offset(value: parser::ParseResult) -> isize {
    if value.diagnostics.is_empty() {
        -1
    } else {
        value.diagnostics[0].offset
    }
}

fn first_oracle_offset(value: differential::OracleResponse) -> isize {
    if value.diagnostics.is_empty() {
        -1
    } else {
        value.diagnostics[0].offset
    }
}

fn input_hash(value: bytes::Bytes) -> string {
    let mut result = 0x811c9dc5.to_usize();
    for index in 0..value.len() {
        result = (result ^ value.get(index).to_usize()) * 0x01000193.to_usize();
    }
    result.to_string()
}

fn save_failure(
    output: string,
    input: bytes::Bytes,
    actual: parser::ParseResult,
    expected: differential::OracleResponse,
    message: string,
) -> Result[(), string] {
    let directory = path::join(output, input_hash(input));
    fs::create_dir_all(directory).map_err(|error| error.to_string())?;
    fs::write_bytes_structured(path::join(directory, "input.go"), input).map_err(
        |error| error.to_string(),
    )?;
    fs::write_file_structured(path::join(directory, "gomlgo.json"), actual_json(actual)).map_err(
        |error| error.to_string(),
    )?;
    fs::write_file_structured(path::join(directory, "oracle.json"), oracle_json(expected)).map_err(
        |error| error.to_string(),
    )?;
    fs::write_file_structured(path::join(directory, "diff.txt"), message).map_err(
        |error| error.to_string(),
    )
}

pub fn run(root: string, output: string, seed_limit: isize) -> Result[Summary, string] {
    let files: Vec[string] = Vec::new();
    if fs::is_file(root) {
        files.push(root)
    } else {
        collect_go_files(root, files)?
    }
    let mut seeds = 0;
    let mut cases = 0;
    let mut failures = 0;
    for file in files {
        if seeds < seed_limit {
            let source = fs::read_bytes_structured(file).map_err(|error| error.to_string())?;
            let seed = differential::run_oracle("parse-file", source)?;
            if seed.ok {
                seeds += 1;
                for input in mutations(source) {
                    cases += 1;
                    let actual = parser::parse_file_bytes(input);
                    let expected = differential::run_oracle("parse-file", input)?;
                    let actual_ok = actual.diagnostics.is_empty();
                    let offset_mismatch = !actual_ok && !expected.ok
                        && first_actual_offset(actual) != first_oracle_offset(expected);
                    if actual_ok != expected.ok || offset_mismatch {
                        failures += 1;
                        let message = f"seed={file}\nactual_ok={actual_ok}\nexpected_ok={expected.ok}\nactual_first_offset={first_actual_offset(actual)}\nexpected_first_offset={first_oracle_offset(expected)}";
                        save_failure(output, input, actual, expected, message)?
                    }
                }
            }
        }
    }
    Result::Ok(Summary { seeds, cases, failures })
}
