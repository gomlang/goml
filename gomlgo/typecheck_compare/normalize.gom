package typecheck_compare;

use gomlgo::checker;
use gomlgo::syntax;
use gomlgo::types as go_types;
use std::collections;
use std::json;

pub struct NormalizedResult {
    pub universe_scope: Vec[json::Value],
    pub unsafe_scope: Vec[json::Value],
    pub package_scope: Vec[json::Value],
    pub types: Vec[json::Value],
    pub defs: Vec[json::Value],
    pub uses: Vec[json::Value],
    pub implicits: Vec[json::Value],
    pub selections: Vec[json::Value],
    pub scopes: Vec[json::Value],
    pub instances: Vec[json::Value],
    pub init_order: Vec[json::Value],
    pub file_versions: Vec[json::Value],
}

fn string_value(value: string) -> json::Value {
    json::Value::String(value)
}

fn number_value(value: isize) -> json::Value {
    json::Value::Number(value.to_string())
}

fn number64_value(value: i64) -> json::Value {
    json::Value::Number(value.to_string())
}

fn bool_value(value: bool) -> json::Value {
    json::Value::Bool(value)
}

fn array_value(values: Vec[json::Value]) -> json::Value {
    json::Value::Array(values)
}

fn object_value(values: Vec[(string, json::Value)]) -> json::Value {
    json::Value::Object(values)
}

fn package_path(world: go_types::World, owner: Option[go_types::PackageId]) -> string {
    match owner {
        Some(id) => match go_types::get_package(world, id) {
            Some(value) => value.path,
            None => "",
        },
        None => "",
    }
}

fn file_name(value: checker::CheckResult, file: Option[syntax::FileId]) -> string {
    match file {
        Some(id) => if id.value >= 0 && id.value < value.syntax.files.len() {
            value.syntax.files[id.value].name
        } else {
            ""
        },
        None => "",
    }
}

fn object_position(value: checker::CheckResult, object: go_types::Object) -> (string, isize) {
    if object.position < 0 {
        ("", -1)
    } else if package_path(value.world, object.owner)
        != package_path(value.world, Option::Some(value.package_id)) {
        ("<import>", -1)
    } else {
        (file_name(value, object.file), object.position)
    }
}

fn object_key(value: checker::CheckResult, object: go_types::Object) -> string {
    let position = object_position(value, object);
    package_path(value.world, object.owner) + "|" + go_types::object_kind_name(object.kind)
        + f"|{object.name}|{position.0}|{position.1}"
}

fn normalize_constant(kind: string, exact: Option[string]) -> json::Value {
    match exact {
        Some(value) => object_value(
            Vec::from_array([("kind", string_value(kind)), ("exact", string_value(value))]),
        ),
        None => json::Value::Null,
    }
}

fn empty_type(kind: string, text: string) -> Vec[(string, json::Value)] {
    Vec::from_array(
        [
            ("kind", string_value(kind)),
            ("name", string_value("")),
            ("declaration", string_value("")),
            ("text", string_value(text)),
            ("length", number_value(0)),
            ("direction", string_value("")),
            ("variadic", bool_value(false)),
            ("comparable", bool_value(false)),
            ("implicit", bool_value(false)),
            ("elem", json::Value::Null),
            ("key", json::Value::Null),
            ("receiver", json::Value::Null),
            ("fields", array_value(Vec::new())),
            ("parameters", array_value(Vec::new())),
            ("results", array_value(Vec::new())),
            ("methods", array_value(Vec::new())),
            ("embeddeds", array_value(Vec::new())),
            ("terms", array_value(Vec::new())),
            ("type_parameters", array_value(Vec::new())),
            ("receiver_parameters", array_value(Vec::new())),
            ("type_arguments", array_value(Vec::new())),
        ],
    )
}

fn set_field(fields: Vec[(string, json::Value)], name: string, value: json::Value) -> () {
    for index in 0..fields.len() {
        if fields[index].0 == name {
            fields[index] = (name, value);
            return
        }
    }
}

fn replace_json_field(value: json::Value, name: string, replacement: json::Value) -> json::Value {
    match value {
        json::Value::Object(fields) => {
            set_field(fields, name, replacement);
            json::Value::Object(fields)
        },
        other => other,
    }
}

fn contains_type(values: Vec[isize], value: isize) -> bool {
    for item in values {
        if item == value {
            return true
        }
    }
    false
}

fn contains_named_origin(world: go_types::World, values: Vec[isize], value: go_types::TypeId) -> bool {
    let object = match go_types::get_type(world, value) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object,
                underlying: _,
                type_params: _,
                type_args: _,
                methods: _,
            },
        }) => object,
        _ => return false,
    };
    for active in values {
        match go_types::get_type(world, go_types::type_id(active)) {
            Some(go_types::TypeData {
                id: _,
                kind: go_types::TypeKind::Named {
                    object: active_object,
                    underlying: _,
                    type_params: _,
                    type_args: _,
                    methods: _,
                },
            }) => if active_object.value == object.value {
                return true
            },
            _ => {},
        }
    }
    false
}

fn normalize_variable(value: checker::CheckResult, variable: go_types::Variable, active: Vec[isize]) -> json::Value {
    object_value(
        Vec::from_array(
            [
                ("name", string_value(variable.name)),
                ("package", string_value(package_path(value.world, variable.owner))),
                ("type", normalize_type_inner(value, variable.type_id, active)),
            ],
        ),
    )
}

fn normalize_type_parameters(
    value: checker::CheckResult,
    parameters: Vec[go_types::TypeParameter],
    active: Vec[isize],
) -> Vec[json::Value] {
    let result: Vec[json::Value] = Vec::new();
    for parameter in parameters {
        match go_types::get_object(value.world, parameter.object) {
            Some(object) => result.push(
                object_value(
                    Vec::from_array(
                        [
                            ("name", string_value(object.name)),
                            ("declaration", string_value(object_key(value, object))),
                            (
                                "constraint",
                                normalize_type_inner(value, parameter.constraint, active),
                            ),
                        ],
                    ),
                ),
            ),
            None => {},
        }
    }
    result
}

fn normalize_type_reference(value: checker::CheckResult, id: go_types::TypeId) -> json::Value {
    let fields = empty_type("Invalid", go_types::format_type(value.world, id));
    match go_types::get_type(value.world, id) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Named {
                object,
                underlying: _,
                type_params: _,
                type_args: _,
                methods: _,
            },
        }) => match go_types::get_object(value.world, object) {
            Some(object) => {
                set_field(fields, "kind", string_value("Named"));
                set_field(fields, "name", string_value(object.name));
                set_field(fields, "declaration", string_value(object_key(value, object)))
            },
            None => {},
        },
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Alias { object, rhs: _, type_params: _, type_args: _ },
        }) => match go_types::get_object(value.world, object) {
            Some(object) => {
                set_field(fields, "kind", string_value("Alias"));
                set_field(fields, "name", string_value(object.name));
                set_field(fields, "declaration", string_value(object_key(value, object)))
            },
            None => {},
        },
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::TypeParam { object, constraint: _, index: _ },
        }) => match go_types::get_object(value.world, object) {
            Some(object) => {
                set_field(fields, "kind", string_value("TypeParam"));
                set_field(fields, "name", string_value(object.name));
                set_field(fields, "declaration", string_value(object_key(value, object)))
            },
            None => {},
        },
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Basic { basic: _, name: _, untyped: _ },
        }) => set_field(fields, "kind", string_value("*types.Basic")),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Array { length: _, element: _ } }) => set_field(
            fields,
            "kind",
            string_value("*types.Array"),
        ),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Slice { element: _ } }) => set_field(
            fields,
            "kind",
            string_value("*types.Slice"),
        ),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Struct { fields: _ } }) => set_field(
            fields,
            "kind",
            string_value("*types.Struct"),
        ),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element: _ } }) => set_field(
            fields,
            "kind",
            string_value("*types.Pointer"),
        ),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Tuple { variables: _ } }) => set_field(
            fields,
            "kind",
            string_value("*types.Tuple"),
        ),
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: _,
                receiver_type_params: _,
                type_params: _,
                params: _,
                results: _,
                variadic: _,
            },
        }) => set_field(fields, "kind", string_value("*types.Signature")),
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Interface {
                methods: _,
                embeddeds: _,
                comparable: _,
                implicit: _,
            },
        }) => set_field(fields, "kind", string_value("*types.Interface")),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Map { key: _, value: _ } }) => set_field(
            fields,
            "kind",
            string_value("*types.Map"),
        ),
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Chan { direction: _, element: _ },
        }) => set_field(fields, "kind", string_value("*types.Chan")),
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Union { terms: _ } }) => set_field(
            fields,
            "kind",
            string_value("*types.Union"),
        ),
        _ => {},
    }
    object_value(fields)
}

fn normalize_type_inner(value: checker::CheckResult, id: go_types::TypeId, active: Vec[isize]) -> json::Value {
    let repeated_union = if contains_type(active, id.value) {
        match go_types::get_type(value.world, id) {
            Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Union { terms: _ } }) => true,
            _ => false,
        }
    } else {
        false
    };
    if (contains_type(active, id.value) && !repeated_union)
        || contains_named_origin(value.world, active, id) {
        return normalize_type_reference(value, id)
    }
    let next: Vec[isize] = Vec::with_capacity(active.len() + 1);
    for item in active {
        next.push(item)
    }
    next.push(id.value);
    let fields = empty_type("Invalid", go_types::format_type(value.world, id));
    match go_types::get_type(value.world, id) {
        Some(go_types::TypeData { id: _, kind }) => match kind {
            go_types::TypeKind::Invalid => {
                set_field(fields, "kind", string_value("Basic"));
                set_field(fields, "name", string_value("invalid type"))
            },
            go_types::TypeKind::Basic { basic: _, name, untyped: _ } => {
                set_field(fields, "kind", string_value("Basic"));
                set_field(fields, "name", string_value(name))
            },
            go_types::TypeKind::Array { length, element } => {
                set_field(fields, "kind", string_value("Array"));
                set_field(fields, "length", number64_value(length));
                set_field(fields, "elem", normalize_type_inner(value, element, next))
            },
            go_types::TypeKind::Slice { element } => {
                set_field(fields, "kind", string_value("Slice"));
                set_field(fields, "elem", normalize_type_inner(value, element, next))
            },
            go_types::TypeKind::Struct { fields: struct_fields } => {
                set_field(fields, "kind", string_value("Struct"));
                let normalized: Vec[json::Value] = Vec::new();
                for field in struct_fields {
                    normalized.push(
                        object_value(
                            Vec::from_array(
                                [
                                    ("name", string_value(field.variable.name)),
                                    (
                                        "package",
                                        string_value(
                                            package_path(value.world, field.variable.owner),
                                        ),
                                    ),
                                    ("embedded", bool_value(field.embedded)),
                                    ("tag", string_value(field.tag)),
                                    (
                                        "type",
                                        normalize_type_inner(value, field.variable.type_id, next),
                                    ),
                                ],
                            ),
                        ),
                    )
                }
                set_field(fields, "fields", array_value(normalized))
            },
            go_types::TypeKind::Pointer { element } => {
                set_field(fields, "kind", string_value("Pointer"));
                set_field(fields, "elem", normalize_type_inner(value, element, next))
            },
            go_types::TypeKind::Tuple { variables } => {
                set_field(fields, "kind", string_value("Tuple"));
                let normalized: Vec[json::Value] = Vec::new();
                for variable in variables {
                    normalized.push(normalize_variable(value, variable, next))
                }
                set_field(fields, "parameters", array_value(normalized))
            },
            go_types::TypeKind::Signature {
                receiver,
                receiver_type_params,
                type_params,
                params,
                results,
                variadic,
            } => {
                set_field(fields, "kind", string_value("Signature"));
                match receiver {
                    Some(receiver) => set_field(
                        fields,
                        "receiver",
                        normalize_variable(value, receiver, next),
                    ),
                    None => {},
                }
                let parameters: Vec[json::Value] = Vec::new();
                match go_types::get_type(value.world, params) {
                    Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Tuple { variables } }) => for variable in variables {
                        parameters.push(normalize_variable(value, variable, next))
                    },
                    _ => {},
                }
                let result_values: Vec[json::Value] = Vec::new();
                match go_types::get_type(value.world, results) {
                    Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Tuple { variables } }) => for variable in variables {
                        result_values.push(normalize_variable(value, variable, next))
                    },
                    _ => {},
                }
                set_field(fields, "parameters", array_value(parameters));
                set_field(fields, "results", array_value(result_values));
                set_field(fields, "variadic", bool_value(variadic));
                set_field(
                    fields,
                    "type_parameters",
                    array_value(normalize_type_parameters(value, type_params, next)),
                );
                set_field(
                    fields,
                    "receiver_parameters",
                    array_value(normalize_type_parameters(value, receiver_type_params, next)),
                )
            },
            go_types::TypeKind::Interface { methods, embeddeds, comparable, implicit } => {
                set_field(fields, "kind", string_value("Interface"));
                let _ = comparable;
                set_field(
                    fields,
                    "comparable",
                    bool_value(go_types::type_set_comparable(value.world, id)),
                );
                set_field(fields, "implicit", bool_value(implicit));
                let method_values: Vec[json::Value] = Vec::new();
                for method in methods {
                    match go_types::get_object(value.world, method) {
                        Some(object) => method_values.push(
                            object_value(
                                Vec::from_array(
                                    [
                                        ("name", string_value(object.name)),
                                        (
                                            "package",
                                            string_value(package_path(value.world, object.owner)),
                                        ),
                                        ("object", string_value(object_key(value, object))),
                                        ("type", normalize_type_inner(value, object.type_id, next)),
                                    ],
                                ),
                            ),
                        ),
                        None => {},
                    }
                }
                let embedded_values: Vec[json::Value] = Vec::new();
                for embedded in embeddeds {
                    embedded_values.push(normalize_type_inner(value, embedded, next))
                }
                set_field(fields, "methods", array_value(method_values));
                set_field(fields, "embeddeds", array_value(embedded_values))
            },
            go_types::TypeKind::Map { key, value: element } => {
                set_field(fields, "kind", string_value("Map"));
                set_field(fields, "key", normalize_type_inner(value, key, next));
                set_field(fields, "elem", normalize_type_inner(value, element, next))
            },
            go_types::TypeKind::Chan { direction, element } => {
                set_field(fields, "kind", string_value("Chan"));
                set_field(
                    fields,
                    "direction",
                    string_value(
                        if direction == 1 {
                            "SendOnly"
                        } else if direction == 2 {
                            "RecvOnly"
                        } else {
                            "SendRecv"
                        },
                    ),
                );
                set_field(fields, "elem", normalize_type_inner(value, element, next))
            },
            go_types::TypeKind::Named { object, underlying: _, type_params, type_args, methods: _ } => {
                set_field(fields, "kind", string_value("Named"));
                match go_types::get_object(value.world, object) {
                    Some(object) => {
                        set_field(fields, "name", string_value(object.name));
                        set_field(fields, "declaration", string_value(object_key(value, object)))
                    },
                    None => {},
                }
                set_field(
                    fields,
                    "type_parameters",
                    array_value(normalize_type_parameters(value, type_params, next)),
                );
                let arguments: Vec[json::Value] = Vec::new();
                for argument in type_args {
                    arguments.push(normalize_type_inner(value, argument, next))
                }
                set_field(fields, "type_arguments", array_value(arguments))
            },
            go_types::TypeKind::Alias { object, rhs, type_params, type_args } => {
                set_field(fields, "kind", string_value("Alias"));
                let mut predeclared_any = false;
                match go_types::get_object(value.world, object) {
                    Some(object) => {
                        predeclared_any = object.name == "any" && object.owner.is_none();
                        set_field(fields, "name", string_value(object.name));
                        set_field(fields, "declaration", string_value(object_key(value, object)))
                    },
                    None => {},
                }
                let rhs_value = normalize_type_inner(value, rhs, next);
                set_field(
                    fields,
                    "elem",
                    if predeclared_any {
                        replace_json_field(rhs_value, "text", string_value("any"))
                    } else {
                        rhs_value
                    },
                );
                set_field(
                    fields,
                    "type_parameters",
                    array_value(normalize_type_parameters(value, type_params, next)),
                );
                let arguments: Vec[json::Value] = Vec::new();
                for argument in type_args {
                    arguments.push(normalize_type_inner(value, argument, next))
                }
                set_field(fields, "type_arguments", array_value(arguments))
            },
            go_types::TypeKind::TypeParam { object, constraint: _, index: _ } => {
                set_field(fields, "kind", string_value("TypeParam"));
                match go_types::get_object(value.world, object) {
                    Some(object) => {
                        set_field(fields, "name", string_value(object.name));
                        set_field(fields, "declaration", string_value(object_key(value, object)))
                    },
                    None => {},
                }
            },
            go_types::TypeKind::Union { terms } => {
                set_field(fields, "kind", string_value("Union"));
                let normalized: Vec[json::Value] = Vec::new();
                for term in terms {
                    normalized.push(
                        object_value(
                            Vec::from_array(
                                [
                                    ("tilde", bool_value(term.tilde)),
                                    ("type", normalize_type_inner(value, term.type_id, next)),
                                ],
                            ),
                        ),
                    )
                }
                set_field(fields, "terms", array_value(normalized))
            },
        },
        None => {},
    }
    object_value(fields)
}

fn normalize_type(value: checker::CheckResult, id: go_types::TypeId) -> json::Value {
    normalize_type_inner(value, id, Vec::new())
}

fn normalize_object(value: checker::CheckResult, id: go_types::ObjectId) -> json::Value {
    match go_types::get_object(value.world, id) {
        Some(object) => {
            let position = object_position(value, object);
            let imported_path = match object.imported_package {
                Some(package_id) => package_path(value.world, Option::Some(package_id)),
                None => "",
            };
            object_value(
                Vec::from_array(
                    [
                        ("key", string_value(object_key(value, object))),
                        ("kind", string_value(go_types::object_kind_name(object.kind))),
                        ("name", string_value(object.name)),
                        ("package", string_value(package_path(value.world, object.owner))),
                        ("file", string_value(position.0)),
                        ("offset", number_value(position.1)),
                        ("exported", bool_value(object.exported)),
                        ("type", normalize_type(value, object.type_id)),
                        ("value", normalize_constant(object.constant_kind, object.constant)),
                        ("imported_path", string_value(imported_path)),
                    ],
                ),
            )
        },
        None => json::Value::Null,
    }
}

fn json_string_field(value: json::Value, name: string) -> string {
    json::as_string(json::field(value, name).unwrap_or(json::Value::Null)).unwrap_or("")
}

fn compare_json_name(left: json::Value, right: json::Value) -> isize {
    let left_name = json_string_field(left, "name");
    let right_name = json_string_field(right, "name");
    if left_name < right_name {
        -1
    } else if left_name > right_name {
        1
    } else {
        0
    }
}

fn compare_json_node(left: json::Value, right: json::Value) -> isize {
    let left_node = json_string_field(left, "node");
    let right_node = json_string_field(right, "node");
    if left_node < right_node {
        -1
    } else if left_node > right_node {
        1
    } else {
        0
    }
}

fn normalize_scope_objects(value: checker::CheckResult, scope_id: go_types::ScopeId) -> Vec[
    json::Value,
] {
    let result: Vec[json::Value] = Vec::new();
    if scope_id.value >= 0 && scope_id.value < value.world.scopes.len() {
        for entry in value.world.scopes[scope_id.value].entries {
            result.push(normalize_object(value, entry.object))
        }
    }
    collections::sort_by(result, compare_json_name);
    result
}

fn node_key(value: checker::CheckResult, node: syntax::NodeId) -> string {
    syntax::node_key(value.syntax, node).unwrap_or("")
}

fn normalize_object_facts(value: checker::CheckResult, facts: Vec[checker::ObjectFact]) -> Vec[
    json::Value,
] {
    let result: Vec[json::Value] = Vec::new();
    for fact in facts {
        result.push(
            object_value(
                Vec::from_array(
                    [
                        ("node", string_value(node_key(value, fact.node))),
                        (
                            "object",
                            match fact.object {
                                Some(object) => normalize_object(value, object),
                                None => json::Value::Null,
                            },
                        ),
                    ],
                ),
            ),
        )
    }
    collections::sort_by(result, compare_json_node);
    result
}

fn find_type_fact(value: checker::CheckResult, node: syntax::NodeId) -> Option[checker::TypeFact] {
    for fact in value.info.types {
        if fact.node.value == node.value {
            return Option::Some(fact)
        }
    }
    Option::None
}

fn selection_kind(value: checker::CheckResult, fact: checker::SelectionFact) -> string {
    match go_types::get_object(value.world, fact.object) {
        Some(object) => if object.kind == go_types::ObjectKind::Var {
            "FieldVal"
        } else {
            match syntax::get_kind(value.syntax.arena, fact.node) {
                Some(syntax::SyntaxKind::SelectorExpr { expression, selector: _ }) => match find_type_fact(
                    value,
                    expression,
                ) {
                    Some(type_fact) => if type_fact.type_expr {
                        "MethodExpr"
                    } else {
                        "MethodVal"
                    },
                    None => "MethodVal",
                },
                _ => "MethodVal",
            }
        },
        None => "FieldVal",
    }
}

fn normalize_type_facts(value: checker::CheckResult) -> Vec[json::Value] {
    let result: Vec[json::Value] = Vec::new();
    for fact in value.info.types {
        let fact_node = checker::type_fact_key(fact).unwrap_or(node_key(value, fact.node));
        result.push(
            object_value(
                Vec::from_array(
                    [
                        ("node", string_value(fact_node)),
                        ("type", normalize_type(value, fact.type_id)),
                        (
                            "value",
                            normalize_constant(
                                checker::type_fact_constant_kind(fact),
                                checker::type_fact_constant(fact),
                            ),
                        ),
                        ("void", bool_value(fact.void)),
                        ("type_expr", bool_value(fact.type_expr)),
                        ("builtin", bool_value(fact.builtin)),
                        ("value_expr", bool_value(fact.value_expr)),
                        ("nil", bool_value(fact.nil)),
                        ("addressable", bool_value(fact.addressable)),
                        ("assignable", bool_value(fact.assignable)),
                        ("comma_ok", bool_value(fact.comma_ok)),
                    ],
                ),
            ),
        )
    }
    collections::sort_by(result, compare_json_node);
    result
}

fn normalize_selections(value: checker::CheckResult) -> Vec[json::Value] {
    let result: Vec[json::Value] = Vec::new();
    for fact in value.info.selections {
        let indices: Vec[json::Value] = Vec::new();
        for index in fact.index {
            indices.push(number_value(index))
        }
        result.push(
            object_value(
                Vec::from_array(
                    [
                        ("node", string_value(node_key(value, fact.node))),
                        ("kind", string_value(selection_kind(value, fact))),
                        ("receiver", normalize_type(value, fact.receiver_type)),
                        ("object", normalize_object(value, fact.object)),
                        ("type", normalize_type(value, fact.type_id)),
                        ("index", array_value(indices)),
                        ("indirect", bool_value(fact.indirect)),
                    ],
                ),
            ),
        )
    }
    collections::sort_by(result, compare_json_node);
    result
}

fn normalize_scopes(value: checker::CheckResult) -> Vec[json::Value] {
    let result: Vec[json::Value] = Vec::new();
    for fact in value.info.scopes {
        if fact.scope.value >= 0 && fact.scope.value < value.world.scopes.len() {
            let scope = value.world.scopes[fact.scope.value];
            let parent = match scope.parent {
                Some(id) => if id.value >= 0 && id.value < value.world.scopes.len() {
                    Option::Some(value.world.scopes[id.value])
                } else {
                    Option::None
                },
                None => Option::None,
            };
            result.push(
                object_value(
                    Vec::from_array(
                        [
                            ("node", string_value(node_key(value, fact.node))),
                            ("file", string_value(file_name(value, scope.file))),
                            ("start", number_value(scope.start)),
                            ("end", number_value(scope.end)),
                            (
                                "parent_file",
                                string_value(
                                    match parent {
                                        Some(parent) => file_name(value, parent.file),
                                        None => "",
                                    },
                                ),
                            ),
                            (
                                "parent_start",
                                number_value(
                                    match parent {
                                        Some(parent) => parent.start,
                                        None => -1,
                                    },
                                ),
                            ),
                            (
                                "parent_end",
                                number_value(
                                    match parent {
                                        Some(parent) => parent.end,
                                        None => -1,
                                    },
                                ),
                            ),
                            ("objects", array_value(normalize_scope_objects(value, fact.scope))),
                        ],
                    ),
                ),
            )
        }
    }
    collections::sort_by(result, compare_json_node);
    result
}

fn normalize_instances(value: checker::CheckResult) -> Vec[json::Value] {
    let result: Vec[json::Value] = Vec::new();
    for fact in value.info.instances {
        let arguments: Vec[json::Value] = Vec::new();
        for argument in fact.type_args {
            arguments.push(normalize_type(value, argument))
        }
        result.push(
            object_value(
                Vec::from_array(
                    [
                        ("node", string_value(node_key(value, fact.node))),
                        ("type_arguments", array_value(arguments)),
                        ("type", normalize_type(value, fact.type_id)),
                    ],
                ),
            ),
        )
    }
    collections::sort_by(result, compare_json_node);
    result
}

fn normalize_init_order(value: checker::CheckResult) -> Vec[json::Value] {
    let result: Vec[json::Value] = Vec::new();
    for fact in value.info.init_order {
        let left: Vec[json::Value] = Vec::new();
        for object in fact.left {
            left.push(normalize_object(value, object))
        }
        result.push(
            object_value(
                Vec::from_array(
                    [("lhs", array_value(left)), ("rhs", string_value(node_key(value, fact.right)))],
                ),
            ),
        )
    }
    result
}

fn normalize_file_versions(value: checker::CheckResult) -> Vec[json::Value] {
    let result: Vec[json::Value] = Vec::new();
    for fact in value.info.file_versions {
        result.push(
            object_value(
                Vec::from_array(
                    [
                        ("file", string_value(file_name(value, Option::Some(fact.file)))),
                        ("version", string_value(fact.version)),
                    ],
                ),
            ),
        )
    }
    collections::sort_by(
        result,
        |left: json::Value, right: json::Value| {
            let left_file = json_string_field(left, "file");
            let right_file = json_string_field(right, "file");
            if left_file < right_file {
                -1
            } else if left_file > right_file {
                1
            } else {
                0
            }
        },
    );
    result
}

pub fn normalize_result(value: checker::CheckResult) -> NormalizedResult {
    let package_scope = value.world.packages[value.package_id.value].scope;
    let unsafe_scope = value.world.packages[value.world.unsafe_package.value].scope;
    NormalizedResult {
        universe_scope: normalize_scope_objects(value, value.world.universe),
        unsafe_scope: normalize_scope_objects(value, unsafe_scope),
        package_scope: normalize_scope_objects(value, package_scope),
        types: normalize_type_facts(value),
        defs: normalize_object_facts(value, value.info.defs),
        uses: normalize_object_facts(value, value.info.uses),
        implicits: normalize_object_facts(value, value.info.implicits),
        selections: normalize_selections(value),
        scopes: normalize_scopes(value),
        instances: normalize_instances(value),
        init_order: normalize_init_order(value),
        file_versions: normalize_file_versions(value),
    }
}
