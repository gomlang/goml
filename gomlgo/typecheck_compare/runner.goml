package typecheck_compare;

use gomlgo::checker;
use gomlgo::loader;
use gomlgo::parser_diff;
use gomlgo::typecheck_diff;
use std::collections;
use std::fs;
use std::json;
use std::path;
use std::text;
use std::utf8;
use utf8::BytesUtf8;

pub const ACCEPTANCE_MODE: string = "acceptance";

pub const DIAGNOSTICS_MODE: string = "diagnostics";

pub const INFO_MODE: string = "info";

pub struct Summary {
    pub files: isize,
    pub accepted: isize,
    pub rejected: isize,
    pub info_compared: isize,
}

pub enum CompareMode {
    Acceptance,
    Diagnostics,
    Info,
}

pub fn mode_from_string(value: string) -> Option[CompareMode] {
    match value {
        ACCEPTANCE_MODE => Option::Some(CompareMode::Acceptance),
        DIAGNOSTICS_MODE => Option::Some(CompareMode::Diagnostics),
        INFO_MODE => Option::Some(CompareMode::Info),
        _ => Option::None,
    }
}

fn collect_go_files(root: string, files: Vec[string]) -> Result[(), string] {
    if fs::is_file(root) {
        if path::extension(root) == Option::Some("go") {
            files.push(root)
        }
    } else {
        let names = fs::read_dir(root).map_err(|error| error.to_string())?;
        collections::sort(names);
        for name in names {
            collect_go_files(path::join(root, name), files)?
        }
    }
    Result::Ok(())
}

fn first_checker_diagnostic(result: checker::CheckResult) -> string {
    if result.diagnostics.is_empty() {
        "none"
    } else {
        f"{result.diagnostics[0].file}:{result.diagnostics[0].start}: {result.diagnostics[0].message}"
    }
}

fn first_oracle_diagnostic(result: typecheck_diff::CheckResponse) -> string {
    if result.diagnostics.is_empty() {
        "none"
    } else {
        f"{result.diagnostics[0].file}:{result.diagnostics[0].start}: {result.diagnostics[0].message}"
    }
}

fn source_go_version(source: string) -> string {
    for line in text::split(source, "\n") {
        if line.starts_with("// -lang=") {
            return text::split(line.byte_slice(9, line.byte_len()), " ")[0]
        }
    }
    "go1.26"
}

fn source_fake_import_c(source: string) -> bool {
    source.contains("// -fakeImportC")
}

fn source_alias_enabled(source: string) -> bool {
    !source.contains("// -gotypesalias=0")
}

fn unordered_label_diagnostic(message: string) -> bool {
    message.starts_with("label ") && message.ends_with(" declared and not used")
}

fn compare_checker_diagnostic_position(
    left: checker::CheckDiagnostic,
    right: checker::CheckDiagnostic,
) -> isize {
    if left.start < right.start || (left.start == right.start && left.message < right.message) {
        -1
    } else if left.start == right.start && left.message == right.message {
        0
    } else {
        1
    }
}

fn compare_oracle_diagnostic_position(
    left: typecheck_diff::Diagnostic,
    right: typecheck_diff::Diagnostic,
) -> isize {
    if left.start < right.start || (left.start == right.start && left.message < right.message) {
        -1
    } else if left.start == right.start && left.message == right.message {
        0
    } else {
        1
    }
}

fn compare_diagnostics(
    file: string,
    actual: checker::CheckResult,
    expected: typecheck_diff::CheckResponse,
) -> Result[(), string] {
    let actual_diagnostics: Vec[checker::CheckDiagnostic] = Vec::new();
    let actual_labels: Vec[checker::CheckDiagnostic] = Vec::new();
    for value in actual.diagnostics {
        if unordered_label_diagnostic(value.message) {
            actual_labels.push(value)
        } else {
            actual_diagnostics.push(value)
        }
    }
    let expected_diagnostics: Vec[typecheck_diff::Diagnostic] = Vec::new();
    let expected_labels: Vec[typecheck_diff::Diagnostic] = Vec::new();
    for value in expected.diagnostics {
        if unordered_label_diagnostic(value.message) {
            expected_labels.push(value)
        } else {
            expected_diagnostics.push(value)
        }
    }
    collections::stable_sort_by(actual_labels, compare_checker_diagnostic_position);
    collections::stable_sort_by(expected_labels, compare_oracle_diagnostic_position);
    for value in actual_labels {
        actual_diagnostics.push(value)
    }
    for value in expected_labels {
        expected_diagnostics.push(value)
    }
    let common = if actual_diagnostics.len() < expected_diagnostics.len() {
        actual_diagnostics.len()
    } else {
        expected_diagnostics.len()
    };
    for index in 0..common {
        let left = actual_diagnostics[index];
        let right = expected_diagnostics[index];
        if left.file != right.file || left.start != right.start || left.end != right.end
            || left.message != right.message
            || left.soft != right.soft
            || left.secondary != right.secondary {
            return Result::Err(
                f"{file}: diagnostic mismatch at {index}\nactual={left.file}:{left.start}-{left.end} soft={left.soft} secondary={left.secondary} {left.message}\nexpected={right.file}:{right.start}-{right.end} soft={right.soft} secondary={right.secondary} {right.message}",
            )
        }
    }
    if actual_diagnostics.len() != expected_diagnostics.len() {
        return Result::Err(
            f"{file}: diagnostics length mismatch\nactual={actual_diagnostics.len()}\nexpected={expected_diagnostics.len()}",
        )
    }
    Result::Ok(())
}

fn compare_section(file: string, name: string, actual: Vec[json::Value], expected: Vec[json::Value]) -> Result[
    (),
    string,
] {
    let actual_keys: Vec[string] = Vec::new();
    for value in actual {
        let node = json::as_string(json::field(value, "node").unwrap_or(json::Value::Null)).unwrap_or(
            "",
        );
        if node != "" {
            actual_keys.push(node)
        }
    }
    let expected_keys: Vec[string] = Vec::new();
    for value in expected {
        let node = json::as_string(json::field(value, "node").unwrap_or(json::Value::Null)).unwrap_or(
            "",
        );
        if node != "" {
            expected_keys.push(node)
        }
    }
    if actual.len() != expected.len() && !actual_keys.is_empty() && !expected_keys.is_empty() {
        let mut actual_index = 0;
        let mut expected_index = 0;
        while actual_index < actual_keys.len() && expected_index < expected_keys.len() {
            if actual_keys[actual_index] == expected_keys[expected_index] {
                actual_index += 1;
                expected_index += 1;
            } else if actual_keys[actual_index] < expected_keys[expected_index] {
                return Result::Err(
                    file + ": " + name + " has extra actual node " + actual_keys[actual_index]
                        + "\nactual fact="
                        + json::try_to_string(actual[actual_index]).unwrap_or(""),
                )
            } else {
                return Result::Err(
                    file + ": " + name + " is missing expected node "
                        + expected_keys[expected_index]
                        + "\nexpected fact="
                        + json::try_to_string(expected[expected_index]).unwrap_or(""),
                )
            }
        }
        if actual_index < actual_keys.len() {
            return Result::Err(
                file + ": " + name + " has extra actual node " + actual_keys[actual_index]
                    + "\nactual fact="
                    + json::try_to_string(actual[actual_index]).unwrap_or(""),
            )
        } else if expected_index < expected_keys.len() {
            return Result::Err(
                file + ": " + name + " is missing expected node " + expected_keys[expected_index]
                    + "\nexpected fact="
                    + json::try_to_string(expected[expected_index]).unwrap_or(""),
            )
        }
    }
    if actual.len() == expected.len() {
        for index in 0..actual.len() {
            match parser_diff::compare_ast(
                actual[index],
                expected[index],
                parser_diff::Mode::Position,
            ) {
                Some(difference) => return Result::Err(
                    f"{file}: {name} mismatch at $[{index}]"
                        + difference.path.byte_slice(1, difference.path.byte_len())
                        + "\nactual="
                        + difference.actual
                        + "\nexpected="
                        + difference.expected
                        + "\nactual fact="
                        + json::try_to_string(actual[index]).unwrap_or("")
                        + "\nexpected fact="
                        + json::try_to_string(expected[index]).unwrap_or(""),
                ),
                None => {},
            }
        }
    }
    match parser_diff::compare_ast(
        json::Value::Array(actual),
        json::Value::Array(expected),
        parser_diff::Mode::Position,
    ) {
        Some(difference) => Result::Err(
            file + ": " + name + " mismatch at " + difference.path + "\nactual=" + difference.actual
                + "\nexpected="
                + difference.expected
                + if actual_keys.is_empty() && expected_keys.is_empty() {
                    ""
                } else {
                    "\nactual nodes=" + text::join(actual_keys, ",") + "\nexpected nodes="
                        + text::join(expected_keys, ",")
                },
        ),
        None => Result::Ok(()),
    }
}

pub fn compare_info(
    file: string,
    actual: checker::CheckResult,
    expected: typecheck_diff::CheckResponse,
) -> Result[(), string] {
    let actual_package = actual.world.packages[actual.package_id.value];
    if actual_package.path != expected.package_info.path
        || actual_package.name != expected.package_info.name
        || actual_package.complete != expected.package_info.complete {
        return Result::Err(
            f"{file}: package metadata mismatch\nactual={actual_package.path} {actual_package.name} complete={actual_package.complete}\nexpected={expected.package_info.path} {expected.package_info.name} complete={expected.package_info.complete}",
        )
    }
    let normalized = normalize_result(actual);
    compare_section(file, "package_scope", normalized.package_scope, expected.package_scope)?;
    compare_section(file, "types", normalized.types, expected.types)?;
    compare_section(file, "defs", normalized.defs, expected.defs)?;
    compare_section(file, "uses", normalized.uses, expected.uses)?;
    compare_section(file, "implicits", normalized.implicits, expected.implicits)?;
    compare_section(file, "selections", normalized.selections, expected.selections)?;
    compare_section(file, "scopes", normalized.scopes, expected.scopes)?;
    compare_section(file, "instances", normalized.instances, expected.instances)?;
    compare_section(file, "init_order", normalized.init_order, expected.init_order)?;
    compare_section(file, "file_versions", normalized.file_versions, expected.file_versions)?;
    compare_section(file, "universe_scope", normalized.universe_scope, expected.universe_scope)?;
    compare_section(file, "unsafe_scope", normalized.unsafe_scope, expected.unsafe_scope)
}

fn compare_file(file: string, mode: CompareMode) -> Result[(bool, bool), string] {
    let source_bytes = fs::read_bytes_structured(file).map_err(|error| error.to_string())?;
    let source = source_bytes.to_string_utf8().map_err(|error| error.to_string())?;
    let package_path = "typecheck/fixture";
    let go_version = source_go_version(source);
    let fake_import_c = source_fake_import_c(source);
    let enable_alias = source_alias_enabled(source);
    let load_config = loader::default_config();
    load_config.checker_config.go_version = go_version;
    load_config.checker_config.fake_import_c = fake_import_c;
    load_config.checker_config.enable_alias = enable_alias;
    let actual = loader::check_sources_with_diagnostics(
        load_config,
        package_path,
        Vec::from_array([checker::SourceFile { name: file, source: source_bytes }]),
    );
    let request = typecheck_diff::request(
        package_path,
        Vec::from_array([typecheck_diff::SourceFile { name: file, source }]),
    );
    request.go_version = go_version;
    request.config.fake_import_c = fake_import_c;
    request.config.enable_alias = enable_alias;
    let expected = typecheck_diff::run_check(request)?;
    let actual_ok = match actual {
        Ok(result) => result.diagnostics.is_empty(),
        Err(_) => false,
    };
    if actual_ok != expected.ok {
        let actual_diagnostic = match actual {
            Ok(result) => first_checker_diagnostic(result),
            Err(message) => message,
        };
        return Result::Err(
            f"{file}: type-check acceptance mismatch\nactual ok={actual_ok} first diagnostic={actual_diagnostic}\nexpected ok={expected.ok} first diagnostic="
                + first_oracle_diagnostic(expected),
        )
    } else if actual_ok {
        compare_info(file, actual?, expected)?;
        return Result::Ok((true, true))
    } else {
        match mode {
            CompareMode::Acceptance => {},
            CompareMode::Diagnostics => compare_diagnostics(file, actual?, expected)?,
            CompareMode::Info => {
                let result = actual?;
                compare_diagnostics(file, result, expected)?;
                compare_info(file, result, expected)?
            },
        }
    }
    Result::Ok(
        (
            false,
            match mode {
                CompareMode::Info => true,
                _ => false,
            },
        ),
    )
}

pub fn compare_tree_mode(root: string, mode: CompareMode) -> Result[Summary, string] {
    let files: Vec[string] = Vec::new();
    collect_go_files(root, files)?;
    let mut accepted = 0;
    let mut info_compared = 0;
    for file in files {
        let result = compare_file(file, mode)?;
        if result.0 {
            accepted += 1;
        }
        if result.1 {
            info_compared += 1;
        }
    }
    Result::Ok(
        Summary { files: files.len(), accepted, rejected: files.len() - accepted, info_compared },
    )
}

pub fn compare_tree(root: string) -> Result[Summary, string] {
    compare_tree_mode(root, CompareMode::Diagnostics)
}
