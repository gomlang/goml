package typecheck_compare;

use std::env;
use std::path;
use std::testing;

#[test]
fn compares_local_typecheck_fixtures() -> () {
    if env::var_structured("GOMLGO_ORACLE").is_ok() {
        let root = path::join(env::current_dir_structured().unwrap_or("."), "testdata/typecheck");
        let result = testing::expect_ok(compare_tree(root), "typecheck comparison failed");
        testing::assert_eq(result.files, 3);
        testing::assert_eq(result.accepted, 2);
        testing::assert_eq(result.rejected, 1);
        testing::assert_eq(result.info_compared, 2)
    }
}
