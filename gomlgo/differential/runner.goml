package differential;

use std::bytes;
use std::env;
use std::process;
use std::utf8;
use utf8::BytesUtf8;

pub const DEFAULT_ORACLE: string = "../_artifact/gomlgo/oracle";

fn bytes_to_string(value: bytes::Bytes) -> Result[string, string] {
    value.to_string_utf8().map_err(|error| error.to_string())
}

pub fn oracle_path() -> string {
    env::var_structured("GOMLGO_ORACLE").unwrap_or(DEFAULT_ORACLE)
}

pub fn run_oracle_at(executable: string, mode: string, source: bytes::Bytes) -> Result[
    OracleResponse,
    string,
] {
    let output = process::Command::new(executable).arg(mode).input(source).output_structured().map_err(
        |error| error.to_string(),
    )?;
    let stdout = bytes_to_string(output.stdout())?;
    if output.status().success() {
        decode_response(stdout)
    } else {
        let stderr = bytes_to_string(output.stderr())?;
        Result::Err("oracle failed: " + stderr)
    }
}

pub fn run_oracle(mode: string, source: bytes::Bytes) -> Result[OracleResponse, string] {
    run_oracle_at(oracle_path(), mode, source)
}
