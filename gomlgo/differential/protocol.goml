package differential;

use std::json;
use json::Deserialize;

#[derive(Deserialize)]
pub struct OracleToken {
    pub kind: string,
    pub literal: string,
    pub start: isize,
    pub end: isize,
    pub synthetic: bool,
}

#[derive(Deserialize)]
pub struct OracleDiagnostic {
    pub message: string,
    pub offset: isize,
}

#[derive(Deserialize)]
pub struct OracleResponse {
    pub mode: string,
    pub ok: bool,
    pub go_version: string,
    pub goroot: string,
    pub tokens: Vec[OracleToken],
    pub ast: json::Value,
    pub diagnostics: Vec[OracleDiagnostic],
}

pub fn decode_response(input: string) -> Result[OracleResponse, string] {
    json::from_string(input)
}
