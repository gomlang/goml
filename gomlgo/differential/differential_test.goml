package differential;

use std::bytes;
use std::json;
use std::testing;

fn expect_response(result: Result[OracleResponse, string]) -> OracleResponse {
    match result {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            OracleResponse {
                mode: "error",
                ok: false,
                go_version: "",
                goroot: "",
                tokens: Vec::new(),
                ast: json::Value::Object(Vec::new()),
                diagnostics: Vec::new(),
            }
        },
    }
}

#[test]
fn decodes_oracle_protocol() -> () {
    let response = expect_response(
        decode_response(
            "{\"mode\":\"scan\",\"ok\":true,\"go_version\":\"go1.26.5\",\"goroot\":\"/usr/lib/go-1.26\",\"tokens\":[{\"kind\":\"IDENT\",\"literal\":\"π\",\"start\":0,\"end\":2,\"synthetic\":false}],\"ast\":{},\"diagnostics\":[]}",
        ),
    );
    testing::assert(response.ok);
    testing::assert_eq(response.mode, "scan");
    testing::assert_eq(response.tokens.len(), 1);
    testing::assert_eq(response.tokens[0].kind, "IDENT");
    testing::assert_eq(response.tokens[0].literal, "π");
    testing::assert_eq(response.tokens[0].start, 0);
    testing::assert_eq(response.tokens[0].end, 2);
    testing::assert(!response.tokens[0].synthetic)
}

#[test]
fn invokes_running_oracle() -> () {
    let response = expect_response(run_oracle("scan", bytes::Bytes::from_string("package main\n")));
    let version = expect_response(run_oracle("version", bytes::Bytes::new()));
    testing::assert(response.ok);
    testing::assert(version.go_version.starts_with("go1.26."));
    testing::assert(version.goroot != "");
    testing::assert_eq(response.go_version, version.go_version);
    testing::assert_eq(response.goroot, version.goroot);
    testing::assert_eq(response.tokens.len(), 4);
    testing::assert_eq(response.tokens[0].kind, "package");
    testing::assert_eq(response.tokens[1].literal, "main");
    testing::assert(response.tokens[2].synthetic);
    testing::assert_eq(response.tokens[3].kind, "EOF");
    match response.ast {
        json::Value::Object(fields) => testing::assert_eq(fields.len(), 0),
        _ => testing::fail("scan AST must be an empty object"),
    }
}

#[test]
fn invalid_input_returns_partial_ast_and_diagnostics() -> () {
    let response = expect_response(
        run_oracle("parse-file", bytes::Bytes::from_string("package main\nfunc main( {\n")),
    );
    testing::assert(!response.ok);
    testing::assert(!response.diagnostics.is_empty());
    testing::assert(response.diagnostics[0].offset >= 0);
    match response.ast {
        json::Value::Object(fields) => testing::assert(!fields.is_empty()),
        _ => testing::fail("invalid source must retain a partial AST"),
    }
}
