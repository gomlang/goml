package typecheck_diff;

use std::bytes;
use std::env;
use std::process;
use std::utf8;
use utf8::BytesUtf8;

pub const DEFAULT_ORACLE: string = "../_artifact/gomlgo/oracle";

fn bytes_to_string(value: bytes::Bytes) -> Result[string, string] {
    value.to_string_utf8().map_err(|error| error.to_string())
}

pub fn oracle_path() -> string {
    env::var_structured("GOMLGO_ORACLE").unwrap_or(DEFAULT_ORACLE)
}

fn invoke(executable: string, mode: string, input: string) -> Result[string, string] {
    let output = process::Command::new(executable).arg(mode).input(bytes::Bytes::from_string(input)).output_structured().map_err(
        |error| error.to_string(),
    )?;
    let stdout = bytes_to_string(output.stdout())?;
    if output.status().success() {
        Result::Ok(stdout)
    } else {
        Result::Err("oracle failed: " + bytes_to_string(output.stderr())?)
    }
}

pub fn run_check_at(executable: string, value: CheckRequest) -> Result[CheckResponse, string] {
    decode_check_response(invoke(executable, "type-check-package", encode_check_request(value))?)
}

pub fn run_check(value: CheckRequest) -> Result[CheckResponse, string] {
    run_check_at(oracle_path(), value)
}

pub fn run_constant_at(executable: string, value: ConstantRequest) -> Result[
    ConstantResponse,
    string,
] {
    decode_constant_response(invoke(executable, "constant-eval", encode_constant_request(value))?)
}

pub fn run_constant(value: ConstantRequest) -> Result[ConstantResponse, string] {
    run_constant_at(oracle_path(), value)
}
