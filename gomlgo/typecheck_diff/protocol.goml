package typecheck_diff;

use std::json;
use json::{Deserialize, Serialize};

#[derive(Serialize)]
pub struct SourceFile {
    pub name: string,
    pub source: string,
}

#[derive(Serialize)]
pub struct CheckConfig {
    pub ignore_func_bodies: bool,
    pub fake_import_c: bool,
    pub disable_unused_import_check: bool,
    pub enable_alias: bool,
    pub collect_info: bool,
}

#[derive(Serialize)]
pub struct CheckRequest {
    pub package_path: string,
    pub go_version: string,
    pub goos: string,
    pub goarch: string,
    pub files: Vec[SourceFile],
    pub config: CheckConfig,
}

#[derive(Deserialize)]
pub struct Diagnostic {
    pub file: string,
    pub start: isize,
    pub end: isize,
    pub message: string,
    pub soft: bool,
    pub secondary: bool,
}

#[derive(Deserialize)]
pub struct PackageInfo {
    pub path: string,
    pub name: string,
    pub complete: bool,
}

#[derive(Deserialize)]
pub struct CheckResponse {
    pub mode: string,
    pub ok: bool,
    pub go_version: string,
    pub goroot: string,
    #[serde(rename = "package")]
    pub package_info: PackageInfo,
    pub diagnostics: Vec[Diagnostic],
    pub universe_scope: Vec[json::Value],
    pub unsafe_scope: Vec[json::Value],
    pub package_scope: Vec[json::Value],
    pub types: Vec[json::Value],
    pub defs: Vec[json::Value],
    pub uses: Vec[json::Value],
    pub implicits: Vec[json::Value],
    pub selections: Vec[json::Value],
    pub scopes: Vec[json::Value],
    pub instances: Vec[json::Value],
    pub init_order: Vec[json::Value],
    pub file_versions: Vec[json::Value],
}

#[derive(Serialize)]
pub struct ConstantRequest {
    pub expression: string,
    pub go_version: string,
}

#[derive(Deserialize)]
pub struct ConstantValue {
    pub kind: string,
    pub exact: string,
}

#[derive(Deserialize)]
pub struct ConstantResponse {
    pub mode: string,
    pub ok: bool,
    pub go_version: string,
    pub goroot: string,
    #[serde(rename = "type")]
    pub type_value: json::Value,
    pub value: Option[ConstantValue],
    pub diagnostics: Vec[Diagnostic],
}

pub fn default_config() -> CheckConfig {
    CheckConfig {
        ignore_func_bodies: false,
        fake_import_c: false,
        disable_unused_import_check: false,
        enable_alias: true,
        collect_info: true,
    }
}

pub fn acceptance_request(package_path: string, files: Vec[SourceFile]) -> CheckRequest {
    let value = request(package_path, files);
    value.config.collect_info = false;
    value
}

pub fn request(package_path: string, files: Vec[SourceFile]) -> CheckRequest {
    CheckRequest {
        package_path,
        go_version: "go1.26",
        goos: "linux",
        goarch: "amd64",
        files,
        config: default_config(),
    }
}

pub fn encode_check_request(value: CheckRequest) -> string {
    json::try_to_string(value).unwrap_or("")
}

pub fn encode_constant_request(value: ConstantRequest) -> string {
    json::try_to_string(value).unwrap_or("")
}

pub fn decode_check_response(input: string) -> Result[CheckResponse, string] {
    json::from_string(input)
}

pub fn decode_constant_response(input: string) -> Result[ConstantResponse, string] {
    json::from_string(input)
}
