package typecheck_diff;

use gomlgo::differential;
use std::bytes;
use std::json;
use std::testing;

fn expect_check(value: Result[CheckResponse, string]) -> CheckResponse {
    match value {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            loop {}
        },
    }
}

fn expect_constant(value: Result[ConstantResponse, string]) -> ConstantResponse {
    match value {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            loop {}
        },
    }
}

#[test]
fn request_encoding_is_stable() -> () {
    let encoded = encode_check_request(
        request(
            "example/p",
            Vec::from_array([SourceFile { name: "a.go", source: "package p\nvar X int\n" }]),
        ),
    );
    let parsed = json::parse(encoded).unwrap_or(json::Value::Null);
    testing::assert_eq(
        json::as_string(json::field(parsed, "package_path").unwrap_or(json::Value::Null)).unwrap_or(
            "",
        ),
        "example/p",
    );
    testing::assert(
        json::as_bool(
            json::field(json::field(parsed, "config").unwrap_or(json::Value::Null), "collect_info").unwrap_or(
                json::Value::Null,
            ),
        ).unwrap_or(false),
    )
}

#[test]
fn acceptance_request_skips_info() -> () {
    let encoded = encode_check_request(acceptance_request("example/p", Vec::new()));
    let parsed = json::parse(encoded).unwrap_or(json::Value::Null);
    testing::assert(
        !json::as_bool(
            json::field(json::field(parsed, "config").unwrap_or(json::Value::Null), "collect_info").unwrap_or(
                json::Value::Null,
            ),
        ).unwrap_or(true),
    )
}

#[test]
fn invokes_type_check_oracle() -> () {
    let response = expect_check(
        run_check(
            request(
                "example/p",
                Vec::from_array(
                    [
                        SourceFile {
                            name: "a.go",
                            source: "package p\nvar X int\nfunc F() int { return X }\n",
                        },
                    ],
                ),
            ),
        ),
    );
    testing::assert(response.ok);
    testing::assert_eq(response.mode, "type-check-package");
    let version = testing::expect_ok(
        differential::run_oracle_at(oracle_path(), "version", bytes::Bytes::new()),
        "oracle version request failed",
    );
    testing::assert(version.go_version.starts_with("go1.26."));
    testing::assert_eq(response.go_version, version.go_version);
    testing::assert_eq(response.package_info.path, "example/p");
    testing::assert_eq(response.package_info.name, "p");
    testing::assert(response.package_info.complete);
    testing::assert_eq(response.universe_scope.len(), 44);
    testing::assert_eq(response.unsafe_scope.len(), 9);
    testing::assert_eq(response.package_scope.len(), 2);
    testing::assert(!response.types.is_empty());
    testing::assert(!response.defs.is_empty());
    testing::assert(!response.uses.is_empty())
}

#[test]
fn invokes_constant_oracle() -> () {
    let response = expect_constant(
        run_constant(ConstantRequest { expression: "(1 << 100) + 3", go_version: "go1.26" }),
    );
    testing::assert(response.ok);
    testing::assert_eq(response.mode, "constant-eval");
    match response.value {
        Some(value) => {
            testing::assert_eq(value.kind, "Int");
            testing::assert_eq(value.exact, "1267650600228229401496703205379")
        },
        None => testing::fail("missing constant value"),
    }
}
