package execution;

use gomlgo::types as go_types;
use gomlgo::checker;
use gomlgo::syntax;
use std::env;
use std::fs;
use std::path;
use std::testing;

fn fixture(name: string) -> string {
    path::join(path::join(env::current_dir_structured().unwrap_or("."), "testdata/execution"), name)
}

fn package_named(packages: Vec[GoListPackage], name: string) -> Option[GoListPackage] {
    for package_value in packages {
        if package_value.import_path == name {
            return Option::Some(package_value)
        }
    }
    Option::None
}

fn execution_package_named(packages: Vec[ExecutionPackage], name: string) -> Option[
    ExecutionPackage,
] {
    for package_value in packages {
        if package_value.path == name {
            return Option::Some(package_value)
        }
    }
    Option::None
}

fn has_diagnostic(result: ExecutionLoadResult, expected: string) -> bool {
    for diagnostic in result.diagnostics {
        if diagnostic.message.contains(expected) {
            return true
        }
    }
    false
}

#[test]
fn parses_concatenated_go_list_json_objects() -> () {
    let values = testing::expect_ok(
        parse_json_stream("{\"value\":\"} [ \\\"\"}\n{\"nested\":[{\"ok\":true}]}\n"),
        "JSON stream parsing failed",
    );
    testing::assert_eq(values.len(), 2)
}

#[test]
fn discovers_go126_toolchain_and_package_graph() -> () {
    let config = default_config();
    let toolchain = testing::expect_ok(
        discover_toolchain(config.go_binary),
        "toolchain discovery failed",
    );
    testing::assert(toolchain.version.starts_with("go1.26."));
    let listed = testing::expect_ok(
        list_go_packages(config, toolchain, fixture("basic")),
        "go list failed",
    );
    testing::assert_eq(listed.root_path, "example.com/execution");
    testing::assert(
        testing::expect_some(package_named(listed.packages, "math"), "missing math package").standard,
    );
    testing::assert(
        testing::expect_some(
            package_named(listed.packages, "example.com/execution/helper"),
            "missing helper package",
        ).module_main,
    )
}

#[test]
fn loads_a_named_go_source_file() -> () {
    let file = path::join(
        path::join(env::current_dir_structured().unwrap_or("."), "testdata/execute/pure/control"),
        "main.go",
    );
    let loaded = testing::expect_ok(
        load_files(default_config(), Vec::from_array([file])),
        "named source loading failed",
    );
    testing::assert(loaded.diagnostics.is_empty());
    testing::assert(loaded.program.is_some())
}

#[test]
fn loads_generated_files_from_standard_library_sources() -> () {
    let file = path::join(fixture("native_api"), "main.gom.go");
    let loaded = testing::expect_ok(
        load_files(default_config(), Vec::from_array([file])),
        "generated source loading failed",
    );
    testing::assert(loaded.diagnostics.is_empty());
    let program = testing::expect_some(loaded.program, "generated source program is missing");
    testing::assert(execution_package_named(program.packages, "runtime").is_some());
    testing::assert(execution_package_named(program.packages, "io").is_some());
    testing::assert(execution_package_named(program.packages, "fmt").is_some());
    testing::assert(execution_package_named(program.packages, "slices").is_some())
}

#[test]
fn loads_generated_files_with_additional_standard_library_api() -> () {
    let file = path::join(fixture("native_api_fallback"), "main.gom.go");
    let loaded = testing::expect_ok(
        load_files(default_config(), Vec::from_array([file])),
        "generated source loading failed",
    );
    testing::assert(loaded.diagnostics.is_empty());
    let program = testing::expect_some(loaded.program, "generated source program is missing");
    testing::assert(execution_package_named(program.packages, "strings").is_some())
}

#[test]
fn rejects_incomparable_standard_library_values_for_every_source_name() -> () {
    let directory = path::join(
        env::current_dir_structured().unwrap_or("."),
        "_artifact/incomparable-source-names",
    );
    testing::assert_ok(fs::create_dir_all(directory));
    let source = "package main\nimport \"bytes\"\nfunc main() { var left, right bytes.Buffer; println(left == right) }\n";
    for name in Vec::from_array(["main.go", "main.gom.go", "goml_generated.go"]) {
        let file = path::join(directory, name);
        testing::assert_ok(fs::write_file_structured(file, source));
        let loaded = testing::expect_ok(
            load_files(default_config(), Vec::from_array([file])),
            "standard library comparison loading failed",
        );
        testing::assert(loaded.program.is_none());
        testing::assert(has_diagnostic(loaded, "cannot be compared"))
    }
    testing::assert_ok(fs::remove_dir_all(directory))
}

#[test]
fn rejects_multiple_entry_source_files() -> () {
    let file = path::join(
        path::join(env::current_dir_structured().unwrap_or("."), "testdata/execute/pure/control"),
        "main.go",
    );
    testing::assert(load_files(default_config(), Vec::from_array([file, file])).is_err())
}

#[test]
fn rejects_non_standard_imports_in_single_file_mode() -> () {
    let file = path::join(fixture("basic"), "main.go");
    let loaded = testing::expect_ok(
        load_files(default_config(), Vec::from_array([file])),
        "single-file loading failed",
    );
    testing::assert(loaded.program.is_none());
    testing::assert(has_diagnostic(loaded, "non-standard import example.com/execution/helper"))
}

#[test]
fn loads_interpreted_packages_and_native_standard_library() -> () {
    let loaded = testing::expect_ok(
        load_program(default_config(), fixture("basic")),
        "execution program loading failed",
    );
    testing::assert_eq(loaded.diagnostics.len(), 0);
    let program = testing::expect_some(loaded.program, "execution program was not produced");
    let main = testing::expect_some(
        execution_package_named(program.packages, "example.com/execution"),
        "missing main package",
    );
    let helper = testing::expect_some(
        execution_package_named(program.packages, "example.com/execution/helper"),
        "missing helper package",
    );
    let math = testing::expect_some(
        execution_package_named(program.packages, "math"),
        "missing math package",
    );
    testing::assert(main.mode == ExecutionMode::Interpreted);
    testing::assert(helper.mode == ExecutionMode::Interpreted);
    testing::assert(math.mode == ExecutionMode::Native);
    testing::assert(main.syntax.is_some());
    testing::assert(helper.syntax.is_some());
    testing::assert(math.syntax.is_none());
    testing::assert_eq(
        testing::expect_some(
            go_types::get_object(program.world, program.main_function),
            "missing main function object",
        ).name,
        "main",
    );
    testing::assert(
        program.initialization_order[program.initialization_order.len() - 1].value
            == program.main_package.value,
    )
}

#[test]
fn checks_function_bodies_in_interpreted_dependencies() -> () {
    let loaded = testing::expect_ok(
        load_program(default_config(), fixture("invalid_dependency")),
        "execution program loading failed",
    );
    testing::assert(loaded.program.is_none());
    testing::assert(has_diagnostic(loaded, "undefined: missing"))
}

#[test]
fn rejects_main_packages_without_main_function() -> () {
    let loaded = testing::expect_ok(
        load_program(default_config(), fixture("missing_main")),
        "execution program loading failed",
    );
    testing::assert(loaded.program.is_none());
    testing::assert(has_diagnostic(loaded, "main.main is not defined"))
}

#[test]
fn indexes_type_facts_per_package_and_reports_missing_facts() -> () {
    let loaded = testing::expect_ok(
        load_program(default_config(), fixture("basic")),
        "execution program loading failed",
    );
    let program = testing::expect_some(loaded.program, "execution program was not produced");
    let main = testing::expect_some(
        execution_package_named(program.packages, "example.com/execution"),
        "missing main package",
    );
    let helper = testing::expect_some(
        execution_package_named(program.packages, "example.com/execution/helper"),
        "missing helper package",
    );
    testing::assert(main.index.package_id.value == main.package_id.value);
    testing::assert(helper.index.package_id.value == helper.package_id.value);
    testing::assert(main.index.package_id.value != helper.index.package_id.value);
    testing::assert(require_node_type(main.index, syntax::node_id(-1)).is_err());
    testing::assert(require_node_type_index(main.index, syntax::node_id(-1)).is_err());
    let first = main.info.types[0];
    let fact_index = testing::expect_ok(
        require_node_type_index(main.index, first.node),
        "type fact index is missing",
    );
    testing::assert(main.index.types[fact_index].node.value == first.node.value)
}

#[test]
fn diagnoses_conflicting_and_out_of_range_type_facts() -> () {
    let loaded = testing::expect_ok(
        load_program(default_config(), fixture("basic")),
        "execution program loading failed",
    );
    let program = testing::expect_some(loaded.program, "execution program was not produced");
    let main = testing::expect_some(
        execution_package_named(program.packages, "example.com/execution"),
        "missing main package",
    );
    testing::assert(!main.info.types.is_empty());
    let first = main.info.types[0];
    let info = checker::empty_info();
    info.types.push(first);
    info.types.push(first);
    info.types.push(
        checker::TypeFact {
            node: syntax::node_id(main.index.node_count),
            type_id: first.type_id,
            extra: Option::None,
            void: false,
            type_expr: false,
            builtin: false,
            value_expr: true,
            nil: false,
            addressable: false,
            assignable: false,
            comma_ok: false,
        },
    );
    let indexed = build_type_info_index(
        program.world,
        main.package_id,
        main.path,
        main.index.node_count,
        main.index.file_count,
        info,
    );
    testing::assert_eq(indexed.diagnostics.len(), 2)
}
