package execution;

use gomlgo::toolchain;
use std::bytes;
use std::json;
use std::process;
use std::text;
use std::utf8;
use utf8::BytesUtf8;

pub fn default_config() -> ExecutionConfig {
    ExecutionConfig {
        go_binary: toolchain::default_binary(),
        goos: "linux",
        goarch: "amd64",
        cgo: false,
        tags: Vec::new(),
        interpret_dependencies: true,
    }
}

fn process_text(value: bytes::Bytes) -> string {
    value.to_string_utf8().unwrap_or("<non-UTF-8 process output>")
}

fn successful_output(output: process::Output, operation: string) -> Result[string, string] {
    if process::ExitStatus::success(process::Output::status(output)) {
        Result::Ok(process_text(process::Output::stdout(output)))
    } else {
        let stderr = text::trim(process_text(process::Output::stderr(output)));
        Result::Err(
            if stderr == "" {
                f"{operation} failed"
            } else {
                f"{operation} failed: {stderr}"
            },
        )
    }
}

fn required_json_string(value: json::Value, name: string) -> Result[string, string] {
    let field = json::field(value, name).ok_or(f"go tool JSON omitted {name}")?;
    json::as_string(field).ok_or(f"go tool JSON field {name} must be a string")
}

fn optional_json_string(value: json::Value, name: string) -> string {
    json::field(value, name).and_then(|field| json::as_string(field)).unwrap_or("")
}

fn optional_json_bool(value: json::Value, name: string) -> bool {
    json::field(value, name).and_then(|field| json::as_bool(field)).unwrap_or(false)
}

fn optional_json_strings(value: json::Value, name: string) -> Result[Vec[string], string] {
    let Some(field) = json::field(value, name) else {
        return Result::Ok(Vec::new())
    };
    let Some(items) = json::as_array(field) else {
        return Result::Err(f"go tool JSON field {name} must be an array")
    };
    let result: Vec[string] = Vec::with_capacity(items.len());
    for item in items {
        let value = json::as_string(item).ok_or(f"go tool JSON field {name} must contain strings")?;
        result.push(value)
    }
    Result::Ok(result)
}

fn parse_json_stream(input: string) -> Result[Vec[json::Value], string] {
    let values: Vec[json::Value] = Vec::new();
    let mut index = 0;
    while index < input.byte_len() {
        while index < input.byte_len()
            && (input.byte_get(index) == b' ' || input.byte_get(index) == b'\t'
                || input.byte_get(index) == b'\r'
                || input.byte_get(index) == b'\n') {
            index += 1;
        }
        if index == input.byte_len() {
            break
        } else if input.byte_get(index) != b'{' {
            return Result::Err(f"go list emitted a non-object JSON value at byte {index}")
        }
        let start = index;
        let mut depth = 0;
        let mut in_string = false;
        let mut escaped = false;
        let mut complete = false;
        while index < input.byte_len() {
            let byte = input.byte_get(index);
            if in_string {
                if escaped {
                    escaped = false;
                } else if byte == b'\\' {
                    escaped = true;
                } else if byte == b'"' {
                    in_string = false;
                }
            } else if byte == b'"' {
                in_string = true;
            } else if byte == b'{' || byte == b'[' {
                depth += 1;
            } else if byte == b'}' || byte == b']' {
                depth -= 1;
                if depth == 0 {
                    index += 1;
                    values.push(json::parse(input.byte_slice(start, index))?);
                    complete = true;
                    break
                } else if depth < 0 {
                    return Result::Err(f"go list emitted unbalanced JSON at byte {index}")
                }
            }
            index += 1;
        }
        if !complete {
            return Result::Err(f"go list emitted incomplete JSON at byte {start}")
        }
    }
    Result::Ok(values)
}

pub fn discover_toolchain(go_binary: string) -> Result[GoToolchain, string] {
    let binary = process::look_path_structured(go_binary).map_err(|error| error.to_string())?;
    let output = process::Command::new(binary).arg("env").arg("-json").args(
        Vec::from_array(["GOROOT", "GOVERSION", "GOOS", "GOARCH", "CGO_ENABLED"]),
    ).env("GOTOOLCHAIN", "local").output_structured().map_err(|error| error.to_string())?;
    let root = json::parse(successful_output(output, "go env")?)?;
    let version = required_json_string(root, "GOVERSION")?;
    if !toolchain::compatible_version(version) {
        return Result::Err("gomlgo execution requires Go 1.26.x, found " + version)
    }
    Result::Ok(
        GoToolchain {
            binary,
            goroot: required_json_string(root, "GOROOT")?,
            version,
            host_goos: required_json_string(root, "GOOS")?,
            host_goarch: required_json_string(root, "GOARCH")?,
            host_cgo: required_json_string(root, "CGO_ENABLED")? == "1",
        },
    )
}

fn package_module_field(value: json::Value, name: string) -> Option[json::Value] {
    json::field(value, "Module").and_then(|module| json::field(module, name))
}

fn package_module_string(value: json::Value, name: string) -> string {
    match package_module_field(value, name) {
        Some(field) => json::as_string(field).unwrap_or(""),
        None => "",
    }
}

fn package_module_bool(value: json::Value, name: string) -> bool {
    match package_module_field(value, name) {
        Some(field) => json::as_bool(field).unwrap_or(false),
        None => false,
    }
}

fn decode_list_package(value: json::Value) -> Result[GoListPackage, string] {
    if let Some(error) = json::field(value, "Error") {
        let message = optional_json_string(error, "Err");
        if message != "" {
            return Result::Err(message)
        }
    }
    Result::Ok(
        GoListPackage {
            directory: required_json_string(value, "Dir")?,
            import_path: required_json_string(value, "ImportPath")?,
            name: required_json_string(value, "Name")?,
            standard: optional_json_bool(value, "Standard"),
            dependency_only: optional_json_bool(value, "DepOnly"),
            module_path: package_module_string(value, "Path"),
            module_main: package_module_bool(value, "Main"),
            module_go_version: package_module_string(value, "GoVersion"),
            go_files: optional_json_strings(value, "GoFiles")?,
            imports: optional_json_strings(value, "Imports")?,
        },
    )
}

fn listed_root_path(packages: Vec[GoListPackage]) -> Result[string, string] {
    let roots: Vec[string] = Vec::new();
    for package_value in packages {
        if !package_value.dependency_only {
            roots.push(package_value.import_path)
        }
    }
    if roots.len() == 1 {
        Result::Ok(roots[0])
    } else if roots.is_empty() {
        Result::Err("go list did not identify an entry package")
    } else {
        Result::Err("go list identified multiple entry packages")
    }
}

fn list_go_package_patterns(
    config: ExecutionConfig,
    toolchain: GoToolchain,
    directory: string,
    patterns: Vec[string],
) -> Result[GoListResult, string] {
    let command = process::Command::new(toolchain.binary).arg("list").arg("-deps").arg("-json");
    if !config.tags.is_empty() {
        let _ = command.arg("-tags").arg(text::join(config.tags, ","));
    }
    let output = command.args(patterns).current_dir(directory).env("GOTOOLCHAIN", "local").env(
        "GOOS",
        config.goos,
    ).env("GOARCH", config.goarch).env(
        "CGO_ENABLED",
        if config.cgo {
            "1"
        } else {
            "0"
        },
    ).output_structured().map_err(|error| error.to_string())?;
    let encoded = successful_output(output, "go list")?;
    let decoded = parse_json_stream(encoded)?;
    let packages: Vec[GoListPackage] = Vec::with_capacity(decoded.len());
    for value in decoded {
        packages.push(decode_list_package(value)?)
    }
    let root_path = listed_root_path(packages)?;
    Result::Ok(GoListResult { toolchain, packages, root_path })
}

pub fn list_go_packages(config: ExecutionConfig, toolchain: GoToolchain, directory: string) -> Result[
    GoListResult,
    string,
] {
    list_go_package_patterns(config, toolchain, directory, Vec::from_array(["."]))
}

pub fn list_go_files(
    config: ExecutionConfig,
    toolchain: GoToolchain,
    directory: string,
    files: Vec[string],
) -> Result[GoListResult, string] {
    list_go_package_patterns(config, toolchain, directory, files)
}
