package execution;

use gomlgo::checker;
use gomlgo::types as go_types;
use std::fs;
use std::path;
use std::text;

fn listed_package(packages: Vec[GoListPackage], package_path: string) -> Option[GoListPackage] {
    for package_value in packages {
        if package_value.import_path == package_path {
            return Option::Some(package_value)
        }
    }
    Option::None
}

fn visit_package(
    packages: Vec[GoListPackage],
    states: HashMap[string, isize],
    output: Vec[string],
    package_path: string,
) -> Result[(), string] {
    match states[package_path] {
        Some(1) => return Result::Err("package dependency cycle at " + package_path),
        Some(2) => return Result::Ok(()),
        _ => {},
    }
    let Some(package_value) = listed_package(packages, package_path) else {
        return Result::Err("go list omitted package " + package_path)
    };
    states[package_path] = 1;
    for dependency in package_value.imports {
        if dependency != "C" {
            visit_package(packages, states, output, dependency)?
        }
    }
    states[package_path] = 2;
    output.push(package_path);
    Result::Ok(())
}

fn package_order(value: GoListResult) -> Result[Vec[string], string] {
    let result: Vec[string] = Vec::new();
    visit_package(value.packages, HashMap::new(), result, value.root_path)?;
    Result::Ok(result)
}

fn execution_mode(config: ExecutionConfig, package_value: GoListPackage, root_path: string) -> ExecutionMode {
    if package_value.standard {
        ExecutionMode::Native
    } else if package_value.import_path == root_path || package_value.module_main
        || config.interpret_dependencies {
        ExecutionMode::Interpreted
    } else {
        ExecutionMode::Native
    }
}

fn package_sources(package_value: GoListPackage) -> Result[Vec[checker::SourceFile], string] {
    let result: Vec[checker::SourceFile] = Vec::with_capacity(package_value.go_files.len());
    for name in package_value.go_files {
        let file = path::join(package_value.directory, name);
        result.push(
            checker::SourceFile {
                name: file,
                source: fs::read_bytes_structured(file).map_err(|error| error.to_string())?,
            },
        )
    }
    if result.is_empty() {
        Result::Err("package " + package_value.import_path + " has no Go source files")
    } else {
        Result::Ok(result)
    }
}

fn checker_language_version(package_value: GoListPackage) -> string {
    if package_value.standard || package_value.module_go_version == "" {
        "go1.26"
    } else {
        let version = if package_value.module_go_version.starts_with("go") {
            package_value.module_go_version.byte_slice(
                2,
                package_value.module_go_version.byte_len(),
            )
        } else {
            package_value.module_go_version
        };
        let parts = text::split(version, ".");
        if parts.len() >= 2 && parts[0] == "1" {
            "go1." + parts[1]
        } else {
            "go1.26"
        }
    }
}

fn world_package(world: go_types::World, package_path: string) -> Option[go_types::PackageId] {
    for package_value in world.packages {
        if package_value.path == package_path || package_value.path == "vendor/" + package_path
            || package_value.path == "cmd/vendor/" + package_path {
            return Option::Some(package_value.id)
        }
    }
    Option::None
}

fn package_dependencies(world: go_types::World, package_value: GoListPackage) -> Result[
    Vec[go_types::PackageId],
    string,
] {
    let result: Vec[go_types::PackageId] = Vec::new();
    for dependency in package_value.imports {
        if dependency != "C" {
            match world_package(world, dependency) {
                Some(value) => result.push(value),
                None => return Result::Err(
                    "package " + package_value.import_path + " dependency " + dependency
                        + " was not loaded",
                ),
            }
        }
    }
    Result::Ok(result)
}

fn execution_diagnostic(package_path: string, value: checker::CheckDiagnostic) -> ExecutionDiagnostic {
    ExecutionDiagnostic {
        package_path,
        file: value.file,
        start: value.start,
        end: value.end,
        message: value.message,
        soft: value.soft,
        secondary: value.secondary,
    }
}

fn linker_diagnostic(package_path: string, message: string) -> ExecutionDiagnostic {
    ExecutionDiagnostic {
        package_path,
        file: "",
        start: -1,
        end: -1,
        message,
        soft: false,
        secondary: false,
    }
}

fn load_checked_packages(config: ExecutionConfig, listed: GoListResult) -> Result[
    ExecutionLoadResult,
    string,
] {
    let order = package_order(listed)?;
    let sizes = go_types::gc_sizes(config.goarch).ok_or("unsupported GOARCH " + config.goarch)?;
    let mut world = go_types::new_world();
    let packages: Vec[ExecutionPackage] = Vec::new();
    let initialization_order: Vec[go_types::PackageId] = Vec::new();
    let diagnostics: Vec[ExecutionDiagnostic] = Vec::new();
    for package_path in order {
        let package_value = listed_package(listed.packages, package_path).ok_or(
            "go list omitted package " + package_path,
        )?;
        let mode = execution_mode(config, package_value, listed.root_path);
        if package_path == "unsafe" {
            let dependencies = package_dependencies(world, package_value)?;
            packages.push(
                ExecutionPackage {
                    package_id: world.unsafe_package,
                    path: package_path,
                    name: "unsafe",
                    mode,
                    dependencies,
                    syntax: Option::None,
                    info: checker::empty_info(),
                    index: empty_type_info_index(world.unsafe_package),
                },
            );
            initialization_order.push(world.unsafe_package)
        } else {
            let checker_config = checker::default_config();
            checker_config.go_version = checker_language_version(package_value);
            checker_config.sizes = sizes;
            checker_config.ignore_func_bodies = mode == ExecutionMode::Native;
            checker_config.exported_api_only = mode == ExecutionMode::Native;
            checker_config.disable_unused_import_check = mode == ExecutionMode::Native;
            checker_config.retain_syntax_paths = false;
            let checked = checker::check_package_in_world(
                checker_config,
                checker::PackageInput {
                    path: package_value.import_path,
                    files: package_sources(package_value)?,
                },
                world,
            );
            world = checked.world;
            for diagnostic in checked.diagnostics {
                diagnostics.push(execution_diagnostic(package_path, diagnostic))
            }
            let dependencies = package_dependencies(world, package_value)?;
            let node_count = checked.syntax.arena.nodes.len();
            let file_count = checked.syntax.files.len();
            let indexed = build_type_info_index(
                world,
                checked.package_id,
                package_path,
                node_count,
                file_count,
                checked.info,
            );
            for diagnostic in indexed.diagnostics {
                diagnostics.push(diagnostic)
            }
            packages.push(
                ExecutionPackage {
                    package_id: checked.package_id,
                    path: package_path,
                    name: package_value.name,
                    mode,
                    dependencies,
                    syntax: if mode == ExecutionMode::Interpreted {
                        Option::Some(checked.syntax)
                    } else {
                        Option::None
                    },
                    info: checked.info,
                    index: indexed.index,
                },
            );
            initialization_order.push(checked.package_id)
        }
    }
    let root_id = world_package(world, listed.root_path).ok_or(
        "entry package was not loaded: " + listed.root_path,
    )?;
    let root_package = world.packages[root_id.value];
    if root_package.name != "main" {
        diagnostics.push(
            linker_diagnostic(
                listed.root_path,
                "entry package must be named main, found " + root_package.name,
            ),
        )
    }
    let mut main_function: Option[go_types::ObjectId] = Option::None;
    match go_types::lookup_local(world, root_package.scope, "main") {
        Some(object_id) => match go_types::get_object(world, object_id) {
            Some(object) => if object.kind == go_types::ObjectKind::Func {
                main_function = Option::Some(object_id);
            } else {
                diagnostics.push(linker_diagnostic(listed.root_path, "main.main is not a function"))
            },
            None => diagnostics.push(linker_diagnostic(listed.root_path, "main.main is invalid")),
        },
        None => diagnostics.push(linker_diagnostic(listed.root_path, "main.main is not defined")),
    }
    let program = if diagnostics.is_empty() {
        let package_indices: Vec[Option[isize]] = Vec::with_capacity(world.packages.len());
        for _ in world.packages {
            package_indices.push(Option::None)
        }
        for index in 0..packages.len() {
            let package_id = packages[index].package_id;
            if package_id.value >= 0 && package_id.value < package_indices.len() {
                package_indices[package_id.value] = Option::Some(index);
            }
        }
        main_function.map(
            |main_function| ExecutionProgram {
                world,
                packages,
                package_indices,
                initialization_order,
                main_package: root_id,
                main_function,
                toolchain: listed.toolchain,
            },
        )
    } else {
        Option::None
    };
    Result::Ok(ExecutionLoadResult { program, diagnostics })
}

pub fn load_program(config: ExecutionConfig, directory: string) -> Result[
    ExecutionLoadResult,
    string,
] {
    let directory = fs::canonicalize(directory).map_err(|error| error.to_string())?;
    let toolchain = discover_toolchain(config.go_binary)?;
    let listed = list_go_packages(config, toolchain, directory)?;
    load_checked_packages(config, listed)
}

pub fn load_files(config: ExecutionConfig, files: Vec[string]) -> Result[
    ExecutionLoadResult,
    string,
] {
    if files.len() != 1 {
        return Result::Err("single-file execution requires exactly one Go source file")
    }
    let first = fs::canonicalize(files[0]).map_err(|error| error.to_string())?;
    let directory = path::parent(first).ok_or("Go source file has no parent directory")?;
    let names = Vec::from_array([path::file_name(first).ok_or("Go source file has no file name")?]);
    let toolchain = discover_toolchain(config.go_binary)?;
    let listed = list_go_files(config, toolchain, directory, names)?;
    let diagnostics: Vec[ExecutionDiagnostic] = Vec::new();
    for package_value in listed.packages {
        if package_value.import_path != listed.root_path && !package_value.standard {
            diagnostics.push(
                linker_diagnostic(
                    listed.root_path,
                    "single-file execution does not support non-standard import "
                        + package_value.import_path,
                ),
            )
        }
    }
    if !diagnostics.is_empty() {
        return Result::Ok(ExecutionLoadResult { program: Option::None, diagnostics })
    }
    load_checked_packages(config, listed)
}
