package interpreter;

use gomlgo::types as go_types;
use std::collections;

struct ChannelValue {
    element_type: go_types::TypeId,
    capacity: isize,
    values: collections::Deque[Value],
    closed: Ref[bool],
}

fn new_channel_value(element_type: go_types::TypeId, capacity: isize) -> ChannelValue {
    ChannelValue {
        element_type,
        capacity,
        values: collections::Deque::with_capacity(capacity),
        closed: Ref::new(false),
    }
}

fn channel_length(channel: ChannelValue) -> isize {
    channel.values.len()
}

fn channel_can_buffer_send(channel: ChannelValue) -> bool {
    channel.capacity > channel_length(channel)
}

fn channel_has_value(channel: ChannelValue) -> bool {
    channel_length(channel) > 0
}

fn channel_buffer_send(channel: ChannelValue, value: Value) -> Result[(), string] {
    if channel.closed.get() {
        Result::Err("send on closed channel")
    } else if !channel_can_buffer_send(channel) {
        Result::Err("channel buffer is full")
    } else {
        channel.values.push_back(copy_value(value));
        Result::Ok(())
    }
}

fn channel_buffer_receive(channel: ChannelValue) -> Result[Value, string] {
    if !channel_has_value(channel) {
        Result::Err("channel buffer is empty")
    } else {
        Result::Ok(copy_value(channel.values.pop_front().ok_or("channel buffer is empty")?))
    }
}

fn channel_close(channel: ChannelValue) -> Result[(), string] {
    if channel.closed.get() {
        Result::Err("close of closed channel")
    } else {
        channel.closed.set(true);
        Result::Ok(())
    }
}
