fn assert_runtime_error(name: string, message: string) -> () {
    let result = run(load_bytecode(name), default_config());
    testing::assert_eq(result.exit_code, 1);
    let error = testing::expect_some(result.error, "runtime error is missing for " + name);
    let _ = testing::expect_some(error.location, "runtime error location is missing for " + name);
    let stderr = result.stderr.to_string_utf8().unwrap_or("<non-UTF-8>");
    if !stderr.contains(message) {
        testing::fail("runtime error for " + name + " was: " + stderr)
    }
}

#[test]
fn reports_sequential_runtime_errors() -> () {
    assert_runtime_error("runtime_divide_zero", "integer divide by zero");
    assert_runtime_error("runtime_index", "index out of range");
    assert_runtime_error("runtime_nil_pointer", "nil pointer dereference");
    assert_runtime_error("runtime_make_slice", "makeslice: len out of range")
}

fn assert_matches_go(name: string) -> () {
    let config = execution::default_config();
    let native = testing::expect_ok(
        process::Command::new(config.go_binary).arg("run").arg("main.go").current_dir(fixture(name)).env(
            "GOTOOLCHAIN",
            "local",
        ).output_structured(),
        "Go execution failed",
    );
    let interpreted = run(load_bytecode(name), default_config());
    if interpreted.exit_code
        != process::ExitStatus::code(process::Output::status(native)).unwrap_or(-1) {
        testing::fail(
            "exit mismatch for " + name + ": "
                + interpreted.stderr.to_string_utf8().unwrap_or("<non-UTF-8>"),
        )
    }
    testing::assert_eq(
        interpreted.exit_code,
        process::ExitStatus::code(process::Output::status(native)).unwrap_or(-1),
    );
    testing::assert_eq(
        interpreted.stdout.to_string_utf8().unwrap_or("<non-UTF-8>"),
        process::Output::stdout(native).to_string_utf8().unwrap_or("<non-UTF-8>"),
    );
    testing::assert_eq(
        interpreted.stderr.to_string_utf8().unwrap_or("<non-UTF-8>"),
        process::Output::stderr(native).to_string_utf8().unwrap_or("<non-UTF-8>"),
    )
}

#[test]
fn matches_go126_for_m1_single_file_corpus() -> () {
    assert_matches_go("control");
    assert_matches_go("control_flow");
    assert_matches_go("aggregate_slice");
    assert_matches_go("string_byte_conversion");
    assert_matches_go("basic_values");
    assert_matches_go("range_values");
    assert_matches_go("globals_init");
    assert_matches_go("maps");
    assert_matches_go("methods_interfaces");
    assert_matches_go("closures");
    assert_matches_go("type_switch");
    assert_matches_go("defer_panic_recover");
    assert_matches_go("runtime_fault_recover")
}

#[test]
fn matches_go126_for_mixed_numeric_switch_comparisons() -> () {
    assert_matches_go("float_match")
}

#[test]
fn matches_go126_for_cooperative_scheduler() -> () {
    assert_matches_go("channels");
    assert_matches_go("select");
    assert_matches_go("channel_panic_recover");
    assert_matches_go("defer_channels")
}

#[test]
fn matches_go126_for_generic_instances() -> () {
    assert_matches_go("generics")
}

#[test]
fn stops_execution_when_instruction_fuel_is_exhausted() -> () {
    let config = default_config();
    config.max_steps = 3.to_i64();
    let result = run(load_bytecode("control"), config);
    testing::assert_eq(result.exit_code, 1);
    testing::assert(result.error.is_some());
    testing::assert(result.stderr.to_string_utf8().unwrap_or("").contains("instruction limit"))
}

#[test]
fn copies_aggregate_values_and_preserves_pointer_identity() -> () {
    let world = go_types::new_world();
    let int_type = testing::expect_some(go_types::basic_type(world, "int"), "missing int type");
    let array_type = go_types::add_type(
        world,
        go_types::TypeKind::Array { length: 2.to_i64(), element: int_type },
    );
    let memory = new_memory();
    let initial = testing::expect_ok(zero_value(world, array_type), "zero array failed");
    let first = allocate_cell(memory, initial);
    let second = allocate_cell(
        memory,
        testing::expect_ok(load_place(memory, root_place(first)), "array load failed"),
    );
    let one = testing::expect_ok(
        constant_value(world, int_type, "Int", "1"),
        "integer constant failed",
    );
    testing::assert_ok(store_place(memory, index_place(root_place(first), 0), one));
    let original = testing::expect_ok(
        load_place(memory, index_place(root_place(first), 0)),
        "original load failed",
    );
    let copied = testing::expect_ok(
        load_place(memory, index_place(root_place(second), 0)),
        "copied load failed",
    );
    testing::assert(!testing::expect_ok(values_equal(world, original, copied), "comparison failed"));
    let pointer = Value::Local(LocalValue::Pointer(Option::Some(root_place(first))));
    testing::assert(
        testing::expect_ok(
            values_equal(world, pointer, copy_value(pointer)),
            "pointer comparison failed",
        ),
    )
}

#[test]
fn preserves_precise_float64_constant_bits() -> () {
    let world = go_types::new_world();
    let float_type = testing::expect_some(
        go_types::basic_type(world, "float64"),
        "missing float64 type",
    );
    let value = testing::expect_ok(
        constant_value(world, float_type, "Float", "183186547087/10"),
        "float constant conversion failed",
    );
    match value {
        Value::Local(LocalValue::Float { bits, width }) => {
            testing::assert_eq(width, 64);
            testing::assert_eq(bits, float64_bits(18318654708.7))
        },
        _ => testing::fail("float constant did not produce a floating-point value"),
    }
}

#[test]
fn passes_host_backed_interfaces_directly_to_native_calls() -> () {
    let program = load_bytecode("control");
    let world = program.world;
    let package_id = go_types::add_package(world, "example/host", "host", world.universe, false);
    let object = go_types::add_object(
        world,
        go_types::ObjectKind::TypeName,
        "HostInterface",
        Option::Some(package_id),
        Option::None,
        Option::None,
        0,
        world.invalid,
    );
    let underlying = go_types::add_type(
        world,
        go_types::TypeKind::Interface {
            methods: Vec::new(),
            embeddeds: Vec::new(),
            comparable: false,
            implicit: false,
        },
    );
    let interface_type = go_types::add_type(
        world,
        go_types::TypeKind::Named {
            object,
            underlying,
            type_params: Vec::new(),
            type_args: Vec::new(),
            methods: Vec::new(),
        },
    );
    testing::assert(go_types::set_object_type(world, object, interface_type));
    let string_type = testing::expect_some(
        go_types::basic_type(world, "string"),
        "missing string type",
    );
    let host = new_native_string("host");
    let state = testing::expect_ok(
        initialize_state(program, default_config()),
        "VM initialization failed",
    );
    let converted = testing::expect_ok(
        native_argument(
            state,
            Value::Interface {
                static_type: interface_type,
                dynamic_type: Option::Some(string_type),
                value: Option::Some(Ref::new(Value::Host { type_id: string_type, value: host })),
            },
            interface_type,
            "interface",
        ),
        "host interface conversion failed",
    );
    testing::assert_eq(native_value_string(converted), "host");
    testing::assert(state.native_callbacks.is_empty())
}
