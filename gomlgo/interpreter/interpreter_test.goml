#[test]
fn selects_ready_cases_from_the_configured_seed() -> () {
    let first_config = default_config();
    first_config.select_seed = 1.to_u64();
    let first = run(load_bytecode("select_seed"), first_config);
    let repeated = run(load_bytecode("select_seed"), first_config);
    testing::assert_eq(first.exit_code, 0);
    testing::assert_eq(first.stderr.to_string_utf8().unwrap_or(""), "first 1\nblocked-second\n");
    testing::assert_eq(
        repeated.stderr.to_string_utf8().unwrap_or(""),
        first.stderr.to_string_utf8().unwrap_or(""),
    );
    let second_config = default_config();
    second_config.select_seed = 2.to_u64();
    let second = run(load_bytecode("select_seed"), second_config);
    testing::assert_eq(second.exit_code, 0);
    testing::assert_eq(second.stderr.to_string_utf8().unwrap_or(""), "second 2\nblocked-first\n")
}

#[test]
fn reports_scheduler_deadlocks() -> () {
    let result = run(load_bytecode("deadlock"), default_config());
    testing::assert_eq(result.exit_code, 1);
    testing::assert(result.error.is_some());
    testing::assert(
        result.stderr.to_string_utf8().unwrap_or("").contains(
            "fatal error: all goroutines are asleep - deadlock!",
        ),
    )
}

