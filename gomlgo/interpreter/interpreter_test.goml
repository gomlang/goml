#[test]
fn passes_native_backed_pointers_through_native_interfaces() -> () {
    let program = load_bytecode("native_locker");
    let manifest = testing::expect_ok(bytecode::native_manifest(program), "native manifest failed");
    if let Some(error) = native::install_catalog_error(manifest) {
        testing::fail(error)
    }
    let result = run(program, default_config());
    if result.exit_code != 0 {
        testing::fail(result.stderr.to_string_utf8().unwrap_or("native locker execution failed"))
    }
    testing::assert_eq(result.stderr.to_string_utf8().unwrap_or(""), "true\n");
    testing::assert(result.error.is_none())
}

