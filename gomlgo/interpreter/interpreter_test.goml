use std::utf8;
use utf8::BytesUtf8;

fn fixture(name: string) -> string {
    path::join(
        path::join(env::current_dir_structured().unwrap_or("."), "testdata/execute/pure"),
        name,
    )
}

fn load_bytecode(name: string) -> bytecode::BytecodeProgram {
    let file = path::join(fixture(name), "main.go");
    let loaded = testing::expect_ok(
        execution::load_files(execution::default_config(), Vec::from_array([file])),
        "execution loading failed",
    );
    if !loaded.diagnostics.is_empty() {
        testing::fail(loaded.diagnostics[0].message);
        loop {}
    }
    let lowered = bytecode::lower(
        testing::expect_some(loaded.program, "execution program is missing"),
    );
    if !lowered.diagnostics.is_empty() {
        testing::fail(lowered.diagnostics[0].message);
        loop {}
    }
    testing::expect_some(lowered.program, "bytecode program is missing")
}

fn blocked_scheduler_goroutine() -> ScheduledGoroutine {
    ScheduledGoroutine {
        frames: Vec::new(),
        pending: Ref::new(Option::None),
        native: Ref::new(Option::None),
        native_channel: Ref::new(Option::None),
        state: Ref::new(1),
        startup: false,
    }
}

fn test_instruction(kind: bytecode::InstructionKind) -> bytecode::Instruction {
    bytecode::Instruction {
        kind,
        location: bytecode::CodeLocation { file: syntax::file_id(-1), start: 0, end: 0 },
    }
}

fn test_function(local_count: isize, place_count: isize, instructions: Vec[bytecode::Instruction]) -> bytecode::BytecodeFunction {
    let locals: Vec[bytecode::Local] = Vec::with_capacity(local_count);
    for index in 0..local_count {
        locals.push(
            bytecode::Local {
                id: bytecode::local_id(index),
                object: Option::None,
                name: "",
                type_id: go_types::type_id(-1),
            },
        )
    }
    bytecode::BytecodeFunction {
        id: bytecode::function_id(0),
        package_id: go_types::package_id(-1),
        object: go_types::object_id(-1),
        name: "",
        signature: go_types::type_id(-1),
        register_types: Vec::new(),
        place_count,
        locals,
        captures: Vec::new(),
        parameters: Vec::new(),
        results: Vec::new(),
        blocks: Vec::from_array(
            [
                bytecode::BasicBlock {
                    id: bytecode::block_id(0),
                    parameters: Vec::new(),
                    instructions,
                    terminator: bytecode::Terminator {
                        kind: bytecode::TerminatorKind::Unreachable,
                        location: bytecode::CodeLocation {
                            file: syntax::file_id(-1),
                            start: 0,
                            end: 0,
                        },
                    },
                },
            ],
        ),
        entry: bytecode::block_id(0),
    }
}

#[test]
fn identifies_only_locals_with_escaping_storage() -> () {
    let function = test_function(
        3,
        3,
        Vec::from_array(
            [
                test_instruction(
                    bytecode::InstructionKind::LocalPlace {
                        target: bytecode::place_id(0),
                        local: bytecode::local_id(0),
                    },
                ),
                test_instruction(
                    bytecode::InstructionKind::FieldPlace {
                        target: bytecode::place_id(1),
                        base: bytecode::place_id(0),
                        index: Vec::from_array([0]),
                    },
                ),
                test_instruction(
                    bytecode::InstructionKind::AddressOf {
                        target: bytecode::register_id(0),
                        source: bytecode::place_id(1),
                    },
                ),
                test_instruction(
                    bytecode::InstructionKind::MakeClosure {
                        target: bytecode::register_id(1),
                        function: bytecode::function_id(1),
                        captures: Vec::from_array([bytecode::local_id(1)]),
                    },
                ),
                test_instruction(
                    bytecode::InstructionKind::LocalPlace {
                        target: bytecode::place_id(2),
                        local: bytecode::local_id(2),
                    },
                ),
            ],
        ),
    );
    let recyclable = recyclable_function_locals(function);
    testing::assert(!recyclable[0]);
    testing::assert(!recyclable[1]);
    testing::assert(recyclable[2])
}

#[test]
fn reuses_released_frame_cells() -> () {
    let memory = new_memory();
    let first = allocate_reusable_cell(memory, Value::Local(LocalValue::Bool(false)));
    release_reusable_cell(memory, first);
    let second = allocate_reusable_cell(memory, Value::Local(LocalValue::Bool(true)));
    testing::assert_eq(first.value, second.value);
    testing::assert_eq(memory.length.get(), 1);
    testing::assert(
        testing::expect_ok(
            boolean_value(testing::expect_ok(load_place(memory, root_place(second)), "load failed")),
            "boolean failed",
        ),
    )
}

#[test]
fn excludes_native_call_waiters_from_channel_matching() -> () {
    let goroutine = blocked_scheduler_goroutine();
    testing::assert(scheduled_channel_waiter(goroutine));
    goroutine.native.set(
        Option::Some(
            ScheduledNativeCall {
                native: NativePrepared {
                    id: Option::None,
                    function: Option::None,
                    parameter_types: Vec::new(),
                    parameter_keys: Vec::new(),
                    result_types: Vec::new(),
                    result_keys: Vec::new(),
                    variadic: false,
                    reflect_value_of: false,
                    runtime_stack: false,
                    argument_slices: Vec::new(),
                },
                invocation: new_native_invocation(0, false),
                owner: Option::None,
                results: Vec::new(),
                deferred: false,
            },
        ),
    );
    testing::assert(!scheduled_channel_waiter(goroutine))
}

#[test]
fn executes_functions_assignments_loops_and_switches() -> () {
    let result = run(load_bytecode("control"), default_config());
    testing::assert_eq(result.exit_code, 0);
    testing::assert_eq(result.stdout.to_string_utf8().unwrap_or(""), "");
    testing::assert_eq(result.stderr.to_string_utf8().unwrap_or(""), "6\n");
    testing::assert(result.error.is_none());
    testing::assert(result.steps > 0.to_i64())
}

