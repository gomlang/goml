pub trait HostValueMarker {}

pub type HostValueRef = dyn HostValueMarker;

pub struct NativeInvocation {
    pub value: HostValueRef,
}

pub struct NativeCompletionQueue {
    pub value: HostValueRef,
}

pub struct NativeHostValue {
    pub value: HostValueRef,
}

pub struct NativeCallbackQueue {
    pub value: HostValueRef,
}

pub struct NativeCallbackRequest {
    pub value: HostValueRef,
}

pub struct NativeCallbackCompletion {
    pub value: HostValueRef,
}

pub struct NativeChannelInvocation {
    pub value: HostValueRef,
}

