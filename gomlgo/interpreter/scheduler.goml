package interpreter;

use gomlgo::bytecode;
use gomlgo::types as go_types;

struct ScheduledInvocation {
    function: bytecode::FunctionId,
    arguments: Vec[Value],
    captures: Vec[CellId],
}

struct ScheduledFrame {
    frame: Frame,
    instruction: Ref[isize],
    waiting: Ref[bool],
    results: Vec[bytecode::RegisterId],
    finishing: Ref[bool],
    panic: Ref[Option[PanicState]],
    deferred: bool,
    callback: Ref[Option[ScheduledCallback]],
}

struct ScheduledPendingCall {
    caller: Frame,
    call: PreparedCall,
}

struct ScheduledNativeCall {
    native: NativePrepared,
    invocation: NativeInvocation,
    owner: Option[ScheduledFrame],
    results: Vec[bytecode::RegisterId],
    deferred: bool,
}

enum ScheduledNativeChannelTarget {
    Receive {
        value: bytecode::RegisterId,
        ok: Option[bytecode::RegisterId],
        element_type: go_types::TypeId,
    },
    Select {
        chosen: bytecode::RegisterId,
        cases: Vec[bytecode::SelectCase],
        native_indices: Vec[isize],
    },
}

struct ScheduledNativeChannel {
    invocation: NativeChannelInvocation,
    owner: ScheduledFrame,
    target: ScheduledNativeChannelTarget,
}

struct ScheduledCallback {
    request: NativeCallbackRequest,
    completion: NativeCallbackCompletion,
    arguments: Vec[Value],
    argument_types: Vec[go_types::TypeId],
    argument_keys: Vec[string],
    result_types: Vec[go_types::TypeId],
    result_keys: Vec[string],
}

struct ScheduledGoroutine {
    frames: Vec[ScheduledFrame],
    pending: Ref[Option[ScheduledPendingCall]],
    native: Ref[Option[ScheduledNativeCall]],
    native_channel: Ref[Option[ScheduledNativeChannel]],
    state: Ref[isize],
    startup: bool,
}

struct Scheduler {
    state: VmState,
    goroutines: Vec[ScheduledGoroutine],
    entries: Vec[bytecode::FunctionId],
    next_entry: Ref[isize],
    cursor: Ref[isize],
    random: Ref[u64],
    native_completions: NativeCompletionQueue,
}

struct WaitingOperation {
    goroutine: isize,
    case_index: isize,
}

struct ScheduledInstruction {
    instructions: Vec[bytecode::Instruction],
    index: isize,
    present: bool,
    message: string,
}

enum SendAttempt {
    Sent,
    Blocked,
    Panicked(PanicPayload),
}

enum ReceiveAttempt {
    Received {
        value: Value,
        ok: bool,
    },
    Blocked,
}

fn scheduled_entries(state: VmState) -> Vec[bytecode::FunctionId] {
    let entries: Vec[bytecode::FunctionId] = Vec::new();
    for package_id in state.program.initialization_order {
        for package_value in state.program.packages {
            if package_value.package_id.value == package_id.value {
                if let Some(function) = package_value.initializer {
                    entries.push(function)
                }
            }
        }
    }
    entries.push(state.program.main);
    entries
}

fn new_scheduler(state: VmState) -> Scheduler {
    Scheduler {
        state,
        goroutines: Vec::new(),
        entries: scheduled_entries(state),
        next_entry: Ref::new(0),
        cursor: Ref::new(0),
        random: Ref::new(state.config.select_seed),
        native_completions: state.native_completions,
    }
}

fn scheduled_frame(
    state: VmState,
    invocation: ScheduledInvocation,
    results: Vec[bytecode::RegisterId],
    recover_state: Option[PanicState],
    deferred: bool,
) -> Result[ScheduledFrame, string] {
    validate_function(state, invocation.function)?;
    let function = state.program.functions[invocation.function.value];
    let frame_result = frame_for_call(
        state,
        function,
        invocation.arguments,
        invocation.captures,
        recover_state,
        false,
    );
    if frame_result.error != "" {
        return Result::Err(frame_result.error)
    }
    Result::Ok(
        ScheduledFrame {
            frame: frame_result.frame,
            instruction: Ref::new(0),
            waiting: Ref::new(false),
            results,
            finishing: Ref::new(false),
            panic: Ref::new(Option::None),
            deferred,
            callback: Ref::new(Option::None),
        },
    )
}

fn start_next_entry(scheduler: Scheduler, goroutine: ScheduledGoroutine) -> Result[bool, string] {
    let index = scheduler.next_entry.get();
    if index >= scheduler.entries.len() {
        Result::Ok(false)
    } else {
        scheduler.next_entry.set(index + 1);
        goroutine.frames.push(
            scheduled_frame(
                scheduler.state,
                ScheduledInvocation {
                    function: scheduler.entries[index],
                    arguments: Vec::new(),
                    captures: Vec::new(),
                },
                Vec::new(),
                Option::None,
                false,
            )?,
        );
        goroutine.state.set(0);
        Result::Ok(true)
    }
}

fn start_scheduler(scheduler: Scheduler) -> Result[(), string] {
    let startup = ScheduledGoroutine {
        frames: Vec::new(),
        pending: Ref::new(Option::None),
        native: Ref::new(Option::None),
        native_channel: Ref::new(Option::None),
        state: Ref::new(0),
        startup: true,
    };
    scheduler.goroutines.push(startup);
    if !start_next_entry(scheduler, startup)? {
        return Result::Err("program has no entry function")
    }
    Result::Ok(())
}

fn scheduled_top(goroutine: ScheduledGoroutine) -> Result[ScheduledFrame, string] {
    if goroutine.frames.is_empty() {
        Result::Err("goroutine has no frame")
    } else {
        Result::Ok(goroutine.frames[goroutine.frames.len() - 1])
    }
}

fn append_invocation_arguments(receiver: Value, arguments: Vec[Value]) -> Vec[Value] {
    let result = Vec::from_array([receiver]);
    for argument in arguments {
        result.push(argument)
    }
    result
}

fn scheduled_interface_invocation(
    state: VmState,
    method: go_types::ObjectId,
    receiver: Value,
    arguments: Vec[Value],
    first_argument: isize,
) -> Result[ScheduledInvocation, string] {
    let method_object = state.program.world.objects[method.value];
    let (dynamic_type, dynamic_value) = match receiver {
        Value::Interface { static_type: _, dynamic_type: Some(dynamic_type), value: Some(value) } => (
            dynamic_type,
            value.get(),
        ),
        _ => return Result::Err("interface method " + method_object.name + " has a nil receiver"),
    };
    let selection = go_types::lookup_field_or_method(
        state.program.world,
        dynamic_type,
        true,
        method_object.name,
    ).ok_or("dynamic interface method was not found")?;
    let function = state.program.object_functions[selection.object.value].ok_or(
        "scheduled dynamic interface method " + method_object.name + " on "
            + go_types::format_type(state.program.world, dynamic_type)
            + " has no interpreted body",
    )?;
    let values = Vec::from_array(
        [
            method_expression_receiver(
                state,
                state.program.functions[function.value],
                dynamic_value,
                dynamic_type,
                selection.index,
            )?,
        ],
    );
    for index in first_argument..arguments.len() {
        values.push(arguments[index])
    }
    Result::Ok(ScheduledInvocation { function, arguments: values, captures: Vec::new() })
}

fn scheduled_call(state: VmState, call: PreparedCall) -> Result[Option[ScheduledInvocation], string] {
    match call.target {
        PreparedTarget::Static(function) => Result::Ok(
            Option::Some(
                ScheduledInvocation { function, arguments: call.arguments, captures: Vec::new() },
            ),
        ),
        PreparedTarget::Method { function, receiver } => Result::Ok(
            Option::Some(
                ScheduledInvocation {
                    function,
                    arguments: append_invocation_arguments(receiver, call.arguments),
                    captures: Vec::new(),
                },
            ),
        ),
        PreparedTarget::InterfaceMethod { method, receiver } => Result::Ok(
            Option::Some(
                scheduled_interface_invocation(state, method, receiver, call.arguments, 0)?,
            ),
        ),
        PreparedTarget::Dynamic(target) => match target {
            Value::Host { type_id: _, value: _ } => Result::Ok(Option::None),
            Value::Local(LocalValue::Function(Some(value))) => match value.target {
                FunctionTarget::Bytecode(function) => {
                    let arguments = match value.receiver {
                        Some(receiver) => append_invocation_arguments(
                            receiver.get(),
                            call.arguments,
                        ),
                        None => call.arguments,
                    };
                    Result::Ok(
                        Option::Some(
                            ScheduledInvocation { function, arguments, captures: value.captures },
                        ),
                    )
                },
                FunctionTarget::MethodExpression { function, receiver_type, index } => {
                    if call.arguments.is_empty() {
                        return Result::Err("method expression call has no receiver")
                    }
                    let arguments = Vec::from_array(
                        [
                            method_expression_receiver(
                                state,
                                state.program.functions[function.value],
                                call.arguments[0],
                                receiver_type,
                                index,
                            )?,
                        ],
                    );
                    for index in 1..call.arguments.len() {
                        arguments.push(call.arguments[index])
                    }
                    Result::Ok(
                        Option::Some(
                            ScheduledInvocation { function, arguments, captures: value.captures },
                        ),
                    )
                },
                FunctionTarget::InterfaceMethod(method) => {
                    let receiver = match value.receiver {
                        Some(receiver) => receiver.get(),
                        None => if call.arguments.is_empty() {
                            return Result::Err("interface method expression call has no receiver")
                        } else {
                            call.arguments[0]
                        },
                    };
                    Result::Ok(
                        Option::Some(
                            scheduled_interface_invocation(
                                state,
                                method,
                                receiver,
                                call.arguments,
                                if value.receiver.is_some() {
                                    0
                                } else {
                                    1
                                },
                            )?,
                        ),
                    )
                },
            },
            Value::Local(LocalValue::Function(None)) => Result::Err("call of nil function"),
            _ => Result::Err("dynamic call target is not a function"),
        },
        PreparedTarget::Native(_) | PreparedTarget::Builtin(_) => Result::Ok(Option::None),
    }
}

fn invalid_scheduled_instruction(message: string) -> ScheduledInstruction {
    ScheduledInstruction { instructions: Vec::new(), index: -1, present: false, message }
}

fn scheduled_instruction(scheduled: ScheduledFrame) -> ScheduledInstruction {
    let block_id = scheduled.frame.block.get();
    if block_id.value < 0 || block_id.value >= scheduled.frame.blocks.len() {
        return invalid_scheduled_instruction(f"invalid current block {block_id.value}")
    }
    let block = scheduled.frame.blocks[block_id.value];
    let index = scheduled.instruction.get();
    if index < 0 || index > block.instructions.len() {
        invalid_scheduled_instruction(f"invalid current instruction {index}")
    } else {
        ScheduledInstruction {
            instructions: block.instructions,
            index,
            present: index < block.instructions.len(),
            message: "",
        }
    }
}

fn scheduled_current_instruction(scheduled: ScheduledFrame) -> Result[
    Option[bytecode::Instruction],
    string,
] {
    let current = scheduled_instruction(scheduled);
    if current.message != "" {
        Result::Err(current.message)
    } else if current.present {
        Result::Ok(Option::Some(current.instructions[current.index]))
    } else {
        Result::Ok(Option::None)
    }
}

fn scheduled_channel_id(frame: Frame, register_id: bytecode::RegisterId) -> Result[isize, string] {
    match register(frame, register_id)? {
        Value::Local(LocalValue::Channel(value)) => Result::Ok(value),
        _ => Result::Err("channel operation source is not a channel"),
    }
}

fn scheduled_channel_matches(frame: Frame, register_id: bytecode::RegisterId, target: isize) -> Result[
    bool,
    string,
] {
    match register(frame, register_id)? {
        Value::Local(LocalValue::Channel(value)) => Result::Ok(value == target),
        Value::Host { type_id: _, value: _ } => Result::Ok(false),
        _ => Result::Err("channel operation source is not a channel"),
    }
}

fn checked_channel(state: VmState, id: isize) -> Result[ChannelValue, string] {
    if id < 0 || id >= state.channels.len() {
        Result::Err(f"invalid channel {id}")
    } else {
        Result::Ok(state.channels[id])
    }
}

fn instruction_channel_matches(
    scheduler: Scheduler,
    goroutine: ScheduledGoroutine,
    target: isize,
    receive: bool,
    choose: bool,
) -> Result[isize, string] {
    let scheduled = scheduled_top(goroutine)?;
    match scheduled_current_instruction(scheduled)? {
        Some(bytecode::Instruction {
            kind: bytecode::InstructionKind::Send { channel, value: _ },
            location: _,
        }) => if !receive && scheduled_channel_matches(scheduled.frame, channel, target)? {
            Result::Ok(-1)
        } else {
            Result::Ok(-2)
        },
        Some(bytecode::Instruction {
            kind: bytecode::InstructionKind::Receive { value: _, ok: _, channel },
            location: _,
        }) => if receive && scheduled_channel_matches(scheduled.frame, channel, target)? {
            Result::Ok(-1)
        } else {
            Result::Ok(-2)
        },
        Some(bytecode::Instruction {
            kind: bytecode::InstructionKind::Select { chosen: _, cases },
            location: _,
        }) => {
            let matches: Vec[isize] = Vec::new();
            for index in 0..cases.len() {
                let matched = match cases[index].operation {
                    bytecode::SelectOperation::Send { channel, value: _ } => !receive
                        && scheduled_channel_matches(scheduled.frame, channel, target)?,
                    bytecode::SelectOperation::Receive { channel, value: _, ok: _ } => receive
                        && scheduled_channel_matches(scheduled.frame, channel, target)?,
                    bytecode::SelectOperation::Default => false,
                };
                if matched {
                    matches.push(index)
                }
            }
            if matches.is_empty() {
                Result::Ok(-2)
            } else if choose {
                Result::Ok(select_choice(scheduler, matches))
            } else {
                Result::Ok(matches[0])
            }
        },
        _ => Result::Ok(-2),
    }
}

fn cancel_scheduled_native_channel(
    scheduler: Scheduler,
    goroutine_index: isize,
    pending: ScheduledNativeChannel,
) -> Result[(), string] {
    if !cancel_native_channel_invocation_value(pending.invocation.value) {
        return Result::Err("native channel invocation could not be canceled")
    } else if !wait_native_channel_invocation_value(pending.invocation.value) {
        return Result::Err("native channel invocation cancellation could not be joined")
    }
    complete_native_channel(scheduler, goroutine_index, pending)
}

fn scheduled_channel_waiter(goroutine: ScheduledGoroutine) -> bool {
    goroutine.state.get() == 1 && goroutine.native.get().is_none()
}

fn find_waiting_operation(scheduler: Scheduler, current: isize, channel: isize, receive: bool) -> Result[
    Option[WaitingOperation],
    string,
] {
    for index in 0..scheduler.goroutines.len() {
        let goroutine = scheduler.goroutines[index];
        if index != current && scheduled_channel_waiter(goroutine) {
            let case_index = instruction_channel_matches(
                scheduler,
                goroutine,
                channel,
                receive,
                true,
            )?;
            if case_index >= -1 {
                match goroutine.native_channel.get() {
                    Some(pending) => {
                        cancel_scheduled_native_channel(scheduler, index, pending)?;
                        return Result::Ok(
                            Option::Some(WaitingOperation { goroutine: index, case_index }),
                        )
                    },
                    None => return Result::Ok(
                        Option::Some(WaitingOperation { goroutine: index, case_index }),
                    ),
                }
            }
        }
    }
    Result::Ok(Option::None)
}

fn select_case_enter(
    scheduler: Scheduler,
    goroutine: ScheduledGoroutine,
    scheduled: ScheduledFrame,
    chosen: bytecode::RegisterId,
    cases: Vec[bytecode::SelectCase],
    case_index: isize,
) -> Result[(), string] {
    let selected = cases[case_index];
    let arguments = block_argument_values(scheduled.frame, selected.arguments)?;
    let chosen_type = scheduler.state.program.functions[scheduled.frame.function.value].register_types[chosen.value];
    set_register(
        scheduled.frame,
        chosen,
        integer_for_type(scheduler.state, chosen_type, case_index)?,
    )?;
    enter_block(
        scheduler.state.program.functions[scheduled.frame.function.value],
        scheduled.frame,
        selected.target,
        arguments,
    )?;
    scheduled.instruction.set(0);
    scheduled.waiting.set(false);
    goroutine.state.set(0);
    Result::Ok(())
}

fn complete_waiting_receive(scheduler: Scheduler, waiting: WaitingOperation, value: Value) -> Result[
    (),
    string,
] {
    let goroutine = scheduler.goroutines[waiting.goroutine];
    let scheduled = scheduled_top(goroutine)?;
    match scheduled_current_instruction(scheduled)? {
        Some(bytecode::Instruction {
            kind: bytecode::InstructionKind::Receive { value: target, ok, channel: _ },
            location: _,
        }) => {
            set_register(scheduled.frame, target, value)?;
            if let Some(target) = ok {
                set_register(scheduled.frame, target, Value::Local(LocalValue::Bool(true)))?
            }
            scheduled.instruction.set(scheduled.instruction.get() + 1);
            scheduled.waiting.set(false);
            goroutine.state.set(0);
            Result::Ok(())
        },
        Some(bytecode::Instruction {
            kind: bytecode::InstructionKind::Select { chosen, cases },
            location: _,
        }) => match cases[waiting.case_index].operation {
            bytecode::SelectOperation::Receive { channel: _, value: target, ok } => {
                set_register(scheduled.frame, target, value)?;
                if let Some(target) = ok {
                    set_register(scheduled.frame, target, Value::Local(LocalValue::Bool(true)))?
                }
                select_case_enter(
                    scheduler,
                    goroutine,
                    scheduled,
                    chosen,
                    cases,
                    waiting.case_index,
                )
            },
            _ => Result::Err("waiting select case is not a receive"),
        },
        _ => Result::Err("waiting receive is no longer at a receive instruction"),
    }
}

fn complete_waiting_send(scheduler: Scheduler, waiting: WaitingOperation) -> Result[Value, string] {
    let goroutine = scheduler.goroutines[waiting.goroutine];
    let scheduled = scheduled_top(goroutine)?;
    match scheduled_current_instruction(scheduled)? {
        Some(bytecode::Instruction {
            kind: bytecode::InstructionKind::Send { channel: _, value },
            location: _,
        }) => {
            let result = register(scheduled.frame, value)?;
            scheduled.instruction.set(scheduled.instruction.get() + 1);
            scheduled.waiting.set(false);
            goroutine.state.set(0);
            Result::Ok(result)
        },
        Some(bytecode::Instruction {
            kind: bytecode::InstructionKind::Select { chosen, cases },
            location: _,
        }) => match cases[waiting.case_index].operation {
            bytecode::SelectOperation::Send { channel: _, value } => {
                let result = register(scheduled.frame, value)?;
                select_case_enter(
                    scheduler,
                    goroutine,
                    scheduled,
                    chosen,
                    cases,
                    waiting.case_index,
                )?;
                Result::Ok(result)
            },
            _ => Result::Err("waiting select case is not a send"),
        },
        _ => Result::Err("waiting send is no longer at a send instruction"),
    }
}

fn attempt_send(scheduler: Scheduler, current: isize, channel_id: isize, value: Value) -> Result[
    SendAttempt,
    string,
] {
    if channel_id < 0 {
        return Result::Ok(SendAttempt::Blocked)
    }
    let channel = checked_channel(scheduler.state, channel_id)?;
    if channel.closed.get() {
        return Result::Ok(
            SendAttempt::Panicked(runtime_fault_payload(scheduler.state, "send on closed channel")?),
        )
    }
    match find_waiting_operation(scheduler, current, channel_id, true)? {
        Some(waiting) => {
            complete_waiting_receive(scheduler, waiting, value)?;
            Result::Ok(SendAttempt::Sent)
        },
        None => if channel_can_buffer_send(channel) {
            channel_buffer_send(channel, value)?;
            Result::Ok(SendAttempt::Sent)
        } else {
            Result::Ok(SendAttempt::Blocked)
        },
    }
}

fn attempt_receive(scheduler: Scheduler, current: isize, channel_id: isize) -> Result[
    ReceiveAttempt,
    string,
] {
    if channel_id < 0 {
        return Result::Ok(ReceiveAttempt::Blocked)
    }
    let channel = checked_channel(scheduler.state, channel_id)?;
    if channel_has_value(channel) {
        return Result::Ok(
            ReceiveAttempt::Received { value: channel_buffer_receive(channel)?, ok: true },
        )
    }
    match find_waiting_operation(scheduler, current, channel_id, false)? {
        Some(waiting) => Result::Ok(
            ReceiveAttempt::Received { value: complete_waiting_send(scheduler, waiting)?, ok: true },
        ),
        None => if channel.closed.get() {
            Result::Ok(
                ReceiveAttempt::Received {
                    value: runtime_zero_value(scheduler.state, channel.element_type)?,
                    ok: false,
                },
            )
        } else {
            Result::Ok(ReceiveAttempt::Blocked)
        },
    }
}

fn wake_channel(scheduler: Scheduler, channel: isize) -> Result[(), string] {
    for index in 0..scheduler.goroutines.len() {
        let goroutine = scheduler.goroutines[index];
        if scheduled_channel_waiter(goroutine)
            && (instruction_channel_matches(scheduler, goroutine, channel, true, false)? >= -1
                || instruction_channel_matches(scheduler, goroutine, channel, false, false)? >= -1) {
            match goroutine.native_channel.get() {
                Some(pending) => cancel_scheduled_native_channel(scheduler, index, pending)?,
                None => goroutine.state.set(0),
            }
        }
    }
    Result::Ok(())
}

fn select_case_ready(
    scheduler: Scheduler,
    current: isize,
    scheduled: ScheduledFrame,
    operation: bytecode::SelectOperation,
) -> Result[bool, string] {
    match operation {
        bytecode::SelectOperation::Send { channel, value: _ } => {
            let channel_id = scheduled_channel_id(scheduled.frame, channel)?;
            if channel_id < 0 {
                Result::Ok(false)
            } else {
                let channel = checked_channel(scheduler.state, channel_id)?;
                Result::Ok(
                    channel.closed.get() || channel_can_buffer_send(channel)
                        || find_waiting_operation(scheduler, current, channel_id, true)?.is_some(),
                )
            }
        },
        bytecode::SelectOperation::Receive { channel, value: _, ok: _ } => {
            let channel_id = scheduled_channel_id(scheduled.frame, channel)?;
            if channel_id < 0 {
                Result::Ok(false)
            } else {
                let channel = checked_channel(scheduler.state, channel_id)?;
                Result::Ok(
                    channel.closed.get() || channel_has_value(channel)
                        || find_waiting_operation(scheduler, current, channel_id, false)?.is_some(),
                )
            }
        },
        bytecode::SelectOperation::Default => Result::Ok(false),
    }
}

fn select_choice(scheduler: Scheduler, ready: Vec[isize]) -> isize {
    let next = scheduler.random.get() * 0x5851f42d4c957f2d.to_u64() + 0x14057b7ef767814f.to_u64();
    scheduler.random.set(next);
    ready[(next % ready.len().to_u64()).to_isize()]
}

fn block_scheduled(goroutine: ScheduledGoroutine, scheduled: ScheduledFrame) -> () {
    scheduled.waiting.set(true);
    goroutine.state.set(1)
}

fn advance_scheduled(scheduled: ScheduledFrame) -> () {
    scheduled.instruction.set(scheduled.instruction.get() + 1);
    scheduled.waiting.set(false)
}

fn count_scheduled_step(
    scheduler: Scheduler,
    scheduled: ScheduledFrame,
    location: bytecode::CodeLocation,
) -> bool {
    if scheduled.waiting.get() {
        true
    } else {
        use_step(scheduler.state, frame_location(scheduled.frame, location))
    }
}

fn complete_native_callback(state: VmState, callback: ScheduledCallback, outcome: InvocationOutcome) -> Result[
    (),
    string,
] {
    for index in 0..callback.arguments.len() {
        if !write_native_callback_argument(
            callback.request,
            index,
            NativeHostValue {
                value: native_argument(
                    state,
                    callback.arguments[index],
                    callback.argument_types[index],
                    callback.argument_keys[index],
                )?,
            },
        ) {
            return Result::Err("native callback argument writeback failed")
        }
    }
    match outcome {
        InvocationOutcome::Returned(values) => {
            if values.len() != callback.result_types.len()
                || values.len() != callback.result_keys.len() {
                set_native_callback_error(
                    callback.completion,
                    "callback result count does not match its signature",
                )
            } else {
                for index in 0..values.len() {
                    append_native_callback_result(
                        callback.completion,
                        NativeHostValue {
                            value: native_argument(
                                state,
                                values[index],
                                callback.result_types[index],
                                callback.result_keys[index],
                            )?,
                        },
                    )
                }
            }
        },
        InvocationOutcome::Panicked(payload) => {
            let type_key = native_runtime_type_key(state.program.world, payload.type_id)?;
            set_native_callback_panic(
                callback.completion,
                NativeHostValue {
                    value: native_argument(state, payload.value, payload.type_id, type_key)?,
                },
            )
        },
        InvocationOutcome::Exited(code) => set_native_callback_exit(callback.completion, code),
    }
    if !finish_native_callback(callback.completion) {
        return Result::Err("native callback completion was already finished")
    }
    Result::Ok(())
}

fn start_native_callback(
    scheduler: Scheduler,
    binding: NativeCallbackBinding,
    request: NativeCallbackRequest,
) -> Result[(), string] {
    let method_name = native_callback_method(request);
    let (signature, target) = match binding.target {
        NativeCallbackTarget::Function { function, signature } => (
            signature,
            PreparedTarget::Dynamic(Value::Local(LocalValue::Function(Option::Some(function)))),
        ),
        NativeCallbackTarget::Interface { receiver, interface_type } => {
            if method_name == "" {
                return Result::Err("native interface callback has no method name")
            }
            let selection = go_types::lookup_field_or_method(
                scheduler.state.program.world,
                interface_type,
                false,
                method_name,
            ).ok_or("native interface callback method was not found")?;
            let method = scheduler.state.program.world.objects[selection.object.value];
            (method.type_id, PreparedTarget::InterfaceMethod { method: selection.object, receiver })
        },
    };
    let shape = callback_signature_shape(scheduler.state.program.world, signature)?;
    let completion = new_native_callback_completion(request);
    if native_callback_argument_count(request) != shape.0.len() {
        set_native_callback_error(
            completion,
            "callback argument count does not match its signature",
        );
        let _ = finish_native_callback(completion);
        return Result::Ok(())
    }
    let arguments: Vec[Value] = Vec::with_capacity(shape.0.len());
    for index in 0..shape.0.len() {
        let host = native_callback_argument(request, index);
        arguments.push(native_result(scheduler.state, host.value, shape.0[index], shape.1[index])?)
    }
    let entry = scheduler.state.program.functions[scheduler.state.program.main.value];
    let location = bytecode::expand_location(
        entry.package_id,
        entry.id,
        entry.blocks[entry.entry.value].terminator.location,
    );
    let call = PreparedCall {
        target,
        arguments,
        argument_types: shape.0,
        variadic: false,
        location,
    };
    let invocation = scheduled_call(scheduler.state, call)?.ok_or(
        "native callback target is not interpreted",
    )?;
    check_goroutine_limit(scheduler)?;
    let goroutine = ScheduledGoroutine {
        frames: Vec::new(),
        pending: Ref::new(Option::None),
        native: Ref::new(Option::None),
        native_channel: Ref::new(Option::None),
        state: Ref::new(0),
        startup: false,
    };
    let frame = scheduled_frame(scheduler.state, invocation, Vec::new(), Option::None, false)?;
    frame.callback.set(
        Option::Some(
            ScheduledCallback {
                request,
                completion,
                arguments,
                argument_types: shape.0,
                argument_keys: shape.1,
                result_types: shape.2,
                result_keys: shape.3,
            },
        ),
    );
    goroutine.frames.push(frame);
    add_scheduled_goroutine(scheduler, goroutine);
    Result::Ok(())
}

fn poll_native_callbacks(scheduler: Scheduler) -> Result[bool, string] {
    for binding in scheduler.state.native_callbacks {
        if let Some(request) = take_native_callback_request(binding.queue) {
            let _ = take_native_completion(scheduler.native_completions);
            start_native_callback(scheduler, binding, request)?;
            return Result::Ok(true)
        }
    }
    Result::Ok(false)
}

fn close_native_callbacks(state: VmState) -> () {
    for binding in state.native_callbacks {
        close_native_callback_queue(binding.queue)
    }
}

fn start_scheduled_native_call(
    scheduler: Scheduler,
    goroutine_index: isize,
    call: PreparedCall,
    owner: Option[ScheduledFrame],
    results: Vec[bytecode::RegisterId],
    deferred: bool,
) -> Result[(), string] {
    let native = match call.target {
        PreparedTarget::Native(id) => static_native_prepared(scheduler.state, id)?,
        PreparedTarget::Dynamic(Value::Host { type_id, value }) => {
            dynamic_native_prepared(scheduler.state, value, type_id, call.variadic)?
        },
        _ => return Result::Err("scheduled native call target is not native"),
    };
    let invocation = prepare_native_value_invocation(scheduler.state, native, call.arguments)?;
    prepare_native_runtime_context(native, invocation, goroutine_index)?;
    if !start_native_completion(scheduler.native_completions, invocation) {
        return Result::Err("native completion queue rejected invocation")
    }
    let goroutine = scheduler.goroutines[goroutine_index];
    goroutine.native.set(
        Option::Some(ScheduledNativeCall { native, invocation, owner, results, deferred }),
    );
    goroutine.state.set(1);
    Result::Ok(())
}

fn complete_scheduled_native(
    scheduler: Scheduler,
    goroutine_index: isize,
    pending: ScheduledNativeCall,
) -> Result[Option[InvocationOutcome], string] {
    let goroutine = scheduler.goroutines[goroutine_index];
    goroutine.native.set(Option::None);
    let _ = take_native_completion(scheduler.native_completions);
    let outcome = finish_native_value_invocation(
        scheduler.state,
        pending.native,
        pending.invocation,
    )?;
    match pending.owner {
        Some(owner) => {
            owner.waiting.set(false);
            goroutine.state.set(0);
            if pending.deferred && owner.finishing.get() {
                match update_scheduled_panic(owner, outcome) {
                    Some(outcome) => {
                        goroutine.state.set(2);
                        Result::Ok(Option::Some(outcome))
                    },
                    None => resume_scheduled_finish(scheduler, goroutine_index),
                }
            } else {
                match outcome {
                    InvocationOutcome::Returned(values) => {
                        if values.len() != pending.results.len() {
                            return Result::Err(
                                "native call result count does not match destination count",
                            )
                        }
                        for index in 0..values.len() {
                            set_register(owner.frame, pending.results[index], values[index])?
                        }
                        Result::Ok(Option::None)
                    },
                    InvocationOutcome::Panicked(payload) => begin_scheduled_finish(
                        scheduler,
                        goroutine_index,
                        Option::Some(payload),
                    ),
                    InvocationOutcome::Exited(code) => {
                        goroutine.state.set(2);
                        Result::Ok(Option::Some(InvocationOutcome::Exited(code)))
                    },
                }
            }
        },
        None => {
            goroutine.state.set(2);
            match outcome {
                InvocationOutcome::Returned(_) => Result::Ok(Option::None),
                outcome => Result::Ok(Option::Some(outcome)),
            }
        },
    }
}

fn poll_scheduled_native(scheduler: Scheduler) -> Result[Option[InvocationOutcome], string] {
    for index in 0..scheduler.goroutines.len() {
        if let Some(pending) = scheduler.goroutines[index].native.get() {
            if native_completion_ready(pending.invocation) {
                if let Some(outcome) = complete_scheduled_native(scheduler, index, pending)? {
                    return Result::Ok(Option::Some(outcome))
                }
            }
        }
    }
    Result::Ok(Option::None)
}

fn has_scheduled_native(scheduler: Scheduler) -> bool {
    for goroutine in scheduler.goroutines {
        if goroutine.native.get().is_some() || goroutine.native_channel.get().is_some() {
            return true
        }
    }
    false
}

fn channel_element_type(world: go_types::World, type_id: go_types::TypeId) -> Result[
    go_types::TypeId,
    string,
] {
    match go_types::get_type(world, go_types::underlying(world, type_id)) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Chan { direction: _, element } }) => Result::Ok(
            element,
        ),
        _ => Result::Err("native channel value is not channel typed"),
    }
}

fn start_native_channel(
    scheduler: Scheduler,
    goroutine_index: isize,
    owner: ScheduledFrame,
    channels: Vec[dyn HostValueMarker],
    default_case: bool,
    target: ScheduledNativeChannelTarget,
) -> Result[(), string] {
    let invocation = new_native_channel_invocation();
    for channel in channels {
        if !append_native_channel_receive_value(invocation.value, channel) {
            return Result::Err("native receive target is not a receive-capable channel")
        }
    }
    if default_case && !append_native_channel_default_value(invocation.value) {
        return Result::Err("native channel default case could not be appended")
    }
    if !start_native_channel_invocation_value(scheduler.native_completions.value, invocation.value) {
        return Result::Err("native channel invocation could not start")
    }
    let goroutine = scheduler.goroutines[goroutine_index];
    goroutine.native_channel.set(Option::Some(ScheduledNativeChannel { invocation, owner, target }));
    owner.waiting.set(true);
    goroutine.state.set(1);
    Result::Ok(())
}

fn complete_native_channel(
    scheduler: Scheduler,
    goroutine_index: isize,
    pending: ScheduledNativeChannel,
) -> Result[(), string] {
    let goroutine = scheduler.goroutines[goroutine_index];
    goroutine.native_channel.set(Option::None);
    let _ = take_native_completion(scheduler.native_completions);
    pending.owner.waiting.set(false);
    goroutine.state.set(0);
    let chosen = native_channel_invocation_index_value(pending.invocation.value);
    let host = native_channel_invocation_result_value(pending.invocation.value);
    let open = native_channel_invocation_open_value(pending.invocation.value);
    match pending.target {
        ScheduledNativeChannelTarget::Receive { value, ok, element_type } => {
            set_register(
                pending.owner.frame,
                value,
                Value::Host { type_id: element_type, value: host },
            )?;
            if let Some(target) = ok {
                set_register(pending.owner.frame, target, Value::Local(LocalValue::Bool(open)))?
            }
            advance_scheduled(pending.owner)
        },
        ScheduledNativeChannelTarget::Select { chosen: target, cases, native_indices } => {
            if chosen == -1 {
                return Result::Ok(())
            } else if chosen < 0 || chosen >= native_indices.len() {
                return Result::Err("native select returned an invalid case")
            }
            let case_index = native_indices[chosen];
            match cases[case_index].operation {
                bytecode::SelectOperation::Receive { channel, value, ok } => {
                    let function = scheduler.state.program.functions[pending.owner.frame.function.value];
                    let channel_type = function.register_types[channel.value];
                    set_register(
                        pending.owner.frame,
                        value,
                        Value::Host {
                            type_id: channel_element_type(
                                scheduler.state.program.world,
                                channel_type,
                            )?,
                            value: host,
                        },
                    )?;
                    if let Some(register_id) = ok {
                        set_register(
                            pending.owner.frame,
                            register_id,
                            Value::Local(LocalValue::Bool(open)),
                        )?
                    }
                },
                bytecode::SelectOperation::Default => {},
                _ => return Result::Err("native select chose a non-receive case"),
            }
            select_case_enter(scheduler, goroutine, pending.owner, target, cases, case_index)?
        },
    }
    Result::Ok(())
}

fn poll_scheduled_native_channels(scheduler: Scheduler) -> Result[(), string] {
    for index in 0..scheduler.goroutines.len() {
        if let Some(pending) = scheduler.goroutines[index].native_channel.get() {
            if native_channel_invocation_ready_value(pending.invocation.value) {
                complete_native_channel(scheduler, index, pending)?
            }
        }
    }
    Result::Ok(())
}

fn update_scheduled_panic(scheduled: ScheduledFrame, outcome: InvocationOutcome) -> Option[
    InvocationOutcome,
] {
    match outcome {
        InvocationOutcome::Returned(_) => {
            if let Some(active) = scheduled.panic.get() {
                if !active.active.get() {
                    scheduled.panic.set(Option::None)
                }
            }
            Option::None
        },
        InvocationOutcome::Panicked(payload) => {
            scheduled.panic.set(Option::Some(panic_state(payload)));
            Option::None
        },
        InvocationOutcome::Exited(code) => Option::Some(InvocationOutcome::Exited(code)),
    }
}

fn complete_scheduled_frame(
    scheduler: Scheduler,
    goroutine_index: isize,
    outcome: InvocationOutcome,
) -> Result[Option[InvocationOutcome], string] {
    let goroutine = scheduler.goroutines[goroutine_index];
    let completed = scheduled_top(goroutine)?;
    let _ = goroutine.frames.pop().ok_or("scheduled frame stack is empty")?;
    release_frame_slots(scheduler.state, completed.frame);
    if let Some(callback) = completed.callback.get() {
        if !goroutine.frames.is_empty() {
            return Result::Err("native callback root returned with caller frames")
        }
        complete_native_callback(scheduler.state, callback, outcome)?;
        goroutine.state.set(2);
        return Result::Ok(Option::None)
    }
    match outcome {
        InvocationOutcome::Exited(code) => {
            goroutine.state.set(2);
            Result::Ok(Option::Some(InvocationOutcome::Exited(code)))
        },
        InvocationOutcome::Returned(values) => if goroutine.frames.is_empty() {
            if goroutine.startup {
                if start_next_entry(scheduler, goroutine)? {
                    Result::Ok(Option::None)
                } else {
                    goroutine.state.set(2);
                    Result::Ok(Option::Some(InvocationOutcome::Returned(values)))
                }
            } else {
                goroutine.state.set(2);
                Result::Ok(Option::None)
            }
        } else {
            let caller = scheduled_top(goroutine)?;
            if completed.deferred && caller.finishing.get() {
                let _ = update_scheduled_panic(caller, InvocationOutcome::Returned(values));
                resume_scheduled_finish(scheduler, goroutine_index)
            } else {
                if values.len() != completed.results.len() {
                    return Result::Err("call result count does not match destination count")
                }
                for index in 0..values.len() {
                    set_register(caller.frame, completed.results[index], values[index])?
                }
                goroutine.state.set(0);
                Result::Ok(Option::None)
            }
        },
        InvocationOutcome::Panicked(payload) => if goroutine.frames.is_empty() {
            goroutine.state.set(2);
            Result::Ok(Option::Some(InvocationOutcome::Panicked(payload)))
        } else {
            let caller = scheduled_top(goroutine)?;
            if completed.deferred && caller.finishing.get() {
                let _ = update_scheduled_panic(caller, InvocationOutcome::Panicked(payload));
                resume_scheduled_finish(scheduler, goroutine_index)
            } else {
                begin_scheduled_finish(scheduler, goroutine_index, Option::Some(payload))
            }
        },
    }
}

fn resume_scheduled_finish(scheduler: Scheduler, goroutine_index: isize) -> Result[
    Option[InvocationOutcome],
    string,
] {
    let goroutine = scheduler.goroutines[goroutine_index];
    let scheduled = scheduled_top(goroutine)?;
    loop {
        if scheduled.frame.deferred.is_empty() {
            let function = scheduler.state.program.functions[scheduled.frame.function.value];
            let outcome = match scheduled.panic.get() {
                Some(active) => if active.active.get() {
                    InvocationOutcome::Panicked(active.payload.get())
                } else {
                    InvocationOutcome::Returned(
                        function_result_values(scheduler.state, scheduled.frame, function)?,
                    )
                },
                None => InvocationOutcome::Returned(
                    function_result_values(scheduler.state, scheduled.frame, function)?,
                ),
            };
            return complete_scheduled_frame(scheduler, goroutine_index, outcome)
        }
        let call = scheduled.frame.deferred.pop().ok_or("deferred call stack is empty")?;
        match scheduled_call(scheduler.state, call) {
            Ok(Some(invocation)) => {
                goroutine.frames.push(
                    scheduled_frame(
                        scheduler.state,
                        invocation,
                        Vec::new(),
                        scheduled.panic.get(),
                        true,
                    )?,
                );
                return Result::Ok(Option::None)
            },
            Ok(None) => {
                match call.target {
                    PreparedTarget::Native(_) | PreparedTarget::Dynamic(Value::Host { .. }) => {
                        start_scheduled_native_call(
                            scheduler,
                            goroutine_index,
                            call,
                            Option::Some(scheduled),
                            Vec::new(),
                            true,
                        )?;
                        scheduled.waiting.set(true);
                        return Result::Ok(Option::None)
                    },
                    _ => {},
                }
                let outcome = match invoke_prepared(
                    scheduler.state,
                    scheduled.frame,
                    call,
                    scheduled.panic.get(),
                ) {
                    Ok(value) => value,
                    Err(message) => if runtime_fault(message) {
                        InvocationOutcome::Panicked(
                            runtime_fault_payload(scheduler.state, message)?,
                        )
                    } else {
                        return Result::Err(message)
                    },
                };
                if let Some(outcome) = update_scheduled_panic(scheduled, outcome) {
                    goroutine.state.set(2);
                    return Result::Ok(Option::Some(outcome))
                }
            },
            Err(message) => if runtime_fault(message) {
                scheduled.panic.set(
                    Option::Some(panic_state(runtime_fault_payload(scheduler.state, message)?)),
                )
            } else {
                return Result::Err(message)
            },
        }
    }
}

fn begin_scheduled_finish(scheduler: Scheduler, goroutine_index: isize, panic: Option[PanicPayload]) -> Result[
    Option[InvocationOutcome],
    string,
] {
    let scheduled = scheduled_top(scheduler.goroutines[goroutine_index])?;
    scheduled.finishing.set(true);
    scheduled.panic.set(panic.map(|payload| panic_state(payload)));
    resume_scheduled_finish(scheduler, goroutine_index)
}

fn panic_scheduled(scheduler: Scheduler, goroutine_index: isize, payload: PanicPayload) -> Result[
    Option[InvocationOutcome],
    string,
] {
    begin_scheduled_finish(scheduler, goroutine_index, Option::Some(payload))
}

fn return_scheduled(scheduler: Scheduler, goroutine_index: isize, values: Vec[Value]) -> Result[
    Option[InvocationOutcome],
    string,
] {
    let scheduled = scheduled_top(scheduler.goroutines[goroutine_index])?;
    let function = scheduler.state.program.functions[scheduled.frame.function.value];
    commit_function_results(scheduler.state, scheduled.frame, function, values)?;
    begin_scheduled_finish(scheduler, goroutine_index, Option::None)
}

fn check_goroutine_limit(scheduler: Scheduler) -> Result[(), string] {
    let mut active = 0;
    for goroutine in scheduler.goroutines {
        if goroutine.state.get() != 2 {
            active += 1;
        }
    }
    if active >= scheduler.state.config.max_goroutines {
        Result::Err("maximum goroutine count exceeded")
    } else {
        Result::Ok(())
    }
}

fn add_scheduled_goroutine(scheduler: Scheduler, goroutine: ScheduledGoroutine) -> () {
    for index in 0..scheduler.goroutines.len() {
        let current = scheduler.goroutines[index];
        if current.state.get() == 2 && !current.startup {
            scheduler.goroutines[index] = goroutine;
            return
        }
    }
    scheduler.goroutines.push(goroutine)
}

fn spawn_scheduled(scheduler: Scheduler, invocation: ScheduledInvocation) -> Result[(), string] {
    check_goroutine_limit(scheduler)?;
    let goroutine = ScheduledGoroutine {
        frames: Vec::new(),
        pending: Ref::new(Option::None),
        native: Ref::new(Option::None),
        native_channel: Ref::new(Option::None),
        state: Ref::new(0),
        startup: false,
    };
    goroutine.frames.push(
        scheduled_frame(scheduler.state, invocation, Vec::new(), Option::None, false)?,
    );
    add_scheduled_goroutine(scheduler, goroutine);
    Result::Ok(())
}

fn spawn_scheduled_call(scheduler: Scheduler, caller: Frame, call: PreparedCall) -> Result[
    (),
    string,
] {
    check_goroutine_limit(scheduler)?;
    add_scheduled_goroutine(
        scheduler,
        ScheduledGoroutine {
            frames: Vec::new(),
            pending: Ref::new(Option::Some(ScheduledPendingCall { caller, call })),
            native: Ref::new(Option::None),
            native_channel: Ref::new(Option::None),
            state: Ref::new(0),
            startup: false,
        },
    );
    Result::Ok(())
}

fn execute_scheduled_select(
    scheduler: Scheduler,
    goroutine_index: isize,
    scheduled: ScheduledFrame,
    instruction: bytecode::Instruction,
    chosen: bytecode::RegisterId,
    cases: Vec[bytecode::SelectCase],
) -> Result[Option[InvocationOutcome], string] {
    if !count_scheduled_step(scheduler, scheduled, instruction.location) {
        return Result::Err("instruction limit exceeded")
    }
    let native_channels: Vec[dyn HostValueMarker] = Vec::new();
    let native_indices: Vec[isize] = Vec::new();
    let mut default_index = -1;
    for index in 0..cases.len() {
        match cases[index].operation {
            bytecode::SelectOperation::Receive { channel, value: _, ok: _ } => match register(
                scheduled.frame,
                channel,
            )? {
                Value::Host { type_id: _, value } => {
                    native_channels.push(value);
                    native_indices.push(index)
                },
                Value::Local(LocalValue::Channel(_)) => {},
                _ => return Result::Err("select receive source is not a channel"),
            },
            bytecode::SelectOperation::Send { channel, value: _ } => match register(
                scheduled.frame,
                channel,
            )? {
                Value::Local(LocalValue::Channel(_)) => {},
                Value::Host { type_id: _, value: _ } => {
                    return Result::Err("native channel sends in mixed selects are not supported")
                },
                _ => return Result::Err("select send target is not a channel"),
            },
            bytecode::SelectOperation::Default => {
                default_index = index;
            },
        }
    }
    let ready: Vec[isize] = Vec::new();
    for index in 0..cases.len() {
        match cases[index].operation {
            bytecode::SelectOperation::Receive { channel, value: _, ok: _ } => match register(
                scheduled.frame,
                channel,
            )? {
                Value::Host { type_id: _, value: _ } => {},
                _ => if select_case_ready(
                    scheduler,
                    goroutine_index,
                    scheduled,
                    cases[index].operation,
                )? {
                    ready.push(index)
                },
            },
            bytecode::SelectOperation::Default => {},
            operation => if select_case_ready(scheduler, goroutine_index, scheduled, operation)? {
                ready.push(index)
            },
        }
    }
    if ready.is_empty() && !native_channels.is_empty() {
        if default_index >= 0 {
            native_indices.push(default_index)
        }
        start_native_channel(
            scheduler,
            goroutine_index,
            scheduled,
            native_channels,
            default_index >= 0,
            ScheduledNativeChannelTarget::Select { chosen, cases, native_indices },
        )?;
        return Result::Ok(Option::None)
    }
    let selected = if ready.is_empty() {
        default_index
    } else {
        select_choice(scheduler, ready)
    };
    if selected < 0 {
        block_scheduled(scheduler.goroutines[goroutine_index], scheduled);
        return Result::Ok(Option::None)
    }
    match cases[selected].operation {
        bytecode::SelectOperation::Send { channel, value } => {
            let channel_id = scheduled_channel_id(scheduled.frame, channel)?;
            match attempt_send(
                scheduler,
                goroutine_index,
                channel_id,
                register(scheduled.frame, value)?,
            )? {
                SendAttempt::Sent => {
                    wake_channel(scheduler, channel_id)?;
                    select_case_enter(
                        scheduler,
                        scheduler.goroutines[goroutine_index],
                        scheduled,
                        chosen,
                        cases,
                        selected,
                    )?;
                    Result::Ok(Option::None)
                },
                SendAttempt::Blocked => {
                    block_scheduled(scheduler.goroutines[goroutine_index], scheduled);
                    Result::Ok(Option::None)
                },
                SendAttempt::Panicked(payload) => panic_scheduled(
                    scheduler,
                    goroutine_index,
                    payload,
                ),
            }
        },
        bytecode::SelectOperation::Receive { channel, value, ok } => {
            let channel_id = scheduled_channel_id(scheduled.frame, channel)?;
            match attempt_receive(scheduler, goroutine_index, channel_id)? {
                ReceiveAttempt::Received { value: received, ok: received_ok } => {
                    set_register(scheduled.frame, value, received)?;
                    if let Some(target) = ok {
                        set_register(
                            scheduled.frame,
                            target,
                            Value::Local(LocalValue::Bool(received_ok)),
                        )?
                    }
                    wake_channel(scheduler, channel_id)?;
                    select_case_enter(
                        scheduler,
                        scheduler.goroutines[goroutine_index],
                        scheduled,
                        chosen,
                        cases,
                        selected,
                    )?;
                    Result::Ok(Option::None)
                },
                ReceiveAttempt::Blocked => {
                    block_scheduled(scheduler.goroutines[goroutine_index], scheduled);
                    Result::Ok(Option::None)
                },
            }
        },
        bytecode::SelectOperation::Default => {
            select_case_enter(
                scheduler,
                scheduler.goroutines[goroutine_index],
                scheduled,
                chosen,
                cases,
                selected,
            )?;
            Result::Ok(Option::None)
        },
    }
}

fn finish_scheduled_instruction(
    scheduler: Scheduler,
    goroutine_index: isize,
    scheduled: ScheduledFrame,
    control: InstructionControl,
) -> Result[Option[InvocationOutcome], string] {
    if control.kind == 0 {
        advance_scheduled(scheduled);
        Result::Ok(Option::None)
    } else if control.kind == 1 {
        panic_scheduled(
            scheduler,
            goroutine_index,
            control.panic.ok_or("panic instruction has no payload")?.get(),
        )
    } else if control.kind == 2 {
        Result::Ok(Option::Some(InvocationOutcome::Exited(control.exit_code)))
    } else {
        Result::Err(control.error)
    }
}

fn execute_scheduled_instruction(
    scheduler: Scheduler,
    goroutine_index: isize,
    scheduled: ScheduledFrame,
    instruction: bytecode::Instruction,
) -> Result[Option[InvocationOutcome], string] {
    let goroutine = scheduler.goroutines[goroutine_index];
    match instruction.kind {
        bytecode::InstructionKind::Call { results, target, arguments, variadic } => {
            if scheduled.waiting.get() {
                return Result::Err("call instruction is marked as waiting")
            }
            let prepared = match prepare_call(
                scheduler.state,
                scheduled.frame,
                target,
                arguments,
                variadic,
                frame_location(scheduled.frame, instruction.location),
            ) {
                Ok(value) => value,
                Err(message) => return if runtime_fault(message) {
                    panic_scheduled(
                        scheduler,
                        goroutine_index,
                        runtime_fault_payload(scheduler.state, message)?,
                    )
                } else {
                    Result::Err(message)
                },
            };
            match prepared.target {
                PreparedTarget::Native(_) | PreparedTarget::Dynamic(Value::Host { .. }) => {
                    if !use_step(
                        scheduler.state,
                        frame_location(scheduled.frame, instruction.location),
                    ) {
                        return Result::Err("instruction limit exceeded")
                    }
                    start_scheduled_native_call(
                        scheduler,
                        goroutine_index,
                        prepared,
                        Option::Some(scheduled),
                        results,
                        false,
                    )?;
                    advance_scheduled(scheduled);
                    scheduled.waiting.set(true);
                    return Result::Ok(Option::None)
                },
                _ => {},
            }
            match scheduled_call(scheduler.state, prepared) {
                Ok(Some(invocation)) => {
                    if !use_step(
                        scheduler.state,
                        frame_location(scheduled.frame, instruction.location),
                    ) {
                        return Result::Err("instruction limit exceeded")
                    }
                    if goroutine.frames.len() >= scheduler.state.config.max_call_depth {
                        return Result::Err("maximum call depth exceeded")
                    }
                    advance_scheduled(scheduled);
                    goroutine.frames.push(
                        scheduled_frame(scheduler.state, invocation, results, Option::None, false)?,
                    );
                    Result::Ok(Option::None)
                },
                Ok(None) => finish_scheduled_instruction(
                    scheduler,
                    goroutine_index,
                    scheduled,
                    execute_instruction(scheduler.state, scheduled.frame, instruction),
                ),
                Err(message) => if runtime_fault(message) {
                    panic_scheduled(
                        scheduler,
                        goroutine_index,
                        runtime_fault_payload(scheduler.state, message)?,
                    )
                } else {
                    Result::Err(message)
                },
            }
        },
        bytecode::InstructionKind::Spawn { target, arguments, variadic } => {
            if !count_scheduled_step(scheduler, scheduled, instruction.location) {
                return Result::Err("instruction limit exceeded")
            }
            let prepared = prepare_call(
                scheduler.state,
                scheduled.frame,
                target,
                arguments,
                variadic,
                frame_location(scheduled.frame, instruction.location),
            )?;
            match scheduled_call(scheduler.state, prepared)? {
                Some(invocation) => spawn_scheduled(scheduler, invocation)?,
                None => spawn_scheduled_call(scheduler, scheduled.frame, prepared)?,
            }
            advance_scheduled(scheduled);
            Result::Ok(Option::None)
        },
        bytecode::InstructionKind::MakeChannel { target, type_id, capacity } => {
            if !count_scheduled_step(scheduler, scheduled, instruction.location) {
                return Result::Err("instruction limit exceeded")
            }
            let capacity = integer_host(register(scheduled.frame, capacity)?)?;
            if capacity < 0 {
                return panic_scheduled(
                    scheduler,
                    goroutine_index,
                    runtime_fault_payload(scheduler.state, "makechan: size out of range")?,
                )
            }
            let element_type = match go_types::get_type(
                scheduler.state.program.world,
                go_types::underlying(scheduler.state.program.world, type_id),
            ) {
                Some(go_types::TypeData {
                    id: _,
                    kind: go_types::TypeKind::Chan { direction: _, element },
                }) => element,
                _ => return Result::Err("make channel type is not channel typed"),
            };
            let id = scheduler.state.channels.len();
            scheduler.state.channels.push(new_channel_value(element_type, capacity));
            set_register(scheduled.frame, target, Value::Local(LocalValue::Channel(id)))?;
            advance_scheduled(scheduled);
            Result::Ok(Option::None)
        },
        bytecode::InstructionKind::Send { channel, value } => {
            if !count_scheduled_step(scheduler, scheduled, instruction.location) {
                return Result::Err("instruction limit exceeded")
            }
            let channel_id = scheduled_channel_id(scheduled.frame, channel)?;
            match attempt_send(
                scheduler,
                goroutine_index,
                channel_id,
                register(scheduled.frame, value)?,
            )? {
                SendAttempt::Sent => {
                    advance_scheduled(scheduled);
                    wake_channel(scheduler, channel_id)?;
                    Result::Ok(Option::None)
                },
                SendAttempt::Blocked => {
                    block_scheduled(goroutine, scheduled);
                    Result::Ok(Option::None)
                },
                SendAttempt::Panicked(payload) => panic_scheduled(
                    scheduler,
                    goroutine_index,
                    payload,
                ),
            }
        },
        bytecode::InstructionKind::Receive { value, ok, channel } => {
            if !count_scheduled_step(scheduler, scheduled, instruction.location) {
                return Result::Err("instruction limit exceeded")
            }
            match register(scheduled.frame, channel)? {
                Value::Host { type_id, value: host } => {
                    start_native_channel(
                        scheduler,
                        goroutine_index,
                        scheduled,
                        Vec::from_array([host]),
                        false,
                        ScheduledNativeChannelTarget::Receive {
                            value,
                            ok,
                            element_type: channel_element_type(
                                scheduler.state.program.world,
                                type_id,
                            )?,
                        },
                    )?;
                    return Result::Ok(Option::None)
                },
                _ => {},
            }
            let channel_id = scheduled_channel_id(scheduled.frame, channel)?;
            match attempt_receive(scheduler, goroutine_index, channel_id)? {
                ReceiveAttempt::Received { value: received, ok: received_ok } => {
                    set_register(scheduled.frame, value, received)?;
                    if let Some(target) = ok {
                        set_register(
                            scheduled.frame,
                            target,
                            Value::Local(LocalValue::Bool(received_ok)),
                        )?
                    }
                    advance_scheduled(scheduled);
                    wake_channel(scheduler, channel_id)?;
                    Result::Ok(Option::None)
                },
                ReceiveAttempt::Blocked => {
                    block_scheduled(goroutine, scheduled);
                    Result::Ok(Option::None)
                },
            }
        },
        bytecode::InstructionKind::Close { channel } => {
            if !count_scheduled_step(scheduler, scheduled, instruction.location) {
                return Result::Err("instruction limit exceeded")
            }
            let channel_id = scheduled_channel_id(scheduled.frame, channel)?;
            if channel_id < 0 {
                return panic_scheduled(
                    scheduler,
                    goroutine_index,
                    runtime_fault_payload(scheduler.state, "close of nil channel")?,
                )
            }
            match channel_close(checked_channel(scheduler.state, channel_id)?) {
                Ok(()) => {},
                Err(message) => return panic_scheduled(
                    scheduler,
                    goroutine_index,
                    runtime_fault_payload(scheduler.state, message)?,
                ),
            }
            advance_scheduled(scheduled);
            wake_channel(scheduler, channel_id)?;
            Result::Ok(Option::None)
        },
        bytecode::InstructionKind::Select { chosen, cases } => execute_scheduled_select(
            scheduler,
            goroutine_index,
            scheduled,
            instruction,
            chosen,
            cases,
        ),
        _ => finish_scheduled_instruction(
            scheduler,
            goroutine_index,
            scheduled,
            execute_instruction(scheduler.state, scheduled.frame, instruction),
        ),
    }
}

fn execute_scheduled_step(scheduler: Scheduler, goroutine_index: isize) -> Result[
    Option[InvocationOutcome],
    string,
] {
    let goroutine = scheduler.goroutines[goroutine_index];
    match goroutine.pending.get() {
        Some(pending) => {
            goroutine.pending.set(Option::None);
            match pending.call.target {
                PreparedTarget::Native(_) | PreparedTarget::Dynamic(Value::Host { .. }) => {
                    start_scheduled_native_call(
                        scheduler,
                        goroutine_index,
                        pending.call,
                        Option::None,
                        Vec::new(),
                        false,
                    )?;
                    return Result::Ok(Option::None)
                },
                _ => {},
            }
            goroutine.state.set(2);
            return match invoke_prepared(
                scheduler.state,
                pending.caller,
                pending.call,
                Option::None,
            ) {
                Ok(InvocationOutcome::Returned(_)) => Result::Ok(Option::None),
                Ok(outcome) => Result::Ok(Option::Some(outcome)),
                Err(message) => if runtime_fault(message) {
                    Result::Ok(
                        Option::Some(
                            InvocationOutcome::Panicked(
                                runtime_fault_payload(scheduler.state, message)?,
                            ),
                        ),
                    )
                } else {
                    Result::Err(message)
                },
            }
        },
        None => {},
    }
    let scheduled = scheduled_top(goroutine)?;
    let current = scheduled_instruction(scheduled);
    if current.message != "" {
        Result::Err(current.message)
    } else if current.present {
        execute_scheduled_instruction(
            scheduler,
            goroutine_index,
            scheduled,
            current.instructions[current.index],
        )
    } else {
        let function = scheduler.state.program.functions[scheduled.frame.function.value];
        let block = function.blocks[scheduled.frame.block.get().value];
        match execute_terminator(scheduler.state, scheduled.frame, block.terminator)? {
            FunctionControl::Jump { target, arguments } => {
                enter_block_registers(function, scheduled.frame, target, arguments)?;
                scheduled.instruction.set(0);
                scheduled.waiting.set(false);
                Result::Ok(Option::None)
            },
            FunctionControl::Return(values) => {
                return_scheduled(scheduler, goroutine_index, values)
            },
        }
    }
}

fn next_runnable(scheduler: Scheduler) -> isize {
    if scheduler.goroutines.is_empty() {
        return -1
    }
    let start = scheduler.cursor.get() % scheduler.goroutines.len();
    for offset in 0..scheduler.goroutines.len() {
        let index = (start + offset) % scheduler.goroutines.len();
        if scheduler.goroutines[index].state.get() == 0 {
            scheduler.cursor.set((index + 1) % scheduler.goroutines.len());
            return index
        }
    }
    return -1
}

fn has_blocked_goroutine(scheduler: Scheduler) -> bool {
    for goroutine in scheduler.goroutines {
        if goroutine.state.get() == 1 {
            return true
        }
    }
    false
}

fn execute_scheduled_program(state: VmState) -> Result[InvocationOutcome, string] {
    let scheduler = new_scheduler(state);
    start_scheduler(scheduler)?;
    loop {
        let _ = poll_native_callbacks(scheduler)?;
        poll_scheduled_native_channels(scheduler)?;
        match poll_scheduled_native(scheduler)? {
            Some(outcome) => {
                close_native_callbacks(scheduler.state);
                close_native_completions(scheduler.native_completions);
                return Result::Ok(outcome)
            },
            None => {},
        }
        let goroutine_index = next_runnable(scheduler);
        if goroutine_index < 0 {
            if has_scheduled_native(scheduler) {
                if !await_native_completion(scheduler.native_completions) {
                    close_native_callbacks(scheduler.state);
                    close_native_completions(scheduler.native_completions);
                    return Result::Err("native completion queue closed while calls were pending")
                }
                continue
            } else if has_blocked_goroutine(scheduler) {
                close_native_callbacks(scheduler.state);
                close_native_completions(scheduler.native_completions);
                return Result::Err("fatal error: all goroutines are asleep - deadlock!")
            } else {
                close_native_callbacks(scheduler.state);
                close_native_completions(scheduler.native_completions);
                return Result::Err("scheduler stopped before main returned")
            }
        }
        let quantum = if state.config.instruction_quantum > 0 {
            state.config.instruction_quantum
        } else {
            1
        };
        for _ in 0..quantum {
            if scheduler.goroutines[goroutine_index].state.get() != 0 {
                break
            }
            match execute_scheduled_step(scheduler, goroutine_index)? {
                Some(outcome) => {
                    close_native_callbacks(scheduler.state);
                    close_native_completions(scheduler.native_completions);
                    return Result::Ok(outcome)
                },
                None => {},
            }
        }
    }
}

fn instruction_needs_scheduler(kind: bytecode::InstructionKind) -> bool {
    match kind {
        bytecode::InstructionKind::MakeChannel { target: _, type_id: _, capacity: _ } | bytecode::InstructionKind::Spawn {
            target: _,
            arguments: _,
            variadic: _,
        } | bytecode::InstructionKind::Send { channel: _, value: _ } | bytecode::InstructionKind::Receive {
            value: _,
            ok: _,
            channel: _,
        } | bytecode::InstructionKind::Close { channel: _ } | bytecode::InstructionKind::Select {
            chosen: _,
            cases: _,
        } => true,
        _ => false,
    }
}

fn callback_type(world: go_types::World, type_id: go_types::TypeId) -> bool {
    match go_types::get_type(world, go_types::unalias(world, type_id)) {
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Signature { .. } }) => true,
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Named { underlying, .. } }) => {
            go_types::is_interface(world, underlying)
        },
        _ => false,
    }
}

fn register_callback_type(
    world: go_types::World,
    function: bytecode::BytecodeFunction,
    register: bytecode::RegisterId,
) -> bool {
    register.value >= 0 && register.value < function.register_types.len()
        && callback_type(world, function.register_types[register.value])
}

fn instruction_callback(
    program: bytecode::BytecodeProgram,
    function: bytecode::BytecodeFunction,
    kind: bytecode::InstructionKind,
) -> bool {
    match kind {
        bytecode::InstructionKind::Call { results: _, target, arguments, variadic: _ } | bytecode::InstructionKind::Defer {
            target,
            arguments,
            variadic: _,
        } => match target {
            bytecode::CallTarget::Native(_) | bytecode::CallTarget::NativeMethod {
                call: _,
                receiver: _,
            } | bytecode::CallTarget::Dynamic(_) | bytecode::CallTarget::InterfaceMethod {
                method: _,
                receiver: _,
            } => {
                for argument in arguments {
                    if register_callback_type(program.world, function, argument) {
                        return true
                    }
                }
                false
            },
            _ => false,
        },
        bytecode::InstructionKind::Convert { target: _, source, type_id } => {
            !program.native_calls.is_empty() && go_types::is_interface(program.world, type_id)
                && register_callback_type(program.world, function, source)
        },
        _ => false,
    }
}

fn program_needs_scheduler(program: bytecode::BytecodeProgram) -> bool {
    for call in program.native_calls {
        for parameter in call.parameter_types {
            if callback_type(program.world, parameter) {
                return true
            }
        }
    }
    for function in program.functions {
        for block in function.blocks {
            for instruction in block.instructions {
                if instruction_needs_scheduler(instruction.kind)
                    || instruction_callback(program, function, instruction.kind) {
                    return true
                }
            }
        }
    }
    false
}
