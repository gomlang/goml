package registry;

use std::testing;
use std::fs;

#[test]
fn cached_git_sources_must_match_the_current_index() -> () {
    let root = "_artifact/test-work/registry-source-metadata";
    if fs::exists(root) {
        let _ = testing::expect_ok(fs::remove_dir_all(root), "remove cache");
    }
    let entry = Entry {
        name: "demo::leaf",
        git: Option::Some("https://github.com/gomlang/leaf.git"),
        path: Option::None,
    };
    let source = directory(root, entry);
    let _ = testing::expect_ok(fs::create_dir_all(source + "/.git"), "cache directory");
    let _ = testing::expect_ok(
        fs::write_file_structured(source + "/goml.toml", "[module]\npath = \"demo::leaf\"\n"),
        "manifest",
    );
    testing::assert(cached_directory(root, entry).is_err());
    let _ = testing::expect_ok(
        fs::write_file_structured(
            source + "/.git/goml-registry-source",
            "https://github.com/gomlang/leaf.git",
        ),
        "source metadata",
    );
    testing::assert(cached_directory(root, entry).is_ok());
    testing::assert(
        cached_directory(
            root,
            Entry { git: Option::Some("https://github.com/gomlang/other.git"), ..entry },
        ).is_err(),
    );
}

#[test]
fn registry_maps_canonical_modules_to_git_or_local_sources() -> () {
    let entries = testing::expect_ok(
        parse(
            "[modules.\"ecosystem::ansi\"]\ngit = \"https://github.com/gomlang/ansi.git\" # source\n[modules.\"demo::leaf\"]\npath = \"demo/leaf\"\n",
        ),
        "index",
    );
    let remote = testing::expect_ok(find(entries, "ecosystem::ansi"), "remote module");
    testing::assert(remote.git == Option::Some("https://github.com/gomlang/ansi.git"));
    testing::assert_eq(directory("/registry", remote), "/registry/sources/ecosystem/ansi");
    let local = testing::expect_ok(find(entries, "demo::leaf"), "local module");
    testing::assert_eq(directory("/registry", local), "/registry/demo/leaf");
    testing::assert(find(entries, "demo::missing").is_err());
}

#[test]
fn registry_rejects_ambiguous_or_invalid_sources() -> () {
    for fields in Vec::from_array(
        [
            "",
            "git = \"\"",
            "git = \"--upload-pack=bad\"",
            "path = \"\"",
            "path = \"../outside\"",
            "path = \"/outside\"",
            "path = \".git\"",
            "git = false",
            "latest = \"1.0.0\"",
            "git = \"https://github.com/gomlang/ansi.git\"\npath = \"ansi\"",
            "path = \"one\"\npath = \"two\"",
        ],
    ) {
        testing::assert(parse("[modules.\"demo::leaf\"]\n" + fields).is_err());
    }
    for name in Vec::from_array(
        ["missing_owner", "demo::../outside", "demo::one::two", "std::leaf", "builtin::leaf"],
    ) {
        testing::assert(parse("[modules.\"" + name + "\"]\npath = \"leaf\"").is_err());
    }
    testing::assert(parse("modules = []").is_err());
    testing::assert(parse("[modules]\n\"demo::leaf\" = true").is_err());
    testing::assert(
        parse("[modules.\"demo::leaf\"]\npath = \"one\"\n[modules.\"demo::leaf\"]\npath = \"two\"").is_err(),
    );
}
