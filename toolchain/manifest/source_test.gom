package manifest;

use std::testing;

#[test]
fn source_suffixes_preserve_development_boundaries() -> () {
    for suffix in Vec::from_array([".goml", ".gom"]) {
        testing::assert(is_source_file("main" + suffix));
        testing::assert(!is_test_source("main" + suffix));
        testing::assert(is_test_source("value_test" + suffix));
        testing::assert(development_source("/project", "/project/value_test" + suffix));
        testing::assert(!development_source("/project", "/project/value" + suffix));
        testing::assert(!development_source("/project", "/other/value_test" + suffix));
    }
    for name in Vec::from_array(["main.gomlx", "value_test.goml.bak", "main.go", "goml.toml"]) {
        testing::assert(!is_source_file(name));
        testing::assert(!is_test_source(name));
    }
}
