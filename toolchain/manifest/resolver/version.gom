package resolver;

use std::cmp;
use std::text;

pub struct SemVersion {
    pub major: isize,
    pub minor: isize,
    pub patch: isize,
}

fn decimal_number(value: string) -> Option[isize] {
    let length = value.byte_len();
    if length == 0 {
        return Option::None
    }
    let mut result = 0;
    for index in 0..length {
        let byte = value.byte_get(index);
        if byte < b'0' || byte > b'9' {
            return Option::None
        } else {
            result = result * 10 + (byte - b'0').to_isize();
        }
    }
    Option::Some(result)
}

pub fn parse_sem_version(value: string) -> Option[SemVersion] {
    let parts = text::split(value, ".");
    if parts.len() != 3 {
        return None
    }
    let Some(major) = decimal_number(parts[0]) else {
        return None
    };
    let Some(minor) = decimal_number(parts[1]) else {
        return None
    };
    let Some(patch) = decimal_number(parts[2]) else {
        return None
    };
    Some(SemVersion { major, minor, patch })
}

pub fn compare_versions(left: SemVersion, right: SemVersion) -> cmp::Ordering {
    cmp::compare(left.major, right.major).then(cmp::compare(left.minor, right.minor)).then(
        cmp::compare(left.patch, right.patch),
    )
}

pub fn minimum_version[E](versions: Vec[string], minimum: SemVersion, invalid: (string) -> E) -> Result[
    Option[string],
    E,
] {
    let mut selected: Option[string] = None;
    let mut selected_value: Option[SemVersion] = None;
    for version in versions {
        let Some(parsed) = parse_sem_version(version) else {
            return Err(invalid(version))
        };
        if !compare_versions(parsed, minimum).is_lt()
            && match selected_value {
                Some(current) => compare_versions(parsed, current).is_lt(),
                None => true,
            } {
            selected = Some(version);
            selected_value = Some(parsed);
        }
    }
    Ok(selected)
}
