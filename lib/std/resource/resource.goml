package resource;

pub struct ScopeError[E, C] {
    pub action: Option[E],
    pub cleanup: Vec[C],
}

impl[E: ToString, C: ToString] ToString for ScopeError[E, C] {
    fn to_string(self: ScopeError[E, C]) -> string {
        let mut message = self.action.map(|error| error.to_string()).unwrap_or("");
        for error in self.cleanup {
            if message != "" {
                message += "; ";
            }
            message += "cleanup: " + error.to_string();
        }
        message
    }
}

enum State[E] {
    Open(Vec[() -> Result[(), E]]),
    Closing,
    Closed(Vec[E]),
}

pub struct Scope[E] {
    state: Channel[State[E]],
    done: Channel[()],
}

fn close_actions[E](actions: Vec[() -> Result[(), E]], errors: Vec[E]) -> () {
    defer {
        if !actions.is_empty() {
            close_actions(actions, errors);
        }
    };
    while let Some(action) = actions.pop() {
        if let Err(error) = action() {
            errors.push(error);
        }
    }
}

impl[E] Scope[E] {
    pub fn new() -> Scope[E] {
        let state = Channel::new(1);
        state.send(State::Open(Vec::new()));
        Scope { state, done: Channel::new(0) }
    }

    pub fn register(self: Scope[E], cleanup: () -> Result[(), E]) -> bool {
        let state = self.state.recv().unwrap_or(State::Closed(Vec::new()));
        match state {
            Open(actions) => {
                actions.push(cleanup);
                self.state.send(State::Open(actions));
                true
            },
            state => {
                self.state.send(state);
                false
            },
        }
    }

    pub fn is_closed(self: Scope[E]) -> bool {
        let state = self.state.recv().unwrap_or(State::Closed(Vec::new()));
        let closed = match state {
            Open(_) => false,
            _ => true,
        };
        self.state.send(state);
        closed
    }

    pub fn close(self: Scope[E]) -> Vec[E] {
        let state = self.state.recv().unwrap_or(State::Closed(Vec::new()));
        match state {
            Closed(errors) => {
                self.state.send(State::Closed(errors));
                errors.copy()
            },
            Closing => {
                self.state.send(State::Closing);
                let _ = self.done.recv();
                self.close()
            },
            Open(actions) => {
                self.state.send(State::Closing);
                let errors = Vec::new();
                defer {
                    let _ = self.state.recv();
                    self.state.send(State::Closed(errors));
                    self.done.close();
                };
                close_actions(actions, errors);
                errors.copy()
            },
        }
    }
}

pub fn finish[T, E, C](action: Result[T, E], cleanup: Vec[C]) -> Result[T, ScopeError[E, C]] {
    match action {
        Ok(value) if cleanup.is_empty() => Result::Ok(value),
        Ok(_) => Result::Err(ScopeError { action: Option::None, cleanup: cleanup.copy() }),
        Err(error) => Result::Err(
            ScopeError { action: Option::Some(error), cleanup: cleanup.copy() },
        ),
    }
}

pub fn with_cleanup[T, E, C](action: () -> Result[T, E], cleanup: () -> Result[(), C]) -> Result[
    T,
    ScopeError[E, C],
] {
    let errors = Vec::new();
    let result = {
        defer {
            if let Err(error) = cleanup() {
                errors.push(error);
            }
        };
        action()
    };
    finish(result, errors)
}

pub fn scope[T, E, C](action: (Scope[C]) -> Result[T, E]) -> Result[T, ScopeError[E, C]] {
    let scope: Scope[C] = Scope::new();
    let errors: Vec[C] = Vec::new();
    let result = {
        defer errors.extend(scope.close());
        action(scope)
    };
    finish(result, errors)
}
