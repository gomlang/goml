package fs;

use module::bytes;
use module::io;
use module::utf8;
use utf8::BytesUtf8;

struct MetadataFormatBuffer {
    output: bytes::Bytes,
    limit: isize,
    operation: string,
    name: Option[string],
}

impl MetadataFormatBuffer {
    fn append(self: MetadataFormatBuffer, value: string) -> Result[(), Error] {
        if value.byte_len() > self.limit - self.output.len() {
            return Result::Err(
                Error::new(
                    io::ErrorKind::InvalidData,
                    self.operation,
                    self.name,
                    Option::None,
                    "formatted output exceeds byte limit",
                ),
            )
        }
        for index in 0..value.byte_len() {
            self.output.push(value.byte_get(index));
        }
        Result::Ok(())
    }

    fn flag(self: MetadataFormatBuffer, label: string, value: bool) -> Result[(), Error] {
        self.append(label)?;
        self.append(
            if value {
                "1"
            } else {
                "0"
            },
        )
    }

    fn finish(self: MetadataFormatBuffer) -> Result[string, Error] {
        self.output.to_string_utf8().map_err(
            |error| Error::new(
                io::ErrorKind::InvalidData,
                self.operation,
                self.name,
                Option::None,
                error.to_string(),
            ),
        )
    }
}

fn metadata_format_buffer(operation: string, name: Option[string], max_bytes: isize) -> Result[
    MetadataFormatBuffer,
    Error,
] {
    if max_bytes < 0 {
        return Result::Err(
            Error::new(
                io::ErrorKind::InvalidInput,
                operation,
                name,
                Option::None,
                "limit must be non-negative",
            ),
        )
    }
    Result::Ok(
        MetadataFormatBuffer { output: bytes::Bytes::new(), limit: max_bytes, operation, name },
    )
}

fn metadata_kind_text(kind: NodeKind) -> string {
    match kind {
        NodeKind::File => "file",
        NodeKind::Directory => "directory",
        NodeKind::Symlink => "symlink",
        NodeKind::BlockDevice => "block_device",
        NodeKind::CharacterDevice => "character_device",
        NodeKind::NamedPipe => "named_pipe",
        NodeKind::Socket => "socket",
        NodeKind::Irregular => "irregular",
        NodeKind::Unknown => "unknown",
    }
}

fn directory_kind_text(kind: FileType) -> string {
    match kind {
        FileType::File => "file",
        FileType::Directory => "directory",
        FileType::Symlink => "symlink",
        FileType::Other => "other",
    }
}

pub fn format_metadata(name: string, metadata: Metadata, max_bytes: isize) -> Result[string, Error] {
    let buffer = metadata_format_buffer("format metadata", Option::Some(name), max_bytes)?;
    let mode = metadata.mode();
    buffer.append("kind=")?;
    buffer.append(metadata_kind_text(mode.kind()))?;
    buffer.append(" permissions=")?;
    let permissions = mode.permissions().mode();
    let bits: Vec[u32] = Vec::from_array(
        [0o400, 0o200, 0o100, 0o040, 0o020, 0o010, 0o004, 0o002, 0o001],
    );
    let letters = ["r", "w", "x", "r", "w", "x", "r", "w", "x"];
    for index in 0..bits.len() {
        buffer.append(
            if permissions & bits[index] != 0 {
                letters[index]
            } else {
                "-"
            },
        )?;
    }
    buffer.append(" flags=")?;
    match mode.flags() {
        None => buffer.append("unknown")?,
        Some(flags) => {
            buffer.flag("set_uid:", flags.set_uid)?;
            buffer.flag(",set_gid:", flags.set_gid)?;
            buffer.flag(",sticky:", flags.sticky)?;
            buffer.flag(",append_only:", flags.append_only)?;
            buffer.flag(",exclusive:", flags.exclusive)?;
            buffer.flag(",temporary:", flags.temporary)?;
        },
    }
    buffer.append(" size=")?;
    buffer.append(metadata.len().to_string())?;
    buffer.append(" modified_ns=")?;
    buffer.append(metadata.modified_unix_nanoseconds().to_string())?;
    buffer.append(" name=")?;
    buffer.append(name)?;
    if mode.file_type().is_dir() {
        buffer.append("/")?;
    }
    buffer.finish()
}

pub fn format_directory_entry[E: DirectoryEntry](entry: E, max_bytes: isize) -> Result[
    string,
    Error,
] {
    if max_bytes < 0 {
        return Result::Err(
            Error::new(
                io::ErrorKind::InvalidInput,
                "format directory entry",
                Option::None,
                Option::None,
                "limit must be non-negative",
            ),
        )
    }
    let name = entry.name();
    let kind = entry.file_type();
    let buffer = metadata_format_buffer("format directory entry", Option::Some(name), max_bytes)?;
    buffer.append("kind=")?;
    buffer.append(directory_kind_text(kind))?;
    buffer.append(" name=")?;
    buffer.append(name)?;
    if kind.is_dir() {
        buffer.append("/")?;
    }
    buffer.finish()
}
