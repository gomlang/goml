package fs;

pub enum NodeKind {
    File,
    Directory,
    Symlink,
    BlockDevice,
    CharacterDevice,
    NamedPipe,
    Socket,
    Irregular,
    Unknown,
}

impl PartialEq for NodeKind {
    fn eq(self: NodeKind, other: NodeKind) -> bool {
        match (self, other) {
            (File, File) => true,
            (Directory, Directory) => true,
            (Symlink, Symlink) => true,
            (BlockDevice, BlockDevice) => true,
            (CharacterDevice, CharacterDevice) => true,
            (NamedPipe, NamedPipe) => true,
            (Socket, Socket) => true,
            (Irregular, Irregular) => true,
            (Unknown, Unknown) => true,
            _ => false,
        }
    }
}

impl Eq for NodeKind {}

pub struct ModeFlags {
    pub set_uid: bool,
    pub set_gid: bool,
    pub sticky: bool,
    pub append_only: bool,
    pub exclusive: bool,
    pub temporary: bool,
}

impl PartialEq for ModeFlags {
    fn eq(self: ModeFlags, other: ModeFlags) -> bool {
        self.set_uid == other.set_uid && self.set_gid == other.set_gid
            && self.sticky == other.sticky
            && self.append_only == other.append_only
            && self.exclusive == other.exclusive
            && self.temporary == other.temporary
    }
}

impl Eq for ModeFlags {}

pub struct FileMode {
    kind_value: NodeKind,
    permissions_value: Permissions,
    flags_value: Option[ModeFlags],
}

impl FileMode {
    pub fn from_parts(kind: NodeKind, permissions: u32, flags: Option[ModeFlags]) -> FileMode {
        FileMode {
            kind_value: kind,
            permissions_value: Permissions { mode_value: permissions & 0o777 },
            flags_value: flags,
        }
    }

    pub fn new(kind: NodeKind, permissions: u32, flags: ModeFlags) -> FileMode {
        FileMode::from_parts(kind, permissions, Option::Some(flags))
    }

    pub fn from_file_type(kind: FileType, permissions: u32) -> FileMode {
        FileMode::from_parts(
            match kind {
                File => NodeKind::File,
                Directory => NodeKind::Directory,
                Symlink => NodeKind::Symlink,
                Other => NodeKind::Unknown,
            },
            permissions,
            Option::None,
        )
    }

    pub fn kind(self: FileMode) -> NodeKind {
        self.kind_value
    }

    pub fn permissions(self: FileMode) -> Permissions {
        self.permissions_value
    }

    pub fn flags(self: FileMode) -> Option[ModeFlags] {
        self.flags_value
    }

    pub fn file_type(self: FileMode) -> FileType {
        match self.kind_value {
            File => FileType::File,
            Directory => FileType::Directory,
            Symlink => FileType::Symlink,
            _ => FileType::Other,
        }
    }
}

impl PartialEq for FileMode {
    fn eq(self: FileMode, other: FileMode) -> bool {
        self.kind_value == other.kind_value
            && self.permissions_value.mode() == other.permissions_value.mode()
            && self.flags_value == other.flags_value
    }
}

impl Eq for FileMode {}

impl Metadata {
    pub fn from_mode(mode: FileMode, length: i64, modified: i64) -> Metadata {
        Metadata {
            mode_value: mode,
            length_value: length,
            modified_unix_nanoseconds_value: modified,
        }
    }

    pub fn mode(self: Metadata) -> FileMode {
        self.mode_value
    }
}

pub struct SnapshotEntry {
    name_value: string,
    metadata_value: Metadata,
}

impl SnapshotEntry {
    pub fn new(name: string, metadata: Metadata) -> SnapshotEntry {
        SnapshotEntry { name_value: name, metadata_value: metadata }
    }

    pub fn mode(self: SnapshotEntry) -> FileMode {
        self.metadata_value.mode()
    }
}

impl DirectoryEntry for SnapshotEntry {
    fn name(self: SnapshotEntry) -> string {
        self.name_value
    }

    fn file_type(self: SnapshotEntry) -> FileType {
        self.metadata_value.file_type()
    }

    fn metadata(self: SnapshotEntry) -> Result[Metadata, Error] {
        Result::Ok(self.metadata_value)
    }
}
