package fs;

pub struct SubFs[F] {
    filesystem: F,
    root: string,
}

impl[F: FileSystem] SubFs[F] {
    pub fn new(filesystem: F, root: string) -> Result[SubFs[F], Error] {
        if !valid_path(root) {
            return Result::Err(
                portable_input_error("sub filesystem", root, "invalid filesystem path"),
            )
        }
        Result::Ok(SubFs { filesystem, root })
    }
}

impl[F: FileSystem] FileSystem for SubFs[F] {
    type Handle = F::Handle;

    fn open(self: SubFs[F], name: string) -> Result[F::Handle, Error] {
        if !valid_path(name) {
            return Result::Err(portable_input_error("open", name, "invalid filesystem path"))
        }
        let path = if self.root == "." {
            name
        } else if name == "." {
            self.root
        } else {
            self.root + "/" + name
        };
        self.filesystem.open(path)
    }
}
