package fs;

pub struct SubFs[F] {
    filesystem: F,
    root: string,
}

fn sub_path(root: string, name: string, operation: string) -> Result[string, Error] {
    if !valid_path(name) {
        return Err(portable_input_error(operation, name, "invalid filesystem path"))
    }
    Ok(
        if root == "." {
            name
        } else if name == "." {
            root
        } else {
            root + "/" + name
        },
    )
}

impl[F: FileSystem] SubFs[F] {
    pub fn new(filesystem: F, root: string) -> Result[SubFs[F], Error] {
        if !valid_path(root) {
            return Err(portable_input_error("sub filesystem", root, "invalid filesystem path"))
        }
        Ok(SubFs { filesystem, root })
    }
}

impl[F: FileSystem] FileSystem for SubFs[F] {
    type Handle = F::Handle;

    fn open(self: SubFs[F], name: string) -> Result[F::Handle, Error] {
        self.filesystem.open(sub_path(self.root, name, "open")?)
    }
}
