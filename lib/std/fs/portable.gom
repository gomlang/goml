package fs;

use module::bytes;
use module::io;
use io::Close;
use io::Read;

pub trait File: io::Read + io::Close {
    fn stat(self: Self) -> Result[Metadata, Error];
}

pub trait FileSystem {
    type Handle: File;
    fn open(self: Self, name: string) -> Result[Self::Handle, Error];
}

struct PortableReader[R] {
    reader: R,
}

impl[R: io::Read] io::Read for PortableReader[R] {
    fn read(self: PortableReader[R], buffer: MutSlice[byte]) -> Result[isize, io::Error] {
        self.reader.read(buffer)
    }
}

pub fn valid_path(name: string) -> bool {
    if name == "." {
        return true
    }
    if name.byte_len() == 0 {
        return false
    }
    let mut start = 0;
    let mut index = 0;
    loop {
        if index == name.byte_len() || name.byte_get(index) == b'/' {
            let width = index - start;
            if width == 0 || (width == 1 && name.byte_get(start) == b'.')
                || (width == 2 && name.byte_get(start) == b'.' && name.byte_get(start + 1) == b'.') {
                return false
            }
            if index == name.byte_len() {
                return true
            }
            start = index + 1;
        }
        index += 1;
    }
}

fn portable_input_error(operation: string, name: string, message: string) -> Error {
    Error::new(io::ErrorKind::InvalidInput, operation, Option::Some(name), Option::None, message)
}

fn portable_io_error(error: io::Error, operation: string, name: string) -> Error {
    Error::new(error.kind(), operation, Option::Some(name), error.raw_os_code(), error.message())
}

pub fn stat_from[F: FileSystem](filesystem: F, name: string) -> Result[Metadata, Error] {
    if !valid_path(name) {
        return Result::Err(portable_input_error("stat", name, "invalid filesystem path"))
    }
    let file = filesystem.open(name)?;
    let needs_close = Ref::new(true);
    defer {
        if needs_close.get() {
            needs_close.set(false);
            let _ = file.close();
        }
    };
    let result = file.stat();
    needs_close.set(false);
    let closed = file.close().map_err(|error| portable_io_error(error, "close file", name));
    match result {
        Err(error) => Result::Err(error),
        Ok(value) => closed.map(|_| value),
    }
}

pub fn read_file_from[F: FileSystem](filesystem: F, name: string, max_bytes: isize) -> Result[
    bytes::Bytes,
    Error,
] {
    if !valid_path(name) {
        return Result::Err(portable_input_error("read file", name, "invalid filesystem path"))
    }
    if max_bytes < 0 {
        return Result::Err(portable_input_error("read file", name, "limit must be non-negative"))
    }
    let file = filesystem.open(name)?;
    let needs_close = Ref::new(true);
    defer {
        if needs_close.get() {
            needs_close.set(false);
            let _ = file.close();
        }
    };
    let reader = PortableReader { reader: file };
    let result = reader.read_to_end(max_bytes).map_err(
        |error| portable_io_error(error, "read file", name),
    );
    needs_close.set(false);
    let closed = file.close().map_err(|error| portable_io_error(error, "close file", name));
    match result {
        Err(error) => Result::Err(error),
        Ok(value) => closed.map(|_| value),
    }
}
