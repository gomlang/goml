package fs;

use module::bytes;
use module::internal::host;
use module::io;
use module::utf8;
use utf8::BytesUtf8;

pub enum FileType {
    File,
    Directory,
    Symlink,
    Other,
}

impl FileType {
    pub fn is_file(self: FileType) -> bool {
        self == FileType::File
    }

    pub fn is_dir(self: FileType) -> bool {
        self == FileType::Directory
    }

    pub fn is_symlink(self: FileType) -> bool {
        self == FileType::Symlink
    }
}

impl PartialEq for FileType {
    fn eq(self: FileType, other: FileType) -> bool {
        match (self, other) {
            (File, File) => true,
            (Directory, Directory) => true,
            (Symlink, Symlink) => true,
            (Other, Other) => true,
            _ => false,
        }
    }
}

pub struct Permissions {
    mode_value: u32,
}

impl Permissions {
    pub fn mode(self: Permissions) -> u32 {
        self.mode_value
    }

    pub fn readonly(self: Permissions) -> bool {
        self.mode_value & 0o222 == 0
    }
}

pub struct Metadata {
    file_type_value: FileType,
    length_value: i64,
    permissions_value: Permissions,
    modified_unix_nanoseconds_value: i64,
}

impl Metadata {
    pub fn file_type(self: Metadata) -> FileType {
        self.file_type_value
    }

    pub fn len(self: Metadata) -> i64 {
        self.length_value
    }

    pub fn permissions(self: Metadata) -> Permissions {
        self.permissions_value
    }

    pub fn modified_unix_nanoseconds(self: Metadata) -> i64 {
        self.modified_unix_nanoseconds_value
    }
}

pub struct DirEntry {
    name_value: string,
    path_value: string,
    file_type_value: FileType,
}

impl DirEntry {
    pub fn name(self: DirEntry) -> string {
        self.name_value
    }

    pub fn path(self: DirEntry) -> string {
        self.path_value
    }

    pub fn file_type(self: DirEntry) -> FileType {
        self.file_type_value
    }
}

fn structured_error(
    operation: string,
    path: string,
    kind_code: isize,
    has_raw_code: bool,
    raw_code: isize,
    message: string,
) -> Error {
    Error::new(
        io::kind_from_code(kind_code),
        operation,
        Option::Some(path),
        if has_raw_code {
            Option::Some(raw_code)
        } else {
            Option::None
        },
        message,
    )
}

pub fn read_bytes_structured(path: string) -> Result[bytes::Bytes, Error] {
    let (ok, data, kind_code, has_raw_code, raw_code, message) = host::read_bytes_v2(path);
    if ok {
        Result::Ok(bytes::Bytes::from_vec(data))
    } else {
        Result::Err(structured_error("read file", path, kind_code, has_raw_code, raw_code, message))
    }
}

pub fn read_file_structured(path: string) -> Result[string, Error] {
    match read_bytes_structured(path) {
        Ok(data) => data.to_string_utf8().map_err(
            |error| Error::new(
                io::ErrorKind::InvalidData,
                "read file",
                Option::Some(path),
                Option::None,
                error.to_string(),
            ),
        ),
        Err(error) => Result::Err(error),
    }
}

pub fn write_bytes_structured(path: string, data: bytes::Bytes) -> Result[(), Error] {
    let (ok, kind_code, has_raw_code, raw_code, message) = host::write_bytes_v2(path, data.to_vec());
    if ok {
        Result::Ok(())
    } else {
        Result::Err(
            structured_error("write file", path, kind_code, has_raw_code, raw_code, message),
        )
    }
}

pub fn write_file_structured(path: string, content: string) -> Result[(), Error] {
    write_bytes_structured(path, bytes::Bytes::from_string(content))
}

fn path_operation(operation: isize, name: string, first: string, second: string) -> Result[
    (),
    Error,
] {
    let (ok, kind_code, has_raw_code, raw_code, message) = host::fs_path_operation_v2(
        operation,
        first,
        second,
    );
    if ok {
        Result::Ok(())
    } else {
        Result::Err(
            structured_error(
                name,
                if second == "" {
                    first
                } else {
                    first + " -> " + second
                },
                kind_code,
                has_raw_code,
                raw_code,
                message,
            ),
        )
    }
}

pub fn create_dir(path: string) -> Result[(), Error] {
    path_operation(0, "create directory", path, "")
}

pub fn rename(from: string, to: string) -> Result[(), Error] {
    path_operation(1, "rename", from, to)
}

pub fn replace(from: string, to: string) -> Result[(), Error] {
    path_operation(1, "replace", from, to)
}

pub fn hard_link(from: string, to: string) -> Result[(), Error] {
    path_operation(2, "create hard link", from, to)
}

pub fn symbolic_link(from: string, to: string) -> Result[(), Error] {
    path_operation(3, "create symbolic link", from, to)
}

pub fn copy(from: string, to: string) -> Result[(), Error] {
    path_operation(4, "copy file", from, to)
}

pub fn atomic_write_bytes(path: string, data: bytes::Bytes) -> Result[(), Error] {
    let (ok, kind, has_raw, raw, message) = host::fs_atomic_write_v2(path, data.to_vec());
    if ok {
        Result::Ok(())
    } else {
        Result::Err(structured_error("atomic write", path, kind, has_raw, raw, message))
    }
}

pub fn atomic_write(path: string, content: string) -> Result[(), Error] {
    atomic_write_bytes(path, bytes::Bytes::from_string(content))
}

fn file_type_from_code(code: isize) -> FileType {
    if code == 0 {
        FileType::File
    } else if code == 1 {
        FileType::Directory
    } else if code == 2 {
        FileType::Symlink
    } else {
        FileType::Other
    }
}

fn query_metadata(path: string, follow: bool) -> Result[Metadata, Error] {
    let (ok, file_type, length, mode, modified, kind, has_raw, raw, message) = host::fs_metadata_v2(
        path,
        follow,
    );
    if ok {
        Result::Ok(
            Metadata {
                file_type_value: file_type_from_code(file_type),
                length_value: length,
                permissions_value: Permissions { mode_value: mode },
                modified_unix_nanoseconds_value: modified,
            },
        )
    } else {
        Result::Err(structured_error("read metadata", path, kind, has_raw, raw, message))
    }
}

pub fn metadata(path: string) -> Result[Metadata, Error] {
    query_metadata(path, true)
}

pub fn symlink_metadata(path: string) -> Result[Metadata, Error] {
    query_metadata(path, false)
}

pub fn try_exists(path: string) -> Result[bool, Error] {
    match metadata(path) {
        Ok(_) => Result::Ok(true),
        Err(error) => if error.kind() == io::ErrorKind::NotFound {
            Result::Ok(false)
        } else {
            Result::Err(error)
        },
    }
}

pub fn read_dir_names_structured(path: string) -> Result[Vec[string], Error] {
    let (ok, names, kind, has_raw, raw, message) = host::read_dir_v2(path);
    if !ok {
        Result::Err(structured_error("read directory", path, kind, has_raw, raw, message))
    } else {
        Result::Ok(names)
    }
}

pub fn read_dir_structured(path: string) -> Result[Vec[DirEntry], Error] {
    let entries: Vec[DirEntry] = Vec::new();
    for name in read_dir_names_structured(path)? {
        let entry_path = host::path_join(path, name);
        let value = symlink_metadata(entry_path)?;
        entries.push(
            DirEntry {
                name_value: name,
                path_value: entry_path,
                file_type_value: value.file_type(),
            },
        )
    }
    Result::Ok(entries)
}

pub fn create_dir_all(path: string) -> Result[(), Error] {
    let (ok, err) = host::create_dir_all(path);
    if ok {
        Result::Ok(())
    } else {
        Result::Err(structured_error("create directories", path, 0, false, 0, err))
    }
}

pub fn remove_file(path: string) -> Result[(), Error] {
    let (ok, err) = host::remove_file(path);
    if ok {
        Result::Ok(())
    } else {
        Result::Err(structured_error("remove file", path, 0, false, 0, err))
    }
}

pub fn remove_dir_all(path: string) -> Result[(), Error] {
    let (ok, err) = host::remove_dir_all(path);
    if ok {
        Result::Ok(())
    } else {
        Result::Err(structured_error("remove directory", path, 0, false, 0, err))
    }
}

pub fn exists(path: string) -> bool {
    host::file_exists(path)
}

pub fn is_file(path: string) -> bool {
    host::is_file(path)
}

pub fn is_dir(path: string) -> bool {
    host::is_dir(path)
}

pub fn canonicalize(path: string) -> Result[string, Error] {
    let (ok, result, err) = host::canonicalize(path);
    if ok {
        Result::Ok(result)
    } else {
        Result::Err(structured_error("canonicalize", path, 0, false, 0, err))
    }
}

pub fn read_dir(path: string) -> Result[Vec[string], Error] {
    let (ok, names, err) = host::read_dir(path);
    if ok {
        Result::Ok(names)
    } else {
        Result::Err(structured_error("read directory", path, 0, false, 0, err))
    }
}

pub fn sha256_file(path: string) -> Result[string, Error] {
    let (ok, result, err) = host::sha256_file(path);
    if ok {
        Result::Ok(result)
    } else {
        Result::Err(structured_error("hash file", path, 0, false, 0, err))
    }
}
