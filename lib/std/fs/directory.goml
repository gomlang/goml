package fs;

pub trait DirectoryEntry {
    fn name(self: Self) -> string;
    fn file_type(self: Self) -> FileType;
    fn metadata(self: Self) -> Result[Metadata, Error];
}

pub trait ReadDirFile: File {
    type Entry: DirectoryEntry;
    fn read_dir(self: Self, amount: isize) -> Result[Vec[Self::Entry], ReadDirError[Self::Entry]];
}

pub struct ReadDirError[E] {
    entries_value: Vec[E],
    error_value: Error,
}

impl[E] ReadDirError[E] {
    pub fn new(entries: Vec[E], error: Error) -> ReadDirError[E] {
        let snapshot = Vec::with_capacity(entries.len());
        for entry in entries {
            snapshot.push(entry);
        }
        ReadDirError { entries_value: snapshot, error_value: error }
    }

    pub fn entries(self: ReadDirError[E]) -> Slice[E] {
        self.entries_value.as_slice()
    }

    pub fn error(self: ReadDirError[E]) -> Error {
        self.error_value
    }
}

impl[E] ToString for ReadDirError[E] {
    fn to_string(self: ReadDirError[E]) -> string {
        self.error_value.to_string()
    }
}

impl[E] Debug for ReadDirError[E] {
    fn debug(self: ReadDirError[E]) -> string {
        self.error_value.debug()
    }
}

impl DirectoryEntry for DirEntry {
    fn name(self: DirEntry) -> string {
        self.name_value
    }

    fn file_type(self: DirEntry) -> FileType {
        self.file_type_value
    }

    fn metadata(self: DirEntry) -> Result[Metadata, Error] {
        symlink_metadata(self.path())
    }
}
