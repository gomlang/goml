package walkdir;

use module::fs;
use module::path;

pub struct DirEntry {
    path_value: string,
    depth_value: isize,
    metadata_value: fs::Metadata,
    symlink: bool,
}

impl DirEntry {
    pub fn path(self: DirEntry) -> string {
        self.path_value
    }

    pub fn file_name(self: DirEntry) -> Option[string] {
        path::file_name(self.path_value)
    }

    pub fn depth(self: DirEntry) -> isize {
        self.depth_value
    }

    pub fn file_type(self: DirEntry) -> fs::FileType {
        self.metadata_value.file_type()
    }

    pub fn metadata(self: DirEntry) -> fs::Metadata {
        self.metadata_value
    }

    pub fn path_is_symlink(self: DirEntry) -> bool {
        self.symlink
    }
}

impl Debug for DirEntry {
    fn debug(self: DirEntry) -> string {
        "DirEntry(" + self.path_value + ", depth=" + self.depth_value.to_string() + ")"
    }
}

fn read_entry(name: string, depth: isize, follow: bool) -> Result[DirEntry, Error] {
    let link_metadata = fs::symlink_metadata(name).map_err(|error| from_fs(error, name, depth))?;
    let symlink = link_metadata.file_type().is_symlink();
    let metadata = if symlink && follow {
        fs::metadata(name).map_err(|error| from_fs(error, name, depth))?
    } else {
        link_metadata
    };
    Result::Ok(DirEntry { path_value: name, depth_value: depth, metadata_value: metadata, symlink })
}
