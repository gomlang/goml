package walkdir;

pub struct WalkDir {
    root: string,
    minimum: isize,
    maximum: Option[isize],
    follow: bool,
    postorder: bool,
    predicate: (DirEntry) -> bool,
}

impl WalkDir {
    pub fn new(root: string) -> WalkDir {
        WalkDir {
            root,
            minimum: 0,
            maximum: Option::None,
            follow: false,
            postorder: false,
            predicate: |_| true,
        }
    }

    pub fn min_depth(self: WalkDir, depth: isize) -> WalkDir {
        WalkDir { minimum: depth, ..self }
    }

    pub fn max_depth(self: WalkDir, depth: isize) -> WalkDir {
        WalkDir { maximum: Option::Some(depth), ..self }
    }

    pub fn follow_links(self: WalkDir, enabled: bool) -> WalkDir {
        WalkDir { follow: enabled, ..self }
    }

    pub fn contents_first(self: WalkDir, enabled: bool) -> WalkDir {
        WalkDir { postorder: enabled, ..self }
    }

    pub fn filter_entry(self: WalkDir, predicate: (DirEntry) -> bool) -> WalkDir {
        WalkDir { predicate: |entry| (self.predicate)(entry) && predicate(entry), ..self }
    }

    pub fn iter(self: WalkDir) -> WalkIterator {
        WalkIterator {
            options: self,
            started: Ref::new(false),
            done: Ref::new(false),
            pending: Ref::new(Option::None),
            work: Vec::from_array([Work::Visit(self.root, 0)]),
            ancestors: HashMap::new(),
        }
    }
}

impl IntoIterator for WalkDir {
    type Item = Result[DirEntry, Error];

    type IntoIter = WalkIterator;

    fn into_iter(self: WalkDir) -> WalkIterator {
        self.iter()
    }
}

pub fn walk(root: string) -> WalkIterator {
    WalkDir::new(root).iter()
}
