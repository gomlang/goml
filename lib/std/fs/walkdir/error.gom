package walkdir;

use module::fs;
use module::io;

pub struct Error {
    cause: fs::Error,
    path_value: string,
    depth_value: isize,
    ancestor: Option[string],
}

impl Error {
    pub fn path(self: Error) -> string {
        self.path_value
    }

    pub fn depth(self: Error) -> isize {
        self.depth_value
    }

    pub fn kind(self: Error) -> io::ErrorKind {
        self.cause.kind()
    }

    pub fn fs_error(self: Error) -> fs::Error {
        self.cause
    }

    pub fn loop_ancestor(self: Error) -> Option[string] {
        self.ancestor
    }
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        self.cause.to_string() + " (depth " + self.depth_value.to_string() + ")"
    }
}

impl Debug for Error {
    fn debug(self: Error) -> string {
        self.to_string()
    }
}

fn from_fs(cause: fs::Error, name: string, depth: isize) -> Error {
    Error { cause, path_value: name, depth_value: depth, ancestor: Option::None }
}

fn invalid_options(root: string) -> Error {
    from_fs(
        fs::Error::new(
            io::ErrorKind::InvalidInput,
            "walk directory",
            Option::Some(root),
            Option::None,
            "depth bounds must be nonnegative and min_depth must not exceed max_depth",
        ),
        root,
        0,
    )
}

fn loop_error(entry: DirEntry, ancestor: string) -> Error {
    Error {
        cause: fs::Error::new(
            io::ErrorKind::InvalidData,
            "walk directory",
            Option::Some(entry.path()),
            Option::None,
            "directory loop to " + ancestor,
        ),
        path_value: entry.path(),
        depth_value: entry.depth(),
        ancestor: Option::Some(ancestor),
    }
}
