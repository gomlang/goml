package walkdir;

use module::bytes::endian;
use module::fs;
use module::io;
use module::utf8;

struct NativeMetadata {
    value: fs::Metadata,
    identity: string,
}

fn malformed(operation: string, name: string, message: string) -> fs::Error {
    kernel_error(io::ErrorKind::InvalidData, operation, name, message)
}

fn stat_word(data: Slice[byte], offset: isize, name: string) -> Result[u64, fs::Error] {
    endian::read_u64(data, offset, endian::Endian::Little).map_err(
        |error| malformed("read metadata", name, error.to_string()),
    )
}

fn decode_stat(data: Slice[byte], name: string) -> Result[NativeMetadata, fs::Error] {
    if data.len() != 144 {
        return Result::Err(
            malformed("read metadata", name, "invalid linux/amd64 stat record length"),
        );
    }
    let device = stat_word(data, 0, name)?;
    let inode = stat_word(data, 8, name)?;
    let mode = endian::read_u32(data, 24, endian::Endian::Little).map_err(
        |error| malformed("read metadata", name, error.to_string()),
    )?;
    let size = stat_word(data, 48, name)?.to_i64();
    let seconds = stat_word(data, 88, name)?.to_i64();
    let nanos = stat_word(data, 96, name)?;
    if nanos >= 1000000000 {
        return Result::Err(malformed("read metadata", name, "invalid stat nanoseconds"));
    }
    let file_type = match mode & 0xf000 {
        0x8000 => fs::FileType::File,
        0x4000 => fs::FileType::Directory,
        0xa000 => fs::FileType::Symlink,
        _ => fs::FileType::Other,
    };
    Result::Ok(
        NativeMetadata {
            value: fs::Metadata::from_parts(
                file_type,
                size,
                mode,
                seconds * 1000000000 + nanos.to_i64(),
            ),
            identity: device.to_string() + ":" + inode.to_string(),
        },
    )
}

fn decode_dirents(data: Slice[byte], directory: string) -> Result[Vec[string], fs::Error] {
    let result = Vec::new();
    let mut offset = 0;
    while offset < data.len() {
        if data.len() - offset < 24 {
            return Result::Err(
                malformed("read directory", directory, "truncated getdents64 record"),
            );
        }
        let length = endian::read_u16(data, offset + 16, endian::Endian::Little).map_err(
            |error| malformed("read directory", directory, error.to_string()),
        )?.to_isize();
        if length < 24 || length % 8 != 0 || length > data.len() - offset {
            return Result::Err(
                malformed("read directory", directory, "invalid getdents64 record length"),
            );
        }
        let inode = endian::read_u64(data, offset, endian::Endian::Little).map_err(
            |error| malformed("read directory", directory, error.to_string()),
        )?;
        let mut end = offset + 19;
        while end < offset + length && data[end] != 0 {
            end += 1;
        }
        if end == offset + length || end == offset + 19 {
            return Result::Err(
                malformed("read directory", directory, "invalid getdents64 filename"),
            );
        }
        let name = utf8::decode(data.sub(offset + 19, end).to_vec()).map_err(
            |error| malformed("read directory", directory, error.to_string()),
        )?;
        if name.contains("/") {
            return Result::Err(
                malformed("read directory", directory, "getdents64 filename contains a separator"),
            );
        }
        if inode != 0 && name != "." && name != ".." {
            result.push(name);
        }
        offset += length;
    }
    Result::Ok(result)
}
