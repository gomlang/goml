package walkdir;

use module::fs;
use module::io;
use module::os::linux::syscall;
use module::os::linux::syscall::{Arg};
use module::utf8;

const AT_FDCWD: isize = -100;

const AT_SYMLINK_NOFOLLOW: usize = 0x100;

const O_DIRECTORY: usize = 0x10000;

const O_NOFOLLOW: usize = 0x20000;

const O_CLOEXEC: usize = 0x80000;

struct Location {
    path: string,
    name: string,
    parent: usize,
    depth: isize,
}

fn zeroes(size: isize) -> Vec[byte] {
    let result = Vec::new();
    for _ in 0..size {
        result.push(0);
    }
    result
}

fn kernel_error(kind: io::ErrorKind, operation: string, name: string, message: string) -> fs::Error {
    fs::Error::new(kind, operation, Option::Some(name), Option::None, message)
}

fn errno_error(operation: string, name: string, errno: usize) -> fs::Error {
    let kind = match errno {
        2 => io::ErrorKind::NotFound,
        1 | 13 => io::ErrorKind::PermissionDenied,
        4 => io::ErrorKind::Interrupted,
        11 => io::ErrorKind::WouldBlock,
        17 => io::ErrorKind::AlreadyExists,
        9 | 20 | 22 | 36 | 40 => io::ErrorKind::InvalidInput,
        38 | 95 => io::ErrorKind::Unsupported,
        _ => io::ErrorKind::Other,
    };
    fs::Error::new(
        kind,
        operation,
        Option::Some(name),
        Option::Some(errno.to_isize()),
        "errno " + errno.to_string(),
    )
}

fn invoke(number: usize, args: [Arg; 6], operation: string, name: string) -> Result[
    usize,
    fs::Error,
] {
    loop {
        let result = syscall::syscall6_with_buffers(number, args).map_err(
            |error| kernel_error(io::ErrorKind::Unsupported, operation, name, error.to_string()),
        )?;
        if result.errno == syscall::EINTR {
            continue;
        }
        return if result.is_ok() {
            Result::Ok(result.r1)
        } else {
            Result::Err(errno_error(operation, name, result.errno))
        };
    }
}

fn c_path(name: string, operation: string, display: string) -> Result[Vec[byte], fs::Error] {
    let result = utf8::encode(name);
    if result.contains(0) {
        return Result::Err(
            kernel_error(
                io::ErrorKind::InvalidInput,
                operation,
                display,
                "path contains a NUL byte",
            ),
        );
    }
    result.push(0);
    Result::Ok(result)
}

fn stat_at(location: Location, follow: bool) -> Result[NativeMetadata, fs::Error] {
    let name = c_path(location.name, "read metadata", location.path)?;
    let data = zeroes(144);
    let flags = if follow {
        0
    } else {
        AT_SYMLINK_NOFOLLOW
    };
    invoke(
        syscall::SYS_NEWFSTATAT,
        [
            Arg::Word(location.parent),
            Arg::Buffer(name.as_mut_slice()),
            Arg::Buffer(data.as_mut_slice()),
            Arg::Word(flags),
            Arg::Word(0),
            Arg::Word(0),
        ],
        "read metadata",
        location.path,
    )?;
    decode_stat(data.as_slice(), location.path)
}

fn stat_fd(fd: usize, name: string) -> Result[NativeMetadata, fs::Error] {
    let data = zeroes(144);
    invoke(
        syscall::SYS_FSTAT,
        [
            Arg::Word(fd),
            Arg::Buffer(data.as_mut_slice()),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
        "read metadata",
        name,
    )?;
    decode_stat(data.as_slice(), name)
}

fn open_directory(location: Location, follow: bool) -> Result[usize, fs::Error] {
    let name = c_path(location.name, "read directory", location.path)?;
    let flags = O_DIRECTORY | O_CLOEXEC
        | if follow {
            0
        } else {
            O_NOFOLLOW
        };
    invoke(
        syscall::SYS_OPENAT,
        [
            Arg::Word(location.parent),
            Arg::Buffer(name.as_mut_slice()),
            Arg::Word(flags),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
        "read directory",
        location.path,
    )
}

fn close_fd(fd: usize, name: string) -> Result[(), fs::Error] {
    let result = syscall::syscall6(syscall::SYS_CLOSE, [fd, 0, 0, 0, 0, 0]).map_err(
        |error| kernel_error(io::ErrorKind::Unsupported, "close directory", name, error.to_string()),
    )?;
    if result.is_ok() {
        Result::Ok(())
    } else {
        Result::Err(errno_error("close directory", name, result.errno))
    }
}

fn directory_names(fd: usize, name: string) -> Result[Vec[string], fs::Error] {
    let result = Vec::new();
    let data = zeroes(32768);
    loop {
        let count = invoke(
            syscall::SYS_GETDENTS64,
            [
                Arg::Word(fd),
                Arg::Buffer(data.as_mut_slice()),
                Arg::Word(data.len().to_usize()),
                Arg::Word(0),
                Arg::Word(0),
                Arg::Word(0),
            ],
            "read directory",
            name,
        )?;
        if count == 0 {
            break;
        }
        if count > data.len().to_usize() {
            return Result::Err(
                malformed("read directory", name, "getdents64 returned an invalid byte count"),
            );
        }
        result.extend(decode_dirents(data.slice(0, count.to_isize()), name)?);
    }
    result.sort_by(
        |left, right| if left < right {
            -1
        } else if left == right {
            0
        } else {
            1
        },
    );
    Result::Ok(result)
}
