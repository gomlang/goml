package walkdir;

use module::io;
use module::path;

struct Pending {
    entry: DirEntry,
    location: Location,
}

struct OpenDirectory {
    fd: usize,
    identity: string,
}

enum Work {
    Visit(Location),
    Leave(DirEntry, Option[OpenDirectory]),
}

pub struct WalkIterator {
    options: WalkDir,
    started: Ref[bool],
    done: Ref[bool],
    pending: Ref[Option[Pending]],
    work: Vec[Work],
    ancestors: HashMap[string, string],
    descriptors: HashMap[usize, string],
}

impl WalkIterator {
    pub fn skip_current_dir(self: WalkIterator) -> () {
        self.pending.set(Option::None);
    }

    pub fn close(self: WalkIterator) -> () {
        self.done.set(true);
        self.pending.set(Option::None);
        self.work.clear();
        for (fd, name) in self.descriptors.entries() {
            self.descriptors.remove(fd);
            let _ = close_fd(fd, name);
        }
        for (name, _) in self.ancestors.entries() {
            self.ancestors.remove(name);
        }
    }
}

fn descend_open(iterator: WalkIterator, pending: Pending) -> Result[(), Error] {
    let entry = pending.entry;
    let fd = open_directory(pending.location, iterator.options.follow).map_err(
        |error| from_fs(error, entry.path(), entry.depth()),
    )?;
    let retained = Ref::new(false);
    defer {
        if !retained.get() {
            let _ = close_fd(fd, entry.path());
        }
    };
    let metadata = stat_fd(fd, entry.path()).map_err(
        |error| from_fs(error, entry.path(), entry.depth()),
    )?;
    if metadata.identity != entry.identity {
        return Result::Err(
            from_fs(
                kernel_error(
                    io::ErrorKind::Other,
                    "read directory",
                    entry.path(),
                    "directory changed before it could be opened",
                ),
                entry.path(),
                entry.depth(),
            ),
        );
    }
    if let Some(ancestor) = iterator.ancestors[metadata.identity] {
        return Result::Err(loop_error(entry, ancestor));
    }
    let names = directory_names(fd, entry.path()).map_err(
        |error| from_fs(error, entry.path(), entry.depth()),
    )?;
    iterator.descriptors.insert(fd, entry.path());
    iterator.ancestors.insert(metadata.identity, entry.path());
    retained.set(true);
    iterator.work.push(
        Work::Leave(entry, Option::Some(OpenDirectory { fd, identity: metadata.identity })),
    );
    let mut index = names.len();
    while index > 0 {
        index -= 1;
        iterator.work.push(
            Work::Visit(
                Location {
                    path: path::join(entry.path(), names[index]),
                    name: names[index],
                    parent: fd,
                    depth: entry.depth() + 1,
                },
            ),
        );
    }
    Result::Ok(())
}

fn descend(iterator: WalkIterator, pending: Pending) -> Result[(), Error] {
    let result = descend_open(iterator, pending);
    if result.is_err() {
        iterator.work.push(Work::Leave(pending.entry, Option::None));
    }
    result
}

impl Iterator for WalkIterator {
    type Item = Result[DirEntry, Error];

    fn next(self: WalkIterator) -> Option[Result[DirEntry, Error]] {
        if self.done.get() {
            return Option::None;
        }
        if !self.started.get() {
            self.started.set(true);
            let valid_maximum = match self.options.maximum {
                Some(value) => value >= self.options.minimum,
                None => true,
            };
            if self.options.minimum < 0 || !valid_maximum {
                self.close();
                return Option::Some(Result::Err(invalid_options(self.options.root)));
            }
        }
        if let Some(entry) = self.pending.get() {
            self.pending.set(Option::None);
            if let Err(error) = descend(self, entry) {
                return Option::Some(Result::Err(error));
            }
        }
        while let Some(work) = self.work.pop() {
            match work {
                Leave(entry, directory) => {
                    if let Some(open) = directory {
                        self.ancestors.remove(open.identity);
                        self.descriptors.remove(open.fd);
                        if let Err(error) = close_fd(open.fd, entry.path()) {
                            if self.options.postorder {
                                self.work.push(Work::Leave(entry, Option::None));
                            }
                            return Option::Some(
                                Result::Err(from_fs(error, entry.path(), entry.depth())),
                            );
                        }
                    }
                    if self.options.postorder && entry.depth() >= self.options.minimum {
                        return Option::Some(Result::Ok(entry));
                    }
                },
                Visit(location) => {
                    let depth = location.depth;
                    let entry = match read_entry(location, self.options.follow) {
                        Ok(value) => value,
                        Err(error) => return Option::Some(Result::Err(error)),
                    };
                    let accepted = (self.options.predicate)(entry);
                    if self.done.get() {
                        return Option::None;
                    }
                    if !accepted {
                        continue;
                    }
                    let below_maximum = match self.options.maximum {
                        Some(value) => depth < value,
                        None => true,
                    };
                    if entry.file_type().is_dir() && below_maximum {
                        if !self.options.postorder && depth >= self.options.minimum {
                            self.pending.set(Option::Some(Pending { entry, location }));
                            return Option::Some(Result::Ok(entry));
                        }
                        if let Err(error) = descend(self, Pending { entry, location }) {
                            return Option::Some(Result::Err(error));
                        }
                    } else if depth >= self.options.minimum {
                        return Option::Some(Result::Ok(entry));
                    }
                },
            }
        }
        self.close();
        Option::None
    }
}
