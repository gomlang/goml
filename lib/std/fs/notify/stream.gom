package notify;

use module::fs;
use module::io;
use module::task;

pub struct Subscription[T] {
    output: Receiver[Result[Vec[T], fs::Error]],
    stop: Channel[()],
    stopped: Channel[bool],
    worker: task::Task[Result[(), fs::Error]],
}

impl[T] Subscription[T] {
    pub fn events(self: Subscription[T]) -> Receiver[Result[Vec[T], fs::Error]] {
        self.output
    }

    pub fn done(self: Subscription[T]) -> Receiver[()] {
        self.worker.done()
    }

    pub fn close(self: Subscription[T]) -> Result[(), fs::Error] {
        let stopped = self.stopped.recv().unwrap_or(true);
        if !stopped {
            self.stop.close();
        }
        self.stopped.send(true);
        self.worker.join()
    }
}

fn stop_requested(stop: Channel[()], cancel: task::CancelToken, source_closed: Receiver[()]) -> bool {
    select {
        recv(stop) as _ => true,
        recv(cancel.done()) as _ => true,
        recv(source_closed) as _ => true,
        default => false,
    }
}

fn subscribe_source[T](
    scope: task::Scope,
    capacity: isize,
    read: () -> Result[Vec[T], fs::Error],
    close: () -> Result[(), fs::Error],
    ended: () -> bool,
    source_closed: Receiver[()],
) -> Result[Subscription[T], fs::Error] {
    if capacity < 0 {
        return Result::Err(
            error(io::ErrorKind::InvalidInput, "subscription capacity must be nonnegative"),
        );
    }
    if scope.token().is_cancelled() {
        return Result::Err(error(io::ErrorKind::Interrupted, "subscription scope is cancelled"));
    }
    let output: Channel[Result[Vec[T], fs::Error]] = Channel::new(capacity);
    let stop: Channel[()] = Channel::new(0);
    let stopped = Channel::new(1);
    stopped.send(false);
    let worker = scope.try_spawn(
        |cancel: task::CancelToken| {
            defer output.close();
            loop {
                if stop_requested(stop, cancel, source_closed) {
                    break;
                }
                let batch = read();
                if let Ok(events) = batch {
                    if events.is_empty() {
                        if ended() {
                            break;
                        }
                        continue;
                    }
                }
                let failed = batch.is_err();
                let delivered = select {
                    send(output, batch) => true,
                    recv(stop) as _ => false,
                    recv(cancel.done()) as _ => false,
                    recv(source_closed) as _ => false,
                };
                if !delivered || failed || ended() {
                    break;
                }
            }
            close()
        },
    ).ok_or(error(io::ErrorKind::Interrupted, "subscription scope is cancelled"))?;
    Result::Ok(Subscription { output: output.receiver(), stop, stopped, worker })
}
