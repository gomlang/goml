package fs;

pub trait LinkFileSystem: FileSystem {
    fn read_link(self: Self, name: string) -> Result[string, Error];
    fn symlink_metadata(self: Self, name: string) -> Result[Metadata, Error];
}

pub fn read_link_from[F: LinkFileSystem](filesystem: F, name: string) -> Result[string, Error] {
    if !valid_path(name) {
        return Err(portable_input_error("read link", name, "invalid filesystem path"))
    }
    filesystem.read_link(name)
}

pub fn symlink_metadata_from[F: LinkFileSystem](filesystem: F, name: string) -> Result[
    Metadata,
    Error,
] {
    if !valid_path(name) {
        return Err(portable_input_error("symlink metadata", name, "invalid filesystem path"))
    }
    filesystem.symlink_metadata(name)
}

impl[F: LinkFileSystem] LinkFileSystem for SubFs[F] {
    fn read_link(self: SubFs[F], name: string) -> Result[string, Error] {
        self.filesystem.read_link(sub_path(self.root, name, "read link")?)
    }

    fn symlink_metadata(self: SubFs[F], name: string) -> Result[Metadata, Error] {
        self.filesystem.symlink_metadata(sub_path(self.root, name, "symlink metadata")?)
    }
}
