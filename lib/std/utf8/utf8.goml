package utf8;

use module::bytes;

pub trait BytesUtf8 {
    fn to_string_utf8(self: Self) -> Result[string, Utf8Error];
}

impl BytesUtf8 for bytes::Bytes {
    fn to_string_utf8(self: bytes::Bytes) -> Result[string, Utf8Error] {
        decode(self.to_vec())
    }
}

pub struct Utf8Error {
    valid_up_to_value: isize,
    error_length_value: Option[isize],
}

impl Utf8Error {
    pub fn new(valid_up_to: isize, error_length: Option[isize]) -> Utf8Error {
        Utf8Error { valid_up_to_value: valid_up_to, error_length_value: error_length }
    }

    pub fn valid_up_to(self: Utf8Error) -> isize {
        self.valid_up_to_value
    }

    pub fn error_length(self: Utf8Error) -> Option[isize] {
        self.error_length_value
    }
}

impl ToString for Utf8Error {
    fn to_string(self: Utf8Error) -> string {
        f"invalid UTF-8 at byte {self.valid_up_to_value}"
    }
}

impl Debug for Utf8Error {
    fn debug(self: Utf8Error) -> string {
        self.to_string()
    }
}

impl PartialEq for Utf8Error {
    fn eq(self: Utf8Error, other: Utf8Error) -> bool {
        self.valid_up_to_value == other.valid_up_to_value
            && self.error_length_value == other.error_length_value
    }
}

fn continuation(value: byte) -> bool {
    value >= 0x80 && value <= 0xbf
}

pub fn validate(bytes: Slice[byte]) -> Result[(), Utf8Error] {
    let mut index = 0;
    while index < bytes.len() {
        match prefix(bytes.sub(index, bytes.len())) {
            Prefix::Scalar(_, width) => {
                index += width;
            },
            Prefix::Invalid => return Result::Err(Utf8Error::new(index, Option::Some(1))),
            Prefix::Incomplete => return Result::Err(Utf8Error::new(index, Option::None)),
        }
    }
    Result::Ok(())
}

pub fn decode(bytes: Vec[byte]) -> Result[string, Utf8Error] {
    decode_slice(bytes.as_slice())
}

pub fn decode_slice(bytes: Slice[byte]) -> Result[string, Utf8Error] {
    validate(bytes)?;
    let values = bytes.to_vec();
    let (valid, value) = string_from_utf8(values);
    if valid {
        Result::Ok(value)
    } else {
        Result::Err(Utf8Error::new(0, Option::None))
    }
}

pub fn encode(value: string) -> Vec[byte] {
    value.to_bytes()
}

pub fn encode_into(value: string, output: MutSlice[byte], offset: isize) -> Result[
    isize,
    bytes::BoundsError,
] {
    let encoded = value.to_bytes();
    if output.copy_from(offset, encoded.as_slice()) {
        Result::Ok(encoded.len())
    } else {
        Result::Err(bytes::BoundsError::new(offset, encoded.len(), output.len()))
    }
}

pub fn encode_to(value: string, output: bytes::Builder) -> () {
    output.extend(value.to_bytes().as_slice())
}

pub fn encode_char_into(value: char, output: MutSlice[byte], offset: isize) -> Result[
    isize,
    bytes::BoundsError,
] {
    let width = encoded_len(value);
    if offset < 0 || offset > output.len() || width > output.len() - offset {
        return Result::Err(bytes::BoundsError::new(offset, width, output.len()))
    }
    let encoded = encode_char(value);
    for index in 0..width {
        output[offset + index] = encoded[index];
    }
    Result::Ok(width)
}

pub fn encoded_len(value: char) -> isize {
    let scalar = value.to_u32();
    if scalar <= 0x7f {
        1
    } else if scalar <= 0x7ff {
        2
    } else if scalar <= 0xffff {
        3
    } else {
        4
    }
}

pub fn encode_char(value: char) -> Vec[byte] {
    let scalar = value.to_u32();
    let result: Vec[byte] = Vec::with_capacity(encoded_len(value));
    if scalar <= 0x7f {
        result.push(scalar.to_u8());
    } else if scalar <= 0x7ff {
        result.push((0xc0 | (scalar >> 6)).to_u8());
        result.push((0x80 | (scalar & 0x3f)).to_u8());
    } else if scalar <= 0xffff {
        result.push((0xe0 | (scalar >> 12)).to_u8());
        result.push((0x80 | ((scalar >> 6) & 0x3f)).to_u8());
        result.push((0x80 | (scalar & 0x3f)).to_u8());
    } else {
        result.push((0xf0 | (scalar >> 18)).to_u8());
        result.push((0x80 | ((scalar >> 12) & 0x3f)).to_u8());
        result.push((0x80 | ((scalar >> 6) & 0x3f)).to_u8());
        result.push((0x80 | (scalar & 0x3f)).to_u8());
    }
    result
}

pub fn encode_char_to(value: char, output: bytes::Builder) -> () {
    output.extend(encode_char(value).as_slice())
}
