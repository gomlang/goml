package tests;

fn text_reference_full_rune(input: Slice[byte]) -> bool {
    let width = text_reference_utf8_width(input);
    width != 0 && (width < 0 || !text_reference_utf8_prefix(input, width) || input.len() >= width)
}

fn text_reference_utf8_prefix(input: Slice[byte], width: isize) -> bool {
    for index in 1..width {
        if index >= input.len() {
            break
        }
        let value = input[index];
        if value < 0x80 || value > 0xbf {
            return false
        }
        if index == 1 {
            if input[0] == 0xe0 && value < 0xa0 {
                return false
            }
            if input[0] == 0xed && value > 0x9f {
                return false
            }
            if input[0] == 0xf0 && value < 0x90 {
                return false
            }
            if input[0] == 0xf4 && value > 0x8f {
                return false
            }
        }
    }
    true
}

fn text_reference_utf8_width(input: Slice[byte]) -> isize {
    if input.len() == 0 {
        return 0
    }
    let lead = input[0];
    if lead < 0x80 {
        1
    } else if lead >= 0xc2 && lead <= 0xdf {
        2
    } else if lead >= 0xe0 && lead <= 0xef {
        3
    } else if lead >= 0xf0 && lead <= 0xf4 {
        4
    } else {
        -1
    }
}

fn text_reference_valid_utf8(input: Slice[byte]) -> bool {
    let mut index = 0;
    while index < input.len() {
        let decoded = text_reference_decode_rune(input.sub(index, input.len()));
        if decoded.0 == '�' && decoded.1 == 1 {
            return false
        }
        index += decoded.1;
    }
    true
}

fn text_reference_decode_rune(input: Slice[byte]) -> (char, isize) {
    let width = text_reference_utf8_width(input);
    if width == 0 {
        return ('�', 0)
    }
    if width < 0 || input.len() < width || !text_reference_utf8_prefix(input, width) {
        return ('�', 1)
    }
    let mask = match width {
        1 => 0x7f,
        2 => 0x1f,
        3 => 0xf,
        _ => 7,
    };
    let mut value = input[0].to_u32() & mask;
    for index in 1..width {
        value = value * 64 + (input[index].to_u32() & 63);
    };
    (char_from_u32(value).unwrap_or('�'), width)
}

fn text_reference_rune_count(input: Slice[byte]) -> isize {
    let mut index = 0;
    let mut count = 0;
    while index < input.len() {
        index += text_reference_decode_rune(input.sub(index, input.len())).1;
        count += 1;
    }
    count
}

fn text_reference_decode_last_rune(input: Slice[byte]) -> (char, isize) {
    if input.len() == 0 {
        return ('�', 0)
    }
    let mut start = input.len() - 1;
    while start > 0 && input.len() - start < 4 && !text_reference_rune_start(input[start]) {
        start -= 1;
    }
    let decoded = text_reference_decode_rune(input.sub(start, input.len()));
    if start + decoded.1 == input.len() {
        decoded
    } else {
        ('�', 1)
    }
}

fn text_reference_rune_start(value: byte) -> bool {
    (value & 0xc0) != 0x80
}

fn text_reference_encode_rune(output: MutSlice[byte], value: char) -> isize {
    let code = value.to_u32();
    let width = if code < 0x80 {
        1
    } else if code < 0x800 {
        2
    } else if code < 0x10000 {
        3
    } else {
        4
    };
    if width == 1 {
        output[0] = code.to_u8();
    } else {
        let prefix = match width {
            2 => 0xc0,
            3 => 0xe0,
            _ => 0xf0,
        };
        output[0] = (prefix | (code >> ((width - 1) * 6).to_u32())).to_u8();
        for index in 1..width {
            output[index] = (0x80 | ((code >> ((width - 1 - index) * 6).to_u32()) & 63)).to_u8();
        }
    }
    width
}

fn text_reference_valid_rune(value: i32) -> bool {
    value >= 0 && value <= 0x10ffff && (value < 0xd800 || value > 0xdfff)
}
