package tests;

use std::bytes;
use std::testing;
use std::utf8;

#[test]
fn utf8_string_writes_preserve_bounds() -> () {
    for value in["", "ascii", "é界🙂"] {
        let encoded = value.to_bytes();
        let output = Vec::from_array(
            [b'!', b'!', b'!', b'!', b'!', b'!', b'!', b'!', b'!', b'!', b'!'],
        );
        assert_equal(
            testing::expect_ok(utf8::encode_into(value, output.as_mut_slice(), 1), "string output"),
            encoded.len(),
        );
        assert_equal(output.slice(1, encoded.len() + 1).to_vec(), encoded);
        assert_equal(output[0], b'!');
        assert_equal(output[encoded.len() + 1], b'!');
        let before = output.copy();
        for offset in[-1, 12, 9223372036854775807] {
            let error = testing::expect_err(
                utf8::encode_into(value, output.as_mut_slice(), offset),
                "out of bounds string output",
            );
            assert_equal(error.offset(), offset);
            assert_equal(error.needed(), encoded.len());
            assert_equal(output, before);
        }
        if encoded.len() > 0 {
            testing::assert(utf8::encode_into(value, output.as_mut_slice(), output.len()).is_err());
            assert_equal(output, before);
        }
        let builder = bytes::Builder::new();
        builder.push(b'!');
        utf8::encode_to(value, builder);
        assert_equal(builder.to_vec(), ("!" + value).to_bytes());
    }
}
