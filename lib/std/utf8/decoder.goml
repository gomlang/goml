package utf8;

pub enum DecoderError {
    InvalidUtf8(Utf8Error),
    Finished,
    OffsetOverflow,
}

impl ToString for DecoderError {
    fn to_string(self: DecoderError) -> string {
        match self {
            InvalidUtf8(error) => error.to_string(),
            Finished => "UTF-8 decoder is finished; reset before feeding more bytes",
            OffsetOverflow => "UTF-8 decoder byte offset overflows isize",
        }
    }
}

impl Debug for DecoderError {
    fn debug(self: DecoderError) -> string {
        self.to_string()
    }
}

pub struct Decoder {
    pending: Vec[byte],
    offset: Ref[isize],
    failure: Ref[Option[Utf8Error]],
    finished: Ref[bool],
}

impl Decoder {
    pub fn new() -> Decoder {
        Decoder {
            pending: Vec::with_capacity(MAX_WIDTH),
            offset: Ref::new(0),
            failure: Ref::new(Option::None),
            finished: Ref::new(false),
        }
    }

    pub fn reset(self: Decoder) -> () {
        self.pending.clear();
        self.offset.set(0);
        self.failure.set(Option::None);
        self.finished.set(false)
    }

    pub fn consumed(self: Decoder) -> isize {
        self.offset.get()
    }

    pub fn feed(self: Decoder, value: byte) -> Result[Option[char], DecoderError] {
        if let Option::Some(error) = self.failure.get() {
            return Err(DecoderError::InvalidUtf8(error))
        }
        if self.finished.get() {
            return Err(DecoderError::Finished)
        }
        if self.offset.get() == 9223372036854775807 {
            return Err(DecoderError::OffsetOverflow)
        }
        self.pending.push(value);
        self.offset.set(self.offset.get() + 1);
        match prefix(self.pending.as_slice()) {
            Scalar(character, _) => {
                self.pending.clear();
                Ok(Option::Some(character))
            },
            Incomplete => Ok(Option::None),
            Invalid => {
                let error = Utf8Error::new(self.offset.get() - self.pending.len(), Option::Some(1));
                self.failure.set(Option::Some(error));
                Err(DecoderError::InvalidUtf8(error))
            },
        }
    }

    pub fn finish(self: Decoder) -> Result[(), DecoderError] {
        if let Option::Some(error) = self.failure.get() {
            return Err(DecoderError::InvalidUtf8(error))
        }
        if self.pending.len() > 0 {
            let error = Utf8Error::new(self.offset.get() - self.pending.len(), Option::None);
            self.failure.set(Option::Some(error));
            return Err(DecoderError::InvalidUtf8(error))
        }
        self.finished.set(true);
        Ok(())
    }
}
