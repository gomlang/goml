package utf8;

pub const MAX_WIDTH: isize = 4;

pub const REPLACEMENT: char = '�';

enum Prefix {
    Scalar(char, isize),
    Invalid,
    Incomplete,
}

pub fn valid_scalar(value: u32) -> bool {
    value <= 0x10ffff && (value < 0xd800 || value > 0xdfff)
}

pub fn rune_start(value: byte) -> bool {
    value & 0xc0 != 0x80
}

fn prefix(input: Slice[byte]) -> Prefix {
    if input.len() == 0 {
        return Prefix::Incomplete
    }
    let first = input[0];
    if first < 0x80 {
        return Prefix::Scalar(char_from_u32(first.to_u32()).unwrap_or(REPLACEMENT), 1)
    }
    let width = if first >= 0xc2 && first <= 0xdf {
        2
    } else if first >= 0xe0 && first <= 0xef {
        3
    } else if first >= 0xf0 && first <= 0xf4 {
        4
    } else {
        return Prefix::Invalid
    };
    let mut value = first.to_u32() & (0x7f >> width);
    for index in 1..width {
        if index >= input.len() {
            return Prefix::Incomplete
        }
        let next = input[index];
        if !continuation(next) {
            return Prefix::Invalid
        }
        if index == 1
            && ((first == 0xe0 && next < 0xa0) || (first == 0xed && next > 0x9f)
                || (first == 0xf0 && next < 0x90)
                || (first == 0xf4 && next > 0x8f)) {
            return Prefix::Invalid
        }
        value = (value << 6) | (next & 0x3f).to_u32();
    }
    Prefix::Scalar(char_from_u32(value).unwrap_or(REPLACEMENT), width)
}

pub fn full_rune(input: Slice[byte]) -> bool {
    match prefix(input) {
        Prefix::Incomplete => false,
        _ => true,
    }
}

pub fn decode_first(input: Slice[byte]) -> Result[(char, isize), Utf8Error] {
    match prefix(input) {
        Prefix::Scalar(value, width) => Result::Ok((value, width)),
        Prefix::Invalid => Result::Err(Utf8Error::new(0, Option::Some(1))),
        Prefix::Incomplete => Result::Err(Utf8Error::new(0, Option::None)),
    }
}

pub fn decode_rune(input: Slice[byte]) -> (char, isize) {
    match prefix(input) {
        Prefix::Scalar(value, width) => (value, width),
        _ => (
            REPLACEMENT,
            if input.len() == 0 {
                0
            } else {
                1
            },
        ),
    }
}

pub fn decode_last_rune(input: Slice[byte]) -> (char, isize) {
    if input.len() == 0 {
        return (REPLACEMENT, 0)
    }
    let mut start = input.len() - 1;
    let lower = if input.len() > MAX_WIDTH {
        input.len() - MAX_WIDTH
    } else {
        0
    };
    while start > lower && continuation(input[start]) {
        start -= 1;
    }
    match prefix(input.sub(start, input.len())) {
        Prefix::Scalar(value, width) => if width == input.len() - start {
            (value, width)
        } else {
            (REPLACEMENT, 1)
        },
        _ => (REPLACEMENT, 1),
    }
}

pub fn rune_count(input: Slice[byte]) -> isize {
    let mut offset = 0;
    let mut count = 0;
    while offset < input.len() {
        let (_, width) = decode_rune(input.sub(offset, input.len()));
        offset += width;
        count += 1;
    }
    count
}

pub fn decode_lossy(input: Slice[byte]) -> string {
    let output: Vec[byte] = Vec::new();
    let mut offset = 0;
    while offset < input.len() {
        let (value, width) = decode_rune(input.sub(offset, input.len()));
        output.extend(encode_char(value));
        offset += width;
    }
    let (_, result) = string_from_utf8(output);
    result
}
