package process;

use module::bytes;
use module::internal::host;
use module::io;
use module::task;
use module::time;

pub enum ExitReason {
    Exited(isize),
    Signaled,
    Unknown,
}

pub struct ExitStatus {
    pub code_value: isize,
}

impl ExitStatus {
    pub fn success(self: ExitStatus) -> bool {
        self.code_value == 0
    }

    pub fn code(self: ExitStatus) -> Option[isize] {
        if self.code_value < 0 {
            Option::None
        } else {
            Option::Some(self.code_value)
        }
    }

    pub fn reason(self: ExitStatus) -> ExitReason {
        if self.code_value >= 0 {
            ExitReason::Exited(self.code_value)
        } else if self.code_value == -1 {
            ExitReason::Signaled
        } else {
            ExitReason::Unknown
        }
    }
}

pub struct Output {
    pub status_value: ExitStatus,
    pub stdout_value: bytes::Bytes,
    pub stderr_value: bytes::Bytes,
}

impl Output {
    pub fn status(self: Output) -> ExitStatus {
        self.status_value
    }

    pub fn stdout(self: Output) -> bytes::Bytes {
        self.stdout_value
    }

    pub fn stderr(self: Output) -> bytes::Bytes {
        self.stderr_value
    }
}

pub struct Command {
    pub program: string,
    pub arguments: Vec[string],
    pub has_directory: bool,
    pub directory: string,
    pub environment: Vec[(string, string)],
    pub has_input: bool,
    pub input_value: Vec[u8],
}

impl Command {
    pub fn new(program: string) -> Command {
        Command {
            program,
            arguments: Vec::new(),
            has_directory: false,
            directory: "",
            environment: Vec::new(),
            has_input: false,
            input_value: Vec::new(),
        }
    }

    pub fn arg(self: Command, argument: string) -> Command {
        self.arguments.push(argument);
        self
    }

    pub fn args(self: Command, arguments: Vec[string]) -> Command {
        for argument in arguments {
            self.arguments.push(argument)
        }
        self
    }

    pub fn current_dir(self: Command, directory: string) -> Command {
        Command {
            program: self.program,
            arguments: self.arguments,
            has_directory: true,
            directory,
            environment: self.environment,
            has_input: self.has_input,
            input_value: self.input_value,
        }
    }

    pub fn env(self: Command, key: string, value: string) -> Command {
        self.environment.push((key, value));
        self
    }

    pub fn env_clear(self: Command) -> Command {
        self.environment.clear();
        self.environment.push(("", ""));
        self
    }

    pub fn envs(self: Command, values: Vec[(string, string)]) -> Command {
        for value in values {
            self.environment.push(value)
        }
        self
    }

    pub fn input(self: Command, value: bytes::Bytes) -> Command {
        Command {
            program: self.program,
            arguments: self.arguments,
            has_directory: self.has_directory,
            directory: self.directory,
            environment: self.environment,
            has_input: true,
            input_value: value.to_vec(),
        }
    }

    fn output_raw(self: Command) -> Result[Output, string] {
        let (ok, code, stdout, stderr, err) = host::process_output(
            self.program,
            self.arguments,
            self.has_directory,
            self.directory,
            self.environment,
            self.has_input,
            self.input_value,
        );
        if ok {
            Result::Ok(
                Output {
                    status_value: ExitStatus { code_value: code },
                    stdout_value: bytes::Bytes::from_vec(stdout),
                    stderr_value: bytes::Bytes::from_vec(stderr),
                },
            )
        } else {
            Result::Err(err)
        }
    }

    pub fn output_structured(self: Command) -> Result[Output, Error] {
        let program = self.program;
        self.output_raw().map_err(
            |message| Error::new(
                io::ErrorKind::Other,
                "execute",
                Option::Some(program),
                Option::None,
                message,
            ),
        )
    }

    pub fn output_timeout_structured(self: Command, timeout: time::Duration) -> Result[
        Output,
        Error,
    ] {
        let program = self.program;
        match self.output_timeout_raw(timeout.as_milliseconds().to_isize()) {
            Ok((output, timed_out)) => if timed_out {
                Result::Err(
                    Error::new(
                        io::ErrorKind::TimedOut,
                        "execute",
                        Option::Some(program),
                        Option::None,
                        "process timed out",
                    ),
                )
            } else {
                Result::Ok(output)
            },
            Err(message) => Result::Err(
                Error::new(
                    io::ErrorKind::Other,
                    "execute",
                    Option::Some(program),
                    Option::None,
                    message,
                ),
            ),
        }
    }

    fn output_timeout_raw(self: Command, timeout_ms: isize) -> Result[(Output, bool), string] {
        let (ok, code, stdout, stderr, err, timed_out) = host::process_output_timeout(
            self.program,
            self.arguments,
            self.has_directory,
            self.directory,
            self.environment,
            self.has_input,
            self.input_value,
            timeout_ms,
        );
        if ok {
            Result::Ok(
                (
                    Output {
                        status_value: ExitStatus { code_value: code },
                        stdout_value: bytes::Bytes::from_vec(stdout),
                        stderr_value: bytes::Bytes::from_vec(stderr),
                    },
                    timed_out,
                ),
            )
        } else {
            Result::Err(err)
        }
    }

    fn output_cancel_raw(self: Command, cancel: task::CancelToken) -> Result[
        task::WaitResult[Output],
        string,
    ] {
        let (ok, code, stdout, stderr, err, cancelled) = host::process_output_cancel(
            self.program,
            self.arguments,
            self.has_directory,
            self.directory,
            self.environment,
            self.has_input,
            self.input_value,
            cancel.runtime_id(),
        );
        if cancelled {
            Result::Ok(task::WaitResult::Cancelled)
        } else if ok {
            Result::Ok(
                task::WaitResult::Completed(
                    Output {
                        status_value: ExitStatus { code_value: code },
                        stdout_value: bytes::Bytes::from_vec(stdout),
                        stderr_value: bytes::Bytes::from_vec(stderr),
                    },
                ),
            )
        } else {
            Result::Err(err)
        }
    }

    pub fn output_cancel_structured(self: Command, cancel: task::CancelToken) -> Result[
        Output,
        Error,
    ] {
        let program = self.program;
        match self.output_cancel_raw(cancel) {
            Ok(task::WaitResult::Completed(output)) => Result::Ok(output),
            Ok(task::WaitResult::Cancelled) => Result::Err(
                Error::new(
                    io::ErrorKind::Interrupted,
                    "execute",
                    Option::Some(program),
                    Option::None,
                    "process cancelled",
                ),
            ),
            Err(message) => Result::Err(
                Error::new(
                    io::ErrorKind::Other,
                    "execute",
                    Option::Some(program),
                    Option::None,
                    message,
                ),
            ),
        }
    }

    fn status_raw(self: Command) -> Result[ExitStatus, string] {
        let (ok, code, err) = host::process_status(
            self.program,
            self.arguments,
            self.has_directory,
            self.directory,
            self.environment,
        );
        if ok {
            Result::Ok(ExitStatus { code_value: code })
        } else {
            Result::Err(err)
        }
    }

    pub fn status_structured(self: Command) -> Result[ExitStatus, Error] {
        let program = self.program;
        self.status_raw().map_err(
            |message| Error::new(
                io::ErrorKind::Other,
                "execute",
                Option::Some(program),
                Option::None,
                message,
            ),
        )
    }

    pub fn status_timeout_structured(self: Command, timeout: time::Duration) -> Result[
        ExitStatus,
        Error,
    ] {
        let program = self.program;
        match self.status_timeout_raw(timeout.as_milliseconds().to_isize()) {
            Ok((status, timed_out)) => if timed_out {
                Result::Err(
                    Error::new(
                        io::ErrorKind::TimedOut,
                        "execute",
                        Option::Some(program),
                        Option::None,
                        "process timed out",
                    ),
                )
            } else {
                Result::Ok(status)
            },
            Err(message) => Result::Err(
                Error::new(
                    io::ErrorKind::Other,
                    "execute",
                    Option::Some(program),
                    Option::None,
                    message,
                ),
            ),
        }
    }

    fn status_timeout_raw(self: Command, timeout_ms: isize) -> Result[(ExitStatus, bool), string] {
        let (ok, code, err, timed_out) = host::process_status_timeout(
            self.program,
            self.arguments,
            self.has_directory,
            self.directory,
            self.environment,
            timeout_ms,
        );
        if ok {
            Result::Ok((ExitStatus { code_value: code }, timed_out))
        } else {
            Result::Err(err)
        }
    }

    fn status_cancel_raw(self: Command, cancel: task::CancelToken) -> Result[
        task::WaitResult[ExitStatus],
        string,
    ] {
        let (ok, code, err, cancelled) = host::process_status_cancel(
            self.program,
            self.arguments,
            self.has_directory,
            self.directory,
            self.environment,
            cancel.runtime_id(),
        );
        if cancelled {
            Result::Ok(task::WaitResult::Cancelled)
        } else if ok {
            Result::Ok(task::WaitResult::Completed(ExitStatus { code_value: code }))
        } else {
            Result::Err(err)
        }
    }

    pub fn status_cancel_structured(self: Command, cancel: task::CancelToken) -> Result[
        ExitStatus,
        Error,
    ] {
        let program = self.program;
        match self.status_cancel_raw(cancel) {
            Ok(task::WaitResult::Completed(status)) => Result::Ok(status),
            Ok(task::WaitResult::Cancelled) => Result::Err(
                Error::new(
                    io::ErrorKind::Interrupted,
                    "execute",
                    Option::Some(program),
                    Option::None,
                    "process cancelled",
                ),
            ),
            Err(message) => Result::Err(
                Error::new(
                    io::ErrorKind::Other,
                    "execute",
                    Option::Some(program),
                    Option::None,
                    message,
                ),
            ),
        }
    }
}

pub fn exit(code: isize) -> () {
    host::exit(code)
}

fn look_path_raw(program: string) -> Result[string, string] {
    let (ok, result, err) = host::process_look_path(program);
    if ok {
        Result::Ok(result)
    } else {
        Result::Err(err)
    }
}

pub fn look_path_structured(program: string) -> Result[string, Error] {
    look_path_raw(program).map_err(
        |message| Error::new(
            io::ErrorKind::NotFound,
            "look path",
            Option::Some(program),
            Option::None,
            message,
        ),
    )
}
