package json;

use module::io;
use module::bytes;
use module::serde;
use module::text;

pub fn from_reader[T: serde::Deserialize, R: io::Read](reader: R, limits: DecodeLimits) -> Result[
    T,
    Error,
] {
    let decoder = Decoder::new(reader, limits)?;
    let Some(value) = decoder.decode()? else {
        return Result::Err(
            stream_fail(
                decoder.cursor.session,
                ErrorKind::UnexpectedEof,
                "expected JSON value",
                Option::None,
            ),
        )
    };
    decoder.finish()?;
    Result::Ok(value)
}

pub fn from_string_with_limits[T: serde::Deserialize](input: string, limits: DecodeLimits) -> Result[
    T,
    Error,
] {
    from_reader(io::StringReader::new(input), limits)
}

pub fn value_from_reader[R: io::Read](reader: R, limits: DecodeLimits) -> Result[Value, Error] {
    let decoder = Decoder::new(reader, limits)?;
    let Some(value) = decoder.next_value()? else {
        return Result::Err(
            stream_fail(
                decoder.cursor.session,
                ErrorKind::UnexpectedEof,
                "expected JSON value",
                Option::None,
            ),
        )
    };
    decoder.finish()?;
    Result::Ok(value)
}

pub fn parse_with_limits(input: string, limits: DecodeLimits) -> Result[Value, Error] {
    value_from_reader(io::StringReader::new(input), limits)
}

pub fn to_writer[T: serde::Serialize, W: io::Write](value: T, writer: W, limits: EncodeLimits) -> Result[
    usize,
    Error,
] {
    let encoder = Encoder::new(writer, limits)?;
    stream_encode_action(
        encoder,
        false,
        |serializer| serde::Serialize::serialize(value, serializer),
    )
}

pub fn encode_to_writer[W: io::Write](value: Value, writer: W, limits: EncodeLimits) -> Result[
    usize,
    Error,
] {
    let encoder = Encoder::new(writer, limits)?;
    stream_encode_action(encoder, false, |serializer| stream_write_value(value, serializer))
}

pub fn to_string_with_limits[T: serde::Serialize](value: T, limits: EncodeLimits) -> Result[
    string,
    Error,
] {
    let writer = io::Cursor::new(bytes::Bytes::new());
    let _ = to_writer(value, writer, limits)?;
    Result::Ok(text::StringBuilder { values: writer.bytes().to_vec() }.to_string())
}

pub fn encode_with_limits(value: Value, limits: EncodeLimits) -> Result[string, Error] {
    let writer = io::Cursor::new(bytes::Bytes::new());
    let _ = encode_to_writer(value, writer, limits)?;
    Result::Ok(text::StringBuilder { values: writer.bytes().to_vec() }.to_string())
}
