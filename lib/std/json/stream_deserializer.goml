package json;

use module::io;
use module::serde;
use serde::Deserializer;
use module::num;

impl[R: io::Read] serde::Deserializer for StreamDeserializer[R] {
    fn deserialize_extension(self: StreamDeserializer[R]) -> Result[(i8, Vec[byte]), string] {
        decode_event(self)?;
        Result::Err(decode_schema(self, "JSON does not support extension values").to_string())
    }

    fn error(self: StreamDeserializer[R], message: string) -> string {
        match stream_check(self.lease) {
            Err(error) => error.to_string(),
            Ok(()) => decode_schema(self, message).to_string(),
        }
    }

    fn deserialize_any(self: StreamDeserializer[R]) -> Result[serde::Value, string] {
        decode_event(self)?;
        if decode_key(self) {
            return decode_text(self).map(|text| serde::Value::String(text)).map_err(
                |error| error.to_string(),
            )
        }
        decode_claim(self).map_err(|error| error.to_string())?;
        let result = token_build_value(
            self.lease.session,
            self.lease,
            || decode_step(self, true),
            |items| serde::Value::Sequence(items),
            |fields| serde::Value::Struct(fields),
            |token| match token {
                Null => Result::Ok(serde::Value::Unit),
                Bool(value) => Result::Ok(serde::Value::Bool(value)),
                String(value) => Result::Ok(serde::Value::String(value)),
                Number(value) => Result::Ok(serde::Value::Number(value)),
                _ => Result::Err(decode_schema(self, "expected JSON scalar")),
            },
        ).map_err(|error| error.to_string())?;
        let Some(result) = result else {
            return Result::Err(decode_schema(self, "expected JSON value").to_string())
        };
        decode_completed(self);
        Result::Ok(result)
    }

    fn deserialize_unit(self: StreamDeserializer[R]) -> Result[(), string] {
        decode_event(self)?;
        match decode_scalar(self).map_err(|error| error.to_string())?.token {
            Null => Result::Ok(()),
            _ => Result::Err(decode_schema(self, "expected JSON null").to_string()),
        }
    }

    fn deserialize_bool(self: StreamDeserializer[R]) -> Result[bool, string] {
        decode_event(self)?;
        match decode_scalar(self).map_err(|error| error.to_string())?.token {
            Bool(value) => Result::Ok(value),
            _ => Result::Err(decode_schema(self, "expected JSON bool").to_string()),
        }
    }

    fn deserialize_int(self: StreamDeserializer[R]) -> Result[isize, string] {
        decode_event(self)?;
        decode_integer(self, 0).map(|value| value.to_isize())
    }

    fn deserialize_int8(self: StreamDeserializer[R]) -> Result[i8, string] {
        decode_event(self)?;
        decode_integer(self, 8).map(|value| value.to_i8())
    }

    fn deserialize_int16(self: StreamDeserializer[R]) -> Result[i16, string] {
        decode_event(self)?;
        decode_integer(self, 16).map(|value| value.to_i16())
    }

    fn deserialize_int32(self: StreamDeserializer[R]) -> Result[i32, string] {
        decode_event(self)?;
        decode_integer(self, 32).map(|value| value.to_i32())
    }

    fn deserialize_int64(self: StreamDeserializer[R]) -> Result[i64, string] {
        decode_event(self)?;
        decode_integer(self, 64)
    }

    fn deserialize_uint(self: StreamDeserializer[R]) -> Result[usize, string] {
        decode_event(self)?;
        decode_unsigned(self, 0).map(|value| value.to_usize())
    }

    fn deserialize_uint8(self: StreamDeserializer[R]) -> Result[u8, string] {
        decode_event(self)?;
        decode_unsigned(self, 8).map(|value| value.to_u8())
    }

    fn deserialize_uint16(self: StreamDeserializer[R]) -> Result[u16, string] {
        decode_event(self)?;
        decode_unsigned(self, 16).map(|value| value.to_u16())
    }

    fn deserialize_uint32(self: StreamDeserializer[R]) -> Result[u32, string] {
        decode_event(self)?;
        decode_unsigned(self, 32).map(|value| value.to_u32())
    }

    fn deserialize_uint64(self: StreamDeserializer[R]) -> Result[u64, string] {
        decode_event(self)?;
        decode_unsigned(self, 64)
    }

    fn deserialize_float32(self: StreamDeserializer[R]) -> Result[f32, string] {
        decode_event(self)?;
        let number = decode_number(self).map_err(|error| error.to_string())?;
        num::parse_float32_structured(number).map_err(
            |error| decode_schema(self, error.to_string()).to_string(),
        )
    }

    fn deserialize_float64(self: StreamDeserializer[R]) -> Result[f64, string] {
        decode_event(self)?;
        let number = decode_number(self).map_err(|error| error.to_string())?;
        num::parse_float64_structured(number).map_err(
            |error| decode_schema(self, error.to_string()).to_string(),
        )
    }

    fn deserialize_number(self: StreamDeserializer[R]) -> Result[string, string] {
        decode_event(self)?;
        decode_number(self).map_err(|error| error.to_string())
    }

    fn deserialize_string(self: StreamDeserializer[R]) -> Result[string, string] {
        decode_event(self)?;
        decode_text(self).map_err(|error| error.to_string())
    }

    fn deserialize_char(self: StreamDeserializer[R]) -> Result[char, string] {
        decode_event(self)?;
        let text = decode_text(self).map_err(|error| error.to_string())?;
        if let Some((character, end)) = text.decode_at(0) {
            if end == text.byte_len() {
                return Result::Ok(character)
            }
        }
        Result::Err(decode_schema(self, "expected one-character JSON string").to_string())
    }

    fn deserialize_bytes(self: StreamDeserializer[R]) -> Result[Vec[byte], string] {
        let _ = self.begin_sequence()?;
        let items = Vec::new();
        while self.next_sequence_element()? {
            items.push(self.deserialize_uint8()?);
        }
        self.end_sequence()?;
        Result::Ok(items)
    }

    fn begin_optional(self: StreamDeserializer[R]) -> Result[bool, string] {
        decode_event(self)?;
        decode_frame_limit(self).map_err(|error| error.to_string())?;
        decode_claim(self).map_err(|error| error.to_string())?;
        let present = decode_peek(self).map_err(|error| error.to_string())?.token != Token::Null;
        let frame = decode_new_frame(StreamDeserializeKind::Optional, 0, false);
        if present {
            frame.state.set(StreamDeserializeState::Ready);
        } else {
            let _ = decode_take(self).map_err(|error| error.to_string())?;
        }
        self.frames.push(frame);
        Result::Ok(present)
    }

    fn end_optional(self: StreamDeserializer[R]) -> Result[(), string] {
        decode_event(self)?;
        let frame = decode_frame(self, StreamDeserializeKind::Optional).map_err(
            |error| error.to_string(),
        )?;
        decode_idle(self, frame).map_err(|error| error.to_string())?;
        let _ = self.frames.pop();
        decode_completed(self);
        Result::Ok(())
    }

    fn begin_sequence(self: StreamDeserializer[R]) -> Result[Option[isize], string] {
        decode_event(self)?;
        decode_begin(self, StreamDeserializeKind::Sequence, 0, Token::StartArray).map_err(
            |error| error.to_string(),
        )?;
        Result::Ok(Option::None)
    }

    fn next_sequence_element(self: StreamDeserializer[R]) -> Result[bool, string] {
        decode_event(self)?;
        let frame = decode_frame(self, StreamDeserializeKind::Sequence).map_err(
            |error| error.to_string(),
        )?;
        decode_next_array(self, frame).map_err(|error| error.to_string())
    }

    fn end_sequence(self: StreamDeserializer[R]) -> Result[(), string] {
        decode_event(self)?;
        decode_end(self, StreamDeserializeKind::Sequence, Token::EndArray).map_err(
            |error| error.to_string(),
        )
    }

    fn begin_tuple(self: StreamDeserializer[R], length: isize) -> Result[(), string] {
        decode_event(self)?;
        decode_begin(self, StreamDeserializeKind::Tuple, length, Token::StartArray).map_err(
            |error| error.to_string(),
        )
    }

    fn begin_tuple_element(self: StreamDeserializer[R], index: isize) -> Result[(), string] {
        decode_event(self)?;
        let frame = decode_frame(self, StreamDeserializeKind::Tuple).map_err(
            |error| error.to_string(),
        )?;
        decode_idle(self, frame).map_err(|error| error.to_string())?;
        if index != frame.index.get() || index >= frame.length.get() {
            return Result::Err(decode_schema(self, "unexpected JSON tuple index").to_string())
        }
        if !decode_next_array(self, frame).map_err(|error| error.to_string())? {
            return Result::Err(decode_schema(self, "missing JSON tuple element").to_string())
        }
        Result::Ok(())
    }

    fn end_tuple(self: StreamDeserializer[R]) -> Result[(), string] {
        decode_event(self)?;
        decode_end(self, StreamDeserializeKind::Tuple, Token::EndArray).map_err(
            |error| error.to_string(),
        )
    }

    fn begin_map(self: StreamDeserializer[R]) -> Result[Option[isize], string] {
        decode_event(self)?;
        decode_begin(self, StreamDeserializeKind::Map, 0, Token::StartObject).map_err(
            |error| error.to_string(),
        )?;
        Result::Ok(Option::None)
    }

    fn next_map_entry(self: StreamDeserializer[R]) -> Result[bool, string] {
        decode_event(self)?;
        let frame = decode_frame(self, StreamDeserializeKind::Map).map_err(
            |error| error.to_string(),
        )?;
        decode_idle(self, frame).map_err(|error| error.to_string())?;
        if frame.done.get() {
            return Result::Ok(false)
        }
        match decode_peek(self).map_err(|error| error.to_string())?.token {
            EndObject => {
                frame.done.set(true);
                Result::Ok(false)
            },
            Key(_) => {
                frame.state.set(StreamDeserializeState::Entry);
                Result::Ok(true)
            },
            _ => Result::Err(decode_schema(self, "expected JSON object key or end").to_string()),
        }
    }

    fn begin_map_key(self: StreamDeserializer[R]) -> Result[(), string] {
        decode_event(self)?;
        let frame = decode_frame(self, StreamDeserializeKind::Map).map_err(
            |error| error.to_string(),
        )?;
        if frame.state.get() != StreamDeserializeState::Entry {
            return Result::Err(decode_schema(self, "JSON map key is not expected here").to_string())
        }
        frame.state.set(StreamDeserializeState::Key);
        Result::Ok(())
    }

    fn begin_map_value(self: StreamDeserializer[R]) -> Result[(), string] {
        decode_event(self)?;
        let frame = decode_frame(self, StreamDeserializeKind::Map).map_err(
            |error| error.to_string(),
        )?;
        if frame.state.get() != StreamDeserializeState::KeyDone {
            return Result::Err(
                decode_schema(self, "JSON map value requires a completed key").to_string(),
            )
        }
        frame.state.set(StreamDeserializeState::Ready);
        Result::Ok(())
    }

    fn end_map(self: StreamDeserializer[R]) -> Result[(), string] {
        decode_event(self)?;
        decode_end(self, StreamDeserializeKind::Map, Token::EndObject).map_err(
            |error| error.to_string(),
        )
    }

    fn begin_struct(self: StreamDeserializer[R], name: string, fields: isize) -> Result[(), string] {
        decode_event(self)?;
        decode_begin(self, StreamDeserializeKind::Struct, fields, Token::StartObject).map_err(
            |error| error.to_string(),
        )
    }

    fn next_struct_field(self: StreamDeserializer[R]) -> Result[Option[serde::FieldKey], string] {
        decode_event(self)?;
        let frame = decode_frame(self, StreamDeserializeKind::Struct).map_err(
            |error| error.to_string(),
        )?;
        decode_next_field(self, frame).map(|key| key.map(|name| serde::FieldKey::Name(name))).map_err(
            |error| error.to_string(),
        )
    }

    fn skip_value(self: StreamDeserializer[R]) -> Result[(), string] {
        decode_event(self)?;
        decode_claim(self).map_err(|error| error.to_string())?;
        decode_skip(self).map_err(|error| error.to_string())?;
        decode_completed(self);
        Result::Ok(())
    }

    fn end_struct(self: StreamDeserializer[R]) -> Result[(), string] {
        decode_event(self)?;
        decode_end(self, StreamDeserializeKind::Struct, Token::EndObject).map_err(
            |error| error.to_string(),
        )
    }

    fn begin_variant(self: StreamDeserializer[R], enum_name: string, variants: isize) -> Result[
        serde::VariantKey,
        string,
    ] {
        decode_event(self)?;
        decode_variant(self, variants).map(|name| serde::VariantKey::Name(name)).map_err(
            |error| error.to_string(),
        )
    }

    fn begin_variant_fields(self: StreamDeserializer[R], kind: isize, fields: isize) -> Result[
        (),
        string,
    ] {
        decode_event(self)?;
        decode_variant_fields(self, kind, fields).map_err(|error| error.to_string())
    }

    fn next_variant_field(self: StreamDeserializer[R]) -> Result[Option[serde::FieldKey], string] {
        decode_event(self)?;
        decode_variant_next(self).map_err(|error| error.to_string())
    }

    fn end_variant(self: StreamDeserializer[R]) -> Result[(), string] {
        decode_event(self)?;
        decode_variant_end(self).map_err(|error| error.to_string())
    }
}
