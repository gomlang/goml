package json;

use module::io;

#[derive(ToString, Debug, PartialEq, Eq)]
pub enum LimitKind {
    InputBytes,
    ValueBytes,
    OutputBytes,
    Depth,
    Values,
    StringBytes,
    NumberBytes,
    ContainerEntries,
    PathBytes,
    SerdeFrames,
    Events,
}

#[derive(ToString, Debug, PartialEq, Eq)]
pub enum ErrorKind {
    InvalidLimit,
    Limit(LimitKind),
    Syntax,
    UnexpectedEof,
    TrailingData,
    Utf8,
    Schema,
    State,
    Io,
}

#[derive(ToString, Debug, PartialEq, Eq)]
pub enum PathSegment {
    Field(string),
    Index(isize),
    Variant(string),
}

#[derive(ToString, Debug, PartialEq, Eq)]
pub enum Token {
    StartArray,
    EndArray,
    StartObject,
    EndObject,
    Key(string),
    String(string),
    Number(string),
    Bool(bool),
    Null,
}

pub struct DecodeLimits {
    pub max_input_bytes: isize,
    pub max_value_bytes: isize,
    pub max_depth: isize,
    pub max_values: isize,
    pub max_string_bytes: isize,
    pub max_number_bytes: isize,
    pub max_container_entries: isize,
    pub max_path_bytes: isize,
    pub max_serde_frames: isize,
    pub max_events: isize,
}

pub struct EncodeLimits {
    pub max_output_bytes: isize,
    pub max_depth: isize,
    pub max_values: isize,
    pub max_string_bytes: isize,
    pub max_number_bytes: isize,
    pub max_container_entries: isize,
    pub max_path_bytes: isize,
    pub max_serde_frames: isize,
    pub max_events: isize,
}

pub struct Error {
    kind_value: ErrorKind,
    offset_value: isize,
    path_value: Vec[PathSegment],
    message_value: string,
    cause_value: Option[io::Error],
    read_value: usize,
    written_value: usize,
}

impl Error {
    pub fn kind(self: Error) -> ErrorKind {
        self.kind_value
    }

    pub fn byte_offset(self: Error) -> isize {
        self.offset_value
    }

    pub fn path(self: Error) -> Slice[PathSegment] {
        self.path_value.as_slice()
    }

    pub fn message(self: Error) -> string {
        self.message_value
    }

    pub fn cause(self: Error) -> Option[io::Error] {
        self.cause_value
    }

    pub fn confirmed_read(self: Error) -> usize {
        self.read_value
    }

    pub fn confirmed_written(self: Error) -> usize {
        self.written_value
    }
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        f"JSON {self.kind_value} at byte {self.offset_value}: {self.message_value}"
    }
}

impl Debug for Error {
    fn debug(self: Error) -> string {
        self.to_string()
    }
}

struct TokenRecord {
    token: Token,
    start_offset: isize,
    path: Vec[PathSegment],
}

enum StreamDirection {
    Decode,
    Encode,
}

struct FailureDescriptor {
    kind: ErrorKind,
    offset: isize,
    path: Vec[PathSegment],
    message: string,
    cause: Option[io::Error],
}

struct StreamSession {
    first_error: Ref[Option[FailureDescriptor]],
    active: Ref[bool],
    generation: Ref[isize],
    events: Ref[isize],
    offset: Ref[isize],
    read: Ref[isize],
    written: Ref[isize],
    path: Vec[PathSegment],
    path_bytes: Ref[isize],
    direction: StreamDirection,
}

struct StreamLease {
    session: StreamSession,
    generation: isize,
    max_events: isize,
}
