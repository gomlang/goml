package json;

use module::io;

enum ValueBuildFrame[T] {
    Array(Vec[T]),
    Object {
        entries: Vec[(string, T)],
        key: Ref[Option[string]],
    },
}

fn value_build_append[T](session: StreamSession, frames: Vec[ValueBuildFrame[T]], value: T) -> Result[
    (),
    Error,
] {
    if frames.is_empty() {
        return Err(
            stream_fail(session, ErrorKind::State, "JSON value builder has no parent", Option::None),
        )
    }
    match frames[frames.len() - 1] {
        Array(entries) => {
            entries.push(value);
            Ok(())
        },
        Object { entries, key } => {
            let Some(name) = key.get() else {
                return Err(
                    stream_fail(session, ErrorKind::State, "JSON object value has no key", None),
                )
            };
            entries.push((name, value));
            key.set(Option::None);
            Ok(())
        },
    }
}

fn token_read_value[R: io::Read](cursor: StreamCursor[R], state: TokenState, lease: StreamLease) -> Result[
    Option[Value],
    Error,
] {
    token_build_value(
        cursor.session,
        lease,
        || token_step(cursor, state, lease, true),
        |values| Value::Array(values),
        |entries| Value::Object(entries),
        |token| match token {
            String(value) => Ok(Value::String(value)),
            Number(value) => Ok(Value::Number(value)),
            Bool(value) => Ok(Value::Bool(value)),
            Null => Ok(Value::Null),
            _ => Err(
                stream_fail(cursor.session, ErrorKind::State, "expected JSON scalar", Option::None),
            ),
        },
    )
}

fn token_build_value[T](
    session: StreamSession,
    lease: StreamLease,
    next: () -> Result[Option[StreamTokenRecord], Error],
    array: (Vec[T]) -> T,
    object: (Vec[(string, T)]) -> T,
    scalar: (Token) -> Result[T, Error],
) -> Result[Option[T], Error] {
    let frames: Vec[ValueBuildFrame[T]] = Vec::new();
    loop {
        stream_event(lease, lease.max_events)?;
        let Some(record) = next()? else {
            if frames.is_empty() {
                return Ok(Option::None)
            }
            return Err(
                stream_fail(
                    session,
                    State,
                    "JSON token stream ended inside value construction",
                    None,
                ),
            )
        };
        if record.skipped {
            return Err(
                stream_fail_at(
                    session,
                    State,
                    "JSON value builder received an omitted payload",
                    None,
                    record.record.start_offset,
                    record.record.path,
                ),
            )
        }
        let value = match record.record.token {
            StartArray => {
                frames.push(ValueBuildFrame::Array(Vec::new()));
                continue
            },
            StartObject => {
                frames.push(
                    ValueBuildFrame::Object { entries: Vec::new(), key: Ref::new(Option::None) },
                );
                continue
            },
            Key(name) => {
                if frames.is_empty() {
                    return Err(
                        stream_fail_at(
                            session,
                            State,
                            "JSON key outside value object",
                            None,
                            record.record.start_offset,
                            record.record.path,
                        ),
                    )
                }
                match frames[frames.len() - 1] {
                    Object { entries: _, key } => {
                        if key.get().is_some() {
                            return Err(
                                stream_fail_at(
                                    session,
                                    State,
                                    "JSON object key has no value",
                                    None,
                                    record.record.start_offset,
                                    record.record.path,
                                ),
                            )
                        }
                        key.set(Option::Some(name));
                    },
                    Array(_) => return Err(
                        stream_fail_at(
                            session,
                            State,
                            "JSON key inside value array",
                            None,
                            record.record.start_offset,
                            record.record.path,
                        ),
                    ),
                }
                continue
            },
            EndArray => {
                match frames.pop() {
                    Some(ValueBuildFrame::Array(entries)) => array(entries),
                    _ => return Err(
                        stream_fail_at(
                            session,
                            State,
                            "JSON array end does not match value construction",
                            None,
                            record.record.start_offset,
                            record.record.path,
                        ),
                    ),
                }
            },
            EndObject => {
                match frames.pop() {
                    Some(ValueBuildFrame::Object { entries, key }) => {
                        if key.get().is_some() {
                            return Err(
                                stream_fail_at(
                                    session,
                                    State,
                                    "JSON object ended without a field value",
                                    None,
                                    record.record.start_offset,
                                    record.record.path,
                                ),
                            )
                        }
                        object(entries)
                    },
                    _ => return Err(
                        stream_fail_at(
                            session,
                            State,
                            "JSON object end does not match value construction",
                            None,
                            record.record.start_offset,
                            record.record.path,
                        ),
                    ),
                }
            },
            token => scalar(token)?,
        };
        if frames.is_empty() {
            return Ok(Option::Some(value))
        }
        value_build_append(session, frames, value)?;
    }
}
