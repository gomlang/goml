package tests;

use std::json;
use std::testing;
use std::text;

fn json_token_fingerprint(input: string, step: isize) -> Result[string, json::Error] {
    let decoder = json_decode_new(
        json_decode_probe(input.to_bytes(), step, 0, 0),
        json_decode_limits(),
    );
    let output = text::StringBuilder::new();
    loop {
        let Some(token) = decoder.next_token()? else {
            break
        };
        output.write_string(
            match token {
                StartArray => "[",
                EndArray => "]",
                StartObject => "{",
                EndObject => "}",
                Key(value) | String(value) => "s" + value.byte_len().to_string() + ":" + value + ";",
                Number(value) => "n" + value + ";",
                Bool(value) => value.to_string() + ";",
                Null => "null;",
            },
        );
    }
    decoder.finish()?;
    Result::Ok(output.to_string())
}

fn json_known_answer(input: string, valid: bool, expected: string) -> () {
    for step in[1, 2, 7, 4096] {
        let value = json::parse_with_limits(input, json_decode_limits());
        if value.is_ok() != valid {
            testing::fail("JSON acceptance mismatch: " + input);
        }
        if valid {
            let actual = testing::expect_ok(
                json_token_fingerprint(input, step),
                "JSON token known answer",
            );
            testing::assert_eq(actual, expected);
            let value = testing::expect_ok(value, "valid JSON");
            let encoded = testing::expect_ok(
                json::encode_with_limits(value, json_encode_limits()),
                "JSON encode known answer",
            );
            let encoded_tokens = testing::expect_ok(
                json_token_fingerprint(encoded, step),
                "encoded JSON token sequence",
            );
            testing::assert_eq(encoded_tokens, expected);
        }
    }
}

#[test]
fn test_json_stream_differential() -> () {
    for (input, valid, expected) in[
        ("null", true, "null;"),
        ("true", true, "true;"),
        ("false", true, "false;"),
        ("-0", true, "n-0;"),
        ("1.2300e+99", true, "n1.2300e+99;"),
        ("1e-9999", true, "n1e-9999;"),
        ("18446744073709551616", true, "n18446744073709551616;"),
        ("[]", true, "[]"),
        ("{}", true, "{}"),
        ("{\"x\":1,\"x\":2}", true, "{s1:x;n1;s1:x;n2;}"),
        ("\"中😀\\n\\t\\u0000\"", true, "s10:中😀\n\t\u0000;"),
        ("\"\\ud83d\\ude00\"", true, "s4:😀;"),
        ("[{},[],true,null]", true, "[{}[]true;null;]"),
        ("", false, ""),
        (" ", false, ""),
        ("[", false, ""),
        ("{", false, ""),
        ("[1,]", false, ""),
        ("{\"a\":}", false, ""),
        ("01", false, ""),
        ("+1", false, ""),
        (".1", false, ""),
        ("1.", false, ""),
        ("1e", false, ""),
        ("NaN", false, ""),
        ("true false", false, ""),
        ("{}[]", false, ""),
        ("/*x*/1", false, ""),
        ("[true false]", false, ""),
        ("{\"x\" 1}", false, ""),
        ("[1,,2]", false, ""),
    ] {
        json_known_answer(input, valid, expected);
    }
    for number in 0..64 {
        let digits = number.to_string();
        let input = "{\"n\":" + digits + ",\"a\":[-" + digits + ".25e+2,\"é😀\\n\",false]}";
        let prefix = "{s1:n;n" + digits + ";s1:a;[n-" + digits + ".25e+2;";
        let expected = prefix + "s7:é😀\n;false;]}";
        json_known_answer(input, true, expected);
        for index in 0..input.byte_len() {
            let byte = input.byte_get(index);
            if byte < 128 {
                let changed = input.byte_slice(0, index) + "#"
                    + input.byte_slice(index + 1, input.byte_len());
                if index == 2 {
                    json_known_answer(
                        changed,
                        true,
                        "{s1:#;n" + digits + ";s1:a;[n-" + digits + ".25e+2;s7:é😀\n;false;]}",
                    );
                } else if byte == b'a' && input.byte_get(index - 1) == b'"' {
                    json_known_answer(
                        changed,
                        true,
                        "{s1:n;n" + digits + ";s1:#;[n-" + digits + ".25e+2;s7:é😀\n;false;]}",
                    );
                } else if byte == b'\\' {
                    json_known_answer(changed, true, prefix + "s8:é😀#n;false;]}");
                } else {
                    json_known_answer(changed, false, "");
                }
            }
        }
    }
    let builder = text::StringBuilder::new();
    for _ in 0..4095 {
        builder.write_string(" ");
    }
    builder.write_string("\"😀\"");
    let input = builder.to_string();
    testing::assert_eq(
        testing::expect_ok(json_token_fingerprint(input, 4096), "UTF-8 transport boundary"),
        "s4:😀;",
    );
}
