package json;

use module::num;
use module::serde;
use module::text;

enum JsonDeserializeFrame {
    Optional,
    Sequence {
        first: Ref[bool],
        done: Ref[bool],
        index: Ref[isize],
    },
    Tuple {
        length: isize,
        index: Ref[isize],
    },
    Map {
        first: Ref[bool],
        done: Ref[bool],
        state: Ref[isize],
        key: Ref[Option[string]],
    },
    Struct {
        name: string,
        first: Ref[bool],
        done: Ref[bool],
        field: Ref[Option[string]],
    },
    Variant {
        enum_name: string,
        variant_name: string,
        representation: isize,
        kind: Ref[isize],
        length: Ref[isize],
        index: Ref[isize],
        first: Ref[bool],
        done: Ref[bool],
        begun: Ref[bool],
    },
}

struct JsonDeserializer {
    parser: JsonParser,
    frames: Vec[JsonDeserializeFrame],
}

fn json_current_index(index: Ref[isize]) -> isize {
    if index.get() > 0 {
        index.get() - 1
    } else {
        0
    }
}

fn write_json_deserialize_frame_path(builder: text::StringBuilder, frame: JsonDeserializeFrame) -> () {
    match frame {
        JsonDeserializeFrame::Optional => builder.write_string(".Some"),
        JsonDeserializeFrame::Sequence { first: _, done: _, index } => {
            builder.write_char('[');
            builder.write_string(json_current_index(index).to_string());
            builder.write_char(']')
        },
        JsonDeserializeFrame::Tuple { length: _, index } => {
            builder.write_char('[');
            builder.write_string(json_current_index(index).to_string());
            builder.write_char(']')
        },
        JsonDeserializeFrame::Map { first: _, done: _, state: _, key } => match key.get() {
            Some(name) => {
                builder.write_string("[\"");
                builder.write_string(name);
                builder.write_string("\"]")
            },
            None => builder.write_string(".map"),
        },
        JsonDeserializeFrame::Struct { name, first: _, done: _, field } => {
            if name.byte_len() == 0 {} else {
                builder.write_char('.');
                builder.write_string(name)
            }
            if let Some(name) = field.get() {
                builder.write_char('.');
                builder.write_string(name)
            }
        },
        JsonDeserializeFrame::Variant {
            enum_name,
            variant_name,
            representation: _,
            kind,
            length: _,
            index,
            first: _,
            done: _,
            begun: _,
        } => {
            builder.write_char('.');
            builder.write_string(enum_name);
            builder.write_string("::");
            builder.write_string(variant_name);
            if kind.get() == 1 {
                builder.write_char('[');
                builder.write_string(json_current_index(index).to_string());
                builder.write_char(']')
            }
        },
    }
}

fn json_deserializer_path(deserializer: JsonDeserializer) -> string {
    let builder = text::StringBuilder::new();
    builder.write_char('$');
    for frame in deserializer.frames {
        write_json_deserialize_frame_path(builder, frame)
    }
    builder.finish()
}

fn json_deserializer_error(deserializer: JsonDeserializer, message: string) -> string {
    message + " at path " + json_deserializer_path(deserializer)
        + f" at byte {deserializer.parser.index.get()}"
}

fn contextualize_json_error(deserializer: JsonDeserializer, message: string) -> string {
    let with_path = if message.contains(" at path ") {
        message
    } else {
        message + " at path " + json_deserializer_path(deserializer)
    };
    if with_path.contains(" at byte ") {
        with_path
    } else {
        f"{with_path} at byte {deserializer.parser.index.get()}"
    }
}

fn expected_json_value(deserializer: JsonDeserializer, expected: string) -> string {
    json_deserializer_error(
        deserializer,
        "expected " + expected + ", found " + direct_json_actual(deserializer.parser),
    )
}

fn json_deserializer(input: string) -> JsonDeserializer {
    JsonDeserializer { parser: json_parser(input), frames: Vec::new() }
}

fn finish_json_deserializer(deserializer: JsonDeserializer) -> Result[(), string] {
    if !deserializer.frames.is_empty() {
        Result::Err("JSON deserialization ended inside a compound value")
    } else {
        skip_json_whitespace(deserializer.parser);
        if deserializer.parser.index.get() == deserializer.parser.input.byte_len() {
            Result::Ok(())
        } else {
            Result::Err(json_error(deserializer.parser, "trailing JSON data"))
        }
    }
}

fn consume_json_byte(parser: JsonParser, expected: byte, message: string) -> Result[(), string] {
    skip_json_whitespace(parser);
    if parser.index.get() >= parser.input.byte_len()
        || parser.input.byte_get(parser.index.get()) != expected {
        Result::Err(json_error(parser, message))
    } else {
        parser.index.set(parser.index.get() + 1);
        Result::Ok(())
    }
}

fn consume_json_literal(parser: JsonParser, expected: string) -> Result[(), string] {
    skip_json_whitespace(parser);
    if json_literal_matches(parser, expected) {
        parser.index.set(parser.index.get() + expected.byte_len());
        Result::Ok(())
    } else {
        Result::Err(json_error(parser, "invalid literal"))
    }
}

fn skip_direct_json_array(parser: JsonParser) -> Result[(), string] {
    consume_json_byte(parser, b'[', "expected array")?;
    skip_json_whitespace(parser);
    if parser.index.get() < parser.input.byte_len()
        && parser.input.byte_get(parser.index.get()) == b']' {
        parser.index.set(parser.index.get() + 1);
        return Result::Ok(())
    }
    while parser.index.get() < parser.input.byte_len() {
        skip_direct_json_value(parser)?;
        skip_json_whitespace(parser);
        if parser.index.get() >= parser.input.byte_len() {
            return Result::Err(json_error(parser, "unterminated array"))
        } else if parser.input.byte_get(parser.index.get()) == b']' {
            parser.index.set(parser.index.get() + 1);
            return Result::Ok(())
        } else if parser.input.byte_get(parser.index.get()) == b',' {
            parser.index.set(parser.index.get() + 1)
        } else {
            return Result::Err(json_error(parser, "expected array separator"))
        }
    }
    Result::Err(json_error(parser, "unterminated array"))
}

fn skip_direct_json_object(parser: JsonParser) -> Result[(), string] {
    consume_json_byte(parser, b'{', "expected object")?;
    skip_json_whitespace(parser);
    if parser.index.get() < parser.input.byte_len()
        && parser.input.byte_get(parser.index.get()) == b'}' {
        parser.index.set(parser.index.get() + 1);
        return Result::Ok(())
    }
    while parser.index.get() < parser.input.byte_len() {
        let _ = parse_json_string(parser)?;
        consume_json_byte(parser, b':', "expected object colon")?;
        skip_direct_json_value(parser)?;
        skip_json_whitespace(parser);
        if parser.index.get() >= parser.input.byte_len() {
            return Result::Err(json_error(parser, "unterminated object"))
        } else if parser.input.byte_get(parser.index.get()) == b'}' {
            parser.index.set(parser.index.get() + 1);
            return Result::Ok(())
        } else if parser.input.byte_get(parser.index.get()) == b',' {
            parser.index.set(parser.index.get() + 1)
        } else {
            return Result::Err(json_error(parser, "expected object separator"))
        }
    }
    Result::Err(json_error(parser, "unterminated object"))
}

fn skip_direct_json_value(parser: JsonParser) -> Result[(), string] {
    skip_json_whitespace(parser);
    if parser.index.get() >= parser.input.byte_len() {
        Result::Err(json_error(parser, "expected JSON value"))
    } else {
        let byte = parser.input.byte_get(parser.index.get());
        if byte == b'{' {
            skip_direct_json_object(parser)
        } else if byte == b'[' {
            skip_direct_json_array(parser)
        } else if byte == b'"' {
            let _ = parse_json_string(parser)?;
            Result::Ok(())
        } else if byte == b't' {
            consume_json_literal(parser, "true")
        } else if byte == b'f' {
            consume_json_literal(parser, "false")
        } else if byte == b'n' {
            consume_json_literal(parser, "null")
        } else if byte == b'-' || json_digit(byte) {
            let _ = parse_json_number_text(parser)?;
            Result::Ok(())
        } else {
            Result::Err(json_error(parser, "unexpected JSON token"))
        }
    }
}

fn direct_json_actual(parser: JsonParser) -> string {
    skip_json_whitespace(parser);
    if parser.index.get() >= parser.input.byte_len() {
        "end of input"
    } else {
        let byte = parser.input.byte_get(parser.index.get());
        if byte == b'{' {
            "object"
        } else if byte == b'[' {
            "array"
        } else if byte == b'"' {
            "string"
        } else if byte == b't' || byte == b'f' {
            "boolean"
        } else if byte == b'n' {
            "null"
        } else if byte == b'-' || json_digit(byte) {
            "number"
        } else {
            "token"
        }
    }
}

fn direct_json_number(deserializer: JsonDeserializer) -> Result[string, string] {
    let parser = deserializer.parser;
    skip_json_whitespace(parser);
    if parser.index.get() >= parser.input.byte_len() {
        Result::Err(json_deserializer_error(deserializer, "expected number, found end of input"))
    } else {
        let byte = parser.input.byte_get(parser.index.get());
        if byte == b'-' || json_digit(byte) {
            parse_json_number_text(parser)
        } else {
            Result::Err(
                json_deserializer_error(
                    deserializer,
                    "expected number, found " + direct_json_actual(parser),
                ),
            )
        }
    }
}

fn direct_json_int(deserializer: JsonDeserializer, width: isize) -> Result[i64, string] {
    let text = direct_json_number(deserializer)?;
    let value = num::parse_int_structured(text).map_err(
        |error| json_deserializer_error(deserializer, error.to_string()),
    )?.to_i64();
    if width == 8 && (value < -128 || value > 127) {
        Result::Err(json_deserializer_error(deserializer, "i8 is out of range"))
    } else if width == 16 && (value < -32768 || value > 32767) {
        Result::Err(json_deserializer_error(deserializer, "i16 is out of range"))
    } else if width == 32 && (value < -2147483648 || value > 2147483647) {
        Result::Err(json_deserializer_error(deserializer, "i32 is out of range"))
    } else {
        Result::Ok(value)
    }
}

fn direct_json_uint(deserializer: JsonDeserializer, width: isize) -> Result[u64, string] {
    let text = direct_json_number(deserializer)?;
    let value = num::parse_uint_structured(text).map_err(
        |error| json_deserializer_error(deserializer, error.to_string()),
    )?.to_u64();
    if width == 8 && value > 255 {
        Result::Err(json_deserializer_error(deserializer, "u8 is out of range"))
    } else if width == 16 && value > 65535 {
        Result::Err(json_deserializer_error(deserializer, "u16 is out of range"))
    } else if width == 32 && value > 4294967295 {
        Result::Err(json_deserializer_error(deserializer, "u32 is out of range"))
    } else {
        Result::Ok(value)
    }
}

fn json_frame_index(deserializer: JsonDeserializer) -> Result[isize, string] {
    if deserializer.frames.is_empty() {
        Result::Err(json_error(deserializer.parser, "no active compound value"))
    } else {
        Result::Ok(deserializer.frames.len() - 1)
    }
}

fn pop_json_frame(deserializer: JsonDeserializer) -> () {
    let _ = deserializer.frames.pop();
}

fn next_json_array_value(deserializer: JsonDeserializer, first: bool, done: bool) -> Result[
    (bool, bool, bool),
    string,
] {
    if done {
        return Result::Ok((first, done, false))
    }
    skip_json_whitespace(deserializer.parser);
    if deserializer.parser.index.get() >= deserializer.parser.input.byte_len() {
        Result::Err(json_error(deserializer.parser, "unterminated array"))
    } else if first {
        if deserializer.parser.input.byte_get(deserializer.parser.index.get()) == b']' {
            Result::Ok((false, true, false))
        } else {
            Result::Ok((false, false, true))
        }
    } else if deserializer.parser.input.byte_get(deserializer.parser.index.get()) == b']' {
        Result::Ok((false, true, false))
    } else if deserializer.parser.input.byte_get(deserializer.parser.index.get()) == b',' {
        deserializer.parser.index.set(deserializer.parser.index.get() + 1);
        skip_json_whitespace(deserializer.parser);
        Result::Ok((false, false, true))
    } else {
        Result::Err(json_error(deserializer.parser, "expected array separator"))
    }
}

fn next_json_object_field(deserializer: JsonDeserializer, first: bool, done: bool) -> Result[
    (bool, bool, Option[string]),
    string,
] {
    if done {
        return Result::Ok((first, done, Option::None))
    }
    skip_json_whitespace(deserializer.parser);
    if deserializer.parser.index.get() >= deserializer.parser.input.byte_len() {
        Result::Err(json_error(deserializer.parser, "unterminated object"))
    } else if first && deserializer.parser.input.byte_get(deserializer.parser.index.get()) == b'}' {
        Result::Ok((false, true, Option::None))
    } else {
        if !first {
            if deserializer.parser.input.byte_get(deserializer.parser.index.get()) == b'}' {
                return Result::Ok((false, true, Option::None))
            } else if deserializer.parser.input.byte_get(deserializer.parser.index.get()) == b',' {
                deserializer.parser.index.set(deserializer.parser.index.get() + 1);
                skip_json_whitespace(deserializer.parser)
            } else {
                return Result::Err(json_error(deserializer.parser, "expected object separator"))
            }
        }
        let name = parse_json_string(deserializer.parser)?;
        consume_json_byte(deserializer.parser, b':', "expected object colon")?;
        Result::Ok((false, false, Option::Some(name)))
    }
}

fn next_json_map_entry(deserializer: JsonDeserializer, first: bool, done: bool) -> Result[
    (bool, bool, bool),
    string,
] {
    if done {
        return Result::Ok((first, done, false))
    }
    skip_json_whitespace(deserializer.parser);
    if deserializer.parser.index.get() >= deserializer.parser.input.byte_len() {
        Result::Err(json_error(deserializer.parser, "unterminated map"))
    } else if first {
        if deserializer.parser.input.byte_get(deserializer.parser.index.get()) == b'}' {
            Result::Ok((false, true, false))
        } else {
            Result::Ok((false, false, true))
        }
    } else if deserializer.parser.input.byte_get(deserializer.parser.index.get()) == b'}' {
        Result::Ok((false, true, false))
    } else if deserializer.parser.input.byte_get(deserializer.parser.index.get()) == b',' {
        deserializer.parser.index.set(deserializer.parser.index.get() + 1);
        skip_json_whitespace(deserializer.parser);
        Result::Ok((false, false, true))
    } else {
        Result::Err(json_error(deserializer.parser, "expected map entry separator"))
    }
}

fn take_json_map_key(deserializer: JsonDeserializer) -> Result[Option[string], string] {
    if deserializer.frames.is_empty() {
        Result::Ok(Option::None)
    } else {
        let frame = deserializer.frames.len() - 1;
        match deserializer.frames[frame] {
            JsonDeserializeFrame::Map { first: _, done: _, state, key } => if state.get() == 2 {
                match key.get() {
                    Some(value) => {
                        state.set(3);
                        Result::Ok(Option::Some(value))
                    },
                    None => Result::Err(json_error(deserializer.parser, "map key is missing")),
                }
            } else {
                Result::Ok(Option::None)
            },
            _ => Result::Ok(Option::None),
        }
    }
}

impl serde::Deserializer for JsonDeserializer {
    fn error(self: JsonDeserializer, message: string) -> string {
        json_deserializer_error(self, message)
    }

    fn deserialize_any(self: JsonDeserializer) -> Result[serde::Value, string] {
        Result::Ok(into_serde_value(parse_json_value(self.parser)?))
    }

    fn deserialize_unit(self: JsonDeserializer) -> Result[(), string] {
        skip_json_whitespace(self.parser);
        if self.parser.index.get() < self.parser.input.byte_len()
            && self.parser.input.byte_get(self.parser.index.get()) == b'n' {
            consume_json_literal(self.parser, "null")
        } else {
            Result::Err(expected_json_value(self, "null"))
        }
    }

    fn deserialize_bool(self: JsonDeserializer) -> Result[bool, string] {
        skip_json_whitespace(self.parser);
        if self.parser.index.get() < self.parser.input.byte_len()
            && self.parser.input.byte_get(self.parser.index.get()) == b't' {
            consume_json_literal(self.parser, "true")?;
            Result::Ok(true)
        } else if self.parser.index.get() < self.parser.input.byte_len()
            && self.parser.input.byte_get(self.parser.index.get()) == b'f' {
            consume_json_literal(self.parser, "false")?;
            Result::Ok(false)
        } else {
            Result::Err(expected_json_value(self, "boolean"))
        }
    }

    fn deserialize_int(self: JsonDeserializer) -> Result[isize, string] {
        Result::Ok(direct_json_int(self, 0)?.to_isize())
    }

    fn deserialize_int8(self: JsonDeserializer) -> Result[i8, string] {
        Result::Ok(direct_json_int(self, 8)?.to_i8())
    }

    fn deserialize_int16(self: JsonDeserializer) -> Result[i16, string] {
        Result::Ok(direct_json_int(self, 16)?.to_i16())
    }

    fn deserialize_int32(self: JsonDeserializer) -> Result[i32, string] {
        Result::Ok(direct_json_int(self, 32)?.to_i32())
    }

    fn deserialize_int64(self: JsonDeserializer) -> Result[i64, string] {
        direct_json_int(self, 64)
    }

    fn deserialize_uint(self: JsonDeserializer) -> Result[usize, string] {
        Result::Ok(direct_json_uint(self, 0)?.to_usize())
    }

    fn deserialize_uint8(self: JsonDeserializer) -> Result[u8, string] {
        Result::Ok(direct_json_uint(self, 8)?.to_u8())
    }

    fn deserialize_uint16(self: JsonDeserializer) -> Result[u16, string] {
        Result::Ok(direct_json_uint(self, 16)?.to_u16())
    }

    fn deserialize_uint32(self: JsonDeserializer) -> Result[u32, string] {
        Result::Ok(direct_json_uint(self, 32)?.to_u32())
    }

    fn deserialize_uint64(self: JsonDeserializer) -> Result[u64, string] {
        direct_json_uint(self, 64)
    }

    fn deserialize_float32(self: JsonDeserializer) -> Result[f32, string] {
        let text = direct_json_number(self)?;
        num::parse_float32_structured(text).map_err(
            |error| json_deserializer_error(self, error.to_string()),
        )
    }

    fn deserialize_float64(self: JsonDeserializer) -> Result[f64, string] {
        let text = direct_json_number(self)?;
        num::parse_float64_structured(text).map_err(
            |error| json_deserializer_error(self, error.to_string()),
        )
    }

    fn deserialize_number(self: JsonDeserializer) -> Result[string, string] {
        direct_json_number(self)
    }

    fn deserialize_string(self: JsonDeserializer) -> Result[string, string] {
        match take_json_map_key(self)? {
            Some(value) => Result::Ok(value),
            None => {
                skip_json_whitespace(self.parser);
                if self.parser.index.get() < self.parser.input.byte_len()
                    && self.parser.input.byte_get(self.parser.index.get()) == b'"' {
                    parse_json_string(self.parser)
                } else {
                    Result::Err(expected_json_value(self, "string"))
                }
            },
        }
    }

    fn deserialize_char(self: JsonDeserializer) -> Result[char, string] {
        let value = match take_json_map_key(self)? {
            Some(value) => value,
            None => {
                skip_json_whitespace(self.parser);
                if self.parser.index.get() < self.parser.input.byte_len()
                    && self.parser.input.byte_get(self.parser.index.get()) == b'"' {
                    parse_json_string(self.parser)?
                } else {
                    return Result::Err(expected_json_value(self, "string"))
                }
            },
        };
        match value.decode_at(0) {
            Some((character, next)) => if next == value.byte_len() {
                Result::Ok(character)
            } else {
                Result::Err("expected one-character string")
            },
            None => Result::Err("expected one-character string"),
        }
    }

    fn deserialize_bytes(self: JsonDeserializer) -> Result[Vec[byte], string] {
        consume_json_byte(self.parser, b'[', "expected byte array")?;
        let values: Vec[byte] = Vec::new();
        let mut first = true;
        while true {
            skip_json_whitespace(self.parser);
            if self.parser.index.get() < self.parser.input.byte_len()
                && self.parser.input.byte_get(self.parser.index.get()) == b']' {
                self.parser.index.set(self.parser.index.get() + 1);
                return Result::Ok(values)
            } else if first {
                first = false;
            } else {
                consume_json_byte(self.parser, b',', "expected byte array separator")?;
            }
            values.push(direct_json_uint(self, 8)?.to_u8())
        }
        Result::Err("unreachable byte array state")
    }

    fn begin_optional(self: JsonDeserializer) -> Result[bool, string] {
        skip_json_whitespace(self.parser);
        let present = if self.parser.index.get() < self.parser.input.byte_len()
            && self.parser.input.byte_get(self.parser.index.get()) == b'n' {
            consume_json_literal(self.parser, "null")?;
            false
        } else {
            true
        };
        self.frames.push(JsonDeserializeFrame::Optional);
        Result::Ok(present)
    }

    fn end_optional(self: JsonDeserializer) -> Result[(), string] {
        let frame = json_frame_index(self)?;
        match self.frames[frame] {
            JsonDeserializeFrame::Optional => {
                pop_json_frame(self);
                Result::Ok(())
            },
            _ => Result::Err(json_error(self.parser, "end_optional does not match active value")),
        }
    }

    fn begin_sequence(self: JsonDeserializer) -> Result[Option[isize], string] {
        consume_json_byte(self.parser, b'[', "expected array")?;
        self.frames.push(
            JsonDeserializeFrame::Sequence {
                first: Ref::new(true),
                done: Ref::new(false),
                index: Ref::new(0),
            },
        );
        Result::Ok(Option::None)
    }

    fn next_sequence_element(self: JsonDeserializer) -> Result[bool, string] {
        let frame = json_frame_index(self)?;
        match self.frames[frame] {
            JsonDeserializeFrame::Sequence { first, done, index } => {
                let next = next_json_array_value(self, first.get(), done.get())?;
                if next.2 {
                    index.set(index.get() + 1)
                }
                first.set(next.0);
                done.set(next.1);
                Result::Ok(next.2)
            },
            _ => Result::Err(json_error(self.parser, "sequence element outside an array")),
        }
    }

    fn end_sequence(self: JsonDeserializer) -> Result[(), string] {
        let frame = json_frame_index(self)?;
        match self.frames[frame] {
            JsonDeserializeFrame::Sequence { first: _, done, index: _ } => if !done.get() {
                Result::Err(json_error(self.parser, "array ended before all elements"))
            } else {
                consume_json_byte(self.parser, b']', "expected array end")?;
                pop_json_frame(self);
                Result::Ok(())
            },
            _ => Result::Err(json_error(self.parser, "end_sequence does not match active value")),
        }
    }

    fn begin_tuple(self: JsonDeserializer, length: isize) -> Result[(), string] {
        if length < 0 {
            return Result::Err(json_error(self.parser, "tuple length cannot be negative"))
        }
        consume_json_byte(self.parser, b'[', "expected tuple array")?;
        self.frames.push(JsonDeserializeFrame::Tuple { length, index: Ref::new(0) });
        Result::Ok(())
    }

    fn begin_tuple_element(self: JsonDeserializer, index: isize) -> Result[(), string] {
        let frame = json_frame_index(self)?;
        match self.frames[frame] {
            JsonDeserializeFrame::Tuple { length, index: next } => if index != next.get()
                || index >= length {
                Result::Err(json_error(self.parser, "tuple element index is out of order"))
            } else {
                if index > 0 {
                    consume_json_byte(self.parser, b',', "expected tuple separator")?
                } else {
                    skip_json_whitespace(self.parser)
                }
                if self.parser.index.get() >= self.parser.input.byte_len()
                    || self.parser.input.byte_get(self.parser.index.get()) == b']' {
                    Result::Err(json_error(self.parser, "tuple has too few elements"))
                } else {
                    next.set(index + 1);
                    Result::Ok(())
                }
            },
            _ => Result::Err(json_error(self.parser, "tuple element outside a tuple")),
        }
    }

    fn end_tuple(self: JsonDeserializer) -> Result[(), string] {
        let frame = json_frame_index(self)?;
        match self.frames[frame] {
            JsonDeserializeFrame::Tuple { length, index } => if index.get() != length {
                Result::Err(json_error(self.parser, "tuple ended before all elements"))
            } else {
                consume_json_byte(self.parser, b']', "tuple has too many elements")?;
                pop_json_frame(self);
                Result::Ok(())
            },
            _ => Result::Err(json_error(self.parser, "end_tuple does not match active value")),
        }
    }

    fn begin_map(self: JsonDeserializer) -> Result[Option[isize], string] {
        consume_json_byte(self.parser, b'{', "expected map object")?;
        self.frames.push(
            JsonDeserializeFrame::Map {
                first: Ref::new(true),
                done: Ref::new(false),
                state: Ref::new(0),
                key: Ref::new(Option::None),
            },
        );
        Result::Ok(Option::None)
    }

    fn next_map_entry(self: JsonDeserializer) -> Result[bool, string] {
        let frame = json_frame_index(self)?;
        match self.frames[frame] {
            JsonDeserializeFrame::Map { first, done, state, key } => if state.get() != 0
                && state.get() != 4 {
                Result::Err(json_error(self.parser, "previous map entry is incomplete"))
            } else {
                let next = next_json_map_entry(self, first.get(), done.get())?;
                first.set(next.0);
                done.set(next.1);
                if next.2 {
                    key.set(Option::None)
                }
                state.set(
                    if next.2 {
                        1
                    } else {
                        0
                    },
                );
                Result::Ok(next.2)
            },
            _ => Result::Err(json_error(self.parser, "map entry outside a map")),
        }
    }

    fn begin_map_key(self: JsonDeserializer) -> Result[(), string] {
        let frame = json_frame_index(self)?;
        match self.frames[frame] {
            JsonDeserializeFrame::Map { first: _, done: _, state, key } => if state.get() != 1 {
                Result::Err(json_error(self.parser, "map is not expecting a key"))
            } else {
                let value = parse_json_string(self.parser)?;
                state.set(2);
                key.set(Option::Some(value));
                Result::Ok(())
            },
            _ => Result::Err(json_error(self.parser, "map key outside a map")),
        }
    }

    fn begin_map_value(self: JsonDeserializer) -> Result[(), string] {
        let frame = json_frame_index(self)?;
        match self.frames[frame] {
            JsonDeserializeFrame::Map { first: _, done: _, state, key: _ } => if state.get() != 3 {
                Result::Err(json_error(self.parser, "map is not expecting a value"))
            } else {
                consume_json_byte(self.parser, b':', "expected map entry colon")?;
                state.set(4);
                Result::Ok(())
            },
            _ => Result::Err(json_error(self.parser, "map value outside a map")),
        }
    }

    fn end_map(self: JsonDeserializer) -> Result[(), string] {
        let frame = json_frame_index(self)?;
        match self.frames[frame] {
            JsonDeserializeFrame::Map { first: _, done, state, key: _ } => if !done.get()
                || state.get() != 0 {
                Result::Err(json_error(self.parser, "map ended before all entries"))
            } else {
                consume_json_byte(self.parser, b'}', "expected map end")?;
                pop_json_frame(self);
                Result::Ok(())
            },
            _ => Result::Err(json_error(self.parser, "end_map does not match active value")),
        }
    }

    fn begin_struct(self: JsonDeserializer, name: string, fields: isize) -> Result[(), string] {
        if fields < 0 {
            return Result::Err(json_error(self.parser, "struct field count cannot be negative"))
        }
        consume_json_byte(self.parser, b'{', "expected object")?;
        self.frames.push(
            JsonDeserializeFrame::Struct {
                name,
                first: Ref::new(true),
                done: Ref::new(false),
                field: Ref::new(Option::None),
            },
        );
        Result::Ok(())
    }

    fn next_struct_field(self: JsonDeserializer) -> Result[Option[serde::FieldKey], string] {
        let frame = json_frame_index(self)?;
        match self.frames[frame] {
            JsonDeserializeFrame::Struct { name: _, first, done, field } => {
                let next = next_json_object_field(self, first.get(), done.get())?;
                first.set(next.0);
                done.set(next.1);
                match next.2 {
                    Some(name) => {
                        field.set(Option::Some(name));
                        Result::Ok(Option::Some(serde::FieldKey::Name(name)))
                    },
                    None => {
                        field.set(Option::None);
                        Result::Ok(Option::None)
                    },
                }
            },
            _ => Result::Err(json_error(self.parser, "struct field outside an object")),
        }
    }

    fn skip_value(self: JsonDeserializer) -> Result[(), string] {
        skip_direct_json_value(self.parser)
    }

    fn end_struct(self: JsonDeserializer) -> Result[(), string] {
        let frame = json_frame_index(self)?;
        match self.frames[frame] {
            JsonDeserializeFrame::Struct { name: _, first: _, done, field: _ } => if !done.get() {
                Result::Err(json_error(self.parser, "object ended before all fields"))
            } else {
                consume_json_byte(self.parser, b'}', "expected object end")?;
                pop_json_frame(self);
                Result::Ok(())
            },
            _ => Result::Err(json_error(self.parser, "end_struct does not match active value")),
        }
    }

    fn begin_variant(self: JsonDeserializer, enum_name: string, variants: isize) -> Result[
        serde::VariantKey,
        string,
    ] {
        if variants < 0 {
            return Result::Err(json_error(self.parser, "enum variant count cannot be negative"))
        }
        skip_json_whitespace(self.parser);
        if self.parser.index.get() >= self.parser.input.byte_len() {
            Result::Err(json_error(self.parser, "expected enum variant"))
        } else if self.parser.input.byte_get(self.parser.index.get()) == b'"' {
            let name = parse_json_string(self.parser)?;
            self.frames.push(
                JsonDeserializeFrame::Variant {
                    enum_name,
                    variant_name: name,
                    representation: 0,
                    kind: Ref::new(0),
                    length: Ref::new(0),
                    index: Ref::new(0),
                    first: Ref::new(true),
                    done: Ref::new(false),
                    begun: Ref::new(false),
                },
            );
            Result::Ok(serde::VariantKey::Name(name))
        } else {
            consume_json_byte(self.parser, b'{', "expected externally tagged enum object")?;
            let name = parse_json_string(self.parser)?;
            consume_json_byte(self.parser, b':', "expected enum payload colon")?;
            self.frames.push(
                JsonDeserializeFrame::Variant {
                    enum_name,
                    variant_name: name,
                    representation: 1,
                    kind: Ref::new(-1),
                    length: Ref::new(0),
                    index: Ref::new(0),
                    first: Ref::new(true),
                    done: Ref::new(false),
                    begun: Ref::new(false),
                },
            );
            Result::Ok(serde::VariantKey::Name(name))
        }
    }

    fn begin_variant_fields(self: JsonDeserializer, kind: isize, fields: isize) -> Result[
        (),
        string,
    ] {
        if kind < 0 || kind > 2 || fields < 0 || kind == 0 && fields != 0 {
            return Result::Err(json_error(self.parser, "invalid enum variant payload shape"))
        }
        let frame = json_frame_index(self)?;
        match self.frames[frame] {
            JsonDeserializeFrame::Variant {
                enum_name: _,
                variant_name: _,
                representation,
                kind: actual_kind,
                length,
                index,
                first,
                done,
                begun,
            } => if begun.get() {
                Result::Err(json_error(self.parser, "variant fields were already begun"))
            } else if representation == 0 {
                if kind != 0 || fields != 0 {
                    Result::Err(json_error(self.parser, "unit variant has an unexpected payload"))
                } else {
                    let _ = representation;
                    actual_kind.set(kind);
                    length.set(fields);
                    index.set(0);
                    first.set(true);
                    done.set(true);
                    begun.set(true);
                    Result::Ok(())
                }
            } else if kind == 1 || kind == 2 {
                consume_json_byte(
                    self.parser,
                    if kind == 1 {
                        b'['
                    } else {
                        b'{'
                    },
                    "unexpected enum payload shape",
                )?;
                let _ = representation;
                actual_kind.set(kind);
                length.set(fields);
                index.set(0);
                first.set(true);
                done.set(false);
                begun.set(true);
                Result::Ok(())
            } else {
                Result::Err(json_error(self.parser, "unexpected enum payload shape"))
            },
            _ => Result::Err(json_error(self.parser, "variant fields outside a variant")),
        }
    }

    fn next_variant_field(self: JsonDeserializer) -> Result[Option[serde::FieldKey], string] {
        let frame = json_frame_index(self)?;
        match self.frames[frame] {
            JsonDeserializeFrame::Variant {
                enum_name: _,
                variant_name: _,
                representation,
                kind,
                length,
                index,
                first,
                done,
                begun,
            } => if !begun.get() {
                Result::Err(json_error(self.parser, "variant fields were not begun"))
            } else if kind.get() == 0 {
                Result::Ok(Option::None)
            } else if kind.get() == 1 {
                let _ = representation;
                let _ = length;
                let next = next_json_array_value(self, first.get(), done.get())?;
                let position = index.get();
                if next.2 {
                    index.set(position + 1)
                }
                first.set(next.0);
                done.set(next.1);
                if next.2 {
                    Result::Ok(Option::Some(serde::FieldKey::Position(position)))
                } else {
                    Result::Ok(Option::None)
                }
            } else {
                let _ = representation;
                let _ = length;
                let next = next_json_object_field(self, first.get(), done.get())?;
                let field = next.2.map(|name| serde::FieldKey::Name(name));
                if field.is_some() {
                    index.set(index.get() + 1)
                }
                first.set(next.0);
                done.set(next.1);
                Result::Ok(field)
            },
            _ => Result::Err(json_error(self.parser, "variant field outside a variant")),
        }
    }

    fn end_variant(self: JsonDeserializer) -> Result[(), string] {
        let frame = json_frame_index(self)?;
        match self.frames[frame] {
            JsonDeserializeFrame::Variant {
                enum_name: _,
                variant_name: _,
                representation,
                kind,
                length: _,
                index: _,
                first: _,
                done,
                begun,
            } => if !begun.get() || !done.get() {
                Result::Err(json_error(self.parser, "variant ended before all fields"))
            } else {
                if kind.get() == 1 {
                    consume_json_byte(self.parser, b']', "expected tuple variant end")?
                } else if kind.get() == 2 {
                    consume_json_byte(self.parser, b'}', "expected struct variant end")?
                }
                if representation == 1 {
                    consume_json_byte(self.parser, b'}', "expected enum object end")?
                }
                pop_json_frame(self);
                Result::Ok(())
            },
            _ => Result::Err(json_error(self.parser, "end_variant does not match active value")),
        }
    }
}
