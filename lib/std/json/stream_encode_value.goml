package json;

use module::io;
use module::serde;
use serde::Serializer;

enum ValueEncodeFrame {
    Array {
        values: Vec[Value],
        length: isize,
        index: Ref[isize],
    },
    Object {
        entries: Vec[(string, Value)],
        length: isize,
        index: Ref[isize],
    },
}

fn stream_write_value[W: io::Write](value: Value, serializer: StreamSerializer[W]) -> Result[
    (),
    string,
] {
    let frames: Vec[ValueEncodeFrame] = Vec::new();
    let mut pending = Option::Some(value);
    loop {
        stream_event(serializer.lease, serializer.sink.limits.max_events).map_err(
            |error| error.to_string(),
        )?;
        if let Some(value) = pending {
            pending = Option::None;
            match value {
                Array(values) => {
                    let length = values.len();
                    serializer.begin_sequence(length)?;
                    frames.push(ValueEncodeFrame::Array { values, length, index: Ref::new(0) });
                },
                Object(entries) => {
                    let length = entries.len();
                    serializer.begin_map(length)?;
                    frames.push(ValueEncodeFrame::Object { entries, length, index: Ref::new(0) });
                },
                String(value) => serializer.serialize_string(value)?,
                Number(value) => serializer.serialize_number(value)?,
                Bool(value) => serializer.serialize_bool(value)?,
                Null => serializer.serialize_unit()?,
            }
        } else {
            if frames.is_empty() {
                return Result::Ok(())
            }
            match frames[frames.len() - 1] {
                Array { values, length, index } => {
                    if values.len() != length {
                        return Result::Err(
                            stream_serde_fail(
                                serializer.lease,
                                "JSON input array changed during encoding",
                            ),
                        )
                    }
                    let position = index.get();
                    if position == length {
                        serializer.end_sequence()?;
                        let _ = frames.pop();
                    } else {
                        let child = values[position];
                        serializer.begin_sequence_element(position)?;
                        index.set(position + 1);
                        pending = Option::Some(child);
                    }
                },
                Object { entries, length, index } => {
                    if entries.len() != length {
                        return Result::Err(
                            stream_serde_fail(
                                serializer.lease,
                                "JSON input object changed during encoding",
                            ),
                        )
                    }
                    let position = index.get();
                    if position == length {
                        serializer.end_map()?;
                        let _ = frames.pop();
                    } else {
                        let (name, child) = entries[position];
                        serializer.begin_map_key(position)?;
                        serializer.serialize_string(name)?;
                        serializer.begin_map_value(position)?;
                        index.set(position + 1);
                        pending = Option::Some(child);
                    }
                },
            }
        }
    }
}
