package json;

use module::io;
use module::serde;

pub struct Encoder[W] {
    sink: StreamSink[W],
}

fn stream_encode_action[W: io::Write](
    encoder: Encoder[W],
    newline: bool,
    action: (StreamSerializer[W]) -> Result[(), string],
) -> Result[usize, Error] {
    let session = encoder.sink.session;
    let lease = stream_enter(session, encoder.sink.limits.max_events)?;
    let completed = Ref::new(false);
    defer {
        stream_leave(lease, completed.get());
    };
    let start = session.written.get();
    let serializer = stream_serializer(encoder.sink, lease);
    let serialized = match action(serializer) {
        Ok(()) => finish_stream_serializer(serializer),
        Err(message) => Result::Err(stream_fail(session, ErrorKind::Schema, message, Option::None)),
    };
    let result = serialized.and_then(
        |_| {
            if newline {
                sink_emit_text(encoder.sink, lease, "\n")?;
            }
            stream_check(lease)?;
            Result::Ok((session.written.get() - start).to_usize())
        },
    );
    completed.set(true);
    stream_result(session, result)
}

impl[W: io::Write] Encoder[W] {
    pub fn new(writer: W, limits: EncodeLimits) -> Result[Encoder[W], Error] {
        stream_validate_encode_limits(limits)?;
        Result::Ok(
            Encoder {
                sink: StreamSink {
                    writer,
                    session: stream_session(StreamDirection::Encode),
                    limits,
                },
            },
        )
    }

    pub fn written(self: Encoder[W]) -> usize {
        self.sink.session.written.get().to_usize()
    }

    pub fn encode[T: serde::Serialize](self: Encoder[W], value: T) -> Result[usize, Error] {
        stream_encode_action(
            self,
            true,
            |serializer| serde::Serialize::serialize(value, serializer),
        )
    }

    pub fn encode_value(self: Encoder[W], value: Value) -> Result[usize, Error] {
        stream_encode_action(self, true, |serializer| stream_write_value(value, serializer))
    }
}
