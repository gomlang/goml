package num;

pub enum ParseComplexError {
    Syntax,
    OutOfRange,
}

impl ParseComplexError {
    pub fn is_range(self: ParseComplexError) -> bool {
        match self {
            Syntax => false,
            OutOfRange => true,
        }
    }
}

impl ToString for ParseComplexError {
    fn to_string(self: ParseComplexError) -> string {
        match self {
            Syntax => "invalid complex number syntax",
            OutOfRange => "complex component out of range",
        }
    }
}

impl Debug for ParseComplexError {
    fn debug(self: ParseComplexError) -> string {
        self.to_string()
    }
}

impl PartialEq for ParseComplexError {
    fn eq(self: ParseComplexError, other: ParseComplexError) -> bool {
        match (self, other) {
            (Syntax, Syntax) | (OutOfRange, OutOfRange) => true,
            _ => false,
        }
    }
}

impl Eq for ParseComplexError {}

fn complex_component(value: string, narrow: bool) -> Result[f64, ParseComplexError] {
    let result = if narrow {
        parse_float32_structured(value).map(|parsed: f32| float32_to_float64(parsed))
    } else {
        parse_float64_structured(value)
    };
    result.map_err(
        |error: ParseFloatError| {
            if error.is_range() {
                ParseComplexError::OutOfRange
            } else {
                ParseComplexError::Syntax
            }
        },
    )
}

fn complex_components(value: string, narrow: bool) -> Result[(f64, f64), ParseComplexError] {
    let input = if value.byte_len() >= 2 && value.byte_get(0) == b'('
        && value.byte_get(value.byte_len() - 1) == b')' {
        value.byte_slice(1, value.byte_len() - 1)
    } else {
        value
    };
    if input.byte_len() == 0 {
        return Result::Err(ParseComplexError::Syntax)
    }
    if input.byte_get(input.byte_len() - 1) != b'i' {
        return complex_component(input, narrow).map(|real: f64| (real, 0.0))
    }
    let body = input.byte_slice(0, input.byte_len() - 1);
    let mut separator = -1;
    for index in 1..body.byte_len() {
        let current = body.byte_get(index);
        let previous = body.byte_get(index - 1);
        if (current == b'+' || current == b'-') && previous != b'e' && previous != b'E'
            && previous != b'p'
            && previous != b'P' {
            separator = index;
            break
        }
    }
    if separator < 0 {
        return complex_component(body, narrow).map(|imaginary: f64| (0.0, imaginary))
    }
    let mut imaginary_start = separator;
    if body.byte_get(separator) == b'+' && separator + 1 < body.byte_len()
        && body.byte_get(separator + 1) != b'+' {
        imaginary_start += 1;
    }
    let real = complex_component(body.byte_slice(0, separator), narrow);
    let imaginary = complex_component(body.byte_slice(imaginary_start, body.byte_len()), narrow);
    match (real, imaginary) {
        (Err(ParseComplexError::Syntax), _) | (_, Err(ParseComplexError::Syntax)) => Result::Err(
            ParseComplexError::Syntax,
        ),
        (Err(error), _) | (_, Err(error)) => Result::Err(error),
        (Ok(real), Ok(imaginary)) => Result::Ok((real, imaginary)),
    }
}

pub fn parse_complex_f64(value: string) -> Result[(f64, f64), ParseComplexError] {
    complex_components(value, false)
}

pub fn parse_complex_f32(value: string) -> Result[(f32, f32), ParseComplexError] {
    complex_components(value, true).map(|parts: (f64, f64)| (parts.0.to_f32(), parts.1.to_f32()))
}

pub enum ComplexFormat {
    Shortest(FloatNotation),
    Fixed(isize),
    Scientific(isize, bool),
    General(isize, bool),
    Binary,
    Hex(isize, bool),
}

fn format_complex_component64(value: f64, format: ComplexFormat, max_bytes: isize) -> Result[
    string,
    FormatFloatError,
] {
    match format {
        Shortest(notation) => format_float64_shortest(value, notation, max_bytes),
        Fixed(precision) => format_float64_fixed(value, precision, max_bytes),
        Scientific(precision, uppercase) => format_float64_scientific(
            value,
            precision,
            uppercase,
            max_bytes,
        ),
        General(precision, uppercase) => format_float64_general(
            value,
            precision,
            uppercase,
            max_bytes,
        ),
        Binary => format_float64_binary(value, max_bytes),
        Hex(precision, uppercase) => format_float64_hex(value, precision, uppercase, max_bytes),
    }
}

fn format_complex_component32(value: f32, format: ComplexFormat, max_bytes: isize) -> Result[
    string,
    FormatFloatError,
] {
    match format {
        Shortest(notation) => format_float32_shortest(value, notation, max_bytes),
        Fixed(precision) => format_float32_fixed(value, precision, max_bytes),
        Scientific(precision, uppercase) => format_float32_scientific(
            value,
            precision,
            uppercase,
            max_bytes,
        ),
        General(precision, uppercase) => format_float32_general(
            value,
            precision,
            uppercase,
            max_bytes,
        ),
        Binary => format_float32_binary(value, max_bytes),
        Hex(precision, uppercase) => format_float32_hex(value, precision, uppercase, max_bytes),
    }
}

fn join_complex_components(real: string, imaginary: string, max_bytes: isize) -> Result[
    string,
    FormatFloatError,
] {
    let sign = if imaginary.byte_get(0) == b'+' || imaginary.byte_get(0) == b'-' {
        ""
    } else {
        "+"
    };
    let framing = 3 + sign.byte_len();
    if framing > max_bytes {
        return Result::Err(FormatFloatError::OutputLimit(max_bytes))
    }
    let remaining = max_bytes - framing;
    if real.byte_len() > remaining || imaginary.byte_len() > remaining - real.byte_len() {
        return Result::Err(FormatFloatError::OutputLimit(max_bytes))
    }
    Result::Ok("(" + real + sign + imaginary + "i)")
}

pub fn format_complex_f64(real: f64, imaginary: f64, format: ComplexFormat, max_bytes: isize) -> Result[
    string,
    FormatFloatError,
] {
    let real_text = format_complex_component64(real, format, max_bytes)?;
    let imaginary_text = format_complex_component64(imaginary, format, max_bytes)?;
    join_complex_components(real_text, imaginary_text, max_bytes)
}

pub fn format_complex_f32(real: f32, imaginary: f32, format: ComplexFormat, max_bytes: isize) -> Result[
    string,
    FormatFloatError,
] {
    let real_text = format_complex_component32(real, format, max_bytes)?;
    let imaginary_text = format_complex_component32(imaginary, format, max_bytes)?;
    join_complex_components(real_text, imaginary_text, max_bytes)
}
