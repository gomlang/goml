package num;

pub enum Rounding {
    TowardZero,
    Floor,
    Ceil,
    NearestAway,
    NearestEven,
}

pub enum FloatConversionError {
    NonFinite,
    OutOfRange,
}

impl ToString for FloatConversionError {
    fn to_string(self: FloatConversionError) -> string {
        match self {
            NonFinite => "cannot convert NaN or infinity to an integer",
            OutOfRange => "rounded value is outside the integer range",
        }
    }
}

impl Debug for FloatConversionError {
    fn debug(self: FloatConversionError) -> string {
        self.to_string()
    }
}

fn unsigned_float_bits(value: u64, precision: isize, bias: u64) -> u64 {
    if value == 0 {
        return 0
    }
    let mut exponent = 0;
    let mut remaining = value;
    while remaining > 1 {
        remaining = remaining >> 1;
        exponent += 1;
    }
    let mut significand = value;
    if exponent <= precision {
        significand = significand << (precision - exponent);
    } else {
        let shift = exponent - precision;
        significand = value >> shift;
        let remainder = value & ((1 << shift) - 1);
        let half = 1 << (shift - 1);
        if remainder > half || (remainder == half && (significand & 1) != 0) {
            significand += 1;
            if significand == (1 << (precision + 1)) {
                significand = significand >> 1;
                exponent += 1;
            }
        }
    }
    let exponent_bits = (exponent.to_u64() + bias) << precision;
    exponent_bits | (significand & ((1 << precision) - 1))
}

fn signed_magnitude(value: i64) -> u64 {
    if value < 0 {
        (-(value + 1)).to_u64() + 1
    } else {
        value.to_u64()
    }
}

pub trait ToFloat {
    fn to_f32(self: Self) -> f32;
    fn to_f64(self: Self) -> f64;
}

fn rounded_magnitude(value: f64, rounding: Rounding) -> Result[(bool, u64), FloatConversionError] {
    let bits = value.to_bits();
    let negative = (bits >> 63) != 0;
    let raw_exponent = ((bits >> 52) & 2047).to_isize();
    if raw_exponent == 2047 {
        return Result::Err(FloatConversionError::NonFinite)
    }
    let fraction = bits & 4503599627370495;
    if raw_exponent == 0 && fraction == 0 {
        return Result::Ok((negative, 0))
    }
    let exponent = raw_exponent - 1023;
    if exponent >= 64 {
        return Result::Err(FloatConversionError::OutOfRange)
    }
    let significand = fraction | 4503599627370496;
    let mut magnitude: u64 = 0;
    let mut fractional = true;
    let mut half_comparison = -1;
    if exponent >= 52 {
        magnitude = significand << (exponent - 52);
        fractional = false;
    } else if exponent >= 0 {
        let shift = 52 - exponent;
        magnitude = significand >> shift;
        let remainder = significand & ((1 << shift) - 1);
        fractional = remainder != 0;
        let half = 1 << (shift - 1);
        half_comparison = if remainder < half {
            -1
        } else if remainder == half {
            0
        } else {
            1
        };
    } else if exponent == -1 {
        half_comparison = if fraction == 0 {
            0
        } else {
            1
        };
    }
    let increment = fractional
        && match rounding {
            TowardZero => false,
            Floor => negative,
            Ceil => !negative,
            NearestAway => half_comparison >= 0,
            NearestEven => half_comparison > 0 || (half_comparison == 0 && (magnitude & 1) != 0),
        };
    if increment {
        if magnitude == 18446744073709551615 {
            return Result::Err(FloatConversionError::OutOfRange)
        }
        magnitude += 1;
    }
    Result::Ok((negative, magnitude))
}

pub fn float_to_i64(value: f64, rounding: Rounding) -> Result[i64, FloatConversionError] {
    let (negative, magnitude) = rounded_magnitude(value, rounding)?;
    if negative {
        if magnitude > 9223372036854775808 {
            return Result::Err(FloatConversionError::OutOfRange)
        }
        if magnitude == 9223372036854775808 {
            return Result::Ok(-9223372036854775807 - 1)
        }
        Result::Ok(-magnitude.to_i64())
    } else if magnitude > 9223372036854775807 {
        Result::Err(FloatConversionError::OutOfRange)
    } else {
        Result::Ok(magnitude.to_i64())
    }
}

pub fn float_to_u64(value: f64, rounding: Rounding) -> Result[u64, FloatConversionError] {
    let (negative, magnitude) = rounded_magnitude(value, rounding)?;
    if negative && magnitude != 0 {
        Result::Err(FloatConversionError::OutOfRange)
    } else {
        Result::Ok(magnitude)
    }
}

pub trait TryToInt {
    fn try_to_isize(self: Self) -> Result[isize, FloatConversionError];
    fn try_to_i8(self: Self) -> Result[i8, FloatConversionError];
    fn try_to_i16(self: Self) -> Result[i16, FloatConversionError];
    fn try_to_i32(self: Self) -> Result[i32, FloatConversionError];
    fn try_to_i64(self: Self) -> Result[i64, FloatConversionError];
    fn try_to_usize(self: Self) -> Result[usize, FloatConversionError];
    fn try_to_u8(self: Self) -> Result[u8, FloatConversionError];
    fn try_to_u16(self: Self) -> Result[u16, FloatConversionError];
    fn try_to_u32(self: Self) -> Result[u32, FloatConversionError];
    fn try_to_u64(self: Self) -> Result[u64, FloatConversionError];
}

impl ToFloat for isize {
    fn to_f32(self: isize) -> f32 {
        float32_from_bits(
            (unsigned_float_bits(signed_magnitude(self.to_i64()), 23, 127)
                | (if self < 0 {
                    1 << 31
                } else {
                    0
                })).to_u32(),
        )
    }

    fn to_f64(self: isize) -> f64 {
        float64_from_bits(
            (unsigned_float_bits(signed_magnitude(self.to_i64()), 52, 1023)
                | (if self < 0 {
                    1 << 63
                } else {
                    0
                })),
        )
    }
}

impl ToFloat for i8 {
    fn to_f32(self: i8) -> f32 {
        float32_from_bits(
            (unsigned_float_bits(signed_magnitude(self.to_i64()), 23, 127)
                | (if self < 0 {
                    1 << 31
                } else {
                    0
                })).to_u32(),
        )
    }

    fn to_f64(self: i8) -> f64 {
        float64_from_bits(
            (unsigned_float_bits(signed_magnitude(self.to_i64()), 52, 1023)
                | (if self < 0 {
                    1 << 63
                } else {
                    0
                })),
        )
    }
}

