}

impl ToFloat for u32 {
    fn to_f32(self: u32) -> f32 {
        float32_from_bits((unsigned_float_bits(self.to_u64(), 23, 127)).to_u32())
    }

    fn to_f64(self: u32) -> f64 {
        float64_from_bits((unsigned_float_bits(self.to_u64(), 52, 1023)))
    }
}

impl ToFloat for u64 {
    fn to_f32(self: u64) -> f32 {
        float32_from_bits((unsigned_float_bits(self, 23, 127)).to_u32())
    }

    fn to_f64(self: u64) -> f64 {
        float64_from_bits((unsigned_float_bits(self, 52, 1023)))
    }
}

impl TryToInt for f32 {
    fn try_to_isize(self: f32) -> Result[isize, FloatConversionError] {
        let value = float_to_i64(self.to_f64(), Rounding::TowardZero)?;
        Result::Ok(value.to_isize())
    }

    fn try_to_i8(self: f32) -> Result[i8, FloatConversionError] {
        let value = float_to_i64(self.to_f64(), Rounding::TowardZero)?;
        if value < -128 || value > 127 {
            return Result::Err(FloatConversionError::OutOfRange)
        }
        Result::Ok(value.to_i8())
    }

    fn try_to_i16(self: f32) -> Result[i16, FloatConversionError] {
        let value = float_to_i64(self.to_f64(), Rounding::TowardZero)?;
        if value < -32768 || value > 32767 {
            return Result::Err(FloatConversionError::OutOfRange)
        }
        Result::Ok(value.to_i16())
    }

    fn try_to_i32(self: f32) -> Result[i32, FloatConversionError] {
        let value = float_to_i64(self.to_f64(), Rounding::TowardZero)?;
        if value < -2147483648 || value > 2147483647 {
            return Result::Err(FloatConversionError::OutOfRange)
        }
        Result::Ok(value.to_i32())
    }

    fn try_to_i64(self: f32) -> Result[i64, FloatConversionError] {
        let value = float_to_i64(self.to_f64(), Rounding::TowardZero)?;
        Result::Ok(value)
    }

    fn try_to_usize(self: f32) -> Result[usize, FloatConversionError] {
        let value = float_to_u64(self.to_f64(), Rounding::TowardZero)?;
        Result::Ok(value.to_usize())
    }

    fn try_to_u8(self: f32) -> Result[u8, FloatConversionError] {
        let value = float_to_u64(self.to_f64(), Rounding::TowardZero)?;
        if value > 255 {
            return Result::Err(FloatConversionError::OutOfRange)
        }
        Result::Ok(value.to_u8())
    }

    fn try_to_u16(self: f32) -> Result[u16, FloatConversionError] {
        let value = float_to_u64(self.to_f64(), Rounding::TowardZero)?;
        if value > 65535 {
            return Result::Err(FloatConversionError::OutOfRange)
        }
        Result::Ok(value.to_u16())
    }

    fn try_to_u32(self: f32) -> Result[u32, FloatConversionError] {
        let value = float_to_u64(self.to_f64(), Rounding::TowardZero)?;
        if value > 4294967295 {
            return Result::Err(FloatConversionError::OutOfRange)
        }
        Result::Ok(value.to_u32())
    }

    fn try_to_u64(self: f32) -> Result[u64, FloatConversionError] {
        let value = float_to_u64(self.to_f64(), Rounding::TowardZero)?;
        Result::Ok(value)
    }
}

impl TryToInt for f64 {
    fn try_to_isize(self: f64) -> Result[isize, FloatConversionError] {
        let value = float_to_i64(self, Rounding::TowardZero)?;
        Result::Ok(value.to_isize())
    }

    fn try_to_i8(self: f64) -> Result[i8, FloatConversionError] {
        let value = float_to_i64(self, Rounding::TowardZero)?;
