                | (if self < 0 {
                    1 << 31
                } else {
                    0
                })).to_u32(),
        )
    }

    fn to_f64(self: i32) -> f64 {
        float64_from_bits(
            (unsigned_float_bits(signed_magnitude(self.to_i64()), 52, 1023)
                | (if self < 0 {
                    1 << 63
                } else {
                    0
                })),
        )
    }
}

impl ToFloat for i64 {
    fn to_f32(self: i64) -> f32 {
        float32_from_bits(
            (unsigned_float_bits(signed_magnitude(self), 23, 127)
                | (if self < 0 {
                    1 << 31
                } else {
                    0
                })).to_u32(),
        )
    }

    fn to_f64(self: i64) -> f64 {
        float64_from_bits(
            (unsigned_float_bits(signed_magnitude(self), 52, 1023)
                | (if self < 0 {
                    1 << 63
                } else {
                    0
                })),
        )
    }
}

impl ToFloat for usize {
    fn to_f32(self: usize) -> f32 {
        float32_from_bits((unsigned_float_bits(self.to_u64(), 23, 127)).to_u32())
    }

    fn to_f64(self: usize) -> f64 {
        float64_from_bits((unsigned_float_bits(self.to_u64(), 52, 1023)))
    }
}

impl ToFloat for u8 {
    fn to_f32(self: u8) -> f32 {
        float32_from_bits((unsigned_float_bits(self.to_u64(), 23, 127)).to_u32())
    }

    fn to_f64(self: u8) -> f64 {
        float64_from_bits((unsigned_float_bits(self.to_u64(), 52, 1023)))
    }
}

impl ToFloat for u16 {
    fn to_f32(self: u16) -> f32 {
        float32_from_bits((unsigned_float_bits(self.to_u64(), 23, 127)).to_u32())
    }

    fn to_f64(self: u16) -> f64 {
        float64_from_bits((unsigned_float_bits(self.to_u64(), 52, 1023)))
