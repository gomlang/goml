        if value > 4294967295 {
            return Result::Err(FloatConversionError::OutOfRange)
        }
        Result::Ok(value.to_u32())
    }

    fn try_to_u64(self: f64) -> Result[u64, FloatConversionError] {
        let value = float_to_u64(self, Rounding::TowardZero)?;
        Result::Ok(value)
    }
}
