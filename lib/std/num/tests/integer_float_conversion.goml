package tests;

use std::num;
use std::num::{ToFloat};
use std::rand;
use std::testing;

fn conversion_check_integer_floats(value: u64) -> () {
    let (u64bits, u32bits, i64bits, i32bits) = conversion_expected_integer_floats(value);
    testing::assert_eq(value.to_f64().to_bits(), u64bits);
    testing::assert_eq(value.to_f32().to_bits(), u32bits);
    testing::assert_eq(value.to_i64().to_f64().to_bits(), i64bits);
    testing::assert_eq(value.to_i64().to_f32().to_bits(), i32bits);
}

fn conversion_check_float_integers(bits: u64) -> () {
    let modes = Vec::from_array(
        [
            num::Rounding::TowardZero,
            num::Rounding::Floor,
            num::Rounding::Ceil,
            num::Rounding::NearestAway,
            num::Rounding::NearestEven,
        ],
    );
    for index in 0..modes.len() {
        let (signed, i, unsigned, u) = conversion_expected_float_integers(bits, index);
        let value = float64_from_bits(bits);
        let actual_i = num::float_to_i64(value, modes[index]);
        let actual_u = num::float_to_u64(value, modes[index]);
        testing::assert_eq(actual_i.is_ok(), signed);
        testing::assert_eq(actual_u.is_ok(), unsigned);
        if signed {
            testing::assert_eq(testing::expect_ok(actual_i, "signed oracle"), i);
        }
        if unsigned {
            testing::assert_eq(testing::expect_ok(actual_u, "unsigned oracle"), u);
        }
    }
}

#[test]
fn numeric_conversion_boundaries() -> () {
    let mut seed: u64 = 0x6f4d21a389;
    for _ in 0..2000 {
        let value = rand::next_u64(seed);
        seed = value;
        conversion_check_integer_floats(value);
        conversion_check_float_integers(value);
    }
    for bit in 0..64 {
        let power: u64 = 1 << bit;
        for offset in 0..8 {
            conversion_check_integer_floats(power + offset.to_u64());
            conversion_check_integer_floats(power - offset.to_u64());
        }
    }
    for value in Vec::from_array(
        [
            0.0,
            -0.0,
            0.5,
            -0.5,
            1.5,
            -1.5,
            2.5,
            -2.5,
            9223372036854775808.0,
            -9223372036854775808.0,
            18446744073709551616.0,
        ],
    ) {
        for offset in 0..4 {
            conversion_check_float_integers(value.to_bits() + offset.to_u64());
            conversion_check_float_integers(value.to_bits() - offset.to_u64());
        }
    }
    println("numeric oracle ok")
}
