package tests;

use std::fs;
use std::testing;

static CONVERSION_KNOWN_ANSWERS: OnceCell[HashMap[string, Vec[string]]] = OnceCell::new();

fn conversion_known_answer(key: string) -> Vec[string] {
    let answers = CONVERSION_KNOWN_ANSWERS.get_or_init(
        || {
            let content = testing::expect_ok(
                fs::read_file_structured("num/tests/conversion_known_answers.tsv"),
                "read known answers",
            );
            let values: HashMap[string, Vec[string]] = HashMap::new();
            for line in content.split("\n") {
                if line.byte_len() > 0 {
                    let fields = line.split("\t");
                    let outputs = Vec::new();
                    for index in 1..fields.len() {
                        outputs.push(fields[index]);
                    }
                    testing::assert(!values.contains(fields[0]));
                    values.set(fields[0], outputs);
                }
            }
            values
        },
    );
    testing::expect_some(answers.get(key), "missing known answer: " + key)
}

fn conversion_answer_unsigned(value: string) -> u64 {
    let mut result: u64 = 0;
    testing::assert(value.byte_len() > 0);
    for digit in value.to_bytes() {
        testing::assert(digit >= b'0' && digit <= b'9');
        result = result * 10 + (digit - b'0').to_u64();
    }
    result
}

fn conversion_answer_signed(value: string) -> i64 {
    if value.starts_with("-") {
        (0.to_u64() - conversion_answer_unsigned(value.byte_slice(1, value.byte_len()))).to_i64()
    } else {
        conversion_answer_unsigned(value).to_i64()
    }
}

fn conversion_expected_integer_floats(value: u64) -> (u64, u32, u64, u32) {
    let values = conversion_known_answer("integer_floats" + "|" + value.to_string());
    (
        conversion_answer_unsigned(values[0]),
        conversion_answer_unsigned(values[1]).to_u32(),
        conversion_answer_unsigned(values[2]),
        conversion_answer_unsigned(values[3]).to_u32(),
    )
}

fn conversion_expected_float_integers(bits: u64, mode: isize) -> (bool, i64, bool, u64) {
    let values = conversion_known_answer(
        "float_integers" + "|" + bits.to_string() + "|" + mode.to_string(),
    );
    (
        values[0] == "true",
        conversion_answer_signed(values[1]),
        values[2] == "true",
        conversion_answer_unsigned(values[3]),
    )
}
