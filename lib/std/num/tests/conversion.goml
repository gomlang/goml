package tests;

use std::num;
use std::num::{ToFloat, TryToInt};
use std::testing;

#[test]
fn numeric_conversion_edges() -> () {
    let unsigned: u64 = 18446744073709551615;
    let signed: i64 = -9223372036854775807 - 1;
    testing::assert_eq(unsigned.to_f64(), 18446744073709551616.0);
    testing::assert_eq(signed.to_f64(), -9223372036854775808.0);
    let tie: u64 = 9007199254740993;
    testing::assert_eq(tie.to_f64(), 9007199254740992.0);
    let tie32: u64 = 16777217;
    let expected32: f32 = 16777216.0;
    testing::assert_eq(tie32.to_f32(), expected32);
    testing::assert_eq(testing::expect_ok((127.9).try_to_i8(), "truncate"), 127);
    testing::assert((128.0).try_to_i8().is_err());
    testing::assert((-1.0).try_to_u64().is_err());
    testing::assert_eq(testing::expect_ok((-0.9).try_to_u64(), "truncate toward zero"), 0);
    testing::assert((18446744073709551616.0).try_to_u64().is_err());
    testing::assert_eq(
        testing::expect_ok((-9223372036854775808.0).try_to_i64(), "signed minimum"),
        signed,
    );
    testing::assert(float64_from_bits(9218868437227405312).try_to_i64().is_err());
    testing::assert(float64_from_bits(9221120237041090561).try_to_i64().is_err());
    testing::assert_eq(
        testing::expect_ok(num::float_to_i64(2.5, num::Rounding::NearestEven), "even"),
        2,
    );
    testing::assert_eq(
        testing::expect_ok(num::float_to_i64(3.5, num::Rounding::NearestEven), "odd"),
        4,
    );
    testing::assert_eq(
        testing::expect_ok(num::float_to_i64(-2.5, num::Rounding::NearestAway), "away"),
        -3,
    );
    testing::assert_eq(
        testing::expect_ok(num::float_to_i64(-0.1, num::Rounding::Floor), "floor"),
        -1,
    );
    println("numeric ok")
}
