package tests;

use std::bytes;
use std::encoding::hex;
use std::fs;
use std::testing;

static KNOWN_ANSWERS: OnceCell[HashMap[string, Vec[string]]] = OnceCell::new();

fn known_answer(key: string) -> Vec[string] {
    let answers = KNOWN_ANSWERS.get_or_init(
        || {
            let content = testing::expect_ok(
                fs::read_file_structured("num/tests/known_answers.tsv"),
                "read known answers",
            );
            let values: HashMap[string, Vec[string]] = HashMap::new();
            for line in content.split("\n") {
                if line.byte_len() > 0 {
                    let fields = line.split("\t");
                    let outputs = Vec::new();
                    for index in 1..fields.len() {
                        outputs.push(fields[index]);
                    }
                    testing::assert(!values.contains(fields[0]));
                    values.set(fields[0], outputs);
                }
            }
            values
        },
    );
    testing::expect_some(answers.get(key), "missing known answer: " + key)
}

fn answer_unsigned(value: string) -> u64 {
    let mut result: u64 = 0;
    testing::assert(value.byte_len() > 0);
    for digit in value.to_bytes() {
        testing::assert(digit >= b'0' && digit <= b'9');
        result = result * 10 + (digit - b'0').to_u64();
    }
    result
}

fn answer_text(value: string) -> string {
    let (valid, text) = string_from_utf8(
        testing::expect_ok(hex::decode(value), "known answer hex").to_vec(),
    );
    testing::assert(valid);
    text
}

fn answer_bytes(value: Slice[byte]) -> string {
    hex::encode(bytes::Bytes::from_slice_copy(value))
}

fn expected_format_int(value: i64, radix: isize) -> string {
    let values = known_answer("go_format_int" + "|" + value.to_string() + "|" + radix.to_string());
    answer_text(values[0])
}

fn expected_format_uint(value: u64, radix: isize) -> string {
    let values = known_answer("go_format_uint" + "|" + value.to_string() + "|" + radix.to_string());
    answer_text(values[0])
}

fn expected_parse_complex(value: string, width: isize) -> (u64, u64, bool, bool) {
    let values = known_answer(
        "go_parse_complex" + "|" + answer_bytes(value.to_bytes().as_slice()) + "|"
            + width.to_string(),
    );
    (
        answer_unsigned(values[0]),
        answer_unsigned(values[1]),
        values[2] == "true",
        values[3] == "true",
    )
}

fn expected_parse_float(value: string, bits: isize) -> (u64, bool, bool) {
    let values = known_answer(
        "go_parse_float" + "|" + answer_bytes(value.to_bytes().as_slice()) + "|" + bits.to_string(),
    );
    (answer_unsigned(values[0]), values[1] == "true", values[2] == "true")
}

fn expected_parse_exact_float(value: string, bits: isize) -> (u64, bool, bool) {
    let values = known_answer(
        "go_parse_exact_float" + "|" + answer_bytes(value.to_bytes().as_slice()) + "|"
            + bits.to_string(),
    );
    (answer_unsigned(values[0]), values[1] == "true", values[2] == "true")
}

fn expected_parse_bool(value: string) -> (bool, bool) {
    let values = known_answer("go_parse_bool" + "|" + answer_bytes(value.to_bytes().as_slice()));
    (values[0] == "true", values[1] == "true")
}

fn expected_integer_float_bits(value: u64, signed: bool) -> (u32, u64) {
    let values = known_answer(
        "go_integer_float_bits" + "|" + value.to_string() + "|" + signed.to_string(),
    );
    (answer_unsigned(values[0]).to_u32(), answer_unsigned(values[1]))
}

fn expected_format_complex(real: f64, imaginary: f64, format: byte, precision: isize, width: isize) -> string {
    let values = known_answer(
        "go_format_complex" + "|" + float64_to_bits(real).to_string() + "|"
            + float64_to_bits(imaginary).to_string()
            + "|"
            + format.to_string()
            + "|"
            + precision.to_string()
            + "|"
            + width.to_string(),
    );
    answer_text(values[0])
}
