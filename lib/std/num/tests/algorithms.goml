package tests;

use std::testing;

fn assert_equal[T: PartialEq](actual: T, expected: T) -> () {
    testing::assert(actual == expected)
}

#[test]
fn numeric_algorithms() -> () {
    check_complex_formatting();
    check_complex_parsing();
    check_float_conversions();
    check_float_parsing();
    check_float_shortest();
    check_float_power();
    check_float_fixed();
    check_boolean_parsing();
    check_integer_format();
    check_integer_width();
    check_aggregate_answers();
    println("pure standard algorithms ok")
}
