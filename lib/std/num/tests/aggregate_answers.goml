package tests;

use std::num;
use std::num::{TryToInt};
use std::testing;

struct AnswerDigest {
    hash: Ref[u64],
    count: Ref[isize],
}

static FORMAT_ANSWERS: OnceCell[AnswerDigest] = OnceCell::new();

static ROUNDING_ANSWERS: OnceCell[AnswerDigest] = OnceCell::new();

static SIGNED_PARSE_ANSWERS: OnceCell[AnswerDigest] = OnceCell::new();

static UNSIGNED_PARSE_ANSWERS: OnceCell[AnswerDigest] = OnceCell::new();

fn answer_digest(cell: OnceCell[AnswerDigest]) -> AnswerDigest {
    cell.get_or_init(|| AnswerDigest { hash: Ref::new(14695981039346656037), count: Ref::new(0) })
}

fn record_answer(cell: OnceCell[AnswerDigest], value: string) -> () {
    let state = answer_digest(cell);
    let mut hash = state.hash.get();
    for byte in value.to_bytes() {
        hash = (hash ^ byte.to_u64()) * 1099511628211;
    }
    state.hash.set(hash);
    state.count.set(state.count.get() + 1);
}

fn assert_answer_digest(cell: OnceCell[AnswerDigest], count: isize, hash: u64, name: string) -> () {
    let state = answer_digest(cell);
    if state.count.get() != count || state.hash.get() != hash {
        testing::fail(
            f"{name} known-answer mismatch: count {state.count.get()}, digest {state.hash.get()}",
        );
    }
}

fn check_aggregate_answers() -> () {
    assert_answer_digest(FORMAT_ANSWERS, 283786, 13139322998476136644, "float formatting");
    assert_answer_digest(ROUNDING_ANSWERS, 358720, 8813407331961481098, "float integer conversion");
    assert_answer_digest(
        SIGNED_PARSE_ANSWERS,
        29640,
        10220148350331383328,
        "signed integer parsing",
    );
    assert_answer_digest(
        UNSIGNED_PARSE_ANSWERS,
        29640,
        10968687544468165129,
        "unsigned integer parsing",
    );
}

fn checked_parse_signed_width(input: string, radix: isize, bits: isize) -> (i64, bool) {
    let result = match num::parse_int_bits(input, radix, bits) {
        Ok(value) => (value, true),
        Err(_) => (0.to_i64(), false),
    };
    let (value, valid) = result;
    record_answer(
        SIGNED_PARSE_ANSWERS,
        "go_parse_signed_width|" + answer_bytes(input.to_bytes().as_slice())
            + f"|{radix}|{bits}\t{value}\t{valid}\n",
    );
    result
}

fn checked_parse_unsigned_width(input: string, radix: isize, bits: isize) -> (u64, bool) {
    let result = match num::parse_uint_bits(input, radix, bits) {
        Ok(value) => (value, true),
        Err(_) => (0.to_u64(), false),
    };
    let (value, valid) = result;
    record_answer(
        UNSIGNED_PARSE_ANSWERS,
        "go_parse_unsigned_width|" + answer_bytes(input.to_bytes().as_slice())
            + f"|{radix}|{bits}\t{value}\t{valid}\n",
    );
    result
}

fn rounded_answer(result: Result[u64, num::FloatConversionError]) -> (u64, isize) {
    match result {
        Ok(value) => (value, 0),
        Err(num::FloatConversionError::NonFinite) => (0, 1),
        Err(num::FloatConversionError::OutOfRange) => (0, 2),
    }
}

fn checked_rounded_integer(value: f64, mode: isize, width: isize, signed: bool) -> (u64, isize) {
    let rounding = [
        num::Rounding::TowardZero,
        num::Rounding::Floor,
        num::Rounding::Ceil,
        num::Rounding::NearestAway,
        num::Rounding::NearestEven,
    ][mode];
    let result = if width == 64 {
        if signed {
            num::float_to_i64(value, rounding).map(|n: i64| n.to_u64())
        } else {
            num::float_to_u64(value, rounding)
        }
    } else {
        testing::assert_eq(mode, 0);
        if signed {
            match width {
                8 => value.try_to_i8().map(|n: i8| n.to_i64().to_u64()),
                16 => value.try_to_i16().map(|n: i16| n.to_i64().to_u64()),
                32 => value.try_to_i32().map(|n: i32| n.to_i64().to_u64()),
                _ => {
                    testing::fail("unsupported signed known-answer width");
                    Result::Err(num::FloatConversionError::OutOfRange)
                },
            }
        } else {
            match width {
                8 => value.try_to_u8().map(|n: u8| n.to_u64()),
                16 => value.try_to_u16().map(|n: u16| n.to_u64()),
                32 => value.try_to_u32().map(|n: u32| n.to_u64()),
                _ => {
                    testing::fail("unsupported unsigned known-answer width");
                    Result::Err(num::FloatConversionError::OutOfRange)
                },
            }
        }
    };
    let (bits, status) = rounded_answer(result);
    record_answer(
        ROUNDING_ANSWERS,
        f"go_rounded_integer|{float64_to_bits(value)}|{mode}|{width}|{signed}\t{bits}\t{status}\n",
    );
    (bits, status)
}

fn checked_float_format(value: f64, format: byte, precision: isize, bits: isize) -> string {
    let limit = 4096;
    let shortest = match format {
        b'f' => num::FloatNotation::Fixed,
        b'e' => num::FloatNotation::Scientific,
        b'E' => num::FloatNotation::ScientificUpper,
        b'g' => num::FloatNotation::General,
        _ => num::FloatNotation::GeneralUpper,
    };
    let result = if bits == 64 {
        match format {
            b'b' => num::format_float64_binary(value, limit),
            b'x' | b'X' => num::format_float64_hex(value, precision, format == b'X', limit),
            _ => if precision == -1 {
                num::format_float64_shortest(value, shortest, limit)
            } else {
                match format {
                    b'f' => num::format_float64_fixed(value, precision, limit),
                    b'e' | b'E' => num::format_float64_scientific(
                        value,
                        precision,
                        format == b'E',
                        limit,
                    ),
                    _ => num::format_float64_general(value, precision, format == b'G', limit),
                }
            },
        }
    } else {
        testing::assert_eq(bits, 32);
        let value = float64_to_float32(value);
        match format {
            b'b' => num::format_float32_binary(value, limit),
            b'x' | b'X' => num::format_float32_hex(value, precision, format == b'X', limit),
            _ => if precision == -1 {
                num::format_float32_shortest(value, shortest, limit)
            } else {
                match format {
                    b'f' => num::format_float32_fixed(value, precision, limit),
                    b'e' | b'E' => num::format_float32_scientific(
                        value,
                        precision,
                        format == b'E',
                        limit,
                    ),
                    _ => num::format_float32_general(value, precision, format == b'G', limit),
                }
            },
        }
    };
    let output = testing::expect_ok(result, "known-answer float formatting");
    record_answer(
        FORMAT_ANSWERS,
        f"go_format_float|{float64_to_bits(value)}|{format}|{precision}|{bits}\t"
            + answer_bytes(output.to_bytes().as_slice())
            + "\n",
    );
    output
}
