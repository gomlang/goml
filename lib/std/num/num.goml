package num;

pub fn parse_bool_structured(value: string) -> Result[bool, ParseBoolError] {
    match value {
        "1" | "t" | "T" | "true" | "TRUE" | "True" => Result::Ok(true),
        "0" | "f" | "F" | "false" | "FALSE" | "False" => Result::Ok(false),
        _ => Result::Err(ParseBoolError { input_value: value }),
    }
}

pub enum FormatIntError {
    InvalidRadix(isize),
    BufferTooSmall(isize, isize),
}

impl ToString for FormatIntError {
    fn to_string(self: FormatIntError) -> string {
        match self {
            FormatIntError::InvalidRadix(radix) => f"invalid integer formatting radix: {radix}",
            FormatIntError::BufferTooSmall(needed, available) => f"integer output needs {needed} bytes, buffer has {available}",
        }
    }
}

impl Debug for FormatIntError {
    fn debug(self: FormatIntError) -> string {
        self.to_string()
    }
}

fn integer_format_bytes(value: u64, negative: bool, radix: isize) -> Result[
    Vec[byte],
    FormatIntError,
] {
    if radix < 2 || radix > 36 {
        return Result::Err(FormatIntError::InvalidRadix(radix))
    }
    let digits = "0123456789abcdefghijklmnopqrstuvwxyz";
    let reversed: Vec[byte] = Vec::new();
    let mut remaining = value;
    loop {
        reversed.push(digits.byte_get((remaining % radix.to_u64()).to_isize()));
        remaining = remaining / radix.to_u64();
        if remaining == 0 {
            break
        }
    }
    let result: Vec[byte] = Vec::new();
    if negative {
        result.push(b'-');
    }
    let mut index = reversed.len();
    while index > 0 {
        index -= 1;
        result.push(reversed[index]);
    }
    Result::Ok(result)
}

fn signed_format_bytes(value: i64, radix: isize) -> Result[Vec[byte], FormatIntError] {
    let magnitude = if value < 0 {
        (-(value + 1)).to_u64() + 1
    } else {
        value.to_u64()
    };
    integer_format_bytes(magnitude, value < 0, radix)
}

pub fn format_int(value: i64, radix: isize) -> Result[string, FormatIntError] {
    Result::Ok(string_from_utf8(signed_format_bytes(value, radix)?).1)
}

pub fn format_uint(value: u64, radix: isize) -> Result[string, FormatIntError] {
    Result::Ok(string_from_utf8(integer_format_bytes(value, false, radix)?).1)
}

fn write_integer(output: MutSlice[byte], encoded: Vec[byte]) -> Result[isize, FormatIntError] {
    if output.len() < encoded.len() {
        return Result::Err(FormatIntError::BufferTooSmall(encoded.len(), output.len()))
    }
    for index in 0..encoded.len() {
        output[index] = encoded[index];
    }
    Result::Ok(encoded.len())
}

pub fn write_int(output: MutSlice[byte], value: i64, radix: isize) -> Result[isize, FormatIntError] {
    write_integer(output, signed_format_bytes(value, radix)?)
}

pub fn write_uint(output: MutSlice[byte], value: u64, radix: isize) -> Result[isize, FormatIntError] {
    write_integer(output, integer_format_bytes(value, false, radix)?)
}

fn integer_digit(value: byte) -> Option[isize] {
    if value >= b'0' && value <= b'9' {
        Option::Some((value - b'0').to_isize())
    } else if value >= b'a' && value <= b'z' {
        Option::Some((value - b'a' + 10).to_isize())
    } else if value >= b'A' && value <= b'Z' {
        Option::Some((value - b'A' + 10).to_isize())
    } else {
        Option::None
    }
}

fn integer_base(value: string, start: isize, radix: isize) -> (bool, isize, isize, bool) {
    if radix != 0 && (radix < 2 || radix > 36) {
        return (false, start, radix, false)
    } else if radix != 0 {
        return (true, start, radix, false)
    } else if start < value.byte_len() && value.byte_get(start) == b'0' {
        if start + 1 < value.byte_len() {
            let marker = value.byte_get(start + 1);
            if marker == b'x' || marker == b'X' {
                return (true, start + 2, 16, true)
            } else if marker == b'o' || marker == b'O' {
                return (true, start + 2, 8, true)
            } else if marker == b'b' || marker == b'B' {
                return (true, start + 2, 2, true)
            }
        };
        (true, start, 8, true)
    } else {
        (true, start, 10, false)
    }
}

fn integer_magnitude(
    value: string,
    start: isize,
    radix: isize,
    allow_underscores: bool,
    prefix: bool,
    limit: u64,
) -> (bool, u64, string) {
    let mut index = start;
    let mut result: u64 = 0;
    let mut saw_digit = false;
    let mut previous_digit = false;
    while index < value.byte_len() {
        let current = value.byte_get(index);
        if current == b'_' {
            let after_prefix = prefix && !saw_digit && index == start;
            if !allow_underscores || (!previous_digit && !after_prefix)
                || index + 1 >= value.byte_len() {
                return (false, 0, "invalid syntax")
            }
            match integer_digit(value.byte_get(index + 1)) {
                Some(digit) => if digit >= radix {
                    return (false, 0, "invalid syntax")
                },
                None => return (false, 0, "invalid syntax"),
            }
            previous_digit = false;
            index += 1;
        } else {
            let Some(digit) = integer_digit(current) else {
                return (false, 0, "invalid syntax");
            };
            if digit >= radix {
                return (false, 0, "invalid syntax")
            }
            let unsigned_digit = digit.to_u64();
            let unsigned_radix = radix.to_u64();
            if result > (limit - unsigned_digit) / unsigned_radix {
                return (false, 0, "value out of range")
            }
            result = result * unsigned_radix + unsigned_digit;
            saw_digit = true;
            previous_digit = true;
            index += 1;
        }
    }
    if !saw_digit || !previous_digit {
        (false, 0, "invalid syntax")
    } else {
        (true, result, "")
    }
}

fn parse_int_value(value: string, radix: isize) -> (bool, isize, string) {
    let mut start = 0;
    let mut negative = false;
    if start < value.byte_len() && (value.byte_get(start) == b'+' || value.byte_get(start) == b'-') {
        negative = value.byte_get(start) == b'-';
        start += 1;
    }
    let (valid_radix, digits_start, actual_radix, prefix) = integer_base(value, start, radix);
    if !valid_radix {
        return (false, 0, "invalid radix")
    }
    let limit: u64 = if negative {
        9223372036854775808
    } else {
        9223372036854775807
    };
    let (valid, magnitude, message) = integer_magnitude(
        value,
        digits_start,
        actual_radix,
        radix == 0,
        prefix,
        limit,
    );
    if !valid {
        (false, 0, message)
    } else if negative && magnitude == 9223372036854775808 {
        (true, -9223372036854775807 - 1, "")
    } else if negative {
        (true, 0 - magnitude.to_isize(), "")
    } else {
        (true, magnitude.to_isize(), "")
    }
}

fn parse_uint_value(value: string, radix: isize) -> (bool, usize, string) {
    let (valid_radix, digits_start, actual_radix, prefix) = integer_base(value, 0, radix);
    if !valid_radix {
        return (false, 0, "invalid radix")
    }
    let (valid, magnitude, message) = integer_magnitude(
        value,
        digits_start,
        actual_radix,
        radix == 0,
        prefix,
        18446744073709551615,
    );
    if valid {
        (true, magnitude.to_usize(), "")
    } else {
        (false, 0, message)
    }
}

fn float_parse_failure(value: string, parsed: f64) -> ParseFloatError {
    let range = float64_to_bits(parsed) & 0x7fffffffffffffff == 0x7ff0000000000000;
    ParseFloatError::classified(
        value,
        if range {
            "value out of range"
        } else {
            "invalid syntax"
        },
        range,
    )
}

pub fn parse_int_structured(value: string) -> Result[isize, ParseIntError] {
    parse_int_radix_structured(value, 10)
}

pub enum IntWidthError {
    InvalidWidth(isize),
    Parse(ParseIntError),
    OutOfRange(isize),
}

impl ToString for IntWidthError {
    fn to_string(self: IntWidthError) -> string {
        match self {
            IntWidthError::InvalidWidth(bits) => f"invalid integer bit width: {bits}",
            IntWidthError::Parse(error) => error.to_string(),
            IntWidthError::OutOfRange(bits) => f"integer is outside the requested {bits}-bit range",
        }
    }
}

impl Debug for IntWidthError {
    fn debug(self: IntWidthError) -> string {
        self.to_string()
    }
}

fn integer_width(bits: isize) -> Result[isize, IntWidthError] {
    if bits < 0 || bits > 64 {
        Result::Err(IntWidthError::InvalidWidth(bits))
    } else {
        Result::Ok(
            if bits == 0 {
                64
            } else {
                bits
            },
        )
    }
}

pub fn parse_int_bits(value: string, radix: isize, bits: isize) -> Result[i64, IntWidthError] {
    let width = integer_width(bits)?;
    let parsed = parse_int_radix_structured(value, radix).map_err(
        |error| IntWidthError::Parse(error),
    )?.to_i64();
    if width < 64 {
        let bound = 1.to_i64() << (width - 1);
        if parsed < -bound || parsed >= bound {
            return Result::Err(IntWidthError::OutOfRange(width))
        }
    }
    Result::Ok(parsed)
}

pub fn parse_uint_bits(value: string, radix: isize, bits: isize) -> Result[u64, IntWidthError] {
    let width = integer_width(bits)?;
    let parsed = parse_uint_radix_structured(value, radix).map_err(
        |error| IntWidthError::Parse(error),
    )?.to_u64();
    if width < 64 && parsed >= (1.to_u64() << width) {
        return Result::Err(IntWidthError::OutOfRange(width))
    }
    Result::Ok(parsed)
}

pub fn parse_int_radix_structured(value: string, radix: isize) -> Result[isize, ParseIntError] {
    let (ok, parsed, message) = parse_int_value(value, radix);
    if ok {
        Result::Ok(parsed)
    } else {
        Result::Err(ParseIntError::new(value, radix, message))
    }
}

pub fn parse_uint_structured(value: string) -> Result[usize, ParseIntError] {
    parse_uint_radix_structured(value, 10)
}

pub fn parse_uint_radix_structured(value: string, radix: isize) -> Result[usize, ParseIntError] {
    let (ok, parsed, message) = parse_uint_value(value, radix);
    if ok {
        Result::Ok(parsed)
    } else {
        Result::Err(ParseIntError::new(value, radix, message))
    }
}

pub fn parse_float32_structured(value: string) -> Result[f32, ParseFloatError] {
    let (ok, parsed) = __goml_builtin_string_parse_float32(value);
    if ok {
        Result::Ok(parsed.to_f32())
    } else {
        Result::Err(float_parse_failure(value, parsed))
    }
}

pub fn parse_float64_structured(value: string) -> Result[f64, ParseFloatError] {
    let (ok, parsed) = __goml_builtin_string_parse_float64(value);
    if ok {
        Result::Ok(parsed)
    } else {
        Result::Err(float_parse_failure(value, parsed))
    }
}

pub fn checked_add_int64(left: i64, right: i64) -> Option[i64] {
    if right > 0 && left > 9223372036854775807 - right {
        Option::None
    } else if right < 0 && left < -9223372036854775807 - 1 - right {
        Option::None
    } else {
        Option::Some(left + right)
    }
}

pub fn checked_subtract_int64(left: i64, right: i64) -> Option[i64] {
    if right > 0 && left < -9223372036854775807 - 1 + right {
        Option::None
    } else if right < 0 && left > 9223372036854775807 + right {
        Option::None
    } else {
        Option::Some(left - right)
    }
}

pub fn checked_multiply_int64(left: i64, right: i64) -> Option[i64] {
    if left == 0 || right == 0 {
        Option::Some(0)
    } else if left == -9223372036854775807 - 1 && right == -1 {
        Option::None
    } else if right == -9223372036854775807 - 1 && left == -1 {
        Option::None
    } else {
        let result = left * right;
        if result / right == left {
            Option::Some(result)
        } else {
            Option::None
        }
    }
}

pub fn saturating_add_int64(left: i64, right: i64) -> i64 {
    match checked_add_int64(left, right) {
        Some(value) => value,
        None => if right < 0 {
            -9223372036854775807 - 1
        } else {
            9223372036854775807
        },
    }
}

pub fn saturating_subtract_int64(left: i64, right: i64) -> i64 {
    match checked_subtract_int64(left, right) {
        Some(value) => value,
        None => if right < 0 {
            9223372036854775807
        } else {
            -9223372036854775807 - 1
        },
    }
}

pub fn saturating_multiply_int64(left: i64, right: i64) -> i64 {
    match checked_multiply_int64(left, right) {
        Some(value) => value,
        None => if (left < 0) != (right < 0) {
            -9223372036854775807 - 1
        } else {
            9223372036854775807
        },
    }
}
