package task;

use module::internal::task as internal_task;
use module::panic;

pub struct CancelToken {
    value: internal_task::CancelToken,
}

pub struct Scope {
    handle: internal_task::ScopeHandle,
}

pub struct Task[T] {
    result: Ref[Option[Result[T, panic::Panic]]],
    ready: Channel[()],
}

pub struct IndexedError[E] {
    pub index: isize,
    pub error: E,
}

pub struct ConcurrencyLimit {
    slots: Channel[()],
}

pub enum WaitResult[T] {
    Completed(T),
    Cancelled,
}

fn completed_scope_value[T](result: Ref[Option[T]]) -> T {
    loop {
        if let Some(value) = result.get() {
            break value
        }
    }
}

impl ConcurrencyLimit {
    pub fn new(limit: isize) -> ConcurrencyLimit {
        let count = if limit > 0 {
            limit
        } else {
            1
        };
        let slots: Channel[()] = Channel::new(count);
        for _ in 0..count {
            slots.send(())
        }
        ConcurrencyLimit { slots }
    }

    pub fn run[T](self: ConcurrencyLimit, cancel: CancelToken, body: (CancelToken) -> T) -> WaitResult[
        T,
    ] {
        match recv_with(cancel, self.slots) {
            WaitResult::Completed(Some(())) => {
                defer self.slots.send(());
                WaitResult::Completed(body(cancel))
            },
            WaitResult::Completed(None) | WaitResult::Cancelled => WaitResult::Cancelled,
        }
    }
}

pub fn scope[T](body: (Scope) -> T) -> T {
    let handle = internal_task::root_scope();
    let result: Ref[Option[T]] = Ref::new(Option::None);
    internal_task::run(handle, || result.set(Option::Some(body(Scope { handle }))));
    completed_scope_value(result)
}

pub fn scope_with[T](parent: CancelToken, body: (Scope) -> T) -> T {
    let handle = internal_task::child_scope(parent.value);
    let result: Ref[Option[T]] = Ref::new(Option::None);
    internal_task::run(handle, || result.set(Option::Some(body(Scope { handle }))));
    completed_scope_value(result)
}

pub fn try_scope[T, E](body: (Scope) -> Result[T, E]) -> Result[T, E] {
    let handle = internal_task::root_scope();
    let result: Ref[Option[Result[T, E]]] = Ref::new(Option::None);
    internal_task::run(
        handle,
        || {
            let value = body(Scope { handle });
            if value.is_err() {
                internal_task::cancel(handle)
            }
            result.set(Option::Some(value))
        },
    );
    completed_scope_value(result)
}

pub fn try_scope_with[T, E](parent: CancelToken, body: (Scope) -> Result[T, E]) -> Result[T, E] {
    let handle = internal_task::child_scope(parent.value);
    let result: Ref[Option[Result[T, E]]] = Ref::new(Option::None);
    internal_task::run(
        handle,
        || {
            let value = body(Scope { handle });
            if value.is_err() {
                internal_task::cancel(handle)
            }
            result.set(Option::Some(value))
        },
    );
    completed_scope_value(result)
}

pub fn active_scope_count() -> isize {
    internal_task::active_scope_count()
}

impl Scope {
    pub fn spawn[T](self: Scope, body: (CancelToken) -> T) -> Task[T] {
        let result: Ref[Option[Result[T, panic::Panic]]] = Ref::new(Option::None);
        let ready: Channel[()] = Channel::new(0);
        let token = CancelToken { value: internal_task::token(self.handle) };
        internal_task::spawn(
            self.handle,
            || {
                let outcome = panic::catch(|| body(token));
                result.set(Option::Some(outcome));
                ready.close();
                if let Err(info) = outcome {
                    panic::resume(info);
                }
            },
        );
        Task { result, ready }
    }

    pub fn try_spawn[T](self: Scope, body: (CancelToken) -> T) -> Option[Task[T]] {
        let result: Ref[Option[Result[T, panic::Panic]]] = Ref::new(Option::None);
        let ready: Channel[()] = Channel::new(0);
        let token = CancelToken { value: internal_task::token(self.handle) };
        if internal_task::try_spawn(
            self.handle,
            || {
                let outcome = panic::catch(|| body(token));
                result.set(Option::Some(outcome));
                ready.close();
                if let Err(info) = outcome {
                    panic::resume(info);
                }
            },
        ) {
            Option::Some(Task { result, ready })
        } else {
            Option::None
        }
    }

    pub fn spawn_try[T, E](self: Scope, body: (CancelToken) -> Result[T, E]) -> Task[Result[T, E]] {
        self.spawn(
            |token| {
                let value = body(token);
                if value.is_err() {
                    self.cancel()
                }
                value
            },
        )
    }

    pub fn cancel(self: Scope) -> () {
        internal_task::cancel(self.handle)
    }

    pub fn token(self: Scope) -> CancelToken {
        CancelToken { value: internal_task::token(self.handle) }
    }
}

impl CancelToken {
    pub fn is_cancelled(self: CancelToken) -> bool {
        self.value.is_cancelled()
    }

    pub fn runtime_id(self: CancelToken) -> i64 {
        internal_task::id(self.value)
    }

    pub fn done(self: CancelToken) -> Receiver[()] {
        self.value.done()
    }
}

pub fn recv_with[T](cancel: CancelToken, channel: Channel[T]) -> WaitResult[Option[T]] {
    let (value, open, completed) = internal_task::recv_with(cancel.value, channel);
    if completed {
        if open {
            WaitResult::Completed(Option::Some(value))
        } else {
            WaitResult::Completed(Option::None)
        }
    } else {
        WaitResult::Cancelled
    }
}

pub fn send_with[T](cancel: CancelToken, channel: Channel[T], value: T) -> WaitResult[()] {
    if internal_task::send_with(cancel.value, channel, value) {
        WaitResult::Completed(())
    } else {
        WaitResult::Cancelled
    }
}

pub fn sleep_nanoseconds_with(cancel: CancelToken, nanoseconds: i64) -> WaitResult[()] {
    if internal_task::sleep_with(cancel.value, nanoseconds) {
        WaitResult::Completed(())
    } else {
        WaitResult::Cancelled
    }
}

impl[T] Task[T] {
    pub fn done(self: Task[T]) -> Receiver[()] {
        self.ready.receiver()
    }

    pub fn join(self: Task[T]) -> T {
        let _ = self.ready.recv();
        match self.result.get() {
            Some(Ok(value)) => value,
            Some(Err(info)) => panic::resume(info),
            None => panic::raise("task completed without a result"),
        }
    }
}

pub fn join_all[T](tasks: Vec[Task[T]]) -> Vec[T] {
    let values: Vec[T] = Vec::with_capacity(tasks.len());
    for task in tasks {
        values.push(task.join())
    }
    values
}

pub fn join_all_results[T, E](tasks: Vec[Task[Result[T, E]]]) -> Result[Vec[T], Vec[E]] {
    let values: Vec[T] = Vec::with_capacity(tasks.len());
    let errors: Vec[E] = Vec::new();
    for task in tasks {
        match task.join() {
            Ok(value) => values.push(value),
            Err(error) => errors.push(error),
        }
    }
    if errors.is_empty() {
        Result::Ok(values)
    } else {
        Result::Err(errors)
    }
}

pub fn join_all_indexed_results[T, E](tasks: Vec[Task[Result[T, E]]]) -> Result[
    Vec[T],
    Vec[IndexedError[E]],
] {
    let values: Vec[T] = Vec::with_capacity(tasks.len());
    let errors: Vec[IndexedError[E]] = Vec::new();
    for index in 0..tasks.len() {
        match tasks[index].join() {
            Ok(value) => values.push(value),
            Err(error) => errors.push(IndexedError { index, error }),
        }
    }
    if errors.is_empty() {
        Result::Ok(values)
    } else {
        Result::Err(errors)
    }
}

fn concurrent_worker[T, E](
    cancel: CancelToken,
    work: Channel[(isize, T)],
    results: Channel[(isize, Result[(), E])],
    body: (CancelToken, T) -> Result[(), E],
) -> () {
    loop {
        match recv_with(cancel, work) {
            WaitResult::Completed(Some(item)) => {
                let result = body(cancel, item.1);
                if let WaitResult::Cancelled = send_with(cancel, results, (item.0, result)) {
                    break;
                }
            },
            WaitResult::Completed(None) | WaitResult::Cancelled => break,
        }
    }
}

fn record_concurrent_result[E](ordered: Vec[Option[E]], received: Option[(isize, Result[(), E])]) -> () {
    if let Some(item) = received {
        if let Err(error) = item.1 {
            ordered[item.0] = Option::Some(error);
        }
    }
}

pub fn for_each_concurrent[T, E](
    limit: isize,
    values: Vec[T],
    body: (CancelToken, T) -> Result[(), E],
) -> Result[(), Vec[IndexedError[E]]] {
    if values.is_empty() {
        return Result::Ok(())
    }
    let total = values.len();
    let worker_count = if limit <= 0 {
        1
    } else if limit < total {
        limit
    } else {
        total
    };
    let work: Channel[(isize, T)] = Channel::new(worker_count);
    let results: Channel[(isize, Result[(), E])] = Channel::new(worker_count);
    scope(
        |scope: Scope| {
            defer work.close();
            let cancel = scope.token();
            for _ in 0..worker_count {
                let _ = scope.spawn(
                    |cancel: CancelToken| concurrent_worker(cancel, work, results, body),
                );
            }
            let ordered: Vec[Option[E]] = Vec::with_capacity(total);
            for _ in 0..total {
                ordered.push(Option::None)
            }
            let mut dispatched = 0;
            let mut completed = 0;
            while completed < total {
                if dispatched < total {
                    select {
                        send(work,(dispatched, values[dispatched])) => {
                            dispatched += 1;
                        },
                        recv(results) as received => {
                            record_concurrent_result(ordered, received);
                            completed += 1;
                        },
                        recv(cancel.done()) as _ => return Result::Ok(()),
                    }
                } else {
                    let received = select {
                        recv(results) as value => value,
                        recv(cancel.done()) as _ => return Result::Ok(()),
                    };
                    record_concurrent_result(ordered, received);
                    completed += 1;
                };
            }
            let errors: Vec[IndexedError[E]] = Vec::new();
            for index in 0..total {
                if let Some(error) = ordered[index] {
                    errors.push(IndexedError { index, error })
                }
            }
            if errors.is_empty() {
                Result::Ok(())
            } else {
                Result::Err(errors)
            }
        },
    )
}

pub fn race[T](bodies: Vec[(CancelToken) -> T]) -> Option[T] {
    if bodies.is_empty() {
        return Option::None
    }
    scope(
        |scope: Scope| {
            let results: Channel[T] = Channel::new(1);
            for body in bodies {
                let _ = scope.spawn(
                    |cancel: CancelToken| {
                        let value = body(cancel);
                        select {
                            send(results, value) => (),
                            default => (),
                        }
                    },
                );
            }
            let value = select {
                recv(results) as value => value,
                recv(scope.token().done()) as _ => Option::None,
            };
            scope.cancel();
            value
        },
    )
}
