package math;

use module::math::bits;

const FOUR_OVER_PI: [u64; 20] = [
    0x0000000000000001,
    0x45f306dc9c882a53,
    0xf84eafa3ea69bb81,
    0xb6c52b3278872083,
    0xfca2c757bd778ac3,
    0x6e48dc74849ba5c0,
    0x0c925dd413a32439,
    0xfc3bd63962534e7d,
    0xd1046bea5d768909,
    0xd338e04d68befc82,
    0x7323ac7306a673e9,
    0x3908bf177bf25076,
    0x3ff12fffbc0b301f,
    0xde5e2316b414da3e,
    0xda6cfd9e4f96136e,
    0x9e8c7ecd3cbfd45a,
    0xea4f758fd7cbe2f6,
    0x7a0e73ef14a525d4,
    0xd7f6bf623f1aba10,
    0xac06608df8f6d757,
];

fn reduce_large_angle(value: f64) -> (u64, f64) {
    let representation = value.to_bits();
    let exponent = ((representation >> 52) & 0x7ff).to_isize() - 1075;
    let significand = (representation & FRACTION_MASK) | (1 << 52);
    let digit = (exponent + 61) / 64;
    let shift = ((exponent + 61) % 64).to_u64();
    let first = (FOUR_OVER_PI[digit] << shift) | (FOUR_OVER_PI[digit + 1] >> (64 - shift));
    let second = (FOUR_OVER_PI[digit + 1] << shift) | (FOUR_OVER_PI[digit + 2] >> (64 - shift));
    let third = (FOUR_OVER_PI[digit + 2] << shift) | (FOUR_OVER_PI[digit + 3] >> (64 - shift));
    let (third_high, _) = bits::mul64(third, significand);
    let (second_high, second_low) = bits::mul64(second, significand);
    let first_low = first * significand;
    let (low, carry) = bits::add64(second_low, third_high, false);
    let (high, _) = bits::add64(first_low, second_high, carry);
    let mut octant = high >> 61;
    let high = (high << 3) | (low >> 61);
    let leading = bits::leading_zeros64(high).to_u64();
    let exponent = 1023 - (leading + 1);
    let significand = ((high << (leading + 1)) | (low >> (64 - (leading + 1)))) >> 12;
    let mut fraction = float64_from_bits(significand | (exponent << 52));
    if octant & 1 == 1 {
        octant = (octant + 1) & 7;
        fraction -= 1.0;
    };
    (octant, fraction * (PI / 4.0))
}

fn reduce_angle(value: f64) -> (u64, f64) {
    if value >= 536870912.0 {
        return reduce_large_angle(value)
    }
    let mut octant = integer_magnitude(value * (4.0 / PI));
    if octant & 1 == 1 {
        octant += 1;
    }
    let integral = small_integer_float(octant.to_isize());
    let reduced = ((value - integral * 7.85398125648498535156e-1)
        - integral * 3.77489470793079817668e-8)
        - integral * 2.69515142907905952645e-15;
    (octant & 7, reduced)
}

fn sin_reduced(value: f64) -> f64 {
    let square = value * value;
    value
        + value * square
            * (((((1.58962301576546568060e-10 * square - 2.50507477628578072866e-8) * square
                + 2.75573136213857245213e-6)
                * square
                - 1.98412698295895385996e-4)
                * square
                + 8.33333333332211858878e-3)
                * square
                - 1.66666666666666307295e-1)
}

fn cos_reduced(value: f64) -> f64 {
    let square = value * value;
    1.0 - 0.5 * square
        + square * square
            * (((((-1.13585365213876817300e-11 * square + 2.08757008419747316778e-9) * square
                - 2.75573141792967388112e-7)
                * square
                + 2.48015872888517045348e-5)
                * square
                - 1.38888888888730564116e-3)
                * square
                + 4.16666666666665929218e-2)
}

pub fn sin(value: f64) -> f64 {
    if value == 0.0 || is_nan(value) {
        return value
    }
    if is_infinite(value) {
        return nan()
    }
    let (octant, reduced) = reduce_angle(magnitude(value));
    let mut sign = negative(value);
    let mut octant = octant;
    if octant > 3 {
        sign = !sign;
        octant -= 4;
    }
    let result = if octant == 1 || octant == 2 {
        cos_reduced(reduced)
    } else {
        sin_reduced(reduced)
    };
    if sign {
        -result
    } else {
        result
    }
}

pub fn cos(value: f64) -> f64 {
    if !is_finite(value) {
        return nan()
    }
    let (octant, reduced) = reduce_angle(magnitude(value));
    let mut sign = false;
    let mut octant = octant;
    if octant > 3 {
        sign = !sign;
        octant -= 4;
    }
    if octant > 1 {
        sign = !sign;
    }
    let result = if octant == 1 || octant == 2 {
        sin_reduced(reduced)
    } else {
        cos_reduced(reduced)
    };
    if sign {
        -result
    } else {
        result
    }
}

pub fn tan(value: f64) -> f64 {
    if value == 0.0 || is_nan(value) {
        return value
    }
    if is_infinite(value) {
        return nan()
    }
    let (octant, reduced) = reduce_angle(magnitude(value));
    let square = reduced * reduced;
    let mut result = if square > 1e-14 {
        reduced
            + reduced
                * (square
                    * ((-1.30936939181383777646e4 * square + 1.15351664838587416140e6) * square
                        - 1.79565251976484877988e7)
                    / ((((square + 1.36812963470692954678e4) * square - 1.32089234440210967447e6)
                        * square
                        + 2.50083801823357915839e7)
                        * square
                        - 5.38695755929454629881e7))
    } else {
        reduced
    };
    if octant & 2 == 2 {
        result = -1.0 / result;
    }
    if negative(value) {
        -result
    } else {
        result
    }
}
