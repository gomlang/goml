package tests;

use std::math;
use std::testing;

fn assert_close64(actual: f64, expected: u64, tolerance: u64) -> () {
    let bits = actual.to_bits();
    let difference = if bits >= expected {
        bits - expected
    } else {
        expected - bits
    };
    if difference > tolerance {
        testing::fail(
            "floating-point result exceeds ULP tolerance: actual=" + bits.to_string()
                + ", expected="
                + expected.to_string()
                + ", difference="
                + difference.to_string(),
        );
    }
}

#[test]
fn elementary_known_answers() -> () {
    assert_close64(math::sqrt(float64_from_bits(0x0000000000000000)), 0x0000000000000000, 0);
    assert_close64(math::log(float64_from_bits(0x0000000000000000)), 0xfff0000000000000, 0);
    assert_close64(math::sqrt(float64_from_bits(0x8000000000000000)), 0x8000000000000000, 0);
    assert_close64(math::log(float64_from_bits(0x8000000000000000)), 0xfff0000000000000, 0);
    assert_close64(math::sqrt(float64_from_bits(0x0000000000000001)), 0x1e60000000000000, 0);
    assert_close64(math::log(float64_from_bits(0x0000000000000001)), 0xc0874385446d71c3, 2);
    assert_close64(math::sqrt(float64_from_bits(0x000fffffffffffff)), 0x1fffffffffffffff, 0);
    assert_close64(math::log(float64_from_bits(0x000fffffffffffff)), 0xc086232bdd7abcd2, 2);
    assert_close64(math::sqrt(float64_from_bits(0x0010000000000000)), 0x2000000000000000, 0);
    assert_close64(math::log(float64_from_bits(0x0010000000000000)), 0xc086232bdd7abcd2, 2);
    assert_close64(math::sqrt(float64_from_bits(0x3ff0000000000000)), 0x3ff0000000000000, 0);
    assert_close64(math::log(float64_from_bits(0x3ff0000000000000)), 0x0000000000000000, 0);
    assert_close64(math::sqrt(float64_from_bits(0x3fefffffffffffff)), 0x3fefffffffffffff, 0);
    assert_close64(math::log(float64_from_bits(0x3fefffffffffffff)), 0xbca0000000000000, 2);
    assert_close64(math::sqrt(float64_from_bits(0x3ff0000000000001)), 0x3ff0000000000000, 0);
    assert_close64(math::log(float64_from_bits(0x3ff0000000000001)), 0x3cafffffffffffff, 2);
    assert_close64(math::sqrt(float64_from_bits(0x4000000000000000)), 0x3ff6a09e667f3bcd, 0);
    assert_close64(math::log(float64_from_bits(0x4000000000000000)), 0x3fe62e42fefa39ef, 2);
    assert_close64(math::sqrt(float64_from_bits(0x7fefffffffffffff)), 0x5fefffffffffffff, 0);
    assert_close64(math::log(float64_from_bits(0x7fefffffffffffff)), 0x40862e42fefa39ef, 2);
    assert_close64(math::exp(float64_from_bits(0x8000000000000001)), 0x3ff0000000000000, 2);
    assert_close64(math::exp(float64_from_bits(0x0000000000000001)), 0x3ff0000000000000, 2);
    assert_close64(math::exp(float64_from_bits(0x3ff0000000000000)), 0x4005bf0a8b145769, 2);
    assert_close64(math::exp(float64_from_bits(0xbff0000000000000)), 0x3fd78b56362cef38, 2);
    assert_close64(math::exp(float64_from_bits(0x4086280000000000)), 0x7fdd422d2be5dc9b, 2);
    assert_close64(math::exp(float64_from_bits(0x40862e42fefa39ef)), 0x7fefffffffffff2a, 2);
    assert_close64(math::exp(float64_from_bits(0x40862e42fefa39f0)), 0x7ff0000000000000, 0);
    assert_close64(math::exp(float64_from_bits(0xc086240000000000)), 0x000e6cf6d08897ac, 2);
    assert_close64(math::exp(float64_from_bits(0xc087400000000000)), 0x0000000000000002, 0);
    assert_close64(math::exp(float64_from_bits(0xc087480000000000)), 0x0000000000000001, 0);
    assert_close64(math::exp(float64_from_bits(0xc0874910d52d3051)), 0x0000000000000001, 0);
    assert_close64(math::exp(float64_from_bits(0xc0874910d52d3052)), 0x0000000000000000, 0);
}

#[test]
fn trigonometric_large_angles_and_poles() -> () {
    let cases: [(u64, u64, u64, u64); 13] = [
        (0x0000000000000001, 0x0000000000000001, 0x3ff0000000000000, 0x0000000000000001),
        (0x3ff921fb54442d18, 0x3ff0000000000000, 0x3c91a62633145c00, 0x434d02967c31cdc0),
        (0x3ff921fb54442d17, 0x3ff0000000000000, 0x3cb469898cc51700, 0x4329153d9443ed0d),
        (0x3ff921fb54442d19, 0x3ff0000000000000, 0xbca72cece675d200, 0xc33617a154947677),
        (0x41bfffffffffffff, 0x3fd4e67c4aa3dd2f, 0xbfee3edd238bb17a, 0xbfd61cd928a38268),
        (0x41c0000000000000, 0x3fd4e67c0e2622df, 0xbfee3edd2dfeef90, 0xbfd61cd8e0ffa035),
        (0x41c0000000000001, 0x3fd4e67b952aadfe, 0xbfee3edd42e56b61, 0xbfd61cd851b7dc63),
        (0x4360000000000000, 0xbfe958b4e2e20661, 0xbfe3888e17e3c374, 0x3ff4c2f55b092bf2),
        (0x4760000000000000, 0xbfef66c46194bbb7, 0xbfc8a43363cfc082, 0x401463ae1d527340),
        (0x4415af1d78b58c40, 0xbfe4a5e605fd6450, 0x3fe872720fc60d3e, 0xbfeb06fbbe995392),
        (0x54b249ad2594c37d, 0xbfd85c5e5b929359, 0x3fed9757496841f5, 0xbfda5807d6f76f7d),
        (0x7fefffffffffffff, 0x3f7452fc98b34eb0, 0xbfefffe62ecfab75, 0xbf74530cfe72949d),
        (0xffefffffffffffff, 0xbf7452fc98b34eb0, 0xbfefffe62ecfab75, 0x3f74530cfe72949d),
    ];
    for (input, sine, cosine, tangent) in cases {
        let value = float64_from_bits(input);
        let tolerance: u64 = if input == 1 {
            0
        } else {
            2
        };
        assert_close64(math::sin(value), sine, tolerance);
        assert_close64(math::cos(value), cosine, tolerance);
        assert_close64(
            math::tan(value),
            tangent,
            if input == 1 {
                0
            } else {
                3
            },
        );
        testing::assert_eq(
            math::sin(-value).to_bits(),
            math::sin(value).to_bits() ^ 0x8000000000000000,
        );
        testing::assert_eq(math::cos(-value).to_bits(), math::cos(value).to_bits());
        testing::assert_eq(
            math::tan(-value).to_bits(),
            math::tan(value).to_bits() ^ 0x8000000000000000,
        );
    }
}

#[test]
fn powers_preserve_special_values_and_extreme_exponents() -> () {
    let negative_zero = float64_from_bits(0x8000000000000000);
    let infinity = float64_from_bits(0x7ff0000000000000);
    let nan = float64_from_bits(0x7ff8000000000001);
    testing::assert_eq(math::pow(nan, 0.0), 1.0);
    testing::assert_eq(math::pow(1.0, nan), 1.0);
    testing::assert_eq(math::pow(-1.0, infinity), 1.0);
    testing::assert_eq(math::pow(-1.0, -infinity), 1.0);
    testing::assert_eq(math::pow(negative_zero, -3.0), -infinity);
    testing::assert_eq(math::pow(negative_zero, 3.0).to_bits(), negative_zero.to_bits());
    testing::assert_eq(math::pow(negative_zero, 2.0).to_bits(), 0);
    testing::assert_eq(math::pow(negative_zero, -2.0), infinity);
    testing::assert_eq(math::pow(-infinity, -3.0).to_bits(), negative_zero.to_bits());
    testing::assert_eq(math::pow(-infinity, 3.0), -infinity);
    testing::assert_eq(math::pow(-infinity, 0.5), infinity);
    testing::assert_eq(math::pow(-infinity, -0.5).to_bits(), 0);
    testing::assert_eq(math::pow(2.0, -1074.0).to_bits(), 1);
    testing::assert_eq(math::pow(2.0, -1075.0).to_bits(), 0);
    testing::assert_eq(math::pow(-2.0, -1075.0).to_bits(), negative_zero.to_bits());
    testing::assert_eq(math::pow(-2.0, 1023.0).to_bits(), 0xffe0000000000000);
    testing::assert_eq(math::pow(-1.0, 9007199254740991.0), -1.0);
    testing::assert_eq(math::pow(-1.0, 9007199254740992.0), 1.0);
    testing::assert_eq(math::pow(-1.0, 9223372036854775808.0), 1.0);
    testing::assert_eq(math::pow(0.5, infinity).to_bits(), 0);
    testing::assert_eq(math::pow(0.5, -infinity), infinity);
    testing::assert_eq(math::pow(2.0, infinity), infinity);
    testing::assert_eq(math::pow(2.0, -infinity).to_bits(), 0);
    testing::assert(math::is_nan(math::pow(-2.0, 0.25)));
    testing::assert(math::is_nan(math::pow(-2.0, 0.5)));
    testing::assert(math::is_nan(math::pow(nan, 2.0)));
    testing::assert(math::is_nan(math::pow(2.0, nan)));
    assert_close64(
        math::pow(float64_from_bits(0x3ff0000000000001), 4503599627370496.0),
        0x4005bf0a8b145769,
        2,
    );
    assert_close64(
        math::pow(float64_from_bits(0x3fefffffffffffff), 9007199254740992.0),
        0x3fd78b56362cef37,
        2,
    );
    assert_close64(math::pow(float64_from_bits(1), 0.5), 0x1e60000000000000, 0);
}

#[test]
fn rounding_classification_and_signed_zero() -> () {
    let negative_zero = float64_from_bits(0x8000000000000000);
    let infinity = float64_from_bits(0x7ff0000000000000);
    let nan = float64_from_bits(0x7ff8000000000001);
    for value in[0.0, negative_zero] {
        testing::assert_eq(math::sqrt(value).to_bits(), value.to_bits());
        testing::assert_eq(math::sin(value).to_bits(), value.to_bits());
        testing::assert_eq(math::tan(value).to_bits(), value.to_bits());
        testing::assert_eq(math::floor(value).to_bits(), value.to_bits());
        testing::assert_eq(math::ceil(value).to_bits(), value.to_bits());
        testing::assert_eq(math::round(value).to_bits(), value.to_bits());
        testing::assert_eq(math::trunc(value).to_bits(), value.to_bits());
        testing::assert_eq(math::cos(value), 1.0);
        testing::assert_eq(math::exp(value), 1.0);
        testing::assert_eq(math::log(value), -infinity);
        testing::assert(math::is_finite(value));
        testing::assert(!math::is_normal(value));
        testing::assert(!math::is_subnormal(value));
    }
    for value in[infinity, -infinity] {
        testing::assert(math::is_infinite(value));
        testing::assert(!math::is_finite(value));
        testing::assert(!math::is_normal(value));
        testing::assert(!math::is_subnormal(value));
        testing::assert(math::is_nan(math::sin(value)));
        testing::assert(math::is_nan(math::cos(value)));
        testing::assert(math::is_nan(math::tan(value)));
        testing::assert_eq(math::floor(value), value);
        testing::assert_eq(math::ceil(value), value);
        testing::assert_eq(math::round(value), value);
        testing::assert_eq(math::trunc(value), value);
    }
    testing::assert_eq(math::exp(-infinity).to_bits(), 0);
    testing::assert_eq(math::exp(infinity), infinity);
    testing::assert_eq(math::sqrt(infinity), infinity);
    testing::assert_eq(math::log(infinity), infinity);
    testing::assert(math::is_nan(math::sqrt(-infinity)));
    testing::assert(math::is_nan(math::log(-infinity)));
    testing::assert(math::is_nan(math::sqrt(-1.0)));
    testing::assert(math::is_nan(math::log(-1.0)));
    for result in[
        math::sqrt(nan),
        math::exp(nan),
        math::log(nan),
        math::sin(nan),
        math::cos(nan),
        math::tan(nan),
        math::floor(nan),
        math::ceil(nan),
        math::round(nan),
        math::trunc(nan),
    ] {
        testing::assert(math::is_nan(result));
        testing::assert(!math::is_finite(result));
        testing::assert(!math::is_normal(result));
        testing::assert(!math::is_subnormal(result));
        testing::assert(!math::is_infinite(result));
    }
    for bits in[1.to_u64(), 0x000fffffffffffff, 0x8000000000000001, 0x800fffffffffffff] {
        testing::assert(math::is_subnormal(float64_from_bits(bits)));
        testing::assert(!math::is_normal(float64_from_bits(bits)));
        testing::assert(math::is_finite(float64_from_bits(bits)));
    }
    for bits in[
        0x0010000000000000.to_u64(),
        0x7fefffffffffffff,
        0x8010000000000000,
        0xffefffffffffffff,
    ] {
        testing::assert(math::is_normal(float64_from_bits(bits)));
        testing::assert(!math::is_subnormal(float64_from_bits(bits)));
    }
    testing::assert_eq(math::round(0.5), 1.0);
    testing::assert_eq(math::round(-0.5), -1.0);
    testing::assert_eq(math::round(float64_from_bits(0x3fdfffffffffffff)).to_bits(), 0);
    testing::assert_eq(
        math::round(float64_from_bits(0xbfdfffffffffffff)).to_bits(),
        negative_zero.to_bits(),
    );
    testing::assert_eq(
        math::round(float64_from_bits(0x4330000000000001)).to_bits(),
        0x4330000000000001,
    );
    testing::assert_eq(math::floor(-0.1), -1.0);
    testing::assert_eq(math::ceil(-0.1).to_bits(), negative_zero.to_bits());
    testing::assert_eq(math::trunc(-0.1).to_bits(), negative_zero.to_bits());
    testing::assert_eq(math::floor(float64_from_bits(1)).to_bits(), 0);
    testing::assert_eq(math::ceil(float64_from_bits(1)), 1.0);
    testing::assert_eq(math::floor(-float64_from_bits(1)), -1.0);
    testing::assert_eq(math::ceil(-float64_from_bits(1)).to_bits(), negative_zero.to_bits());
}

#[test]
fn single_precision_extremes() -> () {
    let smallest = float32_from_bits(1);
    let maximum = float32_from_bits(0x7f7fffff);
    let negative_zero = float32_from_bits(0x80000000);
    let infinity = float32_from_bits(0x7f800000);
    let nan = float32_from_bits(0x7fc00001);
    testing::assert_eq(math::sqrt32(smallest).to_bits(), 0x1a3504f3);
    testing::assert_eq(math::log32(smallest).to_bits(), 0xc2ce8ed0);
    testing::assert_eq(math::sin32(smallest).to_bits(), 1);
    testing::assert_eq(math::tan32(smallest).to_bits(), 1);
    testing::assert_eq(math::cos32(smallest).to_bits(), 0x3f800000);
    testing::assert_eq(math::sqrt32(maximum).to_bits(), 0x5f7fffff);
    testing::assert_eq(math::log32(maximum).to_bits(), 0x42b17218);
    testing::assert_eq(math::sin32(maximum).to_bits(), 0xbf0599b3);
    testing::assert_eq(math::cos32(maximum).to_bits(), 0x3f5a5f96);
    testing::assert_eq(math::tan32(maximum).to_bits(), 0xbf1c9eca);
    testing::assert_eq(math::exp32(float32_from_bits(0xc2cfcccd)).to_bits(), 1);
    testing::assert_eq(math::exp32(maximum), infinity);
    testing::assert_eq(math::pow32(2.0, -149.0).to_bits(), 1);
    testing::assert_eq(math::pow32(2.0, -150.0).to_bits(), 0);
    testing::assert_eq(math::sqrt32(negative_zero).to_bits(), negative_zero.to_bits());
    testing::assert_eq(math::sin32(negative_zero).to_bits(), negative_zero.to_bits());
    testing::assert_eq(math::tan32(negative_zero).to_bits(), negative_zero.to_bits());
    testing::assert_eq(math::floor32(negative_zero).to_bits(), negative_zero.to_bits());
    testing::assert_eq(math::ceil32(negative_zero).to_bits(), negative_zero.to_bits());
    testing::assert_eq(math::round32(negative_zero).to_bits(), negative_zero.to_bits());
    testing::assert_eq(math::trunc32(negative_zero).to_bits(), negative_zero.to_bits());
    testing::assert_eq(math::round32(-0.5), -1.0);
    testing::assert_eq(math::floor32(-0.1), -1.0);
    testing::assert_eq(math::ceil32(-0.1).to_bits(), negative_zero.to_bits());
    testing::assert_eq(math::trunc32(-0.1).to_bits(), negative_zero.to_bits());
    testing::assert(math::is_subnormal32(smallest));
    testing::assert(!math::is_normal32(smallest));
    testing::assert(math::is_normal32(float32_from_bits(0x00800000)));
    testing::assert(math::is_normal32(maximum));
    testing::assert(math::is_finite32(maximum));
    testing::assert(math::is_nan32(nan));
    testing::assert(!math::is_finite32(nan));
    testing::assert(math::is_infinite32(infinity));
    testing::assert(!math::is_finite32(infinity));
    testing::assert(math::is_nan32(math::sqrt32(-1.0)));
    testing::assert(math::is_nan32(math::log32(-1.0)));
    testing::assert(math::is_nan32(math::sin32(infinity)));
    testing::assert(math::is_nan32(math::cos32(infinity)));
    testing::assert(math::is_nan32(math::tan32(infinity)));
}
