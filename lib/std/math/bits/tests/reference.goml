package tests;

fn reference_bits_count(value: u64) -> isize {
    let mut result = 0;
    for bit in 0..64 {
        result += ((value >> bit) & 1).to_isize();
    }
    result
}

fn reference_bits_len(value: u64) -> isize {
    let mut remaining = value;
    let mut result = 0;
    while remaining != 0 {
        remaining /= 2;
        result += 1;
    }
    result
}

fn reference_bits_leading(value: u64) -> isize {
    64 - reference_bits_len(value)
}

fn reference_bits_trailing(value: u64) -> isize {
    for bit in 0..64 {
        if value & (1.to_u64() << bit) != 0 {
            return bit
        }
    }
    64
}

fn reference_bits_rotate_width(value: u64, count: isize, width: isize) -> u64 {
    let mut result: u64 = 0;
    for bit in 0..width {
        if value & (1.to_u64() << bit) != 0 {
            result = result | (1.to_u64() << ((bit + (count & (width - 1))) % width));
        }
    }
    result
}

fn reference_bits_rotate(value: u64, count: isize) -> u64 {
    reference_bits_rotate_width(value, count, 64)
}

fn reference_rotate8(value: u8, count: isize) -> u8 {
    reference_bits_rotate_width(value.to_u64(), count, 8).to_u8()
}

fn reference_rotate16(value: u16, count: isize) -> u16 {
    reference_bits_rotate_width(value.to_u64(), count, 16).to_u16()
}

fn reference_rotate32(value: u32, count: isize) -> u32 {
    reference_bits_rotate_width(value.to_u64(), count, 32).to_u32()
}

fn reference_bits_reverse(value: u64) -> u64 {
    let mut result: u64 = 0;
    for bit in 0..64 {
        result = (result << 1) | ((value >> bit) & 1);
    }
    result
}

fn reference_bits_reverse_bytes(value: u64) -> u64 {
    let mut result: u64 = 0;
    for index in 0..8 {
        result = (result << 8) | ((value >> (index * 8)) & 255);
    }
    result
}

fn reference_bits_add(left: u64, right: u64, carry: u64) -> (u64, u64) {
    let mut result: u64 = 0;
    let mut pending = carry;
    for index in 0..8 {
        let digit = ((left >> (8 * index)) & 255) + ((right >> (8 * index)) & 255) + pending;
        result = result | ((digit & 255) << (8 * index));
        pending = digit / 256;
    }
    return (result, pending)
}

fn reference_bits_sub(left: u64, right: u64, borrow: u64) -> (u64, u64) {
    let mut result: u64 = 0;
    let mut pending = borrow.to_isize();
    for index in 0..8 {
        let digit = ((left >> (8 * index)) & 255).to_isize()
            - ((right >> (8 * index)) & 255).to_isize()
            - pending;
        result = result | ((digit & 255).to_u64() << (8 * index));
        pending = if digit < 0 {
            1
        } else {
            0
        };
    }
    return (result, pending.to_u64())
}

fn reference_bits_mul(left: u64, right: u64) -> (u64, u64) {
    let digits: Vec[u64] = Vec::new();
    for _ in 0..16 {
        digits.push(0);
    }
    for a in 0..8 {
        for b in 0..8 {
            digits[a + b] += ((left >> (a * 8)) & 255) * ((right >> (b * 8)) & 255);
        }
    }
    for index in 0..15 {
        digits[index + 1] += digits[index] / 256;
        digits[index] %= 256;
    }
    let mut low: u64 = 0;
    let mut high: u64 = 0;
    for index in 0..8 {
        low = low | (digits[index] << (index * 8));
        high = high | (digits[index + 8] << (index * 8));
    }
    return (high, low)
}

fn reference_bits_div(high: u64, low: u64, divisor: u64) -> (u64, u64) {
    let mut remainder = high % divisor;
    let mut quotient: u64 = 0;
    for index in 0..64 {
        let overflow = remainder >> 63 != 0;
        remainder = (remainder << 1) | ((low >> (63 - index)) & 1);
        quotient <<= 1;
        if overflow || remainder >= divisor {
            remainder -= divisor;
            quotient = quotient | 1;
        }
    }
    return (quotient, remainder)
}

fn reference_bits_rem(high: u64, low: u64, divisor: u64) -> u64 {
    reference_bits_div(high, low, divisor).1
}

fn reference_div32(high: u32, low: u32, divisor: u32) -> (u32, u32) {
    let value = (high.to_u64() << 32) | low.to_u64();
    ((value / divisor.to_u64()).to_u32(), (value % divisor.to_u64()).to_u32())
}

fn reference_rem32(high: u32, low: u32, divisor: u32) -> u32 {
    reference_div32(high, low, divisor).1
}
