package tests;

use std::math::bits;
use std::rand;
use std::testing;

fn check_wide_division(high: u64, low: u64, divisor: u64) -> () {
    if divisor == 0 {
        assert_equal(
            testing::expect_err(bits::div64(high, low, divisor), "zero division64"),
            bits::DivisionError::DivisionByZero,
        );
        assert_equal(
            testing::expect_err(bits::rem64(high, low, divisor), "zero remainder64"),
            bits::DivisionError::DivisionByZero,
        );
    } else {
        if high >= divisor {
            assert_equal(
                testing::expect_err(bits::div64(high, low, divisor), "overflow64"),
                bits::DivisionError::Overflow,
            );
        } else {
            let actual = testing::expect_ok(bits::div64(high, low, divisor), "division64");
            assert_equal(actual, reference_bits_div(high, low, divisor));
            let (quotient, remainder) = actual;
            testing::assert(remainder < divisor);
            let (product_high, product_low) = bits::mul64(quotient, divisor);
            let (sum_low, carry) = bits::add64(product_low, remainder, false);
            let (sum_high, overflow) = bits::add64(product_high, 0, carry);
            assert_equal((sum_high, sum_low), (high, low));
            testing::assert(!overflow);
        }
        assert_equal(
            testing::expect_ok(bits::rem64(high, low, divisor), "remainder64"),
            reference_bits_rem(high, low, divisor),
        );
    }
    let high32 = high.to_u32();
    let low32 = low.to_u32();
    let divisor32 = divisor.to_u32();
    if divisor32 == 0 {
        assert_equal(
            testing::expect_err(bits::div32(high32, low32, divisor32), "zero division32"),
            bits::DivisionError::DivisionByZero,
        );
        assert_equal(
            testing::expect_err(bits::rem32(high32, low32, divisor32), "zero remainder32"),
            bits::DivisionError::DivisionByZero,
        );
    } else {
        if high32 >= divisor32 {
            assert_equal(
                testing::expect_err(bits::div32(high32, low32, divisor32), "overflow32"),
                bits::DivisionError::Overflow,
            );
        } else {
            assert_equal(
                testing::expect_ok(bits::div32(high32, low32, divisor32), "division32"),
                reference_div32(high32, low32, divisor32),
            );
        }
        assert_equal(
            testing::expect_ok(bits::rem32(high32, low32, divisor32), "remainder32"),
            reference_rem32(high32, low32, divisor32),
        );
    }
}

fn check_bit_boundaries() -> () {
    let shifts = Vec::from_array(
        [
            -9223372036854775807 - 1,
            -257,
            -65,
            -33,
            -17,
            -9,
            -1,
            0,
            1,
            8,
            16,
            32,
            64,
            257,
            9223372036854775807,
        ],
    );
    for index in 0..65536 {
        let value = index.to_u16();
        let wide = value.to_u64();
        assert_equal(bits::ones_count16(value), reference_bits_count(wide));
        assert_equal(bits::len16(value), reference_bits_len(wide));
        assert_equal(bits::leading_zeros16(value), reference_bits_leading(wide) - 48);
        assert_equal(
            bits::trailing_zeros16(value),
            if value == 0 {
                16
            } else {
                reference_bits_trailing(wide)
            },
        );
        assert_equal(bits::reverse16(value), (reference_bits_reverse(wide) >> 48).to_u16());
        assert_equal(
            bits::reverse_bytes16(value),
            (reference_bits_reverse_bytes(wide) >> 48).to_u16(),
        );
        for shift in shifts {
            assert_equal(bits::rotate_left16(value, shift), reference_rotate16(value, shift));
            if index < 256 {
                assert_equal(
                    bits::rotate_left8(value.to_u8(), shift),
                    reference_rotate8(value.to_u8(), shift),
                );
            }
        }
    }
    let maximum: u64 = 18446744073709551615;
    for index in 0..64 {
        let power = 1.to_u64() << index;
        for left in[power - 1, power, power + 1] {
            for right in[0.to_u64(), 1, power - 1, power, power + 1, maximum] {
                check_bit_word(left, right);
            }
            for shift in shifts {
                assert_equal(
                    bits::rotate_left32(left.to_u32(), shift),
                    reference_rotate32(left.to_u32(), shift),
                );
                assert_equal(bits::rotate_left64(left, shift), reference_bits_rotate(left, shift));
            }
        }
        for divisor in[power - 1, power, power + 1, maximum] {
            for high in[0.to_u64(), divisor - 1, divisor, maximum] {
                for low in[0.to_u64(), 1, divisor - 1, maximum] {
                    check_wide_division(high, low, divisor);
                }
            }
        }
    }
    for index in 0..2048 {
        let high = rand::next_u64(index.to_u64());
        let low = rand::next_u64(index.to_u64() + 8000);
        let divisor = rand::next_u64(index.to_u64() + 16000);
        check_wide_division(high, low, divisor);
        if divisor != 0 {
            check_wide_division(high % divisor, low, divisor);
        }
    }
}
