package bits;

pub enum DivisionError {
    DivisionByZero,
    Overflow,
}

impl Debug for DivisionError {
    fn debug(self: DivisionError) -> string {
        self.to_string()
    }
}

impl PartialEq for DivisionError {
    fn eq(self: DivisionError, other: DivisionError) -> bool {
        match (self, other) {
            (DivisionError::DivisionByZero, DivisionError::DivisionByZero) => true,
            (DivisionError::Overflow, DivisionError::Overflow) => true,
            _ => false,
        }
    }
}

impl Eq for DivisionError {}

impl ToString for DivisionError {
    fn to_string(self: DivisionError) -> string {
        match self {
            DivisionError::DivisionByZero => "integer division by zero",
            DivisionError::Overflow => "integer quotient overflows its word width",
        }
    }
}

pub fn ones_count64(value: u64) -> isize {
    let mut remaining = value;
    let mut count = 0;
    while remaining != 0 {
        remaining = remaining & (remaining - 1);
        count += 1;
    }
    count
}

pub fn len64(value: u64) -> isize {
    let mut remaining = value;
    let mut count = 0;
    while remaining != 0 {
        remaining = remaining >> 1;
        count += 1;
    }
    count
}

pub fn leading_zeros64(value: u64) -> isize {
    64 - len64(value)
}

pub fn trailing_zeros64(value: u64) -> isize {
    if value == 0 {
        return 64
    }
    let mut remaining = value;
    let mut count = 0;
    while remaining & 1 == 0 {
        remaining = remaining >> 1;
        count += 1;
    }
    count
}

pub fn rotate_left64(value: u64, count: isize) -> u64 {
    let shift = count & 63;
    if shift == 0 {
        value
    } else {
        (value << shift) | (value >> (64 - shift))
    }
}

pub fn reverse64(value: u64) -> u64 {
    let mut remaining = value;
    let mut result: u64 = 0;
    for _ in 0..64 {
        result = (result << 1) | (remaining & 1);
        remaining = remaining >> 1;
    }
    result
}

pub fn reverse_bytes64(value: u64) -> u64 {
    let mut remaining = value;
    let mut result: u64 = 0;
    for _ in 0..8 {
        result = (result << 8) | (remaining & 255);
        remaining = remaining >> 8;
    }
    result
}

pub fn add64(left: u64, right: u64, carry: bool) -> (u64, bool) {
    let sum = left + right;
    let result = sum
        + if carry {
            1
        } else {
            0
        };
    (result, sum < left || result < sum)
}

pub fn sub64(left: u64, right: u64, borrow: bool) -> (u64, bool) {
    let difference = left - right;
    let result = difference
        - if borrow {
            1
        } else {
            0
        };
    (result, left < right || (borrow && difference == 0))
}

pub fn mul64(left: u64, right: u64) -> (u64, u64) {
    let low_left = left & 0xffffffff;
    let low_right = right & 0xffffffff;
    let high_left = left >> 32;
    let high_right = right >> 32;
    let low_product = low_left * low_right;
    let middle = high_left * low_right + (low_product >> 32);
    let upper = middle >> 32;
    let lower = low_left * high_right + (middle & 0xffffffff);
    (high_left * high_right + upper + (lower >> 32), (lower << 32) | (low_product & 0xffffffff))
}

pub fn div64(high: u64, low: u64, divisor: u64) -> Result[(u64, u64), DivisionError] {
    if divisor == 0 {
        return Result::Err(DivisionError::DivisionByZero)
    }
    if high >= divisor {
        return Result::Err(DivisionError::Overflow)
    }
    let mut remainder = high;
    let mut quotient: u64 = 0;
    let mut index = 64;
    while index > 0 {
        index -= 1;
        let carry = remainder >> 63;
        remainder = (remainder << 1) | ((low >> index) & 1);
        if carry != 0 || remainder >= divisor {
            remainder -= divisor;
            quotient = quotient | (1 << index);
        }
    }
    Result::Ok((quotient, remainder))
}

pub fn rem64(high: u64, low: u64, divisor: u64) -> Result[u64, DivisionError] {
    if divisor == 0 {
        return Result::Err(DivisionError::DivisionByZero)
    }
    let (_, remainder) = div64(high % divisor, low, divisor)?;
    Result::Ok(remainder)
}

pub fn add32(left: u32, right: u32, carry: bool) -> (u32, bool) {
    let sum = left.to_u64() + right.to_u64()
        + if carry {
            1
        } else {
            0
        };
    (sum.to_u32(), sum >> 32 != 0)
}

pub fn sub32(left: u32, right: u32, borrow: bool) -> (u32, bool) {
    let difference = left - right;
    (
        difference
            - if borrow {
                1
            } else {
                0
            },
        left < right || (borrow && difference == 0),
    )
}

pub fn mul32(left: u32, right: u32) -> (u32, u32) {
    let product = left.to_u64() * right.to_u64();
    ((product >> 32).to_u32(), product.to_u32())
}

pub fn div32(high: u32, low: u32, divisor: u32) -> Result[(u32, u32), DivisionError] {
    if divisor == 0 {
        return Result::Err(DivisionError::DivisionByZero)
    }
    if high >= divisor {
        return Result::Err(DivisionError::Overflow)
    }
    let dividend = (high.to_u64() << 32) | low.to_u64();
    Result::Ok(((dividend / divisor.to_u64()).to_u32(), (dividend % divisor.to_u64()).to_u32()))
}

pub fn rem32(high: u32, low: u32, divisor: u32) -> Result[u32, DivisionError] {
    if divisor == 0 {
        Result::Err(DivisionError::DivisionByZero)
    } else {
        Result::Ok((((high.to_u64() << 32) | low.to_u64()) % divisor.to_u64()).to_u32())
    }
}
