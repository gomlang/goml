package bits;

pub fn ones_count8(value: u8) -> isize {
    ones_count64(value.to_u64())
}

pub fn len8(value: u8) -> isize {
    len64(value.to_u64())
}

pub fn leading_zeros8(value: u8) -> isize {
    8 - len8(value)
}

pub fn trailing_zeros8(value: u8) -> isize {
    if value == 0 {
        8
    } else {
        trailing_zeros64(value.to_u64())
    }
}

pub fn rotate_left8(value: u8, count: isize) -> u8 {
    let shift = count & 7;
    if shift == 0 {
        value
    } else {
        (value << shift) | (value >> (8 - shift))
    }
}

pub fn reverse8(value: u8) -> u8 {
    (reverse64(value.to_u64()) >> 56).to_u8()
}

pub fn ones_count16(value: u16) -> isize {
    ones_count64(value.to_u64())
}

pub fn len16(value: u16) -> isize {
    len64(value.to_u64())
}

pub fn leading_zeros16(value: u16) -> isize {
    16 - len16(value)
}

pub fn trailing_zeros16(value: u16) -> isize {
    if value == 0 {
        16
    } else {
        trailing_zeros64(value.to_u64())
    }
}

pub fn rotate_left16(value: u16, count: isize) -> u16 {
    let shift = count & 15;
    if shift == 0 {
        value
    } else {
        (value << shift) | (value >> (16 - shift))
    }
}

pub fn reverse16(value: u16) -> u16 {
    (reverse64(value.to_u64()) >> 48).to_u16()
}

pub fn reverse_bytes16(value: u16) -> u16 {
    (reverse_bytes64(value.to_u64()) >> 48).to_u16()
}

pub fn ones_count32(value: u32) -> isize {
    ones_count64(value.to_u64())
}

pub fn len32(value: u32) -> isize {
    len64(value.to_u64())
}

pub fn leading_zeros32(value: u32) -> isize {
    32 - len32(value)
}

pub fn trailing_zeros32(value: u32) -> isize {
    if value == 0 {
        32
    } else {
        trailing_zeros64(value.to_u64())
    }
}

pub fn rotate_left32(value: u32, count: isize) -> u32 {
    let shift = count & 31;
    if shift == 0 {
        value
    } else {
        (value << shift) | (value >> (32 - shift))
    }
}

pub fn reverse32(value: u32) -> u32 {
    (reverse64(value.to_u64()) >> 32).to_u32()
}

pub fn reverse_bytes32(value: u32) -> u32 {
    (reverse_bytes64(value.to_u64()) >> 32).to_u32()
}
