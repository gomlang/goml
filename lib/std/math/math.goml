package math;

pub const E: f64 = 2.7182818284590452354;

pub const PI: f64 = 3.14159265358979323846;

pub const TAU: f64 = 6.28318530717958647692;

pub const SQRT_2: f64 = 1.4142135623730950488;

pub const LN_2: f64 = 0.69314718055994530942;

pub const LN_10: f64 = 2.30258509299404568402;

pub fn is_nan(value: f64) -> bool {
    value.to_bits() & 0x7fffffffffffffff > 0x7ff0000000000000
}

pub fn is_infinite(value: f64) -> bool {
    value.to_bits() & 0x7fffffffffffffff == 0x7ff0000000000000
}

pub fn is_finite(value: f64) -> bool {
    value.to_bits() & 0x7ff0000000000000 != 0x7ff0000000000000
}

pub fn is_normal(value: f64) -> bool {
    let exponent = value.to_bits() & 0x7ff0000000000000;
    exponent != 0 && exponent != 0x7ff0000000000000
}

pub fn is_subnormal(value: f64) -> bool {
    let bits = value.to_bits() & 0x7fffffffffffffff;
    bits != 0 && bits & 0x7ff0000000000000 == 0
}

pub fn sqrt32(value: f32) -> f32 {
    sqrt(value.to_f64()).to_f32()
}

pub fn pow32(value: f32, exponent: f32) -> f32 {
    pow(value.to_f64(), exponent.to_f64()).to_f32()
}

pub fn exp32(value: f32) -> f32 {
    exp(value.to_f64()).to_f32()
}

pub fn log32(value: f32) -> f32 {
    log(value.to_f64()).to_f32()
}

pub fn sin32(value: f32) -> f32 {
    sin(value.to_f64()).to_f32()
}

pub fn cos32(value: f32) -> f32 {
    cos(value.to_f64()).to_f32()
}

pub fn tan32(value: f32) -> f32 {
    tan(value.to_f64()).to_f32()
}

pub fn floor32(value: f32) -> f32 {
    floor(value.to_f64()).to_f32()
}

pub fn ceil32(value: f32) -> f32 {
    ceil(value.to_f64()).to_f32()
}

pub fn round32(value: f32) -> f32 {
    round(value.to_f64()).to_f32()
}

pub fn trunc32(value: f32) -> f32 {
    trunc(value.to_f64()).to_f32()
}

pub fn is_nan32(value: f32) -> bool {
    let bits = value.to_bits();
    bits & 0x7f800000 == 0x7f800000 && bits & 0x007fffff != 0
}

pub fn is_infinite32(value: f32) -> bool {
    value.to_bits() & 0x7fffffff == 0x7f800000
}

pub fn is_finite32(value: f32) -> bool {
    value.to_bits() & 0x7f800000 != 0x7f800000
}

pub fn is_normal32(value: f32) -> bool {
    let exponent = value.to_bits() & 0x7f800000;
    exponent != 0 && exponent != 0x7f800000
}

pub fn is_subnormal32(value: f32) -> bool {
    let bits = value.to_bits() & 0x7fffffff;
    bits != 0 && bits & 0x7f800000 == 0
}
