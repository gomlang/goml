package complex;

use module::math;

pub struct Complex {
    pub real: f64,
    pub imaginary: f64,
}

pub enum DivisionError {
    ZeroDivisor,
}

impl ToString for DivisionError {
    fn to_string(self: DivisionError) -> string {
        "complex divisor is zero"
    }
}

impl Debug for DivisionError {
    fn debug(self: DivisionError) -> string {
        self.to_string()
    }
}

impl PartialEq for Complex {
    fn eq(self: Complex, other: Complex) -> bool {
        self.real == other.real && self.imaginary == other.imaginary
    }
}

fn magnitude(value: f64) -> f64 {
    if value < 0.0 {
        -value
    } else {
        value
    }
}

fn negative(value: f64) -> bool {
    value.to_bits() >> 63 != 0
}

fn signed_infinity_unit(value: f64) -> f64 {
    if math::is_infinite(value) {
        if negative(value) {
            -1.0
        } else {
            1.0
        }
    } else {
        0.0
    }
}

fn arctangent(value: f64) -> f64 {
    if math::is_nan(value) {
        return value
    }
    if value < 0.0 {
        return -arctangent(-value)
    }
    if math::is_infinite(value) {
        return math::PI / 2.0
    }
    if value > 1.0 {
        return math::PI / 2.0 - arctangent(1.0 / value)
    }
    if value > 0.41421356237309503 {
        return math::PI / 4.0 + arctangent((value - 1.0) / (value + 1.0))
    }
    let square = value * value;
    let mut term = value;
    let mut sum = value;
    let mut index = 1;
    let mut denominator = 3.0;
    while index < 64 {
        term = -term * square;
        let next = sum + term / denominator;
        if next == sum {
            break
        }
        sum = next;
        index += 1;
        denominator += 2.0;
    }
    sum
}

pub fn atan2(y: f64, x: f64) -> f64 {
    if math::is_nan(x) || math::is_nan(y) {
        return float64_from_bits(0x7ff8000000000000)
    }
    if math::is_infinite(y) && math::is_infinite(x) {
        let angle = if negative(x) {
            3.0 * math::PI / 4.0
        } else {
            math::PI / 4.0
        };
        return if negative(y) {
            -angle
        } else {
            angle
        }
    }
    if math::is_infinite(y) {
        return if negative(y) {
            -math::PI / 2.0
        } else {
            math::PI / 2.0
        }
    }
    if math::is_infinite(x) {
        if negative(x) {
            return if negative(y) {
                -math::PI
            } else {
                math::PI
            }
        }
        return if negative(y) {
            -0.0
        } else {
            0.0
        }
    }
    if x == 0.0 {
        if y == 0.0 {
            if negative(x) {
                return if negative(y) {
                    -math::PI
                } else {
                    math::PI
                }
            }
            return y
        }
        return if negative(y) {
            -math::PI / 2.0
        } else {
            math::PI / 2.0
        }
    }
    let angle = if magnitude(y) > magnitude(x) {
        math::PI / 2.0 - arctangent(magnitude(x) / magnitude(y))
    } else {
        arctangent(magnitude(y) / magnitude(x))
    };
    if x < 0.0 {
        if negative(y) {
            angle - math::PI
        } else {
            math::PI - angle
        }
    } else if negative(y) {
        -angle
    } else {
        angle
    }
}

fn sinh_scalar(value: f64) -> f64 {
    if magnitude(value) < 0.5 {
        let square = value * value;
        value
            * (1.0
                + square
                    * (1.0 / 6.0
                        + square
                            * (1.0 / 120.0
                                + square
                                    * (1.0 / 5040.0
                                        + square * (1.0 / 362880.0 + square / 39916800.0)))))
    } else {
        (math::exp(value) - math::exp(-value)) / 2.0
    }
}

fn cosh_scalar(value: f64) -> f64 {
    (math::exp(value) + math::exp(-value)) / 2.0
}

impl Complex {
    pub fn new(real: f64, imaginary: f64) -> Complex {
        Complex { real, imaginary }
    }

    pub fn from_real(real: f64) -> Complex {
        Complex::new(real, 0.0)
    }

    pub fn from_polar(radius: f64, phase: f64) -> Complex {
        Complex::new(radius * math::cos(phase), radius * math::sin(phase))
    }

    pub fn add(self: Complex, other: Complex) -> Complex {
        Complex::new(self.real + other.real, self.imaginary + other.imaginary)
    }

    pub fn sub(self: Complex, other: Complex) -> Complex {
        Complex::new(self.real - other.real, self.imaginary - other.imaginary)
    }

    pub fn neg(self: Complex) -> Complex {
        Complex::new(-self.real, -self.imaginary)
    }

    pub fn mul(self: Complex, other: Complex) -> Complex {
        Complex::new(
            self.real * other.real - self.imaginary * other.imaginary,
            self.real * other.imaginary + self.imaginary * other.real,
        )
    }

    pub fn try_div(self: Complex, other: Complex) -> Result[Complex, DivisionError] {
        if other.real == 0.0 && other.imaginary == 0.0 {
            return Result::Err(DivisionError::ZeroDivisor)
        }
        if math::is_infinite(other.real) || math::is_infinite(other.imaginary) {
            if !math::is_finite(self.real) || !math::is_finite(self.imaginary)
                || math::is_nan(other.real)
                || math::is_nan(other.imaginary) {
                let nan = float64_from_bits(0x7ff8000000000000);
                return Result::Ok(Complex::new(nan, nan))
            }
            let real = signed_infinity_unit(other.real);
            let imaginary = signed_infinity_unit(other.imaginary);
            return Result::Ok(
                Complex::new(
                    0.0 * (self.real * real + self.imaginary * imaginary),
                    0.0 * (self.imaginary * real - self.real * imaginary),
                ),
            )
        }
        if math::is_infinite(self.real) || math::is_infinite(self.imaginary) {
            let real = signed_infinity_unit(self.real);
            let imaginary = signed_infinity_unit(self.imaginary);
            let infinity = float64_from_bits(0x7ff0000000000000);
            return Result::Ok(
                Complex::new(
                    infinity * (real * other.real + imaginary * other.imaginary),
                    infinity * (imaginary * other.real - real * other.imaginary),
                ),
            )
        }
        let scale = if magnitude(other.real) >= magnitude(other.imaginary) {
            magnitude(other.real)
        } else {
            magnitude(other.imaginary)
        };
        let real = other.real / scale;
        let imaginary = other.imaginary / scale;
        let denominator = real * real + imaginary * imaginary;
        if scale >= 1.0 {
            Result::Ok(
                Complex::new(
                    ((self.real / scale) * real + (self.imaginary / scale) * imaginary)
                        / denominator,
                    ((self.imaginary / scale) * real - (self.real / scale) * imaginary)
                        / denominator,
                ),
            )
        } else {
            Result::Ok(
                Complex::new(
                    (self.real * real + self.imaginary * imaginary) / denominator / scale,
                    (self.imaginary * real - self.real * imaginary) / denominator / scale,
                ),
            )
        }
    }

    pub fn conjugate(self: Complex) -> Complex {
        Complex::new(self.real, -self.imaginary)
    }

    pub fn abs(self: Complex) -> f64 {
        let mut real = magnitude(self.real);
        let mut imaginary = magnitude(self.imaginary);
        if math::is_infinite(real) || math::is_infinite(imaginary) {
            return float64_from_bits(0x7ff0000000000000)
        }
        if real < imaginary {
            let saved = real;
            real = imaginary;
            imaginary = saved;
        }
        if real == 0.0 {
            return 0.0
        }
        let ratio = imaginary / real;
        real * math::sqrt(1.0 + ratio * ratio)
    }

    pub fn phase(self: Complex) -> f64 {
        atan2(self.imaginary, self.real)
    }

    pub fn polar(self: Complex) -> (f64, f64) {
        (self.abs(), self.phase())
    }

    pub fn exp(self: Complex) -> Complex {
        let scale = math::exp(self.real);
        Complex::new(scale * math::cos(self.imaginary), scale * math::sin(self.imaginary))
    }

    pub fn log(self: Complex) -> Complex {
        Complex::new(math::log(self.abs()), self.phase())
    }

    pub fn log10(self: Complex) -> Complex {
        let value = self.log();
        Complex::new(value.real / math::LN_10, value.imaginary / math::LN_10)
    }

    pub fn sqrt(self: Complex) -> Complex {
        if self.imaginary == 0.0 {
            if self.real < 0.0 {
                let imaginary = math::sqrt(-self.real);
                return Complex::new(
                    0.0,
                    if negative(self.imaginary) {
                        -imaginary
                    } else {
                        imaginary
                    },
                )
            }
            return Complex::new(math::sqrt(self.real), self.imaginary)
        }
        let radius = self.abs();
        if self.real >= 0.0 {
            let real = math::sqrt(radius / 2.0 + self.real / 2.0);
            Complex::new(real, self.imaginary / (2.0 * real))
        } else {
            let imaginary = math::sqrt(radius / 2.0 - self.real / 2.0);
            let imaginary = if negative(self.imaginary) {
                -imaginary
            } else {
                imaginary
            };
            Complex::new(magnitude(self.imaginary) / (2.0 * magnitude(imaginary)), imaginary)
        }
    }

    pub fn pow(self: Complex, exponent: Complex) -> Complex {
        if self.real == 0.0 && self.imaginary == 0.0 {
            if exponent.real == 0.0 && exponent.imaginary == 0.0 {
                return Complex::from_real(1.0)
            }
            if exponent.real > 0.0 && exponent.imaginary == 0.0 {
                return Complex::from_real(0.0)
            }
        }
        self.log().mul(exponent).exp()
    }

    pub fn powi(self: Complex, exponent: i32) -> Result[Complex, DivisionError] {
        let mut factor = self;
        let mut power = exponent.to_i64();
        if power < 0 {
            factor = Complex::from_real(1.0).try_div(factor)?;
            power = -power;
        }
        let mut result = Complex::from_real(1.0);
        while power > 0 {
            if power & 1 != 0 {
                result = result.mul(factor);
            }
            factor = factor.mul(factor);
            power = power >> 1;
        }
        Result::Ok(result)
    }

    pub fn sin(self: Complex) -> Complex {
        Complex::new(
            math::sin(self.real) * cosh_scalar(self.imaginary),
            math::cos(self.real) * sinh_scalar(self.imaginary),
        )
    }

    pub fn cos(self: Complex) -> Complex {
        Complex::new(
            math::cos(self.real) * cosh_scalar(self.imaginary),
            -math::sin(self.real) * sinh_scalar(self.imaginary),
        )
    }

    pub fn sinh(self: Complex) -> Complex {
        Complex::new(
            sinh_scalar(self.real) * math::cos(self.imaginary),
            cosh_scalar(self.real) * math::sin(self.imaginary),
        )
    }

    pub fn cosh(self: Complex) -> Complex {
        Complex::new(
            cosh_scalar(self.real) * math::cos(self.imaginary),
            sinh_scalar(self.real) * math::sin(self.imaginary),
        )
    }

    pub fn tan(self: Complex) -> Result[Complex, DivisionError] {
        self.sin().try_div(self.cos())
    }

    pub fn tanh(self: Complex) -> Result[Complex, DivisionError] {
        self.sinh().try_div(self.cosh())
    }

    pub fn asin(self: Complex) -> Complex {
        if self.imaginary == 0.0 && magnitude(self.real) > 1.0 {
            let real = if negative(self.real) {
                -math::PI / 2.0
            } else {
                math::PI / 2.0
            };
            let magnitude = magnitude(self.real);
            let imaginary = if magnitude > 1e150 {
                math::log(magnitude) + math::LN_2
            } else {
                math::log(magnitude + math::sqrt(magnitude - 1.0) * math::sqrt(magnitude + 1.0))
            };
            return Complex::new(
                real,
                if negative(self.imaginary) {
                    -imaginary
                } else {
                    imaginary
                },
            )
        }
        let imaginary_unit = Complex::new(0.0, 1.0);
        let inside = imaginary_unit.mul(self).add(
            Complex::from_real(1.0).sub(self.mul(self)).sqrt(),
        );
        Complex::new(0.0, -1.0).mul(inside.log())
    }

    pub fn acos(self: Complex) -> Complex {
        Complex::from_real(math::PI / 2.0).sub(self.asin())
    }

    pub fn atan(self: Complex) -> Complex {
        let imaginary_unit = Complex::new(0.0, 1.0);
        let rotated = imaginary_unit.mul(self);
        Complex::new(0.0, 0.5).mul(
            Complex::from_real(1.0).sub(rotated).log().sub(
                Complex::from_real(1.0).add(rotated).log(),
            ),
        )
    }

    pub fn asinh(self: Complex) -> Complex {
        self.add(self.mul(self).add(Complex::from_real(1.0)).sqrt()).log()
    }

    pub fn acosh(self: Complex) -> Complex {
        self.add(
            self.add(Complex::from_real(1.0)).sqrt().mul(self.sub(Complex::from_real(1.0)).sqrt()),
        ).log()
    }

    pub fn atanh(self: Complex) -> Complex {
        if self.imaginary == 0.0 && magnitude(self.real) > 1.0 {
            let real = (math::log(magnitude(1.0 + self.real))
                - math::log(magnitude(1.0 - self.real)))
                / 2.0;
            let imaginary = if negative(self.imaginary) {
                -math::PI / 2.0
            } else {
                math::PI / 2.0
            };
            return Complex::new(real, imaginary)
        }
        let one = Complex::from_real(1.0);
        let difference = one.add(self).log().sub(one.sub(self).log());
        Complex::new(difference.real / 2.0, difference.imaginary / 2.0)
    }
}
