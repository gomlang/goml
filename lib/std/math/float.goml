package math;

const SIGN_MASK: u64 = 0x8000000000000000;

const FRACTION_MASK: u64 = 0x000fffffffffffff;

const EXPONENT_MASK: u64 = 0x7ff0000000000000;

fn magnitude(value: f64) -> f64 {
    float64_from_bits(value.to_bits() & ~SIGN_MASK)
}

fn negative(value: f64) -> bool {
    value.to_bits() & SIGN_MASK != 0
}

fn copy_sign(value: f64, sign: f64) -> f64 {
    float64_from_bits((value.to_bits() & ~SIGN_MASK) | (sign.to_bits() & SIGN_MASK))
}

fn infinity() -> f64 {
    float64_from_bits(EXPONENT_MASK)
}

fn nan() -> f64 {
    float64_from_bits(0x7ff8000000000001)
}

fn small_integer_float(value: isize) -> f64 {
    if value < 0 {
        -(float64_from_bits(0x4330000000000000 | (-value).to_u64()) - 4503599627370496.0)
    } else {
        float64_from_bits(0x4330000000000000 | value.to_u64()) - 4503599627370496.0
    }
}

fn integer_magnitude(value: f64) -> u64 {
    let bits = value.to_bits();
    let exponent = ((bits >> 52) & 0x7ff).to_isize() - 1023;
    if exponent < 0 {
        return 0
    }
    let significand = (bits & FRACTION_MASK) | (1 << 52);
    if exponent < 52 {
        significand >> (52 - exponent)
    } else {
        significand << (exponent - 52)
    }
}

fn normalize(value: f64) -> (f64, isize) {
    if magnitude(value) < 2.2250738585072014e-308 {
        (value * 4503599627370496.0, -52)
    } else {
        (value, 0)
    }
}

fn split_exponent(value: f64) -> (f64, isize) {
    if value == 0.0 || !is_finite(value) {
        return (value, 0)
    }
    let (value, correction) = normalize(value);
    let bits = value.to_bits();
    let exponent = correction + ((bits >> 52) & 0x7ff).to_isize() - 1022;
    (float64_from_bits((bits & ~EXPONENT_MASK) | (1022 << 52)), exponent)
}

fn scale_exponent(value: f64, exponent: isize) -> f64 {
    if value == 0.0 || !is_finite(value) {
        return value
    }
    let (value, correction) = normalize(value);
    let bits = value.to_bits();
    let mut exponent = exponent + correction + ((bits >> 52) & 0x7ff).to_isize() - 1023;
    if exponent < -1075 {
        return copy_sign(0.0, value)
    }
    if exponent > 1023 {
        return copy_sign(infinity(), value)
    }
    let mut scale = 1.0;
    if exponent < -1022 {
        exponent += 53;
        scale = 1.11022302462515654042e-16;
    }
    scale * float64_from_bits((bits & ~EXPONENT_MASK) | ((exponent + 1023).to_u64() << 52))
}

pub fn trunc(value: f64) -> f64 {
    let mut bits = value.to_bits();
    let exponent = ((bits >> 52) & 0x7ff).to_isize() - 1023;
    if exponent < 0 {
        return float64_from_bits(bits & SIGN_MASK)
    }
    if exponent < 52 {
        bits = bits & ~((1 << (52 - exponent)) - 1);
    }
    float64_from_bits(bits)
}

pub fn floor(value: f64) -> f64 {
    let integral = trunc(value);
    if value < integral {
        integral - 1.0
    } else {
        integral
    }
}

pub fn ceil(value: f64) -> f64 {
    -floor(-value)
}

pub fn round(value: f64) -> f64 {
    let mut bits = value.to_bits();
    let exponent = (bits >> 52) & 0x7ff;
    if exponent < 1023 {
        bits = bits & SIGN_MASK;
        if exponent == 1022 {
            bits = bits | 0x3ff0000000000000;
        }
    } else if exponent < 1075 {
        let shift = exponent - 1023;
        bits += 0x0008000000000000 >> shift;
        bits = bits & ~(FRACTION_MASK >> shift);
    }
    float64_from_bits(bits)
}

pub fn sqrt(value: f64) -> f64 {
    if value == 0.0 || is_nan(value) || value == infinity() {
        return value
    }
    if value < 0.0 {
        return nan()
    }
    let mut significand = value.to_bits();
    let mut exponent = ((significand >> 52) & 0x7ff).to_isize();
    if exponent == 0 {
        while significand & (1 << 52) == 0 {
            significand = significand << 1;
            exponent -= 1;
        }
        exponent += 1;
    }
    exponent -= 1023;
    significand = (significand & ~EXPONENT_MASK) | (1 << 52);
    if exponent & 1 == 1 {
        significand = significand << 1;
    }
    exponent = exponent >> 1;
    significand = significand << 1;
    let mut result: u64 = 0;
    let mut doubled: u64 = 0;
    let mut bit: u64 = 1 << 53;
    while bit != 0 {
        let candidate = doubled + bit;
        if candidate <= significand {
            doubled = candidate + bit;
            significand -= candidate;
            result += bit;
        }
        significand = significand << 1;
        bit = bit >> 1;
    }
    if significand != 0 {
        result += result & 1;
    }
    float64_from_bits((result >> 1) + ((exponent + 1022).to_u64() << 52))
}
