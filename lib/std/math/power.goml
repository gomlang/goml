package math;

pub fn exp(value: f64) -> f64 {
    if is_nan(value) {
        return value
    }
    if value > 7.09782712893383973096e2 {
        return infinity()
    }
    if value < -7.45133219101941108420e2 {
        return 0.0
    }
    if value > -3.7252902984619140625e-9 && value < 3.7252902984619140625e-9 {
        return 1.0 + value
    }
    let rounded = 1.44269504088896338700 * magnitude(value) + 0.5;
    let power = integer_magnitude(rounded).to_isize();
    let power = if value < 0.0 {
        -power
    } else {
        power
    };
    let exponent = small_integer_float(power);
    let high = value - exponent * 6.93147180369123816490e-1;
    let low = exponent * 1.90821492927058770002e-10;
    let reduced = high - low;
    let square = reduced * reduced;
    let correction = reduced
        - square
            * (1.66666666666666657415e-1
                + square
                    * (-2.77777777770155933842e-3
                        + square
                            * (6.61375632143793436117e-5
                                + square
                                    * (-1.65339022054652515390e-6
                                        + square * 4.13813679705723846039e-8))));
    let result = 1.0 - ((low - (reduced * correction) / (2.0 - correction)) - high);
    scale_exponent(result, power)
}

pub fn log(value: f64) -> f64 {
    if is_nan(value) || value == infinity() {
        return value
    }
    if value < 0.0 {
        return nan()
    }
    if value == 0.0 {
        return -infinity()
    }
    let (fraction, power) = split_exponent(value);
    let (fraction, power) = if fraction < SQRT_2 / 2.0 {
        (fraction * 2.0, power - 1)
    } else {
        (fraction, power)
    };
    let reduced = fraction - 1.0;
    let exponent = small_integer_float(power);
    let ratio = reduced / (2.0 + reduced);
    let square = ratio * ratio;
    let fourth = square * square;
    let first = square
        * (6.666666666666735130e-1
            + fourth
                * (2.857142874366239149e-1
                    + fourth * (1.818357216161805012e-1 + fourth * 1.479819860511658591e-1)));
    let second = fourth
        * (3.999999999940941908e-1
            + fourth * (2.222219843214978396e-1 + fourth * 1.531383769920937332e-1));
    let correction = first + second;
    let half_square = 0.5 * reduced * reduced;
    exponent * 6.93147180369123816490e-1
        - ((half_square
            - (ratio * (half_square + correction) + exponent * 1.90821492927058770002e-10))
            - reduced)
}

fn odd_integer(value: f64) -> bool {
    let value = magnitude(value);
    value < 9007199254740992.0 && trunc(value) == value && integer_magnitude(value) & 1 == 1
}

pub fn pow(value: f64, exponent: f64) -> f64 {
    if exponent == 0.0 || value == 1.0 {
        return 1.0
    }
    if exponent == 1.0 {
        return value
    }
    if is_nan(value) || is_nan(exponent) {
        return nan()
    }
    if value == 0.0 {
        if exponent < 0.0 {
            return if negative(value) && odd_integer(exponent) {
                -infinity()
            } else {
                infinity()
            }
        }
        return if negative(value) && odd_integer(exponent) {
            value
        } else {
            0.0
        }
    }
    if is_infinite(exponent) {
        if value == -1.0 {
            return 1.0
        }
        return if (magnitude(value) < 1.0) == (exponent > 0.0) {
            0.0
        } else {
            infinity()
        }
    }
    if is_infinite(value) {
        if negative(value) {
            return pow(copy_sign(0.0, value), -exponent)
        }
        return if exponent < 0.0 {
            0.0
        } else {
            infinity()
        }
    }
    if exponent == 0.5 {
        return sqrt(value)
    }
    if exponent == -0.5 {
        return 1.0 / sqrt(value)
    }
    let mut integral = trunc(magnitude(exponent));
    let mut fractional = magnitude(exponent) - integral;
    if fractional != 0.0 && value < 0.0 {
        return nan()
    }
    if integral >= 9223372036854775808.0 {
        if value == -1.0 {
            return 1.0
        }
        return if (magnitude(value) < 1.0) == (exponent > 0.0) {
            0.0
        } else {
            infinity()
        }
    }
    if magnitude(magnitude(value) - 1.0) <= 0.0001 && magnitude(exponent) >= 1048576.0 {
        let result = exp(exponent * log(magnitude(value)));
        return if value < 0.0 && odd_integer(exponent) {
            -result
        } else {
            result
        }
    }
    let mut result = 1.0;
    let mut result_exponent = 0;
    if fractional != 0.0 {
        if fractional > 0.5 {
            fractional -= 1.0;
            integral += 1.0;
        }
        result = exp(fractional * log(value));
    }
    let (fraction, power) = split_exponent(value);
    let mut fraction = fraction;
    let mut power = power;
    let mut remaining = integer_magnitude(integral);
    while remaining != 0 {
        if power < -4096 || power > 4096 {
            result_exponent += power;
            break
        }
        if remaining & 1 == 1 {
            result *= fraction;
            result_exponent += power;
        }
        fraction *= fraction;
        power = power << 1;
        if fraction < 0.5 {
            fraction += fraction;
            power -= 1;
        }
        remaining = remaining >> 1;
    }
    if exponent < 0.0 {
        result = 1.0 / result;
        result_exponent = -result_exponent;
    }
    scale_exponent(result, result_exponent)
}
