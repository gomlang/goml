package time;

use module::internal::host;
use module::task;

pub struct Duration {
    nanoseconds: i64,
}

pub struct Timer {
    id: i64,
    ready: Receiver[()],
}

impl Duration {
    pub fn zero() -> Duration {
        Duration { nanoseconds: 0 }
    }

    pub fn from_nanoseconds(value: i64) -> Duration {
        Duration {
            nanoseconds: if value < 0 {
                0
            } else {
                value
            },
        }
    }

    pub fn from_microseconds(value: i64) -> Duration {
        Duration::from_nanoseconds(value * 1000)
    }

    pub fn from_milliseconds(value: i64) -> Duration {
        Duration::from_nanoseconds(value * 1000000)
    }

    pub fn from_seconds(value: i64) -> Duration {
        Duration::from_nanoseconds(value * 1000000000)
    }

    pub fn checked_from_microseconds(value: i64) -> Option[Duration] {
        Duration::checked_scaled(value, 1000)
    }

    pub fn checked_from_milliseconds(value: i64) -> Option[Duration] {
        Duration::checked_scaled(value, 1000000)
    }

    pub fn checked_from_seconds(value: i64) -> Option[Duration] {
        Duration::checked_scaled(value, 1000000000)
    }

    fn checked_scaled(value: i64, scale: i64) -> Option[Duration] {
        if value < 0 || value > 9223372036854775807 / scale {
            Option::None
        } else {
            Option::Some(Duration::from_nanoseconds(value * scale))
        }
    }

    pub fn saturating_from_microseconds(value: i64) -> Duration {
        Duration::saturating_scaled(value, 1000)
    }

    pub fn saturating_from_milliseconds(value: i64) -> Duration {
        Duration::saturating_scaled(value, 1000000)
    }

    pub fn saturating_from_seconds(value: i64) -> Duration {
        Duration::saturating_scaled(value, 1000000000)
    }

    fn saturating_scaled(value: i64, scale: i64) -> Duration {
        match Duration::checked_scaled(value, scale) {
            Some(duration) => duration,
            None => if value < 0 {
                Duration::zero()
            } else {
                Duration::from_nanoseconds(9223372036854775807)
            },
        }
    }

    pub fn as_nanoseconds(self: Duration) -> i64 {
        self.nanoseconds
    }

    pub fn as_microseconds(self: Duration) -> i64 {
        self.nanoseconds / 1000
    }

    pub fn as_milliseconds(self: Duration) -> i64 {
        self.nanoseconds / 1000000
    }

    pub fn as_seconds(self: Duration) -> i64 {
        self.nanoseconds / 1000000000
    }

    pub fn is_zero(self: Duration) -> bool {
        self.nanoseconds == 0
    }

    pub fn add(self: Duration, other: Duration) -> Duration {
        Duration::from_nanoseconds(self.nanoseconds + other.nanoseconds)
    }

    pub fn subtract(self: Duration, other: Duration) -> Duration {
        Duration::from_nanoseconds(self.nanoseconds - other.nanoseconds)
    }

    pub fn checked_add(self: Duration, other: Duration) -> Option[Duration] {
        if other.nanoseconds > 9223372036854775807 - self.nanoseconds {
            Option::None
        } else {
            Option::Some(Duration::from_nanoseconds(self.nanoseconds + other.nanoseconds))
        }
    }

    pub fn saturating_add(self: Duration, other: Duration) -> Duration {
        self.checked_add(other).unwrap_or(Duration::from_nanoseconds(9223372036854775807))
    }

    pub fn checked_subtract(self: Duration, other: Duration) -> Option[Duration] {
        if self.nanoseconds < other.nanoseconds {
            Option::None
        } else {
            Option::Some(Duration::from_nanoseconds(self.nanoseconds - other.nanoseconds))
        }
    }

    pub fn saturating_subtract(self: Duration, other: Duration) -> Duration {
        self.checked_subtract(other).unwrap_or(Duration::zero())
    }

    pub fn checked_multiply(self: Duration, factor: i64) -> Option[Duration] {
        if factor < 0 || factor > 0 && self.nanoseconds > 9223372036854775807 / factor {
            Option::None
        } else {
            Option::Some(Duration::from_nanoseconds(self.nanoseconds * factor))
        }
    }

    pub fn saturating_multiply(self: Duration, factor: i64) -> Duration {
        match self.checked_multiply(factor) {
            Some(duration) => duration,
            None => if factor < 0 {
                Duration::zero()
            } else {
                Duration::from_nanoseconds(9223372036854775807)
            },
        }
    }

    pub fn compare(self: Duration, other: Duration) -> isize {
        if self.nanoseconds < other.nanoseconds {
            -1
        } else if self.nanoseconds > other.nanoseconds {
            1
        } else {
            0
        }
    }
}

impl PartialEq for Duration {
    fn eq(self: Duration, other: Duration) -> bool {
        self.nanoseconds == other.nanoseconds
    }
}

impl Eq for Duration {}

pub struct Instant {
    nanoseconds: i64,
}

impl Instant {
    pub fn now() -> Instant {
        Instant { nanoseconds: host::monotonic_nanoseconds() }
    }

    pub fn elapsed(self: Instant) -> Duration {
        Instant::now().duration_since(self)
    }

    pub fn duration_since(self: Instant, earlier: Instant) -> Duration {
        Duration::from_nanoseconds(self.nanoseconds - earlier.nanoseconds)
    }

    pub fn checked_duration_since(self: Instant, earlier: Instant) -> Option[Duration] {
        if self.nanoseconds < earlier.nanoseconds {
            Option::None
        } else {
            Option::Some(Duration::from_nanoseconds(self.nanoseconds - earlier.nanoseconds))
        }
    }

    pub fn compare(self: Instant, other: Instant) -> isize {
        if self.nanoseconds < other.nanoseconds {
            -1
        } else if self.nanoseconds > other.nanoseconds {
            1
        } else {
            0
        }
    }
}

impl PartialEq for Instant {
    fn eq(self: Instant, other: Instant) -> bool {
        self.nanoseconds == other.nanoseconds
    }
}

impl Eq for Instant {}

pub struct SystemTime {
    unix_nanoseconds: i64,
}

impl SystemTime {
    pub fn now() -> SystemTime {
        SystemTime { unix_nanoseconds: host::unix_nanoseconds() }
    }

    pub fn from_unix_nanoseconds(value: i64) -> SystemTime {
        SystemTime { unix_nanoseconds: value }
    }

    pub fn checked_from_unix_milliseconds(value: i64) -> Result[SystemTime, Error] {
        if value > 9223372036854 || value < -9223372036854 {
            Result::Err(Error::new("system time conversion", "milliseconds out of range"))
        } else {
            Result::Ok(SystemTime::from_unix_nanoseconds(value * 1000000))
        }
    }

    pub fn checked_from_unix_seconds(value: i64) -> Result[SystemTime, Error] {
        if value > 9223372036 || value < -9223372036 {
            Result::Err(Error::new("system time conversion", "seconds out of range"))
        } else {
            Result::Ok(SystemTime::from_unix_nanoseconds(value * 1000000000))
        }
    }

    pub fn duration_since(self: SystemTime, earlier: SystemTime) -> Result[Duration, Error] {
        if self.unix_nanoseconds < earlier.unix_nanoseconds {
            Result::Err(Error::new("system time difference", "earlier time is after receiver"))
        } else {
            Result::Ok(Duration::from_nanoseconds(self.unix_nanoseconds - earlier.unix_nanoseconds))
        }
    }

    pub fn unix_nanoseconds(self: SystemTime) -> i64 {
        self.unix_nanoseconds
    }

    pub fn unix_milliseconds(self: SystemTime) -> i64 {
        self.unix_nanoseconds / 1000000
    }

    pub fn unix_seconds(self: SystemTime) -> i64 {
        self.unix_nanoseconds / 1000000000
    }

    pub fn compare(self: SystemTime, other: SystemTime) -> isize {
        if self.unix_nanoseconds < other.unix_nanoseconds {
            -1
        } else if self.unix_nanoseconds > other.unix_nanoseconds {
            1
        } else {
            0
        }
    }
}

impl PartialEq for SystemTime {
    fn eq(self: SystemTime, other: SystemTime) -> bool {
        self.unix_nanoseconds == other.unix_nanoseconds
    }
}

impl Eq for SystemTime {}

pub fn sleep(duration: Duration) -> () {
    host::sleep_nanoseconds(duration.as_nanoseconds())
}

impl Timer {
    pub fn new(duration: Duration) -> Timer {
        let (id, ready) = host::timer_new(duration.as_nanoseconds());
        Timer { id, ready }
    }

    pub fn done(self: Timer) -> Receiver[()] {
        self.ready
    }

    pub fn stop(self: Timer) -> bool {
        host::timer_stop(self.id)
    }
}

pub fn after(duration: Duration) -> Receiver[()] {
    Timer::new(duration).done()
}

pub fn sleep_with(cancel: task::CancelToken, duration: Duration) -> task::WaitResult[()] {
    task::sleep_nanoseconds_with(cancel, duration.as_nanoseconds())
}
