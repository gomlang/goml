package stream;

use module::hash;
use hash::Hasher;
use module::io;
use io::{Read, Write};

fn checked_count(count: isize, length: isize, operation: string) -> Result[isize, io::Error] {
    if count < 0 || count > length {
        Result::Err(
            io::Error::new(
                io::ErrorKind::InvalidData,
                operation,
                Option::None,
                Option::None,
                "invalid byte count returned by stream",
            ),
        )
    } else {
        Result::Ok(count)
    }
}

pub struct Reader[R, H] {
    reader: R,
    state: H,
}

impl[R: Read, H: Hasher] Reader[R, H] {
    pub fn new(reader: R, hasher: H) -> Reader[R, H] {
        Reader { reader, state: hasher }
    }

    pub fn inner(self: Reader[R, H]) -> R {
        self.reader
    }

    pub fn hasher(self: Reader[R, H]) -> H {
        self.state
    }
}

impl[R: Read, H: Hasher] Read for Reader[R, H] {
    fn read(self: Reader[R, H], output: MutSlice[byte]) -> Result[isize, io::Error] {
        let count = checked_count(self.reader.read(output)?, output.len(), "hash read")?;
        if count > 0 {
            self.state.update(output.as_slice().sub(0, count));
        }
        Result::Ok(count)
    }
}

pub struct Writer[W, H] {
    writer: W,
    state: H,
}

impl[W: Write, H: Hasher] Writer[W, H] {
    pub fn new(writer: W, hasher: H) -> Writer[W, H] {
        Writer { writer, state: hasher }
    }

    pub fn inner(self: Writer[W, H]) -> W {
        self.writer
    }

    pub fn hasher(self: Writer[W, H]) -> H {
        self.state
    }
}

impl[W: Write, H: Hasher] Write for Writer[W, H] {
    fn write(self: Writer[W, H], input: Slice[byte]) -> Result[isize, io::Error] {
        let count = checked_count(self.writer.write(input)?, input.len(), "hash write")?;
        if count > 0 {
            self.state.update(input.sub(0, count));
        }
        Result::Ok(count)
    }

    fn flush(self: Writer[W, H]) -> Result[(), io::Error] {
        self.writer.flush()
    }
}
