package crc32;

use module::bytes;
use module::hash;
use hash::Hasher;

pub const IEEE: u32 = 0xedb88320;

pub const CASTAGNOLI: u32 = 0x82f63b78;

pub const KOOPMAN: u32 = 0xeb31d82e;

pub struct Table {
    values: Vec[u32],
}

impl Table {
    pub fn new(polynomial: u32) -> Table {
        let values: Vec[u32] = Vec::with_capacity(256);
        for index in 0..256 {
            let mut value = index.to_u32();
            for _ in 0..8 {
                value = if value & 1 == 0 {
                    value >> 1
                } else {
                    (value >> 1) ^ polynomial
                };
            }
            values.push(value)
        }
        Table { values }
    }
}

pub fn update(previous: u32, table: Table, input: Slice[byte]) -> u32 {
    let mut value = previous ^ 0xffffffff;
    for digit in input {
        value = table.values[((value ^ digit.to_u32()) & 255).to_isize()] ^ (value >> 8);
    }
    value ^ 0xffffffff
}

pub fn checksum(input: Slice[byte], table: Table) -> u32 {
    update(0, table, input)
}

pub struct Digest {
    state: Ref[u32],
    table: Table,
}

impl Digest {
    pub fn new(table: Table) -> Digest {
        Digest { state: Ref::new(0), table }
    }

    pub fn sum32(self: Digest) -> u32 {
        self.state.get()
    }

    pub fn copy(self: Digest) -> Digest {
        Digest { state: Ref::new(self.state.get()), table: self.table }
    }
}

impl Hasher for Digest {
    fn update(self: Digest, input: Slice[byte]) -> () {
        self.state.set(update(self.state.get(), self.table, input))
    }

    fn reset(self: Digest) -> () {
        self.state.set(0)
    }

    fn sum(self: Digest) -> bytes::Bytes {
        let output = bytes::Bytes::with_capacity(4);
        let value = self.state.get();
        for index in 0..4 {
            output.push((value >> ((3 - index) * 8)).to_u8())
        }
        output
    }

    fn size(self: Digest) -> isize {
        4
    }

    fn block_size(self: Digest) -> isize {
        1
    }
}
