package crc64;

use module::bytes;
use module::hash;
use hash::Hasher;

pub const ISO: u64 = 0xd800000000000000;

pub const ECMA: u64 = 0xc96c5795d7870f42;

pub struct Table {
    values: Vec[u64],
}

impl Table {
    pub fn new(polynomial: u64) -> Table {
        let values: Vec[u64] = Vec::with_capacity(256);
        for index in 0..256 {
            let mut value = index.to_u64();
            for _ in 0..8 {
                value = if value & 1 == 0 {
                    value >> 1
                } else {
                    (value >> 1) ^ polynomial
                };
            }
            values.push(value)
        }
        Table { values }
    }
}

pub fn update(previous: u64, table: Table, input: Slice[byte]) -> u64 {
    let mut value = previous ^ 0xffffffffffffffff;
    for digit in input {
        value = table.values[((value ^ digit.to_u64()) & 255).to_isize()] ^ (value >> 8);
    }
    value ^ 0xffffffffffffffff
}

pub fn checksum(input: Slice[byte], table: Table) -> u64 {
    update(0, table, input)
}

pub struct Digest {
    state: Ref[u64],
    table: Table,
}

impl Digest {
    pub fn new(table: Table) -> Digest {
        Digest { state: Ref::new(0), table }
    }

    pub fn sum64(self: Digest) -> u64 {
        self.state.get()
    }

    pub fn copy(self: Digest) -> Digest {
        Digest { state: Ref::new(self.state.get()), table: self.table }
    }
}

impl Hasher for Digest {
    fn update(self: Digest, input: Slice[byte]) -> () {
        self.state.set(update(self.state.get(), self.table, input))
    }

    fn reset(self: Digest) -> () {
        self.state.set(0)
    }

    fn sum(self: Digest) -> bytes::Bytes {
        let output = bytes::Bytes::with_capacity(8);
        let value = self.state.get();
        for index in 0..8 {
            output.push((value >> ((7 - index) * 8)).to_u8())
        }
        output
    }

    fn size(self: Digest) -> isize {
        8
    }

    fn block_size(self: Digest) -> isize {
        1
    }
}
