package adler32;

use module::bytes;
use module::hash;
use hash::Hasher;

pub fn update(previous: u32, input: Slice[byte]) -> u32 {
    let mut first = previous & 0xffff;
    let mut second = previous >> 16;
    let mut start = 0;
    while start < input.len() {
        let remaining = input.len() - start;
        let count = if remaining < 5552 {
            remaining
        } else {
            5552
        };
        for index in start..start + count {
            first += input[index].to_u32();
            second += first;
        }
        first = first % 65521;
        second = second % 65521;
        start += count;
    }
    let result = (second << 16) | first;
    result
}

pub fn checksum(input: Slice[byte]) -> u32 {
    update(1, input)
}

pub struct Digest {
    state: Ref[u32],
}

impl Digest {
    pub fn new() -> Digest {
        Digest { state: Ref::new(1) }
    }

    pub fn sum32(self: Digest) -> u32 {
        self.state.get()
    }

    pub fn copy(self: Digest) -> Digest {
        Digest { state: Ref::new(self.state.get()) }
    }
}

impl Hasher for Digest {
    fn update(self: Digest, input: Slice[byte]) -> () {
        self.state.set(update(self.state.get(), input))
    }

    fn reset(self: Digest) -> () {
        self.state.set(1)
    }

    fn sum(self: Digest) -> bytes::Bytes {
        let value = self.state.get();
        bytes::Bytes::from_vec(
            Vec::from_array(
                [(value >> 24).to_u8(), (value >> 16).to_u8(), (value >> 8).to_u8(), value.to_u8()],
            ),
        )
    }

    fn size(self: Digest) -> isize {
        4
    }

    fn block_size(self: Digest) -> isize {
        1
    }
}
