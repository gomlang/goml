package fnv;

use module::bytes;
use module::hash;
use hash::Hasher;
use module::math::bits;

pub struct Digest {
    state: Ref[(u64, u64)],
    width: isize,
    alternate: bool,
}

fn initial(width: isize) -> (u64, u64) {
    if width == 32 {
        (0, 2166136261)
    } else if width == 64 {
        (0, 14695981039346656037)
    } else {
        (0x6c62272e07bb0142, 0x62b821756295c58d)
    }
}

fn digest(width: isize, alternate: bool) -> Digest {
    Digest { state: Ref::new(initial(width)), width, alternate }
}

impl Digest {
    pub fn new32() -> Digest {
        digest(32, false)
    }

    pub fn new32a() -> Digest {
        digest(32, true)
    }

    pub fn new64() -> Digest {
        digest(64, false)
    }

    pub fn new64a() -> Digest {
        digest(64, true)
    }

    pub fn new128() -> Digest {
        digest(128, false)
    }

    pub fn new128a() -> Digest {
        digest(128, true)
    }

    pub fn copy(self: Digest) -> Digest {
        Digest { state: Ref::new(self.state.get()), width: self.width, alternate: self.alternate }
    }
}

impl Hasher for Digest {
    fn update(self: Digest, input: Slice[byte]) -> () {
        let (old_high, old_low) = self.state.get();
        let mut high = old_high;
        let mut low = old_low;
        for digit in input {
            if self.alternate {
                low = low ^ digit.to_u64();
            }
            if self.width == 32 {
                low = (low * 16777619) & 0xffffffff;
            } else if self.width == 64 {
                low = low * 1099511628211;
            } else {
                let (carry, product) = bits::mul64(low, 315);
                high = high * 315 + carry + (low << 24);
                low = product;
            }
            if !self.alternate {
                low = low ^ digit.to_u64();
            }
        }
        self.state.set((high, low))
    }

    fn reset(self: Digest) -> () {
        self.state.set(initial(self.width))
    }

    fn sum(self: Digest) -> bytes::Bytes {
        let output = bytes::Bytes::with_capacity(self.width / 8);
        let (high, low) = self.state.get();
        if self.width == 128 {
            for index in 0..8 {
                output.push((high >> ((7 - index) * 8)).to_u8())
            }
        }
        let count = if self.width == 32 {
            4
        } else {
            8
        };
        for index in 0..count {
            output.push((low >> ((count - 1 - index) * 8)).to_u8())
        }
        output
    }

    fn size(self: Digest) -> isize {
        self.width / 8
    }

    fn block_size(self: Digest) -> isize {
        1
    }
}
