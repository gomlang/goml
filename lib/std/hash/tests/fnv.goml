package tests;

use std::bytes;
use std::hash::fnv;
use std::hash;
use hash::Hasher;
use std::encoding::hex;

fn check_fnv(input: bytes::Bytes) -> () {
    check_fnv_state(input);
    for (digest, width, alternate) in[
        (fnv::Digest::new32(), 4, false),
        (fnv::Digest::new32a(), 4, true),
        (fnv::Digest::new64(), 8, false),
        (fnv::Digest::new64a(), 8, true),
        (fnv::Digest::new128(), 16, false),
        (fnv::Digest::new128a(), 16, true),
    ] {
        check_digest(digest, input, reference_fnv(input.as_slice(), width, alternate));
    }
}

fn check_fnv_state(input: bytes::Bytes) -> () {
    for digest in[
        fnv::Digest::new32(),
        fnv::Digest::new32a(),
        fnv::Digest::new64(),
        fnv::Digest::new64a(),
        fnv::Digest::new128(),
        fnv::Digest::new128a(),
    ] {
        let alias = digest;
        let initial = digest.sum().to_vec_copy();
        let middle = input.len() / 2;
        alias.update(input.slice(0, middle));
        let checkpoint = digest.sum().to_vec_copy();
        let independent = digest.copy();
        digest.update(input.slice(middle, input.len()));
        let expected = digest.sum().to_vec_copy();
        assert_equal(independent.sum().to_vec(), checkpoint);
        independent.update(input.slice(middle, input.len()));
        assert_equal(independent.sum().to_vec(), expected);
        alias.reset();
        assert_equal(digest.sum().to_vec(), initial);
        assert_equal(independent.sum().to_vec(), expected);
        independent.reset();
        assert_equal(independent.sum().to_vec(), initial);
        if input.len() <= 31 {
            for split in 0..input.len() + 1 {
                digest.reset();
                digest.update(input.slice(0, split));
                let snapshot = digest.sum();
                let before = snapshot.to_vec_copy();
                digest.update(input.slice(split, input.len()));
                assert_equal(snapshot.to_vec(), before);
                assert_equal(digest.sum().to_vec(), expected);
            }
        }
    }
}

fn check_fnv_known_answers() -> () {
    for (digest, empty, abc) in[
        (fnv::Digest::new32(), "811c9dc5", "439c2f4b"),
        (fnv::Digest::new32a(), "811c9dc5", "1a47e90b"),
        (fnv::Digest::new64(), "cbf29ce484222325", "d8dcca186bafadcb"),
        (fnv::Digest::new64a(), "cbf29ce484222325", "e71fa2190541574b"),
        (
            fnv::Digest::new128(),
            "6c62272e07bb014262b821756295c58d",
            "a68bb2a4348b5822836dbc78c6aee73b",
        ),
        (
            fnv::Digest::new128a(),
            "6c62272e07bb014262b821756295c58d",
            "a68d622cec8b5822836dbc7977af7f3b",
        ),
    ] {
        assert_equal(hex::encode(digest.sum()), empty);
        digest.update(bytes::Bytes::from_string("abc").as_slice());
        assert_equal(hex::encode(digest.sum()), abc);
    }
}
