package tests;

use std::bytes;

fn reference_adler32(input: Slice[byte]) -> u32 {
    let mut a: u32 = 1;
    let mut b: u32 = 0;
    for value in input {
        a = (a + value.to_u32()) % 65521;
        b = (b + a) % 65521;
    }
    return (b << 16) | a
}

fn reference_crc32_table(polynomial: u32) -> u32 {
    polynomial
}

fn reference_crc64_table(polynomial: u64) -> u64 {
    polynomial
}

fn reference_crc32(input: Slice[byte], polynomial: u32) -> u32 {
    reference_crc32_update(0, polynomial, input)
}

fn reference_crc64(input: Slice[byte], polynomial: u64) -> u64 {
    reference_crc64_update(0, polynomial, input)
}

fn reference_crc32_update(previous: u32, polynomial: u32, input: Slice[byte]) -> u32 {
    let mut value = previous ^ 0xffffffff;
    for byte in input {
        for bit in 0..8 {
            let feedback = (value ^ (byte.to_u32() >> bit)) & 1;
            value >>= 1;
            if feedback != 0 {
                value = value ^ polynomial;
            }
        }
    }
    value ^ 0xffffffff
}

fn reference_crc64_update(previous: u64, polynomial: u64, input: Slice[byte]) -> u64 {
    let mut value = previous ^ 0xffffffffffffffff;
    for byte in input {
        for bit in 0..8 {
            let feedback = (value ^ (byte.to_u64() >> bit)) & 1;
            value >>= 1;
            if feedback != 0 {
                value = value ^ polynomial;
            }
        }
    }
    value ^ 0xffffffffffffffff
}

fn reference_fnv(input: Slice[byte], width: isize, alternate: bool) -> bytes::Bytes {
    let offset = if width == 4 {
        b"\xc5\x9d\x1c\x81"
    } else if width == 8 {
        b"\x25\x23\x22\x84\xe4\x9c\xf2\xcb"
    } else {
        b"\x8d\xc5\x95\x62\x75\x21\xb8\x62\x42\x01\xbb\x07\x2e\x27\x62\x6c"
    };
    let prime = if width == 4 {
        b"\x93\x01\x00\x01"
    } else if width == 8 {
        b"\xb3\x01\x00\x00\x00\x01\x00\x00"
    } else {
        b"\x3b\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00"
    };
    let state = offset.copy();
    for byte in input {
        if alternate {
            state[0] = state[0] ^ byte;
        }
        let product: Vec[u64] = Vec::new();
        for _ in 0..width {
            product.push(0);
        }
        for left in 0..width {
            for right in 0..width - left {
                product[left + right] += state[left].to_u64() * prime[right].to_u64();
            }
        }
        for index in 0..width {
            state[index] = product[index].to_u8();
            if index + 1 < width {
                product[index + 1] += product[index] / 256;
            }
        }
        if !alternate {
            state[0] = state[0] ^ byte;
        }
    }
    let result = bytes::Bytes::new();
    for index in 0..width {
        result.push(state[width - 1 - index]);
    }
    result
}
