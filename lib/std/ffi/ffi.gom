package ffi;

use module::bytes;
use module::utf8;
use utf8::BytesUtf8;

pub type Ptr[T] = GoPtr[T];

pub fn null[T]() -> Ptr[T] {
    go_ptr_null()
}

pub fn is_nil[T](value: Ptr[T]) -> bool {
    go_ptr_is_nil(value)
}

pub type Error = GoError;

pub fn nil_error() -> Error {
    go_error_nil()
}

pub fn error_is_nil(value: Error) -> bool {
    go_error_is_nil(value)
}

pub struct NonNilError {
    value: Error,
}

impl NonNilError {
    pub fn from_error(value: Error) -> Option[NonNilError] {
        if error_is_nil(value) {
            Option::None
        } else {
            Option::Some(NonNilError { value })
        }
    }

    pub fn as_error(self: NonNilError) -> Error {
        self.value
    }
}

pub struct Outcome[T] {
    pub value: T,
    pub error: Error,
}

impl[T] Outcome[T] {
    pub fn new(value: T, error: Error) -> Outcome[T] {
        Outcome { value, error }
    }

    pub fn into_result_discarding_value_on_error(self: Outcome[T]) -> Result[T, NonNilError] {
        match NonNilError::from_error(self.error) {
            Some(error) => Result::Err(error),
            None => Result::Ok(self.value),
        }
    }
}

pub enum BoundaryError {
    NilError,
    InvalidRune(i32),
}

impl ToString for BoundaryError {
    fn to_string(self: BoundaryError) -> string {
        match self {
            NilError => "Go FFI boundary rejected Err(nil)",
            InvalidRune(value) => "Go FFI boundary rejected invalid rune " + value.to_string(),
        }
    }
}

impl[T] Outcome[T] {
    pub fn from_raw_result(value: Result[T, Error], failure_value: T) -> Result[
        Outcome[T],
        BoundaryError,
    ] {
        match value {
            Ok(value) => Result::Ok(Outcome::new(value, nil_error())),
            Err(error) => if error_is_nil(error) {
                Result::Err(BoundaryError::NilError)
            } else {
                Result::Ok(Outcome::new(failure_value, error))
            },
        }
    }

    pub fn from_result(value: Result[T, NonNilError], failure_value: T) -> Result[
        Outcome[T],
        BoundaryError,
    ] {
        Outcome::from_raw_result(value.map_err(|error| error.as_error()), failure_value)
    }

    pub fn into_tuple(self: Outcome[T]) -> (T, Error) {
        (self.value, self.error)
    }
}

pub fn error_matches(value: Error, target: Error) -> bool {
    go_error_is(value, target)
}

impl NonNilError {
    pub fn message_bytes(self: NonNilError) -> bytes::Bytes {
        bytes::Bytes::from_vec(go_error_message_bytes(self.value))
    }

    pub fn message(self: NonNilError) -> Result[string, utf8::Utf8Error] {
        self.message_bytes().to_string_utf8()
    }

    pub fn matches(self: NonNilError, target: Error) -> bool {
        error_matches(self.value, target)
    }
}

pub type String = GoString;

pub fn string_from_bytes(value: bytes::Bytes) -> String {
    go_string_from_bytes(value.to_vec())
}

pub fn string_from_text(value: string) -> String {
    go_string_from_text(value)
}

pub fn string_bytes(value: String) -> bytes::Bytes {
    bytes::Bytes::from_vec(go_string_bytes(value))
}

pub fn string_text(value: String) -> Result[string, utf8::Utf8Error] {
    string_bytes(value).to_string_utf8()
}

pub type Rune = i32;

pub fn rune_from_char(value: char) -> Rune {
    value.to_u32().to_i32()
}

pub fn rune_char(value: Rune) -> Result[char, BoundaryError] {
    if value < 0 {
        return Result::Err(BoundaryError::InvalidRune(value))
    }
    match char_from_u32(value.to_u32()) {
        Some(character) => Result::Ok(character),
        None => Result::Err(BoundaryError::InvalidRune(value)),
    }
}

pub type RawSlice[T] = MutSlice[T];

pub fn slice_nil[T]() -> RawSlice[T] {
    go_slice_nil()
}

pub fn slice_is_nil[T](value: RawSlice[T]) -> bool {
    go_slice_is_nil(value)
}

pub fn slice_capacity[T](value: RawSlice[T]) -> isize {
    go_slice_capacity(value)
}

pub fn slice_append[T](value: RawSlice[T], item: T) -> RawSlice[T] {
    go_slice_append(value, item)
}

pub fn slice_shared[T](value: Vec[T]) -> RawSlice[T] {
    mut_slice(value, 0, value.len())
}

pub fn slice_copy[T](value: RawSlice[T]) -> RawSlice[T] {
    slice_shared(slice_to_vec_copy(value))
}

pub fn slice_from_vec_copy[T](value: Vec[T]) -> RawSlice[T] {
    slice_copy(slice_shared(value))
}

pub fn slice_to_vec_copy[T](value: RawSlice[T]) -> Vec[T] {
    let result: Vec[T] = Vec::with_capacity(value.len());
    for index in 0..value.len() {
        result.push(value[index]);
    }
    result
}

pub fn slice_trusted_readonly[T](value: RawSlice[T]) -> Slice[T] {
    mut_slice_as_slice(value)
}

pub type RawMap[K, V] = GoMap[K, V];

pub fn map_nil[K, V]() -> RawMap[K, V] {
    go_map_nil()
}

pub fn map_is_nil[K, V](value: RawMap[K, V]) -> bool {
    go_map_is_nil(value)
}

pub fn map_new[K, V]() -> RawMap[K, V] {
    go_map_new()
}

pub fn map_len[K, V](value: RawMap[K, V]) -> isize {
    go_map_len(value)
}

pub fn map_get[K, V](value: RawMap[K, V], key: K) -> Option[V] {
    let (item, present) = go_map_lookup(value, key);
    if present {
        Option::Some(item)
    } else {
        Option::None
    }
}

pub fn map_set[K, V](value: RawMap[K, V], key: K, item: V) -> () {
    go_map_set(value, key, item)
}

pub fn map_delete[K, V](value: RawMap[K, V], key: K) -> () {
    go_map_delete(value, key)
}

pub fn map_copy[K, V](value: RawMap[K, V]) -> RawMap[K, V] {
    go_map_copy(value)
}

pub type Func[F] = GoFunc[F];

pub fn func_nil[F]() -> Func[F] {
    go_func_nil()
}

pub fn func_is_nil[F](value: Func[F]) -> bool {
    go_func_is_nil(value)
}

pub fn func_from_closure[F](value: F) -> Func[F] {
    go_func_from_closure(value)
}

pub fn func_to_closure[F](value: Func[F]) -> Option[F] {
    if func_is_nil(value) {
        Option::None
    } else {
        Option::Some(go_func_to_closure(value))
    }
}
