package rand;

use module::bytes;
use module::internal::host;

pub fn bytes(length: isize) -> Result[bytes::Bytes, string] {
    if length < 0 {
        Err("random byte length must be non-negative")
    } else {
        let (ok, value, error) = host::crypto_random_bytes(length);
        if ok {
            Ok(bytes::Bytes::from_vec(value))
        } else {
            Err(error)
        }
    }
}
