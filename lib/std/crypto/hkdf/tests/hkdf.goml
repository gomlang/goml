package tests;

use std::bytes;
use std::crypto::hash as crypto_hash;
use std::crypto::hkdf;
use std::encoding::hex;
use std::hash as standard_hash;
use standard_hash::Hasher;
use std::testing;

fn new_sha256() -> crypto_hash::Sha256Digest {
    crypto_hash::Sha256Digest::new256()
}

fn new_sha512() -> crypto_hash::Sha512Digest {
    crypto_hash::Sha512Digest::new512()
}

fn repeated(value: byte, length: isize) -> bytes::Bytes {
    let output = bytes::Bytes::with_capacity(length);
    for _ in 0..length {
        output.push(value)
    }
    output
}

fn pattern(length: isize) -> bytes::Bytes {
    let output = bytes::Bytes::with_capacity(length);
    for index in 0..length {
        output.push(((index * 37 + 11) % 256).to_u8())
    }
    output
}

pub struct InvalidDigest {}

impl Hasher for InvalidDigest {
    fn update(self: InvalidDigest, input: Slice[byte]) -> () {}

    fn reset(self: InvalidDigest) -> () {}

    fn sum(self: InvalidDigest) -> bytes::Bytes {
        bytes::Bytes::new()
    }

    fn size(self: InvalidDigest) -> isize {
        0
    }

    fn block_size(self: InvalidDigest) -> isize {
        64
    }
}

fn new_invalid() -> InvalidDigest {
    InvalidDigest {}
}

fn from_hex(value: string) -> bytes::Bytes {
    testing::expect_ok(hex::decode(value), "decode fixture hex")
}

fn check_rfc_vectors() -> () {
    let input_key = repeated(0x0b, 22);
    let salt = from_hex("000102030405060708090a0b0c");
    let info = from_hex("f0f1f2f3f4f5f6f7f8f9");
    let prk = testing::expect_ok(
        hkdf::extract(new_sha256, salt.as_slice(), input_key.as_slice()),
        "RFC 5869 extract",
    );
    testing::assert_eq(
        hex::encode(prk),
        "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5",
    );
    let okm = testing::expect_ok(
        hkdf::expand(new_sha256, prk.as_slice(), info.as_slice(), 42),
        "RFC 5869 expand",
    );
    testing::assert_eq(
        hex::encode(okm),
        "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865",
    );
    let derived = testing::expect_ok(
        hkdf::derive(new_sha256, salt.as_slice(), input_key.as_slice(), info.as_slice(), 42),
        "RFC 5869 derive",
    );
    testing::assert_eq(hex::encode(derived), hex::encode(okm));
}

fn check_hkdf(salt: bytes::Bytes, input_key: bytes::Bytes, info: bytes::Bytes) -> () {
    let prk = testing::expect_ok(
        hkdf::extract(new_sha256, salt.as_slice(), input_key.as_slice()),
        "HKDF extract",
    );
    testing::assert_eq(hex::encode(prk), expected_extract256(salt.as_slice(), input_key.as_slice()));
    for length in Vec::from_array([0, 1, 31, 32, 33, 42, 63, 64, 65, 127, 8160]) {
        let expanded = testing::expect_ok(
            hkdf::expand(new_sha256, prk.as_slice(), info.as_slice(), length),
            "HKDF expand",
        );
        testing::assert_eq(expanded.len(), length);
        testing::assert_eq(
            hex::encode(expanded),
            expected_expand256(prk.as_slice(), info.as_slice(), length),
        );
        let derived = testing::expect_ok(
            hkdf::derive(new_sha256, salt.as_slice(), input_key.as_slice(), info.as_slice(), length),
            "HKDF derive",
        );
        testing::assert_eq(hex::encode(derived), hex::encode(expanded));
        testing::assert_eq(
            hex::encode(derived),
            expected_derive256(salt.as_slice(), input_key.as_slice(), info.as_slice(), length),
        );
    }
    for length in Vec::from_array([0, 1, 63, 64, 65, 128]) {
        let derived = testing::expect_ok(
            hkdf::derive(new_sha512, salt.as_slice(), input_key.as_slice(), info.as_slice(), length),
            "HKDF-SHA-512 derive",
        );
        testing::assert_eq(
            hex::encode(derived),
            expected_derive512(salt.as_slice(), input_key.as_slice(), info.as_slice(), length),
        );
    }
    testing::assert(hkdf::expand(new_sha256, prk.as_slice(), info.as_slice(), -1).is_err());
    testing::assert(hkdf::expand(new_sha256, prk.as_slice(), info.as_slice(), 8161).is_err());
}

fn check_invalid_digest() -> () {
    let empty = bytes::Bytes::new();
    testing::assert(hkdf::extract(new_invalid, empty.as_slice(), empty.as_slice()).is_err());
    testing::assert(hkdf::expand(new_invalid, empty.as_slice(), empty.as_slice(), 1).is_err());
}

#[test]
fn hkdf_known_answers_and_limits() -> () {
    check_rfc_vectors();
    check_hkdf(bytes::Bytes::new(), bytes::Bytes::new(), bytes::Bytes::new());
    check_hkdf(pattern(17), pattern(81), pattern(39));
    check_invalid_digest();
}
