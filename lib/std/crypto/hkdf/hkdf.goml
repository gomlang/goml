package hkdf;

use module::bytes;
use module::crypto::hmac;
use module::hash as standard_hash;
use standard_hash::Hasher;

pub enum Error {
    InvalidDigest,
    InvalidLength,
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        match self {
            InvalidDigest => "HKDF requires a valid digest",
            InvalidLength => "HKDF output length must be between zero and 255 digest blocks",
        }
    }
}

impl Debug for Error {
    fn debug(self: Error) -> string {
        self.to_string()
    }
}

pub fn extract[H: Hasher](make: () -> H, salt: Slice[byte], input_key: Slice[byte]) -> Result[
    bytes::Bytes,
    Error,
] {
    match hmac::sum(make, salt, input_key) {
        Ok(value) => Result::Ok(value),
        Err(_) => Result::Err(Error::InvalidDigest),
    }
}

pub fn expand[H: Hasher](
    make: () -> H,
    pseudorandom_key: Slice[byte],
    info: Slice[byte],
    length: isize,
) -> Result[bytes::Bytes, Error] {
    if length < 0 {
        return Result::Err(Error::InvalidLength)
    }
    let digest = match hmac::Digest::new(make, pseudorandom_key) {
        Ok(value) => value,
        Err(_) => return Result::Err(Error::InvalidDigest),
    };
    let block_size = digest.size();
    if length > 0 && (length - 1) / block_size >= 255 {
        return Result::Err(Error::InvalidLength)
    }
    let output = bytes::Bytes::with_capacity(length);
    let mut previous = bytes::Bytes::new();
    let mut counter = 1;
    while output.len() < length {
        digest.reset();
        digest.update(previous.as_slice());
        digest.update(info);
        let suffix = Vec::from_array([counter.to_u8()]);
        digest.update(suffix.as_slice());
        previous = digest.sum();
        for item in previous.as_slice() {
            if output.len() == length {
                break
            }
            output.push(item)
        }
        counter += 1;
    }
    Result::Ok(output)
}

pub fn derive[H: Hasher](
    make: () -> H,
    salt: Slice[byte],
    input_key: Slice[byte],
    info: Slice[byte],
    length: isize,
) -> Result[bytes::Bytes, Error] {
    let pseudorandom_key = extract(make, salt, input_key)?;
    expand(make, pseudorandom_key.as_slice(), info, length)
}
