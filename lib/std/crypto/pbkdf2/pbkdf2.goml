package pbkdf2;

use module::bytes;
use module::crypto::hmac;
use module::hash as standard_hash;
use standard_hash::Hasher;

pub const MAX_OUTPUT_BYTES: isize = 1048576;

pub const MAX_ITERATIONS: isize = 1000000;

pub const MAX_PRF_CALLS: isize = 1000000;

pub enum Error {
    InvalidDigest,
    InvalidIterations,
    InvalidLength,
    ResourceLimit,
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        match self {
            Error::InvalidDigest => "PBKDF2 requires a valid fixed-size digest",
            Error::InvalidIterations => "PBKDF2 iterations must be between one and 1000000",
            Error::InvalidLength => "PBKDF2 output length is outside the supported range",
            Error::ResourceLimit => "PBKDF2 work exceeds 1000000 PRF evaluations",
        }
    }
}

impl Debug for Error {
    fn debug(self: Error) -> string {
        self.to_string()
    }
}

pub fn derive[H: Hasher](
    make: () -> H,
    password: Slice[byte],
    salt: Slice[byte],
    iterations: isize,
    length: isize,
) -> Result[bytes::Bytes, Error] {
    if iterations <= 0 || iterations > MAX_ITERATIONS {
        return Result::Err(Error::InvalidIterations)
    }
    if length < 0 || length > MAX_OUTPUT_BYTES {
        return Result::Err(Error::InvalidLength)
    }
    let mac = match hmac::Digest::new(make, password) {
        Ok(value) => value,
        Err(_) => return Result::Err(Error::InvalidDigest),
    };
    let digest_size = mac.size();
    if length > 0 && (length - 1) / digest_size >= 4294967295 {
        return Result::Err(Error::InvalidLength)
    }
    let blocks = if length == 0 {
        0
    } else {
        (length - 1) / digest_size + 1
    };
    if blocks > MAX_PRF_CALLS / iterations {
        return Result::Err(Error::ResourceLimit)
    }
    let output = bytes::Bytes::with_capacity(length);
    for block in 1..blocks + 1 {
        let counter = Vec::from_array(
            [(block >> 24).to_u8(), (block >> 16).to_u8(), (block >> 8).to_u8(), block.to_u8()],
        );
        mac.reset();
        mac.update(salt);
        mac.update(counter.as_slice());
        let mut previous = mac.sum();
        if previous.len() != digest_size {
            return Result::Err(Error::InvalidDigest)
        }
        let accumulated = bytes::Bytes::from_slice_copy(previous.as_slice());
        for _ in 1..iterations {
            mac.reset();
            mac.update(previous.as_slice());
            previous = mac.sum();
            if previous.len() != digest_size {
                return Result::Err(Error::InvalidDigest)
            }
            for index in 0..digest_size {
                accumulated.set(index, accumulated.get(index) ^ previous.get(index))
            }
        }
        for item in accumulated.as_slice() {
            if output.len() == length {
                break
            }
            output.push(item)
        }
    }
    Result::Ok(output)
}
