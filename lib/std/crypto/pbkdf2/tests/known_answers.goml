package tests;

use std::bytes;
use std::encoding::hex;
use std::fs;
use std::testing;

static KNOWN_ANSWERS: OnceCell[HashMap[string, Vec[string]]] = OnceCell::new();

fn known_answer(key: string) -> Vec[string] {
    let answers = KNOWN_ANSWERS.get_or_init(
        || {
            let content = testing::expect_ok(
                fs::read_file_structured("crypto/pbkdf2/tests/known_answers.tsv"),
                "read known answers",
            );
            let values: HashMap[string, Vec[string]] = HashMap::new();
            for line in content.split("\n") {
                if line.byte_len() > 0 {
                    let fields = line.split("\t");
                    let outputs = Vec::new();
                    for index in 1..fields.len() {
                        outputs.push(fields[index]);
                    }
                    testing::assert(!values.contains(fields[0]));
                    values.set(fields[0], outputs);
                }
            }
            values
        },
    );
    testing::expect_some(answers.get(key), "missing known answer: " + key)
}

fn answer_text(value: string) -> string {
    let (valid, text) = string_from_utf8(
        testing::expect_ok(hex::decode(value), "known answer hex").to_vec(),
    );
    testing::assert(valid);
    text
}

fn answer_bytes(value: Slice[byte]) -> string {
    hex::encode(bytes::Bytes::from_slice_copy(value))
}

fn expected_pbkdf2_sha256(
    password: Slice[byte],
    salt: Slice[byte],
    iterations: isize,
    length: isize,
) -> string {
    let values = known_answer(
        "go_pbkdf2_sha256" + "|" + answer_bytes(password) + "|" + answer_bytes(salt) + "|"
            + iterations.to_string()
            + "|"
            + length.to_string(),
    );
    answer_text(values[0])
}

fn expected_pbkdf2_sha512(
    password: Slice[byte],
    salt: Slice[byte],
    iterations: isize,
    length: isize,
) -> string {
    let values = known_answer(
        "go_pbkdf2_sha512" + "|" + answer_bytes(password) + "|" + answer_bytes(salt) + "|"
            + iterations.to_string()
            + "|"
            + length.to_string(),
    );
    answer_text(values[0])
}

fn expected_pbkdf2_sha3_256(
    password: Slice[byte],
    salt: Slice[byte],
    iterations: isize,
    length: isize,
) -> string {
    let values = known_answer(
        "go_pbkdf2_sha3_256" + "|" + answer_bytes(password) + "|" + answer_bytes(salt) + "|"
            + iterations.to_string()
            + "|"
            + length.to_string(),
    );
    answer_text(values[0])
}
