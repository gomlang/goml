package tests;

use std::bytes;
use std::crypto::hash as crypto_hash;
use std::crypto::pbkdf2;
use std::encoding::hex;
use std::hash as standard_hash;
use standard_hash::Hasher;
use std::testing;

fn new_sha256() -> crypto_hash::Sha256Digest {
    crypto_hash::Sha256Digest::new256()
}

fn new_sha512() -> crypto_hash::Sha512Digest {
    crypto_hash::Sha512Digest::new512()
}

fn new_sha3_256() -> crypto_hash::Sha3Digest {
    crypto_hash::Sha3Digest::new256()
}

fn pattern(length: isize) -> bytes::Bytes {
    let output = bytes::Bytes::with_capacity(length);
    for index in 0..length {
        output.push(((index * 37 + 11) % 256).to_u8())
    }
    output
}

fn check_pbkdf2_vectors() -> () {
    let password = bytes::Bytes::from_string("passwd");
    let salt = bytes::Bytes::from_string("salt");
    let value = testing::expect_ok(
        pbkdf2::derive(new_sha256, password.as_slice(), salt.as_slice(), 1, 64),
        "RFC 7914 PBKDF2-SHA256",
    );
    testing::assert_eq(
        hex::encode(value),
        "55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783",
    );
}

fn check_pbkdf2(password: bytes::Bytes, salt: bytes::Bytes) -> () {
    for iterations in Vec::from_array([1, 2, 3, 11, 100]) {
        for length in Vec::from_array([1, 16, 31, 32, 33, 64, 65]) {
            let sha256 = testing::expect_ok(
                pbkdf2::derive(new_sha256, password.as_slice(), salt.as_slice(), iterations, length),
                "PBKDF2-SHA256",
            );
            testing::assert_eq(
                hex::encode(sha256),
                expected_pbkdf2_sha256(password.as_slice(), salt.as_slice(), iterations, length),
            );
            let sha512 = testing::expect_ok(
                pbkdf2::derive(new_sha512, password.as_slice(), salt.as_slice(), iterations, length),
                "PBKDF2-SHA512",
            );
            testing::assert_eq(
                hex::encode(sha512),
                expected_pbkdf2_sha512(password.as_slice(), salt.as_slice(), iterations, length),
            );
        }
    }
    for iterations in Vec::from_array([1, 2, 11]) {
        let output = testing::expect_ok(
            pbkdf2::derive(new_sha3_256, password.as_slice(), salt.as_slice(), iterations, 48),
            "PBKDF2-SHA3-256",
        );
        testing::assert_eq(
            hex::encode(output),
            expected_pbkdf2_sha3_256(password.as_slice(), salt.as_slice(), iterations, 48),
        );
    }
}

fn check_pbkdf2_limits() -> () {
    let password = bytes::Bytes::new();
    let salt = bytes::Bytes::new();
    testing::assert(
        pbkdf2::derive(new_sha256, password.as_slice(), salt.as_slice(), 0, 32).is_err(),
    );
    testing::assert(
        pbkdf2::derive(new_sha256, password.as_slice(), salt.as_slice(), -1, 32).is_err(),
    );
    testing::assert(
        pbkdf2::derive(
            new_sha256,
            password.as_slice(),
            salt.as_slice(),
            pbkdf2::MAX_ITERATIONS + 1,
            32,
        ).is_err(),
    );
    testing::assert(
        pbkdf2::derive(new_sha256, password.as_slice(), salt.as_slice(), 1, -1).is_err(),
    );
    testing::assert(
        pbkdf2::derive(
            new_sha256,
            password.as_slice(),
            salt.as_slice(),
            1,
            pbkdf2::MAX_OUTPUT_BYTES + 1,
        ).is_err(),
    );
    testing::assert(
        pbkdf2::derive(new_sha256, password.as_slice(), salt.as_slice(), pbkdf2::MAX_ITERATIONS, 64).is_err(),
    );
    testing::assert_eq(
        testing::expect_ok(
            pbkdf2::derive(new_sha256, password.as_slice(), salt.as_slice(), 1, 0),
            "PBKDF2 zero output",
        ).len(),
        0,
    );
}

pub struct BadOutputDigest {}

impl Hasher for BadOutputDigest {
    fn update(self: BadOutputDigest, input: Slice[byte]) -> () {}

    fn reset(self: BadOutputDigest) -> () {}

    fn sum(self: BadOutputDigest) -> bytes::Bytes {
        bytes::Bytes::new()
    }

    fn size(self: BadOutputDigest) -> isize {
        1
    }

    fn block_size(self: BadOutputDigest) -> isize {
        1
    }
}

fn new_bad_output() -> BadOutputDigest {
    BadOutputDigest {}
}

#[test]
fn pbkdf2_known_answers_and_limits() -> () {
    check_pbkdf2_vectors();
    check_pbkdf2(bytes::Bytes::new(), bytes::Bytes::new());
    check_pbkdf2(pattern(75), pattern(29));
    check_pbkdf2_limits();
    let empty = bytes::Bytes::new();
    testing::assert(
        pbkdf2::derive(new_bad_output, empty.as_slice(), empty.as_slice(), 1, 1).is_err(),
    );
}
