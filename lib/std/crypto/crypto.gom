package crypto;

use module::bytes;
use module::hash;
use hash::Hasher;

pub fn digest_equal(left: Slice[byte], right: Slice[byte]) -> bool {
    if left.len() != right.len() {
        return false
    }
    let mut difference: byte = 0;
    for index in 0..left.len() {
        difference = difference | (left[index] ^ right[index]);
    }
    difference == 0
}

pub fn verify_digest[H: Hasher](digest: H, expected: Slice[byte]) -> bool {
    let actual = digest.sum();
    digest_equal(actual.as_slice(), expected)
}
