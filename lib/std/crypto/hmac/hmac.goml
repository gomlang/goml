package hmac;

use module::bytes;
use module::crypto;
use module::hash as standard_hash;
use standard_hash::Hasher;

pub enum Error {
    InvalidDigest,
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        "HMAC requires a digest with a positive output size no larger than its block size"
    }
}

impl Debug for Error {
    fn debug(self: Error) -> string {
        self.to_string()
    }
}

pub struct Digest[H] {
    inner: H,
    outer: H,
    inner_pad: bytes::Bytes,
    outer_pad: bytes::Bytes,
}

impl[H: Hasher] Digest[H] {
    pub fn new(make: () -> H, key: Slice[byte]) -> Result[Digest[H], Error] {
        let inner = make();
        let outer = make();
        let block_size = inner.block_size();
        let output_size = inner.size();
        if block_size <= 0 || output_size <= 0 || output_size > block_size
            || outer.block_size() != block_size
            || outer.size() != output_size {
            return Result::Err(Error::InvalidDigest)
        }
        let key_bytes = if key.len() > block_size {
            inner.reset();
            inner.update(key);
            let shortened = inner.sum().to_vec_copy();
            inner.reset();
            shortened
        } else {
            let copied = Vec::with_capacity(key.len());
            for item in key {
                copied.push(item)
            }
            copied
        };
        let inner_pad = bytes::Bytes::with_capacity(block_size);
        let outer_pad = bytes::Bytes::with_capacity(block_size);
        for index in 0..block_size {
            let key_byte = if index < key_bytes.len() {
                key_bytes[index]
            } else {
                0
            };
            inner_pad.push(key_byte ^ 0x36);
            outer_pad.push(key_byte ^ 0x5c);
        }
        inner.reset();
        inner.update(inner_pad.as_slice());
        outer.reset();
        Result::Ok(Digest { inner, outer, inner_pad, outer_pad })
    }

    pub fn verify(self: Digest[H], expected: Slice[byte]) -> bool {
        crypto::verify_digest(self, expected)
    }
}

impl[H: Hasher] Hasher for Digest[H] {
    fn update(self: Digest[H], input: Slice[byte]) -> () {
        self.inner.update(input)
    }

    fn reset(self: Digest[H]) -> () {
        self.inner.reset();
        self.inner.update(self.inner_pad.as_slice());
        self.outer.reset()
    }

    fn sum(self: Digest[H]) -> bytes::Bytes {
        let inner_sum = self.inner.sum();
        self.outer.reset();
        self.outer.update(self.outer_pad.as_slice());
        self.outer.update(inner_sum.as_slice());
        self.outer.sum()
    }

    fn size(self: Digest[H]) -> isize {
        self.inner.size()
    }

    fn block_size(self: Digest[H]) -> isize {
        self.inner_pad.len()
    }
}

pub fn sum[H: Hasher](make: () -> H, key: Slice[byte], input: Slice[byte]) -> Result[
    bytes::Bytes,
    Error,
] {
    let digest = Digest::new(make, key)?;
    digest.update(input);
    Result::Ok(digest.sum())
}
