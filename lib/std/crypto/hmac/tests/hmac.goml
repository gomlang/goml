package tests;

use std::bytes;
use std::crypto;
use std::crypto::hash as crypto_hash;
use std::crypto::hmac;
use std::encoding::hex;
use std::hash as standard_hash;
use standard_hash::Hasher;
use std::testing;

fn new_sha256() -> crypto_hash::Sha256Digest {
    crypto_hash::Sha256Digest::new256()
}

fn new_sha512() -> crypto_hash::Sha512Digest {
    crypto_hash::Sha512Digest::new512()
}

fn repeated(value: byte, length: isize) -> bytes::Bytes {
    let output = bytes::Bytes::with_capacity(length);
    for _ in 0..length {
        output.push(value)
    }
    output
}

fn pattern(length: isize) -> bytes::Bytes {
    let output = bytes::Bytes::with_capacity(length);
    for index in 0..length {
        output.push(((index * 37 + 11) % 256).to_u8())
    }
    output
}

pub struct InvalidDigest {}

impl Hasher for InvalidDigest {
    fn update(self: InvalidDigest, input: Slice[byte]) -> () {}

    fn reset(self: InvalidDigest) -> () {}

    fn sum(self: InvalidDigest) -> bytes::Bytes {
        bytes::Bytes::new()
    }

    fn size(self: InvalidDigest) -> isize {
        0
    }

    fn block_size(self: InvalidDigest) -> isize {
        64
    }
}

fn new_invalid() -> InvalidDigest {
    InvalidDigest {}
}

fn check_rfc_vectors() -> () {
    let hmac_key = repeated(0x0b, 20);
    let hmac_message = bytes::Bytes::from_string("Hi There");
    let hmac_value = testing::expect_ok(
        hmac::sum(new_sha256, hmac_key.as_slice(), hmac_message.as_slice()),
        "RFC 4231 HMAC-SHA-256",
    );
    testing::assert_eq(
        hex::encode(hmac_value),
        "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7",
    );
}

fn check_hmac(key: bytes::Bytes, message: bytes::Bytes) -> () {
    let first = testing::expect_ok(
        hmac::sum(new_sha256, key.as_slice(), message.as_slice()),
        "HMAC-SHA-256 one-shot",
    );
    let second = testing::expect_ok(
        hmac::sum(new_sha512, key.as_slice(), message.as_slice()),
        "HMAC-SHA-512 one-shot",
    );
    testing::assert_eq(hex::encode(first), expected_hmac256(key.as_slice(), message.as_slice()));
    testing::assert_eq(hex::encode(second), expected_hmac512(key.as_slice(), message.as_slice()));
    testing::assert(crypto::digest_equal(first.as_slice(), first.as_slice()));
    testing::assert(!crypto::digest_equal(first.as_slice(), message.as_slice()));
    testing::assert(!crypto::digest_equal(first.as_slice(), second.as_slice()));
    let raw = crypto_hash::Sha256Digest::new256();
    raw.update(message.as_slice());
    let raw_sum = raw.sum();
    testing::assert(crypto::verify_digest(raw, raw_sum.as_slice()));
    let digest = testing::expect_ok(hmac::Digest::new(new_sha256, key.as_slice()), "new HMAC");
    let midpoint = message.len() / 2;
    digest.update(message.slice(0, midpoint));
    let partial = digest.sum();
    testing::assert_eq(
        hex::encode(partial),
        expected_hmac256(key.as_slice(), message.slice(0, midpoint)),
    );
    digest.update(message.slice(midpoint, message.len()));
    testing::assert_eq(hex::encode(digest.sum()), hex::encode(first));
    testing::assert_eq(hex::encode(digest.sum()), hex::encode(first));
    testing::assert(digest.verify(first.as_slice()));
    let wrong = bytes::Bytes::from_slice_copy(first.as_slice());
    wrong.set(0, wrong.get(0) ^ 1);
    testing::assert(!digest.verify(wrong.as_slice()));
    testing::assert(!digest.verify(message.as_slice()));
    digest.reset();
    testing::assert_eq(
        hex::encode(digest.sum()),
        expected_hmac256(key.as_slice(), bytes::Bytes::new().as_slice()),
    );
    digest.update(message.as_slice());
    testing::assert_eq(hex::encode(digest.sum()), hex::encode(first));
    testing::assert_eq(digest.size(), 32);
    testing::assert_eq(digest.block_size(), 64);
}

fn check_invalid_digest() -> () {
    let empty = bytes::Bytes::new();
    testing::assert(hmac::Digest::new(new_invalid, empty.as_slice()).is_err());
    testing::assert(hmac::sum(new_invalid, empty.as_slice(), empty.as_slice()).is_err());
}

#[test]
fn hmac_known_answers_and_streaming() -> () {
    check_rfc_vectors();
    for key_length in Vec::from_array([0, 1, 20, 64, 65, 128, 129]) {
        for message_length in Vec::from_array([0, 1, 3, 55, 56, 64, 65, 129]) {
            check_hmac(pattern(key_length), pattern(message_length));
        }
    }
    check_invalid_digest();
}
