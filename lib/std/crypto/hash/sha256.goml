package hash;

use module::bytes;
use module::hash as standard_hash;
use standard_hash::Hasher;

const SHA256_K: [u32; 64] = [
    0x428a2f98,
    0x71374491,
    0xb5c0fbcf,
    0xe9b5dba5,
    0x3956c25b,
    0x59f111f1,
    0x923f82a4,
    0xab1c5ed5,
    0xd807aa98,
    0x12835b01,
    0x243185be,
    0x550c7dc3,
    0x72be5d74,
    0x80deb1fe,
    0x9bdc06a7,
    0xc19bf174,
    0xe49b69c1,
    0xefbe4786,
    0x0fc19dc6,
    0x240ca1cc,
    0x2de92c6f,
    0x4a7484aa,
    0x5cb0a9dc,
    0x76f988da,
    0x983e5152,
    0xa831c66d,
    0xb00327c8,
    0xbf597fc7,
    0xc6e00bf3,
    0xd5a79147,
    0x06ca6351,
    0x14292967,
    0x27b70a85,
    0x2e1b2138,
    0x4d2c6dfc,
    0x53380d13,
    0x650a7354,
    0x766a0abb,
    0x81c2c92e,
    0x92722c85,
    0xa2bfe8a1,
    0xa81a664b,
    0xc24b8b70,
    0xc76c51a3,
    0xd192e819,
    0xd6990624,
    0xf40e3585,
    0x106aa070,
    0x19a4c116,
    0x1e376c08,
    0x2748774c,
    0x34b0bcb5,
    0x391c0cb3,
    0x4ed8aa4a,
    0x5b9cca4f,
    0x682e6ff3,
    0x748f82ee,
    0x78a5636f,
    0x84c87814,
    0x8cc70208,
    0x90befffa,
    0xa4506ceb,
    0xbef9a3f7,
    0xc67178f2,
];

pub enum Sha256Variant {
    Sha224,
    Sha256,
}

pub struct Sha256Digest {
    state: Ref[Vec[u32]],
    buffer: Ref[Vec[byte]],
    length: Ref[u64],
    variant: Sha256Variant,
}

fn rotate_right32(value: u32, count: isize) -> u32 {
    (value >> count) | (value << (32 - count))
}

fn initial256(variant: Sha256Variant) -> Vec[u32] {
    match variant {
        Sha256Variant::Sha224 => Vec::from_array(
            [
                0xc1059ed8,
                0x367cd507,
                0x3070dd17,
                0xf70e5939,
                0xffc00b31,
                0x68581511,
                0x64f98fa7,
                0xbefa4fa4,
            ],
        ),
        Sha256Variant::Sha256 => Vec::from_array(
            [
                0x6a09e667,
                0xbb67ae85,
                0x3c6ef372,
                0xa54ff53a,
                0x510e527f,
                0x9b05688c,
                0x1f83d9ab,
                0x5be0cd19,
            ],
        ),
    }
}

fn compress256(state: Vec[u32], block: Vec[byte]) -> () {
    let words = Vec::with_capacity(64);
    for index in 0..16 {
        let offset = index * 4;
        words.push(
            (block[offset].to_u32() << 24) | (block[offset + 1].to_u32() << 16)
                | (block[offset + 2].to_u32() << 8)
                | block[offset + 3].to_u32(),
        )
    }
    for index in 16..64 {
        let left = words[index - 15];
        let right = words[index - 2];
        let small0 = rotate_right32(left, 7) ^ rotate_right32(left, 18) ^ (left >> 3);
        let small1 = rotate_right32(right, 17) ^ rotate_right32(right, 19) ^ (right >> 10);
        words.push(words[index - 16] + small0 + words[index - 7] + small1)
    }
    let mut a = state[0];
    let mut b = state[1];
    let mut c = state[2];
    let mut d = state[3];
    let mut e = state[4];
    let mut f = state[5];
    let mut g = state[6];
    let mut h = state[7];
    for index in 0..64 {
        let big1 = rotate_right32(e, 6) ^ rotate_right32(e, 11) ^ rotate_right32(e, 25);
        let choose = (e & f) ^ (~e & g);
        let first = h + big1 + choose + SHA256_K[index] + words[index];
        let big0 = rotate_right32(a, 2) ^ rotate_right32(a, 13) ^ rotate_right32(a, 22);
        let majority = (a & b) ^ (a & c) ^ (b & c);
        let second = big0 + majority;
        h = g;
        g = f;
        f = e;
        e = d + first;
        d = c;
        c = b;
        b = a;
        a = first + second;
    }
    state[0] = state[0] + a;
    state[1] = state[1] + b;
    state[2] = state[2] + c;
    state[3] = state[3] + d;
    state[4] = state[4] + e;
    state[5] = state[5] + f;
    state[6] = state[6] + g;
    state[7] = state[7] + h;
}

impl Sha256Digest {
    pub fn new224() -> Sha256Digest {
        Sha256Digest::new(Sha256Variant::Sha224)
    }

    pub fn new256() -> Sha256Digest {
        Sha256Digest::new(Sha256Variant::Sha256)
    }

    pub fn new(variant: Sha256Variant) -> Sha256Digest {
        Sha256Digest {
            state: Ref::new(initial256(variant)),
            buffer: Ref::new(Vec::new()),
            length: Ref::new(0),
            variant,
        }
    }

    pub fn copy(self: Sha256Digest) -> Sha256Digest {
        let state = Vec::with_capacity(8);
        for word in self.state.get() {
            state.push(word)
        }
        let buffer = Vec::with_capacity(self.buffer.get().len());
        for item in self.buffer.get() {
            buffer.push(item)
        }
        Sha256Digest {
            state: Ref::new(state),
            buffer: Ref::new(buffer),
            length: Ref::new(self.length.get()),
            variant: self.variant,
        }
    }

    fn finish(self: Sha256Digest) -> bytes::Bytes {
        let bit_length = self.length.get() << 3;
        let length = self.buffer.get().len();
        let padding = Vec::new();
        padding.push(0x80);
        let zeros = if length < 56 {
            55 - length
        } else {
            119 - length
        };
        for _ in 0..zeros {
            padding.push(0)
        }
        self.update(padding.as_slice());
        let tail = Vec::with_capacity(8);
        for index in 0..8 {
            tail.push((bit_length >> ((7 - index) * 8)).to_u8())
        }
        self.update(tail.as_slice());
        let output = Vec::with_capacity(self.size());
        let words = if self.size() == 28 {
            7
        } else {
            8
        };
        for index in 0..words {
            let word = self.state.get()[index];
            for offset in 0..4 {
                output.push((word >> ((3 - offset) * 8)).to_u8())
            }
        }
        bytes::Bytes::from_vec(output)
    }
}

impl Hasher for Sha256Digest {
    fn update(self: Sha256Digest, input: Slice[byte]) -> () {
        self.length.set(self.length.get() + input.len().to_u64());
        let mut buffer = self.buffer.get();
        let state = self.state.get();
        for item in input {
            buffer.push(item);
            if buffer.len() == 64 {
                compress256(state, buffer);
                buffer = Vec::new();
            }
        }
        self.buffer.set(buffer)
    }

    fn reset(self: Sha256Digest) -> () {
        self.state.set(initial256(self.variant));
        self.buffer.set(Vec::new());
        self.length.set(0)
    }

    fn sum(self: Sha256Digest) -> bytes::Bytes {
        self.copy().finish()
    }

    fn size(self: Sha256Digest) -> isize {
        match self.variant {
            Sha256Variant::Sha224 => 28,
            Sha256Variant::Sha256 => 32,
        }
    }

    fn block_size(self: Sha256Digest) -> isize {
        64
    }
}
