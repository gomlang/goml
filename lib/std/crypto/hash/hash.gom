package hash;

use module::bytes;
use module::fs;
use module::text;
use module::hash as standard_hash;
use standard_hash::Hasher;

fn hex_digit(value: byte) -> string {
    let index = value.to_isize();
    "0123456789abcdef".byte_slice(index, index + 1)
}

fn hex_bytes(value: bytes::Bytes) -> string {
    let output = text::StringBuilder::with_capacity(value.len() * 2);
    for index in 0..value.len() {
        let item = value.get(index);
        output.write_string(hex_digit(item >> 4));
        output.write_string(hex_digit(item & 0x0f));
    }
    output.finish()
}

pub fn sha224(value: bytes::Bytes) -> string {
    let digest = Sha256Digest::new224();
    digest.update(value.as_slice());
    hex_bytes(digest.sum())
}

pub fn sha256(value: bytes::Bytes) -> string {
    let digest = Sha256Digest::new256();
    digest.update(value.as_slice());
    hex_bytes(digest.sum())
}

pub fn sha384(value: bytes::Bytes) -> string {
    let digest = Sha512Digest::new384();
    digest.update(value.as_slice());
    hex_bytes(digest.sum())
}

pub fn sha512(value: bytes::Bytes) -> string {
    let digest = Sha512Digest::new512();
    digest.update(value.as_slice());
    hex_bytes(digest.sum())
}

pub fn sha512_224(value: bytes::Bytes) -> string {
    let digest = Sha512Digest::new512_224();
    digest.update(value.as_slice());
    hex_bytes(digest.sum())
}

pub fn sha512_256(value: bytes::Bytes) -> string {
    let digest = Sha512Digest::new512_256();
    digest.update(value.as_slice());
    hex_bytes(digest.sum())
}

pub fn sha3_224(value: bytes::Bytes) -> string {
    let digest = Sha3Digest::new224();
    digest.update(value.as_slice());
    hex_bytes(digest.sum())
}

pub fn sha3_256(value: bytes::Bytes) -> string {
    let digest = Sha3Digest::new256();
    digest.update(value.as_slice());
    hex_bytes(digest.sum())
}

pub fn sha3_384(value: bytes::Bytes) -> string {
    let digest = Sha3Digest::new384();
    digest.update(value.as_slice());
    hex_bytes(digest.sum())
}

pub fn sha3_512(value: bytes::Bytes) -> string {
    let digest = Sha3Digest::new512();
    digest.update(value.as_slice());
    hex_bytes(digest.sum())
}

pub fn sha256_file(path: string) -> Result[string, fs::Error] {
    let value = fs::read_bytes_structured(path)?;
    Result::Ok(sha256(value))
}
