pub enum Sha512Variant {
    Sha384,
    Sha512,
    Sha512_224,
    Sha512_256,
}

pub struct Sha512Digest {
    state: Ref[Vec[u64]],
    buffer: Ref[Vec[byte]],
    length_high: Ref[u64],
    length_low: Ref[u64],
    variant: Sha512Variant,
}

fn rotate_right64(value: u64, count: isize) -> u64 {
    (value >> count) | (value << (64 - count))
}

fn initial512(variant: Sha512Variant) -> Vec[u64] {
    match variant {
        Sha512Variant::Sha384 => Vec::from_array(
            [
                0xcbbb9d5dc1059ed8,
                0x629a292a367cd507,
                0x9159015a3070dd17,
                0x152fecd8f70e5939,
                0x67332667ffc00b31,
                0x8eb44a8768581511,
                0xdb0c2e0d64f98fa7,
                0x47b5481dbefa4fa4,
            ],
        ),
        Sha512Variant::Sha512 => Vec::from_array(
            [
                0x6a09e667f3bcc908,
                0xbb67ae8584caa73b,
                0x3c6ef372fe94f82b,
                0xa54ff53a5f1d36f1,
                0x510e527fade682d1,
                0x9b05688c2b3e6c1f,
                0x1f83d9abfb41bd6b,
                0x5be0cd19137e2179,
            ],
        ),
        Sha512Variant::Sha512_224 => Vec::from_array(
            [
                0x8c3d37c819544da2,
                0x73e1996689dcd4d6,
                0x1dfab7ae32ff9c82,
                0x679dd514582f9fcf,
                0x0f6d2b697bd44da8,
                0x77e36f7304c48942,
                0x3f9d85a86a1d36c8,
                0x1112e6ad91d692a1,
            ],
        ),
        Sha512Variant::Sha512_256 => Vec::from_array(
            [
                0x22312194fc2bf72c,
                0x9f555fa3c84c64c2,
                0x2393b86b6f53b151,
                0x963877195940eabd,
                0x96283ee2a88effe3,
                0xbe5e1e2553863992,
                0x2b0199fc2c85b8aa,
                0x0eb72ddc81c52ca2,
            ],
        ),
    }
}

fn compress512(state: Vec[u64], block: Vec[byte]) -> () {
    let words = Vec::with_capacity(80);
    for index in 0..16 {
        let offset = index * 8;
        let mut word = 0;
        for part in 0..8 {
            word = (word << 8) | block[offset + part].to_u64();
        }
        words.push(word)
    }
    for index in 16..80 {
        let left = words[index - 15];
        let right = words[index - 2];
        let small0 = rotate_right64(left, 1) ^ rotate_right64(left, 8) ^ (left >> 7);
        let small1 = rotate_right64(right, 19) ^ rotate_right64(right, 61) ^ (right >> 6);
        words.push(words[index - 16] + small0 + words[index - 7] + small1)
    }
    let mut a = state[0];
    let mut b = state[1];
    let mut c = state[2];
    let mut d = state[3];
    let mut e = state[4];
    let mut f = state[5];
    let mut g = state[6];
    let mut h = state[7];
    for index in 0..80 {
        let big1 = rotate_right64(e, 14) ^ rotate_right64(e, 18) ^ rotate_right64(e, 41);
        let choose = (e & f) ^ (~e & g);
        let first = h + big1 + choose + SHA512_K[index] + words[index];
        let big0 = rotate_right64(a, 28) ^ rotate_right64(a, 34) ^ rotate_right64(a, 39);
        let majority = (a & b) ^ (a & c) ^ (b & c);
        let second = big0 + majority;
        h = g;
        g = f;
        f = e;
        e = d + first;
        d = c;
        c = b;
        b = a;
        a = first + second;
    }
    state[0] = state[0] + a;
    state[1] = state[1] + b;
    state[2] = state[2] + c;
    state[3] = state[3] + d;
    state[4] = state[4] + e;
    state[5] = state[5] + f;
    state[6] = state[6] + g;
    state[7] = state[7] + h;
}

impl Sha512Digest {
    pub fn new384() -> Sha512Digest {
        Sha512Digest::new(Sha512Variant::Sha384)
    }

    pub fn new512() -> Sha512Digest {
        Sha512Digest::new(Sha512Variant::Sha512)
    }

    pub fn new512_224() -> Sha512Digest {
        Sha512Digest::new(Sha512Variant::Sha512_224)
    }

    pub fn new512_256() -> Sha512Digest {
        Sha512Digest::new(Sha512Variant::Sha512_256)
    }

    pub fn new(variant: Sha512Variant) -> Sha512Digest {
        Sha512Digest {
            state: Ref::new(initial512(variant)),
            buffer: Ref::new(Vec::new()),
            length_high: Ref::new(0),
            length_low: Ref::new(0),
            variant,
        }
    }

    pub fn copy(self: Sha512Digest) -> Sha512Digest {
        let state = Vec::with_capacity(8);
        for word in self.state.get() {
            state.push(word)
        }
        let buffer = Vec::with_capacity(self.buffer.get().len());
        for item in self.buffer.get() {
            buffer.push(item)
        }
        Sha512Digest {
            state: Ref::new(state),
            buffer: Ref::new(buffer),
            length_high: Ref::new(self.length_high.get()),
            length_low: Ref::new(self.length_low.get()),
            variant: self.variant,
        }
    }

    fn finish(self: Sha512Digest) -> bytes::Bytes {
        let bit_high = (self.length_high.get() << 3) | (self.length_low.get() >> 61);
        let bit_low = self.length_low.get() << 3;
        let length = self.buffer.get().len();
        let padding = Vec::new();
        padding.push(0x80);
        let zeros = if length < 112 {
            111 - length
        } else {
            239 - length
        };
        for _ in 0..zeros {
            padding.push(0)
        }
        self.update(padding.as_slice());
        let tail = Vec::with_capacity(16);
        for index in 0..8 {
            tail.push((bit_high >> ((7 - index) * 8)).to_u8())
        }
        for index in 0..8 {
            tail.push((bit_low >> ((7 - index) * 8)).to_u8())
        }
        self.update(tail.as_slice());
        let output = Vec::with_capacity(self.size());
        for index in 0..8 {
            let word = self.state.get()[index];
            for offset in 0..8 {
                if output.len() < self.size() {
                    output.push((word >> ((7 - offset) * 8)).to_u8())
                }
            }
        }
        bytes::Bytes::from_vec(output)
    }
}

impl Hasher for Sha512Digest {
    fn update(self: Sha512Digest, input: Slice[byte]) -> () {
        let old_low = self.length_low.get();
        let next_low = old_low + input.len().to_u64();
        self.length_low.set(next_low);
        if next_low < old_low {
            self.length_high.set(self.length_high.get() + 1)
        }
        let mut buffer = self.buffer.get();
        let state = self.state.get();
        for item in input {
            buffer.push(item);
            if buffer.len() == 128 {
                compress512(state, buffer);
                buffer = Vec::new();
            }
        }
        self.buffer.set(buffer)
    }

    fn reset(self: Sha512Digest) -> () {
        self.state.set(initial512(self.variant));
        self.buffer.set(Vec::new());
        self.length_high.set(0);
        self.length_low.set(0)
    }

    fn sum(self: Sha512Digest) -> bytes::Bytes {
        self.copy().finish()
    }

    fn size(self: Sha512Digest) -> isize {
        match self.variant {
            Sha512Variant::Sha384 => 48,
            Sha512Variant::Sha512 => 64,
            Sha512Variant::Sha512_224 => 28,
            Sha512Variant::Sha512_256 => 32,
        }
    }

    fn block_size(self: Sha512Digest) -> isize {
        128
    }
}
