package tests;

use std::bytes;
use std::encoding::hex;
use std::fs;
use std::testing;

static SHA2_KNOWN_ANSWERS: OnceCell[HashMap[string, Vec[string]]] = OnceCell::new();

fn sha2_known_answer(key: string) -> Vec[string] {
    let answers = SHA2_KNOWN_ANSWERS.get_or_init(
        || {
            let content = testing::expect_ok(
                fs::read_file_structured("crypto/hash/tests/sha2_known_answers.tsv"),
                "read known answers",
            );
            let values: HashMap[string, Vec[string]] = HashMap::new();
            for line in content.split("\n") {
                if line.byte_len() > 0 {
                    let fields = line.split("\t");
                    let outputs = Vec::new();
                    for index in 1..fields.len() {
                        outputs.push(fields[index]);
                    }
                    testing::assert(!values.contains(fields[0]));
                    values.set(fields[0], outputs);
                }
            }
            values
        },
    );
    testing::expect_some(answers.get(key), "missing known answer: " + key)
}

fn sha2_answer_text(value: string) -> string {
    let (valid, text) = string_from_utf8(
        testing::expect_ok(hex::decode(value), "known answer hex").to_vec(),
    );
    testing::assert(valid);
    text
}

fn sha2_answer_bytes(value: Slice[byte]) -> string {
    hex::encode(bytes::Bytes::from_slice_copy(value))
}

fn sha2_expected_sum224(value: Slice[byte]) -> string {
    let values = sha2_known_answer("go_sum224" + "|" + sha2_answer_bytes(value));
    sha2_answer_text(values[0])
}

fn sha2_expected_sum256(value: Slice[byte]) -> string {
    let values = sha2_known_answer("go_sum256" + "|" + sha2_answer_bytes(value));
    sha2_answer_text(values[0])
}

fn sha2_expected_sum384(value: Slice[byte]) -> string {
    let values = sha2_known_answer("go_sum384" + "|" + sha2_answer_bytes(value));
    sha2_answer_text(values[0])
}

fn sha2_expected_sum512(value: Slice[byte]) -> string {
    let values = sha2_known_answer("go_sum512" + "|" + sha2_answer_bytes(value));
    sha2_answer_text(values[0])
}

fn sha2_expected_sum512_224(value: Slice[byte]) -> string {
    let values = sha2_known_answer("go_sum512_224" + "|" + sha2_answer_bytes(value));
    sha2_answer_text(values[0])
}

fn sha2_expected_sum512_256(value: Slice[byte]) -> string {
    let values = sha2_known_answer("go_sum512_256" + "|" + sha2_answer_bytes(value));
    sha2_answer_text(values[0])
}
