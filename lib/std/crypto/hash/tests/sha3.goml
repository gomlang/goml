package tests;

use std::bytes;
use std::crypto::hash as crypto_hash;
use std::encoding::hex;
use std::hash as standard_hash;
use standard_hash::Hasher;
use std::testing;

fn pattern(length: isize) -> bytes::Bytes {
    let output = bytes::Bytes::with_capacity(length);
    for index in 0..length {
        output.push(((index * 37 + 11) % 256).to_u8())
    }
    output
}

fn check_nist_vectors() -> () {
    let empty = bytes::Bytes::new();
    testing::assert_eq(
        crypto_hash::sha3_224(empty),
        "6b4e03423667dbb73b6e15454f0eb1abd4597f9a1b078e3f5b5a6bc7",
    );
    testing::assert_eq(
        crypto_hash::sha3_256(empty),
        "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a",
    );
    testing::assert_eq(
        crypto_hash::sha3_384(empty),
        "0c63a75b845e4f7d01107d852e4c2485c51a50aaaa94fc61995e71bbee983a2ac3713831264adb47fb6bd1e058d5f004",
    );
    testing::assert_eq(
        crypto_hash::sha3_512(empty),
        "a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26",
    );
    let shake = crypto_hash::ShakeDigest::new128();
    testing::assert_eq(
        hex::encode(testing::expect_ok(shake.squeeze(32), "SHAKE128 empty")),
        "7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26",
    );
}

fn check_sha3(value: bytes::Bytes) -> () {
    testing::assert_eq(crypto_hash::sha3_224(value), sha3_expected_sum224(value.as_slice()));
    testing::assert_eq(crypto_hash::sha3_256(value), sha3_expected_sum256(value.as_slice()));
    testing::assert_eq(crypto_hash::sha3_384(value), sha3_expected_sum384(value.as_slice()));
    testing::assert_eq(crypto_hash::sha3_512(value), sha3_expected_sum512(value.as_slice()));
    let midpoint = value.len() / 2;
    let digest = crypto_hash::Sha3Digest::new256();
    digest.update(value.slice(0, midpoint));
    testing::assert_eq(hex::encode(digest.sum()), sha3_expected_sum256(value.slice(0, midpoint)));
    let independent = digest.copy();
    independent.update(bytes::Bytes::from_string("!").as_slice());
    digest.update(value.slice(midpoint, value.len()));
    testing::assert_eq(hex::encode(digest.sum()), sha3_expected_sum256(value.as_slice()));
    testing::assert_eq(hex::encode(digest.sum()), sha3_expected_sum256(value.as_slice()));
    testing::assert(independent.sum().len() == 32);
    digest.reset();
    testing::assert_eq(
        hex::encode(digest.sum()),
        sha3_expected_sum256(bytes::Bytes::new().as_slice()),
    );
    testing::assert_eq(digest.size(), 32);
    testing::assert_eq(digest.block_size(), 136);
}

fn check_shake(value: bytes::Bytes, length: isize) -> () {
    let first = crypto_hash::ShakeDigest::new128();
    let second = crypto_hash::ShakeDigest::new256();
    let midpoint = value.len() / 2;
    testing::expect_ok(first.absorb(value.slice(0, midpoint)), "SHAKE128 first chunk");
    testing::expect_ok(first.absorb(value.slice(midpoint, value.len())), "SHAKE128 second chunk");
    testing::expect_ok(second.absorb(value.as_slice()), "SHAKE256 absorb");
    let prefix = testing::expect_ok(first.squeeze(length / 2), "SHAKE128 prefix");
    let suffix = testing::expect_ok(first.squeeze(length - prefix.len()), "SHAKE128 suffix");
    let joined = bytes::Bytes::from_slice_copy(prefix.as_slice());
    joined.extend_from_slice(suffix.as_slice());
    testing::assert_eq(hex::encode(joined), sha3_expected_shake128(value.as_slice(), length));
    testing::assert_eq(
        hex::encode(testing::expect_ok(second.squeeze(length), "SHAKE256 output")),
        sha3_expected_shake256(value.as_slice(), length),
    );
    testing::assert(first.absorb(value.as_slice()).is_err());
    testing::assert(second.absorb(value.as_slice()).is_err());
    let copy = first.copy();
    testing::assert_eq(
        hex::encode(testing::expect_ok(copy.squeeze(13), "SHAKE clone continuation")),
        hex::encode(testing::expect_ok(first.squeeze(13), "SHAKE continuation")),
    );
    first.reset();
    testing::expect_ok(first.absorb(value.as_slice()), "SHAKE absorb after reset");
    testing::assert_eq(
        hex::encode(testing::expect_ok(first.squeeze(length), "SHAKE after reset")),
        sha3_expected_shake128(value.as_slice(), length),
    );
}

fn check_shake_limits() -> () {
    let value = bytes::Bytes::from_string("abc");
    let zero = crypto_hash::ShakeDigest::new256();
    testing::assert_eq(testing::expect_ok(zero.squeeze(0), "SHAKE zero squeeze").len(), 0);
    testing::assert(zero.absorb(value.as_slice()).is_err());
    zero.reset();
    testing::expect_ok(zero.absorb(value.as_slice()), "SHAKE absorb after zero-squeeze reset");
    let shake = crypto_hash::ShakeDigest::new128();
    testing::assert(shake.squeeze(-1).is_err());
    testing::assert(shake.squeeze(crypto_hash::MAX_SHAKE_OUTPUT_BYTES + 1).is_err());
    testing::expect_ok(shake.absorb(value.as_slice()), "SHAKE absorb after rejected squeeze");
    let output = testing::expect_ok(
        shake.squeeze(crypto_hash::MAX_SHAKE_OUTPUT_BYTES),
        "SHAKE maximum single squeeze",
    );
    testing::assert_eq(output.len(), crypto_hash::MAX_SHAKE_OUTPUT_BYTES);
    testing::assert_eq(
        hex::encode(bytes::Bytes::from_slice_copy(output.slice(0, 32))),
        sha3_expected_shake128(value.as_slice(), 32),
    );
    testing::assert(shake.absorb(value.as_slice()).is_err());
}

#[test]
fn sha3_and_shake_known_answers() -> () {
    check_nist_vectors();
    for length in Vec::from_array(
        [0, 1, 3, 71, 72, 103, 104, 105, 135, 136, 137, 143, 144, 145, 168, 169, 256],
    ) {
        check_sha3(pattern(length));
        check_shake(pattern(length), 400);
    }
    check_shake_limits();
}
