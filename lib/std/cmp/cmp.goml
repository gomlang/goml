package cmp;

pub use prelude::{Ordering};

pub trait PartialOrd: PartialEq {
    fn partial_cmp(self: Self, other: Self) -> Option[Ordering];
    fn lt(self: Self, other: Self) -> bool {
        match self.partial_cmp(other) {
            Option::Some(ordering) => ordering == Ordering::Less,
            Option::None => false,
        }
    }
    fn le(self: Self, other: Self) -> bool {
        match self.partial_cmp(other) {
            Option::Some(ordering) => ordering != Ordering::Greater,
            Option::None => false,
        }
    }
    fn gt(self: Self, other: Self) -> bool {
        match self.partial_cmp(other) {
            Option::Some(ordering) => ordering == Ordering::Greater,
            Option::None => false,
        }
    }
    fn ge(self: Self, other: Self) -> bool {
        match self.partial_cmp(other) {
            Option::Some(ordering) => ordering != Ordering::Less,
            Option::None => false,
        }
    }
}

impl PartialOrd for Ordering {
    fn partial_cmp(self: Ordering, other: Ordering) -> Option[Ordering] {
        Option::Some(
            if self == other {
                Ordering::Equal
            } else {
                match self {
                    Ordering::Less => Ordering::Less,
                    Ordering::Equal => if other == Ordering::Greater {
                        Ordering::Less
                    } else {
                        Ordering::Greater
                    },
                    Ordering::Greater => Ordering::Greater,
                }
            },
        )
    }
}

pub trait Ord: Eq + PartialOrd {
    fn cmp(self: Self, other: Self) -> Ordering;
}

impl Ord for Ordering {
    fn cmp(self: Ordering, other: Ordering) -> Ordering {
        if self == other {
            Ordering::Equal
        } else {
            match self {
                Ordering::Less => Ordering::Less,
                Ordering::Equal => if other == Ordering::Greater {
                    Ordering::Less
                } else {
                    Ordering::Greater
                },
                Ordering::Greater => Ordering::Greater,
            }
        }
    }
}

impl Ord for () {
    fn cmp(self: (), other: ()) -> Ordering {
        Ordering::Equal
    }
}

impl PartialOrd for () {
    fn partial_cmp(self: (), other: ()) -> Option[Ordering] {
        Option::Some(Ordering::Equal)
    }
}

impl Ord for bool {
    fn cmp(self: bool, other: bool) -> Ordering {
        if self == other {
            Ordering::Equal
        } else if self {
            Ordering::Greater
        } else {
            Ordering::Less
        }
    }
}

impl PartialOrd for bool {
    fn partial_cmp(self: bool, other: bool) -> Option[Ordering] {
        Option::Some(
            if self == other {
                Ordering::Equal
            } else if self {
                Ordering::Greater
            } else {
                Ordering::Less
            },
        )
    }
}

impl Ord for string {
    fn cmp(self: string, other: string) -> Ordering {
        if self < other {
            Ordering::Less
        } else if self > other {
            Ordering::Greater
        } else {
            Ordering::Equal
        }
    }
}

impl PartialOrd for string {
    fn partial_cmp(self: string, other: string) -> Option[Ordering] {
        Option::Some(
            if self < other {
