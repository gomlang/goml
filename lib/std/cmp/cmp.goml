impl PartialOrd for f32 {
    fn partial_cmp(self: f32, other: f32) -> Option[Ordering] {
        if self < other {
            Option::Some(Ordering::Less)
        } else if self > other {
            Option::Some(Ordering::Greater)
        } else if self == other {
            Option::Some(Ordering::Equal)
        } else {
            Option::None
        }
    }
}

impl PartialOrd for f64 {
    fn partial_cmp(self: f64, other: f64) -> Option[Ordering] {
        if self < other {
            Option::Some(Ordering::Less)
        } else if self > other {
            Option::Some(Ordering::Greater)
        } else if self == other {
            Option::Some(Ordering::Equal)
        } else {
            Option::None
        }
    }
}

impl[T: PartialOrd] PartialOrd for Vec[T] {
    fn partial_cmp(self: Vec[T], other: Vec[T]) -> Option[Ordering] {
        let limit = if self.len() < other.len() {
            self.len()
        } else {
            other.len()
        };
        let mut index = 0;
        while index < limit {
            match PartialOrd::partial_cmp(self[index], other[index]) {
                Option::None => return Option::None,
                Option::Some(Ordering::Equal) => {
                    index += 1;
                },
                Option::Some(ordering) => return Option::Some(ordering),
            }
        }
        PartialOrd::partial_cmp(self.len(), other.len())
    }
}

impl[T: Ord] Ord for Vec[T] {
    fn cmp(self: Vec[T], other: Vec[T]) -> Ordering {
        let limit = if self.len() < other.len() {
            self.len()
        } else {
            other.len()
        };
        let mut index = 0;
        while index < limit {
            match Ord::cmp(self[index], other[index]) {
                Ordering::Equal => {
                    index += 1;
                },
                ordering => return ordering,
            }
        }
        Ord::cmp(self.len(), other.len())
    }
}

impl[T: PartialOrd] PartialOrd for Slice[T] {
    fn partial_cmp(self: Slice[T], other: Slice[T]) -> Option[Ordering] {
        let limit = if self.len() < other.len() {
            self.len()
        } else {
            other.len()
        };
        let mut index = 0;
        while index < limit {
            match PartialOrd::partial_cmp(self[index], other[index]) {
                Option::None => return Option::None,
                Option::Some(Ordering::Equal) => {
                    index += 1;
                },
                Option::Some(ordering) => return Option::Some(ordering),
            }
        }
        PartialOrd::partial_cmp(self.len(), other.len())
    }
}

impl[T: Ord] Ord for Slice[T] {
    fn cmp(self: Slice[T], other: Slice[T]) -> Ordering {
        let limit = if self.len() < other.len() {
            self.len()
        } else {
            other.len()
        };
        let mut index = 0;
        while index < limit {
            match Ord::cmp(self[index], other[index]) {
                Ordering::Equal => {
                    index += 1;
                },
                ordering => return ordering,
            }
        }
        Ord::cmp(self.len(), other.len())
    }
}

impl[T: PartialOrd] PartialOrd for Option[T] {
    fn partial_cmp(self: Option[T], other: Option[T]) -> Option[Ordering] {
        match (self, other) {
            (Option::None, Option::None) => Option::Some(Ordering::Equal),
            (Option::None, Option::Some(_)) => Option::Some(Ordering::Less),
            (Option::Some(_), Option::None) => Option::Some(Ordering::Greater),
            (Option::Some(left), Option::Some(right)) => PartialOrd::partial_cmp(left, right),
        }
    }
}

impl[T: Ord] Ord for Option[T] {
    fn cmp(self: Option[T], other: Option[T]) -> Ordering {
        match (self, other) {
            (Option::None, Option::None) => Ordering::Equal,
            (Option::None, Option::Some(_)) => Ordering::Less,
            (Option::Some(_), Option::None) => Ordering::Greater,
            (Option::Some(left), Option::Some(right)) => Ord::cmp(left, right),
        }
    }
}

impl[T: PartialOrd, E: PartialOrd] PartialOrd for Result[T, E] {
    fn partial_cmp(self: Result[T, E], other: Result[T, E]) -> Option[Ordering] {
        match (self, other) {
            (Result::Ok(left), Result::Ok(right)) => PartialOrd::partial_cmp(left, right),
            (Result::Ok(_), Result::Err(_)) => Option::Some(Ordering::Less),
            (Result::Err(_), Result::Ok(_)) => Option::Some(Ordering::Greater),
            (Result::Err(left), Result::Err(right)) => PartialOrd::partial_cmp(left, right),
        }
    }
}

impl[T: Ord, E: Ord] Ord for Result[T, E] {
    fn cmp(self: Result[T, E], other: Result[T, E]) -> Ordering {
        match (self, other) {
            (Result::Ok(left), Result::Ok(right)) => Ord::cmp(left, right),
            (Result::Ok(_), Result::Err(_)) => Ordering::Less,
            (Result::Err(_), Result::Ok(_)) => Ordering::Greater,
            (Result::Err(left), Result::Err(right)) => Ord::cmp(left, right),
        }
    }
}

pub struct Reverse[T] {
    pub value: T,
}

impl[T] Reverse[T] {
    pub fn new(value: T) -> Reverse[T] {
        Reverse { value }
    }

    pub fn into_inner(self: Reverse[T]) -> T {
        self.value
    }
}

impl[T: PartialEq] PartialEq for Reverse[T] {
    fn eq(self: Reverse[T], other: Reverse[T]) -> bool {
        self.value == other.value
    }
}

impl[T: Eq] Eq for Reverse[T] {}

impl[T: PartialOrd] PartialOrd for Reverse[T] {
    fn partial_cmp(self: Reverse[T], other: Reverse[T]) -> Option[Ordering] {
        PartialOrd::partial_cmp(other.value, self.value)
    }
}

impl[T: Ord] Ord for Reverse[T] {
    fn cmp(self: Reverse[T], other: Reverse[T]) -> Ordering {
        Ord::cmp(other.value, self.value)
    }
}

pub fn compare[T: Ord](left: T, right: T) -> Ordering {
    Ord::cmp(left, right)
}

pub fn min[T: Ord](left: T, right: T) -> T {
    min_by(left, right, |first: T, second: T| compare(first, second))
}

pub fn max[T: Ord](left: T, right: T) -> T {
    max_by(left, right, |first: T, second: T| compare(first, second))
}

pub fn min_by[T](left: T, right: T, compare_fn: (T, T) -> Ordering) -> T {
    if compare_fn(left, right).is_gt() {
        right
    } else {
        left
    }
}

pub fn max_by[T](left: T, right: T, compare_fn: (T, T) -> Ordering) -> T {
    if compare_fn(left, right).is_gt() {
        left
    } else {
        right
    }
}

pub fn min_by_key[T, K: Ord](left: T, right: T, key: (T) -> K) -> T {
    let left_key = key(left);
    let right_key = key(right);
    min_by(left, right, |_: T, _: T| compare(left_key, right_key))
}

pub fn max_by_key[T, K: Ord](left: T, right: T, key: (T) -> K) -> T {
    let left_key = key(left);
    let right_key = key(right);
    max_by(left, right, |_: T, _: T| compare(left_key, right_key))
}

pub fn clamp[T: Ord](value: T, minimum: T, maximum: T) -> Result[T, string] {
    if compare(minimum, maximum).is_gt() {
        Result::Err("minimum exceeds maximum")
    } else if compare(value, minimum).is_lt() {
        Result::Ok(minimum)
    } else if compare(value, maximum).is_gt() {
        Result::Ok(maximum)
    } else {
        Result::Ok(value)
    }
}
