package unicode;

pub enum Case {
    Upper,
    Lower,
    Title,
}

pub struct CaseMapping {
    pub from: char,
    pub upper: char,
    pub lower: char,
    pub title: char,
}

pub struct SpecialCase {
    data: string,
}

fn case_offset(kind: Case) -> isize {
    match kind {
        Case::Upper => 6,
        Case::Lower => 12,
        Case::Title => 18,
    }
}

fn mapping_offset(data: string, width: isize, value: u32) -> Option[isize] {
    if data.byte_len() == 0 {
        return Option::None
    }
    if value < unpack(data, 0) || value > unpack(data, data.byte_len() - width) {
        return Option::None
    }
    let mut low = 0;
    let mut high = data.byte_len() / width;
    while low < high {
        let middle = low + (high - low) / 2;
        let current = unpack(data, middle * width);
        if current < value {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    if low < data.byte_len() / width && unpack(data, low * width) == value {
        Option::Some(low * width)
    } else {
        Option::None
    }
}

pub fn to_case(value: char, kind: Case) -> char {
    match mapping_offset(CASE_DATA, 24, value.to_u32()) {
        Option::Some(offset) => char_from_u32(unpack(CASE_DATA, offset + case_offset(kind))).unwrap_or(
            value,
        ),
        Option::None => value,
    }
}

pub fn simple_fold(value: char) -> char {
    match mapping_offset(SIMPLE_FOLD_DATA, 12, value.to_u32()) {
        Option::Some(offset) => char_from_u32(unpack(SIMPLE_FOLD_DATA, offset + 6)).unwrap_or(value),
        Option::None => value,
    }
}

pub fn to_lowercase(value: char) -> char {
    to_case(value, Case::Lower)
}

pub fn to_uppercase(value: char) -> char {
    to_case(value, Case::Upper)
}

pub fn to_titlecase(value: char) -> char {
    to_case(value, Case::Title)
}

impl SpecialCase {
    pub fn new(mappings: Vec[CaseMapping]) -> Result[SpecialCase, TableError] {
        let output: Vec[byte] = Vec::new();
        let mut previous: u32 = 0;
        for index in 0..mappings.len() {
            let mapping = mappings[index];
            let codepoint = mapping.from.to_u32();
            if index > 0 && codepoint <= previous {
                return Result::Err(TableError::UnsortedMapping(index))
            }
            previous = codepoint;
            pack(codepoint, output);
            pack(mapping.upper.to_u32(), output);
            pack(mapping.lower.to_u32(), output);
            pack(mapping.title.to_u32(), output);
        }
        Result::Ok(SpecialCase { data: finish_string(output) })
    }

    pub fn to_case(self: SpecialCase, value: char, kind: Case) -> char {
        match mapping_offset(self.data, 24, value.to_u32()) {
            Option::Some(offset) => char_from_u32(unpack(self.data, offset + case_offset(kind))).unwrap_or(
                value,
            ),
            Option::None => to_case(value, kind),
        }
    }
}

pub fn turkish_case() -> SpecialCase {
    SpecialCase {
        data: "000049000049000131000049000069000130000069000130000130000130000069000130000131000049000131000049",
    }
}

pub fn azeri_case() -> SpecialCase {
    turkish_case()
}

pub fn lowercase(value: string) -> string {
    let output: Vec[byte] = Vec::new();
    for character in value.chars() {
        append_string(output, to_lowercase(character).to_string());
    }
    finish_string(output)
}

pub fn uppercase(value: string) -> string {
    let output: Vec[byte] = Vec::new();
    for character in value.chars() {
        append_string(output, to_uppercase(character).to_string());
    }
    finish_string(output)
}

pub fn lowercase_with(value: string, special: SpecialCase) -> string {
    let output: Vec[byte] = Vec::new();
    for character in value.chars() {
        append_string(output, special.to_case(character, Case::Lower).to_string());
    }
    finish_string(output)
}

pub fn uppercase_with(value: string, special: SpecialCase) -> string {
    let output: Vec[byte] = Vec::new();
    for character in value.chars() {
        append_string(output, special.to_case(character, Case::Upper).to_string());
    }
    finish_string(output)
}
