package unicode;

pub struct Range {
    pub low: u32,
    pub high: u32,
    pub stride: u32,
}

pub enum TableError {
    InvalidRange(isize),
    UnsortedRange(isize),
    UnsortedMapping(isize),
}

impl ToString for TableError {
    fn to_string(self: TableError) -> string {
        match self {
            TableError::InvalidRange(index) => f"invalid Unicode range at index {index}",
            TableError::UnsortedRange(index) => f"overlapping or unsorted Unicode range at index {index}",
            TableError::UnsortedMapping(index) => f"duplicate or unsorted Unicode case mapping at index {index}",
        }
    }
}

impl Debug for TableError {
    fn debug(self: TableError) -> string {
        self.to_string()
    }
}

pub struct RangeTable {
    data: string,
}

fn unpack_width(data: string, offset: isize, width: isize) -> u32 {
    let mut result: u32 = 0;
    for index in offset..offset + width {
        let digit = data.byte_get(index);
        let value = if digit <= b'9' {
            digit - b'0'
        } else {
            digit - b'a' + 10
        };
        result = (result << 4) | value.to_u32();
    }
    result
}

fn unpack(data: string, offset: isize) -> u32 {
    unpack_width(data, offset, 6)
}

fn pack_width(value: u32, width: isize, output: Vec[byte]) -> () {
    let digits = "0123456789abcdef";
    let mut shift = width * 4;
    while shift > 0 {
        shift -= 4;
        output.push(digits.byte_get(((value >> shift) & 15).to_isize()));
    }
}

fn pack(value: u32, output: Vec[byte]) -> () {
    pack_width(value, 6, output)
}

impl RangeTable {
    pub fn new(ranges: Vec[Range]) -> Result[RangeTable, TableError] {
        let output: Vec[byte] = Vec::new();
        let mut previous: u32 = 0;
        for index in 0..ranges.len() {
            let range = ranges[index];
            if range.low > range.high || range.high > 0x10ffff || range.stride == 0 {
                return Result::Err(TableError::InvalidRange(index))
            }
            if index > 0 && range.low <= previous {
                return Result::Err(TableError::UnsortedRange(index))
            }
            previous = range.high;
            pack(range.low, output);
            pack(range.high, output);
            pack_width(range.stride, 8, output);
        }
        Result::Ok(RangeTable { data: finish_string(output) })
    }

    pub fn contains_codepoint(self: RangeTable, value: u32) -> bool {
        let mut low = 0;
        let mut high = self.data.byte_len() / 20;
        while low < high {
            let middle = low + (high - low) / 2;
            let offset = middle * 20;
            let start = unpack(self.data, offset);
            let end = unpack(self.data, offset + 6);
            if value < start {
                high = middle;
            } else if value > end {
                low = middle + 1;
            } else {
                return (value - start) % unpack_width(self.data, offset + 12, 8) == 0
            }
        }
        false
    }

    pub fn contains(self: RangeTable, value: char) -> bool {
        self.contains_codepoint(value.to_u32())
    }

    pub fn ranges(self: RangeTable) -> Vec[Range] {
        let result: Vec[Range] = Vec::new();
        for index in 0..self.data.byte_len() / 20 {
            let offset = index * 20;
            result.push(
                Range {
                    low: unpack(self.data, offset),
                    high: unpack(self.data, offset + 6),
                    stride: unpack_width(self.data, offset + 12, 8),
                },
            );
        }
        result
    }
}

pub fn in_any(value: char, tables: Vec[RangeTable]) -> bool {
    for table in tables {
        if table.contains(value) {
            return true
        }
    }
    false
}

fn in_category(value: char, name: string) -> bool {
    match category(name) {
        Option::Some(table) => table.contains(value),
        Option::None => false,
    }
}
