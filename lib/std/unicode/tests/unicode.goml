package tests;

use std::unicode;
use std::testing;

fn check_unicode() -> () {
    check_unicode_tables();
    let turkish = unicode::turkish_case();
    let mut flags_digest: u64 = 14695981039346656037;
    let mut cases_digest: u64 = 14695981039346656037;
    let mut turkish_digest: u64 = 14695981039346656037;
    for point in 0..0x110000 {
        match char_from_u32(point.to_u32()) {
            Option::None => (),
            Option::Some(value) => {
                let predicates = [
                    unicode::is_control(value),
                    unicode::is_letter(value),
                    unicode::is_number(value),
                    unicode::is_whitespace(value),
                    unicode::is_lowercase(value),
                    unicode::is_uppercase(value),
                    unicode::is_digit(value),
                    unicode::is_mark(value),
                    unicode::is_punctuation(value),
                    unicode::is_symbol(value),
                    unicode::is_titlecase(value),
                    unicode::is_graphic(value),
                    unicode::is_printable(value),
                ];
                let mut flags: u32 = 0;
                for index in 0..13 {
                    if predicates[index] {
                        flags |= 1 << index;
                    }
                }
                flags_digest = unicode_digest(flags_digest, flags.to_u64());
                for mapped in[
                    unicode::to_uppercase(value),
                    unicode::to_lowercase(value),
                    unicode::to_titlecase(value),
                    unicode::simple_fold(value),
                ] {
                    cases_digest = unicode_digest(cases_digest, mapped.to_u32().to_u64());
                }
                for mapped in[
                    turkish.to_case(value, unicode::Case::Upper),
                    turkish.to_case(value, unicode::Case::Lower),
                    turkish.to_case(value, unicode::Case::Title),
                ] {
                    turkish_digest = unicode_digest(turkish_digest, mapped.to_u32().to_u64());
                }
            },
        }
    }
    assert_equal(flags_digest, 9822683613072754166);
    assert_equal(cases_digest, 10201534621996716365);
    assert_equal(turkish_digest, 11775719878402340809);
    assert_equal(unicode::lowercase_with("Iİ", turkish), "ıi");
    assert_equal(unicode::uppercase_with("iı", unicode::azeri_case()), "İI");
    assert_equal(unicode::uppercase("Straße"), "STRAßE");
    assert_equal(unicode::case_fold("Straße Σς"), "strasse σσ");
    let mappings = Vec::from_array(
        [unicode::CaseMapping { from: 'a', upper: 'X', lower: 'y', title: 'Z' }],
    );
    let special = testing::expect_ok(unicode::SpecialCase::new(mappings), "special case");
    mappings.push(mappings[0]);
    testing::assert(unicode::SpecialCase::new(mappings).is_err());
    mappings[0] = unicode::CaseMapping { from: 'a', upper: 'A', lower: 'a', title: 'A' };
    assert_equal(special.to_case('a', unicode::Case::Upper), 'X');
    assert_equal(special.to_case('a', unicode::Case::Lower), 'y');
    assert_equal(special.to_case('a', unicode::Case::Title), 'Z');
    assert_equal(special.to_case('b', unicode::Case::Upper), 'B');
}

fn check_unicode_tables() -> () {
    let mut digest: u64 = 14695981039346656037;
    for family in 0..5 {
        let names = unicode_names(family);
        digest = unicode_digest(digest, names.len().to_u64());
        testing::assert(unicode_table(family, "not_a_table").is_none());
        for name in names {
            for value in name.to_bytes() {
                digest = unicode_digest(digest, value.to_u64());
            }
            digest = unicode_digest(digest, 0);
            let table = testing::expect_some(unicode_table(family, name), "named table");
            let ranges = table.ranges();
            digest = unicode_digest(digest, (ranges.len() * 3).to_u64());
            for index in 0..ranges.len() {
                let range = ranges[index];
                digest = unicode_digest(digest, range.low.to_u64());
                digest = unicode_digest(digest, range.high.to_u64());
                digest = unicode_digest(digest, range.stride.to_u64());
                let start = if range.low > 0 {
                    range.low - 1
                } else {
                    0
                };
                for point in[start, range.low, range.low + 1, range.high, range.high + 1] {
                    digest = unicode_digest(
                        digest,
                        if table.contains_codepoint(point) {
                            1
                        } else {
                            0
                        },
                    );
                }
            }
            testing::assert(!table.contains_codepoint(0x110000));
        }
    }
    assert_equal(digest, 16881326278438167911);
    let input = Vec::from_array([unicode::Range { low: 65, high: 90, stride: 2 }]);
    let table = testing::expect_ok(unicode::RangeTable::new(input), "custom table");
    input[0] = unicode::Range { low: 0, high: 0, stride: 1 };
    let snapshot = table.ranges();
    snapshot[0] = input[0];
    testing::assert(table.contains('A'));
    testing::assert(!table.contains('B'));
    testing::assert(table.contains('C'));
    testing::assert(unicode::in_any('A', Vec::from_array([table])));
    testing::assert(!unicode::in_any('A', Vec::new()));
    for range in[
        unicode::Range { low: 3, high: 2, stride: 1 },
        unicode::Range { low: 0, high: 0x110000, stride: 1 },
        unicode::Range { low: 0, high: 1, stride: 0 },
    ] {
        testing::assert(unicode::RangeTable::new(Vec::from_array([range])).is_err());
    }
    testing::assert(
        unicode::RangeTable::new(
            Vec::from_array(
                [
                    unicode::Range { low: 1, high: 3, stride: 1 },
                    unicode::Range { low: 3, high: 4, stride: 1 },
                ],
            ),
        ).is_err(),
    );
    let wide = testing::expect_ok(
        unicode::RangeTable::new(
            Vec::from_array([unicode::Range { low: 1, high: 10, stride: 0xffffffff }]),
        ),
        "wide stride",
    );
    testing::assert(wide.contains_codepoint(1));
    testing::assert(!wide.contains_codepoint(2));
    let stride: u32 = 0xffffffff;
    assert_equal(wide.ranges()[0].stride, stride);
    testing::assert(
        testing::expect_some(unicode::category("Cs"), "surrogates").contains_codepoint(0xd800),
    );
}

fn unicode_names(family: isize) -> Vec[string] {
    match family {
        0 => unicode::category_names(),
        1 => unicode::script_names(),
        2 => unicode::property_names(),
        3 => unicode::fold_category_names(),
        _ => unicode::fold_script_names(),
    }
}

fn unicode_digest(value: u64, item: u64) -> u64 {
    (value ^ item) * 1099511628211
}

fn unicode_table(family: isize, name: string) -> Option[unicode::RangeTable] {
    match family {
        0 => unicode::category(name),
        1 => unicode::script(name),
        2 => unicode::property(name),
        3 => unicode::fold_category(name),
        _ => unicode::fold_script(name),
    }
}
