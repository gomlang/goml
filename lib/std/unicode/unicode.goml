package unicode;

pub const VERSION: string = "15.0.0";

fn append_string(output: Vec[byte], value: string) -> () {
    for index in 0..value.byte_len() {
        output.push(value.byte_get(index));
    }
}

fn finish_string(output: Vec[byte]) -> string {
    let (_, value) = string_from_utf8(output);
    value
}

pub fn is_control(value: char) -> bool {
    let codepoint = value.to_u32();
    codepoint < 0x20 || (codepoint >= 0x7f && codepoint <= 0x9f)
}

pub fn is_letter(value: char) -> bool {
    in_category(value, "L")
}

pub fn is_number(value: char) -> bool {
    in_category(value, "N")
}

pub fn is_digit(value: char) -> bool {
    in_category(value, "Nd")
}

pub fn is_mark(value: char) -> bool {
    in_category(value, "M")
}

pub fn is_punctuation(value: char) -> bool {
    in_category(value, "P")
}

pub fn is_symbol(value: char) -> bool {
    in_category(value, "S")
}

pub fn is_whitespace(value: char) -> bool {
    match property("White_Space") {
        Option::Some(table) => table.contains(value),
        Option::None => false,
    }
}

pub fn is_lowercase(value: char) -> bool {
    in_category(value, "Ll")
}

pub fn is_uppercase(value: char) -> bool {
    in_category(value, "Lu")
}

pub fn is_titlecase(value: char) -> bool {
    in_category(value, "Lt")
}

pub fn is_graphic(value: char) -> bool {
    is_letter(value) || is_mark(value) || is_number(value) || is_punctuation(value)
        || is_symbol(value)
        || in_category(value, "Zs")
}

pub fn is_printable(value: char) -> bool {
    value == ' ' || is_letter(value) || is_mark(value) || is_number(value) || is_punctuation(value)
        || is_symbol(value)
}
