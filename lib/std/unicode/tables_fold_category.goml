package unicode;

pub fn fold_category_names() -> Vec[string] {
    Vec::from_array(["L", "Ll", "Lt", "Lu", "M", "Mn"])
}

pub fn fold_category(name: string) -> Option[RangeTable] {
    match name {
        "L" => Option::Some(RangeTable { data: "00034500034500000001" }),
        "Ll" => Option::Some(
            RangeTable {
                data: "",
            },
        ),
        "Lt" => Option::Some(
            RangeTable {
                data: "0001c40001c6000000020001c70001c9000000020001ca0001cc000000020001f10001f300000002001f80001f8700000001001f90001f9700000001001fa0001fa700000001001fb3001fc300000010001ff3001ff300000001",
            },
        ),
        "Lu" => Option::Some(
            RangeTable {
                data: "",
            },
        ),
        "M" => Option::Some(RangeTable { data: "0003990003b900000020001fbe001fbe00000001" }),
        "Mn" => Option::Some(RangeTable { data: "0003990003b900000020001fbe001fbe00000001" }),
        _ => Option::None,
    }
}
