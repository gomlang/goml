package unicode;

pub fn fold_script_names() -> Vec[string] {
    Vec::from_array(["Common", "Greek", "Inherited"])
}

pub fn fold_script(name: string) -> Option[RangeTable] {
    match name {
        "Common" => Option::Some(RangeTable { data: "00039c0003bc00000020" }),
        "Greek" => Option::Some(RangeTable { data: "0000b500034500000290" }),
        "Inherited" => Option::Some(RangeTable { data: "0003990003b900000020001fbe001fbe00000001" }),
        _ => Option::None,
    }
}
