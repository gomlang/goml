pub struct Stat {
    pub dev: u64,
    pub ino: u64,
    pub nlink: u64,
    pub mode: u32,
    pub uid: u32,
    pub gid: u32,
    pub rdev: u64,
    pub size: i64,
    pub blksize: i64,
    pub blocks: i64,
    pub atime: Timespec,
    pub mtime: Timespec,
    pub ctime: Timespec,
}

impl Stat {
    pub fn size() -> isize {
        144
    }

    pub fn encode(self: Stat) -> Vec[byte] {
        let data = zeroed(144);
        let _ = endian::write_u64(data.as_mut_slice(), 0, self.dev, endian::Endian::Little);
        let _ = endian::write_u64(data.as_mut_slice(), 8, self.ino, endian::Endian::Little);
        let _ = endian::write_u64(data.as_mut_slice(), 16, self.nlink, endian::Endian::Little);
        let _ = endian::write_u32(data.as_mut_slice(), 24, self.mode, endian::Endian::Little);
        let _ = endian::write_u32(data.as_mut_slice(), 28, self.uid, endian::Endian::Little);
        let _ = endian::write_u32(data.as_mut_slice(), 32, self.gid, endian::Endian::Little);
        let _ = endian::write_u64(data.as_mut_slice(), 40, self.rdev, endian::Endian::Little);
        let _ = endian::write_i64(data.as_mut_slice(), 48, self.size, endian::Endian::Little);
        let _ = endian::write_i64(data.as_mut_slice(), 56, self.blksize, endian::Endian::Little);
        let _ = endian::write_i64(data.as_mut_slice(), 64, self.blocks, endian::Endian::Little);
        let _ = data.as_mut_slice().copy_from(72, self.atime.encode().as_slice());
        let _ = data.as_mut_slice().copy_from(88, self.mtime.encode().as_slice());
        let _ = data.as_mut_slice().copy_from(104, self.ctime.encode().as_slice());
        data
    }

    pub fn decode(data: Slice[byte]) -> Result[Stat, endian::BoundsError] {
        require_size(data, 144)?;
        Result::Ok(
            Stat {
                dev: endian::read_u64(data, 0, endian::Endian::Little)?,
                ino: endian::read_u64(data, 8, endian::Endian::Little)?,
                nlink: endian::read_u64(data, 16, endian::Endian::Little)?,
                mode: endian::read_u32(data, 24, endian::Endian::Little)?,
                uid: endian::read_u32(data, 28, endian::Endian::Little)?,
                gid: endian::read_u32(data, 32, endian::Endian::Little)?,
                rdev: endian::read_u64(data, 40, endian::Endian::Little)?,
                size: endian::read_i64(data, 48, endian::Endian::Little)?,
                blksize: endian::read_i64(data, 56, endian::Endian::Little)?,
                blocks: endian::read_i64(data, 64, endian::Endian::Little)?,
                atime: Timespec::decode(data.sub(72, 88))?,
                mtime: Timespec::decode(data.sub(88, 104))?,
                ctime: Timespec::decode(data.sub(104, 120))?,
            },
        )
    }
}

pub struct StatxTimestamp {
    pub seconds: i64,
    pub nanoseconds: u32,
}

impl StatxTimestamp {
    pub fn size() -> isize {
