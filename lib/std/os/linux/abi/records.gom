        let _ = endian::write_i32(data.as_mut_slice(), 8, self.level, endian::Endian::Little);
        let _ = endian::write_i32(data.as_mut_slice(), 12, self.kind, endian::Endian::Little);
        data
    }

    pub fn decode(data: Slice[byte]) -> Result[Cmsghdr, endian::BoundsError] {
        require_size(data, 16)?;
        Result::Ok(
