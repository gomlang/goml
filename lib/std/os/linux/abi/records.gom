        let _ = endian::write_i64(data.as_mut_slice(), 0, self.seconds, endian::Endian::Little);
        let _ = endian::write_u32(data.as_mut_slice(), 8, self.nanoseconds, endian::Endian::Little);
        data
    }

    pub fn decode(data: Slice[byte]) -> Result[StatxTimestamp, endian::BoundsError] {
        require_size(data, 16)?;
        Result::Ok(
            StatxTimestamp {
                seconds: endian::read_i64(data, 0, endian::Endian::Little)?,
                nanoseconds: endian::read_u32(data, 8, endian::Endian::Little)?,
            },
        )
    }
}

pub struct Statx {
    pub mask: u32,
    pub blksize: u32,
    pub attributes: u64,
    pub nlink: u32,
    pub uid: u32,
    pub gid: u32,
    pub mode: u16,
    pub ino: u64,
    pub size: u64,
    pub blocks: u64,
    pub attributes_mask: u64,
    pub atime: StatxTimestamp,
    pub btime: StatxTimestamp,
    pub ctime: StatxTimestamp,
    pub mtime: StatxTimestamp,
    pub rdev_major: u32,
    pub rdev_minor: u32,
    pub dev_major: u32,
    pub dev_minor: u32,
    pub mount_id: u64,
    pub dio_memory_align: u32,
    pub dio_offset_align: u32,
}

impl Statx {
    pub fn size() -> isize {
        256
    }

    pub fn encode(self: Statx) -> Vec[byte] {
        let data = zeroed(256);
        let _ = endian::write_u32(data.as_mut_slice(), 0, self.mask, endian::Endian::Little);
        let _ = endian::write_u32(data.as_mut_slice(), 4, self.blksize, endian::Endian::Little);
        let _ = endian::write_u64(data.as_mut_slice(), 8, self.attributes, endian::Endian::Little);
        let _ = endian::write_u32(data.as_mut_slice(), 16, self.nlink, endian::Endian::Little);
        let _ = endian::write_u32(data.as_mut_slice(), 20, self.uid, endian::Endian::Little);
        let _ = endian::write_u32(data.as_mut_slice(), 24, self.gid, endian::Endian::Little);
        let _ = endian::write_u16(data.as_mut_slice(), 28, self.mode, endian::Endian::Little);
        let _ = endian::write_u64(data.as_mut_slice(), 32, self.ino, endian::Endian::Little);
        let _ = endian::write_u64(data.as_mut_slice(), 40, self.size, endian::Endian::Little);
        let _ = endian::write_u64(data.as_mut_slice(), 48, self.blocks, endian::Endian::Little);
        let _ = endian::write_u64(
            data.as_mut_slice(),
            56,
            self.attributes_mask,
            endian::Endian::Little,
        );
        let _ = data.as_mut_slice().copy_from(64, self.atime.encode().as_slice());
        let _ = data.as_mut_slice().copy_from(80, self.btime.encode().as_slice());
        let _ = data.as_mut_slice().copy_from(96, self.ctime.encode().as_slice());
        let _ = data.as_mut_slice().copy_from(112, self.mtime.encode().as_slice());
        let _ = endian::write_u32(data.as_mut_slice(), 128, self.rdev_major, endian::Endian::Little);
        let _ = endian::write_u32(data.as_mut_slice(), 132, self.rdev_minor, endian::Endian::Little);
        let _ = endian::write_u32(data.as_mut_slice(), 136, self.dev_major, endian::Endian::Little);
        let _ = endian::write_u32(data.as_mut_slice(), 140, self.dev_minor, endian::Endian::Little);
        let _ = endian::write_u64(data.as_mut_slice(), 144, self.mount_id, endian::Endian::Little);
        let _ = endian::write_u32(
            data.as_mut_slice(),
            152,
            self.dio_memory_align,
            endian::Endian::Little,
        );
        let _ = endian::write_u32(
            data.as_mut_slice(),
            156,
            self.dio_offset_align,
            endian::Endian::Little,
        );
        data
    }

    pub fn decode(data: Slice[byte]) -> Result[Statx, endian::BoundsError] {
        require_size(data, 256)?;
        Result::Ok(
            Statx {
                mask: endian::read_u32(data, 0, endian::Endian::Little)?,
                blksize: endian::read_u32(data, 4, endian::Endian::Little)?,
                attributes: endian::read_u64(data, 8, endian::Endian::Little)?,
                nlink: endian::read_u32(data, 16, endian::Endian::Little)?,
                uid: endian::read_u32(data, 20, endian::Endian::Little)?,
                gid: endian::read_u32(data, 24, endian::Endian::Little)?,
                mode: endian::read_u16(data, 28, endian::Endian::Little)?,
                ino: endian::read_u64(data, 32, endian::Endian::Little)?,
                size: endian::read_u64(data, 40, endian::Endian::Little)?,
                blocks: endian::read_u64(data, 48, endian::Endian::Little)?,
                attributes_mask: endian::read_u64(data, 56, endian::Endian::Little)?,
                atime: StatxTimestamp::decode(data.sub(64, 80))?,
                btime: StatxTimestamp::decode(data.sub(80, 96))?,
                ctime: StatxTimestamp::decode(data.sub(96, 112))?,
                mtime: StatxTimestamp::decode(data.sub(112, 128))?,
                rdev_major: endian::read_u32(data, 128, endian::Endian::Little)?,
                rdev_minor: endian::read_u32(data, 132, endian::Endian::Little)?,
                dev_major: endian::read_u32(data, 136, endian::Endian::Little)?,
                dev_minor: endian::read_u32(data, 140, endian::Endian::Little)?,
                mount_id: endian::read_u64(data, 144, endian::Endian::Little)?,
                dio_memory_align: endian::read_u32(data, 152, endian::Endian::Little)?,
                dio_offset_align: endian::read_u32(data, 156, endian::Endian::Little)?,
            },
        )
    }
}

pub struct Rusage {
    pub user_time: Timeval,
    pub system_time: Timeval,
    pub max_rss: i64,
    pub shared_memory: i64,
    pub unshared_data: i64,
    pub unshared_stack: i64,
    pub minor_faults: i64,
    pub major_faults: i64,
    pub swaps: i64,
    pub input_blocks: i64,
    pub output_blocks: i64,
    pub messages_sent: i64,
    pub messages_received: i64,
    pub signals: i64,
    pub voluntary_switches: i64,
    pub involuntary_switches: i64,
}

impl Rusage {
    pub fn size() -> isize {
        144
    }

    pub fn encode(self: Rusage) -> Vec[byte] {
        let data = zeroed(144);
        let _ = data.as_mut_slice().copy_from(0, self.user_time.encode().as_slice());
        let _ = data.as_mut_slice().copy_from(16, self.system_time.encode().as_slice());
        let _ = endian::write_i64(data.as_mut_slice(), 32, self.max_rss, endian::Endian::Little);
        let _ = endian::write_i64(
            data.as_mut_slice(),
            40,
            self.shared_memory,
            endian::Endian::Little,
        );
        let _ = endian::write_i64(
            data.as_mut_slice(),
            48,
            self.unshared_data,
            endian::Endian::Little,
        );
        let _ = endian::write_i64(
            data.as_mut_slice(),
            56,
            self.unshared_stack,
            endian::Endian::Little,
        );
        let _ = endian::write_i64(
            data.as_mut_slice(),
            64,
            self.minor_faults,
            endian::Endian::Little,
        );
        let _ = endian::write_i64(
            data.as_mut_slice(),
            72,
            self.major_faults,
            endian::Endian::Little,
        );
        let _ = endian::write_i64(data.as_mut_slice(), 80, self.swaps, endian::Endian::Little);
        let _ = endian::write_i64(
            data.as_mut_slice(),
            88,
            self.input_blocks,
            endian::Endian::Little,
        );
        let _ = endian::write_i64(
            data.as_mut_slice(),
            96,
            self.output_blocks,
            endian::Endian::Little,
        );
        let _ = endian::write_i64(
            data.as_mut_slice(),
            104,
            self.messages_sent,
            endian::Endian::Little,
        );
        let _ = endian::write_i64(
            data.as_mut_slice(),
            112,
            self.messages_received,
            endian::Endian::Little,
        );
        let _ = endian::write_i64(data.as_mut_slice(), 120, self.signals, endian::Endian::Little);
        let _ = endian::write_i64(
            data.as_mut_slice(),
            128,
            self.voluntary_switches,
            endian::Endian::Little,
        );
        let _ = endian::write_i64(
            data.as_mut_slice(),
            136,
            self.involuntary_switches,
            endian::Endian::Little,
        );
        data
    }

    pub fn decode(data: Slice[byte]) -> Result[Rusage, endian::BoundsError] {
        require_size(data, 144)?;
        Result::Ok(
            Rusage {
                user_time: Timeval::decode(data.sub(0, 16))?,
                system_time: Timeval::decode(data.sub(16, 32))?,
                max_rss: endian::read_i64(data, 32, endian::Endian::Little)?,
                shared_memory: endian::read_i64(data, 40, endian::Endian::Little)?,
                unshared_data: endian::read_i64(data, 48, endian::Endian::Little)?,
                unshared_stack: endian::read_i64(data, 56, endian::Endian::Little)?,
                minor_faults: endian::read_i64(data, 64, endian::Endian::Little)?,
                major_faults: endian::read_i64(data, 72, endian::Endian::Little)?,
                swaps: endian::read_i64(data, 80, endian::Endian::Little)?,
                input_blocks: endian::read_i64(data, 88, endian::Endian::Little)?,
                output_blocks: endian::read_i64(data, 96, endian::Endian::Little)?,
                messages_sent: endian::read_i64(data, 104, endian::Endian::Little)?,
                messages_received: endian::read_i64(data, 112, endian::Endian::Little)?,
                signals: endian::read_i64(data, 120, endian::Endian::Little)?,
                voluntary_switches: endian::read_i64(data, 128, endian::Endian::Little)?,
                involuntary_switches: endian::read_i64(data, 136, endian::Endian::Little)?,
            },
        )
    }
}
