}

pub struct Flock {
    pub kind: i16,
    pub whence: i16,
    pub start: i64,
    pub length: i64,
    pub pid: i32,
}

impl Flock {
    pub fn size() -> isize {
        32
    }

    pub fn encode(self: Flock) -> Vec[byte] {
        let data = zeroed(32);
        let _ = endian::write_i16(data.as_mut_slice(), 0, self.kind, endian::Endian::Little);
        let _ = endian::write_i16(data.as_mut_slice(), 2, self.whence, endian::Endian::Little);
        let _ = endian::write_i64(data.as_mut_slice(), 8, self.start, endian::Endian::Little);
        let _ = endian::write_i64(data.as_mut_slice(), 16, self.length, endian::Endian::Little);
        let _ = endian::write_i32(data.as_mut_slice(), 24, self.pid, endian::Endian::Little);
        data
    }

    pub fn decode(data: Slice[byte]) -> Result[Flock, endian::BoundsError] {
        require_size(data, 32)?;
        Result::Ok(
            Flock {
                kind: endian::read_i16(data, 0, endian::Endian::Little)?,
                whence: endian::read_i16(data, 2, endian::Endian::Little)?,
                start: endian::read_i64(data, 8, endian::Endian::Little)?,
                length: endian::read_i64(data, 16, endian::Endian::Little)?,
                pid: endian::read_i32(data, 24, endian::Endian::Little)?,
            },
        )
    }
}

