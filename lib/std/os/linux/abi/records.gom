pub struct Msghdr {
    pub name: usize,
    pub name_len: u32,
    pub iov: usize,
    pub iov_len: usize,
    pub control: usize,
    pub control_len: usize,
    pub flags: i32,
}

impl Msghdr {
    pub fn size() -> isize {
        56
    }

    pub fn encode(self: Msghdr) -> Vec[byte] {
        let data = zeroed(56);
        let _ = endian::write_u64(
            data.as_mut_slice(),
            0,
            self.name.to_u64(),
            endian::Endian::Little,
        );
        let _ = endian::write_u32(data.as_mut_slice(), 8, self.name_len, endian::Endian::Little);
        let _ = endian::write_u64(
            data.as_mut_slice(),
            16,
            self.iov.to_u64(),
            endian::Endian::Little,
        );
        let _ = endian::write_u64(
            data.as_mut_slice(),
            24,
            self.iov_len.to_u64(),
            endian::Endian::Little,
        );
        let _ = endian::write_u64(
            data.as_mut_slice(),
            32,
            self.control.to_u64(),
            endian::Endian::Little,
        );
        let _ = endian::write_u64(
            data.as_mut_slice(),
            40,
            self.control_len.to_u64(),
            endian::Endian::Little,
        );
        let _ = endian::write_i32(data.as_mut_slice(), 48, self.flags, endian::Endian::Little);
        data
    }

    pub fn decode(data: Slice[byte]) -> Result[Msghdr, endian::BoundsError] {
        require_size(data, 56)?;
        Result::Ok(
            Msghdr {
                name: endian::read_u64(data, 0, endian::Endian::Little)?.to_usize(),
                name_len: endian::read_u32(data, 8, endian::Endian::Little)?,
                iov: endian::read_u64(data, 16, endian::Endian::Little)?.to_usize(),
                iov_len: endian::read_u64(data, 24, endian::Endian::Little)?.to_usize(),
                control: endian::read_u64(data, 32, endian::Endian::Little)?.to_usize(),
                control_len: endian::read_u64(data, 40, endian::Endian::Little)?.to_usize(),
                flags: endian::read_i32(data, 48, endian::Endian::Little)?,
            },
        )
    }
}

