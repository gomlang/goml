    }

    pub fn decode(data: Slice[byte]) -> Result[Timeval, endian::BoundsError] {
        require_size(data, 16)?;
        Result::Ok(
            Timeval {
                seconds: endian::read_i64(data, 0, endian::Endian::Little)?,
                microseconds: endian::read_i64(data, 8, endian::Endian::Little)?,
            },
        )
    }
}

pub struct Itimerspec {
    pub interval: Timespec,
    pub value: Timespec,
}

impl Itimerspec {
    pub fn size() -> isize {
        32
    }

    pub fn encode(self: Itimerspec) -> Vec[byte] {
        let data = zeroed(32);
        let _ = data.as_mut_slice().copy_from(0, self.interval.encode().as_slice());
        let _ = data.as_mut_slice().copy_from(16, self.value.encode().as_slice());
        data
    }

    pub fn decode(data: Slice[byte]) -> Result[Itimerspec, endian::BoundsError] {
        require_size(data, 32)?;
        Result::Ok(
            Itimerspec {
                interval: Timespec::decode(data.sub(0, 16))?,
                value: Timespec::decode(data.sub(16, 32))?,
            },
        )
    }
}

