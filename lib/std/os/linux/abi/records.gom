package abi;

use module::bytes::endian;

pub struct Timespec {
    pub seconds: i64,
    pub nanoseconds: i64,
}

impl Timespec {
    pub fn size() -> isize {
        16
    }

    pub fn encode(self: Timespec) -> Vec[byte] {
        let data = zeroed(16);
        let _ = endian::write_i64(data.as_mut_slice(), 0, self.seconds, endian::Endian::Little);
        let _ = endian::write_i64(data.as_mut_slice(), 8, self.nanoseconds, endian::Endian::Little);
        data
    }

    pub fn decode(data: Slice[byte]) -> Result[Timespec, endian::BoundsError] {
        require_size(data, 16)?;
        Result::Ok(
            Timespec {
                seconds: endian::read_i64(data, 0, endian::Endian::Little)?,
                nanoseconds: endian::read_i64(data, 8, endian::Endian::Little)?,
            },
        )
    }
}

pub struct Timeval {
    pub seconds: i64,
    pub microseconds: i64,
}

impl Timeval {
    pub fn size() -> isize {
        16
    }

    pub fn encode(self: Timeval) -> Vec[byte] {
        let data = zeroed(16);
        let _ = endian::write_i64(data.as_mut_slice(), 0, self.seconds, endian::Endian::Little);
        let _ = endian::write_i64(data.as_mut_slice(), 8, self.microseconds, endian::Endian::Little);
