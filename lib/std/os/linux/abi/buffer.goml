package abi;

use module::bytes::endian;
use module::os::linux::syscall;

fn zeroed(length: isize) -> Vec[byte] {
    let result: Vec[byte] = Vec::with_capacity(length);
    for _ in 0..length {
        result.push(0);
    }
    result
}

fn require_size(data: Slice[byte], size: isize) -> Result[(), endian::BoundsError] {
    if data.len() < size {
        Result::Err(endian::BoundsError::new(0, size, data.len()))
    } else {
        Result::Ok(())
    }
}

pub struct Iovecs {
    storage: Vec[byte],
    pointers_value: Vec[syscall::Pointer],
    count_value: isize,
}

impl Iovecs {
    pub fn new(buffers: Slice[MutSlice[byte]]) -> Result[Iovecs, string] {
        if buffers.len() > 1024 {
            return Result::Err("Linux permits at most 1024 iovec entries")
        }
        let storage = zeroed(buffers.len() * 16);
        let pointers_value: Vec[syscall::Pointer] = Vec::with_capacity(buffers.len());
        for index in 0..buffers.len() {
            let buffer = buffers[index];
            let _ = endian::write_u64(
                storage.as_mut_slice(),
                index * 16 + 8,
                buffer.len().to_u64(),
                endian::Endian::Little,
            );
            pointers_value.push(
                syscall::Pointer {
                    buffer: storage.as_mut_slice(),
                    offset: index * 16,
                    target: buffer,
                },
            );
        }
        Result::Ok(Iovecs { storage, pointers_value, count_value: buffers.len() })
    }

    pub fn buffer(self: Iovecs) -> MutSlice[byte] {
        self.storage.as_mut_slice()
    }

    pub fn pointers(self: Iovecs) -> Slice[syscall::Pointer] {
        self.pointers_value.as_slice()
    }

    pub fn len(self: Iovecs) -> isize {
        self.count_value
    }
}

pub struct Message {
    storage: Vec[byte],
    pointers_value: Vec[syscall::Pointer],
}

impl Message {
    pub fn new(name: MutSlice[byte], vectors: Iovecs, control: MutSlice[byte]) -> Result[
        Message,
        string,
    ] {
        if name.len().to_u64() > 0xffffffff {
            return Result::Err("socket address length exceeds socklen_t")
        }
        let storage = Msghdr {
            name: 0,
            name_len: name.len().to_u32(),
            iov: 0,
            iov_len: vectors.len().to_usize(),
            control: 0,
            control_len: control.len().to_usize(),
            flags: 0,
        }.encode();
        let pointers_value = vectors.pointers().to_vec();
        pointers_value.push(
            syscall::Pointer { buffer: storage.as_mut_slice(), offset: 0, target: name },
        );
        pointers_value.push(
            syscall::Pointer {
                buffer: storage.as_mut_slice(),
                offset: 16,
                target: vectors.buffer(),
            },
        );
        pointers_value.push(
            syscall::Pointer { buffer: storage.as_mut_slice(), offset: 32, target: control },
        );
        Result::Ok(Message { storage, pointers_value })
    }

    pub fn buffer(self: Message) -> MutSlice[byte] {
        self.storage.as_mut_slice()
    }

    pub fn pointers(self: Message) -> Slice[syscall::Pointer] {
        self.pointers_value.as_slice()
    }

    pub fn header(self: Message) -> Result[Msghdr, endian::BoundsError] {
        Msghdr::decode(self.storage.as_slice())
    }
}
