package syscall;

use module::internal::syscall as host;

pub enum Arg {
    Word(usize),
    Buffer(MutSlice[byte]),
}

pub struct Pointer {
    pub buffer: MutSlice[byte],
    pub offset: isize,
    pub target: MutSlice[byte],
}

pub struct Errno(pub usize);

impl PartialEq for Errno {
    fn eq(self: Errno, other: Errno) -> bool {
        self.0 == other.0
    }
}

impl Eq for Errno {}

impl Debug for Errno {
    fn debug(self: Errno) -> string {
        self.to_string()
    }
}

impl Errno {
    pub fn name(self: Errno) -> Option[string] {
        errno_name(self.0)
    }
}

impl ToString for Errno {
    fn to_string(self: Errno) -> string {
        self.name().unwrap_or("errno " + self.0.to_string())
    }
}

pub struct SyscallResult {
    pub r1: usize,
    pub r2: usize,
    pub errno: usize,
}

impl SyscallResult {
    pub fn is_ok(self: SyscallResult) -> bool {
        self.errno == 0
    }

    pub fn into_result(self: SyscallResult) -> Result[usize, Errno] {
        if self.is_ok() {
            Result::Ok(self.r1)
        } else {
            Result::Err(Errno(self.errno))
        }
    }
}

pub enum Error {
    UnsupportedTarget,
    InvalidPointer {
        index: isize,
        offset: isize,
        length: isize,
    },
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        match self {
            UnsupportedTarget => "std::os::linux::syscall requires linux/amd64",
            InvalidPointer { index, offset, length } => f"syscall pointer {index} needs 8 bytes at offset {offset} in buffer of length {length}",
        }
    }
}

impl Debug for Error {
    fn debug(self: Error) -> string {
        self.to_string()
    }
}

fn call(number: usize, words: [usize; 6], buffers: [MutSlice[byte]; 6]) -> Result[
    SyscallResult,
    Error,
] {
    let (supported, r1, r2, errno) = host::syscall6(number, words, buffers);
    if supported {
        Result::Ok(SyscallResult { r1, r2, errno })
    } else {
        Result::Err(Error::UnsupportedTarget)
    }
}

pub fn syscall6(number: usize, args: [usize; 6]) -> Result[SyscallResult, Error] {
    let empty: MutSlice[byte] = Vec::new().as_mut_slice();
    call(number, args, [empty, empty, empty, empty, empty, empty])
}

pub fn syscall6_with_buffers(number: usize, args: [Arg; 6]) -> Result[SyscallResult, Error] {
    let (words, buffers) = split_args(args);
    call(number, words, buffers)
}

fn split_args(args: [Arg; 6]) -> ([usize; 6], [MutSlice[byte]; 6]) {
    let mut words: [usize; 6] = [0, 0, 0, 0, 0, 0];
    let empty: MutSlice[byte] = Vec::new().as_mut_slice();
    let mut buffers = [empty, empty, empty, empty, empty, empty];
    for index in 0..6 {
        match args[index] {
            Word(value) => {
                words[index] = value;
            },
            Buffer(value) => {
                buffers[index] = value;
            },
        }
    }
    return (words, buffers)
}

pub fn syscall6_with_pointers(number: usize, args: [Arg; 6], pointers: Slice[Pointer]) -> Result[
    SyscallResult,
    Error,
] {
    let slots: Vec[MutSlice[byte]] = Vec::with_capacity(pointers.len());
    let targets: Vec[MutSlice[byte]] = Vec::with_capacity(pointers.len());
    for index in 0..pointers.len() {
        let pointer = pointers[index];
        let length = pointer.buffer.len();
        let offset = pointer.offset;
        if offset < 0 || offset > length || length - offset < 8 {
            return Result::Err(Error::InvalidPointer { index, offset, length })
        }
        slots.push(pointer.buffer.sub(offset, offset + 8));
        targets.push(pointer.target);
    }
    let (words, buffers) = split_args(args);
    let (supported, r1, r2, errno) = host::syscall6_with_pointers(
        number,
        words,
        buffers,
        slots.as_slice(),
        targets.as_slice(),
    );
    if supported {
        Result::Ok(SyscallResult { r1, r2, errno })
    } else {
        Result::Err(Error::UnsupportedTarget)
    }
}
