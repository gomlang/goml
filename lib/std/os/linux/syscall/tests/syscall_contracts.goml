package tests;

use std::os::linux::syscall;
use std::os::linux::syscall::{Arg};
use std::testing;
use std::fs;
use std::bytes::endian;

#[test]
fn raw_syscall_contracts() -> () {
    let pid = kernel_raw(syscall::SYS_GETPID, [0, 0, 0, 0, 0, 0]);
    testing::assert(pid.is_ok());
    let process_path = testing::expect_ok(fs::canonicalize("/proc/self"), "current process path");
    testing::assert_eq(process_path, "/proc/" + pid.r1.to_string());
    let missing = kernel_raw(0x7fffffff, [0, 0, 0, 0, 0, 0]);
    testing::assert_eq(missing.errno, syscall::ENOSYS);
    testing::assert_eq(missing.r1, (-1).to_usize());
    testing::assert(!missing.is_ok());
    let fds = Vec::from_array([0, 0, 0, 0, 0, 0, 0, 0]);
    let pipe = kernel_invoke(
        syscall::SYS_PIPE2,
        [
            Arg::Buffer(fds.as_mut_slice()),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
    );
    testing::assert(pipe.is_ok());
    let read_fd = testing::expect_ok(
        endian::read_u32(fds.as_slice(), 0, endian::Endian::Little),
        "read fd",
    ).to_usize();
    let write_fd = testing::expect_ok(
        endian::read_u32(fds.as_slice(), 4, endian::Endian::Little),
        "write fd",
    ).to_usize();
    defer kernel_close(read_fd);
    defer kernel_close(write_fd);
    let input = b"!syscall!";
    let written = kernel_invoke(
        syscall::SYS_WRITE,
        [
            Arg::Word(write_fd),
            Arg::Buffer(input.slice_mut(1, 8)),
            Arg::Word(7),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
    );
    testing::assert(written.is_ok());
    testing::assert_eq(written.r1, 7);
    let output = b"?????????";
    let read = kernel_invoke(
        syscall::SYS_READ,
        [
            Arg::Word(read_fd),
            Arg::Buffer(output.slice_mut(1, 8)),
            Arg::Word(7),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
    );
    testing::assert(read.is_ok());
    testing::assert_eq(read.r1, 7);
    testing::assert(output == b"?syscall?");
    let empty: Vec[byte] = Vec::new();
    let zero = kernel_invoke(
        syscall::SYS_WRITE,
        [
            Arg::Word(write_fd),
            Arg::Buffer(empty.as_mut_slice()),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
    );
    testing::assert(zero.is_ok());
    testing::assert_eq(zero.r1, 0);
    let bad = kernel_invoke(
        syscall::SYS_READ,
        [
            Arg::Word((-1).to_usize()),
            Arg::Buffer(empty.as_mut_slice()),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
    );
    testing::assert_eq(bad.errno, syscall::EBADF);
    let device = b"/dev/zero\0";
    let opened = kernel_invoke(
        syscall::SYS_OPENAT,
        [
            Arg::Word((-100).to_usize()),
            Arg::Buffer(device.as_mut_slice()),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
    );
    testing::assert(opened.is_ok());
    defer kernel_close(opened.r1);
    let mapped = kernel_raw(syscall::SYS_MMAP, [0, 4096, 1, 2, opened.r1, 4096]);
    testing::assert(mapped.is_ok());
    let unmapped = kernel_raw(syscall::SYS_MUNMAP, [mapped.r1, 4096, 0, 0, 0, 0]);
    testing::assert(unmapped.is_ok());
    check_errno();
    check_vectors();
    check_messages();
    println(
        "linux amd64 syscall: raw calls, errno, vectors, nested messages, and validation passed",
    )
}
