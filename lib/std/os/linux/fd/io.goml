package fd;

use module::io;
use module::io::{Error, ErrorKind};
use module::internal::linux as kernel;
use module::os::linux::abi;
use module::os::linux::syscall;
use module::os::linux::syscall::{Arg};

fn checked_count(value: usize, capacity: isize, operation: string) -> Result[isize, Error] {
    if value > capacity.to_usize() {
        Result::Err(
            kernel::error(
                ErrorKind::InvalidData,
                operation,
                "kernel returned an invalid byte count",
            ),
        )
    } else {
        Result::Ok(value.to_isize())
    }
}

fn scalar_io(raw: usize, number: usize, buffer: MutSlice[byte], offset: i64, operation: string) -> Result[
    isize,
    Error,
] {
    let count = kernel::invoke(
        number,
        [
            Arg::Word(raw),
            Arg::Buffer(buffer),
            Arg::Word(buffer.len().to_usize()),
            Arg::Word(offset.to_usize()),
            Arg::Word(0),
            Arg::Word(0),
        ],
        operation,
    )?;
    checked_count(count, buffer.len(), operation)
}

fn vector_io(
    raw: usize,
    number: usize,
    buffers: Slice[MutSlice[byte]],
    offset: i64,
    operation: string,
) -> Result[isize, Error] {
    let vectors = abi::Iovecs::new(buffers).map_err(
        |message| kernel::error(ErrorKind::InvalidInput, operation, message),
    )?;
    let mut capacity: usize = 0;
    for buffer in buffers {
        if buffer.len().to_usize() > 0x7fffffffffffffff - capacity {
            return Result::Err(
                kernel::error(
                    ErrorKind::InvalidInput,
                    operation,
                    "combined buffer length exceeds ssize_t",
                ),
            )
        }
        capacity += buffer.len().to_usize();
    }
    let count = kernel::invoke_pointers(
        number,
        [
            Arg::Word(raw),
            Arg::Buffer(vectors.buffer()),
            Arg::Word(vectors.len().to_usize()),
            Arg::Word(offset.to_usize()),
            Arg::Word(0),
            Arg::Word(0),
        ],
        vectors.pointers(),
        operation,
    )?;
    checked_count(count, capacity.to_isize(), operation)
}

impl Fd {
    pub fn read(self: Fd, output: MutSlice[byte]) -> Result[isize, Error] {
        self.use_fd("read", |raw| scalar_io(raw, syscall::SYS_READ, output, 0, "read"))
    }

    pub fn write(self: Fd, input: Slice[byte]) -> Result[isize, Error] {
        let data = input.to_vec();
        self.use_fd(
            "write",
            |raw| scalar_io(raw, syscall::SYS_WRITE, data.as_mut_slice(), 0, "write"),
        )
    }

    pub fn read_at(self: Fd, output: MutSlice[byte], offset: i64) -> Result[isize, Error] {
        self.use_fd("pread", |raw| scalar_io(raw, syscall::SYS_PREAD64, output, offset, "pread"))
    }

    pub fn write_at(self: Fd, input: Slice[byte], offset: i64) -> Result[isize, Error] {
        let data = input.to_vec();
        self.use_fd(
            "pwrite",
            |raw| scalar_io(raw, syscall::SYS_PWRITE64, data.as_mut_slice(), offset, "pwrite"),
        )
    }

    pub fn read_vectored(self: Fd, outputs: Slice[MutSlice[byte]]) -> Result[isize, Error] {
        self.use_fd("readv", |raw| vector_io(raw, syscall::SYS_READV, outputs, 0, "readv"))
    }

    pub fn read_vectored_at(self: Fd, outputs: Slice[MutSlice[byte]], offset: i64) -> Result[
        isize,
        Error,
    ] {
        self.use_fd("preadv", |raw| vector_io(raw, syscall::SYS_PREADV, outputs, offset, "preadv"))
    }

    pub fn write_vectored(self: Fd, inputs: Slice[Slice[byte]]) -> Result[isize, Error] {
        let buffers: Vec[MutSlice[byte]] = Vec::with_capacity(inputs.len());
        for input in inputs {
            buffers.push(input.to_vec().as_mut_slice());
        }
        self.use_fd(
            "writev",
            |raw| vector_io(raw, syscall::SYS_WRITEV, buffers.as_slice(), 0, "writev"),
        )
    }

    pub fn write_vectored_at(self: Fd, inputs: Slice[Slice[byte]], offset: i64) -> Result[
        isize,
        Error,
    ] {
        let buffers: Vec[MutSlice[byte]] = Vec::with_capacity(inputs.len());
        for input in inputs {
            buffers.push(input.to_vec().as_mut_slice());
        }
        self.use_fd(
            "pwritev",
            |raw| vector_io(raw, syscall::SYS_PWRITEV, buffers.as_slice(), offset, "pwritev"),
        )
    }

    pub fn read_exact(self: Fd, output: MutSlice[byte]) -> Result[(), Error] {
        self.use_fd(
            "read exact",
            |raw| {
                let mut offset = 0;
                while offset < output.len() {
                    let count = scalar_io(
                        raw,
                        syscall::SYS_READ,
                        output.sub(offset, output.len()),
                        0,
                        "read exact",
                    )?;
                    if count == 0 {
                        return Result::Err(
                            kernel::error(
                                ErrorKind::UnexpectedEof,
                                "read exact",
                                "unexpected end of file",
                            ),
                        )
                    }
                    offset += count;
                }
                Result::Ok(())
            },
        )
    }

    pub fn write_all(self: Fd, input: Slice[byte]) -> Result[(), Error] {
        let data = input.to_vec();
        self.use_fd(
            "write all",
            |raw| {
                let mut offset = 0;
                while offset < data.len() {
                    let count = scalar_io(
                        raw,
                        syscall::SYS_WRITE,
                        data.slice_mut(offset, data.len()),
                        0,
                        "write all",
                    )?;
                    if count == 0 {
                        return Result::Err(
                            kernel::error(
                                ErrorKind::WriteZero,
                                "write all",
                                "write made no progress",
                            ),
                        )
                    }
                    offset += count;
                }
                Result::Ok(())
            },
        )
    }

    pub fn seek(self: Fd, offset: i64, whence: usize) -> Result[u64, Error] {
        self.use_fd(
            "seek",
            |raw| kernel::invoke(
                syscall::SYS_LSEEK,
                [
                    Arg::Word(raw),
                    Arg::Word(offset.to_usize()),
                    Arg::Word(whence),
                    Arg::Word(0),
                    Arg::Word(0),
                    Arg::Word(0),
                ],
                "seek",
            ).map(|value| value.to_u64()),
        )
    }
}

impl io::Read for Fd {
    fn read(self: Fd, buffer: MutSlice[byte]) -> Result[isize, Error] {
        self.read(buffer)
    }
}

impl io::Write for Fd {
    fn write(self: Fd, buffer: Slice[byte]) -> Result[isize, Error] {
        self.write(buffer)
    }
}

impl io::Close for Fd {
    fn close(self: Fd) -> Result[(), Error] {
        self.close()
    }
}
