package fd;

use module::io::{Error, ErrorKind};
use module::internal::linux as kernel;
use module::os::linux::abi;
use module::os::linux::syscall;
use module::os::linux::syscall::{Arg};
use module::utf8;

pub fn open(path: string, flags: usize, mode: u32) -> Result[Fd, Error] {
    open_at(AT_FDCWD, path, flags, mode)
}

pub fn open_at(directory: isize, path: string, flags: usize, mode: u32) -> Result[Fd, Error] {
    open_at_bytes(directory, utf8::encode(path).as_slice(), flags, mode)
}

pub fn open_at_bytes(directory: isize, path: Slice[byte], flags: usize, mode: u32) -> Result[
    Fd,
    Error,
] {
    let name = kernel::c_path(path, "openat")?;
    kernel::invoke(
        syscall::SYS_OPENAT,
        [
            Arg::Word(directory.to_usize()),
            Arg::Buffer(name.as_mut_slice()),
            Arg::Word(flags | O_CLOEXEC),
            Arg::Word(mode.to_usize()),
            Arg::Word(0),
            Arg::Word(0),
        ],
        "openat",
    ).map(owned)
}

pub fn open_at2(directory: isize, path: string, how: abi::OpenHow) -> Result[Fd, Error] {
    open_at2_bytes(directory, utf8::encode(path).as_slice(), how)
}

pub fn open_at2_bytes(directory: isize, path: Slice[byte], how: abi::OpenHow) -> Result[Fd, Error] {
    let name = kernel::c_path(path, "openat2")?;
    let options = abi::OpenHow {
        flags: how.flags | O_CLOEXEC.to_u64(),
        mode: how.mode,
        resolve: how.resolve,
    }.encode();
    kernel::invoke(
        syscall::SYS_OPENAT2,
        [
            Arg::Word(directory.to_usize()),
            Arg::Buffer(name.as_mut_slice()),
            Arg::Buffer(options.as_mut_slice()),
            Arg::Word(abi::OpenHow::size().to_usize()),
            Arg::Word(0),
            Arg::Word(0),
        ],
        "openat2",
    ).map(owned)
}

pub fn memfd(name: string, flags: usize) -> Result[Fd, Error] {
    let value = kernel::c_path(utf8::encode(name).as_slice(), "memfd_create")?;
    kernel::invoke(
        syscall::SYS_MEMFD_CREATE,
        [
            Arg::Buffer(value.as_mut_slice()),
            Arg::Word(flags | MFD_CLOEXEC),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
        "memfd_create",
    ).map(owned)
}

impl Fd {
    pub fn open_at(self: Fd, path: string, flags: usize, mode: u32) -> Result[Fd, Error] {
        self.use_fd("openat", |raw| open_at(raw.to_isize(), path, flags, mode))
    }

    pub fn open_at_bytes(self: Fd, path: Slice[byte], flags: usize, mode: u32) -> Result[Fd, Error] {
        self.use_fd("openat", |raw| open_at_bytes(raw.to_isize(), path, flags, mode))
    }

    pub fn open_at2(self: Fd, path: string, how: abi::OpenHow) -> Result[Fd, Error] {
        self.use_fd("openat2", |raw| open_at2(raw.to_isize(), path, how))
    }

    pub fn stat(self: Fd) -> Result[abi::Stat, Error] {
        self.use_fd(
            "fstat",
            |raw| {
                let data = kernel::zeroes(abi::Stat::size());
                kernel::invoke(
                    syscall::SYS_FSTAT,
                    [
                        Arg::Word(raw),
                        Arg::Buffer(data.as_mut_slice()),
                        Arg::Word(0),
                        Arg::Word(0),
                        Arg::Word(0),
                        Arg::Word(0),
                    ],
                    "fstat",
                )?;
                abi::Stat::decode(data.as_slice()).map_err(
                    |value| kernel::error(ErrorKind::InvalidData, "fstat", value.to_string()),
                )
            },
        )
    }

    pub fn truncate(self: Fd, length: i64) -> Result[(), Error] {
        self.use_fd(
            "ftruncate",
            |raw| kernel::invoke(
                syscall::SYS_FTRUNCATE,
                [
                    Arg::Word(raw),
                    Arg::Word(length.to_usize()),
                    Arg::Word(0),
                    Arg::Word(0),
                    Arg::Word(0),
                    Arg::Word(0),
                ],
                "ftruncate",
            ).map(|_| ()),
        )
    }

    pub fn chmod(self: Fd, mode: u32) -> Result[(), Error] {
        self.use_fd(
            "fchmod",
            |raw| kernel::invoke(
                syscall::SYS_FCHMOD,
                [
                    Arg::Word(raw),
                    Arg::Word(mode.to_usize()),
                    Arg::Word(0),
                    Arg::Word(0),
                    Arg::Word(0),
                    Arg::Word(0),
                ],
                "fchmod",
            ).map(|_| ()),
        )
    }

    pub fn chown(self: Fd, uid: u32, gid: u32) -> Result[(), Error] {
        self.use_fd(
            "fchown",
            |raw| kernel::invoke(
                syscall::SYS_FCHOWN,
                [
                    Arg::Word(raw),
                    Arg::Word(uid.to_usize()),
                    Arg::Word(gid.to_usize()),
                    Arg::Word(0),
                    Arg::Word(0),
                    Arg::Word(0),
                ],
                "fchown",
            ).map(|_| ()),
        )
    }

    pub fn sync(self: Fd) -> Result[(), Error] {
        self.use_fd(
            "fsync",
            |raw| kernel::invoke(
                syscall::SYS_FSYNC,
                [
                    Arg::Word(raw),
                    Arg::Word(0),
                    Arg::Word(0),
                    Arg::Word(0),
                    Arg::Word(0),
                    Arg::Word(0),
                ],
                "fsync",
            ).map(|_| ()),
        )
    }

    pub fn sync_data(self: Fd) -> Result[(), Error] {
        self.use_fd(
            "fdatasync",
            |raw| kernel::invoke(
                syscall::SYS_FDATASYNC,
                [
                    Arg::Word(raw),
                    Arg::Word(0),
                    Arg::Word(0),
                    Arg::Word(0),
                    Arg::Word(0),
                    Arg::Word(0),
                ],
                "fdatasync",
            ).map(|_| ()),
        )
    }

    pub fn allocate(self: Fd, mode: usize, offset: i64, length: i64) -> Result[(), Error] {
        self.use_fd(
            "fallocate",
            |raw| kernel::invoke(
                syscall::SYS_FALLOCATE,
                [
                    Arg::Word(raw),
                    Arg::Word(mode),
                    Arg::Word(offset.to_usize()),
                    Arg::Word(length.to_usize()),
                    Arg::Word(0),
                    Arg::Word(0),
                ],
                "fallocate",
            ).map(|_| ()),
        )
    }

    pub fn flock(self: Fd, operation: usize) -> Result[(), Error] {
        self.use_fd(
            "flock",
            |raw| kernel::invoke(
                syscall::SYS_FLOCK,
                [
                    Arg::Word(raw),
                    Arg::Word(operation),
                    Arg::Word(0),
                    Arg::Word(0),
                    Arg::Word(0),
                    Arg::Word(0),
                ],
                "flock",
            ).map(|_| ()),
        )
    }

    pub fn record_lock(self: Fd, command: usize, lock: abi::Flock) -> Result[abi::Flock, Error] {
        if command != F_GETLK && command != F_SETLK && command != F_SETLKW && command != F_OFD_GETLK
            && command != F_OFD_SETLK
            && command != F_OFD_SETLKW {
            return Result::Err(
                kernel::error(
                    ErrorKind::InvalidInput,
                    "record lock",
                    "expected a file-lock fcntl command",
                ),
            )
        }
        self.use_fd(
            "record lock",
            |raw| {
                let data = lock.encode();
                kernel::invoke(
                    syscall::SYS_FCNTL,
                    [
                        Arg::Word(raw),
                        Arg::Word(command),
                        Arg::Buffer(data.as_mut_slice()),
                        Arg::Word(0),
                        Arg::Word(0),
                        Arg::Word(0),
                    ],
                    "record lock",
                )?;
                abi::Flock::decode(data.as_slice()).map_err(
                    |value| kernel::error(ErrorKind::InvalidData, "record lock", value.to_string()),
                )
            },
        )
    }

    pub fn ioctl(self: Fd, request: usize, buffer: MutSlice[byte]) -> Result[usize, Error] {
        self.use_fd(
            "ioctl",
            |raw| kernel::call(
                syscall::SYS_IOCTL,
                [
                    Arg::Word(raw),
                    Arg::Word(request),
                    Arg::Buffer(buffer),
                    Arg::Word(0),
                    Arg::Word(0),
                    Arg::Word(0),
                ],
                "ioctl",
            ),
        )
    }
}
