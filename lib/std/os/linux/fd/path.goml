package fd;

use module::io::{Error, ErrorKind};
use module::internal::linux as kernel;
use module::os::linux::abi;
use module::os::linux::syscall;
use module::os::linux::syscall::{Arg};
use module::utf8;

pub fn stat_at(directory: isize, path: string, flags: usize) -> Result[abi::Stat, Error] {
    stat_at_bytes(directory, utf8::encode(path).as_slice(), flags)
}

pub fn stat_at_bytes(directory: isize, path: Slice[byte], flags: usize) -> Result[abi::Stat, Error] {
    let name = kernel::c_path(path, "fstatat")?;
    let data = kernel::zeroes(abi::Stat::size());
    kernel::invoke(
        syscall::SYS_NEWFSTATAT,
        [
            Arg::Word(directory.to_usize()),
            Arg::Buffer(name.as_mut_slice()),
            Arg::Buffer(data.as_mut_slice()),
            Arg::Word(flags),
            Arg::Word(0),
            Arg::Word(0),
        ],
        "fstatat",
    )?;
    abi::Stat::decode(data.as_slice()).map_err(
        |value| kernel::error(ErrorKind::InvalidData, "fstatat", value.to_string()),
    )
}

pub fn statx_at(directory: isize, path: string, flags: usize, mask: u32) -> Result[
    abi::Statx,
    Error,
] {
    statx_at_bytes(directory, utf8::encode(path).as_slice(), flags, mask)
}

pub fn statx_at_bytes(directory: isize, path: Slice[byte], flags: usize, mask: u32) -> Result[
    abi::Statx,
    Error,
] {
    let name = kernel::c_path(path, "statx")?;
    let data = kernel::zeroes(abi::Statx::size());
    kernel::invoke(
        syscall::SYS_STATX,
        [
            Arg::Word(directory.to_usize()),
            Arg::Buffer(name.as_mut_slice()),
            Arg::Word(flags),
            Arg::Word(mask.to_usize()),
            Arg::Buffer(data.as_mut_slice()),
            Arg::Word(0),
        ],
        "statx",
    )?;
    abi::Statx::decode(data.as_slice()).map_err(
        |value| kernel::error(ErrorKind::InvalidData, "statx", value.to_string()),
    )
}

pub fn mkdir_at(directory: isize, path: string, mode: u32) -> Result[(), Error] {
    mkdir_at_bytes(directory, utf8::encode(path).as_slice(), mode)
}

pub fn mkdir_at_bytes(directory: isize, path: Slice[byte], mode: u32) -> Result[(), Error] {
    let name = kernel::c_path(path, "mkdirat")?;
    kernel::invoke(
        syscall::SYS_MKDIRAT,
        [
            Arg::Word(directory.to_usize()),
            Arg::Buffer(name.as_mut_slice()),
            Arg::Word(mode.to_usize()),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
        "mkdirat",
    ).map(|_| ())
}

pub fn unlink_at(directory: isize, path: string, flags: usize) -> Result[(), Error] {
    unlink_at_bytes(directory, utf8::encode(path).as_slice(), flags)
}

pub fn unlink_at_bytes(directory: isize, path: Slice[byte], flags: usize) -> Result[(), Error] {
    let name = kernel::c_path(path, "unlinkat")?;
    kernel::invoke(
        syscall::SYS_UNLINKAT,
        [
            Arg::Word(directory.to_usize()),
            Arg::Buffer(name.as_mut_slice()),
            Arg::Word(flags),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
        "unlinkat",
    ).map(|_| ())
}

pub fn rename_at(
    old_directory: isize,
    old_path: string,
    new_directory: isize,
    new_path: string,
    flags: usize,
) -> Result[(), Error] {
    rename_at_bytes(
        old_directory,
        utf8::encode(old_path).as_slice(),
        new_directory,
        utf8::encode(new_path).as_slice(),
        flags,
    )
}

pub fn rename_at_bytes(
    old_directory: isize,
    old_path: Slice[byte],
    new_directory: isize,
    new_path: Slice[byte],
    flags: usize,
) -> Result[(), Error] {
    let old_name = kernel::c_path(old_path, "renameat2")?;
    let new_name = kernel::c_path(new_path, "renameat2")?;
    kernel::invoke(
        syscall::SYS_RENAMEAT2,
        [
            Arg::Word(old_directory.to_usize()),
            Arg::Buffer(old_name.as_mut_slice()),
            Arg::Word(new_directory.to_usize()),
            Arg::Buffer(new_name.as_mut_slice()),
            Arg::Word(flags),
            Arg::Word(0),
        ],
        "renameat2",
    ).map(|_| ())
}

pub fn link_at(
    old_directory: isize,
    old_path: string,
    new_directory: isize,
    new_path: string,
    flags: usize,
) -> Result[(), Error] {
    link_at_bytes(
        old_directory,
        utf8::encode(old_path).as_slice(),
        new_directory,
        utf8::encode(new_path).as_slice(),
        flags,
    )
}

pub fn link_at_bytes(
    old_directory: isize,
    old_path: Slice[byte],
    new_directory: isize,
    new_path: Slice[byte],
    flags: usize,
) -> Result[(), Error] {
    let old_name = kernel::c_path(old_path, "linkat")?;
    let new_name = kernel::c_path(new_path, "linkat")?;
    kernel::invoke(
        syscall::SYS_LINKAT,
        [
            Arg::Word(old_directory.to_usize()),
            Arg::Buffer(old_name.as_mut_slice()),
            Arg::Word(new_directory.to_usize()),
            Arg::Buffer(new_name.as_mut_slice()),
            Arg::Word(flags),
            Arg::Word(0),
        ],
        "linkat",
    ).map(|_| ())
}

pub fn symlink_at(target: string, directory: isize, path: string) -> Result[(), Error] {
    symlink_at_bytes(utf8::encode(target).as_slice(), directory, utf8::encode(path).as_slice())
}

pub fn symlink_at_bytes(target: Slice[byte], directory: isize, path: Slice[byte]) -> Result[
    (),
    Error,
] {
    let target_name = kernel::c_path(target, "symlinkat")?;
    let name = kernel::c_path(path, "symlinkat")?;
    kernel::invoke(
        syscall::SYS_SYMLINKAT,
        [
            Arg::Buffer(target_name.as_mut_slice()),
            Arg::Word(directory.to_usize()),
            Arg::Buffer(name.as_mut_slice()),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
        "symlinkat",
    ).map(|_| ())
}

pub fn readlink_at(directory: isize, path: string) -> Result[Vec[byte], Error] {
    readlink_at_bytes(directory, utf8::encode(path).as_slice())
}

pub fn readlink_at_bytes(directory: isize, path: Slice[byte]) -> Result[Vec[byte], Error] {
    let name = kernel::c_path(path, "readlinkat")?;
    let mut size = 256;
    loop {
        let data = kernel::zeroes(size);
        let count = kernel::invoke(
            syscall::SYS_READLINKAT,
            [
                Arg::Word(directory.to_usize()),
                Arg::Buffer(name.as_mut_slice()),
                Arg::Buffer(data.as_mut_slice()),
                Arg::Word(size.to_usize()),
                Arg::Word(0),
                Arg::Word(0),
            ],
            "readlinkat",
        )?;
        let length = checked_count(count, size, "readlinkat")?;
        if length < size {
            data.truncate(length);
            return Result::Ok(data);
        }
        if size > 0x3fffffffffffffff {
            return Result::Err(
                kernel::error(
                    ErrorKind::InvalidData,
                    "readlinkat",
                    "link length exceeds addressable memory",
                ),
            )
        }
        size *= 2;
    }
}

pub fn chmod_at(directory: isize, path: string, mode: u32, flags: usize) -> Result[(), Error] {
    chmod_at_bytes(directory, utf8::encode(path).as_slice(), mode, flags)
}

pub fn chmod_at_bytes(directory: isize, path: Slice[byte], mode: u32, flags: usize) -> Result[
    (),
    Error,
] {
    let name = kernel::c_path(path, "fchmodat")?;
    let number = if flags == 0 {
        syscall::SYS_FCHMODAT
    } else {
        syscall::SYS_FCHMODAT2
    };
    kernel::invoke(
        number,
        [
            Arg::Word(directory.to_usize()),
            Arg::Buffer(name.as_mut_slice()),
            Arg::Word(mode.to_usize()),
            Arg::Word(flags),
            Arg::Word(0),
            Arg::Word(0),
        ],
        "fchmodat",
    ).map(|_| ())
}

pub fn chown_at(directory: isize, path: string, uid: u32, gid: u32, flags: usize) -> Result[
    (),
    Error,
] {
    chown_at_bytes(directory, utf8::encode(path).as_slice(), uid, gid, flags)
}

pub fn chown_at_bytes(directory: isize, path: Slice[byte], uid: u32, gid: u32, flags: usize) -> Result[
    (),
    Error,
] {
    let name = kernel::c_path(path, "fchownat")?;
    kernel::invoke(
        syscall::SYS_FCHOWNAT,
        [
            Arg::Word(directory.to_usize()),
            Arg::Buffer(name.as_mut_slice()),
            Arg::Word(uid.to_usize()),
            Arg::Word(gid.to_usize()),
            Arg::Word(flags),
            Arg::Word(0),
        ],
        "fchownat",
    ).map(|_| ())
}

pub fn utimens_at(
    directory: isize,
    path: string,
    access: abi::Timespec,
    modified: abi::Timespec,
    flags: usize,
) -> Result[(), Error] {
    utimens_at_bytes(directory, utf8::encode(path).as_slice(), access, modified, flags)
}

pub fn utimens_at_bytes(
    directory: isize,
    path: Slice[byte],
    access: abi::Timespec,
    modified: abi::Timespec,
    flags: usize,
) -> Result[(), Error] {
    let name = kernel::c_path(path, "utimensat")?;
    let times = access.encode();
    times.extend(modified.encode());
    kernel::invoke(
        syscall::SYS_UTIMENSAT,
        [
            Arg::Word(directory.to_usize()),
            Arg::Buffer(name.as_mut_slice()),
            Arg::Buffer(times.as_mut_slice()),
            Arg::Word(flags),
            Arg::Word(0),
            Arg::Word(0),
        ],
        "utimensat",
    ).map(|_| ())
}
