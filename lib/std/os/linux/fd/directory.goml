package fd;

use module::io::{Error, ErrorKind};
use module::bytes::endian;
use module::internal::linux as kernel;
use module::os::linux::syscall;
use module::os::linux::syscall::{Arg};

pub struct DirEntry {
    pub inode: u64,
    pub next_offset: i64,
    pub kind: byte,
    pub name: Vec[byte],
}

fn invalid_dirent() -> Error {
    kernel::error(ErrorKind::InvalidData, "getdents64", "invalid directory record")
}

fn decode_dirents(data: Slice[byte]) -> Result[Vec[DirEntry], Error] {
    let result = Vec::new();
    let mut offset = 0;
    while offset < data.len() {
        if data.len() - offset < 20 {
            return Result::Err(invalid_dirent())
        }
        let length = endian::read_u16(data, offset + 16, endian::Endian::Little).map_err(
            |_| invalid_dirent(),
        )?.to_isize();
        if length < 24 || length % 8 != 0 || length > data.len() - offset {
            return Result::Err(invalid_dirent())
        }
        let mut end = offset + 19;
        while end < offset + length && data[end] != 0 {
            if data[end] == 47 {
                return Result::Err(invalid_dirent())
            }
            end += 1;
        }
        if end == offset + length || end == offset + 19 {
            return Result::Err(invalid_dirent())
        }
        result.push(
            DirEntry {
                inode: endian::read_u64(data, offset, endian::Endian::Little).map_err(
                    |_| invalid_dirent(),
                )?,
                next_offset: endian::read_i64(data, offset + 8, endian::Endian::Little).map_err(
                    |_| invalid_dirent(),
                )?,
                kind: data[offset + 18],
                name: data.sub(offset + 19, end).to_vec(),
            },
        );
        offset += length;
    }
    Result::Ok(result)
}

impl Fd {
    pub fn read_dir(self: Fd) -> Result[Vec[DirEntry], Error] {
        self.use_fd(
            "getdents64",
            |raw| {
                let data = kernel::zeroes(32768);
                let count = kernel::invoke(
                    syscall::SYS_GETDENTS64,
                    [
                        Arg::Word(raw),
                        Arg::Buffer(data.as_mut_slice()),
                        Arg::Word(data.len().to_usize()),
                        Arg::Word(0),
                        Arg::Word(0),
                        Arg::Word(0),
                    ],
                    "getdents64",
                )?;
                decode_dirents(data.slice(0, checked_count(count, data.len(), "getdents64")?))
            },
        )
    }
}
