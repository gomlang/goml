package process;

use module::internal::linux as kernel;
use module::io::{Error, ErrorKind};
use module::os::linux::fd;
use module::os::linux::syscall;
use module::os::linux::syscall::{Arg};

fn checked_signal(signal: usize, operation: string) -> Result[(), Error] {
    if signal > SIGRTMAX {
        Result::Err(
            kernel::error(ErrorKind::InvalidInput, operation, "signal must be between 0 and 64"),
        )
    } else {
        Result::Ok(())
    }
}

pub fn kill(pid: isize, signal: usize) -> Result[(), Error] {
    checked_pid(pid, "kill")?;
    checked_signal(signal, "kill")?;
    kernel::invoke(
        syscall::SYS_KILL,
        [
            Arg::Word(pid.to_usize()),
            Arg::Word(signal),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
        "kill",
    ).map(|_| ())
}

pub fn signal_thread(group: isize, thread: isize, signal: usize) -> Result[(), Error] {
    checked_pid(group, "tgkill")?;
    checked_pid(thread, "tgkill")?;
    checked_signal(signal, "tgkill")?;
    kernel::invoke(
        syscall::SYS_TGKILL,
        [
            Arg::Word(group.to_usize()),
            Arg::Word(thread.to_usize()),
            Arg::Word(signal),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
        "tgkill",
    ).map(|_| ())
}

pub fn pidfd_open(pid: isize, flags: usize) -> Result[fd::Fd, Error] {
    checked_pid(pid, "pidfd_open")?;
    if flags > 0xffffffff {
        return Result::Err(kernel::errno_error("pidfd_open", syscall::EINVAL))
    }
    let raw = kernel::invoke(
        syscall::SYS_PIDFD_OPEN,
        [
            Arg::Word(pid.to_usize()),
            Arg::Word(flags),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
        "pidfd_open",
    )?;
    match fd::Fd::from_raw(raw.to_isize()) {
        Ok(handle) => Result::Ok(handle),
        Err(error) => {
            let _ = kernel::call(
                syscall::SYS_CLOSE,
                [
                    Arg::Word(raw),
                    Arg::Word(0),
                    Arg::Word(0),
                    Arg::Word(0),
                    Arg::Word(0),
                    Arg::Word(0),
                ],
                "close unadopted pidfd",
            );
            Result::Err(error)
        },
    }
}

pub fn pidfd_signal(handle: fd::Fd, signal: usize) -> Result[(), Error] {
    checked_signal(signal, "pidfd_send_signal")?;
    handle.with_raw_fd(
        |raw| kernel::invoke(
            syscall::SYS_PIDFD_SEND_SIGNAL,
            [
                Arg::Word(raw),
                Arg::Word(signal),
                Arg::Word(0),
                Arg::Word(0),
                Arg::Word(0),
                Arg::Word(0),
            ],
            "pidfd_send_signal",
        ).map(|_| ()),
    )
}
