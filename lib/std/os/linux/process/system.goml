pub fn process_group(pid: isize) -> Result[isize, Error] {
    checked_pid(pid, "process_group")?;
    kernel::invoke(
        syscall::SYS_GETPGID,
        [
            Arg::Word(pid.to_usize()),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
        "process_group",
    ).map(|value| value.to_isize())
}

pub fn session(pid: isize) -> Result[isize, Error] {
    checked_pid(pid, "session")?;
    kernel::invoke(
        syscall::SYS_GETSID,
        [
            Arg::Word(pid.to_usize()),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
        "session",
    ).map(|value| value.to_isize())
}

fn checked_pid(pid: isize, operation: string) -> Result[(), Error] {
    if pid < -0x80000000 || pid > 0x7fffffff {
        Result::Err(
            kernel::error(ErrorKind::InvalidInput, operation, "PID is outside signed 32-bit range"),
        )
    } else {
        Result::Ok(())
    }
}

pub fn set_process_group(pid: isize, group: isize) -> Result[(), Error] {
    checked_pid(pid, "setpgid")?;
    checked_pid(group, "setpgid")?;
    kernel::invoke(
        syscall::SYS_SETPGID,
        [
            Arg::Word(pid.to_usize()),
            Arg::Word(group.to_usize()),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
        "setpgid",
    ).map(|_| ())
}

pub fn create_session() -> Result[isize, Error] {
    kernel::invoke(
        syscall::SYS_SETSID,
        [Arg::Word(0), Arg::Word(0), Arg::Word(0), Arg::Word(0), Arg::Word(0), Arg::Word(0)],
        "setsid",
    ).map(|value| value.to_isize())
}

pub fn groups() -> Result[Vec[u32], Error] {
    loop {
        let count = kernel::invoke(
            syscall::SYS_GETGROUPS,
            [Arg::Word(0), Arg::Word(0), Arg::Word(0), Arg::Word(0), Arg::Word(0), Arg::Word(0)],
            "getgroups",
        )?;
        let data = kernel::zeroes(count.to_isize() * 4);
        let actual = match kernel::invoke(
            syscall::SYS_GETGROUPS,
            [
                Arg::Word(count),
                Arg::Buffer(data.as_mut_slice()),
                Arg::Word(0),
                Arg::Word(0),
                Arg::Word(0),
                Arg::Word(0),
            ],
            "getgroups",
        ) {
            Ok(value) => value,
            Err(error) => {
                if error.raw_os_code() == Option::Some(syscall::EINVAL.to_isize()) {
                    continue;
                }
                return Result::Err(error)
            },
        };
        if actual > count {
            continue;
        }
        let result = Vec::with_capacity(actual.to_isize());
        for index in 0..actual.to_isize() {
            result.push(
                endian::read_u32(data.as_slice(), index * 4, endian::Endian::Little).map_err(
                    |_| kernel::error(ErrorKind::InvalidData, "getgroups", "invalid group buffer"),
                )?,
            );
        }
        return Result::Ok(result);
    }
}

pub fn resource_usage(who: isize) -> Result[abi::Rusage, Error] {
    if who != RUSAGE_SELF && who != RUSAGE_CHILDREN && who != RUSAGE_THREAD {
        return Result::Err(kernel::errno_error("getrusage", syscall::EINVAL))
    }
    let data = kernel::zeroes(abi::Rusage::size());
    kernel::invoke(
        syscall::SYS_GETRUSAGE,
        [
            Arg::Word(who.to_usize()),
            Arg::Buffer(data.as_mut_slice()),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
        "getrusage",
    )?;
    abi::Rusage::decode(data.as_slice()).map_err(
        |_| kernel::error(ErrorKind::InvalidData, "getrusage", "invalid resource usage buffer"),
    )
}

pub fn resource_limit(pid: isize, resource: usize) -> Result[abi::Rlimit, Error] {
    prlimit(pid, resource, Option::None)
}

pub fn set_resource_limit(pid: isize, resource: usize, value: abi::Rlimit) -> Result[
    abi::Rlimit,
    Error,
] {
    prlimit(pid, resource, Option::Some(value))
}

fn prlimit(pid: isize, resource: usize, value: Option[abi::Rlimit]) -> Result[abi::Rlimit, Error] {
    checked_pid(pid, "prlimit64")?;
    if resource > RLIMIT_RTTIME {
        return Result::Err(kernel::errno_error("prlimit64", syscall::EINVAL))
    }
    let updated = match value {
        Some(limit) => limit.encode(),
        None => Vec::new(),
    };
    let previous = kernel::zeroes(abi::Rlimit::size());
    kernel::invoke(
        syscall::SYS_PRLIMIT64,
        [
            Arg::Word(pid.to_usize()),
            Arg::Word(resource),
            Arg::Buffer(updated.as_mut_slice()),
            Arg::Buffer(previous.as_mut_slice()),
            Arg::Word(0),
            Arg::Word(0),
        ],
        "prlimit64",
    )?;
    abi::Rlimit::decode(previous.as_slice()).map_err(
        |_| kernel::error(ErrorKind::InvalidData, "prlimit64", "invalid resource limit buffer"),
    )
}

pub fn priority(which: usize, who: u32) -> Result[isize, Error] {
    if which > PRIO_USER {
        return Result::Err(kernel::errno_error("getpriority", syscall::EINVAL))
    }
    kernel::invoke(
        syscall::SYS_GETPRIORITY,
        [
            Arg::Word(which),
            Arg::Word(who.to_usize()),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
        "getpriority",
    ).map(|value| 20 - value.to_isize())
}

pub fn set_priority(which: usize, who: u32, value: isize) -> Result[(), Error] {
    if which > PRIO_USER {
        return Result::Err(kernel::errno_error("setpriority", syscall::EINVAL))
    }
    if value < -20 || value > 19 {
        return Result::Err(
            kernel::error(
                ErrorKind::InvalidInput,
                "setpriority",
                "priority must be between -20 and 19",
            ),
        )
    }
    kernel::invoke(
        syscall::SYS_SETPRIORITY,
        [
            Arg::Word(which),
            Arg::Word(who.to_usize()),
            Arg::Word(value.to_usize()),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
        "setpriority",
    ).map(|_| ())
}

pub struct ResIds {
    pub real: u32,
    pub effective: u32,
    pub saved: u32,
}

fn read_res_ids(number: usize, operation: string) -> Result[ResIds, Error] {
    let data = kernel::zeroes(12);
    kernel::invoke(
        number,
        [
            Arg::Buffer(data.as_mut_slice().sub(0, 4)),
            Arg::Buffer(data.as_mut_slice().sub(4, 8)),
            Arg::Buffer(data.as_mut_slice().sub(8, 12)),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
        operation,
    )?;
    let real = endian::read_u32(data.as_slice(), 0, endian::Endian::Little).map_err(
        |_| kernel::error(ErrorKind::InvalidData, operation, "invalid ID buffer"),
    )?;
    let effective = endian::read_u32(data.as_slice(), 4, endian::Endian::Little).map_err(
        |_| kernel::error(ErrorKind::InvalidData, operation, "invalid ID buffer"),
    )?;
    let saved = endian::read_u32(data.as_slice(), 8, endian::Endian::Little).map_err(
        |_| kernel::error(ErrorKind::InvalidData, operation, "invalid ID buffer"),
    )?;
    Result::Ok(ResIds { real, effective, saved })
}

pub fn user_ids() -> Result[ResIds, Error] {
    read_res_ids(syscall::SYS_GETRESUID, "getresuid")
}

pub fn group_ids() -> Result[ResIds, Error] {
    read_res_ids(syscall::SYS_GETRESGID, "getresgid")
}
