package process;

use module::internal::linux as kernel;
use module::io::{Error, ErrorKind};
use module::os::linux::abi;
use module::os::linux::syscall;
use module::os::linux::syscall::{Arg};
use module::bytes::endian;

pub fn pid() -> Result[isize, Error] {
    kernel::invoke(
        syscall::SYS_GETPID,
        [Arg::Word(0), Arg::Word(0), Arg::Word(0), Arg::Word(0), Arg::Word(0), Arg::Word(0)],
        "pid",
    ).map(|value| value.to_isize())
}

pub fn parent_pid() -> Result[isize, Error] {
    kernel::invoke(
        syscall::SYS_GETPPID,
        [Arg::Word(0), Arg::Word(0), Arg::Word(0), Arg::Word(0), Arg::Word(0), Arg::Word(0)],
        "parent_pid",
    ).map(|value| value.to_isize())
}

