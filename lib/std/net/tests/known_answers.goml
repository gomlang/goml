package tests;

use std::bytes;
use std::encoding::hex;
use std::fs;
use std::testing;

static KNOWN_ANSWERS: OnceCell[HashMap[string, HashMap[string, Vec[string]]]] = OnceCell::new();

fn known_answer(key: string) -> Vec[string] {
    let tables = KNOWN_ANSWERS.get_or_init(|| HashMap::new());
    let operation = key.split(":")[0];
    let answers = tables.get_or_insert_with(
        operation,
        || {
            let content = testing::expect_ok(
                fs::read_file_structured("net/tests/known_answers/" + operation + ".tsv"),
                "read known answers",
            );
            let values: HashMap[string, Vec[string]] = HashMap::new();
            for line in content.split("\n") {
                if line.byte_len() > 0 {
                    let fields = line.split("\t");
                    let outputs = Vec::new();
                    for index in 1..fields.len() {
                        outputs.push(fields[index]);
                    }
                    testing::assert(!values.contains(fields[0]));
                    values.set(fields[0], outputs);
                }
            }
            values
        },
    );
    testing::expect_some(answers.get(key), "missing known answer: " + key)
}

fn answer_unsigned(value: string) -> u64 {
    let mut result: u64 = 0;
    testing::assert(value.byte_len() > 0);
    for digit in value.to_bytes() {
        testing::assert(digit >= b'0' && digit <= b'9');
        result = result * 10 + (digit - b'0').to_u64();
    }
    result
}

fn answer_signed(value: string) -> i64 {
    if value.starts_with("-") {
        (0.to_u64() - answer_unsigned(value.byte_slice(1, value.byte_len()))).to_i64()
    } else {
        answer_unsigned(value).to_i64()
    }
}

fn answer_text(value: string) -> string {
    string_from_utf8(testing::expect_ok(hex::decode(value), "known answer hex").to_vec()).1
}

fn answer_bytes(value: Slice[byte]) -> string {
    hex::encode(bytes::Bytes::from_slice_copy(value))
}

fn expected_address_values(input: string) -> (string, string, string, string) {
    let values = known_answer("AddressValues:" + answer_bytes(input.to_bytes().as_slice()));
    (answer_text(values[0]), answer_text(values[1]), answer_text(values[2]), answer_text(values[3]))
}

fn expected_compare_addresses(left: string, right: string) -> isize {
    let values = known_answer(
        "CompareAddresses:" + answer_bytes(left.to_bytes().as_slice()) + ":"
            + answer_bytes(right.to_bytes().as_slice()),
    );
    answer_signed(values[0]).to_isize()
}

fn expected_valid_prefix(input: string) -> bool {
    let values = known_answer("ValidPrefix:" + answer_bytes(input.to_bytes().as_slice()));
    values[0] == "true"
}

fn expected_parse_address_bytes(input: string) -> (bool, string, string) {
    let values = known_answer("ParseAddressBytes:" + answer_bytes(input.to_bytes().as_slice()));
    (values[0] == "true", answer_text(values[1]), answer_text(values[2]))
}

fn expected_parse_prefix_bytes(input: string) -> (bool, string, isize) {
    let values = known_answer("ParsePrefixBytes:" + answer_bytes(input.to_bytes().as_slice()));
    (values[0] == "true", answer_text(values[1]), answer_signed(values[2]).to_isize())
}

fn expected_scoped_address_facts(input: string) -> (bool, string, string, string) {
    let values = known_answer("ScopedAddressFacts:" + answer_bytes(input.to_bytes().as_slice()));
    (values[0] == "true", answer_text(values[1]), answer_text(values[2]), answer_text(values[3]))
}
