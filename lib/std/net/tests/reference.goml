package tests;

use std::net;
use std::testing;

fn reference_address_bytes(address: net::IpAddr) -> Vec[byte] {
    let result: Vec[byte] = Vec::new();
    match address {
        net::IpAddr::V4(parts) => for part in parts {
            result.push(part);
        },
        net::IpAddr::V6(parts) => for part in parts {
            result.push((part / 256).to_u8());
            result.push((part % 256).to_u8());
        },
    }
    result
}

fn reference_address_facts(address: net::IpAddr) -> (u32, net::IpAddr) {
    let parts = reference_address_bytes(address);
    let v4 = parts.len() == 4;
    let mut mapped = !v4;
    if !v4 {
        for index in 0..10 {
            mapped = mapped && parts[index] == 0;
        }
        mapped = mapped && parts[10] == 255 && parts[11] == 255;
    }
    let mut unspecified = true;
    for part in parts {
        unspecified = unspecified && part == 0;
    }
    let mut loopback = false;
    let mut private = false;
    let mut multicast = false;
    let mut link_unicast = false;
    let mut link_multicast = false;
    let mut interface_multicast = false;
    let mut broadcast = false;
    let mut unmapped = address;
    if v4 || mapped {
        let offset = parts.len() - 4;
        let a = parts[offset];
        let b = parts[offset + 1];
        loopback = a == 127;
        private = a == 10 || (a == 172 && b >= 16 && b <= 31) || (a == 192 && b == 168);
        multicast = a >= 224 && a <= 239;
        link_unicast = a == 169 && b == 254;
        link_multicast = a == 224 && b == 0 && parts[offset + 2] == 0;
        broadcast = a == 255 && b == 255 && parts[offset + 2] == 255 && parts[offset + 3] == 255;
        unmapped = net::IpAddr::V4([a, b, parts[offset + 2], parts[offset + 3]]);
    } else {
        loopback = parts[15] == 1;
        for index in 0..15 {
            loopback = loopback && parts[index] == 0;
        }
        private = parts[0] == 252 || parts[0] == 253;
        multicast = parts[0] == 255;
        link_unicast = parts[0] == 254 && parts[1] >= 128 && parts[1] <= 191;
        link_multicast = multicast && parts[1] % 16 == 2;
        interface_multicast = multicast && parts[1] % 16 == 1;
    }
    let mut global = !unspecified && !loopback && !multicast && !link_unicast && !broadcast;
    if mapped {
        global = global && !(parts[12] == 0 && parts[13] == 0 && parts[14] == 0 && parts[15] == 0);
    }
    let flags = [
        v4,
        !v4,
        mapped,
        unspecified,
        loopback,
        private,
        multicast,
        link_unicast,
        link_multicast,
        interface_multicast,
        global,
    ];
    let mut result: u32 = 0;
    for index in 0..11 {
        if flags[index] {
            result = result | (1.to_u32() << index);
        }
    }
    return (result, unmapped)
}

fn reference_same_prefix(left: Vec[byte], right: Vec[byte], bits: isize) -> bool {
    if left.len() != right.len() {
        return false
    }
    for index in 0..bits {
        let shift = 7 - index % 8;
        if ((left[index / 8] >> shift) & 1) != ((right[index / 8] >> shift) & 1) {
            return false
        }
    }
    true
}

fn reference_prefix_facts(prefix: net::IpPrefix, address: net::IpAddr, other: net::IpPrefix) -> (
    net::IpPrefix,
    bool,
    bool,
) {
    let parts = reference_address_bytes(prefix.address());
    let masked = parts.copy();
    for index in prefix.bits()..parts.len() * 8 {
        masked[index / 8] = masked[index / 8] & (255.to_u8() ^ (1.to_u8() << (7 - index % 8)));
    }
    let masked_address = if masked.len() == 4 {
        net::IpAddr::V4([masked[0], masked[1], masked[2], masked[3]])
    } else {
        let mut words: [u16; 8] = [0, 0, 0, 0, 0, 0, 0, 0];
        for index in 0..8 {
            words[index] = masked[index * 2].to_u16() * 256 + masked[index * 2 + 1].to_u16();
        }
        net::IpAddr::V6(words)
    };
    let contains = reference_same_prefix(parts, reference_address_bytes(address), prefix.bits());
    let overlap_bits = if prefix.bits() < other.bits() {
        prefix.bits()
    } else {
        other.bits()
    };
    let overlaps = reference_same_prefix(
        parts,
        reference_address_bytes(other.address()),
        overlap_bits,
    );
    (
        testing::expect_ok(net::IpPrefix::new(masked_address, prefix.bits()), "reference mask"),
        contains,
        overlaps,
    )
}
