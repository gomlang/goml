package net;

use module::io::{Error, ErrorKind};

pub enum IpAddr {
    V4([byte; 4]),
    V6([u16; 8]),
}

pub struct SocketAddr {
    pub ip: IpAddr,
    pub port: u16,
    pub scope_id: u32,
}

fn invalid_address() -> Error {
    error(
        ErrorKind::InvalidInput,
        "parse address",
        "expected a numeric IP address and a valid port",
    )
}

fn digits(value: string, radix: u32, maximum: u32) -> Result[u32, Error] {
    if value.byte_len() == 0 {
        return Result::Err(invalid_address());
    }
    let mut result: u32 = 0;
    for index in 0..value.byte_len() {
        let ch = value.byte_get(index);
        let digit = if ch >= 48 && ch <= 57 {
            ch.to_u32() - 48
        } else if ch >= 97 && ch <= 102 {
            ch.to_u32() - 87
        } else if ch >= 65 && ch <= 70 {
            ch.to_u32() - 55
        } else {
            return Result::Err(invalid_address());
        };
        if digit >= radix || digit > maximum || result > (maximum - digit) / radix {
            return Result::Err(invalid_address());
        }
        result = result * radix + digit;
    }
    Result::Ok(result)
}

fn parse_v4(value: string) -> Result[[byte; 4], Error] {
    let parts = value.split(".");
    if parts.len() != 4 {
        return Result::Err(invalid_address());
    }
    let mut result: [byte; 4] = [0, 0, 0, 0];
    for index in 0..4 {
        let part = parts[index];
        if part.byte_len() > 1 && part.starts_with("0") {
            return Result::Err(invalid_address());
        }
        result[index] = digits(part, 10, 255)?.to_u8();
    }
    Result::Ok(result)
}

fn parse_segments(value: string, dotted_tail: bool) -> Result[Vec[u16], Error] {
    let result = Vec::new();
    if value == "" {
        return Result::Ok(result);
    }
    let parts = value.split(":");
    for index in 0..parts.len() {
        let part = parts[index];
        if part.contains(".") {
            if !dotted_tail || index != parts.len() - 1 {
                return Result::Err(invalid_address());
            }
            let v4 = parse_v4(part)?;
            result.push((v4[0].to_u16() << 8) | v4[1].to_u16());
            result.push((v4[2].to_u16() << 8) | v4[3].to_u16());
        } else {
            if part.byte_len() > 4 {
                return Result::Err(invalid_address());
            }
            result.push(digits(part, 16, 0xffff)?.to_u16());
        }
    }
    Result::Ok(result)
}

impl IpAddr {
    pub fn parse(value: string) -> Result[IpAddr, Error] {
        if !value.contains(":") {
            return parse_v4(value).map(|v| IpAddr::V4(v));
        }
        let (left, right, compressed) = match value.split_once("::") {
            Some((left, right)) => (
                parse_segments(left, false)?,
                parse_segments(right, true)?,
                true,
            ),
            None => (parse_segments(value, true)?, Vec::new(), false),
        };
        let count = left.len() + right.len();
        if count > 8 || compressed && count == 8 || !compressed && count != 8 {
            return Result::Err(invalid_address());
        }
        let mut result: [u16; 8] = [0, 0, 0, 0, 0, 0, 0, 0];
        for index in 0..left.len() {
            result[index] = left[index];
        }
        for index in 0..right.len() {
            result[8 - right.len() + index] = right[index];
        }
        Result::Ok(IpAddr::V6(result))
    }

    pub fn is_ipv4(self: IpAddr) -> bool {
        match self {
            V4(_) => true,
            V6(_) => false,
        }
    }

    pub fn is_ipv6(self: IpAddr) -> bool {
        !self.is_ipv4()
    }
}

fn hex_segment(value: u16) -> string {
    let digits = "0123456789abcdef";
    let mut remaining = value.to_usize();
    let mut result = "";
    loop {
        let index = (remaining % 16).to_isize();
        result = digits.byte_slice(index, index + 1) + result;
        remaining = remaining / 16;
        if remaining == 0 {
            return result;
        }
    }
}

impl ToString for IpAddr {
    fn to_string(self: IpAddr) -> string {
        match self {
            V4(parts) => parts[0].to_string() + "." + parts[1].to_string() + "."
                + parts[2].to_string()
                + "."
                + parts[3].to_string(),
            V6(parts) => {
                let mut best_start = 0;
                let mut best_length = 1;
                let mut index = 0;
                while index < 8 {
                    let start = index;
                    while index < 8 && parts[index] == 0 {
                        index += 1;
                    }
                    if index - start > best_length {
                        best_start = start;
                        best_length = index - start;
                    }
                    index += 1;
                }
                let before = Vec::new();
                let after = Vec::new();
                for index in 0..8 {
                    if best_length == 1 || index < best_start {
                        before.push(hex_segment(parts[index]));
                    } else if index >= best_start + best_length {
                        after.push(hex_segment(parts[index]));
                    }
                }
                if best_length == 1 {
                    before.join(":")
                } else {
                    before.join(":") + "::" + after.join(":")
                }
            },
        }
    }
}

impl PartialEq for IpAddr {
    fn eq(self: IpAddr, other: IpAddr) -> bool {
        self.to_string() == other.to_string()
    }
}

impl Eq for IpAddr {}

impl Debug for IpAddr {
    fn debug(self: IpAddr) -> string {
        self.to_string()
    }
}

impl SocketAddr {
    pub fn new(ip: IpAddr, port: u16) -> SocketAddr {
        SocketAddr { ip, port, scope_id: 0 }
    }

    pub fn parse(value: string) -> Result[SocketAddr, Error] {
        if value.starts_with("[") {
            let (host, port) = value.split_once("]:").ok_or(invalid_address())?;
            let host = host.byte_slice(1, host.byte_len());
            let (ip, scope_id) = match host.split_once("%") {
                Some((ip, scope)) => (IpAddr::parse(ip)?, digits(scope, 10, 4294967295)?),
                None => (IpAddr::parse(host)?, 0),
            };
            if !ip.is_ipv6() {
                return Result::Err(invalid_address());
            }
            Result::Ok(SocketAddr { ip, port: digits(port, 10, 65535)?.to_u16(), scope_id })
        } else {
            let (ip, port) = value.split_once(":").ok_or(invalid_address())?;
            Result::Ok(
                SocketAddr::new(IpAddr::V4(parse_v4(ip)?), digits(port, 10, 65535)?.to_u16()),
            )
        }
    }
}

impl ToString for SocketAddr {
    fn to_string(self: SocketAddr) -> string {
        let host = if self.ip.is_ipv6() {
            "[" + self.ip.to_string()
                + if self.scope_id == 0 {
                    ""
                } else {
                    "%" + self.scope_id.to_string()
                }
                + "]"
        } else {
            self.ip.to_string()
        };
        host + ":" + self.port.to_string()
    }
}

impl PartialEq for SocketAddr {
    fn eq(self: SocketAddr, other: SocketAddr) -> bool {
        self.ip == other.ip && self.port == other.port && self.scope_id == other.scope_id
    }
}

impl Eq for SocketAddr {}

impl Debug for SocketAddr {
    fn debug(self: SocketAddr) -> string {
        self.to_string()
    }
}
