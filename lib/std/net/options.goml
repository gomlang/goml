package net;

use module::io::{Error, ErrorKind};
use module::task;
use module::context;
use module::time;

pub struct WaitOptions {
    timeout: Option[time::Duration],
    cancel: Option[task::CancelToken],
    context: Option[context::Context],
}

impl WaitOptions {
    pub fn new() -> WaitOptions {
        WaitOptions { timeout: Option::None, cancel: Option::None, context: Option::None }
    }

    pub fn with_context(self: WaitOptions, context: context::Context) -> WaitOptions {
        WaitOptions { context: Option::Some(context), ..self }
    }

    pub fn with_timeout(self: WaitOptions, timeout: time::Duration) -> WaitOptions {
        WaitOptions { timeout: Option::Some(timeout), ..self }
    }

    pub fn with_cancel(self: WaitOptions, cancel: task::CancelToken) -> WaitOptions {
        WaitOptions { cancel: Option::Some(cancel), ..self }
    }
}

struct Wait {
    timer: Option[time::Timer],
    expired: Receiver[()],
    cancel: Receiver[()],
    context_signal: Receiver[()],
    context: Option[context::Context],
    started: time::Instant,
    timeout: Option[time::Duration],
    operation: string,
}

impl Wait {
    fn new(options: WaitOptions, operation: string) -> Wait {
        let options = if let Some(context) = options.context {
            let timeout = match (options.timeout, context.remaining()) {
                (Some(left), Some(right)) => Option::Some(
                    if left.compare(right) < 0 {
                        left
                    } else {
                        right
                    },
                ),
                (Some(left), None) => Option::Some(left),
                (None, right) => right,
            };
            WaitOptions { timeout, ..options }
        } else {
            options
        };
        let never: Channel[()] = Channel::new(0);
        let started = time::Instant::now();
        let timer = options.timeout.map(|duration| time::Timer::new(duration));
        Wait {
            timer,
            expired: timer.map(|value| value.done()).unwrap_or(never.receiver()),
            cancel: options.cancel.map(|value| value.done()).unwrap_or(never.receiver()),
            context_signal: options.context.map(|value| value.done()).unwrap_or(never.receiver()),
            context: options.context,
            started,
            timeout: options.timeout,
            operation,
        }
    }

    fn stop(self: Wait) -> () {
        if let Some(timer) = self.timer {
            let _ = timer.stop();
        }
    }

    fn cancelled(self: Wait) -> Error {
        if let Some(context) = self.context {
            if let Some(context::Error::DeadlineExceeded) = context.error() {
                return self.timed_out()
            }
        }
        error(ErrorKind::Interrupted, self.operation, "operation cancelled")
    }

    fn timed_out(self: Wait) -> Error {
        error(ErrorKind::TimedOut, self.operation, "operation timed out")
    }

    fn check(self: Wait) -> Result[(), Error] {
        let cancelled = select {
            recv(self.cancel) as _ => true,
            recv(self.context_signal) as _ => true,
            default => false,
        };
        if cancelled {
            return Result::Err(self.cancelled());
        }
        if let Some(timeout) = self.timeout {
            if self.started.elapsed().compare(timeout) >= 0 {
                return Result::Err(self.timed_out());
            }
        }
        Result::Ok(())
    }

    fn acquire(self: Wait, gate: Channel[()], closed_signal: Channel[()]) -> Result[(), Error] {
        self.check()?;
        select {
            recv(gate) as _ => Result::Ok(()),
            recv(closed_signal) as _ => Result::Err(closed(self.operation)),
            recv(self.cancel) as _ => Result::Err(self.cancelled()),
            recv(self.context_signal) as _ => Result::Err(self.cancelled()),
            recv(self.expired) as _ => Result::Err(self.timed_out()),
        }
    }
}
