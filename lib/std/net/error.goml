package net;

pub use module::io::{Error, ErrorKind};

fn error(kind: ErrorKind, operation: string, message: string) -> Error {
    Error::new(kind, operation, Option::None, Option::None, message)
}

fn closed(operation: string) -> Error {
    error(ErrorKind::InvalidInput, operation, "socket is closed")
}

fn errno_error(operation: string, errno: usize) -> Error {
    let kind = match errno {
        1 | 13 => ErrorKind::PermissionDenied,
        4 => ErrorKind::Interrupted,
        11 => ErrorKind::WouldBlock,
        9 | 22 | 89 | 97 => ErrorKind::InvalidInput,
        32 => ErrorKind::BrokenPipe,
        38 | 92 | 95 => ErrorKind::Unsupported,
        110 => ErrorKind::TimedOut,
        _ => ErrorKind::Other,
    };
    Error::new(
        kind,
        operation,
        Option::None,
        Option::Some(errno.to_isize()),
        "errno " + errno.to_string(),
    )
}
