package net;

use module::io::{Error, ErrorKind};

#[derive(Hash)]
pub struct ScopedIpAddr {
    address_value: IpAddr,
    zone_value: string,
}

impl ScopedIpAddr {
    pub fn new(address: IpAddr, zone: string) -> Result[ScopedIpAddr, Error] {
        if address.is_ipv4() && zone != "" {
            return Result::Err(
                error(ErrorKind::InvalidInput, "scoped IP address", "IPv4 cannot carry a zone"),
            )
        }
        Result::Ok(ScopedIpAddr { address_value: address, zone_value: zone })
    }

    pub fn parse(value: string) -> Result[ScopedIpAddr, Error] {
        match value.split_once("%") {
            Some((host, zone)) => {
                if zone == "" {
                    return Result::Err(
                        error(
                            ErrorKind::InvalidInput,
                            "scoped IP address",
                            "explicit zone must not be empty",
                        ),
                    )
                }
                ScopedIpAddr::new(IpAddr::parse(host)?, zone)
            },
            None => ScopedIpAddr::new(IpAddr::parse(value)?, ""),
        }
    }

    pub fn address(self: ScopedIpAddr) -> IpAddr {
        self.address_value
    }

    pub fn zone(self: ScopedIpAddr) -> string {
        self.zone_value
    }

    pub fn with_zone(self: ScopedIpAddr, zone: string) -> Result[ScopedIpAddr, Error] {
        ScopedIpAddr::new(self.address_value, zone)
    }

    pub fn without_zone(self: ScopedIpAddr) -> IpAddr {
        self.address_value
    }

    pub fn unmap(self: ScopedIpAddr) -> ScopedIpAddr {
        if self.address_value.is_ipv4_mapped() {
            ScopedIpAddr { address_value: self.address_value.unmap(), zone_value: "" }
        } else {
            self
        }
    }

    pub fn to_socket_addr(self: ScopedIpAddr, port: u16) -> Result[SocketAddr, Error] {
        let scope_id = if self.zone_value == "" {
            0
        } else {
            digits(self.zone_value, 10, 4294967295).map_err(
                |_| {
                    error(
                        ErrorKind::InvalidInput,
                        "scoped IP address",
                        "socket scope requires a numeric u32 zone; resolve interface names explicitly",
                    )
                },
            )?
        };
        Result::Ok(SocketAddr { ip: self.address_value, port, scope_id })
    }

    pub fn from_socket_addr(address: SocketAddr) -> Result[ScopedIpAddr, Error] {
        ScopedIpAddr::new(
            address.ip,
            if address.scope_id == 0 {
                ""
            } else {
                address.scope_id.to_string()
            },
        )
    }
}

impl IpAddr {
    pub fn with_zone(self: IpAddr, zone: string) -> Result[ScopedIpAddr, Error] {
        ScopedIpAddr::new(self, zone)
    }
}

impl ToString for ScopedIpAddr {
    fn to_string(self: ScopedIpAddr) -> string {
        self.address_value.to_string()
            + if self.zone_value == "" {
                ""
            } else {
                "%" + self.zone_value
            }
    }
}

impl Debug for ScopedIpAddr {
    fn debug(self: ScopedIpAddr) -> string {
        self.to_string()
    }
}

impl PartialEq for ScopedIpAddr {
    fn eq(self: ScopedIpAddr, other: ScopedIpAddr) -> bool {
        self.address_value == other.address_value && self.zone_value == other.zone_value
    }
}

impl Eq for ScopedIpAddr {}
