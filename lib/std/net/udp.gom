package net;

use module::io::{Error, ErrorKind};
use module::os::linux::syscall;
use module::os::linux::syscall::{Arg};

pub struct UdpSocket {
    socket: Socket,
}

pub struct Datagram {
    pub source: SocketAddr,
    pub len: isize,
    pub datagram_len: isize,
    pub truncated: bool,
}

impl UdpSocket {
    pub fn bind(address: SocketAddr) -> Result[UdpSocket, Error] {
        let socket = socket_from_fd(create_socket(address, true)?)?;
        if let Err(value) = socket.with_fd("bind UDP", |fd| bind_socket(fd, address)) {
            let _ = socket.close();
            return Result::Err(value);
        }
        Result::Ok(UdpSocket { socket })
    }

    pub fn local_addr(self: UdpSocket) -> Result[SocketAddr, Error] {
        self.socket.with_fd("local address", |fd| socket_address(fd, false))
    }

    pub fn close(self: UdpSocket) -> Result[(), Error] {
        self.socket.close()
    }

    pub fn is_closed(self: UdpSocket) -> bool {
        self.socket.is_closed()
    }

    pub fn send_to(self: UdpSocket, data: Slice[byte], destination: SocketAddr) -> Result[
        isize,
        Error,
    ] {
        self.send_to_with(data, destination, WaitOptions::new())
    }

    pub fn send_to_with(
        self: UdpSocket,
        data: Slice[byte],
        destination: SocketAddr,
        options: WaitOptions,
    ) -> Result[isize, Error] {
        let wait = Wait::new(options, "send UDP");
        defer wait.stop();
        wait.acquire(self.socket.writer, self.socket.ended)?;
        defer self.socket.writer.send(());
        let address = encode_address(destination)?;
        let buffer = data.to_vec();
        self.socket.perform(
            true,
            wait,
            |fd| call(
                syscall::SYS_SENDTO,
                [
                    Arg::Word(fd),
                    Arg::Buffer(buffer.as_mut_slice()),
                    Arg::Word(buffer.len().to_usize()),
                    Arg::Word(0x4000),
                    Arg::Buffer(address.as_mut_slice()),
                    Arg::Word(address.len().to_usize()),
                ],
                "send UDP",
            ).map(|size| size.to_isize()),
        )
    }

    pub fn recv_from(self: UdpSocket, buffer: MutSlice[byte]) -> Result[Datagram, Error] {
        self.recv_from_with(buffer, WaitOptions::new())
    }

    pub fn recv_from_with(self: UdpSocket, buffer: MutSlice[byte], options: WaitOptions) -> Result[
        Datagram,
        Error,
    ] {
        let wait = Wait::new(options, "receive UDP");
        defer wait.stop();
        wait.acquire(self.socket.reader, self.socket.ended)?;
        defer self.socket.reader.send(());
        let address = zeroes(28);
        let size = zeroes(4);
        let count = self.socket.perform(
            false,
            wait,
            |fd| {
                put_le(size.as_mut_slice(), 0, 28, 4);
                call(
                    syscall::SYS_RECVFROM,
                    [
                        Arg::Word(fd),
                        Arg::Buffer(buffer),
                        Arg::Word(buffer.len().to_usize()),
                        Arg::Word(0x20),
                        Arg::Buffer(address.as_mut_slice()),
                        Arg::Buffer(size.as_mut_slice()),
                    ],
                    "receive UDP",
                ).map(|value| value.to_isize())
            },
        )?;
        let address_size = get_le(size.as_slice(), 0, 4).to_isize();
        if address_size > address.len() {
            return Result::Err(
                error(ErrorKind::InvalidData, "receive UDP", "invalid address length"),
            );
        }
        Result::Ok(
            Datagram {
                source: decode_address(address.slice(0, address_size))?,
                len: if count > buffer.len() {
                    buffer.len()
                } else {
                    count
                },
                datagram_len: count,
                truncated: count > buffer.len(),
            },
        )
    }
}
