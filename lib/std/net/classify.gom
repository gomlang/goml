package net;

impl IpAddr {
    pub fn bit_len(self: IpAddr) -> isize {
        if self.is_ipv4() {
            32
        } else {
            128
        }
    }

    pub fn is_ipv4_mapped(self: IpAddr) -> bool {
        match self {
            V4(_) => false,
            V6(parts) => parts[0] == 0 && parts[1] == 0 && parts[2] == 0 && parts[3] == 0
                && parts[4] == 0
                && parts[5] == 0xffff,
        }
    }

    pub fn unmap(self: IpAddr) -> IpAddr {
        match self {
            V6(parts) => {
                if self.is_ipv4_mapped() {
                    IpAddr::V4(
                        [
                            (parts[6] >> 8).to_u8(),
                            (parts[6] & 255).to_u8(),
                            (parts[7] >> 8).to_u8(),
                            (parts[7] & 255).to_u8(),
                        ],
                    )
                } else {
                    self
                }
            },
            V4(_) => self,
        }
    }

    pub fn is_unspecified(self: IpAddr) -> bool {
        match self {
            V4(parts) => parts[0] == 0 && parts[1] == 0 && parts[2] == 0 && parts[3] == 0,
            V6(parts) => {
                for part in parts {
                    if part != 0 {
                        return false
                    }
                }
                true
            },
        }
    }

    pub fn is_loopback(self: IpAddr) -> bool {
        match self.unmap() {
            V4(parts) => parts[0] == 127,
            V6(parts) => parts[0] == 0 && parts[1] == 0 && parts[2] == 0 && parts[3] == 0
                && parts[4] == 0
                && parts[5] == 0
                && parts[6] == 0
                && parts[7] == 1,
        }
    }

    pub fn is_private(self: IpAddr) -> bool {
        match self.unmap() {
            V4(parts) => parts[0] == 10 || parts[0] == 172 && parts[1] >= 16 && parts[1] <= 31
                || parts[0] == 192 && parts[1] == 168,
            V6(parts) => (parts[0] & 0xfe00) == 0xfc00,
        }
    }

    pub fn is_multicast(self: IpAddr) -> bool {
        match self.unmap() {
            V4(parts) => parts[0] >= 224 && parts[0] <= 239,
            V6(parts) => (parts[0] & 0xff00) == 0xff00,
        }
    }

    pub fn is_link_local_unicast(self: IpAddr) -> bool {
        match self.unmap() {
            V4(parts) => parts[0] == 169 && parts[1] == 254,
            V6(parts) => (parts[0] & 0xffc0) == 0xfe80,
        }
    }

    pub fn is_link_local_multicast(self: IpAddr) -> bool {
        match self.unmap() {
            V4(parts) => parts[0] == 224 && parts[1] == 0 && parts[2] == 0,
            V6(parts) => (parts[0] & 0xff0f) == 0xff02,
        }
    }

    pub fn is_interface_local_multicast(self: IpAddr) -> bool {
        match self {
            V4(_) => false,
            V6(parts) => (parts[0] & 0xff0f) == 0xff01,
        }
    }

    pub fn is_global_unicast(self: IpAddr) -> bool {
        let address = self.unmap();
        if address == IpAddr::V4([255, 255, 255, 255]) {
            return false
        }
        !address.is_unspecified() && !address.is_loopback() && !address.is_multicast()
            && !address.is_link_local_unicast()
    }
}
