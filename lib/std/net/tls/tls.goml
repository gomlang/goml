package tls;

use module::context;
use module::io;
use module::net;
use module::time;

pub enum Version {
    Tls12,
    Tls13,
}

pub struct ClientConfig {
    server_name: string,
    roots: Vec[byte],
    certificate: Vec[byte],
    private_key: Vec[byte],
    protocols: Vec[string],
    minimum: Version,
    timeout: time::Duration,
}

impl ClientConfig {
    pub fn new(server_name: string) -> ClientConfig {
        ClientConfig {
            server_name,
            roots: Vec::new(),
            certificate: Vec::new(),
            private_key: Vec::new(),
            protocols: Vec::new(),
            minimum: Version::Tls12,
            timeout: time::Duration::from_seconds(30),
        }
    }

    pub fn with_ca_pem(self: ClientConfig, pem: Slice[byte]) -> ClientConfig {
        ClientConfig { roots: copied(pem), ..self }
    }

    pub fn with_client_certificate(
        self: ClientConfig,
        certificate: Slice[byte],
        private_key: Slice[byte],
    ) -> ClientConfig {
        ClientConfig { certificate: copied(certificate), private_key: copied(private_key), ..self }
    }

    pub fn with_alpn(self: ClientConfig, protocols: Vec[string]) -> ClientConfig {
        ClientConfig { protocols: protocols.copy(), ..self }
    }

    pub fn with_minimum_version(self: ClientConfig, minimum: Version) -> ClientConfig {
        ClientConfig { minimum, ..self }
    }

    pub fn with_connect_timeout(self: ClientConfig, timeout: time::Duration) -> ClientConfig {
        ClientConfig { timeout, ..self }
    }
}

pub struct ConnectionInfo {
    pub version: Version,
    pub negotiated_protocol: string,
}

pub struct TlsStream {
    id: i64,
    read_gate: Channel[()],
    write_gate: Channel[()],
    closed: Channel[()],
    close_gate: Channel[()],
    handshake_gate: Channel[()],
    handshake_done: Channel[()],
    handshake_timeout: time::Duration,
}

fn copied(data: Slice[byte]) -> Vec[byte] {
    let result: Vec[byte] = Vec::with_capacity(data.len());
    for byte in data {
        result.push(byte)
    }
    result
}

fn validate_protocols(protocols: Slice[string], operation: string) -> Result[(), io::Error] {
    for protocol in protocols {
        if protocol.byte_len() == 0 || protocol.byte_len() > 255 {
            return Err(
                error(InvalidInput, operation, "ALPN identifiers must contain 1 to 255 bytes"),
            )
        }
    }
    Ok(())
}

fn error(kind: io::ErrorKind, operation: string, message: string) -> io::Error {
    io::Error::new(kind, operation, Option::None, Option::None, message)
}

fn runtime_error(kind: isize, operation: string, message: string) -> io::Error {
    error(
        match kind {
            2 => Interrupted,
            3 => TimedOut,
            4 => InvalidInput,
            5 => BrokenPipe,
            _ => Other,
        },
        operation,
        message,
    )
}

fn context_error(operation: string, value: context::Error) -> io::Error {
    error(
        match value {
            Cancelled => Interrupted,
            DeadlineExceeded => TimedOut,
        },
        operation,
        value.to_string(),
    )
}

fn check_context(context: context::Context, operation: string) -> Result[(), io::Error] {
    context.check().map_err(|value| context_error(operation, value))
}

fn cancellation_id(context: context::Context) -> i64 {
    context.token().map(|token| token.runtime_id()).unwrap_or(0)
}

fn operation_timeout(context: context::Context) -> i64 {
    context.remaining().map(|duration| duration.as_nanoseconds()).unwrap_or(-1)
}

pub fn connect(host: string, port: u16, config: ClientConfig) -> Result[TlsStream, io::Error] {
    connect_with(host, port, config, context::Context::background())
}

pub fn connect_with(host: string, port: u16, config: ClientConfig, context: context::Context) -> Result[
    TlsStream,
    io::Error,
] {
    check_context(context, "TLS connect")?;
    if host.byte_len() == 0 || host.to_bytes().contains(0) || config.server_name.byte_len() == 0
        || config.server_name.to_bytes().contains(0) {
        return Err(
            error(
                InvalidInput,
                "TLS connect",
                "host and verification name must be non-empty and contain no NUL",
            ),
        )
    }
    if config.certificate.is_empty() != config.private_key.is_empty() {
        return Err(
            error(
                InvalidInput,
                "TLS connect",
                "client certificate and private key must be provided together",
            ),
        )
    }
    validate_protocols(config.protocols.as_slice(), "TLS connect")?;
    let host = if host.contains(":") {
        "[" + host + "]"
    } else {
        host
    };
    let address = host + ":" + port.to_string();
    let timeout = match context.remaining() {
        Some(remaining) if remaining.compare(config.timeout) < 0 => remaining,
        _ => config.timeout,
    };
    let (ok, id, kind, message) = __goml_std_net_tls_connect(
        address,
        config.server_name,
        config.roots.copy(),
        config.certificate.copy(),
        config.private_key.copy(),
        config.protocols.copy(),
        version_number(config.minimum),
        cancellation_id(context),
        timeout.as_nanoseconds(),
    );
    if !ok {
        check_context(context, "TLS connect")?;
        return Err(runtime_error(kind, "TLS connect", message))
    }
    let stream = stream_from_runtime(id, config.timeout, true);
    if let Err(error) = check_context(context, "TLS connect") {
        let _ = stream.close();
        return Err(error)
    }
    Ok(stream)
}

impl TlsStream {
    fn acquire(self: TlsStream, gate: Channel[()], context: context::Context, operation: string) -> Result[
        (),
        io::Error,
    ] {
        check_context(context, operation)?;
        select {
            recv(self.closed) as _ => Err(
                error(io::ErrorKind::BrokenPipe, operation, "TLS stream is closed"),
            ),
            recv(context.done()) as _ => {
                check_context(context, operation)?;
                Err(error(io::ErrorKind::Interrupted, operation, "operation cancelled"))
            },
            recv(gate) as _ => if self.is_closed() {
                gate.send(());
                Err(error(io::ErrorKind::BrokenPipe, operation, "TLS stream is closed"))
            } else {
                Ok(())
            },
        }
    }

    fn handshake_complete(self: TlsStream) -> bool {
        select {
            recv(self.handshake_done) as _ => true,
            default => false,
        }
    }

    pub fn handshake(self: TlsStream) -> Result[(), io::Error] {
        self.handshake_with(context::Context::background())
    }

    pub fn handshake_with(self: TlsStream, context: context::Context) -> Result[(), io::Error] {
        check_context(context, "TLS handshake")?;
        if self.is_closed() {
            return Err(error(io::ErrorKind::BrokenPipe, "TLS handshake", "TLS stream is closed"))
        }
        if self.handshake_complete() {
            return Ok(())
        }
        self.acquire(self.handshake_gate, context, "TLS handshake")?;
        defer self.handshake_gate.send(());
        if self.handshake_complete() {
            return Ok(())
        }
        let timeout = match context.remaining() {
            Some(remaining) if remaining.compare(self.handshake_timeout) < 0 => remaining,
            _ => self.handshake_timeout,
        };
        let (ok, _, kind, message) = __goml_std_net_tls_handshake(
            self.id,
            cancellation_id(context),
            timeout.as_nanoseconds(),
        );
        if !ok {
            let closed = self.is_closed();
            let _ = self.abort();
            check_context(context, "TLS handshake")?;
            if closed {
                return Err(
                    error(io::ErrorKind::BrokenPipe, "TLS handshake", "TLS stream is closed"),
                )
            }
            return Err(runtime_error(kind, "TLS handshake", message))
        }
        if let Err(failure) = check_context(context, "TLS handshake") {
            let _ = self.abort();
            return Err(failure)
        }
        self.handshake_done.close();
        Ok(())
    }

    fn address(self: TlsStream, peer: bool) -> Result[net::SocketAddr, io::Error] {
        if self.is_closed() {
            return Err(error(io::ErrorKind::BrokenPipe, "TLS address", "TLS stream is closed"))
        }
        let address = __goml_std_net_tls_address(self.id, peer);
        if address.byte_len() == 0 {
            return Err(error(io::ErrorKind::BrokenPipe, "TLS address", "TLS stream is closed"))
        }
        net::SocketAddr::parse(address)
    }

    pub fn local_addr(self: TlsStream) -> Result[net::SocketAddr, io::Error] {
        self.address(false)
    }

    pub fn peer_addr(self: TlsStream) -> Result[net::SocketAddr, io::Error] {
        self.address(true)
    }

    pub fn close(self: TlsStream) -> Result[(), io::Error] {
        self.finish_close(false)
    }

    pub fn abort(self: TlsStream) -> Result[(), io::Error] {
        self.finish_close(true)
    }

    fn finish_close(self: TlsStream, abort: bool) -> Result[(), io::Error] {
        let mut message = if abort {
            __goml_std_net_tls_abort(self.id)
        } else {
            ""
        };
        let _ = self.close_gate.recv();
        defer self.close_gate.send(());
        if !self.is_closed() {
            self.closed.close();
            if !abort {
                message = __goml_std_net_tls_close(self.id);
            }
        }
        if message == "" {
            Ok(())
        } else {
            Err(error(io::ErrorKind::Other, "TLS close", message))
        }
    }

    pub fn is_closed(self: TlsStream) -> bool {
        select {
            recv(self.closed) as _ => true,
            default => false,
        }
    }

    pub fn connection_info(self: TlsStream) -> Result[ConnectionInfo, io::Error] {
        if self.is_closed() {
            return Err(error(io::ErrorKind::BrokenPipe, "TLS state", "TLS stream is closed"))
        }
        if !self.handshake_complete() {
            return Err(
                error(io::ErrorKind::InvalidInput, "TLS state", "TLS handshake has not completed"),
            )
        }
        let (ok, version, negotiated_protocol) = __goml_std_net_tls_state(self.id);
        if !ok {
            return Err(error(io::ErrorKind::BrokenPipe, "TLS state", "TLS stream is closed"))
        }
        Ok(
            ConnectionInfo {
                version: if version == 772 {
                    Tls13
                } else {
                    Tls12
                },
                negotiated_protocol,
            },
        )
    }

    fn read_locked(self: TlsStream, buffer: MutSlice[byte], context: context::Context) -> Result[
        isize,
        io::Error,
    ] {
        check_context(context, "TLS read")?;
        if buffer.len() == 0 {
            return Ok(0)
        }
        let (count, kind, message) = __goml_std_net_tls_read(
            self.id,
            buffer,
            cancellation_id(context),
            operation_timeout(context),
        );
        if message != "" {
            let _ = self.close();
            if count == 0 {
                check_context(context, "TLS read")?;
                return Err(runtime_error(kind, "TLS read", message))
            }
        }
        Ok(count)
    }

    fn write_locked(self: TlsStream, buffer: Slice[byte], context: context::Context) -> Result[
        isize,
        io::Error,
    ] {
        check_context(context, "TLS write")?;
        if buffer.len() == 0 {
            return Ok(0)
        }
        let (count, kind, message) = __goml_std_net_tls_write(
            self.id,
            buffer,
            cancellation_id(context),
            operation_timeout(context),
        );
        if message != "" {
            let _ = self.close();
            if count == 0 {
                check_context(context, "TLS write")?;
                return Err(runtime_error(kind, "TLS write", message))
            }
        }
        Ok(count)
    }

    pub fn read_with(self: TlsStream, buffer: MutSlice[byte], context: context::Context) -> Result[
        isize,
        io::Error,
    ] {
        self.handshake_with(context)?;
        self.acquire(self.read_gate, context, "TLS read")?;
        defer self.read_gate.send(());
        self.read_locked(buffer, context)
    }

    pub fn write_with(self: TlsStream, buffer: Slice[byte], context: context::Context) -> Result[
        isize,
        io::Error,
    ] {
        self.handshake_with(context)?;
        self.acquire(self.write_gate, context, "TLS write")?;
        defer self.write_gate.send(());
        self.write_locked(buffer, context)
    }

    pub fn read_exact_with(self: TlsStream, buffer: MutSlice[byte], context: context::Context) -> Result[
        (),
        io::Error,
    ] {
        self.handshake_with(context)?;
        self.acquire(self.read_gate, context, "TLS read exact")?;
        defer self.read_gate.send(());
        let mut offset = 0;
        while offset < buffer.len() {
            let count = self.read_locked(buffer.sub(offset, buffer.len()), context)?;
            if count == 0 {
                return Err(
                    error(UnexpectedEof, "TLS read exact", "stream ended before filling the buffer"),
                )
            }
            offset += count;
        }
        Ok(())
    }

    pub fn write_all_with(self: TlsStream, buffer: Slice[byte], context: context::Context) -> Result[
        (),
        io::Error,
    ] {
        self.handshake_with(context)?;
        self.acquire(self.write_gate, context, "TLS write all")?;
        defer self.write_gate.send(());
        let mut offset = 0;
        while offset < buffer.len() {
            let count = self.write_locked(buffer.sub(offset, buffer.len()), context)?;
            if count == 0 {
                return Err(
                    error(io::ErrorKind::WriteZero, "TLS write all", "stream made no progress"),
                )
            }
            offset += count;
        }
        Ok(())
    }
}

impl io::Read for TlsStream {
    fn read(self: TlsStream, buffer: MutSlice[byte]) -> Result[isize, io::Error] {
        self.read_with(buffer, context::Context::background())
    }
}

impl io::Write for TlsStream {
    fn write(self: TlsStream, buffer: Slice[byte]) -> Result[isize, io::Error] {
        self.write_with(buffer, context::Context::background())
    }
}

impl io::Close for TlsStream {
    fn close(self: TlsStream) -> Result[(), io::Error] {
        self.close()
    }
}
