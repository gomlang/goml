package net;

use module::context;
use module::io::{Error, ErrorKind};

pub fn resolve(host: string, port: u16) -> Result[Vec[SocketAddr], Error] {
    resolve_with(host, port, context::Context::background())
}

pub fn resolve_with(host: string, port: u16, context: context::Context) -> Result[
    Vec[SocketAddr],
    Error,
] {
    context.check().map_err(|value| context_error("resolve", value))?;
    if host.byte_len() == 0 || host.to_bytes().contains(0) {
        return Result::Err(error(ErrorKind::InvalidInput, "resolve", "invalid host name"))
    }
    if let Ok(ip) = IpAddr::parse(host) {
        return Result::Ok(Vec::from_array([SocketAddr::new(ip, port)]))
    }
    let cancel_id = context.token().map(|token| token.runtime_id()).unwrap_or(0);
    let timeout = context.remaining().map(|duration| duration.as_nanoseconds()).unwrap_or(
        30000000000,
    );
    let (ok, addresses, kind, message) = __goml_std_net_resolve(host, cancel_id, timeout);
    context.check().map_err(|value| context_error("resolve", value))?;
    if !ok {
        return Result::Err(
            error(
                match kind {
                    2 => ErrorKind::Interrupted,
                    3 => ErrorKind::TimedOut,
                    _ => ErrorKind::Other,
                },
                "resolve",
                message,
            ),
        )
    }
    let result: Vec[SocketAddr] = Vec::new();
    for address in addresses {
        let value = SocketAddr::new(IpAddr::parse(address)?, port);
        if !result.contains(value) {
            result.push(value)
        }
    }
    if result.is_empty() {
        Result::Err(error(ErrorKind::NotFound, "resolve", "host has no addresses"))
    } else {
        Result::Ok(result)
    }
}

fn context_error(operation: string, value: context::Error) -> Error {
    error(
        match value {
            Cancelled => ErrorKind::Interrupted,
            DeadlineExceeded => ErrorKind::TimedOut,
        },
        operation,
        value.to_string(),
    )
}

impl TcpStream {
    pub fn connect_host(host: string, port: u16, context: context::Context) -> Result[
        TcpStream,
        Error,
    ] {
        let addresses = resolve_with(host, port, context)?;
        let mut last = error(ErrorKind::NotFound, "connect", "host has no reachable addresses");
        for address in addresses {
            context.check().map_err(|value| context_error("connect", value))?;
            match TcpStream::connect_with(address, WaitOptions::new().with_context(context)) {
                Ok(stream) => return Result::Ok(stream),
                Err(error) => {
                    last = error;
                },
            }
        }
        Result::Err(last)
    }
}
