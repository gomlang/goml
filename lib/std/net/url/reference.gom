package url;

use module::bytes;

pub enum ParseErrorKind {
    InvalidHost,
    InvalidPort,
    PortOutOfRange,
    InvalidUserInfo,
    InvalidZone,
    InvalidIpLiteral,
    InvalidLimit,
    InputLimit,
    OutputLimit,
    RelativeBase,
    ControlCharacter,
    InvalidScheme,
    InvalidEscape,
}

impl PartialEq for ParseErrorKind {
    fn eq(self: ParseErrorKind, other: ParseErrorKind) -> bool {
        match (self, other) {
            (ParseErrorKind::InvalidHost, ParseErrorKind::InvalidHost) => true,
            (ParseErrorKind::InvalidPort, ParseErrorKind::InvalidPort) => true,
            (ParseErrorKind::PortOutOfRange, ParseErrorKind::PortOutOfRange) => true,
            (ParseErrorKind::InvalidUserInfo, ParseErrorKind::InvalidUserInfo) => true,
            (ParseErrorKind::InvalidZone, ParseErrorKind::InvalidZone) => true,
            (ParseErrorKind::InvalidIpLiteral, ParseErrorKind::InvalidIpLiteral) => true,
            (ParseErrorKind::InvalidLimit, ParseErrorKind::InvalidLimit) => true,
            (ParseErrorKind::InputLimit, ParseErrorKind::InputLimit) => true,
            (ParseErrorKind::OutputLimit, ParseErrorKind::OutputLimit) => true,
            (ParseErrorKind::RelativeBase, ParseErrorKind::RelativeBase) => true,
            (ParseErrorKind::ControlCharacter, ParseErrorKind::ControlCharacter) => true,
            (ParseErrorKind::InvalidScheme, ParseErrorKind::InvalidScheme) => true,
            (ParseErrorKind::InvalidEscape, ParseErrorKind::InvalidEscape) => true,
            _ => false,
        }
    }
}

impl Eq for ParseErrorKind {}

impl ToString for ParseErrorKind {
    fn to_string(self: ParseErrorKind) -> string {
        match self {
            ParseErrorKind::InvalidHost => "invalid URL host",
            ParseErrorKind::InvalidPort => "invalid URL port",
            ParseErrorKind::PortOutOfRange => "URL port exceeds 65535",
            ParseErrorKind::InvalidUserInfo => "invalid URL user information",
            ParseErrorKind::InvalidZone => "invalid URL zone identifier",
            ParseErrorKind::InvalidIpLiteral => "invalid URL IP literal",
            ParseErrorKind::InvalidLimit => "negative URL reference limit",
            ParseErrorKind::InputLimit => "URL reference input exceeds byte limit",
            ParseErrorKind::OutputLimit => "URL reference output exceeds byte limit",
            ParseErrorKind::RelativeBase => "relative reference requires an absolute base",
            ParseErrorKind::ControlCharacter => "control character in URL reference",
            ParseErrorKind::InvalidScheme => "invalid URL scheme",
            ParseErrorKind::InvalidEscape => "invalid URL percent escape",
        }
    }
}

impl Debug for ParseErrorKind {
    fn debug(self: ParseErrorKind) -> string {
        self.to_string()
    }
}

pub struct ParseError {
    kind_value: ParseErrorKind,
    index_value: isize,
}

impl ParseError {
    pub fn kind(self: ParseError) -> ParseErrorKind {
        self.kind_value
    }

    pub fn index(self: ParseError) -> isize {
        self.index_value
    }
}

impl ToString for ParseError {
    fn to_string(self: ParseError) -> string {
        f"{self.kind_value} at byte {self.index_value}"
    }
}

impl Debug for ParseError {
    fn debug(self: ParseError) -> string {
        self.to_string()
    }
}

fn parse_error(kind: ParseErrorKind, index: isize) -> ParseError {
    ParseError { kind_value: kind, index_value: index }
}

fn validate_percent(input: Slice[byte], start: isize, end: isize) -> Result[(), ParseError] {
    let mut index = start;
    while index < end {
        if input[index] == b'%' {
            if end - index < 3 || hex_value(input[index + 1]) < 0 || hex_value(input[index + 2]) < 0 {
                return Result::Err(parse_error(ParseErrorKind::InvalidEscape, index))
            }
            index += 3;
        } else {
            index += 1;
        }
    }
    Result::Ok(())
}

fn scheme_letter(value: byte) -> bool {
    value >= b'a' && value <= b'z' || value >= b'A' && value <= b'Z'
}

enum WirePart {
    Literal,
    Authority,
    Path,
    QueryOrFragment,
}

fn wire_safe(value: byte, mode: WirePart) -> bool {
    match mode {
        WirePart::Literal => true,
        WirePart::Authority => unreserved(value) || sub_delimiter(value) || value == b':'
            || value == b'@'
            || value == b'['
            || value == b']',
        WirePart::Path => unreserved(value) || sub_delimiter(value) || value == b':'
            || value == b'@'
            || value == b'/',
        WirePart::QueryOrFragment => unreserved(value) || sub_delimiter(value) || value == b':'
            || value == b'@'
            || value == b'/'
            || value == b'?',
    }
}

pub struct Reference {
    scheme_value: Option[string],
    authority_value: Option[string],
    path_value: string,
    query_value: Option[string],
    fragment_value: Option[string],
}

impl Reference {
    pub fn to_ascii(self: Reference, max_output_bytes: isize) -> Result[string, ParseError] {
        if max_output_bytes < 0 {
            return Result::Err(parse_error(ParseErrorKind::InvalidLimit, 0))
        }
        let _ = self.authority()?;
        let parts: Vec[(string, WirePart)] = Vec::new();
        if let Some(scheme) = self.scheme_value {
            parts.push((scheme, WirePart::Literal));
            parts.push((":", WirePart::Literal));
        }
        if let Some(authority) = self.authority_value {
            parts.push(("//", WirePart::Literal));
            parts.push((authority, WirePart::Authority));
        }
        parts.push((self.path_value, WirePart::Path));
        if let Some(query) = self.query_value {
            parts.push(("?", WirePart::Literal));
            parts.push((query, WirePart::QueryOrFragment));
        }
        if let Some(fragment) = self.fragment_value {
            parts.push(("#", WirePart::Literal));
            parts.push((fragment, WirePart::QueryOrFragment));
        }
        let mut length = 0;
        let mut source_offset = 0;
        for (text, mode) in parts {
            let data = text.to_bytes();
            let mut index = 0;
            while index < data.len() {
                let value = data[index];
                let escaped = value == b'%';
                if escaped
                    && (data.len() - index < 3 || hex_value(data[index + 1]) < 0
                        || hex_value(data[index + 2]) < 0) {
                    return Result::Err(
                        parse_error(ParseErrorKind::InvalidEscape, source_offset + index),
                    )
                }
                let size = if escaped || !wire_safe(value, mode) {
                    3
                } else {
                    1
                };
                if size > max_output_bytes - length {
                    return Result::Err(parse_error(ParseErrorKind::OutputLimit, max_output_bytes))
                }
                length += size;
                index += if escaped {
                    3
                } else {
                    1
                };
            }
            source_offset += data.len();
        }
        let output: Vec[byte] = Vec::new();
        let hex = b"0123456789ABCDEF";
        for (text, mode) in parts {
            let data = text.to_bytes();
            let mut index = 0;
            while index < data.len() {
                let value = data[index];
                if value == b'%' {
                    output.push(b'%');
                    output.push(hex[hex_value(data[index + 1])]);
                    output.push(hex[hex_value(data[index + 2])]);
                    index += 3;
                } else {
                    if wire_safe(value, mode) {
                        output.push(value);
                    } else {
                        output.push(b'%');
                        output.push(hex[(value / 16).to_isize()]);
                        output.push(hex[(value % 16).to_isize()]);
                    }
                    index += 1;
                }
            }
        }
        Result::Ok(string_from_utf8(output).1)
    }

    pub fn resolve(self: Reference, reference: Reference, max_output_bytes: isize) -> Result[
        Reference,
        ParseError,
    ] {
        if max_output_bytes < 0 {
            return Result::Err(parse_error(ParseErrorKind::InvalidLimit, 0))
        }
        if self.scheme_value.is_none() && reference.scheme_value.is_none() {
            return Result::Err(parse_error(ParseErrorKind::RelativeBase, 0))
        }
        let mut scheme = self.scheme_value;
        let mut authority = self.authority_value;
        let mut path = self.path_value;
        let mut query = reference.query_value;
        if reference.scheme_value.is_some() {
            scheme = reference.scheme_value;
            authority = reference.authority_value;
            path = remove_dot_segments(reference.path_value);
        } else if reference.authority_value.is_some() {
            authority = reference.authority_value;
            path = remove_dot_segments(reference.path_value);
        } else if reference.path_value == "" {
            if query.is_none() {
                query = self.query_value;
            }
        } else if reference.path_value.starts_with("/") {
            path = remove_dot_segments(reference.path_value);
        } else {
            let prefix = if authority.is_some() && self.path_value == "" {
                "/"
            } else {
                let bytes = self.path_value.to_bytes();
                let mut end = 0;
                for index in 0..bytes.len() {
                    if bytes[index] == b'/' {
                        end = index + 1;
                    }
                }
                self.path_value.byte_slice(0, end)
            };
            if reference.path_value.byte_len() > 9223372036854775807 - prefix.byte_len() {
                return Result::Err(parse_error(ParseErrorKind::OutputLimit, max_output_bytes))
            }
            path = remove_dot_segments(prefix + reference.path_value);
        }
        if authority.is_none() && path.starts_with("//") {
            if path.byte_len() > 9223372036854775805 {
                return Result::Err(parse_error(ParseErrorKind::OutputLimit, max_output_bytes))
            }
            path = "/." + path;
        }
        let result = Reference {
            scheme_value: scheme,
            authority_value: authority,
            path_value: path,
            query_value: query,
            fragment_value: reference.fragment_value,
        };
        let mut length = 0;
        for piece in result.pieces() {
            if piece.byte_len() > max_output_bytes - length {
                return Result::Err(parse_error(ParseErrorKind::OutputLimit, max_output_bytes))
            }
            length += piece.byte_len();
        }
        Result::Ok(result)
    }

    fn pieces(self: Reference) -> Vec[string] {
        let output: Vec[string] = Vec::new();
        if let Some(scheme) = self.scheme_value {
            output.push(scheme);
            output.push(":");
        }
        if let Some(authority) = self.authority_value {
            output.push("//");
            output.push(authority);
        }
        output.push(self.path_value);
        if let Some(query) = self.query_value {
            output.push("?");
            output.push(query);
        }
        if let Some(fragment) = self.fragment_value {
            output.push("#");
            output.push(fragment);
        }
        output
    }

    pub fn parse(input: string, max_input_bytes: isize) -> Result[Reference, ParseError] {
        if max_input_bytes < 0 {
            return Result::Err(parse_error(ParseErrorKind::InvalidLimit, 0))
        }
        if input.byte_len() > max_input_bytes {
            return Result::Err(parse_error(ParseErrorKind::InputLimit, max_input_bytes))
        }
        let data = input.to_bytes();
        for index in 0..data.len() {
            if data[index] < 32 || data[index] == 127 {
                return Result::Err(parse_error(ParseErrorKind::ControlCharacter, index))
            }
        }
        let mut fragment_start = data.len();
        let mut query_start = data.len();
        for index in 0..data.len() {
            if data[index] == b'#' {
                fragment_start = index;
                break
            }
            if data[index] == b'?' && query_start == data.len() {
                query_start = index;
            }
        }
        let end = if query_start < fragment_start {
            query_start
        } else {
            fragment_start
        };
        let mut start = 0;
        let mut scheme: Option[string] = Option::None;
        for index in 0..end {
            if data[index] == b'/' {
                break
            }
            if data[index] == b':' {
                if index == 0 {
                    return Result::Err(parse_error(ParseErrorKind::InvalidScheme, 0))
                }
                for position in 0..index {
                    let value = data[position];
                    if !scheme_letter(value)
                        && (position == 0
                            || !(value >= b'0' && value <= b'9' || value == b'+' || value == b'-'
                                || value == b'.')) {
                        return Result::Err(parse_error(ParseErrorKind::InvalidScheme, position))
                    }
                }
                scheme = Option::Some(input.byte_slice(0, index));
                start = index + 1;
                break
            }
        }
        let mut authority: Option[string] = Option::None;
        if end - start >= 2 && data[start] == b'/' && data[start + 1] == b'/' {
            let authority_start = start + 2;
            start = authority_start;
            while start < end && data[start] != b'/' {
                start += 1;
            }
            authority = Option::Some(input.byte_slice(authority_start, start));
        }
        validate_percent(data.as_slice(), start, end)?;
        let query = if query_start < fragment_start {
            Option::Some(input.byte_slice(query_start + 1, fragment_start))
        } else {
            Option::None
        };
        let fragment = if fragment_start < data.len() {
            validate_percent(data.as_slice(), fragment_start + 1, data.len())?;
            Option::Some(input.byte_slice(fragment_start + 1, data.len()))
        } else {
            Option::None
        };
        Result::Ok(
            Reference {
                scheme_value: scheme,
                authority_value: authority,
                path_value: input.byte_slice(start, end),
                query_value: query,
                fragment_value: fragment,
            },
        )
    }

    pub fn scheme(self: Reference) -> Option[string] {
        self.scheme_value
    }

    pub fn raw_authority(self: Reference) -> Option[string] {
        self.authority_value
    }

    pub fn raw_path(self: Reference) -> string {
        self.path_value
    }

    pub fn raw_query(self: Reference) -> Option[string] {
        self.query_value
    }

    pub fn raw_fragment(self: Reference) -> Option[string] {
        self.fragment_value
    }

    pub fn is_absolute(self: Reference) -> bool {
        self.scheme_value.is_some()
    }

    pub fn decoded_path(self: Reference, limit: isize) -> Result[bytes::Bytes, CodecError] {
        path_unescape(self.path_value, limit)
    }

    pub fn decoded_fragment(self: Reference, limit: isize) -> Result[
        Option[bytes::Bytes],
        CodecError,
    ] {
        match self.fragment_value {
            Some(value) => Result::Ok(Option::Some(path_unescape(value, limit)?)),
            None => if limit < 0 {
                Result::Err(codec_error(CodecErrorKind::InvalidLimit, 0))
            } else {
                Result::Ok(Option::None)
            },
        }
    }
}

impl ToString for Reference {
    fn to_string(self: Reference) -> string {
        self.pieces().join("")
    }
}

impl PartialEq for Reference {
    fn eq(self: Reference, other: Reference) -> bool {
        self.scheme_value == other.scheme_value && self.authority_value == other.authority_value
            && self.path_value == other.path_value
            && self.query_value == other.query_value
            && self.fragment_value == other.fragment_value
    }
}

impl Eq for Reference {}

fn discard_last_segment(output: Vec[byte]) -> () {
    while !output.is_empty() {
        if output.pop().unwrap_or(0) == b'/' {
            break
        }
    }
}

fn remove_dot_segments(path: string) -> string {
    let input = path.to_bytes();
    let output: Vec[byte] = Vec::new();
    let mut offset = 0;
    while offset < input.len() {
        let remaining = input.len() - offset;
        if path.starts_with_at(offset, "../") {
            offset += 3;
        } else if path.starts_with_at(offset, "./") {
            offset += 2;
        } else if path.starts_with_at(offset, "/./") {
            offset += 2;
        } else if remaining == 2 && path.starts_with_at(offset, "/.") {
            output.push(b'/');
            break
        } else if path.starts_with_at(offset, "/../") {
            offset += 3;
            discard_last_segment(output);
        } else if remaining == 3 && path.starts_with_at(offset, "/..") {
            discard_last_segment(output);
            output.push(b'/');
            break
        } else if remaining == 1 && input[offset] == b'.'
            || remaining == 2 && path.starts_with_at(offset, "..") {
            break
        } else {
            if input[offset] == b'/' {
                output.push(b'/');
                offset += 1;
            }
            while offset < input.len() && input[offset] != b'/' {
                output.push(input[offset]);
                offset += 1;
            }
        }
    }
    string_from_utf8(output).1
}
