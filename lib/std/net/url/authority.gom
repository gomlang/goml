package url;

use module::bytes;

pub enum HostKind {
    Name,
    Ipv4,
    Ipv6,
    IpvFuture,
}

impl PartialEq for HostKind {
    fn eq(self: HostKind, other: HostKind) -> bool {
        match (self, other) {
            (HostKind::Name, HostKind::Name) => true,
            (HostKind::Ipv4, HostKind::Ipv4) => true,
            (HostKind::Ipv6, HostKind::Ipv6) => true,
            (HostKind::IpvFuture, HostKind::IpvFuture) => true,
            _ => false,
        }
    }
}

impl Eq for HostKind {}

impl Debug for HostKind {
    fn debug(self: HostKind) -> string {
        match self {
            HostKind::Name => "Name",
            HostKind::Ipv4 => "Ipv4",
            HostKind::Ipv6 => "Ipv6",
            HostKind::IpvFuture => "IpvFuture",
        }
    }
}

fn unreserved(value: byte) -> bool {
    scheme_letter(value) || value >= b'0' && value <= b'9' || value == b'-' || value == b'.'
        || value == b'_'
        || value == b'~'
}

fn sub_delimiter(value: byte) -> bool {
    value == b'!' || value == b'$' || value == b'&' || value == b'\'' || value == b'('
        || value == b')'
        || value == b'*'
        || value == b'+'
        || value == b','
        || value == b';'
        || value == b'='
}

fn valid_v4_host(input: string) -> bool {
    let parts = input.split(".");
    if parts.len() != 4 {
        return false
    }
    for part in parts {
        if part.byte_len() == 0 || part.byte_len() > 3
            || part.byte_len() > 1 && part.starts_with("0") {
            return false
        }
        let mut value = 0;
        for digit in part.to_bytes() {
            if digit < b'0' || digit > b'9' {
                return false
            }
            value = value * 10 + (digit - b'0').to_isize();
        }
        if value > 255 {
            return false
        }
    }
    true
}

fn ipv6_group_count(input: string, allow_v4: bool) -> Option[isize] {
    if input == "" {
        return Option::Some(0)
    }
    let parts = input.split(":");
    let mut count = 0;
    for index in 0..parts.len() {
        let part = parts[index];
        if part.contains(".") {
            if !allow_v4 || index != parts.len() - 1 || !valid_v4_host(part) {
                return Option::None
            }
            count += 2;
        } else {
            if part.byte_len() == 0 || part.byte_len() > 4 {
                return Option::None
            }
            for digit in part.to_bytes() {
                if hex_value(digit) < 0 {
                    return Option::None
                }
            }
            count += 1;
        }
        if count > 8 {
            return Option::None
        }
    }
    Option::Some(count)
}

fn valid_v6_host(input: string) -> bool {
    if input.byte_len() < 2 || input.byte_len() > 45 {
        return false
    }
    match input.split_once("::") {
        Some((left, right)) => match (ipv6_group_count(left, false), ipv6_group_count(right, true)) {
            (Some(a), Some(b)) => a + b < 8,
            _ => false,
        },
        None => ipv6_group_count(input, true) == Option::Some(8),
    }
}

fn valid_future_host(input: string) -> bool {
    let data = input.to_bytes();
    if data.len() < 4 || data[0] != b'v' && data[0] != b'V' {
        return false
    }
    let mut index = 1;
    while index < data.len() && hex_value(data[index]) >= 0 {
        index += 1;
    }
    if index == 1 || index >= data.len() || data[index] != b'.' {
        return false
    }
    index += 1;
    if index == data.len() {
        return false
    }
    while index < data.len() {
        let value = data[index];
        if !unreserved(value) && !sub_delimiter(value) && value != b':' {
            return false
        }
        index += 1;
    }
    true
}

pub struct UserInfo {
    username_value: string,
    password_value: Option[string],
}

impl UserInfo {
    pub fn raw_username(self: UserInfo) -> string {
        self.username_value
    }

    pub fn raw_password(self: UserInfo) -> Option[string] {
        self.password_value
    }

    pub fn has_password(self: UserInfo) -> bool {
        self.password_value.is_some()
    }

    pub fn username(self: UserInfo, limit: isize) -> Result[bytes::Bytes, CodecError] {
        path_unescape(self.username_value, limit)
    }

    pub fn password(self: UserInfo, limit: isize) -> Result[Option[bytes::Bytes], CodecError] {
        optional_component(self.password_value, limit)
    }
}

fn optional_component(value: Option[string], limit: isize) -> Result[
    Option[bytes::Bytes],
    CodecError,
] {
    if limit < 0 {
        return Result::Err(codec_error(CodecErrorKind::InvalidLimit, 0))
    }
    match value {
        Some(value) => Result::Ok(Option::Some(path_unescape(value, limit)?)),
        None => Result::Ok(Option::None),
    }
}

impl ToString for UserInfo {
    fn to_string(self: UserInfo) -> string {
        match self.password_value {
            Some(value) => self.username_value + ":" + value,
            None => self.username_value,
        }
    }
}

impl PartialEq for UserInfo {
    fn eq(self: UserInfo, other: UserInfo) -> bool {
        self.username_value == other.username_value && self.password_value == other.password_value
    }
}

impl Eq for UserInfo {}

pub struct Authority {
    raw_value: string,
    user_value: Option[UserInfo],
    host_value: string,
    kind_value: HostKind,
    port_value: Option[string],
    port_index: isize,
    zone_value: Option[string],
}

impl Authority {
    pub fn parse(input: string, max_input_bytes: isize) -> Result[Authority, ParseError] {
        if max_input_bytes < 0 {
            return Result::Err(parse_error(ParseErrorKind::InvalidLimit, 0))
        }
        if input.byte_len() > max_input_bytes {
            return Result::Err(parse_error(ParseErrorKind::InputLimit, max_input_bytes))
        }
        let data = input.to_bytes();
        let mut host_start = 0;
        let mut user: Option[UserInfo] = Option::None;
        for index in 0..data.len() {
            if data[index] == b'@' {
                if host_start != 0 {
                    return Result::Err(parse_error(ParseErrorKind::InvalidUserInfo, index))
                }
                host_start = index + 1;
            }
        }
        if host_start > 0 {
            let end = host_start - 1;
            validate_percent(data.as_slice(), 0, end)?;
            let mut separator = end;
            let mut index = 0;
            while index < end {
                let value = data[index];
                if value == b'%' {
                    index += 3;
                    continue
                }
                if value == b':' && separator == end {
                    separator = index;
                }
                if !unreserved(value) && !sub_delimiter(value) && value != b':' {
                    return Result::Err(parse_error(ParseErrorKind::InvalidUserInfo, index))
                }
                index += 1;
            }
            user = Option::Some(
                UserInfo {
                    username_value: input.byte_slice(0, separator),
                    password_value: if separator < end {
                        Option::Some(input.byte_slice(separator + 1, end))
                    } else {
                        Option::None
                    },
                },
            );
        }
        let mut host_end = data.len();
        let mut port_index = data.len();
        let mut kind = HostKind::Name;
        let mut zone: Option[string] = Option::None;
        if host_start < data.len() && data[host_start] == b'[' {
            let mut close = host_start + 1;
            while close < data.len() && data[close] != b']' {
                close += 1;
            }
            if close == data.len() {
                return Result::Err(parse_error(ParseErrorKind::InvalidIpLiteral, host_start))
            }
            host_end = close + 1;
            if host_end < data.len() {
                if data[host_end] != b':' {
                    return Result::Err(parse_error(ParseErrorKind::InvalidPort, host_end))
                }
                port_index = host_end + 1;
            }
            let literal = input.byte_slice(host_start + 1, close);
            if literal.starts_with("v") || literal.starts_with("V") {
                if !valid_future_host(literal) {
                    return Result::Err(
                        parse_error(ParseErrorKind::InvalidIpLiteral, host_start + 1),
                    )
                }
                kind = HostKind::IpvFuture;
            } else {
                let mut address_end = close;
                for index in host_start + 1..close {
                    if data[index] == b'%' {
                        address_end = index;
                        break
                    }
                }
                if !valid_v6_host(input.byte_slice(host_start + 1, address_end)) {
                    return Result::Err(
                        parse_error(ParseErrorKind::InvalidIpLiteral, host_start + 1),
                    )
                }
                if address_end < close {
                    if close - address_end < 4 || !input.starts_with_at(address_end, "%25") {
                        return Result::Err(parse_error(ParseErrorKind::InvalidZone, address_end))
                    }
                    let start = address_end + 3;
                    validate_percent(data.as_slice(), start, close)?;
                    let mut index = start;
                    while index < close {
                        let value = data[index];
                        if value == b'%' {
                            let decoded = hex_value(data[index + 1]) * 16
                                + hex_value(data[index + 2]);
                            if decoded < 32 || decoded == 127 {
                                return Result::Err(parse_error(ParseErrorKind::InvalidZone, index))
                            }
                            index += 3;
                        } else {
                            if !unreserved(value) && value < 128 {
                                return Result::Err(parse_error(ParseErrorKind::InvalidZone, index))
                            }
                            index += 1;
                        }
                    }
                    zone = Option::Some(input.byte_slice(start, close));
                }
                kind = HostKind::Ipv6;
            }
        } else {
            for index in host_start..data.len() {
                if data[index] == b':' {
                    host_end = index;
                    port_index = index + 1;
                    break
                }
            }
            validate_percent(data.as_slice(), host_start, host_end)?;
            let mut index = host_start;
            while index < host_end {
                let value = data[index];
                if value == b'%' {
                    index += 3;
                    continue
                }
                if !unreserved(value) && !sub_delimiter(value) && value < 128 {
                    return Result::Err(parse_error(ParseErrorKind::InvalidHost, index))
                }
                index += 1;
            }
            if valid_v4_host(input.byte_slice(host_start, host_end)) {
                kind = HostKind::Ipv4;
            }
        }
        let port = if host_end < data.len() {
            for index in port_index..data.len() {
                if data[index] < b'0' || data[index] > b'9' {
                    return Result::Err(parse_error(ParseErrorKind::InvalidPort, index))
                }
            }
            Option::Some(input.byte_slice(port_index, data.len()))
        } else {
            Option::None
        };
        Result::Ok(
            Authority {
                raw_value: input,
                user_value: user,
                host_value: input.byte_slice(host_start, host_end),
                kind_value: kind,
                port_value: port,
                port_index,
                zone_value: zone,
            },
        )
    }

    pub fn userinfo(self: Authority) -> Option[UserInfo] {
        self.user_value
    }

    pub fn raw_host(self: Authority) -> string {
        self.host_value
    }

    pub fn host_kind(self: Authority) -> HostKind {
        self.kind_value
    }

    pub fn raw_port(self: Authority) -> Option[string] {
        self.port_value
    }

    pub fn raw_zone(self: Authority) -> Option[string] {
        self.zone_value
    }

    pub fn hostname(self: Authority, limit: isize) -> Result[bytes::Bytes, CodecError] {
        let raw = if self.kind_value == HostKind::Ipv6 || self.kind_value == HostKind::IpvFuture {
            self.host_value.byte_slice(1, self.host_value.byte_len() - 1)
        } else {
            self.host_value
        };
        path_unescape(raw, limit)
    }

    pub fn zone(self: Authority, limit: isize) -> Result[Option[bytes::Bytes], CodecError] {
        optional_component(self.zone_value, limit)
    }

    pub fn port_number(self: Authority) -> Result[Option[u16], ParseError] {
        match self.port_value {
            None => Result::Ok(Option::None),
            Some("") => Result::Ok(Option::None),
            Some(value) => {
                let mut result = 0;
                let data = value.to_bytes();
                for index in 0..data.len() {
                    let digit = (data[index] - b'0').to_isize();
                    if result > (65535 - digit) / 10 {
                        return Result::Err(
                            parse_error(ParseErrorKind::PortOutOfRange, self.port_index + index),
                        )
                    }
                    result = result * 10 + digit;
                }
                Result::Ok(Option::Some(result.to_u16()))
            },
        }
    }

    pub fn redacted(self: Authority, limit: isize) -> Result[string, ParseError] {
        if limit < 0 {
            return Result::Err(parse_error(ParseErrorKind::InvalidLimit, 0))
        }
        let pieces: Vec[string] = Vec::new();
        match self.user_value {
            Some(user) if user.has_password() => {
                pieces.push(user.raw_username());
                pieces.push(":xxxxx@");
                pieces.push(self.host_value);
                if let Some(port) = self.port_value {
                    pieces.push(":");
                    pieces.push(port);
                }
            },
            _ => pieces.push(self.raw_value),
        }
        bounded_join(pieces, limit)
    }
}

fn bounded_join(pieces: Vec[string], limit: isize) -> Result[string, ParseError] {
    if limit < 0 {
        return Result::Err(parse_error(ParseErrorKind::InvalidLimit, 0))
    }
    let mut length = 0;
    for piece in pieces {
        if piece.byte_len() > limit - length {
            return Result::Err(parse_error(ParseErrorKind::OutputLimit, limit))
        }
        length += piece.byte_len();
    }
    Result::Ok(pieces.join(""))
}

impl ToString for Authority {
    fn to_string(self: Authority) -> string {
        self.raw_value
    }
}

impl PartialEq for Authority {
    fn eq(self: Authority, other: Authority) -> bool {
        self.raw_value == other.raw_value
    }
}

impl Eq for Authority {}

impl Reference {
    pub fn authority(self: Reference) -> Result[Option[Authority], ParseError] {
        match self.raw_authority() {
            Some(value) => Result::Ok(Option::Some(Authority::parse(value, value.byte_len())?)),
            None => Result::Ok(Option::None),
        }
    }

    pub fn redacted(self: Reference, limit: isize) -> Result[string, ParseError] {
        if limit < 0 {
            return Result::Err(parse_error(ParseErrorKind::InvalidLimit, 0))
        }
        let authority = match self.authority()? {
            Some(value) => Option::Some(value.redacted(limit)?),
            None => Option::None,
        };
        let result = Reference {
            scheme_value: self.scheme_value,
            authority_value: authority,
            path_value: self.path_value,
            query_value: self.query_value,
            fragment_value: self.fragment_value,
        };
        bounded_join(result.pieces(), limit)
    }
}
