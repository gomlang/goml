package tests;

use std::bytes;
use std::encoding::hex;
use std::fs;
use std::testing;

static KNOWN_ANSWERS: OnceCell[HashMap[string, HashMap[string, Vec[string]]]] = OnceCell::new();

fn known_answer(key: string) -> Vec[string] {
    let tables = KNOWN_ANSWERS.get_or_init(|| HashMap::new());
    let operation = key.split(":")[0];
    let answers = tables.get_or_insert_with(
        operation,
        || {
            let content = testing::expect_ok(
                fs::read_file_structured("net/url/tests/known_answers/" + operation + ".tsv"),
                "read known answers",
            );
            let values: HashMap[string, Vec[string]] = HashMap::new();
            for line in content.split("\n") {
                if line.byte_len() > 0 {
                    let fields = line.split("\t");
                    let outputs = Vec::new();
                    for index in 1..fields.len() {
                        outputs.push(fields[index]);
                    }
                    testing::assert(!values.contains(fields[0]));
                    values.set(fields[0], outputs);
                }
            }
            values
        },
    );
    testing::expect_some(answers.get(key), "missing known answer: " + key)
}

fn answer_text(value: string) -> string {
    string_from_utf8(testing::expect_ok(hex::decode(value), "known answer hex").to_vec()).1
}

fn answer_bytes(value: Slice[byte]) -> string {
    hex::encode(bytes::Bytes::from_slice_copy(value))
}

fn expected_url_escape(input: Slice[byte], query: bool) -> string {
    let values = known_answer("URLEscape:" + answer_bytes(input) + ":" + query.to_string());
    answer_text(values[0])
}

fn expected_url_unescape(input: string, query: bool) -> (Vec[byte], bool) {
    let values = known_answer(
        "URLUnescape:" + answer_bytes(input.to_bytes().as_slice()) + ":" + query.to_string(),
    );
    (testing::expect_ok(hex::decode(values[0]), "expected bytes").to_vec(), values[1] == "true")
}

fn expected_query_canonical(input: string) -> (string, bool) {
    let values = known_answer("QueryCanonical:" + answer_bytes(input.to_bytes().as_slice()));
    (answer_text(values[0]), values[1] == "true")
}

fn expected_resolve_url(base: string, reference: string) -> (string, bool) {
    let values = known_answer(
        "ResolveURL:" + answer_bytes(base.to_bytes().as_slice()) + ":"
            + answer_bytes(reference.to_bytes().as_slice()),
    );
    (answer_text(values[0]), values[1] == "true")
}

fn expected_url_ipv6(input: string) -> bool {
    let values = known_answer("URLIPv6:" + answer_bytes(input.to_bytes().as_slice()));
    values[0] == "true"
}

fn expected_url_authority(input: string) -> (string, string, string, bool) {
    let values = known_answer("URLAuthority:" + answer_bytes(input.to_bytes().as_slice()));
    (answer_text(values[0]), answer_text(values[1]), answer_text(values[2]), values[3] == "true")
}
