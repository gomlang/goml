package url;

use module::bytes;

pub enum EscapeMode {
    PathSegment,
    QueryComponent,
}

pub enum CodecErrorKind {
    InvalidLimit,
    InputLimit,
    OutputLimit,
    InvalidEscape,
    FieldLimit,
    InvalidSeparator,
}

impl PartialEq for CodecErrorKind {
    fn eq(self: CodecErrorKind, other: CodecErrorKind) -> bool {
        match (self, other) {
            (CodecErrorKind::InvalidLimit, CodecErrorKind::InvalidLimit) => true,
            (CodecErrorKind::InputLimit, CodecErrorKind::InputLimit) => true,
            (CodecErrorKind::OutputLimit, CodecErrorKind::OutputLimit) => true,
            (CodecErrorKind::InvalidEscape, CodecErrorKind::InvalidEscape) => true,
            (CodecErrorKind::FieldLimit, CodecErrorKind::FieldLimit) => true,
            (CodecErrorKind::InvalidSeparator, CodecErrorKind::InvalidSeparator) => true,
            _ => false,
        }
    }
}

impl Eq for CodecErrorKind {}

impl ToString for CodecErrorKind {
    fn to_string(self: CodecErrorKind) -> string {
        match self {
            CodecErrorKind::InvalidLimit => "negative URL codec limit",
            CodecErrorKind::InputLimit => "URL codec input exceeds byte limit",
            CodecErrorKind::OutputLimit => "URL codec output exceeds byte limit",
            CodecErrorKind::InvalidEscape => "invalid percent escape",
            CodecErrorKind::FieldLimit => "query exceeds field limit",
            CodecErrorKind::InvalidSeparator => "unescaped semicolon in query field",
        }
    }
}

impl Debug for CodecErrorKind {
    fn debug(self: CodecErrorKind) -> string {
        self.to_string()
    }
}

pub struct CodecError {
    kind_value: CodecErrorKind,
    index_value: isize,
}

impl CodecError {
    pub fn kind(self: CodecError) -> CodecErrorKind {
        self.kind_value
    }

    pub fn index(self: CodecError) -> isize {
        self.index_value
    }
}

impl ToString for CodecError {
    fn to_string(self: CodecError) -> string {
        f"{self.kind_value} at index {self.index_value}"
    }
}

impl Debug for CodecError {
    fn debug(self: CodecError) -> string {
        self.to_string()
    }
}

fn codec_error(kind: CodecErrorKind, index: isize) -> CodecError {
    CodecError { kind_value: kind, index_value: index }
}

fn query_mode(mode: EscapeMode) -> bool {
    match mode {
        EscapeMode::PathSegment => false,
        EscapeMode::QueryComponent => true,
    }
}

fn safe_byte(value: byte, mode: EscapeMode) -> bool {
    value >= b'a' && value <= b'z' || value >= b'A' && value <= b'Z'
        || value >= b'0' && value <= b'9'
        || value == b'-'
        || value == b'_'
        || value == b'.'
        || value == b'~'
        || !query_mode(mode)
            && (value == b'$' || value == b'&' || value == b'+' || value == b':' || value == b'='
                || value == b'@')
}

fn escaped_length(input: Slice[byte], mode: EscapeMode, limit: isize) -> Result[isize, CodecError] {
    if limit < 0 {
        return Result::Err(codec_error(CodecErrorKind::InvalidLimit, 0))
    }
    let mut length = 0;
    for index in 0..input.len() {
        let value = input[index];
        let width = if safe_byte(value, mode) || query_mode(mode) && value == b' ' {
            1
        } else {
            3
        };
        if width > limit - length {
            return Result::Err(codec_error(CodecErrorKind::OutputLimit, index))
        }
        length += width;
    }
    Result::Ok(length)
}

fn append_escaped(output: Vec[byte], input: Slice[byte], mode: EscapeMode) -> () {
    let hex = b"0123456789ABCDEF";
    for value in input {
        if safe_byte(value, mode) {
            output.push(value);
        } else if query_mode(mode) && value == b' ' {
            output.push(b'+');
        } else {
            output.push(b'%');
            output.push(hex[(value >> 4).to_isize()]);
            output.push(hex[(value & 15).to_isize()]);
        }
    }
}

pub fn escape(input: Slice[byte], mode: EscapeMode, limit: isize) -> Result[string, CodecError] {
    let length = escaped_length(input, mode, limit)?;
    let output: Vec[byte] = Vec::with_capacity(length);
    append_escaped(output, input, mode);
    Result::Ok(string_from_utf8(output).1)
}

fn hex_value(value: byte) -> isize {
    if value >= b'0' && value <= b'9' {
        (value - b'0').to_isize()
    } else if value >= b'A' && value <= b'F' {
        (value - b'A').to_isize() + 10
    } else if value >= b'a' && value <= b'f' {
        (value - b'a').to_isize() + 10
    } else {
        -1
    }
}

fn decode_component(input: Slice[byte], mode: EscapeMode, limit: isize, base: isize) -> Result[
    bytes::Bytes,
    CodecError,
] {
    if limit < 0 {
        return Result::Err(codec_error(CodecErrorKind::InvalidLimit, base))
    }
    let output = bytes::Bytes::new();
    let mut index = 0;
    while index < input.len() {
        let mut value = input[index];
        let width = if value == b'%' {
            3
        } else {
            1
        };
        if width == 3 {
            if input.len() - index < 3 || hex_value(input[index + 1]) < 0
                || hex_value(input[index + 2]) < 0 {
                return Result::Err(codec_error(CodecErrorKind::InvalidEscape, base + index))
            }
            value = (hex_value(input[index + 1]) * 16 + hex_value(input[index + 2])).to_u8();
        } else if query_mode(mode) && value == b'+' {
            value = b' ';
        }
        if output.len() == limit {
            return Result::Err(codec_error(CodecErrorKind::OutputLimit, base + index))
        }
        output.push(value);
        index += width;
    }
    Result::Ok(output)
}

pub fn unescape(input: string, mode: EscapeMode, limit: isize) -> Result[bytes::Bytes, CodecError] {
    decode_component(input.to_bytes().as_slice(), mode, limit, 0)
}

pub fn path_escape(input: string, limit: isize) -> Result[string, CodecError] {
    escape(input.to_bytes().as_slice(), EscapeMode::PathSegment, limit)
}

pub fn query_escape(input: string, limit: isize) -> Result[string, CodecError] {
    escape(input.to_bytes().as_slice(), EscapeMode::QueryComponent, limit)
}

pub fn path_unescape(input: string, limit: isize) -> Result[bytes::Bytes, CodecError] {
    unescape(input, EscapeMode::PathSegment, limit)
}

pub fn query_unescape(input: string, limit: isize) -> Result[bytes::Bytes, CodecError] {
    unescape(input, EscapeMode::QueryComponent, limit)
}
