package url;

use module::bytes;

pub fn parse_query_bounded(
    input: string,
    max_input_bytes: isize,
    max_fields: isize,
    max_decoded_bytes: isize,
) -> Result[Vec[(bytes::Bytes, bytes::Bytes)], CodecError] {
    if max_input_bytes < 0 || max_fields < 0 || max_decoded_bytes < 0 {
        return Result::Err(codec_error(CodecErrorKind::InvalidLimit, 0))
    }
    if input.byte_len() > max_input_bytes {
        return Result::Err(codec_error(CodecErrorKind::InputLimit, max_input_bytes))
    }
    parse_query(input, max_fields, max_decoded_bytes)
}

pub fn parse_query(input: string, max_fields: isize, max_decoded_bytes: isize) -> Result[
    Vec[(bytes::Bytes, bytes::Bytes)],
    CodecError,
] {
    if max_fields < 0 || max_decoded_bytes < 0 {
        return Result::Err(codec_error(CodecErrorKind::InvalidLimit, 0))
    }
    let source = input.to_bytes();
    let fields: Vec[(bytes::Bytes, bytes::Bytes)] = Vec::new();
    let mut start = 0;
    let mut used = 0;
    while start < source.len() {
        let mut end = start;
        let mut separator = source.len();
        while end < source.len() && source[end] != b'&' {
            if source[end] == b';' {
                return Result::Err(codec_error(CodecErrorKind::InvalidSeparator, end))
            }
            if source[end] == b'=' && separator == source.len() {
                separator = end;
            }
            end += 1;
        }
        if end > start {
            if fields.len() == max_fields {
                return Result::Err(codec_error(CodecErrorKind::FieldLimit, start))
            }
            let name_end = if separator < end {
                separator
            } else {
                end
            };
            let value_start = if separator < end {
                separator + 1
            } else {
                end
            };
            let name = decode_component(
                source.as_slice().sub(start, name_end),
                EscapeMode::QueryComponent,
                max_decoded_bytes - used,
                start,
            )?;
            used += name.len();
            let value = decode_component(
                source.as_slice().sub(value_start, end),
                EscapeMode::QueryComponent,
                max_decoded_bytes - used,
                value_start,
            )?;
            used += value.len();
            fields.push((name, value));
        }
        if end == source.len() {
            break
        }
        start = end + 1;
    }
    Result::Ok(fields)
}

fn compare_names(left: bytes::Bytes, right: bytes::Bytes) -> isize {
    let a = left.as_slice();
    let b = right.as_slice();
    let common = if a.len() < b.len() {
        a.len()
    } else {
        b.len()
    };
    for index in 0..common {
        if a[index] < b[index] {
            return -1
        }
        if a[index] > b[index] {
            return 1
        }
    }
    if a.len() < b.len() {
        -1
    } else if a.len() > b.len() {
        1
    } else {
        0
    }
}

pub fn encode_query(fields: Slice[(bytes::Bytes, bytes::Bytes)], limit: isize) -> Result[
    string,
    CodecError,
] {
    if limit < 0 {
        return Result::Err(codec_error(CodecErrorKind::InvalidLimit, 0))
    }
    let mut length = 0;
    for index in 0..fields.len() {
        let separators = if index == 0 {
            1
        } else {
            2
        };
        if separators > limit - length {
            return Result::Err(codec_error(CodecErrorKind::OutputLimit, index))
        }
        length += separators;
        let (name, value) = fields[index];
        length += escaped_length(name.as_slice(), EscapeMode::QueryComponent, limit - length).map_err(
            |error: CodecError| codec_error(error.kind(), index),
        )?;
        length += escaped_length(value.as_slice(), EscapeMode::QueryComponent, limit - length).map_err(
            |error: CodecError| codec_error(error.kind(), index),
        )?;
    }
    let sorted = fields.to_vec();
    sorted.stable_sort_by(
        |left: (bytes::Bytes, bytes::Bytes), right: (bytes::Bytes, bytes::Bytes)| compare_names(
            left.0,
            right.0,
        ),
    );
    let output: Vec[byte] = Vec::with_capacity(length);
    for index in 0..sorted.len() {
        if index > 0 {
            output.push(b'&');
        }
        let (name, value) = sorted[index];
        append_escaped(output, name.as_slice(), EscapeMode::QueryComponent);
        output.push(b'=');
        append_escaped(output, value.as_slice(), EscapeMode::QueryComponent);
    }
    Result::Ok(string_from_utf8(output).1)
}
