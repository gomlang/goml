package net;

use module::io;

impl io::Read for TcpStream {
    fn read(self: TcpStream, buffer: MutSlice[byte]) -> Result[isize, io::Error] {
        self.read_with(buffer, WaitOptions::new())
    }
}

impl io::Write for TcpStream {
    fn write(self: TcpStream, buffer: Slice[byte]) -> Result[isize, io::Error] {
        self.write_with(buffer, WaitOptions::new())
    }
}

impl io::Close for TcpStream {
    fn close(self: TcpStream) -> Result[(), io::Error] {
        self.socket.close()
    }
}
