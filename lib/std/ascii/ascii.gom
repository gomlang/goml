package ascii;

pub fn is_ascii(value: byte) -> bool {
    value <= 0x7f
}

pub fn is_uppercase(value: byte) -> bool {
    value >= b'A' && value <= b'Z'
}

pub fn is_lowercase(value: byte) -> bool {
    value >= b'a' && value <= b'z'
}

pub fn is_alphabetic(value: byte) -> bool {
    is_uppercase(value) || is_lowercase(value)
}

pub fn is_digit(value: byte) -> bool {
    value >= b'0' && value <= b'9'
}

pub fn is_hexdigit(value: byte) -> bool {
    is_digit(value) || (value >= b'A' && value <= b'F') || (value >= b'a' && value <= b'f')
}

pub fn is_alphanumeric(value: byte) -> bool {
    is_alphabetic(value) || is_digit(value)
}

pub fn is_whitespace(value: byte) -> bool {
    value == b'\t' || value == b'\n' || value == b'\x0B' || value == b'\f' || value == b'\r'
        || value == b' '
}

pub fn is_control(value: byte) -> bool {
    value <= 0x1f || value == 0x7f
}

pub fn is_graphic(value: byte) -> bool {
    value >= 0x21 && value <= 0x7e
}

pub fn is_punctuation(value: byte) -> bool {
    is_graphic(value) && !is_alphanumeric(value)
}

pub fn to_lowercase(value: byte) -> byte {
    if is_uppercase(value) {
        value + (b'a' - b'A')
    } else {
        value
    }
}

pub fn to_uppercase(value: byte) -> byte {
    if is_lowercase(value) {
        value - (b'a' - b'A')
    } else {
        value
    }
}

pub fn eq_ignore_case(left: byte, right: byte) -> bool {
    to_lowercase(left) == to_lowercase(right)
}

fn hex_digit(value: byte) -> char {
    "0123456789abcdef".get(value.to_isize())
}

pub fn escape_default(value: byte) -> string {
    match value {
        b'\t' => "\\t",
        b'\r' => "\\r",
        b'\n' => "\\n",
        39 => "\\'",
        34 => "\\\"",
        92 => "\\\\",
        _ => if value >= 0x20 && value <= 0x7e {
            let (_, result) = string_from_utf8(Vec::from_array([value]));
            result
        } else {
            f"\\x{hex_digit(value >> 4)}{hex_digit(value & 0x0f)}"
        },
    }
}
