package bincode;

use module::bytes;
use module::serde;

fn little_endian(config: Config) -> bool {
    match config.endianness {
        Endianness::Little => true,
        Endianness::Big => false,
    }
}

fn variable_ints(config: Config) -> bool {
    match config.int_encoding {
        IntEncoding::Variable => true,
        IntEncoding::Fixed => false,
    }
}

fn push_fixed(output: Vec[byte], value: u64, width: isize, config: Config) -> () {
    let mut index = 0;
    while index < width {
        let position = if little_endian(config) {
            index
        } else {
            width - index - 1
        };
        output.push((value >> (position * 8)).to_u8());
        index += 1;
    }
}

fn push_variable(output: Vec[byte], value: u64, config: Config) -> () {
    if value < 0xfb {
        output.push(value.to_u8())
    } else if value <= 0xffff {
        output.push(0xfb);
        push_fixed(output, value, 2, config)
    } else if value <= 0xffffffff {
        output.push(0xfc);
        push_fixed(output, value, 4, config)
    } else {
        output.push(0xfd);
        push_fixed(output, value, 8, config)
    }
}

fn normalized_width(width: isize) -> isize {
    if width == 0 {
        64
    } else {
        width
    }
}

fn push_unsigned(output: Vec[byte], value: u64, width: isize, config: Config) -> () {
    let actual_width = normalized_width(width);
    if actual_width == 8 {
        output.push(value.to_u8())
    } else if variable_ints(config) {
        push_variable(output, value, config)
    } else {
        push_fixed(output, value, actual_width / 8, config)
    }
}

fn zigzag(value: i64) -> u64 {
    ((value.to_u64()) << 1) ^ ((value >> 63).to_u64())
}

fn push_signed(output: Vec[byte], value: i64, width: isize, config: Config) -> () {
    let actual_width = normalized_width(width);
    if actual_width == 8 {
        output.push(value.to_u8())
    } else if variable_ints(config) {
        push_variable(output, zigzag(value), config)
    } else {
        push_fixed(output, value.to_u64(), actual_width / 8, config)
    }
}

fn push_length(output: Vec[byte], value: isize, config: Config) -> Result[(), string] {
    if value < 0 {
        Result::Err("negative collection length")
    } else {
        push_unsigned(output, value.to_u64(), 64, config);
        Result::Ok(())
    }
}

fn push_string(output: Vec[byte], value: string, config: Config) -> Result[(), string] {
    let encoded = bytes::Bytes::from_string(value).to_vec();
    push_length(output, encoded.len(), config)?;
    for value in encoded {
        output.push(value)
    }
    Result::Ok(())
}

fn push_values(output: Vec[byte], values: Vec[serde::Value], config: Config) -> Result[(), string] {
    for value in values {
        push_value(output, value, config)?
    }
    Result::Ok(())
}

fn push_fields(output: Vec[byte], fields: Vec[(string, serde::Value)], config: Config) -> Result[
    (),
    string,
] {
    for field in fields {
        push_value(output, field.1, config)?
    }
    Result::Ok(())
}

fn push_optional(output: Vec[byte], values: Vec[serde::Value], config: Config) -> Result[(), string] {
    if values.is_empty() {
        output.push(0);
        Result::Ok(())
    } else if values.len() == 1 {
        output.push(1);
        push_value(output, values[0], config)
    } else {
        Result::Err("optional value contains more than one item")
    }
}

fn push_value(output: Vec[byte], value: serde::Value, config: Config) -> Result[(), string] {
    match value {
        serde::Value::Binary(data) => {
            push_length(output, data.len(), config)?;
            for byte in data {
                output.push(byte)
            }
            Result::Ok(())
        },
        serde::Value::Map(entries) => {
            push_length(output, entries.len(), config)?;
            for entry in entries {
                push_value(output, entry.0, config)?;
                push_value(output, entry.1, config)?;
            }
            Result::Ok(())
        },
        serde::Value::Extension { .. } => Result::Err("bincode does not support extension values"),
        serde::Value::Unit => Result::Ok(()),
        serde::Value::Bool(value) => {
            output.push(
                if value {
                    1
                } else {
                    0
                },
            );
            Result::Ok(())
        },
        serde::Value::Int(value) => {
            push_signed(output, value.to_i64(), 0, config);
            Result::Ok(())
        },
        serde::Value::Int8(value) => {
            push_signed(output, value.to_i64(), 8, config);
            Result::Ok(())
        },
        serde::Value::Int16(value) => {
            push_signed(output, value.to_i64(), 16, config);
            Result::Ok(())
        },
        serde::Value::Int32(value) => {
            push_signed(output, value.to_i64(), 32, config);
            Result::Ok(())
        },
        serde::Value::Int64(value) => {
            push_signed(output, value, 64, config);
            Result::Ok(())
        },
        serde::Value::Uint(value) => {
            push_unsigned(output, value.to_u64(), 0, config);
            Result::Ok(())
        },
        serde::Value::Uint8(value) => {
            push_unsigned(output, value.to_u64(), 8, config);
            Result::Ok(())
        },
        serde::Value::Uint16(value) => {
            push_unsigned(output, value.to_u64(), 16, config);
            Result::Ok(())
        },
        serde::Value::Uint32(value) => {
            push_unsigned(output, value.to_u64(), 32, config);
            Result::Ok(())
        },
        serde::Value::Uint64(value) => {
            push_unsigned(output, value, 64, config);
            Result::Ok(())
        },
        serde::Value::Float32(value) => {
            push_fixed(output, value.to_bits().to_u64(), 4, config);
            Result::Ok(())
        },
        serde::Value::Float64(value) => {
            push_fixed(output, value.to_bits(), 8, config);
            Result::Ok(())
        },
        serde::Value::Number(_) => Result::Err("bincode requires a precise numeric type"),
        serde::Value::String(value) => push_string(output, value, config),
        serde::Value::Char(value) => {
            push_unsigned(output, value.to_u32().to_u64(), 32, config);
            Result::Ok(())
        },
        serde::Value::Sequence(values) => {
            push_length(output, values.len(), config)?;
            push_values(output, values, config)
        },
        serde::Value::Tuple(values) => push_values(output, values, config),
        serde::Value::Optional(values) => push_optional(output, values, config),
        serde::Value::Struct(fields) => push_fields(output, fields, config),
        serde::Value::Variant { index, name: _, kind: _, fields } => {
            if index < 0 {
                Result::Err("negative enum variant index")
            } else {
                push_unsigned(output, index.to_u64(), 32, config);
                push_fields(output, fields, config)
            }
        },
    }
}

enum BincodeSerializeFrame {
    Optional {
        ready: Ref[bool],
    },
    Sequence {
        length: isize,
        index: Ref[isize],
        ready: Ref[bool],
    },
    Tuple {
        length: isize,
        index: Ref[isize],
        ready: Ref[bool],
    },
    Map {
        length: isize,
        index: Ref[isize],
        state: Ref[isize],
    },
    Struct {
        length: isize,
        index: Ref[isize],
        ready: Ref[bool],
    },
    Variant {
        length: isize,
        index: Ref[isize],
        ready: Ref[bool],
    },
}

struct BincodeSerializer {
    output: Vec[byte],
    config: Config,
    frames: Vec[BincodeSerializeFrame],
    root_written: Ref[bool],
}

fn bincode_serializer(config: Config) -> BincodeSerializer {
    BincodeSerializer {
        output: Vec::new(),
        config,
        frames: Vec::new(),
        root_written: Ref::new(false),
    }
}

fn claim_bincode_value(serializer: BincodeSerializer) -> Result[(), string] {
    if serializer.frames.is_empty() {
        if serializer.root_written.get() {
            Result::Err("bincode serialization produced more than one root value")
        } else {
            serializer.root_written.set(true);
            Result::Ok(())
        }
    } else {
        let frame = serializer.frames.len() - 1;
        match serializer.frames[frame] {
            BincodeSerializeFrame::Optional { ready } => if ready.get() {
                ready.set(false);
                Result::Ok(())
            } else {
                Result::Err("optional is not expecting a value")
            },
            BincodeSerializeFrame::Sequence { length: _, index: _, ready } => if ready.get() {
                ready.set(false);
                Result::Ok(())
            } else {
                Result::Err("sequence is not expecting a value")
            },
            BincodeSerializeFrame::Tuple { length: _, index: _, ready } => if ready.get() {
                ready.set(false);
                Result::Ok(())
            } else {
                Result::Err("tuple is not expecting a value")
            },
            BincodeSerializeFrame::Map { length: _, index, state } => if state.get() == 1 {
                state.set(2);
                Result::Ok(())
            } else if state.get() == 3 {
                index.set(index.get() + 1);
                state.set(0);
                Result::Ok(())
            } else {
                Result::Err("map is not expecting a value")
            },
            BincodeSerializeFrame::Struct { length: _, index: _, ready } => if ready.get() {
                ready.set(false);
                Result::Ok(())
            } else {
                Result::Err("struct is not expecting a value")
            },
            BincodeSerializeFrame::Variant { length: _, index: _, ready } => if ready.get() {
                ready.set(false);
                Result::Ok(())
            } else {
                Result::Err("variant is not expecting a value")
            },
        }
    }
}

fn finish_bincode_serializer(serializer: BincodeSerializer) -> Result[(), string] {
    if !serializer.frames.is_empty() {
        Result::Err("bincode serialization ended inside a compound value")
    } else if !serializer.root_written.get() {
        Result::Err("bincode serialization produced no value")
    } else {
        Result::Ok(())
    }
}

impl serde::Serializer for BincodeSerializer {
    fn is_human_readable(self: BincodeSerializer) -> bool {
        false
    }

    fn serialize_unit(self: BincodeSerializer) -> Result[(), string] {
        claim_bincode_value(self)
    }

    fn serialize_bool(self: BincodeSerializer, value: bool) -> Result[(), string] {
        claim_bincode_value(self)?;
        self.output.push(
            if value {
                1
            } else {
                0
            },
        );
        Result::Ok(())
    }

    fn serialize_int(self: BincodeSerializer, value: isize) -> Result[(), string] {
        claim_bincode_value(self)?;
        push_signed(self.output, value.to_i64(), 0, self.config);
        Result::Ok(())
    }

    fn serialize_int8(self: BincodeSerializer, value: i8) -> Result[(), string] {
        claim_bincode_value(self)?;
        push_signed(self.output, value.to_i64(), 8, self.config);
        Result::Ok(())
    }

    fn serialize_int16(self: BincodeSerializer, value: i16) -> Result[(), string] {
        claim_bincode_value(self)?;
        push_signed(self.output, value.to_i64(), 16, self.config);
        Result::Ok(())
    }

    fn serialize_int32(self: BincodeSerializer, value: i32) -> Result[(), string] {
        claim_bincode_value(self)?;
        push_signed(self.output, value.to_i64(), 32, self.config);
        Result::Ok(())
    }

    fn serialize_int64(self: BincodeSerializer, value: i64) -> Result[(), string] {
        claim_bincode_value(self)?;
        push_signed(self.output, value, 64, self.config);
        Result::Ok(())
    }

    fn serialize_uint(self: BincodeSerializer, value: usize) -> Result[(), string] {
        claim_bincode_value(self)?;
        push_unsigned(self.output, value.to_u64(), 0, self.config);
        Result::Ok(())
    }

    fn serialize_uint8(self: BincodeSerializer, value: u8) -> Result[(), string] {
        claim_bincode_value(self)?;
        push_unsigned(self.output, value.to_u64(), 8, self.config);
        Result::Ok(())
    }

    fn serialize_uint16(self: BincodeSerializer, value: u16) -> Result[(), string] {
        claim_bincode_value(self)?;
        push_unsigned(self.output, value.to_u64(), 16, self.config);
        Result::Ok(())
    }

    fn serialize_uint32(self: BincodeSerializer, value: u32) -> Result[(), string] {
        claim_bincode_value(self)?;
        push_unsigned(self.output, value.to_u64(), 32, self.config);
        Result::Ok(())
    }

    fn serialize_uint64(self: BincodeSerializer, value: u64) -> Result[(), string] {
        claim_bincode_value(self)?;
        push_unsigned(self.output, value, 64, self.config);
        Result::Ok(())
    }

    fn serialize_float32(self: BincodeSerializer, value: f32) -> Result[(), string] {
        claim_bincode_value(self)?;
        push_fixed(self.output, value.to_bits().to_u64(), 4, self.config);
        Result::Ok(())
    }

    fn serialize_float64(self: BincodeSerializer, value: f64) -> Result[(), string] {
        claim_bincode_value(self)?;
        push_fixed(self.output, value.to_bits(), 8, self.config);
        Result::Ok(())
    }

    fn serialize_number(self: BincodeSerializer, value: string) -> Result[(), string] {
        let _ = self;
        let _ = value;
        Result::Err("bincode requires a precise numeric type")
    }

    fn serialize_string(self: BincodeSerializer, value: string) -> Result[(), string] {
        claim_bincode_value(self)?;
        push_string(self.output, value, self.config)
    }

    fn serialize_char(self: BincodeSerializer, value: char) -> Result[(), string] {
        claim_bincode_value(self)?;
        push_unsigned(self.output, value.to_u32().to_u64(), 32, self.config);
        Result::Ok(())
    }

    fn serialize_bytes(self: BincodeSerializer, value: Slice[byte]) -> Result[(), string] {
        claim_bincode_value(self)?;
        push_length(self.output, value.len(), self.config)?;
        for byte_value in value {
            self.output.push(byte_value)
        }
        Result::Ok(())
    }

    fn begin_optional(self: BincodeSerializer, present: bool) -> Result[(), string] {
        claim_bincode_value(self)?;
        self.output.push(
            if present {
                1
            } else {
                0
            },
        );
        self.frames.push(BincodeSerializeFrame::Optional { ready: Ref::new(present) });
        Result::Ok(())
    }

    fn end_optional(self: BincodeSerializer) -> Result[(), string] {
        if self.frames.is_empty() {
            return Result::Err("end_optional without begin_optional")
        }
        match self.frames[self.frames.len() - 1] {
            BincodeSerializeFrame::Optional { ready } => if ready.get() {
                Result::Err("optional item was not serialized")
            } else {
                let _ = self.frames.pop();
                Result::Ok(())
            },
            _ => Result::Err("end_optional does not match active bincode value"),
        }
    }

    fn begin_sequence(self: BincodeSerializer, length: isize) -> Result[(), string] {
        if length < 0 {
            Result::Err("negative collection length")
        } else {
            claim_bincode_value(self)?;
            push_length(self.output, length, self.config)?;
            self.frames.push(
                BincodeSerializeFrame::Sequence {
                    length,
                    index: Ref::new(0),
                    ready: Ref::new(false),
                },
            );
            Result::Ok(())
        }
    }

    fn begin_sequence_element(self: BincodeSerializer, index: isize) -> Result[(), string] {
        if self.frames.is_empty() {
            return Result::Err("sequence element without sequence")
        }
        let frame = self.frames.len() - 1;
        match self.frames[frame] {
            BincodeSerializeFrame::Sequence { length, index: next, ready } => if ready.get()
                || index != next.get()
                || index >= length {
                Result::Err("sequence element index is out of order")
            } else {
                next.set(index + 1);
                ready.set(true);
                Result::Ok(())
            },
            _ => Result::Err("sequence element outside a sequence"),
        }
    }

    fn end_sequence(self: BincodeSerializer) -> Result[(), string] {
        if self.frames.is_empty() {
            return Result::Err("end_sequence without begin_sequence")
        }
        match self.frames[self.frames.len() - 1] {
            BincodeSerializeFrame::Sequence { length, index, ready } => if ready.get()
                || index.get() != length {
                Result::Err("sequence length does not match serialized elements")
            } else {
                let _ = self.frames.pop();
                Result::Ok(())
            },
            _ => Result::Err("end_sequence does not match active bincode value"),
        }
    }

    fn begin_tuple(self: BincodeSerializer, length: isize) -> Result[(), string] {
        if length < 0 {
            Result::Err("tuple length cannot be negative")
        } else {
            claim_bincode_value(self)?;
            self.frames.push(
                BincodeSerializeFrame::Tuple { length, index: Ref::new(0), ready: Ref::new(false) },
            );
            Result::Ok(())
        }
    }

    fn begin_tuple_element(self: BincodeSerializer, index: isize) -> Result[(), string] {
        if self.frames.is_empty() {
            return Result::Err("tuple element without tuple")
        }
        let frame = self.frames.len() - 1;
        match self.frames[frame] {
            BincodeSerializeFrame::Tuple { length, index: next, ready } => if ready.get()
                || index != next.get()
                || index >= length {
                Result::Err("tuple element index is out of order")
            } else {
                next.set(index + 1);
                ready.set(true);
                Result::Ok(())
            },
            _ => Result::Err("tuple element outside a tuple"),
        }
    }

    fn end_tuple(self: BincodeSerializer) -> Result[(), string] {
        if self.frames.is_empty() {
            return Result::Err("end_tuple without begin_tuple")
        }
        match self.frames[self.frames.len() - 1] {
            BincodeSerializeFrame::Tuple { length, index, ready } => if ready.get()
                || index.get() != length {
                Result::Err("tuple length does not match serialized elements")
            } else {
                let _ = self.frames.pop();
                Result::Ok(())
            },
            _ => Result::Err("end_tuple does not match active bincode value"),
        }
    }

    fn begin_map(self: BincodeSerializer, length: isize) -> Result[(), string] {
        if length < 0 {
            Result::Err("negative collection length")
        } else {
            claim_bincode_value(self)?;
            push_length(self.output, length, self.config)?;
            self.frames.push(
                BincodeSerializeFrame::Map { length, index: Ref::new(0), state: Ref::new(0) },
            );
            Result::Ok(())
        }
    }

    fn begin_map_key(self: BincodeSerializer, index: isize) -> Result[(), string] {
        if self.frames.is_empty() {
            return Result::Err("map key without map")
        }
        let frame = self.frames.len() - 1;
        match self.frames[frame] {
            BincodeSerializeFrame::Map { length, index: next, state } => if state.get() != 0
                || index != next.get()
                || index >= length {
                Result::Err("map key index is out of order")
            } else {
                state.set(1);
                Result::Ok(())
            },
            _ => Result::Err("map key outside a map"),
        }
    }

    fn begin_map_value(self: BincodeSerializer, index: isize) -> Result[(), string] {
        if self.frames.is_empty() {
            return Result::Err("map value without map")
        }
        let frame = self.frames.len() - 1;
        match self.frames[frame] {
            BincodeSerializeFrame::Map { length: _, index: next, state } => if state.get() != 2
                || index != next.get() {
                Result::Err("map value has no completed key")
            } else {
                state.set(3);
                Result::Ok(())
            },
            _ => Result::Err("map value outside a map"),
        }
    }

    fn end_map(self: BincodeSerializer) -> Result[(), string] {
        if self.frames.is_empty() {
            return Result::Err("end_map without begin_map")
        }
        match self.frames[self.frames.len() - 1] {
            BincodeSerializeFrame::Map { length, index, state } => if state.get() != 0
                || index.get() != length {
                Result::Err("map length does not match serialized entries")
            } else {
                let _ = self.frames.pop();
                Result::Ok(())
            },
            _ => Result::Err("end_map does not match active bincode value"),
        }
    }

    fn begin_struct(self: BincodeSerializer, name: string, fields: isize) -> Result[(), string] {
        let _ = name;
        if fields < 0 {
            Result::Err("struct field count cannot be negative")
        } else {
            claim_bincode_value(self)?;
            self.frames.push(
                BincodeSerializeFrame::Struct {
                    length: fields,
                    index: Ref::new(0),
                    ready: Ref::new(false),
                },
            );
            Result::Ok(())
        }
    }

    fn begin_struct_field(self: BincodeSerializer, index: isize, name: string) -> Result[(), string] {
        let _ = name;
        if self.frames.is_empty() {
            return Result::Err("struct field without struct")
        }
        let frame = self.frames.len() - 1;
        match self.frames[frame] {
            BincodeSerializeFrame::Struct { length, index: next, ready } => if ready.get()
                || index != next.get()
                || index >= length {
                Result::Err("struct field index is out of order")
            } else {
                next.set(index + 1);
                ready.set(true);
                Result::Ok(())
            },
            _ => Result::Err("struct field outside a struct"),
        }
    }

    fn end_struct(self: BincodeSerializer) -> Result[(), string] {
        if self.frames.is_empty() {
            return Result::Err("end_struct without begin_struct")
        }
        match self.frames[self.frames.len() - 1] {
            BincodeSerializeFrame::Struct { length, index, ready } => if ready.get()
                || index.get() != length {
                Result::Err("struct field count does not match serialized values")
            } else {
                let _ = self.frames.pop();
                Result::Ok(())
            },
            _ => Result::Err("end_struct does not match active bincode value"),
        }
    }

    fn begin_variant(
        self: BincodeSerializer,
        enum_name: string,
        index: isize,
        name: string,
        kind: isize,
        fields: isize,
    ) -> Result[(), string] {
        let _ = enum_name;
        let _ = name;
        if index < 0 {
            Result::Err("negative enum variant index")
        } else if kind < 0 || kind > 2 {
            Result::Err("invalid enum variant kind")
        } else if fields < 0 {
            Result::Err("enum variant field count cannot be negative")
        } else if kind == 0 && fields != 0 {
            Result::Err("unit enum variant cannot contain fields")
        } else {
            claim_bincode_value(self)?;
            push_unsigned(self.output, index.to_u64(), 32, self.config);
            self.frames.push(
                BincodeSerializeFrame::Variant {
                    length: fields,
                    index: Ref::new(0),
                    ready: Ref::new(false),
                },
            );
            Result::Ok(())
        }
    }

    fn begin_variant_field(self: BincodeSerializer, index: isize, name: string) -> Result[
        (),
        string,
    ] {
        let _ = name;
        if self.frames.is_empty() {
            return Result::Err("variant field without variant")
        }
        let frame = self.frames.len() - 1;
        match self.frames[frame] {
            BincodeSerializeFrame::Variant { length, index: next, ready } => if ready.get()
                || index != next.get()
                || index >= length {
                Result::Err("variant field index is out of order")
            } else {
                next.set(index + 1);
                ready.set(true);
                Result::Ok(())
            },
            _ => Result::Err("variant field outside a variant"),
        }
    }

    fn end_variant(self: BincodeSerializer) -> Result[(), string] {
        if self.frames.is_empty() {
            return Result::Err("end_variant without begin_variant")
        }
        match self.frames[self.frames.len() - 1] {
            BincodeSerializeFrame::Variant { length, index, ready } => if ready.get()
                || index.get() != length {
                Result::Err("variant field count does not match serialized values")
            } else {
                let _ = self.frames.pop();
                Result::Ok(())
            },
            _ => Result::Err("end_variant does not match active bincode value"),
        }
    }
}

pub fn encode_value(value: serde::Value, config: Config) -> Result[Vec[byte], string] {
    let output: Vec[byte] = Vec::new();
    push_value(output, value, config)?;
    Result::Ok(output)
}
