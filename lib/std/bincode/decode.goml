package bincode;

use module::bytes;
use module::serde;
use module::utf8;
use utf8::BytesUtf8;

enum BincodeFrame {
    Optional {
        ready: Ref[bool],
    },
    Sequence {
        length: isize,
        index: Ref[isize],
        ready: Ref[bool],
    },
    Tuple {
        length: isize,
        index: Ref[isize],
        ready: Ref[bool],
    },
    Map {
        length: isize,
        index: Ref[isize],
        state: Ref[isize],
    },
    Struct {
        name: string,
        fields: isize,
        index: Ref[isize],
        ready: Ref[bool],
    },
    Variant {
        enum_name: string,
        variant: isize,
        fields: Ref[isize],
        index: Ref[isize],
        begun: Ref[bool],
        ready: Ref[bool],
    },
}

struct Decoder {
    input: Slice[byte],
    offset: Ref[isize],
    config: Config,
    frames: Vec[BincodeFrame],
}

fn bincode_deserializer(input: Slice[byte], config: Config) -> Decoder {
    Decoder { input, offset: Ref::new(0), config, frames: Vec::new() }
}

fn bincode_current_index(index: Ref[isize]) -> isize {
    if index.get() > 0 {
        index.get() - 1
    } else {
        0
    }
}

fn write_bincode_path_string(builder: bytes::Builder, value: string) -> () {
    for index in 0..value.byte_len() {
        builder.push(value.byte_get(index))
    }
}

fn write_bincode_frame_path(builder: bytes::Builder, frame: BincodeFrame) -> () {
    match frame {
        BincodeFrame::Optional { ready: _ } => write_bincode_path_string(builder, ".Some"),
        BincodeFrame::Sequence { length: _, index, ready: _ } => {
            builder.push(b'[');
            write_bincode_path_string(builder, bincode_current_index(index).to_string());
            builder.push(b']')
        },
        BincodeFrame::Tuple { length: _, index, ready: _ } => {
            builder.push(b'[');
            write_bincode_path_string(builder, bincode_current_index(index).to_string());
            builder.push(b']')
        },
        BincodeFrame::Map { length: _, index, state } => {
            builder.push(b'[');
            write_bincode_path_string(builder, index.get().to_string());
            builder.push(b']');
            if state.get() <= 3 {
                write_bincode_path_string(builder, ".key")
            } else {
                write_bincode_path_string(builder, ".value")
            }
        },
        BincodeFrame::Struct { name, fields: _, index, ready: _ } => {
            builder.push(b'.');
            write_bincode_path_string(builder, name);
            builder.push(b'[');
            write_bincode_path_string(builder, bincode_current_index(index).to_string());
            builder.push(b']')
        },
        BincodeFrame::Variant { enum_name, variant, fields: _, index, begun: _, ready: _ } => {
            builder.push(b'.');
            write_bincode_path_string(builder, enum_name);
            write_bincode_path_string(builder, "::");
            write_bincode_path_string(builder, variant.to_string());
            builder.push(b'[');
            write_bincode_path_string(builder, bincode_current_index(index).to_string());
            builder.push(b']')
        },
    }
}

fn bincode_decoder_path(decoder: Decoder) -> string {
    let builder = bytes::Builder::new();
    builder.push(b'$');
    for frame in decoder.frames {
        write_bincode_frame_path(builder, frame)
    }
    let (_, path) = string_from_utf8(builder.finish().to_vec());
    path
}

fn decoder_error(decoder: Decoder, message: string) -> string {
    message + " at path " + bincode_decoder_path(decoder) + f" at byte {decoder.offset.get()}"
}

fn read_byte(decoder: Decoder) -> Result[byte, string] {
    let offset = decoder.offset.get();
    if offset >= decoder.input.len() {
        Result::Err(decoder_error(decoder, "unexpected end of input"))
    } else {
        let value = decoder.input.get(offset);
        decoder.offset.set(offset + 1);
        Result::Ok(value)
    }
}

fn read_fixed(decoder: Decoder, width: isize) -> Result[u64, string] {
    let mut result: u64 = 0;
    let mut index = 0;
    while index < width {
        let value = read_byte(decoder)?.to_u64();
        let position = if little_endian(decoder.config) {
            index
        } else {
            width - index - 1
        };
        result = result | (value << (position * 8));
        index += 1;
    }
    Result::Ok(result)
}

fn read_variable(decoder: Decoder) -> Result[u64, string] {
    let marker = read_byte(decoder)?;
    if marker < 0xfb {
        Result::Ok(marker.to_u64())
    } else if marker == 0xfb {
        read_fixed(decoder, 2)
    } else if marker == 0xfc {
        read_fixed(decoder, 4)
    } else if marker == 0xfd {
        read_fixed(decoder, 8)
    } else if marker == 0xfe {
        Result::Err(decoder_error(decoder, "u128 varints are unsupported"))
    } else {
        Result::Err(decoder_error(decoder, "invalid varint marker"))
    }
}

fn unsigned_fits(value: u64, width: isize) -> bool {
    if width == 8 {
        value <= 0xff
    } else if width == 16 {
        value <= 0xffff
    } else if width == 32 {
        value <= 0xffffffff
    } else {
        true
    }
}

fn read_unsigned(decoder: Decoder, width: isize) -> Result[u64, string] {
    let actual_width = normalized_width(width);
    let value = if actual_width == 8 {
        read_byte(decoder)?.to_u64()
    } else if variable_ints(decoder.config) {
        read_variable(decoder)?
    } else {
        read_fixed(decoder, actual_width / 8)?
    };
    if unsigned_fits(value, actual_width) {
        Result::Ok(value)
    } else {
        Result::Err(decoder_error(decoder, "integer exceeds destination width"))
    }
}

fn signed_fits(value: i64, width: isize) -> bool {
    if width == 8 {
        value >= -128 && value <= 127
    } else if width == 16 {
        value >= -32768 && value <= 32767
    } else if width == 32 {
        value >= -2147483648 && value <= 2147483647
    } else {
        true
    }
}

fn unzigzag(value: u64) -> i64 {
    let magnitude = (value >> 1).to_i64();
    if value & 1 == 0 {
        magnitude
    } else {
        -magnitude - 1
    }
}

fn fixed_signed(value: u64, width: isize) -> i64 {
    if width == 8 {
        value.to_u8().to_i8().to_i64()
    } else if width == 16 {
        value.to_u16().to_i16().to_i64()
    } else if width == 32 {
        value.to_u32().to_i32().to_i64()
    } else {
        value.to_i64()
    }
}

fn read_signed(decoder: Decoder, width: isize) -> Result[i64, string] {
    let actual_width = normalized_width(width);
    let value = if actual_width == 8 {
        read_byte(decoder)?.to_i8().to_i64()
    } else if variable_ints(decoder.config) {
        unzigzag(read_variable(decoder)?)
    } else {
        fixed_signed(read_fixed(decoder, actual_width / 8)?, actual_width)
    };
    if signed_fits(value, actual_width) {
        Result::Ok(value)
    } else {
        Result::Err(decoder_error(decoder, "integer exceeds destination width"))
    }
}

fn read_length(decoder: Decoder) -> Result[isize, string] {
    let value = read_unsigned(decoder, 64)?;
    let maximum = 9223372036854775807.to_u64();
    if value > maximum {
        Result::Err(decoder_error(decoder, "collection length is too large"))
    } else {
        Result::Ok(value.to_isize())
    }
}

fn read_string(decoder: Decoder) -> Result[string, string] {
    let length = read_length(decoder)?;
    let remaining = decoder.input.len() - decoder.offset.get();
    if length > remaining {
        Result::Err(decoder_error(decoder, "string length exceeds remaining input"))
    } else {
        let values: Vec[byte] = Vec::with_capacity(length);
        for _ in 0..length {
            values.push(read_byte(decoder)?);
        }
        bytes::Bytes::from_vec(values).to_string_utf8().map_err(
            |_| decoder_error(decoder, "invalid UTF-8 string"),
        )
    }
}

fn read_integer(decoder: Decoder, signed: bool, width: isize) -> Result[serde::Value, string] {
    if signed {
        let value = read_signed(decoder, width)?;
        if width == 0 {
            Result::Ok(serde::Value::Int(value.to_isize()))
        } else if width == 8 {
            Result::Ok(serde::Value::Int8(value.to_i8()))
        } else if width == 16 {
            Result::Ok(serde::Value::Int16(value.to_i16()))
        } else if width == 32 {
            Result::Ok(serde::Value::Int32(value.to_i32()))
        } else if width == 64 {
            Result::Ok(serde::Value::Int64(value))
        } else {
            Result::Err(decoder_error(decoder, "unsupported signed integer width"))
        }
    } else {
        let value = read_unsigned(decoder, width)?;
        if width == 0 {
            Result::Ok(serde::Value::Uint(value.to_usize()))
        } else if width == 8 {
            Result::Ok(serde::Value::Uint8(value.to_u8()))
        } else if width == 16 {
            Result::Ok(serde::Value::Uint16(value.to_u16()))
        } else if width == 32 {
            Result::Ok(serde::Value::Uint32(value.to_u32()))
        } else if width == 64 {
            Result::Ok(serde::Value::Uint64(value))
        } else {
            Result::Err(decoder_error(decoder, "unsupported unsigned integer width"))
        }
    }
}

fn read_float(decoder: Decoder, width: isize) -> Result[serde::Value, string] {
    if width == 32 {
        Result::Ok(
            serde::Value::Float32(
                __goml_builtin_float32_from_bits(read_fixed(decoder, 4)?.to_u32()),
            ),
        )
    } else if width == 64 {
        Result::Ok(serde::Value::Float64(__goml_builtin_float64_from_bits(read_fixed(decoder, 8)?)))
    } else {
        Result::Err(decoder_error(decoder, "unsupported floating-point width"))
    }
}

fn read_char(decoder: Decoder) -> Result[serde::Value, string] {
    let value = read_unsigned(decoder, 32)?;
    char_from_u32(value.to_u32()).map(|value| serde::Value::Char(value)).ok_or(
        decoder_error(decoder, "invalid Unicode scalar value"),
    )
}

fn read_sequence(decoder: Decoder, schemas: Vec[serde::Schema]) -> Result[serde::Value, string] {
    if schemas.len() != 1 {
        Result::Err(decoder_error(decoder, "invalid sequence schema"))
    } else {
        let length = read_length(decoder)?;
        let values: Vec[serde::Value] = Vec::with_capacity(length);
        for _ in 0..length {
            values.push(read_schema(decoder, schemas[0])?);
        }
        Result::Ok(serde::Value::Sequence(values))
    }
}

fn read_tuple(decoder: Decoder, schemas: Vec[serde::Schema]) -> Result[serde::Value, string] {
    let values: Vec[serde::Value] = Vec::with_capacity(schemas.len());
    for schema in schemas {
        values.push(read_schema(decoder, schema)?)
    }
    Result::Ok(serde::Value::Tuple(values))
}

fn read_optional(decoder: Decoder, schemas: Vec[serde::Schema]) -> Result[serde::Value, string] {
    if schemas.len() != 1 {
        Result::Err(decoder_error(decoder, "invalid optional schema"))
    } else {
        let tag = read_byte(decoder)?;
        if tag == 0 {
            Result::Ok(serde::Value::Optional(Vec::new()))
        } else if tag == 1 {
            Result::Ok(serde::Value::Optional(Vec::from_array([read_schema(decoder, schemas[0])?])))
        } else {
            Result::Err(decoder_error(decoder, "invalid option tag"))
        }
    }
}

fn read_fields(decoder: Decoder, schemas: Vec[(string, serde::Schema)]) -> Result[
    Vec[(string, serde::Value)],
    string,
] {
    let values: Vec[(string, serde::Value)] = Vec::with_capacity(schemas.len());
    for field in schemas {
        values.push((field.0, read_schema(decoder, field.1)?))
    }
    Result::Ok(values)
}

fn read_variant(decoder: Decoder, variants: Vec[serde::VariantSchema]) -> Result[
    serde::Value,
    string,
] {
    let index = read_unsigned(decoder, 32)?;
    for variant in variants {
        if variant.index >= 0 && variant.index.to_u64() == index {
            let fields = read_fields(decoder, variant.fields)?;
            return Result::Ok(
                serde::Value::Variant {
                    index: variant.index,
                    name: variant.name,
                    kind: variant.kind,
                    fields,
                },
            )
        }
    }
    Result::Err(decoder_error(decoder, "unknown enum variant index"))
}

fn read_schema(decoder: Decoder, schema: serde::Schema) -> Result[serde::Value, string] {
    match schema {
        serde::Schema::Any => Result::Err(
            decoder_error(decoder, "bincode cannot decode a schema-free value"),
        ),
        serde::Schema::Unit => Result::Ok(serde::Value::Unit),
        serde::Schema::Bool => {
            let value = read_byte(decoder)?;
            if value == 0 {
                Result::Ok(serde::Value::Bool(false))
            } else if value == 1 {
                Result::Ok(serde::Value::Bool(true))
            } else {
                Result::Err(decoder_error(decoder, "invalid bool value"))
            }
        },
        serde::Schema::Integer { signed, width } => read_integer(decoder, signed, width),
        serde::Schema::Float(width) => read_float(decoder, width),
        serde::Schema::String => Result::Ok(serde::Value::String(read_string(decoder)?)),
        serde::Schema::Char => read_char(decoder),
        serde::Schema::Sequence(schemas) => read_sequence(decoder, schemas),
        serde::Schema::Tuple(schemas) => read_tuple(decoder, schemas),
        serde::Schema::Optional(schemas) => read_optional(decoder, schemas),
        serde::Schema::Struct(fields) => Result::Ok(
            serde::Value::Struct(read_fields(decoder, fields)?),
        ),
        serde::Schema::Enum(variants) => read_variant(decoder, variants),
    }
}

fn decoder_frame_index(decoder: Decoder) -> Result[isize, string] {
    if decoder.frames.is_empty() {
        Result::Err(decoder_error(decoder, "no active compound value"))
    } else {
        Result::Ok(decoder.frames.len() - 1)
    }
}

fn pop_decoder_frame(decoder: Decoder) -> () {
    let _ = decoder.frames.pop();
}

fn claim_bincode_input(decoder: Decoder) -> Result[(), string] {
    if decoder.frames.is_empty() {
        Result::Ok(())
    } else {
        let frame = decoder.frames.len() - 1;
        match decoder.frames[frame] {
            BincodeFrame::Optional { ready } => if ready.get() {
                ready.set(false);
                Result::Ok(())
            } else {
                Result::Err(decoder_error(decoder, "optional is not expecting a value"))
            },
            BincodeFrame::Sequence { length: _, index: _, ready } => if ready.get() {
                ready.set(false);
                Result::Ok(())
            } else {
                Result::Err(decoder_error(decoder, "sequence is not expecting a value"))
            },
            BincodeFrame::Tuple { length: _, index: _, ready } => if ready.get() {
                ready.set(false);
                Result::Ok(())
            } else {
                Result::Err(decoder_error(decoder, "tuple is not expecting a value"))
            },
            BincodeFrame::Map { length: _, index: _, state } => if state.get() == 2 {
                state.set(3);
                Result::Ok(())
            } else if state.get() == 4 {
                state.set(5);
                Result::Ok(())
            } else {
                Result::Err(decoder_error(decoder, "map is not expecting a value"))
            },
            BincodeFrame::Struct { name: _, fields: _, index: _, ready } => if ready.get() {
                ready.set(false);
                Result::Ok(())
            } else {
                Result::Err(decoder_error(decoder, "struct is not expecting a value"))
            },
            BincodeFrame::Variant { enum_name: _, variant: _, fields: _, index: _, begun, ready } => if begun.get()
                && ready.get() {
                ready.set(false);
                Result::Ok(())
            } else {
                Result::Err(decoder_error(decoder, "variant is not expecting a value"))
            },
        }
    }
}

impl serde::Deserializer for Decoder {
    fn is_human_readable(self: Decoder) -> bool {
        false
    }

    fn error(self: Decoder, message: string) -> string {
        decoder_error(self, message)
    }

    fn deserialize_any(self: Decoder) -> Result[serde::Value, string] {
        Result::Err(decoder_error(self, "bincode cannot decode a schema-free value"))
    }

    fn deserialize_unit(self: Decoder) -> Result[(), string] {
        claim_bincode_input(self)
    }

    fn deserialize_bool(self: Decoder) -> Result[bool, string] {
        claim_bincode_input(self)?;
        let value = read_byte(self)?;
        if value == 0 {
            Result::Ok(false)
        } else if value == 1 {
            Result::Ok(true)
        } else {
            Result::Err(decoder_error(self, "invalid bool value"))
        }
    }

    fn deserialize_int(self: Decoder) -> Result[isize, string] {
        claim_bincode_input(self)?;
        Result::Ok(read_signed(self, 0)?.to_isize())
    }

    fn deserialize_int8(self: Decoder) -> Result[i8, string] {
        claim_bincode_input(self)?;
        Result::Ok(read_signed(self, 8)?.to_i8())
    }

    fn deserialize_int16(self: Decoder) -> Result[i16, string] {
        claim_bincode_input(self)?;
        Result::Ok(read_signed(self, 16)?.to_i16())
    }

    fn deserialize_int32(self: Decoder) -> Result[i32, string] {
        claim_bincode_input(self)?;
        Result::Ok(read_signed(self, 32)?.to_i32())
    }

    fn deserialize_int64(self: Decoder) -> Result[i64, string] {
        claim_bincode_input(self)?;
        read_signed(self, 64)
    }

    fn deserialize_uint(self: Decoder) -> Result[usize, string] {
        claim_bincode_input(self)?;
        Result::Ok(read_unsigned(self, 0)?.to_usize())
    }

    fn deserialize_uint8(self: Decoder) -> Result[u8, string] {
        claim_bincode_input(self)?;
        Result::Ok(read_unsigned(self, 8)?.to_u8())
    }

    fn deserialize_uint16(self: Decoder) -> Result[u16, string] {
        claim_bincode_input(self)?;
        Result::Ok(read_unsigned(self, 16)?.to_u16())
    }

    fn deserialize_uint32(self: Decoder) -> Result[u32, string] {
        claim_bincode_input(self)?;
        Result::Ok(read_unsigned(self, 32)?.to_u32())
    }

    fn deserialize_uint64(self: Decoder) -> Result[u64, string] {
        claim_bincode_input(self)?;
        read_unsigned(self, 64)
    }

    fn deserialize_float32(self: Decoder) -> Result[f32, string] {
        claim_bincode_input(self)?;
        Result::Ok(__goml_builtin_float32_from_bits(read_fixed(self, 4)?.to_u32()))
    }

    fn deserialize_float64(self: Decoder) -> Result[f64, string] {
        claim_bincode_input(self)?;
        Result::Ok(__goml_builtin_float64_from_bits(read_fixed(self, 8)?))
    }

    fn deserialize_number(self: Decoder) -> Result[string, string] {
        Result::Err(decoder_error(self, "bincode requires a precise numeric type"))
    }

    fn deserialize_string(self: Decoder) -> Result[string, string] {
        claim_bincode_input(self)?;
        read_string(self)
    }

    fn deserialize_char(self: Decoder) -> Result[char, string] {
        claim_bincode_input(self)?;
        let value = read_unsigned(self, 32)?;
        char_from_u32(value.to_u32()).ok_or(decoder_error(self, "invalid Unicode scalar value"))
    }

    fn deserialize_bytes(self: Decoder) -> Result[Vec[byte], string] {
        claim_bincode_input(self)?;
        let length = read_length(self)?;
        let values: Vec[byte] = Vec::with_capacity(length);
        for _ in 0..length {
            values.push(read_byte(self)?);
        }
        Result::Ok(values)
    }

    fn begin_optional(self: Decoder) -> Result[bool, string] {
        claim_bincode_input(self)?;
        let tag = read_byte(self)?;
        if tag == 0 || tag == 1 {
            self.frames.push(BincodeFrame::Optional { ready: Ref::new(tag == 1) });
            Result::Ok(tag == 1)
        } else {
            Result::Err(decoder_error(self, "invalid option tag"))
        }
    }

    fn end_optional(self: Decoder) -> Result[(), string] {
        let frame = decoder_frame_index(self)?;
        match self.frames[frame] {
            BincodeFrame::Optional { ready } => if ready.get() {
                Result::Err(decoder_error(self, "optional item was not consumed"))
            } else {
                pop_decoder_frame(self);
                Result::Ok(())
            },
            _ => Result::Err(decoder_error(self, "end_optional does not match active value")),
        }
    }

    fn begin_sequence(self: Decoder) -> Result[Option[isize], string] {
        claim_bincode_input(self)?;
        let length = read_length(self)?;
        self.frames.push(
            BincodeFrame::Sequence { length, index: Ref::new(0), ready: Ref::new(false) },
        );
        Result::Ok(Option::Some(length))
    }

    fn next_sequence_element(self: Decoder) -> Result[bool, string] {
        let frame = decoder_frame_index(self)?;
        match self.frames[frame] {
            BincodeFrame::Sequence { length, index, ready } => if ready.get() {
                Result::Err(decoder_error(self, "previous sequence element was not consumed"))
            } else if index.get() >= length {
                Result::Ok(false)
            } else {
                index.set(index.get() + 1);
                ready.set(true);
                Result::Ok(true)
            },
            _ => Result::Err(decoder_error(self, "sequence element outside a sequence")),
        }
    }

    fn end_sequence(self: Decoder) -> Result[(), string] {
        let frame = decoder_frame_index(self)?;
        match self.frames[frame] {
            BincodeFrame::Sequence { length, index, ready } => if ready.get()
                || index.get() != length {
                Result::Err(decoder_error(self, "sequence ended before all elements"))
            } else {
                pop_decoder_frame(self);
                Result::Ok(())
            },
            _ => Result::Err(decoder_error(self, "end_sequence does not match active value")),
        }
    }

    fn begin_tuple(self: Decoder, length: isize) -> Result[(), string] {
        if length < 0 {
            Result::Err(decoder_error(self, "tuple length cannot be negative"))
        } else {
            claim_bincode_input(self)?;
            self.frames.push(
                BincodeFrame::Tuple { length, index: Ref::new(0), ready: Ref::new(false) },
            );
            Result::Ok(())
        }
    }

    fn begin_tuple_element(self: Decoder, index: isize) -> Result[(), string] {
        let frame = decoder_frame_index(self)?;
        match self.frames[frame] {
            BincodeFrame::Tuple { length, index: next, ready } => if ready.get()
                || index != next.get()
                || index >= length {
                Result::Err(decoder_error(self, "tuple element index is out of order"))
            } else {
                next.set(index + 1);
                ready.set(true);
                Result::Ok(())
            },
            _ => Result::Err(decoder_error(self, "tuple element outside a tuple")),
        }
    }

    fn end_tuple(self: Decoder) -> Result[(), string] {
        let frame = decoder_frame_index(self)?;
        match self.frames[frame] {
            BincodeFrame::Tuple { length, index, ready } => if ready.get() || index.get() != length {
                Result::Err(decoder_error(self, "tuple ended before all elements"))
            } else {
                pop_decoder_frame(self);
                Result::Ok(())
            },
            _ => Result::Err(decoder_error(self, "end_tuple does not match active value")),
        }
    }

    fn begin_map(self: Decoder) -> Result[Option[isize], string] {
        claim_bincode_input(self)?;
        let length = read_length(self)?;
        self.frames.push(BincodeFrame::Map { length, index: Ref::new(0), state: Ref::new(0) });
        Result::Ok(Option::Some(length))
    }

    fn next_map_entry(self: Decoder) -> Result[bool, string] {
        let frame = decoder_frame_index(self)?;
        match self.frames[frame] {
            BincodeFrame::Map { length, index, state } => {
                let next = if state.get() == 5 {
                    index.get() + 1
                } else {
                    index.get()
                };
                if state.get() != 0 && state.get() != 5 {
                    Result::Err(decoder_error(self, "previous map entry is incomplete"))
                } else if next >= length {
                    index.set(next);
                    state.set(0);
                    Result::Ok(false)
                } else {
                    index.set(next);
                    state.set(1);
                    Result::Ok(true)
                }
            },
            _ => Result::Err(decoder_error(self, "map entry outside a map")),
        }
    }

    fn begin_map_key(self: Decoder) -> Result[(), string] {
        let frame = decoder_frame_index(self)?;
        match self.frames[frame] {
            BincodeFrame::Map { length: _, index: _, state } => if state.get() != 1 {
                Result::Err(decoder_error(self, "map is not expecting a key"))
            } else {
                state.set(2);
                Result::Ok(())
            },
            _ => Result::Err(decoder_error(self, "map key outside a map")),
        }
    }

    fn begin_map_value(self: Decoder) -> Result[(), string] {
        let frame = decoder_frame_index(self)?;
        match self.frames[frame] {
            BincodeFrame::Map { length: _, index: _, state } => if state.get() != 3 {
                Result::Err(decoder_error(self, "map is not expecting a value"))
            } else {
                state.set(4);
                Result::Ok(())
            },
            _ => Result::Err(decoder_error(self, "map value outside a map")),
        }
    }

    fn end_map(self: Decoder) -> Result[(), string] {
        let frame = decoder_frame_index(self)?;
        match self.frames[frame] {
            BincodeFrame::Map { length, index, state } => {
                let next = if state.get() == 5 {
                    index.get() + 1
                } else {
                    index.get()
                };
                if next != length || state.get() != 0 && state.get() != 5 {
                    Result::Err(decoder_error(self, "map ended before all entries"))
                } else {
                    pop_decoder_frame(self);
                    Result::Ok(())
                }
            },
            _ => Result::Err(decoder_error(self, "end_map does not match active value")),
        }
    }

    fn begin_struct(self: Decoder, name: string, fields: isize) -> Result[(), string] {
        if fields < 0 {
            Result::Err(decoder_error(self, "struct field count cannot be negative"))
        } else {
            claim_bincode_input(self)?;
            self.frames.push(
                BincodeFrame::Struct { name, fields, index: Ref::new(0), ready: Ref::new(false) },
            );
            Result::Ok(())
        }
    }

    fn next_struct_field(self: Decoder) -> Result[Option[serde::FieldKey], string] {
        let frame = decoder_frame_index(self)?;
        match self.frames[frame] {
            BincodeFrame::Struct { name: _, fields, index, ready } => if ready.get() {
                Result::Err(decoder_error(self, "previous struct field was not consumed"))
            } else if index.get() >= fields {
                Result::Ok(Option::None)
            } else {
                let position = index.get();
                index.set(position + 1);
                ready.set(true);
                Result::Ok(Option::Some(serde::FieldKey::Position(position)))
            },
            _ => Result::Err(decoder_error(self, "struct field outside a struct")),
        }
    }

    fn skip_value(self: Decoder) -> Result[(), string] {
        Result::Err(decoder_error(self, "bincode cannot skip an untyped value"))
    }

    fn end_struct(self: Decoder) -> Result[(), string] {
        let frame = decoder_frame_index(self)?;
        match self.frames[frame] {
            BincodeFrame::Struct { name: _, fields, index, ready } => if ready.get()
                || index.get() != fields {
                Result::Err(decoder_error(self, "struct ended before all fields"))
            } else {
                pop_decoder_frame(self);
                Result::Ok(())
            },
            _ => Result::Err(decoder_error(self, "end_struct does not match active value")),
        }
    }

    fn begin_variant(self: Decoder, enum_name: string, variants: isize) -> Result[
        serde::VariantKey,
        string,
    ] {
        if variants < 0 {
            return Result::Err(decoder_error(self, "enum variant count cannot be negative"))
        }
        claim_bincode_input(self)?;
        let index = read_unsigned(self, 32)?;
        if index > 9223372036854775807.to_u64() {
            Result::Err(decoder_error(self, "enum variant index is too large"))
        } else {
            self.frames.push(
                BincodeFrame::Variant {
                    enum_name,
                    variant: index.to_isize(),
                    fields: Ref::new(0),
                    index: Ref::new(0),
                    begun: Ref::new(false),
                    ready: Ref::new(false),
                },
            );
            Result::Ok(serde::VariantKey::Index(index.to_isize()))
        }
    }

    fn begin_variant_fields(self: Decoder, kind: isize, fields: isize) -> Result[(), string] {
        if kind < 0 || kind > 2 || fields < 0 || kind == 0 && fields != 0 {
            return Result::Err(decoder_error(self, "invalid variant field state"))
        }
        let frame = decoder_frame_index(self)?;
        match self.frames[frame] {
            BincodeFrame::Variant {
                enum_name: _,
                variant: _,
                fields: actual_fields,
                index,
                begun,
                ready,
            } => if begun.get() {
                Result::Err(decoder_error(self, "invalid variant field state"))
            } else {
                actual_fields.set(fields);
                index.set(0);
                begun.set(true);
                ready.set(false);
                Result::Ok(())
            },
            _ => Result::Err(decoder_error(self, "variant fields outside a variant")),
        }
    }

    fn next_variant_field(self: Decoder) -> Result[Option[serde::FieldKey], string] {
        let frame = decoder_frame_index(self)?;
        match self.frames[frame] {
            BincodeFrame::Variant { enum_name: _, variant: _, fields, index, begun, ready } => if !begun.get() {
                Result::Err(decoder_error(self, "variant fields were not begun"))
            } else if ready.get() {
                Result::Err(decoder_error(self, "previous variant field was not consumed"))
            } else if index.get() >= fields.get() {
                Result::Ok(Option::None)
            } else {
                let position = index.get();
                index.set(position + 1);
                ready.set(true);
                Result::Ok(Option::Some(serde::FieldKey::Position(position)))
            },
            _ => Result::Err(decoder_error(self, "variant field outside a variant")),
        }
    }

    fn end_variant(self: Decoder) -> Result[(), string] {
        let frame = decoder_frame_index(self)?;
        match self.frames[frame] {
            BincodeFrame::Variant { enum_name: _, variant: _, fields, index, begun, ready } => if !begun.get()
                || ready.get()
                || index.get() != fields.get() {
                Result::Err(decoder_error(self, "variant ended before all fields"))
            } else {
                pop_decoder_frame(self);
                Result::Ok(())
            },
            _ => Result::Err(decoder_error(self, "end_variant does not match active value")),
        }
    }
}

pub fn decode_value(input: Slice[byte], schema: serde::Schema, config: Config) -> Result[
    (serde::Value, isize),
    string,
] {
    let decoder = bincode_deserializer(input, config);
    let value = read_schema(decoder, schema)?;
    Result::Ok((value, decoder.offset.get()))
}
