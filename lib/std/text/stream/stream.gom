package stream;

use std::text;
use std::io;
use io::Write;

pub enum ReplaceWriteError {
    Replacement(isize, text::ReplaceError),
    Write(isize, io::Error),
}

impl ReplaceWriteError {
    pub fn transferred(self: ReplaceWriteError) -> isize {
        match self {
            Replacement(count, _) => count,
            Write(count, _) => count,
        }
    }
}

impl ToString for ReplaceWriteError {
    fn to_string(self: ReplaceWriteError) -> string {
        match self {
            Replacement(count, error) => f"replacement failed after {count} written bytes: {error}",
            Write(count, error) => f"replacement write failed after {count} bytes: {error}",
        }
    }
}

impl Debug for ReplaceWriteError {
    fn debug(self: ReplaceWriteError) -> string {
        self.to_string()
    }
}

fn replacement_write_error(kind: io::ErrorKind, message: string) -> io::Error {
    io::Error::new(kind, "write replacement", Option::None, Option::None, message)
}

pub fn write_replaced[W: io::Write](
    replacer: text::Replacer,
    value: string,
    writer: W,
    max_bytes: isize,
    max_work: isize,
) -> Result[isize, ReplaceWriteError] {
    let chunks = replacer.chunks(value, max_bytes, max_work).map_err(
        |error| ReplaceWriteError::Replacement(0, error),
    )?;
    let buffer: Vec[byte] = Vec::with_capacity(4096);
    for _ in 0..4096 {
        buffer.push(0.to_u8());
    }
    let mut transferred = 0;
    for part in chunks {
        let part = part.map_err(|error| ReplaceWriteError::Replacement(transferred, error))?;
        let mut start = 0;
        while start < part.byte_len() {
            let remaining = part.byte_len() - start;
            let length = if remaining < buffer.len() {
                remaining
            } else {
                buffer.len()
            };
            for index in 0..length {
                buffer[index] = part.byte_get(start + index);
            }
            let mut offset = 0;
            while offset < length {
                let count = match writer.write(buffer.slice(offset, length)) {
                    Ok(count) => count,
                    Err(error) => return Result::Err(ReplaceWriteError::Write(transferred, error)),
                };
                if count < 0 || count > length - offset {
                    return Result::Err(
                        ReplaceWriteError::Write(
                            transferred,
                            replacement_write_error(
                                io::ErrorKind::InvalidData,
                                "writer returned an invalid byte count",
                            ),
                        ),
                    )
                }
                if count == 0 {
                    return Result::Err(
                        ReplaceWriteError::Write(
                            transferred,
                            replacement_write_error(
                                io::ErrorKind::WriteZero,
                                "writer made no progress",
                            ),
                        ),
                    )
                }
                offset += count;
                transferred += count;
            }
            start += length;
        }
    }
    Result::Ok(transferred)
}
