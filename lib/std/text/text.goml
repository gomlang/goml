package text;

use module::bytes;
use module::unicode;

pub fn fields_by_iter(value: string, separator: (char) -> bool) -> FnIterator[string] {
    let offset = Ref::new(0);
    FnIterator::from_fn(
        || {
            let mut start: Option[isize] = Option::None;
            while offset.get() < value.byte_len() {
                let index = offset.get();
                let Some((character, width)) = value.decode_at(index) else {
                    offset.set(value.byte_len());
                    return Option::None
                };
                offset.set(index + width);
                if separator(character) {
                    match start {
                        Option::Some(first) => return Option::Some(value.byte_slice(first, index)),
                        Option::None => (),
                    }
                } else if start.is_none() {
                    start = Option::Some(index);
                }
            }
            match start {
                Option::Some(first) => Option::Some(value.byte_slice(first, value.byte_len())),
                Option::None => Option::None,
            }
        },
    )
}

pub fn fields_iter(value: string) -> FnIterator[string] {
    fields_by_iter(value, |character: char| unicode::is_whitespace(character))
}

pub fn fields_by(value: string, separator: (char) -> bool, max_fields: isize) -> Result[
    Vec[string],
    bytes::TransformError,
] {
    if max_fields < 0 {
        return Result::Err(bytes::TransformError::InvalidLimit(max_fields))
    }
    let result: Vec[string] = Vec::new();
    for field in fields_by_iter(value, separator) {
        if result.len() >= max_fields {
            return Result::Err(bytes::TransformError::LimitExceeded(max_fields))
        }
        result.push(field);
    }
    Result::Ok(result)
}

pub fn fields(value: string, max_fields: isize) -> Result[Vec[string], bytes::TransformError] {
    fields_by(value, |character: char| unicode::is_whitespace(character), max_fields)
}

pub fn trim_start_by(value: string, remove: (char) -> bool) -> string {
    for (index, character) in value.char_indices() {
        if !remove(character) {
            return value.byte_slice(index, value.byte_len())
        }
    }
    ""
}

pub fn trim_end_by(value: string, remove: (char) -> bool) -> string {
    let mut end = value.byte_len();
    while end > 0 {
        let mut start = end - 1;
        while !value.is_char_boundary(start) {
            start -= 1;
        }
        let Some((character, _)) = value.decode_at(start) else {
            break
        };
        if !remove(character) {
            break
        }
        end = start;
    }
    value.byte_slice(0, end)
}

pub fn trim_by(value: string, remove: (char) -> bool) -> string {
    trim_end_by(trim_start_by(value, remove), remove)
}

pub fn trim_space(value: string) -> string {
    trim_by(value, |character: char| unicode::is_whitespace(character))
}

pub fn trim_chars(value: string, characters: string) -> string {
    let set = scalar_set(characters);
    trim_by(value, |character: char| set.contains(character))
}

fn scalar_set(characters: string) -> HashMap[char, bool] {
    let set: HashMap[char, bool] = HashMap::new();
    for character in characters.chars() {
        set.set(character, true);
    }
    set
}

pub fn trim_start_chars(value: string, characters: string) -> string {
    let set = scalar_set(characters);
    trim_start_by(value, |character: char| set.contains(character))
}

pub fn trim_end_chars(value: string, characters: string) -> string {
    let set = scalar_set(characters);
    trim_end_by(value, |character: char| set.contains(character))
}

pub fn find_by(value: string, predicate: (char) -> bool) -> Option[isize] {
    for (index, character) in value.char_indices() {
        if predicate(character) {
            return Option::Some(index)
        }
    }
    Option::None
}

pub fn rfind_by(value: string, predicate: (char) -> bool) -> Option[isize] {
    let mut end = value.byte_len();
    while end > 0 {
        let mut start = end - 1;
        while !value.is_char_boundary(start) {
            start -= 1;
        }
        let Some((character, _)) = value.decode_at(start) else {
            break
        };
        if predicate(character) {
            return Option::Some(start)
        }
        end = start;
    }
    Option::None
}

pub fn find_char(value: string, character: char) -> Option[isize] {
    find(value, character.to_string())
}

pub fn rfind_char(value: string, character: char) -> Option[isize] {
    rfind(value, character.to_string())
}

pub fn find_any(value: string, characters: string) -> Option[isize] {
    if characters.byte_len() == 0 {
        return Option::None
    }
    let set = scalar_set(characters);
    find_by(value, |character: char| set.contains(character))
}

pub fn rfind_any(value: string, characters: string) -> Option[isize] {
    if characters.byte_len() == 0 {
        return Option::None
    }
    let set = scalar_set(characters);
    rfind_by(value, |character: char| set.contains(character))
}

pub fn contains_any(value: string, characters: string) -> bool {
    find_any(value, characters).is_some()
}

pub fn equal_fold(left: string, right: string) -> bool {
    let first = left.chars();
    let second = right.chars();
    loop {
        match (first.next(), second.next()) {
            (Option::None, Option::None) => return true,
            (Option::Some(a), Option::Some(b)) => {
                if a != b {
                    let mut next = unicode::simple_fold(a);
                    while next != a && next != b {
                        next = unicode::simple_fold(next);
                    }
                    if next != b {
                        return false
                    }
                }
            },
            _ => return false,
        }
    }
}

pub struct Finder {
    pattern: string,
    fallback: Vec[isize],
}

impl Finder {
    pub fn new(pattern: string) -> Finder {
        let fallback: Vec[isize] = Vec::new();
        let mut matched = 0;
        for index in 0..pattern.byte_len() {
            if index > 0 {
                while matched > 0 && pattern.byte_get(index) != pattern.byte_get(matched) {
                    matched = fallback[matched - 1];
                }
                if pattern.byte_get(index) == pattern.byte_get(matched) {
                    matched += 1;
                }
            }
            fallback.push(matched);
        }
        Finder { pattern, fallback }
    }

    fn search(self: Finder, value: string, start: isize, last: bool) -> Option[isize] {
        if self.pattern.byte_len() == 0 {
            return Option::Some(
                if last {
                    value.byte_len()
                } else {
                    start
                },
            )
        }
        let mut matched = 0;
        let mut result: Option[isize] = Option::None;
        for index in start..value.byte_len() {
            while matched > 0 && value.byte_get(index) != self.pattern.byte_get(matched) {
                matched = self.fallback[matched - 1];
            }
            if value.byte_get(index) == self.pattern.byte_get(matched) {
                matched += 1;
            }
            if matched == self.pattern.byte_len() {
                let offset = index - matched + 1;
                if !last {
                    return Option::Some(offset)
                }
                result = Option::Some(offset);
                matched = self.fallback[matched - 1];
            }
        }
        result
    }

    pub fn find(self: Finder, value: string) -> Option[isize] {
        self.search(value, 0, false)
    }

    pub fn rfind(self: Finder, value: string) -> Option[isize] {
        self.search(value, 0, true)
    }

    pub fn contains(self: Finder, value: string) -> bool {
        self.find(value).is_some()
    }
}

pub fn starts_with_at(value: string, start: isize, prefix: string) -> bool {
    value.starts_with_at(start, prefix)
}

pub fn find(value: string, expected: string) -> Option[isize] {
    Finder::new(expected).find(value)
}

pub fn find_bytes(value: string, expected: string) -> Option[isize] {
    find(value, expected)
}

pub fn char_indices(value: string) -> FnIterator[(isize, char)] {
    value.char_indices()
}

pub fn char_count(value: string) -> isize {
    value.char_count()
}

pub fn slice_chars(value: string, start: isize, end: isize) -> Option[string] {
    value.slice_chars(start, end)
}

pub fn rfind(value: string, expected: string) -> Option[isize] {
    Finder::new(expected).rfind(value)
}

pub fn count(value: string, pattern: string) -> Result[isize, bytes::TransformError] {
    let mut found = 0;
    if pattern.byte_len() == 0 {
        found = value.char_count();
        if found == 9223372036854775807 {
            return Result::Err(bytes::TransformError::LengthOverflow)
        }
        return Result::Ok(found + 1)
    }
    let finder = Finder::new(pattern);
    let mut offset = 0;
    loop {
        match finder.search(value, offset, false) {
            Option::None => break,
            Option::Some(index) => {
                found += 1;
                offset = index + pattern.byte_len();
            },
        }
    }
    Result::Ok(found)
}

pub fn cut(value: string, separator: string) -> Option[(string, string)] {
    match find(value, separator) {
        Option::Some(index) => Option::Some(
            (
                value.byte_slice(0, index),
                value.byte_slice(index + separator.byte_len(), value.byte_len()),
            ),
        ),
        Option::None => Option::None,
    }
}

pub fn cut_prefix(value: string, prefix: string) -> Option[string] {
    if value.starts_with_at(0, prefix) {
        Option::Some(value.byte_slice(prefix.byte_len(), value.byte_len()))
    } else {
        Option::None
    }
}

pub fn cut_suffix(value: string, suffix: string) -> Option[string] {
    let start = value.byte_len() - suffix.byte_len();
    if value.starts_with_at(start, suffix) {
        Option::Some(value.byte_slice(0, start))
    } else {
        Option::None
    }
}

fn split_iterator(value: string, separator: string, after: bool) -> FnIterator[string] {
    let finder = Finder::new(separator);
    let offset = Ref::new(0);
    let done = Ref::new(false);
    FnIterator::from_fn(
        || {
            if done.get() {
                return Option::None
            }
            let start = offset.get();
            if separator.byte_len() == 0 {
                done.set(true);
                return Option::Some(value)
            }
            match finder.search(value, start, false) {
                Option::None => {
                    done.set(true);
                    Option::Some(value.byte_slice(start, value.byte_len()))
                },
                Option::Some(index) => {
                    let end = index + separator.byte_len();
                    offset.set(end);
                    Option::Some(
                        value.byte_slice(
                            start,
                            if after {
                                end
                            } else {
                                index
                            },
                        ),
                    )
                },
            }
        },
    )
}

pub fn split_iter(value: string, separator: string) -> FnIterator[string] {
    split_iterator(value, separator, false)
}

pub fn split_after_iter(value: string, separator: string) -> FnIterator[string] {
    split_iterator(value, separator, true)
}

fn push_text_part(parts: Vec[string], part: string, limit: isize) -> Result[
    (),
    bytes::TransformError,
] {
    if parts.len() >= limit {
        return Result::Err(bytes::TransformError::LimitExceeded(limit))
    }
    parts.push(part);
    Result::Ok(())
}

fn split_checked_parts(
    value: string,
    separator: string,
    count: isize,
    max_parts: isize,
    after: bool,
) -> Result[Vec[string], bytes::TransformError] {
    check_output_limit(max_parts)?;
    let result: Vec[string] = Vec::new();
    if count == 0 {
        return Result::Ok(result)
    }
    let mut offset = 0;
    if separator.byte_len() == 0 {
        while offset < value.byte_len() {
            if count > 0 && result.len() == count - 1 {
                push_text_part(result, value.byte_slice(offset, value.byte_len()), max_parts)?;
                break
            }
            let Some((_, width)) = value.decode_at(offset) else {
                break
            };
            let end = offset + width;
            push_text_part(result, value.byte_slice(offset, end), max_parts)?;
            offset = end;
        }
    } else {
        let finder = Finder::new(separator);
        let maximum = if count < 0 {
            -1
        } else {
            count - 1
        };
        for index in match_positions(value, finder, maximum) {
            let end = index + separator.byte_len();
            push_text_part(
                result,
                value.byte_slice(
                    offset,
                    if after {
                        end
                    } else {
                        index
                    },
                ),
                max_parts,
            )?;
            offset = end;
        }
        push_text_part(result, value.byte_slice(offset, value.byte_len()), max_parts)?;
    }
    Result::Ok(result)
}

pub fn split_n_checked(value: string, separator: string, count: isize, max_parts: isize) -> Result[
    Vec[string],
    bytes::TransformError,
] {
    split_checked_parts(value, separator, count, max_parts, false)
}

pub fn split_after_n_checked(value: string, separator: string, count: isize, max_parts: isize) -> Result[
    Vec[string],
    bytes::TransformError,
] {
    split_checked_parts(value, separator, count, max_parts, true)
}

pub fn split_checked(value: string, separator: string, max_parts: isize) -> Result[
    Vec[string],
    bytes::TransformError,
] {
    split_checked_parts(value, separator, -1, max_parts, false)
}

pub fn split_after_checked(value: string, separator: string, max_parts: isize) -> Result[
    Vec[string],
    bytes::TransformError,
] {
    split_checked_parts(value, separator, -1, max_parts, true)
}

pub fn lines_inclusive_iter(value: string) -> FnIterator[string] {
    let parts = split_after_iter(value, "\n");
    FnIterator::from_fn(
        || {
            match parts.next() {
                Option::Some(part) => if part.byte_len() > 0 {
                    Option::Some(part)
                } else {
                    Option::None
                },
                Option::None => Option::None,
            }
        },
    )
}

pub fn lines_iter(value: string) -> FnIterator[string] {
    let parts = lines_inclusive_iter(value);
    FnIterator::from_fn(
        || {
            match parts.next() {
                Option::Some(part) => {
                    let without_lf = cut_suffix(part, "\n").unwrap_or(part);
                    Option::Some(cut_suffix(without_lf, "\r").unwrap_or(without_lf))
                },
                Option::None => Option::None,
            }
        },
    )
}

pub fn trim_start(value: string) -> string {
    value.trim_start()
}

pub fn trim_end(value: string) -> string {
    value.trim_end()
}

pub fn trim(value: string) -> string {
    value.trim()
}

pub fn split(value: string, separator: string) -> Vec[string] {
    value.split(separator)
}

pub fn split_once(value: string, separator: string) -> Option[(string, string)] {
    value.split_once(separator)
}

pub fn lines(value: string) -> Vec[string] {
    value.lines()
}

pub fn replace(value: string, expected: string, replacement: string) -> string {
    value.replace(expected, replacement)
}

pub fn join(values: Vec[string], separator: string) -> string {
    values.join(separator)
}

pub fn repeat(value: string, count: isize) -> string {
    value.repeat(count)
}

const TEXT_MAX: isize = 9223372036854775807;

fn check_output_limit(limit: isize) -> Result[(), bytes::TransformError] {
    if limit < 0 {
        Result::Err(bytes::TransformError::InvalidLimit(limit))
    } else {
        Result::Ok(())
    }
}

fn checked_length(current: isize, additional: isize, limit: isize) -> Result[
    isize,
    bytes::TransformError,
] {
    if additional > TEXT_MAX - current {
        return Result::Err(bytes::TransformError::LengthOverflow)
    }
    let length = current + additional;
    if length > limit {
        Result::Err(bytes::TransformError::LimitExceeded(limit))
    } else {
        Result::Ok(length)
    }
}

pub fn clone_checked(value: string, max_bytes: isize) -> Result[string, bytes::TransformError] {
    check_output_limit(max_bytes)?;
    let length = checked_length(0, value.byte_len(), max_bytes)?;
    let output = StringBuilder::with_capacity(length);
    output.write_string(value);
    Result::Ok(output.finish())
}

pub fn join_checked(values: Vec[string], separator: string, max_bytes: isize) -> Result[
    string,
    bytes::TransformError,
] {
    check_output_limit(max_bytes)?;
    let mut length = 0;
    for index in 0..values.len() {
        if index > 0 {
            length = checked_length(length, separator.byte_len(), max_bytes)?;
        }
        length = checked_length(length, values[index].byte_len(), max_bytes)?;
    }
    let output = StringBuilder::with_capacity(length);
    for index in 0..values.len() {
        if index > 0 {
            output.write_string(separator);
        }
        output.write_string(values[index]);
    }
    Result::Ok(output.finish())
}

pub fn repeat_checked(value: string, count: isize, max_bytes: isize) -> Result[
    string,
    bytes::TransformError,
] {
    check_output_limit(max_bytes)?;
    if count < 0 {
        return Result::Err(bytes::TransformError::InvalidCount(count))
    }
    if value.byte_len() > 0 && count > TEXT_MAX / value.byte_len() {
        return Result::Err(bytes::TransformError::LengthOverflow)
    }
    let length = checked_length(0, value.byte_len() * count, max_bytes)?;
    let output = StringBuilder::with_capacity(length);
    if length > 0 {
        for _ in 0..count {
            output.write_string(value);
        }
    }
    Result::Ok(output.finish())
}

fn match_positions(value: string, finder: Finder, maximum: isize) -> FnIterator[isize] {
    let offset = Ref::new(0);
    let remaining = Ref::new(maximum);
    let done = Ref::new(maximum == 0);
    FnIterator::from_fn(
        || {
            if done.get() || remaining.get() == 0 {
                return Option::None
            }
            if remaining.get() > 0 {
                remaining.set(remaining.get() - 1);
            }
            if finder.pattern.byte_len() == 0 {
                let index = offset.get();
                match value.decode_at(index) {
                    Option::Some((_, width)) => offset.set(index + width),
                    Option::None => done.set(true),
                }
                Option::Some(index)
            } else {
                match finder.search(value, offset.get(), false) {
                    Option::Some(index) => {
                        offset.set(index + finder.pattern.byte_len());
                        Option::Some(index)
                    },
                    Option::None => {
                        done.set(true);
                        Option::None
                    },
                }
            }
        },
    )
}

pub fn replace_n_checked(
    value: string,
    old: string,
    replacement: string,
    maximum: isize,
    max_bytes: isize,
) -> Result[string, bytes::TransformError] {
    check_output_limit(max_bytes)?;
    let finder = Finder::new(old);
    let mut matches = 0;
    for _ in match_positions(value, finder, maximum) {
        if matches == TEXT_MAX {
            return Result::Err(bytes::TransformError::LengthOverflow)
        }
        matches += 1;
    }
    let mut length = value.byte_len();
    if replacement.byte_len() > old.byte_len() {
        let growth = replacement.byte_len() - old.byte_len();
        if matches > (TEXT_MAX - length) / growth {
            return Result::Err(bytes::TransformError::LengthOverflow)
        }
        length += matches * growth;
    } else {
        length -= matches * (old.byte_len() - replacement.byte_len());
    }
    checked_length(0, length, max_bytes)?;
    let output = StringBuilder::with_capacity(length);
    let mut offset = 0;
    for index in match_positions(value, finder, maximum) {
        output.write_string(value.byte_slice(offset, index));
        output.write_string(replacement);
        offset = index + old.byte_len();
    }
    output.write_string(value.byte_slice(offset, value.byte_len()));
    Result::Ok(output.finish())
}

pub fn replace_checked(value: string, old: string, replacement: string, max_bytes: isize) -> Result[
    string,
    bytes::TransformError,
] {
    replace_n_checked(value, old, replacement, -1, max_bytes)
}

pub fn map_chars(value: string, transform: (char) -> Option[char], max_bytes: isize) -> Result[
    string,
    bytes::TransformError,
] {
    check_output_limit(max_bytes)?;
    let output = StringBuilder::new();
    for character in value.chars() {
        match transform(character) {
            Option::None => (),
            Option::Some(mapped) => {
                let encoded = mapped.to_string();
                checked_length(output.len(), encoded.byte_len(), max_bytes)?;
                output.write_string(encoded);
            },
        }
    }
    Result::Ok(output.finish())
}

pub fn case_checked(value: string, kind: unicode::Case, max_bytes: isize) -> Result[
    string,
    bytes::TransformError,
] {
    map_chars(value, |character: char| Option::Some(unicode::to_case(character, kind)), max_bytes)
}

pub fn case_with_checked(
    value: string,
    special: unicode::SpecialCase,
    kind: unicode::Case,
    max_bytes: isize,
) -> Result[string, bytes::TransformError] {
    map_chars(value, |character: char| Option::Some(special.to_case(character, kind)), max_bytes)
}

pub fn is_ascii(value: string) -> bool {
    value.is_ascii()
}

pub fn eq_ignore_ascii_case(left: string, right: string) -> bool {
    left.eq_ignore_ascii_case(right)
}

pub fn to_ascii_lowercase(value: string) -> string {
    value.to_ascii_lowercase()
}

pub fn to_ascii_uppercase(value: string) -> string {
    value.to_ascii_uppercase()
}
