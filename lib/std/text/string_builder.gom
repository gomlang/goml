package text;

use module::bytes;
use module::utf8;
use utf8::BytesUtf8;

pub struct StringBuilder {
    pub values: Vec[byte],
}

impl StringBuilder {
    pub fn new() -> StringBuilder {
        StringBuilder { values: Vec::new() }
    }

    pub fn with_capacity(capacity: isize) -> StringBuilder {
        StringBuilder { values: Vec::with_capacity(capacity) }
    }

    pub fn len(self: StringBuilder) -> isize {
        self.values.len()
    }

    pub fn capacity(self: StringBuilder) -> isize {
        self.values.capacity()
    }

    pub fn reserve_checked(self: StringBuilder, additional: isize, max_bytes: isize) -> Result[
        (),
        bytes::TransformError,
    ] {
        check_output_limit(max_bytes)?;
        if additional < 0 {
            return Result::Err(bytes::TransformError::InvalidCount(additional))
        }
        checked_length(self.len(), additional, max_bytes)?;
        self.values.reserve(additional);
        Result::Ok(())
    }

    pub fn is_empty(self: StringBuilder) -> bool {
        self.values.is_empty()
    }

    pub fn write_string(self: StringBuilder, value: string) -> () {
        let length = value.byte_len();
        self.values.reserve(length);
        for index in 0..length {
            self.values.push(value.byte_get(index))
        }
    }

    pub fn write_char(self: StringBuilder, value: char) -> () {
        self.write_string(value.to_string())
    }

    pub fn write_string_checked(self: StringBuilder, value: string, max_bytes: isize) -> Result[
        (),
        bytes::TransformError,
    ] {
        check_output_limit(max_bytes)?;
        checked_length(self.len(), value.byte_len(), max_bytes)?;
        self.write_string(value);
        Result::Ok(())
    }

    pub fn write_char_checked(self: StringBuilder, value: char, max_bytes: isize) -> Result[
        (),
        bytes::TransformError,
    ] {
        self.write_string_checked(value.to_string(), max_bytes)
    }

    pub fn write_line_checked(self: StringBuilder, value: string, max_bytes: isize) -> Result[
        (),
        bytes::TransformError,
    ] {
        check_output_limit(max_bytes)?;
        let length = checked_length(self.len(), value.byte_len(), max_bytes)?;
        checked_length(length, 1, max_bytes)?;
        self.write_line(value);
        Result::Ok(())
    }

    pub fn write_bytes(self: StringBuilder, value: bytes::Bytes) -> Result[(), utf8::Utf8Error] {
        match value.to_string_utf8() {
            Ok(text) => {
                self.write_string(text);
                Result::Ok(())
            },
            Err(error) => Result::Err(error),
        }
    }

    pub fn write_line(self: StringBuilder, value: string) -> () {
        self.write_string(value);
        self.write_string("\n")
    }

    pub fn clear(self: StringBuilder) -> () {
        self.values.clear()
    }

    pub fn finish(self: StringBuilder) -> string {
        let (_, value) = string_from_utf8(self.values);
        value
    }
}

impl ToString for StringBuilder {
    fn to_string(self: StringBuilder) -> string {
        self.finish()
    }
}
