package tests;

fn text_reference_bytes_last_index(input: Slice[byte], pattern: Slice[byte]) -> isize {
    let mut index = input.len() - pattern.len();
    while index >= 0 {
        if text_reference_bytes_at(input, pattern, index) {
            return index
        }
        index -= 1;
    };
    -1
}

fn text_reference_bytes_at(input: Slice[byte], pattern: Slice[byte], start: isize) -> bool {
    if start < 0 || start + pattern.len() > input.len() {
        return false
    }
    for index in 0..pattern.len() {
        if input[start + index] != pattern[index] {
            return false
        }
    }
    true
}

fn text_reference_bytes_index(input: Slice[byte], pattern: Slice[byte]) -> isize {
    for index in 0..input.len() - pattern.len() + 1 {
        if text_reference_bytes_at(input, pattern, index) {
            return index
        }
    };
    -1
}

fn text_reference_bytes_split_after_n(input: Slice[byte], separator: Slice[byte], count: isize) -> Vec[
    Vec[byte],
] {
    text_reference_bytes_split(input, separator, count, true)
}

fn text_reference_bytes_split(input: Slice[byte], separator: Slice[byte], count: isize, after: bool) -> Vec[
    Vec[byte],
] {
    let result: Vec[Vec[byte]] = Vec::new();
    if count == 0 {
        return result
    }
    let mut start = 0;
    let mut index = 0;
    while index <= input.len() && (count < 0 || result.len() < count - 1) {
        if separator.len() == 0 {
            if index == input.len() {
                break
            }
            index += text_reference_decode_rune(input.sub(index, input.len())).1;
            result.push(input.sub(start, index).to_vec());
            start = index;
        } else if text_reference_bytes_at(input, separator, index) {
            let end = if after {
                index + separator.len()
            } else {
                index
            };
            result.push(input.sub(start, end).to_vec());
            index += separator.len();
            start = index;
        } else {
            index += 1;
        }
    }
    if separator.len() != 0 || start < input.len() {
        result.push(input.sub(start, input.len()).to_vec());
    }
    result
}

fn text_reference_bytes_split_n(input: Slice[byte], separator: Slice[byte], count: isize) -> Vec[
    Vec[byte],
] {
    text_reference_bytes_split(input, separator, count, false)
}

fn text_reference_bytes_repeat(input: Slice[byte], count: isize) -> Vec[byte] {
    let output: Vec[byte] = Vec::new();
    for _ in 0..count {
        for value in input {
            output.push(value);
        }
    }
    output
}

fn text_reference_bytes_replace(
    input: Slice[byte],
    old: Slice[byte],
    replacement: Slice[byte],
    count: isize,
) -> Vec[byte] {
    let output: Vec[byte] = Vec::new();
    let mut index = 0;
    let mut used = 0;
    while index <= input.len() {
        if (count < 0 || used < count) && text_reference_bytes_at(input, old, index) {
            for value in replacement {
                output.push(value);
            }
            used += 1;
            if old.len() > 0 {
                index += old.len();
                continue
            }
            if index == input.len() {
                break
            }
            let width = text_reference_decode_rune(input.sub(index, input.len())).1;
            for at in index..index + width {
                output.push(input[at]);
            }
            index += width;
        } else {
            if index == input.len() {
                break
            }
            output.push(input[index]);
            index += 1;
        }
    }
    output
}

fn text_reference_bytes_last_index_byte(input: Slice[byte], value: byte) -> isize {
    let mut index = input.len();
    while index > 0 {
        index -= 1;
        if input[index] == value {
            return index
        }
    };
    -1
}

fn text_reference_bytes_index_byte(input: Slice[byte], value: byte) -> isize {
    for index in 0..input.len() {
        if input[index] == value {
            return index
        }
    };
    -1
}

fn text_reference_byte_lines(input: Slice[byte]) -> Vec[Vec[byte]] {
    let lines: Vec[Vec[byte]] = Vec::new();
    let mut start = 0;
    for index in 0..input.len() {
        if input[index] == b'\n' {
            lines.push(input.sub(start, index + 1).to_vec());
            start = index + 1;
        }
    }
    if start < input.len() {
        lines.push(input.sub(start, input.len()).to_vec());
    }
    lines
}

fn text_reference_bytes_suffix(input: Slice[byte], pattern: Slice[byte]) -> bool {
    text_reference_bytes_at(input, pattern, input.len() - pattern.len())
}

fn text_reference_bytes_prefix(input: Slice[byte], pattern: Slice[byte]) -> bool {
    text_reference_bytes_at(input, pattern, 0)
}

fn text_reference_bytes_count(input: Slice[byte], pattern: Slice[byte]) -> isize {
    if pattern.len() == 0 {
        return text_reference_rune_count(input) + 1
    }
    let mut total = 0;
    let mut index = 0;
    while index + pattern.len() <= input.len() {
        if text_reference_bytes_at(input, pattern, index) {
            total += 1;
            index += pattern.len();
        } else {
            index += 1;
        }
    }
    total
}
