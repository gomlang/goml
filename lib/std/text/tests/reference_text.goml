package tests;

use std::testing;
use std::utf8;

fn text_reference_text_last_index(value: string, pattern: string) -> isize {
    text_reference_bytes_last_index(
        text_reference_text_bytes(value),
        text_reference_text_bytes(pattern),
    )
}

fn text_reference_text_bytes(value: string) -> Slice[byte] {
    value.to_bytes().as_slice()
}

fn text_reference_text_trim_end_chars(value: string, characters: string) -> string {
    text_reference_text_string(
        text_reference_byte_trim_end_chars(text_reference_text_bytes(value), characters),
    )
}

fn text_reference_text_string(value: Vec[byte]) -> string {
    testing::expect_ok(utf8::decode_slice(value.as_slice()), "reference string")
}

fn text_reference_text_find_char(value: string, character: char) -> isize {
    text_reference_text_index(value, character.to_string())
}

fn text_reference_text_index(value: string, pattern: string) -> isize {
    text_reference_bytes_index(text_reference_text_bytes(value), text_reference_text_bytes(pattern))
}

fn text_reference_text_find_any(value: string, characters: string) -> isize {
    text_reference_byte_find_any(text_reference_text_bytes(value), characters)
}

fn text_reference_text_find_by(value: string) -> isize {
    text_reference_byte_find_predicate(
        text_reference_text_bytes(value),
        text_reference_text_separator,
        false,
    )
}

fn text_reference_text_separator(value: char) -> bool {
    value == ',' || value == '界' || value == '🙂'
}

fn text_reference_text_trim_start_chars(value: string, characters: string) -> string {
    text_reference_text_string(
        text_reference_byte_trim_start_chars(text_reference_text_bytes(value), characters),
    )
}

fn text_reference_text_rfind_any(value: string, characters: string) -> isize {
    text_reference_byte_rfind_any(text_reference_text_bytes(value), characters)
}

fn text_reference_text_split_after_n(value: string, separator: string, count: isize) -> Vec[string] {
    text_reference_text_parts(
        text_reference_bytes_split_after_n(
            text_reference_text_bytes(value),
            text_reference_text_bytes(separator),
            count,
        ),
    )
}

fn text_reference_text_parts(parts: Vec[Vec[byte]]) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    for part in parts {
        result.push(text_reference_text_string(part));
    }
    result
}

fn text_reference_text_split_n(value: string, separator: string, count: isize) -> Vec[string] {
    text_reference_text_parts(
        text_reference_bytes_split_n(
            text_reference_text_bytes(value),
            text_reference_text_bytes(separator),
            count,
        ),
    )
}

fn text_reference_text_rfind_by(value: string) -> isize {
    text_reference_byte_find_predicate(
        text_reference_text_bytes(value),
        text_reference_text_separator,
        true,
    )
}

fn text_reference_text_lines(value: string) -> Vec[string] {
    text_reference_text_parts(text_reference_byte_lines(text_reference_text_bytes(value)))
}

fn text_reference_text_split_after(value: string, separator: string) -> Vec[string] {
    text_reference_text_split_after_n(value, separator, -1)
}

fn text_reference_text_cut(value: string, pattern: string) -> (string, string, bool) {
    let index = text_reference_text_index(value, pattern);
    if index < 0 {
        (value, "", false)
    } else {
        (
            value.byte_slice(0, index),
            value.byte_slice(index + pattern.byte_len(), value.byte_len()),
            true,
        )
    }
}

fn text_reference_text_trim_suffix(value: string, pattern: string) -> string {
    if text_reference_text_has_suffix(value, pattern) {
        value.byte_slice(0, value.byte_len() - pattern.byte_len())
    } else {
        value
    }
}

fn text_reference_text_has_suffix(value: string, pattern: string) -> bool {
    text_reference_bytes_suffix(
        text_reference_text_bytes(value),
        text_reference_text_bytes(pattern),
    )
}

fn text_reference_text_has_prefix(value: string, pattern: string) -> bool {
    text_reference_bytes_prefix(
        text_reference_text_bytes(value),
        text_reference_text_bytes(pattern),
    )
}

fn text_reference_text_cut_prefix(value: string, pattern: string) -> (string, bool) {
    (
        text_reference_text_trim_prefix(value, pattern),
        text_reference_text_has_prefix(value, pattern),
    )
}

fn text_reference_text_trim_prefix(value: string, pattern: string) -> string {
    if text_reference_text_has_prefix(value, pattern) {
        value.byte_slice(pattern.byte_len(), value.byte_len())
    } else {
        value
    }
}

fn text_reference_text_cut_suffix(value: string, pattern: string) -> (string, bool) {
    (
        text_reference_text_trim_suffix(value, pattern),
        text_reference_text_has_suffix(value, pattern),
    )
}

fn text_reference_text_split(value: string, separator: string) -> Vec[string] {
    text_reference_text_split_n(value, separator, -1)
}

fn text_reference_text_count(value: string, pattern: string) -> isize {
    text_reference_bytes_count(text_reference_text_bytes(value), text_reference_text_bytes(pattern))
}

fn text_reference_text_compare(left: string, right: string) -> isize {
    let mut index = 0;
    while index < left.byte_len() && index < right.byte_len() {
        if left.byte_get(index) < right.byte_get(index) {
            return -1
        }
        if left.byte_get(index) > right.byte_get(index) {
            return 1
        }
        index += 1;
    }
    if left.byte_len() < right.byte_len() {
        -1
    } else if left.byte_len() > right.byte_len() {
        1
    } else {
        0
    }
}
