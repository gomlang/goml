package tests;

use std::text;

#[test]
fn line_index_clamps_large_unicode_columns() -> () {
    let source = "é🙂\r\n界\n";
    let index = text::LineIndex::new(source);
    for encoding in[
        text::PositionEncoding::Utf8,
        text::PositionEncoding::Utf16,
        text::PositionEncoding::Utf32,
    ] {
        let position = text::LineColumn { line: 0, column: 9223372036854775807 };
        assert_equal(index.line_column_to_offset(position, encoding), 6);
        assert_equal(index.line_column_to_offset_checked(position, encoding), Option::None);
        assert_equal(
            index.line_column_to_offset(
                text::LineColumn { line: 1, column: 9223372036854775807 },
                encoding,
            ),
            11,
        );
        assert_equal(
            index.line_column_to_offset(text::LineColumn { line: 2, column: 0 }, encoding),
            source.byte_len(),
        );
    }
    assert_equal(
        index.line_column_to_offset_checked(
            text::LineColumn { line: 0, column: 2 },
            text::PositionEncoding::Utf16,
        ),
        Option::None,
    );
    assert_equal(
        index.line_column_to_offset_checked(
            text::LineColumn { line: 0, column: 3 },
            text::PositionEncoding::Utf16,
        ),
        Option::Some(6),
    );
    assert_equal(
        index.line_column_to_offset_checked(
            text::LineColumn { line: 0, column: 2 },
            text::PositionEncoding::Utf32,
        ),
        Option::Some(6),
    );
}
