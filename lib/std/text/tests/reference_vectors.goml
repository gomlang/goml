package tests;

use std::json;
use std::fs;
use std::num;
use std::testing;

fn text_expected_quoted_prefix(data: TextReferenceData, value: string) -> (string, bool) {
    let value = text_reference_value(
        data,
        "text_expected_quoted_prefix;" + text_reference_key_string(value),
    );
    (
        text_reference_value_string(text_reference_value_array(value)[0]),
        text_reference_value_bool(text_reference_value_array(value)[1]),
    )
}

fn text_reference_value_array(value: json::Value) -> Vec[json::Value] {
    testing::expect_some(json::as_array(value), "reference array value")
}

fn text_reference_value(data: TextReferenceData, key: string) -> json::Value {
    testing::expect_some(data.values.get(key), key)
}

struct TextReferenceData {
    values: HashMap[string, json::Value],
}

fn load_text_reference_data() -> TextReferenceData {
    let source = testing::expect_ok(
        fs::read_file_structured("text/tests/reference_vectors.json"),
        "read fixed reference vectors",
    );
    let parsed = testing::expect_ok(json::parse(source), "parse fixed reference vectors");
    let values: HashMap[string, json::Value] = HashMap::new();
    match parsed {
        json::Value::Object(entries) => {
            for entry in entries {
                values.set(entry.0, entry.1);
            }
        },
        _ => testing::fail("expected fixed reference object"),
    }
    TextReferenceData { values }
}

fn text_reference_key_string(value: string) -> string {
    let mut result = "s";
    for item in value.to_bytes() {
        result += text_reference_hex(item.to_u32(), 2);
    }
    result + ";"
}

fn text_reference_value_bool(value: json::Value) -> bool {
    testing::expect_some(json::as_bool(value), "reference boolean value")
}

fn text_reference_value_string(value: json::Value) -> string {
    let encoded = text_reference_json_text(value);
    let output: Vec[byte] = Vec::new();
    let mut index = 0;
    while index < encoded.byte_len() {
        let digit = |value: byte| if value <= b'9' {
            value - b'0'
        } else {
            value - b'a' + 10
        };
        output.push(digit(encoded.byte_get(index)) * 16 + digit(encoded.byte_get(index + 1)));
        index += 2;
    }
    string_from_utf8(output).1
}

fn text_reference_json_text(value: json::Value) -> string {
    testing::expect_some(json::as_string(value), "reference string value")
}

fn text_expected_unquote(data: TextReferenceData, value: string) -> (Vec[byte], bool) {
    let value = text_reference_value(
        data,
        "text_expected_unquote;" + text_reference_key_string(value),
    );
    (
        text_reference_value_bytes(text_reference_value_array(value)[0]),
        text_reference_value_bool(text_reference_value_array(value)[1]),
    )
}

fn text_reference_value_bytes(value: json::Value) -> Vec[byte] {
    let output: Vec[byte] = Vec::new();
    for item in text_reference_value_array(value) {
        output.push(text_reference_value_number(item).to_u8());
    }
    output
}

fn text_reference_value_number(value: json::Value) -> isize {
    testing::expect_ok(
        num::parse_int_structured(text_reference_json_text(value)),
        "reference integer value",
    )
}

fn text_expected_unquote_element(data: TextReferenceData, value: string, delimiter: byte) -> (
    u32,
    bool,
    string,
    bool,
) {
    let value = text_reference_value(
        data,
        "text_expected_unquote_element;" + text_reference_key_string(value) + delimiter.to_string()
            + ";",
    );
    (
        text_reference_value_number(text_reference_value_array(value)[0]).to_u32(),
        text_reference_value_bool(text_reference_value_array(value)[1]),
        text_reference_value_string(text_reference_value_array(value)[2]),
        text_reference_value_bool(text_reference_value_array(value)[3]),
    )
}

fn text_expected_append_conversions(
    data: TextReferenceData,
    prefix: string,
    signed: i64,
    unsigned: u64,
    floating: f64,
    flag: bool,
    value: string,
) -> string {
    let value = text_reference_value(
        data,
        "text_expected_append_conversions;" + text_reference_key_string(prefix) + signed.to_string()
            + ";"
            + unsigned.to_string()
            + ";"
            + float64_to_bits(floating).to_string()
            + ";"
            + flag.to_string()
            + ";"
            + text_reference_key_string(value),
    );
    text_reference_value_string(value)
}

fn text_expected_replace_many(
    data: TextReferenceData,
    value: string,
    old: Slice[string],
    replacement: Slice[string],
) -> string {
    let value = text_reference_value(
        data,
        "text_expected_replace_many;" + text_reference_key_string(value)
            + text_reference_key_strings(old)
            + text_reference_key_strings(replacement),
    );
    text_reference_value_string(value)
}

fn text_reference_key_strings(value: Slice[string]) -> string {
    let mut result = "[";
    for item in value {
        result += text_reference_key_string(item);
    }
    result + "];"
}

fn text_expected_replace_scalar_many(
    data: TextReferenceData,
    value: string,
    old: Slice[string],
    replacement: Slice[string],
) -> string {
    let value = text_reference_value(
        data,
        "text_expected_replace_scalar_many;" + text_reference_key_string(value)
            + text_reference_key_strings(old)
            + text_reference_key_strings(replacement),
    );
    text_reference_value_string(value)
}

fn text_expected_legacy_word_title(data: TextReferenceData, value: string) -> string {
    let value = text_reference_value(
        data,
        "text_expected_legacy_word_title;" + text_reference_key_string(value),
    );
    text_reference_value_string(value)
}

fn text_expected_scalar_title(data: TextReferenceData, value: string) -> string {
    let value = text_reference_value(
        data,
        "text_expected_scalar_title;" + text_reference_key_string(value),
    );
    text_reference_value_string(value)
}
