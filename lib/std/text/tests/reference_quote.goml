package tests;

use std::unicode;

fn text_reference_quote(value: string) -> string {
    text_reference_quote_string(value, false, false)
}

fn text_reference_quote_string(value: string, ascii: bool, graphic: bool) -> string {
    let mut result = "\"";
    for character in value.chars() {
        result += text_reference_quote_scalar(character, '"', ascii, graphic);
    }
    result + "\""
}

fn text_reference_quote_scalar(value: char, delimiter: char, ascii: bool, graphic: bool) -> string {
    if value == delimiter || value == '\\' {
        return "\\" + value.to_string()
    }
    match value {
        '\u0007' => "\\a",
        '\u0008' => "\\b",
        '\u000c' => "\\f",
        '\n' => "\\n",
        '\r' => "\\r",
        '\t' => "\\t",
        '\u000b' => "\\v",
        _ => {
            let code = value.to_u32();
            let printable = unicode::is_printable(value) || (graphic && unicode::is_graphic(value));
            if printable && (!ascii || code < 128) {
                value.to_string()
            } else if code < 32 || code == 127 {
                "\\x" + text_reference_hex(code, 2)
            } else if code < 65536 {
                "\\u" + text_reference_hex(code, 4)
            } else {
                "\\U" + text_reference_hex(code, 8)
            }
        },
    }
}

fn text_reference_hex(value: u32, width: isize) -> string {
    let alphabet = "0123456789abcdef";
    let mut result = "";
    for index in 0..width {
        let digit = (value >> ((width - index - 1) * 4).to_u32()) & 15;
        result += alphabet.byte_slice(digit.to_isize(), digit.to_isize() + 1);
    }
    result
}

fn text_reference_can_backquote(value: string) -> bool {
    for character in value.chars() {
        let code = character.to_u32();
        if (code < 32 && character != '\t') || code == 127 || character == '`' || code == 0xfeff {
            return false
        }
    }
    true
}

fn text_reference_quote_ascii(value: string) -> string {
    text_reference_quote_string(value, true, false)
}

fn text_reference_quote_graphic(value: string) -> string {
    text_reference_quote_string(value, false, true)
}

fn text_reference_quote_char_graphic(value: char) -> string {
    "'" + text_reference_quote_scalar(value, '\'', false, true) + "'"
}

fn text_reference_quote_char(value: char) -> string {
    "'" + text_reference_quote_scalar(value, '\'', false, false) + "'"
}

fn text_reference_quote_char_ascii(value: char) -> string {
    "'" + text_reference_quote_scalar(value, '\'', true, false) + "'"
}

fn text_reference_unquote_valid(input: Slice[byte]) -> bool {
    text_reference_valid_utf8(input)
}
