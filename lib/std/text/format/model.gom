package format;

use module::text;
use module::num;

#[derive(ToString, Debug, PartialEq, Eq)]
pub enum Error {
    InvalidLimit,
    InvalidSpec(string),
    ConversionFailure(string),
    LengthOverflow,
    LimitExceeded(isize),
}

#[derive(ToString, Debug, PartialEq, Eq)]
pub enum Alignment {
    Left,
    Right,
    Center,
}

#[derive(ToString, Debug, PartialEq, Eq)]
pub struct Padding {
    pub width: isize,
    pub alignment: Alignment,
    pub fill: char,
}

impl Padding {
    pub fn plain() -> Padding {
        Padding { width: 0, alignment: Alignment::Right, fill: ' ' }
    }
}

#[derive(ToString, Debug, PartialEq, Eq)]
pub enum TextStyle {
    Plain,
    Quoted,
    QuotedAscii,
}

#[derive(PartialEq, Eq)]
pub struct TextSpec {
    pub padding: Padding,
    pub max_chars: Option[isize],
    pub style: TextStyle,
}

impl TextSpec {
    pub fn plain() -> TextSpec {
        TextSpec { padding: Padding::plain(), max_chars: Option::None, style: TextStyle::Plain }
    }
}

#[derive(ToString, Debug, PartialEq, Eq)]
pub enum Sign {
    NegativeOnly,
    Always,
    Space,
}

#[derive(ToString, Debug, PartialEq, Eq)]
pub struct IntSpec {
    pub padding: Padding,
    pub radix: isize,
    pub uppercase: bool,
    pub alternate: bool,
    pub sign: Sign,
    pub min_digits: isize,
}

impl IntSpec {
    pub fn plain() -> IntSpec {
        IntSpec {
            padding: Padding::plain(),
            radix: 10,
            uppercase: false,
            alternate: false,
            sign: Sign::NegativeOnly,
            min_digits: 0,
        }
    }
}

pub enum FloatStyle {
    Shortest(num::FloatNotation),
    Fixed(isize),
    Scientific(isize, bool),
    General(isize, bool),
    Binary,
    Hex(isize, bool),
}

pub struct FloatSpec {
    pub padding: Padding,
    pub sign: Sign,
    pub style: FloatStyle,
}

impl FloatSpec {
    pub fn plain() -> FloatSpec {
        FloatSpec {
            padding: Padding::plain(),
            sign: Sign::NegativeOnly,
            style: FloatStyle::Shortest(num::FloatNotation::General),
        }
    }
}

pub struct Formatter {
    builder: text::StringBuilder,
    max_bytes: isize,
}

impl Formatter {
    pub fn new(max_bytes: isize) -> Result[Formatter, Error] {
        if max_bytes < 0 {
            return Result::Err(Error::InvalidLimit)
        }
        Result::Ok(Formatter { builder: text::StringBuilder::new(), max_bytes })
    }

    pub fn len(self: Formatter) -> isize {
        self.builder.len()
    }

    pub fn remaining(self: Formatter) -> isize {
        self.max_bytes - self.builder.len()
    }

    pub fn finish(self: Formatter) -> string {
        self.builder.finish()
    }
}
