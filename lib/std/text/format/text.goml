package format;

use module::text;
use module::bytes;

fn validate_padding(padding: Padding) -> Result[(), Error] {
    if padding.width < 0 {
        Result::Err(Error::InvalidSpec("padding width must be non-negative"))
    } else {
        Result::Ok(())
    }
}

fn text_transform_error(error: bytes::TransformError, limit: isize) -> Error {
    match error {
        InvalidLimit(_) => Error::InvalidLimit,
        InvalidCount(_) => Error::InvalidSpec("text count must be non-negative"),
        LengthOverflow => Error::LengthOverflow,
        LimitExceeded(_) => Error::LimitExceeded(limit),
    }
}

fn text_prefix(value: string, max_chars: Option[isize]) -> string {
    let Some(max_chars) = max_chars else {
        return value
    };
    let mut count = 0;
    for (index, _) in value.char_indices() {
        if count == max_chars {
            return value.byte_slice(0, index)
        }
        count += 1;
    }
    value
}

impl Formatter {
    fn commit_field(self: Formatter, value: string, padding: Padding) -> Result[(), Error] {
        validate_padding(padding)?;
        let mut scalars = 0;
        for _ in value.chars() {
            scalars += 1;
        }
        let count = if padding.width > scalars {
            padding.width - scalars
        } else {
            0
        };
        let fill = padding.fill.to_string();
        if count > 9223372036854775807 / fill.byte_len() {
            return Result::Err(Error::LengthOverflow)
        }
        let padding_bytes = count * fill.byte_len();
        if value.byte_len() > 9223372036854775807 - padding_bytes {
            return Result::Err(Error::LengthOverflow)
        }
        let field_bytes = value.byte_len() + padding_bytes;
        if self.len() > 9223372036854775807 - field_bytes {
            return Result::Err(Error::LengthOverflow)
        }
        if field_bytes > self.remaining() {
            return Result::Err(Error::LimitExceeded(self.max_bytes))
        }
        let before = match padding.alignment {
            Left => 0,
            Right => count,
            Center => count / 2,
        };
        for _ in 0..before {
            self.builder.write_string(fill);
        }
        self.builder.write_string(value);
        for _ in 0..(count - before) {
            self.builder.write_string(fill);
        }
        Result::Ok(())
    }

    pub fn literal(self: Formatter, value: string) -> Result[(), Error] {
        self.commit_field(value, Padding::plain())
    }

    pub fn text(self: Formatter, value: string, spec: TextSpec) -> Result[(), Error] {
        validate_padding(spec.padding)?;
        if let Some(max_chars) = spec.max_chars {
            if max_chars < 0 {
                return Result::Err(Error::InvalidSpec("text character limit must be non-negative"))
            }
        }
        let value = text_prefix(value, spec.max_chars);
        let rendered = match spec.style {
            Plain => value,
            Quoted => text::quote(value, self.remaining()).map_err(
                |error| text_transform_error(error, self.max_bytes),
            )?,
            QuotedAscii => text::quote_ascii(value, self.remaining()).map_err(
                |error| text_transform_error(error, self.max_bytes),
            )?,
        };
        self.commit_field(rendered, spec.padding)
    }

    pub fn display[T: ToString](self: Formatter, value: T, padding: Padding) -> Result[(), Error] {
        validate_padding(padding)?;
        self.commit_field(value.to_string(), padding)
    }

    pub fn debug[T: Debug](self: Formatter, value: T, padding: Padding) -> Result[(), Error] {
        validate_padding(padding)?;
        self.commit_field(value.debug(), padding)
    }
}
