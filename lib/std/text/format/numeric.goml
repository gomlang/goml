package format;

use module::num;

fn validate_integer(spec: IntSpec) -> Result[(), Error] {
    validate_padding(spec.padding)?;
    if spec.min_digits < 0 {
        return Result::Err(Error::InvalidSpec("negative integer minimum digits"))
    }
    if spec.radix < 2 || spec.radix > 36 {
        return Result::Err(Error::InvalidSpec("integer radix must be between 2 and 36"))
    }
    if spec.alternate && spec.radix != 2 && spec.radix != 8 && spec.radix != 16 {
        return Result::Err(Error::InvalidSpec("alternate integer radix must be 2, 8 or 16"))
    }
    Result::Ok(())
}

fn validate_float(spec: FloatSpec) -> Result[(), Error] {
    validate_padding(spec.padding)?;
    let valid = match spec.style {
        FloatStyle::Fixed(precision) => precision >= 0,
        FloatStyle::Scientific(precision, _) => precision >= 0,
        FloatStyle::General(precision, _) => precision >= 0,
        FloatStyle::Hex(precision, _) => precision >= -1,
        _ => true,
    };
    if !valid {
        return Result::Err(Error::InvalidSpec("invalid floating-point precision"))
    }
    Result::Ok(())
}

fn numeric_sign(negative: bool, sign: Sign) -> string {
    if negative {
        return "-"
    }
    match sign {
        Sign::NegativeOnly => "",
        Sign::Always => "+",
        Sign::Space => " ",
    }
}

fn numeric_append(output: Vec[byte], value: string) -> () {
    let mut index = 0;
    while index < value.byte_len() {
        output.push(value.byte_get(index));
        index += 1;
    }
}

fn numeric_float_error(error: num::FormatFloatError, limit: isize) -> Error {
    match error {
        num::FormatFloatError::InvalidLimit(_) => Error::InvalidLimit,
        num::FormatFloatError::InvalidPrecision(_) => Error::InvalidSpec(error.to_string()),
        num::FormatFloatError::OutputLimit(_) => Error::LimitExceeded(limit),
        num::FormatFloatError::RoundtripFailure => Error::ConversionFailure(error.to_string()),
    }
}

impl Formatter {
    fn commit_integer(self: Formatter, encoded: string, negative: bool, spec: IntSpec) -> Result[
        (),
        Error,
    ] {
        let start = if negative {
            1
        } else {
            0
        };
        let digits = encoded.byte_len() - start;
        let width = if spec.min_digits > digits {
            spec.min_digits
        } else {
            digits
        };
        let sign = numeric_sign(negative, spec.sign);
        let prefix = if spec.alternate {
            match spec.radix {
                2 => if spec.uppercase {
                    "0B"
                } else {
                    "0b"
                },
                8 => if spec.uppercase {
                    "0O"
                } else {
                    "0o"
                },
                _ => if spec.uppercase {
                    "0X"
                } else {
                    "0x"
                },
            }
        } else {
            ""
        };
        let overhead = sign.byte_len() + prefix.byte_len();
        if width > 9223372036854775807 - overhead {
            return Result::Err(Error::LengthOverflow)
        }
        let length = overhead + width;
        if length > self.remaining() {
            return Result::Err(Error::LimitExceeded(self.max_bytes))
        }
        let output: Vec[byte] = Vec::with_capacity(length);
        numeric_append(output, sign);
        numeric_append(output, prefix);
        let mut zeros = width - digits;
        while zeros > 0 {
            output.push(b'0');
            zeros -= 1;
        }
        let mut index = start;
        while index < encoded.byte_len() {
            let digit = encoded.byte_get(index);
            output.push(
                if spec.uppercase && digit >= b'a' && digit <= b'z' {
                    digit - b'a' + b'A'
                } else {
                    digit
                },
            );
            index += 1;
        }
        self.commit_field(string_from_utf8(output).1, spec.padding)
    }

    pub fn integer(self: Formatter, value: i64, spec: IntSpec) -> Result[(), Error] {
        validate_integer(spec)?;
        let encoded = num::format_int(value, spec.radix).map_err(
            |error: num::FormatIntError| Error::InvalidSpec(error.to_string()),
        )?;
        self.commit_integer(encoded, value < 0, spec)
    }

    pub fn unsigned(self: Formatter, value: u64, spec: IntSpec) -> Result[(), Error] {
        validate_integer(spec)?;
        let encoded = num::format_uint(value, spec.radix).map_err(
            |error: num::FormatIntError| Error::InvalidSpec(error.to_string()),
        )?;
        self.commit_integer(encoded, false, spec)
    }

    fn commit_float(self: Formatter, encoded: string, spec: FloatSpec) -> Result[(), Error] {
        let signed = encoded.byte_len() > 0
            && (encoded.byte_get(0) == b'-' || encoded.byte_get(0) == b'+');
        let sign = if signed {
            ""
        } else {
            numeric_sign(false, spec.sign)
        };
        if encoded.byte_len() > 9223372036854775807 - sign.byte_len() {
            return Result::Err(Error::LengthOverflow)
        }
        let length = encoded.byte_len() + sign.byte_len();
        if length > self.remaining() {
            return Result::Err(Error::LimitExceeded(self.max_bytes))
        }
        if sign.byte_len() == 0 {
            return self.commit_field(encoded, spec.padding)
        }
        let output: Vec[byte] = Vec::with_capacity(length);
        numeric_append(output, sign);
        numeric_append(output, encoded);
        self.commit_field(string_from_utf8(output).1, spec.padding)
    }

    pub fn float32(self: Formatter, value: f32, spec: FloatSpec) -> Result[(), Error] {
        validate_float(spec)?;
        let limit = self.remaining();
        let encoded = match spec.style {
            FloatStyle::Shortest(notation) => num::format_float32_shortest(value, notation, limit),
            FloatStyle::Fixed(precision) => num::format_float32_fixed(value, precision, limit),
            FloatStyle::Scientific(precision, uppercase) => num::format_float32_scientific(
                value,
                precision,
                uppercase,
                limit,
            ),
            FloatStyle::General(precision, uppercase) => num::format_float32_general(
                value,
                precision,
                uppercase,
                limit,
            ),
            FloatStyle::Binary => num::format_float32_binary(value, limit),
            FloatStyle::Hex(precision, uppercase) => num::format_float32_hex(
                value,
                precision,
                uppercase,
                limit,
            ),
        }.map_err(|error: num::FormatFloatError| numeric_float_error(error, self.max_bytes))?;
        self.commit_float(encoded, spec)
    }

    pub fn float64(self: Formatter, value: f64, spec: FloatSpec) -> Result[(), Error] {
        validate_float(spec)?;
        let limit = self.remaining();
        let encoded = match spec.style {
            FloatStyle::Shortest(notation) => num::format_float64_shortest(value, notation, limit),
            FloatStyle::Fixed(precision) => num::format_float64_fixed(value, precision, limit),
            FloatStyle::Scientific(precision, uppercase) => num::format_float64_scientific(
                value,
                precision,
                uppercase,
                limit,
            ),
            FloatStyle::General(precision, uppercase) => num::format_float64_general(
                value,
                precision,
                uppercase,
                limit,
            ),
            FloatStyle::Binary => num::format_float64_binary(value, limit),
            FloatStyle::Hex(precision, uppercase) => num::format_float64_hex(
                value,
                precision,
                uppercase,
                limit,
            ),
        }.map_err(|error: num::FormatFloatError| numeric_float_error(error, self.max_bytes))?;
        self.commit_float(encoded, spec)
    }
}
