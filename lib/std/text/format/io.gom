package format;

use module::io;
use io::Write;

pub fn write_to[W: io::Write](writer: W, value: string) -> Result[usize, io::TransferError] {
    let input = value.to_bytes();
    let mut offset = 0;
    while offset < input.len() {
        let remaining = input.len() - offset;
        let count = writer.write(input.slice(offset, input.len())).map_err(
            |error| io::TransferError::new(offset.to_usize(), error),
        )?;
        let failure = if count < 0 || count > remaining {
            Option::Some((io::ErrorKind::InvalidData, "invalid byte count returned by writer"))
        } else if count == 0 {
            Option::Some((io::ErrorKind::WriteZero, "writer made no progress"))
        } else {
            Option::None
        };
        if let Some((kind, message)) = failure {
            return Result::Err(
                io::TransferError::new(
                    offset.to_usize(),
                    io::Error::new(kind, "format write", Option::None, Option::None, message),
                ),
            )
        }
        offset += count;
    }
    Result::Ok(offset.to_usize())
}
