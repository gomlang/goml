package iter;

pub fn empty[T]() -> FnIterator[T] {
    FnIterator::from_fn(|| Option::None)
}

pub fn once[T](value: T) -> FnIterator[T] {
    let remaining = Ref::new(Option::Some(value));
    FnIterator::from_fn(
        || {
            let current = remaining.get();
            remaining.set(Option::None);
            current
        },
    )
}

pub fn from_fn[T](next_fn: () -> Option[T]) -> FnIterator[T] {
    FnIterator::from_fn(next_fn)
}

pub fn map[A, B, I: Iterator](iterator: I, map_fn: (A) -> B) -> FnIterator[B] where I::Item = A {
    FnIterator::from_fn(
        || {
            iterator.next().map(|value| map_fn(value))
        },
    )
}

pub fn filter[T, I: Iterator](iterator: I, predicate: (T) -> bool) -> FnIterator[T]
where
    I::Item = T,
{
    FnIterator::from_fn(
        || {
            while let Some(value) = iterator.next() {
                if predicate(value) {
                    return Option::Some(value)
                }
            }
            Option::None
        },
    )
}

pub fn filter_map[A, B, I: Iterator](iterator: I, map_fn: (A) -> Option[B]) -> FnIterator[B]
where
    I::Item = A,
{
    FnIterator::from_fn(
        || {
            while let Some(value) = iterator.next() {
                if let Some(mapped) = map_fn(value) {
                    return Option::Some(mapped)
                }
            }
            Option::None
        },
    )
}

pub fn take[I: Iterator](iterator: I, count: isize) -> FnIterator[I::Item] {
    let remaining = Ref::new(
        if count > 0 {
            count
        } else {
            0
        },
    );
    FnIterator::from_fn(
        || {
            if remaining.get() == 0 {
                Option::None
            } else {
                remaining.set(remaining.get() - 1);
                iterator.next()
            }
        },
    )
}

pub fn take_while[T, I: Iterator](iterator: I, predicate: (T) -> bool) -> FnIterator[T]
where
    I::Item = T,
{
    let done = Ref::new(false);
    FnIterator::from_fn(
        || {
            if done.get() {
                Option::None
            } else {
                match iterator.next() {
                    Some(value) => if predicate(value) {
                        Option::Some(value)
                    } else {
                        done.set(true);
                        Option::None
                    },
                    None => {
                        done.set(true);
                        Option::None
                    },
                }
            }
        },
    )
}

pub fn skip[I: Iterator](iterator: I, count: isize) -> FnIterator[I::Item] {
    let remaining = Ref::new(
        if count > 0 {
            count
        } else {
            0
        },
    );
    FnIterator::from_fn(
        || {
            while remaining.get() > 0 {
                match iterator.next() {
                    Some(_) => remaining.set(remaining.get() - 1),
                    None => {
                        remaining.set(0);
                        return Option::None
                    },
                }
            }
            iterator.next()
        },
    )
}

pub fn skip_while[T, I: Iterator](iterator: I, predicate: (T) -> bool) -> FnIterator[T]
where
    I::Item = T,
{
    let skipping = Ref::new(true);
    FnIterator::from_fn(
        || {
            while let Some(value) = iterator.next() {
                if skipping.get() && predicate(value) {} else {
                    skipping.set(false);
                    return Option::Some(value)
                }
            }
            Option::None
        },
    )
}

pub fn enumerate[I: Iterator](iterator: I) -> FnIterator[(isize, I::Item)] {
    let index = Ref::new(0);
    FnIterator::from_fn(
        || {
            match iterator.next() {
                Some(value) => {
                    let current = index.get();
                    index.set(current + 1);
                    Option::Some((current, value))
                },
                None => Option::None,
            }
        },
    )
}

pub fn zip[A: Iterator, B: Iterator](left: A, right: B) -> FnIterator[(A::Item, B::Item)] {
    FnIterator::from_fn(
        || {
            left.next().and_then(
                |left_value| right.next().map(|right_value| (left_value, right_value)),
            )
        },
    )
}

pub fn chain[T, A: Iterator, B: Iterator](first: A, second: B) -> FnIterator[T]
where
    A::Item = T,
    B::Item = T,
{
    let first_done = Ref::new(false);
    FnIterator::from_fn(
        || {
            if !first_done.get() {
                match first.next() {
                    Some(value) => return Option::Some(value),
                    None => first_done.set(true),
                }
            }
            second.next()
        },
    )
}

pub fn inspect[T, I: Iterator](iterator: I, action: (T) -> ()) -> FnIterator[T] where I::Item = T {
    FnIterator::from_fn(
        || {
            match iterator.next() {
                Some(value) => {
                    action(value);
                    Option::Some(value)
                },
                None => Option::None,
            }
        },
    )
}

pub fn map_while[A, B, I: Iterator](iterator: I, map_fn: (A) -> Option[B]) -> FnIterator[B]
where
    I::Item = A,
{
    let done = Ref::new(false);
    FnIterator::from_fn(
        || {
            if done.get() {
                Option::None
            } else {
                match iterator.next() {
                    Some(value) => match map_fn(value) {
                        Some(mapped) => Option::Some(mapped),
                        None => {
                            done.set(true);
                            Option::None
                        },
                    },
                    None => {
                        done.set(true);
                        Option::None
                    },
                }
            }
        },
    )
}

pub fn fold[T, A, I: Iterator](iterator: I, initial: A, combine: (A, T) -> A) -> A
where
    I::Item = T,
{
    let mut accumulator = initial;
    while let Some(value) = iterator.next() {
        accumulator = combine(accumulator, value);
    }
    accumulator
}

pub fn collect[T, I: Iterator](iterator: I) -> Vec[T] where I::Item = T {
    let values = Vec::new();
    while let Some(value) = iterator.next() {
        values.push(value)
    }
    values
}

pub fn find[T, I: Iterator](iterator: I, predicate: (T) -> bool) -> Option[T] where I::Item = T {
    while let Some(value) = iterator.next() {
        if predicate(value) {
            return Option::Some(value)
        }
    }
    Option::None
}

pub fn find_map[A, B, I: Iterator](iterator: I, map_fn: (A) -> Option[B]) -> Option[B]
where
    I::Item = A,
{
    while let Some(value) = iterator.next() {
        if let Some(mapped) = map_fn(value) {
            return Option::Some(mapped)
        }
    }
    Option::None
}

pub fn any[T, I: Iterator](iterator: I, predicate: (T) -> bool) -> bool where I::Item = T {
    find(iterator, predicate).is_some()
}

pub fn all[T, I: Iterator](iterator: I, predicate: (T) -> bool) -> bool where I::Item = T {
    !any(iterator, |value: T| !predicate(value))
}

pub fn count[I: Iterator](iterator: I) -> isize {
    let mut result = 0;
    while let Some(_) = iterator.next() {
        result += 1;
    }
    result
}

pub fn position[T, I: Iterator](iterator: I, predicate: (T) -> bool) -> Option[isize]
where
    I::Item = T,
{
    let mut index = 0;
    while let Some(value) = iterator.next() {
        if predicate(value) {
            return Option::Some(index)
        } else {
            index += 1;
        }
    }
    Option::None
}

pub fn nth[I: Iterator](iterator: I, index: isize) -> Option[I::Item] {
    if index < 0 {
        Option::None
    } else {
        let mut current = 0;
        while let Some(value) = iterator.next() {
            if current == index {
                return Option::Some(value)
            } else {
                current += 1;
            }
        }
        Option::None
    }
}

pub fn last[I: Iterator](iterator: I) -> Option[I::Item] {
    let mut result = Option::None;
    while let Some(value) = iterator.next() {
        result = Option::Some(value);
    }
    result
}

pub fn for_each[T, I: Iterator](iterator: I, action: (T) -> ()) -> () where I::Item = T {
    while let Some(value) = iterator.next() {
        action(value)
    }
}

pub fn reduce[T, I: Iterator](iterator: I, combine: (T, T) -> T) -> Option[T] where I::Item = T {
    let Some(first) = iterator.next() else {
        return Option::None;
    };
    Option::Some(fold(iterator, first, combine))
}
