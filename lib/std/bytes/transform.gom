package bytes;

const TRANSFORM_MAX: isize = 9223372036854775807;

pub enum TransformError {
    InvalidLimit(isize),
    InvalidCount(isize),
    LimitExceeded(isize),
    LengthOverflow,
}

impl ToString for TransformError {
    fn to_string(self: TransformError) -> string {
        match self {
            TransformError::InvalidLimit(limit) => f"negative byte transformation limit {limit}",
            TransformError::InvalidCount(count) => f"negative transformation count {count}",
            TransformError::LimitExceeded(limit) => f"byte transformation exceeds limit {limit}",
            TransformError::LengthOverflow => "byte transformation length overflows isize",
        }
    }
}

impl Debug for TransformError {
    fn debug(self: TransformError) -> string {
        self.to_string()
    }
}

fn boundary_width(input: Slice[byte], offset: isize) -> isize {
    let first = input[offset];
    let width = if first >= 0xc2 && first <= 0xdf {
        2
    } else if first >= 0xe0 && first <= 0xef {
        3
    } else if first >= 0xf0 && first <= 0xf4 {
        4
    } else {
        return 1
    };
    if width > input.len() - offset {
        return 1
    }
    for index in 1..width {
        let next = input[offset + index];
        if next < 0x80 || next > 0xbf {
            return 1
        }
        if index == 1
            && ((first == 0xe0 && next < 0xa0) || (first == 0xed && next > 0x9f)
                || (first == 0xf0 && next < 0x90)
                || (first == 0xf4 && next > 0x8f)) {
            return 1
        }
    }
    width
}

fn add_length(total: isize, additional: isize) -> Result[isize, TransformError] {
    if additional > TRANSFORM_MAX - total {
        Result::Err(TransformError::LengthOverflow)
    } else {
        Result::Ok(total + additional)
    }
}

fn check_limit(limit: isize) -> Result[(), TransformError] {
    if limit < 0 {
        Result::Err(TransformError::InvalidLimit(limit))
    } else {
        Result::Ok(())
    }
}

fn output_length(length: isize, limit: isize) -> Result[isize, TransformError] {
    if length > limit {
        Result::Err(TransformError::LimitExceeded(limit))
    } else {
        Result::Ok(length)
    }
}

fn count_matches(input: Slice[byte], finder: Finder, maximum: isize) -> Result[
    isize,
    TransformError,
] {
    let mut found = 0;
    let mut offset = 0;
    while maximum < 0 || found < maximum {
        if finder.pattern.is_empty() {
            found = add_length(found, 1)?;
            if offset == input.len() {
                break
            }
            offset += boundary_width(input, offset);
        } else {
            match finder.find(input.sub(offset, input.len())) {
                Option::None => break,
                Option::Some(index) => {
                    found = add_length(found, 1)?;
                    offset += index + finder.pattern.len();
                },
            }
        }
    }
    Result::Ok(found)
}

pub fn count(input: Slice[byte], pattern: Slice[byte]) -> Result[isize, TransformError] {
    count_matches(input, Finder::new(pattern), -1)
}

fn push_part(parts: Vec[Slice[byte]], part: Slice[byte], limit: isize) -> Result[(), TransformError] {
    if parts.len() >= limit {
        return Result::Err(TransformError::LimitExceeded(limit))
    }
    parts.push(part);
    Result::Ok(())
}

fn split_iterator(input: Slice[byte], separator: Slice[byte], count: isize, after: bool) -> FnIterator[
    Slice[byte],
] {
    let finder = Finder::new(separator);
    let offset = Ref::new(0);
    let remaining = Ref::new(count);
    let done = Ref::new(count == 0);
    FnIterator::from_fn(
        || {
            if done.get() {
                return Option::None
            }
            let start = offset.get();
            let width = finder.pattern.len();
            if width == 0 && start == input.len() {
                done.set(true);
                return Option::None
            }
            let parts_left = remaining.get();
            if parts_left > 0 {
                remaining.set(parts_left - 1);
            }
            if parts_left == 1 {
                done.set(true);
                return Option::Some(input.sub(start, input.len()))
            }
            if width == 0 {
                let end = start + boundary_width(input, start);
                offset.set(end);
                return Option::Some(input.sub(start, end))
            }
            match finder.find(input.sub(start, input.len())) {
                Option::None => {
                    done.set(true);
                    Option::Some(input.sub(start, input.len()))
                },
                Option::Some(index) => {
                    let end = start + index;
                    offset.set(end + width);
                    Option::Some(
                        input.sub(
                            start,
                            if after {
                                end + width
                            } else {
                                end
                            },
                        ),
                    )
                },
            }
        },
    )
}

pub fn split_iter(input: Slice[byte], separator: Slice[byte]) -> FnIterator[Slice[byte]] {
    split_iterator(input, separator, -1, false)
}

pub fn split_after_iter(input: Slice[byte], separator: Slice[byte]) -> FnIterator[Slice[byte]] {
    split_iterator(input, separator, -1, true)
}

pub fn lines_iter(input: Slice[byte]) -> FnIterator[Slice[byte]] {
    let separator = Vec::from_array([b'\n']);
    let parts = split_after_iter(input, separator.as_slice());
    FnIterator::from_fn(
        || {
            match parts.next() {
                Option::Some(part) => if part.len() > 0 {
                    Option::Some(part)
                } else {
                    Option::None
                },
                Option::None => Option::None,
            }
        },
    )
}

fn split_parts(input: Slice[byte], separator: Slice[byte], count: isize, limit: isize, after: bool) -> Result[
    Vec[Slice[byte]],
    TransformError,
] {
    check_limit(limit)?;
    let result: Vec[Slice[byte]] = Vec::new();
    if count == 0 {
        return Result::Ok(result)
    }
    for part in split_iterator(input, separator, count, after) {
        push_part(result, part, limit)?;
    }
    Result::Ok(result)
}

pub fn split(input: Slice[byte], separator: Slice[byte], max_parts: isize) -> Result[
    Vec[Slice[byte]],
    TransformError,
] {
    split_parts(input, separator, -1, max_parts, false)
}

pub fn split_n(input: Slice[byte], separator: Slice[byte], count: isize, max_parts: isize) -> Result[
    Vec[Slice[byte]],
    TransformError,
] {
    split_parts(input, separator, count, max_parts, false)
}

pub fn split_after(input: Slice[byte], separator: Slice[byte], max_parts: isize) -> Result[
    Vec[Slice[byte]],
    TransformError,
] {
    split_parts(input, separator, -1, max_parts, true)
}

pub fn split_after_n(input: Slice[byte], separator: Slice[byte], count: isize, max_parts: isize) -> Result[
    Vec[Slice[byte]],
    TransformError,
] {
    split_parts(input, separator, count, max_parts, true)
}

pub fn join(parts: Vec[Slice[byte]], separator: Slice[byte], max_bytes: isize) -> Result[
    Bytes,
    TransformError,
] {
    check_limit(max_bytes)?;
    let mut length = 0;
    for index in 0..parts.len() {
        if index > 0 {
            length = add_length(length, separator.len())?;
        }
        length = add_length(length, parts[index].len())?;
        output_length(length, max_bytes)?;
    }
    let result = Builder::with_capacity(length);
    for index in 0..parts.len() {
        if index > 0 {
            result.extend(separator);
        }
        result.extend(parts[index]);
    }
    Result::Ok(result.finish())
}

pub fn repeat(input: Slice[byte], count: isize, max_bytes: isize) -> Result[Bytes, TransformError] {
    check_limit(max_bytes)?;
    if count < 0 {
        return Result::Err(TransformError::InvalidCount(count))
    }
    if input.len() > 0 && count > TRANSFORM_MAX / input.len() {
        return Result::Err(TransformError::LengthOverflow)
    }
    let length = output_length(input.len() * count, max_bytes)?;
    let result = Builder::with_capacity(length);
    if length > 0 {
        for _ in 0..count {
            result.extend(input);
        }
    }
    Result::Ok(result.finish())
}

pub fn replace_n(
    input: Slice[byte],
    old: Slice[byte],
    replacement: Slice[byte],
    maximum: isize,
    max_bytes: isize,
) -> Result[Bytes, TransformError] {
    check_limit(max_bytes)?;
    let finder = Finder::new(old);
    let matches = count_matches(input, finder, maximum)?;
    let mut length = input.len();
    if replacement.len() > old.len() {
        let growth = replacement.len() - old.len();
        if matches > (TRANSFORM_MAX - length) / growth {
            return Result::Err(TransformError::LengthOverflow)
        }
        length += matches * growth;
    } else {
        length -= matches * (old.len() - replacement.len());
    }
    output_length(length, max_bytes)?;
    let result = Builder::with_capacity(length);
    let mut offset = 0;
    for index in 0..matches {
        let start = if old.len() == 0 {
            if index > 0 {
                offset + boundary_width(input, offset)
            } else {
                offset
            }
        } else {
            offset + finder.find(input.sub(offset, input.len())).unwrap_or(0)
        };
        result.extend(input.sub(offset, start));
        result.extend(replacement);
        offset = start + old.len();
    }
    result.extend(input.sub(offset, input.len()));
    Result::Ok(result.finish())
}

pub fn replace(input: Slice[byte], old: Slice[byte], replacement: Slice[byte], max_bytes: isize) -> Result[
    Bytes,
    TransformError,
] {
    replace_n(input, old, replacement, -1, max_bytes)
}

pub fn replace_invalid_utf8(input: Slice[byte], replacement: Slice[byte], max_bytes: isize) -> Result[
    Bytes,
    TransformError,
] {
    check_limit(max_bytes)?;
    let mut offset = 0;
    let mut length = 0;
    let mut invalid = false;
    while offset < input.len() {
        let width = boundary_width(input, offset);
        let malformed = width == 1 && input[offset] >= 0x80;
        let additional = if malformed {
            if invalid {
                0
            } else {
                replacement.len()
            }
        } else {
            width
        };
        length = output_length(add_length(length, additional)?, max_bytes)?;
        invalid = malformed;
        offset += width;
    }
    let result = Builder::with_capacity(length);
    offset = 0;
    invalid = false;
    while offset < input.len() {
        let width = boundary_width(input, offset);
        let malformed = width == 1 && input[offset] >= 0x80;
        if malformed {
            if !invalid {
                result.extend(replacement);
            }
        } else {
            result.extend(input.sub(offset, offset + width));
        }
        invalid = malformed;
        offset += width;
    }
    Result::Ok(result.finish())
}
