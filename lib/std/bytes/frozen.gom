package bytes;

pub struct FrozenBytes {
    values: FrozenVec[byte],
    offset: isize,
    length: isize,
}

impl FrozenBytes {
    pub fn new() -> FrozenBytes {
        Bytes::new().freeze()
    }

    pub fn from_vec_copy(values: Vec[byte]) -> FrozenBytes {
        Bytes::from_vec(values).freeze()
    }

    pub fn from_slice_copy(values: Slice[byte]) -> FrozenBytes {
        Bytes::from_slice_copy(values).freeze()
    }

    pub fn from_string(value: string) -> FrozenBytes {
        Bytes::from_string(value).freeze()
    }

    pub fn len(self: FrozenBytes) -> isize {
        self.length
    }

    pub fn is_empty(self: FrozenBytes) -> bool {
        self.length == 0
    }

    pub fn get_checked(self: FrozenBytes, index: isize) -> Option[byte] {
        if index < 0 || index >= self.length {
            Option::None
        } else {
            Option::Some(self.values.get(self.offset + index))
        }
    }

    pub fn slice_checked(self: FrozenBytes, start: isize, end: isize) -> Option[FrozenBytes] {
        if start < 0 || end < start || end > self.length {
            Option::None
        } else {
            Option::Some(
                FrozenBytes {
                    values: self.values,
                    offset: self.offset + start,
                    length: end - start,
                },
            )
        }
    }

    pub fn to_vec_copy(self: FrozenBytes) -> Vec[byte] {
        let result = Vec::with_capacity(self.length);
        for index in 0..self.length {
            result.push(self.values.get(self.offset + index));
        }
        result
    }

    pub fn thaw(self: FrozenBytes) -> Bytes {
        Bytes::from_vec(self.to_vec_copy())
    }
}

impl PartialEq for FrozenBytes {
    fn eq(self: FrozenBytes, other: FrozenBytes) -> bool {
        if self.length != other.length {
            return false
        }
        for index in 0..self.length {
            if self.values.get(self.offset + index) != other.values.get(other.offset + index) {
                return false
            }
        }
        true
    }
}

impl Eq for FrozenBytes {}
