package tests;

use std::text;
use std::unicode;
use std::testing;
use std::bytes;

fn map_test_character(value: char) -> Option[char] {
    if value == ',' {
        Option::None
    } else if value == 'a' {
        Option::Some('界')
    } else {
        Option::Some(unicode::to_uppercase(value))
    }
}
