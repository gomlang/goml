package tests;

use std::unicode;

fn text_reference_byte_valid_utf8(input: Slice[byte], replacement: Slice[byte]) -> Vec[byte] {
    let result: Vec[byte] = Vec::new();
    let mut invalid = false;
    for item in text_reference_chars(input) {
        if item.0 == '�' && item.2 == 1 {
            if !invalid {
                for value in replacement {
                    result.push(value);
                }
            }
            invalid = true;
        } else {
            invalid = false;
            for index in item.1..item.1 + item.2 {
                result.push(input[index]);
            }
        }
    }
    result
}

fn text_reference_chars(input: Slice[byte]) -> Vec[(char, isize, isize)] {
    let result: Vec[(char, isize, isize)] = Vec::new();
    let mut index = 0;
    while index < input.len() {
        let (value, width) = text_reference_decode_rune(input.sub(index, input.len()));
        result.push((value, index, width));
        index += width;
    }
    result
}

fn text_reference_byte_equal_fold(left: Slice[byte], right: Slice[byte]) -> bool {
    let a = text_reference_chars(left);
    let b = text_reference_chars(right);
    if a.len() != b.len() {
        return false
    }
    for index in 0..a.len() {
        let value = a[index].0;
        let expected = b[index].0;
        if value != expected {
            let mut folded = unicode::simple_fold(value);
            while folded != value && folded != expected {
                folded = unicode::simple_fold(folded);
            }
            if folded != expected {
                return false
            }
        }
    }
    true
}

fn text_reference_byte_find_char(input: Slice[byte], character: char) -> isize {
    text_reference_byte_find_predicate(input, |value: char| value == character, false)
}

fn text_reference_byte_find_predicate(input: Slice[byte], predicate: (char) -> bool, last: bool) -> isize {
    let mut result = -1;
    for item in text_reference_chars(input) {
        if predicate(item.0) {
            result = item.1;
            if !last {
                return result
            }
        }
    }
    result
}

fn text_reference_byte_trim_chars(input: Slice[byte], characters: string) -> Vec[byte] {
    text_reference_byte_trim(
        input,
        |value: char| text_reference_contains_char(characters, value),
        true,
        true,
    )
}

fn text_reference_contains_char(characters: string, value: char) -> bool {
    for character in characters.chars() {
        if character == value {
            return true
        }
    }
    false
}

fn text_reference_byte_trim(input: Slice[byte], predicate: (char) -> bool, left: bool, right: bool) -> Vec[
    byte,
] {
    let chars = text_reference_chars(input);
    let mut low = 0;
    let mut high = chars.len();
    if left {
        while low < high && predicate(chars[low].0) {
            low += 1;
        }
    }
    if right {
        while high > low && predicate(chars[high - 1].0) {
            high -= 1;
        }
    }
    let start = if low < chars.len() {
        chars[low].1
    } else {
        input.len()
    };
    let end = if high < chars.len() {
        chars[high].1
    } else {
        input.len()
    };
    input.sub(start, end).to_vec()
}

fn text_reference_byte_map(input: Slice[byte]) -> Vec[byte] {
    let result: Vec[byte] = Vec::new();
    for item in text_reference_chars(input) {
        if item.0 != ',' {
            let value = if item.0 == 'a' {
                '界'
            } else {
                unicode::to_uppercase(item.0)
            };
            result.extend(value.to_string().to_bytes());
        }
    }
    result
}

fn text_reference_byte_rfind_char(input: Slice[byte], character: char) -> isize {
    text_reference_byte_find_predicate(input, |value: char| value == character, true)
}

fn text_reference_byte_trim_end_chars(input: Slice[byte], characters: string) -> Vec[byte] {
    text_reference_byte_trim(
        input,
        |value: char| text_reference_contains_char(characters, value),
        false,
        true,
    )
}

fn text_reference_byte_rfind_by(input: Slice[byte]) -> isize {
    text_reference_byte_find_predicate(input, text_reference_byte_separator, true)
}

fn text_reference_byte_separator(value: char) -> bool {
    value == ',' || value == '界' || value == '�'
}

fn text_reference_byte_trim_space(input: Slice[byte]) -> Vec[byte] {
    text_reference_byte_trim(input, unicode::is_whitespace, true, true)
}

fn text_reference_byte_trim_start_by(input: Slice[byte]) -> Vec[byte] {
    text_reference_byte_trim(input, text_reference_byte_separator, true, false)
}

fn text_reference_byte_case(input: Slice[byte], kind: isize, special: bool) -> Vec[byte] {
    let result: Vec[byte] = Vec::new();
    let target = match kind {
        0 => unicode::Case::Upper,
        1 => unicode::Case::Lower,
        _ => unicode::Case::Title,
    };
    let turkish = unicode::turkish_case();
    for item in text_reference_chars(input) {
        let value = if special {
            turkish.to_case(item.0, target)
        } else {
            match kind {
                0 => unicode::to_uppercase(item.0),
                1 => unicode::to_lowercase(item.0),
                _ => unicode::to_titlecase(item.0),
            }
        };
        result.extend(value.to_string().to_bytes());
    }
    result
}

fn text_reference_byte_find_by(input: Slice[byte]) -> isize {
    text_reference_byte_find_predicate(input, text_reference_byte_separator, false)
}

fn text_reference_byte_find_any(input: Slice[byte], characters: string) -> isize {
    text_reference_byte_find_predicate(
        input,
        |value: char| text_reference_contains_char(characters, value),
        false,
    )
}

fn text_reference_byte_fields(input: Slice[byte]) -> Vec[Vec[byte]] {
    text_reference_byte_fields_predicate(input, unicode::is_whitespace)
}

fn text_reference_byte_fields_predicate(input: Slice[byte], predicate: (char) -> bool) -> Vec[
    Vec[byte],
] {
    let result: Vec[Vec[byte]] = Vec::new();
    let mut start = 0;
    for item in text_reference_chars(input) {
        if predicate(item.0) {
            if start < item.1 {
                result.push(input.sub(start, item.1).to_vec());
            }
            start = item.1 + item.2;
        }
    }
    if start < input.len() {
        result.push(input.sub(start, input.len()).to_vec());
    }
    result
}

fn text_reference_byte_fields_by(input: Slice[byte]) -> Vec[Vec[byte]] {
    text_reference_byte_fields_predicate(input, text_reference_byte_separator)
}

fn text_reference_byte_trim_start_chars(input: Slice[byte], characters: string) -> Vec[byte] {
    text_reference_byte_trim(
        input,
        |value: char| text_reference_contains_char(characters, value),
        true,
        false,
    )
}

fn text_reference_byte_trim_end_by(input: Slice[byte]) -> Vec[byte] {
    text_reference_byte_trim(input, text_reference_byte_separator, false, true)
}

fn text_reference_byte_rfind_any(input: Slice[byte], characters: string) -> isize {
    text_reference_byte_find_predicate(
        input,
        |value: char| text_reference_contains_char(characters, value),
        true,
    )
}

fn text_reference_byte_trim_by(input: Slice[byte]) -> Vec[byte] {
    text_reference_byte_trim(input, text_reference_byte_separator, true, true)
}
