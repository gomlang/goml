package bytes;

pub struct Finder {
    pattern: Vec[byte],
    fallback: Vec[isize],
}

impl Finder {
    pub fn new(pattern: Slice[byte]) -> Finder {
        let copied = pattern.to_vec();
        let fallback: Vec[isize] = Vec::new();
        let mut matched = 0;
        for index in 0..copied.len() {
            if index > 0 {
                while matched > 0 && copied[index] != copied[matched] {
                    matched = fallback[matched - 1];
                }
                if copied[index] == copied[matched] {
                    matched += 1;
                }
            }
            fallback.push(matched);
        }
        Finder { pattern: copied, fallback }
    }

    fn search(self: Finder, input: Slice[byte], last: bool) -> Option[isize] {
        if self.pattern.is_empty() {
            return Option::Some(
                if last {
                    input.len()
                } else {
                    0
                },
            )
        }
        let mut matched = 0;
        let mut result: Option[isize] = Option::None;
        for index in 0..input.len() {
            while matched > 0 && input[index] != self.pattern[matched] {
                matched = self.fallback[matched - 1];
            }
            if input[index] == self.pattern[matched] {
                matched += 1;
            }
            if matched == self.pattern.len() {
                let start = index - matched + 1;
                if !last {
                    return Option::Some(start)
                }
                result = Option::Some(start);
                matched = self.fallback[matched - 1];
            }
        }
        result
    }

    pub fn find(self: Finder, input: Slice[byte]) -> Option[isize] {
        self.search(input, false)
    }

    pub fn rfind(self: Finder, input: Slice[byte]) -> Option[isize] {
        self.search(input, true)
    }

    pub fn contains(self: Finder, input: Slice[byte]) -> bool {
        self.find(input).is_some()
    }
}

pub fn find(input: Slice[byte], pattern: Slice[byte]) -> Option[isize] {
    Finder::new(pattern).find(input)
}

pub fn rfind(input: Slice[byte], pattern: Slice[byte]) -> Option[isize] {
    Finder::new(pattern).rfind(input)
}

pub fn contains(input: Slice[byte], pattern: Slice[byte]) -> bool {
    find(input, pattern).is_some()
}

pub fn starts_with(input: Slice[byte], prefix: Slice[byte]) -> bool {
    if prefix.len() > input.len() {
        return false
    }
    for index in 0..prefix.len() {
        if input[index] != prefix[index] {
            return false
        }
    }
    true
}

pub fn ends_with(input: Slice[byte], suffix: Slice[byte]) -> bool {
    if suffix.len() > input.len() {
        return false
    }
    starts_with(input.sub(input.len() - suffix.len(), input.len()), suffix)
}

pub fn cut(input: Slice[byte], separator: Slice[byte]) -> Option[(Slice[byte], Slice[byte])] {
    match find(input, separator) {
        Option::Some(index) => Option::Some(
            (input.sub(0, index), input.sub(index + separator.len(), input.len())),
        ),
        Option::None => Option::None,
    }
}

pub fn cut_prefix(input: Slice[byte], prefix: Slice[byte]) -> Option[Slice[byte]] {
    if starts_with(input, prefix) {
        Option::Some(input.sub(prefix.len(), input.len()))
    } else {
        Option::None
    }
}

pub fn cut_suffix(input: Slice[byte], suffix: Slice[byte]) -> Option[Slice[byte]] {
    if ends_with(input, suffix) {
        Option::Some(input.sub(0, input.len() - suffix.len()))
    } else {
        Option::None
    }
}

pub fn find_byte(input: Slice[byte], value: byte) -> Option[isize] {
    for index in 0..input.len() {
        if input[index] == value {
            return Option::Some(index)
        }
    }
    Option::None
}

pub fn rfind_byte(input: Slice[byte], value: byte) -> Option[isize] {
    let mut index = input.len();
    while index > 0 {
        index -= 1;
        if input[index] == value {
            return Option::Some(index)
        }
    }
    Option::None
}
