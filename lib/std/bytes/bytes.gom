package bytes;

pub struct BoundsError {
    offset_value: isize,
    needed_value: isize,
    length_value: isize,
}

impl BoundsError {
    pub fn new(offset: isize, needed: isize, length: isize) -> BoundsError {
        BoundsError { offset_value: offset, needed_value: needed, length_value: length }
    }

    pub fn offset(self: BoundsError) -> isize {
        self.offset_value
    }

    pub fn needed(self: BoundsError) -> isize {
        self.needed_value
    }

    pub fn length(self: BoundsError) -> isize {
        self.length_value
    }
}

impl ToString for BoundsError {
    fn to_string(self: BoundsError) -> string {
        f"byte range at offset {self.offset_value} needs {self.needed_value} bytes in buffer of length {self.length_value}"
    }
}

impl Debug for BoundsError {
    fn debug(self: BoundsError) -> string {
        self.to_string()
    }
}

impl PartialEq for BoundsError {
    fn eq(self: BoundsError, other: BoundsError) -> bool {
        self.offset_value == other.offset_value && self.needed_value == other.needed_value
            && self.length_value == other.length_value
    }
}

pub struct Builder {
    values: Vec[byte],
}

impl Builder {
    pub fn new() -> Builder {
        Builder { values: Vec::new() }
    }

    pub fn with_capacity(capacity: isize) -> Builder {
        Builder { values: Vec::with_capacity(capacity) }
    }

    pub fn len(self: Builder) -> isize {
        self.values.len()
    }

    pub fn is_empty(self: Builder) -> bool {
        self.values.is_empty()
    }

    pub fn push(self: Builder, value: byte) -> () {
        self.values.push(value)
    }

    pub fn extend(self: Builder, value: Slice[byte]) -> () {
        self.values.reserve(value.len());
        for byte in value {
            self.values.push(byte)
        }
    }

    pub fn clear(self: Builder) -> () {
        self.values.clear()
    }

    pub fn finish(self: Builder) -> Bytes {
        Bytes::from_vec(self.values)
    }

    pub fn to_vec(self: Builder) -> Vec[byte] {
        self.values
    }

    pub fn to_vec_copy(self: Builder) -> Vec[byte] {
        self.values.copy()
    }

    pub fn finish_copy(self: Builder) -> Bytes {
        Bytes::from_vec_copy(self.values)
    }
}

pub struct Bytes {
    pub values: Vec[byte],
}

impl Bytes {
    pub fn new() -> Bytes {
        Bytes { values: Vec::new() }
    }

    pub fn with_capacity(capacity: isize) -> Bytes {
        Bytes { values: Vec::with_capacity(capacity) }
    }

    pub fn from_vec(values: Vec[byte]) -> Bytes {
        Bytes { values }
    }

    pub fn from_vec_copy(values: Vec[byte]) -> Bytes {
        Bytes { values: values.copy() }
    }

    pub fn from_slice_copy(values: Slice[byte]) -> Bytes {
        let result = Bytes::with_capacity(values.len());
        result.extend_from_slice(values);
        result
    }

    pub fn from_string(value: string) -> Bytes {
        Bytes { values: value.to_bytes() }
    }

    pub fn len(self: Bytes) -> isize {
        self.values.len()
    }

    pub fn capacity(self: Bytes) -> isize {
        self.values.capacity()
    }

    pub fn is_empty(self: Bytes) -> bool {
        self.values.is_empty()
    }

    pub fn get(self: Bytes, index: isize) -> byte {
        self.values[index]
    }

    pub fn get_checked(self: Bytes, index: isize) -> Option[byte] {
        self.values.get_checked(index)
    }

    pub fn set(self: Bytes, index: isize, value: byte) -> () {
        self.values[index] = value;
    }

    pub fn set_checked(self: Bytes, index: isize, value: byte) -> bool {
        self.values.as_mut_slice().set_checked(index, value)
    }

    pub fn push(self: Bytes, value: byte) -> () {
        self.values.push(value)
    }

    pub fn pop(self: Bytes) -> Option[byte] {
        self.values.pop()
    }

    pub fn reserve(self: Bytes, additional: isize) -> () {
        self.values.reserve(additional)
    }

    pub fn truncate(self: Bytes, len: isize) -> () {
        self.values.truncate(len)
    }

    pub fn clear(self: Bytes) -> () {
        self.values.clear()
    }

    pub fn slice(self: Bytes, start: isize, end: isize) -> Slice[byte] {
        self.values.slice(start, end)
    }

    pub fn slice_checked(self: Bytes, start: isize, end: isize) -> Option[Slice[byte]] {
        self.values.slice_checked(start, end)
    }

    pub fn as_slice(self: Bytes) -> Slice[byte] {
        self.values.as_slice()
    }

    pub fn slice_mut(self: Bytes, start: isize, end: isize) -> MutSlice[byte] {
        self.values.slice_mut(start, end)
    }

    pub fn slice_mut_checked(self: Bytes, start: isize, end: isize) -> Option[MutSlice[byte]] {
        self.values.slice_mut_checked(start, end)
    }

    pub fn as_mut_slice(self: Bytes) -> MutSlice[byte] {
        self.values.as_mut_slice()
    }

    pub fn extend_from_slice(self: Bytes, source: Slice[byte]) -> () {
        self.values.reserve(source.len());
        for value in source {
            self.values.push(value)
        }
    }

    pub fn to_vec(self: Bytes) -> Vec[byte] {
        self.values
    }

    pub fn to_vec_copy(self: Bytes) -> Vec[byte] {
        self.values.copy()
    }

    pub fn copy(self: Bytes) -> Bytes {
        Bytes::from_vec_copy(self.values)
    }

    pub fn freeze(self: Bytes) -> FrozenBytes {
        FrozenBytes { values: self.values.freeze(), offset: 0, length: self.len() }
    }

    pub fn builder() -> Builder {
        Builder::new()
    }
}
