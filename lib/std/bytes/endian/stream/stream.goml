}

pub fn read_u16[R: Read](reader: R, order: endian::Endian) -> Result[Option[u16], ReadError] {
    read_fixed(reader, 2, |input: Slice[byte]| endian::read_u16(input, 0, order))
}

pub fn write_u16[W: Write](writer: W, value: u16, order: endian::Endian) -> Result[(), io::Error] {
    write_fixed(writer, 2, |output: MutSlice[byte]| endian::write_u16(output, 0, value, order))
}

