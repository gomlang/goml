}

pub fn write_i16[W: Write](writer: W, value: i16, order: endian::Endian) -> Result[(), io::Error] {
    write_fixed(writer, 2, |output: MutSlice[byte]| endian::write_i16(output, 0, value, order))
}

pub fn read_u32[R: Read](reader: R, order: endian::Endian) -> Result[Option[u32], ReadError] {
    read_fixed(reader, 4, |input: Slice[byte]| endian::read_u32(input, 0, order))
}

