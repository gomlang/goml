package stream;

use std::bytes::endian;
use std::io;
use io::{Read, Write};

pub enum ReadError {
    Io(io::Error, isize),
    Decode(endian::VarintError),
}

impl ToString for ReadError {
    fn to_string(self: ReadError) -> string {
        match self {
            ReadError::Io(error, count) => f"binary read after {count} bytes: {error}",
            ReadError::Decode(error) => error.to_string(),
        }
    }
}

impl Debug for ReadError {
    fn debug(self: ReadError) -> string {
        self.to_string()
    }
}

pub fn read_uvarint[R: Read](reader: R) -> Result[Option[u64], ReadError] {
    let input: Vec[byte] = Vec::new();
    let one = b"\0";
    for index in 0..endian::MAX_VARINT_LEN64 {
        let count = match reader.read(one.as_mut_slice()) {
            Ok(count) => count,
            Err(error) => return Result::Err(ReadError::Io(error, index)),
        };
        if count == 0 {
            if index == 0 {
                return Result::Ok(Option::None)
            }
            return Result::Err(ReadError::Decode(endian::VarintError::Truncated(index)))
        }
        if count != 1 {
            return Result::Err(
                ReadError::Io(
                    io::Error::new(
                        io::ErrorKind::InvalidData,
                        "read varint",
                        Option::None,
                        Option::None,
                        "invalid reader byte count",
                    ),
                    index,
                ),
            )
        }
        input.push(one[0]);
        if one[0] < 128 || index == endian::MAX_VARINT_LEN64 - 1 {
            let (value, _) = endian::read_uvarint(input.as_slice(), 0).map_err(
                |error: endian::VarintError| ReadError::Decode(error),
            )?;
            return Result::Ok(Option::Some(value))
        }
    }
    Result::Err(ReadError::Decode(endian::VarintError::Overflow(9)))
}

pub fn read_varint[R: Read](reader: R) -> Result[Option[i64], ReadError] {
    let value = read_uvarint(reader)?;
    Result::Ok(
        value.map(
            |value: u64| {
                let magnitude = (value >> 1).to_i64();
                if value & 1 == 0 {
                    magnitude
                } else {
                    -1 - magnitude
                }
            },
        ),
    )
}

pub fn write_uvarint[W: Write](writer: W, value: u64) -> Result[(), io::Error] {
    let output: Vec[byte] = Vec::new();
    for _ in 0..endian::MAX_VARINT_LEN64 {
        output.push(0);
    }
    let count = endian::write_uvarint(output.as_mut_slice(), 0, value).map_err(
        |error: endian::BoundsError| io::Error::new(
            io::ErrorKind::InvalidData,
            "write varint",
            Option::None,
            Option::None,
            error.to_string(),
        ),
    )?;
    writer.write_all(output.slice(0, count))
}

pub fn write_varint[W: Write](writer: W, value: i64) -> Result[(), io::Error] {
    write_uvarint(writer, (value.to_u64() << 1) ^ (value >> 63).to_u64())
}

fn fixed_error(kind: io::ErrorKind, operation: string, message: string) -> io::Error {
    io::Error::new(kind, operation, Option::None, Option::None, message)
}

fn fixed_buffer(width: isize) -> Vec[byte] {
    let result: Vec[byte] = Vec::new();
    for _ in 0..width {
        result.push(0);
    }
    result
}

fn read_fixed[R: Read, T](
    reader: R,
    width: isize,
    decode: (Slice[byte]) -> Result[T, endian::BoundsError],
) -> Result[Option[T], ReadError] {
    let buffer = fixed_buffer(width);
    let mut offset = 0;
    while offset < width {
        let count = match reader.read(buffer.as_mut_slice().sub(offset, width)) {
            Ok(count) => count,
            Err(error) => return Result::Err(ReadError::Io(error, offset)),
        };
        if count < 0 || count > width - offset {
            return Result::Err(
                ReadError::Io(
                    fixed_error(
                        io::ErrorKind::InvalidData,
                        "read fixed",
                        "invalid reader byte count",
                    ),
                    offset,
                ),
            )
        }
        if count == 0 {
            if offset == 0 {
                return Result::Ok(Option::None)
            }
            return Result::Err(
                ReadError::Io(
                    fixed_error(
                        io::ErrorKind::UnexpectedEof,
                        "read fixed",
                        "truncated fixed-width value",
                    ),
                    offset,
                ),
            )
        }
        offset += count;
    }
    let value = decode(buffer.as_slice()).map_err(
        |error: endian::BoundsError| ReadError::Io(
            fixed_error(io::ErrorKind::InvalidData, "read fixed", error.to_string()),
            offset,
        ),
    )?;
    Result::Ok(Option::Some(value))
}

fn write_fixed[W: Write](
    writer: W,
    width: isize,
    encode: (MutSlice[byte]) -> Result[(), endian::BoundsError],
) -> Result[(), io::Error] {
    let buffer = fixed_buffer(width);
    encode(buffer.as_mut_slice()).map_err(
        |error: endian::BoundsError| fixed_error(
            io::ErrorKind::InvalidData,
            "write fixed",
            error.to_string(),
        ),
    )?;
    writer.write_all(buffer.as_slice())
}

pub fn read_with[R: Read, T](
    reader: R,
    width: isize,
    limit: isize,
    decode: (endian::Reader) -> Result[T, endian::BoundsError],
) -> Result[Option[T], ReadError] {
    if width < 0 || limit < 0 || width > limit {
        return Result::Err(
            ReadError::Io(
                fixed_error(
                    io::ErrorKind::InvalidInput,
                    "read block",
                    "invalid block width or byte limit",
                ),
                0,
            ),
        )
    }
    read_fixed(reader, width, |input: Slice[byte]| decode(endian::Reader::new(input)))
}

pub fn write_with[W: Write](
    writer: W,
    width: isize,
    limit: isize,
    encode: (endian::Writer) -> Result[(), endian::BoundsError],
) -> Result[(), io::Error] {
    if width < 0 || limit < 0 || width > limit {
        return Result::Err(
            fixed_error(
                io::ErrorKind::InvalidInput,
                "write block",
                "invalid block width or byte limit",
            ),
        )
    }
    write_fixed(writer, width, |output: MutSlice[byte]| encode(endian::Writer::new(output)))
}

pub fn read_bool[R: Read](reader: R) -> Result[Option[bool], ReadError] {
    read_fixed(reader, 1, |input: Slice[byte]| endian::read_bool(input, 0))
}

pub fn write_bool[W: Write](writer: W, value: bool) -> Result[(), io::Error] {
    write_fixed(writer, 1, |output: MutSlice[byte]| endian::write_bool(output, 0, value))
}

pub fn read_u8[R: Read](reader: R) -> Result[Option[u8], ReadError] {
    read_fixed(reader, 1, |input: Slice[byte]| endian::read_u8(input, 0))
}

pub fn write_u8[W: Write](writer: W, value: u8) -> Result[(), io::Error] {
    write_fixed(writer, 1, |output: MutSlice[byte]| endian::write_u8(output, 0, value))
}

pub fn read_i8[R: Read](reader: R) -> Result[Option[i8], ReadError] {
