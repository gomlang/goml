package endian;

use std::bytes as byte_buffer;

pub const MAX_VARINT_LEN64: isize = 10;

pub enum VarintError {
    InvalidOffset(isize),
    Truncated(isize),
    Overflow(isize),
}

impl Debug for VarintError {
    fn debug(self: VarintError) -> string {
        self.to_string()
    }
}

impl PartialEq for VarintError {
    fn eq(self: VarintError, other: VarintError) -> bool {
        match (self, other) {
            (VarintError::InvalidOffset(left), VarintError::InvalidOffset(right)) => left == right,
            (VarintError::Truncated(left), VarintError::Truncated(right)) => left == right,
            (VarintError::Overflow(left), VarintError::Overflow(right)) => left == right,
            _ => false,
        }
    }
}

impl Eq for VarintError {}

impl ToString for VarintError {
    fn to_string(self: VarintError) -> string {
        match self {
            VarintError::InvalidOffset(offset) => f"invalid varint offset {offset}",
            VarintError::Truncated(offset) => f"truncated varint at byte {offset}",
            VarintError::Overflow(offset) => f"varint overflows u64 at byte {offset}",
        }
    }
}

pub fn uvarint_len(value: u64) -> isize {
    let mut remaining = value;
    let mut length = 1;
    while remaining >= 128 {
        remaining = remaining >> 7;
        length += 1;
    }
    length
}

fn zigzag(value: i64) -> u64 {
    (value.to_u64() << 1) ^ (value >> 63).to_u64()
}

pub fn varint_len(value: i64) -> isize {
    uvarint_len(zigzag(value))
}

pub fn read_uvarint(input: Slice[byte], offset: isize) -> Result[(u64, isize), VarintError] {
    if offset < 0 || offset > input.len() {
        return Result::Err(VarintError::InvalidOffset(offset))
    }
    let mut value: u64 = 0;
    for index in 0..MAX_VARINT_LEN64 {
        if index >= input.len() - offset {
            return Result::Err(VarintError::Truncated(offset + index))
        }
        let digit = input[offset + index];
        if index == 9 && digit > 1 {
            return Result::Err(VarintError::Overflow(offset + index))
        }
        value = value | ((digit & 127).to_u64() << (index * 7));
        if digit < 128 {
            return Result::Ok((value, index + 1))
        }
    }
    Result::Err(VarintError::Overflow(offset + 9))
}

pub fn read_varint(input: Slice[byte], offset: isize) -> Result[(i64, isize), VarintError] {
    let (value, count) = read_uvarint(input, offset)?;
    let magnitude = (value >> 1).to_i64();
    let decoded = if value & 1 == 0 {
        magnitude
    } else {
        -1 - magnitude
    };
    Result::Ok((decoded, count))
}

pub fn write_uvarint(output: MutSlice[byte], offset: isize, value: u64) -> Result[
    isize,
    BoundsError,
] {
    let length = uvarint_len(value);
    check_range(output.len(), offset, length)?;
    let mut remaining = value;
    for index in 0..length - 1 {
        output[offset + index] = remaining.to_u8() | 128;
        remaining = remaining >> 7;
    }
    output[offset + length - 1] = remaining.to_u8();
    Result::Ok(length)
}

pub fn write_varint(output: MutSlice[byte], offset: isize, value: i64) -> Result[isize, BoundsError] {
    write_uvarint(output, offset, zigzag(value))
}

pub fn append_uvarint(output: byte_buffer::Builder, value: u64) -> () {
    let mut remaining = value;
    while remaining >= 128 {
        output.push(remaining.to_u8() | 128);
        remaining = remaining >> 7;
    }
    output.push(remaining.to_u8())
}

pub fn append_varint(output: byte_buffer::Builder, value: i64) -> () {
    append_uvarint(output, zigzag(value))
}

impl Reader {
    pub fn read_uvarint(self: Reader) -> Result[u64, VarintError] {
        let (value, count) = read_uvarint(self.input, self.offset.get())?;
        self.offset.set(self.offset.get() + count);
        Result::Ok(value)
    }

    pub fn read_varint(self: Reader) -> Result[i64, VarintError] {
        let (value, count) = read_varint(self.input, self.offset.get())?;
        self.offset.set(self.offset.get() + count);
        Result::Ok(value)
    }
}

impl Writer {
    pub fn write_uvarint(self: Writer, value: u64) -> Result[(), BoundsError] {
        let count = write_uvarint(self.output, self.offset.get(), value)?;
        self.offset.set(self.offset.get() + count);
        Result::Ok(())
    }

    pub fn write_varint(self: Writer, value: i64) -> Result[(), BoundsError] {
        let count = write_varint(self.output, self.offset.get(), value)?;
        self.offset.set(self.offset.get() + count);
        Result::Ok(())
    }
}
