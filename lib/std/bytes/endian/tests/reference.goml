package tests;

fn reference_put_uvarint(output: MutSlice[byte], value: u64) -> isize {
    let mut remaining = value;
    let mut index = 0;
    loop {
        let digit = (remaining % 128).to_u8();
        remaining /= 128;
        output[index] = if remaining == 0 {
            digit
        } else {
            digit + 128
        };
        index += 1;
        if remaining == 0 {
            return index
        }
    }
}

fn reference_put_varint(output: MutSlice[byte], value: i64) -> isize {
    let encoded = if value < 0 {
        (-(value + 1)).to_u64() * 2 + 1
    } else {
        value.to_u64() * 2
    };
    reference_put_uvarint(output, encoded)
}

fn reference_binary_record_bytes(
    enabled: bool,
    sequence: u16,
    samples: Slice[i16],
    weight_bits: u32,
    little: bool,
) -> Vec[byte] {
    let output: Vec[byte] = Vec::new();
    output.push(
        if enabled {
            1
        } else {
            0
        },
    );
    for (value, width) in[
        (sequence.to_u64(), 2),
        (samples[0].to_u16().to_u64(), 2),
        (samples[1].to_u16().to_u64(), 2),
        (samples[2].to_u16().to_u64(), 2),
        (weight_bits.to_u64(), 4),
    ] {
        for index in 0..width {
            output.push(
                (value
                    >> (8
                        * if little {
                            index
                        } else {
                            width - 1 - index
                        })).to_u8(),
            );
        }
    }
    while output.len() < 16 {
        output.push(0);
    }
    output
}
