package tests;

use std::bytes;
use std::bytes::endian;
use std::rand;
use std::testing;

fn check_varint_cursors() -> () {
    let signed: Vec[i64] = Vec::from_array([-9223372036854775808, -1, 0, 9223372036854775807]);
    let output = Vec::new();
    for _ in 0..64 {
        output.push(255.to_u8());
    }
    let writer = endian::Writer::new(output.as_mut_slice());
    let values: Vec[u64] = Vec::from_array([0, 127, 128, 18446744073709551615]);
    let mut position = 0;
    for value in values {
        testing::expect_ok(writer.write_uvarint(value), "cursor uvarint write");
        position += endian::uvarint_len(value);
        assert_equal(writer.position(), position);
    }
    for value in signed {
        testing::expect_ok(writer.write_varint(value), "cursor varint write");
    }
    let reader = endian::Reader::new(output.slice(0, writer.position()));
    for value in values {
        assert_equal(testing::expect_ok(reader.read_uvarint(), "cursor uvarint read"), value);
    }
    assert_equal(reader.position(), position);
    let alias = reader;
    for value in signed {
        assert_equal(testing::expect_ok(alias.read_varint(), "cursor varint read"), value);
    }
    assert_equal(reader.position(), writer.position());
    testing::assert(reader.read_uvarint().is_err());
    assert_equal(reader.position(), writer.position());
    for capacity in 0..10 {
        let storage = Vec::new();
        for _ in 0..capacity {
            storage.push(99.to_u8());
        }
        let snapshot = storage.copy();
        let short = endian::Writer::new(storage.as_mut_slice());
        testing::assert(short.write_uvarint(18446744073709551615).is_err());
        assert_equal(short.position(), 0);
        assert_equal(storage, snapshot);
        testing::assert(short.write_varint(-9223372036854775808).is_err());
        assert_equal(short.position(), 0);
        assert_equal(storage, snapshot);
    }
    let encoded = b"\x01\x80\x80\x80\x80\x80\x80\x80\x80\x80\x02";
    for length in 1..12 {
        let invalid = endian::Reader::new(encoded.slice(0, length));
        assert_equal(testing::expect_ok(invalid.read_uvarint(), "prefix"), 1.to_u64());
        let error = if length == 11 {
            endian::VarintError::Overflow(10)
        } else {
            endian::VarintError::Truncated(length)
        };
        assert_equal(invalid.read_uvarint(), Result::Err(error));
        assert_equal(invalid.position(), 1);
        assert_equal(invalid.read_varint(), Result::Err(error));
        assert_equal(invalid.position(), 1);
    }
}

fn check_one_varint(value: u64) -> () {
    let output = filled_bytes(0, 12);
    let reference = filled_bytes(0, 10);
    let length = testing::expect_ok(
        endian::write_uvarint(output.as_mut_slice(), 1, value),
        "write unsigned",
    );
    assert_equal(length, endian::uvarint_len(value));
    assert_equal(length, reference_put_uvarint(reference.as_mut_slice(), value));
    assert_equal(output.slice(1, 1 + length).to_vec(), reference.slice(0, length).to_vec());
    assert_equal(
        testing::expect_ok(endian::read_uvarint(output.as_slice(), 1), "read unsigned"),
        (value, length),
    );
    let builder = bytes::Builder::new();
    endian::append_uvarint(builder, value);
    assert_equal(builder.to_vec(), reference.slice(0, length).to_vec());
    for size in 0..length {
        let before = output.to_vec_copy();
        testing::assert_err(endian::write_uvarint(output.slice_mut(1, 1 + size), 0, value));
        assert_equal(output.to_vec(), before);
        testing::assert_err(endian::read_uvarint(reference.slice(0, size), 0));
    }
    let signed = value.to_i64();
    let signed_length = testing::expect_ok(
        endian::write_varint(output.as_mut_slice(), 0, signed),
        "write signed",
    );
    assert_equal(signed_length, endian::varint_len(signed));
    assert_equal(signed_length, reference_put_varint(reference.as_mut_slice(), signed));
    assert_equal(
        output.slice(0, signed_length).to_vec(),
        reference.slice(0, signed_length).to_vec(),
    );
    assert_equal(
        testing::expect_ok(endian::read_varint(output.as_slice(), 0), "read signed"),
        (signed, signed_length),
    );
    builder.clear();
    endian::append_varint(builder, signed);
    assert_equal(builder.to_vec(), reference.slice(0, signed_length).to_vec());
}

#[test]
fn check_varints() -> () {
    check_varint_cursors();
    for value in Vec::from_array(
        [
            0.to_u64(),
            1,
            127,
            128,
            255,
            256,
            16383,
            16384,
            0x7fffffffffffffff,
            0x8000000000000000,
            0xffffffffffffffff,
        ],
    ) {
        check_one_varint(value)
    }
    for index in 0..256 {
        check_one_varint(rand::next_u64(index.to_u64()))
    }
    let invalid = filled_bytes(128, 11);
    assert_equal(
        testing::expect_err(endian::read_uvarint(invalid.as_slice(), 0), "overflow"),
        endian::VarintError::Overflow(9),
    );
    invalid.set(9, 2);
    assert_equal(
        testing::expect_err(endian::read_uvarint(invalid.as_slice(), 0), "high bits"),
        endian::VarintError::Overflow(9),
    );
    assert_equal(
        testing::expect_err(endian::read_uvarint(invalid.as_slice(), -1), "offset"),
        endian::VarintError::InvalidOffset(-1),
    );
    testing::assert_err(endian::read_uvarint(invalid.as_slice(), 12));
    testing::assert_err(endian::write_uvarint(invalid.as_mut_slice(), -1, 1));
    testing::assert_err(endian::write_uvarint(invalid.as_mut_slice(), 12, 1));
    let overlong = bytes::Bytes::from_vec(Vec::from_array([128.to_u8(), 0]));
    assert_equal(
        testing::expect_ok(endian::read_uvarint(overlong.as_slice(), 0), "nonminimal varint"),
        (0.to_u64(), 2),
    );
}

fn filled_bytes(value: byte, count: isize) -> bytes::Bytes {
    let output = bytes::Bytes::with_capacity(count);
    for _ in 0..count {
        output.push(value)
    }
    output
}
