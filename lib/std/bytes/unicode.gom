package bytes;

use module::unicode;

fn decode_scalar(input: Slice[byte], offset: isize) -> (char, isize) {
    let width = boundary_width(input, offset);
    let first = input[offset];
    if width == 1 {
        return (
            if first < 0x80 {
                char_from_u32(first.to_u32()).unwrap_or('�')
            } else {
                '�'
            },
            1,
        )
    }
    let mut code = first.to_u32() & (0x7f >> width);
    for index in 1..width {
        code = (code << 6) | (input[offset + index] & 0x3f).to_u32();
    }
    let result = (char_from_u32(code).unwrap_or('�'), width);
    result
}

fn decode_last_scalar(input: Slice[byte], end: isize) -> (char, isize) {
    let mut start = end - 1;
    let lower = if end > 4 {
        end - 4
    } else {
        0
    };
    while start > lower && input[start] & 0xc0 == 0x80 {
        start -= 1;
    }
    let (character, width) = decode_scalar(input.sub(0, end), start);
    if start + width == end {
        (character, width)
    } else {
        ('�', 1)
    }
}

pub fn find_by(input: Slice[byte], predicate: (char) -> bool) -> Option[isize] {
    let mut offset = 0;
    while offset < input.len() {
        let (character, width) = decode_scalar(input, offset);
        if predicate(character) {
            return Option::Some(offset)
        }
        offset += width;
    }
    Option::None
}

pub fn rfind_by(input: Slice[byte], predicate: (char) -> bool) -> Option[isize] {
    let mut end = input.len();
    while end > 0 {
        let (character, width) = decode_last_scalar(input, end);
        end -= width;
        if predicate(character) {
            return Option::Some(end)
        }
    }
    Option::None
}

pub fn find_char(input: Slice[byte], character: char) -> Option[isize] {
    find_by(input, |value: char| value == character)
}

pub fn rfind_char(input: Slice[byte], character: char) -> Option[isize] {
    rfind_by(input, |value: char| value == character)
}

fn scalar_set(characters: string) -> HashMap[char, bool] {
    let set: HashMap[char, bool] = HashMap::new();
    for character in characters.chars() {
        set.set(character, true);
    }
    set
}

pub fn find_any(input: Slice[byte], characters: string) -> Option[isize] {
    if characters.byte_len() == 0 {
        return Option::None
    }
    let set = scalar_set(characters);
    find_by(input, |value: char| set.contains(value))
}

pub fn rfind_any(input: Slice[byte], characters: string) -> Option[isize] {
    if characters.byte_len() == 0 {
        return Option::None
    }
    let set = scalar_set(characters);
    rfind_by(input, |value: char| set.contains(value))
}

pub fn fields_by_iter(input: Slice[byte], separator: (char) -> bool) -> FnIterator[Slice[byte]] {
    let offset = Ref::new(0);
    FnIterator::from_fn(
        || {
            let mut start: Option[isize] = Option::None;
            while offset.get() < input.len() {
                let index = offset.get();
                let (character, width) = decode_scalar(input, index);
                offset.set(index + width);
                if separator(character) {
                    match start {
                        Option::Some(first) => return Option::Some(input.sub(first, index)),
                        Option::None => (),
                    }
                } else if start.is_none() {
                    start = Option::Some(index);
                }
            }
            match start {
                Option::Some(first) => Option::Some(input.sub(first, input.len())),
                Option::None => Option::None,
            }
        },
    )
}

pub fn fields_iter(input: Slice[byte]) -> FnIterator[Slice[byte]] {
    fields_by_iter(input, |value: char| unicode::is_whitespace(value))
}

pub fn fields_by(input: Slice[byte], separator: (char) -> bool, max_fields: isize) -> Result[
    Vec[Slice[byte]],
    TransformError,
] {
    check_limit(max_fields)?;
    let result: Vec[Slice[byte]] = Vec::new();
    for field in fields_by_iter(input, separator) {
        push_part(result, field, max_fields)?;
    }
    Result::Ok(result)
}

pub fn fields(input: Slice[byte], max_fields: isize) -> Result[Vec[Slice[byte]], TransformError] {
    fields_by(input, |value: char| unicode::is_whitespace(value), max_fields)
}

pub fn trim_start_by(input: Slice[byte], remove: (char) -> bool) -> Slice[byte] {
    let mut offset = 0;
    while offset < input.len() {
        let (character, width) = decode_scalar(input, offset);
        if !remove(character) {
            break
        }
        offset += width;
    }
    input.sub(offset, input.len())
}

pub fn trim_end_by(input: Slice[byte], remove: (char) -> bool) -> Slice[byte] {
    let mut end = input.len();
    while end > 0 {
        let (character, width) = decode_last_scalar(input, end);
        if !remove(character) {
            break
        }
        end -= width;
    }
    input.sub(0, end)
}

pub fn trim_by(input: Slice[byte], remove: (char) -> bool) -> Slice[byte] {
    trim_end_by(trim_start_by(input, remove), remove)
}

pub fn trim_space(input: Slice[byte]) -> Slice[byte] {
    trim_by(input, |value: char| unicode::is_whitespace(value))
}

pub fn trim_chars(input: Slice[byte], characters: string) -> Slice[byte] {
    let set = scalar_set(characters);
    trim_by(input, |value: char| set.contains(value))
}

pub fn trim_start_chars(input: Slice[byte], characters: string) -> Slice[byte] {
    let set = scalar_set(characters);
    trim_start_by(input, |value: char| set.contains(value))
}

pub fn trim_end_chars(input: Slice[byte], characters: string) -> Slice[byte] {
    let set = scalar_set(characters);
    trim_end_by(input, |value: char| set.contains(value))
}

pub fn map_chars(input: Slice[byte], transform: (char) -> Option[char], max_bytes: isize) -> Result[
    Bytes,
    TransformError,
] {
    check_limit(max_bytes)?;
    let result = Builder::new();
    let mut offset = 0;
    while offset < input.len() {
        let (character, width) = decode_scalar(input, offset);
        offset += width;
        match transform(character) {
            Option::None => (),
            Option::Some(mapped) => {
                let encoded = mapped.to_string();
                output_length(add_length(result.len(), encoded.byte_len())?, max_bytes)?;
                for index in 0..encoded.byte_len() {
                    result.push(encoded.byte_get(index));
                }
            },
        }
    }
    Result::Ok(result.finish())
}

pub fn case_with(
    input: Slice[byte],
    special: unicode::SpecialCase,
    kind: unicode::Case,
    max_bytes: isize,
) -> Result[Bytes, TransformError] {
    map_chars(input, |value: char| Option::Some(special.to_case(value, kind)), max_bytes)
}

pub fn to_case(input: Slice[byte], kind: unicode::Case, max_bytes: isize) -> Result[
    Bytes,
    TransformError,
] {
    map_chars(input, |value: char| Option::Some(unicode::to_case(value, kind)), max_bytes)
}

pub fn equal_fold(left: Slice[byte], right: Slice[byte]) -> bool {
    let mut first = 0;
    let mut second = 0;
    while first < left.len() && second < right.len() {
        let (a, a_width) = decode_scalar(left, first);
        let (b, b_width) = decode_scalar(right, second);
        first += a_width;
        second += b_width;
        if a != b {
            let mut next = unicode::simple_fold(a);
            while next != a && next != b {
                next = unicode::simple_fold(next);
            }
            if next != b {
                return false
            }
        }
    }
    first == left.len() && second == right.len()
}
