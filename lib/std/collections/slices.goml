package collections;

use module::cmp;

const SEQUENCE_MAX: isize = 9223372036854775807;

pub enum SequenceError {
    InvalidRange(isize, isize, isize),
    InvalidCount(isize),
    LengthOverflow,
}

impl ToString for SequenceError {
    fn to_string(self: SequenceError) -> string {
        match self {
            SequenceError::InvalidRange(start, end, length) => f"invalid sequence range {start}..{end} for length {length}",
            SequenceError::InvalidCount(count) => f"invalid sequence count {count}",
            SequenceError::LengthOverflow => "sequence length overflows isize",
        }
    }
}

impl Debug for SequenceError {
    fn debug(self: SequenceError) -> string {
        self.to_string()
    }
}

pub fn slice_equal_by[A, B](left: Slice[A], right: Slice[B], equal: (A, B) -> bool) -> bool {
    if left.len() != right.len() {
        return false
    }
    for index in 0..left.len() {
        if !equal(left[index], right[index]) {
            return false
        }
    }
    true
}

pub fn slice_equal[T: PartialEq](left: Slice[T], right: Slice[T]) -> bool {
    slice_equal_by(left, right, |first: T, second: T| first == second)
}

pub fn slice_compare_by[A, B](left: Slice[A], right: Slice[B], compare: (A, B) -> cmp::Ordering) -> cmp::Ordering {
    let length = if left.len() < right.len() {
        left.len()
    } else {
        right.len()
    };
    for index in 0..length {
        let order = compare(left[index], right[index]);
        if order != cmp::Ordering::Equal {
            return order
        }
    }
    cmp::compare(left.len(), right.len())
}

pub fn slice_compare[T: cmp::Ord](left: Slice[T], right: Slice[T]) -> cmp::Ordering {
    slice_compare_by(left, right, |first: T, second: T| cmp::compare(first, second))
}

pub fn slice_index_by[T](values: Slice[T], predicate: (T) -> bool) -> Option[isize] {
    for index in 0..values.len() {
        if predicate(values[index]) {
            return Option::Some(index)
        }
    }
    Option::None
}

pub fn slice_index[T: PartialEq](values: Slice[T], expected: T) -> Option[isize] {
    slice_index_by(values, |value: T| value == expected)
}

pub fn slice_contains_by[T](values: Slice[T], predicate: (T) -> bool) -> bool {
    slice_index_by(values, predicate).is_some()
}

pub fn slice_contains[T: PartialEq](values: Slice[T], expected: T) -> bool {
    slice_index(values, expected).is_some()
}

pub fn slice_concat[T](parts: Vec[Slice[T]]) -> Result[Vec[T], SequenceError] {
    let mut length = 0;
    for part in parts {
        if part.len() > SEQUENCE_MAX - length {
            return Result::Err(SequenceError::LengthOverflow)
        }
        length += part.len();
    }
    let result: Vec[T] = Vec::with_capacity(length);
    for part in parts {
        for value in part {
            result.push(value)
        }
    }
    Result::Ok(result)
}

pub fn slice_repeat[T](values: Slice[T], count: isize) -> Result[Vec[T], SequenceError] {
    if count < 0 {
        return Result::Err(SequenceError::InvalidCount(count))
    }
    if values.len() > 0 && count > SEQUENCE_MAX / values.len() {
        return Result::Err(SequenceError::LengthOverflow)
    }
    let length = values.len() * count;
    let result: Vec[T] = Vec::with_capacity(length);
    if length > 0 {
        for _ in 0..count {
            for value in values {
                result.push(value)
            }
        }
    }
    Result::Ok(result)
}

pub fn vec_replace[T](values: Vec[T], start: isize, end: isize, replacement: Slice[T]) -> Result[
    (),
    SequenceError,
] {
    let length = values.len();
    if start < 0 || end < start || end > length {
        return Result::Err(SequenceError::InvalidRange(start, end, length))
    }
    let retained = length - (end - start);
    if replacement.len() > SEQUENCE_MAX - retained {
        return Result::Err(SequenceError::LengthOverflow)
    }
    let combined = slice_concat(
        Vec::from_array([values.slice(0, start), replacement, values.slice(end, length)]),
    )?;
    for index in 0..combined.len() {
        if index < length {
            values[index] = combined[index];
        } else {
            values.push(combined[index])
        }
    }
    values.truncate(combined.len());
    Result::Ok(())
}

pub fn vec_insert_slice[T](values: Vec[T], index: isize, inserted: Slice[T]) -> Result[
    (),
    SequenceError,
] {
    vec_replace(values, index, index, inserted)
}

pub fn vec_delete_range[T](values: Vec[T], start: isize, end: isize) -> Result[(), SequenceError] {
    vec_replace(values, start, end, values.slice(0, 0))
}

pub fn vec_delete_if[T](values: Vec[T], predicate: (T) -> bool) -> isize {
    let length = values.len();
    let mut output = 0;
    for index in 0..length {
        let value = values[index];
        if !predicate(value) {
            values[output] = value;
            output += 1;
        }
    }
    values.truncate(output);
    length - output
}

pub fn vec_grow[T](values: Vec[T], additional: isize) -> Result[(), SequenceError] {
    if additional < 0 {
        return Result::Err(SequenceError::InvalidCount(additional))
    }
    if additional > SEQUENCE_MAX - values.len() {
        return Result::Err(SequenceError::LengthOverflow)
    }
    values.reserve(additional);
    Result::Ok(())
}

pub fn slice_reverse[T](values: MutSlice[T]) -> () {
    let mut left = 0;
    let mut right = values.len();
    while left < right {
        right -= 1;
        let value = values[left];
        values[left] = values[right];
        values[right] = value;
        left += 1;
    }
}

pub fn slice_all[T](values: Slice[T]) -> FnIterator[(isize, T)] {
    let next = Ref::new(0);
    FnIterator::from_fn(
        || {
            let index = next.get();
            if index < values.len() {
                next.set(index + 1);
                Option::Some((index, values[index]))
            } else {
                Option::None
            }
        },
    )
}

pub fn slice_backward[T](values: Slice[T]) -> FnIterator[(isize, T)] {
    let next = Ref::new(values.len());
    FnIterator::from_fn(
        || {
            if next.get() > 0 {
                let index = next.get() - 1;
                next.set(index);
                Option::Some((index, values[index]))
            } else {
                Option::None
            }
        },
    )
}

pub fn slice_chunks[T](values: Slice[T], size: isize) -> Result[FnIterator[Slice[T]], SequenceError] {
    if size <= 0 {
        return Result::Err(SequenceError::InvalidCount(size))
    }
    let next = Ref::new(0);
    Result::Ok(
        FnIterator::from_fn(
            || {
                let start = next.get();
                if start >= values.len() {
                    Option::None
                } else {
                    let remaining = values.len() - start;
                    let count = if size < remaining {
                        size
                    } else {
                        remaining
                    };
                    let end = start + count;
                    next.set(end);
                    Option::Some(values.sub(start, end))
                }
            },
        ),
    )
}

pub fn vec_append_iter[I: Iterator](iterator: I, values: Vec[I::Item]) -> () {
    for value in iterator {
        values.push(value)
    }
}

pub fn slice_collect[T, I: Iterator](iterator: I) -> Vec[T] where I::Item = T {
    let result = Vec::new();
    vec_append_iter(iterator, result);
    result
}

pub fn slice_sorted_by[T, I: Iterator](iterator: I, compare: (T, T) -> isize) -> Vec[T]
where
    I::Item = T,
{
    let result = slice_collect(iterator);
    stable_sort_by(result, compare);
    result
}

pub fn slice_sorted[T: cmp::Ord, I: Iterator](iterator: I) -> Vec[T] where I::Item = T {
    let result = slice_collect(iterator);
    stable_sort(result);
    result
}

pub fn slice_sort_by[T](values: MutSlice[T], compare: (T, T) -> isize) -> () {
    let sorted = values.as_slice().to_vec();
    stable_sort_by(sorted, compare);
    for index in 0..sorted.len() {
        values[index] = sorted[index];
    }
}

pub fn slice_sort[T: cmp::Ord](values: MutSlice[T]) -> () {
    slice_sort_by(values, |left: T, right: T| cmp::compare(left, right).to_isize())
}

pub fn slice_is_sorted_by[T](values: Slice[T], compare: (T, T) -> isize) -> bool {
    for index in 1..values.len() {
        if compare(values[index - 1], values[index]) > 0 {
            return false
        }
    }
    true
}

pub fn slice_is_sorted[T: cmp::Ord](values: Slice[T]) -> bool {
    slice_is_sorted_by(values, |left: T, right: T| cmp::compare(left, right).to_isize())
}

pub fn slice_binary_search_by[T](values: Slice[T], compare: (T) -> isize) -> (isize, bool) {
    let index = search(values.len(), |index: isize| compare(values[index]) >= 0).unwrap_or(
        values.len(),
    );
    (index, index < values.len() && compare(values[index]) == 0)
}

pub fn slice_binary_search[T: cmp::Ord](values: Slice[T], expected: T) -> (isize, bool) {
    slice_binary_search_by(values, |value: T| cmp::compare(value, expected).to_isize())
}

pub fn slice_min_by[T](values: Slice[T], compare: (T, T) -> isize) -> Option[T] {
    if values.len() == 0 {
        return Option::None
    }
    let mut best = values[0];
    for index in 1..values.len() {
        if compare(values[index], best) < 0 {
            best = values[index];
        }
    }
    Option::Some(best)
}

pub fn slice_max_by[T](values: Slice[T], compare: (T, T) -> isize) -> Option[T] {
    if values.len() == 0 {
        return Option::None
    }
    let mut best = values[0];
    for index in 1..values.len() {
        if compare(values[index], best) > 0 {
            best = values[index];
        }
    }
    Option::Some(best)
}

pub fn slice_min[T: cmp::Ord](values: Slice[T]) -> Option[T] {
    slice_min_by(values, |left: T, right: T| cmp::compare(left, right).to_isize())
}

pub fn slice_max[T: cmp::Ord](values: Slice[T]) -> Option[T] {
    slice_max_by(values, |left: T, right: T| cmp::compare(left, right).to_isize())
}
