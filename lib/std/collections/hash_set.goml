package collections;

pub struct HashSet[K] {
    pub entries: HashMap[K, ()],
}

impl[K: Eq + Hash] Default for HashSet[K] {
    fn default() -> HashSet[K] {
        HashSet::new()
    }
}

impl[K: Eq + Hash] HashSet[K] {
    pub fn new() -> HashSet[K] {
        HashSet { entries: HashMap::new() }
    }

    pub fn len(self: HashSet[K]) -> isize {
        self.entries.len()
    }

    pub fn is_empty(self: HashSet[K]) -> bool {
        self.entries.len() == 0
    }

    pub fn contains(self: HashSet[K], value: K) -> bool {
        self.entries.contains(value)
    }

    pub fn insert(self: HashSet[K], value: K) -> bool {
        self.entries.insert(value, ()).is_none()
    }

    pub fn remove(self: HashSet[K], value: K) -> bool {
        self.entries.remove_value(value).is_some()
    }

    pub fn to_vec(self: HashSet[K]) -> Vec[K] {
        let result: Vec[K] = Vec::with_capacity(self.len());
        for entry in self.entries.entries() {
            result.push(entry.0)
        }
        result
    }
}
