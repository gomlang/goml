package collections;

struct IndexMapEntry[K, V] {
    hash: u64,
    key: K,
    value: V,
}

enum IndexMapProbe {
    Found(isize, isize),
    Vacant(isize),
}

pub struct IndexMap[K, V] {
    indices: Ref[Vec[isize]],
    entries: Ref[Vec[Option[IndexMapEntry[K, V]]]],
    len: Ref[isize],
    deleted: Ref[isize],
}

impl[K: Eq + Hash, V] Default for IndexMap[K, V] {
    fn default() -> IndexMap[K, V] {
        IndexMap::new()
    }
}

fn index_map_capacity_for_entries(entries: isize) -> isize {
    let requested = if entries < 0 {
        0
    } else {
        entries
    };
    let mut capacity = 8;
    while requested * 3 >= capacity * 2 {
        capacity *= 2;
    }
    capacity
}

fn index_map_empty_indices(capacity: isize) -> Vec[isize] {
    let indices = Vec::with_capacity(capacity);
    for _ in 0..capacity {
        indices.push(-1);
    }
    indices
}

impl[K: Eq + Hash, V] IndexMap[K, V] {
    pub fn new() -> IndexMap[K, V] {
        IndexMap::with_capacity(0)
    }

    pub fn with_capacity(capacity: isize) -> IndexMap[K, V] {
        let entry_capacity = if capacity < 0 {
            0
        } else {
            capacity
        };
        IndexMap {
            indices: Ref::new(
                index_map_empty_indices(index_map_capacity_for_entries(entry_capacity)),
            ),
            entries: Ref::new(Vec::with_capacity(entry_capacity)),
            len: Ref::new(0),
            deleted: Ref::new(0),
        }
    }

    pub fn len(self: IndexMap[K, V]) -> isize {
        self.len.get()
    }

    pub fn is_empty(self: IndexMap[K, V]) -> bool {
        self.len.get() == 0
    }

    fn probe(self: IndexMap[K, V], key: K, hash: u64) -> IndexMapProbe {
        let indices = self.indices.get();
        let mask = indices.len() - 1;
        let mut position = (hash & mask.to_u64()).to_isize();
        let mut perturb = hash;
        let mut first_deleted = -1;
        loop {
            let dense_index = indices[position];
            if dense_index == -1 {
                return IndexMapProbe::Vacant(
                    if first_deleted >= 0 {
                        first_deleted
                    } else {
                        position
                    },
                )
            } else if dense_index == -2 {
                if first_deleted < 0 {
                    first_deleted = position;
                }
            } else {
                if let Some(entry) = self.entries.get()[dense_index] {
                    if entry.hash == hash && PartialEq::eq(entry.key, key) {
                        return IndexMapProbe::Found(position, dense_index)
                    }
                }
            }
            position = ((position.to_u64() * 5 + perturb + 1) & mask.to_u64()).to_isize();
            perturb >>= 5;
        }
    }

    fn place_entry_index(self: IndexMap[K, V], dense_index: isize) -> () {
        if let Some(entry) = self.entries.get()[dense_index] {
            match self.probe(entry.key, entry.hash) {
                Found(slot, _) => {
                    self.indices.get()[slot] = dense_index;
                },
                Vacant(slot) => {
                    self.indices.get()[slot] = dense_index;
                },
            }
        }
    }

    fn rebuild(self: IndexMap[K, V], requested_entries: isize) -> () {
        let live_entries = self.len.get();
        let desired_entries = if requested_entries > live_entries {
            requested_entries
        } else {
            live_entries
        };
        let old_entries = self.entries.get();
        let next_entries: Vec[Option[IndexMapEntry[K, V]]] = Vec::with_capacity(desired_entries);
        for old_entry in old_entries {
            if let Some(entry) = old_entry {
                next_entries.push(Option::Some(entry))
            }
        }
        self.entries.set(next_entries);
        self.indices.set(index_map_empty_indices(index_map_capacity_for_entries(desired_entries)));
        self.deleted.set(0);
        let mut dense_index = 0;
        while dense_index < self.entries.get().len() {
            self.place_entry_index(dense_index);
            dense_index += 1;
        }
    }

    fn ensure_insert_capacity(self: IndexMap[K, V]) -> () {
        let occupied = self.len.get() + self.deleted.get();
        if (occupied + 1) * 3 >= self.indices.get().len() * 2 {
            self.rebuild(self.len.get() + 1)
        }
    }

    fn compact_after_remove(self: IndexMap[K, V]) -> () {
        if self.len.get() == 0 {
            self.clear()
        } else if self.deleted.get() >= 8 && self.deleted.get() > self.len.get() {
            self.rebuild(self.len.get())
        }
    }

    pub fn contains(self: IndexMap[K, V], key: K) -> bool {
        let hash = Hash::hash(key);
        match self.probe(key, hash) {
            Found(_, _) => true,
            Vacant(_) => false,
        }
    }

    pub fn get(self: IndexMap[K, V], key: K) -> Option[V] {
        let hash = Hash::hash(key);
        match self.probe(key, hash) {
            Found(_, dense_index) => {
                self.entries.get()[dense_index].map(|entry| entry.value)
            },
            Vacant(_) => Option::None,
        }
    }

    pub fn insert(self: IndexMap[K, V], key: K, value: V) -> Option[V] {
        self.ensure_insert_capacity();
        let hash = Hash::hash(key);
        match self.probe(key, hash) {
            Found(_, dense_index) => {
                match self.entries.get()[dense_index] {
                    Some(entry) => {
                        let previous = entry.value;
                        self.entries.get()[dense_index] = Option::Some(
                            IndexMapEntry { hash: entry.hash, key: entry.key, value },
                        );
                        Option::Some(previous)
                    },
                    None => Option::None,
                }
            },
            Vacant(slot) => {
                let dense_index = self.entries.get().len();
                self.entries.get().push(Option::Some(IndexMapEntry { hash, key, value }));
                self.indices.get()[slot] = dense_index;
                self.len.set(self.len.get() + 1);
                Option::None
            },
        }
    }

    pub fn remove(self: IndexMap[K, V], key: K) -> Option[V] {
        let hash = Hash::hash(key);
        match self.probe(key, hash) {
            Found(slot, dense_index) => {
                match self.entries.get()[dense_index] {
                    Some(entry) => {
                        self.indices.get()[slot] = -2;
                        self.entries.get()[dense_index] = Option::None;
                        self.len.set(self.len.get() - 1);
                        self.deleted.set(self.deleted.get() + 1);
                        self.compact_after_remove();
                        Option::Some(entry.value)
                    },
                    None => Option::None,
                }
            },
            Vacant(_) => Option::None,
        }
    }

    pub fn reserve(self: IndexMap[K, V], additional: isize) -> () {
        if additional <= 0 {} else {
            let desired_entries = self.len.get() + additional;
            let desired_capacity = index_map_capacity_for_entries(desired_entries);
            if desired_capacity > self.indices.get().len() || self.deleted.get() > 0 {
                self.rebuild(desired_entries)
            } else {
                self.entries.get().reserve(additional)
            }
        }
    }

    pub fn clear(self: IndexMap[K, V]) -> () {
        let capacity = self.indices.get().len();
        self.indices.set(index_map_empty_indices(capacity));
        self.entries.get().clear();
        self.len.set(0);
        self.deleted.set(0)
    }

    pub fn entries(self: IndexMap[K, V]) -> Vec[(K, V)] {
        let result = Vec::with_capacity(self.len.get());
        for value in self.entries.get() {
            if let Some(entry) = value {
                result.push((entry.key, entry.value))
            }
        }
        result
    }

    pub fn keys(self: IndexMap[K, V]) -> Vec[K] {
        let result = Vec::with_capacity(self.len.get());
        for value in self.entries.get() {
            if let Some(entry) = value {
                result.push(entry.key)
            }
        }
        result
    }

    pub fn values(self: IndexMap[K, V]) -> Vec[V] {
        let result = Vec::with_capacity(self.len.get());
        for value in self.entries.get() {
            if let Some(entry) = value {
                result.push(entry.value)
            }
        }
        result
    }

    pub fn iter(self: IndexMap[K, V]) -> FnIterator[(K, V)] {
        let mut index = 0;
        let entries_len = self.entries.get().len();
        FnIterator::from_fn(
            || {
                while index < entries_len {
                    let current = index;
                    index += 1;
                    if let Some(entry) = self.entries.get()[current] {
                        return Option::Some((entry.key, entry.value))
                    }
                }
                Option::None
            },
        )
    }
}

impl[K: Eq + Hash, V] IntoIterator for IndexMap[K, V] {
    type Item = (K, V);

    type IntoIter = FnIterator[(K, V)];

    fn into_iter(self: IndexMap[K, V]) -> FnIterator[(K, V)] {
        self.iter()
    }
}
