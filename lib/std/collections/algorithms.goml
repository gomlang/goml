package collections;

use module::cmp;

pub fn stable_sort_by[T](values: Vec[T], compare: (T, T) -> isize) -> () {
    values.stable_sort_by(compare)
}

pub fn sort_by[T](values: Vec[T], compare: (T, T) -> isize) -> () {
    values.sort_by(compare)
}

pub fn stable_sort_by_ordering[T](values: Vec[T], compare: (T, T) -> cmp::Ordering) -> () {
    values.stable_sort_by_ordering(compare)
}

pub fn sort_by_ordering[T](values: Vec[T], compare: (T, T) -> cmp::Ordering) -> () {
    values.sort_by_ordering(compare)
}

pub fn stable_sort[T: cmp::Ord](values: Vec[T]) -> () {
    values.stable_sort_by_ordering(|left: T, right: T| cmp::compare(left, right))
}

pub fn sort[T: cmp::Ord](values: Vec[T]) -> () {
    values.sort_by_ordering(|left: T, right: T| cmp::compare(left, right))
}

pub fn binary_search_by[T](values: Vec[T], compare: (T) -> isize) -> Option[isize] {
    values.binary_search_by(compare)
}

pub fn binary_search_by_ordering[T](values: Vec[T], compare: (T) -> cmp::Ordering) -> Option[isize] {
    values.binary_search_by_ordering(compare)
}

pub fn binary_search[T: cmp::Ord](values: Vec[T], expected: T) -> Option[isize] {
    values.binary_search_by_ordering(|value: T| cmp::compare(value, expected))
}

pub fn position_by[T](values: Vec[T], predicate: (T) -> bool) -> Option[isize] {
    values.position(predicate)
}

pub fn min_by[T](values: Vec[T], compare: (T, T) -> isize) -> Option[T] {
    values.min_by(compare)
}

pub fn max_by[T](values: Vec[T], compare: (T, T) -> isize) -> Option[T] {
    values.max_by(compare)
}

pub fn min_by_ordering[T](values: Vec[T], compare: (T, T) -> cmp::Ordering) -> Option[T] {
    values.min_by_ordering(compare)
}

pub fn max_by_ordering[T](values: Vec[T], compare: (T, T) -> cmp::Ordering) -> Option[T] {
    values.max_by_ordering(compare)
}

pub fn min[T: cmp::Ord](values: Vec[T]) -> Option[T] {
    values.min_by_ordering(|left: T, right: T| cmp::compare(left, right))
}

pub fn max[T: cmp::Ord](values: Vec[T]) -> Option[T] {
    values.max_by_ordering(|left: T, right: T| cmp::compare(left, right))
}

pub fn dedup_by[T](values: Vec[T], equal: (T, T) -> bool) -> () {
    values.dedup_by(equal)
}

pub fn dedup[T: PartialEq](values: Vec[T]) -> () {
    values.dedup()
}

pub fn search(length: isize, predicate: (isize) -> bool) -> Option[isize] {
    if length < 0 {
        return Option::None
    }
    let mut low = 0;
    let mut high = length;
    while low < high {
        let middle = low + (high - low) / 2;
        if predicate(middle) {
            high = middle;
        } else {
            low = middle + 1;
        }
    }
    Option::Some(low)
}

pub fn search_by(length: isize, compare: (isize) -> isize) -> Option[(isize, bool)] {
    let index = match search(length, |index: isize| compare(index) >= 0) {
        Some(index) => index,
        None => return Option::None,
    };
    Option::Some((index, index < length && compare(index) == 0))
}

pub fn search_by_ordering(length: isize, compare: (isize) -> cmp::Ordering) -> Option[(isize, bool)] {
    search_by(length, |index: isize| compare(index).to_isize())
}

pub fn lower_bound_by[T](values: Vec[T], compare: (T) -> isize) -> isize {
    search(values.len(), |index: isize| compare(values[index]) >= 0).unwrap_or(values.len())
}

pub fn upper_bound_by[T](values: Vec[T], compare: (T) -> isize) -> isize {
    search(values.len(), |index: isize| compare(values[index]) > 0).unwrap_or(values.len())
}

pub fn lower_bound_by_ordering[T](values: Vec[T], compare: (T) -> cmp::Ordering) -> isize {
    lower_bound_by(values, |value: T| compare(value).to_isize())
}

pub fn upper_bound_by_ordering[T](values: Vec[T], compare: (T) -> cmp::Ordering) -> isize {
    upper_bound_by(values, |value: T| compare(value).to_isize())
}

pub fn lower_bound[T: cmp::Ord](values: Vec[T], expected: T) -> isize {
    lower_bound_by_ordering(values, |value: T| cmp::compare(value, expected))
}

pub fn upper_bound[T: cmp::Ord](values: Vec[T], expected: T) -> isize {
    upper_bound_by_ordering(values, |value: T| cmp::compare(value, expected))
}

pub fn equal_range_by[T](values: Vec[T], compare: (T) -> isize) -> (isize, isize) {
    (lower_bound_by(values, compare), upper_bound_by(values, compare))
}

pub fn equal_range_by_ordering[T](values: Vec[T], compare: (T) -> cmp::Ordering) -> (isize, isize) {
    (lower_bound_by_ordering(values, compare), upper_bound_by_ordering(values, compare))
}

pub fn equal_range[T: cmp::Ord](values: Vec[T], expected: T) -> (isize, isize) {
    (lower_bound(values, expected), upper_bound(values, expected))
}

pub fn is_sorted_by[T](values: Vec[T], compare: (T, T) -> isize) -> bool {
    for index in 1..values.len() {
        if compare(values[index - 1], values[index]) > 0 {
            return false
        }
    }
    true
}

pub fn is_sorted_by_ordering[T](values: Vec[T], compare: (T, T) -> cmp::Ordering) -> bool {
    is_sorted_by(values, |left: T, right: T| compare(left, right).to_isize())
}

pub fn is_sorted[T: cmp::Ord](values: Vec[T]) -> bool {
    is_sorted_by_ordering(values, |left: T, right: T| cmp::compare(left, right))
}
