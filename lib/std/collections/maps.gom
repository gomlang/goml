package collections;

pub fn map_clone[K: Hash + Eq, V](source: HashMap[K, V]) -> HashMap[K, V] {
    let result = HashMap::new();
    map_copy(result, source);
    result
}

pub fn map_copy[K: Hash + Eq, V](destination: HashMap[K, V], source: HashMap[K, V]) -> () {
    for (key, value) in source.entries() {
        destination.set(key, value)
    }
}

pub fn map_equal_by[K: Hash + Eq, A, B](
    left: HashMap[K, A],
    right: HashMap[K, B],
    equal: (A, B) -> bool,
) -> bool {
    if left.len() != right.len() {
        return false
    }
    for (key, value) in left.entries() {
        match right.get(key) {
            Option::Some(other) => if !equal(value, other) {
                return false
            },
            Option::None => return false,
        }
    }
    true
}

pub fn map_equal[K: Hash + Eq, V: PartialEq](left: HashMap[K, V], right: HashMap[K, V]) -> bool {
    map_equal_by(left, right, |value: V, other: V| value == other)
}

pub fn map_delete_if[K: Hash + Eq, V](values: HashMap[K, V], predicate: (K, V) -> bool) -> isize {
    let mut removed = 0;
    for (key, value) in values.entries() {
        if predicate(key, value) && values.remove_value(key).is_some() {
            removed += 1;
        }
    }
    removed
}

pub fn map_all[K: Hash + Eq, V](values: HashMap[K, V]) -> FnIterator[(K, V)] {
    values.entries().iter()
}

pub fn map_keys[K: Hash + Eq, V](values: HashMap[K, V]) -> FnIterator[K] {
    let entries = values.entries().iter();
    FnIterator::from_fn(|| entries.next().map(|entry: (K, V)| entry.0))
}

pub fn map_values[K: Hash + Eq, V](values: HashMap[K, V]) -> FnIterator[V] {
    let entries = values.entries().iter();
    FnIterator::from_fn(|| entries.next().map(|entry: (K, V)| entry.1))
}

pub fn map_insert[K: Hash + Eq, V, I: Iterator](destination: HashMap[K, V], entries: I) -> ()
where
    I::Item = (K, V),
{
    for (key, value) in entries {
        destination.set(key, value)
    }
}

pub fn map_collect[K: Hash + Eq, V, I: Iterator](entries: I) -> HashMap[K, V]
where
    I::Item = (K, V),
{
    let result = HashMap::new();
    map_insert(result, entries);
    result
}
