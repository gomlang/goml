package collections;

pub struct Index[T] {
    pub value: isize,
}

impl[T] Index[T] {
    pub fn value(self: Index[T]) -> isize {
        self.value
    }
}

impl[T] PartialEq for Index[T] {
    fn eq(self: Index[T], other: Index[T]) -> bool {
        self.value == other.value
    }
}

impl[T] Eq for Index[T] {}

impl[T] Hash for Index[T] {
    fn hash(self: Index[T]) -> u64 {
        Hash::hash(self.value)
    }
}

pub struct IndexVec[T] {
    pub values: Vec[T],
}

impl[T] Default for IndexVec[T] {
    fn default() -> IndexVec[T] {
        IndexVec::new()
    }
}

impl[T] IndexVec[T] {
    pub fn new() -> IndexVec[T] {
        IndexVec { values: Vec::new() }
    }

    pub fn with_capacity(capacity: isize) -> IndexVec[T] {
        IndexVec { values: Vec::with_capacity(capacity) }
    }

    pub fn len(self: IndexVec[T]) -> isize {
        self.values.len()
    }

    pub fn is_empty(self: IndexVec[T]) -> bool {
        self.values.is_empty()
    }

    pub fn push(self: IndexVec[T], value: T) -> Index[T] {
        let index = Index { value: self.values.len() };
        self.values.push(value);
        index
    }

    pub fn contains(self: IndexVec[T], index: Index[T]) -> bool {
        index.value >= 0 && index.value < self.values.len()
    }

    pub fn get(self: IndexVec[T], index: Index[T]) -> T {
        self.values[index.value]
    }

    pub fn try_get(self: IndexVec[T], index: Index[T]) -> Option[T] {
        if self.contains(index) {
            Option::Some(self.values[index.value])
        } else {
            Option::None
        }
    }

    pub fn set(self: IndexVec[T], index: Index[T], value: T) -> () {
        self.values[index.value] = value;
    }
}
