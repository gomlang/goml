package collections;

pub struct Stack[T] {
    pub values: Vec[T],
}

impl[T] Default for Stack[T] {
    fn default() -> Stack[T] {
        Stack::new()
    }
}

impl[T] Stack[T] {
    pub fn new() -> Stack[T] {
        Stack { values: Vec::new() }
    }

    pub fn with_capacity(capacity: isize) -> Stack[T] {
        Stack { values: Vec::with_capacity(capacity) }
    }

    pub fn len(self: Stack[T]) -> isize {
        self.values.len()
    }

    pub fn is_empty(self: Stack[T]) -> bool {
        self.values.is_empty()
    }

    pub fn push(self: Stack[T], value: T) -> () {
        self.values.push(value)
    }

    pub fn pop(self: Stack[T]) -> Option[T] {
        self.values.pop()
    }

    pub fn peek(self: Stack[T]) -> Option[T] {
        self.values.last()
    }

    pub fn clear(self: Stack[T]) -> () {
        self.values.clear()
    }
}
