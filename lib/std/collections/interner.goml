package collections;

pub struct Symbol {
    pub index: isize,
}

impl Symbol {
    pub fn index(self: Symbol) -> isize {
        self.index
    }
}

impl PartialEq for Symbol {
    fn eq(self: Symbol, other: Symbol) -> bool {
        self.index == other.index
    }
}

impl Eq for Symbol {}

impl Hash for Symbol {
    fn hash(self: Symbol) -> u64 {
        Hash::hash(self.index)
    }
}

pub struct Interner {
    pub symbols: HashMap[string, Symbol],
    pub values: Vec[string],
}

impl Default for Interner {
    fn default() -> Interner {
        Interner::new()
    }
}

impl Interner {
    pub fn new() -> Interner {
        Interner { symbols: HashMap::new(), values: Vec::new() }
    }

    pub fn len(self: Interner) -> isize {
        self.values.len()
    }

    pub fn is_empty(self: Interner) -> bool {
        self.values.is_empty()
    }

    pub fn contains(self: Interner, value: string) -> bool {
        self.symbols.contains(value)
    }

    pub fn intern(self: Interner, value: string) -> Symbol {
        match self.symbols[value] {
            Some(symbol) => symbol,
            None => {
                let symbol = Symbol { index: self.values.len() };
                self.values.push(value);
                self.symbols[value] = symbol;
                symbol
            },
        }
    }

    pub fn get(self: Interner, symbol: Symbol) -> string {
        self.values[symbol.index]
    }

    pub fn resolve(self: Interner, symbol: Symbol) -> Option[string] {
        if symbol.index >= 0 && symbol.index < self.values.len() {
            Option::Some(self.values[symbol.index])
        } else {
            Option::None
        }
    }
}
