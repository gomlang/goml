package tests;

use std::collections;

#[test]
fn index_map_replacement_preserves_active_traversal() -> () {
    let values: collections::IndexMap[isize, isize] = collections::IndexMap::new();
    for key in 0..5 {
        assert_equal(values.insert(key, key), Option::None);
    }
    assert_equal(values.remove(0), Option::Some(0));
    let entries = values.iter();
    assert_equal(entries.next(), Option::Some((1, 1)));
    assert_equal(values.insert(3, 30), Option::Some(3));
    assert_equal(entries.next(), Option::Some((2, 2)));
    assert_equal(entries.next(), Option::Some((3, 30)));
    assert_equal(entries.next(), Option::Some((4, 4)));
    assert_equal(entries.next(), Option::None);
    values.clear();
    assert_equal(values.len(), 0);
    assert_equal(values.get(3), Option::None);
    assert_equal(values.insert(3, 300), Option::None);
    assert_equal(values.entries(), Vec::from_array([(3, 300)]));
}
