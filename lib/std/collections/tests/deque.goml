package tests;

use std::collections;
use std::testing;

#[test]
fn native_deque_pop_storage() -> () {
    let deque: collections::Deque[isize] = collections::Deque::with_capacity(3);
    let alias = deque;
    let slots = deque.slots.get();
    deque.push_back(1);
    deque.push_back(2);
    deque.push_back(3);
    assert_equal(alias.pop_front(), Option::Some(1));
    assert_equal(slots[0], Option::None);
    deque.push_back(4);
    assert_equal(slots[0], Option::Some(4));
    assert_equal(alias.pop_back(), Option::Some(4));
    assert_equal(slots[0], Option::None);
    assert_equal(deque.pop_front(), Option::Some(2));
    assert_equal(deque.pop_back(), Option::Some(3));
    testing::assert(deque.is_empty());
    assert_equal(deque.head.get(), 0);
    assert_equal(slots, Vec::from_array([Option::None, Option::None, Option::None]));
    testing::assert(deque.pop_front().is_none());
    testing::assert(deque.pop_back().is_none());
    deque.push_front(5);
    assert_equal(alias.pop_front(), Option::Some(5));
    assert_equal(deque.head.get(), 0);
    testing::assert(slots[2].is_none());
}
