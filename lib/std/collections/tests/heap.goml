package tests;

use std::collections;
use std::testing;

#[test]
fn binary_heap_repairs_both_directions() -> () {
    for length in 0..65 {
        let values: Vec[isize] = Vec::new();
        for index in 0..length {
            values.push((index * 17) % 23 - 11);
        }
        let expected = values.copy();
        reference_sort_ints(expected.as_mut_slice());
        let heap = collections::BinaryHeap::from_vec(values);
        assert_equal(heap.len(), length);
        for index in 0..length {
            let next = expected[length - index - 1];
            assert_equal(heap.peek(), Option::Some(next));
            assert_equal(heap.pop(), Option::Some(next));
        }
        testing::assert(heap.is_empty());
        assert_equal(heap.pop(), Option::None);
        for value in expected {
            heap.push(value);
            assert_equal(heap.peek(), Option::Some(value));
        }
        assert_equal(heap.into_sorted_vec(), expected);
        testing::assert(heap.is_empty());
    }
}
