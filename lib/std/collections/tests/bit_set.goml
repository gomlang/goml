package tests;

use std::collections;
use std::testing;

#[test]
fn bit_set_word_boundaries() -> () {
    let set = collections::BitSet::new();
    testing::assert(!set.contains(-1));
    testing::assert(!set.insert(-1));
    testing::assert(!set.remove(-1));
    testing::assert(!set.contains(0));
    testing::assert(!set.remove(64));
    for index in[0, 63, 64, 127, 128] {
        testing::assert(set.insert(index));
        testing::assert(set.contains(index));
        testing::assert(!set.insert(index));
    }
    assert_equal(set.len(), 5);
    testing::assert(!set.contains(62));
    testing::assert(!set.contains(192));
    testing::assert(set.remove(64));
    testing::assert(!set.remove(64));
    testing::assert(set.contains(63));
    testing::assert(set.contains(127));
    assert_equal(set.len(), 4);
    set.clear();
    testing::assert(set.is_empty());
    testing::assert(!set.contains(128));
    testing::assert(set.insert(64));
    assert_equal(set.len(), 1);
}
