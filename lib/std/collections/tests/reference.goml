package tests;

fn reference_sort_ints(values: MutSlice[isize]) -> () {
    for index in 1..values.len() {
        let value = values[index];
        let mut cursor = index;
        while cursor > 0 && values[cursor - 1] > value {
            values[cursor] = values[cursor - 1];
            cursor -= 1;
        }
        values[cursor] = value;
    }
}

fn reference_ints_sorted(values: Slice[isize]) -> bool {
    for index in 1..values.len() {
        if values[index - 1] > values[index] {
            return false
        }
    }
    true
}

fn reference_search_ints(values: Slice[isize], expected: isize) -> isize {
    for index in 0..values.len() {
        if values[index] >= expected {
            return index
        }
    }
    values.len()
}

fn reference_find_index(length: isize, target: isize) -> (isize, bool) {
    (
        if target < 0 {
            0
        } else if target >= length {
            length
        } else {
            target
        },
        target >= 0 && target < length,
    )
}

fn reference_stable_order(keys: Slice[isize]) -> Vec[isize] {
    let output: Vec[isize] = Vec::new();
    for index in 0..keys.len() {
        output.push(index);
    }
    for index in 1..output.len() {
        let value = output[index];
        let mut cursor = index;
        while cursor > 0 && keys[output[cursor - 1]] > keys[value] {
            output[cursor] = output[cursor - 1];
            cursor -= 1;
        }
        output[cursor] = value;
    }
    output
}

fn reference_slice_equal(left: Slice[isize], right: Slice[isize]) -> bool {
    if left.len() != right.len() {
        return false
    }
    for index in 0..left.len() {
        if left[index] != right[index] {
            return false
        }
    }
    true
}

fn reference_slice_compare(left: Slice[isize], right: Slice[isize]) -> isize {
    let count = if left.len() < right.len() {
        left.len()
    } else {
        right.len()
    };
    for index in 0..count {
        if left[index] < right[index] {
            return -1
        }
        if left[index] > right[index] {
            return 1
        }
    }
    if left.len() < right.len() {
        -1
    } else if left.len() > right.len() {
        1
    } else {
        0
    }
}

fn reference_slice_index(values: Slice[isize], expected: isize) -> isize {
    for index in 0..values.len() {
        if values[index] == expected {
            return index
        }
    }
    return -1
}

fn reference_slice_repeat(values: Slice[isize], count: isize) -> Vec[isize] {
    let output = Vec::new();
    for _ in 0..count {
        for value in values {
            output.push(value);
        }
    }
    output
}

fn reference_slice_delete(values: MutSlice[isize], start: isize, end: isize) -> Vec[isize] {
    let output = Vec::new();
    for index in 0..values.len() {
        if index < start || index >= end {
            output.push(values[index]);
        }
    }
    output
}

fn reference_slice_replace_two(
    values: MutSlice[isize],
    start: isize,
    end: isize,
    first: isize,
    second: isize,
) -> Vec[isize] {
    let output = Vec::new();
    for index in 0..start {
        output.push(values[index]);
    }
    output.push(first);
    output.push(second);
    for index in end..values.len() {
        output.push(values[index]);
    }
    output
}

fn reference_slice_compact(values: MutSlice[isize]) -> Vec[isize] {
    let output = Vec::new();
    for index in 0..values.len() {
        if index == 0 || values[index] != values[index - 1] {
            output.push(values[index]);
        }
    }
    output
}

fn reference_map_new() -> Vec[Option[isize]] {
    let output = Vec::new();
    for _ in 0..65 {
        output.push(Option::None);
    }
    output
}

fn reference_map_get(values: Vec[Option[isize]], key: isize) -> Option[isize] {
    values[key + 32]
}

fn reference_map_set(values: Vec[Option[isize]], key: isize, value: isize) -> () {
    values[key + 32] = Option::Some(value);
}

fn reference_map_delete(values: Vec[Option[isize]], key: isize) -> () {
    values[key + 32] = Option::None;
}

fn reference_map_len(values: Vec[Option[isize]]) -> isize {
    let mut count = 0;
    for value in values {
        if value.is_some() {
            count += 1;
        }
    }
    count
}

fn reference_maps_clone(values: Vec[Option[isize]]) -> Vec[Option[isize]] {
    values.copy()
}

fn reference_maps_equal(left: Vec[Option[isize]], right: Vec[Option[isize]]) -> bool {
    for index in 0..65 {
        if left[index] != right[index] {
            return false
        }
    }
    true
}

fn reference_maps_copy(destination: Vec[Option[isize]], source: Vec[Option[isize]]) -> () {
    for index in 0..65 {
        if source[index].is_some() {
            destination[index] = source[index];
        }
    }
}
