package collections;

pub struct ArenaId[T] {
    pub index: isize,
}

impl[T] ArenaId[T] {
    pub fn index(self: ArenaId[T]) -> isize {
        self.index
    }
}

impl[T] PartialEq for ArenaId[T] {
    fn eq(self: ArenaId[T], other: ArenaId[T]) -> bool {
        self.index == other.index
    }
}

impl[T] Eq for ArenaId[T] {}

impl[T] Hash for ArenaId[T] {
    fn hash(self: ArenaId[T]) -> u64 {
        Hash::hash(self.index)
    }
}

pub struct Arena[T] {
    pub values: Vec[T],
}

impl[T] Default for Arena[T] {
    fn default() -> Arena[T] {
        Arena::new()
    }
}

impl[T] Arena[T] {
    pub fn new() -> Arena[T] {
        Arena { values: Vec::new() }
    }

    pub fn len(self: Arena[T]) -> isize {
        self.values.len()
    }

    pub fn is_empty(self: Arena[T]) -> bool {
        self.values.is_empty()
    }

    pub fn alloc(self: Arena[T], value: T) -> ArenaId[T] {
        let index = self.values.len();
        self.values.push(value);
        ArenaId { index }
    }

    pub fn contains_id(self: Arena[T], id: ArenaId[T]) -> bool {
        id.index >= 0 && id.index < self.values.len()
    }

    pub fn get(self: Arena[T], id: ArenaId[T]) -> T {
        self.values[id.index]
    }

    pub fn try_get(self: Arena[T], id: ArenaId[T]) -> Option[T] {
        if self.contains_id(id) {
            Option::Some(self.values[id.index])
        } else {
            Option::None
        }
    }

    pub fn set(self: Arena[T], id: ArenaId[T], value: T) -> () {
        self.values[id.index] = value;
    }
}
