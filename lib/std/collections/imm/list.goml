package imm;

struct ListNode[T] {
    value: T,
    next: Option[Ref[ListNode[T]]],
}

pub struct List[T] {
    head: Option[Ref[ListNode[T]]],
    length: isize,
}

impl[T] Default for List[T] {
    fn default() -> List[T] {
        List::new()
    }
}

impl[T] List[T] {
    pub fn new() -> List[T] {
        List { head: Option::None, length: 0 }
    }

    pub fn from_vec(values: Vec[T]) -> List[T] {
        let mut result = List::new();
        let mut index = values.len();
        while index > 0 {
            index -= 1;
            result = result.push_front(values[index]);
        }
        result
    }

    pub fn len(self: List[T]) -> isize {
        self.length
    }

    pub fn is_empty(self: List[T]) -> bool {
        self.length == 0
    }

    pub fn first(self: List[T]) -> Option[T] {
        match self.head {
            Option::Some(node) => Option::Some(node.get().value),
            Option::None => Option::None,
        }
    }

    pub fn push_front(self: List[T], value: T) -> List[T] {
        List {
            head: Option::Some(Ref::new(ListNode { value, next: self.head })),
            length: self.length + 1,
        }
    }

    pub fn pop_front(self: List[T]) -> Option[(T, List[T])] {
        match self.head {
            Option::Some(node) => {
                let node = node.get();
                Option::Some((node.value, List { head: node.next, length: self.length - 1 }))
            },
            Option::None => Option::None,
        }
    }

    pub fn tail(self: List[T]) -> Option[List[T]] {
        match self.head {
            Option::Some(node) => Option::Some(
                List { head: node.get().next, length: self.length - 1 },
            ),
            Option::None => Option::None,
        }
    }

    pub fn reverse(self: List[T]) -> List[T] {
        let mut result = List::new();
        for value in self {
            result = result.push_front(value);
        }
        result
    }

    pub fn iter(self: List[T]) -> FnIterator[T] {
        let cursor = Ref::new(self.head);
        FnIterator::from_fn(
            || match cursor.get() {
                Option::Some(node) => {
                    let node = node.get();
                    cursor.set(node.next);
                    Option::Some(node.value)
                },
                Option::None => Option::None,
            },
        )
    }

    pub fn to_vec(self: List[T]) -> Vec[T] {
        let result = Vec::with_capacity(self.length);
        for value in self {
            result.push(value);
        }
        result
    }
}

impl[T] IntoIterator for List[T] {
    type Item = T;

    type IntoIter = FnIterator[T];

    fn into_iter(self: List[T]) -> FnIterator[T] {
        self.iter()
    }
}

impl[T: PartialEq] PartialEq for List[T] {
    fn eq(self: List[T], other: List[T]) -> bool {
        if self.length != other.length {
            return false
        }
        let other_values = other.iter();
        for value in self {
            if Option::Some(value) != other_values.next() {
                return false
            }
        }
        true
    }
}

impl[T: Eq] Eq for List[T] {}
