package imm;

pub struct HashSet[T] {
    entries: HashMap[T, ()],
}

impl[T: Eq + Hash] Default for HashSet[T] {
    fn default() -> HashSet[T] {
        HashSet::new()
    }
}

impl[T: Eq + Hash] HashSet[T] {
    pub fn new() -> HashSet[T] {
        HashSet { entries: HashMap::new() }
    }

    pub fn from_vec(values: Vec[T]) -> HashSet[T] {
        let mut result = HashSet::new();
        for value in values {
            result = result.insert(value);
        }
        result
    }

    pub fn len(self: HashSet[T]) -> isize {
        self.entries.len()
    }

    pub fn is_empty(self: HashSet[T]) -> bool {
        self.entries.is_empty()
    }

    pub fn contains(self: HashSet[T], value: T) -> bool {
        self.entries.contains_key(value)
    }

    pub fn insert(self: HashSet[T], value: T) -> HashSet[T] {
        HashSet { entries: self.entries.insert(value, ()) }
    }

    pub fn remove(self: HashSet[T], value: T) -> HashSet[T] {
        HashSet { entries: self.entries.remove(value) }
    }

    pub fn iter(self: HashSet[T]) -> FnIterator[T] {
        let iterator = self.entries.iter();
        FnIterator::from_fn(|| iterator.next().map(|entry| entry.0))
    }

    pub fn to_vec(self: HashSet[T]) -> Vec[T] {
        self.entries.keys()
    }

    pub fn union(self: HashSet[T], other: HashSet[T]) -> HashSet[T] {
        let mut result = self;
        for value in other {
            result = result.insert(value);
        }
        result
    }

    pub fn intersection(self: HashSet[T], other: HashSet[T]) -> HashSet[T] {
        let mut result = HashSet::new();
        for value in self {
            if other.contains(value) {
                result = result.insert(value);
            }
        }
        result
    }

    pub fn difference(self: HashSet[T], other: HashSet[T]) -> HashSet[T] {
        let mut result = self;
        for value in other {
            result = result.remove(value);
        }
        result
    }

    pub fn symmetric_difference(self: HashSet[T], other: HashSet[T]) -> HashSet[T] {
        let mut result = self;
        for value in other {
            result = if self.contains(value) {
                result.remove(value)
            } else {
                result.insert(value)
            };
        }
        result
    }

    pub fn is_subset(self: HashSet[T], other: HashSet[T]) -> bool {
        if self.len() > other.len() {
            return false
        }
        for value in self {
            if !other.contains(value) {
                return false
            }
        }
        true
    }

    pub fn is_disjoint(self: HashSet[T], other: HashSet[T]) -> bool {
        for value in self {
            if other.contains(value) {
                return false
            }
        }
        true
    }
}

impl[T: Eq + Hash] IntoIterator for HashSet[T] {
    type Item = T;

    type IntoIter = FnIterator[T];

    fn into_iter(self: HashSet[T]) -> FnIterator[T] {
        self.iter()
    }
}

impl[T: Eq + Hash] PartialEq for HashSet[T] {
    fn eq(self: HashSet[T], other: HashSet[T]) -> bool {
        self.entries == other.entries
    }
}

impl[T: Eq + Hash] Eq for HashSet[T] {}
