package imm;

use std::cmp;

const BTREE_MIN_DEGREE: isize = 8;

const BTREE_MAX_KEYS: isize = 15;

struct BTreeNode[K, V] {
    leaf: bool,
    keys: Vec[K],
    values: Vec[V],
    children: Vec[BTreeNode[K, V]],
}

struct BTreeIterFrame[K, V] {
    node: BTreeNode[K, V],
    position: isize,
}

pub struct BTreeMap[K, V] {
    root: Option[BTreeNode[K, V]],
    len: isize,
}

impl[K, V] BTreeNode[K, V] {
    fn new(leaf: bool) -> BTreeNode[K, V] {
        BTreeNode { leaf, keys: Vec::new(), values: Vec::new(), children: Vec::new() }
    }

    fn copy(self: BTreeNode[K, V]) -> BTreeNode[K, V] {
        BTreeNode {
            leaf: self.leaf,
            keys: self.keys.copy(),
            values: self.values.copy(),
            children: self.children.copy(),
        }
    }

    fn split_child(self: BTreeNode[K, V], index: isize) -> () {
        let child = self.children[index].copy();
        let sibling = BTreeNode::new(child.leaf);
        let middle_key = child.keys[BTREE_MIN_DEGREE - 1];
        let middle_value = child.values[BTREE_MIN_DEGREE - 1];
        let mut position = BTREE_MIN_DEGREE;
        while position < child.keys.len() {
            sibling.keys.push(child.keys[position]);
            sibling.values.push(child.values[position]);
            position += 1;
        }
        child.keys.truncate(BTREE_MIN_DEGREE - 1);
        child.values.truncate(BTREE_MIN_DEGREE - 1);
        if !child.leaf {
            position = BTREE_MIN_DEGREE;
            while position < child.children.len() {
                sibling.children.push(child.children[position]);
                position += 1;
            }
            child.children.truncate(BTREE_MIN_DEGREE);
        }
        self.keys.insert(index, middle_key);
        self.values.insert(index, middle_value);
        self.children[index] = child;
        self.children.insert(index + 1, sibling)
    }

    fn first_entry(self: BTreeNode[K, V]) -> (K, V) {
        let mut current = self;
        while !current.leaf {
            current = current.children[0];
        };
        (current.keys[0], current.values[0])
    }

    fn last_entry(self: BTreeNode[K, V]) -> (K, V) {
        let mut current = self;
        while !current.leaf {
            current = current.children[current.children.len() - 1];
        }
        let index = current.keys.len() - 1;
        (current.keys[index], current.values[index])
    }

    fn borrow_from_previous(self: BTreeNode[K, V], index: isize) -> () {
        let child = self.children[index].copy();
        let sibling = self.children[index - 1].copy();
        child.keys.insert(0, self.keys[index - 1]);
        child.values.insert(0, self.values[index - 1]);
        if !child.leaf {
            if let Option::Some(value) = sibling.children.pop() {
                child.children.insert(0, value)
            }
        }
        if let Option::Some(value) = sibling.keys.pop() {
            self.keys[index - 1] = value;
        }
        if let Option::Some(value) = sibling.values.pop() {
            self.values[index - 1] = value;
        }
        self.children[index] = child;
        self.children[index - 1] = sibling;
    }

    fn borrow_from_next(self: BTreeNode[K, V], index: isize) -> () {
        let child = self.children[index].copy();
        let sibling = self.children[index + 1].copy();
        child.keys.push(self.keys[index]);
        child.values.push(self.values[index]);
        if !child.leaf {
            child.children.push(sibling.children.remove(0));
        }
        self.keys[index] = sibling.keys.remove(0);
        self.values[index] = sibling.values.remove(0);
        self.children[index] = child;
        self.children[index + 1] = sibling;
    }

    fn merge_children(self: BTreeNode[K, V], index: isize) -> () {
        let child = self.children[index].copy();
        let sibling = self.children.remove(index + 1);
        child.keys.push(self.keys.remove(index));
        child.values.push(self.values.remove(index));
        for key in sibling.keys {
            child.keys.push(key)
        }
        for value in sibling.values {
            child.values.push(value)
        }
        for descendant in sibling.children {
            child.children.push(descendant)
        }
        self.children[index] = child;
    }
}

impl[K: cmp::Ord, V] BTreeNode[K, V] {
    fn lower_bound(self: BTreeNode[K, V], key: K) -> isize {
        let mut low = 0;
        let mut high = self.keys.len();
        while low < high {
            let middle = low + (high - low) / 2;
            if cmp::Ord::cmp(self.keys[middle], key).is_lt() {
                low = middle + 1;
            } else {
                high = middle;
            }
        }
        low
    }

    fn insert_non_full(self: BTreeNode[K, V], key: K, value: V) -> bool {
        let mut index = self.lower_bound(key);
        if index < self.keys.len() && cmp::Ord::cmp(self.keys[index], key).is_eq() {
            self.values[index] = value;
            false
        } else if self.leaf {
            self.keys.insert(index, key);
            self.values.insert(index, value);
            true
        } else {
            if self.children[index].keys.len() == BTREE_MAX_KEYS {
                self.split_child(index);
                let ordering = cmp::Ord::cmp(key, self.keys[index]);
                if ordering.is_eq() {
                    self.values[index] = value;
                    return false
                } else if ordering.is_gt() {
                    index += 1;
                }
            }
            let child = self.children[index].copy();
            let added = child.insert_non_full(key, value);
            self.children[index] = child;
            added
        }
    }

    fn remove_entry(self: BTreeNode[K, V], key: K) -> () {
        let mut index = self.lower_bound(key);
        if index < self.keys.len() && cmp::Ord::cmp(self.keys[index], key).is_eq() {
            if self.leaf {
                let _ = self.keys.remove(index);
                let _ = self.values.remove(index);
            } else if self.children[index].keys.len() >= BTREE_MIN_DEGREE {
                let child = self.children[index].copy();
                let (replacement_key, replacement_value) = child.last_entry();
                self.keys[index] = replacement_key;
                self.values[index] = replacement_value;
                child.remove_entry(replacement_key);
                self.children[index] = child;
            } else if self.children[index + 1].keys.len() >= BTREE_MIN_DEGREE {
                let child = self.children[index + 1].copy();
                let (replacement_key, replacement_value) = child.first_entry();
                self.keys[index] = replacement_key;
                self.values[index] = replacement_value;
                child.remove_entry(replacement_key);
                self.children[index + 1] = child;
            } else {
                self.merge_children(index);
                self.children[index].remove_entry(key)
            }
        } else if !self.leaf {
            if self.children[index].keys.len() == BTREE_MIN_DEGREE - 1 {
                if index > 0 && self.children[index - 1].keys.len() >= BTREE_MIN_DEGREE {
                    self.borrow_from_previous(index)
                } else if index < self.keys.len()
                    && self.children[index + 1].keys.len() >= BTREE_MIN_DEGREE {
                    self.borrow_from_next(index)
                } else if index < self.keys.len() {
                    self.merge_children(index)
                } else {
                    self.merge_children(index - 1);
                    index -= 1;
                }
            } else {
                self.children[index] = self.children[index].copy();
            }
            self.children[index].remove_entry(key)
        }
    }
}

fn btree_iterator[K, V](stack: Vec[BTreeIterFrame[K, V]]) -> FnIterator[(K, V)] {
    FnIterator::from_fn(
        || loop {
            if stack.is_empty() {
                return Option::None
            }
            let top = stack.len() - 1;
            let frame = stack[top];
            if frame.node.leaf {
                if frame.position < frame.node.keys.len() {
                    let index = frame.position;
                    stack[top] = BTreeIterFrame { node: frame.node, position: index + 1 };
                    return Option::Some((frame.node.keys[index], frame.node.values[index]))
                } else {
                    let _ = stack.pop();
                }
            } else if frame.position > frame.node.keys.len() * 2 {
                let _ = stack.pop();
            } else if frame.position % 2 == 0 {
                let child_index = frame.position / 2;
                stack[top] = BTreeIterFrame { node: frame.node, position: frame.position + 1 };
                stack.push(BTreeIterFrame { node: frame.node.children[child_index], position: 0 })
            } else {
                let index = frame.position / 2;
                stack[top] = BTreeIterFrame { node: frame.node, position: frame.position + 1 };
                return Option::Some((frame.node.keys[index], frame.node.values[index]))
            }
        },
    )
}

impl[K: cmp::Ord, V] Default for BTreeMap[K, V] {
    fn default() -> BTreeMap[K, V] {
        BTreeMap::new()
    }
}

impl[K: cmp::Ord, V] BTreeMap[K, V] {
    pub fn new() -> BTreeMap[K, V] {
        BTreeMap { root: Option::None, len: 0 }
    }

    pub fn from_vec(entries: Vec[(K, V)]) -> BTreeMap[K, V] {
        let mut result = BTreeMap::new();
        for (key, value) in entries {
            result = result.insert(key, value);
        }
        result
    }

    pub fn len(self: BTreeMap[K, V]) -> isize {
        self.len
    }

    pub fn is_empty(self: BTreeMap[K, V]) -> bool {
        self.len == 0
    }

    pub fn get(self: BTreeMap[K, V], key: K) -> Option[V] {
        let mut current = self.root;
        while let Option::Some(node) = current {
            let index = node.lower_bound(key);
            if index < node.keys.len() && cmp::Ord::cmp(node.keys[index], key).is_eq() {
                return Option::Some(node.values[index])
            } else if node.leaf {
                return Option::None
            } else {
                current = Option::Some(node.children[index]);
            }
        }
        Option::None
    }

    pub fn contains_key(self: BTreeMap[K, V], key: K) -> bool {
        self.get(key).is_some()
    }

    pub fn insert(self: BTreeMap[K, V], key: K, value: V) -> BTreeMap[K, V] {
        match self.root {
            Option::None => {
                let root = BTreeNode::new(true);
                root.keys.push(key);
                root.values.push(value);
                BTreeMap { root: Option::Some(root), len: 1 }
            },
            Option::Some(root) => {
                let next_root = if root.keys.len() == BTREE_MAX_KEYS {
                    let next = BTreeNode::new(false);
                    next.children.push(root);
                    next.split_child(0);
                    next
                } else {
                    root.copy()
                };
                let added = next_root.insert_non_full(key, value);
                BTreeMap {
                    root: Option::Some(next_root),
                    len: self.len
                        + if added {
                            1
                        } else {
                            0
                        },
                }
            },
        }
    }

    pub fn remove(self: BTreeMap[K, V], key: K) -> BTreeMap[K, V] {
        if !self.contains_key(key) {
            return self
        }
        match self.root {
            Option::None => self,
            Option::Some(root) => {
                let next_root = root.copy();
                next_root.remove_entry(key);
                let root = if next_root.keys.is_empty() {
                    if next_root.leaf {
                        Option::None
                    } else {
                        Option::Some(next_root.children[0])
                    }
                } else {
                    Option::Some(next_root)
                };
                BTreeMap { root, len: self.len - 1 }
            },
        }
    }

    pub fn first(self: BTreeMap[K, V]) -> Option[(K, V)] {
        self.root.map(|root| root.first_entry())
    }

    pub fn last(self: BTreeMap[K, V]) -> Option[(K, V)] {
        self.root.map(|root| root.last_entry())
    }

    pub fn lower_bound(self: BTreeMap[K, V], key: K) -> Option[(K, V)] {
        let mut current = self.root;
        let mut candidate = Option::None;
        while let Option::Some(node) = current {
            let index = node.lower_bound(key);
            if index < node.keys.len() {
                candidate = Option::Some((node.keys[index], node.values[index]));
                if cmp::Ord::cmp(node.keys[index], key).is_eq() {
                    return candidate
                }
            }
            if node.leaf {
                return candidate
            }
            current = Option::Some(node.children[index]);
        }
        candidate
    }

    pub fn upper_bound(self: BTreeMap[K, V], key: K) -> Option[(K, V)] {
        let mut current = self.root;
        let mut candidate = Option::None;
        while let Option::Some(node) = current {
            let mut index = node.lower_bound(key);
            if index < node.keys.len() && cmp::Ord::cmp(node.keys[index], key).is_eq() {
                index += 1;
            }
            if index < node.keys.len() {
                candidate = Option::Some((node.keys[index], node.values[index]));
            }
            if node.leaf {
                return candidate
            }
            current = Option::Some(node.children[index]);
        }
        candidate
    }

    pub fn iter(self: BTreeMap[K, V]) -> FnIterator[(K, V)] {
        let stack = Vec::new();
        if let Option::Some(root) = self.root {
            stack.push(BTreeIterFrame { node: root, position: 0 })
        }
        btree_iterator(stack)
    }

    pub fn range(self: BTreeMap[K, V], start: K, end: K) -> FnIterator[(K, V)] {
        let stack = Vec::new();
        if cmp::Ord::cmp(start, end).is_lt() {
            let mut current = self.root;
            while let Option::Some(node) = current {
                let index = node.lower_bound(start);
                if node.leaf {
                    stack.push(BTreeIterFrame { node, position: index });
                    break
                }
                stack.push(BTreeIterFrame { node, position: index * 2 + 1 });
                if index < node.keys.len() && cmp::Ord::cmp(node.keys[index], start).is_eq() {
                    break
                }
                current = Option::Some(node.children[index]);
            }
        }
        let iterator = btree_iterator(stack);
        FnIterator::from_fn(
            || match iterator.next() {
                Option::Some((key, value)) => {
                    if cmp::Ord::cmp(key, end).is_lt() {
                        Option::Some((key, value))
                    } else {
                        stack.clear();
                        Option::None
                    }
                },
                Option::None => Option::None,
            },
        )
    }

    pub fn entries(self: BTreeMap[K, V]) -> Vec[(K, V)] {
        let result = Vec::with_capacity(self.len);
        for entry in self {
            result.push(entry)
        }
        result
    }

    pub fn keys(self: BTreeMap[K, V]) -> Vec[K] {
        let result = Vec::with_capacity(self.len);
        for (key, _) in self {
            result.push(key)
        }
        result
    }

    pub fn values(self: BTreeMap[K, V]) -> Vec[V] {
        let result = Vec::with_capacity(self.len);
        for (_, value) in self {
            result.push(value)
        }
        result
    }
}

impl[K: cmp::Ord, V] IntoIterator for BTreeMap[K, V] {
    type Item = (K, V);

    type IntoIter = FnIterator[(K, V)];

    fn into_iter(self: BTreeMap[K, V]) -> FnIterator[(K, V)] {
        self.iter()
    }
}

impl[K: cmp::Ord, V: PartialEq] PartialEq for BTreeMap[K, V] {
    fn eq(self: BTreeMap[K, V], other: BTreeMap[K, V]) -> bool {
        if self.len != other.len {
            return false
        }
        let left = self.iter();
        let right = other.iter();
        while let Option::Some(entry) = left.next() {
            if right.next() != Option::Some(entry) {
                return false
            }
        }
        true
    }
}

impl[K: cmp::Ord, V: Eq] Eq for BTreeMap[K, V] {}
