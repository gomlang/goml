package imm;

const VECTOR_WIDTH: isize = 32;

enum VectorNode[T] {
    Leaf(FrozenVec[T]),
    Branch(FrozenVec[VectorNode[T]]),
}

struct VectorIterFrame[T] {
    node: VectorNode[T],
    position: isize,
}

pub struct Vector[T] {
    root: Option[VectorNode[T]],
    height: isize,
    tail: FrozenVec[T],
    length: isize,
}

fn vector_child_width(height: isize) -> isize {
    let mut width = 1;
    for _ in 0..height {
        width *= VECTOR_WIDTH;
    }
    width
}

impl[T] VectorNode[T] {
    fn get(self: VectorNode[T], index: isize, width: isize) -> T {
        match self {
            Leaf(values) => values.get(index),
            Branch(children) => {
                children.get(index / width).get(index % width, width / VECTOR_WIDTH)
            },
        }
    }

    fn replaced(self: VectorNode[T], index: isize, width: isize, value: T) -> VectorNode[T] {
        match self {
            Leaf(values) => {
                let values = values.to_vec();
                values[index] = value;
                Leaf(values.freeze())
            },
            Branch(children) => {
                let children = children.to_vec();
                let child_index = index / width;
                children[child_index] = children[child_index].replaced(
                    index % width,
                    width / VECTOR_WIDTH,
                    value,
                );
                Branch(children.freeze())
            },
        }
    }

    fn pushed_leaf(self: VectorNode[T], leaf: VectorNode[T]) -> (
        VectorNode[T],
        Option[VectorNode[T]],
    ) {
        match self {
            Leaf(_) => (self, Option::Some(leaf)),
            Branch(children) => {
                let last_index = children.len() - 1;
                let (last, overflow) = children.get(last_index).pushed_leaf(leaf);
                match overflow {
                    Option::Some(next) => {
                        if children.len() == VECTOR_WIDTH {
                            (self, Option::Some(Branch(Vec::from_array([next]).freeze())))
                        } else {
                            let children = children.to_vec();
                            children[last_index] = last;
                            children.push(next);
                            (Branch(children.freeze()), Option::None)
                        }
                    },
                    Option::None => {
                        let children = children.to_vec();
                        children[last_index] = last;
                        (Branch(children.freeze()), Option::None)
                    },
                }
            },
        }
    }

    fn popped_leaf(self: VectorNode[T]) -> (Option[VectorNode[T]], FrozenVec[T]) {
        match self {
            Leaf(values) => (Option::None, values),
            Branch(children) => {
                let last_index = children.len() - 1;
                let (last, values) = children.get(last_index).popped_leaf();
                let children = children.to_vec();
                match last {
                    Option::Some(last) => {
                        children[last_index] = last;
                    },
                    Option::None => {
                        let _ = children.pop();
                    },
                }
                if children.is_empty() {
                    (Option::None, values)
                } else {
                    (Option::Some(Branch(children.freeze())), values)
                }
            },
        }
    }
}

impl[T] Default for Vector[T] {
    fn default() -> Vector[T] {
        Vector::new()
    }
}

impl[T] Vector[T] {
    pub fn new() -> Vector[T] {
        Vector { root: Option::None, height: 0, tail: Vec::new().freeze(), length: 0 }
    }

    pub fn from_vec(values: Vec[T]) -> Vector[T] {
        let mut result = Vector::new();
        for value in values {
            result = result.push(value);
        }
        result
    }

    pub fn len(self: Vector[T]) -> isize {
        self.length
    }

    pub fn is_empty(self: Vector[T]) -> bool {
        self.length == 0
    }

    pub fn get(self: Vector[T], index: isize) -> Option[T] {
        if index < 0 || index >= self.length {
            return Option::None
        }
        let tail_start = self.length - self.tail.len();
        if index >= tail_start {
            Option::Some(self.tail.get(index - tail_start))
        } else {
            match self.root {
                Option::Some(root) => Option::Some(root.get(index, vector_child_width(self.height))),
                Option::None => Option::None,
            }
        }
    }

    pub fn set(self: Vector[T], index: isize, value: T) -> Option[Vector[T]] {
        if index < 0 || index >= self.length {
            return Option::None
        }
        let tail_start = self.length - self.tail.len();
        if index >= tail_start {
            let tail = self.tail.to_vec();
            tail[index - tail_start] = value;
            Option::Some(
                Vector {
                    root: self.root,
                    height: self.height,
                    tail: tail.freeze(),
                    length: self.length,
                },
            )
        } else {
            match self.root {
                Option::Some(root) => Option::Some(
                    Vector {
                        root: Option::Some(
                            root.replaced(index, vector_child_width(self.height), value),
                        ),
                        height: self.height,
                        tail: self.tail,
                        length: self.length,
                    },
                ),
                Option::None => Option::None,
            }
        }
    }

    pub fn push(self: Vector[T], value: T) -> Vector[T] {
        if self.tail.len() < VECTOR_WIDTH {
            let tail = self.tail.to_vec();
            tail.push(value);
            return Vector {
                root: self.root,
                height: self.height,
                tail: tail.freeze(),
                length: self.length + 1,
            }
        }
        let leaf = VectorNode::Leaf(self.tail);
        let (root, height) = match self.root {
            Option::Some(root) => {
                let (root, overflow) = root.pushed_leaf(leaf);
                match overflow {
                    Option::Some(next) => (
                        VectorNode::Branch(Vec::from_array([root, next]).freeze()),
                        self.height + 1,
                    ),
                    Option::None => (root, self.height),
                }
            },
            Option::None => (leaf, 0),
        };
        Vector {
            root: Option::Some(root),
            height,
            tail: Vec::from_array([value]).freeze(),
            length: self.length + 1,
        }
    }

    pub fn pop(self: Vector[T]) -> Option[(T, Vector[T])] {
        if self.is_empty() {
            return Option::None
        }
        let value = self.tail.get(self.tail.len() - 1);
        if self.tail.len() > 1 {
            let tail = self.tail.to_vec();
            let _ = tail.pop();
            return Option::Some(
                (
                    value,
                    Vector {
                        root: self.root,
                        height: self.height,
                        tail: tail.freeze(),
                        length: self.length - 1,
                    },
                ),
            )
        }
        match self.root {
            Option::Some(root) => {
                let (remaining, tail) = root.popped_leaf();
                let mut root = remaining;
                let mut height = self.height;
                loop {
                    match root {
                        Option::Some(VectorNode::Branch(children)) => {
                            if children.len() == 1 {
                                root = Option::Some(children.get(0));
                                height -= 1;
                            } else {
                                break
                            }
                        },
                        Option::Some(VectorNode::Leaf(_)) => break,
                        Option::None => {
                            height = 0;
                            break
                        },
                    }
                }
                Option::Some((value, Vector { root, height, tail, length: self.length - 1 }))
            },
            Option::None => Option::Some((value, Vector::new())),
        }
    }

    pub fn first(self: Vector[T]) -> Option[T] {
        self.get(0)
    }

    pub fn last(self: Vector[T]) -> Option[T] {
        self.get(self.length - 1)
    }

    pub fn iter(self: Vector[T]) -> FnIterator[T] {
        let stack: Vec[VectorIterFrame[T]] = Vec::new();
        if !self.tail.is_empty() {
            stack.push(VectorIterFrame { node: VectorNode::Leaf(self.tail), position: 0 });
        }
        if let Option::Some(root) = self.root {
            stack.push(VectorIterFrame { node: root, position: 0 });
        }
        FnIterator::from_fn(
            || loop {
                if stack.is_empty() {
                    return Option::None
                }
                let top = stack.len() - 1;
                let frame = stack[top];
                match frame.node {
                    Leaf(values) => {
                        if frame.position < values.len() {
                            stack[top] = VectorIterFrame {
                                node: frame.node,
                                position: frame.position + 1,
                            };
                            return Option::Some(values.get(frame.position))
                        } else {
                            let _ = stack.pop();
                        }
                    },
                    Branch(children) => {
                        if frame.position < children.len() {
                            stack[top] = VectorIterFrame {
                                node: frame.node,
                                position: frame.position + 1,
                            };
                            stack.push(
                                VectorIterFrame { node: children.get(frame.position), position: 0 },
                            );
                        } else {
                            let _ = stack.pop();
                        }
                    },
                }
            },
        )
    }

    pub fn to_vec(self: Vector[T]) -> Vec[T] {
        let result = Vec::with_capacity(self.length);
        for value in self {
            result.push(value);
        }
        result
    }
}

impl[T] IntoIterator for Vector[T] {
    type Item = T;

    type IntoIter = FnIterator[T];

    fn into_iter(self: Vector[T]) -> FnIterator[T] {
        self.iter()
    }
}

impl[T: PartialEq] PartialEq for Vector[T] {
    fn eq(self: Vector[T], other: Vector[T]) -> bool {
        if self.length != other.length {
            return false
        }
        let other_values = other.iter();
        for value in self {
            if Option::Some(value) != other_values.next() {
                return false
            }
        }
        true
    }
}

impl[T: Eq] Eq for Vector[T] {}
