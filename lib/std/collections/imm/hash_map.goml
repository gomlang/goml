package imm;

enum HamtNode[K, V] {
    Leaf(u64, Vec[(K, V)]),
    Branch(u32, Vec[HamtNode[K, V]]),
}

struct HamtIterFrame[K, V] {
    node: HamtNode[K, V],
    position: isize,
}

pub struct HashMap[K, V] {
    root: Option[HamtNode[K, V]],
    size: isize,
}

fn hamt_bit(hash: u64, shift: isize) -> u32 {
    let bit: u32 = 1;
    bit << ((hash >> shift) & 31)
}

fn hamt_index(bitmap: u32, bit: u32) -> isize {
    let mut remaining = bitmap & (bit - 1);
    let mut index = 0;
    while remaining != 0 {
        remaining &= remaining - 1;
        index += 1;
    }
    index
}

impl[K: Eq + Hash, V] HamtNode[K, V] {
    fn get(self: HamtNode[K, V], key: K, hash: u64, shift: isize) -> Option[V] {
        match self {
            Leaf(stored_hash, entries) => {
                if stored_hash == hash {
                    for (stored_key, value) in entries {
                        if stored_key == key {
                            return Option::Some(value)
                        }
                    }
                }
                Option::None
            },
            Branch(bitmap, children) => {
                let bit = hamt_bit(hash, shift);
                if bitmap & bit == 0 {
                    Option::None
                } else {
                    children[hamt_index(bitmap, bit)].get(key, hash, shift + 5)
                }
            },
        }
    }

    fn join(
        self: HamtNode[K, V],
        own_hash: u64,
        other: HamtNode[K, V],
        other_hash: u64,
        shift: isize,
    ) -> HamtNode[K, V] {
        let own_bit = hamt_bit(own_hash, shift);
        let other_bit = hamt_bit(other_hash, shift);
        if own_bit == other_bit {
            HamtNode::Branch(
                own_bit,
                Vec::from_array([self.join(own_hash, other, other_hash, shift + 5)]),
            )
        } else if own_bit < other_bit {
            HamtNode::Branch(own_bit | other_bit, Vec::from_array([self, other]))
        } else {
            HamtNode::Branch(own_bit | other_bit, Vec::from_array([other, self]))
        }
    }

    fn insert(self: HamtNode[K, V], key: K, value: V, hash: u64, shift: isize) -> (
        HamtNode[K, V],
        bool,
    ) {
        match self {
            Leaf(stored_hash, entries) => {
                if stored_hash != hash {
                    let other = HamtNode::Leaf(hash, Vec::from_array([(key, value)]));
                    return (self.join(stored_hash, other, hash, shift), true)
                }
                let copied = entries.copy();
                for index in 0..entries.len() {
                    if entries[index].0 == key {
                        copied[index] = (entries[index].0, value);
                        return (HamtNode::Leaf(hash, copied), false)
                    }
                }
                copied.push((key, value));
                (HamtNode::Leaf(hash, copied), true)
            },
            Branch(bitmap, children) => {
                let bit = hamt_bit(hash, shift);
                let index = hamt_index(bitmap, bit);
                let copied = children.copy();
                if bitmap & bit == 0 {
                    copied.insert(index, HamtNode::Leaf(hash, Vec::from_array([(key, value)])));
                    (HamtNode::Branch(bitmap | bit, copied), true)
                } else {
                    let (child, added) = children[index].insert(key, value, hash, shift + 5);
                    copied[index] = child;
                    (HamtNode::Branch(bitmap, copied), added)
                }
            },
        }
    }

    fn remove(self: HamtNode[K, V], key: K, hash: u64, shift: isize) -> (
        Option[HamtNode[K, V]],
        bool,
    ) {
        match self {
            Leaf(stored_hash, entries) => {
                if stored_hash == hash {
                    for index in 0..entries.len() {
                        if entries[index].0 == key {
                            if entries.len() == 1 {
                                return (Option::None, true)
                            }
                            let copied = entries.copy();
                            let _ = copied.remove(index);
                            return (Option::Some(HamtNode::Leaf(hash, copied)), true)
                        }
                    }
                };
                (Option::Some(self), false)
            },
            Branch(bitmap, children) => {
                let bit = hamt_bit(hash, shift);
                if bitmap & bit == 0 {
                    return (Option::Some(self), false)
                }
                let index = hamt_index(bitmap, bit);
                let (child, removed) = children[index].remove(key, hash, shift + 5);
                if !removed {
                    return (Option::Some(self), false)
                }
                let copied = children.copy();
                let mut next_bitmap = bitmap;
                match child {
                    Option::Some(node) => {
                        copied[index] = node;
                    },
                    Option::None => {
                        let _ = copied.remove(index);
                        next_bitmap &= ~bit;
                    },
                }
                if copied.is_empty() {
                    return (Option::None, true)
                }
                if copied.len() == 1 {
                    if let HamtNode::Leaf(_, _) = copied[0] {
                        return (Option::Some(copied[0]), true)
                    }
                };
                (Option::Some(HamtNode::Branch(next_bitmap, copied)), true)
            },
        }
    }
}

impl[K: Eq + Hash, V] Default for HashMap[K, V] {
    fn default() -> HashMap[K, V] {
        HashMap::new()
    }
}

impl[K: Eq + Hash, V] HashMap[K, V] {
    pub fn new() -> HashMap[K, V] {
        HashMap { root: Option::None, size: 0 }
    }

    pub fn from_vec(entries: Vec[(K, V)]) -> HashMap[K, V] {
        let mut result = HashMap::new();
        for (key, value) in entries {
            result = result.insert(key, value);
        }
        result
    }

    pub fn len(self: HashMap[K, V]) -> isize {
        self.size
    }

    pub fn is_empty(self: HashMap[K, V]) -> bool {
        self.size == 0
    }

    pub fn get(self: HashMap[K, V], key: K) -> Option[V] {
        match self.root {
            Option::None => Option::None,
            Option::Some(root) => root.get(key, key.hash(), 0),
        }
    }

    pub fn contains_key(self: HashMap[K, V], key: K) -> bool {
        self.get(key).is_some()
    }

    pub fn insert(self: HashMap[K, V], key: K, value: V) -> HashMap[K, V] {
        let hash = key.hash();
        match self.root {
            Option::None => HashMap {
                root: Option::Some(HamtNode::Leaf(hash, Vec::from_array([(key, value)]))),
                size: 1,
            },
            Option::Some(root) => {
                let (next_root, added) = root.insert(key, value, hash, 0);
                HashMap {
                    root: Option::Some(next_root),
                    size: self.size
                        + if added {
                            1
                        } else {
                            0
                        },
                }
            },
        }
    }

    pub fn remove(self: HashMap[K, V], key: K) -> HashMap[K, V] {
        match self.root {
            Option::None => self,
            Option::Some(root) => {
                let (next_root, removed) = root.remove(key, key.hash(), 0);
                HashMap {
                    root: next_root,
                    size: self.size
                        - if removed {
                            1
                        } else {
                            0
                        },
                }
            },
        }
    }

    pub fn iter(self: HashMap[K, V]) -> FnIterator[(K, V)] {
        let stack: Vec[HamtIterFrame[K, V]] = Vec::new();
        if let Option::Some(root) = self.root {
            stack.push(HamtIterFrame { node: root, position: 0 });
        }
        FnIterator::from_fn(
            || loop {
                if stack.is_empty() {
                    return Option::None
                }
                let top = stack.len() - 1;
                let frame = stack[top];
                match frame.node {
                    HamtNode::Leaf(_, entries) => {
                        if frame.position < entries.len() {
                            stack[top] = HamtIterFrame {
                                node: frame.node,
                                position: frame.position + 1,
                            };
                            return Option::Some(entries[frame.position])
                        }
                        let _ = stack.pop();
                    },
                    HamtNode::Branch(_, children) => {
                        if frame.position < children.len() {
                            stack[top] = HamtIterFrame {
                                node: frame.node,
                                position: frame.position + 1,
                            };
                            stack.push(
                                HamtIterFrame { node: children[frame.position], position: 0 },
                            );
                        } else {
                            let _ = stack.pop();
                        }
                    },
                }
            },
        )
    }

    pub fn entries(self: HashMap[K, V]) -> Vec[(K, V)] {
        let result = Vec::with_capacity(self.size);
        for entry in self {
            result.push(entry);
        }
        result
    }

    pub fn keys(self: HashMap[K, V]) -> Vec[K] {
        let result = Vec::with_capacity(self.size);
        for (key, _) in self {
            result.push(key);
        }
        result
    }

    pub fn values(self: HashMap[K, V]) -> Vec[V] {
        let result = Vec::with_capacity(self.size);
        for (_, value) in self {
            result.push(value);
        }
        result
    }
}

impl[K: Eq + Hash, V] IntoIterator for HashMap[K, V] {
    type Item = (K, V);

    type IntoIter = FnIterator[(K, V)];

    fn into_iter(self: HashMap[K, V]) -> FnIterator[(K, V)] {
        self.iter()
    }
}

impl[K: Eq + Hash, V: PartialEq] PartialEq for HashMap[K, V] {
    fn eq(self: HashMap[K, V], other: HashMap[K, V]) -> bool {
        if self.size != other.size {
            return false
        }
        for (key, value) in self {
            match other.get(key) {
                Option::None => return false,
                Option::Some(other_value) => if value != other_value {
                    return false
                },
            }
        }
        true
    }
}

impl[K: Eq + Hash, V: Eq] Eq for HashMap[K, V] {}
