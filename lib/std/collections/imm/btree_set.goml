package imm;

use std::cmp;

pub struct BTreeSet[T] {
    entries: BTreeMap[T, ()],
}

impl[T: cmp::Ord] Default for BTreeSet[T] {
    fn default() -> BTreeSet[T] {
        BTreeSet::new()
    }
}

impl[T: cmp::Ord] BTreeSet[T] {
    pub fn new() -> BTreeSet[T] {
        BTreeSet { entries: BTreeMap::new() }
    }

    pub fn from_vec(values: Vec[T]) -> BTreeSet[T] {
        let mut result = BTreeSet::new();
        for value in values {
            result = result.insert(value);
        }
        result
    }

    pub fn len(self: BTreeSet[T]) -> isize {
        self.entries.len()
    }

    pub fn is_empty(self: BTreeSet[T]) -> bool {
        self.entries.is_empty()
    }

    pub fn contains(self: BTreeSet[T], value: T) -> bool {
        self.entries.contains_key(value)
    }

    pub fn insert(self: BTreeSet[T], value: T) -> BTreeSet[T] {
        BTreeSet { entries: self.entries.insert(value, ()) }
    }

    pub fn remove(self: BTreeSet[T], value: T) -> BTreeSet[T] {
        BTreeSet { entries: self.entries.remove(value) }
    }

    pub fn first(self: BTreeSet[T]) -> Option[T] {
        self.entries.first().map(|entry| entry.0)
    }

    pub fn last(self: BTreeSet[T]) -> Option[T] {
        self.entries.last().map(|entry| entry.0)
    }

    pub fn lower_bound(self: BTreeSet[T], value: T) -> Option[T] {
        self.entries.lower_bound(value).map(|entry| entry.0)
    }

    pub fn upper_bound(self: BTreeSet[T], value: T) -> Option[T] {
        self.entries.upper_bound(value).map(|entry| entry.0)
    }

    pub fn iter(self: BTreeSet[T]) -> FnIterator[T] {
        let iterator = self.entries.iter();
        FnIterator::from_fn(|| iterator.next().map(|entry| entry.0))
    }

    pub fn range(self: BTreeSet[T], start: T, end: T) -> FnIterator[T] {
        let iterator = self.entries.range(start, end);
        FnIterator::from_fn(|| iterator.next().map(|entry| entry.0))
    }

    pub fn to_vec(self: BTreeSet[T]) -> Vec[T] {
        self.entries.keys()
    }

    pub fn union(self: BTreeSet[T], other: BTreeSet[T]) -> BTreeSet[T] {
        let mut result = self;
        for value in other {
            result = result.insert(value);
        }
        result
    }

    pub fn intersection(self: BTreeSet[T], other: BTreeSet[T]) -> BTreeSet[T] {
        let mut result = BTreeSet::new();
        for value in self {
            if other.contains(value) {
                result = result.insert(value);
            }
        }
        result
    }

    pub fn difference(self: BTreeSet[T], other: BTreeSet[T]) -> BTreeSet[T] {
        let mut result = self;
        for value in other {
            result = result.remove(value);
        }
        result
    }

    pub fn symmetric_difference(self: BTreeSet[T], other: BTreeSet[T]) -> BTreeSet[T] {
        let mut result = self;
        for value in other {
            if self.contains(value) {
                result = result.remove(value);
            } else {
                result = result.insert(value);
            }
        }
        result
    }

    pub fn is_subset(self: BTreeSet[T], other: BTreeSet[T]) -> bool {
        if self.len() > other.len() {
            return false
        }
        for value in self {
            if !other.contains(value) {
                return false
            }
        }
        true
    }

    pub fn is_disjoint(self: BTreeSet[T], other: BTreeSet[T]) -> bool {
        for value in self {
            if other.contains(value) {
                return false
            }
        }
        true
    }
}

impl[T: cmp::Ord] IntoIterator for BTreeSet[T] {
    type Item = T;

    type IntoIter = FnIterator[T];

    fn into_iter(self: BTreeSet[T]) -> FnIterator[T] {
        self.iter()
    }
}

impl[T: cmp::Ord] PartialEq for BTreeSet[T] {
    fn eq(self: BTreeSet[T], other: BTreeSet[T]) -> bool {
        self.entries == other.entries
    }
}

impl[T: cmp::Ord] Eq for BTreeSet[T] {}
