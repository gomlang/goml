package tests;

use std::collections::imm;
use std::testing;

#[test]
fn vector_empty_and_checked_indexes() -> () {
    let empty: imm::Vector[isize] = imm::Vector::new();
    let default: imm::Vector[isize] = Default::default();
    testing::assert(empty == default);
    testing::assert(empty.is_empty());
    assert_equal(empty.len(), 0);
    testing::assert_none(empty.first());
    testing::assert_none(empty.last());
    testing::assert_none(empty.pop());
    testing::assert_none(empty.get(-1));
    testing::assert_none(empty.get(0));
    testing::assert_none(empty.set(-1, 1));
    testing::assert_none(empty.set(0, 1));
    testing::assert_none(empty.iter().next());
    let one = empty.push(7);
    assert_equal(one.first(), Option::Some(7));
    assert_equal(one.last(), Option::Some(7));
    testing::assert_none(one.get(-1));
    testing::assert_none(one.get(1));
    testing::assert_none(one.get(9223372036854775807));
    testing::assert_none(one.set(-1, 8));
    testing::assert_none(one.set(1, 8));
    let (value, rest) = testing::expect_some(one.pop(), "singleton pop");
    assert_equal(value, 7);
    testing::assert(rest == empty);
    assert_equal(one.first(), Option::Some(7));
}

#[test]
fn vector_versions_across_tree_boundaries() -> () {
    let boundaries = Vec::from_array(
        [
            1,
            31,
            32,
            33,
            63,
            64,
            65,
            1023,
            1024,
            1025,
            1055,
            1056,
            1057,
            32767,
            32768,
            32769,
            32799,
            32800,
            32801,
        ],
    );
    let versions: Vec[imm::Vector[isize]] = Vec::new();
    let mut values: imm::Vector[isize] = imm::Vector::new();
    for value in 0..32802 {
        values = values.push(value);
        if boundaries.contains(values.len()) {
            versions.push(values);
        }
    }
    assert_equal(versions.len(), boundaries.len());
    for index in 0..versions.len() {
        let version = versions[index];
        assert_equal(version.len(), boundaries[index]);
        assert_equal(version.first(), Option::Some(0));
        assert_equal(version.last(), Option::Some(version.len() - 1));
        let middle = version.len() / 2;
        let changed = testing::expect_some(version.set(middle, -1), "replace inside version");
        assert_equal(changed.get(middle), Option::Some(-1));
        assert_equal(version.get(middle), Option::Some(middle));
        let extended = version.push(-2);
        assert_equal(extended.last(), Option::Some(-2));
        assert_equal(version.last(), Option::Some(version.len() - 1));
        let (last, shortened) = testing::expect_some(version.pop(), "pop retained version");
        assert_equal(last, version.len() - 1);
        assert_equal(shortened.len(), version.len() - 1);
        testing::assert(shortened.push(last) == version);
        let mut expected = 0;
        for value in version {
            assert_equal(value, expected);
            expected += 1;
        }
        assert_equal(expected, version.len());
    }
    let original = values;
    let mut expected = values.len();
    while expected > 0 {
        let (value, remaining) = testing::expect_some(values.pop(), "shrinking tree");
        expected -= 1;
        assert_equal(value, expected);
        assert_equal(remaining.len(), expected);
        if expected > 0 {
            assert_equal(remaining.first(), Option::Some(0));
            assert_equal(remaining.last(), Option::Some(expected - 1));
            assert_equal(remaining.get(expected / 2), Option::Some(expected / 2));
        }
        values = remaining;
    }
    testing::assert(values.is_empty());
    testing::assert_none(values.pop());
    assert_equal(original.len(), 32802);
    assert_equal(original.last(), Option::Some(32801));
    assert_equal(values.push(17).to_vec(), Vec::from_array([17]));
}

#[test]
fn vector_mutable_conversions_and_iterator_snapshot() -> () {
    let input: Vec[isize] = Vec::new();
    for value in 0..65 {
        input.push(value);
    }
    let original = imm::Vector::from_vec(input);
    let iterator = original.iter();
    input[0] = -1;
    input[64] = -2;
    input.clear();
    let output = original.to_vec();
    output[1] = -3;
    output[64] = -4;
    output.clear();
    let changed = testing::expect_some(original.set(0, -5), "replace tree value");
    let changed = testing::expect_some(changed.set(64, -6), "replace tail value");
    assert_equal(changed.get(0), Option::Some(-5));
    assert_equal(changed.get(64), Option::Some(-6));
    testing::assert(changed != original);
    testing::assert(original.push(65) != original);
    for expected in 0..65 {
        assert_equal(original.get(expected), Option::Some(expected));
        assert_equal(iterator.next(), Option::Some(expected));
    }
    testing::assert_none(iterator.next());
    testing::assert_none(iterator.next());
    testing::assert(imm::Vector::from_vec(original.to_vec()) == original);
    let independent = original.iter();
    assert_equal(independent.next(), Option::Some(0));
}

#[test]
fn vector_elements_preserve_reference_identity() -> () {
    let element = Ref::new(1);
    let mut values: imm::Vector[Ref[isize]] = imm::Vector::new();
    for _ in 0..33 {
        values = values.push(element);
    }
    let replacement = Ref::new(2);
    let branch = testing::expect_some(values.set(0, replacement), "replace reference slot");
    element.set(3);
    assert_equal(testing::expect_some(values.first(), "original reference").get(), 3);
    assert_equal(testing::expect_some(branch.first(), "replacement reference").get(), 2);
    assert_equal(testing::expect_some(branch.last(), "shared tail reference").get(), 3);
    let output = values.to_vec();
    output[0] = replacement;
    assert_equal(testing::expect_some(values.first(), "isolated slot").get(), 3);
    output[1].set(4);
    assert_equal(testing::expect_some(values.last(), "shallow element").get(), 4);
    testing::assert(imm::Vector::from_vec(values.to_vec()) == values);
    testing::assert(branch != values);
}
