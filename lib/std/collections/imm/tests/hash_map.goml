package tests;

use std::collections::imm;
use std::testing;

struct HamtTestKey {
    value: isize,
    bits: u64,
}

impl PartialEq for HamtTestKey {
    fn eq(self: HamtTestKey, other: HamtTestKey) -> bool {
        self.value == other.value && self.bits == other.bits
    }
}

impl Eq for HamtTestKey {}

impl Hash for HamtTestKey {
    fn hash(self: HamtTestKey) -> u64 {
        self.bits
    }
}

fn hamt_reference_key(value: isize) -> HamtTestKey {
    HamtTestKey {
        value,
        bits: if value % 5 == 0 {
            17
        } else {
            (value.to_u64() << 55) | (value % 3).to_u64()
        },
    }
}

fn check_hamt_reference(actual: imm::HashMap[HamtTestKey, isize], expected: Vec[Option[isize]]) -> () {
    let mut count = 0;
    for key in 0..expected.len() {
        testing::assert(actual.get(hamt_reference_key(key)) == expected[key]);
        testing::assert(actual.contains_key(hamt_reference_key(key)) == expected[key].is_some());
        if expected[key].is_some() {
            count += 1;
        }
    }
    testing::assert(actual.len() == count);
    let seen = Vec::with_capacity(expected.len());
    for _ in 0..expected.len() {
        seen.push(false);
    }
    let mut iterated = 0;
    for (key, value) in actual {
        testing::assert(!seen[key.value]);
        seen[key.value] = true;
        testing::assert(expected[key.value] == Option::Some(value));
        iterated += 1;
    }
    testing::assert(iterated == count);
}

#[test]
fn immutable_hash_map_preserves_branches_and_snapshots() -> () {
    let empty: imm::HashMap[string, isize] = Default::default();
    testing::assert(empty.is_empty());
    testing::assert(empty.len() == 0);
    testing::assert(empty.get("a").is_none());
    testing::assert(empty.remove("a") == empty);
    testing::assert(empty.iter().next().is_none());
    let first = empty.insert("a", 1).insert("b", 2);
    let iterator = first.iter();
    let second = first.insert("a", 3).insert("c", 4);
    let third = first.remove("a").insert("d", 5);
    testing::assert(empty.is_empty());
    testing::assert(first.len() == 2);
    testing::assert(first.get("a") == Option::Some(1));
    testing::assert(first.get("b") == Option::Some(2));
    testing::assert(first.get("c").is_none());
    testing::assert(first.get("d").is_none());
    testing::assert(second.len() == 3);
    testing::assert(second.get("a") == Option::Some(3));
    testing::assert(third.len() == 2);
    testing::assert(third.get("a").is_none());
    testing::assert(third.get("d") == Option::Some(5));
    let mut collected = imm::HashMap::new();
    for (key, value) in iterator {
        collected = collected.insert(key, value);
    }
    testing::assert(collected == first);
    testing::assert(iterator.next().is_none());
    testing::assert(iterator.next().is_none());
    testing::assert(first.remove("missing") == first);
    testing::assert(first.remove("a").remove("b").is_empty());
    let reverse = imm::HashMap::from_vec(Vec::from_array([("b", 2), ("a", 1)]));
    testing::assert(first == reverse);
    testing::assert(first != first.insert("a", 2));
    testing::assert(first != third);
}

#[test]
fn immutable_hash_map_copies_container_storage() -> () {
    let input = Vec::from_array([("a", 1), ("b", 2), ("a", 3)]);
    let map = imm::HashMap::from_vec(input);
    input[0] = ("a", 99);
    input.clear();
    testing::assert(map.len() == 2);
    testing::assert(map.get("a") == Option::Some(3));
    let output = map.entries();
    output[0] = ("changed", 100);
    output.clear();
    let keys = map.keys();
    let values = map.values();
    testing::assert(keys.len() == 2);
    testing::assert(values.len() == 2);
    testing::assert(keys.contains("a") && keys.contains("b"));
    testing::assert(values.contains(2) && values.contains(3));
    keys.clear();
    values.clear();
    testing::assert(map.len() == 2);
    testing::assert(map.get("a") == Option::Some(3));
    testing::assert(map.get("b") == Option::Some(2));
    let cell = Ref::new(1);
    let references: imm::HashMap[string, Ref[isize]] = imm::HashMap::new();
    let original = references.insert("value", cell);
    let changed = original.insert("value", Ref::new(9));
    cell.set(2);
    testing::assert(testing::expect_some(original.get("value"), "shared element").get() == 2);
    testing::assert(testing::expect_some(changed.get("value"), "replaced element").get() == 9);
    let nan = float64_from_bits(0x7ff8000000000000);
    let partial: imm::HashMap[string, f64] = imm::HashMap::new();
    let partial = partial.insert("nan", nan);
    testing::assert(partial != partial);
}

#[test]
fn immutable_hash_map_handles_full_hash_collisions() -> () {
    let mut map: imm::HashMap[HamtTestKey, isize] = imm::HashMap::new();
    for value in 0..80 {
        map = map.insert(HamtTestKey { value, bits: 7 }, value * 2);
    }
    let original = map;
    let iterator = original.iter();
    for value in 0..80 {
        map = if value % 2 == 0 {
            map.remove(HamtTestKey { value, bits: 7 })
        } else {
            map.insert(HamtTestKey { value, bits: 7 }, -value)
        };
    }
    testing::assert(map.len() == 40);
    testing::assert(original.len() == 80);
    for value in 0..80 {
        testing::assert(original.get(HamtTestKey { value, bits: 7 }) == Option::Some(value * 2));
        let expected = if value % 2 == 0 {
            Option::None
        } else {
            Option::Some(-value)
        };
        testing::assert(map.get(HamtTestKey { value, bits: 7 }) == expected);
    }
    testing::assert(map.remove(HamtTestKey { value: 100, bits: 7 }) == map);
    testing::assert(map.get(HamtTestKey { value: 1, bits: 8 }).is_none());
    let mut count = 0;
    for (key, value) in iterator {
        testing::assert(value == key.value * 2);
        count += 1;
    }
    testing::assert(count == 80);
    for value in 0..80 {
        map = map.remove(HamtTestKey { value, bits: 7 });
    }
    testing::assert(map.is_empty());
    testing::assert(map.iter().next().is_none());
}

#[test]
fn immutable_hash_map_uses_all_hash_bits_and_compacts_paths() -> () {
    let mut map: imm::HashMap[HamtTestKey, isize] = imm::HashMap::new();
    for value in 0..16 {
        map = map.insert(HamtTestKey { value, bits: value.to_u64() << 60 }, value);
    }
    let deep = map;
    for value in 1..32 {
        map = map.insert(HamtTestKey { value: value + 100, bits: value.to_u64() }, -value);
    }
    let wide = map;
    for value in 0..16 {
        testing::assert(
            map.get(HamtTestKey { value, bits: value.to_u64() << 60 }) == Option::Some(value),
        );
    }
    for value in 1..32 {
        testing::assert(
            map.get(HamtTestKey { value: value + 100, bits: value.to_u64() })
                == Option::Some(-value),
        );
        map = map.remove(HamtTestKey { value: value + 100, bits: value.to_u64() });
    }
    testing::assert(map == deep);
    for value in 0..15 {
        map = map.remove(HamtTestKey { value, bits: value.to_u64() << 60 });
    }
    testing::assert(map.len() == 1);
    testing::assert(map.get(HamtTestKey { value: 15, bits: 15.to_u64() << 60 }) == Option::Some(15));
    map = map.insert(HamtTestKey { value: 32, bits: 32 }, 32);
    testing::assert(map.len() == 2);
    testing::assert(map.get(HamtTestKey { value: 32, bits: 32 }) == Option::Some(32));
    testing::assert(map.get(HamtTestKey { value: 15, bits: 15.to_u64() << 60 }) == Option::Some(15));
    testing::assert(wide.len() == 47);
    testing::assert(deep.len() == 16);
}

#[test]
fn immutable_hash_map_matches_reference_with_retained_versions() -> () {
    let mut actual: imm::HashMap[HamtTestKey, isize] = imm::HashMap::new();
    let expected: Vec[Option[isize]] = Vec::new();
    let versions: Vec[(imm::HashMap[HamtTestKey, isize], Vec[Option[isize]])] = Vec::new();
    for _ in 0..65 {
        expected.push(Option::None);
    }
    let mut state: u64 = 2319;
    for step in 0..512 {
        state = state * 6364136223846793005 + 1442695040888963407;
        let key = ((state >> 32) % 65).to_isize();
        if state & 3 == 0 {
            actual = actual.remove(hamt_reference_key(key));
            expected[key] = Option::None;
        } else {
            actual = actual.insert(hamt_reference_key(key), step);
            expected[key] = Option::Some(step);
        }
        check_hamt_reference(actual, expected);
        if step % 23 == 0 {
            versions.push((actual, expected.copy()));
        }
    }
    for (version, reference) in versions {
        check_hamt_reference(version, reference);
        let branch = version.insert(hamt_reference_key(0), -1).remove(hamt_reference_key(1));
        check_hamt_reference(version, reference);
        let branch_reference = reference.copy();
        branch_reference[0] = Option::Some(-1);
        branch_reference[1] = Option::None;
        check_hamt_reference(branch, branch_reference);
    }
}
