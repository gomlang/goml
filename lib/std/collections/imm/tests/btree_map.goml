package tests;

use std::collections::imm;
use std::iter;
use std::testing;

fn check_btree_reference(map: imm::BTreeMap[isize, isize], reference: Vec[Option[isize]]) -> () {
    let expected = Vec::new();
    for key in 0..reference.len() {
        assert_equal(map.get(key), reference[key]);
        assert_equal(map.contains_key(key), reference[key].is_some());
        if let Option::Some(value) = reference[key] {
            expected.push((key, value))
        }
    }
    assert_equal(map.len(), expected.len());
    assert_equal(map.is_empty(), expected.is_empty());
    assert_equal(map.entries(), expected);
    if expected.is_empty() {
        assert_equal(map.first(), Option::None);
        assert_equal(map.last(), Option::None);
    } else {
        assert_equal(map.first(), Option::Some(expected[0]));
        assert_equal(map.last(), expected.last());
    }
}

#[test]
fn imm_btree_map_empty_and_updates() -> () {
    let empty: imm::BTreeMap[isize, string] = Default::default();
    testing::assert(empty.is_empty());
    assert_equal(empty.len(), 0);
    assert_equal(empty.get(10), Option::None);
    assert_equal(empty.first(), Option::None);
    assert_equal(empty.last(), Option::None);
    assert_equal(empty.lower_bound(10), Option::None);
    assert_equal(empty.upper_bound(10), Option::None);
    let empty_iterator = empty.iter();
    assert_equal(empty_iterator.next(), Option::None);
    assert_equal(empty_iterator.next(), Option::None);
    testing::assert(empty.remove(10).is_empty());
    let initial = empty.insert(10, "old");
    let replaced = initial.insert(10, "new");
    let left = initial.insert(5, "left");
    let right = initial.insert(15, "right");
    assert_equal(initial.len(), 1);
    assert_equal(replaced.len(), 1);
    assert_equal(initial.get(10), Option::Some("old"));
    assert_equal(replaced.get(10), Option::Some("new"));
    assert_equal(left.entries(), Vec::from_array([(5, "left"), (10, "old")]));
    assert_equal(right.entries(), Vec::from_array([(10, "old"), (15, "right")]));
    testing::assert(initial.remove(10).is_empty());
    testing::assert(initial.remove(99) == initial);
    testing::assert(initial != replaced);
    testing::assert(initial != left);
    testing::assert(initial == imm::BTreeMap::from_vec(Vec::from_array([(10, "old")])));
    testing::assert(empty.is_empty());
}

#[test]
fn imm_btree_map_split_borrow_merge_and_persistence() -> () {
    let mut map: imm::BTreeMap[isize, isize] = imm::BTreeMap::new();
    let versions = Vec::new();
    for key in 0..2048 {
        map = map.insert(key, key * 3);
        if key % 127 == 0 {
            versions.push(map)
        }
    }
    let original = map;
    let iterator = original.iter();
    let mut descending = original;
    let mut alternating = original;
    for step in 0..2048 {
        let previous = map;
        map = map.remove(step);
        descending = descending.remove(2047 - step);
        let key = if step % 2 == 0 {
            step / 2
        } else {
            2047 - step / 2
        };
        alternating = alternating.remove(key);
        assert_equal(map.len(), 2047 - step);
        assert_equal(descending.len(), 2047 - step);
        assert_equal(alternating.len(), 2047 - step);
        assert_equal(previous.get(step), Option::Some(step * 3));
        assert_equal(map.get(step), Option::None);
        assert_equal(descending.get(2047 - step), Option::None);
        assert_equal(alternating.get(key), Option::None);
        if step < 2047 {
            assert_equal(map.first(), Option::Some((step + 1, (step + 1) * 3)));
            assert_equal(descending.last(), Option::Some((2046 - step, (2046 - step) * 3)));
        }
        if step % 127 == 0 {
            let ascending_entries = map.entries();
            for index in 0..ascending_entries.len() {
                let expected_key = step + 1 + index;
                assert_equal(ascending_entries[index], (expected_key, expected_key * 3));
            }
            let descending_entries = descending.entries();
            for index in 0..descending_entries.len() {
                assert_equal(descending_entries[index], (index, index * 3));
            }
        }
    }
    testing::assert(map.is_empty());
    testing::assert(descending.is_empty());
    testing::assert(alternating.is_empty());
    assert_equal(map.first(), Option::None);
    assert_equal(map.last(), Option::None);
    assert_equal(original.len(), 2048);
    for key in 0..2048 {
        assert_equal(iterator.next(), Option::Some((key, key * 3)));
        assert_equal(original.get(key), Option::Some(key * 3));
    }
    assert_equal(iterator.next(), Option::None);
    for version in versions {
        for key in 0..version.len() {
            assert_equal(version.get(key), Option::Some(key * 3));
        }
        assert_equal(version.get(version.len()), Option::None);
    }
    let restarted = map.insert(7, 49).insert(3, 9);
    assert_equal(restarted.entries(), Vec::from_array([(3, 9), (7, 49)]));
    testing::assert(map.is_empty());
}

#[test]
fn imm_btree_map_reference_operations() -> () {
    let mut map: imm::BTreeMap[isize, isize] = imm::BTreeMap::new();
    let reference: Vec[Option[isize]] = Vec::new();
    for _ in 0..257 {
        reference.push(Option::None)
    }
    let histories = Vec::new();
    let mut seed = 713;
    for step in 0..4096 {
        seed = (seed * 37 + 19) % 104729;
        let key = seed % 257;
        let previous = map;
        let previous_value = map.get(key);
        if seed % 5 < 2 {
            map = map.remove(key);
            reference[key] = Option::None;
        } else {
            map = map.insert(key, step);
            reference[key] = Option::Some(step);
        }
        assert_equal(previous.get(key), previous_value);
        if step % 31 == 0 {
            check_btree_reference(map, reference)
        }
        if step % 127 == 0 {
            histories.push((map, reference.copy()))
        }
    }
    check_btree_reference(map, reference);
    for (version, expected) in histories {
        check_btree_reference(version, expected)
    }
    let reversed = map.entries();
    reversed.reverse();
    testing::assert(map == imm::BTreeMap::from_vec(reversed));
}

#[test]
fn imm_btree_map_ranges_and_bounds() -> () {
    let mut map: imm::BTreeMap[isize, isize] = imm::BTreeMap::new();
    for index in 0..512 {
        map = map.insert(index * 2, index * 3);
    }
    assert_equal(map.lower_bound(-1), Option::Some((0, 0)));
    assert_equal(map.upper_bound(-1), Option::Some((0, 0)));
    assert_equal(map.lower_bound(1023), Option::None);
    assert_equal(map.upper_bound(1022), Option::None);
    for index in 0..511 {
        assert_equal(map.lower_bound(index * 2), Option::Some((index * 2, index * 3)));
        assert_equal(
            map.lower_bound(index * 2 + 1),
            Option::Some(((index + 1) * 2, (index + 1) * 3)),
        );
        assert_equal(map.upper_bound(index * 2), Option::Some(((index + 1) * 2, (index + 1) * 3)));
        assert_equal(
            map.upper_bound(index * 2 + 1),
            Option::Some(((index + 1) * 2, (index + 1) * 3)),
        );
    }
    for start in -1..65 {
        for width in 0..5 {
            let end = start + width;
            let expected = Vec::new();
            for key in start..end {
                if key >= 0 && key % 2 == 0 {
                    expected.push((key, key / 2 * 3))
                }
            }
            let iterator = map.range(start, end);
            assert_equal(iter::collect(iterator), expected);
            assert_equal(iterator.next(), Option::None);
        }
    }
    assert_equal(iter::collect(map.range(1000, 2000)), map.entries().slice(500, 512).to_vec());
    assert_equal(iter::collect(map.range(7, 2)).len(), 0);
    assert_equal(iter::collect(map.range(2000, 2001)).len(), 0);
    let range = map.range(510, 518);
    let derived = map.remove(512).insert(513, -1);
    assert_equal(
        iter::collect(range),
        Vec::from_array([(510, 765), (512, 768), (514, 771), (516, 774)]),
    );
    assert_equal(derived.get(512), Option::None);
    assert_equal(map.get(512), Option::Some(768));
}

#[test]
fn imm_btree_map_storage_isolation_and_value_semantics() -> () {
    let input = Vec::from_array([(3, 30), (1, 10), (3, 33), (2, 20)]);
    let map = imm::BTreeMap::from_vec(input);
    input[0] = (9, 90);
    input.clear();
    assert_equal(map.entries(), Vec::from_array([(1, 10), (2, 20), (3, 33)]));
    let entries = map.entries();
    let keys = map.keys();
    let values = map.values();
    entries[0] = (9, 99);
    entries.clear();
    keys[0] = 100;
    values[0] = 100;
    assert_equal(map.keys(), Vec::from_array([1, 2, 3]));
    assert_equal(map.values(), Vec::from_array([10, 20, 33]));
    let nested = Ref::new(7);
    let shared = imm::BTreeMap::new().insert(1, nested);
    let changed = shared.insert(2, Ref::new(9));
    nested.set(8);
    assert_equal(testing::expect_some(shared.get(1), "shared value").get(), 8);
    assert_equal(testing::expect_some(changed.get(1), "derived shared value").get(), 8);
    let replaced = changed.insert(1, Ref::new(11));
    assert_equal(testing::expect_some(shared.get(1), "preserved value").get(), 8);
    assert_equal(testing::expect_some(replaced.get(1), "replaced value").get(), 11);
    let nan = float64_from_bits(0x7ff8000000000000);
    let nan_map = imm::BTreeMap::new().insert(1, nan);
    testing::assert(nan_map != nan_map);
}

#[test]
fn imm_btree_map_borrows_preserve_neighbors() -> () {
    let mut ascending: imm::BTreeMap[isize, isize] = imm::BTreeMap::new();
    let mut descending: imm::BTreeMap[isize, isize] = imm::BTreeMap::new();
    for index in 0..17 {
        ascending = ascending.insert(index, index);
        descending = descending.insert(16 - index, 16 - index);
    }
    let removed_first = ascending.remove(0);
    let removed_last = descending.remove(16);
    let replaced_middle = ascending.insert(7, 70);
    let removed_middle = ascending.remove(7);
    for key in 0..17 {
        assert_equal(ascending.get(key), Option::Some(key));
        assert_equal(descending.get(key), Option::Some(key));
        assert_equal(
            removed_first.get(key),
            if key == 0 {
                Option::None
            } else {
                Option::Some(key)
            },
        );
        assert_equal(
            removed_last.get(key),
            if key == 16 {
                Option::None
            } else {
                Option::Some(key)
            },
        );
        assert_equal(
            removed_middle.get(key),
            if key == 7 {
                Option::None
            } else {
                Option::Some(key)
            },
        );
    }
    assert_equal(replaced_middle.get(7), Option::Some(70));
    assert_equal(replaced_middle.len(), 17);
    assert_equal(removed_first.len(), 16);
    assert_equal(removed_last.len(), 16);
    assert_equal(removed_middle.len(), 16);
}
