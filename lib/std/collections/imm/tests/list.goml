package tests;

use std::collections::imm;
use std::testing;

#[test]
fn list_empty_and_default() -> () {
    let empty: imm::List[isize] = imm::List::new();
    let default: imm::List[isize] = Default::default();
    testing::assert(empty == default);
    testing::assert(empty.is_empty());
    assert_equal(empty.len(), 0);
    testing::assert_none(empty.first());
    testing::assert_none(empty.tail());
    testing::assert_none(empty.pop_front());
    testing::assert_none(empty.iter().next());
    testing::assert(empty.reverse() == empty);
    testing::assert(empty.to_vec().is_empty());
    let singleton = empty.push_front(7);
    let (value, rest) = testing::expect_some(singleton.pop_front(), "singleton pop");
    assert_equal(value, 7);
    testing::assert(rest == empty);
    assert_equal(singleton.first(), Option::Some(7));
}

#[test]
fn list_versions_and_mutable_conversions() -> () {
    let input = Vec::from_array([1, 2, 3]);
    let original = imm::List::from_vec(input);
    let iterator = original.iter();
    input[0] = 99;
    input.push(4);
    let left = original.push_front(0);
    let right = original.push_front(-1);
    testing::assert(original == imm::List::from_vec(Vec::from_array([1, 2, 3])));
    testing::assert(left != right);
    testing::assert(original != left);
    assert_equal(left.to_vec(), Vec::from_array([0, 1, 2, 3]));
    assert_equal(right.to_vec(), Vec::from_array([-1, 1, 2, 3]));
    testing::assert(testing::expect_some(left.tail(), "shared tail") == original);
    let (value, tail) = testing::expect_some(right.pop_front(), "branch pop");
    assert_equal(value, -1);
    testing::assert(tail == original);
    let output = original.to_vec();
    output[0] = 42;
    output.clear();
    assert_equal(original.to_vec(), Vec::from_array([1, 2, 3]));
    assert_equal(iterator.next(), Option::Some(1));
    assert_equal(iterator.next(), Option::Some(2));
    assert_equal(iterator.next(), Option::Some(3));
    testing::assert_none(iterator.next());
    testing::assert_none(iterator.next());
    assert_equal(original.reverse().to_vec(), Vec::from_array([3, 2, 1]));
}

#[test]
fn list_long_iteration_and_reversal() -> () {
    let mut values: imm::List[isize] = imm::List::new();
    for value in 0..10000 {
        values = values.push_front(value);
    }
    let ascending = values.reverse();
    assert_equal(ascending.len(), 10000);
    testing::assert(ascending.reverse() == values);
    let mut expected = 0;
    for value in ascending {
        assert_equal(value, expected);
        expected += 1;
    }
    assert_equal(expected, 10000);
    let mut remaining = ascending;
    for expected in 0..10000 {
        let (value, tail) = testing::expect_some(remaining.pop_front(), "long list pop");
        assert_equal(value, expected);
        remaining = tail;
    }
    testing::assert(remaining.is_empty());
    assert_equal(ascending.first(), Option::Some(0));
    assert_equal(values.first(), Option::Some(9999));
}

#[test]
fn list_elements_preserve_reference_identity() -> () {
    let element = Ref::new(1);
    let values = imm::List::from_vec(Vec::from_array([element]));
    let branch = values.push_front(Ref::new(2));
    element.set(3);
    assert_equal(testing::expect_some(values.first(), "reference element").get(), 3);
    let tail = testing::expect_some(branch.tail(), "reference branch tail");
    testing::assert(tail == values);
    testing::expect_some(tail.first(), "shared reference").set(4);
    assert_equal(element.get(), 4);
    let different = imm::List::from_vec(Vec::from_array([Ref::new(4)]));
    testing::assert(values != different);
}
