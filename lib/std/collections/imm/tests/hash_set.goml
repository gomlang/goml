package tests;

use std::collections::imm;
use std::testing;

#[test]
fn immutable_hash_set_preserves_versions_and_storage() -> () {
    let empty: imm::HashSet[isize] = Default::default();
    testing::assert(empty.is_empty());
    testing::assert(empty.iter().next().is_none());
    let input = Vec::from_array([1, 2, 1, 3]);
    let first = imm::HashSet::from_vec(input);
    let iterator = first.iter();
    input.clear();
    let second = first.insert(4).remove(2);
    let third = first.insert(5).remove(1);
    testing::assert(empty.is_empty());
    testing::assert(first.len() == 3);
    testing::assert(first.contains(1) && first.contains(2) && first.contains(3));
    testing::assert(!first.contains(4) && !first.contains(5));
    testing::assert(second.contains(4) && !second.contains(2));
    testing::assert(third.contains(5) && !third.contains(1));
    testing::assert(first.insert(1) == first);
    testing::assert(first.remove(10) == first);
    testing::assert(first != second);
    testing::assert(first != first.insert(4));
    let reverse = imm::HashSet::from_vec(Vec::from_array([3, 2, 1]));
    testing::assert(first == reverse);
    let output = first.to_vec();
    testing::assert(output.len() == 3);
    output[0] = 99;
    output.clear();
    testing::assert(first == reverse);
    let mut collected = imm::HashSet::new();
    for value in iterator {
        collected = collected.insert(value);
    }
    testing::assert(collected == first);
    testing::assert(iterator.next().is_none());
    testing::assert(first.remove(1).remove(2).remove(3) == empty);
}

#[test]
fn immutable_hash_set_algebra() -> () {
    let empty: imm::HashSet[isize] = imm::HashSet::new();
    let left = imm::HashSet::from_vec(Vec::from_array([1, 2, 3]));
    let right = imm::HashSet::from_vec(Vec::from_array([3, 4, 5]));
    testing::assert(left.union(right) == imm::HashSet::from_vec(Vec::from_array([1, 2, 3, 4, 5])));
    testing::assert(left.intersection(right) == empty.insert(3));
    testing::assert(left.difference(right) == imm::HashSet::from_vec(Vec::from_array([1, 2])));
    testing::assert(
        left.symmetric_difference(right) == imm::HashSet::from_vec(Vec::from_array([1, 2, 4, 5])),
    );
    testing::assert(left.union(right) == right.union(left));
    testing::assert(left.intersection(right) == right.intersection(left));
    testing::assert(left.symmetric_difference(right) == right.symmetric_difference(left));
    testing::assert(left.union(empty) == left);
    testing::assert(left.intersection(empty).is_empty());
    testing::assert(left.difference(empty) == left);
    testing::assert(empty.difference(left).is_empty());
    testing::assert(left.symmetric_difference(empty) == left);
    testing::assert(left.union(left) == left);
    testing::assert(left.intersection(left) == left);
    testing::assert(left.difference(left).is_empty());
    testing::assert(left.symmetric_difference(left).is_empty());
    testing::assert(empty.is_subset(left));
    testing::assert(left.is_subset(left));
    testing::assert(!left.is_subset(right));
    testing::assert(!left.is_subset(empty));
    testing::assert(left.is_subset(left.union(right)));
    testing::assert(empty.is_disjoint(left));
    testing::assert(left.is_disjoint(empty));
    testing::assert(!left.is_disjoint(right));
    testing::assert(left.difference(right).is_disjoint(right));
    testing::assert(left.len() == 3 && right.len() == 3);
}

#[test]
fn immutable_hash_set_collision_algebra() -> () {
    let mut left: imm::HashSet[HamtTestKey] = imm::HashSet::new();
    let mut right: imm::HashSet[HamtTestKey] = imm::HashSet::new();
    for value in 0..48 {
        let key = HamtTestKey { value, bits: 0 };
        if value < 32 {
            left = left.insert(key);
        }
        if value >= 16 {
            right = right.insert(key);
        }
    }
    let union = left.union(right);
    let intersection = left.intersection(right);
    let difference = left.difference(right);
    let symmetric = left.symmetric_difference(right);
    testing::assert(union.len() == 48);
    testing::assert(intersection.len() == 16);
    testing::assert(difference.len() == 16);
    testing::assert(symmetric.len() == 32);
    for value in 0..48 {
        let key = HamtTestKey { value, bits: 0 };
        testing::assert(union.contains(key));
        testing::assert(intersection.contains(key) == (value >= 16 && value < 32));
        testing::assert(difference.contains(key) == (value < 16));
        testing::assert(symmetric.contains(key) == (value < 16 || value >= 32));
        testing::assert(left.contains(key) == (value < 32));
        testing::assert(right.contains(key) == (value >= 16));
    }
    testing::assert(intersection.is_subset(left));
    testing::assert(intersection.is_subset(right));
    testing::assert(difference.is_disjoint(right));
}
