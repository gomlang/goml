package tests;

use std::collections::imm;
use std::iter;
use std::testing;

#[test]
fn imm_btree_set_updates_order_and_persistence() -> () {
    let empty: imm::BTreeSet[isize] = Default::default();
    testing::assert(empty.is_empty());
    assert_equal(empty.first(), Option::None);
    assert_equal(empty.last(), Option::None);
    assert_equal(empty.lower_bound(0), Option::None);
    assert_equal(empty.upper_bound(0), Option::None);
    assert_equal(empty.iter().next(), Option::None);
    assert_equal(empty.range(0, 1).next(), Option::None);
    testing::assert(empty.remove(1) == empty);
    let input = Vec::from_array([3, 1, 2, 3]);
    let initial = imm::BTreeSet::from_vec(input);
    input.clear();
    assert_equal(initial.len(), 3);
    assert_equal(initial.to_vec(), Vec::from_array([1, 2, 3]));
    let iterator = initial.iter();
    let left = initial.insert(4).remove(1);
    let right = initial.insert(0).remove(3);
    assert_equal(left.to_vec(), Vec::from_array([2, 3, 4]));
    assert_equal(right.to_vec(), Vec::from_array([0, 1, 2]));
    assert_equal(iter::collect(iterator), Vec::from_array([1, 2, 3]));
    testing::assert(initial.contains(1));
    testing::assert(!initial.contains(4));
    testing::assert(initial.insert(2) == initial);
    testing::assert(initial.remove(9) == initial);
    testing::assert(initial != left);
    testing::assert(initial != empty);
    assert_equal(initial.first(), Option::Some(1));
    assert_equal(initial.last(), Option::Some(3));
    assert_equal(initial.lower_bound(2), Option::Some(2));
    assert_equal(initial.upper_bound(2), Option::Some(3));
    assert_equal(initial.lower_bound(0), Option::Some(1));
    assert_equal(initial.upper_bound(3), Option::None);
    assert_equal(iter::collect(initial.range(1, 3)), Vec::from_array([1, 2]));
    let values = initial.to_vec();
    values[0] = 99;
    values.clear();
    assert_equal(initial.to_vec(), Vec::from_array([1, 2, 3]));
    let collected = Vec::new();
    for value in initial {
        collected.push(value)
    }
    assert_equal(collected, Vec::from_array([1, 2, 3]));
}

#[test]
fn imm_btree_set_algebra() -> () {
    let left = imm::BTreeSet::from_vec(Vec::from_array([1, 3, 5, 7]));
    let right = imm::BTreeSet::from_vec(Vec::from_array([2, 3, 6, 7]));
    let empty: imm::BTreeSet[isize] = imm::BTreeSet::new();
    assert_equal(left.union(right).to_vec(), Vec::from_array([1, 2, 3, 5, 6, 7]));
    assert_equal(left.intersection(right).to_vec(), Vec::from_array([3, 7]));
    assert_equal(left.difference(right).to_vec(), Vec::from_array([1, 5]));
    assert_equal(left.symmetric_difference(right).to_vec(), Vec::from_array([1, 2, 5, 6]));
    testing::assert(left.union(right) == right.union(left));
    testing::assert(left.intersection(right) == right.intersection(left));
    testing::assert(left.symmetric_difference(right) == right.symmetric_difference(left));
    testing::assert(left.is_subset(left.union(right)));
    testing::assert(!left.is_subset(right));
    testing::assert(!left.is_disjoint(right));
    testing::assert(left.difference(right).is_disjoint(right));
    testing::assert(empty.is_subset(left));
    testing::assert(empty.is_disjoint(left));
    testing::assert(left.is_disjoint(empty));
    testing::assert(left.union(empty) == left);
    testing::assert(empty.union(left) == left);
    testing::assert(left.intersection(empty) == empty);
    testing::assert(left.difference(empty) == left);
    testing::assert(left.symmetric_difference(empty) == left);
    testing::assert(left.difference(left) == empty);
    testing::assert(left.symmetric_difference(left) == empty);
    assert_equal(left.to_vec(), Vec::from_array([1, 3, 5, 7]));
    assert_equal(right.to_vec(), Vec::from_array([2, 3, 6, 7]));
    let mut evens = empty;
    let mut thirds = empty;
    for value in 0..1024 {
        if value % 2 == 0 {
            evens = evens.insert(value);
        }
        if value % 3 == 0 {
            thirds = thirds.insert(value);
        }
    }
    let union = evens.union(thirds);
    let intersection = evens.intersection(thirds);
    let difference = evens.difference(thirds);
    let symmetric = evens.symmetric_difference(thirds);
    for value in 0..1024 {
        assert_equal(union.contains(value), value % 2 == 0 || value % 3 == 0);
        assert_equal(intersection.contains(value), value % 6 == 0);
        assert_equal(difference.contains(value), value % 2 == 0 && value % 3 != 0);
        assert_equal(symmetric.contains(value), (value % 2 == 0) != (value % 3 == 0));
        assert_equal(evens.contains(value), value % 2 == 0);
        assert_equal(thirds.contains(value), value % 3 == 0);
    }
}
