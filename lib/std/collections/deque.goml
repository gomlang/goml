package collections;

pub struct Deque[T] {
    pub slots: Ref[Vec[Option[T]]],
    pub head: Ref[isize],
    pub len: Ref[isize],
}

impl[T] Default for Deque[T] {
    fn default() -> Deque[T] {
        Deque::new()
    }
}

impl[T] Deque[T] {
    pub fn new() -> Deque[T] {
        Deque { slots: Ref::new(Vec::new()), head: Ref::new(0), len: Ref::new(0) }
    }

    pub fn with_capacity(capacity: isize) -> Deque[T] {
        let slots: Vec[Option[T]] = Vec::with_capacity(capacity);
        for _ in 0..capacity {
            slots.push(Option::None);
        }
        Deque { slots: Ref::new(slots), head: Ref::new(0), len: Ref::new(0) }
    }

    pub fn len(self: Deque[T]) -> isize {
        self.len.get()
    }

    pub fn capacity(self: Deque[T]) -> isize {
        self.slots.get().len()
    }

    pub fn is_empty(self: Deque[T]) -> bool {
        self.len.get() == 0
    }

    pub fn ensure_space(self: Deque[T]) -> () {
        if self.len.get() < self.capacity() {} else {
            let old = self.slots.get();
            let old_capacity = old.len();
            let new_capacity = if old_capacity == 0 {
                4
            } else {
                old_capacity * 2
            };
            let next: Vec[Option[T]] = Vec::with_capacity(new_capacity);
            for _ in 0..new_capacity {
                next.push(Option::None);
            }
            let mut index = 0;
            while index < self.len.get() {
                let old_index = (self.head.get() + index) % old_capacity;
                next[index] = old[old_index];
                index += 1;
            }
            self.slots.set(next);
            self.head.set(0)
        }
    }

    pub fn push_back(self: Deque[T], value: T) -> () {
        self.ensure_space();
        let index = (self.head.get() + self.len.get()) % self.capacity();
        self.slots.get()[index] = Option::Some(value);
        self.len.set(self.len.get() + 1)
    }

    pub fn push_front(self: Deque[T], value: T) -> () {
        self.ensure_space();
        let index = (self.head.get() - 1 + self.capacity()) % self.capacity();
        self.head.set(index);
        self.slots.get()[index] = Option::Some(value);
        self.len.set(self.len.get() + 1)
    }

    pub fn pop_front(self: Deque[T]) -> Option[T] {
        if self.len.get() == 0 {
            Option::None
        } else {
            let index = self.head.get();
            let value = self.slots.get()[index];
            self.slots.get()[index] = Option::None;
            self.len.set(self.len.get() - 1);
            if self.len.get() == 0 {
                self.head.set(0)
            } else {
                self.head.set((index + 1) % self.capacity())
            }
            value
        }
    }

    pub fn pop_back(self: Deque[T]) -> Option[T] {
        if self.len.get() == 0 {
            Option::None
        } else {
            let index = (self.head.get() + self.len.get() - 1) % self.capacity();
            let value = self.slots.get()[index];
            self.slots.get()[index] = Option::None;
            self.len.set(self.len.get() - 1);
            if self.len.get() == 0 {
                self.head.set(0)
            }
            value
        }
    }

    pub fn front(self: Deque[T]) -> Option[T] {
        if self.len.get() == 0 {
            Option::None
        } else {
            self.slots.get()[self.head.get()]
        }
    }

    pub fn back(self: Deque[T]) -> Option[T] {
        if self.len.get() == 0 {
            Option::None
        } else {
            self.slots.get()[(self.head.get() + self.len.get() - 1) % self.capacity()]
        }
    }

    pub fn get(self: Deque[T], index: isize) -> Option[T] {
        if index < 0 || index >= self.len.get() {
            Option::None
        } else {
            self.slots.get()[(self.head.get() + index) % self.capacity()]
        }
    }

    pub fn clear(self: Deque[T]) -> () {
        while self.len.get() > 0 {
            let _ = self.pop_back();
        }
    }
}
