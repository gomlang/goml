package rand;

use module::math;
use module::math::bits;
use module::num;
use num::ToFloat;

pub trait Source {
    fn next_u64(self: Self) -> u64;
}

pub enum SampleError {
    ZeroBound,
    InvalidRange,
    NegativeLength,
}

impl ToString for SampleError {
    fn to_string(self: SampleError) -> string {
        match self {
            ZeroBound => "random bound must be positive",
            InvalidRange => "random range must have a smaller start than end",
            NegativeLength => "random output length must be nonnegative",
        }
    }
}

impl Debug for SampleError {
    fn debug(self: SampleError) -> string {
        self.to_string()
    }
}

pub struct Generator[S] {
    source: S,
}

fn sample_bounded[S: Source](source: S, upper: u64) -> u64 {
    if upper & (upper - 1) == 0 {
        return source.next_u64() & (upper - 1)
    }
    let threshold = (0 - upper) % upper;
    loop {
        let (high, low) = bits::mul64(source.next_u64(), upper);
        if low >= threshold {
            return high
        }
    }
}

impl[S: Source] Generator[S] {
    pub fn new(source: S) -> Generator[S] {
        Generator { source }
    }

    pub fn source(self: Generator[S]) -> S {
        self.source
    }

    pub fn next_u64(self: Generator[S]) -> u64 {
        self.source.next_u64()
    }

    pub fn bounded_u64(self: Generator[S], upper: u64) -> Result[u64, SampleError] {
        if upper == 0 {
            Result::Err(SampleError::ZeroBound)
        } else {
            Result::Ok(sample_bounded(self.source, upper))
        }
    }

    pub fn range_i64(self: Generator[S], start: i64, end: i64) -> Result[i64, SampleError] {
        if start >= end {
            return Result::Err(SampleError::InvalidRange)
        }
        let width = end.to_u64() - start.to_u64();
        Result::Ok((start.to_u64() + sample_bounded(self.source, width)).to_i64())
    }

    pub fn float64(self: Generator[S]) -> f64 {
        (self.source.next_u64() & 0x001fffffffffffff).to_f64() / 9007199254740992.0
    }

    pub fn float32(self: Generator[S]) -> f32 {
        ((self.source.next_u64() >> 32).to_u32() & 0x00ffffff).to_f32() / 16777216.0
    }

    pub fn exponential_f64(self: Generator[S]) -> f64 {
        -math::log(1.0 - self.float64())
    }

    pub fn normal_f64(self: Generator[S]) -> f64 {
        let radius = math::sqrt(-2.0 * math::log(1.0 - self.float64()));
        radius * math::cos(math::TAU * self.float64())
    }

    pub fn bytes(self: Generator[S], length: isize) -> Result[Vec[byte], SampleError] {
        if length < 0 {
            return Result::Err(SampleError::NegativeLength)
        }
        let output: Vec[byte] = Vec::with_capacity(length);
        while output.len() < length {
            let word = self.source.next_u64();
            for offset in 0..8 {
                if output.len() == length {
                    break
                }
                output.push((word >> (offset * 8)).to_u8())
            }
        }
        Result::Ok(output)
    }

    pub fn shuffled[T](self: Generator[S], values: Vec[T]) -> Vec[T] {
        let output: Vec[T] = Vec::with_capacity(values.len());
        for value in values {
            output.push(value)
        }
        let mut remaining = output.len();
        while remaining > 1 {
            let index = sample_bounded(self.source, remaining.to_u64()).to_isize();
            let last = remaining - 1;
            let value = output[index];
            output[index] = output[last];
            output[last] = value;
            remaining -= 1;
        }
        output
    }
}
