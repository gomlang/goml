package rand;

use module::math::bits;

pub struct Pcg {
    high: Ref[u64],
    low: Ref[u64],
}

fn pcg_next(source: Pcg) -> u64 {
    let high = source.high.get();
    let low = source.low.get();
    let (product_high, product_low) = bits::mul64(low, 4865540595714422341);
    let mixed_high = product_high + high * 4865540595714422341 + low * 2549297995355413924;
    let (next_low, carry) = bits::add64(product_low, 1442695040888963407, false);
    let (next_high, _) = bits::add64(mixed_high, 6364136223846793005, carry);
    source.high.set(next_high);
    source.low.set(next_low);
    let mut output = next_high ^ (next_high >> 32);
    output = output * 0xda942042e4dd58b5;
    output = output ^ (output >> 48);
    output * (next_low | 1)
}

impl Pcg {
    pub fn new(seed_high: u64, seed_low: u64) -> Pcg {
        Pcg { high: Ref::new(seed_high), low: Ref::new(seed_low) }
    }

    pub fn seed(self: Pcg, seed_high: u64, seed_low: u64) -> () {
        self.high.set(seed_high);
        self.low.set(seed_low)
    }

    pub fn next_u64(self: Pcg) -> u64 {
        pcg_next(self)
    }

    pub fn state(self: Pcg) -> (u64, u64) {
        (self.high.get(), self.low.get())
    }
}

impl Source for Pcg {
    fn next_u64(self: Pcg) -> u64 {
        pcg_next(self)
    }
}
