package rand;

pub struct ChaCha8 {
    key: Ref[Vec[u32]],
    buffer: Ref[Vec[u64]],
    position: Ref[isize],
    available: Ref[isize],
    counter: Ref[u32],
}

fn rotate_left32(value: u32, count: isize) -> u32 {
    (value << count) | (value >> (32 - count))
}

fn quarter_round(input: Vec[u32], a: isize, b: isize, c: isize, d: isize) -> Vec[u32] {
    input[a] = input[a] + input[b];
    input[d] = rotate_left32(input[d] ^ input[a], 16);
    input[c] = input[c] + input[d];
    input[b] = rotate_left32(input[b] ^ input[c], 12);
    input[a] = input[a] + input[b];
    input[d] = rotate_left32(input[d] ^ input[a], 8);
    input[c] = input[c] + input[d];
    input[b] = rotate_left32(input[b] ^ input[c], 7);
    input
}

fn chacha_block(key: Vec[u32], counter: u32) -> Vec[u32] {
    let mut state = Vec::from_array(
        [
            0x61707865,
            0x3320646e,
            0x79622d32,
            0x6b206574,
            key[0],
            key[1],
            key[2],
            key[3],
            key[4],
            key[5],
            key[6],
            key[7],
            counter,
            0,
            0,
            0,
        ],
    );
    for _ in 0..4 {
        state = quarter_round(state, 0, 4, 8, 12);
        state = quarter_round(state, 1, 5, 9, 13);
        state = quarter_round(state, 2, 6, 10, 14);
        state = quarter_round(state, 3, 7, 11, 15);
        state = quarter_round(state, 0, 5, 10, 15);
        state = quarter_round(state, 1, 6, 11, 12);
        state = quarter_round(state, 2, 7, 8, 13);
        state = quarter_round(state, 3, 4, 9, 14);
    }
    for index in 0..8 {
        state[index + 4] = state[index + 4] + key[index];
    }
    state
}

fn chacha_group(key: Vec[u32], counter: u32) -> Vec[u64] {
    let first = chacha_block(key, counter);
    let second = chacha_block(key, counter + 1);
    let third = chacha_block(key, counter + 2);
    let fourth = chacha_block(key, counter + 3);
    let output = Vec::with_capacity(32);
    for index in 0..16 {
        output.push(first[index].to_u64() | (second[index].to_u64() << 32));
        output.push(third[index].to_u64() | (fourth[index].to_u64() << 32))
    }
    output
}

fn key_from_seed(seed: [byte; 32]) -> Vec[u32] {
    let key = Vec::with_capacity(8);
    for index in 0..8 {
        let offset = index * 4;
        key.push(
            seed[offset].to_u32() | (seed[offset + 1].to_u32() << 8)
                | (seed[offset + 2].to_u32() << 16)
                | (seed[offset + 3].to_u32() << 24),
        )
    }
    key
}

fn key_from_tail(buffer: Vec[u64]) -> Vec[u32] {
    let key = Vec::with_capacity(8);
    for index in 28..32 {
        let word = buffer[index];
        key.push(word.to_u32());
        key.push((word >> 32).to_u32())
    }
    key
}

fn chacha_next(source: ChaCha8) -> u64 {
    if source.position.get() >= source.available.get() {
        let mut counter = source.counter.get() + 4;
        if counter == 16 {
            source.key.set(key_from_tail(source.buffer.get()));
            counter = 0;
        }
        source.buffer.set(chacha_group(source.key.get(), counter));
        source.counter.set(counter);
        source.position.set(0);
        source.available.set(
            if counter == 12 {
                28
            } else {
                32
            },
        );
    }
    let position = source.position.get();
    source.position.set(position + 1);
    source.buffer.get()[position]
}

impl ChaCha8 {
    pub fn new(seed: [byte; 32]) -> ChaCha8 {
        let key = key_from_seed(seed);
        let buffer = chacha_group(key, 0);
        ChaCha8 {
            key: Ref::new(key),
            buffer: Ref::new(buffer),
            position: Ref::new(0),
            available: Ref::new(32),
            counter: Ref::new(0),
        }
    }

    pub fn seed(self: ChaCha8, seed: [byte; 32]) -> () {
        let key = key_from_seed(seed);
        self.key.set(key);
        self.buffer.set(chacha_group(key, 0));
        self.position.set(0);
        self.available.set(32);
        self.counter.set(0)
    }

    pub fn next_u64(self: ChaCha8) -> u64 {
        chacha_next(self)
    }
}

impl Source for ChaCha8 {
    fn next_u64(self: ChaCha8) -> u64 {
        chacha_next(self)
    }
}
