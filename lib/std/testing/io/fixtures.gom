package io;

use module::bytes;
use module::io as stream;

fn fixture_error(message: string) -> stream::Error {
    stream::Error::new(
        stream::ErrorKind::InvalidInput,
        "create I/O fixture",
        Option::None,
        Option::None,
        message,
    )
}

pub struct FragmentReader {
    data: bytes::Bytes,
    position_value: Ref[isize],
    calls_value: Ref[isize],
    max_chunk: isize,
    failure_at: isize,
    failure: Option[stream::Error],
}

impl FragmentReader {
    pub fn new(data: bytes::Bytes, max_chunk: isize) -> Result[FragmentReader, stream::Error] {
        FragmentReader::create(data, max_chunk, -1, Option::None)
    }

    pub fn with_error(data: bytes::Bytes, max_chunk: isize, fail_after: isize, error: stream::Error) -> Result[
        FragmentReader,
        stream::Error,
    ] {
        FragmentReader::create(data, max_chunk, fail_after, Option::Some(error))
    }

    fn create(data: bytes::Bytes, max_chunk: isize, fail_after: isize, error: Option[stream::Error]) -> Result[
        FragmentReader,
        stream::Error,
    ] {
        if max_chunk <= 0 {
            return Result::Err(fixture_error("maximum read chunk must be positive"))
        }
        if error.is_some() && (fail_after < 0 || fail_after > data.len()) {
            return Result::Err(fixture_error("read failure offset is outside input"))
        }
        Result::Ok(
            FragmentReader {
                data: data.copy(),
                position_value: Ref::new(0),
                calls_value: Ref::new(0),
                max_chunk,
                failure_at: fail_after,
                failure: error,
            },
        )
    }

    pub fn position(self: FragmentReader) -> isize {
        self.position_value.get()
    }

    pub fn calls(self: FragmentReader) -> isize {
        self.calls_value.get()
    }
}

impl stream::Read for FragmentReader {
    fn read(self: FragmentReader, output: MutSlice[byte]) -> Result[isize, stream::Error] {
        self.calls_value.set(self.calls_value.get() + 1);
        if output.len() == 0 {
            return Result::Ok(0)
        }
        match self.failure {
            Some(error) => {
                if self.position() == self.failure_at {
                    return Result::Err(error)
                }
            },
            None => {},
        }
        let mut count = self.data.len() - self.position();
        if count > output.len() {
            count = output.len();
        }
        if count > self.max_chunk {
            count = self.max_chunk;
        }
        if self.failure.is_some() && count > self.failure_at - self.position() {
            count = self.failure_at - self.position();
        }
        for index in 0..count {
            output[index] = self.data.get(self.position() + index);
        }
        self.position_value.set(self.position() + count);
        Result::Ok(count)
    }
}

pub struct FragmentWriter {
    data: bytes::Bytes,
    calls_value: Ref[isize],
    max_chunk: isize,
    failure_at: isize,
    failure: Option[stream::Error],
}

impl FragmentWriter {
    pub fn new(max_chunk: isize) -> Result[FragmentWriter, stream::Error] {
        FragmentWriter::create(max_chunk, -1, Option::None)
    }

    pub fn with_error(max_chunk: isize, fail_after: isize, error: stream::Error) -> Result[
        FragmentWriter,
        stream::Error,
    ] {
        FragmentWriter::create(max_chunk, fail_after, Option::Some(error))
    }

    fn create(max_chunk: isize, fail_after: isize, error: Option[stream::Error]) -> Result[
        FragmentWriter,
        stream::Error,
    ] {
        if max_chunk <= 0 {
            return Result::Err(fixture_error("maximum write chunk must be positive"))
        }
        if error.is_some() && fail_after < 0 {
            return Result::Err(fixture_error("write failure offset must be non-negative"))
        }
        Result::Ok(
            FragmentWriter {
                data: bytes::Bytes::new(),
                calls_value: Ref::new(0),
                max_chunk,
                failure_at: fail_after,
                failure: error,
            },
        )
    }

    pub fn bytes(self: FragmentWriter) -> bytes::Bytes {
        self.data.copy()
    }

    pub fn calls(self: FragmentWriter) -> isize {
        self.calls_value.get()
    }
}

impl stream::Write for FragmentWriter {
    fn write(self: FragmentWriter, input: Slice[byte]) -> Result[isize, stream::Error] {
        self.calls_value.set(self.calls_value.get() + 1);
        if input.len() == 0 {
            return Result::Ok(0)
        }
        match self.failure {
            Some(error) => {
                if self.data.len() == self.failure_at {
                    return Result::Err(error)
                }
            },
            None => {},
        }
        let mut count = input.len();
        if count > self.max_chunk {
            count = self.max_chunk;
        }
        if self.failure.is_some() && count > self.failure_at - self.data.len() {
            count = self.failure_at - self.data.len();
        }
        self.data.extend_from_slice(input.sub(0, count));
        Result::Ok(count)
    }
}
