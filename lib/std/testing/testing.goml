package testing;

use module::env;
use module::internal::host;
use module::num;

pub fn seed() -> isize {
    match env::var_structured("GOML_TEST_SEED") {
        Ok(value) => num::parse_int_structured(value).unwrap_or(0),
        Err(_) => 0,
    }
}

pub fn fail(message: string) -> () {
    host::test_fail(message)
}

pub fn assert(condition: bool) -> () {
    if condition {} else {
        fail("assertion failed")
    }
}

pub fn assert_eq[T: PartialEq + Debug](actual: T, expected: T) -> () {
    if PartialEq::eq(actual, expected) {} else {
        fail(
            "assertion failed: values are not equal\n  actual: " + Debug::debug(actual)
                + "\nexpected: "
                + Debug::debug(expected),
        )
    }
}

pub fn assert_ne[T: PartialEq + Debug](actual: T, expected: T) -> () {
    if PartialEq::eq(actual, expected) {
        fail("assertion failed: values are equal\nvalue: " + Debug::debug(actual))
    }
}

pub fn assert_some[T](value: Option[T]) -> () {
    if value.is_some() {} else {
        fail("assertion failed: expected Some, found None")
    }
}

pub fn assert_none[T](value: Option[T]) -> () {
    if value.is_none() {} else {
        fail("assertion failed: expected None, found Some")
    }
}

pub fn assert_ok[T, E](value: Result[T, E]) -> () {
    if value.is_ok() {} else {
        fail("assertion failed: expected Ok, found Err")
    }
}

pub fn assert_err[T, E](value: Result[T, E]) -> () {
    if value.is_err() {} else {
        fail("assertion failed: expected Err, found Ok")
    }
}

pub fn expect_some[T](value: Option[T], message: string) -> T {
    match value {
        Some(value) => value,
        None => {
            fail(message);
            loop {}
        },
    }
}

pub fn expect_ok[T, E](value: Result[T, E], message: string) -> T {
    match value {
        Ok(value) => value,
        Err(_) => {
            fail(message);
            loop {}
        },
    }
}

pub fn expect_err[T, E](value: Result[T, E], message: string) -> E {
    match value {
        Err(error) => error,
        Ok(_) => {
            fail(message);
            loop {}
        },
    }
}
