package fs;

use module::fs as filesystem;
use module::io;

fn memory_resolve_charge(remaining: Ref[isize], amount: isize, operation: string, name: string) -> Result[
    (),
    filesystem::Error,
] {
    if amount < 0 || remaining.get() < amount {
        return Err(
            memory_error(
                InvalidData,
                operation,
                Some(name),
                "memory filesystem resolution work limit exceeded",
            ),
        )
    }
    remaining.set(remaining.get() - amount);
    Ok(())
}

fn memory_pending_push(pending: Vec[string], path: string) -> () {
    let parts: Vec[string] = Vec::new();
    for part in path.split("/") {
        parts.push(part);
    }
    let mut index = parts.len();
    while index > 0 {
        index -= 1;
        pending.push(parts[index]);
    }
}

fn resolve_memory(source: MemoryFS, name: string, follow_final: bool, operation: string) -> Result[
    isize,
    filesystem::Error,
] {
    if !filesystem::valid_path(name) {
        return Err(memory_error(InvalidInput, operation, Some(name), "invalid filesystem path"))
    }
    let remaining = Ref::new(source.limits.max_resolve_work);
    memory_resolve_charge(remaining, name.byte_len(), operation, name)?;
    memory_resolve_charge(remaining, 1, operation, name)?;
    let pending: Vec[string] = Vec::new();
    memory_pending_push(pending, name);
    let mut current = source.root;
    let mut hops = 0;
    while let Some(component) = pending.pop() {
        memory_resolve_charge(remaining, 1, operation, name)?;
        if component == "" || component == "." {
            continue
        }
        if component == ".." {
            if current == source.root {
                return Err(
                    memory_error(
                        InvalidInput,
                        operation,
                        Some(name),
                        "link target escapes memory filesystem root",
                    ),
                )
            }
            current = source.nodes[current].parent;
            continue
        }
        memory_resolve_charge(remaining, 1, operation, name)?;
        let parent_path = source.nodes[current].path;
        let path = if parent_path == "." {
            component
        } else {
            parent_path + "/" + component
        };
        let next = match source.index[path] {
            Some(index) => index,
            None => return Err(
                memory_error(NotFound, operation, Some(name), "memory filesystem entry not found"),
            ),
        };
        let node = source.nodes[next];
        if let Link(target) = node.content {
            if follow_final || !pending.is_empty() {
                if hops >= source.limits.max_link_hops {
                    return Err(
                        memory_error(
                            InvalidData,
                            operation,
                            Some(name),
                            "memory filesystem link hop limit exceeded",
                        ),
                    )
                }
                hops += 1;
                if target == "" {
                    return Err(
                        memory_error(
                            NotFound,
                            operation,
                            Some(name),
                            "empty memory filesystem link target",
                        ),
                    )
                }
                if target.starts_with("/") {
                    return Err(
                        memory_error(
                            InvalidInput,
                            operation,
                            Some(name),
                            "absolute memory filesystem link target",
                        ),
                    )
                }
                memory_resolve_charge(remaining, target.byte_len(), operation, name)?;
                memory_pending_push(pending, target);
                continue
            }
        }
        if pending.is_empty() {
            return Ok(next)
        }
        match node.content {
            Directory => {
                current = next;
            },
            _ => return Err(
                memory_error(
                    InvalidInput,
                    operation,
                    Some(name),
                    "memory filesystem path component is not a directory",
                ),
            ),
        }
    }
    Ok(current)
}

impl filesystem::LinkFileSystem for MemoryFS {
    fn read_link(self: MemoryFS, name: string) -> Result[string, filesystem::Error] {
        let index = resolve_memory(self, name, false, "read link")?;
        match self.nodes[index].content {
            Link(target) => Ok(target),
            _ => Err(
                memory_error(
                    InvalidInput,
                    "read link",
                    Some(name),
                    "memory filesystem entry is not a symbolic link",
                ),
            ),
        }
    }

    fn symlink_metadata(self: MemoryFS, name: string) -> Result[
        filesystem::Metadata,
        filesystem::Error,
    ] {
        let index = resolve_memory(self, name, false, "symlink metadata")?;
        Ok(self.nodes[index].metadata)
    }
}
