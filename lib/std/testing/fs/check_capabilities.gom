package fs;

use module::fs as filesystem;
use module::io;

pub fn check_seek[F: filesystem::FileSystem](source: F, expected: ExpectedTree, limits: CheckLimits) -> Result[
    CheckReport,
    filesystem::Error,
] where F::Handle: filesystem::ReadDirFile + io::Seek {
    let (state, expected) = check_prepare(expected, limits)?;
    check_run(
        state,
        source,
        expected,
        |value: F, path: string, metadata: filesystem::Metadata| {
            check_file(state, value, path, metadata);
            check_seek_file(state, value, path, metadata);
        },
        |_, _, _| (),
        |_, _, _, _| (),
    );
    Result::Ok(check_report(state))
}

pub fn check_read_at[F: filesystem::FileSystem](
    source: F,
    expected: ExpectedTree,
    limits: CheckLimits,
) -> Result[CheckReport, filesystem::Error] where F::Handle: filesystem::ReadDirFile + io::ReadAt {
    let (state, expected) = check_prepare(expected, limits)?;
    check_run(
        state,
        source,
        expected,
        |value: F, path: string, metadata: filesystem::Metadata| {
            check_file(state, value, path, metadata);
            check_read_at_file(state, value, path, metadata);
        },
        |_, _, _| (),
        |_, _, _, _| (),
    );
    Result::Ok(check_report(state))
}

pub fn check_links[F: filesystem::LinkFileSystem](
    source: F,
    expected: ExpectedTree,
    limits: CheckLimits,
) -> Result[CheckReport, filesystem::Error] where F::Handle: filesystem::ReadDirFile {
    let (state, expected) = check_prepare(expected, limits)?;
    check_invalid_link_paths(state, source);
    check_run(
        state,
        source,
        expected,
        |value: F, path: string, metadata: filesystem::Metadata| check_file(
            state,
            value,
            path,
            metadata,
        ),
        |value: F, path: string, metadata: Option[filesystem::Metadata]| check_link(
            state,
            value,
            path,
            metadata,
        ),
        |_, _, _, _| (),
    );
    Result::Ok(check_report(state))
}

pub fn check_helpers[F: filesystem::FileSystem](
    source: F,
    expected: ExpectedTree,
    limits: CheckLimits,
) -> Result[CheckReport, filesystem::Error] where F::Handle: filesystem::ReadDirFile {
    let (state, expected) = check_prepare(expected, limits)?;
    check_run(
        state,
        source,
        expected,
        |value: F, path: string, metadata: filesystem::Metadata| {
            let issue_count = state.issues.len();
            check_file(state, value, path, metadata);
            if !check_stopped(state) && state.issues.len() == issue_count {
                check_helper_file(state, value, path, metadata);
            }
        },
        |_, _, _| (),
        |value: F, path: string, metadata: filesystem::Metadata, entries: Vec[CheckedEntry]| {
            check_helper_directory(state, value, path, metadata, entries);
        },
    );
    Result::Ok(check_report(state))
}
