package fs;

use module::fs as filesystem;
use filesystem::LinkFileSystem;

fn check_link[F: filesystem::LinkFileSystem](
    state: CheckState,
    source: F,
    path: string,
    expected: Option[filesystem::Metadata],
) -> () {
    let first_target = check_call(state, path, "read link", || source.read_link(path));
    let first_metadata = check_call(
        state,
        path,
        "symlink metadata",
        || source.symlink_metadata(path),
    );
    let second_target = check_call(state, path, "read link", || source.read_link(path));
    let second_metadata = check_call(
        state,
        path,
        "symlink metadata",
        || source.symlink_metadata(path),
    );
    if let Some(first) = first_target {
        if let Some(second) = second_target {
            if first != second {
                check_inconsistent(
                    state,
                    path,
                    "read link",
                    "raw symbolic link target changed between calls",
                );
            }
        }
    }
    if let Some(first) = first_metadata {
        if first.file_type() != filesystem::FileType::Symlink {
            check_inconsistent(
                state,
                path,
                "symlink metadata",
                "enumerated symbolic link has a non-link metadata type",
            );
        }
        if let Some(expected) = expected {
            if !check_metadata_equal(expected, first) {
                check_inconsistent(
                    state,
                    path,
                    "entry/symlink metadata",
                    "entry metadata differs from non-following link metadata",
                );
            }
        }
        if let Some(second) = second_metadata {
            if !check_metadata_equal(first, second) {
                check_inconsistent(
                    state,
                    path,
                    "symlink metadata",
                    "non-following symbolic link metadata changed between calls",
                );
            }
        }
    }
    if let Some(second) = second_metadata {
        if first_metadata.is_none() {
            if second.file_type() != filesystem::FileType::Symlink {
                check_inconsistent(
                    state,
                    path,
                    "symlink metadata",
                    "enumerated symbolic link has a non-link metadata type",
                );
            }
            if let Some(expected) = expected {
                if !check_metadata_equal(expected, second) {
                    check_inconsistent(
                        state,
                        path,
                        "entry/symlink metadata",
                        "entry metadata differs from non-following link metadata",
                    );
                }
            }
        }
    }
}

fn check_invalid_link_paths[F: filesystem::LinkFileSystem](state: CheckState, source: F) -> () {
    for path in["", "/", "/a", "a/", "a//b", "./a", "..", "a/../b"] {
        if check_stopped(state) {
            return
        }
        if let Some(result) = check_call(
            state,
            path,
            "read link invalid path",
            || Result::Ok(source.read_link(path)),
        ) {
            if result.is_ok() {
                check_violation(
                    state,
                    path,
                    "read link invalid path",
                    "provider accepted an invalid logical link path",
                );
            }
        }
        if check_stopped(state) {
            return
        }
        if let Some(result) = check_call(
            state,
            path,
            "symlink metadata invalid path",
            || Result::Ok(source.symlink_metadata(path)),
        ) {
            if result.is_ok() {
                check_violation(
                    state,
                    path,
                    "symlink metadata invalid path",
                    "provider accepted an invalid logical metadata path",
                );
            }
        }
    }
}
