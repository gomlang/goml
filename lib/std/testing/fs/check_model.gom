package fs;

use module::fs as filesystem;
use module::io;
use module::panic;

pub enum ExpectedTree {
    Contains(Vec[string]),
    Empty,
}

pub struct CheckLimits {
    pub max_nodes: isize,
    pub max_depth: isize,
    pub max_directory_entries: isize,
    pub max_file_bytes: isize,
    pub max_total_read_bytes: isize,
    pub max_provider_calls: isize,
    pub max_issues: isize,
    pub max_path_bytes: isize,
}

pub enum CheckBudget {
    Nodes,
    Depth,
    DirectoryEntries,
    FileBytes,
    TotalReadBytes,
    ProviderCalls,
    PathBytes,
}

pub enum CheckStop {
    Budget(string, CheckBudget),
    IssueLimit,
    ProviderPanic,
}

pub enum CheckIssueKind {
    ContractViolation(string),
    ProviderError(filesystem::Error),
    InconsistentSnapshot(string),
    ProviderPanic(panic::Panic),
}

pub struct CheckIssue {
    pub path: string,
    pub operation: string,
    pub kind: CheckIssueKind,
}

struct CheckCounters {
    nodes: isize,
    read_bytes: isize,
    provider_calls: isize,
    cleanup_calls: isize,
    path_bytes: isize,
}

struct CheckState {
    limits: CheckLimits,
    counters: Ref[CheckCounters],
    issues: Vec[CheckIssue],
    incomplete: Ref[bool],
    stop: Ref[Option[CheckStop]],
}

struct CheckedEntry {
    name: string,
    file_type: filesystem::FileType,
    metadata: Option[filesystem::Metadata],
}

pub struct CheckReport {
    issues_value: Vec[CheckIssue],
    complete_value: bool,
    stop_value: Option[CheckStop],
    counters: CheckCounters,
}

impl CheckReport {
    pub fn issues(self: CheckReport) -> Slice[CheckIssue] {
        self.issues_value.as_slice()
    }

    pub fn complete(self: CheckReport) -> bool {
        self.complete_value
    }

    pub fn passed(self: CheckReport) -> bool {
        self.complete_value && self.issues_value.is_empty()
    }

    pub fn stop_reason(self: CheckReport) -> Option[CheckStop] {
        self.stop_value
    }

    pub fn discovered_nodes(self: CheckReport) -> isize {
        self.counters.nodes
    }

    pub fn read_bytes(self: CheckReport) -> isize {
        self.counters.read_bytes
    }

    pub fn provider_calls(self: CheckReport) -> isize {
        self.counters.provider_calls
    }

    pub fn cleanup_calls(self: CheckReport) -> isize {
        self.counters.cleanup_calls
    }

    pub fn path_bytes(self: CheckReport) -> isize {
        self.counters.path_bytes
    }
}

fn check_metadata_equal(left: filesystem::Metadata, right: filesystem::Metadata) -> bool {
    left.mode() == right.mode() && left.len() == right.len()
        && left.modified_unix_nanoseconds() == right.modified_unix_nanoseconds()
}

fn check_initial_state(limits: CheckLimits, expected: ExpectedTree) -> Result[
    CheckState,
    filesystem::Error,
] {
    if limits.max_nodes < 0 || limits.max_depth < 0 || limits.max_directory_entries < 0
        || limits.max_file_bytes < 0
        || limits.max_total_read_bytes < 0
        || limits.max_provider_calls < 0
        || limits.max_issues < 0
        || limits.max_path_bytes < 0 {
        return Result::Err(
            memory_error(
                io::ErrorKind::InvalidInput,
                "check filesystem",
                Option::None,
                "limits must be non-negative",
            ),
        )
    }
    if let ExpectedTree::Contains(paths) = expected {
        for path in paths {
            if !filesystem::valid_path(path) {
                return Result::Err(
                    memory_error(
                        io::ErrorKind::InvalidInput,
                        "check filesystem",
                        Option::Some(path),
                        "invalid expected path",
                    ),
                )
            }
        }
    }
    Result::Ok(
        CheckState {
            limits,
            counters: Ref::new(
                CheckCounters {
                    nodes: 0,
                    read_bytes: 0,
                    provider_calls: 0,
                    cleanup_calls: 0,
                    path_bytes: 0,
                },
            ),
            issues: Vec::new(),
            incomplete: Ref::new(false),
            stop: Ref::new(Option::None),
        },
    )
}

fn check_report(state: CheckState) -> CheckReport {
    let issues = Vec::with_capacity(state.issues.len());
    for issue in state.issues {
        issues.push(issue);
    }
    CheckReport {
        issues_value: issues,
        complete_value: !state.incomplete.get() && state.stop.get().is_none(),
        stop_value: state.stop.get(),
        counters: state.counters.get(),
    }
}
