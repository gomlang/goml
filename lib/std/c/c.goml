package c;

use module::bytes::{Bytes};
use module::ffi;
use module::utf8;

pub enum Error {
    InteriorNul,
    Native(string),
}

impl Debug for Error {
    fn debug(self: Error) -> string {
        self.to_string()
    }
}

impl PartialEq for Error {
    fn eq(self: Error, other: Error) -> bool {
        match (self, other) {
            (InteriorNul, InteriorNul) => true,
            (Native(left), Native(right)) => left == right,
            _ => false,
        }
    }
}

impl Eq for Error {}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        match self {
            InteriorNul => "C string contains an interior NUL byte",
            Native(message) => message,
        }
    }
}

pub struct CString {
    raw: ffi::String,
}

#[comptime]
pub fn literal(value: string) -> string {
    for index in 0..value.byte_len() {
        if value.byte_get(index) == 0 {
            compile_error("C string literal contains an interior NUL byte")
        }
    }
    value
}

impl CString {
    pub fn from_raw(raw: ffi::String) -> Result[CString, Error] {
        for byte in ffi::string_bytes(raw).to_vec() {
            if byte == 0 {
                return Result::Err(Error::InteriorNul)
            }
        }
        Result::Ok(CString { raw })
    }

    pub fn new(value: string) -> Result[CString, Error] {
        CString::from_raw(ffi::string_from_text(value))
    }

    pub fn from_bytes(value: Bytes) -> Result[CString, Error] {
        CString::from_raw(ffi::string_from_bytes(value))
    }

    pub fn as_raw(self: CString) -> ffi::String {
        self.raw
    }

    pub fn bytes(self: CString) -> Bytes {
        ffi::string_bytes(self.raw)
    }

    pub fn text(self: CString) -> Result[string, utf8::Utf8Error] {
        ffi::string_text(self.raw)
    }
}

pub fn check_error(error: ffi::Error) -> Result[(), Error] {
    match ffi::NonNilError::from_error(error) {
        Some(error) => Result::Err(
            Error::Native(error.message().unwrap_or("C boundary error contains invalid UTF-8")),
        ),
        None => Result::Ok(()),
    }
}
