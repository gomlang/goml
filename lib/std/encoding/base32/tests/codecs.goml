package tests;

use std::bytes;
use std::encoding::base32;
use std::rand;
use std::testing;

#[test]
fn check_base32() -> () {
    let plain = Vec::from_array(["", "f", "fo", "foo", "foob", "fooba", "foobar"]);
    let standard = Vec::from_array(
        ["", "MY======", "MZXQ====", "MZXW6===", "MZXW6YQ=", "MZXW6YTB", "MZXW6YTBOI======"],
    );
    let hexadecimal = Vec::from_array(
        ["", "CO======", "CPNG====", "CPNMU===", "CPNMUOG=", "CPNMUOJ1", "CPNMUOJ1E8======"],
    );
    for index in 0..plain.len() {
        let input = bytes::Bytes::from_string(plain[index]);
        assert_equal(base32::encode(input), standard[index]);
        assert_equal(base32::encode_with(input, base32::Variant::Hex), hexadecimal[index]);
    }
    let standard_reference = reference_base32("ABCDEFGHIJKLMNOPQRSTUVWXYZ234567");
    let hex_reference = reference_base32("0123456789ABCDEFGHIJKLMNOPQRSTUV");
    for length in 0..257 {
        let input = bytes::Bytes::from_vec(rand::bytes(length.to_u64(), length));
        for (padded, raw, reference) in Vec::from_array(
            [
                (base32::Variant::Standard, base32::Variant::StandardNoPadding, standard_reference),
                (base32::Variant::Hex, base32::Variant::HexNoPadding, hex_reference),
            ],
        ) {
            let encoded = base32::encode_with(input, padded);
            assert_equal(encoded, reference_base32_encode(reference, input.as_slice()));
            let decoded = testing::expect_ok(base32::decode_with(encoded, padded), "base32 decode");
            assert_equal(decoded.to_vec(), input.to_vec());
            let unpadded = base32::encode_with(input, raw);
            assert_equal(unpadded, encoded.replace("=", ""));
            assert_equal(
                testing::expect_ok(base32::decode_with(unpadded, raw), "raw base32").to_vec(),
                input.to_vec(),
            );
        }
    }
    for invalid in Vec::from_array(
        [
            "A",
            "AAA",
            "AAAAAA",
            "MY",
            "========",
            "M=Y=====",
            "my======",
            "MY=====!",
            "MY======\n",
            "MY======MY======",
            "MZ======",
            "MZXR====",
            "MZXW7===",
            "MZXW6YR=",
            "你=======",
        ],
    ) {
        testing::assert_err(base32::decode(invalid))
    }
    testing::assert_err(base32::decode_with("MY======", base32::Variant::StandardNoPadding));
    for invalid in Vec::from_array(["A", "AAA", "AAAAAA", "MZ", "MZXR", "MZXW7", "MZXW6YR"]) {
        testing::assert_err(base32::decode_with(invalid, base32::Variant::StandardNoPadding))
    }
    let error = testing::expect_err(base32::decode("M!======"), "invalid digit");
    assert_equal(error.index(), 1);
    assert_equal(error.kind(), base32::DecodeErrorKind::InvalidByte);
    assert_equal(
        testing::expect_err(base32::decode("MZ======"), "padding bits").kind(),
        base32::DecodeErrorKind::NonCanonical,
    );
}
