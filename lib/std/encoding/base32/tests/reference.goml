package tests;

use std::bytes;

struct ReferenceBase32 {
    alphabet: string,
    padding: i32,
}

fn reference_base32(alphabet: string) -> ReferenceBase32 {
    ReferenceBase32 { alphabet, padding: 61 }
}

fn reference_base32_padding(value: ReferenceBase32, padding: i32) -> ReferenceBase32 {
    ReferenceBase32 { alphabet: value.alphabet, padding }
}

fn reference_base32_encode(value: ReferenceBase32, input: Slice[byte]) -> string {
    let output = bytes::Bytes::new();
    for first in 0..(input.len() * 8 + 4) / 5 {
        let mut digit = 0;
        for offset in 0..5 {
            let bit = first * 5 + offset;
            digit *= 2;
            if bit < input.len() * 8 {
                digit += ((input[bit / 8] >> (7 - bit % 8)) & 1).to_isize();
            }
        }
        output.push(value.alphabet.byte_get(digit));
    }
    if value.padding >= 0 {
        while output.len() % 8 != 0 {
            output.push(value.padding.to_u8());
        }
    }
    string_from_utf8(output.to_vec()).1
}
