package hex;

use module::bytes;
use module::text;

pub enum DecodeErrorKind {
    OddLength,
    InvalidByte,
}

pub struct DecodeError {
    index_value: isize,
    kind_value: DecodeErrorKind,
}

impl DecodeError {
    pub fn new(index: isize, kind: DecodeErrorKind) -> DecodeError {
        DecodeError { index_value: index, kind_value: kind }
    }

    pub fn index(self: DecodeError) -> isize {
        self.index_value
    }

    pub fn kind(self: DecodeError) -> DecodeErrorKind {
        self.kind_value
    }
}

impl ToString for DecodeError {
    fn to_string(self: DecodeError) -> string {
        match self.kind_value {
            DecodeErrorKind::OddLength => f"odd hexadecimal length at byte {self.index_value}",
            DecodeErrorKind::InvalidByte => f"invalid hexadecimal digit at byte {self.index_value}",
        }
    }
}

impl Debug for DecodeError {
    fn debug(self: DecodeError) -> string {
        self.to_string()
    }
}

impl PartialEq for DecodeErrorKind {
    fn eq(self: DecodeErrorKind, other: DecodeErrorKind) -> bool {
        match (self, other) {
            (DecodeErrorKind::OddLength, DecodeErrorKind::OddLength) => true,
            (DecodeErrorKind::InvalidByte, DecodeErrorKind::InvalidByte) => true,
            _ => false,
        }
    }
}

impl Eq for DecodeErrorKind {}

impl PartialEq for DecodeError {
    fn eq(self: DecodeError, other: DecodeError) -> bool {
        self.index_value == other.index_value && self.kind_value == other.kind_value
    }
}

fn encode_digit(value: byte, upper: bool) -> char {
    if value < 10 {
        char_from_u32((b'0' + value).to_u32()).unwrap_or('0')
    } else if upper {
        char_from_u32((b'A' + value - 10).to_u32()).unwrap_or('A')
    } else {
        char_from_u32((b'a' + value - 10).to_u32()).unwrap_or('a')
    }
}

fn encode_with_case(input: bytes::Bytes, upper: bool) -> string {
    let output = text::StringBuilder::with_capacity(input.len() * 2);
    for value in input.as_slice() {
        output.write_char(encode_digit(value >> 4, upper));
        output.write_char(encode_digit(value & 0x0f, upper))
    }
    output.finish()
}

fn decode_digit(value: byte, index: isize) -> Result[byte, DecodeError] {
    if value >= b'0' && value <= b'9' {
        Result::Ok(value - b'0')
    } else if value >= b'a' && value <= b'f' {
        Result::Ok(value - b'a' + 10)
    } else if value >= b'A' && value <= b'F' {
        Result::Ok(value - b'A' + 10)
    } else {
        Result::Err(DecodeError::new(index, DecodeErrorKind::InvalidByte))
    }
}

pub fn encode(input: bytes::Bytes) -> string {
    encode_with_case(input, false)
}

pub fn encode_upper(input: bytes::Bytes) -> string {
    encode_with_case(input, true)
}

pub fn decode(input: string) -> Result[bytes::Bytes, DecodeError] {
    if input.byte_len() % 2 != 0 {
        return Result::Err(DecodeError::new(input.byte_len() - 1, DecodeErrorKind::OddLength))
    }
    let output = bytes::Bytes::with_capacity(input.byte_len() / 2);
    let mut index = 0;
    while index < input.byte_len() {
        let high = decode_digit(input.byte_get(index), index)?;
        let low = decode_digit(input.byte_get(index + 1), index + 1)?;
        output.push((high << 4) | low);
        index += 2;
    }
    Result::Ok(output)
}
