package tests;

use std::bytes;

fn reference_encode_pem(
    label: string,
    keys: Slice[string],
    values: Slice[string],
    data: Slice[byte],
) -> string {
    let mut output = "-----BEGIN " + label + "-----\n";
    let order: Vec[isize] = Vec::new();
    for index in 0..keys.len() {
        order.push(index);
    }
    for index in 1..order.len() {
        let mut cursor = index;
        while cursor > 0
            && (keys[order[cursor]] == "Proc-Type"
                || (keys[order[cursor - 1]] != "Proc-Type"
                    && keys[order[cursor]] < keys[order[cursor - 1]])) {
            let temp = order[cursor];
            order[cursor] = order[cursor - 1];
            order[cursor - 1] = temp;
            cursor -= 1;
        }
    }
    for index in order {
        output += keys[index] + ": " + values[index] + "\n";
    }
    if keys.len() != 0 {
        output += "\n";
    }
    let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    let body = bytes::Bytes::new();
    for digit in 0..(data.len() * 8 + 5) / 6 {
        let mut value = 0;
        for offset in 0..6 {
            let bit = digit * 6 + offset;
            value *= 2;
            if bit < data.len() * 8 {
                value += ((data[bit / 8] >> (7 - bit % 8)) & 1).to_isize();
            }
        }
        body.push(alphabet.byte_get(value));
    }
    while body.len() % 4 != 0 {
        body.push(b'=');
    }
    let text = string_from_utf8(body.to_vec()).1;
    let mut first = 0;
    while first < text.byte_len() {
        let end = if first + 64 < text.byte_len() {
            first + 64
        } else {
            text.byte_len()
        };
        output += text.byte_slice(first, end) + "\n";
        first = end;
    }
    output + "-----END " + label + "-----\n"
}
