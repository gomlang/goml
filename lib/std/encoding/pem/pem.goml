package pem;

use std::bytes;
use std::text;
use std::collections;
use std::encoding::base64;

pub enum Error {
    InvalidLabel,
    InvalidHeader,
    DuplicateHeader(string),
    InvalidLimit,
    LimitExceeded,
    Malformed(isize),
    InvalidBase64(base64::DecodeError),
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        match self {
            Error::InvalidLabel => "invalid PEM label",
            Error::InvalidHeader => "invalid PEM header",
            Error::DuplicateHeader(key) => f"duplicate PEM header: {key}",
            Error::InvalidLimit => "negative PEM limit",
            Error::LimitExceeded => "PEM limit exceeded",
            Error::Malformed(offset) => f"malformed PEM block at byte {offset}",
            Error::InvalidBase64(error) => f"invalid PEM body: {error}",
        }
    }
}

impl Debug for Error {
    fn debug(self: Error) -> string {
        self.to_string()
    }
}

pub struct Block {
    label_value: string,
    headers_value: Vec[(string, string)],
    data_value: bytes::Bytes,
}

fn printable(value: string, allow_tab: bool) -> bool {
    for index in 0..value.byte_len() {
        let byte = value.byte_get(index);
        if byte < 32 || byte > 126 {
            if !(allow_tab && byte == 9) {
                return false
            }
        }
    }
    true
}

impl Block {
    pub fn new(label: string, headers: Vec[(string, string)], data: bytes::Bytes) -> Result[
        Block,
        Error,
    ] {
        if label.byte_len() == 0 || !printable(label, false) || label.starts_with(" ")
            || label.ends_with(" ") {
            return Result::Err(Error::InvalidLabel)
        }
        let seen: HashMap[string, bool] = HashMap::new();
        let normalized: Vec[(string, string)] = Vec::new();
        for (key, value) in headers {
            if key.byte_len() == 0 || !printable(key, false) || key.contains(":")
                || key.contains(" ")
                || !printable(value, true) {
                return Result::Err(Error::InvalidHeader)
            }
            if seen.contains(key) {
                return Result::Err(Error::DuplicateHeader(key))
            }
            seen.insert(key, true);
            normalized.push((key, text::trim_chars(value, " \t")));
        }
        Result::Ok(
            Block {
                label_value: label,
                headers_value: normalized,
                data_value: bytes::Bytes::from_vec(data.to_vec().copy()),
            },
        )
    }

    pub fn label(self: Block) -> string {
        self.label_value
    }

    pub fn headers(self: Block) -> Vec[(string, string)] {
        self.headers_value.copy()
    }

    pub fn data(self: Block) -> bytes::Bytes {
        bytes::Bytes::from_vec(self.data_value.to_vec().copy())
    }
}

fn add_size(current: isize, amount: isize, limit: isize) -> Result[isize, Error] {
    if amount > limit - current {
        Result::Err(Error::LimitExceeded)
    } else {
        Result::Ok(current + amount)
    }
}

pub fn encode(block: Block, max_bytes: isize) -> Result[string, Error] {
    if max_bytes < 0 {
        return Result::Err(Error::InvalidLimit)
    }
    let mut size = add_size(0, 32, max_bytes)?;
    size = add_size(size, block.label_value.byte_len(), max_bytes)?;
    size = add_size(size, block.label_value.byte_len(), max_bytes)?;
    for (key, value) in block.headers_value {
        size = add_size(size, key.byte_len(), max_bytes)?;
        size = add_size(size, value.byte_len(), max_bytes)?;
        size = add_size(size, 3, max_bytes)?;
    }
    if block.headers_value.len() > 0 {
        size = add_size(size, 1, max_bytes)?;
    }
    let length = block.data_value.len();
    let groups = length / 3
        + if length % 3 == 0 {
            0
        } else {
            1
        };
    if groups > (max_bytes - size) / 4 {
        return Result::Err(Error::LimitExceeded)
    }
    let encoded_length = groups * 4;
    size = add_size(size, encoded_length, max_bytes)?;
    let lines = encoded_length / 64
        + if encoded_length % 64 == 0 {
            0
        } else {
            1
        };
    size = add_size(size, lines, max_bytes)?;
    let output = text::StringBuilder::with_capacity(size);
    output.write_line(f"-----BEGIN {block.label_value}-----");
    let headers = block.headers_value.copy();
    collections::sort_by(
        headers,
        |left: (string, string), right: (string, string)| {
            let (a, _) = left;
            let (b, _) = right;
            if a == b {
                0
            } else if a == "Proc-Type" {
                -1
            } else if b == "Proc-Type" {
                1
            } else if a < b {
                -1
            } else {
                1
            }
        },
    );
    for (key, value) in headers {
        output.write_line(f"{key}: {value}");
    }
    if headers.len() > 0 {
        output.write_line("");
    }
    let encoded = base64::encode(block.data_value);
    let mut offset = 0;
    while offset < encoded_length {
        let end = if encoded_length - offset < 64 {
            encoded_length
        } else {
            offset + 64
        };
        output.write_line(encoded.byte_slice(offset, end));
        offset = end;
    }
    output.write_line(f"-----END {block.label_value}-----");
    Result::Ok(output.finish())
}

fn next_line(input: string, offset: isize) -> (string, isize) {
    let mut end = offset;
    while end < input.byte_len() && input.byte_get(end) != 10 {
        end += 1;
    }
    let next = if end < input.byte_len() {
        end + 1
    } else {
        end
    };
    if end > offset && input.byte_get(end - 1) == 13 {
        end -= 1;
    }
    let line = text::trim_end_chars(input.byte_slice(offset, end), " \t");
    (line, next)
}

pub fn decode(input: string, max_input: isize, max_data: isize, max_headers: isize) -> Result[
    Option[(Block, isize)],
    Error,
] {
    if max_input < 0 || max_data < 0 || max_headers < 0 {
        return Result::Err(Error::InvalidLimit)
    }
    if input.byte_len() > max_input {
        return Result::Err(Error::LimitExceeded)
    }
    let mut offset = 0;
    while offset < input.byte_len() {
        let (line, next) = next_line(input, offset);
        if line.starts_with("-----BEGIN ") {
            if !line.ends_with("-----") || line.byte_len() < 17 {
                return Result::Err(Error::Malformed(offset))
            }
            let label = line.byte_slice(11, line.byte_len() - 5);
            let headers: Vec[(string, string)] = Vec::new();
            let body = text::StringBuilder::new();
            let mut reading_headers = true;
            offset = next;
            while offset < input.byte_len() {
                let (part, after) = next_line(input, offset);
                if part.starts_with("-----END ") {
                    if part != f"-----END {label}-----" {
                        return Result::Err(Error::Malformed(offset))
                    }
                    let encoded = body.finish();
                    let mut padding = 0;
                    if encoded.ends_with("=") {
                        padding += 1;
                    }
                    if encoded.ends_with("==") {
                        padding += 1;
                    }
                    let decoded_length = encoded.byte_len() / 4 * 3 - padding;
                    if decoded_length > max_data {
                        return Result::Err(Error::LimitExceeded)
                    }
                    let data = base64::decode(encoded).map_err(
                        |error: base64::DecodeError| Error::InvalidBase64(error),
                    )?;
                    if data.len() > max_data {
                        return Result::Err(Error::LimitExceeded)
                    }
                    return Result::Ok(Option::Some((Block::new(label, headers, data)?, after)))
                }
                if reading_headers {
                    match text::cut(part, ":") {
                        Some((key, value)) => {
                            if headers.len() >= max_headers {
                                return Result::Err(Error::LimitExceeded)
                            }
                            headers.push(
                                (text::trim_chars(key, " \t"), text::trim_chars(value, " \t")),
                            );
                            offset = after;
                            continue
                        },
                        None => (),
                    }
                    reading_headers = false;
                }
                for index in 0..part.byte_len() {
                    let byte = part.byte_get(index);
                    if byte != 32 && byte != 9 {
                        body.values.push(byte);
                    }
                }
                offset = after;
            }
            return Result::Err(Error::Malformed(offset))
        }
        offset = next;
    }
    Result::Ok(Option::None)
}
