package base64;

use module::bytes;
use module::text;

const STANDARD_ALPHABET: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

const URL_SAFE_ALPHABET: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";

pub enum Variant {
    Standard,
    StandardNoPadding,
    UrlSafe,
    UrlSafeNoPadding,
}

pub enum DecodeErrorKind {
    InvalidLength,
    InvalidByte,
    InvalidPadding,
    NonCanonical,
}

pub struct DecodeError {
    index_value: isize,
    kind_value: DecodeErrorKind,
}

impl DecodeError {
    pub fn new(index: isize, kind: DecodeErrorKind) -> DecodeError {
        DecodeError { index_value: index, kind_value: kind }
    }

    pub fn index(self: DecodeError) -> isize {
        self.index_value
    }

    pub fn kind(self: DecodeError) -> DecodeErrorKind {
        self.kind_value
    }
}

impl ToString for DecodeError {
    fn to_string(self: DecodeError) -> string {
        match self.kind_value {
            InvalidLength => f"invalid base64 length at byte {self.index_value}",
            InvalidByte => f"invalid base64 digit at byte {self.index_value}",
            InvalidPadding => f"invalid base64 padding at byte {self.index_value}",
            NonCanonical => f"non-canonical base64 trailing bits at byte {self.index_value}",
        }
    }
}

impl Debug for DecodeError {
    fn debug(self: DecodeError) -> string {
        self.to_string()
    }
}

impl PartialEq for DecodeErrorKind {
    fn eq(self: DecodeErrorKind, other: DecodeErrorKind) -> bool {
        match (self, other) {
            (InvalidLength, InvalidLength) => true,
            (InvalidByte, InvalidByte) => true,
            (InvalidPadding, InvalidPadding) => true,
            (NonCanonical, NonCanonical) => true,
            _ => false,
        }
    }
}

impl Eq for DecodeErrorKind {}

impl PartialEq for DecodeError {
    fn eq(self: DecodeError, other: DecodeError) -> bool {
        self.index_value == other.index_value && self.kind_value == other.kind_value
    }
}

fn alphabet(variant: Variant) -> string {
    match variant {
        Standard | StandardNoPadding => STANDARD_ALPHABET,
        UrlSafe | UrlSafeNoPadding => URL_SAFE_ALPHABET,
    }
}

fn padded(variant: Variant) -> bool {
    match variant {
        Standard | UrlSafe => true,
        StandardNoPadding | UrlSafeNoPadding => false,
    }
}

fn digit(value: byte, variant: Variant) -> char {
    alphabet(variant).get(value.to_isize())
}

fn decode_digit(value: byte, index: isize, variant: Variant) -> Result[byte, DecodeError] {
    if value >= b'A' && value <= b'Z' {
        Ok(value - b'A')
    } else if value >= b'a' && value <= b'z' {
        Ok(value - b'a' + 26)
    } else if value >= b'0' && value <= b'9' {
        Ok(value - b'0' + 52)
    } else {
        match variant {
            Standard | StandardNoPadding => if value == b'+' {
                Ok(62)
            } else if value == b'/' {
                Ok(63)
            } else {
                Err(DecodeError::new(index, DecodeErrorKind::InvalidByte))
            },
            UrlSafe | UrlSafeNoPadding => if value == b'-' {
                Ok(62)
            } else if value == b'_' {
                Ok(63)
            } else {
                Err(DecodeError::new(index, DecodeErrorKind::InvalidByte))
            },
        }
    }
}

pub fn encode(input: bytes::Bytes) -> string {
    encode_with(input, Variant::Standard)
}

pub fn encode_with(input: bytes::Bytes, variant: Variant) -> string {
    let input_len = input.len();
    let full_len = (input_len / 3) * 4;
    let remainder = input_len % 3;
    let output_len = if remainder == 0 {
        full_len
    } else if padded(variant) {
        full_len + 4
    } else {
        full_len + remainder + 1
    };
    let output = text::StringBuilder::with_capacity(output_len);
    let mut index = 0;
    while index + 3 <= input_len {
        let first = input.get(index);
        let second = input.get(index + 1);
        let third = input.get(index + 2);
        output.write_char(digit(first >> 2, variant));
        output.write_char(digit(((first & 0x03) << 4) | (second >> 4), variant));
        output.write_char(digit(((second & 0x0f) << 2) | (third >> 6), variant));
        output.write_char(digit(third & 0x3f, variant));
        index += 3;
    }
    if remainder == 1 {
        let first = input.get(index);
        output.write_char(digit(first >> 2, variant));
        output.write_char(digit((first & 0x03) << 4, variant));
        if padded(variant) {
            output.write_string("==")
        }
    } else if remainder == 2 {
        let first = input.get(index);
        let second = input.get(index + 1);
        output.write_char(digit(first >> 2, variant));
        output.write_char(digit(((first & 0x03) << 4) | (second >> 4), variant));
        output.write_char(digit((second & 0x0f) << 2, variant));
        if padded(variant) {
            output.write_char('=')
        }
    }
    output.finish()
}

fn decoded_input_length(input: string, variant: Variant) -> Result[isize, DecodeError] {
    let length = input.byte_len();
    let data_length = if padded(variant) {
        if length % 4 != 0 {
            return Err(DecodeError::new(length, DecodeErrorKind::InvalidLength))
        } else if length == 0 {
            return Ok(0)
        }
        let padding = if input.byte_get(length - 1) == b'=' {
            if length >= 2 && input.byte_get(length - 2) == b'=' {
                2
            } else {
                1
            }
        } else {
            0
        };
        length - padding
    } else if length % 4 == 1 {
        return Err(DecodeError::new(length, DecodeErrorKind::InvalidLength))
    } else {
        length
    };
    for index in 0..data_length {
        if input.byte_get(index) == b'=' {
            return Err(DecodeError::new(index, DecodeErrorKind::InvalidPadding))
        }
    }
    Ok(data_length)
}

pub fn decode(input: string) -> Result[bytes::Bytes, DecodeError] {
    decode_with(input, Variant::Standard)
}

pub fn decode_with(input: string, variant: Variant) -> Result[bytes::Bytes, DecodeError] {
    let data_length = decoded_input_length(input, variant)?;
    let output = bytes::Bytes::with_capacity(data_length * 3 / 4);
    let mut index = 0;
    while index + 4 <= data_length {
        let first = decode_digit(input.byte_get(index), index, variant)?;
        let second = decode_digit(input.byte_get(index + 1), index + 1, variant)?;
        let third = decode_digit(input.byte_get(index + 2), index + 2, variant)?;
        let fourth = decode_digit(input.byte_get(index + 3), index + 3, variant)?;
        output.push((first << 2) | (second >> 4));
        output.push((second << 4) | (third >> 2));
        output.push((third << 6) | fourth);
        index += 4;
    }
    let remainder = data_length - index;
    if remainder == 2 {
        let first = decode_digit(input.byte_get(index), index, variant)?;
        let second = decode_digit(input.byte_get(index + 1), index + 1, variant)?;
        if second & 0x0f != 0 {
            return Err(DecodeError::new(index + 1, DecodeErrorKind::NonCanonical))
        }
        output.push((first << 2) | (second >> 4))
    } else if remainder == 3 {
        let first = decode_digit(input.byte_get(index), index, variant)?;
        let second = decode_digit(input.byte_get(index + 1), index + 1, variant)?;
        let third = decode_digit(input.byte_get(index + 2), index + 2, variant)?;
        if third & 0x03 != 0 {
            return Err(DecodeError::new(index + 2, DecodeErrorKind::NonCanonical))
        }
        output.push((first << 2) | (second >> 4));
        output.push((second << 4) | (third >> 2))
    }
    Ok(output)
}
