package tests;

use std::bytes;
use std::encoding::base64;
use std::testing;

fn assert_decode_error(
    input: string,
    variant: base64::Variant,
    index: isize,
    kind: base64::DecodeErrorKind,
) -> () {
    let error = testing::expect_err(base64::decode_with(input, variant), "invalid base64");
    testing::assert_eq(error.index(), index);
    testing::assert(error.kind() == kind);
}

#[test]
fn native_base64_padding_errors() -> () {
    for variant in[base64::Variant::Standard, base64::Variant::UrlSafe] {
        for (input, index, kind) in[
            ("=", 1, base64::DecodeErrorKind::InvalidLength),
            ("Zg=", 3, base64::DecodeErrorKind::InvalidLength),
            ("!===", 1, base64::DecodeErrorKind::InvalidPadding),
            ("===A", 0, base64::DecodeErrorKind::InvalidPadding),
            ("AA=A", 2, base64::DecodeErrorKind::InvalidPadding),
            ("!!!!", 0, base64::DecodeErrorKind::InvalidByte),
            ("Zh==", 1, base64::DecodeErrorKind::NonCanonical),
            ("Zm9=", 2, base64::DecodeErrorKind::NonCanonical),
        ] {
            assert_decode_error(input, variant, index, kind);
        }
    }
    for variant in[base64::Variant::StandardNoPadding, base64::Variant::UrlSafeNoPadding] {
        for (input, index, kind) in[
            ("=AAAA", 5, base64::DecodeErrorKind::InvalidLength),
            ("!A=", 2, base64::DecodeErrorKind::InvalidPadding),
            ("Zg==", 2, base64::DecodeErrorKind::InvalidPadding),
            ("!A", 0, base64::DecodeErrorKind::InvalidByte),
            ("Zh", 1, base64::DecodeErrorKind::NonCanonical),
            ("Zm9", 2, base64::DecodeErrorKind::NonCanonical),
        ] {
            assert_decode_error(input, variant, index, kind);
        }
    }
}

#[test]
fn native_base64_vectors() -> () {
    for (plain, padded, unpadded) in[
        ("", "", ""),
        ("f", "Zg==", "Zg"),
        ("fo", "Zm8=", "Zm8"),
        ("foo", "Zm9v", "Zm9v"),
        ("foob", "Zm9vYg==", "Zm9vYg"),
        ("fooba", "Zm9vYmE=", "Zm9vYmE"),
        ("foobar", "Zm9vYmFy", "Zm9vYmFy"),
    ] {
        for (variant, encoded) in[
            (base64::Variant::Standard, padded),
            (base64::Variant::UrlSafe, padded),
            (base64::Variant::StandardNoPadding, unpadded),
            (base64::Variant::UrlSafeNoPadding, unpadded),
        ] {
            let input = bytes::Bytes::from_string(plain);
            testing::assert_eq(base64::encode_with(input, variant), encoded);
            let decoded = testing::expect_ok(base64::decode_with(encoded, variant), "base64 vector");
            testing::assert(decoded.as_slice().to_vec() == plain.to_bytes());
        }
    }
}
