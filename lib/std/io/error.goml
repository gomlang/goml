package io;

pub enum ErrorKind {
    NotFound,
    PermissionDenied,
    AlreadyExists,
    InvalidInput,
    InvalidData,
    TimedOut,
    Interrupted,
    UnexpectedEof,
    WriteZero,
    BrokenPipe,
    WouldBlock,
    Unsupported,
    Other,
}

impl ToString for ErrorKind {
    fn to_string(self: ErrorKind) -> string {
        match self {
            ErrorKind::NotFound => "NotFound",
            ErrorKind::PermissionDenied => "PermissionDenied",
            ErrorKind::AlreadyExists => "AlreadyExists",
            ErrorKind::InvalidInput => "InvalidInput",
            ErrorKind::InvalidData => "InvalidData",
            ErrorKind::TimedOut => "TimedOut",
            ErrorKind::Interrupted => "Interrupted",
            ErrorKind::UnexpectedEof => "UnexpectedEof",
            ErrorKind::WriteZero => "WriteZero",
            ErrorKind::BrokenPipe => "BrokenPipe",
            ErrorKind::WouldBlock => "WouldBlock",
            ErrorKind::Unsupported => "Unsupported",
            ErrorKind::Other => "Other",
        }
    }
}

impl Debug for ErrorKind {
    fn debug(self: ErrorKind) -> string {
        self.to_string()
    }
}

impl PartialEq for ErrorKind {
    fn eq(self: ErrorKind, other: ErrorKind) -> bool {
        kind_code(self) == kind_code(other)
    }
}

impl Eq for ErrorKind {}

pub fn kind_from_code(code: isize) -> ErrorKind {
    match code {
        1 => ErrorKind::NotFound,
        2 => ErrorKind::PermissionDenied,
        3 => ErrorKind::AlreadyExists,
        4 => ErrorKind::InvalidInput,
        5 => ErrorKind::InvalidData,
        6 => ErrorKind::TimedOut,
        7 => ErrorKind::Interrupted,
        8 => ErrorKind::UnexpectedEof,
        9 => ErrorKind::WriteZero,
        10 => ErrorKind::BrokenPipe,
        11 => ErrorKind::WouldBlock,
        12 => ErrorKind::Unsupported,
        _ => ErrorKind::Other,
    }
}

pub fn kind_code(kind: ErrorKind) -> isize {
    match kind {
        ErrorKind::NotFound => 1,
        ErrorKind::PermissionDenied => 2,
        ErrorKind::AlreadyExists => 3,
        ErrorKind::InvalidInput => 4,
        ErrorKind::InvalidData => 5,
        ErrorKind::TimedOut => 6,
        ErrorKind::Interrupted => 7,
        ErrorKind::UnexpectedEof => 8,
        ErrorKind::WriteZero => 9,
        ErrorKind::BrokenPipe => 10,
        ErrorKind::WouldBlock => 11,
        ErrorKind::Unsupported => 12,
        ErrorKind::Other => 0,
    }
}

pub struct ErrorDetails {
    kind_value: ErrorKind,
    operation_value: string,
    context_value: Option[string],
    raw_os_code_value: Option[isize],
    message_value: string,
}

impl ErrorDetails {
    pub fn new(
        kind: ErrorKind,
        operation: string,
        context: Option[string],
        raw_os_code: Option[isize],
        message: string,
    ) -> ErrorDetails {
        ErrorDetails {
            kind_value: kind,
            operation_value: operation,
            context_value: context,
            raw_os_code_value: raw_os_code,
            message_value: message,
        }
    }

    pub fn kind(self: ErrorDetails) -> ErrorKind {
        self.kind_value
    }

    pub fn operation(self: ErrorDetails) -> string {
        self.operation_value
    }

    pub fn context(self: ErrorDetails) -> Option[string] {
        self.context_value
    }

    pub fn raw_os_code(self: ErrorDetails) -> Option[isize] {
        self.raw_os_code_value
    }

    pub fn message(self: ErrorDetails) -> string {
        self.message_value
    }
}

impl ToString for ErrorDetails {
    fn to_string(self: ErrorDetails) -> string {
        match self.context_value {
            Some(context) => self.operation_value + " " + context + ": " + self.message_value,
            None => self.operation_value + ": " + self.message_value,
        }
    }
}

impl Debug for ErrorDetails {
    fn debug(self: ErrorDetails) -> string {
        self.to_string()
    }
}

impl PartialEq for ErrorDetails {
    fn eq(self: ErrorDetails, other: ErrorDetails) -> bool {
        self.kind_value == other.kind_value && self.operation_value == other.operation_value
            && self.context_value == other.context_value
            && self.raw_os_code_value == other.raw_os_code_value
            && self.message_value == other.message_value
    }
}

pub struct Error {
    details: ErrorDetails,
}

impl Error {
    pub fn new(
        kind: ErrorKind,
        operation: string,
        context: Option[string],
        raw_os_code: Option[isize],
        message: string,
    ) -> Error {
        Error { details: ErrorDetails::new(kind, operation, context, raw_os_code, message) }
    }

    pub fn kind(self: Error) -> ErrorKind {
        self.details.kind()
    }

    pub fn operation(self: Error) -> string {
        self.details.operation()
    }

    pub fn context(self: Error) -> Option[string] {
        self.details.context()
    }

    pub fn raw_os_code(self: Error) -> Option[isize] {
        self.details.raw_os_code()
    }

    pub fn message(self: Error) -> string {
        self.details.message()
    }
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        self.details.to_string()
    }
}

impl Debug for Error {
    fn debug(self: Error) -> string {
        self.to_string()
    }
}

impl PartialEq for Error {
    fn eq(self: Error, other: Error) -> bool {
        self.details == other.details
    }
}
