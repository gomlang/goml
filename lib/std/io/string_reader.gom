package io;

pub enum SeekFrom {
    Start(isize),
    Current(isize),
    End(isize),
}

pub struct StringReader {
    value: Ref[string],
    offset: Ref[isize],
    previous_char: Ref[Option[isize]],
}

impl StringReader {
    pub fn new(value: string) -> StringReader {
        StringReader {
            value: Ref::new(value),
            offset: Ref::new(0),
            previous_char: Ref::new(Option::None),
        }
    }

    pub fn reset(self: StringReader, value: string) -> () {
        self.value.set(value);
        self.offset.set(0);
        self.previous_char.set(Option::None);
    }

    pub fn size(self: StringReader) -> isize {
        self.value.get().byte_len()
    }

    pub fn position(self: StringReader) -> isize {
        self.offset.get()
    }

    pub fn len(self: StringReader) -> isize {
        if self.position() >= self.size() {
            0
        } else {
            self.size() - self.position()
        }
    }

    pub fn is_empty(self: StringReader) -> bool {
        self.len() == 0
    }

    pub fn seek(self: StringReader, from: SeekFrom) -> Result[isize, Error] {
        self.seek_position(from)
    }

    fn seek_position(self: StringReader, from: SeekFrom) -> Result[isize, Error] {
        self.previous_char.set(Option::None);
        let (base, delta) = match from {
            Start(offset) => (0, offset),
            Current(offset) => (self.position(), offset),
            End(offset) => (self.size(), offset),
        };
        let position = checked_seek_position(base, delta, "seek string")?;
        self.offset.set(position);
        Result::Ok(position)
    }

    pub fn read_byte(self: StringReader) -> Option[byte] {
        self.previous_char.set(Option::None);
        if self.is_empty() {
            return Option::None
        }
        let position = self.position();
        self.offset.set(position + 1);
        Option::Some(self.value.get().byte_get(position))
    }

    pub fn unread_byte(self: StringReader) -> Result[(), Error] {
        self.previous_char.set(Option::None);
        if self.position() == 0 {
            return Result::Err(
                stream_error(
                    ErrorKind::InvalidInput,
                    "unread string byte",
                    "already at the beginning",
                ),
            )
        }
        self.offset.set(self.position() - 1);
        Result::Ok(())
    }

    pub fn read_char(self: StringReader) -> Option[(char, isize)] {
        self.previous_char.set(Option::None);
        if self.is_empty() {
            return Option::None
        }
        let position = self.position();
        let decoded = self.value.get().decode_at(position).unwrap_or(('�', 1));
        self.previous_char.set(Option::Some(position));
        self.offset.set(position + decoded.1);
        Option::Some(decoded)
    }

    pub fn unread_char(self: StringReader) -> Result[(), Error] {
        match self.previous_char.get() {
            Some(position) => {
                self.offset.set(position);
                self.previous_char.set(Option::None);
                Result::Ok(())
            },
            None => Result::Err(
                stream_error(
                    ErrorKind::InvalidInput,
                    "unread string character",
                    "previous operation was not a successful character read",
                ),
            ),
        }
    }

    pub fn write_to[W: Write](self: StringReader, writer: W) -> Result[isize, TransferError] {
        self.previous_char.set(Option::None);
        let value = self.value.get();
        let start = self.position();
        if start >= value.byte_len() {
            return Result::Ok(0)
        }
        let buffer = byte_buffer(4096);
        let mut transferred = 0;
        while transferred < value.byte_len() - start {
            let remaining = value.byte_len() - start - transferred;
            let length = if remaining < buffer.len() {
                remaining
            } else {
                buffer.len()
            };
            for index in 0..length {
                buffer.set(index, value.byte_get(start + transferred + index));
            }
            let mut offset = 0;
            while offset < length {
                let count = match writer.write(buffer.slice(offset, length)) {
                    Ok(count) => valid_count(count, length - offset, "write string reader").map_err(
                        |error| TransferError::new(transferred.to_usize(), error),
                    )?,
                    Err(error) => return Result::Err(
                        TransferError::new(transferred.to_usize(), error),
                    ),
                };
                if count == 0 {
                    return Result::Err(
                        positional_error(
                            ErrorKind::WriteZero,
                            "write string reader",
                            "writer made no progress",
                            transferred,
                        ),
                    )
                }
                offset += count;
                transferred += count;
                self.offset.set(start + transferred);
            }
        }
        Result::Ok(transferred)
    }
}

impl Read for StringReader {
    fn read(self: StringReader, buffer: MutSlice[byte]) -> Result[isize, Error] {
        self.previous_char.set(Option::None);
        let available = self.len();
        let count = if available < buffer.len() {
            available
        } else {
            buffer.len()
        };
        let value = self.value.get();
        let start = self.position();
        for index in 0..count {
            buffer[index] = value.byte_get(start + index);
        }
        self.offset.set(start + count);
        Result::Ok(count)
    }
}

impl ReadAt for StringReader {
    fn read_at(self: StringReader, buffer: MutSlice[byte], offset: isize) -> Result[
        isize,
        TransferError,
    ] {
        check_at_range(offset, buffer.len(), "read string at")?;
        let value = self.value.get();
        let available = if offset >= value.byte_len() {
            0
        } else {
            value.byte_len() - offset
        };
        let count = if available < buffer.len() {
            available
        } else {
            buffer.len()
        };
        for index in 0..count {
            buffer[index] = value.byte_get(offset + index);
        }
        if count == buffer.len() {
            Result::Ok(count)
        } else {
            Result::Err(
                positional_error(
                    ErrorKind::UnexpectedEof,
                    "read string at",
                    "buffer extends beyond string",
                    count,
                ),
            )
        }
    }
}
