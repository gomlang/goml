package io;

pub struct CopyError {
    read_value: u64,
    written_value: u64,
    cause: Error,
}

impl CopyError {
    fn new(read_count: u64, written_count: u64, error: Error) -> CopyError {
        CopyError { read_value: read_count, written_value: written_count, cause: error }
    }

    pub fn read_count(self: CopyError) -> u64 {
        self.read_value
    }

    pub fn written_count(self: CopyError) -> u64 {
        self.written_value
    }

    pub fn error(self: CopyError) -> Error {
        self.cause
    }
}

impl ToString for CopyError {
    fn to_string(self: CopyError) -> string {
        f"after reading {self.read_value} bytes and writing {self.written_value} bytes: {self.cause}"
    }
}

impl Debug for CopyError {
    fn debug(self: CopyError) -> string {
        self.to_string()
    }
}

pub fn copy_progress[R: Read, W: Write](reader: R, writer: W) -> Result[u64, CopyError] {
    let buffer = byte_buffer(8192);
    copy_buffer_progress(reader, writer, buffer.as_mut_slice())
}

pub fn copy_buffer_progress[R: Read, W: Write](reader: R, writer: W, buffer: MutSlice[byte]) -> Result[
    u64,
    CopyError,
] {
    if buffer.len() == 0 {
        return Result::Err(
            CopyError::new(
                0,
                0,
                stream_error(ErrorKind::InvalidInput, "copy progress", "buffer must not be empty"),
            ),
        )
    }
    let mut read_count: u64 = 0;
    let mut written_count: u64 = 0;
    loop {
        let remaining = 18446744073709551615 - read_count;
        if remaining == 0 {
            return Result::Err(
                CopyError::new(
                    read_count,
                    written_count,
                    stream_error(ErrorKind::InvalidData, "copy progress", "byte count exhausted"),
                ),
            )
        }
        let length = if remaining < buffer.len().to_u64() {
            remaining.to_isize()
        } else {
            buffer.len()
        };
        let count = match reader.read(buffer.sub(0, length)) {
            Ok(count) => valid_count(count, length, "copy progress read").map_err(
                |error| CopyError::new(read_count, written_count, error),
            )?,
            Err(error) => return Result::Err(CopyError::new(read_count, written_count, error)),
        };
        if count == 0 {
            return Result::Ok(written_count)
        }
        read_count += count.to_u64();
        let mut offset = 0;
        while offset < count {
            let written = match writer.write(buffer.as_slice().sub(offset, count)) {
                Ok(written) => valid_count(written, count - offset, "copy progress write").map_err(
                    |error| CopyError::new(read_count, written_count, error),
                )?,
                Err(error) => return Result::Err(CopyError::new(read_count, written_count, error)),
            };
            if written == 0 {
                return Result::Err(
                    CopyError::new(
                        read_count,
                        written_count,
                        stream_error(
                            ErrorKind::WriteZero,
                            "copy progress",
                            "writer made no progress",
                        ),
                    ),
                )
            }
            offset += written;
            written_count += written.to_u64();
        }
    }
}
