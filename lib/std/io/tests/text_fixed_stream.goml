package tests;

use std::bytes;
use std::bytes::endian;
use std::bytes::endian::stream;
use std::io;
use io::Read;
use std::testing;

struct TextFixedReader {
    cursor: io::Cursor,
    chunk: isize,
    interrupted: Ref[bool],
}

impl Read for TextFixedReader {
    fn read(self: TextFixedReader, buffer: MutSlice[byte]) -> Result[isize, io::Error] {
        if self.interrupted.get() {
            self.interrupted.set(false);
            return Result::Err(
                io::Error::new(
                    io::ErrorKind::Interrupted,
                    "fixed reader",
                    Option::None,
                    Option::None,
                    "retry",
                ),
            )
        }
        let length = if buffer.len() < self.chunk {
            buffer.len()
        } else {
            self.chunk
        };
        self.cursor.read(buffer.sub(0, length))
    }
}
