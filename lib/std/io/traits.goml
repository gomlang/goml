package io;

use module::bytes;
use module::utf8;
use utf8::BytesUtf8;

fn stream_error(kind: ErrorKind, operation: string, message: string) -> Error {
    Error::new(kind, operation, Option::None, Option::None, message)
}

fn valid_count(count: isize, length: isize, operation: string) -> Result[isize, Error] {
    if count < 0 || count > length {
        Result::Err(
            stream_error(ErrorKind::InvalidData, operation, "invalid byte count returned by stream"),
        )
    } else {
        Result::Ok(count)
    }
}

pub trait Read {
    fn read(self: Self, buffer: MutSlice[byte]) -> Result[isize, Error];
    fn read_exact(self: Self, buffer: MutSlice[byte]) -> Result[(), Error] {
        let mut offset = 0;
        while offset < buffer.len() {
            let count = match self.read(buffer.sub(offset, buffer.len())) {
                Ok(count) => valid_count(count, buffer.len() - offset, "read exact")?,
                Err(error) => return Result::Err(error),
            };
            if count == 0 {
                return Result::Err(
                    stream_error(
                        ErrorKind::UnexpectedEof,
                        "read exact",
                        "stream ended before the buffer was filled",
                    ),
                )
            }
            offset += count;
        }
        Result::Ok(())
    }
    fn read_to_end(self: Self, limit: isize) -> Result[bytes::Bytes, Error] {
        if limit < 0 {
            return Result::Err(
                stream_error(ErrorKind::InvalidInput, "read to end", "limit must be non-negative"),
            )
        }
        let result = bytes::Bytes::new();
        let buffer = byte_buffer(8192);
        loop {
            let remaining = limit - result.len();
            let capacity = if remaining < buffer.len() {
                remaining + 1
            } else {
                buffer.len()
            };
            let count = match self.read(buffer.slice_mut(0, capacity)) {
                Ok(count) => valid_count(count, capacity, "read to end")?,
                Err(error) => return Result::Err(error),
            };
            if count == 0 {
                return Result::Ok(result)
            }
            if count > remaining {
                return Result::Err(
                    stream_error(ErrorKind::InvalidData, "read to end", "stream exceeds byte limit"),
                )
            }
            result.extend_from_slice(buffer.slice(0, count))
        }
    }
    fn read_to_string(self: Self, limit: isize) -> Result[string, Error] {
        self.read_to_end(limit)?.to_string_utf8().map_err(
            |error| stream_error(ErrorKind::InvalidData, "read to string", error.to_string()),
        )
    }
}

pub trait Write {
    fn write(self: Self, buffer: Slice[byte]) -> Result[isize, Error];
    fn flush(self: Self) -> Result[(), Error] {
        Result::Ok(())
    }
    fn write_all(self: Self, buffer: Slice[byte]) -> Result[(), Error] {
        let mut offset = 0;
        while offset < buffer.len() {
            let count = match self.write(buffer.sub(offset, buffer.len())) {
                Ok(count) => valid_count(count, buffer.len() - offset, "write all")?,
                Err(error) => return Result::Err(error),
            };
            if count == 0 {
                return Result::Err(
                    stream_error(ErrorKind::WriteZero, "write all", "stream made no progress"),
                )
            }
            offset += count;
        }
        Result::Ok(())
    }
}

pub trait Close {
    fn close(self: Self) -> Result[(), Error];
}

pub struct TransferError {
    transferred_value: usize,
    error_value: Error,
}

impl TransferError {
    pub fn new(transferred: usize, error: Error) -> TransferError {
        TransferError { transferred_value: transferred, error_value: error }
    }

    pub fn transferred(self: TransferError) -> usize {
        self.transferred_value
    }

    pub fn error(self: TransferError) -> Error {
        self.error_value
    }
}

impl ToString for TransferError {
    fn to_string(self: TransferError) -> string {
        f"after {self.transferred_value} bytes: {self.error_value}"
    }
}

impl Debug for TransferError {
    fn debug(self: TransferError) -> string {
        self.to_string()
    }
}

pub fn read_at_least[R: Read](reader: R, buffer: MutSlice[byte], minimum: isize) -> Result[
    isize,
    TransferError,
] {
    if minimum < 0 || minimum > buffer.len() {
        return Result::Err(
            TransferError::new(
                0,
                stream_error(
                    ErrorKind::InvalidInput,
                    "read at least",
                    "minimum exceeds buffer range",
                ),
            ),
        )
    }
    let mut total = 0;
    while total < minimum {
        let count = match reader.read(buffer.sub(total, buffer.len())) {
            Ok(count) => valid_count(count, buffer.len() - total, "read at least").map_err(
                |error| TransferError::new(total.to_usize(), error),
            )?,
            Err(error) => return Result::Err(TransferError::new(total.to_usize(), error)),
        };
        if count == 0 {
            return Result::Err(
                TransferError::new(
                    total.to_usize(),
                    stream_error(
                        ErrorKind::UnexpectedEof,
                        "read at least",
                        "stream ended before minimum",
                    ),
                ),
            )
        }
        total += count;
    }
    Result::Ok(total)
}

fn positional_error(kind: ErrorKind, operation: string, message: string, count: isize) -> TransferError {
    TransferError::new(count.to_usize(), stream_error(kind, operation, message))
}

fn check_at_range(offset: isize, length: isize, operation: string) -> Result[(), TransferError] {
    if offset < 0 || length > 9223372036854775807 - offset {
        Result::Err(
            positional_error(ErrorKind::InvalidInput, operation, "invalid positional range", 0),
        )
    } else {
        Result::Ok(())
    }
}

fn complete_transfer(
    result: Result[isize, TransferError],
    length: isize,
    operation: string,
    short_kind: ErrorKind,
) -> Result[(), TransferError] {
    match result {
        Result::Ok(count) => {
            if count < 0 || count > length {
                Result::Err(
                    positional_error(
                        ErrorKind::InvalidData,
                        operation,
                        "invalid byte count returned by stream",
                        0,
                    ),
                )
            } else if count != length {
                Result::Err(
                    positional_error(short_kind, operation, "incomplete positional transfer", count),
                )
            } else {
                Result::Ok(())
            }
        },
        Result::Err(error) => {
            if error.transferred() > length.to_usize() {
                Result::Err(
                    positional_error(
                        ErrorKind::InvalidData,
                        operation,
                        "invalid error progress returned by stream",
                        0,
                    ),
                )
            } else {
                Result::Err(error)
            }
        },
    }
}

pub trait ReadAt {
    fn read_at(self: Self, buffer: MutSlice[byte], offset: isize) -> Result[isize, TransferError];
    fn read_exact_at(self: Self, buffer: MutSlice[byte], offset: isize) -> Result[(), TransferError] {
        check_at_range(offset, buffer.len(), "read exact at")?;
        complete_transfer(
            self.read_at(buffer, offset),
            buffer.len(),
            "read exact at",
            ErrorKind::UnexpectedEof,
        )
    }
}

pub trait WriteAt {
    fn write_at(self: Self, buffer: Slice[byte], offset: isize) -> Result[isize, TransferError];
    fn write_all_at(self: Self, buffer: Slice[byte], offset: isize) -> Result[(), TransferError] {
        check_at_range(offset, buffer.len(), "write all at")?;
        complete_transfer(
            self.write_at(buffer, offset),
            buffer.len(),
            "write all at",
            ErrorKind::InvalidData,
        )
    }
}

pub trait BufRead: Read {
    fn fill_buf(self: Self) -> Result[Slice[byte], Error];
    fn consume(self: Self, amount: isize) -> Result[(), Error];
    fn discard(self: Self, amount: isize) -> Result[isize, TransferError] {
        if amount < 0 {
            return Result::Err(
                TransferError::new(
                    0,
                    stream_error(
                        ErrorKind::InvalidInput,
                        "discard buffer",
                        "amount must be non-negative",
                    ),
                ),
            )
        }
        let mut discarded = 0;
        while discarded < amount {
            let buffer = self.fill_buf().map_err(
                |error| TransferError::new(discarded.to_usize(), error),
            )?;
            if buffer.len() == 0 {
                return Result::Err(
                    TransferError::new(
                        discarded.to_usize(),
                        stream_error(
                            ErrorKind::UnexpectedEof,
                            "discard buffer",
                            "stream ended before requested amount",
                        ),
                    ),
                )
            }
            let remaining = amount - discarded;
            let count = if buffer.len() < remaining {
                buffer.len()
            } else {
                remaining
            };
            self.consume(count).map_err(|error| TransferError::new(discarded.to_usize(), error))?;
            discarded += count;
        }
        Result::Ok(discarded)
    }
    fn read_until(self: Self, delimiter: byte, limit: isize) -> Result[bytes::Bytes, Error] {
        if limit < 0 {
            return Result::Err(
                stream_error(ErrorKind::InvalidInput, "read until", "limit must be non-negative"),
            )
        }
        let result = bytes::Bytes::new();
        loop {
            let buffer = self.fill_buf()?;
            if buffer.len() == 0 {
                return Result::Ok(result)
            }
            let mut count = 0;
            let mut found = false;
            while count < buffer.len() && count < limit - result.len() {
                let value = buffer[count];
                count += 1;
                if value == delimiter {
                    found = true;
                    break
                }
            }
            result.extend_from_slice(buffer.sub(0, count));
            self.consume(count)?;
            if found {
                return Result::Ok(result)
            }
            if result.len() == limit {
                if self.fill_buf()?.len() == 0 {
                    return Result::Ok(result)
                }
                return Result::Err(
                    stream_error(
                        ErrorKind::InvalidData,
                        "read until",
                        "delimiter not found within byte limit",
                    ),
                )
            }
        }
    }
    fn read_line(self: Self, limit: isize) -> Result[Option[string], Error] {
        let bytes = self.read_until(b'\n', limit)?;
        if bytes.is_empty() {
            return Result::Ok(Option::None)
        }
        bytes.to_string_utf8().map(|line| Option::Some(line)).map_err(
            |error| stream_error(ErrorKind::InvalidData, "read line", error.to_string()),
        )
    }
}

fn byte_buffer(length: isize) -> bytes::Bytes {
    let buffer = bytes::Bytes::with_capacity(length);
    for _ in 0..length {
        buffer.push(0)
    }
    buffer
}

pub fn copy[R: Read, W: Write](reader: R, writer: W) -> Result[u64, Error] {
    let buffer = byte_buffer(8192);
    copy_buffer(reader, writer, buffer.as_mut_slice())
}

pub fn copy_buffer[R: Read, W: Write](reader: R, writer: W, buffer: MutSlice[byte]) -> Result[
    u64,
    Error,
] {
    if buffer.len() == 0 {
        return Result::Err(
            stream_error(ErrorKind::InvalidInput, "copy buffer", "buffer must not be empty"),
        )
    }
    let mut total: u64 = 0;
    loop {
        let count = match reader.read(buffer) {
            Ok(count) => valid_count(count, buffer.len(), "copy")?,
            Err(error) => return Result::Err(error),
        };
        if count == 0 {
            return Result::Ok(total)
        }
        writer.write_all(buffer.as_slice().sub(0, count))?;
        if total > 18446744073709551615 - count.to_u64() {
            return Result::Err(stream_error(ErrorKind::InvalidData, "copy", "byte count overflow"))
        }
        total += count.to_u64();
    }
}

pub fn copy_n[R: Read, W: Write](reader: R, writer: W, count: isize) -> Result[u64, Error] {
    let limited = Take::new(reader, count)?;
    if count == 0 {
        return Result::Ok(0)
    }
    let transferred = copy(limited, writer)?;
    if transferred != count.to_u64() {
        Result::Err(
            stream_error(ErrorKind::UnexpectedEof, "copy n", "input ended before requested count"),
        )
    } else {
        Result::Ok(transferred)
    }
}
