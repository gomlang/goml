package io;

pub trait Seek {
    fn seek(self: Self, from: SeekFrom) -> Result[isize, Error];
}

fn checked_seek_position(base: isize, delta: isize, operation: string) -> Result[isize, Error] {
    if delta < -base || delta > 9223372036854775807 - base {
        Result::Err(
            stream_error(ErrorKind::InvalidInput, operation, "invalid or overflowing position"),
        )
    } else {
        Result::Ok(base + delta)
    }
}

impl Seek for Cursor {
    fn seek(self: Cursor, from: SeekFrom) -> Result[isize, Error] {
        let (base, delta) = match from {
            Start(offset) => (0, offset),
            Current(offset) => (self.position(), offset),
            End(offset) => (self.data.len(), offset),
        };
        let position = checked_seek_position(base, delta, "seek cursor")?;
        self.set_position(position)?;
        Result::Ok(position)
    }
}

impl[R: ReadAt] Seek for SectionReader[R] {
    fn seek(self: SectionReader[R], from: SeekFrom) -> Result[isize, Error] {
        let (base, delta) = match from {
            Start(offset) => (0, offset),
            Current(offset) => (self.position(), offset),
            End(offset) => (self.length, offset),
        };
        let position = checked_seek_position(base, delta, "seek section")?;
        self.set_position(position)?;
        Result::Ok(position)
    }
}

impl[W: WriteAt] Seek for OffsetWriter[W] {
    fn seek(self: OffsetWriter[W], from: SeekFrom) -> Result[isize, Error] {
        let (base, delta) = match from {
            Start(offset) => (0, offset),
            Current(offset) => (self.position(), offset),
            End(_) => return Result::Err(
                stream_error(
                    ErrorKind::Unsupported,
                    "seek offset writer",
                    "end position is unavailable",
                ),
            ),
        };
        let position = checked_seek_position(base, delta, "seek offset writer")?;
        self.set_position(position)?;
        Result::Ok(position)
    }
}

impl Seek for StringReader {
    fn seek(self: StringReader, from: SeekFrom) -> Result[isize, Error] {
        self.seek_position(from)
    }
}
