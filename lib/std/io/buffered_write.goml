package io;

use module::utf8;

impl[W: Write] BufWriter[W] {
    fn accept_bytes(self: BufWriter[W], input: Slice[byte]) -> Result[isize, TransferError] {
        let mut accepted = 0;
        while accepted < input.len() {
            let count = self.write(input.sub(accepted, input.len())).map_err(
                |error| TransferError::new(accepted.to_usize(), error),
            )?;
            let count = valid_count(count, input.len() - accepted, "buffered write").map_err(
                |error| TransferError::new(accepted.to_usize(), error),
            )?;
            if count == 0 {
                return Result::Err(
                    TransferError::new(
                        accepted.to_usize(),
                        stream_error(
                            ErrorKind::WriteZero,
                            "buffered write",
                            "writer made no progress",
                        ),
                    ),
                )
            }
            accepted += count;
        }
        Result::Ok(accepted)
    }

    pub fn write_byte(self: BufWriter[W], value: byte) -> Result[(), Error] {
        let input = Vec::from_array([value]);
        self.accept_bytes(input.as_slice()).map(|_| ()).map_err(|error| error.error())
    }

    pub fn write_char(self: BufWriter[W], value: char) -> Result[isize, TransferError] {
        self.accept_bytes(utf8::encode_char(value).as_slice())
    }

    pub fn write_string(self: BufWriter[W], value: string) -> Result[isize, TransferError] {
        if value.byte_len() == 0 {
            return Result::Ok(0)
        }
        let capacity = if value.byte_len() < 4096 {
            value.byte_len()
        } else {
            4096
        };
        let buffer = byte_buffer(capacity);
        let mut accepted = 0;
        while accepted < value.byte_len() {
            let remaining = value.byte_len() - accepted;
            let count = if remaining < capacity {
                remaining
            } else {
                capacity
            };
            for index in 0..count {
                buffer.set(index, value.byte_get(accepted + index));
            }
            match self.accept_bytes(buffer.slice(0, count)) {
                Ok(count) => {
                    accepted += count;
                },
                Err(error) => return Result::Err(
                    TransferError::new(accepted.to_usize() + error.transferred(), error.error()),
                ),
            }
        }
        Result::Ok(accepted)
    }

    pub fn read_from[R: Read](self: BufWriter[W], reader: R) -> Result[u64, CopyError] {
        copy_progress(reader, self)
    }
}
