package io;

use module::resource;

pub struct NoopCloser[R] {
    reader: R,
}

impl[R: Read] NoopCloser[R] {
    pub fn new(reader: R) -> NoopCloser[R] {
        NoopCloser { reader }
    }
}

impl[R: Read] Read for NoopCloser[R] {
    fn read(self: NoopCloser[R], buffer: MutSlice[byte]) -> Result[isize, Error] {
        self.reader.read(buffer)
    }
}

impl[R: Read] Close for NoopCloser[R] {
    fn close(self: NoopCloser[R]) -> Result[(), Error] {
        Result::Ok(())
    }
}

pub fn with_resource[R: Close, T, E](value: R, action: (R) -> Result[T, E]) -> Result[
    T,
    resource::ScopeError[E, Error],
] {
    resource::with_cleanup(|| action(value), || value.close())
}
