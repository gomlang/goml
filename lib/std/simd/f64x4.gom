package simd;

pub struct f64x4 {
    lanes: [f64; 4],
}

impl f64x4 {
    pub fn from_array(values: [f64; 4]) -> f64x4 {
        f64x4 { lanes: values }
    }

    pub fn to_array(self: f64x4) -> [f64; 4] {
        self.lanes
    }

    pub fn splat(value: f64) -> f64x4 {
        f64x4::from_array(__goml_simd_f64x4_splat(value))
    }

    pub fn from_slice(values: Slice[f64], offset: isize) -> Option[f64x4] {
        if offset < 0 || offset > values.len() || values.len() - offset < 4 {
            Option::None
        } else {
            Option::Some(
                f64x4::from_array(
                    [values[offset + 0], values[offset + 1], values[offset + 2], values[offset + 3]],
                ),
            )
        }
    }

    pub fn copy_to_slice(self: f64x4, values: MutSlice[f64], offset: isize) -> bool {
        if offset < 0 || offset > values.len() || values.len() - offset < 4 {
            false
        } else {
            for index in 0..4 {
                values[offset + index] = self.lanes[index];
            }
            true
        }
    }

    pub fn add(self: f64x4, other: f64x4) -> f64x4 {
        f64x4::from_array(__goml_simd_f64x4_add(self.lanes, other.lanes))
    }

    pub fn sub(self: f64x4, other: f64x4) -> f64x4 {
        f64x4::from_array(__goml_simd_f64x4_sub(self.lanes, other.lanes))
    }

    pub fn mul(self: f64x4, other: f64x4) -> f64x4 {
        f64x4::from_array(__goml_simd_f64x4_mul(self.lanes, other.lanes))
    }

    pub fn min(self: f64x4, other: f64x4) -> f64x4 {
        f64x4::from_array(__goml_simd_f64x4_min(self.lanes, other.lanes))
    }

    pub fn max(self: f64x4, other: f64x4) -> f64x4 {
        f64x4::from_array(__goml_simd_f64x4_max(self.lanes, other.lanes))
    }

    pub fn div(self: f64x4, other: f64x4) -> f64x4 {
        f64x4::from_array(__goml_simd_f64x4_div(self.lanes, other.lanes))
    }

    pub fn neg(self: f64x4) -> f64x4 {
        f64x4::from_array(__goml_simd_f64x4_neg(self.lanes))
    }

    pub fn abs(self: f64x4) -> f64x4 {
        f64x4::from_array(__goml_simd_f64x4_abs(self.lanes))
    }

    pub fn sqrt(self: f64x4) -> f64x4 {
        f64x4::from_array(__goml_simd_f64x4_sqrt(self.lanes))
    }

    pub fn floor(self: f64x4) -> f64x4 {
        f64x4::from_array(__goml_simd_f64x4_floor(self.lanes))
    }

    pub fn ceil(self: f64x4) -> f64x4 {
        f64x4::from_array(__goml_simd_f64x4_ceil(self.lanes))
    }

    pub fn trunc(self: f64x4) -> f64x4 {
        f64x4::from_array(__goml_simd_f64x4_trunc(self.lanes))
    }

    pub fn round(self: f64x4) -> f64x4 {
        f64x4::from_array(__goml_simd_f64x4_round(self.lanes))
    }

    pub fn round_ties_even(self: f64x4) -> f64x4 {
        f64x4::from_array(__goml_simd_f64x4_round_ties_even(self.lanes))
    }

    pub fn simd_eq(self: f64x4, other: f64x4) -> mask64x4 {
        mask64x4::from_bitmask(__goml_simd_f64x4_eq(self.lanes, other.lanes))
    }

    pub fn simd_ne(self: f64x4, other: f64x4) -> mask64x4 {
        mask64x4::from_bitmask(__goml_simd_f64x4_ne(self.lanes, other.lanes))
    }

    pub fn simd_lt(self: f64x4, other: f64x4) -> mask64x4 {
        mask64x4::from_bitmask(__goml_simd_f64x4_lt(self.lanes, other.lanes))
    }

    pub fn simd_le(self: f64x4, other: f64x4) -> mask64x4 {
        mask64x4::from_bitmask(__goml_simd_f64x4_le(self.lanes, other.lanes))
    }

    pub fn simd_gt(self: f64x4, other: f64x4) -> mask64x4 {
        mask64x4::from_bitmask(__goml_simd_f64x4_gt(self.lanes, other.lanes))
    }

    pub fn simd_ge(self: f64x4, other: f64x4) -> mask64x4 {
        mask64x4::from_bitmask(__goml_simd_f64x4_ge(self.lanes, other.lanes))
    }

    pub fn reduce_sum(self: f64x4) -> f64 {
        __goml_simd_f64x4_reduce_sum(self.lanes)
    }

    pub fn reduce_product(self: f64x4) -> f64 {
        __goml_simd_f64x4_reduce_product(self.lanes)
    }

    pub fn reduce_min(self: f64x4) -> f64 {
        __goml_simd_f64x4_reduce_min(self.lanes)
    }

    pub fn reduce_max(self: f64x4) -> f64 {
        __goml_simd_f64x4_reduce_max(self.lanes)
    }

    pub fn shuffle(self: f64x4, other: f64x4, indices: [u32; 4]) -> f64x4 {
        f64x4::from_array(__goml_simd_f64x4_shuffle(self.lanes, other.lanes, indices))
    }

    pub fn swizzle(self: f64x4, indices: [u32; 4]) -> f64x4 {
        f64x4::from_array(__goml_simd_f64x4_swizzle(self.lanes, indices))
    }

    pub fn reverse(self: f64x4) -> f64x4 {
        self.swizzle([3, 2, 1, 0])
    }

    pub fn interleave_low(self: f64x4, other: f64x4) -> f64x4 {
        self.shuffle(other, [0, 4, 1, 5])
    }

    pub fn interleave_high(self: f64x4, other: f64x4) -> f64x4 {
        self.shuffle(other, [2, 6, 3, 7])
    }

    pub fn deinterleave_even(self: f64x4, other: f64x4) -> f64x4 {
        self.shuffle(other, [0, 2, 4, 6])
    }

    pub fn deinterleave_odd(self: f64x4, other: f64x4) -> f64x4 {
        self.shuffle(other, [1, 3, 5, 7])
    }

    pub fn to_f32(self: f64x4) -> f32x4 {
        f32x4::from_array(__goml_simd_f64x4_to_f32(self.lanes))
    }

    pub fn to_i32(self: f64x4) -> i32x4 {
        i32x4::from_array(__goml_simd_f64x4_to_i32(self.lanes))
    }

    pub fn to_u32(self: f64x4) -> u32x4 {
        u32x4::from_array(__goml_simd_f64x4_to_u32(self.lanes))
    }

    pub fn to_i64(self: f64x4) -> i64x4 {
        i64x4::from_array(__goml_simd_f64x4_to_i64(self.lanes))
    }

    pub fn to_u64(self: f64x4) -> u64x4 {
        u64x4::from_array(__goml_simd_f64x4_to_u64(self.lanes))
    }

    pub fn to_bits(self: f64x4) -> u64x4 {
        u64x4::from_array(__goml_simd_f64x4_to_bits(self.lanes))
    }

    pub fn from_bits(value: u64x4) -> f64x4 {
        f64x4::from_array(__goml_simd_f64x4_from_bits(value.to_array()))
    }

    pub fn mul_add(self: f64x4, other: f64x4, addend: f64x4) -> f64x4 {
        f64x4::from_array(__goml_simd_f64x4_mul_add(self.lanes, other.lanes, addend.lanes))
    }

    pub fn is_nan(self: f64x4) -> mask64x4 {
        self.simd_ne(self)
    }

    pub fn is_infinite(self: f64x4) -> mask64x4 {
        self.abs().simd_eq(f64x4::from_bits(u64x4::splat(9218868437227405312)))
    }

    pub fn is_finite(self: f64x4) -> mask64x4 {
        self.abs().simd_lt(f64x4::from_bits(u64x4::splat(9218868437227405312)))
    }
}

impl SimdSelect[mask64x4]for f64x4 {
    fn select_mask(self: f64x4, mask: mask64x4, other: f64x4) -> f64x4 {
        f64x4::from_array(__goml_simd_f64x4_select(mask.to_bitmask(), self.lanes, other.lanes))
    }
}

impl PartialEq for f64x4 {
    fn eq(self: f64x4, other: f64x4) -> bool {
        self.simd_eq(other).all()
    }
}

impl Debug for f64x4 {
    fn debug(self: f64x4) -> string {
        f"f64x4({self.lanes[0]}, {self.lanes[1]}, {self.lanes[2]}, {self.lanes[3]})"
    }
}
