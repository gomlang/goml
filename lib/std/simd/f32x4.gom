package simd;

pub struct f32x4 {
    lanes: [f32; 4],
}

impl f32x4 {
    pub fn from_array(values: [f32; 4]) -> f32x4 {
        f32x4 { lanes: values }
    }

    pub fn to_array(self: f32x4) -> [f32; 4] {
        self.lanes
    }

    pub fn splat(value: f32) -> f32x4 {
        f32x4::from_array(__goml_simd_f32x4_splat(value))
    }

    pub fn from_slice(values: Slice[f32], offset: isize) -> Option[f32x4] {
        if offset < 0 || offset > values.len() || values.len() - offset < 4 {
            Option::None
        } else {
            Option::Some(
                f32x4::from_array(
                    [values[offset + 0], values[offset + 1], values[offset + 2], values[offset + 3]],
                ),
            )
        }
    }

    pub fn copy_to_slice(self: f32x4, values: MutSlice[f32], offset: isize) -> bool {
        if offset < 0 || offset > values.len() || values.len() - offset < 4 {
            false
        } else {
            for index in 0..4 {
                values[offset + index] = self.lanes[index];
            }
            true
        }
    }

    pub fn add(self: f32x4, other: f32x4) -> f32x4 {
        f32x4::from_array(__goml_simd_f32x4_add(self.lanes, other.lanes))
    }

    pub fn sub(self: f32x4, other: f32x4) -> f32x4 {
        f32x4::from_array(__goml_simd_f32x4_sub(self.lanes, other.lanes))
    }

    pub fn mul(self: f32x4, other: f32x4) -> f32x4 {
        f32x4::from_array(__goml_simd_f32x4_mul(self.lanes, other.lanes))
    }

    pub fn min(self: f32x4, other: f32x4) -> f32x4 {
        f32x4::from_array(__goml_simd_f32x4_min(self.lanes, other.lanes))
    }

    pub fn max(self: f32x4, other: f32x4) -> f32x4 {
        f32x4::from_array(__goml_simd_f32x4_max(self.lanes, other.lanes))
    }

    pub fn div(self: f32x4, other: f32x4) -> f32x4 {
        f32x4::from_array(__goml_simd_f32x4_div(self.lanes, other.lanes))
    }

    pub fn neg(self: f32x4) -> f32x4 {
        f32x4::from_array(__goml_simd_f32x4_neg(self.lanes))
    }

    pub fn abs(self: f32x4) -> f32x4 {
        f32x4::from_array(__goml_simd_f32x4_abs(self.lanes))
    }

    pub fn sqrt(self: f32x4) -> f32x4 {
        f32x4::from_array(__goml_simd_f32x4_sqrt(self.lanes))
    }

    pub fn floor(self: f32x4) -> f32x4 {
        f32x4::from_array(__goml_simd_f32x4_floor(self.lanes))
    }

    pub fn ceil(self: f32x4) -> f32x4 {
        f32x4::from_array(__goml_simd_f32x4_ceil(self.lanes))
    }

    pub fn trunc(self: f32x4) -> f32x4 {
        f32x4::from_array(__goml_simd_f32x4_trunc(self.lanes))
    }

    pub fn round(self: f32x4) -> f32x4 {
        f32x4::from_array(__goml_simd_f32x4_round(self.lanes))
    }

    pub fn round_ties_even(self: f32x4) -> f32x4 {
        f32x4::from_array(__goml_simd_f32x4_round_ties_even(self.lanes))
    }

    pub fn simd_eq(self: f32x4, other: f32x4) -> mask32x4 {
        mask32x4::from_bitmask(__goml_simd_f32x4_eq(self.lanes, other.lanes))
    }

    pub fn simd_ne(self: f32x4, other: f32x4) -> mask32x4 {
        mask32x4::from_bitmask(__goml_simd_f32x4_ne(self.lanes, other.lanes))
    }

    pub fn simd_lt(self: f32x4, other: f32x4) -> mask32x4 {
        mask32x4::from_bitmask(__goml_simd_f32x4_lt(self.lanes, other.lanes))
    }

    pub fn simd_le(self: f32x4, other: f32x4) -> mask32x4 {
        mask32x4::from_bitmask(__goml_simd_f32x4_le(self.lanes, other.lanes))
    }

    pub fn simd_gt(self: f32x4, other: f32x4) -> mask32x4 {
        mask32x4::from_bitmask(__goml_simd_f32x4_gt(self.lanes, other.lanes))
    }

    pub fn simd_ge(self: f32x4, other: f32x4) -> mask32x4 {
        mask32x4::from_bitmask(__goml_simd_f32x4_ge(self.lanes, other.lanes))
    }

    pub fn reduce_sum(self: f32x4) -> f32 {
        __goml_simd_f32x4_reduce_sum(self.lanes)
    }

    pub fn reduce_product(self: f32x4) -> f32 {
        __goml_simd_f32x4_reduce_product(self.lanes)
    }

    pub fn reduce_min(self: f32x4) -> f32 {
        __goml_simd_f32x4_reduce_min(self.lanes)
    }

    pub fn reduce_max(self: f32x4) -> f32 {
        __goml_simd_f32x4_reduce_max(self.lanes)
    }

    pub fn shuffle(self: f32x4, other: f32x4, indices: [u32; 4]) -> f32x4 {
        f32x4::from_array(__goml_simd_f32x4_shuffle(self.lanes, other.lanes, indices))
    }

    pub fn swizzle(self: f32x4, indices: [u32; 4]) -> f32x4 {
        f32x4::from_array(__goml_simd_f32x4_swizzle(self.lanes, indices))
    }

    pub fn reverse(self: f32x4) -> f32x4 {
        self.swizzle([3, 2, 1, 0])
    }

    pub fn interleave_low(self: f32x4, other: f32x4) -> f32x4 {
        self.shuffle(other, [0, 4, 1, 5])
    }

    pub fn interleave_high(self: f32x4, other: f32x4) -> f32x4 {
        self.shuffle(other, [2, 6, 3, 7])
    }

    pub fn deinterleave_even(self: f32x4, other: f32x4) -> f32x4 {
        self.shuffle(other, [0, 2, 4, 6])
    }

    pub fn deinterleave_odd(self: f32x4, other: f32x4) -> f32x4 {
        self.shuffle(other, [1, 3, 5, 7])
    }

    pub fn to_f64(self: f32x4) -> f64x4 {
        f64x4::from_array(__goml_simd_f32x4_to_f64(self.lanes))
    }

    pub fn to_i32(self: f32x4) -> i32x4 {
        i32x4::from_array(__goml_simd_f32x4_to_i32(self.lanes))
    }

    pub fn to_u32(self: f32x4) -> u32x4 {
        u32x4::from_array(__goml_simd_f32x4_to_u32(self.lanes))
    }

    pub fn to_i64(self: f32x4) -> i64x4 {
        i64x4::from_array(__goml_simd_f32x4_to_i64(self.lanes))
    }

    pub fn to_u64(self: f32x4) -> u64x4 {
        u64x4::from_array(__goml_simd_f32x4_to_u64(self.lanes))
    }

    pub fn to_bits(self: f32x4) -> u32x4 {
        u32x4::from_array(__goml_simd_f32x4_to_bits(self.lanes))
    }

    pub fn from_bits(value: u32x4) -> f32x4 {
        f32x4::from_array(__goml_simd_f32x4_from_bits(value.to_array()))
    }

    pub fn mul_add(self: f32x4, other: f32x4, addend: f32x4) -> f32x4 {
        f32x4::from_array(__goml_simd_f32x4_mul_add(self.lanes, other.lanes, addend.lanes))
    }

    pub fn is_nan(self: f32x4) -> mask32x4 {
        self.simd_ne(self)
    }

    pub fn is_infinite(self: f32x4) -> mask32x4 {
        self.abs().simd_eq(f32x4::from_bits(u32x4::splat(2139095040)))
    }

    pub fn is_finite(self: f32x4) -> mask32x4 {
        self.abs().simd_lt(f32x4::from_bits(u32x4::splat(2139095040)))
    }
}

impl SimdSelect[mask32x4]for f32x4 {
    fn select_mask(self: f32x4, mask: mask32x4, other: f32x4) -> f32x4 {
        f32x4::from_array(__goml_simd_f32x4_select(mask.to_bitmask(), self.lanes, other.lanes))
    }
}

impl PartialEq for f32x4 {
    fn eq(self: f32x4, other: f32x4) -> bool {
        self.simd_eq(other).all()
    }
}

impl Debug for f32x4 {
    fn debug(self: f32x4) -> string {
        f"f32x4({self.lanes[0]}, {self.lanes[1]}, {self.lanes[2]}, {self.lanes[3]})"
    }
}
