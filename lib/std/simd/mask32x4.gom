package simd;

pub struct mask32x4 {
    bits: u8,
}

impl PartialEq for mask32x4 {
    fn eq(self: mask32x4, other: mask32x4) -> bool {
        self.bits == other.bits
    }
}

impl Eq for mask32x4 {}

impl Debug for mask32x4 {
    fn debug(self: mask32x4) -> string {
        f"mask32x4({self.bits})"
    }
}

impl mask32x4 {
    pub fn splat(value: bool) -> mask32x4 {
        mask32x4 {
            bits: if value {
                15
            } else {
                0
            },
        }
    }

    pub fn from_bitmask(bits: u8) -> mask32x4 {
        mask32x4 { bits: bits & 15 }
    }

    pub fn to_bitmask(self: mask32x4) -> u8 {
        self.bits
    }

    pub fn from_array(values: [bool; 4]) -> mask32x4 {
        let mut bits: u8 = 0;
        for index in 0..4 {
            if values[index] {
                bits = bits | (1 << index);
            }
        }
        mask32x4 { bits }
    }

    pub fn to_array(self: mask32x4) -> [bool; 4] {
        [self.bits & 1 != 0, self.bits & 2 != 0, self.bits & 4 != 0, self.bits & 8 != 0]
    }

    pub fn all(self: mask32x4) -> bool {
        self.bits == 15
    }

    pub fn any(self: mask32x4) -> bool {
        self.bits != 0
    }

    pub fn bitand(self: mask32x4, other: mask32x4) -> mask32x4 {
        mask32x4::from_bitmask(self.bits & other.bits)
    }

    pub fn bitor(self: mask32x4, other: mask32x4) -> mask32x4 {
        mask32x4::from_bitmask(self.bits | other.bits)
    }

    pub fn bitxor(self: mask32x4, other: mask32x4) -> mask32x4 {
        mask32x4::from_bitmask(self.bits ^ other.bits)
    }

    pub fn bitnot(self: mask32x4) -> mask32x4 {
        mask32x4::from_bitmask(~self.bits)
    }

    pub fn select(self: mask32x4, if_true: f32x4, if_false: f32x4) -> f32x4 {
        let left = if_true.to_array();
        let right = if_false.to_array();
        let mut result = right;
        for index in 0..4 {
            if self.bits & (1 << index) != 0 {
                result[index] = left[index];
            }
        }
        f32x4::from_array(result)
    }
}
