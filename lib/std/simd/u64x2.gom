package simd;

pub struct u64x2 {
    lanes: [u64; 2],
}

impl u64x2 {
    pub fn from_array(values: [u64; 2]) -> u64x2 {
        u64x2 { lanes: values }
    }

    pub fn to_array(self: u64x2) -> [u64; 2] {
        self.lanes
    }

    pub fn splat(value: u64) -> u64x2 {
        u64x2::from_array(__goml_simd_u64x2_splat(value))
    }

    pub fn from_slice(values: Slice[u64], offset: isize) -> Option[u64x2] {
        if offset < 0 || offset > values.len() || values.len() - offset < 2 {
            Option::None
        } else {
            Option::Some(u64x2::from_array([values[offset + 0], values[offset + 1]]))
        }
    }

    pub fn copy_to_slice(self: u64x2, values: MutSlice[u64], offset: isize) -> bool {
        if offset < 0 || offset > values.len() || values.len() - offset < 2 {
            false
        } else {
            for index in 0..2 {
                values[offset + index] = self.lanes[index];
            }
            true
        }
    }

    pub fn add(self: u64x2, other: u64x2) -> u64x2 {
        u64x2::from_array(__goml_simd_u64x2_add(self.lanes, other.lanes))
    }

    pub fn sub(self: u64x2, other: u64x2) -> u64x2 {
        u64x2::from_array(__goml_simd_u64x2_sub(self.lanes, other.lanes))
    }

    pub fn mul(self: u64x2, other: u64x2) -> u64x2 {
        u64x2::from_array(__goml_simd_u64x2_mul(self.lanes, other.lanes))
    }

    pub fn min(self: u64x2, other: u64x2) -> u64x2 {
        u64x2::from_array(__goml_simd_u64x2_min(self.lanes, other.lanes))
    }

    pub fn max(self: u64x2, other: u64x2) -> u64x2 {
        u64x2::from_array(__goml_simd_u64x2_max(self.lanes, other.lanes))
    }

    pub fn bitand(self: u64x2, other: u64x2) -> u64x2 {
        u64x2::from_array(__goml_simd_u64x2_bitand(self.lanes, other.lanes))
    }

    pub fn bitor(self: u64x2, other: u64x2) -> u64x2 {
        u64x2::from_array(__goml_simd_u64x2_bitor(self.lanes, other.lanes))
    }

    pub fn bitxor(self: u64x2, other: u64x2) -> u64x2 {
        u64x2::from_array(__goml_simd_u64x2_bitxor(self.lanes, other.lanes))
    }

    pub fn saturating_add(self: u64x2, other: u64x2) -> u64x2 {
        u64x2::from_array(__goml_simd_u64x2_saturating_add(self.lanes, other.lanes))
    }

    pub fn saturating_sub(self: u64x2, other: u64x2) -> u64x2 {
        u64x2::from_array(__goml_simd_u64x2_saturating_sub(self.lanes, other.lanes))
    }

    pub fn neg(self: u64x2) -> u64x2 {
        u64x2::from_array(__goml_simd_u64x2_neg(self.lanes))
    }

    pub fn abs(self: u64x2) -> u64x2 {
        u64x2::from_array(__goml_simd_u64x2_abs(self.lanes))
    }

    pub fn bitnot(self: u64x2) -> u64x2 {
        u64x2::from_array(__goml_simd_u64x2_bitnot(self.lanes))
    }

    pub fn simd_eq(self: u64x2, other: u64x2) -> mask64x2 {
        mask64x2::from_bitmask(__goml_simd_u64x2_eq(self.lanes, other.lanes))
    }

    pub fn simd_ne(self: u64x2, other: u64x2) -> mask64x2 {
        mask64x2::from_bitmask(__goml_simd_u64x2_ne(self.lanes, other.lanes))
    }

    pub fn simd_lt(self: u64x2, other: u64x2) -> mask64x2 {
        mask64x2::from_bitmask(__goml_simd_u64x2_lt(self.lanes, other.lanes))
    }

    pub fn simd_le(self: u64x2, other: u64x2) -> mask64x2 {
        mask64x2::from_bitmask(__goml_simd_u64x2_le(self.lanes, other.lanes))
    }

    pub fn simd_gt(self: u64x2, other: u64x2) -> mask64x2 {
        mask64x2::from_bitmask(__goml_simd_u64x2_gt(self.lanes, other.lanes))
    }

    pub fn simd_ge(self: u64x2, other: u64x2) -> mask64x2 {
        mask64x2::from_bitmask(__goml_simd_u64x2_ge(self.lanes, other.lanes))
    }

    pub fn reduce_sum(self: u64x2) -> u64 {
        __goml_simd_u64x2_reduce_sum(self.lanes)
    }

    pub fn reduce_product(self: u64x2) -> u64 {
        __goml_simd_u64x2_reduce_product(self.lanes)
    }

    pub fn reduce_min(self: u64x2) -> u64 {
        __goml_simd_u64x2_reduce_min(self.lanes)
    }

    pub fn reduce_max(self: u64x2) -> u64 {
        __goml_simd_u64x2_reduce_max(self.lanes)
    }

    pub fn reduce_and(self: u64x2) -> u64 {
        __goml_simd_u64x2_reduce_and(self.lanes)
    }

    pub fn reduce_or(self: u64x2) -> u64 {
        __goml_simd_u64x2_reduce_or(self.lanes)
    }

    pub fn reduce_xor(self: u64x2) -> u64 {
        __goml_simd_u64x2_reduce_xor(self.lanes)
    }

    pub fn shuffle(self: u64x2, other: u64x2, indices: [u32; 2]) -> u64x2 {
        u64x2::from_array(__goml_simd_u64x2_shuffle(self.lanes, other.lanes, indices))
    }

    pub fn swizzle(self: u64x2, indices: [u32; 2]) -> u64x2 {
        u64x2::from_array(__goml_simd_u64x2_swizzle(self.lanes, indices))
    }

    pub fn reverse(self: u64x2) -> u64x2 {
        self.swizzle([1, 0])
    }

    pub fn interleave_low(self: u64x2, other: u64x2) -> u64x2 {
        self.shuffle(other, [0, 2])
    }

    pub fn interleave_high(self: u64x2, other: u64x2) -> u64x2 {
        self.shuffle(other, [1, 3])
    }

    pub fn deinterleave_even(self: u64x2, other: u64x2) -> u64x2 {
        self.shuffle(other, [0, 2])
    }

    pub fn deinterleave_odd(self: u64x2, other: u64x2) -> u64x2 {
        self.shuffle(other, [1, 3])
    }

    pub fn to_f64(self: u64x2) -> f64x2 {
        f64x2::from_array(__goml_simd_u64x2_to_f64(self.lanes))
    }

    pub fn to_i64(self: u64x2) -> i64x2 {
        i64x2::from_array(__goml_simd_u64x2_to_i64(self.lanes))
    }

    pub fn shl(self: u64x2, count: u32) -> u64x2 {
        u64x2::from_array(__goml_simd_u64x2_shl(self.lanes, count))
    }

    pub fn shr(self: u64x2, count: u32) -> u64x2 {
        u64x2::from_array(__goml_simd_u64x2_shr(self.lanes, count))
    }
}

impl SimdSelect[mask64x2]for u64x2 {
    fn select_mask(self: u64x2, mask: mask64x2, other: u64x2) -> u64x2 {
        u64x2::from_array(__goml_simd_u64x2_select(mask.to_bitmask(), self.lanes, other.lanes))
    }
}

impl PartialEq for u64x2 {
    fn eq(self: u64x2, other: u64x2) -> bool {
        self.simd_eq(other).all()
    }
}

impl Eq for u64x2 {}

impl Debug for u64x2 {
    fn debug(self: u64x2) -> string {
        f"u64x2({self.lanes[0]}, {self.lanes[1]})"
    }
}
