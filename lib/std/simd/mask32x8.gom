package simd;

pub struct mask32x8 {
    bits: u8,
}

impl mask32x8 {
    pub fn splat(value: bool) -> mask32x8 {
        mask32x8 {
            bits: if value {
                255
            } else {
                0
            },
        }
    }

    pub fn from_bitmask(bits: u8) -> mask32x8 {
        mask32x8 { bits: bits & 255 }
    }

    pub fn to_bitmask(self: mask32x8) -> u8 {
        self.bits
    }

    pub fn from_array(values: [bool; 8]) -> mask32x8 {
        let mut bits: u8 = 0;
        for index in 0..8 {
            if values[index] {
                bits = bits | (1 << index);
            }
        }
        mask32x8 { bits }
    }

    pub fn to_array(self: mask32x8) -> [bool; 8] {
        [
            self.bits & 1 != 0,
            self.bits & 2 != 0,
            self.bits & 4 != 0,
            self.bits & 8 != 0,
            self.bits & 16 != 0,
            self.bits & 32 != 0,
            self.bits & 64 != 0,
            self.bits & 128 != 0,
        ]
    }

    pub fn bitand(self: mask32x8, other: mask32x8) -> mask32x8 {
        mask32x8::from_bitmask(__goml_simd_mask32x8_bitand(self.bits, other.bits))
    }

    pub fn bitor(self: mask32x8, other: mask32x8) -> mask32x8 {
        mask32x8::from_bitmask(__goml_simd_mask32x8_bitor(self.bits, other.bits))
    }

    pub fn bitxor(self: mask32x8, other: mask32x8) -> mask32x8 {
        mask32x8::from_bitmask(__goml_simd_mask32x8_bitxor(self.bits, other.bits))
    }

    pub fn bitnot(self: mask32x8) -> mask32x8 {
        mask32x8::from_bitmask(__goml_simd_mask32x8_bitnot(self.bits))
    }

    pub fn all(self: mask32x8) -> bool {
        __goml_simd_mask32x8_all(self.bits)
    }

    pub fn any(self: mask32x8) -> bool {
        __goml_simd_mask32x8_any(self.bits)
    }

    pub fn select[T: SimdSelect[mask32x8]](self: mask32x8, if_true: T, if_false: T) -> T {
        if_true.select_mask(self, if_false)
    }
}

impl PartialEq for mask32x8 {
    fn eq(self: mask32x8, other: mask32x8) -> bool {
        self.bits == other.bits
    }
}

impl Eq for mask32x8 {}

impl Debug for mask32x8 {
    fn debug(self: mask32x8) -> string {
        f"mask32x8({self.bits})"
    }
}
