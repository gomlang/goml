package simd;

pub struct mask8x16 {
    bits: u16,
}

impl mask8x16 {
    pub fn splat(value: bool) -> mask8x16 {
        mask8x16 {
            bits: if value {
                65535
            } else {
                0
            },
        }
    }

    pub fn from_bitmask(bits: u16) -> mask8x16 {
        mask8x16 { bits: bits & 65535 }
    }

    pub fn to_bitmask(self: mask8x16) -> u16 {
        self.bits
    }

    pub fn from_array(values: [bool; 16]) -> mask8x16 {
        let mut bits: u16 = 0;
        for index in 0..16 {
            if values[index] {
                bits = bits | (1 << index);
            }
        }
        mask8x16 { bits }
    }

    pub fn to_array(self: mask8x16) -> [bool; 16] {
        [
            self.bits & 1 != 0,
            self.bits & 2 != 0,
            self.bits & 4 != 0,
            self.bits & 8 != 0,
            self.bits & 16 != 0,
            self.bits & 32 != 0,
            self.bits & 64 != 0,
            self.bits & 128 != 0,
            self.bits & 256 != 0,
            self.bits & 512 != 0,
            self.bits & 1024 != 0,
            self.bits & 2048 != 0,
            self.bits & 4096 != 0,
            self.bits & 8192 != 0,
            self.bits & 16384 != 0,
            self.bits & 32768 != 0,
        ]
    }

    pub fn bitand(self: mask8x16, other: mask8x16) -> mask8x16 {
        mask8x16::from_bitmask(__goml_simd_mask8x16_bitand(self.bits, other.bits))
    }

    pub fn bitor(self: mask8x16, other: mask8x16) -> mask8x16 {
        mask8x16::from_bitmask(__goml_simd_mask8x16_bitor(self.bits, other.bits))
    }

    pub fn bitxor(self: mask8x16, other: mask8x16) -> mask8x16 {
        mask8x16::from_bitmask(__goml_simd_mask8x16_bitxor(self.bits, other.bits))
    }

    pub fn bitnot(self: mask8x16) -> mask8x16 {
        mask8x16::from_bitmask(__goml_simd_mask8x16_bitnot(self.bits))
    }

    pub fn all(self: mask8x16) -> bool {
        __goml_simd_mask8x16_all(self.bits)
    }

    pub fn any(self: mask8x16) -> bool {
        __goml_simd_mask8x16_any(self.bits)
    }

    pub fn select[T: SimdSelect[mask8x16]](self: mask8x16, if_true: T, if_false: T) -> T {
        if_true.select_mask(self, if_false)
    }
}

impl PartialEq for mask8x16 {
    fn eq(self: mask8x16, other: mask8x16) -> bool {
        self.bits == other.bits
    }
}

impl Eq for mask8x16 {}

impl Debug for mask8x16 {
    fn debug(self: mask8x16) -> string {
        f"mask8x16({self.bits})"
    }
}
