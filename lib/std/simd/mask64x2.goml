package simd;

pub struct mask64x2 {
    bits: u8,
}

impl mask64x2 {
    pub fn splat(value: bool) -> mask64x2 {
        mask64x2 {
            bits: if value {
                0x03
            } else {
                0
            },
        }
    }

    pub fn from_bitmask(bits: u8) -> mask64x2 {
        mask64x2 { bits: bits & 0x03 }
    }

    pub fn to_bitmask(self: mask64x2) -> u8 {
        self.bits
    }

    pub fn from_array(values: [bool; 2]) -> mask64x2 {
        let mut bits: u8 = 0;
        for index in 0..2 {
            if values[index] {
                bits = bits | (1 << index);
            }
        }
        mask64x2 { bits }
    }

    pub fn to_array(self: mask64x2) -> [bool; 2] {
        [self.bits & 0x01 != 0, self.bits & 0x02 != 0]
    }

    pub fn bitand(self: mask64x2, other: mask64x2) -> mask64x2 {
        mask64x2::from_bitmask(__goml_simd_mask64x2_bitand(self.bits, other.bits))
    }

    pub fn bitor(self: mask64x2, other: mask64x2) -> mask64x2 {
        mask64x2::from_bitmask(__goml_simd_mask64x2_bitor(self.bits, other.bits))
    }

    pub fn bitxor(self: mask64x2, other: mask64x2) -> mask64x2 {
        mask64x2::from_bitmask(__goml_simd_mask64x2_bitxor(self.bits, other.bits))
    }

    pub fn bitnot(self: mask64x2) -> mask64x2 {
        mask64x2::from_bitmask(__goml_simd_mask64x2_bitnot(self.bits))
    }

    pub fn all(self: mask64x2) -> bool {
        __goml_simd_mask64x2_all(self.bits)
    }

    pub fn any(self: mask64x2) -> bool {
        __goml_simd_mask64x2_any(self.bits)
    }

    pub fn select[T: SimdSelect[mask64x2]](self: mask64x2, if_true: T, if_false: T) -> T {
        if_true.select_mask(self, if_false)
    }
}

impl PartialEq for mask64x2 {
    fn eq(self: mask64x2, other: mask64x2) -> bool {
        self.bits == other.bits
    }
}

impl Eq for mask64x2 {}

impl Debug for mask64x2 {
    fn debug(self: mask64x2) -> string {
        f"mask64x2({self.bits})"
    }
}
