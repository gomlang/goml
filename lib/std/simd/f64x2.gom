package simd;

pub struct f64x2 {
    lanes: [f64; 2],
}

impl f64x2 {
    pub fn from_array(values: [f64; 2]) -> f64x2 {
        f64x2 { lanes: values }
    }

    pub fn to_array(self: f64x2) -> [f64; 2] {
        self.lanes
    }

    pub fn splat(value: f64) -> f64x2 {
        f64x2::from_array(__goml_simd_f64x2_splat(value))
    }

    pub fn from_slice(values: Slice[f64], offset: isize) -> Option[f64x2] {
        if offset < 0 || offset > values.len() || values.len() - offset < 2 {
            Option::None
        } else {
            Option::Some(f64x2::from_array([values[offset + 0], values[offset + 1]]))
        }
    }

    pub fn copy_to_slice(self: f64x2, values: MutSlice[f64], offset: isize) -> bool {
        if offset < 0 || offset > values.len() || values.len() - offset < 2 {
            false
        } else {
            for index in 0..2 {
                values[offset + index] = self.lanes[index];
            }
            true
        }
    }

    pub fn add(self: f64x2, other: f64x2) -> f64x2 {
        f64x2::from_array(__goml_simd_f64x2_add(self.lanes, other.lanes))
    }

    pub fn sub(self: f64x2, other: f64x2) -> f64x2 {
        f64x2::from_array(__goml_simd_f64x2_sub(self.lanes, other.lanes))
    }

    pub fn mul(self: f64x2, other: f64x2) -> f64x2 {
        f64x2::from_array(__goml_simd_f64x2_mul(self.lanes, other.lanes))
    }

    pub fn min(self: f64x2, other: f64x2) -> f64x2 {
        f64x2::from_array(__goml_simd_f64x2_min(self.lanes, other.lanes))
    }

    pub fn max(self: f64x2, other: f64x2) -> f64x2 {
        f64x2::from_array(__goml_simd_f64x2_max(self.lanes, other.lanes))
    }

    pub fn div(self: f64x2, other: f64x2) -> f64x2 {
        f64x2::from_array(__goml_simd_f64x2_div(self.lanes, other.lanes))
    }

    pub fn neg(self: f64x2) -> f64x2 {
        f64x2::from_array(__goml_simd_f64x2_neg(self.lanes))
    }

    pub fn abs(self: f64x2) -> f64x2 {
        f64x2::from_array(__goml_simd_f64x2_abs(self.lanes))
    }

    pub fn sqrt(self: f64x2) -> f64x2 {
        f64x2::from_array(__goml_simd_f64x2_sqrt(self.lanes))
    }

    pub fn floor(self: f64x2) -> f64x2 {
        f64x2::from_array(__goml_simd_f64x2_floor(self.lanes))
    }

    pub fn ceil(self: f64x2) -> f64x2 {
        f64x2::from_array(__goml_simd_f64x2_ceil(self.lanes))
    }

    pub fn trunc(self: f64x2) -> f64x2 {
        f64x2::from_array(__goml_simd_f64x2_trunc(self.lanes))
    }

    pub fn round(self: f64x2) -> f64x2 {
        f64x2::from_array(__goml_simd_f64x2_round(self.lanes))
    }

    pub fn round_ties_even(self: f64x2) -> f64x2 {
        f64x2::from_array(__goml_simd_f64x2_round_ties_even(self.lanes))
    }

    pub fn simd_eq(self: f64x2, other: f64x2) -> mask64x2 {
        mask64x2::from_bitmask(__goml_simd_f64x2_eq(self.lanes, other.lanes))
    }

    pub fn simd_ne(self: f64x2, other: f64x2) -> mask64x2 {
        mask64x2::from_bitmask(__goml_simd_f64x2_ne(self.lanes, other.lanes))
    }

    pub fn simd_lt(self: f64x2, other: f64x2) -> mask64x2 {
        mask64x2::from_bitmask(__goml_simd_f64x2_lt(self.lanes, other.lanes))
    }

    pub fn simd_le(self: f64x2, other: f64x2) -> mask64x2 {
        mask64x2::from_bitmask(__goml_simd_f64x2_le(self.lanes, other.lanes))
    }

    pub fn simd_gt(self: f64x2, other: f64x2) -> mask64x2 {
        mask64x2::from_bitmask(__goml_simd_f64x2_gt(self.lanes, other.lanes))
    }

    pub fn simd_ge(self: f64x2, other: f64x2) -> mask64x2 {
        mask64x2::from_bitmask(__goml_simd_f64x2_ge(self.lanes, other.lanes))
    }

    pub fn reduce_sum(self: f64x2) -> f64 {
        __goml_simd_f64x2_reduce_sum(self.lanes)
    }

    pub fn reduce_product(self: f64x2) -> f64 {
        __goml_simd_f64x2_reduce_product(self.lanes)
    }

    pub fn reduce_min(self: f64x2) -> f64 {
        __goml_simd_f64x2_reduce_min(self.lanes)
    }

    pub fn reduce_max(self: f64x2) -> f64 {
        __goml_simd_f64x2_reduce_max(self.lanes)
    }

    pub fn shuffle(self: f64x2, other: f64x2, indices: [u32; 2]) -> f64x2 {
        f64x2::from_array(__goml_simd_f64x2_shuffle(self.lanes, other.lanes, indices))
    }

    pub fn swizzle(self: f64x2, indices: [u32; 2]) -> f64x2 {
        f64x2::from_array(__goml_simd_f64x2_swizzle(self.lanes, indices))
    }

    pub fn reverse(self: f64x2) -> f64x2 {
        self.swizzle([1, 0])
    }

    pub fn interleave_low(self: f64x2, other: f64x2) -> f64x2 {
        self.shuffle(other, [0, 2])
    }

    pub fn interleave_high(self: f64x2, other: f64x2) -> f64x2 {
        self.shuffle(other, [1, 3])
    }

    pub fn deinterleave_even(self: f64x2, other: f64x2) -> f64x2 {
        self.shuffle(other, [0, 2])
    }

    pub fn deinterleave_odd(self: f64x2, other: f64x2) -> f64x2 {
        self.shuffle(other, [1, 3])
    }

    pub fn to_i64(self: f64x2) -> i64x2 {
        i64x2::from_array(__goml_simd_f64x2_to_i64(self.lanes))
    }

    pub fn to_u64(self: f64x2) -> u64x2 {
        u64x2::from_array(__goml_simd_f64x2_to_u64(self.lanes))
    }

    pub fn to_bits(self: f64x2) -> u64x2 {
        u64x2::from_array(__goml_simd_f64x2_to_bits(self.lanes))
    }

    pub fn from_bits(value: u64x2) -> f64x2 {
        f64x2::from_array(__goml_simd_f64x2_from_bits(value.to_array()))
    }

    pub fn mul_add(self: f64x2, other: f64x2, addend: f64x2) -> f64x2 {
        f64x2::from_array(__goml_simd_f64x2_mul_add(self.lanes, other.lanes, addend.lanes))
    }

    pub fn is_nan(self: f64x2) -> mask64x2 {
        self.simd_ne(self)
    }

    pub fn is_infinite(self: f64x2) -> mask64x2 {
        self.abs().simd_eq(f64x2::from_bits(u64x2::splat(9218868437227405312)))
    }

    pub fn is_finite(self: f64x2) -> mask64x2 {
        self.abs().simd_lt(f64x2::from_bits(u64x2::splat(9218868437227405312)))
    }
}

impl SimdSelect[mask64x2]for f64x2 {
    fn select_mask(self: f64x2, mask: mask64x2, other: f64x2) -> f64x2 {
        f64x2::from_array(__goml_simd_f64x2_select(mask.to_bitmask(), self.lanes, other.lanes))
    }
}

impl PartialEq for f64x2 {
    fn eq(self: f64x2, other: f64x2) -> bool {
        self.simd_eq(other).all()
    }
}

impl Debug for f64x2 {
    fn debug(self: f64x2) -> string {
        f"f64x2({self.lanes[0]}, {self.lanes[1]})"
    }
}
