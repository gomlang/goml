package simd;

pub struct f32x8 {
    lanes: [f32; 8],
}

impl f32x8 {
    pub fn from_array(values: [f32; 8]) -> f32x8 {
        f32x8 { lanes: values }
    }

    pub fn to_array(self: f32x8) -> [f32; 8] {
        self.lanes
    }

    pub fn splat(value: f32) -> f32x8 {
        f32x8::from_array(__goml_simd_f32x8_splat(value))
    }

    pub fn from_slice(values: Slice[f32], offset: isize) -> Option[f32x8] {
        if offset < 0 || offset > values.len() || values.len() - offset < 8 {
            Option::None
        } else {
            Option::Some(
                f32x8::from_array(
                    [
                        values[offset + 0],
                        values[offset + 1],
                        values[offset + 2],
                        values[offset + 3],
                        values[offset + 4],
                        values[offset + 5],
                        values[offset + 6],
                        values[offset + 7],
                    ],
                ),
            )
        }
    }

    pub fn copy_to_slice(self: f32x8, values: MutSlice[f32], offset: isize) -> bool {
        if offset < 0 || offset > values.len() || values.len() - offset < 8 {
            false
        } else {
            for index in 0..8 {
                values[offset + index] = self.lanes[index];
            }
            true
        }
    }

    pub fn add(self: f32x8, other: f32x8) -> f32x8 {
        f32x8::from_array(__goml_simd_f32x8_add(self.lanes, other.lanes))
    }

    pub fn sub(self: f32x8, other: f32x8) -> f32x8 {
        f32x8::from_array(__goml_simd_f32x8_sub(self.lanes, other.lanes))
    }

    pub fn mul(self: f32x8, other: f32x8) -> f32x8 {
        f32x8::from_array(__goml_simd_f32x8_mul(self.lanes, other.lanes))
    }

    pub fn min(self: f32x8, other: f32x8) -> f32x8 {
        f32x8::from_array(__goml_simd_f32x8_min(self.lanes, other.lanes))
    }

    pub fn max(self: f32x8, other: f32x8) -> f32x8 {
        f32x8::from_array(__goml_simd_f32x8_max(self.lanes, other.lanes))
    }

    pub fn div(self: f32x8, other: f32x8) -> f32x8 {
        f32x8::from_array(__goml_simd_f32x8_div(self.lanes, other.lanes))
    }

    pub fn neg(self: f32x8) -> f32x8 {
        f32x8::from_array(__goml_simd_f32x8_neg(self.lanes))
    }

    pub fn abs(self: f32x8) -> f32x8 {
        f32x8::from_array(__goml_simd_f32x8_abs(self.lanes))
    }

    pub fn sqrt(self: f32x8) -> f32x8 {
        f32x8::from_array(__goml_simd_f32x8_sqrt(self.lanes))
    }

    pub fn floor(self: f32x8) -> f32x8 {
        f32x8::from_array(__goml_simd_f32x8_floor(self.lanes))
    }

    pub fn ceil(self: f32x8) -> f32x8 {
        f32x8::from_array(__goml_simd_f32x8_ceil(self.lanes))
    }

    pub fn trunc(self: f32x8) -> f32x8 {
        f32x8::from_array(__goml_simd_f32x8_trunc(self.lanes))
    }

    pub fn round(self: f32x8) -> f32x8 {
        f32x8::from_array(__goml_simd_f32x8_round(self.lanes))
    }

    pub fn round_ties_even(self: f32x8) -> f32x8 {
        f32x8::from_array(__goml_simd_f32x8_round_ties_even(self.lanes))
    }

    pub fn simd_eq(self: f32x8, other: f32x8) -> mask32x8 {
        mask32x8::from_bitmask(__goml_simd_f32x8_eq(self.lanes, other.lanes))
    }

    pub fn simd_ne(self: f32x8, other: f32x8) -> mask32x8 {
        mask32x8::from_bitmask(__goml_simd_f32x8_ne(self.lanes, other.lanes))
    }

    pub fn simd_lt(self: f32x8, other: f32x8) -> mask32x8 {
        mask32x8::from_bitmask(__goml_simd_f32x8_lt(self.lanes, other.lanes))
    }

    pub fn simd_le(self: f32x8, other: f32x8) -> mask32x8 {
        mask32x8::from_bitmask(__goml_simd_f32x8_le(self.lanes, other.lanes))
    }

    pub fn simd_gt(self: f32x8, other: f32x8) -> mask32x8 {
        mask32x8::from_bitmask(__goml_simd_f32x8_gt(self.lanes, other.lanes))
    }

    pub fn simd_ge(self: f32x8, other: f32x8) -> mask32x8 {
        mask32x8::from_bitmask(__goml_simd_f32x8_ge(self.lanes, other.lanes))
    }

    pub fn reduce_sum(self: f32x8) -> f32 {
        __goml_simd_f32x8_reduce_sum(self.lanes)
    }

    pub fn reduce_product(self: f32x8) -> f32 {
        __goml_simd_f32x8_reduce_product(self.lanes)
    }

    pub fn reduce_min(self: f32x8) -> f32 {
        __goml_simd_f32x8_reduce_min(self.lanes)
    }

    pub fn reduce_max(self: f32x8) -> f32 {
        __goml_simd_f32x8_reduce_max(self.lanes)
    }

    pub fn shuffle(self: f32x8, other: f32x8, indices: [u32; 8]) -> f32x8 {
        f32x8::from_array(__goml_simd_f32x8_shuffle(self.lanes, other.lanes, indices))
    }

    pub fn swizzle(self: f32x8, indices: [u32; 8]) -> f32x8 {
        f32x8::from_array(__goml_simd_f32x8_swizzle(self.lanes, indices))
    }

    pub fn reverse(self: f32x8) -> f32x8 {
        self.swizzle([7, 6, 5, 4, 3, 2, 1, 0])
    }

    pub fn interleave_low(self: f32x8, other: f32x8) -> f32x8 {
        self.shuffle(other, [0, 8, 1, 9, 2, 10, 3, 11])
    }

    pub fn interleave_high(self: f32x8, other: f32x8) -> f32x8 {
        self.shuffle(other, [4, 12, 5, 13, 6, 14, 7, 15])
    }

    pub fn deinterleave_even(self: f32x8, other: f32x8) -> f32x8 {
        self.shuffle(other, [0, 2, 4, 6, 8, 10, 12, 14])
    }

    pub fn deinterleave_odd(self: f32x8, other: f32x8) -> f32x8 {
        self.shuffle(other, [1, 3, 5, 7, 9, 11, 13, 15])
    }

    pub fn to_i16(self: f32x8) -> i16x8 {
        i16x8::from_array(__goml_simd_f32x8_to_i16(self.lanes))
    }

    pub fn to_u16(self: f32x8) -> u16x8 {
        u16x8::from_array(__goml_simd_f32x8_to_u16(self.lanes))
    }

    pub fn to_i32(self: f32x8) -> i32x8 {
        i32x8::from_array(__goml_simd_f32x8_to_i32(self.lanes))
    }

    pub fn to_u32(self: f32x8) -> u32x8 {
        u32x8::from_array(__goml_simd_f32x8_to_u32(self.lanes))
    }

    pub fn to_bits(self: f32x8) -> u32x8 {
        u32x8::from_array(__goml_simd_f32x8_to_bits(self.lanes))
    }

    pub fn from_bits(value: u32x8) -> f32x8 {
        f32x8::from_array(__goml_simd_f32x8_from_bits(value.to_array()))
    }

    pub fn mul_add(self: f32x8, other: f32x8, addend: f32x8) -> f32x8 {
        f32x8::from_array(__goml_simd_f32x8_mul_add(self.lanes, other.lanes, addend.lanes))
    }

    pub fn is_nan(self: f32x8) -> mask32x8 {
        self.simd_ne(self)
    }

    pub fn is_infinite(self: f32x8) -> mask32x8 {
        self.abs().simd_eq(f32x8::from_bits(u32x8::splat(0x7f800000)))
    }

    pub fn is_finite(self: f32x8) -> mask32x8 {
        self.abs().simd_lt(f32x8::from_bits(u32x8::splat(0x7f800000)))
    }
}

impl SimdSelect[mask32x8]for f32x8 {
    fn select_mask(self: f32x8, mask: mask32x8, other: f32x8) -> f32x8 {
        f32x8::from_array(__goml_simd_f32x8_select(mask.to_bitmask(), self.lanes, other.lanes))
    }
}

impl PartialEq for f32x8 {
    fn eq(self: f32x8, other: f32x8) -> bool {
        self.simd_eq(other).all()
    }
}

impl Debug for f32x8 {
    fn debug(self: f32x8) -> string {
        f"f32x8({self.lanes[0]}, {self.lanes[1]}, {self.lanes[2]}, {self.lanes[3]}, {self.lanes[4]}, {self.lanes[5]}, {self.lanes[6]}, {self.lanes[7]})"
    }
}
