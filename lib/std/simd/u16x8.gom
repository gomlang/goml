package simd;

pub struct u16x8 {
    lanes: [u16; 8],
}

impl u16x8 {
    pub fn from_array(values: [u16; 8]) -> u16x8 {
        u16x8 { lanes: values }
    }

    pub fn to_array(self: u16x8) -> [u16; 8] {
        self.lanes
    }

    pub fn splat(value: u16) -> u16x8 {
        u16x8::from_array(__goml_simd_u16x8_splat(value))
    }

    pub fn from_slice(values: Slice[u16], offset: isize) -> Option[u16x8] {
        if offset < 0 || offset > values.len() || values.len() - offset < 8 {
            Option::None
        } else {
            Option::Some(
                u16x8::from_array(
                    [
                        values[offset + 0],
                        values[offset + 1],
                        values[offset + 2],
                        values[offset + 3],
                        values[offset + 4],
                        values[offset + 5],
                        values[offset + 6],
                        values[offset + 7],
                    ],
                ),
            )
        }
    }

    pub fn copy_to_slice(self: u16x8, values: MutSlice[u16], offset: isize) -> bool {
        if offset < 0 || offset > values.len() || values.len() - offset < 8 {
            false
        } else {
            for index in 0..8 {
                values[offset + index] = self.lanes[index];
            }
            true
        }
    }

    pub fn add(self: u16x8, other: u16x8) -> u16x8 {
        u16x8::from_array(__goml_simd_u16x8_add(self.lanes, other.lanes))
    }

    pub fn sub(self: u16x8, other: u16x8) -> u16x8 {
        u16x8::from_array(__goml_simd_u16x8_sub(self.lanes, other.lanes))
    }

    pub fn mul(self: u16x8, other: u16x8) -> u16x8 {
        u16x8::from_array(__goml_simd_u16x8_mul(self.lanes, other.lanes))
    }

    pub fn min(self: u16x8, other: u16x8) -> u16x8 {
        u16x8::from_array(__goml_simd_u16x8_min(self.lanes, other.lanes))
    }

    pub fn max(self: u16x8, other: u16x8) -> u16x8 {
        u16x8::from_array(__goml_simd_u16x8_max(self.lanes, other.lanes))
    }

    pub fn bitand(self: u16x8, other: u16x8) -> u16x8 {
        u16x8::from_array(__goml_simd_u16x8_bitand(self.lanes, other.lanes))
    }

    pub fn bitor(self: u16x8, other: u16x8) -> u16x8 {
        u16x8::from_array(__goml_simd_u16x8_bitor(self.lanes, other.lanes))
    }

    pub fn bitxor(self: u16x8, other: u16x8) -> u16x8 {
        u16x8::from_array(__goml_simd_u16x8_bitxor(self.lanes, other.lanes))
    }

    pub fn saturating_add(self: u16x8, other: u16x8) -> u16x8 {
        u16x8::from_array(__goml_simd_u16x8_saturating_add(self.lanes, other.lanes))
    }

    pub fn saturating_sub(self: u16x8, other: u16x8) -> u16x8 {
        u16x8::from_array(__goml_simd_u16x8_saturating_sub(self.lanes, other.lanes))
    }

    pub fn neg(self: u16x8) -> u16x8 {
        u16x8::from_array(__goml_simd_u16x8_neg(self.lanes))
    }

    pub fn abs(self: u16x8) -> u16x8 {
        u16x8::from_array(__goml_simd_u16x8_abs(self.lanes))
    }

    pub fn bitnot(self: u16x8) -> u16x8 {
        u16x8::from_array(__goml_simd_u16x8_bitnot(self.lanes))
    }

    pub fn simd_eq(self: u16x8, other: u16x8) -> mask16x8 {
        mask16x8::from_bitmask(__goml_simd_u16x8_eq(self.lanes, other.lanes))
    }

    pub fn simd_ne(self: u16x8, other: u16x8) -> mask16x8 {
        mask16x8::from_bitmask(__goml_simd_u16x8_ne(self.lanes, other.lanes))
    }

    pub fn simd_lt(self: u16x8, other: u16x8) -> mask16x8 {
        mask16x8::from_bitmask(__goml_simd_u16x8_lt(self.lanes, other.lanes))
    }

    pub fn simd_le(self: u16x8, other: u16x8) -> mask16x8 {
        mask16x8::from_bitmask(__goml_simd_u16x8_le(self.lanes, other.lanes))
    }

    pub fn simd_gt(self: u16x8, other: u16x8) -> mask16x8 {
        mask16x8::from_bitmask(__goml_simd_u16x8_gt(self.lanes, other.lanes))
    }

    pub fn simd_ge(self: u16x8, other: u16x8) -> mask16x8 {
        mask16x8::from_bitmask(__goml_simd_u16x8_ge(self.lanes, other.lanes))
    }

    pub fn reduce_sum(self: u16x8) -> u16 {
        __goml_simd_u16x8_reduce_sum(self.lanes)
    }

    pub fn reduce_product(self: u16x8) -> u16 {
        __goml_simd_u16x8_reduce_product(self.lanes)
    }

    pub fn reduce_min(self: u16x8) -> u16 {
        __goml_simd_u16x8_reduce_min(self.lanes)
    }

    pub fn reduce_max(self: u16x8) -> u16 {
        __goml_simd_u16x8_reduce_max(self.lanes)
    }

    pub fn reduce_and(self: u16x8) -> u16 {
        __goml_simd_u16x8_reduce_and(self.lanes)
    }

    pub fn reduce_or(self: u16x8) -> u16 {
        __goml_simd_u16x8_reduce_or(self.lanes)
    }

    pub fn reduce_xor(self: u16x8) -> u16 {
        __goml_simd_u16x8_reduce_xor(self.lanes)
    }

    pub fn shuffle(self: u16x8, other: u16x8, indices: [u32; 8]) -> u16x8 {
        u16x8::from_array(__goml_simd_u16x8_shuffle(self.lanes, other.lanes, indices))
    }

    pub fn swizzle(self: u16x8, indices: [u32; 8]) -> u16x8 {
        u16x8::from_array(__goml_simd_u16x8_swizzle(self.lanes, indices))
    }

    pub fn reverse(self: u16x8) -> u16x8 {
        self.swizzle([7, 6, 5, 4, 3, 2, 1, 0])
    }

    pub fn interleave_low(self: u16x8, other: u16x8) -> u16x8 {
        self.shuffle(other, [0, 8, 1, 9, 2, 10, 3, 11])
    }

    pub fn interleave_high(self: u16x8, other: u16x8) -> u16x8 {
        self.shuffle(other, [4, 12, 5, 13, 6, 14, 7, 15])
    }

    pub fn deinterleave_even(self: u16x8, other: u16x8) -> u16x8 {
        self.shuffle(other, [0, 2, 4, 6, 8, 10, 12, 14])
    }

    pub fn deinterleave_odd(self: u16x8, other: u16x8) -> u16x8 {
        self.shuffle(other, [1, 3, 5, 7, 9, 11, 13, 15])
    }

    pub fn to_f32(self: u16x8) -> f32x8 {
        f32x8::from_array(__goml_simd_u16x8_to_f32(self.lanes))
    }

    pub fn to_i16(self: u16x8) -> i16x8 {
        i16x8::from_array(__goml_simd_u16x8_to_i16(self.lanes))
    }

    pub fn to_i32(self: u16x8) -> i32x8 {
        i32x8::from_array(__goml_simd_u16x8_to_i32(self.lanes))
    }

    pub fn to_u32(self: u16x8) -> u32x8 {
        u32x8::from_array(__goml_simd_u16x8_to_u32(self.lanes))
    }

    pub fn shl(self: u16x8, count: u32) -> u16x8 {
        u16x8::from_array(__goml_simd_u16x8_shl(self.lanes, count))
    }

    pub fn shr(self: u16x8, count: u32) -> u16x8 {
        u16x8::from_array(__goml_simd_u16x8_shr(self.lanes, count))
    }
}

impl SimdSelect[mask16x8]for u16x8 {
    fn select_mask(self: u16x8, mask: mask16x8, other: u16x8) -> u16x8 {
        u16x8::from_array(__goml_simd_u16x8_select(mask.to_bitmask(), self.lanes, other.lanes))
    }
}

impl PartialEq for u16x8 {
    fn eq(self: u16x8, other: u16x8) -> bool {
        self.simd_eq(other).all()
    }
}

impl Eq for u16x8 {}

impl Debug for u16x8 {
    fn debug(self: u16x8) -> string {
        f"u16x8({self.lanes[0]}, {self.lanes[1]}, {self.lanes[2]}, {self.lanes[3]}, {self.lanes[4]}, {self.lanes[5]}, {self.lanes[6]}, {self.lanes[7]})"
    }
}
