package simd;

pub struct u32x4 {
    lanes: [u32; 4],
}

impl u32x4 {
    pub fn from_array(values: [u32; 4]) -> u32x4 {
        u32x4 { lanes: values }
    }

    pub fn to_array(self: u32x4) -> [u32; 4] {
        self.lanes
    }

    pub fn splat(value: u32) -> u32x4 {
        u32x4::from_array(__goml_simd_u32x4_splat(value))
    }

    pub fn from_slice(values: Slice[u32], offset: isize) -> Option[u32x4] {
        if offset < 0 || offset > values.len() || values.len() - offset < 4 {
            Option::None
        } else {
            Option::Some(
                u32x4::from_array(
                    [values[offset + 0], values[offset + 1], values[offset + 2], values[offset + 3]],
                ),
            )
        }
    }

    pub fn copy_to_slice(self: u32x4, values: MutSlice[u32], offset: isize) -> bool {
        if offset < 0 || offset > values.len() || values.len() - offset < 4 {
            false
        } else {
            for index in 0..4 {
                values[offset + index] = self.lanes[index];
            }
            true
        }
    }

    pub fn add(self: u32x4, other: u32x4) -> u32x4 {
        u32x4::from_array(__goml_simd_u32x4_add(self.lanes, other.lanes))
    }

    pub fn sub(self: u32x4, other: u32x4) -> u32x4 {
        u32x4::from_array(__goml_simd_u32x4_sub(self.lanes, other.lanes))
    }

    pub fn mul(self: u32x4, other: u32x4) -> u32x4 {
        u32x4::from_array(__goml_simd_u32x4_mul(self.lanes, other.lanes))
    }

    pub fn min(self: u32x4, other: u32x4) -> u32x4 {
        u32x4::from_array(__goml_simd_u32x4_min(self.lanes, other.lanes))
    }

    pub fn max(self: u32x4, other: u32x4) -> u32x4 {
        u32x4::from_array(__goml_simd_u32x4_max(self.lanes, other.lanes))
    }

    pub fn bitand(self: u32x4, other: u32x4) -> u32x4 {
        u32x4::from_array(__goml_simd_u32x4_bitand(self.lanes, other.lanes))
    }

    pub fn bitor(self: u32x4, other: u32x4) -> u32x4 {
        u32x4::from_array(__goml_simd_u32x4_bitor(self.lanes, other.lanes))
    }

    pub fn bitxor(self: u32x4, other: u32x4) -> u32x4 {
        u32x4::from_array(__goml_simd_u32x4_bitxor(self.lanes, other.lanes))
    }

    pub fn saturating_add(self: u32x4, other: u32x4) -> u32x4 {
        u32x4::from_array(__goml_simd_u32x4_saturating_add(self.lanes, other.lanes))
    }

    pub fn saturating_sub(self: u32x4, other: u32x4) -> u32x4 {
        u32x4::from_array(__goml_simd_u32x4_saturating_sub(self.lanes, other.lanes))
    }

    pub fn neg(self: u32x4) -> u32x4 {
        u32x4::from_array(__goml_simd_u32x4_neg(self.lanes))
    }

    pub fn abs(self: u32x4) -> u32x4 {
        u32x4::from_array(__goml_simd_u32x4_abs(self.lanes))
    }

    pub fn bitnot(self: u32x4) -> u32x4 {
        u32x4::from_array(__goml_simd_u32x4_bitnot(self.lanes))
    }

    pub fn simd_eq(self: u32x4, other: u32x4) -> mask32x4 {
        mask32x4::from_bitmask(__goml_simd_u32x4_eq(self.lanes, other.lanes))
    }

    pub fn simd_ne(self: u32x4, other: u32x4) -> mask32x4 {
        mask32x4::from_bitmask(__goml_simd_u32x4_ne(self.lanes, other.lanes))
    }

    pub fn simd_lt(self: u32x4, other: u32x4) -> mask32x4 {
        mask32x4::from_bitmask(__goml_simd_u32x4_lt(self.lanes, other.lanes))
    }

    pub fn simd_le(self: u32x4, other: u32x4) -> mask32x4 {
        mask32x4::from_bitmask(__goml_simd_u32x4_le(self.lanes, other.lanes))
    }

    pub fn simd_gt(self: u32x4, other: u32x4) -> mask32x4 {
        mask32x4::from_bitmask(__goml_simd_u32x4_gt(self.lanes, other.lanes))
    }

    pub fn simd_ge(self: u32x4, other: u32x4) -> mask32x4 {
        mask32x4::from_bitmask(__goml_simd_u32x4_ge(self.lanes, other.lanes))
    }

    pub fn reduce_sum(self: u32x4) -> u32 {
        __goml_simd_u32x4_reduce_sum(self.lanes)
    }

    pub fn reduce_product(self: u32x4) -> u32 {
        __goml_simd_u32x4_reduce_product(self.lanes)
    }

    pub fn reduce_min(self: u32x4) -> u32 {
        __goml_simd_u32x4_reduce_min(self.lanes)
    }

    pub fn reduce_max(self: u32x4) -> u32 {
        __goml_simd_u32x4_reduce_max(self.lanes)
    }

    pub fn reduce_and(self: u32x4) -> u32 {
        __goml_simd_u32x4_reduce_and(self.lanes)
    }

    pub fn reduce_or(self: u32x4) -> u32 {
        __goml_simd_u32x4_reduce_or(self.lanes)
    }

    pub fn reduce_xor(self: u32x4) -> u32 {
        __goml_simd_u32x4_reduce_xor(self.lanes)
    }

    pub fn shuffle(self: u32x4, other: u32x4, indices: [u32; 4]) -> u32x4 {
        u32x4::from_array(__goml_simd_u32x4_shuffle(self.lanes, other.lanes, indices))
    }

    pub fn swizzle(self: u32x4, indices: [u32; 4]) -> u32x4 {
        u32x4::from_array(__goml_simd_u32x4_swizzle(self.lanes, indices))
    }

    pub fn reverse(self: u32x4) -> u32x4 {
        self.swizzle([3, 2, 1, 0])
    }

    pub fn interleave_low(self: u32x4, other: u32x4) -> u32x4 {
        self.shuffle(other, [0, 4, 1, 5])
    }

    pub fn interleave_high(self: u32x4, other: u32x4) -> u32x4 {
        self.shuffle(other, [2, 6, 3, 7])
    }

    pub fn deinterleave_even(self: u32x4, other: u32x4) -> u32x4 {
        self.shuffle(other, [0, 2, 4, 6])
    }

    pub fn deinterleave_odd(self: u32x4, other: u32x4) -> u32x4 {
        self.shuffle(other, [1, 3, 5, 7])
    }

    pub fn to_f32(self: u32x4) -> f32x4 {
        f32x4::from_array(__goml_simd_u32x4_to_f32(self.lanes))
    }

    pub fn to_f64(self: u32x4) -> f64x4 {
        f64x4::from_array(__goml_simd_u32x4_to_f64(self.lanes))
    }

    pub fn to_i32(self: u32x4) -> i32x4 {
        i32x4::from_array(__goml_simd_u32x4_to_i32(self.lanes))
    }

    pub fn to_i64(self: u32x4) -> i64x4 {
        i64x4::from_array(__goml_simd_u32x4_to_i64(self.lanes))
    }

    pub fn to_u64(self: u32x4) -> u64x4 {
        u64x4::from_array(__goml_simd_u32x4_to_u64(self.lanes))
    }

    pub fn shl(self: u32x4, count: u32) -> u32x4 {
        u32x4::from_array(__goml_simd_u32x4_shl(self.lanes, count))
    }

    pub fn shr(self: u32x4, count: u32) -> u32x4 {
        u32x4::from_array(__goml_simd_u32x4_shr(self.lanes, count))
    }
}

impl SimdSelect[mask32x4]for u32x4 {
    fn select_mask(self: u32x4, mask: mask32x4, other: u32x4) -> u32x4 {
        u32x4::from_array(__goml_simd_u32x4_select(mask.to_bitmask(), self.lanes, other.lanes))
    }
}

impl PartialEq for u32x4 {
    fn eq(self: u32x4, other: u32x4) -> bool {
        self.simd_eq(other).all()
    }
}

impl Eq for u32x4 {}

impl Debug for u32x4 {
    fn debug(self: u32x4) -> string {
        f"u32x4({self.lanes[0]}, {self.lanes[1]}, {self.lanes[2]}, {self.lanes[3]})"
    }
}
