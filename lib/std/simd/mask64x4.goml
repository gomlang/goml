package simd;

pub struct mask64x4 {
    bits: u8,
}

impl mask64x4 {
    pub fn splat(value: bool) -> mask64x4 {
        mask64x4 {
            bits: if value {
                0x0f
            } else {
                0
            },
        }
    }

    pub fn from_bitmask(bits: u8) -> mask64x4 {
        mask64x4 { bits: bits & 0x0f }
    }

    pub fn to_bitmask(self: mask64x4) -> u8 {
        self.bits
    }

    pub fn from_array(values: [bool; 4]) -> mask64x4 {
        let mut bits: u8 = 0;
        for index in 0..4 {
            if values[index] {
                bits = bits | (1 << index);
            }
        }
        mask64x4 { bits }
    }

    pub fn to_array(self: mask64x4) -> [bool; 4] {
        [self.bits & 0x01 != 0, self.bits & 0x02 != 0, self.bits & 0x04 != 0, self.bits & 0x08 != 0]
    }

    pub fn bitand(self: mask64x4, other: mask64x4) -> mask64x4 {
        mask64x4::from_bitmask(__goml_simd_mask64x4_bitand(self.bits, other.bits))
    }

    pub fn bitor(self: mask64x4, other: mask64x4) -> mask64x4 {
        mask64x4::from_bitmask(__goml_simd_mask64x4_bitor(self.bits, other.bits))
    }

    pub fn bitxor(self: mask64x4, other: mask64x4) -> mask64x4 {
        mask64x4::from_bitmask(__goml_simd_mask64x4_bitxor(self.bits, other.bits))
    }

    pub fn bitnot(self: mask64x4) -> mask64x4 {
        mask64x4::from_bitmask(__goml_simd_mask64x4_bitnot(self.bits))
    }

    pub fn all(self: mask64x4) -> bool {
        __goml_simd_mask64x4_all(self.bits)
    }

    pub fn any(self: mask64x4) -> bool {
        __goml_simd_mask64x4_any(self.bits)
    }

    pub fn select[T: SimdSelect[mask64x4]](self: mask64x4, if_true: T, if_false: T) -> T {
        if_true.select_mask(self, if_false)
    }
}

impl PartialEq for mask64x4 {
    fn eq(self: mask64x4, other: mask64x4) -> bool {
        self.bits == other.bits
    }
}

impl Eq for mask64x4 {}

impl Debug for mask64x4 {
    fn debug(self: mask64x4) -> string {
        f"mask64x4({self.bits})"
    }
}
