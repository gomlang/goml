package simd;

pub struct mask16x8 {
    bits: u8,
}

impl mask16x8 {
    pub fn splat(value: bool) -> mask16x8 {
        mask16x8 {
            bits: if value {
                0xff
            } else {
                0
            },
        }
    }

    pub fn from_bitmask(bits: u8) -> mask16x8 {
        mask16x8 { bits: bits & 0xff }
    }

    pub fn to_bitmask(self: mask16x8) -> u8 {
        self.bits
    }

    pub fn from_array(values: [bool; 8]) -> mask16x8 {
        let mut bits: u8 = 0;
        for index in 0..8 {
            if values[index] {
                bits = bits | (1 << index);
            }
        }
        mask16x8 { bits }
    }

    pub fn to_array(self: mask16x8) -> [bool; 8] {
        [
            self.bits & 0x01 != 0,
            self.bits & 0x02 != 0,
            self.bits & 0x04 != 0,
            self.bits & 0x08 != 0,
            self.bits & 0x10 != 0,
            self.bits & 0x20 != 0,
            self.bits & 0x40 != 0,
            self.bits & 0x80 != 0,
        ]
    }

    pub fn bitand(self: mask16x8, other: mask16x8) -> mask16x8 {
        mask16x8::from_bitmask(__goml_simd_mask16x8_bitand(self.bits, other.bits))
    }

    pub fn bitor(self: mask16x8, other: mask16x8) -> mask16x8 {
        mask16x8::from_bitmask(__goml_simd_mask16x8_bitor(self.bits, other.bits))
    }

    pub fn bitxor(self: mask16x8, other: mask16x8) -> mask16x8 {
        mask16x8::from_bitmask(__goml_simd_mask16x8_bitxor(self.bits, other.bits))
    }

    pub fn bitnot(self: mask16x8) -> mask16x8 {
        mask16x8::from_bitmask(__goml_simd_mask16x8_bitnot(self.bits))
    }

    pub fn all(self: mask16x8) -> bool {
        __goml_simd_mask16x8_all(self.bits)
    }

    pub fn any(self: mask16x8) -> bool {
        __goml_simd_mask16x8_any(self.bits)
    }

    pub fn select[T: SimdSelect[mask16x8]](self: mask16x8, if_true: T, if_false: T) -> T {
        if_true.select_mask(self, if_false)
    }
}

impl PartialEq for mask16x8 {
    fn eq(self: mask16x8, other: mask16x8) -> bool {
        self.bits == other.bits
    }
}

impl Eq for mask16x8 {}

impl Debug for mask16x8 {
    fn debug(self: mask16x8) -> string {
        f"mask16x8({self.bits})"
    }
}
