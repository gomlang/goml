package simd;

pub struct mask8x32 {
    bits: u32,
}

impl mask8x32 {
    pub fn splat(value: bool) -> mask8x32 {
        mask8x32 {
            bits: if value {
                0xffffffff
            } else {
                0
            },
        }
    }

    pub fn from_bitmask(bits: u32) -> mask8x32 {
        mask8x32 { bits: bits & 0xffffffff }
    }

    pub fn to_bitmask(self: mask8x32) -> u32 {
        self.bits
    }

    pub fn from_array(values: [bool; 32]) -> mask8x32 {
        let mut bits: u32 = 0;
        for index in 0..32 {
            if values[index] {
                bits = bits | (1 << index);
            }
        }
        mask8x32 { bits }
    }

    pub fn to_array(self: mask8x32) -> [bool; 32] {
        [
            self.bits & 0x00000001 != 0,
            self.bits & 0x00000002 != 0,
            self.bits & 0x00000004 != 0,
            self.bits & 0x00000008 != 0,
            self.bits & 0x00000010 != 0,
            self.bits & 0x00000020 != 0,
            self.bits & 0x00000040 != 0,
            self.bits & 0x00000080 != 0,
            self.bits & 0x00000100 != 0,
            self.bits & 0x00000200 != 0,
            self.bits & 0x00000400 != 0,
            self.bits & 0x00000800 != 0,
            self.bits & 0x00001000 != 0,
            self.bits & 0x00002000 != 0,
            self.bits & 0x00004000 != 0,
            self.bits & 0x00008000 != 0,
            self.bits & 0x00010000 != 0,
            self.bits & 0x00020000 != 0,
            self.bits & 0x00040000 != 0,
            self.bits & 0x00080000 != 0,
            self.bits & 0x00100000 != 0,
            self.bits & 0x00200000 != 0,
            self.bits & 0x00400000 != 0,
            self.bits & 0x00800000 != 0,
            self.bits & 0x01000000 != 0,
            self.bits & 0x02000000 != 0,
            self.bits & 0x04000000 != 0,
            self.bits & 0x08000000 != 0,
            self.bits & 0x10000000 != 0,
            self.bits & 0x20000000 != 0,
            self.bits & 0x40000000 != 0,
            self.bits & 0x80000000 != 0,
        ]
    }

    pub fn bitand(self: mask8x32, other: mask8x32) -> mask8x32 {
        mask8x32::from_bitmask(__goml_simd_mask8x32_bitand(self.bits, other.bits))
    }

    pub fn bitor(self: mask8x32, other: mask8x32) -> mask8x32 {
        mask8x32::from_bitmask(__goml_simd_mask8x32_bitor(self.bits, other.bits))
    }

    pub fn bitxor(self: mask8x32, other: mask8x32) -> mask8x32 {
        mask8x32::from_bitmask(__goml_simd_mask8x32_bitxor(self.bits, other.bits))
    }

    pub fn bitnot(self: mask8x32) -> mask8x32 {
        mask8x32::from_bitmask(__goml_simd_mask8x32_bitnot(self.bits))
    }

    pub fn all(self: mask8x32) -> bool {
        __goml_simd_mask8x32_all(self.bits)
    }

    pub fn any(self: mask8x32) -> bool {
        __goml_simd_mask8x32_any(self.bits)
    }

    pub fn select[T: SimdSelect[mask8x32]](self: mask8x32, if_true: T, if_false: T) -> T {
        if_true.select_mask(self, if_false)
    }
}

impl PartialEq for mask8x32 {
    fn eq(self: mask8x32, other: mask8x32) -> bool {
        self.bits == other.bits
    }
}

impl Eq for mask8x32 {}

impl Debug for mask8x32 {
    fn debug(self: mask8x32) -> string {
        f"mask8x32({self.bits})"
    }
}
