package error;

enum ReportMapStep[E] {
    Node(Report[E]),
    Context(string),
    Group(isize),
}

impl[E] Report[E] {
    pub fn map[F](self: Report[E], convert: (E) -> F) -> Report[F] {
        let pending = Vec::from_array([ReportMapStep::Node(self)]);
        let mapped: Vec[Report[F]] = Vec::new();
        while let Some(step) = pending.pop() {
            match step {
                Node(report) => match report.node {
                    Value(value) => mapped.push(Report::new(convert(value))),
                    Context(message, cause) => {
                        pending.push(ReportMapStep::Context(message));
                        pending.push(ReportMapStep::Node(cause))
                    },
                    Group(causes) => {
                        pending.push(ReportMapStep::Group(causes.len()));
                        let mut index = causes.len();
                        while index > 0 {
                            index -= 1;
                            pending.push(ReportMapStep::Node(causes[index]));
                        }
                    },
                },
                Context(message) => {
                    let cause = mapped[mapped.len() - 1];
                    let _ = mapped.pop();
                    mapped.push(cause.context(message))
                },
                Group(count) => {
                    let children: Vec[Report[F]] = Vec::new();
                    let start = mapped.len() - count;
                    for index in start..mapped.len() {
                        children.push(mapped[index])
                    }
                    for _ in 0..count {
                        let _ = mapped.pop();
                    }
                    mapped.push(Report { node: ReportNode::Group(children) })
                },
            }
        }
        mapped[0]
    }
}
