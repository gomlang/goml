package error;

pub trait ResultExt[T, E] {
    fn into_report(self: Self) -> Result[T, Report[E]];
}

impl[T, E] ResultExt[T, E]for Result[T, E] {
    fn into_report(self: Result[T, E]) -> Result[T, Report[E]] {
        self.map_err(|cause: E| Report::new(cause))
    }
}

pub trait ReportContext[T, E] {
    fn context(self: Self, message: string) -> Result[T, Report[E]];
    fn with_context(self: Self, message: () -> string) -> Result[T, Report[E]];
}

impl[T, E] ReportContext[T, E]for Result[T, Report[E]] {
    fn context(self: Result[T, Report[E]], message: string) -> Result[T, Report[E]] {
        self.map_err(|report: Report[E]| report.context(message))
    }

    fn with_context(self: Result[T, Report[E]], message: () -> string) -> Result[T, Report[E]] {
        self.map_err(|report: Report[E]| report.context(message()))
    }
}
