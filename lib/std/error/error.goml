package error;

pub trait Error: Debug + ToString {}

impl[E: Debug + ToString] Error for E {}

enum ReportNode[E] {
    Value(E),
    Context(string, Report[E]),
    Group(Vec[Report[E]]),
}

pub struct Report[E] {
    node: ReportNode[E],
}

impl[E] Report[E] {
    pub fn new(value: E) -> Report[E] {
        Report { node: ReportNode::Value(value) }
    }

    pub fn context(self: Report[E], message: string) -> Report[E] {
        Report { node: ReportNode::Context(message, self) }
    }

    pub fn join(values: Slice[Report[E]]) -> Option[Report[E]] {
        if values.len() == 0 {
            Option::None
        } else {
            Option::Some(Report { node: ReportNode::Group(values.to_vec()) })
        }
    }

    pub fn value(self: Report[E]) -> Option[E] {
        match self.node {
            ReportNode::Value(value) => Option::Some(value),
            _ => Option::None,
        }
    }

    pub fn message(self: Report[E]) -> Option[string] {
        match self.node {
            ReportNode::Context(message, _) => Option::Some(message),
            _ => Option::None,
        }
    }

    pub fn causes(self: Report[E]) -> Vec[Report[E]] {
        match self.node {
            ReportNode::Value(_) => Vec::new(),
            ReportNode::Context(_, cause) => Vec::from_array([cause]),
            ReportNode::Group(causes) => causes.as_slice().to_vec(),
        }
    }

    pub fn find_map[T](self: Report[E], select: (E) -> Option[T]) -> Option[T] {
        let pending = Vec::from_array([self]);
        while let Some(report) = pending.pop() {
            match report.node {
                ReportNode::Value(value) => if let Some(result) = select(value) {
                    return Option::Some(result)
                },
                ReportNode::Context(_, cause) => pending.push(cause),
                ReportNode::Group(causes) => {
                    let mut index = causes.len();
                    while index > 0 {
                        index -= 1;
                        pending.push(causes[index]);
                    }
                },
            }
        }
        Option::None
    }

    pub fn find(self: Report[E], predicate: (E) -> bool) -> Option[E] {
        self.find_map(
            |value: E| if predicate(value) {
                Option::Some(value)
            } else {
                Option::None
            },
        )
    }
}

impl[E: PartialEq] Report[E] {
    pub fn contains(self: Report[E], target: E) -> bool {
        self.find(|value: E| value == target).is_some()
    }
}

enum ReportRender[E] {
    Node(Report[E]),
    Text(string),
}

impl[E: ToString] ToString for Report[E] {
    fn to_string(self: Report[E]) -> string {
        let output: Vec[byte] = Vec::new();
        let pending = Vec::from_array([ReportRender::Node(self)]);
        while let Some(step) = pending.pop() {
            let text = match step {
                ReportRender::Text(value) => value,
                ReportRender::Node(report) => match report.node {
                    ReportNode::Value(value) => value.to_string(),
                    ReportNode::Context(message, cause) => {
                        pending.push(ReportRender::Node(cause));
                        message + ": "
                    },
                    ReportNode::Group(causes) => {
                        let mut index = causes.len();
                        while index > 0 {
                            index -= 1;
                            pending.push(ReportRender::Node(causes[index]));
                            if index > 0 {
                                pending.push(ReportRender::Text("\n"));
                            }
                        }
                        ""
                    },
                },
            };
            for index in 0..text.byte_len() {
                output.push(text.byte_get(index));
            }
        }
        let (_, result) = string_from_utf8(output);
        result
    }
}

impl[E: ToString] Debug for Report[E] {
    fn debug(self: Report[E]) -> string {
        self.to_string()
    }
}

pub enum ErrorKind {
    NotFound,
    PermissionDenied,
    AlreadyExists,
    InvalidInput,
    InvalidData,
    TimedOut,
    Interrupted,
    UnexpectedEof,
    WriteZero,
    BrokenPipe,
    WouldBlock,
    Unsupported,
    Other,
}

impl ToString for ErrorKind {
    fn to_string(self: ErrorKind) -> string {
        match self {
            ErrorKind::NotFound => "NotFound",
            ErrorKind::PermissionDenied => "PermissionDenied",
            ErrorKind::AlreadyExists => "AlreadyExists",
            ErrorKind::InvalidInput => "InvalidInput",
            ErrorKind::InvalidData => "InvalidData",
            ErrorKind::TimedOut => "TimedOut",
            ErrorKind::Interrupted => "Interrupted",
            ErrorKind::UnexpectedEof => "UnexpectedEof",
            ErrorKind::WriteZero => "WriteZero",
            ErrorKind::BrokenPipe => "BrokenPipe",
            ErrorKind::WouldBlock => "WouldBlock",
            ErrorKind::Unsupported => "Unsupported",
            ErrorKind::Other => "Other",
        }
    }
}

impl Debug for ErrorKind {
    fn debug(self: ErrorKind) -> string {
        self.to_string()
    }
}

impl PartialEq for ErrorKind {
    fn eq(self: ErrorKind, other: ErrorKind) -> bool {
        kind_code(self) == kind_code(other)
    }
}

impl Eq for ErrorKind {}

pub struct Details {
    kind_code_value: isize,
    operation_value: string,
    context_value: Option[string],
    raw_os_code_value: Option[isize],
    message_value: string,
}

impl Details {
    pub fn new(
        kind_code: isize,
        operation: string,
        context: Option[string],
        raw_os_code: Option[isize],
        message: string,
    ) -> Details {
        Details {
            kind_code_value: kind_code,
            operation_value: operation,
            context_value: context,
            raw_os_code_value: raw_os_code,
            message_value: message,
        }
    }

    pub fn kind_code(self: Details) -> isize {
        self.kind_code_value
    }

    pub fn operation(self: Details) -> string {
        self.operation_value
    }

    pub fn context(self: Details) -> Option[string] {
        self.context_value
    }

    pub fn raw_os_code(self: Details) -> Option[isize] {
        self.raw_os_code_value
    }

    pub fn message(self: Details) -> string {
        self.message_value
    }
}

impl ToString for Details {
    fn to_string(self: Details) -> string {
        match self.context_value {
            Some(context) => self.operation_value + " " + context + ": " + self.message_value,
            None => self.operation_value + ": " + self.message_value,
        }
    }
}

impl Debug for Details {
    fn debug(self: Details) -> string {
        self.to_string()
    }
}

impl PartialEq for Details {
    fn eq(self: Details, other: Details) -> bool {
        self.kind_code_value == other.kind_code_value
            && self.operation_value == other.operation_value
            && self.context_value == other.context_value
            && self.raw_os_code_value == other.raw_os_code_value
            && self.message_value == other.message_value
    }
}

pub fn kind_from_code(code: isize) -> ErrorKind {
    match code {
        1 => ErrorKind::NotFound,
        2 => ErrorKind::PermissionDenied,
        3 => ErrorKind::AlreadyExists,
        4 => ErrorKind::InvalidInput,
        5 => ErrorKind::InvalidData,
        6 => ErrorKind::TimedOut,
        7 => ErrorKind::Interrupted,
        8 => ErrorKind::UnexpectedEof,
        9 => ErrorKind::WriteZero,
        10 => ErrorKind::BrokenPipe,
        11 => ErrorKind::WouldBlock,
        12 => ErrorKind::Unsupported,
        _ => ErrorKind::Other,
    }
}

pub fn kind_code(kind: ErrorKind) -> isize {
    match kind {
        ErrorKind::NotFound => 1,
        ErrorKind::PermissionDenied => 2,
        ErrorKind::AlreadyExists => 3,
        ErrorKind::InvalidInput => 4,
        ErrorKind::InvalidData => 5,
        ErrorKind::TimedOut => 6,
        ErrorKind::Interrupted => 7,
        ErrorKind::UnexpectedEof => 8,
        ErrorKind::WriteZero => 9,
        ErrorKind::BrokenPipe => 10,
        ErrorKind::WouldBlock => 11,
        ErrorKind::Unsupported => 12,
        ErrorKind::Other => 0,
    }
}
