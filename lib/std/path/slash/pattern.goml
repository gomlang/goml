package slash;

pub const DEFAULT_WORK_LIMIT: isize = 1000000;

pub const DEFAULT_PATTERN_LIMIT: isize = 4096;

pub enum MatchError {
    InvalidPattern(isize),
    PatternLimit,
    WorkLimit,
}

impl ToString for MatchError {
    fn to_string(self: MatchError) -> string {
        match self {
            MatchError::InvalidPattern(index) => f"invalid path pattern at character {index}",
            MatchError::PatternLimit => "path pattern exceeds its character limit",
            MatchError::WorkLimit => "path matching exceeds its work limit",
        }
    }
}

impl Debug for MatchError {
    fn debug(self: MatchError) -> string {
        self.to_string()
    }
}

impl PartialEq for MatchError {
    fn eq(self: MatchError, other: MatchError) -> bool {
        match (self, other) {
            (MatchError::InvalidPattern(left), MatchError::InvalidPattern(right)) => left == right,
            (MatchError::PatternLimit, MatchError::PatternLimit) => true,
            (MatchError::WorkLimit, MatchError::WorkLimit) => true,
            _ => false,
        }
    }
}

impl Eq for MatchError {}

enum Token {
    Literal(char),
    Any,
    Star,
    Class(Vec[(char, char)], bool),
}

pub struct Pattern {
    tokens: Vec[Token],
}

fn class_char(chars: Vec[char], start: isize) -> Result[(char, isize), MatchError] {
    let mut index = start;
    if index >= chars.len() || chars[index] == '-' || chars[index] == ']' {
        return Result::Err(MatchError::InvalidPattern(index))
    }
    if chars[index] == '\\' {
        index += 1;
    }
    if index >= chars.len() {
        return Result::Err(MatchError::InvalidPattern(index))
    }
    Result::Ok((chars[index], index + 1))
}

impl Pattern {
    pub fn compile(pattern: string) -> Result[Pattern, MatchError] {
        Pattern::compile_with_limit(pattern, DEFAULT_PATTERN_LIMIT)
    }

    pub fn compile_with_limit(pattern: string, limit: isize) -> Result[Pattern, MatchError] {
        if limit < 0 {
            return Result::Err(MatchError::PatternLimit)
        }
        let chars: Vec[char] = Vec::new();
        for value in pattern.chars() {
            if chars.len() >= limit {
                return Result::Err(MatchError::PatternLimit)
            }
            chars.push(value)
        }
        let tokens: Vec[Token] = Vec::new();
        let mut index = 0;
        while index < chars.len() {
            let value = chars[index];
            index += 1;
            if value == '*' {
                tokens.push(Token::Star);
                while index < chars.len() && chars[index] == '*' {
                    index += 1;
                }
            } else if value == '?' {
                tokens.push(Token::Any)
            } else if value == '\\' {
                if index >= chars.len() {
                    return Result::Err(MatchError::InvalidPattern(index))
                }
                tokens.push(Token::Literal(chars[index]));
                index += 1;
            } else if value == '[' {
                let negated = index < chars.len() && chars[index] == '^';
                if negated {
                    index += 1;
                }
                let ranges: Vec[(char, char)] = Vec::new();
                while index < chars.len() && (chars[index] != ']' || ranges.is_empty()) {
                    let (low, next) = class_char(chars, index)?;
                    index = next;
                    let mut high = low;
                    if index < chars.len() && chars[index] == '-' {
                        let (upper, next) = class_char(chars, index + 1)?;
                        high = upper;
                        index = next;
                    }
                    ranges.push((low, high));
                }
                if index >= chars.len() || ranges.is_empty() {
                    return Result::Err(MatchError::InvalidPattern(index))
                }
                index += 1;
                tokens.push(Token::Class(ranges, negated));
            } else {
                tokens.push(Token::Literal(value))
            }
        }
        Result::Ok(Pattern { tokens })
    }

    pub fn matches(self: Pattern, name: string) -> Result[bool, MatchError] {
        self.matches_with_limit(name, DEFAULT_WORK_LIMIT)
    }

    pub fn matches_with_limit(self: Pattern, name: string, limit: isize) -> Result[bool, MatchError] {
        if limit < 0 || self.tokens.len() > limit {
            return Result::Err(MatchError::WorkLimit)
        }
        let states: Vec[bool] = Vec::new();
        states.push(true);
        for token in self.tokens {
            states.push(
                match token {
                    Token::Star => states[states.len() - 1],
                    _ => false,
                },
            );
        }
        let mut remaining = limit - self.tokens.len();
        for value in name.chars() {
            if remaining == 0 {
                return Result::Err(MatchError::WorkLimit)
            }
            remaining -= 1;
            let mut diagonal = states[0];
            states[0] = false;
            for index in 0..self.tokens.len() {
                if remaining == 0 {
                    return Result::Err(MatchError::WorkLimit)
                }
                remaining -= 1;
                let previous = states[index + 1];
                states[index + 1] = match self.tokens[index] {
                    Token::Star => states[index] || (previous && value != '/'),
                    Token::Any => diagonal && value != '/',
                    Token::Literal(expected) => diagonal && expected == value,
                    Token::Class(ranges, negated) => {
                        let mut found = false;
                        for (low, high) in ranges {
                            if remaining == 0 {
                                return Result::Err(MatchError::WorkLimit)
                            }
                            remaining -= 1;
                            if low <= value && value <= high {
                                found = true;
                            }
                        }
                        diagonal && found != negated
                    },
                };
                diagonal = previous;
            }
        }
        Result::Ok(states[self.tokens.len()])
    }
}

pub fn matches(pattern: string, name: string) -> Result[bool, MatchError] {
    Pattern::compile(pattern)?.matches(name)
}
