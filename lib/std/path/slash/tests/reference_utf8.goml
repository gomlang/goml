package tests;

fn text_reference_decode_rune(input: Slice[byte]) -> (char, isize) {
    let width = text_reference_utf8_width(input);
    if width == 0 {
        return ('�', 0)
    }
    if width < 0 || input.len() < width || !text_reference_utf8_prefix(input, width) {
        return ('�', 1)
    }
    let mask = match width {
        1 => 0x7f,
        2 => 0x1f,
        3 => 0xf,
        _ => 7,
    };
    let mut value = input[0].to_u32() & mask;
    for index in 1..width {
        value = value * 64 + (input[index].to_u32() & 63);
    };
    (char_from_u32(value).unwrap_or('�'), width)
}

fn text_reference_utf8_prefix(input: Slice[byte], width: isize) -> bool {
    for index in 1..width {
        if index >= input.len() {
            break
        }
        let value = input[index];
        if value < 0x80 || value > 0xbf {
            return false
        }
        if index == 1 {
            if input[0] == 0xe0 && value < 0xa0 {
                return false
            }
            if input[0] == 0xed && value > 0x9f {
                return false
            }
            if input[0] == 0xf0 && value < 0x90 {
                return false
            }
            if input[0] == 0xf4 && value > 0x8f {
                return false
            }
        }
    }
    true
}

fn text_reference_utf8_width(input: Slice[byte]) -> isize {
    if input.len() == 0 {
        return 0
    }
    let lead = input[0];
    if lead < 0x80 {
        1
    } else if lead >= 0xc2 && lead <= 0xdf {
        2
    } else if lead >= 0xe0 && lead <= 0xef {
        3
    } else if lead >= 0xf0 && lead <= 0xf4 {
        4
    } else {
        -1
    }
}
