package tests;

use std::path::slash;
use std::rand;
use std::testing;

fn check_slash_paths(data: TextReferenceData) -> () {
    check_path_pattern_audit(data);
    let paths = Vec::from_array(
        [
            "",
            ".",
            "..",
            "/",
            "///",
            "a",
            "a/",
            "a//b",
            "a/./b/../c",
            "/../../a",
            "../../a/..",
            "../a/../../b",
            "a...",
            ".profile",
            "a.tar.gz",
            "a/.b/",
            "a.b/c",
            "C:\\a\\b",
            "//server/share",
            "世界/../文档/数据.goml",
            "/a//../..///",
            "a/../",
        ],
    );
    for value in paths {
        check_one_path(value)
    }
    assert_equal(slash::join(Vec::new()), "");
    assert_equal(slash::join(Vec::from_array(["", ""])), "");
    assert_equal(slash::join(Vec::from_array(["a", "/b", "..", "c"])), "a/c");
    assert_equal(slash::join(Vec::from_array(["", "/a", "../../b"])), "/b");
    assert_equal(slash::join(Vec::from_array(["a", ".."])), ".");
    for left in paths {
        for right in paths {
            let expected = if left == "" && right == "" {
                ""
            } else if left == "" {
                text_reference_path_clean(right)
            } else if right == "" {
                text_reference_path_clean(left)
            } else {
                text_reference_path_clean(left + "/" + right)
            };
            assert_equal(slash::join(Vec::from_array([left, right])), expected)
        }
    }
    let patterns = Vec::from_array(
        [
            "",
            "*",
            "**",
            "?",
            "a*",
            "*a",
            "a?b",
            "a*/b",
            "a*b?c*x",
            "a*b*c*d*e*/f",
            "[a-c]",
            "[^a-c]",
            "[z-a]",
            "[世界]",
            "[a-ζ]*",
            "*[a-ζ]",
            "[\\]a]",
            "[\\-x]",
            "[x\\-]",
            "[a/b]",
            "[^a]",
            "a\\*b",
            "\\?",
            "\\[",
            "\\\\",
            "[[]",
            "*/*",
            "*/?/*",
        ],
    );
    let names = Vec::from_array(
        [
            "",
            "a",
            "ab",
            "abc",
            "a*b",
            "a☺b",
            "a/b",
            "a/c/b",
            "abxbbxdbxebxczzx",
            "abxbbxdbxebxczzy",
            "axbxcxdxe/f",
            "axbxcxdxexxx/fff",
            "世界",
            "世",
            "α",
            "ζ",
            "A",
            "z",
            "x",
            "-",
            "]",
            "[",
            "?",
            "\\",
            "/",
            "ab/c",
            "a/b/c",
        ],
    );
    for pattern in patterns {
        for name in names {
            check_path_match(data, pattern, name)
        }
    }
    for pattern in Vec::from_array(
        ["[", "[^", "[]", "[]a]", "[-]", "[x-]", "[-x]", "\\", "[a-b-c]", "a/b[", "[a\\", "[a-"],
    ) {
        for name in names {
            testing::assert(slash::matches(pattern, name).is_err())
        }
    }
    let fragments = Vec::from_array(["a", "b", "/", ".", "..", "世", "\\", ""]);
    let pattern_fragments = Vec::from_array(
        ["a", "b", "*", "?", "/", "[a-b]", "[^a]", "世", "[世-界]"],
    );
    let mut seed: u64 = 719;
    for _ in 0..1024 {
        let mut path = "";
        let mut pattern = "";
        for _ in 0..8 {
            let word = rand::next_u64(seed);
            seed = word;
            path = path + fragments[(word % fragments.len().to_u64()).to_isize()];
            pattern = pattern
                + pattern_fragments[((word >> 16) % pattern_fragments.len().to_u64()).to_isize()];
        }
        check_one_path(path);
        check_path_match(data, pattern, path);
    }
    assert_equal(slash::Pattern::compile_with_limit("aa", 1).is_err(), true);
    assert_equal(slash::Pattern::compile_with_limit("世", 1).is_ok(), true);
    assert_equal(slash::Pattern::compile_with_limit("", 0).is_ok(), true);
    assert_equal(slash::Pattern::compile_with_limit("", -1).is_err(), true);
    testing::assert(slash::Pattern::compile("a".repeat(slash::DEFAULT_PATTERN_LIMIT + 1)).is_err());
    match slash::Pattern::compile("世[") {
        Result::Err(error) => assert_equal(error, slash::MatchError::InvalidPattern(2)),
        Result::Ok(_) => testing::fail("unclosed Unicode pattern accepted"),
    }
    let pattern = testing::expect_ok(slash::Pattern::compile("a*b"), "budget pattern");
    assert_equal(pattern.matches_with_limit("ab", 0), Result::Err(slash::MatchError::WorkLimit));
    assert_equal(pattern.matches_with_limit("ab", -1), Result::Err(slash::MatchError::WorkLimit));
    assert_equal(pattern.matches_with_limit("ab", 100), Result::Ok(true));
    assert_equal(pattern.matches("a/b"), Result::Ok(false));
    assert_equal(pattern.matches("ab"), Result::Ok(true));
    let empty = testing::expect_ok(slash::Pattern::compile(""), "empty pattern");
    assert_equal(empty.matches_with_limit("", 0), Result::Ok(true));
    assert_equal(empty.matches_with_limit("a", 0), Result::Err(slash::MatchError::WorkLimit));
    let singleton = testing::expect_ok(slash::Pattern::compile("?"), "single scalar pattern");
    assert_equal(singleton.matches_with_limit("世", 3), Result::Ok(true));
    assert_equal(singleton.matches_with_limit("世", 2), Result::Err(slash::MatchError::WorkLimit));
    let repeated = testing::expect_ok(
        slash::Pattern::compile("*a".repeat(100) + "b"),
        "adversarial pattern",
    );
    assert_equal(
        repeated.matches_with_limit("a".repeat(1000), 1000),
        Result::Err(slash::MatchError::WorkLimit),
    );
    assert_equal(
        testing::expect_ok(repeated.matches("a".repeat(1000)), "bounded polynomial match"),
        false,
    );
    assert_equal(slash::matches("[^a]", "/"), Result::Ok(true));
    assert_equal(slash::matches("?", "/"), Result::Ok(false));
    assert_equal(slash::matches("*", "/"), Result::Ok(false));
    assert_equal(slash::matches("[z-a]", "z"), Result::Ok(false));
}

fn check_one_path(value: string) -> () {
    assert_equal(slash::clean(value), text_reference_path_clean(value));
    assert_equal(slash::base(value), text_reference_path_base(value));
    assert_equal(slash::dir(value), text_reference_path_dir(value));
    assert_equal(slash::extension(value), text_reference_path_ext(value));
    assert_equal(slash::split(value), text_reference_path_split(value));
    assert_equal(slash::is_absolute(value), text_reference_path_is_abs(value));
    assert_equal(slash::clean(slash::clean(value)), slash::clean(value));
    let (directory, name) = slash::split(value);
    assert_equal(directory + name, value)
}

fn check_path_match(data: TextReferenceData, pattern: string, name: string) -> () {
    let (expected, valid) = text_expected_path_match(data, pattern, name);
    testing::assert(valid);
    let actual = testing::expect_ok(slash::matches(pattern, name), pattern);
    if actual != expected {
        testing::fail(f"pattern {pattern}, name {name}, actual {actual}, expected {expected}");
    }
    let compiled = testing::expect_ok(slash::Pattern::compile(pattern), "compile path pattern");
    assert_equal(testing::expect_ok(compiled.matches(name), "reusable pattern"), expected)
}

fn check_path_pattern_audit(data: TextReferenceData) -> () {
    let atoms = Vec::from_array(
        [
            ("", ""),
            ("a", "a"),
            ("*", "[^/]*"),
            ("?", "[^/]"),
            ("[a/]", "[a/]"),
            ("[^b]", "[^b]"),
            ("\\*", "\\*"),
            ("世", "世"),
            ("/", "/"),
        ],
    );
    let names = Vec::from_array(
        ["", "a", "b", "/", "*", "世", "aa", "ab", "a/", "/a", "a世", "世a", "世界", "a/b", "a*a", "世/界"],
    );
    for first in atoms {
        for second in atoms {
            for third in atoms {
                let pattern = first.0 + second.0 + third.0;
                let regex = first.1 + second.1 + third.1;
                for name in names {
                    let (expected, valid) = text_expected_path_regexp(data, regex, name);
                    testing::assert(valid);
                    let actual = testing::expect_ok(
                        slash::matches(pattern, name),
                        "scalar pattern match",
                    );
                    if actual != expected {
                        testing::fail(
                            f"scalar pattern {pattern}, name {name}, actual {actual}, expected {expected}",
                        );
                    }
                }
            }
        }
    }
    for prefix in["", "*", "a/", "世", "a?", "[a-z]"] {
        for suffix in["[", "[]", "[^]", "[a-]", "[a-b-c]", "\\"] {
            let pattern = prefix + suffix;
            for name in names {
                let (_, valid) = text_expected_path_match(data, pattern, name);
                testing::assert(!valid);
                testing::assert(slash::matches(pattern, name).is_err());
            }
        }
    }
    for (source, name, budget, expected) in[
        ("[abc]", "a", 6, true),
        ("[abc]", "z", 6, false),
        ("[a-c]", "b", 4, true),
        ("[^a-c]", "/", 4, true),
        ("**a", "a", 5, true),
        ("**", "", 1, true),
        ("", "世", 1, false),
    ] {
        let pattern = testing::expect_ok(slash::Pattern::compile(source), "budget pattern");
        let alias = pattern;
        assert_equal(
            pattern.matches_with_limit(name, budget - 1),
            Result::Err(slash::MatchError::WorkLimit),
        );
        assert_equal(alias.matches_with_limit(name, budget), Result::Ok(expected));
        assert_equal(pattern.matches_with_limit(name, budget), Result::Ok(expected));
    }
    let (reference_match, valid) = text_expected_path_match(data, "*[�]", "世");
    testing::assert(valid && reference_match);
    assert_equal(slash::matches("*[�]", "世"), Result::Ok(false));
    assert_equal(slash::matches("*[�]", "世�"), Result::Ok(true));
    let (reference_match, valid) = text_expected_path_match(data, "*??", "世");
    testing::assert(valid && reference_match);
    assert_equal(slash::matches("*??", "世"), Result::Ok(false));
    assert_equal(slash::matches("*??", "世界"), Result::Ok(true));
    let (reference_match, valid) = text_expected_path_match(data, "*[a/]*", "a/");
    testing::assert(valid && !reference_match);
    assert_equal(slash::matches("*[a/]*", "a/"), Result::Ok(true));
}
