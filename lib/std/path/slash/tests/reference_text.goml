package tests;

use std::testing;
use std::utf8;

fn text_reference_text_last_index(value: string, pattern: string) -> isize {
    text_reference_bytes_last_index(
        text_reference_text_bytes(value),
        text_reference_text_bytes(pattern),
    )
}

fn text_reference_text_bytes(value: string) -> Slice[byte] {
    value.to_bytes().as_slice()
}

fn text_reference_text_split(value: string, separator: string) -> Vec[string] {
    text_reference_text_split_n(value, separator, -1)
}

fn text_reference_text_split_n(value: string, separator: string, count: isize) -> Vec[string] {
    text_reference_text_parts(
        text_reference_bytes_split_n(
            text_reference_text_bytes(value),
            text_reference_text_bytes(separator),
            count,
        ),
    )
}

fn text_reference_text_parts(parts: Vec[Vec[byte]]) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    for part in parts {
        result.push(text_reference_text_string(part));
    }
    result
}

fn text_reference_text_string(value: Vec[byte]) -> string {
    testing::expect_ok(utf8::decode_slice(value.as_slice()), "reference string")
}
