package tests;

use std::unicode;

fn text_reference_hex(value: u32, width: isize) -> string {
    let alphabet = "0123456789abcdef";
    let mut result = "";
    for index in 0..width {
        let digit = (value >> ((width - index - 1) * 4).to_u32()) & 15;
        result += alphabet.byte_slice(digit.to_isize(), digit.to_isize() + 1);
    }
    result
}
