package tests;

fn text_reference_path_base(value: string) -> string {
    if value == "" {
        return "."
    }
    let mut end = value.byte_len();
    while end > 0 && value.byte_get(end - 1) == b'/' {
        end -= 1;
    }
    if end == 0 {
        "/"
    } else {
        text_reference_path_split(value.byte_slice(0, end)).1
    }
}

fn text_reference_path_split(value: string) -> (string, string) {
    let index = text_reference_text_last_index(value, "/") + 1;
    (value.byte_slice(0, index), value.byte_slice(index, value.byte_len()))
}

fn text_reference_path_clean(value: string) -> string {
    let absolute = text_reference_path_is_abs(value);
    let parts: Vec[string] = Vec::new();
    for part in text_reference_text_split(value, "/") {
        if part == "" || part == "." {
            continue
        }
        if part == ".." {
            if parts.len() > 0 && parts[parts.len() - 1] != ".." {
                parts.truncate(parts.len() - 1);
            } else if !absolute {
                parts.push(part);
            }
        } else {
            parts.push(part);
        }
    }
    let joined = parts.join("/");
    if absolute {
        "/" + joined
    } else if joined == "" {
        "."
    } else {
        joined
    }
}

fn text_reference_path_is_abs(value: string) -> bool {
    value.byte_len() > 0 && value.byte_get(0) == b'/'
}

fn text_reference_path_dir(value: string) -> string {
    text_reference_path_clean(text_reference_path_split(value).0)
}

fn text_reference_path_ext(value: string) -> string {
    let basename = text_reference_path_split(value).1;
    let index = text_reference_text_last_index(basename, ".");
    if index < 0 {
        ""
    } else {
        basename.byte_slice(index, basename.byte_len())
    }
}
