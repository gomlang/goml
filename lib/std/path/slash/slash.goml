package slash;

pub fn is_absolute(path: string) -> bool {
    path.starts_with("/")
}

pub fn clean(path: string) -> string {
    let rooted = is_absolute(path);
    let parts: Vec[string] = Vec::new();
    for part in path.split("/") {
        if part == "" || part == "." {
            continue
        }
        if part == ".." {
            if parts.len() > 0 && parts[parts.len() - 1] != ".." {
                let _ = parts.pop();
            } else if !rooted {
                parts.push(part)
            }
        } else {
            parts.push(part)
        }
    }
    let value = parts.join("/");
    if rooted {
        "/" + value
    } else if value == "" {
        "."
    } else {
        value
    }
}

pub fn join(parts: Vec[string]) -> string {
    let present: Vec[string] = Vec::new();
    for part in parts {
        if part != "" {
            present.push(part)
        }
    }
    if present.is_empty() {
        ""
    } else {
        clean(present.join("/"))
    }
}

pub fn split(path: string) -> (string, string) {
    let mut index = path.byte_len();
    while index > 0 {
        if path.byte_get(index - 1) == b'/' {
            return (path.byte_slice(0, index), path.byte_slice(index, path.byte_len()))
        }
        index -= 1;
    }
    let result = ("", path);
    result
}

pub fn base(path: string) -> string {
    if path == "" {
        return "."
    }
    let mut end = path.byte_len();
    while end > 0 && path.byte_get(end - 1) == b'/' {
        end -= 1;
    }
    if end == 0 {
        "/"
    } else {
        let (_, name) = split(path.byte_slice(0, end));
        name
    }
}

pub fn dir(path: string) -> string {
    let (directory, _) = split(path);
    clean(directory)
}

pub fn extension(path: string) -> string {
    let mut index = path.byte_len();
    while index > 0 {
        index -= 1;
        let value = path.byte_get(index);
        if value == b'/' {
            return ""
        }
        if value == b'.' {
            return path.byte_slice(index, path.byte_len())
        }
    }
    ""
}
