package tests;

use std::path;
use std::testing;

#[test]
fn volume_names_follow_the_host_path_rules() -> () {
    let cases = Vec::from_array(
        [
            ("", ""),
            ("relative/file", ""),
            ("/absolute/file", ""),
            ("C:", "C:"),
            ("C:\\directory\\file", "C:"),
            ("C:/directory/file", "C:"),
            ("//server/share/file", "\\\\server\\share"),
            ("//server\\share/file", "\\\\server\\share"),
            ("\\\\server\\share\\file", "\\\\server\\share"),
            ("\\\\?\\C:\\file", "\\\\?\\C:"),
            ("\\\\.\\UNC\\server\\share\\file", "\\\\.\\UNC\\server\\share"),
            ("\\\\.\\unc\\server\\share\\file", "\\\\.\\unc\\server\\share"),
            ("世界/文件", ""),
        ],
    );
    for (input, windows) in cases {
        let expected = if path::separator() == "\\" {
            windows
        } else {
            ""
        };
        testing::assert_eq(path::volume_name(input), expected)
    }
}
