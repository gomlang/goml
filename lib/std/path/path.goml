package path;

use module::internal::host;
use module::io;

fn trim_prefix(value: string, prefix: string) -> string {
    if value.starts_with(prefix) {
        value.byte_slice(prefix.byte_len(), value.byte_len())
    } else {
        value
    }
}

fn trim_suffix(value: string, suffix: string) -> string {
    if value.ends_with(suffix) {
        value.byte_slice(0, value.byte_len() - suffix.byte_len())
    } else {
        value
    }
}

pub fn join(base: string, child: string) -> string {
    host::path_join(base, child)
}

pub fn clean(path: string) -> string {
    host::path_clean(path)
}

pub fn is_absolute(path: string) -> bool {
    host::path_is_absolute(path)
}

pub fn parent(path: string) -> Option[string] {
    let (found, value) = host::path_parent(path);
    if found {
        Option::Some(value)
    } else {
        Option::None
    }
}

pub fn file_name(path: string) -> Option[string] {
    let (found, value) = host::path_file_name(path);
    if found {
        Option::Some(value)
    } else {
        Option::None
    }
}

pub fn extension(path: string) -> Option[string] {
    let (found, value) = host::path_extension(path);
    if found {
        Option::Some(trim_prefix(value, "."))
    } else {
        Option::None
    }
}

pub fn file_stem(path: string) -> Option[string] {
    match file_name(path) {
        Some(name) => match extension(name) {
            Some(value) => Option::Some(trim_suffix(name, "." + value)),
            None => Option::Some(name),
        },
        None => Option::None,
    }
}

pub fn with_extension(path: string, new_extension: string) -> string {
    let without = match file_name(path) {
        Some(name) => match extension(name) {
            Some(value) => trim_suffix(path, "." + value),
            None => path,
        },
        None => path,
    };
    let normalized = trim_prefix(new_extension, ".");
    if normalized == "" {
        without
    } else {
        without + "." + normalized
    }
}

pub fn absolute_structured(path: string) -> Result[string, Error] {
    let (ok, value, err) = host::path_absolute(path);
    if ok {
        Result::Ok(value)
    } else {
        Result::Err(
            Error::new(io::ErrorKind::Other, "absolute path", Option::Some(path), Option::None, err),
        )
    }
}

#[go_ffi("path/filepath", "VolumeName")]
extern fn volume_name_ffi(path: string) -> string;

pub fn volume_name(path: string) -> string {
    volume_name_ffi(path)
}

pub fn separator() -> string {
    host::path_separator()
}

pub fn is_separator(value: char) -> bool {
    value == '/' || value == '\\'
}

fn is_separator_byte(value: byte) -> bool {
    value == b'/' || value == b'\\'
}

pub fn components(path: string) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    let mut start = 0;
    let mut index = 0;
    while index <= path.byte_len() {
        if index == path.byte_len() || is_separator_byte(path.byte_get(index)) {
            if index > start {
                result.push(path.byte_slice(start, index))
            }
            start = index + 1;
        }
        index += 1;
    }
    result
}

fn is_ascii_letter(value: byte) -> bool {
    value >= b'a' && value <= b'z' || value >= b'A' && value <= b'Z'
}

pub fn windows_prefix(path: string) -> Option[string] {
    let length = path.byte_len();
    if length >= 2 && is_ascii_letter(path.byte_get(0)) && path.byte_get(1) == b':' {
        Option::Some(path.byte_slice(0, 2))
    } else if length >= 2 && is_separator_byte(path.byte_get(0))
        && is_separator_byte(path.byte_get(1)) {
        let mut separators = 0;
        let mut index = 2;
        while index < length {
            if is_separator_byte(path.byte_get(index)) {
                separators += 1;
                if separators == 2 {
                    return Option::Some(path.byte_slice(0, index))
                }
            }
            index += 1;
        }
        if separators == 1 && index > 2 {
            Option::Some(path)
        } else {
            Option::None
        }
    } else {
        Option::None
    }
}

pub fn relative(base: string, target: string) -> Result[string, Error] {
    let (ok, value, message) = host::path_relative(base, target);
    if ok {
        Result::Ok(value)
    } else {
        Result::Err(
            Error::new(
                io::ErrorKind::InvalidInput,
                "relative path",
                Option::Some(base + " -> " + target),
                Option::None,
                message,
            ),
        )
    }
}
