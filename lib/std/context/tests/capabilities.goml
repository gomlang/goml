package tests;

use std::context;
use std::net;
use std::task;
use std::testing;
use std::time;

#[test]
fn context_lifecycle() -> () {
    let before = task::active_scope_count();
    context::with_cancel(
        context::Context::background(),
        |parent, cancel| {
            context::with_cancel(
                parent,
                |child, _| {
                    cancel.cancel();
                    let _ = child.done().recv();
                    testing::assert(child.check().is_err());
                },
            );
        },
    );
    context::with_timeout(
        context::Context::background(),
        time::Duration::zero(),
        |ctx, _| {
            testing::assert(ctx.check().is_err());
            testing::assert(ctx.sleep(time::Duration::from_seconds(1)).is_err());
            testing::assert(net::resolve_with("localhost", 80, ctx).is_err());
        },
    );
    context::with_timeout(
        context::Context::background(),
        time::Duration::from_milliseconds(10),
        |parent, _| {
            context::with_timeout(
                parent,
                time::Duration::from_seconds(1),
                |child, _| {
                    let _ = child.done().recv();
                    testing::assert_eq(
                        testing::expect_some(child.error(), "deadline").to_string(),
                        "deadline exceeded",
                    );
                },
            );
        },
    );
    context::with_timeout(
        context::Context::background(),
        time::Duration::from_milliseconds(1),
        |ctx, cancel| {
            cancel.cancel();
            cancel.cancel();
            time::sleep(time::Duration::from_milliseconds(3));
            testing::assert_eq(
                testing::expect_some(ctx.error(), "first cause").to_string(),
                "operation cancelled",
            );
        },
    );
    testing::assert_eq(task::active_scope_count(), before);
    println("context ok")
}
