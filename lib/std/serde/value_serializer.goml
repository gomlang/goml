package serde;

enum ValueSerializeFrame {
    Optional {
        values: Vec[Value],
        present: bool,
        ready: Ref[bool],
    },
    Sequence {
        values: Vec[Value],
        length: isize,
        ready: Ref[bool],
    },
    Tuple {
        values: Vec[Value],
        length: isize,
        ready: Ref[bool],
    },
    Map {
        entries: Vec[(Value, Value)],
        length: isize,
        state: Ref[isize],
        key: Ref[Option[Value]],
    },
    Struct {
        fields: Vec[(string, Value)],
        length: isize,
        pending: Ref[Option[string]],
    },
    Variant {
        index: isize,
        name: string,
        kind: isize,
        fields: Vec[(string, Value)],
        length: isize,
        pending: Ref[Option[string]],
    },
}

pub struct ValueSerializer {
    frames: Vec[ValueSerializeFrame],
    result: Ref[Option[Value]],
}

pub fn value_serializer() -> ValueSerializer {
    ValueSerializer { frames: Vec::new(), result: Ref::new(Option::None) }
}

pub fn finish_value_serializer(serializer: ValueSerializer) -> Result[Value, string] {
    if !serializer.frames.is_empty() {
        Err("serialization ended inside a compound value")
    } else {
        serializer.result.get().ok_or("serialization produced no value")
    }
}

fn value_slot_ready(serializer: ValueSerializer) -> bool {
    if serializer.frames.is_empty() {
        serializer.result.get().is_none()
    } else {
        match serializer.frames[serializer.frames.len() - 1] {
            ValueSerializeFrame::Optional { values: _, present: _, ready } => ready.get(),
            ValueSerializeFrame::Sequence { values: _, length: _, ready } => ready.get(),
            ValueSerializeFrame::Tuple { values: _, length: _, ready } => ready.get(),
            ValueSerializeFrame::Map { entries: _, length: _, state, key: _ } => {
                state.get() == 1 || state.get() == 2
            },
            ValueSerializeFrame::Struct { fields: _, length: _, pending } => {
                pending.get().is_some()
            },
            ValueSerializeFrame::Variant {
                index: _,
                name: _,
                kind: _,
                fields: _,
                length: _,
                pending,
            } => pending.get().is_some(),
        }
    }
}

fn append_serialized_value(serializer: ValueSerializer, value: Value) -> Result[(), string] {
    if serializer.frames.is_empty() {
        if serializer.result.get().is_some() {
            Err("serialization produced more than one root value")
        } else {
            serializer.result.set(Option::Some(value));
            Ok(())
        }
    } else {
        match serializer.frames[serializer.frames.len() - 1] {
            ValueSerializeFrame::Optional { values, present: _, ready } => if ready.get() {
                values.push(value);
                ready.set(false);
                Ok(())
            } else {
                Err("optional value is not expecting an item")
            },
            ValueSerializeFrame::Sequence { values, length: _, ready } => if ready.get() {
                values.push(value);
                ready.set(false);
                Ok(())
            } else {
                Err("sequence is not expecting an element")
            },
            ValueSerializeFrame::Tuple { values, length: _, ready } => if ready.get() {
                values.push(value);
                ready.set(false);
                Ok(())
            } else {
                Err("tuple is not expecting an element")
            },
            ValueSerializeFrame::Map { entries, length: _, state, key } => if state.get() == 1 {
                key.set(Option::Some(value));
                state.set(0);
                Ok(())
            } else if state.get() == 2 {
                match key.get() {
                    Some(encoded_key) => {
                        entries.push((encoded_key, value));
                        key.set(Option::None);
                        state.set(0);
                        Ok(())
                    },
                    None => Err("map value has no key"),
                }
            } else {
                Err("map is not expecting a value")
            },
            ValueSerializeFrame::Struct { fields, length: _, pending } => match pending.get() {
                Some(name) => {
                    fields.push((name, value));
                    pending.set(Option::None);
                    Ok(())
                },
                None => Err("struct is not expecting a field value"),
            },
            ValueSerializeFrame::Variant { index: _, name: _, kind: _, fields, length: _, pending } => match pending.get() {
                Some(name) => {
                    fields.push((name, value));
                    pending.set(Option::None);
                    Ok(())
                },
                None => Err("variant is not expecting a field value"),
            },
        }
    }
}

fn begin_value_frame(serializer: ValueSerializer, frame: ValueSerializeFrame) -> Result[(), string] {
    if value_slot_ready(serializer) {
        serializer.frames.push(frame);
        Ok(())
    } else {
        Err("serializer is not expecting a value")
    }
}

impl Serializer for ValueSerializer {
    fn serialize_unit(self: ValueSerializer) -> Result[(), string] {
        append_serialized_value(self, Value::Unit)
    }

    fn serialize_bool(self: ValueSerializer, value: bool) -> Result[(), string] {
        append_serialized_value(self, Value::Bool(value))
    }

    fn serialize_int(self: ValueSerializer, value: isize) -> Result[(), string] {
        append_serialized_value(self, Value::Int(value))
    }

    fn serialize_int8(self: ValueSerializer, value: i8) -> Result[(), string] {
        append_serialized_value(self, Value::Int8(value))
    }

    fn serialize_int16(self: ValueSerializer, value: i16) -> Result[(), string] {
        append_serialized_value(self, Value::Int16(value))
    }

    fn serialize_int32(self: ValueSerializer, value: i32) -> Result[(), string] {
        append_serialized_value(self, Value::Int32(value))
    }

    fn serialize_int64(self: ValueSerializer, value: i64) -> Result[(), string] {
        append_serialized_value(self, Value::Int64(value))
    }

    fn serialize_uint(self: ValueSerializer, value: usize) -> Result[(), string] {
        append_serialized_value(self, Value::Uint(value))
    }

    fn serialize_uint8(self: ValueSerializer, value: u8) -> Result[(), string] {
        append_serialized_value(self, Value::Uint8(value))
    }

    fn serialize_uint16(self: ValueSerializer, value: u16) -> Result[(), string] {
        append_serialized_value(self, Value::Uint16(value))
    }

    fn serialize_uint32(self: ValueSerializer, value: u32) -> Result[(), string] {
        append_serialized_value(self, Value::Uint32(value))
    }

    fn serialize_uint64(self: ValueSerializer, value: u64) -> Result[(), string] {
        append_serialized_value(self, Value::Uint64(value))
    }

    fn serialize_float32(self: ValueSerializer, value: f32) -> Result[(), string] {
        append_serialized_value(self, Value::Float32(value))
    }

    fn serialize_float64(self: ValueSerializer, value: f64) -> Result[(), string] {
        append_serialized_value(self, Value::Float64(value))
    }

    fn serialize_number(self: ValueSerializer, value: string) -> Result[(), string] {
        append_serialized_value(self, Value::Number(value))
    }

    fn serialize_string(self: ValueSerializer, value: string) -> Result[(), string] {
        append_serialized_value(self, Value::String(value))
    }

    fn serialize_char(self: ValueSerializer, value: char) -> Result[(), string] {
        append_serialized_value(self, Value::Char(value))
    }

    fn serialize_bytes(self: ValueSerializer, value: Slice[byte]) -> Result[(), string] {
        let values: Vec[byte] = Vec::with_capacity(value.len());
        for item in value {
            values.push(item)
        }
        append_serialized_value(self, Value::Binary(values))
    }

    fn serialize_extension(self: ValueSerializer, tag: i8, data: Slice[byte]) -> Result[(), string] {
        let values: Vec[byte] = Vec::with_capacity(data.len());
        for item in data {
            values.push(item)
        }
        append_serialized_value(self, Value::Extension { tag, data: values })
    }

    fn begin_optional(self: ValueSerializer, present: bool) -> Result[(), string] {
        begin_value_frame(
            self,
            ValueSerializeFrame::Optional { values: Vec::new(), present, ready: Ref::new(present) },
        )
    }

    fn end_optional(self: ValueSerializer) -> Result[(), string] {
        if self.frames.is_empty() {
            return Err("end_optional without begin_optional")
        }
        match self.frames[self.frames.len() - 1] {
            ValueSerializeFrame::Optional { values, present, ready } => {
                if ready.get()
                    || values.len()
                        != if present {
                            1
                        } else {
                            0
                        } {
                    return Err("optional value has the wrong number of items")
                }
                let _ = self.frames.pop();
                append_serialized_value(self, Value::Optional(values))
            },
            _ => Err("end_optional does not match the active compound value"),
        }
    }

    fn begin_sequence(self: ValueSerializer, length: isize) -> Result[(), string] {
        if length < 0 {
            Err("sequence length cannot be negative")
        } else {
            begin_value_frame(
                self,
                ValueSerializeFrame::Sequence {
                    values: Vec::with_capacity(length),
                    length,
                    ready: Ref::new(false),
                },
            )
        }
    }

    fn begin_sequence_element(self: ValueSerializer, index: isize) -> Result[(), string] {
        if self.frames.is_empty() {
            return Err("sequence element without sequence")
        }
        match self.frames[self.frames.len() - 1] {
            ValueSerializeFrame::Sequence { values, length, ready } => if ready.get() {
                Err("previous sequence element has no value")
            } else if index != values.len() || index >= length {
                Err("sequence element index is out of order")
            } else {
                ready.set(true);
                Ok(())
            },
            _ => Err("sequence element outside a sequence"),
        }
    }

    fn end_sequence(self: ValueSerializer) -> Result[(), string] {
        if self.frames.is_empty() {
            return Err("end_sequence without begin_sequence")
        }
        match self.frames[self.frames.len() - 1] {
            ValueSerializeFrame::Sequence { values, length, ready } => {
                if ready.get() || values.len() != length {
                    return Err("sequence length does not match its elements")
                }
                let _ = self.frames.pop();
                append_serialized_value(self, Value::Sequence(values))
            },
            _ => Err("end_sequence does not match the active compound value"),
        }
    }

    fn begin_tuple(self: ValueSerializer, length: isize) -> Result[(), string] {
        if length < 0 {
            Err("tuple length cannot be negative")
        } else {
            begin_value_frame(
                self,
                ValueSerializeFrame::Tuple {
                    values: Vec::with_capacity(length),
                    length,
                    ready: Ref::new(false),
                },
            )
        }
    }

    fn begin_tuple_element(self: ValueSerializer, index: isize) -> Result[(), string] {
        if self.frames.is_empty() {
            return Err("tuple element without tuple")
        }
        match self.frames[self.frames.len() - 1] {
            ValueSerializeFrame::Tuple { values, length, ready } => if ready.get() {
                Err("previous tuple element has no value")
            } else if index != values.len() || index >= length {
                Err("tuple element index is out of order")
            } else {
                ready.set(true);
                Ok(())
            },
            _ => Err("tuple element outside a tuple"),
        }
    }

    fn end_tuple(self: ValueSerializer) -> Result[(), string] {
        if self.frames.is_empty() {
            return Err("end_tuple without begin_tuple")
        }
        match self.frames[self.frames.len() - 1] {
            ValueSerializeFrame::Tuple { values, length, ready } => {
                if ready.get() || values.len() != length {
                    return Err("tuple length does not match its elements")
                }
                let _ = self.frames.pop();
                append_serialized_value(self, Value::Tuple(values))
            },
            _ => Err("end_tuple does not match the active compound value"),
        }
    }

    fn begin_map(self: ValueSerializer, length: isize) -> Result[(), string] {
        if length < 0 {
            Err("map length cannot be negative")
        } else {
            begin_value_frame(
                self,
                ValueSerializeFrame::Map {
                    entries: Vec::with_capacity(length),
                    length,
                    state: Ref::new(0),
                    key: Ref::new(Option::None),
                },
            )
        }
    }

    fn begin_map_key(self: ValueSerializer, index: isize) -> Result[(), string] {
        if self.frames.is_empty() {
            return Err("map key without map")
        }
        match self.frames[self.frames.len() - 1] {
            ValueSerializeFrame::Map { entries, length, state, key } => if state.get() != 0
                || key.get().is_some() {
                Err("previous map entry is incomplete")
            } else if index != entries.len() || index >= length {
                Err("map entry index is out of order")
            } else {
                state.set(1);
                Ok(())
            },
            _ => Err("map key outside a map"),
        }
    }

    fn begin_map_value(self: ValueSerializer, index: isize) -> Result[(), string] {
        if self.frames.is_empty() {
            return Err("map value without map")
        }
        match self.frames[self.frames.len() - 1] {
            ValueSerializeFrame::Map { entries, length: _, state, key } => if state.get() != 0
                || key.get().is_none() {
                Err("map value has no completed key")
            } else if index != entries.len() {
                Err("map entry index is out of order")
            } else {
                state.set(2);
                Ok(())
            },
            _ => Err("map value outside a map"),
        }
    }

    fn end_map(self: ValueSerializer) -> Result[(), string] {
        if self.frames.is_empty() {
            return Err("end_map without begin_map")
        }
        match self.frames[self.frames.len() - 1] {
            ValueSerializeFrame::Map { entries, length, state, key } => {
                if state.get() != 0 || key.get().is_some() || entries.len() != length {
                    return Err("map length does not match its entries")
                }
                let _ = self.frames.pop();
                append_serialized_value(self, Value::Map(entries))
            },
            _ => Err("end_map does not match the active compound value"),
        }
    }

    fn begin_struct(self: ValueSerializer, name: string, fields: isize) -> Result[(), string] {
        if fields < 0 {
            Err("struct field count cannot be negative")
        } else {
            begin_value_frame(
                self,
                ValueSerializeFrame::Struct {
                    fields: Vec::with_capacity(fields),
                    length: fields,
                    pending: Ref::new(Option::None),
                },
            )
        }
    }

    fn begin_struct_field(self: ValueSerializer, index: isize, name: string) -> Result[(), string] {
        if self.frames.is_empty() {
            return Err("struct field without struct")
        }
        match self.frames[self.frames.len() - 1] {
            ValueSerializeFrame::Struct { fields, length, pending } => if pending.get().is_some() {
                Err("previous struct field has no value")
            } else if index != fields.len() || index >= length {
                Err("struct field index is out of order")
            } else {
                pending.set(Option::Some(name));
                Ok(())
            },
            _ => Err("struct field outside a struct"),
        }
    }

    fn end_struct(self: ValueSerializer) -> Result[(), string] {
        if self.frames.is_empty() {
            return Err("end_struct without begin_struct")
        }
        match self.frames[self.frames.len() - 1] {
            ValueSerializeFrame::Struct { fields, length, pending } => {
                if pending.get().is_some() || fields.len() != length {
                    return Err("struct field count does not match its values")
                }
                let _ = self.frames.pop();
                append_serialized_value(self, Value::Struct(fields))
            },
            _ => Err("end_struct does not match the active compound value"),
        }
    }

    fn begin_variant(
        self: ValueSerializer,
        enum_name: string,
        index: isize,
        name: string,
        kind: isize,
        fields: isize,
    ) -> Result[(), string] {
        if fields < 0 {
            Err("variant field count cannot be negative")
        } else {
            begin_value_frame(
                self,
                ValueSerializeFrame::Variant {
                    index,
                    name,
                    kind,
                    fields: Vec::with_capacity(fields),
                    length: fields,
                    pending: Ref::new(Option::None),
                },
            )
        }
    }

    fn begin_variant_field(self: ValueSerializer, index: isize, name: string) -> Result[(), string] {
        if self.frames.is_empty() {
            return Err("variant field without variant")
        }
        match self.frames[self.frames.len() - 1] {
            ValueSerializeFrame::Variant { index: _, name: _, kind: _, fields, length, pending } => if pending.get().is_some() {
                Err("previous variant field has no value")
            } else if index != fields.len() || index >= length {
                Err("variant field index is out of order")
            } else {
                pending.set(Option::Some(name));
                Ok(())
            },
            _ => Err("variant field outside a variant"),
        }
    }

    fn end_variant(self: ValueSerializer) -> Result[(), string] {
        if self.frames.is_empty() {
            return Err("end_variant without begin_variant")
        }
        match self.frames[self.frames.len() - 1] {
            ValueSerializeFrame::Variant { index, name, kind, fields, length, pending } => {
                if pending.get().is_some() || fields.len() != length {
                    return Err("variant field count does not match its values")
                }
                let _ = self.frames.pop();
                append_serialized_value(self, Value::Variant { index, name, kind, fields })
            },
            _ => Err("end_variant does not match the active compound value"),
        }
    }
}
