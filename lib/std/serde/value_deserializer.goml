package serde;

use module::num;

fn parse_int(value: string) -> Result[isize, string] {
    num::parse_int_structured(value).map_err(|error| error.to_string())
}

fn parse_uint(value: string) -> Result[usize, string] {
    num::parse_uint_structured(value).map_err(|error| error.to_string())
}

fn parse_float32(value: string) -> Result[f32, string] {
    num::parse_float32_structured(value).map_err(|error| error.to_string())
}

fn parse_float64(value: string) -> Result[f64, string] {
    num::parse_float64_structured(value).map_err(|error| error.to_string())
}

enum ValueDeserializeFrame {
    Optional,
    Sequence {
        values: Vec[Value],
        index: Ref[isize],
    },
    Tuple {
        values: Vec[Value],
        index: Ref[isize],
    },
    Map {
        entries: Vec[(Value, Value)],
        index: Ref[isize],
        state: Ref[isize],
    },
    Struct {
        fields: Vec[(string, Value)],
        index: Ref[isize],
    },
    Variant {
        kind: isize,
        fields: Vec[(string, Value)],
        index: Ref[isize],
        begun: Ref[bool],
    },
}

pub struct ValueDeserializer {
    current: Ref[Option[Value]],
    frames: Vec[ValueDeserializeFrame],
    track_unused: bool,
    unused_fields: Vec[(string, Value)],
}

pub fn value_deserializer(value: Value) -> ValueDeserializer {
    ValueDeserializer {
        current: Ref::new(Option::Some(value)),
        frames: Vec::new(),
        track_unused: false,
        unused_fields: Vec::new(),
    }
}

pub fn finish_value_deserializer(deserializer: ValueDeserializer) -> Result[(), string] {
    if !deserializer.frames.is_empty() {
        Err("deserialization ended inside a compound value")
    } else if deserializer.current.get().is_some() {
        Err("deserialization did not consume the value")
    } else {
        Ok(())
    }
}

fn take_deserializer_value(deserializer: ValueDeserializer) -> Result[Value, string] {
    match deserializer.current.get() {
        Some(value) => {
            deserializer.current.set(Option::None);
            Ok(value)
        },
        None => Err("deserializer is not positioned at a value"),
    }
}

fn set_deserializer_value(deserializer: ValueDeserializer, value: Value) -> Result[(), string] {
    if deserializer.current.get().is_some() {
        Err("previous deserializer value was not consumed")
    } else {
        deserializer.current.set(Option::Some(value));
        Ok(())
    }
}

fn pop_value_deserializer_frame(deserializer: ValueDeserializer) -> () {
    let _ = deserializer.frames.pop();
}

fn deserialize_number_value(value: Value) -> Result[string, string] {
    match value {
        Number(value) => Ok(value),
        Int(value) => Ok(value.to_string()),
        Int8(value) => Ok(value.to_string()),
        Int16(value) => Ok(value.to_string()),
        Int32(value) => Ok(value.to_string()),
        Int64(value) => Ok(value.to_string()),
        Uint(value) => Ok(value.to_string()),
        Uint8(value) => Ok(value.to_string()),
        Uint16(value) => Ok(value.to_string()),
        Uint32(value) => Ok(value.to_string()),
        Uint64(value) => Ok(value.to_string()),
        Float32(value) => Ok(value.to_string()),
        Float64(value) => Ok(value.to_string()),
        _ => Err("expected number"),
    }
}

fn deserialize_bytes_value(value: Value) -> Result[Vec[byte], string] {
    match value {
        Binary(data) => Ok(data.copy()),
        Value::Sequence(values) => {
            let bytes: Vec[byte] = Vec::with_capacity(values.len());
            for value in values {
                match value {
                    Uint8(value) => bytes.push(value),
                    Number(value) => {
                        let parsed = parse_uint(value)?;
                        if parsed > 255 {
                            return Err("u8 is out of range")
                        } else {
                            bytes.push(parsed.to_u8())
                        }
                    },
                    _ => return Err("expected u8"),
                }
            }
            Ok(bytes)
        },
        _ => Err("expected byte sequence"),
    }
}

impl Deserializer for ValueDeserializer {
    fn deserialize_any(self: ValueDeserializer) -> Result[Value, string] {
        take_deserializer_value(self)
    }

    fn deserialize_unit(self: ValueDeserializer) -> Result[(), string] {
        match take_deserializer_value(self)? {
            Value::Unit => Ok(()),
            _ => Err("expected ()"),
        }
    }

    fn deserialize_bool(self: ValueDeserializer) -> Result[bool, string] {
        match take_deserializer_value(self)? {
            Value::Bool(value) => Ok(value),
            _ => Err("expected bool"),
        }
    }

    fn deserialize_int(self: ValueDeserializer) -> Result[isize, string] {
        match take_deserializer_value(self)? {
            Int(value) => Ok(value),
            Number(value) => parse_int(value),
            _ => Err("expected isize"),
        }
    }

    fn deserialize_int8(self: ValueDeserializer) -> Result[i8, string] {
        match take_deserializer_value(self)? {
            Int8(value) => Ok(value),
            Number(value) => {
                let parsed = parse_int(value)?;
                if parsed < -128 || parsed > 127 {
                    Err("i8 is out of range")
                } else {
                    Ok(parsed.to_i8())
                }
            },
            _ => Err("expected i8"),
        }
    }

    fn deserialize_int16(self: ValueDeserializer) -> Result[i16, string] {
        match take_deserializer_value(self)? {
            Int16(value) => Ok(value),
            Number(value) => {
                let parsed = parse_int(value)?;
                if parsed < -32768 || parsed > 32767 {
                    Err("i16 is out of range")
                } else {
                    Ok(parsed.to_i16())
                }
            },
            _ => Err("expected i16"),
        }
    }

    fn deserialize_int32(self: ValueDeserializer) -> Result[i32, string] {
        match take_deserializer_value(self)? {
            Int32(value) => Ok(value),
            Number(value) => {
                let parsed = parse_int(value)?;
                if parsed < -2147483648 || parsed > 2147483647 {
                    Err("i32 is out of range")
                } else {
                    Ok(parsed.to_i32())
                }
            },
            _ => Err("expected i32"),
        }
    }

    fn deserialize_int64(self: ValueDeserializer) -> Result[i64, string] {
        match take_deserializer_value(self)? {
            Int64(value) => Ok(value),
            Number(value) => parse_int(value).map(|value| value.to_i64()),
            _ => Err("expected i64"),
        }
    }

    fn deserialize_uint(self: ValueDeserializer) -> Result[usize, string] {
        match take_deserializer_value(self)? {
            Uint(value) => Ok(value),
            Number(value) => parse_uint(value),
            _ => Err("expected usize"),
        }
    }

    fn deserialize_uint8(self: ValueDeserializer) -> Result[u8, string] {
        match take_deserializer_value(self)? {
            Uint8(value) => Ok(value),
            Number(value) => {
                let parsed = parse_uint(value)?;
                if parsed > 255 {
                    Err("u8 is out of range")
                } else {
                    Ok(parsed.to_u8())
                }
            },
            _ => Err("expected u8"),
        }
    }

    fn deserialize_uint16(self: ValueDeserializer) -> Result[u16, string] {
        match take_deserializer_value(self)? {
            Uint16(value) => Ok(value),
            Number(value) => {
                let parsed = parse_uint(value)?;
                if parsed > 65535 {
                    Err("u16 is out of range")
                } else {
                    Ok(parsed.to_u16())
                }
            },
            _ => Err("expected u16"),
        }
    }

    fn deserialize_uint32(self: ValueDeserializer) -> Result[u32, string] {
        match take_deserializer_value(self)? {
            Uint32(value) => Ok(value),
            Number(value) => {
                let parsed = parse_uint(value)?;
                if parsed > 4294967295 {
                    Err("u32 is out of range")
                } else {
                    Ok(parsed.to_u32())
                }
            },
            _ => Err("expected u32"),
        }
    }

    fn deserialize_uint64(self: ValueDeserializer) -> Result[u64, string] {
        match take_deserializer_value(self)? {
            Uint64(value) => Ok(value),
            Number(value) => parse_uint(value).map(|value| value.to_u64()),
            _ => Err("expected u64"),
        }
    }

    fn deserialize_float32(self: ValueDeserializer) -> Result[f32, string] {
        match take_deserializer_value(self)? {
            Float32(value) => Ok(value),
            Number(value) => parse_float32(value),
            _ => Err("expected f32"),
        }
    }

    fn deserialize_float64(self: ValueDeserializer) -> Result[f64, string] {
        match take_deserializer_value(self)? {
            Float64(value) => Ok(value),
            Number(value) => parse_float64(value),
            _ => Err("expected f64"),
        }
    }

    fn deserialize_number(self: ValueDeserializer) -> Result[string, string] {
        deserialize_number_value(take_deserializer_value(self)?)
    }

    fn deserialize_string(self: ValueDeserializer) -> Result[string, string] {
        match take_deserializer_value(self)? {
            Value::String(value) => Ok(value),
            _ => Err("expected string"),
        }
    }

    fn deserialize_char(self: ValueDeserializer) -> Result[char, string] {
        match take_deserializer_value(self)? {
            Value::Char(value) => Ok(value),
            Value::String(value) => if value.len() == 1 {
                Ok(value.get(0))
            } else {
                Err("expected one-character string")
            },
            _ => Err("expected char"),
        }
    }

    fn deserialize_bytes(self: ValueDeserializer) -> Result[Vec[byte], string] {
        deserialize_bytes_value(take_deserializer_value(self)?)
    }

    fn deserialize_extension(self: ValueDeserializer) -> Result[(i8, Vec[byte]), string] {
        match take_deserializer_value(self)? {
            Extension { tag, data } => Ok((tag, data.copy())),
            _ => Err("expected extension value"),
        }
    }

    fn begin_optional(self: ValueDeserializer) -> Result[bool, string] {
        let value = take_deserializer_value(self)?;
        match value {
            Value::Optional(values) => if values.is_empty() {
                self.frames.push(ValueDeserializeFrame::Optional);
                Ok(false)
            } else if values.len() == 1 {
                self.frames.push(ValueDeserializeFrame::Optional);
                set_deserializer_value(self, values[0])?;
                Ok(true)
            } else {
                Err("optional value contains more than one item")
            },
            Value::Unit => {
                self.frames.push(ValueDeserializeFrame::Optional);
                Ok(false)
            },
            value => {
                self.frames.push(ValueDeserializeFrame::Optional);
                set_deserializer_value(self, value)?;
                Ok(true)
            },
        }
    }

    fn end_optional(self: ValueDeserializer) -> Result[(), string] {
        if self.frames.is_empty() {
            return Err("end_optional without begin_optional")
        } else if self.current.get().is_some() {
            return Err("optional item was not consumed")
        }
        match self.frames[self.frames.len() - 1] {
            ValueDeserializeFrame::Optional => {
                pop_value_deserializer_frame(self);
                Ok(())
            },
            _ => Err("end_optional does not match the active compound value"),
        }
    }

    fn begin_sequence(self: ValueDeserializer) -> Result[Option[isize], string] {
        match take_deserializer_value(self)? {
            Value::Sequence(values) => {
                let length = values.len();
                self.frames.push(ValueDeserializeFrame::Sequence { values, index: Ref::new(0) });
                Ok(Option::Some(length))
            },
            _ => Err("expected sequence"),
        }
    }

    fn next_sequence_element(self: ValueDeserializer) -> Result[bool, string] {
        if self.frames.is_empty() {
            return Err("sequence element without sequence")
        } else if self.current.get().is_some() {
            return Err("previous sequence element was not consumed")
        }
        match self.frames[self.frames.len() - 1] {
            ValueDeserializeFrame::Sequence { values, index } => if index.get() >= values.len() {
                Ok(false)
            } else {
                set_deserializer_value(self, values[index.get()])?;
                index.set(index.get() + 1);
                Ok(true)
            },
            _ => Err("sequence element outside a sequence"),
        }
    }

    fn end_sequence(self: ValueDeserializer) -> Result[(), string] {
        if self.frames.is_empty() {
            return Err("end_sequence without begin_sequence")
        } else if self.current.get().is_some() {
            return Err("sequence element was not consumed")
        }
        match self.frames[self.frames.len() - 1] {
            ValueDeserializeFrame::Sequence { values, index } => if index.get() != values.len() {
                Err("sequence ended before all elements were consumed")
            } else {
                pop_value_deserializer_frame(self);
                Ok(())
            },
            _ => Err("end_sequence does not match the active compound value"),
        }
    }

    fn begin_tuple(self: ValueDeserializer, length: isize) -> Result[(), string] {
        let value = take_deserializer_value(self)?;
        let values = match value {
            Value::Tuple(values) => values,
            Value::Sequence(values) => values,
            _ => return Err("expected tuple"),
        };
        if values.len() != length {
            Err("tuple length does not match the expected length")
        } else {
            self.frames.push(ValueDeserializeFrame::Tuple { values, index: Ref::new(0) });
            Ok(())
        }
    }

    fn begin_tuple_element(self: ValueDeserializer, index: isize) -> Result[(), string] {
        if self.frames.is_empty() {
            return Err("tuple element without tuple")
        } else if self.current.get().is_some() {
            return Err("previous tuple element was not consumed")
        }
        match self.frames[self.frames.len() - 1] {
            ValueDeserializeFrame::Tuple { values, index: next } => if index != next.get()
                || index >= values.len() {
                Err("tuple element index is out of order")
            } else {
                set_deserializer_value(self, values[index])?;
                next.set(index + 1);
                Ok(())
            },
            _ => Err("tuple element outside a tuple"),
        }
    }

    fn end_tuple(self: ValueDeserializer) -> Result[(), string] {
        if self.frames.is_empty() {
            return Err("end_tuple without begin_tuple")
        } else if self.current.get().is_some() {
            return Err("tuple element was not consumed")
        }
        match self.frames[self.frames.len() - 1] {
            ValueDeserializeFrame::Tuple { values, index } => if index.get() != values.len() {
                Err("tuple ended before all elements were consumed")
            } else {
                pop_value_deserializer_frame(self);
                Ok(())
            },
            _ => Err("end_tuple does not match the active compound value"),
        }
    }

    fn begin_map(self: ValueDeserializer) -> Result[Option[isize], string] {
        let entries = match take_deserializer_value(self)? {
            Value::Map(entries) => entries,
            Value::Struct(fields) => {
                let entries: Vec[(Value, Value)] = Vec::new();
                for field in fields {
                    entries.push((Value::String(field.0), field.1));
                }
                entries
            },
            Value::Sequence(values) => {
                let entries: Vec[(Value, Value)] = Vec::with_capacity(values.len());
                for value in values {
                    match value {
                        Value::Tuple(pair) if pair.len() == 2 => entries.push((pair[0], pair[1])),
                        _ => return Err("map entry must be a tuple with two values"),
                    }
                }
                entries
            },
            _ => return Err("expected map entries"),
        };
        let length = entries.len();
        self.frames.push(
            ValueDeserializeFrame::Map { entries, index: Ref::new(0), state: Ref::new(0) },
        );
        Ok(Option::Some(length))
    }

    fn next_map_entry(self: ValueDeserializer) -> Result[bool, string] {
        if self.frames.is_empty() {
            return Err("map entry without map")
        } else if self.current.get().is_some() {
            return Err("previous map value was not consumed")
        }
        match self.frames[self.frames.len() - 1] {
            ValueDeserializeFrame::Map { entries, index, state } => {
                if state.get() == 2 {
                    index.set(index.get() + 1);
                    state.set(0)
                } else if state.get() != 0 {
                    return Err("previous map entry is incomplete")
                }
                if index.get() >= entries.len() {
                    Ok(false)
                } else {
                    state.set(1);
                    Ok(true)
                }
            },
            _ => Err("map entry outside a map"),
        }
    }

    fn begin_map_key(self: ValueDeserializer) -> Result[(), string] {
        if self.frames.is_empty() {
            return Err("map key without map")
        }
        match self.frames[self.frames.len() - 1] {
            ValueDeserializeFrame::Map { entries, index, state } => if state.get() != 1 {
                Err("map is not expecting a key")
            } else {
                let entry = entries[index.get()];
                set_deserializer_value(self, entry.0)?;
                state.set(3);
                Ok(())
            },
            _ => Err("map key outside a map"),
        }
    }

    fn begin_map_value(self: ValueDeserializer) -> Result[(), string] {
        if self.frames.is_empty() {
            return Err("map value without map")
        } else if self.current.get().is_some() {
            return Err("map key was not consumed")
        }
        match self.frames[self.frames.len() - 1] {
            ValueDeserializeFrame::Map { entries, index, state } => if state.get() != 3 {
                Err("map is not expecting a value")
            } else {
                let entry = entries[index.get()];
                set_deserializer_value(self, entry.1)?;
                state.set(2);
                Ok(())
            },
            _ => Err("map value outside a map"),
        }
    }

    fn end_map(self: ValueDeserializer) -> Result[(), string] {
        if self.frames.is_empty() {
            return Err("end_map without begin_map")
        } else if self.current.get().is_some() {
            return Err("map value was not consumed")
        }
        match self.frames[self.frames.len() - 1] {
            ValueDeserializeFrame::Map { entries, index, state } => {
                if state.get() == 2 {
                    index.set(index.get() + 1);
                    state.set(0)
                }
                if state.get() != 0 || index.get() != entries.len() {
                    Err("map ended before all entries were consumed")
                } else {
                    pop_value_deserializer_frame(self);
                    Ok(())
                }
            },
            _ => Err("end_map does not match the active compound value"),
        }
    }

    fn begin_struct(self: ValueDeserializer, name: string, fields: isize) -> Result[(), string] {
        match take_deserializer_value(self)? {
            Value::Struct(values) => {
                self.frames.push(
                    ValueDeserializeFrame::Struct { fields: values, index: Ref::new(0) },
                );
                Ok(())
            },
            _ => Err("expected struct value"),
        }
    }

    fn next_struct_field(self: ValueDeserializer) -> Result[Option[FieldKey], string] {
        if self.frames.is_empty() {
            return Err("struct field without struct")
        } else if self.current.get().is_some() {
            return Err("previous struct field was not consumed")
        }
        match self.frames[self.frames.len() - 1] {
            ValueDeserializeFrame::Struct { fields, index } => if index.get() >= fields.len() {
                Ok(Option::None)
            } else {
                let position = index.get();
                let field = fields[position];
                index.set(position + 1);
                set_deserializer_value(self, field.1)?;
                if field.0 == "" {
                    Ok(Option::Some(FieldKey::Position(position)))
                } else {
                    Ok(Option::Some(FieldKey::Name(field.0)))
                }
            },
            _ => Err("struct field outside a struct"),
        }
    }

    fn skip_value(self: ValueDeserializer) -> Result[(), string] {
        let value = take_deserializer_value(self)?;
        if self.track_unused && self.frames.len() == 1 {
            match self.frames[0] {
                ValueDeserializeFrame::Struct { fields, index } => {
                    let position = index.get() - 1;
                    if position >= 0 && position < fields.len() {
                        self.unused_fields.push((fields[position].0, value))
                    }
                },
                _ => (),
            }
        }
        Ok(())
    }

    fn preserve_unknown_fields(self: ValueDeserializer, fields: Vec[(string, Value)]) -> () {
        if self.track_unused && self.frames.is_empty() {
            for field in fields {
                self.unused_fields.push(field);
            }
        }
    }

    fn end_struct(self: ValueDeserializer) -> Result[(), string] {
        if self.frames.is_empty() {
            return Err("end_struct without begin_struct")
        } else if self.current.get().is_some() {
            return Err("struct field was not consumed")
        }
        match self.frames[self.frames.len() - 1] {
            ValueDeserializeFrame::Struct { fields, index } => if index.get() != fields.len() {
                Err("struct ended before all fields were consumed")
            } else {
                pop_value_deserializer_frame(self);
                Ok(())
            },
            _ => Err("end_struct does not match the active compound value"),
        }
    }

    fn begin_variant(self: ValueDeserializer, enum_name: string, variants: isize) -> Result[
        VariantKey,
        string,
    ] {
        let value = take_deserializer_value(self)?;
        match value {
            Value::Variant { index, name: _, kind, fields } => {
                self.frames.push(
                    ValueDeserializeFrame::Variant {
                        kind,
                        fields,
                        index: Ref::new(0),
                        begun: Ref::new(false),
                    },
                );
                Ok(VariantKey::Index(index))
            },
            value => {
                let parts = variant_parts(value)?;
                self.frames.push(
                    ValueDeserializeFrame::Variant {
                        kind: parts.1,
                        fields: parts.2,
                        index: Ref::new(0),
                        begun: Ref::new(false),
                    },
                );
                Ok(VariantKey::Name(parts.0))
            },
        }
    }

    fn begin_variant_fields(self: ValueDeserializer, kind: isize, fields: isize) -> Result[
        (),
        string,
    ] {
        if self.frames.is_empty() {
            return Err("variant fields without variant")
        }
        match self.frames[self.frames.len() - 1] {
            ValueDeserializeFrame::Variant {
                kind: actual_kind,
                fields: actual_fields,
                index: _,
                begun,
            } => if begun.get() {
                Err("variant fields were already begun")
            } else if actual_kind != kind || (kind != 2 && actual_fields.len() != fields) {
                Err("variant payload shape does not match the expected shape")
            } else {
                begun.set(true);
                Ok(())
            },
            _ => Err("variant fields outside a variant"),
        }
    }

    fn next_variant_field(self: ValueDeserializer) -> Result[Option[FieldKey], string] {
        if self.frames.is_empty() {
            return Err("variant field without variant")
        } else if self.current.get().is_some() {
            return Err("previous variant field was not consumed")
        }
        match self.frames[self.frames.len() - 1] {
            ValueDeserializeFrame::Variant { kind, fields, index, begun } => if !begun.get() {
                Err("variant fields were not begun")
            } else if index.get() >= fields.len() {
                Ok(Option::None)
            } else {
                let position = index.get();
                let field = fields[position];
                index.set(position + 1);
                set_deserializer_value(self, field.1)?;
                if kind == 2 && field.0 != "" {
                    Ok(Option::Some(FieldKey::Name(field.0)))
                } else {
                    Ok(Option::Some(FieldKey::Position(position)))
                }
            },
            _ => Err("variant field outside a variant"),
        }
    }

    fn end_variant(self: ValueDeserializer) -> Result[(), string] {
        if self.frames.is_empty() {
            return Err("end_variant without begin_variant")
        } else if self.current.get().is_some() {
            return Err("variant field was not consumed")
        }
        match self.frames[self.frames.len() - 1] {
            ValueDeserializeFrame::Variant { kind: _, fields, index, begun } => if !begun.get() {
                Err("variant fields were not begun")
            } else if index.get() != fields.len() {
                Err("variant ended before all fields were consumed")
            } else {
                pop_value_deserializer_frame(self);
                Ok(())
            },
            _ => Err("end_variant does not match the active compound value"),
        }
    }
}
