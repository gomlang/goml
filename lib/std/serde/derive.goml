package serde;

#[comptime_derive]
fn exprs() -> MetaExprList {
    meta_expr_list_new()
}

#[comptime_derive]
fn exprs_one(value: MetaExpr) -> MetaExprList {
    let values = exprs();
    meta_expr_list_push(values, value);
    values
}

#[comptime_derive]
fn exprs_two(first: MetaExpr, second: MetaExpr) -> MetaExprList {
    let values = exprs_one(first);
    meta_expr_list_push(values, second);
    values
}

#[comptime_derive]
fn exprs_three(first: MetaExpr, second: MetaExpr, third: MetaExpr) -> MetaExprList {
    let values = exprs_two(first, second);
    meta_expr_list_push(values, third);
    values
}

#[comptime_derive]
fn exprs_four(first: MetaExpr, second: MetaExpr, third: MetaExpr, fourth: MetaExpr) -> MetaExprList {
    let values = exprs_two(first, second);
    meta_expr_list_push(values, third);
    meta_expr_list_push(values, fourth);
    values
}

#[comptime_derive]
fn exprs_five(first: MetaExpr, second: MetaExpr, third: MetaExpr, fourth: MetaExpr, fifth: MetaExpr) -> MetaExprList {
    let values = exprs_four(first, second, third, fourth);
    meta_expr_list_push(values, fifth);
    values
}

#[comptime_derive]
fn type_list_two(first: MetaType, second: MetaType) -> MetaTypeList {
    let values = meta_type_list_new();
    meta_type_list_push(values, first);
    meta_type_list_push(values, second);
    values
}

#[comptime_derive]
fn type_list_one(value: MetaType) -> MetaTypeList {
    let values = meta_type_list_new();
    meta_type_list_push(values, value);
    values
}

#[comptime_derive]
fn result_type(ok: MetaType) -> MetaType {
    meta_type_apply(meta_type_call_site("Result"), type_list_two(ok, meta_type_call_site("string")))
}

#[comptime_derive]
fn option_type(value: MetaType) -> MetaType {
    meta_type_apply(meta_type_call_site("Option"), type_list_one(value))
}

#[comptime_derive]
fn definition_call(input: DeriveInput, name: string, args: MetaExprList) -> MetaExpr {
    meta_expr_call(input, name, args)
}

#[comptime_derive]
fn serialize_value(input: DeriveInput, value: MetaExpr) -> MetaExpr {
    meta_expr_try(
        meta_expr_trait_call(
            input,
            "Serialize",
            "serialize",
            exprs_two(value, meta_expr_var("serializer")),
        ),
    )
}

#[comptime_derive]
fn serializer_call(name: string, args: MetaExprList) -> MetaExpr {
    meta_expr_method_call(meta_expr_var("serializer"), name, args)
}

#[comptime_derive]
fn try_serializer_call(name: string, args: MetaExprList) -> MetaExpr {
    meta_expr_try(serializer_call(name, args))
}

#[comptime_derive]
fn deserialize_value(input: DeriveInput) -> MetaExpr {
    meta_expr_try(
        meta_expr_trait_call(
            input,
            "Deserialize",
            "deserialize",
            exprs_one(meta_expr_var("deserializer")),
        ),
    )
}

#[comptime_derive]
fn deserializer_call(name: string, args: MetaExprList) -> MetaExpr {
    meta_expr_method_call(meta_expr_var("deserializer"), name, args)
}

#[comptime_derive]
fn try_deserializer_call(name: string, args: MetaExprList) -> MetaExpr {
    meta_expr_try(deserializer_call(name, args))
}

#[comptime_derive]
fn result_ok(value: MetaExpr) -> MetaExpr {
    meta_expr_constructor("Result::Ok", exprs_one(value))
}

#[comptime_derive]
fn deserializer_result_err(message: string) -> MetaExpr {
    meta_expr_constructor(
        "Result::Err",
        exprs_one(deserializer_call("error", exprs_one(meta_expr_string(message)))),
    )
}

#[comptime_derive]
fn policy_attribute(input: DeriveInput, variant: isize, field: isize, index: isize) -> MetaAttribute {
    if field >= 0 {
        if variant < 0 {
            derive_field_attribute(input, field, index)
        } else {
            derive_variant_field_attribute(input, variant, field, index)
        }
    } else if variant >= 0 {
        derive_variant_attribute(input, variant, index)
    } else {
        derive_attribute(input, index)
    }
}

#[comptime_derive]
fn policy_attribute_count(input: DeriveInput, variant: isize, field: isize) -> isize {
    if field >= 0 {
        if variant < 0 {
            derive_field_attribute_count(input, field)
        } else {
            derive_variant_field_attribute_count(input, variant, field)
        }
    } else if variant >= 0 {
        derive_variant_attribute_count(input, variant)
    } else {
        derive_attribute_count(input)
    }
}

#[comptime_derive]
fn policy(input: DeriveInput, variant: isize, field: isize, name: string) -> string {
    let mut value = "";
    let mut seen = false;
    for index in 0..policy_attribute_count(input, variant, field) {
        let attribute = policy_attribute(input, variant, field, index);
        if meta_attribute_name(attribute) == "serde" {
            for argument in 0..meta_attribute_argument_count(attribute) {
                if meta_attribute_argument_name(attribute, argument) == name {
                    if seen {
                        compile_error("duplicate serde attribute `" + name + "`")
                    }
                    seen = true;
                    value = if meta_attribute_argument_kind(attribute, argument) == "ident" {
                        "#"
                    } else {
                        meta_attribute_argument_text(attribute, argument)
                    };
                }
            }
        }
    }
    value
}

#[comptime_derive]
fn has_policy(input: DeriveInput, variant: isize, field: isize, name: string) -> bool {
    for index in 0..policy_attribute_count(input, variant, field) {
        let attribute = policy_attribute(input, variant, field, index);
        if meta_attribute_name(attribute) == "serde" {
            for argument in 0..meta_attribute_argument_count(attribute) {
                if meta_attribute_argument_name(attribute, argument) == name {
                    return true
                }
            }
        }
    }
    false
}

#[comptime_derive]
fn source_field_name(input: DeriveInput, variant: isize, field: isize) -> string {
    if variant < 0 {
        derive_field_name(input, field)
    } else {
        derive_variant_field_name(input, variant, field)
    }
}

#[comptime_derive]
fn field_type(input: DeriveInput, variant: isize, field: isize) -> MetaType {
    if variant < 0 {
        derive_field_type(input, field)
    } else {
        derive_variant_field_type(input, variant, field)
    }
}

#[comptime_derive]
fn field_count(input: DeriveInput, variant: isize) -> isize {
    if variant < 0 {
        derive_field_count(input)
    } else {
        derive_variant_field_count(input, variant)
    }
}

#[comptime_derive]
fn wire_field_name(input: DeriveInput, variant: isize, field: isize) -> string {
    let name = policy(input, variant, field, "rename");
    if has_policy(input, variant, field, "rename") {
        name
    } else if variant >= 0 && derive_variant_kind(input, variant) != 2 {
        ""
    } else {
        source_field_name(input, variant, field)
    }
}

#[comptime_derive]
fn wire_variant_name(input: DeriveInput, variant: isize) -> string {
    let name = policy(input, variant, -1, "rename");
    if has_policy(input, variant, -1, "rename") {
        name
    } else {
        derive_variant_name(input, variant)
    }
}

#[comptime_derive]
fn skipped(input: DeriveInput, variant: isize, field: isize, serializing: bool) -> bool {
    policy(input, variant, field, "skip") != ""
        || policy(
            input,
            variant,
            field,
            if serializing {
                "skip_serializing"
            } else {
                "skip_deserializing"
            },
        )
            != ""
}

#[comptime_derive]
fn is_flatten(input: DeriveInput, variant: isize, field: isize) -> bool {
    policy(input, variant, field, "flatten") != ""
}

#[comptime_derive]
fn has_flatten(input: DeriveInput, variant: isize) -> bool {
    for field in 0..field_count(input, variant) {
        if is_flatten(input, variant, field) {
            return true
        }
    }
    false
}

#[comptime_derive]
fn field_default(input: DeriveInput, variant: isize, field: isize) -> string {
    let value = policy(input, variant, field, "default");
    if value != "" {
        value
    } else if skipped(input, variant, field, false) {
        "#"
    } else {
        ""
    }
}

#[comptime_derive]
fn default_expr(input: DeriveInput, variant: isize, field: isize) -> MetaExpr {
    let value = field_default(input, variant, field);
    if value == "#" {
        meta_expr_trait_call_site("builtin::Default", "default", exprs())
    } else {
        meta_expr_call_site(value, exprs())
    }
}

#[comptime_derive]
fn validate_policy_site(input: DeriveInput, variant: isize, field: isize) -> () {
    for index in 0..policy_attribute_count(input, variant, field) {
        let attribute = policy_attribute(input, variant, field, index);
        if meta_attribute_name(attribute) == "serde" {
            if meta_attribute_argument_count(attribute) == 0 {
                compile_error("serde attribute requires an argument")
            }
            for argument in 0..meta_attribute_argument_count(attribute) {
                let name = meta_attribute_argument_name(attribute, argument);
                let kind = meta_attribute_argument_kind(attribute, argument);
                let value_kind = meta_attribute_argument_value_kind(attribute, argument);
                let value = meta_attribute_argument_text(attribute, argument);
                let field_flag = name == "skip" || name == "skip_serializing"
                    || name == "skip_deserializing"
                    || name == "flatten";
                if field >= 0
                    && (field_flag || name == "default" || name == "rename"
                        || name == "skip_serializing_if") {
                    if field_flag && kind != "ident" {
                        compile_error("serde `" + name + "` is a flag")
                    } else if name == "default" {
                        if kind != "ident"
                            && (kind != "named"
                                || (value_kind != "string" && value_kind != "path"
                                    && value_kind != "ident")
                                || value == "") {
                            compile_error("serde default requires a function path")
                        }
                    } else if name == "rename" && (kind != "named" || value_kind != "string") {
                        compile_error("serde rename requires a string")
                    } else if name == "skip_serializing_if"
                        && (kind != "named"
                            || (value_kind != "string" && value_kind != "path"
                                && value_kind != "ident")
                            || value == "") {
                        compile_error("serde skip_serializing_if requires a function path")
                    }
                    if variant >= 0 && derive_variant_kind(input, variant) != 2
                        && (name == "flatten" || name == "rename" || name == "skip_serializing_if") {
                        compile_error("serde `" + name + "` requires a named field")
                    }
                } else if field < 0 && variant >= 0 && name == "rename" {
                    if kind != "named" || value_kind != "string" {
                        compile_error("serde rename requires a string")
                    }
                } else if field < 0 && variant < 0 && derive_item_kind(input) != 0
                    && (name == "tag" || name == "content" || name == "untagged") {
                    if name == "untagged" && kind != "ident" {
                        compile_error("serde untagged is a flag")
                    } else if name != "untagged"
                        && (kind != "named" || value_kind != "string" || value == "") {
                        compile_error("serde `" + name + "` requires a nonempty string")
                    }
                } else {
                    compile_error("unsupported serde attribute `" + name + "` at this location")
                }
                let _ = policy(input, variant, field, name);
            }
        }
    }
    if field >= 0 && is_flatten(input, variant, field) {
        if has_policy(input, variant, field, "rename")
            || policy(input, variant, field, "default") != ""
            || skipped(input, variant, field, true)
            || skipped(input, variant, field, false) {
            compile_error("serde flatten cannot be combined with rename, default, or skip")
        }
    }
}

#[comptime_derive]
fn validate_fields(input: DeriveInput, variant: isize) -> () {
    for field in 0..field_count(input, variant) {
        validate_policy_site(input, variant, field);
        if !is_flatten(input, variant, field) {
            let name = wire_field_name(input, variant, field);
            if variant < 0 || derive_variant_kind(input, variant) == 2 {
                for previous in 0..field {
                    if !is_flatten(input, variant, previous)
                        && wire_field_name(input, variant, previous) == name {
                        compile_error("duplicate serde field name `" + name + "`")
                    }
                }
            }
        }
    }
}

#[comptime_derive]
fn validate_policies(input: DeriveInput) -> () {
    validate_policy_site(input, -1, -1);
    if derive_item_kind(input) == 0 {
        validate_fields(input, -1)
    } else {
        let tag = policy(input, -1, -1, "tag");
        let content = policy(input, -1, -1, "content");
        let untagged = policy(input, -1, -1, "untagged") != "";
        if content != "" && tag == "" {
            compile_error("serde content requires tag")
        } else if tag != "" && tag == content {
            compile_error("serde tag and content must be different")
        } else if untagged && (tag != "" || content != "") {
            compile_error("serde untagged cannot be combined with tag or content")
        }
        for variant in 0..derive_variant_count(input) {
            validate_policy_site(input, variant, -1);
            validate_fields(input, variant);
            for previous in 0..variant {
                if wire_variant_name(input, previous) == wire_variant_name(input, variant) {
                    compile_error("duplicate serde variant name")
                }
            }
            if tag != "" && content == "" {
                if derive_variant_kind(input, variant) == 1 && field_count(input, variant) != 1 {
                    compile_error(
                        "internally tagged enums require unit, named, or single-field variants",
                    )
                }
                for field in 0..field_count(input, variant) {
                    if wire_field_name(input, variant, field) == tag {
                        compile_error("serde tag conflicts with a variant field")
                    }
                }
            }
        }
    }
}

#[comptime_derive]
fn add_field_predicates(input: DeriveInput, output: DeriveOutput, variant: isize, serializing: bool) -> () {
    for field in 0..field_count(input, variant) {
        let ty = field_type(input, variant, field);
        if meta_type_contains_generic(input, ty) {
            if !skipped(input, variant, field, serializing) {
                derive_output_add_predicate(
                    output,
                    ty,
                    if serializing {
                        "Serialize"
                    } else {
                        "Deserialize"
                    },
                )
            }
            if !serializing && field_default(input, variant, field) == "#" {
                derive_output_add_call_site_predicate(output, ty, "builtin::Default")
            }
        }
    }
}

#[comptime_derive]
fn add_predicates(input: DeriveInput, output: DeriveOutput, serializing: bool) -> () {
    if derive_item_kind(input) == 0 {
        add_field_predicates(input, output, -1, serializing)
    } else {
        for variant in 0..derive_variant_count(input) {
            add_field_predicates(input, output, variant, serializing)
        }
    }
}

#[comptime_derive]
fn field_binding(field: isize) -> string {
    "__goml_serde_field_" + field.to_string()
}

#[comptime_derive]
fn field_value(input: DeriveInput, variant: isize, field: isize) -> MetaExpr {
    if variant < 0 {
        meta_expr_field(meta_expr_var("self"), source_field_name(input, variant, field))
    } else {
        meta_expr_var(field_binding(field))
    }
}

#[comptime_derive]
fn include_binding(field: isize) -> string {
    "__goml_serde_include_" + field.to_string()
}

#[comptime_derive]
fn serialized_count(input: DeriveInput, variant: isize, block: MetaBlock) -> MetaExpr {
    let mut count = meta_expr_int(0);
    for field in 0..field_count(input, variant) {
        if !skipped(input, variant, field, true) {
            let predicate = policy(input, variant, field, "skip_serializing_if");
            let amount = if predicate == "" {
                meta_expr_int(1)
            } else {
                meta_block_expr(
                    block,
                    meta_expr_try(
                        definition_call(
                            input,
                            "require_readable",
                            exprs_two(
                                serializer_call("is_human_readable", exprs()),
                                meta_expr_string("skip_serializing_if"),
                            ),
                        ),
                    ),
                );
                meta_block_let(
                    block,
                    include_binding(field),
                    meta_expr_unary(
                        1,
                        meta_expr_call_site(
                            predicate,
                            exprs_one(field_value(input, variant, field)),
                        ),
                    ),
                );
                meta_expr_if(
                    meta_expr_var(include_binding(field)),
                    meta_expr_int(1),
                    meta_expr_int(0),
                )
            };
            count = meta_expr_binary(0, count, amount);
        }
    }
    count
}

#[comptime_derive]
fn serialize_fields_body(input: DeriveInput, variant: isize) -> MetaExpr {
    let block = meta_block_new();
    let count = serialized_count(input, variant, block);
    let flatten = has_flatten(input, variant) || custom_enum(input);
    if flatten {
        meta_block_expr(
            block,
            meta_expr_try(
                definition_call(
                    input,
                    "require_readable",
                    exprs_two(
                        serializer_call("is_human_readable", exprs()),
                        meta_expr_string("flatten"),
                    ),
                ),
            ),
        );
        meta_block_let(
            block,
            "__goml_serde_fields",
            definition_call(input, "policy_fields_new", exprs()),
        );
    } else if variant < 0 {
        meta_block_expr(
            block,
            try_serializer_call(
                "begin_struct",
                exprs_two(meta_expr_string(derive_item_name(input)), count),
            ),
        );
    } else {
        meta_block_expr(
            block,
            try_serializer_call(
                "begin_variant",
                exprs_five(
                    meta_expr_string(derive_item_name(input)),
                    meta_expr_int(variant),
                    meta_expr_string(wire_variant_name(input, variant)),
                    meta_expr_int(derive_variant_kind(input, variant)),
                    count,
                ),
            ),
        );
    }
    meta_block_let_mut(block, "__goml_serde_index", meta_expr_int(0));
    for field in 0..field_count(input, variant) {
        if !skipped(input, variant, field, true) {
            let field_block = meta_block_new();
            let value = field_value(input, variant, field);
            if flatten {
                let encoded = meta_expr_try(definition_call(input, "to_value", exprs_one(value)));
                let call = if is_flatten(input, variant, field) {
                    definition_call(
                        input,
                        "policy_flatten",
                        exprs_two(meta_expr_var("__goml_serde_fields"), encoded),
                    )
                } else if variant >= 0 && derive_variant_kind(input, variant) == 1 {
                    definition_call(
                        input,
                        "policy_push_positional",
                        exprs_two(meta_expr_var("__goml_serde_fields"), encoded),
                    )
                } else {
                    definition_call(
                        input,
                        "policy_push_field",
                        exprs_three(
                            meta_expr_var("__goml_serde_fields"),
                            meta_expr_string(wire_field_name(input, variant, field)),
                            encoded,
                        ),
                    )
                };
                meta_block_expr(field_block, meta_expr_try(call));
            } else {
                meta_block_expr(
                    field_block,
                    try_serializer_call(
                        if variant < 0 {
                            "begin_struct_field"
                        } else {
                            "begin_variant_field"
                        },
                        exprs_two(
                            meta_expr_var("__goml_serde_index"),
                            meta_expr_string(wire_field_name(input, variant, field)),
                        ),
                    ),
                );
                meta_block_expr(field_block, serialize_value(input, value));
                meta_block_assign(
                    field_block,
                    meta_expr_var("__goml_serde_index"),
                    meta_expr_binary(0, meta_expr_var("__goml_serde_index"), meta_expr_int(1)),
                );
            }
            let body = meta_block_finish_unit(field_block);
            meta_block_expr(
                block,
                if policy(input, variant, field, "skip_serializing_if") != "" {
                    meta_expr_if(meta_expr_var(include_binding(field)), body, meta_expr_unit())
                } else {
                    body
                },
            );
        }
    }
    if flatten {
        let value = if variant < 0 {
            definition_call(input, "structure", exprs_one(meta_expr_var("__goml_serde_fields")))
        } else {
            definition_call(
                input,
                "variant",
                exprs_four(
                    meta_expr_int(variant),
                    meta_expr_string(wire_variant_name(input, variant)),
                    meta_expr_int(derive_variant_kind(input, variant)),
                    meta_expr_var("__goml_serde_fields"),
                ),
            )
        };
        meta_block_finish(
            block,
            if custom_enum(input) {
                definition_call(
                    input,
                    "serialize_tagged_value",
                    exprs_four(
                        value,
                        meta_expr_string(policy(input, -1, -1, "tag")),
                        meta_expr_string(policy(input, -1, -1, "content")),
                        meta_expr_var("serializer"),
                    ),
                )
            } else {
                definition_call(
                    input,
                    "serialize_value_into",
                    exprs_two(value, meta_expr_var("serializer")),
                )
            },
        )
    } else {
        meta_block_finish(
            block,
            serializer_call(
                if variant < 0 {
                    "end_struct"
                } else {
                    "end_variant"
                },
                exprs(),
            ),
        )
    }
}

#[comptime_derive]
fn serialize_enum_body(input: DeriveInput) -> MetaExpr {
    let arms = meta_arm_list_new();
    for variant in 0..derive_variant_count(input) {
        let positional = meta_pattern_list_new();
        let named = meta_pattern_field_list_new();
        let kind = derive_variant_kind(input, variant);
        for field in 0..field_count(input, variant) {
            if kind == 2 {
                meta_pattern_field_list_push(
                    named,
                    source_field_name(input, variant, field),
                    meta_pattern_bind(field_binding(field)),
                )
            } else {
                meta_pattern_list_push(positional, meta_pattern_bind(field_binding(field)))
            }
        }
        let pattern = if kind == 2 {
            meta_pattern_struct(
                derive_item_name(input) + "::" + derive_variant_name(input, variant),
                named,
                false,
            )
        } else {
            meta_pattern_target_constructor(input, derive_variant_name(input, variant), positional)
        };
        meta_arm_list_push(arms, meta_arm(pattern, serialize_fields_body(input, variant)));
    }
    meta_expr_match(meta_expr_var("self"), arms)
}

#[comptime_derive]
fn custom_enum(input: DeriveInput) -> bool {
    derive_item_kind(input) != 0
        && (policy(input, -1, -1, "tag") != "" || policy(input, -1, -1, "untagged") != "")
}

#[comptime_derive]
fn serialize_body(input: DeriveInput) -> MetaExpr {
    if derive_item_kind(input) == 0 {
        serialize_fields_body(input, -1)
    } else {
        serialize_enum_body(input)
    }
}

#[comptime_derive(Serialize)]
pub fn derive_serialize(input: DeriveInput) -> DeriveOutput {
    validate_policies(input);
    let output = derive_output_new(input, "Serialize");
    add_predicates(input, output, true);
    let params = meta_param_list_new();
    meta_param_list_push(params, "self", derive_target_type(input));
    meta_param_list_push(params, "serializer", meta_type_call_site("S"));
    let generics = meta_generic_list_new();
    meta_generic_list_push(generics, "S");
    meta_generic_list_add_bound(input, generics, "S", "Serializer");
    derive_output_add_method(
        output,
        meta_method_generic(
            "serialize",
            generics,
            params,
            result_type(meta_type_call_site("()")),
            serialize_body(input),
        ),
    );
    output
}

#[comptime_derive]
fn decoded_count(input: DeriveInput, variant: isize) -> isize {
    let mut count = 0;
    for field in 0..field_count(input, variant) {
        if !skipped(input, variant, field, false) && !is_flatten(input, variant, field) {
            count += 1;
        }
    }
    count
}

#[comptime_derive]
fn decoded_index(input: DeriveInput, variant: isize, field: isize) -> isize {
    let mut count = 0;
    for previous in 0..field {
        if !skipped(input, variant, previous, false) && !is_flatten(input, variant, previous) {
            count += 1;
        }
    }
    count
}

#[comptime_derive]
fn decoded_field_branch(input: DeriveInput, variant: isize, field: isize, otherwise: MetaExpr) -> MetaExpr {
    let block = meta_block_new();
    let binding = field_binding(field);
    let label = wire_field_name(input, variant, field);
    meta_block_expr(
        block,
        meta_expr_if(
            meta_expr_method_call(meta_expr_var(binding), "is_some", exprs()),
            meta_expr_return(deserializer_result_err("duplicate field `" + label + "`")),
            meta_expr_unit(),
        ),
    );
    meta_block_assign(
        block,
        meta_expr_var(binding),
        meta_expr_constructor("Option::Some", exprs_one(deserialize_value(input))),
    );
    meta_expr_if(
        definition_call(
            input,
            "field_key_matches",
            exprs_three(
                meta_expr_var("__goml_serde_next"),
                meta_expr_int(decoded_index(input, variant, field)),
                meta_expr_string(label),
            ),
        ),
        meta_block_finish_unit(block),
        otherwise,
    )
}

#[comptime_derive]
fn defaulted_value(input: DeriveInput, variant: isize, field: isize, option: MetaExpr) -> MetaExpr {
    let arms = meta_arm_list_new();
    let patterns = meta_pattern_list_new();
    meta_pattern_list_push(patterns, meta_pattern_bind("__goml_serde_value"));
    meta_arm_list_push(
        arms,
        meta_arm(
            meta_pattern_constructor("Option::Some", patterns),
            meta_expr_var("__goml_serde_value"),
        ),
    );
    meta_arm_list_push(
        arms,
        meta_arm(
            meta_pattern_constructor("Option::None", meta_pattern_list_new()),
            default_expr(input, variant, field),
        ),
    );
    meta_expr_match(option, arms)
}

#[comptime_derive]
fn constructed_value(input: DeriveInput, variant: isize) -> MetaExpr {
    let named = meta_expr_field_list_new();
    let positional = exprs();
    for field in 0..field_count(input, variant) {
        let value = meta_expr_var(field_binding(field));
        if variant < 0 || derive_variant_kind(input, variant) == 2 {
            meta_expr_field_list_push(named, source_field_name(input, variant, field), value)
        } else {
            meta_expr_list_push(positional, value)
        }
    }
    if variant < 0 {
        meta_expr_target_struct(input, named)
    } else if derive_variant_kind(input, variant) == 2 {
        meta_expr_target_variant_struct(input, derive_variant_name(input, variant), named)
    } else {
        meta_expr_target_constructor(input, derive_variant_name(input, variant), positional)
    }
}

#[comptime_derive]
fn deserialize_fields_body(input: DeriveInput, variant: isize) -> MetaExpr {
    let block = meta_block_new();
    let flatten = has_flatten(input, variant);
    if flatten {
        meta_block_expr(
            block,
            meta_expr_try(
                definition_call(
                    input,
                    "require_readable",
                    exprs_two(
                        deserializer_call("is_human_readable", exprs()),
                        meta_expr_string("flatten"),
                    ),
                ),
            ),
        );
        meta_block_let(
            block,
            "__goml_serde_remaining",
            definition_call(input, "policy_fields_new", exprs()),
        );
    }
    let begin = if variant < 0 {
        try_deserializer_call(
            "begin_struct",
            exprs_two(
                meta_expr_string(derive_item_name(input)),
                meta_expr_int(decoded_count(input, variant)),
            ),
        )
    } else {
        try_deserializer_call(
            "begin_variant_fields",
            exprs_two(
                meta_expr_int(derive_variant_kind(input, variant)),
                meta_expr_int(decoded_count(input, variant)),
            ),
        )
    };
    meta_block_expr(block, begin);
    for field in 0..field_count(input, variant) {
        if !skipped(input, variant, field, false) && !is_flatten(input, variant, field) {
            meta_block_let_mut_typed(
                block,
                field_binding(field),
                option_type(field_type(input, variant, field)),
                meta_expr_constructor("Option::None", exprs()),
            );
        }
    }
    let next_call = if variant < 0 {
        "next_struct_field"
    } else {
        "next_variant_field"
    };
    meta_block_let_mut(block, "__goml_serde_next", try_deserializer_call(next_call, exprs()));
    let loop_block = meta_block_new();
    let mut branch = if flatten {
        meta_expr_try(
            definition_call(
                input,
                "policy_capture_field",
                exprs_three(
                    meta_expr_var("deserializer"),
                    meta_expr_var("__goml_serde_next"),
                    meta_expr_var("__goml_serde_remaining"),
                ),
            ),
        )
    } else {
        try_deserializer_call("skip_value", exprs())
    };
    let mut field = field_count(input, variant);
    while field > 0 {
        field -= 1;
        if !skipped(input, variant, field, false) && !is_flatten(input, variant, field) {
            branch = decoded_field_branch(input, variant, field, branch);
        } else if skipped(input, variant, field, false) && flatten {
            branch = meta_expr_if(
                definition_call(
                    input,
                    "field_key_matches",
                    exprs_three(
                        meta_expr_var("__goml_serde_next"),
                        meta_expr_int(-1),
                        meta_expr_string(wire_field_name(input, variant, field)),
                    ),
                ),
                try_deserializer_call("skip_value", exprs()),
                branch,
            );
        }
    }
    meta_block_expr(loop_block, branch);
    meta_block_assign(
        loop_block,
        meta_expr_var("__goml_serde_next"),
        try_deserializer_call(next_call, exprs()),
    );
    meta_block_expr(
        block,
        meta_expr_while(
            meta_expr_method_call(meta_expr_var("__goml_serde_next"), "is_some", exprs()),
            meta_block_finish_unit(loop_block),
        ),
    );
    for field in 0..field_count(input, variant) {
        if !skipped(input, variant, field, false) && !is_flatten(input, variant, field)
            && field_default(input, variant, field) == "" {
            meta_block_expr(
                block,
                meta_expr_if(
                    meta_expr_method_call(meta_expr_var(field_binding(field)), "is_none", exprs()),
                    meta_expr_return(
                        deserializer_result_err(
                            "missing field `" + wire_field_name(input, variant, field) + "`",
                        ),
                    ),
                    meta_expr_unit(),
                ),
            );
        }
    }
    meta_block_expr(
        block,
        try_deserializer_call(
            if variant < 0 {
                "end_struct"
            } else {
                "end_variant"
            },
            exprs(),
        ),
    );
    for field in 0..field_count(input, variant) {
        let value = if is_flatten(input, variant, field) {
            meta_expr_try(
                definition_call(
                    input,
                    "policy_take_flatten",
                    exprs_one(meta_expr_var("__goml_serde_remaining")),
                ),
            )
        } else if skipped(input, variant, field, false) {
            default_expr(input, variant, field)
        } else if field_default(input, variant, field) != "" {
            defaulted_value(input, variant, field, meta_expr_var(field_binding(field)))
        } else {
            meta_expr_try(
                definition_call(
                    input,
                    "required_field",
                    exprs_two(
                        meta_expr_var(field_binding(field)),
                        meta_expr_string(wire_field_name(input, variant, field)),
                    ),
                ),
            )
        };
        meta_block_let_typed(block, field_binding(field), field_type(input, variant, field), value);
    }
    if flatten {
        meta_block_expr(
            block,
            deserializer_call(
                "preserve_unknown_fields",
                exprs_one(meta_expr_var("__goml_serde_remaining")),
            ),
        );
    }
    meta_block_finish(block, result_ok(constructed_value(input, variant)))
}

#[comptime_derive]
fn deserialize_enum_body(input: DeriveInput) -> MetaExpr {
    let block = meta_block_new();
    meta_block_let(
        block,
        "__goml_serde_key",
        try_deserializer_call(
            "begin_variant",
            exprs_two(
                meta_expr_string(derive_item_name(input)),
                meta_expr_int(derive_variant_count(input)),
            ),
        ),
    );
    let mut branch = deserializer_result_err("unknown enum variant");
    let mut variant = derive_variant_count(input);
    while variant > 0 {
        variant -= 1;
        branch = meta_expr_if(
            definition_call(
                input,
                "variant_key_matches",
                exprs_three(
                    meta_expr_var("__goml_serde_key"),
                    meta_expr_int(variant),
                    meta_expr_string(wire_variant_name(input, variant)),
                ),
            ),
            deserialize_fields_body(input, variant),
            branch,
        );
    }
    meta_block_finish(block, branch)
}

#[comptime_derive]
fn result_match(value: MetaExpr, binding: string, success: MetaExpr) -> MetaExpr {
    let arms = meta_arm_list_new();
    let ok = meta_pattern_list_new();
    meta_pattern_list_push(ok, meta_pattern_bind(binding));
    meta_arm_list_push(arms, meta_arm(meta_pattern_constructor("Result::Ok", ok), success));
    let error = meta_pattern_list_new();
    meta_pattern_list_push(error, meta_pattern_bind("__goml_serde_error"));
    meta_arm_list_push(
        arms,
        meta_arm(
            meta_pattern_constructor("Result::Err", error),
            meta_expr_constructor("Result::Err", exprs_one(meta_expr_var("__goml_serde_error"))),
        ),
    );
    meta_expr_match(value, arms)
}

#[comptime_derive]
fn dynamic_field_value(input: DeriveInput, variant: isize, field: isize) -> MetaExpr {
    if skipped(input, variant, field, false) {
        return result_ok(default_expr(input, variant, field))
    } else if is_flatten(input, variant, field) {
        return definition_call(
            input,
            "policy_take_flatten",
            exprs_one(meta_expr_var("__goml_serde_payload_fields")),
        )
    }
    let option = definition_call(
        input,
        "policy_take_field",
        exprs_three(
            meta_expr_var("__goml_serde_payload_fields"),
            meta_expr_string(wire_field_name(input, variant, field)),
            meta_expr_int(
                if derive_variant_kind(input, variant) == 2 {
                    -1
                } else {
                    decoded_index(input, variant, field)
                },
            ),
        ),
    );
    let arms = meta_arm_list_new();
    let some = meta_pattern_list_new();
    meta_pattern_list_push(some, meta_pattern_bind("__goml_serde_raw_field"));
    meta_arm_list_push(
        arms,
        meta_arm(
            meta_pattern_constructor("Option::Some", some),
            definition_call(input, "from_value", exprs_one(meta_expr_var("__goml_serde_raw_field"))),
        ),
    );
    let missing = if field_default(input, variant, field) != "" {
        result_ok(default_expr(input, variant, field))
    } else {
        meta_expr_constructor(
            "Result::Err",
            exprs_one(
                meta_expr_string("missing field `" + source_field_name(input, variant, field) + "`"),
            ),
        )
    };
    meta_arm_list_push(
        arms,
        meta_arm(meta_pattern_constructor("Option::None", meta_pattern_list_new()), missing),
    );
    meta_expr_match(option, arms)
}

#[comptime_derive]
fn typed_dynamic_field(input: DeriveInput, variant: isize, field: isize) -> MetaExpr {
    let block = meta_block_new();
    meta_block_let_typed(
        block,
        "__goml_serde_typed_field",
        result_type(field_type(input, variant, field)),
        dynamic_field_value(input, variant, field),
    );
    meta_block_finish(block, meta_expr_var("__goml_serde_typed_field"))
}

#[comptime_derive]
fn dynamic_variant(input: DeriveInput, variant: isize) -> MetaExpr {
    let mut body = result_ok(constructed_value(input, variant));
    let mut field = field_count(input, variant);
    while field > 0 {
        field -= 1;
        if is_flatten(input, variant, field) {
            body = result_match(
                typed_dynamic_field(input, variant, field),
                field_binding(field),
                body,
            );
        }
    }
    field = field_count(input, variant);
    while field > 0 {
        field -= 1;
        if !is_flatten(input, variant, field) {
            body = result_match(
                typed_dynamic_field(input, variant, field),
                field_binding(field),
                body,
            );
        }
    }
    result_match(
        definition_call(
            input,
            "policy_payload_fields",
            exprs_three(
                meta_expr_var("__goml_serde_payload"),
                meta_expr_int(derive_variant_kind(input, variant)),
                meta_expr_int(decoded_count(input, variant)),
            ),
        ),
        "__goml_serde_payload_fields",
        body,
    )
}

#[comptime_derive]
fn deserialize_custom_enum(input: DeriveInput) -> MetaExpr {
    let block = meta_block_new();
    meta_block_expr(
        block,
        meta_expr_try(
            definition_call(
                input,
                "require_readable",
                exprs_two(
                    deserializer_call("is_human_readable", exprs()),
                    meta_expr_string("enum representation"),
                ),
            ),
        ),
    );
    let raw = try_deserializer_call("deserialize_any", exprs());
    if policy(input, -1, -1, "untagged") != "" {
        meta_block_let(block, "__goml_serde_payload", raw);
        for variant in 0..derive_variant_count(input) {
            meta_block_let_typed(
                block,
                "__goml_serde_candidate",
                result_type(derive_target_type(input)),
                dynamic_variant(input, variant),
            );
            meta_block_expr(
                block,
                meta_expr_if(
                    meta_expr_method_call(meta_expr_var("__goml_serde_candidate"), "is_ok", exprs()),
                    meta_expr_return(meta_expr_var("__goml_serde_candidate")),
                    meta_expr_unit(),
                ),
            );
        }
        meta_block_finish(block, deserializer_result_err("no untagged enum variant matched"))
    } else {
        meta_block_let(
            block,
            "__goml_serde_tagged",
            meta_expr_try(
                definition_call(
                    input,
                    "policy_tagged_parts",
                    exprs_three(
                        raw,
                        meta_expr_string(policy(input, -1, -1, "tag")),
                        meta_expr_string(policy(input, -1, -1, "content")),
                    ),
                ),
            ),
        );
        meta_block_let(
            block,
            "__goml_serde_payload",
            definition_call(
                input,
                "policy_tag_payload",
                exprs_one(meta_expr_var("__goml_serde_tagged")),
            ),
        );
        let mut branch = deserializer_result_err("unknown enum variant");
        let mut variant = derive_variant_count(input);
        while variant > 0 {
            variant -= 1;
            branch = meta_expr_if(
                meta_expr_binary(
                    16,
                    definition_call(
                        input,
                        "policy_tag_name",
                        exprs_one(meta_expr_var("__goml_serde_tagged")),
                    ),
                    meta_expr_string(wire_variant_name(input, variant)),
                ),
                dynamic_variant(input, variant),
                branch,
            );
        }
        meta_block_finish(block, branch)
    }
}

#[comptime_derive(Deserialize)]
pub fn derive_deserialize(input: DeriveInput) -> DeriveOutput {
    validate_policies(input);
    let output = derive_output_new(input, "Deserialize");
    add_predicates(input, output, false);
    let params = meta_param_list_new();
    meta_param_list_push(params, "deserializer", meta_type_call_site("D"));
    let generics = meta_generic_list_new();
    meta_generic_list_push(generics, "D");
    meta_generic_list_add_bound(input, generics, "D", "Deserializer");
    let body = if derive_item_kind(input) == 0 {
        deserialize_fields_body(input, -1)
    } else if custom_enum(input) {
        deserialize_custom_enum(input)
    } else {
        deserialize_enum_body(input)
    };
    derive_output_add_method(
        output,
        meta_method_generic(
            "deserialize",
            generics,
            params,
            result_type(derive_target_type(input)),
            body,
        ),
    );
    output
}
