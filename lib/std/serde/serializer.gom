package serde;

pub trait Serializer {
    fn is_human_readable(self: Self) -> bool {
        true
    }
    fn serialize_unit(self: Self) -> Result[(), string];
    fn serialize_bool(self: Self, value: bool) -> Result[(), string];
    fn serialize_int(self: Self, value: isize) -> Result[(), string];
    fn serialize_int8(self: Self, value: i8) -> Result[(), string];
    fn serialize_int16(self: Self, value: i16) -> Result[(), string];
    fn serialize_int32(self: Self, value: i32) -> Result[(), string];
    fn serialize_int64(self: Self, value: i64) -> Result[(), string];
    fn serialize_uint(self: Self, value: usize) -> Result[(), string];
    fn serialize_uint8(self: Self, value: u8) -> Result[(), string];
    fn serialize_uint16(self: Self, value: u16) -> Result[(), string];
    fn serialize_uint32(self: Self, value: u32) -> Result[(), string];
    fn serialize_uint64(self: Self, value: u64) -> Result[(), string];
    fn serialize_float32(self: Self, value: f32) -> Result[(), string];
    fn serialize_float64(self: Self, value: f64) -> Result[(), string];
    fn serialize_number(self: Self, value: string) -> Result[(), string];
    fn serialize_string(self: Self, value: string) -> Result[(), string];
    fn serialize_char(self: Self, value: char) -> Result[(), string];
    fn serialize_bytes(self: Self, value: Slice[byte]) -> Result[(), string];
    fn serialize_extension(self: Self, tag: i8, data: Slice[byte]) -> Result[(), string] {
        Result::Err("format does not support extension values")
    }
    fn begin_optional(self: Self, present: bool) -> Result[(), string];
    fn end_optional(self: Self) -> Result[(), string];
    fn begin_sequence(self: Self, length: isize) -> Result[(), string];
    fn begin_sequence_element(self: Self, index: isize) -> Result[(), string];
    fn end_sequence(self: Self) -> Result[(), string];
    fn begin_tuple(self: Self, length: isize) -> Result[(), string];
    fn begin_tuple_element(self: Self, index: isize) -> Result[(), string];
    fn end_tuple(self: Self) -> Result[(), string];
    fn begin_map(self: Self, length: isize) -> Result[(), string];
    fn begin_map_key(self: Self, index: isize) -> Result[(), string];
    fn begin_map_value(self: Self, index: isize) -> Result[(), string];
    fn end_map(self: Self) -> Result[(), string];
    fn begin_struct(self: Self, name: string, fields: isize) -> Result[(), string];
    fn begin_struct_field(self: Self, index: isize, name: string) -> Result[(), string];
    fn end_struct(self: Self) -> Result[(), string];
    fn begin_variant(
        self: Self,
        enum_name: string,
        index: isize,
        name: string,
        kind: isize,
        fields: isize,
    ) -> Result[(), string];
    fn begin_variant_field(self: Self, index: isize, name: string) -> Result[(), string];
    fn end_variant(self: Self) -> Result[(), string];
}

pub fn serialize_value_into[S: Serializer](value: Value, serializer: S) -> Result[(), string] {
    match value {
        Value::Unit => serializer.serialize_unit(),
        Value::Bool(value) => serializer.serialize_bool(value),
        Value::Int(value) => serializer.serialize_int(value),
        Value::Int8(value) => serializer.serialize_int8(value),
        Value::Int16(value) => serializer.serialize_int16(value),
        Value::Int32(value) => serializer.serialize_int32(value),
        Value::Int64(value) => serializer.serialize_int64(value),
        Value::Uint(value) => serializer.serialize_uint(value),
        Value::Uint8(value) => serializer.serialize_uint8(value),
        Value::Uint16(value) => serializer.serialize_uint16(value),
        Value::Uint32(value) => serializer.serialize_uint32(value),
        Value::Uint64(value) => serializer.serialize_uint64(value),
        Value::Float32(value) => serializer.serialize_float32(value),
        Value::Float64(value) => serializer.serialize_float64(value),
        Value::Number(value) => serializer.serialize_number(value),
        Value::String(value) => serializer.serialize_string(value),
        Value::Char(value) => serializer.serialize_char(value),
        Value::Binary(value) => serializer.serialize_bytes(value.as_slice()),
        Value::Extension { tag, data } => serializer.serialize_extension(tag, data.as_slice()),
        Value::Map(entries) => {
            serializer.begin_map(entries.len())?;
            for index in 0..entries.len() {
                let entry = entries[index];
                serializer.begin_map_key(index)?;
                serialize_value_into(entry.0, serializer)?;
                serializer.begin_map_value(index)?;
                serialize_value_into(entry.1, serializer)?;
            }
            serializer.end_map()
        },
        Value::Sequence(values) => {
            serializer.begin_sequence(values.len())?;
            let mut index = 0;
            for value in values {
                serializer.begin_sequence_element(index)?;
                serialize_value_into(value, serializer)?;
                index += 1;
            }
            serializer.end_sequence()
        },
        Value::Tuple(values) => {
            serializer.begin_tuple(values.len())?;
            let mut index = 0;
            for value in values {
                serializer.begin_tuple_element(index)?;
                serialize_value_into(value, serializer)?;
                index += 1;
            }
            serializer.end_tuple()
        },
        Value::Optional(values) => if values.is_empty() {
            serializer.begin_optional(false)?;
            serializer.end_optional()
        } else if values.len() == 1 {
            serializer.begin_optional(true)?;
            serialize_value_into(values[0], serializer)?;
            serializer.end_optional()
        } else {
            Result::Err("optional value contains more than one item")
        },
        Value::Struct(fields) => {
            serializer.begin_struct("", fields.len())?;
            let mut index = 0;
            for field in fields {
                serializer.begin_struct_field(index, field.0)?;
                serialize_value_into(field.1, serializer)?;
                index += 1;
            }
            serializer.end_struct()
        },
        Value::Variant { index, name, kind, fields } => {
            serializer.begin_variant("", index, name, kind, fields.len())?;
            let mut field_index = 0;
            for field in fields {
                serializer.begin_variant_field(field_index, field.0)?;
                serialize_value_into(field.1, serializer)?;
                field_index += 1;
            }
            serializer.end_variant()
        },
    }
}
