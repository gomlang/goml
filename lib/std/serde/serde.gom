    fn serialize[S: Serializer](self: (), serializer: S) -> Result[(), string] {
        serializer.serialize_unit()
    }
}

impl Deserialize for () {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[(), string] {
        deserializer.deserialize_unit()
    }
}

