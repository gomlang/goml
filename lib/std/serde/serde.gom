impl[T: Serialize] Serialize for Vec[T] {
    fn serialize[S: Serializer](self: Vec[T], serializer: S) -> Result[(), string] {
        serializer.begin_sequence(self.len())?;
        let mut index = 0;
        while index < self.len() {
            serializer.begin_sequence_element(index)?;
            Serialize::serialize(self[index], serializer)?;
            index += 1;
        }
        serializer.end_sequence()
    }
}

impl[T: Deserialize] Deserialize for Vec[T] {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[Vec[T], string] {
        let length = deserializer.begin_sequence()?;
        let result: Vec[T] = Vec::with_capacity(length.unwrap_or(0));
        while deserializer.next_sequence_element()? {
            let item: T = Deserialize::deserialize(deserializer)?;
            result.push(item)
        }
        deserializer.end_sequence()?;
        Result::Ok(result)
    }
}

impl[T: Serialize] Serialize for Option[T] {
    fn serialize[S: Serializer](self: Option[T], serializer: S) -> Result[(), string] {
        match self {
            Some(value) => {
                serializer.begin_optional(true)?;
                Serialize::serialize(value, serializer)?;
                serializer.end_optional()
            },
            None => {
                serializer.begin_optional(false)?;
                serializer.end_optional()
            },
        }
    }
}

impl[T: Deserialize] Deserialize for Option[T] {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[Option[T], string] {
        let result = if deserializer.begin_optional()? {
            let item: T = Deserialize::deserialize(deserializer)?;
            Option::Some(item)
        } else {
            Option::None
        };
        deserializer.end_optional()?;
        Result::Ok(result)
    }
}

impl[A: Serialize, B: Serialize] Serialize for (A, B) {
    fn serialize[S: Serializer](self: (A, B), serializer: S) -> Result[(), string] {
        serializer.begin_tuple(2)?;
        serializer.begin_tuple_element(0)?;
        Serialize::serialize(self.0, serializer)?;
        serializer.begin_tuple_element(1)?;
        Serialize::serialize(self.1, serializer)?;
        serializer.end_tuple()
    }
}

impl[A: Deserialize, B: Deserialize] Deserialize for (A, B) {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[(A, B), string] {
        deserializer.begin_tuple(2)?;
        deserializer.begin_tuple_element(0)?;
        let first: A = Deserialize::deserialize(deserializer)?;
        deserializer.begin_tuple_element(1)?;
        let second: B = Deserialize::deserialize(deserializer)?;
        deserializer.end_tuple()?;
        Result::Ok((first, second))
    }
}

impl[A: Serialize, B: Serialize, C: Serialize] Serialize for (A, B, C) {
    fn serialize[S: Serializer](self: (A, B, C), serializer: S) -> Result[(), string] {
        serializer.begin_tuple(3)?;
        serializer.begin_tuple_element(0)?;
        Serialize::serialize(self.0, serializer)?;
        serializer.begin_tuple_element(1)?;
        Serialize::serialize(self.1, serializer)?;
        serializer.begin_tuple_element(2)?;
        Serialize::serialize(self.2, serializer)?;
        serializer.end_tuple()
    }
}

impl[A: Deserialize, B: Deserialize, C: Deserialize] Deserialize for (A, B, C) {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[(A, B, C), string] {
        deserializer.begin_tuple(3)?;
        deserializer.begin_tuple_element(0)?;
        let first: A = Deserialize::deserialize(deserializer)?;
        deserializer.begin_tuple_element(1)?;
        let second: B = Deserialize::deserialize(deserializer)?;
        deserializer.begin_tuple_element(2)?;
        let third: C = Deserialize::deserialize(deserializer)?;
        deserializer.end_tuple()?;
        Result::Ok((first, second, third))
    }
}
