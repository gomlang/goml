package serde;

pub enum Value {
    Unit,
    Bool(bool),
    Int(isize),
    Int8(i8),
    Int16(i16),
    Int32(i32),
    Int64(i64),
    Uint(usize),
    Uint8(u8),
    Uint16(u16),
    Uint32(u32),
    Uint64(u64),
    Float32(f32),
    Float64(f64),
    Number(string),
    String(string),
    Char(char),
    Binary(Vec[byte]),
    Map(Vec[(Value, Value)]),
    Extension {
        tag: i8,
        data: Vec[byte],
    },
    Sequence(Vec[Value]),
    Tuple(Vec[Value]),
    Optional(Vec[Value]),
    Struct(Vec[(string, Value)]),
    Variant {
        index: isize,
        name: string,
        kind: isize,
        fields: Vec[(string, Value)],
    },
}

pub enum Schema {
    Any,
    Unit,
    Bool,
    Integer {
        signed: bool,
        width: isize,
    },
    Float(isize),
    String,
    Char,
    Sequence(Vec[Schema]),
    Tuple(Vec[Schema]),
    Optional(Vec[Schema]),
    Struct(Vec[(string, Schema)]),
    Enum(Vec[VariantSchema]),
}

pub struct VariantSchema {
    pub index: isize,
    pub name: string,
    pub kind: isize,
    pub fields: Vec[(string, Schema)],
}

pub struct TypedSchema[T] {
    pub value: Schema,
}

pub trait Serialize {
    fn serialize[S: Serializer](self: Self, serializer: S) -> Result[(), string];
}

pub trait Deserialize {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[Self, string];
}

pub fn to_value[T: Serialize](value: T) -> Result[Value, string] {
    let serializer = value_serializer();
    Serialize::serialize(value, serializer)?;
    finish_value_serializer(serializer)
}

pub fn from_value[T: Deserialize](value: Value) -> Result[T, string] {
    let deserializer = value_deserializer(value);
    let decoded: T = Deserialize::deserialize(deserializer)?;
    finish_value_deserializer(deserializer)?;
    Result::Ok(decoded)
}

pub fn structure(fields: Vec[(string, Value)]) -> Value {
    Value::Struct(fields)
}

pub fn variant(index: isize, name: string, kind: isize, fields: Vec[(string, Value)]) -> Value {
    Value::Variant { index, name, kind, fields }
}

pub fn typed_schema[T](value: Schema) -> TypedSchema[T] {
    TypedSchema { value }
}

pub fn structure_schema(fields: Vec[(string, Schema)]) -> Schema {
    Schema::Struct(fields)
}

pub fn variant_schema(index: isize, name: string, kind: isize, fields: Vec[(string, Schema)]) -> VariantSchema {
    VariantSchema { index, name, kind, fields }
}

pub fn enumeration_schema(variants: Vec[VariantSchema]) -> Schema {
    Schema::Enum(variants)
}

pub fn field(value: Value, name: string) -> Result[Value, string] {
    match value {
        Value::Struct(fields) => named_field(fields, name),
        _ => Result::Err("expected struct value"),
    }
}

pub fn named_field(fields: Vec[(string, Value)], name: string) -> Result[Value, string] {
    for field in fields {
        if field.0 == name {
            return Result::Ok(field.1)
        }
    }
    Result::Err("missing field `" + name + "`")
}

pub fn positional_field(fields: Vec[(string, Value)], index: isize) -> Result[Value, string] {
    if index < 0 || index >= fields.len() {
        Result::Err(f"missing positional field {index}")
    } else {
        Result::Ok(fields[index].1)
    }
}

pub fn variant_parts(value: Value) -> Result[(string, isize, Vec[(string, Value)]), string] {
    match value {
        Value::Variant { index: _, name, kind, fields } => Result::Ok((name, kind, fields)),
        Value::String(name) => Result::Ok((name, 0, Vec::new())),
        Value::Struct(fields) => if fields.len() == 1 {
            let entry = fields[0];
            match entry.1 {
                Value::Sequence(values) => {
                    let result: Vec[(string, Value)] = Vec::with_capacity(values.len());
                    for value in values {
                        result.push(("", value))
                    }
                    Result::Ok((entry.0, 1, result))
                },
                Value::Struct(values) => Result::Ok((entry.0, 2, values)),
                value => Result::Ok((entry.0, 1, Vec::from_array([("", value)]))),
            }
        } else {
            Result::Err("expected externally tagged enum value")
        },
        _ => Result::Err("expected enum variant"),
    }
}

pub fn error(message: string) -> Result[(), string] {
    Result::Err(message)
}

impl Serialize for Value {
    fn serialize[S: Serializer](self: Value, serializer: S) -> Result[(), string] {
        serialize_value_into(self, serializer)
    }
}

impl Deserialize for Value {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[Value, string] {
        deserializer.deserialize_any()
    }
}

