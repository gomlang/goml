package syscall;

pub fn syscall6(number: usize, words: [usize; 6], buffers: [MutSlice[byte]; 6]) -> (
    bool,
    usize,
    usize,
    usize,
) {
    __goml_std_linux_syscall6(number, words, buffers)
}

pub fn syscall6_with_pointers(
    number: usize,
    words: [usize; 6],
    buffers: [MutSlice[byte]; 6],
    slots: Slice[MutSlice[byte]],
    targets: Slice[MutSlice[byte]],
) -> (bool, usize, usize, usize) {
    __goml_std_linux_syscall6_pointers(number, words, buffers, slots, targets)
}
