package task;

pub struct ScopeHandle {
    id: i64,
}

pub struct CancelToken {
    id: i64,
}

fn scope_new(parent: i64) -> i64 {
    __goml_std_task_scope_new(parent)
}

fn scope_spawn(scope: i64, body: () -> ()) -> bool {
    __goml_std_task_scope_spawn(scope, body)
}

fn scope_run(scope: i64, body: () -> ()) -> () {
    __goml_std_task_scope_run(scope, body)
}

fn scope_try_spawn(scope: i64, body: () -> ()) -> bool {
    __goml_std_task_scope_try_spawn(scope, body)
}

fn scope_cancel(scope: i64) -> () {
    __goml_std_task_scope_cancel(scope)
}

fn scope_finish(scope: i64) -> () {
    __goml_std_task_scope_finish(scope)
}

fn scope_cancelled(scope: i64) -> bool {
    __goml_std_task_scope_cancelled(scope)
}

fn scope_done(scope: i64) -> Receiver[()] {
    __goml_std_task_scope_done(scope)
}

fn scope_sleep(scope: i64, nanoseconds: i64) -> bool {
    __goml_std_task_scope_sleep(scope, nanoseconds)
}

fn scope_count() -> isize {
    __goml_std_task_scope_count()
}

pub fn root_scope() -> ScopeHandle {
    ScopeHandle { id: scope_new(0) }
}

pub fn child_scope(parent: CancelToken) -> ScopeHandle {
    ScopeHandle { id: scope_new(parent.id) }
}

pub fn spawn(scope: ScopeHandle, body: () -> ()) -> () {
    let _ = scope_spawn(scope.id, body);
}

pub fn try_spawn(scope: ScopeHandle, body: () -> ()) -> bool {
    scope_try_spawn(scope.id, body)
}

pub fn run(scope: ScopeHandle, body: () -> ()) -> () {
    scope_run(scope.id, body);
    scope_finish(scope.id)
}

pub fn cancel(scope: ScopeHandle) -> () {
    scope_cancel(scope.id)
}

pub fn finish(scope: ScopeHandle) -> () {
    scope_finish(scope.id)
}

pub fn token(scope: ScopeHandle) -> CancelToken {
    CancelToken { id: scope.id }
}

pub fn recv_with[T](cancel: CancelToken, channel: Channel[T]) -> (T, bool, bool) {
    channel_recv_cancel(channel, cancel.id)
}

pub fn send_with[T](cancel: CancelToken, channel: Channel[T], value: T) -> bool {
    channel_send_cancel(channel, value, cancel.id)
}

pub fn sleep_with(cancel: CancelToken, nanoseconds: i64) -> bool {
    scope_sleep(cancel.id, nanoseconds)
}

pub fn id(cancel: CancelToken) -> i64 {
    cancel.id
}

pub fn active_scope_count() -> isize {
    scope_count()
}

impl CancelToken {
    pub fn is_cancelled(self: CancelToken) -> bool {
        scope_cancelled(self.id)
    }

    pub fn done(self: CancelToken) -> Receiver[()] {
        scope_done(self.id)
    }
}
