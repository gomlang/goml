package linux;

use module::io;
use module::os::linux::syscall;

pub fn error(kind: io::ErrorKind, operation: string, message: string) -> io::Error {
    io::Error::new(kind, operation, Option::None, Option::None, message)
}

pub fn errno_error(operation: string, code: usize) -> io::Error {
    let kind = match code {
        2 => io::ErrorKind::NotFound,
        1 | 13 => io::ErrorKind::PermissionDenied,
        4 => io::ErrorKind::Interrupted,
        11 => io::ErrorKind::WouldBlock,
        17 => io::ErrorKind::AlreadyExists,
        9 | 20 | 22 | 36 | 40 | 75 => io::ErrorKind::InvalidInput,
        32 => io::ErrorKind::BrokenPipe,
        38 | 95 => io::ErrorKind::Unsupported,
        110 => io::ErrorKind::TimedOut,
        _ => io::ErrorKind::Other,
    };
    io::Error::new(
        kind,
        operation,
        Option::None,
        Option::Some(code.to_isize()),
        syscall::Errno(code).to_string(),
    )
}

fn checked(result: Result[syscall::SyscallResult, syscall::Error], operation: string) -> Result[
    usize,
    io::Error,
] {
    let value = result.map_err(
        |value| match value {
            syscall::Error::UnsupportedTarget => error(
                io::ErrorKind::Unsupported,
                operation,
                value.to_string(),
            ),
            syscall::Error::InvalidPointer { index: _, offset: _, length: _ } => error(
                io::ErrorKind::InvalidInput,
                operation,
                value.to_string(),
            ),
        },
    )?;
    value.into_result().map_err(|value| errno_error(operation, value.0))
}

pub fn call(number: usize, args: [syscall::Arg; 6], operation: string) -> Result[usize, io::Error] {
    checked(syscall::syscall6_with_buffers(number, args), operation)
}

pub fn invoke(number: usize, args: [syscall::Arg; 6], operation: string) -> Result[usize, io::Error] {
    loop {
        let result = call(number, args, operation);
        if let Err(value) = result {
            if value.raw_os_code() == Option::Some(syscall::EINTR.to_isize()) {
                continue;
            }
        }
        return result;
    }
}

pub fn call_pointers(
    number: usize,
    args: [syscall::Arg; 6],
    pointers: Slice[syscall::Pointer],
    operation: string,
) -> Result[usize, io::Error] {
    checked(syscall::syscall6_with_pointers(number, args, pointers), operation)
}

pub fn invoke_pointers(
    number: usize,
    args: [syscall::Arg; 6],
    pointers: Slice[syscall::Pointer],
    operation: string,
) -> Result[usize, io::Error] {
    loop {
        let result = call_pointers(number, args, pointers, operation);
        if let Err(value) = result {
            if value.raw_os_code() == Option::Some(syscall::EINTR.to_isize()) {
                continue;
            }
        }
        return result;
    }
}

pub fn zeroes(size: isize) -> Vec[byte] {
    let result: Vec[byte] = Vec::with_capacity(size);
    for _ in 0..size {
        result.push(0);
    }
    result
}

pub fn c_path(path: Slice[byte], operation: string) -> Result[Vec[byte], io::Error] {
    if path.contains(0) {
        return Result::Err(
            error(io::ErrorKind::InvalidInput, operation, "path contains a NUL byte"),
        )
    }
    let result = path.to_vec();
    result.push(0);
    Result::Ok(result)
}
