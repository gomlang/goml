package linux;

pub fn spawn(
    program: string,
    arguments: Vec[string],
    directory: string,
    environment: Vec[string],
    files: Vec[usize],
    new_session: bool,
    new_process_group: bool,
) -> (bool, isize, isize, usize, string) {
    __goml_linux_process_spawn(
        program,
        arguments,
        directory,
        environment,
        files,
        new_session,
        new_process_group,
    )
}
