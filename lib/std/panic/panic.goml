package panic;

pub struct Panic {
    message: string,
    stack: string,
    rethrow: () -> never,
}

impl Panic {
    pub fn message(self: Panic) -> string {
        self.message
    }

    pub fn stack_trace(self: Panic) -> string {
        self.stack
    }
}

impl ToString for Panic {
    fn to_string(self: Panic) -> string {
        self.message
    }
}

pub fn raise(message: string) -> never {
    __goml_std_panic_raise(message)
}

pub fn resume(info: Panic) -> never {
    (info.rethrow)()
}

pub fn catch[T](body: () -> T) -> Result[T, Panic] {
    let result: Ref[Option[Result[T, Panic]]] = Ref::new(Option::None);
    __goml_std_panic_catch(
        || result.set(Option::Some(Result::Ok(body()))),
        |message, stack, rethrow| result.set(
            Option::Some(Result::Err(Panic { message, stack, rethrow })),
        ),
    );
    match result.get() {
        Some(value) => value,
        None => raise("panic boundary returned without a result"),
    }
}
