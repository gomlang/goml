}

fn decimal_string(value: u64) -> string {
    if value == 0 {
        return "0"
    }
    let reversed: Vec[byte] = vec_with_capacity(20);
    let mut remaining = value;
    while remaining > 0 {
        reversed.push((remaining % 10).to_u8() + b'0');
        remaining /= 10;
    }
    let bytes: Vec[byte] = vec_with_capacity(reversed.len());
    let mut offset = 0;
    while offset < reversed.len() {
        bytes.push(reversed[reversed.len() - offset - 1]);
        offset += 1;
    }
    let (_, result) = string_from_utf8_raw(bytes);
    result
}

fn signed_decimal_string(value: i64) -> string {
    if value < 0 {
        "-" + decimal_string(0 - value.to_u64())
    } else {
        decimal_string(value.to_u64())
    }
}

fn __goml_builtin_string_concat(values: Vec[string]) -> string {
    let mut length = 0;
    let mut value_index = 0;
    while value_index < values.len() {
        length += values[value_index].byte_len();
        value_index += 1;
    }
    let bytes: Vec[byte] = vec_with_capacity(length);
    value_index = 0;
    while value_index < values.len() {
        let value = values[value_index];
        let mut byte_index = 0;
        while byte_index < value.byte_len() {
            bytes.push(value.byte_get(byte_index));
            byte_index += 1;
        }
        value_index += 1;
    }
    let (_, result) = string_from_utf8_raw(bytes);
    result
}

