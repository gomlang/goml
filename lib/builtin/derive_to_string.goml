package builtin;

#[comptime_derive]
fn derive_to_string_attribute(input: DeriveInput, variant: isize) -> isize {
    let mut found = -1;
    for index in 0..derive_variant_attribute_count(input, variant) {
        let attribute = derive_variant_attribute(input, variant, index);
        if meta_attribute_name(attribute) == "to_string" {
            if found >= 0 {
                let _ = derive_error_at(attribute, "duplicate to_string attribute");
            }
            if meta_attribute_argument_count(attribute) != 1 {
                let _ = derive_error_at(attribute, "to_string requires exactly one string template");
            }
            if meta_attribute_argument_kind(attribute, 0) != "string" {
                let _ = derive_error_at_argument(
                    attribute,
                    0,
                    "to_string requires a string template",
                );
            }
            found = index;
        }
    }
    found
}

#[comptime_derive]
fn derive_to_string_validate(input: DeriveInput) -> () {
    for index in 0..derive_attribute_count(input) {
        let attribute = derive_attribute(input, index);
        if meta_attribute_name(attribute) == "to_string" {
            let _ = derive_error_at(attribute, "to_string templates belong on enum variants");
        }
    }
    if derive_item_kind(input) == 0 {
        for field in 0..derive_field_count(input) {
            for index in 0..derive_field_attribute_count(input, field) {
                let attribute = derive_field_attribute(input, field, index);
                if meta_attribute_name(attribute) == "to_string" {
                    let _ = derive_error_at(
                        attribute,
                        "to_string templates belong on enum variants",
                    );
                }
            }
        }
    } else {
        for variant in 0..derive_variant_count(input) {
            let _ = derive_to_string_attribute(input, variant);
            for field in 0..derive_variant_field_count(input, variant) {
                for index in 0..derive_variant_field_attribute_count(input, variant, field) {
                    let attribute = derive_variant_field_attribute(input, variant, field, index);
                    if meta_attribute_name(attribute) == "to_string" {
                        let _ = derive_error_at(
                            attribute,
                            "to_string templates belong on enum variants",
                        );
                    }
                }
            }
        }
    }
}

#[comptime_derive]
fn derive_to_string_piece(
    input: DeriveInput,
    variant: isize,
    attribute: MetaAttribute,
    offset: isize,
) -> (isize, isize, string) {
    let template = meta_attribute_argument_text(attribute, 0);
    let first = template.byte_get(offset);
    if first == b'{' || first == b'}' {
        if offset + 1 < template.byte_len() && template.byte_get(offset + 1) == first {
            return (offset + 2, -1, template.byte_slice(offset, offset + 1))
        }
        if first == b'}' {
            let _ = derive_error_at_argument(attribute, 0, "unmatched `}` in to_string template");
        }
        let mut end = offset + 1;
        while end < template.byte_len() && template.byte_get(end) != b'}' {
            end += 1;
        }
        if end == template.byte_len() {
            let _ = derive_error_at_argument(
                attribute,
                0,
                "unclosed placeholder in to_string template",
            );
        }
        let name = template.byte_slice(offset + 1, end);
        for field in 0..derive_variant_field_count(input, variant) {
            let expected = if derive_variant_kind(input, variant) == 2 {
                derive_variant_field_name(input, variant, field)
            } else {
                field.to_string()
            };
            if name == expected {
                return (end + 1, field, "")
            }
        }
        let _ = derive_error_at_argument(
            attribute,
            0,
            "unknown field `" + name + "` in to_string template",
        );
        (end + 1, -1, "")
    } else {
        let mut end = offset + 1;
        while end < template.byte_len() && template.byte_get(end) != b'{'
            && template.byte_get(end) != b'}' {
            end += 1;
        };
        (end, -1, template.byte_slice(offset, end))
    }
}

#[comptime_derive]
fn derive_to_string_field_used(input: DeriveInput, variant: isize, field: isize) -> bool {
    let index = derive_to_string_attribute(input, variant);
    if index < 0 {
        return true
    }
    let attribute = derive_variant_attribute(input, variant, index);
    let template = meta_attribute_argument_text(attribute, 0);
    let mut offset = 0;
    while offset < template.byte_len() {
        let piece = derive_to_string_piece(input, variant, attribute, offset);
        if piece.1 == field {
            return true
        }
        offset = piece.0;
    }
    false
}

#[comptime_derive]
fn derive_to_string_type_seen(input: DeriveInput, variant: isize, field: isize, ty: MetaType) -> bool {
    for previous_variant in 0..variant + 1 {
        let count = if previous_variant == variant {
            field
        } else {
            derive_variant_field_count(input, previous_variant)
        };
        for previous_field in 0..count {
            if meta_type_equal(
                derive_variant_field_type(input, previous_variant, previous_field),
                ty,
            )
                && derive_to_string_field_used(input, previous_variant, previous_field) {
                return true
            }
        }
    }
    false
}

#[comptime_derive]
fn derive_to_string_add_predicates(input: DeriveInput, output: DeriveOutput) -> () {
    if derive_item_kind(input) == 0 {
        derive_add_predicates(input, output, "ToString")
    } else {
        for variant in 0..derive_variant_count(input) {
            for field in 0..derive_variant_field_count(input, variant) {
                let ty = derive_variant_field_type(input, variant, field);
                if meta_type_contains_generic(input, ty)
                    && derive_to_string_field_used(input, variant, field)
                    && !derive_to_string_type_seen(input, variant, field, ty) {
                    derive_output_add_predicate(output, ty, "ToString")
                }
            }
        }
    }
}

#[comptime_derive]
fn derive_to_string_template_arm(input: DeriveInput, variant: isize, index: isize) -> MetaArm {
    let attribute = derive_variant_attribute(input, variant, index);
    derive_set_span(meta_attribute_argument_span(attribute, 0));
    let positional = meta_pattern_list_new();
    let named = meta_pattern_field_list_new();
    let caches: Vec[string] = Vec::new();
    let block = meta_block_new();
    for field in 0..derive_variant_field_count(input, variant) {
        let used = derive_to_string_field_used(input, variant, field);
        let binding = derive_fresh_name(input, "field");
        let pattern = if used {
            meta_pattern_bind(binding)
        } else {
            meta_pattern_wild()
        };
        if derive_variant_kind(input, variant) == 2 {
            meta_pattern_field_list_push(
                named,
                derive_variant_field_name(input, variant, field),
                pattern,
            )
        } else {
            meta_pattern_list_push(positional, pattern)
        }
        if used {
            let cache = derive_fresh_name(input, "formatted");
            meta_block_let(
                block,
                cache,
                derive_format_value(
                    input,
                    meta_expr_var(binding),
                    derive_variant_field_type(input, variant, field),
                    "ToString",
                    "to_string",
                ),
            );
            caches.push(cache);
        } else {
            caches.push("");
        }
    }
    let template = meta_attribute_argument_text(attribute, 0);
    let mut offset = 0;
    let mut result = meta_expr_string("");
    while offset < template.byte_len() {
        let piece = derive_to_string_piece(input, variant, attribute, offset);
        let value = if piece.1 < 0 {
            meta_expr_string(piece.2)
        } else {
            meta_expr_var(caches.get(piece.1))
        };
        result = derive_concat(result, value);
        offset = piece.0;
    }
    let pattern = if derive_variant_kind(input, variant) == 2 {
        meta_pattern_struct(
            derive_item_name(input) + "::" + derive_variant_name(input, variant),
            named,
            false,
        )
    } else {
        meta_pattern_target_constructor(input, derive_variant_name(input, variant), positional)
    };
    let arm = meta_arm(pattern, meta_block_finish(block, result));
    derive_set_span(derive_span(input));
    arm
}
