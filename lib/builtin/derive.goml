package builtin;

#[comptime_derive]
fn derive_expr_list_one(value: MetaExpr) -> MetaExprList {
    let values = meta_expr_list_new();
    meta_expr_list_push(values, value);
    values
}

#[comptime_derive]
fn derive_expr_list_two(first: MetaExpr, second: MetaExpr) -> MetaExprList {
    let values = meta_expr_list_new();
    meta_expr_list_push(values, first);
    meta_expr_list_push(values, second);
    values
}

#[comptime_derive]
fn derive_trait_call(
    input: DeriveInput,
    trait_name: string,
    method_name: string,
    values: MetaExprList,
) -> MetaExpr {
    meta_expr_trait_call(input, trait_name, method_name, values)
}

#[comptime_derive]
fn derive_format_value(
    input: DeriveInput,
    value: MetaExpr,
    ty: MetaType,
    trait_name: string,
    method_name: string,
) -> MetaExpr {
    if trait_name == "ToString" && meta_type_kind(ty) == "primitive"
        && meta_type_name(ty) == "string" {
        value
    } else {
        derive_trait_call(input, trait_name, method_name, derive_expr_list_one(value))
    }
}

#[comptime_derive]
fn derive_concat(left: MetaExpr, right: MetaExpr) -> MetaExpr {
    meta_expr_binary(0, left, right)
}

#[comptime_derive]
fn derive_and(left: MetaExpr, right: MetaExpr) -> MetaExpr {
    meta_expr_binary(10, left, right)
}

#[comptime_derive]
fn derive_struct_type_seen(input: DeriveInput, index: isize, ty: MetaType) -> bool {
    let mut previous = 0;
    while previous < index {
        if meta_type_equal(derive_field_type(input, previous), ty) {
            return true
        }
        previous += 1;
    }
    false
}

#[comptime_derive]
fn derive_enum_type_seen(input: DeriveInput, variant_index: isize, field_index: isize, ty: MetaType) -> bool {
    let mut previous_variant = 0;
    while previous_variant < variant_index {
        let mut previous_field = 0;
        while previous_field < derive_variant_field_count(input, previous_variant) {
            if meta_type_equal(
                derive_variant_field_type(input, previous_variant, previous_field),
                ty,
            ) {
                return true
            }
            previous_field += 1;
        }
        previous_variant += 1;
    }
    let mut previous_field = 0;
    while previous_field < field_index {
        if meta_type_equal(derive_variant_field_type(input, variant_index, previous_field), ty) {
            return true
        }
        previous_field += 1;
    }
    false
}

#[comptime_derive]
fn derive_add_predicates(input: DeriveInput, output: DeriveOutput, trait_name: string) -> () {
    if derive_item_kind(input) == 0 {
        let mut index = 0;
        while index < derive_field_count(input) {
            let ty = derive_field_type(input, index);
            if meta_type_contains_generic(input, ty) && !derive_struct_type_seen(input, index, ty) {
                derive_output_add_predicate(output, ty, trait_name)
            }
            index += 1;
        }
    } else {
        let mut variant_index = 0;
        while variant_index < derive_variant_count(input) {
            let mut field_index = 0;
            while field_index < derive_variant_field_count(input, variant_index) {
                let ty = derive_variant_field_type(input, variant_index, field_index);
                if meta_type_contains_generic(input, ty)
                    && !derive_enum_type_seen(input, variant_index, field_index, ty) {
                    derive_output_add_predicate(output, ty, trait_name)
                }
                field_index += 1;
            }
            variant_index += 1;
        }
    }
}

#[comptime_derive]
fn derive_add_all_predicates(input: DeriveInput, output: DeriveOutput, trait_name: string) -> () {
    if derive_item_kind(input) == 0 {
        let mut index = 0;
        while index < derive_field_count(input) {
            let ty = derive_field_type(input, index);
            if derive_struct_type_seen(input, index, ty) {} else {
                derive_output_add_predicate(output, ty, trait_name)
            }
            index += 1;
        }
    } else {
        let mut variant_index = 0;
        while variant_index < derive_variant_count(input) {
            let mut field_index = 0;
            while field_index < derive_variant_field_count(input, variant_index) {
                let ty = derive_variant_field_type(input, variant_index, field_index);
                if derive_enum_type_seen(input, variant_index, field_index, ty) {} else {
                    derive_output_add_predicate(output, ty, trait_name)
                }
                field_index += 1;
            }
            variant_index += 1;
        }
    }
}

#[comptime_derive]
fn derive_self_params(input: DeriveInput) -> MetaParamList {
    let params = meta_param_list_new();
    meta_param_list_push(params, "self", derive_target_type(input));
    params
}

#[comptime_derive]
fn derive_eq_params(input: DeriveInput) -> MetaParamList {
    let params = derive_self_params(input);
    meta_param_list_push(params, "other", derive_target_type(input));
    params
}

#[comptime_derive]
fn derive_struct_format_body(input: DeriveInput, trait_name: string, method_name: string) -> MetaExpr {
    let item_name = derive_item_name(input);
    if derive_field_count(input) == 0 {
        return meta_expr_string(item_name + " {}")
    }
    let block = meta_block_new();
    let fields = meta_pattern_field_list_new();
    let mut result = meta_expr_string(item_name + " { ");
    let mut index = 0;
    while index < derive_field_count(input) {
        let field_name = derive_field_name(input, index);
        let binding = derive_fresh_name(input, "field");
        meta_pattern_field_list_push(fields, field_name, meta_pattern_bind(binding));
        if index > 0 {
            result = derive_concat(result, meta_expr_string(", "));
        }
        result = derive_concat(result, meta_expr_string(field_name + ": "));
        result = derive_concat(
            result,
            derive_format_value(
                input,
                meta_expr_var(binding),
                derive_field_type(input, index),
                trait_name,
                method_name,
            ),
        );
        index += 1;
    }
    result = derive_concat(result, meta_expr_string(" }"));
    meta_block_let_pattern(
        block,
        meta_pattern_struct(item_name, fields, false),
        meta_expr_var("self"),
    );
    meta_block_finish(block, result)
}

#[comptime_derive]
fn derive_enum_format_body(input: DeriveInput, trait_name: string, method_name: string) -> MetaExpr {
    let item_name = derive_item_name(input);
    let arms = meta_arm_list_new();
    let mut variant_index = 0;
    while variant_index < derive_variant_count(input) {
        let variant_name = derive_variant_name(input, variant_index);
        let variant_kind = derive_variant_kind(input, variant_index);
        let field_count = derive_variant_field_count(input, variant_index);
        let positional = meta_pattern_list_new();
        let named = meta_pattern_field_list_new();
        let named_fields = variant_kind == 2;
        let mut result = if variant_kind == 0 {
            meta_expr_string(item_name + "::" + variant_name)
        } else if named_fields {
            meta_expr_string(item_name + "::" + variant_name + " { ")
        } else {
            meta_expr_string(item_name + "::" + variant_name + "(")
        };
        let mut field_index = 0;
        while field_index < field_count {
            let field_name = derive_variant_field_name(input, variant_index, field_index);
            let binding = derive_fresh_name(input, "field");
            if named_fields {
                meta_pattern_field_list_push(named, field_name, meta_pattern_bind(binding))
            } else {
                meta_pattern_list_push(positional, meta_pattern_bind(binding))
            }
            if field_index > 0 {
                result = derive_concat(result, meta_expr_string(", "));
            }
            if named_fields {
                result = derive_concat(result, meta_expr_string(field_name + ": "));
            }
            result = derive_concat(
                result,
                derive_format_value(
                    input,
                    meta_expr_var(binding),
                    derive_variant_field_type(input, variant_index, field_index),
                    trait_name,
                    method_name,
                ),
            );
            field_index += 1;
        }
        if variant_kind != 0 {
            result = derive_concat(
                result,
                if named_fields {
                    meta_expr_string(" }")
                } else {
                    meta_expr_string(")")
                },
            );
        }
        let constructor = item_name + "::" + variant_name;
        let pattern = if named_fields {
            meta_pattern_struct(constructor, named, false)
        } else {
            meta_pattern_constructor(constructor, positional)
        };
        meta_arm_list_push(arms, meta_arm(pattern, result));
        variant_index += 1;
    }
    meta_expr_match(meta_expr_var("self"), arms)
}

#[comptime_derive(ToString)]
pub fn derive_to_string(input: DeriveInput) -> DeriveOutput {
    let output = derive_output_new(input, "ToString");
    derive_add_predicates(input, output, "ToString");
    let body = if derive_item_kind(input) == 0 {
        derive_struct_format_body(input, "ToString", "to_string")
    } else {
        derive_enum_format_body(input, "ToString", "to_string")
    };
    derive_output_add_method(
        output,
        meta_method("to_string", derive_self_params(input), meta_type_call_site("string"), body),
    );
    output
}

#[comptime_derive(Debug)]
pub fn derive_debug(input: DeriveInput) -> DeriveOutput {
    let output = derive_output_new(input, "Debug");
    derive_add_predicates(input, output, "Debug");
    let body = if derive_item_kind(input) == 0 {
        derive_struct_format_body(input, "Debug", "debug")
    } else {
        derive_enum_format_body(input, "Debug", "debug")
    };
    derive_output_add_method(
        output,
        meta_method("debug", derive_self_params(input), meta_type_call_site("string"), body),
    );
    output
}

#[comptime_derive]
fn derive_struct_eq_body(input: DeriveInput, trait_name: string) -> MetaExpr {
    let mut result = meta_expr_bool(true);
    let mut index = 0;
    while index < derive_field_count(input) {
        let field_name = derive_field_name(input, index);
        result = derive_and(
            result,
            derive_trait_call(
                input,
                trait_name,
                "eq",
                derive_expr_list_two(
                    meta_expr_field(meta_expr_var("self"), field_name),
                    meta_expr_field(meta_expr_var("other"), field_name),
                ),
            ),
        );
        index += 1;
    }
    result
}

#[comptime_derive]
fn derive_enum_eq_body(input: DeriveInput, trait_name: string) -> MetaExpr {
    let item_name = derive_item_name(input);
    let arms = meta_arm_list_new();
    let mut variant_index = 0;
    while variant_index < derive_variant_count(input) {
        let variant_name = derive_variant_name(input, variant_index);
        let variant_kind = derive_variant_kind(input, variant_index);
        let field_count = derive_variant_field_count(input, variant_index);
        let named_fields = variant_kind == 2;
        let left_positional = meta_pattern_list_new();
        let right_positional = meta_pattern_list_new();
        let left_named = meta_pattern_field_list_new();
        let right_named = meta_pattern_field_list_new();
        let mut body = meta_expr_bool(true);
        let mut field_index = 0;
        while field_index < field_count {
            let field_name = derive_variant_field_name(input, variant_index, field_index);
            let left = derive_fresh_name(input, "left");
            let right = derive_fresh_name(input, "right");
            if named_fields {
                meta_pattern_field_list_push(left_named, field_name, meta_pattern_bind(left));
                meta_pattern_field_list_push(right_named, field_name, meta_pattern_bind(right))
            } else {
                meta_pattern_list_push(left_positional, meta_pattern_bind(left));
                meta_pattern_list_push(right_positional, meta_pattern_bind(right))
            }
            body = derive_and(
                body,
                derive_trait_call(
                    input,
                    trait_name,
                    "eq",
                    derive_expr_list_two(meta_expr_var(left), meta_expr_var(right)),
                ),
            );
            field_index += 1;
        }
        let constructor = item_name + "::" + variant_name;
        let left_pattern = if named_fields {
            meta_pattern_struct(constructor, left_named, false)
        } else {
            meta_pattern_constructor(constructor, left_positional)
        };
        let right_pattern = if named_fields {
            meta_pattern_struct(constructor, right_named, false)
        } else {
            meta_pattern_constructor(constructor, right_positional)
        };
        let tuple = meta_pattern_list_new();
        meta_pattern_list_push(tuple, left_pattern);
        meta_pattern_list_push(tuple, right_pattern);
        meta_arm_list_push(arms, meta_arm(meta_pattern_tuple(tuple), body));
        variant_index += 1;
    }
    if derive_variant_count(input) > 1 {
        meta_arm_list_push(arms, meta_arm(meta_pattern_wild(), meta_expr_bool(false)))
    }
    meta_expr_match(
        meta_expr_tuple(derive_expr_list_two(meta_expr_var("self"), meta_expr_var("other"))),
        arms,
    )
}

#[comptime_derive(PartialEq)]
pub fn derive_partial_eq(input: DeriveInput) -> DeriveOutput {
    let output = derive_output_new(input, "PartialEq");
    derive_add_predicates(input, output, "PartialEq");
    let body = if derive_item_kind(input) == 0 {
        derive_struct_eq_body(input, "PartialEq")
    } else {
        derive_enum_eq_body(input, "PartialEq")
    };
    derive_output_add_method(
        output,
        meta_method("eq", derive_eq_params(input), meta_type_call_site("bool"), body),
    );
    output
}

#[comptime_derive(Eq)]
pub fn derive_eq(input: DeriveInput) -> DeriveOutput {
    let output = derive_output_new(input, "Eq");
    derive_add_all_predicates(input, output, "Eq");
    output
}

#[comptime_derive]
fn derive_hash_step(input: DeriveInput, value: MetaExpr) -> MetaExpr {
    derive_concat(
        meta_expr_binary(
            2,
            meta_expr_var("h"),
            meta_expr_integer("1099511628211", meta_type_call_site("u64")),
        ),
        derive_trait_call(input, "Hash", "hash", derive_expr_list_one(value)),
    )
}

#[comptime_derive]
fn derive_hash_initial() -> MetaExpr {
    meta_expr_integer("14695981039346656037", meta_type_call_site("u64"))
}

#[comptime_derive]
fn derive_struct_hash_body(input: DeriveInput) -> MetaExpr {
    let block = meta_block_new();
    meta_block_let(block, "h", derive_hash_initial());
    let mut index = 0;
    while index < derive_field_count(input) {
        meta_block_let(
            block,
            "h",
            derive_hash_step(
                input,
                meta_expr_field(meta_expr_var("self"), derive_field_name(input, index)),
            ),
        );
        index += 1;
    }
    meta_block_finish(block, meta_expr_var("h"))
}

#[comptime_derive]
fn derive_enum_hash_body(input: DeriveInput) -> MetaExpr {
    let item_name = derive_item_name(input);
    let arms = meta_arm_list_new();
    let mut variant_index = 0;
    while variant_index < derive_variant_count(input) {
        let variant_name = derive_variant_name(input, variant_index);
        let variant_kind = derive_variant_kind(input, variant_index);
        let field_count = derive_variant_field_count(input, variant_index);
        let named_fields = variant_kind == 2;
        let positional = meta_pattern_list_new();
        let named = meta_pattern_field_list_new();
        let block = meta_block_new();
        meta_block_let(
            block,
            "h",
            derive_concat(derive_hash_initial(), meta_expr_int(variant_index + 1)),
        );
        let mut field_index = 0;
        while field_index < field_count {
            let field_name = derive_variant_field_name(input, variant_index, field_index);
            let binding = derive_fresh_name(input, "field");
            if named_fields {
                meta_pattern_field_list_push(named, field_name, meta_pattern_bind(binding))
            } else {
                meta_pattern_list_push(positional, meta_pattern_bind(binding))
            }
            meta_block_let(block, "h", derive_hash_step(input, meta_expr_var(binding)));
            field_index += 1;
        }
        let constructor = item_name + "::" + variant_name;
        let pattern = if named_fields {
            meta_pattern_struct(constructor, named, false)
        } else {
            meta_pattern_constructor(constructor, positional)
        };
        meta_arm_list_push(arms, meta_arm(pattern, meta_block_finish(block, meta_expr_var("h"))));
        variant_index += 1;
    }
    meta_expr_match(meta_expr_var("self"), arms)
}

#[comptime_derive(Hash)]
pub fn derive_hash(input: DeriveInput) -> DeriveOutput {
    let output = derive_output_new(input, "Hash");
    derive_add_predicates(input, output, "Hash");
    let body = if derive_item_kind(input) == 0 {
        derive_struct_hash_body(input)
    } else {
        derive_enum_hash_body(input)
    };
    derive_output_add_method(
        output,
        meta_method("hash", derive_self_params(input), meta_type_call_site("u64"), body),
    );
    output
}

#[comptime_derive]
fn derive_default_value(input: DeriveInput) -> MetaExpr {
    derive_trait_call(input, "Default", "default", meta_expr_list_new())
}

#[comptime_derive]
fn derive_add_default_predicates(input: DeriveInput, output: DeriveOutput) -> () {
    if derive_item_kind(input) == 0 {
        let mut index = 0;
        while index < derive_field_count(input) {
            let ty = derive_field_type(input, index);
            if meta_type_contains_generic(input, ty) && !derive_struct_type_seen(input, index, ty) {
                derive_output_add_predicate(output, ty, "Default")
            }
            index += 1;
        }
    } else if derive_variant_count(input) > 0 {
        let mut index = 0;
        while index < derive_variant_field_count(input, 0) {
            let ty = derive_variant_field_type(input, 0, index);
            if meta_type_contains_generic(input, ty) && !derive_enum_type_seen(input, 0, index, ty) {
                derive_output_add_predicate(output, ty, "Default")
            }
            index += 1;
        }
    }
}

#[comptime_derive]
fn derive_struct_default_body(input: DeriveInput) -> MetaExpr {
    let fields = meta_expr_field_list_new();
    let mut index = 0;
    while index < derive_field_count(input) {
        meta_expr_field_list_push(
            fields,
            derive_field_name(input, index),
            derive_default_value(input),
        );
        index += 1;
    }
    meta_expr_target_struct(input, fields)
}

#[comptime_derive]
fn derive_enum_default_body(input: DeriveInput) -> MetaExpr {
    let variant_name = derive_variant_name(input, 0);
    let kind = derive_variant_kind(input, 0);
    if kind == 2 {
        let fields = meta_expr_field_list_new();
        let mut index = 0;
        while index < derive_variant_field_count(input, 0) {
            meta_expr_field_list_push(
                fields,
                derive_variant_field_name(input, 0, index),
                derive_default_value(input),
            );
            index += 1;
        }
        meta_expr_target_variant_struct(input, variant_name, fields)
    } else {
        let values = meta_expr_list_new();
        let mut index = 0;
        while index < derive_variant_field_count(input, 0) {
            meta_expr_list_push(values, derive_default_value(input));
            index += 1;
        }
        meta_expr_target_constructor(input, variant_name, values)
    }
}

#[comptime_derive(Default)]
pub fn derive_default(input: DeriveInput) -> DeriveOutput {
    if derive_item_kind(input) != 0 && derive_variant_count(input) == 0 {
        derive_error(input, "Default cannot be derived for an empty enum")
    } else {
        let output = derive_output_new(input, "Default");
        derive_add_default_predicates(input, output);
        let body = if derive_item_kind(input) == 0 {
            derive_struct_default_body(input)
        } else {
            derive_enum_default_body(input)
        };
        derive_output_add_method(
            output,
            meta_method("default", meta_param_list_new(), derive_target_type(input), body),
        );
        output
    }
}

#[comptime_derive]
fn derive_call_site_trait(trait_name: string, method_name: string, values: MetaExprList) -> MetaExpr {
    meta_expr_trait_call_site(trait_name, method_name, values)
}

#[comptime_derive]
fn derive_ordering(name: string) -> MetaExpr {
    meta_expr_constructor("Ordering::" + name, meta_expr_list_new())
}

#[comptime_derive]
fn derive_some(value: MetaExpr) -> MetaExpr {
    meta_expr_constructor("Option::Some", derive_expr_list_one(value))
}

#[comptime_derive]
fn derive_none() -> MetaExpr {
    meta_expr_constructor("Option::None", meta_expr_list_new())
}

#[comptime_derive]
fn derive_ord_step(input: DeriveInput, left: MetaExpr, right: MetaExpr, rest: MetaExpr) -> MetaExpr {
    let block = meta_block_new();
    let result = derive_fresh_name(input, "ordering");
    meta_block_let(
        block,
        result,
        derive_call_site_trait("std::cmp::Ord", "cmp", derive_expr_list_two(left, right)),
    );
    meta_block_finish(
        block,
        meta_expr_if(
            meta_expr_binary(16, meta_expr_var(result), derive_ordering("Equal")),
            rest,
            meta_expr_var(result),
        ),
    )
}

#[comptime_derive]
fn derive_partial_ord_step(input: DeriveInput, left: MetaExpr, right: MetaExpr, rest: MetaExpr) -> MetaExpr {
    let arms = meta_arm_list_new();
    meta_arm_list_push(
        arms,
        meta_arm(meta_pattern_constructor("Option::None", meta_pattern_list_new()), derive_none()),
    );
    let equal = meta_pattern_list_new();
    meta_pattern_list_push(
        equal,
        meta_pattern_constructor("Ordering::Equal", meta_pattern_list_new()),
    );
    meta_arm_list_push(arms, meta_arm(meta_pattern_constructor("Option::Some", equal), rest));
    let ordering = derive_fresh_name(input, "ordering");
    let other = meta_pattern_list_new();
    meta_pattern_list_push(other, meta_pattern_bind(ordering));
    meta_arm_list_push(
        arms,
        meta_arm(
            meta_pattern_constructor("Option::Some", other),
            derive_some(meta_expr_var(ordering)),
        ),
    );
    meta_expr_match(
        derive_call_site_trait(
            "std::cmp::PartialOrd",
            "partial_cmp",
            derive_expr_list_two(left, right),
        ),
        arms,
    )
}

#[comptime_derive]
fn derive_struct_ord_body(input: DeriveInput, partial: bool) -> MetaExpr {
    let mut result = if partial {
        derive_some(derive_ordering("Equal"))
    } else {
        derive_ordering("Equal")
    };
    let mut index = derive_field_count(input);
    while index > 0 {
        index -= 1;
        let field_name = derive_field_name(input, index);
        let left = meta_expr_field(meta_expr_var("self"), field_name);
        let right = meta_expr_field(meta_expr_var("other"), field_name);
        result = if partial {
            derive_partial_ord_step(input, left, right, result)
        } else {
            derive_ord_step(input, left, right, result)
        };
    }
    result
}

#[comptime_derive]
fn derive_enum_tag(input: DeriveInput, value: MetaExpr) -> MetaExpr {
    let arms = meta_arm_list_new();
    let mut variant = 0;
    while variant < derive_variant_count(input) {
        let kind = derive_variant_kind(input, variant);
        let pattern = if kind == 2 {
            let fields = meta_pattern_field_list_new();
            let mut field = 0;
            while field < derive_variant_field_count(input, variant) {
                meta_pattern_field_list_push(
                    fields,
                    derive_variant_field_name(input, variant, field),
                    meta_pattern_wild(),
                );
                field += 1;
            }
            meta_pattern_struct(
                derive_item_name(input) + "::" + derive_variant_name(input, variant),
                fields,
                false,
            )
        } else {
            let fields = meta_pattern_list_new();
            let mut field = 0;
            while field < derive_variant_field_count(input, variant) {
                meta_pattern_list_push(fields, meta_pattern_wild());
                field += 1;
            }
            meta_pattern_target_constructor(input, derive_variant_name(input, variant), fields)
        };
        meta_arm_list_push(arms, meta_arm(pattern, meta_expr_int(variant)));
        variant += 1;
    }
    meta_expr_match(value, arms)
}

#[comptime_derive]
fn derive_enum_same_variant_body(input: DeriveInput, variant: isize, partial: bool) -> MetaArm {
    let kind = derive_variant_kind(input, variant);
    let left_positional = meta_pattern_list_new();
    let right_positional = meta_pattern_list_new();
    let left_named = meta_pattern_field_list_new();
    let right_named = meta_pattern_field_list_new();
    let mut body = if partial {
        derive_some(derive_ordering("Equal"))
    } else {
        derive_ordering("Equal")
    };
    let mut field = derive_variant_field_count(input, variant);
    while field > 0 {
        field -= 1;
        let left = derive_fresh_name(input, "left");
        let right = derive_fresh_name(input, "right");
        if kind == 2 {
            let name = derive_variant_field_name(input, variant, field);
            meta_pattern_field_list_push(left_named, name, meta_pattern_bind(left));
            meta_pattern_field_list_push(right_named, name, meta_pattern_bind(right))
        } else {
            meta_pattern_list_prepend(left_positional, meta_pattern_bind(left));
            meta_pattern_list_prepend(right_positional, meta_pattern_bind(right))
        }
        body = if partial {
            derive_partial_ord_step(input, meta_expr_var(left), meta_expr_var(right), body)
        } else {
            derive_ord_step(input, meta_expr_var(left), meta_expr_var(right), body)
        };
    }
    let constructor = derive_item_name(input) + "::" + derive_variant_name(input, variant);
    let left_pattern = if kind == 2 {
        meta_pattern_struct(constructor, left_named, false)
    } else {
        meta_pattern_constructor(constructor, left_positional)
    };
    let right_pattern = if kind == 2 {
        meta_pattern_struct(constructor, right_named, false)
    } else {
        meta_pattern_constructor(constructor, right_positional)
    };
    let pair = meta_pattern_list_new();
    meta_pattern_list_push(pair, left_pattern);
    meta_pattern_list_push(pair, right_pattern);
    meta_arm(meta_pattern_tuple(pair), body)
}

#[comptime_derive]
fn derive_enum_payload_order(input: DeriveInput, partial: bool) -> MetaExpr {
    let arms = meta_arm_list_new();
    let mut variant = 0;
    while variant < derive_variant_count(input) {
        meta_arm_list_push(arms, derive_enum_same_variant_body(input, variant, partial));
        variant += 1;
    }
    meta_arm_list_push(
        arms,
        meta_arm(
            meta_pattern_wild(),
            if partial {
                derive_some(derive_ordering("Equal"))
            } else {
                derive_ordering("Equal")
            },
        ),
    );
    meta_expr_match(
        meta_expr_tuple(derive_expr_list_two(meta_expr_var("self"), meta_expr_var("other"))),
        arms,
    )
}

#[comptime_derive]
fn derive_enum_ord_body(input: DeriveInput, partial: bool) -> MetaExpr {
    let block = meta_block_new();
    let left_tag = derive_fresh_name(input, "left_tag");
    let right_tag = derive_fresh_name(input, "right_tag");
    meta_block_let(block, left_tag, derive_enum_tag(input, meta_expr_var("self")));
    meta_block_let(block, right_tag, derive_enum_tag(input, meta_expr_var("other")));
    let less = if partial {
        derive_some(derive_ordering("Less"))
    } else {
        derive_ordering("Less")
    };
    let greater = if partial {
        derive_some(derive_ordering("Greater"))
    } else {
        derive_ordering("Greater")
    };
    meta_block_finish(
        block,
        meta_expr_if(
            meta_expr_binary(12, meta_expr_var(left_tag), meta_expr_var(right_tag)),
            less,
            meta_expr_if(
                meta_expr_binary(13, meta_expr_var(left_tag), meta_expr_var(right_tag)),
                greater,
                derive_enum_payload_order(input, partial),
            ),
        ),
    )
}

#[comptime_derive]
fn derive_add_call_site_predicates(input: DeriveInput, output: DeriveOutput, trait_name: string) -> () {
    if derive_item_kind(input) == 0 {
        let mut index = 0;
        while index < derive_field_count(input) {
            let ty = derive_field_type(input, index);
            if meta_type_contains_generic(input, ty) && !derive_struct_type_seen(input, index, ty) {
                derive_output_add_call_site_predicate(output, ty, trait_name)
            }
            index += 1;
        }
    } else {
        let mut variant = 0;
        while variant < derive_variant_count(input) {
            let mut field = 0;
            while field < derive_variant_field_count(input, variant) {
                let ty = derive_variant_field_type(input, variant, field);
                if meta_type_contains_generic(input, ty)
                    && !derive_enum_type_seen(input, variant, field, ty) {
                    derive_output_add_call_site_predicate(output, ty, trait_name)
                }
                field += 1;
            }
            variant += 1;
        }
    }
}

#[comptime_derive(PartialOrd)]
pub fn derive_partial_ord(input: DeriveInput) -> DeriveOutput {
    let output = derive_output_new_call_site(input, "std::cmp::PartialOrd");
    derive_add_call_site_predicates(input, output, "std::cmp::PartialOrd");
    let ordering = meta_type_call_site("Ordering");
    let values = meta_type_list_new();
    meta_type_list_push(values, ordering);
    let ret_ty = meta_type_apply(meta_type_call_site("Option"), values);
    derive_output_add_method(
        output,
        meta_method(
            "partial_cmp",
            derive_eq_params(input),
            ret_ty,
            if derive_item_kind(input) == 0 {
                derive_struct_ord_body(input, true)
            } else {
                derive_enum_ord_body(input, true)
            },
        ),
    );
    output
}

#[comptime_derive(Ord)]
pub fn derive_ord(input: DeriveInput) -> DeriveOutput {
    let output = derive_output_new_call_site(input, "std::cmp::Ord");
    derive_add_call_site_predicates(input, output, "std::cmp::Ord");
    derive_output_add_method(
        output,
        meta_method(
            "cmp",
            derive_eq_params(input),
            meta_type_call_site("Ordering"),
            if derive_item_kind(input) == 0 {
                derive_struct_ord_body(input, false)
            } else {
                derive_enum_ord_body(input, false)
            },
        ),
    );
    output
}
