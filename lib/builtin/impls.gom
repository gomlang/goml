#[lang("slice")]
impl[T] Slice[T] {
    fn get(self: Self, index: isize) -> T {
        slice_get(self, index)
    }

    fn get_checked(self: Self, index: isize) -> Option[T] {
        if index < 0 || index >= self.len() {
            Option::None
        } else {
            Option::Some(self[index])
        }
    }

    fn len(self: Self) -> isize {
        slice_len(self)
    }

    fn sub(self: Self, start: isize, end: isize) -> Self {
        slice_sub(self, start, end)
    }

    fn sub_checked(self: Self, start: isize, end: isize) -> Option[Self] {
        if start < 0 || end < start || end > self.len() {
            Option::None
        } else {
            Option::Some(self.sub(start, end))
        }
    }

    fn to_vec(self: Self) -> Vec[T] {
        let result: Vec[T] = Vec::with_capacity(self.len());
        for value in self {
            result.push(value)
        }
        result
    }

    fn iter(self: Self) -> FnIterator[T] {
        let mut index = 0;
        let len = self.len();
        FnIterator::from_fn(
            || {
                let current = index;
                if current < len {
                    let value = self.get(current);
                    index = current + 1;
                    Option::Some(value)
                } else {
                    Option::None
                }
            },
        )
    }
}

#[lang("mut_slice")]
impl[T] MutSlice[T] {
    fn get(self: Self, index: isize) -> T {
        mut_slice_get(self, index)
    }

    fn get_checked(self: Self, index: isize) -> Option[T] {
        if index < 0 || index >= self.len() {
            Option::None
        } else {
            Option::Some(self[index])
        }
    }

    fn set(self: Self, index: isize, value: T) -> () {
        mut_slice_set(self, index, value)
    }

    fn set_checked(self: Self, index: isize, value: T) -> bool {
        if index < 0 || index >= self.len() {
            false
        } else {
            self[index] = value;
            true
        }
    }

    fn len(self: Self) -> isize {
        mut_slice_len(self)
    }

    fn sub(self: Self, start: isize, end: isize) -> Self {
        mut_slice_sub(self, start, end)
    }

    fn sub_checked(self: Self, start: isize, end: isize) -> Option[Self] {
        if start < 0 || end < start || end > self.len() {
            Option::None
        } else {
            Option::Some(self.sub(start, end))
        }
    }

    fn as_slice(self: Self) -> Slice[T] {
        mut_slice_as_slice(self)
    }

    fn copy_from(self: Self, start: isize, source: Slice[T]) -> bool {
        mut_slice_copy_from(self, start, source)
    }

    fn copy_within(self: Self, source_start: isize, source_end: isize, dest_start: isize) -> bool {
        if source_start < 0 || source_end < source_start || source_end > self.len() {
            false
        } else {
            self.copy_from(dest_start, self.as_slice().sub(source_start, source_end))
        }
    }

    fn fill(self: Self, value: T) -> () {
        let mut index = 0;
        while index < self.len() {
            self[index] = value;
            index += 1;
        }
    }

    fn to_vec(self: Self) -> Vec[T] {
        self.as_slice().to_vec()
    }

    fn iter(self: Self) -> FnIterator[T] {
        self.as_slice().iter()
    }
}

impl[T] IntoIterator for Slice[T] {
    type Item = T;

    type IntoIter = FnIterator[T];

    fn into_iter(self: Slice[T]) -> FnIterator[T] {
        self.iter()
    }
}

