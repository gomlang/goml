    }

    fn entry(self: Self, key: K) -> HashMapEntry[K, V] {
        HashMapEntry { values: self, key }
    }

    fn remove(self: Self, key: K) -> () {
        hashmap_remove(self, key)
    }

    fn len(self: Self) -> isize {
        hashmap_len(self)
    }

    fn contains(self: Self, key: K) -> bool {
