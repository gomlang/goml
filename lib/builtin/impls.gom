    }
}

impl[K: Hash + Eq, V] HashMapEntry[K, V] {
    fn key(self: Self) -> K {
        self.key
    }

    fn get(self: Self) -> Option[V] {
        self.values.get(self.key)
    }

    fn or_insert(self: Self, value: V) -> V {
        self.or_insert_with(|| value)
    }

    fn or_insert_with(self: Self, create: () -> V) -> V {
        self.values.get_or_insert_with(self.key, create)
    }

    fn insert(self: Self, value: V) -> Option[V] {
        self.values.insert(self.key, value)
    }

    fn and_modify(self: Self, update: (V) -> V) -> Self {
        let _ = self.values.update(self.key, update);
        self
    }

    fn update(self: Self, update: (V) -> V) -> Option[V] {
        self.values.update(self.key, update)
    }

    fn remove(self: Self) -> Option[V] {
        self.values.remove_value(self.key)
    }

    fn remove_entry(self: Self) -> Option[(K, V)] {
        self.remove().map(|value| (self.key, value))
    }
}

