impl[T] FnIterator[T] {
    fn from_fn(next_fn: () -> Option[T]) -> Self {
        FnIterator { next_fn }
    }
}

impl[T] Iterator for FnIterator[T] {
    type Item = T;

    fn next(self: Self) -> Option[T] {
        self.next_fn()
    }
}

impl[I: Iterator] IntoIterator for I {
    type Item = I::Item;

    type IntoIter = I;

    fn into_iter(self: I) -> I {
        self
    }
}

#[lang("vec", from_array = "from_array")]
impl[T] Vec[T] {
    fn new() -> Self {
        vec_new()
    }

    fn with_capacity(capacity: isize) -> Self {
        vec_with_capacity(capacity)
    }

    fn push(self: Self, elem: T) -> () {
        vec_push(self, elem)
    }

    fn pushed(self: Self, elem: T) -> Self {
        let result: Vec[T] = Vec::with_capacity(self.len() + 1);
        let mut index = 0;
        while index < self.len() {
            result.push(self[index]);
            index += 1;
        }
        result.push(elem);
        result
    }

    fn copy(self: Self) -> Self {
        let result: Vec[T] = Vec::with_capacity(self.len());
        let mut index = 0;
        while index < self.len() {
            result.push(self[index]);
            index += 1;
        }
        result
    }

    fn freeze(self: Self) -> FrozenVec[T] {
        FrozenVec { values: self.copy() }
    }

    fn get(self: Self, index: isize) -> T {
        vec_get(self, index)
    }

    fn get_checked(self: Self, index: isize) -> Option[T] {
        if index < 0 || index >= self.len() {
            Option::None
        } else {
            Option::Some(self[index])
        }
    }

    fn set(self: Self, index: isize, elem: T) -> () {
        vec_set(self, index, elem)
    }

    fn len(self: Self) -> isize {
        vec_len(self)
    }

    fn capacity(self: Self) -> isize {
        vec_capacity(self)
    }

    fn is_empty(self: Self) -> bool {
        vec_len(self) == 0
    }

    fn reserve(self: Self, additional: isize) -> () {
        vec_reserve(self, additional)
    }

    fn truncate(self: Self, len: isize) -> () {
        vec_truncate(self, len)
    }

    fn clear(self: Self) -> () {
        self.truncate(0)
    }

    fn last(self: Self) -> Option[T] {
        let len = self.len();
        if len == 0 {
            Option::None
        } else {
            Option::Some(self[len - 1])
        }
    }

    fn pop(self: Self) -> Option[T] {
        let len = self.len();
        if len == 0 {
            Option::None
        } else {
            let value = self[len - 1];
            self.truncate(len - 1);
            Option::Some(value)
        }
    }

    fn swap(self: Self, left: isize, right: isize) -> () {
        let value = self[left];
        self[left] = self[right];
        self[right] = value;
    }

    fn swap_remove(self: Self, index: isize) -> T {
        let len = self.len();
        let value = self[index];
        if index + 1 < len {
            self[index] = self[len - 1];
        }
        self.truncate(len - 1);
        value
    }

    fn insert(self: Self, index: isize, value: T) -> () {
        let len = self.len();
        if index == len {
            self.push(value)
        } else {
            let _ = self[index];
            self.push(self[len - 1]);
            let mut current = len - 1;
            while current > index {
                self[current] = self[current - 1];
                current -= 1;
            }
            self[index] = value;
        }
    }

    fn remove(self: Self, index: isize) -> T {
        let len = self.len();
        let value = self[index];
        let mut current = index;
        while current + 1 < len {
            self[current] = self[current + 1];
            current += 1;
        }
        self.truncate(len - 1);
        value
    }

    fn reverse(self: Self) -> () {
        let mut left = 0;
        let mut right = self.len() - 1;
        while left < right {
            self.swap(left, right);
            left += 1;
            right -= 1;
        }
    }

    fn extend(self: Self, other: Vec[T]) -> () {
        let len = other.len();
        self.reserve(len);
        let mut index = 0;
        while index < len {
            self.push(other[index]);
            index += 1;
        }
    }

    fn slice(self: Self, start: isize, end: isize) -> Slice[T] {
        slice(self, start, end)
    }

    fn slice_checked(self: Self, start: isize, end: isize) -> Option[Slice[T]] {
        if start < 0 || end < start || end > self.len() {
            Option::None
        } else {
            Option::Some(slice(self, start, end))
        }
    }

    fn as_slice(self: Self) -> Slice[T] {
        slice(self, 0, self.len())
    }

    fn slice_mut(self: Self, start: isize, end: isize) -> MutSlice[T] {
        mut_slice(self, start, end)
    }

    fn slice_mut_checked(self: Self, start: isize, end: isize) -> Option[MutSlice[T]] {
        if start < 0 || end < start || end > self.len() {
            Option::None
        } else {
            Option::Some(mut_slice(self, start, end))
        }
    }

    fn as_mut_slice(self: Self) -> MutSlice[T] {
        mut_slice(self, 0, self.len())
    }

    fn iter(self: Self) -> FnIterator[T] {
        let mut index = 0;
        let len = self.len();
        FnIterator::from_fn(
            || {
                let current = index;
                if current < len {
                    let value = self[current];
                    index = current + 1;
                    Option::Some(value)
                } else {
                    Option::None
                }
            },
        )
    }

    fn position(self: Self, predicate: (T) -> bool) -> Option[isize] {
        for index in 0..self.len() {
            if predicate(self[index]) {
                return Option::Some(index)
            }
        }
        Option::None
    }

    fn stable_sort_by(self: Self, compare: (T, T) -> isize) -> () {
        let length = self.len();
        if length < 2 {
            return
        }
        let buffer: Vec[T] = Vec::with_capacity(length);
        for index in 0..length {
            buffer.push(self[index])
        }
        let mut width = 1;
        while width < length {
            let mut left = 0;
            while left < length {
                let middle = smaller(left + width, length);
                let right = smaller(middle + width, length);
                let mut first = left;
                let mut second = middle;
                let mut output = left;
                while first < middle && second < right {
                    if compare(self[first], self[second]) <= 0 {
                        buffer[output] = self[first];
                        first += 1;
                    } else {
                        buffer[output] = self[second];
                        second += 1;
                    }
                    output += 1;
                }
                while first < middle {
                    buffer[output] = self[first];
                    first += 1;
                    output += 1;
                }
                while second < right {
                    buffer[output] = self[second];
                    second += 1;
                    output += 1;
                }
                left = right;
            }
            for index in 0..length {
                self[index] = buffer[index];
            }
            width = if width > length / 2 {
                length
            } else {
                width * 2
            };
        }
    }

    fn sort_by(self: Self, compare: (T, T) -> isize) -> () {
        self.stable_sort_by(compare)
    }

    fn sort_by_ordering(self: Self, compare: (T, T) -> Ordering) -> () {
        self.sort_by(|left: T, right: T| compare(left, right).to_isize())
    }

    fn stable_sort_by_ordering(self: Self, compare: (T, T) -> Ordering) -> () {
        self.stable_sort_by(|left: T, right: T| compare(left, right).to_isize())
    }

    fn binary_search_by(self: Self, compare: (T) -> isize) -> Option[isize] {
        let mut low = 0;
        let mut high = self.len();
        while low < high {
            let middle = low + (high - low) / 2;
            if compare(self[middle]) < 0 {
                low = middle + 1;
            } else {
                high = middle;
            }
        }
        if low < self.len() && compare(self[low]) == 0 {
            Option::Some(low)
        } else {
            Option::None
        }
    }

    fn binary_search_by_ordering(self: Self, compare: (T) -> Ordering) -> Option[isize] {
        self.binary_search_by(|value: T| compare(value).to_isize())
    }

    fn min_by(self: Self, compare: (T, T) -> isize) -> Option[T] {
        if self.is_empty() {
            Option::None
        } else {
            let mut best = self[0];
            for index in 1..self.len() {
                let value = self[index];
                if compare(value, best) < 0 {
                    best = value;
                }
            }
            Option::Some(best)
        }
    }

    fn max_by(self: Self, compare: (T, T) -> isize) -> Option[T] {
        if self.is_empty() {
            Option::None
        } else {
            let mut best = self[0];
            for index in 1..self.len() {
                let value = self[index];
                if compare(value, best) > 0 {
                    best = value;
                }
            }
            Option::Some(best)
        }
    }

    fn min_by_ordering(self: Self, compare: (T, T) -> Ordering) -> Option[T] {
        self.min_by(|left: T, right: T| compare(left, right).to_isize())
    }

    fn max_by_ordering(self: Self, compare: (T, T) -> Ordering) -> Option[T] {
        self.max_by(|left: T, right: T| compare(left, right).to_isize())
    }

    fn dedup_by(self: Self, equal: (T, T) -> bool) -> () {
        if self.len() < 2 {
            return
        }
        let mut output = 1;
        for index in 1..self.len() {
            let value = self[index];
            if !equal(self[output - 1], value) {
                self[output] = value;
                output += 1;
            }
        }
        self.truncate(output)
    }
}

fn smaller(left: isize, right: isize) -> isize {
    if left < right {
        left
    } else {
        right
    }
}

impl[T: ToString] Vec[T] {
    fn join(self: Self, separator: string) -> string {
        let parts: Vec[string] = Vec::with_capacity(self.len());
        for index in 0..self.len() {
            parts.push(self[index].to_string())
        }
        let result: Vec[string] = Vec::with_capacity(parts.len() * 2);
        for index in 0..parts.len() {
            if index > 0 {
                result.push(separator)
            }
            result.push(parts[index])
        }
        __goml_builtin_string_concat(result)
    }
}

impl[T: PartialEq] Vec[T] {
    fn contains(self: Self, expected: T) -> bool {
        let mut index = 0;
        while index < self.len() {
            if PartialEq::eq(self[index], expected) {
                return true
            }
            index += 1;
        }
        false
    }

    fn dedup(self: Self) -> () {
        self.dedup_by(|left: T, right: T| PartialEq::eq(left, right))
    }
}

impl[T: PartialEq] Slice[T] {
    fn contains(self: Self, expected: T) -> bool {
        let mut index = 0;
        while index < self.len() {
            if PartialEq::eq(self[index], expected) {
                return true
            }
            index += 1;
        }
        false
    }
}

impl[T: PartialEq] FrozenVec[T] {
    fn contains(self: Self, expected: T) -> bool {
        for value in self.values {
            if PartialEq::eq(value, expected) {
                return true
            }
        }
        false
    }
}

impl[T] FrozenVec[T] {
    fn len(self: Self) -> isize {
        self.values.len()
    }

    fn is_empty(self: Self) -> bool {
        self.values.is_empty()
    }

    fn get(self: Self, index: isize) -> T {
        self.values[index]
    }

    fn to_vec(self: Self) -> Vec[T] {
        self.values.copy()
    }

    fn iter(self: Self) -> FnIterator[T] {
        self.values.iter()
    }
}

