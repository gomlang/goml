impl[T: PartialEq] PartialEq for Vec[T] {
    fn eq(self: Vec[T], other: Vec[T]) -> bool {
        if self.len() != other.len() {
            false
        } else {
            let mut index = 0;
            while index < self.len() {
                if self[index] == other[index] {
                    index += 1;
                } else {
                    return false
                }
            }
            true
        }
    }
}

impl[T: Eq] Eq for Vec[T] {}

impl[T: Hash] Hash for Vec[T] {
    fn hash(self: Vec[T]) -> u64 {
        let mut value: u64 = 0xcbf29ce484222325;
        let mut index = 0;
        while index < self.len() {
            value = value * 0x100000001b3 + Hash::hash(self[index]);
            index += 1;
        }
        value
    }
}

impl[T: PartialEq] PartialEq for Slice[T] {
    fn eq(self: Slice[T], other: Slice[T]) -> bool {
        if self.len() != other.len() {
            false
        } else {
            let mut index = 0;
            while index < self.len() {
                if self[index] == other[index] {
                    index += 1;
                } else {
                    return false
                }
            }
            true
        }
    }
}

impl[T: Eq] Eq for Slice[T] {}

impl[T: Hash] Hash for Slice[T] {
    fn hash(self: Slice[T]) -> u64 {
        let mut value: u64 = 0xcbf29ce484222325;
        let mut index = 0;
        while index < self.len() {
            value = value * 0x100000001b3 + Hash::hash(self[index]);
            index += 1;
        }
        value
    }
}

impl[T: PartialEq] PartialEq for Option[T] {
    fn eq(self: Option[T], other: Option[T]) -> bool {
        match (self, other) {
            (Option::None, Option::None) => true,
            (Option::Some(left), Option::Some(right)) => left == right,
            _ => false,
        }
    }
}

impl[T: Eq] Eq for Option[T] {}

impl[T: Hash] Hash for Option[T] {
    fn hash(self: Option[T]) -> u64 {
        match self {
            Option::None => 0xcbf29ce484222326,
            Option::Some(value) => 0xcbf29ce484222327 + Hash::hash(value),
        }
    }
}

impl[T: PartialEq, E: PartialEq] PartialEq for Result[T, E] {
    fn eq(self: Result[T, E], other: Result[T, E]) -> bool {
        match (self, other) {
            (Result::Ok(left), Result::Ok(right)) => left == right,
            (Result::Err(left), Result::Err(right)) => left == right,
            _ => false,
        }
    }
}

impl[T: Eq, E: Eq] Eq for Result[T, E] {}

impl[T: Hash, E: Hash] Hash for Result[T, E] {
    fn hash(self: Result[T, E]) -> u64 {
        match self {
            Result::Ok(value) => 0xcbf29ce484222326 + Hash::hash(value),
            Result::Err(value) => 0xcbf29ce484222327 + Hash::hash(value),
        }
    }
}

