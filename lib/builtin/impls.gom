package builtin;

impl isize {
    fn to_string(self: isize) -> string {
        __goml_builtin_int_to_string(self)
    }
}

impl i32 {
    fn to_string(self: i32) -> string {
        __goml_builtin_int32_to_string(self)
    }
}

impl char {
    fn to_string(self: char) -> string {
        char_to_string(self)
    }
}

impl string {
    fn len(self: string) -> isize {
        string_len(self)
    }

    fn byte_len(self: string) -> isize {
        string_len(self)
    }

    fn get(self: string, index: isize) -> char {
        string_get(self, index)
    }

    fn byte_get(self: string, index: isize) -> byte {
        string_byte_get(self, index)
    }

    fn byte_slice(self: string, start: isize, end: isize) -> string {
        string_byte_slice(self, start, end)
    }

    fn is_char_boundary(self: string, index: isize) -> bool {
        string_is_char_boundary(self, index)
    }

    fn decode_at(self: string, index: isize) -> Option[(char, isize)] {
        let (valid, value, width) = string_decode_utf8_at(self, index);
        if valid {
            Option::Some((value, width))
        } else {
            Option::None
        }
    }

    fn to_bytes(self: string) -> Vec[byte] {
        string_to_bytes(self)
    }

    fn chars(self: string) -> FnIterator[char] {
        let mut index = 0;
        FnIterator::from_fn(
            || {
                match self.decode_at(index) {
                    Some(decoded) => {
                        let (value, width) = decoded;
                        index += width;
                        Option::Some(value)
                    },
                    None => Option::None,
                }
            },
        )
    }

    fn char_indices(self: string) -> FnIterator[(isize, char)] {
        let mut index = 0;
        FnIterator::from_fn(
            || {
                let current = index;
                match self.decode_at(current) {
                    Some(decoded) => {
                        let (value, width) = decoded;
                        index = current + width;
                        Option::Some((current, value))
                    },
                    None => Option::None,
                }
            },
        )
    }

    fn starts_with_at(self: string, start: isize, prefix: string) -> bool {
        let value_len = self.byte_len();
        let prefix_len = prefix.byte_len();
        if start < 0 || start > value_len || prefix_len > value_len - start {
            false
        } else {
            let end = start + prefix_len;
            self.is_char_boundary(start) && self.is_char_boundary(end)
                && self.byte_slice(start, end) == prefix
        }
    }

    fn find(self: string, expected: string) -> Option[isize] {
        string_find_from(self, expected, 0)
    }

    fn find_bytes(self: string, expected: string) -> Option[isize] {
        self.find(expected)
    }

    fn char_count(self: string) -> isize {
        let mut count = 0;
        for _ in self.chars() {
            count += 1;
        }
        count
    }

    fn slice_chars(self: string, start: isize, end: isize) -> Option[string] {
        if start < 0 || end < start {
            Option::None
        } else {
            let mut char_index = 0;
            let mut start_byte = if start == 0 {
                Option::Some(0)
            } else {
                Option::None
            };
            let mut end_byte = if end == 0 {
                Option::Some(0)
            } else {
                Option::None
            };
            for item in self.char_indices() {
                let (byte_index, _) = item;
                if char_index == start {
                    start_byte = Option::Some(byte_index);
                }
                if char_index == end {
                    end_byte = Option::Some(byte_index);
                }
                char_index += 1;
            }
            if char_index == start {
                start_byte = Option::Some(self.byte_len());
            }
            if char_index == end {
                end_byte = Option::Some(self.byte_len());
            }
            match (start_byte, end_byte) {
                (Some(first), Some(last)) => Option::Some(self.byte_slice(first, last)),
                _ => Option::None,
            }
        }
    }

    fn rfind(self: string, expected: string) -> Option[isize] {
        let value_len = self.byte_len();
        let expected_len = expected.byte_len();
        if expected_len > value_len {
            Option::None
        } else {
            let mut start = value_len - expected_len;
            while start >= 0 {
                if self.starts_with_at(start, expected) {
                    return Option::Some(start)
                } else {
                    start -= 1;
                }
            }
            Option::None
        }
    }

    fn trim_start(self: string) -> string {
        let mut start = 0;
        while start < self.byte_len() && ascii_is_whitespace(self.byte_get(start)) {
            start += 1;
        }
        self.byte_slice(start, self.byte_len())
    }

    fn trim_end(self: string) -> string {
        let mut end = self.byte_len();
        while end > 0 && ascii_is_whitespace(self.byte_get(end - 1)) {
            end -= 1;
        }
        self.byte_slice(0, end)
    }

    fn trim(self: string) -> string {
        self.trim_start().trim_end()
    }

    fn split(self: string, separator: string) -> Vec[string] {
        let result: Vec[string] = Vec::new();
        let separator_len = separator.byte_len();
        let value_len = self.byte_len();
        if separator_len == 0 {
            result.push(self);
            return result
        }
        let mut start = 0;
        loop {
            match string_find_from(self, separator, start) {
                Some(index) => {
                    result.push(self.byte_slice(start, index));
                    start = index + separator_len;
                },
                None => {
                    result.push(self.byte_slice(start, value_len));
                    break
                },
            }
        }
        result
    }

    fn split_once(self: string, separator: string) -> Option[(string, string)] {
        let separator_len = separator.byte_len();
        let value_len = self.byte_len();
        if separator_len == 0 {
            Option::None
        } else {
            match self.find(separator) {
                Some(index) => Option::Some(
                    (self.byte_slice(0, index), self.byte_slice(index + separator_len, value_len)),
                ),
                None => Option::None,
            }
        }
    }

    fn lines(self: string) -> Vec[string] {
        let result = self.split("\n");
        if !result.is_empty() && result[result.len() - 1] == "" {
            let _ = result.pop();
        }
        for index in 0..result.len() {
            let line = result[index];
            if line.byte_len() > 0 && line.byte_get(line.byte_len() - 1) == b'\r' {
                result[index] = line.byte_slice(0, line.byte_len() - 1);
            }
        }
        result
    }

    fn replace(self: string, expected: string, replacement: string) -> string {
        if expected.byte_len() == 0 {
            self
        } else {
            let parts: Vec[string] = Vec::new();
            let mut start = 0;
            loop {
                match string_find_from(self, expected, start) {
                    Some(index) => {
                        parts.push(self.byte_slice(start, index));
                        parts.push(replacement);
                        start = index + expected.byte_len();
                    },
                    None => {
                        parts.push(self.byte_slice(start, self.byte_len()));
                        break
                    },
                }
            }
            __goml_builtin_string_concat(parts)
        }
    }

    fn repeat(self: string, count: isize) -> string {
        if count <= 0 || self.byte_len() == 0 {
            ""
        } else {
            let parts: Vec[string] = Vec::with_capacity(count);
            for _ in 0..count {
                parts.push(self)
            }
            __goml_builtin_string_concat(parts)
        }
    }

    fn is_ascii(self: string) -> bool {
        for index in 0..self.byte_len() {
            if self.byte_get(index) > 0x7f {
                return false
            }
        }
        true
    }

    fn eq_ignore_ascii_case(self: string, other: string) -> bool {
        if self.byte_len() != other.byte_len() {
            false
        } else {
            for index in 0..self.byte_len() {
                if !ascii_eq_ignore_case(self.byte_get(index), other.byte_get(index)) {
                    return false
                }
            }
            true
        }
    }

    fn to_ascii_lowercase(self: string) -> string {
        let values = self.to_bytes();
        for index in 0..values.len() {
            values[index] = ascii_to_lowercase(values[index]);
        }
        let (_, result) = string_from_utf8(values);
        result
    }

    fn to_ascii_uppercase(self: string) -> string {
        let values = self.to_bytes();
        for index in 0..values.len() {
            values[index] = ascii_to_uppercase(values[index]);
        }
        let (_, result) = string_from_utf8(values);
        result
    }
}

fn string_find_from(value: string, expected: string, start: isize) -> Option[isize] {
    let value_len = value.byte_len();
    let expected_len = expected.byte_len();
    if start < 0 || start > value_len {
        Option::None
    } else if expected_len == 0 {
        Option::Some(start)
    } else if expected_len > value_len - start {
        Option::None
    } else {
        let limit = value_len - expected_len;
        let mut index = start;
        while index <= limit {
            if value.starts_with_at(index, expected) {
                return Option::Some(index)
            } else {
                index += 1;
            }
        }
        Option::None
    }
}

fn ascii_is_whitespace(value: byte) -> bool {
    value == b'\t' || value == b'\n' || value == b'\x0B' || value == b'\f' || value == b'\r'
        || value == b' '
}

fn ascii_is_uppercase(value: byte) -> bool {
    value >= b'A' && value <= b'Z'
}

fn ascii_is_lowercase(value: byte) -> bool {
    value >= b'a' && value <= b'z'
}

fn ascii_to_lowercase(value: byte) -> byte {
    if ascii_is_uppercase(value) {
        value + (b'a' - b'A')
    } else {
        value
    }
}

fn ascii_to_uppercase(value: byte) -> byte {
    if ascii_is_lowercase(value) {
        value - (b'a' - b'A')
    } else {
        value
    }
}

fn ascii_eq_ignore_case(left: byte, right: byte) -> bool {
    ascii_to_lowercase(left) == ascii_to_lowercase(right)
}

