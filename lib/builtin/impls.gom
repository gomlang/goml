    }

    fn insert(self: Self, key: K, value: V) -> Option[V] {
        hashmap_insert(self, key, value)
    }

    fn get_or_insert_with(self: Self, key: K, create: () -> V) -> V {
        hashmap_get_or_insert_with(self, key, create)
    }

    fn update(self: Self, key: K, update: (V) -> V) -> Option[V] {
        hashmap_update(self, key, update)
    }

    fn remove_value(self: Self, key: K) -> Option[V] {
