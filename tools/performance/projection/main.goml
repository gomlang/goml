package main;

struct Large {
    values: [isize; 32],
}

struct Outer {
    inner: Large,
}

fn read(value: Large) -> isize {
    let mut result = 0;
    for index in 0..32 {
        result += value.values[index];
    }
    result
}

fn project(value: Outer, count: isize) -> isize {
    let mut result = 0;
    for _ in 0..count {
        result += read(value.inner);
    }
    result
}

fn main() -> () {
    println(project(Outer { inner: Large { values: [1; 32] } }, 100));
}
