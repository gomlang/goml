package main;

struct Large {
    values: [isize; 32],
}

fn read(value: Ref[Large], index: isize) -> isize {
    value.get().values[index]
}

fn project(value: Ref[Large], count: isize) -> isize {
    let mut result = 0;
    for _ in 0..count {
        for index in 0..32 {
            result += read(value, index);
        }
    }
    result
}

fn main() -> () {
    println(project(Ref::new(Large { values: [1; 32] }), 100));
}
