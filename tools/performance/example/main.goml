package main;

#[go_ffi("example.com/goml-performance/profile", "Iterations")]
extern fn iterations() -> isize;

#[go_ffi("example.com/goml-performance/profile", "Start")]
extern fn start() -> ();

#[go_ffi("example.com/goml-performance/profile", "Finish")]
extern fn finish(checksum: u64, steps: isize) -> ();

struct Cpu {
    pc: u32,
    accumulator: u64,
}

struct Machine {
    cpu: Cpu,
    memory: [u32; 256],
    timer: u64,
}

fn step(cpu: Cpu, instruction: u32, timer: u64) -> Cpu {
    let mut cpu = cpu;
    match instruction & 3 {
        0 => {
            cpu.accumulator ^= instruction.to_u64() + timer;
        },
        1 => {
            cpu.accumulator = (cpu.accumulator << 3) ^ (cpu.accumulator >> 2);
        },
        2 => {
            cpu.accumulator += instruction.to_u64() * 17;
        },
        _ => {
            cpu.accumulator ^= timer << 5;
        },
    }
    cpu.pc = (cpu.pc + (instruction >> 8) + 1) & 255;
    cpu
}

fn main() -> () {
    let count = iterations();
    let mut machine = Machine { cpu: Cpu { pc: 0, accumulator: 7 }, memory: [0; 256], timer: 0 };
    for index in 0..256 {
        machine.memory[index] = (index.to_u32() * 197 + 101) ^ (index.to_u32() << 9);
    }
    start();
    for _ in 0..count {
        let instruction = machine.memory[(machine.cpu.pc & 255).to_isize()];
        machine.cpu = step(machine.cpu, instruction, machine.timer);
        machine.timer += 1;
    }
    finish(machine.cpu.accumulator ^ machine.timer, count)
}
