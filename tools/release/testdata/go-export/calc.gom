package calc;

#[go_ffi("math", "Abs")]
extern fn abs_raw(value: f64) -> f64;

#[go_export("Add")]
pub fn add(left: i64, right: i64) -> i64 {
    left + right
}

#[go_export("AbsPlusOne")]
pub fn abs_plus_one(value: f64) -> f64 {
    abs_raw(value) + 1.0
}

#[go_export("Pair")]
pub fn pair(value: i64) -> (i64, i64) {
    (value, value + 1)
}
