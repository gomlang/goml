package main;

use std::path;
use std::error;
use std::testing;
use error::ResultExt;
use error::ReportContext;

fn main() -> () {
    let result: Result[(), string] = Result::Err("leaf");
    let report = testing::expect_err(
        result.into_report().with_context(|| "load").context("outer"),
        "expected report",
    );
    testing::assert_eq(report.map(|value: string| value + "!").to_string(), "outer: load: leaf!");
    println(path::join("std", "works"))
}
