package main;

use std::collections::imm;
use std::testing;

fn check_immutable_collections() -> () {
    let map: imm::HashMap[string, isize] = imm::HashMap::new();
    let updated = map.insert("key", 7);
    testing::assert(map.is_empty());
    testing::assert(updated.get("key") == Option::Some(7));
    let set = imm::HashSet::from_vec(Vec::from_array([1, 2, 1]));
    testing::assert_eq(set.len(), 2);
    testing::assert(set.remove(1).contains(2));
    let vector = imm::Vector::from_vec(Vec::from_array([1, 2]));
    testing::assert(vector.push(3).get(2) == Option::Some(3));
    testing::assert_eq(vector.len(), 2);
    let list = imm::List::from_vec(Vec::from_array([1, 2]));
    testing::assert(list.push_front(0).to_vec() == Vec::from_array([0, 1, 2]));
    let tree = imm::BTreeMap::from_vec(Vec::from_array([(2, "b"), (1, "a")]));
    testing::assert(tree.remove(1).first() == Option::Some((2, "b")));
    testing::assert(tree.first() == Option::Some((1, "a")));
    let ordered = imm::BTreeSet::from_vec(Vec::from_array([3, 1, 2]));
    testing::assert(ordered.to_vec() == Vec::from_array([1, 2, 3]));
    let selected = Vec::new();
    for value in ordered.range(1, 3) {
        selected.push(value);
    }
    testing::assert(selected == Vec::from_array([1, 2]));
}
