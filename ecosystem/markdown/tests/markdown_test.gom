package tests;

use ecosystem::markdown;
use std::testing;

fn commonmark(source: string) -> string {
    testing::expect_ok(
        markdown::render(
            testing::expect_ok(markdown::parse(source), "parse"),
            markdown::RenderOptions::commonmark(),
        ),
        "render",
    )
}

#[test]
fn block_structure_spans_references_and_visitors() -> () {
    let document = testing::expect_ok(
        markdown::parse("# Title\n\n> A **bold** [link][ref].\n\n[ref]: /target \"Tooltip\"\n"),
        "document",
    );
    testing::assert_eq(document.blocks.len(), 2);
    testing::assert_eq(document.blocks[0].span.start, 0);
    testing::assert_eq(document.blocks[0].span.end, 0);
    testing::assert_eq(document.blocks[1].span.start, 2);
    let reference = testing::expect_some(document.references.get("ref"), "reference");
    testing::assert_eq(reference.destination, "/target");
    testing::assert_eq(reference.title, "Tooltip");
    let headings: Vec[string] = Vec::new();
    let links: Vec[string] = Vec::new();
    let count = Ref::new(0);
    testing::assert_ok(
        markdown::walk(
            document,
            |block| {
                count.set(count.get() + 1);
                if let markdown::BlockKind::Heading(_, children) = block.kind {
                    headings.push(
                        testing::expect_ok(markdown::inline_text(children), "heading text"),
                    );
                }
            },
            |inline| {
                if let markdown::Inline::Link(destination, _, _) = inline {
                    links.push(destination);
                }
            },
        ),
    );
    testing::assert_eq(count.get(), 3);
    testing::assert(headings == Vec::from_array(["Title"]));
    testing::assert(links == Vec::from_array(["/target"]));
}

#[test]
fn markup_precedence_emphasis_links_and_entities() -> () {
    testing::assert_eq(
        commonmark("***a*** and `*b*` and \\*c\\*"),
        "<p><em><strong>a</strong></em> and <code>*b*</code> and *c*</p>\n",
    );
    testing::assert_eq(
        commonmark("[a *b*](foo(bar) \"t\") ![a **b**](image.png)"),
        "<p><a href=\"foo(bar)\" title=\"t\">a <em>b</em></a> <img src=\"image.png\" alt=\"a b\" /></p>\n",
    );
    testing::assert_eq(
        commonmark("&NotEqualTilde; &AMP; &#x1F600; &#0; &#xD800;"),
        "<p>≂̸ &amp; 😀 � �</p>\n",
    );
    testing::assert_eq(
        commonmark("[中文](https://example.test/中文?q=1&x=2)"),
        "<p><a href=\"https://example.test/%E4%B8%AD%E6%96%87?q=1&amp;x=2\">中文</a></p>\n",
    );
    testing::assert_eq(
        commonmark("[ẞ]\n\n[ss]: /first\n[SS]: /second"),
        "<p><a href=\"/first\">ẞ</a></p>\n",
    );
}

#[test]
fn nested_lists_tightness_tabs_and_fences() -> () {
    testing::assert_eq(
        commonmark("3. a\n4. b\n   - c\n   - d\n"),
        "<ol start=\"3\">\n<li>a</li>\n<li>b\n<ul>\n<li>c</li>\n<li>d</li>\n</ul>\n</li>\n</ol>\n",
    );
    testing::assert_eq(
        commonmark("- a\n\n- b\n"),
        "<ul>\n<li>\n<p>a</p>\n</li>\n<li>\n<p>b</p>\n</li>\n</ul>\n",
    );
    testing::assert_eq(
        commonmark("- foo\n\n\t\t\tbar\n"),
        "<ul>\n<li>\n<p>foo</p>\n<pre><code>  \tbar\n</code></pre>\n</li>\n</ul>\n",
    );
    testing::assert_eq(
        commonmark("```gom extra\n\t<code>\n```"),
        "<pre><code class=\"language-gom\">\t&lt;code&gt;\n</code></pre>\n",
    );
    testing::assert_eq(
        commonmark("# Title\r\n\r\ntext\rnext"),
        "<h1>Title</h1>\n<p>text\nnext</p>\n",
    );
}

#[test]
fn renderer_defaults_escape_html_and_filter_schemes() -> () {
    testing::assert_eq(
        testing::expect_ok(markdown::to_html("<script>alert(1)</script>"), "safe HTML"),
        "&lt;script&gt;alert(1)&lt;/script&gt;\n",
    );
    testing::assert_eq(
        testing::expect_ok(markdown::to_html("[bad](javascript&#58;alert(1))"), "safe URL"),
        "<p><a href=\"\">bad</a></p>\n",
    );
    testing::assert_eq(
        commonmark("[bad](javascript:alert(1))"),
        "<p><a href=\"javascript:alert(1)\">bad</a></p>\n",
    );
    testing::assert(markdown::safe_url("../relative?q=a"));
    testing::assert(markdown::safe_url("https://example.test"));
    testing::assert(markdown::safe_url("mailto:a@example.test"));
    testing::assert(!markdown::safe_url("java\nscript:alert(1)"));
    testing::assert(!markdown::safe_url("data:text/html,test"));
    testing::assert_eq(markdown::escape_html("<&\" >"), "&lt;&amp;&quot; &gt;");
    testing::assert_eq(markdown::escape_html("'\"&amp;"), "'&quot;&amp;amp;");
}

#[test]
fn input_node_depth_work_and_output_limits() -> () {
    testing::assert_err(
        markdown::parse_with_options(
            "large",
            markdown::ParseOptions { max_bytes: 2, max_depth: 8, max_nodes: 100, max_work: 1000 },
        ),
    );
    testing::assert_err(
        markdown::parse_with_options(
            "node",
            markdown::ParseOptions { max_bytes: 100, max_depth: 8, max_nodes: 0, max_work: 1000 },
        ),
    );
    testing::assert_err(
        markdown::parse_with_options(
            "> ".repeat(20) + "text",
            markdown::ParseOptions { max_bytes: 100, max_depth: 4, max_nodes: 100, max_work: 1000 },
        ),
    );
    testing::assert_err(
        markdown::parse_with_options(
            "<".repeat(40),
            markdown::ParseOptions { max_bytes: 100, max_depth: 8, max_nodes: 100, max_work: 64 },
        ),
    );
    let document = testing::expect_ok(markdown::parse("content"), "document");
    testing::assert_err(
        markdown::render(
            document,
            markdown::RenderOptions {
                allow_raw_html: false,
                allow_unsafe_urls: false,
                hard_breaks: false,
                xhtml: true,
                max_depth: 8,
                max_bytes: 3,
            },
        ),
    );
    let cycle: Vec[markdown::Inline] = Vec::new();
    cycle.push(markdown::Inline::Emphasis(cycle));
    let cyclic = markdown::Document {
        blocks: Vec::from_array(
            [
                markdown::Block {
                    kind: markdown::BlockKind::Paragraph(cycle),
                    span: markdown::LineSpan { start: 0, end: 0 },
                },
            ],
        ),
        references: HashMap::new(),
    };
    testing::assert_err(markdown::render(cyclic, markdown::RenderOptions::standard()));
    testing::assert_err(markdown::walk(cyclic, |_| (), |_| ()));
    testing::assert_err(markdown::inline_text(cycle));
}

#[test]
fn configurable_breaks_manual_ast_and_plain_text() -> () {
    let values = Vec::from_array(
        [
            markdown::Inline::Text("A < "),
            markdown::Inline::Strong(Vec::from_array([markdown::Inline::Code("B")])),
            markdown::Inline::SoftBreak,
            markdown::Inline::Text("C"),
        ],
    );
    testing::assert_eq(testing::expect_ok(markdown::inline_text(values), "plain text"), "A < B\nC");
    let document = markdown::Document {
        blocks: Vec::from_array(
            [
                markdown::Block {
                    kind: markdown::BlockKind::Paragraph(values),
                    span: markdown::LineSpan { start: 0, end: 0 },
                },
            ],
        ),
        references: HashMap::new(),
    };
    let options = markdown::RenderOptions {
        allow_raw_html: false,
        allow_unsafe_urls: false,
        hard_breaks: true,
        xhtml: false,
        max_depth: 16,
        max_bytes: 1000,
    };
    testing::assert_eq(
        testing::expect_ok(markdown::render(document, options), "custom options"),
        "<p>A &lt; <strong><code>B</code></strong><br>\nC</p>\n",
    );
}
