package markdown;

#[derive(Debug, PartialEq)]
pub struct Error {
    pub message: string,
    pub line: isize,
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        f"line {self.line + 1}: {self.message}"
    }
}

#[derive(Debug, PartialEq)]
pub struct LineSpan {
    pub start: isize,
    pub end: isize,
}

pub enum Inline {
    Text(string),
    Code(string),
    Emphasis(Vec[Inline]),
    Strong(Vec[Inline]),
    Link(string, string, Vec[Inline]),
    Image(string, string, Vec[Inline]),
    Html(string),
    SoftBreak,
    HardBreak,
}

pub enum BlockKind {
    Paragraph(Vec[Inline]),
    Heading(isize, Vec[Inline]),
    Code(string, string),
    Html(string),
    Quote(Vec[Block]),
    List(bool, isize, bool, Vec[Vec[Block]]),
    ThematicBreak,
}

pub struct Block {
    pub kind: BlockKind,
    pub span: LineSpan,
}

pub struct Reference {
    pub destination: string,
    pub title: string,
}

pub struct Document {
    pub blocks: Vec[Block],
    pub references: HashMap[string, Reference],
}

pub struct ParseOptions {
    pub max_bytes: isize,
    pub max_depth: isize,
    pub max_nodes: isize,
    pub max_work: isize,
}

impl ParseOptions {
    pub fn standard() -> ParseOptions {
        ParseOptions { max_bytes: 4194304, max_depth: 128, max_nodes: 250000, max_work: 20000000 }
    }
}

pub struct RenderOptions {
    pub allow_raw_html: bool,
    pub allow_unsafe_urls: bool,
    pub hard_breaks: bool,
    pub xhtml: bool,
    pub max_depth: isize,
    pub max_bytes: isize,
}

impl RenderOptions {
    pub fn standard() -> RenderOptions {
        RenderOptions {
            allow_raw_html: false,
            allow_unsafe_urls: false,
            hard_breaks: false,
            xhtml: true,
            max_depth: 256,
            max_bytes: 16777216,
        }
    }

    pub fn commonmark() -> RenderOptions {
        RenderOptions {
            allow_raw_html: true,
            allow_unsafe_urls: true,
            hard_breaks: false,
            xhtml: true,
            max_depth: 256,
            max_bytes: 16777216,
        }
    }
}

struct Context {
    options: ParseOptions,
    references: HashMap[string, Reference],
    nodes: Ref[isize],
    work: Ref[isize],
}

impl Context {
    fn tick(self: Context, line: isize) -> Result[(), Error] {
        self.spend(1, line)
    }

    fn spend(self: Context, amount: isize, line: isize) -> Result[(), Error] {
        if amount > self.options.max_work - self.work.get() {
            return Result::Err(Error { line, message: "parse work limit exceeded" })
        }
        self.work.set(self.work.get() + amount);
        Result::Ok(())
    }

    fn node(self: Context, line: isize) -> Result[(), Error] {
        if self.nodes.get() >= self.options.max_nodes {
            return Result::Err(Error { line, message: "parse node limit exceeded" })
        }
        self.nodes.set(self.nodes.get() + 1);
        Result::Ok(())
    }
}

struct Line {
    text: string,
    number: isize,
    lazy: bool,
}

enum RawKind {
    Definition,
    Paragraph(string),
    Heading(isize, string),
    Code(string, string),
    Html(string),
    Quote(Vec[RawBlock]),
    List(bool, isize, bool, Vec[Vec[RawBlock]]),
    ThematicBreak,
}

struct RawBlock {
    kind: RawKind,
    span: LineSpan,
}
