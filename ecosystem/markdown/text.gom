package markdown;

use std::text;
use std::unicode;

#[go_ffi("unicode", "IsPunct")]
extern fn is_punct(value: char) -> bool;

#[go_ffi("unicode", "IsSymbol")]
extern fn is_symbol(value: char) -> bool;

fn punctuation(ch: char) -> bool {
    is_punct(ch) || is_symbol(ch)
}

fn ascii_punctuation(ch: char) -> bool {
    "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~".contains(ch.to_string())
}

fn blank(value: string) -> bool {
    for ch in value.chars() {
        if ch != ' ' && ch != '\t' {
            return false
        }
    }
    true
}

fn previous(value: string, index: isize) -> char {
    if index == 0 {
        return ' '
    }
    let mut cursor = index - 1;
    while !value.is_char_boundary(cursor) {
        cursor -= 1;
    }
    value.get(cursor)
}

fn current(value: string, index: isize) -> char {
    if index >= value.byte_len() {
        ' '
    } else {
        value.get(index)
    }
}

fn whitespace(ch: char) -> bool {
    unicode::is_whitespace(ch)
}

fn indent(value: string) -> (isize, isize) {
    let mut index: isize = 0;
    let mut column: isize = 0;
    while index < value.byte_len() {
        if value.byte_get(index) == 32 {
            column += 1;
        } else if value.byte_get(index) == 9 {
            column += 4 - column % 4;
        } else {
            break;
        }
        index += 1;
    }
    let result = (column, index);
    result
}

fn strip_indent(value: string, count: isize) -> string {
    strip_indent_from(value, count, 0)
}

fn strip_indent_from(value: string, count: isize, base: isize) -> string {
    let mut index: isize = 0;
    let mut column = base;
    let target = base + count;
    while index < value.byte_len() && column < target {
        if value.byte_get(index) == 32 {
            column += 1;
        } else if value.byte_get(index) == 9 {
            column += 4 - column % 4;
        } else {
            break;
        }
        index += 1;
    }
    let extra = if column > target {
        " ".repeat(column - target)
    } else {
        ""
    };
    extra + value.byte_slice(index, value.byte_len())
}

fn container_view(value: string, base: isize) -> string {
    let mut index: isize = 0;
    let mut column = base;
    while index < value.byte_len() {
        if value.byte_get(index) == 32 {
            column += 1;
        } else if value.byte_get(index) == 9 {
            column += 4 - column % 4;
        } else {
            break;
        }
        index += 1;
    }
    if column - base >= 4 {
        "    " + strip_indent_from(value, 4, base)
    } else {
        " ".repeat(column - base) + value.byte_slice(index, value.byte_len())
    }
}

fn strip_container(value: string, count: isize) -> string {
    container_view(strip_indent(value, count), count)
}

fn trim_spaces(value: string) -> string {
    let mut start: isize = 0;
    let mut end = value.byte_len();
    while start < end && (value.byte_get(start) == 32 || value.byte_get(start) == 9) {
        start += 1;
    }
    while end > start && (value.byte_get(end - 1) == 32 || value.byte_get(end - 1) == 9) {
        end -= 1;
    }
    value.byte_slice(start, end)
}

fn repeat_at(value: string, start: isize, marker: u8) -> isize {
    let mut end = start;
    while end < value.byte_len() && value.byte_get(end) == marker {
        end += 1;
    }
    end - start
}

fn skip_space(value: string, start: isize) -> isize {
    let mut index = start;
    while index < value.byte_len()
        && (value.byte_get(index) == 32 || value.byte_get(index) == 9 || value.byte_get(index) == 10) {
        index += 1;
    }
    index
}

fn scalar(value: isize) -> string {
    let code = if value == 0 || value > 1114111 || (value >= 55296 && value <= 57343) {
        65533
    } else {
        value
    };
    let bytes: Vec[u8] = Vec::new();
    if code < 128 {
        bytes.push(code.to_u8());
    } else if code < 2048 {
        bytes.push((192 + code / 64).to_u8());
        bytes.push((128 + code % 64).to_u8());
    } else if code < 65536 {
        bytes.push((224 + code / 4096).to_u8());
        bytes.push((128 + code / 64 % 64).to_u8());
        bytes.push((128 + code % 64).to_u8());
    } else {
        bytes.push((240 + code / 262144).to_u8());
        bytes.push((128 + code / 4096 % 64).to_u8());
        bytes.push((128 + code / 64 % 64).to_u8());
        bytes.push((128 + code % 64).to_u8());
    }
    string_from_utf8(bytes).1
}

fn entity(value: string, start: isize) -> Option[(string, isize)] {
    if start >= value.byte_len() || value.byte_get(start) != 38 {
        return Option::None
    }
    let mut end = start + 1;
    while end < value.byte_len() && end - start <= 33 && value.byte_get(end) != 59 {
        let byte = value.byte_get(end);
        if !((byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57)
            || (byte == 35 && end == start + 1)) {
            return Option::None
        }
        end += 1;
    }
    if end >= value.byte_len() || value.byte_get(end) != 59 {
        return Option::None
    }
    let name = value.byte_slice(start + 1, end);
    if !name.starts_with("#") {
        return named_entity(name).map(|text| (text, end + 1))
    }
    let hex = name.starts_with("#x") || name.starts_with("#X");
    let first = if hex {
        2
    } else {
        1
    };
    let digits = name.byte_len() - first;
    if digits < 1
        || digits
            > (if hex {
                6
            } else {
                7
            }) {
        return Option::None
    }
    let mut number: isize = 0;
    for index in first..name.byte_len() {
        let byte = name.byte_get(index);
        let digit = if byte >= 48 && byte <= 57 {
            (byte - 48).to_isize()
        } else if hex && byte >= 65 && byte <= 70 {
            (byte - 55).to_isize()
        } else if hex && byte >= 97 && byte <= 102 {
            (byte - 87).to_isize()
        } else {
            return Option::None
        };
        number = number
            * (if hex {
                16
            } else {
                10
            })
            + digit;
    }
    Option::Some((scalar(number), end + 1))
}

fn unescape(value: string) -> string {
    let output = text::StringBuilder::new();
    let mut index: isize = 0;
    while index < value.byte_len() {
        let ch = value.get(index);
        if ch == '\\' && index + 1 < value.byte_len() && ascii_punctuation(value.get(index + 1)) {
            let next = value.get(index + 1);
            output.write_char(next);
            index += 1 + next.to_string().byte_len();
        } else if let Some((decoded, end)) = entity(value, index) {
            output.write_string(decoded);
            index = end;
        } else {
            output.write_char(ch);
            index += ch.to_string().byte_len();
        }
    }
    output.finish()
}

fn normalize_label(value: string) -> string {
    let output = text::StringBuilder::new();
    let mut pending = false;
    for ch in unicode::case_fold(value).chars() {
        if whitespace(ch) {
            pending = !output.is_empty();
        } else {
            if pending {
                output.write_char(' ');
            }
            pending = false;
            output.write_char(ch);
        }
    }
    output.finish()
}
