package markdown;

use std::text;

enum Visit {
    Block(Block),
    Inline(Inline),
}

fn push_inlines(stack: Vec[(Visit, isize)], values: Vec[Inline], depth: isize) -> () {
    let mut index = values.len();
    while index > 0 {
        index -= 1;
        stack.push((Visit::Inline(values[index]), depth));
    }
}

fn push_blocks(stack: Vec[(Visit, isize)], values: Vec[Block], depth: isize) -> () {
    let mut index = values.len();
    while index > 0 {
        index -= 1;
        stack.push((Visit::Block(values[index]), depth));
    }
}

fn walk_stack(stack: Vec[(Visit, isize)], visit_block: (Block) -> (), visit_inline: (Inline) -> ()) -> Result[
    (),
    Error,
] {
    let mut count: isize = 0;
    while let Some((visit, depth)) = stack.pop() {
        count += 1;
        if count > 250000 || depth > 256 {
            return Result::Err(Error { line: 0, message: "AST walk limit exceeded" })
        }
        match visit {
            Visit::Block(block) => {
                visit_block(block);
                match block.kind {
                    BlockKind::Paragraph(values) => push_inlines(stack, values, depth + 1),
                    BlockKind::Heading(_, values) => push_inlines(stack, values, depth + 1),
                    BlockKind::Quote(values) => push_blocks(stack, values, depth + 1),
                    BlockKind::List(_, _, _, items) => {
                        let mut index = items.len();
                        while index > 0 {
                            index -= 1;
                            push_blocks(stack, items[index], depth + 1);
                        }
                    },
                    _ => (),
                }
            },
            Visit::Inline(inline) => {
                visit_inline(inline);
                match inline {
                    Inline::Emphasis(values) => push_inlines(stack, values, depth + 1),
                    Inline::Strong(values) => push_inlines(stack, values, depth + 1),
                    Inline::Link(_, _, values) => push_inlines(stack, values, depth + 1),
                    Inline::Image(_, _, values) => push_inlines(stack, values, depth + 1),
                    _ => (),
                }
            },
        }
    }
    Result::Ok(())
}

pub fn walk(document: Document, visit_block: (Block) -> (), visit_inline: (Inline) -> ()) -> Result[
    (),
    Error,
] {
    let stack: Vec[(Visit, isize)] = Vec::new();
    push_blocks(stack, document.blocks, 0);
    walk_stack(stack, visit_block, visit_inline)
}

pub fn inline_text(inlines: Vec[Inline]) -> Result[string, Error] {
    let output = text::StringBuilder::new();
    let stack: Vec[(Visit, isize)] = Vec::new();
    push_inlines(stack, inlines, 0);
    walk_stack(
        stack,
        |_| (),
        |inline| {
            match inline {
                Inline::Text(value) => output.write_string(value),
                Inline::Code(value) => output.write_string(value),
                Inline::SoftBreak => output.write_char('\n'),
                Inline::HardBreak => output.write_char('\n'),
                _ => (),
            }
        },
    )?;
    Result::Ok(output.finish())
}
