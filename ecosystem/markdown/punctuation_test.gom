package markdown;

use std::testing;

#[test]
fn punctuation_includes_symbols_and_excludes_other_categories() -> () {
    for ch in "!$+^`|~§«»؉،。〰©€∑😀🫨".chars() {
        testing::assert(punctuation(ch));
    }
    for ch in "aZ9é中Ω\u0301\u200d\u00a0\t\n\u0378".chars() {
        testing::assert(!punctuation(ch));
    }
    testing::assert(!punctuation(char_from_u32(0x10ffff).unwrap_or(' ')));
}

#[test]
fn unicode_punctuation_table_covers_all_pinned_scalars() -> () {
    let mut count = 0;
    for code in 0..0x110000 {
        if let Some(ch) = char_from_u32(code.to_u32()) {
            if punctuation(ch) {
                count += 1;
            }
        }
    }
    testing::assert_eq(count, 8612);
}
