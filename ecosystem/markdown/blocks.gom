package markdown;

use std::text;

struct Fence {
    marker: u8,
    count: isize,
    indentation: isize,
    info: string,
}

struct Marker {
    ordered: bool,
    start: isize,
    delimiter: u8,
    padding: isize,
    content: string,
}

fn fence_start(value: string) -> Option[Fence] {
    let (columns, offset) = indent(value);
    if columns > 3 || offset >= value.byte_len() {
        return Option::None
    }
    let marker = value.byte_get(offset);
    if marker != 96 && marker != 126 {
        return Option::None
    }
    let count = repeat_at(value, offset, marker);
    if count < 3 {
        return Option::None
    }
    let info = trim_spaces(value.byte_slice(offset + count, value.byte_len()));
    if marker == 96 && info.contains("`") {
        return Option::None
    }
    Option::Some(Fence { marker, count, indentation: columns, info: unescape(info) })
}

fn fence_end(value: string, fence: Fence) -> bool {
    let (columns, offset) = indent(value);
    if columns > 3 {
        return false
    }
    let count = repeat_at(value, offset, fence.marker);
    count >= fence.count && blank(value.byte_slice(offset + count, value.byte_len()))
}

fn thematic(value: string) -> bool {
    let (columns, offset) = indent(value);
    if columns > 3 || offset >= value.byte_len() {
        return false
    }
    let marker = value.byte_get(offset);
    if marker != 42 && marker != 45 && marker != 95 {
        return false
    }
    let mut count: isize = 0;
    for byte in value.byte_slice(offset, value.byte_len()).to_bytes() {
        if byte == marker {
            count += 1;
        } else if byte != 32 && byte != 9 {
            return false
        }
    }
    count >= 3
}

fn atx(value: string) -> Option[(isize, string)] {
    let (columns, offset) = indent(value);
    if columns > 3 {
        return Option::None
    }
    let count = repeat_at(value, offset, 35);
    if count == 0 || count > 6 {
        return Option::None
    }
    let after = offset + count;
    if after < value.byte_len() && value.byte_get(after) != 32 && value.byte_get(after) != 9 {
        return Option::None
    }
    let content = trim_spaces(value.byte_slice(after, value.byte_len()));
    let mut end = content.byte_len();
    while end > 0 && content.byte_get(end - 1) == 35 {
        end -= 1;
    }
    let content = if end < content.byte_len()
        && (end == 0 || content.byte_get(end - 1) == 32 || content.byte_get(end - 1) == 9) {
        trim_spaces(content.byte_slice(0, end))
    } else {
        content
    };
    Option::Some((count, content))
}

fn setext(value: string) -> Option[isize] {
    let (columns, offset) = indent(value);
    if columns > 3 || offset >= value.byte_len() {
        return Option::None
    }
    let marker = value.byte_get(offset);
    if marker != 61 && marker != 45 {
        return Option::None
    }
    let count = repeat_at(value, offset, marker);
    if blank(value.byte_slice(offset + count, value.byte_len())) {
        Option::Some(
            if marker == 61 {
                1
            } else {
                2
            },
        )
    } else {
        Option::None
    }
}

fn quote_content(value: string) -> Option[string] {
    let raw = quote_content_raw(value)?;
    let (columns, offset) = indent(value);
    let after = offset + 1;
    let padding = if after < value.byte_len()
        && (value.byte_get(after) == 32 || value.byte_get(after) == 9) {
        2
    } else {
        1
    };
    Option::Some(container_view(raw, columns + padding))
}

fn quote_content_raw(value: string) -> Option[string] {
    let (columns, offset) = indent(value);
    if columns > 3 || offset >= value.byte_len() || value.byte_get(offset) != 62 {
        return Option::None
    }
    let mut after = offset + 1;
    if after < value.byte_len() && value.byte_get(after) == 32 {
        after += 1;
    } else if after < value.byte_len() && value.byte_get(after) == 9 {
        let remaining = 4 - (columns + 1) % 4 - 1;
        return Option::Some(" ".repeat(remaining) + value.byte_slice(after + 1, value.byte_len()))
    }
    Option::Some(value.byte_slice(after, value.byte_len()))
}

fn list_marker(value: string, interrupting: bool) -> Option[Marker] {
    let (columns, offset) = indent(value);
    if columns > 3 || offset >= value.byte_len() {
        return Option::None
    }
    let mut index = offset;
    let ordered = value.byte_get(index) >= 48 && value.byte_get(index) <= 57;
    let mut start: isize = 1;
    if ordered {
        start = 0;
        while index < value.byte_len() && value.byte_get(index) >= 48 && value.byte_get(index) <= 57 {
            if index - offset >= 9 {
                return Option::None
            }
            start = start * 10 + (value.byte_get(index) - 48).to_isize();
            index += 1;
        }
        if index >= value.byte_len() || (value.byte_get(index) != 46 && value.byte_get(index) != 41) {
            return Option::None
        }
        if interrupting && start != 1 {
            return Option::None
        }
    } else if value.byte_get(index) != 42 && value.byte_get(index) != 43
        && value.byte_get(index) != 45 {
        return Option::None
    }
    let delimiter = value.byte_get(index);
    index += 1;
    if index < value.byte_len() && value.byte_get(index) != 32 && value.byte_get(index) != 9 {
        return Option::None
    }
    if interrupting && blank(value.byte_slice(index, value.byte_len())) {
        return Option::None
    }
    let marker_columns = columns + index - offset;
    let mut after = index;
    let mut column = marker_columns;
    while after < value.byte_len() {
        if value.byte_get(after) == 32 {
            column += 1;
        } else if value.byte_get(after) == 9 {
            column += 4 - column % 4;
        } else {
            break;
        }
        after += 1;
    }
    let padding = if column - marker_columns >= 1 && column - marker_columns <= 4
        && after < value.byte_len() {
        column
    } else {
        marker_columns + 1
    };
    let prefix = " ".repeat(marker_columns) + value.byte_slice(index, value.byte_len());
    Option::Some(
        Marker { ordered, start, delimiter, padding, content: strip_container(prefix, padding) },
    )
}

fn interrupts(value: string) -> bool {
    atx(value).is_some() || fence_start(value).is_some() || thematic(value)
        || quote_content(value).is_some()
        || list_marker(value, true).is_some()
        || html_block_start(value, true).is_some()
}

fn lazy_text(value: string) -> bool {
    let mut content = value;
    loop {
        if let Some(inner) = quote_content(content) {
            content = inner;
            continue;
        }
        if let Some(marker) = list_marker(content, false) {
            content = marker.content;
            continue;
        }
        break;
    }
    !blank(content) && !interrupts(content) && indent(content).0 < 4 && setext(content).is_none()
}

fn last_line(lines: Vec[Line], start: isize, end: isize) -> isize {
    let mut index = end;
    while index > start + 1 && blank(lines[index - 1].text) {
        index -= 1;
    }
    lines[index - 1].number
}

fn parse_blocks(context: Context, lines: Vec[Line], depth: isize) -> Result[Vec[RawBlock], Error] {
    if depth > context.options.max_depth {
        return Result::Err(
            Error {
                line: if lines.is_empty() {
                    0
                } else {
                    lines[0].number
                },
                message: "block nesting limit exceeded",
            },
        )
    }
    let blocks: Vec[RawBlock] = Vec::new();
    let mut index: isize = 0;
    while index < lines.len() {
        context.tick(lines[index].number)?;
        if blank(lines[index].text) {
            index += 1;
            continue;
        }
        context.node(lines[index].number)?;
        let start = index;
        let line = lines[index];
        if let Some(fence) = fence_start(line.text) {
            let content = text::StringBuilder::new();
            index += 1;
            while index < lines.len() && !fence_end(lines[index].text, fence) {
                context.tick(lines[index].number)?;
                content.write_line(strip_indent(lines[index].text, fence.indentation));
                index += 1;
            }
            if index < lines.len() {
                index += 1;
            }
            blocks.push(
                RawBlock {
                    kind: RawKind::Code(fence.info, content.finish()),
                    span: LineSpan { start: line.number, end: lines[index - 1].number },
                },
            );
            continue;
        }
        if let Some((level, content)) = atx(line.text) {
            blocks.push(
                RawBlock {
                    kind: RawKind::Heading(level, content),
                    span: LineSpan { start: line.number, end: line.number },
                },
            );
            index += 1;
            continue;
        }
        if thematic(line.text) {
            blocks.push(
                RawBlock {
                    kind: RawKind::ThematicBreak,
                    span: LineSpan { start: line.number, end: line.number },
                },
            );
            index += 1;
            continue;
        }
        if let Some((kind, ending)) = html_block_start(line.text, false) {
            let content = text::StringBuilder::new();
            while index < lines.len() {
                if kind >= 6 && blank(lines[index].text) {
                    break;
                }
                let text = lines[index].text;
                content.write_line(text);
                index += 1;
                if kind < 6
                    && (if kind == 1 {
                        text.to_ascii_lowercase().contains(ending)
                    } else {
                        text.contains(ending)
                    }) {
                    break;
                }
            }
            blocks.push(
                RawBlock {
                    kind: RawKind::Html(content.finish()),
                    span: LineSpan { start: line.number, end: lines[index - 1].number },
                },
            );
            continue;
        }
        if quote_content(line.text).is_some() {
            let inner: Vec[Line] = Vec::new();
            let mut lazy = false;
            let mut active_fence: Option[Fence] = Option::None;
            while index < lines.len() {
                let current = lines[index];
                if let Some(content) = if active_fence.is_some() {
                    quote_content_raw(current.text)
                } else {
                    quote_content(current.text)
                } {
                    if let Some(fence) = active_fence {
                        if fence_end(content, fence) {
                            active_fence = Option::None;
                        }
                        lazy = false;
                    } else if let Some(fence) = fence_start(content) {
                        active_fence = Option::Some(fence);
                        lazy = false;
                    } else {
                        lazy = lazy_text(content)
                            || (lazy && !blank(content) && !interrupts(content)
                                && setext(content).is_none());
                    }
                    inner.push(Line { text: content, number: current.number, lazy: current.lazy });
                    index += 1;
                } else if lazy && !blank(current.text) && !interrupts(current.text) {
                    inner.push(Line { text: current.text, number: current.number, lazy: true });
                    index += 1;
                } else {
                    break;
                }
            }
            blocks.push(
                RawBlock {
                    kind: RawKind::Quote(parse_blocks(context, inner, depth + 1)?),
                    span: LineSpan { start: line.number, end: last_line(lines, start, index) },
                },
            );
            continue;
        }
        if let Some(first) = list_marker(line.text, false) {
            let items: Vec[Vec[RawBlock]] = Vec::new();
            let mut loose = false;
            loop {
                if index >= lines.len() {
                    break;
                }
                let Some(marker) = list_marker(lines[index].text, false) else {
                    break;
                };
                if marker.ordered != first.ordered || marker.delimiter != first.delimiter
                    || thematic(lines[index].text) {
                    break;
                }
                let inner = Vec::from_array(
                    [
                        Line {
                            text: marker.content,
                            number: lines[index].number,
                            lazy: lines[index].lazy,
                        },
                    ],
                );
                index += 1;
                let mut lazy = lazy_text(marker.content);
                let mut previous_blank = blank(marker.content);
                let mut active_fence = fence_start(marker.content);
                while index < lines.len() {
                    let current = lines[index];
                    if blank(current.text) {
                        inner.push(current);
                        previous_blank = true;
                        lazy = false;
                        index += 1;
                        if inner.len() == 2 && blank(marker.content) {
                            break;
                        }
                        continue;
                    }
                    if indent(current.text).0 >= marker.padding {
                        let content = if active_fence.is_some() {
                            strip_indent(current.text, marker.padding)
                        } else {
                            strip_container(current.text, marker.padding)
                        };
                        inner.push(
                            Line { text: content, number: current.number, lazy: current.lazy },
                        );
                        previous_blank = false;
                        if let Some(fence) = active_fence {
                            if fence_end(content, fence) {
                                active_fence = Option::None;
                            }
                            lazy = false;
                        } else if let Some(fence) = fence_start(content) {
                            active_fence = Option::Some(fence);
                            lazy = false;
                        } else {
                            lazy = lazy_text(content)
                                || (lazy && !blank(content) && !interrupts(content));
                        }
                        index += 1;
                        continue;
                    }
                    if list_marker(current.text, false).is_some() {
                        break;
                    }
                    if lazy && !previous_blank && !interrupts(current.text) {
                        inner.push(Line { text: current.text, number: current.number, lazy: true });
                        index += 1;
                        continue;
                    }
                    break;
                }
                let children = parse_blocks(context, inner, depth + 1)?;
                for child in 1..children.len() {
                    let left = children[child - 1].span.end;
                    let right = children[child].span.start;
                    for input in inner {
                        if input.number > left && input.number < right && blank(input.text) {
                            loose = true;
                        }
                    }
                }
                items.push(children);
                if index < lines.len() {
                    if let Some(next) = list_marker(lines[index].text, false) {
                        if next.ordered == first.ordered && next.delimiter == first.delimiter
                            && !thematic(lines[index].text) {
                            if previous_blank && inner.len() > 1 {
                                loose = true;
                            }
                            continue;
                        }
                    }
                }
                break;
            }
            blocks.push(
                RawBlock {
                    kind: RawKind::List(first.ordered, first.start, !loose, items),
                    span: LineSpan { start: line.number, end: last_line(lines, start, index) },
                },
            );
            continue;
        }
        if indent(line.text).0 >= 4 {
            let collected: Vec[string] = Vec::new();
            while index < lines.len()
                && (blank(lines[index].text) || indent(lines[index].text).0 >= 4) {
                collected.push(strip_indent(lines[index].text, 4));
                index += 1;
            }
            while !collected.is_empty() && blank(collected[collected.len() - 1]) {
                let _ = collected.pop();
            }
            let content = text::join(collected, "\n") + "\n";
            blocks.push(
                RawBlock {
                    kind: RawKind::Code("", content),
                    span: LineSpan { start: line.number, end: last_line(lines, start, index) },
                },
            );
            continue;
        }
        let content = text::StringBuilder::new();
        content.write_string(strip_indent(line.text, indent(line.text).0));
        index += 1;
        let mut heading: Option[isize] = Option::None;
        while index < lines.len() && !blank(lines[index].text) {
            if let Some(level) = if lines[index].lazy {
                Option::None
            } else {
                setext(lines[index].text)
            } {
                if take_references(context, content.finish()).trim() == "" {
                    content.write_char('\n');
                    content.write_string(lines[index].text);
                    index += 1;
                    continue;
                }
                heading = Option::Some(level);
                index += 1;
                break;
            }
            if interrupts(lines[index].text) {
                break;
            }
            content.write_char('\n');
            content.write_string(strip_indent(lines[index].text, indent(lines[index].text).0));
            index += 1;
        }
        let original = content.finish();
        let remaining = take_references(context, original);
        let parsed = remaining.trim();
        if remaining.byte_len() < original.byte_len() {
            let removed_lines = original.byte_slice(0, original.byte_len() - remaining.byte_len()).split(
                "\n",
            ).len()
                - 1;
            blocks.push(
                RawBlock {
                    kind: RawKind::Definition,
                    span: LineSpan {
                        start: line.number,
                        end: line.number
                            + (if remaining == "" {
                                removed_lines
                            } else {
                                removed_lines - 1
                            }),
                    },
                },
            );
        }
        if parsed != "" {
            let removed = original.byte_slice(0, original.byte_len() - remaining.byte_len()).split(
                "\n",
            ).len()
                - 1;
            blocks.push(
                RawBlock {
                    kind: match heading {
                        Some(level) => RawKind::Heading(level, parsed),
                        None => RawKind::Paragraph(parsed),
                    },
                    span: LineSpan { start: line.number + removed, end: lines[index - 1].number },
                },
            );
        } else if heading.is_some() {
            let underline = lines[index - 1];
            let tail = parse_blocks(context, Vec::from_array([underline]), depth)?;
            blocks.extend(tail);
        }
    }
    Result::Ok(blocks)
}

fn finalize(context: Context, raw: Vec[RawBlock]) -> Result[Vec[Block], Error] {
    let blocks: Vec[Block] = Vec::new();
    for block in raw {
        let kind = match block.kind {
            RawKind::Definition => continue,
            RawKind::Paragraph(value) => BlockKind::Paragraph(
                parse_inlines(context, value, block.span.start)?,
            ),
            RawKind::Heading(level, value) => BlockKind::Heading(
                level,
                parse_inlines(context, value, block.span.start)?,
            ),
            RawKind::Code(info, value) => BlockKind::Code(info, value),
            RawKind::Html(value) => BlockKind::Html(value),
            RawKind::Quote(children) => BlockKind::Quote(finalize(context, children)?),
            RawKind::List(ordered, start, tight, items) => {
                let converted: Vec[Vec[Block]] = Vec::new();
                for item in items {
                    converted.push(finalize(context, item)?);
                }
                BlockKind::List(ordered, start, tight, converted)
            },
            RawKind::ThematicBreak => BlockKind::ThematicBreak,
        };
        blocks.push(Block { kind, span: block.span });
    }
    Result::Ok(blocks)
}

pub fn parse_with_options(source: string, options: ParseOptions) -> Result[Document, Error] {
    if options.max_bytes < 0 || source.byte_len() > options.max_bytes || options.max_depth < 1
        || options.max_nodes < 0
        || options.max_work < 0 {
        return Result::Err(
            Error { line: 0, message: "invalid parse limits or input exceeds size limit" },
        )
    }
    let source = source.replace("\r\n", "\n").replace("\r", "\n").replace(
        string_from_utf8(Vec::from_array([0])).1,
        "�",
    );
    let lines: Vec[Line] = Vec::new();
    let parts = source.split("\n");
    for index in 0..parts.len() {
        if index + 1 == parts.len() && parts[index] == "" {
            break;
        }
        lines.push(Line { text: parts[index], number: index, lazy: false });
    }
    let context = Context {
        options,
        references: HashMap::new(),
        nodes: Ref::new(0),
        work: Ref::new(0),
    };
    let raw = parse_blocks(context, lines, 0)?;
    Result::Ok(Document { blocks: finalize(context, raw)?, references: context.references })
}

pub fn parse(source: string) -> Result[Document, Error] {
    parse_with_options(source, ParseOptions::standard())
}
