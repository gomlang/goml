package markdown;

fn label_at(value: string, start: isize) -> Option[(string, isize)] {
    if start >= value.byte_len() || value.byte_get(start) != 91 {
        return Option::None
    }
    let mut index = start + 1;
    let mut count: isize = 0;
    while index < value.byte_len() {
        let ch = value.get(index);
        if ch == ']' {
            return Option::Some((value.byte_slice(start + 1, index), index + 1))
        }
        if ch == '[' || count >= 999 {
            return Option::None
        }
        if ch == '\\' && index + 1 < value.byte_len() && ascii_punctuation(value.get(index + 1)) {
            index += 1;
            count += 1;
        }
        index += value.get(index).to_string().byte_len();
        count += 1;
    }
    Option::None
}

fn destination_at(value: string, start: isize) -> Option[(string, isize)] {
    let mut index = start;
    if index < value.byte_len() && value.byte_get(index) == 60 {
        index += 1;
        let first = index;
        while index < value.byte_len() {
            let ch = value.get(index);
            if ch == '>' {
                return Option::Some((unescape(value.byte_slice(first, index)), index + 1))
            }
            if ch == '\n' || ch == '<' {
                return Option::None
            }
            if ch == '\\' && index + 1 < value.byte_len() && ascii_punctuation(value.get(index + 1)) {
                index += 1;
            }
            index += value.get(index).to_string().byte_len();
        }
        return Option::None
    }
    let mut nesting: isize = 0;
    while index < value.byte_len() {
        let ch = value.get(index);
        if ch <= ' ' {
            break;
        }
        if ch == '(' {
            nesting += 1;
            if nesting > 128 {
                return Option::None
            }
        }
        if ch == ')' {
            if nesting == 0 {
                break;
            }
            nesting -= 1;
        }
        if ch == '\\' && index + 1 < value.byte_len() && ascii_punctuation(value.get(index + 1)) {
            index += 1;
        }
        index += value.get(index).to_string().byte_len();
    }
    if nesting != 0 {
        Option::None
    } else {
        Option::Some((unescape(value.byte_slice(start, index)), index))
    }
}

fn title_at(value: string, start: isize) -> Option[(string, isize)] {
    if start >= value.byte_len() {
        return Option::None
    }
    let opener = value.get(start);
    let closer = if opener == '(' {
        ')'
    } else {
        opener
    };
    if opener != '(' && opener != '\'' && opener != '"' {
        return Option::None
    }
    let mut index = start + 1;
    let mut previous_newline = false;
    while index < value.byte_len() {
        let ch = value.get(index);
        if ch == closer {
            return Option::Some((unescape(value.byte_slice(start + 1, index)), index + 1))
        }
        if ch == '(' && opener == '(' {
            return Option::None
        }
        if ch == '\n' {
            if previous_newline {
                return Option::None
            }
            previous_newline = true;
        } else if ch != ' ' && ch != '\t' {
            previous_newline = false;
        }
        if ch == '\\' && index + 1 < value.byte_len() && ascii_punctuation(value.get(index + 1)) {
            index += 1;
        }
        index += value.get(index).to_string().byte_len();
    }
    Option::None
}

fn inline_destination(value: string, start: isize) -> Option[(Reference, isize)] {
    if start >= value.byte_len() || value.byte_get(start) != 40 {
        return Option::None
    }
    let first = skip_space(value, start + 1);
    let (destination, end) = destination_at(value, first)?;
    let mut cursor = skip_space(value, end);
    let mut title = "";
    if cursor > end {
        if let Some((text, after)) = title_at(value, cursor) {
            title = text;
            cursor = skip_space(value, after);
        }
    }
    if cursor < value.byte_len() && value.byte_get(cursor) == 41 {
        Option::Some((Reference { destination, title }, cursor + 1))
    } else {
        Option::None
    }
}

fn reference_at(value: string, start: isize) -> Option[(string, Reference, isize)] {
    let (label, end) = label_at(value, start)?;
    let normalized = normalize_label(label);
    if normalized == "" || end >= value.byte_len() || value.byte_get(end) != 58 {
        return Option::None
    }
    let first = skip_space(value, end + 1);
    let (destination, after) = destination_at(value, first)?;
    if first == after {
        return Option::None
    }
    let mut cursor = after;
    while cursor < value.byte_len() && (value.byte_get(cursor) == 32 || value.byte_get(cursor) == 9) {
        cursor += 1;
    }
    let end_of_destination = cursor;
    let mut title = "";
    let possible_title = skip_space(value, cursor);
    if possible_title > after {
        if let Some((text, end)) = title_at(value, possible_title) {
            let mut next = end;
            while next < value.byte_len()
                && (value.byte_get(next) == 32 || value.byte_get(next) == 9) {
                next += 1;
            }
            if next == value.byte_len() || value.byte_get(next) == 10 {
                title = text;
                cursor = next;
            }
        }
    }
    if cursor == end_of_destination && cursor < value.byte_len() && value.byte_get(cursor) != 10 {
        return Option::None
    }
    if cursor < value.byte_len() && value.byte_get(cursor) == 10 {
        cursor += 1;
    }
    Option::Some((normalized, Reference { destination, title }, cursor))
}

fn take_references(context: Context, value: string) -> string {
    let mut index: isize = 0;
    loop {
        let first = skip_space(value, index);
        let Some((label, reference, end)) = reference_at(value, first) else {
            break;
        };
        if !context.references.contains(label) {
            context.references.set(label, reference);
        }
        index = end;
    }
    value.byte_slice(index, value.byte_len())
}
