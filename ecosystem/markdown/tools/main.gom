package main;

use std::collections;
use std::crypto::hash;
use std::env;
use std::fs;
use std::io;
use std::json;
use std::process;
use std::text;

const SOURCE_SHA256: string = "ea49a2b75ac0cd3028224804e1925509528ddadf3271131545b546f740c71192";

pub fn generate(root: string) -> Result[string, string] {
    let source_path = root + "/tools/data/entities.json";
    if hash::sha256_file(source_path).map_err(|error| error.to_string())? != SOURCE_SHA256 {
        return Result::Err("HTML entity source checksum mismatch");
    }
    let source = fs::read_file_structured(source_path).map_err(|error| error.to_string())?;
    let entries = match json::parse(source)? {
        json::Value::Object(entries) => entries,
        _ => return Result::Err("expected named-entity object"),
    };
    if entries.len() != 2125 {
        return Result::Err("expected all 2125 HTML5 entities");
    }
    let names = Vec::new();
    let values = HashMap::new();
    for (name, value) in entries {
        if name == "" {
            return Result::Err("empty HTML entity name");
        }
        for byte in name.to_bytes() {
            if !((byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
                || (byte >= 48 && byte <= 57)) {
                return Result::Err("invalid HTML entity name");
            }
        }
        let value = json::as_string(value).ok_or("expected HTML entity replacement string")?;
        if value == "" || values.contains(name) {
            return Result::Err("empty or duplicate HTML entity");
        }
        names.push(name);
        values.insert(name, value);
    }
    collections::sort(names);
    let prefixes: Vec[byte] = Vec::new();
    for name in names {
        if !prefixes.contains(name.byte_get(0)) {
            prefixes.push(name.byte_get(0));
        }
    }
    let output = text::StringBuilder::new();
    output.write_string(
        "package markdown;\n\nfn named_entity(name: string) -> Option[string] {\n    if name == \"\" {\n        return Option::None\n    }\n    match name.byte_get(0) {\n",
    );
    for prefix in prefixes {
        output.write_string(
            "        " + prefix.to_string() + " => entity_" + prefix.to_string() + "(name),\n",
        );
    }
    output.write_string("        _ => Option::None,\n    }\n}\n");
    for prefix in prefixes {
        output.write_string(
            "\nfn entity_" + prefix.to_string()
                + "(name: string) -> Option[string] {\n    match name {\n",
        );
        for name in names {
            if name.byte_get(0) == prefix {
                let value = values.get(name).ok_or("missing HTML entity replacement")?;
                output.write_string(
                    "        " + json::encode(json::Value::String(name)) + " => Option::Some("
                        + json::encode(json::Value::String(value))
                        + "),\n",
                );
            }
        }
        output.write_string("        _ => Option::None,\n    }\n}\n");
    }
    Result::Ok(output.finish())
}

pub fn verify(root: string) -> Result[(), string] {
    let existing = fs::read_file_structured(root + "/entities.gom").map_err(
        |error| error.to_string(),
    )?;
    if generate(root)? != existing {
        return Result::Err("generated HTML entities differ; run the native tool with generate");
    }
    Result::Ok(())
}

fn run() -> Result[(), string] {
    let args = env::args();
    let command = if args.len() > 1 {
        args[1]
    } else {
        "check"
    };
    let root = if args.len() > 2 {
        args[2]
    } else {
        ".."
    };
    if command == "check" {
        verify(root)
    } else if command == "generate" {
        fs::write_file_structured(root + "/entities.gom", generate(root)?).map_err(
            |error| error.to_string(),
        )
    } else {
        Result::Err("usage: markdown_entities [check|generate] [markdown directory]")
    }
}

fn main() -> () {
    if let Err(error) = run() {
        io::eprintln(error);
        process::exit(1);
    }
}
