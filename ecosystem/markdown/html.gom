package markdown;

fn ascii_letter(ch: char) -> bool {
    (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z')
}

fn ascii_digit(ch: char) -> bool {
    ch >= '0' && ch <= '9'
}

fn tag_end(value: string, start: isize) -> Option[isize] {
    if start >= value.byte_len() || value.byte_get(start) != 60 {
        return Option::None
    }
    let mut index = start + 1;
    let closing = current(value, index) == '/';
    if closing {
        index += 1;
    }
    if !ascii_letter(current(value, index)) {
        return Option::None
    }
    while index < value.byte_len()
        && (ascii_letter(value.get(index)) || ascii_digit(value.get(index))
            || value.get(index) == '-') {
        index += 1;
    }
    if closing {
        index = skip_space(value, index);
        if index < value.byte_len() && value.byte_get(index) == 62 {
            return Option::Some(index + 1)
        }
        return Option::None
    }
    loop {
        let spaced = skip_space(value, index);
        let had_space = spaced > index;
        index = spaced;
        if value.starts_with_at(index, "/>") {
            return Option::Some(index + 2)
        }
        if value.starts_with_at(index, ">") {
            return Option::Some(index + 1)
        }
        if !had_space {
            return Option::None
        }
        let ch = current(value, index);
        if !ascii_letter(ch) && ch != '_' && ch != ':' {
            return Option::None
        }
        index += 1;
        while index < value.byte_len() {
            let ch = value.get(index);
            if !ascii_letter(ch) && !ascii_digit(ch) && !"_:.-".contains(ch.to_string()) {
                break;
            }
            index += 1;
        }
        let after_name = index;
        index = skip_space(value, index);
        if current(value, index) != '=' {
            index = after_name;
            continue;
        }
        index = skip_space(value, index + 1);
        let quote = current(value, index);
        if quote == '\'' || quote == '"' {
            index += 1;
            while index < value.byte_len() && value.get(index) != quote {
                index += value.get(index).to_string().byte_len();
            }
            if index >= value.byte_len() {
                return Option::None
            }
            index += 1;
        } else {
            let first = index;
            while index < value.byte_len() {
                let ch = value.get(index);
                if whitespace(ch) || "\"'=<>`".contains(ch.to_string()) {
                    break;
                }
                index += ch.to_string().byte_len();
            }
            if first == index {
                return Option::None
            }
        }
    }
}

fn until(value: string, start: isize, marker: string) -> Option[isize] {
    value.byte_slice(start, value.byte_len()).find(marker).map(
        |offset| start + offset + marker.byte_len(),
    )
}

fn inline_html_end(value: string, start: isize) -> Option[isize] {
    if value.starts_with_at(start, "<!--") {
        if value.starts_with_at(start + 4, ">") {
            return Option::Some(start + 5)
        }
        if value.starts_with_at(start + 4, "->") {
            return Option::Some(start + 6)
        }
        return until(value, start + 4, "-->")
    }
    if value.starts_with_at(start, "<?") {
        return until(value, start + 2, "?>")
    }
    if value.starts_with_at(start, "<![CDATA[") {
        return until(value, start + 9, "]]>")
    }
    if value.starts_with_at(start, "<!") && current(value, start + 2) >= 'A'
        && current(value, start + 2) <= 'Z' {
        let mut index = start + 2;
        while current(value, index) >= 'A' && current(value, index) <= 'Z' {
            index += 1;
        }
        if whitespace(current(value, index)) {
            return until(value, index, ">")
        }
    }
    tag_end(value, start)
}

fn html_block_start(value: string, interrupting: bool) -> Option[(isize, string)] {
    let (columns, offset) = indent(value);
    if columns > 3 {
        return Option::None
    }
    let value = value.byte_slice(offset, value.byte_len());
    let lower = value.to_ascii_lowercase();
    for tag in Vec::from_array(["script", "pre", "style", "textarea"]) {
        let prefix = "<" + tag;
        if lower.starts_with(prefix) {
            let ch = current(lower, prefix.byte_len());
            if ch == '>' || whitespace(ch) {
                return Option::Some((1, "</" + tag + ">"))
            }
        }
    }
    if value.starts_with("<!--") {
        return Option::Some((2, "-->"))
    }
    if value.starts_with("<?") {
        return Option::Some((3, "?>"))
    }
    if value.starts_with("<![CDATA[") {
        return Option::Some((5, "]]>"))
    }
    if value.starts_with("<!") && current(value, 2) >= 'A' && current(value, 2) <= 'Z' {
        return Option::Some((4, ">"))
    }
    let tags = "address article aside base basefont blockquote body caption center col colgroup dd details dialog dir div dl dt fieldset figcaption figure footer form frame frameset h1 h2 h3 h4 h5 h6 head header hr html iframe legend li link main menu menuitem nav noframes ol optgroup option p param search section summary table tbody td tfoot th thead title tr track ul";
    let mut index: isize = if lower.starts_with("</") {
        2
    } else if lower.starts_with("<") {
        1
    } else {
        return Option::None
    };
    let start = index;
    while ascii_letter(current(lower, index)) || ascii_digit(current(lower, index)) {
        index += 1;
    }
    let name = lower.byte_slice(start, index);
    if name != "" && (" " + tags + " ").contains(" " + name + " ") {
        let ch = current(lower, index);
        if whitespace(ch) || ch == '>' || lower.starts_with_at(index, "/>") {
            return Option::Some((6, ""))
        }
    }
    if !interrupting {
        if let Some(end) = tag_end(value, 0) {
            if blank(value.byte_slice(end, value.byte_len())) {
                return Option::Some((7, ""))
            }
        }
    }
    Option::None
}

fn autolink(value: string, start: isize) -> Option[(Reference, string, isize)] {
    let end = value.byte_slice(start + 1, value.byte_len()).find(">")? + start + 1;
    let inside = value.byte_slice(start + 1, end);
    for ch in inside.chars() {
        if ch <= ' ' || ch == '<' {
            return Option::None
        }
    }
    if let Some((scheme, _)) = inside.split_once(":") {
        if scheme.byte_len() >= 2 && scheme.byte_len() <= 32 && ascii_letter(scheme.get(0)) {
            let mut valid = true;
            for ch in scheme.chars() {
                if !ascii_letter(ch) && !ascii_digit(ch) && !"+.-".contains(ch.to_string()) {
                    valid = false;
                }
            }
            if valid {
                return Option::Some((Reference { destination: inside, title: "" }, inside, end + 1))
            }
        }
    }
    let (local, domain) = inside.split_once("@")?;
    if local == "" || domain == "" {
        return Option::None
    }
    for ch in local.chars() {
        if !ascii_letter(ch) && !ascii_digit(ch) && !".!#$%&'*+/=?^_`{|}~-".contains(ch.to_string()) {
            return Option::None
        }
    }
    for part in domain.split(".") {
        if part == "" || part.byte_len() > 63 || part.starts_with("-") || part.ends_with("-") {
            return Option::None
        }
        for ch in part.chars() {
            if !ascii_letter(ch) && !ascii_digit(ch) && ch != '-' {
                return Option::None
            }
        }
    }
    Option::Some((Reference { destination: "mailto:" + inside, title: "" }, inside, end + 1))
}
