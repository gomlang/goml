package markdown;

struct Piece {
    value: Ref[Inline],
    previous: Ref[isize],
    next: Ref[isize],
    depth: Ref[isize],
}

struct Delimiter {
    node: isize,
    marker: u8,
    count: Ref[isize],
    original: isize,
    opens: bool,
    closes: bool,
    active: Ref[bool],
}

struct Bracket {
    node: isize,
    start: isize,
    bottom: isize,
    image: bool,
    active: Ref[bool],
}

fn append_piece(context: Context, pieces: Vec[Piece], tail: Ref[isize], value: Inline, line: isize) -> Result[
    isize,
    Error,
] {
    context.node(line)?;
    let id = pieces.len();
    pieces.push(
        Piece {
            value: Ref::new(value),
            previous: Ref::new(tail.get()),
            next: Ref::new(-1),
            depth: Ref::new(0),
        },
    );
    pieces[tail.get()].next.set(id);
    tail.set(id);
    Result::Ok(id)
}

fn detach(pieces: Vec[Piece], id: isize, tail: Ref[isize]) -> () {
    let piece = pieces[id];
    let previous = piece.previous.get();
    let next = piece.next.get();
    if previous >= 0 {
        pieces[previous].next.set(next);
    }
    if next >= 0 {
        pieces[next].previous.set(previous);
    } else {
        tail.set(previous);
    }
}

fn collect_pieces(pieces: Vec[Piece], start: isize, end: isize) -> Vec[Inline] {
    let result: Vec[Inline] = Vec::new();
    let mut index = start;
    while index >= 0 && index != end {
        let value = pieces[index].value.get();
        match value {
            Inline::Text(text) => if text != "" {
                result.push(value);
            },
            _ => result.push(value),
        }
        index = pieces[index].next.get();
    }
    result
}

fn nesting(context: Context, pieces: Vec[Piece], start: isize, end: isize, line: isize) -> Result[
    isize,
    Error,
] {
    let mut depth: isize = 1;
    let mut index = start;
    while index >= 0 && index != end {
        if pieces[index].depth.get() + 1 > depth {
            depth = pieces[index].depth.get() + 1;
        }
        index = pieces[index].next.get();
    }
    if depth > context.options.max_depth {
        Result::Err(Error { line, message: "inline nesting limit exceeded" })
    } else {
        Result::Ok(depth)
    }
}

fn emphasis(
    context: Context,
    pieces: Vec[Piece],
    delimiters: Vec[Delimiter],
    tail: Ref[isize],
    bottom: isize,
    line: isize,
) -> Result[(), Error] {
    let mut closer = bottom;
    while closer < delimiters.len() {
        context.tick(line)?;
        let close = delimiters[closer];
        if !close.active.get() || !close.closes || close.count.get() == 0 {
            closer += 1;
            continue;
        }
        let mut opener = closer - 1;
        let mut found = false;
        while opener >= bottom {
            context.tick(line)?;
            let open = delimiters[opener];
            let odd = (open.closes || close.opens) && (open.original + close.original) % 3 == 0
                && (open.original % 3 != 0 || close.original % 3 != 0);
            if open.active.get() && open.opens && open.marker == close.marker
                && open.count.get() > 0
                && !odd {
                found = true;
                break;
            }
            opener -= 1;
        }
        if !found {
            closer += 1;
            continue;
        }
        let open = delimiters[opener];
        let used = if open.count.get() >= 2 && close.count.get() >= 2 {
            2
        } else {
            1
        };
        let start = pieces[open.node].next.get();
        let depth = nesting(context, pieces, start, close.node, line)?;
        let children = collect_pieces(pieces, start, close.node);
        let value = if used == 2 {
            Inline::Strong(children)
        } else {
            Inline::Emphasis(children)
        };
        context.node(line)?;
        let node = pieces.len();
        pieces.push(
            Piece {
                value: Ref::new(value),
                previous: Ref::new(open.node),
                next: Ref::new(close.node),
                depth: Ref::new(depth),
            },
        );
        pieces[open.node].next.set(node);
        pieces[close.node].previous.set(node);
        open.count.set(open.count.get() - used);
        close.count.set(close.count.get() - used);
        let marker = if open.marker == 42 {
            "*"
        } else {
            "_"
        };
        pieces[open.node].value.set(Inline::Text(marker.repeat(open.count.get())));
        pieces[close.node].value.set(Inline::Text(marker.repeat(close.count.get())));
        for index in opener + 1..closer {
            delimiters[index].active.set(false);
        }
        if open.count.get() == 0 {
            open.active.set(false);
            detach(pieces, open.node, tail);
        }
        if close.count.get() == 0 {
            close.active.set(false);
            detach(pieces, close.node, tail);
            closer += 1;
        }
    }
    Result::Ok(())
}

fn parse_inlines(context: Context, value: string, line: isize) -> Result[Vec[Inline], Error] {
    let pieces = Vec::from_array(
        [
            Piece {
                value: Ref::new(Inline::Text("")),
                previous: Ref::new(-1),
                next: Ref::new(-1),
                depth: Ref::new(0),
            },
        ],
    );
    let tail = Ref::new(0);
    let delimiters: Vec[Delimiter] = Vec::new();
    let brackets: Vec[Bracket] = Vec::new();
    let mut index: isize = 0;
    while index < value.byte_len() {
        context.tick(line)?;
        let ch = value.get(index);
        if ch == '\\' && index + 1 < value.byte_len() {
            let next = value.get(index + 1);
            if ascii_punctuation(next) || next == '\n' {
                let _ = append_piece(
                    context,
                    pieces,
                    tail,
                    if next == '\n' {
                        Inline::HardBreak
                    } else {
                        Inline::Text(next.to_string())
                    },
                    line,
                )?;
                index += 1 + next.to_string().byte_len();
                if next == '\n' {
                    while index < value.byte_len()
                        && (value.byte_get(index) == 32 || value.byte_get(index) == 9) {
                        index += 1;
                    }
                }
                continue;
            }
        }
        if ch == '\n' {
            let mut hard = false;
            if let Inline::Text(text) = pieces[tail.get()].value.get() {
                let mut end = text.byte_len();
                while end > 0 && text.byte_get(end - 1) == 32 {
                    end -= 1;
                }
                hard = text.byte_len() - end >= 2;
                pieces[tail.get()].value.set(Inline::Text(text.byte_slice(0, end)));
            }
            let _ = append_piece(
                context,
                pieces,
                tail,
                if hard {
                    Inline::HardBreak
                } else {
                    Inline::SoftBreak
                },
                line,
            )?;
            index += 1;
            while index < value.byte_len()
                && (value.byte_get(index) == 32 || value.byte_get(index) == 9) {
                index += 1;
            }
            continue;
        }
        if ch == '`' {
            let count = repeat_at(value, index, 96);
            let mut cursor = index + count;
            let mut found = false;
            while cursor < value.byte_len() {
                context.tick(line)?;
                if value.byte_get(cursor) == 96 {
                    let run = repeat_at(value, cursor, 96);
                    if run == count {
                        found = true;
                        break;
                    }
                    cursor += run;
                } else {
                    cursor += value.get(cursor).to_string().byte_len();
                }
            }
            if found {
                let text = value.byte_slice(index + count, cursor).replace("\n", " ");
                let content = if text.starts_with(" ") && text.ends_with(" ") && !blank(text) {
                    text.byte_slice(1, text.byte_len() - 1)
                } else {
                    text
                };
                let _ = append_piece(context, pieces, tail, Inline::Code(content), line)?;
                index = cursor + count;
            } else {
                let _ = append_piece(context, pieces, tail, Inline::Text("`".repeat(count)), line)?;
                index += count;
            }
            continue;
        }
        if ch == '&' {
            if let Some((text, end)) = entity(value, index) {
                let _ = append_piece(context, pieces, tail, Inline::Text(text), line)?;
                index = end;
                continue;
            }
        }
        if ch == '*' || ch == '_' {
            let marker = value.byte_get(index);
            let count = repeat_at(value, index, marker);
            let before = previous(value, index);
            let after = current(value, index + count);
            let left = !whitespace(after)
                && (!punctuation(after) || whitespace(before) || punctuation(before));
            let right = !whitespace(before)
                && (!punctuation(before) || whitespace(after) || punctuation(after));
            let opens = left && (ch == '*' || !right || punctuation(before));
            let closes = right && (ch == '*' || !left || punctuation(after));
            let node = append_piece(
                context,
                pieces,
                tail,
                Inline::Text(ch.to_string().repeat(count)),
                line,
            )?;
            delimiters.push(
                Delimiter {
                    node,
                    marker,
                    count: Ref::new(count),
                    original: count,
                    opens,
                    closes,
                    active: Ref::new(true),
                },
            );
            index += count;
            continue;
        }
        if ch == '[' || (ch == '!' && value.starts_with_at(index + 1, "[")) {
            let image = ch == '!';
            let node = append_piece(
                context,
                pieces,
                tail,
                Inline::Text(
                    if image {
                        "!["
                    } else {
                        "["
                    },
                ),
                line,
            )?;
            index += if image {
                2
            } else {
                1
            };
            brackets.push(
                Bracket {
                    node,
                    start: index,
                    bottom: delimiters.len(),
                    image,
                    active: Ref::new(true),
                },
            );
            continue;
        }
        if ch == ']' {
            if let Some(bracket) = brackets.pop() {
                if bracket.active.get() {
                    if value.starts_with_at(index + 1, "(") {
                        context.spend(value.byte_len() - index, line)?;
                    }
                    let mut matched = inline_destination(value, index + 1);
                    if matched.is_none() {
                        let label = value.byte_slice(bracket.start, index);
                        let explicit = label_at(value, index + 1);
                        let (label, end) = match explicit {
                            Some((reference, end)) => (
                                if reference == "" {
                                    label
                                } else {
                                    reference
                                },
                                end,
                            ),
                            None => (label, index + 1),
                        };
                        if label.byte_len() <= 3996 && label.char_count() <= 999 {
                            if let Some(reference) = context.references.get(normalize_label(label)) {
                                matched = Option::Some((reference, end));
                            }
                        }
                    }
                    if let Some((reference, end)) = matched {
                        emphasis(context, pieces, delimiters, tail, bracket.bottom, line)?;
                        let start = pieces[bracket.node].next.get();
                        let depth = nesting(context, pieces, start, -1, line)?;
                        let children = collect_pieces(pieces, start, -1);
                        pieces[bracket.node].value.set(
                            if bracket.image {
                                Inline::Image(reference.destination, reference.title, children)
                            } else {
                                Inline::Link(reference.destination, reference.title, children)
                            },
                        );
                        pieces[bracket.node].next.set(-1);
                        pieces[bracket.node].depth.set(depth);
                        tail.set(bracket.node);
                        for index in bracket.bottom..delimiters.len() {
                            delimiters[index].active.set(false);
                        }
                        if !bracket.image {
                            for outer in brackets {
                                if !outer.image {
                                    outer.active.set(false);
                                }
                            }
                        }
                        index = end;
                        continue;
                    }
                }
            }
        }
        if ch == '<' {
            context.spend(value.byte_len() - index, line)?;
            if let Some((reference, label, end)) = autolink(value, index) {
                let _ = append_piece(
                    context,
                    pieces,
                    tail,
                    Inline::Link(
                        reference.destination,
                        reference.title,
                        Vec::from_array([Inline::Text(label)]),
                    ),
                    line,
                )?;
                index = end;
                continue;
            }
            if let Some(end) = inline_html_end(value, index) {
                let _ = append_piece(
                    context,
                    pieces,
                    tail,
                    Inline::Html(value.byte_slice(index, end)),
                    line,
                )?;
                index = end;
                continue;
            }
        }
        let start = index;
        index += ch.to_string().byte_len();
        while index < value.byte_len() && !"\\\n`&*_[!]<>".contains(value.get(index).to_string()) {
            index += value.get(index).to_string().byte_len();
        }
        let _ = append_piece(
            context,
            pieces,
            tail,
            Inline::Text(value.byte_slice(start, index)),
            line,
        )?;
    }
    emphasis(context, pieces, delimiters, tail, 0, line)?;
    Result::Ok(collect_pieces(pieces, pieces[0].next.get(), -1))
}
