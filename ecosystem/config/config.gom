package config;

use std::json;
use std::serde;

pub struct Snapshot {
    root: Node,
    revision: u64,
}

impl Snapshot {
    pub fn revision(self: Snapshot) -> u64 {
        self.revision
    }

    pub fn get(self: Snapshot, path: string) -> Result[json::Value, Error] {
        lookup(self.root, pointer(path)?, 0, "").map(|value| node_json(value))
    }

    pub fn contains(self: Snapshot, path: string) -> Result[bool, Error] {
        match lookup(self.root, pointer(path)?, 0, "") {
            Ok(_) => Result::Ok(true),
            Err(error) if error.kind == ErrorKind::Missing => Result::Ok(false),
            Err(error) => Result::Err(error),
        }
    }

    pub fn origin(self: Snapshot, path: string) -> Result[Origin, Error] {
        lookup(self.root, pointer(path)?, 0, "").map(|value| value.origin)
    }

    pub fn origins(self: Snapshot) -> Vec[(string, Origin)] {
        let result = Vec::new();
        node_origins(self.root, "", result);
        result
    }

    pub fn json(self: Snapshot) -> string {
        json::encode(node_json(self.root))
    }

    pub fn decode[T: serde::Deserialize](self: Snapshot) -> Result[T, Error] {
        self.decode_at("")
    }

    pub fn decode_at[T: serde::Deserialize](self: Snapshot, path: string) -> Result[T, Error] {
        let node = lookup(self.root, pointer(path)?, 0, "")?;
        json::from_string(json::encode(node_json(node))).map_err(
            |message| Error::new(ErrorKind::Type, path, node.origin, message),
        )
    }

    pub fn invalid(self: Snapshot, path: string, message: string) -> Error {
        Error::new(
            ErrorKind::Validation,
            path,
            self.origin(path).unwrap_or(self.root.origin),
            message,
        )
    }
}

pub struct Builder {
    sources: Vec[Source],
    arrays: ArrayMerge,
    limits: Limits,
    validators: Vec[(Snapshot) -> Result[(), Error]],
}

impl Builder {
    pub fn new() -> Builder {
        Builder {
            sources: Vec::new(),
            arrays: ArrayMerge::Replace,
            limits: Limits::new(),
            validators: Vec::new(),
        }
    }

    pub fn with_source(self: Builder, source: Source) -> Builder {
        let sources = self.sources.as_slice().to_vec();
        sources.push(source);
        Builder { sources, ..self }
    }

    pub fn with_arrays(self: Builder, arrays: ArrayMerge) -> Builder {
        Builder { arrays, ..self }
    }

    pub fn with_limits(self: Builder, limits: Limits) -> Builder {
        Builder { limits, ..self }
    }

    pub fn validate_with(self: Builder, validator: (Snapshot) -> Result[(), Error]) -> Builder {
        let validators = self.validators.as_slice().to_vec();
        validators.push(validator);
        Builder { validators, ..self }
    }

    pub fn files(self: Builder) -> Vec[string] {
        let result = Vec::new();
        for source in self.sources {
            if let SourceKind::File(_, file, _) = source.kind {
                if !result.contains(file) {
                    result.push(file);
                }
            }
        }
        result
    }

    pub fn build(self: Builder) -> Result[Snapshot, Error] {
        self.limits.validate()?;
        if self.sources.len() > self.limits.max_sources {
            return Result::Err(
                failure(ErrorKind::Limit, "configuration source count limit exceeded"),
            )
        }
        let mut root = empty_node(anonymous());
        let bytes = Ref::new(0);
        let nodes = Ref::new(0);
        for source in self.sources {
            root = apply_source(root, source, self.limits, self.arrays, bytes, nodes)?;
            validate_tree(root, 0, self.limits, Ref::new(0))?;
        }
        let snapshot = Snapshot { root, revision: 0 };
        if snapshot.json().byte_len() > self.limits.max_total_bytes {
            return Result::Err(
                failure(ErrorKind::Limit, "merged configuration byte limit exceeded"),
            )
        }
        for validator in self.validators {
            validator(snapshot)?;
        }
        Result::Ok(snapshot)
    }
}
