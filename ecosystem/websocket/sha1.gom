package websocket;

use std::bytes;

fn rotate(value: u32, amount: isize) -> u32 {
    (value << amount) | (value >> (32 - amount))
}

fn sha1(input: bytes::Bytes) -> bytes::Bytes {
    let data = input.copy();
    let length = input.len().to_u64() * 8;
    data.push(128);
    while data.len() % 64 != 56 {
        data.push(0);
    }
    for index in 0..8 {
        data.push((length >> ((7 - index) * 8)).to_u8());
    }
    let state: Vec[u32] = Vec::from_array(
        [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0],
    );
    for chunk in 0..(data.len() / 64) {
        let words: Vec[u32] = Vec::new();
        for index in 0..16 {
            let at = chunk * 64 + index * 4;
            words.push(
                (data.get(at).to_u32() << 24) | (data.get(at + 1).to_u32() << 16)
                    | (data.get(at + 2).to_u32() << 8)
                    | data.get(at + 3).to_u32(),
            );
        }
        for index in 16..80 {
            words.push(
                rotate(
                    words[index - 3] ^ words[index - 8] ^ words[index - 14] ^ words[index - 16],
                    1,
                ),
            );
        }
        let mut a = state[0];
        let mut b = state[1];
        let mut c = state[2];
        let mut d = state[3];
        let mut e = state[4];
        for index in 0..80 {
            let (f, k): (u32, u32) = if index < 20 {
                ((b & c) | ((b ^ 0xffffffff) & d), 0x5a827999)
            } else if index < 40 {
                (b ^ c ^ d, 0x6ed9eba1)
            } else if index < 60 {
                ((b & c) | (b & d) | (c & d), 0x8f1bbcdc)
            } else {
                (b ^ c ^ d, 0xca62c1d6)
            };
            let next = (rotate(a, 5).to_u64() + f.to_u64() + e.to_u64() + k.to_u64()
                + words[index].to_u64()).to_u32();
            e = d;
            d = c;
            c = rotate(b, 30);
            b = a;
            a = next;
        }
        state[0] = (state[0].to_u64() + a.to_u64()).to_u32();
        state[1] = (state[1].to_u64() + b.to_u64()).to_u32();
        state[2] = (state[2].to_u64() + c.to_u64()).to_u32();
        state[3] = (state[3].to_u64() + d.to_u64()).to_u32();
        state[4] = (state[4].to_u64() + e.to_u64()).to_u32();
    }
    let output = bytes::Bytes::new();
    for word in state {
        for index in 0..4 {
            output.push((word >> ((3 - index) * 8)).to_u8());
        }
    }
    output
}
