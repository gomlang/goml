package tests;

use ecosystem::websocket as ws;
use std::bytes;
use std::context;
use std::io;
use std::io::{Read, Write, Close};
use std::net;
use std::task;
use std::testing;
use std::time;

struct Memory {
    input: bytes::Bytes,
    offset: Ref[isize],
    output: bytes::Bytes,
    read_size: isize,
    write_size: isize,
    closed: Ref[bool],
}

impl Read for Memory {
    fn read(self: Memory, buffer: MutSlice[u8]) -> Result[isize, io::Error] {
        let mut count = self.input.len() - self.offset.get();
        if count > self.read_size {
            count = self.read_size;
        }
        if count > buffer.len() {
            count = buffer.len();
        }
        for index in 0..count {
            buffer[index] = self.input.get(self.offset.get() + index);
        }
        self.offset.set(self.offset.get() + count);
        Result::Ok(count)
    }
}

impl Write for Memory {
    fn write(self: Memory, buffer: Slice[u8]) -> Result[isize, io::Error] {
        let count = if buffer.len() < self.write_size {
            buffer.len()
        } else {
            self.write_size
        };
        self.output.extend_from_slice(buffer.sub(0, count));
        Result::Ok(count)
    }
}

impl Close for Memory {
    fn close(self: Memory) -> Result[(), io::Error] {
        self.closed.set(true);
        Result::Ok(())
    }
}

fn memory(input: bytes::Bytes, read_size: isize, write_size: isize) -> Memory {
    Memory {
        input,
        offset: Ref::new(0),
        output: bytes::Bytes::new(),
        read_size,
        write_size,
        closed: Ref::new(false),
    }
}

fn receive_text(connection: ws::Connection, ctx: context::Context) -> string {
    match testing::expect_ok(connection.receive(ctx), "receive text") {
        Text(value) => value,
        _ => {
            testing::fail("expected text");
            ""
        },
    }
}

#[test]
fn generic_standard_io_handles_short_transfers_and_coalesced_handshake() -> () {
    for read_size in Vec::from_array([1, 3, 8192]) {
        let request = request();
        let parsed = testing::expect_ok(ws::ServerRequest::parse(request.encode(), 16384), "parse");
        let input = testing::expect_ok(parsed.response(Option::Some("chat")), "response");
        input.extend_from_slice(
            testing::expect_ok(
                ws::encode_frame(text_frame("already upgraded"), Option::None),
                "text",
            ).as_slice(),
        );
        let stream = memory(input, read_size, 2);
        let (connection, protocol) = testing::expect_ok(
            ws::client(
                ws::Transport::from_io(stream),
                request,
                ws::Limits::standard(),
                context::Context::background(),
            ),
            "short IO handshake",
        );
        equal(testing::expect_some(protocol, "selected"), "chat");
        equal(receive_text(connection, context::Context::background()), "already upgraded");
        testing::assert_ok(
            connection.send(ws::Message::Text("partial write"), context::Context::background()),
        );
        let parser = decoder(ws::Role::Server);
        testing::assert_ok(
            parser.push(stream.output.slice(request.encode().len(), stream.output.len())),
        );
        let frame = testing::expect_some(testing::expect_ok(parser.next(), "sent frame"), "frame");
        equal(frame.payload.to_vec(), "partial write".to_bytes());
        testing::assert_ok(connection.abort());
        testing::assert(stream.closed.get());
    }
}

#[test]
fn zero_write_invalid_counts_and_handshake_failures_close_transport() -> () {
    let ctx = context::Context::background();
    let stream = memory(bytes::Bytes::new(), 1, 0);
    testing::assert_err(
        ws::client(ws::Transport::from_io(stream), request(), ws::Limits::standard(), ctx),
    );
    testing::assert(stream.closed.get());
    let closed = Ref::new(false);
    let stream = ws::Transport::new(
        |buffer, _| Result::Ok(buffer.len() + 1),
        |buffer, _| Result::Ok(buffer.len()),
        || {
            closed.set(true);
            Result::Ok(())
        },
    );
    testing::assert_err(ws::client(stream, request(), ws::Limits::standard(), ctx));
    testing::assert(closed.get());
    let stream = memory(bytes::Bytes::from_string("HTTP/1.1 403 Forbidden\r\n\r\n"), 8192, 8192);
    testing::assert_err(
        ws::client(ws::Transport::from_io(stream), request(), ws::Limits::standard(), ctx),
    );
    testing::assert(stream.closed.get());
}

fn network(
    server: (ws::Connection, net::TcpStream, context::Context) -> (),
    client: (ws::Connection, context::Context) -> (),
) -> () {
    context::with_timeout(
        context::Context::background(),
        time::Duration::from_seconds(5),
        |ctx, _| {
            let listener = testing::expect_ok(
                net::TcpListener::bind(
                    testing::expect_ok(net::SocketAddr::parse("127.0.0.1:0"), "address"),
                ),
                "listener",
            );
            defer {
                let _ = listener.close();
            };
            let address = testing::expect_ok(listener.local_addr(), "local address");
            task::scope(
                |scope| {
                    let worker = scope.spawn(
                        |_| {
                            let stream = testing::expect_ok(
                                listener.accept_with(net::WaitOptions::new().with_context(ctx)),
                                "accept",
                            ).0;
                            let connection = testing::expect_ok(
                                ws::server(
                                    ws::Transport::tcp(stream),
                                    ws::Limits::standard(),
                                    ctx,
                                    |request| {
                                        equal(request.target, "/chat");
                                        Result::Ok(Option::Some("chat"))
                                    },
                                ),
                                "server handshake",
                            );
                            defer {
                                let _ = connection.abort();
                            };
                            server(connection, stream, ctx);
                        },
                    );
                    let stream = testing::expect_ok(
                        net::TcpStream::connect_with(
                            address,
                            net::WaitOptions::new().with_context(ctx),
                        ),
                        "connect",
                    );
                    let (connection, protocol) = testing::expect_ok(
                        ws::client(
                            ws::Transport::tcp(stream),
                            request(),
                            ws::Limits::standard(),
                            ctx,
                        ),
                        "client handshake",
                    );
                    defer {
                        let _ = connection.abort();
                    };
                    equal(testing::expect_some(protocol, "selected"), "chat");
                    client(connection, ctx);
                    worker.join();
                },
            );
        },
    );
}

#[test]
fn real_tcp_echo_ping_pong_and_clean_close() -> () {
    network(
        |connection, _, ctx| {
            equal(receive_text(connection, ctx), "你好 😀");
            testing::assert_ok(connection.send(ws::Message::Text("echo"), ctx));
            match testing::expect_ok(connection.receive(ctx), "ping") {
                Ping(_) => {},
                _ => testing::fail("ping"),
            }
            match testing::expect_ok(connection.receive(ctx), "close") {
                Close(Some(value)) => equal(value.code, 1000),
                _ => testing::fail("close"),
            }
            testing::assert(connection.is_closed());
        },
        |connection, ctx| {
            testing::assert_ok(connection.send(ws::Message::Text("你好 😀"), ctx));
            equal(receive_text(connection, ctx), "echo");
            testing::assert_ok(
                connection.send(ws::Message::Ping(bytes::Bytes::from_string("heartbeat")), ctx),
            );
            match testing::expect_ok(connection.receive(ctx), "pong") {
                Pong(value) => equal(value.to_vec(), "heartbeat".to_bytes()),
                _ => testing::fail("pong"),
            }
            testing::assert_ok(
                connection.close(Option::Some(ws::CloseFrame { code: 1000, reason: "bye" }), ctx),
            );
            match testing::expect_ok(connection.receive(ctx), "close echo") {
                Close(_) => {},
                _ => testing::fail("close echo"),
            }
            testing::assert(connection.is_closed());
        },
    );
}

#[test]
fn blocking_receive_does_not_prevent_concurrent_send() -> () {
    network(
        |connection, _, ctx| {
            equal(receive_text(connection, ctx), "unlock");
            testing::assert_ok(connection.send(ws::Message::Text("unlocked"), ctx));
        },
        |connection, ctx| {
            task::scope(
                |scope| {
                    let reader = scope.spawn(|_| receive_text(connection, ctx));
                    time::sleep(time::Duration::from_milliseconds(20));
                    testing::assert_ok(connection.send(ws::Message::Text("unlock"), ctx));
                    equal(reader.join(), "unlocked");
                },
            );
        },
    );
}

#[test]
fn read_deadline_retains_partial_frame_and_can_resume() -> () {
    let partial: Channel[()] = Channel::new(1);
    let resume: Channel[()] = Channel::new(1);
    network(
        |_, stream, ctx| {
            let wire = testing::expect_ok(
                ws::encode_frame(text_frame("resumed"), Option::None),
                "wire",
            );
            testing::assert_ok(
                stream.write_all_with(wire.slice(0, 4), net::WaitOptions::new().with_context(ctx)),
            );
            partial.send(());
            let _ = resume.recv();
            testing::assert_ok(
                stream.write_all_with(
                    wire.slice(4, wire.len()),
                    net::WaitOptions::new().with_context(ctx),
                ),
            );
        },
        |connection, ctx| {
            let _ = partial.recv();
            context::with_timeout(
                ctx,
                time::Duration::from_milliseconds(25),
                |limited, _| {
                    equal(
                        testing::expect_err(connection.receive(limited), "read deadline").kind,
                        ws::ErrorKind::Timeout,
                    );
                },
            );
            testing::assert(!connection.is_closed());
            resume.send(());
            equal(receive_text(connection, ctx), "resumed");
        },
    );
}

#[test]
fn cancellation_and_abort_wake_active_and_queued_readers() -> () {
    let release: Channel[()] = Channel::new(1);
    network(
        |_, _, _| {
            let _ = release.recv();
        },
        |connection, ctx| {
            context::with_cancel(
                ctx,
                |cancelled, cancel| {
                    task::scope(
                        |scope| {
                            let first = scope.spawn(|_| connection.receive(cancelled));
                            time::sleep(time::Duration::from_milliseconds(10));
                            cancel.cancel();
                            equal(
                                testing::expect_err(first.join(), "cancel receive").kind,
                                ws::ErrorKind::Cancelled,
                            );
                        },
                    );
                },
            );
            task::scope(
                |scope| {
                    let first = scope.spawn(|_| connection.receive(ctx));
                    let second = scope.spawn(|_| connection.receive(ctx));
                    time::sleep(time::Duration::from_milliseconds(10));
                    testing::assert_ok(connection.abort());
                    testing::assert_err(first.join());
                    testing::assert_err(second.join());
                },
            );
            release.send(());
        },
    );
}
