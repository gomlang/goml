package websocket;

use std::bytes;

#[derive(Debug, PartialEq)]
pub enum ErrorKind {
    Handshake,
    Protocol,
    Utf8,
    Limit,
    Backpressure,
    Closed,
    UnexpectedEof,
    Io,
    Cancelled,
    Timeout,
    InvalidInput,
}

pub struct Error {
    pub kind: ErrorKind,
    pub message: string,
}

impl Debug for Error {
    fn debug(self: Error) -> string {
        self.message
    }
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        self.message
    }
}

fn error(kind: ErrorKind, message: string) -> Error {
    Error { kind, message }
}

#[derive(Debug, PartialEq)]
pub enum Role {
    Client,
    Server,
}

#[derive(Debug, PartialEq)]
pub enum Opcode {
    Continuation,
    Text,
    Binary,
    Close,
    Ping,
    Pong,
}

pub struct Frame {
    pub final: bool,
    pub opcode: Opcode,
    pub payload: bytes::Bytes,
}

pub struct CloseFrame {
    pub code: u16,
    pub reason: string,
}

pub enum Message {
    Text(string),
    Binary(bytes::Bytes),
    Ping(bytes::Bytes),
    Pong(bytes::Bytes),
    Close(Option[CloseFrame]),
}

#[derive(Debug, PartialEq)]
pub enum State {
    Open,
    CloseSent,
    CloseReceived,
    Closed,
    Failed,
}

pub struct Limits {
    pub frame_bytes: isize,
    pub message_bytes: isize,
    pub buffered_bytes: isize,
    pub queued_bytes: isize,
    pub queued_frames: isize,
    pub handshake_bytes: isize,
}

impl Limits {
    pub fn standard() -> Limits {
        Limits {
            frame_bytes: 1048576,
            message_bytes: 8388608,
            buffered_bytes: 2097152,
            queued_bytes: 2097152,
            queued_frames: 256,
            handshake_bytes: 16384,
        }
    }

    pub fn validate(self: Limits) -> Result[(), Error] {
        if self.frame_bytes < 125 || self.frame_bytes > 1073741824
            || self.message_bytes < self.frame_bytes
            || self.buffered_bytes < self.frame_bytes + 14
            || self.queued_bytes < 139
            || self.queued_frames < 1
            || self.handshake_bytes < 256 {
            Result::Err(error(ErrorKind::InvalidInput, "invalid WebSocket limits"))
        } else {
            Result::Ok(())
        }
    }
}

fn opcode_byte(value: Opcode) -> u8 {
    match value {
        Continuation => 0,
        Text => 1,
        Binary => 2,
        Close => 8,
        Ping => 9,
        Pong => 10,
    }
}

fn opcode(value: u8) -> Result[Opcode, Error] {
    match value {
        0 => Result::Ok(Opcode::Continuation),
        1 => Result::Ok(Opcode::Text),
        2 => Result::Ok(Opcode::Binary),
        8 => Result::Ok(Opcode::Close),
        9 => Result::Ok(Opcode::Ping),
        10 => Result::Ok(Opcode::Pong),
        _ => Result::Err(error(ErrorKind::Protocol, "reserved opcode")),
    }
}

fn control(value: Opcode) -> bool {
    opcode_byte(value) >= 8
}
