package tracing;

use std::json;

#[derive(Debug, PartialEq)]
pub enum Level {
    Error,
    Warn,
    Info,
    Debug,
    Trace,
}

impl Level {
    pub fn rank(self: Level) -> isize {
        match self {
            Error => 1,
            Warn => 2,
            Info => 3,
            Debug => 4,
            Trace => 5,
        }
    }

    pub fn name(self: Level) -> string {
        match self {
            Error => "ERROR",
            Warn => "WARN",
            Info => "INFO",
            Debug => "DEBUG",
            Trace => "TRACE",
        }
    }
}

#[derive(Debug, PartialEq)]
pub enum ErrorKind {
    InvalidInput,
    Cancelled,
    DeadlineExceeded,
    Closed,
    Sink,
    Exhausted,
}

#[derive(Debug, PartialEq)]
pub struct Error {
    pub kind: ErrorKind,
    pub message: string,
}

impl Error {
    pub fn sink(message: string) -> Error {
        Error { kind: ErrorKind::Sink, message }
    }
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        self.message
    }
}

#[derive(Debug, PartialEq)]
pub enum Value {
    Text(string),
    Bool(bool),
    Int(i64),
    Uint(u64),
    Float(f64),
    Null,
}

impl Value {
    pub fn to_json(self: Value) -> json::Value {
        match self {
            Text(value) => json::Value::String(value),
            Bool(value) => json::Value::Bool(value),
            Int(value) => json::Value::Number(value.to_string()),
            Uint(value) => json::Value::Number(value.to_string()),
            Float(value) => {
                let encoded = value.to_string();
                if encoded == "NaN" || encoded == "+Inf" || encoded == "-Inf" {
                    json::Value::String(encoded)
                } else {
                    json::Value::Number(encoded)
                }
            },
            Null => json::Value::Null,
        }
    }
}

#[derive(Debug, PartialEq)]
pub struct Field {
    pub name: string,
    pub value: Value,
}

pub struct Fields {
    values: FrozenVec[Field],
}

impl Fields {
    pub fn new() -> Fields {
        Fields { values: Vec::new().freeze() }
    }

    pub fn from_vec(values: Vec[Field]) -> Fields {
        let mut result = Fields::new();
        for field in values {
            result = result.with(field.name, field.value);
        }
        result
    }

    pub fn with(self: Fields, name: string, value: Value) -> Fields {
        let values = self.values.to_vec();
        for index in 0..values.len() {
            if values[index].name == name {
                values[index] = Field { name, value };
                return Fields { values: values.freeze() }
            }
        }
        values.push(Field { name, value });
        Fields { values: values.freeze() }
    }

    pub fn merge(self: Fields, other: Fields) -> Fields {
        let mut result = self;
        for field in other.values.iter() {
            result = result.with(field.name, field.value);
        }
        result
    }

    pub fn get(self: Fields, name: string) -> Option[Value] {
        for field in self.values.iter() {
            if field.name == name {
                return Option::Some(field.value)
            }
        }
        Option::None
    }

    pub fn len(self: Fields) -> isize {
        self.values.len()
    }

    pub fn to_vec(self: Fields) -> Vec[Field] {
        self.values.to_vec()
    }

    pub fn to_json(self: Fields) -> json::Value {
        let output = Vec::new();
        for field in self.values.iter() {
            output.push((field.name, field.value.to_json()));
        }
        json::Value::Object(output)
    }
}

pub struct Metadata {
    pub level: Level,
    pub target: string,
    pub name: string,
}

impl Metadata {
    pub fn new(level: Level, target: string, name: string) -> Metadata {
        Metadata { level, target, name }
    }
}

#[derive(Debug, PartialEq)]
pub enum Kind {
    SpanStart,
    SpanUpdate,
    SpanEnd,
    Event,
}

impl Kind {
    pub fn name(self: Kind) -> string {
        match self {
            SpanStart => "span_start",
            SpanUpdate => "span_update",
            SpanEnd => "span_end",
            Event => "event",
        }
    }
}

pub struct Record {
    pub sequence: u64,
    pub timestamp_ns: i64,
    pub elapsed_ns: i64,
    pub trace_id: u64,
    pub span_id: u64,
    pub parent_id: u64,
    pub kind: Kind,
    pub metadata: Metadata,
    pub fields: Fields,
}

impl Record {
    pub fn to_json(self: Record) -> json::Value {
        json::Value::Object(
            Vec::from_array(
                [
                    ("sequence", json::Value::Number(self.sequence.to_string())),
                    ("timestamp_ns", json::Value::Number(self.timestamp_ns.to_string())),
                    ("elapsed_ns", json::Value::Number(self.elapsed_ns.to_string())),
                    ("trace_id", json::Value::Number(self.trace_id.to_string())),
                    ("span_id", json::Value::Number(self.span_id.to_string())),
                    ("parent_id", json::Value::Number(self.parent_id.to_string())),
                    ("kind", json::Value::String(self.kind.name())),
                    ("level", json::Value::String(self.metadata.level.name())),
                    ("target", json::Value::String(self.metadata.target)),
                    ("name", json::Value::String(self.metadata.name)),
                    ("fields", self.fields.to_json()),
                ],
            ),
        )
    }

    pub fn json_line(self: Record) -> string {
        json::encode(self.to_json()) + "\n"
    }

    pub fn text_line(self: Record) -> string {
        self.timestamp_ns.to_string() + " " + self.metadata.level.name() + " "
            + json::encode(json::Value::String(self.metadata.target))
            + " "
            + self.kind.name()
            + " trace="
            + self.trace_id.to_string()
            + " span="
            + self.span_id.to_string()
            + " parent="
            + self.parent_id.to_string()
            + " "
            + json::encode(json::Value::String(self.metadata.name))
            + " "
            + json::encode(self.fields.to_json())
            + "\n"
    }
}
