package tests;

use ecosystem::tracing;
use tracing::{Tracer, Sink, MemorySink, Options, Overflow, Sampling, Filter, Level, Metadata, Fields, Field, Value, Delivery, Kind, Error, ErrorKind};
use std::context;
use std::task;
use std::time;
use std::testing;
use std::json;
use std::io;
use std::bytes;
use std::resource;
use std::utf8;
use utf8::BytesUtf8;

fn background() -> context::Context {
    context::Context::background()
}

fn meta(name: string) -> Metadata {
    Metadata::new(Level::Info, "app", name)
}

fn empty() -> Fields {
    Fields::new()
}

fn event(tracer: Tracer, name: string) -> Delivery {
    testing::expect_ok(tracer.event(background(), Option::None, meta(name), empty()), "event")
}

fn make(scope: task::Scope, sink: Sink) -> Tracer {
    testing::expect_ok(Tracer::new(scope, sink, Options::standard()), "tracer")
}

fn signal[T](channel: Channel[T]) -> T {
    let timer = time::Timer::new(time::Duration::from_seconds(5));
    defer {
        let _ = timer.stop();
    };
    let value = select {
        recv(channel) as value => value,
        recv(timer.done()) as _ => Option::None,
    };
    testing::expect_some(value, "timed rendezvous")
}

#[test]
fn nested_spans_preserve_causality_fields_and_live_child_after_parent_close() -> () {
    let memory = MemorySink::new();
    task::scope(
        |scope| {
            let tracer = make(scope, memory.sink());
            let parent = testing::expect_ok(
                tracer.span(
                    background(),
                    Option::None,
                    meta("request"),
                    empty().with("url", Value::Text("/users")),
                ),
                "parent",
            );
            let child = testing::expect_ok(
                tracer.span(background(), Option::Some(parent.context()), meta("db"), empty()),
                "child",
            );
            testing::assert_ok(parent.close(background()));
            testing::assert_ok(
                child.event(background(), meta("row"), empty().with("count", Value::Int(3))),
            );
            testing::assert_ok(
                child.record(background(), empty().with("cached", Value::Bool(true))),
            );
            testing::assert_ok(child.close(background()));
            testing::assert_ok(child.close(background()));
            testing::assert_eq(
                testing::expect_ok(tracer.metrics(background()), "metrics").live_spans,
                0.to_u64(),
            );
            testing::assert_ok(tracer.close(background()));
        },
    );
    let records = memory.records();
    testing::assert_eq(records.len(), 6);
    testing::assert_eq(records[0].kind, Kind::SpanStart);
    testing::assert_eq(records[1].parent_id, records[0].span_id);
    testing::assert_eq(records[1].trace_id, records[0].trace_id);
    testing::assert_eq(records[2].kind, Kind::SpanEnd);
    testing::assert_eq(records[3].span_id, records[1].span_id);
    testing::assert_eq(records[5].fields.get("cached").unwrap_or(Value::Null), Value::Bool(true));
    testing::assert(records[5].elapsed_ns >= records[1].elapsed_ns);
    for index in 0..records.len() {
        testing::assert_eq(records[index].sequence, (index + 1).to_u64());
    }
}

#[test]
fn closed_parent_rejects_new_work_and_foreign_context_is_rejected() -> () {
    task::scope(
        |scope| {
            let first = make(scope, MemorySink::new().sink());
            let second = make(scope, MemorySink::new().sink());
            let parent = testing::expect_ok(
                first.span(background(), Option::None, meta("root"), empty()),
                "span",
            );
            let error = testing::expect_err(
                second.event(background(), Option::Some(parent.context()), meta("invalid"), empty()),
                "foreign context",
            );
            testing::assert_eq(error.kind, ErrorKind::InvalidInput);
            testing::assert_ok(parent.close(background()));
            let error = testing::expect_err(
                first.span(background(), Option::Some(parent.context()), meta("late"), empty()),
                "closed parent",
            );
            testing::assert_eq(error.kind, ErrorKind::Closed);
            testing::assert_err(parent.event(background(), meta("late event"), empty()));
            testing::assert_err(parent.record(background(), empty()));
            testing::assert_ok(first.close(background()));
            testing::assert_ok(second.close(background()));
        },
    );
}

#[test]
fn fields_and_record_snapshots_have_no_mutable_aliases() -> () {
    let inputs = Vec::from_array([Field { name: "answer", value: Value::Int(1) }]);
    let fields = Fields::from_vec(inputs);
    inputs[0] = Field { name: "answer", value: Value::Int(99) };
    let copies = fields.to_vec();
    copies[0] = Field { name: "answer", value: Value::Int(88) };
    testing::assert_eq(fields.get("answer").unwrap_or(Value::Null), Value::Int(1));
    let memory = MemorySink::new();
    task::scope(
        |scope| {
            let tracer = make(scope, memory.sink());
            let span = testing::expect_ok(
                tracer.span(background(), Option::None, meta("s"), fields),
                "span",
            );
            testing::assert_ok(span.record(background(), empty().with("answer", Value::Int(2))));
            testing::assert_ok(span.close(background()));
            testing::assert_ok(tracer.close(background()));
        },
    );
    let records = memory.records();
    testing::assert_eq(records[0].fields.get("answer").unwrap_or(Value::Null), Value::Int(1));
    testing::assert_eq(records[1].fields.get("answer").unwrap_or(Value::Null), Value::Int(2));
    let altered = records[0].fields.to_vec();
    altered[0] = Field { name: "answer", value: Value::Null };
    records.truncate(0);
    testing::assert_eq(memory.records().len(), 3);
    testing::assert_eq(
        memory.records()[0].fields.get("answer").unwrap_or(Value::Null),
        Value::Int(1),
    );
}

#[test]
fn target_filter_longest_namespace_and_last_equal_directive_win() -> () {
    let filter = Filter::new(Option::Some(Level::Warn)).with("app", Option::Some(Level::Debug)).with(
        "app::sql",
        Option::None,
    ).with("app::sql::slow", Option::Some(Level::Trace)).with("app", Option::Some(Level::Info));
    testing::assert(filter.enabled(Metadata::new(Level::Info, "app::http", "ok")));
    testing::assert(!filter.enabled(Metadata::new(Level::Debug, "app", "hidden")));
    testing::assert(!filter.enabled(Metadata::new(Level::Info, "apple", "boundary")));
    testing::assert(!filter.enabled(Metadata::new(Level::Error, "app::sql", "off")));
    testing::assert(filter.enabled(Metadata::new(Level::Trace, "app::sql::slow::query", "on")));
}

#[test]
fn reload_filter_changes_events_but_preserves_existing_span_end() -> () {
    let memory = MemorySink::new();
    task::scope(
        |scope| {
            let tracer = make(scope, memory.sink());
            let span = testing::expect_ok(
                tracer.span(background(), Option::None, meta("request"), empty()),
                "span",
            );
            testing::assert_ok(tracer.reload_filter(background(), Filter::new(Option::None)));
            testing::assert_eq(
                testing::expect_ok(
                    span.event(background(), meta("hidden"), empty()),
                    "hidden event",
                ),
                Delivery::Filtered,
            );
            testing::assert_ok(span.close(background()));
            testing::assert_eq(
                testing::expect_ok(tracer.metrics(background()), "metrics").filtered,
                1.to_u64(),
            );
            testing::assert_ok(tracer.close(background()));
        },
    );
    testing::assert_eq(memory.records().len(), 2);
    testing::assert_eq(memory.records()[1].kind, Kind::SpanEnd);
}

#[test]
fn filtered_spans_use_nearest_visible_ancestry_after_reload() -> () {
    let memory = MemorySink::new();
    task::scope(
        |scope| {
            let options = Options { filter: Filter::new(Option::None), ..Options::standard() };
            let tracer = testing::expect_ok(Tracer::new(scope, memory.sink(), options), "tracer");
            let root = testing::expect_ok(
                tracer.span(background(), Option::None, meta("hidden"), empty()),
                "root",
            );
            testing::assert(root.context().sampled());
            testing::assert_ok(
                tracer.reload_filter(background(), Filter::new(Option::Some(Level::Trace))),
            );
            let child = testing::expect_ok(
                tracer.span(background(), Option::Some(root.context()), meta("child"), empty()),
                "child",
            );
            testing::assert(child.context().sampled());
            testing::assert_eq(
                testing::expect_ok(child.event(background(), meta("hidden"), empty()), "event"),
                Delivery::Accepted,
            );
            testing::assert_ok(root.close(background()));
            testing::assert_ok(child.close(background()));
            testing::assert_ok(tracer.close(background()));
        },
    );
    testing::assert_eq(memory.records().len(), 3);
    testing::assert_eq(memory.records()[0].parent_id, 0.to_u64());
    testing::assert_eq(memory.records()[0].trace_id, 1.to_u64());
}

#[test]
fn deterministic_sampling_inherits_root_decision() -> () {
    let memory = MemorySink::new();
    task::scope(
        |scope| {
            let tracer = testing::expect_ok(
                Tracer::new(
                    scope,
                    memory.sink(),
                    Options { sampling: Sampling::Every(3), ..Options::standard() },
                ),
                "tracer",
            );
            for index in 0..8 {
                let root = testing::expect_ok(
                    tracer.span(background(), Option::None, meta("root"), empty()),
                    "root",
                );
                testing::assert_eq(root.context().sampled(), index % 3 == 0);
                let child = testing::expect_ok(
                    tracer.span(background(), Option::Some(root.context()), meta("child"), empty()),
                    "child",
                );
                testing::assert_eq(child.context().sampled(), root.context().sampled());
                testing::assert_ok(child.close(background()));
                testing::assert_ok(root.close(background()));
            }
            testing::assert_ok(tracer.close(background()));
        },
    );
    testing::assert_eq(memory.records().len(), 12);
}

#[test]
fn task_context_propagation_and_concurrent_close_emit_single_end() -> () {
    let memory = MemorySink::new();
    task::scope(
        |scope| {
            let tracer = make(scope, memory.sink());
            let root = testing::expect_ok(
                tracer.span(background(), Option::None, meta("root"), empty()),
                "root",
            );
            let tasks = Vec::new();
            for index in 0..12 {
                tasks.push(
                    scope.spawn(
                        |_| {
                            let child = testing::expect_ok(
                                tracer.span(
                                    background(),
                                    Option::Some(root.context()),
                                    meta("task"),
                                    empty().with("index", Value::Int(index.to_i64())),
                                ),
                                "child",
                            );
                            for item in 0..20 {
                                testing::assert_ok(
                                    child.event(
                                        background(),
                                        meta("work"),
                                        empty().with("item", Value::Int(item.to_i64())),
                                    ),
                                );
                            }
                            testing::assert_ok(child.close(background()));
                        },
                    ),
                );
            }
            for task in tasks {
                task.join();
            }
            let closers = Vec::new();
            for _ in 0..12 {
                closers.push(scope.spawn(|_| root.close(background())));
            }
            for closer in closers {
                testing::assert_ok(closer.join());
            }
            testing::assert_ok(tracer.close(background()));
        },
    );
    let records = memory.records();
    testing::assert_eq(records.len(), 266);
    for index in 0..records.len() {
        testing::assert_eq(records[index].trace_id, 1.to_u64());
        testing::assert_eq(records[index].sequence, (index + 1).to_u64());
    }
    testing::assert_eq(records[265].kind, Kind::SpanEnd);
    testing::assert_eq(records[265].span_id, 1.to_u64());
}

#[test]
fn json_and_text_escape_controls_and_preserve_number_types() -> () {
    let memory = MemorySink::new();
    task::scope(
        |scope| {
            let tracer = make(scope, memory.sink());
            let fields = empty().with("text", Value::Text("line\n\"引号\\")).with(
                "signed",
                Value::Int(-9223372036854775808),
            ).with("unsigned", Value::Uint(18446744073709551615)).with("float", Value::Float(1.25)).with(
                "bool",
                Value::Bool(true),
            ).with("nil", Value::Null).with(
                "nan",
                Value::Float(float64_from_bits(9221120237041090560)),
            );
            testing::assert_ok(tracer.event(background(), Option::None, meta("a\nb"), fields));
            testing::assert_ok(tracer.close(background()));
        },
    );
    let record = memory.records()[0];
    let parsed = testing::expect_ok(json::parse(record.json_line()), "valid JSON");
    let fields = testing::expect_some(json::field(parsed, "fields"), "fields");
    testing::assert_eq(
        json::as_string(testing::expect_some(json::field(fields, "text"), "text")).unwrap_or(""),
        "line\n\"引号\\",
    );
    testing::assert_eq(
        json::as_string(testing::expect_some(json::field(fields, "nan"), "nan")).unwrap_or(""),
        "NaN",
    );
    testing::assert(!record.text_line().contains("a\nb"));
    testing::assert(record.text_line().ends_with("\n"));
}

#[test]
fn writer_adapter_fanout_and_local_filter_compose() -> () {
    let buffer = bytes::Bytes::new();
    let cursor = io::Cursor::new(buffer);
    let memory = MemorySink::new();
    task::scope(
        |scope| {
            let sinks = Vec::from_array(
                [
                    Sink::writer(cursor, tracing::Format::Json),
                    memory.sink().filtered(Filter::new(Option::Some(Level::Error))),
                ],
            );
            let sink = Sink::fanout(sinks);
            sinks.truncate(0);
            let tracer = make(scope, sink);
            let _ = event(tracer, "info");
            testing::assert_ok(
                tracer.event(
                    background(),
                    Option::None,
                    Metadata::new(Level::Error, "app", "error"),
                    empty(),
                ),
            );
            testing::assert_ok(tracer.close(background()));
        },
    );
    testing::assert_eq(memory.records().len(), 1);
    let output = testing::expect_ok(cursor.bytes().to_string_utf8(), "output");
    testing::assert(output.contains("\"name\":\"info\""));
    testing::assert(output.contains("\"name\":\"error\""));
}

#[test]
fn scope_preserves_action_and_cleanup_errors() -> () {
    task::scope(
        |scope| {
            let tracer = make(scope, MemorySink::new().sink());
            let span = testing::expect_ok(
                tracer.span(background(), Option::None, meta("work"), empty()),
                "span",
            );
            let result: Result[(), resource::ScopeError[string, Error]] = span.in_scope(
                background(),
                |_| Result::Err("action failed"),
            );
            let problem = testing::expect_err(result, "action error");
            testing::assert_eq(problem.action.unwrap_or(""), "action failed");
            testing::assert(problem.cleanup.is_empty());
            testing::assert_eq(
                testing::expect_ok(tracer.metrics(background()), "metrics").live_spans,
                0.to_u64(),
            );
            let second = testing::expect_ok(
                tracer.span(background(), Option::None, meta("work"), empty()),
                "span",
            );
            testing::assert_ok(tracer.close(background()));
            let result: Result[(), resource::ScopeError[string, Error]] = second.in_scope(
                background(),
                |_| Result::Err("again"),
            );
            let problem = testing::expect_err(result, "both errors");
            testing::assert_eq(problem.action.unwrap_or(""), "again");
            testing::assert_eq(problem.cleanup[0].kind, ErrorKind::Closed);
        },
    );
}

#[test]
fn invalid_configuration_and_cancelled_worker_scope_are_recoverable() -> () {
    task::scope(
        |scope| {
            for capacity in Vec::from_array([-1, 0, 1048577]) {
                testing::assert_eq(
                    testing::expect_err(
                        Tracer::new(
                            scope,
                            MemorySink::new().sink(),
                            Options { capacity, ..Options::standard() },
                        ),
                        "capacity",
                    ).kind,
                    ErrorKind::InvalidInput,
                );
            }
            testing::assert_eq(
                testing::expect_err(
                    Tracer::new(
                        scope,
                        MemorySink::new().sink(),
                        Options { sampling: Sampling::Every(0), ..Options::standard() },
                    ),
                    "sampling",
                ).kind,
                ErrorKind::InvalidInput,
            );
            scope.cancel();
            testing::assert_eq(
                testing::expect_err(
                    Tracer::new(scope, MemorySink::new().sink(), Options::standard()),
                    "cancelled scope",
                ).kind,
                ErrorKind::Cancelled,
            );
        },
    );
}

#[test]
fn filtered_debug_parent_preserves_error_events_and_visible_ancestry() -> () {
    let memory = MemorySink::new();
    task::scope(
        |scope| {
            let tracer = make(scope, memory.sink());
            let root = testing::expect_ok(
                tracer.span(background(), Option::None, meta("root"), empty()),
                "root",
            );
            let hidden = testing::expect_ok(
                tracer.span(
                    background(),
                    Option::Some(root.context()),
                    Metadata::new(Level::Debug, "app", "hidden"),
                    empty(),
                ),
                "hidden",
            );
            testing::assert(hidden.context().sampled());
            testing::assert_eq(
                testing::expect_ok(
                    hidden.event(
                        background(),
                        Metadata::new(Level::Error, "app", "failure"),
                        empty(),
                    ),
                    "visible error",
                ),
                Delivery::Accepted,
            );
            let child = testing::expect_ok(
                tracer.span(background(), Option::Some(hidden.context()), meta("child"), empty()),
                "child",
            );
            testing::assert_ok(hidden.close(background()));
            testing::assert_ok(child.close(background()));
            testing::assert_ok(root.close(background()));
            testing::assert_ok(tracer.close(background()));
        },
    );
    let records = memory.records();
    testing::assert_eq(records.len(), 5);
    testing::assert_eq(records[1].metadata.name, "failure");
    testing::assert_eq(records[1].span_id, records[0].span_id);
    testing::assert_eq(records[2].parent_id, records[0].span_id);
}

#[test]
fn root_sampling_ordinals_are_independent_of_child_count_and_filtering() -> () {
    task::scope(
        |scope| {
            let tracer = testing::expect_ok(
                Tracer::new(
                    scope,
                    MemorySink::new().sink(),
                    Options { sampling: Sampling::Every(2), ..Options::standard() },
                ),
                "tracer",
            );
            for index in 0..12 {
                let metadata = if index % 3 == 0 {
                    Metadata::new(Level::Debug, "app", "filtered root")
                } else {
                    meta("root")
                };
                let root = testing::expect_ok(
                    tracer.span(background(), Option::None, metadata, empty()),
                    "root",
                );
                testing::assert_eq(root.context().sampled(), index % 2 == 0);
                for _ in 0..index {
                    let child = testing::expect_ok(
                        tracer.span(
                            background(),
                            Option::Some(root.context()),
                            meta("child"),
                            empty(),
                        ),
                        "child",
                    );
                    testing::assert_eq(child.context().sampled(), index % 2 == 0);
                    testing::assert_ok(child.event(background(), meta("work"), empty()));
                    testing::assert_ok(child.close(background()));
                }
                testing::assert_ok(root.close(background()));
            }
            testing::assert_ok(tracer.close(background()));
        },
    );
}

#[test]
fn sampling_none_suppresses_whole_trace_after_filter_reload() -> () {
    let memory = MemorySink::new();
    task::scope(
        |scope| {
            let tracer = testing::expect_ok(
                Tracer::new(
                    scope,
                    memory.sink(),
                    Options { sampling: Sampling::None, ..Options::standard() },
                ),
                "tracer",
            );
            let root = testing::expect_ok(
                tracer.span(background(), Option::None, meta("root"), empty()),
                "root",
            );
            testing::assert(!root.context().sampled());
            testing::assert_ok(
                tracer.reload_filter(background(), Filter::new(Option::Some(Level::Trace))),
            );
            let child = testing::expect_ok(
                tracer.span(background(), Option::Some(root.context()), meta("child"), empty()),
                "child",
            );
            testing::assert_eq(
                testing::expect_ok(
                    child.event(background(), Metadata::new(Level::Error, "app", "hidden"), empty()),
                    "event",
                ),
                Delivery::Filtered,
            );
            testing::assert_ok(child.close(background()));
            testing::assert_ok(root.close(background()));
            testing::assert_eq(event(tracer, "standalone"), Delivery::Filtered);
            testing::assert_ok(tracer.close(background()));
        },
    );
    testing::assert(memory.records().is_empty());
}
