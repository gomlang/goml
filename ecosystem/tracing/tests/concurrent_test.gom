package tests;

use ecosystem::tracing;
use tracing::{Tracer, Sink, MemorySink, Options, Overflow, Delivery, Error, ErrorKind, Kind};
use std::context;
use std::task;
use std::time;
use std::testing;
use std::resource;

#[test]
fn saturated_drop_queue_counts_only_rejected_events() -> () {
    let entered: Channel[()] = Channel::new(1);
    let release: Channel[()] = Channel::new(1);
    let memory = MemorySink::new();
    let first = Ref::new(true);
    let slow = Sink::from_callback(
        |_| {
            if first.get() {
                first.set(false);
                entered.send(());
                let _ = release.recv();
            }
            Result::Ok(())
        },
    );
    task::scope(
        |scope| {
            let tracer = testing::expect_ok(
                Tracer::new(
                    scope,
                    Sink::fanout(Vec::from_array([slow, memory.sink()])),
                    Options { capacity: 1, overflow: Overflow::DropNewest, ..Options::standard() },
                ),
                "tracer",
            );
            testing::assert_eq(event(tracer, "first"), Delivery::Accepted);
            signal(entered);
            testing::assert_eq(event(tracer, "second"), Delivery::Accepted);
            for _ in 0..100 {
                testing::assert_eq(event(tracer, "dropped"), Delivery::Dropped);
            }
            let metrics = testing::expect_ok(tracer.metrics(background()), "metrics");
            testing::assert_eq(metrics.accepted, 2.to_u64());
            testing::assert_eq(metrics.dropped, 100.to_u64());
            release.send(());
            testing::assert_ok(tracer.close(background()));
        },
    );
    testing::assert_eq(memory.records().len(), 2);
    testing::assert_eq(memory.records()[1].metadata.name, "second");
}

#[test]
fn saturated_block_queue_times_out_without_publishing_cancelled_record() -> () {
    let entered: Channel[()] = Channel::new(1);
    let release: Channel[()] = Channel::new(1);
    let first = Ref::new(true);
    let memory = MemorySink::new();
    let slow = Sink::from_callback(
        |_| {
            if first.get() {
                first.set(false);
                entered.send(());
                let _ = release.recv();
            }
            Result::Ok(())
        },
    );
    task::scope(
        |scope| {
            let tracer = testing::expect_ok(
                Tracer::new(
                    scope,
                    Sink::fanout(Vec::from_array([slow, memory.sink()])),
                    Options { capacity: 1, ..Options::standard() },
                ),
                "tracer",
            );
            let _ = event(tracer, "first");
            signal(entered);
            let _ = event(tracer, "second");
            context::with_timeout(
                background(),
                time::Duration::from_milliseconds(15),
                |ctx, _| {
                    let problem = testing::expect_err(
                        tracer.event(ctx, Option::None, meta("timed out"), empty()),
                        "queue timeout",
                    );
                    testing::assert_eq(problem.kind, ErrorKind::DeadlineExceeded);
                },
            );
            release.send(());
            testing::assert_eq(event(tracer, "after"), Delivery::Accepted);
            testing::assert_ok(tracer.close(background()));
        },
    );
    testing::assert_eq(memory.records().len(), 3);
    testing::assert_eq(memory.records()[2].sequence, 3.to_u64());
}

#[test]
fn flush_timeout_leaves_barrier_queued_and_later_close_drains() -> () {
    let entered: Channel[()] = Channel::new(1);
    let release: Channel[()] = Channel::new(1);
    let calls = Ref::new(0);
    let finishes = Ref::new(0);
    let sink = Sink::new(
        |_| {
            entered.send(());
            let _ = release.recv();
            Result::Ok(())
        },
        || {
            calls.set(calls.get() + 1);
            Result::Ok(())
        },
        || {
            finishes.set(finishes.get() + 1);
            Result::Ok(())
        },
    );
    task::scope(
        |scope| {
            let tracer = make(scope, sink);
            let _ = event(tracer, "slow");
            signal(entered);
            context::with_timeout(
                background(),
                time::Duration::from_milliseconds(15),
                |ctx, _| {
                    testing::assert_eq(
                        testing::expect_err(tracer.flush(ctx), "flush timeout").kind,
                        ErrorKind::DeadlineExceeded,
                    );
                },
            );
            release.send(());
            testing::assert_ok(tracer.close(background()));
            testing::assert_ok(tracer.flush(background()));
            testing::assert_ok(tracer.close(background()));
        },
    );
    testing::assert_eq(calls.get(), 2);
    testing::assert_eq(finishes.get(), 1);
}

#[test]
fn accepted_close_survives_caller_timeout_and_rejects_new_events() -> () {
    let entered: Channel[()] = Channel::new(1);
    let release: Channel[()] = Channel::new(1);
    let memory = MemorySink::new();
    let sink = Sink::fanout(
        Vec::from_array(
            [
                Sink::from_callback(
                    |_| {
                        entered.send(());
                        let _ = release.recv();
                        Result::Ok(())
                    },
                ),
                memory.sink(),
            ],
        ),
    );
    task::scope(
        |scope| {
            let tracer = make(scope, sink);
            let _ = event(tracer, "slow");
            signal(entered);
            context::with_timeout(
                background(),
                time::Duration::from_milliseconds(15),
                |ctx, _| {
                    testing::assert_eq(
                        testing::expect_err(tracer.close(ctx), "close timeout").kind,
                        ErrorKind::DeadlineExceeded,
                    );
                },
            );
            testing::assert_eq(
                testing::expect_err(
                    tracer.event(background(), Option::None, meta("late"), empty()),
                    "closed",
                ).kind,
                ErrorKind::Closed,
            );
            release.send(());
            testing::assert_ok(tracer.close(background()));
        },
    );
    testing::assert_eq(memory.records().len(), 1);
}

#[test]
fn close_not_yet_enqueued_can_be_cancelled_and_retried() -> () {
    let entered: Channel[()] = Channel::new(1);
    let release: Channel[()] = Channel::new(1);
    let first = Ref::new(true);
    let sink = Sink::from_callback(
        |_| {
            if first.get() {
                first.set(false);
                entered.send(());
                let _ = release.recv();
            }
            Result::Ok(())
        },
    );
    task::scope(
        |scope| {
            let tracer = testing::expect_ok(
                Tracer::new(scope, sink, Options { capacity: 1, ..Options::standard() }),
                "tracer",
            );
            let _ = event(tracer, "slow");
            signal(entered);
            let _ = event(tracer, "queued");
            context::with_timeout(
                background(),
                time::Duration::from_milliseconds(15),
                |ctx, _| {
                    testing::assert_eq(
                        testing::expect_err(tracer.close(ctx), "timeout").kind,
                        ErrorKind::DeadlineExceeded,
                    );
                },
            );
            testing::assert(!testing::expect_ok(tracer.metrics(background()), "metrics").closing);
            release.send(());
            let _ = event(tracer, "still open");
            testing::assert_ok(tracer.close(background()));
        },
    );
}

#[test]
fn simultaneous_flush_and_close_finish_sink_exactly_once() -> () {
    let finish_count = Ref::new(0);
    let memory = MemorySink::new();
    let sink = Sink::fanout(
        Vec::from_array(
            [
                memory.sink(),
                Sink::new(
                    |_| Result::Ok(()),
                    || Result::Ok(()),
                    || {
                        finish_count.set(finish_count.get() + 1);
                        Result::Ok(())
                    },
                ),
            ],
        ),
    );
    task::scope(
        |scope| {
            let tracer = make(scope, sink);
            for _ in 0..30 {
                let _ = event(tracer, "event");
            }
            let tasks = Vec::new();
            for index in 0..30 {
                tasks.push(
                    scope.spawn(
                        |_| if index % 2 == 0 {
                            tracer.close(background())
                        } else {
                            tracer.flush(background())
                        },
                    ),
                );
            }
            for task in tasks {
                testing::assert_ok(task.join());
            }
        },
    );
    testing::assert_eq(finish_count.get(), 1);
    testing::assert_eq(memory.records().len(), 30);
}

#[test]
fn first_sink_failure_is_latched_and_fanout_still_visits_other_subscribers() -> () {
    let memory = MemorySink::new();
    let finishes = Ref::new(0);
    let sink = Sink::fanout(
        Vec::from_array(
            [
                Sink::new(
                    |_| Result::Err(Error::sink("write failed")),
                    || Result::Err(Error::sink("flush failed")),
                    || {
                        finishes.set(finishes.get() + 1);
                        Result::Err(Error::sink("finish failed"))
                    },
                ),
                memory.sink(),
            ],
        ),
    );
    task::scope(
        |scope| {
            let tracer = make(scope, sink);
            let _ = event(tracer, "first");
            testing::assert_eq(
                testing::expect_err(tracer.flush(background()), "latched write failure").message,
                "write failed",
            );
            testing::assert_eq(
                testing::expect_err(
                    tracer.event(background(), Option::None, meta("late"), empty()),
                    "latched error",
                ).message,
                "write failed",
            );
            testing::assert_eq(
                testing::expect_err(tracer.close(background()), "close error").message,
                "write failed",
            );
            testing::assert_eq(
                testing::expect_err(tracer.close(background()), "idempotent error").message,
                "write failed",
            );
        },
    );
    testing::assert_eq(finishes.get(), 1);
    testing::assert_eq(memory.records().len(), 1);
}

#[test]
fn cancellation_before_admission_changes_no_metrics_or_lifecycle() -> () {
    task::scope(
        |scope| {
            let tracer = make(scope, MemorySink::new().sink());
            context::with_cancel(
                background(),
                |ctx, cancel| {
                    cancel.cancel();
                    testing::assert_eq(
                        testing::expect_err(
                            tracer.event(ctx, Option::None, meta("cancelled"), empty()),
                            "cancelled event",
                        ).kind,
                        ErrorKind::Cancelled,
                    );
                    testing::assert_err(tracer.span(ctx, Option::None, meta("cancelled"), empty()));
                    testing::assert_err(tracer.flush(ctx));
                    testing::assert_err(tracer.close(ctx));
                },
            );
            let metrics = testing::expect_ok(tracer.metrics(background()), "metrics");
            testing::assert_eq(metrics.accepted, 0.to_u64());
            testing::assert_eq(metrics.live_spans, 0.to_u64());
            testing::assert_ok(tracer.close(background()));
        },
    );
}

#[test]
fn cancelled_worker_scope_propagates_failure_and_runs_finish() -> () {
    let finishes: Channel[()] = Channel::new(1);
    task::scope(
        |scope| {
            let tracer = make(
                scope,
                Sink::new(
                    |_| Result::Ok(()),
                    || Result::Ok(()),
                    || {
                        finishes.send(());
                        Result::Ok(())
                    },
                ),
            );
            scope.cancel();
            signal(finishes);
            let error = testing::expect_err(tracer.close(background()), "worker cancelled");
            testing::assert_eq(error.kind, ErrorKind::Cancelled);
            testing::assert_eq(
                testing::expect_some(tracer.error(), "latched cancellation").kind,
                ErrorKind::Cancelled,
            );
        },
    );
}

#[test]
fn reliable_span_end_waits_for_capacity_in_drop_mode() -> () {
    let entered: Channel[()] = Channel::new(1);
    let release: Channel[()] = Channel::new(1);
    let first = Ref::new(true);
    let memory = MemorySink::new();
    let sink = Sink::fanout(
        Vec::from_array(
            [
                Sink::from_callback(
                    |_| {
                        if first.get() {
                            first.set(false);
                            entered.send(());
                            let _ = release.recv();
                        }
                        Result::Ok(())
                    },
                ),
                memory.sink(),
            ],
        ),
    );
    task::scope(
        |scope| {
            let tracer = testing::expect_ok(
                Tracer::new(
                    scope,
                    sink,
                    Options { capacity: 1, overflow: Overflow::DropNewest, ..Options::standard() },
                ),
                "tracer",
            );
            let span = testing::expect_ok(
                tracer.span(background(), Option::None, meta("root"), empty()),
                "span",
            );
            signal(entered);
            testing::assert_ok(span.event(background(), meta("queued"), empty()));
            context::with_timeout(
                background(),
                time::Duration::from_milliseconds(15),
                |ctx, _| {
                    testing::assert_err(span.close(ctx));
                },
            );
            testing::assert_eq(
                testing::expect_ok(tracer.metrics(background()), "metrics").live_spans,
                1.to_u64(),
            );
            release.send(());
            testing::assert_ok(span.close(background()));
            testing::assert_ok(tracer.close(background()));
        },
    );
    testing::assert_eq(memory.records().len(), 3);
    testing::assert_eq(memory.records()[2].kind, Kind::SpanEnd);
}

#[test]
fn tracer_scope_preserves_action_error_and_flush_failure() -> () {
    task::scope(
        |scope| {
            let tracer = make(
                scope,
                Sink::new(
                    |_| Result::Ok(()),
                    || Result::Err(Error::sink("flush failed")),
                    || Result::Ok(()),
                ),
            );
            let result: Result[(), resource::ScopeError[string, Error]] = tracer.in_scope(
                background(),
                |_| Result::Err("application failed"),
            );
            let error = testing::expect_err(result, "both failures");
            testing::assert_eq(error.action.unwrap_or(""), "application failed");
            testing::assert_eq(error.cleanup.len(), 1);
            testing::assert_eq(error.cleanup[0].message, "flush failed");
            testing::assert_eq(
                testing::expect_err(tracer.close(background()), "finished").message,
                "flush failed",
            );
        },
    );
}
