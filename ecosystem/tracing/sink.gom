package tracing;

use std::bytes;
use std::io;
use io::Write;

pub struct Sink {
    write: (Record) -> Result[(), Error],
    flush: () -> Result[(), Error],
    finish: () -> Result[(), Error],
}

impl Sink {
    pub fn new(
        write: (Record) -> Result[(), Error],
        flush: () -> Result[(), Error],
        finish: () -> Result[(), Error],
    ) -> Sink {
        Sink { write, flush, finish }
    }

    pub fn from_callback(write: (Record) -> Result[(), Error]) -> Sink {
        Sink::new(write, || Result::Ok(()), || Result::Ok(()))
    }

    pub fn fanout(sinks: Vec[Sink]) -> Sink {
        let sinks = sinks.freeze();
        Sink::new(
            |record| {
                let mut error = Option::None;
                for sink in sinks.iter() {
                    if let Err(problem) = (sink.write)(record) {
                        if error.is_none() {
                            error = Option::Some(problem);
                        }
                    }
                }
                match error {
                    Some(error) => Result::Err(error),
                    None => Result::Ok(()),
                }
            },
            || {
                let mut error = Option::None;
                for sink in sinks.iter() {
                    if let Err(problem) = (sink.flush)() {
                        if error.is_none() {
                            error = Option::Some(problem);
                        }
                    }
                }
                match error {
                    Some(error) => Result::Err(error),
                    None => Result::Ok(()),
                }
            },
            || {
                let mut error = Option::None;
                for sink in sinks.iter() {
                    if let Err(problem) = (sink.finish)() {
                        if error.is_none() {
                            error = Option::Some(problem);
                        }
                    }
                }
                match error {
                    Some(error) => Result::Err(error),
                    None => Result::Ok(()),
                }
            },
        )
    }

    pub fn filtered(self: Sink, filter: Filter) -> Sink {
        Sink::new(
            |record| if filter.enabled(record.metadata) {
                (self.write)(record)
            } else {
                Result::Ok(())
            },
            self.flush,
            self.finish,
        )
    }

    pub fn writer[W: Write](writer: W, format: Format) -> Sink {
        Sink::new(
            |record| {
                let line = match format {
                    Json => record.json_line(),
                    Text => record.text_line(),
                };
                writer.write_all(bytes::Bytes::from_string(line).as_slice()).map_err(
                    |error| Error::sink(error.to_string()),
                )
            },
            || writer.flush().map_err(|error| Error::sink(error.to_string())),
            || Result::Ok(()),
        )
    }
}

#[derive(Debug, PartialEq)]
pub enum Format {
    Json,
    Text,
}

pub struct MemorySink {
    state: Channel[Vec[Record]],
}

impl MemorySink {
    pub fn new() -> MemorySink {
        let state = Channel::new(1);
        state.send(Vec::new());
        MemorySink { state }
    }

    pub fn records(self: MemorySink) -> Vec[Record] {
        let values = self.state.recv().unwrap_or(Vec::new());
        let copy = values.copy();
        self.state.send(values);
        copy
    }

    pub fn sink(self: MemorySink) -> Sink {
        Sink::from_callback(
            |record| {
                let values = self.state.recv().unwrap_or(Vec::new());
                values.push(record);
                self.state.send(values);
                Result::Ok(())
            },
        )
    }
}
