package tracing;

pub struct Directive {
    pub target: string,
    pub maximum: Option[Level],
}

pub struct Filter {
    default: Option[Level],
    directives: FrozenVec[Directive],
}

impl Filter {
    pub fn new(maximum: Option[Level]) -> Filter {
        Filter { default: maximum, directives: Vec::new().freeze() }
    }

    pub fn with(self: Filter, target: string, maximum: Option[Level]) -> Filter {
        let directives = self.directives.to_vec();
        directives.push(Directive { target, maximum });
        Filter { directives: directives.freeze(), ..self }
    }

    pub fn enabled(self: Filter, metadata: Metadata) -> bool {
        let mut maximum = self.default;
        let mut longest = -1;
        for directive in self.directives.iter() {
            let matches = metadata.target == directive.target
                || metadata.target.starts_with(directive.target + "::");
            if matches && directive.target.byte_len() >= longest {
                longest = directive.target.byte_len();
                maximum = directive.maximum;
            }
        }
        maximum.map(|level| metadata.level.rank() <= level.rank()).unwrap_or(false)
    }
}

#[derive(Debug, PartialEq)]
pub enum Sampling {
    All,
    None,
    Every(u64),
}

impl Sampling {
    fn accepts(self: Sampling, root: u64) -> bool {
        match self {
            All => true,
            None => false,
            Every(period) => (root - 1) % period == 0,
        }
    }
}

#[derive(Debug, PartialEq)]
pub enum Overflow {
    Block,
    DropNewest,
}

pub struct Options {
    pub capacity: isize,
    pub overflow: Overflow,
    pub filter: Filter,
    pub sampling: Sampling,
}

impl Options {
    pub fn standard() -> Options {
        Options {
            capacity: 256,
            overflow: Overflow::Block,
            filter: Filter::new(Option::Some(Level::Info)),
            sampling: Sampling::All,
        }
    }
}

#[derive(Debug, PartialEq)]
pub enum Delivery {
    Accepted,
    Filtered,
    Dropped,
}

#[derive(Debug, PartialEq)]
pub struct Metrics {
    pub accepted: u64,
    pub dropped: u64,
    pub filtered: u64,
    pub live_spans: u64,
    pub closing: bool,
}
