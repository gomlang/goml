package tempfile;

use std::io;
use std::os::linux::fd;

pub enum SeekFrom {
    Start(i64),
    Current(i64),
    End(i64),
}

pub struct File {
    descriptor: fd::Fd,
}

struct ManagedState {
    active: bool,
}

struct Managed {
    descriptor: fd::Fd,
    parent: fd::Fd,
    name: string,
    path_value: string,
    directory: bool,
    state: Channel[ManagedState],
}

pub struct NamedTempFile {
    owned: Managed,
}

pub struct TempDir {
    owned: Managed,
}

pub struct KeptFile {
    pub file: File,
    pub path: string,
}

pub struct ScopeError {
    pub action: Option[io::Error],
    pub cleanup: Option[io::Error],
}

impl ToString for ScopeError {
    fn to_string(self: ScopeError) -> string {
        let action = self.action.map(|error| error.to_string()).unwrap_or("");
        let cleanup = self.cleanup.map(|error| error.to_string()).unwrap_or("");
        if action == "" {
            cleanup
        } else if cleanup == "" {
            action
        } else {
            action + "; cleanup failed: " + cleanup
        }
    }
}

impl Debug for ScopeError {
    fn debug(self: ScopeError) -> string {
        self.to_string()
    }
}

fn failure(kind: io::ErrorKind, operation: string, message: string) -> io::Error {
    io::Error::new(kind, operation, Option::None, Option::None, message)
}

fn inactive() -> io::Error {
    failure(io::ErrorKind::InvalidInput, "temporary resource", "resource is closed or transferred")
}

fn managed(descriptor: fd::Fd, parent: fd::Fd, name: string, path_value: string, directory: bool) -> Managed {
    let state = Channel::new(1);
    state.send(ManagedState { active: true });
    Managed { descriptor, parent, name, path_value, directory, state }
}

impl Managed {
    fn locked[T](self: Managed, action: (Ref[ManagedState]) -> Result[T, io::Error]) -> Result[
        T,
        io::Error,
    ] {
        let state = Ref::new(self.state.recv().ok_or(inactive())?);
        defer {
            self.state.send(state.get());
        };
        action(state)
    }

    fn access[T](self: Managed, action: (fd::Fd) -> Result[T, io::Error]) -> Result[T, io::Error] {
        self.locked(
            |state| {
                if !state.get().active {
                    return Result::Err(inactive())
                }
                action(self.descriptor)
            },
        )
    }

    fn is_closed(self: Managed) -> bool {
        self.locked(|state| Result::Ok(!state.get().active)).unwrap_or(true)
    }
}

fn seek_descriptor(descriptor: fd::Fd, position: SeekFrom) -> Result[u64, io::Error] {
    match position {
        Start(offset) => if offset < 0 {
            Result::Err(failure(io::ErrorKind::InvalidInput, "seek", "negative start offset"))
        } else {
            descriptor.seek(offset, fd::SEEK_SET)
        },
        Current(offset) => descriptor.seek(offset, fd::SEEK_CUR),
        End(offset) => descriptor.seek(offset, fd::SEEK_END),
    }
}
