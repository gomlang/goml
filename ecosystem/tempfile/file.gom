package tempfile;

use std::io;
use std::os::linux::fd;

impl File {
    pub fn close(self: File) -> Result[(), io::Error] {
        self.descriptor.close()
    }

    pub fn is_closed(self: File) -> bool {
        self.descriptor.is_closed()
    }

    pub fn seek(self: File, position: SeekFrom) -> Result[u64, io::Error] {
        seek_descriptor(self.descriptor, position)
    }

    pub fn rewind(self: File) -> Result[(), io::Error] {
        self.seek(SeekFrom::Start(0)).map(|_| ())
    }

    pub fn len(self: File) -> Result[i64, io::Error] {
        self.descriptor.stat().map(|value| value.size)
    }

    pub fn set_len(self: File, length: i64) -> Result[(), io::Error] {
        if length < 0 {
            return Result::Err(
                failure(io::ErrorKind::InvalidInput, "set file length", "negative length"),
            )
        }
        self.descriptor.truncate(length)
    }

    pub fn sync_all(self: File) -> Result[(), io::Error] {
        self.descriptor.sync()
    }

    pub fn sync_data(self: File) -> Result[(), io::Error] {
        self.descriptor.sync_data()
    }

    pub fn duplicate(self: File) -> Result[File, io::Error] {
        self.descriptor.duplicate().map(|descriptor| File { descriptor })
    }
}

impl io::Read for File {
    fn read(self: File, buffer: MutSlice[byte]) -> Result[isize, io::Error] {
        self.descriptor.read(buffer)
    }
}

impl io::Write for File {
    fn write(self: File, buffer: Slice[byte]) -> Result[isize, io::Error] {
        self.descriptor.write(buffer)
    }

    fn flush(self: File) -> Result[(), io::Error] {
        if self.is_closed() {
            Result::Err(inactive())
        } else {
            Result::Ok(())
        }
    }
}

impl io::Close for File {
    fn close(self: File) -> Result[(), io::Error] {
        self.close()
    }
}

impl NamedTempFile {
    pub fn new() -> Result[NamedTempFile, io::Error] {
        Builder::new().tempfile()
    }

    pub fn new_in(parent: string) -> Result[NamedTempFile, io::Error] {
        Builder::new().parent(parent).tempfile()
    }

    pub fn path(self: NamedTempFile) -> string {
        self.owned.path_value
    }

    pub fn is_closed(self: NamedTempFile) -> bool {
        self.owned.is_closed()
    }

    pub fn close(self: NamedTempFile) -> Result[(), io::Error] {
        self.owned.close()
    }

    pub fn seek(self: NamedTempFile, position: SeekFrom) -> Result[u64, io::Error] {
        self.owned.access(|descriptor| seek_descriptor(descriptor, position))
    }

    pub fn rewind(self: NamedTempFile) -> Result[(), io::Error] {
        self.seek(SeekFrom::Start(0)).map(|_| ())
    }

    pub fn len(self: NamedTempFile) -> Result[i64, io::Error] {
        self.owned.access(|descriptor| descriptor.stat().map(|value| value.size))
    }

    pub fn set_len(self: NamedTempFile, length: i64) -> Result[(), io::Error] {
        self.owned.access(|descriptor| File { descriptor }.set_len(length))
    }

    pub fn sync_all(self: NamedTempFile) -> Result[(), io::Error] {
        self.owned.access(|descriptor| descriptor.sync())
    }

    pub fn sync_data(self: NamedTempFile) -> Result[(), io::Error] {
        self.owned.access(|descriptor| descriptor.sync_data())
    }

    pub fn duplicate(self: NamedTempFile) -> Result[File, io::Error] {
        self.owned.access(|descriptor| descriptor.duplicate().map(|descriptor| File { descriptor }))
    }

    pub fn into_file(self: NamedTempFile) -> Result[File, io::Error] {
        self.owned.transfer(Option::None, false, true)?;
        Result::Ok(File { descriptor: self.owned.descriptor })
    }

    pub fn keep(self: NamedTempFile) -> Result[KeptFile, io::Error] {
        self.owned.transfer(Option::None, false, false)?;
        Result::Ok(KeptFile { file: File { descriptor: self.owned.descriptor }, path: self.path() })
    }

    pub fn persist(self: NamedTempFile, destination: string) -> Result[File, io::Error] {
        self.owned.transfer(Option::Some(destination), false, false)?;
        Result::Ok(File { descriptor: self.owned.descriptor })
    }

    pub fn persist_overwrite(self: NamedTempFile, destination: string) -> Result[File, io::Error] {
        self.owned.transfer(Option::Some(destination), true, false)?;
        Result::Ok(File { descriptor: self.owned.descriptor })
    }

    pub fn reopen(self: NamedTempFile) -> Result[File, io::Error] {
        self.owned.access(
            |descriptor| {
                if !same_entry(self.owned)? {
                    return Result::Err(
                        failure(
                            io::ErrorKind::NotFound,
                            "reopen temporary file",
                            "temporary path was removed",
                        ),
                    )
                }
                let opened = self.owned.parent.open_at(
                    self.owned.name,
                    fd::O_RDWR | fd::O_NOFOLLOW,
                    0,
                )?;
                let accepted = Ref::new(false);
                defer {
                    if !accepted.get() {
                        let _ = opened.close();
                    }
                };
                let original = descriptor.stat()?;
                let current = opened.stat()?;
                if current.dev != original.dev || current.ino != original.ino {
                    return Result::Err(
                        failure(
                            io::ErrorKind::InvalidData,
                            "reopen temporary file",
                            "path changed while reopening",
                        ),
                    )
                }
                accepted.set(true);
                Result::Ok(File { descriptor: opened })
            },
        )
    }
}

impl io::Read for NamedTempFile {
    fn read(self: NamedTempFile, buffer: MutSlice[byte]) -> Result[isize, io::Error] {
        self.owned.access(|descriptor| descriptor.read(buffer))
    }

    fn read_exact(self: NamedTempFile, buffer: MutSlice[byte]) -> Result[(), io::Error] {
        self.owned.access(|descriptor| io::Read::read_exact(descriptor, buffer))
    }
}

impl io::Write for NamedTempFile {
    fn write(self: NamedTempFile, buffer: Slice[byte]) -> Result[isize, io::Error] {
        self.owned.access(|descriptor| descriptor.write(buffer))
    }

    fn write_all(self: NamedTempFile, buffer: Slice[byte]) -> Result[(), io::Error] {
        self.owned.access(|descriptor| descriptor.write_all(buffer))
    }

    fn flush(self: NamedTempFile) -> Result[(), io::Error] {
        self.owned.access(|_| Result::Ok(()))
    }
}

impl io::Close for NamedTempFile {
    fn close(self: NamedTempFile) -> Result[(), io::Error] {
        self.close()
    }
}
