package tempfile;

use std::io;
use std::os::linux::fd;
use std::path;

fn same_entry(owned: Managed) -> Result[bool, io::Error] {
    let current = owned.parent.with_raw_fd(
        |raw| fd::stat_at(raw.to_isize(), owned.name, fd::AT_SYMLINK_NOFOLLOW),
    );
    match current {
        Err(error) if error.kind() == io::ErrorKind::NotFound => Result::Ok(false),
        Err(error) => Result::Err(error),
        Ok(current) => {
            let original = owned.descriptor.stat()?;
            if current.dev != original.dev || current.ino != original.ino {
                Result::Err(
                    failure(
                        io::ErrorKind::InvalidData,
                        "temporary resource",
                        "path no longer names the original resource",
                    ),
                )
            } else {
                Result::Ok(true)
            }
        },
    }
}

fn remove_contents(directory: fd::Fd, depth: isize) -> Result[(), io::Error] {
    if depth > 256 {
        return Result::Err(
            failure(
                io::ErrorKind::InvalidData,
                "remove temporary directory",
                "directory nesting exceeds 256 levels",
            ),
        )
    }
    let _ = directory.seek(0, fd::SEEK_SET)?;
    loop {
        let entries = directory.read_dir()?;
        if entries.is_empty() {
            return Result::Ok(())
        }
        for entry in entries {
            if entry.name == Vec::from_array([b'.']) || entry.name == Vec::from_array([b'.', b'.']) {
                continue
            }
            let removed = directory.with_raw_fd(
                |raw| {
                    let status = fd::stat_at_bytes(
                        raw.to_isize(),
                        entry.name.as_slice(),
                        fd::AT_SYMLINK_NOFOLLOW,
                    )?;
                    if status.mode.to_usize() & fd::S_IFMT == fd::S_IFDIR {
                        let child = directory.open_at_bytes(
                            entry.name.as_slice(),
                            fd::O_RDONLY | fd::O_DIRECTORY | fd::O_NOFOLLOW,
                            0,
                        )?;
                        defer {
                            let _ = child.close();
                        };
                        let actual = child.stat()?;
                        if actual.dev != status.dev || actual.ino != status.ino {
                            return Result::Err(
                                failure(
                                    io::ErrorKind::InvalidData,
                                    "remove temporary directory",
                                    "directory changed during cleanup",
                                ),
                            )
                        }
                        remove_contents(child, depth + 1)?;
                        fd::unlink_at_bytes(raw.to_isize(), entry.name.as_slice(), fd::AT_REMOVEDIR)
                    } else {
                        fd::unlink_at_bytes(raw.to_isize(), entry.name.as_slice(), 0)
                    }
                },
            );
            match removed {
                Err(error) if error.kind() == io::ErrorKind::NotFound => {},
                Err(error) => return Result::Err(error),
                Ok(()) => {},
            }
        }
    }
}

impl Managed {
    fn remove(self: Managed) -> Result[(), io::Error] {
        if !same_entry(self)? {
            return Result::Ok(())
        }
        if self.directory {
            remove_contents(self.descriptor, 0)?;
        }
        self.parent.with_raw_fd(
            |raw| fd::unlink_at(
                raw.to_isize(),
                self.name,
                if self.directory {
                    fd::AT_REMOVEDIR
                } else {
                    0
                },
            ),
        )
    }

    fn close(self: Managed) -> Result[(), io::Error] {
        self.locked(
            |state| {
                if !state.get().active {
                    return Result::Ok(())
                }
                state.set(ManagedState { active: false });
                let removed = self.remove();
                let descriptor_closed = self.descriptor.close();
                let parent_closed = self.parent.close();
                removed?;
                descriptor_closed?;
                parent_closed
            },
        )
    }

    fn transfer(self: Managed, destination: Option[string], overwrite: bool, anonymous: bool) -> Result[
        (),
        io::Error,
    ] {
        self.locked(
            |state| {
                if !state.get().active {
                    return Result::Err(inactive())
                }
                if !same_entry(self)? {
                    return Result::Err(
                        failure(
                            io::ErrorKind::NotFound,
                            "persist temporary resource",
                            "temporary path was removed",
                        ),
                    )
                }
                if anonymous {
                    self.parent.with_raw_fd(|raw| fd::unlink_at(raw.to_isize(), self.name, 0))?;
                } else if let Some(destination) = destination {
                    if destination == "" || destination.ends_with("/") {
                        return Result::Err(
                            failure(
                                io::ErrorKind::InvalidInput,
                                "persist temporary resource",
                                "destination must name a file or directory",
                            ),
                        )
                    }
                    let name = path::file_name(destination).ok_or(
                        failure(
                            io::ErrorKind::InvalidInput,
                            "persist temporary resource",
                            "destination must have a file name",
                        ),
                    )?;
                    if name == "." || name == ".." {
                        return Result::Err(
                            failure(
                                io::ErrorKind::InvalidInput,
                                "persist temporary resource",
                                "invalid destination name",
                            ),
                        )
                    }
                    let target_parent = fd::open(
                        path::parent(destination).unwrap_or("."),
                        fd::O_RDONLY | fd::O_DIRECTORY,
                        0,
                    )?;
                    defer {
                        let _ = target_parent.close();
                    };
                    self.parent.with_raw_fd(
                        |source| target_parent.with_raw_fd(
                            |target| {
                                fd::rename_at(
                                    source.to_isize(),
                                    self.name,
                                    target.to_isize(),
                                    name,
                                    if overwrite {
                                        0
                                    } else {
                                        fd::RENAME_NOREPLACE
                                    },
                                )
                            },
                        ),
                    )?;
                }
                state.set(ManagedState { active: false });
                let _ = self.parent.close();
                Result::Ok(())
            },
        )
    }
}

impl TempDir {
    pub fn new() -> Result[TempDir, io::Error] {
        tempdir()
    }

    pub fn path(self: TempDir) -> string {
        self.owned.path_value
    }

    pub fn is_closed(self: TempDir) -> bool {
        self.owned.is_closed()
    }

    pub fn close(self: TempDir) -> Result[(), io::Error] {
        self.owned.close()
    }

    pub fn keep(self: TempDir) -> Result[string, io::Error] {
        self.owned.transfer(Option::None, false, false)?;
        let _ = self.owned.descriptor.close();
        Result::Ok(self.path())
    }

    pub fn persist(self: TempDir, destination: string) -> Result[string, io::Error] {
        let absolute = absolute_path(destination)?;
        self.owned.transfer(Option::Some(destination), false, false)?;
        let _ = self.owned.descriptor.close();
        Result::Ok(absolute)
    }
}

impl io::Close for TempDir {
    fn close(self: TempDir) -> Result[(), io::Error] {
        self.close()
    }
}

fn absolute_path(value: string) -> Result[string, io::Error] {
    path::absolute_structured(value).map_err(
        |error| io::Error::new(
            error.kind(),
            error.operation(),
            error.context(),
            error.raw_os_code(),
            error.message(),
        ),
    )
}
