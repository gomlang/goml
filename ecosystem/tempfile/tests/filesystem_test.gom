package tests;

use ecosystem::tempfile;
use std::bytes;
use std::fs;
use std::io;
use io::{Read, Write};
use std::os::linux::fd;
use std::path;
use std::task;
use std::testing;

fn must[T](value: Result[T, io::Error]) -> T {
    match value {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            loop {}
        },
    }
}

fn directory() -> tempfile::TempDir {
    must(tempfile::tempdir())
}

fn content(value: string) -> bytes::Bytes {
    bytes::Bytes::from_string(value)
}

#[test]
fn builder_names_permissions_and_validation() -> () {
    let root = directory();
    defer {
        let _ = root.close();
    };
    let builder = tempfile::Builder::new().parent(root.path()).prefix("report-").suffix(".log");
    let file = must(builder.tempfile());
    defer {
        let _ = file.close();
    };
    let name = testing::expect_some(path::file_name(file.path()), "name");
    testing::assert(name.starts_with("report-") && name.ends_with(".log"));
    testing::assert_eq(name.byte_len(), 43);
    let mode = testing::expect_ok(fs::metadata(file.path()), "file metadata").permissions().mode();
    testing::assert_eq(mode & 0o077, 0);
    let nested = must(builder.tempdir());
    defer {
        let _ = nested.close();
    };
    let mode = testing::expect_ok(fs::metadata(nested.path()), "directory metadata").permissions().mode();
    testing::assert_eq(mode & 0o077, 0);
    for prefix in Vec::from_array(["../bad", "sub/file", "bad\\name", "bad\u0000name"]) {
        testing::assert_err(builder.prefix(prefix).tempfile());
    }
    testing::assert_err(builder.suffix("/bad").tempdir());
    testing::assert_err(builder.random_bytes(7).tempfile());
    testing::assert_err(builder.random_bytes(65).tempfile());
    testing::assert_err(builder.attempts(0).tempdir());
    testing::assert_err(builder.attempts(1025).tempdir());
    testing::assert_err(builder.parent(path::join(root.path(), "missing")).tempfile());
    testing::assert_err(builder.parent(file.path()).tempfile());
    let short = must(builder.random_bytes(8).tempfile());
    defer {
        let _ = short.close();
    };
    testing::assert_eq(testing::expect_some(path::file_name(short.path()), "name").byte_len(), 27);
}

#[test]
fn file_read_write_seek_truncate_and_shared_aliases() -> () {
    let file = must(tempfile::NamedTempFile::new());
    defer {
        let _ = file.close();
    };
    let alias = file;
    must(file.write_all(content("abcdef").as_slice()));
    testing::assert_eq(must(alias.len()), 6);
    testing::assert_eq(must(file.seek(tempfile::SeekFrom::End(-2))), 4);
    testing::assert_eq(must(file.read_to_string(2)), "ef");
    must(file.rewind());
    let buffer = Vec::from_array([0, 0, 0]);
    must(alias.read_exact(buffer.as_mut_slice()));
    testing::assert(buffer == Vec::from_array([b'a', b'b', b'c']));
    testing::assert_eq(must(file.seek(tempfile::SeekFrom::Current(0))), 3);
    must(file.set_len(2));
    testing::assert_eq(must(file.len()), 2);
    testing::assert_eq(must(file.seek(tempfile::SeekFrom::Current(0))), 3);
    must(file.set_len(5));
    must(file.rewind());
    testing::assert(must(file.read_to_end(5)).to_vec() == Vec::from_array([b'a', b'b', 0, 0, 0]));
    testing::assert_err(file.seek(tempfile::SeekFrom::Start(-1)));
    testing::assert_err(file.set_len(-1));
    must(file.sync_data());
    must(file.sync_all());
    must(alias.close());
    testing::assert(file.is_closed());
    testing::assert(!fs::exists(file.path()));
    must(file.close());
    testing::assert_err(file.write(content("x").as_slice()));
    testing::assert_err(file.flush());
    testing::assert_err(file.keep());
}

#[test]
fn reopening_has_independent_cursor_and_duplicate_shares_cursor() -> () {
    let file = must(tempfile::NamedTempFile::new());
    defer {
        let _ = file.close();
    };
    must(file.write_all(content("abcdef").as_slice()));
    let reopened = must(file.reopen());
    defer {
        let _ = reopened.close();
    };
    testing::assert_eq(must(reopened.read_to_string(6)), "abcdef");
    must(file.rewind());
    let duplicate = must(file.duplicate());
    defer {
        let _ = duplicate.close();
    };
    testing::assert_eq(must(duplicate.seek(tempfile::SeekFrom::Current(2))), 2);
    testing::assert_eq(must(file.seek(tempfile::SeekFrom::Current(0))), 2);
    must(file.close());
    testing::assert(!duplicate.is_closed());
    testing::assert_eq(must(duplicate.read_to_string(4)), "cdef");
    must(reopened.rewind());
    testing::assert_eq(must(reopened.read_to_string(6)), "abcdef");
}

#[test]
fn anonymous_unlinks_immediately_and_transfers_aliases() -> () {
    let root = directory();
    defer {
        let _ = root.close();
    };
    let named = must(tempfile::NamedTempFile::new_in(root.path()));
    must(named.write_all(content("secret").as_slice()));
    let file = must(named.into_file());
    defer {
        let _ = file.close();
    };
    testing::assert(named.is_closed());
    testing::assert(!fs::exists(named.path()));
    testing::assert_err(named.read_to_end(10));
    must(named.close());
    must(file.rewind());
    testing::assert_eq(must(file.read_to_string(6)), "secret");
    let fresh = must(tempfile::tempfile_in(root.path()));
    defer {
        let _ = fresh.close();
    };
    testing::assert_eq(testing::expect_ok(fs::read_dir(root.path()), "parent entries").len(), 0);
    must(fresh.write_all(content("x").as_slice()));
    must(fresh.rewind());
    testing::assert_eq(must(fresh.read_to_string(1)), "x");
}

#[test]
fn persist_is_atomic_noclobber_and_failed_transfer_preserves_owner() -> () {
    let root = directory();
    defer {
        let _ = root.close();
    };
    let file = must(tempfile::NamedTempFile::new_in(root.path()));
    defer {
        let _ = file.close();
    };
    must(file.write_all(content("new").as_slice()));
    let target = path::join(root.path(), "output");
    testing::assert_ok(fs::write_file_structured(target, "old"));
    testing::assert_eq(
        testing::expect_err(file.persist(target), "no clobber").kind(),
        io::ErrorKind::AlreadyExists,
    );
    testing::assert(!file.is_closed());
    testing::assert_eq(
        testing::expect_ok(fs::read_file_structured(target), "original target"),
        "old",
    );
    testing::assert_err(file.persist(path::join(root.path(), "missing/target")));
    testing::assert_err(file.persist(""));
    testing::assert_err(file.persist(root.path() + "/"));
    let output = must(file.persist_overwrite(target));
    defer {
        let _ = output.close();
    };
    testing::assert(file.is_closed());
    testing::assert(!fs::exists(file.path()));
    must(file.close());
    testing::assert_eq(testing::expect_ok(fs::read_file_structured(target), "persisted"), "new");
    must(output.rewind());
    testing::assert_eq(must(output.read_to_string(3)), "new");
    let second = must(tempfile::NamedTempFile::new_in(root.path()));
    defer {
        let _ = second.close();
    };
    let distinct = must(second.persist(path::join(root.path(), "new-output")));
    must(distinct.close());
    testing::assert(fs::exists(path::join(root.path(), "new-output")));
}

#[test]
fn symlink_destination_noclobber_and_overwrite_does_not_follow() -> () {
    let root = directory();
    defer {
        let _ = root.close();
    };
    let protected = path::join(root.path(), "protected");
    let link = path::join(root.path(), "link");
    testing::assert_ok(fs::write_file_structured(protected, "untouched"));
    testing::assert_ok(fs::symbolic_link(protected, link));
    let file = must(tempfile::NamedTempFile::new_in(root.path()));
    defer {
        let _ = file.close();
    };
    must(file.write_all(content("replacement").as_slice()));
    testing::assert_err(file.persist(link));
    let persisted = must(file.persist_overwrite(link));
    must(persisted.close());
    testing::assert_eq(
        testing::expect_ok(fs::read_file_structured(protected), "protected"),
        "untouched",
    );
    testing::assert_eq(
        testing::expect_ok(fs::read_file_structured(link), "replacement"),
        "replacement",
    );
    testing::assert(
        !testing::expect_ok(fs::symlink_metadata(link), "metadata").file_type().is_symlink(),
    );
}

#[test]
fn keep_files_and_directories_disarms_all_aliases() -> () {
    let root = directory();
    defer {
        let _ = root.close();
    };
    let file = must(tempfile::NamedTempFile::new_in(root.path()));
    let kept = must(file.keep());
    defer {
        let _ = kept.file.close();
    };
    must(file.close());
    testing::assert(file.is_closed());
    testing::assert(fs::exists(kept.path));
    must(kept.file.write_all(content("kept").as_slice()));
    let nested = must(tempfile::tempdir_in(root.path()));
    let path = must(nested.keep());
    must(nested.close());
    testing::assert(nested.is_closed());
    testing::assert(fs::is_dir(path));
    testing::assert_err(nested.keep());
}

#[test]
fn recursive_cleanup_unlinks_symlinks_without_following() -> () {
    let outside = directory();
    defer {
        let _ = outside.close();
    };
    let protected = path::join(outside.path(), "protected");
    testing::assert_ok(fs::write_file_structured(protected, "keep"));
    let root = directory();
    defer {
        let _ = root.close();
    };
    testing::assert_ok(fs::create_dir_all(path::join(root.path(), "a/b/c")));
    testing::assert_ok(fs::write_file_structured(path::join(root.path(), "a/b/c/file"), "remove"));
    testing::assert_ok(fs::symbolic_link(outside.path(), path::join(root.path(), "directory-link")));
    testing::assert_ok(fs::symbolic_link(protected, path::join(root.path(), "file-link")));
    testing::assert_ok(fs::symbolic_link("missing", path::join(root.path(), "broken-link")));
    let raw = must(fd::open(root.path(), fd::O_RDONLY | fd::O_DIRECTORY, 0));
    defer {
        let _ = raw.close();
    };
    let invalid_name = Vec::from_array([255, b'x']);
    let non_utf8 = must(
        raw.open_at_bytes(invalid_name.as_slice(), fd::O_CREAT | fd::O_EXCL | fd::O_RDWR, 0o600),
    );
    must(non_utf8.close());
    must(root.close());
    testing::assert(!fs::exists(root.path()));
    testing::assert_eq(
        testing::expect_ok(fs::read_file_structured(protected), "outside survived"),
        "keep",
    );
}

#[test]
fn directory_persist_preserves_tree_and_refuses_existing_target() -> () {
    let outer = directory();
    defer {
        let _ = outer.close();
    };
    let root = must(tempfile::tempdir_in(outer.path()));
    defer {
        let _ = root.close();
    };
    testing::assert_ok(fs::write_file_structured(path::join(root.path(), "data"), "content"));
    let existing = path::join(outer.path(), "existing");
    testing::assert_ok(fs::create_dir(existing));
    testing::assert_err(root.persist(existing));
    let target = path::join(outer.path(), "saved");
    testing::assert_eq(must(root.persist(target)), target);
    must(root.close());
    testing::assert(!fs::exists(root.path()));
    testing::assert_eq(
        testing::expect_ok(fs::read_file_structured(path::join(target, "data")), "tree"),
        "content",
    );
}

#[test]
fn replacement_is_detected_and_original_descriptor_still_reads() -> () {
    let root = directory();
    defer {
        let _ = root.close();
    };
    let file = must(tempfile::NamedTempFile::new_in(root.path()));
    defer {
        let _ = file.close();
    };
    must(file.write_all(content("original").as_slice()));
    testing::assert_ok(fs::rename(file.path(), path::join(root.path(), "moved")));
    testing::assert_ok(fs::write_file_structured(file.path(), "replacement"));
    testing::assert_err(file.reopen());
    testing::assert_err(file.keep());
    testing::assert_err(file.persist(path::join(root.path(), "target")));
    must(file.rewind());
    testing::assert_eq(must(file.read_to_string(8)), "original");
    testing::assert_eq(
        testing::expect_err(file.close(), "replaced").kind(),
        io::ErrorKind::InvalidData,
    );
    testing::assert(file.is_closed());
    testing::assert_eq(
        testing::expect_ok(fs::read_file_structured(file.path()), "replacement untouched"),
        "replacement",
    );
}

#[test]
fn deleted_paths_close_successfully_and_pinned_parent_survives_rename() -> () {
    let outer = directory();
    defer {
        let _ = outer.close();
    };
    let parent = path::join(outer.path(), "parent");
    let renamed = path::join(outer.path(), "renamed");
    testing::assert_ok(fs::create_dir(parent));
    let file = must(tempfile::NamedTempFile::new_in(parent));
    defer {
        let _ = file.close();
    };
    let name = testing::expect_some(path::file_name(file.path()), "name");
    testing::assert_ok(fs::rename(parent, renamed));
    must(file.close());
    testing::assert(!fs::exists(path::join(renamed, name)));
    let removed = must(tempfile::NamedTempFile::new_in(renamed));
    testing::assert_ok(fs::remove_file(removed.path()));
    testing::assert_err(removed.keep());
    must(removed.close());
}

#[test]
fn scoped_lifetimes_keep_and_both_errors() -> () {
    let outer = directory();
    defer {
        let _ = outer.close();
    };
    let builder = tempfile::Builder::new().parent(outer.path());
    let escaped = testing::expect_ok(
        tempfile::with_tempfile(builder, |file| Result::Ok(file)),
        "scope",
    );
    testing::assert(escaped.is_closed());
    testing::assert(!fs::exists(escaped.path()));
    let kept = testing::expect_ok(
        tempfile::with_tempfile(builder, |file| file.keep()),
        "scope keep",
    );
    defer {
        let _ = kept.file.close();
    };
    testing::assert(fs::exists(kept.path));
    let error = io::Error::new(io::ErrorKind::Other, "action", Option::None, Option::None, "failed");
    let result: Result[(), tempfile::ScopeError] = tempfile::with_tempfile(
        builder,
        |file| {
            testing::assert_ok(fs::rename(file.path(), path::join(outer.path(), "renamed")));
            testing::assert_ok(fs::write_file_structured(file.path(), "replacement"));
            Result::Err(error)
        },
    );
    let failed = testing::expect_err(result, "both errors");
    testing::assert_some(failed.action);
    testing::assert_some(failed.cleanup);
    let escaped_dir = testing::expect_ok(
        tempfile::with_tempdir(builder, |dir| Result::Ok(dir)),
        "directory scope",
    );
    testing::assert(escaped_dir.is_closed());
    let escaped_file = testing::expect_ok(
        tempfile::with_anonymous(builder, |file| Result::Ok(file)),
        "anonymous scope",
    );
    testing::assert(escaped_file.is_closed());
}

#[test]
fn concurrent_creation_is_unique_and_cleanup_is_idempotent() -> () {
    let root = directory();
    defer {
        let _ = root.close();
    };
    task::scope(
        |scope| {
            let tasks = Vec::new();
            for _ in 0..64 {
                tasks.push(scope.spawn(|_| must(tempfile::NamedTempFile::new_in(root.path()))));
            }
            let files = task::join_all(tasks);
            for left in 0..files.len() {
                for right in left + 1..files.len() {
                    testing::assert(files[left].path() != files[right].path());
                }
            }
            let jobs = Vec::new();
            for file in files {
                for _ in 0..4 {
                    jobs.push(scope.spawn(|_| must(file.close())));
                }
            }
            let _ = task::join_all(jobs);
        },
    );
    testing::assert_eq(testing::expect_ok(fs::read_dir(root.path()), "all cleaned").len(), 0);
}

#[test]
fn concurrent_transfer_has_one_winner_and_cannot_close_kept_file() -> () {
    let root = directory();
    defer {
        let _ = root.close();
    };
    let file = must(tempfile::NamedTempFile::new_in(root.path()));
    defer {
        let _ = file.close();
    };
    task::scope(
        |scope| {
            let tasks = Vec::new();
            for _ in 0..16 {
                tasks.push(scope.spawn(|_| file.keep()));
            }
            let results = task::join_all(tasks);
            let mut wins = 0;
            for result in results {
                if let Ok(kept) = result {
                    wins += 1;
                    must(file.close());
                    must(kept.file.write_all(content("alive").as_slice()));
                    must(kept.file.close());
                }
            }
            testing::assert_eq(wins, 1);
        },
    );
}

#[test]
fn repeated_scopes_do_not_leak_descriptors() -> () {
    let warmup = must(tempfile::tempfile());
    must(warmup.close());
    let baseline = testing::expect_ok(fs::read_dir("/proc/self/fd"), "fd list").len();
    for _ in 0..128 {
        let root = directory();
        let file = must(tempfile::NamedTempFile::new_in(root.path()));
        let anonymous = must(tempfile::tempfile_in(root.path()));
        must(file.close());
        must(anonymous.close());
        must(root.close());
    }
    let after = testing::expect_ok(fs::read_dir("/proc/self/fd"), "fd list").len();
    testing::assert_eq(after, baseline);
}

#[test]
fn streams_compose_with_buffered_io_and_copy() -> () {
    let source = must(tempfile::tempfile());
    defer {
        let _ = source.close();
    };
    let buffered = io::BufWriter::new(source);
    must(buffered.write_all(content("line one\nline two\n").as_slice()));
    must(buffered.flush());
    must(source.rewind());
    let destination = must(tempfile::SpooledTempFile::new(4));
    defer {
        let _ = destination.close();
    };
    testing::assert_eq(must(io::copy(io::BufReader::new(source), destination)), 18);
    testing::assert(destination.is_rolled());
    must(destination.rewind());
    testing::assert_eq(must(destination.read_to_string(18)), "line one\nline two\n");
}

#[test]
fn scoped_action_failure_still_removes_its_path() -> () {
    let location = Ref::new("");
    let error = io::Error::new(io::ErrorKind::Other, "action", Option::None, Option::None, "abort");
    let result: Result[(), tempfile::ScopeError] = tempfile::with_tempfile(
        tempfile::Builder::new(),
        |file| {
            location.set(file.path());
            file.write_all(content("partial").as_slice())?;
            Result::Err(error)
        },
    );
    let failure = testing::expect_err(result, "action failed");
    testing::assert_some(failure.action);
    testing::assert_none(failure.cleanup);
    testing::assert(!fs::exists(location.get()));
}

#[test]
fn simultaneous_close_and_io_use_shared_lifecycle() -> () {
    let file = must(tempfile::NamedTempFile::new());
    defer {
        let _ = file.close();
    };
    let data = content("record\n");
    task::scope(
        |scope| {
            let start: Channel[()] = Channel::new(0);
            let tasks = Vec::new();
            for _ in 0..16 {
                tasks.push(
                    scope.spawn(
                        |_| {
                            let _ = start.recv();
                            for _ in 0..64 {
                                if let Err(error) = file.write_all(data.as_slice()) {
                                    testing::assert_eq(error.kind(), io::ErrorKind::InvalidInput);
                                    return
                                }
                            }
                        },
                    ),
                );
            }
            let close = scope.spawn(
                |_| {
                    let _ = start.recv();
                    must(file.close());
                },
            );
            start.close();
            let _ = task::join_all(tasks);
            close.join();
        },
    );
    testing::assert(file.is_closed());
    testing::assert(!fs::exists(file.path()));
}
