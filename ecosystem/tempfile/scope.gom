package tempfile;

use std::io;

fn scoped_result[T](action: Result[T, io::Error], cleanup: Result[(), io::Error]) -> Result[
    T,
    ScopeError,
] {
    match (action, cleanup) {
        (Ok(value), Ok(())) => Result::Ok(value),
        (Err(error), Ok(())) => Result::Err(
            ScopeError { action: Option::Some(error), cleanup: Option::None },
        ),
        (Ok(_), Err(error)) => Result::Err(
            ScopeError { action: Option::None, cleanup: Option::Some(error) },
        ),
        (Err(action), Err(cleanup)) => Result::Err(
            ScopeError { action: Option::Some(action), cleanup: Option::Some(cleanup) },
        ),
    }
}

fn creation_error(error: io::Error) -> ScopeError {
    ScopeError { action: Option::Some(error), cleanup: Option::None }
}

pub fn with_tempfile[T](builder: Builder, action: (NamedTempFile) -> Result[T, io::Error]) -> Result[
    T,
    ScopeError,
] {
    let file = builder.tempfile().map_err(creation_error)?;
    defer {
        let _ = file.close();
    };
    let result = action(file);
    scoped_result(result, file.close())
}

pub fn with_tempdir[T](builder: Builder, action: (TempDir) -> Result[T, io::Error]) -> Result[
    T,
    ScopeError,
] {
    let directory = builder.tempdir().map_err(creation_error)?;
    defer {
        let _ = directory.close();
    };
    let result = action(directory);
    scoped_result(result, directory.close())
}

pub fn with_anonymous[T](builder: Builder, action: (File) -> Result[T, io::Error]) -> Result[
    T,
    ScopeError,
] {
    let file = builder.anonymous().map_err(creation_error)?;
    defer {
        let _ = file.close();
    };
    let result = action(file);
    scoped_result(result, file.close())
}

pub fn with_spooled[T](
    limit: isize,
    builder: Builder,
    action: (SpooledTempFile) -> Result[T, io::Error],
) -> Result[T, ScopeError] {
    let file = SpooledTempFile::with_builder(limit, builder).map_err(creation_error)?;
    defer {
        let _ = file.close();
    };
    let result = action(file);
    scoped_result(result, file.close())
}
