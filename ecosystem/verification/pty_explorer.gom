package main;

use std::fs;
use std::num;
use std::os::linux::process;
use std::time;

fn pty_stat(text: string, key: string) -> isize {
    match text.find(key) {
        Some(start) => {
            let start = start + key.byte_len();
            let mut end = start;
            while end < text.byte_len() && text.byte_get(end) >= b'0' && text.byte_get(end) <= b'9' {
                end += 1;
            }
            num::parse_int_structured(text.byte_slice(start, end)).unwrap_or(-1)
        },
        None => -1,
    }
}

fn verify_explorer_pty(binary: string) -> Result[(), string] {
    let root = "/tmp/goml-native-explorer-" + process::pid().map_err(|e| e.to_string())?.to_string()
        + "-"
        + time::SystemTime::now().unix_nanoseconds().to_string();
    fs::create_dir(root).map_err(|e| e.to_string())?;
    defer {
        let _ = fs::remove_dir_all(root);
    };
    let readme = root + "/README.md";
    fs::write_file_structured(readme, "# Initial preview\n\nA read-only file browser.\n").map_err(
        |e| e.to_string(),
    )?;
    fs::create_dir(root + "/docs").map_err(|e| e.to_string())?;
    let mut guide = "# Guide heading\n";
    for index in 0..100 {
        guide += "\nGuide paragraph " + index.to_string() + "\n";
    }
    fs::write_file_structured(root + "/docs/guide.md", guide).map_err(|e| e.to_string())?;
    fs::create_dir(root + "/_artifact").map_err(|e| e.to_string())?;
    fs::write_file_structured(root + "/_artifact/ignored.md", "# Hidden").map_err(|e| e.to_string())?;
    let child = Pty::open(binary, root, 110, 28)?;
    defer child.close();
    child.until(
        |child| child.screen.text().contains("Initial preview")
            && child.screen.text().contains("Scan complete"),
        "Explorer initial scan",
    )?;
    pty_require(
        child.screen.text().contains("README.md") && !child.screen.text().contains("ignored.md")
            && child.screen.text().contains("4/4"),
        "Explorer directory exclusions or scan count",
    )?;
    child.assert_raw(false)?;
    let updated = "# Updated preview\n\nRoot notifications refreshed this file.\n";
    fs::write_file_structured(readme, updated).map_err(|e| e.to_string())?;
    child.until(
        |child| child.screen.text().contains("Updated preview")
            && pty_stat(child.screen.text(), "changes ") > 0,
        "Explorer changed file notification",
    )?;
    fs::write_file_structured(root + "/fresh.md", "# Fresh file\n").map_err(|e| e.to_string())?;
    child.until(
        |child| child.screen.text().contains("fresh.md")
            && child.screen.text().contains("Scan complete"),
        "Explorer created file notification",
    )?;
    fs::remove_file(root + "/fresh.md").map_err(|e| e.to_string())?;
    child.until(
        |child| !child.screen.text().contains("fresh.md")
            && child.screen.text().contains("Scan complete"),
        "Explorer removed file notification",
    )?;
    child.send("\u001b[B\u001b[B")?;
    child.visible("Guide heading")?;
    child.send("\t")?;
    child.visible("Markdown [focus]")?;
    child.send("\u001b[6~")?;
    child.until(
        |child| !child.screen.text().contains("Guide heading")
            && child.screen.text().contains("Guide paragraph"),
        "Explorer preview scrolling",
    )?;
    let prior = pty_stat(child.screen.text(), "scans ");
    pty_require(prior >= 0, "Explorer scan counter missing")?;
    child.send("r")?;
    child.until(
        |child| pty_stat(child.screen.text(), "scans ") > prior
            && child.screen.text().contains("Scan complete"),
        "Explorer manual rescan",
    )?;
    child.resize(84, 20)?;
    child.until(
        |child| child.screen.text().contains("GoML Explorer")
            && child.screen.text().contains("q quit"),
        "Explorer resize",
    )?;
    child.send("q")?;
    child.finish()?;
    child.modes(true, false)?;
    pty_require(
        fs::read_file_structured(readme).map_err(|e| e.to_string())? == updated,
        "Explorer modified file contents",
    )
}
