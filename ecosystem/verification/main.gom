package main;

use std::env;
use std::fs;
use std::io;
use std::path;
use std::process;

pub struct Options {
    pub selected: Vec[string],
    pub goml: string,
    pub registry_only: bool,
    pub race: bool,
    pub list: bool,
}

pub fn parse_options(arguments: Vec[string], root: string) -> Result[Options, string] {
    let mut options = Options {
        selected: Vec::new(),
        goml: path::join(root, "stage2/bin/goml"),
        registry_only: false,
        race: true,
        list: false,
    };
    let valid = modules();
    valid.push("goml_stats");
    valid.push("explorer");
    let mut index = 0;
    while index < arguments.len() {
        let argument = arguments[index];
        match argument {
            "--goml" => {
                index += 1;
                if index == arguments.len() {
                    return Result::Err("--goml requires a path");
                }
                options.goml = path::absolute_structured(arguments[index]).map_err(
                    |error| error.to_string(),
                )?;
            },
            "--registry-only" => {
                options.registry_only = true;
            },
            "--no-race" => {
                options.race = false;
            },
            "--list" | "--help" | "-h" => {
                options.list = true;
            },
            _ => {
                if !valid.contains(argument) {
                    return Result::Err("unknown module or option: " + argument);
                }
                if !options.selected.contains(argument) {
                    options.selected.push(argument);
                }
            },
        }
        index += 1;
    }
    if options.selected.is_empty() {
        options.selected = valid;
    }
    Result::Ok(options)
}

pub fn repository_root(start: string) -> Result[string, string] {
    let mut current = path::absolute_structured(start).map_err(|error| error.to_string())?;
    loop {
        if fs::is_file(path::join(current, "ecosystem/verification/goml.toml")) {
            return Result::Ok(current);
        }
        match path::parent(current) {
            Some(parent) => {
                if parent == current {
                    return Result::Err("cannot find repository root");
                }
                current = parent;
            },
            None => return Result::Err("cannot find repository root"),
        }
    }
}

fn execute() -> Result[(), string] {
    let root = repository_root(env::current_dir_structured().map_err(|error| error.to_string())?)?;
    let arguments = env::args();
    let options = parse_options(arguments.slice(1, arguments.len()).to_vec(), root)?;
    if options.list {
        io::println(
            "Usage: just ecosystem-test [--goml PATH] [--no-race] [MODULE...]\nNative GoML tests, consumer builds, cache stability, PTY and race checks.\n--registry-only prints the isolated registry GOML_HOME.",
        );
        for name in options.selected {
            io::println(name);
        }
        return Result::Ok(());
    }
    let home = registry_snapshot(path::join(root, "ecosystem"))?;
    if options.registry_only {
        io::println(home);
        return Result::Ok(());
    }
    verify_all(root, home, options)
}

fn main() -> () {
    match execute() {
        Result::Ok(()) => (),
        Result::Err(error) => {
            io::eprintln(error);
            process::exit(1);
        },
    }
}
