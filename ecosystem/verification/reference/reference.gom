package reference;

use std::bytes;
use std::env;
use std::fs;
use std::json;
use std::process;
use std::testing;
use std::time;
use std::utf8;
use utf8::BytesUtf8;

pub fn array(value: json::Value) -> Vec[json::Value] {
    testing::expect_some(json::as_array(value), "expected reference array")
}

pub fn field(value: json::Value, name: string) -> json::Value {
    testing::expect_some(json::field(value, name), "expected reference field " + name)
}

pub fn integer(value: json::Value) -> isize {
    testing::expect_some(json::as_int(value), "expected reference integer")
}

pub fn text(value: json::Value) -> string {
    testing::expect_some(json::as_string(value), "expected reference string")
}

pub fn load() -> json::Value {
    let source = testing::expect_ok(
        fs::read_file_structured("tests/data/reference.json"),
        "read independent reference fixture",
    );
    let value = testing::expect_ok(json::parse(source), "parse reference fixture");
    if json::field(value, "format").and_then(|v| json::as_string(v))
        != Option::Some("indexed-json-v2") {
        return value
    }
    let shapes = array(field(value, "shapes"));
    let decoded: Vec[json::Value] = Vec::new();
    for entry in array(field(value, "nodes")) {
        let node = array(entry);
        decoded.push(
            match integer(node[0]) {
                0 => node[1],
                1 => {
                    let output = Vec::new();
                    for index in array(node[1]) {
                        output.push(decoded[integer(index)]);
                    }
                    json::Value::Array(output)
                },
                2 => {
                    let keys = array(shapes[integer(node[1])]);
                    let values = array(node[2]);
                    testing::assert_eq(keys.len(), values.len());
                    let output = Vec::new();
                    for index in 0..keys.len() {
                        output.push((text(keys[index]), decoded[integer(values[index])]));
                    }
                    json::Value::Object(output)
                },
                _ => {
                    testing::fail("invalid indexed reference node");
                    json::Value::Null
                },
            },
        );
    }
    decoded[integer(field(value, "root"))]
}

pub fn equal(left: json::Value, right: json::Value) -> bool {
    match (left, right) {
        (Null, Null) => true,
        (Bool(a), Bool(b)) => a == b,
        (String(a), String(b)) => a == b,
        (Number(a), Number(b)) => a == b,
        (Array(a), Array(b)) => {
            if a.len() != b.len() {
                return false
            }
            for index in 0..a.len() {
                if !equal(a[index], b[index]) {
                    return false
                }
            }
            true
        },
        (Object(a), Object(b)) => {
            if a.len() != b.len() {
                return false
            }
            for (key, value) in a {
                match json::field(json::Value::Object(b), key) {
                    Some(other) => if !equal(value, other) {
                        return false
                    },
                    None => return false,
                }
            }
            true
        },
        _ => false,
    }
}

pub fn assert_equal(actual: json::Value, expected: json::Value, label: string) -> () {
    if !equal(actual, expected) {
        testing::fail(
            label + "\nactual: " + json::encode(actual) + "\nexpected: " + json::encode(expected),
        );
    }
}

pub fn multiset(actual: Vec[json::Value], expected: Vec[json::Value], label: string) -> () {
    testing::assert_eq(actual.len(), expected.len());
    let matched: Vec[bool] = Vec::new();
    for _ in expected {
        matched.push(false);
    }
    for entry in actual {
        let mut found = false;
        for index in 0..expected.len() {
            if !matched[index] && equal(entry, expected[index]) {
                matched[index] = true;
                found = true;
                break;
            }
        }
        if !found {
            testing::fail(label + ": unexpected " + json::encode(entry));
        }
    }
}

pub fn binary(name: string) -> string {
    env::var_structured("GOML_VERIFY_BINARY").unwrap_or("_artifact/bin/" + name)
}

pub fn output(name: string, argument: string, input: string) -> Result[process::Output, string] {
    process::Command::new(binary(name)).arg(argument).input(bytes::Bytes::from_string(input)).output_timeout_structured(
        time::Duration::from_seconds(120),
    ).map_err(|error| name + " consumer: " + error.to_string())
}

pub fn run(name: string, argument: string, input: string) -> Result[string, string] {
    let result = output(name, argument, input)?;
    let stderr = result.stderr().to_string_utf8().map_err(|error| error.to_string())?;
    if !result.status().success() {
        return Result::Err(name + " consumer failed: " + stderr)
    }
    if stderr != "" {
        return Result::Err(name + " unexpected stderr: " + stderr)
    }
    result.stdout().to_string_utf8().map_err(|error| error.to_string())
}

pub fn run_json(name: string, input: json::Value) -> Result[json::Value, string] {
    json::parse(run(name, "--json", json::encode(input))?)
}
