package reference;

use std::text;

pub fn strip_csi(value: string) -> string {
    let output = text::StringBuilder::new();
    let mut at = 0;
    let mut start = 0;
    while at + 1 < value.byte_len() {
        if value.byte_get(at) == 27 && value.byte_get(at + 1) == b'[' {
            let mut end = at + 2;
            while end < value.byte_len() && value.byte_get(end) >= 0x30
                && value.byte_get(end) <= 0x3f {
                end += 1;
            }
            while end < value.byte_len() && value.byte_get(end) >= 0x20
                && value.byte_get(end) <= 0x2f {
                end += 1;
            }
            if end < value.byte_len() && value.byte_get(end) >= 0x40 && value.byte_get(end) <= 0x7e {
                output.write_string(value.byte_slice(start, at));
                at = end + 1;
                start = at;
                continue
            }
        }
        at += 1;
    }
    output.write_string(value.byte_slice(start, value.byte_len()));
    output.finish()
}
