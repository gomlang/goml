package reference;

use std::num;
use std::utf8;

#[derive(Debug, PartialEq)]
pub struct Cell {
    pub text: string,
    pub width: isize,
    pub foreground: string,
    pub background: string,
    pub attributes: isize,
}

impl Cell {
    fn blank(self: Cell) -> Cell {
        Cell { text: " ", width: 1, ..self }
    }
}

struct ScreenState {
    width: isize,
    height: isize,
    cells: Vec[Cell],
    x: isize,
    y: isize,
    foreground: string,
    background: string,
    attributes: isize,
    head: Option[isize],
    joined: bool,
    pending: Vec[byte],
}

pub struct Screen {
    state: Ref[ScreenState],
}

impl Screen {
    pub fn new(width: isize, height: isize) -> Screen {
        let cells = Vec::new();
        for _ in 0..width * height {
            cells.push(
                Cell {
                    text: " ",
                    width: 1,
                    foreground: "default",
                    background: "default",
                    attributes: 0,
                },
            );
        }
        Screen {
            state: Ref::new(
                ScreenState {
                    width,
                    height,
                    cells,
                    x: 0,
                    y: 0,
                    foreground: "default",
                    background: "default",
                    attributes: 0,
                    head: Option::None,
                    joined: false,
                    pending: Vec::new(),
                },
            ),
        }
    }

    pub fn resize(self: Screen, width: isize, height: isize) -> () {
        let previous = self.state.get();
        let mut state = Screen::new(width, height).state.get();
        state.foreground = previous.foreground;
        state.background = previous.background;
        state.attributes = previous.attributes;
        state.pending = previous.pending;
        self.state.set(state);
    }

    pub fn cell(self: Screen, x: isize, y: isize) -> Cell {
        let state = self.state.get();
        state.cells[y * state.width + x]
    }

    pub fn width(self: Screen) -> isize {
        self.state.get().width
    }

    pub fn height(self: Screen) -> isize {
        self.state.get().height
    }

    pub fn attributes(self: Screen) -> isize {
        self.state.get().attributes
    }

    pub fn foreground(self: Screen) -> string {
        self.state.get().foreground
    }

    pub fn background(self: Screen) -> string {
        self.state.get().background
    }

    pub fn text(self: Screen) -> string {
        let state = self.state.get();
        let mut output = "";
        for y in 0..state.height {
            if y > 0 {
                output += "\n";
            }
            for x in 0..state.width {
                output += state.cells[y * state.width + x].text;
            }
        }
        output
    }

    pub fn highlighted(self: Screen, word: string) -> bool {
        let state = self.state.get();
        for y in 0..state.height {
            let mut highlighted = "";
            for x in 0..state.width {
                let cell = state.cells[y * state.width + x];
                if cell.attributes & 32 != 0 {
                    highlighted += cell.text;
                } else {
                    highlighted += " ";
                }
            }
            if highlighted.contains(word) {
                return true
            }
        }
        false
    }

    pub fn feed(self: Screen, bytes: Slice[byte]) -> Result[(), string] {
        let mut state = self.state.get();
        for byte in bytes {
            state.pending.push(byte);
        }
        let data = state.pending;
        let mut at = 0;
        while at < data.len() {
            if data[at] == 27 {
                if at + 1 == data.len() {
                    break
                }
                if data[at + 1] == 91 {
                    let mut end = at + 2;
                    while end < data.len() && !(data[end] >= 0x40 && data[end] <= 0x7e) {
                        end += 1;
                    }
                    if end == data.len() {
                        break
                    }
                    let parameters = utf8::decode_slice(data.slice(at + 2, end)).map_err(
                        |e| e.to_string(),
                    )?;
                    state = control(state, parameters, data[end])?;
                    at = end + 1;
                    continue
                }
                if data[at + 1] == 93 {
                    let mut end = at + 2;
                    while end < data.len() && data[end] != 7
                        && !(data[end] == 27 && end + 1 < data.len() && data[end + 1] == 92) {
                        end += 1;
                    }
                    if end == data.len() {
                        break
                    }
                    at = end
                        + if data[end] == 7 {
                            1
                        } else {
                            2
                        };
                    continue
                }
                at += 2;
                continue
            }
            let length = if data[at] < 0x80 {
                1
            } else if data[at] < 0xe0 {
                2
            } else if data[at] < 0xf0 {
                3
            } else {
                4
            };
            if at + length > data.len() {
                break
            }
            let text = utf8::decode_slice(data.slice(at, at + length)).map_err(|e| e.to_string())?;
            let scalar = text.chars().next().ok_or("empty scalar")?.to_u32();
            if scalar == 13 {
                state.x = 0;
                state.head = Option::None;
            } else if scalar == 10 {
                state.y = minimum(state.y + 1, state.height - 1);
                state.head = Option::None;
            } else if scalar == 0x200d || state.joined || (scalar >= 0x300 && scalar <= 0x36f)
                || scalar == 0xfe0e
                || scalar == 0xfe0f {
                if let Some(head) = state.head {
                    let cell = state.cells[head];
                    state.cells[head] = Cell { text: cell.text + text, ..cell };
                }
                state.joined = scalar == 0x200d;
            } else if scalar >= 32 && state.x < state.width && state.y < state.height {
                let width = if (scalar >= 0x2e80 && scalar <= 0x9fff)
                    || (scalar >= 0x1f300 && scalar <= 0x1faff) {
                    2
                } else {
                    1
                };
                if state.x + width <= state.width {
                    let index = state.y * state.width + state.x;
                    for column in 0..width {
                        erase(state.cells, index + column, state.width);
                    }
                    state.cells[index] = Cell {
                        text,
                        width,
                        foreground: state.foreground,
                        background: state.background,
                        attributes: state.attributes,
                    };
                    if width == 2 {
                        state.cells[index + 1] = Cell { text: "", width: 0, ..state.cells[index] };
                    }
                    state.head = Option::Some(index);
                    state.x += width;
                }
            }
            at += length;
        }
        state.pending = data.slice(at, data.len()).to_vec();
        self.state.set(state);
        Result::Ok(())
    }
}

fn erase(cells: Vec[Cell], index: isize, width: isize) -> () {
    let cell = cells[index];
    if cell.width == 0 && index % width > 0 {
        cells[index - 1] = cells[index - 1].blank();
    }
    if cell.width == 2 && index % width + 1 < width {
        cells[index + 1] = cells[index + 1].blank();
    }
    cells[index] = cell.blank();
}

fn control(state: ScreenState, parameters: string, final_byte: byte) -> Result[ScreenState, string] {
    let mut state = state;
    if parameters.starts_with("?") {
        return Result::Ok(state)
    }
    let values = Vec::new();
    for value in parameters.split(";") {
        values.push(
            if value == "" {
                0
            } else {
                num::parse_int_structured(value).map_err(|e| e.to_string())?
            },
        );
    }
    if final_byte == b'H' || final_byte == b'f' {
        state.y = bounded(values[0] - 1, state.height - 1);
        state.x = bounded(
            if values.len() > 1 {
                values[1] - 1
            } else {
                0
            },
            state.width - 1,
        );
        state.head = Option::None;
        state.joined = false;
    } else if final_byte == b'J' && (values[0] == 2 || values[0] == 3) {
        for index in 0..state.cells.len() {
            state.cells[index] = state.cells[index].blank();
        }
    } else if final_byte == b'A' {
        state.y = bounded(state.y - maximum(values[0], 1), state.height - 1);
        state.head = Option::None;
    } else if final_byte == b'K' {
        for x in 0..state.width {
            state.cells[state.y * state.width + x] = state.cells[state.y * state.width + x].blank();
        }
    } else if final_byte == b'm' {
        let mut at = 0;
        while at < values.len() {
            let value = values[at];
            match value {
                0 => {
                    state.foreground = "default";
                    state.background = "default";
                    state.attributes = 0;
                },
                1 => {
                    state.attributes |= 1;
                },
                2 => {
                    state.attributes |= 2;
                },
                3 => {
                    state.attributes |= 4;
                },
                4 => {
                    state.attributes |= 8;
                },
                5 => {
                    state.attributes |= 16;
                },
                7 => {
                    state.attributes |= 32;
                },
                8 => {
                    state.attributes |= 64;
                },
                9 => {
                    state.attributes |= 128;
                },
                53 => {
                    state.attributes |= 256;
                },
                22 => {
                    state.attributes &= ~3;
                },
                23 => {
                    state.attributes &= ~4;
                },
                24 => {
                    state.attributes &= ~8;
                },
                25 => {
                    state.attributes &= ~16;
                },
                27 => {
                    state.attributes &= ~32;
                },
                28 => {
                    state.attributes &= ~64;
                },
                29 => {
                    state.attributes &= ~128;
                },
                55 => {
                    state.attributes &= ~256;
                },
                39 => {
                    state.foreground = "default";
                },
                49 => {
                    state.background = "default";
                },
                _ => {
                    if (value >= 30 && value <= 37) || (value >= 90 && value <= 97) {
                        state.foreground = "i:"
                            + (value
                                - if value < 90 {
                                    30
                                } else {
                                    82
                                }).to_string();
                    } else if (value >= 40 && value <= 47) || (value >= 100 && value <= 107) {
                        state.background = "i:"
                            + (value
                                - if value < 100 {
                                    40
                                } else {
                                    92
                                }).to_string();
                    } else if value == 38 || value == 48 {
                        if at + 2 >= values.len() {
                            return Result::Err("truncated reference SGR")
                        }
                        let color = if values[at + 1] == 5 {
                            at += 2;
                            "i:" + values[at].to_string()
                        } else {
                            if at + 4 >= values.len() {
                                return Result::Err("truncated reference RGB")
                            }
                            at += 4;
                            "r:" + values[at - 2].to_string() + ":" + values[at - 1].to_string()
                                + ":"
                                + values[at].to_string()
                        };
                        if value == 38 {
                            state.foreground = color;
                        } else {
                            state.background = color;
                        }
                    }
                },
            }
            at += 1;
        }
    }
    Result::Ok(state)
}

fn minimum(a: isize, b: isize) -> isize {
    if a < b {
        a
    } else {
        b
    }
}

fn maximum(a: isize, b: isize) -> isize {
    if a > b {
        a
    } else {
        b
    }
}

fn bounded(value: isize, high: isize) -> isize {
    minimum(maximum(value, 0), high)
}
