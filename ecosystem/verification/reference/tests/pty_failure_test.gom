package tests;

use ecosystem::verification as application;
use std::fs;
use std::testing;

#[test]
fn missing_pty_child_releases_every_opened_descriptor() -> () {
    let binary = "/__goml_native_pty_missing_program__";
    testing::assert_err(application::verify_pty("terminal", binary));
    let before = testing::expect_ok(
        fs::read_dir_names_structured("/proc/self/fd"),
        "initial descriptors",
    ).len();
    for _ in 0..24 {
        testing::assert_err(application::verify_pty("terminal", binary));
    }
    let after = testing::expect_ok(
        fs::read_dir_names_structured("/proc/self/fd"),
        "remaining descriptors",
    ).len();
    testing::assert_eq(after, before);
}
