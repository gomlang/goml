package tests;

use ecosystem::verification::reference;
use std::json;
use std::testing;

#[test]
fn reference_json_comparison_ignores_field_order_but_preserves_integer_precision() -> () {
    let left = testing::expect_ok(
        json::parse("{\"integer\":9007199254740993,\"nested\":[true,null,\"x\"]}"),
        "left JSON",
    );
    let reordered = testing::expect_ok(
        json::parse("{\"nested\":[true,null,\"x\"],\"integer\":9007199254740993}"),
        "reordered JSON",
    );
    let rounded = testing::expect_ok(
        json::parse("{\"integer\":9007199254740992,\"nested\":[true,null,\"x\"]}"),
        "rounded JSON",
    );
    testing::assert(reference::equal(left, reordered));
    testing::assert(!reference::equal(left, rounded));
    testing::assert(!reference::equal(json::Value::Array(Vec::new()), json::Value::Null));
    reference::multiset(
        Vec::from_array([left, json::Value::Null, left]),
        Vec::from_array([reordered, reordered, json::Value::Null]),
        "repeated values",
    );
}

#[test]
fn independent_screen_preserves_fragmented_clusters_and_style_reset() -> () {
    let source = "\u001b[2;2H\u001b[1;7;38;2;1;2;3;48;5;17m界👩‍💻á\u001b[0m".to_bytes();
    for split in 0..source.len() + 1 {
        let screen = reference::Screen::new(10, 3);
        testing::assert_ok(screen.feed(source.slice(0, split)));
        testing::assert_ok(screen.feed(source.slice(split, source.len())));
        let cell = screen.cell(1, 1);
        testing::assert_eq(cell.text, "界");
        testing::assert_eq(cell.width, 2);
        testing::assert_eq(cell.attributes, 33);
        testing::assert_eq(cell.foreground, "r:1:2:3");
        testing::assert_eq(cell.background, "i:17");
        testing::assert_eq(screen.cell(2, 1).width, 0);
        testing::assert_eq(screen.cell(3, 1).text, "👩‍💻");
        testing::assert_eq(screen.cell(4, 1).width, 0);
        testing::assert_eq(screen.cell(5, 1).text, "á");
        testing::assert(screen.highlighted("界👩‍💻á"));
        testing::assert_eq(screen.attributes(), 0);
        testing::assert_eq(screen.foreground(), "default");
        testing::assert_eq(screen.background(), "default");
    }
}

#[test]
fn independent_screen_erases_wide_overlap_and_separates_sequences_from_text() -> () {
    let screen = reference::Screen::new(6, 2);
    testing::assert_ok(screen.feed("界\u001b[1;2Hx".to_bytes().as_slice()));
    testing::assert_eq(screen.cell(0, 0).text, " ");
    testing::assert_eq(screen.cell(0, 0).width, 1);
    testing::assert_eq(screen.cell(1, 0).text, "x");
    testing::assert_ok(
        screen.feed(
            "\u001b[2;1H中\u001b]8;;https://example.org\u001b\\ok\u001b]8;;\u001b\\".to_bytes().as_slice(),
        ),
    );
    testing::assert_eq(screen.cell(0, 1).text, "中");
    testing::assert_eq(screen.cell(2, 1).text, "o");
    testing::assert_eq(screen.cell(3, 1).text, "k");
    testing::assert_ok(screen.feed("\u001b[2J".to_bytes().as_slice()));
    testing::assert_eq(screen.text(), "      \n      ");
    testing::assert_err(screen.feed(Vec::from_array([255.to_u8(), 0, 0, 0]).as_slice()));
}

#[test]
fn stripped_history_exposes_character_by_character_secret_even_after_erasure() -> () {
    let secret = "SENSITIVE_PASSWORD";
    let mut captured = "";
    let mut column = 1;
    for character in secret.chars() {
        captured += "\u001b[2;" + column.to_string() + "H\u001b[31m" + character.to_string()
            + "\u001b[0m";
        column += 1;
    }
    captured += "\u001b[2J\u001b[Hsafe screen";
    testing::assert(!captured.contains(secret));
    testing::assert(reference::strip_csi(captured).contains(secret));
    testing::assert_eq(reference::strip_csi("中\u001b[?25l\u001b[2 q文\u001b[0mé"), "中文é");
    testing::assert_eq(reference::strip_csi("x\u001b[31"), "x\u001b[31");
    testing::assert_eq(reference::strip_csi("x\u001b[12\ny"), "x\u001b[12\ny");
}
