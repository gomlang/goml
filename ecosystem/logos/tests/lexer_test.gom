package tests;

use ecosystem::logos;
use std::num;
use std::task;
use std::testing;

fn same[T: PartialEq](actual: T, expected: T) -> () {
    testing::assert(actual == expected);
}

#[derive(Debug, PartialEq)]
enum Token {
    Let,
    Identifier(string),
    Number(isize),
    Symbol(string),
}

fn grammar() -> logos::Grammar[Token, isize, string] {
    let rules: Vec[logos::Rule[Token, isize, string]] = Vec::from_array(
        [
            logos::Rule::token("let", Token::Let),
            logos::Rule::regex(
                "[a-zA-Z_][a-zA-Z0-9_]*",
                |ctx| logos::Action::Emit(Token::Identifier(ctx.slice())),
            ),
            logos::Rule::regex(
                "[0-9]+",
                |ctx| match num::parse_int_structured(ctx.slice()) {
                    Ok(value) => logos::Action::Emit(Token::Number(value)),
                    Err(error) => logos::Action::Error(error.to_string()),
                },
            ),
            logos::Rule::regex("[=+]", |ctx| logos::Action::Emit(Token::Symbol(ctx.slice()))),
            logos::Rule::regex(
                "[ \\t\\r\\n]+",
                |ctx| {
                    ctx.set_extras(ctx.extras() + 1);
                    logos::Action::Skip
                },
            ),
        ],
    );
    testing::expect_ok(logos::Grammar::compile(rules), "compile language")
}

fn take(lexer: logos::Lexer[Token, isize, string]) -> Token {
    testing::expect_ok(testing::expect_some(lexer.next(), "token"), "valid token")
}

fn regex(pattern: string) -> logos::Grammar[string, (), string] {
    testing::expect_ok(
        logos::Grammar::compile(
            Vec::from_array([logos::Rule::regex(pattern, |ctx| logos::Action::Emit(ctx.slice()))]),
        ),
        "compile regex",
    )
}

#[test]
fn maximal_munch_keyword_priority_and_spans() -> () {
    let grammar = grammar();
    same(grammar.rule_count(), 5);
    testing::assert(grammar.state_count() > 5);
    let lexer = grammar.lexer("let letter = 123 + x", 0);
    same(take(lexer), Token::Let);
    same(lexer.span(), logos::Span { start: 0, end: 3 });
    same(lexer.slice(), "let");
    same(lexer.remainder(), " letter = 123 + x");
    same(take(lexer), Token::Identifier("letter"));
    same(take(lexer), Token::Symbol("="));
    same(take(lexer), Token::Number(123));
    same(take(lexer), Token::Symbol("+"));
    same(take(lexer), Token::Identifier("x"));
    same(lexer.extras(), 5);
    testing::assert_none(lexer.next());
    testing::assert_none(lexer.next());
    same(lexer.span(), logos::Span { start: 20, end: 20 });
}

#[test]
fn longest_alternative_optional_bounded_and_nullable_loops() -> () {
    for entry in Vec::from_array(
        [
            ("a|abcd|ab", "abcd!", "abcd"),
            ("(a|ab)c?", "abc", "abc"),
            ("ab{2,4}", "abbbbb", "abbbb"),
            ("(?:ab){2}", "ababab", "abab"),
            ("ab{2,}", "abbbb", "abbbb"),
            ("(a?)*b", "aaab", "aaab"),
            ("(a|)*b", "b", "b"),
            ("a{0}b", "b", "b"),
            ("(x{0}){1000}a", "a", "a"),
        ],
    ) {
        let lexer = regex(entry.0).lexer(entry.1, ());
        same(
            testing::expect_ok(testing::expect_some(lexer.next(), "match"), "regex match"),
            entry.2,
        );
        same(lexer.slice(), entry.2);
    }
}

#[test]
fn partial_error_recovery_and_unicode_boundaries() -> () {
    let grammar: logos::Grammar[string, (), string] = testing::expect_ok(
        logos::Grammar::compile(
            Vec::from_array([logos::Rule::token("abcd", "long"), logos::Rule::token("!", "bang")]),
        ),
        "compile prefix",
    );
    let lexer = grammar.lexer("ab!😀!", ());
    same(lexer.next(), Option::Some(Result::Err(logos::LexError::Unexpected)));
    same(lexer.slice(), "ab");
    same(lexer.next(), Option::Some(Result::Ok("bang")));
    same(lexer.next(), Option::Some(Result::Err(logos::LexError::Unexpected)));
    same(lexer.span(), logos::Span { start: 3, end: 7 });
    same(lexer.next(), Option::Some(Result::Ok("bang")));
    let letters = regex("\\p{L}+").lexer("é中λ!", ());
    same(letters.next(), Option::Some(Result::Ok("é中λ")));
    same(letters.span(), logos::Span { start: 0, end: 7 });
    testing::assert_err(grammar.lexer_at("é", 1, ()));
    testing::assert_err(grammar.lexer_at("é", -1, ()));
    testing::assert_err(grammar.lexer_at("é", 3, ()));
    let end = testing::expect_ok(grammar.lexer_at("é", 2, ()), "end boundary");
    testing::assert_none(end.next());
}

#[test]
fn explicit_priority_and_ambiguity_are_recoverable() -> () {
    let rules: Vec[logos::Rule[string, (), string]] = Vec::from_array(
        [
            logos::Rule::token("ab", "first"),
            logos::Rule::token("ab", "second"),
            logos::Rule::token("abc", "long").with_priority(0),
        ],
    );
    let grammar = testing::expect_ok(
        logos::Grammar::compile(rules),
        "ambiguity checked at matching",
    );
    let lexer = grammar.lexer("abcab", ());
    same(lexer.next(), Option::Some(Result::Ok("long")));
    match testing::expect_err(testing::expect_some(lexer.next(), "ambiguous match"), "ambiguity") {
        Ambiguous(indices) => testing::assert(indices == Vec::from_array([0, 1])),
        _ => testing::fail("expected ambiguous indices"),
    }
    same(lexer.slice(), "ab");
    rules[1] = rules[1].with_priority(10);
    let resolved = testing::expect_ok(logos::Grammar::compile(rules), "explicit priority").lexer(
        "ab",
        (),
    );
    same(resolved.next(), Option::Some(Result::Ok("second")));
    let original = grammar.lexer("ab", ());
    testing::assert_err(testing::expect_some(original.next(), "immutable rules"));
}

#[test]
fn callbacks_skip_error_extras_and_checked_bump() -> () {
    let rules: Vec[logos::Rule[string, isize, string]] = Vec::from_array(
        [
            logos::Rule::literal(
                "\"",
                |ctx| {
                    let remainder = ctx.remainder();
                    for (offset, ch) in remainder.char_indices() {
                        if ch == '"' {
                            testing::assert_ok(ctx.bump(offset + 1));
                            ctx.set_extras(ctx.extras() + 1);
                            return logos::Action::Emit(ctx.slice())
                        }
                    }
                    testing::assert_ok(ctx.bump(remainder.byte_len()));
                    logos::Action::Error("unclosed string")
                },
            ),
            logos::Rule::skip(" +"),
        ],
    );
    let lexer = testing::expect_ok(logos::Grammar::compile(rules), "callback grammar").lexer(
        "\"é😀\" \"oops",
        0,
    );
    same(lexer.next(), Option::Some(Result::Ok("\"é😀\"")));
    same(lexer.span(), logos::Span { start: 0, end: 8 });
    same(lexer.extras(), 1);
    same(lexer.next(), Option::Some(Result::Err(logos::LexError::Callback("unclosed string"))));
    same(lexer.slice(), "\"oops");
    testing::assert_none(lexer.next());
    let lexer = regex(".").lexer("é😀a", ());
    testing::assert_err(lexer.bump(-1));
    testing::assert_err(lexer.bump(1));
    testing::assert_err(lexer.bump(8));
    same(lexer.span(), logos::Span { start: 0, end: 0 });
    testing::assert_ok(lexer.bump(2));
    same(lexer.next(), Option::Some(Result::Ok("😀")));
}

#[test]
fn flags_classes_escapes_and_properties() -> () {
    for entry in Vec::from_array(
        [
            ("[a-cx-z-]+", "abcxyz-", "abcxyz-"),
            ("[^0-9]+", "é中A1", "é中A"),
            ("\\w+", "abc_12é", "abc_12"),
            ("\\d+", "012٣", "012"),
            ("[\\dA-F]+", "ABC123Z", "ABC123"),
            ("\\x41\\u0042\\u{1f600}", "AB😀", "AB😀"),
            ("\\p{Number}+", "١Ⅷ7!", "١Ⅷ7"),
            ("\\P{ASCII}+", "é中a", "é中"),
            ("[^\\p{L}]+", "123!a", "123!"),
            ("\\p{White_Space}+", "\u2003 \tA", "\u2003 \t"),
            ("\\p{Lowercase}+", "éabA", "éab"),
            ("\\p{Uppercase}+", "ÉABa", "ÉAB"),
            ("\\D+", "abc1", "abc"),
            ("\\W+", "é!a", "é!"),
            ("\\S+", "é! a", "é!"),
        ],
    ) {
        same(regex(entry.0).lexer(entry.1, ()).next(), Option::Some(Result::Ok(entry.2)));
    }
    let rules: Vec[logos::Rule[string, (), string]] = Vec::from_array(
        [logos::Rule::regex("[A-Z]+", |ctx| logos::Action::Emit(ctx.slice())).ignore_ascii_case()],
    );
    same(
        testing::expect_ok(logos::Grammar::compile(rules), "ignore case").lexer("AbC", ()).next(),
        Option::Some(Result::Ok("AbC")),
    );
    let rules: Vec[logos::Rule[string, (), string]] = Vec::from_array(
        [logos::Rule::regex(".+", |ctx| logos::Action::Emit(ctx.slice())).with_dot_all()],
    );
    same(
        testing::expect_ok(logos::Grammar::compile(rules), "dot all").lexer("a\nb", ()).next(),
        Option::Some(Result::Ok("a\nb")),
    );
    same(regex(".+").lexer("a\nb", ()).next(), Option::Some(Result::Ok("a")));
}

#[test]
fn positions_forks_iterators_and_mode_switching() -> () {
    let lexer = grammar().lexer("x\n  y", 0);
    same(take(lexer), Token::Identifier("x"));
    let fork = lexer.fork();
    same(take(lexer), Token::Identifier("y"));
    same(lexer.position(), logos::Position { line: 2, column: 3 });
    same(fork.remainder(), "\n  y");
    same(fork.extras(), 0);
    same(lexer.extras(), 1);
    same(take(fork), Token::Identifier("y"));
    let modes: logos::Grammar[string, isize, string] = testing::expect_ok(
        logos::Grammar::compile(
            Vec::from_array([logos::Rule::regex(".+", |ctx| logos::Action::Emit(ctx.slice()))]),
        ),
        "second mode",
    );
    let lexer = grammar().lexer("let contents!", 0);
    same(take(lexer), Token::Let);
    let other = lexer.morph(modes);
    same(other.next(), Option::Some(Result::Ok(" contents!")));
    same(lexer.remainder(), "");
    let items = regex(".").lexer("é中", ()).spanned();
    let first = testing::expect_some(items.next(), "first");
    same(first.0, Result::Ok("é"));
    same(first.1, logos::Span { start: 0, end: 2 });
    let second = testing::expect_some(items.next(), "second");
    same(second.1, logos::Span { start: 2, end: 5 });
    testing::assert_none(items.next());
    let mut count = 0;
    for value in regex(".").lexer("abc", ()) {
        testing::assert_ok(value);
        count += 1;
    }
    same(count, 3);
}

#[test]
fn rejected_patterns_have_rule_and_byte_diagnostics() -> () {
    for pattern in Vec::from_array(
        [
            "",
            "a*",
            "a?",
            "(a|)",
            "[",
            "[]",
            "[z-a]",
            "[a&&b]",
            "[a--b]",
            "[a~~b]",
            "[\\w-z]",
            "(",
            ")",
            "a{3,2}",
            "a{",
            "a{1025}",
            "a**",
            "a+?",
            "(?=a)",
            "^a",
            "a$",
            "\\b",
            "\\1",
            "\\p{Script}",
            "\\u{d800}",
            "\\xGG",
            "\\",
        ],
    ) {
        let rules: Vec[logos::Rule[string, (), string]] = Vec::from_array(
            [
                logos::Rule::token("ok", "ok"),
                logos::Rule::regex(pattern, |ctx| logos::Action::Emit(ctx.slice())),
            ],
        );
        let error = testing::expect_err(logos::Grammar::compile(rules), pattern);
        same(error.rule, 1);
        testing::assert(error.offset >= 0 && error.offset <= pattern.byte_len());
        testing::assert(error.message.byte_len() > 0);
    }
    let empty: Vec[logos::Rule[string, (), string]] = Vec::new();
    testing::assert_err(logos::Grammar::compile(empty));
    let rules: Vec[logos::Rule[string, (), string]] = Vec::from_array(
        [logos::Rule::token("", "empty")],
    );
    testing::assert_err(logos::Grammar::compile(rules));
}

#[test]
fn compile_and_runtime_budgets_ensure_progress() -> () {
    let rules: Vec[logos::Rule[string, (), string]] = Vec::from_array(
        [logos::Rule::regex("(ab){100}", |ctx| logos::Action::Emit(ctx.slice()))],
    );
    testing::assert_err(
        logos::Grammar::compile_with(
            rules,
            logos::Options { max_states: 20, ..logos::Options::new() },
        ),
    );
    testing::assert_err(
        logos::Grammar::compile_with(
            rules,
            logos::Options { max_pattern_bytes: 3, ..logos::Options::new() },
        ),
    );
    let rules: Vec[logos::Rule[string, (), string]] = Vec::from_array(
        [logos::Rule::regex("(((a)))", |ctx| logos::Action::Emit(ctx.slice()))],
    );
    testing::assert_err(
        logos::Grammar::compile_with(
            rules,
            logos::Options { max_depth: 2, ..logos::Options::new() },
        ),
    );
    let rules: Vec[logos::Rule[string, (), string]] = Vec::from_array(
        [logos::Rule::regex("((){1000}){1000}a", |ctx| logos::Action::Emit(ctx.slice()))],
    );
    testing::assert_err(
        logos::Grammar::compile_with(
            rules,
            logos::Options { max_states: 20, ..logos::Options::new() },
        ),
    );
    let rules: Vec[logos::Rule[string, (), string]] = Vec::from_array(
        [logos::Rule::regex("a+", |ctx| logos::Action::Emit(ctx.slice()))],
    );
    let lexer = testing::expect_ok(
        logos::Grammar::compile_with(
            rules,
            logos::Options { max_token_bytes: 3, ..logos::Options::new() },
        ),
        "token budget",
    ).lexer("aaaaa", ());
    same(lexer.next(), Option::Some(Result::Err(logos::LexError::BudgetExceeded)));
    same(lexer.slice(), "aaa");
    same(lexer.next(), Option::Some(Result::Ok("aa")));
    let rules: Vec[logos::Rule[string, (), string]] = Vec::from_array([logos::Rule::skip(".")]);
    let lexer = testing::expect_ok(
        logos::Grammar::compile_with(
            rules,
            logos::Options { max_work: 10, ..logos::Options::new() },
        ),
        "work budget",
    ).lexer("abcdef", ());
    same(lexer.next(), Option::Some(Result::Err(logos::LexError::BudgetExceeded)));
    testing::assert(lexer.span().end > 0 && lexer.span().end <= 6);
    let rules: Vec[logos::Rule[string, (), string]] = Vec::from_array(
        [logos::Rule::token("😀", "emoji")],
    );
    let lexer = testing::expect_ok(
        logos::Grammar::compile_with(
            rules,
            logos::Options { max_token_bytes: 1, ..logos::Options::new() },
        ),
        "UTF-8 budget",
    ).lexer("😀", ());
    same(lexer.next(), Option::Some(Result::Err(logos::LexError::BudgetExceeded)));
    same(lexer.span(), logos::Span { start: 0, end: 4 });
}

#[test]
fn nfa_handles_adversarial_alternation_without_backtracking() -> () {
    let parts: Vec[string] = Vec::new();
    for _ in 0..2000 {
        parts.push("a");
    }
    parts.push("b");
    let source = parts.join("");
    let lexer = regex("(a|aa)+b").lexer(source, ());
    same(lexer.next(), Option::Some(Result::Ok(source)));
    testing::assert_none(lexer.next());
}

#[test]
fn independent_lexers_share_an_immutable_grammar() -> () {
    let grammar = grammar();
    task::scope(
        |scope| {
            let results: Channel[bool] = Channel::new(8);
            for _ in 0..8 {
                scope.spawn(
                    |_| {
                        let lexer = grammar.lexer("let a = 1", 0);
                        let tokens: Vec[Token] = Vec::new();
                        for result in lexer {
                            match result {
                                Ok(token) => tokens.push(token),
                                Err(_) => {
                                    results.send(false);
                                    return
                                },
                            }
                        }
                        results.send(
                            tokens
                                == Vec::from_array(
                                    [
                                        Token::Let,
                                        Token::Identifier("a"),
                                        Token::Symbol("="),
                                        Token::Number(1),
                                    ],
                                )
                                && lexer.extras() == 3,
                        );
                    },
                );
            }
            for _ in 0..8 {
                testing::assert(testing::expect_some(results.recv(), "worker result"));
            }
        },
    );
}
