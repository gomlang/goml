package logos;

pub struct Lexer[T, X, E] {
    grammar: Grammar[T, X, E],
    context: Context[X],
}

impl[T, X, E] Lexer[T, X, E] {
    pub fn source(self: Lexer[T, X, E]) -> string {
        self.context.source()
    }

    pub fn span(self: Lexer[T, X, E]) -> Span {
        self.context.span()
    }

    pub fn slice(self: Lexer[T, X, E]) -> string {
        self.context.slice()
    }

    pub fn remainder(self: Lexer[T, X, E]) -> string {
        self.context.remainder()
    }

    pub fn position(self: Lexer[T, X, E]) -> Position {
        self.context.position()
    }

    pub fn extras(self: Lexer[T, X, E]) -> X {
        self.context.extras()
    }

    pub fn set_extras(self: Lexer[T, X, E], extras: X) -> () {
        self.context.set_extras(extras);
    }

    pub fn bump(self: Lexer[T, X, E], bytes: isize) -> Result[(), string] {
        self.context.bump(bytes)
    }

    pub fn next(self: Lexer[T, X, E]) -> Option[Result[T, LexError[E]]] {
        let work = Ref::new(0);
        loop {
            let start = self.span().end;
            if start == self.source().byte_len() {
                self.context.cursor.set(Span { start, end: start });
                return Option::None
            }
            let scanned = scan(self.grammar, self.source(), start, work);
            let end = match scanned {
                Match(end, _) | Ambiguous(end, _) | Unexpected(end) | Budget(end) => end,
            };
            self.context.cursor.set(Span { start, end });
            match scanned {
                Match(_, rule) => {
                    let callback = self.grammar.rules.get(rule).callback;
                    match callback(self.context) {
                        Emit(value) => return Option::Some(Result::Ok(value)),
                        Skip => (),
                        Error(error) => return Option::Some(Result::Err(LexError::Callback(error))),
                    }
                },
                Ambiguous(_, rules) => return Option::Some(Result::Err(LexError::Ambiguous(rules))),
                Unexpected(_) => return Option::Some(Result::Err(LexError::Unexpected)),
                Budget(_) => return Option::Some(Result::Err(LexError::BudgetExceeded)),
            }
        }
    }

    pub fn spanned(self: Lexer[T, X, E]) -> FnIterator[(Result[T, LexError[E]], Span)] {
        FnIterator::from_fn(|| self.next().map(|value| (value, self.span())))
    }

    pub fn fork(self: Lexer[T, X, E]) -> Lexer[T, X, E] {
        Lexer {
            grammar: self.grammar,
            context: Context {
                source: self.source(),
                cursor: Ref::new(self.span()),
                extras: Ref::new(self.extras()),
            },
        }
    }

    pub fn morph[U, F](self: Lexer[T, X, E], grammar: Grammar[U, X, F]) -> Lexer[U, X, F] {
        Lexer { grammar, context: self.context }
    }
}

impl[T, X, E] Iterator for Lexer[T, X, E] {
    type Item = Result[T, LexError[E]];

    fn next(self: Lexer[T, X, E]) -> Option[Result[T, LexError[E]]] {
        Lexer::next(self)
    }
}
