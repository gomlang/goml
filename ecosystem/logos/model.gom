package logos;

#[derive(Debug, PartialEq)]
pub struct Span {
    pub start: isize,
    pub end: isize,
}

#[derive(Debug, PartialEq)]
pub struct Position {
    pub line: isize,
    pub column: isize,
}

#[derive(Debug, PartialEq)]
pub struct CompileError {
    pub rule: isize,
    pub offset: isize,
    pub message: string,
}

impl ToString for CompileError {
    fn to_string(self: CompileError) -> string {
        "rule " + self.rule.to_string() + " at byte " + self.offset.to_string() + ": "
            + self.message
    }
}

#[derive(PartialEq)]
pub enum LexError[E] {
    Unexpected,
    Ambiguous(Vec[isize]),
    Callback(E),
    BudgetExceeded,
}

impl[E: Debug] Debug for LexError[E] {
    fn debug(self: LexError[E]) -> string {
        match self {
            Unexpected => "Unexpected",
            Ambiguous(rules) => {
                let parts: Vec[string] = Vec::new();
                for rule in rules {
                    parts.push(rule.to_string());
                }
                "Ambiguous(" + parts.join(", ") + ")"
            },
            Callback(error) => "Callback(" + error.debug() + ")",
            BudgetExceeded => "BudgetExceeded",
        }
    }
}

pub enum Action[T, E] {
    Emit(T),
    Skip,
    Error(E),
}

pub struct Options {
    pub max_pattern_bytes: isize,
    pub max_depth: isize,
    pub max_repeat: isize,
    pub max_states: isize,
    pub max_token_bytes: isize,
    pub max_work: isize,
}

impl Options {
    pub fn new() -> Options {
        Options {
            max_pattern_bytes: 65536,
            max_depth: 64,
            max_repeat: 1024,
            max_states: 16384,
            max_token_bytes: 1048576,
            max_work: 10000000,
        }
    }
}

enum Pattern {
    Literal(string),
    Regex(string),
}

pub struct Rule[T, X, E] {
    pattern: Pattern,
    priority: Option[isize],
    ignore_case: bool,
    dot_all: bool,
    callback: (Context[X]) -> Action[T, E],
}

impl[T, X, E] Rule[T, X, E] {
    pub fn token(text: string, value: T) -> Rule[T, X, E] {
        Rule::literal(text, |_| Action::Emit(value))
    }

    pub fn literal(text: string, callback: (Context[X]) -> Action[T, E]) -> Rule[T, X, E] {
        Rule {
            pattern: Pattern::Literal(text),
            priority: Option::None,
            ignore_case: false,
            dot_all: false,
            callback,
        }
    }

    pub fn regex(pattern: string, callback: (Context[X]) -> Action[T, E]) -> Rule[T, X, E] {
        Rule {
            pattern: Pattern::Regex(pattern),
            priority: Option::None,
            ignore_case: false,
            dot_all: false,
            callback,
        }
    }

    pub fn skip(pattern: string) -> Rule[T, X, E] {
        Rule::regex(pattern, |_| Action::Skip)
    }

    pub fn with_priority(self: Rule[T, X, E], priority: isize) -> Rule[T, X, E] {
        Rule { priority: Option::Some(priority), ..self }
    }

    pub fn ignore_ascii_case(self: Rule[T, X, E]) -> Rule[T, X, E] {
        Rule { ignore_case: true, ..self }
    }

    pub fn with_dot_all(self: Rule[T, X, E]) -> Rule[T, X, E] {
        Rule { dot_all: true, ..self }
    }
}

pub struct Context[X] {
    source: string,
    cursor: Ref[Span],
    extras: Ref[X],
}

fn next_boundary(source: string, offset: isize) -> isize {
    let mut next = offset + 1;
    while next < source.byte_len() && !source.is_char_boundary(next) {
        next += 1;
    }
    next
}

impl[X] Context[X] {
    pub fn source(self: Context[X]) -> string {
        self.source
    }

    pub fn span(self: Context[X]) -> Span {
        self.cursor.get()
    }

    pub fn slice(self: Context[X]) -> string {
        let span = self.span();
        self.source.byte_slice(span.start, span.end)
    }

    pub fn remainder(self: Context[X]) -> string {
        self.source.byte_slice(self.span().end, self.source.byte_len())
    }

    pub fn extras(self: Context[X]) -> X {
        self.extras.get()
    }

    pub fn set_extras(self: Context[X], value: X) -> () {
        self.extras.set(value);
    }

    pub fn bump(self: Context[X], bytes: isize) -> Result[(), string] {
        let span = self.span();
        if bytes < 0 || bytes > self.source.byte_len() - span.end {
            return Result::Err("bump is outside the source")
        }
        let end = span.end + bytes;
        if !self.source.is_char_boundary(end) {
            return Result::Err("bump must end at a UTF-8 boundary")
        }
        self.cursor.set(Span { end, ..span });
        Result::Ok(())
    }

    pub fn position(self: Context[X]) -> Position {
        let mut line = 1;
        let mut column = 1;
        let mut offset = 0;
        while offset < self.span().start {
            if self.source.get(offset) == '\n' {
                line += 1;
                column = 1;
            } else {
                column += 1;
            }
            offset = next_boundary(self.source, offset);
        }
        Position { line, column }
    }
}
