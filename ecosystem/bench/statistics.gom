package bench;

use std::math;
use std::context;
use std::num::{ToFloat, TryToInt};
use std::rand;

fn sorted(values: Vec[f64]) -> Vec[f64] {
    let result = values.copy();
    result.sort_by(
        |left, right| if left < right {
            -1
        } else if left > right {
            1
        } else {
            0
        },
    );
    result
}

fn quantile(values: Vec[f64], probability: f64) -> f64 {
    let index = (values.len() - 1).to_f64() * probability;
    let lower = math::floor(index).try_to_isize().unwrap_or(0);
    let upper = if lower + 1 < values.len() {
        lower + 1
    } else {
        lower
    };
    values[lower] + (values[upper] - values[lower]) * (index - lower.to_f64())
}

fn mean(values: Vec[f64]) -> f64 {
    let mut result = 0.0;
    for index in 0..values.len() {
        result += (values[index] - result) / (index + 1).to_f64();
    }
    result
}

pub fn bootstrap_mean_with(
    values: Vec[f64],
    resamples: isize,
    confidence: f64,
    seed: u64,
    control: context::Context,
) -> Result[Interval, Error] {
    if values.len() < 2 || values.len() > 10000 || resamples < 20 || resamples > 100000
        || values.len().to_u64() * resamples.to_u64() > 20000000
        || !math::is_finite(confidence)
        || confidence <= 0.5
        || confidence >= 1.0 {
        return Result::Err(error(ErrorKind::Data, "invalid bootstrap options"))
    }
    for value in values {
        if !math::is_finite(value) || value <= 0.0 {
            return Result::Err(error(ErrorKind::Data, "samples must be positive finite values"))
        }
    }
    let mut state = seed;
    let means = Vec::with_capacity(resamples);
    check_context(control)?;
    for resample in 0..resamples {
        if resample % 32 == 0 {
            check_context(control)?;
        }
        let mut current = 0.0;
        for index in 0..values.len() {
            state = rand::next_u64(state);
            let value = values[(state % values.len().to_u64()).to_isize()];
            current += (value - current) / (index + 1).to_f64();
        }
        means.push(current);
    }
    let ordered = sorted(means);
    let tail = (1.0 - confidence) / 2.0;
    Result::Ok(
        Interval {
            lower: quantile(ordered, tail),
            estimate: mean(values),
            upper: quantile(ordered, 1.0 - tail),
        },
    )
}

pub fn analyze_with(samples: Vec[Sample], options: Options, control: context::Context) -> Result[
    Statistics,
    Error,
] {
    check_context(control)?;
    options.validate()?;
    if samples.len() < 2 || samples.len() > 10000 {
        return Result::Err(error(ErrorKind::Data, "statistics require 2 to 10000 samples"))
    }
    let values = Vec::with_capacity(samples.len());
    let mut xy = 0.0;
    let mut xx = 0.0;
    for sample in samples {
        if sample.iterations == 0 || sample.elapsed_ns <= 0 {
            return Result::Err(
                error(ErrorKind::Data, "sample iterations and elapsed time must be positive"),
            )
        }
        values.push(sample.elapsed_ns.to_f64() / sample.iterations.to_f64());
        let x = sample.iterations.to_f64();
        xy += x * sample.elapsed_ns.to_f64();
        xx += x * x;
    }
    let interval = bootstrap_mean_with(
        values,
        options.bootstrap_resamples,
        options.confidence,
        options.seed,
        control,
    )?;
    let ordered = sorted(values);
    let median = quantile(ordered, 0.5);
    let deviations = Vec::new();
    let mut squares = 0.0;
    for value in values {
        let difference = value - interval.estimate;
        squares += difference * difference;
        deviations.push(
            if value > median {
                value - median
            } else {
                median - value
            },
        );
    }
    let q1 = quantile(ordered, 0.25);
    let q3 = quantile(ordered, 0.75);
    let spread = q3 - q1;
    let mut mild = 0;
    let mut severe = 0;
    for value in values {
        if value < q1 - 3.0 * spread || value > q3 + 3.0 * spread {
            severe += 1;
        } else if value < q1 - 1.5 * spread || value > q3 + 1.5 * spread {
            mild += 1;
        }
    }
    Result::Ok(
        Statistics {
            mean: interval,
            median,
            min: ordered[0],
            max: ordered[ordered.len() - 1],
            standard_deviation: math::sqrt(squares / (values.len() - 1).to_f64()),
            median_absolute_deviation: quantile(sorted(deviations), 0.5),
            mild_outliers: mild,
            severe_outliers: severe,
            slope_ns: xy / xx,
        },
    )
}

pub fn bootstrap_mean(values: Vec[f64], resamples: isize, confidence: f64, seed: u64) -> Result[
    Interval,
    Error,
] {
    bootstrap_mean_with(values, resamples, confidence, seed, context::Context::background())
}

pub fn analyze(samples: Vec[Sample], options: Options) -> Result[Statistics, Error] {
    analyze_with(samples, options, context::Context::background())
}
