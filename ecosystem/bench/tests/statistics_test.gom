package tests;

use ecosystem::bench;
use bench::{Options, Sample, Report, SuiteReport, Throughput, Timing, Change};
use std::testing;
use std::math;

fn options() -> Options {
    Options {
        warmup_ns: 25,
        measurement_ns: 400,
        samples: 4,
        max_iterations: 100,
        max_total_iterations: 10000,
        max_wall_ns: 1000000,
        bootstrap_resamples: 200,
        seed: 17,
        ..Options::standard(),
    }
}

fn must[T](value: Result[T, bench::Error]) -> T {
    testing::expect_ok(value, "benchmark")
}

fn report(values: Vec[i64]) -> Report {
    let samples = Vec::new();
    for value in values {
        samples.push(Sample { iterations: 1, elapsed_ns: value });
    }
    let configured = Options { samples: values.len(), ..options() };
    Report {
        group: "algorithms",
        name: "sort",
        parameter: "32",
        throughput: Throughput::Elements(32),
        timing: Timing::Batch,
        samples,
        statistics: must(bench::analyze(samples, configured)),
        warmup_iterations: 1,
        total_iterations: (values.len() + 1).to_u64(),
        elapsed_wall_ns: 1000,
        checksum: 5,
        options: configured,
    }
}

#[test]
fn fixed_statistics_bootstrap_replay_and_input_immutability() -> () {
    let values = Vec::from_array(
        [
            Sample { iterations: 1, elapsed_ns: 10 },
            Sample { iterations: 2, elapsed_ns: 40 },
            Sample { iterations: 3, elapsed_ns: 90 },
            Sample { iterations: 4, elapsed_ns: 160 },
        ],
    );
    let result = must(bench::analyze(values, options()));
    testing::assert_eq(result.mean.estimate, 25.0);
    testing::assert_eq(result.median, 25.0);
    testing::assert_eq(result.min, 10.0);
    testing::assert_eq(result.max, 40.0);
    let deviation_error = math::sqrt(166.66666666666666) - result.standard_deviation;
    testing::assert(deviation_error > -0.000001 && deviation_error < 0.000001);
    testing::assert_eq(result.median_absolute_deviation, 10.0);
    testing::assert_eq(result.slope_ns, 1000.0 / 30.0);
    testing::assert(result.mean.lower <= 25.0 && result.mean.upper >= 25.0);
    let again = must(bench::analyze(values, options()));
    testing::assert_eq(result.mean.lower, again.mean.lower);
    testing::assert_eq(result.mean.upper, again.mean.upper);
    testing::assert_eq(values[0].elapsed_ns, 10);
    let constant = must(bench::bootstrap_mean(Vec::from_array([7.0, 7.0, 7.0]), 100, 0.95, 2));
    testing::assert_eq(constant.lower, 7.0);
    testing::assert_eq(constant.upper, 7.0);
}

#[test]
fn outliers_stay_in_statistics_and_bad_samples_are_recoverable() -> () {
    let baseline = report(Vec::from_array([10, 10, 10, 10, 10, 10, 10, 10, 100]));
    testing::assert_eq(baseline.statistics.severe_outliers, 1);
    testing::assert_eq(baseline.statistics.mean.estimate, 20.0);
    testing::assert(
        bench::analyze(
            Vec::from_array(
                [Sample { iterations: 0, elapsed_ns: 1 }, Sample { iterations: 1, elapsed_ns: 1 }],
            ),
            options(),
        ).is_err(),
    );
    testing::assert(
        bench::analyze(
            Vec::from_array(
                [Sample { iterations: 1, elapsed_ns: 0 }, Sample { iterations: 1, elapsed_ns: 1 }],
            ),
            options(),
        ).is_err(),
    );
    testing::assert(
        bench::bootstrap_mean(Vec::from_array([math::sqrt(-1.0), 1.0]), 20, 0.95, 1).is_err(),
    );
    testing::assert(bench::bootstrap_mean(Vec::from_array([1.0, 2.0]), 0, 0.95, 1).is_err());
    testing::assert_eq(
        must(bench::throughput_per_second(Throughput::Bytes(100), 10.0)),
        10000000000.0,
    );
    testing::assert(bench::throughput_per_second(Throughput::None, 10.0).is_err());
    testing::assert(bench::throughput_per_second(Throughput::Bytes(1), 0.0).is_err());
}

#[test]
fn baseline_classification_and_identity_checks() -> () {
    let baseline = report(Vec::from_array([100, 100, 100, 100]));
    testing::assert_eq(
        must(bench::compare(baseline, report(Vec::from_array([120, 120, 120, 120])))).change,
        Change::Regressed,
    );
    testing::assert_eq(
        must(bench::compare(baseline, report(Vec::from_array([80, 80, 80, 80])))).change,
        Change::Improved,
    );
    testing::assert_eq(
        must(bench::compare(baseline, report(Vec::from_array([101, 101, 101, 101])))).change,
        Change::WithinNoise,
    );
    testing::assert_eq(
        must(bench::compare(baseline, report(Vec::from_array([30, 100, 100, 200])))).change,
        Change::Inconclusive,
    );
    testing::assert(bench::compare(baseline, Report { parameter: "64", ..baseline }).is_err());
    testing::assert(
        bench::compare(baseline, Report { throughput: Throughput::Bytes(32), ..baseline }).is_err(),
    );
    testing::assert(
        bench::compare(baseline, Report { timing: Timing::PerIteration, ..baseline }).is_err(),
    );
}

#[test]
fn json_roundtrip_schema_limits_and_html_escaping() -> () {
    let baseline = report(Vec::from_array([10, 10, 10, 10]));
    let suite = SuiteReport {
        schema: 1,
        reports: Vec::from_array([Report { name: "<script>alert('x')</script>&\"", ..baseline }]),
    };
    let encoded = must(bench::to_json(suite));
    let decoded = must(bench::from_json(encoded));
    testing::assert_eq(decoded.reports[0].name, suite.reports[0].name);
    testing::assert_eq(decoded.reports[0].samples.len(), 4);
    testing::assert_eq(decoded.reports[0].statistics.mean.estimate, 10.0);
    let html = must(bench::to_html(suite));
    testing::assert(!html.contains("<script>"));
    testing::assert(html.contains("&lt;script&gt;"));
    testing::assert(html.contains("&amp;"));
    testing::assert(bench::to_json(SuiteReport { schema: 2, reports: Vec::new() }).is_err());
    testing::assert(
        bench::to_json(SuiteReport { schema: 1, reports: Vec::from_array([baseline, baseline]) }).is_err(),
    );
    testing::assert(bench::from_json("{not-json}").is_err());
    testing::assert(
        bench::to_json(
            SuiteReport {
                schema: 1,
                reports: Vec::from_array([Report { total_iterations: 0, ..baseline }]),
            },
        ).is_err(),
    );
}

#[test]
fn json_depth_preflight_ignores_quoted_and_escaped_brackets() -> () {
    let mut deep = "";
    for _ in 0..65 {
        deep += "[";
    }
    deep += "0";
    for _ in 0..65 {
        deep += "]";
    }
    testing::assert_eq(
        testing::expect_err(bench::from_json(deep), "deep JSON").kind,
        bench::ErrorKind::Limit,
    );
    let baseline = report(Vec::from_array([10, 10, 10, 10]));
    let mut quoted = "\\\"";
    for _ in 0..100 {
        quoted += "[\\\"]";
    }
    let suite = SuiteReport {
        schema: 1,
        reports: Vec::from_array([Report { parameter: quoted, ..baseline }]),
    };
    let encoded = must(bench::to_json(suite));
    testing::assert_eq(must(bench::from_json(encoded)).reports[0].parameter, quoted);
    testing::assert(bench::from_json("{\"schema\":\"").is_err());
    testing::assert(
        bench::throughput_per_second(Throughput::Bytes(18446744073709551615), 1e-300).is_err(),
    );
}
