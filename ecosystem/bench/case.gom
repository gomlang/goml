package bench;

use std::context;

#[go_ffi("example.com/goml-ecosystem/bench/adapter", "Consume")]
extern fn consume(value: u64) -> ();

#[go_ffi("example.com/goml-ecosystem/bench/adapter", "Observed")]
pub extern fn observed() -> u64;

#[go_ffi("example.com/goml-ecosystem/bench/adapter", "Opaque")]
extern fn opaque(value: u64) -> u64;

pub fn black_box(value: u64) -> u64 {
    let result = opaque(value);
    consume(result);
    result
}

fn check_context(control: context::Context) -> Result[(), Error] {
    control.check().map_err(|failure| error(ErrorKind::Cancelled, failure.to_string()))
}

impl Case {
    pub fn new(name: string, work: () -> u64) -> Case {
        Case::fallible(name, || Result::Ok(work()))
    }

    pub fn fallible(name: string, work: () -> Result[u64, string]) -> Case {
        Case {
            group: "default",
            name,
            parameter: "",
            throughput: Throughput::None,
            timing: Timing::Batch,
            measure: |iterations, clock, control| {
                check_context(control)?;
                let start = clock.now()?;
                let mut checksum: u64 = 0;
                let mut index: u64 = 0;
                while index < iterations {
                    if index % 256 == 0 {
                        check_context(control)?;
                    }
                    let value = work().map_err(|message| error(ErrorKind::Workload, message))?;
                    consume(value);
                    checksum ^= ((value << (index % 64)) | (value >> ((64 - index % 64) % 64)));
                    index += 1;
                }
                let end = clock.now()?;
                check_context(control)?;
                Result::Ok(Batch { elapsed_ns: end - start, checksum })
            },
        }
    }

    pub fn with_setup[T](name: string, setup: () -> T, work: (T) -> u64) -> Case {
        Case::try_with_setup(name, || Result::Ok(setup()), |value| Result::Ok(work(value)))
    }

    pub fn try_with_setup[T](
        name: string,
        setup: () -> Result[T, string],
        work: (T) -> Result[u64, string],
    ) -> Case {
        Case {
            group: "default",
            name,
            parameter: "",
            throughput: Throughput::None,
            timing: Timing::PerIteration,
            measure: |iterations, clock, control| {
                let mut elapsed: i64 = 0;
                let mut checksum: u64 = 0;
                let mut index: u64 = 0;
                while index < iterations {
                    check_context(control)?;
                    let prepared = setup().map_err(|message| error(ErrorKind::Workload, message))?;
                    let start = clock.now()?;
                    let value = work(prepared).map_err(
                        |message| error(ErrorKind::Workload, message),
                    )?;
                    let end = clock.now()?;
                    let delta = end - start;
                    if delta > 9223372036854775807 - elapsed {
                        return Result::Err(error(ErrorKind::Limit, "elapsed time overflow"))
                    }
                    elapsed += delta;
                    consume(value);
                    checksum ^= ((value << (index % 64)) | (value >> ((64 - index % 64) % 64)));
                    index += 1;
                }
                check_context(control)?;
                Result::Ok(Batch { elapsed_ns: elapsed, checksum })
            },
        }
    }

    pub fn with_group(self: Case, group: string) -> Case {
        Case { group, ..self }
    }

    pub fn with_parameter(self: Case, parameter: string) -> Case {
        Case { parameter, ..self }
    }

    pub fn with_throughput(self: Case, throughput: Throughput) -> Case {
        Case { throughput, ..self }
    }
}

pub fn parameterized[T](group: string, name: string, parameters: Vec[(string, T)], work: (T) -> u64) -> Vec[
    Case,
] {
    let cases = Vec::new();
    for (parameter, value) in parameters {
        cases.push(Case::new(name, || work(value)).with_group(group).with_parameter(parameter));
    }
    cases
}
