package datetime;

struct PosixParser {
    text: string,
    position: Ref[isize],
    extended: bool,
}

enum RuleDay {
    Julian(isize),
    JulianWithoutLeap(isize),
    MonthWeekDay(isize, isize, isize),
}

struct TransitionRule {
    day: RuleDay,
    seconds: i64,
}

struct PosixRules {
    standard: ZoneInfo,
    daylight: Option[ZoneInfo],
    start: TransitionRule,
    end: TransitionRule,
}

impl PosixParser {
    fn peek(self: PosixParser) -> byte {
        let position = self.position.get();
        if position == self.text.byte_len() {
            0
        } else {
            self.text.byte_get(position)
        }
    }

    fn advance(self: PosixParser) -> () {
        self.position.set(self.position.get() + 1);
    }

    fn expect(self: PosixParser, expected: byte) -> Result[(), Error] {
        if self.peek() != expected {
            Result::Err(parse_error(self.position.get(), "invalid POSIX timezone rule"))
        } else {
            self.advance();
            Result::Ok(())
        }
    }

    fn number(self: PosixParser, maximum: isize) -> Result[isize, Error] {
        let start = self.position.get();
        let mut result = 0;
        while self.peek() >= b'0' && self.peek() <= b'9' {
            result = result * 10 + (self.peek() - b'0').to_isize();
            if result > maximum {
                return Result::Err(parse_error(self.position.get(), "POSIX number out of range"));
            }
            self.advance();
        }
        if start == self.position.get() {
            Result::Err(parse_error(start, "expected POSIX number"))
        } else {
            Result::Ok(result)
        }
    }

    fn name(self: PosixParser) -> Result[string, Error] {
        let quoted = self.peek() == b'<';
        if quoted {
            self.advance();
        }
        let start = self.position.get();
        while self.peek() >= b'A' && self.peek() <= b'Z'
            || self.peek() >= b'a' && self.peek() <= b'z'
            || quoted
                && (self.peek() >= b'0' && self.peek() <= b'9' || self.peek() == b'+'
                    || self.peek() == b'-') {
            self.advance();
        }
        let name = self.text.byte_slice(start, self.position.get());
        if name.byte_len() < 3 {
            return Result::Err(
                parse_error(start, "POSIX abbreviation needs at least three characters"),
            );
        }
        if quoted {
            self.expect(b'>')?;
        }
        Result::Ok(name)
    }

    fn seconds(self: PosixParser, max_hour: isize) -> Result[i64, Error] {
        let negative = self.peek() == b'-';
        if self.peek() == b'-' || self.peek() == b'+' {
            self.advance();
        }
        let hour = self.number(max_hour)?;
        let mut minute = 0;
        let mut second = 0;
        if self.peek() == b':' {
            self.advance();
            minute = self.number(59)?;
            if self.peek() == b':' {
                self.advance();
                second = self.number(59)?;
            }
        }
        let value = (hour * 3600 + minute * 60 + second).to_i64();
        Result::Ok(
            if negative {
                -value
            } else {
                value
            },
        )
    }

    fn rule(self: PosixParser) -> Result[TransitionRule, Error] {
        let day = match self.peek() {
            b'M' => {
                self.advance();
                let month = self.number(12)?;
                self.expect(b'.')?;
                let week = self.number(5)?;
                self.expect(b'.')?;
                let day = self.number(6)?;
                if month < 1 || week < 1 {
                    return Result::Err(
                        parse_error(self.position.get(), "POSIX month/week starts at one"),
                    );
                }
                RuleDay::MonthWeekDay(month, week, day)
            },
            b'J' => {
                self.advance();
                let day = self.number(365)?;
                if day < 1 {
                    return Result::Err(parse_error(self.position.get(), "Julian day starts at one"));
                }
                RuleDay::JulianWithoutLeap(day)
            },
            _ => RuleDay::Julian(self.number(365)?),
        };
        let seconds = if self.peek() == b'/' {
            self.advance();
            if !self.extended && (self.peek() == b'-' || self.peek() == b'+') {
                return Result::Err(
                    Error::TimeZone("signed transition times require TZif version 3 or higher"),
                );
            }
            self.seconds(
                if self.extended {
                    167
                } else {
                    24
                },
            )?
        } else {
            7200
        };
        Result::Ok(TransitionRule { day, seconds })
    }
}

fn parse_posix(text: string, extended: bool) -> Result[PosixRules, Error] {
    if text.byte_len() > 4096 {
        return Result::Err(Error::TimeZone("POSIX footer exceeds 4096 bytes"));
    }
    for byte in text.to_bytes() {
        if byte < 33 || byte > 126 {
            return Result::Err(
                Error::TimeZone("POSIX rule requires printable ASCII without spaces"),
            );
        }
    }
    let parser = PosixParser { text, position: Ref::new(0), extended };
    let name = parser.name()?;
    let offset = Offset::from_seconds((-parser.seconds(24)?).to_isize())?;
    let standard = ZoneInfo { offset, abbreviation: name, is_dst: false };
    let empty_rule = TransitionRule { day: RuleDay::Julian(0), seconds: 0 };
    if parser.peek() == 0 {
        return Result::Ok(
            PosixRules { standard, daylight: Option::None, start: empty_rule, end: empty_rule },
        );
    }
    let name = parser.name()?;
    let offset = if parser.peek() == b',' {
        Offset::from_seconds(offset.seconds_value + 3600)?
    } else {
        Offset::from_seconds((-parser.seconds(24)?).to_isize())?
    };
    let daylight = ZoneInfo { offset, abbreviation: name, is_dst: true };
    parser.expect(b',')?;
    let start = parser.rule()?;
    parser.expect(b',')?;
    let end = parser.rule()?;
    if parser.peek() != 0 {
        return Result::Err(parse_error(parser.position.get(), "trailing POSIX rule data"));
    }
    Result::Ok(PosixRules { standard, daylight: Option::Some(daylight), start, end })
}

fn rule_epoch(rule: TransitionRule, year: isize, previous: Offset) -> i64 {
    let ordinal = match rule.day {
        RuleDay::Julian(value) => value,
        RuleDay::JulianWithoutLeap(value) => value - 1
            + if is_leap_year(year) && value >= 60 {
                1
            } else {
                0
            },
        RuleDay::MonthWeekDay(month, week, day) => {
            let mut start = 0;
            for m in 1..month {
                start += month_length(year, m);
            }
            let first_weekday = floor_mod(year_start(year) + start.to_i64() + 4, 7).to_isize();
            let mut selected = (day - first_weekday + 7) % 7 + 1 + (week - 1) * 7;
            if selected > month_length(year, month) {
                selected -= 7;
            }
            start + selected - 1
        },
    };
    (year_start(year) + ordinal.to_i64()) * 86400 + rule.seconds - previous.seconds_value.to_i64()
}

impl PosixRules {
    fn info(self: PosixRules, instant: UtcInstant) -> ZoneInfo {
        let daylight = match self.daylight {
            Some(value) => value,
            None => return self.standard,
        };
        let year = instant.to_utc().date_value.year_value;
        for candidate in year - 1..=year + 1 {
            let start = rule_epoch(self.start, candidate, self.standard.offset);
            let end = rule_epoch(self.end, candidate, daylight.offset);
            let end = if end <= start {
                rule_epoch(self.end, candidate + 1, daylight.offset)
            } else {
                end
            };
            if start <= instant.seconds_value && instant.seconds_value < end {
                return daylight;
            }
        }
        self.standard
    }
}
