package datetime;

use std::serde::{Serialize, Deserialize, Serializer, Deserializer};

impl Serialize for Date {
    fn serialize[S: Serializer](self: Date, serializer: S) -> Result[(), string] {
        serializer.serialize_string(self.to_string())
    }
}

impl Deserialize for Date {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[Date, string] {
        Date::parse(deserializer.deserialize_string()?).map_err(
            |error| deserializer.error(error.to_string()),
        )
    }
}

impl Serialize for Time {
    fn serialize[S: Serializer](self: Time, serializer: S) -> Result[(), string] {
        serializer.serialize_string(self.to_string())
    }
}

impl Deserialize for Time {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[Time, string] {
        Time::parse(deserializer.deserialize_string()?).map_err(
            |error| deserializer.error(error.to_string()),
        )
    }
}

