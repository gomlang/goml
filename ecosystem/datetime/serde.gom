impl Serialize for UtcInstant {
    fn serialize[S: Serializer](self: UtcInstant, serializer: S) -> Result[(), string] {
        serializer.serialize_string(self.to_string())
    }
}

impl Deserialize for UtcInstant {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[UtcInstant, string] {
        UtcInstant::parse(deserializer.deserialize_string()?).map_err(
            |error| deserializer.error(error.to_string()),
        )
    }
}

impl Serialize for Offset {
    fn serialize[S: Serializer](self: Offset, serializer: S) -> Result[(), string] {
        serializer.serialize_string(self.to_string())
    }
}

impl Deserialize for Offset {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[Offset, string] {
        Offset::parse(deserializer.deserialize_string()?).map_err(
            |error| deserializer.error(error.to_string()),
        )
    }
}

impl Serialize for OffsetDateTime {
    fn serialize[S: Serializer](self: OffsetDateTime, serializer: S) -> Result[(), string] {
        Serialize::serialize((self.instant_value, self.offset_value), serializer)
    }
}

impl Deserialize for OffsetDateTime {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[OffsetDateTime, string] {
        let pair: (UtcInstant, Offset) = Deserialize::deserialize(deserializer)?;
        pair.0.with_offset(pair.1).map_err(|error| deserializer.error(error.to_string()))
    }
}

impl Serialize for Duration {
    fn serialize[S: Serializer](self: Duration, serializer: S) -> Result[(), string] {
        Serialize::serialize((self.seconds_value, self.nanos_value), serializer)
    }
}

impl Deserialize for Duration {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[Duration, string] {
        let pair: (i64, isize) = Deserialize::deserialize(deserializer)?;
        if pair.1 < 0 || pair.1 >= 1000000000 {
            return Result::Err(deserializer.error("non-canonical duration nanoseconds"));
        }
        Duration::new(pair.0, pair.1.to_i64()).map_err(
            |error| deserializer.error(error.to_string()),
        )
    }
}
