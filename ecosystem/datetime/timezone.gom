package datetime;

use std::bytes;
use std::bytes::endian;
use std::os::linux::fd;
use std::io;
use io::Read;
use std::utf8;
use utf8::BytesUtf8;

#[derive(Debug, PartialEq, Eq)]
pub struct ZoneInfo {
    pub offset: Offset,
    pub abbreviation: string,
    pub is_dst: bool,
}

struct Transition {
    seconds: i64,
    type_index: isize,
}

pub struct TimeZone {
    name_value: string,
    transitions: Vec[Transition],
    types: Vec[ZoneInfo],
    future: Option[PosixRules],
    finite: bool,
}

pub struct ZonedDateTime {
    datetime_value: OffsetDateTime,
    zone_value: TimeZone,
    info_value: ZoneInfo,
}

pub enum LocalResult {
    Unique(ZonedDateTime),
    Ambiguous(ZonedDateTime, ZonedDateTime),
    Nonexistent,
}

#[derive(Debug, PartialEq, Eq)]
pub enum FoldPolicy {
    Reject,
    Earlier,
    Later,
}

impl LocalResult {
    pub fn resolve(self: LocalResult, policy: FoldPolicy) -> Result[ZonedDateTime, Error] {
        match self {
            LocalResult::Unique(value) => Result::Ok(value),
            LocalResult::Ambiguous(earlier, later) => match policy {
                FoldPolicy::Reject => Result::Err(Error::Invalid("ambiguous local time")),
                FoldPolicy::Earlier => Result::Ok(earlier),
                FoldPolicy::Later => Result::Ok(later),
            },
            LocalResult::Nonexistent => Result::Err(Error::Invalid("nonexistent local time")),
        }
    }
}

impl TimeZone {
    pub fn fixed(name: string, offset: Offset) -> TimeZone {
        let info = ZoneInfo { offset, abbreviation: name, is_dst: false };
        TimeZone {
            name_value: name,
            transitions: Vec::new(),
            types: Vec::from_array([info]),
            future: Option::None,
            finite: false,
        }
    }

    pub fn from_posix(name: string, rule: string) -> Result[TimeZone, Error] {
        let future = parse_posix(rule, true)?;
        let types = Vec::from_array([future.standard]);
        if let Some(daylight) = future.daylight {
            types.push(daylight);
        }
        Result::Ok(
            TimeZone {
                name_value: name,
                transitions: Vec::new(),
                types,
                future: Option::Some(future),
                finite: false,
            },
        )
    }

    pub fn load(name: string) -> Result[TimeZone, Error] {
        TimeZone::load_from("/usr/share/zoneinfo", name)
    }

    pub fn load_from(directory: string, name: string) -> Result[TimeZone, Error] {
        if name == "" || name.starts_with("/") || name.byte_len() > 255 {
            return Result::Err(Error::Invalid("invalid timezone name"));
        }
        for part in name.split("/") {
            if part == "" || part == "." || part == ".." {
                return Result::Err(Error::Invalid("invalid timezone path component"));
            }
            for byte in part.to_bytes() {
                if !(byte >= b'A' && byte <= b'Z' || byte >= b'a' && byte <= b'z'
                    || byte >= b'0' && byte <= b'9'
                    || byte == b'_'
                    || byte == b'-'
                    || byte == b'+') {
                    return Result::Err(Error::Invalid("invalid character in timezone name"));
                }
            }
        }
        let file = fd::open(directory + "/" + name, fd::O_RDONLY | fd::O_NONBLOCK, 0).map_err(
            |error| Error::Io(error.to_string()),
        )?;
        let read = file.read_to_end(16777216);
        let closed = file.close();
        let data = read.map_err(|error| Error::Io(error.to_string()))?;
        closed.map_err(|error| Error::Io(error.to_string()))?;
        TimeZone::from_tzif(name, data)
    }

    pub fn name(self: TimeZone) -> string {
        self.name_value
    }

    pub fn transition_count(self: TimeZone) -> isize {
        self.transitions.len()
    }

    pub fn has_future_rules(self: TimeZone) -> bool {
        self.future.is_some()
    }

    pub fn last_explicit_transition(self: TimeZone) -> Option[i64] {
        if self.transitions.is_empty() {
            Option::None
        } else {
            Option::Some(self.transitions[self.transitions.len() - 1].seconds)
        }
    }

    pub fn offset_at(self: TimeZone, instant: UtcInstant) -> Result[ZoneInfo, Error] {
        let length = self.transitions.len();
        if length == 0 || instant.seconds_value > self.transitions[length - 1].seconds {
            if let Some(rules) = self.future {
                return checked_zone_info(rules.info(instant));
            }
            if self.finite {
                return Result::Err(
                    Error::Unsupported("TZif has no future rule after its final transition"),
                );
            }
        }
        let mut low = 0;
        let mut high = length;
        while low < high {
            let middle = low + (high - low) / 2;
            if self.transitions[middle].seconds <= instant.seconds_value {
                low = middle + 1;
            } else {
                high = middle;
            }
        }
        let index = if low == 0 {
            0
        } else {
            self.transitions[low - 1].type_index
        };
        checked_zone_info(self.types[index])
    }

    pub fn at(self: TimeZone, instant: UtcInstant) -> Result[ZonedDateTime, Error] {
        let info = self.offset_at(instant)?;
        Result::Ok(
            ZonedDateTime {
                datetime_value: instant.with_offset(info.offset)?,
                zone_value: self,
                info_value: info,
            },
        )
    }

    pub fn resolve_local(self: TimeZone, local: LocalDateTime) -> Result[LocalResult, Error] {
        let offsets: Vec[Offset] = Vec::new();
        for info in self.types {
            offsets.push(info.offset);
        }
        if let Some(rules) = self.future {
            offsets.push(rules.standard.offset);
            if let Some(info) = rules.daylight {
                offsets.push(info.offset);
            }
        }
        let candidates: Vec[ZonedDateTime] = Vec::new();
        let seen: HashMap[isize, bool] = HashMap::new();
        let mut unsupported: Option[Error] = Option::None;
        let mut out_of_range = false;
        for offset in offsets {
            if seen.get(offset.seconds_value).is_some() {
                continue;
            }
            seen.set(offset.seconds_value, true);
            let datetime = match local.assume_offset(offset) {
                Ok(value) => value,
                Err(_) => {
                    out_of_range = true;
                    continue;
                },
            };
            match self.at(datetime.instant_value) {
                Ok(value) => if value.local() == local {
                    candidates.push(value);
                },
                Err(error) => {
                    unsupported = Option::Some(error);
                },
            }
        }
        if let Some(error) = unsupported {
            return Result::Err(error);
        }
        if candidates.is_empty() {
            if out_of_range {
                return Result::Err(
                    Error::OutOfRange("local timezone conversion exceeds instant range"),
                );
            }
            return Result::Ok(LocalResult::Nonexistent);
        }
        if candidates.len() == 1 {
            return Result::Ok(LocalResult::Unique(candidates[0]));
        }
        if candidates.len() > 2 {
            return Result::Err(
                Error::Unsupported("zone produces more than two local-time candidates"),
            );
        }
        if candidates[0].instant().compare(candidates[1].instant()) < 0 {
            Result::Ok(LocalResult::Ambiguous(candidates[0], candidates[1]))
        } else {
            Result::Ok(LocalResult::Ambiguous(candidates[1], candidates[0]))
        }
    }
}

impl ZonedDateTime {
    pub fn instant(self: ZonedDateTime) -> UtcInstant {
        self.datetime_value.instant_value
    }

    pub fn local(self: ZonedDateTime) -> LocalDateTime {
        self.datetime_value.local()
    }

    pub fn offset_datetime(self: ZonedDateTime) -> OffsetDateTime {
        self.datetime_value
    }

    pub fn info(self: ZonedDateTime) -> ZoneInfo {
        self.info_value
    }

    pub fn zone(self: ZonedDateTime) -> TimeZone {
        self.zone_value
    }

    pub fn to_zone(self: ZonedDateTime, zone: TimeZone) -> Result[ZonedDateTime, Error] {
        zone.at(self.instant())
    }

    pub fn checked_add(self: ZonedDateTime, duration: Duration) -> Result[ZonedDateTime, Error] {
        self.zone_value.at(self.instant().checked_add(duration)?)
    }

    pub fn checked_add_days(self: ZonedDateTime, days: i64) -> Result[LocalResult, Error] {
        self.zone_value.resolve_local(
            self.local().date_value.checked_add_days(days)?.at(self.local().time_value),
        )
    }

    pub fn checked_add_months(self: ZonedDateTime, months: i64, policy: InvalidDay) -> Result[
        LocalResult,
        Error,
    ] {
        self.zone_value.resolve_local(self.local().checked_add_months(months, policy)?)
    }
}

impl ToString for ZonedDateTime {
    fn to_string(self: ZonedDateTime) -> string {
        self.datetime_value.to_string() + "[" + self.zone_value.name_value + "]"
    }
}

struct Header {
    version: byte,
    ut: isize,
    standard: isize,
    leaps: isize,
    times: isize,
    types: isize,
    chars: isize,
}

fn tz_error(message: string) -> Error {
    Error::TimeZone(message)
}

fn count(data: bytes::Bytes, position: isize) -> Result[isize, Error] {
    let result = endian::read_u32(data.as_slice(), position, endian::Endian::Big).map_err(
        |error| tz_error(error.to_string()),
    )?.to_isize();
    if result > 1000000 {
        Result::Err(tz_error("TZif count exceeds limit"))
    } else {
        Result::Ok(result)
    }
}

fn header(data: bytes::Bytes, start: isize) -> Result[Header, Error] {
    if start > data.len() - 44 {
        return Result::Err(tz_error("truncated TZif header"));
    }
    if data.get(start) != b'T' || data.get(start + 1) != b'Z' || data.get(start + 2) != b'i'
        || data.get(start + 3) != b'f' {
        return Result::Err(tz_error("invalid TZif magic"));
    }
    let version = data.get(start + 4);
    if version != 0 && version != b'2' && version != b'3' && version != b'4' {
        return Result::Err(Error::Unsupported("unsupported TZif version"));
    }
    for index in start + 5..start + 20 {
        if data.get(index) != 0 {
            return Result::Err(tz_error("nonzero TZif reserved byte"));
        }
    }
    let result = Header {
        version,
        ut: count(data, start + 20)?,
        standard: count(data, start + 24)?,
        leaps: count(data, start + 28)?,
        times: count(data, start + 32)?,
        types: count(data, start + 36)?,
        chars: count(data, start + 40)?,
    };
    if result.types < 1 || result.types > 256 || result.chars < 1 || result.chars > 65536
        || result.ut != 0 && result.ut != result.types
        || result.standard != 0 && result.standard != result.types {
        return Result::Err(tz_error("invalid TZif counts"));
    }
    Result::Ok(result)
}

fn block_size(header: Header, width: isize) -> isize {
    header.times * (width + 1) + header.types * 6 + header.chars + header.leaps * (width + 4)
        + header.standard
        + header.ut
}

impl TimeZone {
    pub fn from_tzif(name: string, data: bytes::Bytes) -> Result[TimeZone, Error] {
        if data.len() > 16777216 {
            return Result::Err(tz_error("TZif exceeds 16 MiB limit"));
        }
        let first = header(data, 0)?;
        let mut selected = first;
        let mut width = 4;
        let mut start = 44;
        if first.version != 0 {
            let next = 44 + block_size(first, 4);
            selected = header(data, next)?;
            if selected.version != first.version {
                return Result::Err(tz_error("TZif header versions disagree"));
            }
            width = 8;
            start = next + 44;
        }
        if selected.leaps != 0 || first.leaps != 0 {
            return Result::Err(
                Error::Unsupported("leap-second TZif data is not supported; use POSIX zoneinfo"),
            );
        }
        let end = start + block_size(selected, width);
        if end > data.len() {
            return Result::Err(tz_error("truncated TZif data"));
        }
        let types_start = start + selected.times * (width + 1);
        let chars_start = types_start + selected.types * 6;
        let types: Vec[ZoneInfo] = Vec::new();
        for index in 0..selected.types {
            let position = types_start + index * 6;
            let seconds = endian::read_i32(data.as_slice(), position, endian::Endian::Big).map_err(
                |error| tz_error(error.to_string()),
            )?.to_isize();
            if seconds < -89999 || seconds > 93599 {
                return Result::Err(tz_error("TZif UTC offset outside RFC9636 bounds"));
            }
            let offset = Offset::from_seconds(seconds)?;
            if data.get(position + 4) > 1 {
                return Result::Err(tz_error("invalid DST flag"));
            }
            let abbreviation_index = data.get(position + 5).to_isize();
            if abbreviation_index >= selected.chars {
                return Result::Err(tz_error("invalid abbreviation index"));
            }
            let mut abbreviation_end = abbreviation_index;
            while abbreviation_end < selected.chars && data.get(chars_start + abbreviation_end) != 0 {
                abbreviation_end += 1;
            }
            if abbreviation_end == selected.chars {
                return Result::Err(tz_error("unterminated abbreviation"));
            }
            let abbreviation = bytes::Bytes::from_slice_copy(
                data.slice(chars_start + abbreviation_index, chars_start + abbreviation_end),
            ).to_string_utf8().map_err(|_| tz_error("non-UTF8 abbreviation"))?;
            types.push(ZoneInfo { offset, abbreviation, is_dst: data.get(position + 4) == 1 });
        }
        let transitions: Vec[Transition] = Vec::new();
        for index in 0..selected.times {
            let position = start + index * width;
            let seconds = if width == 8 {
                endian::read_i64(data.as_slice(), position, endian::Endian::Big).map_err(
                    |error| tz_error(error.to_string()),
                )?
            } else {
                endian::read_i32(data.as_slice(), position, endian::Endian::Big).map_err(
                    |error| tz_error(error.to_string()),
                )?.to_i64()
            };
            if index > 0 && transitions[index - 1].seconds >= seconds {
                return Result::Err(tz_error("transitions must be strictly increasing"));
            }
            let type_index = data.get(start + selected.times * width + index).to_isize();
            if type_index >= types.len() {
                return Result::Err(tz_error("invalid transition type"));
            }
            transitions.push(Transition { seconds, type_index });
        }
        let indicators = chars_start + selected.chars;
        for index in indicators..end {
            if data.get(index) > 1 {
                return Result::Err(tz_error("invalid standard/UT indicator"));
            }
        }
        for index in 0..selected.ut {
            if data.get(indicators + selected.standard + index) == 1
                && (selected.standard == 0 || data.get(indicators + index) == 0) {
                return Result::Err(tz_error("UT indicator requires standard indicator"));
            }
        }
        let mut future: Option[PosixRules] = Option::None;
        if first.version != 0 {
            if data.len() - end < 2 || data.get(end) != b'\n' || data.get(data.len() - 1) != b'\n' {
                return Result::Err(tz_error("missing TZif footer framing"));
            }
            let tail = bytes::Bytes::from_slice_copy(data.slice(end + 1, data.len() - 1)).to_string_utf8().map_err(
                |_| tz_error("non-UTF8 footer"),
            )?;
            if tail != "" {
                future = Option::Some(parse_posix(tail, first.version != b'2')?);
            }
        } else if end != data.len() {
            return Result::Err(tz_error("trailing version-one TZif bytes"));
        }
        let finite = future.is_none() && !transitions.is_empty();
        let zone = TimeZone { name_value: name, transitions, types, future, finite };
        if let Some(rules) = future {
            if let Some(last) = zone.last_explicit_transition() {
                if let Ok(instant) = UtcInstant::new(last, 0) {
                    let recorded = zone.types[zone.transitions[zone.transitions.len() - 1].type_index];
                    if rules.info(instant) != recorded {
                        return Result::Err(tz_error("POSIX footer disagrees with final transition"));
                    }
                }
            }
        }
        Result::Ok(zone)
    }
}

fn checked_zone_info(info: ZoneInfo) -> Result[ZoneInfo, Error] {
    if info.abbreviation == "-00" {
        Result::Err(Error::Unsupported("TZif marks local time as unspecified"))
    } else {
        Result::Ok(info)
    }
}
