package datetime;

use std::time;

#[derive(Debug, PartialEq, Eq, Hash)]
pub struct Duration {
    seconds_value: i64,
    nanos_value: isize,
}

impl Duration {
    pub fn new(seconds: i64, nanoseconds: i64) -> Result[Duration, Error] {
        if seconds < -315537897600 || seconds > 315537897600 || nanoseconds < -999999999
            || nanoseconds > 999999999 {
            return Result::Err(
                Error::OutOfRange(
                    "duration exceeds calendar range or fractional nanoseconds exceed one second",
                ),
            );
        }
        let normalized = seconds + floor_div(nanoseconds, 1000000000);
        if normalized < -315537897600 || normalized > 315537897600 {
            return Result::Err(Error::OutOfRange("normalized duration exceeds calendar range"));
        }
        Result::Ok(
            Duration {
                seconds_value: normalized,
                nanos_value: floor_mod(nanoseconds, 1000000000).to_isize(),
            },
        )
    }

    pub fn seconds(value: i64) -> Result[Duration, Error] {
        Duration::new(value, 0)
    }

    pub fn days(value: i64) -> Result[Duration, Error] {
        if value < -3652059 || value > 3652059 {
            Result::Err(Error::OutOfRange("duration days exceed calendar range"))
        } else {
            Duration::seconds(value * 86400)
        }
    }

    pub fn nanoseconds(value: i64) -> Duration {
        Duration {
            seconds_value: floor_div(value, 1000000000),
            nanos_value: floor_mod(value, 1000000000).to_isize(),
        }
    }

    pub fn whole_seconds(self: Duration) -> i64 {
        self.seconds_value
            + if self.seconds_value < 0 && self.nanos_value != 0 {
                1
            } else {
                0
            }
    }

    pub fn floor_seconds(self: Duration) -> i64 {
        self.seconds_value
    }

    pub fn subsecond_nanoseconds(self: Duration) -> isize {
        self.nanos_value
    }

    pub fn checked_nanoseconds(self: Duration) -> Result[i64, Error] {
        let seconds = self.whole_seconds();
        let fraction = if self.seconds_value < 0 && self.nanos_value != 0 {
            self.nanos_value.to_i64() - 1000000000
        } else {
            self.nanos_value.to_i64()
        };
        if seconds < -9223372036 || seconds > 9223372036
            || seconds == 9223372036 && fraction > 854775807
            || seconds == -9223372036 && fraction < -854775808 {
            Result::Err(Error::OutOfRange("duration does not fit signed 64-bit nanoseconds"))
        } else {
            Result::Ok(seconds * 1000000000 + fraction)
        }
    }

    pub fn checked_add(self: Duration, other: Duration) -> Result[Duration, Error] {
        let fraction = self.nanos_value + other.nanos_value;
        Duration::new(
            self.seconds_value + other.seconds_value + (fraction / 1000000000).to_i64(),
            (fraction % 1000000000).to_i64(),
        )
    }

    pub fn checked_negate(self: Duration) -> Result[Duration, Error] {
        Duration::new(-self.seconds_value, -self.nanos_value.to_i64())
    }
}

#[derive(Debug, PartialEq, Eq, Hash)]
pub struct UtcInstant {
    seconds_value: i64,
    nanos_value: isize,
}

impl UtcInstant {
    pub fn new(unix_seconds: i64, nanosecond: isize) -> Result[UtcInstant, Error] {
        if unix_seconds < -62135596800 || unix_seconds > 253402300799 || nanosecond < 0
            || nanosecond > 999999999 {
            Result::Err(
                Error::OutOfRange("instant must be in years 1..9999 with nanosecond 0..999999999"),
            )
        } else {
            Result::Ok(UtcInstant { seconds_value: unix_seconds, nanos_value: nanosecond })
        }
    }

    pub fn from_unix_nanoseconds(value: i64) -> UtcInstant {
        UtcInstant {
            seconds_value: floor_div(value, 1000000000),
            nanos_value: floor_mod(value, 1000000000).to_isize(),
        }
    }

    pub fn from_unix_milliseconds(value: i64) -> Result[UtcInstant, Error] {
        UtcInstant::new(floor_div(value, 1000), (floor_mod(value, 1000) * 1000000).to_isize())
    }

    pub fn now() -> UtcInstant {
        UtcInstant::from_unix_nanoseconds(time::SystemTime::now().unix_nanoseconds())
    }

    pub fn unix_seconds(self: UtcInstant) -> i64 {
        self.seconds_value
    }

    pub fn nanosecond(self: UtcInstant) -> isize {
        self.nanos_value
    }

    pub fn unix_milliseconds(self: UtcInstant) -> i64 {
        self.seconds_value * 1000 + (self.nanos_value / 1000000).to_i64()
    }

    pub fn checked_unix_nanoseconds(self: UtcInstant) -> Result[i64, Error] {
        Duration { seconds_value: self.seconds_value, nanos_value: self.nanos_value }.checked_nanoseconds()
    }

    pub fn to_utc(self: UtcInstant) -> LocalDateTime {
        let date = date_from_epoch_days(floor_div(self.seconds_value, 86400));
        date.at(
            Time {
                seconds_value: floor_mod(self.seconds_value, 86400).to_isize(),
                nanos_value: self.nanos_value,
            },
        )
    }

    pub fn with_offset(self: UtcInstant, offset: Offset) -> Result[OffsetDateTime, Error] {
        UtcInstant::new(self.seconds_value + offset.seconds_value.to_i64(), self.nanos_value)?;
        Result::Ok(OffsetDateTime { instant_value: self, offset_value: offset })
    }

    pub fn checked_add(self: UtcInstant, duration: Duration) -> Result[UtcInstant, Error] {
        let fraction = self.nanos_value + duration.nanos_value;
        UtcInstant::new(
            self.seconds_value + duration.seconds_value + (fraction / 1000000000).to_i64(),
            fraction % 1000000000,
        )
    }

    pub fn checked_subtract(self: UtcInstant, duration: Duration) -> Result[UtcInstant, Error] {
        self.checked_add(duration.checked_negate()?)
    }

    pub fn duration_since(self: UtcInstant, earlier: UtcInstant) -> Duration {
        let fraction = self.nanos_value - earlier.nanos_value;
        Duration {
            seconds_value: self.seconds_value - earlier.seconds_value
                + floor_div(fraction.to_i64(), 1000000000),
            nanos_value: floor_mod(fraction.to_i64(), 1000000000).to_isize(),
        }
    }

    pub fn compare(self: UtcInstant, other: UtcInstant) -> isize {
        let seconds = compare_i64(self.seconds_value, other.seconds_value);
        if seconds == 0 {
            compare_i64(self.nanos_value.to_i64(), other.nanos_value.to_i64())
        } else {
            seconds
        }
    }
}

#[derive(Debug, PartialEq, Eq, Hash)]
pub struct Offset {
    seconds_value: isize,
}

impl Offset {
    pub fn utc() -> Offset {
        Offset { seconds_value: 0 }
    }

    pub fn from_seconds(value: isize) -> Result[Offset, Error] {
        if value < -93599 || value > 93599 {
            Result::Err(Error::OutOfRange("offset exceeds 25:59:59"))
        } else {
            Result::Ok(Offset { seconds_value: value })
        }
    }

    pub fn seconds(self: Offset) -> isize {
        self.seconds_value
    }
}

#[derive(Debug, PartialEq, Eq, Hash)]
pub struct OffsetDateTime {
    instant_value: UtcInstant,
    offset_value: Offset,
}

impl OffsetDateTime {
    pub fn instant(self: OffsetDateTime) -> UtcInstant {
        self.instant_value
    }

    pub fn offset(self: OffsetDateTime) -> Offset {
        self.offset_value
    }

    pub fn local(self: OffsetDateTime) -> LocalDateTime {
        UtcInstant {
            seconds_value: self.instant_value.seconds_value
                + self.offset_value.seconds_value.to_i64(),
            nanos_value: self.instant_value.nanos_value,
        }.to_utc()
    }

    pub fn to_offset(self: OffsetDateTime, offset: Offset) -> Result[OffsetDateTime, Error] {
        self.instant_value.with_offset(offset)
    }

    pub fn checked_add(self: OffsetDateTime, duration: Duration) -> Result[OffsetDateTime, Error] {
        self.instant_value.checked_add(duration)?.with_offset(self.offset_value)
    }

    pub fn checked_add_months(self: OffsetDateTime, months: i64, policy: InvalidDay) -> Result[
        OffsetDateTime,
        Error,
    ] {
        self.local().checked_add_months(months, policy)?.assume_offset(self.offset_value)
    }
}
