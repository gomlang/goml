package tests;

use std::bytes;
use std::fs;
use std::testing;

struct ZoneType {
    offset: i64,
    daylight: bool,
    name: string,
}

struct SyntheticFixture {
    name: string,
    types: Vec[ZoneType],
    transitions: Vec[(i64, byte)],
    footer: string,
}

fn zone_type(offset: i64, daylight: bool, name: string) -> ZoneType {
    ZoneType { offset, daylight, name }
}

fn integer_bytes(output: bytes::Builder, value: i64, width: isize) -> () {
    for index in 0..width {
        let shift = (width - index - 1) * 8;
        output.push(((value >> shift) & 255).to_u8());
    }
}

fn tzif_block(version: byte, width: isize, types: Vec[ZoneType], transitions: Vec[(i64, byte)]) -> bytes::Bytes {
    let names = bytes::Builder::new();
    let records = bytes::Builder::new();
    for kind in types {
        integer_bytes(records, kind.offset, 4);
        records.push(
            if kind.daylight {
                1
            } else {
                0
            },
        );
        records.push(names.len().to_u8());
        names.extend(bytes::Bytes::from_string(kind.name).as_slice());
        names.push(0);
    }
    let output = bytes::Builder::new();
    output.extend(bytes::Bytes::from_string("TZif").as_slice());
    output.push(version);
    for _ in 0..15 {
        output.push(0);
    }
    for count in Vec::from_array([0, 0, 0, transitions.len(), types.len(), names.len()]) {
        integer_bytes(output, count.to_i64(), 4);
    }
    for (timestamp, _) in transitions {
        integer_bytes(output, timestamp, width);
    }
    for (_, index) in transitions {
        output.push(index);
    }
    output.extend(records.finish().as_slice());
    output.extend(names.finish().as_slice());
    output.finish()
}

fn tzif(version: byte, types: Vec[ZoneType], transitions: Vec[(i64, byte)], footer: string) -> bytes::Bytes {
    let output = bytes::Builder::new();
    output.extend(tzif_block(version, 4, types, Vec::new()).as_slice());
    if version != 0 {
        output.extend(tzif_block(version, 8, types, transitions).as_slice());
        output.extend(bytes::Bytes::from_string("\n" + footer + "\n").as_slice());
    }
    output.finish()
}

fn check_fixture(name: string, generated: bytes::Bytes) -> () {
    let existing = testing::expect_ok(
        fs::read_bytes_structured("fixtures/Synthetic/" + name),
        "synthetic TZif fixture",
    );
    testing::assert_eq(generated.len(), existing.len());
    testing::assert(generated.to_vec() == existing.to_vec());
}

#[test]
fn synthetic_tzif_fixtures_match_independent_rfc9636_layout() -> () {
    let normal = Vec::from_array([zone_type(0, false, "STD"), zone_type(3600, true, "DST")]);
    let cases = Vec::from_array(
        [
            SyntheticFixture {
                name: "AllYear",
                types: Vec::from_array(
                    [zone_type(-10800, false, "XXX"), zone_type(-14400, true, "EDT")],
                ),
                transitions: Vec::new(),
                footer: "XXX3EDT4,0/0,J365/23",
            },
            SyntheticFixture {
                name: "Finite",
                types: normal,
                transitions: Vec::from_array([(0, 1.to_u8())]),
                footer: "",
            },
            SyntheticFixture {
                name: "Shifted",
                types: normal,
                transitions: Vec::new(),
                footer: "STD0DST,J60/-2,J300/26",
            },
            SyntheticFixture {
                name: "Extreme",
                types: normal,
                transitions: Vec::new(),
                footer: "STD0DST,M1.1.0/-167,M12.5.0/167",
            },
            SyntheticFixture {
                name: "Julian",
                types: normal,
                transitions: Vec::new(),
                footer: "STD0DST,59,300",
            },
            SyntheticFixture {
                name: "NegativeDst",
                types: Vec::from_array([zone_type(3600, false, "IST"), zone_type(0, true, "GMT")]),
                transitions: Vec::new(),
                footer: "IST-1GMT0,M10.5.0,M3.5.0/1",
            },
            SyntheticFixture {
                name: "MultipleFold",
                types: Vec::from_array(
                    [
                        zone_type(0, false, "ZERO"),
                        zone_type(-3600, false, "ONE"),
                        zone_type(-7200, false, "TWO"),
                    ],
                ),
                transitions: Vec::from_array([(0, 1.to_u8()), (1800, 2.to_u8())]),
                footer: "TWO2",
            },
        ],
    );
    for fixture in cases {
        check_fixture(fixture.name, tzif(51, fixture.types, fixture.transitions, fixture.footer));
    }
    let utc = Vec::from_array([zone_type(0, false, "UTC")]);
    check_fixture("VersionOne", tzif(0, utc, Vec::new(), ""));
    check_fixture("VersionFour", tzif(52, utc, Vec::new(), "UTC0"));
}
