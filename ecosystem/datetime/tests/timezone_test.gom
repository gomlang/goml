package tests;

use ecosystem::datetime as dt;
use std::testing;
use std::fs;
use std::bytes;
use std::task;

fn zone(name: string) -> dt::TimeZone {
    testing::expect_ok(dt::TimeZone::load_from("fixtures", name), "fixture zone")
}

fn utc(text: string) -> dt::UtcInstant {
    testing::expect_ok(dt::UtcInstant::parse(text), "UTC")
}

fn local(text: string) -> dt::LocalDateTime {
    testing::expect_ok(dt::LocalDateTime::parse(text), "local")
}

#[test]
fn dst_gap_and_fold_are_explicit_and_ordered() -> () {
    let ny = zone("America/New_York");
    match testing::expect_ok(ny.resolve_local(local("2024-03-10T02:30:00")), "gap") {
        dt::LocalResult::Nonexistent => (),
        _ => testing::fail("spring gap must not normalize silently"),
    }
    let result = testing::expect_ok(ny.resolve_local(local("2024-11-03T01:30:00.123")), "fold");
    match result {
        dt::LocalResult::Ambiguous(early, late) => {
            testing::assert_eq(early.instant().to_string(), "2024-11-03T05:30:00.123Z");
            testing::assert_eq(late.instant().to_string(), "2024-11-03T06:30:00.123Z");
            testing::assert(early.info().is_dst);
            testing::assert(!late.info().is_dst);
        },
        _ => testing::fail("autumn fold must return two candidates"),
    }
    testing::assert_err(result.resolve(dt::FoldPolicy::Reject));
    testing::assert_eq(
        testing::expect_ok(result.resolve(dt::FoldPolicy::Later), "later").instant().unix_seconds(),
        1730615400,
    );
    let before = testing::expect_ok(ny.at(utc("2024-03-10T06:59:59.999999999Z")), "before");
    let after = testing::expect_ok(before.checked_add(dt::Duration::nanoseconds(1)), "after");
    testing::assert_eq(before.local().to_string(), "2024-03-10T01:59:59.999999999");
    testing::assert_eq(after.local().to_string(), "2024-03-10T03:00:00");
}

#[test]
fn wall_calendar_day_differs_from_elapsed_day() -> () {
    let ny = zone("America/New_York");
    let start = testing::expect_ok(ny.at(utc("2024-03-09T17:00:00Z")), "start");
    let calendar = testing::expect_ok(
        testing::expect_ok(start.checked_add_days(1), "day").resolve(dt::FoldPolicy::Reject),
        "unique",
    );
    let elapsed = testing::expect_ok(
        start.checked_add(testing::expect_ok(dt::Duration::days(1), "duration")),
        "elapsed",
    );
    testing::assert_eq(calendar.local().to_string(), "2024-03-10T12:00:00");
    testing::assert_eq(elapsed.local().to_string(), "2024-03-10T13:00:00");
    testing::assert_eq(
        calendar.instant().duration_since(start.instant()).whole_seconds(),
        23 * 3600,
    );
}

#[test]
fn southern_half_hour_dst_and_skipped_whole_day() -> () {
    let lord = zone("Australia/Lord_Howe");
    match testing::expect_ok(lord.resolve_local(local("2024-04-07T01:45:00")), "half-hour fold") {
        dt::LocalResult::Ambiguous(first, second) => testing::assert_eq(
            second.instant().duration_since(first.instant()).whole_seconds(),
            1800,
        ),
        _ => testing::fail("expected half-hour fold"),
    }
    match testing::expect_ok(lord.resolve_local(local("2024-10-06T02:15:00")), "half-hour gap") {
        dt::LocalResult::Nonexistent => (),
        _ => testing::fail("expected half-hour gap"),
    }
    match testing::expect_ok(
        zone("Pacific/Apia").resolve_local(local("2011-12-30T12:00:00")),
        "skipped date",
    ) {
        dt::LocalResult::Nonexistent => (),
        _ => testing::fail("expected skipped date"),
    }
    testing::assert_eq(
        testing::expect_ok(lord.offset_at(utc("2500-01-01T00:00:00Z")), "future summer").offset.seconds(),
        39600,
    );
    testing::assert_eq(
        testing::expect_ok(lord.offset_at(utc("2500-07-01T00:00:00Z")), "future winter").offset.seconds(),
        37800,
    );
}

#[test]
fn future_rules_and_historical_second_offsets() -> () {
    let ny = zone("America/New_York");
    testing::assert(ny.has_future_rules());
    testing::assert_eq(
        testing::expect_ok(ny.offset_at(utc("2500-01-01T00:00:00Z")), "winter").offset.seconds(),
        -18000,
    );
    testing::assert_eq(
        testing::expect_ok(ny.offset_at(utc("2500-07-01T00:00:00Z")), "summer").offset.seconds(),
        -14400,
    );
    testing::assert_eq(
        testing::expect_ok(ny.offset_at(utc("1800-01-01T00:00:00Z")), "historical").offset.seconds(),
        -17762,
    );
    let dublin = zone("Europe/Dublin");
    testing::assert_eq(
        testing::expect_ok(dublin.offset_at(utc("1900-01-01T00:00:00Z")), "Dublin historic").offset.seconds(),
        -1521,
    );
    let dublin = testing::expect_ok(
        dt::TimeZone::from_posix("negative-dst", "IST-1GMT0,M10.5.0,M3.5.0/1"),
        "negative DST rules",
    );
    testing::assert(
        testing::expect_ok(dublin.offset_at(utc("2500-01-01T00:00:00Z")), "negative DST").is_dst,
    );
    testing::assert(
        !testing::expect_ok(dublin.offset_at(utc("2500-07-01T00:00:00Z")), "standard summer").is_dst,
    );
}

#[test]
fn posix_rules_support_julian_and_outside_day_times() -> () {
    let shifted = testing::expect_ok(
        dt::TimeZone::from_posix("shifted", "STD0DST,J60/-2,J300/26"),
        "signed rules",
    );
    testing::assert(
        !testing::expect_ok(shifted.offset_at(utc("2024-02-29T21:59:59Z")), "before").is_dst,
    );
    testing::assert(
        testing::expect_ok(shifted.offset_at(utc("2024-02-29T22:00:00Z")), "after").is_dst,
    );
    let numbered = testing::expect_ok(
        dt::TimeZone::from_posix("numbered", "STD0DST,59,300"),
        "Julian",
    );
    testing::assert(
        testing::expect_ok(numbered.offset_at(utc("2024-02-29T03:00:00Z")), "Julian leap").is_dst,
    );
    testing::assert(
        !testing::expect_ok(numbered.offset_at(utc("2023-02-28T03:00:00Z")), "Julian normal").is_dst,
    );
    for invalid in Vec::from_array(
        [
            "",
            "UT0",
            "ABC25",
            "ABC0DST",
            "ABC0DST,M0.1.1,M10.1.1",
            "ABC0DST,M3.0.0,M10.1.0",
            "ABC0DST,M3.1.0/168,M10.1.0",
            "ABC0DST,J0,J100",
            "ABC0DST,366,100",
            "ABC0DST,M3.1.0,M10.1.0garbage",
            "ABC0DST,M3.1.0/2u,M10.1.0",
        ],
    ) {
        testing::assert_err(dt::TimeZone::from_posix("bad", invalid));
    }
}

#[test]
fn loading_rejects_traversal_and_malformed_tzif() -> () {
    for name in Vec::from_array(
        [
            "",
            "/etc/passwd",
            "../etc/passwd",
            "America/../Etc/UTC",
            "America//New_York",
            "America/./New_York",
            "Etc/UTC\u0000",
            "Etc\\UTC",
        ],
    ) {
        testing::assert_err(dt::TimeZone::load_from("fixtures", name));
    }
    let original = testing::expect_ok(
        fs::read_bytes_structured("fixtures/America/New_York"),
        "fixture",
    );
    for length in Vec::from_array([0, 1, 4, 43, 44, 100, original.len() - 1]) {
        testing::assert_err(
            dt::TimeZone::from_tzif(
                "truncated",
                bytes::Bytes::from_slice_copy(original.slice(0, length)),
            ),
        );
    }
    let mutated = original.copy();
    mutated.set(0, b'X');
    testing::assert_err(dt::TimeZone::from_tzif("bad magic", mutated));
    let version = original.copy();
    version.set(4, b'9');
    testing::assert_err(dt::TimeZone::from_tzif("bad version", version));
    let reserved = original.copy();
    reserved.set(5, 1);
    testing::assert_err(dt::TimeZone::from_tzif("reserved", reserved));
    let count = original.copy();
    count.set(32, 255);
    testing::assert_err(dt::TimeZone::from_tzif("unbounded count", count));
}

#[test]
fn tzif_missing_future_rules_are_rejected_after_final_transition() -> () {
    let finite = zone("Synthetic/Finite");
    testing::assert(!finite.has_future_rules());
    testing::assert_eq(
        testing::expect_ok(finite.offset_at(utc("1969-12-31T23:59:59Z")), "before first").offset.seconds(),
        0,
    );
    testing::assert_eq(
        testing::expect_ok(finite.offset_at(utc("1970-01-01T00:00:00Z")), "last transition").offset.seconds(),
        3600,
    );
    testing::assert_err(finite.offset_at(utc("1970-01-01T00:00:01Z")));
    testing::assert_err(finite.resolve_local(local("2050-01-01T00:00:00")));
    testing::assert_err(zone("Synthetic/MultipleFold").resolve_local(local("1969-12-31T23:10:00")));
}

#[test]
fn tzif_rejects_invalid_transition_indices_flags_and_footer() -> () {
    let source = testing::expect_ok(
        fs::read_bytes_structured("fixtures/Synthetic/Finite"),
        "fixture",
    );
    let second_header = 44 + 12 + 8;
    let body = second_header + 44;
    let invalid_index = source.copy();
    invalid_index.set(body + 8, 2);
    testing::assert_err(dt::TimeZone::from_tzif("invalid transition index", invalid_index));
    let invalid_dst = source.copy();
    invalid_dst.set(body + 9 + 4, 2);
    testing::assert_err(dt::TimeZone::from_tzif("invalid DST flag", invalid_dst));
    let invalid_abbreviation = source.copy();
    invalid_abbreviation.set(body + 9 + 5, 255);
    testing::assert_err(dt::TimeZone::from_tzif("invalid abbreviation index", invalid_abbreviation));
    let invalid_tail = source.copy();
    invalid_tail.set(invalid_tail.len() - 1, b'x');
    testing::assert_err(dt::TimeZone::from_tzif("invalid footer", invalid_tail));
    let leap = source.copy();
    leap.set(31, 1);
    testing::assert_err(dt::TimeZone::from_tzif("leap data", leap));
    testing::assert_err(dt::TimeZone::from_posix("embedded null", "UTC0\u0000ignored"));
    testing::assert_err(dt::TimeZone::from_posix("unicode", "UTC0é"));
}

#[test]
fn copied_tzif_data_and_fixed_boundary_conversions() -> () {
    let source = testing::expect_ok(fs::read_bytes_structured("fixtures/Etc/UTC"), "fixture");
    let loaded = testing::expect_ok(dt::TimeZone::from_tzif("snapshot", source), "snapshot");
    source.clear();
    testing::assert_eq(
        testing::expect_ok(loaded.offset_at(utc("2024-01-01T00:00:00Z")), "owned parsed data").offset.seconds(),
        0,
    );
    let positive = dt::TimeZone::fixed(
        "+1",
        testing::expect_ok(dt::Offset::from_seconds(3600), "offset"),
    );
    testing::assert_err(positive.at(utc("9999-12-31T23:59:59Z")));
    testing::assert_err(positive.resolve_local(local("0001-01-01T00:00:00")));
    let negative = dt::TimeZone::fixed(
        "-1",
        testing::expect_ok(dt::Offset::from_seconds(-3600), "offset"),
    );
    testing::assert_err(negative.at(utc("0001-01-01T00:00:00Z")));
    testing::assert_err(negative.resolve_local(local("9999-12-31T23:59:59")));
}

#[test]
fn permanent_dst_versions_and_unspecified_local_time() -> () {
    let permanent = zone("Synthetic/AllYear");
    for text in Vec::from_array(
        [
            "0001-01-01T00:00:00Z",
            "1969-12-31T23:59:59Z",
            "1970-01-01T00:00:00Z",
            "2024-01-01T00:00:00Z",
            "2024-07-01T00:00:00Z",
            "9999-12-31T23:59:59Z",
        ],
    ) {
        let info = testing::expect_ok(permanent.offset_at(utc(text)), "permanent DST");
        testing::assert_eq(info.offset.seconds(), -14400);
        testing::assert(info.is_dst);
    }
    testing::assert_eq(
        testing::expect_ok(
            zone("Synthetic/VersionOne").offset_at(utc("2500-01-01T00:00:00Z")),
            "v1 fixed",
        ).offset.seconds(),
        0,
    );
    testing::assert_eq(
        testing::expect_ok(
            zone("Synthetic/VersionFour").offset_at(utc("2500-01-01T00:00:00Z")),
            "v4 fixed",
        ).offset.seconds(),
        0,
    );
    let unknown = testing::expect_ok(dt::TimeZone::from_posix("unknown", "<-00>0"), "unknown zone");
    testing::assert_err(unknown.offset_at(utc("2024-01-01T00:00:00Z")));
    let modern = testing::expect_ok(
        fs::read_bytes_structured("fixtures/Synthetic/Extreme"),
        "modern fixture",
    );
    modern.set(4, b'2');
    modern.set(44 + 12 + 8 + 4, b'2');
    testing::assert_err(dt::TimeZone::from_tzif("invalid version-two extension", modern));
}

#[test]
fn immutable_zones_support_concurrent_conversion_and_resolution() -> () {
    let ny = zone("America/New_York");
    let fold = local("2500-11-07T01:30:00.123456789");
    let expected = testing::expect_ok(
        testing::expect_ok(ny.resolve_local(fold), "resolve").resolve(dt::FoldPolicy::Earlier),
        "earlier",
    ).instant();
    task::scope(
        |scope| {
            for _ in 0..12 {
                scope.spawn(
                    |_| {
                        for _ in 0..100 {
                            let actual = testing::expect_ok(
                                testing::expect_ok(ny.resolve_local(fold), "resolve").resolve(
                                    dt::FoldPolicy::Earlier,
                                ),
                                "earlier",
                            );
                            testing::assert_eq(actual.instant(), expected);
                            testing::assert_eq(
                                testing::expect_ok(ny.at(actual.instant()), "conversion").local(),
                                fold,
                            );
                        }
                    },
                );
            }
        },
    );
}
