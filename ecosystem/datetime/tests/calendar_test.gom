package tests;

use ecosystem::datetime as dt;
use std::testing;
use std::json;
use std::bincode;

fn date(text: string) -> dt::Date {
    testing::expect_ok(dt::Date::parse(text), "valid date")
}

fn instant(text: string) -> dt::UtcInstant {
    testing::expect_ok(dt::UtcInstant::parse(text), "valid instant")
}

#[test]
fn gregorian_centuries_bounds_and_iso_weeks() -> () {
    testing::assert(dt::is_leap_year(2000));
    testing::assert(!dt::is_leap_year(1900));
    testing::assert_err(dt::Date::new(1900, 2, 29));
    testing::assert_ok(dt::Date::new(2000, 2, 29));
    testing::assert_err(dt::Date::new(0, 1, 1));
    testing::assert_err(dt::Date::new(10000, 1, 1));
    testing::assert_err(dt::Date::new(2024, 13, 1));
    testing::assert_err(dt::Date::new(2024, 1, 0));
    testing::assert_eq(date("0001-01-01").epoch_days(), -719162);
    testing::assert_eq(date("9999-12-31").epoch_days(), 2932896);
    testing::assert_eq(date("1970-01-01").weekday(), 4);
    testing::assert_eq(date("2000-03-01").ordinal(), 61);
    testing::assert_eq(date("1900-03-01").ordinal(), 60);
    testing::assert(date("2021-01-01").iso_week() == (2020, 53, 5));
    testing::assert(date("2019-12-30").iso_week() == (2020, 1, 1));
    testing::assert_eq(
        testing::expect_ok(dt::Date::from_iso_week(2020, 53, 7), "ISO"),
        date("2021-01-03"),
    );
    testing::assert_err(dt::Date::from_iso_week(2021, 53, 1));
    testing::assert_err(dt::Date::from_iso_week(2020, 0, 1));
    testing::assert_eq(
        testing::expect_ok(dt::Date::from_ordinal(2000, 366), "ordinal"),
        date("2000-12-31"),
    );
    testing::assert_err(dt::Date::from_ordinal(1900, 366));
}

#[test]
fn calendar_arithmetic_requires_invalid_day_policy() -> () {
    let jan = date("2023-01-31");
    testing::assert_err(jan.checked_add_months(1, dt::InvalidDay::Reject));
    testing::assert_eq(
        testing::expect_ok(jan.checked_add_months(1, dt::InvalidDay::Clamp), "clamp"),
        date("2023-02-28"),
    );
    testing::assert_eq(
        testing::expect_ok(jan.checked_add_months(1, dt::InvalidDay::Carry), "carry"),
        date("2023-03-03"),
    );
    testing::assert_eq(
        testing::expect_ok(date("2024-02-29").checked_add_years(-1, dt::InvalidDay::Clamp), "year"),
        date("2023-02-28"),
    );
    testing::assert_eq(
        testing::expect_ok(
            date("2024-03-31").checked_add_months(-1, dt::InvalidDay::Carry),
            "negative carry",
        ),
        date("2024-03-02"),
    );
    testing::assert_err(date("0001-01-01").checked_add_days(-1));
    testing::assert_err(date("9999-12-31").checked_add_days(1));
    testing::assert_err(jan.checked_add_days(9223372036854775807));
    testing::assert_err(jan.checked_add_months(9223372036854775807, dt::InvalidDay::Clamp));
    testing::assert_err(jan.checked_add_years(9223372036854775807, dt::InvalidDay::Clamp));
}

#[test]
fn negative_epoch_and_nanosecond_normalization() -> () {
    let previous = dt::UtcInstant::from_unix_nanoseconds(-1);
    testing::assert_eq(previous.to_string(), "1969-12-31T23:59:59.999999999Z");
    testing::assert_eq(previous.unix_seconds(), -1);
    testing::assert_eq(previous.nanosecond(), 999999999);
    testing::assert_eq(previous.unix_milliseconds(), -1);
    testing::assert_eq(testing::expect_ok(previous.checked_unix_nanoseconds(), "nanos"), -1);
    let duration = dt::Duration::nanoseconds(-1);
    testing::assert_eq(duration.whole_seconds(), 0);
    testing::assert_eq(duration.floor_seconds(), -1);
    testing::assert_eq(duration.subsecond_nanoseconds(), 999999999);
    let epoch = instant("1970-01-01T00:00:00Z");
    testing::assert_eq(testing::expect_ok(epoch.checked_add(duration), "subtract nanos"), previous);
    testing::assert_eq(
        testing::expect_ok(previous.checked_add(dt::Duration::nanoseconds(1)), "add nanos"),
        epoch,
    );
    testing::assert_eq(
        testing::expect_ok(previous.duration_since(epoch).checked_nanoseconds(), "difference"),
        -1,
    );
    testing::assert_eq(
        testing::expect_ok(dt::UtcInstant::from_unix_milliseconds(-1001), "negative millis").to_string(),
        "1969-12-31T23:59:58.999Z",
    );
    testing::assert_err(instant("0001-01-01T00:00:00Z").checked_add(duration));
    testing::assert_err(
        instant("9999-12-31T23:59:59.999999999Z").checked_add(dt::Duration::nanoseconds(1)),
    );
    testing::assert_err(instant("9999-01-01T00:00:00Z").checked_unix_nanoseconds());
}

#[test]
fn signed_nanosecond_extremes_are_lossless() -> () {
    for value in Vec::from_array(
        [
            -9223372036854775807 - 1,
            -9223372036854775807,
            -1000000001,
            -1000000000,
            -999999999,
            0,
            999999999,
            1000000000,
            9223372036854775807,
        ],
    ) {
        let value: i64 = value;
        testing::assert_eq(
            testing::expect_ok(dt::Duration::nanoseconds(value).checked_nanoseconds(), "duration"),
            value,
        );
        testing::assert_eq(
            testing::expect_ok(
                dt::UtcInstant::from_unix_nanoseconds(value).checked_unix_nanoseconds(),
                "instant",
            ),
            value,
        );
    }
    testing::assert_err(dt::Duration::new(9223372036854775807, 0));
    testing::assert_err(dt::Duration::days(9223372036854775807));
}

#[test]
fn rfc3339_precision_offset_and_strict_rejections() -> () {
    let value = testing::expect_ok(
        dt::OffsetDateTime::parse_rfc3339("2024-02-29t23:30:59.123456789+05:45"),
        "rfc",
    );
    testing::assert_eq(value.instant().to_string(), "2024-02-29T17:45:59.123456789Z");
    testing::assert_eq(
        testing::expect_ok(value.to_rfc3339(), "format"),
        "2024-02-29T23:30:59.123456789+05:45",
    );
    testing::assert_eq(
        instant("1970-01-01t00:00:00.100000000z").to_string(),
        "1970-01-01T00:00:00.1Z",
    );
    for invalid in Vec::from_array(
        [
            "2024-02-30T12:00:00Z",
            "2024-02-29 12:00:00Z",
            "2024-02-29T24:00:00Z",
            "2024-02-29T12:00:60Z",
            "2024-02-29T12:00:00.Z",
            "2024-02-29T12:00:00.1234567890Z",
            "2024-02-29T12:00:00-00:00",
            "2024-02-29T12:00:00+24:00",
            "2024-02-29T12:00:00+01:60",
            "2024-02-29T12:00:00+01:00:01",
            "2024-02-29T12:00:00",
            "2024-02-29T12:00:00Z ",
            "2024-02-29T12:00:00😀😀",
            "0001-01-01T00:00:00+01:00",
            "9999-12-31T23:00:00-02:00",
        ],
    ) {
        testing::assert_err(dt::OffsetDateTime::parse_rfc3339(invalid));
    }
}

#[test]
fn historical_second_offsets_and_pattern_formatting() -> () {
    let offset = testing::expect_ok(dt::Offset::parse("+00:19:32"), "offset");
    let value = testing::expect_ok(
        instant("1900-01-01T00:00:00Z").with_offset(offset),
        "historical",
    );
    testing::assert_eq(value.to_string(), "1900-01-01T00:19:32+00:19:32");
    testing::assert_err(value.to_rfc3339());
    testing::assert_eq(
        testing::expect_ok(value.format("%F %T.%f %j %G-W%V-%u %z %:z %%"), "pattern"),
        "1900-01-01 00:19:32.000000000 001 1900-W01-1 +001932 +00:19:32 %",
    );
    testing::assert_err(value.format("%Q"));
    testing::assert_err(value.format("%"));
    testing::assert_err(value.local().format("%z"));
    testing::assert_eq(
        testing::expect_ok(value.local().format("日期%Y年%m月%d日"), "unicode pattern"),
        "日期1900年01月01日",
    );
}

#[test]
fn serde_validates_and_preserves_historical_offsets() -> () {
    let value = testing::expect_ok(
        instant("1900-01-01T00:00:00.000000001Z").with_offset(
            testing::expect_ok(dt::Offset::parse("-00:25:21"), "offset"),
        ),
        "value",
    );
    let encoded = testing::expect_ok(json::try_to_string(value), "serialize");
    let decoded: dt::OffsetDateTime = testing::expect_ok(json::from_string(encoded), "deserialize");
    testing::assert_eq(decoded, value);
    let bad: Result[dt::Date, string] = json::from_string("\"2023-02-29\"");
    testing::assert_err(bad);
    let config = bincode::standard();
    let binary = testing::expect_ok(bincode::encode_to_vec(value, config), "binary encode");
    let result: (dt::OffsetDateTime, isize) = testing::expect_ok(
        bincode::decode_from_slice(binary.as_slice(), config),
        "binary decode",
    );
    testing::assert_eq(result.0, value);
    testing::assert_eq(result.1, binary.len());
    let duration = dt::Duration::nanoseconds(-1);
    let duration_json = testing::expect_ok(json::try_to_string(duration), "duration json");
    let restored: dt::Duration = testing::expect_ok(
        json::from_string(duration_json),
        "duration parse",
    );
    testing::assert_eq(restored, duration);
    let invalid: Result[dt::Duration, string] = json::from_string("[0,-1]");
    testing::assert_err(invalid);
}
