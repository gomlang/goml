package datetime;

#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    OutOfRange(string),
    Invalid(string),
    Parse {
        offset: isize,
        message: string,
    },
    TimeZone(string),
    Unsupported(string),
    Io(string),
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        self.debug()
    }
}

#[derive(Debug, PartialEq, Eq)]
pub enum InvalidDay {
    Reject,
    Clamp,
    Carry,
}

#[derive(Debug, PartialEq, Eq, Hash)]
pub struct Date {
    year_value: isize,
    month_value: isize,
    day_value: isize,
}

pub fn is_leap_year(year: isize) -> bool {
    year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}

pub fn days_in_month(year: isize, month: isize) -> Result[isize, Error] {
    if year < 1 || year > 9999 || month < 1 || month > 12 {
        return Result::Err(Error::OutOfRange("year must be 1..9999 and month 1..12"));
    }
    Result::Ok(month_length(year, month))
}

fn month_length(year: isize, month: isize) -> isize {
    match month {
        2 => if is_leap_year(year) {
            29
        } else {
            28
        },
        4 | 6 | 9 | 11 => 30,
        _ => 31,
    }
}

fn year_start(year: isize) -> i64 {
    let previous = (year - 1).to_i64();
    365 * previous + floor_div(previous, 4) - floor_div(previous, 100) + floor_div(previous, 400)
        - 719162
}

fn floor_div(value: i64, divisor: i64) -> i64 {
    let q = value / divisor;
    if value % divisor < 0 {
        q - 1
    } else {
        q
    }
}

fn floor_mod(value: i64, divisor: i64) -> i64 {
    let remainder = value % divisor;
    if remainder < 0 {
        remainder + divisor
    } else {
        remainder
    }
}

impl Date {
    pub fn new(year: isize, month: isize, day: isize) -> Result[Date, Error] {
        let length = days_in_month(year, month)?;
        if day < 1 || day > length {
            Result::Err(Error::Invalid("day does not exist in month"))
        } else {
            Result::Ok(Date { year_value: year, month_value: month, day_value: day })
        }
    }

    pub fn from_epoch_days(days: i64) -> Result[Date, Error] {
        if days < -719162 || days > 2932896 {
            return Result::Err(Error::OutOfRange("date must be between 0001-01-01 and 9999-12-31"));
        }
        Result::Ok(date_from_epoch_days(days))
    }

    pub fn from_ordinal(year: isize, ordinal: isize) -> Result[Date, Error] {
        Date::new(year, 1, 1)?;
        let length = if is_leap_year(year) {
            366
        } else {
            365
        };
        if ordinal < 1 || ordinal > length {
            return Result::Err(Error::Invalid("ordinal day out of range"));
        }
        Date::from_epoch_days(year_start(year) + ordinal.to_i64() - 1)
    }

    pub fn from_iso_week(year: isize, week: isize, weekday: isize) -> Result[Date, Error] {
        let jan4 = Date::new(year, 1, 4)?;
        if week < 1 || week > 53 || weekday < 1 || weekday > 7 {
            return Result::Err(Error::Invalid("ISO week or weekday out of range"));
        }
        let days = jan4.epoch_days() - jan4.weekday().to_i64() + 1 + (week - 1).to_i64() * 7
            + weekday.to_i64()
            - 1;
        let result = Date::from_epoch_days(days)?;
        let actual = result.iso_week();
        if actual.0 != year || actual.1 != week {
            Result::Err(Error::Invalid("ISO week does not exist in year"))
        } else {
            Result::Ok(result)
        }
    }

    pub fn year(self: Date) -> isize {
        self.year_value
    }

    pub fn month(self: Date) -> isize {
        self.month_value
    }

    pub fn day(self: Date) -> isize {
        self.day_value
    }

    pub fn ordinal(self: Date) -> isize {
        let mut result = self.day_value;
        for month in 1..self.month_value {
            result += month_length(self.year_value, month);
        }
        result
    }

    pub fn epoch_days(self: Date) -> i64 {
        year_start(self.year_value) + self.ordinal().to_i64() - 1
    }

    pub fn weekday(self: Date) -> isize {
        (floor_mod(self.epoch_days() + 3, 7) + 1).to_isize()
    }

    pub fn iso_week(self: Date) -> (isize, isize, isize) {
        let weekday = self.weekday();
        let thursday = self.epoch_days() + 4 - weekday.to_i64();
        let mut year = self.year_value;
        if thursday < year_start(year) {
            year -= 1;
        }
        if thursday >= year_start(year + 1) {
            year += 1;
        }
        let week = ((thursday - year_start(year)) / 7 + 1).to_isize();
        (year, week, weekday)
    }

    pub fn checked_add_days(self: Date, days: i64) -> Result[Date, Error] {
        if days < -3652058 || days > 3652058 {
            Result::Err(Error::OutOfRange("day arithmetic exceeds date range"))
        } else {
            Date::from_epoch_days(self.epoch_days() + days)
        }
    }

    pub fn checked_add_months(self: Date, months: i64, policy: InvalidDay) -> Result[Date, Error] {
        if months < -119987 || months > 119987 {
            return Result::Err(Error::OutOfRange("month arithmetic exceeds date range"));
        }
        let index = (self.year_value - 1).to_i64() * 12 + self.month_value.to_i64() - 1 + months;
        if index < 0 || index >= 119988 {
            return Result::Err(Error::OutOfRange("month arithmetic exceeds date range"));
        }
        let year = (index / 12 + 1).to_isize();
        let month = (index % 12 + 1).to_isize();
        let length = month_length(year, month);
        if self.day_value <= length {
            return Date::new(year, month, self.day_value);
        }
        match policy {
            InvalidDay::Reject => Result::Err(
                Error::Invalid("calendar arithmetic produced an invalid day"),
            ),
            InvalidDay::Clamp => Date::new(year, month, length),
            InvalidDay::Carry => Date::new(year, month, 1)?.checked_add_days(
                self.day_value.to_i64() - 1,
            ),
        }
    }

    pub fn checked_add_years(self: Date, years: i64, policy: InvalidDay) -> Result[Date, Error] {
        if years < -9998 || years > 9998 {
            Result::Err(Error::OutOfRange("year arithmetic exceeds date range"))
        } else {
            self.checked_add_months(years * 12, policy)
        }
    }

    pub fn days_since(self: Date, earlier: Date) -> i64 {
        self.epoch_days() - earlier.epoch_days()
    }

    pub fn compare(self: Date, other: Date) -> isize {
        compare_i64(self.epoch_days(), other.epoch_days())
    }

    pub fn at(self: Date, time: Time) -> LocalDateTime {
        LocalDateTime { date_value: self, time_value: time }
    }

    pub fn midnight(self: Date) -> LocalDateTime {
        self.at(Time::midnight())
    }
}

fn compare_i64(left: i64, right: i64) -> isize {
    if left < right {
        -1
    } else if left > right {
        1
    } else {
        0
    }
}

#[derive(Debug, PartialEq, Eq, Hash)]
pub struct Time {
    seconds_value: isize,
    nanos_value: isize,
}

impl Time {
    pub fn new(hour: isize, minute: isize, second: isize, nanosecond: isize) -> Result[Time, Error] {
        if hour < 0 || hour > 23 || minute < 0 || minute > 59 || second < 0 || second > 59
            || nanosecond < 0
            || nanosecond > 999999999 {
            Result::Err(
                Error::OutOfRange(
                    "time requires hour 0..23, minute/second 0..59, nanosecond 0..999999999",
                ),
            )
        } else {
            Result::Ok(
                Time { seconds_value: hour * 3600 + minute * 60 + second, nanos_value: nanosecond },
            )
        }
    }

    pub fn midnight() -> Time {
        Time { seconds_value: 0, nanos_value: 0 }
    }

    pub fn hour(self: Time) -> isize {
        self.seconds_value / 3600
    }

    pub fn minute(self: Time) -> isize {
        self.seconds_value / 60 % 60
    }

    pub fn second(self: Time) -> isize {
        self.seconds_value % 60
    }

    pub fn nanosecond(self: Time) -> isize {
        self.nanos_value
    }

    pub fn seconds_since_midnight(self: Time) -> isize {
        self.seconds_value
    }

    pub fn compare(self: Time, other: Time) -> isize {
        let seconds = compare_i64(self.seconds_value.to_i64(), other.seconds_value.to_i64());
        if seconds == 0 {
            compare_i64(self.nanos_value.to_i64(), other.nanos_value.to_i64())
        } else {
            seconds
        }
    }
}

#[derive(Debug, PartialEq, Eq, Hash)]
pub struct LocalDateTime {
    date_value: Date,
    time_value: Time,
}

impl LocalDateTime {
    pub fn new(date: Date, time: Time) -> LocalDateTime {
        date.at(time)
    }

    pub fn date(self: LocalDateTime) -> Date {
        self.date_value
    }

    pub fn time(self: LocalDateTime) -> Time {
        self.time_value
    }

    pub fn assume_utc(self: LocalDateTime) -> UtcInstant {
        UtcInstant {
            seconds_value: self.date_value.epoch_days() * 86400
                + self.time_value.seconds_value.to_i64(),
            nanos_value: self.time_value.nanos_value,
        }
    }

    pub fn assume_offset(self: LocalDateTime, offset: Offset) -> Result[OffsetDateTime, Error] {
        let instant = UtcInstant::new(
            self.assume_utc().seconds_value - offset.seconds_value.to_i64(),
            self.time_value.nanos_value,
        )?;
        Result::Ok(OffsetDateTime { instant_value: instant, offset_value: offset })
    }

    pub fn checked_add(self: LocalDateTime, duration: Duration) -> Result[LocalDateTime, Error] {
        Result::Ok(self.assume_utc().checked_add(duration)?.to_utc())
    }

    pub fn checked_add_months(self: LocalDateTime, months: i64, policy: InvalidDay) -> Result[
        LocalDateTime,
        Error,
    ] {
        Result::Ok(self.date_value.checked_add_months(months, policy)?.at(self.time_value))
    }

    pub fn compare(self: LocalDateTime, other: LocalDateTime) -> isize {
        self.assume_utc().compare(other.assume_utc())
    }
}

fn date_from_epoch_days(days: i64) -> Date {
    let mut low = 1;
    let mut high = 10000;
    while low + 1 < high {
        let middle = (low + high) / 2;
        if year_start(middle) <= days {
            low = middle;
        } else {
            high = middle;
        }
    }
    let mut remaining = (days - year_start(low)).to_isize();
    let mut month = 1;
    while remaining >= month_length(low, month) {
        remaining -= month_length(low, month);
        month += 1;
    }
    Date { year_value: low, month_value: month, day_value: remaining + 1 }
}
