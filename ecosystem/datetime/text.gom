package datetime;

fn padded(value: isize, width: isize) -> string {
    let mut result = value.to_string();
    while result.byte_len() < width {
        result = "0" + result;
    }
    result
}

fn parse_error(offset: isize, message: string) -> Error {
    Error::Parse { offset, message }
}

fn digits(text: string, start: isize, length: isize) -> Result[isize, Error] {
    if start < 0 || length < 1 || start + length > text.byte_len() {
        return Result::Err(parse_error(start, "missing digits"));
    }
    let mut result = 0;
    for index in start..start + length {
        let byte = text.byte_get(index);
        if byte < b'0' || byte > b'9' {
            return Result::Err(parse_error(index, "expected ASCII digit"));
        }
        result = result * 10 + (byte - b'0').to_isize();
    }
    Result::Ok(result)
}

fn separator(text: string, position: isize, expected: byte) -> Result[(), Error] {
    if position >= text.byte_len() || text.byte_get(position) != expected {
        Result::Err(parse_error(position, "unexpected separator"))
    } else {
        Result::Ok(())
    }
}

impl ToString for Date {
    fn to_string(self: Date) -> string {
        padded(self.year_value, 4) + "-" + padded(self.month_value, 2) + "-"
            + padded(self.day_value, 2)
    }
}

impl Date {
    pub fn parse(text: string) -> Result[Date, Error] {
        if text.byte_len() != 10 {
            return Result::Err(parse_error(0, "date requires YYYY-MM-DD"));
        }
        separator(text, 4, b'-')?;
        separator(text, 7, b'-')?;
        Date::new(digits(text, 0, 4)?, digits(text, 5, 2)?, digits(text, 8, 2)?)
    }
}

impl ToString for Time {
    fn to_string(self: Time) -> string {
        let base = padded(self.hour(), 2) + ":" + padded(self.minute(), 2) + ":"
            + padded(self.second(), 2);
        if self.nanos_value == 0 {
            return base;
        }
        let fraction = padded(self.nanos_value, 9);
        let mut end = 9;
        while fraction.byte_get(end - 1) == b'0' {
            end -= 1;
        }
        base + "." + fraction.byte_slice(0, end)
    }
}

impl Time {
    pub fn parse(text: string) -> Result[Time, Error] {
        let length = text.byte_len();
        if length != 8 && (length < 10 || length > 18) {
            return Result::Err(
                parse_error(0, "time requires HH:MM:SS with at most nine fractional digits"),
            );
        }
        separator(text, 2, b':')?;
        separator(text, 5, b':')?;
        let mut nanos = 0;
        if length > 8 {
            separator(text, 8, b'.')?;
            nanos = digits(text, 9, length - 9)?;
            for _ in length - 9..9 {
                nanos *= 10;
            }
        }
        Time::new(digits(text, 0, 2)?, digits(text, 3, 2)?, digits(text, 6, 2)?, nanos)
    }
}

impl ToString for LocalDateTime {
    fn to_string(self: LocalDateTime) -> string {
        self.date_value.to_string() + "T" + self.time_value.to_string()
    }
}

impl LocalDateTime {
    pub fn parse(text: string) -> Result[LocalDateTime, Error] {
        if text.byte_len() < 19 {
            return Result::Err(parse_error(0, "local datetime requires date and time"));
        }
        separator(text, 10, b'T')?;
        Result::Ok(
            Date::parse(text.byte_slice(0, 10))?.at(
                Time::parse(text.byte_slice(11, text.byte_len()))?,
            ),
        )
    }

    pub fn format(self: LocalDateTime, pattern: string) -> Result[string, Error] {
        format_pattern(self, Option::None, pattern)
    }
}

impl ToString for Offset {
    fn to_string(self: Offset) -> string {
        let seconds = if self.seconds_value < 0 {
            -self.seconds_value
        } else {
            self.seconds_value
        };
        let sign = if self.seconds_value < 0 {
            "-"
        } else {
            "+"
        };
        let base = sign + padded(seconds / 3600, 2) + ":" + padded(seconds / 60 % 60, 2);
        if seconds % 60 == 0 {
            base
        } else {
            base + ":" + padded(seconds % 60, 2)
        }
    }
}

impl Offset {
    pub fn parse(text: string) -> Result[Offset, Error] {
        if text == "Z" {
            return Result::Ok(Offset::utc());
        }
        if text.byte_len() != 6 && text.byte_len() != 9 {
            return Result::Err(parse_error(0, "offset requires Z or signed HH:MM[:SS]"));
        }
        let negative = match text.byte_get(0) {
            b'+' => false,
            b'-' => true,
            _ => return Result::Err(parse_error(0, "offset sign required")),
        };
        separator(text, 3, b':')?;
        let hour = digits(text, 1, 2)?;
        let minute = digits(text, 4, 2)?;
        let second = if text.byte_len() == 9 {
            separator(text, 6, b':')?;
            digits(text, 7, 2)?
        } else {
            0
        };
        if minute > 59 || second > 59 {
            return Result::Err(parse_error(4, "offset minute/second out of range"));
        }
        let total = hour * 3600 + minute * 60 + second;
        Offset::from_seconds(
            if negative {
                -total
            } else {
                total
            },
        )
    }
}

impl ToString for UtcInstant {
    fn to_string(self: UtcInstant) -> string {
        self.to_utc().to_string() + "Z"
    }
}

impl UtcInstant {
    pub fn parse(text: string) -> Result[UtcInstant, Error] {
        Result::Ok(OffsetDateTime::parse_rfc3339(text)?.instant())
    }
}

impl OffsetDateTime {
    pub fn parse_rfc3339(text: string) -> Result[OffsetDateTime, Error] {
        for index in 0..text.byte_len() {
            if text.byte_get(index) >= 128 {
                return Result::Err(parse_error(index, "RFC3339 requires ASCII"));
            }
        }
        let length = text.byte_len();
        if length < 20 || length > 35 {
            return Result::Err(parse_error(0, "RFC3339 datetime length out of range"));
        }
        let mut offset_start = length - 1;
        let offset = if text.byte_get(length - 1) == b'Z' || text.byte_get(length - 1) == b'z' {
            Offset::utc()
        } else {
            offset_start = length - 6;
            let suffix = text.byte_slice(offset_start, length);
            if suffix == "-00:00" {
                return Result::Err(
                    Error::Unsupported(
                        "RFC3339 unknown local offset -00:00 cannot denote a known offset",
                    ),
                );
            }
            let offset = Offset::parse(suffix)?;
            if offset.seconds_value <= -86400 || offset.seconds_value >= 86400 {
                return Result::Err(parse_error(offset_start, "RFC3339 offset hour exceeds 23"));
            }
            offset
        };
        if text.byte_get(10) != b'T' && text.byte_get(10) != b't' {
            return Result::Err(parse_error(10, "RFC3339 requires T separator"));
        }
        let date = Date::parse(text.byte_slice(0, 10))?;
        let time = Time::parse(text.byte_slice(11, offset_start))?;
        date.at(time).assume_offset(offset)
    }

    pub fn to_rfc3339(self: OffsetDateTime) -> Result[string, Error] {
        let seconds = self.offset_value.seconds_value;
        if seconds % 60 != 0 || seconds <= -86400 || seconds >= 86400 {
            return Result::Err(Error::Unsupported("RFC3339 cannot represent this offset"));
        }
        Result::Ok(
            self.local().to_string()
                + if seconds == 0 {
                    "Z"
                } else {
                    self.offset_value.to_string()
                },
        )
    }

    pub fn format(self: OffsetDateTime, pattern: string) -> Result[string, Error] {
        format_pattern(self.local(), Option::Some(self.offset_value), pattern)
    }
}

impl ToString for OffsetDateTime {
    fn to_string(self: OffsetDateTime) -> string {
        self.local().to_string() + self.offset_value.to_string()
    }
}

fn format_pattern(local: LocalDateTime, offset: Option[Offset], pattern: string) -> Result[
    string,
    Error,
] {
    let date = local.date_value;
    let time = local.time_value;
    let iso = date.iso_week();
    let mut result = "";
    let mut index = 0;
    while index < pattern.byte_len() {
        if pattern.byte_get(index) != b'%' {
            let start = index;
            while index < pattern.byte_len() && pattern.byte_get(index) != b'%' {
                index += 1;
            }
            result += pattern.byte_slice(start, index);
            continue;
        }
        index += 1;
        if index == pattern.byte_len() {
            return Result::Err(parse_error(index, "incomplete format directive"));
        }
        result += match pattern.byte_get(index) {
            b'%' => "%",
            b'Y' => padded(date.year_value, 4),
            b'm' => padded(date.month_value, 2),
            b'd' => padded(date.day_value, 2),
            b'H' => padded(time.hour(), 2),
            b'M' => padded(time.minute(), 2),
            b'S' => padded(time.second(), 2),
            b'f' => padded(time.nanos_value, 9),
            b'j' => padded(date.ordinal(), 3),
            b'u' => date.weekday().to_string(),
            b'G' => padded(iso.0, 4),
            b'V' => padded(iso.1, 2),
            b'F' => date.to_string(),
            b'T' => padded(time.hour(), 2) + ":" + padded(time.minute(), 2) + ":"
                + padded(time.second(), 2),
            b'z' => match offset {
                Some(value) => value.to_string().replace(":", ""),
                None => return Result::Err(
                    parse_error(index, "offset directive requires offset datetime"),
                ),
            },
            b':' => {
                index += 1;
                if index >= pattern.byte_len() || pattern.byte_get(index) != b'z' {
                    return Result::Err(parse_error(index, "expected z after %:"));
                }
                match offset {
                    Some(value) => value.to_string(),
                    None => return Result::Err(
                        parse_error(index, "offset directive requires offset datetime"),
                    ),
                }
            },
            _ => return Result::Err(parse_error(index, "unsupported format directive")),
        };
        index += 1;
    }
    Result::Ok(result)
}
