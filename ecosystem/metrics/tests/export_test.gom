package tests;

use ecosystem::metrics as metrics;
use std::testing;

#[test]
fn prometheus_fixed_vector_escaping_order_types_and_histogram_suffixes() -> () {
    let registry = registry();
    let gauge = testing::expect_ok(
        registry.gauge(metrics::Descriptor::gauge("z_temperature", "temperature"), empty()),
        "gauge",
    );
    testing::assert_ok(gauge.set(-2.5));
    let latency = testing::expect_ok(
        registry.histogram(
            metrics::Descriptor::histogram(
                "latency_seconds",
                "Request latency",
                Vec::from_array([0.1, 0.5]),
            ).with_labels(Vec::from_array(["method"])).with_unit("seconds"),
            labels("method", "GET"),
        ),
        "histogram",
    );
    testing::assert_ok(latency.observe(0.1));
    testing::assert_ok(latency.observe(0.3));
    testing::assert_ok(latency.observe(1.0));
    let descriptor = metrics::Descriptor::counter("a_calls_total", "Calls\\count\nSecond line").with_labels(
        Vec::from_array(["route", "method"]),
    );
    let value = testing::expect_ok(
        registry.counter(
            descriptor,
            testing::expect_ok(
                metrics::Labels::new(Vec::from_array([("route", "/中\"\\\n"), ("method", "GET")])),
                "labels",
            ),
        ),
        "counter",
    );
    testing::assert_ok(value.add(7));
    let expected = "# HELP a_calls_total Calls\\\\count\\nSecond line\n# TYPE a_calls_total counter\na_calls_total{method=\"GET\",route=\"/中\\\"\\\\\\n\"} 7\n"
        + "# HELP latency_seconds Request latency\n# TYPE latency_seconds histogram\nlatency_seconds_bucket{method=\"GET\",le=\"0.1\"} 1\nlatency_seconds_bucket{method=\"GET\",le=\"0.5\"} 2\nlatency_seconds_bucket{method=\"GET\",le=\"+Inf\"} 3\nlatency_seconds_sum{method=\"GET\"} 1.4\nlatency_seconds_count{method=\"GET\"} 3\n"
        + "# HELP z_temperature temperature\n# TYPE z_temperature gauge\nz_temperature -2.5\n";
    testing::assert_eq(registry.render(), expected);
    testing::assert_eq(metrics::content_type(), "text/plain; version=0.0.4; charset=utf-8");
}

#[test]
fn snapshot_is_detached_and_cannot_be_mutated_through_public_views() -> () {
    let registry = registry();
    let value = histogram(registry, "histogram");
    testing::assert_ok(value.observe(0.25));
    let snapshot = registry.snapshot();
    let before = snapshot.prometheus();
    testing::assert_ok(value.observe(0.5));
    testing::assert_eq(snapshot.prometheus(), before);
    testing::assert(registry.render() != before);
    let families = snapshot.families();
    families[0].descriptor.buckets[0] = 200.0;
    if let metrics::Value::Histogram(histogram) = families[0].samples[0].value {
        histogram.cumulative[0] = 999;
        histogram.boundaries[0] = 300.0;
    }
    testing::assert_eq(snapshot.prometheus(), before);
    let again = snapshot.families();
    testing::assert_eq(again[0].descriptor.buckets[0], 0.1);
}

#[test]
fn zero_series_negative_zero_and_metadata_only_families_export_deterministically() -> () {
    let registry = registry();
    testing::assert_ok(
        registry.register(metrics::Descriptor::counter("metadata_total", "No samples")),
    );
    let values = metrics::Descriptor::gauge("sample", "Ordered").with_labels(
        Vec::from_array(["key"]),
    );
    for key in Vec::from_array(["z", "a", "", "m"]) {
        let gauge = testing::expect_ok(registry.gauge(values, labels("key", key)), "gauge");
        testing::assert_ok(gauge.set(float64_from_bits(0x8000000000000000)));
    }
    let expected = "# HELP metadata_total No samples\n# TYPE metadata_total counter\n# HELP sample Ordered\n# TYPE sample gauge\nsample{key=\"\"} 0\nsample{key=\"a\"} 0\nsample{key=\"m\"} 0\nsample{key=\"z\"} 0\n";
    testing::assert_eq(registry.render(), expected);
    testing::assert_eq(registry.render(), registry.render());
    let empty_histogram = testing::expect_ok(
        registry.histogram(
            metrics::Descriptor::histogram("no_bounds", "Only infinity", Vec::new()),
            empty(),
        ),
        "histogram",
    );
    testing::assert_ok(empty_histogram.observe(10.0));
    testing::assert(registry.render().contains("no_bounds_bucket{le=\"+Inf\"} 1\n"));
}
