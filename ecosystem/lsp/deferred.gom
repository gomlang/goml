package lsp;

use std::json;
use std::time;

pub struct PendingRequest {
    token_value: RequestToken,
    params_value: Option[json::Value],
    started: time::Instant,
    timeout: Option[time::Duration],
}

impl PendingRequest {
    pub fn token(self: PendingRequest) -> RequestToken {
        self.token_value
    }

    pub fn params(self: PendingRequest) -> Option[json::Value] {
        self.params_value
    }

    pub fn remaining(self: PendingRequest) -> Option[time::Duration] {
        self.timeout.map(|timeout| timeout.saturating_subtract(self.started.elapsed()))
    }

    fn expired(self: PendingRequest) -> bool {
        match self.timeout {
            Some(timeout) => self.started.elapsed().compare(timeout) >= 0,
            None => false,
        }
    }
}

pub struct Dispatch {
    pub event: Event,
    pub request: Option[PendingRequest],
}

fn request_timeout() -> RpcError {
    RpcError::new(-32803, "request deadline exceeded")
}

impl Server {
    pub fn accept(self: Server, message: Message) -> Result[Dispatch, RpcError] {
        self.accept_with_timeout(message, Option::None)
    }

    pub fn accept_with_timeout(self: Server, message: Message, timeout: Option[time::Duration]) -> Result[
        Dispatch,
        RpcError,
    ] {
        let _ = decode_value(encode_value(message))?;
        self.prune_timeouts();
        if let Message::Request(id, method, params) = message {
            if self.phase() == Phase::Running && method != "initialize" && method != "shutdown"
                && !method.starts_with("$/")
                && self.router_value.requests.contains(method) {
                let token = match self.session_value.begin(id, method) {
                    Ok(token) => token,
                    Err(problem) => return Result::Ok(
                        Dispatch {
                            event: Event {
                                reply: Option::Some(
                                    Message::Response(Option::Some(id), Result::Err(problem)),
                                ),
                                ..empty_event(),
                            },
                            request: Option::None,
                        },
                    ),
                };
                let request = PendingRequest {
                    token_value: token,
                    params_value: params,
                    started: time::Instant::now(),
                    timeout,
                };
                if timeout.is_some() {
                    self.timed_requests.push(request);
                }
                return Result::Ok(Dispatch { event: empty_event(), request: Option::Some(request) })
            }
        }
        Result::Ok(Dispatch { event: self.handle_immediate(message)?, request: Option::None })
    }

    pub fn complete(self: Server, request: PendingRequest, result: Result[json::Value, RpcError]) -> Result[
        Message,
        RpcError,
    ] {
        self.session_value.validate_incoming(request.token_value)?;
        let result = if request.expired() {
            Result::Err(request_timeout())
        } else {
            result
        };
        let reply = self.session_value.complete(request.token_value, result)?;
        self.prune_timeouts();
        Result::Ok(reply)
    }

    pub fn execute(self: Server, request: PendingRequest) -> Result[Message, RpcError] {
        self.session_value.validate_incoming(request.token_value)?;
        if request.expired() {
            return self.complete(request, Result::Err(request_timeout()))
        }
        let result = self.router_value.dispatch(
            RequestContext { token: request.token_value, documents: self.documents_value },
            request.params_value,
        );
        self.complete(request, result)
    }

    pub fn handle(self: Server, message: Message) -> Result[Event, RpcError] {
        let dispatch = self.accept(message)?;
        match dispatch.request {
            Some(request) => Result::Ok(
                Event { reply: Option::Some(self.execute(request)?), ..dispatch.event },
            ),
            None => Result::Ok(dispatch.event),
        }
    }

    fn prune_timeouts(self: Server) -> () {
        let active: Vec[PendingRequest] = Vec::new();
        for request in self.timed_requests {
            if request.token_value.is_active() {
                active.push(request);
            }
        }
        self.timed_requests.clear();
        self.timed_requests.extend(active);
    }

    pub fn next_timeout(self: Server) -> Option[time::Duration] {
        self.prune_timeouts();
        let mut earliest = self.session_value.next_outgoing_timeout();
        for request in self.timed_requests {
            if let Some(remaining) = request.remaining() {
                if earliest.is_none() || remaining.compare(earliest.unwrap_or(remaining)) < 0 {
                    earliest = Option::Some(remaining);
                }
            }
        }
        earliest
    }

    pub fn poll_timeouts(self: Server) -> Result[Vec[Message], RpcError] {
        let replies: Vec[Message] = Vec::new();
        for request in self.timed_requests.copy() {
            if request.token_value.is_active() && request.expired() {
                replies.push(
                    self.session_value.complete(request.token_value, Result::Err(request_timeout()))?,
                );
            }
        }
        self.prune_timeouts();
        Result::Ok(replies)
    }
}
