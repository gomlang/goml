package lsp;

use std::time;

struct OutgoingDeadline {
    started: time::Instant,
    duration: time::Duration,
}

impl OutgoingDeadline {
    fn remaining(self: OutgoingDeadline) -> time::Duration {
        self.duration.saturating_subtract(self.started.elapsed())
    }

    fn expired(self: OutgoingDeadline) -> bool {
        self.started.elapsed().compare(self.duration) >= 0
    }
}

pub struct ExpiredRequest {
    pub completed: Completed,
    pub cancellation: Message,
}

impl Session {
    pub fn next_outgoing_timeout(self: Session) -> Option[time::Duration] {
        let mut earliest: Option[time::Duration] = Option::None;
        for (_, deadline) in self.outgoing_deadlines.entries() {
            let remaining = deadline.remaining();
            if earliest.is_none() || remaining.compare(earliest.unwrap_or(remaining)) < 0 {
                earliest = Option::Some(remaining);
            }
        }
        earliest
    }

    pub fn poll_outgoing_timeouts(self: Session) -> Result[Vec[ExpiredRequest], RpcError] {
        let expired: Vec[ExpiredRequest] = Vec::new();
        for (id, deadline) in self.outgoing_deadlines.entries() {
            if deadline.expired() {
                let token = self.outgoing.get(id).ok_or(invalid("deadline has no pending request"))?;
                let cancellation = self.expire(id)?;
                expired.push(
                    ExpiredRequest {
                        completed: Completed {
                            id,
                            method: token.method(),
                            result: Result::Err(request_timeout()),
                        },
                        cancellation,
                    },
                );
            }
        }
        Result::Ok(expired)
    }
}

impl Server {
    pub fn poll_outgoing_timeouts(self: Server) -> Result[Vec[ExpiredRequest], RpcError] {
        self.session_value.poll_outgoing_timeouts()
    }
}
