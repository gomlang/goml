package lsp;

use ecosystem::rope;
use std::json;
use std::text;

#[derive(Debug, PartialEq, Eq)]
pub struct Position {
    pub line: isize,
    pub character: isize,
}

#[derive(Debug, PartialEq, Eq)]
pub struct Range {
    pub start: Position,
    pub end: Position,
}

impl Position {
    pub fn from_json(value: json::Value) -> Result[Position, RpcError] {
        let _ = members(value)?;
        Result::Ok(
            Position {
                line: unsigned(required(value, "line")?)?,
                character: unsigned(required(value, "character")?)?,
            },
        )
    }

    pub fn to_json(self: Position) -> json::Value {
        json::object(
            Vec::from_array(
                [
                    ("line", json::Value::Number(self.line.to_string())),
                    ("character", json::Value::Number(self.character.to_string())),
                ],
            ),
        )
    }
}

impl Range {
    pub fn from_json(value: json::Value) -> Result[Range, RpcError] {
        let _ = members(value)?;
        let range = Range {
            start: Position::from_json(required(value, "start")?)?,
            end: Position::from_json(required(value, "end")?)?,
        };
        if before(range.end, range.start) {
            Result::Err(invalid("reversed range"))
        } else {
            Result::Ok(range)
        }
    }

    pub fn to_json(self: Range) -> json::Value {
        json::object(
            Vec::from_array([("start", self.start.to_json()), ("end", self.end.to_json())]),
        )
    }
}

fn before(left: Position, right: Position) -> bool {
    left.line < right.line || (left.line == right.line && left.character < right.character)
}

pub struct TextEdit {
    pub range: Range,
    pub new_text: string,
}

impl TextEdit {
    pub fn from_json(value: json::Value) -> Result[TextEdit, RpcError] {
        let _ = members(value)?;
        Result::Ok(
            TextEdit {
                range: Range::from_json(required(value, "range")?)?,
                new_text: string_field(value, "newText")?,
            },
        )
    }

    pub fn to_json(self: TextEdit) -> json::Value {
        json::object(
            Vec::from_array(
                [("range", self.range.to_json()), ("newText", json::Value::String(self.new_text))],
            ),
        )
    }
}

pub struct Change {
    pub range: Option[Range],
    pub range_length: Option[isize],
    pub text: string,
}

impl Change {
    pub fn from_json(value: json::Value) -> Result[Change, RpcError] {
        let _ = members(value)?;
        let range = match json::field(value, "range") {
            Some(value) => Option::Some(Range::from_json(value)?),
            None => Option::None,
        };
        let range_length = match json::field(value, "rangeLength") {
            Some(value) => Option::Some(unsigned(value)?),
            None => Option::None,
        };
        if range.is_none() && range_length.is_some() {
            return Result::Err(invalid("rangeLength requires range"))
        }
        Result::Ok(Change { range, range_length, text: string_field(value, "text")? })
    }
}

pub struct Document {
    uri_value: string,
    language_value: string,
    version_value: isize,
    text_value: rope::Rope,
    encoding_value: PositionEncoding,
}

impl Document {
    pub fn new(uri: string, language_id: string, version: isize, content: string) -> Result[
        Document,
        RpcError,
    ] {
        Document::new_with_encoding(uri, language_id, version, content, PositionEncoding::Utf16)
    }

    pub fn new_with_encoding(
        uri: string,
        language_id: string,
        version: isize,
        content: string,
        encoding: PositionEncoding,
    ) -> Result[Document, RpcError] {
        let _ = integer(json::Value::Number(version.to_string()))?;
        if uri == "" {
            return Result::Err(invalid("document URI must not be empty"))
        }
        Result::Ok(
            Document {
                uri_value: uri,
                language_value: language_id,
                version_value: version,
                encoding_value: encoding,
                text_value: rope::Rope::from_string(content).map_err(
                    |error| invalid(error.to_string()),
                )?,
            },
        )
    }

    pub fn encoding(self: Document) -> PositionEncoding {
        self.encoding_value
    }

    fn units(self: Document, offset: isize) -> Result[isize, RpcError] {
        match self.encoding_value {
            Utf8 => Result::Ok(offset),
            Utf16 => self.text_value.byte_to_utf16(offset).map_err(
                |error| invalid(error.to_string()),
            ),
            Utf32 => self.text_value.byte_to_scalar(offset).map_err(
                |error| invalid(error.to_string()),
            ),
        }
    }

    pub fn uri(self: Document) -> string {
        self.uri_value
    }

    pub fn language_id(self: Document) -> string {
        self.language_value
    }

    pub fn version(self: Document) -> isize {
        self.version_value
    }

    pub fn content(self: Document) -> string {
        self.text_value.to_string()
    }

    pub fn line_count(self: Document) -> isize {
        self.text_value.len_lines()
    }

    pub fn position(self: Document, offset: isize) -> Result[Position, RpcError] {
        if offset < 0 || offset > self.text_value.len_bytes()
            || !self.text_value.is_char_boundary(offset) {
            return Result::Err(invalid("byte offset is outside the document or splits UTF-8"))
        }
        let line = self.text_value.byte_to_line(offset).map_err(|error| invalid(error.to_string()))?;
        let (start, end) = self.text_value.line_bounds(line, false).map_err(
            |error| invalid(error.to_string()),
        )?;
        let clamped = if offset > end {
            end
        } else {
            offset
        };
        let first = self.units(start)?;
        let current = self.units(clamped)?;
        Result::Ok(Position { line, character: current - first })
    }

    pub fn offset(self: Document, position: Position) -> Result[isize, RpcError] {
        if position.line < 0 || position.line >= self.text_value.len_lines()
            || position.character < 0
            || position.character > 2147483647 {
            return Result::Err(invalid("position outside document"))
        }
        let (start, end) = self.text_value.line_bounds(position.line, false).map_err(
            |error| invalid(error.to_string()),
        )?;
        let first = self.units(start)?;
        let last = self.units(end)?;
        if position.character >= last - first {
            return Result::Ok(end)
        }
        let index = first + position.character;
        match self.encoding_value {
            Utf8 => if self.text_value.is_char_boundary(index) {
                Result::Ok(index)
            } else {
                Result::Err(invalid("position splits a UTF-8 scalar"))
            },
            Utf16 => self.text_value.utf16_to_byte(index).map_err(
                |_| invalid("position splits a UTF-16 surrogate pair"),
            ),
            Utf32 => self.text_value.scalar_to_byte(index).map_err(
                |error| invalid(error.to_string()),
            ),
        }
    }

    pub fn offsets(self: Document, range: Range) -> Result[(isize, isize), RpcError] {
        if before(range.end, range.start) {
            return Result::Err(invalid("reversed range"))
        }
        Result::Ok((self.offset(range.start)?, self.offset(range.end)?))
    }

    pub fn text_in(self: Document, range: Range) -> Result[string, RpcError] {
        let (start, end) = self.offsets(range)?;
        Result::Ok(
            self.text_value.slice_bytes(start, end).map_err(|error| invalid(error.to_string()))?.to_string(),
        )
    }

    pub fn changed(self: Document, version: isize, changes: Vec[Change], max_bytes: isize) -> Result[
        Document,
        RpcError,
    ] {
        if version <= self.version_value {
            return Result::Err(invalid("document version must increase"))
        }
        let _ = integer(json::Value::Number(version.to_string()))?;
        if max_bytes < 0 {
            return Result::Err(invalid("invalid document size limit"))
        }
        let mut result = self;
        for change in changes {
            let (start, end) = match change.range {
                Some(range) => result.offsets(range)?,
                None => (0, result.text_value.len_bytes()),
            };
            if let Some(expected) = change.range_length {
                if change.range.is_none() || expected != result.units(end)? - result.units(start)? {
                    return Result::Err(
                        invalid(
                            "rangeLength does not match replaced length in the negotiated encoding",
                        ),
                    )
                }
            }
            if result.text_value.len_bytes() - (end - start) > max_bytes
                || change.text.byte_len()
                    > max_bytes - (result.text_value.len_bytes() - (end - start)) {
                return Result::Err(invalid("document size limit exceeded"))
            }
            let replacement = rope::Rope::from_string(change.text).map_err(
                |error| invalid(error.to_string()),
            )?;
            let content = result.text_value.replace_bytes(start, end, replacement).map_err(
                |error| invalid(error.to_string()),
            )?;
            result = Document { text_value: content, version_value: version, ..result };
        }
        if result.text_value.len_bytes() > max_bytes {
            return Result::Err(invalid("document size limit exceeded"))
        }
        Result::Ok(Document { version_value: version, ..result })
    }

    pub fn apply_edits(self: Document, edits: Vec[TextEdit]) -> Result[string, RpcError] {
        let spans: Vec[(isize, isize, isize, string)] = Vec::new();
        for index in 0..edits.len() {
            let edit = edits[index];
            let (start, end) = self.offsets(edit.range)?;
            spans.push((start, end, index, edit.new_text));
        }
        spans.sort_by(
            |left, right| if left.0 == right.0 {
                left.2 - right.2
            } else {
                left.0 - right.0
            },
        );
        let output = text::StringBuilder::new();
        let mut cursor: isize = 0;
        for (start, end, _, replacement) in spans {
            if start < cursor {
                return Result::Err(invalid("overlapping text edits"))
            }
            let unchanged = self.text_value.slice_bytes(cursor, start).map_err(
                |error| invalid(error.to_string()),
            )?;
            for chunk in unchanged.chunks() {
                output.write_string(chunk);
            }
            output.write_string(replacement);
            cursor = end;
        }
        let remaining = self.text_value.slice_bytes(cursor, self.text_value.len_bytes()).map_err(
            |error| invalid(error.to_string()),
        )?;
        for chunk in remaining.chunks() {
            output.write_string(chunk);
        }
        Result::Ok(output.finish())
    }
}

pub fn utf16_length(value: string) -> isize {
    let mut result: isize = 0;
    for ch in value.chars() {
        result += if ch.to_string().byte_len() == 4 {
            2
        } else {
            1
        };
    }
    result
}

pub struct Documents {
    values: HashMap[string, Document],
    encoding_value: Ref[PositionEncoding],
    max_documents: isize,
    max_bytes: isize,
}

impl Documents {
    pub fn new(max_documents: isize, max_bytes: isize) -> Result[Documents, RpcError] {
        Documents::new_with_encoding(max_documents, max_bytes, PositionEncoding::Utf16)
    }

    pub fn new_with_encoding(max_documents: isize, max_bytes: isize, encoding: PositionEncoding) -> Result[
        Documents,
        RpcError,
    ] {
        if max_documents < 0 || max_bytes < 0 {
            return Result::Err(invalid("invalid document limits"))
        }
        Result::Ok(
            Documents {
                values: HashMap::new(),
                encoding_value: Ref::new(encoding),
                max_documents,
                max_bytes,
            },
        )
    }

    pub fn encoding(self: Documents) -> PositionEncoding {
        self.encoding_value.get()
    }

    fn select_encoding(self: Documents, encoding: PositionEncoding) -> () {
        self.encoding_value.set(encoding);
        for (uri, document) in self.values.entries() {
            self.values.set(uri, Document { encoding_value: encoding, ..document });
        }
    }

    pub fn len(self: Documents) -> isize {
        self.values.len()
    }

    pub fn get(self: Documents, uri: string) -> Option[Document] {
        self.values.get(uri)
    }

    pub fn open(self: Documents, document: Document) -> Result[(), RpcError] {
        if self.values.contains(document.uri()) {
            return Result::Err(invalid("document already open"))
        }
        if self.values.len() >= self.max_documents || document.content().byte_len() > self.max_bytes {
            return Result::Err(invalid("document limit exceeded"))
        }
        self.values.set(document.uri(), Document { encoding_value: self.encoding(), ..document });
        Result::Ok(())
    }

    pub fn close(self: Documents, uri: string) -> Result[Document, RpcError] {
        self.values.remove_value(uri).ok_or(invalid("document is not open"))
    }

    pub fn change(self: Documents, uri: string, version: isize, changes: Vec[Change]) -> Result[
        Document,
        RpcError,
    ] {
        let current = self.values.get(uri).ok_or(invalid("document is not open"))?;
        let next = current.changed(version, changes, self.max_bytes)?;
        self.values.set(uri, next);
        Result::Ok(next)
    }

    pub fn synchronize(self: Documents, method: string, params: json::Value) -> Result[
        bool,
        RpcError,
    ] {
        if method != "textDocument/didOpen" && method != "textDocument/didClose"
            && method != "textDocument/didChange" {
            return Result::Ok(false)
        }
        let _ = members(params)?;
        let document = required(params, "textDocument")?;
        let _ = members(document)?;
        let uri = string_field(document, "uri")?;
        if method == "textDocument/didOpen" {
            self.open(
                Document::new(
                    uri,
                    string_field(document, "languageId")?,
                    integer(required(document, "version")?)?,
                    string_field(document, "text")?,
                )?,
            )?;
        } else if method == "textDocument/didClose" {
            let _ = self.close(uri)?;
        } else {
            let version = integer(required(document, "version")?)?;
            let values = json::as_array(required(params, "contentChanges")?).ok_or(
                invalid("contentChanges must be an array"),
            )?;
            let changes: Vec[Change] = Vec::new();
            for value in values {
                changes.push(Change::from_json(value)?);
            }
            let _ = self.change(uri, version, changes)?;
        }
        Result::Ok(true)
    }
}
