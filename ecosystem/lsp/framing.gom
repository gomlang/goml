package lsp;

pub struct FrameLimits {
    pub header_bytes: isize,
    pub body_bytes: isize,
    pub buffered_bytes: isize,
}

impl FrameLimits {
    pub fn standard() -> FrameLimits {
        FrameLimits { header_bytes: 8192, body_bytes: 16777216, buffered_bytes: 33570816 }
    }
}

pub struct FrameDecoder {
    limits: FrameLimits,
    buffer: Vec[u8],
    start: Ref[isize],
    scanned: Ref[isize],
    length: Ref[Option[isize]],
    failure: Ref[Option[string]],
}

fn header_length(header: string, maximum: isize) -> Result[isize, string] {
    if !header.is_ascii() {
        return Result::Err("headers must be ASCII")
    }
    let mut length: Option[isize] = Option::None;
    let mut content_type = false;
    for line in header.split("\r\n") {
        let (name, raw) = line.split_once(":").ok_or("invalid header line")?;
        if name == "" {
            return Result::Err("invalid header name")
        }
        for ch in name.chars() {
            if !((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9')
                || "!#$%&'*+-.^_`|~".contains(ch.to_string())) {
                return Result::Err("invalid header name")
            }
        }
        for byte in raw.to_bytes() {
            if (byte < 32 && byte != 9) || byte == 127 {
                return Result::Err("invalid header value")
            }
        }
        let value = raw.trim();
        if name.eq_ignore_ascii_case("content-length") {
            if length.is_some() {
                return Result::Err("duplicate Content-Length")
            }
            if value == "" {
                return Result::Err("empty Content-Length")
            }
            let mut parsed: isize = 0;
            for byte in value.to_bytes() {
                if byte < 48 || byte > 57 {
                    return Result::Err("invalid Content-Length")
                }
                let digit = (byte - 48).to_isize();
                if parsed > maximum / 10 || (parsed == maximum / 10 && digit > maximum % 10) {
                    return Result::Err("frame body exceeds limit")
                }
                parsed = parsed * 10 + digit;
            }
            length = Option::Some(parsed);
        } else if name.eq_ignore_ascii_case("content-type") {
            if content_type {
                return Result::Err("duplicate Content-Type")
            }
            content_type = true;
            let parameters = value.split(";");
            let mut charset_seen = false;
            for index in 1..parameters.len() {
                let (key, value) = parameters[index].trim().split_once("=").ok_or(
                    "invalid content type parameter",
                )?;
                if key.trim().eq_ignore_ascii_case("charset") {
                    if charset_seen {
                        return Result::Err("duplicate charset parameter")
                    }
                    charset_seen = true;
                    let value = value.trim();
                    let value = if value.byte_len() >= 2 && value.starts_with("\"")
                        && value.ends_with("\"") {
                        value.byte_slice(1, value.byte_len() - 1)
                    } else {
                        value
                    };
                    if !value.eq_ignore_ascii_case("utf-8") && !value.eq_ignore_ascii_case("utf8") {
                        return Result::Err("unsupported character encoding")
                    }
                }
            }
        }
    }
    length.ok_or("missing Content-Length")
}

impl FrameDecoder {
    pub fn new(limits: FrameLimits) -> Result[FrameDecoder, string] {
        if limits.header_bytes < 4 || limits.body_bytes < 0
            || limits.buffered_bytes < limits.header_bytes
            || limits.buffered_bytes < limits.body_bytes {
            return Result::Err("invalid frame limits")
        }
        Result::Ok(
            FrameDecoder {
                limits,
                buffer: Vec::new(),
                start: Ref::new(0),
                scanned: Ref::new(0),
                length: Ref::new(Option::None),
                failure: Ref::new(Option::None),
            },
        )
    }

    pub fn buffered(self: FrameDecoder) -> isize {
        self.buffer.len() - self.start.get()
    }

    pub fn needed(self: FrameDecoder) -> isize {
        match self.length.get() {
            Some(length) => if length > self.buffered() {
                length - self.buffered()
            } else {
                0
            },
            None => 1,
        }
    }

    pub fn reset(self: FrameDecoder) -> () {
        self.buffer.clear();
        self.start.set(0);
        self.scanned.set(0);
        self.length.set(Option::None);
        self.failure.set(Option::None);
    }

    fn fail[T](self: FrameDecoder, message: string) -> Result[T, string] {
        self.failure.set(Option::Some(message));
        Result::Err(message)
    }

    pub fn push(self: FrameDecoder, data: Slice[u8]) -> Result[(), string] {
        if let Some(message) = self.failure.get() {
            return Result::Err(message)
        }
        if data.len() > self.limits.buffered_bytes - self.buffered() {
            return self.fail("buffered input exceeds limit")
        }
        if self.start.get() > 0
            && (self.start.get() >= self.buffer.len() / 2
                || data.len() > self.limits.buffered_bytes - self.buffer.len()) {
            let remaining = self.buffer.slice(self.start.get(), self.buffer.len()).to_vec();
            let consumed = self.start.get();
            self.buffer.clear();
            self.buffer.extend(remaining);
            self.start.set(0);
            self.scanned.set(self.scanned.get() - consumed);
        }
        for byte in data {
            self.buffer.push(byte);
        }
        Result::Ok(())
    }

    fn read_next(self: FrameDecoder) -> Result[Option[string], string] {
        if self.length.get().is_none() {
            let mut index = self.scanned.get();
            let mut found = false;
            while index + 3 < self.buffer.len() {
                if self.buffer[index] == 13 && self.buffer[index + 1] == 10
                    && self.buffer[index + 2] == 13
                    && self.buffer[index + 3] == 10 {
                    if index + 4 - self.start.get() > self.limits.header_bytes {
                        return Result::Err("frame header exceeds limit")
                    }
                    let (ok, header) = string_from_utf8(
                        self.buffer.slice(self.start.get(), index).to_vec(),
                    );
                    if !ok {
                        return Result::Err("invalid header encoding")
                    }
                    self.length.set(Option::Some(header_length(header, self.limits.body_bytes)?));
                    self.start.set(index + 4);
                    self.scanned.set(index + 4);
                    found = true;
                    break;
                }
                index += 1;
                if index + 4 - self.start.get() > self.limits.header_bytes {
                    return Result::Err("frame header exceeds limit")
                }
            }
            if !found {
                self.scanned.set(index);
                return Result::Ok(Option::None)
            }
        }
        let length = self.length.get().unwrap_or(0);
        if self.buffered() < length {
            return Result::Ok(Option::None)
        }
        let end = self.start.get() + length;
        let (ok, body) = string_from_utf8(self.buffer.slice(self.start.get(), end).to_vec());
        if !ok {
            return Result::Err("invalid UTF-8 body")
        }
        self.start.set(end);
        self.scanned.set(end);
        self.length.set(Option::None);
        Result::Ok(Option::Some(body))
    }

    pub fn next(self: FrameDecoder) -> Result[Option[string], string] {
        if let Some(message) = self.failure.get() {
            return Result::Err(message)
        }
        match self.read_next() {
            Ok(value) => Result::Ok(value),
            Err(message) => self.fail(message),
        }
    }

    pub fn finish(self: FrameDecoder) -> Result[(), string] {
        if let Some(message) = self.failure.get() {
            return Result::Err(message)
        }
        if self.buffered() != 0 || self.length.get().is_some() {
            self.fail("undrained or truncated frame at EOF")
        } else {
            Result::Ok(())
        }
    }
}

pub fn frame_body(body: string) -> Vec[u8] {
    let bytes = f"Content-Length: {body.byte_len()}\r\n\r\n".to_bytes();
    bytes.extend(body.to_bytes());
    bytes
}

pub fn frame(message: Message) -> Result[Vec[u8], RpcError] {
    Result::Ok(frame_body(encode(message)?))
}
