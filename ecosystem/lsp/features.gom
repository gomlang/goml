package lsp;

use std::json;

pub struct DocumentPosition {
    pub uri: string,
    pub position: Position,
}

impl DocumentPosition {
    pub fn from_json(value: json::Value) -> Result[DocumentPosition, RpcError] {
        let _ = members(value)?;
        let document = required(value, "textDocument")?;
        let _ = members(document)?;
        Result::Ok(
            DocumentPosition {
                uri: string_field(document, "uri")?,
                position: Position::from_json(required(value, "position")?)?,
            },
        )
    }

    pub fn to_json(self: DocumentPosition) -> json::Value {
        json::object(
            Vec::from_array(
                [
                    (
                        "textDocument",
                        json::object(Vec::from_array([("uri", json::Value::String(self.uri))])),
                    ),
                    ("position", self.position.to_json()),
                ],
            ),
        )
    }
}

pub struct Location {
    pub uri: string,
    pub range: Range,
}

impl Location {
    pub fn from_json(value: json::Value) -> Result[Location, RpcError] {
        let _ = members(value)?;
        Result::Ok(
            Location {
                uri: string_field(value, "uri")?,
                range: Range::from_json(required(value, "range")?)?,
            },
        )
    }

    pub fn to_json(self: Location) -> json::Value {
        json::object(
            Vec::from_array(
                [("uri", json::Value::String(self.uri)), ("range", self.range.to_json())],
            ),
        )
    }
}

pub struct Diagnostic {
    pub range: Range,
    pub message: string,
    pub severity: Option[isize],
    pub code: Option[Id],
    pub source: Option[string],
    pub related: Vec[(Location, string)],
    pub data: Option[json::Value],
}

impl Diagnostic {
    pub fn new(range: Range, message: string) -> Diagnostic {
        Diagnostic {
            range,
            message,
            severity: Option::None,
            code: Option::None,
            source: Option::None,
            related: Vec::new(),
            data: Option::None,
        }
    }

    pub fn to_json(self: Diagnostic) -> Result[json::Value, RpcError] {
        let _ = Range::from_json(self.range.to_json())?;
        let fields = Vec::from_array(
            [("range", self.range.to_json()), ("message", json::Value::String(self.message))],
        );
        if let Some(severity) = self.severity {
            if severity < 1 || severity > 4 {
                return Result::Err(invalid("diagnostic severity must be 1 through 4"))
            }
            fields.push(("severity", json::Value::Number(severity.to_string())));
        }
        if let Some(code) = self.code {
            let _ = Id::from_json(code.to_json())?;
            fields.push(("code", code.to_json()));
        }
        if let Some(source) = self.source {
            fields.push(("source", json::Value::String(source)));
        }
        if let Some(data) = self.data {
            fields.push(("data", data));
        }
        if !self.related.is_empty() {
            let related: Vec[json::Value] = Vec::new();
            for (location, message) in self.related {
                let _ = Location::from_json(location.to_json())?;
                related.push(
                    json::object(
                        Vec::from_array(
                            [
                                ("location", location.to_json()),
                                ("message", json::Value::String(message)),
                            ],
                        ),
                    ),
                );
            }
            fields.push(("relatedInformation", json::Value::Array(related)));
        }
        Result::Ok(json::object(fields))
    }
}

pub fn publish_diagnostics(uri: string, version: Option[isize], diagnostics: Vec[Diagnostic]) -> Result[
    Message,
    RpcError,
] {
    let values: Vec[json::Value] = Vec::new();
    for diagnostic in diagnostics {
        values.push(diagnostic.to_json()?);
    }
    let fields = Vec::from_array(
        [("uri", json::Value::String(uri)), ("diagnostics", json::Value::Array(values))],
    );
    if let Some(version) = version {
        let _ = integer(json::Value::Number(version.to_string()))?;
        fields.push(("version", json::Value::Number(version.to_string())));
    }
    Result::Ok(
        Message::Notification("textDocument/publishDiagnostics", Option::Some(json::object(fields))),
    )
}

pub fn hover(markdown: string, range: Option[Range]) -> Result[json::Value, RpcError] {
    let fields = Vec::from_array(
        [
            (
                "contents",
                json::object(
                    Vec::from_array(
                        [
                            ("kind", json::Value::String("markdown")),
                            ("value", json::Value::String(markdown)),
                        ],
                    ),
                ),
            ),
        ],
    );
    if let Some(range) = range {
        let _ = Range::from_json(range.to_json())?;
        fields.push(("range", range.to_json()));
    }
    Result::Ok(json::object(fields))
}

pub fn progress(token: Id, value: json::Value) -> Result[Message, RpcError] {
    let _ = Id::from_json(token.to_json())?;
    Result::Ok(
        Message::Notification(
            "$/progress",
            Option::Some(
                json::object(Vec::from_array([("token", token.to_json()), ("value", value)])),
            ),
        ),
    )
}
