package lsp;

use std::json;

#[derive(Debug, PartialEq, Eq)]
pub enum PositionEncoding {
    Utf8,
    Utf16,
    Utf32,
}

impl PositionEncoding {
    pub fn from_string(value: string) -> Option[PositionEncoding] {
        match value {
            "utf-8" => Option::Some(PositionEncoding::Utf8),
            "utf-16" => Option::Some(PositionEncoding::Utf16),
            "utf-32" => Option::Some(PositionEncoding::Utf32),
            _ => Option::None,
        }
    }

    pub fn as_string(self: PositionEncoding) -> string {
        match self {
            Utf8 => "utf-8",
            Utf16 => "utf-16",
            Utf32 => "utf-32",
        }
    }

    pub fn length(self: PositionEncoding, text: string) -> isize {
        match self {
            Utf8 => text.byte_len(),
            Utf16 => utf16_length(text),
            Utf32 => {
                let mut count: isize = 0;
                for _ in text.chars() {
                    count += 1;
                }
                count
            },
        }
    }
}

fn negotiate_encoding(capabilities: json::Value, supported: Vec[PositionEncoding]) -> Result[
    PositionEncoding,
    RpcError,
] {
    let _ = members(capabilities)?;
    let Some(general) = json::field(capabilities, "general") else {
        return Result::Ok(PositionEncoding::Utf16)
    };
    let _ = members(general)?;
    let Some(value) = json::field(general, "positionEncodings") else {
        return Result::Ok(PositionEncoding::Utf16)
    };
    let values = json::as_array(value).ok_or(invalid("positionEncodings must be an array"))?;
    let mut selected: Option[PositionEncoding] = Option::None;
    for value in values {
        let name = json::as_string(value).ok_or(invalid("position encoding must be a string"))?;
        if let Some(encoding) = PositionEncoding::from_string(name) {
            if selected.is_none() && supported.contains(encoding) {
                selected = Option::Some(encoding);
            }
        }
    }
    Result::Ok(selected.unwrap_or(PositionEncoding::Utf16))
}
