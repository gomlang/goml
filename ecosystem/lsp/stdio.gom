package lsp;

use std::bytes;
use std::io;

pub struct Stdio {
    decoder: FrameDecoder,
}

impl Stdio {
    pub fn new(limits: FrameLimits) -> Result[Stdio, string] {
        Result::Ok(Stdio { decoder: FrameDecoder::new(limits)? })
    }

    pub fn read_body(self: Stdio) -> Result[Option[string], string] {
        loop {
            if let Some(body) = self.decoder.next()? {
                return Result::Ok(Option::Some(body))
            }
            match io::read_stdin_exact_structured(self.decoder.needed()) {
                Ok(data) => self.decoder.push(data.as_slice())?,
                Err(problem) => {
                    if problem.kind() == io::ErrorKind::UnexpectedEof {
                        self.decoder.finish()?;
                        return Result::Ok(Option::None)
                    }
                    return Result::Err(problem.to_string())
                },
            }
        }
    }

    pub fn write(self: Stdio, message: Message) -> Result[(), string] {
        let bytes = frame(message).map_err(|problem| problem.to_string())?;
        io::write_stdout_structured(bytes::Bytes::from_vec(bytes)).map_err(
            |problem| problem.to_string(),
        )
    }
}
