package tests;

use ecosystem::lsp;
use std::json;
use std::time;
use std::testing;

fn running_server(calls: Ref[isize], limit: isize) -> lsp::Server {
    let router = lsp::Router::new();
    testing::assert_ok(
        router.on_raw_request(
            "work",
            |_, params| {
                calls.set(calls.get() + 1);
                Result::Ok(params.unwrap_or(json::Value::Null))
            },
        ),
    );
    let server = testing::expect_ok(
        lsp::Server::new(
            router,
            testing::expect_ok(lsp::Documents::new(8, 4096), "documents"),
            limit,
            json::object(Vec::new()),
        ),
        "server",
    );
    testing::assert_ok(
        request(
            server,
            "initialize",
            Option::Some(
                json::object(Vec::from_array([("capabilities", json::object(Vec::new()))])),
            ),
        ),
    );
    testing::assert_ok(server.handle(lsp::Message::Notification("initialized", Option::None)));
    server
}

fn work_message(id: isize) -> lsp::Message {
    lsp::Message::Request(lsp::Id::Number(id), "work", Option::None)
}

fn pending(server: lsp::Server, id: isize) -> lsp::PendingRequest {
    let dispatch = testing::expect_ok(server.accept(work_message(id)), "accept");
    testing::assert_none(dispatch.event.reply);
    testing::expect_some(dispatch.request, "pending")
}

fn response_result(message: lsp::Message) -> Result[json::Value, lsp::RpcError] {
    match message {
        lsp::Message::Response(_, result) => result,
        _ => Result::Err(lsp::RpcError::new(-32603, "not a response")),
    }
}

#[test]
fn deferred_requests_receive_cancellation_and_complete_once() -> () {
    let calls = Ref::new(0);
    let server = running_server(calls, 2);
    let first = pending(server, 10);
    let second = pending(server, 11);
    testing::assert_eq(calls.get(), 0);
    testing::assert_eq(server.session().incoming_count(), 2);
    testing::assert_some(testing::expect_ok(server.accept(work_message(12)), "limit").event.reply);
    testing::assert_some(
        testing::expect_ok(server.accept(work_message(10)), "duplicate").event.reply,
    );
    testing::assert_ok(
        server.accept(
            lsp::Message::Notification(
                "$/cancelRequest",
                Option::Some(json::object(Vec::from_array([("id", lsp::Id::Number(10).to_json())]))),
            ),
        ),
    );
    testing::assert(first.token().is_cancelled());
    let reply = testing::expect_ok(server.execute(first), "cancel response");
    testing::assert_eq(testing::expect_err(response_result(reply), "cancelled").code, -32800);
    testing::assert_eq(calls.get(), 0);
    testing::assert_err(server.execute(first));
    testing::assert_ok(response_result(testing::expect_ok(server.execute(second), "second")));
    testing::assert_eq(calls.get(), 1);
    let reused = pending(server, 10);
    testing::assert_err(server.complete(first, Result::Ok(json::Value::Null)));
    testing::assert(reused.token().is_active());
    testing::assert(server.session().cancel(lsp::Id::Number(10)));
    testing::assert_ok(
        response_result(
            testing::expect_ok(
                server.complete(reused, Result::Ok(json::Value::String("partial result"))),
                "partial after cancellation",
            ),
        ),
    );
    testing::assert_eq(server.session().incoming_count(), 0);
}

#[test]
fn deferred_deadlines_expire_without_invoking_handlers_and_ignore_stale_tokens() -> () {
    let calls = Ref::new(0);
    let server = running_server(calls, 4);
    let expired = testing::expect_some(
        testing::expect_ok(
            server.accept_with_timeout(
                work_message(10),
                Option::Some(time::Duration::from_milliseconds(0)),
            ),
            "timed request",
        ).request,
        "pending",
    );
    testing::assert_some(server.next_timeout());
    let replies = testing::expect_ok(server.poll_timeouts(), "poll");
    testing::assert_eq(replies.len(), 1);
    testing::assert_eq(testing::expect_err(response_result(replies[0]), "timeout").code, -32803);
    testing::assert(!expired.token().is_active());
    testing::assert_eq(testing::expect_ok(server.poll_timeouts(), "second poll").len(), 0);
    testing::assert_none(server.next_timeout());
    let current = pending(server, 10);
    testing::assert_err(server.execute(expired));
    testing::assert(current.token().is_active());
    testing::assert_ok(server.execute(current));
    testing::assert_eq(calls.get(), 1);
    let expired = testing::expect_some(
        testing::expect_ok(
            server.accept_with_timeout(
                work_message(20),
                Option::Some(time::Duration::from_milliseconds(0)),
            ),
            "timed request",
        ).request,
        "pending",
    );
    testing::assert_eq(
        testing::expect_err(
            response_result(
                testing::expect_ok(
                    server.complete(expired, Result::Ok(json::Value::Null)),
                    "complete overdue",
                ),
            ),
            "timeout",
        ).code,
        -32803,
    );
    testing::assert_none(server.next_timeout());
}

#[test]
fn deferred_tokens_reject_foreign_servers_and_shutdown_drains_before_exit() -> () {
    let calls = Ref::new(0);
    let server = running_server(calls, 8);
    let other = running_server(Ref::new(0), 8);
    let first = pending(server, 10);
    testing::assert_err(other.execute(first));
    testing::assert_err(other.complete(first, Result::Ok(json::Value::Null)));
    testing::assert_eq(calls.get(), 0);
    testing::assert(first.token().is_active());
    testing::assert_ok(request(server, "shutdown", Option::None));
    testing::assert_ok(server.execute(first));
    testing::assert_eq(calls.get(), 1);
    testing::assert_some(
        testing::expect_ok(server.accept(work_message(11)), "after shutdown").event.reply,
    );
    let abandoned = pending(other, 15);
    testing::assert_ok(other.session().request(lsp::Id::Number(16), "client/work", Option::None));
    testing::assert_ok(other.accept(lsp::Message::Notification("exit", Option::None)));
    testing::assert(!abandoned.token().is_active());
    testing::assert(abandoned.token().is_cancelled());
    testing::assert_eq(other.session().incoming_count(), 0);
    testing::assert_eq(other.session().outgoing_count(), 0);
    testing::assert(other.session().is_closed());
    testing::assert_err(other.execute(abandoned));
    testing::assert_err(other.session().begin(lsp::Id::Number(17), "closed"));
}
