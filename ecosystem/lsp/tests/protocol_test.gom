package tests;

use ecosystem::lsp;
use std::json;
use std::testing;

fn decoder() -> lsp::FrameDecoder {
    testing::expect_ok(lsp::FrameDecoder::new(lsp::FrameLimits::standard()), "decoder")
}

#[test]
fn framing_every_split_and_multibyte_chunks() -> () {
    let body = "{\"jsonrpc\":\"2.0\",\"method\":\"你好😀\"}";
    let wire = lsp::frame_body(body);
    for split in 0..wire.len() + 1 {
        let stream = decoder();
        testing::assert_ok(stream.push(wire.slice(0, split)));
        let first = testing::expect_ok(stream.next(), "first chunk");
        if split < wire.len() {
            testing::assert_none(first);
        } else {
            testing::assert_eq(testing::expect_some(first, "whole frame"), body);
        }
        testing::assert_ok(stream.push(wire.slice(split, wire.len())));
        if split < wire.len() {
            testing::assert_eq(
                testing::expect_some(testing::expect_ok(stream.next(), "second chunk"), "frame"),
                body,
            );
        }
        testing::assert_none(testing::expect_ok(stream.next(), "drained"));
        testing::assert_ok(stream.finish());
    }
    let stream = decoder();
    for _ in 0..100 {
        for byte in wire {
            testing::assert_ok(stream.push(Vec::from_array([byte]).as_slice()));
        }
        testing::assert_eq(
            testing::expect_some(testing::expect_ok(stream.next(), "one-byte chunks"), "frame"),
            body,
        );
    }
    testing::assert_ok(stream.finish());
    let combined = wire.copy();
    combined.extend(wire);
    testing::assert_ok(stream.push(combined.as_slice()));
    testing::assert_some(testing::expect_ok(stream.next(), "one"));
    testing::assert_some(testing::expect_ok(stream.next(), "two"));
    testing::assert_ok(stream.finish());
}

#[test]
fn framing_limits_malformed_headers_eof_and_reset() -> () {
    let invalid = Vec::from_array(
        [
            "Content-Length: -1\r\n\r\n",
            "Content-Length: 1\r\nContent-Length: 1\r\n\r\nx",
            "Content-Type: x\r\n\r\n",
            "Content-Length: 999999999999999999999999999999\r\n\r\n",
            "Content-Length: 0\r\nContent-Type: x; charset=utf-16\r\n\r\n",
            "Content-Length: 0\r\nContent-Type: x; charset=utf-8; charset=utf8\r\n\r\n",
            "Bad Header: 1\r\nContent-Length: 0\r\n\r\n",
            "Content-Length: 0\n\r\n\r\n",
        ],
    );
    for wire in invalid {
        let stream = decoder();
        testing::assert_ok(stream.push(wire.to_bytes().as_slice()));
        testing::assert_err(stream.next());
        testing::assert_err(stream.push(Vec::new().as_slice()));
        testing::assert_err(stream.finish());
        stream.reset();
        testing::assert_ok(stream.push(lsp::frame_body("").as_slice()));
        testing::assert_eq(
            testing::expect_some(testing::expect_ok(stream.next(), "after reset"), "empty body"),
            "",
        );
    }
    let stream = decoder();
    let invalid_utf8 = "Content-Length: 1\r\n\r\n".to_bytes();
    invalid_utf8.push(255);
    testing::assert_ok(stream.push(invalid_utf8.as_slice()));
    testing::assert_err(stream.next());
    let stream = decoder();
    testing::assert_ok(stream.push("Content-Length: 2\r\n\r\nx".to_bytes().as_slice()));
    testing::assert_none(testing::expect_ok(stream.next(), "partial body"));
    testing::assert_err(stream.finish());
    let small = testing::expect_ok(
        lsp::FrameDecoder::new(
            lsp::FrameLimits { header_bytes: 24, body_bytes: 4, buffered_bytes: 32 },
        ),
        "limits",
    );
    testing::assert_ok(small.push("Content-Length: 5\r\n\r\n".to_bytes().as_slice()));
    testing::assert_err(small.next());
    small.reset();
    testing::assert_err(small.push("x".repeat(33).to_bytes().as_slice()));
    small.reset();
    testing::assert_ok(small.push("x".repeat(24).to_bytes().as_slice()));
    testing::assert_err(small.next());
    let stream = decoder();
    testing::assert_ok(
        stream.push(
            "content-length:\t2\r\nX-Trace2: yes\r\nContent-Type: application/vscode-jsonrpc; charset=utf8\r\n\r\n{}".to_bytes().as_slice(),
        ),
    );
    testing::assert_eq(
        testing::expect_some(testing::expect_ok(stream.next(), "case insensitive"), "frame"),
        "{}",
    );
    testing::assert_ok(
        stream.push(
            "Content-Length: 2\r\nContent-Type: x; charset=\"UTF-8\"\r\n\r\n{}".to_bytes().as_slice(),
        ),
    );
    testing::assert_eq(
        testing::expect_some(testing::expect_ok(stream.next(), "quoted charset"), "frame"),
        "{}",
    );
}

#[test]
fn message_variants_ids_errors_and_validation() -> () {
    let messages = Vec::from_array(
        [
            "{\"jsonrpc\":\"2.0\",\"id\":0,\"method\":\"test\",\"params\":{}}",
            "{\"jsonrpc\":\"2.0\",\"id\":\"0\",\"method\":\"test\",\"params\":[]}",
            "{\"jsonrpc\":\"2.0\",\"method\":\"notify\"}",
            "{\"jsonrpc\":\"2.0\",\"id\":null,\"error\":{\"code\":-32700,\"message\":\"parse\",\"data\":null}}",
            "{\"jsonrpc\":\"2.0\",\"id\":12,\"result\":null}",
        ],
    );
    for source in messages {
        let message = testing::expect_ok(lsp::decode(source), "decode");
        let encoded = testing::expect_ok(lsp::encode(message), "encode");
        let roundtrip = testing::expect_ok(lsp::decode(encoded), "roundtrip");
        testing::assert_eq(testing::expect_ok(lsp::encode(roundtrip), "stable"), encoded);
    }
    let bad = Vec::from_array(
        [
            "[]",
            "{}",
            "null",
            "{\"jsonrpc\":\"1.0\",\"method\":\"x\"}",
            "{\"jsonrpc\":\"2.0\",\"id\":null,\"method\":\"x\"}",
            "{\"jsonrpc\":\"2.0\",\"id\":1.5,\"method\":\"x\"}",
            "{\"jsonrpc\":\"2.0\",\"id\":2147483648,\"method\":\"x\"}",
            "{\"jsonrpc\":\"2.0\",\"id\":18446744073709551617,\"method\":\"x\"}",
            "{\"jsonrpc\":\"2.0\",\"method\":\"x\",\"params\":null}",
            "{\"jsonrpc\":\"2.0\",\"method\":\"x\",\"result\":1}",
            "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":0,\"error\":{}}",
            "{\"jsonrpc\":\"2.0\",\"id\":1,\"id\":2,\"result\":0}",
            "{\"jsonrpc\":\"2.0\",\"id\":1,\"error\":{\"code\":0,\"message\":2}}",
        ],
    );
    for source in bad {
        testing::assert_eq(testing::expect_err(lsp::decode(source), "invalid request").code, -32600);
    }
    testing::assert_eq(testing::expect_err(lsp::decode("{"), "parse error").code, -32700);
    testing::assert_eq(
        testing::expect_err(lsp::decode("[".repeat(129)), "depth limit").code,
        -32700,
    );
    testing::assert_err(
        lsp::encode(
            lsp::Message::Request(lsp::Id::Number(1), "bad", Option::Some(json::Value::Null)),
        ),
    );
}

#[test]
fn pending_requests_cancellation_expiry_and_owner_checks() -> () {
    let session = testing::expect_ok(lsp::Session::new(2), "session");
    let token = testing::expect_ok(session.begin(lsp::Id::Number(1), "compute"), "begin");
    testing::assert_err(session.begin(lsp::Id::Number(1), "duplicate"));
    let text = testing::expect_ok(session.begin(lsp::Id::Text("1"), "separate id"), "string id");
    testing::assert_err(session.begin(lsp::Id::Number(2), "limit"));
    testing::assert(session.cancel(token.id()));
    testing::assert_eq(testing::expect_err(token.check(), "cancelled").code, -32800);
    testing::assert(!text.is_cancelled());
    let foreign = testing::expect_ok(lsp::Session::new(2), "foreign");
    testing::assert_err(foreign.complete(token, Result::Ok(json::Value::Null)));
    let response = testing::expect_ok(
        session.complete(token, Result::Err(lsp::RpcError::new(-32800, "cancelled"))),
        "complete",
    );
    testing::assert_ok(lsp::encode(response));
    testing::assert(!token.is_active());
    testing::assert_err(session.complete(token, Result::Ok(json::Value::Null)));
    let reused = testing::expect_ok(session.begin(token.id(), "reused"), "reuse");
    testing::assert_err(session.complete(token, Result::Ok(json::Value::Null)));
    testing::assert_ok(session.complete(reused, Result::Ok(json::Value::Null)));
    testing::assert_eq(session.incoming_count(), 1);
    testing::assert_ok(session.request(lsp::Id::Number(8), "client/request", Option::None));
    testing::assert_ok(session.cancel_outgoing(lsp::Id::Number(8)));
    testing::assert_eq(session.outgoing_count(), 1);
    let completed = testing::expect_ok(
        session.receive(
            lsp::Message::Response(Option::Some(lsp::Id::Number(8)), Result::Ok(json::Value::Null)),
        ),
        "reply after cancellation",
    );
    testing::assert_eq(completed.method, "client/request");
    testing::assert_eq(session.outgoing_count(), 0);
    testing::assert_err(
        session.receive(
            lsp::Message::Response(Option::Some(lsp::Id::Number(8)), Result::Ok(json::Value::Null)),
        ),
    );
    testing::assert_ok(session.request(lsp::Id::Number(9), "timeout", Option::None));
    testing::assert_ok(session.expire(lsp::Id::Number(9)));
    testing::assert_eq(session.outgoing_count(), 0);
}
