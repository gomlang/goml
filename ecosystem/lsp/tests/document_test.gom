package tests;

use ecosystem::lsp;
use std::json;
use std::testing;

fn pos(line: isize, character: isize) -> lsp::Position {
    lsp::Position { line, character }
}

fn range(line: isize, start: isize, end: isize) -> lsp::Range {
    lsp::Range { start: pos(line, start), end: pos(line, end) }
}

#[test]
fn unicode_positions_crlf_cr_lf_and_column_clamping() -> () {
    let document = testing::expect_ok(
        lsp::Document::new("file:///a", "goml", 1, "a😀é\r\n中\rz\n"),
        "document",
    );
    testing::assert_eq(document.line_count(), 4);
    testing::assert_eq(testing::expect_ok(document.offset(pos(0, 1)), "before emoji"), 1);
    testing::assert_eq(testing::expect_ok(document.offset(pos(0, 3)), "after emoji"), 5);
    testing::assert_err(document.offset(pos(0, 2)));
    testing::assert_eq(testing::expect_ok(document.offset(pos(0, 999)), "clamp"), 7);
    testing::assert_eq(testing::expect_ok(document.position(8), "CRLF interior"), pos(0, 4));
    testing::assert_eq(testing::expect_ok(document.position(9), "next line"), pos(1, 0));
    testing::assert_eq(testing::expect_ok(document.offset(pos(2, 0)), "after CR"), 13);
    testing::assert_err(document.position(3));
    testing::assert_err(document.offset(pos(-1, 0)));
    testing::assert_err(document.offset(pos(4, 0)));
    testing::assert_err(document.offset(pos(0, -1)));
    testing::assert_eq(testing::expect_ok(document.text_in(range(0, 1, 3)), "selection"), "😀");
    testing::assert_eq(lsp::utf16_length(document.content()), 10);
}

#[test]
fn chunked_document_edits_preserve_snapshots_and_line_boundaries() -> () {
    let prefix = "x".repeat(1023);
    let original_text = prefix + "\r\n😀middle\r\ntail";
    let original = testing::expect_ok(
        lsp::Document::new("file:///large", "goml", 1, original_text),
        "chunked document",
    );
    testing::assert_eq(testing::expect_ok(original.position(1024), "split CRLF"), pos(0, 1023));
    testing::assert_eq(testing::expect_ok(original.offset(pos(1, 2)), "wide scalar"), 1029);
    let changes = Vec::from_array(
        [
            lsp::Change {
                range: Option::Some(lsp::Range { start: pos(0, 1022), end: pos(1, 2) }),
                range_length: Option::Some(5),
                text: "中\r",
            },
            lsp::Change {
                range: Option::Some(range(1, 0, 6)),
                range_length: Option::Some(6),
                text: "😀",
            },
        ],
    );
    let edited = testing::expect_ok(original.changed(2, changes, 2048), "chunk-spanning edits");
    testing::assert_eq(edited.content(), "x".repeat(1022) + "中\r😀\r\ntail");
    testing::assert_eq(edited.line_count(), 3);
    testing::assert_eq(original.content(), original_text);
    testing::assert_eq(original.version(), 1);
    testing::assert_err(edited.offset(pos(1, 1)));
    testing::assert_eq(testing::expect_ok(edited.text_in(range(1, 0, 2)), "selection"), "😀");
    let empty = testing::expect_ok(edited.changed(3, Vec::new(), 2048), "version-only change");
    testing::assert_eq(empty.version(), 3);
    testing::assert_eq(empty.content(), edited.content());
}

#[test]
fn changes_are_sequential_transactional_and_versioned() -> () {
    let documents = testing::expect_ok(lsp::Documents::new(1, 32), "store");
    let original = testing::expect_ok(
        lsp::Document::new("file:///a", "goml", 1, "a😀b\n"),
        "document",
    );
    testing::assert_ok(documents.open(original));
    testing::assert_err(documents.open(original));
    testing::assert_err(
        documents.open(testing::expect_ok(lsp::Document::new("file:///b", "goml", 1, ""), "second")),
    );
    let changes = Vec::from_array(
        [
            lsp::Change {
                range: Option::Some(range(0, 1, 3)),
                range_length: Option::Some(2),
                text: "X",
            },
            lsp::Change {
                range: Option::Some(range(0, 2, 3)),
                range_length: Option::None,
                text: "YZ",
            },
        ],
    );
    let next = testing::expect_ok(documents.change("file:///a", 4, changes), "sequential");
    testing::assert_eq(next.content(), "aXYZ\n");
    testing::assert_eq(original.content(), "a😀b\n");
    testing::assert_err(original.changed(2, Vec::new(), -1));
    testing::assert_err(original.changed(2, Vec::new(), 0));
    testing::assert_eq(next.version(), 4);
    testing::assert_err(documents.change("file:///a", 4, Vec::new()));
    let bad = Vec::from_array(
        [
            lsp::Change { range: Option::None, range_length: Option::None, text: "replacement" },
            lsp::Change {
                range: Option::Some(range(99, 0, 1)),
                range_length: Option::None,
                text: "bad",
            },
        ],
    );
    testing::assert_err(documents.change("file:///a", 5, bad));
    testing::assert_eq(
        testing::expect_some(documents.get("file:///a"), "unchanged").content(),
        "aXYZ\n",
    );
    testing::assert_err(
        documents.change(
            "file:///a",
            5,
            Vec::from_array(
                [
                    lsp::Change {
                        range: Option::Some(range(0, 0, 1)),
                        range_length: Option::Some(2),
                        text: "bad",
                    },
                ],
            ),
        ),
    );
    testing::assert_err(
        documents.change(
            "file:///a",
            5,
            Vec::from_array(
                [
                    lsp::Change {
                        range: Option::None,
                        range_length: Option::None,
                        text: "x".repeat(33),
                    },
                ],
            ),
        ),
    );
    let replaced = testing::expect_ok(
        documents.change(
            "file:///a",
            6,
            Vec::from_array(
                [lsp::Change { range: Option::None, range_length: Option::None, text: "full" }],
            ),
        ),
        "full update",
    );
    testing::assert_eq(replaced.content(), "full");
    testing::assert_eq(testing::expect_ok(documents.close("file:///a"), "close").version(), 6);
    testing::assert_err(documents.close("file:///a"));
    testing::assert_eq(documents.len(), 0);
}

#[test]
fn text_edits_share_original_coordinates_and_preserve_insert_order() -> () {
    let document = testing::expect_ok(lsp::Document::new("a", "text", 0, "abcdef"), "document");
    let edits = Vec::from_array(
        [
            lsp::TextEdit { range: range(0, 4, 6), new_text: "!" },
            lsp::TextEdit { range: range(0, 1, 1), new_text: "X" },
            lsp::TextEdit { range: range(0, 1, 1), new_text: "Y" },
            lsp::TextEdit { range: range(0, 1, 2), new_text: "Z" },
        ],
    );
    testing::assert_eq(testing::expect_ok(document.apply_edits(edits), "edits"), "aXYZcd!");
    testing::assert_err(
        document.apply_edits(
            Vec::from_array(
                [
                    lsp::TextEdit { range: range(0, 1, 3), new_text: "X" },
                    lsp::TextEdit { range: range(0, 2, 4), new_text: "Y" },
                ],
            ),
        ),
    );
    testing::assert_err(
        document.apply_edits(
            Vec::from_array(
                [
                    lsp::TextEdit { range: range(0, 1, 2), new_text: "X" },
                    lsp::TextEdit { range: range(0, 1, 1), new_text: "Y" },
                ],
            ),
        ),
    );
    testing::assert_eq(document.content(), "abcdef");
}

#[test]
fn feature_wire_names_and_optional_fields() -> () {
    let edit = lsp::TextEdit { range: range(0, 0, 1), new_text: "updated" };
    testing::assert_eq(
        testing::expect_ok(lsp::TextEdit::from_json(edit.to_json()), "text edit").new_text,
        "updated",
    );
    testing::assert_some(json::field(edit.to_json(), "newText"));
    testing::assert_none(json::field(edit.to_json(), "new_text"));
    let diagnostic = lsp::Diagnostic::new(range(0, 0, 1), "problem");
    let wire = testing::expect_ok(diagnostic.to_json(), "diagnostic");
    testing::assert_none(json::field(wire, "severity"));
    testing::assert_none(json::field(wire, "relatedInformation"));
    let publish = testing::expect_ok(
        lsp::publish_diagnostics("file:///a", Option::Some(8), Vec::from_array([diagnostic])),
        "publish",
    );
    testing::assert_ok(lsp::decode(testing::expect_ok(lsp::encode(publish), "serialize")));
    let hover = testing::expect_ok(lsp::hover("**hello**", Option::Some(range(0, 0, 1))), "hover");
    let contents = testing::expect_some(json::field(hover, "contents"), "contents");
    testing::assert_eq(
        testing::expect_some(
            json::as_string(testing::expect_some(json::field(contents, "kind"), "kind")),
            "string",
        ),
        "markdown",
    );
}
