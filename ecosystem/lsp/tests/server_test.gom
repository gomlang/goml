package tests;

use ecosystem::lsp;
use std::json;
use std::serde;
use serde::{Deserialize, Serialize};
use std::testing;

#[derive(Deserialize)]
struct Add {
    left: isize,
    right: isize,
}

#[derive(Serialize)]
struct Sum {
    value: isize,
}

fn request(server: lsp::Server, method: string, params: Option[json::Value]) -> Result[
    json::Value,
    lsp::RpcError,
] {
    let event = testing::expect_ok(
        server.handle(lsp::Message::Request(lsp::Id::Number(1), method, params)),
        "request event",
    );
    let lsp::Message::Response(_, result) = testing::expect_some(event.reply, "reply") else {
        return Result::Err(lsp::RpcError::new(-32603, "expected response"))
    };
    result
}

#[test]
fn lifecycle_typed_callbacks_notifications_and_sync() -> () {
    let router = lsp::Router::new();
    let offset = 4;
    testing::assert_ok(
        router.on_request(
            "add",
            |context, params: Add| {
                context.token.check()?;
                Result::Ok(Sum { value: params.left + params.right + offset })
            },
        ),
    );
    let count = Ref::new(0);
    testing::assert_ok(
        router.on_notification(
            "tick",
            |_, _| {
                count.set(count.get() + 1);
                Result::Ok(())
            },
        ),
    );
    let docs = testing::expect_ok(lsp::Documents::new(8, 4096), "documents");
    let server = testing::expect_ok(
        lsp::Server::new(router, docs, 16, json::object(Vec::new())),
        "server",
    );
    testing::assert_eq(
        testing::expect_err(request(server, "add", Option::None), "before init").code,
        -32002,
    );
    testing::assert_ok(server.handle(lsp::Message::Notification("tick", Option::None)));
    testing::assert_eq(count.get(), 0);
    let capabilities = json::object(Vec::from_array([("capabilities", json::object(Vec::new()))]));
    testing::assert_err(request(server, "initialize", Option::None));
    testing::assert_eq(server.phase(), lsp::Phase::New);
    testing::assert_ok(request(server, "initialize", Option::Some(capabilities)));
    testing::assert_eq(server.phase(), lsp::Phase::AwaitInitialized);
    testing::assert_ok(
        server.handle(
            lsp::Message::Notification("initialized", Option::Some(json::object(Vec::new()))),
        ),
    );
    testing::assert_eq(server.phase(), lsp::Phase::Running);
    testing::assert_err(request(server, "initialize", Option::Some(capabilities)));
    let parameters = json::object(
        Vec::from_array([("left", json::Value::Number("2")), ("right", json::Value::Number("3"))]),
    );
    let sum = testing::expect_ok(request(server, "add", Option::Some(parameters)), "typed callback");
    testing::assert_eq(
        json::as_int(testing::expect_some(json::field(sum, "value"), "sum")).unwrap_or(-1),
        9,
    );
    testing::assert_eq(
        testing::expect_err(request(server, "add", Option::None), "bad params").code,
        -32602,
    );
    testing::assert_eq(
        testing::expect_err(request(server, "missing", Option::None), "missing handler").code,
        -32601,
    );
    testing::assert_eq(
        testing::expect_err(request(server, "$/custom", Option::None), "reserved").code,
        -32601,
    );
    let event = testing::expect_ok(
        server.handle(lsp::Message::Notification("tick", Option::None)),
        "notification",
    );
    testing::assert_none(event.reply);
    testing::assert_eq(count.get(), 1);
    let open = testing::expect_ok(
        lsp::decode(
            "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///a\",\"languageId\":\"goml\",\"version\":1,\"text\":\"hello\"}}}",
        ),
        "open",
    );
    testing::assert_ok(server.handle(open));
    testing::assert_eq(testing::expect_some(docs.get("file:///a"), "stored").content(), "hello");
    testing::assert_ok(request(server, "shutdown", Option::None));
    testing::assert_eq(server.phase(), lsp::Phase::Shutdown);
    testing::assert_err(request(server, "add", Option::Some(parameters)));
    let exited = testing::expect_ok(
        server.handle(lsp::Message::Notification("exit", Option::None)),
        "exit",
    );
    testing::assert_eq(exited.exit_code.unwrap_or(-1), 0);
    testing::assert_err(server.handle(lsp::Message::Notification("tick", Option::None)));
}

#[test]
fn premature_exit_and_duplicate_handlers() -> () {
    let router = lsp::Router::new();
    testing::assert_ok(router.on_raw_request("x", |_, _| Result::Ok(json::Value::Null)));
    testing::assert_err(router.on_raw_request("x", |_, _| Result::Ok(json::Value::Null)));
    let documents = testing::expect_ok(lsp::Documents::new(1, 16), "documents");
    let server = testing::expect_ok(
        lsp::Server::new(router, documents, 8, json::object(Vec::new())),
        "server",
    );
    testing::assert_eq(
        testing::expect_ok(server.handle(lsp::Message::Notification("exit", Option::None)), "exit").exit_code.unwrap_or(
            -1,
        ),
        1,
    );
}
