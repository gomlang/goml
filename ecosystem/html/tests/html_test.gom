package tests;

use ecosystem::html;
use std::testing;

#[test]
fn escaping_modes_and_limits() -> () {
    let nul = char_from_u32(0).unwrap_or(' ').to_string();
    testing::assert_eq(testing::expect_ok(html::escape(nul, 1), "NUL preserved"), nul);
    let input = "<&>\"'尾";
    let expected = "&lt;&amp;&gt;&#34;&#39;尾";
    testing::assert_eq(
        testing::expect_ok(html::escape(input, expected.byte_len()), "exact limit"),
        expected,
    );
    testing::assert_eq(html::escape_text(input), "&lt;&amp;&gt;&quot;'尾");
    testing::assert(html::escape(input, expected.byte_len() - 1).is_err());
    testing::assert(html::escape("", -1).is_err());
    testing::assert_eq(testing::expect_ok(html::escape("", 0), "empty"), "");
    testing::assert_eq(testing::expect_ok(html::escape("&amp;", 100), "double escape"), "&amp;amp;");
    for apostrophe in[false, true] {
        for numeric in[false, true] {
            let options = html::EscapeOptions {
                escape_apostrophe: apostrophe,
                numeric_double_quote: numeric,
            };
            let encoded = testing::expect_ok(html::escape_with(input, options, 100), "configured");
            let expected = match (apostrophe, numeric) {
                (false, false) => "&lt;&amp;&gt;&quot;'尾",
                (false, true) => "&lt;&amp;&gt;&#34;'尾",
                (true, false) => "&lt;&amp;&gt;&quot;&#39;尾",
                (true, true) => "&lt;&amp;&gt;&#34;&#39;尾",
            };
            testing::assert_eq(encoded, expected);
            testing::assert_eq(
                testing::expect_ok(html::escaped_len(input, options), "length"),
                encoded.byte_len(),
            );
            for limit in 0..expected.byte_len() + 2 {
                match html::escape_with(input, options, limit) {
                    Ok(value) => {
                        testing::assert(limit >= expected.byte_len());
                        testing::assert_eq(value, expected);
                    },
                    Err(html::Error::LimitExceeded(actual)) => {
                        testing::assert(limit < expected.byte_len());
                        testing::assert_eq(actual, limit);
                    },
                    _ => testing::fail("unexpected configured escape error"),
                }
            }
            for limit in[-1, -9223372036854775807 - 1] {
                match html::escape_with(input, options, limit) {
                    Err(html::Error::InvalidLimit(actual)) => testing::assert_eq(actual, limit),
                    _ => testing::fail("expected invalid escape limit"),
                }
            }
        }
    }
}
