package tests;

use ecosystem::html;
use std::fs;
use std::json;
use std::testing;

fn check_decode_bounds(input: string, expected: string, context: html::DecodeContext) -> () {
    for limit in 0..expected.byte_len() + 2 {
        let result = html::unescape_with(input, context, limit);
        if limit < expected.byte_len() {
            match result {
                Err(html::Error::LimitExceeded(actual)) => testing::assert_eq(actual, limit),
                _ => testing::fail("expected HTML decoded output limit error"),
            }
        } else {
            testing::assert_eq(testing::expect_ok(result, "bounded HTML decode"), expected);
        }
    }
    for limit in[-1, -9223372036854775807 - 1] {
        match html::unescape_with(input, context, limit) {
            Err(html::Error::InvalidLimit(actual)) => testing::assert_eq(actual, limit),
            _ => testing::fail("expected negative HTML decode limit error"),
        }
    }
}

#[test]
fn reference_context_numeric_recovery_and_bounds() -> () {
    for (input, expected) in Vec::from_array(
        [
            ("&notin;", "∉"),
            ("&notit;", "¬it;"),
            ("&amp=", "&="),
            ("&amp;lt;", "&lt;"),
            ("&unknown;", "&unknown;"),
            ("&", "&"),
            ("&#65 &#x41; &#X1F600;", "A A 😀"),
            ("&#0;&#xD800;&#1114112;", "���"),
            ("&#128;&#x9f;", "€Ÿ"),
            ("&#x; &#; &#-1;", "&#x; &#; &#-1;"),
            ("&#999999999999999999999999999999999999;", "�"),
            ("&#000000000000000000000000000000000065;", "A"),
            ("&#1", char_from_u32(1).unwrap_or(' ').to_string()),
        ],
    ) {
        testing::assert_eq(
            testing::expect_ok(html::unescape(input, expected.byte_len()), "HTML reference"),
            expected,
        );
        check_decode_bounds(input, expected, html::DecodeContext::Text);
    }
    for (input, expected) in Vec::from_array(
        [
            ("&notit;", "&notit;"),
            ("&amp=", "&amp="),
            ("&ampx", "&ampx"),
            ("&amp;=", "&="),
            ("&amp!", "&!"),
            ("&#65=", "A="),
        ],
    ) {
        testing::assert_eq(
            testing::expect_ok(
                html::unescape_with(input, html::DecodeContext::Attribute, 100),
                "attribute reference",
            ),
            expected,
        );
        check_decode_bounds(input, expected, html::DecodeContext::Attribute);
    }
    testing::assert(html::unescape("", -1).is_err());
    testing::assert_eq(testing::expect_ok(html::unescape("", 0), "empty decode"), "");
    let legacy = testing::expect_some(
        json::as_array(
            testing::expect_ok(
                json::parse(
                    testing::expect_ok(fs::read_file_structured("data/legacy.json"), "legacy data"),
                ),
                "legacy JSON",
            ),
        ),
        "legacy names",
    );
    testing::assert_eq(legacy.len(), 106);
    for item in legacy {
        let name = testing::expect_some(json::as_string(item), "legacy name");
        let expected = testing::expect_some(html::named_entity(name), "legacy value");
        testing::assert_eq(
            testing::expect_ok(html::unescape("&" + name, 100), "legacy decode"),
            expected,
        );
        for suffix in["A", "Z", "a", "z", "0", "9", "="] {
            let input = "&" + name + suffix;
            testing::assert_eq(
                testing::expect_ok(
                    html::unescape_with(input, html::DecodeContext::Attribute, input.byte_len()),
                    "attribute ambiguity",
                ),
                input,
            );
            let terminated = "&" + name + ";" + suffix;
            testing::assert_eq(
                testing::expect_ok(
                    html::unescape_with(
                        terminated,
                        html::DecodeContext::Attribute,
                        expected.byte_len() + suffix.byte_len(),
                    ),
                    "terminated attribute reference",
                ),
                expected + suffix,
            );
        }
    }
}

#[test]
fn nonlegacy_names_long_prefixes_and_context_bounds() -> () {
    for context in[html::DecodeContext::Text, html::DecodeContext::Attribute] {
        for (input, expected) in[
            ("", ""),
            ("界🙂", "界🙂"),
            ("&apos", "&apos"),
            ("&apos;", "'"),
            ("&NotEqualTilde", "&NotEqualTilde"),
            ("&NotEqualTilde;", "≂̸"),
            ("&CounterClockwiseContourIntegral", "&CounterClockwiseContourIntegral"),
            ("&CounterClockwiseContourIntegral;", "∳"),
            ("&CounterClockwiseContourIntegralx;", "&CounterClockwiseContourIntegralx;"),
            ("&CounterClockwiseContourIntegral;界", "∳界"),
            (
                "&zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz;",
                "&zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz;",
            ),
            (
                "&zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz&amp;",
                "&zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz&",
            ),
            ("&#x10FFFF;", char_from_u32(1114111).unwrap_or(' ').to_string()),
            ("&#x110000;", "�"),
            ("&#xDFFF;", "�"),
            ("&amp;lt;", "&lt;"),
        ] {
            check_decode_bounds(input, expected, context);
        }
    }
    check_decode_bounds("&notin", "¬in", html::DecodeContext::Text);
    check_decode_bounds("&notin", "&notin", html::DecodeContext::Attribute);
    let suffix = "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz;";
    check_decode_bounds("&not" + suffix, "¬" + suffix, html::DecodeContext::Text);
    check_decode_bounds("&not" + suffix, "&not" + suffix, html::DecodeContext::Attribute);
}
