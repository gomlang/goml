package tests;

use ecosystem::html;
use std::fs;
use std::json;
use std::testing;

#[test]
fn all_pinned_named_references_match_independent_data() -> () {
    let source = testing::expect_ok(
        fs::read_file_structured("data/entities.json"),
        "entity reference data",
    );
    let object = testing::expect_ok(json::parse(source), "entity JSON");
    let entries = match object {
        json::Value::Object(entries) => entries,
        _ => {
            testing::assert(false);
            Vec::new()
        },
    };
    testing::assert_eq(entries.len(), 2125);
    for (name, encoded) in entries {
        let expected = testing::expect_some(json::as_string(encoded), "entity value");
        testing::assert_eq(testing::expect_some(html::named_entity(name), "named entity"), expected);
        testing::assert_eq(
            testing::expect_ok(
                html::unescape("&" + name + ";", expected.byte_len()),
                "reference decode",
            ),
            expected,
        );
        testing::assert_eq(
            testing::expect_ok(
                html::unescape_with(
                    "&" + name + ";",
                    html::DecodeContext::Attribute,
                    expected.byte_len(),
                ),
                "attribute reference decode",
            ),
            expected,
        );
    }
    testing::assert(html::named_entity("").is_none());
    testing::assert(html::named_entity("amp;").is_none());
    testing::assert(html::named_entity("notAnEntity").is_none());
    testing::assert_eq(
        testing::expect_some(html::named_entity("NotEqualTilde"), "two scalars"),
        "≂̸",
    );
}
