package html;

pub enum DecodeContext {
    Text,
    Attribute,
}

fn name_byte(value: byte) -> bool {
    (value >= b'a' && value <= b'z') || (value >= b'A' && value <= b'Z')
        || (value >= b'0' && value <= b'9')
}

fn digit(value: byte, radix: isize) -> Option[isize] {
    let result = if value >= b'0' && value <= b'9' {
        (value - b'0').to_isize()
    } else if value >= b'a' && value <= b'f' {
        (value - b'a').to_isize() + 10
    } else if value >= b'A' && value <= b'F' {
        (value - b'A').to_isize() + 10
    } else {
        16
    };
    if result < radix {
        Option::Some(result)
    } else {
        Option::None
    }
}

fn numeric_scalar(value: isize) -> string {
    let code = match value {
        0 | 55296..=57343 => 65533,
        128 => 8364,
        130 => 8218,
        131 => 402,
        132 => 8222,
        133 => 8230,
        134 => 8224,
        135 => 8225,
        136 => 710,
        137 => 8240,
        138 => 352,
        139 => 8249,
        140 => 338,
        142 => 381,
        145 => 8216,
        146 => 8217,
        147 => 8220,
        148 => 8221,
        149 => 8226,
        150 => 8211,
        151 => 8212,
        152 => 732,
        153 => 8482,
        154 => 353,
        155 => 8250,
        156 => 339,
        158 => 382,
        159 => 376,
        _ => if value > 1114111 {
            65533
        } else {
            value
        },
    };
    char_from_u32(code.to_u32()).unwrap_or('�').to_string()
}

fn reference(value: string, start: isize, attribute: bool) -> Option[(string, isize)] {
    let mut index = start + 1;
    if index >= value.byte_len() {
        return Option::None
    }
    if value.byte_get(index) == b'#' {
        index += 1;
        let mut radix = 10;
        if index < value.byte_len()
            && (value.byte_get(index) == b'x' || value.byte_get(index) == b'X') {
            radix = 16;
            index += 1;
        }
        let first = index;
        let mut number = 0;
        while index < value.byte_len() {
            let Some(part) = digit(value.byte_get(index), radix) else {
                break
            };
            if number <= 1114111 {
                number = number * radix + part;
            }
            index += 1;
        }
        if index == first {
            return Option::None
        }
        if index < value.byte_len() && value.byte_get(index) == b';' {
            index += 1;
        }
        return Option::Some((numeric_scalar(number), index))
    }
    let mut found = Option::None;
    while index < value.byte_len() && index - start <= 31 && name_byte(value.byte_get(index)) {
        index += 1;
        let name = value.byte_slice(start + 1, index);
        let semicolon = index < value.byte_len() && value.byte_get(index) == b';';
        if semicolon {
            if let Some(decoded) = named_entity(name) {
                return Option::Some((decoded, index + 1))
            }
        }
        if legacy_entity(name) {
            let ambiguous = attribute && index < value.byte_len()
                && (name_byte(value.byte_get(index)) || value.byte_get(index) == b'=');
            if !ambiguous {
                if let Some(decoded) = named_entity(name) {
                    found = Option::Some((decoded, index));
                }
            }
        }
    }
    found
}

pub fn unescape(value: string, max_bytes: isize) -> Result[string, Error] {
    unescape_with(value, DecodeContext::Text, max_bytes)
}

pub fn unescape_with(value: string, context: DecodeContext, max_bytes: isize) -> Result[
    string,
    Error,
] {
    if max_bytes < 0 {
        return Result::Err(Error::InvalidLimit(max_bytes))
    }
    let attribute = match context {
        DecodeContext::Text => false,
        DecodeContext::Attribute => true,
    };
    let output: Vec[byte] = Vec::new();
    let mut index = 0;
    while index < value.byte_len() {
        if value.byte_get(index) == b'&' {
            if let Some((decoded, end)) = reference(value, index, attribute) {
                if decoded.byte_len() > max_bytes - output.len() {
                    return Result::Err(Error::LimitExceeded(max_bytes))
                }
                for offset in 0..decoded.byte_len() {
                    output.push(decoded.byte_get(offset));
                }
                index = end;
                continue
            }
        }
        if output.len() == max_bytes {
            return Result::Err(Error::LimitExceeded(max_bytes))
        }
        output.push(value.byte_get(index));
        index += 1;
    }
    Result::Ok(string_from_utf8(output).1)
}
