        "REG" => true,
        "THORN" => true,
        "Uacute" => true,
        "Ucirc" => true,
        "Ugrave" => true,
        "Uuml" => true,
        "Yacute" => true,
        "aacute" => true,
        "acirc" => true,
        "acute" => true,
        "aelig" => true,
        "agrave" => true,
        "amp" => true,
