package html;

pub struct EscapeOptions {
    pub escape_apostrophe: bool,
    pub numeric_double_quote: bool,
}

impl EscapeOptions {
    pub fn standard() -> EscapeOptions {
        EscapeOptions { escape_apostrophe: true, numeric_double_quote: true }
    }

    pub fn text() -> EscapeOptions {
        EscapeOptions { escape_apostrophe: false, numeric_double_quote: false }
    }
}

pub enum Error {
    InvalidLimit(isize),
    LimitExceeded(isize),
    LengthOverflow,
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        match self {
            Error::InvalidLimit(limit) => f"invalid HTML output limit: {limit}",
            Error::LimitExceeded(limit) => f"HTML output exceeds byte limit: {limit}",
            Error::LengthOverflow => "HTML output length overflow",
        }
    }
}

impl Debug for Error {
    fn debug(self: Error) -> string {
        self.to_string()
    }
}

fn replacement(value: byte, options: EscapeOptions) -> string {
    match value {
        b'&' => "&amp;",
        b'<' => "&lt;",
        b'>' => "&gt;",
        b'"' => if options.numeric_double_quote {
            "&#34;"
        } else {
            "&quot;"
        },
        b'\'' => if options.escape_apostrophe {
            "&#39;"
        } else {
            ""
        },
        _ => "",
    }
}

pub fn escaped_len(value: string, options: EscapeOptions) -> Result[isize, Error] {
    let mut length = 0;
    for index in 0..value.byte_len() {
        let encoded = replacement(value.byte_get(index), options);
        let width = if encoded.byte_len() == 0 {
            1
        } else {
            encoded.byte_len()
        };
        if length > 9223372036854775807 - width {
            return Result::Err(Error::LengthOverflow)
        }
        length += width;
    }
    Result::Ok(length)
}

fn encode(value: string, options: EscapeOptions) -> string {
    let output: Vec[byte] = Vec::new();
    for index in 0..value.byte_len() {
        let byte = value.byte_get(index);
        let encoded = replacement(byte, options);
        if encoded.byte_len() == 0 {
            output.push(byte);
        } else {
            for offset in 0..encoded.byte_len() {
                output.push(encoded.byte_get(offset));
            }
        }
    }
    string_from_utf8(output).1
}

pub fn escape_with(value: string, options: EscapeOptions, max_bytes: isize) -> Result[string, Error] {
    if max_bytes < 0 {
        return Result::Err(Error::InvalidLimit(max_bytes))
    }
    if escaped_len(value, options)? > max_bytes {
        return Result::Err(Error::LimitExceeded(max_bytes))
    }
    Result::Ok(encode(value, options))
}

pub fn escape(value: string, max_bytes: isize) -> Result[string, Error] {
    escape_with(value, EscapeOptions::standard(), max_bytes)
}

pub fn escape_text(value: string) -> string {
    encode(value, EscapeOptions::text())
}
