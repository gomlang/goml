package color;

use std::num;
use std::math;

fn syntax(message: string) -> Error {
    Error::InvalidSyntax(message)
}

fn hex_digit(value: byte) -> Result[u8, Error] {
    if value >= 48 && value <= 57 {
        Result::Ok(value - 48)
    } else if value >= 97 && value <= 102 {
        Result::Ok(value - 87)
    } else if value >= 65 && value <= 70 {
        Result::Ok(value - 55)
    } else {
        Result::Err(syntax("invalid hexadecimal digit"))
    }
}

fn hex_pair(value: string, index: isize, short: bool) -> Result[u8, Error] {
    let hi = hex_digit(value.byte_get(index))?;
    let lo = if short {
        hi
    } else {
        hex_digit(value.byte_get(index + 1))?
    };
    Result::Ok(hi * 16 + lo)
}

pub fn parse_hex(value: string) -> Result[Srgb, Error] {
    let value = value.trim();
    if !value.starts_with("#") {
        return Result::Err(syntax("hexadecimal color requires #"))
    }
    let length = value.byte_len() - 1;
    if length != 3 && length != 4 && length != 6 && length != 8 {
        return Result::Err(syntax("expected 3, 4, 6 or 8 hexadecimal digits"))
    }
    let short = length <= 4;
    let width = if short {
        1
    } else {
        2
    };
    let r = hex_pair(value, 1, short)?;
    let g = hex_pair(value, 1 + width, short)?;
    let b = hex_pair(value, 1 + 2 * width, short)?;
    let a = if length == 4 || length == 8 {
        hex_pair(value, 1 + 3 * width, short)?
    } else {
        255
    };
    Result::Ok(Srgb::from_rgba8(r, g, b, a))
}

fn digit(value: byte) -> bool {
    value >= 48 && value <= 57
}

fn whitespace(value: byte) -> bool {
    value == 32 || value == 9 || value == 10 || value == 12 || value == 13
}

fn number(value: string) -> Result[f64, Error] {
    let mut index = 0;
    if value.starts_with("+") || value.starts_with("-") {
        index += 1;
    }
    let mut digits = 0;
    while index < value.byte_len() && digit(value.byte_get(index)) {
        digits += 1;
        index += 1;
    }
    if index < value.byte_len() && value.byte_get(index) == 46 {
        index += 1;
        let start = index;
        while index < value.byte_len() && digit(value.byte_get(index)) {
            digits += 1;
            index += 1;
        }
        if start == index {
            return Result::Err(syntax("fraction requires a digit"))
        }
    }
    if digits == 0 {
        return Result::Err(syntax("expected a decimal number"))
    }
    if index < value.byte_len() && (value.byte_get(index) == 101 || value.byte_get(index) == 69) {
        index += 1;
        if index < value.byte_len() && (value.byte_get(index) == 43 || value.byte_get(index) == 45) {
            index += 1;
        }
        let start = index;
        while index < value.byte_len() && digit(value.byte_get(index)) {
            index += 1;
        }
        if start == index {
            return Result::Err(syntax("exponent requires a digit"))
        }
    }
    if index != value.byte_len() {
        return Result::Err(syntax("unexpected number suffix"))
    }
    let parsed = num::parse_float64_structured(value).map_err(|_| syntax("number overflow"))?;
    if !math::is_finite(parsed) {
        return Result::Err(Error::NonFinite("parsed number"))
    }
    Result::Ok(parsed)
}

fn percentage(value: string, required: bool, scale: f64) -> Result[f64, Error] {
    if value.ends_with("%") {
        Result::Ok(clamp(number(value.byte_slice(0, value.byte_len() - 1))? / 100.0, 0.0, 1.0))
    } else if required {
        Result::Err(syntax("expected percentage"))
    } else {
        Result::Ok(clamp(number(value)? / scale, 0.0, 1.0))
    }
}

fn angle(value: string) -> Result[f64, Error] {
    let (suffix, factor) = if value.ends_with("grad") {
        (4, 0.9)
    } else if value.ends_with("turn") {
        (4, 360.0)
    } else if value.ends_with("deg") {
        (3, 1.0)
    } else if value.ends_with("rad") {
        (3, 180.0 / math::PI)
    } else {
        (0, 1.0)
    };
    let result = number(value.byte_slice(0, value.byte_len() - suffix))? * factor;
    check_hue(result)?;
    Result::Ok(hue(result))
}

fn words(value: string) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    let mut index = 0;
    while index < value.byte_len() {
        while index < value.byte_len() && whitespace(value.byte_get(index)) {
            index += 1;
        }
        let start = index;
        while index < value.byte_len() && !whitespace(value.byte_get(index)) {
            index += 1;
        }
        if index > start {
            result.push(value.byte_slice(start, index));
        }
    }
    result
}

pub fn parse(value: string) -> Result[Srgb, Error] {
    if value.byte_len() > 4096 {
        return Result::Err(syntax("input exceeds 4096 bytes"))
    }
    let value = value.trim().to_ascii_lowercase();
    if value.starts_with("#") {
        return parse_hex(value)
    }
    if let Some(color) = named(value) {
        return Result::Ok(color)
    }
    let (name, rest) = value.split_once("(").ok_or(syntax("unknown named color"))?;
    if !rest.ends_with(")") {
        return Result::Err(syntax("missing closing parenthesis"))
    }
    let body = rest.byte_slice(0, rest.byte_len() - 1);
    let legacy = body.contains(",");
    let (parts, alpha) = if legacy {
        if body.contains("/") {
            return Result::Err(syntax("mixed comma and slash separators"))
        }
        let raw = body.split(",");
        if raw.len() != 3 && raw.len() != 4 {
            return Result::Err(syntax("expected three channels and optional alpha"))
        }
        let parts = Vec::from_array([raw[0].trim(), raw[1].trim(), raw[2].trim()]);
        let alpha = if raw.len() == 4 {
            percentage(raw[3].trim(), false, 1.0)?
        } else {
            1.0
        };
        (parts, alpha)
    } else {
        let raw = body.split("/");
        if raw.len() > 2 {
            return Result::Err(syntax("too many alpha separators"))
        }
        let parts = words(raw[0]);
        if parts.len() != 3 {
            return Result::Err(syntax("expected three channels"))
        }
        let alpha = if raw.len() == 2 {
            percentage(raw[1].trim(), false, 1.0)?
        } else {
            1.0
        };
        (parts, alpha)
    };
    if name == "rgb" || name == "rgba" {
        if legacy
            && (parts[0].ends_with("%") != parts[1].ends_with("%")
                || parts[0].ends_with("%") != parts[2].ends_with("%")) {
            return Result::Err(syntax("legacy RGB requires consistent channel units"))
        }
        Srgb::new(
            percentage(parts[0], false, 255.0)?,
            percentage(parts[1], false, 255.0)?,
            percentage(parts[2], false, 255.0)?,
            alpha,
        )
    } else if name == "hsl" || name == "hsla" {
        Result::Ok(
            Hsl::new(
                angle(parts[0])?,
                percentage(parts[1], true, 1.0)?,
                percentage(parts[2], true, 1.0)?,
                alpha,
            )?.to_srgb(),
        )
    } else {
        Result::Err(syntax("unsupported color function"))
    }
}

fn hex_byte(value: u8) -> string {
    let digits = "0123456789abcdef";
    let hi = (value / 16).to_isize();
    let lo = (value % 16).to_isize();
    digits.byte_slice(hi, hi + 1) + digits.byte_slice(lo, lo + 1)
}

impl Srgb {
    pub fn to_hex(self: Srgb) -> string {
        "#" + hex_byte(byte(self.r)) + hex_byte(byte(self.g)) + hex_byte(byte(self.b))
    }

    pub fn to_hex_alpha(self: Srgb) -> string {
        self.to_hex() + hex_byte(byte(self.alpha))
    }

    pub fn to_css(self: Srgb) -> string {
        "rgb(" + (self.r * 255.0).to_string() + " " + (self.g * 255.0).to_string() + " "
            + (self.b * 255.0).to_string()
            + " / "
            + self.alpha.to_string()
            + ")"
    }
}
