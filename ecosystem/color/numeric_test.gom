package color;

use std::math;
use std::num::{ToFloat};
use std::testing;

#[test]
fn angle_reduction_preserves_quadrants_and_axes() -> () {
    for degree in -179..181 {
        let angle = degree.to_f64() * math::PI / 180.0;
        let actual = atan2(math::sin(angle), math::cos(angle));
        testing::assert(abs(actual - angle) <= 0.000000000000001);
    }
    testing::assert_eq(atan2(0.0, 1.0), 0.0);
    testing::assert_eq(atan2(1.0, 0.0), math::PI / 2.0);
    testing::assert_eq(atan2(0.0, -1.0), math::PI);
    testing::assert_eq(atan2(-1.0, 0.0), -math::PI / 2.0);
    testing::assert_eq(atan2(1.0, 1.0), math::PI / 4.0);
}

#[test]
fn cube_root_preserves_sign_and_extreme_magnitudes() -> () {
    for root in Vec::from_array([1.0, 2.0, 3.0, 7.0, 0.25, 1e-100, 1e100]) {
        for sign in Vec::from_array([-1.0, 1.0]) {
            let expected = sign * root;
            let actual = cbrt(expected * expected * expected);
            testing::assert(abs(actual / expected - 1.0) <= 0.000000000000001);
        }
    }
    let smallest = float64_from_bits(1);
    let root = float64_from_bits(0x2990000000000000);
    testing::assert_eq(cbrt(smallest), root);
    testing::assert_eq(cbrt(-smallest), -root);
    testing::assert_eq(cbrt(-0.0).to_bits(), (-0.0).to_bits());
    testing::assert_eq(cbrt(0.0), 0.0);
}
