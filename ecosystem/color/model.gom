package color;

use std::math;
use std::num::{ToFloat, TryToInt};

#[derive(PartialEq, Eq, Debug)]
pub enum Error {
    NonFinite(string),
    OutOfRange(string),
    InvalidSyntax(string),
    InvalidGradient(string),
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        match self {
            NonFinite(name) => "nonfinite color component: " + name,
            OutOfRange(name) => "color component out of range: " + name,
            InvalidSyntax(message) => "invalid color: " + message,
            InvalidGradient(message) => "invalid gradient: " + message,
        }
    }
}

#[derive(PartialEq, Eq, Debug)]
pub enum Gamut {
    Clip,
    PreserveHue,
}

#[derive(PartialEq, Debug)]
pub struct Srgb {
    r: f64,
    g: f64,
    b: f64,
    alpha: f64,
}

#[derive(PartialEq, Debug)]
pub struct LinearRgb {
    r: f64,
    g: f64,
    b: f64,
    alpha: f64,
}

fn abs(value: f64) -> f64 {
    if value < 0.0 {
        -value
    } else {
        value
    }
}

fn min(a: f64, b: f64) -> f64 {
    if a < b {
        a
    } else {
        b
    }
}

fn max(a: f64, b: f64) -> f64 {
    if a > b {
        a
    } else {
        b
    }
}

fn clamp(value: f64, lo: f64, hi: f64) -> f64 {
    max(lo, min(value, hi))
}

fn check(value: f64, lo: f64, hi: f64, name: string) -> Result[(), Error] {
    if !math::is_finite(value) {
        Result::Err(Error::NonFinite(name))
    } else if value < lo || value > hi {
        Result::Err(Error::OutOfRange(name))
    } else {
        Result::Ok(())
    }
}

fn unit(value: f64, name: string) -> Result[(), Error] {
    check(value, 0.0, 1.0, name)
}

fn hue(value: f64) -> f64 {
    let value = value - math::floor(value / 360.0) * 360.0;
    if value >= 360.0 {
        0.0
    } else {
        value
    }
}

fn byte(value: f64) -> u8 {
    match math::round(clamp(value, 0.0, 1.0) * 255.0).try_to_u8() {
        Ok(value) => value,
        Err(_) => 0,
    }
}

pub fn decode_srgb(value: f64) -> Result[f64, Error] {
    check(value, -1000000.0, 1000000.0, "encoded channel")?;
    Result::Ok(decode(value))
}

pub fn encode_srgb(value: f64) -> Result[f64, Error] {
    check(value, -1000000.0, 1000000.0, "linear channel")?;
    Result::Ok(encode(value))
}

fn decode(value: f64) -> f64 {
    let magnitude = abs(value);
    let result = if magnitude <= 0.04045 {
        magnitude / 12.92
    } else {
        math::pow((magnitude + 0.055) / 1.055, 2.4)
    };
    if value < 0.0 {
        -result
    } else {
        result
    }
}

fn encode(value: f64) -> f64 {
    let magnitude = abs(value);
    let result = if magnitude <= 0.0031308 {
        magnitude * 12.92
    } else {
        1.055 * math::pow(magnitude, 1.0 / 2.4) - 0.055
    };
    if value < 0.0 {
        -result
    } else {
        result
    }
}

impl Srgb {
    pub fn new(red: f64, green: f64, blue: f64, alpha: f64) -> Result[Srgb, Error] {
        unit(red, "red")?;
        unit(green, "green")?;
        unit(blue, "blue")?;
        unit(alpha, "alpha")?;
        Result::Ok(Srgb { r: red, g: green, b: blue, alpha })
    }

    pub fn from_rgb8(red: u8, green: u8, blue: u8) -> Srgb {
        Srgb::from_rgba8(red, green, blue, 255)
    }

    pub fn from_rgba8(red: u8, green: u8, blue: u8, alpha: u8) -> Srgb {
        Srgb {
            r: red.to_f64() / 255.0,
            g: green.to_f64() / 255.0,
            b: blue.to_f64() / 255.0,
            alpha: alpha.to_f64() / 255.0,
        }
    }

    pub fn transparent() -> Srgb {
        Srgb { r: 0.0, g: 0.0, b: 0.0, alpha: 0.0 }
    }

    pub fn black() -> Srgb {
        Srgb::from_rgb8(0, 0, 0)
    }

    pub fn white() -> Srgb {
        Srgb::from_rgb8(255, 255, 255)
    }

    pub fn red(self: Srgb) -> f64 {
        self.r
    }

    pub fn green(self: Srgb) -> f64 {
        self.g
    }

    pub fn blue(self: Srgb) -> f64 {
        self.b
    }

    pub fn alpha(self: Srgb) -> f64 {
        self.alpha
    }

    pub fn with_alpha(self: Srgb, alpha: f64) -> Result[Srgb, Error] {
        unit(alpha, "alpha")?;
        Result::Ok(Srgb { alpha, ..self })
    }

    pub fn to_rgb8(self: Srgb) -> (u8, u8, u8) {
        (byte(self.r), byte(self.g), byte(self.b))
    }

    pub fn to_rgba8(self: Srgb) -> (u8, u8, u8, u8) {
        (byte(self.r), byte(self.g), byte(self.b), byte(self.alpha))
    }

    pub fn to_linear(self: Srgb) -> LinearRgb {
        LinearRgb { r: decode(self.r), g: decode(self.g), b: decode(self.b), alpha: self.alpha }
    }

    pub fn composite_over(self: Srgb, background: Srgb) -> Srgb {
        self.to_linear().composite_over(background.to_linear()).to_srgb(Gamut::Clip)
    }

    pub fn relative_luminance(self: Srgb) -> f64 {
        let rgb = self.to_linear();
        0.2126 * rgb.r + 0.7152 * rgb.g + 0.0722 * rgb.b
    }

    pub fn contrast_ratio(self: Srgb, other: Srgb) -> Result[f64, Error] {
        if self.alpha != 1.0 || other.alpha != 1.0 {
            return Result::Err(Error::OutOfRange("contrast requires opaque colors"))
        }
        let a = self.relative_luminance();
        let b = other.relative_luminance();
        Result::Ok((max(a, b) + 0.05) / (min(a, b) + 0.05))
    }

    pub fn contrast_on(self: Srgb, background: Srgb) -> Result[f64, Error] {
        self.composite_over(background).contrast_ratio(background)
    }

    pub fn readable_foreground(self: Srgb) -> Result[Srgb, Error] {
        if self.contrast_ratio(Srgb::black())? >= self.contrast_ratio(Srgb::white())? {
            Result::Ok(Srgb::black())
        } else {
            Result::Ok(Srgb::white())
        }
    }
}

impl LinearRgb {
    pub fn new(red: f64, green: f64, blue: f64, alpha: f64) -> Result[LinearRgb, Error] {
        check(red, -1000000.0, 1000000.0, "linear red")?;
        check(green, -1000000.0, 1000000.0, "linear green")?;
        check(blue, -1000000.0, 1000000.0, "linear blue")?;
        unit(alpha, "alpha")?;
        Result::Ok(LinearRgb { r: red, g: green, b: blue, alpha })
    }

    pub fn red(self: LinearRgb) -> f64 {
        self.r
    }

    pub fn green(self: LinearRgb) -> f64 {
        self.g
    }

    pub fn blue(self: LinearRgb) -> f64 {
        self.b
    }

    pub fn alpha(self: LinearRgb) -> f64 {
        self.alpha
    }

    pub fn is_in_gamut(self: LinearRgb) -> bool {
        self.r >= 0.0 && self.r <= 1.0 && self.g >= 0.0 && self.g <= 1.0 && self.b >= 0.0
            && self.b <= 1.0
    }

    pub fn to_srgb(self: LinearRgb, gamut: Gamut) -> Srgb {
        if gamut == Gamut::PreserveHue && !self.is_in_gamut() {
            return self.to_oklab().to_oklch().gamut_map()
        }
        Srgb {
            r: clamp(encode(self.r), 0.0, 1.0),
            g: clamp(encode(self.g), 0.0, 1.0),
            b: clamp(encode(self.b), 0.0, 1.0),
            alpha: self.alpha,
        }
    }

    pub fn composite_over(self: LinearRgb, background: LinearRgb) -> LinearRgb {
        let remaining = background.alpha * (1.0 - self.alpha);
        let alpha = self.alpha + remaining;
        if alpha == 0.0 {
            return LinearRgb { r: 0.0, g: 0.0, b: 0.0, alpha: 0.0 }
        }
        let foreground_weight = self.alpha / alpha;
        let background_weight = remaining / alpha;
        LinearRgb {
            r: self.r * foreground_weight + background.r * background_weight,
            g: self.g * foreground_weight + background.g * background_weight,
            b: self.b * foreground_weight + background.b * background_weight,
            alpha,
        }
    }
}
