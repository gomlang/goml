package color;

use std::math;
use std::num::{ToFloat};

fn atan_unit(value: f64) -> f64 {
    let mut reduced = value;
    for _ in 0..3 {
        reduced = reduced / (1.0 + math::sqrt(1.0 + reduced * reduced));
    }
    let square = reduced * reduced;
    let mut power = reduced;
    let mut result = reduced;
    for index in 1..10 {
        power = -power * square;
        result += power / (2 * index + 1).to_f64();
    }
    result * 8.0
}

fn atan2(y: f64, x: f64) -> f64 {
    let ax = abs(x);
    let ay = abs(y);
    if ax == 0.0 && ay == 0.0 {
        return 0.0
    }
    let angle = if ay <= ax {
        atan_unit(ay / ax)
    } else {
        math::PI / 2.0 - atan_unit(ax / ay)
    };
    let angle = if x < 0.0 {
        math::PI - angle
    } else {
        angle
    };
    if y < 0.0 {
        -angle
    } else {
        angle
    }
}

fn cbrt(value: f64) -> f64 {
    if value == 0.0 || !math::is_finite(value) {
        return value
    }
    let mut normalized = abs(value);
    let mut scale = 1.0;
    while normalized < 1.0 {
        normalized *= 8.0;
        scale *= 0.5;
    }
    while normalized >= 8.0 {
        normalized *= 0.125;
        scale *= 2.0;
    }
    let mut root = 2.0;
    for _ in 0..8 {
        root = (2.0 * root + normalized / (root * root)) / 3.0;
    }
    let result = root * scale;
    if value < 0.0 {
        -result
    } else {
        result
    }
}
