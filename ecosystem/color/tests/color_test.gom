package tests;

use ecosystem::color;
use ecosystem::color::{Srgb, LinearRgb, Hsl, Hsv, Xyz, Lab, Lch, Oklab, Oklch, Gamut, MixSpace, HueDirection, Gradient, Stop, Extension};
use std::testing;
use std::math;
use std::num::{ToFloat};

fn near(actual: f64, expected: f64, tolerance: f64) -> () {
    let delta = actual - expected;
    testing::assert(delta >= -tolerance && delta <= tolerance);
}

fn rgb(text: string) -> Srgb {
    testing::expect_ok(color::parse(text), text)
}

fn same(a: Srgb, b: Srgb, tolerance: f64) -> () {
    near(a.red(), b.red(), tolerance);
    near(a.green(), b.green(), tolerance);
    near(a.blue(), b.blue(), tolerance);
    near(a.alpha(), b.alpha(), tolerance);
}

#[test]
fn byte_roundtrip_and_transfer_thresholds() -> () {
    for channel in 0..256 {
        let value = Srgb::from_rgba8(
            channel.to_u8(),
            channel.to_u8(),
            channel.to_u8(),
            channel.to_u8(),
        );
        testing::assert_eq(value.to_rgba8().0, channel.to_u8());
        testing::assert_eq(value.to_rgba8().3, channel.to_u8());
        same(value.to_linear().to_srgb(Gamut::Clip), value, 0.000000000000001);
    }
    near(
        testing::expect_ok(color::decode_srgb(0.04045), "threshold"),
        0.00313080495356037,
        0.000000000000001,
    );
    near(
        testing::expect_ok(color::encode_srgb(-0.5), "extended"),
        -0.7353569830524495,
        0.000000000000001,
    );
}

#[test]
fn constructors_reject_invalid_components() -> () {
    let nan = math::sqrt(-1.0);
    let infinity = math::exp(10000.0);
    for invalid in Vec::from_array([nan, infinity, -infinity, -0.1, 1.1]) {
        testing::assert_err(Srgb::new(invalid, 0.0, 0.0, 1.0));
        testing::assert_err(Srgb::black().with_alpha(invalid));
    }
    testing::assert_err(LinearRgb::new(1000001.0, 0.0, 0.0, 1.0));
    testing::assert_err(Hsl::new(infinity, 0.0, 0.0, 1.0));
    testing::assert_err(Hsv::new(0.0, -0.1, 1.0, 1.0));
    testing::assert_err(Xyz::new(nan, 0.0, 0.0, 1.0));
    testing::assert_err(Lab::new(0.0, 10001.0, 0.0, 1.0));
    testing::assert_err(Lch::new(50.0, -1.0, 0.0, 1.0));
    testing::assert_err(Oklab::new(101.0, 0.0, 0.0, 1.0));
    testing::assert_err(Oklch::new(0.5, -0.1, 0.0, 1.0));
    testing::assert_err(color::decode_srgb(nan));
    testing::assert_err(color::encode_srgb(infinity));
}

#[test]
fn hsl_and_hsv_cover_hue_sectors_and_achromatic_colors() -> () {
    let names = Vec::from_array(["red", "yellow", "lime", "cyan", "blue", "magenta"]);
    for index in 0..6 {
        let h = index.to_f64() * 60.0;
        same(
            testing::expect_ok(Hsl::new(h, 1.0, 0.5, 1.0), "hsl").to_srgb(),
            rgb(names[index]),
            0.000000000001,
        );
        same(
            testing::expect_ok(Hsv::new(h, 1.0, 1.0, 1.0), "hsv").to_srgb(),
            rgb(names[index]),
            0.000000000001,
        );
    }
    near(testing::expect_ok(Hsl::new(-30.0, 1.0, 0.5, 1.0), "negative hue").hue(), 330.0, 0.0);
    near(testing::expect_ok(Hsv::new(1080.0, 1.0, 0.5, 1.0), "wrap").hue(), 0.0, 0.0);
    near(rgb("gray").to_hsl().hue(), 0.0, 0.0);
    near(rgb("black").to_hsv().saturation(), 0.0, 0.0);
}

#[test]
fn color_space_roundtrips_preserve_rgb_and_alpha() -> () {
    for r in 0..7 {
        for g in 0..7 {
            for b in 0..7 {
                let value = testing::expect_ok(
                    Srgb::new(r.to_f64() / 6.0, g.to_f64() / 6.0, b.to_f64() / 6.0, 0.37),
                    "grid",
                );
                same(value.to_hsl().to_srgb(), value, 0.000000000001);
                same(value.to_hsv().to_srgb(), value, 0.000000000001);
                same(value.to_xyz().to_srgb(Gamut::Clip), value, 0.000000000001);
                same(value.to_lab().to_lch().to_lab().to_srgb(Gamut::Clip), value, 0.000000000001);
                same(value.to_oklab().to_srgb(Gamut::Clip), value, 0.000002);
                same(value.to_oklch().to_srgb(Gamut::Clip), value, 0.000002);
            }
        }
    }
}

#[test]
fn d65_white_and_primary_coordinates_match_reference() -> () {
    let white = Srgb::white().to_xyz();
    near(white.x(), 0.9504559270516716, 0.000000000000001);
    near(white.y(), 1.0, 0.000000000000001);
    near(white.z(), 1.0890577507598784, 0.000000000000001);
    let lab = Srgb::white().to_lab();
    near(lab.lightness(), 100.0, 0.00000000001);
    near(lab.a(), 0.0, 0.00000000001);
    near(lab.b(), 0.0, 0.00000000001);
    let red = rgb("red").to_oklab();
    near(red.lightness(), 0.6279553606145516, 0.0000000001);
    near(red.a(), 0.22486306106597398, 0.0000000001);
    near(red.b(), 0.1258462985307351, 0.0000000001);
}

#[test]
fn extended_signed_linear_and_xyz_values_remain_finite() -> () {
    let value = testing::expect_ok(LinearRgb::new(-0.2, 1.4, 0.3, 0.5), "extended linear");
    testing::assert(!value.is_in_gamut());
    let inverse = value.to_xyz().to_linear();
    near(inverse.red(), -0.2, 0.000000000001);
    near(inverse.green(), 1.4, 0.000000000001);
    let inverse = value.to_oklab().to_linear();
    near(inverse.red(), -0.2, 0.000001);
    near(inverse.green(), 1.4, 0.000001);
    testing::assert(math::is_finite(value.to_xyz().to_lab().lightness()));
}

#[test]
fn gamut_mapping_preserves_oklch_hue_and_lightness() -> () {
    let outside = testing::expect_ok(Oklch::new(0.65, 0.5, 35.0, 0.4), "out of gamut");
    let mapped = outside.to_srgb(Gamut::PreserveHue);
    testing::assert(mapped.to_linear().is_in_gamut());
    near(mapped.to_oklch().lightness(), 0.65, 0.0000001);
    near(mapped.to_oklch().hue(), 35.0, 0.0001);
    testing::assert(mapped.to_oklch().chroma() < 0.5);
    near(mapped.alpha(), 0.4, 0.0);
    testing::assert_eq(
        testing::expect_ok(Oklch::new(-1.0, 0.5, 40.0, 1.0), "negative").to_srgb(Gamut::PreserveHue).to_hex(),
        "#000000",
    );
    testing::assert_eq(
        testing::expect_ok(Oklch::new(2.0, 0.5, 40.0, 1.0), "bright").to_srgb(Gamut::PreserveHue).to_hex(),
        "#ffffff",
    );
}

#[test]
fn source_over_uses_linear_light_and_handles_zero_alpha() -> () {
    let half = testing::expect_ok(Srgb::white().with_alpha(0.5), "half");
    let result = half.composite_over(Srgb::black());
    near(result.red(), 0.7353569830524495, 0.000000000001);
    near(result.alpha(), 1.0, 0.0);
    let result = half.composite_over(testing::expect_ok(rgb("red").with_alpha(0.5), "half red"));
    near(result.alpha(), 0.75, 0.0);
    near(result.red(), 1.0, 0.000000000001);
    same(Srgb::transparent().composite_over(Srgb::transparent()), Srgb::transparent(), 0.0);
    same(rgb("red").composite_over(Srgb::transparent()), rgb("red"), 0.000000000001);
}

#[test]
fn contrast_requires_opaque_background_and_chooses_readable_text() -> () {
    near(
        testing::expect_ok(Srgb::black().contrast_ratio(Srgb::white()), "contrast"),
        21.0,
        0.000000000001,
    );
    near(testing::expect_ok(rgb("red").contrast_ratio(rgb("red")), "same"), 1.0, 0.0);
    testing::assert_err(Srgb::transparent().contrast_ratio(Srgb::white()));
    testing::assert_err(Srgb::white().contrast_on(Srgb::transparent()));
    near(
        testing::expect_ok(Srgb::transparent().contrast_on(Srgb::white()), "transparent"),
        1.0,
        0.0,
    );
    testing::assert_eq(
        testing::expect_ok(Srgb::black().readable_foreground(), "text").to_hex(),
        "#ffffff",
    );
    testing::assert_eq(
        testing::expect_ok(Srgb::white().readable_foreground(), "text").to_hex(),
        "#000000",
    );
}

#[test]
fn hexadecimal_forms_roundtrip() -> () {
    testing::assert_eq(rgb("#123").to_hex(), "#112233");
    testing::assert_eq(rgb("#1234").to_hex_alpha(), "#11223344");
    testing::assert_eq(rgb("#AbCdEf80").to_hex_alpha(), "#abcdef80");
    testing::assert_eq(rgb("  #Ff0000 ").to_hex(), "#ff0000");
    for bad in Vec::from_array(
        ["", "123", "#", "#12", "#12345", "#1234567", "#123456789", "#00zz00", "#💖"],
    ) {
        testing::assert_err(color::parse_hex(bad));
    }
}

#[test]
fn css_rgb_hsl_units_alpha_clamping_and_aliases() -> () {
    testing::assert_eq(rgb("RGB(255, 0, 128)").to_hex(), "#ff0080");
    testing::assert_eq(rgb("rgb(100% 0 50% / 50%)").to_hex_alpha(), "#ff008080");
    testing::assert_eq(rgb("rgba(255, 0, 0, .25)").to_hex_alpha(), "#ff000040");
    testing::assert_eq(rgb("rgb(-30 280 0 / 2)").to_hex_alpha(), "#00ff00ff");
    testing::assert_eq(rgb("hsl(.5turn 100% 50%)").to_hex(), "#00ffff");
    testing::assert_eq(rgb("hsl(200grad, 100%, 50%)").to_hex(), "#00ffff");
    testing::assert_eq(rgb("hsla(-120deg 100% 50% / .5)").to_hex_alpha(), "#0000ff80");
    testing::assert_eq(rgb("hsl(3.141592653589793rad 100% 50%)").to_hex(), "#00ffff");
    testing::assert_eq(rgb("rgb(2.55e2 0e0 0)").to_hex(), "#ff0000");
    testing::assert_eq(rgb("rebeccapurple").to_hex(), "#663399");
    testing::assert_eq(rgb("TRANSPARENT").alpha(), 0.0);
}

#[test]
fn css_rejects_malformed_and_unsupported_inputs() -> () {
    for bad in Vec::from_array(
        [
            "currentcolor",
            "none",
            "rgb(1, 2 3)",
            "rgb(1,2,3/1)",
            "rgb(1% 2% 3% /)",
            "rgb(1,2%,3)",
            "rgb(NaN 0 0)",
            "rgb(1e999 0 0)",
            "rgb(1_0 0 0)",
            "rgb(0x10 0 0)",
            "rgb(1. 0 0)",
            "rgb(1e 0 0)",
            "rgb(1 2 3 / 1 / 1)",
            "rgb(1 2 3)junk",
            "rgb (1 2 3)",
            "hsl(0 1 1)",
            "hsl(0foo 100% 50%)",
            "lab(50% 0 0)",
            "rgb(1 2 3)",
        ],
    ) {
        testing::assert_err(color::parse(bad));
    }
    testing::assert_err(color::parse("x".repeat(4097)));
}

#[test]
fn css_serialization_preserves_fractional_channels() -> () {
    let original = testing::expect_ok(
        Srgb::new(0.123456789, 0.987654321, 0.314159265, 0.271828182),
        "color",
    );
    same(rgb(original.to_css()), original, 0.000000000000001);
}

#[test]
fn mix_premultiplies_alpha_and_distinguishes_color_spaces() -> () {
    let linear = testing::expect_ok(
        color::mix(Srgb::black(), Srgb::white(), 0.5, MixSpace::LinearRgb, Gamut::Clip),
        "linear",
    );
    let encoded = testing::expect_ok(
        color::mix(Srgb::black(), Srgb::white(), 0.5, MixSpace::Srgb, Gamut::Clip),
        "encoded",
    );
    near(linear.red(), 0.7353569830524495, 0.000000000001);
    near(encoded.red(), 0.5, 0.0);
    let transparent_red = testing::expect_ok(rgb("red").with_alpha(0.0), "transparent red");
    for space in Vec::from_array(
        [MixSpace::Srgb, MixSpace::LinearRgb, MixSpace::Lab, MixSpace::Oklab],
    ) {
        let result = testing::expect_ok(
            color::mix(transparent_red, rgb("blue"), 0.5, space, Gamut::Clip),
            "mix",
        );
        near(result.alpha(), 0.5, 0.0);
        same(result, testing::expect_ok(rgb("blue").with_alpha(0.5), "half blue"), 0.000002);
    }
    testing::assert_err(
        color::mix(rgb("red"), rgb("blue"), math::sqrt(-1.0), MixSpace::Oklab, Gamut::Clip),
    );
    testing::assert_err(color::mix(rgb("red"), rgb("blue"), 1.1, MixSpace::Oklab, Gamut::Clip));
}

#[test]
fn hue_interpolation_policies_and_powerless_hue() -> () {
    let a = testing::expect_ok(Hsl::new(350.0, 1.0, 0.5, 1.0), "a").to_srgb();
    let b = testing::expect_ok(Hsl::new(10.0, 1.0, 0.5, 1.0), "b").to_srgb();
    for direction in Vec::from_array([HueDirection::Shorter, HueDirection::Increasing]) {
        testing::assert_eq(
            testing::expect_ok(
                color::mix(a, b, 0.5, MixSpace::Hsl(direction), Gamut::Clip),
                "short",
            ).to_hex(),
            "#ff0000",
        );
    }
    for direction in Vec::from_array([HueDirection::Longer, HueDirection::Decreasing]) {
        testing::assert_eq(
            testing::expect_ok(color::mix(a, b, 0.5, MixSpace::Hsl(direction), Gamut::Clip), "long").to_hex(),
            "#00ffff",
        );
    }
    let result = testing::expect_ok(
        color::mix(rgb("gray"), rgb("blue"), 0.5, MixSpace::Hsl(HueDirection::Shorter), Gamut::Clip),
        "borrow hue",
    );
    near(result.to_hsl().hue(), 240.0, 0.00000000001);
}

#[test]
fn gradients_snapshot_stops_and_support_hard_edges() -> () {
    let stops = Vec::from_array(
        [
            Stop { position: 0.0, color: rgb("red") },
            Stop { position: 0.5, color: rgb("red") },
            Stop { position: 0.5, color: rgb("blue") },
            Stop { position: 1.0, color: rgb("blue") },
        ],
    );
    let gradient = testing::expect_ok(
        Gradient::new(stops, MixSpace::Srgb, Gamut::Clip, Extension::Clamp),
        "gradient",
    );
    stops[0] = Stop { position: 0.0, color: rgb("lime") };
    testing::assert_eq(gradient.len(), 4);
    testing::assert_eq(testing::expect_ok(gradient.sample(0.0), "snapshot").to_hex(), "#ff0000");
    testing::assert_eq(
        testing::expect_ok(gradient.sample(0.49999), "left edge").to_hex(),
        "#ff0000",
    );
    testing::assert_eq(testing::expect_ok(gradient.sample(0.5), "right edge").to_hex(), "#0000ff");
    testing::assert_eq(testing::expect_ok(gradient.sample(2.0), "clamp").to_hex(), "#0000ff");
    testing::assert_eq(testing::expect_ok(gradient.samples(1), "one sample").len(), 1);
    testing::assert_eq(testing::expect_ok(gradient.samples(0), "empty samples").len(), 0);
}

#[test]
fn gradients_extend_repeat_mirror_and_reject_invalid_definitions() -> () {
    let stops = Vec::from_array(
        [Stop { position: 0.0, color: Srgb::black() }, Stop { position: 1.0, color: Srgb::white() }],
    );
    let repeat = testing::expect_ok(
        Gradient::new(stops, MixSpace::Srgb, Gamut::Clip, Extension::Repeat),
        "repeat",
    );
    let mirror = testing::expect_ok(
        Gradient::new(stops, MixSpace::Srgb, Gamut::Clip, Extension::Mirror),
        "mirror",
    );
    near(testing::expect_ok(repeat.sample(-0.25), "repeat negative").red(), 0.75, 0.0);
    near(testing::expect_ok(repeat.sample(1.0), "repeat boundary").red(), 0.0, 0.0);
    near(testing::expect_ok(mirror.sample(1.25), "mirror").red(), 0.75, 0.0);
    near(testing::expect_ok(mirror.sample(-0.25), "mirror negative").red(), 0.25, 0.0);
    testing::assert_err(Gradient::new(Vec::new(), MixSpace::Srgb, Gamut::Clip, Extension::Clamp));
    testing::assert_err(
        Gradient::new(
            Vec::from_array([stops[1], stops[0]]),
            MixSpace::Srgb,
            Gamut::Clip,
            Extension::Clamp,
        ),
    );
    testing::assert_err(repeat.samples(-1));
    testing::assert_err(repeat.samples(65537));
    testing::assert_err(repeat.sample(math::sqrt(-1.0)));
}

#[test]
fn color_differences_match_published_ciede2000_pair() -> () {
    let a = testing::expect_ok(Lab::new(50.0, 2.6772, -79.7751, 1.0), "a");
    let b = testing::expect_ok(Lab::new(50.0, 0.0, -82.7485, 1.0), "b");
    near(a.delta_e_2000(b), 2.0425, 0.00005);
    near(b.delta_e_2000(a), 2.0425, 0.00005);
    near(a.delta_e_2000(a), 0.0, 0.0);
    near(a.delta_e_76(a), 0.0, 0.0);
    near(rgb("red").to_oklab().delta_e(rgb("red").to_oklab()), 0.0, 0.0);
}

#[test]
fn mixing_subnormal_alpha_preserves_chromatic_components() -> () {
    let tiny = 5e-324;
    let red = testing::expect_ok(Srgb::new(1.0, 0.0, 0.0, tiny), "tiny red");
    let blue = testing::expect_ok(Srgb::new(0.0, 0.0, 1.0, tiny), "tiny blue");
    for space in Vec::from_array(
        [
            MixSpace::Srgb,
            MixSpace::LinearRgb,
            MixSpace::Lab,
            MixSpace::Oklab,
            MixSpace::Hsl(HueDirection::Shorter),
            MixSpace::Oklch(HueDirection::Shorter),
        ],
    ) {
        let same_color = testing::expect_ok(
            color::mix(red, red, 0.5, space, Gamut::Clip),
            "same tiny colors",
        );
        testing::assert_eq(same_color.alpha(), tiny);
        near(same_color.red(), 1.0, 0.000002);
        near(same_color.green(), 0.0, 0.000002);
        near(same_color.blue(), 0.0, 0.000002);
        let tiny_result = testing::expect_ok(
            color::mix(red, blue, 0.5, space, Gamut::Clip),
            "different tiny colors",
        );
        let normal_result = testing::expect_ok(
            color::mix(rgb("red"), rgb("blue"), 0.5, space, Gamut::Clip),
            "opaque reference",
        );
        testing::assert_eq(tiny_result.alpha(), tiny);
        near(tiny_result.red(), normal_result.red(), 0.000000000001);
        near(tiny_result.green(), normal_result.green(), 0.000000000001);
        near(tiny_result.blue(), normal_result.blue(), 0.000000000001);
    }
    let one = testing::expect_ok(Srgb::new(1.0, 0.0, 0.0, tiny), "one unit");
    let four = testing::expect_ok(Srgb::new(0.0, 0.0, 1.0, tiny * 4.0), "four units");
    let weighted = testing::expect_ok(
        color::mix(one, four, 0.5, MixSpace::Srgb, Gamut::Clip),
        "unequal tiny alpha",
    );
    near(weighted.red(), 0.2, 0.000000000000001);
    near(weighted.blue(), 0.8, 0.000000000000001);
    testing::assert_eq(weighted.alpha(), tiny * 2.0);
}

#[test]
fn mixing_extreme_alpha_endpoints_and_zero_results_remain_finite() -> () {
    let tiny = 5e-324;
    for alpha in Vec::from_array(
        [0.0, tiny, tiny * 128.0, 2.2250738585072014e-308, 1e-200, 0.5, 1.0],
    ) {
        let a = testing::expect_ok(Srgb::new(0.125, 0.5, 0.75, alpha), "a");
        let b = testing::expect_ok(Srgb::new(0.875, 0.25, 0.5, tiny), "b");
        for space in Vec::from_array(
            [
                MixSpace::Srgb,
                MixSpace::LinearRgb,
                MixSpace::Lab,
                MixSpace::Oklab,
                MixSpace::Hsl(HueDirection::Longer),
                MixSpace::Oklch(HueDirection::Increasing),
            ],
        ) {
            testing::assert_eq(
                testing::expect_ok(color::mix(a, b, 0.0, space, Gamut::Clip), "left endpoint"),
                a,
            );
            testing::assert_eq(
                testing::expect_ok(color::mix(a, b, 1.0, space, Gamut::Clip), "right endpoint"),
                b,
            );
            for fraction in Vec::from_array([tiny, 0.25, 0.5, 0.75, 0.9999999999999999]) {
                let value = testing::expect_ok(
                    color::mix(a, b, fraction, space, Gamut::PreserveHue),
                    "finite mixture",
                );
                for channel in Vec::from_array(
                    [value.red(), value.green(), value.blue(), value.alpha()],
                ) {
                    testing::assert(math::is_finite(channel));
                    testing::assert(channel >= 0.0 && channel <= 1.0);
                }
            }
        }
    }
    let zero = Srgb::transparent();
    let tiny_red = testing::expect_ok(rgb("red").with_alpha(tiny), "tiny red");
    let underflow = testing::expect_ok(
        color::mix(zero, tiny_red, 0.25, MixSpace::Srgb, Gamut::Clip),
        "rounded zero alpha",
    );
    testing::assert_eq(underflow, zero);
    let survives = testing::expect_ok(
        color::mix(zero, tiny_red, 0.75, MixSpace::Srgb, Gamut::Clip),
        "rounded positive alpha",
    );
    testing::assert_eq(survives.alpha(), tiny);
    testing::assert_eq(survives.red(), 1.0);
}
