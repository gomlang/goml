package color;

use std::math;

#[go_ffi("math", "Atan2")]
extern fn atan2(y: f64, x: f64) -> f64;

#[go_ffi("math", "Cbrt")]
extern fn cbrt(value: f64) -> f64;

#[derive(PartialEq, Debug)]
pub struct Hsl {
    h: f64,
    s: f64,
    l: f64,
    alpha: f64,
}

#[derive(PartialEq, Debug)]
pub struct Hsv {
    h: f64,
    s: f64,
    v: f64,
    alpha: f64,
}

#[derive(PartialEq, Debug)]
pub struct Xyz {
    x: f64,
    y: f64,
    z: f64,
    alpha: f64,
}

#[derive(PartialEq, Debug)]
pub struct Lab {
    l: f64,
    a: f64,
    b: f64,
    alpha: f64,
}

#[derive(PartialEq, Debug)]
pub struct Lch {
    l: f64,
    c: f64,
    h: f64,
    alpha: f64,
}

#[derive(PartialEq, Debug)]
pub struct Oklab {
    l: f64,
    a: f64,
    b: f64,
    alpha: f64,
}

#[derive(PartialEq, Debug)]
pub struct Oklch {
    l: f64,
    c: f64,
    h: f64,
    alpha: f64,
}

fn check_hue(value: f64) -> Result[(), Error] {
    check(value, -1000000000.0, 1000000000.0, "hue")
}

fn polar_hue(a: f64, b: f64) -> f64 {
    if abs(a) + abs(b) < 0.000000000001 {
        0.0
    } else {
        hue(atan2(b, a) * 180.0 / math::PI)
    }
}

fn sector(h: f64, chroma: f64, offset: f64, alpha: f64) -> Srgb {
    let position = h / 60.0;
    let x = chroma * (1.0 - abs(position - 2.0 * math::floor(position / 2.0) - 1.0));
    let (r, g, b) = if position < 1.0 {
        (chroma, x, 0.0)
    } else if position < 2.0 {
        (x, chroma, 0.0)
    } else if position < 3.0 {
        (0.0, chroma, x)
    } else if position < 4.0 {
        (0.0, x, chroma)
    } else if position < 5.0 {
        (x, 0.0, chroma)
    } else {
        (chroma, 0.0, x)
    };
    Srgb {
        r: clamp(r + offset, 0.0, 1.0),
        g: clamp(g + offset, 0.0, 1.0),
        b: clamp(b + offset, 0.0, 1.0),
        alpha,
    }
}

impl Hsl {
    pub fn new(h: f64, s: f64, l: f64, alpha: f64) -> Result[Hsl, Error] {
        check_hue(h)?;
        unit(s, "saturation")?;
        unit(l, "lightness")?;
        unit(alpha, "alpha")?;
        Result::Ok(Hsl { h: hue(h), s, l, alpha })
    }

    pub fn hue(self: Hsl) -> f64 {
        self.h
    }

    pub fn saturation(self: Hsl) -> f64 {
        self.s
    }

    pub fn lightness(self: Hsl) -> f64 {
        self.l
    }

    pub fn alpha(self: Hsl) -> f64 {
        self.alpha
    }

    pub fn to_srgb(self: Hsl) -> Srgb {
        let c = (1.0 - abs(2.0 * self.l - 1.0)) * self.s;
        sector(self.h, c, self.l - c / 2.0, self.alpha)
    }
}

impl Hsv {
    pub fn new(h: f64, s: f64, v: f64, alpha: f64) -> Result[Hsv, Error] {
        check_hue(h)?;
        unit(s, "saturation")?;
        unit(v, "value")?;
        unit(alpha, "alpha")?;
        Result::Ok(Hsv { h: hue(h), s, v, alpha })
    }

    pub fn hue(self: Hsv) -> f64 {
        self.h
    }

    pub fn saturation(self: Hsv) -> f64 {
        self.s
    }

    pub fn value(self: Hsv) -> f64 {
        self.v
    }

    pub fn alpha(self: Hsv) -> f64 {
        self.alpha
    }

    pub fn to_srgb(self: Hsv) -> Srgb {
        let c = self.v * self.s;
        sector(self.h, c, self.v - c, self.alpha)
    }
}

impl Srgb {
    fn cylindrical(self: Srgb) -> (f64, f64, f64) {
        let hi = max(self.r, max(self.g, self.b));
        let lo = min(self.r, min(self.g, self.b));
        let c = hi - lo;
        let h = if c == 0.0 {
            0.0
        } else if hi == self.r {
            hue(60.0 * (self.g - self.b) / c)
        } else if hi == self.g {
            60.0 * ((self.b - self.r) / c + 2.0)
        } else {
            60.0 * ((self.r - self.g) / c + 4.0)
        };
        (h, lo, hi)
    }

    pub fn to_hsl(self: Srgb) -> Hsl {
        let (h, lo, hi) = self.cylindrical();
        let l = (lo + hi) / 2.0;
        let s = if hi == lo {
            0.0
        } else {
            (hi - lo) / (1.0 - abs(2.0 * l - 1.0))
        };
        Hsl { h, s: clamp(s, 0.0, 1.0), l, alpha: self.alpha }
    }

    pub fn to_hsv(self: Srgb) -> Hsv {
        let (h, lo, hi) = self.cylindrical();
        Hsv {
            h,
            s: if hi == 0.0 {
                0.0
            } else {
                (hi - lo) / hi
            },
            v: hi,
            alpha: self.alpha,
        }
    }

    pub fn to_xyz(self: Srgb) -> Xyz {
        self.to_linear().to_xyz()
    }

    pub fn to_lab(self: Srgb) -> Lab {
        self.to_xyz().to_lab()
    }

    pub fn to_oklab(self: Srgb) -> Oklab {
        self.to_linear().to_oklab()
    }

    pub fn to_oklch(self: Srgb) -> Oklch {
        self.to_oklab().to_oklch()
    }
}

impl LinearRgb {
    pub fn to_xyz(self: LinearRgb) -> Xyz {
        Xyz {
            x: 0.41239079926595934 * self.r + 0.357584339383878 * self.g
                + 0.1804807884018343 * self.b,
            y: 0.21263900587151027 * self.r + 0.715168678767756 * self.g
                + 0.07219231536073371 * self.b,
            z: 0.01933081871559185 * self.r + 0.11919477979462598 * self.g
                + 0.9505321522496607 * self.b,
            alpha: self.alpha,
        }
    }

    pub fn to_oklab(self: LinearRgb) -> Oklab {
        let l = cbrt(0.4122214708 * self.r + 0.5363325363 * self.g + 0.0514459929 * self.b);
        let m = cbrt(0.2119034982 * self.r + 0.6806995451 * self.g + 0.1073969566 * self.b);
        let s = cbrt(0.0883024619 * self.r + 0.2817188376 * self.g + 0.6299787005 * self.b);
        Oklab {
            l: 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
            a: 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
            b: 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s,
            alpha: self.alpha,
        }
    }
}

fn lab_curve(value: f64) -> f64 {
    if value > 216.0 / 24389.0 {
        cbrt(value)
    } else {
        (24389.0 / 27.0 * value + 16.0) / 116.0
    }
}

fn lab_inverse(value: f64) -> f64 {
    if value > 6.0 / 29.0 {
        value * value * value
    } else {
        (116.0 * value - 16.0) * 27.0 / 24389.0
    }
}

impl Xyz {
    pub fn new(x: f64, y: f64, z: f64, alpha: f64) -> Result[Xyz, Error] {
        check(x, -1000000.0, 1000000.0, "X")?;
        check(y, -1000000.0, 1000000.0, "Y")?;
        check(z, -1000000.0, 1000000.0, "Z")?;
        unit(alpha, "alpha")?;
        Result::Ok(Xyz { x, y, z, alpha })
    }

    pub fn x(self: Xyz) -> f64 {
        self.x
    }

    pub fn y(self: Xyz) -> f64 {
        self.y
    }

    pub fn z(self: Xyz) -> f64 {
        self.z
    }

    pub fn alpha(self: Xyz) -> f64 {
        self.alpha
    }

    pub fn to_linear(self: Xyz) -> LinearRgb {
        LinearRgb {
            r: 3.2409699419045226 * self.x - 1.537383177570094 * self.y
                - 0.4986107602930034 * self.z,
            g: -0.9692436362808796 * self.x + 1.8759675015077202 * self.y
                + 0.04155505740717559 * self.z,
            b: 0.05563007969699366 * self.x - 0.20397695888897652 * self.y
                + 1.0569715142428786 * self.z,
            alpha: self.alpha,
        }
    }

    pub fn to_srgb(self: Xyz, gamut: Gamut) -> Srgb {
        self.to_linear().to_srgb(gamut)
    }

    pub fn to_lab(self: Xyz) -> Lab {
        let x = lab_curve(self.x / 0.9504559270516716);
        let y = lab_curve(self.y);
        let z = lab_curve(self.z / 1.0890577507598784);
        Lab { l: 116.0 * y - 16.0, a: 500.0 * (x - y), b: 200.0 * (y - z), alpha: self.alpha }
    }
}

impl Lab {
    pub fn new(l: f64, a: f64, b: f64, alpha: f64) -> Result[Lab, Error] {
        check(l, -10000.0, 10000.0, "Lab lightness")?;
        check(a, -10000.0, 10000.0, "Lab a")?;
        check(b, -10000.0, 10000.0, "Lab b")?;
        unit(alpha, "alpha")?;
        Result::Ok(Lab { l, a, b, alpha })
    }

    pub fn lightness(self: Lab) -> f64 {
        self.l
    }

    pub fn a(self: Lab) -> f64 {
        self.a
    }

    pub fn b(self: Lab) -> f64 {
        self.b
    }

    pub fn alpha(self: Lab) -> f64 {
        self.alpha
    }

    pub fn to_xyz(self: Lab) -> Xyz {
        let y = (self.l + 16.0) / 116.0;
        Xyz {
            x: 0.9504559270516716 * lab_inverse(y + self.a / 500.0),
            y: lab_inverse(y),
            z: 1.0890577507598784 * lab_inverse(y - self.b / 200.0),
            alpha: self.alpha,
        }
    }

    pub fn to_srgb(self: Lab, gamut: Gamut) -> Srgb {
        self.to_xyz().to_srgb(gamut)
    }

    pub fn to_lch(self: Lab) -> Lch {
        Lch {
            l: self.l,
            c: math::sqrt(self.a * self.a + self.b * self.b),
            h: polar_hue(self.a, self.b),
            alpha: self.alpha,
        }
    }

    pub fn delta_e_76(self: Lab, other: Lab) -> f64 {
        distance(self.l - other.l, self.a - other.a, self.b - other.b)
    }
}

fn distance(a: f64, b: f64, c: f64) -> f64 {
    math::sqrt(a * a + b * b + c * c)
}

impl Lch {
    pub fn new(l: f64, c: f64, h: f64, alpha: f64) -> Result[Lch, Error] {
        check(l, -10000.0, 10000.0, "LCh lightness")?;
        check(c, 0.0, 10000.0, "LCh chroma")?;
        check_hue(h)?;
        unit(alpha, "alpha")?;
        Result::Ok(Lch { l, c, h: hue(h), alpha })
    }

    pub fn lightness(self: Lch) -> f64 {
        self.l
    }

    pub fn chroma(self: Lch) -> f64 {
        self.c
    }

    pub fn hue(self: Lch) -> f64 {
        self.h
    }

    pub fn alpha(self: Lch) -> f64 {
        self.alpha
    }

    pub fn to_lab(self: Lch) -> Lab {
        Lab {
            l: self.l,
            a: self.c * math::cos(self.h * math::PI / 180.0),
            b: self.c * math::sin(self.h * math::PI / 180.0),
            alpha: self.alpha,
        }
    }

    pub fn to_srgb(self: Lch, gamut: Gamut) -> Srgb {
        self.to_lab().to_srgb(gamut)
    }
}

impl Oklab {
    pub fn new(l: f64, a: f64, b: f64, alpha: f64) -> Result[Oklab, Error] {
        check(l, -100.0, 100.0, "Oklab lightness")?;
        check(a, -100.0, 100.0, "Oklab a")?;
        check(b, -100.0, 100.0, "Oklab b")?;
        unit(alpha, "alpha")?;
        Result::Ok(Oklab { l, a, b, alpha })
    }

    pub fn lightness(self: Oklab) -> f64 {
        self.l
    }

    pub fn a(self: Oklab) -> f64 {
        self.a
    }

    pub fn b(self: Oklab) -> f64 {
        self.b
    }

    pub fn alpha(self: Oklab) -> f64 {
        self.alpha
    }

    pub fn to_linear(self: Oklab) -> LinearRgb {
        let l = self.l + 0.3963377774 * self.a + 0.2158037573 * self.b;
        let m = self.l - 0.1055613458 * self.a - 0.0638541728 * self.b;
        let s = self.l - 0.0894841775 * self.a - 1.2914855480 * self.b;
        let l = l * l * l;
        let m = m * m * m;
        let s = s * s * s;
        LinearRgb {
            r: 4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
            g: -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
            b: -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s,
            alpha: self.alpha,
        }
    }

    pub fn to_srgb(self: Oklab, gamut: Gamut) -> Srgb {
        self.to_linear().to_srgb(gamut)
    }

    pub fn to_oklch(self: Oklab) -> Oklch {
        Oklch {
            l: self.l,
            c: math::sqrt(self.a * self.a + self.b * self.b),
            h: polar_hue(self.a, self.b),
            alpha: self.alpha,
        }
    }

    pub fn delta_e(self: Oklab, other: Oklab) -> f64 {
        distance(self.l - other.l, self.a - other.a, self.b - other.b)
    }
}

impl Oklch {
    pub fn new(l: f64, c: f64, h: f64, alpha: f64) -> Result[Oklch, Error] {
        check(l, -100.0, 100.0, "Oklch lightness")?;
        check(c, 0.0, 100.0, "Oklch chroma")?;
        check_hue(h)?;
        unit(alpha, "alpha")?;
        Result::Ok(Oklch { l, c, h: hue(h), alpha })
    }

    pub fn lightness(self: Oklch) -> f64 {
        self.l
    }

    pub fn chroma(self: Oklch) -> f64 {
        self.c
    }

    pub fn hue(self: Oklch) -> f64 {
        self.h
    }

    pub fn alpha(self: Oklch) -> f64 {
        self.alpha
    }

    pub fn to_oklab(self: Oklch) -> Oklab {
        Oklab {
            l: self.l,
            a: self.c * math::cos(self.h * math::PI / 180.0),
            b: self.c * math::sin(self.h * math::PI / 180.0),
            alpha: self.alpha,
        }
    }

    pub fn to_srgb(self: Oklch, gamut: Gamut) -> Srgb {
        self.to_oklab().to_srgb(gamut)
    }

    fn gamut_map(self: Oklch) -> Srgb {
        if self.l <= 0.0 {
            return Srgb { alpha: self.alpha, ..Srgb::black() }
        }
        if self.l >= 1.0 {
            return Srgb { alpha: self.alpha, ..Srgb::white() }
        }
        let mut low = 0.0;
        let mut high = self.c;
        for _ in 0..40 {
            let mid = (low + high) / 2.0;
            if (Oklch { c: mid, ..self }).to_oklab().to_linear().is_in_gamut() {
                low = mid;
            } else {
                high = mid;
            }
        }
        let mapped = Oklch { c: low, ..self };
        mapped.to_oklab().to_linear().to_srgb(Gamut::Clip)
    }
}
