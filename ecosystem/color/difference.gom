package color;

use std::math;

fn cos_deg(angle: f64) -> f64 {
    math::cos(angle * math::PI / 180.0)
}

fn sin_deg(angle: f64) -> f64 {
    math::sin(angle * math::PI / 180.0)
}

impl Lab {
    pub fn delta_e_2000(self: Lab, other: Lab) -> f64 {
        let c1 = math::sqrt(self.a * self.a + self.b * self.b);
        let c2 = math::sqrt(other.a * other.a + other.b * other.b);
        let cmean7 = math::pow((c1 + c2) / 2.0, 7.0);
        let g = 0.5 * (1.0 - math::sqrt(cmean7 / (cmean7 + 6103515625.0)));
        let a1 = (1.0 + g) * self.a;
        let a2 = (1.0 + g) * other.a;
        let cp1 = math::sqrt(a1 * a1 + self.b * self.b);
        let cp2 = math::sqrt(a2 * a2 + other.b * other.b);
        let h1 = polar_hue(a1, self.b);
        let h2 = polar_hue(a2, other.b);
        let dl = other.l - self.l;
        let dc = cp2 - cp1;
        let raw_dh = h2 - h1;
        let dh = if cp1 * cp2 == 0.0 {
            0.0
        } else if raw_dh > 180.0 {
            raw_dh - 360.0
        } else if raw_dh < -180.0 {
            raw_dh + 360.0
        } else {
            raw_dh
        };
        let dh = 2.0 * math::sqrt(cp1 * cp2) * sin_deg(dh / 2.0);
        let lm = (self.l + other.l) / 2.0;
        let cm = (cp1 + cp2) / 2.0;
        let hm = if cp1 * cp2 == 0.0 {
            h1 + h2
        } else if abs(h1 - h2) <= 180.0 {
            (h1 + h2) / 2.0
        } else if h1 + h2 < 360.0 {
            (h1 + h2 + 360.0) / 2.0
        } else {
            (h1 + h2 - 360.0) / 2.0
        };
        let t = 1.0 - 0.17 * cos_deg(hm - 30.0) + 0.24 * cos_deg(2.0 * hm)
            + 0.32 * cos_deg(3.0 * hm + 6.0)
            - 0.20 * cos_deg(4.0 * hm - 63.0);
        let deviation = (hm - 275.0) / 25.0;
        let theta = 30.0 * math::exp(-deviation * deviation);
        let cm7 = math::pow(cm, 7.0);
        let rc = 2.0 * math::sqrt(cm7 / (cm7 + 6103515625.0));
        let lm50 = lm - 50.0;
        let sl = 1.0 + 0.015 * lm50 * lm50 / math::sqrt(20.0 + lm50 * lm50);
        let sc = 1.0 + 0.045 * cm;
        let sh = 1.0 + 0.015 * cm * t;
        let rt = -sin_deg(2.0 * theta) * rc;
        let l = dl / sl;
        let c = dc / sc;
        let h = dh / sh;
        math::sqrt(max(0.0, l * l + c * c + h * h + rt * c * h))
    }
}
