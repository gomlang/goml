package tests;

use ecosystem::tui;
use ecosystem::ansi;
use ecosystem::terminal;
use std::testing;

#[test]
fn paragraph_block_alignment_clipping_and_scroll_snapshot() -> () {
    let output = buffer(16, 5);
    let inner = testing::expect_ok(
        tui::block(output, output.area(), " Demo ", tui::Theme::defaults()),
        "block",
    );
    testing::expect_ok(
        tui::paragraph(
            output,
            inner,
            ansi::StyledText::plain("first\n中文 hello\nlast"),
            tui::ParagraphOptions {
                wrap: false,
                alignment: tui::Alignment::Right,
                scroll_y: 1,
                ..tui::ParagraphOptions::defaults(),
            },
        ),
        "paragraph",
    );
    testing::assert_eq(
        output.lines().join("\n"),
        "┌ Demo ────────┐\n│    中文 hello│\n│          last│\n│              │\n└──────────────┘",
    );
    testing::expect_ok(output.validate(), "snapshot invariant");
}

#[test]
fn list_and_table_keep_selection_visible_and_respect_focus() -> () {
    let output = buffer(12, 3);
    let items = Vec::from_array(
        [
            ansi::StyledText::plain("zero"),
            ansi::StyledText::plain("one"),
            ansi::StyledText::plain("two"),
            ansi::StyledText::plain("three"),
            ansi::StyledText::plain("four"),
        ],
    );
    let state = tui::SelectionState::new().update(key(terminal::KeyCode::End), items.len(), 3);
    let state = testing::expect_ok(
        tui::list(output, output.area(), items, state, tui::Theme::defaults()),
        "list",
    );
    testing::assert_eq(state.offset, 2);
    testing::assert_eq(output.lines()[2], "four        ");
    testing::assert_eq(cell(output, 0, 2).style, tui::Theme::defaults().selected);
    let unfocused = tui::SelectionState { focused: false, ..state };
    testing::assert_eq(unfocused.update(key(terminal::KeyCode::Up), 5, 3).selected, 4);
    let rows = Vec::from_array(
        [
            Vec::from_array([ansi::StyledText::plain("A"), ansi::StyledText::plain("界")]),
            Vec::from_array([ansi::StyledText::plain("B"), ansi::StyledText::plain("two")]),
            Vec::from_array([ansi::StyledText::plain("C"), ansi::StyledText::plain("three")]),
        ],
    );
    let state = testing::expect_ok(
        tui::table(
            output,
            output.area(),
            Vec::from_array([ansi::StyledText::plain("ID"), ansi::StyledText::plain("Name")]),
            rows,
            Vec::from_array([tui::Constraint::Fixed(3), tui::Constraint::Fill(1)]),
            tui::SelectionState { selected: 2, ..tui::SelectionState::new() },
            tui::Theme::defaults(),
        ),
        "table",
    );
    testing::assert_eq(state.offset, 1);
    testing::assert_eq(output.lines().join("\n"), "ID  Name    \nB   two     \nC   three   ");
}

#[test]
fn tree_expansion_hierarchy_validation_and_focus_navigation() -> () {
    let output = buffer(16, 3);
    let nodes = Vec::from_array(
        [
            tui::TreeNode { id: "root", depth: 0, label: ansi::StyledText::plain("root") },
            tui::TreeNode { id: "child", depth: 1, label: ansi::StyledText::plain("child") },
            tui::TreeNode { id: "leaf", depth: 2, label: ansi::StyledText::plain("leaf") },
            tui::TreeNode { id: "other", depth: 0, label: ansi::StyledText::plain("other") },
        ],
    );
    let state = testing::expect_ok(
        tui::tree(output, output.area(), nodes, tui::TreeState::new(), tui::Theme::defaults()),
        "collapsed",
    );
    testing::assert(output.lines()[1].contains("other"));
    let state = testing::expect_ok(
        state.update(key(terminal::KeyCode::Right), nodes, 3),
        "expand root",
    );
    let state = testing::expect_ok(
        tui::tree(output, output.area(), nodes, state, tui::Theme::defaults()),
        "expanded",
    );
    testing::assert(output.lines()[1].contains("child"));
    testing::assert(!output.lines().join("").contains("leaf"));
    let state = testing::expect_ok(state.toggle("child"), "expand child");
    testing::expect_ok(
        tui::tree(output, output.area(), nodes, state, tui::Theme::defaults()),
        "nested",
    );
    testing::assert(output.lines()[2].contains("leaf"));
    let invalid = Vec::from_array(
        [tui::TreeNode { id: "bad", depth: 1, label: ansi::StyledText::plain("bad") }],
    );
    testing::assert(
        tui::tree(output, output.area(), invalid, tui::TreeState::new(), tui::Theme::defaults()).is_err(),
    );
    let focus = testing::expect_ok(tui::Focus::new(3), "focus");
    testing::assert(focus.update(key(terminal::KeyCode::BackTab)));
    testing::assert_eq(focus.current(), 2);
    testing::assert(focus.update(key(terminal::KeyCode::Tab)));
    testing::assert_eq(focus.current(), 0);
}

#[test]
fn tabs_gauge_scrollbar_sparkline_chart_render_and_validate_ranges() -> () {
    let output = buffer(20, 8);
    let theme = tui::Theme::defaults();
    testing::expect_ok(
        tui::tabs(
            output,
            rect(0, 0, 20, 1),
            Vec::from_array(["One", "Two"]),
            tui::SelectionState { selected: 1, ..tui::SelectionState::new() },
            theme,
        ),
        "tabs",
    );
    testing::assert(output.lines()[0].starts_with(" One │ Two "));
    testing::expect_ok(tui::gauge(output, rect(0, 1, 10, 1), 1, 2, "50%", theme), "gauge");
    testing::assert_eq(output.lines()[1].byte_slice(0, 3), "█");
    testing::expect_ok(
        tui::scrollbar(output, rect(19, 1, 1, 6), 100, 20, 80, tui::Direction::Vertical, theme),
        "scrollbar",
    );
    testing::assert_eq(cell(output, 19, 6).text, "█");
    testing::expect_ok(
        tui::sparkline(
            output,
            rect(0, 2, 8, 1),
            Vec::from_array([0, 1, 2, 3, 4, 5, 6, 7]),
            7,
            theme,
        ),
        "sparkline",
    );
    testing::assert(output.lines()[2].starts_with("▁▂▃▄▅▆▇█"));
    testing::expect_ok(
        tui::chart(
            output,
            rect(0, 3, 10, 5),
            10,
            10,
            Vec::from_array(
                [
                    tui::Series {
                        points: Vec::from_array(
                            [tui::Point { x: 0, y: 0 }, tui::Point { x: 10, y: 10 }],
                        ),
                        style: theme.accent,
                        connect: true,
                    },
                ],
            ),
            theme,
        ),
        "chart",
    );
    testing::assert_eq(cell(output, 9, 3).text, "•");
    testing::assert_eq(cell(output, 0, 7).text, "•");
    testing::assert(tui::gauge(output, output.area(), 2, 1, "", theme).is_err());
    testing::assert(tui::sparkline(output, output.area(), Vec::from_array([-1]), 7, theme).is_err());
    testing::expect_ok(output.validate(), "widgets preserve buffer");
}

#[test]
fn selected_tabs_scroll_into_view() -> () {
    let output = buffer(9, 1);
    let state = testing::expect_ok(
        tui::tabs(
            output,
            output.area(),
            Vec::from_array(["One", "Two", "Three", "Four"]),
            tui::SelectionState { selected: 3, ..tui::SelectionState::new() },
            tui::Theme::defaults(),
        ),
        "scroll tabs",
    );
    testing::assert_eq(state.offset, 3);
    testing::assert(output.lines()[0].contains("Four"));
    testing::assert_eq(cell(output, 1, 0).style, tui::Theme::defaults().selected);
}
