package tests;

use ecosystem::tui;
use std::testing;

#[test]
fn layout_respects_fixed_ratio_weights_caps_and_spacing() -> () {
    let area = rect(1, 2, 20, 8);
    let parts = testing::expect_ok(
        tui::layout(
            area,
            tui::Direction::Horizontal,
            Vec::from_array(
                [
                    tui::Constraint::Fixed(3),
                    tui::Constraint::Max(4),
                    tui::Constraint::Fill(2),
                    tui::Constraint::Fill(1),
                ],
            ),
            1,
        ),
        "constraints",
    );
    testing::assert_eq(parts[0], rect(1, 2, 3, 8));
    testing::assert_eq(parts[1].width, 4);
    testing::assert(parts[2].width >= parts[3].width);
    testing::assert_eq(parts[3].right(), area.right());
    let ratio = testing::expect_ok(
        tui::layout(
            area,
            tui::Direction::Vertical,
            Vec::from_array([tui::Constraint::Ratio(1, 4), tui::Constraint::Min(2)]),
            0,
        ),
        "ratio",
    );
    testing::assert_eq(ratio[0].height, 2);
    testing::assert_eq(ratio[1].height, 6);
    testing::assert(
        tui::layout(
            area,
            tui::Direction::Vertical,
            Vec::from_array([tui::Constraint::Ratio(1, 0)]),
            0,
        ).is_err(),
    );
}

#[test]
fn layout_exhaustive_small_allocations_stay_ordered_and_bounded() -> () {
    for length in 0..33 {
        for spacing in 0..5 {
            for fixed in 0..10 {
                let area = rect(0, 0, length, 1);
                let parts = testing::expect_ok(
                    tui::layout(
                        area,
                        tui::Direction::Horizontal,
                        Vec::from_array(
                            [
                                tui::Constraint::Fixed(fixed),
                                tui::Constraint::Fill(1),
                                tui::Constraint::Max(3),
                            ],
                        ),
                        spacing,
                    ),
                    "layout",
                );
                let mut right = 0;
                for part in parts {
                    testing::assert(part.x >= right);
                    testing::assert(part.right() <= length);
                    right = part.right();
                }
            }
        }
    }
}
