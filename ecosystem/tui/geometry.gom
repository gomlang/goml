package tui;

#[derive(Debug, PartialEq, Eq)]
pub struct Error {
    pub message: string,
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        self.message
    }
}

fn failure(message: string) -> Error {
    Error { message }
}

pub const MAX_DIMENSION: isize = 4096;

pub const MAX_CELLS: isize = 1048576;

pub const MAX_TEXT_BYTES: isize = 1048576;

fn minimum(a: isize, b: isize) -> isize {
    if a < b {
        a
    } else {
        b
    }
}

fn maximum(a: isize, b: isize) -> isize {
    if a > b {
        a
    } else {
        b
    }
}

fn clamp(value: isize, low: isize, high: isize) -> isize {
    maximum(low, minimum(value, high))
}

#[derive(Debug, PartialEq, Eq)]
pub struct Rect {
    pub x: isize,
    pub y: isize,
    pub width: isize,
    pub height: isize,
}

impl Rect {
    pub fn new(x: isize, y: isize, width: isize, height: isize) -> Result[Rect, Error] {
        let value = Rect { x, y, width, height };
        value.validate()?;
        Result::Ok(value)
    }

    pub fn validate(self: Rect) -> Result[(), Error] {
        if self.x < 0 || self.y < 0 || self.width < 0 || self.height < 0 || self.x > MAX_DIMENSION
            || self.y > MAX_DIMENSION
            || self.width > MAX_DIMENSION - self.x
            || self.height > MAX_DIMENSION - self.y {
            Result::Err(failure("rectangle outside coordinate limits"))
        } else {
            Result::Ok(())
        }
    }

    pub fn right(self: Rect) -> isize {
        self.x + self.width
    }

    pub fn bottom(self: Rect) -> isize {
        self.y + self.height
    }

    pub fn contains(self: Rect, x: isize, y: isize) -> bool {
        x >= self.x && y >= self.y && x < self.right() && y < self.bottom()
    }

    pub fn intersection(self: Rect, other: Rect) -> Rect {
        let x = maximum(self.x, other.x);
        let y = maximum(self.y, other.y);
        Rect {
            x,
            y,
            width: maximum(0, minimum(self.right(), other.right()) - x),
            height: maximum(0, minimum(self.bottom(), other.bottom()) - y),
        }
    }

    pub fn inset(self: Rect, horizontal: isize, vertical: isize) -> Rect {
        let dx = clamp(horizontal, 0, self.width / 2);
        let dy = clamp(vertical, 0, self.height / 2);
        Rect {
            x: self.x + dx,
            y: self.y + dy,
            width: self.width - dx * 2,
            height: self.height - dy * 2,
        }
    }
}

#[derive(Debug, PartialEq, Eq)]
pub enum Direction {
    Horizontal,
    Vertical,
}

#[derive(Debug, PartialEq, Eq)]
pub enum Constraint {
    Fixed(isize),
    Min(isize),
    Max(isize),
    Ratio(isize, isize),
    Fill(isize),
}

pub fn layout(area: Rect, direction: Direction, constraints: Vec[Constraint], spacing: isize) -> Result[
    Vec[Rect],
    Error,
] {
    area.validate()?;
    if spacing < 0 || spacing > MAX_DIMENSION || constraints.len() > MAX_DIMENSION {
        return Result::Err(failure("invalid layout limits"))
    }
    let length = match direction {
        Horizontal => area.width,
        Vertical => area.height,
    };
    let gap = if constraints.len() > 1 {
        minimum(length, spacing * (constraints.len() - 1))
    } else {
        0
    };
    let available = length - gap;
    let sizes: Vec[isize] = Vec::new();
    let limits: Vec[isize] = Vec::new();
    let weights: Vec[isize] = Vec::new();
    let mut used = 0;
    for constraint in constraints {
        let (desired, limit, weight) = match constraint {
            Fixed(value) => (value, value, 0),
            Min(value) => (value, available, 1),
            Max(value) => (0, value, 1),
            Ratio(numerator, denominator) => {
                if numerator < 0 || numerator > MAX_DIMENSION || denominator < 1
                    || denominator > MAX_DIMENSION {
                    return Result::Err(failure("invalid layout ratio"))
                }
                let value = minimum(available, available * numerator / denominator);
                (value, value, 0)
            },
            Fill(weight) => {
                if weight < 1 || weight > MAX_DIMENSION {
                    return Result::Err(failure("invalid fill weight"))
                };
                (0, available, weight)
            },
        };
        if desired < 0 || desired > MAX_DIMENSION || limit < 0 || limit > MAX_DIMENSION {
            return Result::Err(failure("invalid layout constraint"))
        }
        let size = minimum(desired, available - used);
        sizes.push(size);
        limits.push(limit);
        weights.push(weight);
        used += size;
    }
    while used < available {
        let mut total = 0;
        for index in 0..sizes.len() {
            if sizes[index] < limits[index] {
                total += weights[index];
            }
        }
        if total == 0 {
            break
        }
        let remaining = available - used;
        let mut progress = false;
        for index in 0..sizes.len() {
            if weights[index] > 0 && sizes[index] < limits[index] && used < available {
                let share = maximum(1, remaining * weights[index] / total);
                let amount = minimum(minimum(share, limits[index] - sizes[index]), available - used);
                sizes[index] = sizes[index] + amount;
                used += amount;
                progress = true;
            }
        }
        if !progress {
            break
        }
    }
    let result = Vec::new();
    let mut offset = 0;
    for size in sizes {
        result.push(
            match direction {
                Horizontal => Rect {
                    x: area.x + offset,
                    y: area.y,
                    width: size,
                    height: area.height,
                },
                Vertical => Rect { x: area.x, y: area.y + offset, width: area.width, height: size },
            },
        );
        offset = minimum(length, offset + size + spacing);
    }
    Result::Ok(result)
}
