package tui;

use ecosystem::ansi;

#[derive(Debug, PartialEq, Eq)]
pub struct Theme {
    pub base: ansi::Style,
    pub border: ansi::Style,
    pub title: ansi::Style,
    pub selected: ansi::Style,
    pub muted: ansi::Style,
    pub accent: ansi::Style,
}

impl Theme {
    pub fn defaults() -> Theme {
        Theme {
            base: ansi::Style::new(),
            border: ansi::Style::new().foreground(ansi::Color::Indexed(8)),
            title: ansi::Style::new().with_attribute(ansi::BOLD, true),
            selected: ansi::Style::new().with_attribute(ansi::REVERSE, true),
            muted: ansi::Style::new().with_attribute(ansi::DIM, true),
            accent: ansi::Style::new().foreground(ansi::Color::Indexed(6)),
        }
    }
}

#[derive(Debug, PartialEq, Eq)]
pub enum Alignment {
    Left,
    Center,
    Right,
}

pub struct ParagraphOptions {
    pub wrap: bool,
    pub alignment: Alignment,
    pub scroll_x: isize,
    pub scroll_y: isize,
}

impl ParagraphOptions {
    pub fn defaults() -> ParagraphOptions {
        ParagraphOptions { wrap: true, alignment: Alignment::Left, scroll_x: 0, scroll_y: 0 }
    }
}

pub fn paragraph(buffer: Buffer, area: Rect, text: ansi::StyledText, options: ParagraphOptions) -> Result[
    (),
    Error,
] {
    area.validate()?;
    if options.scroll_x < 0 || options.scroll_y < 0 || options.scroll_x > MAX_TEXT_BYTES
        || options.scroll_y > MAX_TEXT_BYTES {
        return Result::Err(failure("invalid paragraph scroll"))
    }
    if text.plain_text().byte_len() > MAX_TEXT_BYTES {
        return Result::Err(failure("paragraph text limit exceeded"))
    }
    if area.width == 0 || area.height == 0 {
        return Result::Ok(())
    }
    let lines = if options.wrap {
        text.wrap(area.width).map_err(|error| failure(error.to_string()))?
    } else {
        let result = Vec::new();
        let mut line = ansi::StyledText::new();
        for span in text.spans() {
            let parts = span.text.split("\n");
            for index in 0..parts.len() {
                if index > 0 {
                    result.push(line);
                    line = ansi::StyledText::new();
                }
                line.push(ansi::Span { text: parts[index], ..span });
            }
        }
        result.push(line);
        result
    };
    for row in 0..area.height {
        let index = row + options.scroll_y;
        if index >= lines.len() {
            break
        }
        let line = lines[index].clip(options.scroll_x, area.width).map_err(
            |error| failure(error.to_string()),
        )?;
        let padding = maximum(0, area.width - line.width());
        let offset = match options.alignment {
            Left => 0,
            Center => padding / 2,
            Right => padding,
        };
        buffer.draw_text(
            Rect { x: area.x + offset, y: area.y + row, width: area.width - offset, height: 1 },
            line,
        )?;
    }
    Result::Ok(())
}

pub fn block(buffer: Buffer, area: Rect, title: string, theme: Theme) -> Result[Rect, Error] {
    area.validate()?;
    buffer.fill(area, theme.base)?;
    if area.width < 2 || area.height < 2 {
        return Result::Ok(area)
    }
    for x in area.x + 1..area.right() - 1 {
        buffer.put(x, area.y, "─", theme.border)?;
        buffer.put(x, area.bottom() - 1, "─", theme.border)?;
    }
    for y in area.y + 1..area.bottom() - 1 {
        buffer.put(area.x, y, "│", theme.border)?;
        buffer.put(area.right() - 1, y, "│", theme.border)?;
    }
    buffer.put(area.x, area.y, "┌", theme.border)?;
    buffer.put(area.right() - 1, area.y, "┐", theme.border)?;
    buffer.put(area.x, area.bottom() - 1, "└", theme.border)?;
    buffer.put(area.right() - 1, area.bottom() - 1, "┘", theme.border)?;
    buffer.draw_text(
        Rect { x: area.x + 1, y: area.y, width: area.width - 2, height: 1 },
        ansi::StyledText::from_spans(Vec::from_array([ansi::Span::new(title, theme.title)])),
    )?;
    Result::Ok(area.inset(1, 1))
}

pub fn gauge(
    buffer: Buffer,
    area: Rect,
    numerator: isize,
    denominator: isize,
    label: string,
    theme: Theme,
) -> Result[(), Error] {
    area.validate()?;
    if denominator < 1 || denominator > 1000000000 || numerator < 0 || numerator > denominator {
        return Result::Err(failure("invalid gauge ratio"))
    }
    buffer.fill(area, theme.base)?;
    let filled = area.width * numerator / denominator;
    for y in area.y..area.bottom() {
        for x in area.x..area.x + filled {
            buffer.put(x, y, "█", theme.accent)?;
        }
    }
    paragraph(
        buffer,
        area,
        ansi::StyledText::from_spans(Vec::from_array([ansi::Span::new(label, theme.title)])),
        ParagraphOptions {
            alignment: Alignment::Center,
            wrap: false,
            ..ParagraphOptions::defaults(),
        },
    )
}

pub fn scrollbar(
    buffer: Buffer,
    area: Rect,
    content: isize,
    viewport: isize,
    offset: isize,
    direction: Direction,
    theme: Theme,
) -> Result[(), Error] {
    area.validate()?;
    if content < 0 || content > MAX_TEXT_BYTES || viewport < 0 || viewport > MAX_TEXT_BYTES
        || offset < 0 {
        return Result::Err(failure("invalid scrollbar range"))
    }
    let length = match direction {
        Vertical => area.height,
        Horizontal => area.width,
    };
    if length == 0 || area.width == 0 || area.height == 0 {
        return Result::Ok(())
    }
    let thumb = if content <= viewport || content == 0 {
        length
    } else {
        maximum(1, length * viewport / content)
    };
    let start = if content <= viewport {
        0
    } else {
        minimum(offset, content - viewport) * (length - thumb) / (content - viewport)
    };
    for index in 0..length {
        let active = index >= start && index < start + thumb;
        let symbol = if active {
            "█"
        } else {
            "░"
        };
        let style = if active {
            theme.accent
        } else {
            theme.muted
        };
        match direction {
            Vertical => {
                buffer.put(area.x, area.y + index, symbol, style)?;
            },
            Horizontal => {
                buffer.put(area.x + index, area.y, symbol, style)?;
            },
        }
    }
    Result::Ok(())
}

pub fn sparkline(buffer: Buffer, area: Rect, values: Vec[isize], maximum_value: isize, theme: Theme) -> Result[
    (),
    Error,
] {
    area.validate()?;
    if values.len() > MAX_TEXT_BYTES || maximum_value < 1 || maximum_value > 1000000000 {
        return Result::Err(failure("invalid sparkline range"))
    }
    let glyphs = ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"];
    let count = minimum(area.width, values.len());
    if area.height == 0 {
        return Result::Ok(())
    }
    for index in 0..count {
        let value = values[values.len() - count + index];
        if value < 0 || value > maximum_value {
            return Result::Err(failure("sparkline value outside range"))
        }
        buffer.put(
            area.x + index,
            area.bottom() - 1,
            glyphs[minimum(7, value * 8 / maximum_value)],
            theme.accent,
        )?;
    }
    Result::Ok(())
}

#[derive(Debug, PartialEq, Eq)]
pub struct Point {
    pub x: isize,
    pub y: isize,
}

pub struct Series {
    pub points: Vec[Point],
    pub style: ansi::Style,
    pub connect: bool,
}

pub fn chart(
    buffer: Buffer,
    area: Rect,
    x_max: isize,
    y_max: isize,
    series: Vec[Series],
    theme: Theme,
) -> Result[(), Error] {
    area.validate()?;
    if x_max < 1 || y_max < 1 || x_max > 1000000000 || y_max > 1000000000 || series.len() > 256 {
        return Result::Err(failure("invalid chart bounds"))
    }
    if area.width < 2 || area.height < 2 {
        return Result::Ok(())
    }
    let mut total = 0;
    for item in series {
        total += item.points.len();
        if total > 65536 {
            return Result::Err(failure("chart point limit exceeded"))
        }
    }
    for x in area.x..area.right() {
        buffer.put(x, area.bottom() - 1, "─", theme.border)?;
    }
    for y in area.y..area.bottom() {
        buffer.put(area.x, y, "│", theme.border)?;
    }
    buffer.put(area.x, area.bottom() - 1, "└", theme.border)?;
    let mut work = 0;
    for item in series {
        let mut previous: Option[Point] = Option::None;
        for point in item.points {
            if point.x < 0 || point.x > x_max || point.y < 0 || point.y > y_max {
                previous = Option::None;
                continue
            }
            let pixel = Point {
                x: area.x + point.x * (area.width - 1) / x_max,
                y: area.bottom() - 1 - point.y * (area.height - 1) / y_max,
            };
            if item.connect {
                if let Some(old) = previous {
                    work += maximum(
                        if old.x > pixel.x {
                            old.x - pixel.x
                        } else {
                            pixel.x - old.x
                        },
                        if old.y > pixel.y {
                            old.y - pixel.y
                        } else {
                            pixel.y - old.y
                        },
                    );
                    if work > MAX_CELLS {
                        return Result::Err(failure("chart raster work budget exceeded"))
                    }
                    draw_segment(buffer, old, pixel, item.style)?;
                }
            }
            buffer.put(pixel.x, pixel.y, "•", item.style)?;
            previous = Option::Some(pixel);
        }
    }
    Result::Ok(())
}

fn draw_segment(buffer: Buffer, from: Point, to: Point, style: ansi::Style) -> Result[(), Error] {
    let dx = to.x - from.x;
    let dy = to.y - from.y;
    let steps = maximum(
        if dx < 0 {
            -dx
        } else {
            dx
        },
        if dy < 0 {
            -dy
        } else {
            dy
        },
    );
    if steps > 0 {
        for index in 1..steps {
            buffer.put(from.x + dx * index / steps, from.y + dy * index / steps, "·", style)?;
        }
    }
    Result::Ok(())
}
