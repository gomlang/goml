package tui;

use ecosystem::ansi;
use ecosystem::terminal;
use ecosystem::unicode_text;

struct EditSnapshot {
    text: string,
    cursor: isize,
    anchor: isize,
}

pub struct Editor {
    value: Ref[EditSnapshot],
    history: Ref[Vec[EditSnapshot]],
    future: Vec[EditSnapshot],
    max_bytes: isize,
    scroll_x: Ref[isize],
    scroll_y: Ref[isize],
}

pub struct EditorOptions {
    pub multiline: bool,
    pub password: bool,
    pub focused: bool,
    pub style: ansi::Style,
    pub selection_style: ansi::Style,
    pub cursor_style: ansi::Style,
}

impl EditorOptions {
    pub fn defaults() -> EditorOptions {
        EditorOptions {
            multiline: true,
            password: false,
            focused: true,
            style: ansi::Style::new(),
            selection_style: ansi::Style::new().with_attribute(ansi::REVERSE, true),
            cursor_style: ansi::Style::new().with_attribute(ansi::UNDERLINE, true),
        }
    }
}

impl Editor {
    pub fn new(text: string, max_bytes: isize) -> Result[Editor, Error] {
        if max_bytes < 1 || max_bytes > MAX_TEXT_BYTES || text.byte_len() > max_bytes {
            return Result::Err(failure("editor byte limit exceeded"))
        }
        let text = ansi::safe_text(text.replace("\r\n", "\n"));
        if text.byte_len() > max_bytes {
            return Result::Err(failure("editor byte limit exceeded"))
        }
        Result::Ok(
            Editor {
                value: Ref::new(
                    EditSnapshot { cursor: text.byte_len(), anchor: text.byte_len(), text },
                ),
                history: Ref::new(Vec::new()),
                future: Vec::new(),
                max_bytes,
                scroll_x: Ref::new(0),
                scroll_y: Ref::new(0),
            },
        )
    }

    pub fn text(self: Editor) -> string {
        self.value.get().text
    }

    pub fn cursor(self: Editor) -> isize {
        self.value.get().cursor
    }

    pub fn selection(self: Editor) -> Option[(isize, isize)] {
        let value = self.value.get();
        if value.cursor == value.anchor {
            Option::None
        } else {
            Option::Some((minimum(value.cursor, value.anchor), maximum(value.cursor, value.anchor)))
        }
    }

    pub fn clear_history(self: Editor) -> () {
        self.history.set(Vec::new());
        self.future.clear();
    }

    fn remember(self: Editor) -> () {
        let old = self.history.get();
        let next = Vec::new();
        let mut bytes = self.text().byte_len();
        let mut start = old.len();
        while start > 0 && old.len() - start < 63
            && bytes + old[start - 1].text.byte_len() <= 4194304 {
            start -= 1;
            bytes += old[start].text.byte_len();
        }
        for index in start..old.len() {
            next.push(old[index]);
        }
        next.push(self.value.get());
        self.history.set(next);
        self.future.clear();
    }

    pub fn set_text(self: Editor, text: string) -> Result[(), Error] {
        if text.byte_len() > self.max_bytes {
            return Result::Err(failure("editor byte limit exceeded"))
        }
        let text = ansi::safe_text(text.replace("\r\n", "\n"));
        if text.byte_len() > self.max_bytes {
            return Result::Err(failure("editor byte limit exceeded"))
        }
        if text != self.text() {
            self.remember();
            self.value.set(EditSnapshot { cursor: text.byte_len(), anchor: text.byte_len(), text });
        }
        Result::Ok(())
    }

    pub fn set_cursor(self: Editor, byte_offset: isize, extend_selection: bool) -> Result[(), Error] {
        let value = self.value.get();
        if byte_offset < 0 || byte_offset > value.text.byte_len()
            || !unicode_text::is_grapheme_boundary(value.text, byte_offset) {
            return Result::Err(failure("editor cursor splits a grapheme"))
        }
        self.value.set(
            EditSnapshot {
                cursor: byte_offset,
                anchor: if extend_selection {
                    value.anchor
                } else {
                    byte_offset
                },
                ..value,
            },
        );
        Result::Ok(())
    }

    pub fn insert(self: Editor, text: string) -> Result[(), Error] {
        if text.byte_len() > self.max_bytes {
            return Result::Err(failure("editor insertion too large"))
        }
        let text = ansi::safe_text(text.replace("\r\n", "\n"));
        let old = self.value.get();
        let start = minimum(old.anchor, old.cursor);
        let end = maximum(old.anchor, old.cursor);
        if old.text.byte_len() - (end - start) + text.byte_len() > self.max_bytes {
            return Result::Err(failure("editor byte limit exceeded"))
        }
        let value = old.text.byte_slice(0, start) + text
            + old.text.byte_slice(end, old.text.byte_len());
        let cursor = next_boundary_at(value, start + text.byte_len());
        if value != old.text {
            self.remember();
        }
        self.value.set(EditSnapshot { text: value, cursor, anchor: cursor });
        Result::Ok(())
    }

    fn trim_history(self: Editor) -> () {
        let past = self.history.get();
        let future = self.future.copy();
        let mut bytes = 0;
        for value in past {
            bytes += value.text.byte_len();
        }
        for value in future {
            bytes += value.text.byte_len();
        }
        let mut past_start = 0;
        let mut future_start = 0;
        while bytes > 4194304 || past.len() - past_start + future.len() - future_start > 64 {
            if past_start < past.len() {
                bytes -= past[past_start].text.byte_len();
                past_start += 1;
            } else if future_start < future.len() {
                bytes -= future[future_start].text.byte_len();
                future_start += 1;
            } else {
                break
            }
        }
        let kept = Vec::new();
        for index in past_start..past.len() {
            kept.push(past[index]);
        }
        self.history.set(kept);
        self.future.clear();
        for index in future_start..future.len() {
            self.future.push(future[index]);
        }
    }

    pub fn undo(self: Editor) -> bool {
        let history = self.history.get();
        if let Some(value) = history.pop() {
            self.future.push(self.value.get());
            self.value.set(value);
            self.trim_history();
            true
        } else {
            false
        }
    }

    pub fn redo(self: Editor) -> bool {
        if let Some(value) = self.future.pop() {
            self.history.get().push(self.value.get());
            self.value.set(value);
            self.trim_history();
            true
        } else {
            false
        }
    }

    pub fn update(self: Editor, event: terminal::Event) -> Result[bool, Error] {
        match event {
            Paste(text) => {
                self.insert(text)?;
                Result::Ok(true)
            },
            Key(key) => {
                let value = self.value.get();
                if key.modifiers.control {
                    match key.code {
                        Char('a') => {
                            self.value.set(
                                EditSnapshot { cursor: value.text.byte_len(), anchor: 0, ..value },
                            );
                            return Result::Ok(true)
                        },
                        Char('z') => {
                            return Result::Ok(
                                if key.modifiers.shift {
                                    self.redo()
                                } else {
                                    self.undo()
                                },
                            )
                        },
                        Char('y') => {
                            return Result::Ok(self.redo())
                        },
                        _ => (),
                    }
                }
                match key.code {
                    Char(character) if !key.modifiers.control && !key.modifiers.alt => {
                        self.insert(character.to_string())?;
                    },
                    Enter => {
                        self.insert("\n")?;
                    },
                    Tab => {
                        self.insert("\t")?;
                    },
                    Backspace | Delete => {
                        if self.selection().is_none() {
                            let next = if key.code == terminal::KeyCode::Backspace {
                                previous_boundary(value.text, value.cursor)
                            } else {
                                next_boundary(value.text, value.cursor)
                            };
                            self.set_cursor(next, true)?;
                        }
                        self.insert("")?;
                    },
                    Left | Right => {
                        let next = if key.modifiers.control {
                            word_cursor(
                                value.text,
                                value.cursor,
                                key.code == terminal::KeyCode::Right,
                            )
                        } else if !key.modifiers.shift && self.selection().is_some() {
                            if key.code == terminal::KeyCode::Left {
                                minimum(value.cursor, value.anchor)
                            } else {
                                maximum(value.cursor, value.anchor)
                            }
                        } else if key.code == terminal::KeyCode::Left {
                            previous_boundary(value.text, value.cursor)
                        } else {
                            next_boundary(value.text, value.cursor)
                        };
                        self.set_cursor(next, key.modifiers.shift)?;
                    },
                    Home | End => {
                        let (start, end) = line_bounds(value.text, value.cursor);
                        let next = if key.code == terminal::KeyCode::Home {
                            if key.modifiers.control {
                                0
                            } else {
                                start
                            }
                        } else {
                            if key.modifiers.control {
                                value.text.byte_len()
                            } else {
                                end
                            }
                        };
                        self.set_cursor(next, key.modifiers.shift)?;
                    },
                    Up | Down => {
                        let (start, end) = line_bounds(value.text, value.cursor);
                        let mut column = 0;
                        for part in unicode_text::graphemes(
                            value.text.byte_slice(start, value.cursor),
                        ) {
                            column += editor_width(part.text, column, false);
                        }
                        let next = if key.code == terminal::KeyCode::Up {
                            if start == 0 {
                                0
                            } else {
                                let (above, _) = line_bounds(value.text, start - 1);
                                byte_at_column(value.text, above, start - 1, column)
                            }
                        } else {
                            if end == value.text.byte_len() {
                                end
                            } else {
                                let (_, below) = line_bounds(value.text, end + 1);
                                byte_at_column(value.text, end + 1, below, column)
                            }
                        };
                        self.set_cursor(next, key.modifiers.shift)?;
                    },
                    _ => return Result::Ok(false),
                }
                Result::Ok(true)
            },
            _ => Result::Ok(false),
        }
    }

    pub fn render(self: Editor, buffer: Buffer, area: Rect, options: EditorOptions) -> Result[
        (),
        Error,
    ] {
        area.validate()?;
        if area.width == 0 || area.height == 0 {
            return Result::Ok(())
        }
        buffer.fill(area, options.style)?;
        let value = self.value.get();
        let parts = unicode_text::graphemes(value.text);
        let mut cursor_x = 0;
        let mut cursor_y = 0;
        for part in parts {
            if part.start >= value.cursor {
                break
            }
            if part.text == "\n" && options.multiline {
                cursor_y += 1;
                cursor_x = 0;
            } else {
                cursor_x += editor_width(part.text, cursor_x, options.password);
            }
        }
        let mut scroll_x = self.scroll_x.get();
        let mut scroll_y = self.scroll_y.get();
        if cursor_x < scroll_x {
            scroll_x = cursor_x;
        }
        if cursor_x >= scroll_x + area.width {
            scroll_x = cursor_x - area.width + 1;
        }
        if cursor_y < scroll_y {
            scroll_y = cursor_y;
        }
        if cursor_y >= scroll_y + area.height {
            scroll_y = cursor_y - area.height + 1;
        }
        self.scroll_x.set(scroll_x);
        self.scroll_y.set(scroll_y);
        let mut x = 0;
        let mut y = 0;
        for part in parts {
            if part.text == "\n" && options.multiline {
                if options.focused && part.start == value.cursor && y >= scroll_y
                    && y < scroll_y + area.height
                    && x >= scroll_x
                    && x < scroll_x + area.width {
                    buffer.put(
                        area.x + x - scroll_x,
                        area.y + y - scroll_y,
                        " ",
                        options.cursor_style,
                    )?;
                }
                y += 1;
                x = 0;
                continue
            }
            let width = editor_width(part.text, x, options.password);
            let selected = part.start >= minimum(value.cursor, value.anchor)
                && part.end <= maximum(value.cursor, value.anchor);
            let at_cursor = options.focused && part.start == value.cursor;
            let style = if at_cursor {
                options.cursor_style
            } else if selected {
                options.selection_style
            } else {
                options.style
            };
            if y >= scroll_y && y < scroll_y + area.height && x >= scroll_x
                && x + width <= scroll_x + area.width {
                let text = if options.password {
                    "•"
                } else if part.text == "\t" {
                    " ".repeat(width)
                } else if part.text == "\n" {
                    " "
                } else {
                    part.text
                };
                buffer.draw_text(
                    Rect { x: area.x + x - scroll_x, y: area.y + y - scroll_y, width, height: 1 },
                    ansi::StyledText::from_spans(Vec::from_array([ansi::Span::new(text, style)])),
                )?;
            }
            x += width;
        }
        if options.focused && value.cursor == value.text.byte_len() && cursor_y >= scroll_y
            && cursor_y < scroll_y + area.height {
            buffer.put(
                area.x + cursor_x - scroll_x,
                area.y + cursor_y - scroll_y,
                " ",
                options.cursor_style,
            )?;
        }
        Result::Ok(())
    }
}

fn editor_width(text: string, column: isize, password: bool) -> isize {
    if password || text == "\n" {
        1
    } else if text == "\t" {
        8 - column % 8
    } else {
        maximum(1, unicode_text::width(text))
    }
}

fn previous_boundary(text: string, offset: isize) -> isize {
    let mut previous = 0;
    for boundary in unicode_text::grapheme_boundaries(text) {
        if boundary >= offset {
            break
        }
        previous = boundary;
    }
    previous
}

fn next_boundary(text: string, offset: isize) -> isize {
    for boundary in unicode_text::grapheme_boundaries(text) {
        if boundary > offset {
            return boundary
        }
    }
    text.byte_len()
}

fn next_boundary_at(text: string, offset: isize) -> isize {
    for boundary in unicode_text::grapheme_boundaries(text) {
        if boundary >= offset {
            return boundary
        }
    }
    text.byte_len()
}

fn line_bounds(text: string, offset: isize) -> (isize, isize) {
    let mut start = 0;
    let mut end = text.byte_len();
    for part in unicode_text::graphemes(text) {
        if part.text == "\n" {
            if part.start < offset {
                start = part.end;
            } else {
                end = part.start;
                break
            }
        }
    };
    (start, end)
}

fn byte_at_column(text: string, start: isize, end: isize, column: isize) -> isize {
    let mut used = 0;
    for part in unicode_text::graphemes(text.byte_slice(start, end)) {
        let width = editor_width(part.text, used, false);
        if used + width > column {
            return start + part.start
        }
        used += width;
    }
    end
}

fn word_cursor(text: string, offset: isize, forward: bool) -> isize {
    if forward {
        for word in unicode_text::word_segments(text) {
            if word.end > offset {
                return word.end
            }
        }
        text.byte_len()
    } else {
        let mut last = 0;
        for word in unicode_text::word_segments(text) {
            if word.start >= offset {
                break
            }
            last = word.start;
        }
        last
    }
}
