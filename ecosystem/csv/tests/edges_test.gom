package tests;

use ecosystem::csv;
use std::io;
use io::{Read, Write};
use std::serde::{Deserialize, Serialize};
use std::testing;

#[derive(Serialize, Deserialize)]
struct Letter {
    value: Option[char],
}

#[derive(Serialize)]
struct NestedOptional {
    value: Option[Option[string]],
}

#[test]
fn unicode_optional_char_and_bom_content_roundtrip_without_loss() -> () {
    let schema = ok(
        csv::Schema::new(
            Vec::from_array([csv::Column::new("value", csv::ScalarType::Char).optional()]),
        ),
    );
    for value in Vec::from_array([Option::Some('é'), Option::Some('🌈'), Option::None]) {
        let encoded = ok(schema.encode(Letter { value }));
        let decoded: Letter = ok(schema.decode(encoded, Option::None, csv::HeaderPolicy::Reject));
        testing::assert(decoded.value == value);
    }
    let output = sink(1);
    let writer = ok(csv::Writer::new(output, csv::WriteOptions::new()));
    let expected = Vec::from_array(["\uFEFFinside", "2"]);
    testing::assert_ok(writer.write(csv::StringRecord::new(expected)));
    let reader = ok(
        csv::Reader::new(Chunks { data: output.data, ..chunks("", 1) }, csv::ReadOptions::new()),
    );
    testing::assert(one(reader).values() == expected);
    let schema = ok(
        csv::Schema::new(
            Vec::from_array([csv::Column::new("value", csv::ScalarType::Text).optional()]),
        ),
    );
    for value in Vec::from_array([Option::Some(Option::None), Option::Some(Option::Some("x"))]) {
        kind(schema.encode(NestedOptional { value }), csv::ErrorKind::Type);
    }
}

struct InvalidRead {
    negative: bool,
}

impl Read for InvalidRead {
    fn read(self: InvalidRead, output: MutSlice[byte]) -> Result[isize, io::Error] {
        Result::Ok(
            if self.negative {
                -1
            } else {
                output.len() + 1
            },
        )
    }
}

struct InvalidWrite {}

impl Write for InvalidWrite {
    fn write(self: InvalidWrite, input: Slice[byte]) -> Result[isize, io::Error] {
        Result::Ok(input.len() + 1)
    }
}

#[test]
fn invalid_transfer_counts_and_eof_truncation_are_recoverable_errors() -> () {
    for negative in Vec::from_array([true, false]) {
        let reader = ok(csv::Reader::new(InvalidRead { negative }, csv::ReadOptions::new()));
        kind(reader.next(), csv::ErrorKind::Io);
        kind(reader.next(), csv::ErrorKind::Io);
    }
    let writer = ok(csv::Writer::new(InvalidWrite {}, csv::WriteOptions::new()));
    kind(writer.write(csv::StringRecord::new(Vec::from_array(["value"]))), csv::ErrorKind::Io);
    for input in Vec::from_array(["\"", "\"a", "\"a\"\""]) {
        kind(
            ok(csv::Reader::new(chunks(input, 1), csv::ReadOptions::new())).next(),
            csv::ErrorKind::Syntax,
        );
    }
}
