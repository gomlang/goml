package highlight;

use ecosystem::logos;

impl Language {
    pub fn compile(name: string, extensions: Vec[string], rules: Vec[Rule], regions: Vec[Region]) -> Result[
        Language,
        Error,
    ] {
        compile_language(name, extensions, rules, regions, false, false)
    }

    pub fn name(self: Language) -> string {
        self.name
    }

    pub fn extensions(self: Language) -> Vec[string] {
        self.extensions.copy()
    }
}

fn compile_language(
    name: string,
    extensions: Vec[string],
    rules: Vec[Rule],
    regions: Vec[Region],
    raw: bool,
    markdown: bool,
) -> Result[Language, Error] {
    if name == "" || name.byte_len() > 128 || rules.len() > 4096 || regions.len() > 256 {
        return Result::Err(failure("invalid language definition"));
    }
    let compiled: Vec[logos::Rule[Token, (), string]] = Vec::new();
    for rule in rules {
        let value = Token::Plain(rule.scope);
        compiled.push(
            match rule.pattern {
                Pattern::Literal(text) => logos::Rule::token(text, value).with_priority(
                    rule.priority,
                ),
                Pattern::Regex(text) => logos::Rule::regex(text, |_| logos::Action::Emit(value)).with_priority(
                    rule.priority,
                ),
            },
        );
    }
    for region in regions {
        if region.begin == "" || region.end == "" || region.begin.contains("\n")
            || region.end.contains("\n")
            || region.begin.byte_len() > 1024
            || region.end.byte_len() > 1024
            || (region.nested && region.begin == region.end) {
            return Result::Err(failure("invalid region delimiters"));
        }
        compiled.push(logos::Rule::token(region.begin, Token::Enter(region)).with_priority(200));
    }
    if raw {
        compiled.push(
            logos::Rule::regex("b?r#*\"", |_| logos::Action::Emit(Token::Raw)).with_priority(200),
        );
    }
    compiled.push(
        logos::Rule::regex(".", |_| logos::Action::Emit(Token::Plain(Scope::Text))).with_dot_all().with_priority(
            0,
        ),
    );
    let grammar = logos::Grammar::compile(compiled).map_err(|error| failure(error.to_string()))?;
    Result::Ok(Language { name, extensions: extensions.copy(), grammar, markdown })
}

fn words(values: string, scope: Scope, output: Vec[Rule]) -> () {
    for value in values.split(" ") {
        output.push(Rule::literal(value, scope));
    }
}

fn quoted(begin: string, end: string, escaped: bool, multiline: bool) -> Region {
    Region {
        begin,
        end,
        scope: Scope::String,
        nested: false,
        escape: if escaped {
            Option::Some('\\')
        } else {
            Option::None
        },
        multiline,
    }
}

fn goml_language() -> Result[Language, Error] {
    let rules = Vec::from_array(
        [
            Rule::regex("[\\p{L}_][\\p{L}\\p{N}_]*", Scope::Identifier),
            Rule::regex("'[\\p{L}_][\\p{L}\\p{N}_]*", Scope::Identifier),
            Rule::regex(
                "b?'([^'\\\\\\r\\n]|\\\\(u[0-9A-Fa-f]{4}|x[0-9A-Fa-f]{2}|[^\\r\\n]))'",
                Scope::String,
            ),
            Rule::regex(
                "[0-9][0-9A-Za-z_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9][0-9_]*)?",
                Scope::Number,
            ),
            Rule { priority: 150, ..Rule::regex("//[^\\n\\r]*", Scope::Comment) },
            Rule::regex("[+*/%=!&|^~<>?:-]", Scope::Operator),
            Rule::regex("[(){}\\[\\],.;]", Scope::Punctuation),
            Rule::regex("[ \\t\\r\\n]+", Scope::Text),
        ],
    );
    words(
        "fn let mut const static if else match for while loop in return break continue pub use as package struct enum trait impl type where dyn true false defer select recv send scope spawn go comptime",
        Scope::Keyword,
        rules,
    );
    words(
        "bool string char byte isize usize i8 i16 i32 i64 u8 u16 u32 u64 f32 f64 Vec Slice MutSlice FrozenVec Option Result Ref Channel",
        Scope::Type,
        rules,
    );
    let regions = Vec::from_array(
        [
            Region { nested: true, ..Region::new("/*", "*/", Scope::Comment) },
            quoted("\"", "\"", true, false),
            quoted("b\"", "\"", true, false),
            quoted("f\"", "\"", true, false),
        ],
    );
    compile_language("goml", Vec::from_array(["gom", "goml"]), rules, regions, true, false)
}

fn json_language() -> Result[Language, Error] {
    let rules = Vec::from_array(
        [
            Rule::regex("-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?", Scope::Number),
            Rule::regex("[{}\\[\\],:]", Scope::Punctuation),
            Rule::regex("[ \\t\\r\\n]+", Scope::Text),
            Rule::regex("[A-Za-z_][A-Za-z_0-9]*", Scope::Invalid),
        ],
    );
    words("true false null", Scope::Keyword, rules);
    compile_language(
        "json",
        Vec::from_array(["json", "jsonl"]),
        rules,
        Vec::from_array([quoted("\"", "\"", true, false)]),
        false,
        false,
    )
}

fn toml_language() -> Result[Language, Error] {
    let rules = Vec::from_array(
        [
            Rule::regex("[A-Za-z_][A-Za-z0-9_-]*", Scope::Identifier),
            Rule { priority: 20, ..Rule::regex("[+-]?[0-9][0-9A-Za-z_:.+-]*", Scope::Number) },
            Rule::regex("#[^\\r\\n]*", Scope::Comment),
            Rule::regex("[{}\\[\\],.]", Scope::Punctuation),
            Rule::literal("=", Scope::Operator),
            Rule::regex("[ \\t\\r\\n]+", Scope::Text),
        ],
    );
    words("true false inf nan", Scope::Keyword, rules);
    compile_language(
        "toml",
        Vec::from_array(["toml"]),
        rules,
        Vec::from_array(
            [
                quoted("\"\"\"", "\"\"\"", true, true),
                quoted("'''", "'''", false, true),
                quoted("\"", "\"", true, false),
                quoted("'", "'", false, false),
            ],
        ),
        false,
        false,
    )
}

fn markdown_language() -> Result[Language, Error] {
    let rules = Vec::from_array(
        [
            Rule::regex("`[^`\\r\\n]+`", Scope::Code),
            Rule::regex("!?(\\[[^\\]\\r\\n]*\\])\\([^()\\r\\n]*\\)", Scope::Link),
            Rule::regex(
                "\\*\\*[^*\\r\\n]+\\*\\*|__[^_\\r\\n]+__|\\*[^*\\r\\n]+\\*|_[^_\\r\\n]+_",
                Scope::Emphasis,
            ),
            Rule::regex("[ \\t\\r\\n]+", Scope::Text),
        ],
    );
    compile_language(
        "markdown",
        Vec::from_array(["md", "markdown"]),
        rules,
        Vec::from_array([Region::new("<!--", "-->", Scope::Comment)]),
        false,
        true,
    )
}

impl Highlighter {
    pub fn new(options: Options) -> Result[Highlighter, Error] {
        if options.max_bytes < 1 || options.max_bytes > 67108864 || options.max_line_bytes < 1
            || options.max_line_bytes > options.max_bytes
            || options.max_lines < 1
            || options.max_lines > 1000000
            || options.max_spans < 1
            || options.max_spans > 4000000
            || options.max_depth < 1
            || options.max_depth > 1024 {
            return Result::Err(failure("invalid highlighting limits"));
        }
        let plain = Language::compile("text", Vec::from_array(["txt"]), Vec::new(), Vec::new())?;
        Result::Ok(
            Highlighter {
                languages: Vec::from_array(
                    [
                        plain,
                        goml_language()?,
                        json_language()?,
                        toml_language()?,
                        markdown_language()?,
                    ],
                ),
                options,
            },
        )
    }

    pub fn with_language(self: Highlighter, language: Language) -> Highlighter {
        let languages = self.languages.copy();
        for index in 0..languages.len() {
            if languages[index].name == language.name {
                languages[index] = language;
                return Highlighter { languages, ..self };
            }
        }
        languages.push(language);
        Highlighter { languages, ..self }
    }

    pub fn language_names(self: Highlighter) -> Vec[string] {
        let names = Vec::new();
        for language in self.languages {
            names.push(language.name);
        }
        names
    }

    pub fn detect(self: Highlighter, filename: string) -> string {
        let parts = filename.split(".");
        let extension = parts[parts.len() - 1];
        for language in self.languages {
            if language.extensions.contains(extension) {
                return language.name;
            }
        }
        "text"
    }

    fn language(self: Highlighter, name: string) -> Result[Language, Error] {
        for language in self.languages {
            if language.name == name || language.extensions.contains(name) {
                return Result::Ok(language);
            }
        }
        Result::Err(failure("unknown language: " + name))
    }
}
