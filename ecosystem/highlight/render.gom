package highlight;

use ecosystem::ansi;
use std::text;

pub struct Theme {
    base: ansi::Style,
    entries: Vec[(Scope, ansi::Style)],
}

impl Theme {
    pub fn new(base: ansi::Style) -> Theme {
        Theme { base, entries: Vec::new() }
    }

    pub fn with_style(self: Theme, kind: Scope, style: ansi::Style) -> Theme {
        let entries = self.entries.copy();
        for index in 0..entries.len() {
            let (current, _) = entries[index];
            if current == kind {
                entries[index] = (kind, style);
                return Theme { entries, ..self };
            }
        }
        entries.push((kind, style));
        Theme { entries, ..self }
    }

    pub fn style(self: Theme, kind: Scope) -> ansi::Style {
        for (key, value) in self.entries {
            if key == kind {
                return value;
            }
        }
        self.base
    }

    pub fn dark() -> Theme {
        let base = ansi::Style::new().foreground(ansi::Color::Rgb(220, 223, 228));
        Theme::new(base).with_style(
            Scope::Keyword,
            base.foreground(ansi::Color::Rgb(198, 120, 221)),
        ).with_style(Scope::Type, base.foreground(ansi::Color::Rgb(229, 192, 123))).with_style(
            Scope::Number,
            base.foreground(ansi::Color::Rgb(209, 154, 102)),
        ).with_style(Scope::String, base.foreground(ansi::Color::Rgb(152, 195, 121))).with_style(
            Scope::Comment,
            base.foreground(ansi::Color::Rgb(127, 132, 142)).with_attribute(ansi::ITALIC, true),
        ).with_style(Scope::Operator, base.foreground(ansi::Color::Rgb(86, 182, 194))).with_style(
            Scope::Heading,
            base.foreground(ansi::Color::Rgb(97, 175, 239)).with_attribute(ansi::BOLD, true),
        ).with_style(
            Scope::Link,
            base.foreground(ansi::Color::Rgb(97, 175, 239)).with_attribute(ansi::UNDERLINE, true),
        ).with_style(Scope::Emphasis, base.with_attribute(ansi::ITALIC, true)).with_style(
            Scope::Code,
            base.foreground(ansi::Color::Rgb(152, 195, 121)),
        ).with_style(
            Scope::Invalid,
            base.foreground(ansi::Color::Rgb(224, 108, 117)).with_attribute(ansi::UNDERLINE, true),
        )
    }

    pub fn light() -> Theme {
        let base = ansi::Style::new().foreground(ansi::Color::Rgb(40, 44, 52));
        Theme::new(base).with_style(Scope::Keyword, base.foreground(ansi::Color::Rgb(128, 32, 144))).with_style(
            Scope::Type,
            base.foreground(ansi::Color::Rgb(130, 80, 0)),
        ).with_style(Scope::Number, base.foreground(ansi::Color::Rgb(150, 65, 20))).with_style(
            Scope::String,
            base.foreground(ansi::Color::Rgb(40, 110, 35)),
        ).with_style(
            Scope::Comment,
            base.foreground(ansi::Color::Rgb(95, 100, 110)).with_attribute(ansi::ITALIC, true),
        ).with_style(Scope::Heading, base.with_attribute(ansi::BOLD, true)).with_style(
            Scope::Link,
            base.foreground(ansi::Color::Rgb(0, 80, 160)).with_attribute(ansi::UNDERLINE, true),
        ).with_style(Scope::Invalid, base.foreground(ansi::Color::Rgb(180, 0, 0)))
    }
}

fn write_bounded(output: text::StringBuilder, value: string, limit: isize) -> Result[(), Error] {
    if limit < 0 || value.byte_len() > limit - output.len() {
        return Result::Err(failure("render output limit exceeded"));
    }
    output.write_string(value);
    Result::Ok(())
}

fn escape_html(value: string) -> string {
    let output = text::StringBuilder::new();
    for ch in value.chars() {
        output.write_string(
            match ch {
                '&' => "&amp;",
                '<' => "&lt;",
                '>' => "&gt;",
                '"' => "&quot;",
                '\'' => "&#39;",
                _ => ch.to_string(),
            },
        );
    }
    output.finish()
}

impl Document {
    pub fn to_ansi(self: Document, theme: Theme, profile: ansi::Profile, max_bytes: isize) -> Result[
        string,
        Error,
    ] {
        let output = text::StringBuilder::new();
        let mut previous = ansi::Style::new();
        for span in self.spans() {
            let style = theme.style(span.scope);
            write_bounded(output, style.transition(previous, profile), max_bytes)?;
            write_bounded(
                output,
                ansi::safe_text(self.source.byte_slice(span.start, span.end)),
                max_bytes,
            )?;
            previous = style;
        }
        write_bounded(output, ansi::Style::new().transition(previous, profile), max_bytes)?;
        Result::Ok(output.finish())
    }

    pub fn to_html(self: Document, max_bytes: isize) -> Result[string, Error] {
        let output = text::StringBuilder::new();
        write_bounded(output, "<pre class=\"highlight\"><code>", max_bytes)?;
        for span in self.spans() {
            write_bounded(output, "<span class=\"hl-" + span.scope.name() + "\">", max_bytes)?;
            write_bounded(
                output,
                escape_html(self.source.byte_slice(span.start, span.end)),
                max_bytes,
            )?;
            write_bounded(output, "</span>", max_bytes)?;
        }
        write_bounded(output, "</code></pre>", max_bytes)?;
        Result::Ok(output.finish())
    }
}
