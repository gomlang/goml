package highlight;

use ecosystem::logos;
use std::context;

#[derive(Debug, PartialEq, Eq)]
pub struct Error {
    pub message: string,
    pub line: isize,
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        "highlight line " + self.line.to_string() + ": " + self.message
    }
}

fn failure(message: string) -> Error {
    Error { message, line: 0 }
}

fn checked_context(ctx: context::Context) -> Result[(), Error] {
    ctx.check().map_err(|error| failure(error.to_string()))
}

#[derive(Debug, PartialEq, Eq)]
pub enum Scope {
    Text,
    Keyword,
    Type,
    Identifier,
    Number,
    String,
    Comment,
    Operator,
    Punctuation,
    Heading,
    Link,
    Emphasis,
    Code,
    Invalid,
}

impl Scope {
    pub fn name(self: Scope) -> string {
        match self {
            Text => "text",
            Keyword => "keyword",
            Type => "type",
            Identifier => "identifier",
            Number => "number",
            String => "string",
            Comment => "comment",
            Operator => "operator",
            Punctuation => "punctuation",
            Heading => "heading",
            Link => "link",
            Emphasis => "emphasis",
            Code => "code",
            Invalid => "invalid",
        }
    }
}

#[derive(Debug, PartialEq, Eq)]
pub struct Span {
    pub start: isize,
    pub end: isize,
    pub scope: Scope,
}

pub enum Pattern {
    Literal(string),
    Regex(string),
}

pub struct Rule {
    pub pattern: Pattern,
    pub scope: Scope,
    pub priority: isize,
}

impl Rule {
    pub fn regex(pattern: string, scope: Scope) -> Rule {
        Rule { pattern: Pattern::Regex(pattern), scope, priority: 10 }
    }

    pub fn literal(pattern: string, scope: Scope) -> Rule {
        Rule { pattern: Pattern::Literal(pattern), scope, priority: 100 }
    }
}

#[derive(PartialEq, Eq)]
pub struct Region {
    pub begin: string,
    pub end: string,
    pub scope: Scope,
    pub nested: bool,
    pub escape: Option[char],
    pub multiline: bool,
}

impl Region {
    pub fn new(begin: string, end: string, scope: Scope) -> Region {
        Region { begin, end, scope, nested: false, escape: Option::None, multiline: true }
    }
}

enum Token {
    Plain(Scope),
    Enter(Region),
    Raw,
}

pub struct Language {
    name: string,
    extensions: Vec[string],
    grammar: logos::Grammar[Token, (), string],
    markdown: bool,
}

#[derive(PartialEq, Eq)]
pub struct State {
    region: Option[Region],
    depth: isize,
    fence: string,
    embedded: string,
}

impl State {
    pub fn new() -> State {
        State { region: Option::None, depth: 0, fence: "", embedded: "" }
    }

    pub fn is_plain(self: State) -> bool {
        self.region.is_none() && self.fence == ""
    }
}

pub struct Line {
    text: string,
    spans: Vec[Span],
    before: State,
    after: State,
}

impl Line {
    pub fn text(self: Line) -> string {
        self.text
    }

    pub fn spans(self: Line) -> Vec[Span] {
        self.spans.copy()
    }

    pub fn before(self: Line) -> State {
        self.before
    }

    pub fn after(self: Line) -> State {
        self.after
    }
}

pub struct Options {
    pub max_bytes: isize,
    pub max_line_bytes: isize,
    pub max_lines: isize,
    pub max_spans: isize,
    pub max_depth: isize,
}

impl Options {
    pub fn new() -> Options {
        Options {
            max_bytes: 4194304,
            max_line_bytes: 65536,
            max_lines: 100000,
            max_spans: 1000000,
            max_depth: 64,
        }
    }
}

pub struct Highlighter {
    languages: Vec[Language],
    options: Options,
}

pub struct Document {
    highlighter: Highlighter,
    language: string,
    source: string,
    lines: Vec[Line],
}

pub struct Update {
    pub document: Document,
    pub reparsed_lines: isize,
    pub reused_lines: isize,
}
