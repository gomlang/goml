package highlight;

use std::context;

fn split_lines(text: string, max_lines: isize, ctx: context::Context) -> Result[Vec[string], Error] {
    let lines = Vec::new();
    let mut start = 0;
    let mut next_check = 0;
    for (index, ch) in text.char_indices() {
        if index >= next_check {
            checked_context(ctx)?;
            next_check = index + 1024;
        }
        if ch == '\n' {
            lines.push(text.byte_slice(start, index + 1));
            start = index + 1;
            if lines.len() >= max_lines {
                return Result::Err(failure("document line limit exceeded"));
            }
        }
    }
    checked_context(ctx)?;
    lines.push(text.byte_slice(start, text.byte_len()));
    Result::Ok(lines)
}

impl Highlighter {
    pub fn document(self: Highlighter, language: string, source: string, ctx: context::Context) -> Result[
        Document,
        Error,
    ] {
        checked_context(ctx)?;
        self.language(language)?;
        if source.byte_len() > self.options.max_bytes {
            return Result::Err(failure("document byte limit exceeded"));
        }
        let texts = split_lines(source, self.options.max_lines, ctx)?;
        let lines = Vec::new();
        let mut state = State::new();
        let mut count = 0;
        for text in texts {
            let line = self.line(language, text, state, ctx).map_err(
                |error| Error { line: lines.len() + 1, ..error },
            )?;
            state = line.after;
            count += line.spans.len();
            if count > self.options.max_spans {
                return Result::Err(failure("document span limit exceeded"));
            }
            lines.push(line);
        }
        Result::Ok(Document { highlighter: self, language, source, lines })
    }
}

impl Document {
    pub fn source(self: Document) -> string {
        self.source
    }

    pub fn language(self: Document) -> string {
        self.language
    }

    pub fn line_count(self: Document) -> isize {
        self.lines.len()
    }

    pub fn line(self: Document, index: isize) -> Option[Line] {
        if index < 0 || index >= self.lines.len() {
            Option::None
        } else {
            Option::Some(self.lines[index])
        }
    }

    pub fn spans(self: Document) -> Vec[Span] {
        let result = Vec::new();
        let mut offset = 0;
        for line in self.lines {
            for span in line.spans {
                append_span(result, span.start + offset, span.end + offset, span.scope);
            }
            offset += line.text.byte_len();
        }
        result
    }

    pub fn replace(
        self: Document,
        start: isize,
        end: isize,
        replacement: string,
        ctx: context::Context,
    ) -> Result[Update, Error] {
        checked_context(ctx)?;
        if start < 0 || end < start || end > self.source.byte_len()
            || !self.source.is_char_boundary(start)
            || !self.source.is_char_boundary(end) {
            return Result::Err(failure("edit range must be valid UTF-8 byte boundaries"));
        }
        let retained = self.source.byte_len() - (end - start);
        if replacement.byte_len() > self.highlighter.options.max_bytes - retained {
            return Result::Err(failure("document byte limit exceeded"));
        }
        let source = self.source.byte_slice(0, start) + replacement
            + self.source.byte_slice(end, self.source.byte_len());
        let texts = split_lines(source, self.highlighter.options.max_lines, ctx)?;
        let mut prefix = 0;
        while prefix < texts.len() && prefix < self.lines.len()
            && texts[prefix] == self.lines[prefix].text {
            checked_context(ctx)?;
            prefix += 1;
        }
        let mut suffix = 0;
        while suffix < texts.len() - prefix && suffix < self.lines.len() - prefix
            && texts[texts.len() - 1 - suffix] == self.lines[self.lines.len() - 1 - suffix].text {
            checked_context(ctx)?;
            suffix += 1;
        }
        let lines = Vec::new();
        let mut state = State::new();
        let mut count = 0;
        for index in 0..prefix {
            checked_context(ctx)?;
            let line = self.lines[index];
            count += line.spans.len();
            lines.push(line);
            state = line.after;
        }
        let mut index = prefix;
        let mut reparsed = 0;
        while index < texts.len() {
            checked_context(ctx)?;
            let old_index = index + self.lines.len() - texts.len();
            if index >= texts.len() - suffix && old_index >= 0
                && state == self.lines[old_index].before {
                for remaining in old_index..self.lines.len() {
                    checked_context(ctx)?;
                    let line = self.lines[remaining];
                    count += line.spans.len();
                    lines.push(line);
                }
                break;
            }
            let line = self.highlighter.line(self.language, texts[index], state, ctx).map_err(
                |error| Error { line: index + 1, ..error },
            )?;
            state = line.after;
            count += line.spans.len();
            lines.push(line);
            reparsed += 1;
            index += 1;
        }
        if count > self.highlighter.options.max_spans {
            return Result::Err(failure("document span limit exceeded"));
        }
        let document = Document { source, lines, ..self };
        checked_context(ctx)?;
        Result::Ok(
            Update {
                reparsed_lines: reparsed,
                reused_lines: document.line_count() - reparsed,
                document,
            },
        )
    }
}
