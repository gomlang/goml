package ndarray;

use std::num;

#[derive(Debug, PartialEq)]
pub enum BinaryOp {
    Add,
    Subtract,
    Multiply,
    Divide,
}

#[derive(Debug, PartialEq)]
pub enum Execution {
    Scalar,
    Simd,
}

pub trait Scalar {
    fn zero() -> Self;
    fn one() -> Self;
    fn add(self: Self, other: Self) -> Result[Self, Error];
    fn subtract(self: Self, other: Self) -> Result[Self, Error];
    fn multiply(self: Self, other: Self) -> Result[Self, Error];
    fn divide(self: Self, other: Self) -> Result[Self, Error];
    fn evaluate(operation: BinaryOp, left: Self, right: Self) -> Result[Self, Error] {
        match operation {
            BinaryOp::Add => Scalar::add(left, right),
            BinaryOp::Subtract => Scalar::subtract(left, right),
            BinaryOp::Multiply => Scalar::multiply(left, right),
            BinaryOp::Divide => Scalar::divide(left, right),
        }
    }
    fn batch(operation: BinaryOp, left: Slice[Self], right: Slice[Self], execution: Execution) -> Result[
        Vec[Self],
        Error,
    ] {
        scalar_batch(operation, left, right)
    }
    fn sum_values(values: Slice[Self]) -> Result[Self, Error] {
        let mut total: Self = Scalar::zero();
        for value in values {
            total = Scalar::add(total, value)?;
        }
        Result::Ok(total)
    }
    fn product_values(values: Slice[Self]) -> Result[Self, Error] {
        let mut total: Self = Scalar::one();
        for value in values {
            total = Scalar::multiply(total, value)?;
        }
        Result::Ok(total)
    }
    fn dot_values(left: Slice[Self], right: Slice[Self], execution: Execution) -> Result[
        Self,
        Error,
    ] {
        if left.len() != right.len() {
            return Result::Err(Error::new(ErrorKind::Shape, "dot lengths differ"))
        }
        let mut total: Self = Scalar::zero();
        for index in 0..left.len() {
            total = Scalar::add(total, Scalar::multiply(left[index], right[index])?)?;
        }
        Result::Ok(total)
    }
}

fn scalar_batch[T: Scalar](operation: BinaryOp, left: Slice[T], right: Slice[T]) -> Result[
    Vec[T],
    Error,
] {
    if left.len() != right.len() {
        return Result::Err(Error::new(ErrorKind::Shape, "elementwise lengths differ"))
    }
    let values: Vec[T] = Vec::with_capacity(left.len());
    for index in 0..left.len() {
        values.push(Scalar::evaluate(operation, left[index], right[index])?);
    }
    Result::Ok(values)
}

impl Scalar for i64 {
    fn zero() -> i64 {
        0
    }

    fn one() -> i64 {
        1
    }

    fn add(self: i64, other: i64) -> Result[i64, Error] {
        num::checked_add_int64(self, other).ok_or(
            Error::new(ErrorKind::Arithmetic, "signed addition overflow"),
        )
    }

    fn subtract(self: i64, other: i64) -> Result[i64, Error] {
        num::checked_subtract_int64(self, other).ok_or(
            Error::new(ErrorKind::Arithmetic, "signed subtraction overflow"),
        )
    }

    fn multiply(self: i64, other: i64) -> Result[i64, Error] {
        num::checked_multiply_int64(self, other).ok_or(
            Error::new(ErrorKind::Arithmetic, "signed multiplication overflow"),
        )
    }

    fn divide(self: i64, other: i64) -> Result[i64, Error] {
        if other == 0 || self == -9223372036854775808 && other == -1 {
            Result::Err(Error::new(ErrorKind::Arithmetic, "invalid signed division"))
        } else {
            Result::Ok(self / other)
        }
    }
}

impl Scalar for u64 {
    fn zero() -> u64 {
        0
    }

    fn one() -> u64 {
        1
    }

    fn add(self: u64, other: u64) -> Result[u64, Error] {
        if other > 18446744073709551615 - self {
            Result::Err(Error::new(ErrorKind::Arithmetic, "unsigned addition overflow"))
        } else {
            Result::Ok(self + other)
        }
    }

    fn subtract(self: u64, other: u64) -> Result[u64, Error] {
        if other > self {
            Result::Err(Error::new(ErrorKind::Arithmetic, "unsigned subtraction overflow"))
        } else {
            Result::Ok(self - other)
        }
    }

    fn multiply(self: u64, other: u64) -> Result[u64, Error] {
        if self != 0 && other > 18446744073709551615 / self {
            Result::Err(Error::new(ErrorKind::Arithmetic, "unsigned multiplication overflow"))
        } else {
            Result::Ok(self * other)
        }
    }

    fn divide(self: u64, other: u64) -> Result[u64, Error] {
        if other == 0 {
            Result::Err(Error::new(ErrorKind::Arithmetic, "division by zero"))
        } else {
            Result::Ok(self / other)
        }
    }
}

impl[T: Scalar] Array[T] {
    pub fn zeros(shape: Vec[isize]) -> Result[Array[T], Error] {
        Array::full(shape, Scalar::zero())
    }

    pub fn ones(shape: Vec[isize]) -> Result[Array[T], Error] {
        Array::full(shape, Scalar::one())
    }

    pub fn binary_with(self: Array[T], other: Array[T], operation: BinaryOp, execution: Execution) -> Result[
        Array[T],
        Error,
    ] {
        let shape = broadcast_shape(self.dimensions, other.dimensions)?;
        let limits = self.limits.intersect(other.limits);
        let length = shape_size(shape, limits)?;
        let left = self.broadcast_to(shape)?;
        let right = other.broadcast_to(shape)?;
        if let Some(a) = left.as_slice() {
            if let Some(b) = right.as_slice() {
                let values: Vec[T] = Scalar::batch(operation, a, b, execution)?;
                if values.len() != length {
                    return Result::Err(
                        Error::new(
                            ErrorKind::Shape,
                            "Scalar::batch returned an incorrect element count",
                        ),
                    )
                }
                return Result::Ok(owned(shape, values, limits))
            }
        }
        let values: Vec[T] = Vec::with_capacity(length);
        for index in 0..length {
            values.push(Scalar::evaluate(operation, left.value(index), right.value(index))?);
        }
        Result::Ok(owned(shape, values, limits))
    }

    pub fn add(self: Array[T], other: Array[T]) -> Result[Array[T], Error] {
        self.binary_with(other, BinaryOp::Add, Execution::Simd)
    }

    pub fn subtract(self: Array[T], other: Array[T]) -> Result[Array[T], Error] {
        self.binary_with(other, BinaryOp::Subtract, Execution::Simd)
    }

    pub fn multiply(self: Array[T], other: Array[T]) -> Result[Array[T], Error] {
        self.binary_with(other, BinaryOp::Multiply, Execution::Simd)
    }

    pub fn divide(self: Array[T], other: Array[T]) -> Result[Array[T], Error] {
        self.binary_with(other, BinaryOp::Divide, Execution::Simd)
    }

    pub fn binary_scalar(self: Array[T], value: T, operation: BinaryOp) -> Result[Array[T], Error] {
        let values: Vec[T] = Vec::with_capacity(self.length);
        for index in 0..self.length {
            values.push(Scalar::evaluate(operation, self.value(index), value)?);
        }
        Result::Ok(owned(self.dimensions, values, self.limits))
    }

    pub fn add_scalar(self: Array[T], value: T) -> Result[Array[T], Error] {
        self.binary_scalar(value, BinaryOp::Add)
    }

    pub fn scale(self: Array[T], value: T) -> Result[Array[T], Error] {
        self.binary_scalar(value, BinaryOp::Multiply)
    }

    pub fn apply_assign(self: Array[T], other: Array[T], operation: BinaryOp) -> Result[(), Error] {
        if !self.writable {
            return Result::Err(Error::new(ErrorKind::ReadOnly, "array view is read-only"))
        }
        if broadcast_shape(self.dimensions, other.dimensions)? != self.dimensions {
            return Result::Err(
                Error::new(ErrorKind::Shape, "in-place operation cannot expand destination"),
            )
        }
        self.assign(self.binary_with(other, operation, Execution::Simd)?)
    }

    pub fn sum(self: Array[T]) -> Result[T, Error] {
        Scalar::sum_values(self.to_vec().as_slice())
    }

    pub fn product(self: Array[T]) -> Result[T, Error] {
        Scalar::product_values(self.to_vec().as_slice())
    }

    pub fn sum_axes(self: Array[T], axes: Vec[isize], keep_dimensions: bool) -> Result[
        Array[T],
        Error,
    ] {
        if axes.is_empty() {
            return Result::Ok(self.copy())
        }
        self.reduce_axes(axes, keep_dimensions, |values| Scalar::sum_values(values))
    }

    pub fn product_axes(self: Array[T], axes: Vec[isize], keep_dimensions: bool) -> Result[
        Array[T],
        Error,
    ] {
        if axes.is_empty() {
            return Result::Ok(self.copy())
        }
        self.reduce_axes(axes, keep_dimensions, |values| Scalar::product_values(values))
    }
}

impl Array[bool] {
    pub fn all(self: Array[bool]) -> bool {
        for index in 0..self.length {
            if !self.value(index) {
                return false
            }
        }
        true
    }

    pub fn any(self: Array[bool]) -> bool {
        for index in 0..self.length {
            if self.value(index) {
                return true
            }
        }
        false
    }
}

pub fn where_array[T](condition: Array[bool], yes: Array[T], no: Array[T]) -> Result[
    Array[T],
    Error,
] {
    let shape = broadcast_shape(
        broadcast_shape(yes.dimensions, no.dimensions)?,
        condition.dimensions,
    )?;
    let limits = yes.limits.intersect(no.limits).intersect(condition.limits);
    let length = shape_size(shape, limits)?;
    let condition = condition.broadcast_to(shape)?;
    let yes = yes.broadcast_to(shape)?;
    let no = no.broadcast_to(shape)?;
    let values = Vec::with_capacity(length);
    for index in 0..length {
        values.push(
            if condition.value(index) {
                yes.value(index)
            } else {
                no.value(index)
            },
        );
    }
    Result::Ok(owned(shape, values, limits))
}
