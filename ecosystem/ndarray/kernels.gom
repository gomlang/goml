package ndarray;

use std::simd;
use std::math;

fn add_f64(left: simd::f64x4, right: simd::f64x4) -> simd::f64x4 {
    left.add(right)
}

fn subtract_f64(left: simd::f64x4, right: simd::f64x4) -> simd::f64x4 {
    left.sub(right)
}

fn multiply_f64(left: simd::f64x4, right: simd::f64x4) -> simd::f64x4 {
    left.mul(right)
}

fn divide_f64(left: simd::f64x4, right: simd::f64x4) -> simd::f64x4 {
    left.div(right)
}

fn dot_f64(total: simd::f64x4, left: simd::f64x4, right: simd::f64x4) -> simd::f64x4 {
    total.add(left.mul(right))
}

impl Scalar for f64 {
    fn zero() -> f64 {
        0.0
    }

    fn one() -> f64 {
        1.0
    }

    fn add(self: f64, other: f64) -> Result[f64, Error] {
        Result::Ok(self + other)
    }

    fn subtract(self: f64, other: f64) -> Result[f64, Error] {
        Result::Ok(self - other)
    }

    fn multiply(self: f64, other: f64) -> Result[f64, Error] {
        Result::Ok(self * other)
    }

    fn divide(self: f64, other: f64) -> Result[f64, Error] {
        Result::Ok(self / other)
    }

    fn batch(operation: BinaryOp, left: Slice[f64], right: Slice[f64], execution: Execution) -> Result[
        Vec[f64],
        Error,
    ] {
        if execution == Execution::Scalar {
            return scalar_batch(operation, left, right)
        }
        if left.len() != right.len() {
            return Result::Err(Error::new(ErrorKind::Shape, "elementwise lengths differ"))
        }
        let output = Vec::with_capacity(left.len());
        let mut index = 0;
        while index <= left.len() - 4 {
            let a = simd::f64x4::from_array(
                [left[index], left[index + 1], left[index + 2], left[index + 3]],
            );
            let b = simd::f64x4::from_array(
                [right[index], right[index + 1], right[index + 2], right[index + 3]],
            );
            let result = match operation {
                BinaryOp::Add => add_f64(a, b),
                BinaryOp::Subtract => subtract_f64(a, b),
                BinaryOp::Multiply => multiply_f64(a, b),
                BinaryOp::Divide => divide_f64(a, b),
            }.to_array();
            for lane in 0..4 {
                output.push(result[lane]);
            }
            index += 4;
        }
        while index < left.len() {
            output.push(Scalar::evaluate(operation, left[index], right[index])?);
            index += 1;
        }
        Result::Ok(output)
    }

    fn dot_values(left: Slice[f64], right: Slice[f64], execution: Execution) -> Result[f64, Error] {
        if left.len() != right.len() {
            return Result::Err(Error::new(ErrorKind::Shape, "dot lengths differ"))
        }
        let mut index = 0;
        let mut total: f64 = 0.0;
        if execution == Execution::Simd {
            let mut lanes = simd::f64x4::splat(0.0);
            while index <= left.len() - 4 {
                let a = simd::f64x4::from_array(
                    [left[index], left[index + 1], left[index + 2], left[index + 3]],
                );
                let b = simd::f64x4::from_array(
                    [right[index], right[index + 1], right[index + 2], right[index + 3]],
                );
                lanes = dot_f64(lanes, a, b);
                index += 4;
            }
            total = lanes.reduce_sum();
        }
        while index < left.len() {
            total += left[index] * right[index];
            index += 1;
        }
        Result::Ok(total)
    }

    fn sum_values(values: Slice[f64]) -> Result[f64, Error] {
        Result::Ok(compensated_sum(values))
    }
}

fn add_f32(left: simd::f32x4, right: simd::f32x4) -> simd::f32x4 {
    left.add(right)
}

fn subtract_f32(left: simd::f32x4, right: simd::f32x4) -> simd::f32x4 {
    left.sub(right)
}

fn multiply_f32(left: simd::f32x4, right: simd::f32x4) -> simd::f32x4 {
    left.mul(right)
}

fn divide_f32(left: simd::f32x4, right: simd::f32x4) -> simd::f32x4 {
    left.div(right)
}

fn dot_f32(total: simd::f32x4, left: simd::f32x4, right: simd::f32x4) -> simd::f32x4 {
    total.add(left.mul(right))
}

impl Scalar for f32 {
    fn zero() -> f32 {
        0.0
    }

    fn one() -> f32 {
        1.0
    }

    fn add(self: f32, other: f32) -> Result[f32, Error] {
        Result::Ok(self + other)
    }

    fn subtract(self: f32, other: f32) -> Result[f32, Error] {
        Result::Ok(self - other)
    }

    fn multiply(self: f32, other: f32) -> Result[f32, Error] {
        Result::Ok(self * other)
    }

    fn divide(self: f32, other: f32) -> Result[f32, Error] {
        Result::Ok(self / other)
    }

    fn batch(operation: BinaryOp, left: Slice[f32], right: Slice[f32], execution: Execution) -> Result[
        Vec[f32],
        Error,
    ] {
        if execution == Execution::Scalar {
            return scalar_batch(operation, left, right)
        }
        if left.len() != right.len() {
            return Result::Err(Error::new(ErrorKind::Shape, "elementwise lengths differ"))
        }
        let output = Vec::with_capacity(left.len());
        let mut index = 0;
        while index <= left.len() - 4 {
            let a = simd::f32x4::from_array(
                [left[index], left[index + 1], left[index + 2], left[index + 3]],
            );
            let b = simd::f32x4::from_array(
                [right[index], right[index + 1], right[index + 2], right[index + 3]],
            );
            let result = match operation {
                BinaryOp::Add => add_f32(a, b),
                BinaryOp::Subtract => subtract_f32(a, b),
                BinaryOp::Multiply => multiply_f32(a, b),
                BinaryOp::Divide => divide_f32(a, b),
            }.to_array();
            for lane in 0..4 {
                output.push(result[lane]);
            }
            index += 4;
        }
        while index < left.len() {
            output.push(Scalar::evaluate(operation, left[index], right[index])?);
            index += 1;
        }
        Result::Ok(output)
    }

    fn dot_values(left: Slice[f32], right: Slice[f32], execution: Execution) -> Result[f32, Error] {
        if left.len() != right.len() {
            return Result::Err(Error::new(ErrorKind::Shape, "dot lengths differ"))
        }
        let mut index = 0;
        let mut total: f32 = 0.0;
        if execution == Execution::Simd {
            let mut lanes = simd::f32x4::splat(0.0);
            while index <= left.len() - 4 {
                let a = simd::f32x4::from_array(
                    [left[index], left[index + 1], left[index + 2], left[index + 3]],
                );
                let b = simd::f32x4::from_array(
                    [right[index], right[index + 1], right[index + 2], right[index + 3]],
                );
                lanes = dot_f32(lanes, a, b);
                index += 4;
            }
            total = lanes.reduce_sum();
        }
        while index < left.len() {
            total += left[index] * right[index];
            index += 1;
        }
        Result::Ok(total)
    }

    fn sum_values(values: Slice[f32]) -> Result[f32, Error] {
        let widened = Vec::with_capacity(values.len());
        for value in values {
            widened.push(value.to_f64());
        }
        Result::Ok(compensated_sum(widened.as_slice()).to_f32())
    }
}

fn magnitude(value: f64) -> f64 {
    float64_from_bits(value.to_bits() & 0x7fffffffffffffff)
}

fn count_float(value: isize) -> f64 {
    simd::i64x4::splat(value.to_i64()).to_f64().to_array()[0]
}

fn compensated_sum(values: Slice[f64]) -> f64 {
    let mut total = 0.0;
    let mut correction = 0.0;
    for value in values {
        let next = total + value;
        if math::is_finite(total) && math::is_finite(value) && math::is_finite(next) {
            correction += if magnitude(total) >= magnitude(value) {
                (total - next) + value
            } else {
                (value - next) + total
            };
        } else {
            correction = 0.0;
        }
        total = next;
    }
    total + correction
}
