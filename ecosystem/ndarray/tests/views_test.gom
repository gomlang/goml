package tests;

use ecosystem::ndarray;
use ecosystem::ndarray::{Array, Limits, SliceSpec, ErrorKind};
use std::testing;

fn array(shape: Vec[isize], values: Vec[isize]) -> Array[isize] {
    testing::expect_ok(Array::from_vec(shape, values), "array")
}

fn grid() -> Array[isize] {
    array(Vec::from_array([2, 3]), Vec::from_array([0, 1, 2, 3, 4, 5]))
}

#[test]
fn constructors_scalar_empty_bounds_and_metadata_snapshots() -> () {
    let shape = Vec::from_array([2, 3]);
    let values = Vec::from_array([0, 1, 2, 3, 4, 5]);
    let a = array(shape, values);
    shape[0] = 99;
    values[0] = 99;
    let exposed = a.shape();
    exposed[0] = 88;
    testing::assert(a.shape() == Vec::from_array([2, 3]));
    testing::assert(a.strides() == Vec::from_array([3, 1]));
    testing::assert_eq(testing::expect_ok(a.get(Vec::from_array([-1, -1])), "negative index"), 5);
    testing::assert_eq(testing::expect_ok(a.get_flat(-6), "flat index"), 0);
    testing::assert_err(a.get_flat(6));
    testing::assert_err(a.get(Vec::from_array([0])));
    testing::assert_err(a.get(Vec::from_array([0, -4])));
    let scalar = Array::scalar("scalar");
    testing::assert_eq(scalar.ndim(), 0);
    testing::assert_eq(testing::expect_ok(scalar.get(Vec::new()), "scalar get"), "scalar");
    let empty = array(Vec::from_array([3, 0, 9223372036854775807]), Vec::new());
    testing::assert(empty.is_contiguous() && empty.is_empty());
    testing::assert_err(empty.get(Vec::from_array([0, 0, 0])));
    testing::assert_err(Array::from_vec(Vec::from_array([-1]), Vec::from_array([0])));
    testing::assert_err(
        Array::from_vec(Vec::from_array([9223372036854775807, 2]), Vec::from_array([0])),
    );
    testing::assert_err(
        Array::from_vec_with_limits(
            Vec::from_array([2, 3]),
            Vec::from_array([0, 1, 2, 3, 4, 5]),
            Limits { max_rank: 1, max_elements: 6 },
        ),
    );
    testing::assert_err(
        Array::from_vec_with_limits(
            Vec::new(),
            Vec::from_array([0]),
            Limits { max_rank: 0, max_elements: 0 },
        ),
    );
}

#[test]
fn shared_transpose_slice_and_overlap_safe_assignment() -> () {
    let a = grid();
    let transposed = testing::expect_ok(a.reversed_axes(), "transpose");
    testing::assert(a.shares_storage(transposed));
    testing::assert(transposed.to_vec() == Vec::from_array([0, 3, 1, 4, 2, 5]));
    testing::assert_ok(transposed.set(Vec::from_array([1, 0]), 9));
    testing::assert_eq(testing::expect_ok(a.get(Vec::from_array([0, 1])), "shared update"), 9);
    let reverse = testing::expect_ok(a.slice(1, SliceSpec::reverse()), "reverse");
    testing::assert(reverse.to_vec() == Vec::from_array([2, 9, 0, 5, 4, 3]));
    testing::assert_ok(a.assign(reverse));
    testing::assert(a.to_vec() == Vec::from_array([2, 9, 0, 5, 4, 3]));
    let square = array(Vec::from_array([2, 2]), Vec::from_array([1, 2, 3, 4]));
    testing::assert_ok(square.assign(testing::expect_ok(square.reversed_axes(), "transpose")));
    testing::assert(square.to_vec() == Vec::from_array([1, 3, 2, 4]));
    let strided = testing::expect_ok(
        a.slice(1, SliceSpec { step: 2, ..SliceSpec::all() }),
        "strided",
    );
    testing::assert(strided.to_vec() == Vec::from_array([2, 0, 5, 3]));
    testing::assert_err(strided.as_mut_slice());
    let row = testing::expect_ok(a.index_axis(0, 1), "row");
    let bytes = testing::expect_ok(row.as_mut_slice(), "contiguous view");
    bytes[0] = 10;
    testing::assert_eq(testing::expect_ok(a.get_flat(3), "write through slice"), 10);
}

#[test]
fn slicing_clamps_and_distinguishes_omitted_negative_stop() -> () {
    let a = array(Vec::from_array([5]), Vec::from_array([0, 1, 2, 3, 4]));
    let fixtures = Vec::from_array(
        [
            (SliceSpec::reverse(), Vec::from_array([4, 3, 2, 1, 0])),
            (SliceSpec { start: Option::None, stop: Option::Some(-1), step: -1 }, Vec::new()),
            (
                SliceSpec { start: Option::Some(99), stop: Option::Some(-99), step: -2 },
                Vec::from_array([4, 2, 0]),
            ),
            (
                SliceSpec { start: Option::Some(-99), stop: Option::Some(99), step: 2 },
                Vec::from_array([0, 2, 4]),
            ),
            (SliceSpec { step: -9223372036854775808, ..SliceSpec::all() }, Vec::from_array([4])),
            (SliceSpec { step: 9223372036854775807, ..SliceSpec::all() }, Vec::from_array([0])),
            (SliceSpec::between(4, 1), Vec::new()),
        ],
    );
    for (spec, expected) in fixtures {
        testing::assert(testing::expect_ok(a.slice(0, spec), "slice").to_vec() == expected);
    }
    testing::assert_err(a.slice(0, SliceSpec { step: 0, ..SliceSpec::all() }));
    let empty = array(Vec::from_array([0, 5]), Vec::new());
    testing::assert(
        testing::expect_ok(empty.slice(1, SliceSpec::reverse()), "empty reverse").is_empty(),
    );
}

#[test]
fn reshape_views_copies_inference_and_broadcast_read_only() -> () {
    let a = grid();
    let shaped = testing::expect_ok(a.reshape_view(Vec::from_array([3, -1])), "reshape");
    testing::assert(shaped.shape() == Vec::from_array([3, 2]));
    testing::assert(shaped.shares_storage(a));
    let transposed = testing::expect_ok(a.reversed_axes(), "transpose");
    testing::assert_err(transposed.reshape_view(Vec::from_array([6])));
    let flattened = testing::expect_ok(transposed.ravel(), "ravel copy");
    testing::assert(!flattened.shares_storage(a));
    testing::assert(flattened.to_vec() == Vec::from_array([0, 3, 1, 4, 2, 5]));
    testing::assert(!testing::expect_ok(a.flatten(), "flatten").shares_storage(a));
    testing::assert_err(a.reshape(Vec::from_array([-1, -1])));
    testing::assert_err(a.reshape(Vec::from_array([5])));
    let empty = array(Vec::from_array([0]), Vec::new());
    testing::assert_err(empty.reshape(Vec::from_array([0, -1])));
    testing::assert(
        testing::expect_ok(empty.reshape(Vec::from_array([-1, 2])), "infer zero").shape()
            == Vec::from_array([0, 2]),
    );
    let scalar = Array::scalar(7);
    let broad = testing::expect_ok(scalar.broadcast_to(Vec::from_array([2, 3])), "broadcast");
    testing::assert_eq(testing::expect_err(broad.fill(8), "read only").kind, ErrorKind::ReadOnly);
    testing::assert(broad.to_vec() == Vec::from_array([7, 7, 7, 7, 7, 7]));
    testing::assert_ok(a.assign(scalar));
    testing::assert(a.to_vec() == broad.to_vec());
    testing::assert(
        testing::expect_ok(
            ndarray::broadcast_shape(Vec::from_array([0, 3]), Vec::from_array([1, 3])),
            "zero broadcast",
        )
            == Vec::from_array([0, 3]),
    );
    testing::assert_err(a.broadcast_to(Vec::from_array([2, 4])));
    let expanded = testing::expect_ok(a.insert_axis(-1), "insert");
    testing::assert(expanded.shape() == Vec::from_array([2, 3, 1]));
    testing::assert(testing::expect_ok(expanded.squeeze(), "squeeze").shape() == a.shape());
}

#[test]
fn gather_diagonal_concat_stack_and_custom_reductions() -> () {
    let a = grid();
    let taken = testing::expect_ok(a.take(1, Vec::from_array([-1, 0, -1])), "gather");
    testing::assert(taken.to_vec() == Vec::from_array([2, 0, 2, 5, 3, 5]));
    testing::assert(!taken.shares_storage(a));
    let diagonal = testing::expect_ok(a.diagonal(1, 0, 1), "diagonal");
    testing::assert(diagonal.to_vec() == Vec::from_array([1, 5]));
    testing::assert_ok(diagonal.fill(99));
    testing::assert(a.to_vec() == Vec::from_array([0, 99, 2, 3, 4, 99]));
    let joined = testing::expect_ok(ndarray::concatenate(Vec::from_array([a, a]), 1), "concat");
    testing::assert(joined.shape() == Vec::from_array([2, 6]));
    testing::assert(joined.to_vec() == Vec::from_array([0, 99, 2, 0, 99, 2, 3, 4, 99, 3, 4, 99]));
    let stacked = testing::expect_ok(ndarray::stack(Vec::from_array([a, a]), 0), "stack");
    testing::assert(stacked.shape() == Vec::from_array([2, 2, 3]));
    let strings = a.map(|value| value.to_string());
    let lengths = testing::expect_ok(
        strings.reduce_axes(
            Vec::from_array([1]),
            true,
            |items| {
                let mut total = 0;
                for item in items {
                    total += item.byte_len();
                }
                Result::Ok(total)
            },
        ),
        "generic reduction",
    );
    testing::assert(lengths.shape() == Vec::from_array([2, 1]));
    testing::assert(lengths.to_vec() == Vec::from_array([4, 4]));
    testing::assert_err(
        a.reduce_axes(Vec::from_array([0, -2]), false, |items| Result::Ok(items.len())),
    );
}
