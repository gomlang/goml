package tests;

use ecosystem::ndarray::{Array, SolveOptions, ErrorKind};
use std::testing;
use std::math;

#[test]
fn partial_pivot_lu_solves_many_rhs_and_preserves_factors() -> () {
    let a = floats(
        Vec::from_array([3, 3]),
        Vec::from_array([0.0, 2.0, 1.0, 1.0, -2.0, -3.0, 2.0, 3.0, 1.0]),
    );
    let original = a.copy();
    let b = floats(Vec::from_array([3]), Vec::from_array([3.0, 0.0, 7.0]));
    let lu = testing::expect_ok(a.lu(SolveOptions::standard()), "LU");
    same(
        testing::expect_ok(lu.solve(b), "solve"),
        floats(Vec::from_array([3]), Vec::from_array([1.0, 2.0, -1.0])),
    );
    let permuted = testing::expect_ok(a.take(0, lu.permutation()), "permuted A");
    same(testing::expect_ok(lu.lower().matmul(lu.upper()), "LU product"), permuted);
    let inverse = testing::expect_ok(lu.inverse(), "inverse");
    same(
        testing::expect_ok(a.matmul(inverse), "identity"),
        testing::expect_ok(Array::eye(3, 3, 0), "eye"),
    );
    same(a, original);
    testing::assert_ok(lu.packed().fill(0.0));
    testing::assert_ok(a.fill(0.0));
    same(
        testing::expect_ok(lu.solve(b), "factor snapshot"),
        floats(Vec::from_array([3]), Vec::from_array([1.0, 2.0, -1.0])),
    );
    near(lu.determinant(), -7.0);
    near(lu.slogdet().0, -1.0);
    near(lu.slogdet().1, math::log(7.0));
}

#[test]
fn cholesky_matches_known_factor_and_solves() -> () {
    let a = floats(
        Vec::from_array([3, 3]),
        Vec::from_array([4.0, 12.0, -16.0, 12.0, 37.0, -43.0, -16.0, -43.0, 98.0]),
    );
    let factor = testing::expect_ok(a.cholesky(SolveOptions::standard()), "Cholesky");
    same(
        factor.lower(),
        floats(
            Vec::from_array([3, 3]),
            Vec::from_array([2.0, 0.0, 0.0, 6.0, 1.0, 0.0, -8.0, 5.0, 3.0]),
        ),
    );
    same(
        testing::expect_ok(
            factor.solve(floats(Vec::from_array([3]), Vec::from_array([-20.0, -43.0, 192.0]))),
            "SPD solve",
        ),
        floats(Vec::from_array([3]), Vec::from_array([1.0, 2.0, 3.0])),
    );
    near(factor.slogdet(), math::log(36.0));
    testing::assert_ok(factor.lower().fill(0.0));
    near(testing::expect_ok(factor.lower().get_flat(0), "factor copy"), 2.0);
}

#[test]
fn householder_qr_reconstructs_and_fits_overdetermined_system() -> () {
    let a = floats(
        Vec::from_array([4, 2]),
        Vec::from_array([1.0, 1.0, 1.0, 2.0, 1.0, 3.0, 1.0, 4.0]),
    );
    let qr = testing::expect_ok(a.qr(SolveOptions::standard()), "QR");
    same(testing::expect_ok(qr.q().matmul(qr.r()), "QR product"), a);
    same(
        testing::expect_ok(
            testing::expect_ok(qr.q().reversed_axes(), "Q transpose").matmul(qr.q()),
            "orthogonal columns",
        ),
        testing::expect_ok(Array::eye(2, 2, 0), "eye"),
    );
    let rhs = floats(Vec::from_array([4]), Vec::from_array([6.0, 5.0, 7.0, 10.0]));
    same(
        testing::expect_ok(qr.solve(rhs), "least squares"),
        floats(Vec::from_array([2]), Vec::from_array([3.5, 1.4])),
    );
    let residual = testing::expect_ok(
        testing::expect_ok(a.matmul(testing::expect_ok(qr.solve(rhs), "solution")), "predicted").subtract(
            rhs,
        ),
        "residual",
    );
    same(
        testing::expect_ok(
            testing::expect_ok(a.reversed_axes(), "transpose").matmul(residual),
            "normal equation residual",
        ),
        floats(Vec::from_array([2]), Vec::from_array([0.0, 0.0])),
    );
}

#[test]
fn singular_nonfinite_nonsymmetric_and_bad_rhs_are_recoverable() -> () {
    let singular = floats(Vec::from_array([2, 2]), Vec::from_array([1.0, 2.0, 2.0, 4.0]));
    testing::assert_eq(
        testing::expect_err(singular.lu(SolveOptions::standard()), "singular").kind,
        ErrorKind::Singular,
    );
    near(testing::expect_ok(singular.determinant(), "zero determinant"), 0.0);
    let logdet = testing::expect_ok(singular.slogdet(), "singular slogdet");
    near(logdet.0, 0.0);
    testing::assert(math::is_infinite(logdet.1) && logdet.1 < 0.0);
    testing::assert_err(singular.qr(SolveOptions::standard()));
    let indefinite = floats(Vec::from_array([2, 2]), Vec::from_array([1.0, 2.0, 2.0, 1.0]));
    testing::assert_eq(
        testing::expect_err(indefinite.cholesky(SolveOptions::standard()), "indefinite").kind,
        ErrorKind::NotPositiveDefinite,
    );
    let nonsymmetric = floats(Vec::from_array([2, 2]), Vec::from_array([2.0, 0.0, 1.0, 2.0]));
    testing::assert_err(nonsymmetric.cholesky(SolveOptions::standard()));
    testing::assert_err(
        nonsymmetric.solve(
            floats(Vec::from_array([3]), Vec::from_array([1.0, 2.0, 3.0])),
            SolveOptions::standard(),
        ),
    );
    testing::assert_err(
        nonsymmetric.lu(SolveOptions { absolute_tolerance: -1.0, ..SolveOptions::standard() }),
    );
    let nonfinite = floats(
        Vec::from_array([1, 1]),
        Vec::from_array([float64_from_bits(0x7ff8000000000000)]),
    );
    testing::assert_eq(
        testing::expect_err(nonfinite.lu(SolveOptions::standard()), "nan input").kind,
        ErrorKind::NonFinite,
    );
    let near_singular = floats(Vec::from_array([2, 2]), Vec::from_array([1.0, 0.0, 0.0, 1e-15]));
    testing::assert_err(near_singular.lu(SolveOptions::standard()));
    testing::assert_ok(
        near_singular.lu(SolveOptions { absolute_tolerance: 0.0, relative_tolerance: 0.0 }),
    );
}

#[test]
fn zero_dimension_factorizations_preserve_shapes_and_identity_determinant() -> () {
    let empty: Array[f64] = testing::expect_ok(
        Array::zeros(Vec::from_array([0, 0])),
        "empty matrix",
    );
    near(testing::expect_ok(empty.determinant(), "empty determinant"), 1.0);
    testing::assert(
        testing::expect_ok(empty.inverse(SolveOptions::standard()), "empty inverse").shape()
            == Vec::from_array([0, 0]),
    );
    let b: Array[f64] = testing::expect_ok(Array::zeros(Vec::from_array([0])), "empty rhs");
    testing::assert(
        testing::expect_ok(empty.solve(b, SolveOptions::standard()), "empty solve").shape()
            == Vec::from_array([0]),
    );
    testing::assert(
        testing::expect_ok(empty.cholesky(SolveOptions::standard()), "empty cholesky").lower().is_empty(),
    );
    testing::assert(
        testing::expect_ok(empty.qr(SolveOptions::standard()), "empty QR").q().is_empty(),
    );
}
