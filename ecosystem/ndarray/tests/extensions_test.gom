package tests;

use ecosystem::ndarray::{Array, Scalar, BinaryOp, Execution, Error, ErrorKind, Limits};
use std::testing;

struct BadBatch {
    value: isize,
}

impl Scalar for BadBatch {
    fn zero() -> BadBatch {
        BadBatch { value: 0 }
    }

    fn one() -> BadBatch {
        BadBatch { value: 1 }
    }

    fn add(self: BadBatch, other: BadBatch) -> Result[BadBatch, Error] {
        Result::Ok(self)
    }

    fn subtract(self: BadBatch, other: BadBatch) -> Result[BadBatch, Error] {
        Result::Ok(self)
    }

    fn multiply(self: BadBatch, other: BadBatch) -> Result[BadBatch, Error] {
        Result::Ok(self)
    }

    fn divide(self: BadBatch, other: BadBatch) -> Result[BadBatch, Error] {
        Result::Ok(self)
    }

    fn batch(
        operation: BinaryOp,
        left: Slice[BadBatch],
        right: Slice[BadBatch],
        execution: Execution,
    ) -> Result[Vec[BadBatch], Error] {
        Result::Ok(Vec::new())
    }
}

#[test]
fn custom_scalar_batches_cannot_violate_shape_invariant() -> () {
    let a = Array::scalar(BadBatch { value: 1 });
    testing::assert_eq(testing::expect_err(a.add(a), "wrong output length").kind, ErrorKind::Shape);
    testing::assert_eq(testing::expect_ok(a.get_flat(0), "unchanged input").value, 1);
}

#[test]
fn scalar_operations_preserve_custom_limits_and_empty_zero_capacity_arrays() -> () {
    let dimensions = Vec::new();
    for _ in 0..40 {
        dimensions.push(1);
    }
    let limits = Limits { max_rank: 40, max_elements: 2 };
    let values = testing::expect_ok(Array::full_with_limits(dimensions, 2.0, limits), "high rank");
    let scaled = testing::expect_ok(
        testing::expect_ok(values.add_scalar(3.0), "add scalar").scale(2.0),
        "scale",
    );
    testing::assert_eq(scaled.ndim(), 40);
    near(testing::expect_ok(scaled.get_flat(0), "result"), 10.0);
    testing::assert_eq(scaled.limits().max_rank, 40);
    let empty = testing::expect_ok(
        Array::full_with_limits(Vec::from_array([0]), 1.0, Limits { max_rank: 1, max_elements: 0 }),
        "zero capacity",
    );
    testing::assert(testing::expect_ok(empty.scale(2.0), "empty scalar multiply").is_empty());
    let a = testing::expect_ok(
        Array::full_with_limits(
            Vec::from_array([2, 1]),
            1.0,
            Limits { max_rank: 2, max_elements: 2 },
        ),
        "bounded a",
    );
    let b = testing::expect_ok(Array::full(Vec::from_array([1, 2]), 2.0), "b");
    testing::assert_eq(
        testing::expect_err(a.add(b), "output exceeds smallest limit").kind,
        ErrorKind::Limit,
    );
    testing::assert_eq(
        testing::expect_err(a.reshape(Vec::from_array([1, 1, 2])), "rank limit").kind,
        ErrorKind::Limit,
    );
    let empty_large = testing::expect_ok(
        Array::full_with_limits(
            Vec::from_array([0, 9223372036854775807]),
            1.0,
            Limits { max_rank: 2, max_elements: 4 },
        ),
        "empty huge axis",
    );
    testing::assert_eq(
        testing::expect_err(empty_large.sum_axes(Vec::from_array([0]), false), "output limit").kind,
        ErrorKind::Limit,
    );
}
