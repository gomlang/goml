package ndarray;

fn batch_index(coordinates: Vec[isize], shape: Vec[isize]) -> isize {
    let mut index = 0;
    let padding = coordinates.len() - shape.len();
    for axis in 0..shape.len() {
        index = index * shape[axis]
            + if shape[axis] == 1 {
                0
            } else {
                coordinates[axis + padding]
            };
    }
    index
}

impl[T: Scalar] Array[T] {
    pub fn matmul(self: Array[T], other: Array[T]) -> Result[Array[T], Error] {
        self.matmul_with(other, Execution::Simd)
    }

    pub fn matmul_with(self: Array[T], other: Array[T], execution: Execution) -> Result[
        Array[T],
        Error,
    ] {
        if self.ndim() == 0 || other.ndim() == 0 {
            return Result::Err(
                Error::new(ErrorKind::Shape, "matmul requires rank-one or higher inputs"),
            )
        }
        let left_vector = self.ndim() == 1;
        let right_vector = other.ndim() == 1;
        let rows = if left_vector {
            1
        } else {
            self.dimensions[self.ndim() - 2]
        };
        let inner = self.dimensions[self.ndim() - 1];
        let right_inner = if right_vector {
            other.dimensions[0]
        } else {
            other.dimensions[other.ndim() - 2]
        };
        let columns = if right_vector {
            1
        } else {
            other.dimensions[other.ndim() - 1]
        };
        if inner != right_inner {
            return Result::Err(Error::new(ErrorKind::Shape, "matrix contraction dimensions differ"))
        }
        let left_batch = if left_vector {
            Vec::new()
        } else {
            self.dimensions.slice(0, self.ndim() - 2).to_vec()
        };
        let right_batch = if right_vector {
            Vec::new()
        } else {
            other.dimensions.slice(0, other.ndim() - 2).to_vec()
        };
        let batch = broadcast_shape(left_batch, right_batch)?;
        let shape = batch.copy();
        if !left_vector {
            shape.push(rows);
        }
        if !right_vector {
            shape.push(columns);
        }
        let limits = self.limits.intersect(other.limits);
        let length = shape_size(shape, limits)?;
        let output: Vec[T] = Vec::with_capacity(length);
        if length == 0 {
            return Result::Ok(owned(shape, output, limits))
        }
        let a = self.to_vec();
        let original_b = other.to_vec();
        let packed_b = Vec::with_capacity(original_b.len());
        let right_batches = shape_size(right_batch, other.limits)?;
        for group in 0..right_batches {
            let base = group * inner * columns;
            for column in 0..columns {
                for k in 0..inner {
                    packed_b.push(original_b[base + k * columns + column]);
                }
            }
        }
        let batches = shape_size(batch, limits)?;
        for group in 0..batches {
            let index = coordinates(group, batch);
            let a_base = batch_index(index, left_batch) * rows * inner;
            let b_base = batch_index(index, right_batch) * columns * inner;
            for row in 0..rows {
                for column in 0..columns {
                    let a_start = a_base + row * inner;
                    let b_start = b_base + column * inner;
                    output.push(
                        Scalar::dot_values(
                            a.slice(a_start, a_start + inner),
                            packed_b.slice(b_start, b_start + inner),
                            execution,
                        )?,
                    );
                }
            }
        }
        Result::Ok(owned(shape, output, limits))
    }

    pub fn eye(rows: isize, columns: isize, offset: isize) -> Result[Array[T], Error] {
        let array: Array[T] = Array::zeros(Vec::from_array([rows, columns]))?;
        array.diagonal(offset, 0, 1)?.fill(Scalar::one())?;
        Result::Ok(array)
    }
}
