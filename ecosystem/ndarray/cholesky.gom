package ndarray;

use std::math;

pub struct Cholesky {
    lower: Array[f64],
}

impl Array[f64] {
    pub fn cholesky(self: Array[f64], options: SolveOptions) -> Result[Cholesky, Error] {
        let (n, _, data) = matrix_values(self, true)?;
        let tolerance = options.threshold(data)?;
        for row in 0..n {
            for column in 0..row {
                if magnitude(data[row * n + column] - data[column * n + row]) > tolerance {
                    return Result::Err(
                        Error::new(
                            ErrorKind::NotPositiveDefinite,
                            "Cholesky requires a symmetric matrix",
                        ),
                    )
                }
            }
        }
        let lower = zeros(n * n);
        for row in 0..n {
            for column in 0..row + 1 {
                let mut value = data[row * n + column];
                for previous in 0..column {
                    value -= lower[row * n + previous] * lower[column * n + previous];
                }
                if !math::is_finite(value) {
                    return Result::Err(Error::new(ErrorKind::NonFinite, "Cholesky update overflow"))
                }
                if row == column {
                    if value <= tolerance {
                        return Result::Err(
                            Error::new(
                                ErrorKind::NotPositiveDefinite,
                                "matrix is not positive definite at the requested tolerance",
                            ),
                        )
                    }
                    lower[row * n + column] = math::sqrt(value);
                } else {
                    lower[row * n + column] = value / lower[column * n + column];
                }
            }
        }
        finite_values(lower)?;
        Result::Ok(Cholesky { lower: owned(self.dimensions, lower, self.limits) })
    }
}

impl Cholesky {
    pub fn lower(self: Cholesky) -> Array[f64] {
        self.lower.copy()
    }

    pub fn solve(self: Cholesky, rhs: Array[f64]) -> Result[Array[f64], Error] {
        let n = self.lower.dimensions[0];
        let (columns, _, output) = rhs_values(rhs, n)?;
        let limits = self.lower.limits.intersect(rhs.limits);
        let _ = shape_size(rhs.dimensions, limits)?;
        for row in 0..n {
            for previous in 0..row {
                for column in 0..columns {
                    output[row * columns + column] -= self.lower.data[row * n + previous]
                        * output[previous * columns + column];
                }
            }
            for column in 0..columns {
                output[row * columns + column] /= self.lower.data[row * n + row];
            }
        }
        let mut row = n;
        while row > 0 {
            row -= 1;
            for later in row + 1..n {
                for column in 0..columns {
                    output[row * columns + column] -= self.lower.data[later * n + row]
                        * output[later * columns + column];
                }
            }
            for column in 0..columns {
                output[row * columns + column] /= self.lower.data[row * n + row];
            }
        }
        finite_values(output)?;
        Result::Ok(owned(rhs.dimensions, output, limits))
    }

    pub fn slogdet(self: Cholesky) -> f64 {
        let n = self.lower.dimensions[0];
        let mut value = 0.0;
        for index in 0..n {
            value += 2.0 * math::log(self.lower.data[index * n + index]);
        }
        value
    }
}
