package ndarray;

use std::math;

pub struct SolveOptions {
    pub absolute_tolerance: f64,
    pub relative_tolerance: f64,
}

impl SolveOptions {
    pub fn standard() -> SolveOptions {
        SolveOptions { absolute_tolerance: 0.0, relative_tolerance: 1e-12 }
    }

    fn threshold(self: SolveOptions, values: Vec[f64]) -> Result[f64, Error] {
        if !math::is_finite(self.absolute_tolerance) || !math::is_finite(self.relative_tolerance)
            || self.absolute_tolerance < 0.0
            || self.relative_tolerance < 0.0 {
            return Result::Err(
                Error::new(ErrorKind::Arithmetic, "solve tolerances must be finite and nonnegative"),
            )
        }
        let mut scale = 0.0;
        for value in values {
            if magnitude(value) > scale {
                scale = magnitude(value);
            }
        }
        let tolerance = self.absolute_tolerance + self.relative_tolerance * scale;
        if !math::is_finite(tolerance) {
            return Result::Err(Error::new(ErrorKind::Arithmetic, "solve tolerance overflow"))
        }
        Result::Ok(tolerance)
    }
}

fn finite_values(values: Vec[f64]) -> Result[(), Error] {
    for value in values {
        if !math::is_finite(value) {
            return Result::Err(
                Error::new(
                    ErrorKind::NonFinite,
                    "linear algebra requires finite values and intermediates",
                ),
            )
        }
    }
    Result::Ok(())
}

fn matrix_values(array: Array[f64], square: bool) -> Result[(isize, isize, Vec[f64]), Error] {
    if array.ndim() != 2 {
        return Result::Err(Error::new(ErrorKind::Shape, "factorization requires a matrix"))
    }
    let rows = array.dimensions[0];
    let columns = array.dimensions[1];
    if square && rows != columns {
        return Result::Err(Error::new(ErrorKind::Shape, "matrix must be square"))
    }
    let values = array.to_vec();
    finite_values(values)?;
    Result::Ok((rows, columns, values))
}

fn rhs_values(array: Array[f64], rows: isize) -> Result[(isize, bool, Vec[f64]), Error] {
    if array.ndim() != 1 && array.ndim() != 2 {
        return Result::Err(
            Error::new(ErrorKind::Shape, "right-hand side must be a vector or matrix"),
        )
    }
    if array.dimensions[0] != rows {
        return Result::Err(Error::new(ErrorKind::Shape, "right-hand side row count differs"))
    }
    let columns = if array.ndim() == 1 {
        1
    } else {
        array.dimensions[1]
    };
    let values = array.to_vec();
    finite_values(values)?;
    Result::Ok((columns, array.ndim() == 1, values))
}

fn zeros(count: isize) -> Vec[f64] {
    let result = Vec::with_capacity(count);
    for _ in 0..count {
        result.push(0.0);
    }
    result
}

pub struct Lu {
    factors: Array[f64],
    permutation: Vec[isize],
    odd: bool,
}

impl Array[f64] {
    pub fn lu(self: Array[f64], options: SolveOptions) -> Result[Lu, Error] {
        let (n, _, data) = matrix_values(self, true)?;
        let tolerance = options.threshold(data)?;
        let permutation = Vec::new();
        for index in 0..n {
            permutation.push(index);
        }
        let mut odd = false;
        for column in 0..n {
            let mut pivot = column;
            for row in column + 1..n {
                if magnitude(data[row * n + column]) > magnitude(data[pivot * n + column]) {
                    pivot = row;
                }
            }
            if magnitude(data[pivot * n + column]) <= tolerance {
                return Result::Err(
                    Error::new(ErrorKind::Singular, "matrix is singular at the requested tolerance"),
                )
            }
            if pivot != column {
                for j in 0..n {
                    let previous = data[column * n + j];
                    data[column * n + j] = data[pivot * n + j];
                    data[pivot * n + j] = previous;
                }
                let previous = permutation[column];
                permutation[column] = permutation[pivot];
                permutation[pivot] = previous;
                odd = !odd;
            }
            for row in column + 1..n {
                let factor = data[row * n + column] / data[column * n + column];
                data[row * n + column] = factor;
                for j in column + 1..n {
                    let updated = data[row * n + j] - factor * data[column * n + j];
                    if !math::is_finite(updated) {
                        return Result::Err(
                            Error::new(ErrorKind::NonFinite, "LU elimination overflow"),
                        )
                    }
                    data[row * n + j] = updated;
                }
            }
        }
        Result::Ok(Lu { factors: owned(self.dimensions, data, self.limits), permutation, odd })
    }

    pub fn solve(self: Array[f64], rhs: Array[f64], options: SolveOptions) -> Result[
        Array[f64],
        Error,
    ] {
        self.lu(options)?.solve(rhs)
    }

    pub fn inverse(self: Array[f64], options: SolveOptions) -> Result[Array[f64], Error] {
        self.lu(options)?.inverse()
    }

    pub fn determinant(self: Array[f64]) -> Result[f64, Error] {
        match self.lu(SolveOptions { absolute_tolerance: 0.0, relative_tolerance: 0.0 }) {
            Ok(factors) => Result::Ok(factors.determinant()),
            Err(error) => if error.kind == ErrorKind::Singular {
                Result::Ok(0.0)
            } else {
                Result::Err(error)
            },
        }
    }

    pub fn slogdet(self: Array[f64]) -> Result[(f64, f64), Error] {
        match self.lu(SolveOptions { absolute_tolerance: 0.0, relative_tolerance: 0.0 }) {
            Ok(factors) => Result::Ok(factors.slogdet()),
            Err(error) => if error.kind == ErrorKind::Singular {
                Result::Ok((0.0, float64_from_bits(0xfff0000000000000)))
            } else {
                Result::Err(error)
            },
        }
    }
}

impl Lu {
    pub fn packed(self: Lu) -> Array[f64] {
        self.factors.copy()
    }

    pub fn permutation(self: Lu) -> Vec[isize] {
        self.permutation.copy()
    }

    pub fn lower(self: Lu) -> Array[f64] {
        let n = self.factors.dimensions[0];
        let data = zeros(n * n);
        for row in 0..n {
            for column in 0..n {
                data[row * n + column] = if row == column {
                    1.0
                } else if row > column {
                    self.factors.data[row * n + column]
                } else {
                    0.0
                };
            }
        }
        owned(self.factors.dimensions, data, self.factors.limits)
    }

    pub fn upper(self: Lu) -> Array[f64] {
        let n = self.factors.dimensions[0];
        let data = zeros(n * n);
        for row in 0..n {
            for column in row..n {
                data[row * n + column] = self.factors.data[row * n + column];
            }
        }
        owned(self.factors.dimensions, data, self.factors.limits)
    }

    pub fn solve(self: Lu, rhs: Array[f64]) -> Result[Array[f64], Error] {
        let n = self.factors.dimensions[0];
        let (columns, _, original) = rhs_values(rhs, n)?;
        let limits = self.factors.limits.intersect(rhs.limits);
        let _ = shape_size(rhs.dimensions, limits)?;
        let output = Vec::with_capacity(original.len());
        for row in 0..n {
            for column in 0..columns {
                output.push(original[self.permutation[row] * columns + column]);
            }
        }
        for row in 0..n {
            for previous in 0..row {
                for column in 0..columns {
                    output[row * columns + column] -= self.factors.data[row * n + previous]
                        * output[previous * columns + column];
                }
            }
        }
        let mut row = n;
        while row > 0 {
            row -= 1;
            for later in row + 1..n {
                for column in 0..columns {
                    output[row * columns + column] -= self.factors.data[row * n + later]
                        * output[later * columns + column];
                }
            }
            for column in 0..columns {
                output[row * columns + column] /= self.factors.data[row * n + row];
            }
        }
        finite_values(output)?;
        Result::Ok(owned(rhs.dimensions, output, limits))
    }

    pub fn inverse(self: Lu) -> Result[Array[f64], Error] {
        let n = self.factors.dimensions[0];
        let identity = Array::full_with_limits(Vec::from_array([n, n]), 0.0, self.factors.limits)?;
        identity.diagonal(0, 0, 1)?.fill(1.0)?;
        self.solve(identity)
    }

    pub fn determinant(self: Lu) -> f64 {
        let n = self.factors.dimensions[0];
        let mut value = if self.odd {
            -1.0
        } else {
            1.0
        };
        for index in 0..n {
            value *= self.factors.data[index * n + index];
        }
        value
    }

    pub fn slogdet(self: Lu) -> (f64, f64) {
        let n = self.factors.dimensions[0];
        let mut sign = if self.odd {
            -1.0
        } else {
            1.0
        };
        let mut logarithm = 0.0;
        for index in 0..n {
            let value = self.factors.data[index * n + index];
            if value < 0.0 {
                sign = -sign;
            }
            logarithm += math::log(magnitude(value));
        }
        let result = (sign, logarithm);
        result
    }
}
