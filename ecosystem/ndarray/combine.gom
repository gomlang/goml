package ndarray;

pub fn concatenate[T](arrays: Vec[Array[T]], axis: isize) -> Result[Array[T], Error] {
    if arrays.is_empty() {
        return Result::Err(Error::new(ErrorKind::Shape, "concatenate requires at least one array"))
    }
    let first = arrays[0];
    let axis = axis_index(axis, first.ndim())?;
    let shape = first.dimensions.copy();
    shape[axis] = 0;
    let mut limits = first.limits;
    for array in arrays {
        limits = limits.intersect(array.limits);
        if array.ndim() != first.ndim() {
            return Result::Err(Error::new(ErrorKind::Shape, "concatenate rank mismatch"))
        }
        for other in 0..shape.len() {
            if other != axis && array.dimensions[other] != shape[other] {
                return Result::Err(Error::new(ErrorKind::Shape, "concatenate dimensions differ"))
            }
        }
        if array.dimensions[axis] > 9223372036854775807 - shape[axis] {
            return Result::Err(Error::new(ErrorKind::Limit, "concatenate axis overflows"))
        }
        shape[axis] += array.dimensions[axis];
    }
    let length = shape_size(shape, limits)?;
    let values = Vec::with_capacity(length);
    for flat in 0..length {
        let index = coordinates(flat, shape);
        let mut selected = index[axis];
        for array in arrays {
            if selected < array.dimensions[axis] {
                index[axis] = selected;
                values.push(array.get(index)?);
                break;
            }
            selected -= array.dimensions[axis];
        }
    }
    Result::Ok(owned(shape, values, limits))
}

pub fn stack[T](arrays: Vec[Array[T]], axis: isize) -> Result[Array[T], Error] {
    if arrays.is_empty() {
        return Result::Err(Error::new(ErrorKind::Shape, "stack requires at least one array"))
    }
    let expanded = Vec::new();
    for array in arrays {
        if array.dimensions != arrays[0].dimensions {
            return Result::Err(Error::new(ErrorKind::Shape, "stack shapes differ"))
        }
        expanded.push(array.insert_axis(axis)?);
    }
    concatenate(expanded, axis)
}

impl[T] Array[T] {
    pub fn reduce_axes[U](
        self: Array[T],
        axes: Vec[isize],
        keep_dimensions: bool,
        reduce: (Slice[T]) -> Result[U, Error],
    ) -> Result[Array[U], Error] {
        let selected = Vec::new();
        for _ in self.dimensions {
            selected.push(false);
        }
        for axis in axes {
            let axis = axis_index(axis, self.ndim())?;
            if selected[axis] {
                return Result::Err(Error::new(ErrorKind::Axis, "reduction axis appears twice"))
            }
            selected[axis] = true;
        }
        let outer_shape = Vec::new();
        let inner_shape = Vec::new();
        let result_shape = Vec::new();
        for axis in 0..self.ndim() {
            if selected[axis] {
                inner_shape.push(self.dimensions[axis]);
                if keep_dimensions {
                    result_shape.push(1);
                }
            } else {
                outer_shape.push(self.dimensions[axis]);
                result_shape.push(self.dimensions[axis]);
            }
        }
        let groups = shape_size(outer_shape, self.limits)?;
        let count = shape_size(inner_shape, self.limits)?;
        let output = Vec::with_capacity(groups);
        for group in 0..groups {
            let outer = coordinates(group, outer_shape);
            let values = Vec::with_capacity(count);
            for item in 0..count {
                let inner = coordinates(item, inner_shape);
                let mut outer_axis = 0;
                let mut inner_axis = 0;
                let mut address = self.offset;
                for axis in 0..self.ndim() {
                    if selected[axis] {
                        address += inner[inner_axis] * self.steps[axis];
                        inner_axis += 1;
                    } else {
                        address += outer[outer_axis] * self.steps[axis];
                        outer_axis += 1;
                    }
                }
                values.push(self.data[address]);
            }
            output.push(reduce(values.as_slice())?);
        }
        Result::Ok(owned(result_shape, output, self.limits))
    }
}
