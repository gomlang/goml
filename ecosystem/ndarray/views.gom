package ndarray;

use std::num;

pub struct SliceSpec {
    pub start: Option[isize],
    pub stop: Option[isize],
    pub step: isize,
}

impl SliceSpec {
    pub fn all() -> SliceSpec {
        SliceSpec { start: Option::None, stop: Option::None, step: 1 }
    }

    pub fn reverse() -> SliceSpec {
        SliceSpec { step: -1, ..SliceSpec::all() }
    }

    pub fn between(start: isize, stop: isize) -> SliceSpec {
        SliceSpec { start: Option::Some(start), stop: Option::Some(stop), step: 1 }
    }
}

fn slice_bound(value: Option[isize], length: isize, step: isize, start: bool) -> isize {
    if let Some(value) = value {
        let value = if value < 0 {
            value + length
        } else {
            value
        };
        let lower = if step < 0 {
            -1
        } else {
            0
        };
        let upper = if step < 0 {
            length - 1
        } else {
            length
        };
        if value < lower {
            lower
        } else if value > upper {
            upper
        } else {
            value
        }
    } else if step < 0 {
        if start {
            length - 1
        } else {
            -1
        }
    } else {
        if start {
            0
        } else {
            length
        }
    }
}

impl[T] Array[T] {
    fn view(self: Array[T], shape: Vec[isize], steps: Vec[isize], offset: isize, writable: bool) -> Result[
        Array[T],
        Error,
    ] {
        let length = shape_size(shape, self.limits)?;
        Result::Ok(
            Array {
                dimensions: shape,
                steps: if length == 0 {
                    contiguous_steps(shape, 0)
                } else {
                    steps
                },
                offset: if length == 0 {
                    0
                } else {
                    offset
                },
                length,
                writable,
                ..self,
            },
        )
    }

    pub fn transpose(self: Array[T], axes: Vec[isize]) -> Result[Array[T], Error] {
        if axes.len() != self.ndim() {
            return Result::Err(
                Error::new(ErrorKind::Axis, "transpose requires a permutation of all axes"),
            )
        }
        let seen = Vec::new();
        for _ in axes {
            seen.push(false);
        }
        let shape = Vec::new();
        let steps = Vec::new();
        for axis in axes {
            let axis = axis_index(axis, self.ndim())?;
            if seen[axis] {
                return Result::Err(Error::new(ErrorKind::Axis, "transpose axis appears twice"))
            }
            seen[axis] = true;
            shape.push(self.dimensions[axis]);
            steps.push(self.steps[axis]);
        }
        self.view(shape, steps, self.offset, self.writable)
    }

    pub fn reversed_axes(self: Array[T]) -> Result[Array[T], Error] {
        let axes = Vec::new();
        for axis in 0..self.ndim() {
            axes.push(self.ndim() - axis - 1);
        }
        self.transpose(axes)
    }

    pub fn swap_axes(self: Array[T], first: isize, second: isize) -> Result[Array[T], Error] {
        let first = axis_index(first, self.ndim())?;
        let second = axis_index(second, self.ndim())?;
        let axes = Vec::new();
        for axis in 0..self.ndim() {
            axes.push(axis);
        }
        axes[first] = second;
        axes[second] = first;
        self.transpose(axes)
    }

    pub fn slice(self: Array[T], axis: isize, spec: SliceSpec) -> Result[Array[T], Error] {
        let axis = axis_index(axis, self.ndim())?;
        if spec.step == 0 {
            return Result::Err(Error::new(ErrorKind::Index, "slice step cannot be zero"))
        }
        let start = slice_bound(spec.start, self.dimensions[axis], spec.step, true);
        let stop = slice_bound(spec.stop, self.dimensions[axis], spec.step, false);
        let count = if spec.step > 0 {
            if stop <= start {
                0
            } else {
                1 + (stop - start - 1) / spec.step
            }
        } else {
            if start <= stop {
                0
            } else {
                1 + ((start - stop - 1).to_u64() / ((~spec.step.to_u64()) + 1)).to_isize()
            }
        };
        let shape = self.dimensions.copy();
        shape[axis] = count;
        if shape_size(shape, self.limits)? == 0 {
            return self.view(shape, self.steps.copy(), 0, self.writable)
        }
        let steps = self.steps.copy();
        let offset = self.offset + start * self.steps[axis];
        steps[axis] = if count <= 1 {
            0
        } else {
            num::checked_multiply_int64(self.steps[axis].to_i64(), spec.step.to_i64()).ok_or(
                Error::new(ErrorKind::Limit, "slice stride overflow"),
            )?.to_isize()
        };
        self.view(shape, steps, offset, self.writable)
    }

    pub fn index_axis(self: Array[T], axis: isize, index: isize) -> Result[Array[T], Error] {
        let axis = axis_index(axis, self.ndim())?;
        let index = item_index(index, self.dimensions[axis])?;
        let shape = self.dimensions.copy();
        let steps = self.steps.copy();
        let _ = shape.remove(axis);
        let _ = steps.remove(axis);
        self.view(shape, steps, self.offset + index * self.steps[axis], self.writable)
    }

    pub fn insert_axis(self: Array[T], axis: isize) -> Result[Array[T], Error] {
        let axis = axis_index(axis, self.ndim() + 1)?;
        let shape = Vec::new();
        let steps = Vec::new();
        for old in 0..self.ndim() + 1 {
            if old == axis {
                shape.push(1);
                steps.push(0);
            }
            if old < self.ndim() {
                shape.push(self.dimensions[old]);
                steps.push(self.steps[old]);
            }
        }
        self.view(shape, steps, self.offset, self.writable)
    }

    pub fn squeeze(self: Array[T]) -> Result[Array[T], Error] {
        let shape = Vec::new();
        let steps = Vec::new();
        for axis in 0..self.ndim() {
            if self.dimensions[axis] != 1 {
                shape.push(self.dimensions[axis]);
                steps.push(self.steps[axis]);
            }
        }
        self.view(shape, steps, self.offset, self.writable)
    }

    pub fn broadcast_to(self: Array[T], shape: Vec[isize]) -> Result[Array[T], Error] {
        let _ = shape_size(shape, self.limits)?;
        if shape.len() < self.ndim() {
            return Result::Err(Error::new(ErrorKind::Shape, "broadcast target has fewer axes"))
        }
        let steps = Vec::new();
        let mut writable = self.writable;
        let padding = shape.len() - self.ndim();
        for axis in 0..shape.len() {
            let original = if axis < padding {
                1
            } else {
                self.dimensions[axis - padding]
            };
            if original == shape[axis] && axis >= padding {
                steps.push(self.steps[axis - padding]);
            } else if original == 1 {
                steps.push(0);
                if shape[axis] > 1 {
                    writable = false;
                }
            } else {
                return Result::Err(
                    Error::new(ErrorKind::Shape, "cannot broadcast to requested shape"),
                )
            }
        }
        self.view(shape.copy(), steps, self.offset, writable)
    }

    pub fn take(self: Array[T], axis: isize, indices: Vec[isize]) -> Result[Array[T], Error] {
        let axis = axis_index(axis, self.ndim())?;
        let selected = Vec::new();
        for index in indices {
            selected.push(item_index(index, self.dimensions[axis])?);
        }
        let shape = self.dimensions.copy();
        shape[axis] = selected.len();
        let count = shape_size(shape, self.limits)?;
        let data = Vec::with_capacity(count);
        for flat in 0..count {
            let index = coordinates(flat, shape);
            index[axis] = selected[index[axis]];
            data.push(self.get(index)?);
        }
        Result::Ok(owned(shape, data, self.limits))
    }

    pub fn diagonal(self: Array[T], offset: isize, first: isize, second: isize) -> Result[
        Array[T],
        Error,
    ] {
        let first = axis_index(first, self.ndim())?;
        let second = axis_index(second, self.ndim())?;
        if first == second {
            return Result::Err(Error::new(ErrorKind::Axis, "diagonal requires distinct axes"))
        }
        let a = self.dimensions[first];
        let b = self.dimensions[second];
        let row = if offset < 0 {
            if offset <= -a {
                a
            } else {
                -offset
            }
        } else {
            0
        };
        let column = if offset > 0 {
            minimum(offset, b)
        } else {
            0
        };
        let count = minimum(a - row, b - column);
        let shape = Vec::new();
        let steps = Vec::new();
        for axis in 0..self.ndim() {
            if axis != first && axis != second {
                shape.push(self.dimensions[axis]);
                steps.push(self.steps[axis]);
            }
        }
        shape.push(count);
        if shape_size(shape, self.limits)? == 0 {
            steps.push(0);
            return self.view(shape, steps, 0, self.writable)
        }
        let stride = if count <= 1 {
            0
        } else {
            num::checked_add_int64(self.steps[first].to_i64(), self.steps[second].to_i64()).ok_or(
                Error::new(ErrorKind::Limit, "diagonal stride overflow"),
            )?.to_isize()
        };
        steps.push(stride);
        self.view(
            shape,
            steps,
            self.offset + row * self.steps[first] + column * self.steps[second],
            self.writable,
        )
    }
}
