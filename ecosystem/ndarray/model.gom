package ndarray;

#[derive(Debug, PartialEq)]
pub enum ErrorKind {
    Shape,
    Axis,
    Index,
    Limit,
    ReadOnly,
    NonContiguous,
    Arithmetic,
    Empty,
    Singular,
    NonFinite,
    NotPositiveDefinite,
}

pub struct Error {
    pub kind: ErrorKind,
    pub message: string,
}

impl Error {
    pub fn new(kind: ErrorKind, message: string) -> Error {
        Error { kind, message }
    }
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        self.message
    }
}

impl Debug for Error {
    fn debug(self: Error) -> string {
        self.message
    }
}

pub struct Limits {
    pub max_rank: isize,
    pub max_elements: isize,
}

impl Limits {
    pub fn standard() -> Limits {
        Limits { max_rank: 32, max_elements: 16777216 }
    }

    fn validate(self: Limits) -> Result[(), Error] {
        if self.max_rank < 0 || self.max_rank > 1024 || self.max_elements < 0 {
            Result::Err(Error::new(ErrorKind::Limit, "invalid array limits"))
        } else {
            Result::Ok(())
        }
    }

    fn intersect(self: Limits, other: Limits) -> Limits {
        Limits {
            max_rank: minimum(self.max_rank, other.max_rank),
            max_elements: minimum(self.max_elements, other.max_elements),
        }
    }
}

pub struct Array[T] {
    data: Vec[T],
    identity: Ref[bool],
    dimensions: Vec[isize],
    steps: Vec[isize],
    offset: isize,
    length: isize,
    writable: bool,
    limits: Limits,
}

fn minimum(a: isize, b: isize) -> isize {
    if a < b {
        a
    } else {
        b
    }
}

fn shape_size(shape: Vec[isize], limits: Limits) -> Result[isize, Error] {
    limits.validate()?;
    if shape.len() > limits.max_rank {
        return Result::Err(Error::new(ErrorKind::Limit, "array rank exceeds limit"))
    }
    let mut empty = false;
    for dimension in shape {
        if dimension < 0 {
            return Result::Err(Error::new(ErrorKind::Shape, "dimensions must be nonnegative"))
        }
        if dimension == 0 {
            empty = true;
        }
    }
    if empty {
        return Result::Ok(0)
    }
    let mut length = 1;
    for dimension in shape {
        if length > limits.max_elements / dimension {
            return Result::Err(Error::new(ErrorKind::Limit, "array element count exceeds limit"))
        }
        length *= dimension;
    }
    if length > limits.max_elements {
        return Result::Err(Error::new(ErrorKind::Limit, "array element count exceeds limit"))
    }
    Result::Ok(length)
}

fn contiguous_steps(shape: Vec[isize], length: isize) -> Vec[isize] {
    let steps = Vec::new();
    for _ in shape {
        steps.push(0);
    }
    if length == 0 {
        return steps
    }
    let mut stride = 1;
    let mut axis = shape.len();
    while axis > 0 {
        axis -= 1;
        steps[axis] = stride;
        stride *= shape[axis];
    }
    steps
}

fn axis_index(axis: isize, rank: isize) -> Result[isize, Error] {
    let normalized = if axis < 0 {
        axis + rank
    } else {
        axis
    };
    if normalized < 0 || normalized >= rank {
        Result::Err(Error::new(ErrorKind::Axis, "axis outside array rank"))
    } else {
        Result::Ok(normalized)
    }
}

fn item_index(index: isize, length: isize) -> Result[isize, Error] {
    let normalized = if index < 0 {
        index + length
    } else {
        index
    };
    if normalized < 0 || normalized >= length {
        Result::Err(Error::new(ErrorKind::Index, "array index out of range"))
    } else {
        Result::Ok(normalized)
    }
}

fn coordinates(flat: isize, shape: Vec[isize]) -> Vec[isize] {
    let result = Vec::new();
    for _ in shape {
        result.push(0);
    }
    let mut remaining = flat;
    let mut axis = shape.len();
    while axis > 0 {
        axis -= 1;
        result[axis] = remaining % shape[axis];
        remaining /= shape[axis];
    }
    result
}

fn inferred_shape(shape: Vec[isize], length: isize, limits: Limits) -> Result[Vec[isize], Error] {
    let result = shape.copy();
    let mut inferred = Option::None;
    for axis in 0..result.len() {
        if result[axis] == -1 {
            if inferred.is_some() {
                return Result::Err(
                    Error::new(ErrorKind::Shape, "only one dimension may be inferred"),
                )
            }
            inferred = Option::Some(axis);
            result[axis] = 1;
        }
    }
    let count = shape_size(result, Limits { max_elements: 9223372036854775807, ..limits })?;
    if let Some(axis) = inferred {
        if count == 0 || length % count != 0 {
            return Result::Err(Error::new(ErrorKind::Shape, "cannot infer reshape dimension"))
        }
        result[axis] = length / count;
    }
    if shape_size(result, limits)? != length {
        return Result::Err(Error::new(ErrorKind::Shape, "reshape changes element count"))
    }
    Result::Ok(result)
}

pub fn broadcast_shape(left: Vec[isize], right: Vec[isize]) -> Result[Vec[isize], Error] {
    let rank = if left.len() > right.len() {
        left.len()
    } else {
        right.len()
    };
    let result = Vec::new();
    for axis in 0..rank {
        let a = if axis < rank - left.len() {
            1
        } else {
            left[axis - (rank - left.len())]
        };
        let b = if axis < rank - right.len() {
            1
        } else {
            right[axis - (rank - right.len())]
        };
        if a < 0 || b < 0 {
            return Result::Err(
                Error::new(ErrorKind::Shape, "broadcast dimensions must be nonnegative"),
            )
        }
        result.push(
            if a == b {
                a
            } else if a == 1 {
                b
            } else if b == 1 {
                a
            } else {
                return Result::Err(
                    Error::new(ErrorKind::Shape, "incompatible broadcast dimensions"),
                )
            },
        );
    }
    Result::Ok(result)
}

fn owned[T](shape: Vec[isize], data: Vec[T], limits: Limits) -> Array[T] {
    Array {
        data,
        identity: Ref::new(false),
        dimensions: shape.copy(),
        steps: contiguous_steps(shape, data.len()),
        offset: 0,
        length: data.len(),
        writable: true,
        limits,
    }
}
