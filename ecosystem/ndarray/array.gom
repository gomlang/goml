package ndarray;

impl[T] Array[T] {
    pub fn from_vec(shape: Vec[isize], values: Vec[T]) -> Result[Array[T], Error] {
        Array::from_vec_with_limits(shape, values, Limits::standard())
    }

    pub fn from_vec_with_limits(shape: Vec[isize], values: Vec[T], limits: Limits) -> Result[
        Array[T],
        Error,
    ] {
        let length = shape_size(shape, limits)?;
        if length != values.len() {
            return Result::Err(Error::new(ErrorKind::Shape, "shape does not match input length"))
        }
        Result::Ok(owned(shape, values.copy(), limits))
    }

    pub fn full(shape: Vec[isize], value: T) -> Result[Array[T], Error] {
        Array::full_with_limits(shape, value, Limits::standard())
    }

    pub fn full_with_limits(shape: Vec[isize], value: T, limits: Limits) -> Result[Array[T], Error] {
        let length = shape_size(shape, limits)?;
        let data = Vec::with_capacity(length);
        for _ in 0..length {
            data.push(value);
        }
        Result::Ok(owned(shape, data, limits))
    }

    pub fn scalar(value: T) -> Array[T] {
        owned(Vec::new(), Vec::from_array([value]), Limits::standard())
    }

    pub fn shape(self: Array[T]) -> Vec[isize] {
        self.dimensions.copy()
    }

    pub fn strides(self: Array[T]) -> Vec[isize] {
        self.steps.copy()
    }

    pub fn ndim(self: Array[T]) -> isize {
        self.dimensions.len()
    }

    pub fn size(self: Array[T]) -> isize {
        self.length
    }

    pub fn is_empty(self: Array[T]) -> bool {
        self.length == 0
    }

    pub fn is_writable(self: Array[T]) -> bool {
        self.writable
    }

    pub fn limits(self: Array[T]) -> Limits {
        self.limits
    }

    pub fn shares_storage(self: Array[T], other: Array[T]) -> bool {
        ptr_eq(self.identity, other.identity)
    }

    pub fn is_contiguous(self: Array[T]) -> bool {
        if self.length == 0 {
            return true
        }
        let mut expected = 1;
        let mut axis = self.ndim();
        while axis > 0 {
            axis -= 1;
            if self.dimensions[axis] > 1 && self.steps[axis] != expected {
                return false
            }
            expected *= self.dimensions[axis];
        }
        true
    }

    fn address(self: Array[T], indices: Vec[isize]) -> Result[isize, Error] {
        if indices.len() != self.ndim() {
            return Result::Err(Error::new(ErrorKind::Index, "index rank differs from array rank"))
        }
        let mut address = self.offset;
        for axis in 0..indices.len() {
            address += item_index(indices[axis], self.dimensions[axis])? * self.steps[axis];
        }
        Result::Ok(address)
    }

    fn position(self: Array[T], flat: isize) -> isize {
        if self.is_contiguous() {
            return self.offset + flat
        }
        let mut remaining = flat;
        let mut address = self.offset;
        let mut axis = self.ndim();
        while axis > 0 {
            axis -= 1;
            address += (remaining % self.dimensions[axis]) * self.steps[axis];
            remaining /= self.dimensions[axis];
        }
        address
    }

    fn value(self: Array[T], flat: isize) -> T {
        self.data[self.position(flat)]
    }

    pub fn get(self: Array[T], indices: Vec[isize]) -> Result[T, Error] {
        Result::Ok(self.data[self.address(indices)?])
    }

    pub fn get_flat(self: Array[T], index: isize) -> Result[T, Error] {
        Result::Ok(self.value(item_index(index, self.length)?))
    }

    pub fn set(self: Array[T], indices: Vec[isize], value: T) -> Result[(), Error] {
        if !self.writable {
            return Result::Err(Error::new(ErrorKind::ReadOnly, "array view is read-only"))
        }
        let position = self.address(indices)?;
        self.data[position] = value;
        Result::Ok(())
    }

    pub fn set_flat(self: Array[T], index: isize, value: T) -> Result[(), Error] {
        if !self.writable {
            return Result::Err(Error::new(ErrorKind::ReadOnly, "array view is read-only"))
        }
        let position = self.position(item_index(index, self.length)?);
        self.data[position] = value;
        Result::Ok(())
    }

    pub fn to_vec(self: Array[T]) -> Vec[T] {
        let result = Vec::with_capacity(self.length);
        for flat in 0..self.length {
            result.push(self.value(flat));
        }
        result
    }

    pub fn copy(self: Array[T]) -> Array[T] {
        owned(self.dimensions, self.to_vec(), self.limits)
    }

    pub fn as_slice(self: Array[T]) -> Option[Slice[T]] {
        if self.is_contiguous() {
            Option::Some(self.data.slice(self.offset, self.offset + self.length))
        } else {
            Option::None
        }
    }

    pub fn as_mut_slice(self: Array[T]) -> Result[MutSlice[T], Error] {
        if !self.writable {
            return Result::Err(Error::new(ErrorKind::ReadOnly, "array view is read-only"))
        }
        if !self.is_contiguous() {
            return Result::Err(Error::new(ErrorKind::NonContiguous, "array is not contiguous"))
        }
        Result::Ok(self.data.as_mut_slice().sub(self.offset, self.offset + self.length))
    }

    pub fn reshape_view(self: Array[T], shape: Vec[isize]) -> Result[Array[T], Error] {
        let shape = inferred_shape(shape, self.length, self.limits)?;
        if !self.is_contiguous() {
            return Result::Err(
                Error::new(ErrorKind::NonContiguous, "reshape_view requires contiguous data"),
            )
        }
        Result::Ok(Array { dimensions: shape, steps: contiguous_steps(shape, self.length), ..self })
    }

    pub fn reshape(self: Array[T], shape: Vec[isize]) -> Result[Array[T], Error] {
        if self.is_contiguous() {
            self.reshape_view(shape)
        } else {
            self.copy().reshape_view(shape)
        }
    }

    pub fn ravel(self: Array[T]) -> Result[Array[T], Error] {
        self.reshape(Vec::from_array([self.length]))
    }

    pub fn flatten(self: Array[T]) -> Result[Array[T], Error] {
        self.copy().reshape_view(Vec::from_array([self.length]))
    }

    pub fn fill(self: Array[T], value: T) -> Result[(), Error] {
        if !self.writable {
            return Result::Err(Error::new(ErrorKind::ReadOnly, "array view is read-only"))
        }
        for flat in 0..self.length {
            self.data[self.position(flat)] = value;
        }
        Result::Ok(())
    }

    pub fn assign(self: Array[T], source: Array[T]) -> Result[(), Error] {
        if !self.writable {
            return Result::Err(Error::new(ErrorKind::ReadOnly, "array view is read-only"))
        }
        let source = source.broadcast_to(self.dimensions)?;
        let snapshot = source.to_vec();
        for flat in 0..self.length {
            self.data[self.position(flat)] = snapshot[flat];
        }
        Result::Ok(())
    }

    pub fn map[U](self: Array[T], mapper: (T) -> U) -> Array[U] {
        let result = Vec::with_capacity(self.length);
        for flat in 0..self.length {
            result.push(mapper(self.value(flat)));
        }
        owned(self.dimensions, result, self.limits)
    }

    pub fn map_indexed[U](self: Array[T], mapper: (Vec[isize], T) -> U) -> Array[U] {
        let result = Vec::with_capacity(self.length);
        for flat in 0..self.length {
            result.push(mapper(coordinates(flat, self.dimensions), self.value(flat)));
        }
        owned(self.dimensions, result, self.limits)
    }

    pub fn zip_map[U, V](self: Array[T], other: Array[U], mapper: (T, U) -> V) -> Result[
        Array[V],
        Error,
    ] {
        let shape = broadcast_shape(self.dimensions, other.dimensions)?;
        let limits = self.limits.intersect(other.limits);
        let length = shape_size(shape, limits)?;
        let left = self.broadcast_to(shape)?;
        let right = other.broadcast_to(shape)?;
        let result = Vec::with_capacity(length);
        for index in 0..length {
            result.push(mapper(left.value(index), right.value(index)));
        }
        Result::Ok(owned(shape, result, limits))
    }
}
