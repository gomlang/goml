package parser;

pub struct ParseLimits {
    pub max_depth: isize,
    pub max_work: isize,
}

impl ParseLimits {
    pub fn standard() -> ParseLimits {
        ParseLimits { max_depth: 256, max_work: 1000000 }
    }
}

pub struct ParseContext {
    limits: ParseLimits,
    remaining: Ref[isize],
    depth_value: isize,
    peak: Ref[isize],
    failure: Ref[Option[Error]],
}

impl ParseContext {
    pub fn new(limits: ParseLimits) -> Result[ParseContext, Error] {
        if limits.max_depth < 1 || limits.max_depth > 4096 || limits.max_work < 0 {
            return Result::Err(
                Error {
                    offset: 0,
                    expected: "parser depth 1 through 4096 and nonnegative work budget",
                    committed: true,
                },
            )
        }
        Result::Ok(
            ParseContext {
                limits,
                remaining: Ref::new(limits.max_work),
                depth_value: 0,
                peak: Ref::new(0),
                failure: Ref::new(Option::None),
            },
        )
    }

    fn stop(self: ParseContext, offset: isize, expected: string) -> Error {
        let problem = Error { offset, expected, committed: true };
        self.failure.set(Option::Some(problem));
        problem
    }

    pub fn charge(self: ParseContext, amount: isize, offset: isize) -> Result[(), Error] {
        if let Some(problem) = self.failure.get() {
            return Result::Err(problem)
        }
        if amount < 0 || amount > self.remaining.get() {
            return Result::Err(self.stop(offset, "parser work budget exceeded"))
        }
        self.remaining.set(self.remaining.get() - amount);
        Result::Ok(())
    }

    pub fn nested(self: ParseContext, offset: isize) -> Result[ParseContext, Error] {
        self.charge(1, offset)?;
        if self.depth_value >= self.limits.max_depth {
            return Result::Err(self.stop(offset, "parser nesting limit exceeded"))
        }
        let depth = self.depth_value + 1;
        if depth > self.peak.get() {
            self.peak.set(depth);
        }
        Result::Ok(ParseContext { depth_value: depth, ..self })
    }

    pub fn limit_error(self: ParseContext) -> Option[Error] {
        self.failure.get()
    }

    pub fn work_used(self: ParseContext) -> isize {
        self.limits.max_work - self.remaining.get()
    }

    pub fn peak_depth(self: ParseContext) -> isize {
        self.peak.get()
    }
}
