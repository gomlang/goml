package tests;

use ecosystem::parser;
use ecosystem::parser::binary;
use std::bytes::endian;
use std::testing;

#[test]
fn lists_and_bounds() -> () {
    let list = parser::integer().separated(parser::literal(","), 1, false);
    equal(testing::expect_ok(list.parse("1,-2,3"), "list"), Vec::from_array([1, -2, 3]));
    testing::assert_err(list.parse("1,"));
    testing::assert_err(list.parse(""));
    let trailing = parser::integer().separated(parser::literal(","), 0, true);
    equal(testing::expect_ok(trailing.parse("1,"), "trailing list").len(), 1);
    equal(testing::expect_ok(trailing.parse(""), "empty list").len(), 0);
    testing::assert_err(parser::pure(1).separated(parser::pure(()), 0, false).parse(""));
    testing::assert_err(parser::literal("x").repeat(3, 2).parse("xx"));
    equal(testing::expect_ok(parser::literal("x").repeat(2, 3).parse("xxx"), "repeat").len(), 3);
    testing::assert_err(parser::literal("x").many1().parse(""));
}

#[test]
fn unicode_text_spans_and_errors() -> () {
    let parsed = testing::expect_ok(parser::identifier().spanned().parse("你好_42"), "identifier");
    equal(parsed.0, "你好_42");
    equal(parsed.1, parser::Span { start: 0, end: 9 });
    equal(testing::expect_ok(parser::quoted('"').parse("\"你好\\n\\\"x\""), "quoted"), "你好\n\"x");
    testing::assert_err(parser::quoted('"').parse("\"bad\\z\""));
    testing::assert_err(parser::quoted('"').parse("\"unclosed"));
    testing::assert_err(parser::any_char().parse_at("你好", 1));
    let problem = testing::expect_err(
        parser::literal("first\n").right(parser::integer().context("port")).parse("first\nx"),
        "context",
    );
    equal(problem.render("first\nx"), "2:1: expected port: decimal digit\nx\n^");
    equal(parser::error(3, "digit").render("你x"), "1:2: expected digit\n你x\n ^");
}

#[test]
fn lookahead_dependent_parsing_and_validation() -> () {
    let guarded = parser::literal("let").left(
        parser::satisfy(|c| c == '_' || c == 'x', "continuation").not("keyword boundary"),
    );
    equal(testing::expect_ok(guarded.parse_prefix("let rest"), "keyword"), ("let", " rest"));
    testing::assert_err(guarded.parse("letx"));
    equal(
        testing::expect_ok(
            parser::literal("a").peek().then(parser::literal("a")).parse("a"),
            "peek",
        ),
        ("a", "a"),
    );
    equal(
        testing::expect_ok(
            parser::literal("a").cut().attempt().or(parser::literal("b")).parse("b"),
            "attempt",
        ),
        "b",
    );
    let repeated = parser::integer().left(parser::literal(":")).and_then(
        |count| parser::any_char().repeat(count, count),
    );
    equal(testing::expect_ok(repeated.parse("2:你好"), "dependent").len(), 2);
    testing::assert_err(parser::integer().verify(|n| n >= 0 && n < 256, "byte").parse("256"));
}

#[test]
fn associativity_and_numbers() -> () {
    let left = parser::integer().chain_left(parser::literal("-"), |a, _, b| a - b);
    let right = parser::integer().chain_right(parser::literal("-"), |a, _, b| a - b);
    equal(testing::expect_ok(left.parse("10-3-2"), "left"), 5);
    equal(testing::expect_ok(right.parse("10-3-2"), "right"), 9);
    testing::assert_err(left.parse("10-"));
    equal(testing::expect_ok(parser::decimal().parse("-1.25e+2"), "float"), -125.0);
    testing::assert_err(parser::decimal().parse("1e"));
    testing::assert_err(parser::decimal().parse("1."));
}

#[test]
fn binary_fragmentation_and_limits() -> () {
    let frame = binary::literal(b"GO".as_slice()).right(
        binary::length_prefixed(binary::uint16(endian::Endian::Big).map(|n| n.to_isize()), 10),
    );
    let data = b"GO\x00\x03abc";
    for length in 0..data.len() {
        let problem = testing::expect_err(frame.parse(data.slice(0, length)), "fragment");
        match problem {
            binary::Error::Incomplete { offset, needed } => {
                equal(offset, length);
                testing::assert(needed > 0);
            },
            _ => testing::fail("valid prefix must request more input"),
        }
    }
    equal(testing::expect_ok(frame.parse(data.as_slice()), "frame").to_vec(), b"abc");
    testing::assert_err(frame.parse(b"GO\xFF\xFF".as_slice()));
    testing::assert_err(frame.parse(b"NO\x00\x00".as_slice()));
    equal(
        testing::expect_ok(
            binary::int16(endian::Endian::Little).parse(b"\xFF\xFF".as_slice()),
            "signed",
        ),
        -1,
    );
    testing::assert_err(binary::take(-1).parse(data.as_slice()));
}

fn equal[T: PartialEq](actual: T, expected: T) -> () {
    testing::assert(actual == expected)
}
