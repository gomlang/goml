package tests;

use ecosystem::parser;
use ecosystem::parser::arithmetic;
use std::testing;

#[test]
fn recursive_expression() -> () {
    testing::assert_eq(
        testing::expect_ok(arithmetic::expression().parse(" 2 * (3 + 4) - 1 "), "expression"),
        13,
    );
    let problem = testing::expect_err(arithmetic::expression().parse("1 + )"), "missing operand");
    testing::assert_eq(problem.offset, 4);
    testing::assert(problem.committed);
    testing::assert_err(arithmetic::expression().parse("(2 + 3"));
    testing::assert_err(arithmetic::expression().parse("999999999999999999999999"));
}

#[test]
fn backtracking_and_furthest_error() -> () {
    let value = parser::literal("ab").right(parser::literal("c")).or(parser::literal("abx"));
    testing::assert_eq(testing::expect_ok(value.parse("abx"), "alternative"), "abx");
    testing::assert_eq(testing::expect_err(value.parse("aby"), "error").offset, 2);
    testing::assert_err(parser::literal("a").cut().or(parser::literal("b")).parse("b"));
}

#[test]
fn empty_repetition_is_rejected() -> () {
    testing::assert_err(parser::pure(1).many().parse(""));
    testing::assert_eq(
        testing::expect_ok(parser::literal("x").many().parse("xxx"), "repetition").len(),
        3,
    );
    testing::assert_eq(
        testing::expect_ok(parser::literal("x").optional().parse(""), "optional").is_none(),
        true,
    );
}

#[test]
fn captured_generic_transform_and_unicode_offsets() -> () {
    let suffix = "!";
    let value = parser::literal("你好").map(|text| text + suffix);
    testing::assert_eq(testing::expect_ok(value.parse("你好"), "unicode"), "你好!");
    testing::assert_eq(testing::expect_err(value.parse("你好x"), "trailing").offset, 6);
    testing::assert_err(value.parse_at("你好", -1));
    let invalid = parser::Parser::new(|_, offset| Result::Ok((42, offset - 1)));
    testing::assert_err(invalid.parse(""));
}
