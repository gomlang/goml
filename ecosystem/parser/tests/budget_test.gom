package tests;

use ecosystem::parser;
use ecosystem::parser::binary;
use std::testing;

fn recursive_text() -> parser::Parser[()] {
    parser::lazy(recursive_text)
}

fn recursive_binary() -> binary::Parser[()] {
    binary::lazy(recursive_binary)
}

#[test]
fn recursive_parsers_fail_recoverably_at_shared_depth_limit() -> () {
    let limits = parser::ParseLimits { max_depth: 20, max_work: 1000 };
    let context = testing::expect_ok(parser::ParseContext::new(limits), "context");
    let problem = testing::expect_err(recursive_text().parse_in(context, "", 0), "left recursion");
    testing::assert_eq(problem.expected, "parser nesting limit exceeded");
    testing::assert(problem.committed);
    testing::assert_eq(context.peak_depth(), 20);
    testing::assert_eq(context.work_used(), 21);
    let problem = testing::expect_err(
        recursive_binary().parse_with_limits(b"".as_slice(), limits),
        "binary recursion",
    );
    testing::assert(
        match problem {
            binary::Error::Invalid(problem) => problem.expected == "parser nesting limit exceeded"
                && problem.committed,
            _ => false,
        },
    );
    testing::assert_err(parser::ParseContext::new(parser::ParseLimits { max_depth: 0, ..limits }));
}

#[test]
fn work_limits_survive_backtracking_repetition_and_error_relabeling() -> () {
    let limits = parser::ParseLimits { max_depth: 100, max_work: 40 };
    let parser = parser::literal("x").many().attempt().label("renamed").optional();
    let problem = testing::expect_err(
        parser.parse_with_limits("x".repeat(100), limits),
        "bounded repetition",
    );
    testing::assert_eq(problem.expected, "parser work budget exceeded");
    testing::assert(problem.committed);
    let alternatives = Vec::new();
    for _ in 0..500 {
        alternatives.push(parser::literal("no"));
    }
    alternatives.push(parser::literal("yes"));
    testing::assert_err(parser::choice(alternatives).parse_with_limits("yes", limits));
    let context = testing::expect_ok(parser::ParseContext::new(limits), "context");
    let greedy = parser::take_while(|_| true, 0, "bytes");
    let problem = testing::expect_err(
        greedy.parse_in(context, "x".repeat(100), 0),
        "primitive budget",
    );
    testing::assert_eq(problem.offset, 39);
    testing::assert_eq(context.work_used(), 40);
    testing::assert_err(parser::pure(1).parse_in(context, "", 0));
    testing::assert_ok(parser::literal("ok").parse_with_limits("ok", limits));
    let tolerant = parser::Parser::with_context(
        |context, _, offset| {
            let _ = context.charge(1000, offset);
            Result::Ok(((), offset))
        },
    );
    testing::assert_err(tolerant.parse_with_limits("", limits));
}

#[test]
fn explicit_context_tracks_siblings_and_custom_nested_parsers() -> () {
    let parser = parser::Parser::with_context(
        |context, input, offset| {
            parser::literal("a").then(parser::literal("b")).parse_in(context, input, offset)
        },
    );
    let context = testing::expect_ok(
        parser::ParseContext::new(parser::ParseLimits { max_depth: 3, max_work: 6 }),
        "context",
    );
    let parsed = testing::expect_ok(parser.parse_in(context, "ab", 0), "nested context");
    testing::assert_eq(parsed.1, 2);
    testing::assert_eq(context.peak_depth(), 3);
    testing::assert_eq(context.work_used(), 6);
    testing::assert_none(context.limit_error());
    testing::assert_err(
        parser.parse_with_limits("ab", parser::ParseLimits { max_depth: 3, max_work: 5 }),
    );
}

#[test]
fn binary_alternatives_preserve_incomplete_input_and_committed_errors() -> () {
    let first = binary::literal(b"AB".as_slice());
    let second = binary::literal(b"AX".as_slice());
    let parser = first.or(second);
    let incomplete = testing::expect_err(parser.parse(b"A".as_slice()), "partial prefix");
    testing::assert(
        match incomplete {
            binary::Error::Incomplete { offset, needed } => offset == 1 && needed == 1,
            _ => false,
        },
    );
    testing::assert_ok(parser.parse(b"AX".as_slice()));
    testing::assert_err(first.cut().or(second).parse(b"AX".as_slice()));
    testing::assert_ok(first.cut().attempt().or(second).parse(b"AX".as_slice()));
    testing::assert_err(first.optional().parse(b"A".as_slice()));
    testing::assert_none(
        testing::expect_ok(first.optional().parse_at(b"Q".as_slice(), 0), "optional mismatch").0,
    );
    testing::assert_ok(first.peek().right(first).parse(b"AB".as_slice()));
    testing::assert_err(first.not("different").parse(b"A".as_slice()));
    let limits = parser::ParseLimits { max_depth: 64, max_work: 10 };
    let repeated = binary::byte_value().repeat(100, 100).attempt().optional();
    let problem = testing::expect_err(
        repeated.parse_with_limits("x".repeat(100).to_bytes().as_slice(), limits),
        "binary work limit",
    );
    testing::assert(
        match problem {
            binary::Error::Invalid(problem) => problem.expected == "parser work budget exceeded"
                && problem.committed,
            _ => false,
        },
    );
}
