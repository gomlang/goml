package parser;

#[derive(Debug, PartialEq)]
pub struct Span {
    pub start: isize,
    pub end: isize,
}

impl Error {
    pub fn render(self: Error, input: string) -> string {
        let mut offset = if self.offset < 0 {
            0
        } else if self.offset > input.byte_len() {
            input.byte_len()
        } else {
            self.offset
        };
        while offset > 0 && !input.is_char_boundary(offset) {
            offset -= 1;
        }
        let mut start = 0;
        let mut line = 1;
        for index in 0..offset {
            if input.byte_get(index) == b'\n' {
                start = index + 1;
                line += 1;
            }
        }
        let mut end = offset;
        while end < input.byte_len() && input.byte_get(end) != b'\n' {
            end += 1;
        }
        let column = input.byte_slice(start, offset).char_count() + 1;
        f"{line}:{column}: expected {self.expected}\n" + input.byte_slice(start, end) + "\n"
            + " ".repeat(column - 1)
            + "^"
    }
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        f"byte {self.offset}: expected {self.expected}"
    }
}

impl[T] Parser[T] {
    pub fn parse_prefix(self: Parser[T], input: string) -> Result[(T, string), Error] {
        let (value, next) = self.parse_at(input, 0)?;
        Result::Ok((value, input.byte_slice(next, input.byte_len())))
    }

    pub fn try_map[U](self: Parser[T], transform: (T) -> Result[U, string]) -> Parser[U] {
        Parser::new(
            |input, offset| {
                let (value, next) = self.parse_at(input, offset)?;
                match transform(value) {
                    Ok(mapped) => Result::Ok((mapped, next)),
                    Err(message) => Result::Err(error(offset, message)),
                }
            },
        )
    }

    pub fn and_then[U](self: Parser[T], build: (T) -> Parser[U]) -> Parser[U] {
        Parser::new(
            |input, offset| {
                let (value, next) = self.parse_at(input, offset)?;
                build(value).parse_at(input, next)
            },
        )
    }

    pub fn verify(self: Parser[T], accept: (T) -> bool, expected: string) -> Parser[T] {
        self.try_map(
            |value| if accept(value) {
                Result::Ok(value)
            } else {
                Result::Err(expected)
            },
        )
    }

    pub fn label(self: Parser[T], expected: string) -> Parser[T] {
        Parser::new(
            |input, offset| {
                self.parse_at(input, offset).map_err(
                    |problem| {
                        Error { offset: problem.offset, expected, committed: problem.committed }
                    },
                )
            },
        )
    }

    pub fn context(self: Parser[T], name: string) -> Parser[T] {
        Parser::new(
            |input, offset| {
                self.parse_at(input, offset).map_err(
                    |problem| {
                        Error {
                            offset: problem.offset,
                            expected: name + ": " + problem.expected,
                            committed: problem.committed,
                        }
                    },
                )
            },
        )
    }

    pub fn attempt(self: Parser[T]) -> Parser[T] {
        Parser::new(
            |input, offset| self.parse_at(input, offset).map_err(
                |problem| error(problem.offset, problem.expected),
            ),
        )
    }

    pub fn peek(self: Parser[T]) -> Parser[T] {
        Parser::new(
            |input, offset| {
                let (value, _) = self.parse_at(input, offset)?;
                Result::Ok((value, offset))
            },
        )
    }

    pub fn not(self: Parser[T], expected: string) -> Parser[()] {
        Parser::new(
            |input, offset| {
                match self.parse_at(input, offset) {
                    Ok(_) => Result::Err(error(offset, expected)),
                    Err(problem) => if problem.committed {
                        Result::Err(problem)
                    } else {
                        Result::Ok(((), offset))
                    },
                }
            },
        )
    }

    pub fn spanned(self: Parser[T]) -> Parser[(T, Span)] {
        Parser::new(
            |input, offset| {
                let (value, next) = self.parse_at(input, offset)?;
                Result::Ok(((value, Span { start: offset, end: next }), next))
            },
        )
    }

    pub fn recognize(self: Parser[T]) -> Parser[string] {
        Parser::new(
            |input, offset| {
                let (_, next) = self.parse_at(input, offset)?;
                Result::Ok((input.byte_slice(offset, next), next))
            },
        )
    }

    pub fn repeat(self: Parser[T], minimum: isize, maximum: isize) -> Parser[Vec[T]] {
        Parser::new(
            |input, offset| {
                if minimum < 0 || maximum < minimum {
                    return Result::Err(error(offset, "valid repetition bounds"))
                }
                let values: Vec[T] = Vec::new();
                let mut next = offset;
                while values.len() < maximum {
                    match self.parse_at(input, next) {
                        Ok((value, end)) => {
                            if end == next {
                                return Result::Err(
                                    Error {
                                        offset: next,
                                        expected: "repetition must consume input",
                                        committed: true,
                                    },
                                )
                            }
                            values.push(value);
                            next = end;
                        },
                        Err(problem) => {
                            if problem.committed || values.len() < minimum {
                                return Result::Err(problem)
                            }
                            break;
                        },
                    }
                }
                Result::Ok((values, next))
            },
        )
    }

    pub fn many1(self: Parser[T]) -> Parser[Vec[T]] {
        self.then(self.many()).map(
            |pair| {
                let values = Vec::from_array([pair.0]);
                values.extend(pair.1);
                values
            },
        )
    }

    pub fn separated[S](self: Parser[T], separator: Parser[S], minimum: isize, trailing: bool) -> Parser[
        Vec[T],
    ] {
        Parser::new(
            |input, offset| {
                if minimum < 0 {
                    return Result::Err(error(offset, "nonnegative list minimum"))
                }
                let values: Vec[T] = Vec::new();
                let mut next = offset;
                match self.parse_at(input, next) {
                    Ok((value, end)) => {
                        values.push(value);
                        next = end;
                    },
                    Err(problem) => {
                        if problem.committed || minimum > 0 {
                            return Result::Err(problem)
                        }
                        return Result::Ok((values, next))
                    },
                }
                loop {
                    let after_separator = match separator.parse_at(input, next) {
                        Ok((_, end)) => end,
                        Err(problem) => {
                            if problem.committed {
                                return Result::Err(problem)
                            }
                            break;
                        },
                    };
                    match self.parse_at(input, after_separator) {
                        Ok((value, end)) => {
                            if end == next {
                                return Result::Err(
                                    Error {
                                        offset: next,
                                        expected: "list must consume input",
                                        committed: true,
                                    },
                                )
                            }
                            values.push(value);
                            next = end;
                        },
                        Err(problem) => {
                            if !trailing || problem.committed {
                                return Result::Err(problem)
                            }
                            next = after_separator;
                            break;
                        },
                    }
                }
                if values.len() < minimum {
                    return Result::Err(error(next, f"at least {minimum} list elements"))
                }
                Result::Ok((values, next))
            },
        )
    }

    pub fn between[L, R](self: Parser[T], left: Parser[L], right: Parser[R]) -> Parser[T] {
        left.right(self.left(right).cut())
    }

    pub fn chain_left[O](self: Parser[T], operator: Parser[O], apply: (T, O, T) -> T) -> Parser[T] {
        self.then(operator.then(self.cut()).many()).map(
            |pair| {
                let mut result = pair.0;
                for step in pair.1 {
                    result = apply(result, step.0, step.1);
                }
                result
            },
        )
    }

    pub fn chain_right[O](self: Parser[T], operator: Parser[O], apply: (T, O, T) -> T) -> Parser[T] {
        self.then(operator.then(self.cut()).many()).map(
            |pair| {
                let mut index = pair.1.len();
                if index == 0 {
                    return pair.0
                }
                let mut result = pair.1[index - 1].1;
                while index > 0 {
                    index -= 1;
                    let left = if index == 0 {
                        pair.0
                    } else {
                        pair.1[index - 1].1
                    };
                    result = apply(left, pair.1[index].0, result);
                }
                result
            },
        )
    }
}

pub fn fail[T](expected: string) -> Parser[T] {
    Parser::new(|_, offset| Result::Err(error(offset, expected)))
}

pub fn end() -> Parser[()] {
    Parser::new(
        |input: string, offset| {
            if offset == input.byte_len() {
                Result::Ok(((), offset))
            } else {
                Result::Err(error(offset, "end of input"))
            }
        },
    )
}

pub fn position() -> Parser[isize] {
    Parser::new(|_, offset| Result::Ok((offset, offset)))
}

pub fn choice[T](alternatives: Vec[Parser[T]]) -> Parser[T] {
    let mut result = fail("an alternative");
    for alternative in alternatives {
        result = result.or(alternative);
    }
    result
}
