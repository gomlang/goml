package arithmetic;

use ecosystem::parser;
use std::num;

fn number() -> parser::Parser[isize] {
    parser::token(
        parser::Parser::with_context(
            |context, input, offset| {
                let digits = parser::take_while(
                    |value| value >= b'0' && value <= b'9',
                    1,
                    "integer",
                );
                let (text, next) = digits.parse_in(context, input, offset)?;
                match num::parse_int_structured(text) {
                    Ok(value) => Result::Ok((value, next)),
                    Err(_) => Result::Err(parser::error(offset, "integer in machine range")),
                }
            },
        ),
    )
}

fn symbol(value: string) -> parser::Parser[string] {
    parser::token(parser::literal(value))
}

fn factor() -> parser::Parser[isize] {
    number().or(symbol("(").right(parser::lazy(expression).left(symbol(")")).cut()))
}

fn product() -> parser::Parser[isize] {
    factor().then(symbol("*").right(parser::lazy(factor).cut()).many()).map(
        |pair| {
            let mut value = pair.0;
            for right in pair.1 {
                value *= right;
            }
            value
        },
    )
}

pub fn expression() -> parser::Parser[isize] {
    product().then(symbol("+").or(symbol("-")).then(parser::lazy(product).cut()).many()).map(
        |pair| {
            let mut value = pair.0;
            for step in pair.1 {
                if step.0 == "+" {
                    value += step.1;
                } else {
                    value -= step.1;
                }
            }
            value
        },
    )
}
