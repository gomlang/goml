package parser;

use std::num;
use std::unicode;

pub fn satisfy(predicate: (char) -> bool, expected: string) -> Parser[char] {
    Parser::new(
        |input: string, offset| {
            if !input.is_char_boundary(offset) {
                return Result::Err(error(offset, "UTF-8 character boundary"))
            }
            let characters = input.byte_slice(offset, input.byte_len()).chars();
            match characters.next() {
                Some(value) => if predicate(value) {
                    Result::Ok((value, offset + value.to_string().byte_len()))
                } else {
                    Result::Err(error(offset, expected))
                },
                None => Result::Err(error(offset, expected)),
            }
        },
    )
}

pub fn character(value: char) -> Parser[char] {
    satisfy(|actual| actual == value, value.to_string())
}

pub fn any_char() -> Parser[char] {
    satisfy(|_| true, "character")
}

pub fn one_of(values: string) -> Parser[char] {
    satisfy(|value| values.contains(value.to_string()), "one of " + values)
}

pub fn none_of(values: string) -> Parser[char] {
    satisfy(|value| !values.contains(value.to_string()), "character outside " + values)
}

pub fn digits() -> Parser[string] {
    take_while(|value| value >= b'0' && value <= b'9', 1, "decimal digit")
}

pub fn integer() -> Parser[isize] {
    one_of("+-").optional().then(digits()).recognize().try_map(
        |value| num::parse_int_structured(value).map_err(|problem| problem.to_string()),
    )
}

pub fn decimal() -> Parser[f64] {
    let fraction = literal(".").then(digits().cut()).optional();
    let exponent = one_of("eE").then(one_of("+-").optional().then(digits()).cut()).optional();
    one_of("+-").optional().then(digits()).then(fraction).then(exponent).recognize().try_map(
        |value| num::parse_float64_structured(value).map_err(|problem| problem.to_string()),
    )
}

pub fn identifier() -> Parser[string] {
    satisfy(|value| unicode::is_letter(value) || value == '_', "identifier start").then(
        satisfy(
            |value| (unicode::is_letter(value) || unicode::is_number(value)) || value == '_',
            "identifier continuation",
        ).many(),
    ).recognize()
}

pub fn line_ending() -> Parser[string] {
    literal("\r\n").or(literal("\n"))
}

pub fn rest_of_line() -> Parser[string] {
    take_while(|value| value != b'\r' && value != b'\n', 0, "line contents")
}

pub fn quoted(quote: char) -> Parser[string] {
    let escaped = character('\\').right(
        any_char().try_map(
            |value| {
                match value {
                    'n' => Result::Ok('\n'),
                    'r' => Result::Ok('\r'),
                    't' => Result::Ok('\t'),
                    '\\' => Result::Ok('\\'),
                    other => if other == quote {
                        Result::Ok(other)
                    } else {
                        Result::Err("supported string escape")
                    },
                }
            },
        ).cut(),
    );
    escaped.or(
        satisfy(
            |value| value != quote && value != '\\' && value != '\n' && value != '\r',
            "string character",
        ),
    ).many().between(character(quote), character(quote)).map(
        |characters| {
            let parts: Vec[string] = Vec::new();
            for value in characters {
                parts.push(value.to_string());
            }
            parts.join("")
        },
    )
}
