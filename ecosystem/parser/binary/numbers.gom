package binary;

use std::bytes::endian;

pub fn uint16(order: endian::Endian) -> Parser[u16] {
    take(2).try_map(
        |bytes| endian::read_u16(bytes, 0, order).map_err(|problem| problem.to_string()),
    )
}

pub fn uint32(order: endian::Endian) -> Parser[u32] {
    take(4).try_map(
        |bytes| endian::read_u32(bytes, 0, order).map_err(|problem| problem.to_string()),
    )
}

pub fn uint64(order: endian::Endian) -> Parser[u64] {
    take(8).try_map(
        |bytes| endian::read_u64(bytes, 0, order).map_err(|problem| problem.to_string()),
    )
}

pub fn int16(order: endian::Endian) -> Parser[i16] {
    take(2).try_map(
        |bytes| endian::read_i16(bytes, 0, order).map_err(|problem| problem.to_string()),
    )
}

pub fn int32(order: endian::Endian) -> Parser[i32] {
    take(4).try_map(
        |bytes| endian::read_i32(bytes, 0, order).map_err(|problem| problem.to_string()),
    )
}

pub fn int64(order: endian::Endian) -> Parser[i64] {
    take(8).try_map(
        |bytes| endian::read_i64(bytes, 0, order).map_err(|problem| problem.to_string()),
    )
}

pub fn float32(order: endian::Endian) -> Parser[f32] {
    take(4).try_map(
        |bytes| endian::read_f32(bytes, 0, order).map_err(|problem| problem.to_string()),
    )
}

pub fn float64(order: endian::Endian) -> Parser[f64] {
    take(8).try_map(
        |bytes| endian::read_f64(bytes, 0, order).map_err(|problem| problem.to_string()),
    )
}
