package binary;

use ecosystem::parser;
use std::bytes::endian;

#[derive(Debug, PartialEq)]
pub enum Error {
    Incomplete {
        offset: isize,
        needed: isize,
    },
    Invalid(parser::Error),
}

pub struct Parser[T] {
    run: (Slice[byte], isize) -> Result[(T, isize), Error],
}

impl[T] Parser[T] {
    pub fn new(run: (Slice[byte], isize) -> Result[(T, isize), Error]) -> Parser[T] {
        Parser { run }
    }

    pub fn parse_at(self: Parser[T], input: Slice[byte], offset: isize) -> Result[(T, isize), Error] {
        if offset < 0 || offset > input.len() {
            return Result::Err(Error::Invalid(parser::error(offset, "valid binary offset")))
        }
        let (value, next) = (self.run)(input, offset)?;
        if next < offset || next > input.len() {
            return Result::Err(
                Error::Invalid(parser::error(offset, "valid binary parser progress")),
            )
        }
        Result::Ok((value, next))
    }

    pub fn parse(self: Parser[T], input: Slice[byte]) -> Result[T, Error] {
        let (value, next) = self.parse_at(input, 0)?;
        if next != input.len() {
            return Result::Err(Error::Invalid(parser::error(next, "end of binary input")))
        }
        Result::Ok(value)
    }

    pub fn map[U](self: Parser[T], transform: (T) -> U) -> Parser[U] {
        Parser::new(
            |input, offset| {
                let (value, next) = self.parse_at(input, offset)?;
                Result::Ok((transform(value), next))
            },
        )
    }

    pub fn try_map[U](self: Parser[T], transform: (T) -> Result[U, string]) -> Parser[U] {
        Parser::new(
            |input, offset| {
                let (value, next) = self.parse_at(input, offset)?;
                let mapped = transform(value).map_err(
                    |message| Error::Invalid(parser::error(offset, message)),
                )?;
                Result::Ok((mapped, next))
            },
        )
    }

    pub fn then[U](self: Parser[T], other: Parser[U]) -> Parser[(T, U)] {
        Parser::new(
            |input, offset| {
                let (left, next) = self.parse_at(input, offset)?;
                let (right, end) = other.parse_at(input, next)?;
                Result::Ok(((left, right), end))
            },
        )
    }

    pub fn right[U](self: Parser[T], other: Parser[U]) -> Parser[U] {
        self.then(other).map(|pair| pair.1)
    }

    pub fn left[U](self: Parser[T], other: Parser[U]) -> Parser[T] {
        self.then(other).map(|pair| pair.0)
    }

    pub fn and_then[U](self: Parser[T], build: (T) -> Parser[U]) -> Parser[U] {
        Parser::new(
            |input, offset| {
                let (value, next) = self.parse_at(input, offset)?;
                build(value).parse_at(input, next)
            },
        )
    }

    pub fn repeat(self: Parser[T], count: isize, limit: isize) -> Parser[Vec[T]] {
        Parser::new(
            |input, offset| {
                if count < 0 || count > limit {
                    return Result::Err(
                        Error::Invalid(parser::error(offset, "bounded element count")),
                    )
                }
                let result: Vec[T] = Vec::new();
                let mut next = offset;
                for _ in 0..count {
                    let (value, end) = self.parse_at(input, next)?;
                    if end == next {
                        return Result::Err(
                            Error::Invalid(
                                parser::error(next, "binary repetition must consume input"),
                            ),
                        )
                    }
                    result.push(value);
                    next = end;
                }
                Result::Ok((result, next))
            },
        )
    }
}

pub fn take(count: isize) -> Parser[Slice[byte]] {
    Parser::new(
        |input: Slice[byte], offset| {
            if count < 0 {
                return Result::Err(Error::Invalid(parser::error(offset, "nonnegative byte count")))
            }
            let remaining = input.len() - offset;
            if count > remaining {
                return Result::Err(
                    Error::Incomplete { offset: input.len(), needed: count - remaining },
                )
            }
            Result::Ok((input.sub(offset, offset + count), offset + count))
        },
    )
}

pub fn literal(expected: Slice[byte]) -> Parser[Slice[byte]] {
    let frozen = expected.to_vec().freeze();
    Parser::new(
        |input: Slice[byte], offset| {
            let mut index = 0;
            while index < frozen.len() {
                if index >= input.len() - offset {
                    return Result::Err(
                        Error::Incomplete { offset: input.len(), needed: frozen.len() - index },
                    )
                }
                if input[offset + index] != frozen.get(index) {
                    return Result::Err(
                        Error::Invalid(parser::error(offset + index, "binary literal")),
                    )
                }
                index += 1;
            }
            take(frozen.len()).parse_at(input, offset)
        },
    )
}

pub fn byte_value() -> Parser[byte] {
    take(1).map(|value| value[0])
}

pub fn length_prefixed(length: Parser[isize], maximum: isize) -> Parser[Slice[byte]] {
    length.and_then(
        |count| {
            Parser::new(
                |input, offset| {
                    if count < 0 || count > maximum {
                        return Result::Err(
                            Error::Invalid(parser::error(offset, "bounded frame length")),
                        )
                    }
                    take(count).parse_at(input, offset)
                },
            )
        },
    )
}
