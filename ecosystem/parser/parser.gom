package parser;

#[derive(Debug, PartialEq)]
pub struct Error {
    pub offset: isize,
    pub expected: string,
    pub committed: bool,
}

pub struct Parser[T] {
    run: (string, isize) -> Result[(T, isize), Error],
}

pub fn error(offset: isize, expected: string) -> Error {
    Error { offset, expected, committed: false }
}

impl[T] Parser[T] {
    pub fn new(run: (string, isize) -> Result[(T, isize), Error]) -> Parser[T] {
        Parser { run }
    }

    pub fn parse_at(self: Parser[T], input: string, offset: isize) -> Result[(T, isize), Error] {
        if offset < 0 || offset > input.byte_len() {
            return Result::Err(error(offset, "valid input offset"))
        }
        if !input.is_char_boundary(offset) {
            return Result::Err(error(offset, "UTF-8 character boundary"))
        }
        let (value, next) = (self.run)(input, offset)?;
        if next < offset || next > input.byte_len() {
            return Result::Err(Error { offset, expected: "valid parser progress", committed: true })
        }
        if !input.is_char_boundary(next) {
            return Result::Err(error(next, "UTF-8 character boundary"))
        }
        Result::Ok((value, next))
    }

    pub fn parse(self: Parser[T], input: string) -> Result[T, Error] {
        let (value, next) = self.parse_at(input, 0)?;
        if next != input.byte_len() {
            Result::Err(error(next, "end of input"))
        } else {
            Result::Ok(value)
        }
    }

    pub fn map[U](self: Parser[T], transform: (T) -> U) -> Parser[U] {
        Parser::new(
            |input, offset| {
                let (value, next) = self.parse_at(input, offset)?;
                Result::Ok((transform(value), next))
            },
        )
    }

    pub fn then[U](self: Parser[T], other: Parser[U]) -> Parser[(T, U)] {
        Parser::new(
            |input, offset| {
                let (left, next) = self.parse_at(input, offset)?;
                let (right, end) = other.parse_at(input, next)?;
                Result::Ok(((left, right), end))
            },
        )
    }

    pub fn left[U](self: Parser[T], other: Parser[U]) -> Parser[T] {
        self.then(other).map(|pair| pair.0)
    }

    pub fn right[U](self: Parser[T], other: Parser[U]) -> Parser[U] {
        self.then(other).map(|pair| pair.1)
    }

    pub fn or(self: Parser[T], other: Parser[T]) -> Parser[T] {
        Parser::new(
            |input, offset| {
                match self.parse_at(input, offset) {
                    Ok(value) => Result::Ok(value),
                    Err(first) => {
                        if first.committed {
                            return Result::Err(first)
                        }
                        match other.parse_at(input, offset) {
                            Ok(value) => Result::Ok(value),
                            Err(second) => {
                                if second.committed || second.offset > first.offset {
                                    Result::Err(second)
                                } else if first.offset > second.offset {
                                    Result::Err(first)
                                } else {
                                    Result::Err(
                                        error(
                                            first.offset,
                                            first.expected + " or " + second.expected,
                                        ),
                                    )
                                }
                            },
                        }
                    },
                }
            },
        )
    }

    pub fn cut(self: Parser[T]) -> Parser[T] {
        Parser::new(
            |input, offset| {
                match self.parse_at(input, offset) {
                    Ok(value) => Result::Ok(value),
                    Err(problem) => Result::Err(
                        Error {
                            offset: problem.offset,
                            expected: problem.expected,
                            committed: true,
                        },
                    ),
                }
            },
        )
    }

    pub fn many(self: Parser[T]) -> Parser[Vec[T]] {
        Parser::new(
            |input, offset| {
                let values: Vec[T] = Vec::new();
                let mut next = offset;
                loop {
                    match self.parse_at(input, next) {
                        Ok((value, end)) => {
                            if end == next {
                                return Result::Err(
                                    Error {
                                        offset: next,
                                        expected: "repetition must consume input",
                                        committed: true,
                                    },
                                )
                            }
                            values.push(value);
                            next = end;
                        },
                        Err(problem) => {
                            if problem.committed {
                                return Result::Err(problem)
                            }
                            return Result::Ok((values, next))
                        },
                    }
                }
            },
        )
    }

    pub fn optional(self: Parser[T]) -> Parser[Option[T]] {
        Parser::new(
            |input, offset| {
                match self.parse_at(input, offset) {
                    Ok((value, next)) => Result::Ok((Option::Some(value), next)),
                    Err(problem) => if problem.committed {
                        Result::Err(problem)
                    } else {
                        Result::Ok((Option::None, offset))
                    },
                }
            },
        )
    }
}

pub fn pure[T](value: T) -> Parser[T] {
    Parser::new(|_, offset| Result::Ok((value, offset)))
}

pub fn lazy[T](build: () -> Parser[T]) -> Parser[T] {
    Parser::new(|input, offset| build().parse_at(input, offset))
}

pub fn literal(expected: string) -> Parser[string] {
    Parser::new(
        |input, offset| {
            if input.starts_with_at(offset, expected) {
                Result::Ok((expected, offset + expected.byte_len()))
            } else {
                Result::Err(error(offset, expected))
            }
        },
    )
}

pub fn take_while(predicate: (byte) -> bool, minimum: isize, expected: string) -> Parser[string] {
    Parser::new(
        |input, offset| {
            let mut next = offset;
            while next < input.byte_len() && predicate(input.byte_get(next)) {
                next += 1;
            }
            if !input.is_char_boundary(next) {
                return Result::Err(error(next, "UTF-8 character boundary"))
            }
            if next - offset < minimum {
                Result::Err(error(next, expected))
            } else {
                Result::Ok((input.byte_slice(offset, next), next))
            }
        },
    )
}

pub fn whitespace() -> Parser[string] {
    take_while(
        |value| value == b' ' || value == b'\t' || value == b'\r' || value == b'\n',
        0,
        "whitespace",
    )
}

pub fn token[T](value: Parser[T]) -> Parser[T] {
    whitespace().right(value).left(whitespace())
}
