package main;

use std::testing;

fn main() -> () {
    let units: Vec[Ref[()]] = Vec::new();
    let bools: Vec[Ref[bool]] = Vec::new();
    for _ in 0..2 {
        units.push(Ref::new(()));
        bools.push(Ref::new(false));
    }
    testing::assert(!ptr_eq(units[0], units[1]));
    testing::assert(ptr_eq(units[0], units[0]));
    println(f"distinct Ref[()] compare equal: {ptr_eq(units[0], units[1])}");
    println(f"distinct Ref[bool] compare equal: {ptr_eq(bools[0], bools[1])}");
}
