package main;

struct Token[T] {
    value: isize,
}

trait Creator {
    fn token() -> Token[Self];
}

struct Item {}

impl Creator for Item {
    fn token() -> Token[Item] {
        Token { value: 42 }
    }
}

fn erased[T: Creator]() -> isize {
    let token: Token[T] = Creator::token();
    token.value
}

fn main() -> () {
    println(42);
}
