package trace;

use std::time;

#[derive(Debug, PartialEq)]
pub enum EventKind {
    RequestStart,
    ConnectStart,
    ConnectDone,
    Connection,
    RequestQueued,
    RequestWritten,
    ResponseReceived,
    Retry,
    Redirect,
    RequestDone,
    RequestFailed,
}

pub struct Event {
    pub request_id: i64,
    pub attempt: isize,
    pub kind: EventKind,
    pub method: string,
    pub url: string,
    pub detail: string,
    pub status: Option[isize],
    pub reused: bool,
    pub protocol: string,
    pub elapsed: time::Duration,
}

struct State {
    next_request_id: i64,
    events: Vec[Event],
}

pub struct Trace {
    state: Channel[State],
    started: time::Instant,
    capacity: isize,
}

impl Trace {
    pub fn new(capacity: isize) -> Option[Trace] {
        if capacity < 1 || capacity > 65536 {
            return Option::None
        }
        let state = Channel::new(1);
        state.send(State { next_request_id: 1, events: Vec::new() });
        Option::Some(Trace { state, started: time::Instant::now(), capacity })
    }

    pub fn begin(self: Trace, method: string, url: string) -> i64 {
        let mut state = self.state.recv().unwrap_or(
            State { next_request_id: 1, events: Vec::new() },
        );
        let id = state.next_request_id;
        if state.next_request_id < 9223372036854775807 {
            state.next_request_id += 1;
        }
        self.append(
            state.events,
            Event {
                request_id: id,
                attempt: 0,
                kind: EventKind::RequestStart,
                method,
                url,
                detail: "",
                status: Option::None,
                reused: false,
                protocol: "",
                elapsed: self.started.elapsed(),
            },
        );
        self.state.send(state);
        id
    }

    fn append(self: Trace, events: Vec[Event], event: Event) -> () {
        if events.len() >= self.capacity {
            let _ = events.remove(0);
        }
        events.push(event);
    }

    pub fn emit(
        self: Trace,
        request_id: i64,
        attempt: isize,
        kind: EventKind,
        detail: string,
        status: Option[isize],
        reused: bool,
        protocol: string,
    ) -> () {
        let state = self.state.recv().unwrap_or(State { next_request_id: 1, events: Vec::new() });
        self.append(
            state.events,
            Event {
                request_id,
                attempt,
                kind,
                method: "",
                url: "",
                detail,
                status,
                reused,
                protocol,
                elapsed: self.started.elapsed(),
            },
        );
        self.state.send(state);
    }

    pub fn snapshot(self: Trace) -> Vec[Event] {
        let state = self.state.recv().unwrap_or(State { next_request_id: 1, events: Vec::new() });
        let events = state.events.copy();
        self.state.send(state);
        events
    }

    pub fn drain(self: Trace) -> Vec[Event] {
        let state = self.state.recv().unwrap_or(State { next_request_id: 1, events: Vec::new() });
        let events = state.events;
        self.state.send(State { events: Vec::new(), ..state });
        events
    }
}
