package tests;

use ecosystem::request::trace::{Trace, EventKind};
use std::testing;
use std::task;

#[test]
fn trace_records_bounded_events_and_drains_snapshots() -> () {
    testing::assert(Trace::new(0).is_none());
    testing::assert(Trace::new(65537).is_none());
    let trace = testing::expect_some(Trace::new(3), "trace");
    let first = trace.begin("GET", "http://example.test/a");
    let second = trace.begin("POST", "http://example.test/b");
    testing::assert_eq(first, 1);
    testing::assert_eq(second, 2);
    trace.emit(first, 0, EventKind::Connection, "example.test:80", Option::None, false, "http/1.1");
    trace.emit(first, 0, EventKind::RequestDone, "", Option::Some(200), false, "http/1.1");
    let snapshot = trace.snapshot();
    testing::assert_eq(snapshot.len(), 3);
    testing::assert_eq(snapshot[0].request_id, second);
    testing::assert_eq(snapshot[2].kind, EventKind::RequestDone);
    testing::assert_eq(testing::expect_some(snapshot[2].status, "status"), 200);
    testing::assert_eq(trace.drain().len(), 3);
    testing::assert_eq(snapshot.len(), 3);
    testing::assert_eq(trace.snapshot().len(), 0);
}

#[test]
fn trace_assigns_unique_ids_under_concurrency() -> () {
    let trace = testing::expect_some(Trace::new(128), "trace");
    task::scope(
        |scope| {
            let calls = Vec::new();
            for _ in 0..32 {
                calls.push(scope.spawn(|_| trace.begin("GET", "http://example.test/")));
            }
            let ids: HashMap[i64, bool] = HashMap::new();
            for call in calls {
                let id = call.join();
                testing::assert(!ids.contains(id));
                ids.set(id, true);
            }
        },
    );
    testing::assert_eq(trace.snapshot().len(), 32);
}
