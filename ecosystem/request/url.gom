package request;

use std::net;
use std::net::url;
use std::bytes::{Bytes};

fn invalid_url() -> Error {
    Error::new(ErrorKind::Builder, "expected absolute HTTP(S) URL without credentials")
}

fn encode_request_path(value: string) -> string {
    let result: Vec[byte] = Vec::new();
    let hex = b"0123456789ABCDEF";
    for byte in value.to_bytes() {
        if byte >= b'a' && byte <= b'z' || byte >= b'A' && byte <= b'Z'
            || byte >= b'0' && byte <= b'9'
            || byte == b'-'
            || byte == b'_'
            || byte == b'.'
            || byte == b'~'
            || (byte == b'/' || byte == b':' || byte == b'@' || byte == b'!' || byte == b'$'
                || byte == b'&'
                || byte == b'\''
                || byte == b'('
                || byte == b')'
                || byte == b'*'
                || byte == b'+'
                || byte == b','
                || byte == b';'
                || byte == b'='
                || byte == b'%') {
            result.push(byte)
        } else {
            result.push(b'%');
            result.push(hex[(byte / 16).to_isize()]);
            result.push(hex[(byte % 16).to_isize()]);
        }
    }
    string_from_utf8(result).1
}

fn decode_form(value: string) -> Result[Vec[(string, string)], Error] {
    let fields = url::parse_query_bounded(
        value,
        value.byte_len(),
        value.byte_len(),
        value.byte_len(),
    ).map_err(|_| invalid_url())?;
    let result: Vec[(string, string)] = Vec::new();
    for (name, value) in fields {
        let (valid_name, name) = string_from_utf8(name.to_vec());
        let (valid_value, value) = string_from_utf8(value.to_vec());
        if !valid_name || !valid_value {
            return Result::Err(invalid_url())
        }
        result.push((name, value));
    }
    Result::Ok(result)
}

fn encode_form(values: Vec[(string, string)]) -> Result[string, Error] {
    let fields: Vec[(Bytes, Bytes)] = Vec::new();
    for (name, value) in values {
        fields.push((Bytes::from_string(name), Bytes::from_string(value)));
    }
    url::encode_query(fields.as_slice(), 9223372036854775807).map_err(|_| invalid_url())
}

fn normalized_path(path: string) -> string {
    let components: Vec[string] = Vec::new();
    for part in path.split("/") {
        if part == ".." {
            let _ = components.pop();
        } else if part != "." {
            components.push(part)
        }
    }
    let mut result = components.join("/");
    if !result.starts_with("/") {
        result = "/" + result;
    }
    if (path.ends_with("/.") || path.ends_with("/..")) && !result.ends_with("/") {
        result += "/";
    }
    result
}

impl Url {
    fn scheme(self: Url) -> string {
        if self.secure {
            "https"
        } else {
            "http"
        }
    }
}

fn parse_url(text: string, base: string) -> Result[Url, Error] {
    for byte in text.to_bytes() {
        if byte < 32 || byte == 127 || byte == b'\\' {
            return Result::Err(invalid_url())
        }
    }
    let text = text.split_once("#").map(|pair| pair.0).unwrap_or(text);
    let mut scheme_prefix = false;
    for byte in text.to_bytes() {
        if byte == b'/' || byte == b'?' {
            break
        }
        if byte == b':' {
            scheme_prefix = true;
            break
        }
    }
    if !scheme_prefix && base != "" {
        let parent = Url::parse(base)?;
        if text.starts_with("//") {
            return Url::parse(parent.scheme() + ":" + text)
        }
        let (base_path, _) = parent.target.split_once("?").unwrap_or((parent.target, ""));
        let target = if text == "" {
            parent.target
        } else if text.starts_with("?") {
            base_path + text
        } else if text.starts_with("/") {
            text
        } else {
            let parts = base_path.split("/");
            let _ = parts.pop();
            parts.join("/") + "/" + text
        };
        let (path, query) = target.split_once("?").unwrap_or((target, ""));
        return Url::parse(
            parent.scheme() + "://" + parent.authority + normalized_path(path)
                + if target.contains("?") {
                    "?" + query
                } else {
                    ""
                },
        )
    }
    let reference = url::Reference::parse(text, text.byte_len()).map_err(|_| invalid_url())?;
    let scheme = ascii_lower(reference.scheme().ok_or(invalid_url())?);
    if scheme != "http" && scheme != "https" {
        return Result::Err(invalid_url())
    }
    let authority = ascii_lower(reference.raw_authority().ok_or(invalid_url())?);
    if authority == "" || authority.contains("@") || authority.contains(" ")
        || authority.contains("%") {
        return Result::Err(invalid_url())
    }
    let (host, port_text) = if authority.starts_with("[") {
        let (host, tail) = authority.byte_slice(1, authority.byte_len()).split_once("]").ok_or(
            invalid_url(),
        )?;
        net::IpAddr::parse(host).map_err(|_| invalid_url())?;
        if tail != "" && !tail.starts_with(":") {
            return Result::Err(invalid_url())
        };
        (
            host,
            if tail == "" {
                ""
            } else {
                tail.byte_slice(1, tail.byte_len())
            },
        )
    } else {
        if authority.contains("[") || authority.contains("]") {
            return Result::Err(invalid_url())
        }
        authority.split_once(":").unwrap_or((authority, ""))
    };
    if host == "" {
        return Result::Err(invalid_url())
    }
    let port = if port_text == "" {
        if scheme == "https" {
            443
        } else {
            80
        }
    } else {
        let mut value = 0;
        for byte in port_text.to_bytes() {
            if byte < b'0' || byte > b'9' || value > 6553 {
                return Result::Err(invalid_url())
            }
            value = value * 10 + (byte - b'0').to_isize();
        }
        if value > 65535 || value == 0 {
            return Result::Err(invalid_url())
        }
        value.to_u16()
    };
    let path = if reference.raw_path() == "" {
        "/"
    } else {
        reference.raw_path()
    };
    let target = encode_request_path(path)
        + match reference.raw_query() {
            Some(query) => "?" + query,
            None => "",
        };
    let origin = scheme + "://"
        + if host.contains(":") {
            "[" + host + "]"
        } else {
            host
        }
        + ":"
        + port.to_string();
    Result::Ok(
        Url {
            text: scheme + "://" + authority + target,
            origin,
            secure: scheme == "https",
            host,
            port,
            authority,
            target,
        },
    )
}
