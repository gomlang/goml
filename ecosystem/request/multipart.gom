package request;

use std::bytes::{Bytes, FrozenBytes};
use std::crypto::rand;
use std::encoding::hex;

pub struct Part {
    bytes_value: FrozenBytes,
    filename: Option[string],
    content_type: string,
}

impl Part {
    pub fn text(value: string) -> Part {
        Part {
            bytes_value: FrozenBytes::from_string(value),
            filename: Option::None,
            content_type: "text/plain; charset=utf-8",
        }
    }

    pub fn bytes(value: Bytes) -> Part {
        Part {
            bytes_value: value.freeze(),
            filename: Option::None,
            content_type: "application/octet-stream",
        }
    }

    pub fn frozen_bytes(value: FrozenBytes) -> Part {
        Part {
            bytes_value: value,
            filename: Option::None,
            content_type: "application/octet-stream",
        }
    }

    pub fn file_name(self: Part, value: string) -> Part {
        Part { filename: Option::Some(value), ..self }
    }

    pub fn mime_type(self: Part, value: string) -> Part {
        Part { content_type: value, ..self }
    }
}

pub struct Multipart {
    parts: Vec[(string, Part)],
}

impl Multipart {
    pub fn new() -> Multipart {
        Multipart { parts: Vec::new() }
    }

    pub fn part(self: Multipart, name: string, value: Part) -> Multipart {
        let parts: Vec[(string, Part)] = Vec::new();
        for part in self.parts {
            parts.push(part)
        }
        parts.push((name, value));
        Multipart { parts }
    }

    pub fn text(self: Multipart, name: string, value: string) -> Multipart {
        self.part(name, Part::text(value))
    }
}

impl RequestBuilder {
    pub fn multipart(self: RequestBuilder, value: Multipart) -> RequestBuilder {
        match encode_multipart(value, self.client.options.request_limit_value) {
            Ok((body, content_type)) => self.body(body).header("content-type", content_type),
            Err(error) => self.failed(error),
        }
    }
}

fn mime_quote(value: string) -> Result[string, Error] {
    for byte in value.to_bytes() {
        if byte < 32 || byte == 127 {
            return Result::Err(Error::new(ErrorKind::Builder, "invalid multipart metadata"))
        }
    }
    Result::Ok(value.replace("\\", "\\\\").replace("\"", "\\\""))
}

fn validate_mime(value: string) -> Result[(), Error] {
    let invalid = Error::new(ErrorKind::Builder, "invalid multipart MIME type");
    let _ = mime_quote(value)?;
    if value == "" {
        return Result::Ok(())
    }
    let (essence, parameters) = value.split_once(";").unwrap_or((value, ""));
    let (kind, subtype) = essence.trim().split_once("/").ok_or(invalid)?;
    if !token(kind) || !token(subtype) {
        return Result::Err(invalid)
    }
    let parts: Vec[string] = Vec::new();
    let mut quoted = false;
    let mut escaped = false;
    let mut start = 0;
    for index in 0..parameters.byte_len() {
        let byte = parameters.byte_get(index);
        if escaped {
            escaped = false;
        } else if quoted && byte == b'\\' {
            escaped = true;
        } else if byte == b'"' {
            quoted = !quoted;
        } else if !quoted && byte == b';' {
            parts.push(parameters.byte_slice(start, index).trim());
            start = index + 1;
        }
    }
    if quoted || escaped {
        return Result::Err(invalid)
    }
    if parameters != "" {
        parts.push(parameters.byte_slice(start, parameters.byte_len()).trim());
    }
    let seen: HashMap[string, string] = HashMap::new();
    for part in parts {
        let (name, parameter) = part.split_once("=").ok_or(invalid)?;
        let name = ascii_lower(name.trim());
        let parameter = parameter.trim();
        if !token(name) || parameter == ""
            || !(token(parameter)
                || parameter.starts_with("\"") && parameter.ends_with("\"")
                    && parameter.byte_len() >= 2) {
            return Result::Err(invalid)
        }
        if let Some(previous) = seen.get(name) {
            if previous != parameter {
                return Result::Err(invalid)
            }
        }
        seen.insert(name, parameter);
    }
    Result::Ok(())
}

fn encode_multipart(value: Multipart, limit: isize) -> Result[(Bytes, string), Error] {
    let boundary = hex::encode(
        rand::bytes(30).map_err(|message| Error::new(ErrorKind::Builder, message))?,
    );
    let result = Bytes::new();
    for (name, part) in value.parts {
        if name == "" {
            return Result::Err(Error::new(ErrorKind::Builder, "empty multipart field name"))
        }
        let mut header = "--" + boundary + "\r\nContent-Disposition: form-data; name=\""
            + mime_quote(name)?
            + "\"";
        if let Some(filename) = part.filename {
            header += "; filename=\"" + mime_quote(filename)? + "\"";
        }
        validate_mime(part.content_type)?;
        if part.content_type != "" {
            header += "\r\nContent-Type: " + part.content_type;
        }
        header += "\r\n\r\n";
        if header.byte_len() > limit - result.len()
            || part.bytes_value.len() > limit - result.len() - header.byte_len() - 2 {
            return Result::Err(
                Error::new(ErrorKind::BodyLimit, "multipart output exceeds request limit"),
            )
        }
        result.extend_from_slice(header.to_bytes().as_slice());
        result.extend_from_slice(part.bytes_value.to_vec_copy().as_slice());
        result.extend_from_slice(b"\r\n".as_slice());
    }
    let final_boundary = "--" + boundary + "--\r\n";
    if final_boundary.byte_len() > limit - result.len() {
        return Result::Err(
            Error::new(ErrorKind::BodyLimit, "multipart output exceeds request limit"),
        )
    }
    result.extend_from_slice(final_boundary.to_bytes().as_slice());
    Result::Ok((result, "multipart/form-data; boundary=" + boundary))
}
