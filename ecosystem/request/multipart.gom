package request;

use std::bytes::{Bytes, FrozenBytes};
use std::crypto::rand;
use std::encoding::hex;
use std::io;
use ecosystem::mime;
use ecosystem::mime::multipart as mime_multipart;
use ecosystem::textproto;

pub struct Part {
    bytes_value: FrozenBytes,
    filename: Option[string],
    content_type: string,
}

impl Part {
    pub fn text(value: string) -> Part {
        Part {
            bytes_value: FrozenBytes::from_string(value),
            filename: Option::None,
            content_type: "text/plain; charset=utf-8",
        }
    }

    pub fn bytes(value: Bytes) -> Part {
        Part {
            bytes_value: value.freeze(),
            filename: Option::None,
            content_type: "application/octet-stream",
        }
    }

    pub fn frozen_bytes(value: FrozenBytes) -> Part {
        Part {
            bytes_value: value,
            filename: Option::None,
            content_type: "application/octet-stream",
        }
    }

    pub fn file_name(self: Part, value: string) -> Part {
        Part { filename: Option::Some(value), ..self }
    }

    pub fn mime_type(self: Part, value: string) -> Part {
        Part { content_type: value, ..self }
    }
}

pub struct Multipart {
    parts: Vec[(string, Part)],
}

impl Multipart {
    pub fn new() -> Multipart {
        Multipart { parts: Vec::new() }
    }

    pub fn part(self: Multipart, name: string, value: Part) -> Multipart {
        let parts: Vec[(string, Part)] = Vec::new();
        for part in self.parts {
            parts.push(part)
        }
        parts.push((name, value));
        Multipart { parts }
    }

    pub fn text(self: Multipart, name: string, value: string) -> Multipart {
        self.part(name, Part::text(value))
    }
}

impl RequestBuilder {
    pub fn multipart(self: RequestBuilder, value: Multipart) -> RequestBuilder {
        match encode_multipart(value, self.client.options.request_limit_value) {
            Ok((body, content_type)) => self.body(body).header("content-type", content_type),
            Err(error) => self.failed(error),
        }
    }
}

fn mime_quote(value: string) -> Result[string, Error] {
    for byte in value.to_bytes() {
        if byte < 32 || byte == 127 {
            return Result::Err(Error::new(ErrorKind::Builder, "invalid multipart metadata"))
        }
    }
    Result::Ok(value.replace("\\", "\\\\").replace("\"", "\\\""))
}

fn validate_mime(value: string) -> Result[(), Error] {
    let invalid = Error::new(ErrorKind::Builder, "invalid multipart MIME type");
    let _ = mime_quote(value)?;
    if value == "" {
        return Result::Ok(())
    }
    let _ = mime::parse_media_type(value, mime::Limits::standard()).map_err(|_| invalid)?;
    Result::Ok(())
}

fn multipart_error(error: mime_multipart::Error) -> Error {
    Error::new(
        if error.kind == mime_multipart::ErrorKind::Limit {
            ErrorKind::BodyLimit
        } else {
            ErrorKind::Builder
        },
        error.message,
    )
}

fn encode_multipart(value: Multipart, limit: isize) -> Result[(Bytes, string), Error] {
    let boundary = hex::encode(
        rand::bytes(30).map_err(|message| Error::new(ErrorKind::Builder, message))?,
    );
    let sink = io::Cursor::new(Bytes::new());
    let line_limit = if limit > 9223372036854775805 {
        9223372036854775805
    } else {
        limit
    };
    let limits = mime_multipart::Limits {
        max_wire_bytes: limit,
        max_header_bytes: limit,
        max_line_bytes: line_limit,
        max_value_bytes: limit,
        max_part_bytes: limit,
        max_total_bytes: limit,
        max_parts: limit,
        ..mime_multipart::Limits::standard(),
    };
    let writer = mime_multipart::Writer::new(sink, boundary, limits).map_err(multipart_error)?;
    for (name, part) in value.parts {
        if name == "" {
            return Result::Err(Error::new(ErrorKind::Builder, "empty multipart field name"))
        }
        let mut disposition = "form-data; name=\"" + mime_quote(name)? + "\"";
        if let Some(filename) = part.filename {
            disposition += "; filename=\"" + mime_quote(filename)? + "\"";
        }
        let headers = textproto::Headers::new();
        headers.append("Content-Disposition", Bytes::from_string(disposition)).map_err(
            |error| Error::new(ErrorKind::Builder, error.message),
        )?;
        validate_mime(part.content_type)?;
        if part.content_type != "" {
            headers.append("Content-Type", Bytes::from_string(part.content_type)).map_err(
                |error| Error::new(ErrorKind::Builder, error.message),
            )?;
        }
        writer.begin_part(headers).map_err(multipart_error)?;
        let payload = part.bytes_value.to_vec_copy();
        let _ = writer.write_body_chunk(payload.as_slice()).map_err(multipart_error)?;
    }
    writer.finish().map_err(multipart_error)?;
    Result::Ok((sink.bytes(), "multipart/form-data; boundary=" + boundary))
}
