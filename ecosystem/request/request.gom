package request;

use std::bytes::{Bytes, FrozenBytes};
use std::context;
use std::time::{Duration};
use std::json;
use std::serde::{Serialize};
use std::encoding::base64;

pub struct Request {
    method_value: string,
    url_value: Url,
    headers_value: Headers,
    body_value: FrozenBytes,
    timeout_value: Duration,
    body_limit_value: isize,
    redirects: RedirectPolicy,
}

impl Request {
    pub fn method(self: Request) -> string {
        self.method_value
    }

    pub fn url(self: Request) -> Url {
        self.url_value
    }

    pub fn headers(self: Request) -> Headers {
        self.headers_value
    }

    pub fn body(self: Request) -> Bytes {
        self.body_value.thaw()
    }

    pub fn frozen_body(self: Request) -> FrozenBytes {
        self.body_value
    }
}

pub struct RequestBuilder {
    client: Client,
    method_value: string,
    url_text: string,
    headers: Headers,
    body_value: FrozenBytes,
    timeout_value: Duration,
    body_limit_value: isize,
    redirects: RedirectPolicy,
    error: Option[Error],
}

fn validate_request_headers(headers: Headers) -> Result[(), Error] {
    for entry in headers.entries() {
        if entry.0 == "host" || entry.0 == "content-length" || entry.0 == "transfer-encoding"
            || entry.0 == "connection"
            || entry.0 == "trailer"
            || entry.0 == "upgrade"
            || entry.0 == "proxy-connection" {
            return Result::Err(
                Error::new(ErrorKind::Builder, "transport manages header: " + entry.0),
            )
        }
    }
    Result::Ok(())
}

impl RequestBuilder {
    fn failed(self: RequestBuilder, error: Error) -> RequestBuilder {
        RequestBuilder {
            error: if self.error.is_some() {
                self.error
            } else {
                Option::Some(error)
            },
            ..self,
        }
    }

    pub fn header(self: RequestBuilder, name: string, value: string) -> RequestBuilder {
        match self.headers.insert(name, value) {
            Ok(headers) => RequestBuilder { headers, ..self },
            Err(error) => self.failed(error),
        }
    }

    pub fn append_header(self: RequestBuilder, name: string, value: string) -> RequestBuilder {
        match self.headers.append(name, value) {
            Ok(headers) => RequestBuilder { headers, ..self },
            Err(error) => self.failed(error),
        }
    }

    pub fn headers(self: RequestBuilder, headers: Headers) -> RequestBuilder {
        let mut result = self;
        for entry in headers.entries() {
            result = RequestBuilder { headers: result.headers.remove(entry.0), ..result };
        }
        for entry in headers.entries() {
            result = result.append_header(entry.0, entry.1);
        }
        result
    }

    pub fn query(self: RequestBuilder, values: Vec[(string, string)]) -> RequestBuilder {
        match Url::parse(self.url_text).and_then(|url| url.query(values)) {
            Ok(url) => RequestBuilder { url_text: url.text, ..self },
            Err(error) => self.failed(error),
        }
    }

    pub fn body(self: RequestBuilder, value: Bytes) -> RequestBuilder {
        RequestBuilder { body_value: value.freeze(), ..self }
    }

    pub fn frozen_body(self: RequestBuilder, value: FrozenBytes) -> RequestBuilder {
        RequestBuilder { body_value: value, ..self }
    }

    pub fn text(self: RequestBuilder, value: string) -> RequestBuilder {
        self.body(Bytes::from_string(value)).header("content-type", "text/plain; charset=utf-8")
    }

    pub fn json[T: Serialize](self: RequestBuilder, value: T) -> RequestBuilder {
        match json::try_to_string(value) {
            Ok(text) => self.body(Bytes::from_string(text)).header(
                "content-type",
                "application/json",
            ),
            Err(message) => self.failed(Error::new(ErrorKind::Builder, message)),
        }
    }

    pub fn form(self: RequestBuilder, values: Vec[(string, string)]) -> RequestBuilder {
        let (names, values) = encode_pairs(values);
        match native_text(raw_encode_form(names, values)) {
            Ok(text) => self.body(Bytes::from_string(text)).header(
                "content-type",
                "application/x-www-form-urlencoded",
            ),
            Err(error) => self.failed(error),
        }
    }

    pub fn bearer_auth(self: RequestBuilder, token: string) -> RequestBuilder {
        self.header("authorization", "Bearer " + token)
    }

    pub fn basic_auth(self: RequestBuilder, username: string, password: string) -> RequestBuilder {
        if username.contains(":") {
            return self.failed(
                Error::new(ErrorKind::Builder, "basic authentication username contains colon"),
            )
        }
        self.header(
            "authorization",
            "Basic " + base64::encode(Bytes::from_string(username + ":" + password)),
        )
    }

    pub fn timeout(self: RequestBuilder, duration: Duration) -> RequestBuilder {
        RequestBuilder { timeout_value: duration, ..self }
    }

    pub fn body_limit(self: RequestBuilder, count: isize) -> RequestBuilder {
        RequestBuilder { body_limit_value: count, ..self }
    }

    pub fn redirect(self: RequestBuilder, policy: RedirectPolicy) -> RequestBuilder {
        RequestBuilder { redirects: policy, ..self }
    }

    pub fn build(self: RequestBuilder) -> Result[Request, Error] {
        if let Some(error) = self.error {
            return Result::Err(error)
        }
        if !token(self.method_value) {
            return Result::Err(Error::new(ErrorKind::Builder, "invalid HTTP method"))
        }
        if self.method_value == "CONNECT" || self.method_value == "TRACE" {
            return Result::Err(Error::new(ErrorKind::Builder, "CONNECT and TRACE are unsupported"))
        }
        if self.timeout_value.is_zero() || self.body_limit_value < 0
            || self.body_limit_value.to_i64() == 9223372036854775807 {
            return Result::Err(
                Error::new(ErrorKind::Builder, "invalid request timeout or body limit"),
            )
        }
        match self.redirects {
            RedirectPolicy::Limited(count) | RedirectPolicy::SameOrigin(count) => if count < 0 {
                return Result::Err(Error::new(ErrorKind::Builder, "negative redirect limit"))
            },
            _ => (),
        }
        validate_request_headers(self.headers)?;
        Result::Ok(
            Request {
                method_value: self.method_value,
                url_value: Url::parse(self.url_text)?,
                headers_value: self.headers,
                body_value: self.body_value,
                timeout_value: self.timeout_value,
                body_limit_value: self.body_limit_value,
                redirects: self.redirects,
            },
        )
    }

    pub fn send(self: RequestBuilder) -> Result[Response, Error] {
        self.client.execute(self.build()?)
    }

    pub fn send_with(self: RequestBuilder, context: context::Context) -> Result[Response, Error] {
        self.client.execute_with(self.build()?, context)
    }
}
