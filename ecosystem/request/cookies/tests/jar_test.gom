package tests;

use ecosystem::request::cookies;
use std::testing;

#[test]
fn jar_matches_domain_path_and_secure_attributes() -> () {
    let jar = testing::expect_some(cookies::Jar::new(), "jar");
    let jar = jar.set("api.example.com", "/a/page", "host=one; Path=/", 100);
    let jar = jar.set("api.example.com", "/a/page", "domain=two; Domain=.example.com; Path=/", 100);
    let jar = jar.set(
        "api.example.com",
        "/a/page",
        "secure=yes; Domain=example.com; Secure; Path=/",
        100,
    );
    let jar = jar.set("api.example.com", "/a/page", "path=deep; Path=/a", 100);
    testing::assert_eq(jar.len(), 4);
    testing::assert_eq(jar.header("other.example.com", "/a/page", false, 101).1, "domain=two");
    testing::assert_eq(
        jar.header("api.example.com", "/a/page", false, 101).1,
        "path=deep; host=one; domain=two",
    );
    testing::assert_eq(
        jar.header("api.example.com", "/a/page", true, 101).1,
        "path=deep; host=one; domain=two; secure=yes",
    );
    testing::assert_eq(
        jar.header("api.example.com", "/ab", true, 101).1,
        "host=one; domain=two; secure=yes",
    );
}

#[test]
fn jar_rejects_public_suffix_cross_site_and_invalid_domains() -> () {
    let jar = testing::expect_some(cookies::Jar::new(), "jar");
    let jar = jar.set("shop.example.co.uk", "/", "bad=1; Domain=co.uk", 100);
    let jar = jar.set("shop.example.co.uk", "/", "ok=1; Domain=example.co.uk", 100);
    let jar = jar.set("shop.example.co.uk", "/", "bad=2; Domain=other.co.uk", 100);
    let jar = jar.set("tenant.blogspot.com", "/", "bad=3; Domain=blogspot.com", 100);
    let jar = jar.set("foo.ck", "/", "bad=4; Domain=foo.ck", 100);
    testing::assert_eq(jar.header("api.example.co.uk", "/", false, 101).1, "ok=1");
    testing::assert_eq(jar.header("other.co.uk", "/", false, 101).1, "");
    testing::assert_eq(jar.header("other.blogspot.com", "/", false, 101).1, "");
    testing::assert_eq(jar.header("bar.foo.ck", "/", false, 101).1, "");
}

#[test]
fn jar_expiry_replacement_and_header_order_are_stable() -> () {
    let jar = testing::expect_some(cookies::Jar::new(), "jar");
    let jar = jar.set("example.com", "/a/x", "first=old; Path=/", 100);
    let jar = jar.set("example.com", "/a/x", "short=one; Path=/a", 100);
    let jar = jar.set("example.com", "/a/x", "first=new; Path=/", 101);
    let jar = jar.set("example.com", "/a/x", "temp=yes; Max-Age=2", 101);
    testing::assert_eq(
        jar.header("example.com", "/a/x", false, 102).1,
        "short=one; temp=yes; first=new",
    );
    let (jar, header) = jar.header("example.com", "/a/x", false, 103);
    testing::assert_eq(header, "short=one; first=new");
    let jar = jar.set("example.com", "/a/x", "first=gone; Path=/; Max-Age=0", 104);
    testing::assert_eq(jar.header("example.com", "/a/x", false, 104).1, "short=one");
    testing::assert_eq(jar.len(), 1);
}

#[test]
fn jar_bounds_entries_and_ignores_invalid_max_age() -> () {
    let mut jar = testing::expect_some(cookies::Jar::new(), "jar");
    for index in 0..181 {
        jar = jar.set("example.com", "/", "name" + index.to_string() + "=v", 100);
    }
    testing::assert_eq(jar.len(), 180);
    testing::assert(!jar.header("example.com", "/", false, 101).1.contains("name0=v"));
    testing::assert(jar.header("example.com", "/", false, 101).1.contains("name180=v"));
    let jar = jar.set("example.com", "/", "keep=ok; Max-Age=-nonsense", 101);
    testing::assert(jar.header("example.com", "/", false, 102).1.contains("keep=ok"));
}

#[test]
fn jar_bounds_total_entries_across_domains() -> () {
    let mut jar = testing::expect_some(cookies::Jar::new(), "jar");
    for index in 0..3001 {
        jar = jar.set(
            "host" + (index / 180).to_string() + ".example.com",
            "/",
            "name" + index.to_string() + "=value",
            100,
        );
    }
    testing::assert_eq(jar.len(), 3000);
    testing::assert(!jar.header("host0.example.com", "/", false, 101).1.contains("name0=value"));
    testing::assert(jar.header("host16.example.com", "/", false, 101).1.contains("name3000=value"));
}
