package tests;

use ecosystem::request::cookies;
use std::testing;

#[test]
fn suffix_rules_choose_longest_match_and_exception() -> () {
    let rules = testing::expect_some(
        cookies::SuffixList::parse("// list\ncom\nco.uk\n*.ck\n!www.ck\nblogspot.com\n", 100, 10),
        "suffix rules",
    );
    for (domain, expected) in[
        ("example.com", "com"),
        ("a.example.co.uk", "co.uk"),
        ("foo.ck", "foo.ck"),
        ("www.ck", "ck"),
        ("a.www.ck", "ck"),
        ("me.blogspot.com", "blogspot.com"),
        ("site.unknown", "unknown"),
    ] {
        testing::assert_eq(testing::expect_some(rules.suffix(domain), "suffix"), expected);
    }
}

#[test]
fn suffix_rules_validate_inputs_and_budgets() -> () {
    testing::assert(cookies::SuffixList::parse("com\n", 3, 1).is_none());
    testing::assert(cookies::SuffixList::parse("com\n", 4, 0).is_none());
    testing::assert(cookies::SuffixList::parse("com\nCOM\n", 8, 2).is_none());
    testing::assert(cookies::SuffixList::parse("bad..domain\n", 20, 1).is_none());
    let rules = testing::expect_some(cookies::SuffixList::parse("com\n", 4, 1), "rules");
    for domain in["", ".com", "a..com", "a.com.", "a/com"] {
        testing::assert(rules.suffix(domain).is_none());
    }
}

#[test]
fn bundled_suffix_list_covers_icann_and_private_rules() -> () {
    let rules = testing::expect_some(cookies::default_suffix_list(), "bundled rules");
    for (domain, expected) in[
        ("a.example.com", "com"),
        ("a.example.co.uk", "co.uk"),
        ("www.ck", "ck"),
        ("foo.ck", "foo.ck"),
        ("owner.blogspot.com", "blogspot.com"),
        ("shop.公司.cn", "公司.cn"),
        ("shop.xn--55qx5d.cn", "xn--55qx5d.cn"),
        ("SHOP.РФ", "рф"),
        ("site.unknown", "unknown"),
    ] {
        testing::assert_eq(testing::expect_some(rules.suffix(domain), "suffix"), expected);
    }
}
