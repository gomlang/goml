package cookies;

use std::unicode;

pub struct SuffixList {
    rules: HashMap[string, isize],
}

fn lower_ascii(value: string) -> string {
    let result: Vec[byte] = Vec::new();
    for byte in value.to_bytes() {
        result.push(
            if byte >= b'A' && byte <= b'Z' {
                byte + 32
            } else {
                byte
            },
        );
    }
    string_from_utf8(result).1
}

fn valid_domain(value: string) -> bool {
    if value == "" || value.byte_len() > 253 || value.starts_with(".") || value.ends_with(".") {
        return false
    }
    let mut label_length = 0;
    for byte in value.to_bytes() {
        if byte == b'.' {
            if label_length == 0 || label_length > 63 {
                return false
            }
            label_length = 0;
        } else {
            if byte <= 32 || byte == 127 || byte == b'/' || byte == b'\\' || byte == b':' {
                return false
            }
            label_length += 1;
        }
    }
    label_length > 0 && label_length <= 63
}

fn join_labels(labels: Vec[string], start: isize) -> string {
    let mut result = "";
    for index in start..labels.len() {
        if result != "" {
            result += ".";
        }
        result += labels[index];
    }
    result
}

impl SuffixList {
    pub fn parse(text: string, max_bytes: isize, max_rules: isize) -> Option[SuffixList] {
        if max_bytes < 0 || max_rules < 0 || text.byte_len() > max_bytes {
            return Option::None
        }
        let rules: HashMap[string, isize] = HashMap::new();
        let mut count = 0;
        for line in text.split("\n") {
            let line = line.trim();
            if line == "" || line.starts_with("//") {
                continue
            }
            let (kind, domain) = if line.starts_with("!") {
                (2, line.byte_slice(1, line.byte_len()))
            } else if line.starts_with("*.") {
                (1, line.byte_slice(2, line.byte_len()))
            } else {
                (0, line)
            };
            let domain = unicode::lowercase(domain);
            let key = if kind == 2 {
                "!" + domain
            } else if kind == 1 {
                "*." + domain
            } else {
                domain
            };
            if !valid_domain(domain) || rules.contains(key) || count >= max_rules {
                return Option::None
            }
            rules.set(key, kind);
            count += 1;
        }
        Option::Some(SuffixList { rules })
    }

    pub fn suffix(self: SuffixList, domain: string) -> Option[string] {
        let domain = unicode::lowercase(domain);
        if !valid_domain(domain) {
            return Option::None
        }
        let labels = domain.split(".");
        let mut best_labels = 1;
        let mut exception = false;
        for index in 0..labels.len() {
            let candidate = join_labels(labels, index);
            let label_count = labels.len() - index;
            if self.rules.contains(candidate) && label_count > best_labels {
                best_labels = label_count;
                exception = false;
            }
            if self.rules.contains("!" + candidate) && label_count >= best_labels {
                best_labels = label_count;
                exception = true;
            }
            if index > 0 && self.rules.contains("*." + candidate) && label_count + 1 > best_labels {
                best_labels = label_count + 1;
                exception = false;
            }
        }
        if exception {
            best_labels -= 1;
        }
        Option::Some(join_labels(labels, labels.len() - best_labels))
    }
}
