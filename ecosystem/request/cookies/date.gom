package cookies;

fn decimal(value: string) -> Option[isize] {
    if value == "" {
        return Option::None
    }
    let mut result: isize = 0;
    for byte in value.to_bytes() {
        if byte < b'0' || byte > b'9'
            || result > (9223372036854775807 - (byte - b'0').to_isize()) / 10 {
            return Option::None
        }
        result = result * 10 + (byte - b'0').to_isize();
    }
    Option::Some(result)
}

pub fn cookie_date(value: string) -> Option[i64] {
    let fields = value.replace(",", " ").replace("-", " ").split(" ");
    let parts: Vec[string] = Vec::new();
    for field in fields {
        if field != "" {
            parts.push(field);
        }
    }
    if parts.len() < 5 {
        return Option::None
    }
    let offset = if decimal(parts[0]).is_some() {
        0
    } else {
        1
    };
    if parts.len() < offset + 4 {
        return Option::None
    }
    let asctime = decimal(parts[offset]).is_none();
    let day = decimal(
        parts[offset
            + if asctime {
                1
            } else {
                0
            }],
    )?;
    let month_name = lower_ascii(
        parts[offset
            + if asctime {
                0
            } else {
                1
            }],
    );
    let months = Vec::from_array(
        ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"],
    );
    let mut month = 0;
    for index in 0..months.len() {
        if months[index] == month_name {
            month = index + 1;
        }
    }
    let mut year = decimal(
        parts[offset
            + if asctime {
                3
            } else {
                2
            }],
    )?;
    if year < 70 {
        year += 2000;
    } else if year < 100 {
        year += 1900;
    }
    let clock = parts[offset
        + if asctime {
            2
        } else {
            3
        }].split(":");
    if clock.len() != 3 || month == 0 || year < 1601 || year > 9999 || day < 1 || day > 31 {
        return Option::None
    }
    let hour = decimal(clock[0])?;
    let minute = decimal(clock[1])?;
    let second = decimal(clock[2])?;
    if hour > 23 || minute > 59 || second > 59 {
        return Option::None
    }
    let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
    let lengths = Vec::from_array(
        [
            31,
            if leap {
                29
            } else {
                28
            },
            31,
            30,
            31,
            30,
            31,
            31,
            30,
            31,
            30,
            31,
        ],
    );
    if day > lengths[month - 1] {
        return Option::None
    }
    let prior = year - 1;
    let mut days = (year - 1970) * 365 + prior / 4 - prior / 100 + prior / 400
        - (1969 / 4 - 1969 / 100 + 1969 / 400);
    for index in 0..month - 1 {
        days += lengths[index];
    }
    days += day - 1;
    Option::Some((days * 86400 + hour * 3600 + minute * 60 + second).to_i64())
}
