package request;

use std::testing;

#[test]
fn relative_url_queries_can_contain_absolute_urls() -> () {
    let base = testing::expect_ok(Url::parse("https://example.com/base/file?old=yes"), "base URL");
    for (reference, expected) in[
        ("/login?next=https://other.test/x", "https://example.com/login?next=https://other.test/x"),
        (
            "?redirect_uri=https://client/callback",
            "https://example.com/base/file?redirect_uri=https://client/callback",
        ),
        ("../next?url=http://other.test", "https://example.com/next?url=http://other.test"),
        ("./part:name", "https://example.com/base/part:name"),
        ("//other.test/path?q=http://example.com", "https://other.test/path?q=http://example.com"),
        ("HTTPS://OTHER.test/a", "https://other.test/a"),
        ("#fragment", "https://example.com/base/file?old=yes"),
    ] {
        testing::assert_eq(
            testing::expect_ok(base.join(reference), "relative URL").as_string(),
            expected,
        );
    }
    for reference in[
        "mailto:someone@example.com",
        "data:text/plain,x",
        "https:relative",
        "invalid:part",
        "1invalid:part",
    ] {
        testing::assert_err(base.join(reference));
    }
}

#[test]
fn proxy_bypass_matches_effective_ports_domains_and_numeric_loopback() -> () {
    let plain = testing::expect_ok(Url::parse("http://example.com/path"), "plain URL");
    let secure = testing::expect_ok(Url::parse("https://sub.example.com/path"), "secure URL");
    for entry in["example.com", "example.com:80", "EXAMPLE.COM:080", "*"] {
        testing::assert(proxy_bypass_entry(plain, entry));
    }
    for entry in[
        "example.com:443",
        ".example.com",
        "*.example.com",
        "other.example.com",
        "com:443",
        "",
        "example.com:",
    ] {
        testing::assert(!proxy_bypass_entry(plain, entry));
    }
    for entry in["example.com:443", ".example.com:443", "*.example.com:443", "sub.example.com"] {
        testing::assert(proxy_bypass_entry(secure, entry));
    }
    testing::assert(!proxy_bypass_entry(secure, ".example.com:80"));
    let ipv6 = testing::expect_ok(Url::parse("https://[2001:db8::1]/"), "IPv6 URL");
    testing::assert(proxy_bypass_entry(ipv6, "[2001:db8::1]:443"));
    testing::assert(proxy_bypass_entry(ipv6, "2001:db8:0:0:0:0:0:1"));
    testing::assert(!proxy_bypass_entry(ipv6, "[2001:db8::1]:80"));
    for host in[
        "localhost",
        "127.0.0.1",
        "127.23.45.67",
        "::1",
        "0:0:0:0:0:0:0:1",
        "::ffff:127.0.0.1",
    ] {
        testing::assert(proxy_loopback(host));
    }
    for host in["127.example.com", "localhost.example.com", "128.0.0.1", "2001:db8::1"] {
        testing::assert(!proxy_loopback(host));
    }
}
