package request;

use std::ffi;

#[go_type("example.com/goml-ecosystem/request/adapter", "Client")]
extern type NativeClient;

#[go_type("example.com/goml-ecosystem/request/adapter", "Control")]
extern type NativeControl;

#[go_type("example.com/goml-ecosystem/request/adapter", "Response")]
extern type NativeResponse;

#[go_type("example.com/goml-ecosystem/request/adapter", "Failure")]
extern type NativeFailure;

#[go_ffi("example.com/goml-ecosystem/request/adapter", "NewControl")]
extern fn raw_new_control(nanoseconds: i64) -> NativeControl;

#[go_ffi("example.com/goml-ecosystem/request/adapter", "Cancel")]
extern fn raw_cancel(value: NativeControl) -> ();

#[go_ffi("example.com/goml-ecosystem/request/adapter", "NewClient")]
extern fn raw_new_client(
    connect: i64,
    idle: i64,
    max_idle: isize,
    max_headers: i64,
    gzip: bool,
    cookies: bool,
    ca: ffi::String,
    certificate: ffi::String,
    key: ffi::String,
    proxy: ffi::String,
    environment_proxy: bool,
) -> (NativeClient, NativeFailure);

#[go_ffi("example.com/goml-ecosystem/request/adapter", "Close")]
extern fn raw_close(value: NativeClient) -> ();

#[go_ffi("example.com/goml-ecosystem/request/adapter", "CloseIdle")]
extern fn raw_close_idle(value: NativeClient) -> ();

#[go_ffi("example.com/goml-ecosystem/request/adapter", "IsClosed")]
extern fn raw_is_closed(value: NativeClient) -> bool;

#[go_ffi("example.com/goml-ecosystem/request/adapter", "ParseURL")]
extern fn raw_parse_url(text: ffi::String, base: ffi::String) -> (
    ffi::String,
    ffi::String,
    bool,
    NativeFailure,
);

#[go_ffi("example.com/goml-ecosystem/request/adapter", "Query")]
extern fn raw_query(
    text: ffi::String,
    names: ffi::RawSlice[ffi::String],
    values: ffi::RawSlice[ffi::String],
) -> (ffi::String, NativeFailure);

#[go_ffi("example.com/goml-ecosystem/request/adapter", "EncodeForm")]
extern fn raw_encode_form(names: ffi::RawSlice[ffi::String], values: ffi::RawSlice[ffi::String]) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/request/adapter", "Do")]
extern fn raw_do(
    client: NativeClient,
    control: NativeControl,
    method: ffi::String,
    address: ffi::String,
    names: ffi::RawSlice[ffi::String],
    values: ffi::RawSlice[ffi::String],
    body: ffi::RawSlice[byte],
    limit: i64,
) -> (NativeResponse, NativeFailure);

#[go_ffi("example.com/goml-ecosystem/request/adapter", "ResponseStatus")]
extern fn raw_response_status(value: NativeResponse) -> isize;

#[go_ffi("example.com/goml-ecosystem/request/adapter", "ResponseVersion")]
extern fn raw_response_version(value: NativeResponse) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/request/adapter", "ResponseNames")]
extern fn raw_response_names(value: NativeResponse) -> ffi::RawSlice[ffi::String];

#[go_ffi("example.com/goml-ecosystem/request/adapter", "ResponseValues")]
extern fn raw_response_values(value: NativeResponse) -> ffi::RawSlice[ffi::String];

#[go_ffi("example.com/goml-ecosystem/request/adapter", "ResponseBody")]
extern fn raw_response_body(value: NativeResponse) -> ffi::RawSlice[byte];

#[go_ffi("example.com/goml-ecosystem/request/adapter", "FailureKind")]
extern fn raw_failure_kind(value: NativeFailure) -> isize;

#[go_ffi("example.com/goml-ecosystem/request/adapter", "FailureMessage")]
extern fn raw_failure_message(value: NativeFailure) -> ffi::String;
