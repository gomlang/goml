package request;

use std::ffi;
use std::bytes::{Bytes, FrozenBytes};
use std::json;
use std::serde::{Deserialize};

#[derive(Debug, PartialEq)]
pub enum ErrorKind {
    Builder,
    Timeout,
    Cancelled,
    Transport,
    BodyLimit,
    Redirect,
    Closed,
    Decode,
    Status,
}

pub struct Error {
    pub kind: ErrorKind,
    pub message: string,
    pub status: Option[isize],
}

impl Error {
    pub fn new(kind: ErrorKind, message: string) -> Error {
        Error { kind, message, status: Option::None }
    }
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        self.message
    }
}

fn native_text(value: ffi::String) -> Result[string, Error] {
    ffi::string_text(value).map_err(
        |_| Error::new(ErrorKind::Decode, "invalid UTF-8 in native response"),
    )
}

fn check(value: NativeFailure) -> Result[(), Error] {
    let code = raw_failure_kind(value);
    if code == 0 {
        return Result::Ok(())
    }
    let kind = match code {
        1 => ErrorKind::Builder,
        2 => ErrorKind::Timeout,
        3 => ErrorKind::Cancelled,
        5 => ErrorKind::BodyLimit,
        7 => ErrorKind::Closed,
        _ => ErrorKind::Transport,
    };
    Result::Err(Error::new(kind, native_text(raw_failure_message(value))?))
}

fn ascii_lower(text: string) -> string {
    let result: Vec[byte] = Vec::new();
    for byte in text.to_bytes() {
        result.push(
            if byte >= b'A' && byte <= b'Z' {
                byte + 32
            } else {
                byte
            },
        )
    }
    string_from_utf8(result).1
}

fn token(text: string) -> bool {
    if text.byte_len() == 0 {
        return false
    }
    for byte in text.to_bytes() {
        if !((byte >= b'a' && byte <= b'z') || (byte >= b'A' && byte <= b'Z')
            || (byte >= b'0' && byte <= b'9')
            || byte == b'!'
            || byte == b'#'
            || byte == b'$'
            || byte == b'%'
            || byte == b'&'
            || byte == b'\''
            || byte == b'*'
            || byte == b'+'
            || byte == b'-'
            || byte == b'.'
            || byte == b'^'
            || byte == b'_'
            || byte == b'`'
            || byte == b'|'
            || byte == b'~') {
            return false
        }
    }
    true
}

pub struct Headers {
    entries: Vec[(string, string)],
}

impl Headers {
    pub fn new() -> Headers {
        Headers { entries: Vec::new() }
    }

    pub fn len(self: Headers) -> isize {
        self.entries.len()
    }

    pub fn is_empty(self: Headers) -> bool {
        self.entries.is_empty()
    }

    pub fn entries(self: Headers) -> Vec[(string, string)] {
        let result: Vec[(string, string)] = Vec::new();
        for entry in self.entries {
            result.push(entry)
        }
        result
    }

    pub fn get(self: Headers, name: string) -> Option[string] {
        let key = ascii_lower(name);
        for entry in self.entries {
            if entry.0 == key {
                return Option::Some(entry.1)
            }
        }
        Option::None
    }

    pub fn get_all(self: Headers, name: string) -> Vec[string] {
        let key = ascii_lower(name);
        let result: Vec[string] = Vec::new();
        for entry in self.entries {
            if entry.0 == key {
                result.push(entry.1)
            }
        }
        result
    }

    pub fn contains(self: Headers, name: string) -> bool {
        self.get(name).is_some()
    }

    pub fn remove(self: Headers, name: string) -> Headers {
        let key = ascii_lower(name);
        let entries: Vec[(string, string)] = Vec::new();
        for entry in self.entries {
            if entry.0 != key {
                entries.push(entry)
            }
        }
        Headers { entries }
    }

    pub fn append(self: Headers, name: string, value: string) -> Result[Headers, Error] {
        if !token(name) {
            return Result::Err(Error::new(ErrorKind::Builder, "invalid header name"))
        }
        for byte in value.to_bytes() {
            if byte == 127 || byte < 32 && byte != 9 {
                return Result::Err(Error::new(ErrorKind::Builder, "invalid header value"))
            }
        }
        let entries = self.entries();
        entries.push((ascii_lower(name), value));
        Result::Ok(Headers { entries })
    }

    pub fn insert(self: Headers, name: string, value: string) -> Result[Headers, Error] {
        self.remove(name).append(name, value)
    }
}

fn encode_pairs(pairs: Vec[(string, string)]) -> (
    ffi::RawSlice[ffi::String],
    ffi::RawSlice[ffi::String],
) {
    let names: Vec[ffi::String] = Vec::new();
    let values: Vec[ffi::String] = Vec::new();
    for pair in pairs {
        names.push(ffi::string_from_text(pair.0));
        values.push(ffi::string_from_text(pair.1))
    };
    (ffi::slice_from_vec_copy(names), ffi::slice_from_vec_copy(values))
}

#[derive(Debug, PartialEq)]
pub struct Url {
    text: string,
    origin: string,
    secure: bool,
}

impl Url {
    pub fn parse(text: string) -> Result[Url, Error] {
        parse_url(text, "")
    }

    pub fn join(self: Url, reference: string) -> Result[Url, Error] {
        parse_url(reference, self.text)
    }

    pub fn as_string(self: Url) -> string {
        self.text
    }

    pub fn origin(self: Url) -> string {
        self.origin
    }

    pub fn is_https(self: Url) -> bool {
        self.secure
    }

    pub fn query(self: Url, pairs: Vec[(string, string)]) -> Result[Url, Error] {
        let (names, values) = encode_pairs(pairs);
        let (text, error) = raw_query(ffi::string_from_text(self.text), names, values);
        check(error)?;
        Url::parse(native_text(text)?)
    }
}

impl ToString for Url {
    fn to_string(self: Url) -> string {
        self.text
    }
}

fn parse_url(text: string, base: string) -> Result[Url, Error] {
    let (text, origin, secure, error) = raw_parse_url(
        ffi::string_from_text(text),
        ffi::string_from_text(base),
    );
    check(error)?;
    Result::Ok(Url { text: native_text(text)?, origin: native_text(origin)?, secure })
}

#[derive(Debug, PartialEq)]
pub enum RedirectPolicy {
    None,
    Limited(isize),
    SameOrigin(isize),
}

#[derive(Debug, PartialEq)]
pub struct StatusCode {
    value: isize,
}

impl StatusCode {
    pub fn from_u16(value: u16) -> Result[StatusCode, Error] {
        if value < 100 || value > 599 {
            Result::Err(Error::new(ErrorKind::Builder, "status code outside 100..599"))
        } else {
            Result::Ok(StatusCode { value: value.to_isize() })
        }
    }

    pub fn as_isize(self: StatusCode) -> isize {
        self.value
    }

    pub fn is_informational(self: StatusCode) -> bool {
        self.value >= 100 && self.value < 200
    }

    pub fn is_success(self: StatusCode) -> bool {
        self.value >= 200 && self.value < 300
    }

    pub fn is_redirection(self: StatusCode) -> bool {
        self.value >= 300 && self.value < 400
    }

    pub fn is_client_error(self: StatusCode) -> bool {
        self.value >= 400 && self.value < 500
    }

    pub fn is_server_error(self: StatusCode) -> bool {
        self.value >= 500 && self.value < 600
    }
}

impl ToString for StatusCode {
    fn to_string(self: StatusCode) -> string {
        self.value.to_string()
    }
}

pub struct Response {
    status_value: StatusCode,
    headers_value: Headers,
    body_value: FrozenBytes,
    url_value: Url,
    version_value: string,
    history_value: Vec[Url],
}

impl Response {
    pub fn status(self: Response) -> StatusCode {
        self.status_value
    }

    pub fn headers(self: Response) -> Headers {
        self.headers_value
    }

    pub fn url(self: Response) -> Url {
        self.url_value
    }

    pub fn version(self: Response) -> string {
        self.version_value
    }

    pub fn content_length(self: Response) -> isize {
        self.body_value.len()
    }

    pub fn history(self: Response) -> Vec[Url] {
        let result: Vec[Url] = Vec::new();
        for url in self.history_value {
            result.push(url)
        }
        result
    }

    pub fn bytes(self: Response) -> Bytes {
        self.body_value.thaw()
    }

    pub fn frozen_bytes(self: Response) -> FrozenBytes {
        self.body_value
    }

    pub fn text(self: Response) -> Result[string, Error] {
        let (valid, text) = string_from_utf8(self.body_value.to_vec_copy());
        if valid {
            Result::Ok(text)
        } else {
            Result::Err(Error::new(ErrorKind::Decode, "response is not UTF-8"))
        }
    }

    pub fn json[T: Deserialize](self: Response) -> Result[T, Error] {
        json::from_string(self.text()?).map_err(|message| Error::new(ErrorKind::Decode, message))
    }

    pub fn error_for_status(self: Response) -> Result[Response, Error] {
        if self.status_value.is_client_error() || self.status_value.is_server_error() {
            Result::Err(
                Error {
                    kind: ErrorKind::Status,
                    message: "HTTP status " + self.status_value.to_string(),
                    status: Option::Some(self.status_value.value),
                },
            )
        } else {
            Result::Ok(self)
        }
    }
}

impl Debug for Error {
    fn debug(self: Error) -> string {
        self.message
    }
}
