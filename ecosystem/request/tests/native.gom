package tests;

use std::ffi;
use std::testing;

#[go_type("example.com/goml-ecosystem/request/testserver", "Server")]
extern type Server;

#[go_ffi("example.com/goml-ecosystem/request/testserver", "Start")]
extern fn start(secure: bool, mutual: bool) -> Server;

#[go_ffi("example.com/goml-ecosystem/request/testserver", "URL")]
extern fn native_url(server: Server) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/request/testserver", "Certificate")]
extern fn native_certificate(server: Server) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/request/testserver", "Key")]
extern fn native_key(server: Server) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/request/testserver", "Close")]
extern fn close(server: Server) -> ();

fn url(server: Server) -> string {
    testing::expect_ok(ffi::string_text(native_url(server)), "server URL")
}

fn certificate(server: Server) -> string {
    testing::expect_ok(ffi::string_text(native_certificate(server)), "certificate")
}

fn key(server: Server) -> string {
    testing::expect_ok(ffi::string_text(native_key(server)), "key")
}

#[go_ffi("example.com/goml-ecosystem/request/testserver", "Wait")]
extern fn wait_request(server: Server) -> bool;

#[go_ffi("example.com/goml-ecosystem/request/testserver", "Release")]
extern fn release_requests(server: Server) -> ();

#[go_ffi("example.com/goml-ecosystem/request/testserver", "StartProxy")]
extern fn start_proxy(secure: bool) -> Server;
