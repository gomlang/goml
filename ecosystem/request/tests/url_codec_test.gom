package tests;

use ecosystem::request::{Url, ErrorKind};
use std::testing;

#[test]
fn standard_reference_decomposition_preserves_http_urls() -> () {
    for (input, expected, origin) in[
        ("HTTP://Example.COM", "http://example.com/", "http://example.com:80"),
        ("https://Example.COM:000443?", "https://example.com:000443/?", "https://example.com:443"),
        (
            "http://example.com:/a%2fb?x=%#ignored%",
            "http://example.com:/a%2fb?x=%",
            "http://example.com:80",
        ),
        ("http://[::1]:81/café", "http://[::1]:81/caf%C3%A9", "http://[::1]:81"),
        ("http://example.com/a/../b", "http://example.com/a/../b", "http://example.com:80"),
        (
            "http://example.com/a b?raw=a b",
            "http://example.com/a%20b?raw=a b",
            "http://example.com:80",
        ),
    ] {
        let value = testing::expect_ok(Url::parse(input), "HTTP decomposition");
        testing::assert_eq(value.as_string(), expected);
        testing::assert_eq(value.origin(), origin);
    }
    for input in[
        "http:/a",
        "http:a",
        "http:///a",
        "http://host/%",
        "http://host/%gg",
        "http://host:65536/",
        "http://host:abc/",
        "http://host/a#bad\\fragment",
    ] {
        testing::assert(Url::parse(input).is_err());
    }
    let base = testing::expect_ok(Url::parse("https://example.com/a/b?old"), "base");
    for (link, expected) in[
        ("", "https://example.com/a/b?old"),
        ("#ignored%", "https://example.com/a/b?old"),
        ("?", "https://example.com/a/b?"),
        ("?raw=%", "https://example.com/a/b?raw=%"),
        ("../c%2fd?x=%", "https://example.com/c%2fd?x=%"),
        ("//Other.COM:80/p", "https://other.com:80/p"),
        ("/x//y", "https://example.com/x//y"),
    ] {
        testing::assert_eq(testing::expect_ok(base.join(link), "HTTP join").as_string(), expected);
    }
    testing::assert_eq(base.as_string(), "https://example.com/a/b?old");
}

#[test]
fn standard_query_codecs_preserve_request_policy() -> () {
    let original = testing::expect_ok(
        Url::parse("https://example.com/a%2fb?z=last&x=a+b&x=%2b&&empty&=v"),
        "URL",
    );
    let pairs = Vec::from_array([("x", "third"), ("é", "中"), ("a", "\"'!~")]);
    let updated = testing::expect_ok(original.query(pairs), "query");
    testing::assert_eq(
        updated.as_string(),
        "https://example.com/a%2fb?=v&a=%22%27%21~&empty=&x=a+b&x=%2B&x=third&z=last&%C3%A9=%E4%B8%AD",
    );
    testing::assert_eq(
        original.as_string(),
        "https://example.com/a%2fb?z=last&x=a+b&x=%2b&&empty&=v",
    );
    testing::assert_eq(pairs.len(), 3);
    testing::assert_eq(pairs[0].0, "x");
    for query in["x=%", "x=%0", "x=%gg", "x=%FF", "%FF=x", "x=%C0%AF", "x=a;b"] {
        let value = testing::expect_ok(
            Url::parse("http://example.com/?" + query),
            "raw query remains accepted",
        );
        let error = testing::expect_err(
            value.query(Vec::new()),
            "query decoding rejects invalid text",
        );
        testing::assert_eq(error.kind, ErrorKind::Builder);
    }
    for (query, expected) in[
        ("&&", ""),
        ("x=%00", "x=%00"),
        ("x=%3b", "x=%3B"),
        ("x=one=two", "x=one%3Dtwo"),
    ] {
        let value = testing::expect_ok(Url::parse("http://example.com/?" + query), "raw query");
        testing::assert_eq(
            testing::expect_ok(value.query(Vec::new()), "decoded query").as_string(),
            "http://example.com/?" + expected,
        );
    }
    for input in[
        "mailto:a@example.com",
        "http://u:p@example.com/",
        "http://[fe80::1%25eth0]/",
        "http://example.com:0/",
        "http://example.com/a\\b",
    ] {
        testing::assert(Url::parse(input).is_err());
    }
}
