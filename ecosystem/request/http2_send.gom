package request;

use std::bytes::{Bytes};

fn http2_queue(
    controls: Channel[Http2Frame],
    kind: byte,
    flags: byte,
    stream: isize,
    payload: Bytes,
) -> Result[(), Error] {
    let frame = Http2Frame { kind, flags, stream, payload };
    select {
        send(controls, frame) => Result::Ok(()),
        default => Result::Err(transport_error("HTTP/2 control queue exceeds limit")),
    }
}
