package request;

use ecosystem::request::cookies;
use std::testing;
use std::time;

#[test]
fn cookie_paths_decode_percent_escapes_and_preserve_literal_plus() -> () {
    let url = testing::expect_ok(Url::parse("https://example.com/a%20b/c+d/file"), "URL");
    testing::assert_eq(cookie_path(url), "/a b/c+d/file");
    let client = testing::expect_ok(Client::builder().cookie_store(true).build(), "client");
    defer client.close();
    let headers = testing::expect_ok(
        Headers::new().append("set-cookie", "token=ok; Path=/a b/c+d"),
        "headers",
    );
    store_cookies(client, url, headers);
    testing::assert(
        testing::expect_ok(cookie_headers(client, url, Headers::new()), "cookie headers").get(
            "cookie",
        )
            == Option::Some("token=ok"),
    );
    let unmatched = testing::expect_ok(
        Url::parse("https://example.com/a%20b/c%20d/file"),
        "unmatched path",
    );
    testing::assert(
        !testing::expect_ok(cookie_headers(client, unmatched, Headers::new()), "unmatched cookies").contains(
            "cookie",
        ),
    );
    let encoded_slash = testing::expect_ok(
        Url::parse("https://example.com/a%20b%2Fc+d/file"),
        "escaped slash",
    );
    testing::assert(
        testing::expect_ok(
            cookie_headers(client, encoded_slash, Headers::new()),
            "escaped slash cookies",
        ).get("cookie")
            == Option::Some("token=ok"),
    );
}

#[test]
fn expired_cookies_are_removed_from_the_shared_jar() -> () {
    let client = testing::expect_ok(Client::builder().cookie_store(true).build(), "client");
    defer client.close();
    let url = testing::expect_ok(Url::parse("https://example.com/"), "URL");
    let state = testing::expect_some(client.state.recv(), "state");
    let mut jar = testing::expect_some(state.cookies, "jar");
    let now = time::SystemTime::now().unix_seconds();
    for index in 0..100 {
        jar = jar.set(
            "expired.example.com",
            "/",
            "old" + index.to_string() + "=x; Max-Age=1",
            now - 2,
        );
    }
    jar = jar.set("example.com", "/", "live=yes; Max-Age=86400", now - 2);
    client.state.send(ClientState { cookies: Option::Some(jar), ..state });
    testing::assert(
        testing::expect_ok(cookie_headers(client, url, Headers::new()), "cookies").get("cookie")
            == Option::Some("live=yes"),
    );
    let state = testing::expect_some(client.state.recv(), "pruned state");
    testing::assert_eq(testing::expect_some(state.cookies, "jar").len(), 1);
    client.state.send(state);
    let deletion = testing::expect_ok(
        Headers::new().append("set-cookie", "live=deleted; Max-Age=0"),
        "deletion",
    );
    store_cookies(client, url, deletion);
    let state = testing::expect_some(client.state.recv(), "deleted state");
    testing::assert_eq(testing::expect_some(state.cookies, "jar").len(), 0);
    client.state.send(state);
}

#[test]
fn cookie_expiry_accepts_the_three_http_date_formats() -> () {
    let expected: Option[i64] = Option::Some(784111777);
    for value in[
        "Sun, 06 Nov 1994 08:49:37 GMT",
        "Sunday, 06-Nov-94 08:49:37 GMT",
        "Sun Nov  6 08:49:37 1994",
    ] {
        testing::assert(cookies::cookie_date(value) == expected);
    }
    for value in[
        "Sun, 31 Nov 1994 08:49:37 GMT",
        "Sun, 29 Feb 2023 08:49:37 GMT",
        "Sun Nov 6 25:49:37 1994",
    ] {
        testing::assert(cookies::cookie_date(value).is_none());
    }
    let client = testing::expect_ok(Client::builder().cookie_store(true).build(), "client");
    defer client.close();
    let url = testing::expect_ok(Url::parse("https://example.com/"), "URL");
    let headers = testing::expect_ok(
        Headers::new().append("set-cookie", "old=x; Expires=Sun Nov 6 08:49:37 1994"),
        "expired header",
    );
    store_cookies(client, url, headers);
    testing::assert(
        !testing::expect_ok(cookie_headers(client, url, Headers::new()), "expired cookies").contains(
            "cookie",
        ),
    );
}

#[test]
fn client_cookie_wrapper_matches_domains_and_preserves_manual_cookie() -> () {
    let client = testing::expect_ok(Client::builder().cookie_store(true).build(), "client");
    defer client.close();
    let source = testing::expect_ok(Url::parse("https://shop.example.co.uk/login"), "source");
    let valid = testing::expect_ok(
        Headers::new().append("set-cookie", "shared=ok; Domain=example.co.uk; Path=/"),
        "valid cookie",
    );
    let valid = testing::expect_ok(valid.append("set-cookie", "unsafe=no; Domain=co.uk"), "suffix");
    store_cookies(client, source, valid);
    let target = testing::expect_ok(Url::parse("https://api.example.co.uk/path"), "target");
    let manual = testing::expect_ok(Headers::new().insert("cookie", "manual=yes"), "manual");
    let output = testing::expect_ok(cookie_headers(client, target, manual), "cookie headers");
    testing::assert_eq(
        testing::expect_some(output.get("cookie"), "cookie field"),
        "manual=yes; shared=ok",
    );
    let outside = testing::expect_ok(Url::parse("https://other.co.uk/path"), "outside");
    testing::assert(
        !testing::expect_ok(cookie_headers(client, outside, Headers::new()), "outside cookie").contains(
            "cookie",
        ),
    );
}
