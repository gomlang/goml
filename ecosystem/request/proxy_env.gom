package request;

use std::env;
use std::net;

fn proxy_env_value(upper: string, lower: string) -> string {
    let value = env::var_structured(upper).unwrap_or("");
    if value == "" {
        env::var_structured(lower).unwrap_or("")
    } else {
        value
    }
}

fn proxy_loopback(host: string) -> bool {
    if host == "localhost" {
        return true
    }
    match net::IpAddr::parse(host) {
        Ok(net::IpAddr::V4(parts)) => parts[0] == 127,
        Ok(net::IpAddr::V6(parts)) => parts == [0, 0, 0, 0, 0, 0, 0, 1]
            || parts[0] == 0 && parts[1] == 0 && parts[2] == 0 && parts[3] == 0 && parts[4] == 0
                && parts[5] == 65535
                && parts[6] >> 8 == 127,
        Err(_) => false,
    }
}

fn proxy_bypass_entry(url: Url, value: string) -> bool {
    let value = ascii_lower(value.trim());
    if value == "*" {
        return true
    }
    if value == "" {
        return false
    }
    let mut host = value;
    let mut port = "";
    if value.starts_with("[") {
        let pair = match value.byte_slice(1, value.byte_len()).split_once("]") {
            Some(pair) => pair,
            None => return false,
        };
        host = pair.0;
        if pair.1.starts_with(":") {
            port = pair.1.byte_slice(1, pair.1.byte_len());
            if port == "" {
                return false
            }
        } else if pair.1 != "" {
            return false
        }
    } else if net::IpAddr::parse(value).is_err() {
        if let Some((name, number)) = value.split_once(":") {
            host = name;
            port = number;
            if port == "" {
                return false
            }
        }
    }
    if port != "" {
        match decimal(port) {
            Ok(value) => if value != url.port.to_isize() {
                return false
            },
            Err(_) => return false,
        }
    }
    if let Ok(address) = net::IpAddr::parse(host) {
        return match net::IpAddr::parse(url.host) {
            Ok(target) => target == address,
            Err(_) => false,
        }
    }
    if host.starts_with("*.") {
        host = host.byte_slice(1, host.byte_len());
    }
    if host.starts_with(".") {
        url.host.ends_with(host)
    } else {
        host != "" && (url.host == host || url.host.ends_with("." + host))
    }
}

fn environment_proxy_url(url: Url) -> Result[Option[Url], Error] {
    if proxy_loopback(url.host) {
        return Result::Ok(Option::None)
    }
    for entry in proxy_env_value("NO_PROXY", "no_proxy").split(",") {
        if proxy_bypass_entry(url, entry) {
            return Result::Ok(Option::None)
        }
    }
    let value = if url.secure {
        proxy_env_value("HTTPS_PROXY", "https_proxy")
    } else {
        proxy_env_value("HTTP_PROXY", "http_proxy")
    };
    if value == "" {
        return Result::Ok(Option::None)
    }
    if !url.secure && env::var_structured("REQUEST_METHOD").unwrap_or("") != "" {
        return Result::Err(
            Error::new(ErrorKind::Builder, "HTTP proxy environment is disabled in CGI"),
        )
    }
    Url::parse(
        if value.contains("://") {
            value
        } else {
            "http://" + value
        },
    ).map(Option::Some)
}
