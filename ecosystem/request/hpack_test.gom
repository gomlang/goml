package request;

use std::bytes::{Bytes};
use std::testing;

fn hpack_hex(value: string) -> Bytes {
    let output = Bytes::new();
    let mut offset = 0;
    while offset < value.byte_len() {
        output.push(
            (hex_digit(value.byte_get(offset)) * 16 + hex_digit(value.byte_get(offset + 1))).to_u8(),
        );
        offset += 2;
    }
    output
}

#[test]
fn hpack_rfc7541_huffman_and_dynamic_table_examples() -> () {
    let decoder = Hpack::new();
    let first = testing::expect_ok(
        decoder.decode(hpack_hex("828684418cf1e3c2e5f23a6ba0ab90f4ff"), 4096),
        "RFC 7541 C.4.1",
    );
    testing::assert(
        first
            == Vec::from_array(
                [
                    (":method", "GET"),
                    (":scheme", "http"),
                    (":path", "/"),
                    (":authority", "www.example.com"),
                ],
            ),
    );
    let second = testing::expect_ok(
        decoder.decode(hpack_hex("828684be5886a8eb10649cbf"), 4096),
        "RFC 7541 C.4.2",
    );
    testing::assert(second[3] == (":authority", "www.example.com"));
    testing::assert(second[4] == ("cache-control", "no-cache"));
    let third = testing::expect_ok(
        decoder.decode(hpack_hex("828785bf408825a849e95ba97d7f8925a849e95bb8e8b4bf"), 4096),
        "RFC 7541 C.4.3",
    );
    testing::assert(
        third
            == Vec::from_array(
                [
                    (":method", "GET"),
                    (":scheme", "https"),
                    (":path", "/index.html"),
                    (":authority", "www.example.com"),
                    ("custom-key", "custom-value"),
                ],
            ),
    );
}

#[test]
fn hpack_rejects_invalid_indices_huffman_and_table_updates() -> () {
    for malformed in Vec::from_array(
        [
            "80",
            "be",
            "ff",
            "ff80808080808080808080",
            "200001610162be",
            "8220",
            "3fe21f",
            "0084fffffffc0161",
            "0081ff0161",
            "00811e0161",
        ],
    ) {
        testing::assert_err(Hpack::new().decode(hpack_hex(malformed), 4096));
    }
    testing::assert_err(Hpack::new().decode(hpack_hex("828684418cf1e3c2e5f23a6ba0ab90f4ff"), 100));
    testing::assert_err(hpack_huffman(hpack_hex("f1e3c2e5f23a6ba0ab90f4ff").as_slice(), 3));
}

#[test]
fn hpack_literals_preserve_duplicate_sensitive_and_unicode_fields() -> () {
    let expected = Vec::from_array(
        [
            (":status", "200"),
            ("set-cookie", "a=1"),
            ("set-cookie", "b=2"),
            ("authorization", "Bearer secret"),
            ("x-unicode", "中😀"),
        ],
    );
    let decoder = Hpack::new();
    testing::assert(
        testing::expect_ok(decoder.decode(hpack_encode(expected), 4096), "literals") == expected,
    );
    testing::assert_eq(decoder.entries.len(), 0);
    testing::assert_eq(
        testing::expect_ok(decoder.decode(hpack_hex("203fe11f"), 0), "table resize").len(),
        0,
    );
    testing::assert_eq(decoder.sizes[1], 4096);
}

#[test]
fn http2_response_headers_reject_invalid_pseudo_fields_and_connections() -> () {
    for fields in Vec::from_array(
        [
            Vec::from_array([("x-first", "value"), (":status", "200")]),
            Vec::from_array([(":status", "200"), (":status", "201")]),
            Vec::from_array([(":method", "GET")]),
            Vec::from_array([(":status", "101")]),
            Vec::from_array([(":status", "200"), ("Connection", "close")]),
            Vec::from_array([(":status", "200"), ("transfer-encoding", "chunked")]),
            Vec::from_array([(":status", "200"), ("x-bad", "line\r\n")]),
        ],
    ) {
        testing::assert_err(http2_response_headers(fields, false));
    }
    testing::assert_err(http2_response_headers(Vec::from_array([(":status", "200")]), true));
    testing::assert_err(http2_response_headers(Vec::from_array([("content-length", "1")]), true));
}
