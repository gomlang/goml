package request;

use ecosystem::request::cookies;
use std::time;

fn cookie_path(url: Url) -> string {
    let path = url.target.split_once("?").map(|pair| pair.0).unwrap_or(url.target);
    let source = path.to_bytes();
    let decoded: Vec[byte] = Vec::new();
    let mut index = 0;
    while index < source.len() {
        if source[index] == b'%' && index + 2 < source.len() && hex_digit(source[index + 1]) >= 0
            && hex_digit(source[index + 2]) >= 0 {
            decoded.push((hex_digit(source[index + 1]) * 16 + hex_digit(source[index + 2])).to_u8());
            index += 3;
        } else {
            decoded.push(source[index]);
            index += 1;
        }
    }
    let (valid, value) = string_from_utf8(decoded);
    if valid {
        value
    } else {
        path
    }
}

fn cookie_headers(client: Client, url: Url, headers: Headers) -> Result[Headers, Error] {
    let state = client.state.recv().unwrap_or(
        ClientState { idle: Vec::new(), cookies: Option::None },
    );
    let jar = match state.cookies {
        Some(jar) => jar,
        None => {
            client.state.send(state);
            return Result::Ok(headers)
        },
    };
    let (jar, stored) = jar.header(
        url.host,
        cookie_path(url),
        url.secure,
        time::SystemTime::now().unix_seconds(),
    );
    let state = ClientState { cookies: Option::Some(jar), ..state };
    defer client.state.send(state);
    if stored == "" {
        return Result::Ok(headers)
    }
    let existing = headers.get("cookie").unwrap_or("");
    headers.insert(
        "cookie",
        if existing == "" {
            stored
        } else {
            existing + "; " + stored
        },
    )
}

fn store_cookies(client: Client, url: Url, headers: Headers) -> () {
    let state = client.state.recv().unwrap_or(
        ClientState { idle: Vec::new(), cookies: Option::None },
    );
    let mut jar = match state.cookies {
        Some(jar) => jar,
        None => {
            client.state.send(state);
            return
        },
    };
    let now = time::SystemTime::now().unix_seconds();
    for text in headers.get_all("set-cookie") {
        jar = jar.set(url.host, cookie_path(url), text, now);
    }
    client.state.send(ClientState { cookies: Option::Some(jar), ..state });
}
