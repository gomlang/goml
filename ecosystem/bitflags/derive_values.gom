package bitflags;

#[comptime_derive]
fn flag_method_name(name: string) -> string {
    let mut result = "flag_";
    for index in 0..name.byte_len() {
        let value = name.byte_get(index);
        if value >= b'A' && value <= b'Z' {
            let offset = (value - b'A').to_isize();
            result += "abcdefghijklmnopqrstuvwxyz".byte_slice(offset, offset + 1);
        } else if (value >= b'a' && value <= b'z') || (value >= b'0' && value <= b'9')
            || value == b'_' {
            result += name.byte_slice(index, index + 1);
        } else {
            compile_error("FlagValues requires ASCII flag names")
        }
    }
    result
}

#[comptime_derive(FlagValues)]
pub fn derive_flag_values(input: DeriveInput) -> DeriveOutput {
    let _ = derive_flags(input);
    let storage = meta_type_name(derive_field_type(input, 0));
    let width = storage_width(storage);
    let mask: u64 = if width == 64 {
        18446744073709551615
    } else {
        (1.to_u64() << width) - 1
    };
    let output = derive_output_inherent(input);
    for item in 0..derive_attribute_count(input) {
        let attribute = derive_attribute(input, item);
        if meta_attribute_name(attribute) != "flags" {
            continue;
        }
        for index in 0..meta_attribute_argument_count(attribute) {
            let name = meta_attribute_argument_name(attribute, index);
            if name == "unnamed" {
                continue;
            }
            let method_name = flag_method_name(name);
            for previous in 0..index {
                let previous_name = meta_attribute_argument_name(attribute, previous);
                if previous_name != "unnamed" && flag_method_name(previous_name) == method_name {
                    compile_error("FlagValues accessor collision: " + method_name)
                }
            }
            let bits = mask_expr(declaration_value(attribute, index, mask));
            let value = if storage == "u64" {
                bits
            } else {
                meta_expr_method_call(
                    bits,
                    "to_"
                        + if storage == "byte" {
                            "u8"
                        } else {
                            storage
                        },
                    meta_expr_list_new(),
                )
            };
            let fields = meta_expr_field_list_new();
            meta_expr_field_list_push(fields, derive_field_name(input, 0), value);
            derive_output_add_public_method(
                output,
                meta_method(
                    method_name,
                    meta_param_list_new(),
                    derive_target_type(input),
                    meta_expr_target_struct(input, fields),
                ),
            );
        }
    }
    output
}
