package bitflags;

pub struct IterNames[F] {
    source: F,
    flags: Vec[Flag],
    index: Ref[isize],
    remaining_bits: Ref[u64],
}

fn names[F: Flags](source: F) -> IterNames[F] {
    IterNames {
        source,
        flags: source.definitions(),
        index: Ref::new(0),
        remaining_bits: Ref::new(source.bits()),
    }
}

impl[F: Flags] IterNames[F] {
    pub fn remaining(self: IterNames[F]) -> F {
        Flags::from_bits_retain(self.remaining_bits.get())
    }
}

impl[F: Flags] Iterator for IterNames[F] {
    type Item = (string, F);

    fn next(self: IterNames[F]) -> Option[(string, F)] {
        while self.index.get() < self.flags.len() {
            let flag = self.flags[self.index.get()];
            self.index.set(self.index.get() + 1);
            let bits = flag.bits();
            if flag.is_named() && (self.source.bits() & bits) == bits
                && (self.remaining_bits.get() & bits) != 0 {
                self.remaining_bits.set(self.remaining_bits.get() & ~bits);
                return Option::Some((flag.name(), Flags::from_bits_retain(bits)))
            }
        }
        Option::None
    }
}

pub struct Iter[F] {
    names: IterNames[F],
    finished: Ref[bool],
}

impl[F: Flags] Iterator for Iter[F] {
    type Item = F;

    fn next(self: Iter[F]) -> Option[F] {
        if self.finished.get() {
            return Option::None
        }
        if let Some(entry) = self.names.next() {
            return Option::Some(entry.1)
        }
        self.finished.set(true);
        let remaining = self.names.remaining();
        if remaining.is_empty() {
            Option::None
        } else {
            Option::Some(remaining)
        }
    }
}

fn defined_names[F: Flags](source: F) -> FnIterator[(string, F)] {
    let flags = source.definitions();
    let index = Ref::new(0);
    FnIterator::from_fn(
        || {
            while index.get() < flags.len() {
                let flag = flags[index.get()];
                index.set(index.get() + 1);
                if flag.is_named() {
                    return Option::Some((flag.name(), Flags::from_bits_retain(flag.bits())))
                }
            }
            Option::None
        },
    )
}

fn equal_names[F: Flags](source: F) -> FnIterator[string] {
    let entries = defined_names(source);
    FnIterator::from_fn(
        || {
            while let Some(entry) = entries.next() {
                if entry.1.bits() == source.bits() {
                    return Option::Some(entry.0)
                }
            }
            Option::None
        },
    )
}
