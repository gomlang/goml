package tests;

use ecosystem::bitflags;
use bitflags::Flags;
use std::testing;
use std::json;
use std::bincode;

#[derive(Flags)]
#[flags(ALL = "~0")]
struct U16 {
    bits: u16,
}

#[derive(Flags)]
#[flags(ALL = "~0")]
struct U32 {
    bits: u32,
}

#[derive(Flags)]
#[flags(ALL = "~0")]
struct Usize {
    bits: usize,
}

#[derive(Flags)]
#[flags(ALL = "~0")]
struct I16 {
    bits: i16,
}

#[derive(Flags)]
#[flags(ALL = "~0")]
struct I32 {
    bits: i32,
}

#[derive(Flags)]
#[flags(ALL = "~0")]
struct I64 {
    bits: i64,
}

#[derive(Flags)]
#[flags(ALL = "~0")]
struct Isize {
    bits: isize,
}

#[derive(Flags)]
#[flags(ALL = "~0")]
struct Byte {
    bits: byte,
}

fn width[F: bitflags::Flags](sample: F, bytes: isize, maximum: u64) -> () {
    testing::assert_eq(sample.storage_mask(), maximum);
    let value: F = Flags::from_bits_retain(maximum);
    testing::assert_eq(value.bits(), maximum);
    let encoded = testing::expect_ok(
        bincode::encode_to_vec(bitflags::Number { value }, bincode::legacy()),
        "encode integer width",
    );
    testing::assert_eq(encoded.len(), bytes);
    let (decoded, consumed): (bitflags::Number[F], isize) = testing::expect_ok(
        bincode::decode_from_slice(encoded.as_slice(), bincode::legacy()),
        "decode integer width",
    );
    testing::assert_eq(consumed, bytes);
    testing::assert_eq(decoded.value.bits(), maximum);
    let text = testing::expect_ok(json::try_to_string(bitflags::Number { value }), "JSON width");
    let decoded: bitflags::Number[F] = testing::expect_ok(
        json::from_string(text),
        "JSON decode width",
    );
    testing::assert_eq(decoded.value.bits(), maximum);
}

#[test]
fn all_integer_storage_widths_preserve_bit_patterns() -> () {
    width(U16::empty(), 2, 65535);
    width(U32::empty(), 4, 4294967295);
    width(Usize::empty(), 8, 18446744073709551615);
    width(I16::empty(), 2, 65535);
    width(I32::empty(), 4, 4294967295);
    width(I64::empty(), 8, 18446744073709551615);
    width(Isize::empty(), 8, 18446744073709551615);
    width(Byte::empty(), 1, 255);
}
