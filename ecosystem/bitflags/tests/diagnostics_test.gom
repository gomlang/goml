package tests;

use std::env;
use std::fs;
use std::json;
use std::path;
use std::process;
use std::testing;
use std::time;
use std::utf8;
use utf8::BytesUtf8;

#[test]
fn rejected_derive_inputs_report_precise_diagnostics() -> () {
    let module_root = testing::expect_ok(env::current_dir_structured(), "module directory");
    let driver = env::var_structured("GOML_VERIFY_DRIVER").unwrap_or(
        testing::expect_ok(fs::canonicalize("../../stage2/bin/goml"), "driver"),
    );
    let source = testing::expect_ok(
        fs::read_file_structured("tests/data/diagnostics.jsonl"),
        "diagnostic fixtures",
    );
    let directory = path::join(module_root, "_artifact/native-diagnostics");
    testing::assert_ok(fs::create_dir_all(directory));
    defer {
        testing::assert_ok(fs::remove_dir_all(directory));
    };
    let manifest = "[module]\npath=\"diagnostics::bitflags\"\n[dependencies]\n\"ecosystem::bitflags\"=\"0.1.0\"\n";
    testing::assert_ok(fs::write_file_structured(path::join(directory, "goml.toml"), manifest));
    let mut count = 0;
    for line in source.split("\n") {
        if line == "" {
            continue;
        }
        let row = testing::expect_some(
            json::as_array(testing::expect_ok(json::parse(line), "case JSON")),
            "case",
        );
        let declaration = testing::expect_some(json::as_string(row[0]), "declaration");
        let expected = testing::expect_some(json::as_string(row[1]), "diagnostic");
        let declaration = "#[derive(bitflags::"
            + testing::expect_some(json::as_string(row[2]), "derive")
            + ")]\n"
            + declaration;
        testing::assert_ok(
            fs::write_file_structured(
                path::join(directory, "main.gom"),
                "package main;\nuse ecosystem::bitflags;\n" + declaration + "\nfn main() -> () {}\n",
            ),
        );
        let formatted = testing::expect_ok(
            process::Command::new(driver).arg("fmt").current_dir(directory).output_timeout_structured(
                time::Duration::from_seconds(60),
            ),
            "format diagnostic fixture",
        );
        testing::assert(formatted.status().success());
        let output = testing::expect_ok(
            process::Command::new(driver).arg("check").current_dir(directory).output_timeout_structured(
                time::Duration::from_seconds(60),
            ),
            "compiler process",
        );
        let message = testing::expect_ok(output.stdout().to_string_utf8(), "stdout")
            + testing::expect_ok(output.stderr().to_string_utf8(), "stderr");
        if output.status().success() || !message.contains(expected) {
            testing::fail("case " + count.to_string() + " expected " + expected + ": " + message);
        }
        count += 1;
    }
    testing::assert_eq(count, 19);
}
