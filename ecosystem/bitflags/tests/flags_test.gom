package tests;

use ecosystem::bitflags;
use bitflags::Flags;
use std::testing;
use std::json;
use std::bincode;

#[derive(Flags, Debug, PartialEq, Eq, Hash, Default)]
#[flags(NONE = "0", READ = "1", WRITE = "0b10", BOTH = "READ | WRITE", ALIAS = "READ", GROUP = "0x0c", unnamed = "0x40")]
struct Access {
    raw: u8,
}

#[derive(Flags)]
#[flags(A = "1", AB = "3")]
struct Overlap {
    raw: u8,
}

#[derive(Flags)]
#[flags()]
struct Empty {
    raw: u8,
}

#[derive(Flags)]
#[flags(A = "1", unnamed = "~0")]
struct External {
    raw: u64,
}

#[derive(Flags)]
#[flags(HIGH = "0x8000000000000000", ALL = "~0")]
struct Wide {
    raw: u64,
}

#[derive(Flags)]
#[flags(HIGH = "0x80", ALL = "~0")]
struct Signed {
    raw: i8,
}

#[test]
fn constructors_and_unknown_bits() -> () {
    testing::assert_eq(Access::empty().bits(), 0);
    testing::assert_eq(Access::all().bits(), 79);
    testing::assert_eq(Access::all_named().bits(), 15);
    testing::assert_none(Access::from_bits(128));
    testing::assert_none(Access::from_bits(256));
    testing::assert_some(Access::from_bits(64));
    testing::assert_eq(Access::from_bits_retain(511).bits(), 255);
    testing::assert_eq(Access::from_bits_truncate(255).bits(), 79);
    let value = Access::from_bits_retain(255);
    testing::assert_eq(value.known_bits(), 79);
    testing::assert_eq(value.unknown_bits(), 176);
    testing::assert(value.contains_unknown_bits());
    testing::assert(value.is_all());
    testing::assert_eq(value.truncate().bits(), 79);
    testing::assert_eq(value.clear().bits(), 0);
    testing::assert_eq(Access::default().bits(), 0);
}

#[test]
fn exhaustive_set_algebra_and_predicates() -> () {
    for left in 0..256 {
        let a = Access::from_bits_retain(left.to_u64());
        testing::assert_eq(a.complement().bits(), (~left.to_u64()) & 79);
        for right in 0..256 {
            let b = Access::from_bits_retain(right.to_u64());
            testing::assert_eq(a.union(b).bits(), (left | right).to_u64());
            testing::assert_eq(a.intersection(b).bits(), (left & right).to_u64());
            testing::assert_eq(a.difference(b).bits(), (left & ~right).to_u64());
            testing::assert_eq(a.symmetric_difference(b).bits(), (left ^ right).to_u64());
            testing::assert_eq(a.contains(b), (left & right) == right);
            testing::assert_eq(a.intersects(b), (left & right) != 0);
        }
    }
}

#[test]
fn updates_are_values_and_flags_are_hash_keys() -> () {
    let read = testing::expect_some(Access::from_name("READ"), "READ");
    let write = testing::expect_some(Access::from_name("WRITE"), "WRITE");
    let original = read;
    let mut value = read.insert(write);
    value = value.toggle(read).set(read, true).remove(write);
    testing::assert_eq(value, original);
    testing::assert_eq(value.set(read, false), Access::empty());
    let map: HashMap[Access, string] = HashMap::new();
    map.set(read, "read");
    testing::assert(map.get(Access::from_bits_retain(1)) == Option::Some("read"));
    testing::assert_none(Access::from_name("_"));
    testing::assert_none(Access::from_name("read"));
    testing::assert(read.contains(Access::empty()));
    testing::assert(!read.intersects(Access::empty()));
}

#[test]
fn ordered_iteration_aliases_overlap_and_remainder() -> () {
    let value = Access::from_bits_retain(255);
    let names = value.iter_names();
    let mut text = "";
    while let Some(entry) = names.next() {
        text += entry.0 + ",";
    }
    testing::assert_eq(text, "READ,WRITE,GROUP,");
    testing::assert_eq(names.remaining().bits(), 240);
    testing::assert_none(names.next());
    let restored: Access = bitflags::collect(value.iter());
    testing::assert_eq(restored, value);
    let overlap = Overlap::from_bits_retain(3).iter_names();
    testing::assert_eq(testing::expect_some(overlap.next(), "A").0, "A");
    testing::assert_eq(testing::expect_some(overlap.next(), "AB").0, "AB");
    testing::assert_eq(overlap.remaining().bits(), 0);
    testing::assert_none(overlap.next());
    let equal = Access::from_bits_retain(1).iter_equal_names();
    testing::assert_eq(testing::expect_some(equal.next(), "READ"), "READ");
    testing::assert_eq(testing::expect_some(equal.next(), "ALIAS"), "ALIAS");
    testing::assert_none(equal.next());
    let entries = Access::iter_defined_names();
    let mut count = 0;
    while let Some(_) = entries.next() {
        count += 1;
    }
    testing::assert_eq(count, 6);
}

#[test]
fn iterators_are_fused_and_copies_share_progress() -> () {
    let names = Access::from_bits_retain(3).iter_names();
    let copy = names;
    testing::assert_eq(testing::expect_some(names.next(), "first").0, "READ");
    testing::assert_eq(testing::expect_some(copy.next(), "second").0, "WRITE");
    testing::assert_none(names.next());
    let bits = Access::from_bits_retain(128).iter();
    testing::assert_eq(testing::expect_some(bits.next(), "remainder").bits(), 128);
    testing::assert_none(bits.next());
    testing::assert_none(bits.next());
}

#[test]
fn zero_empty_unnamed_and_full_width_masks() -> () {
    testing::assert(Empty::empty().is_all());
    testing::assert_none(Empty::from_bits(1));
    testing::assert_eq(Empty::from_bits_retain(8).format(), "0x8");
    testing::assert_eq(Access::empty().format(), "");
    testing::assert_eq(Access::empty().debug_flags(), "Access(0x0)");
    testing::assert_eq(External::all().bits(), 18446744073709551615);
    testing::assert_eq(External::all_named().bits(), 1);
    testing::assert_eq(Wide::from_bits_retain(9223372036854775808).format(), "HIGH");
    testing::assert_eq(Wide::all().format(), "HIGH | ALL");
    testing::assert_eq(Signed { raw: -1 }.bits(), 255);
    testing::assert_eq(Signed::from_bits_retain(128).raw, -128);
    testing::assert_eq(Signed::from_bits_retain(128).format(), "HIGH");
}

#[test]
fn text_round_trips_all_byte_values() -> () {
    for bits in 0..256 {
        let value = Access::from_bits_retain(bits.to_u64());
        let decoded: Access = testing::expect_ok(bitflags::parse(value.format()), "round trip");
        testing::assert_eq(decoded, value);
        let truncated: Access = testing::expect_ok(
            bitflags::parse_truncate(value.format()),
            "truncate",
        );
        testing::assert_eq(truncated, value.truncate());
    }
    testing::assert_eq(Access::from_bits_retain(255).format(), "READ | WRITE | GROUP | 0xf0");
    testing::assert_eq(
        bitflags::format_truncate(Access::from_bits_retain(255)),
        "READ | WRITE | GROUP | 0x40",
    );
    testing::assert_eq(
        bitflags::format_strict(Access::from_bits_retain(255)),
        "READ | WRITE | GROUP",
    );
    let value: Access = testing::expect_ok(bitflags::parse("  READ |\t0x+02 "), "whitespace");
    testing::assert_eq(value.bits(), 3);
}

#[test]
fn parser_errors_have_byte_positions() -> () {
    for input in Vec::from_array(
        ["|", "READ|", "|READ", "READ||WRITE", "0x", "0x100", "0x-1", "0x1_0", "read", "0X01"],
    ) {
        let result: Result[Access, bitflags::ParseError] = bitflags::parse(input);
        testing::assert_err(result);
    }
    let bad: Result[Access, bitflags::ParseError] = bitflags::parse("READ | wat");
    let error = testing::expect_err(bad, "unknown name");
    testing::assert_eq(error.offset, 7);
    testing::assert_eq(error.kind, bitflags::ParseErrorKind::UnknownName);
    let strict: Result[Access, bitflags::ParseError] = bitflags::parse_strict("0x1");
    testing::assert_eq(
        testing::expect_err(strict, "strict").kind,
        bitflags::ParseErrorKind::HexNotAllowed,
    );
    let checked: Result[Access, bitflags::ParseError] = bitflags::parse_checked("0x80");
    testing::assert_eq(
        testing::expect_err(checked, "unknown bits").kind,
        bitflags::ParseErrorKind::UnknownBits,
    );
}

#[test]
fn serde_text_and_storage_width_numbers() -> () {
    let value = Access::from_bits_retain(129);
    let text = bitflags::Text { value };
    let encoded = testing::expect_ok(json::try_to_string(text), "text JSON");
    testing::assert_eq(encoded, "\"READ | 0x80\"");
    let decoded: bitflags::Text[Access] = testing::expect_ok(
        json::from_string(encoded),
        "decode text",
    );
    testing::assert(decoded == text);
    let number = bitflags::Number { value };
    testing::assert_eq(testing::expect_ok(json::try_to_string(number), "number JSON"), "129");
    let bytes = testing::expect_ok(
        bincode::encode_to_vec(number, bincode::legacy()),
        "binary number",
    );
    testing::assert_eq(bytes.len(), 1);
    testing::assert_eq(bytes[0], 129);
    let (decoded, consumed): (bitflags::Number[Access], isize) = testing::expect_ok(
        bincode::decode_from_slice(bytes.as_slice(), bincode::legacy()),
        "binary decode",
    );
    testing::assert(decoded == number);
    testing::assert_eq(consumed, 1);
    let bad: Result[bitflags::Number[Access], string] = json::from_string("256");
    testing::assert_err(bad);
}

#[test]
fn serde_auto_selects_text_and_binary_representations() -> () {
    let value: Access = Flags::from_bits_retain(129);
    let automatic = bitflags::Auto { value };
    let text = testing::expect_ok(json::try_to_string(automatic), "automatic text");
    testing::assert_eq(
        text,
        testing::expect_ok(json::try_to_string(bitflags::Text { value }), "explicit text"),
    );
    let decoded: bitflags::Auto[Access] = testing::expect_ok(
        json::from_string(text),
        "automatic text decode",
    );
    testing::assert_eq(decoded.value.bits(), value.bits());
    let binary = testing::expect_ok(
        bincode::encode_to_vec(automatic, bincode::legacy()),
        "automatic binary",
    );
    testing::assert(binary == Vec::from_array([129.to_u8()]));
    let decoded: (bitflags::Auto[Access], isize) = testing::expect_ok(
        bincode::decode_from_slice(binary.as_slice(), bincode::legacy()),
        "automatic binary decode",
    );
    testing::assert_eq(decoded.0.value.bits(), value.bits());
}
