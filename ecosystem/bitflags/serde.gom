package bitflags;

use std::serde::{Serialize, Deserialize, Serializer, Deserializer};

#[derive(PartialEq, Eq, Hash)]
pub struct Text[F] {
    pub value: F,
}

#[derive(PartialEq, Eq, Hash)]
pub struct Number[F] {
    pub value: F,
}

impl[F: Flags] Serialize for Text[F] {
    fn serialize[S: Serializer](self: Text[F], serializer: S) -> Result[(), string] {
        serializer.serialize_string(self.value.format())
    }
}

impl[F: Flags] Deserialize for Text[F] {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[Text[F], string] {
        let text = deserializer.deserialize_string()?;
        let value: F = parse(text).map_err(|error| deserializer.error(error.to_string()))?;
        Result::Ok(Text { value })
    }
}

impl[F: Flags] Serialize for Number[F] {
    fn serialize[S: Serializer](self: Number[F], serializer: S) -> Result[(), string] {
        let bits = self.value.bits();
        match self.value.storage_mask() {
            255 => serializer.serialize_uint8(bits.to_u8()),
            65535 => serializer.serialize_uint16(bits.to_u16()),
            4294967295 => serializer.serialize_uint32(bits.to_u32()),
            _ => serializer.serialize_uint64(bits),
        }
    }
}

impl[F: Flags] Deserialize for Number[F] {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[Number[F], string] {
        let empty: F = Flags::empty();
        let bits = match empty.storage_mask() {
            255 => deserializer.deserialize_uint8()?.to_u64(),
            65535 => deserializer.deserialize_uint16()?.to_u64(),
            4294967295 => deserializer.deserialize_uint32()?.to_u64(),
            _ => deserializer.deserialize_uint64()?,
        };
        Result::Ok(Number { value: Flags::from_bits_retain(bits) })
    }
}
