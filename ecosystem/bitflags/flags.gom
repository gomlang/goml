package bitflags;

#[derive(Debug, PartialEq, Eq)]
pub struct Flag {
    name_value: string,
    bits_value: u64,
}

impl Flag {
    pub fn new(name: string, bits: u64) -> Flag {
        Flag { name_value: name, bits_value: bits }
    }

    pub fn name(self: Flag) -> string {
        self.name_value
    }

    pub fn bits(self: Flag) -> u64 {
        self.bits_value
    }

    pub fn is_named(self: Flag) -> bool {
        self.name_value != ""
    }
}

pub trait Flags {
    fn bits(self: Self) -> u64;
    fn from_bits_retain(bits: u64) -> Self;
    fn storage_mask(self: Self) -> u64;
    fn definitions(self: Self) -> Vec[Flag];
    fn type_name(self: Self) -> string;
    fn known_mask(self: Self) -> u64 {
        let mut mask: u64 = 0;
        for flag in self.definitions() {
            mask |= flag.bits();
        }
        mask
    }
    fn named_mask(self: Self) -> u64 {
        let mut mask: u64 = 0;
        for flag in self.definitions() {
            if flag.is_named() {
                mask |= flag.bits();
            }
        }
        mask
    }
    fn empty() -> Self {
        Flags::from_bits_retain(0)
    }
    fn all() -> Self {
        let empty: Self = Flags::empty();
        Flags::from_bits_retain(empty.known_mask())
    }
    fn all_named() -> Self {
        let empty: Self = Flags::empty();
        Flags::from_bits_retain(empty.named_mask())
    }
    fn from_bits(bits: u64) -> Option[Self] {
        let value: Self = Flags::from_bits_retain(bits);
        if (bits & ~value.known_mask()) == 0 {
            Option::Some(value)
        } else {
            Option::None
        }
    }
    fn from_bits_truncate(bits: u64) -> Self {
        let value: Self = Flags::from_bits_retain(bits);
        Flags::from_bits_retain(bits & value.known_mask())
    }
    fn from_name(name: string) -> Option[Self] {
        let empty: Self = Flags::empty();
        for flag in empty.definitions() {
            if flag.is_named() && flag.name() == name {
                return Option::Some(Flags::from_bits_retain(flag.bits()))
            }
        }
        Option::None
    }
    fn is_empty(self: Self) -> bool {
        self.bits() == 0
    }
    fn is_all(self: Self) -> bool {
        (self.bits() & self.known_mask()) == self.known_mask()
    }
    fn known_bits(self: Self) -> u64 {
        self.bits() & self.known_mask()
    }
    fn unknown_bits(self: Self) -> u64 {
        self.bits() & ~self.known_mask()
    }
    fn contains_unknown_bits(self: Self) -> bool {
        self.unknown_bits() != 0
    }
    fn contains(self: Self, other: Self) -> bool {
        (self.bits() & other.bits()) == other.bits()
    }
    fn intersects(self: Self, other: Self) -> bool {
        (self.bits() & other.bits()) != 0
    }
    fn union(self: Self, other: Self) -> Self {
        Flags::from_bits_retain(self.bits() | other.bits())
    }
    fn intersection(self: Self, other: Self) -> Self {
        Flags::from_bits_retain(self.bits() & other.bits())
    }
    fn difference(self: Self, other: Self) -> Self {
        Flags::from_bits_retain(self.bits() & ~other.bits())
    }
    fn symmetric_difference(self: Self, other: Self) -> Self {
        Flags::from_bits_retain(self.bits() ^ other.bits())
    }
    fn complement(self: Self) -> Self {
        Flags::from_bits_retain(~self.bits() & self.known_mask())
    }
    fn insert(self: Self, other: Self) -> Self {
        self.union(other)
    }
    fn remove(self: Self, other: Self) -> Self {
        self.difference(other)
    }
    fn toggle(self: Self, other: Self) -> Self {
        self.symmetric_difference(other)
    }
    fn set(self: Self, other: Self, enabled: bool) -> Self {
        if enabled {
            self.insert(other)
        } else {
            self.remove(other)
        }
    }
    fn truncate(self: Self) -> Self {
        Flags::from_bits_truncate(self.bits())
    }
    fn clear(self: Self) -> Self {
        Flags::empty()
    }
    fn iter_names(self: Self) -> IterNames[Self] {
        names(self)
    }
    fn iter(self: Self) -> Iter[Self] {
        Iter { names: self.iter_names(), finished: Ref::new(false) }
    }
    fn iter_defined_names() -> FnIterator[(string, Self)] {
        let empty: Self = Flags::empty();
        defined_names(empty)
    }
    fn iter_equal_names(self: Self) -> FnIterator[string] {
        equal_names(self)
    }
    fn format(self: Self) -> string {
        format(self)
    }
    fn debug_flags(self: Self) -> string {
        let text = self.format();
        self.type_name() + "("
            + if text == "" {
                "0x0"
            } else {
                text
            }
            + ")"
    }
}

pub fn collect[F: Flags, I: Iterator](values: I) -> F where I::Item = F {
    let mut result: F = Flags::empty();
    while let Some(value) = values.next() {
        result = result.union(value);
    }
    result
}
