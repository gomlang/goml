package bitflags;

use std::text;
use std::unicode;

#[derive(Debug, PartialEq, Eq)]
pub enum ParseErrorKind {
    EmptyFlag,
    UnknownName,
    InvalidHex,
    HexNotAllowed,
    UnknownBits,
}

#[derive(Debug, PartialEq, Eq)]
pub struct ParseError {
    pub kind: ParseErrorKind,
    pub offset: isize,
    pub token: string,
}

impl ToString for ParseError {
    fn to_string(self: ParseError) -> string {
        f"{self.kind.debug()} at byte {self.offset}: {self.token}"
    }
}

#[derive(PartialEq, Eq)]
pub enum ParseMode {
    Retain,
    Truncate,
    Strict,
    Checked,
}

fn trimmed_span(value: string) -> (isize, isize) {
    let mut first = value.byte_len();
    let mut end = 0;
    for entry in text::char_indices(value) {
        if !unicode::is_whitespace(entry.1) {
            if first == value.byte_len() {
                first = entry.0;
            }
            let byte = value.byte_get(entry.0);
            end = entry.0
                + if byte < 128 {
                    1
                } else if byte < 224 {
                    2
                } else if byte < 240 {
                    3
                } else {
                    4
                };
        }
    }
    if end == 0 {
        (value.byte_len(), value.byte_len())
    } else {
        (first, end)
    }
}

pub fn parse[F: Flags](input: string) -> Result[F, ParseError] {
    parse_with(input, ParseMode::Retain)
}

pub fn parse_truncate[F: Flags](input: string) -> Result[F, ParseError] {
    parse_with(input, ParseMode::Truncate)
}

pub fn parse_strict[F: Flags](input: string) -> Result[F, ParseError] {
    parse_with(input, ParseMode::Strict)
}

pub fn parse_checked[F: Flags](input: string) -> Result[F, ParseError] {
    parse_with(input, ParseMode::Checked)
}

pub fn parse_with[F: Flags](input: string, mode: ParseMode) -> Result[F, ParseError] {
    let mut result: F = Flags::empty();
    let whole = trimmed_span(input);
    if whole.0 == whole.1 {
        return Result::Ok(result)
    }
    let mut start = 0;
    for end in 0..=input.byte_len() {
        if end != input.byte_len() && input.byte_get(end) != b'|' {
            continue;
        }
        let segment = input.byte_slice(start, end);
        let span = trimmed_span(segment);
        let token = segment.byte_slice(span.0, span.1);
        let offset = start + span.0;
        if token == "" {
            return Result::Err(ParseError { kind: ParseErrorKind::EmptyFlag, offset, token })
        }
        let value: F = if token.starts_with("0x") {
            if mode == ParseMode::Strict {
                return Result::Err(
                    ParseError { kind: ParseErrorKind::HexNotAllowed, offset, token },
                )
            }
            let digits = token.byte_slice(2, token.byte_len());
            let digits = if digits.starts_with("+") {
                digits.byte_slice(1, digits.byte_len())
            } else {
                digits
            };
            let bits = match number(digits, 16, result.storage_mask()) {
                Some(bits) => bits,
                None => return Result::Err(
                    ParseError { kind: ParseErrorKind::InvalidHex, offset, token },
                ),
            };
            if mode == ParseMode::Checked && (bits & ~result.known_mask()) != 0 {
                return Result::Err(ParseError { kind: ParseErrorKind::UnknownBits, offset, token })
            }
            Flags::from_bits_retain(bits)
        } else {
            let named: Option[F] = Flags::from_name(token);
            match named {
                Some(value) => value,
                None => return Result::Err(
                    ParseError { kind: ParseErrorKind::UnknownName, offset, token },
                ),
            }
        };
        result = result.union(value);
        start = end + 1;
    }
    Result::Ok(
        if mode == ParseMode::Truncate {
            result.truncate()
        } else {
            result
        },
    )
}

fn formatted[F: Flags](value: F, include_remainder: bool) -> string {
    let iterator = value.iter_names();
    let mut result = "";
    while let Some(entry) = iterator.next() {
        if result != "" {
            result += " | ";
        }
        result += entry.0;
    }
    let remaining = iterator.remaining().bits();
    if include_remainder && remaining != 0 {
        if result != "" {
            result += " | ";
        }
        result += hex(remaining);
    }
    result
}

pub fn format[F: Flags](value: F) -> string {
    formatted(value, true)
}

pub fn format_truncate[F: Flags](value: F) -> string {
    formatted(value.truncate(), true)
}

pub fn format_strict[F: Flags](value: F) -> string {
    formatted(value, false)
}
