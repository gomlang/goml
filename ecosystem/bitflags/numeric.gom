package bitflags;

#[comptime]
fn ascii_space(value: byte) -> bool {
    value == 32 || (value >= 9 && value <= 13)
}

#[comptime]
fn strip_ascii(value: string) -> string {
    let mut start = 0;
    let mut end = value.byte_len();
    while start < end && ascii_space(value.byte_get(start)) {
        start += 1;
    }
    while end > start && ascii_space(value.byte_get(end - 1)) {
        end -= 1;
    }
    value.byte_slice(start, end)
}

#[comptime]
fn number(value: string, radix: u64, maximum: u64) -> Option[u64] {
    if value.byte_len() == 0 {
        return Option::None
    }
    let mut result: u64 = 0;
    for index in 0..value.byte_len() {
        let byte = value.byte_get(index);
        let digit = if byte >= b'0' && byte <= b'9' {
            (byte - b'0').to_u64()
        } else if byte >= b'a' && byte <= b'f' {
            (byte - b'a').to_u64() + 10
        } else if byte >= b'A' && byte <= b'F' {
            (byte - b'A').to_u64() + 10
        } else {
            return Option::None
        };
        if digit >= radix || digit > maximum || result > (maximum - digit) / radix {
            return Option::None
        }
        result = result * radix + digit;
    }
    Option::Some(result)
}

#[comptime]
fn decimal(bits: u64) -> string {
    bits.to_string()
}

pub fn hex(bits: u64) -> string {
    let mut value = bits;
    let mut result = "";
    loop {
        let digit = (value & 15).to_isize();
        result = "0123456789abcdef".byte_slice(digit, digit + 1) + result;
        value >>= 4;
        if value == 0 {
            break;
        }
    }
    "0x" + result
}
