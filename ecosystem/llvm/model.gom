package llvm;

use std::ffi;

#[derive(Debug, PartialEq)]
pub enum ErrorKind {
    Argument,
    Closed,
    Stale,
    Verification,
    Llvm,
}

#[derive(Debug)]
pub struct LlvmError {
    pub kind: ErrorKind,
    pub message: string,
}

impl ToString for LlvmError {
    fn to_string(self: LlvmError) -> string {
        self.message
    }
}

fn check(raw: ffi::String) -> Result[(), LlvmError] {
    let message = ffi::string_text(raw).unwrap_or("llvm: invalid UTF-8 diagnostic");
    if message == "" {
        return Result::Ok(())
    }
    let kind = if message.starts_with("argument:") {
        ErrorKind::Argument
    } else if message.starts_with("closed:") {
        ErrorKind::Closed
    } else if message.starts_with("stale:") {
        ErrorKind::Stale
    } else if message.starts_with("verification:") {
        ErrorKind::Verification
    } else {
        ErrorKind::Llvm
    };
    Result::Err(LlvmError { kind, message })
}

fn handle(result: (NativeHandle, ffi::String)) -> Result[NativeHandle, LlvmError] {
    let (value, error) = result;
    check(error)?;
    Result::Ok(value)
}

fn printed(raw: NativeHandle) -> Result[string, LlvmError] {
    let (value, error) = raw_print(raw);
    check(error)?;
    Result::Ok(ffi::string_text(value).unwrap_or("<invalid UTF-8>"))
}

pub fn version() -> string {
    ffi::string_text(raw_version()).unwrap_or("unknown")
}

pub struct Context {
    raw: NativeHandle,
}

impl Context {
    pub fn is_closed(self: Context) -> bool {
        raw_is_closed(self.raw)
    }

    pub fn close(self: Context) -> Result[(), LlvmError] {
        check(raw_close(self.raw))
    }
}

