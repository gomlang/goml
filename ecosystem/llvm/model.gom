#[derive(Debug, PartialEq)]
pub enum BinaryOp {
    Add,
    Sub,
    Mul,
    SignedDiv,
    UnsignedDiv,
    SignedRem,
    UnsignedRem,
    And,
    Or,
    Xor,
    ShiftLeft,
    ArithmeticShiftRight,
    LogicalShiftRight,
    FloatAdd,
    FloatSub,
    FloatMul,
    FloatDiv,
    FloatRem,
}

impl BinaryOp {
    fn code(self: BinaryOp) -> isize {
        match self {
            BinaryOp::Add => 0,
            BinaryOp::Sub => 1,
            BinaryOp::Mul => 2,
            BinaryOp::SignedDiv => 3,
            BinaryOp::UnsignedDiv => 4,
            BinaryOp::SignedRem => 5,
            BinaryOp::UnsignedRem => 6,
            BinaryOp::And => 7,
            BinaryOp::Or => 8,
            BinaryOp::Xor => 9,
            BinaryOp::ShiftLeft => 10,
            BinaryOp::ArithmeticShiftRight => 11,
            BinaryOp::LogicalShiftRight => 12,
            BinaryOp::FloatAdd => 13,
            BinaryOp::FloatSub => 14,
            BinaryOp::FloatMul => 15,
            BinaryOp::FloatDiv => 16,
            BinaryOp::FloatRem => 17,
        }
    }
}

#[derive(Debug, PartialEq)]
pub enum IntPredicate {
    Equal,
    NotEqual,
    UnsignedGreater,
    UnsignedGreaterEqual,
    UnsignedLess,
    UnsignedLessEqual,
    SignedGreater,
    SignedGreaterEqual,
    SignedLess,
    SignedLessEqual,
}

impl IntPredicate {
    fn code(self: IntPredicate) -> isize {
        match self {
            IntPredicate::Equal => 32,
            IntPredicate::NotEqual => 33,
            IntPredicate::UnsignedGreater => 34,
            IntPredicate::UnsignedGreaterEqual => 35,
            IntPredicate::UnsignedLess => 36,
            IntPredicate::UnsignedLessEqual => 37,
            IntPredicate::SignedGreater => 38,
            IntPredicate::SignedGreaterEqual => 39,
            IntPredicate::SignedLess => 40,
            IntPredicate::SignedLessEqual => 41,
        }
    }
}

#[derive(Debug, PartialEq)]
pub enum FloatPredicate {
    Never,
    OrderedEqual,
    OrderedGreater,
    OrderedGreaterEqual,
    OrderedLess,
    OrderedLessEqual,
    OrderedNotEqual,
    Ordered,
    Unordered,
    UnorderedEqual,
    UnorderedGreater,
    UnorderedGreaterEqual,
    UnorderedLess,
    UnorderedLessEqual,
    UnorderedNotEqual,
    Always,
}

impl FloatPredicate {
    fn code(self: FloatPredicate) -> isize {
        match self {
            FloatPredicate::Never => 0,
            FloatPredicate::OrderedEqual => 1,
            FloatPredicate::OrderedGreater => 2,
            FloatPredicate::OrderedGreaterEqual => 3,
            FloatPredicate::OrderedLess => 4,
            FloatPredicate::OrderedLessEqual => 5,
            FloatPredicate::OrderedNotEqual => 6,
            FloatPredicate::Ordered => 7,
            FloatPredicate::Unordered => 8,
            FloatPredicate::UnorderedEqual => 9,
            FloatPredicate::UnorderedGreater => 10,
            FloatPredicate::UnorderedGreaterEqual => 11,
            FloatPredicate::UnorderedLess => 12,
            FloatPredicate::UnorderedLessEqual => 13,
            FloatPredicate::UnorderedNotEqual => 14,
            FloatPredicate::Always => 15,
        }
    }
}

#[derive(Debug, PartialEq)]
pub enum CastOp {
    ZeroExtend,
    SignExtend,
    Truncate,
    SignedToFloat,
    UnsignedToFloat,
    FloatToSigned,
    FloatToUnsigned,
    FloatExtend,
    FloatTruncate,
    PointerToInt,
    IntToPointer,
    Bitcast,
}

impl CastOp {
    fn code(self: CastOp) -> isize {
        match self {
            CastOp::ZeroExtend => 0,
            CastOp::SignExtend => 1,
            CastOp::Truncate => 2,
            CastOp::SignedToFloat => 3,
            CastOp::UnsignedToFloat => 4,
            CastOp::FloatToSigned => 5,
            CastOp::FloatToUnsigned => 6,
            CastOp::FloatExtend => 7,
            CastOp::FloatTruncate => 8,
            CastOp::PointerToInt => 9,
            CastOp::IntToPointer => 10,
            CastOp::Bitcast => 11,
        }
    }
}

#[derive(Debug, PartialEq)]
pub enum OptimizationLevel {
    None,
    Less,
    Default,
    Aggressive,
}

impl OptimizationLevel {
    fn code(self: OptimizationLevel) -> isize {
        match self {
            OptimizationLevel::None => 0,
            OptimizationLevel::Less => 1,
            OptimizationLevel::Default => 2,
            OptimizationLevel::Aggressive => 3,
        }
    }
}
