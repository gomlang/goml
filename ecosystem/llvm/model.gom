    raw: NativeHandle,
}

impl Module {
    pub fn is_closed(self: Module) -> bool {
        raw_is_closed(self.raw)
    }

    pub fn close(self: Module) -> Result[(), LlvmError] {
        check(raw_close(self.raw))
    }

    pub fn ir(self: Module) -> Result[string, LlvmError] {
        printed(self.raw)
    }
}

