package llvm;

use std::bytes::{Bytes};
use std::ffi;
use std::utf8;

#[derive(Debug, PartialEq)]
pub enum Relocation {
    Default,
    Static,
    Pic,
}

impl Relocation {
    fn code(self: Relocation) -> isize {
        match self {
            Default => 0,
            Static => 1,
            Pic => 2,
        }
    }
}

#[derive(Debug, PartialEq)]
pub enum CodeModel {
    Default,
    Small,
    Large,
}

impl CodeModel {
    fn code(self: CodeModel) -> isize {
        match self {
            Default => 0,
            Small => 3,
            Large => 6,
        }
    }
}

pub struct TargetOptions {
    pub triple: string,
    pub cpu: string,
    pub features: string,
    pub optimization: OptimizationLevel,
    pub relocation: Relocation,
    pub code_model: CodeModel,
}

impl TargetOptions {
    pub fn new(triple: string) -> TargetOptions {
        TargetOptions {
            triple,
            cpu: "",
            features: "",
            optimization: OptimizationLevel::Default,
            relocation: Relocation::Pic,
            code_model: CodeModel::Default,
        }
    }

    pub fn native() -> TargetOptions {
        let (triple, cpu, features) = raw_host_target();
        TargetOptions {
            cpu: ffi::string_text(cpu).unwrap_or(""),
            features: ffi::string_text(features).unwrap_or(""),
            ..TargetOptions::new(ffi::string_text(triple).unwrap_or("")),
        }
    }
}

#[derive(Debug, PartialEq)]
pub enum ByteOrder {
    LittleEndian,
    BigEndian,
}

#[derive(Debug, PartialEq)]
pub struct TypeLayout {
    pub size_bits: u64,
    pub store_bytes: u64,
    pub abi_bytes: u64,
    pub abi_alignment: u64,
    pub preferred_alignment: u64,
}

pub fn normalize_triple(triple: string) -> Result[string, LlvmError] {
    let (result, error) = raw_normalize_triple(ffi::string_from_text(triple));
    check(error)?;
    ffi::string_text(result).map_err(
        |_| LlvmError { kind: ErrorKind::Llvm, message: "LLVM returned an invalid target triple" },
    )
}

pub fn target_names() -> Vec[string] {
    let result = Vec::new();
    for name in ffi::slice_to_vec_copy(raw_target_names()) {
        result.push(ffi::string_text(name).unwrap_or(""));
    }
    result
}

pub struct TargetMachine {
    raw: NativeHandle,
}

impl Context {
    pub fn target_machine(self: Context, options: TargetOptions) -> Result[TargetMachine, LlvmError] {
        Result::Ok(
            TargetMachine {
                raw: handle(
                    raw_new_target(
                        self.raw,
                        ffi::string_from_text(options.triple),
                        ffi::string_from_text(options.cpu),
                        ffi::string_from_text(options.features),
                        options.optimization.code(),
                        options.relocation.code(),
                        options.code_model.code(),
                    ),
                )?,
            },
        )
    }
}

impl Module {
    pub fn target_triple(self: Module) -> Result[string, LlvmError] {
        let (value, error) = raw_module_target_text(self.raw, false);
        check(error)?;
        Result::Ok(ffi::string_text(value).unwrap_or("<invalid UTF-8>"))
    }

    pub fn data_layout(self: Module) -> Result[string, LlvmError] {
        let (value, error) = raw_module_target_text(self.raw, true);
        check(error)?;
        Result::Ok(ffi::string_text(value).unwrap_or("<invalid UTF-8>"))
    }
}

impl TargetMachine {
    pub fn is_closed(self: TargetMachine) -> bool {
        raw_is_closed(self.raw)
    }

    pub fn close(self: TargetMachine) -> Result[(), LlvmError] {
        check(raw_close(self.raw))
    }

    fn text(self: TargetMachine, field: isize) -> Result[string, LlvmError] {
        let (value, error) = raw_target_text(self.raw, field);
        check(error)?;
        Result::Ok(ffi::string_text(value).unwrap_or("<invalid UTF-8>"))
    }

    pub fn triple(self: TargetMachine) -> Result[string, LlvmError] {
        self.text(0)
    }

    pub fn cpu(self: TargetMachine) -> Result[string, LlvmError] {
        self.text(1)
    }

    pub fn features(self: TargetMachine) -> Result[string, LlvmError] {
        self.text(2)
    }

    pub fn name(self: TargetMachine) -> Result[string, LlvmError] {
        self.text(3)
    }

    pub fn data_layout(self: TargetMachine) -> Result[string, LlvmError] {
        self.text(4)
    }

    pub fn byte_order(self: TargetMachine) -> Result[ByteOrder, LlvmError] {
        let (little, error) = raw_target_little_endian(self.raw);
        check(error)?;
        Result::Ok(
            if little {
                ByteOrder::LittleEndian
            } else {
                ByteOrder::BigEndian
            },
        )
    }

    pub fn pointer_bytes(self: TargetMachine, address_space: isize) -> Result[u64, LlvmError] {
        let (_, size, error) = raw_target_pointer(self.raw, address_space, false);
        check(error)?;
        Result::Ok(size)
    }

    pub fn pointer_int_type(self: TargetMachine, address_space: isize) -> Result[Type, LlvmError] {
        let (value, _, error) = raw_target_pointer(self.raw, address_space, true);
        check(error)?;
        Result::Ok(Type { raw: value })
    }

    pub fn type_layout(self: TargetMachine, ty: Type) -> Result[TypeLayout, LlvmError] {
        let (value, error) = raw_target_layout(self.raw, ty.raw, 0, 0);
        check(error)?;
        let fields = ffi::slice_to_vec_copy(value);
        Result::Ok(
            TypeLayout {
                size_bits: fields[0],
                store_bytes: fields[1],
                abi_bytes: fields[2],
                abi_alignment: fields[3],
                preferred_alignment: fields[4],
            },
        )
    }

    pub fn field_offset(self: TargetMachine, ty: Type, index: isize) -> Result[u64, LlvmError] {
        let (value, error) = raw_target_layout(self.raw, ty.raw, 1, index);
        check(error)?;
        Result::Ok(ffi::slice_to_vec_copy(value)[0])
    }

    pub fn configure(self: TargetMachine, module: Module) -> Result[(), LlvmError] {
        check(raw_configure_target(self.raw, module.raw))
    }

    pub fn optimize(self: TargetMachine, module: Module, level: OptimizationLevel) -> Result[
        (),
        LlvmError,
    ] {
        self.run_passes(module, "default<O" + level.code().to_string() + ">")
    }

    pub fn run_passes(self: TargetMachine, module: Module, pipeline: string) -> Result[
        (),
        LlvmError,
    ] {
        check(raw_optimize_target(self.raw, module.raw, ffi::string_from_text(pipeline)))
    }

    pub fn emit_object(self: TargetMachine, module: Module, path: string) -> Result[(), LlvmError] {
        check(raw_emit_target_file(self.raw, module.raw, ffi::string_from_text(path), false))
    }

    pub fn emit_assembly(self: TargetMachine, module: Module, path: string) -> Result[(), LlvmError] {
        check(raw_emit_target_file(self.raw, module.raw, ffi::string_from_text(path), true))
    }

    pub fn object_bytes(self: TargetMachine, module: Module, max_bytes: isize) -> Result[
        Bytes,
        LlvmError,
    ] {
        let (value, error) = raw_emit_target_bytes(self.raw, module.raw, false, max_bytes);
        check(error)?;
        Result::Ok(Bytes::from_vec(ffi::slice_to_vec_copy(value)))
    }

    pub fn assembly_text(self: TargetMachine, module: Module, max_bytes: isize) -> Result[
        string,
        LlvmError,
    ] {
        let (value, error) = raw_emit_target_bytes(self.raw, module.raw, true, max_bytes);
        check(error)?;
        utf8::decode(ffi::slice_to_vec_copy(value)).map_err(
            |_| LlvmError { kind: ErrorKind::Llvm, message: "LLVM assembly is not valid UTF-8" },
        )
    }
}
