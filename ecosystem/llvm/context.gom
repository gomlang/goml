package llvm;

use std::ffi;
use std::bytes::{Bytes};

impl Context {
    pub fn new() -> Context {
        Context { raw: raw_new_context() }
    }

    pub fn module(self: Context, name: string) -> Result[Module, LlvmError] {
        Result::Ok(Module { raw: handle(raw_new_module(self.raw, ffi::string_from_text(name)))? })
    }

    pub fn parse_ir(self: Context, source: string) -> Result[Module, LlvmError] {
        Result::Ok(
            Module { raw: handle(raw_parse(self.raw, ffi::string_from_text(source), false))? },
        )
    }

    pub fn parse_bitcode(self: Context, source: Bytes) -> Result[Module, LlvmError] {
        Result::Ok(
            Module { raw: handle(raw_parse(self.raw, ffi::string_from_bytes(source), true))? },
        )
    }

    fn primitive(self: Context, kind: isize, parameter: u64) -> Result[Type, LlvmError] {
        Result::Ok(Type { raw: handle(raw_primitive(self.raw, kind, parameter))? })
    }

    pub fn void_type(self: Context) -> Result[Type, LlvmError] {
        self.primitive(0, 0)
    }

    pub fn int_type(self: Context, bits: u64) -> Result[Type, LlvmError] {
        self.primitive(1, bits)
    }

    pub fn float_type(self: Context) -> Result[Type, LlvmError] {
        self.primitive(2, 0)
    }

    pub fn double_type(self: Context) -> Result[Type, LlvmError] {
        self.primitive(3, 0)
    }

    pub fn pointer_type(self: Context, address_space: u64) -> Result[Type, LlvmError] {
        self.primitive(4, address_space)
    }

    pub fn array_type(self: Context, element: Type, count: u64) -> Result[Type, LlvmError] {
        Result::Ok(
            Type {
                raw: handle(
                    raw_composite(
                        self.raw,
                        0,
                        ffi::slice_from_vec_copy(Vec::from_array([element.raw])),
                        count,
                        false,
                    ),
                )?,
            },
        )
    }

    pub fn struct_type(self: Context, fields: Vec[Type], packed: bool) -> Result[Type, LlvmError] {
        let members = Vec::new();
        for field in fields {
            members.push(field.raw);
        }
        Result::Ok(
            Type {
                raw: handle(
                    raw_composite(self.raw, 1, ffi::slice_from_vec_copy(members), 0, packed),
                )?,
            },
        )
    }

    pub fn function_type(self: Context, result: Type, parameters: Vec[Type], variadic: bool) -> Result[
        Type,
        LlvmError,
    ] {
        let members = Vec::from_array([result.raw]);
        for parameter in parameters {
            members.push(parameter.raw);
        }
        Result::Ok(
            Type {
                raw: handle(
                    raw_composite(self.raw, 2, ffi::slice_from_vec_copy(members), 0, variadic),
                )?,
            },
        )
    }

    pub fn builder(self: Context) -> Result[Builder, LlvmError] {
        Result::Ok(Builder { raw: handle(raw_new_builder(self.raw))? })
    }
}

impl Type {
    pub fn same_as(self: Type, other: Type) -> Result[bool, LlvmError] {
        let (value, error) = raw_type_equal(self.raw, other.raw);
        check(error)?;
        Result::Ok(value)
    }

    fn constant(self: Type, kind: isize, integer: u64, real: f64) -> Result[Value, LlvmError] {
        Result::Ok(Value { raw: handle(raw_constant(self.raw, kind, integer, real))? })
    }

    pub fn const_int(self: Type, bits: u64, sign_extend: bool) -> Result[Value, LlvmError] {
        self.constant(
            if sign_extend {
                1
            } else {
                0
            },
            bits,
            0.0,
        )
    }

    pub fn const_signed(self: Type, value: i64) -> Result[Value, LlvmError] {
        self.const_int(value.to_u64(), true)
    }

    pub fn const_float(self: Type, value: f64) -> Result[Value, LlvmError] {
        self.constant(2, 0, value)
    }

    pub fn zero(self: Type) -> Result[Value, LlvmError] {
        self.constant(3, 0, 0.0)
    }

    pub fn undef(self: Type) -> Result[Value, LlvmError] {
        self.constant(4, 0, 0.0)
    }

    pub fn const_aggregate(self: Type, elements: Vec[Value]) -> Result[Value, LlvmError] {
        let raw = Vec::new();
        for element in elements {
            raw.push(element.raw);
        }
        Result::Ok(Value { raw: handle(raw_aggregate(self.raw, ffi::slice_from_vec_copy(raw)))? })
    }
}
