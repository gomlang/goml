package llvm;

use std::ffi;

pub struct InsertionPoint {
    raw: NativeHandle,
}

pub enum Operand {
    Value(Value),
    Block(Block),
    Function(Function),
}

pub struct Local {
    value_type: Type,
    slot: Value,
}

fn read_ir(raw: NativeHandle, query: isize) -> Result[Vec[NativeHandle], LlvmError] {
    let (values, error) = raw_read_ir(raw, query);
    check(error)?;
    Result::Ok(ffi::slice_to_vec_copy(values))
}

fn same_handle(left: NativeHandle, right: NativeHandle) -> Result[bool, LlvmError] {
    let (equal, error) = raw_handle_equal(left, right);
    check(error)?;
    Result::Ok(equal)
}

fn value_name(raw: NativeHandle) -> Result[string, LlvmError] {
    let (name, error) = raw_value_name(raw);
    check(error)?;
    match ffi::string_text(name) {
        Ok(value) => Result::Ok(value),
        Err(_) => Result::Err(
            LlvmError { kind: ErrorKind::Argument, message: "argument: name is not UTF-8" },
        ),
    }
}

impl InsertionPoint {
    pub fn is_closed(self: InsertionPoint) -> bool {
        raw_is_closed(self.raw)
    }
}

impl Builder {
    pub fn position_before(self: Builder, instruction: Value) -> Result[(), LlvmError] {
        check(raw_position_before(self.raw, instruction.raw))
    }

    pub fn position_at_start(self: Builder, block: Block) -> Result[(), LlvmError] {
        check(raw_position_start(self.raw, block.raw))
    }

    pub fn save_position(self: Builder) -> Result[InsertionPoint, LlvmError] {
        Result::Ok(InsertionPoint { raw: handle(raw_save_position(self.raw))? })
    }

    pub fn restore_position(self: Builder, position: InsertionPoint) -> Result[(), LlvmError] {
        check(raw_restore_position(self.raw, position.raw))
    }

    pub fn clear_position(self: Builder) -> Result[(), LlvmError] {
        check(raw_clear_position(self.raw))
    }
}

impl Module {
    pub fn functions(self: Module) -> Result[Vec[Function], LlvmError] {
        let result = Vec::new();
        for raw in read_ir(self.raw, 0)? {
            result.push(Function { raw });
        }
        Result::Ok(result)
    }

    pub fn promote_locals(self: Module) -> Result[(), LlvmError] {
        self.run_passes("function(sroa,mem2reg)")
    }
}

impl Function {
    pub fn blocks(self: Function) -> Result[Vec[Block], LlvmError] {
        let result = Vec::new();
        for raw in read_ir(self.raw, 1)? {
            result.push(Block { raw });
        }
        Result::Ok(result)
    }

    pub fn name(self: Function) -> Result[string, LlvmError] {
        value_name(self.raw)
    }

    pub fn same_as(self: Function, other: Function) -> Result[bool, LlvmError] {
        same_handle(self.raw, other.raw)
    }

    pub fn entry_alloca(self: Function, value_type: Type, name: string) -> Result[Value, LlvmError] {
        Result::Ok(
            Value {
                raw: handle(raw_entry_alloca(self.raw, value_type.raw, ffi::string_from_text(name)))?,
            },
        )
    }

    pub fn local(self: Function, value_type: Type, name: string) -> Result[Local, LlvmError] {
        Result::Ok(Local { value_type, slot: self.entry_alloca(value_type, name)? })
    }
}

impl Local {
    pub fn read(self: Local, builder: Builder, name: string) -> Result[Value, LlvmError] {
        builder.load(self.value_type, self.slot, name)
    }

    pub fn write(self: Local, builder: Builder, value: Value) -> Result[(), LlvmError] {
        if !self.value_type.same_as(value.value_type()?)? {
            return Result::Err(
                LlvmError {
                    kind: ErrorKind::Argument,
                    message: "argument: local value type mismatch",
                },
            );
        }
        builder.store(value, self.slot)
    }

    pub fn is_closed(self: Local) -> bool {
        self.slot.is_closed()
    }
}

impl Block {
    pub fn name(self: Block) -> Result[string, LlvmError] {
        value_name(self.raw)
    }

    pub fn same_as(self: Block, other: Block) -> Result[bool, LlvmError] {
        same_handle(self.raw, other.raw)
    }

    pub fn instructions(self: Block) -> Result[Vec[Value], LlvmError] {
        let result = Vec::new();
        for raw in read_ir(self.raw, 2)? {
            result.push(Value { raw });
        }
        Result::Ok(result)
    }

    pub fn successors(self: Block) -> Result[Vec[Block], LlvmError] {
        let result = Vec::new();
        for raw in read_ir(self.raw, 3)? {
            result.push(Block { raw });
        }
        Result::Ok(result)
    }

    pub fn predecessors(self: Block) -> Result[Vec[Block], LlvmError] {
        let result = Vec::new();
        for raw in read_ir(self.raw, 4)? {
            result.push(Block { raw });
        }
        Result::Ok(result)
    }

    pub fn terminator(self: Block) -> Result[Option[Value], LlvmError] {
        let values = read_ir(self.raw, 8)?;
        Result::Ok(
            if values.is_empty() {
                Option::None
            } else {
                Option::Some(Value { raw: values[0] })
            },
        )
    }
}

impl Value {
    pub fn name(self: Value) -> Result[string, LlvmError] {
        value_name(self.raw)
    }

    pub fn same_as(self: Value, other: Value) -> Result[bool, LlvmError] {
        same_handle(self.raw, other.raw)
    }

    pub fn is_phi(self: Value) -> Result[bool, LlvmError] {
        let (value, error) = raw_is_phi(self.raw);
        check(error)?;
        Result::Ok(value)
    }

    pub fn operands(self: Value) -> Result[Vec[Operand], LlvmError] {
        let result = Vec::new();
        for raw in read_ir(self.raw, 5)? {
            let (kind, error) = raw_handle_kind(raw);
            check(error)?;
            if kind == 4 {
                result.push(Operand::Function(Function { raw }));
            } else if kind == 5 {
                result.push(Operand::Block(Block { raw }));
            } else {
                result.push(Operand::Value(Value { raw }));
            }
        }
        Result::Ok(result)
    }

    pub fn users(self: Value) -> Result[Vec[Value], LlvmError] {
        let result = Vec::new();
        for raw in read_ir(self.raw, 6)? {
            result.push(Value { raw });
        }
        Result::Ok(result)
    }

    pub fn incoming(self: Value) -> Result[Vec[(Value, Block)], LlvmError] {
        let values = read_ir(self.raw, 7)?;
        let result = Vec::new();
        let mut index = 0;
        while index < values.len() {
            result.push((Value { raw: values[index] }, Block { raw: values[index + 1] }));
            index += 2;
        }
        Result::Ok(result)
    }

    fn edit_incoming(self: Value, mode: isize, index: isize, incoming: Vec[(Value, Block)]) -> Result[
        (),
        LlvmError,
    ] {
        let values = Vec::new();
        let blocks = Vec::new();
        for (value, block) in incoming {
            values.push(value.raw);
            blocks.push(block.raw);
        }
        check(
            raw_edit_incoming(
                self.raw,
                mode,
                index,
                ffi::slice_from_vec_copy(values),
                ffi::slice_from_vec_copy(blocks),
            ),
        )
    }

    pub fn replace_incoming(self: Value, incoming: Vec[(Value, Block)]) -> Result[(), LlvmError] {
        self.edit_incoming(1, 0, incoming)
    }

    pub fn set_incoming(self: Value, index: isize, value: Value, block: Block) -> Result[
        (),
        LlvmError,
    ] {
        self.edit_incoming(2, index, Vec::from_array([(value, block)]))
    }

    pub fn remove_incoming(self: Value, index: isize) -> Result[(), LlvmError] {
        self.edit_incoming(3, index, Vec::new())
    }

    pub fn replace_all_uses_with(self: Value, replacement: Value) -> Result[(), LlvmError] {
        check(raw_replace_uses(self.raw, replacement.raw))
    }

    pub fn set_operand(self: Value, index: isize, replacement: Value) -> Result[(), LlvmError] {
        check(raw_set_operand(self.raw, index, replacement.raw))
    }

    pub fn erase(self: Value) -> Result[(), LlvmError] {
        check(raw_erase_instruction(self.raw))
    }
}
