package tests;

use ecosystem::llvm::{Context, Module, Builder, Type, Function, LlvmError, ErrorKind, BinaryOp, IntPredicate, FloatPredicate, CastOp, OptimizationLevel};
use std::testing;
use std::bytes::{Bytes};

fn ok[T](value: Result[T, LlvmError]) -> T {
    testing::expect_ok(value, "LLVM operation")
}

fn invalid[T](value: Result[T, LlvmError], kind: ErrorKind) -> () {
    match value {
        Err(error) => testing::assert_eq(error.kind, kind),
        Ok(_) => testing::fail("expected LLVM error"),
    }
}

fn setup(context: Context) -> (Module, Type, Function, Builder) {
    let module = ok(context.module("test"));
    let integer = ok(context.int_type(64));
    let function = ok(
        module.add_function(
            "f",
            ok(context.function_type(integer, Vec::from_array([integer]), false)),
        ),
    );
    let builder = ok(context.builder());
    ok(builder.position_at_end(ok(function.append_block("entry"))));
    (module, integer, function, builder)
}

#[test]
fn types_constants_and_aggregate_validation() -> () {
    let context = Context::new();
    defer {
        let _ = context.close();
    };
    testing::assert(ecosystem::llvm::version().starts_with("18."));
    let integer = ok(context.int_type(64));
    testing::assert_eq(ok(integer.ir()), "i64");
    testing::assert(ok(integer.same_as(ok(context.int_type(64)))));
    testing::assert(!ok(integer.same_as(ok(context.int_type(32)))));
    testing::assert_eq(ok(ok(integer.const_signed(-1)).ir()), "i64 -1");
    testing::assert_eq(ok(ok(ok(context.int_type(128)).const_signed(-1)).ir()), "i128 -1");
    let floating = ok(context.double_type());
    testing::assert(ok(ok(floating.const_float(1.25)).ir()).contains("1.250000e+00"));
    let pair = ok(context.struct_type(Vec::from_array([integer, floating]), false));
    let aggregate = ok(
        pair.const_aggregate(
            Vec::from_array([ok(integer.const_signed(7)), ok(floating.const_float(2.0))]),
        ),
    );
    testing::assert(ok(aggregate.ir()).contains("i64 7"));
    let array = ok(context.array_type(integer, 2));
    testing::assert_ok(
        array.const_aggregate(Vec::from_array([ok(integer.zero()), ok(integer.const_signed(1))])),
    );
    testing::assert_ok(ok(context.struct_type(Vec::new(), true)).const_aggregate(Vec::new()));
    invalid(context.int_type(0), ErrorKind::Argument);
    invalid(context.int_type(65537), ErrorKind::Argument);
    invalid(context.pointer_type(16777216), ErrorKind::Argument);
    invalid(context.array_type(ok(context.void_type()), 1), ErrorKind::Argument);
    invalid(
        context.struct_type(Vec::from_array([ok(context.void_type())]), false),
        ErrorKind::Argument,
    );
    invalid(
        context.function_type(integer, Vec::from_array([ok(context.void_type())]), false),
        ErrorKind::Argument,
    );
    invalid(integer.const_float(1.0), ErrorKind::Argument);
    invalid(floating.const_int(1, false), ErrorKind::Argument);
    invalid(ok(context.void_type()).zero(), ErrorKind::Argument);
    invalid(pair.const_aggregate(Vec::new()), ErrorKind::Argument);
    invalid(
        pair.const_aggregate(Vec::from_array([ok(integer.zero()), ok(integer.zero())])),
        ErrorKind::Argument,
    );
    invalid(ok(integer.zero()).set_name("constant"), ErrorKind::Argument);
}

#[test]
fn instruction_types_and_control_flow_are_checked_before_llvm() -> () {
    let context = Context::new();
    defer {
        let _ = context.close();
    };
    let (module, integer, function, builder) = setup(context);
    let parameter = ok(function.parameter(0));
    let small = ok(context.int_type(32));
    let real = ok(context.double_type());
    let zero = ok(integer.zero());
    invalid(function.parameter(-1), ErrorKind::Argument);
    invalid(function.parameter(1), ErrorKind::Argument);
    invalid(builder.binary(BinaryOp::Add, parameter, ok(small.zero()), "bad"), ErrorKind::Argument);
    invalid(builder.binary(BinaryOp::FloatAdd, parameter, zero, "bad"), ErrorKind::Argument);
    invalid(
        builder.int_compare(IntPredicate::Equal, parameter, ok(real.zero()), "bad"),
        ErrorKind::Argument,
    );
    invalid(
        builder.float_compare(FloatPredicate::OrderedEqual, parameter, zero, "bad"),
        ErrorKind::Argument,
    );
    invalid(builder.cast(CastOp::Truncate, parameter, integer, "bad"), ErrorKind::Argument);
    invalid(builder.ret_void(), ErrorKind::Argument);
    invalid(builder.ret(ok(small.zero())), ErrorKind::Argument);
    invalid(builder.load(integer, parameter, "bad"), ErrorKind::Argument);
    invalid(builder.store(parameter, zero), ErrorKind::Argument);
    invalid(builder.alloca(ok(context.void_type()), "bad"), ErrorKind::Argument);
    invalid(builder.select(parameter, zero, zero, "bad"), ErrorKind::Argument);
    invalid(builder.call(function, Vec::new(), "bad"), ErrorKind::Argument);
    invalid(builder.call(function, Vec::from_array([ok(small.zero())]), "bad"), ErrorKind::Argument);
    invalid(
        builder.conditional_branch(
            parameter,
            ok(function.append_block("yes")),
            ok(function.append_block("no")),
        ),
        ErrorKind::Argument,
    );
    let slot = ok(builder.alloca(integer, "slot"));
    ok(builder.store(parameter, slot));
    let loaded = ok(builder.load(integer, slot, "loaded"));
    invalid(builder.phi(integer, "late"), ErrorKind::Argument);
    ok(builder.ret(loaded));
    invalid(builder.ret(zero), ErrorKind::Argument);
    invalid(builder.binary(BinaryOp::Add, zero, zero, "after_return"), ErrorKind::Argument);
    invalid(module.verify(), ErrorKind::Verification);
}

#[test]
fn handles_reject_cross_context_module_and_function_use() -> () {
    let context = Context::new();
    let other = Context::new();
    defer {
        let _ = context.close();
        let _ = other.close();
    };
    let (module, integer, function, builder) = setup(context);
    let foreign = ok(other.int_type(64));
    invalid(integer.same_as(foreign), ErrorKind::Argument);
    invalid(context.array_type(foreign, 2), ErrorKind::Argument);
    invalid(
        builder.binary(BinaryOp::Add, ok(function.parameter(0)), ok(foreign.zero()), "cross"),
        ErrorKind::Argument,
    );
    let second = ok(
        module.add_function(
            "second",
            ok(context.function_type(integer, Vec::from_array([integer]), false)),
        ),
    );
    invalid(
        builder.binary(BinaryOp::Add, ok(function.parameter(0)), ok(second.parameter(0)), "cross"),
        ErrorKind::Argument,
    );
    invalid(builder.branch(ok(second.append_block("entry"))), ErrorKind::Argument);
    let different_module = ok(context.module("different"));
    let callee = ok(
        different_module.add_function(
            "callee",
            ok(context.function_type(integer, Vec::new(), false)),
        ),
    );
    invalid(builder.call(callee, Vec::new(), "cross"), ErrorKind::Argument);
    invalid(module.add_function("f", ok(function.signature())), ErrorKind::Argument);
    invalid(module.add_function("bad\u0000name", ok(function.signature())), ErrorKind::Argument);
    invalid(module.add_function("not_function", integer), ErrorKind::Argument);
    invalid(module.function("missing"), ErrorKind::Argument);
}

#[test]
fn explicit_close_invalidates_dependents_and_can_be_repeated() -> () {
    let context = Context::new();
    let (module, integer, function, builder) = setup(context);
    let value = ok(function.parameter(0));
    ok(module.close());
    ok(module.close());
    testing::assert(module.is_closed());
    testing::assert(value.is_closed());
    testing::assert(function.is_closed());
    invalid(value.ir(), ErrorKind::Closed);
    invalid(function.parameter(0), ErrorKind::Closed);
    invalid(builder.ret(ok(integer.zero())), ErrorKind::Argument);
    let next = ok(context.module("next"));
    let function = ok(
        next.add_function("next", ok(context.function_type(integer, Vec::new(), false))),
    );
    ok(builder.position_at_end(ok(function.append_block("entry"))));
    ok(builder.ret(ok(integer.zero())));
    ok(next.verify());
    ok(builder.close());
    ok(builder.close());
    invalid(builder.position_at_end(ok(function.append_block("extra"))), ErrorKind::Closed);
    ok(context.close());
    ok(context.close());
    testing::assert(integer.is_closed());
    testing::assert(next.is_closed());
    invalid(integer.zero(), ErrorKind::Closed);
    invalid(context.module("closed"), ErrorKind::Closed);
    ok(next.close());
}

#[test]
fn parsing_verification_bitcode_and_optimization_lifetimes() -> () {
    let context = Context::new();
    defer {
        let _ = context.close();
    };
    let source = "define i64 @identity(i64 %x) { entry: %a = add i64 %x, 0\n ret i64 %a\n }";
    let module = ok(context.parse_ir(source));
    ok(module.verify());
    let function = ok(module.function("identity"));
    let parameter = ok(function.parameter(0));
    let clone = ok(module.clone());
    let decoded = ok(context.parse_bitcode(ok(module.bitcode())));
    ok(decoded.verify());
    ok(module.optimize(OptimizationLevel::Default));
    invalid(function.ir(), ErrorKind::Stale);
    invalid(parameter.ir(), ErrorKind::Stale);
    testing::assert(function.is_closed());
    testing::assert(!ok(module.ir()).contains("add i64"));
    testing::assert(ok(clone.ir()).contains("add i64"));
    let fresh = ok(module.function("identity"));
    testing::assert_ok(fresh.parameter(0));
    invalid(module.run_passes("unknown-goml-pass"), ErrorKind::Llvm);
    invalid(fresh.ir(), ErrorKind::Stale);
    ok(module.verify());
    invalid(context.parse_ir("definitely not LLVM IR"), ErrorKind::Llvm);
    invalid(context.parse_bitcode(Bytes::from_vec(Vec::from_array([1, 2, 3, 4]))), ErrorKind::Llvm);
    invalid(
        module.emit_object("/missing/goml-llvm-directory/object.o", OptimizationLevel::Default),
        ErrorKind::Llvm,
    );
    invalid(module.emit_assembly("bad\u0000path", OptimizationLevel::Default), ErrorKind::Argument);
}

#[test]
fn phi_predecessors_and_gep_indices_validate_without_assertions() -> () {
    let context = Context::new();
    defer {
        let _ = context.close();
    };
    let (module, integer, function, builder) = setup(context);
    let merge = ok(function.append_block("merge"));
    let left = ok(function.append_block("left"));
    let right = ok(function.append_block("right"));
    ok(builder.conditional_branch(ok(ok(context.int_type(1)).const_int(1, false)), left, right));
    ok(builder.position_at_end(left));
    ok(builder.branch(merge));
    ok(builder.position_at_end(right));
    ok(builder.branch(merge));
    ok(builder.position_at_end(merge));
    let phi = ok(builder.phi(integer, "merged"));
    invalid(phi.add_incoming(Vec::new()), ErrorKind::Argument);
    invalid(
        phi.add_incoming(Vec::from_array([(ok(ok(context.int_type(32)).zero()), left)])),
        ErrorKind::Argument,
    );
    ok(phi.add_incoming(Vec::from_array([(ok(integer.const_signed(1)), left)])));
    invalid(
        phi.add_incoming(Vec::from_array([(ok(integer.const_signed(2)), left)])),
        ErrorKind::Argument,
    );
    ok(phi.add_incoming(Vec::from_array([(ok(integer.const_signed(2)), right)])));
    let pair = ok(context.struct_type(Vec::from_array([integer, integer]), false));
    let slot = ok(builder.alloca(pair, "pair"));
    let small = ok(context.int_type(32));
    invalid(builder.gep(pair, slot, Vec::new(), false, "bad"), ErrorKind::Argument);
    invalid(
        builder.gep(
            pair,
            slot,
            Vec::from_array([ok(small.zero()), ok(small.const_signed(2))]),
            false,
            "bad",
        ),
        ErrorKind::Argument,
    );
    invalid(
        builder.gep(
            pair,
            slot,
            Vec::from_array([ok(small.zero()), ok(integer.zero())]),
            false,
            "bad",
        ),
        ErrorKind::Argument,
    );
    let field = ok(
        builder.gep(
            pair,
            slot,
            Vec::from_array([ok(small.zero()), ok(small.const_signed(1))]),
            true,
            "field",
        ),
    );
    ok(builder.store(phi, field));
    ok(builder.ret(ok(builder.load(integer, field, "answer"))));
    ok(module.verify());
}

#[test]
fn arithmetic_casts_comparisons_and_void_calls() -> () {
    let context = Context::new();
    defer {
        let _ = context.close();
    };
    let (module, integer, function, builder) = setup(context);
    let parameter = ok(function.parameter(0));
    let one = ok(integer.const_signed(1));
    let operations = Vec::from_array(
        [
            BinaryOp::Add,
            BinaryOp::Sub,
            BinaryOp::Mul,
            BinaryOp::SignedDiv,
            BinaryOp::UnsignedDiv,
            BinaryOp::SignedRem,
            BinaryOp::UnsignedRem,
            BinaryOp::And,
            BinaryOp::Or,
            BinaryOp::Xor,
            BinaryOp::ShiftLeft,
            BinaryOp::ArithmeticShiftRight,
            BinaryOp::LogicalShiftRight,
        ],
    );
    for operation in operations {
        let _ = ok(builder.binary(operation, parameter, one, "integer"));
    }
    let real = ok(context.double_type());
    let floating = ok(builder.cast(CastOp::SignedToFloat, parameter, real, "float"));
    for operation in Vec::from_array(
        [
            BinaryOp::FloatAdd,
            BinaryOp::FloatSub,
            BinaryOp::FloatMul,
            BinaryOp::FloatDiv,
            BinaryOp::FloatRem,
        ],
    ) {
        let _ = ok(builder.binary(operation, floating, ok(real.const_float(2.0)), "floating"));
    }
    let compare = ok(
        builder.float_compare(FloatPredicate::OrderedLess, floating, ok(real.zero()), "less"),
    );
    let selected = ok(builder.select(compare, one, parameter, "selected"));
    let narrow = ok(builder.cast(CastOp::Truncate, selected, ok(context.int_type(32)), "narrow"));
    let _ = ok(builder.cast(CastOp::ZeroExtend, narrow, integer, "wide"));
    let _ = ok(builder.cast(CastOp::SignExtend, narrow, integer, "signed_wide"));
    let _ = ok(builder.cast(CastOp::UnsignedToFloat, parameter, real, "unsigned"));
    let _ = ok(builder.cast(CastOp::FloatToSigned, floating, integer, "signed"));
    let _ = ok(builder.cast(CastOp::FloatToUnsigned, floating, integer, "unsigned"));
    let fp32 = ok(builder.cast(CastOp::FloatTruncate, floating, ok(context.float_type()), "fp32"));
    let _ = ok(builder.cast(CastOp::FloatExtend, fp32, real, "fp64"));
    let pointer = ok(
        builder.cast(CastOp::IntToPointer, parameter, ok(context.pointer_type(0)), "pointer"),
    );
    let _ = ok(builder.cast(CastOp::PointerToInt, pointer, integer, "integer"));
    let _ = ok(builder.cast(CastOp::Bitcast, floating, integer, "bits"));
    let procedure = ok(
        module.add_function(
            "procedure",
            ok(context.function_type(ok(context.void_type()), Vec::new(), false)),
        ),
    );
    invalid(builder.call(procedure, Vec::new(), "named_void"), ErrorKind::Argument);
    let _ = ok(builder.call(procedure, Vec::new(), ""));
    ok(builder.ret(selected));
    ok(builder.position_at_end(ok(procedure.append_block("entry"))));
    let void_value = ok(builder.call(procedure, Vec::new(), ""));
    invalid(builder.ret(void_value), ErrorKind::Argument);
    ok(builder.ret_void());
    ok(module.verify());
}
