package tests;

use ecosystem::llvm;
use llvm::{Context, TargetOptions, CodeModel, Relocation, ByteOrder, ErrorKind, OptimizationLevel};
use std::testing;

#[test]
fn targets_options_and_normalized_metadata_are_checked() -> () {
    testing::assert(llvm::target_names().contains("x86-64"));
    testing::assert(llvm::target_names().contains("aarch64"));
    testing::assert_eq(ok(llvm::normalize_triple("x86_64-linux-gnu")), "x86_64-unknown-linux-gnu");
    invalid(llvm::normalize_triple(""), ErrorKind::Argument);
    invalid(llvm::normalize_triple("bad\u0000triple"), ErrorKind::Argument);
    let context = Context::new();
    defer {
        let _ = context.close();
    };
    let native = TargetOptions::native();
    let target = ok(context.target_machine(native));
    testing::assert_eq(ok(target.triple()), ok(llvm::normalize_triple(native.triple)));
    testing::assert_eq(ok(target.cpu()), native.cpu);
    testing::assert_eq(ok(target.features()), native.features);
    testing::assert_eq(ok(target.name()), "x86-64");
    let options = TargetOptions {
        cpu: "x86-64",
        features: "+sse2,-avx",
        relocation: Relocation::Static,
        code_model: CodeModel::Small,
        ..TargetOptions::new("x86_64-unknown-linux-gnu"),
    };
    let portable = ok(context.target_machine(options));
    testing::assert_eq(ok(portable.cpu()), "x86-64");
    testing::assert_eq(ok(portable.features()), "+sse2,-avx");
    invalid(
        context.target_machine(TargetOptions::new("notreal-unknown-linux-gnu")),
        ErrorKind::Llvm,
    );
    invalid(
        context.target_machine(TargetOptions { cpu: "bad\u0000cpu", ..options }),
        ErrorKind::Argument,
    );
    invalid(
        context.target_machine(TargetOptions { features: "sse2", ..options }),
        ErrorKind::Argument,
    );
    invalid(
        context.target_machine(TargetOptions { features: "+sse2,", ..options }),
        ErrorKind::Argument,
    );
    invalid(
        context.target_machine(
            TargetOptions {
                triple: "i386-unknown-linux-gnu",
                code_model: CodeModel::Large,
                ..options,
            },
        ),
        ErrorKind::Argument,
    );
}

#[test]
fn abi_layouts_distinguish_sizes_padding_pointer_widths_and_byte_order() -> () {
    let context = Context::new();
    defer {
        let _ = context.close();
    };
    let wide = ok(context.target_machine(TargetOptions::new("x86_64-unknown-linux-gnu")));
    let narrow = ok(context.target_machine(TargetOptions::new("i386-unknown-linux-gnu")));
    let big = ok(context.target_machine(TargetOptions::new("aarch64_be-unknown-linux-gnu")));
    testing::assert_eq(ok(wide.pointer_bytes(0)), 8);
    testing::assert_eq(ok(narrow.pointer_bytes(0)), 4);
    testing::assert_eq(ok(wide.pointer_bytes(270)), 4);
    testing::assert_eq(ok(ok(narrow.pointer_int_type(0)).ir()), "i32");
    testing::assert_eq(ok(ok(wide.pointer_int_type(0)).ir()), "i64");
    testing::assert_eq(ok(wide.byte_order()), ByteOrder::LittleEndian);
    testing::assert_eq(ok(big.byte_order()), ByteOrder::BigEndian);
    let integer = ok(context.int_type(19));
    let layout = ok(wide.type_layout(integer));
    testing::assert_eq(layout.size_bits, 19);
    testing::assert_eq(layout.store_bytes, 3);
    testing::assert_eq(layout.abi_bytes, 4);
    let fields = Vec::from_array(
        [ok(context.int_type(8)), ok(context.int_type(64)), ok(context.pointer_type(0))],
    );
    let unpacked = ok(context.struct_type(fields, false));
    let packed = ok(context.struct_type(fields, true));
    testing::assert_eq(ok(wide.type_layout(unpacked)).abi_bytes, 24);
    testing::assert_eq(ok(wide.type_layout(unpacked)).abi_alignment, 8);
    testing::assert_eq(ok(narrow.type_layout(unpacked)).abi_bytes, 16);
    testing::assert_eq(ok(narrow.type_layout(unpacked)).abi_alignment, 4);
    testing::assert_eq(ok(wide.field_offset(unpacked, 1)), 8);
    testing::assert_eq(ok(wide.field_offset(unpacked, 2)), 16);
    testing::assert_eq(ok(narrow.field_offset(unpacked, 1)), 4);
    testing::assert_eq(ok(narrow.field_offset(unpacked, 2)), 12);
    testing::assert_eq(ok(wide.type_layout(packed)).abi_bytes, 17);
    testing::assert_eq(ok(wide.field_offset(packed, 1)), 1);
    testing::assert_eq(ok(wide.type_layout(ok(context.array_type(unpacked, 3)))).abi_bytes, 72);
    testing::assert_eq(
        ok(wide.type_layout(ok(context.struct_type(Vec::new(), false)))).abi_bytes,
        0,
    );
}

#[test]
fn invalid_or_excessive_layouts_fail_before_native_assertions() -> () {
    let context = Context::new();
    let foreign = Context::new();
    defer {
        let _ = context.close();
        let _ = foreign.close();
    };
    let target = ok(context.target_machine(TargetOptions::native()));
    invalid(target.pointer_bytes(-1), ErrorKind::Argument);
    invalid(target.pointer_int_type(16777216), ErrorKind::Argument);
    invalid(target.type_layout(ok(context.void_type())), ErrorKind::Argument);
    invalid(target.type_layout(ok(foreign.int_type(64))), ErrorKind::Argument);
    let integer = ok(context.int_type(64));
    invalid(target.field_offset(integer, 0), ErrorKind::Argument);
    let pair = ok(context.struct_type(Vec::from_array([integer, integer]), false));
    invalid(target.field_offset(pair, -1), ErrorKind::Argument);
    invalid(target.field_offset(pair, 2), ErrorKind::Argument);
    let large = ok(context.array_type(integer, 2147483647));
    invalid(target.type_layout(ok(context.array_type(large, 2147483647))), ErrorKind::Argument);
    let mut deep = integer;
    let shared = Vec::new();
    for _ in 0..66 {
        shared.push(deep);
        deep = ok(context.array_type(deep, 1));
    }
    invalid(target.type_layout(deep), ErrorKind::Argument);
    invalid(target.type_layout(ok(context.struct_type(shared, false))), ErrorKind::Argument);
    let parsed = ok(
        context.parse_ir(
            "%Opaque = type opaque\ndeclare void @opaque(%Opaque)\ndeclare void @scalable(<vscale x 4 x i32>)",
        ),
    );
    for name in Vec::from_array(["opaque", "scalable"]) {
        let function = ok(parsed.function(name));
        invalid(target.type_layout(ok(function.signature())), ErrorKind::Argument);
        invalid(target.type_layout(ok(ok(function.parameter(0)).value_type())), ErrorKind::Argument);
    }
}

#[test]
fn cross_target_memory_emission_preserves_ir_handles_and_output_snapshots() -> () {
    let context = Context::new();
    defer {
        let _ = context.close();
    };
    let module = ok(
        context.parse_ir("define i64 @answer(i64 %x) { %v = add i64 %x, 42\n ret i64 %v }"),
    );
    let source = ok(module.ir());
    let function = ok(module.function("answer"));
    for (triple, architecture, width) in Vec::from_array(
        [
            ("x86_64-unknown-linux-gnu", 62, 2),
            ("i386-unknown-linux-gnu", 3, 1),
            ("aarch64-unknown-linux-gnu", 183, 2),
        ],
    ) {
        let target = ok(context.target_machine(TargetOptions::new(triple)));
        let output = ok(target.object_bytes(module, 1048576));
        testing::assert_eq(output.get(0), 127);
        testing::assert_eq(output.get(1), 69);
        testing::assert_eq(output.get(4).to_isize(), width);
        testing::assert_eq(output.get(18).to_isize(), architecture);
        testing::assert_eq(output.get(19), 0);
        let assembly = ok(target.assembly_text(module, 1048576));
        testing::assert(assembly.contains("answer"));
        invalid(target.object_bytes(module, 1), ErrorKind::Argument);
        invalid(target.object_bytes(module, 0), ErrorKind::Argument);
        invalid(target.object_bytes(module, 1073741825), ErrorKind::Argument);
        output.set(0, 0);
        testing::assert_eq(ok(target.object_bytes(module, 1048576)).get(0), 127);
        testing::assert_eq(ok(module.ir()), source);
        testing::assert_ok(function.parameter(0));
        ok(target.close());
        invalid(target.object_bytes(module, 1048576), ErrorKind::Closed);
    }
    testing::assert_eq(ok(module.target_triple()), "");
    testing::assert_eq(ok(module.data_layout()), "");
}

#[test]
fn target_configuration_and_passes_enforce_consistency_and_lifetimes() -> () {
    let context = Context::new();
    defer {
        let _ = context.close();
    };
    let target = ok(context.target_machine(TargetOptions::new("aarch64-unknown-linux-gnu")));
    let host = ok(context.target_machine(TargetOptions::native()));
    let module = ok(context.parse_ir("define i64 @f(i64 %x) { %v = add i64 %x, 0\n ret i64 %v }"));
    let function = ok(module.function("f"));
    invalid(target.run_passes(module, ""), ErrorKind::Argument);
    testing::assert_eq(ok(module.target_triple()), "");
    testing::assert_ok(function.ir());
    ok(target.configure(module));
    ok(target.configure(module));
    testing::assert_eq(ok(module.target_triple()), ok(target.triple()));
    testing::assert_eq(ok(module.data_layout()), ok(target.data_layout()));
    testing::assert_ok(function.ir());
    let configured = ok(module.ir());
    invalid(host.configure(module), ErrorKind::Argument);
    invalid(host.object_bytes(module, 1048576), ErrorKind::Argument);
    invalid(host.optimize(module, OptimizationLevel::Default), ErrorKind::Argument);
    testing::assert_eq(ok(module.ir()), configured);
    testing::assert_ok(function.ir());
    ok(target.optimize(module, OptimizationLevel::Default));
    invalid(function.ir(), ErrorKind::Stale);
    testing::assert(!ok(module.ir()).contains("add i64"));
    let fresh = ok(module.function("f"));
    invalid(target.run_passes(module, "not-a-real-pass"), ErrorKind::Llvm);
    invalid(fresh.ir(), ErrorKind::Stale);
    ok(module.verify());
    let decoded = ok(context.parse_bitcode(ok(module.bitcode())));
    testing::assert_eq(ok(decoded.target_triple()), ok(target.triple()));
    testing::assert_eq(ok(decoded.data_layout()), ok(target.data_layout()));
    let conflicting = ok(
        context.parse_ir("target datalayout = \"e-p:32:32\"\ndefine i64 @f() { ret i64 1 }"),
    );
    invalid(target.configure(conflicting), ErrorKind::Argument);
}

#[test]
fn target_close_and_context_ownership_are_explicit() -> () {
    let context = Context::new();
    let foreign = Context::new();
    defer {
        let _ = context.close();
        let _ = foreign.close();
    };
    let target = ok(context.target_machine(TargetOptions::native()));
    let pointer = ok(target.pointer_int_type(0));
    let module = ok(context.parse_ir("define i64 @f() { ret i64 1 }"));
    invalid(target.configure(ok(foreign.module("foreign"))), ErrorKind::Argument);
    ok(target.close());
    ok(target.close());
    testing::assert(target.is_closed());
    invalid(target.triple(), ErrorKind::Closed);
    invalid(target.type_layout(pointer), ErrorKind::Closed);
    testing::assert_ok(pointer.ir());
    let second = ok(context.target_machine(TargetOptions::native()));
    ok(module.close());
    invalid(second.object_bytes(module, 1048576), ErrorKind::Closed);
    testing::assert_ok(second.triple());
    ok(context.close());
    testing::assert(second.is_closed());
    testing::assert(pointer.is_closed());
    invalid(second.byte_order(), ErrorKind::Closed);
    invalid(context.target_machine(TargetOptions::native()), ErrorKind::Closed);
    ok(second.close());
}
