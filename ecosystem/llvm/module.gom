package llvm;

use std::ffi;
use std::bytes::{Bytes};

impl Module {
    pub fn verify(self: Module) -> Result[(), LlvmError] {
        check(raw_verify(self.raw))
    }

    pub fn clone(self: Module) -> Result[Module, LlvmError] {
        Result::Ok(Module { raw: handle(raw_clone(self.raw))? })
    }

    pub fn bitcode(self: Module) -> Result[Bytes, LlvmError] {
        let (value, error) = raw_bitcode(self.raw);
        check(error)?;
        Result::Ok(Bytes::from_vec(ffi::slice_to_vec_copy(value)))
    }

    pub fn add_function(self: Module, name: string, signature: Type) -> Result[Function, LlvmError] {
        Result::Ok(
            Function {
                raw: handle(
                    raw_function(self.raw, ffi::string_from_text(name), signature.raw, true),
                )?,
            },
        )
    }

    pub fn function(self: Module, name: string) -> Result[Function, LlvmError] {
        Result::Ok(
            Function {
                raw: handle(raw_function(self.raw, ffi::string_from_text(name), self.raw, false))?,
            },
        )
    }

    pub fn optimize(self: Module, level: OptimizationLevel) -> Result[(), LlvmError] {
        self.run_passes("default<O" + level.code().to_string() + ">")
    }

    pub fn run_passes(self: Module, pipeline: string) -> Result[(), LlvmError] {
        check(raw_optimize(self.raw, ffi::string_from_text(pipeline)))
    }

    pub fn emit_object(self: Module, path: string, level: OptimizationLevel) -> Result[
        (),
        LlvmError,
    ] {
        check(raw_emit_file(self.raw, ffi::string_from_text(path), false, level.code()))
    }

    pub fn emit_assembly(self: Module, path: string, level: OptimizationLevel) -> Result[
        (),
        LlvmError,
    ] {
        check(raw_emit_file(self.raw, ffi::string_from_text(path), true, level.code()))
    }
}

impl Function {
    pub fn signature(self: Function) -> Result[Type, LlvmError] {
        Result::Ok(Type { raw: handle(raw_value_type(self.raw))? })
    }

    pub fn parameter(self: Function, index: isize) -> Result[Value, LlvmError] {
        Result::Ok(Value { raw: handle(raw_parameter(self.raw, index))? })
    }

    pub fn append_block(self: Function, name: string) -> Result[Block, LlvmError] {
        Result::Ok(Block { raw: handle(raw_new_block(self.raw, ffi::string_from_text(name)))? })
    }
}

impl Value {
    pub fn value_type(self: Value) -> Result[Type, LlvmError] {
        Result::Ok(Type { raw: handle(raw_value_type(self.raw))? })
    }

    pub fn set_name(self: Value, name: string) -> Result[(), LlvmError] {
        check(raw_set_name(self.raw, ffi::string_from_text(name)))
    }

    pub fn add_incoming(self: Value, incoming: Vec[(Value, Block)]) -> Result[(), LlvmError] {
        let values = Vec::new();
        let blocks = Vec::new();
        for (value, block) in incoming {
            values.push(value.raw);
            blocks.push(block.raw);
        }
        check(
            raw_incoming(
                self.raw,
                ffi::slice_from_vec_copy(values),
                ffi::slice_from_vec_copy(blocks),
            ),
        )
    }
}
