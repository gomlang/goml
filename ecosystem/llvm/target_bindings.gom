package llvm;

use std::ffi;

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "HostTarget")]
extern fn raw_host_target() -> (ffi::String, ffi::String, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "TargetNames")]
extern fn raw_target_names() -> ffi::RawSlice[ffi::String];

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "NormalizeTriple")]
extern fn raw_normalize_triple(triple: ffi::String) -> (ffi::String, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "NewTarget")]
extern fn raw_new_target(
    context: NativeHandle,
    triple: ffi::String,
    cpu: ffi::String,
    features: ffi::String,
    level: isize,
    relocation: isize,
    model: isize,
) -> (NativeHandle, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "TargetText")]
extern fn raw_target_text(target: NativeHandle, field: isize) -> (ffi::String, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "ModuleTargetText")]
extern fn raw_module_target_text(module: NativeHandle, layout: bool) -> (ffi::String, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "TargetLittleEndian")]
extern fn raw_target_little_endian(target: NativeHandle) -> (bool, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "TargetPointer")]
extern fn raw_target_pointer(target: NativeHandle, address_space: isize, as_type: bool) -> (
    NativeHandle,
    u64,
    ffi::String,
);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "TargetLayout")]
extern fn raw_target_layout(target: NativeHandle, ty: NativeHandle, operation: isize, index: isize) -> (
    ffi::RawSlice[u64],
    ffi::String,
);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "ConfigureTarget")]
extern fn raw_configure_target(target: NativeHandle, module: NativeHandle) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "OptimizeTarget")]
extern fn raw_optimize_target(target: NativeHandle, module: NativeHandle, pipeline: ffi::String) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "EmitTargetFile")]
extern fn raw_emit_target_file(
    target: NativeHandle,
    module: NativeHandle,
    path: ffi::String,
    assembly: bool,
) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "EmitTargetBytes")]
extern fn raw_emit_target_bytes(
    target: NativeHandle,
    module: NativeHandle,
    assembly: bool,
    limit: isize,
) -> (ffi::RawSlice[u8], ffi::String);
