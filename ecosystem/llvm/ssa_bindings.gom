package llvm;

use std::ffi;

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "PositionBefore")]
extern fn raw_position_before(builder: NativeHandle, instruction: NativeHandle) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "PositionStart")]
extern fn raw_position_start(builder: NativeHandle, block: NativeHandle) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "SavePosition")]
extern fn raw_save_position(builder: NativeHandle) -> (NativeHandle, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "RestorePosition")]
extern fn raw_restore_position(builder: NativeHandle, position: NativeHandle) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "ClearPosition")]
extern fn raw_clear_position(builder: NativeHandle) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "ReadIR")]
extern fn raw_read_ir(handle: NativeHandle, query: isize) -> (
    ffi::RawSlice[NativeHandle],
    ffi::String,
);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "HandleKind")]
extern fn raw_handle_kind(handle: NativeHandle) -> (isize, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "HandleEqual")]
extern fn raw_handle_equal(left: NativeHandle, right: NativeHandle) -> (bool, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "ValueName")]
extern fn raw_value_name(handle: NativeHandle) -> (ffi::String, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "IsPhi")]
extern fn raw_is_phi(handle: NativeHandle) -> (bool, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "EditIncoming")]
extern fn raw_edit_incoming(
    phi: NativeHandle,
    mode: isize,
    index: isize,
    values: ffi::RawSlice[NativeHandle],
    blocks: ffi::RawSlice[NativeHandle],
) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "ReplaceUses")]
extern fn raw_replace_uses(value: NativeHandle, replacement: NativeHandle) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "EraseInstruction")]
extern fn raw_erase_instruction(value: NativeHandle) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "SetOperand")]
extern fn raw_set_operand(instruction: NativeHandle, index: isize, replacement: NativeHandle) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "EntryAlloca")]
extern fn raw_entry_alloca(function: NativeHandle, value_type: NativeHandle, name: ffi::String) -> (
    NativeHandle,
    ffi::String,
);
