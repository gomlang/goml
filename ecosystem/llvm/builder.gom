package llvm;

use std::ffi;

impl Builder {
    pub fn position_at_end(self: Builder, block: Block) -> Result[(), LlvmError] {
        check(raw_position(self.raw, block.raw))
    }

    pub fn binary(self: Builder, operation: BinaryOp, left: Value, right: Value, name: string) -> Result[
        Value,
        LlvmError,
    ] {
        Result::Ok(
            Value {
                raw: handle(
                    raw_binary(
                        self.raw,
                        operation.code(),
                        left.raw,
                        right.raw,
                        ffi::string_from_text(name),
                    ),
                )?,
            },
        )
    }

    pub fn int_compare(
        self: Builder,
        predicate: IntPredicate,
        left: Value,
        right: Value,
        name: string,
    ) -> Result[Value, LlvmError] {
        Result::Ok(
            Value {
                raw: handle(
                    raw_compare(
                        self.raw,
                        predicate.code(),
                        false,
                        left.raw,
                        right.raw,
                        ffi::string_from_text(name),
                    ),
                )?,
            },
        )
    }

    pub fn float_compare(
        self: Builder,
        predicate: FloatPredicate,
        left: Value,
        right: Value,
        name: string,
    ) -> Result[Value, LlvmError] {
        Result::Ok(
            Value {
                raw: handle(
                    raw_compare(
                        self.raw,
                        predicate.code(),
                        true,
                        left.raw,
                        right.raw,
                        ffi::string_from_text(name),
                    ),
                )?,
            },
        )
    }

    pub fn cast(self: Builder, operation: CastOp, value: Value, target: Type, name: string) -> Result[
        Value,
        LlvmError,
    ] {
        Result::Ok(
            Value {
                raw: handle(
                    raw_cast(
                        self.raw,
                        operation.code(),
                        value.raw,
                        target.raw,
                        ffi::string_from_text(name),
                    ),
                )?,
            },
        )
    }

    pub fn call(self: Builder, function: Function, arguments: Vec[Value], name: string) -> Result[
        Value,
        LlvmError,
    ] {
        let values = Vec::new();
        for argument in arguments {
            values.push(argument.raw);
        }
        Result::Ok(
            Value {
                raw: handle(
                    raw_call(
                        self.raw,
                        function.raw,
                        ffi::slice_from_vec_copy(values),
                        ffi::string_from_text(name),
                    ),
                )?,
            },
        )
    }

    fn emit(self: Builder, operation: isize, arguments: Vec[NativeHandle], name: string) -> Result[
        Value,
        LlvmError,
    ] {
        Result::Ok(
            Value {
                raw: handle(
                    raw_emit(
                        self.raw,
                        operation,
                        ffi::slice_from_vec_copy(arguments),
                        ffi::string_from_text(name),
                    ),
                )?,
            },
        )
    }

    pub fn ret(self: Builder, value: Value) -> Result[(), LlvmError] {
        let _ = self.emit(0, Vec::from_array([value.raw]), "")?;
        Result::Ok(())
    }

    pub fn ret_void(self: Builder) -> Result[(), LlvmError] {
        let _ = self.emit(1, Vec::new(), "")?;
        Result::Ok(())
    }

    pub fn branch(self: Builder, block: Block) -> Result[(), LlvmError] {
        let _ = self.emit(2, Vec::from_array([block.raw]), "")?;
        Result::Ok(())
    }

    pub fn conditional_branch(self: Builder, condition: Value, yes: Block, no: Block) -> Result[
        (),
        LlvmError,
    ] {
        let _ = self.emit(3, Vec::from_array([condition.raw, yes.raw, no.raw]), "")?;
        Result::Ok(())
    }

    pub fn alloca(self: Builder, value_type: Type, name: string) -> Result[Value, LlvmError] {
        self.emit(4, Vec::from_array([value_type.raw]), name)
    }

    pub fn load(self: Builder, value_type: Type, pointer: Value, name: string) -> Result[
        Value,
        LlvmError,
    ] {
        self.emit(5, Vec::from_array([value_type.raw, pointer.raw]), name)
    }

    pub fn store(self: Builder, value: Value, pointer: Value) -> Result[(), LlvmError] {
        let _ = self.emit(6, Vec::from_array([value.raw, pointer.raw]), "")?;
        Result::Ok(())
    }

    pub fn select(self: Builder, condition: Value, yes: Value, no: Value, name: string) -> Result[
        Value,
        LlvmError,
    ] {
        self.emit(7, Vec::from_array([condition.raw, yes.raw, no.raw]), name)
    }

    pub fn phi(self: Builder, value_type: Type, name: string) -> Result[Value, LlvmError] {
        self.emit(8, Vec::from_array([value_type.raw]), name)
    }

    pub fn unreachable(self: Builder) -> Result[(), LlvmError] {
        let _ = self.emit(9, Vec::new(), "")?;
        Result::Ok(())
    }

    pub fn gep(
        self: Builder,
        source_type: Type,
        pointer: Value,
        indices: Vec[Value],
        in_bounds: bool,
        name: string,
    ) -> Result[Value, LlvmError] {
        let values = Vec::new();
        for index in indices {
            values.push(index.raw);
        }
        Result::Ok(
            Value {
                raw: handle(
                    raw_gep(
                        self.raw,
                        source_type.raw,
                        pointer.raw,
                        ffi::slice_from_vec_copy(values),
                        in_bounds,
                        ffi::string_from_text(name),
                    ),
                )?,
            },
        )
    }
}
