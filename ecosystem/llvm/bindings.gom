package llvm;

use std::ffi;

#[go_type("example.com/goml-ecosystem/llvm/adapter", "Handle")]
extern type NativeHandle;

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "NewContext")]
extern fn raw_new_context() -> NativeHandle;

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "Close")]
extern fn raw_close(handle: NativeHandle) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "IsClosed")]
extern fn raw_is_closed(handle: NativeHandle) -> bool;

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "NewModule")]
extern fn raw_new_module(handle: NativeHandle, name: ffi::String) -> (NativeHandle, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "Parse")]
extern fn raw_parse(handle: NativeHandle, source: ffi::String, bitcode: bool) -> (
    NativeHandle,
    ffi::String,
);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "Print")]
extern fn raw_print(handle: NativeHandle) -> (ffi::String, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "Verify")]
extern fn raw_verify(handle: NativeHandle) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "Clone")]
extern fn raw_clone(handle: NativeHandle) -> (NativeHandle, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "Bitcode")]
extern fn raw_bitcode(handle: NativeHandle) -> (ffi::RawSlice[u8], ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "Primitive")]
extern fn raw_primitive(handle: NativeHandle, kind: isize, parameter: u64) -> (
    NativeHandle,
    ffi::String,
);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "Composite")]
extern fn raw_composite(
    handle: NativeHandle,
    kind: isize,
    members: ffi::RawSlice[NativeHandle],
    count: u64,
    flag: bool,
) -> (NativeHandle, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "TypeEqual")]
extern fn raw_type_equal(left: NativeHandle, right: NativeHandle) -> (bool, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "ValueType")]
extern fn raw_value_type(handle: NativeHandle) -> (NativeHandle, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "Constant")]
extern fn raw_constant(handle: NativeHandle, kind: isize, integer: u64, real: f64) -> (
    NativeHandle,
    ffi::String,
);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "Aggregate")]
extern fn raw_aggregate(handle: NativeHandle, elements: ffi::RawSlice[NativeHandle]) -> (
    NativeHandle,
    ffi::String,
);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "Function")]
extern fn raw_function(
    handle: NativeHandle,
    name: ffi::String,
    signature: NativeHandle,
    create: bool,
) -> (NativeHandle, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "Parameter")]
extern fn raw_parameter(handle: NativeHandle, index: isize) -> (NativeHandle, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "SetName")]
extern fn raw_set_name(handle: NativeHandle, name: ffi::String) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "NewBlock")]
extern fn raw_new_block(handle: NativeHandle, name: ffi::String) -> (NativeHandle, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "NewBuilder")]
extern fn raw_new_builder(handle: NativeHandle) -> (NativeHandle, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "Position")]
extern fn raw_position(builder: NativeHandle, block: NativeHandle) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "Binary")]
extern fn raw_binary(
    builder: NativeHandle,
    operation: isize,
    left: NativeHandle,
    right: NativeHandle,
    name: ffi::String,
) -> (NativeHandle, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "Compare")]
extern fn raw_compare(
    builder: NativeHandle,
    predicate: isize,
    floating: bool,
    left: NativeHandle,
    right: NativeHandle,
    name: ffi::String,
) -> (NativeHandle, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "Cast")]
extern fn raw_cast(
    builder: NativeHandle,
    operation: isize,
    value: NativeHandle,
    target: NativeHandle,
    name: ffi::String,
) -> (NativeHandle, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "Emit")]
extern fn raw_emit(
    builder: NativeHandle,
    operation: isize,
    arguments: ffi::RawSlice[NativeHandle],
    name: ffi::String,
) -> (NativeHandle, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "Call")]
extern fn raw_call(
    builder: NativeHandle,
    function: NativeHandle,
    arguments: ffi::RawSlice[NativeHandle],
    name: ffi::String,
) -> (NativeHandle, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "Incoming")]
extern fn raw_incoming(
    phi: NativeHandle,
    values: ffi::RawSlice[NativeHandle],
    blocks: ffi::RawSlice[NativeHandle],
) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "GEP")]
extern fn raw_gep(
    builder: NativeHandle,
    source: NativeHandle,
    pointer: NativeHandle,
    indices: ffi::RawSlice[NativeHandle],
    in_bounds: bool,
    name: ffi::String,
) -> (NativeHandle, ffi::String);

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "Optimize")]
extern fn raw_optimize(handle: NativeHandle, pipeline: ffi::String) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "EmitFile")]
extern fn raw_emit_file(handle: NativeHandle, path: ffi::String, assembly: bool, level: isize) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/llvm/adapter", "Version")]
extern fn raw_version() -> ffi::String;
