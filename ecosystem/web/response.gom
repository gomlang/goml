package web;

use std::bytes::{Bytes};
use std::ffi;
use std::json;
use std::serde::{Serialize};

pub struct StreamWriter {
    native: NativeWriter,
}

impl StreamWriter {
    pub fn check(self: StreamWriter) -> Result[(), Error] {
        check(raw_writer_check(self.native))
    }

    pub fn write(self: StreamWriter, bytes: Bytes) -> Result[(), Error] {
        check(raw_write(self.native, ffi::slice_from_vec_copy(bytes.to_vec_copy()), false))
    }

    pub fn send(self: StreamWriter, bytes: Bytes) -> Result[(), Error] {
        check(raw_write(self.native, ffi::slice_from_vec_copy(bytes.to_vec_copy()), true))
    }

    pub fn text(self: StreamWriter, value: string) -> Result[(), Error] {
        self.send(Bytes::from_string(value))
    }

    pub fn event(self: StreamWriter, value: Event) -> Result[(), Error] {
        self.text(value.encode()?)
    }
}

pub struct Event {
    pub data: string,
    pub event: Option[string],
    pub id: Option[string],
    pub retry_milliseconds: Option[u64],
}

impl Event {
    pub fn new(data: string) -> Event {
        Event { data, event: Option::None, id: Option::None, retry_milliseconds: Option::None }
    }

    pub fn encode(self: Event) -> Result[string, Error] {
        let mut output = "";
        if let Some(name) = self.event {
            if name.contains("\r") || name.contains("\n") || name.contains("\u0000") {
                return Result::Err(Error::new(ErrorKind::Configuration, "invalid SSE event name"))
            }
            output = output + "event: " + name + "\n";
        }
        if let Some(id) = self.id {
            if id.contains("\r") || id.contains("\n") || id.contains("\u0000") {
                return Result::Err(Error::new(ErrorKind::Configuration, "invalid SSE event id"))
            }
            output = output + "id: " + id + "\n";
        }
        if let Some(retry) = self.retry_milliseconds {
            output = output + "retry: " + retry.to_string() + "\n";
        }
        for line in self.data.replace("\r\n", "\n").replace("\r", "\n").split("\n") {
            output = output + "data: " + line + "\n";
        }
        Result::Ok(output + "\n")
    }
}

pub struct Response {
    status_value: isize,
    headers_value: Headers,
    bytes_value: Bytes,
    stream_value: Option[(StreamWriter) -> Result[(), Error]],
    error: Option[Error],
}

impl Response {
    pub fn new(status: isize) -> Response {
        Response {
            status_value: status,
            headers_value: Headers::new(),
            bytes_value: Bytes::new(),
            stream_value: Option::None,
            error: if status < 200 || status > 599 {
                Option::Some(
                    Error::new(ErrorKind::Configuration, "response status must be in 200..599"),
                )
            } else {
                Option::None
            },
        }
    }

    pub fn status(self: Response) -> isize {
        self.status_value
    }

    pub fn headers(self: Response) -> Headers {
        self.headers_value
    }

    pub fn body(self: Response, bytes: Bytes) -> Response {
        Response { bytes_value: bytes.copy(), stream_value: Option::None, ..self }
    }

    pub fn header(self: Response, name: string, value: string) -> Response {
        let key = name.to_ascii_lowercase();
        if key == "content-length" || key == "transfer-encoding" || key == "connection"
            || key == "trailer"
            || key == "upgrade"
            || key == "proxy-connection" {
            return Response {
                error: Option::Some(
                    Error::new(ErrorKind::Configuration, "transport manages header: " + name),
                ),
                ..self,
            }
        }
        match self.headers_value.insert(name, value) {
            Ok(headers_value) => Response { headers_value, ..self },
            Err(error) => Response { error: Option::Some(error), ..self },
        }
    }

    pub fn append_header(self: Response, name: string, value: string) -> Response {
        let checked = self.header(name, value);
        if checked.error.is_some() {
            return checked
        }
        match self.headers_value.append(name, value) {
            Ok(headers_value) => Response { headers_value, ..self },
            Err(error) => Response { error: Option::Some(error), ..self },
        }
    }

    pub fn text(status: isize, value: string) -> Response {
        Response::new(status).body(Bytes::from_string(value)).header(
            "content-type",
            "text/plain; charset=utf-8",
        )
    }

    pub fn html(status: isize, value: string) -> Response {
        Response::new(status).body(Bytes::from_string(value)).header(
            "content-type",
            "text/html; charset=utf-8",
        )
    }

    pub fn json[T: Serialize](status: isize, value: T) -> Result[Response, Error] {
        let data = json::try_to_string(value).map_err(|e| Error::new(ErrorKind::Internal, e))?;
        Result::Ok(
            Response::new(status).body(Bytes::from_string(data)).header(
                "content-type",
                "application/json",
            ),
        )
    }

    pub fn redirect(status: isize, location: string) -> Result[Response, Error] {
        if status != 301 && status != 302 && status != 303 && status != 307 && status != 308 {
            return Result::Err(Error::new(ErrorKind::Configuration, "invalid redirect status"))
        }
        let response = Response::new(status).header("location", location);
        response.validate()?;
        Result::Ok(response)
    }

    pub fn stream(
        status: isize,
        content_type: string,
        producer: (StreamWriter) -> Result[(), Error],
    ) -> Response {
        Response {
            stream_value: Option::Some(producer),
            ..Response::new(status).header("content-type", content_type),
        }
    }

    pub fn sse(producer: (StreamWriter) -> Result[(), Error]) -> Response {
        Response::stream(200, "text/event-stream", producer).header("cache-control", "no-cache").header(
            "x-accel-buffering",
            "no",
        )
    }

    pub fn validate(self: Response) -> Result[(), Error] {
        if let Some(error) = self.error {
            return Result::Err(error)
        }
        if (self.status_value == 204 || self.status_value == 304)
            && (!self.bytes_value.is_empty() || self.stream_value.is_some()) {
            return Result::Err(Error::new(ErrorKind::Configuration, "status does not allow a body"))
        }
        Result::Ok(())
    }

    fn into_native(self: Response) -> NativeResponse {
        let response = match self.validate() {
            Ok(_) => self,
            Err(error) => error.response(),
        };
        let (names, values) = encode_headers(response.headers_value);
        let stream: ffi::Func[(NativeWriter) -> NativeFailure] = match response.stream_value {
            None => ffi::func_nil(),
            Some(producer) => ffi::func_from_closure(
                |native| match producer(StreamWriter { native }) {
                    Ok(_) => raw_success(),
                    Err(error) => failure(error),
                },
            ),
        };
        raw_response(
            response.status_value,
            names,
            values,
            ffi::slice_from_vec_copy(response.bytes_value.to_vec_copy()),
            stream,
        )
    }
}
