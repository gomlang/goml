package web;

use std::bytes::{Bytes};
use std::json;
use std::serde::{Serialize, Deserialize};

#[derive(Debug, PartialEq)]
pub enum ErrorKind {
    Configuration,
    BadRequest,
    BodyLimit,
    Cancelled,
    Timeout,
    Transport,
    Closed,
    Internal,
    UnsupportedMediaType,
    UnprocessableEntity,
}

#[derive(Debug)]
pub struct Error {
    pub kind: ErrorKind,
    pub message: string,
}

impl Error {
    pub fn new(kind: ErrorKind, message: string) -> Error {
        Error { kind, message }
    }

    pub fn status(self: Error) -> isize {
        match self.kind {
            ErrorKind::BadRequest => 400,
            ErrorKind::BodyLimit => 413,
            ErrorKind::UnsupportedMediaType => 415,
            ErrorKind::UnprocessableEntity => 422,
            ErrorKind::Cancelled => 499,
            ErrorKind::Timeout => 504,
            _ => 500,
        }
    }

    pub fn response(self: Error) -> Response {
        let message = if self.status() == 500 {
            "internal server error"
        } else {
            self.message
        };
        Response::text(self.status(), message)
    }
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        self.message
    }
}

fn token(value: string) -> bool {
    if value.byte_len() == 0 {
        return false
    }
    for c in value.to_bytes() {
        if !((c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9')
            || c == b'!'
            || c == b'#'
            || c == b'$'
            || c == b'%'
            || c == b'&'
            || c == b'\''
            || c == b'*'
            || c == b'+'
            || c == b'-'
            || c == b'.'
            || c == b'^'
            || c == b'_'
            || c == b'`'
            || c == b'|'
            || c == b'~') {
            return false
        }
    }
    true
}

pub struct Headers {
    values: Vec[(string, string)],
}

impl Headers {
    pub fn new() -> Headers {
        Headers { values: Vec::new() }
    }

    pub fn len(self: Headers) -> isize {
        self.values.len()
    }

    pub fn entries(self: Headers) -> Vec[(string, string)] {
        self.values.copy()
    }

    pub fn get(self: Headers, name: string) -> Option[string] {
        for entry in self.values {
            if entry.0 == name.to_ascii_lowercase() {
                return Option::Some(entry.1)
            }
        }
        Option::None
    }

    pub fn get_all(self: Headers, name: string) -> Vec[string] {
        let values = Vec::new();
        for entry in self.values {
            if entry.0 == name.to_ascii_lowercase() {
                values.push(entry.1)
            }
        }
        values
    }

    pub fn append(self: Headers, name: string, value: string) -> Result[Headers, Error] {
        if !token(name) {
            return Result::Err(Error::new(ErrorKind::Configuration, "invalid header name"))
        }
        for c in value.to_bytes() {
            if c == 127 || c < 32 && c != 9 {
                return Result::Err(Error::new(ErrorKind::Configuration, "invalid header value"))
            }
        }
        let values = self.values.copy();
        values.push((name.to_ascii_lowercase(), value));
        Result::Ok(Headers { values })
    }

    pub fn remove(self: Headers, name: string) -> Headers {
        let values = Vec::new();
        for entry in self.values {
            if entry.0 != name.to_ascii_lowercase() {
                values.push(entry)
            }
        }
        Headers { values }
    }

    pub fn insert(self: Headers, name: string, value: string) -> Result[Headers, Error] {
        self.remove(name).append(name, value)
    }
}

fn content_type(headers: Headers, expected: string) -> bool {
    match headers.get("content-type") {
        None => false,
        Some(value) => value.split(";")[0].trim().eq_ignore_ascii_case(expected),
    }
}

pub struct CapturedResponse {
    pub status: isize,
    pub headers: Headers,
    body_value: Bytes,
}

impl CapturedResponse {
    pub fn bytes(self: CapturedResponse) -> Bytes {
        self.body_value.copy()
    }

    pub fn text(self: CapturedResponse) -> Result[string, Error] {
        let (valid, text) = string_from_utf8(self.body_value.to_vec_copy());
        if valid {
            Result::Ok(text)
        } else {
            Result::Err(Error::new(ErrorKind::BadRequest, "body is not UTF-8"))
        }
    }

    pub fn json[T: Deserialize](self: CapturedResponse) -> Result[T, Error] {
        json::from_string(self.text()?).map_err(|e| Error::new(ErrorKind::UnprocessableEntity, e))
    }
}
