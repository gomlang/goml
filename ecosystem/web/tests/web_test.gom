package tests;

use ecosystem::web;
use ecosystem::web::{Router, Headers, Response, Request, Error, ErrorKind, Limits, Event, StreamWriter};
use std::bytes::{Bytes};
use std::testing;
use std::serde::{Serialize, Deserialize};
use std::time::{Duration};
use std::io;

fn call(router: Router, method: string, path: string) -> web::CapturedResponse {
    testing::expect_ok(router.dispatch(method, path, Headers::new(), Bytes::new()), "dispatch")
}

fn text(router: Router, method: string, path: string) -> string {
    testing::expect_ok(call(router, method, path).text(), "text")
}

fn ok(request: Request) -> Result[Response, Error] {
    Result::Ok(Response::text(200, request.path()))
}

#[test]
fn routing_literal_parameter_wildcard_and_unicode() -> () {
    let router = Router::new().get(
        "/users/{id}",
        |request| Result::Ok(Response::text(200, request.params().required("id")?)),
    ).get("/users/new", |_| Result::Ok(Response::text(200, "literal"))).get(
        "/files/{*path}",
        |request| Result::Ok(Response::text(200, request.params().required("path")?)),
    ).get("/你好", |_| Result::Ok(Response::text(200, "unicode")));
    testing::assert_eq(text(router, "GET", "/users/42"), "42");
    testing::assert_eq(text(router, "GET", "/users/new"), "literal");
    testing::assert_eq(text(router, "GET", "/users/a%2Fb"), "a/b");
    testing::assert_eq(text(router, "GET", "/users/a+b"), "a+b");
    testing::assert_eq(text(router, "GET", "/files/a/b%20c"), "a/b c");
    testing::assert_eq(text(router, "GET", "/%E4%BD%A0%E5%A5%BD"), "unicode");
    testing::assert_eq(call(router, "GET", "/files/").status, 404);
    testing::assert_eq(call(router, "GET", "/users/42/").status, 404);
    testing::assert_eq(call(router, "GET", "/missing").status, 404);
}

#[test]
fn precedence_does_not_fall_through_to_less_specific_methods() -> () {
    let router = Router::new().get("/a/static", ok).post("/a/{x}", ok).get("/a/{*rest}", ok);
    let response = call(router, "POST", "/a/static");
    testing::assert_eq(response.status, 405);
    testing::assert(response.headers.get("allow") == Option::Some("GET, HEAD, OPTIONS"));
    testing::assert_eq(call(router, "POST", "/a/value").status, 200);
    testing::assert_eq(call(router, "GET", "/a/value").status, 405);
}

#[test]
fn head_options_and_explicit_handlers() -> () {
    let router = Router::new().get("/hello", |_| Result::Ok(Response::text(201, "hello"))).post(
        "/hello",
        ok,
    );
    let head = call(router, "HEAD", "/hello");
    testing::assert_eq(head.status, 201);
    testing::assert(head.bytes().is_empty());
    let options = call(router, "OPTIONS", "/hello");
    testing::assert_eq(options.status, 204);
    testing::assert(options.headers.get("allow") == Option::Some("GET, HEAD, POST, OPTIONS"));
    let custom = router.route("HEAD", "/hello", |_| Result::Ok(Response::new(202))).route(
        "OPTIONS",
        "/hello",
        |_| Result::Ok(Response::new(203)),
    );
    testing::assert_eq(call(custom, "HEAD", "/hello").status, 202);
    testing::assert_eq(call(custom, "OPTIONS", "/hello").status, 203);
}

#[test]
fn malformed_routes_are_recoverable_and_router_is_persistent() -> () {
    let original = Router::new().get("/a", ok);
    let added = original.get("/b", ok);
    testing::assert_eq(call(original, "GET", "/b").status, 404);
    testing::assert_eq(call(added, "GET", "/b").status, 200);
    for path in Vec::from_array(
        ["relative", "/a?b", "/a#b", "/a%20b", "/{*rest}/x", "/{id}/{id}", "/{}", "/{x", "/x}"],
    ) {
        testing::assert(Router::new().get(path, ok).validate().is_err());
    }
    testing::assert(original.get("/a", ok).validate().is_err());
    testing::assert(Router::new().get("/{x}", ok).post("/{y}", ok).validate().is_err());
    testing::assert(Router::new().route("get", "/", ok).validate().is_err());
}

#[test]
fn layers_nesting_attributes_and_error_recovery() -> () {
    let child = Router::new().get(
        "/item",
        |request| Result::Ok(Response::text(200, request.attribute("tag").unwrap_or("missing"))),
    ).layer(|request, next| next.run(request.with_attribute("tag", "child")));
    let router = Router::new().nest("/api", child).layer(
        |request, next| Result::Ok(next.run(request)?.header("x-outer", "yes")),
    ).layer(|request, next| next.run(request.with_attribute("tag", "outer")));
    let response = call(router, "GET", "/api/item");
    testing::assert_eq(testing::expect_ok(response.text(), "text"), "child");
    testing::assert(response.headers.get("x-outer") == Option::Some("yes"));
    testing::assert(call(router, "GET", "/missing").headers.get("x-outer") == Option::Some("yes"));
    let failed = Router::new().get(
        "/",
        |_| Result::Err(Error::new(ErrorKind::BadRequest, "bad input")),
    ).layer(
        |request, next| match next.run(request) {
            Result::Ok(value) => Result::Ok(value),
            Result::Err(error) => Result::Ok(Response::text(409, error.message)),
        },
    );
    testing::assert_eq(call(failed, "GET", "/").status, 409);
    testing::assert(Router::new().nest("/bad/", Router::new()).validate().is_err());
}

#[derive(Serialize, Deserialize)]
struct Message {
    name: string,
    count: isize,
}

#[test]
fn typed_json_roundtrip_and_content_types() -> () {
    let router = Router::new().post(
        "/",
        |request| {
            let value: Message = request.json()?;
            Response::json(201, Message { name: value.name, count: value.count + 1 })
        },
    );
    let headers = testing::expect_ok(
        Headers::new().insert("Content-Type", "application/problem+json; charset=utf-8"),
        "headers",
    );
    let response = testing::expect_ok(
        router.dispatch("POST", "/", headers, Bytes::from_string("{\"name\":\"中😀\",\"count\":41}")),
        "json request",
    );
    let message: Message = testing::expect_ok(response.json(), "decode");
    testing::assert_eq(message.name, "中😀");
    testing::assert_eq(message.count, 42);
    testing::assert_eq(response.status, 201);
    testing::assert(response.headers.get("content-type") == Option::Some("application/json"));
    testing::assert_eq(call(router, "POST", "/").status, 415);
    let broken = testing::expect_ok(
        router.dispatch("POST", "/", headers, Bytes::from_string("bad")),
        "invalid JSON",
    );
    testing::assert_eq(broken.status, 422);
}

#[derive(Serialize, Deserialize)]
struct Fields {
    name: string,
    count: i16,
    enabled: bool,
    tag: Vec[string],
}

#[test]
fn typed_form_and_query_preserve_strings_and_repeated_fields() -> () {
    let raw = "name=0001%2B%E4%B8%AD&count=-12&enabled=true&tag=a&tag=b";
    let pairs = testing::expect_ok(web::parse_pairs(raw, 10), "pairs");
    let value: Fields = testing::expect_ok(pairs.decode(), "typed pairs");
    testing::assert_eq(value.name, "0001+中");
    testing::assert_eq(value.count, -12);
    testing::assert(value.enabled);
    testing::assert_eq(value.tag.len(), 2);
    let router = Router::new().get(
        "/",
        |request| {
            let value: Fields = request.query_as()?;
            Response::json(200, value)
        },
    ).post(
        "/",
        |request| {
            let value: Fields = request.form_as()?;
            Response::json(200, value)
        },
    );
    let decoded: Fields = testing::expect_ok(call(router, "GET", "/?" + raw).json(), "query");
    testing::assert_eq(decoded.count, -12);
    let headers = testing::expect_ok(
        Headers::new().insert("content-type", "application/x-www-form-urlencoded"),
        "headers",
    );
    let response = testing::expect_ok(
        router.dispatch("POST", "/", headers, Bytes::from_string(raw)),
        "form",
    );
    testing::assert_eq(response.status, 200);
    let invalid: Result[Fields, Error] = testing::expect_ok(
        web::parse_pairs(raw + "&count=3", 10),
        "pairs",
    ).decode();
    testing::assert(invalid.is_err());
    let overflow: Result[Fields, Error] = testing::expect_ok(
        web::parse_pairs(raw.replace("-12", "999999999999"), 10),
        "pairs",
    ).decode();
    testing::assert(overflow.is_err());
}

#[test]
fn percent_decoding_and_field_limits_reject_malformed_values() -> () {
    let pairs = testing::expect_ok(web::parse_pairs("a=one+two&a=x%3Dy&empty&=v&&", 4), "pairs");
    testing::assert_eq(pairs.get_all("a").len(), 2);
    testing::assert_eq(pairs.required("a").unwrap_or(""), "one two");
    testing::assert(pairs.get("empty") == Option::Some(""));
    testing::assert(pairs.get("") == Option::Some("v"));
    testing::assert(web::parse_pairs("a=1&b=2", 1).is_err());
    for value in Vec::from_array(["x=%", "x=%0", "x=%XX", "x=%FF"]) {
        testing::assert(web::parse_pairs(value, 10).is_err());
    }
    let router = Router::new().get("/{id}", ok);
    testing::assert_eq(call(router, "GET", "/%FF").status, 400);
}

#[test]
fn header_validation_snapshots_and_error_redaction() -> () {
    let headers = testing::expect_ok(Headers::new().append("X-Test", "one"), "append");
    let more = testing::expect_ok(headers.append("x-test", "two"), "append");
    testing::assert_eq(headers.len(), 1);
    testing::assert_eq(more.get_all("X-TEST").len(), 2);
    more.entries().clear();
    testing::assert_eq(more.len(), 2);
    testing::assert(headers.append("bad name", "x").is_err());
    testing::assert(headers.append("x", "bad\r\nvalue").is_err());
    testing::assert(Response::new(200).header("Content-Length", "1").validate().is_err());
    testing::assert(Response::new(204).body(Bytes::from_string("bad")).validate().is_err());
    testing::assert(Response::new(199).validate().is_err());
    let router = Router::new().get(
        "/",
        |_| Result::Err(Error::new(ErrorKind::Internal, "secret detail")),
    );
    testing::assert_eq(text(router, "GET", "/"), "internal server error");
}

#[test]
fn request_body_and_response_capture_limits() -> () {
    let router = Router::new().post("/", |request| Result::Ok(Response::text(200, request.text()?))).limits(
        Limits { body_bytes: 4, extraction_bytes: 2, ..Limits::new() },
    );
    let extracted = testing::expect_ok(
        router.dispatch("POST", "/", Headers::new(), Bytes::from_string("123")),
        "extraction limit",
    );
    testing::assert_eq(extracted.status, 413);
    let too_large = testing::expect_err(
        router.dispatch("POST", "/", Headers::new(), Bytes::from_string("12345")),
        "transport limit",
    );
    testing::assert_eq(too_large.kind, ErrorKind::BodyLimit);
    let capture = Router::new().get("/", |_| Result::Ok(Response::text(200, "12345"))).limits(
        Limits { capture_bytes: 4, ..Limits::new() },
    );
    let error = testing::expect_err(
        capture.dispatch("GET", "/", Headers::new(), Bytes::new()),
        "capture limit",
    );
    testing::assert_eq(error.kind, ErrorKind::BodyLimit);
}

#[test]
fn request_and_writer_handles_expire_after_dispatch() -> () {
    let saved_request: Ref[Option[Request]] = Ref::new(Option::None);
    let saved_writer: Ref[Option[StreamWriter]] = Ref::new(Option::None);
    let router = Router::new().get(
        "/",
        |request| {
            saved_request.set(Option::Some(request));
            Result::Ok(
                Response::stream(
                    200,
                    "text/plain",
                    |writer| {
                        saved_writer.set(Option::Some(writer));
                        writer.text("hello")
                    },
                ),
            )
        },
    );
    testing::assert_eq(text(router, "GET", "/"), "hello");
    let request = testing::expect_some(saved_request.get(), "request");
    let writer = testing::expect_some(saved_writer.get(), "writer");
    testing::assert_eq(
        testing::expect_err(request.check(), "expired request").kind,
        ErrorKind::Closed,
    );
    testing::assert_eq(
        testing::expect_err(writer.text("late"), "expired writer").kind,
        ErrorKind::Closed,
    );
}

#[test]
fn sse_multiline_metadata_validation_and_head_skips_producer() -> () {
    let event = Event {
        data: "a\r\nb\rc\n",
        event: Option::Some("update"),
        id: Option::Some("42"),
        retry_milliseconds: Option::Some(250),
    };
    testing::assert_eq(
        testing::expect_ok(event.encode(), "event"),
        "event: update\nid: 42\nretry: 250\ndata: a\ndata: b\ndata: c\ndata: \n\n",
    );
    testing::assert(Event { id: Option::Some("x\ny"), ..Event::new("safe") }.encode().is_err());
    let invoked = Ref::new(0);
    let router = Router::new().get(
        "/events",
        |_| Result::Ok(
            Response::sse(
                |writer| {
                    invoked.set(invoked.get() + 1);
                    writer.event(Event::new("中😀"))?;
                    writer.event(Event::new("next"))
                },
            ),
        ),
    );
    testing::assert(call(router, "HEAD", "/events").bytes().is_empty());
    testing::assert_eq(invoked.get(), 0);
    let response = call(router, "GET", "/events");
    testing::assert(response.headers.get("content-type") == Option::Some("text/event-stream"));
    testing::assert_eq(testing::expect_ok(response.text(), "events"), "data: 中😀\n\ndata: next\n\n");
    testing::assert_eq(invoked.get(), 1);
}

#[test]
fn streaming_composes_with_standard_io_and_bounded_chunks() -> () {
    let router = Router::new().post(
        "/",
        |request| Result::Ok(
            Response::stream(
                200,
                "application/octet-stream",
                |writer| {
                    let count = io::copy(request.body(), writer).map_err(
                        |error| Error::new(ErrorKind::Transport, error.to_string()),
                    )?;
                    if count == 0 {
                        return Result::Err(Error::new(ErrorKind::BadRequest, "empty stream"))
                    }
                    Result::Ok(())
                },
            ),
        ),
    );
    let input = Bytes::from_string("abcdef".repeat(30000));
    let response = testing::expect_ok(
        router.dispatch("POST", "/", Headers::new(), input),
        "stream copy",
    );
    testing::assert_eq(response.bytes().len(), 180000);
    testing::assert_eq(testing::expect_ok(response.text(), "stream body"), "abcdef".repeat(30000));
}

#[test]
fn total_deadline_interrupts_cooperative_handler() -> () {
    let router = Router::new().get(
        "/",
        |request| {
            request.wait(Duration::from_seconds(3))?;
            Result::Ok(Response::new(200))
        },
    ).limits(Limits { request_timeout: Duration::from_milliseconds(5), ..Limits::new() });
    let error = testing::expect_err(
        router.dispatch("GET", "/", Headers::new(), Bytes::new()),
        "deadline",
    );
    testing::assert_eq(error.kind, ErrorKind::Timeout);
}

#[test]
fn server_ephemeral_port_shutdown_and_validation() -> () {
    let server = testing::expect_ok(Router::new().get("/", ok).serve("127.0.0.1:0"), "start");
    testing::assert(testing::expect_ok(server.address(), "address").starts_with("127.0.0.1:"));
    testing::assert(!server.is_closed());
    testing::expect_ok(server.shutdown(Duration::from_seconds(1)), "shutdown");
    testing::assert(server.is_closed());
    testing::expect_ok(server.shutdown(Duration::from_seconds(1)), "shutdown again");
    testing::assert(
        Router::new().limits(Limits { concurrent_requests: 0, ..Limits::new() }).validate().is_err(),
    );
}
