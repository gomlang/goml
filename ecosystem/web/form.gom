package web;

use std::serde;
use std::serde::{Deserialize, Deserializer, Value, FieldKey, VariantKey};

struct FormDeserializer {
    inner: serde::ValueDeserializer,
}

fn form_scalar(value: FormDeserializer) -> Result[string, string] {
    match value.inner.deserialize_any()? {
        Value::String(text) => Result::Ok(text),
        Value::Sequence(values) => {
            if values.len() != 1 {
                return Result::Err("duplicate scalar form field")
            }
            match values[0] {
                Value::String(text) => Result::Ok(text),
                _ => Result::Err("expected textual form field"),
            }
        },
        _ => Result::Err("expected textual form field"),
    }
}

impl Pairs {
    pub fn decode[T: Deserialize](self: Pairs) -> Result[T, Error] {
        let fields: Vec[(string, Value)] = Vec::new();
        let seen: HashMap[string, bool] = HashMap::new();
        for entry in self.values {
            if seen.get(entry.0).is_some() {
                continue
            }
            seen.insert(entry.0, true);
            let values: Vec[Value] = Vec::new();
            for value in self.get_all(entry.0) {
                values.push(Value::String(value))
            }
            fields.push((entry.0, Value::Sequence(values)));
        }
        let inner = serde::value_deserializer(Value::Struct(fields));
        let decoded: Result[T, string] = Deserialize::deserialize(FormDeserializer { inner });
        let value = decoded.map_err(|e| Error::new(ErrorKind::UnprocessableEntity, e))?;
        serde::finish_value_deserializer(inner).map_err(
            |e| Error::new(ErrorKind::UnprocessableEntity, e),
        )?;
        Result::Ok(value)
    }
}

impl Deserializer for FormDeserializer {
    fn deserialize_any(self: FormDeserializer) -> Result[Value, string] {
        self.inner.deserialize_any()
    }

    fn deserialize_unit(self: FormDeserializer) -> Result[(), string] {
        if form_scalar(self)?.byte_len() == 0 {
            Result::Ok(())
        } else {
            Result::Err("expected empty unit field")
        }
    }

    fn deserialize_bool(self: FormDeserializer) -> Result[bool, string] {
        match form_scalar(self)? {
            "true" => Result::Ok(true),
            "false" => Result::Ok(false),
            _ => Result::Err("expected true or false"),
        }
    }

    fn deserialize_int(self: FormDeserializer) -> Result[isize, string] {
        serde::value_deserializer(Value::Number(form_scalar(self)?)).deserialize_int()
    }

    fn deserialize_int8(self: FormDeserializer) -> Result[i8, string] {
        serde::value_deserializer(Value::Number(form_scalar(self)?)).deserialize_int8()
    }

    fn deserialize_int16(self: FormDeserializer) -> Result[i16, string] {
        serde::value_deserializer(Value::Number(form_scalar(self)?)).deserialize_int16()
    }

    fn deserialize_int32(self: FormDeserializer) -> Result[i32, string] {
        serde::value_deserializer(Value::Number(form_scalar(self)?)).deserialize_int32()
    }

    fn deserialize_int64(self: FormDeserializer) -> Result[i64, string] {
        serde::value_deserializer(Value::Number(form_scalar(self)?)).deserialize_int64()
    }

    fn deserialize_uint(self: FormDeserializer) -> Result[usize, string] {
        serde::value_deserializer(Value::Number(form_scalar(self)?)).deserialize_uint()
    }

    fn deserialize_uint8(self: FormDeserializer) -> Result[u8, string] {
        serde::value_deserializer(Value::Number(form_scalar(self)?)).deserialize_uint8()
    }

    fn deserialize_uint16(self: FormDeserializer) -> Result[u16, string] {
        serde::value_deserializer(Value::Number(form_scalar(self)?)).deserialize_uint16()
    }

    fn deserialize_uint32(self: FormDeserializer) -> Result[u32, string] {
        serde::value_deserializer(Value::Number(form_scalar(self)?)).deserialize_uint32()
    }

    fn deserialize_uint64(self: FormDeserializer) -> Result[u64, string] {
        serde::value_deserializer(Value::Number(form_scalar(self)?)).deserialize_uint64()
    }

    fn deserialize_float32(self: FormDeserializer) -> Result[f32, string] {
        serde::value_deserializer(Value::Number(form_scalar(self)?)).deserialize_float32()
    }

    fn deserialize_float64(self: FormDeserializer) -> Result[f64, string] {
        serde::value_deserializer(Value::Number(form_scalar(self)?)).deserialize_float64()
    }

    fn deserialize_number(self: FormDeserializer) -> Result[string, string] {
        serde::value_deserializer(Value::Number(form_scalar(self)?)).deserialize_number()
    }

    fn deserialize_string(self: FormDeserializer) -> Result[string, string] {
        form_scalar(self)
    }

    fn deserialize_char(self: FormDeserializer) -> Result[char, string] {
        serde::value_deserializer(Value::String(form_scalar(self)?)).deserialize_char()
    }

    fn deserialize_bytes(self: FormDeserializer) -> Result[Vec[byte], string] {
        Result::Ok(form_scalar(self)?.to_bytes())
    }

    fn begin_optional(self: FormDeserializer) -> Result[bool, string] {
        self.inner.begin_optional()
    }

    fn end_optional(self: FormDeserializer) -> Result[(), string] {
        self.inner.end_optional()
    }

    fn begin_sequence(self: FormDeserializer) -> Result[Option[isize], string] {
        self.inner.begin_sequence()
    }

    fn next_sequence_element(self: FormDeserializer) -> Result[bool, string] {
        self.inner.next_sequence_element()
    }

    fn end_sequence(self: FormDeserializer) -> Result[(), string] {
        self.inner.end_sequence()
    }

    fn begin_tuple(self: FormDeserializer, length: isize) -> Result[(), string] {
        self.inner.begin_tuple(length)
    }

    fn begin_tuple_element(self: FormDeserializer, index: isize) -> Result[(), string] {
        self.inner.begin_tuple_element(index)
    }

    fn end_tuple(self: FormDeserializer) -> Result[(), string] {
        self.inner.end_tuple()
    }

    fn begin_map(self: FormDeserializer) -> Result[Option[isize], string] {
        self.inner.begin_map()
    }

    fn next_map_entry(self: FormDeserializer) -> Result[bool, string] {
        self.inner.next_map_entry()
    }

    fn begin_map_key(self: FormDeserializer) -> Result[(), string] {
        self.inner.begin_map_key()
    }

    fn begin_map_value(self: FormDeserializer) -> Result[(), string] {
        self.inner.begin_map_value()
    }

    fn end_map(self: FormDeserializer) -> Result[(), string] {
        self.inner.end_map()
    }

    fn begin_struct(self: FormDeserializer, name: string, fields: isize) -> Result[(), string] {
        self.inner.begin_struct(name, fields)
    }

    fn next_struct_field(self: FormDeserializer) -> Result[Option[FieldKey], string] {
        self.inner.next_struct_field()
    }

    fn skip_value(self: FormDeserializer) -> Result[(), string] {
        self.inner.skip_value()
    }

    fn end_struct(self: FormDeserializer) -> Result[(), string] {
        self.inner.end_struct()
    }

    fn begin_variant(self: FormDeserializer, enum_name: string, variants: isize) -> Result[
        VariantKey,
        string,
    ] {
        self.inner.begin_variant(enum_name, variants)
    }

    fn begin_variant_fields(self: FormDeserializer, kind: isize, fields: isize) -> Result[
        (),
        string,
    ] {
        self.inner.begin_variant_fields(kind, fields)
    }

    fn next_variant_field(self: FormDeserializer) -> Result[Option[FieldKey], string] {
        self.inner.next_variant_field()
    }

    fn end_variant(self: FormDeserializer) -> Result[(), string] {
        self.inner.end_variant()
    }
}
