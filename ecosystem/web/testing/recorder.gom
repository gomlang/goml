package testing;

use ecosystem::web;
use web::{CapturedResponse, Error, Headers, Router};
use std::bytes::{Bytes};

pub struct Exchange {
    pub method: string,
    pub target: string,
    pub result: Result[CapturedResponse, Error],
}

pub struct Recorder {
    router: Router,
    exchanges: Channel[Vec[Exchange]],
}

pub struct RecordedRequest {
    recorder: Recorder,
    method_value: string,
    target_value: string,
    headers_value: Headers,
    body_value: Bytes,
}

impl Recorder {
    pub fn new(router: Router) -> Recorder {
        let exchanges = Channel::new(1);
        exchanges.send(Vec::new());
        Recorder { router, exchanges }
    }

    pub fn request(self: Recorder, method: string, target: string) -> RecordedRequest {
        RecordedRequest {
            recorder: self,
            method_value: method,
            target_value: target,
            headers_value: Headers::new(),
            body_value: Bytes::new(),
        }
    }

    pub fn record(self: Recorder, method: string, target: string, headers: Headers, body: Bytes) -> Result[
        CapturedResponse,
        Error,
    ] {
        let result = self.router.dispatch(method, target, headers, body);
        let exchanges = self.exchanges.recv().unwrap_or(Vec::new());
        exchanges.push(Exchange { method, target, result });
        self.exchanges.send(exchanges);
        result
    }

    pub fn exchanges(self: Recorder) -> Vec[Exchange] {
        let exchanges = self.exchanges.recv().unwrap_or(Vec::new());
        let snapshot = exchanges.copy();
        self.exchanges.send(exchanges);
        snapshot
    }
}

impl RecordedRequest {
    pub fn header(self: RecordedRequest, name: string, value: string) -> Result[
        RecordedRequest,
        Error,
    ] {
        Result::Ok(
            RecordedRequest { headers_value: self.headers_value.append(name, value)?, ..self },
        )
    }

    pub fn body(self: RecordedRequest, body: Bytes) -> RecordedRequest {
        RecordedRequest { body_value: body.copy(), ..self }
    }

    pub fn send(self: RecordedRequest) -> Result[CapturedResponse, Error] {
        self.recorder.record(
            self.method_value,
            self.target_value,
            self.headers_value,
            self.body_value,
        )
    }
}
