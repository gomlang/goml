package testing;

use ecosystem::web;
use web::{CapturedResponse, Error, ErrorKind, Headers, Router};
use std::bytes::{Bytes};

#[derive(Debug, PartialEq)]
pub enum Fault {
    Pass,
    Reject(ErrorKind),
    TruncateBody(isize),
    FailAfter(ErrorKind),
}

struct FaultState {
    actions: Vec[Fault],
    cursor: isize,
}

pub struct FaultTransport {
    router: Router,
    state: Channel[FaultState],
}

impl FaultTransport {
    pub fn new(router: Router, actions: Vec[Fault]) -> FaultTransport {
        let state = Channel::new(1);
        state.send(FaultState { actions: actions.copy(), cursor: 0 });
        FaultTransport { router, state }
    }

    pub fn calls(self: FaultTransport) -> isize {
        let state = self.state.recv().unwrap_or(FaultState { actions: Vec::new(), cursor: 0 });
        let count = state.cursor;
        self.state.send(state);
        count
    }

    pub fn dispatch(
        self: FaultTransport,
        method: string,
        target: string,
        headers: Headers,
        body: Bytes,
    ) -> Result[CapturedResponse, Error] {
        let state = self.state.recv().unwrap_or(FaultState { actions: Vec::new(), cursor: 0 });
        let action = state.actions.get_checked(state.cursor).unwrap_or(Fault::Pass);
        self.state.send(FaultState { cursor: state.cursor + 1, ..state });
        match action {
            Fault::Pass => self.router.dispatch(method, target, headers, body),
            Fault::Reject(kind) => Result::Err(Error::new(kind, "injected transport rejection")),
            Fault::TruncateBody(length) => if length < 0 {
                Result::Err(Error::new(ErrorKind::Configuration, "negative fault body length"))
            } else {
                let length = if length < body.len() {
                    length
                } else {
                    body.len()
                };
                self.router.dispatch(
                    method,
                    target,
                    headers,
                    Bytes::from_slice_copy(body.slice(0, length)),
                )
            },
            Fault::FailAfter(kind) => {
                self.router.dispatch(method, target, headers, body)?;
                Result::Err(Error::new(kind, "injected transport failure after dispatch"))
            },
        }
    }
}
