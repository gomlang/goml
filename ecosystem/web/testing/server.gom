package testing;

use ecosystem::web;
use web::{Error, ErrorKind, Router, Server};
use std::time::{Duration};

pub struct TestServer {
    server: Server,
    address_value: string,
}

impl TestServer {
    pub fn start(router: Router) -> Result[TestServer, Error] {
        let server = router.serve("127.0.0.1:0")?;
        let address = server.address()?;
        Result::Ok(TestServer { server, address_value: address })
    }

    pub fn address(self: TestServer) -> string {
        self.address_value
    }

    pub fn base_url(self: TestServer) -> string {
        "http://" + self.address_value
    }

    pub fn url(self: TestServer, target: string) -> Result[string, Error] {
        if !target.starts_with("/") || target.starts_with("//") || target.contains("#") {
            return Result::Err(Error::new(ErrorKind::Configuration, "invalid test target"))
        }
        for byte in target.to_bytes() {
            if byte < 32 || byte == 127 || byte == b'\\' {
                return Result::Err(Error::new(ErrorKind::Configuration, "invalid test target"))
            }
        }
        Result::Ok(self.base_url() + target)
    }

    pub fn shutdown(self: TestServer, timeout: Duration) -> Result[(), Error] {
        self.server.shutdown(timeout)
    }

    pub fn is_closed(self: TestServer) -> bool {
        self.server.is_closed()
    }
}
