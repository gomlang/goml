package tests;

use ecosystem::web::{Router, Response};
use ecosystem::web::testing::{TestServer};
use std::testing;
use std::time::{Duration};

#[test]
fn test_server_binds_loopback_and_validates_urls() -> () {
    let server = testing::expect_ok(
        TestServer::start(Router::new().get("/", |_| Result::Ok(Response::text(200, "ok")))),
        "test server",
    );
    testing::assert(server.address().starts_with("127.0.0.1:"));
    testing::assert_eq(
        testing::expect_ok(server.url("/path?q=1"), "URL"),
        server.base_url() + "/path?q=1",
    );
    for target in["relative", "//host", "/fragment#x", "/bad\r\nheader"] {
        testing::assert_err(server.url(target));
    }
    testing::assert(!server.is_closed());
    testing::assert_ok(server.shutdown(Duration::from_seconds(2)));
    testing::assert(server.is_closed());
    testing::assert_ok(server.shutdown(Duration::from_seconds(2)));
}
