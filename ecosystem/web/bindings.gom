package web;

use std::ffi;

#[go_type("example.com/goml-ecosystem/web/adapter", "Request")]
extern type NativeRequest;

#[go_type("example.com/goml-ecosystem/web/adapter", "Response")]
extern type NativeResponse;

#[go_type("example.com/goml-ecosystem/web/adapter", "Writer")]
extern type NativeWriter;

#[go_type("example.com/goml-ecosystem/web/adapter", "Server")]
extern type NativeServer;

#[go_type("example.com/goml-ecosystem/web/adapter", "Capture")]
extern type NativeCapture;

#[go_type("example.com/goml-ecosystem/web/adapter", "Failure")]
extern type NativeFailure;

#[go_ffi("example.com/goml-ecosystem/web/adapter", "FailureCode")]
extern fn raw_failure_code(value: NativeFailure) -> isize;

#[go_ffi("example.com/goml-ecosystem/web/adapter", "FailureMessage")]
extern fn raw_failure_message(value: NativeFailure) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/web/adapter", "NewFailure")]
extern fn raw_failure(code: isize, message: ffi::String) -> NativeFailure;

#[go_ffi("example.com/goml-ecosystem/web/adapter", "Success")]
extern fn raw_success() -> NativeFailure;

#[go_ffi("example.com/goml-ecosystem/web/adapter", "RequestMethod")]
extern fn raw_method(value: NativeRequest) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/web/adapter", "RequestPath")]
extern fn raw_path(value: NativeRequest) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/web/adapter", "RequestQuery")]
extern fn raw_query(value: NativeRequest) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/web/adapter", "RequestRemote")]
extern fn raw_remote(value: NativeRequest) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/web/adapter", "RequestHost")]
extern fn raw_host(value: NativeRequest) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/web/adapter", "RequestNames")]
extern fn raw_request_names(value: NativeRequest) -> ffi::RawSlice[ffi::String];

#[go_ffi("example.com/goml-ecosystem/web/adapter", "RequestValues")]
extern fn raw_request_values(value: NativeRequest) -> ffi::RawSlice[ffi::String];

#[go_ffi("example.com/goml-ecosystem/web/adapter", "Check")]
extern fn raw_check(value: NativeRequest) -> NativeFailure;

#[go_ffi("example.com/goml-ecosystem/web/adapter", "Wait")]
extern fn raw_wait(value: NativeRequest, nanoseconds: i64) -> NativeFailure;

#[go_ffi("example.com/goml-ecosystem/web/adapter", "Read")]
extern fn raw_read(value: NativeRequest, size: isize) -> (ffi::RawSlice[byte], NativeFailure);

#[go_ffi("example.com/goml-ecosystem/web/adapter", "CloseBody")]
extern fn raw_close_body(value: NativeRequest) -> NativeFailure;

#[go_ffi("example.com/goml-ecosystem/web/adapter", "NewResponse")]
extern fn raw_response(
    status: isize,
    names: ffi::RawSlice[ffi::String],
    values: ffi::RawSlice[ffi::String],
    body: ffi::RawSlice[byte],
    stream: ffi::Func[(NativeWriter) -> NativeFailure],
) -> NativeResponse;

#[go_ffi("example.com/goml-ecosystem/web/adapter", "Write")]
extern fn raw_write(value: NativeWriter, body: ffi::RawSlice[byte], flush: bool) -> NativeFailure;

#[go_ffi("example.com/goml-ecosystem/web/adapter", "WriterCheck")]
extern fn raw_writer_check(value: NativeWriter) -> NativeFailure;

#[go_ffi("example.com/goml-ecosystem/web/adapter", "Dispatch")]
extern fn raw_dispatch(
    handler: ffi::Func[(NativeRequest) -> NativeResponse],
    method: ffi::String,
    target: ffi::String,
    names: ffi::RawSlice[ffi::String],
    values: ffi::RawSlice[ffi::String],
    body: ffi::RawSlice[byte],
    timeout: i64,
    body_limit: i64,
    capture_limit: i64,
) -> (NativeCapture, NativeFailure);

#[go_ffi("example.com/goml-ecosystem/web/adapter", "CaptureStatus")]
extern fn raw_capture_status(value: NativeCapture) -> isize;

#[go_ffi("example.com/goml-ecosystem/web/adapter", "CaptureNames")]
extern fn raw_capture_names(value: NativeCapture) -> ffi::RawSlice[ffi::String];

#[go_ffi("example.com/goml-ecosystem/web/adapter", "CaptureValues")]
extern fn raw_capture_values(value: NativeCapture) -> ffi::RawSlice[ffi::String];

#[go_ffi("example.com/goml-ecosystem/web/adapter", "CaptureBody")]
extern fn raw_capture_body(value: NativeCapture) -> ffi::RawSlice[byte];

#[go_ffi("example.com/goml-ecosystem/web/adapter", "Start")]
extern fn raw_start(
    address: ffi::String,
    handler: ffi::Func[(NativeRequest) -> NativeResponse],
    timeout: i64,
    body_limit: i64,
    max_headers: isize,
    max_concurrent: isize,
    header_timeout: i64,
) -> (NativeServer, NativeFailure);

#[go_ffi("example.com/goml-ecosystem/web/adapter", "Address")]
extern fn raw_address(value: NativeServer) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/web/adapter", "Shutdown")]
extern fn raw_shutdown(value: NativeServer, nanoseconds: i64) -> NativeFailure;

#[go_ffi("example.com/goml-ecosystem/web/adapter", "IsClosed")]
extern fn raw_is_closed(value: NativeServer) -> bool;
