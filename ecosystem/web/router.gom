package web;

use std::bytes::{Bytes};
use std::time::{Duration};

pub type Handler = (Request) -> Result[Response, Error];

pub type Middleware = (Request, Next) -> Result[Response, Error];

pub struct Next {
    handler: Handler,
}

impl Next {
    pub fn run(self: Next, request: Request) -> Result[Response, Error] {
        (self.handler)(request)
    }
}

fn middleware_call(layers: Vec[Middleware], index: isize, handler: Handler, request: Request) -> Result[
    Response,
    Error,
] {
    request.check()?;
    if index == layers.len() {
        return handler(request)
    }
    let next = Next { handler: |request| middleware_call(layers, index + 1, handler, request) };
    (layers[index])(request, next)
}

enum Segment {
    Literal(string),
    Parameter(string),
    Wildcard(string),
}

struct Route {
    method: string,
    path: string,
    segments: Vec[Segment],
    shape: string,
    handler: Handler,
}

fn route_segments(path: string) -> Result[(Vec[Segment], string), Error] {
    if !path.starts_with("/") || path.contains("?") || path.contains("#") || path.contains("%") {
        return Result::Err(
            Error::new(ErrorKind::Configuration, "route must be an unescaped absolute path"),
        )
    }
    let parts = path.split("/");
    let segments = Vec::new();
    let names: HashMap[string, bool] = HashMap::new();
    let mut shape = "";
    for i in 1..parts.len() {
        let part = parts[i];
        if part.starts_with("{") && part.ends_with("}") {
            let raw = part.slice_chars(1, part.char_count() - 1).unwrap_or("");
            let wildcard = raw.starts_with("*");
            let name = if wildcard {
                raw.slice_chars(1, raw.char_count()).unwrap_or("")
            } else {
                raw
            };
            if !token(name) || name.contains("*") || names.get(name).is_some() {
                return Result::Err(
                    Error::new(ErrorKind::Configuration, "invalid or repeated route parameter"),
                )
            }
            names.insert(name, true);
            if wildcard {
                if i != parts.len() - 1 {
                    return Result::Err(
                        Error::new(ErrorKind::Configuration, "wildcard must be the final segment"),
                    )
                }
                segments.push(Segment::Wildcard(name));
                shape = shape + "/{*}";
            } else {
                segments.push(Segment::Parameter(name));
                shape = shape + "/{}";
            }
        } else {
            if part.contains("{") || part.contains("}") {
                return Result::Err(
                    Error::new(ErrorKind::Configuration, "malformed route parameter"),
                )
            }
            segments.push(Segment::Literal(part));
            shape = shape + "/" + part;
        }
    }
    Result::Ok((segments, shape))
}

fn match_route(segments: Vec[Segment], parts: Vec[string]) -> Option[(Pairs, string)] {
    let values = Vec::new();
    let mut index = 1;
    let mut rank = "";
    for segment in segments {
        match segment {
            Segment::Wildcard(name) => {
                if index >= parts.len() || index == parts.len() - 1 && parts[index].byte_len() == 0 {
                    return Option::None
                }
                let tail = Vec::new();
                while index < parts.len() {
                    tail.push(parts[index]);
                    index += 1;
                }
                values.push((name, tail.join("/")));
                rank = rank + "1";
            },
            Segment::Literal(expected) => {
                if index >= parts.len() || parts[index] != expected {
                    return Option::None
                }
                rank = rank + "3";
                index += 1;
            },
            Segment::Parameter(name) => {
                if index >= parts.len() || parts[index].byte_len() == 0 {
                    return Option::None
                }
                values.push((name, parts[index]));
                rank = rank + "2";
                index += 1;
            },
        }
    }
    if index != parts.len() {
        Option::None
    } else {
        Option::Some((Pairs { values }, rank))
    }
}

pub struct Limits {
    pub body_bytes: isize,
    pub extraction_bytes: isize,
    pub form_fields: isize,
    pub capture_bytes: isize,
    pub request_timeout: Duration,
    pub header_timeout: Duration,
    pub header_bytes: isize,
    pub concurrent_requests: isize,
}

impl Limits {
    pub fn new() -> Limits {
        Limits {
            body_bytes: 1048576,
            extraction_bytes: 1048576,
            form_fields: 1024,
            capture_bytes: 4194304,
            request_timeout: Duration::from_seconds(30),
            header_timeout: Duration::from_seconds(5),
            header_bytes: 32768,
            concurrent_requests: 256,
        }
    }

    pub fn validate(self: Limits) -> Result[(), Error] {
        if self.body_bytes < 0 || self.extraction_bytes < 0 || self.form_fields < 0
            || self.capture_bytes < 0
            || self.request_timeout.is_zero()
            || self.header_timeout.is_zero()
            || self.header_bytes < 1024
            || self.concurrent_requests < 1 {
            Result::Err(Error::new(ErrorKind::Configuration, "invalid request limits"))
        } else {
            Result::Ok(())
        }
    }
}

pub struct Router {
    routes: Vec[Route],
    layers: Vec[Middleware],
    fallback_value: Handler,
    limits_value: Limits,
    error: Option[Error],
}

impl Router {
    pub fn new() -> Router {
        Router {
            routes: Vec::new(),
            layers: Vec::new(),
            fallback_value: |_| Result::Ok(Response::text(404, "not found")),
            limits_value: Limits::new(),
            error: Option::None,
        }
    }

    fn failed(self: Router, error: Error) -> Router {
        Router {
            error: if self.error.is_some() {
                self.error
            } else {
                Option::Some(error)
            },
            ..self,
        }
    }

    pub fn route(self: Router, method: string, path: string, handler: Handler) -> Router {
        if !token(method) || method != method.to_ascii_uppercase() || method == "CONNECT"
            || method == "TRACE" {
            return self.failed(Error::new(ErrorKind::Configuration, "unsupported route method"))
        }
        let (segments, shape) = match route_segments(path) {
            Ok(value) => value,
            Err(error) => return self.failed(error),
        };
        for route in self.routes {
            if shape == route.shape && (method == route.method || path != route.path) {
                return self.failed(
                    Error::new(ErrorKind::Configuration, "duplicate or conflicting route: " + path),
                )
            }
        }
        let routes = self.routes.copy();
        routes.push(Route { method, path, segments, shape, handler });
        Router { routes, ..self }
    }

    pub fn get(self: Router, path: string, handler: Handler) -> Router {
        self.route("GET", path, handler)
    }

    pub fn post(self: Router, path: string, handler: Handler) -> Router {
        self.route("POST", path, handler)
    }

    pub fn put(self: Router, path: string, handler: Handler) -> Router {
        self.route("PUT", path, handler)
    }

    pub fn delete(self: Router, path: string, handler: Handler) -> Router {
        self.route("DELETE", path, handler)
    }

    pub fn patch(self: Router, path: string, handler: Handler) -> Router {
        self.route("PATCH", path, handler)
    }

    pub fn layer(self: Router, middleware: Middleware) -> Router {
        let layers = self.layers.copy();
        layers.push(middleware);
        Router { layers, ..self }
    }

    pub fn fallback(self: Router, handler: Handler) -> Router {
        Router { fallback_value: handler, ..self }
    }

    pub fn limits(self: Router, limits: Limits) -> Router {
        Router { limits_value: limits, ..self }
    }

    pub fn nest(self: Router, prefix: string, child: Router) -> Router {
        if let Err(error) = child.validate() {
            return self.failed(error)
        }
        if !prefix.starts_with("/") || prefix == "/" || prefix.ends_with("/")
            || prefix.contains("{")
            || prefix.contains("}") {
            return self.failed(
                Error::new(
                    ErrorKind::Configuration,
                    "nest prefix must be a static path without trailing slash",
                ),
            )
        }
        let mut result = self;
        for route in child.routes {
            let handler = route.handler;
            let layers = child.layers;
            result = result.route(
                route.method,
                prefix + route.path,
                |request| middleware_call(layers, 0, handler, request),
            );
        }
        result
    }

    pub fn validate(self: Router) -> Result[(), Error] {
        if let Some(error) = self.error {
            return Result::Err(error)
        }
        self.limits_value.validate()
    }

    fn handle(self: Router, request: Request) -> Result[Response, Error] {
        let parts = Vec::new();
        for part in request.path_value.split("/") {
            parts.push(decode_component(part, false)?)
        }
        let mut best = "";
        let candidates: Vec[(Route, Pairs, string)] = Vec::new();
        for route in self.routes {
            if let Some((params, rank)) = match_route(route.segments, parts) {
                if rank > best {
                    best = rank;
                }
                candidates.push((route, params, rank));
            }
        }
        let allowed = Vec::new();
        let mut selected: Option[(Handler, Pairs)] = Option::None;
        let mut head: Option[(Handler, Pairs)] = Option::None;
        for candidate in candidates {
            if candidate.2 != best {
                continue
            }
            let route = candidate.0;
            if !allowed.contains(route.method) {
                allowed.push(route.method);
            }
            if route.method == "GET" && !allowed.contains("HEAD") {
                allowed.push("HEAD");
            }
            if route.method == request.method_value {
                selected = Option::Some((route.handler, candidate.1));
            }
            if route.method == "GET" && request.method_value == "HEAD" {
                head = Option::Some((route.handler, candidate.1));
            }
        }
        if selected.is_none() {
            selected = head;
        }
        let (handler, params) = match selected {
            Some(value) => value,
            None => if allowed.is_empty() {
                (self.fallback_value, Pairs::new())
            } else {
                if !allowed.contains("OPTIONS") {
                    allowed.push("OPTIONS");
                }
                let allow = allowed.join(", ");
                let status = if request.method_value == "OPTIONS" {
                    204
                } else {
                    405
                };
                (|_| Result::Ok(Response::new(status).header("allow", allow)), Pairs::new())
            },
        };
        middleware_call(self.layers, 0, handler, Request { params_value: params, ..request })
    }

    pub fn dispatch(self: Router, method: string, target: string, headers: Headers, body: Bytes) -> Result[
        CapturedResponse,
        Error,
    ] {
        self.validate()?;
        if !token(method) {
            return Result::Err(Error::new(ErrorKind::Configuration, "invalid HTTP method"))
        }
        dispatch(self, method, target, headers, body)
    }

    pub fn serve(self: Router, address: string) -> Result[Server, Error] {
        self.validate()?;
        start(self, address)
    }
}
