package web;

use std::io;
use std::bytes::{Bytes};
use std::ffi;

fn io_error(error: Error, operation: string) -> io::Error {
    let kind = match error.kind {
        ErrorKind::Configuration => io::ErrorKind::InvalidInput,
        ErrorKind::BadRequest => io::ErrorKind::InvalidData,
        ErrorKind::BodyLimit => io::ErrorKind::InvalidData,
        ErrorKind::Timeout => io::ErrorKind::TimedOut,
        ErrorKind::Closed => io::ErrorKind::BrokenPipe,
        _ => io::ErrorKind::Other,
    };
    io::Error::new(kind, operation, Option::None, Option::None, error.message)
}

impl io::Read for Body {
    fn read(self: Body, buffer: MutSlice[byte]) -> Result[isize, io::Error] {
        if buffer.len() == 0 {
            return Result::Ok(0)
        }
        let count = if buffer.len() > 65536 {
            65536
        } else {
            buffer.len()
        };
        let chunk = Body::read(self, count).map_err(|error| io_error(error, "read HTTP request"))?;
        for i in 0..chunk.len() {
            buffer[i] = chunk.as_slice()[i];
        }
        Result::Ok(chunk.len())
    }
}

impl io::Close for Body {
    fn close(self: Body) -> Result[(), io::Error] {
        Body::close(self).map_err(|error| io_error(error, "close HTTP request"))
    }
}

impl io::Write for StreamWriter {
    fn write(self: StreamWriter, buffer: Slice[byte]) -> Result[isize, io::Error] {
        let count = if buffer.len() > 65536 {
            65536
        } else {
            buffer.len()
        };
        let data = Vec::with_capacity(count);
        for i in 0..count {
            data.push(buffer[i])
        }
        check(raw_write(self.native, ffi::slice_from_vec_copy(data), false)).map_err(
            |error| io_error(error, "write HTTP response"),
        )?;
        Result::Ok(count)
    }

    fn flush(self: StreamWriter) -> Result[(), io::Error] {
        check(raw_write(self.native, ffi::slice_from_vec_copy(Vec::new()), true)).map_err(
            |error| io_error(error, "flush HTTP response"),
        )
    }
}
