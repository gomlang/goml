package lzw;

#[derive(Debug, PartialEq, Eq)]
pub enum BitOrder {
    Lsb,
    Msb,
}

fn validate_width(literal_width: isize) -> Result[(), ecosystem::compress::Error] {
    if literal_width < 2 || literal_width > 8 {
        Result::Err(
            ecosystem::compress::Error::new(
                ecosystem::compress::ErrorKind::Invalid,
                0,
                "LZW literal width must be between 2 and 8",
            ),
        )
    } else {
        Result::Ok(())
    }
}
