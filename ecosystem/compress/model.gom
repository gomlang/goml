package compress;

use std::io;

#[derive(Debug, PartialEq, Eq)]
pub enum ErrorKind {
    Invalid,
    Truncated,
    Checksum,
    Dictionary,
    Limit,
    Io,
    State,
}

pub struct Error {
    pub kind: ErrorKind,
    pub offset: isize,
    pub message: string,
    pub cause: Option[io::Error],
}

impl Error {
    pub fn new(kind: ErrorKind, offset: isize, message: string) -> Error {
        Error { kind, offset, message, cause: Option::None }
    }

    pub fn to_io(self: Error) -> io::Error {
        match self.cause {
            Some(cause) => cause,
            None => io::Error::new(
                if self.kind == ErrorKind::Truncated {
                    io::ErrorKind::UnexpectedEof
                } else {
                    io::ErrorKind::InvalidData
                },
                "compression",
                Option::None,
                Option::None,
                self.to_string(),
            ),
        }
    }
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        "compression at " + self.offset.to_string() + ": " + self.message
    }
}

impl Debug for Error {
    fn debug(self: Error) -> string {
        self.to_string()
    }
}

pub struct Limits {
    pub max_input_bytes: isize,
    pub max_output_bytes: isize,
    pub max_blocks: isize,
    pub max_work: isize,
}

impl Limits {
    pub fn validate(self: Limits) -> Result[(), Error] {
        if self.max_input_bytes < 0 || self.max_output_bytes < 0 || self.max_blocks < 0
            || self.max_work < 0 {
            Result::Err(Error::new(ErrorKind::Limit, 0, "compression limits must be nonnegative"))
        } else {
            Result::Ok(())
        }
    }
}
