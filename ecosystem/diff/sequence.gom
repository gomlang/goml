package diff;

#[derive(Debug, PartialEq)]
pub enum Tag {
    Equal,
    Delete,
    Insert,
}

#[derive(Debug, PartialEq)]
pub struct Op {
    pub tag: Tag,
    pub old_start: isize,
    pub old_end: isize,
    pub new_start: isize,
    pub new_end: isize,
}

pub struct Options {
    pub max_work: isize,
    pub max_trace: isize,
}

impl Options {
    pub fn new() -> Options {
        Options { max_work: 10000000, max_trace: 1000000 }
    }
}

fn diagonal(row: Vec[isize], k: isize) -> isize {
    row[k + (row.len() - 1) / 2]
}

fn backtrack(trace: Vec[Vec[isize]], old_len: isize, new_len: isize) -> Vec[Tag] {
    let result: Vec[Tag] = Vec::new();
    let mut x = old_len;
    let mut y = new_len;
    let mut d = trace.len() - 1;
    while d > 0 {
        let k = x - y;
        let previous = trace[d - 1];
        let previous_k: isize = if k == -d
            || (k != d && diagonal(previous, k - 1) < diagonal(previous, k + 1)) {
            k + 1
        } else {
            k - 1
        };
        let previous_x = diagonal(previous, previous_k);
        let previous_y = previous_x - previous_k;
        while x > previous_x && y > previous_y {
            result.push(Tag::Equal);
            x -= 1;
            y -= 1;
        }
        if x == previous_x {
            result.push(Tag::Insert);
            y -= 1;
        } else {
            result.push(Tag::Delete);
            x -= 1;
        }
        d -= 1;
    }
    while x > 0 && y > 0 {
        result.push(Tag::Equal);
        x -= 1;
        y -= 1;
    }
    while x > 0 {
        result.push(Tag::Delete);
        x -= 1;
    }
    while y > 0 {
        result.push(Tag::Insert);
        y -= 1;
    }
    result.reverse();
    result
}

fn compact(steps: Vec[Tag]) -> Vec[Op] {
    let result: Vec[Op] = Vec::new();
    let mut old_pos = 0;
    let mut new_pos = 0;
    for tag in steps {
        let old_start = old_pos;
        let new_start = new_pos;
        if tag != Tag::Insert {
            old_pos += 1;
        }
        if tag != Tag::Delete {
            new_pos += 1;
        }
        if let Some(previous) = result.last() {
            if previous.tag == tag {
                result[result.len() - 1] = Op {
                    tag,
                    old_start: previous.old_start,
                    old_end: old_pos,
                    new_start: previous.new_start,
                    new_end: new_pos,
                };
                continue;
            }
        }
        result.push(Op { tag, old_start, old_end: old_pos, new_start, new_end: new_pos });
    }
    result
}

pub fn sequence_by[T](old: Slice[T], new: Slice[T], equal: (T, T) -> bool, options: Options) -> Result[
    Vec[Op],
    string,
] {
    if options.max_work < 1 || options.max_trace < 1 {
        return Result::Err("diff budgets must be positive")
    }
    if old.len() == 0 && new.len() == 0 {
        return Result::Ok(Vec::new())
    }
    if old.len() == 0 {
        return Result::Ok(
            Vec::from_array(
                [
                    Op {
                        tag: Tag::Insert,
                        old_start: 0,
                        old_end: 0,
                        new_start: 0,
                        new_end: new.len(),
                    },
                ],
            ),
        )
    }
    if new.len() == 0 {
        return Result::Ok(
            Vec::from_array(
                [
                    Op {
                        tag: Tag::Delete,
                        old_start: 0,
                        old_end: old.len(),
                        new_start: 0,
                        new_end: 0,
                    },
                ],
            ),
        )
    }
    let trace: Vec[Vec[isize]] = Vec::new();
    let mut work = 0;
    let mut cells = 0;
    let mut d = 0;
    loop {
        let width = 2 * d + 1;
        if width > options.max_trace - cells {
            return Result::Err("diff trace budget exceeded")
        }
        cells += width;
        let row: Vec[isize] = Vec::with_capacity(width);
        for _ in 0..width {
            row.push(0);
        }
        let mut k = -d;
        while k <= d {
            work += 1;
            if work > options.max_work {
                return Result::Err("diff work budget exceeded")
            }
            let mut x: isize = if d == 0 {
                0
            } else {
                let previous = trace[d - 1];
                if k == -d || (k != d && diagonal(previous, k - 1) < diagonal(previous, k + 1)) {
                    diagonal(previous, k + 1)
                } else {
                    diagonal(previous, k - 1) + 1
                }
            };
            let mut y = x - k;
            while x < old.len() && y < new.len() && equal(old[x], new[y]) {
                x += 1;
                y += 1;
                work += 1;
                if work > options.max_work {
                    return Result::Err("diff work budget exceeded")
                }
            }
            row[k + d] = x;
            if x >= old.len() && y >= new.len() {
                trace.push(row);
                return Result::Ok(compact(backtrack(trace, old.len(), new.len())))
            }
            k += 2;
        }
        trace.push(row);
        d += 1;
    }
}

pub fn sequence[T: PartialEq](old: Slice[T], new: Slice[T]) -> Result[Vec[Op], string] {
    sequence_by(old, new, |left, right| left == right, Options::new())
}

pub fn distance(operations: Vec[Op]) -> isize {
    let mut result = 0;
    for operation in operations {
        if operation.tag == Tag::Delete {
            result += operation.old_end - operation.old_start;
        }
        if operation.tag == Tag::Insert {
            result += operation.new_end - operation.new_start;
        }
    }
    result
}

pub fn invert(operations: Vec[Op]) -> Vec[Op] {
    let result: Vec[Op] = Vec::new();
    for operation in operations {
        let tag = match operation.tag {
            Equal => Tag::Equal,
            Insert => Tag::Delete,
            Delete => Tag::Insert,
        };
        result.push(
            Op {
                tag,
                old_start: operation.new_start,
                old_end: operation.new_end,
                new_start: operation.old_start,
                new_end: operation.old_end,
            },
        );
    }
    result
}
