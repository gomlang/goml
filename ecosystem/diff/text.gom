package diff;

pub fn lines(text: string) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    let mut start = 0;
    for index in 0..text.byte_len() {
        if text.byte_get(index) == b'\n' {
            result.push(text.byte_slice(start, index + 1));
            start = index + 1;
        }
    }
    if start < text.byte_len() {
        result.push(text.byte_slice(start, text.byte_len()));
    }
    result
}

pub fn line_diff(old: string, new: string) -> Result[Vec[Op], string] {
    sequence(lines(old).as_slice(), lines(new).as_slice())
}

pub fn character_diff(old: string, new: string) -> Result[Vec[Op], string] {
    let left: Vec[char] = Vec::new();
    let right: Vec[char] = Vec::new();
    for character in old.chars() {
        left.push(character);
    }
    for character in new.chars() {
        right.push(character);
    }
    sequence(left.as_slice(), right.as_slice())
}

pub struct Statistics {
    pub equal: isize,
    pub inserted: isize,
    pub deleted: isize,
}

pub fn statistics(operations: Vec[Op]) -> Statistics {
    let mut same = 0;
    let mut inserted = 0;
    let mut deleted = 0;
    for operation in operations {
        match operation.tag {
            Equal => {
                same += operation.old_end - operation.old_start;
            },
            Insert => {
                inserted += operation.new_end - operation.new_start;
            },
            Delete => {
                deleted += operation.old_end - operation.old_start;
            },
        }
    }
    Statistics { equal: same, inserted, deleted }
}
