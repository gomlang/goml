package diff;

use std::num;

#[derive(PartialEq)]
pub struct PatchLine {
    pub tag: Tag,
    pub text: string,
}

#[derive(PartialEq)]
pub struct Hunk {
    pub old_start: isize,
    pub old_count: isize,
    pub new_start: isize,
    pub new_count: isize,
    pub lines: Vec[PatchLine],
}

#[derive(PartialEq)]
pub struct Patch {
    pub old_name: string,
    pub new_name: string,
    pub hunks: Vec[Hunk],
}

fn validate_name(name: string) -> Result[(), string] {
    if name.contains("\n") || name.contains("\r") || name.contains("\t") {
        Result::Err("patch names cannot contain tabs or newlines")
    } else {
        Result::Ok(())
    }
}

pub fn patch(old: string, new: string, old_name: string, new_name: string, context: isize) -> Result[
    Patch,
    string,
] {
    patch_with(old, new, old_name, new_name, context, Options::new(), Algorithm::Myers)
}

pub fn patch_with(
    old: string,
    new: string,
    old_name: string,
    new_name: string,
    context: isize,
    options: Options,
    algorithm: Algorithm,
) -> Result[Patch, string] {
    if context < 0 || context > 1000000 {
        return Result::Err("patch context must be between 0 and 1000000")
    }
    validate_name(old_name)?;
    validate_name(new_name)?;
    let old_lines = lines(old);
    let new_lines = lines(new);
    let operations = sequence_with(
        old_lines.as_slice(),
        new_lines.as_slice(),
        |left, right| left == right,
        options,
        algorithm,
    )?;
    let entries: Vec[PatchLine] = Vec::new();
    for operation in operations {
        if operation.tag == Tag::Insert {
            for index in operation.new_start..operation.new_end {
                entries.push(PatchLine { tag: Tag::Insert, text: new_lines[index] });
            }
        } else {
            for index in operation.old_start..operation.old_end {
                entries.push(PatchLine { tag: operation.tag, text: old_lines[index] });
            }
        }
    }
    let positions: Vec[(isize, isize)] = Vec::new();
    let mut old_position = 0;
    let mut new_position = 0;
    for entry in entries {
        positions.push((old_position, new_position));
        if entry.tag != Tag::Insert {
            old_position += 1;
        }
        if entry.tag != Tag::Delete {
            new_position += 1;
        }
    }
    positions.push((old_position, new_position));
    let ranges: Vec[(isize, isize)] = Vec::new();
    for index in 0..entries.len() {
        if entries[index].tag == Tag::Equal {
            continue;
        }
        let start = if index > context {
            index - context
        } else {
            0
        };
        let end = if context < entries.len() - index - 1 {
            index + context + 1
        } else {
            entries.len()
        };
        match ranges.last() {
            Some(previous) => if start <= previous.1 {
                ranges[ranges.len() - 1] = (previous.0, end);
            } else {
                ranges.push((start, end));
            },
            None => ranges.push((start, end)),
        }
    }
    let hunks: Vec[Hunk] = Vec::new();
    for range in ranges {
        let start = positions[range.0];
        let end = positions[range.1];
        hunks.push(
            Hunk {
                old_start: start.0,
                new_start: start.1,
                old_count: end.0 - start.0,
                new_count: end.1 - start.1,
                lines: entries.slice(range.0, range.1).to_vec(),
            },
        );
    }
    Result::Ok(Patch { old_name, new_name, hunks })
}

fn range_text(start: isize, count: isize) -> string {
    let line = if count == 0 {
        start
    } else {
        start + 1
    };
    f"{line},{count}"
}

fn validate_hunk(hunk: Hunk) -> Result[(), string] {
    if hunk.old_start < 0 || hunk.new_start < 0 || hunk.old_count < 0 || hunk.new_count < 0 {
        return Result::Err("negative patch range")
    }
    if hunk.old_count > 9223372036854775807 - hunk.old_start
        || hunk.new_count > 9223372036854775807 - hunk.new_start {
        return Result::Err("patch range overflows machine integer")
    }
    let mut old_count = 0;
    let mut new_count = 0;
    let mut old_closed = false;
    let mut new_closed = false;
    for line in hunk.lines {
        if line.text == "" {
            return Result::Err("patch line must contain text or a newline")
        }
        let embedded = match line.text.find("\n") {
            Some(index) => index != line.text.byte_len() - 1,
            None => false,
        };
        if embedded {
            return Result::Err("patch entry contains multiple lines")
        }
        if line.tag != Tag::Insert {
            if old_closed {
                return Result::Err("old content continues after a missing newline")
            }
            old_count += 1;
            old_closed = !line.text.ends_with("\n");
        }
        if line.tag != Tag::Delete {
            if new_closed {
                return Result::Err("new content continues after a missing newline")
            }
            new_count += 1;
            new_closed = !line.text.ends_with("\n");
        }
    }
    if old_count != hunk.old_count || new_count != hunk.new_count {
        return Result::Err("patch hunk counts do not match its lines")
    }
    Result::Ok(())
}

fn validate_layout(hunks: Vec[Hunk]) -> Result[(), string] {
    let mut old_end = 0;
    let mut new_end = 0;
    for hunk in hunks {
        validate_hunk(hunk)?;
        if hunk.old_start < old_end || hunk.new_start < new_end {
            return Result::Err("patch hunks overlap or are out of order")
        }
        if hunk.old_start - old_end != hunk.new_start - new_end {
            return Result::Err("unchanged gap differs between old and new ranges")
        }
        old_end = hunk.old_start + hunk.old_count;
        new_end = hunk.new_start + hunk.new_count;
    }
    Result::Ok(())
}

impl Patch {
    pub fn to_unified(self: Patch) -> Result[string, string] {
        validate_name(self.old_name)?;
        validate_name(self.new_name)?;
        validate_layout(self.hunks)?;
        if self.hunks.is_empty() {
            return Result::Ok("")
        }
        let output = Vec::from_array(["--- " + self.old_name + "\n", "+++ " + self.new_name + "\n"]);
        for hunk in self.hunks {
            validate_hunk(hunk)?;
            output.push(
                "@@ -" + range_text(hunk.old_start, hunk.old_count) + " +"
                    + range_text(hunk.new_start, hunk.new_count)
                    + " @@\n",
            );
            for line in hunk.lines {
                let marker = match line.tag {
                    Equal => " ",
                    Delete => "-",
                    Insert => "+",
                };
                output.push(marker + line.text);
                if !line.text.ends_with("\n") {
                    output.push("\n\\ No newline at end of file\n");
                }
            }
        }
        Result::Ok(output.join(""))
    }

    pub fn apply(self: Patch, old: string) -> Result[string, string] {
        validate_layout(self.hunks)?;
        let source = lines(old);
        let result: Vec[string] = Vec::new();
        let mut cursor = 0;
        for hunk in self.hunks {
            validate_hunk(hunk)?;
            if hunk.old_start < cursor || hunk.old_start > source.len() {
                return Result::Err("patch hunk is out of order or outside the source")
            }
            while cursor < hunk.old_start {
                result.push(source[cursor]);
                cursor += 1;
            }
            if result.len() != hunk.new_start {
                return Result::Err("patch new position does not match prior hunks")
            }
            for line in hunk.lines {
                if line.tag != Tag::Insert {
                    if cursor >= source.len() || source[cursor] != line.text {
                        return Result::Err(f"patch conflict at source line {cursor + 1}")
                    }
                    cursor += 1;
                }
                if line.tag != Tag::Delete {
                    result.push(line.text);
                }
            }
        }
        while cursor < source.len() {
            result.push(source[cursor]);
            cursor += 1;
        }
        for index in 0..result.len() {
            if index < result.len() - 1 && !result[index].ends_with("\n") {
                return Result::Err("patch appends content after a missing newline")
            }
        }
        Result::Ok(result.join(""))
    }

    pub fn reverse(self: Patch) -> Patch {
        let hunks: Vec[Hunk] = Vec::new();
        for hunk in self.hunks {
            let entries: Vec[PatchLine] = Vec::new();
            for line in hunk.lines {
                let tag = match line.tag {
                    Equal => Tag::Equal,
                    Insert => Tag::Delete,
                    Delete => Tag::Insert,
                };
                entries.push(PatchLine { tag, text: line.text });
            }
            hunks.push(
                Hunk {
                    old_start: hunk.new_start,
                    old_count: hunk.new_count,
                    new_start: hunk.old_start,
                    new_count: hunk.old_count,
                    lines: entries,
                },
            );
        }
        Patch { old_name: self.new_name, new_name: self.old_name, hunks }
    }
}

fn parse_range(value: string) -> Result[(isize, isize), string] {
    let parts = value.split(",");
    if parts.len() < 1 || parts.len() > 2 {
        return Result::Err("invalid unified range")
    }
    for part in parts {
        if part == "" {
            return Result::Err("empty unified range")
        }
        for index in 0..part.byte_len() {
            let value = part.byte_get(index);
            if value < b'0' || value > b'9' {
                return Result::Err("unified ranges require decimal digits")
            }
        }
    }
    let start = num::parse_int_structured(parts[0]).map_err(|_| "invalid unified range start")?;
    let count = if parts.len() == 1 {
        1
    } else {
        num::parse_int_structured(parts[1]).map_err(|_| "invalid unified range count")?
    };
    if start < 0 || count < 0 || (count > 0 && start == 0) {
        return Result::Err("invalid unified range bounds")
    }
    Result::Ok(
        (
            if count == 0 {
                start
            } else {
                start - 1
            },
            count,
        ),
    )
}

fn header(value: string) -> Result[(isize, isize, isize, isize), string] {
    if !value.starts_with("@@ -") {
        return Result::Err("expected unified hunk header")
    }
    let body = value.byte_slice(4, value.byte_len());
    let (old, rest) = body.split_once(" +").ok_or("invalid unified hunk header")?;
    let (new, _) = rest.split_once(" @@").ok_or("invalid unified hunk header")?;
    let left = parse_range(old)?;
    let right = parse_range(new)?;
    Result::Ok((left.0, left.1, right.0, right.1))
}

fn filename(header: string, prefix: string) -> Result[string, string] {
    if !header.starts_with(prefix) || !header.ends_with("\n") {
        return Result::Err("expected unified file header")
    }
    let value = header.byte_slice(prefix.byte_len(), header.byte_len() - 1);
    let name = match value.split_once("\t") {
        Some((name, _)) => name,
        None => value,
    };
    validate_name(name)?;
    Result::Ok(name)
}

pub fn parse_unified(text: string) -> Result[Patch, string] {
    if text == "" {
        return Result::Ok(Patch { old_name: "", new_name: "", hunks: Vec::new() })
    }
    let input = lines(text);
    if input.len() < 2 {
        return Result::Err("unified patch requires two file headers")
    }
    let old_name = filename(input[0], "--- ")?;
    let new_name = filename(input[1], "+++ ")?;
    let hunks: Vec[Hunk] = Vec::new();
    let mut index = 2;
    while index < input.len() {
        let (old_start, old_count, new_start, new_count) = header(input[index])?;
        index += 1;
        let entries: Vec[PatchLine] = Vec::new();
        let mut old_seen = 0;
        let mut new_seen = 0;
        while index < input.len() && (old_seen < old_count || new_seen < new_count) {
            let line = input[index];
            if !line.ends_with("\n") || line.byte_len() < 2 {
                return Result::Err("unterminated patch line")
            }
            let tag = match line.byte_get(0) {
                b' ' => Tag::Equal,
                b'-' => Tag::Delete,
                b'+' => Tag::Insert,
                _ => return Result::Err("invalid patch line marker"),
            };
            let mut content = line.byte_slice(1, line.byte_len());
            index += 1;
            if index < input.len() && input[index] == "\\ No newline at end of file\n" {
                content = content.byte_slice(0, content.byte_len() - 1);
                index += 1;
            }
            if tag != Tag::Insert {
                old_seen += 1;
            }
            if tag != Tag::Delete {
                new_seen += 1;
            }
            entries.push(PatchLine { tag, text: content });
        }
        let hunk = Hunk { old_start, old_count, new_start, new_count, lines: entries };
        validate_hunk(hunk)?;
        hunks.push(hunk);
    }
    if hunks.is_empty() {
        return Result::Err("unified headers must be followed by a hunk")
    }
    validate_layout(hunks)?;
    Result::Ok(Patch { old_name, new_name, hunks })
}
