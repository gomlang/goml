package diff;

struct Segment {
    old_start: isize,
    old_end: isize,
    new_start: isize,
    new_end: isize,
    equal: bool,
}

fn spend(work: Ref[isize], amount: isize) -> Result[(), string] {
    if amount > work.get() {
        return Result::Err("diff work budget exceeded")
    }
    work.set(work.get() - amount);
    Result::Ok(())
}

fn append_operation(operations: Vec[Op], tag: Tag, x: isize, end_x: isize, y: isize, end_y: isize) -> () {
    if x == end_x && y == end_y {
        return
    }
    if let Some(previous) = operations.last() {
        if previous.tag == tag && previous.old_end == x && previous.new_end == y {
            operations[operations.len() - 1] = Op { old_end: end_x, new_end: end_y, ..previous };
            return
        }
    }
    operations.push(Op { tag, old_start: x, old_end: end_x, new_start: y, new_end: end_y });
}

fn lcs_row[T](
    old: Slice[T],
    new: Slice[T],
    reverse: bool,
    equal: (T, T) -> bool,
    row: Vec[isize],
    work: Ref[isize],
) -> Result[(), string] {
    spend(work, new.len() + 1)?;
    for index in 0..new.len() + 1 {
        row[index] = 0;
    }
    for index in 0..old.len() {
        let x = if reverse {
            old.len() - 1 - index
        } else {
            index
        };
        let mut diagonal = 0;
        for column in 1..new.len() + 1 {
            spend(work, 1)?;
            let y = if reverse {
                new.len() - column
            } else {
                column - 1
            };
            let above = row[column];
            row[column] = if equal(old[x], new[y]) {
                diagonal + 1
            } else if above > row[column - 1] {
                above
            } else {
                row[column - 1]
            };
            diagonal = above;
        }
    }
    Result::Ok(())
}

fn hirschberg[T](old: Slice[T], new: Slice[T], equal: (T, T) -> bool, options: Options) -> Result[
    Vec[Op],
    string,
] {
    let work = Ref::new(options.max_work);
    let pending = Vec::from_array(
        [
            Segment {
                old_start: 0,
                old_end: old.len(),
                new_start: 0,
                new_end: new.len(),
                equal: false,
            },
        ],
    );
    let operations: Vec[Op] = Vec::new();
    let forward: Vec[isize] = Vec::new();
    let backward: Vec[isize] = Vec::new();
    while let Some(segment) = pending.pop() {
        spend(work, 1)?;
        let mut x = segment.old_start;
        let mut y = segment.new_start;
        let mut end_x = segment.old_end;
        let mut end_y = segment.new_end;
        if segment.equal {
            append_operation(operations, Tag::Equal, x, end_x, y, end_y);
            continue;
        }
        while x < end_x && y < end_y {
            spend(work, 1)?;
            if !equal(old[x], new[y]) {
                break;
            }
            x += 1;
            y += 1;
        }
        append_operation(operations, Tag::Equal, segment.old_start, x, segment.new_start, y);
        while x < end_x && y < end_y {
            spend(work, 1)?;
            if !equal(old[end_x - 1], new[end_y - 1]) {
                break;
            }
            end_x -= 1;
            end_y -= 1;
        }
        if end_x < segment.old_end {
            pending.push(
                Segment {
                    old_start: end_x,
                    old_end: segment.old_end,
                    new_start: end_y,
                    new_end: segment.new_end,
                    equal: true,
                },
            );
        }
        if x == end_x || y == end_y {
            append_operation(operations, Tag::Delete, x, end_x, y, y);
            append_operation(operations, Tag::Insert, end_x, end_x, y, end_y);
            continue;
        }
        if end_x - x == 1 || end_y - y == 1 {
            let mut matched: Option[(isize, isize)] = Option::None;
            if end_x - x == 1 {
                for candidate in y..end_y {
                    spend(work, 1)?;
                    if equal(old[x], new[candidate]) {
                        matched = Option::Some((x, candidate));
                        break;
                    }
                }
            } else {
                for candidate in x..end_x {
                    spend(work, 1)?;
                    if equal(old[candidate], new[y]) {
                        matched = Option::Some((candidate, y));
                        break;
                    }
                }
            }
            if let Some((match_x, match_y)) = matched {
                append_operation(operations, Tag::Delete, x, match_x, y, y);
                append_operation(operations, Tag::Insert, match_x, match_x, y, match_y);
                append_operation(operations, Tag::Equal, match_x, match_x + 1, match_y, match_y + 1);
                x = match_x + 1;
                y = match_y + 1;
            }
            append_operation(operations, Tag::Delete, x, end_x, y, y);
            append_operation(operations, Tag::Insert, end_x, end_x, y, end_y);
            continue;
        }
        let width = end_y - y + 1;
        if width > options.max_trace / 2 {
            return Result::Err("diff linear workspace budget exceeded")
        }
        while forward.len() < width {
            forward.push(0);
            backward.push(0);
        }
        let middle = x + (end_x - x) / 2;
        lcs_row(old.sub(x, middle), new.sub(y, end_y), false, equal, forward, work)?;
        lcs_row(old.sub(middle, end_x), new.sub(y, end_y), true, equal, backward, work)?;
        spend(work, width)?;
        let mut split = 0;
        let mut best = -1;
        for column in 0..width {
            let score = forward[column] + backward[width - 1 - column];
            if score > best {
                best = score;
                split = column;
            }
        }
        pending.push(
            Segment {
                old_start: middle,
                old_end: end_x,
                new_start: y + split,
                new_end: end_y,
                equal: false,
            },
        );
        pending.push(
            Segment {
                old_start: x,
                old_end: middle,
                new_start: y,
                new_end: y + split,
                equal: false,
            },
        );
    }
    Result::Ok(operations)
}

pub fn sequence_linear_by[T](old: Slice[T], new: Slice[T], equal: (T, T) -> bool, options: Options) -> Result[
    Vec[Op],
    string,
] {
    if options.max_work < 1 || options.max_trace < 1 {
        return Result::Err("diff budgets must be positive")
    }
    if old.len() < new.len() {
        hirschberg(new, old, |right, left| equal(left, right), options).map(invert)
    } else {
        hirschberg(old, new, equal, options)
    }
}

pub fn sequence_linear[T: PartialEq](old: Slice[T], new: Slice[T]) -> Result[Vec[Op], string] {
    sequence_linear_by(old, new, |left, right| left == right, Options::new())
}

#[derive(Debug, PartialEq)]
pub enum Algorithm {
    Myers,
    Hirschberg,
}

pub fn sequence_with[T](
    old: Slice[T],
    new: Slice[T],
    equal: (T, T) -> bool,
    options: Options,
    algorithm: Algorithm,
) -> Result[Vec[Op], string] {
    match algorithm {
        Myers => sequence_by(old, new, equal, options),
        Hirschberg => sequence_linear_by(old, new, equal, options),
    }
}
