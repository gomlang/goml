package tests;

use ecosystem::diff;
use std::testing;

fn validate(old: Vec[isize], new: Vec[isize], operations: Vec[diff::Op]) -> () {
    let mut x = 0;
    let mut y = 0;
    let output: Vec[isize] = Vec::new();
    for op in operations {
        testing::assert_eq(op.old_start, x);
        testing::assert_eq(op.new_start, y);
        testing::assert(op.old_end >= x && op.old_end <= old.len());
        testing::assert(op.new_end >= y && op.new_end <= new.len());
        match op.tag {
            Equal => {
                testing::assert_eq(op.old_end - x, op.new_end - y);
                for i in 0..op.old_end - x {
                    testing::assert_eq(old[x + i], new[y + i]);
                    output.push(old[x + i]);
                }
            },
            Delete => testing::assert_eq(op.new_end, y),
            Insert => {
                testing::assert_eq(op.old_end, x);
                for i in y..op.new_end {
                    output.push(new[i]);
                }
            },
        }
        x = op.old_end;
        y = op.new_end;
    }
    testing::assert_eq(x, old.len());
    testing::assert_eq(y, new.len());
    testing::assert(output == new);
}

fn oracle_distance(old: Vec[isize], new: Vec[isize]) -> isize {
    let rows: Vec[Vec[isize]] = Vec::new();
    for x in 0..old.len() + 1 {
        let row: Vec[isize] = Vec::new();
        for y in 0..new.len() + 1 {
            if x == 0 {
                row.push(y);
            } else if y == 0 {
                row.push(x);
            } else if old[x - 1] == new[y - 1] {
                row.push(rows[x - 1][y - 1]);
            } else {
                let a = rows[x - 1][y] + 1;
                let b = row[y - 1] + 1;
                row.push(
                    if a < b {
                        a
                    } else {
                        b
                    },
                );
            }
        }
        rows.push(row);
    }
    rows[old.len()][new.len()]
}

fn binary_sequence(value: isize, length: isize) -> Vec[isize] {
    let result: Vec[isize] = Vec::new();
    for index in 0..length {
        result.push((value >> index) & 1);
    }
    result
}

#[test]
fn exhaustive_minimal_edits_and_inverse() -> () {
    for old_length in 0..6 {
        for new_length in 0..6 {
            for old_bits in 0..(1 << old_length) {
                for new_bits in 0..(1 << new_length) {
                    let old = binary_sequence(old_bits, old_length);
                    let new = binary_sequence(new_bits, new_length);
                    let operations = testing::expect_ok(
                        diff::sequence(old.as_slice(), new.as_slice()),
                        "diff",
                    );
                    validate(old, new, operations);
                    validate(new, old, diff::invert(operations));
                    testing::assert_eq(diff::distance(operations), oracle_distance(old, new));
                }
            }
        }
    }
}

#[test]
fn custom_comparison_unicode_and_budgets() -> () {
    let old = Vec::from_array(["A", "B"]);
    let new = Vec::from_array(["a", "b"]);
    let operations = testing::expect_ok(
        diff::sequence_by(
            old.as_slice(),
            new.as_slice(),
            |a, b| a.eq_ignore_ascii_case(b),
            diff::Options::new(),
        ),
        "case insensitive",
    );
    testing::assert_eq(diff::distance(operations), 0);
    testing::assert_err(
        diff::sequence_by(
            old.as_slice(),
            new.as_slice(),
            |a, b| a == b,
            diff::Options { max_work: 1, max_trace: 1 },
        ),
    );
    testing::assert_eq(
        diff::distance(testing::expect_ok(diff::character_diff("你好世界", "你好朋友"), "unicode")),
        4,
    );
    testing::assert(diff::lines("a\r\nb\nlast") == Vec::from_array(["a\r\n", "b\n", "last"]));
    let stats = diff::statistics(
        testing::expect_ok(diff::line_diff("a\nb\n", "a\nc\nd\n"), "lines"),
    );
    testing::assert_eq(stats.equal, 1);
    testing::assert_eq(stats.inserted, 2);
    testing::assert_eq(stats.deleted, 1);
}

#[test]
fn patch_roundtrip_context_and_newlines() -> () {
    let texts = Vec::from_array(
        [
            "",
            "a",
            "a\n",
            "a\r\n",
            "one\ntwo\nthree\n",
            "你好\n世界",
            "\n",
            "a\nb\nc\nd\ne\nf\ng\nh\ni\nj\n",
        ],
    );
    for old in texts {
        for new in texts {
            for context in 0..4 {
                let patch = testing::expect_ok(
                    diff::patch(old, new, "old", "new", context),
                    "patch",
                );
                testing::assert_eq(testing::expect_ok(patch.apply(old), "apply"), new);
                testing::assert_eq(testing::expect_ok(patch.reverse().apply(new), "reverse"), old);
                let encoded = testing::expect_ok(patch.to_unified(), "encode");
                let decoded = testing::expect_ok(diff::parse_unified(encoded), "parse");
                testing::assert_eq(testing::expect_ok(decoded.apply(old), "parsed apply"), new);
            }
        }
    }
}

#[test]
fn unified_format_and_conflicts() -> () {
    let patch = testing::expect_ok(diff::patch("a\nb\n", "a\nc\n", "a/file", "b/file", 3), "patch");
    testing::assert_eq(
        testing::expect_ok(patch.to_unified(), "render"),
        "--- a/file\n+++ b/file\n@@ -1,2 +1,2 @@\n a\n-b\n+c\n",
    );
    testing::assert_err(patch.apply("a\nx\n"));
    testing::assert_err(diff::parse_unified("--- a\n+++ b\n@@ -1,2 +1,2 @@\n-a\n+b\n"));
    testing::assert_err(diff::parse_unified("--- a\n+++ b\n@@ -0 +0 @@\n-a\n+b\n"));
    testing::assert_err(diff::patch("", "a", "bad\nname", "b", 0));
    let compact = testing::expect_ok(
        diff::parse_unified("--- a\told time\n+++ b\tnew time\n@@ -1 +1 @@ section\n-a\n+b\n"),
        "short counts",
    );
    testing::assert_eq(testing::expect_ok(compact.apply("a\n"), "short counts apply"), "b\n");
}

#[test]
fn separated_hunks_and_invalid_models() -> () {
    let old = "a\nb\nc\nd\ne\nf\ng\nh\n";
    let new = "A\nb\nc\nd\ne\nf\ng\nH\n";
    let patch = testing::expect_ok(diff::patch(old, new, "old", "new", 1), "patch");
    testing::assert_eq(patch.hunks.len(), 2);
    testing::assert_eq(testing::expect_ok(patch.apply(old), "apply"), new);
    let invalid = diff::Patch {
        old_name: "a",
        new_name: "b",
        hunks: Vec::from_array(
            [
                diff::Hunk {
                    old_start: 0,
                    old_count: 0,
                    new_start: 0,
                    new_count: 1,
                    lines: Vec::from_array(
                        [diff::PatchLine { tag: diff::Tag::Insert, text: "a\nb\n" }],
                    ),
                },
            ],
        ),
    };
    testing::assert_err(invalid.to_unified());
    testing::assert_err(invalid.apply(""));
}
