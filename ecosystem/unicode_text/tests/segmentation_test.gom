package tests;

use ecosystem::unicode_text as unicode;
use std::testing;
use std::text;

#[test]
fn graphemes_preserve_utf8_offsets_and_extended_sequences() -> () {
    let value = "é👩🏽‍💻🇨🇳각क्‍क\r\n";
    let segments = unicode::graphemes(value);
    testing::assert_eq(segments.len(), 6);
    let builder = text::StringBuilder::new();
    let mut end = 0;
    for segment in segments {
        testing::assert_eq(segment.start, end);
        testing::assert_eq(segment.text, value.byte_slice(segment.start, segment.end));
        testing::assert(unicode::is_grapheme_boundary(value, segment.start));
        builder.write_string(segment.text);
        end = segment.end;
    }
    testing::assert_eq(end, value.byte_len());
    testing::assert_eq(builder.finish(), value);
    testing::assert_eq(segments[4].text, "क्‍क");
    testing::assert_eq(segments[5].text, "\r\n");
    testing::assert(!unicode::is_grapheme_boundary(value, 1));
    testing::assert(!unicode::is_grapheme_boundary(value, 2));
    testing::assert(!unicode::is_grapheme_boundary(value, -1));
    testing::assert(!unicode::is_grapheme_boundary(value, value.byte_len() + 1));
}

#[test]
fn empty_text_and_regional_indicator_parity() -> () {
    testing::assert_eq(unicode::graphemes("").len(), 0);
    testing::assert(unicode::grapheme_boundaries("") == Vec::from_array([0]));
    testing::assert(unicode::word_boundaries("") == Vec::from_array([0]));
    testing::assert_eq(unicode::line_breaks("").len(), 1);
    testing::assert(unicode::line_breaks("")[0].mandatory);
    let clusters = unicode::graphemes("🇦🇧🇨🇩🇪");
    testing::assert_eq(clusters.len(), 3);
    testing::assert_eq(clusters[0].text, "🇦🇧");
    testing::assert_eq(clusters[2].text, "🇪");
    testing::assert(unicode::is_grapheme_boundary("", 0));
}

#[test]
fn prepend_controls_and_non_emoji_joiners() -> () {
    testing::assert_eq(unicode::graphemes("\u0600A").len(), 1);
    testing::assert_eq(unicode::graphemes("a\u200db").len(), 2);
    testing::assert_eq(unicode::graphemes("\n\u0301").len(), 2);
    testing::assert_eq(unicode::graphemes("👩\u0301\u200d💻").len(), 1);
    testing::assert_eq(unicode::graphemes("👩\u0301\u200da").len(), 2);
}

#[test]
fn words_handle_quotes_numbers_hebrew_and_ideographs() -> () {
    let values = unicode::words("can't 3,456.78 א\"ב 中文 😀 ___");
    testing::assert_eq(values.len(), 5);
    testing::assert_eq(values[0].text, "can't");
    testing::assert_eq(values[1].text, "3,456.78");
    testing::assert_eq(values[2].text, "א\"ב");
    testing::assert_eq(values[3].text, "中");
    testing::assert_eq(values[4].text, "文");
    let source = "é x\u200dy!";
    let builder = text::StringBuilder::new();
    for word in unicode::word_segments(source) {
        testing::assert_eq(word.text, source.byte_slice(word.start, word.end));
        builder.write_string(word.text);
    }
    testing::assert_eq(builder.finish(), source);
}

#[test]
fn line_breaks_obey_joiners_punctuation_numbers_and_hard_breaks() -> () {
    let breaks = unicode::line_breaks("a\u00a0b a\u2060b\r\n界。");
    testing::assert_eq(breaks.len(), 3);
    testing::assert_eq(breaks[0].offset, "a\u00a0b ".byte_len());
    testing::assert(!breaks[0].mandatory);
    testing::assert_eq(breaks[1].offset, "a\u00a0b a\u2060b\r\n".byte_len());
    testing::assert(breaks[1].mandatory);
    testing::assert_eq(unicode::line_breaks("$(12.35)%").len(), 1);
    testing::assert_eq(unicode::line_breaks("(  abc)").len(), 1);
    testing::assert_eq(unicode::line_breaks("a\u200b  b").len(), 2);
    testing::assert_eq(unicode::line_breaks("a\u0085b\u2028c\u2029").len(), 3);
}

#[test]
fn long_combining_and_regional_sequences_remain_bounded() -> () {
    let builder = text::StringBuilder::new();
    builder.write_string("a");
    for _ in 0..10000 {
        builder.write_string("\u0301");
    }
    let value = builder.finish();
    testing::assert_eq(unicode::graphemes(value).len(), 1);
    testing::assert_eq(unicode::width(value), 1);
    let flags = text::StringBuilder::new();
    for _ in 0..4000 {
        flags.write_string("🇦");
    }
    testing::assert_eq(unicode::graphemes(flags.finish()).len(), 2000);
}
