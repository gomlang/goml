package tests;

use ecosystem::unicode_text as unicode;
use std::testing;

#[test]
fn width_covers_emoji_variations_ambiguous_and_controls() -> () {
    let defaults = unicode::WidthOptions::new();
    testing::assert_eq(unicode::width("a中é👩🏽‍💻🇨🇳1️⃣"), 10);
    testing::assert_eq(unicode::width("\u0301\u200b\u2060\t\r\n\u0000"), 0);
    testing::assert_eq(unicode::width("©"), 1);
    testing::assert_eq(unicode::width("©️"), 2);
    testing::assert_eq(unicode::width("©︎"), 1);
    testing::assert_eq(unicode::width("·"), 1);
    testing::assert_eq(
        unicode::width_with("·", unicode::WidthOptions { ambiguous_wide: true, ..defaults }),
        2,
    );
    testing::assert_eq(
        unicode::width_with("😀👩🏽‍💻🇨🇳", unicode::WidthOptions { emoji_wide: false, ..defaults }),
        3,
    );
    testing::assert_eq(unicode::width("각"), 2);
    testing::assert_eq(unicode::max_line_width("ab\r\n界界\u2028x", defaults), 4);
}

#[test]
fn truncation_never_splits_a_grapheme() -> () {
    let value = "a界é👩🏽‍💻";
    testing::assert_eq(unicode::truncate(value, -1), "");
    testing::assert_eq(unicode::truncate(value, 0), "");
    testing::assert_eq(unicode::truncate(value, 2), "a");
    testing::assert_eq(unicode::truncate(value, 3), "a界");
    testing::assert_eq(unicode::truncate(value, 4), "a界é");
    testing::assert_eq(unicode::truncate(value, 6), value);
    testing::assert_eq(unicode::truncate("\u0301a", 0), "\u0301");
}

#[test]
fn ellipsis_and_alignment_respect_width_and_output_limits() -> () {
    let width = unicode::WidthOptions::new();
    let limits = unicode::LayoutLimits::new();
    testing::assert_eq(
        testing::expect_ok(unicode::ellipsize("中文世界", 5, "…", width, limits), "ellipsis"),
        "中文…",
    );
    testing::assert_eq(
        testing::expect_ok(unicode::ellipsize("abcdef", 1, "界", width, limits), "wide marker"),
        "a",
    );
    testing::assert_eq(
        testing::expect_ok(
            unicode::pad("界", 5, unicode::Alignment::Center, width, limits),
            "center",
        ),
        " 界  ",
    );
    testing::assert_eq(
        testing::expect_ok(unicode::pad("界", 4, unicode::Alignment::Right, width, limits), "right"),
        "  界",
    );
    testing::assert_eq(
        testing::expect_ok(
            unicode::pad("界", 1, unicode::Alignment::Left, width, limits),
            "no clipping",
        ),
        "界",
    );
    let small = unicode::LayoutLimits { max_output_bytes: 3, ..limits };
    testing::assert_err(unicode::pad("界", 4, unicode::Alignment::Left, width, small));
    testing::assert_err(
        unicode::pad("x", 9223372036854775807, unicode::Alignment::Left, width, limits),
    );
    testing::assert_err(
        unicode::ellipsize(
            "abcd",
            2,
            "…",
            width,
            unicode::LayoutLimits { max_output_bytes: 3, ..limits },
        ),
    );
}

#[test]
fn tabs_use_display_columns_and_reset_at_hard_breaks() -> () {
    let width = unicode::WidthOptions::new();
    let limits = unicode::LayoutLimits::new();
    testing::assert_eq(
        testing::expect_ok(unicode::expand_tabs("界\tx\r\na\tb", 4, width, limits), "tabs"),
        "界  x\r\na   b",
    );
    testing::assert_err(unicode::expand_tabs("\t", 0, width, limits));
    testing::assert_err(unicode::expand_tabs("\t", 1048577, width, limits));
    testing::assert_err(
        unicode::expand_tabs(
            "\t",
            8,
            width,
            unicode::LayoutLimits { max_output_bytes: 2, ..limits },
        ),
    );
}

#[test]
fn wrapping_prefers_words_preserves_clusters_and_hard_lines() -> () {
    testing::assert(unicode::wrap("hello world", 5) == Vec::from_array(["hello", "world"]));
    testing::assert(unicode::wrap("a\r\n\n界界\n", 3) == Vec::from_array(["a", "", "界", "界", ""]));
    testing::assert(unicode::wrap("👩🏽‍💻x", 1) == Vec::from_array(["👩🏽‍💻", "x"]));
    testing::assert(unicode::wrap("éé", 1) == Vec::from_array(["é", "é"]));
    testing::assert(unicode::wrap("", 5) == Vec::from_array([""]));
    testing::assert(unicode::wrap("abc", 0) == Vec::from_array(["a", "b", "c"]));
    testing::assert(unicode::wrap("a     b", 1) == Vec::from_array(["a", "b"]));
}

#[test]
fn configured_wrapping_reports_source_ranges_and_overflow() -> () {
    let source = "hello world\n界";
    let lines = testing::expect_ok(
        unicode::wrap_configured(source, unicode::WrapOptions::new(5)),
        "wrap",
    );
    testing::assert_eq(lines.len(), 3);
    for line in lines {
        testing::assert_eq(line.text, source.byte_slice(line.start, line.end));
    }
    testing::assert(!lines[0].hard_break);
    testing::assert(lines[1].hard_break);
    testing::assert_eq(lines[2].width, 2);
    let whole = testing::expect_ok(
        unicode::wrap_configured(
            "abcdefgh ij",
            unicode::WrapOptions { break_long_words: false, ..unicode::WrapOptions::new(3) },
        ),
        "whole words",
    );
    testing::assert_eq(whole[0].text, "abcdefgh");
    testing::assert_eq(whole[0].width, 8);
    let preserved = testing::expect_ok(
        unicode::wrap_configured(
            "a   b",
            unicode::WrapOptions { trim_spaces: false, ..unicode::WrapOptions::new(2) },
        ),
        "preserve whitespace",
    );
    let mut joined = "";
    for line in preserved {
        joined = joined + line.text;
    }
    testing::assert_eq(joined, "a   b");
}

#[test]
fn checked_layout_rejects_invalid_and_exhausted_limits() -> () {
    let width = unicode::WidthOptions::new();
    let limits = unicode::LayoutLimits::new();
    testing::assert_err(unicode::truncate_checked("x", -1, width, limits));
    testing::assert_err(
        unicode::truncate_checked(
            "界",
            1,
            width,
            unicode::LayoutLimits { max_input_bytes: 2, ..limits },
        ),
    );
    testing::assert_err(
        unicode::truncate_checked(
            "界",
            2,
            width,
            unicode::LayoutLimits { max_output_bytes: 2, ..limits },
        ),
    );
    testing::assert_err(unicode::wrap_configured("", unicode::WrapOptions::new(0)));
    testing::assert_err(
        unicode::wrap_configured(
            "a\nb",
            unicode::WrapOptions {
                limits: unicode::LayoutLimits { max_lines: 1, ..limits },
                ..unicode::WrapOptions::new(3),
            },
        ),
    );
    testing::assert_err(
        unicode::wrap_configured(
            "abc",
            unicode::WrapOptions {
                limits: unicode::LayoutLimits { max_output_bytes: 2, ..limits },
                ..unicode::WrapOptions::new(3),
            },
        ),
    );
    testing::assert_err(unicode::LayoutLimits { max_input_bytes: -1, ..limits }.validate());
    testing::assert_err(unicode::LayoutLimits { max_lines: 0, ..limits }.validate());
}
