package unicode_text;

use std::text;

pub enum Error {
    InvalidOptions(string),
    InputLimit,
    OutputLimit,
    LineLimit,
}

impl ToString for Error {
    fn to_string(self) -> string {
        match self {
            Error::InvalidOptions(message) => message,
            Error::InputLimit => "Unicode text input byte limit exceeded",
            Error::OutputLimit => "Unicode text output byte limit exceeded",
            Error::LineLimit => "Unicode text line limit exceeded",
        }
    }
}

pub struct LayoutLimits {
    pub max_input_bytes: isize,
    pub max_output_bytes: isize,
    pub max_lines: isize,
}

impl LayoutLimits {
    pub fn new() -> LayoutLimits {
        LayoutLimits { max_input_bytes: 1048576, max_output_bytes: 16777216, max_lines: 100000 }
    }

    pub fn validate(self) -> Result[(), Error] {
        if self.max_input_bytes < 0 || self.max_output_bytes < 0 || self.max_lines < 1 {
            return Result::Err(
                Error::InvalidOptions("layout limits must be nonnegative and max_lines positive"),
            );
        }
        Result::Ok(())
    }

    fn input(self, value: string) -> Result[(), Error] {
        self.validate()?;
        if value.byte_len() > self.max_input_bytes {
            Result::Err(Error::InputLimit)
        } else {
            Result::Ok(())
        }
    }
}

pub enum Alignment {
    Left,
    Center,
    Right,
}

pub fn truncate_checked(value: string, columns: isize, options: WidthOptions, limits: LayoutLimits) -> Result[
    string,
    Error,
] {
    limits.input(value)?;
    if columns < 0 {
        return Result::Err(Error::InvalidOptions("columns must be nonnegative"));
    }
    let result = truncate_with(value, columns, options);
    if result.byte_len() > limits.max_output_bytes {
        Result::Err(Error::OutputLimit)
    } else {
        Result::Ok(result)
    }
}

pub fn ellipsize(
    value: string,
    columns: isize,
    marker: string,
    options: WidthOptions,
    limits: LayoutLimits,
) -> Result[string, Error] {
    limits.input(value)?;
    limits.input(marker)?;
    if columns < 0 {
        return Result::Err(Error::InvalidOptions("columns must be nonnegative"));
    }
    if width_with(value, options) <= columns {
        return truncate_checked(value, columns, options, limits);
    }
    let suffix = truncate_with(marker, columns, options);
    let prefix = truncate_with(value, columns - width_with(suffix, options), options);
    if suffix.byte_len() > limits.max_output_bytes
        || prefix.byte_len() > limits.max_output_bytes - suffix.byte_len() {
        return Result::Err(Error::OutputLimit);
    }
    Result::Ok(prefix + suffix)
}

pub fn pad(
    value: string,
    columns: isize,
    alignment: Alignment,
    options: WidthOptions,
    limits: LayoutLimits,
) -> Result[string, Error] {
    limits.input(value)?;
    if columns < 0 {
        return Result::Err(Error::InvalidOptions("columns must be nonnegative"));
    }
    let occupied = width_with(value, options);
    let missing = if columns > occupied {
        columns - occupied
    } else {
        0
    };
    if value.byte_len() > limits.max_output_bytes
        || missing > limits.max_output_bytes - value.byte_len() {
        return Result::Err(Error::OutputLimit);
    }
    let left = match alignment {
        Alignment::Left => 0,
        Alignment::Center => missing / 2,
        Alignment::Right => missing,
    };
    let builder = text::StringBuilder::new();
    for _ in 0..left {
        builder.write_string(" ");
    }
    builder.write_string(value);
    for _ in left..missing {
        builder.write_string(" ");
    }
    Result::Ok(builder.finish())
}

pub fn expand_tabs(value: string, tab_stop: isize, options: WidthOptions, limits: LayoutLimits) -> Result[
    string,
    Error,
] {
    limits.input(value)?;
    if tab_stop < 1 || tab_stop > 1048576 {
        return Result::Err(Error::InvalidOptions("tab_stop must be between 1 and 1048576"));
    }
    let builder = text::StringBuilder::new();
    let mut bytes = 0;
    let mut column = 0;
    for cluster in graphemes(value) {
        if cluster.text == "\t" {
            let count = tab_stop - column % tab_stop;
            if count > limits.max_output_bytes - bytes {
                return Result::Err(Error::OutputLimit);
            }
            for _ in 0..count {
                builder.write_string(" ");
            }
            bytes += count;
            column += count;
        } else {
            if cluster.text.byte_len() > limits.max_output_bytes - bytes {
                return Result::Err(Error::OutputLimit);
            }
            builder.write_string(cluster.text);
            bytes += cluster.text.byte_len();
            column = if hard_separator(cluster.text) {
                0
            } else {
                column + width_with(cluster.text, options)
            };
        }
    }
    Result::Ok(builder.finish())
}

fn hard_separator(value: string) -> bool {
    value == "\r\n" || value == "\r" || value == "\n" || value == "\u000b" || value == "\u000c"
        || value == "\u0085"
        || value == "\u2028"
        || value == "\u2029"
}
