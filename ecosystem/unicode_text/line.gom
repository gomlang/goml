package unicode_text;

pub struct LineBreak {
    pub offset: isize,
    pub mandatory: bool,
}

fn line_hard(value: isize) -> bool {
    value == L_BK || value == L_CR || value == L_LF || value == L_NL
}

fn line_alphabetic(value: isize) -> bool {
    value == L_AL || value == L_HL
}

fn line_hangul(value: isize) -> bool {
    value == L_JL || value == L_JV || value == L_JT || value == L_H2 || value == L_H3
}

fn line_aksara(value: Scalar) -> bool {
    value.line == L_AK || value.line == L_AS || value.code == 9676
}

fn line_resolved(item: Scalar) -> Scalar {
    let mut value = item;
    value.line = if item.line == L_AI || item.line == L_XX || item.line == L_SG {
        L_AL
    } else if item.line == L_SA {
        if has_flag(item, F_MARK) {
            L_CM
        } else {
            L_AL
        }
    } else if item.line == L_CJ {
        L_NS
    } else {
        item.line
    };
    value
}

fn line_at(items: Vec[Scalar], index: isize) -> isize {
    if index < 0 || index >= items.len() {
        -1
    } else {
        items[index].line
    }
}

fn line_east(items: Vec[Scalar], index: isize) -> bool {
    index >= 0 && index < items.len() && has_flag(items[index], F_EAST_ASIAN)
}

fn line_quote_start(value: isize) -> bool {
    value == -1 || line_hard(value) || value == L_OP || value == L_QU || value == L_GL
        || value == L_SP
        || value == L_ZW
}

fn line_quote_end(value: isize) -> bool {
    value == -1 || line_hard(value) || value == L_SP || value == L_GL || value == L_WJ
        || value == L_CL
        || value == L_QU
        || value == L_CP
        || value == L_EX
        || value == L_IS
        || value == L_SY
        || value == L_ZW
}

fn line_word_start(value: isize) -> bool {
    value == -1 || line_hard(value) || value == L_SP || value == L_ZW || value == L_CB
        || value == L_GL
}

fn line_allowed(
    items: Vec[Scalar],
    index: isize,
    nonspace: Vec[isize],
    numeric: Vec[bool],
    regional: Vec[isize],
) -> bool {
    let left = items[index - 1];
    let right = items[index];
    let a = left.line;
    let b = right.line;
    let before = line_at(items, index - 2);
    let after = line_at(items, index + 1);
    let spaced_index = nonspace[index - 1];
    let spaced = line_at(items, spaced_index);
    if a == L_BK {
        return true;
    }
    if a == L_CR && b == L_LF {
        return false;
    }
    if a == L_CR || a == L_LF || a == L_NL {
        return true;
    }
    if line_hard(b) || b == L_SP || b == L_ZW {
        return false;
    }
    if spaced == L_ZW {
        return true;
    }
    if a == L_ZWJ {
        return false;
    }
    if a == L_WJ || b == L_WJ || a == L_GL {
        return false;
    }
    if b == L_GL && a != L_SP && a != L_BA && a != L_HY {
        return false;
    }
    if b == L_CL || b == L_CP || b == L_EX || b == L_SY {
        return false;
    }
    if spaced == L_OP {
        return false;
    }
    if spaced == L_QU && has_flag(items[spaced_index], F_INITIAL_QUOTE)
        && line_quote_start(line_at(items, spaced_index - 1)) {
        return false;
    }
    if b == L_QU && has_flag(right, F_FINAL_QUOTE) && line_quote_end(after) {
        return false;
    }
    if a == L_SP && b == L_IS && after == L_NU {
        return true;
    }
    if b == L_IS {
        return false;
    }
    if (spaced == L_CL || spaced == L_CP) && b == L_NS {
        return false;
    }
    if spaced == L_B2 && b == L_B2 {
        return false;
    }
    if a == L_SP {
        return true;
    }
    if b == L_QU && !has_flag(right, F_INITIAL_QUOTE) {
        return false;
    }
    if a == L_QU && !has_flag(left, F_FINAL_QUOTE) {
        return false;
    }
    if b == L_QU && (!line_east(items, index - 1) || !line_east(items, index + 1)) {
        return false;
    }
    if a == L_QU && (!line_east(items, index) || !line_east(items, index - 2)) {
        return false;
    }
    if a == L_CB || b == L_CB {
        return true;
    }
    if (a == L_HY || left.code == 8208) && b == L_AL && line_word_start(before) {
        return false;
    }
    if b == L_BA || b == L_HY || b == L_NS || a == L_BB {
        return false;
    }
    if before == L_HL && (a == L_HY || (a == L_BA && !has_flag(left, F_EAST_ASIAN))) && b != L_HL {
        return false;
    }
    if a == L_SY && b == L_HL {
        return false;
    }
    if b == L_IN {
        return false;
    }
    if (line_alphabetic(a) && b == L_NU) || (a == L_NU && line_alphabetic(b)) {
        return false;
    }
    if a == L_PR && (b == L_ID || b == L_EB || b == L_EM) {
        return false;
    }
    if (a == L_ID || a == L_EB || a == L_EM) && b == L_PO {
        return false;
    }
    if (a == L_PR || a == L_PO) && line_alphabetic(b) {
        return false;
    }
    if line_alphabetic(a) && (b == L_PR || b == L_PO) {
        return false;
    }
    if b == L_PO || b == L_PR {
        if numeric[index - 1] {
            return false;
        }
        if (a == L_CL || a == L_CP) && index >= 2 && numeric[index - 2] {
            return false;
        }
    }
    if a == L_PO || a == L_PR {
        if b == L_NU {
            return false;
        }
        if b == L_OP && (after == L_NU || (after == L_IS && line_at(items, index + 2) == L_NU)) {
            return false;
        }
    }
    if b == L_NU && (a == L_HY || a == L_IS || numeric[index - 1]) {
        return false;
    }
    if a == L_JL && (b == L_JL || b == L_JV || b == L_H2 || b == L_H3) {
        return false;
    }
    if (a == L_JV || a == L_H2) && (b == L_JV || b == L_JT) {
        return false;
    }
    if (a == L_JT || a == L_H3) && b == L_JT {
        return false;
    }
    if (line_hangul(a) && b == L_PO) || (a == L_PR && line_hangul(b)) {
        return false;
    }
    if line_alphabetic(a) && line_alphabetic(b) {
        return false;
    }
    if a == L_AP && line_aksara(right) {
        return false;
    }
    if line_aksara(left) && (b == L_VF || b == L_VI) {
        return false;
    }
    if index >= 2 && line_aksara(items[index - 2]) && a == L_VI && (b == L_AK || right.code == 9676) {
        return false;
    }
    if line_aksara(left) && line_aksara(right) && after == L_VF {
        return false;
    }
    if a == L_IS && line_alphabetic(b) {
        return false;
    }
    if (line_alphabetic(a) || a == L_NU) && b == L_OP && !has_flag(right, F_EAST_ASIAN) {
        return false;
    }
    if a == L_CP && !has_flag(left, F_EAST_ASIAN) && (line_alphabetic(b) || b == L_NU) {
        return false;
    }
    if a == L_RI && b == L_RI && regional[index - 1] % 2 == 1 {
        return false;
    }
    if b == L_EM && (a == L_EB || (has_flag(left, F_PICTOGRAPHIC) && has_flag(left, F_UNASSIGNED))) {
        return false;
    }
    true
}

pub fn line_breaks(value: string) -> Vec[LineBreak] {
    let raw = scalars(value);
    let items: Vec[Scalar] = Vec::new();
    let logical: Vec[isize] = Vec::new();
    let attached: Vec[bool] = Vec::new();
    for original in raw {
        let mut item = line_resolved(original);
        if item.line == L_CM || item.line == L_ZWJ {
            let previous = line_at(items, items.len() - 1);
            if previous != -1 && !line_hard(previous) && previous != L_SP && previous != L_ZW {
                logical.push(items.len() - 1);
                attached.push(true);
                continue;
            }
            item.line = L_AL;
            item.code = 65;
            item.flags = 0;
        }
        logical.push(items.len());
        attached.push(false);
        items.push(item);
    }
    let nonspace: Vec[isize] = Vec::new();
    let numeric: Vec[bool] = Vec::new();
    let regional: Vec[isize] = Vec::new();
    let mut last = -1;
    let mut number = false;
    let mut count = 0;
    for index in 0..items.len() {
        let kind = items[index].line;
        if kind != L_SP {
            last = index;
        }
        number = kind == L_NU || (number && (kind == L_SY || kind == L_IS));
        count = if kind == L_RI {
            count + 1
        } else {
            0
        };
        nonspace.push(last);
        numeric.push(number);
        regional.push(count);
    }
    let result = Vec::new();
    for index in 1..raw.len() {
        if attached[index] {
            continue;
        }
        let a = raw[index - 1].line;
        let b = raw[index].line;
        let mandatory = line_hard(a) && !(a == L_CR && b == L_LF);
        let allowed = if mandatory {
            true
        } else if a == L_ZWJ {
            false
        } else {
            line_allowed(items, logical[index], nonspace, numeric, regional)
        };
        if allowed {
            result.push(LineBreak { offset: raw[index].start, mandatory });
        }
    }
    result.push(LineBreak { offset: value.byte_len(), mandatory: true });
    result
}
