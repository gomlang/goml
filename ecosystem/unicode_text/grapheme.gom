package unicode_text;

pub struct Grapheme {
    pub text: string,
    pub start: isize,
    pub end: isize,
}

fn grapheme_control(value: isize) -> bool {
    value == G_CR || value == G_LF || value == G_CONTROL
}

fn grapheme_break(items: Vec[Scalar], index: isize, regional_count: isize) -> bool {
    let left = items[index - 1].grapheme;
    let right = items[index].grapheme;
    if left == G_CR && right == G_LF {
        return false;
    }
    if grapheme_control(left) || grapheme_control(right) {
        return true;
    }
    if left == G_L && (right == G_L || right == G_V || right == G_LV || right == G_LVT) {
        return false;
    }
    if (left == G_LV || left == G_V) && (right == G_V || right == G_T) {
        return false;
    }
    if (left == G_LVT || left == G_T) && right == G_T {
        return false;
    }
    if right == G_EXTEND || right == G_ZWJ || right == G_SPACINGMARK || left == G_PREPEND {
        return false;
    }
    if items[index].indic == I_CONSONANT {
        let mut at = index - 1;
        let mut linker = false;
        while at >= 0 && (items[at].indic == I_EXTEND || items[at].indic == I_LINKER) {
            linker = linker || items[at].indic == I_LINKER;
            at -= 1;
        }
        if linker && at >= 0 && items[at].indic == I_CONSONANT {
            return false;
        }
    }
    if left == G_ZWJ && has_flag(items[index], F_PICTOGRAPHIC) {
        let mut at = index - 2;
        while at >= 0 && items[at].grapheme == G_EXTEND {
            at -= 1;
        }
        if at >= 0 && has_flag(items[at], F_PICTOGRAPHIC) {
            return false;
        }
    }
    !(left == G_REGIONAL_INDICATOR && right == G_REGIONAL_INDICATOR && regional_count % 2 == 1)
}

fn grapheme_starts(items: Vec[Scalar]) -> Vec[isize] {
    let result = Vec::from_array([0]);
    let mut regional_count = 0;
    for index in 0..items.len() {
        if index > 0 && grapheme_break(items, index, regional_count) {
            result.push(index);
        }
        regional_count = if items[index].grapheme == G_REGIONAL_INDICATOR {
            regional_count + 1
        } else {
            0
        };
    }
    if items.len() > 0 {
        result.push(items.len());
    }
    result
}

pub fn grapheme_boundaries(value: string) -> Vec[isize] {
    let items = scalars(value);
    let result = Vec::new();
    for index in grapheme_starts(items) {
        result.push(
            if index == items.len() {
                value.byte_len()
            } else {
                items[index].start
            },
        );
    }
    result
}

pub fn graphemes(value: string) -> Vec[Grapheme] {
    let boundaries = grapheme_boundaries(value);
    let result = Vec::new();
    for index in 1..boundaries.len() {
        let start = boundaries[index - 1];
        let end = boundaries[index];
        result.push(Grapheme { text: value.byte_slice(start, end), start, end });
    }
    result
}

pub fn is_grapheme_boundary(value: string, offset: isize) -> bool {
    if offset < 0 || offset > value.byte_len() {
        return false;
    }
    for boundary in grapheme_boundaries(value) {
        if boundary == offset {
            return true;
        }
        if boundary > offset {
            return false;
        }
    }
    false
}
