package tests;

use tools::unicode_data as generator;
use ecosystem::tempfile;
use std::bytes;
use std::crypto::hash;
use std::fs;
use std::testing;

fn manifest(root: string, digest: string) -> () {
    testing::assert_ok(fs::create_dir_all(root + "/data"));
    let value = "{\"unicode_version\":\"16.0.0\",\"sources\":{\"fixture.txt\":{\"url\":\"https://unicode.example/source\",\"sha256\":\""
        + digest
        + "\"}}}";
    testing::assert_ok(fs::write_file_structured(root + "/data/manifest.json", value));
}

#[test]
fn every_invocation_fetches_fresh_sources_with_no_cache_headers() -> () {
    let directory = testing::expect_ok(tempfile::tempdir(), "Unicode download fixture");
    defer testing::assert_ok(directory.close());
    let payload = bytes::Bytes::from_string("fresh Unicode data\n");
    manifest(directory.path(), hash::sha256(payload));
    let calls = Ref::new(0);
    for _ in 0..2 {
        let result = testing::expect_ok(
            generator::download_with(
                directory.path(),
                |url, headers, limit| {
                    calls.set(calls.get() + 1);
                    testing::assert_eq(url, "https://unicode.example/source");
                    testing::assert_eq(limit, 16777216);
                    testing::assert_eq(headers.len(), 2);
                    testing::assert(headers.contains(("Cache-Control", "no-cache")));
                    testing::assert(headers.contains(("Pragma", "no-cache")));
                    Result::Ok(payload)
                },
            ),
            "fresh download",
        );
        testing::assert_eq(
            testing::expect_ok(generator::source(result, "fixture.txt"), "source"),
            "fresh Unicode data\n",
        );
        testing::assert(!fs::is_file(directory.path() + "/data/fixture.txt"));
    }
    testing::assert_eq(calls.get(), 2);
}

#[test]
fn checksum_and_transport_errors_never_reuse_previous_sources() -> () {
    let directory = testing::expect_ok(tempfile::tempdir(), "Unicode download fixture");
    defer testing::assert_ok(directory.close());
    let payload = bytes::Bytes::from_string("verified source");
    manifest(directory.path(), hash::sha256(payload));
    testing::assert_ok(generator::download_with(directory.path(), |_, _, _| Result::Ok(payload)));
    testing::assert_err(
        generator::download_with(
            directory.path(),
            |_, _, _| Result::Ok(bytes::Bytes::from_string("corrupted source")),
        ),
    );
    testing::assert_err(
        generator::download_with(directory.path(), |_, _, _| Result::Err("network unavailable")),
    );
    testing::assert_ok(generator::download_with(directory.path(), |_, _, _| Result::Ok(payload)));
}

#[test]
fn oversized_and_invalid_utf8_sources_fail_before_becoming_usable() -> () {
    let oversized = bytes::Bytes::from_string("x".repeat(16777217));
    let error = testing::expect_err(
        generator::fetch_source(
            "large",
            "url",
            hash::sha256(oversized),
            |_, _, _| Result::Ok(oversized),
        ),
        "oversized source",
    );
    testing::assert(error.contains("exceeds download limit"));
    let invalid = bytes::Bytes::from_vec(Vec::from_array([255.to_u8()]));
    let error = testing::expect_err(
        generator::fetch_source(
            "invalid",
            "url",
            hash::sha256(invalid),
            |_, _, _| Result::Ok(invalid),
        ),
        "invalid UTF-8 source",
    );
    testing::assert(error.contains("invalid Unicode source UTF-8"));
}
