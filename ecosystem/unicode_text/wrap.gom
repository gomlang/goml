package unicode_text;

pub struct WrapOptions {
    pub columns: isize,
    pub width: WidthOptions,
    pub trim_spaces: bool,
    pub break_long_words: bool,
    pub limits: LayoutLimits,
}

impl WrapOptions {
    pub fn new(columns: isize) -> WrapOptions {
        WrapOptions {
            columns,
            width: WidthOptions::new(),
            trim_spaces: true,
            break_long_words: true,
            limits: LayoutLimits::new(),
        }
    }
}

pub struct WrappedLine {
    pub text: string,
    pub start: isize,
    pub end: isize,
    pub width: isize,
    pub hard_break: bool,
}

fn append_line(
    value: string,
    clusters: Vec[Grapheme],
    begin: isize,
    end: isize,
    hard: bool,
    options: WrapOptions,
    result: Vec[WrappedLine],
    output_bytes: Ref[isize],
) -> Result[(), Error] {
    if result.len() >= options.limits.max_lines {
        return Result::Err(Error::LineLimit);
    }
    let mut visible_end = end;
    if options.trim_spaces {
        while visible_end > begin && clusters[visible_end - 1].text == " " {
            visible_end -= 1;
        }
    }
    let start_byte = if begin < clusters.len() {
        clusters[begin].start
    } else {
        value.byte_len()
    };
    let end_byte = if visible_end > begin {
        clusters[visible_end - 1].end
    } else {
        start_byte
    };
    if end_byte - start_byte > options.limits.max_output_bytes - output_bytes.get() {
        return Result::Err(Error::OutputLimit);
    }
    let content = value.byte_slice(start_byte, end_byte);
    output_bytes.set(output_bytes.get() + content.byte_len());
    result.push(
        WrappedLine {
            text: content,
            start: start_byte,
            end: end_byte,
            width: width_with(content, options.width),
            hard_break: hard,
        },
    );
    Result::Ok(())
}

pub fn wrap_configured(value: string, options: WrapOptions) -> Result[Vec[WrappedLine], Error] {
    options.limits.input(value)?;
    if options.columns < 1 {
        return Result::Err(Error::InvalidOptions("wrap columns must be positive"));
    }
    let clusters = graphemes(value);
    let opportunities = line_breaks(value);
    let allowed: Vec[bool] = Vec::new();
    let widths: Vec[isize] = Vec::new();
    let mut opportunity = 0;
    for cluster in clusters {
        while opportunity < opportunities.len() && opportunities[opportunity].offset < cluster.end {
            opportunity += 1;
        }
        allowed.push(
            opportunity < opportunities.len() && opportunities[opportunity].offset == cluster.end,
        );
        widths.push(width_with(cluster.text, options.width));
    }
    let result = Vec::new();
    let output_bytes = Ref::new(0);
    let mut start = 0;
    let mut paragraph = 0;
    while paragraph <= clusters.len() {
        let mut end = paragraph;
        while end < clusters.len() && !hard_separator(clusters[end].text) {
            end += 1;
        }
        let hard = end < clusters.len();
        if start == end {
            append_line(value, clusters, start, end, hard, options, result, output_bytes)?;
        }
        while start < end {
            let mut at = start;
            let mut used = 0;
            let mut trailing = 0;
            let mut best = start;
            while at < end {
                used += widths[at];
                trailing = if options.trim_spaces && clusters[at].text == " " {
                    trailing + widths[at]
                } else {
                    0
                };
                if used - trailing > options.columns {
                    break;
                }
                at += 1;
                if allowed[at - 1] {
                    best = at;
                }
            }
            let finish = if at == end {
                end
            } else if best > start {
                best
            } else if options.break_long_words {
                if at > start {
                    at
                } else {
                    start + 1
                }
            } else {
                let mut next = at;
                while next < end && !allowed[next] {
                    next += 1;
                }
                if next < end {
                    next + 1
                } else {
                    end
                }
            };
            append_line(
                value,
                clusters,
                start,
                finish,
                hard && finish == end,
                options,
                result,
                output_bytes,
            )?;
            start = finish;
            if options.trim_spaces {
                while start < end && clusters[start].text == " " {
                    start += 1;
                }
            }
        }
        if !hard {
            break;
        }
        paragraph = end + 1;
        start = paragraph;
    }
    Result::Ok(result)
}

pub fn wrap_with(value: string, columns: isize, options: WidthOptions) -> Vec[string] {
    let actual = if columns < 1 {
        1
    } else {
        columns
    };
    let limits = LayoutLimits {
        max_input_bytes: value.byte_len(),
        max_output_bytes: value.byte_len(),
        max_lines: value.byte_len() + 1,
    };
    let config = WrapOptions { columns: actual, width: options, limits, ..WrapOptions::new(actual) };
    match wrap_configured(value, config) {
        Result::Ok(lines) => {
            let result = Vec::new();
            for line in lines {
                result.push(line.text);
            }
            result
        },
        Result::Err(_) => Vec::new(),
    }
}

pub fn wrap(value: string, columns: isize) -> Vec[string] {
    wrap_with(value, columns, WidthOptions::new())
}
