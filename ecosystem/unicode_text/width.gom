package unicode_text;

pub struct WidthOptions {
    pub ambiguous_wide: bool,
    pub emoji_wide: bool,
}

impl WidthOptions {
    pub fn new() -> WidthOptions {
        WidthOptions { ambiguous_wide: false, emoji_wide: true }
    }
}

fn cluster_width(items: Vec[Scalar], start: isize, end: isize, options: WidthOptions) -> isize {
    let mut columns = 0;
    let mut emoji = false;
    let mut presentation = false;
    let mut selector = 0;
    let mut joiner = false;
    let mut keycap = false;
    let mut pictographic = 0;
    for index in start..end {
        let item = items[index];
        emoji = emoji || has_flag(item, F_EMOJI);
        presentation = presentation || has_flag(item, F_EMOJI_PRESENTATION);
        if item.code == 65038 || item.code == 65039 {
            selector = item.code;
        }
        joiner = joiner || item.code == 8205;
        keycap = keycap || item.code == 8419;
        if has_flag(item, F_PICTOGRAPHIC) {
            pictographic += 1;
        }
        if has_flag(item, F_ZERO)
            || ((item.code >= 4448 && item.code <= 4607)
                || (item.code >= 55216 && item.code <= 55291)) {
            continue;
        }
        let width = if has_flag(item, F_WIDE)
            || (options.ambiguous_wide && has_flag(item, F_AMBIGUOUS)) {
            2
        } else {
            1
        };
        if width > columns {
            columns = width;
        }
    }
    let rendered_emoji = (presentation && selector != 65038) || (emoji && selector == 65039)
        || (emoji && keycap)
        || (joiner && pictographic >= 2);
    if rendered_emoji {
        if options.emoji_wide {
            2
        } else {
            1
        }
    } else {
        columns
    }
}

pub fn width_with(value: string, options: WidthOptions) -> isize {
    let items = scalars(value);
    let starts = grapheme_starts(items);
    let mut result = 0;
    for index in 1..starts.len() {
        result += cluster_width(items, starts[index - 1], starts[index], options);
    }
    result
}

pub fn width(value: string) -> isize {
    width_with(value, WidthOptions::new())
}

pub fn truncate_with(value: string, columns: isize, options: WidthOptions) -> string {
    if columns < 0 {
        return "";
    }
    let items = scalars(value);
    let starts = grapheme_starts(items);
    let mut used = 0;
    let mut end = 0;
    for index in 1..starts.len() {
        let next = cluster_width(items, starts[index - 1], starts[index], options);
        if next > columns - used {
            break;
        }
        used += next;
        end = items[starts[index] - 1].end;
    }
    value.byte_slice(0, end)
}

pub fn truncate(value: string, columns: isize) -> string {
    truncate_with(value, columns, WidthOptions::new())
}

pub fn max_line_width(value: string, options: WidthOptions) -> isize {
    let mut result = 0;
    let mut start = 0;
    for cluster in graphemes(value) {
        if hard_separator(cluster.text) {
            let columns = width_with(value.byte_slice(start, cluster.start), options);
            if columns > result {
                result = columns;
            }
            start = cluster.end;
        }
    }
    let last = width_with(value.byte_slice(start, value.byte_len()), options);
    if last > result {
        last
    } else {
        result
    }
}
