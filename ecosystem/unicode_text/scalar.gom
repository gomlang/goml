package unicode_text;

struct Scalar {
    start: isize,
    end: isize,
    code: isize,
    grapheme: isize,
    word: isize,
    line: isize,
    indic: isize,
    flags: isize,
}

fn hex_value(offset: isize, digits: isize) -> isize {
    let mut value = 0;
    for index in offset..offset + digits {
        let byte = PROPERTY_DATA.byte_get(index).to_isize();
        value = value * 16
            + if byte <= 57 {
                byte - 48
            } else {
                byte - 87
            };
    }
    value
}

fn properties(code: isize) -> isize {
    let mut low = 0;
    let mut high = (PROPERTY_DATA.byte_len() + 1) / 21;
    while low < high {
        let mid = low + (high - low) / 2;
        let at = mid * 21;
        if code < hex_value(at, 6) {
            high = mid;
        } else if code > hex_value(at + 6, 6) {
            low = mid + 1;
        } else {
            return hex_value(at + 12, 8);
        }
    }
    0
}

fn has_flag(value: Scalar, flag: isize) -> bool {
    (value.flags & flag) != 0
}

fn scalars(value: string) -> Vec[Scalar] {
    let result = Vec::new();
    for (start, character) in value.char_indices() {
        let code = character.to_u32().to_isize();
        let data = properties(code);
        let length = if code < 128 {
            1
        } else if code < 2048 {
            2
        } else if code < 65536 {
            3
        } else {
            4
        };
        result.push(
            Scalar {
                start,
                end: start + length,
                code,
                grapheme: data & 15,
                word: (data >> 4) & 31,
                line: (data >> 9) & 63,
                indic: (data >> 15) & 3,
                flags: data >> 17,
            },
        );
    }
    result
}
