package unicode_text;

pub struct Word {
    pub text: string,
    pub start: isize,
    pub end: isize,
    pub is_word: bool,
}

fn word_ignored(value: isize) -> bool {
    value == W_EXTEND || value == W_FORMAT || value == W_ZWJ
}

fn word_newline(value: isize) -> bool {
    value == W_CR || value == W_LF || value == W_NEWLINE
}

fn word_letter(value: isize) -> bool {
    value == W_ALETTER || value == W_HEBREW_LETTER
}

fn word_mid_letter(value: isize) -> bool {
    value == W_MIDLETTER || value == W_MIDNUMLET || value == W_SINGLE_QUOTE
}

fn word_mid_number(value: isize) -> bool {
    value == W_MIDNUM || value == W_MIDNUMLET || value == W_SINGLE_QUOTE
}

fn word_content(value: isize) -> bool {
    word_letter(value) || value == W_NUMERIC || value == W_KATAKANA || value == W_EXTENDNUMLET
}

fn word_break(
    items: Vec[Scalar],
    index: isize,
    previous: Vec[isize],
    next: Vec[isize],
    regional: Vec[isize],
) -> bool {
    let direct = items[index - 1].word;
    let right = items[index].word;
    if direct == W_CR && right == W_LF {
        return false;
    }
    if word_newline(direct) || word_newline(right) {
        return true;
    }
    if direct == W_ZWJ && has_flag(items[index], F_PICTOGRAPHIC) {
        return false;
    }
    if direct == W_WSEGSPACE && right == W_WSEGSPACE {
        return false;
    }
    if word_ignored(right) {
        return false;
    }
    let left_index = previous[index];
    if left_index < 0 {
        return true;
    }
    let left = items[left_index].word;
    let before = if previous[left_index] < 0 {
        W_OTHER
    } else {
        items[previous[left_index]].word
    };
    let after = if next[index] == items.len() {
        W_OTHER
    } else {
        items[next[index]].word
    };
    if word_letter(left) && word_letter(right) {
        return false;
    }
    if word_letter(left) && word_mid_letter(right) && word_letter(after) {
        return false;
    }
    if word_letter(before) && word_mid_letter(left) && word_letter(right) {
        return false;
    }
    if left == W_HEBREW_LETTER && right == W_SINGLE_QUOTE {
        return false;
    }
    if left == W_HEBREW_LETTER && right == W_DOUBLE_QUOTE && after == W_HEBREW_LETTER {
        return false;
    }
    if before == W_HEBREW_LETTER && left == W_DOUBLE_QUOTE && right == W_HEBREW_LETTER {
        return false;
    }
    if left == W_NUMERIC && (right == W_NUMERIC || word_letter(right)) {
        return false;
    }
    if word_letter(left) && right == W_NUMERIC {
        return false;
    }
    if before == W_NUMERIC && word_mid_number(left) && right == W_NUMERIC {
        return false;
    }
    if left == W_NUMERIC && word_mid_number(right) && after == W_NUMERIC {
        return false;
    }
    if left == W_KATAKANA && right == W_KATAKANA {
        return false;
    }
    if word_content(left) && right == W_EXTENDNUMLET {
        return false;
    }
    if left == W_EXTENDNUMLET && word_content(right) {
        return false;
    }
    !(left == W_REGIONAL_INDICATOR && right == W_REGIONAL_INDICATOR && regional[left_index] % 2 == 1)
}

pub fn word_boundaries(value: string) -> Vec[isize] {
    let items = scalars(value);
    let previous: Vec[isize] = Vec::new();
    let next: Vec[isize] = Vec::new();
    let regional: Vec[isize] = Vec::new();
    let mut last = -1;
    let mut count = 0;
    for index in 0..items.len() {
        previous.push(last);
        next.push(items.len());
        if !word_ignored(items[index].word) {
            last = index;
            count = if items[index].word == W_REGIONAL_INDICATOR {
                count + 1
            } else {
                0
            };
        }
        regional.push(count);
    }
    let mut following = items.len();
    let mut index = items.len();
    while index > 0 {
        index -= 1;
        next[index] = following;
        if !word_ignored(items[index].word) {
            following = index;
        }
    }
    let result = Vec::from_array([0]);
    for at in 1..items.len() {
        if word_break(items, at, previous, next, regional) {
            result.push(items[at].start);
        }
    }
    if value.byte_len() > 0 {
        result.push(value.byte_len());
    }
    result
}

pub fn word_segments(value: string) -> Vec[Word] {
    let boundaries = word_boundaries(value);
    let result = Vec::new();
    for index in 1..boundaries.len() {
        let start = boundaries[index - 1];
        let end = boundaries[index];
        let content = value.byte_slice(start, end);
        let mut is_word = false;
        for item in scalars(content) {
            is_word = is_word || has_flag(item, F_WORD);
        }
        result.push(Word { text: content, start, end, is_word });
    }
    result
}

pub fn words(value: string) -> Vec[Word] {
    let result = Vec::new();
    for word in word_segments(value) {
        if word.is_word {
            result.push(word);
        }
    }
    result
}
