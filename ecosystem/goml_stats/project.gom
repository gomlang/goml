package goml_stats;

use std::fs;
use std::fs::walkdir;
use std::path;
use std::text;

pub struct Options {
    pub excludes: Vec[string],
    pub use_default_excludes: bool,
}

impl Options {
    pub fn new() -> Options {
        Options { excludes: Vec::new(), use_default_excludes: true }
    }
}

pub struct FileStats {
    pub path: string,
    pub package_path: string,
    pub module_path: Option[string],
    pub counts: Counts,
}

pub struct Group {
    pub path: string,
    pub counts: Counts,
}

pub struct Report {
    pub root: string,
    pub totals: Counts,
    pub modules: Vec[Group],
    pub packages: Vec[Group],
    pub files: Vec[FileStats],
    pub unassigned: Counts,
}

pub fn default_excludes() -> Vec[string] {
    Vec::from_array(
        [
            ".git",
            ".hg",
            ".svn",
            ".goml",
            "_artifact",
            "_bootstrap",
            "stage0",
            "stage1",
            "stage2",
            "stage3",
            "node_modules",
            "__pycache__",
        ],
    )
}

pub fn normalize_exclude(value: string) -> Result[string, string] {
    let cleaned = path::clean(value);
    if value == "" || path::is_absolute(value) || cleaned == "." || cleaned == ".."
        || text::starts_with_at(cleaned, 0, "../") {
        Result::Err(f"invalid exclusion {value}: use a name or a path relative to the scan root")
    } else {
        Result::Ok(cleaned)
    }
}

fn is_excluded(relative: string, name: string, excludes: Vec[string]) -> bool {
    for excluded in excludes {
        if excluded == relative || excluded == name {
            return true
        }
    }
    false
}

fn module_owner(directory: string, modules: HashMap[string, Counts]) -> Option[string] {
    let mut current = directory;
    loop {
        if modules.get(current).is_some() {
            return Option::Some(current)
        }
        if current == "." {
            return Option::None
        }
        current = path::parent(current).unwrap_or(".");
    }
}

fn is_test_file(relative: string) -> bool {
    let name = path::file_name(relative).unwrap_or(relative);
    if name.byte_len() >= 9 && name.byte_slice(name.byte_len() - 9, name.byte_len()) == "_test.gom" {
        return true
    }
    for component in path::components(relative) {
        if component == "tests" {
            return true
        }
    }
    false
}

fn sorted_groups(values: HashMap[string, Counts], names: Vec[string]) -> Vec[Group] {
    names.sort_by(
        |left, right| if left < right {
            -1
        } else if left > right {
            1
        } else {
            0
        },
    );
    let result: Vec[Group] = Vec::new();
    for name in names {
        result.push(Group { path: name, counts: values.get(name).unwrap_or(Counts::empty()) });
    }
    result
}

pub fn scan(root: string, options: Options) -> Result[Report, string] {
    let absolute = path::absolute_structured(root).map_err(|error| error.to_string())?;
    let metadata = fs::symlink_metadata(absolute).map_err(|error| error.to_string())?;
    if !metadata.file_type().is_dir() && !metadata.file_type().is_file() {
        return Result::Err(f"scan root must be a directory or a .gom file: {absolute}")
    }
    if metadata.file_type().is_file() && path::extension(absolute) != Option::Some("gom") {
        return Result::Err(f"scan root is not a .gom file: {absolute}")
    }
    let base = if metadata.file_type().is_dir() {
        absolute
    } else {
        path::parent(absolute).unwrap_or(absolute)
    };
    let excludes = if options.use_default_excludes {
        default_excludes()
    } else {
        Vec::new()
    };
    for value in options.excludes {
        excludes.push(normalize_exclude(value)?);
    }
    let modules: HashMap[string, Counts] = HashMap::new();
    let module_names: Vec[string] = Vec::new();
    let raw_files: Vec[(string, Counts)] = Vec::new();
    let entries = walkdir::walk(absolute);
    defer entries.close();
    for item in entries {
        let entry = item.map_err(|error| error.to_string())?;
        let relative = path::relative(base, entry.path()).map_err(|error| error.to_string())?;
        let name = entry.file_name().unwrap_or("");
        if entry.depth() > 0 && is_excluded(relative, name, excludes) {
            if entry.file_type().is_dir() {
                entries.skip_current_dir();
            }
            continue
        }
        if entry.file_type().is_file() {
            if name == "goml.toml" {
                let directory = path::parent(relative).unwrap_or(".");
                modules.set(directory, Counts::empty());
                module_names.push(directory);
            } else if path::extension(name) == Option::Some("gom") {
                let source = fs::read_file_structured(entry.path()).map_err(
                    |error| error.to_string(),
                )?;
                let counts = Counts {
                    test_files: if is_test_file(entry.path()) {
                        1
                    } else {
                        0
                    },
                    ..count_source(source),
                };
                raw_files.push((relative, counts));
            }
        }
    }
    raw_files.sort_by(
        |left, right| if left.0 < right.0 {
            -1
        } else if left.0 > right.0 {
            1
        } else {
            0
        },
    );
    let packages: HashMap[string, Counts] = HashMap::new();
    let package_names: Vec[string] = Vec::new();
    let files: Vec[FileStats] = Vec::new();
    let mut totals = Counts::empty();
    let mut unassigned = Counts::empty();
    for (relative, counts) in raw_files {
        let directory = path::parent(relative).unwrap_or(".");
        let owner = module_owner(directory, modules);
        if let Some(name) = owner {
            modules.set(name, modules.get(name).unwrap_or(Counts::empty()).plus(counts));
        } else {
            unassigned = unassigned.plus(counts);
        }
        if packages.get(directory).is_none() {
            package_names.push(directory);
        }
        packages.set(directory, packages.get(directory).unwrap_or(Counts::empty()).plus(counts));
        totals = totals.plus(counts);
        files.push(
            FileStats { path: relative, package_path: directory, module_path: owner, counts },
        );
    }
    Result::Ok(
        Report {
            root: absolute,
            totals,
            modules: sorted_groups(modules, module_names),
            packages: sorted_groups(packages, package_names),
            files,
            unassigned,
        },
    )
}
