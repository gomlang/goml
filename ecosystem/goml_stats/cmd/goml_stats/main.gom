package main;

use ecosystem::goml_stats;
use std::env;
use std::io;
use std::process;
use std::text;

struct Command {
    root: string,
    options: goml_stats::Options,
    json: bool,
    files: bool,
    modules: bool,
    packages: bool,
    help: bool,
}

fn help() -> string {
    "Usage: goml_stats [OPTIONS] [PATH]\n\nCount GoML source files, code/comment/blank lines, bytes, modules and packages.\nPATH defaults to the current directory; a single .gom file is also accepted.\n\n  --files                  Show per-file statistics (also included in JSON)\n  --modules                Show per-module statistics in text output\n  --packages               Show per-package statistics in text output\n  --json                   Emit a JSON report with module and package summaries\n  --exclude NAME_OR_PATH   Exclude a name anywhere or a root-relative path; repeatable\n  --no-default-excludes    Disable the built-in directory exclusions\n  -h, --help               Show this help\n  --                       End options, allowing a path beginning with '-'\n\nSymbolic links are skipped. I/O errors fail the scan without a partial report.\nDefault exclusions: "
        + text::join(goml_stats::default_excludes(), ", ")
}

fn parse(arguments: Vec[string]) -> Result[Command, string] {
    let mut command = Command {
        root: ".",
        options: goml_stats::Options::new(),
        json: false,
        files: false,
        modules: false,
        packages: false,
        help: false,
    };
    let mut has_root = false;
    let mut positional_only = false;
    let mut index = 1;
    while index < arguments.len() {
        let argument = arguments[index];
        if !positional_only && argument == "--" {
            positional_only = true;
        } else if !positional_only && (argument == "--help" || argument == "-h") {
            command.help = true;
        } else if !positional_only && argument == "--json" {
            command.json = true;
        } else if !positional_only && argument == "--files" {
            command.files = true;
        } else if !positional_only && argument == "--modules" {
            command.modules = true;
        } else if !positional_only && argument == "--packages" {
            command.packages = true;
        } else if !positional_only && argument == "--no-default-excludes" {
            command.options = goml_stats::Options { use_default_excludes: false, ..command.options };
        } else if !positional_only && argument == "--exclude" {
            index += 1;
            if index == arguments.len() {
                return Result::Err("--exclude requires a name or relative path")
            }
            command.options.excludes.push(goml_stats::normalize_exclude(arguments[index])?);
        } else if !positional_only && text::starts_with_at(argument, 0, "--exclude=") {
            command.options.excludes.push(
                goml_stats::normalize_exclude(argument.byte_slice(10, argument.byte_len()))?,
            );
        } else if !positional_only && text::starts_with_at(argument, 0, "-") {
            return Result::Err("unknown option: " + argument)
        } else if has_root {
            return Result::Err("expected at most one scan path")
        } else if argument == "" {
            return Result::Err("scan path cannot be empty")
        } else {
            command.root = argument;
            has_root = true;
        }
        index += 1;
    }
    Result::Ok(command)
}

fn main() -> () {
    let command = match parse(env::args()) {
        Ok(value) => value,
        Err(error) => {
            io::eprintln("goml_stats: " + error + "\nRun goml_stats --help for usage.");
            process::exit(2);
            return
        },
    };
    if command.help {
        println(help());
        return
    }
    match goml_stats::scan(command.root, command.options) {
        Ok(report) => {
            if command.json {
                println(goml_stats::render_json(report, command.files));
            } else {
                print(
                    goml_stats::render_text(
                        report,
                        command.modules,
                        command.packages,
                        command.files,
                    ),
                );
            }
        },
        Err(error) => {
            io::eprintln("goml_stats: " + error);
            process::exit(1);
        },
    }
}
