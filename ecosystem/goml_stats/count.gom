package goml_stats;

use std::ascii;

#[derive(Debug, PartialEq)]
pub struct Counts {
    pub files: isize,
    pub test_files: isize,
    pub lines: isize,
    pub code: isize,
    pub comments: isize,
    pub blank: isize,
    pub bytes: isize,
}

impl Counts {
    pub fn empty() -> Counts {
        Counts { files: 0, test_files: 0, lines: 0, code: 0, comments: 0, blank: 0, bytes: 0 }
    }

    pub fn plus(self: Counts, other: Counts) -> Counts {
        Counts {
            files: self.files + other.files,
            test_files: self.test_files + other.test_files,
            lines: self.lines + other.lines,
            code: self.code + other.code,
            comments: self.comments + other.comments,
            blank: self.blank + other.blank,
            bytes: self.bytes + other.bytes,
        }
    }
}

enum Context {
    Code,
    Interpolation(isize),
    InterpolatedString,
    Raw(isize),
}

fn identifier_byte(value: byte) -> bool {
    ascii::is_alphanumeric(value) || value == b'_' || value >= 128
}

fn raw_open(source: string, start: isize, end: isize) -> Option[(isize, isize)] {
    let mut cursor = start;
    if source.byte_get(cursor) == b'b' {
        cursor += 1;
    }
    if cursor >= end || source.byte_get(cursor) != b'r' {
        return Option::None
    }
    cursor += 1;
    let hash_start = cursor;
    while cursor < end && source.byte_get(cursor) == b'#' {
        cursor += 1;
    }
    if cursor < end && source.byte_get(cursor) == b'"' {
        Option::Some((cursor + 1, cursor - hash_start))
    } else {
        Option::None
    }
}

fn quoted_end(source: string, start: isize, end: isize) -> isize {
    let mut cursor = start + 1;
    while cursor < end {
        let value = source.byte_get(cursor);
        if value == b'"' {
            return cursor + 1
        } else if value == b'\\' && cursor + 1 < end {
            cursor += 2;
        } else {
            cursor += 1;
        }
    }
    end
}

fn character_end(source: string, start: isize, end: isize) -> isize {
    let mut cursor = start + 1;
    if cursor >= end {
        return cursor
    }
    let first = source.byte_get(cursor);
    if first == b'\\' && cursor + 1 < end {
        let escape = source.byte_get(cursor + 1);
        cursor += if escape == b'u' {
            6
        } else if escape == b'x' {
            4
        } else {
            2
        };
    } else {
        cursor += if first < 128 {
            1
        } else if first < 224 {
            2
        } else if first < 240 {
            3
        } else {
            4
        };
    }
    if cursor < end && source.byte_get(cursor) == b'\'' {
        cursor + 1
    } else {
        start + 1
    }
}

pub fn count_source(source: string) -> Counts {
    let mut result = Counts { files: 1, bytes: source.byte_len(), ..Counts::empty() };
    let contexts = Vec::from_array([Context::Code]);
    let mut start = 0;
    while start < source.byte_len() {
        let mut end = start;
        while end < source.byte_len() && source.byte_get(end) != b'\n'
            && source.byte_get(end) != b'\r' {
            end += 1;
        }
        let mut code = match contexts[contexts.len() - 1] {
            Raw(_) => true,
            _ => false,
        };
        let mut comment = false;
        let mut cursor = start;
        while cursor < end {
            let value = source.byte_get(cursor);
            match contexts[contexts.len() - 1] {
                Raw(hashes) => {
                    code = true;
                    let mut matched = 0;
                    if value == b'"' {
                        while matched < hashes && cursor + 1 + matched < end
                            && source.byte_get(cursor + 1 + matched) == b'#' {
                            matched += 1;
                        }
                        if matched == hashes {
                            let _ = contexts.pop();
                            cursor += hashes;
                        }
                    }
                    cursor += 1;
                },
                InterpolatedString => {
                    code = true;
                    if value == b'"' {
                        let _ = contexts.pop();
                        cursor += 1;
                    } else if value == b'\\' && cursor + 1 < end {
                        cursor += 2;
                    } else if (value == b'{' || value == b'}') && cursor + 1 < end
                        && source.byte_get(cursor + 1) == value {
                        cursor += 2;
                    } else if value == b'{' {
                        contexts.push(Context::Interpolation(1));
                        cursor += 1;
                    } else {
                        cursor += 1;
                    }
                },
                _ => {
                    if ascii::is_whitespace(value) {
                        cursor += 1;
                    } else if value == b'/' && cursor + 1 < end
                        && source.byte_get(cursor + 1) == b'/' {
                        comment = true;
                        cursor = end;
                    } else {
                        code = true;
                        if value == b'\\' && cursor + 1 < end
                            && source.byte_get(cursor + 1) == b'\\' {
                            cursor = end;
                        } else if let Some((next, hashes)) = raw_open(source, cursor, end) {
                            contexts.push(Context::Raw(hashes));
                            cursor = next;
                        } else if value == b'f' && cursor + 1 < end
                            && source.byte_get(cursor + 1) == b'"' {
                            contexts.push(Context::InterpolatedString);
                            cursor += 2;
                        } else if value == b'"' {
                            cursor = quoted_end(source, cursor, end);
                        } else if value == b'\'' {
                            cursor = character_end(source, cursor, end);
                        } else if identifier_byte(value) {
                            cursor += 1;
                            while cursor < end && identifier_byte(source.byte_get(cursor)) {
                                cursor += 1;
                            }
                        } else {
                            if let Interpolation(depth) = contexts[contexts.len() - 1] {
                                if value == b'}' && depth == 1 {
                                    let _ = contexts.pop();
                                } else if value == b'{' || value == b'}' {
                                    contexts.set(
                                        contexts.len() - 1,
                                        Context::Interpolation(
                                            depth
                                                + if value == b'{' {
                                                    1
                                                } else {
                                                    -1
                                                },
                                        ),
                                    );
                                }
                            }
                            cursor += 1;
                        }
                    }
                },
            }
        }
        result.lines += 1;
        if code {
            result.code += 1;
        } else if comment {
            result.comments += 1;
        } else {
            result.blank += 1;
        }
        if let InterpolatedString = contexts[contexts.len() - 1] {
            let _ = contexts.pop();
        }
        start = end;
        if start < source.byte_len() && source.byte_get(start) == b'\r' {
            start += 1;
        }
        if start < source.byte_len() && source.byte_get(start) == b'\n' {
            start += 1;
        }
    }
    result
}
