package goml_stats;

use std::json;
use std::text;

fn number(value: isize) -> json::Value {
    json::Value::Number(value.to_string())
}

fn counts_json(counts: Counts) -> json::Value {
    json::Value::Object(
        Vec::from_array(
            [
                ("files", number(counts.files)),
                ("test_files", number(counts.test_files)),
                ("lines", number(counts.lines)),
                ("code", number(counts.code)),
                ("comments", number(counts.comments)),
                ("blank", number(counts.blank)),
                ("bytes", number(counts.bytes)),
            ],
        ),
    )
}

fn groups_json(groups: Vec[Group]) -> json::Value {
    let result: Vec[json::Value] = Vec::new();
    for group in groups {
        result.push(
            json::Value::Object(
                Vec::from_array(
                    [
                        ("path", json::Value::String(group.path)),
                        ("counts", counts_json(group.counts)),
                    ],
                ),
            ),
        );
    }
    json::Value::Array(result)
}

pub fn render_json(report: Report, include_files: bool) -> string {
    let fields = Vec::from_array(
        [
            ("schema_version", number(1)),
            ("root", json::Value::String(report.root)),
            ("module_count", number(report.modules.len())),
            ("package_count", number(report.packages.len())),
            ("totals", counts_json(report.totals)),
            ("unassigned", counts_json(report.unassigned)),
            ("modules", groups_json(report.modules)),
            ("packages", groups_json(report.packages)),
        ],
    );
    if include_files {
        let files: Vec[json::Value] = Vec::new();
        for file in report.files {
            files.push(
                json::Value::Object(
                    Vec::from_array(
                        [
                            ("path", json::Value::String(file.path)),
                            ("package", json::Value::String(file.package_path)),
                            (
                                "module",
                                match file.module_path {
                                    Some(value) => json::Value::String(value),
                                    None => json::Value::Null,
                                },
                            ),
                            ("counts", counts_json(file.counts)),
                        ],
                    ),
                ),
            );
        }
        fields.push(("files", json::Value::Array(files)));
    }
    json::encode(json::Value::Object(fields))
}

fn padded(value: string) -> string {
    text::repeat(
        " ",
        if value.byte_len() < 10 {
            10 - value.byte_len()
        } else {
            0
        },
    )
        + value
}

fn header(output: text::StringBuilder, title: string) -> () {
    for name in Vec::from_array(["Files", "Lines", "Code", "Comments", "Blank", "Bytes"]) {
        output.write_string(padded(name));
    }
    output.write_line("  " + title);
}

fn row(output: text::StringBuilder, counts: Counts, name: string) -> () {
    for value in Vec::from_array(
        [counts.files, counts.lines, counts.code, counts.comments, counts.blank, counts.bytes],
    ) {
        output.write_string(padded(value.to_string()));
    }
    output.write_line("  " + name);
}

fn group_table(output: text::StringBuilder, title: string, groups: Vec[Group]) -> () {
    output.write_line("");
    header(output, title);
    for group in groups {
        row(output, group.counts, group.path);
    }
}

pub fn render_text(
    report: Report,
    include_modules: bool,
    include_packages: bool,
    include_files: bool,
) -> string {
    let output = text::StringBuilder::new();
    output.write_line("GoML source statistics: " + report.root);
    output.write_line(
        f"Modules: {report.modules.len()}  Packages: {report.packages.len()}  Test files: {report.totals.test_files}",
    );
    output.write_line("");
    header(output, "Scope");
    row(output, report.totals, "Total");
    if include_modules {
        group_table(output, "Module directory", report.modules);
        if report.unassigned.files > 0 {
            row(output, report.unassigned, "(outside discovered modules)");
        }
    }
    if include_packages {
        group_table(output, "Package directory", report.packages);
    }
    if include_files {
        output.write_line("");
        header(output, "File");
        for file in report.files {
            row(output, file.counts, file.path);
        }
    }
    output.finish()
}
