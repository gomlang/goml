package tests;

use ecosystem::goml_stats;
use std::testing;

fn expect_lines(source: string, code: isize, comments: isize, blank: isize) -> () {
    let counts = goml_stats::count_source(source);
    testing::assert_eq(counts.files, 1);
    testing::assert_eq(counts.test_files, 0);
    testing::assert_eq(counts.bytes, source.byte_len());
    testing::assert_eq(counts.lines, code + comments + blank);
    testing::assert_eq(counts.code, code);
    testing::assert_eq(counts.comments, comments);
    testing::assert_eq(counts.blank, blank);
}

#[test]
fn physical_lines_and_endings() -> () {
    expect_lines("", 0, 0, 0);
    expect_lines("\n", 0, 0, 1);
    expect_lines("\r\n", 0, 0, 1);
    expect_lines("\r", 0, 0, 1);
    expect_lines("\n\r\n\r", 0, 0, 3);
    expect_lines("x", 1, 0, 0);
    expect_lines("x\n", 1, 0, 0);
    expect_lines("x\n\n", 1, 0, 1);
    expect_lines(" \t\r\n// comment\rcode\nlast", 2, 1, 1);
    expect_lines("\t\f ", 0, 0, 1);
}

#[test]
fn comments_and_inline_code() -> () {
    expect_lines("// first\n  /// docs\nlet x = 1; // inline\n\n", 1, 2, 1);
    expect_lines("/* GoML has no block comments\n// this is a line comment\n*/\n", 2, 1, 0);
    expect_lines("// r#\"\n\n// \\\\\n", 0, 2, 1);
}

#[test]
fn ordinary_strings_characters_and_bytes() -> () {
    expect_lines("let url = \"https://example.invalid\";\n// real comment", 1, 1, 0);
    expect_lines("let s = \"\\\"r#\\\" //\";\n// outside\n", 1, 1, 0);
    expect_lines("let c = '\"'; let b = b'\\''; let u = '\\u0022';\n// outside", 1, 1, 0);
    expect_lines("let b = b\"// r#\\\"\";\n\n// outside", 1, 1, 1);
    expect_lines("let 字 = '字'; let emoji = '😀';\n// 中文\n", 1, 1, 0);
}

#[test]
fn raw_strings_keep_comment_and_empty_content_lines() -> () {
    expect_lines("let s = r#\"first\n// content\n\nlast\"#; // inline\n// outside\n", 4, 1, 0);
    expect_lines("let s = r\"first\r\n\r\n// content\r\nlast\";\r\n\r\n", 4, 0, 1);
    expect_lines("let s = r###\"first\n\"##\n// content\n\"###;\n// outside", 4, 1, 0);
    expect_lines("r\"\"; r##\"\n// content\n\"##;\n\n", 3, 0, 1);
}

#[test]
fn raw_bytes_and_identifier_boundaries() -> () {
    expect_lines("let s = br#\"first\n\n// content\n\"#;\n// outside", 4, 1, 0);
    expect_lines("let identifier = \"\"; let other = \"r#\\\"\";\n// outside", 1, 1, 0);
    expect_lines("identifier\"text\";\n// outside\n", 1, 1, 0);
}

#[test]
fn multiline_markers_do_not_open_raw_strings() -> () {
    expect_lines(
        "let s =\n    \\\\r#\" // literal\n    \\\\\n    \\\\// literal\n;\n// outside\n\n",
        5,
        1,
        1,
    );
}

#[test]
fn interpolated_strings_track_nested_expressions() -> () {
    expect_lines("let s = f\"{{hello}} {\"r#\\\"\"} // literal\";\n// outside", 1, 1, 0);
    expect_lines("let s = f\"{r#\"first\n// content\n\nlast\"#}\";\n// outside", 4, 1, 0);
    expect_lines("let s = f\"{f\"{r##\"first\n// content\n\"##}\"}\";\n// outside", 3, 1, 0);
    expect_lines("let s = f\"{if true { \"//\" } else { \"r#\" }}\";\n// outside", 1, 1, 0);
}

#[test]
fn labels_and_incomplete_editor_buffers() -> () {
    expect_lines("'outer: loop { let s = r#\"first\n// content\n\"#;\n}\n// outside", 4, 1, 0);
    expect_lines("break 'outer; let s = r\"first\n// content\n\";\n// outside", 3, 1, 0);
    expect_lines("\"unfinished\n// outside\n", 1, 1, 0);
    expect_lines("r#\"unfinished\n// content\n\n", 3, 0, 0);
}

#[test]
fn exclusions_are_root_relative() -> () {
    testing::assert_eq(
        testing::expect_ok(goml_stats::normalize_exclude("a/../tests/"), "normalized"),
        "tests",
    );
    for invalid in Vec::from_array(["", ".", "..", "../outside", "/absolute", "a/../.."]) {
        testing::assert(goml_stats::normalize_exclude(invalid).is_err());
    }
}
