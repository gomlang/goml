package walkdir;

use std::fs;
use std::path;

pub struct DirEntry {
    path_value: string,
    depth_value: isize,
    metadata_value: fs::Metadata,
    symlink: bool,
    identity: string,
}

impl DirEntry {
    pub fn path(self: DirEntry) -> string {
        self.path_value
    }

    pub fn file_name(self: DirEntry) -> Option[string] {
        path::file_name(self.path_value)
    }

    pub fn depth(self: DirEntry) -> isize {
        self.depth_value
    }

    pub fn file_type(self: DirEntry) -> fs::FileType {
        self.metadata_value.file_type()
    }

    pub fn metadata(self: DirEntry) -> fs::Metadata {
        self.metadata_value
    }

    pub fn path_is_symlink(self: DirEntry) -> bool {
        self.symlink
    }
}

impl Debug for DirEntry {
    fn debug(self: DirEntry) -> string {
        "DirEntry(" + self.path_value + ", depth=" + self.depth_value.to_string() + ")"
    }
}

fn read_entry(location: Location, follow: bool) -> Result[DirEntry, Error] {
    let link_metadata = stat_at(location, false).map_err(
        |error| from_fs(error, location.path, location.depth),
    )?;
    let symlink = link_metadata.value.file_type().is_symlink();
    let metadata = if symlink && follow {
        stat_at(location, true).map_err(|error| from_fs(error, location.path, location.depth))?
    } else {
        link_metadata
    };
    Result::Ok(
        DirEntry {
            path_value: location.path,
            depth_value: location.depth,
            metadata_value: metadata.value,
            symlink,
            identity: metadata.identity,
        },
    )
}
