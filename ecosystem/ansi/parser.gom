package ansi;

use std::utf8;

#[derive(Debug, PartialEq, Eq)]
pub struct Error {
    pub offset: isize,
    pub message: string,
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        f"ANSI byte {self.offset}: {self.message}"
    }
}

#[derive(Debug, PartialEq, Eq)]
pub enum Token {
    Text(string),
    Control(u8),
    Escape(string),
    Csi {
        parameters: string,
        intermediates: string,
        final_byte: u8,
    },
    Osc(string),
    StringControl(u8, string),
}

#[derive(Debug, PartialEq, Eq)]
pub struct Limits {
    pub max_sequence_bytes: isize,
    pub max_chunk_bytes: isize,
    pub max_parameters: isize,
}

impl Limits {
    pub fn standard() -> Limits {
        Limits { max_sequence_bytes: 8192, max_chunk_bytes: 1048576, max_parameters: 128 }
    }
}

struct ParserState {
    pending: Vec[byte],
    offset: isize,
    ended: bool,
    failed: bool,
}

pub struct Parser {
    limits: Limits,
    state: Ref[ParserState],
}

fn fresh_parser_state() -> ParserState {
    ParserState { pending: Vec::new(), offset: 0, ended: false, failed: false }
}

fn failure(offset: isize, message: string) -> Error {
    Error { offset, message }
}

impl Parser {
    pub fn new() -> Parser {
        Parser { limits: Limits::standard(), state: Ref::new(fresh_parser_state()) }
    }

    pub fn with_limits(limits: Limits) -> Result[Parser, Error] {
        if limits.max_sequence_bytes < 4 || limits.max_sequence_bytes > 1048576
            || limits.max_chunk_bytes < 1
            || limits.max_chunk_bytes > 16777216
            || limits.max_parameters < 1
            || limits.max_parameters > 4096 {
            return Result::Err(failure(0, "invalid parser limits"))
        }
        Result::Ok(Parser { limits, state: Ref::new(fresh_parser_state()) })
    }

    pub fn reset(self: Parser) -> () {
        self.state.set(fresh_parser_state())
    }

    pub fn pending_bytes(self: Parser) -> isize {
        self.state.get().pending.len()
    }

    pub fn feed(self: Parser, input: Slice[byte]) -> Result[Vec[Token], Error] {
        let state = self.state.get();
        if state.ended || state.failed {
            return Result::Err(failure(state.offset, "parser requires reset"))
        }
        if input.len() > self.limits.max_chunk_bytes {
            self.state.set(ParserState { failed: true, pending: Vec::new(), ..state });
            return Result::Err(failure(state.offset, "input chunk limit exceeded"))
        }
        let data = state.pending;
        for value in input {
            data.push(value);
        }
        match tokenize(data, state.offset, self.limits) {
            Ok((tokens, remaining, consumed)) => {
                self.state.set(
                    ParserState { pending: remaining, offset: state.offset + consumed, ..state },
                );
                Result::Ok(tokens)
            },
            Err(error) => {
                self.state.set(ParserState { failed: true, pending: Vec::new(), ..state });
                Result::Err(error)
            },
        }
    }

    pub fn finish(self: Parser) -> Result[(), Error] {
        let state = self.state.get();
        if state.failed {
            return Result::Err(failure(state.offset, "parser requires reset"))
        }
        if !state.pending.is_empty() {
            self.state.set(ParserState { failed: true, pending: Vec::new(), ..state });
            return Result::Err(failure(state.offset, "truncated escape sequence or UTF-8"))
        }
        self.state.set(ParserState { ended: true, ..state });
        Result::Ok(())
    }
}

fn decoded(data: Vec[byte], start: isize, end: isize, offset: isize) -> Result[string, Error] {
    utf8::decode_slice(data.as_slice().sub(start, end)).map_err(
        |error| failure(offset + start + error.valid_up_to(), "invalid UTF-8"),
    )
}

fn tokenize(data: Vec[byte], offset: isize, limits: Limits) -> Result[
    (Vec[Token], Vec[byte], isize),
    Error,
] {
    let tokens = Vec::new();
    let mut at = 0;
    while at < data.len() {
        let first = data[at];
        if first == 27 {
            let start = at;
            if at + 1 == data.len() {
                break
            }
            let kind = data[at + 1];
            if kind == 91 {
                let mut end = at + 2;
                let mut count = 1;
                while end < data.len() && data[end] >= 0x30 && data[end] <= 0x3f {
                    if data[end] == 59 || data[end] == 58 {
                        count += 1;
                    }
                    if count > limits.max_parameters {
                        return Result::Err(failure(offset + end, "parameter limit exceeded"))
                    }
                    end += 1;
                    if end - start > limits.max_sequence_bytes {
                        return Result::Err(failure(offset + start, "sequence limit exceeded"))
                    }
                }
                let parameter_end = end;
                while end < data.len() && data[end] >= 0x20 && data[end] <= 0x2f {
                    end += 1;
                    if end - start > limits.max_sequence_bytes {
                        return Result::Err(failure(offset + start, "sequence limit exceeded"))
                    }
                }
                if end == data.len() {
                    break
                }
                if data[end] < 0x40 || data[end] > 0x7e {
                    return Result::Err(failure(offset + end, "invalid CSI final byte"))
                }
                if end + 1 - start > limits.max_sequence_bytes {
                    return Result::Err(failure(offset + start, "sequence limit exceeded"))
                }
                tokens.push(
                    Token::Csi {
                        parameters: decoded(data, at + 2, parameter_end, offset)?,
                        intermediates: decoded(data, parameter_end, end, offset)?,
                        final_byte: data[end],
                    },
                );
                at = end + 1;
            } else if kind == 93 || kind == 80 || kind == 88 || kind == 94 || kind == 95 {
                let mut end = at + 2;
                let mut terminator = 0;
                while end < data.len() {
                    if end - start >= limits.max_sequence_bytes {
                        return Result::Err(failure(offset + start, "sequence limit exceeded"))
                    }
                    if kind == 93 && data[end] == 7 {
                        terminator = 1;
                        break
                    }
                    if data[end] == 27 && end + 1 < data.len() && data[end + 1] == 92 {
                        terminator = 2;
                        break
                    }
                    end += 1;
                }
                if terminator == 0 {
                    break
                }
                if end + terminator - start > limits.max_sequence_bytes {
                    return Result::Err(failure(offset + start, "sequence limit exceeded"))
                }
                let body = decoded(data, at + 2, end, offset)?;
                tokens.push(
                    if kind == 93 {
                        Token::Osc(body)
                    } else {
                        Token::StringControl(kind, body)
                    },
                );
                at = end + terminator;
            } else {
                let mut end = at + 1;
                while end < data.len() && data[end] >= 0x20 && data[end] <= 0x2f {
                    end += 1;
                    if end - start > limits.max_sequence_bytes {
                        return Result::Err(failure(offset + start, "sequence limit exceeded"))
                    }
                }
                if end == data.len() {
                    break
                }
                if data[end] < 0x30 || data[end] > 0x7e {
                    return Result::Err(failure(offset + end, "invalid escape final byte"))
                }
                if end + 1 - start > limits.max_sequence_bytes {
                    return Result::Err(failure(offset + start, "sequence limit exceeded"))
                }
                tokens.push(Token::Escape(decoded(data, at + 1, end + 1, offset)?));
                at = end + 1;
            }
        } else if first < 32 || first == 127 {
            tokens.push(Token::Control(first));
            at += 1;
        } else {
            let mut end = at;
            while end < data.len() && data[end] >= 32 && data[end] != 127 {
                end += 1;
            }
            match utf8::decode_slice(data.as_slice().sub(at, end)) {
                Ok(value) => {
                    tokens.push(Token::Text(value));
                    at = end;
                },
                Err(error) => {
                    if error.error_length().is_none() && end == data.len() {
                        let valid = at + error.valid_up_to();
                        if valid > at {
                            tokens.push(Token::Text(decoded(data, at, valid, offset)?));
                        }
                        at = valid;
                        break
                    }
                    return Result::Err(failure(offset + at + error.valid_up_to(), "invalid UTF-8"))
                },
            }
        }
    }
    let remaining = data.as_slice().sub(at, data.len()).to_vec();
    if remaining.len() > limits.max_sequence_bytes {
        return Result::Err(failure(offset + at, "sequence limit exceeded"))
    }
    Result::Ok((tokens, remaining, at))
}

pub fn parse_tokens(value: string) -> Result[Vec[Token], Error] {
    let parser = Parser::new();
    let result = Vec::new();
    let data = value.to_bytes();
    let mut start = 0;
    while start < data.len() {
        let end = if data.len() - start > 1048576 {
            start + 1048576
        } else {
            data.len()
        };
        for token in parser.feed(data.as_slice().sub(start, end))? {
            result.push(token);
        }
        start = end;
    }
    parser.finish()?;
    Result::Ok(result)
}

pub fn strip(value: string) -> Result[string, Error] {
    let result: Vec[string] = Vec::new();
    for token in parse_tokens(value)? {
        match token {
            Text(value) => result.push(safe_text(value)),
            Control(10) => result.push("\n"),
            Control(9) => result.push("\t"),
            _ => (),
        }
    }
    Result::Ok(result.join(""))
}
