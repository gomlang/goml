package ansi;

use std::io;
use io::Write;

pub fn write[W: Write](writer: W, value: StyledText, profile: Profile) -> Result[(), io::Error] {
    writer.write_all(value.render(profile).to_bytes().as_slice())
}

pub fn write_line[W: Write](writer: W, value: StyledText, profile: Profile) -> Result[(), io::Error] {
    write(writer, value, profile)?;
    writer.write_all("\n".to_bytes().as_slice())
}
