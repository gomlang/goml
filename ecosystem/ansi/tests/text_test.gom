package tests;

use ecosystem::ansi;
use ecosystem::unicode_text;
use std::testing;

#[test]
fn graphemes_span_styles_without_splitting_combining_sequences() -> () {
    let red = ansi::Style::new().foreground(ansi::Color::Indexed(1));
    let blue = ansi::Style::new().foreground(ansi::Color::Indexed(4));
    let text = ansi::StyledText::from_spans(
        Vec::from_array(
            [
                ansi::Span::new("a", red),
                ansi::Span::new("\u0301👩", blue),
                ansi::Span::new("‍💻中", red),
            ],
        ),
    );
    let values = text.graphemes(unicode_text::WidthOptions::new());
    testing::assert_eq(values.len(), 3);
    testing::assert_eq(values[0].text, "á");
    testing::assert_eq(values[0].style, red);
    testing::assert_eq(values[1].text, "👩‍💻");
    testing::assert_eq(values[1].style, blue);
    testing::assert_eq(text.width(), 5);
}

#[test]
fn clipping_wide_cells_fills_partial_intersections() -> () {
    let text = ansi::StyledText::plain("a中b👩‍💻c");
    testing::assert_eq(testing::expect_ok(text.clip(2, 3), "inside wide cells").plain_text(), " b ");
    testing::assert_eq(testing::expect_ok(text.truncate(2), "wide truncation").plain_text(), "a ");
    testing::assert_eq(testing::expect_ok(text.clip(20, 4), "past end").plain_text(), "");
    testing::assert_eq(testing::expect_ok(text.clip(0, 0), "zero width").plain_text(), "");
    testing::assert(text.clip(-1, 4).is_err());
    testing::assert(text.truncate(16777217).is_err());
}

#[test]
fn wrapping_preserves_lines_links_styles_and_column_bounds() -> () {
    let link = testing::expect_ok(ansi::Hyperlink::new("https://example.org", ""), "link");
    let style = ansi::Style::new().with_attribute(ansi::BOLD, true);
    let text = ansi::StyledText::from_spans(
        Vec::from_array([ansi::Span::new("中áb\nxy\n", style).with_link(link)]),
    );
    let lines = testing::expect_ok(text.wrap(3), "wrap");
    testing::assert_eq(lines.len(), 4);
    testing::assert_eq(lines[0].plain_text(), "中á");
    testing::assert_eq(lines[1].plain_text(), "b");
    testing::assert_eq(lines[2].plain_text(), "xy");
    testing::assert_eq(lines[3].plain_text(), "");
    for line in lines {
        testing::assert(line.width() <= 3);
        for span in line.spans() {
            testing::assert_eq(span.style, style);
            testing::assert(span.link == Option::Some(link));
        }
    }
    testing::assert(text.wrap(0).is_err());
    testing::assert_eq(
        testing::expect_ok(ansi::StyledText::plain("中").wrap(1), "oversize grapheme")[0].plain_text(),
        "�",
    );
    for line in testing::expect_ok(ansi::StyledText::plain("a\tb").wrap(3), "tabs") {
        testing::assert(line.width() <= 3);
    }
}

#[test]
fn snapshots_and_external_span_vectors_are_independent() -> () {
    let values = Vec::from_array([ansi::Span::plain("first")]);
    let text = ansi::StyledText::from_spans(values);
    values.push(ansi::Span::plain("outside"));
    let snapshot = text.snapshot();
    text.append(text);
    testing::assert_eq(text.plain_text(), "firstfirst");
    testing::assert_eq(snapshot.plain_text(), "first");
    snapshot.spans().clear();
    testing::assert_eq(snapshot.plain_text(), "first");
}
