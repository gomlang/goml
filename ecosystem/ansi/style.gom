package ansi;

use ecosystem::color;

pub const BOLD: u16 = 1;

pub const DIM: u16 = 2;

pub const ITALIC: u16 = 4;

pub const UNDERLINE: u16 = 8;

pub const BLINK: u16 = 16;

pub const REVERSE: u16 = 32;

pub const HIDDEN: u16 = 64;

pub const STRIKE: u16 = 128;

pub const OVERLINE: u16 = 256;

pub const ALL_ATTRIBUTES: u16 = 511;

#[derive(Debug, PartialEq, Eq)]
pub enum Profile {
    Plain,
    Ansi16,
    Ansi256,
    TrueColor,
}

#[derive(Debug, PartialEq, Eq)]
pub enum Color {
    Default,
    Indexed(u8),
    Rgb(u8, u8, u8),
}

impl Color {
    pub fn from_srgb(value: color::Srgb) -> Color {
        let (red, green, blue) = value.to_rgb8();
        Color::Rgb(red, green, blue)
    }

    pub fn rgb(self: Color) -> Option[(u8, u8, u8)] {
        match self {
            Default => Option::None,
            Rgb(red, green, blue) => Option::Some((red, green, blue)),
            Indexed(index) => Option::Some(palette_rgb(index)),
        }
    }

    pub fn downsample(self: Color, profile: Profile) -> Color {
        match profile {
            Plain => Color::Default,
            TrueColor => self,
            Ansi16 => match self {
                Default => self,
                Indexed(index) if index < 16 => self,
                _ => nearest_color(self, 16),
            },
            Ansi256 => match self {
                Rgb(_, _, _) => nearest_color(self, 256),
                _ => self,
            },
        }
    }
}

impl ToString for Color {
    fn to_string(self: Color) -> string {
        self.debug()
    }
}

pub fn palette_rgb(index: u8) -> (u8, u8, u8) {
    let base: [(u8, u8, u8); 16] = [
        (0, 0, 0),
        (128, 0, 0),
        (0, 128, 0),
        (128, 128, 0),
        (0, 0, 128),
        (128, 0, 128),
        (0, 128, 128),
        (192, 192, 192),
        (128, 128, 128),
        (255, 0, 0),
        (0, 255, 0),
        (255, 255, 0),
        (0, 0, 255),
        (255, 0, 255),
        (0, 255, 255),
        (255, 255, 255),
    ];
    if index < 16 {
        base[index.to_isize()]
    } else if index >= 232 {
        let gray = 8 + (index - 232) * 10;
        (gray, gray, gray)
    } else {
        let value = index.to_isize() - 16;
        let levels: [u8; 6] = [0, 95, 135, 175, 215, 255];
        (levels[value / 36], levels[(value / 6) % 6], levels[value % 6])
    }
}

fn nearest_color(value: Color, count: isize) -> Color {
    let Some((red, green, blue)) = value.rgb() else {
        return Color::Default
    };
    let mut best = 0;
    let mut distance = 1000000;
    for index in 0..count {
        let (r, g, b) = palette_rgb(index.to_u8());
        let dr = red.to_isize() - r.to_isize();
        let dg = green.to_isize() - g.to_isize();
        let db = blue.to_isize() - b.to_isize();
        let candidate = dr * dr + dg * dg + db * db;
        if candidate < distance {
            best = index;
            distance = candidate;
        }
    }
    Color::Indexed(best.to_u8())
}

#[derive(Debug, PartialEq, Eq)]
pub struct Style {
    pub fg: Color,
    pub bg: Color,
    pub attributes: u16,
}

#[derive(PartialEq, Eq)]
pub struct StylePatch {
    pub fg: Option[Color],
    pub bg: Option[Color],
    pub add: u16,
    pub remove: u16,
}

impl Debug for StylePatch {
    fn debug(self: StylePatch) -> string {
        let fg = self.fg.map(|value| value.debug()).unwrap_or("inherit");
        let bg = self.bg.map(|value| value.debug()).unwrap_or("inherit");
        f"StylePatch(fg={fg}, bg={bg}, add={self.add}, remove={self.remove})"
    }
}

impl StylePatch {
    pub fn new() -> StylePatch {
        StylePatch { fg: Option::None, bg: Option::None, add: 0, remove: 0 }
    }
}

impl Style {
    pub fn new() -> Style {
        Style { fg: Color::Default, bg: Color::Default, attributes: 0 }
    }

    pub fn foreground(self: Style, fg: Color) -> Style {
        Style { fg, ..self }
    }

    pub fn background(self: Style, bg: Color) -> Style {
        Style { bg, ..self }
    }

    pub fn with_attribute(self: Style, attribute: u16, enabled: bool) -> Style {
        let attributes = if enabled {
            self.attributes | attribute
        } else {
            self.attributes & ~attribute
        };
        Style { attributes: attributes & ALL_ATTRIBUTES, ..self }
    }

    pub fn patch(self: Style, value: StylePatch) -> Style {
        Style {
            fg: value.fg.unwrap_or(self.fg),
            bg: value.bg.unwrap_or(self.bg),
            attributes: ((self.attributes | value.add) & ~value.remove) & ALL_ATTRIBUTES,
        }
    }

    pub fn resolved(self: Style, profile: Profile) -> Style {
        if profile == Profile::Plain {
            Style::new()
        } else {
            Style {
                fg: self.fg.downsample(profile),
                bg: self.bg.downsample(profile),
                attributes: self.attributes & ALL_ATTRIBUTES,
            }
        }
    }

    pub fn transition(self: Style, previous: Style, profile: Profile) -> string {
        let current = self.resolved(profile);
        let old = previous.resolved(profile);
        if current == old {
            return ""
        }
        let codes: Vec[string] = Vec::new();
        let removed = old.attributes & ~current.attributes;
        if (old.attributes & (BOLD | DIM)) != (current.attributes & (BOLD | DIM)) {
            codes.push("22");
            if current.attributes & BOLD != 0 {
                codes.push("1");
            }
            if current.attributes & DIM != 0 {
                codes.push("2");
            }
        }
        for pair in[
            (ITALIC, 3),
            (UNDERLINE, 4),
            (BLINK, 5),
            (REVERSE, 7),
            (HIDDEN, 8),
            (STRIKE, 9),
            (OVERLINE, 53),
        ] {
            if removed & pair.0 != 0 {
                codes.push(
                    if pair.0 == OVERLINE {
                        "55"
                    } else {
                        (pair.1 + 20).to_string()
                    },
                );
            } else if current.attributes & pair.0 != 0 && old.attributes & pair.0 == 0 {
                codes.push(pair.1.to_string());
            }
        }
        if current.fg != old.fg {
            codes.push(color_code(current.fg, false));
        }
        if current.bg != old.bg {
            codes.push(color_code(current.bg, true));
        }
        if codes.is_empty() {
            ""
        } else {
            "\u001b[" + codes.join(";") + "m"
        }
    }

    pub fn paint(self: Style, value: string, profile: Profile) -> string {
        self.transition(Style::new(), profile) + safe_text(value)
            + Style::new().transition(self, profile)
    }
}

fn color_code(value: Color, background: bool) -> string {
    let base = if background {
        40
    } else {
        30
    };
    match value {
        Default => (base + 9).to_string(),
        Indexed(index) if index < 8 => (base + index.to_isize()).to_string(),
        Indexed(index) if index < 16 => (base + 60 + index.to_isize() - 8).to_string(),
        Indexed(index) => f"{base + 8};5;{index}",
        Rgb(red, green, blue) => f"{base + 8};2;{red};{green};{blue}",
    }
}

pub fn safe_text(value: string) -> string {
    let result: Vec[string] = Vec::new();
    for character in value.chars() {
        if (character < '\u0020' && character != '\n' && character != '\t')
            || (character >= '\u007f' && character <= '\u009f') {
            result.push("�");
        } else {
            result.push(character.to_string());
        }
    }
    result.join("")
}
