package ansi;

use ecosystem::unicode_text;
use std::num;

#[derive(Debug, PartialEq, Eq)]
pub struct Hyperlink {
    url_value: string,
    id_value: string,
}

impl Hyperlink {
    pub fn new(url: string, id: string) -> Result[Hyperlink, Error] {
        if url.byte_len() > 4096 || id.byte_len() > 256 {
            return Result::Err(failure(0, "hyperlink limit exceeded"))
        }
        for value in[url, id] {
            for character in value.chars() {
                if character < '\u0020' || (character >= '\u007f' && character <= '\u009f') {
                    return Result::Err(failure(0, "control character in hyperlink"))
                }
            }
        }
        if id.contains(":") || id.contains(";") {
            return Result::Err(failure(0, "invalid hyperlink id"))
        }
        Result::Ok(Hyperlink { url_value: url, id_value: id })
    }

    pub fn url(self: Hyperlink) -> string {
        self.url_value
    }

    pub fn id(self: Hyperlink) -> string {
        self.id_value
    }

    pub fn open(self: Hyperlink) -> string {
        let parameters = if self.id_value == "" {
            ""
        } else {
            "id=" + self.id_value
        };
        "\u001b]8;" + parameters + ";" + self.url_value + "\u001b\\"
    }
}

impl ToString for Hyperlink {
    fn to_string(self: Hyperlink) -> string {
        self.url_value
    }
}

pub fn close_link() -> string {
    "\u001b]8;;\u001b\\"
}

#[derive(PartialEq, Eq)]
pub struct Span {
    pub text: string,
    pub style: Style,
    pub link: Option[Hyperlink],
}

impl Debug for Span {
    fn debug(self: Span) -> string {
        let link = self.link.map(|value| value.url()).unwrap_or("");
        "Span(" + self.text.debug() + ", " + self.style.debug() + ", " + link.debug() + ")"
    }
}

impl Span {
    pub fn new(text: string, style: Style) -> Span {
        Span { text: safe_text(text), style, link: Option::None }
    }

    pub fn plain(text: string) -> Span {
        Span::new(text, Style::new())
    }

    pub fn with_link(self: Span, link: Hyperlink) -> Span {
        Span { link: Option::Some(link), ..self }
    }
}

#[derive(PartialEq, Eq)]
pub struct StyledGrapheme {
    pub text: string,
    pub style: Style,
    pub link: Option[Hyperlink],
    pub width: isize,
}

impl Debug for StyledGrapheme {
    fn debug(self: StyledGrapheme) -> string {
        f"StyledGrapheme({self.text}, width={self.width})"
    }
}

pub struct StyledText {
    values: Vec[Span],
}

impl StyledText {
    pub fn new() -> StyledText {
        StyledText { values: Vec::new() }
    }

    pub fn plain(text: string) -> StyledText {
        let result = StyledText::new();
        result.push(Span::plain(text));
        result
    }

    pub fn from_spans(spans: Vec[Span]) -> StyledText {
        let result = StyledText::new();
        for span in spans {
            result.push(span);
        }
        result
    }

    pub fn push(self: StyledText, span: Span) -> () {
        let value = Span { text: safe_text(span.text), ..span };
        if value.text != "" {
            self.values.push(value);
        }
    }

    pub fn append(self: StyledText, other: StyledText) -> () {
        let copy = other.spans();
        for value in copy {
            self.push(value);
        }
    }

    pub fn spans(self: StyledText) -> Vec[Span] {
        self.values.copy()
    }

    pub fn snapshot(self: StyledText) -> StyledText {
        StyledText { values: self.values.copy() }
    }

    pub fn plain_text(self: StyledText) -> string {
        let pieces = Vec::new();
        for span in self.values {
            pieces.push(span.text);
        }
        pieces.join("")
    }

    pub fn render(self: StyledText, profile: Profile) -> string {
        self.render_with_links(profile, profile != Profile::Plain)
    }

    pub fn render_with_links(self: StyledText, profile: Profile, hyperlinks: bool) -> string {
        let parts: Vec[string] = Vec::new();
        let mut style = Style::new();
        let mut link: Option[Hyperlink] = Option::None;
        for span in self.values {
            let next = if hyperlinks && profile != Profile::Plain {
                span.link
            } else {
                Option::None
            };
            if link != next {
                if link.is_some() {
                    parts.push(close_link());
                }
                if let Some(value) = next {
                    parts.push(value.open());
                }
                link = next;
            }
            parts.push(span.style.transition(style, profile));
            parts.push(safe_text(span.text));
            style = span.style;
        }
        if link.is_some() {
            parts.push(close_link());
        }
        parts.push(Style::new().transition(style, profile));
        parts.join("")
    }

    pub fn graphemes(self: StyledText, options: unicode_text::WidthOptions) -> Vec[StyledGrapheme] {
        let result = Vec::new();
        let mut index = 0;
        let mut boundary = if self.values.is_empty() {
            0
        } else {
            self.values[0].text.byte_len()
        };
        for part in unicode_text::graphemes(self.plain_text()) {
            while index + 1 < self.values.len() && part.start >= boundary {
                index += 1;
                boundary += self.values[index].text.byte_len();
            }
            let span = self.values[index];
            result.push(
                StyledGrapheme {
                    text: part.text,
                    style: span.style,
                    link: span.link,
                    width: unicode_text::width_with(part.text, options),
                },
            );
        }
        result
    }

    pub fn width(self: StyledText) -> isize {
        self.width_with(unicode_text::WidthOptions::new())
    }

    pub fn width_with(self: StyledText, options: unicode_text::WidthOptions) -> isize {
        let mut column = 0;
        let mut maximum = 0;
        for part in self.graphemes(options) {
            if part.text == "\n" {
                if column > maximum {
                    maximum = column;
                }
                column = 0;
            } else if part.text == "\t" {
                column += 8 - column % 8;
            } else {
                column += part.width;
            }
        }
        if column > maximum {
            column
        } else {
            maximum
        }
    }

    pub fn truncate(self: StyledText, columns: isize) -> Result[StyledText, Error] {
        self.clip(0, columns)
    }

    pub fn clip(self: StyledText, start: isize, columns: isize) -> Result[StyledText, Error] {
        if start < 0 || columns < 0 || start > 16777216 || columns > 16777216 {
            return Result::Err(failure(0, "invalid clipping columns"))
        }
        let result = StyledText::new();
        let mut column = 0;
        let end = start + columns;
        for part in self.graphemes(unicode_text::WidthOptions::new()) {
            if part.text == "\n" {
                break
            }
            let width = if part.text == "\t" {
                8 - column % 8
            } else {
                part.width
            };
            if column >= end {
                break
            }
            if column >= start && column + width <= end {
                let text = if part.text == "\t" {
                    " ".repeat(width)
                } else {
                    part.text
                };
                result.push(Span { text, style: part.style, link: part.link });
            } else if column + width > start {
                let left = if column > start {
                    column
                } else {
                    start
                };
                let right = if column + width < end {
                    column + width
                } else {
                    end
                };
                result.push(
                    Span { text: " ".repeat(right - left), style: part.style, link: part.link },
                );
            }
            column += width;
        }
        Result::Ok(result)
    }

    pub fn wrap(self: StyledText, columns: isize) -> Result[Vec[StyledText], Error] {
        if columns < 1 || columns > 16777216 {
            return Result::Err(failure(0, "invalid wrap width"))
        }
        let lines = Vec::new();
        let mut line = StyledText::new();
        let mut column = 0;
        for part in self.graphemes(unicode_text::WidthOptions::new()) {
            if part.text == "\n" {
                lines.push(line);
                line = StyledText::new();
                column = 0;
                continue
            }
            let text = if part.text == "\t" {
                " ".repeat(8 - column % 8)
            } else {
                part.text
            };
            let width = if part.text == "\t" {
                text.byte_len()
            } else {
                part.width
            };
            if width > columns {
                if column > 0 {
                    lines.push(line);
                    line = StyledText::new();
                    column = 0;
                }
                if part.text == "\t" {
                    for _ in 0..width {
                        if column == columns {
                            lines.push(line);
                            line = StyledText::new();
                            column = 0;
                        }
                        line.push(Span { text: " ", style: part.style, link: part.link });
                        column += 1;
                    }
                } else {
                    line.push(Span { text: "�", style: part.style, link: part.link });
                    column = 1;
                }
            } else {
                if column + width > columns {
                    lines.push(line);
                    line = StyledText::new();
                    column = 0;
                }
                line.push(Span { text, style: part.style, link: part.link });
                column += width;
            }
        }
        lines.push(line);
        Result::Ok(lines)
    }
}

fn numeric(value: string) -> Result[isize, Error] {
    if value == "" {
        return Result::Ok(0)
    }
    if value.byte_len() > 8 {
        return Result::Err(failure(0, "SGR parameter too large"))
    }
    for character in value.chars() {
        if character < '0' || character > '9' {
            return Result::Err(failure(0, "invalid SGR parameter"))
        }
    }
    num::parse_int_structured(value).map_err(|_| failure(0, "invalid SGR number"))
}

fn channel(value: string) -> Result[u8, Error] {
    let number = numeric(value)?;
    if value == "" || number > 255 {
        Result::Err(failure(0, "color channel outside 0..255"))
    } else {
        Result::Ok(number.to_u8())
    }
}

pub fn apply_sgr(style: Style, parameters: string) -> Result[Style, Error] {
    if parameters.byte_len() > 8192 {
        return Result::Err(failure(0, "SGR limit exceeded"))
    }
    let groups = parameters.split(";");
    if groups.len() > 128 {
        return Result::Err(failure(0, "SGR parameter limit exceeded"))
    }
    let mut result = style;
    let mut index = 0;
    while index < groups.len() {
        let fields = groups[index].split(":");
        let code = numeric(fields[0])?;
        if code == 38 || code == 48 {
            let mut value = Color::Default;
            if fields.len() > 1 {
                let mode = numeric(fields[1])?;
                if mode == 5 && fields.len() == 3 {
                    value = Color::Indexed(channel(fields[2])?);
                } else if mode == 2 && (fields.len() == 5 || fields.len() == 6) {
                    let start = fields.len() - 3;
                    if fields.len() == 6 && fields[2] != "" && fields[2] != "0" {
                        return Result::Err(failure(0, "unsupported RGB color space"))
                    }
                    value = Color::Rgb(
                        channel(fields[start])?,
                        channel(fields[start + 1])?,
                        channel(fields[start + 2])?,
                    );
                } else {
                    return Result::Err(failure(0, "invalid colon color parameters"))
                }
            } else {
                if index + 2 >= groups.len() {
                    return Result::Err(failure(0, "truncated color parameters"))
                }
                let mode = numeric(groups[index + 1])?;
                if mode == 5 {
                    value = Color::Indexed(channel(groups[index + 2])?);
                    index += 2;
                } else if mode == 2 && index + 4 < groups.len() {
                    value = Color::Rgb(
                        channel(groups[index + 2])?,
                        channel(groups[index + 3])?,
                        channel(groups[index + 4])?,
                    );
                    index += 4;
                } else {
                    return Result::Err(failure(0, "invalid extended color parameters"))
                }
            }
            result = if code == 38 {
                result.foreground(value)
            } else {
                result.background(value)
            };
        } else if code == 0 {
            result = Style::new();
        } else if code == 1 {
            result = result.with_attribute(BOLD, true);
        } else if code == 2 {
            result = result.with_attribute(DIM, true);
        } else if code == 3 {
            result = result.with_attribute(ITALIC, true);
        } else if code == 4 {
            let enabled = if fields.len() > 1 {
                numeric(fields[1])? != 0
            } else {
                true
            };
            result = result.with_attribute(UNDERLINE, enabled);
        } else if code == 5 || code == 6 {
            result = result.with_attribute(BLINK, true);
        } else if code == 7 {
            result = result.with_attribute(REVERSE, true);
        } else if code == 8 {
            result = result.with_attribute(HIDDEN, true);
        } else if code == 9 {
            result = result.with_attribute(STRIKE, true);
        } else if code == 21 {
            result = result.with_attribute(UNDERLINE, true);
        } else if code == 22 {
            result = result.with_attribute(BOLD | DIM, false);
        } else if code == 23 {
            result = result.with_attribute(ITALIC, false);
        } else if code == 24 {
            result = result.with_attribute(UNDERLINE, false);
        } else if code == 25 {
            result = result.with_attribute(BLINK, false);
        } else if code == 27 {
            result = result.with_attribute(REVERSE, false);
        } else if code == 28 {
            result = result.with_attribute(HIDDEN, false);
        } else if code == 29 {
            result = result.with_attribute(STRIKE, false);
        } else if code >= 30 && code <= 37 {
            result = result.foreground(Color::Indexed((code - 30).to_u8()));
        } else if code == 39 {
            result = result.foreground(Color::Default);
        } else if code >= 40 && code <= 47 {
            result = result.background(Color::Indexed((code - 40).to_u8()));
        } else if code == 49 {
            result = result.background(Color::Default);
        } else if code == 53 {
            result = result.with_attribute(OVERLINE, true);
        } else if code == 55 {
            result = result.with_attribute(OVERLINE, false);
        } else if code >= 90 && code <= 97 {
            result = result.foreground(Color::Indexed((code - 90 + 8).to_u8()));
        } else if code >= 100 && code <= 107 {
            result = result.background(Color::Indexed((code - 100 + 8).to_u8()));
        }
        index += 1;
    }
    Result::Ok(result)
}

pub fn parse(value: string) -> Result[StyledText, Error] {
    let result = StyledText::new();
    let mut style = Style::new();
    let mut link: Option[Hyperlink] = Option::None;
    for token in parse_tokens(value)? {
        match token {
            Text(text) => result.push(Span { text, style, link }),
            Control(10) => result.push(Span { text: "\n", style, link }),
            Control(9) => result.push(Span { text: "\t", style, link }),
            Csi { parameters, intermediates, final_byte: 109 } if intermediates == "" => {
                style = apply_sgr(style, parameters)?;
            },
            Osc(body) if body.starts_with("8;") => {
                let Some((parameters, url)) = body.byte_slice(2, body.byte_len()).split_once(";") else {
                    return Result::Err(failure(0, "malformed OSC 8"))
                };
                let mut id = "";
                for parameter in parameters.split(":") {
                    if parameter.starts_with("id=") {
                        id = parameter.byte_slice(3, parameter.byte_len());
                    }
                }
                link = if url == "" {
                    Option::None
                } else {
                    Option::Some(Hyperlink::new(url, id)?)
                };
            },
            _ => (),
        }
    }
    Result::Ok(result)
}
