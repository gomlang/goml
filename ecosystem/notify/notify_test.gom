package notify;

use std::bytes::endian;
use std::fs;
use std::io;
use std::num;
use std::path;
use std::os::linux::syscall;
use std::os::linux::syscall::{Arg};
use std::utf8;
use std::task;
use std::testing;
use std::time;

fn put(data: Vec[byte], offset: isize, value: u32) -> () {
    testing::expect_ok(
        endian::write_u32(data.as_mut_slice(), offset, value, endian::Endian::Little),
        "write record",
    );
}

#[test]
fn decodes_padded_names_and_rejects_malformed_records() -> () {
    let data = zeroes(36);
    put(data, 0, 7);
    put(data, 4, CREATE | IS_DIR);
    put(data, 8, 123);
    put(data, 12, 4);
    data[16] = b'a';
    data[18] = 255;
    put(data, 20, 0xffffffff);
    put(data, 24, Q_OVERFLOW);
    let events = testing::expect_ok(decode(data.as_slice()), "decode records");
    testing::assert_eq(events.len(), 2);
    testing::assert_eq(events[0].wd, 7);
    testing::assert_eq(events[0].name, "a");
    testing::assert_eq(events[0].mask, CREATE | IS_DIR);
    testing::assert_eq(events[0].cookie, 123);
    testing::assert_eq(events[1].wd, -1);
    testing::assert_eq(events[1].name, "");
    testing::assert_err(decode(data.slice(0, 15)));
    testing::assert_err(decode(data.slice(0, 19)));
    data[16] = 255;
    testing::assert_eq(
        testing::expect_err(decode(data.as_slice()), "invalid UTF-8").kind(),
        io::ErrorKind::InvalidData,
    );
    for index in 16..20 {
        data[index] = b'a';
    }
    testing::assert_err(decode(data.as_slice()));
    data[16] = b'/';
    data[17] = 0;
    testing::assert_err(decode(data.as_slice()));
    put(data, 12, 0xffffffff);
    testing::assert_err(decode(data.as_slice()));
    testing::assert_eq(testing::expect_ok(decode(zeroes(0).as_slice()), "empty").len(), 0);
}

fn temporary(name: string) -> string {
    let result = path::join(
        "/tmp",
        "goml-notify-internal-" + name + "-"
            + time::SystemTime::now().unix_nanoseconds().to_string(),
    );
    testing::expect_ok(fs::create_dir(result), "temporary directory");
    result
}

fn wd_for(state: State, name: string) -> i32 {
    for (wd, directory) in state.watches.entries() {
        if directory == name {
            return wd;
        }
    }
    testing::fail("missing watch: " + name);
    -1
}

fn raw(wd: i32, mask: u32, cookie: u32, name: string) -> RawEvent {
    RawEvent { wd, mask, cookie, name }
}

#[test]
fn matches_renames_across_batches_and_expires_unmatched_subtrees() -> () {
    let root = temporary("rename");
    defer testing::expect_ok(fs::remove_dir_all(root), "cleanup");
    testing::expect_ok(fs::create_dir_all(path::join(root, "old/child")), "tree");
    testing::expect_ok(fs::create_dir(path::join(root, "older")), "sibling");
    let watcher = testing::expect_ok(watch_recursive(root), "watch");
    let state = testing::expect_some(watcher.state.recv(), "state");
    defer testing::expect_ok(close_state(state), "close");
    let root_wd = wd_for(state, root);
    let child_wd = wd_for(state, path::join(root, "old/child"));
    testing::expect_ok(fs::rename(path::join(root, "old"), path::join(root, "new")), "rename");
    let first = testing::expect_ok(
        process_events(state, Vec::from_array([raw(root_wd, MOVED_FROM | IS_DIR, 23, "old")])),
        "from batch",
    );
    testing::assert_eq(first.len(), 1);
    testing::assert_eq(state.moves.len(), 1);
    let uncertain = testing::expect_ok(
        process_events(state, Vec::from_array([raw(child_wd, MODIFY, 0, "uncertain")])),
        "pending events",
    );
    testing::assert_eq(uncertain.len(), 0);
    let second = testing::expect_ok(
        process_events(
            state,
            Vec::from_array(
                [raw(root_wd, MOVED_TO | IS_DIR, 23, "new"), raw(child_wd, CREATE, 0, "file")],
            ),
        ),
        "to batch",
    );
    testing::assert_eq(second.len(), 2);
    testing::assert(second[0].rescan);
    testing::assert_eq(second[1].path, path::join(root, "new/child/file"));
    testing::assert_eq(state.moves.len(), 0);
    testing::assert_eq(wd_for(state, path::join(root, "new/child")), child_wd);
    let _ = wd_for(state, path::join(root, "older"));
    testing::expect_ok(
        process_events(state, Vec::from_array([raw(root_wd, MOVED_FROM | IS_DIR, 24, "new")])),
        "move out",
    );
    time::sleep(time::Duration::from_milliseconds(110));
    testing::expect_ok(expire_moves(state), "expire move");
    testing::assert_eq(state.moves.len(), 0);
    testing::assert_eq(state.watches.len(), 2);
    testing::assert(!state.watches.contains(child_wd));
}

#[test]
fn overflow_rebuilds_watches_and_discards_old_descriptor_events() -> () {
    let root = temporary("overflow");
    defer testing::expect_ok(fs::remove_dir_all(root), "cleanup");
    let watcher = testing::expect_ok(watch_recursive(root), "watch");
    let state = testing::expect_some(watcher.state.recv(), "state");
    defer testing::expect_ok(close_state(state), "close");
    let root_wd = wd_for(state, root);
    testing::expect_ok(fs::create_dir_all(path::join(root, "lost/nested")), "lost directory");
    state.moves.set(
        99,
        PendingMove { path: path::join(root, "stale"), since: time::Instant::now() },
    );
    let events = testing::expect_ok(
        process_events(
            state,
            Vec::from_array([raw(-1, Q_OVERFLOW, 0, ""), raw(root_wd, CREATE, 0, "stale-event")]),
        ),
        "overflow",
    );
    testing::assert_eq(events.len(), 1);
    testing::assert_eq(events[0].path, root);
    testing::assert(events[0].rescan && events[0].has(Q_OVERFLOW));
    testing::assert_eq(state.moves.len(), 0);
    testing::assert_eq(state.watches.len(), 3);
    let _ = wd_for(state, path::join(root, "lost/nested"));
    let file = path::join(root, "lost/nested/file");
    testing::expect_ok(fs::write_file_structured(file, "data"), "write");
    let found = Ref::new(false);
    for event in testing::expect_ok(read_batch(state), "rebuilt watch events") {
        if event.path == file && event.has(CREATE) {
            found.set(true);
        }
    }
    testing::assert(found.get());
}

#[test]
fn copied_watchers_serialize_read_and_close() -> () {
    let root = temporary("close");
    defer testing::expect_ok(fs::remove_dir_all(root), "cleanup");
    let watcher = testing::expect_ok(watch(root), "watch");
    let copy = watcher;
    task::scope(
        |scope: task::Scope| {
            let ready: Channel[()] = Channel::new(1);
            let reader = scope.spawn(
                |_: task::CancelToken| {
                    ready.send(());
                    watcher.read(time::Duration::from_seconds(5))
                },
            );
            let _ = ready.recv();
            testing::expect_ok(copy.close(), "close");
            testing::assert_err(reader.join());
        },
    );
    testing::expect_ok(watcher.close(), "idempotent close");
}

#[test]
fn invalid_utf8_event_closes_the_watcher() -> () {
    let root = temporary("invalid-name");
    defer testing::expect_ok(fs::remove_dir_all(root), "cleanup");
    let watcher = testing::expect_ok(watch(root), "watch");
    defer testing::expect_ok(watcher.close(), "close");
    let name = utf8::encode(root + "/");
    name.push(255);
    name.push(0);
    let result = testing::expect_ok(
        syscall::syscall6_with_buffers(
            syscall::SYS_OPENAT,
            [
                Arg::Word((-100).to_usize()),
                Arg::Buffer(name.as_mut_slice()),
                Arg::Word(0x80041),
                Arg::Word(0o600),
                Arg::Word(0),
                Arg::Word(0),
            ],
        ),
        "open syscall",
    );
    testing::assert_eq(result.errno, 0);
    testing::expect_ok(close_fd(result.r1), "close file");
    testing::assert_eq(
        testing::expect_err(watcher.try_read(), "invalid event").kind(),
        io::ErrorKind::InvalidData,
    );
    testing::assert_eq(
        testing::expect_err(watcher.try_read(), "closed after error").kind(),
        io::ErrorKind::InvalidInput,
    );
}

fn wait_for(watcher: Watcher, name: string, mask: u32) -> Event {
    let started = time::Instant::now();
    loop {
        for event in testing::expect_ok(
            watcher.read(time::Duration::from_milliseconds(20)),
            "read events",
        ) {
            if event.path == name && event.has(mask) {
                return event;
            }
        }
        if started.elapsed().as_seconds() >= 3 {
            testing::fail("missing event for " + name);
        }
    }
}

#[test]
fn discovers_relocations_before_their_rename_events() -> () {
    let root = temporary("early-relocation");
    defer testing::expect_ok(fs::remove_dir_all(root), "cleanup");
    testing::expect_ok(fs::create_dir_all(root + "/old/child"), "existing tree");
    let watcher = testing::expect_ok(watch_recursive(root), "watch");
    defer testing::expect_ok(watcher.close(), "close");
    testing::expect_ok(fs::create_dir(root + "/new"), "new parent");
    testing::expect_ok(fs::rename(root + "/old", root + "/new/old"), "relocate before reading");
    let events = testing::expect_ok(
        watcher.read(time::Duration::from_seconds(1)),
        "discover relocation",
    );
    let rescanned = Ref::new(false);
    for event in events {
        if event.path == root && event.rescan {
            rescanned.set(true);
        }
    }
    testing::assert(rescanned.get());
    testing::assert(!watcher.is_closed());
    let name = root + "/new/old/child/after";
    testing::expect_ok(fs::write_file_structured(name, "data"), "write after relocation");
    let _ = wait_for(watcher, name, CREATE);
}

#[test]
fn reusing_a_pending_move_path_keeps_the_new_tree_watched() -> () {
    let root = temporary("reuse-path");
    defer testing::expect_ok(fs::remove_dir_all(root), "cleanup");
    let outside = temporary("reuse-outside");
    defer testing::expect_ok(fs::remove_dir_all(outside), "outside cleanup");
    testing::expect_ok(fs::create_dir_all(root + "/node/old"), "existing tree");
    let watcher = testing::expect_ok(watch_recursive(root), "watch");
    defer testing::expect_ok(watcher.close(), "close");
    testing::expect_ok(fs::rename(root + "/node", outside + "/node"), "move out");
    testing::expect_ok(fs::create_dir_all(root + "/node/new"), "reuse path");
    let _ = testing::expect_ok(watcher.read(time::Duration::from_seconds(1)), "new tree");
    let _ = testing::expect_ok(
        watcher.read(time::Duration::from_milliseconds(150)),
        "expire old move",
    );
    testing::expect_ok(
        fs::write_file_structured(outside + "/node/old/ignored", "data"),
        "outside write",
    );
    testing::assert(testing::expect_ok(watcher.try_read(), "outside ignored").is_empty());
    let name = root + "/node/new/observed";
    testing::expect_ok(fs::write_file_structured(name, "data"), "new tree write");
    let _ = wait_for(watcher, name, CREATE);
}

#[test]
fn file_watches_and_event_filters_preserve_control_events() -> () {
    let root = temporary("files");
    defer testing::expect_ok(fs::remove_dir_all(root), "cleanup");
    let name = root + "/file";
    testing::expect_ok(fs::write_file_structured(name, "initial"), "file");
    let watcher = testing::expect_ok(
        watch_with(name, Options::new().with_mask(MODIFY)),
        "file watch",
    );
    defer testing::expect_ok(watcher.close(), "close");
    testing::expect_ok(fs::write_file_structured(name, "changed"), "change");
    let event = wait_for(watcher, name, MODIFY);
    testing::assert(!event.is_dir());
    let _ = testing::expect_ok(watcher.try_read(), "filtered close write");
    testing::expect_ok(fs::atomic_write(name, "replacement"), "atomic replacement");
    let _ = wait_for(watcher, name, DELETE_SELF);
    testing::assert(watcher.is_closed());
    let recursive = testing::expect_ok(
        watch_with(root, Options::new().with_recursive(true).with_mask(MODIFY)),
        "filtered recursive watch",
    );
    defer testing::expect_ok(recursive.close(), "close recursive");
    testing::expect_ok(fs::create_dir(root + "/child"), "child");
    testing::assert(wait_for(recursive, root + "/child", CREATE).rescan);
    testing::expect_ok(fs::write_file_structured(root + "/child/file", "data"), "child file");
    let _ = wait_for(recursive, root + "/child/file", MODIFY);
    testing::assert_err(watch_with(root, Options::new().with_mask(0)));
    testing::assert_err(watch_with(root, Options::new().with_mask(IS_DIR)));
    testing::assert_err(watch_recursive(name));
}

#[test]
fn cancellation_stops_waiting_without_closing_the_watcher() -> () {
    let root = temporary("cancel");
    defer testing::expect_ok(fs::remove_dir_all(root), "cleanup");
    let watcher = testing::expect_ok(watch(root), "watch");
    defer testing::expect_ok(watcher.close(), "close");
    task::scope(
        |scope: task::Scope| {
            let ready: Channel[()] = Channel::new(1);
            let waiting = scope.spawn(
                |cancel: task::CancelToken| {
                    ready.send(());
                    watcher.read_with(cancel, time::Duration::from_seconds(5))
                },
            );
            let _ = ready.recv();
            time::sleep(time::Duration::from_milliseconds(20));
            scope.cancel();
            match testing::expect_ok(waiting.join(), "cancel read") {
                task::WaitResult::Cancelled => (),
                task::WaitResult::Completed(_) => testing::fail("expected cancellation"),
            }
        },
    );
    testing::assert(!watcher.is_closed());
    testing::expect_ok(fs::write_file_structured(root + "/after", "data"), "write after cancel");
    let _ = wait_for(watcher, root + "/after", CREATE);
}

#[test]
fn closing_and_cancelling_backpressured_subscriptions_joins_workers() -> () {
    for cancel_scope in Vec::from_array([false, true]) {
        let released = Ref::new(0);
        task::scope(
            |scope: task::Scope| {
                let started: Channel[()] = Channel::new(1);
                let source_closed: Channel[()] = Channel::new(0);
                let subscription = testing::expect_ok(
                    subscribe_source(
                        scope,
                        0,
                        || {
                            started.send(());
                            Result::Ok(Vec::from_array([1]))
                        },
                        || {
                            released.set(released.get() + 1);
                            Result::Ok(())
                        },
                        || false,
                        source_closed.receiver(),
                    ),
                    "subscription",
                );
                let _ = started.recv();
                if cancel_scope {
                    scope.cancel();
                    select {
                        recv(subscription.done()) as _ => (),
                        recv(time::after(time::Duration::from_seconds(2))) as _ => testing::fail(
                            "cancellation did not stop a blocked producer",
                        ),
                    }
                }
                if !cancel_scope {
                    let first = scope.spawn(|_: task::CancelToken| subscription.close());
                    let second = scope.spawn(|_: task::CancelToken| subscription.close());
                    testing::expect_ok(first.join(), "first concurrent close");
                    testing::expect_ok(second.join(), "second concurrent close");
                }
                testing::expect_ok(subscription.close(), "close subscription");
                testing::expect_ok(subscription.close(), "close twice");
                testing::assert(subscription.events().recv().is_none());
            },
        );
        testing::assert_eq(released.get(), 1);
    }
}

#[test]
fn background_subscription_registers_subtrees_before_delivery() -> () {
    let root = temporary("background");
    defer testing::expect_ok(fs::remove_dir_all(root), "cleanup");
    let watcher = testing::expect_ok(watch_recursive(root), "watch");
    task::scope(
        |scope: task::Scope| {
            let subscription = testing::expect_ok(watcher.subscribe(scope, 0), "subscribe");
            testing::expect_ok(fs::create_dir(root + "/child"), "child");
            let started = time::Instant::now();
            loop {
                let state = testing::expect_some(watcher.state.recv(), "state");
                let found = Ref::new(false);
                for (_, name) in state.watches.entries() {
                    if name == root + "/child" {
                        found.set(true);
                    }
                }
                watcher.state.send(state);
                if found.get() {
                    break;
                }
                testing::assert(started.elapsed().as_seconds() < 3);
                time::sleep(time::Duration::from_milliseconds(1));
            }
            testing::expect_ok(
                fs::write_file_structured(root + "/child/file", "data"),
                "nested write",
            );
            let found = Ref::new(false);
            while !found.get() {
                let batch = select {
                    recv(subscription.events()) as value => testing::expect_some(
                        value,
                        "subscription remains open",
                    ),
                    recv(time::after(time::Duration::from_seconds(3))) as _ => Result::Err(
                        error(io::ErrorKind::TimedOut, "subscription timed out"),
                    ),
                };
                for event in testing::expect_ok(batch, "subscription batch") {
                    if event.path == root + "/child/file" && event.has(CREATE) {
                        found.set(true);
                    }
                }
            }
            testing::expect_ok(subscription.close(), "close subscription");
        },
    );
    testing::assert(watcher.is_closed());
}

fn has_notice(notices: Vec[Notice], expected: WatchId, name: string, mask: u32) -> bool {
    for notice in notices {
        if let Notice::Event(id, event) = notice {
            if id == expected && event.path == name && event.has(mask) {
                return true;
            }
        }
    }
    false
}

#[test]
fn watch_sets_isolate_overlaps_errors_and_removal() -> () {
    let root = temporary("set");
    defer testing::expect_ok(fs::remove_dir_all(root), "cleanup");
    testing::expect_ok(fs::create_dir(root + "/child"), "child");
    let set = WatchSet::new();
    defer testing::expect_ok(set.close(), "close set");
    let first = testing::expect_ok(set.add_recursive(root), "recursive root");
    let second = testing::expect_ok(set.add(root + "/child"), "overlapping root");
    testing::assert(first != second);
    testing::assert_err(set.add(root + "/missing"));
    testing::assert_eq(testing::expect_ok(set.watches(), "list watches").len(), 2);
    let name = root + "/child/file";
    testing::expect_ok(fs::write_file_structured(name, "data"), "write");
    let notices = testing::expect_ok(set.read(time::Duration::from_seconds(1)), "read both");
    testing::assert(has_notice(notices, first, name, CREATE));
    testing::assert(has_notice(notices, second, name, CREATE));
    testing::assert(testing::expect_ok(set.remove(first), "remove first"));
    testing::assert(!testing::expect_ok(set.remove(first), "remove absent"));
    testing::expect_ok(fs::write_file_structured(name, "changed"), "change");
    let notices = testing::expect_ok(set.read(time::Duration::from_seconds(1)), "read remaining");
    testing::assert(!has_notice(notices, first, name, MODIFY));
    testing::assert(has_notice(notices, second, name, MODIFY));
    let surviving = testing::expect_ok(set.add(root), "surviving root");
    testing::expect_ok(fs::remove_dir_all(root + "/child"), "remove child root");
    let notices = testing::expect_ok(set.read(time::Duration::from_seconds(1)), "terminal events");
    let removed = Ref::new(false);
    for notice in notices {
        if let Notice::Removed(id) = notice {
            if id == second {
                removed.set(true);
            }
        }
    }
    testing::assert(removed.get());
    testing::assert_eq(testing::expect_ok(set.watches(), "one watch left").len(), 1);
    testing::expect_ok(fs::write_file_structured(root + "/alive", "data"), "write surviving");
    testing::assert(
        has_notice(
            testing::expect_ok(set.read(time::Duration::from_seconds(1)), "surviving events"),
            surviving,
            root + "/alive",
            CREATE,
        ),
    );
    testing::expect_ok(set.close(), "close");
    testing::assert_err(set.add(root));
    testing::assert_err(set.try_read());
    testing::expect_ok(set.close(), "close again");
}

#[test]
fn real_kernel_overflow_rebuilds_recursive_coverage() -> () {
    let root = temporary("kernel-overflow");
    defer testing::expect_ok(fs::remove_dir_all(root), "cleanup");
    let limit = testing::expect_ok(
        num::parse_int_structured(
            testing::expect_ok(
                fs::read_file_structured("/proc/sys/fs/inotify/max_queued_events"),
                "queue limit",
            ).trim(),
        ),
        "parse queue limit",
    );
    if limit > 131072 {
        return;
    }
    let watcher = testing::expect_ok(watch_recursive(root), "watch");
    defer testing::expect_ok(watcher.close(), "close");
    for _ in 0..limit / 2 + 64 {
        testing::expect_ok(fs::write_file_structured(root + "/hot", "data"), "fill queue");
    }
    testing::expect_ok(fs::create_dir_all(root + "/lost/nested"), "unreported directory");
    let overflow = Ref::new(false);
    let started = time::Instant::now();
    while !overflow.get() {
        let events = testing::expect_ok(watcher.try_read(), "drain overflow");
        testing::assert(!events.is_empty());
        for event in events {
            if event.has(Q_OVERFLOW) {
                testing::assert(event.rescan && event.path == root);
                overflow.set(true);
            }
        }
        testing::assert(started.elapsed().as_seconds() < 5);
    }
    let name = root + "/lost/nested/after-overflow";
    testing::expect_ok(fs::write_file_structured(name, "data"), "rebuilt tree");
    let _ = wait_for(watcher, name, CREATE);
}

#[test]
fn repeated_renames_keep_descendant_paths_current() -> () {
    let root = temporary("rename-stress");
    defer testing::expect_ok(fs::remove_dir_all(root), "cleanup");
    testing::expect_ok(fs::create_dir_all(root + "/a/deep/child"), "tree");
    let watcher = testing::expect_ok(watch_recursive(root), "watch");
    defer testing::expect_ok(watcher.close(), "close");
    for _ in 0..100 {
        testing::expect_ok(fs::rename(root + "/a", root + "/b"), "rename forward");
        testing::expect_ok(fs::rename(root + "/b", root + "/a"), "rename back");
    }
    let _ = testing::expect_ok(watcher.read(time::Duration::from_milliseconds(10)), "rename queue");
    while !testing::expect_ok(watcher.try_read(), "drain moves").is_empty() {}
    let name = root + "/a/deep/child/final";
    testing::expect_ok(fs::write_file_structured(name, "data"), "write final location");
    let _ = wait_for(watcher, name, CREATE);
}

#[test]
fn watch_set_errors_are_local_and_closed_roots_release_resources() -> () {
    let root = temporary("set-errors");
    defer testing::expect_ok(fs::remove_dir_all(root), "cleanup");
    testing::expect_ok(fs::create_dir(root + "/bad"), "bad root");
    testing::expect_ok(fs::create_dir(root + "/good"), "good root");
    let set = WatchSet::new();
    defer testing::expect_ok(set.close(), "close set");
    let bad = testing::expect_ok(set.add(root + "/bad"), "add bad");
    let good = testing::expect_ok(set.add(root + "/good"), "add good");
    let name = utf8::encode(root + "/bad/");
    name.push(255);
    name.push(0);
    let opened = testing::expect_ok(
        syscall::syscall6_with_buffers(
            syscall::SYS_OPENAT,
            [
                Arg::Word((-100).to_usize()),
                Arg::Buffer(name.as_mut_slice()),
                Arg::Word(0x80041),
                Arg::Word(0o600),
                Arg::Word(0),
                Arg::Word(0),
            ],
        ),
        "invalid filename",
    );
    testing::assert_eq(opened.errno, 0);
    testing::expect_ok(close_fd(opened.r1), "close file");
    testing::expect_ok(fs::write_file_structured(root + "/good/file", "data"), "good write");
    let notices = testing::expect_ok(set.read(time::Duration::from_seconds(1)), "read with error");
    testing::assert(has_notice(notices, good, root + "/good/file", CREATE));
    let errors = Ref::new(0);
    for notice in notices {
        if let Notice::Error(id, value) = notice {
            testing::assert(id == bad);
            testing::assert_eq(value.kind(), io::ErrorKind::InvalidData);
            errors.set(errors.get() + 1);
        }
    }
    testing::assert_eq(errors.get(), 1);
    testing::assert_eq(testing::expect_ok(set.watches(), "good remains").len(), 1);
    testing::assert(!set.is_closed());
}

#[test]
fn failed_registration_and_repeated_close_do_not_leak_descriptors() -> () {
    let root = temporary("fd-leaks");
    defer testing::expect_ok(fs::remove_dir_all(root), "cleanup");
    time::sleep(time::Duration::from_milliseconds(1));
    let before = testing::expect_ok(fs::read_dir("/proc/self/fd"), "initial descriptors").len();
    for _ in 0..64 {
        testing::assert_err(watch(root + "/missing"));
        let set = WatchSet::new();
        let id = testing::expect_ok(set.add_recursive(root), "register");
        testing::assert_err(set.add_recursive(root + "/missing"));
        testing::assert(testing::expect_ok(set.remove(id), "remove"));
        testing::expect_ok(set.close(), "close set");
        testing::expect_ok(set.close(), "close set again");
    }
    let after = testing::expect_ok(fs::read_dir("/proc/self/fd"), "final descriptors").len();
    testing::assert_eq(after, before);
}

#[test]
fn closing_a_watcher_unblocks_background_delivery() -> () {
    let root = temporary("close-source");
    defer testing::expect_ok(fs::remove_dir_all(root), "cleanup");
    let watcher = testing::expect_ok(watch_recursive(root), "watch");
    task::scope(
        |scope: task::Scope| {
            let subscription = testing::expect_ok(watcher.subscribe(scope, 0), "subscribe");
            testing::expect_ok(fs::create_dir(root + "/child"), "child");
            let started = time::Instant::now();
            loop {
                let state = testing::expect_some(watcher.state.recv(), "state");
                let registered = state.watches.len() == 2;
                watcher.state.send(state);
                if registered {
                    break;
                }
                testing::assert(started.elapsed().as_seconds() < 3);
                time::sleep(time::Duration::from_milliseconds(1));
            }
            testing::expect_ok(watcher.close(), "close source");
            select {
                recv(subscription.done()) as _ => (),
                recv(time::after(time::Duration::from_seconds(2))) as _ => testing::fail(
                    "source close left producer blocked",
                ),
            }
            testing::expect_ok(subscription.close(), "join subscription");
            testing::assert(subscription.events().recv().is_none());
        },
    );
}

#[test]
fn failed_subscriptions_leave_the_source_available() -> () {
    let root = temporary("failed-subscription");
    defer testing::expect_ok(fs::remove_dir_all(root), "cleanup");
    let watcher = testing::expect_ok(watch(root), "watch");
    defer testing::expect_ok(watcher.close(), "close");
    task::scope(
        |scope: task::Scope| {
            testing::assert_err(watcher.subscribe(scope, -1));
            scope.cancel();
            testing::assert_err(watcher.subscribe(scope, 1));
        },
    );
    testing::assert(!watcher.is_closed());
    testing::expect_ok(fs::write_file_structured(root + "/usable", "data"), "write");
    let _ = wait_for(watcher, root + "/usable", CREATE);
}

#[test]
fn empty_watch_sets_cancel_and_accept_new_registrations() -> () {
    let root = temporary("empty-set");
    defer testing::expect_ok(fs::remove_dir_all(root), "cleanup");
    let set = WatchSet::new();
    defer testing::expect_ok(set.close(), "close set");
    task::scope(
        |scope: task::Scope| {
            let ready: Channel[()] = Channel::new(1);
            let reader = scope.spawn(
                |cancel: task::CancelToken| {
                    ready.send(());
                    set.read_with(cancel, time::Duration::from_seconds(5))
                },
            );
            let _ = ready.recv();
            time::sleep(time::Duration::from_milliseconds(20));
            scope.cancel();
            match testing::expect_ok(reader.join(), "cancel empty set") {
                task::WaitResult::Cancelled => (),
                task::WaitResult::Completed(_) => testing::fail("expected cancelled wait"),
            }
        },
    );
    testing::assert(!set.is_closed());
    let id = testing::expect_ok(set.add(root), "add after cancellation");
    testing::expect_ok(fs::write_file_structured(root + "/file", "data"), "write");
    testing::assert(
        has_notice(
            testing::expect_ok(set.read(time::Duration::from_seconds(1)), "read new registration"),
            id,
            root + "/file",
            CREATE,
        ),
    );
}

#[test]
fn ignore_prunes_subtrees_and_preserves_root_control_events() -> () {
    let root = temporary("ignore-prune");
    defer testing::expect_ok(fs::remove_dir_all(root), "cleanup");
    testing::expect_ok(fs::create_dir_all(path::join(root, "cache/deep")), "ignored subtree");
    testing::expect_ok(fs::create_dir_all(path::join(root, "src/nested")), "visible subtree");
    let names = Vec::from_array(["cache"]);
    let options = Options::new().with_ignored_names(names).with_recursive(true).with_mask(MODIFY).with_ignore(
        |name, directory| !directory && name.ends_with(".tmp"),
    );
    names.push("src");
    let state = testing::expect_ok(open_state(root, options), "open watcher");
    defer testing::expect_ok(close_state(state), "close watcher");
    testing::assert_eq(state.watches.len(), 3);
    let root_wd = wd_for(state, root);
    let events = testing::expect_ok(
        process_events(
            state,
            Vec::from_array(
                [
                    raw(root_wd, MODIFY, 0, "ignored.tmp"),
                    raw(root_wd, MODIFY, 0, "visible"),
                    raw(root_wd, CREATE | IS_DIR, 0, "cache"),
                ],
            ),
        ),
        "filter events",
    );
    testing::assert_eq(events.len(), 1);
    testing::assert_eq(events[0].path, path::join(root, "visible"));
    let _ = testing::expect_ok(
        process_events(state, Vec::from_array([raw(-1, Q_OVERFLOW, 0, "")])),
        "rebuild",
    );
    testing::assert_eq(state.watches.len(), 3);
    let all_ignored = testing::expect_ok(
        open_state(root, Options::new().with_recursive(true).with_ignore(|_, _| true)),
        "ignore all children",
    );
    defer testing::expect_ok(close_state(all_ignored), "close");
    testing::assert_eq(all_ignored.watches.len(), 1);
    let events = testing::expect_ok(
        process_events(
            all_ignored,
            Vec::from_array([raw(wd_for(all_ignored, root), DELETE_SELF, 0, "")]),
        ),
        "root lifecycle",
    );
    testing::assert_eq(events.len(), 1);
    testing::assert(all_ignored.fd.get().is_none());
}

#[test]
fn ignore_handles_moves_across_visibility_boundaries() -> () {
    let root = temporary("ignore-moves");
    defer testing::expect_ok(fs::remove_dir_all(root), "cleanup");
    testing::expect_ok(fs::create_dir_all(path::join(root, "visible/nested")), "subtree");
    let state = testing::expect_ok(
        open_state(
            root,
            Options::new().with_recursive(true).with_ignored_names(Vec::from_array(["ignored"])),
        ),
        "open",
    );
    defer testing::expect_ok(close_state(state), "close");
    let root_wd = wd_for(state, root);
    let old_child = wd_for(state, path::join(root, "visible/nested"));
    testing::expect_ok(fs::rename(path::join(root, "visible"), path::join(root, "ignored")), "hide");
    let events = testing::expect_ok(
        process_events(
            state,
            Vec::from_array(
                [
                    raw(root_wd, MOVED_FROM | IS_DIR, 81, "visible"),
                    raw(root_wd, MOVED_TO | IS_DIR, 81, "ignored"),
                    raw(old_child, MODIFY, 0, "hidden-event"),
                ],
            ),
        ),
        "move into ignored tree",
    );
    testing::assert_eq(events.len(), 1);
    testing::assert_eq(events[0].path, path::join(root, "visible"));
    testing::assert_eq(state.watches.len(), 1);
    testing::assert_eq(state.moves.len(), 0);
    testing::expect_ok(
        fs::rename(path::join(root, "ignored"), path::join(root, "returned")),
        "show",
    );
    let events = testing::expect_ok(
        process_events(
            state,
            Vec::from_array(
                [
                    raw(root_wd, MOVED_FROM | IS_DIR, 82, "ignored"),
                    raw(root_wd, MOVED_TO | IS_DIR, 82, "returned"),
                ],
            ),
        ),
        "move out of ignored tree",
    );
    testing::assert_eq(events.len(), 1);
    testing::assert(events[0].rescan);
    testing::assert_eq(events[0].path, path::join(root, "returned"));
    testing::assert_eq(state.watches.len(), 3);
    testing::assert_eq(state.moves.len(), 0);
}

#[test]
fn ignore_rechecks_descendants_after_parent_rename() -> () {
    let root = temporary("ignore-rename-path");
    defer testing::expect_ok(fs::remove_dir_all(root), "cleanup");
    testing::expect_ok(fs::create_dir_all(path::join(root, "old/private/deep")), "private subtree");
    testing::expect_ok(fs::create_dir(path::join(root, "old/public")), "public subtree");
    let hidden = path::join(root, "new/private");
    let state = testing::expect_ok(
        open_state(root, Options::new().with_recursive(true).with_ignore(|name, _| name == hidden)),
        "open",
    );
    defer testing::expect_ok(close_state(state), "close");
    testing::assert_eq(state.watches.len(), 5);
    testing::expect_ok(fs::rename(path::join(root, "old"), path::join(root, "new")), "rename");
    let root_wd = wd_for(state, root);
    let _ = testing::expect_ok(
        process_events(
            state,
            Vec::from_array(
                [
                    raw(root_wd, MOVED_FROM | IS_DIR, 83, "old"),
                    raw(root_wd, MOVED_TO | IS_DIR, 83, "new"),
                ],
            ),
        ),
        "process rename",
    );
    testing::assert_eq(state.watches.len(), 3);
    let _ = wd_for(state, path::join(root, "new/public"));
}
