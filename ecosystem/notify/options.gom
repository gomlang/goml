package notify;

use std::fs;
use std::io;
use std::path;

pub struct Options {
    pub recursive: bool,
    pub mask: u32,
    ignore: (string, bool) -> bool,
}

impl Options {
    pub fn new() -> Options {
        Options { recursive: false, mask: CHANGES, ignore: |_, _| false }
    }

    pub fn with_recursive(self: Options, recursive: bool) -> Options {
        Options { recursive, ..self }
    }

    pub fn with_mask(self: Options, mask: u32) -> Options {
        Options { mask, ..self }
    }

    pub fn with_ignore(self: Options, predicate: (string, bool) -> bool) -> Options {
        Options {
            ignore: |name, directory| (self.ignore)(name, directory) || predicate(name, directory),
            ..self,
        }
    }

    pub fn with_ignored_names(self: Options, names: Vec[string]) -> Options {
        let snapshot = names.as_slice().to_vec();
        self.with_ignore(
            |name, _| match path::file_name(name) {
                Some(value) => snapshot.contains(value),
                None => false,
            },
        )
    }
}

fn validate_options(options: Options) -> Result[(), fs::Error] {
    if options.mask == 0 || options.mask & ALL_EVENTS != options.mask {
        Result::Err(
            error(io::ErrorKind::InvalidInput, "event mask must be a nonempty subset of ALL_EVENTS"),
        )
    } else {
        Result::Ok(())
    }
}

fn ignored(state: State, name: string, directory: bool) -> bool {
    name != state.root && (state.options.ignore)(name, directory)
}

fn visible_event(state: State, event: Event) -> bool {
    let options = state.options;
    if ignored(state, event.path, event.is_dir()) && !event.rescan {
        return false;
    }
    event.rescan
        || options.recursive && event.is_dir() && event.has(CREATE | DELETE | MOVED_FROM | MOVED_TO)
        || event.mask & (options.mask | DELETE_SELF | MOVE_SELF | UNMOUNT | IGNORED | Q_OVERFLOW)
            != 0
}
