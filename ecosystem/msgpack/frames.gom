package msgpack;

#[derive(PartialEq)]
enum FrameKind {
    Optional,
    Sequence,
    Tuple,
    Map,
    Struct,
    Variant,
}

struct Frame {
    kind: FrameKind,
    length: Ref[isize],
    consumed: Ref[isize],
    ready: Ref[bool],
    mapped: Ref[bool],
    state: Ref[isize],
    names: HashMap[string, bool],
}

fn frame(kind: FrameKind, length: isize, mapped: bool) -> Frame {
    Frame {
        kind,
        length: Ref::new(length),
        consumed: Ref::new(0),
        ready: Ref::new(false),
        mapped: Ref::new(mapped),
        state: Ref::new(0),
        names: HashMap::new(),
    }
}

fn top(frames: Vec[Frame], kind: FrameKind) -> Result[Frame, string] {
    if frames.is_empty() {
        return Result::Err("operation requires an open container")
    }
    let value = frames[frames.len() - 1];
    if value.kind != kind {
        Result::Err("operation does not match active container")
    } else {
        Result::Ok(value)
    }
}

fn claim(frames: Vec[Frame], root: Ref[bool]) -> Result[(), string] {
    if frames.is_empty() {
        if root.get() {
            return Result::Err("more than one root value")
        }
        root.set(true);
    } else {
        let current = frames[frames.len() - 1];
        if !current.ready.get() {
            return Result::Err("container is not expecting a value")
        }
        current.ready.set(false);
        current.consumed.set(current.consumed.get() + 1);
    }
    Result::Ok(())
}

fn prepare(frame: Frame, index: isize) -> Result[(), string] {
    if frame.ready.get() || index != frame.consumed.get() || index >= frame.length.get() {
        return Result::Err("field or element index out of order")
    }
    frame.ready.set(true);
    Result::Ok(())
}

fn finish_frame(frames: Vec[Frame], kind: FrameKind) -> Result[(), string] {
    let current = top(frames, kind)?;
    if current.ready.get() || current.consumed.get() != current.length.get() {
        return Result::Err("container ended before its declared values were processed")
    }
    let _ = frames.pop();
    Result::Ok(())
}

fn unique_name(frame: Frame, name: string) -> Result[(), string] {
    if frame.names.contains(name) {
        return Result::Err(f"duplicate field {name}")
    }
    frame.names.set(name, true);
    Result::Ok(())
}
