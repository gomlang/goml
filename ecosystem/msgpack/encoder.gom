package msgpack;

use std::num;
use std::serde;
use std::serde::{Serialize, Serializer};

pub struct Encoder {
    writer: Writer,
    frames: Vec[Frame],
    root: Ref[bool],
}

impl Encoder {
    pub fn new(options: Options) -> Result[Encoder, Error] {
        Result::Ok(
            Encoder { writer: Writer::new(options)?, frames: Vec::new(), root: Ref::new(false) },
        )
    }

    pub fn finish(self: Encoder) -> Result[Vec[u8], Error] {
        if !self.root.get() || !self.frames.is_empty() {
            return Result::Err(
                error(
                    ErrorKind::Serde,
                    self.writer.output.len(),
                    "serialization did not finish exactly one root",
                ),
            )
        }
        let end = skip_prefix(self.writer.output.as_slice(), self.writer.options)?;
        if end != self.writer.output.len() {
            return Result::Err(
                error(ErrorKind::TrailingData, end, "serializer emitted trailing values"),
            )
        }
        Result::Ok(self.writer.output.copy())
    }

    fn push(self: Encoder, frame: Frame) -> Result[(), string] {
        if self.frames.len() > self.writer.options.limits.max_depth {
            return Result::Err("serialization nesting limit exceeded")
        }
        self.frames.push(frame);
        Result::Ok(())
    }

    fn begin(self: Encoder, kind: FrameKind, length: isize, map: bool) -> Result[(), string] {
        self.writer.length(length, self.writer.options.limits.max_container).map_err(
            |problem| problem.to_string(),
        )?;
        claim(self.frames, self.root)?;
        self.writer.container(length, map).map_err(|problem| problem.to_string())?;
        self.push(
            frame(
                kind,
                if kind == FrameKind::Map {
                    length * 2
                } else {
                    length
                },
                map,
            ),
        )
    }

    fn field(self: Encoder, kind: FrameKind, index: isize, name: string) -> Result[(), string] {
        let frame = top(self.frames, kind)?;
        prepare(frame, index)?;
        if frame.mapped.get() {
            unique_name(frame, name)?;
            self.writer.text(name).map_err(|problem| problem.to_string())?;
        }
        Result::Ok(())
    }
}

impl serde::Serializer for Encoder {
    fn serialize_int(self: Encoder, value: isize) -> Result[(), string] {
        claim(self.frames, self.root)?;
        self.writer.int(value.to_i64()).map_err(|problem| problem.to_string())
    }

    fn serialize_int8(self: Encoder, value: i8) -> Result[(), string] {
        claim(self.frames, self.root)?;
        self.writer.int(value.to_i64()).map_err(|problem| problem.to_string())
    }

    fn serialize_int16(self: Encoder, value: i16) -> Result[(), string] {
        claim(self.frames, self.root)?;
        self.writer.int(value.to_i64()).map_err(|problem| problem.to_string())
    }

    fn serialize_int32(self: Encoder, value: i32) -> Result[(), string] {
        claim(self.frames, self.root)?;
        self.writer.int(value.to_i64()).map_err(|problem| problem.to_string())
    }

    fn serialize_int64(self: Encoder, value: i64) -> Result[(), string] {
        claim(self.frames, self.root)?;
        self.writer.int(value).map_err(|problem| problem.to_string())
    }

    fn serialize_uint(self: Encoder, value: usize) -> Result[(), string] {
        claim(self.frames, self.root)?;
        self.writer.uint(value.to_u64()).map_err(|problem| problem.to_string())
    }

    fn serialize_uint8(self: Encoder, value: u8) -> Result[(), string] {
        claim(self.frames, self.root)?;
        self.writer.uint(value.to_u64()).map_err(|problem| problem.to_string())
    }

    fn serialize_uint16(self: Encoder, value: u16) -> Result[(), string] {
        claim(self.frames, self.root)?;
        self.writer.uint(value.to_u64()).map_err(|problem| problem.to_string())
    }

    fn serialize_uint32(self: Encoder, value: u32) -> Result[(), string] {
        claim(self.frames, self.root)?;
        self.writer.uint(value.to_u64()).map_err(|problem| problem.to_string())
    }

    fn serialize_uint64(self: Encoder, value: u64) -> Result[(), string] {
        claim(self.frames, self.root)?;
        self.writer.uint(value).map_err(|problem| problem.to_string())
    }

    fn serialize_float32(self: Encoder, value: f32) -> Result[(), string] {
        claim(self.frames, self.root)?;
        self.writer.float32(value).map_err(|problem| problem.to_string())
    }

    fn serialize_float64(self: Encoder, value: f64) -> Result[(), string] {
        claim(self.frames, self.root)?;
        self.writer.float64(value).map_err(|problem| problem.to_string())
    }

    fn serialize_unit(self: Encoder) -> Result[(), string] {
        claim(self.frames, self.root)?;
        self.writer.scalar(192).map_err(|problem| problem.to_string())
    }

    fn serialize_bool(self: Encoder, value: bool) -> Result[(), string] {
        claim(self.frames, self.root)?;
        self.writer.scalar(
            if value {
                195
            } else {
                194
            },
        ).map_err(|problem| problem.to_string())
    }

    fn serialize_string(self: Encoder, value: string) -> Result[(), string] {
        claim(self.frames, self.root)?;
        self.writer.text(value).map_err(|problem| problem.to_string())
    }

    fn serialize_char(self: Encoder, value: char) -> Result[(), string] {
        self.serialize_string(value.to_string())
    }

    fn serialize_bytes(self: Encoder, value: Slice[u8]) -> Result[(), string] {
        claim(self.frames, self.root)?;
        self.writer.blob(196, value).map_err(|problem| problem.to_string())
    }

    fn serialize_extension(self: Encoder, tag: i8, data: Slice[u8]) -> Result[(), string] {
        claim(self.frames, self.root)?;
        self.writer.extension(tag, data).map_err(|problem| problem.to_string())
    }

    fn serialize_number(self: Encoder, value: string) -> Result[(), string] {
        if value.contains(".") || value.contains("e") || value.contains("E")
            || value.contains("NaN")
            || value.contains("Inf") {
            self.serialize_float64(
                num::parse_float64_structured(value).map_err(|problem| problem.to_string())?,
            )
        } else if value.starts_with("-") {
            self.serialize_int64(
                num::parse_int_structured(value).map_err(|problem| problem.to_string())?.to_i64(),
            )
        } else {
            self.serialize_uint64(
                num::parse_uint_structured(value).map_err(|problem| problem.to_string())?.to_u64(),
            )
        }
    }

    fn begin_optional(self: Encoder, present: bool) -> Result[(), string] {
        claim(self.frames, self.root)?;
        if self.writer.options.tagged_options {
            self.writer.container(
                if present {
                    2
                } else {
                    1
                },
                false,
            ).map_err(|problem| problem.to_string())?;
            self.writer.uint(
                if present {
                    1
                } else {
                    0
                },
            ).map_err(|problem| problem.to_string())?;
        } else if !present {
            self.writer.scalar(192).map_err(|problem| problem.to_string())?;
        }
        let current = frame(
            FrameKind::Optional,
            if present {
                1
            } else {
                0
            },
            false,
        );
        current.ready.set(present);
        self.push(current)
    }

    fn end_optional(self: Encoder) -> Result[(), string] {
        finish_frame(self.frames, FrameKind::Optional)
    }

    fn begin_sequence(self: Encoder, length: isize) -> Result[(), string] {
        self.begin(FrameKind::Sequence, length, false)
    }

    fn begin_sequence_element(self: Encoder, index: isize) -> Result[(), string] {
        prepare(top(self.frames, FrameKind::Sequence)?, index)
    }

    fn end_sequence(self: Encoder) -> Result[(), string] {
        finish_frame(self.frames, FrameKind::Sequence)
    }

    fn begin_tuple(self: Encoder, length: isize) -> Result[(), string] {
        self.begin(FrameKind::Tuple, length, false)
    }

    fn begin_tuple_element(self: Encoder, index: isize) -> Result[(), string] {
        prepare(top(self.frames, FrameKind::Tuple)?, index)
    }

    fn end_tuple(self: Encoder) -> Result[(), string] {
        finish_frame(self.frames, FrameKind::Tuple)
    }

    fn begin_map(self: Encoder, length: isize) -> Result[(), string] {
        self.begin(FrameKind::Map, length, true)
    }

    fn begin_map_key(self: Encoder, index: isize) -> Result[(), string] {
        let current = top(self.frames, FrameKind::Map)?;
        if index < 0 || index >= current.length.get() / 2 {
            return Result::Err("map index outside declared length")
        }
        prepare(current, index * 2)
    }

    fn begin_map_value(self: Encoder, index: isize) -> Result[(), string] {
        let current = top(self.frames, FrameKind::Map)?;
        if index < 0 || index >= current.length.get() / 2 {
            return Result::Err("map index outside declared length")
        }
        prepare(current, index * 2 + 1)
    }

    fn end_map(self: Encoder) -> Result[(), string] {
        finish_frame(self.frames, FrameKind::Map)
    }

    fn begin_struct(self: Encoder, name: string, fields: isize) -> Result[(), string] {
        let _ = name;
        self.begin(FrameKind::Struct, fields, !self.writer.options.structs_as_arrays)
    }

    fn begin_struct_field(self: Encoder, index: isize, name: string) -> Result[(), string] {
        self.field(FrameKind::Struct, index, name)
    }

    fn end_struct(self: Encoder) -> Result[(), string] {
        finish_frame(self.frames, FrameKind::Struct)
    }

    fn begin_variant(
        self: Encoder,
        enum_name: string,
        index: isize,
        name: string,
        kind: isize,
        fields: isize,
    ) -> Result[(), string] {
        let _ = enum_name;
        if index < 0 || kind < 0 || kind > 2 || fields < 0 || (kind == 0 && fields != 0) {
            return Result::Err("invalid variant shape")
        }
        self.writer.length(fields, self.writer.options.limits.max_container).map_err(
            |problem| problem.to_string(),
        )?;
        claim(self.frames, self.root)?;
        if kind != 0 {
            self.writer.container(1, true).map_err(|problem| problem.to_string())?;
        }
        if self.writer.options.variants_as_indices {
            self.writer.uint(index.to_u64()).map_err(|problem| problem.to_string())?;
        } else {
            self.writer.text(name).map_err(|problem| problem.to_string())?;
        }
        let mapped = kind == 2 && !self.writer.options.structs_as_arrays;
        if kind != 0 {
            self.writer.container(fields, mapped).map_err(|problem| problem.to_string())?;
        }
        let current = frame(FrameKind::Variant, fields, mapped);
        current.state.set(kind);
        self.push(current)
    }

    fn begin_variant_field(self: Encoder, index: isize, name: string) -> Result[(), string] {
        self.field(FrameKind::Variant, index, name)
    }

    fn end_variant(self: Encoder) -> Result[(), string] {
        finish_frame(self.frames, FrameKind::Variant)
    }
}

pub fn to_vec_with_options[T: Serialize](value: T, options: Options) -> Result[Vec[u8], Error] {
    let encoder = Encoder::new(options)?;
    Serialize::serialize(value, encoder).map_err(
        |message| serde_error(encoder.writer.output.len(), message),
    )?;
    encoder.finish()
}

pub fn to_vec[T: Serialize](value: T) -> Result[Vec[u8], Error] {
    to_vec_with_options(value, Options::standard())
}
