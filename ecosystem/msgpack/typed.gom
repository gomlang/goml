package msgpack;

use std::serde::{Serialize, Deserialize, Serializer, Deserializer};

#[derive(PartialEq)]
pub struct Binary {
    pub data: Vec[u8],
}

impl Serialize for Binary {
    fn serialize[S: Serializer](self: Binary, serializer: S) -> Result[(), string] {
        serializer.serialize_bytes(self.data.as_slice())
    }
}

impl Deserialize for Binary {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[Binary, string] {
        Result::Ok(Binary { data: deserializer.deserialize_bytes()? })
    }
}

pub struct Pairs[K, V] {
    pub entries: Vec[(K, V)],
}

impl[K: Serialize, V: Serialize] Serialize for Pairs[K, V] {
    fn serialize[S: Serializer](self: Pairs[K, V], serializer: S) -> Result[(), string] {
        serializer.begin_map(self.entries.len())?;
        let mut index = 0;
        for entry in self.entries {
            serializer.begin_map_key(index)?;
            Serialize::serialize(entry.0, serializer)?;
            serializer.begin_map_value(index)?;
            Serialize::serialize(entry.1, serializer)?;
            index += 1;
        }
        serializer.end_map()
    }
}

impl[K: Deserialize, V: Deserialize] Deserialize for Pairs[K, V] {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[Pairs[K, V], string] {
        let length = deserializer.begin_map()?;
        let entries = Vec::with_capacity(length.unwrap_or(0));
        while deserializer.next_map_entry()? {
            deserializer.begin_map_key()?;
            let key: K = Deserialize::deserialize(deserializer)?;
            deserializer.begin_map_value()?;
            let value: V = Deserialize::deserialize(deserializer)?;
            entries.push((key, value));
        }
        deserializer.end_map()?;
        Result::Ok(Pairs { entries })
    }
}

impl[K: Eq + Hash, V] Pairs[K, V] {
    pub fn from_hash_map(values: HashMap[K, V]) -> Pairs[K, V] {
        let entries = Vec::with_capacity(values.len());
        for entry in values.entries() {
            entries.push(entry);
        }
        Pairs { entries }
    }

    pub fn to_hash_map(self: Pairs[K, V]) -> Result[HashMap[K, V], Error] {
        let values = HashMap::new();
        for entry in self.entries {
            if values.contains(entry.0) {
                return Result::Err(error(ErrorKind::TypeMismatch, 0, "duplicate map key"))
            }
            values.set(entry.0, entry.1);
        }
        Result::Ok(values)
    }
}

#[derive(PartialEq)]
pub struct Extension {
    pub tag: i8,
    pub data: Vec[u8],
}

impl Serialize for Extension {
    fn serialize[S: Serializer](self: Extension, serializer: S) -> Result[(), string] {
        serializer.serialize_extension(self.tag, self.data.as_slice())
    }
}

impl Deserialize for Extension {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[Extension, string] {
        let (tag, data) = deserializer.deserialize_extension()?;
        Result::Ok(Extension { tag, data })
    }
}
