package tests;

use ecosystem::msgpack;
use ecosystem::msgpack::{Value, Options, Limits, ErrorKind, Timestamp};
use std::testing;

fn bytes(value: Value) -> Vec[u8] {
    testing::expect_ok(msgpack::pack(value), "pack")
}

fn decode(data: Vec[u8]) -> Value {
    testing::expect_ok(msgpack::unpack(data.as_slice()), "unpack")
}

fn equal_bytes(actual: Vec[u8], expected: Vec[u8]) -> () {
    testing::assert(actual == expected);
}

fn options(limits: Limits, raw: bool) -> Options {
    Options {
        limits,
        structs_as_arrays: false,
        variants_as_indices: false,
        tagged_options: false,
        allow_invalid_utf8: raw,
    }
}

fn filled(length: isize, byte: u8) -> Vec[u8] {
    let result = Vec::with_capacity(length);
    for _ in 0..length {
        result.push(byte);
    }
    result
}

fn failure(data: Vec[u8], kind: ErrorKind) -> () {
    let problem = testing::expect_err(msgpack::unpack(data.as_slice()), "invalid wire");
    testing::assert_eq(problem.kind, kind);
}

#[test]
fn integer_widths_signedness_and_nonminimal_input() -> () {
    let signed: Vec[(i64, Vec[u8])] = Vec::from_array(
        [
            (-1, Vec::from_array([255])),
            (-32, Vec::from_array([224])),
            (-33, Vec::from_array([208, 223])),
            (-128, Vec::from_array([208, 128])),
            (-129, Vec::from_array([209, 255, 127])),
            (-32768, Vec::from_array([209, 128, 0])),
            (-32769, Vec::from_array([210, 255, 255, 127, 255])),
            (-2147483648, Vec::from_array([210, 128, 0, 0, 0])),
            (-2147483649, Vec::from_array([211, 255, 255, 255, 255, 127, 255, 255, 255])),
            (-9223372036854775808, Vec::from_array([211, 128, 0, 0, 0, 0, 0, 0, 0])),
        ],
    );
    for (number, expected) in signed {
        equal_bytes(bytes(Value::Int(number)), expected);
        let Value::Int(actual) = decode(expected) else {
            testing::fail("signed tag");
            return
        };
        testing::assert_eq(actual, number);
    }
    let unsigned: Vec[(u64, Vec[u8])] = Vec::from_array(
        [
            (0, Vec::from_array([0])),
            (127, Vec::from_array([127])),
            (128, Vec::from_array([204, 128])),
            (255, Vec::from_array([204, 255])),
            (256, Vec::from_array([205, 1, 0])),
            (65535, Vec::from_array([205, 255, 255])),
            (65536, Vec::from_array([206, 0, 1, 0, 0])),
            (4294967295, Vec::from_array([206, 255, 255, 255, 255])),
            (4294967296, Vec::from_array([207, 0, 0, 0, 1, 0, 0, 0, 0])),
            (18446744073709551615, Vec::from_array([207, 255, 255, 255, 255, 255, 255, 255, 255])),
        ],
    );
    for (number, expected) in unsigned {
        equal_bytes(bytes(Value::Uint(number)), expected);
        let Value::Uint(actual) = decode(expected) else {
            testing::fail("unsigned tag");
            return
        };
        testing::assert_eq(actual, number);
    }
    equal_bytes(
        bytes(decode(Vec::from_array([211, 0, 0, 0, 0, 0, 0, 0, 42]))),
        Vec::from_array([42]),
    );
    equal_bytes(bytes(decode(Vec::from_array([207, 0, 0, 0, 0, 0, 0, 0, 1]))), Vec::from_array([1]));
}

#[test]
fn float_bits_include_nan_infinity_and_negative_zero() -> () {
    let bits32: Vec[u32] = Vec::from_array(
        [0, 2147483648, 1069547520, 2139095040, 4286578688, 2143289361, 1],
    );
    for bits in bits32 {
        let Value::Float32(value) = decode(bytes(Value::Float32(float32_from_bits(bits)))) else {
            testing::fail("float32");
            return
        };
        testing::assert_eq(value.to_bits(), bits);
    }
    let bits64: Vec[u64] = Vec::from_array(
        [
            0,
            9223372036854775808,
            4609434218613702656,
            9218868437227405312,
            18442240474082181120,
            9221120237041090577,
            1,
        ],
    );
    for bits in bits64 {
        let Value::Float64(value) = decode(bytes(Value::Float64(float64_from_bits(bits)))) else {
            testing::fail("float64");
            return
        };
        testing::assert_eq(value.to_bits(), bits);
    }
}

#[test]
fn strings_binary_extensions_and_all_length_families() -> () {
    for (length, text_tag, binary_tag, extension_tag) in Vec::from_array(
        [
            (0, 160, 196, 199),
            (1, 161, 196, 212),
            (2, 162, 196, 213),
            (4, 164, 196, 214),
            (8, 168, 196, 215),
            (16, 176, 196, 216),
            (31, 191, 196, 199),
            (32, 217, 196, 199),
            (255, 217, 196, 199),
            (256, 218, 197, 200),
            (65535, 218, 197, 200),
            (65536, 219, 198, 201),
        ],
    ) {
        let data = filled(length, 65);
        let text = bytes(Value::String(string_from_utf8(data).1));
        testing::assert_eq(text[0].to_isize(), text_tag);
        let Value::String(actual) = decode(text) else {
            testing::fail("string");
            return
        };
        equal_bytes(actual.to_bytes(), data);
        let binary = bytes(Value::Binary(data));
        testing::assert_eq(binary[0].to_isize(), binary_tag);
        let Value::Binary(actual) = decode(binary) else {
            testing::fail("binary");
            return
        };
        equal_bytes(actual, data);
        let extension = bytes(Value::Extension(-128, data));
        testing::assert_eq(extension[0].to_isize(), extension_tag);
        let Value::Extension(kind, actual) = decode(extension) else {
            testing::fail("extension");
            return
        };
        testing::assert_eq(kind, -128);
        equal_bytes(actual, data);
    }
    for (length, array_tag, map_tag) in Vec::from_array(
        [(0, 144, 128), (15, 159, 143), (16, 220, 222), (65535, 220, 222), (65536, 221, 223)],
    ) {
        let values = Vec::new();
        let entries = Vec::new();
        for _ in 0..length {
            values.push(Value::Nil);
            entries.push((Value::Bool(false), Value::Nil));
        }
        let encoded = bytes(Value::Array(values));
        testing::assert_eq(encoded[0].to_isize(), array_tag);
        let Value::Array(actual) = decode(encoded) else {
            testing::fail("array");
            return
        };
        testing::assert_eq(actual.len(), length);
        let encoded = bytes(Value::Map(entries));
        testing::assert_eq(encoded[0].to_isize(), map_tag);
        let Value::Map(actual) = decode(encoded) else {
            testing::fail("map");
            return
        };
        testing::assert_eq(actual.len(), length);
    }
}

#[test]
fn arbitrary_map_keys_duplicate_pairs_and_raw_utf8() -> () {
    let value = Value::Map(
        Vec::from_array(
            [
                (Value::Array(Vec::from_array([Value::Uint(1)])), Value::String("array key")),
                (Value::Nil, Value::Bool(true)),
                (Value::Nil, Value::Bool(false)),
                (Value::Binary(Vec::from_array([255])), Value::String("中文😀")),
            ],
        ),
    );
    let encoded = bytes(value);
    equal_bytes(bytes(decode(encoded)), encoded);
    let invalid = Vec::from_array([163, 237, 160, 128]);
    failure(invalid, ErrorKind::InvalidUtf8);
    let raw = options(Limits::standard(), true);
    let Value::RawString(data) = testing::expect_ok(
        msgpack::unpack_with_options(invalid.as_slice(), raw),
        "raw decode",
    ) else {
        testing::fail("raw string");
        return
    };
    equal_bytes(
        testing::expect_ok(msgpack::pack_with_options(Value::RawString(data), raw), "raw encode"),
        invalid,
    );
    testing::assert_err(msgpack::pack(Value::RawString(data)));
    let decoded: Result[string, msgpack::Error] = msgpack::from_slice_with_options(
        invalid.as_slice(),
        raw,
    );
    testing::assert_err(decoded);
}

#[test]
fn timestamps_choose_all_three_formats_and_validate_nanoseconds() -> () {
    for (seconds, nanoseconds, length) in Vec::from_array(
        [
            (0, 0, 4),
            (4294967295, 0, 4),
            (4294967296, 0, 8),
            (0, 1, 8),
            (17179869183, 999999999, 8),
            (17179869184, 0, 12),
            (-1, 500000000, 12),
            (-9223372036854775808, 0, 12),
            (9223372036854775807, 999999999, 12),
        ],
    ) {
        let original = Timestamp { seconds, nanoseconds };
        let value = testing::expect_ok(original.to_value(), "timestamp encode");
        let Value::Extension(kind, payload) = value else {
            testing::fail("timestamp extension");
            return
        };
        testing::assert_eq(kind, -1);
        testing::assert_eq(payload.len(), length);
        let actual = testing::expect_ok(
            Timestamp::from_value(decode(bytes(value))),
            "timestamp decode",
        );
        testing::assert_eq(actual.seconds, seconds);
        testing::assert_eq(actual.nanoseconds, nanoseconds);
    }
    testing::assert_err(Timestamp { seconds: 0, nanoseconds: 1000000000 }.to_value());
    testing::assert_err(Timestamp::from_value(Value::Extension(-1, filled(8, 255))));
    testing::assert_err(Timestamp::from_value(Value::Extension(1, filled(4, 0))));
    testing::assert_err(Timestamp::from_value(Value::Extension(-1, filled(3, 0))));
}

#[test]
fn every_truncation_and_resource_limits_are_recoverable() -> () {
    let fixtures = Vec::from_array(
        [
            Value::Array(Vec::from_array([Value::String("中文"), Value::Binary(filled(256, 255))])),
            Value::Map(Vec::from_array([(Value::Uint(18446744073709551615), Value::Float64(1.25))])),
            Value::Extension(127, filled(32, 1)),
            Value::Int(-9223372036854775808),
        ],
    );
    for value in fixtures {
        let encoded = bytes(value);
        for end in 0..encoded.len() {
            testing::assert_err(msgpack::unpack(encoded.slice(0, end)));
            testing::assert_err(msgpack::Decoder::new(encoded.slice(0, end), Options::standard()));
            testing::assert_err(msgpack::skip_prefix(encoded.slice(0, end), Options::standard()));
        }
    }
    failure(Vec::from_array([193]), ErrorKind::InvalidTag);
    failure(Vec::from_array([192, 192]), ErrorKind::TrailingData);
    failure(Vec::from_array([221, 255, 255, 255, 255]), ErrorKind::Limit);
    failure(Vec::from_array([198, 255, 255, 255, 255]), ErrorKind::Limit);
    let encoded = bytes(
        Value::Array(Vec::from_array([Value::Array(Vec::from_array([Value::Nil]))])),
    );
    for limits in Vec::from_array(
        [
            Limits { max_bytes: 2, max_blob: 10, max_container: 10, max_values: 10, max_depth: 10 },
            Limits { max_bytes: 10, max_blob: 10, max_container: 0, max_values: 10, max_depth: 10 },
            Limits { max_bytes: 10, max_blob: 10, max_container: 10, max_values: 2, max_depth: 10 },
            Limits { max_bytes: 10, max_blob: 10, max_container: 10, max_values: 10, max_depth: 1 },
        ],
    ) {
        let selected = options(limits, false);
        testing::assert_err(msgpack::unpack_with_options(encoded.as_slice(), selected));
        testing::assert_err(msgpack::pack_with_options(decode(encoded), selected));
        testing::assert_err(msgpack::Decoder::new(encoded.as_slice(), selected));
    }
    let tiny = options(
        Limits { max_bytes: 10, max_blob: 1, max_container: 10, max_values: 10, max_depth: 10 },
        false,
    );
    testing::assert_err(
        msgpack::unpack_with_options(Vec::from_array([162, 65, 66]).as_slice(), tiny),
    );
    testing::assert_err(msgpack::pack_with_options(Value::Binary(filled(2, 0)), tiny));
    let prefix = Vec::from_array([146, 1, 2, 193]);
    testing::assert_eq(
        testing::expect_ok(
            msgpack::skip_prefix(prefix.as_slice(), Options::standard()),
            "skip prefix",
        ),
        3,
    );
    testing::assert_eq(
        testing::expect_ok(msgpack::unpack_prefix(prefix.as_slice(), Options::standard()), "prefix").1,
        3,
    );
}

#[test]
fn incremental_unpacker_all_chunk_sizes_poison_and_reset() -> () {
    let first = bytes(
        Value::Array(Vec::from_array([Value::String("中文😀"), Value::Extension(9, filled(40, 7))])),
    );
    let second = bytes(
        Value::Map(Vec::from_array([(Value::Binary(filled(17, 2)), Value::Int(-99999))])),
    );
    let combined = first.copy();
    combined.extend(second);
    for chunk in 1..combined.len() + 1 {
        let unpacker = testing::expect_ok(msgpack::Unpacker::new(Options::standard()), "stream");
        let results = Vec::new();
        let mut start = 0;
        while start < combined.len() {
            let end = if start + chunk < combined.len() {
                start + chunk
            } else {
                combined.len()
            };
            testing::assert_ok(unpacker.push(combined.slice(start, end)));
            while let Some(value) = testing::expect_ok(unpacker.next(), "next") {
                results.push(bytes(value));
            }
            start = end;
        }
        testing::assert_eq(results.len(), 2);
        equal_bytes(results[0], first);
        equal_bytes(results[1], second);
        testing::assert_ok(unpacker.finish());
        testing::assert_eq(unpacker.buffered(), 0);
    }
    let unpacker = testing::expect_ok(msgpack::Unpacker::new(Options::standard()), "stream");
    testing::assert_ok(unpacker.push(Vec::from_array([217, 3, 65]).as_slice()));
    testing::assert(testing::expect_ok(unpacker.next(), "incomplete").is_none());
    testing::assert_err(unpacker.finish());
    unpacker.reset();
    testing::assert_ok(unpacker.push(Vec::from_array([193]).as_slice()));
    testing::assert_err(unpacker.next());
    testing::assert_err(unpacker.push(Vec::from_array([1]).as_slice()));
    unpacker.reset();
    testing::assert_ok(unpacker.push(Vec::from_array([1]).as_slice()));
    testing::assert(testing::expect_ok(unpacker.next(), "reset value").is_some());
    testing::assert_ok(unpacker.finish());
}

#[test]
fn stream_compaction_counts_only_unconsumed_bytes() -> () {
    let selected = options(
        Limits { max_bytes: 8, max_blob: 6, max_container: 6, max_values: 20, max_depth: 4 },
        false,
    );
    let stream = testing::expect_ok(msgpack::Unpacker::new(selected), "bounded stream");
    testing::assert_ok(stream.push(Vec::from_array([1, 2, 3, 164, 65, 66]).as_slice()));
    for expected in 1..4 {
        let value = testing::expect_some(testing::expect_ok(stream.next(), "integer"), "available");
        testing::assert(bytes(value) == Vec::from_array([expected.to_u8()]));
    }
    testing::assert_eq(stream.buffered(), 3);
    testing::assert(testing::expect_ok(stream.next(), "partial string").is_none());
    testing::assert_ok(stream.push(Vec::from_array([67, 68, 4, 5, 6]).as_slice()));
    testing::assert_eq(stream.buffered(), 8);
    let value = testing::expect_some(
        testing::expect_ok(stream.next(), "complete string"),
        "available",
    );
    testing::assert(bytes(value) == Vec::from_array([164, 65, 66, 67, 68]));
    for expected in 4..7 {
        let value = testing::expect_some(testing::expect_ok(stream.next(), "integer"), "available");
        testing::assert(bytes(value) == Vec::from_array([expected.to_u8()]));
    }
    testing::assert_ok(stream.finish());
    testing::assert_ok(stream.push(filled(8, 0).as_slice()));
    testing::assert_err(stream.push(Vec::from_array([0]).as_slice()));
    testing::assert_err(stream.next());
}
