package tests;

use ecosystem::msgpack;
use ecosystem::msgpack::{Serialize, Deserialize, Binary, Pairs, Value, Options};
use std::serde;
use std::serde::{Serializer, Deserializer};
use std::testing;

#[derive(Serialize, Deserialize, PartialEq)]
struct Record[T] {
    #[serde(rename = "display_name")]
    name: string,
    id: u64,
    data: T,
    optional: Option[isize],
}

#[derive(Serialize, Deserialize, PartialEq)]
enum Event {
    Idle,
    #[serde(rename = "move")]
    Move(i32, i32),
    One(string),
    Named {
        #[serde(rename = "v")]
        value: u16,
        label: string,
    },
}

fn configured(compact: bool, tagged: bool) -> Options {
    Options {
        limits: msgpack::Limits::standard(),
        structs_as_arrays: compact,
        variants_as_indices: compact,
        tagged_options: tagged,
        allow_invalid_utf8: false,
    }
}

fn round_trip[T: Serialize + Deserialize + PartialEq](value: T, options: Options) -> () {
    let encoded = testing::expect_ok(msgpack::to_vec_with_options(value, options), "typed encode");
    let decoded: T = testing::expect_ok(
        msgpack::from_slice_with_options(encoded.as_slice(), options),
        "typed decode",
    );
    testing::assert(value == decoded);
}

#[test]
fn derive_generic_structs_enums_binary_tuples_and_representation_options() -> () {
    for compact in Vec::from_array([false, true]) {
        for tagged in Vec::from_array([false, true]) {
            let options = configured(compact, tagged);
            round_trip(
                Record {
                    name: "中文😀",
                    id: 18446744073709551615,
                    data: Binary { data: Vec::from_array([0, 255, 128]) },
                    optional: Option::Some(-3),
                },
                options,
            );
            round_trip(
                Record {
                    name: "empty",
                    id: 0,
                    data: Vec::from_array([(1, "a"), (2, "b")]),
                    optional: Option::None,
                },
                options,
            );
            for event in Vec::from_array(
                [
                    Event::Idle,
                    Event::Move(-2, 7),
                    Event::One("payload"),
                    Event::Named { value: 65535, label: "label" },
                ],
            ) {
                round_trip(event, options);
            }
        }
    }
    let nested: Option[Option[isize]] = Option::Some(Option::None);
    round_trip(nested, configured(false, true));
    round_trip(Option::Some(()), configured(false, true));
    round_trip('😀', Options::standard());
    let data = testing::expect_ok(
        msgpack::to_vec(Binary { data: Vec::from_array([1, 2]) }),
        "binary",
    );
    testing::assert_eq(data[0], 196);
    let array = testing::expect_ok(
        msgpack::to_vec(Vec::from_array([1.to_u8(), 2.to_u8()])),
        "byte array",
    );
    testing::assert_eq(array[0], 146);
    let enum_bytes = testing::expect_ok(msgpack::to_vec(Event::One("x")), "one field enum");
    testing::assert(enum_bytes == Vec::from_array([129, 163, 79, 110, 101, 145, 161, 120]));
}

#[test]
fn typed_maps_preserve_arbitrary_keys_and_duplicate_entries() -> () {
    let pairs = Pairs {
        entries: Vec::from_array(
            [(Vec::from_array([1, 2]), "array"), (Vec::from_array([1, 2]), "duplicate")],
        ),
    };
    let encoded = testing::expect_ok(msgpack::to_vec(pairs), "typed map encode");
    let decoded: Pairs[Vec[isize], string] = testing::expect_ok(
        msgpack::from_slice(encoded.as_slice()),
        "typed map decode",
    );
    testing::assert(decoded.entries == pairs.entries);
    let map: HashMap[string, isize] = HashMap::new();
    map.set("a", 1);
    map.set("b", 2);
    let copied = testing::expect_ok(Pairs::from_hash_map(map).to_hash_map(), "hash map conversion");
    testing::assert(copied.get("b") == Option::Some(2));
    testing::assert_err(Pairs { entries: Vec::from_array([("a", 1), ("a", 2)]) }.to_hash_map());
}

#[test]
fn unknown_fields_are_skipped_duplicates_missing_and_wrong_shapes_fail() -> () {
    let unknown = Value::Extension(5, Vec::from_array([1, 2, 3]));
    let fields = Vec::from_array(
        [
            (Value::String("unknown"), Value::Array(Vec::from_array([unknown]))),
            (Value::String("id"), Value::Uint(123)),
            (Value::String("optional"), Value::Nil),
            (Value::String("data"), Value::Uint(42)),
            (Value::String("display_name"), Value::String("named")),
        ],
    );
    let encoded = testing::expect_ok(msgpack::pack(Value::Map(fields)), "field order");
    let result: Record[isize] = testing::expect_ok(
        msgpack::from_slice(encoded.as_slice()),
        "skip unknown",
    );
    testing::assert_eq(result.id, 123);
    testing::assert_eq(result.data, 42);
    fields.push((Value::String("unknown"), Value::Nil));
    let duplicate: Result[Record[isize], msgpack::Error] = msgpack::from_slice(
        testing::expect_ok(msgpack::pack(Value::Map(fields)), "duplicate").as_slice(),
    );
    testing::assert_err(duplicate);
    let missing: Result[Record[isize], msgpack::Error] = msgpack::from_slice(
        Vec::from_array([128]).as_slice(),
    );
    testing::assert_err(missing);
    let tuple: Result[(isize, isize), msgpack::Error] = msgpack::from_slice(
        Vec::from_array([145, 1]).as_slice(),
    );
    testing::assert_err(tuple);
    for invalid in Vec::from_array(
        [
            Value::Uint(99),
            Value::String("Missing"),
            Value::Map(
                Vec::from_array(
                    [(Value::String("move"), Value::Array(Vec::from_array([Value::Uint(1)])))],
                ),
            ),
        ],
    ) {
        let encoded = testing::expect_ok(msgpack::pack(invalid), "invalid enum");
        let result: Result[Event, msgpack::Error] = msgpack::from_slice(encoded.as_slice());
        testing::assert_err(result);
    }
}

#[test]
fn scalar_range_checks_and_std_value_boundaries() -> () {
    let too_big = testing::expect_ok(msgpack::to_vec(128), "integer");
    let small: Result[i8, msgpack::Error] = msgpack::from_slice(too_big.as_slice());
    testing::assert_err(small);
    let negative: Result[u64, msgpack::Error] = msgpack::from_slice(
        Vec::from_array([255]).as_slice(),
    );
    testing::assert_err(negative);
    let highest: u64 = 18446744073709551615;
    let lowest: i64 = -9223372036854775808;
    let maximum = testing::expect_ok(msgpack::to_vec(highest), "max integer");
    let signed: Result[i64, msgpack::Error] = msgpack::from_slice(maximum.as_slice());
    testing::assert_err(signed);
    round_trip(lowest, Options::standard());
    round_trip(highest, Options::standard());
    let integer_float: Result[f64, msgpack::Error] = msgpack::from_slice(
        Vec::from_array([1]).as_slice(),
    );
    testing::assert_err(integer_float);
    let character: Result[char, msgpack::Error] = msgpack::from_slice(
        Vec::from_array([162, 65, 66]).as_slice(),
    );
    testing::assert_err(character);
    let empty: Result[char, msgpack::Error] = msgpack::from_slice(Vec::from_array([160]).as_slice());
    testing::assert_err(empty);
    let trailing: Result[isize, msgpack::Error] = msgpack::from_slice(
        Vec::from_array([1, 2]).as_slice(),
    );
    testing::assert_eq(
        testing::expect_err(trailing, "trailing typed input").kind,
        msgpack::ErrorKind::TrailingData,
    );
    let binary: Result[serde::Value, msgpack::Error] = msgpack::from_slice(
        Vec::from_array([196, 1, 42]).as_slice(),
    );
    testing::assert_err(binary);
    let extension: Result[serde::Value, msgpack::Error] = msgpack::from_slice(
        Vec::from_array([212, 1, 42]).as_slice(),
    );
    testing::assert_err(extension);
    let arbitrary: Result[serde::Value, msgpack::Error] = msgpack::from_slice(
        Vec::from_array([129, 1, 2]).as_slice(),
    );
    testing::assert_err(arbitrary);
    let dynamic: serde::Value = testing::expect_ok(
        msgpack::from_slice(Vec::from_array([129, 161, 97, 146, 1, 195]).as_slice()),
        "Serde dynamic value",
    );
    let canonical = testing::expect_ok(msgpack::to_vec(dynamic), "Serde dynamic encode");
    testing::assert(canonical == Vec::from_array([129, 161, 97, 146, 1, 195]));
}

#[test]
fn event_protocol_rejects_incomplete_out_of_order_and_multiple_roots() -> () {
    let encoder = testing::expect_ok(msgpack::Encoder::new(Options::standard()), "encoder");
    testing::assert_ok(encoder.begin_sequence(2));
    testing::assert_err(encoder.serialize_int(1));
    testing::assert_err(encoder.begin_sequence_element(1));
    testing::assert_ok(encoder.begin_sequence_element(0));
    testing::assert_ok(encoder.serialize_int(7));
    testing::assert_err(encoder.end_sequence());
    testing::assert_err(encoder.finish());
    let encoder = testing::expect_ok(msgpack::Encoder::new(Options::standard()), "encoder");
    testing::assert_ok(encoder.serialize_unit());
    testing::assert_err(encoder.serialize_unit());
    let encoder = testing::expect_ok(msgpack::Encoder::new(Options::standard()), "encoder");
    testing::assert_ok(encoder.begin_map(1));
    testing::assert_err(encoder.begin_map_value(0));
    testing::assert_err(encoder.end_struct());
    let decoder = testing::expect_ok(
        msgpack::Decoder::new(Vec::from_array([129, 1, 2]).as_slice(), Options::standard()),
        "decoder",
    );
    testing::assert_ok(decoder.begin_map());
    testing::assert_err(decoder.begin_map_key());
    testing::assert(testing::expect_ok(decoder.next_map_entry(), "entry"));
    testing::assert_ok(decoder.begin_map_key());
    testing::assert_err(decoder.begin_map_value());
    testing::assert_eq(testing::expect_ok(decoder.deserialize_int(), "key"), 1);
    testing::assert_err(decoder.next_map_entry());
    testing::assert_ok(decoder.begin_map_value());
    testing::assert_eq(testing::expect_ok(decoder.deserialize_int(), "value"), 2);
    testing::assert(!testing::expect_ok(decoder.next_map_entry(), "end"));
    testing::assert_ok(decoder.end_map());
    testing::assert_ok(decoder.finish());
    let decoder = testing::expect_ok(
        msgpack::Decoder::new(Vec::from_array([145, 1]).as_slice(), Options::standard()),
        "decoder",
    );
    testing::assert_ok(decoder.begin_sequence());
    testing::assert(testing::expect_ok(decoder.next_sequence_element(), "element"));
    testing::assert_err(decoder.next_sequence_element());
    testing::assert_err(decoder.end_sequence());
}

#[test]
fn typed_limits_tagged_option_validation_and_overflowed_event_indices() -> () {
    let options = Options {
        limits: msgpack::Limits {
            max_bytes: 100,
            max_blob: 5,
            max_container: 5,
            max_values: 5,
            max_depth: 1,
        },
        structs_as_arrays: false,
        variants_as_indices: false,
        tagged_options: true,
        allow_invalid_utf8: false,
    };
    let nested = Vec::from_array([Vec::from_array([1])]);
    testing::assert_err(msgpack::to_vec_with_options(nested, options));
    let wire = Vec::from_array([145, 145, 1]);
    let decoded: Result[Vec[Vec[isize]], msgpack::Error] = msgpack::from_slice_with_options(
        wire.as_slice(),
        options,
    );
    testing::assert_err(decoded);
    for wire in Vec::from_array(
        [
            Vec::from_array([145, 1]),
            Vec::from_array([146, 0, 1]),
            Vec::from_array([145, 2]),
            Vec::from_array([144]),
        ],
    ) {
        let value: Result[Option[isize], msgpack::Error] = msgpack::from_slice_with_options(
            wire.as_slice(),
            options,
        );
        testing::assert_err(value);
    }
    let encoder = testing::expect_ok(msgpack::Encoder::new(Options::standard()), "encoder");
    testing::assert_ok(encoder.begin_map(1));
    testing::assert_err(encoder.begin_map_key(-9223372036854775808));
    testing::assert_ok(encoder.begin_map_key(0));
    testing::assert_ok(encoder.serialize_int(1));
    testing::assert_err(encoder.begin_map_value(-9223372036854775808));
}
