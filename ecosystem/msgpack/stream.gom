package msgpack;

use std::serde::{Deserialize};

pub struct Unpacker {
    buffer: Vec[u8],
    options: Options,
    head: Ref[isize],
    cursor: Ref[isize],
    values: Ref[isize],
    remaining: Vec[isize],
    failure: Ref[Option[Error]],
}

impl Unpacker {
    pub fn new(options: Options) -> Result[Unpacker, Error] {
        options.limits.validate()?;
        Result::Ok(
            Unpacker {
                buffer: Vec::new(),
                options,
                head: Ref::new(0),
                cursor: Ref::new(0),
                values: Ref::new(0),
                remaining: Vec::from_array([1]),
                failure: Ref::new(Option::None),
            },
        )
    }

    pub fn buffered(self: Unpacker) -> isize {
        self.buffer.len() - self.head.get()
    }

    pub fn push(self: Unpacker, input: Slice[u8]) -> Result[(), Error] {
        if let Some(problem) = self.failure.get() {
            return Result::Err(problem)
        }
        if input.len() > self.options.limits.max_bytes - self.buffered() {
            let problem = error(
                ErrorKind::Limit,
                self.buffer.len(),
                "stream buffer exceeds byte limit",
            );
            self.failure.set(Option::Some(problem));
            return Result::Err(problem)
        }
        if self.head.get() > 0
            && (self.head.get() >= self.buffer.len() / 2
                || input.len() > self.options.limits.max_bytes - self.buffer.len()) {
            let rest = self.buffer.slice(self.head.get(), self.buffer.len()).to_vec();
            self.buffer.clear();
            self.buffer.extend(rest);
            self.head.set(0);
        }
        for byte in input {
            self.buffer.push(byte);
        }
        Result::Ok(())
    }

    fn scan(self: Unpacker) -> Result[Option[isize], Error] {
        let reader = Reader::new(
            self.buffer.slice(self.head.get(), self.buffer.len()),
            self.options,
        )?;
        reader.cursor.set(self.cursor.get());
        reader.values.set(self.values.get());
        while !self.remaining.is_empty() {
            let last = self.remaining.len() - 1;
            if self.remaining[last] == 0 {
                let _ = self.remaining.pop();
                continue;
            }
            if last > self.options.limits.max_depth {
                return Result::Err(
                    error(ErrorKind::Limit, self.cursor.get(), "stream nesting limit exceeded"),
                )
            }
            let token = match reader.token() {
                Ok(value) => value,
                Err(problem) => if problem.kind == ErrorKind::UnexpectedEof {
                    return Result::Ok(Option::None)
                } else {
                    return Result::Err(problem)
                },
            };
            self.cursor.set(reader.cursor.get());
            self.values.set(reader.values.get());
            self.remaining[last] -= 1;
            match token {
                Token::Array(length) => self.remaining.push(length),
                Token::Map(length) => self.remaining.push(length * 2),
                _ => (),
            }
        }
        Result::Ok(Option::Some(self.cursor.get()))
    }

    fn advance(self: Unpacker, end: isize) -> () {
        self.head.set(self.head.get() + end);
        if self.head.get() == self.buffer.len() {
            self.buffer.clear();
            self.head.set(0);
        }
        self.cursor.set(0);
        self.values.set(0);
        self.remaining.push(1);
    }

    fn frame_end(self: Unpacker) -> Result[Option[isize], Error] {
        if let Some(problem) = self.failure.get() {
            return Result::Err(problem)
        }
        if self.buffered() == 0 {
            return Result::Ok(Option::None)
        }
        match self.scan() {
            Ok(value) => Result::Ok(value),
            Err(problem) => {
                self.failure.set(Option::Some(problem));
                Result::Err(problem)
            },
        }
    }

    pub fn next(self: Unpacker) -> Result[Option[Value], Error] {
        let end = match self.frame_end()? {
            Some(end) => end,
            None => return Result::Ok(Option::None),
        };
        let value = unpack_with_options(
            self.buffer.slice(self.head.get(), self.head.get() + end),
            self.options,
        )?;
        self.advance(end);
        Result::Ok(Option::Some(value))
    }

    pub fn decode_next[T: Deserialize](self: Unpacker) -> Result[Option[T], Error] {
        let end = match self.frame_end()? {
            Some(end) => end,
            None => return Result::Ok(Option::None),
        };
        let value = from_slice_with_options(
            self.buffer.slice(self.head.get(), self.head.get() + end),
            self.options,
        )?;
        self.advance(end);
        Result::Ok(Option::Some(value))
    }

    pub fn finish(self: Unpacker) -> Result[(), Error] {
        if let Some(problem) = self.failure.get() {
            return Result::Err(problem)
        }
        if self.buffered() != 0 {
            Result::Err(
                error(ErrorKind::UnexpectedEof, self.cursor.get(), "undrained or truncated stream"),
            )
        } else {
            Result::Ok(())
        }
    }

    pub fn reset(self: Unpacker) -> () {
        self.buffer.clear();
        self.head.set(0);
        self.cursor.set(0);
        self.values.set(0);
        self.remaining.clear();
        self.remaining.push(1);
        self.failure.set(Option::None);
    }
}
