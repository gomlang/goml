package msgpack;

pub use std::serde::{Deserialize, Serialize};

#[derive(Debug, PartialEq)]
pub enum ErrorKind {
    UnexpectedEof,
    InvalidTag,
    InvalidUtf8,
    Limit,
    TrailingData,
    TypeMismatch,
    InvalidTimestamp,
    Serde,
}

#[derive(Debug, PartialEq)]
pub struct Error {
    pub kind: ErrorKind,
    pub offset: isize,
    pub message: string,
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        f"byte {self.offset}: {self.message}"
    }
}

fn error(kind: ErrorKind, offset: isize, message: string) -> Error {
    Error { kind, offset, message }
}

pub enum Value {
    Nil,
    Bool(bool),
    Int(i64),
    Uint(u64),
    Float32(f32),
    Float64(f64),
    String(string),
    RawString(Vec[u8]),
    Binary(Vec[u8]),
    Array(Vec[Value]),
    Map(Vec[(Value, Value)]),
    Extension(i8, Vec[u8]),
}

pub struct Limits {
    pub max_bytes: isize,
    pub max_blob: isize,
    pub max_container: isize,
    pub max_values: isize,
    pub max_depth: isize,
}

impl Limits {
    pub fn standard() -> Limits {
        Limits {
            max_bytes: 16777216,
            max_blob: 16777216,
            max_container: 1000000,
            max_values: 2000000,
            max_depth: 128,
        }
    }

    fn validate(self: Limits) -> Result[(), Error] {
        if self.max_bytes < 0 || self.max_blob < 0 || self.max_container < 0 || self.max_values < 0
            || self.max_depth < 0 {
            Result::Err(error(ErrorKind::Limit, 0, "limits must be nonnegative"))
        } else {
            Result::Ok(())
        }
    }
}

pub struct Options {
    pub limits: Limits,
    pub structs_as_arrays: bool,
    pub variants_as_indices: bool,
    pub tagged_options: bool,
    pub allow_invalid_utf8: bool,
}

impl Options {
    pub fn standard() -> Options {
        Options {
            limits: Limits::standard(),
            structs_as_arrays: false,
            variants_as_indices: false,
            tagged_options: false,
            allow_invalid_utf8: false,
        }
    }
}

pub struct Timestamp {
    pub seconds: i64,
    pub nanoseconds: u32,
}

enum Token {
    Nil,
    Bool(bool),
    Int(i64),
    Uint(u64),
    Float32(f32),
    Float64(f64),
    String(Slice[u8]),
    Binary(Slice[u8]),
    Array(isize),
    Map(isize),
    Extension(i8, Slice[u8]),
}

fn serde_error(offset: isize, message: string) -> Error {
    let prefix = f"byte {offset}: ";
    error(
        ErrorKind::Serde,
        offset,
        if message.starts_with(prefix) {
            message.byte_slice(prefix.byte_len(), message.byte_len())
        } else {
            message
        },
    )
}
