package http;

use std::bytes::{Bytes};

#[derive(Debug, PartialEq)]
pub enum ErrorKind {
    Invalid,
    Limit,
}

#[derive(Debug)]
pub struct Error {
    pub kind: ErrorKind,
    pub message: string,
}

impl Error {
    fn invalid(message: string) -> Error {
        Error { kind: ErrorKind::Invalid, message }
    }

    fn limit() -> Error {
        Error { kind: ErrorKind::Limit, message: "HTTP dump exceeds limit" }
    }
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        self.message
    }
}

fn token(value: string) -> bool {
    if value == "" {
        return false
    }
    for byte in value.to_bytes() {
        if !((byte >= b'a' && byte <= b'z') || (byte >= b'A' && byte <= b'Z')
            || (byte >= b'0' && byte <= b'9')
            || byte == b'!'
            || byte == b'#'
            || byte == b'$'
            || byte == b'%'
            || byte == b'&'
            || byte == b'\''
            || byte == b'*'
            || byte == b'+'
            || byte == b'-'
            || byte == b'.'
            || byte == b'^'
            || byte == b'_'
            || byte == b'`'
            || byte == b'|'
            || byte == b'~') {
            return false
        }
    }
    true
}

fn valid_value(value: string) -> bool {
    for byte in value.to_bytes() {
        if byte == 127 || byte < 32 && byte != 9 {
            return false
        }
    }
    true
}

fn hop_name(name: string) -> bool {
    name == "connection" || name == "proxy-connection" || name == "keep-alive"
        || name == "proxy-authenticate"
        || name == "proxy-authorization"
        || name == "te"
        || name == "trailer"
        || name == "transfer-encoding"
        || name == "upgrade"
}

pub fn strip_hop_headers(headers: Vec[(string, string)]) -> Result[Vec[(string, string)], Error] {
    let nominated: Vec[string] = Vec::new();
    for (name, value) in headers {
        if !token(name) || !valid_value(value) {
            return Result::Err(Error::invalid("invalid HTTP header"))
        }
        if name.eq_ignore_ascii_case("connection") {
            for item in value.split(",") {
                let item = item.trim();
                if !token(item) {
                    return Result::Err(Error::invalid("invalid Connection token"))
                }
                nominated.push(item.to_ascii_lowercase());
            }
        }
    }
    let result: Vec[(string, string)] = Vec::new();
    for (name, value) in headers {
        let lower = name.to_ascii_lowercase();
        if !hop_name(lower) && !nominated.contains(lower) {
            result.push((lower, value));
        }
    }
    Result::Ok(result)
}

fn dump(start: string, headers: Vec[(string, string)], body: Bytes, limit: isize) -> Result[
    Bytes,
    Error,
] {
    if limit < 0 {
        return Result::Err(Error::limit())
    }
    let mut head = start + "\r\n";
    if head.byte_len() > limit {
        return Result::Err(Error::limit())
    }
    for (name, value) in headers {
        if !token(name) || !valid_value(value) {
            return Result::Err(Error::invalid("invalid HTTP header"))
        }
        if name.byte_len() > limit - head.byte_len()
            || value.byte_len() > limit - head.byte_len() - name.byte_len()
            || 4 > limit - head.byte_len() - name.byte_len() - value.byte_len() {
            return Result::Err(Error::limit())
        }
        head += name + ": " + value + "\r\n";
    }
    if 2 > limit - head.byte_len() || body.len() > limit - head.byte_len() - 2 {
        return Result::Err(Error::limit())
    }
    head += "\r\n";
    let result = Bytes::from_string(head);
    result.extend_from_slice(body.as_slice());
    Result::Ok(result)
}

pub fn dump_request(
    method: string,
    target: string,
    headers: Vec[(string, string)],
    body: Bytes,
    limit: isize,
) -> Result[Bytes, Error] {
    if !token(method) || target == "" {
        return Result::Err(Error::invalid("invalid HTTP request line"))
    }
    for byte in target.to_bytes() {
        if byte <= 32 || byte == 127 {
            return Result::Err(Error::invalid("invalid HTTP request line"))
        }
    }
    dump(method + " " + target + " HTTP/1.1", headers, body, limit)
}

pub fn dump_response(
    status: isize,
    reason: string,
    headers: Vec[(string, string)],
    body: Bytes,
    limit: isize,
) -> Result[Bytes, Error] {
    if status < 100 || status > 599 {
        return Result::Err(Error::invalid("invalid HTTP status line"))
    }
    for byte in reason.to_bytes() {
        if byte < 32 || byte == 127 {
            return Result::Err(Error::invalid("invalid HTTP status line"))
        }
    }
    dump("HTTP/1.1 " + status.to_string() + " " + reason, headers, body, limit)
}
