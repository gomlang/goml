package tests;

use ecosystem::http::{strip_hop_headers, dump_request, dump_response};
use std::bytes::{Bytes};
use std::testing;

#[test]
fn removes_static_and_connection_nominated_hop_headers() -> () {
    let headers = Vec::from_array(
        [
            ("Connection", "keep-alive, X-Private"),
            ("X-Private", "secret"),
            ("Proxy-Authorization", "bad"),
            ("Upgrade", "websocket"),
            ("X-End", "one"),
            ("X-End", "two"),
        ],
    );
    let result = testing::expect_ok(strip_hop_headers(headers), "strip headers");
    testing::assert(result == Vec::from_array([("x-end", "one"), ("x-end", "two")]));
    testing::assert(strip_hop_headers(Vec::from_array([("Connection", "bad name")])).is_err());
    testing::assert(strip_hop_headers(Vec::from_array([("X-Test", "bad\r\nheader")])).is_err());
}

#[test]
fn dumps_bounded_http1_views_without_changing_binary_body() -> () {
    let body = Bytes::from_vec(Vec::from_array([0, 255, 10]));
    let request = testing::expect_ok(
        dump_request(
            "POST",
            "/upload?q=1",
            Vec::from_array([("Host", "example.test"), ("Content-Length", "3")]),
            body,
            256,
        ),
        "request dump",
    );
    let expected = Bytes::from_string(
        "POST /upload?q=1 HTTP/1.1\r\nHost: example.test\r\nContent-Length: 3\r\n\r\n",
    );
    expected.extend_from_slice(Vec::from_array([0, 255, 10]).as_slice());
    testing::assert(request.to_vec_copy() == expected.to_vec_copy());
    testing::assert(dump_request("GET", "/", Vec::new(), Bytes::new(), 15).is_err());
    testing::assert(
        dump_request("GET", "/\r\nX-Injected: yes", Vec::new(), Bytes::new(), 256).is_err(),
    );
    let response = testing::expect_ok(
        dump_response(204, "No Content", Vec::new(), Bytes::new(), 256),
        "response dump",
    );
    testing::assert(response.to_vec_copy() == b"HTTP/1.1 204 No Content\r\n\r\n");
}
