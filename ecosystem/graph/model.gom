package graph;

#[derive(PartialEq, Eq, Hash)]
pub struct NodeId {
    slot: isize,
    owner: Ref[bool],
}

#[derive(PartialEq, Eq, Hash)]
pub struct EdgeId {
    slot: isize,
    owner: Ref[bool],
}

impl NodeId {
    pub fn index(self: NodeId) -> isize {
        self.slot
    }
}

impl EdgeId {
    pub fn index(self: EdgeId) -> isize {
        self.slot
    }
}

impl ToString for NodeId {
    fn to_string(self: NodeId) -> string {
        f"node:{self.slot}"
    }
}

impl Debug for NodeId {
    fn debug(self: NodeId) -> string {
        self.to_string()
    }
}

impl ToString for EdgeId {
    fn to_string(self: EdgeId) -> string {
        f"edge:{self.slot}"
    }
}

impl Debug for EdgeId {
    fn debug(self: EdgeId) -> string {
        self.to_string()
    }
}

#[derive(Debug, PartialEq)]
pub enum ErrorKind {
    InvalidNode,
    InvalidEdge,
    WrongGraph,
    RequiresDirected,
    RequiresUndirected,
    Cycle,
    NegativeWeight,
    NegativeCycle,
    Overflow,
    InvalidArgument,
}

#[derive(Debug, PartialEq)]
pub struct Error {
    pub kind: ErrorKind,
    pub message: string,
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        self.message
    }
}

fn error(kind: ErrorKind, message: string) -> Error {
    Error { kind, message }
}

pub struct Edge[E] {
    pub id: EdgeId,
    pub from: NodeId,
    pub to: NodeId,
    pub value: E,
}

pub struct Neighbor {
    pub node: NodeId,
    pub edge: EdgeId,
}

pub struct Graph[N, E] {
    identity: Ref[bool],
    directed_value: bool,
    node_slots: Vec[Option[N]],
    edge_slots: Vec[Option[Edge[E]]],
    outgoing: Vec[Vec[EdgeId]],
    incoming: Vec[Vec[EdgeId]],
    node_count_value: Ref[isize],
    edge_count_value: Ref[isize],
}

impl[N, E] Graph[N, E] {
    pub fn new(directed: bool) -> Graph[N, E] {
        Graph {
            identity: Ref::new(false),
            directed_value: directed,
            node_slots: Vec::new(),
            edge_slots: Vec::new(),
            outgoing: Vec::new(),
            incoming: Vec::new(),
            node_count_value: Ref::new(0),
            edge_count_value: Ref::new(0),
        }
    }

    pub fn is_directed(self: Graph[N, E]) -> bool {
        self.directed_value
    }

    pub fn node_count(self: Graph[N, E]) -> isize {
        self.node_count_value.get()
    }

    pub fn edge_count(self: Graph[N, E]) -> isize {
        self.edge_count_value.get()
    }

    pub fn contains_node(self: Graph[N, E], id: NodeId) -> bool {
        ptr_eq(id.owner, self.identity) && id.slot >= 0 && id.slot < self.node_slots.len()
            && self.node_slots[id.slot].is_some()
    }

    pub fn contains_edge(self: Graph[N, E], id: EdgeId) -> bool {
        ptr_eq(id.owner, self.identity) && id.slot >= 0 && id.slot < self.edge_slots.len()
            && self.edge_slots[id.slot].is_some()
    }

    pub fn node(self: Graph[N, E], id: NodeId) -> Result[N, Error] {
        if !ptr_eq(id.owner, self.identity) {
            return Result::Err(error(ErrorKind::WrongGraph, "node belongs to another graph"))
        }
        if id.slot < 0 || id.slot >= self.node_slots.len() {
            return Result::Err(error(ErrorKind::InvalidNode, "invalid node index"))
        }
        self.node_slots[id.slot].ok_or(error(ErrorKind::InvalidNode, f"removed {id}"))
    }

    pub fn edge(self: Graph[N, E], id: EdgeId) -> Result[Edge[E], Error] {
        if !ptr_eq(id.owner, self.identity) {
            return Result::Err(error(ErrorKind::WrongGraph, "edge belongs to another graph"))
        }
        if id.slot < 0 || id.slot >= self.edge_slots.len() {
            return Result::Err(error(ErrorKind::InvalidEdge, "invalid edge index"))
        }
        self.edge_slots[id.slot].ok_or(error(ErrorKind::InvalidEdge, f"removed {id}"))
    }

    pub fn add_node(self: Graph[N, E], value: N) -> NodeId {
        let id = NodeId { slot: self.node_slots.len(), owner: self.identity };
        self.node_slots.push(Option::Some(value));
        self.outgoing.push(Vec::new());
        self.incoming.push(Vec::new());
        self.node_count_value.set(self.node_count() + 1);
        id
    }

    pub fn add_edge(self: Graph[N, E], from: NodeId, to: NodeId, value: E) -> Result[EdgeId, Error] {
        let _ = self.node(from)?;
        let _ = self.node(to)?;
        let id = EdgeId { slot: self.edge_slots.len(), owner: self.identity };
        self.edge_slots.push(Option::Some(Edge { id, from, to, value }));
        self.outgoing[from.slot].push(id);
        self.incoming[to.slot].push(id);
        self.edge_count_value.set(self.edge_count() + 1);
        Result::Ok(id)
    }

    pub fn set_node(self: Graph[N, E], id: NodeId, value: N) -> Result[N, Error] {
        let previous = self.node(id)?;
        self.node_slots[id.slot] = Option::Some(value);
        Result::Ok(previous)
    }

    pub fn set_edge(self: Graph[N, E], id: EdgeId, value: E) -> Result[E, Error] {
        let previous = self.edge(id)?;
        self.edge_slots[id.slot] = Option::Some(
            Edge { id, from: previous.from, to: previous.to, value },
        );
        Result::Ok(previous.value)
    }

    pub fn remove_edge(self: Graph[N, E], id: EdgeId) -> Result[Edge[E], Error] {
        let previous = self.edge(id)?;
        self.edge_slots[id.slot] = Option::None;
        self.edge_count_value.set(self.edge_count() - 1);
        if let Some(index) = self.outgoing[previous.from.slot].position(|value| value == id) {
            let _ = self.outgoing[previous.from.slot].remove(index);
        }
        if let Some(index) = self.incoming[previous.to.slot].position(|value| value == id) {
            let _ = self.incoming[previous.to.slot].remove(index);
        }
        Result::Ok(previous)
    }

    pub fn remove_node(self: Graph[N, E], id: NodeId) -> Result[N, Error] {
        let previous = self.node(id)?;
        let incident = self.outgoing[id.slot].copy();
        incident.extend(self.incoming[id.slot]);
        for edge in incident {
            if self.contains_edge(edge) {
                let _ = self.remove_edge(edge)?;
            }
        }
        self.node_slots[id.slot] = Option::None;
        self.node_count_value.set(self.node_count() - 1);
        Result::Ok(previous)
    }

    pub fn nodes(self: Graph[N, E]) -> Vec[(NodeId, N)] {
        let result: Vec[(NodeId, N)] = Vec::with_capacity(self.node_count());
        for index in 0..self.node_slots.len() {
            if let Some(value) = self.node_slots[index] {
                result.push((NodeId { slot: index, owner: self.identity }, value));
            }
        }
        result
    }

    pub fn edges(self: Graph[N, E]) -> Vec[Edge[E]] {
        let result: Vec[Edge[E]] = Vec::with_capacity(self.edge_count());
        for entry in self.edge_slots {
            if let Some(edge) = entry {
                result.push(edge);
            }
        }
        result
    }

    pub fn neighbors(self: Graph[N, E], id: NodeId) -> Result[Vec[Neighbor], Error] {
        let _ = self.node(id)?;
        let result: Vec[Neighbor] = Vec::new();
        for edge_id in self.outgoing[id.slot] {
            let edge = self.edge(edge_id)?;
            result.push(Neighbor { node: edge.to, edge: edge.id });
        }
        if !self.directed_value {
            for edge_id in self.incoming[id.slot] {
                let edge = self.edge(edge_id)?;
                if edge.from != id {
                    result.push(Neighbor { node: edge.from, edge: edge.id });
                }
            }
        }
        Result::Ok(result)
    }

    pub fn predecessors(self: Graph[N, E], id: NodeId) -> Result[Vec[Neighbor], Error] {
        if !self.directed_value {
            return self.neighbors(id)
        }
        let _ = self.node(id)?;
        let result: Vec[Neighbor] = Vec::new();
        for edge_id in self.incoming[id.slot] {
            let edge = self.edge(edge_id)?;
            result.push(Neighbor { node: edge.from, edge: edge.id });
        }
        Result::Ok(result)
    }

    pub fn edges_between(self: Graph[N, E], from: NodeId, to: NodeId) -> Result[Vec[EdgeId], Error] {
        let _ = self.node(to)?;
        let result: Vec[EdgeId] = Vec::new();
        for neighbor in self.neighbors(from)? {
            if neighbor.node == to {
                result.push(neighbor.edge);
            }
        }
        Result::Ok(result)
    }

    pub fn clear(self: Graph[N, E]) -> () {
        for node in self.nodes() {
            let _ = self.remove_node(node.0);
        }
    }
}

pub struct Copy[N, E] {
    pub graph: Graph[N, E],
    pub nodes: HashMap[NodeId, NodeId],
    pub edges: HashMap[EdgeId, EdgeId],
}

impl[N, E] Graph[N, E] {
    pub fn map[A, B](self: Graph[N, E], node_map: (N) -> A, edge_map: (E) -> B) -> Result[
        Copy[A, B],
        Error,
    ] {
        let graph: Graph[A, B] = Graph::new(self.directed_value);
        let nodes: HashMap[NodeId, NodeId] = HashMap::new();
        let edges: HashMap[EdgeId, EdgeId] = HashMap::new();
        for node in self.nodes() {
            nodes.set(node.0, graph.add_node(node_map(node.1)));
        }
        for edge in self.edges() {
            let from = nodes.get(edge.from).ok_or(
                error(ErrorKind::InvalidNode, "source changed during graph copy"),
            )?;
            let to = nodes.get(edge.to).ok_or(
                error(ErrorKind::InvalidNode, "destination changed during graph copy"),
            )?;
            edges.set(edge.id, graph.add_edge(from, to, edge_map(edge.value))?);
        }
        Result::Ok(Copy { graph, nodes, edges })
    }

    pub fn copy(self: Graph[N, E]) -> Result[Copy[N, E], Error] {
        self.map(|value| value, |value| value)
    }
}
