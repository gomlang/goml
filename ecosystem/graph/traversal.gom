package graph;

use std::collections;

pub fn bfs[N, E](graph: Graph[N, E], start: NodeId) -> Result[Vec[NodeId], Error] {
    let _ = graph.node(start)?;
    let result: Vec[NodeId] = Vec::new();
    let seen: HashMap[NodeId, bool] = HashMap::new();
    let queue: collections::Deque[NodeId] = collections::Deque::new();
    seen.set(start, true);
    queue.push_back(start);
    while let Some(node) = queue.pop_front() {
        result.push(node);
        for neighbor in graph.neighbors(node)? {
            if !seen.contains(neighbor.node) {
                seen.set(neighbor.node, true);
                queue.push_back(neighbor.node);
            }
        }
    }
    Result::Ok(result)
}

pub fn dfs[N, E](graph: Graph[N, E], start: NodeId) -> Result[Vec[NodeId], Error] {
    let _ = graph.node(start)?;
    let result: Vec[NodeId] = Vec::new();
    let seen: HashMap[NodeId, bool] = HashMap::new();
    let stack = Vec::from_array([start]);
    while let Some(node) = stack.pop() {
        if seen.contains(node) {
            continue;
        }
        seen.set(node, true);
        result.push(node);
        let neighbors = graph.neighbors(node)?;
        neighbors.reverse();
        for neighbor in neighbors {
            if !seen.contains(neighbor.node) {
                stack.push(neighbor.node);
            }
        }
    }
    Result::Ok(result)
}

pub fn topological_sort[N, E](graph: Graph[N, E]) -> Result[Vec[NodeId], Error] {
    if !graph.is_directed() {
        return Result::Err(
            error(ErrorKind::RequiresDirected, "topological order requires a directed graph"),
        )
    }
    let degrees: HashMap[NodeId, isize] = HashMap::new();
    let queue: collections::Deque[NodeId] = collections::Deque::new();
    for node in graph.nodes() {
        let degree = graph.predecessors(node.0)?.len();
        degrees.set(node.0, degree);
        if degree == 0 {
            queue.push_back(node.0);
        }
    }
    let result: Vec[NodeId] = Vec::new();
    while let Some(node) = queue.pop_front() {
        result.push(node);
        for neighbor in graph.neighbors(node)? {
            let previous = degrees.get(neighbor.node).unwrap_or(0);
            degrees.set(neighbor.node, previous - 1);
            if previous == 1 {
                queue.push_back(neighbor.node);
            }
        }
    }
    if result.len() != graph.node_count() {
        return Result::Err(error(ErrorKind::Cycle, "graph contains a directed cycle"))
    }
    Result::Ok(result)
}

pub fn weak_components[N, E](graph: Graph[N, E]) -> Result[Vec[Vec[NodeId]], Error] {
    let result: Vec[Vec[NodeId]] = Vec::new();
    let seen: HashMap[NodeId, bool] = HashMap::new();
    for entry in graph.nodes() {
        if seen.contains(entry.0) {
            continue;
        }
        let component: Vec[NodeId] = Vec::new();
        let stack = Vec::from_array([entry.0]);
        seen.set(entry.0, true);
        while let Some(node) = stack.pop() {
            component.push(node);
            let neighbors = graph.neighbors(node)?;
            if graph.is_directed() {
                neighbors.extend(graph.predecessors(node)?);
            }
            for neighbor in neighbors {
                if !seen.contains(neighbor.node) {
                    seen.set(neighbor.node, true);
                    stack.push(neighbor.node);
                }
            }
        }
        result.push(component);
    }
    Result::Ok(result)
}

pub fn strong_components[N, E](graph: Graph[N, E]) -> Result[Vec[Vec[NodeId]], Error] {
    if !graph.is_directed() {
        return weak_components(graph)
    }
    let seen: HashMap[NodeId, bool] = HashMap::new();
    let order: Vec[NodeId] = Vec::new();
    for entry in graph.nodes() {
        let stack = Vec::from_array([(entry.0, false)]);
        while let Some((node, finished)) = stack.pop() {
            if finished {
                order.push(node);
                continue;
            }
            if seen.contains(node) {
                continue;
            }
            seen.set(node, true);
            stack.push((node, true));
            for neighbor in graph.neighbors(node)? {
                if !seen.contains(neighbor.node) {
                    stack.push((neighbor.node, false));
                }
            }
        }
    }
    order.reverse();
    let assigned: HashMap[NodeId, bool] = HashMap::new();
    let result: Vec[Vec[NodeId]] = Vec::new();
    for start in order {
        if assigned.contains(start) {
            continue;
        }
        let component: Vec[NodeId] = Vec::new();
        let stack = Vec::from_array([start]);
        assigned.set(start, true);
        while let Some(node) = stack.pop() {
            component.push(node);
            for neighbor in graph.predecessors(node)? {
                if !assigned.contains(neighbor.node) {
                    assigned.set(neighbor.node, true);
                    stack.push(neighbor.node);
                }
            }
        }
        result.push(component);
    }
    Result::Ok(result)
}

pub fn unweighted_path[N, E](graph: Graph[N, E], start: NodeId, target: NodeId) -> Result[
    Option[Vec[NodeId]],
    Error,
] {
    let _ = graph.node(start)?;
    let _ = graph.node(target)?;
    let seen: HashMap[NodeId, bool] = HashMap::new();
    let previous: HashMap[NodeId, NodeId] = HashMap::new();
    let queue: collections::Deque[NodeId] = collections::Deque::new();
    seen.set(start, true);
    queue.push_back(start);
    while let Some(node) = queue.pop_front() {
        if node == target {
            return Result::Ok(reconstruct(start, target, previous))
        }
        for neighbor in graph.neighbors(node)? {
            if !seen.contains(neighbor.node) {
                seen.set(neighbor.node, true);
                previous.set(neighbor.node, node);
                queue.push_back(neighbor.node);
            }
        }
    }
    Result::Ok(Option::None)
}

fn reconstruct(start: NodeId, target: NodeId, previous: HashMap[NodeId, NodeId]) -> Option[
    Vec[NodeId],
] {
    let path = Vec::from_array([target]);
    let mut node = target;
    while node != start {
        if path.len() > previous.len() {
            return Option::None
        }
        node = previous.get(node)?;
        path.push(node);
    }
    path.reverse();
    Option::Some(path)
}
