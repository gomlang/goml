package graph;

use std::collections;
use std::num;

pub struct Paths {
    source: NodeId,
    distances: HashMap[NodeId, i64],
    previous: HashMap[NodeId, NodeId],
    previous_edges: HashMap[NodeId, EdgeId],
}

pub struct Route {
    pub cost: i64,
    pub nodes: Vec[NodeId],
    pub edges: Vec[EdgeId],
}

impl Paths {
    pub fn start(self: Paths) -> NodeId {
        self.source
    }

    pub fn distance_to(self: Paths, target: NodeId) -> Option[i64] {
        self.distances.get(target)
    }

    pub fn path_to(self: Paths, target: NodeId) -> Option[Vec[NodeId]] {
        let _ = self.distance_to(target)?;
        reconstruct(self.source, target, self.previous)
    }

    pub fn route_to(self: Paths, target: NodeId) -> Option[Route] {
        let cost = self.distance_to(target)?;
        let nodes = self.path_to(target)?;
        let edges: Vec[EdgeId] = Vec::new();
        for index in 1..nodes.len() {
            edges.push(self.previous_edges.get(nodes[index])?);
        }
        Option::Some(Route { cost, nodes, edges })
    }

    pub fn reachable(self: Paths) -> Vec[NodeId] {
        let result: Vec[NodeId] = Vec::new();
        for (node, _) in self.distances.entries() {
            result.push(node);
        }
        result.sort_by(|left, right| left.slot - right.slot);
        result
    }
}

fn new_paths(start: NodeId) -> Paths {
    let distances: HashMap[NodeId, i64] = HashMap::new();
    distances.set(start, 0);
    Paths { source: start, distances, previous: HashMap::new(), previous_edges: HashMap::new() }
}

fn sum(left: i64, right: i64) -> Result[i64, Error] {
    num::checked_add_int64(left, right).ok_or(
        error(ErrorKind::Overflow, "path cost exceeds i64 range"),
    )
}

fn weighted_search[N, E](
    graph: Graph[N, E],
    start: NodeId,
    target: Option[NodeId],
    weight: (E) -> i64,
    heuristic: (NodeId) -> i64,
) -> Result[Paths, Error] {
    let _ = graph.node(start)?;
    let estimates: HashMap[NodeId, i64] = HashMap::new();
    for node in graph.nodes() {
        let estimate = heuristic(node.0);
        if estimate < 0 {
            return Result::Err(error(ErrorKind::InvalidArgument, "heuristic must be nonnegative"))
        }
        estimates.set(node.0, estimate);
    }
    if let Some(target) = target {
        let _ = graph.node(target)?;
        if estimates.get(target).unwrap_or(-1) != 0 {
            return Result::Err(error(ErrorKind::InvalidArgument, "target heuristic must be zero"))
        }
    }
    let weights: HashMap[EdgeId, i64] = HashMap::new();
    for edge in graph.edges() {
        let cost = weight(edge.value);
        if cost < 0 {
            return Result::Err(error(ErrorKind::NegativeWeight, f"negative weight on {edge.id}"))
        }
        weights.set(edge.id, cost);
    }
    let paths = new_paths(start);
    let heap: collections::BinaryHeap[(i64, isize)] = collections::BinaryHeap::new();
    heap.push((-estimates.get(start).unwrap_or(0), -start.slot));
    while let Some((priority, slot)) = heap.pop() {
        let node = NodeId { slot: -slot, owner: graph.identity };
        let distance = paths.distances.get(node).ok_or(
            error(ErrorKind::InvalidNode, "missing frontier node"),
        )?;
        if sum(distance, estimates.get(node).unwrap_or(0))? != -priority {
            continue;
        }
        if target == Option::Some(node) {
            return Result::Ok(paths)
        }
        for neighbor in graph.neighbors(node)? {
            let cost = weights.get(neighbor.edge).ok_or(
                error(ErrorKind::InvalidEdge, "graph changed during search"),
            )?;
            let candidate = sum(distance, cost)?;
            let improve = match paths.distances.get(neighbor.node) {
                Some(previous) => candidate < previous,
                None => true,
            };
            if improve {
                let priority = sum(candidate, estimates.get(neighbor.node).unwrap_or(0))?;
                paths.distances.set(neighbor.node, candidate);
                paths.previous.set(neighbor.node, node);
                paths.previous_edges.set(neighbor.node, neighbor.edge);
                heap.push((-priority, -neighbor.node.slot));
            }
        }
    }
    Result::Ok(paths)
}

pub fn dijkstra[N, E](graph: Graph[N, E], start: NodeId, weight: (E) -> i64) -> Result[Paths, Error] {
    weighted_search(graph, start, Option::None, weight, |_| 0)
}

pub fn astar[N, E](
    graph: Graph[N, E],
    start: NodeId,
    target: NodeId,
    weight: (E) -> i64,
    heuristic: (NodeId) -> i64,
) -> Result[Option[Route], Error] {
    Result::Ok(
        weighted_search(graph, start, Option::Some(target), weight, heuristic)?.route_to(target),
    )
}

fn relax(paths: Paths, from: NodeId, to: NodeId, edge: EdgeId, cost: i64, commit: bool) -> Result[
    bool,
    Error,
] {
    let Some(distance) = paths.distances.get(from) else {
        return Result::Ok(false)
    };
    let candidate = sum(distance, cost)?;
    let improve = match paths.distances.get(to) {
        Some(previous) => candidate < previous,
        None => true,
    };
    if improve && commit {
        paths.distances.set(to, candidate);
        paths.previous.set(to, from);
        paths.previous_edges.set(to, edge);
    }
    Result::Ok(improve)
}

pub fn bellman_ford[N, E](graph: Graph[N, E], start: NodeId, weight: (E) -> i64) -> Result[
    Paths,
    Error,
] {
    let _ = graph.node(start)?;
    let paths = new_paths(start);
    let edges: Vec[(Edge[E], i64)] = Vec::new();
    for edge in graph.edges() {
        edges.push((edge, weight(edge.value)));
    }
    for _ in 1..graph.node_count() {
        let mut changed = false;
        for (edge, cost) in edges {
            if relax(paths, edge.from, edge.to, edge.id, cost, true)? {
                changed = true;
            }
            if !graph.is_directed() && relax(paths, edge.to, edge.from, edge.id, cost, true)? {
                changed = true;
            }
        }
        if !changed {
            break;
        }
    }
    for (edge, cost) in edges {
        if relax(paths, edge.from, edge.to, edge.id, cost, false)?
            || (!graph.is_directed() && relax(paths, edge.to, edge.from, edge.id, cost, false)?) {
            return Result::Err(error(ErrorKind::NegativeCycle, "reachable negative-weight cycle"))
        }
    }
    Result::Ok(paths)
}
