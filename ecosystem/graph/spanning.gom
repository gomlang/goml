package graph;

pub struct UnionFind {
    parents: Vec[isize],
    sizes: Vec[isize],
    components_value: Ref[isize],
}

impl UnionFind {
    pub fn new(size: isize) -> Result[UnionFind, Error] {
        if size < 0 {
            return Result::Err(
                error(ErrorKind::InvalidArgument, "union-find size must be nonnegative"),
            )
        }
        let parents: Vec[isize] = Vec::with_capacity(size);
        let sizes: Vec[isize] = Vec::with_capacity(size);
        for index in 0..size {
            parents.push(index);
            sizes.push(1);
        }
        Result::Ok(UnionFind { parents, sizes, components_value: Ref::new(size) })
    }

    pub fn len(self: UnionFind) -> isize {
        self.parents.len()
    }

    pub fn components(self: UnionFind) -> isize {
        self.components_value.get()
    }

    pub fn add(self: UnionFind) -> isize {
        let index = self.parents.len();
        self.parents.push(index);
        self.sizes.push(1);
        self.components_value.set(self.components() + 1);
        index
    }

    pub fn find(self: UnionFind, index: isize) -> Result[isize, Error] {
        if index < 0 || index >= self.parents.len() {
            return Result::Err(error(ErrorKind::InvalidArgument, "union-find index out of bounds"))
        }
        let mut root = index;
        while root != self.parents[root] {
            root = self.parents[root];
        }
        let mut current = index;
        while current != root {
            let parent = self.parents[current];
            self.parents[current] = root;
            current = parent;
        }
        Result::Ok(root)
    }

    pub fn union(self: UnionFind, left: isize, right: isize) -> Result[bool, Error] {
        let mut left = self.find(left)?;
        let mut right = self.find(right)?;
        if left == right {
            return Result::Ok(false)
        }
        if self.sizes[left] < self.sizes[right] {
            let previous = left;
            left = right;
            right = previous;
        }
        self.parents[right] = left;
        self.sizes[left] += self.sizes[right];
        self.components_value.set(self.components() - 1);
        Result::Ok(true)
    }

    pub fn connected(self: UnionFind, left: isize, right: isize) -> Result[bool, Error] {
        Result::Ok(self.find(left)? == self.find(right)?)
    }

    pub fn size(self: UnionFind, index: isize) -> Result[isize, Error] {
        Result::Ok(self.sizes[self.find(index)?])
    }
}

pub struct Forest {
    pub edges: Vec[EdgeId],
    pub cost: i64,
    pub components: isize,
}

pub fn minimum_spanning_forest[N, E](graph: Graph[N, E], weight: (E) -> i64) -> Result[
    Forest,
    Error,
] {
    if graph.is_directed() {
        return Result::Err(
            error(ErrorKind::RequiresUndirected, "spanning forest requires an undirected graph"),
        )
    }
    let weighted: Vec[(i64, Edge[E])] = Vec::new();
    for edge in graph.edges() {
        weighted.push((weight(edge.value), edge));
    }
    weighted.sort_by(
        |left, right| {
            if left.0 < right.0 {
                -1
            } else if left.0 > right.0 {
                1
            } else {
                left.1.id.slot - right.1.id.slot
            }
        },
    );
    let sets = UnionFind::new(graph.node_slots.len())?;
    let edges: Vec[EdgeId] = Vec::new();
    let mut cost: i64 = 0;
    let mut components = graph.node_count();
    for (weight, edge) in weighted {
        if sets.union(edge.from.slot, edge.to.slot)? {
            edges.push(edge.id);
            cost = sum(cost, weight)?;
            components -= 1;
        }
    }
    Result::Ok(Forest { edges, cost, components })
}
