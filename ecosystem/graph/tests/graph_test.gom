package tests;

use ecosystem::graph;
use std::testing;

#[test]
fn mutation_identity_loops_and_parallel_edges() -> () {
    let value: graph::Graph[string, i64] = graph::Graph::new(false);
    let a = value.add_node("a");
    let b = value.add_node("b");
    let e1 = testing::expect_ok(value.add_edge(a, b, 3), "edge");
    let e2 = testing::expect_ok(value.add_edge(b, a, 4), "parallel");
    let loop_edge = testing::expect_ok(value.add_edge(a, a, 1), "loop");
    testing::assert_eq(value.edge_count(), 3);
    testing::assert_eq(testing::expect_ok(value.neighbors(a), "neighbors").len(), 3);
    testing::assert_eq(testing::expect_ok(value.edges_between(a, b), "parallel count").len(), 2);
    let foreign: graph::Graph[string, i64] = graph::Graph::new(false);
    let other = foreign.add_node("a");
    testing::assert(a != other);
    testing::assert_eq(
        testing::expect_err(value.add_edge(a, other, 1), "foreign node").kind,
        graph::ErrorKind::WrongGraph,
    );
    testing::assert_eq(testing::expect_ok(value.set_node(a, "renamed"), "replace"), "a");
    testing::assert_eq(testing::expect_ok(value.set_edge(e1, 8), "weight"), 3);
    testing::assert_eq(testing::expect_ok(value.remove_node(a), "remove"), "renamed");
    testing::assert_eq(value.edge_count(), 0);
    testing::assert_eq(value.node_count(), 1);
    testing::assert(
        !value.contains_edge(e1) && !value.contains_edge(e2) && !value.contains_edge(loop_edge),
    );
    testing::assert_eq(testing::expect_ok(value.neighbors(b), "remaining").len(), 0);
    let c = value.add_node("c");
    testing::assert(c.index() > b.index());
    testing::assert_err(value.node(a));
    testing::assert_err(value.remove_edge(e1));
    value.clear();
    testing::assert_eq(value.node_count(), 0);
    testing::assert_err(value.node(c));
}

#[test]
fn traversal_components_and_topological_order() -> () {
    let value: graph::Graph[isize, ()] = graph::Graph::new(true);
    let a = value.add_node(0);
    let b = value.add_node(1);
    let c = value.add_node(2);
    let d = value.add_node(3);
    let isolated = value.add_node(4);
    testing::assert_ok(value.add_edge(a, b, ()));
    testing::assert_ok(value.add_edge(a, c, ()));
    testing::assert_ok(value.add_edge(b, d, ()));
    testing::assert_ok(value.add_edge(c, d, ()));
    testing::assert(
        testing::expect_ok(graph::bfs(value, a), "bfs") == Vec::from_array([a, b, c, d]),
    );
    testing::assert(
        testing::expect_ok(graph::dfs(value, a), "dfs") == Vec::from_array([a, b, d, c]),
    );
    let order = testing::expect_ok(graph::topological_sort(value), "topological order");
    for edge in value.edges() {
        testing::assert(
            order.position(|node| node == edge.from).unwrap_or(-1)
                < order.position(|node| node == edge.to).unwrap_or(-1),
        );
    }
    testing::assert_eq(testing::expect_ok(graph::weak_components(value), "weak").len(), 2);
    testing::assert_eq(testing::expect_ok(graph::strong_components(value), "strong").len(), 5);
    testing::assert_none(
        testing::expect_ok(graph::unweighted_path(value, a, isolated), "unreachable"),
    );
    testing::assert(
        testing::expect_some(
            testing::expect_ok(graph::unweighted_path(value, a, d), "path"),
            "reachable",
        )
            == Vec::from_array([a, b, d]),
    );
    testing::assert_ok(value.add_edge(d, a, ()));
    testing::assert_eq(
        testing::expect_err(graph::topological_sort(value), "cycle").kind,
        graph::ErrorKind::Cycle,
    );
    testing::assert_eq(testing::expect_ok(graph::strong_components(value), "strong cycle").len(), 2);
}

#[test]
fn weighted_paths_astar_and_negative_edges() -> () {
    let value: graph::Graph[isize, i64] = graph::Graph::new(true);
    let a = value.add_node(0);
    let b = value.add_node(1);
    let c = value.add_node(2);
    let d = value.add_node(3);
    testing::assert_ok(value.add_edge(a, b, 10));
    let ac = testing::expect_ok(value.add_edge(a, c, 2), "ac");
    let cb = testing::expect_ok(value.add_edge(c, b, 1), "cb");
    let bd = testing::expect_ok(value.add_edge(b, d, 3), "bd");
    testing::assert_ok(value.add_edge(c, d, 12));
    let paths = testing::expect_ok(graph::dijkstra(value, a, |cost| cost), "dijkstra");
    let route = testing::expect_some(paths.route_to(d), "route");
    testing::assert_eq(route.cost, 6);
    testing::assert(route.nodes == Vec::from_array([a, c, b, d]));
    testing::assert(route.edges == Vec::from_array([ac, cb, bd]));
    testing::assert_eq(paths.reachable().len(), 4);
    let route = testing::expect_some(
        testing::expect_ok(
            graph::astar(
                value,
                a,
                d,
                |cost| cost,
                |node| if node == d {
                    0
                } else if node == b {
                    3
                } else {
                    1
                },
            ),
            "astar",
        ),
        "astar route",
    );
    testing::assert_eq(route.cost, 6);
    testing::assert_err(graph::astar(value, a, d, |cost| cost, |_| 1));
    testing::assert_ok(value.set_edge(cb, -1));
    testing::assert_eq(
        testing::expect_err(graph::dijkstra(value, a, |cost| cost), "negative").kind,
        graph::ErrorKind::NegativeWeight,
    );
    let paths = testing::expect_ok(graph::bellman_ford(value, a, |cost| cost), "bellman ford");
    testing::assert_eq(paths.distance_to(d).unwrap_or(-1), 4);
    testing::assert_ok(value.add_edge(b, c, 0));
    testing::assert_eq(
        testing::expect_err(graph::bellman_ford(value, a, |cost| cost), "negative cycle").kind,
        graph::ErrorKind::NegativeCycle,
    );
}

#[test]
fn overflow_unreachable_cycles_and_zero_paths() -> () {
    let value: graph::Graph[(), i64] = graph::Graph::new(true);
    let a = value.add_node(());
    let b = value.add_node(());
    let c = value.add_node(());
    testing::assert_ok(value.add_edge(b, c, -2));
    testing::assert_ok(value.add_edge(c, b, 1));
    let paths = testing::expect_ok(graph::bellman_ford(value, a, |cost| cost), "unreachable cycle");
    testing::assert_none(paths.path_to(b));
    testing::assert_eq(testing::expect_some(paths.route_to(a), "self").cost, 0);
    value.clear();
    let a = value.add_node(());
    let b = value.add_node(());
    let c = value.add_node(());
    testing::assert_ok(value.add_edge(a, b, 9223372036854775807));
    testing::assert_ok(value.add_edge(b, c, 1));
    testing::assert_eq(
        testing::expect_err(graph::dijkstra(value, a, |cost| cost), "overflow").kind,
        graph::ErrorKind::Overflow,
    );
}

#[test]
fn spanning_forest_and_union_find() -> () {
    let value: graph::Graph[string, i64] = graph::Graph::new(false);
    let a = value.add_node("a");
    let b = value.add_node("b");
    let c = value.add_node("c");
    let _ = value.add_node("isolated");
    testing::assert_ok(value.add_edge(a, b, 9));
    let ac = testing::expect_ok(value.add_edge(a, c, -2), "ac");
    let bc = testing::expect_ok(value.add_edge(b, c, 1), "bc");
    testing::assert_ok(value.add_edge(a, a, -100));
    let forest = testing::expect_ok(graph::minimum_spanning_forest(value, |cost| cost), "forest");
    testing::assert(forest.edges == Vec::from_array([ac, bc]));
    testing::assert_eq(forest.cost, -1);
    testing::assert_eq(forest.components, 2);
    let sets = testing::expect_ok(graph::UnionFind::new(5), "sets");
    testing::assert(testing::expect_ok(sets.union(0, 1), "union"));
    testing::assert(testing::expect_ok(sets.union(1, 2), "union"));
    testing::assert(!testing::expect_ok(sets.union(0, 2), "already connected"));
    testing::assert_eq(testing::expect_ok(sets.size(2), "size"), 3);
    testing::assert_eq(sets.components(), 3);
    testing::assert_eq(sets.add(), 5);
    testing::assert_eq(sets.components(), 4);
    testing::assert_err(sets.find(-1));
    testing::assert_err(sets.union(0, 10));
}

#[test]
fn generic_mapping_and_copy_are_independent() -> () {
    let value: graph::Graph[isize, isize] = graph::Graph::new(true);
    let a = value.add_node(1);
    let b = value.add_node(2);
    let edge = testing::expect_ok(value.add_edge(a, b, 3), "edge");
    let offset = 10;
    let copied = testing::expect_ok(
        value.map(|label| (label + offset).to_string(), |weight| weight.to_i64()),
        "map",
    );
    let mapped = testing::expect_some(copied.nodes.get(a), "node map");
    testing::assert_eq(testing::expect_ok(copied.graph.node(mapped), "label"), "11");
    testing::assert_err(copied.graph.node(a));
    testing::assert_ok(value.remove_edge(edge));
    testing::assert_eq(copied.graph.edge_count(), 1);
    testing::assert_ok(value.remove_node(a));
    testing::assert_eq(copied.graph.node_count(), 2);
}
