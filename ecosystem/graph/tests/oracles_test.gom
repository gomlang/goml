package tests;

use ecosystem::graph;
use std::testing;

fn closure(matrix: Vec[bool], size: isize) -> () {
    for k in 0..size {
        for i in 0..size {
            for j in 0..size {
                if matrix[i * size + k] && matrix[k * size + j] {
                    matrix[i * size + j] = true;
                }
            }
        }
    }
}

#[test]
fn exhaustive_three_node_reachability_and_components() -> () {
    for mask in 0..64 {
        let value: graph::Graph[isize, ()] = graph::Graph::new(true);
        let nodes = Vec::from_array([value.add_node(0), value.add_node(1), value.add_node(2)]);
        let reach = Vec::from_array([false, false, false, false, false, false, false, false, false]);
        let mut bit: isize = 1;
        for i in 0..3 {
            for j in 0..3 {
                if i != j {
                    if (mask / bit) % 2 == 1 {
                        testing::assert_ok(value.add_edge(nodes[i], nodes[j], ()));
                        reach[i * 3 + j] = true;
                    }
                    bit *= 2;
                }
            }
        }
        closure(reach, 3);
        let mut cyclic = false;
        for i in 0..3 {
            cyclic = cyclic || reach[i * 3 + i];
        }
        testing::assert_eq(graph::topological_sort(value).is_err(), cyclic);
        let groups = testing::expect_ok(graph::strong_components(value), "scc");
        let membership = Vec::from_array([-1, -1, -1]);
        for i in 0..groups.len() {
            for node in groups[i] {
                testing::assert_eq(membership[node.index()], -1);
                membership[node.index()] = i;
            }
        }
        for i in 0..3 {
            let bfs = testing::expect_ok(graph::bfs(value, nodes[i]), "bfs");
            let dfs = testing::expect_ok(graph::dfs(value, nodes[i]), "dfs");
            testing::assert(membership[i] >= 0);
            for j in 0..3 {
                let reachable = i == j || reach[i * 3 + j];
                testing::assert_eq(bfs.position(|node| node == nodes[j]).is_some(), reachable);
                testing::assert_eq(dfs.position(|node| node == nodes[j]).is_some(), reachable);
                testing::assert_eq(
                    membership[i] == membership[j],
                    i == j || (reach[i * 3 + j] && reach[j * 3 + i]),
                );
            }
        }
    }
}

#[test]
fn weighted_search_matches_floyd_warshall() -> () {
    let mut seed: isize = 761;
    for sample in 0..80 {
        let size: isize = 6;
        let value: graph::Graph[isize, i64] = graph::Graph::new(sample % 2 == 0);
        let nodes: Vec[graph::NodeId] = Vec::new();
        let matrix: Vec[i64] = Vec::new();
        for i in 0..size {
            nodes.push(value.add_node(i));
            for j in 0..size {
                matrix.push(
                    if i == j {
                        0
                    } else {
                        1000000
                    },
                );
            }
        }
        for _ in 0..28 {
            seed = (seed * 48271) % 2147483647;
            let from = seed % size;
            seed = (seed * 48271) % 2147483647;
            let to = seed % size;
            seed = (seed * 48271) % 2147483647;
            let cost = (seed % 19).to_i64();
            testing::assert_ok(value.add_edge(nodes[from], nodes[to], cost));
            if cost < matrix[from * size + to] {
                matrix[from * size + to] = cost;
            }
            if !value.is_directed() && cost < matrix[to * size + from] {
                matrix[to * size + from] = cost;
            }
        }
        for k in 0..size {
            for i in 0..size {
                for j in 0..size {
                    let cost = matrix[i * size + k] + matrix[k * size + j];
                    if cost < matrix[i * size + j] {
                        matrix[i * size + j] = cost;
                    }
                }
            }
        }
        for i in 0..size {
            let shortest = testing::expect_ok(
                graph::dijkstra(value, nodes[i], |cost| cost),
                "dijkstra",
            );
            let bellman = testing::expect_ok(
                graph::bellman_ford(value, nodes[i], |cost| cost),
                "bellman",
            );
            for j in 0..size {
                let expected = matrix[i * size + j];
                testing::assert_eq(shortest.distance_to(nodes[j]).unwrap_or(1000000), expected);
                testing::assert_eq(bellman.distance_to(nodes[j]).unwrap_or(1000000), expected);
                if let Some(route) = shortest.route_to(nodes[j]) {
                    testing::assert_eq(route.nodes.len(), route.edges.len() + 1);
                    testing::assert_eq(route.nodes[0], nodes[i]);
                    testing::assert_eq(route.nodes[route.nodes.len() - 1], nodes[j]);
                    let mut cost: i64 = 0;
                    for n in 0..route.edges.len() {
                        let edge = testing::expect_ok(value.edge(route.edges[n]), "route edge");
                        let forward = edge.from == route.nodes[n] && edge.to == route.nodes[n + 1];
                        let reverse = !value.is_directed() && edge.to == route.nodes[n]
                            && edge.from == route.nodes[n + 1];
                        testing::assert(forward || reverse);
                        cost += edge.value;
                    }
                    testing::assert_eq(cost, expected);
                } else {
                    testing::assert_eq(expected, 1000000);
                }
            }
        }
    }
}

#[test]
fn spanning_tree_matches_exhaustive_edge_subsets() -> () {
    let pairs = Vec::from_array([(0, 1), (0, 2), (0, 3), (1, 2), (1, 3), (2, 3)]);
    for sample in 0..32 {
        let value: graph::Graph[(), i64] = graph::Graph::new(false);
        let nodes = Vec::from_array(
            [value.add_node(()), value.add_node(()), value.add_node(()), value.add_node(())],
        );
        let costs: Vec[i64] = Vec::new();
        for index in 0..pairs.len() {
            let cost = ((sample * (index + 3) + index * index) % 17 - 8).to_i64();
            costs.push(cost);
            testing::assert_ok(value.add_edge(nodes[pairs[index].0], nodes[pairs[index].1], cost));
        }
        let mut best: i64 = 1000000;
        for mask in 0..64 {
            let reach: Vec[bool] = Vec::new();
            for _ in 0..16 {
                reach.push(false);
            }
            let mut bit: isize = 1;
            let mut count: isize = 0;
            let mut cost: i64 = 0;
            for index in 0..6 {
                if (mask / bit) % 2 == 1 {
                    count += 1;
                    cost += costs[index];
                    let (i, j) = pairs[index];
                    reach[i * 4 + j] = true;
                    reach[j * 4 + i] = true;
                }
                bit *= 2;
            }
            if count == 3 {
                closure(reach, 4);
                if reach[1] && reach[2] && reach[3] && cost < best {
                    best = cost;
                }
            }
        }
        let result = testing::expect_ok(
            graph::minimum_spanning_forest(value, |cost| cost),
            "forest",
        );
        testing::assert_eq(result.cost, best);
        testing::assert_eq(result.edges.len(), 3);
        testing::assert_eq(result.components, 1);
    }
}

#[test]
fn astar_reopens_with_inconsistent_admissible_heuristic() -> () {
    let value: graph::Graph[(), i64] = graph::Graph::new(true);
    let s = value.add_node(());
    let a = value.add_node(());
    let b = value.add_node(());
    let t = value.add_node(());
    testing::assert_ok(value.add_edge(s, a, 3));
    testing::assert_ok(value.add_edge(s, b, 1));
    testing::assert_ok(value.add_edge(b, a, 1));
    testing::assert_ok(value.add_edge(a, t, 3));
    let route = testing::expect_some(
        testing::expect_ok(
            graph::astar(
                value,
                s,
                t,
                |cost| cost,
                |node| if node == b {
                    4
                } else {
                    0
                },
            ),
            "reopen",
        ),
        "reachable",
    );
    testing::assert_eq(route.cost, 5);
    testing::assert(route.nodes == Vec::from_array([s, b, a, t]));
}

#[test]
fn deep_graph_traversals_use_explicit_stacks() -> () {
    let value: graph::Graph[isize, ()] = graph::Graph::new(true);
    let first = value.add_node(0);
    let mut previous = first;
    for index in 1..3000 {
        let next = value.add_node(index);
        testing::assert_ok(value.add_edge(previous, next, ()));
        previous = next;
    }
    testing::assert_eq(testing::expect_ok(graph::dfs(value, first), "deep dfs").len(), 3000);
    testing::assert_eq(testing::expect_ok(graph::strong_components(value), "deep scc").len(), 3000);
    testing::assert_ok(value.add_edge(previous, first, ()));
    testing::assert_eq(testing::expect_ok(graph::strong_components(value), "deep cycle").len(), 1);
}
