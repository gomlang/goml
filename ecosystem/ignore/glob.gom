package ignore;

enum Token {
    Literal(byte),
    Any,
    Star,
    Recursive,
    RecursivePrefix,
    Class(FrozenVec[(byte, byte)], bool),
}

pub struct Glob {
    source: string,
    tokens: FrozenVec[Token],
    limits: Limits,
    insensitive: bool,
}

fn fold(value: byte, insensitive: bool) -> byte {
    if insensitive && value >= b'A' && value <= b'Z' {
        value + 32
    } else {
        value
    }
}

fn named_class(name: string, ranges: Vec[(byte, byte)]) -> Result[(), Error] {
    match name {
        "alnum" => {
            ranges.push((b'0', b'9'));
            ranges.push((b'A', b'Z'));
            ranges.push((b'a', b'z'));
        },
        "alpha" => {
            ranges.push((b'A', b'Z'));
            ranges.push((b'a', b'z'));
        },
        "blank" => {
            ranges.push((b' ', b' '));
            ranges.push((b'\t', b'\t'));
        },
        "cntrl" => {
            ranges.push((0, 31));
            ranges.push((127, 127));
        },
        "digit" => ranges.push((b'0', b'9')),
        "graph" => ranges.push((33, 126)),
        "lower" => ranges.push((b'a', b'z')),
        "print" => ranges.push((32, 126)),
        "punct" => {
            ranges.push((33, 47));
            ranges.push((58, 64));
            ranges.push((91, 96));
            ranges.push((123, 126));
        },
        "space" => {
            ranges.push((9, 13));
            ranges.push((32, 32));
        },
        "upper" => ranges.push((b'A', b'Z')),
        "xdigit" => {
            ranges.push((b'0', b'9'));
            ranges.push((b'A', b'F'));
            ranges.push((b'a', b'f'));
        },
        _ => return Result::Err(failure(ErrorKind::InvalidPattern, "unknown POSIX character class")),
    }
    Result::Ok(())
}

fn class_byte(pattern: string, index: isize) -> Result[(byte, isize), Error] {
    let value = pattern.byte_get(index);
    if value == b'\\' {
        if index + 1 == pattern.byte_len() {
            return Result::Err(
                failure(ErrorKind::InvalidPattern, "trailing escape in character class"),
            )
        }
        Result::Ok((pattern.byte_get(index + 1), index + 2))
    } else {
        Result::Ok((value, index + 1))
    }
}

fn parse_class(pattern: string, start: isize) -> Result[(Token, isize), Error] {
    let mut index = start + 1;
    let mut negate = false;
    if index < pattern.byte_len()
        && (pattern.byte_get(index) == b'!' || pattern.byte_get(index) == b'^') {
        negate = true;
        index += 1;
    }
    let ranges: Vec[(byte, byte)] = Vec::new();
    if index < pattern.byte_len() && pattern.byte_get(index) == b']' {
        ranges.push((b']', b']'));
        index += 1;
    }
    while index < pattern.byte_len() && pattern.byte_get(index) != b']' {
        if index + 1 < pattern.byte_len() && pattern.byte_get(index) == b'['
            && pattern.byte_get(index + 1) == b':' {
            let mut end = index + 2;
            while end + 1 < pattern.byte_len()
                && !(pattern.byte_get(end) == b':' && pattern.byte_get(end + 1) == b']') {
                end += 1;
            }
            if end + 1 >= pattern.byte_len() {
                return Result::Err(failure(ErrorKind::InvalidPattern, "unterminated POSIX class"))
            }
            named_class(pattern.byte_slice(index + 2, end), ranges)?;
            index = end + 2;
            continue;
        }
        let (low, next) = class_byte(pattern, index)?;
        index = next;
        if index + 1 < pattern.byte_len() && pattern.byte_get(index) == b'-'
            && pattern.byte_get(index + 1) != b']' {
            let (high, next) = class_byte(pattern, index + 1)?;
            ranges.push((low, high));
            index = next;
        } else {
            ranges.push((low, low));
        }
    }
    if index == pattern.byte_len() || ranges.is_empty() {
        Result::Err(failure(ErrorKind::InvalidPattern, "unterminated or empty character class"))
    } else {
        Result::Ok((Token::Class(ranges.freeze(), negate), index + 1))
    }
}

impl Glob {
    pub fn new(pattern: string) -> Result[Glob, Error] {
        Glob::with_options(pattern, Limits::standard(), false)
    }

    pub fn with_options(pattern: string, limits: Limits, ascii_case_insensitive: bool) -> Result[
        Glob,
        Error,
    ] {
        limits.validate()?;
        if pattern.byte_len() > limits.max_pattern_bytes {
            return Result::Err(failure(ErrorKind::Limit, "pattern byte limit exceeded"))
        }
        if pattern.contains("\u0000") {
            return Result::Err(failure(ErrorKind::InvalidPattern, "pattern contains NUL"))
        }
        let tokens: Vec[Token] = Vec::new();
        let mut index = 0;
        while index < pattern.byte_len() {
            let value = pattern.byte_get(index);
            if value == b'\\' {
                if index + 1 == pattern.byte_len() {
                    return Result::Err(failure(ErrorKind::InvalidPattern, "trailing escape"))
                }
                tokens.push(Token::Literal(pattern.byte_get(index + 1)));
                index += 2;
            } else if value == b'[' {
                let (token, next) = parse_class(pattern, index)?;
                tokens.push(token);
                index = next;
            } else if value == b'?' {
                tokens.push(Token::Any);
                index += 1;
            } else if value == b'*' {
                let mut end = index + 1;
                while end < pattern.byte_len() && pattern.byte_get(end) == b'*' {
                    end += 1;
                }
                let recursive = end - index >= 2
                    && (index == 0 || pattern.byte_get(index - 1) == b'/')
                    && (end == pattern.byte_len() || pattern.byte_get(end) == b'/');
                if recursive && end < pattern.byte_len() {
                    tokens.push(Token::RecursivePrefix);
                    end += 1;
                } else if recursive {
                    tokens.push(Token::Recursive);
                } else {
                    tokens.push(Token::Star);
                }
                index = end;
            } else {
                tokens.push(Token::Literal(value));
                index += 1;
            }
        }
        Result::Ok(
            Glob {
                source: pattern,
                tokens: tokens.freeze(),
                limits,
                insensitive: ascii_case_insensitive,
            },
        )
    }

    pub fn pattern(self: Glob) -> string {
        self.source
    }

    pub fn is_match(self: Glob, path: string) -> Result[bool, Error] {
        if path.byte_len() > self.limits.max_path_bytes || path.byte_len() == 9223372036854775807 {
            return Result::Err(failure(ErrorKind::Limit, "path byte limit exceeded"))
        }
        self.matches_budget(path, Ref::new(self.limits.max_match_steps))
    }

    fn matches_budget(self: Glob, path: string, budget: Ref[isize]) -> Result[bool, Error] {
        let width = path.byte_len() + 1;
        for token in self.tokens.iter() {
            let cost = match token {
                Class(ranges, _) => ranges.len() + 1,
                _ => 1,
            };
            if cost > budget.get() / width {
                return Result::Err(failure(ErrorKind::Limit, "matching work limit exceeded"))
            }
            budget.set(budget.get() - cost * width);
        }
        let mut previous: Vec[bool] = Vec::new();
        for index in 0..width {
            previous.push(index == 0);
        }
        for token in self.tokens.iter() {
            let current: Vec[bool] = Vec::new();
            let mut prefix = false;
            for index in 0..width {
                let value = if index > 0 {
                    path.byte_get(index - 1)
                } else {
                    0
                };
                let matched = match token {
                    Literal(expected) => index > 0 && previous[index - 1]
                        && fold(value, self.insensitive) == fold(expected, self.insensitive),
                    Any => index > 0 && previous[index - 1] && value != b'/',
                    Star => previous[index] || (index > 0 && current[index - 1] && value != b'/'),
                    Recursive => previous[index] || (index > 0 && current[index - 1]),
                    RecursivePrefix => previous[index] || (index > 0 && prefix && value == b'/'),
                    Class(ranges, negated) => {
                        let mut contained = false;
                        for (low, high) in ranges.iter() {
                            let folded = fold(value, self.insensitive);
                            let upper = if self.insensitive && folded >= b'a' && folded <= b'z' {
                                folded - 32
                            } else {
                                folded
                            };
                            if value >= low && value <= high || folded >= low && folded <= high
                                || upper >= low && upper <= high {
                                contained = true;
                            }
                        }
                        index > 0 && previous[index - 1] && value != b'/' && contained != negated
                    },
                };
                current.push(matched);
                prefix = prefix || previous[index];
            }
            previous = current;
        }
        Result::Ok(previous[path.byte_len()])
    }
}

pub struct GlobSet {
    values: FrozenVec[Glob],
    limits: Limits,
}

impl GlobSet {
    pub fn new(patterns: Vec[string]) -> Result[GlobSet, Error] {
        GlobSet::with_options(patterns, Limits::standard(), false)
    }

    pub fn with_options(patterns: Vec[string], limits: Limits, ascii_case_insensitive: bool) -> Result[
        GlobSet,
        Error,
    ] {
        limits.validate()?;
        if patterns.len() > limits.max_rules {
            return Result::Err(failure(ErrorKind::Limit, "glob count limit exceeded"))
        }
        let values: Vec[Glob] = Vec::new();
        for pattern in patterns {
            values.push(Glob::with_options(pattern, limits, ascii_case_insensitive)?);
        }
        Result::Ok(GlobSet { values: values.freeze(), limits })
    }

    pub fn len(self: GlobSet) -> isize {
        self.values.len()
    }

    pub fn matches(self: GlobSet, path: string) -> Result[Vec[isize], Error] {
        if path.byte_len() > self.limits.max_path_bytes {
            return Result::Err(failure(ErrorKind::Limit, "path byte limit exceeded"))
        }
        let result: Vec[isize] = Vec::new();
        let budget = Ref::new(self.limits.max_match_steps);
        for index in 0..self.values.len() {
            if self.values.get(index).matches_budget(path, budget)? {
                result.push(index);
            }
        }
        Result::Ok(result)
    }

    pub fn is_match(self: GlobSet, path: string) -> Result[bool, Error] {
        self.matches(path).map(|values| !values.is_empty())
    }
}
