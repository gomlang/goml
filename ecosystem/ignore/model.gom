package ignore;

use std::io;
use std::fs;

#[derive(PartialEq, Eq, Debug)]
pub enum ErrorKind {
    InvalidPattern,
    InvalidPath,
    InvalidOptions,
    Limit,
    Io,
    Cancelled,
    Cycle,
}

pub struct Error {
    pub kind: ErrorKind,
    pub message: string,
    pub path: string,
    pub line: isize,
    pub cause: Option[io::Error],
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        self.path
            + (if self.line > 0 {
                ":" + self.line.to_string()
            } else {
                ""
            })
            + ": "
            + self.message
    }
}

fn failure(kind: ErrorKind, message: string) -> Error {
    Error { kind, message, path: "", line: 0, cause: Option::None }
}

fn io_failure(path: string, error: io::Error) -> Error {
    Error {
        kind: ErrorKind::Io,
        message: error.to_string(),
        path,
        line: 0,
        cause: Option::Some(error),
    }
}

fn fs_failure(path: string, error: fs::Error) -> Error {
    io_failure(
        path,
        io::Error::new(
            error.kind(),
            error.operation(),
            error.context(),
            error.raw_os_code(),
            error.message(),
        ),
    )
}

#[derive(Debug)]
pub struct Limits {
    pub max_pattern_bytes: isize,
    pub max_path_bytes: isize,
    pub max_rules: isize,
    pub max_source_bytes: isize,
    pub max_match_steps: isize,
}

impl Limits {
    pub fn standard() -> Limits {
        Limits {
            max_pattern_bytes: 4096,
            max_path_bytes: 32768,
            max_rules: 100000,
            max_source_bytes: 1048576,
            max_match_steps: 16777216,
        }
    }

    fn validate(self: Limits) -> Result[(), Error] {
        if self.max_pattern_bytes < 1 || self.max_path_bytes < 1
            || self.max_path_bytes == 9223372036854775807
            || self.max_rules < 1
            || self.max_source_bytes < 1
            || self.max_match_steps < 1 {
            Result::Err(
                failure(
                    ErrorKind::InvalidOptions,
                    "limits must be positive and path bound must leave space for a sentinel",
                ),
            )
        } else {
            Result::Ok(())
        }
    }
}

fn normalize_relative(value: string, limits: Limits) -> Result[string, Error] {
    if value.byte_len() > limits.max_path_bytes {
        return Result::Err(failure(ErrorKind::Limit, "path byte limit exceeded"))
    }
    if value.starts_with("/") || value.contains("\u0000") {
        return Result::Err(failure(ErrorKind::InvalidPath, "expected a relative path without NUL"))
    }
    let parts: Vec[string] = Vec::new();
    for part in value.split("/") {
        if part == ".." {
            return Result::Err(failure(ErrorKind::InvalidPath, "parent traversal is not allowed"))
        }
        if part != "" && part != "." {
            parts.push(part);
        }
    }
    Result::Ok(parts.join("/"))
}
