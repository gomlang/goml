package tests;

use ecosystem::ignore;
use ecosystem::tempfile;
use std::context;
use std::fs;
use std::path;
use std::testing;
use std::task;

fn temporary() -> tempfile::TempDir {
    testing::expect_ok(tempfile::TempDir::new(), "temporary directory")
}

fn write(root: string, name: string, contents: string) -> () {
    let target = path::join(root, name);
    testing::assert_ok(fs::create_dir_all(path::parent(target).unwrap_or(root)));
    testing::assert_ok(fs::write_file_structured(target, contents));
}

fn collect(root: string, options: ignore::WalkOptions) -> Vec[string] {
    let walker = testing::expect_ok(ignore::Walker::new(root, options), "walker");
    let result: Vec[string] = Vec::new();
    while let Some(entry) = walker.next(context::Context::background()) {
        result.push(testing::expect_ok(entry, "walk entry").relative_path());
    }
    testing::assert(walker.next(context::Context::background()).is_none());
    result
}

#[test]
fn walker_reads_hierarchy_prunes_and_honors_custom_excludes() -> () {
    let dir = temporary();
    defer {
        testing::assert_ok(dir.close());
    };
    write(dir.path(), ".gitignore", "*.tmp\nbuild/\n");
    write(dir.path(), ".git/info/exclude", "*.log\n");
    write(dir.path(), "src/.gitignore", "!keep.tmp\n");
    for name in Vec::from_array(
        [
            "main.gom",
            "root.tmp",
            "root.log",
            "src/main.gom",
            "src/keep.tmp",
            "src/drop.tmp",
            "build/main.gom",
            "skip/file.gom",
        ],
    ) {
        write(dir.path(), name, "");
    }
    let options = ignore::WalkOptions {
        exclude: Option::Some(|relative, _| relative == "" || relative == "skip"),
        ..ignore::WalkOptions::standard(),
    };
    let names = collect(dir.path(), options);
    testing::assert(
        names
            == Vec::from_array(
                [
                    "",
                    ".gitignore",
                    "main.gom",
                    "src",
                    "src/.gitignore",
                    "src/keep.tmp",
                    "src/main.gom",
                ],
            ),
    );
    let parent = testing::expect_ok(ignore::Walker::new(dir.path(), options), "another walker");
    let entry = testing::expect_ok(
        testing::expect_some(parent.next(context::Context::background()), "root entry"),
        "root",
    );
    testing::assert_eq(entry.depth(), 0);
    testing::assert(entry.file_type().is_dir());
    testing::assert(!entry.is_symlink());
    testing::assert_eq(entry.path(), dir.path());
    testing::assert_eq(entry.name(), path::file_name(dir.path()).unwrap_or(""));
    parent.close();
    testing::assert(parent.next(context::Context::background()).is_none());
}

#[test]
fn automatic_rules_and_git_pruning_can_be_disabled_independently() -> () {
    let dir = temporary();
    defer {
        testing::assert_ok(dir.close());
    };
    write(dir.path(), ".gitignore", "*.gom\n");
    write(dir.path(), ".git/info/exclude", "*.txt\n");
    write(dir.path(), ".git/source.gom", "");
    write(dir.path(), "main.gom", "");
    write(dir.path(), "notes.txt", "");
    let options = ignore::WalkOptions {
        gitignore: false,
        skip_git: false,
        ..ignore::WalkOptions::standard(),
    };
    let names = collect(dir.path(), options);
    testing::assert(names.contains(".git/source.gom"));
    testing::assert(names.contains("main.gom") && names.contains("notes.txt"));
    let initial = rules("notes.txt\n");
    let names = collect(dir.path(), ignore::WalkOptions { initial, ..options });
    testing::assert(!names.contains("notes.txt"));
    testing::assert(names.contains("main.gom"));
}

#[test]
fn walk_depth_skip_current_directory_and_file_roots() -> () {
    let dir = temporary();
    defer {
        testing::assert_ok(dir.close());
    };
    write(dir.path(), "a/deep/file.gom", "");
    write(dir.path(), "b/file.gom", "");
    let base = ignore::WalkOptions::standard();
    testing::assert(
        collect(dir.path(), ignore::WalkOptions { max_depth: 0, ..base }) == Vec::from_array([""]),
    );
    testing::assert(
        collect(dir.path(), ignore::WalkOptions { max_depth: 1, ..base })
            == Vec::from_array(["", "a", "b"]),
    );
    let walker = testing::expect_ok(ignore::Walker::new(dir.path(), base), "walker");
    let output: Vec[string] = Vec::new();
    while let Some(entry) = walker.next(context::Context::background()) {
        let entry = testing::expect_ok(entry, "entry");
        output.push(entry.relative_path());
        if entry.relative_path() == "a" {
            walker.skip_current_dir();
        }
    }
    testing::assert(output == Vec::from_array(["", "a", "b", "b/file.gom"]));
    testing::assert(
        collect(
            path::join(dir.path(), "b/file.gom"),
            ignore::WalkOptions { initial: rules("*"), ..base },
        )
            == Vec::from_array([""]),
    );
}

#[test]
fn symlink_policy_and_ancestor_cycles_are_explicit() -> () {
    let dir = temporary();
    defer {
        testing::assert_ok(dir.close());
    };
    write(dir.path(), "real/file.gom", "");
    testing::assert_ok(fs::symbolic_link("real", path::join(dir.path(), "alias")));
    testing::assert_ok(fs::symbolic_link("..", path::join(dir.path(), "real/back")));
    let basic = collect(dir.path(), ignore::WalkOptions::standard());
    testing::assert(basic.contains("alias") && !basic.contains("alias/file.gom"));
    let walker = testing::expect_ok(
        ignore::Walker::new(
            dir.path(),
            ignore::WalkOptions {
                symlinks: ignore::Symlinks::Follow,
                ..ignore::WalkOptions::standard(),
            },
        ),
        "follow links",
    );
    let mut cycles = 0;
    let files: Vec[string] = Vec::new();
    while let Some(result) = walker.next(context::Context::background()) {
        match result {
            Ok(entry) => if entry.file_type().is_file() {
                files.push(entry.relative_path());
            },
            Err(error) => {
                testing::assert_eq(error.kind, ignore::ErrorKind::Cycle);
                cycles += 1;
            },
        }
    }
    testing::assert_eq(cycles, 2);
    testing::assert(files == Vec::from_array(["alias/file.gom", "real/file.gom"]));
}

#[test]
fn source_failures_skip_only_the_affected_branch() -> () {
    let dir = temporary();
    defer {
        testing::assert_ok(dir.close());
    };
    write(dir.path(), "bad/.gitignore", "abcdef");
    write(dir.path(), "bad/main.gom", "");
    write(dir.path(), "good/main.gom", "");
    let options = ignore::WalkOptions {
        limits: ignore::Limits { max_source_bytes: 3, ..ignore::Limits::standard() },
        ..ignore::WalkOptions::standard(),
    };
    let walker = testing::expect_ok(ignore::Walker::new(dir.path(), options), "bounded sources");
    let names: Vec[string] = Vec::new();
    let mut failures = 0;
    while let Some(result) = walker.next(context::Context::background()) {
        match result {
            Ok(entry) => names.push(entry.relative_path()),
            Err(error) => {
                testing::assert_eq(error.kind, ignore::ErrorKind::Limit);
                testing::assert(error.path.ends_with("bad/.gitignore"));
                failures += 1;
            },
        }
    }
    testing::assert_eq(failures, 1);
    testing::assert(!names.contains("bad/main.gom") && names.contains("good/main.gom"));
    let missing = testing::expect_ok(
        ignore::Walker::new(path::join(dir.path(), "missing"), options),
        "deferred metadata",
    );
    let error = testing::expect_err(
        testing::expect_some(missing.next(context::Context::background()), "missing error"),
        "error",
    );
    testing::assert_eq(error.kind, ignore::ErrorKind::Io);
    testing::assert(error.cause.is_some());
    testing::assert(missing.next(context::Context::background()).is_none());
}

#[test]
fn walker_limits_apply_to_initial_rules_pending_work_and_matching() -> () {
    let dir = temporary();
    defer {
        testing::assert_ok(dir.close());
    };
    for index in 0..8 {
        write(dir.path(), "file" + index.to_string(), "");
    }
    let base = ignore::WalkOptions::standard();
    testing::assert_err(
        ignore::Walker::new(
            dir.path(),
            ignore::WalkOptions {
                initial: rules("a\nb"),
                limits: ignore::Limits { max_rules: 1, ..base.limits },
                ..base,
            },
        ),
    );
    for options in Vec::from_array(
        [
            ignore::WalkOptions { max_visited: 3, ..base },
            ignore::WalkOptions { max_entries_per_directory: 2, ..base },
        ],
    ) {
        let walker = testing::expect_ok(ignore::Walker::new(dir.path(), options), "bounded walker");
        testing::assert_ok(
            testing::expect_some(walker.next(context::Context::background()), "root"),
        );
        let error = testing::expect_err(
            testing::expect_some(walker.next(context::Context::background()), "limit"),
            "bounded pending entries",
        );
        testing::assert_eq(error.kind, ignore::ErrorKind::Limit);
        testing::assert(walker.next(context::Context::background()).is_none());
        testing::assert_eq(walker.visited_count(), 1);
    }
    let walker = testing::expect_ok(
        ignore::Walker::new(
            dir.path(),
            ignore::WalkOptions {
                initial: rules("file*"),
                limits: ignore::Limits { max_match_steps: 2, ..base.limits },
                ..base,
            },
        ),
        "bounded matches",
    );
    testing::assert_ok(testing::expect_some(walker.next(context::Context::background()), "root"));
    testing::assert_eq(
        testing::expect_err(
            testing::expect_some(walker.next(context::Context::background()), "match limit"),
            "match limit",
        ).kind,
        ignore::ErrorKind::Limit,
    );
    walker.close();
    testing::assert_err(
        ignore::Walker::new(dir.path(), ignore::WalkOptions { max_depth: -1, ..base }),
    );
    testing::assert_err(ignore::Walker::new("", base));
}

#[test]
fn cancelled_walk_is_fused_and_does_no_more_io() -> () {
    let dir = temporary();
    defer {
        testing::assert_ok(dir.close());
    };
    write(dir.path(), "main.gom", "");
    context::with_cancel(
        context::Context::background(),
        |ctx, cancel| {
            let walker = testing::expect_ok(
                ignore::Walker::new(dir.path(), ignore::WalkOptions::standard()),
                "walker",
            );
            testing::assert_ok(testing::expect_some(walker.next(ctx), "root"));
            cancel.cancel();
            let error = testing::expect_err(
                testing::expect_some(walker.next(ctx), "cancelled"),
                "cancelled",
            );
            testing::assert_eq(error.kind, ignore::ErrorKind::Cancelled);
            testing::assert(walker.next(ctx).is_none());
            testing::assert(walker.next(context::Context::background()).is_none());
            testing::assert_eq(walker.visited_count(), 1);
        },
    );
}

#[test]
fn parallel_callbacks_are_bounded_and_joined() -> () {
    let dir = temporary();
    defer {
        testing::assert_ok(dir.close());
    };
    for index in 0..12 {
        write(dir.path(), index.to_string() + ".gom", "");
    }
    let state: Channel[(isize, isize, isize)] = Channel::new(1);
    state.send((0, 0, 0));
    let entered: Channel[()] = Channel::new(4);
    let release: Channel[()] = Channel::new(4);
    task::scope(
        |scope| {
            let job = scope.spawn(
                |_| ignore::walk_parallel(
                    dir.path(),
                    ignore::WalkOptions::standard(),
                    context::Context::background(),
                    4,
                    |entry, _| {
                        if entry.depth() == 0 {
                            return Result::Ok(())
                        }
                        let (active, maximum, started) = state.recv().unwrap_or((0, 0, 0));
                        state.send(
                            (
                                active + 1,
                                if active + 1 > maximum {
                                    active + 1
                                } else {
                                    maximum
                                },
                                started + 1,
                            ),
                        );
                        if started < 4 {
                            entered.send(());
                            let _ = release.recv();
                        }
                        let (active, maximum, started) = state.recv().unwrap_or((0, 0, 0));
                        state.send((active - 1, maximum, started));
                        Result::Ok(())
                    },
                ),
            );
            for _ in 0..4 {
                let _ = entered.recv();
            }
            for _ in 0..4 {
                release.send(());
            }
            testing::assert_eq(testing::expect_ok(job.join(), "parallel walk"), 13);
        },
    );
    let (active, maximum, started) = state.recv().unwrap_or((0, 0, 0));
    testing::assert_eq(active, 0);
    testing::assert_eq(maximum, 4);
    testing::assert_eq(started, 12);
}

#[test]
fn parallel_callback_failure_cancels_and_returns_original_error() -> () {
    let dir = temporary();
    defer {
        testing::assert_ok(dir.close());
    };
    for index in 0..12 {
        write(dir.path(), index.to_string(), "");
    }
    let result = ignore::walk_parallel(
        dir.path(),
        ignore::WalkOptions::standard(),
        context::Context::background(),
        3,
        |_, _| Result::Err(
            ignore::Error {
                kind: ignore::ErrorKind::InvalidOptions,
                message: "callback stopped",
                path: "callback",
                line: 0,
                cause: Option::None,
            },
        ),
    );
    let error = testing::expect_err(result, "callback failure");
    testing::assert_eq(error.message, "callback stopped");
    testing::assert_err(
        ignore::walk_parallel(
            dir.path(),
            ignore::WalkOptions::standard(),
            context::Context::background(),
            0,
            |_, _| Result::Ok(()),
        ),
    );
}

#[test]
fn worktree_gitdir_and_commondir_excludes_are_resolved() -> () {
    let dir = temporary();
    defer {
        testing::assert_ok(dir.close());
    };
    write(dir.path(), "checkout/.git", "gitdir: ../metadata/worktrees/checkout\n");
    write(dir.path(), "metadata/worktrees/checkout/commondir", "../..\n");
    write(dir.path(), "metadata/info/exclude", "*.tmp\n*.log\n");
    write(dir.path(), "checkout/.gitignore", "!keep.tmp\n");
    write(dir.path(), "checkout/keep.tmp", "");
    write(dir.path(), "checkout/drop.tmp", "");
    write(dir.path(), "checkout/drop.log", "");
    let names = collect(path::join(dir.path(), "checkout"), ignore::WalkOptions::standard());
    testing::assert(names == Vec::from_array(["", ".gitignore", "keep.tmp"]));
    write(
        dir.path(),
        "checkout/.git",
        "gitdir: " + path::join(dir.path(), "metadata/worktrees/checkout") + "\n",
    );
    testing::assert(
        collect(path::join(dir.path(), "checkout"), ignore::WalkOptions::standard()) == names,
    );
    write(dir.path(), "ordinary/.git", "gitdir: ../separate\n");
    write(dir.path(), "separate/info/exclude", "*.gom\n");
    write(dir.path(), "ordinary/main.gom", "");
    testing::assert(
        collect(path::join(dir.path(), "ordinary"), ignore::WalkOptions::standard())
            == Vec::from_array([""]),
    );
    let all = collect(
        path::join(dir.path(), "checkout"),
        ignore::WalkOptions { gitignore: false, ..ignore::WalkOptions::standard() },
    );
    testing::assert(all.contains("drop.tmp") && all.contains("drop.log"));
}

#[test]
fn invalid_git_metadata_and_symlink_ignore_files_are_handled() -> () {
    let dir = temporary();
    defer {
        testing::assert_ok(dir.close());
    };
    write(dir.path(), "bad/.git", "not a gitdir pointer\n");
    let walker = testing::expect_ok(
        ignore::Walker::new(path::join(dir.path(), "bad"), ignore::WalkOptions::standard()),
        "invalid gitfile",
    );
    testing::assert_ok(testing::expect_some(walker.next(context::Context::background()), "root"));
    testing::assert_eq(
        testing::expect_err(
            testing::expect_some(walker.next(context::Context::background()), "gitfile failure"),
            "gitfile failure",
        ).kind,
        ignore::ErrorKind::InvalidPath,
    );
    write(dir.path(), "outside", "*.gom\n");
    write(dir.path(), "links/main.gom", "");
    testing::assert_ok(fs::symbolic_link("../outside", path::join(dir.path(), "links/.gitignore")));
    let names = collect(path::join(dir.path(), "links"), ignore::WalkOptions::standard());
    testing::assert(names.contains("main.gom"));
    testing::assert(names.contains(".gitignore"));
}

#[test]
fn git_metadata_paths_preserve_significant_spaces() -> () {
    let dir = temporary();
    defer {
        testing::assert_ok(dir.close());
    };
    write(dir.path(), "checkout/.git", "gitdir: ../ git data \r\n");
    write(dir.path(), " git data /commondir", "../ common data \n");
    write(dir.path(), " common data /info/exclude", "*.tmp\n");
    write(dir.path(), "checkout/drop.tmp", "");
    write(dir.path(), "checkout/main.gom", "");
    testing::assert(
        collect(path::join(dir.path(), "checkout"), ignore::WalkOptions::standard())
            == Vec::from_array(["", "main.gom"]),
    );
}
