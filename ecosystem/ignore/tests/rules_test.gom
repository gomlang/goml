package tests;

use ecosystem::ignore;
use std::testing;
use std::utf8;

fn rules(text: string) -> ignore::Gitignore {
    testing::expect_ok(
        ignore::Gitignore::new().with_source("", ".gitignore", text),
        "parse ignore rules",
    )
}

fn ignored(value: ignore::Gitignore, path: string, directory: bool) -> bool {
    testing::expect_ok(value.matched(path, directory), "match path").is_ignored()
}

#[test]
fn excluded_parent_prevents_reinclusion() -> () {
    let value = rules("build/\n!build/keep.gom\n");
    let result = testing::expect_ok(
        value.matched("build/keep.gom", false),
        "inherit ignored parent",
    );
    testing::assert(result.is_ignored());
    testing::assert(result.inherited_from() == Option::Some("build"));
    let rule = testing::expect_some(result.rule(), "explanation");
    testing::assert_eq(rule.line, 1);
    testing::assert_eq(rule.source, ".gitignore");
    testing::assert_eq(rule.pattern, "build/");
    testing::assert(!ignored(rules("build/*\n!build/keep.gom\n"), "build/keep.gom", false));
    testing::assert(!ignored(rules("build/*\n"), "build", true));
    testing::assert(ignored(rules("build/*\n"), "build/", true));
    testing::assert(!ignored(rules("build/\n!build/\n"), "build/keep.gom", false));
    testing::assert(!ignored(value, "build", false));
    testing::assert(ignored(value, "build", true));
}

#[test]
fn nested_rules_override_low_priority_excludes_in_any_insertion_order() -> () {
    let nested = testing::expect_ok(
        ignore::Gitignore::new().with_source("src", "src/.gitignore", "!main.gom\n/private.gom\n"),
        "nested rules",
    );
    let value = testing::expect_ok(nested.with_source("", ".gitignore", "*.gom\n"), "root rules");
    let value = testing::expect_ok(
        value.with_excludes(".git/info/exclude", "main.gom\n*.tmp\n"),
        "lowest priority",
    );
    testing::assert(!ignored(value, "src/main.gom", false));
    testing::assert(ignored(value, "main.gom", false));
    testing::assert(ignored(value, "src/private.gom", false));
    testing::assert(ignored(value, "src/a.tmp", false));
    testing::assert(!ignored(nested, "other/private.gom", false));
    testing::assert(!ignored(nested, "src/nested/private.gom", false));
    testing::assert_eq(nested.len(), 2);
}

#[test]
fn ignore_lexing_handles_crlf_bom_escaping_spaces_and_invalid_patterns() -> () {
    let value = rules(
        testing::expect_ok(utf8::decode(Vec::from_array([239, 187, 191])), "BOM")
            + "# comment\r\n\\!literal\n\\#literal\nspace\\ \nplain   \nstar\\*name\n[broken\n\\\n\n!\n",
    );
    for name in Vec::from_array(["!literal", "#literal", "space ", "plain", "star*name"]) {
        testing::assert(ignored(value, name, false));
    }
    for name in Vec::from_array(["literal", "space", "plain ", "starXname", "[broken", "\\"]) {
        testing::assert(!ignored(value, name, false));
    }
    let anchored = rules("/root.gom\nfoo/bar\n");
    testing::assert(ignored(anchored, "root.gom", false));
    testing::assert(!ignored(anchored, "nested/root.gom", false));
    testing::assert(!ignored(anchored, "nested/foo/bar", false));
}

#[test]
fn relative_paths_limits_and_explicit_root_are_checked() -> () {
    let value = rules("*\n");
    testing::assert(!ignored(value, "", true));
    testing::assert(!ignored(value, ".", true));
    testing::assert(ignored(value, "./file", false));
    for path in Vec::from_array(["../a", "a/../b", "/root", "a\u0000b"]) {
        testing::assert_err(value.matched(path, false));
    }
    let small = testing::expect_ok(
        ignore::Gitignore::with_options(
            ignore::Limits { max_rules: 1, max_source_bytes: 8, ..ignore::Limits::standard() },
            false,
        ),
        "small limits",
    );
    testing::assert_err(small.with_source("", "source", "a\nb\n"));
    testing::assert_err(small.with_source("", "source", "123456789"));
    testing::assert_err(small.with_source("../", "source", "a"));
    testing::assert_eq(small.len(), 0);
}
