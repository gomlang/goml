package tests;

use ecosystem::ignore;
use std::testing;
use std::task;

fn glob(pattern: string, path: string) -> bool {
    testing::expect_ok(
        testing::expect_ok(ignore::Glob::new(pattern), "compile glob").is_match(path),
        "match glob",
    )
}

#[test]
fn globstar_separator_and_byte_semantics() -> () {
    for name in Vec::from_array(["a.gom", "src/a.gom", "deep/src/a.gom"]) {
        testing::assert(glob("**/*.gom", name));
    }
    testing::assert(glob("a/**/b", "a/b"));
    testing::assert(glob("a/**/b", "a/c/d/b"));
    testing::assert(!glob("a/*/b", "a/b"));
    testing::assert(!glob("a/*/b", "a/c/d/b"));
    testing::assert(!glob("a**b", "a/c/b"));
    testing::assert(glob("a**b", "axb"));
    testing::assert(!glob("src/**", "src"));
    testing::assert(glob("src/**", "src/"));
    testing::assert(glob("*", ".hidden"));
    testing::assert(!glob("?.gom", "é.gom"));
    testing::assert(glob("??.gom", "é.gom"));
    testing::assert(glob("中文.*", "中文.gom"));
    testing::assert(glob("star\\*name", "star*name"));
    testing::assert(glob("", ""));
    testing::assert(!glob("", "a"));
}

#[test]
fn character_classes_posix_and_ascii_folding() -> () {
    testing::assert(glob("[a-c][!0-9][[:digit:]]", "bz7"));
    testing::assert(glob("[]-]", "]"));
    testing::assert(glob("[]-]", "-"));
    testing::assert(!glob("[^/]*", "/"));
    testing::assert(glob("[[:space:]]", "\t"));
    testing::assert(glob("[[:punct:]]", "!"));
    testing::assert(!glob("[[:alpha:]]", "7"));
    let insensitive = testing::expect_ok(
        ignore::Glob::with_options("[A-Z]*.GOM", ignore::Limits::standard(), true),
        "ASCII case folding",
    );
    testing::assert(testing::expect_ok(insensitive.is_match("hello.gom"), "folded match"));
    let mixed_range = testing::expect_ok(
        ignore::Glob::with_options("[Z-a]", ignore::Limits::standard(), true),
        "mixed range",
    );
    testing::assert(testing::expect_ok(mixed_range.is_match("A"), "range upper case"));
    testing::assert(testing::expect_ok(mixed_range.is_match("z"), "range lower case"));
    for pattern in Vec::from_array(["[", "[abc", "[[:unknown:]]", "trailing\\"]) {
        testing::assert_err(ignore::Glob::new(pattern));
    }
    testing::assert_err(ignore::Glob::new("a\u0000b"));
}

#[test]
fn glob_sets_preserve_order_and_detach_input() -> () {
    let patterns = Vec::from_array(["**/*.gom", "src/*", "**/*.gom"]);
    let set = testing::expect_ok(ignore::GlobSet::new(patterns), "glob set");
    patterns.set(0, "no match");
    patterns.clear();
    testing::assert_eq(set.len(), 3);
    let result = testing::expect_ok(set.matches("src/main.gom"), "all matches");
    testing::assert(result == Vec::from_array([0, 1, 2]));
    result.clear();
    testing::assert_eq(testing::expect_ok(set.matches("src/main.gom"), "detached results").len(), 3);
    testing::assert(!testing::expect_ok(set.is_match("foo.txt"), "absent"));
}

#[test]
fn matching_limits_fail_recoverably_before_growth() -> () {
    let limits = ignore::Limits {
        max_pattern_bytes: 4,
        max_path_bytes: 5,
        max_rules: 2,
        max_source_bytes: 20,
        max_match_steps: 8,
    };
    testing::assert_err(ignore::Glob::with_options("12345", limits, false));
    let value = testing::expect_ok(ignore::Glob::with_options("*a*", limits, false), "bounded glob");
    testing::assert_err(value.is_match("abcdef"));
    testing::assert_err(value.is_match("aaa"));
    testing::assert(testing::expect_ok(value.is_match("a"), "small bounded input"));
    testing::assert_err(
        ignore::GlobSet::with_options(Vec::from_array(["a", "b", "c"]), limits, false),
    );
    testing::assert_err(
        ignore::Glob::with_options("a", ignore::Limits { max_match_steps: 0, ..limits }, false),
    );
}

#[test]
fn immutable_matching_is_safe_across_tasks() -> () {
    let rules = testing::expect_ok(
        ignore::Gitignore::new().with_source("", "rules", "**/*.tmp\n!**/keep.tmp\nbuild/\n"),
        "rules",
    );
    let set = testing::expect_ok(
        ignore::GlobSet::new(Vec::from_array(["**/*.gom", "**/main.*"])),
        "globs",
    );
    task::scope(
        |scope| {
            let jobs: Vec[task::Task[()]] = Vec::new();
            for _ in 0..16 {
                jobs.push(
                    scope.spawn(
                        |_| {
                            for _ in 0..100 {
                                testing::assert(
                                    testing::expect_ok(
                                        rules.matched("build/keep.tmp", false),
                                        "inherited",
                                    ).is_ignored(),
                                );
                                testing::assert(
                                    !testing::expect_ok(
                                        rules.matched("src/keep.tmp", false),
                                        "allowed",
                                    ).is_ignored(),
                                );
                                testing::assert_eq(
                                    testing::expect_ok(set.matches("src/main.gom"), "match").len(),
                                    2,
                                );
                            }
                        },
                    ),
                );
            }
            for job in jobs {
                job.join();
            }
        },
    );
}
