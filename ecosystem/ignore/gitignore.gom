package ignore;

pub struct Rule {
    pub source: string,
    pub line: isize,
    pub pattern: string,
    pub base: string,
    pub negated: bool,
    pub directory_only: bool,
    glob: Option[Glob],
    basename: bool,
    priority: isize,
    depth: isize,
}

pub struct Match {
    rule_value: Option[Rule],
    inherited_value: Option[string],
}

impl Match {
    pub fn is_ignored(self: Match) -> bool {
        self.rule_value.map(|rule| !rule.negated).unwrap_or(false)
    }

    pub fn is_whitelisted(self: Match) -> bool {
        self.rule_value.map(|rule| rule.negated).unwrap_or(false)
    }

    pub fn rule(self: Match) -> Option[Rule] {
        self.rule_value
    }

    pub fn inherited_from(self: Match) -> Option[string] {
        self.inherited_value
    }
}

pub struct Gitignore {
    rules: FrozenVec[Rule],
    limits: Limits,
    insensitive: bool,
}

fn unescaped_trailing_spaces(line: string) -> string {
    let mut end = line.byte_len();
    while end > 0 && line.byte_get(end - 1) == b' ' {
        let mut start = end - 1;
        while start > 0 && line.byte_get(start - 1) == b'\\' {
            start -= 1;
        }
        if (end - 1 - start) % 2 == 1 {
            break;
        }
        end -= 1;
    }
    line.byte_slice(0, end)
}

impl Gitignore {
    fn bounded(self: Gitignore, limits: Limits) -> Result[Gitignore, Error] {
        limits.validate()?;
        if self.rules.len() > limits.max_rules {
            return Result::Err(failure(ErrorKind::Limit, "initial rule count exceeds walker limit"))
        }
        for rule in self.rules.iter() {
            if rule.pattern.byte_len() > limits.max_pattern_bytes
                || rule.base.byte_len() > limits.max_path_bytes {
                return Result::Err(failure(ErrorKind::Limit, "initial rule exceeds walker limits"))
            }
        }
        Result::Ok(Gitignore { limits, ..self })
    }

    pub fn new() -> Gitignore {
        Gitignore { rules: Vec::new().freeze(), limits: Limits::standard(), insensitive: false }
    }

    pub fn with_options(limits: Limits, ascii_case_insensitive: bool) -> Result[Gitignore, Error] {
        limits.validate()?;
        Result::Ok(
            Gitignore { rules: Vec::new().freeze(), limits, insensitive: ascii_case_insensitive },
        )
    }

    pub fn len(self: Gitignore) -> isize {
        self.rules.len()
    }

    pub fn with_source(self: Gitignore, base: string, source_name: string, text: string) -> Result[
        Gitignore,
        Error,
    ] {
        self.add_source(base, source_name, text, 1)
    }

    pub fn with_excludes(self: Gitignore, source_name: string, text: string) -> Result[
        Gitignore,
        Error,
    ] {
        self.add_source("", source_name, text, 0)
    }

    fn add_source(self: Gitignore, base: string, source_name: string, text: string, priority: isize) -> Result[
        Gitignore,
        Error,
    ] {
        let base = normalize_relative(base, self.limits)?;
        if text.byte_len() > self.limits.max_source_bytes {
            return Result::Err(failure(ErrorKind::Limit, "ignore source byte limit exceeded"))
        }
        let rules = self.rules.to_vec();
        let mut line_number = 0;
        for raw in text.split("\n") {
            line_number += 1;
            let raw = if line_number == 1 && raw.byte_len() >= 3 && raw.byte_get(0) == 239
                && raw.byte_get(1) == 187
                && raw.byte_get(2) == 191 {
                raw.byte_slice(3, raw.byte_len())
            } else {
                raw
            };
            let line = unescaped_trailing_spaces(
                if raw.ends_with("\r") {
                    raw.byte_slice(0, raw.byte_len() - 1)
                } else {
                    raw
                },
            );
            if line == "" || line.starts_with("#") {
                continue;
            }
            let negated = line.starts_with("!");
            let mut pattern = if negated {
                line.byte_slice(1, line.byte_len())
            } else {
                line
            };
            if pattern == "" {
                continue;
            }
            let directory_only = pattern.ends_with("/");
            if directory_only {
                pattern = pattern.byte_slice(0, pattern.byte_len() - 1);
            }
            let anchored = pattern.starts_with("/");
            if anchored {
                pattern = pattern.byte_slice(1, pattern.byte_len());
            }
            let basename = !anchored && !pattern.contains("/");
            let glob = match Glob::with_options(pattern, self.limits, self.insensitive) {
                Ok(value) => Option::Some(value),
                Err(error) => if error.kind == ErrorKind::InvalidPattern {
                    Option::None
                } else {
                    return Result::Err(Error { path: source_name, line: line_number, ..error })
                },
            };
            if rules.len() == self.limits.max_rules {
                return Result::Err(failure(ErrorKind::Limit, "ignore rule count limit exceeded"))
            }
            rules.push(
                Rule {
                    source: source_name,
                    line: line_number,
                    pattern: line,
                    base,
                    negated,
                    directory_only,
                    glob,
                    basename,
                    priority,
                    depth: if base == "" {
                        0
                    } else {
                        base.split("/").len()
                    },
                },
            );
        }
        rules.stable_sort_by(
            |left, right| if left.priority != right.priority {
                left.priority - right.priority
            } else {
                left.depth - right.depth
            },
        );
        Result::Ok(Gitignore { rules: rules.freeze(), ..self })
    }

    fn direct_match(self: Gitignore, path: string, is_dir: bool, budget: Ref[isize]) -> Result[
        Match,
        Error,
    ] {
        let mut matched = Option::None;
        for rule in self.rules.iter() {
            if budget.get() == 0 {
                return Result::Err(failure(ErrorKind::Limit, "matching work limit exceeded"))
            }
            budget.set(budget.get() - 1);
            if rule.directory_only && !is_dir {
                continue;
            }
            let relative = if rule.base == "" {
                path
            } else if path.starts_with(rule.base + "/") {
                path.byte_slice(rule.base.byte_len() + 1, path.byte_len())
            } else {
                continue;
            };
            let candidate = if rule.basename {
                relative.split("/").last().unwrap_or(relative)
            } else {
                relative
            };
            if let Some(glob) = rule.glob {
                if glob.matches_budget(candidate, budget)? {
                    matched = Option::Some(rule);
                }
            }
        }
        Result::Ok(Match { rule_value: matched, inherited_value: Option::None })
    }

    pub fn matched(self: Gitignore, path: string, is_dir: bool) -> Result[Match, Error] {
        let trailing_slash = is_dir && path.ends_with("/");
        let path = normalize_relative(path, self.limits)?;
        if path == "" {
            return Result::Ok(Match { rule_value: Option::None, inherited_value: Option::None })
        }
        let budget = Ref::new(self.limits.max_match_steps);
        for index in 0..path.byte_len() {
            if path.byte_get(index) == b'/' {
                let parent = path.byte_slice(0, index);
                let result = self.direct_match(parent, true, budget)?;
                if result.is_ignored() {
                    return Result::Ok(Match { inherited_value: Option::Some(parent), ..result })
                }
            }
        }
        if trailing_slash {
            let parent = self.direct_match(path, true, budget)?;
            if parent.is_ignored() {
                return Result::Ok(Match { inherited_value: Option::Some(path), ..parent })
            }
            return self.direct_match(path + "/", is_dir, budget)
        }
        self.direct_match(path, is_dir, budget)
    }
}
