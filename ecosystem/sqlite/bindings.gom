package sqlite;

use std::ffi;

#[go_type("example.com/goml-ecosystem/sqlite/adapter", "Control")]
extern type NativeControl;

#[go_type("example.com/goml-ecosystem/sqlite/adapter", "Session")]
extern type NativeSession;

#[go_type("example.com/goml-ecosystem/sqlite/adapter", "Value")]
extern type NativeValue;

#[go_type("example.com/goml-ecosystem/sqlite/adapter", "Statement")]
extern type NativeStatement;

#[go_type("example.com/goml-ecosystem/sqlite/adapter", "Column")]
extern type NativeColumn;

#[go_type("example.com/goml-ecosystem/sqlite/adapter", "Row")]
extern type NativeRow;

#[go_type("example.com/goml-ecosystem/sqlite/adapter", "Cursor")]
extern type NativeCursor;

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "BridgeNewControl")]
extern fn raw_new_control(milliseconds: i64) -> (NativeControl, NativeFailure);

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "Cancel")]
extern fn raw_cancel(control: NativeControl) -> ();

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "BridgeOpen")]
extern fn raw_open(dsn: ffi::String, busy: i64, foreign_keys: bool, control: NativeControl) -> (
    NativeSession,
    NativeFailure,
);

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "BridgeClose")]
extern fn raw_close(session: NativeSession) -> NativeFailure;

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "IsClosed")]
extern fn raw_is_closed(session: NativeSession) -> bool;

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "FailureClass")]
extern fn raw_error_class(error: NativeFailure) -> isize;

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "FailureCode")]
extern fn raw_error_code(error: NativeFailure) -> isize;

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "Null")]
extern fn raw_null() -> NativeValue;

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "Integer")]
extern fn raw_integer(value: i64) -> NativeValue;

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "Real")]
extern fn raw_real(value: f64) -> NativeValue;

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "Text")]
extern fn raw_text(value: ffi::String) -> NativeValue;

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "Blob")]
extern fn raw_blob(value: ffi::RawSlice[u8]) -> NativeValue;

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "ValueKind")]
extern fn raw_value_kind(value: NativeValue) -> isize;

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "ValueInteger")]
extern fn raw_value_integer(value: NativeValue) -> i64;

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "ValueReal")]
extern fn raw_value_real(value: NativeValue) -> f64;

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "ValueText")]
extern fn raw_value_text(value: NativeValue) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "ValueBlob")]
extern fn raw_value_blob(value: NativeValue) -> ffi::RawSlice[u8];

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "BridgeExecute")]
extern fn raw_execute(
    session: NativeSession,
    sql: ffi::String,
    values: ffi::RawSlice[NativeValue],
    names: ffi::RawSlice[ffi::String],
    control: NativeControl,
) -> (i64, i64, NativeFailure);

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "BridgeQuery")]
extern fn raw_query(
    session: NativeSession,
    sql: ffi::String,
    values: ffi::RawSlice[NativeValue],
    names: ffi::RawSlice[ffi::String],
    control: NativeControl,
) -> (NativeCursor, NativeFailure);

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "BridgePrepare")]
extern fn raw_prepare(session: NativeSession, sql: ffi::String, control: NativeControl) -> (
    NativeStatement,
    NativeFailure,
);

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "BridgeCloseStatement")]
extern fn raw_close_statement(statement: NativeStatement) -> NativeFailure;

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "BridgeExecuteStatement")]
extern fn raw_execute_statement(
    statement: NativeStatement,
    values: ffi::RawSlice[NativeValue],
    names: ffi::RawSlice[ffi::String],
    control: NativeControl,
) -> (i64, i64, NativeFailure);

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "BridgeQueryStatement")]
extern fn raw_query_statement(
    statement: NativeStatement,
    values: ffi::RawSlice[NativeValue],
    names: ffi::RawSlice[ffi::String],
    control: NativeControl,
) -> (NativeCursor, NativeFailure);

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "ColumnName")]
extern fn raw_column_name(column: NativeColumn) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "ColumnType")]
extern fn raw_column_type(column: NativeColumn) -> ffi::String;

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "RowValues")]
extern fn raw_row_values(row: NativeRow) -> ffi::RawSlice[NativeValue];

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "RowColumns")]
extern fn raw_row_columns(row: NativeRow) -> ffi::RawSlice[NativeColumn];

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "CursorColumns")]
extern fn raw_cursor_columns(cursor: NativeCursor) -> ffi::RawSlice[NativeColumn];

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "BridgeNext")]
extern fn raw_next(cursor: NativeCursor) -> (bool, NativeRow, NativeFailure);

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "BridgeCloseCursor")]
extern fn raw_close_cursor(cursor: NativeCursor) -> NativeFailure;

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "BridgeBegin")]
extern fn raw_begin(session: NativeSession, mode: isize, control: NativeControl) -> (
    NativeSession,
    NativeFailure,
);

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "BridgeSavepoint")]
extern fn raw_savepoint(session: NativeSession, control: NativeControl) -> (
    NativeSession,
    NativeFailure,
);

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "BridgeCommit")]
extern fn raw_commit(session: NativeSession, control: NativeControl) -> NativeFailure;

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "BridgeRollback")]
extern fn raw_rollback(session: NativeSession) -> NativeFailure;

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "Resources")]
extern fn raw_resources(session: NativeSession) -> (isize, isize, isize);

#[go_type("example.com/goml-ecosystem/sqlite/adapter", "Failure")]
extern type NativeFailure;

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "FailureIsNil")]
extern fn raw_error_is_nil(value: NativeFailure) -> bool;

#[go_ffi("example.com/goml-ecosystem/sqlite/adapter", "FailureMessage")]
extern fn raw_error_message(value: NativeFailure) -> ffi::String;
