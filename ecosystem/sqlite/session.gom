package sqlite;

use std::ffi;

pub struct Control {
    raw: NativeControl,
}

impl Control {
    pub fn unlimited() -> Control {
        let (raw, _) = raw_new_control(0);
        Control { raw }
    }

    pub fn timeout(milliseconds: i64) -> Result[Control, DbError] {
        let (raw, error) = raw_new_control(milliseconds);
        check(error)?;
        Result::Ok(Control { raw })
    }

    pub fn cancel(self: Control) -> () {
        raw_cancel(self.raw)
    }
}

pub struct OpenOptions {
    pub busy_timeout_ms: i64,
    pub foreign_keys: bool,
}

impl OpenOptions {
    pub fn standard() -> OpenOptions {
        OpenOptions { busy_timeout_ms: 5000, foreign_keys: true }
    }
}

#[derive(Debug, PartialEq)]
pub enum TransactionMode {
    Deferred,
    Immediate,
    Exclusive,
}

pub struct Execution {
    pub rows_affected: i64,
    pub last_insert_id: i64,
}

pub struct Resources {
    pub statements: isize,
    pub cursors: isize,
    pub transactions: isize,
}

pub struct Database {
    raw: NativeSession,
}

pub struct Transaction {
    raw: NativeSession,
}

pub trait Executor {
    fn execute_with(self: Self, sql: string, params: Params, control: Control) -> Result[
        Execution,
        DbError,
    ];
    fn query_with(self: Self, sql: string, params: Params, control: Control) -> Result[
        Rows,
        DbError,
    ];
    fn prepare_with(self: Self, sql: string, control: Control) -> Result[Statement, DbError];
    fn execute(self: Self, sql: string, params: Params) -> Result[Execution, DbError] {
        self.execute_with(sql, params, Control::unlimited())
    }
    fn query(self: Self, sql: string, params: Params) -> Result[Rows, DbError] {
        self.query_with(sql, params, Control::unlimited())
    }
    fn prepare(self: Self, sql: string) -> Result[Statement, DbError] {
        self.prepare_with(sql, Control::unlimited())
    }
    fn query_all[T: FromRow](self: Self, sql: string, params: Params, max_rows: isize) -> Result[
        Vec[T],
        DbError,
    ] {
        self.query(sql, params)?.collect(max_rows)
    }
    fn query_one[T: FromRow](self: Self, sql: string, params: Params) -> Result[T, DbError] {
        self.query(sql, params)?.one()
    }
    fn query_optional[T: FromRow](self: Self, sql: string, params: Params) -> Result[
        Option[T],
        DbError,
    ] {
        self.query(sql, params)?.optional()
    }
}

fn execute(raw: NativeSession, sql: string, params: Params, control: Control) -> Result[
    Execution,
    DbError,
] {
    let (values, names) = params.encode();
    let (rows_affected, last_insert_id, error) = raw_execute(
        raw,
        ffi::string_from_text(sql),
        values,
        names,
        control.raw,
    );
    check(error)?;
    Result::Ok(Execution { rows_affected, last_insert_id })
}

fn query(raw: NativeSession, sql: string, params: Params, control: Control) -> Result[Rows, DbError] {
    let (values, names) = params.encode();
    let (raw, error) = raw_query(raw, ffi::string_from_text(sql), values, names, control.raw);
    check(error)?;
    Result::Ok(Rows { raw })
}

fn prepare(raw: NativeSession, sql: string, control: Control) -> Result[Statement, DbError] {
    let (raw, error) = raw_prepare(raw, ffi::string_from_text(sql), control.raw);
    check(error)?;
    Result::Ok(Statement { raw })
}

impl Executor for Database {
    fn execute_with(self: Database, sql: string, params: Params, control: Control) -> Result[
        Execution,
        DbError,
    ] {
        execute(self.raw, sql, params, control)
    }

    fn query_with(self: Database, sql: string, params: Params, control: Control) -> Result[
        Rows,
        DbError,
    ] {
        query(self.raw, sql, params, control)
    }

    fn prepare_with(self: Database, sql: string, control: Control) -> Result[Statement, DbError] {
        prepare(self.raw, sql, control)
    }
}

impl Executor for Transaction {
    fn execute_with(self: Transaction, sql: string, params: Params, control: Control) -> Result[
        Execution,
        DbError,
    ] {
        execute(self.raw, sql, params, control)
    }

    fn query_with(self: Transaction, sql: string, params: Params, control: Control) -> Result[
        Rows,
        DbError,
    ] {
        query(self.raw, sql, params, control)
    }

    fn prepare_with(self: Transaction, sql: string, control: Control) -> Result[Statement, DbError] {
        prepare(self.raw, sql, control)
    }
}

impl Database {
    pub fn open(dsn: string) -> Result[Database, DbError] {
        Database::open_with(dsn, OpenOptions::standard(), Control::unlimited())
    }

    pub fn memory() -> Result[Database, DbError] {
        Database::open(":memory:")
    }

    pub fn open_with(dsn: string, options: OpenOptions, control: Control) -> Result[
        Database,
        DbError,
    ] {
        let (raw, error) = raw_open(
            ffi::string_from_text(dsn),
            options.busy_timeout_ms,
            options.foreign_keys,
            control.raw,
        );
        check(error)?;
        Result::Ok(Database { raw })
    }

    pub fn close(self: Database) -> Result[(), DbError] {
        check(raw_close(self.raw))
    }

    pub fn is_closed(self: Database) -> bool {
        raw_is_closed(self.raw)
    }

    pub fn resources(self: Database) -> Resources {
        let (statements, cursors, transactions) = raw_resources(self.raw);
        Resources { statements, cursors, transactions }
    }

    pub fn begin(self: Database, mode: TransactionMode) -> Result[Transaction, DbError] {
        self.begin_with(mode, Control::unlimited())
    }

    pub fn begin_with(self: Database, mode: TransactionMode, control: Control) -> Result[
        Transaction,
        DbError,
    ] {
        let mode = match mode {
            TransactionMode::Deferred => 0,
            TransactionMode::Immediate => 1,
            TransactionMode::Exclusive => 2,
        };
        let (raw, error) = raw_begin(self.raw, mode, control.raw);
        check(error)?;
        Result::Ok(Transaction { raw })
    }

    pub fn transaction[T](
        self: Database,
        mode: TransactionMode,
        callback: (Transaction) -> Result[T, DbError],
    ) -> Result[T, DbError] {
        let transaction = self.begin(mode)?;
        defer {
            let _ = transaction.rollback();
        };
        finish_transaction(transaction, callback(transaction))
    }
}

impl Transaction {
    pub fn is_closed(self: Transaction) -> bool {
        raw_is_closed(self.raw)
    }

    pub fn commit(self: Transaction) -> Result[(), DbError] {
        self.commit_with(Control::unlimited())
    }

    pub fn commit_with(self: Transaction, control: Control) -> Result[(), DbError] {
        check(raw_commit(self.raw, control.raw))
    }

    pub fn rollback(self: Transaction) -> Result[(), DbError] {
        check(raw_rollback(self.raw))
    }

    pub fn close(self: Transaction) -> Result[(), DbError] {
        self.rollback()
    }

    pub fn savepoint(self: Transaction) -> Result[Transaction, DbError] {
        let (raw, error) = raw_savepoint(self.raw, Control::unlimited().raw);
        check(error)?;
        Result::Ok(Transaction { raw })
    }

    pub fn with_savepoint[T](self: Transaction, callback: (Transaction) -> Result[T, DbError]) -> Result[
        T,
        DbError,
    ] {
        let transaction = self.savepoint()?;
        defer {
            let _ = transaction.rollback();
        };
        finish_transaction(transaction, callback(transaction))
    }
}

fn finish_transaction[T](transaction: Transaction, result: Result[T, DbError]) -> Result[T, DbError] {
    let result = match result {
        Ok(value) => transaction.commit().map(|_| value),
        Err(error) => Result::Err(error),
    };
    match result {
        Ok(value) => Result::Ok(value),
        Err(error) => match transaction.rollback() {
            Ok(_) => Result::Err(error),
            Err(cleanup) => Result::Err(error.with_cleanup(cleanup)),
        },
    }
}
