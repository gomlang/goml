package sqlite;

pub struct Statement {
    raw: NativeStatement,
}

impl Statement {
    pub fn close(self: Statement) -> Result[(), DbError] {
        check(raw_close_statement(self.raw))
    }

    pub fn execute(self: Statement, params: Params) -> Result[Execution, DbError] {
        self.execute_with(params, Control::unlimited())
    }

    pub fn execute_with(self: Statement, params: Params, control: Control) -> Result[
        Execution,
        DbError,
    ] {
        let (values, names) = params.encode();
        let (rows_affected, last_insert_id, error) = raw_execute_statement(
            self.raw,
            values,
            names,
            control.raw,
        );
        check(error)?;
        Result::Ok(Execution { rows_affected, last_insert_id })
    }

    pub fn query(self: Statement, params: Params) -> Result[Rows, DbError] {
        self.query_with(params, Control::unlimited())
    }

    pub fn query_with(self: Statement, params: Params, control: Control) -> Result[Rows, DbError] {
        let (values, names) = params.encode();
        let (raw, error) = raw_query_statement(self.raw, values, names, control.raw);
        check(error)?;
        Result::Ok(Rows { raw })
    }

    pub fn query_all[T: FromRow](self: Statement, params: Params, max_rows: isize) -> Result[
        Vec[T],
        DbError,
    ] {
        self.query(params)?.collect(max_rows)
    }

    pub fn query_one[T: FromRow](self: Statement, params: Params) -> Result[T, DbError] {
        self.query(params)?.one()
    }

    pub fn query_optional[T: FromRow](self: Statement, params: Params) -> Result[Option[T], DbError] {
        self.query(params)?.optional()
    }
}

pub struct Rows {
    raw: NativeCursor,
}

impl Rows {
    pub fn close(self: Rows) -> Result[(), DbError] {
        check(raw_close_cursor(self.raw))
    }

    pub fn columns(self: Rows) -> Result[Vec[Column], DbError] {
        decode_columns(raw_cursor_columns(self.raw))
    }

    pub fn next(self: Rows) -> Result[Option[Row], DbError] {
        let (present, row, error) = raw_next(self.raw);
        check(error)?;
        if present {
            match decode_row(row) {
                Ok(row) => Result::Ok(Option::Some(row)),
                Err(error) => {
                    let _ = self.close();
                    Result::Err(error)
                },
            }
        } else {
            Result::Ok(Option::None)
        }
    }

    pub fn next_as[T: FromRow](self: Rows) -> Result[Option[T], DbError] {
        if let Some(row) = self.next()? {
            match row.decode() {
                Ok(value) => Result::Ok(Option::Some(value)),
                Err(error) => {
                    let _ = self.close();
                    Result::Err(error)
                },
            }
        } else {
            Result::Ok(Option::None)
        }
    }

    pub fn collect[T: FromRow](self: Rows, max_rows: isize) -> Result[Vec[T], DbError] {
        defer {
            let _ = self.close();
        };
        if max_rows < 0 {
            return Result::Err(DbError::new(ErrorKind::Argument, "negative result row limit"))
        }
        let values = Vec::new();
        loop {
            let Some(row) = self.next()? else {
                break
            };
            if values.len() >= max_rows {
                return Result::Err(DbError::new(ErrorKind::Limit, "query result exceeds row limit"))
            }
            values.push(row.decode()?);
        }
        self.close()?;
        Result::Ok(values)
    }

    pub fn optional[T: FromRow](self: Rows) -> Result[Option[T], DbError] {
        defer {
            let _ = self.close();
        };
        let Some(row) = self.next()? else {
            return Result::Ok(Option::None)
        };
        if self.next()?.is_some() {
            return Result::Err(
                DbError::new(ErrorKind::MultipleRows, "expected at most one result row"),
            )
        }
        Result::Ok(Option::Some(row.decode()?))
    }

    pub fn one[T: FromRow](self: Rows) -> Result[T, DbError] {
        self.optional()?.ok_or(DbError::new(ErrorKind::NoRows, "query returned no rows"))
    }

    pub fn try_for_each(self: Rows, callback: (Row) -> Result[bool, DbError]) -> Result[(), DbError] {
        defer {
            let _ = self.close();
        };
        loop {
            let Some(row) = self.next()? else {
                break
            };
            if !callback(row)? {
                break
            }
        }
        self.close()
    }
}
