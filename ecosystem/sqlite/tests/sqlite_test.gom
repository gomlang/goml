package tests;

use ecosystem::sqlite::{Database, Executor, Params, Value, Row, FromRow, FromValue, ToValue, DbError, ErrorKind, TransactionMode, OpenOptions, Control};
use std::bytes::{Bytes};
use std::testing;
use std::task;
use std::time;

fn memory() -> Database {
    testing::expect_ok(Database::memory(), "open memory database")
}

fn sql(database: Database, text: string) -> () {
    let _ = testing::expect_ok(database.execute(text, Params::empty()), "execute SQL");
}

fn one(database: Database, text: string) -> Row {
    testing::expect_ok(database.query_one(text, Params::empty()), "one row")
}

fn integer(row: Row, index: isize) -> i64 {
    testing::expect_ok(row.get(index), "integer column")
}

fn text(row: Row, index: isize) -> string {
    testing::expect_ok(row.get(index), "text column")
}

#[test]
fn bound_values_preserve_storage_classes_and_extreme_values() -> () {
    let database = memory();
    defer {
        let _ = database.close();
    };
    sql(
        database,
        "CREATE TABLE values_table(i INTEGER, r REAL, t TEXT, b BLOB, n INTEGER, flag BOOLEAN)",
    );
    let injected = "x'); DROP TABLE values_table; -- 中😀\u0000tail";
    let blob = Bytes::from_vec(Vec::from_array([0, 255, 128, 1]));
    let parameters = Params::positional(
        Vec::from_array(
            [
                Value::Integer(-9223372036854775808),
                Value::Real(1.25),
                injected.to_value(),
                blob.to_value(),
                Value::Null,
                true.to_value(),
            ],
        ),
    );
    let result = testing::expect_ok(
        database.execute("INSERT INTO values_table VALUES(?,?,?,?,?,?)", parameters),
        "insert",
    );
    testing::assert_eq(result.rows_affected, 1);
    testing::assert_eq(result.last_insert_id, 1);
    let row = one(database, "SELECT * FROM values_table");
    testing::assert_eq(integer(row, 0), -9223372036854775808);
    let real: f64 = testing::expect_ok(row.get(1), "real");
    testing::assert_eq(real, 1.25);
    testing::assert_eq(text(row, 2), injected);
    let actual: Bytes = testing::expect_ok(row.get(3), "blob");
    testing::assert(actual.to_vec() == blob.to_vec());
    let missing: Option[i64] = testing::expect_ok(row.get(4), "nullable");
    testing::assert(missing.is_none());
    let flag: bool = testing::expect_ok(row.get(5), "boolean");
    testing::assert(flag);
    let names = row.columns();
    testing::assert_eq(names[0].name, "i");
    testing::assert_eq(names[0].declared_type, "INTEGER");
    let extreme: Row = testing::expect_ok(
        database.query_one(
            "SELECT ? AS maximum, typeof(?) AS empty_type, length(?) AS empty_size",
            Params::positional(
                Vec::from_array(
                    [
                        Value::Integer(9223372036854775807),
                        Value::Blob(Bytes::new()),
                        Value::Blob(Bytes::new()),
                    ],
                ),
            ),
        ),
        "extremes",
    );
    testing::assert_eq(integer(extreme, 0), 9223372036854775807);
    testing::assert_eq(text(extreme, 1), "blob");
    testing::assert_eq(integer(extreme, 2), 0);
}

#[test]
fn named_prepared_parameters_reuse_and_row_snapshots() -> () {
    let database = memory();
    defer {
        let _ = database.close();
    };
    sql(database, "CREATE TABLE records(id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE)");
    let statement = testing::expect_ok(
        database.prepare("INSERT INTO records(id,name) VALUES(:id,:name)"),
        "prepare",
    );
    for index in 1..5 {
        let parameters = Params::named(
            Vec::from_array(
                [
                    ("name", Value::Text("item-" + index.to_string())),
                    ("id", Value::Integer(index.to_i64())),
                ],
            ),
        );
        testing::assert_eq(
            testing::expect_ok(statement.execute(parameters), "prepared insert").rows_affected,
            1,
        );
    }
    testing::assert_eq(database.resources().statements, 1);
    let query = testing::expect_ok(
        database.prepare("SELECT id,name FROM records WHERE id>=? ORDER BY id"),
        "prepare query",
    );
    let rows = testing::expect_ok(
        query.query(Params::positional(Vec::from_array([Value::Integer(2)]))),
        "query",
    );
    let first = testing::expect_some(testing::expect_ok(rows.next(), "first"), "row");
    testing::assert_eq(integer(first, 0), 2);
    let second = testing::expect_some(testing::expect_ok(rows.next(), "second"), "row");
    testing::assert_eq(integer(second, 0), 3);
    testing::assert_eq(text(first, 1), "item-2");
    testing::assert_ok(rows.close());
    let rest: Vec[Row] = testing::expect_ok(
        query.query_all(Params::positional(Vec::from_array([Value::Integer(1)])), 10),
        "reused query",
    );
    testing::assert_eq(rest.len(), 4);
    testing::assert_ok(statement.close());
    testing::assert_ok(statement.close());
    testing::assert_eq(
        testing::expect_err(statement.execute(Params::empty()), "closed").kind,
        ErrorKind::Closed,
    );
    testing::assert_ok(query.close());
    testing::assert_eq(database.resources().statements, 0);
    let named: Row = testing::expect_ok(
        database.query_one(
            "SELECT :x + :x, ?2",
            Params::named(Vec::from_array([("x", Value::Integer(5)), ("", Value::Integer(9))])),
        ),
        "repeated named and positional",
    );
    testing::assert_eq(integer(named, 0), 10);
    testing::assert_eq(integer(named, 1), 9);
}

struct Item {
    id: i64,
    name: string,
}

impl FromRow for Item {
    fn from_row(row: Row) -> Result[Item, DbError] {
        Result::Ok(Item { id: row.get_named("id")?, name: row.get_named("name")? })
    }
}

#[test]
fn typed_rows_strict_conversions_missing_ambiguous_and_cardinality_errors() -> () {
    let database = memory();
    defer {
        let _ = database.close();
    };
    let item: Item = testing::expect_ok(
        database.query_one("SELECT 7 AS id, 'hello' AS name", Params::empty()),
        "typed row",
    );
    testing::assert_eq(item.id, 7);
    testing::assert_eq(item.name, "hello");
    let optional: Option[Item] = testing::expect_ok(
        database.query_optional("SELECT 7 AS id, 'hello' AS name WHERE 0", Params::empty()),
        "optional",
    );
    testing::assert(optional.is_none());
    let no_rows: Result[Row, DbError] = database.query_one("SELECT 1 WHERE 0", Params::empty());
    testing::assert_eq(testing::expect_err(no_rows, "no rows").kind, ErrorKind::NoRows);
    let multiple: Result[Row, DbError] = database.query_one(
        "SELECT 1 UNION ALL SELECT 2",
        Params::empty(),
    );
    testing::assert_eq(testing::expect_err(multiple, "multiple rows").kind, ErrorKind::MultipleRows);
    let duplicate = one(database, "SELECT 1 AS x, 2 AS x");
    testing::assert_err(duplicate.index("x"));
    testing::assert_err(duplicate.index("missing"));
    testing::assert_err(duplicate.value(-1));
    testing::assert_err(duplicate.value(2));
    let wrong: Result[string, DbError] = duplicate.get(0);
    testing::assert_eq(testing::expect_err(wrong, "strict string").kind, ErrorKind::Conversion);
    let wrong: Result[f64, DbError] = duplicate.get(0);
    testing::assert_err(wrong);
    let invalid: Result[bool, DbError] = FromValue::from_value(Value::Integer(2));
    testing::assert_err(invalid);
    let missing: Option[string] = Option::None;
    testing::assert(missing.to_value().is_null());
    let present = Option::Some("yes");
    let decoded: Result[string, DbError] = FromValue::from_value(present.to_value());
    testing::assert_eq(testing::expect_ok(decoded, "option encoding"), "yes");
    testing::assert_eq(database.resources().cursors, 0);
}

#[test]
fn streaming_busy_guards_limits_and_early_stop_release_connection() -> () {
    let database = memory();
    defer {
        let _ = database.close();
    };
    let rows = testing::expect_ok(
        database.query("SELECT 1 AS id UNION ALL SELECT 2 UNION ALL SELECT 3", Params::empty()),
        "cursor",
    );
    testing::assert_eq(testing::expect_ok(rows.columns(), "columns")[0].name, "id");
    testing::assert_eq(
        testing::expect_err(
            database.execute("CREATE TABLE blocked(x)", Params::empty()),
            "active cursor",
        ).kind,
        ErrorKind::Busy,
    );
    let sum: Ref[i64] = Ref::new(0);
    testing::assert_ok(
        rows.try_for_each(
            |row| {
                sum.set(sum.get() + row.get::[i64](0)?);
                Result::Ok(sum.get() < 3)
            },
        ),
    );
    testing::assert_eq(sum.get(), 3);
    testing::assert_eq(database.resources().cursors, 0);
    sql(database, "CREATE TABLE unblocked(x)");
    let limited: Result[Vec[Row], DbError] = database.query_all(
        "SELECT 1 UNION ALL SELECT 2",
        Params::empty(),
        1,
    );
    testing::assert_eq(testing::expect_err(limited, "row limit").kind, ErrorKind::Limit);
    testing::assert_eq(database.resources().cursors, 0);
    let bad: Result[Vec[Item], DbError] = database.query_all(
        "SELECT 1 AS id, 2 AS name",
        Params::empty(),
        10,
    );
    testing::assert_err(bad);
    testing::assert_eq(database.resources().cursors, 0);
    let empty = testing::expect_ok(
        database.query("SELECT 1 WHERE 0", Params::empty()),
        "empty cursor",
    );
    testing::assert(testing::expect_ok(empty.next(), "end").is_none());
    testing::assert(testing::expect_ok(empty.next(), "repeated end").is_none());
}

#[test]
fn transactions_commit_rollback_and_callback_errors_are_atomic() -> () {
    let database = memory();
    defer {
        let _ = database.close();
    };
    sql(database, "CREATE TABLE changes(value INTEGER)");
    let result = testing::expect_ok(
        database.transaction(
            TransactionMode::Immediate,
            |transaction| {
                transaction.execute("INSERT INTO changes VALUES(1)", Params::empty())?;
                transaction.execute("INSERT INTO changes VALUES(2)", Params::empty())?;
                Result::Ok("committed")
            },
        ),
        "transaction",
    );
    testing::assert_eq(result, "committed");
    let failed: Result[(), DbError] = database.transaction(
        TransactionMode::Deferred,
        |transaction| {
            transaction.execute("INSERT INTO changes VALUES(3)", Params::empty())?;
            Result::Err(DbError::new(ErrorKind::Argument, "reject batch"))
        },
    );
    testing::assert_eq(testing::expect_err(failed, "rollback").message, "reject batch");
    testing::assert_eq(integer(one(database, "SELECT sum(value) FROM changes"), 0), 3);
    let tx = testing::expect_ok(database.begin(TransactionMode::Exclusive), "begin");
    testing::assert_eq(
        testing::expect_err(
            database.execute("INSERT INTO changes VALUES(9)", Params::empty()),
            "root busy",
        ).kind,
        ErrorKind::Busy,
    );
    testing::assert_ok(tx.rollback());
    testing::assert_ok(tx.rollback());
    testing::assert(tx.is_closed());
    testing::assert_err(tx.commit());
    testing::assert_eq(database.resources().transactions, 0);
}

#[test]
fn nested_savepoints_preserve_parent_and_outer_rollback_closes_descendants() -> () {
    let database = memory();
    defer {
        let _ = database.close();
    };
    sql(database, "CREATE TABLE changes(value INTEGER)");
    let outer = testing::expect_ok(database.begin(TransactionMode::Deferred), "outer");
    let _ = testing::expect_ok(
        outer.execute("INSERT INTO changes VALUES(1)", Params::empty()),
        "outer insert",
    );
    let rejected: Result[(), DbError] = outer.with_savepoint(
        |inner| {
            inner.execute("INSERT INTO changes VALUES(2)", Params::empty())?;
            Result::Err(DbError::new(ErrorKind::Argument, "rejected inner"))
        },
    );
    testing::assert_err(rejected);
    testing::assert_ok(
        outer.with_savepoint(
            |inner| {
                inner.execute("INSERT INTO changes VALUES(3)", Params::empty())?;
                Result::Ok(())
            },
        ),
    );
    testing::assert_ok(outer.commit());
    testing::assert_eq(integer(one(database, "SELECT sum(value) FROM changes"), 0), 4);
    let outer = testing::expect_ok(database.begin(TransactionMode::Deferred), "outer again");
    let inner = testing::expect_ok(outer.savepoint(), "inner");
    let statement = testing::expect_ok(
        inner.prepare("INSERT INTO changes VALUES(5)"),
        "inner statement",
    );
    let _ = testing::expect_ok(statement.execute(Params::empty()), "inner write");
    let rows = testing::expect_ok(
        inner.query("SELECT value FROM changes", Params::empty()),
        "inner cursor",
    );
    testing::assert_err(outer.commit());
    testing::assert_ok(outer.rollback());
    testing::assert(inner.is_closed());
    testing::assert_err(statement.execute(Params::empty()));
    testing::assert_err(rows.next());
    testing::assert_eq(database.resources().statements, 0);
    testing::assert_eq(database.resources().cursors, 0);
    testing::assert_eq(database.resources().transactions, 0);
    testing::assert_eq(integer(one(database, "SELECT sum(value) FROM changes"), 0), 4);
}

#[test]
fn deferred_foreign_key_commit_failure_can_be_rolled_back() -> () {
    let database = memory();
    defer {
        let _ = database.close();
    };
    sql(database, "CREATE TABLE parent(id INTEGER PRIMARY KEY)");
    sql(
        database,
        "CREATE TABLE child(id INTEGER REFERENCES parent(id) DEFERRABLE INITIALLY DEFERRED)",
    );
    let tx = testing::expect_ok(database.begin(TransactionMode::Deferred), "begin");
    let _ = testing::expect_ok(
        tx.execute("INSERT INTO child VALUES(17)", Params::empty()),
        "deferred insert",
    );
    let error = testing::expect_err(tx.commit(), "deferred constraint");
    testing::assert_eq(error.kind, ErrorKind::Constraint);
    testing::assert_eq(error.primary_code(), 19);
    testing::assert(error.native_cause().is_some());
    testing::assert(!tx.is_closed());
    testing::assert_ok(tx.rollback());
    testing::assert_eq(integer(one(database, "SELECT count(*) FROM child"), 0), 0);
    testing::assert_eq(integer(one(database, "PRAGMA foreign_keys"), 0), 1);
}

#[test]
fn close_cascades_resources_and_rollback_is_visible_to_reused_handles() -> () {
    let database = memory();
    sql(database, "CREATE TABLE t(x)");
    let statement = testing::expect_ok(database.prepare("SELECT * FROM t"), "statement");
    let tx = testing::expect_ok(database.begin(TransactionMode::Immediate), "transaction");
    let rows = testing::expect_ok(tx.query("SELECT 1", Params::empty()), "rows");
    testing::assert_ok(database.close());
    testing::assert_ok(database.close());
    testing::assert(database.is_closed());
    testing::assert(tx.is_closed());
    testing::assert_eq(database.resources().statements, 0);
    testing::assert_eq(database.resources().cursors, 0);
    testing::assert_eq(database.resources().transactions, 0);
    testing::assert_ok(rows.close());
    testing::assert_ok(statement.close());
    testing::assert_ok(tx.rollback());
    testing::assert_eq(
        testing::expect_err(database.execute("SELECT 1", Params::empty()), "closed database").kind,
        ErrorKind::Closed,
    );
    testing::assert_eq(testing::expect_err(rows.next(), "closed rows").kind, ErrorKind::Closed);
}

#[test]
fn invalid_inputs_constraint_errors_and_non_utf8_text_are_recoverable() -> () {
    testing::assert_err(Database::open(""));
    testing::assert_err(Control::timeout(-1));
    testing::assert_err(
        Database::open_with(
            ":memory:",
            OpenOptions { busy_timeout_ms: -1, ..OpenOptions::standard() },
            Control::unlimited(),
        ),
    );
    let database = memory();
    defer {
        let _ = database.close();
    };
    testing::assert_eq(
        testing::expect_err(database.execute("SELECT\u0000 1", Params::empty()), "NUL SQL").kind,
        ErrorKind::Argument,
    );
    testing::assert_err(database.execute("INVALID SQL", Params::empty()));
    testing::assert_err(database.execute("SELECT ?", Params::empty()));
    testing::assert_err(
        database.execute(
            "SELECT :x",
            Params::named(Vec::from_array([("x", Value::Integer(1)), ("x", Value::Integer(2))])),
        ),
    );
    testing::assert_err(
        database.execute("SELECT :x", Params::named(Vec::from_array([(":x", Value::Integer(1))]))),
    );
    sql(database, "CREATE TABLE unique_values(x INTEGER UNIQUE NOT NULL)");
    sql(database, "INSERT INTO unique_values VALUES(1)");
    let error = testing::expect_err(
        database.execute("INSERT INTO unique_values VALUES(1)", Params::empty()),
        "unique",
    );
    testing::assert_eq(error.kind, ErrorKind::Constraint);
    testing::assert(error.code > 255);
    let invalid = one(database, "SELECT CAST(x'fffe' AS TEXT)");
    match testing::expect_ok(invalid.value(0), "raw text") {
        Value::TextBytes(bytes) => testing::assert(bytes.to_vec() == Vec::from_array([255, 254])),
        _ => testing::fail("TEXT bytes were lost"),
    }
    let conversion: Result[string, DbError] = invalid.get(0);
    testing::assert_err(conversion);
    let copied: Row = testing::expect_ok(
        database.query_one(
            "SELECT typeof(?), hex(?)",
            Params::positional(
                Vec::from_array(
                    [
                        testing::expect_ok(invalid.value(0), "value"),
                        testing::expect_ok(invalid.value(0), "value"),
                    ],
                ),
            ),
        ),
        "raw text bind",
    );
    testing::assert_eq(text(copied, 0), "text");
    testing::assert_eq(text(copied, 1), "FFFE");
    testing::assert_eq(
        integer(one(database, "SELECT json_extract('{\"value\":7}', '$.value')"), 0),
        7,
    );
}

fn expensive(database: Database, control: Control) -> Result[i64, DbError] {
    let rows = database.query_with(
        "WITH RECURSIVE n(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM n WHERE x<1000000000) SELECT sum(x) FROM n",
        Params::empty(),
        control,
    )?;
    defer {
        let _ = rows.close();
    };
    let row: Row = rows.one()?;
    row.get(0)
}

#[test]
fn query_deadline_and_external_cancellation_interrupt_sqlite() -> () {
    let database = memory();
    defer {
        let _ = database.close();
    };
    let control = testing::expect_ok(Control::timeout(20), "deadline");
    defer control.cancel();
    testing::assert_eq(
        testing::expect_err(expensive(database, control), "timeout").kind,
        ErrorKind::Timeout,
    );
    testing::assert_eq(integer(one(database, "SELECT 7"), 0), 7);
    let control = Control::unlimited();
    task::scope(
        |scope| {
            let worker = scope.spawn(|_| expensive(database, control));
            time::sleep(time::Duration::from_milliseconds(20));
            control.cancel();
            testing::assert_eq(
                testing::expect_err(worker.join(), "cancelled").kind,
                ErrorKind::Cancelled,
            );
        },
    );
    testing::assert_eq(database.resources().cursors, 0);
    testing::assert_eq(integer(one(database, "SELECT 8"), 0), 8);
}

#[test]
fn concurrent_writes_are_serialized_and_close_interrupts_an_active_query() -> () {
    let database = memory();
    sql(database, "CREATE TABLE items(value INTEGER)");
    task::scope(
        |scope| {
            let workers = Vec::new();
            for worker in 0..6 {
                workers.push(
                    scope.spawn(
                        |_| {
                            for index in 0..30 {
                                let _ = testing::expect_ok(
                                    database.execute(
                                        "INSERT INTO items VALUES(?)",
                                        Params::positional(
                                            Vec::from_array(
                                                [Value::Integer((worker * 30 + index).to_i64())],
                                            ),
                                        ),
                                    ),
                                    "concurrent insert",
                                );
                            }
                        },
                    ),
                );
            }
            for worker in workers {
                worker.join();
            }
        },
    );
    testing::assert_eq(integer(one(database, "SELECT count(*) FROM items"), 0), 180);
    task::scope(
        |scope| {
            let worker = scope.spawn(|_| expensive(database, Control::unlimited()));
            time::sleep(time::Duration::from_milliseconds(20));
            testing::assert_ok(database.close());
            let error = testing::expect_err(worker.join(), "closed query");
            testing::assert(error.kind == ErrorKind::Closed || error.kind == ErrorKind::Cancelled);
        },
    );
    testing::assert(database.is_closed());
}

#[test]
fn sqlite_automatic_rollback_invalidates_all_transaction_handles() -> () {
    let database = memory();
    defer {
        let _ = database.close();
    };
    sql(database, "CREATE TABLE guarded(x INTEGER UNIQUE)");
    sql(database, "INSERT INTO guarded VALUES(1)");
    let outer = testing::expect_ok(database.begin(TransactionMode::Deferred), "outer");
    let _ = testing::expect_ok(
        outer.execute("INSERT INTO guarded VALUES(2)", Params::empty()),
        "tentative",
    );
    let inner = testing::expect_ok(outer.savepoint(), "inner");
    testing::assert_eq(
        testing::expect_err(
            inner.execute("INSERT OR ROLLBACK INTO guarded VALUES(1)", Params::empty()),
            "automatic rollback",
        ).kind,
        ErrorKind::Constraint,
    );
    testing::assert(outer.is_closed());
    testing::assert(inner.is_closed());
    testing::assert_eq(
        testing::expect_err(
            inner.execute("INSERT INTO guarded VALUES(3)", Params::empty()),
            "cannot escape transaction",
        ).kind,
        ErrorKind::Closed,
    );
    testing::assert_eq(integer(one(database, "SELECT count(*) FROM guarded"), 0), 1);
    let outer = testing::expect_ok(database.begin(TransactionMode::Deferred), "new transaction");
    let rejected: Result[(), DbError] = outer.with_savepoint(
        |inner| {
            inner.execute("INSERT INTO guarded VALUES(1)", Params::empty())?;
            Result::Ok(())
        },
    );
    testing::assert_err(rejected);
    testing::assert(!outer.is_closed());
    let _ = testing::expect_ok(
        outer.execute("INSERT INTO guarded VALUES(4)", Params::empty()),
        "continue outer",
    );
    testing::assert_ok(outer.commit());
    testing::assert_eq(integer(one(database, "SELECT sum(x) FROM guarded"), 0), 5);
}

#[test]
fn transaction_sql_and_multiple_statements_cannot_bypass_managed_state() -> () {
    let database = memory();
    defer {
        let _ = database.close();
    };
    for input in Vec::from_array(
        [
            "BEGIN",
            "/* comment */ COMMIT",
            "ROLLBACK",
            "SAVEPOINT user",
            "SELECT 1; DELETE FROM x",
            "--comment\nEND TRANSACTION",
        ],
    ) {
        testing::assert_eq(
            testing::expect_err(database.execute(input, Params::empty()), "managed SQL").kind,
            ErrorKind::Argument,
        );
    }
    sql(database, "CREATE TABLE input(x INTEGER)");
    sql(database, "CREATE TABLE audit(x INTEGER)");
    sql(
        database,
        "CREATE TRIGGER track AFTER INSERT ON input BEGIN INSERT INTO audit VALUES(CASE WHEN NEW.x>0 THEN NEW.x ELSE 0 END); INSERT INTO audit VALUES(99); END;",
    );
    sql(database, "INSERT INTO input VALUES(7);");
    testing::assert_eq(
        integer(one(database, "SELECT sum(x) FROM audit; -- trailing comment"), 0),
        106,
    );
    testing::assert_eq(
        text(one(database, "SELECT '; COMMIT; -- not SQL' AS \"x;y\""), 0),
        "; COMMIT; -- not SQL",
    );
    testing::assert_eq(database.resources().transactions, 0);
}
