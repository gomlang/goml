package reqwest;

use std::ffi;
use std::context;
use std::time::{Duration};
use std::task;
use std::bytes::{FrozenBytes};

pub struct ClientBuilder {
    timeout_value: Duration,
    connect_value: Duration,
    idle_value: Duration,
    max_idle: isize,
    max_headers: i64,
    body_limit_value: isize,
    request_limit_value: isize,
    redirects: RedirectPolicy,
    headers: Headers,
    gzip_value: bool,
    cookies: bool,
    ca: string,
    certificate: string,
    key: string,
    proxy_value: string,
    env_proxy: bool,
    https: bool,
    error: Option[Error],
}

impl ClientBuilder {
    pub fn new() -> ClientBuilder {
        ClientBuilder {
            timeout_value: Duration::from_seconds(30),
            connect_value: Duration::from_seconds(10),
            idle_value: Duration::from_seconds(90),
            max_idle: 16,
            max_headers: 65536,
            body_limit_value: 16777216,
            request_limit_value: 16777216,
            redirects: RedirectPolicy::Limited(10),
            headers: Headers::new(),
            gzip_value: true,
            cookies: false,
            ca: "",
            certificate: "",
            key: "",
            proxy_value: "",
            env_proxy: false,
            https: false,
            error: Option::None,
        }
    }

    pub fn timeout(self: ClientBuilder, duration: Duration) -> ClientBuilder {
        ClientBuilder { timeout_value: duration, ..self }
    }

    pub fn connect_timeout(self: ClientBuilder, duration: Duration) -> ClientBuilder {
        ClientBuilder { connect_value: duration, ..self }
    }

    pub fn pool_idle_timeout(self: ClientBuilder, duration: Duration) -> ClientBuilder {
        ClientBuilder { idle_value: duration, ..self }
    }

    pub fn pool_max_idle(self: ClientBuilder, count: isize) -> ClientBuilder {
        ClientBuilder { max_idle: count, ..self }
    }

    pub fn max_header_bytes(self: ClientBuilder, count: i64) -> ClientBuilder {
        ClientBuilder { max_headers: count, ..self }
    }

    pub fn body_limit(self: ClientBuilder, count: isize) -> ClientBuilder {
        ClientBuilder { body_limit_value: count, ..self }
    }

    pub fn request_body_limit(self: ClientBuilder, count: isize) -> ClientBuilder {
        ClientBuilder { request_limit_value: count, ..self }
    }

    pub fn redirect(self: ClientBuilder, policy: RedirectPolicy) -> ClientBuilder {
        ClientBuilder { redirects: policy, ..self }
    }

    pub fn default_headers(self: ClientBuilder, headers: Headers) -> ClientBuilder {
        ClientBuilder { headers, ..self }
    }

    pub fn user_agent(self: ClientBuilder, value: string) -> ClientBuilder {
        match self.headers.insert("user-agent", value) {
            Ok(headers) => ClientBuilder { headers, ..self },
            Err(error) => ClientBuilder {
                error: if self.error.is_some() {
                    self.error
                } else {
                    Option::Some(error)
                },
                ..self,
            },
        }
    }

    pub fn gzip(self: ClientBuilder, enabled: bool) -> ClientBuilder {
        ClientBuilder { gzip_value: enabled, ..self }
    }

    pub fn cookie_store(self: ClientBuilder, enabled: bool) -> ClientBuilder {
        ClientBuilder { cookies: enabled, ..self }
    }

    pub fn add_root_certificate(self: ClientBuilder, pem: string) -> ClientBuilder {
        ClientBuilder { ca: self.ca + "\n" + pem, ..self }
    }

    pub fn identity(self: ClientBuilder, certificate: string, key: string) -> ClientBuilder {
        ClientBuilder { certificate, key, ..self }
    }

    pub fn proxy(self: ClientBuilder, url: string) -> ClientBuilder {
        ClientBuilder { proxy_value: url, env_proxy: false, ..self }
    }

    pub fn environment_proxy(self: ClientBuilder, enabled: bool) -> ClientBuilder {
        ClientBuilder { env_proxy: enabled, proxy_value: "", ..self }
    }

    pub fn no_proxy(self: ClientBuilder) -> ClientBuilder {
        ClientBuilder { env_proxy: false, proxy_value: "", ..self }
    }

    pub fn https_only(self: ClientBuilder, enabled: bool) -> ClientBuilder {
        ClientBuilder { https: enabled, ..self }
    }

    pub fn build(self: ClientBuilder) -> Result[Client, Error] {
        if let Some(error) = self.error {
            return Result::Err(error)
        }
        if self.timeout_value.is_zero() || self.connect_value.as_milliseconds() < 1
            || self.idle_value.as_milliseconds() < 1
            || self.max_idle < 1
            || self.max_headers < 1
            || self.body_limit_value < 0
            || self.body_limit_value.to_i64() == 9223372036854775807
            || self.request_limit_value < 0 {
            return Result::Err(
                Error::new(ErrorKind::Builder, "invalid client timeout or size limit"),
            )
        }
        match self.redirects {
            RedirectPolicy::Limited(value) | RedirectPolicy::SameOrigin(value) => if value < 0 {
                return Result::Err(Error::new(ErrorKind::Builder, "negative redirect limit"))
            },
            _ => (),
        }
        validate_request_headers(self.headers)?;
        let (raw, error) = raw_new_client(
            self.connect_value.as_milliseconds(),
            self.idle_value.as_milliseconds(),
            self.max_idle,
            self.max_headers,
            self.gzip_value,
            self.cookies,
            ffi::string_from_text(self.ca),
            ffi::string_from_text(self.certificate),
            ffi::string_from_text(self.key),
            ffi::string_from_text(self.proxy_value),
            self.env_proxy,
        );
        check(error)?;
        Result::Ok(Client { raw, options: self })
    }
}

pub struct Client {
    raw: NativeClient,
    options: ClientBuilder,
}

impl Client {
    pub fn builder() -> ClientBuilder {
        ClientBuilder::new()
    }

    pub fn new() -> Result[Client, Error] {
        ClientBuilder::new().build()
    }

    pub fn close(self: Client) -> () {
        raw_close(self.raw)
    }

    pub fn close_idle_connections(self: Client) -> () {
        raw_close_idle(self.raw)
    }

    pub fn is_closed(self: Client) -> bool {
        raw_is_closed(self.raw)
    }

    pub fn request(self: Client, method: string, url: string) -> RequestBuilder {
        RequestBuilder {
            client: self,
            method_value: method,
            url_text: url,
            headers: self.options.headers,
            body_value: FrozenBytes::new(),
            timeout_value: self.options.timeout_value,
            body_limit_value: self.options.body_limit_value,
            redirects: self.options.redirects,
            error: Option::None,
        }
    }

    pub fn get(self: Client, url: string) -> RequestBuilder {
        self.request("GET", url)
    }

    pub fn post(self: Client, url: string) -> RequestBuilder {
        self.request("POST", url)
    }

    pub fn put(self: Client, url: string) -> RequestBuilder {
        self.request("PUT", url)
    }

    pub fn patch(self: Client, url: string) -> RequestBuilder {
        self.request("PATCH", url)
    }

    pub fn delete(self: Client, url: string) -> RequestBuilder {
        self.request("DELETE", url)
    }

    pub fn head(self: Client, url: string) -> RequestBuilder {
        self.request("HEAD", url)
    }

    pub fn execute(self: Client, request: Request) -> Result[Response, Error] {
        self.execute_with(request, context::Context::background())
    }

    pub fn execute_with(self: Client, request: Request, context: context::Context) -> Result[
        Response,
        Error,
    ] {
        if self.is_closed() {
            return Result::Err(Error::new(ErrorKind::Closed, "client is closed"))
        }
        if let Some(error) = context.error() {
            return Result::Err(context_error(error))
        }
        if request.body_value.len() > self.options.request_limit_value {
            return Result::Err(Error::new(ErrorKind::BodyLimit, "request body exceeds limit"))
        }
        let mut timeout = request.timeout_value;
        if let Some(remaining) = context.remaining() {
            if remaining.compare(timeout) < 0 {
                timeout = remaining;
            }
        }
        let control = raw_new_control(timeout.as_nanoseconds());
        defer raw_cancel(control);
        task::scope(
            |scope| {
                let done: Channel[()] = Channel::new(0);
                defer done.close();
                let _ = scope.spawn(
                    |_| {
                        select {
                            recv(context.done()) as _ => raw_cancel(control),
                            recv(done) as _ => (),
                        }
                    },
                );
                let result = execute_loop(self, request, control);
                match result {
                    Err(error) => match context.error() {
                        Some(reason) => Result::Err(context_error(reason)),
                        None => Result::Err(error),
                    },
                    Ok(value) => Result::Ok(value),
                }
            },
        )
    }
}

fn context_error(error: context::Error) -> Error {
    match error {
        context::Error::Cancelled => Error::new(ErrorKind::Cancelled, "request cancelled"),
        context::Error::DeadlineExceeded => Error::new(
            ErrorKind::Timeout,
            "request deadline exceeded",
        ),
    }
}

fn execute_loop(client: Client, request: Request, control: NativeControl) -> Result[Response, Error] {
    let mut url = request.url_value;
    let mut method = request.method_value;
    let mut headers = request.headers_value;
    let mut body = request.body_value;
    let history: Vec[Url] = Vec::new();
    loop {
        if client.options.https && !url.is_https() {
            return Result::Err(Error::new(ErrorKind::Builder, "client requires HTTPS"))
        }
        let (names, values) = encode_pairs(headers.entries());
        let (native, error) = raw_do(
            client.raw,
            control,
            ffi::string_from_text(method),
            ffi::string_from_text(url.text),
            names,
            values,
            ffi::slice_from_vec_copy(body.to_vec_copy()),
            request.body_limit_value.to_i64(),
        );
        check(error)?;
        let status = raw_response_status(native);
        let response_names = ffi::slice_to_vec_copy(raw_response_names(native));
        let response_values = ffi::slice_to_vec_copy(raw_response_values(native));
        let mut response_headers = Headers::new();
        for index in 0..response_names.len() {
            response_headers = response_headers.append(
                native_text(response_names[index])?,
                native_text(response_values[index])?,
            )?;
        }
        let response = Response {
            status_value: StatusCode { value: status },
            headers_value: response_headers,
            body_value: FrozenBytes::from_vec_copy(
                ffi::slice_to_vec_copy(raw_response_body(native)),
            ),
            url_value: url,
            version_value: native_text(raw_response_version(native))?,
            history_value: history,
        };
        if status != 301 && status != 302 && status != 303 && status != 307 && status != 308 {
            return Result::Ok(response)
        }
        let limit = match request.redirects {
            RedirectPolicy::None => return Result::Ok(response),
            RedirectPolicy::Limited(value) | RedirectPolicy::SameOrigin(value) => value,
        };
        let location = match response_headers.get("location") {
            Some(value) => value,
            None => return Result::Ok(response),
        };
        if history.len() >= limit {
            return Result::Err(Error::new(ErrorKind::Redirect, "redirect limit exceeded"))
        }
        let next = url.join(location).map_err(
            |error| Error::new(ErrorKind::Redirect, error.message),
        )?;
        if url.is_https() && !next.is_https() {
            return Result::Err(Error::new(ErrorKind::Redirect, "HTTPS downgrade redirect rejected"))
        }
        match request.redirects {
            RedirectPolicy::SameOrigin(_) => if url.origin != next.origin {
                return Result::Err(
                    Error::new(ErrorKind::Redirect, "cross-origin redirect rejected"),
                )
            },
            _ => (),
        }
        if url.origin != next.origin {
            headers = headers.remove("authorization").remove("proxy-authorization").remove("cookie").remove(
                "cookie2",
            ).remove("www-authenticate");
        }
        if ((status == 301 || status == 302) && method == "POST")
            || (status == 303 && method != "HEAD") {
            method = "GET";
            body = FrozenBytes::new();
            headers = headers.remove("content-type").remove("content-encoding");
        }
        history.push(url);
        url = next;
    }
}

pub fn get(url: string) -> Result[Response, Error] {
    let client = Client::new()?;
    defer client.close();
    client.get(url).send()
}
