package reqwest;

use std::ffi;
use std::bytes::{Bytes};

#[go_type("example.com/goml-ecosystem/reqwest/adapter", "Part")]
extern type NativePart;

#[go_ffi("example.com/goml-ecosystem/reqwest/adapter", "NewPart")]
extern fn raw_part(
    name: ffi::String,
    filename: ffi::String,
    content_type: ffi::String,
    body: ffi::RawSlice[byte],
    file: bool,
) -> NativePart;

#[go_ffi("example.com/goml-ecosystem/reqwest/adapter", "Multipart")]
extern fn raw_multipart(parts: ffi::RawSlice[NativePart], limit: i64) -> (
    ffi::RawSlice[byte],
    ffi::String,
    NativeFailure,
);

pub struct Part {
    bytes_value: Bytes,
    filename: Option[string],
    content_type: string,
}

impl Part {
    pub fn text(value: string) -> Part {
        Part {
            bytes_value: Bytes::from_string(value),
            filename: Option::None,
            content_type: "text/plain; charset=utf-8",
        }
    }

    pub fn bytes(value: Bytes) -> Part {
        Part {
            bytes_value: copy_bytes(value),
            filename: Option::None,
            content_type: "application/octet-stream",
        }
    }

    pub fn file_name(self: Part, value: string) -> Part {
        Part { filename: Option::Some(value), ..self }
    }

    pub fn mime_type(self: Part, value: string) -> Part {
        Part { content_type: value, ..self }
    }
}

pub struct Multipart {
    parts: Vec[(string, Part)],
}

impl Multipart {
    pub fn new() -> Multipart {
        Multipart { parts: Vec::new() }
    }

    pub fn part(self: Multipart, name: string, value: Part) -> Multipart {
        let parts: Vec[(string, Part)] = Vec::new();
        for part in self.parts {
            parts.push(part)
        }
        parts.push((name, value));
        Multipart { parts }
    }

    pub fn text(self: Multipart, name: string, value: string) -> Multipart {
        self.part(name, Part::text(value))
    }
}

impl RequestBuilder {
    pub fn multipart(self: RequestBuilder, value: Multipart) -> RequestBuilder {
        let parts: Vec[NativePart] = Vec::new();
        let mut total = 0;
        for entry in value.parts {
            let size = entry.1.bytes_value.len();
            if size > self.client.options.request_limit_value - total {
                return self.failed(
                    Error::new(ErrorKind::BodyLimit, "multipart input exceeds request limit"),
                )
            }
            total += size;
            parts.push(
                raw_part(
                    ffi::string_from_text(entry.0),
                    ffi::string_from_text(entry.1.filename.unwrap_or("")),
                    ffi::string_from_text(entry.1.content_type),
                    ffi::slice_from_vec_copy(entry.1.bytes_value.to_vec()),
                    entry.1.filename.is_some(),
                ),
            )
        }
        let (body, content_type, error) = raw_multipart(
            ffi::slice_from_vec_copy(parts),
            self.client.options.request_limit_value.to_i64(),
        );
        if let Err(error) = check(error) {
            return self.failed(error)
        }
        match native_text(content_type) {
            Ok(content_type) => self.body(Bytes::from_vec(ffi::slice_to_vec_copy(body))).header(
                "content-type",
                content_type,
            ),
            Err(error) => self.failed(error),
        }
    }
}
