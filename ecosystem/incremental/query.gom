package incremental;

impl[K: Hash + Eq, V] Query[K, V] {
    fn trim(self: Query[K, V], target: isize) -> () {
        while self.entries.len() > target {
            let mut oldest: Option[(K, isize)] = Option::None;
            for (key, memo) in self.entries.entries() {
                let state = memo.state.get();
                if !state.active {
                    let earlier = match oldest {
                        Some((_, previous)) => state.used_at < previous,
                        None => true,
                    };
                    if earlier {
                        oldest = Option::Some((key, state.used_at));
                    }
                }
            }
            if let Some((key, _)) = oldest {
                self.entries.remove(key);
                let mut stats = self.stats_value.get();
                stats.evictions += 1;
                self.stats_value.set(stats);
            } else {
                return
            }
        }
    }

    fn ensure(self: Query[K, V], parent: Evaluation, key: K) -> Result[(V, isize, Ref[()]), Error] {
        parent.check()?;
        let memo = match self.entries.get(key) {
            Some(memo) => memo,
            None => {
                self.trim(self.capacity - 1);
                let memo = Memo {
                    identity: Ref::new(()),
                    label: self.name + "(" + (self.label)(key) + ")",
                    state: Ref::new(
                        MemoState {
                            value: Option::None,
                            changed_at: 0,
                            verified_at: 0,
                            dependencies: Vec::new(),
                            active: false,
                            used_at: 0,
                        },
                    ),
                };
                self.entries.set(key, memo);
                memo
            },
        };
        let child = parent.child(memo.identity, memo.label)?;
        let mut state = memo.state.get();
        if self.clock.get() == 9223372036854775807 {
            self.clock.set(0);
            for (_, cached) in self.entries.entries() {
                let mut previous = cached.state.get();
                previous.used_at = 0;
                cached.state.set(previous);
            }
        }
        self.clock.set(self.clock.get() + 1);
        state.used_at = self.clock.get();
        state.active = true;
        memo.state.set(state);
        let result = self.refresh(parent, child, key, memo);
        child.finish();
        let mut state = memo.state.get();
        state.active = false;
        memo.state.set(state);
        if result.is_err() {
            let mut stats = self.stats_value.get();
            stats.failures += 1;
            self.stats_value.set(stats);
        }
        self.trim(self.capacity);
        result
    }

    fn refresh(self: Query[K, V], parent: Evaluation, child: Evaluation, key: K, memo: Memo[V]) -> Result[
        (V, isize, Ref[()]),
        Error,
    ] {
        let revision = parent.database.revision_value.get();
        let mut state = memo.state.get();
        if let Some(value) = state.value {
            if state.verified_at == revision {
                let mut stats = self.stats_value.get();
                stats.cache_hits += 1;
                self.stats_value.set(stats);
                return Result::Ok((value, state.changed_at, memo.identity))
            }
            let mut stats = self.stats_value.get();
            stats.validations += 1;
            self.stats_value.set(stats);
            let mut valid = true;
            for dependency in state.dependencies {
                child.check()?;
                let matches = match (dependency.validate)(child) {
                    Ok(value) => value == dependency.observed,
                    Err(_) => false,
                };
                if !matches {
                    valid = false;
                    break
                }
            }
            if valid {
                state.verified_at = revision;
                memo.state.set(state);
                return Result::Ok((value, state.changed_at, memo.identity))
            }
        }
        child.check()?;
        let mut stats = self.stats_value.get();
        stats.executions += 1;
        self.stats_value.set(stats);
        let computed = (self.compute)(child, key);
        child.finish();
        child.context_value.check().map_err(cancelled)?;
        let value = computed?;
        let stored = (self.policy.copy)(value);
        let unchanged = match state.value {
            Some(previous) => (self.policy.equal)(previous, stored),
            None => false,
        };
        if unchanged {
            let mut stats = self.stats_value.get();
            stats.unchanged += 1;
            self.stats_value.set(stats);
        } else {
            state.changed_at = revision;
        }
        state.value = Option::Some(stored);
        state.verified_at = revision;
        state.dependencies = child.reads.copy();
        memo.state.set(state);
        Result::Ok((stored, state.changed_at, memo.identity))
    }
}
