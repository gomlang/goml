package incremental;

use std::context;

fn gate() -> Channel[()] {
    let value = Channel::new(1);
    value.send(());
    value
}

fn acquire(value: Channel[()], ctx: context::Context) -> Result[(), Error] {
    ctx.check().map_err(cancelled)?;
    select {
        recv(value) as _ => {
            if let Err(error) = ctx.check() {
                value.send(());
                return Result::Err(cancelled(error))
            }
            Result::Ok(())
        },
        recv(ctx.done()) as _ => Result::Err(
            cancelled(ctx.error().unwrap_or(context::Error::Cancelled)),
        ),
    }
}

impl Database {
    pub fn new() -> Database {
        Database {
            identity: Ref::new(()),
            gate: gate(),
            revision_value: Ref::new(1),
            max_depth: 256,
        }
    }

    pub fn with_depth_limit(max_depth: isize) -> Result[Database, Error] {
        if max_depth <= 0 {
            return Result::Err(failure(ErrorKind::Limit, "maximum query depth must be positive"))
        }
        Result::Ok(
            Database {
                identity: Ref::new(()),
                gate: gate(),
                revision_value: Ref::new(1),
                max_depth,
            },
        )
    }

    pub fn revision(self: Database) -> isize {
        let _ = self.gate.recv();
        defer self.gate.send(());
        self.revision_value.get()
    }

    pub fn input_with[T](self: Database, name: string, value: T, policy: ValuePolicy[T]) -> Input[T] {
        let _ = self.gate.recv();
        defer self.gate.send(());
        Input {
            owner: self.identity,
            identity: Ref::new(()),
            name,
            state: Ref::new(
                InputState { value: (policy.copy)(value), changed_at: self.revision_value.get() },
            ),
            policy,
        }
    }

    pub fn input[T: PartialEq](self: Database, name: string, value: T) -> Input[T] {
        self.input_with(name, value, ValuePolicy::immutable())
    }

    pub fn set_with[T](self: Database, input: Input[T], value: T, ctx: context::Context) -> Result[
        bool,
        Error,
    ] {
        acquire(self.gate, ctx)?;
        defer self.gate.send(());
        self.write(input, value)
    }

    pub fn try_set[T](self: Database, input: Input[T], value: T) -> Result[bool, Error] {
        select {
            recv(self.gate) as _ => (),
            default => return Result::Err(
                failure(ErrorKind::Busy, "database is already executing an operation"),
            ),
        }
        defer self.gate.send(());
        self.write(input, value)
    }

    fn write[T](self: Database, input: Input[T], value: T) -> Result[bool, Error] {
        if !ptr_eq(self.identity, input.owner) {
            return Result::Err(
                failure(ErrorKind::ForeignDatabase, "input belongs to another database"),
            )
        }
        let old = input.state.get();
        let replacement = (input.policy.copy)(value);
        if (input.policy.equal)(old.value, replacement) {
            return Result::Ok(false)
        }
        if self.revision_value.get() == 9223372036854775807 {
            return Result::Err(failure(ErrorKind::Limit, "revision counter exhausted"))
        }
        let revision = self.revision_value.get() + 1;
        input.state.set(InputState { value: replacement, changed_at: revision });
        self.revision_value.set(revision);
        Result::Ok(true)
    }

    pub fn set[T](self: Database, input: Input[T], value: T) -> Result[bool, Error] {
        self.set_with(input, value, context::Context::background())
    }

    pub fn apply_with(self: Database, changes: Vec[Change], ctx: context::Context) -> Result[
        bool,
        Error,
    ] {
        acquire(self.gate, ctx)?;
        defer self.gate.send(());
        for change in changes {
            self.check_owner(change.owner)?;
        }
        if self.revision_value.get() == 9223372036854775807 {
            return Result::Err(failure(ErrorKind::Limit, "revision counter exhausted"))
        }
        let revision = self.revision_value.get() + 1;
        let mut changed = false;
        for change in changes {
            let applied = (change.apply)(revision);
            changed = changed || applied;
        }
        if changed {
            self.revision_value.set(revision);
        }
        Result::Ok(changed)
    }

    pub fn apply(self: Database, changes: Vec[Change]) -> Result[bool, Error] {
        self.apply_with(changes, context::Context::background())
    }

    pub fn query_with[K: Hash + Eq, V](
        self: Database,
        name: string,
        capacity: isize,
        label: (K) -> string,
        policy: ValuePolicy[V],
        compute: (Evaluation, K) -> Result[V, Error],
    ) -> Result[Query[K, V], Error] {
        if capacity <= 0 {
            return Result::Err(failure(ErrorKind::Limit, "query cache capacity must be positive"))
        }
        Result::Ok(
            Query {
                owner: self.identity,
                name,
                capacity,
                label,
                compute,
                policy,
                entries: HashMap::new(),
                stats_value: Ref::new(empty_stats()),
                clock: Ref::new(0),
            },
        )
    }

    pub fn query[K: Hash + Eq + ToString, V: PartialEq](
        self: Database,
        name: string,
        capacity: isize,
        compute: (Evaluation, K) -> Result[V, Error],
    ) -> Result[Query[K, V], Error] {
        self.query_with(name, capacity, |key| key.to_string(), ValuePolicy::immutable(), compute)
    }

    pub fn fetch_with[K: Hash + Eq, V](
        self: Database,
        query: Query[K, V],
        key: K,
        ctx: context::Context,
    ) -> Result[V, Error] {
        acquire(self.gate, ctx)?;
        defer self.gate.send(());
        let evaluation = Evaluation {
            database: self,
            context_value: ctx,
            path: Vec::new(),
            reads: Vec::new(),
            access: gate(),
            ended: Channel::new(0),
        };
        defer evaluation.finish();
        evaluation.query(query, key)
    }

    pub fn fetch[K: Hash + Eq, V](self: Database, query: Query[K, V], key: K) -> Result[V, Error] {
        self.fetch_with(query, key, context::Context::background())
    }

    pub fn try_fetch[K: Hash + Eq, V](self: Database, query: Query[K, V], key: K) -> Result[
        V,
        Error,
    ] {
        select {
            recv(self.gate) as _ => (),
            default => return Result::Err(
                failure(ErrorKind::Busy, "database is already executing an operation"),
            ),
        }
        defer self.gate.send(());
        let evaluation = Evaluation {
            database: self,
            context_value: context::Context::background(),
            path: Vec::new(),
            reads: Vec::new(),
            access: gate(),
            ended: Channel::new(0),
        };
        defer evaluation.finish();
        evaluation.query(query, key)
    }

    pub fn clear[K: Hash + Eq, V](self: Database, query: Query[K, V]) -> Result[isize, Error] {
        let _ = self.gate.recv();
        defer self.gate.send(());
        self.check_owner(query.owner)?;
        let count = query.entries.len();
        for (key, _) in query.entries.entries() {
            query.entries.remove(key);
        }
        Result::Ok(count)
    }

    pub fn stats[K: Hash + Eq, V](self: Database, query: Query[K, V]) -> Result[Stats, Error] {
        let _ = self.gate.recv();
        defer self.gate.send(());
        self.check_owner(query.owner)?;
        Result::Ok(query.stats_value.get())
    }

    pub fn inspect[K: Hash + Eq, V](self: Database, query: Query[K, V]) -> Result[
        Vec[MemoInfo],
        Error,
    ] {
        let _ = self.gate.recv();
        defer self.gate.send(());
        self.check_owner(query.owner)?;
        let result = Vec::new();
        for (_, memo) in query.entries.entries() {
            let state = memo.state.get();
            let dependencies = Vec::new();
            for dependency in state.dependencies {
                dependencies.push(dependency.label);
            }
            result.push(
                MemoInfo {
                    label: memo.label,
                    changed_at: state.changed_at,
                    verified_at: state.verified_at,
                    dependencies,
                },
            );
        }
        Result::Ok(result)
    }

    fn check_owner(self: Database, owner: Ref[()]) -> Result[(), Error] {
        if !ptr_eq(self.identity, owner) {
            Result::Err(failure(ErrorKind::ForeignDatabase, "query belongs to another database"))
        } else {
            Result::Ok(())
        }
    }
}
