package tests;

use ecosystem::incremental as inc;
use std::context;
use std::testing;
use std::time;

#[test]
fn heterogeneous_batches_are_atomic_and_use_one_revision() -> () {
    let db = inc::Database::new();
    let number = db.input("number", 1);
    let text = db.input("text", "one");
    let query = testing::expect_ok(
        db.query(
            "pair",
            2,
            |read: inc::Evaluation, _: isize| Result::Ok(
                read.input(number)?.to_string() + ":" + read.input(text)?,
            ),
        ),
        "query",
    );
    testing::assert_eq(testing::expect_ok(db.fetch(query, 0), "initial"), "1:one");
    testing::assert(
        testing::expect_ok(
            db.apply(Vec::from_array([number.change(2), text.change("two")])),
            "batch",
        ),
    );
    testing::assert_eq(db.revision(), 2);
    testing::assert_eq(testing::expect_ok(db.fetch(query, 0), "updated"), "2:two");
    testing::assert(
        !testing::expect_ok(
            db.apply(Vec::from_array([number.change(2), text.change("two")])),
            "no-op batch",
        ),
    );
    testing::assert_eq(db.revision(), 2);
    let other = inc::Database::new().input("foreign", 0);
    testing::assert_err(db.apply(Vec::from_array([number.change(3), other.change(4)])));
    testing::assert_eq(
        testing::expect_ok(db.fetch(query, 0), "foreign batch changes nothing"),
        "2:two",
    );
}

#[test]
#[allow(unstructured_go)]
fn concurrent_batches_never_expose_partial_updates() -> () {
    let db = inc::Database::new();
    let number = db.input("number", 0);
    let text = db.input("text", "0");
    let query = testing::expect_ok(
        db.query(
            "consistent",
            2,
            |read: inc::Evaluation, _: isize| Result::Ok(
                read.input(number)?.to_string() == read.input(text)?,
            ),
        ),
        "query",
    );
    let start = Channel::new(2);
    let done = Channel::new(2);
    go || {
        let _ = start.recv();
        for index in 1..100 {
            testing::assert_ok(
                db.apply(Vec::from_array([number.change(index), text.change(index.to_string())])),
            );
        }
        done.send(());
    };
    go || {
        let _ = start.recv();
        for _ in 0..100 {
            testing::assert(testing::expect_ok(db.fetch(query, 0), "atomic snapshot"));
        }
        done.send(());
    };
    start.send(());
    start.send(());
    let _ = done.recv();
    let _ = done.recv();
    testing::assert_eq(db.revision(), 100);
}

#[test]
fn diamond_dependencies_evaluate_shared_leaf_once() -> () {
    let db = inc::Database::new();
    let input = db.input("base", 1);
    let leaf = testing::expect_ok(
        db.query("leaf", 4, |read: inc::Evaluation, _: isize| read.input(input)),
        "leaf",
    );
    let left = testing::expect_ok(
        db.query(
            "left",
            4,
            |read: inc::Evaluation, key: isize| Result::Ok(read.query(leaf, key)? + 1),
        ),
        "left",
    );
    let right = testing::expect_ok(
        db.query(
            "right",
            4,
            |read: inc::Evaluation, key: isize| Result::Ok(read.query(leaf, key)? + 2),
        ),
        "right",
    );
    let root = testing::expect_ok(
        db.query(
            "root",
            4,
            |read: inc::Evaluation, key: isize| Result::Ok(
                read.query(left, key)? + read.query(right, key)?,
            ),
        ),
        "root",
    );
    testing::assert_eq(testing::expect_ok(db.fetch(root, 0), "diamond"), 5);
    testing::assert_eq(testing::expect_ok(db.stats(leaf), "stats").executions, 1);
    testing::assert_ok(db.set(input, 10));
    testing::assert_eq(testing::expect_ok(db.fetch(root, 0), "changed diamond"), 23);
    testing::assert_eq(testing::expect_ok(db.stats(leaf), "stats").executions, 2);
}

#[test]
fn diamond_heterogeneous_queries_and_unchanged_cutoff() -> () {
    let db = inc::Database::new();
    let text = db.input("source", "abcd");
    let length = testing::expect_ok(
        db.query(
            "length",
            8,
            |read: inc::Evaluation, _: isize| Result::Ok(read.input(text)?.byte_len()),
        ),
        "length",
    );
    let even = testing::expect_ok(
        db.query(
            "even",
            8,
            |read: inc::Evaluation, key: isize| Result::Ok(read.query(length, key)? % 2 == 0),
        ),
        "even",
    );
    let render = testing::expect_ok(
        db.query(
            "render",
            8,
            |read: inc::Evaluation, key: isize| {
                let value = read.query(even, key)?;
                let again = read.query(even, key)?;
                Result::Ok(
                    if value && again {
                        "even"
                    } else {
                        "odd"
                    },
                )
            },
        ),
        "render",
    );
    testing::assert_eq(testing::expect_ok(db.fetch(render, 0), "initial"), "even");
    testing::assert_eq(testing::expect_ok(db.fetch(render, 0), "memo"), "even");
    testing::assert_eq(testing::expect_ok(db.stats(length), "stats").executions, 1);
    testing::assert(testing::expect_ok(db.set(text, "abcdef"), "changed"));
    testing::assert_eq(testing::expect_ok(db.fetch(render, 0), "backdated"), "even");
    testing::assert_eq(testing::expect_ok(db.stats(length), "stats").executions, 2);
    testing::assert_eq(testing::expect_ok(db.stats(even), "stats").unchanged, 1);
    testing::assert_eq(testing::expect_ok(db.stats(render), "stats").executions, 1);
    testing::assert(!testing::expect_ok(db.set(text, "abcdef"), "equal input"));
    testing::assert_eq(db.revision(), 2);
    testing::assert_ok(db.set(text, "abc"));
    testing::assert_eq(testing::expect_ok(db.fetch(render, 0), "changed output"), "odd");
    testing::assert_eq(testing::expect_ok(db.stats(render), "stats").executions, 2);
}

#[test]
fn dynamic_dependencies_replace_even_when_result_is_equal() -> () {
    let db = inc::Database::new();
    let switch = db.input("switch", true);
    let left = db.input("left", 10);
    let right = db.input("right", 10);
    let branch = testing::expect_ok(
        db.query(
            "branch",
            4,
            |read: inc::Evaluation, _: isize| {
                if read.input(switch)? {
                    read.input(left)
                } else {
                    read.input(right)
                }
            },
        ),
        "branch",
    );
    let root = testing::expect_ok(
        db.query(
            "root",
            4,
            |read: inc::Evaluation, key: isize| Result::Ok(read.query(branch, key)? * 2),
        ),
        "root",
    );
    testing::assert_eq(testing::expect_ok(db.fetch(root, 0), "left"), 20);
    testing::assert_ok(db.set(switch, false));
    testing::assert_eq(testing::expect_ok(db.fetch(root, 0), "same right"), 20);
    testing::assert_eq(testing::expect_ok(db.stats(root), "stats").executions, 1);
    testing::assert_ok(db.set(left, 100));
    testing::assert_eq(testing::expect_ok(db.fetch(root, 0), "unused left"), 20);
    testing::assert_eq(testing::expect_ok(db.stats(branch), "stats").executions, 2);
    testing::assert_ok(db.set(right, 9));
    testing::assert_eq(testing::expect_ok(db.fetch(root, 0), "new right"), 18);
    let info = testing::expect_ok(db.inspect(branch), "inspect")[0];
    testing::assert(info.dependencies == Vec::from_array(["switch", "right"]));
}

#[test]
fn cycles_are_recoverable_and_have_paths() -> () {
    let db = inc::Database::new();
    let recursive: Ref[Option[inc::Query[isize, isize]]] = Ref::new(Option::None);
    let query = testing::expect_ok(
        db.query(
            "recursive",
            8,
            |read: inc::Evaluation, key: isize| {
                if key == 0 {
                    return Result::Ok(7)
                }
                let next = recursive.get().ok_or(inc::Error::user("not installed"))?;
                read.query(
                    next,
                    if key == 1 {
                        2
                    } else {
                        1
                    },
                )
            },
        ),
        "recursive",
    );
    recursive.set(Option::Some(query));
    let error = testing::expect_err(db.fetch(query, 1), "cycle");
    testing::assert_eq(error.kind, inc::ErrorKind::Cycle);
    testing::assert(error.path == Vec::from_array(["recursive(1)", "recursive(2)", "recursive(1)"]));
    testing::assert_eq(testing::expect_ok(db.fetch(query, 0), "recovery"), 7);
}

#[test]
fn failures_are_retried_and_caught_errors_track_revision() -> () {
    let db = inc::Database::new();
    let input = db.input("input", -1);
    let child = testing::expect_ok(
        db.query(
            "fallible",
            8,
            |read: inc::Evaluation, _: isize| {
                let value = read.input(input)?;
                if value < 0 {
                    Result::Err(inc::Error::user("negative"))
                } else {
                    Result::Ok(value)
                }
            },
        ),
        "child",
    );
    let parent = testing::expect_ok(
        db.query(
            "fallback",
            8,
            |read: inc::Evaluation, key: isize| Result::Ok(read.query(child, key).unwrap_or(100)),
        ),
        "parent",
    );
    testing::assert_eq(testing::expect_ok(db.fetch(parent, 0), "fallback"), 100);
    testing::assert_ok(db.set(input, 5));
    testing::assert_eq(testing::expect_ok(db.fetch(parent, 0), "recovered"), 5);
    testing::assert_ok(db.set(input, -2));
    testing::assert_eq(
        testing::expect_ok(db.fetch(parent, 0), "failed validation reruns parent"),
        100,
    );
    testing::assert_err(db.fetch(child, 0));
    testing::assert_err(db.fetch(child, 0));
    testing::assert_ok(db.set(input, 8));
    testing::assert_eq(testing::expect_ok(db.fetch(parent, 0), "recovered again"), 8);
}

#[test]
fn bounded_caches_clear_and_foreign_handles() -> () {
    let db = inc::Database::new();
    let input = db.input("number", 2);
    let query = testing::expect_ok(
        db.query(
            "multiply",
            2,
            |read: inc::Evaluation, key: isize| Result::Ok(read.input(input)? * key),
        ),
        "query",
    );
    for key in 0..10 {
        testing::assert_eq(testing::expect_ok(db.fetch(query, key), "fetch"), key * 2);
    }
    testing::assert_eq(testing::expect_ok(db.inspect(query), "capacity").len(), 2);
    testing::assert_eq(testing::expect_ok(db.stats(query), "evictions").evictions, 8);
    testing::assert_eq(testing::expect_ok(db.clear(query), "clear"), 2);
    testing::assert_eq(testing::expect_ok(db.fetch(query, 9), "after clear"), 18);
    let other = inc::Database::new();
    testing::assert_eq(
        testing::expect_err(other.fetch(query, 0), "foreign query").kind,
        inc::ErrorKind::ForeignDatabase,
    );
    testing::assert_eq(
        testing::expect_err(other.set(input, 3), "foreign input").kind,
        inc::ErrorKind::ForeignDatabase,
    );
    testing::assert_err(other.clear(query));
    testing::assert_err(
        db.query("invalid", 0, |_: inc::Evaluation, value: isize| Result::Ok(value)),
    );
    testing::assert_err(inc::Database::with_depth_limit(0));
}

#[test]
fn copy_policies_isolate_mutable_values() -> () {
    let db = inc::Database::new();
    let policy = inc::ValuePolicy::new(
        |a: Vec[isize], b: Vec[isize]| a == b,
        |value: Vec[isize]| value.copy(),
    );
    let original = Vec::from_array([1, 2]);
    let input = db.input_with("numbers", original, policy);
    original.push(3);
    let query = testing::expect_ok(
        db.query_with(
            "copy",
            4,
            |key: isize| key.to_string(),
            policy,
            |read: inc::Evaluation, _: isize| read.input(input),
        ),
        "query",
    );
    let first = testing::expect_ok(db.fetch(query, 0), "fetch");
    testing::assert(first == Vec::from_array([1, 2]));
    first.push(4);
    testing::assert(testing::expect_ok(db.fetch(query, 0), "isolated") == Vec::from_array([1, 2]));
}

#[test]
#[allow(unstructured_go)]
fn concurrent_root_queries_share_one_execution() -> () {
    let db = inc::Database::new();
    let query = testing::expect_ok(
        db.query(
            "shared",
            4,
            |_: inc::Evaluation, key: isize| {
                time::sleep(time::Duration::from_milliseconds(2));
                Result::Ok(key * 3)
            },
        ),
        "query",
    );
    let done = Channel::new(16);
    for _ in 0..16 {
        go || done.send(db.fetch(query, 7));
    }
    for _ in 0..16 {
        testing::assert_eq(
            testing::expect_ok(testing::expect_some(done.recv(), "joined"), "fetch"),
            21,
        );
    }
    testing::assert_eq(testing::expect_ok(db.stats(query), "stats").executions, 1);
}

#[test]
#[allow(unstructured_go)]
fn cancellation_while_waiting_and_during_computation() -> () {
    let db = inc::Database::new();
    let entered = Channel::new(1);
    let release = Channel::new(1);
    let query = testing::expect_ok(
        db.query(
            "blocking",
            4,
            |_: inc::Evaluation, key: isize| {
                entered.send(());
                let _ = release.recv();
                Result::Ok(key)
            },
        ),
        "query",
    );
    let finished = Channel::new(1);
    go || finished.send(db.fetch(query, 1));
    let _ = entered.recv();
    context::with_cancel(
        context::Context::background(),
        |ctx, cancel| {
            cancel.cancel();
            testing::assert_eq(
                testing::expect_err(db.fetch_with(query, 1, ctx), "cancelled waiting").kind,
                inc::ErrorKind::Cancelled,
            );
        },
    );
    context::with_timeout(
        context::Context::background(),
        time::Duration::from_milliseconds(5),
        |ctx, _| {
            testing::assert_eq(
                testing::expect_err(db.fetch_with(query, 1, ctx), "deadline while waiting").kind,
                inc::ErrorKind::DeadlineExceeded,
            );
        },
    );
    testing::assert_eq(
        testing::expect_err(db.try_fetch(query, 1), "busy").kind,
        inc::ErrorKind::Busy,
    );
    release.send(());
    testing::assert_ok(testing::expect_some(finished.recv(), "join"));
    context::with_cancel(
        context::Context::background(),
        |ctx, cancel| {
            let cancelled = testing::expect_ok(
                db.query(
                    "cancel",
                    2,
                    |_read: inc::Evaluation, value: isize| {
                        cancel.cancel();
                        Result::Ok(value)
                    },
                ),
                "cancel query",
            );
            testing::assert_eq(
                testing::expect_err(db.fetch_with(cancelled, 3, ctx), "cancel before publish").kind,
                inc::ErrorKind::Cancelled,
            );
            testing::assert_eq(
                testing::expect_ok(db.inspect(cancelled), "inspect")[0].verified_at,
                0,
            );
        },
    );
}

#[test]
#[allow(unstructured_go)]
fn callback_access_is_joined_before_publication_and_expires() -> () {
    let db = inc::Database::new();
    let input = db.input("value", 7);
    let started = Channel::new(1);
    let release = Channel::new(1);
    let async_done = Channel::new(1);
    let saved: Ref[Option[inc::Evaluation]] = Ref::new(Option::None);
    let child = testing::expect_ok(
        db.query(
            "slow",
            4,
            |read: inc::Evaluation, _: isize| {
                started.send(());
                let _ = release.recv();
                read.input(input)
            },
        ),
        "slow",
    );
    let parent = testing::expect_ok(
        db.query(
            "launch",
            4,
            |read: inc::Evaluation, key: isize| {
                saved.set(Option::Some(read));
                go || async_done.send(read.query(child, key));
                let _ = started.recv();
                testing::assert_eq(
                    testing::expect_err(read.input(input), "concurrent read").kind,
                    inc::ErrorKind::ConcurrentEvaluation,
                );
                testing::assert_eq(
                    testing::expect_err(db.try_set(input, 9), "reentrant write").kind,
                    inc::ErrorKind::Busy,
                );
                release.send(());
                Result::Ok(10)
            },
        ),
        "parent",
    );
    testing::assert_eq(testing::expect_ok(db.fetch(parent, 0), "joined"), 10);
    testing::assert_eq(
        testing::expect_ok(testing::expect_some(async_done.recv(), "async joined"), "async value"),
        7,
    );
    let expired = testing::expect_some(saved.get(), "saved");
    testing::assert_eq(
        testing::expect_err(expired.input(input), "expired").kind,
        inc::ErrorKind::ExpiredEvaluation,
    );
    testing::assert(
        testing::expect_ok(db.inspect(parent), "dependencies")[0].dependencies
            == Vec::from_array(["slow(0)"]),
    );
}

#[test]
fn depth_limit_and_evicted_dependencies_remain_sound() -> () {
    let db = testing::expect_ok(inc::Database::with_depth_limit(4), "depth");
    let recursive: Ref[Option[inc::Query[isize, isize]]] = Ref::new(Option::None);
    let input = db.input("base", 1);
    let query = testing::expect_ok(
        db.query(
            "sum",
            1,
            |read: inc::Evaluation, key: isize| {
                if key == 0 {
                    read.input(input)
                } else {
                    Result::Ok(
                        read.query(recursive.get().ok_or(inc::Error::user("missing"))?, key - 1)?
                            + 1,
                    )
                }
            },
        ),
        "query",
    );
    recursive.set(Option::Some(query));
    testing::assert_eq(testing::expect_ok(db.fetch(query, 3), "depth four"), 4);
    testing::assert_eq(testing::expect_ok(db.inspect(query), "bounded").len(), 1);
    testing::assert_eq(
        testing::expect_err(db.fetch(query, 5), "depth exceeded").kind,
        inc::ErrorKind::Limit,
    );
    testing::assert_ok(db.set(input, 10));
    testing::assert_eq(testing::expect_ok(db.fetch(query, 3), "changed with evictions"), 13);
}
