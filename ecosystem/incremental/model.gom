package incremental;

use std::context;

#[derive(Debug, PartialEq, Eq)]
pub enum ErrorKind {
    Cycle,
    Cancelled,
    DeadlineExceeded,
    ForeignDatabase,
    ExpiredEvaluation,
    ConcurrentEvaluation,
    Busy,
    Limit,
    User,
}

pub struct Error {
    pub kind: ErrorKind,
    pub message: string,
    pub path: Vec[string],
}

impl Error {
    pub fn user(message: string) -> Error {
        failure(ErrorKind::User, message)
    }
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        self.message
    }
}

impl Debug for Error {
    fn debug(self: Error) -> string {
        self.message
    }
}

fn failure(kind: ErrorKind, message: string) -> Error {
    Error { kind, message, path: Vec::new() }
}

fn cancelled(error: context::Error) -> Error {
    match error {
        Cancelled => failure(ErrorKind::Cancelled, "incremental evaluation cancelled"),
        DeadlineExceeded => failure(
            ErrorKind::DeadlineExceeded,
            "incremental evaluation deadline exceeded",
        ),
    }
}

pub struct ValuePolicy[T] {
    equal: (T, T) -> bool,
    copy: (T) -> T,
}

impl[T] ValuePolicy[T] {
    pub fn new(equal: (T, T) -> bool, copy: (T) -> T) -> ValuePolicy[T] {
        ValuePolicy { equal, copy }
    }
}

impl[T: PartialEq] ValuePolicy[T] {
    pub fn immutable() -> ValuePolicy[T] {
        ValuePolicy::new(|left, right| left == right, |value| value)
    }
}

#[derive(Debug, PartialEq)]
pub struct Stats {
    pub executions: isize,
    pub cache_hits: isize,
    pub validations: isize,
    pub unchanged: isize,
    pub evictions: isize,
    pub failures: isize,
}

fn empty_stats() -> Stats {
    Stats { executions: 0, cache_hits: 0, validations: 0, unchanged: 0, evictions: 0, failures: 0 }
}

pub struct MemoInfo {
    pub label: string,
    pub changed_at: isize,
    pub verified_at: isize,
    pub dependencies: Vec[string],
}

struct Dependency {
    identity: Ref[()],
    label: string,
    observed: isize,
    validate: (Evaluation) -> Result[isize, Error],
}

struct Active {
    identity: Ref[()],
    label: string,
}

struct InputState[T] {
    value: T,
    changed_at: isize,
}

pub struct Input[T] {
    owner: Ref[()],
    identity: Ref[()],
    name: string,
    state: Ref[InputState[T]],
    policy: ValuePolicy[T],
}

pub struct Change {
    owner: Ref[()],
    apply: (isize) -> bool,
}

impl[T] Input[T] {
    pub fn change(self: Input[T], value: T) -> Change {
        let replacement = (self.policy.copy)(value);
        Change {
            owner: self.owner,
            apply: |revision| {
                let previous = self.state.get();
                if (self.policy.equal)(previous.value, replacement) {
                    false
                } else {
                    self.state.set(
                        InputState { value: (self.policy.copy)(replacement), changed_at: revision },
                    );
                    true
                }
            },
        }
    }
}

struct MemoState[V] {
    value: Option[V],
    changed_at: isize,
    verified_at: isize,
    dependencies: Vec[Dependency],
    active: bool,
    used_at: isize,
}

struct Memo[V] {
    identity: Ref[()],
    label: string,
    state: Ref[MemoState[V]],
}

pub struct Query[K, V] {
    owner: Ref[()],
    name: string,
    capacity: isize,
    label: (K) -> string,
    compute: (Evaluation, K) -> Result[V, Error],
    policy: ValuePolicy[V],
    entries: HashMap[K, Memo[V]],
    stats_value: Ref[Stats],
    clock: Ref[isize],
}

pub struct Database {
    identity: Ref[()],
    gate: Channel[()],
    revision_value: Ref[isize],
    max_depth: isize,
}

pub struct Evaluation {
    database: Database,
    context_value: context::Context,
    path: Vec[Active],
    reads: Vec[Dependency],
    access: Channel[()],
    ended: Channel[()],
}
