package tests;

use ecosystem::cache;
use std::context;
use std::task;
use std::testing;
use std::time;

fn until(condition: () -> bool) -> () {
    let start = time::Instant::now();
    while !condition() {
        testing::assert(start.elapsed().as_seconds() < 5);
        time::sleep(time::Duration::from_milliseconds(1));
    }
}

#[test]
fn concurrent_misses_share_one_value_and_hit_bypasses_loader() -> () {
    let values = make(cache::Options::new(3));
    let started = Channel::new(1);
    let release = Channel::new(1);
    task::scope(
        |scope| {
            let leader = scope.spawn(
                |_| values.get_or_try_insert_with(
                    context::Context::background(),
                    1,
                    |_| {
                        started.send(());
                        let _ = release.recv();
                        Result::Ok(cache::Loaded::new("one", 1))
                    },
                ),
            );
            let _ = started.recv();
            let waiters = Vec::new();
            for _ in 0..16 {
                waiters.push(
                    scope.spawn(
                        |_| values.get_or_try_insert_with(
                            context::Context::background(),
                            1,
                            |_| Result::Err(cache::Error::Loader("duplicate")),
                        ),
                    ),
                );
            }
            until(|| values.stats().waiters == 16);
            release.send(());
            testing::assert_eq(testing::expect_ok(leader.join(), "leader"), "one");
            for waiter in waiters {
                testing::assert_eq(testing::expect_ok(waiter.join(), "waiter"), "one");
            }
        },
    );
    testing::assert_eq(
        testing::expect_ok(
            values.get_or_try_insert_with(
                context::Context::background(),
                1,
                |_| Result::Err(cache::Error::Loader("hit called loader")),
            ),
            "hit",
        ),
        "one",
    );
    testing::assert_eq(values.stats().loads, 1);
    testing::assert_eq(values.stats().coalesced, 16);
    testing::assert_eq(values.stats().waiters, 0);
}

#[test]
fn different_keys_load_in_parallel_and_callbacks_can_read_cache() -> () {
    let values = make(cache::Options::new(3));
    put(values, 0, "existing", 1);
    let started = Channel::new(2);
    let release = Channel::new(2);
    task::scope(
        |scope| {
            let tasks = Vec::new();
            for key in 1..3 {
                tasks.push(
                    scope.spawn(
                        |_| values.get_or_try_insert_with(
                            context::Context::background(),
                            key,
                            |_| {
                                testing::assert(get(values, 0) == Option::Some("existing"));
                                started.send(());
                                let _ = release.recv();
                                Result::Ok(cache::Loaded::new(key.to_string(), 1))
                            },
                        ),
                    ),
                );
            }
            let _ = started.recv();
            let _ = started.recv();
            testing::assert_eq(values.stats().inflight, 2);
            release.send(());
            release.send(());
            for result in tasks {
                testing::assert_ok(result.join());
            }
        },
    );
}

#[test]
fn waiter_cancellation_does_not_cancel_the_shared_loader() -> () {
    let values = make(cache::Options::new(2));
    let started = Channel::new(1);
    let release = Channel::new(1);
    task::scope(
        |scope| {
            let leader = scope.spawn(
                |_| values.get_or_try_insert_with(
                    context::Context::background(),
                    1,
                    |_| {
                        started.send(());
                        let _ = release.recv();
                        Result::Ok(cache::Loaded::new("result", 1))
                    },
                ),
            );
            let _ = started.recv();
            context::with_cancel(
                context::Context::background(),
                |ctx, cancel| {
                    let waiter = scope.spawn(
                        |_| values.get_or_try_insert_with(
                            ctx,
                            1,
                            |_| Result::Err(cache::Error::Loader("unused")),
                        ),
                    );
                    until(|| values.stats().waiters == 1);
                    cancel.cancel();
                    testing::assert_eq(
                        testing::expect_err(waiter.join(), "cancelled"),
                        cache::Error::Cancelled,
                    );
                },
            );
            testing::assert_eq(values.stats().inflight, 1);
            testing::assert_eq(values.stats().waiters, 0);
            release.send(());
            testing::assert_ok(leader.join());
        },
    );
    testing::assert(get(values, 1) == Option::Some("result"));
}

#[test]
fn leader_cancellation_is_shared_and_failure_is_not_cached() -> () {
    let values = make(cache::Options::new(2));
    let started = Channel::new(1);
    context::with_cancel(
        context::Context::background(),
        |ctx, cancel| {
            task::scope(
                |scope| {
                    let leader = scope.spawn(
                        |_| values.get_or_try_insert_with(
                            ctx,
                            1,
                            |load| {
                                started.send(());
                                load.sleep(time::Duration::from_seconds(5))?;
                                Result::Ok(cache::Loaded::new("never", 1))
                            },
                        ),
                    );
                    let _ = started.recv();
                    let waiter = scope.spawn(
                        |_| values.get_or_try_insert_with(
                            context::Context::background(),
                            1,
                            |_| Result::Err(cache::Error::Loader("unused")),
                        ),
                    );
                    until(|| values.stats().waiters == 1);
                    cancel.cancel();
                    testing::assert_eq(
                        testing::expect_err(leader.join(), "leader"),
                        cache::Error::Cancelled,
                    );
                    testing::assert_eq(
                        testing::expect_err(waiter.join(), "waiter"),
                        cache::Error::Cancelled,
                    );
                },
            );
        },
    );
    testing::assert(get(values, 1).is_none());
    testing::assert_ok(
        values.get_or_try_insert_with(
            context::Context::background(),
            1,
            |_| Result::Ok(cache::Loaded::new("retry", 1)),
        ),
    );
    testing::assert_eq(values.stats().loads, 2);
}

#[test]
fn invalidation_separates_generations_and_old_result_cannot_resurrect() -> () {
    let values = make(cache::Options::new(2));
    let started = Channel::new(1);
    let release = Channel::new(1);
    task::scope(
        |scope| {
            let old = scope.spawn(
                |_| values.get_or_try_insert_with(
                    context::Context::background(),
                    1,
                    |_| {
                        started.send(());
                        let _ = release.recv();
                        Result::Ok(cache::Loaded::new("old", 1))
                    },
                ),
            );
            let _ = started.recv();
            let waiter = scope.spawn(
                |_| values.get_or_try_insert_with(
                    context::Context::background(),
                    1,
                    |_| Result::Err(cache::Error::Loader("unused")),
                ),
            );
            until(|| values.stats().waiters == 1);
            testing::assert_ok(values.invalidate(1));
            testing::assert_eq(
                testing::expect_err(waiter.join(), "invalidated waiter"),
                cache::Error::Invalidated,
            );
            testing::assert_eq(
                testing::expect_ok(
                    values.get_or_try_insert_with(
                        context::Context::background(),
                        1,
                        |_| Result::Ok(cache::Loaded::new("new", 1)),
                    ),
                    "new generation",
                ),
                "new",
            );
            release.send(());
            testing::assert_eq(
                testing::expect_err(old.join(), "old generation"),
                cache::Error::Invalidated,
            );
        },
    );
    testing::assert(get(values, 1) == Option::Some("new"));
    testing::assert_eq(values.stats().inflight, 0);
}

#[test]
fn replacement_and_clear_discard_outstanding_loads() -> () {
    for action in 0..2 {
        let values = make(cache::Options::new(2));
        let started = Channel::new(1);
        let release = Channel::new(1);
        task::scope(
            |scope| {
                let old = scope.spawn(
                    |_| values.get_or_try_insert_with(
                        context::Context::background(),
                        1,
                        |_| {
                            started.send(());
                            let _ = release.recv();
                            Result::Ok(cache::Loaded::new("stale", 1))
                        },
                    ),
                );
                let _ = started.recv();
                if action == 0 {
                    put(values, 1, "replacement", 1);
                } else {
                    testing::assert_ok(values.clear());
                }
                release.send(());
                testing::assert_eq(
                    testing::expect_err(old.join(), "discarded"),
                    cache::Error::Invalidated,
                );
            },
        );
        testing::assert(
            get(values, 1)
                == if action == 0 {
                    Option::Some("replacement")
                } else {
                    Option::None
                },
        );
    }
}

#[test]
fn close_wakes_waiters_and_cooperative_loaders_without_waiting_for_user_code() -> () {
    let values = make(cache::Options::new(2));
    let started = Channel::new(1);
    task::scope(
        |scope| {
            let leader = scope.spawn(
                |_| values.get_or_try_insert_with(
                    context::Context::background(),
                    1,
                    |load| {
                        started.send(());
                        load.sleep(time::Duration::from_seconds(5))?;
                        Result::Ok(cache::Loaded::new("never", 1))
                    },
                ),
            );
            let _ = started.recv();
            let waiter = scope.spawn(
                |_| values.get_or_try_insert_with(
                    context::Context::background(),
                    1,
                    |_| Result::Err(cache::Error::Loader("unused")),
                ),
            );
            until(|| values.stats().waiters == 1);
            values.close();
            testing::assert_eq(testing::expect_err(waiter.join(), "waiter"), cache::Error::Closed);
            testing::assert_eq(testing::expect_err(leader.join(), "leader"), cache::Error::Closed);
        },
    );
    testing::assert_eq(values.stats().inflight, 0);
    testing::assert_eq(values.stats().entries, 0);
}

#[test]
fn admission_counts_invalidated_callbacks_and_bounds_waiters() -> () {
    let values = make(cache::Options { max_inflight: 1, max_waiters: 1, ..cache::Options::new(2) });
    let started = Channel::new(1);
    let release = Channel::new(1);
    let ctx = context::Context::background();
    task::scope(
        |scope| {
            let leader = scope.spawn(
                |_| values.get_or_try_insert_with(
                    ctx,
                    1,
                    |_| {
                        started.send(());
                        let _ = release.recv();
                        Result::Ok(cache::Loaded::new("old", 1))
                    },
                ),
            );
            let _ = started.recv();
            testing::assert_eq(
                testing::expect_err(
                    values.get_or_try_insert_with(
                        ctx,
                        2,
                        |_| Result::Ok(cache::Loaded::new("unused", 1)),
                    ),
                    "inflight bound",
                ),
                cache::Error::Busy,
            );
            let waiter = scope.spawn(
                |_| values.get_or_try_insert_with(
                    ctx,
                    1,
                    |_| Result::Err(cache::Error::Loader("unused")),
                ),
            );
            until(|| values.stats().waiters == 1);
            testing::assert_eq(
                testing::expect_err(
                    values.get_or_try_insert_with(
                        ctx,
                        1,
                        |_| Result::Ok(cache::Loaded::new("unused", 1)),
                    ),
                    "waiter bound",
                ),
                cache::Error::Busy,
            );
            testing::assert_ok(values.invalidate(1));
            testing::assert_eq(
                testing::expect_err(waiter.join(), "invalidated"),
                cache::Error::Invalidated,
            );
            testing::assert_eq(
                testing::expect_err(
                    values.get_or_try_insert_with(
                        ctx,
                        1,
                        |_| Result::Ok(cache::Loaded::new("unused", 1)),
                    ),
                    "invalidated inflight",
                ),
                cache::Error::Busy,
            );
            release.send(());
            testing::assert_eq(
                testing::expect_err(leader.join(), "leader"),
                cache::Error::Invalidated,
            );
        },
    );
    testing::assert_ok(
        values.get_or_try_insert_with(ctx, 1, |_| Result::Ok(cache::Loaded::new("after", 1))),
    );
    testing::assert_eq(values.stats().rejected, 3);
}

#[test]
fn deadlines_cancel_waiting_and_never_publish_cancelled_leader_results() -> () {
    let values = make(cache::Options::new(2));
    context::with_timeout(
        context::Context::background(),
        time::Duration::from_milliseconds(2),
        |ctx, _| {
            testing::assert_eq(
                testing::expect_err(
                    values.get_or_try_insert_with(
                        ctx,
                        1,
                        |_| {
                            time::sleep(time::Duration::from_milliseconds(5));
                            Result::Ok(cache::Loaded::new("late", 1))
                        },
                    ),
                    "deadline",
                ),
                cache::Error::DeadlineExceeded,
            );
        },
    );
    testing::assert(get(values, 1).is_none());
}

#[test]
fn concurrent_mutations_reads_expiry_and_statistics_stay_bounded() -> () {
    let clock = cache::ManualClock::new();
    let values = make(
        cache::Options {
            clock: clock.clock(),
            max_weight: 31,
            expiry: cache::Expiry::idle(5),
            ..cache::Options::new(12),
        },
    );
    task::scope(
        |scope| {
            let tasks = Vec::new();
            for worker in 0..12 {
                tasks.push(
                    scope.spawn(
                        |_| {
                            for step in 0..300 {
                                let key = (worker * 19 + step * 7) % 31;
                                match step % 7 {
                                    0 | 1 => put(
                                        values,
                                        key,
                                        worker.to_string(),
                                        (key % 5).to_i64(),
                                    ),
                                    2 => testing::assert_ok(values.get(key)),
                                    3 => testing::assert_ok(values.peek(key)),
                                    4 => testing::assert_ok(values.remove(key)),
                                    5 => testing::assert_ok(clock.advance(1)),
                                    _ => testing::assert_ok(values.prune()),
                                }
                                let stats = values.stats();
                                testing::assert(
                                    stats.entries >= 0 && stats.entries <= 12 && stats.weight >= 0
                                        && stats.weight <= 31,
                                );
                            }
                        },
                    ),
                );
            }
            for result in tasks {
                result.join();
            }
        },
    );
    let keys = testing::expect_ok(values.keys_lru(), "keys");
    testing::assert_eq(keys.len(), values.stats().entries);
    let unique: HashMap[isize, bool] = HashMap::new();
    for key in keys {
        unique.set(key, true);
    }
    testing::assert_eq(unique.len(), values.stats().entries);
}

#[test]
fn cancelled_during_publication_clock_read_never_enters_cache() -> () {
    context::with_cancel(
        context::Context::background(),
        |ctx, cancel| {
            let calls = Ref::new(0);
            let values = make(
                cache::Options {
                    clock: cache::Clock::new(
                        || {
                            let count = calls.get() + 1;
                            calls.set(count);
                            if count == 2 {
                                cancel.cancel();
                            }
                            0
                        },
                    ),
                    ..cache::Options::new(2),
                },
            );
            testing::assert_eq(
                testing::expect_err(
                    values.get_or_try_insert_with(
                        ctx,
                        1,
                        |_| Result::Ok(cache::Loaded::new("cancelled", 1)),
                    ),
                    "cancelled before commit",
                ),
                cache::Error::Cancelled,
            );
            testing::assert(get(values, 1).is_none());
        },
    );
}

#[test]
fn loader_failure_is_shared_with_all_waiters_and_retry_succeeds() -> () {
    let values = make(cache::Options::new(2));
    let started = Channel::new(1);
    let release = Channel::new(1);
    task::scope(
        |scope| {
            let leader = scope.spawn(
                |_| values.get_or_try_insert_with(
                    context::Context::background(),
                    1,
                    |_| {
                        started.send(());
                        let _ = release.recv();
                        Result::Err(cache::Error::Loader("shared failure"))
                    },
                ),
            );
            let _ = started.recv();
            let waiters = Vec::new();
            for _ in 0..4 {
                waiters.push(
                    scope.spawn(
                        |_| values.get_or_try_insert_with(
                            context::Context::background(),
                            1,
                            |_| Result::Ok(cache::Loaded::new("duplicate", 1)),
                        ),
                    ),
                );
            }
            until(|| values.stats().waiters == 4);
            release.send(());
            testing::assert_eq(
                testing::expect_err(leader.join(), "leader"),
                cache::Error::Loader("shared failure"),
            );
            for waiter in waiters {
                testing::assert_eq(
                    testing::expect_err(waiter.join(), "waiter"),
                    cache::Error::Loader("shared failure"),
                );
            }
        },
    );
    testing::assert_ok(
        values.get_or_try_insert_with(
            context::Context::background(),
            1,
            |_| Result::Ok(cache::Loaded::new("retry", 1)),
        ),
    );
    testing::assert_eq(values.stats().loads, 2);
}

#[test]
fn expiry_notifications_observe_completed_singleflight_before_reentry() -> () {
    let clock = cache::ManualClock::new();
    let saved: Ref[Option[cache::Cache[isize, string]]] = Ref::new(Option::None);
    let notified = Channel::new(1);
    let values = testing::expect_ok(
        cache::Cache::with_policy(
            cache::Options { clock: clock.clock(), ..cache::Options::new(2) },
            |value: string| value,
            |key: isize, _, cause| {
                if key == 1 && cause == cache::RemovalCause::Expired {
                    let current = testing::expect_some(saved.get(), "cache");
                    let value = testing::expect_ok(
                        current.get_or_try_insert_with(
                            context::Context::background(),
                            2,
                            |_| Result::Err(cache::Error::Loader("expected committed value")),
                        ),
                        "reentry",
                    );
                    notified.send(value);
                }
            },
        ),
        "cache",
    );
    saved.set(Option::Some(values));
    testing::assert_ok(values.insert_with_expiry(1, "expired", 1, cache::Expiry::ttl(1)));
    testing::assert_ok(clock.advance(1));
    testing::assert_eq(
        testing::expect_ok(
            values.get_or_try_insert_with(
                context::Context::background(),
                2,
                |_| Result::Ok(cache::Loaded::new("committed", 1)),
            ),
            "load",
        ),
        "committed",
    );
    testing::assert_eq(testing::expect_some(notified.recv(), "notification"), "committed");
}
