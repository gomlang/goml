package tests;

use ecosystem::cache;
use std::context;
use std::testing;

fn make(options: cache::Options) -> cache::Cache[isize, string] {
    testing::expect_ok(cache::Cache::new(options), "cache")
}

fn put(values: cache::Cache[isize, string], key: isize, value: string, weight: i64) -> () {
    testing::assert_ok(values.insert(key, value, weight));
}

fn get(values: cache::Cache[isize, string], key: isize) -> Option[string] {
    testing::expect_ok(values.get(key), "get")
}

#[test]
fn validates_options_and_weights_without_disturbing_values() -> () {
    let invalid: Result[cache::Cache[isize, string], cache::Error] = cache::Cache::new(
        cache::Options::new(0),
    );
    testing::assert_err(invalid);
    let options = cache::Options { max_weight: 10, ..cache::Options::new(3) };
    let values = make(options);
    put(values, 1, "old", 5);
    testing::assert_eq(
        testing::expect_err(values.insert(1, "new", -1), "negative"),
        cache::Error::InvalidWeight,
    );
    testing::assert_eq(
        testing::expect_err(values.insert(1, "new", 11), "heavy"),
        cache::Error::TooHeavy,
    );
    testing::assert_err(values.insert_with_expiry(1, "new", 1, cache::Expiry::ttl(-1)));
    testing::assert(get(values, 1) == Option::Some("old"));
    put(values, 2, "zero", 0);
    testing::assert_eq(values.stats().weight, 5);
    let huge = make(cache::Options::new(3));
    put(huge, 1, "maximum", 9223372036854775807);
    put(huge, 2, "one", 1);
    testing::assert(get(huge, 1).is_none());
    testing::assert_eq(huge.stats().weight, 1);
}

#[test]
fn lru_links_updates_peek_and_independent_key_snapshots() -> () {
    let values = make(cache::Options::new(3));
    put(values, 1, "one", 1);
    put(values, 2, "two", 1);
    put(values, 3, "three", 1);
    let keys = testing::expect_ok(values.keys_lru(), "keys");
    testing::assert(keys == Vec::from_array([1, 2, 3]));
    testing::assert_ok(values.peek(1));
    testing::assert_ok(values.get(2));
    put(values, 4, "four", 1);
    testing::assert(get(values, 1).is_none());
    testing::assert(testing::expect_ok(values.keys_lru(), "keys") == Vec::from_array([3, 2, 4]));
    testing::assert(keys == Vec::from_array([1, 2, 3]));
    testing::assert(
        testing::expect_ok(values.insert(2, "second", 1), "replace") == Option::Some("two"),
    );
    testing::assert(testing::expect_ok(values.remove(4), "remove") == Option::Some("four"));
    testing::assert(testing::expect_ok(values.keys_lru(), "keys") == Vec::from_array([3, 2]));
    testing::assert_eq(values.stats().evictions, 1);
}

#[test]
fn expiration_precedes_weighted_admission_and_checks_exact_boundary() -> () {
    let clock = cache::ManualClock::new();
    let values = make(
        cache::Options { max_weight: 10, clock: clock.clock(), ..cache::Options::new(3) },
    );
    put(values, 1, "live oldest", 4);
    testing::assert_ok(values.insert_with_expiry(2, "expires", 6, cache::Expiry::ttl(5)));
    testing::assert_ok(clock.advance(5));
    put(values, 3, "new", 6);
    testing::assert(get(values, 1).is_some());
    testing::assert(get(values, 2).is_none());
    testing::assert_eq(values.stats().weight, 10);
    testing::assert_eq(values.stats().expirations, 1);
    testing::assert_eq(values.stats().evictions, 0);
}

#[test]
fn ttl_and_idle_timers_have_independent_refresh_rules() -> () {
    let clock = cache::ManualClock::new();
    let values = make(
        cache::Options {
            clock: clock.clock(),
            expiry: cache::Expiry { ttl_ms: 10, tti_ms: 4, deadline_ms: Option::None },
            ..cache::Options::new(4),
        },
    );
    put(values, 1, "a", 1);
    put(values, 2, "b", 1);
    testing::assert_ok(clock.advance(3));
    testing::assert(get(values, 1).is_some());
    testing::assert_ok(values.peek(2));
    testing::assert_ok(clock.advance(1));
    testing::assert(testing::expect_ok(values.peek(2), "idle expired").is_none());
    testing::assert_ok(clock.advance(2));
    testing::assert(get(values, 1).is_some());
    testing::assert_ok(clock.advance(3));
    testing::assert(get(values, 1).is_some());
    testing::assert_ok(clock.advance(1));
    testing::assert(get(values, 1).is_none());
    put(values, 3, "original", 1);
    testing::assert_ok(clock.advance(3));
    put(values, 3, "replacement", 1);
    testing::assert_ok(clock.advance(3));
    testing::assert(get(values, 3) == Option::Some("replacement"));
}

#[test]
fn per_entry_expiry_deadlines_pruning_and_clock_bounds() -> () {
    let clock = cache::ManualClock::new();
    let values = make(cache::Options { clock: clock.clock(), ..cache::Options::new(4) });
    testing::assert_ok(values.insert_with_expiry(1, "absolute", 1, cache::Expiry::until(2)));
    testing::assert_ok(values.insert_with_expiry(2, "immediate", 1, cache::Expiry::until(0)));
    testing::assert(get(values, 2).is_none());
    testing::assert_ok(clock.advance(2));
    testing::assert_eq(testing::expect_ok(values.prune(), "prune"), 1);
    testing::assert_eq(values.stats().entries, 0);
    testing::assert_err(clock.advance(-1));
    testing::assert_ok(clock.advance(9223372036854775805));
    testing::assert_err(clock.advance(1));
    testing::assert_eq(clock.now(), 9223372036854775807);
    let observed = Ref::new(10);
    let backwards = make(
        cache::Options {
            clock: cache::Clock::new(|| observed.get()),
            expiry: cache::Expiry::ttl(5),
            ..cache::Options::new(2),
        },
    );
    put(backwards, 1, "value", 1);
    observed.set(-100);
    testing::assert(get(backwards, 1).is_some());
    observed.set(15);
    testing::assert(get(backwards, 1).is_none());
}

#[test]
fn copy_policy_detaches_inputs_outputs_and_removal_notifications() -> () {
    let values: cache::Cache[isize, Vec[isize]] = testing::expect_ok(
        cache::Cache::with_policy(
            cache::Options::new(3),
            |value: Vec[isize]| value.copy(),
            |_, value: Vec[isize], _| value.push(999),
        ),
        "policy",
    );
    let original = Vec::from_array([1, 2]);
    testing::assert_ok(values.insert(1, original, 1));
    original.push(3);
    let read = testing::expect_some(testing::expect_ok(values.get(1), "read"), "value");
    testing::assert(read == Vec::from_array([1, 2]));
    read.push(4);
    let removed = testing::expect_some(testing::expect_ok(values.remove(1), "remove"), "removed");
    testing::assert(removed == Vec::from_array([1, 2]));
    let loaded = testing::expect_ok(
        values.get_or_try_insert_with(
            context::Context::background(),
            2,
            |_| Result::Ok(cache::Loaded::new(original, 1)),
        ),
        "load",
    );
    loaded.push(5);
    testing::assert(
        testing::expect_some(testing::expect_ok(values.get(2), "read"), "value")
            == Vec::from_array([1, 2, 3]),
    );
}

#[test]
fn eviction_callbacks_run_after_mutation_and_can_reenter() -> () {
    let saved: Ref[Option[cache::Cache[isize, string]]] = Ref::new(Option::None);
    let events = Channel::new(20);
    let values = testing::expect_ok(
        cache::Cache::with_policy(
            cache::Options::new(2),
            |value: string| value,
            |key: isize, _: string, cause| {
                events.send((key, cause));
                if key == 1 {
                    let current = testing::expect_some(saved.get(), "cache");
                    testing::assert(testing::expect_ok(current.peek(1), "removed").is_none());
                    let _ = current.stats();
                    testing::assert_ok(current.insert(4, "callback", 1));
                }
            },
        ),
        "cache",
    );
    saved.set(Option::Some(values));
    put(values, 1, "one", 1);
    put(values, 2, "two", 1);
    put(values, 3, "three", 1);
    testing::assert(get(values, 4).is_some());
    testing::assert(
        testing::expect_some(events.recv(), "event") == (1, cache::RemovalCause::Capacity),
    );
    testing::assert(
        testing::expect_some(events.recv(), "event") == (2, cache::RemovalCause::Capacity),
    );
    testing::assert_ok(values.clear());
    testing::assert_eq(values.stats().entries, 0);
}

#[test]
fn close_is_shared_idempotent_and_rejects_operations() -> () {
    let values = make(cache::Options::new(2));
    let alias = values;
    put(values, 1, "value", 1);
    values.close();
    alias.close();
    testing::assert_eq(testing::expect_err(values.get(1), "get"), cache::Error::Closed);
    testing::assert_eq(testing::expect_err(values.insert(1, "new", 1), "put"), cache::Error::Closed);
    testing::assert_eq(testing::expect_err(values.clear(), "clear"), cache::Error::Closed);
    testing::assert_eq(testing::expect_err(values.keys_lru(), "keys"), cache::Error::Closed);
    testing::assert(values.closed().recv().is_none());
    testing::assert(values.stats().closed && values.stats().entries == 0);
}

#[test]
fn loader_errors_weight_limits_and_expiry_are_recoverable() -> () {
    let clock = cache::ManualClock::new();
    let values = make(
        cache::Options {
            max_weight: 5,
            clock: clock.clock(),
            expiry: cache::Expiry::ttl(5),
            ..cache::Options::new(2),
        },
    );
    let ctx = context::Context::background();
    testing::assert_eq(
        testing::expect_err(
            values.get_or_try_insert_with(ctx, 1, |_| Result::Err(cache::Error::Loader("failed"))),
            "loader",
        ),
        cache::Error::Loader("failed"),
    );
    testing::assert(get(values, 1).is_none());
    testing::assert_eq(
        testing::expect_err(
            values.get_or_try_insert_with(ctx, 1, |_| Result::Ok(cache::Loaded::new("heavy", 6))),
            "heavy",
        ),
        cache::Error::TooHeavy,
    );
    testing::assert_eq(
        testing::expect_ok(
            values.get_or_try_insert_with(
                ctx,
                1,
                |_| {
                    testing::assert_ok(clock.advance(100));
                    Result::Ok(cache::Loaded::new("ready", 1))
                },
            ),
            "ready",
        ),
        "ready",
    );
    testing::assert(get(values, 1).is_some());
    testing::assert_ok(clock.advance(5));
    testing::assert(get(values, 1).is_none());
    testing::assert_ok(
        values.get_or_try_insert_with(
            ctx,
            2,
            |_| Result::Ok(cache::Loaded::new("custom", 1).with_expiry(cache::Expiry::none())),
        ),
    );
    testing::assert_ok(clock.advance(50));
    testing::assert(get(values, 2).is_some());
    testing::assert_eq(values.stats().load_failures, 2);
    testing::assert_eq(values.stats().load_successes, 2);
}
