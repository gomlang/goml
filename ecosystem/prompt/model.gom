package prompt;

use ecosystem::ansi;
use ecosystem::terminal;
use ecosystem::tui;
use std::context;

#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    InvalidOptions(string),
    Cancelled,
    EndOfInput,
    DeadlineExceeded,
    Terminal(string),
    Cleanup(string),
    ActionAndCleanup(string, string),
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        match self {
            InvalidOptions(message) => "invalid prompt options: " + message,
            Cancelled => "prompt cancelled",
            EndOfInput => "end of input",
            DeadlineExceeded => "prompt deadline exceeded",
            Terminal(message) => "terminal: " + message,
            Cleanup(message) => "terminal cleanup: " + message,
            ActionAndCleanup(action, cleanup) => action + "; terminal cleanup: " + cleanup,
        }
    }
}

pub enum Outcome[T] {
    Pending,
    Submitted(T),
    Cancelled,
    EndOfInput,
}

pub trait Model {
    type Output;
    fn update(self: Self, event: terminal::Event) -> Result[Outcome[Self::Output], Error];
    fn render(self: Self, buffer: tui::Buffer) -> Result[(), tui::Error];
}

fn checked_context(value: context::Context) -> Result[(), Error] {
    value.check().map_err(
        |error| match error {
            context::Error::Cancelled => Error::Cancelled,
            context::Error::DeadlineExceeded => Error::DeadlineExceeded,
        },
    )
}

pub fn run[M: Model](screen: tui::Terminal, model: M, context: context::Context) -> Result[
    M::Output,
    Error,
] {
    loop {
        checked_context(context)?;
        screen.draw_with(context, |buffer| model.render(buffer)).map_err(
            |error| {
                match checked_context(context) {
                    Err(reason) => reason,
                    Ok(_) => Error::Terminal(error.to_string()),
                }
            },
        )?;
        let event = screen.next_event(context, -1).map_err(
            |error| {
                match checked_context(context) {
                    Err(reason) => reason,
                    Ok(_) => Error::Terminal(error.to_string()),
                }
            },
        )?;
        if let Some(event) = event {
            match model.update(event)? {
                Pending => (),
                Submitted(value) => return Result::Ok(value),
                Cancelled => return Result::Err(Error::Cancelled),
                EndOfInput => return Result::Err(Error::EndOfInput),
            }
        }
    }
}

pub fn interact[M: Model](model: M, context: context::Context) -> Result[M::Output, Error] {
    checked_context(context)?;
    let session = terminal::Session::open(terminal::Options::interactive()).map_err(
        |error| Error::Terminal(error.to_string()),
    )?;
    let result = match tui::Terminal::new(session) {
        Ok(screen) => run(screen, model, context),
        Err(error) => Result::Err(Error::Terminal(error.to_string())),
    };
    let cleanup = session.close();
    match (result, cleanup) {
        (Ok(value), Ok(_)) => Result::Ok(value),
        (Err(error), Ok(_)) => Result::Err(error),
        (Ok(_), Err(error)) => Result::Err(Error::Cleanup(error.to_string())),
        (Err(error), Err(cleanup)) => Result::Err(
            Error::ActionAndCleanup(error.to_string(), cleanup.to_string()),
        ),
    }
}

fn control(event: terminal::KeyEvent, character: char) -> bool {
    event.modifiers.control && event.code == terminal::KeyCode::Char(character)
}

fn cancelled_event(event: terminal::Event) -> bool {
    match event {
        Key(key) => key.code == terminal::KeyCode::Escape || control(key, 'c'),
        _ => false,
    }
}

fn invalid(message: string) -> Error {
    Error::InvalidOptions(message)
}

fn ui_error(error: tui::Error) -> Error {
    Error::Terminal(error.to_string())
}

fn label_text(value: string) -> string {
    ansi::safe_text(value).replace("\n", " ").replace("\t", " ")
}

fn label_valid(value: string) -> bool {
    value.byte_len() <= 4096
}

fn draw_line(buffer: tui::Buffer, row: isize, value: string, style: ansi::Style) -> Result[
    (),
    tui::Error,
] {
    let area = buffer.area();
    if row < 0 || row >= area.height {
        return Result::Ok(())
    }
    buffer.draw_text(
        tui::Rect { x: 0, y: row, width: area.width, height: 1 },
        ansi::StyledText::from_spans(Vec::from_array([ansi::Span::new(label_text(value), style)])),
    )
}

#[derive(Debug, PartialEq, Eq)]
pub struct Theme {
    pub question: ansi::Style,
    pub input: ansi::Style,
    pub selected: ansi::Style,
    pub muted: ansi::Style,
    pub error: ansi::Style,
}

impl Theme {
    pub fn defaults() -> Theme {
        Theme {
            question: ansi::Style::new().with_attribute(ansi::BOLD, true),
            input: ansi::Style::new(),
            selected: ansi::Style::new().with_attribute(ansi::REVERSE, true),
            muted: ansi::Style::new().with_attribute(ansi::DIM, true),
            error: ansi::Style::new().foreground(ansi::Color::Indexed(1)),
        }
    }
}
