package tests;

use ecosystem::prompt;
use prompt::Model;
use ecosystem::terminal;
use ecosystem::tui;
use std::testing;

#[test]
fn selection_skips_disabled_choices_and_preserves_typed_values() -> () {
    let choices = Vec::from_array(
        [
            prompt::Choice::new("First", 10),
            prompt::Choice { disabled: true, ..prompt::Choice::new("Unavailable", 20) },
            prompt::Choice::new("Last", 30),
        ],
    );
    let selection = testing::expect_ok(prompt::Select::new("Choose", choices), "single select");
    choices.clear();
    testing::expect_ok(selection.update(key(terminal::KeyCode::Down)), "skip disabled");
    testing::assert(selection.selection().highlighted() == Option::Some(2));
    testing::assert_eq(
        submitted(
            testing::expect_ok(selection.update(key(terminal::KeyCode::Enter)), "choose last"),
        ),
        30,
    );
    testing::assert(selection.update(key(terminal::KeyCode::Enter)).is_err());
}

#[test]
fn search_uses_unicode_casefold_and_can_recover_from_no_matches() -> () {
    let selection = testing::expect_ok(
        prompt::Select::new(
            "City",
            Vec::from_array(
                [
                    prompt::Choice::new("Straße", 1),
                    prompt::Choice::new("北京", 2),
                    prompt::Choice::new("Paris", 3),
                ],
            ),
        ),
        "searchable choice",
    );
    testing::expect_ok(selection.update(terminal::Event::Paste("STRASSE")), "casefold search");
    testing::assert_eq(selection.selection().visible_indices().len(), 1);
    testing::assert(selection.selection().highlighted() == Option::Some(0));
    testing::expect_ok(selection.update(terminal::Event::Paste("x")), "no match");
    testing::assert(selection.selection().visible_indices().is_empty());
    testing::assert(
        pending(
            testing::expect_ok(
                selection.update(key(terminal::KeyCode::Enter)),
                "empty result submit",
            ),
        ),
    );
    testing::expect_ok(selection.update(key(terminal::KeyCode::Backspace)), "restore match");
    testing::assert_eq(
        submitted(
            testing::expect_ok(selection.update(key(terminal::KeyCode::Enter)), "select recovered"),
        ),
        1,
    );
}

#[test]
fn multi_selection_retains_hidden_items_and_enforces_cardinality() -> () {
    let selection = testing::expect_ok(
        prompt::Selection::new(
            prompt::SelectOptions {
                multiple: true,
                min_selected: 2,
                max_selected: 2,
                ..prompt::SelectOptions::new("Pick two"),
            },
            Vec::from_array(
                [
                    prompt::Choice::new("Alpha", 10),
                    prompt::Choice::new("Beta", 20),
                    prompt::Choice::new("Gamma", 30),
                ],
            ),
        ),
        "multiple select",
    );
    testing::assert(pending(testing::expect_ok(selection.submit(), "minimum selection")));
    testing::expect_ok(selection.update(key(terminal::KeyCode::Char(' '))), "select Alpha");
    testing::expect_ok(selection.update(terminal::Event::Paste("Beta")), "filter Beta");
    testing::expect_ok(selection.update(key(terminal::KeyCode::Char(' '))), "select Beta");
    testing::assert_eq(selection.selected_indices().len(), 2);
    for _ in 0..4 {
        testing::expect_ok(selection.update(key(terminal::KeyCode::Backspace)), "clear query");
    }
    testing::expect_ok(selection.update(key(terminal::KeyCode::End)), "jump last");
    testing::expect_ok(selection.update(key(terminal::KeyCode::Char(' '))), "maximum selection");
    testing::assert(selection.validation_message().contains("at most"));
    let values = submitted(testing::expect_ok(selection.submit(), "submit two"));
    testing::assert_eq(values.len(), 2);
    testing::assert_eq(values[0], 10);
    testing::assert_eq(values[1], 20);
}

#[test]
fn pagination_navigation_and_tiny_rendering_remain_in_bounds() -> () {
    let choices = Vec::new();
    for index in 0..100 {
        choices.push(prompt::Choice::new(f"Choice {index}", index));
    }
    let selection = testing::expect_ok(
        prompt::Selection::new(
            prompt::SelectOptions { page_size: 5, ..prompt::SelectOptions::new("Paged") },
            choices,
        ),
        "paged selection",
    );
    testing::expect_ok(selection.update(key(terminal::KeyCode::PageDown)), "page down");
    testing::assert(selection.highlighted() == Option::Some(5));
    testing::expect_ok(selection.update(key(terminal::KeyCode::End)), "last item");
    testing::assert(selection.highlighted() == Option::Some(99));
    for width in 0..5 {
        for height in 0..7 {
            testing::expect_ok(
                selection.render(
                    testing::expect_ok(tui::Buffer::new(width, height), "tiny selection buffer"),
                ),
                "tiny selection render",
            );
        }
    }
    testing::expect_ok(selection.update(key(terminal::KeyCode::Home)), "first item");
    testing::assert(selection.highlighted() == Option::Some(0));
}

#[test]
fn confirm_requires_an_answer_when_no_default_is_available() -> () {
    let confirm = testing::expect_ok(prompt::Confirm::new("Continue?", Option::None), "confirm");
    testing::assert(
        pending(testing::expect_ok(confirm.update(key(terminal::KeyCode::Enter)), "no default")),
    );
    testing::assert(
        submitted(testing::expect_ok(confirm.update(key(terminal::KeyCode::Char('Y'))), "yes")),
    );
    let default_no = testing::expect_ok(
        prompt::Confirm::new("Continue?", Option::Some(false)),
        "default no",
    );
    testing::assert(
        !submitted(testing::expect_ok(default_no.update(key(terminal::KeyCode::Enter)), "default")),
    );
}

#[test]
fn invalid_choices_and_selection_options_fail_before_interaction() -> () {
    let empty: Vec[prompt::Choice[isize]] = Vec::new();
    testing::assert(prompt::Select::new("Empty", empty).is_err());
    testing::assert(
        prompt::Select::new(
            "Disabled",
            Vec::from_array(
                [prompt::Choice { disabled: true, ..prompt::Choice::new("Disabled", 1) }],
            ),
        ).is_err(),
    );
    testing::assert(
        prompt::Selection::new(
            prompt::SelectOptions { page_size: 0, ..prompt::SelectOptions::new("Invalid") },
            Vec::from_array([prompt::Choice::new("one", 1)]),
        ).is_err(),
    );
}

#[test]
fn disabled_search_results_cannot_be_highlighted_or_submitted() -> () {
    let selection = testing::expect_ok(
        prompt::Select::new(
            "Choice",
            Vec::from_array(
                [
                    prompt::Choice::new("Available", 1),
                    prompt::Choice { disabled: true, ..prompt::Choice::new("Hidden", 2) },
                ],
            ),
        ),
        "select",
    );
    testing::expect_ok(selection.update(terminal::Event::Paste("Hidden")), "search disabled");
    testing::assert(selection.selection().highlighted().is_none());
    testing::assert(
        pending(
            testing::expect_ok(selection.update(key(terminal::KeyCode::Enter)), "disabled submit"),
        ),
    );
    let buffer = testing::expect_ok(tui::Buffer::new(20, 1), "one-row buffer");
    testing::expect_ok(selection.render(buffer), "one-row render");
    testing::assert(buffer.lines()[0].starts_with("? Choice"));
}
