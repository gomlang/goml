package tests;

use ecosystem::prompt;
use prompt::Model;
use ecosystem::terminal;
use ecosystem::tui;
use std::testing;

fn key(code: terminal::KeyCode) -> terminal::Event {
    terminal::Event::Key(terminal::KeyEvent { code, modifiers: terminal::Modifiers::none() })
}

fn control(code: terminal::KeyCode) -> terminal::Event {
    terminal::Event::Key(
        terminal::KeyEvent {
            code,
            modifiers: terminal::Modifiers { control: true, ..terminal::Modifiers::none() },
        },
    )
}

fn submitted[T](outcome: prompt::Outcome[T]) -> T {
    match outcome {
        Submitted(value) => value,
        _ => testing::expect_some(Option::None, "expected submitted result"),
    }
}

fn pending[T](outcome: prompt::Outcome[T]) -> bool {
    match outcome {
        Pending => true,
        _ => false,
    }
}

#[test]
fn typed_validation_can_retry_without_losing_input() -> () {
    let input = testing::expect_ok(prompt::integer("Port", 1, 65535), "integer prompt");
    testing::expect_ok(input.update(terminal::Event::Paste("70000")), "paste number");
    testing::assert(
        pending(testing::expect_ok(input.update(key(terminal::KeyCode::Enter)), "invalid submit")),
    );
    testing::assert(input.validation_message().contains("between"));
    testing::assert_eq(input.value(), "70000");
    for _ in 0..5 {
        testing::expect_ok(input.update(key(terminal::KeyCode::Backspace)), "erase digit");
    }
    testing::expect_ok(input.update(terminal::Event::Paste("8080")), "correct number");
    testing::assert_eq(input.validation_message(), "");
    testing::assert_eq(submitted(testing::expect_ok(input.submit(), "submit")), 8080);
    testing::assert(input.update(key(terminal::KeyCode::Enter)).is_err());
}

#[test]
fn grapheme_editing_and_single_line_paste_follow_input_policy() -> () {
    let input = testing::expect_ok(prompt::text("Name"), "text prompt");
    testing::expect_ok(input.update(terminal::Event::Paste("中é👩‍💻")), "Unicode paste");
    testing::expect_ok(input.update(key(terminal::KeyCode::Backspace)), "remove emoji grapheme");
    testing::assert_eq(input.value(), "中é");
    testing::expect_ok(input.update(key(terminal::KeyCode::Backspace)), "remove combining grapheme");
    testing::assert_eq(input.value(), "中");
    testing::expect_ok(input.update(terminal::Event::Paste("a\r\nb\rc\nd")), "normalize paste");
    testing::assert_eq(submitted(testing::expect_ok(input.submit(), "submit Unicode")), "中a b c d");
}

#[test]
fn completion_cycles_and_history_restores_the_current_draft() -> () {
    let history = Vec::from_array(["old", "recent"]);
    let input = testing::expect_ok(
        prompt::TextInput::new(
            prompt::InputOptions {
                initial: "draft",
                history,
                ..prompt::InputOptions::new("Command"),
            },
            |value| Result::[string, string]::Ok(value),
        ),
        "history prompt",
    ).with_completion(|_| Vec::from_array(["first", "second"]));
    history.push("external");
    testing::expect_ok(input.update(key(terminal::KeyCode::Up)), "history recent");
    testing::assert_eq(input.value(), "recent");
    testing::expect_ok(input.update(key(terminal::KeyCode::Up)), "history old");
    testing::assert_eq(input.value(), "old");
    testing::expect_ok(input.update(key(terminal::KeyCode::Down)), "history forward");
    testing::expect_ok(input.update(key(terminal::KeyCode::Down)), "restore draft");
    testing::assert_eq(input.value(), "draft");
    testing::expect_ok(input.update(key(terminal::KeyCode::Tab)), "first completion");
    testing::assert_eq(input.value(), "first");
    testing::expect_ok(input.update(key(terminal::KeyCode::Tab)), "next completion");
    testing::assert_eq(input.value(), "second");
    testing::expect_ok(input.update(key(terminal::KeyCode::Tab)), "cycle completion");
    testing::assert_eq(input.value(), "first");
}

#[test]
fn password_rendering_masks_all_text_and_disables_completion_history_undo() -> () {
    let called = Ref::new(false);
    let input = testing::expect_ok(prompt::password("Secret"), "password").with_completion(
        |_| {
            called.set(true);
            Vec::from_array(["leak"])
        },
    );
    testing::expect_ok(input.update(terminal::Event::Paste("SENSITIVE中")), "secret paste");
    testing::expect_ok(input.update(key(terminal::KeyCode::Tab)), "completion disabled");
    testing::expect_ok(input.update(control(terminal::KeyCode::Char('z'))), "undo disabled");
    testing::assert(!called.get());
    let buffer = testing::expect_ok(tui::Buffer::new(40, 5), "password buffer");
    testing::expect_ok(input.render(buffer), "password render");
    let screen = buffer.lines().join("\n");
    testing::assert(!screen.contains("SENSITIVE"));
    testing::assert(!screen.contains("中"));
    testing::assert_eq(submitted(testing::expect_ok(input.submit(), "submit secret")), "SENSITIVE中");
}

#[test]
fn multiline_input_requires_explicit_modified_enter_to_submit() -> () {
    let input = testing::expect_ok(
        prompt::TextInput::new(
            prompt::InputOptions { multiline: true, ..prompt::InputOptions::new("Message") },
            |value| Result::[string, string]::Ok(value),
        ),
        "multiline",
    );
    testing::expect_ok(input.update(terminal::Event::Paste("one")), "first line");
    testing::assert(
        pending(testing::expect_ok(input.update(key(terminal::KeyCode::Enter)), "newline")),
    );
    testing::expect_ok(input.update(terminal::Event::Paste("two")), "second line");
    testing::assert_eq(
        submitted(
            testing::expect_ok(input.update(control(terminal::KeyCode::Enter)), "submit multiline"),
        ),
        "one\ntwo",
    );
}

#[test]
fn cancellation_eof_and_invalid_options_are_explicit() -> () {
    let input = testing::expect_ok(prompt::text("Input"), "input");
    testing::assert(
        match testing::expect_ok(input.update(key(terminal::KeyCode::Escape)), "escape") {
            prompt::Outcome::Cancelled => true,
            _ => false,
        },
    );
    testing::assert(input.submit().is_err());
    let eof = testing::expect_ok(prompt::text("Input"), "input");
    testing::assert(
        match testing::expect_ok(eof.update(control(terminal::KeyCode::Char('d'))), "EOF") {
            prompt::Outcome::EndOfInput => true,
            _ => false,
        },
    );
    testing::assert(prompt::integer("bad range", 5, 2).is_err());
    testing::assert(
        prompt::TextInput::new(
            prompt::InputOptions { max_bytes: 0, ..prompt::InputOptions::new("Invalid") },
            |value| Result::[string, string]::Ok(value),
        ).is_err(),
    );
    testing::assert(
        prompt::TextInput::new(
            prompt::InputOptions { initial: "a\nb", ..prompt::InputOptions::new("Invalid") },
            |value| Result::[string, string]::Ok(value),
        ).is_err(),
    );
}

#[test]
fn tiny_viewports_and_input_limits_are_recoverable() -> () {
    let input = testing::expect_ok(
        prompt::TextInput::new(
            prompt::InputOptions { max_bytes: 3, ..prompt::InputOptions::new("Bounded") },
            |value| Result::[string, string]::Ok(value),
        ),
        "bounded input",
    );
    testing::expect_ok(input.update(terminal::Event::Paste("abc")), "fill input");
    testing::assert(
        pending(testing::expect_ok(input.update(terminal::Event::Paste("d")), "over-limit input")),
    );
    testing::assert_eq(input.value(), "abc");
    testing::assert(input.validation_message() != "");
    for width in 0..4 {
        for height in 0..4 {
            testing::expect_ok(
                input.render(testing::expect_ok(tui::Buffer::new(width, height), "tiny buffer")),
                "tiny render",
            );
        }
    }
}

#[test]
fn invalid_completion_and_validation_results_preserve_input() -> () {
    let input = testing::expect_ok(prompt::text("Value"), "text").with_completion(
        |_| Vec::from_array(["invalid\ncompletion"]),
    );
    testing::expect_ok(input.update(terminal::Event::Paste("draft")), "draft");
    testing::assert(input.update(key(terminal::KeyCode::Tab)).is_err());
    testing::assert_eq(input.value(), "draft");
    testing::assert_eq(submitted(testing::expect_ok(input.submit(), "submit after error")), "draft");
    let validation: prompt::TextInput[string] = testing::expect_ok(
        prompt::TextInput::new(
            prompt::InputOptions::new("Validated"),
            |_| Result::[string, string]::Err("\u001b[31munsafe\nmessage"),
        ),
        "validation prompt",
    );
    testing::assert(pending(testing::expect_ok(validation.submit(), "invalid value")));
    testing::assert(!validation.validation_message().contains("\u001b"));
    testing::assert(!validation.validation_message().contains("\n"));
}
