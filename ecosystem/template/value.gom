package template;

use std::json;
use std::num;
use std::math;
use std::serde::{Serialize};

impl Value {
    pub fn get(self: Value, name: string) -> Value {
        match self {
            Value::Object(fields) => {
                for (key, value) in fields {
                    if key == name {
                        return value
                    }
                }
                Value::Undefined(name)
            },
            Value::Undefined(path) => Value::Undefined(path + "." + name),
            _ => Value::Undefined(name),
        }
    }

    pub fn as_text(self: Value) -> Option[string] {
        match self {
            Value::Text(value) | Value::Safe(value) => Option::Some(value),
            _ => Option::None,
        }
    }

    pub fn as_int(self: Value) -> Option[i64] {
        match self {
            Value::Int(value) => Option::Some(value),
            _ => Option::None,
        }
    }

    pub fn from_json(value: json::Value) -> Result[Value, Error] {
        convert_json(value, 0, Ref::new(0))
    }
}

fn convert_json(value: json::Value, depth: isize, count: Ref[isize]) -> Result[Value, Error] {
    count.set(count.get() + 1);
    if depth > 128 || count.get() > 1000000 {
        return Result::Err(
            api_error(ErrorKind::Limit, "JSON context nesting or value count limit exceeded"),
        )
    }
    match value {
        json::Value::Null => Result::Ok(Value::Null),
        json::Value::Bool(value) => Result::Ok(Value::Bool(value)),
        json::Value::String(value) => Result::Ok(Value::Text(value)),
        json::Value::Number(value) => {
            if value.contains(".") || value.contains("e") || value.contains("E") {
                let parsed = num::parse_float64_structured(value).map_err(
                    |error| api_error(ErrorKind::Type, error.to_string()),
                )?;
                if !math::is_finite(parsed) {
                    return Result::Err(
                        api_error(ErrorKind::Type, "context contains nonfinite number"),
                    )
                }
                Result::Ok(Value::Float(parsed))
            } else {
                Result::Ok(
                    Value::Int(
                        num::parse_int_structured(value).map_err(
                            |error| api_error(ErrorKind::Type, error.to_string()),
                        )?.to_i64(),
                    ),
                )
            }
        },
        json::Value::Array(items) => {
            if items.len() > 100000 {
                return Result::Err(api_error(ErrorKind::Limit, "context collection limit exceeded"))
            }
            let result = Vec::new();
            for item in items {
                result.push(convert_json(item, depth + 1, count)?);
            }
            Result::Ok(Value::List(result))
        },
        json::Value::Object(fields) => {
            if fields.len() > 100000 {
                return Result::Err(api_error(ErrorKind::Limit, "context collection limit exceeded"))
            }
            let result = Vec::new();
            let seen = HashMap::new();
            for (key, value) in fields {
                if seen.contains(key) {
                    return Result::Err(api_error(ErrorKind::Type, f"duplicate context key {key}"))
                }
                seen.set(key, true);
                result.push((key, convert_json(value, depth + 1, count)?));
            }
            Result::Ok(Value::Object(result))
        },
    }
}

pub fn from_serializable[T: Serialize](value: T) -> Result[Value, Error] {
    Value::from_json(json::to_value(value).map_err(|message| api_error(ErrorKind::Type, message))?)
}

struct Output {
    bytes: Vec[u8],
    limit: isize,
}

impl Output {
    fn new(limit: isize) -> Output {
        Output { bytes: Vec::new(), limit }
    }

    fn append(self: Output, value: string, source: Source, offset: isize) -> Result[(), Error] {
        if value.byte_len() > self.limit - self.bytes.len() {
            return Result::Err(
                problem(
                    source,
                    offset,
                    ErrorKind::Limit,
                    "output or intermediate string exceeds byte limit",
                ),
            )
        }
        for byte in value.to_bytes() {
            self.bytes.push(byte);
        }
        Result::Ok(())
    }

    fn finish(self: Output) -> string {
        string_from_utf8(self.bytes).1
    }
}

fn escaped(value: string, limit: isize, source: Source, offset: isize) -> Result[string, Error] {
    let output = Output::new(limit);
    let mut start = 0;
    for (index, scalar) in value.char_indices() {
        let replacement = match scalar {
            '&' => "&amp;",
            '<' => "&lt;",
            '>' => "&gt;",
            '"' => "&#34;",
            '\'' => "&#39;",
            _ => "",
        };
        if replacement.byte_len() != 0 {
            output.append(value.byte_slice(start, index), source, offset)?;
            output.append(replacement, source, offset)?;
            start = index + 1;
        }
    }
    output.append(value.byte_slice(start, value.byte_len()), source, offset)?;
    Result::Ok(output.finish())
}

pub fn escape_html(value: string) -> Result[string, Error] {
    escaped(value, Limits::standard().max_output_bytes, Source { name: "<escape>", text: "" }, 0)
}

fn is_safe(value: Value) -> bool {
    match value {
        Value::Safe(_) => true,
        _ => false,
    }
}

fn is_missing(value: Value) -> bool {
    match value {
        Value::Undefined(_) => true,
        _ => false,
    }
}

fn numeric(value: Value) -> bool {
    match value {
        Value::Int(_) | Value::Float(_) => true,
        _ => false,
    }
}

fn to_float(value: Value) -> Option[f64] {
    match value {
        Value::Int(value) => match num::parse_float64_structured(value.to_string()) {
            Ok(value) => Option::Some(value),
            Err(_) => Option::None,
        },
        Value::Float(value) => Option::Some(value),
        _ => Option::None,
    }
}

fn write_json(
    value: Value,
    output: Output,
    runtime: Runtime,
    source: Source,
    offset: isize,
    depth: isize,
) -> Result[(), Error] {
    runtime.tick(source, offset, depth)?;
    match value {
        Value::Undefined(name) => return Result::Err(
            problem(source, offset, ErrorKind::Undefined, f"undefined value {name}"),
        ),
        Value::Null => output.append("null", source, offset)?,
        Value::Bool(value) => output.append(value.to_string(), source, offset)?,
        Value::Int(value) => output.append(value.to_string(), source, offset)?,
        Value::Float(value) => output.append(value.to_string(), source, offset)?,
        Value::Text(value) | Value::Safe(value) => output.append(
            json::encode(json::Value::String(value)),
            source,
            offset,
        )?,
        Value::List(items) => {
            output.append("[", source, offset)?;
            for index in 0..items.len() {
                if index > 0 {
                    output.append(",", source, offset)?;
                }
                write_json(items[index], output, runtime, source, offset, depth + 1)?;
            }
            output.append("]", source, offset)?;
        },
        Value::Object(fields) => {
            output.append("{", source, offset)?;
            for index in 0..fields.len() {
                if index > 0 {
                    output.append(",", source, offset)?;
                }
                output.append(json::encode(json::Value::String(fields[index].0)), source, offset)?;
                output.append(":", source, offset)?;
                write_json(fields[index].1, output, runtime, source, offset, depth + 1)?;
            }
            output.append("}", source, offset)?;
        },
    }
    Result::Ok(())
}

fn json_text(value: Value, runtime: Runtime, source: Source, offset: isize) -> Result[string, Error] {
    let output = Output::new(runtime.engine.options.limits.max_output_bytes);
    write_json(value, output, runtime, source, offset, 0)?;
    Result::Ok(output.finish())
}

impl Runtime {
    fn truth(self: Runtime, value: Value, source: Source, offset: isize) -> Result[bool, Error] {
        match value {
            Value::Undefined(name) => if self.engine.options.strict_undefined {
                Result::Err(
                    problem(source, offset, ErrorKind::Undefined, f"undefined value {name}"),
                )
            } else {
                Result::Ok(false)
            },
            Value::Null => Result::Ok(false),
            Value::Bool(value) => Result::Ok(value),
            Value::Int(value) => Result::Ok(value != 0),
            Value::Float(value) => Result::Ok(value != 0.0),
            Value::Text(value) | Value::Safe(value) => Result::Ok(value.byte_len() != 0),
            Value::List(items) => Result::Ok(!items.is_empty()),
            Value::Object(fields) => Result::Ok(!fields.is_empty()),
        }
    }

    fn display(self: Runtime, value: Value, source: Source, offset: isize) -> Result[string, Error] {
        match value {
            Value::Undefined(name) => if self.engine.options.strict_undefined {
                Result::Err(
                    problem(source, offset, ErrorKind::Undefined, f"undefined value {name}"),
                )
            } else {
                Result::Ok("")
            },
            Value::Null => Result::Ok(""),
            Value::Bool(value) => Result::Ok(value.to_string()),
            Value::Int(value) => Result::Ok(value.to_string()),
            Value::Float(value) => Result::Ok(value.to_string()),
            Value::Text(value) | Value::Safe(value) => Result::Ok(value),
            _ => json_text(value, self, source, offset),
        }
    }

    fn sequence(self: Runtime, value: Value, source: Source, offset: isize) -> Result[
        Vec[Value],
        Error,
    ] {
        let items = match value {
            Value::List(items) => items,
            Value::Object(fields) => {
                let items = Vec::new();
                for (key, _) in fields {
                    items.push(Value::Text(key));
                }
                items
            },
            Value::Text(value) | Value::Safe(value) => {
                if value.char_count() > self.engine.options.limits.max_collection {
                    return Result::Err(
                        problem(
                            source,
                            offset,
                            ErrorKind::Limit,
                            "string sequence exceeds collection limit",
                        ),
                    )
                }
                let items = Vec::new();
                for scalar in value.chars() {
                    items.push(Value::Text(scalar.to_string()));
                }
                items
            },
            Value::Undefined(name) => if self.engine.options.strict_undefined {
                return Result::Err(
                    problem(source, offset, ErrorKind::Undefined, f"undefined value {name}"),
                )
            } else {
                Vec::new()
            },
            _ => return Result::Err(
                problem(source, offset, ErrorKind::Type, "expected iterable collection or string"),
            ),
        };
        if items.len() > self.engine.options.limits.max_collection {
            return Result::Err(
                problem(source, offset, ErrorKind::Limit, "collection limit exceeded"),
            )
        }
        Result::Ok(items)
    }

    fn snapshot(self: Runtime, value: Value, source: Source, offset: isize, depth: isize) -> Result[
        Value,
        Error,
    ] {
        self.tick(source, offset, depth)?;
        match value {
            Value::List(items) => {
                if items.len() > self.engine.options.limits.max_collection {
                    return Result::Err(
                        problem(
                            source,
                            offset,
                            ErrorKind::Limit,
                            "context collection limit exceeded",
                        ),
                    )
                }
                let result = Vec::new();
                for item in items {
                    result.push(self.snapshot(item, source, offset, depth + 1)?);
                }
                Result::Ok(Value::List(result))
            },
            Value::Object(fields) => {
                if fields.len() > self.engine.options.limits.max_collection {
                    return Result::Err(
                        problem(
                            source,
                            offset,
                            ErrorKind::Limit,
                            "context collection limit exceeded",
                        ),
                    )
                }
                let result = Vec::new();
                let seen = HashMap::new();
                for (key, value) in fields {
                    if seen.contains(key) {
                        return Result::Err(
                            problem(source, offset, ErrorKind::Type, f"duplicate object key {key}"),
                        )
                    }
                    seen.set(key, true);
                    result.push((key, self.snapshot(value, source, offset, depth + 1)?));
                }
                Result::Ok(Value::Object(result))
            },
            Value::Float(value) => if math::is_finite(value) {
                Result::Ok(Value::Float(value))
            } else {
                Result::Err(problem(source, offset, ErrorKind::Type, "nonfinite context number"))
            },
            Value::Text(text) | Value::Safe(text) => if text.byte_len()
                > self.engine.options.limits.max_output_bytes {
                Result::Err(
                    problem(source, offset, ErrorKind::Limit, "context string exceeds byte limit"),
                )
            } else {
                Result::Ok(value)
            },
            _ => Result::Ok(value),
        }
    }

    fn equal(self: Runtime, left: Value, right: Value, source: Source, offset: isize, depth: isize) -> Result[
        bool,
        Error,
    ] {
        self.tick(source, offset, depth)?;
        if is_missing(left) || is_missing(right) {
            if self.engine.options.strict_undefined {
                return Result::Err(
                    problem(source, offset, ErrorKind::Undefined, "cannot compare undefined values"),
                )
            }
            return Result::Ok(is_missing(left) && is_missing(right))
        }
        if numeric(left) && numeric(right) {
            if let Value::Int(a) = left {
                if let Value::Int(b) = right {
                    return Result::Ok(a == b)
                }
            }
            return Result::Ok(number_order(left, right) == 0)
        }
        match (left, right) {
            (Value::Null, Value::Null) => Result::Ok(true),
            (Value::Bool(a), Value::Bool(b)) => Result::Ok(a == b),
            (Value::Text(a), Value::Text(b)) | (Value::Text(a), Value::Safe(b)) | (
                Value::Safe(a),
                Value::Text(b),
            ) | (Value::Safe(a), Value::Safe(b)) => Result::Ok(a == b),
            (Value::List(a), Value::List(b)) => {
                if a.len() != b.len() {
                    return Result::Ok(false)
                }
                for index in 0..a.len() {
                    if !self.equal(a[index], b[index], source, offset, depth + 1)? {
                        return Result::Ok(false)
                    }
                }
                Result::Ok(true)
            },
            (Value::Object(a), Value::Object(b)) => {
                if a.len() != b.len() {
                    return Result::Ok(false)
                }
                for (key, value) in a {
                    let other = Value::Object(b).get(key);
                    if is_missing(other) {
                        return Result::Ok(false)
                    }
                    if !self.equal(value, other, source, offset, depth + 1)? {
                        return Result::Ok(false)
                    }
                }
                Result::Ok(true)
            },
            _ => Result::Ok(false),
        }
    }

    fn order(self: Runtime, left: Value, right: Value, source: Source, offset: isize) -> Result[
        isize,
        Error,
    ] {
        self.tick(source, offset, 0)?;
        if let Value::Int(a) = left {
            if let Value::Int(b) = right {
                return Result::Ok(
                    if a < b {
                        -1
                    } else if a > b {
                        1
                    } else {
                        0
                    },
                )
            }
        }
        if numeric(left) && numeric(right) {
            return Result::Ok(number_order(left, right))
        }
        if let Some(a) = left.as_text() {
            if let Some(b) = right.as_text() {
                return Result::Ok(
                    if a < b {
                        -1
                    } else if a > b {
                        1
                    } else {
                        0
                    },
                )
            }
        }
        Result::Err(
            problem(source, offset, ErrorKind::Type, "ordering requires numbers or strings"),
        )
    }
}

fn power_two(exponent: isize) -> u64 {
    let mut value: u64 = 1;
    for _ in 0..exponent {
        value *= 2;
    }
    value
}

fn integer_float_order(integer: i64, number: f64) -> isize {
    if number == 0.0 {
        return if integer < 0 {
            -1
        } else if integer > 0 {
            1
        } else {
            0
        }
    }
    if integer < 0 && number > 0.0 {
        return -1
    }
    if integer >= 0 && number < 0.0 {
        return 1
    }
    let negative = integer < 0;
    let magnitude = if negative {
        (-(integer + 1)).to_u64() + 1
    } else {
        integer.to_u64()
    };
    let bits = number.to_bits();
    let exponent = ((bits / 4503599627370496) % 2048).to_isize() - 1023;
    let mantissa = bits % 4503599627370496 + 4503599627370496;
    let order = if exponent < 0 {
        if magnitude == 0 {
            -1
        } else {
            1
        }
    } else if exponent > 63 {
        -1
    } else {
        let whole = if exponent >= 52 {
            mantissa * power_two(exponent - 52)
        } else {
            mantissa / power_two(52 - exponent)
        };
        let fractional = exponent < 52 && mantissa % power_two(52 - exponent) != 0;
        if magnitude < whole {
            -1
        } else if magnitude > whole {
            1
        } else if fractional {
            -1
        } else {
            0
        }
    };
    if negative {
        -order
    } else {
        order
    }
}

fn number_order(left: Value, right: Value) -> isize {
    match (left, right) {
        (Value::Int(a), Value::Int(b)) => if a < b {
            -1
        } else if a > b {
            1
        } else {
            0
        },
        (Value::Int(a), Value::Float(b)) => integer_float_order(a, b),
        (Value::Float(a), Value::Int(b)) => -integer_float_order(b, a),
        (Value::Float(a), Value::Float(b)) => if a < b {
            -1
        } else if a > b {
            1
        } else {
            0
        },
        _ => 0,
    }
}
