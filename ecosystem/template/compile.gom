package template;

use std::utf8;
use std::unicode;

struct Chunk {
    kind: isize,
    text: string,
    offset: isize,
}

fn trim_previous(chunks: Vec[Chunk]) -> () {
    if !chunks.is_empty() {
        let index = chunks.len() - 1;
        let last = chunks[index];
        if last.kind == 0 {
            chunks[index] = Chunk {
                kind: 0,
                text: trim_space(last.text, false, true),
                offset: last.offset,
            };
        }
    }
}

fn scan_chunks(compile: Compile) -> Result[Vec[Chunk], Error] {
    let input = compile.source.text;
    let chunks = Vec::new();
    let mut start = 0;
    let mut index = 0;
    let mut trim_next = false;
    let mut raw = false;
    let mut raw_offset = 0;
    while index < input.byte_len() {
        if input.byte_get(index) != 123 || index + 1 >= input.byte_len() {
            index += 1;
            continue;
        }
        let next = input.byte_get(index + 1);
        if next != 123 && next != 37 && next != 35 {
            index += 1;
            continue;
        }
        if raw {
            if next != 37 {
                index += 1;
                continue;
            }
            let mut end = index + 2;
            while end + 1 < input.byte_len()
                && !(input.byte_get(end) == 37 && input.byte_get(end + 1) == 125) {
                end += 1;
            }
            if end + 1 >= input.byte_len() {
                index += 1;
                continue;
            }
            let mut body_start = index + 2;
            let mut body_end = end;
            let left_trim = body_start < body_end && input.byte_get(body_start) == 45;
            if left_trim {
                body_start += 1;
            }
            let right_trim = body_start < body_end && input.byte_get(body_end - 1) == 45;
            if right_trim {
                body_end -= 1;
            }
            if trim_space(input.byte_slice(body_start, body_end), true, true) != "endraw" {
                index += 1;
                continue;
            }
            let mut text = input.byte_slice(start, index);
            if trim_next {
                text = trim_space(text, true, false);
            }
            if left_trim {
                text = trim_space(text, false, true);
            }
            chunks.push(Chunk { kind: 0, text, offset: start });
            trim_next = right_trim;
            raw = false;
            index = end + 2;
            start = index;
            continue;
        }
        let mut text = input.byte_slice(start, index);
        if trim_next {
            text = trim_space(text, true, false);
            trim_next = false;
        }
        if text.byte_len() > 0 {
            chunks.push(Chunk { kind: 0, text, offset: start });
        }
        let opening = index;
        let mut body_start = index + 2;
        if body_start < input.byte_len() && input.byte_get(body_start) == 45 {
            trim_previous(chunks);
            body_start += 1;
        }
        let close = if next == 123 {
            125
        } else {
            next
        };
        let mut end = body_start;
        let mut quote: u8 = 0;
        let mut brackets = 0;
        let mut closed = false;
        while end + 1 < input.byte_len() {
            let byte = input.byte_get(end);
            if next == 35 {
                if byte == 35 && input.byte_get(end + 1) == 125 {
                    closed = true;
                    break;
                }
                end += 1;
                continue;
            }
            if quote != 0 {
                if byte == 92 {
                    end += 2;
                    continue;
                }
                if byte == quote {
                    quote = 0;
                }
                end += 1;
                continue;
            }
            if byte == close && input.byte_get(end + 1) == 125 && brackets == 0 {
                closed = true;
                break;
            }
            if byte == 34 || byte == 39 {
                quote = byte;
            } else if byte == 40 || byte == 91 || byte == 123 {
                brackets += 1;
            } else if byte == 41 || byte == 93 || byte == 125 {
                if brackets > 0 {
                    brackets -= 1;
                }
            }
            end += 1;
        }
        if !closed {
            return Result::Err(
                problem(compile.source, opening, ErrorKind::Syntax, "unterminated template tag"),
            )
        }
        let mut body_end = end;
        if body_end > body_start && input.byte_get(body_end - 1) == 45 {
            body_end -= 1;
            trim_next = true;
        }
        let body = input.byte_slice(body_start, body_end);
        if next != 35 {
            if next == 37 && trim_space(body, true, true) == "raw" {
                raw = true;
                raw_offset = opening;
            } else {
                chunks.push(
                    Chunk {
                        kind: if next == 123 {
                            1
                        } else {
                            2
                        },
                        text: body,
                        offset: body_start,
                    },
                );
            }
        }
        if chunks.len() > compile.limits.max_nodes {
            return Result::Err(
                problem(compile.source, opening, ErrorKind::Limit, "template chunk limit exceeded"),
            )
        }
        index = end + 2;
        start = index;
    }
    if raw {
        return Result::Err(problem(compile.source, raw_offset, ErrorKind::Syntax, "missing endraw"))
    }
    let mut text = input.byte_slice(start, input.byte_len());
    if trim_next {
        text = trim_space(text, true, false);
    }
    if text.byte_len() > 0 {
        chunks.push(Chunk { kind: 0, text, offset: start });
    }
    Result::Ok(chunks)
}

struct TemplateParser {
    compile: Compile,
    chunks: Vec[Chunk],
    cursor: Ref[isize],
    parent: Ref[Option[Expr]],
    blocks: HashMap[string, Node],
}

impl TemplateParser {
    fn tag(self: TemplateParser) -> Result[ExpressionParser, Error] {
        let chunk = self.chunks[self.cursor.get()];
        tokenize(self.compile, chunk.text, chunk.offset)
    }

    fn closing(self: TemplateParser, name: string, block: Option[string]) -> Result[(), Error] {
        if self.cursor.get() >= self.chunks.len() {
            return Result::Err(
                problem(
                    self.compile.source,
                    self.compile.source.text.byte_len(),
                    ErrorKind::Syntax,
                    f"missing {name}",
                ),
            )
        }
        let parser = self.tag()?;
        parser.expect(name)?;
        if let Some(expected) = block {
            if parser.current().kind != -1 {
                let actual = parser.name()?;
                if actual != expected {
                    return Result::Err(
                        problem(
                            self.compile.source,
                            parser.current().offset,
                            ErrorKind::Syntax,
                            "endblock name mismatch",
                        ),
                    )
                }
            }
        }
        parser.end()?;
        self.cursor.set(self.cursor.get() + 1);
        Result::Ok(())
    }

    fn body(self: TemplateParser, stops: Vec[string], depth: isize) -> Result[Vec[Node], Error] {
        let nodes = Vec::new();
        while self.cursor.get() < self.chunks.len() {
            let chunk = self.chunks[self.cursor.get()];
            self.compile.tick(chunk.offset, depth)?;
            if chunk.kind == 0 {
                nodes.push(Node { kind: NodeKind::Text(chunk.text), offset: chunk.offset });
                self.cursor.set(self.cursor.get() + 1);
                continue;
            }
            let parser = self.tag()?;
            if chunk.kind == 1 {
                let expression = parser.parse(1, 0)?;
                parser.end()?;
                nodes.push(Node { kind: NodeKind::Print(expression), offset: chunk.offset });
                self.cursor.set(self.cursor.get() + 1);
                continue;
            }
            let name = parser.name()?;
            for stop in stops {
                if name == stop {
                    return Result::Ok(nodes)
                }
            }
            self.cursor.set(self.cursor.get() + 1);
            let kind = match name {
                "set" => {
                    let variable = parser.name()?;
                    if parser.take("=") {
                        let expression = parser.parse(1, 0)?;
                        parser.end()?;
                        NodeKind::Set(variable, expression)
                    } else {
                        parser.end()?;
                        let body = self.body(Vec::from_array(["endset"]), depth + 1)?;
                        self.closing("endset", Option::None)?;
                        NodeKind::Capture(variable, body)
                    }
                },
                "if" => {
                    let condition = parser.parse(1, 0)?;
                    parser.end()?;
                    let branches = Vec::new();
                    branches.push(
                        (
                            condition,
                            self.body(Vec::from_array(["elif", "else", "endif"]), depth + 1)?,
                        ),
                    );
                    let mut fallback = Vec::new();
                    while self.cursor.get() < self.chunks.len() {
                        let next = self.tag()?;
                        if next.take("elif") {
                            let condition = next.parse(1, 0)?;
                            next.end()?;
                            self.cursor.set(self.cursor.get() + 1);
                            branches.push(
                                (
                                    condition,
                                    self.body(Vec::from_array(["elif", "else", "endif"]), depth + 1)?,
                                ),
                            );
                        } else if next.take("else") {
                            next.end()?;
                            self.cursor.set(self.cursor.get() + 1);
                            fallback = self.body(Vec::from_array(["endif"]), depth + 1)?;
                            break;
                        } else {
                            break;
                        }
                    }
                    self.closing("endif", Option::None)?;
                    NodeKind::If(branches, fallback)
                },
                "for" => {
                    let variables = Vec::from_array([parser.name()?]);
                    while parser.take(",") {
                        variables.push(parser.name()?);
                    }
                    let names = HashMap::new();
                    for variable in variables {
                        if variable == "loop" || names.contains(variable) {
                            return Result::Err(
                                problem(
                                    self.compile.source,
                                    chunk.offset,
                                    ErrorKind::Syntax,
                                    "duplicate or reserved loop variable",
                                ),
                            )
                        }
                        names.set(variable, true);
                    }
                    parser.expect("in")?;
                    let iterable = parser.parse(2, 0)?;
                    let filter = if parser.take("if") {
                        Option::Some(parser.parse(1, 0)?)
                    } else {
                        Option::None
                    };
                    parser.end()?;
                    let body = self.body(Vec::from_array(["else", "endfor"]), depth + 1)?;
                    let mut fallback = Vec::new();
                    if self.cursor.get() < self.chunks.len() {
                        let next = self.tag()?;
                        if next.take("else") {
                            next.end()?;
                            self.cursor.set(self.cursor.get() + 1);
                            fallback = self.body(Vec::from_array(["endfor"]), depth + 1)?;
                        }
                    }
                    self.closing("endfor", Option::None)?;
                    NodeKind::For(variables, iterable, filter, body, fallback)
                },
                "with" => {
                    let bindings = Vec::new();
                    let names = HashMap::new();
                    if parser.current().kind != -1 {
                        loop {
                            let variable = parser.name()?;
                            if names.contains(variable) {
                                return Result::Err(
                                    problem(
                                        self.compile.source,
                                        chunk.offset,
                                        ErrorKind::Syntax,
                                        "duplicate with binding",
                                    ),
                                )
                            }
                            names.set(variable, true);
                            parser.expect("=")?;
                            bindings.push((variable, parser.parse(1, 0)?));
                            if !parser.take(",") {
                                break;
                            }
                        }
                    }
                    parser.end()?;
                    let body = self.body(Vec::from_array(["endwith"]), depth + 1)?;
                    self.closing("endwith", Option::None)?;
                    NodeKind::With(bindings, body)
                },
                "include" => {
                    let target = parser.parse(1, 0)?;
                    let mut context = Option::None;
                    let mut only = false;
                    let mut ignore = false;
                    if parser.take("ignore") {
                        parser.expect("missing")?;
                        ignore = true;
                    }
                    if parser.take("with") {
                        if !parser.take("context") {
                            context = Option::Some(parser.parse(1, 0)?);
                        }
                    } else if parser.take("without") {
                        parser.expect("context")?;
                        only = true;
                    }
                    if parser.take("only") {
                        only = true;
                    }
                    if parser.take("ignore") {
                        if ignore {
                            return Result::Err(
                                problem(
                                    self.compile.source,
                                    chunk.offset,
                                    ErrorKind::Syntax,
                                    "duplicate ignore missing",
                                ),
                            )
                        }
                        parser.expect("missing")?;
                        ignore = true;
                    }
                    parser.end()?;
                    NodeKind::Include(target, context, only, ignore)
                },
                "autoescape" => {
                    let enabled = parser.parse(1, 0)?;
                    parser.end()?;
                    let body = self.body(Vec::from_array(["endautoescape"]), depth + 1)?;
                    self.closing("endautoescape", Option::None)?;
                    NodeKind::Autoescape(enabled, body)
                },
                "block" => {
                    let label = parser.name()?;
                    parser.end()?;
                    if self.blocks.contains(label) {
                        return Result::Err(
                            problem(
                                self.compile.source,
                                chunk.offset,
                                ErrorKind::Syntax,
                                f"duplicate block {label}",
                            ),
                        )
                    }
                    self.blocks.set(label, Node { kind: NodeKind::Text(""), offset: chunk.offset });
                    let body = self.body(Vec::from_array(["endblock"]), depth + 1)?;
                    self.closing("endblock", Option::Some(label))?;
                    let node = Node { kind: NodeKind::Block(label, body), offset: chunk.offset };
                    self.blocks.set(label, node);
                    node.kind
                },
                "extends" => {
                    if depth != 0 || self.parent.get().is_some() {
                        return Result::Err(
                            problem(
                                self.compile.source,
                                chunk.offset,
                                ErrorKind::Syntax,
                                "extends must occur once at top level",
                            ),
                        )
                    }
                    for node in nodes {
                        match node.kind {
                            NodeKind::Text(text) => if text.trim().byte_len() != 0 {
                                return Result::Err(
                                    problem(
                                        self.compile.source,
                                        node.offset,
                                        ErrorKind::Syntax,
                                        "extends must precede template content",
                                    ),
                                )
                            },
                            _ => return Result::Err(
                                problem(
                                    self.compile.source,
                                    node.offset,
                                    ErrorKind::Syntax,
                                    "extends must precede template content",
                                ),
                            ),
                        }
                    }
                    let parent = parser.parse(1, 0)?;
                    parser.end()?;
                    self.parent.set(Option::Some(parent));
                    continue;
                },
                _ => return Result::Err(
                    problem(
                        self.compile.source,
                        chunk.offset,
                        ErrorKind::Syntax,
                        f"unknown or misplaced tag {name}",
                    ),
                ),
            };
            nodes.push(Node { kind, offset: chunk.offset });
        }
        Result::Ok(nodes)
    }
}

fn validate_limits(limits: Limits) -> Result[(), Error] {
    if limits.max_source_bytes < 0 || limits.max_nodes < 0 || limits.max_depth < 0
        || limits.max_steps < 0
        || limits.max_output_bytes < 0
        || limits.max_collection < 0
        || limits.max_include_depth < 0 {
        Result::Err(api_error(ErrorKind::Limit, "limits must be nonnegative"))
    } else {
        Result::Ok(())
    }
}

pub fn compile_with_limits(name: string, text: string, limits: Limits) -> Result[Template, Error] {
    validate_limits(limits)?;
    let source = Source { name, text };
    if text.byte_len() > limits.max_source_bytes {
        return Result::Err(
            problem(source, 0, ErrorKind::Limit, "template source exceeds byte limit"),
        )
    }
    utf8::validate(text.to_bytes().as_slice()).map_err(
        |error| problem(
            source,
            error.valid_up_to(),
            ErrorKind::Syntax,
            "template source is not UTF-8",
        ),
    )?;
    let context = Compile { source, limits, count: Ref::new(0) };
    let parser = TemplateParser {
        compile: context,
        chunks: scan_chunks(context)?,
        cursor: Ref::new(0),
        parent: Ref::new(Option::None),
        blocks: HashMap::new(),
    };
    let nodes = parser.body(Vec::new(), 0)?;
    if parser.parent.get().is_some() {
        for node in nodes {
            match node.kind {
                NodeKind::Text(value) => if value.trim().byte_len() != 0 {
                    return Result::Err(
                        problem(
                            source,
                            node.offset,
                            ErrorKind::Syntax,
                            "child template content must be inside blocks",
                        ),
                    )
                },
                NodeKind::Block(_, _) | NodeKind::Set(_, _) | NodeKind::Capture(_, _) => (),
                _ => return Result::Err(
                    problem(
                        source,
                        node.offset,
                        ErrorKind::Syntax,
                        "child template top level supports blocks and assignments",
                    ),
                ),
            }
        }
    }
    Result::Ok(Template { source, nodes, parent: parser.parent.get(), blocks: parser.blocks })
}

pub fn compile(name: string, text: string) -> Result[Template, Error] {
    compile_with_limits(name, text, Limits::standard())
}

fn trim_space(value: string, left: bool, right: bool) -> string {
    let mut start = 0;
    let mut end = value.byte_len();
    let mut seen = false;
    for (index, scalar) in value.char_indices() {
        if !unicode::is_whitespace(scalar) {
            if !seen && left {
                start = index;
            }
            seen = true;
            if right {
                end = index + scalar.to_string().byte_len();
            }
        }
    }
    if !seen {
        ""
    } else {
        value.byte_slice(start, end)
    }
}
