package template;

#[derive(Debug, PartialEq)]
pub enum ErrorKind {
    Syntax,
    Undefined,
    Type,
    Arithmetic,
    MissingTemplate,
    RecursiveTemplate,
    Limit,
    Extension,
}

#[derive(Debug)]
pub struct Location {
    pub template: string,
    pub offset: isize,
    pub line: isize,
    pub column: isize,
}

pub struct Error {
    pub kind: ErrorKind,
    pub location: Location,
    pub message: string,
    pub trace: Vec[Location],
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        let at = self.location;
        let mut result = f"{at.template}:{at.line}:{at.column}: {self.message}";
        for caller in self.trace {
            result += f"\n  included from {caller.template}:{caller.line}:{caller.column}";
        }
        result
    }
}

impl Debug for Error {
    fn debug(self: Error) -> string {
        self.to_string()
    }
}

pub struct Limits {
    pub max_source_bytes: isize,
    pub max_nodes: isize,
    pub max_depth: isize,
    pub max_steps: isize,
    pub max_output_bytes: isize,
    pub max_collection: isize,
    pub max_include_depth: isize,
}

impl Limits {
    pub fn standard() -> Limits {
        Limits {
            max_source_bytes: 1048576,
            max_nodes: 100000,
            max_depth: 128,
            max_steps: 1000000,
            max_output_bytes: 8388608,
            max_collection: 100000,
            max_include_depth: 32,
        }
    }
}

pub struct Options {
    pub strict_undefined: bool,
    pub autoescape: bool,
    pub limits: Limits,
}

impl Options {
    pub fn standard() -> Options {
        Options { strict_undefined: true, autoescape: true, limits: Limits::standard() }
    }
}

pub enum Value {
    Undefined(string),
    Null,
    Bool(bool),
    Int(i64),
    Float(f64),
    Text(string),
    Safe(string),
    List(Vec[Value]),
    Object(Vec[(string, Value)]),
}

pub type Function = (Vec[Value]) -> Result[Value, string];

pub type Filter = (Value, Vec[Value]) -> Result[Value, string];

pub type Loader = (string) -> Result[Option[string], string];

struct Source {
    name: string,
    text: string,
}

fn location(source: Source, offset: isize) -> Location {
    let mut line = 1;
    let mut column = 1;
    for (position, scalar) in source.text.char_indices() {
        if position >= offset {
            break;
        }
        if scalar == '\n' {
            line += 1;
            column = 1;
        } else {
            column += 1;
        }
    }
    Location { template: source.name, offset, line, column }
}

fn problem(source: Source, offset: isize, kind: ErrorKind, message: string) -> Error {
    Error { kind, location: location(source, offset), message, trace: Vec::new() }
}

fn api_error(kind: ErrorKind, message: string) -> Error {
    problem(Source { name: "<context>", text: "" }, 0, kind, message)
}

struct Expr {
    kind: ExprKind,
    offset: isize,
}

enum ExprKind {
    Literal(Value),
    Name(string),
    List(Vec[Expr]),
    Object(Vec[(Expr, Expr)]),
    Unary(string, Expr),
    Binary(string, Expr, Expr),
    Compare(Expr, Vec[(string, Expr)]),
    Test(Expr, string, bool),
    Index(Expr, Expr),
    Slice(Expr, Option[Expr], Option[Expr], Option[Expr]),
    Call(string, Vec[Expr]),
    Filter(Expr, string, Vec[Expr]),
    Choose(Expr, Expr, Expr),
}

struct Node {
    kind: NodeKind,
    offset: isize,
}

enum NodeKind {
    Text(string),
    Print(Expr),
    Set(string, Expr),
    Capture(string, Vec[Node]),
    If(Vec[(Expr, Vec[Node])], Vec[Node]),
    For(Vec[string], Expr, Option[Expr], Vec[Node], Vec[Node]),
    With(Vec[(string, Expr)], Vec[Node]),
    Include(Expr, Option[Expr], bool, bool),
    Autoescape(Expr, Vec[Node]),
    Block(string, Vec[Node]),
}

pub struct Template {
    source: Source,
    nodes: Vec[Node],
    parent: Option[Expr],
    blocks: HashMap[string, Node],
}

impl Template {
    pub fn name(self: Template) -> string {
        self.source.name
    }
}

struct Compile {
    source: Source,
    limits: Limits,
    count: Ref[isize],
}

impl Compile {
    fn tick(self: Compile, offset: isize, depth: isize) -> Result[(), Error] {
        if depth > self.limits.max_depth || self.count.get() >= self.limits.max_nodes {
            return Result::Err(
                problem(self.source, offset, ErrorKind::Limit, "template syntax limit exceeded"),
            )
        }
        self.count.set(self.count.get() + 1);
        Result::Ok(())
    }

    fn expr(self: Compile, kind: ExprKind, offset: isize, depth: isize) -> Result[Expr, Error] {
        self.tick(offset, depth)?;
        Result::Ok(Expr { kind, offset })
    }
}

trait LazyError[T] {
    fn or_error(self: Self, failure: () -> Error) -> Result[T, Error];
}

impl[T] LazyError[T]for Option[T] {
    fn or_error(self: Option[T], failure: () -> Error) -> Result[T, Error] {
        match self {
            Some(value) => Result::Ok(value),
            None => Result::Err(failure()),
        }
    }
}
