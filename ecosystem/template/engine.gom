package template;

pub struct Engine {
    options: Options,
    templates: HashMap[string, Template],
    functions: HashMap[string, Function],
    filters: HashMap[string, Filter],
    loader: Ref[Option[Loader]],
}

impl Engine {
    pub fn new(options: Options) -> Result[Engine, Error] {
        validate_limits(options.limits)?;
        Result::Ok(
            Engine {
                options,
                templates: HashMap::new(),
                functions: HashMap::new(),
                filters: HashMap::new(),
                loader: Ref::new(Option::None),
            },
        )
    }

    pub fn add(self: Engine, name: string, source: string) -> Result[(), Error] {
        let template = compile_with_limits(name, source, self.options.limits)?;
        self.templates.set(name, template);
        Result::Ok(())
    }

    pub fn remove(self: Engine, name: string) -> bool {
        self.templates.remove_value(name).is_some()
    }

    pub fn contains(self: Engine, name: string) -> bool {
        self.templates.contains(name)
    }

    pub fn register_function(self: Engine, name: string, function: Function) -> Result[(), Error] {
        if !valid_name(name) || name == "super" {
            return Result::Err(api_error(ErrorKind::Extension, "invalid or reserved function name"))
        }
        self.functions.set(name, function);
        Result::Ok(())
    }

    pub fn register_filter(self: Engine, name: string, filter: Filter) -> Result[(), Error] {
        if !valid_name(name) {
            return Result::Err(api_error(ErrorKind::Extension, "invalid filter name"))
        }
        self.filters.set(name, filter);
        Result::Ok(())
    }

    pub fn set_loader(self: Engine, loader: Loader) -> () {
        self.loader.set(Option::Some(loader));
    }

    fn load(self: Engine, name: string, source: Source, offset: isize) -> Result[Template, Error] {
        if let Some(template) = self.templates.get(name) {
            return Result::Ok(template)
        }
        if let Some(loader) = self.loader.get() {
            if let Some(text) = loader(name).map_err(
                |message| problem(source, offset, ErrorKind::Extension, message),
            )? {
                let template = compile_with_limits(name, text, self.options.limits)?;
                self.templates.set(name, template);
                return Result::Ok(template)
            }
        }
        Result::Err(
            problem(source, offset, ErrorKind::MissingTemplate, f"template not found: {name}"),
        )
    }

    pub fn render(self: Engine, name: string, context: Value) -> Result[string, Error] {
        let source = Source { name, text: "" };
        let template = self.load(name, source, 0)?;
        self.render_template(template, context)
    }

    pub fn render_template(self: Engine, template: Template, context: Value) -> Result[
        string,
        Error,
    ] {
        let runtime = Runtime {
            engine: self,
            scopes: Vec::from_array([HashMap::new()]),
            steps: Ref::new(0),
            stack: Vec::new(),
        };
        let context = runtime.snapshot(context, template.source, 0, 0)?;
        runtime.bind_context(context, template.source, 0)?;
        let output = Output::new(self.options.limits.max_output_bytes);
        runtime.render(template, output, self.options.autoescape, 0)?;
        Result::Ok(output.finish())
    }

    pub fn render_string(self: Engine, source: string, context: Value) -> Result[string, Error] {
        self.render_template(compile_with_limits("<string>", source, self.options.limits)?, context)
    }
}

fn valid_name(value: string) -> bool {
    let mut first = true;
    for scalar in value.chars() {
        if first {
            if !identifier_start(scalar) {
                return false
            }
            first = false;
        } else if !identifier_continue(scalar) {
            return false
        }
    }
    !first
}

struct Runtime {
    engine: Engine,
    scopes: Vec[HashMap[string, Value]],
    steps: Ref[isize],
    stack: Vec[string],
}

struct BlockRef {
    source: Source,
    node: Node,
}

struct World {
    blocks: HashMap[string, Vec[BlockRef]],
    active: Vec[(string, isize)],
}

impl Runtime {
    fn tick(self: Runtime, source: Source, offset: isize, depth: isize) -> Result[(), Error] {
        if depth > self.engine.options.limits.max_depth
            || self.steps.get() >= self.engine.options.limits.max_steps {
            return Result::Err(
                problem(
                    source,
                    offset,
                    ErrorKind::Limit,
                    "rendering depth or operation limit exceeded",
                ),
            )
        }
        self.steps.set(self.steps.get() + 1);
        Result::Ok(())
    }

    fn lookup(self: Runtime, name: string) -> Value {
        let mut index = self.scopes.len();
        while index > 0 {
            index -= 1;
            if let Some(value) = self.scopes[index].get(name) {
                return value
            }
        }
        Value::Undefined(name)
    }

    fn set(self: Runtime, name: string, value: Value) -> () {
        self.scopes[self.scopes.len() - 1].set(name, value);
    }

    fn bind_context(self: Runtime, value: Value, source: Source, offset: isize) -> Result[(), Error] {
        let Value::Object(fields) = value else {
            return Result::Err(
                problem(source, offset, ErrorKind::Type, "render context must be an object"),
            )
        };
        for (key, value) in fields {
            self.set(key, value);
        }
        Result::Ok(())
    }

    fn child(self: Runtime, inherited: bool) -> Runtime {
        let scopes = Vec::new();
        if inherited {
            for scope in self.scopes {
                scopes.push(scope);
            }
        }
        scopes.push(HashMap::new());
        Runtime { engine: self.engine, scopes, steps: self.steps, stack: self.stack }
    }

    fn enter(self: Runtime, template: Template) -> Result[(), Error] {
        if self.stack.len() >= self.engine.options.limits.max_include_depth {
            return Result::Err(
                problem(
                    template.source,
                    0,
                    ErrorKind::Limit,
                    "template include or inheritance depth exceeded",
                ),
            )
        }
        for name in self.stack {
            if name == template.source.name {
                return Result::Err(
                    problem(
                        template.source,
                        0,
                        ErrorKind::RecursiveTemplate,
                        f"recursive template {name}",
                    ),
                )
            }
        }
        self.stack.push(template.source.name);
        Result::Ok(())
    }

    fn render(self: Runtime, template: Template, output: Output, autoescape: bool, depth: isize) -> Result[
        (),
        Error,
    ] {
        let world = World { blocks: HashMap::new(), active: Vec::new() };
        let mut current = template;
        let initial = self.stack.len();
        loop {
            self.tick(current.source, 0, depth)?;
            self.enter(current)?;
            for (name, node) in current.blocks.entries() {
                let chain = world.blocks.get(name).unwrap_or(Vec::new());
                chain.push(BlockRef { source: current.source, node });
                world.blocks.set(name, chain);
            }
            if let Some(parent) = current.parent {
                for node in current.nodes {
                    match node.kind {
                        NodeKind::Set(_, _) | NodeKind::Capture(_, _) => self.nodes(
                            Vec::from_array([node]),
                            current.source,
                            world,
                            output,
                            autoescape,
                            depth + 1,
                        )?,
                        _ => (),
                    }
                }
                let value = self.eval(parent, current.source, world, autoescape, depth + 1)?;
                let name = value.as_text().or_error(
                    || problem(
                        current.source,
                        parent.offset,
                        ErrorKind::Type,
                        "parent template name must be a string",
                    ),
                )?;
                current = self.engine.load(name, current.source, parent.offset)?;
            } else {
                break;
            }
        }
        self.nodes(current.nodes, current.source, world, output, autoescape, depth + 1)?;
        self.stack.truncate(initial);
        Result::Ok(())
    }

    fn block(
        self: Runtime,
        name: string,
        index: isize,
        world: World,
        output: Output,
        autoescape: bool,
        depth: isize,
        caller: Source,
        offset: isize,
    ) -> Result[(), Error] {
        self.tick(caller, offset, depth)?;
        let chain = world.blocks.get(name).or_error(
            || problem(caller, offset, ErrorKind::Type, "unknown inheritance block"),
        )?;
        if index < 0 || index >= chain.len() {
            return Result::Err(
                problem(caller, offset, ErrorKind::Type, "super has no parent block"),
            )
        }
        for active in world.active {
            if active.0 == name && active.1 == index {
                return Result::Err(
                    problem(
                        caller,
                        offset,
                        ErrorKind::RecursiveTemplate,
                        "recursive inheritance block",
                    ),
                )
            }
        }
        let selected = chain[index];
        let NodeKind::Block(_, body) = selected.node.kind else {
            return Result::Err(
                problem(caller, offset, ErrorKind::Type, "invalid inheritance block"),
            )
        };
        world.active.push((name, index));
        self.scopes.push(HashMap::new());
        self.nodes(body, selected.source, world, output, autoescape, depth + 1)?;
        let _ = self.scopes.pop();
        let _ = world.active.pop();
        Result::Ok(())
    }

    fn bind_loop(self: Runtime, names: Vec[string], value: Value, source: Source, offset: isize) -> Result[
        (),
        Error,
    ] {
        if names.len() == 1 {
            self.set(names[0], value);
            return Result::Ok(())
        }
        let values = self.sequence(value, source, offset)?;
        if values.len() != names.len() {
            return Result::Err(
                problem(source, offset, ErrorKind::Type, "loop unpacking length mismatch"),
            )
        }
        for index in 0..names.len() {
            self.set(names[index], values[index]);
        }
        Result::Ok(())
    }

    fn include(self: Runtime, value: Value, source: Source, offset: isize) -> Result[
        Template,
        Error,
    ] {
        let names = match value {
            Value::List(names) => names,
            other => Vec::from_array([other]),
        };
        for value in names {
            let name = value.as_text().or_error(
                || problem(source, offset, ErrorKind::Type, "include names must be strings"),
            )?;
            match self.engine.load(name, source, offset) {
                Ok(template) => return Result::Ok(template),
                Err(error) => if error.kind != ErrorKind::MissingTemplate {
                    return Result::Err(error)
                },
            }
        }
        Result::Err(
            problem(
                source,
                offset,
                ErrorKind::MissingTemplate,
                "none of the included templates exist",
            ),
        )
    }

    fn nodes(
        self: Runtime,
        nodes: Vec[Node],
        source: Source,
        world: World,
        output: Output,
        autoescape: bool,
        depth: isize,
    ) -> Result[(), Error] {
        for node in nodes {
            self.tick(source, node.offset, depth)?;
            match node.kind {
                NodeKind::Text(value) => output.append(value, source, node.offset)?,
                NodeKind::Print(expression) => {
                    let value = self.eval(expression, source, world, autoescape, depth + 1)?;
                    let text = self.display(value, source, expression.offset)?;
                    output.append(
                        if autoescape && !is_safe(value) {
                            escaped(text, output.limit, source, expression.offset)?
                        } else {
                            text
                        },
                        source,
                        expression.offset,
                    )?;
                },
                NodeKind::Set(name, expression) => {
                    let value = self.eval(expression, source, world, autoescape, depth + 1)?;
                    self.set(name, value);
                },
                NodeKind::Capture(name, body) => {
                    let capture = Output::new(output.limit);
                    self.nodes(body, source, world, capture, autoescape, depth + 1)?;
                    self.set(
                        name,
                        if autoescape {
                            Value::Safe(capture.finish())
                        } else {
                            Value::Text(capture.finish())
                        },
                    );
                },
                NodeKind::If(branches, fallback) => {
                    let mut found = false;
                    for (condition, body) in branches {
                        if self.truth(
                            self.eval(condition, source, world, autoescape, depth + 1)?,
                            source,
                            condition.offset,
                        )? {
                            self.nodes(body, source, world, output, autoescape, depth + 1)?;
                            found = true;
                            break;
                        }
                    }
                    if !found {
                        self.nodes(fallback, source, world, output, autoescape, depth + 1)?;
                    }
                },
                NodeKind::For(names, expression, filter, body, fallback) => {
                    let items = self.sequence(
                        self.eval(expression, source, world, autoescape, depth + 1)?,
                        source,
                        expression.offset,
                    )?;
                    let accepted = Vec::new();
                    for item in items {
                        self.tick(source, node.offset, depth)?;
                        self.scopes.push(HashMap::new());
                        self.bind_loop(names, item, source, node.offset)?;
                        let keep = if let Some(condition) = filter {
                            self.truth(
                                self.eval(condition, source, world, autoescape, depth + 1)?,
                                source,
                                condition.offset,
                            )?
                        } else {
                            true
                        };
                        let _ = self.scopes.pop();
                        if keep {
                            accepted.push(item);
                        }
                    }
                    if accepted.is_empty() {
                        self.scopes.push(HashMap::new());
                        self.nodes(fallback, source, world, output, autoescape, depth + 1)?;
                        let _ = self.scopes.pop();
                    }
                    let parent = self.lookup("loop");
                    for index in 0..accepted.len() {
                        self.tick(source, node.offset, depth)?;
                        self.scopes.push(HashMap::new());
                        self.bind_loop(names, accepted[index], source, node.offset)?;
                        self.set(
                            "loop",
                            Value::Object(
                                Vec::from_array(
                                    [
                                        ("index", Value::Int((index + 1).to_i64())),
                                        ("index0", Value::Int(index.to_i64())),
                                        ("revindex", Value::Int((accepted.len() - index).to_i64())),
                                        (
                                            "revindex0",
                                            Value::Int((accepted.len() - index - 1).to_i64()),
                                        ),
                                        ("length", Value::Int(accepted.len().to_i64())),
                                        ("first", Value::Bool(index == 0)),
                                        ("last", Value::Bool(index + 1 == accepted.len())),
                                        ("parent", parent),
                                    ],
                                ),
                            ),
                        );
                        self.nodes(body, source, world, output, autoescape, depth + 1)?;
                        let _ = self.scopes.pop();
                    }
                },
                NodeKind::With(bindings, body) => {
                    let values = Vec::new();
                    for (name, expression) in bindings {
                        values.push(
                            (name, self.eval(expression, source, world, autoescape, depth + 1)?),
                        );
                    }
                    self.scopes.push(HashMap::new());
                    for (name, value) in values {
                        self.set(name, value);
                    }
                    self.nodes(body, source, world, output, autoescape, depth + 1)?;
                    let _ = self.scopes.pop();
                },
                NodeKind::Include(expression, context, only, ignore) => {
                    let target = self.eval(expression, source, world, autoescape, depth + 1)?;
                    let included = match self.include(target, source, expression.offset) {
                        Ok(template) => template,
                        Err(error) => if ignore && error.kind == ErrorKind::MissingTemplate {
                            continue;
                        } else {
                            return Result::Err(error)
                        },
                    };
                    let child = self.child(!only);
                    if let Some(context) = context {
                        child.bind_context(
                            self.eval(context, source, world, autoescape, depth + 1)?,
                            source,
                            context.offset,
                        )?;
                    }
                    if let Err(error) = child.render(included, output, autoescape, depth + 1) {
                        error.trace.push(location(source, node.offset));
                        return Result::Err(error)
                    }
                },
                NodeKind::Autoescape(expression, body) => {
                    let enabled = self.truth(
                        self.eval(expression, source, world, autoescape, depth + 1)?,
                        source,
                        expression.offset,
                    )?;
                    self.nodes(body, source, world, output, enabled, depth + 1)?;
                },
                NodeKind::Block(name, _) => self.block(
                    name,
                    0,
                    world,
                    output,
                    autoescape,
                    depth + 1,
                    source,
                    node.offset,
                )?,
            }
        }
        Result::Ok(())
    }
}
