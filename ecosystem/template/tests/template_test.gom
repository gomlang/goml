package tests;

use ecosystem::template;
use ecosystem::template::{Value, Engine, Options, ErrorKind};
use std::json;
use std::testing;

fn engine() -> Engine {
    testing::expect_ok(Engine::new(Options::standard()), "engine")
}

fn context(source: string) -> Value {
    testing::expect_ok(Value::from_json(testing::expect_ok(json::parse(source), "JSON")), "context")
}

fn render(source: string, data: string) -> string {
    match engine().render_string(source, context(data)) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string() + " IN " + source);
            ""
        },
    }
}

fn check(source: string, data: string, expected: string) -> () {
    testing::assert_eq(render(source, data), expected);
}

#[test]
fn scanner_raw_comments_quoted_delimiters_and_whitespace_control() -> () {
    check("A {# ignored {{ broken #} B", "{}", "A  B");
    check("a \n {{- 'x' -}} \n b", "{}", "axb");
    check("A{% raw %}{{ bad + }} {% if ??? %}{% endraw %}B", "{}", "A{{ bad + }} {% if ??? %}B");
    check(" A {%- raw -%} \n{{ x }} \n{%- endraw -%} B", "{}", " A{{ x }}B");
    check("{{ '}}' }}|{{ {'x': '%}', 'y': '}'}.x }}|{{ '\"' }}", "{}", "}}|%}|&#34;");
    check("你好\n{{ '😀' }}\n", "{}", "你好\n😀\n");
    check("{{ 'a\\n\\t\\u4e2d' }}", "{}", "a\n\t中");
}

#[test]
fn expression_precedence_short_circuit_chains_and_unicode_slices() -> () {
    check("{{ 2 + 3 * 4 }}|{{ (2+3)*4 }}|{{ 2**3**2 }}|{{ -2**2 }}", "{}", "14|20|512|-4");
    check("{{ -7//3 }}|{{ -7%3 }}|{{ 7//-3 }}|{{ 7%-3 }}", "{}", "-3|2|-3|-2");
    check(
        "{{ 'yes' if 1 < x < 8 else 'no' }}|{{ 'a' if not x in [2,3] else 'b' }}",
        "{\"x\":4}",
        "yes|a",
    );
    check(
        "{{ 'ok' or missing }}|{{ '' and missing }}|{{ 'yes' if true else 1/0 }}",
        "{}",
        "ok||yes",
    );
    check(
        "{{ text[1] }}|{{ text[-1] }}|{{ text[::-1] }}|{{ text[1:4:2] }}|{{ text[:-1] }}",
        "{\"text\":\"A中😀BC\"}",
        "中|C|CB😀中A|中B|A中😀B",
    );
    check("{{ [1,2,3,4][::-2]|join(',') }}|{{ (7,8).1 }}|{{ {'a':9}['a'] }}", "{}", "4,2|8|9");
    check(
        "{{ 'x' ~ 12 }}|{{ 'ab'*3 }}|{{ (([1,2]+[3])*2)|join(',') }}",
        "{}",
        "x12|ababab|1,2,3,1,2,3",
    );
    check(
        "{{ 9007199254740993 == 9007199254740992.0 }}|{{ 9223372036854775807 < 9223372036854775808.0 }}|{{ -9223372036854775808 == -9223372036854775808.0 }}",
        "{}",
        "false|true|true",
    );
    check("{{ {'a':1} == {'b':1} }}", "{}", "false");
}

#[test]
fn lexical_scopes_filtered_loops_metadata_unpacking_and_empty_else() -> () {
    check(
        "{% set x='outer' %}{% for x in [1,2,3,4] if x is odd %}{{loop.index}}/{{loop.length}}={{x}}:{{loop.first}}:{{loop.last}};{% set hidden=1 %}{% endfor %}{{x}}/{{hidden is defined}}",
        "{}",
        "1/2=1:true:false;2/2=3:false:true;outer/false",
    );
    check(
        "{% for x in [] %}bad{% else %}{% set x=9 %}empty{% endfor %}{{x|default('none')}}",
        "{}",
        "emptynone",
    );
    check("{% set a=1 %}{% with a=2, b=a %}{{a}}/{{b}}{% endwith %}/{{a}}", "{}", "2/1/1");
    check(
        "{% for k,v in data|items %}{{k}}={{v}};{% endfor %}",
        "{\"data\":{\"a\":1,\"b\":2}}",
        "a=1;b=2;",
    );
    check(
        "{% for x in [1,2] %}{% for y in [3,4] %}{{loop.parent.index}}.{{loop.index}};{% endfor %}{% endfor %}",
        "{}",
        "1.1;1.2;2.1;2.2;",
    );
    check(
        "{% if false %}a{% elif 2>1 %}{% set found='yes' %}b{% else %}c{% endif %}{{found}}",
        "{}",
        "byes",
    );
}

#[test]
fn html_safety_capture_concat_join_json_and_autoescape_blocks() -> () {
    check(
        "{{x}}|{{x|safe}}|{{x|escape}}|{{x|safe|forceescape}}",
        "{\"x\":\"<b>\\\"&'</b>\"}",
        "&lt;b&gt;&#34;&amp;&#39;&lt;/b&gt;|<b>\"&'</b>|&lt;b&gt;&#34;&amp;&#39;&lt;/b&gt;|&lt;b&gt;&#34;&amp;&#39;&lt;/b&gt;",
    );
    check(
        "{{ '<b>'|safe ~ x }}|{{ ['<i>'|safe, x]|join('&') }}",
        "{\"x\":\"<x>\"}",
        "<b>&lt;x&gt;|<i>&amp;&lt;x&gt;",
    );
    check(
        "{% set card %}<b>{{x}}</b>{% endset %}{{card}}|{% autoescape false %}{{x}}{% endautoescape %}|{{x}}",
        "{\"x\":\"<x>\"}",
        "<b>&lt;x&gt;</b>|<x>|&lt;x&gt;",
    );
    check("{{x|tojson}}", "{\"x\":\"</script>&'\"}", "\"\\u003c/script\\u003e\\u0026\\u0027\"");
    check("{{ '/路径?q=a b&x=1'|urlencode }}", "{}", "/%E8%B7%AF%E5%BE%84%3Fq%3Da%20b%26x%3D1");
}

#[test]
fn built_in_filters_cover_collections_text_and_numbers() -> () {
    check(
        "{{ [3,1,2,1]|unique|sort|reverse|join(':') }}|{{ [1,2,3]|sum }}|{{ [8,2,5]|min }}|{{ [8,2,5]|max }}",
        "{}",
        "3:2:1|6|2|8",
    );
    check(
        "{{ users|selectattr('ok')|map('name')|join(',') }}|{{ users|rejectattr('ok')|map('name')|join(',') }}",
        "{\"users\":[{\"name\":\"a\",\"ok\":true},{\"name\":\"b\",\"ok\":false}]}",
        "a|b",
    );
    check(
        "{{ [1,2,3]|batch(2,0)|last|join(',') }}|{{ [0,1,2]|select|join(',') }}|{{ [0,1,2]|reject|join(',') }}",
        "{}",
        "3,0|1,2|0",
    );
    check(
        "{{ ' éCOLE '|trim|lower }}|{{ 'école'|upper }}|{{ 'hELLO'|capitalize }}|{{ '中文😀'|length }}",
        "{}",
        "école|ÉCOLE|Hello|3",
    );
    check(
        "{{ 'aaa'|replace('a','xy',2) }}|{{ '中a'|replace('','-') }}|{{ '-42'|int|abs }}|{{ '1.5'|float }}",
        "{}",
        "xyxya|-中-a-|42|1.5",
    );
    check(
        "{{ range(5,-1,-2)|join(',') }}|{{ []|first|default('empty') }}|{{ 0|default('zero',true) }}|{{ null|default('null',true) }}",
        "{}",
        "5,3,1|empty|zero|null",
    );
}

#[test]
fn includes_context_isolation_fallback_names_and_loader_cache() -> () {
    let engine = engine();
    testing::assert_ok(engine.add("part", "{{x}}/{{outer|default('-')}}{% set outer='changed' %}"));
    testing::assert_ok(
        engine.add(
            "main",
            "{% include ['missing','part'] with {'x':'inner'} %}|{% include 'part' with {'x':'only'} only %}|{{outer}}|{% include 'absent' ignore missing %}",
        ),
    );
    testing::assert_eq(
        testing::expect_ok(engine.render("main", context("{\"outer\":\"parent\"}")), "include"),
        "inner/parent|only/-|parent|",
    );
    let count = Ref::new(0);
    engine.set_loader(
        |name| {
            count.set(count.get() + 1);
            Result::Ok(
                if name == "loaded" {
                    Option::Some("loaded={{x}}")
                } else {
                    Option::None
                },
            )
        },
    );
    testing::assert_eq(
        testing::expect_ok(engine.render("loaded", context("{\"x\":1}")), "loader"),
        "loaded=1",
    );
    testing::assert_eq(
        testing::expect_ok(engine.render("loaded", context("{\"x\":2}")), "cached loader"),
        "loaded=2",
    );
    testing::assert_eq(count.get(), 1);
    testing::assert(engine.remove("loaded"));
    testing::assert(!engine.contains("loaded"));
    testing::assert_ok(engine.render("loaded", context("{\"x\":3}")));
    testing::assert_eq(count.get(), 2);
    testing::assert_ok(engine.add("cycle", "{% include 'cycle' %}"));
    testing::assert_eq(
        testing::expect_err(engine.render("cycle", context("{}")), "cycle").kind,
        ErrorKind::RecursiveTemplate,
    );
}

#[test]
fn inheritance_super_nested_blocks_and_replacement_are_consistent() -> () {
    let engine = engine();
    testing::assert_ok(
        engine.add(
            "base",
            "<head>{% block title %}Base{% endblock %}</head><main>{% block body %}B:{% block inner %}I{% endblock %}{% endblock %}</main>",
        ),
    );
    testing::assert_ok(
        engine.add(
            "middle",
            "{% extends 'base' %}{% block title %}Mid+{{super()}}{% endblock %}{% block body %}M+{{super()}}{% endblock %}",
        ),
    );
    testing::assert_ok(
        engine.add(
            "child",
            "{% extends 'middle' %}{% set suffix='!' %}{% block title %}Child+{{super()}}{% endblock %}{% block inner %}{{value}}{{suffix}}{% endblock %}",
        ),
    );
    testing::assert_eq(
        testing::expect_ok(engine.render("child", context("{\"value\":\"<x>\"}")), "inheritance"),
        "<head>Child+Mid+Base</head><main>M+B:&lt;x&gt;!</main>",
    );
    testing::assert_err(engine.add("child", "{% if %}"));
    testing::assert_eq(
        testing::expect_ok(
            engine.render("child", context("{\"value\":\"Y\"}")),
            "old template retained",
        ),
        "<head>Child+Mid+Base</head><main>M+B:Y!</main>",
    );
    testing::assert_ok(engine.add("a", "{% extends 'b' %}"));
    testing::assert_ok(engine.add("b", "{% extends 'a' %}"));
    testing::assert_eq(
        testing::expect_err(engine.render("a", context("{}")), "inheritance cycle").kind,
        ErrorKind::RecursiveTemplate,
    );
}

#[test]
fn downstream_callbacks_typed_context_and_missing_value_policy() -> () {
    let engine = engine();
    let calls = Ref::new(0);
    testing::assert_ok(
        engine.register_function(
            "twice",
            |args| {
                calls.set(calls.get() + 1);
                if args.len() != 1 {
                    return Result::Err("twice expects one argument")
                }
                let number = args[0].as_int().ok_or("twice expects integer")?;
                Result::Ok(Value::Int(number * 2))
            },
        ),
    );
    testing::assert_ok(
        engine.register_filter(
            "surround",
            |value, args| {
                if !args.is_empty() {
                    return Result::Err("surround accepts no arguments")
                }
                Result::Ok(Value::Text("[" + value.as_text().ok_or("expected text")? + "]"))
            },
        ),
    );
    testing::assert_eq(
        testing::expect_ok(
            engine.render_string(
                "{{twice(3)}}|{{ 'x'|surround }}|{{ 'short' or twice(9) }}",
                context("{}"),
            ),
            "callbacks",
        ),
        "6|[x]|short",
    );
    testing::assert_eq(calls.get(), 1);
    testing::assert_eq(
        testing::expect_err(
            engine.render_string("{{twice('bad')}}", context("{}")),
            "callback error",
        ).kind,
        ErrorKind::Extension,
    );
    testing::assert_eq(
        testing::expect_err(engine.render_string("{{missing}}", context("{}")), "undefined").kind,
        ErrorKind::Undefined,
    );
    testing::assert_eq(
        testing::expect_ok(
            engine.render_string(
                "{{missing.deep|default('fallback')}}|{{missing is undefined}}",
                context("{}"),
            ),
            "defined check",
        ),
        "fallback|true",
    );
    let relaxed = testing::expect_ok(
        Engine::new(
            Options {
                strict_undefined: false,
                autoescape: true,
                limits: template::Limits::standard(),
            },
        ),
        "relaxed",
    );
    testing::assert_eq(
        testing::expect_ok(
            relaxed.render_string(
                "{{missing}}{% if missing %}bad{% endif %}{% for x in missing %}bad{% else %}empty{% endfor %}",
                context("{}"),
            ),
            "relaxed render",
        ),
        "empty",
    );
}

#[test]
fn malformed_templates_type_errors_arithmetic_and_contextual_diagnostics() -> () {
    for source in Vec::from_array(
        [
            "{{",
            "{% raw %}abc",
            "{% if x %}",
            "{% endif %}",
            "{{ 1e }}",
            "{{ 'unterminated }}",
            "{{ 1 + }}",
            "{{ a()() }}",
            "{% block a %}{% endblock b %}",
            "{% block a %}{% endblock %}{% block a %}{% endblock %}",
            "x{% extends 'base' %}",
            "{% extends 'base' %}lost",
            "{% for x,x in xs %}{% endfor %}",
            "{% unknown %}",
        ],
    ) {
        testing::assert_err(template::compile("invalid", source));
    }
    for source in Vec::from_array(
        [
            "{{1/0}}",
            "{{ -9223372036854775808//-1 }}",
            "{{9223372036854775807+1}}",
            "{{2**63}}",
            "{{1e308*1e308}}",
            "{{range(1,2,0)}}",
            "{{ 'x'[::0] }}",
            "{% for a,b in [[1]] %}{% endfor %}",
            "{{ 'x'+1 }}",
            "{{ [1]|join(2) }}",
            "{{ 1 is mystery }}",
            "{{super()}}",
            "{{missing_filter|wat}}",
        ],
    ) {
        testing::assert_err(engine().render_string(source, context("{}")));
    }
    let engine = engine();
    testing::assert_ok(engine.add("outer", "first\n{% include 'inner' %}"));
    testing::assert_ok(engine.add("inner", "中文\n  {{ absent }}"));
    let error = testing::expect_err(engine.render("outer", context("{}")), "nested error");
    testing::assert_eq(error.location.template, "inner");
    testing::assert_eq(error.location.line, 2);
    testing::assert_eq(error.location.column, 6);
    testing::assert_eq(error.trace.len(), 1);
    testing::assert_eq(error.trace[0].template, "outer");
    testing::assert(error.to_string().contains("inner:2:6"));
}

#[test]
fn resource_limits_reject_cycles_deep_syntax_and_expensive_output() -> () {
    let limits = template::Limits {
        max_source_bytes: 2048,
        max_nodes: 1000,
        max_depth: 12,
        max_steps: 100,
        max_output_bytes: 32,
        max_collection: 10,
        max_include_depth: 3,
    };
    let engine = testing::expect_ok(
        Engine::new(Options { strict_undefined: true, autoescape: true, limits }),
        "limited engine",
    );
    for source in Vec::from_array(
        [
            "{{ 'a'*33 }}",
            "{{ range(11)|length }}",
            "{% for x in range(10) %}{% for y in range(10) %}x{% endfor %}{% endfor %}",
            "{{ range(10)*10 }}",
            "{{ '&'*10 }}",
            "{{ 'a'|replace('a','xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx') }}",
            "{{ ['abcdefghijklmnopqrst','abcdefghijklmnopqrst']|tojson }}",
        ],
    ) {
        testing::assert_eq(
            testing::expect_err(engine.render_string(source, context("{}")), "limited render").kind,
            ErrorKind::Limit,
        );
    }
    let values: Vec[Value] = Vec::new();
    values.push(Value::List(values));
    testing::assert_eq(
        testing::expect_err(
            engine.render_string(
                "ok",
                Value::Object(Vec::from_array([("cycle", Value::List(values))])),
            ),
            "cyclic context",
        ).kind,
        ErrorKind::Limit,
    );
    let deep = "{{ (((((((((((((((((((((1))))))))))))))))))))) }}";
    testing::assert_err(template::compile_with_limits("deep", deep, limits));
    testing::assert_ok(engine.add("a", "{% include 'b' %}"));
    testing::assert_ok(engine.add("b", "{% include 'c' %}"));
    testing::assert_ok(engine.add("c", "{% include 'd' %}"));
    testing::assert_ok(engine.add("d", "ok"));
    testing::assert_eq(
        testing::expect_err(engine.render("a", context("{}")), "include depth").kind,
        ErrorKind::Limit,
    );
}

#[test]
fn unicode_whitespace_and_disabled_autoescape_concat() -> () {
    check("A\u00a0{{- 'x' -}}\u3000B", "{}", "AxB");
    check("{{\u00a0'x'\u3000}}", "{}", "x");
    check("{{ '\u00a0é\u3000'|trim }}", "{}", "é");
    check(
        "{% autoescape false %}{{ '<b>'|safe ~ x }}{% endautoescape %}|{{ '<b>'|safe ~ x }}",
        "{\"x\":\"<x>\"}",
        "<b><x>|<b>&lt;x&gt;",
    );
    check("{{ '<B>'|safe|lower }}", "{}", "<b>");
}
