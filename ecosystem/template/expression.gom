package template;

use std::json;
use std::num;
use std::math;
use std::unicode;

struct Token {
    text: string,
    kind: isize,
    offset: isize,
}

struct ExpressionParser {
    compile: Compile,
    tokens: Vec[Token],
    cursor: Ref[isize],
}

fn digit(byte: u8) -> bool {
    byte >= 48 && byte <= 57
}

fn identifier_start(scalar: char) -> bool {
    scalar == '_' || unicode::is_letter(scalar)
}

fn identifier_continue(scalar: char) -> bool {
    identifier_start(scalar) || unicode::is_number(scalar)
}

fn white(byte: u8) -> bool {
    byte == 32 || (byte >= 9 && byte <= 13)
}

fn tokenize(compile: Compile, content: string, offset: isize) -> Result[ExpressionParser, Error] {
    let tokens = Vec::new();
    let mut index = 0;
    while index < content.byte_len() {
        let start = index;
        let byte = content.byte_get(index);
        if white(byte) {
            index += 1;
            continue;
        }
        if tokens.len() >= compile.limits.max_nodes {
            return Result::Err(
                problem(
                    compile.source,
                    offset + index,
                    ErrorKind::Limit,
                    "expression token limit exceeded",
                ),
            )
        }
        if byte == 34 || byte == 39 {
            let quote = byte;
            let encoded = Vec::from_array([34.to_u8()]);
            index += 1;
            let mut closed = false;
            while index < content.byte_len() {
                let current = content.byte_get(index);
                index += 1;
                if current == quote {
                    closed = true;
                    break;
                }
                if current == 92 {
                    if index == content.byte_len() {
                        break;
                    }
                    let escaped = content.byte_get(index);
                    index += 1;
                    if escaped == 39 {
                        encoded.push(39);
                    } else {
                        encoded.push(92);
                        encoded.push(escaped);
                    }
                } else if current == 34 {
                    encoded.push(92);
                    encoded.push(34);
                } else {
                    encoded.push(current);
                }
            }
            if !closed {
                return Result::Err(
                    problem(
                        compile.source,
                        offset + start,
                        ErrorKind::Syntax,
                        "unterminated string literal",
                    ),
                )
            }
            encoded.push(34);
            let decoded = json::parse(string_from_utf8(encoded).1).map_err(
                |message| problem(compile.source, offset + start, ErrorKind::Syntax, message),
            )?;
            let json::Value::String(value) = decoded else {
                return Result::Err(
                    problem(compile.source, offset + start, ErrorKind::Syntax, "invalid string"),
                )
            };
            tokens.push(Token { text: value, kind: 3, offset: offset + start });
        } else if digit(byte) {
            index += 1;
            while index < content.byte_len() && digit(content.byte_get(index)) {
                index += 1;
            }
            if index + 1 < content.byte_len() && content.byte_get(index) == 46
                && digit(content.byte_get(index + 1)) {
                index += 2;
                while index < content.byte_len() && digit(content.byte_get(index)) {
                    index += 1;
                }
            }
            if index < content.byte_len()
                && (content.byte_get(index) == 101 || content.byte_get(index) == 69) {
                index += 1;
                if index < content.byte_len()
                    && (content.byte_get(index) == 43 || content.byte_get(index) == 45) {
                    index += 1;
                }
                let digits = index;
                while index < content.byte_len() && digit(content.byte_get(index)) {
                    index += 1;
                }
                if digits == index {
                    return Result::Err(
                        problem(
                            compile.source,
                            offset + start,
                            ErrorKind::Syntax,
                            "exponent requires digits",
                        ),
                    )
                }
            }
            tokens.push(
                Token { text: content.byte_slice(start, index), kind: 2, offset: offset + start },
            );
        } else {
            let (scalar, width) = content.decode_at(index).or_error(
                || problem(compile.source, offset + index, ErrorKind::Syntax, "invalid UTF-8"),
            )?;
            if unicode::is_whitespace(scalar) {
                index += width;
                continue;
            }
            if identifier_start(scalar) {
                index += width;
                while let Some((next, width)) = content.decode_at(index) {
                    if !identifier_continue(next) {
                        break;
                    }
                    index += width;
                }
                tokens.push(
                    Token {
                        text: content.byte_slice(start, index),
                        kind: 1,
                        offset: offset + start,
                    },
                );
            } else {
                if !"+-*/%~()[]{},.:|<>!=".contains(scalar.to_string()) {
                    return Result::Err(
                        problem(
                            compile.source,
                            offset + index,
                            ErrorKind::Syntax,
                            f"unexpected character {scalar}",
                        ),
                    )
                }
                index += width;
                if index < content.byte_len() && content.is_char_boundary(index + 1) {
                    let pair = content.byte_slice(start, index + 1);
                    if pair == "==" || pair == "!=" || pair == "<=" || pair == ">=" || pair == "//"
                        || pair == "**" {
                        index += 1;
                    }
                }
                tokens.push(
                    Token {
                        text: content.byte_slice(start, index),
                        kind: 0,
                        offset: offset + start,
                    },
                );
            }
        }
    }
    tokens.push(Token { text: "", kind: -1, offset: offset + content.byte_len() });
    Result::Ok(ExpressionParser { compile, tokens, cursor: Ref::new(0) })
}

impl ExpressionParser {
    fn current(self: ExpressionParser) -> Token {
        self.tokens[self.cursor.get()]
    }

    fn at(self: ExpressionParser, value: string) -> bool {
        let token = self.current();
        token.kind != 3 && token.text == value
    }

    fn take(self: ExpressionParser, value: string) -> bool {
        if self.at(value) {
            self.cursor.set(self.cursor.get() + 1);
            true
        } else {
            false
        }
    }

    fn expect(self: ExpressionParser, value: string) -> Result[(), Error] {
        if self.take(value) {
            Result::Ok(())
        } else {
            Result::Err(
                problem(
                    self.compile.source,
                    self.current().offset,
                    ErrorKind::Syntax,
                    f"expected '{value}'",
                ),
            )
        }
    }

    fn name(self: ExpressionParser) -> Result[string, Error] {
        let token = self.current();
        if token.kind != 1 {
            return Result::Err(
                problem(self.compile.source, token.offset, ErrorKind::Syntax, "expected identifier"),
            )
        }
        self.cursor.set(self.cursor.get() + 1);
        Result::Ok(token.text)
    }

    fn end(self: ExpressionParser) -> Result[(), Error] {
        if self.current().kind == -1 {
            Result::Ok(())
        } else {
            Result::Err(
                problem(
                    self.compile.source,
                    self.current().offset,
                    ErrorKind::Syntax,
                    "unexpected trailing expression token",
                ),
            )
        }
    }

    fn arguments(self: ExpressionParser, close: string, depth: isize) -> Result[Vec[Expr], Error] {
        let values = Vec::new();
        if self.take(close) {
            return Result::Ok(values)
        }
        loop {
            values.push(self.parse(1, depth + 1)?);
            if self.take(close) {
                break;
            }
            self.expect(",")?;
            if self.take(close) {
                break;
            }
        }
        Result::Ok(values)
    }

    fn optional_index(self: ExpressionParser, depth: isize) -> Result[Option[Expr], Error] {
        if self.at(":") || self.at("]") {
            Result::Ok(Option::None)
        } else {
            Result::Ok(Option::Some(self.parse(1, depth + 1)?))
        }
    }

    fn atom(self: ExpressionParser, depth: isize) -> Result[Expr, Error] {
        self.compile.tick(self.current().offset, depth)?;
        let token = self.current();
        if token.kind == -1 {
            return Result::Err(
                problem(self.compile.source, token.offset, ErrorKind::Syntax, "expected expression"),
            )
        }
        self.cursor.set(self.cursor.get() + 1);
        let kind = if token.kind == 3 {
            ExprKind::Literal(Value::Text(token.text))
        } else if token.kind == 2 {
            if token.text.contains(".") || token.text.contains("e") || token.text.contains("E") {
                let value = num::parse_float64_structured(token.text).map_err(
                    |error| problem(
                        self.compile.source,
                        token.offset,
                        ErrorKind::Syntax,
                        error.to_string(),
                    ),
                )?;
                if !math::is_finite(value) {
                    return Result::Err(
                        problem(
                            self.compile.source,
                            token.offset,
                            ErrorKind::Syntax,
                            "nonfinite number literal",
                        ),
                    )
                }
                ExprKind::Literal(Value::Float(value))
            } else {
                ExprKind::Literal(
                    Value::Int(
                        num::parse_int_structured(token.text).map_err(
                            |error| problem(
                                self.compile.source,
                                token.offset,
                                ErrorKind::Syntax,
                                error.to_string(),
                            ),
                        )?.to_i64(),
                    ),
                )
            }
        } else if token.text == "true" || token.text == "True" {
            ExprKind::Literal(Value::Bool(true))
        } else if token.text == "false" || token.text == "False" {
            ExprKind::Literal(Value::Bool(false))
        } else if token.text == "none" || token.text == "None" || token.text == "null" {
            ExprKind::Literal(Value::Null)
        } else if token.text == "not" || token.text == "+" || token.text == "-" {
            if token.text == "-" && self.current().kind == 2
                && self.current().text == "9223372036854775808" {
                self.cursor.set(self.cursor.get() + 1);
                ExprKind::Literal(Value::Int(-9223372036854775808))
            } else {
                ExprKind::Unary(
                    token.text,
                    self.parse(
                        if token.text == "not" {
                            4
                        } else {
                            8
                        },
                        depth + 1,
                    )?,
                )
            }
        } else if token.kind == 1 {
            ExprKind::Name(token.text)
        } else if token.text == "[" {
            ExprKind::List(self.arguments("]", depth)?)
        } else if token.text == "(" {
            if self.take(")") {
                ExprKind::List(Vec::new())
            } else {
                let first = self.parse(1, depth + 1)?;
                if self.take(")") {
                    return Result::Ok(first)
                }
                self.expect(",")?;
                let values = Vec::from_array([first]);
                if !self.take(")") {
                    loop {
                        values.push(self.parse(1, depth + 1)?);
                        if self.take(")") {
                            break;
                        }
                        self.expect(",")?;
                        if self.take(")") {
                            break;
                        }
                    }
                }
                ExprKind::List(values)
            }
        } else if token.text == "{" {
            let fields = Vec::new();
            if !self.take("}") {
                loop {
                    let key = self.parse(1, depth + 1)?;
                    self.expect(":")?;
                    fields.push((key, self.parse(1, depth + 1)?));
                    if self.take("}") {
                        break;
                    }
                    self.expect(",")?;
                    if self.take("}") {
                        break;
                    }
                }
            }
            ExprKind::Object(fields)
        } else {
            return Result::Err(
                problem(self.compile.source, token.offset, ErrorKind::Syntax, "expected expression"),
            )
        };
        self.compile.expr(kind, token.offset, depth)
    }

    fn parse(self: ExpressionParser, minimum: isize, depth: isize) -> Result[Expr, Error] {
        let mut left = self.atom(depth)?;
        loop {
            let token = self.current();
            if token.kind == -1 || token.kind == 3 {
                break;
            }
            if self.take(".") {
                let field = self.current();
                let key = if field.kind == 2 {
                    self.cursor.set(self.cursor.get() + 1);
                    ExprKind::Literal(
                        Value::Int(
                            num::parse_int_structured(field.text).map_err(
                                |error| problem(
                                    self.compile.source,
                                    field.offset,
                                    ErrorKind::Syntax,
                                    error.to_string(),
                                ),
                            )?.to_i64(),
                        ),
                    )
                } else {
                    ExprKind::Literal(Value::Text(self.name()?))
                };
                left = self.compile.expr(
                    ExprKind::Index(left, self.compile.expr(key, field.offset, depth)?),
                    token.offset,
                    depth,
                )?;
                continue;
            }
            if self.take("[") {
                let start = self.optional_index(depth)?;
                if self.take(":") {
                    let end = self.optional_index(depth)?;
                    let step = if self.take(":") {
                        self.optional_index(depth)?
                    } else {
                        Option::None
                    };
                    self.expect("]")?;
                    left = self.compile.expr(
                        ExprKind::Slice(left, start, end, step),
                        token.offset,
                        depth,
                    )?;
                } else {
                    let key = start.or_error(
                        || problem(
                            self.compile.source,
                            token.offset,
                            ErrorKind::Syntax,
                            "index requires a value",
                        ),
                    )?;
                    self.expect("]")?;
                    left = self.compile.expr(ExprKind::Index(left, key), token.offset, depth)?;
                }
                continue;
            }
            if self.take("(") {
                let ExprKind::Name(name) = left.kind else {
                    return Result::Err(
                        problem(
                            self.compile.source,
                            token.offset,
                            ErrorKind::Syntax,
                            "only named functions may be called",
                        ),
                    )
                };
                left = self.compile.expr(
                    ExprKind::Call(name, self.arguments(")", depth)?),
                    token.offset,
                    depth,
                )?;
                continue;
            }
            if self.take("|") {
                let name = self.name()?;
                let args = if self.take("(") {
                    self.arguments(")", depth)?
                } else {
                    Vec::new()
                };
                left = self.compile.expr(ExprKind::Filter(left, name, args), token.offset, depth)?;
                continue;
            }
            let precedence = match token.text {
                "if" => 1,
                "or" => 2,
                "and" => 3,
                "==" | "!=" | "<" | ">" | "<=" | ">=" | "in" | "is" | "not" => 4,
                "~" => 5,
                "+" | "-" => 6,
                "*" | "/" | "//" | "%" => 7,
                "**" => 9,
                _ => 0,
            };
            if precedence == 0 || precedence < minimum {
                break;
            }
            self.cursor.set(self.cursor.get() + 1);
            if token.text == "if" {
                let condition = self.parse(2, depth + 1)?;
                self.expect("else")?;
                let fallback = self.parse(1, depth + 1)?;
                left = self.compile.expr(
                    ExprKind::Choose(condition, left, fallback),
                    token.offset,
                    depth,
                )?;
            } else if token.text == "is" {
                let negate = self.take("not");
                let name = self.name()?;
                left = self.compile.expr(ExprKind::Test(left, name, negate), token.offset, depth)?;
            } else {
                let operator = if token.text == "not" {
                    self.expect("in")?;
                    "not in"
                } else {
                    token.text
                };
                let right = self.parse(
                    if operator == "**" {
                        precedence
                    } else {
                        precedence + 1
                    },
                    depth + 1,
                )?;
                let kind = if precedence == 4 {
                    match left.kind {
                        ExprKind::Compare(first, comparisons) => {
                            comparisons.push((operator, right));
                            ExprKind::Compare(first, comparisons)
                        },
                        _ => ExprKind::Compare(left, Vec::from_array([(operator, right)])),
                    }
                } else {
                    ExprKind::Binary(operator, left, right)
                };
                left = self.compile.expr(kind, token.offset, depth)?;
            }
        }
        Result::Ok(left)
    }
}
