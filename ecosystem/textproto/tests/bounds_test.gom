package tests;

use ecosystem::textproto;
use textproto::{ErrorKind, Headers, Limits, Reader, Writer};
use std::bytes;
use std::io;
use io::{Read, Write};
use std::testing;

#[test]
fn header_limits_are_independent_and_exact() -> () {
    let wire = bytes::Bytes::from_vec(b"A: one\r\nA: two\r\n\r\n");
    let exact = Limits {
        max_line_bytes: 6,
        max_header_bytes: wire.len(),
        max_headers: 2,
        max_value_bytes: 3,
        ..Limits::standard(),
    };
    let reader = testing::expect_ok(Reader::new(io::Cursor::new(wire), exact), "exact reader");
    testing::assert_eq(testing::expect_ok(reader.read_headers(false), "exact headers").len(), 2);
    for limits in Vec::from_array(
        [
            Limits { max_header_bytes: wire.len() - 1, ..exact },
            Limits { max_headers: 1, ..exact },
            Limits { max_value_bytes: 2, ..exact },
            Limits { max_line_bytes: 5, ..exact },
        ],
    ) {
        let reader = testing::expect_ok(
            Reader::new(io::Cursor::new(wire), limits),
            "limited reader",
        );
        testing::assert(reader.read_headers(false).is_err());
        testing::assert_eq(
            testing::expect_err(reader.read_headers(false), "sticky header reader").kind,
            ErrorKind::Closed,
        );
    }
    let output = io::Cursor::new(bytes::Bytes::new());
    let writer = testing::expect_ok(Writer::new(output, exact), "writer");
    let headers = Headers::new();
    testing::assert_ok(headers.append("A", bytes::Bytes::from_vec(b"one")));
    testing::assert_ok(headers.append("A", bytes::Bytes::from_vec(b"two")));
    testing::assert_ok(writer.write_headers(headers));
    testing::assert(output.bytes().to_vec() == wire.to_vec());
}

#[test]
fn dot_limits_cover_decoded_bytes_and_terminator() -> () {
    let limits = Limits { max_dot_bytes: 6, ..Limits::standard() };
    let reader = testing::expect_ok(
        Reader::new(io::Cursor::new(bytes::Bytes::from_vec(b"..abc\r\n.\r\n")), limits),
        "reader",
    );
    testing::assert(
        testing::expect_ok(reader.read_dot_bytes(), "exact dot").to_vec() == b".abc\r\n",
    );
    let limits = Limits { max_dot_bytes: 5, ..Limits::standard() };
    let reader = testing::expect_ok(
        Reader::new(io::Cursor::new(bytes::Bytes::from_vec(b"..abc\r\n.\r\n")), limits),
        "limited reader",
    );
    testing::assert_eq(
        testing::expect_err(reader.read_dot_bytes(), "dot limit").kind,
        ErrorKind::Limit,
    );
    let output = io::Cursor::new(bytes::Bytes::new());
    let writer = testing::expect_ok(Writer::new(output, limits), "writer");
    testing::assert_ok(writer.begin_dot());
    testing::assert_eq(
        testing::expect_err(writer.write_dot_chunk(b".abc\r\n".as_slice()), "dot limit").kind,
        ErrorKind::Limit,
    );
    testing::assert_eq(output.bytes().len(), 0);
    testing::assert_ok(writer.write_dot_chunk(b"abc".as_slice()));
    testing::assert_ok(writer.finish_dot());
    testing::assert(output.bytes().to_vec() == b"abc\r\n.\r\n");
}

struct FailingReader {
    calls: Ref[isize],
}

impl Read for FailingReader {
    fn read(self: FailingReader, output: MutSlice[byte]) -> Result[isize, io::Error] {
        self.calls.set(self.calls.get() + 1);
        Result::Err(
            io::Error::new(io::ErrorKind::Interrupted, "read", Option::None, Option::None, "failed"),
        )
    }
}

struct FailingWriter {
    calls: Ref[isize],
}

impl Write for FailingWriter {
    fn write(self: FailingWriter, input: Slice[byte]) -> Result[isize, io::Error] {
        self.calls.set(self.calls.get() + 1);
        Result::Err(
            io::Error::new(
                io::ErrorKind::Interrupted,
                "write",
                Option::None,
                Option::None,
                "failed",
            ),
        )
    }
}

#[test]
fn provider_failures_are_terminal_without_replay() -> () {
    let source = FailingReader { calls: Ref::new(0) };
    let reader = testing::expect_ok(Reader::new(source, Limits::standard()), "reader");
    testing::assert_eq(testing::expect_err(reader.read_line(), "source fault").kind, ErrorKind::Io);
    testing::assert_eq(testing::expect_err(reader.read_line(), "terminal").kind, ErrorKind::Closed);
    testing::assert_eq(source.calls.get(), 1);
    let sink = FailingWriter { calls: Ref::new(0) };
    let writer = testing::expect_ok(Writer::new(sink, Limits::standard()), "writer");
    testing::assert_eq(
        testing::expect_err(writer.write_line(bytes::Bytes::from_vec(b"x")), "sink fault").kind,
        ErrorKind::Io,
    );
    testing::assert_eq(
        testing::expect_err(writer.write_line(bytes::Bytes::from_vec(b"x")), "terminal").kind,
        ErrorKind::Closed,
    );
    testing::assert_eq(sink.calls.get(), 1);
}
