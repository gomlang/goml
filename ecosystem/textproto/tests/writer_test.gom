package tests;

use ecosystem::textproto;
use textproto::{ErrorKind, Headers, Limits, Reader, Writer};
use std::bytes;
use std::io;
use std::testing;

#[test]
fn writer_frames_headers_and_dot_body_across_chunks() -> () {
    let output = io::Cursor::new(bytes::Bytes::new());
    let writer = testing::expect_ok(Writer::new(output, Limits::standard()), "writer");
    testing::assert_ok(writer.write_line(bytes::Bytes::from_vec(b"READY")));
    let headers = Headers::new();
    testing::assert_ok(headers.append("x-name", bytes::Bytes::from_vec(b"one")));
    testing::assert_ok(headers.append("X-NAME", bytes::Bytes::from_vec(b"two")));
    testing::assert_ok(writer.write_headers(headers));
    testing::assert_ok(writer.begin_dot());
    testing::assert_eq(
        testing::expect_ok(writer.write_dot_chunk(b"hello\r".as_slice()), "first chunk"),
        6,
    );
    testing::assert_eq(
        testing::expect_ok(writer.write_dot_chunk(b"\n.dot\r\n".as_slice()), "second chunk"),
        7,
    );
    testing::assert_ok(writer.finish_dot());
    testing::assert_ok(writer.finish_dot());
    testing::assert_ok(writer.write_line(bytes::Bytes::from_vec(b"NEXT")));
    testing::assert(
        output.bytes().to_vec()
            == b"READY\r\nX-Name: one\r\nX-Name: two\r\n\r\nhello\r\n..dot\r\n.\r\nNEXT\r\n",
    );
    let reader = testing::expect_ok(
        Reader::new(io::Cursor::new(output.bytes()), Limits::standard()),
        "roundtrip reader",
    );
    testing::assert(testing::expect_ok(reader.read_line(), "line").is_some());
    testing::assert_eq(testing::expect_ok(reader.read_headers(false), "headers").len(), 2);
    testing::assert(
        testing::expect_ok(reader.read_dot_bytes(), "dot body").to_vec() == b"hello\r\n.dot\r\n",
    );
    testing::assert(testing::expect_ok(reader.read_line(), "tail").is_some());
}

#[test]
fn writer_rejects_invalid_input_before_emitting_it() -> () {
    let output = io::Cursor::new(bytes::Bytes::new());
    let writer = testing::expect_ok(Writer::new(output, Limits::standard()), "writer");
    testing::assert_eq(
        testing::expect_err(writer.write_line(bytes::Bytes::from_vec(b"bad\nline")), "line").kind,
        ErrorKind::Invalid,
    );
    testing::assert_eq(output.bytes().len(), 0);
    let headers = Headers::new();
    testing::assert(headers.append("bad name", bytes::Bytes::from_vec(b"value")).is_err());
    testing::assert(headers.append("valid", bytes::Bytes::from_vec(b"bad\rvalue")).is_err());
    testing::assert_ok(writer.begin_dot());
    testing::assert_eq(
        testing::expect_err(writer.write_dot_chunk(b"bad\n".as_slice()), "bare LF").kind,
        ErrorKind::Invalid,
    );
    testing::assert_eq(output.bytes().len(), 0);
    testing::assert_ok(writer.write_dot_chunk(b"good".as_slice()));
    testing::assert_ok(writer.finish_dot());
    testing::assert(output.bytes().to_vec() == b"good\r\n.\r\n");
}
