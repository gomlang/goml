package tests;

use ecosystem::textproto;
use textproto::{ErrorKind, Limits, Reader};
use std::bytes;
use std::io;
use std::testing;

#[test]
fn lines_headers_and_dot_blocks_share_one_stream() -> () {
    let source = io::Cursor::new(
        bytes::Bytes::from_vec(
            b"READY\r\nX-Name: one\r\nx-name: two\r\nX-Long: first\r\n second\r\n\r\nhello\r\n..dot\r\n.\r\nNEXT\r\n",
        ),
    );
    let reader = testing::expect_ok(Reader::new(source, Limits::standard()), "reader");
    testing::assert(
        testing::expect_some(testing::expect_ok(reader.read_line(), "line"), "line").to_vec()
            == b"READY",
    );
    let headers = testing::expect_ok(reader.read_headers(true), "headers");
    testing::assert_eq(headers.len(), 3);
    testing::assert_eq(headers.values("x-name").len(), 2);
    testing::assert(headers.values("X-Name")[0].to_vec() == b"one");
    testing::assert(headers.values("X-Name")[1].to_vec() == b"two");
    testing::assert(headers.values("X-Long")[0].to_vec() == b"first second");
    testing::assert(
        testing::expect_ok(reader.read_dot_bytes(), "dot body").to_vec() == b"hello\r\n.dot\r\n",
    );
    testing::assert(
        testing::expect_some(testing::expect_ok(reader.read_line(), "following line"), "line").to_vec()
            == b"NEXT",
    );
    testing::assert(testing::expect_ok(reader.read_line(), "EOF").is_none());
}

#[test]
fn invalid_framing_and_limits_poison_reader() -> () {
    let reader = testing::expect_ok(
        Reader::new(io::Cursor::new(bytes::Bytes::from_vec(b"abc\n")), Limits::standard()),
        "reader",
    );
    testing::assert_eq(testing::expect_err(reader.read_line(), "bare LF").kind, ErrorKind::Invalid);
    testing::assert_eq(testing::expect_err(reader.read_line(), "sticky").kind, ErrorKind::Closed);
    let limits = Limits { max_line_bytes: 2, ..Limits::standard() };
    let reader = testing::expect_ok(
        Reader::new(io::Cursor::new(bytes::Bytes::from_vec(b"abc\r\n")), limits),
        "limited reader",
    );
    testing::assert(reader.read_line().is_err());
    let reader = testing::expect_ok(
        Reader::new(
            io::Cursor::new(bytes::Bytes::from_vec(b"X: one\r\n folded\r\n\r\n")),
            Limits::standard(),
        ),
        "headers",
    );
    testing::assert_eq(
        testing::expect_err(reader.read_headers(false), "folded header").kind,
        ErrorKind::Invalid,
    );
    let reader = testing::expect_ok(
        Reader::new(io::Cursor::new(bytes::Bytes::from_vec(b".bad\r\n.\r\n")), Limits::standard()),
        "dot",
    );
    testing::assert_eq(
        testing::expect_err(reader.read_dot_bytes(), "dot escape").kind,
        ErrorKind::Invalid,
    );
}

#[test]
fn header_octets_and_snapshots_keep_text_policy_explicit() -> () {
    testing::assert_eq(
        testing::expect_ok(textproto::canonical_key("x-HTTP-ID"), "key"),
        "X-Http-Id",
    );
    for line in Vec::from_array([b"bad name: value", b"X: bad\x00value", b"X: bad\t\x7f"]) {
        testing::assert(textproto::parse_header_line(bytes::Bytes::from_vec(line)).is_err());
    }
    let raw = bytes::Bytes::from_vec(b"\xff");
    let headers = textproto::Headers::new();
    testing::assert_ok(headers.append("X-Bytes", raw));
    raw.set(0, b'x');
    testing::assert(headers.values("x-bytes")[0].to_vec() == b"\xff");
    testing::assert(headers.fields()[0].value_text().is_err());
    let snapshot = headers.fields();
    snapshot[0].value.set(0, b'y');
    testing::assert(headers.values("x-bytes")[0].to_vec() == b"\xff");
}
