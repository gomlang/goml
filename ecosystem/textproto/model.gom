package textproto;

use std::bytes;
use std::utf8;
use utf8::BytesUtf8;

#[derive(Debug, PartialEq)]
pub enum ErrorKind {
    Invalid,
    Truncated,
    Limit,
    Io,
    Closed,
    State,
}

pub struct Error {
    pub kind: ErrorKind,
    pub offset: isize,
    pub message: string,
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        f"textproto at {self.offset}: {self.message}"
    }
}

impl Debug for Error {
    fn debug(self: Error) -> string {
        self.to_string()
    }
}

fn failure(kind: ErrorKind, offset: isize, message: string) -> Error {
    Error { kind, offset, message }
}

pub struct Limits {
    pub max_line_bytes: isize,
    pub max_header_bytes: isize,
    pub max_headers: isize,
    pub max_value_bytes: isize,
    pub max_dot_bytes: isize,
}

impl Limits {
    pub fn standard() -> Limits {
        Limits {
            max_line_bytes: 8192,
            max_header_bytes: 65536,
            max_headers: 128,
            max_value_bytes: 16384,
            max_dot_bytes: 67108864,
        }
    }

    pub fn validate(self: Limits) -> Result[(), Error] {
        if self.max_line_bytes < 0 || self.max_line_bytes > 9223372036854775805
            || self.max_header_bytes < 0
            || self.max_headers < 0
            || self.max_value_bytes < 0
            || self.max_dot_bytes < 0 {
            return Result::Err(failure(ErrorKind::Limit, 0, "invalid textproto limits"))
        }
        Result::Ok(())
    }
}

pub struct Field {
    pub name: string,
    pub value: bytes::Bytes,
}

impl Field {
    pub fn value_text(self: Field) -> Result[string, Error] {
        self.value.to_string_utf8().map_err(
            |error| failure(ErrorKind::Invalid, 0, error.to_string()),
        )
    }
}

pub struct Headers {
    fields_value: Vec[Field],
}

impl Headers {
    pub fn new() -> Headers {
        Headers { fields_value: Vec::new() }
    }

    pub fn len(self: Headers) -> isize {
        self.fields_value.len()
    }

    pub fn fields(self: Headers) -> Vec[Field] {
        let result = Vec::new();
        for field in self.fields_value {
            result.push(Field { name: field.name, value: field.value.copy() });
        }
        result
    }

    pub fn append(self: Headers, name: string, value: bytes::Bytes) -> Result[(), Error] {
        let name = canonical_key(name)?;
        validate_value(value)?;
        self.fields_value.push(Field { name, value: value.copy() });
        Result::Ok(())
    }

    pub fn values(self: Headers, name: string) -> Vec[bytes::Bytes] {
        let values = Vec::new();
        let key = canonical_key(name).unwrap_or("");
        for field in self.fields_value {
            if field.name == key {
                values.push(field.value.copy());
            }
        }
        values
    }
}

fn header_token(value: byte) -> bool {
    (value >= b'a' && value <= b'z') || (value >= b'A' && value <= b'Z')
        || (value >= b'0' && value <= b'9')
        || value == b'!'
        || value == b'#'
        || value == b'$'
        || value == b'%'
        || value == b'&'
        || value == b'\''
        || value == b'*'
        || value == b'+'
        || value == b'-'
        || value == b'.'
        || value == b'^'
        || value == b'_'
        || value == b'`'
        || value == b'|'
        || value == b'~'
}

pub fn canonical_key(value: string) -> Result[string, Error] {
    let data = value.to_bytes();
    if data.len() == 0 {
        return Result::Err(failure(ErrorKind::Invalid, 0, "empty header name"))
    }
    let output: Vec[byte] = Vec::with_capacity(data.len());
    let mut initial = true;
    for byte in data {
        if !header_token(byte) {
            return Result::Err(failure(ErrorKind::Invalid, 0, "invalid header name"))
        }
        output.push(
            if byte >= b'a' && byte <= b'z' && initial {
                byte - 32
            } else if byte >= b'A' && byte <= b'Z' && !initial {
                byte + 32
            } else {
                byte
            },
        );
        initial = byte == b'-';
    }
    Result::Ok(string_from_utf8(output).1)
}

fn trim_horizontal(data: bytes::Bytes) -> bytes::Bytes {
    let mut start = 0;
    while start < data.len() && (data.get(start) == b' ' || data.get(start) == b'\t') {
        start += 1;
    }
    let mut end = data.len();
    while end > start && (data.get(end - 1) == b' ' || data.get(end - 1) == b'\t') {
        end -= 1;
    }
    bytes::Bytes::from_slice_copy(data.slice(start, end))
}

fn validate_value(data: bytes::Bytes) -> Result[(), Error] {
    for byte in data.as_slice() {
        if byte == 0 || byte == 127 || (byte < 32 && byte != b'\t') {
            return Result::Err(failure(ErrorKind::Invalid, 0, "invalid header value"))
        }
    }
    Result::Ok(())
}

pub fn parse_header_line(line: bytes::Bytes) -> Result[Field, Error] {
    let mut colon = 0;
    while colon < line.len() && line.get(colon) != b':' {
        colon += 1;
    }
    if colon == 0 || colon == line.len() {
        return Result::Err(failure(ErrorKind::Invalid, 0, "invalid header line"))
    }
    let name = canonical_key(string_from_utf8(line.slice(0, colon).to_vec()).1)?;
    let value = trim_horizontal(bytes::Bytes::from_slice_copy(line.slice(colon + 1, line.len())));
    validate_value(value)?;
    Result::Ok(Field { name, value })
}
