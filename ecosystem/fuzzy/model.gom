package fuzzy;

use std::context;

#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    InvalidOptions,
    IncompatiblePreparation,
    InputLimit,
    PatternLimit,
    WorkLimit,
    InvalidLimit,
    Cancelled,
    DeadlineExceeded,
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        match self {
            InvalidOptions => "invalid fuzzy matcher options",
            IncompatiblePreparation => "prepared fuzzy input uses incompatible matching options",
            InputLimit => "fuzzy candidate exceeds input limit",
            PatternLimit => "fuzzy pattern exceeds input limit",
            WorkLimit => "fuzzy match exceeds matrix work limit",
            InvalidLimit => "invalid fuzzy search result or worker limit",
            Cancelled => "fuzzy search cancelled",
            DeadlineExceeded => "fuzzy search deadline exceeded",
        }
    }
}

fn check_context(value: context::Context) -> Result[(), Error] {
    value.check().map_err(
        |error| match error {
            context::Error::Cancelled => Error::Cancelled,
            context::Error::DeadlineExceeded => Error::DeadlineExceeded,
        },
    )
}

#[derive(Debug, PartialEq, Eq)]
pub enum CaseMode {
    Sensitive,
    Fold,
    Smart,
}

#[derive(Debug, PartialEq, Eq)]
pub enum MatchKind {
    Fuzzy,
    Substring,
    Prefix,
    Suffix,
    Exact,
}

pub struct Options {
    pub case_mode: CaseMode,
    pub max_bytes: isize,
    pub max_units: isize,
    pub max_pattern_units: isize,
    pub max_cells: isize,
    pub max_results: isize,
    pub path_bonus: bool,
}

impl Options {
    pub fn new() -> Options {
        Options {
            case_mode: CaseMode::Smart,
            max_bytes: 1048576,
            max_units: 32768,
            max_pattern_units: 256,
            max_cells: 2097152,
            max_results: 10000,
            path_bonus: true,
        }
    }
}

#[derive(Debug, PartialEq, Eq)]
pub struct Range {
    pub start: isize,
    pub end: isize,
}

pub struct Match {
    pub score: isize,
    pub ranges: Vec[Range],
    pub graphemes: Vec[isize],
}

pub struct Hit {
    pub index: isize,
    pub text: string,
    pub matched: Match,
}

pub struct Report {
    pub hits: Vec[Hit],
    pub total: isize,
    pub scanned: isize,
}

struct Unit {
    value: char,
    start: isize,
    end: isize,
    grapheme: isize,
    bonus: isize,
}

pub struct Candidate {
    value: string,
    sensitive: Vec[Unit],
    folded: Vec[Unit],
    path_bonus: bool,
}

impl Candidate {
    pub fn text(self: Candidate) -> string {
        self.value
    }
}

pub struct Pattern {
    value: string,
    units: Vec[char],
    sensitive: bool,
    kind: MatchKind,
    case_mode: CaseMode,
}

pub struct Matcher {
    options: Options,
}
