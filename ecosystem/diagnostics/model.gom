package diagnostics;

#[derive(Debug, PartialEq, Eq)]
pub enum Severity {
    Error,
    Warning,
    Advice,
    Note,
}

impl ToString for Severity {
    fn to_string(self: Severity) -> string {
        match self {
            Error => "error",
            Warning => "warning",
            Advice => "advice",
            Note => "note",
        }
    }
}

#[derive(Debug, PartialEq, Eq)]
pub enum LabelKind {
    Primary,
    Secondary,
}

#[derive(Debug, PartialEq, Eq)]
pub struct Label {
    pub span: Span,
    pub message: string,
    pub kind: LabelKind,
}

impl Label {
    pub fn primary(span: Span, message: string) -> Label {
        Label { span, message, kind: LabelKind::Primary }
    }

    pub fn secondary(span: Span, message: string) -> Label {
        Label { span, message, kind: LabelKind::Secondary }
    }
}

#[derive(Debug, PartialEq, Eq)]
pub enum NoteKind {
    Note,
    Help,
}

#[derive(Debug, PartialEq, Eq)]
pub struct Note {
    pub kind: NoteKind,
    pub message: string,
}

#[derive(Debug, PartialEq, Eq)]
pub enum Applicability {
    MachineApplicable,
    MaybeIncorrect,
    HasPlaceholders,
    Unspecified,
}

impl ToString for Applicability {
    fn to_string(self: Applicability) -> string {
        match self {
            MachineApplicable => "machine applicable",
            MaybeIncorrect => "review required",
            HasPlaceholders => "contains placeholders",
            Unspecified => "unspecified applicability",
        }
    }
}

#[derive(Debug, PartialEq, Eq)]
pub struct Edit {
    pub span: Span,
    pub replacement: string,
}

impl Edit {
    pub fn new(span: Span, replacement: string) -> Edit {
        Edit { span, replacement }
    }
}

#[derive(PartialEq, Eq)]
pub struct Suggestion {
    pub message: string,
    pub applicability: Applicability,
    pub edits: Vec[Edit],
}

impl Suggestion {
    pub fn new(message: string, applicability: Applicability) -> Suggestion {
        Suggestion { message, applicability, edits: Vec::new() }
    }

    pub fn with_edit(self: Suggestion, edit: Edit) -> Suggestion {
        let edits = copied(self.edits);
        edits.push(edit);
        Suggestion { edits, ..self }
    }
}

#[derive(PartialEq, Eq)]
pub struct Diagnostic {
    pub severity: Severity,
    pub code: Option[string],
    pub message: string,
    pub labels: Vec[Label],
    pub notes: Vec[Note],
    pub suggestions: Vec[Suggestion],
}

impl Diagnostic {
    pub fn new(severity: Severity, message: string) -> Diagnostic {
        Diagnostic {
            severity,
            code: Option::None,
            message,
            labels: Vec::new(),
            notes: Vec::new(),
            suggestions: Vec::new(),
        }
    }

    pub fn with_code(self: Diagnostic, code: string) -> Diagnostic {
        Diagnostic { code: Option::Some(code), ..self }
    }

    pub fn with_label(self: Diagnostic, label: Label) -> Diagnostic {
        let labels = copied(self.labels);
        labels.push(label);
        Diagnostic { labels, ..self }
    }

    pub fn with_note(self: Diagnostic, message: string) -> Diagnostic {
        let notes = copied(self.notes);
        notes.push(Note { kind: NoteKind::Note, message });
        Diagnostic { notes, ..self }
    }

    pub fn with_help(self: Diagnostic, message: string) -> Diagnostic {
        let notes = copied(self.notes);
        notes.push(Note { kind: NoteKind::Help, message });
        Diagnostic { notes, ..self }
    }

    pub fn with_suggestion(self: Diagnostic, suggestion: Suggestion) -> Diagnostic {
        let suggestions = copied(self.suggestions);
        suggestions.push(suggestion);
        Diagnostic { suggestions, ..self }
    }
}

fn copied[T](values: Vec[T]) -> Vec[T] {
    let result = Vec::new();
    for value in values {
        result.push(value);
    }
    result
}

impl Debug for Suggestion {
    fn debug(self: Suggestion) -> string {
        f"Suggestion({self.message}, {self.edits.len()} edits)"
    }
}

impl Debug for Diagnostic {
    fn debug(self: Diagnostic) -> string {
        f"Diagnostic({self.severity.to_string()}, {self.message}, {self.labels.len()} labels)"
    }
}
