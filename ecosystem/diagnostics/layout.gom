package diagnostics;

use ecosystem::unicode_text;
use std::text;

struct Cell {
    start: isize,
    end: isize,
    column: isize,
    width: isize,
    text: string,
}

fn unsafe_character(value: char) -> bool {
    (value < '\u0020' || (value >= '\u007f' && value <= '\u009f'))
        || (value >= '\u202a' && value <= '\u202e')
        || (value >= '\u2066' && value <= '\u2069')
        || value == '\u061c'
        || value == '\u200e'
        || value == '\u200f'
        || value == '\u2028'
        || value == '\u2029'
}

fn clean_metadata(value: string) -> string {
    let result = text::StringBuilder::new();
    for character in value.chars() {
        if character == '\n' {
            result.write_string("\\n");
        } else if character == '\r' {
            result.write_string("\\r");
        } else if character == '\t' {
            result.write_string("\\t");
        } else if unsafe_character(character) {
            result.write_string("�");
        } else {
            result.write_char(character);
        }
    }
    result.finish()
}

fn clean_cluster(value: string) -> string {
    let result = text::StringBuilder::new();
    for character in value.chars() {
        if unsafe_character(character) {
            result.write_string("�");
        } else {
            result.write_char(character);
        }
    }
    result.finish()
}

fn line_cells(line: SourceLine, width: unicode_text::WidthOptions, tab_stop: isize) -> Vec[Cell] {
    let cells = Vec::new();
    let mut column = 0;
    for cluster in unicode_text::graphemes(line.text) {
        let mut value = clean_cluster(cluster.text);
        let mut columns = unicode_text::width_with(value, width);
        if cluster.text == "\t" {
            columns = tab_stop - column % tab_stop;
            value = text::repeat(" ", columns);
        } else if columns == 0 {
            value = "◌" + value;
            columns = unicode_text::width_with(value, width);
        }
        cells.push(
            Cell {
                start: line.start + cluster.start,
                end: line.start + cluster.end,
                column,
                width: columns,
                text: value,
            },
        );
        column += columns;
    }
    cells
}

fn column_at(cells: Vec[Cell], offset: isize, round_up: bool) -> isize {
    for cell in cells {
        if offset <= cell.start {
            return cell.column;
        }
        if offset < cell.end {
            return cell.column
                + if round_up {
                    cell.width
                } else {
                    0
                };
        }
    }
    if cells.is_empty() {
        0
    } else {
        let cell = cells[cells.len() - 1];
        cell.column + cell.width
    }
}

fn cells_width(cells: Vec[Cell]) -> isize {
    if cells.is_empty() {
        0
    } else {
        let cell = cells[cells.len() - 1];
        cell.column + cell.width
    }
}

fn cell_window(cells: Vec[Cell], start: isize, columns: isize) -> string {
    let output = text::StringBuilder::new();
    let end = start + columns;
    for cell in cells {
        let last = cell.column + cell.width;
        if last <= start {
            continue;
        }
        if cell.column >= end {
            break;
        }
        if cell.column < start || last > end {
            output.write_string(text::repeat(" ", minimum(last, end) - maximum(cell.column, start)));
        } else {
            output.write_string(cell.text);
        }
    }
    output.finish()
}

fn clipped(value: string, columns: isize, width: unicode_text::WidthOptions) -> string {
    if unicode_text::width_with(value, width) <= columns {
        return value;
    }
    if columns < 3 {
        return text::repeat(".", maximum(columns, 0));
    }
    unicode_text::truncate_with(value, columns - 3, width) + "..."
}
