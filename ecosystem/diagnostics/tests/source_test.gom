package tests;

use ecosystem::diagnostics;
use ecosystem::unicode_text;
use std::testing;

#[test]
fn checked_spans_use_byte_boundaries_and_cache_identity() -> () {
    let cache = diagnostics::SourceCache::new();
    let other = diagnostics::SourceCache::new();
    let file = testing::expect_ok(cache.add("unicode.gom", "中é👩‍💻"), "add");
    testing::assert_eq(
        testing::expect_ok(cache.text(testing::expect_ok(cache.span(file, 0, 3), "span")), "text"),
        "中",
    );
    testing::assert(cache.span(file, -1, 0).is_err());
    testing::assert(cache.span(file, 4, 3).is_err());
    testing::assert(cache.span(file, 0, 100).is_err());
    testing::assert_eq(
        testing::expect_err(cache.span(file, 1, 3), "boundary"),
        diagnostics::Error::CharacterBoundary(1),
    );
    testing::assert_eq(
        testing::expect_err(cache.span(file, 0, 5), "combining scalar"),
        diagnostics::Error::CharacterBoundary(5),
    );
    testing::assert(other.get(file).is_err());
    testing::expect_ok(cache.span(file, 4, 6), "combining mark is a valid byte span");
    let foreign = testing::expect_ok(other.add("other", "same index"), "other");
    testing::assert(file != foreign);
    let source = testing::expect_ok(cache.get(file), "source");
    testing::expect_ok(cache.add("later", "more"), "later");
    testing::assert_eq(source.text(), "中é👩‍💻");
    testing::assert_eq(cache.len(), 2);
}

#[test]
fn source_lines_preserve_crlf_lone_cr_empty_and_eof_positions() -> () {
    let cache = diagnostics::SourceCache::new();
    let file = testing::expect_ok(cache.add("lines", "a\r\n中\rc\n"), "source");
    let source = testing::expect_ok(cache.get(file), "get");
    testing::assert_eq(source.line_count(), 4);
    let first = testing::expect_some(source.line(0), "first");
    testing::assert_eq(first.start, 0);
    testing::assert_eq(first.end, 1);
    testing::assert_eq(first.next, 3);
    testing::assert_eq(testing::expect_some(source.line(1), "second").text, "中");
    testing::assert_eq(testing::expect_some(source.line(3), "last").text, "");
    testing::assert(source.line(-1).is_none());
    testing::assert(source.line(4).is_none());
    let crlf = testing::expect_ok(source.location(2, unicode_text::WidthOptions::new(), 4), "crlf");
    testing::assert_eq(crlf, diagnostics::Location { line: 0, byte_column: 1, display_column: 1 });
    let eof = testing::expect_ok(
        source.location(source.byte_len(), unicode_text::WidthOptions::new(), 4),
        "eof",
    );
    testing::assert_eq(eof, diagnostics::Location { line: 3, byte_column: 0, display_column: 0 });
    let empty = testing::expect_ok(
        cache.get(testing::expect_ok(cache.add("empty", ""), "empty")),
        "empty source",
    );
    testing::assert_eq(empty.line_count(), 1);
    testing::expect_ok(empty.span(0, 0), "empty span");
}

#[test]
fn display_columns_follow_graphemes_tabs_and_safe_controls() -> () {
    let cache = diagnostics::SourceCache::new();
    let file = testing::expect_ok(cache.add("width", "\t中é👩‍💻\u001bX"), "source");
    let source = testing::expect_ok(cache.get(file), "get");
    let width = unicode_text::WidthOptions::new();
    testing::assert_eq(
        testing::expect_ok(source.location(1, width, 4), "after tab").display_column,
        4,
    );
    testing::assert_eq(
        testing::expect_ok(source.location(4, width, 4), "after CJK").display_column,
        6,
    );
    testing::assert_eq(
        testing::expect_ok(source.location(5, width, 4), "inside cluster").display_column,
        6,
    );
    testing::assert_eq(
        testing::expect_ok(source.location(7, width, 4), "after cluster").display_column,
        7,
    );
    testing::assert_eq(
        testing::expect_ok(source.location(11, width, 4), "inside emoji").display_column,
        7,
    );
    testing::assert_eq(
        testing::expect_ok(source.location(19, width, 4), "after escape").display_column,
        10,
    );
    testing::assert(source.location(0, width, 0).is_err());
    testing::assert(source.location(2, width, 4).is_err());
    let narrow = unicode_text::WidthOptions { emoji_wide: false, ..width };
    testing::assert_eq(
        testing::expect_ok(source.location(18, narrow, 8), "custom policy").display_column,
        12,
    );
}

#[test]
fn source_limits_are_checked_before_cache_mutation() -> () {
    let limits = diagnostics::SourceLimits {
        max_files: 2,
        max_file_bytes: 4,
        max_total_bytes: 5,
        max_lines_per_file: 2,
    };
    let cache = testing::expect_ok(diagnostics::SourceCache::with_limits(limits), "cache");
    testing::assert(cache.add("large", "12345").is_err());
    testing::assert(cache.add("lines", "\n\n").is_err());
    testing::assert_eq(cache.len(), 0);
    testing::expect_ok(cache.add("one", "1234"), "first");
    testing::assert(cache.add("two", "12").is_err());
    testing::expect_ok(cache.add("two", "5"), "second");
    testing::assert(cache.add("three", "").is_err());
    testing::assert_eq(cache.total_bytes(), 5);
    testing::assert(
        diagnostics::SourceCache::with_limits(diagnostics::SourceLimits { max_files: 0, ..limits }).is_err(),
    );
}
