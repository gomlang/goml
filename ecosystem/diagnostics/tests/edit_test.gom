package tests;

use ecosystem::diagnostics;
use std::testing;

fn edit(
    cache: diagnostics::SourceCache,
    file: diagnostics::FileId,
    start: isize,
    end: isize,
    value: string,
) -> diagnostics::Edit {
    diagnostics::Edit::new(testing::expect_ok(cache.span(file, start, end), "span"), value)
}

#[test]
fn suggestions_apply_multifile_original_offsets_without_mutation() -> () {
    let cache = diagnostics::SourceCache::new();
    let first = testing::expect_ok(cache.add("one", "let 中 = old;"), "first");
    let second = testing::expect_ok(cache.add("two", "xyz"), "second");
    let base = diagnostics::Suggestion::new("rename", diagnostics::Applicability::MachineApplicable);
    let suggestion = base.with_edit(edit(cache, second, 1, 2, "中")).with_edit(
        edit(cache, first, 10, 13, "new"),
    ).with_edit(edit(cache, first, 0, 0, "pub "));
    testing::assert_eq(base.edits.len(), 0);
    let changed = testing::expect_ok(
        suggestion.apply(cache, diagnostics::EditLimits::new()),
        "apply",
    );
    testing::assert_eq(changed.len(), 2);
    testing::assert_eq(changed[0].file, first);
    testing::assert_eq(changed[0].updated, "pub let 中 = new;");
    testing::assert_eq(changed[1].updated, "x中z");
    testing::assert_eq(testing::expect_ok(cache.get(first), "original").text(), "let 中 = old;");
}

#[test]
fn overlapping_and_ambiguous_insertions_fail_atomically() -> () {
    let cache = diagnostics::SourceCache::new();
    let file = testing::expect_ok(cache.add("source", "abcdef"), "file");
    let base = diagnostics::Suggestion::new("fix", diagnostics::Applicability::MaybeIncorrect);
    let overlapping = base.with_edit(edit(cache, file, 1, 4, "x")).with_edit(
        edit(cache, file, 3, 5, "y"),
    );
    testing::assert_eq(
        testing::expect_err(overlapping.validate(cache, diagnostics::EditLimits::new()), "overlap"),
        diagnostics::Error::ConflictingEdits { first: 0, second: 1 },
    );
    let insertion = base.with_edit(edit(cache, file, 2, 2, "x")).with_edit(
        edit(cache, file, 2, 2, "y"),
    );
    testing::assert(insertion.apply(cache, diagnostics::EditLimits::new()).is_err());
    let inside = base.with_edit(edit(cache, file, 1, 4, "x")).with_edit(
        edit(cache, file, 2, 2, "y"),
    );
    testing::assert(inside.apply(cache, diagnostics::EditLimits::new()).is_err());
    testing::assert_eq(testing::expect_ok(cache.get(file), "unchanged").text(), "abcdef");
}

#[test]
fn adjacent_edits_and_boundary_insertions_have_unambiguous_order() -> () {
    let cache = diagnostics::SourceCache::new();
    let file = testing::expect_ok(cache.add("source", "abc"), "file");
    let suggestion = diagnostics::Suggestion::new(
        "fix",
        diagnostics::Applicability::MachineApplicable,
    ).with_edit(edit(cache, file, 1, 2, "B")).with_edit(edit(cache, file, 2, 2, "+")).with_edit(
        edit(cache, file, 1, 1, "-"),
    ).with_edit(edit(cache, file, 2, 3, "C"));
    testing::assert_eq(
        testing::expect_ok(suggestion.apply(cache, diagnostics::EditLimits::new()), "adjacent")[0].updated,
        "a-B+C",
    );
}

#[test]
fn suggestion_limits_count_final_output_across_files() -> () {
    let cache = diagnostics::SourceCache::new();
    let file = testing::expect_ok(cache.add("source", "abcdef"), "file");
    let suggestion = diagnostics::Suggestion::new(
        "fix",
        diagnostics::Applicability::MachineApplicable,
    ).with_edit(edit(cache, file, 0, 0, "hi")).with_edit(edit(cache, file, 0, 6, ""));
    let limits = diagnostics::EditLimits { max_output_bytes: 2, ..diagnostics::EditLimits::new() };
    testing::assert_eq(
        testing::expect_ok(suggestion.apply(cache, limits), "final size")[0].updated,
        "hi",
    );
    testing::assert(
        suggestion.apply(cache, diagnostics::EditLimits { max_output_bytes: 1, ..limits }).is_err(),
    );
    testing::assert(
        suggestion.apply(cache, diagnostics::EditLimits { max_edits: 1, ..limits }).is_err(),
    );
    testing::assert(
        suggestion.apply(cache, diagnostics::EditLimits { max_replacement_bytes: 1, ..limits }).is_err(),
    );
    testing::assert(
        suggestion.apply(cache, diagnostics::EditLimits { max_edits: -1, ..limits }).is_err(),
    );
    let other = diagnostics::SourceCache::new();
    testing::assert(suggestion.apply(other, diagnostics::EditLimits::new()).is_err());
    let empty = diagnostics::Suggestion::new("nothing", diagnostics::Applicability::Unspecified);
    testing::assert_eq(
        testing::expect_ok(empty.apply(cache, diagnostics::EditLimits::new()), "empty").len(),
        0,
    );
}

#[test]
fn validation_preflights_combined_output_before_any_edit_is_applied() -> () {
    let cache = diagnostics::SourceCache::new();
    let first = testing::expect_ok(cache.add("a", "ab"), "first");
    let second = testing::expect_ok(cache.add("b", "cd"), "second");
    let suggestion = diagnostics::Suggestion::new(
        "two files",
        diagnostics::Applicability::MachineApplicable,
    ).with_edit(edit(cache, first, 0, 1, "A")).with_edit(edit(cache, second, 0, 1, "C"));
    let limit = diagnostics::EditLimits { max_output_bytes: 3, ..diagnostics::EditLimits::new() };
    testing::assert(suggestion.validate(cache, limit).is_err());
    testing::assert(suggestion.apply(cache, limit).is_err());
    testing::assert_eq(testing::expect_ok(cache.get(first), "unchanged").text(), "ab");
    testing::expect_ok(
        suggestion.validate(cache, diagnostics::EditLimits { max_output_bytes: 4, ..limit }),
        "exact budget",
    );
}
