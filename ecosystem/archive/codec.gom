package archive;

use ecosystem::compress;
use ecosystem::compress::gzip as shared_gzip;
use std::bytes;

pub fn gzip(data: bytes::Bytes) -> Result[bytes::Bytes, Error] {
    let limits = compress::Limits {
        max_input_bytes: data.len(),
        max_output_bytes: 9223372036854775807,
        max_blocks: 9223372036854775807,
        max_work: 9223372036854775807,
    };
    shared_gzip::encode(data, limits, 6).map_err(|error| compression_error(error, 0))
}

pub fn gunzip(data: bytes::Bytes, limit: isize) -> Result[bytes::Bytes, Error] {
    if limit < 0 {
        return Result::Err(failure(ErrorKind::Limit, 0, "negative decompression limit"))
    }
    let limits = compress::Limits {
        max_input_bytes: data.len(),
        max_output_bytes: limit,
        max_blocks: 9223372036854775807,
        max_work: 9223372036854775807,
    };
    shared_gzip::decode(data, limits).map_err(|error| compression_error(error, 0))
}

fn inflate(data: bytes::Bytes, limit: isize) -> Result[bytes::Bytes, Error] {
    if limit < 0 {
        return Result::Err(failure(ErrorKind::Limit, 0, "negative decompression limit"))
    }
    let output = bytes::Bytes::new();
    let offset = inflate_into(data, 0, output, limit)?;
    if offset != data.len() {
        return Result::Err(failure(ErrorKind::Invalid, offset, "trailing compressed data"))
    }
    Result::Ok(output)
}
