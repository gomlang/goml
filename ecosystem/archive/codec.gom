package archive;

use std::bytes;
use std::ffi;

#[go_ffi("example.com/goml-ecosystem/archive/adapter", "Compress")]
extern fn native_compress(data: ffi::RawSlice[byte], gzip_format: bool) -> (
    ffi::RawSlice[byte],
    ffi::String,
);

#[go_ffi("example.com/goml-ecosystem/archive/adapter", "Decompress")]
extern fn native_decompress(data: ffi::RawSlice[byte], gzip_format: bool, limit: isize) -> (
    ffi::RawSlice[byte],
    ffi::String,
);

fn codec_result(result: (ffi::RawSlice[byte], ffi::String)) -> Result[bytes::Bytes, Error] {
    let (data, error) = result;
    let message = ffi::string_text(error).unwrap_or("invalid compression error");
    if message != "" {
        return Result::Err(failure(ErrorKind::Invalid, 0, message))
    }
    Result::Ok(bytes::Bytes::from_vec(ffi::slice_to_vec_copy(data)))
}

pub fn gzip(data: bytes::Bytes) -> Result[bytes::Bytes, Error] {
    codec_result(native_compress(ffi::slice_shared(data.to_vec()), true))
}

pub fn gunzip(data: bytes::Bytes, limit: isize) -> Result[bytes::Bytes, Error] {
    codec_result(native_decompress(ffi::slice_shared(data.to_vec()), true, limit))
}

fn deflate(data: bytes::Bytes) -> Result[bytes::Bytes, Error] {
    codec_result(native_compress(ffi::slice_shared(data.to_vec()), false))
}

fn inflate(data: bytes::Bytes, limit: isize) -> Result[bytes::Bytes, Error] {
    codec_result(native_decompress(ffi::slice_shared(data.to_vec()), false, limit))
}
