package archive;

use ecosystem::compress;
use ecosystem::compress::flate;
use std::bytes;
use std::io;

fn inflate_into(data: bytes::Bytes, offset: isize, output: bytes::Bytes, limit: isize) -> Result[
    isize,
    Error,
] {
    if offset < 0 || offset > data.len() {
        return Result::Err(failure(ErrorKind::Truncated, offset, "invalid DEFLATE input offset"))
    }
    if limit < output.len() {
        return Result::Err(failure(ErrorKind::Limit, offset, "decompressed data exceeds limit"))
    }
    let source = io::Cursor::new(data);
    source.set_position(offset).map_err(
        |error| failure(ErrorKind::Invalid, offset, error.to_string()),
    )?;
    let limits = compress::Limits {
        max_input_bytes: if data.len() - offset < 9223372036854775807 {
            data.len() - offset + 1
        } else {
            9223372036854775807
        },
        max_output_bytes: limit - output.len(),
        max_blocks: 9223372036854775807,
        max_work: 9223372036854775807,
    };
    let decoder = flate::Decoder::new(source, limits).map_err(
        |error| compression_error(error, offset),
    )?;
    let buffer = zeros(4096);
    loop {
        let count = decoder.read_chunk(buffer.as_mut_slice()).map_err(
            |error| compression_error(error, offset),
        )?;
        if count == 0 {
            return Result::Ok(offset + decoder.consumed())
        }
        output.extend_from_slice(buffer.slice(0, count));
    }
}

fn compression_error(error: compress::Error, origin: isize) -> Error {
    let kind = match error.kind {
        compress::ErrorKind::Truncated => ErrorKind::Truncated,
        compress::ErrorKind::Limit => ErrorKind::Limit,
        compress::ErrorKind::Checksum => ErrorKind::Checksum,
        compress::ErrorKind::Io => ErrorKind::Io,
        _ => ErrorKind::Invalid,
    };
    failure(kind, origin + error.offset, error.message)
}
