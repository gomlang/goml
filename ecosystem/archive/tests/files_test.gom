package tests;

use ecosystem::archive;
use archive::{Entry, Limits, Compression, ExtractOptions, LinkPolicy};
use std::bytes;
use std::fs;
use std::process;
use std::testing;
use std::time;

fn temporary() -> string {
    let root = "/tmp/goml-archive-" + time::SystemTime::now().unix_nanoseconds().to_string();
    testing::assert_ok(fs::create_dir(root));
    root
}

fn command(program: string, args: Vec[string], directory: string) -> () {
    let result = testing::expect_ok(
        process::Command::new(program).args(args).current_dir(directory).output_structured(),
        "command",
    );
    testing::assert(result.status().success());
}

#[test]
fn external_tar_zip_gzip_interoperability_and_extraction() -> () {
    let root = temporary();
    defer {
        let _ = fs::remove_dir_all(root);
    };
    let limits = Limits::standard();
    let data = bytes::Bytes::from_string("external archive\n");
    let entries = Vec::from_array([Entry::file("file.txt", data)]);
    let tar = testing::expect_ok(archive::encode_tar(entries, limits), "tar");
    let zip = testing::expect_ok(archive::encode_zip(entries, Compression::Deflate, limits), "zip");
    testing::assert_ok(archive::write_file(root + "/native.tar", tar));
    testing::assert_ok(archive::write_file(root + "/native.zip", zip));
    testing::assert_ok(
        archive::write_file(
            root + "/native.tar.gz",
            testing::expect_ok(archive::encode_tar_gz(entries, limits), "tgz"),
        ),
    );
    command("tar", Vec::from_array(["-tf", "native.tar"]), root);
    command("tar", Vec::from_array(["-tzf", "native.tar.gz"]), root);
    command("unzip", Vec::from_array(["-t", "native.zip"]), root);
    testing::assert_ok(fs::write_bytes_structured(root + "/file.txt", data));
    command("tar", Vec::from_array(["--format=ustar", "-cf", "external.tar", "file.txt"]), root);
    command("tar", Vec::from_array(["--format=pax", "-czf", "external.tar.gz", "file.txt"]), root);
    command("zip", Vec::from_array(["-q", "external.zip", "file.txt"]), root);
    let plain = testing::expect_ok(
        archive::open_tar(root + "/external.tar", limits),
        "external tar",
    );
    let packed = testing::expect_ok(
        archive::open_tar_gz(root + "/external.tar.gz", limits),
        "external tgz",
    );
    let zipped = testing::expect_ok(
        archive::open_zip(root + "/external.zip", limits),
        "external zip",
    );
    testing::assert(plain[0].data.to_vec() == data.to_vec());
    testing::assert(packed[0].data.to_vec() == data.to_vec());
    testing::assert(testing::expect_ok(zipped.entry(0), "entry").data.to_vec() == data.to_vec());
    testing::assert_ok(fs::create_dir(root + "/out"));
    testing::assert_eq(
        testing::expect_ok(
            archive::extract(entries, root + "/out", ExtractOptions::standard()),
            "extract",
        ),
        1,
    );
    testing::assert(
        testing::expect_ok(fs::read_bytes_structured(root + "/out/file.txt"), "file").to_vec()
            == data.to_vec(),
    );
    testing::assert(archive::extract(entries, root + "/out", ExtractOptions::standard()).is_err());
}

#[test]
fn extraction_preflight_traversal_duplicates_links_and_existing_symlinks() -> () {
    let root = temporary();
    defer {
        let _ = fs::remove_dir_all(root);
    };
    let options = ExtractOptions::standard();
    let empty = bytes::Bytes::new();
    for path in Vec::from_array(
        ["../outside", "/absolute", "a/../../outside", "C:/outside", "a\\b"],
    ) {
        testing::assert(
            archive::extract(
                Vec::from_array([Entry::file("first", empty), Entry::file(path, empty)]),
                root,
                options,
            ).is_err(),
        );
        testing::assert(!fs::exists(root + "/first"));
    }
    testing::assert(
        archive::extract(
            Vec::from_array([Entry::file("a", empty), Entry::file("a/b", empty)]),
            root,
            options,
        ).is_err(),
    );
    testing::assert(
        archive::extract(
            Vec::from_array([Entry::file("a", empty), Entry::file("a", empty)]),
            root,
            options,
        ).is_err(),
    );
    testing::assert(
        archive::extract(Vec::from_array([Entry::symlink("link", "../outside")]), root, options).is_err(),
    );
    testing::assert_eq(
        testing::expect_ok(
            archive::extract(
                Vec::from_array([Entry::symlink("link", "../outside")]),
                root,
                ExtractOptions { links: LinkPolicy::Skip, ..options },
            ),
            "skip links",
        ),
        0,
    );
    testing::assert_ok(fs::create_dir(root + "/outside"));
    testing::assert_ok(fs::create_dir(root + "/out"));
    testing::assert_ok(fs::symbolic_link(root + "/outside", root + "/out/parent"));
    testing::assert(
        archive::extract(
            Vec::from_array([Entry::file("parent/escaped", empty)]),
            root + "/out",
            options,
        ).is_err(),
    );
    testing::assert(!fs::exists(root + "/outside/escaped"));
    testing::assert_ok(fs::symbolic_link(root + "/outside/escaped", root + "/out/leaf"));
    testing::assert(
        archive::extract(Vec::from_array([Entry::file("leaf", empty)]), root + "/out", options).is_err(),
    );
    testing::assert(!fs::exists(root + "/outside/escaped"));
}
