package archive;

use std::bytes;
use std::io;
use io::{Read, Write, Close, ReadAt};
use std::os::linux::abi;
use std::os::linux::fd;
use std::os::linux::syscall;

#[derive(Debug, PartialEq)]
pub enum LinkPolicy {
    Reject,
    Skip,
}

pub struct ExtractOptions {
    pub limits: Limits,
    pub links: LinkPolicy,
    pub preserve_permissions: bool,
}

impl ExtractOptions {
    pub fn standard() -> ExtractOptions {
        ExtractOptions {
            limits: Limits::standard(),
            links: LinkPolicy::Reject,
            preserve_permissions: false,
        }
    }
}

fn filesystem_error(error: io::Error) -> Error {
    failure(ErrorKind::Io, 0, error.to_string())
}

struct ExtractionRoot {
    directory: fd::Fd,
    openat2: Ref[bool],
}

fn root_components(path: string) -> Result[Vec[string], io::Error] {
    safe_path(path, 9223372036854775807).map_err(
        |error| io::Error::new(
            io::ErrorKind::InvalidInput,
            "resolve archive path",
            Option::Some(path),
            Option::None,
            error.message,
        ),
    )?;
    let components = path.split("/");
    if components[components.len() - 1] == "" {
        return Result::Err(
            io::Error::new(
                io::ErrorKind::InvalidInput,
                "resolve archive path",
                Option::Some(path),
                Option::None,
                "expected a normalized archive path",
            ),
        )
    }
    Result::Ok(components)
}

fn with_root_parent[T](root: fd::Fd, path: string, action: (fd::Fd, string) -> Result[T, io::Error]) -> Result[
    T,
    io::Error,
] {
    let components = root_components(path)?;
    let mut directory = root.duplicate()?;
    defer {
        let _ = directory.close();
    };
    for index in 0..components.len() - 1 {
        let next = directory.open_at(
            components[index],
            fd::O_RDONLY | fd::O_DIRECTORY | fd::O_NOFOLLOW,
            0,
        )?;
        let previous = directory;
        directory = next;
        previous.close()?;
    }
    action(directory, components[components.len() - 1])
}

fn root_open(root: ExtractionRoot, path: string, flags: usize, mode: u32) -> Result[
    fd::Fd,
    io::Error,
] {
    root_components(path)?;
    if root.openat2.get() {
        match root.directory.open_at2(
            path,
            abi::OpenHow {
                flags: flags.to_u64(),
                mode: mode.to_u64(),
                resolve: (fd::RESOLVE_BENEATH | fd::RESOLVE_NO_SYMLINKS).to_u64(),
            },
        ) {
            Ok(file) => return Result::Ok(file),
            Err(error) => {
                if error.raw_os_code() != Option::Some(syscall::ENOSYS.to_isize()) {
                    return Result::Err(error)
                }
                root.openat2.set(false);
            },
        }
    }
    with_root_parent(
        root.directory,
        path,
        |directory, name| directory.open_at(name, flags | fd::O_NOFOLLOW, mode),
    )
}

fn root_mkdir(root: ExtractionRoot, path: string) -> Result[(), Error] {
    match root_open(root, path, fd::O_RDONLY | fd::O_DIRECTORY, 0) {
        Result::Ok(directory) => return directory.close().map_err(filesystem_error),
        Result::Err(error) => {
            if error.kind() != io::ErrorKind::NotFound {
                return Result::Err(filesystem_error(error))
            }
        },
    }
    with_root_parent(
        root.directory,
        path,
        |directory, name| {
            match directory.with_raw_fd(|raw| fd::mkdir_at(raw.to_isize(), name, 0o755)) {
                Ok(_) => Result::Ok(()),
                Err(error) => if error.kind() == io::ErrorKind::AlreadyExists {
                    Result::Ok(())
                } else {
                    Result::Err(error)
                },
            }
        },
    ).map_err(filesystem_error)?;
    root_open(root, path, fd::O_RDONLY | fd::O_DIRECTORY, 0).map_err(filesystem_error)?.close().map_err(
        filesystem_error,
    )
}

fn root_write(root: ExtractionRoot, path: string, data: bytes::Bytes, mode: u32) -> Result[
    (),
    Error,
] {
    let file = root_open(root, path, fd::O_WRONLY | fd::O_CREAT | fd::O_EXCL, mode).map_err(
        filesystem_error,
    )?;
    let written = file.write_all(data.as_slice());
    let closed = file.close();
    written.map_err(filesystem_error)?;
    closed.map_err(filesystem_error)
}

pub fn safe_path(path: string, limit: isize) -> Result[string, Error] {
    if path == "" || path.to_bytes().len() > limit || path.starts_with("/") || path.contains("\\")
        || path.contains(":")
        || path.contains("\u0000") {
        return Result::Err(failure(ErrorKind::Path, 0, "unsafe extraction path"))
    }
    let parts = path.split("/");
    let mut result = "";
    for index in 0..parts.len() {
        let component = parts[index];
        if component == "" && index == parts.len() - 1 {
            continue
        }
        if component == "" || component == "." || component == ".." {
            return Result::Err(failure(ErrorKind::Path, 0, "unsafe extraction path component"))
        }
        if result != "" {
            result += "/";
        }
        result += component;
    }
    if result == "" {
        return Result::Err(failure(ErrorKind::Path, 0, "empty extraction path"))
    }
    Result::Ok(result)
}

pub fn extract(entries: Vec[Entry], destination: string, options: ExtractOptions) -> Result[
    isize,
    Error,
] {
    extract_with_backend(entries, destination, options, true)
}

fn extract_with_backend(
    entries: Vec[Entry],
    destination: string,
    options: ExtractOptions,
    openat2: bool,
) -> Result[isize, Error] {
    options.limits.validate()?;
    if entries.len() > options.limits.max_entries {
        return Result::Err(failure(ErrorKind::Limit, 0, "extraction entry limit"))
    }
    let names: HashMap[string, EntryKind] = HashMap::new();
    let paths = Vec::new();
    let mut total = 0;
    for entry in entries {
        validate_entry(entry, options.limits)?;
        let name = safe_path(entry.header.path, options.limits.max_path_bytes)?;
        if names.get(name).is_some() {
            return Result::Err(failure(ErrorKind::Path, 0, "duplicate extraction path"))
        }
        names.insert(name, entry.header.kind);
        paths.push(name);
        if entry.data.len() > options.limits.max_total_bytes - total {
            return Result::Err(failure(ErrorKind::Limit, 0, "extraction size limit"))
        }
        total += entry.data.len();
        if options.links == LinkPolicy::Reject
            && (entry.header.kind == EntryKind::Symlink || entry.header.kind == EntryKind::Hardlink) {
            return Result::Err(
                failure(ErrorKind::Path, 0, "archive links rejected by extraction policy"),
            )
        }
    }
    for name in paths {
        let components = name.split("/");
        let mut prefix = "";
        for index in 0..components.len() - 1 {
            if prefix != "" {
                prefix += "/";
            }
            prefix += components[index];
            if let Some(kind) = names.get(prefix) {
                if kind != EntryKind::Directory {
                    return Result::Err(
                        failure(ErrorKind::Path, 0, "non-directory archive entry is a parent path"),
                    )
                }
            }
        }
    }
    let directory = fd::open(destination, fd::O_RDONLY | fd::O_DIRECTORY, 0).map_err(
        filesystem_error,
    )?;
    defer {
        let _ = directory.close();
    };
    let root = ExtractionRoot { directory, openat2: Ref::new(openat2) };
    let mut written = 0;
    for index in 0..entries.len() {
        let entry = entries[index];
        if entry.header.kind == EntryKind::Symlink || entry.header.kind == EntryKind::Hardlink {
            continue
        }
        let name = paths[index];
        let components = name.split("/");
        let mut prefix = "";
        let directory_count = if entry.header.kind == EntryKind::Directory {
            components.len()
        } else {
            components.len() - 1
        };
        for component_index in 0..directory_count {
            if prefix != "" {
                prefix += "/";
            }
            prefix += components[component_index];
            root_mkdir(root, prefix)?;
        }
        if entry.header.kind == EntryKind::File {
            let mode = if options.preserve_permissions {
                entry.header.mode & 0o777
            } else {
                0o644
            };
            root_write(root, name, entry.data, mode)?;
        }
        written += 1;
    }
    Result::Ok(written)
}

pub fn read_file(path: string, limit: isize) -> Result[bytes::Bytes, Error] {
    if limit < 0 {
        return Result::Err(failure(ErrorKind::Limit, 0, "negative file limit"))
    }
    let file = fd::open(path, fd::O_RDONLY, 0).map_err(
        |error| failure(ErrorKind::Io, 0, error.to_string()),
    )?;
    defer {
        let _ = file.close();
    };
    file.read_to_end(limit).map_err(|error| failure(ErrorKind::Io, 0, error.to_string()))
}

pub fn write_file(path: string, data: bytes::Bytes) -> Result[(), Error] {
    let file = fd::open(path, fd::O_WRONLY | fd::O_CREAT | fd::O_EXCL, 0o644).map_err(
        |error| failure(ErrorKind::Io, 0, error.to_string()),
    )?;
    defer {
        let _ = file.close();
    };
    file.write_all(data.as_slice()).map_err(|error| failure(ErrorKind::Io, 0, error.to_string()))
}

pub fn open_zip(path: string, limits: Limits) -> Result[ZipArchive, Error] {
    ZipArchive::open(read_file(path, limits.max_archive_bytes)?, limits)
}

pub struct ZipFile {
    descriptor: fd::Fd,
}

impl ReadAt for ZipFile {
    fn read_at(self: ZipFile, output: MutSlice[byte], offset: isize) -> Result[
        isize,
        io::TransferError,
    ] {
        self.descriptor.read_at(output, offset.to_i64()).map_err(
            |error| io::TransferError::new(0, error),
        )
    }
}

impl Close for ZipFile {
    fn close(self: ZipFile) -> Result[(), io::Error] {
        self.descriptor.close()
    }
}

pub fn open_zip_source(path: string, limits: Limits) -> Result[ZipSource[ZipFile], Error] {
    limits.validate()?;
    let descriptor = fd::open(path, fd::O_RDONLY, 0).map_err(
        |error| failure(ErrorKind::Io, 0, error.to_string()),
    )?;
    let stat = match descriptor.stat() {
        Ok(value) => value,
        Err(error) => {
            let _ = descriptor.close();
            return Result::Err(failure(ErrorKind::Io, 0, error.to_string()))
        },
    };
    if stat.mode & 0o170000 != 0o100000 || stat.size < 0
        || stat.size > limits.max_archive_bytes.to_i64() {
        let _ = descriptor.close();
        return Result::Err(
            failure(ErrorKind::Invalid, 0, "ZIP source must be a bounded regular file"),
        )
    }
    let result = ZipSource::open(ZipFile { descriptor }, stat.size.to_isize(), limits);
    if result.is_err() {
        let _ = descriptor.close();
    }
    result
}

pub fn open_tar(path: string, limits: Limits) -> Result[Vec[Entry], Error] {
    decode_tar(read_file(path, limits.max_archive_bytes)?, limits)
}

pub fn open_tar_gz(path: string, limits: Limits) -> Result[Vec[Entry], Error] {
    decode_tar_gz(read_file(path, limits.max_archive_bytes)?, limits)
}
