package archive;

use ecosystem::compress;
use ecosystem::compress::flate;
use std::bytes;

fn deflate(data: bytes::Bytes) -> Result[bytes::Bytes, Error] {
    let limits = compress::Limits {
        max_input_bytes: data.len(),
        max_output_bytes: 9223372036854775807,
        max_blocks: 9223372036854775807,
        max_work: 9223372036854775807,
    };
    flate::encode(data, limits, 6).map_err(|error| compression_error(error, 0))
}
