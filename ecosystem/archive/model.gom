package archive;

use std::bytes;

#[derive(Debug, PartialEq)]
pub enum ErrorKind {
    Invalid,
    Truncated,
    Checksum,
    Unsupported,
    Limit,
    Path,
    Io,
    Closed,
}

pub struct Error {
    pub kind: ErrorKind,
    pub offset: isize,
    pub message: string,
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        f"archive at {self.offset}: {self.message}"
    }
}

impl Debug for Error {
    fn debug(self: Error) -> string {
        self.to_string()
    }
}

fn failure(kind: ErrorKind, offset: isize, message: string) -> Error {
    Error { kind, offset, message }
}

#[derive(Debug, PartialEq)]
pub enum EntryKind {
    File,
    Directory,
    Symlink,
    Hardlink,
}

#[derive(Debug, PartialEq)]
pub enum Compression {
    Stored,
    Deflate,
}

pub struct Limits {
    pub max_entries: isize,
    pub max_entry_bytes: isize,
    pub max_total_bytes: isize,
    pub max_archive_bytes: isize,
    pub max_path_bytes: isize,
    pub max_metadata_bytes: isize,
}

impl Limits {
    pub fn standard() -> Limits {
        Limits {
            max_entries: 100000,
            max_entry_bytes: 67108864,
            max_total_bytes: 268435456,
            max_archive_bytes: 536870912,
            max_path_bytes: 4096,
            max_metadata_bytes: 1048576,
        }
    }

    pub fn validate(self: Limits) -> Result[(), Error] {
        if self.max_entries < 0 || self.max_entry_bytes < 0 || self.max_total_bytes < 0
            || self.max_archive_bytes < 0
            || self.max_path_bytes < 0
            || self.max_metadata_bytes < 0 {
            return Result::Err(failure(ErrorKind::Limit, 0, "limits must be nonnegative"))
        }
        Result::Ok(())
    }
}

pub struct Header {
    pub path: string,
    pub kind: EntryKind,
    pub mode: u32,
    pub uid: u64,
    pub gid: u64,
    pub modified: i64,
    pub user: string,
    pub group: string,
    pub link: string,
    pub comment: string,
    pub pax: Vec[(string, string)],
}

impl Header {
    pub fn file(path: string) -> Header {
        Header {
            path,
            kind: EntryKind::File,
            mode: 0o644,
            uid: 0,
            gid: 0,
            modified: 0,
            user: "",
            group: "",
            link: "",
            comment: "",
            pax: Vec::new(),
        }
    }

    pub fn directory(path: string) -> Header {
        Header { kind: EntryKind::Directory, mode: 0o755, ..Header::file(path) }
    }

    pub fn symlink(path: string, target: string) -> Header {
        Header { kind: EntryKind::Symlink, link: target, ..Header::file(path) }
    }
}

pub struct Entry {
    pub header: Header,
    pub data: bytes::Bytes,
}

impl Entry {
    pub fn file(path: string, data: bytes::Bytes) -> Entry {
        Entry { header: Header::file(path), data }
    }

    pub fn directory(path: string) -> Entry {
        Entry { header: Header::directory(path), data: bytes::Bytes::new() }
    }

    pub fn symlink(path: string, target: string) -> Entry {
        Entry { header: Header::symlink(path, target), data: bytes::Bytes::new() }
    }
}

fn validate_entry(entry: Entry, limits: Limits) -> Result[(), Error] {
    if entry.header.path == "" || entry.header.path.to_bytes().len() > limits.max_path_bytes
        || entry.header.path.contains("\u0000")
        || entry.header.link.contains("\u0000") {
        return Result::Err(failure(ErrorKind::Path, 0, "invalid entry path or link"))
    }
    if entry.data.len() > limits.max_entry_bytes {
        return Result::Err(failure(ErrorKind::Limit, 0, "entry size exceeds limit"))
    }
    if entry.header.kind != EntryKind::File && !entry.data.is_empty() {
        return Result::Err(failure(ErrorKind::Invalid, 0, "non-file entry has payload"))
    }
    Result::Ok(())
}
