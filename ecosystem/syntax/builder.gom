package syntax;

#[derive(Debug, PartialEq, Eq)]
pub struct CacheStatistics {
    pub entries: isize,
    pub retained_bytes: isize,
    pub retained_elements: isize,
    pub hits: u64,
    pub misses: u64,
    pub evictions: u64,
}

struct CacheState {
    entries: Vec[GreenElement],
    bytes: isize,
    elements: isize,
    hits: u64,
    misses: u64,
    evictions: u64,
}

pub struct NodeCache {
    state: Ref[CacheState],
    gate: Channel[()],
    capacity: isize,
    max_bytes: isize,
    max_elements: isize,
}

impl NodeCache {
    pub fn new(capacity: isize, max_bytes: isize, max_elements: isize) -> Result[NodeCache, Error] {
        if capacity < 0 || capacity > 4096 || max_bytes < 0 || max_elements < 0 {
            return Result::Err(Error::InvalidLimits)
        }
        let gate = Channel::new(1);
        gate.send(());
        Result::Ok(
            NodeCache {
                state: Ref::new(
                    CacheState {
                        entries: Vec::new(),
                        bytes: 0,
                        elements: 0,
                        hits: 0,
                        misses: 0,
                        evictions: 0,
                    },
                ),
                gate,
                capacity,
                max_bytes,
                max_elements,
            },
        )
    }

    pub fn intern(self: NodeCache, value: GreenElement) -> GreenElement {
        let _ = self.gate.recv();
        defer self.gate.send(());
        let mut state = self.state.get();
        for entry in state.entries {
            if entry.structural_eq(value) {
                state.hits += 1;
                self.state.set(state);
                return entry
            }
        }
        state.misses += 1;
        let bytes = value.len_bytes();
        let elements = value.element_count();
        if self.capacity == 0 || bytes > self.max_bytes || elements > self.max_elements {
            self.state.set(state);
            return value
        }
        while state.entries.len() >= self.capacity || state.bytes > self.max_bytes - bytes
            || state.elements > self.max_elements - elements {
            let removed = state.entries.remove(0);
            state.bytes -= removed.len_bytes();
            state.elements -= removed.element_count();
            state.evictions += 1;
        }
        state.entries.push(value);
        state.bytes += bytes;
        state.elements += elements;
        self.state.set(state);
        value
    }

    pub fn token(self: NodeCache, kind: u32, value: string, limits: Limits) -> Result[
        GreenToken,
        Error,
    ] {
        let token = GreenToken::with_limits(kind, value, limits)?;
        match self.intern(token.element()) {
            Token(value) => Result::Ok(value),
            _ => Result::Err(Error::ExpectedNode),
        }
    }

    pub fn node(self: NodeCache, kind: u32, children: Vec[GreenElement], limits: Limits) -> Result[
        GreenNode,
        Error,
    ] {
        let node = GreenNode::with_limits(kind, children, limits)?;
        match self.intern(node.element()) {
            Node(value) => Result::Ok(value),
            _ => Result::Err(Error::ExpectedNode),
        }
    }

    pub fn statistics(self: NodeCache) -> CacheStatistics {
        let _ = self.gate.recv();
        defer self.gate.send(());
        let state = self.state.get();
        CacheStatistics {
            entries: state.entries.len(),
            retained_bytes: state.bytes,
            retained_elements: state.elements,
            hits: state.hits,
            misses: state.misses,
            evictions: state.evictions,
        }
    }

    pub fn clear(self: NodeCache) -> () {
        let _ = self.gate.recv();
        defer self.gate.send(());
        let state = self.state.get();
        self.state.set(
            CacheState {
                entries: Vec::new(),
                bytes: 0,
                elements: 0,
                hits: state.hits,
                misses: state.misses,
                evictions: state.evictions,
            },
        );
    }
}

struct Frame {
    kind: u32,
    identity: Ref[()],
    children: Vec[GreenElement],
}

struct BuilderState {
    frames: Vec[Frame],
    roots: Vec[GreenElement],
    bytes: isize,
    elements: isize,
    sealed: bool,
}

pub struct Checkpoint {
    owner: Ref[BuilderState],
    frame: Ref[()],
    index: isize,
}

pub struct GreenBuilder {
    state: Ref[BuilderState],
    limits: Limits,
    cache: Option[NodeCache],
}

impl GreenBuilder {
    pub fn new() -> GreenBuilder {
        GreenBuilder {
            state: Ref::new(
                BuilderState {
                    frames: Vec::new(),
                    roots: Vec::new(),
                    bytes: 0,
                    elements: 0,
                    sealed: false,
                },
            ),
            limits: Limits::standard(),
            cache: Option::None,
        }
    }

    pub fn with_options(limits: Limits, cache: Option[NodeCache]) -> Result[GreenBuilder, Error] {
        limits.validate()?;
        Result::Ok(
            GreenBuilder {
                state: Ref::new(
                    BuilderState {
                        frames: Vec::new(),
                        roots: Vec::new(),
                        bytes: 0,
                        elements: 0,
                        sealed: false,
                    },
                ),
                limits,
                cache,
            },
        )
    }

    pub fn start_node(self: GreenBuilder, kind: u32) -> Result[(), Error] {
        let mut state = self.state.get();
        if state.sealed || (state.frames.is_empty() && !state.roots.is_empty()) {
            return Result::Err(Error::BuilderState)
        }
        if state.frames.len() >= self.limits.max_depth {
            return Result::Err(Error::Limit)
        }
        if let Some(frame) = state.frames.last() {
            if frame.children.len() >= self.limits.max_children {
                return Result::Err(Error::Limit)
            }
        }
        state.elements = checked_add(state.elements, 1, self.limits.max_elements)?;
        state.frames.push(Frame { kind, identity: Ref::new(()), children: Vec::new() });
        self.state.set(state);
        Result::Ok(())
    }

    pub fn checkpoint(self: GreenBuilder) -> Result[Checkpoint, Error] {
        let state = self.state.get();
        if state.sealed {
            return Result::Err(Error::BuilderState)
        }
        match state.frames.last() {
            Some(frame) => Result::Ok(
                Checkpoint { owner: self.state, frame: frame.identity, index: frame.children.len() },
            ),
            None => Result::Err(Error::BuilderState),
        }
    }

    pub fn start_node_at(self: GreenBuilder, checkpoint: Checkpoint, kind: u32) -> Result[(), Error] {
        let mut state = self.state.get();
        if state.sealed || !ptr_eq(self.state, checkpoint.owner) {
            return Result::Err(Error::InvalidCheckpoint)
        }
        let frame = match state.frames.last() {
            Some(value) => value,
            None => return Result::Err(Error::InvalidCheckpoint),
        };
        if !ptr_eq(frame.identity, checkpoint.frame) || checkpoint.index > frame.children.len() {
            return Result::Err(Error::InvalidCheckpoint)
        }
        if state.frames.len() >= self.limits.max_depth
            || checkpoint.index >= self.limits.max_children {
            return Result::Err(Error::Limit)
        }
        state.elements = checked_add(state.elements, 1, self.limits.max_elements)?;
        let children = Vec::new();
        for index in checkpoint.index..frame.children.len() {
            children.push(frame.children[index]);
        }
        for child in children {
            checked_add(state.frames.len() + 1, child.depth(), self.limits.max_depth)?;
        }
        frame.children.truncate(checkpoint.index);
        state.frames.push(Frame { kind, identity: Ref::new(()), children });
        self.state.set(state);
        Result::Ok(())
    }

    pub fn element(self: GreenBuilder, value: GreenElement) -> Result[(), Error] {
        let mut state = self.state.get();
        if state.sealed {
            return Result::Err(Error::BuilderState)
        }
        let frame = match state.frames.last() {
            Some(value) => value,
            None => return Result::Err(Error::BuilderState),
        };
        if frame.children.len() >= self.limits.max_children {
            return Result::Err(Error::Limit)
        }
        value.validate_limits(self.limits)?;
        checked_add(state.frames.len(), value.depth(), self.limits.max_depth)?;
        let bytes = checked_add(state.bytes, value.len_bytes(), self.limits.max_bytes)?;
        let elements = checked_add(state.elements, value.element_count(), self.limits.max_elements)?;
        frame.children.push(value);
        state.bytes = bytes;
        state.elements = elements;
        self.state.set(state);
        Result::Ok(())
    }

    pub fn token(self: GreenBuilder, kind: u32, value: string) -> Result[(), Error] {
        let token = match self.cache {
            Some(cache) => cache.token(kind, value, self.limits)?,
            None => GreenToken::with_limits(kind, value, self.limits)?,
        };
        self.element(token.element())
    }

    pub fn finish_node(self: GreenBuilder) -> Result[GreenNode, Error] {
        let state = self.state.get();
        if state.sealed {
            return Result::Err(Error::BuilderState)
        }
        let frame = match state.frames.last() {
            Some(value) => value,
            None => return Result::Err(Error::BuilderState),
        };
        let node = match self.cache {
            Some(cache) => cache.node(frame.kind, frame.children, self.limits)?,
            None => GreenNode::with_limits(frame.kind, frame.children, self.limits)?,
        };
        let _ = state.frames.pop();
        match state.frames.last() {
            Some(parent) => parent.children.push(node.element()),
            None => state.roots.push(node.element()),
        }
        Result::Ok(node)
    }

    pub fn finish(self: GreenBuilder) -> Result[GreenNode, Error] {
        let mut state = self.state.get();
        if state.sealed || !state.frames.is_empty() || state.roots.len() != 1 {
            return Result::Err(Error::BuilderState)
        }
        let root = match state.roots[0] {
            Node(value) => value,
            _ => return Result::Err(Error::ExpectedNode),
        };
        state.sealed = true;
        self.state.set(state);
        Result::Ok(root)
    }

    pub fn open_depth(self: GreenBuilder) -> isize {
        self.state.get().frames.len()
    }
}
