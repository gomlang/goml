package syntax;

fn occurrence_hash(value: SyntaxElement) -> u64 {
    let mut hash_value = 14695981039346656037;
    let mut current = value;
    loop {
        hash_value = mix(hash_value, current.index().to_u64());
        hash_value = mix(hash_value, current.kind().to_u64());
        hash_value = mix(hash_value, current.range().start().to_u64());
        match current.parent() {
            Some(parent) => {
                current = parent.element();
            },
            None => return match current {
                Node(root) => mix(hash_value, root.root_identity.hash()),
                Token(_) => hash_value,
            },
        }
    }
}

impl PartialEq for SyntaxNode {
    fn eq(self: SyntaxNode, other: SyntaxNode) -> bool {
        self.same_occurrence(other)
    }
}

impl Eq for SyntaxNode {}

impl Hash for SyntaxNode {
    fn hash(self: SyntaxNode) -> u64 {
        occurrence_hash(self.element())
    }
}

impl PartialEq for SyntaxToken {
    fn eq(self: SyntaxToken, other: SyntaxToken) -> bool {
        self.same_occurrence(other)
    }
}

impl Eq for SyntaxToken {}

impl Hash for SyntaxToken {
    fn hash(self: SyntaxToken) -> u64 {
        occurrence_hash(self.element())
    }
}

impl PartialEq for SyntaxElement {
    fn eq(self: SyntaxElement, other: SyntaxElement) -> bool {
        self.same_occurrence(other)
    }
}

impl Eq for SyntaxElement {}

impl Hash for SyntaxElement {
    fn hash(self: SyntaxElement) -> u64 {
        occurrence_hash(self)
    }
}

impl ToString for GreenToken {
    fn to_string(self: GreenToken) -> string {
        self.text()
    }
}

impl ToString for GreenNode {
    fn to_string(self: GreenNode) -> string {
        self.text()
    }
}

impl ToString for GreenElement {
    fn to_string(self: GreenElement) -> string {
        self.text()
    }
}

impl ToString for SyntaxToken {
    fn to_string(self: SyntaxToken) -> string {
        self.text()
    }
}

impl ToString for SyntaxNode {
    fn to_string(self: SyntaxNode) -> string {
        self.text()
    }
}

impl ToString for SyntaxElement {
    fn to_string(self: SyntaxElement) -> string {
        self.text()
    }
}
