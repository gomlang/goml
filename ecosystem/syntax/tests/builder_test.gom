package tests;

use ecosystem::syntax;
use std::testing;
use std::iter;

#[test]
fn builder_checkpoints_wrap_precedence_and_preserve_trivia() -> () {
    let builder = syntax::GreenBuilder::new();
    testing::assert_ok(builder.start_node(0));
    let left = testing::expect_ok(builder.checkpoint(), "left");
    testing::assert_ok(builder.token(1, "a"));
    testing::assert_ok(builder.start_node_at(left, 10));
    testing::assert_ok(builder.token(2, " + "));
    let right = testing::expect_ok(builder.checkpoint(), "right");
    testing::assert_ok(builder.token(1, "b"));
    testing::assert_ok(builder.start_node_at(right, 11));
    testing::assert_ok(builder.token(2, " * "));
    testing::assert_ok(builder.token(1, "c"));
    testing::assert_ok(builder.finish_node());
    testing::assert_ok(builder.finish_node());
    testing::assert_ok(builder.finish_node());
    let green = testing::expect_ok(builder.finish(), "root");
    testing::assert_eq(green.text(), "a + b * c");
    testing::assert_eq(green.depth(), 4);
    testing::assert_eq(green.element_count(), 8);
    testing::assert_err(builder.finish());
    testing::assert_err(builder.start_node(0));
    testing::assert_err(builder.finish_node());
    testing::assert_err(builder.token(1, "x"));
}

#[test]
fn builder_rejects_foreign_stale_checkpoints_and_recovers_after_errors() -> () {
    let first = syntax::GreenBuilder::new();
    let second = syntax::GreenBuilder::new();
    testing::assert_err(first.checkpoint());
    testing::assert_err(first.token(1, "orphan"));
    testing::assert_err(first.finish_node());
    testing::assert_err(first.finish());
    testing::assert_ok(first.start_node(0));
    testing::assert_ok(second.start_node(0));
    let checkpoint = testing::expect_ok(first.checkpoint(), "first");
    testing::assert_err(second.start_node_at(checkpoint, 1));
    testing::assert_ok(first.start_node(1));
    testing::assert_err(first.start_node_at(checkpoint, 1));
    let stale = testing::expect_ok(first.checkpoint(), "inner");
    testing::assert_ok(first.finish_node());
    testing::assert_ok(first.start_node(1));
    testing::assert_err(first.start_node_at(stale, 1));
    testing::assert_ok(first.finish_node());
    testing::assert_ok(first.finish_node());
    testing::assert_err(first.start_node(0));
    testing::assert_eq(testing::expect_ok(first.finish(), "recovered").child_count(), 2);
}

#[test]
fn builder_enforces_aggregate_budgets_without_poisoning_valid_state() -> () {
    let limits = syntax::Limits { max_bytes: 3, max_elements: 4, max_depth: 3, max_children: 2 };
    let builder = testing::expect_ok(
        syntax::GreenBuilder::with_options(limits, Option::None),
        "builder",
    );
    testing::assert_ok(builder.start_node(0));
    testing::assert_ok(builder.token(1, "中"));
    testing::assert_err(builder.token(1, "a"));
    testing::assert_ok(builder.token(1, ""));
    testing::assert_err(builder.token(1, ""));
    testing::assert_ok(builder.finish_node());
    testing::assert_eq(testing::expect_ok(builder.finish(), "valid prefix").text(), "中");
    let depth = testing::expect_ok(
        syntax::GreenBuilder::with_options(limits, Option::None),
        "depth builder",
    );
    testing::assert_ok(depth.start_node(0));
    let checkpoint = testing::expect_ok(depth.checkpoint(), "checkpoint");
    let child = node(2, Vec::from_array([token(1, "x").element()]));
    testing::assert_ok(depth.element(child.element()));
    testing::assert_err(depth.start_node_at(checkpoint, 3));
    testing::assert_eq(depth.open_depth(), 1);
    testing::assert_ok(depth.finish_node());
    testing::assert_eq(testing::expect_ok(depth.finish(), "unchanged tree").text(), "x");
    let invalid = syntax::Limits { max_bytes: -1, max_elements: 1, max_depth: 1, max_children: 0 };
    testing::assert_err(syntax::GreenBuilder::with_options(invalid, Option::None));
    testing::assert_err(syntax::GreenToken::with_limits(0, "", invalid));
}

#[test]
fn interning_is_structural_bounded_and_clear_does_not_invalidate_snapshots() -> () {
    let cache = testing::expect_ok(syntax::NodeCache::new(2, 5, 10), "cache");
    let first = testing::expect_ok(cache.token(1, "ab", syntax::Limits::standard()), "first");
    let same = testing::expect_ok(cache.token(1, "ab", syntax::Limits::standard()), "same");
    testing::assert(first.same_allocation(same));
    let _ = testing::expect_ok(cache.token(2, "c", syntax::Limits::standard()), "second");
    let _ = testing::expect_ok(cache.token(3, "def", syntax::Limits::standard()), "eviction");
    let stats = cache.statistics();
    testing::assert_eq(stats.entries, 2);
    testing::assert_eq(stats.retained_bytes, 4);
    testing::assert_eq(stats.hits, 1);
    testing::assert_eq(stats.evictions, 1);
    let again = testing::expect_ok(cache.token(1, "ab", syntax::Limits::standard()), "reinsert");
    testing::assert(!again.same_allocation(first));
    testing::assert(again == first);
    cache.clear();
    testing::assert_eq(cache.statistics().entries, 0);
    testing::assert_eq(first.text(), "ab");
    let large = testing::expect_ok(
        cache.token(1, "uncached", syntax::Limits::standard()),
        "oversized",
    );
    testing::assert_eq(cache.statistics().entries, 0);
    testing::assert_eq(large.text(), "uncached");
    testing::assert_err(syntax::NodeCache::new(-1, 5, 10));
    testing::assert_err(syntax::NodeCache::new(4097, 5, 10));
    let elements = testing::expect_ok(syntax::NodeCache::new(10, 100, 2), "element budget");
    let tree = node(0, Vec::from_array([token(1, "").element(), token(1, "").element()]));
    let _ = elements.intern(tree.element());
    testing::assert_eq(elements.statistics().entries, 0);
}

#[test]
fn cached_builders_reuse_complete_green_trees() -> () {
    let cache = testing::expect_ok(syntax::NodeCache::new(8, 100, 100), "cache");
    let builds = Vec::new();
    for _ in 0..2 {
        let builder = testing::expect_ok(
            syntax::GreenBuilder::with_options(syntax::Limits::standard(), Option::Some(cache)),
            "builder",
        );
        testing::assert_ok(builder.start_node(0));
        testing::assert_ok(builder.token(1, "é"));
        testing::assert_ok(builder.finish_node());
        builds.push(testing::expect_ok(builder.finish(), "complete"));
    }
    testing::assert(builds[0].same_allocation(builds[1]));
    testing::assert_eq(cache.statistics().hits, 2);
}

struct Expression {
    node: syntax::SyntaxNode,
}

impl syntax::AstNode for Expression {
    fn cast(value: syntax::SyntaxNode) -> Option[Expression] {
        if value.kind() == 10 {
            Option::Some(Expression { node: value })
        } else {
            Option::None
        }
    }

    fn syntax(self: Expression) -> syntax::SyntaxNode {
        self.node
    }
}

#[test]
fn external_typed_ast_works_through_generic_trait_bounds() -> () {
    let root = fixture();
    let expressions: Vec[Expression] = syntax::ast_children(root);
    testing::assert_eq(expressions.len(), 1);
    testing::assert_eq(expressions[0].node.text(), "中+😀");
    testing::assert_eq(iter::count(root.children()), 2);
}
