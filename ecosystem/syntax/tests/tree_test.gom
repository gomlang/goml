package tests;

use ecosystem::syntax;
use std::testing;
use std::task;
use std::iter;

fn token(kind: u32, value: string) -> syntax::GreenToken {
    testing::expect_ok(syntax::GreenToken::new(kind, value), "token")
}

fn node(kind: u32, children: Vec[syntax::GreenElement]) -> syntax::GreenNode {
    testing::expect_ok(syntax::GreenNode::new(kind, children), "node")
}

fn range(start: isize, end: isize) -> syntax::TextRange {
    testing::expect_ok(syntax::TextRange::new(start, end), "range")
}

fn fixture() -> syntax::SyntaxNode {
    syntax::SyntaxNode::new_root(
        node(
            0,
            Vec::from_array(
                [
                    token(1, " ").element(),
                    node(
                        10,
                        Vec::from_array(
                            [
                                token(2, "中").element(),
                                token(3, "+").element(),
                                token(2, "😀").element(),
                            ],
                        ),
                    ).element(),
                    node(11, Vec::new()).element(),
                    token(1, "\r\n").element(),
                ],
            ),
        ),
    )
}

#[test]
fn green_values_copy_inputs_and_compare_by_structure() -> () {
    let children = Vec::from_array([token(1, "abc").element()]);
    let a = node(0, children);
    children[0] = token(2, "changed").element();
    children.push(token(3, "more").element());
    let detached = a.children().to_vec();
    detached.clear();
    let b = node(0, Vec::from_array([token(1, "abc").element()]));
    testing::assert(a == b);
    testing::assert(!a.same_allocation(b));
    testing::assert_eq(a.text(), "abc");
    testing::assert_eq(a.element_count(), 2);
    testing::assert_eq(a.depth(), 2);
    testing::assert_eq(a.max_children(), 1);
    let map: HashMap[syntax::GreenNode, isize] = HashMap::new();
    map.set(a, 42);
    testing::assert(map.get(b) == Option::Some(42));
    testing::assert_none(a.child(-1));
    testing::assert_none(a.child(1));
    testing::assert_eq(testing::expect_ok(a.child_offset(1), "EOF child offset"), 3);
    testing::assert_err(a.child_offset(2));
}

#[test]
fn checked_ranges_and_unicode_offsets() -> () {
    testing::assert_err(syntax::TextRange::new(-1, 1));
    testing::assert_err(syntax::TextRange::new(2, 1));
    testing::assert(range(1, 4).intersect(range(4, 9)) == Option::Some(range(4, 4)));
    testing::assert(range(1, 4).contains(3));
    testing::assert(!range(1, 4).contains(4));
    let root = fixture();
    testing::assert_eq(root.text(), " 中+😀\r\n");
    testing::assert_eq(root.range(), range(0, 11));
    testing::assert_eq(testing::expect_ok(root.text_slice(range(1, 9)), "slice"), "中+😀");
    for offset in[2, 3, 6, 7, 8] {
        testing::assert_err(root.token_at_offset(offset));
        testing::assert_err(root.text_slice(range(offset, offset)));
        testing::assert_err(root.covering_element(range(offset, offset)));
    }
    testing::assert_err(root.token_at_offset(-1));
    testing::assert_err(root.token_at_offset(12));
    testing::assert_eq(testing::expect_ok(root.text_slice(range(11, 11)), "EOF empty"), "");
}

#[test]
fn token_boundaries_choose_both_sides_and_ignore_zero_width() -> () {
    let root = syntax::SyntaxNode::new_root(
        node(
            0,
            Vec::from_array(
                [
                    token(1, "").element(),
                    token(2, "a").element(),
                    node(3, Vec::new()).element(),
                    token(4, "").element(),
                    token(5, "é").element(),
                    token(6, "").element(),
                ],
            ),
        ),
    );
    match testing::expect_ok(root.token_at_offset(1), "between") {
        Between(left, right) => {
            testing::assert_eq(left.kind(), 2);
            testing::assert_eq(right.kind(), 5);
        },
        _ => testing::assert(false),
    }
    for (offset, kind) in[(0, 2), (3, 5)] {
        match testing::expect_ok(root.token_at_offset(offset), "edge") {
            Single(value) => testing::assert_eq(value.kind(), kind),
            _ => testing::assert(false),
        }
    }
    testing::assert_eq(testing::expect_some(root.first_token(), "empty first").kind(), 1);
    testing::assert_eq(testing::expect_some(root.last_token(), "empty last").kind(), 6);
    let empty = syntax::SyntaxNode::new_root(node(0, Vec::from_array([token(1, "").element()])));
    testing::assert(matches_none(testing::expect_ok(empty.token_at_offset(0), "empty offset")));
}

fn matches_none(value: syntax::TokenAtOffset) -> bool {
    match value {
        None => true,
        _ => false,
    }
}

#[test]
fn navigation_distinguishes_shared_occurrences_and_roots() -> () {
    let repeated = node(1, Vec::from_array([token(2, "").element()]));
    let green = node(0, Vec::from_array([repeated.element(), repeated.element()]));
    let root = syntax::SyntaxNode::new_root(green);
    let a = testing::expect_some(root.child_at(0), "first");
    let b = testing::expect_some(root.child_at(1), "second");
    testing::assert(a.green().same_allocation(b.green()));
    testing::assert(!a.same_occurrence(b));
    testing::assert(
        !testing::expect_some(
            testing::expect_some(a.as_node(), "node").first_token(),
            "first token",
        ).same_occurrence(
            testing::expect_some(
                testing::expect_some(b.as_node(), "node").first_token(),
                "second token",
            ),
        ),
    );
    testing::assert(a.same_occurrence(testing::expect_some(b.prev_sibling_or_token(), "previous")));
    testing::assert(b.same_occurrence(testing::expect_some(a.next_sibling_or_token(), "next")));
    let map: HashMap[syntax::SyntaxElement, isize] = HashMap::new();
    map.set(a, 1);
    map.set(b, 2);
    testing::assert(
        map.get(testing::expect_some(root.child_at(0), "same first occurrence")) == Option::Some(1),
    );
    testing::assert(
        map.get(testing::expect_some(root.child_at(1), "same second occurrence")) == Option::Some(2),
    );
    testing::assert_eq(iter::count(root.descendants()), 3);
    testing::assert(testing::expect_some(root.first_child(), "first node").element() == a);
    testing::assert(testing::expect_some(root.last_child(), "last node").element() == b);
    testing::assert(!root.same_tree(syntax::SyntaxNode::new_root(green)));
    let first = testing::expect_some(a.as_node(), "node");
    testing::assert(
        testing::expect_some(first.next_sibling(), "sibling").same_occurrence(
            testing::expect_some(b.as_node(), "node"),
        ),
    );
    testing::assert(first.root().same_occurrence(root));
    testing::assert_eq(iter::count(first.ancestors()), 2);
    testing::assert_eq(iter::count(first.element().ancestors()), 1);
}

#[test]
fn token_navigation_crosses_empty_nodes_without_leaving_subtree_iteration() -> () {
    let root = fixture();
    let forward = Vec::new();
    let mut current = root.first_token();
    while let Some(value) = current {
        forward.push(value.text());
        current = value.next_token();
    }
    testing::assert(forward == Vec::from_array([" ", "中", "+", "😀", "\r\n"]));
    let backward = Vec::new();
    current = root.last_token();
    while let Some(value) = current {
        backward.push(value.text());
        current = value.prev_token();
    }
    backward.reverse();
    testing::assert(backward == forward);
    let expression = testing::expect_some(
        testing::expect_some(root.child_at(1), "child").as_node(),
        "expression",
    );
    let texts = iter::collect(iter::map(expression.tokens(), |value| value.text()));
    testing::assert(texts == Vec::from_array(["中", "+", "😀"]));
    testing::assert_eq(iter::count(expression.children()), 0);
    testing::assert_eq(iter::count(expression.descendants_with_tokens()), 4);
}

#[test]
fn walk_enter_leave_balance_and_skip_subtree() -> () {
    let root = fixture();
    let entered = Vec::new();
    let stack: Vec[syntax::SyntaxElement] = Vec::new();
    for event in root.walk() {
        match event {
            Enter(value) => {
                entered.push(value.kind());
                stack.push(value);
            },
            Leave(value) => testing::assert(
                testing::expect_some(stack.pop(), "matching entry").same_occurrence(value),
            ),
        }
    }
    testing::assert(stack.is_empty());
    testing::assert(entered == Vec::from_array([0, 1, 10, 2, 3, 2, 11, 1]));
    let walk = root.walk();
    let visited = Vec::new();
    while let Some(event) = walk.next() {
        if let Enter(value) = event {
            visited.push(value.kind());
            if value.kind() == 10 {
                walk.skip_subtree();
            }
        }
    }
    testing::assert(visited == Vec::from_array([0, 1, 10, 11, 1]));
    testing::assert_none(walk.next());
    walk.skip_subtree();
    testing::assert_none(walk.next());
}

#[test]
fn covering_element_has_deterministic_empty_range_bias() -> () {
    let root = fixture();
    testing::assert_eq(
        testing::expect_ok(root.covering_element(range(1, 9)), "expression").kind(),
        10,
    );
    testing::assert_eq(testing::expect_ok(root.covering_element(range(1, 4)), "token").kind(), 2);
    testing::assert_eq(testing::expect_ok(root.covering_element(range(0, 11)), "root").kind(), 0);
    testing::assert_eq(
        testing::expect_ok(root.covering_element(range(1, 1)), "left-biased empty").kind(),
        1,
    );
}

#[test]
fn persistent_replacement_preserves_siblings_and_old_views() -> () {
    let root = fixture();
    let expression = testing::expect_some(
        testing::expect_some(root.child_at(1), "expression").as_node(),
        "node",
    );
    let middle = testing::expect_some(
        testing::expect_some(expression.child_at(1), "operator").as_token(),
        "token",
    );
    let replaced = testing::expect_ok(
        middle.replace_with(token(3, " ** "), syntax::Limits::standard()),
        "replace",
    );
    testing::assert_eq(replaced.text(), " 中 ** 😀\r\n");
    testing::assert_eq(root.text(), " 中+😀\r\n");
    testing::assert_eq(middle.text(), "+");
    testing::assert(
        testing::expect_some(replaced.child(0), "unchanged whitespace").same_allocation(
            testing::expect_some(root.green().child(0), "original whitespace"),
        ),
    );
    let changed_expression = testing::expect_some(
        testing::expect_some(replaced.child(1), "changed").as_node(),
        "node",
    );
    testing::assert(
        testing::expect_some(changed_expression.child(0), "left").same_allocation(
            testing::expect_some(expression.green().child(0), "original left"),
        ),
    );
    testing::assert_err(
        middle.element().replace_in(
            syntax::SyntaxNode::new_root(root.green()),
            token(1, "x").element(),
            syntax::Limits::standard(),
        ),
    );
    testing::assert_ok(
        middle.element().replace_in(root, token(1, "x").element(), syntax::Limits::standard()),
    );
    testing::assert_err(
        root.element().replace_with(token(1, "x").element(), syntax::Limits::standard()),
    );
}

#[test]
fn splicing_detaches_input_and_checks_limits_before_allocation() -> () {
    let value = node(0, Vec::from_array([token(1, "a").element(), token(2, "b").element()]));
    let inserted = Vec::from_array([token(3, "中").element()]);
    let changed = testing::expect_ok(
        value.splice_children(1, 2, inserted, syntax::Limits::standard()),
        "splice",
    );
    inserted.clear();
    testing::assert_eq(changed.text(), "a中");
    testing::assert_eq(value.text(), "ab");
    testing::assert_err(value.splice_children(2, 1, Vec::new(), syntax::Limits::standard()));
    let narrow = syntax::Limits {
        max_bytes: 100,
        max_elements: 100,
        max_depth: 100,
        max_children: 1,
    };
    testing::assert_err(
        syntax::GreenNode::with_limits(4, Vec::from_array([value.element()]), narrow),
    );
    testing::assert_err(
        syntax::SyntaxNode::new_root(node(5, Vec::new())).replace_with(value, narrow),
    );
}

#[test]
fn logical_shared_trees_stop_before_size_or_integer_overflow() -> () {
    let limits = syntax::Limits {
        max_bytes: 9223372036854775807,
        max_elements: 9223372036854775807,
        max_depth: 128,
        max_children: 2,
    };
    let mut value = token(1, "xx").element();
    let mut successful = 0;
    loop {
        match syntax::GreenNode::with_limits(0, Vec::from_array([value, value]), limits) {
            Ok(next) => {
                value = next.element();
                successful += 1;
            },
            Err(error) => {
                testing::assert_eq(error, syntax::Error::Limit);
                break
            },
        }
    }
    testing::assert_eq(successful, 61);
}

#[test]
fn deep_tree_operations_are_iterative_and_budgeted() -> () {
    let limits = syntax::Limits {
        max_bytes: 100,
        max_elements: 12000,
        max_depth: 12000,
        max_children: 1,
    };
    let mut value = token(1, "中").element();
    for _ in 0..10000 {
        value = testing::expect_ok(
            syntax::GreenNode::with_limits(2, Vec::from_array([value]), limits),
            "deep node",
        ).element();
    }
    let green = testing::expect_some(value.as_node(), "root");
    let root = syntax::SyntaxNode::new_root(green);
    testing::assert_eq(root.text(), "中");
    testing::assert_eq(iter::count(root.descendants_with_tokens()), 10001);
    let leaf = testing::expect_some(root.first_token(), "leaf");
    testing::assert_eq(iter::count(leaf.element().ancestors()), 10000);
    let changed = testing::expect_ok(leaf.replace_with(token(1, "x"), limits), "deep replacement");
    testing::assert_eq(changed.text(), "x");
    testing::assert_eq(root.text(), "中");
    testing::assert_err(syntax::GreenNode::new(3, Vec::from_array([value])));
}

#[test]
fn immutable_snapshots_and_shared_cache_support_parallel_use() -> () {
    let root = fixture();
    let cache = testing::expect_ok(syntax::NodeCache::new(16, 1024, 1024), "cache");
    task::scope(
        |scope| {
            let jobs: Vec[task::Task[bool]] = Vec::new();
            for worker in 0..8 {
                jobs.push(
                    scope.spawn(
                        |_| {
                            for index in 0..100 {
                                let replacement = testing::expect_ok(
                                    cache.token(
                                        2,
                                        (worker * 100 + index).to_string(),
                                        syntax::Limits::standard(),
                                    ),
                                    "cache token",
                                );
                                let first = testing::expect_some(root.first_token(), "first");
                                let changed = testing::expect_ok(
                                    first.replace_with(replacement, syntax::Limits::standard()),
                                    "parallel edit",
                                );
                                testing::assert_eq(
                                    changed.len_bytes(),
                                    10 + replacement.len_bytes(),
                                );
                                testing::assert_eq(root.text(), " 中+😀\r\n");
                                testing::assert_eq(iter::count(root.tokens()), 5);
                            }
                            true
                        },
                    ),
                );
            }
            for job in jobs {
                testing::assert(job.join());
            }
        },
    );
    testing::assert(cache.statistics().entries <= 16);
}
