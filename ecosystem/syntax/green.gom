package syntax;

use std::text;

#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    Bounds,
    Utf8Boundary,
    InvalidUtf8,
    Limit,
    InvalidLimits,
    BuilderState,
    InvalidCheckpoint,
    ExpectedNode,
    ForeignTree,
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        match self {
            Bounds => "syntax range or child index is out of bounds",
            Utf8Boundary => "syntax offset splits a UTF-8 character",
            InvalidUtf8 => "syntax token contains invalid UTF-8",
            Limit => "syntax resource limit exceeded",
            InvalidLimits => "invalid syntax resource limits",
            BuilderState => "invalid syntax builder state",
            InvalidCheckpoint => "syntax checkpoint does not belong to this open frame",
            ExpectedNode => "expected a syntax node",
            ForeignTree => "syntax element belongs to a different root view",
        }
    }
}

#[derive(Debug, PartialEq, Eq)]
pub struct Limits {
    pub max_bytes: isize,
    pub max_elements: isize,
    pub max_depth: isize,
    pub max_children: isize,
}

impl Limits {
    pub fn standard() -> Limits {
        Limits {
            max_bytes: 67108864,
            max_elements: 1000000,
            max_depth: 4096,
            max_children: 1000000,
        }
    }

    pub fn validate(self: Limits) -> Result[(), Error] {
        if self.max_bytes < 0 || self.max_elements < 1 || self.max_depth < 1
            || self.max_children < 0 {
            Result::Err(Error::InvalidLimits)
        } else {
            Result::Ok(())
        }
    }
}

#[derive(Debug, PartialEq, Eq)]
pub struct TextRange {
    start_value: isize,
    end_value: isize,
}

impl TextRange {
    pub fn new(start: isize, end: isize) -> Result[TextRange, Error] {
        if start < 0 || end < start {
            Result::Err(Error::Bounds)
        } else {
            Result::Ok(TextRange { start_value: start, end_value: end })
        }
    }

    pub fn start(self: TextRange) -> isize {
        self.start_value
    }

    pub fn end(self: TextRange) -> isize {
        self.end_value
    }

    pub fn len(self: TextRange) -> isize {
        self.end_value - self.start_value
    }

    pub fn is_empty(self: TextRange) -> bool {
        self.start_value == self.end_value
    }

    pub fn contains(self: TextRange, offset: isize) -> bool {
        offset >= self.start_value && offset < self.end_value
    }

    pub fn contains_inclusive(self: TextRange, offset: isize) -> bool {
        offset >= self.start_value && offset <= self.end_value
    }

    pub fn contains_range(self: TextRange, other: TextRange) -> bool {
        other.start_value >= self.start_value && other.end_value <= self.end_value
    }

    pub fn intersect(self: TextRange, other: TextRange) -> Option[TextRange] {
        let start = if self.start_value > other.start_value {
            self.start_value
        } else {
            other.start_value
        };
        let end = if self.end_value < other.end_value {
            self.end_value
        } else {
            other.end_value
        };
        if start <= end {
            Option::Some(TextRange { start_value: start, end_value: end })
        } else {
            Option::None
        }
    }
}

pub struct GreenToken {
    data: Ref[TokenData],
}

struct TokenData {
    kind: u32,
    text: string,
    hash_value: u64,
}

pub struct GreenNode {
    data: Ref[NodeData],
}

struct NodeData {
    kind: u32,
    children: FrozenVec[GreenElement],
    ends: FrozenVec[isize],
    bytes: isize,
    elements: isize,
    depth: isize,
    hash_value: u64,
    max_children: isize,
}

pub enum GreenElement {
    Node(GreenNode),
    Token(GreenToken),
}

fn mix(hash_value: u64, value: u64) -> u64 {
    (hash_value ^ value) * 1099511628211
}

fn checked_add(value: isize, extra: isize, maximum: isize) -> Result[isize, Error] {
    if value > maximum || extra > maximum - value {
        Result::Err(Error::Limit)
    } else {
        Result::Ok(value + extra)
    }
}

impl GreenToken {
    pub fn new(kind: u32, value: string) -> Result[GreenToken, Error] {
        GreenToken::with_limits(kind, value, Limits::standard())
    }

    pub fn with_limits(kind: u32, value: string, limits: Limits) -> Result[GreenToken, Error] {
        limits.validate()?;
        if value.byte_len() > limits.max_bytes {
            return Result::Err(Error::Limit)
        }
        let mut at = 0;
        let mut hash_value = mix(14695981039346656037, kind.to_u64());
        while at < value.byte_len() {
            match value.decode_at(at) {
                Some((_, width)) => {
                    at += width;
                },
                None => return Result::Err(Error::InvalidUtf8),
            }
        }
        for index in 0..value.byte_len() {
            hash_value = mix(hash_value, value.byte_get(index).to_u64());
        }
        let builder = text::StringBuilder::new();
        builder.write_string(value);
        Result::Ok(
            GreenToken {
                data: Ref::new(
                    TokenData { kind, text: builder.finish(), hash_value: mix(hash_value, 1) },
                ),
            },
        )
    }

    pub fn kind(self: GreenToken) -> u32 {
        self.data.get().kind
    }

    pub fn text(self: GreenToken) -> string {
        self.data.get().text
    }

    pub fn len_bytes(self: GreenToken) -> isize {
        self.text().byte_len()
    }

    pub fn same_allocation(self: GreenToken, other: GreenToken) -> bool {
        ptr_eq(self.data, other.data)
    }

    pub fn fingerprint(self: GreenToken) -> u64 {
        self.data.get().hash_value
    }

    pub fn element(self: GreenToken) -> GreenElement {
        GreenElement::Token(self)
    }
}

impl GreenNode {
    pub fn new(kind: u32, children: Vec[GreenElement]) -> Result[GreenNode, Error] {
        GreenNode::with_limits(kind, children, Limits::standard())
    }

    pub fn with_limits(kind: u32, children: Vec[GreenElement], limits: Limits) -> Result[
        GreenNode,
        Error,
    ] {
        limits.validate()?;
        if children.len() > limits.max_children {
            return Result::Err(Error::Limit)
        }
        let mut bytes = 0;
        let mut elements = 1;
        let mut depth = 1;
        let mut max_children = children.len();
        let mut hash_value = mix(14695981039346656037, kind.to_u64());
        let ends = Vec::new();
        for child in children {
            let width = child.max_children();
            if width > limits.max_children {
                return Result::Err(Error::Limit)
            }
            if width > max_children {
                max_children = width;
            }
            bytes = checked_add(bytes, child.len_bytes(), limits.max_bytes)?;
            elements = checked_add(elements, child.element_count(), limits.max_elements)?;
            let child_depth = checked_add(child.depth(), 1, limits.max_depth)?;
            if child_depth > depth {
                depth = child_depth;
            }
            hash_value = mix(hash_value, child.fingerprint());
            ends.push(bytes);
        }
        Result::Ok(
            GreenNode {
                data: Ref::new(
                    NodeData {
                        kind,
                        children: children.freeze(),
                        ends: ends.freeze(),
                        bytes,
                        elements,
                        depth,
                        max_children,
                        hash_value: mix(mix(hash_value, children.len().to_u64()), 2),
                    },
                ),
            },
        )
    }

    pub fn kind(self: GreenNode) -> u32 {
        self.data.get().kind
    }

    pub fn len_bytes(self: GreenNode) -> isize {
        self.data.get().bytes
    }

    pub fn element_count(self: GreenNode) -> isize {
        self.data.get().elements
    }

    pub fn depth(self: GreenNode) -> isize {
        self.data.get().depth
    }

    pub fn max_children(self: GreenNode) -> isize {
        self.data.get().max_children
    }

    pub fn child_count(self: GreenNode) -> isize {
        self.data.get().children.len()
    }

    pub fn children(self: GreenNode) -> FrozenVec[GreenElement] {
        self.data.get().children
    }

    pub fn child(self: GreenNode, index: isize) -> Option[GreenElement] {
        if index < 0 || index >= self.child_count() {
            Option::None
        } else {
            Option::Some(self.data.get().children.get(index))
        }
    }

    pub fn child_offset(self: GreenNode, index: isize) -> Result[isize, Error] {
        if index < 0 || index > self.child_count() {
            return Result::Err(Error::Bounds)
        }
        Result::Ok(
            if index == 0 {
                0
            } else {
                self.data.get().ends.get(index - 1)
            },
        )
    }

    fn child_containing_byte(self: GreenNode, offset: isize) -> isize {
        let ends = self.data.get().ends;
        let mut low = 0;
        let mut high = ends.len();
        while low < high {
            let mid = low + (high - low) / 2;
            if ends.get(mid) <= offset {
                low = mid + 1;
            } else {
                high = mid;
            }
        }
        low
    }

    pub fn same_allocation(self: GreenNode, other: GreenNode) -> bool {
        ptr_eq(self.data, other.data)
    }

    pub fn fingerprint(self: GreenNode) -> u64 {
        self.data.get().hash_value
    }

    pub fn element(self: GreenNode) -> GreenElement {
        GreenElement::Node(self)
    }

    pub fn text(self: GreenNode) -> string {
        self.element().text()
    }

    pub fn splice_children(
        self: GreenNode,
        start: isize,
        end: isize,
        inserted: Vec[GreenElement],
        limits: Limits,
    ) -> Result[GreenNode, Error] {
        limits.validate()?;
        if start < 0 || end < start || end > self.child_count() {
            return Result::Err(Error::Bounds)
        }
        let remaining = self.child_count() - (end - start);
        checked_add(remaining, inserted.len(), limits.max_children)?;
        let children = Vec::new();
        for index in 0..start {
            children.push(self.data.get().children.get(index));
        }
        children.extend(inserted);
        for index in end..self.child_count() {
            children.push(self.data.get().children.get(index));
        }
        GreenNode::with_limits(self.kind(), children, limits)
    }
}

impl GreenElement {
    pub fn kind(self: GreenElement) -> u32 {
        match self {
            Node(value) => value.kind(),
            Token(value) => value.kind(),
        }
    }

    pub fn len_bytes(self: GreenElement) -> isize {
        match self {
            Node(value) => value.len_bytes(),
            Token(value) => value.len_bytes(),
        }
    }

    pub fn element_count(self: GreenElement) -> isize {
        match self {
            Node(value) => value.element_count(),
            Token(_) => 1,
        }
    }

    pub fn depth(self: GreenElement) -> isize {
        match self {
            Node(value) => value.depth(),
            Token(_) => 1,
        }
    }

    pub fn max_children(self: GreenElement) -> isize {
        match self {
            Node(value) => value.max_children(),
            Token(_) => 0,
        }
    }

    pub fn validate_limits(self: GreenElement, limits: Limits) -> Result[(), Error] {
        limits.validate()?;
        if self.len_bytes() > limits.max_bytes || self.element_count() > limits.max_elements
            || self.depth() > limits.max_depth
            || self.max_children() > limits.max_children {
            Result::Err(Error::Limit)
        } else {
            Result::Ok(())
        }
    }

    pub fn fingerprint(self: GreenElement) -> u64 {
        match self {
            Node(value) => value.fingerprint(),
            Token(value) => value.fingerprint(),
        }
    }

    pub fn same_allocation(self: GreenElement, other: GreenElement) -> bool {
        match (self, other) {
            (Node(a), Node(b)) => a.same_allocation(b),
            (Token(a), Token(b)) => a.same_allocation(b),
            _ => false,
        }
    }

    pub fn as_node(self: GreenElement) -> Option[GreenNode] {
        match self {
            Node(value) => Option::Some(value),
            _ => Option::None,
        }
    }

    pub fn as_token(self: GreenElement) -> Option[GreenToken] {
        match self {
            Token(value) => Option::Some(value),
            _ => Option::None,
        }
    }

    pub fn text(self: GreenElement) -> string {
        let builder = text::StringBuilder::new();
        let pending = Vec::from_array([self]);
        while let Some(value) = pending.pop() {
            match value {
                Token(token) => builder.write_string(token.text()),
                Node(node) => {
                    let mut index = node.child_count();
                    while index > 0 {
                        index -= 1;
                        pending.push(node.data.get().children.get(index));
                    }
                },
            }
        }
        builder.finish()
    }

    pub fn structural_eq(self: GreenElement, other: GreenElement) -> bool {
        let pending = Vec::from_array([(self, other)]);
        while let Some((left, right)) = pending.pop() {
            if left.same_allocation(right) {
                continue
            }
            if left.fingerprint() != right.fingerprint() || left.kind() != right.kind() {
                return false
            }
            match (left, right) {
                (Token(a), Token(b)) => if a.text() != b.text() {
                    return false
                },
                (Node(a), Node(b)) => {
                    if a.child_count() != b.child_count() {
                        return false
                    }
                    for index in 0..a.child_count() {
                        pending.push(
                            (a.data.get().children.get(index), b.data.get().children.get(index)),
                        );
                    }
                },
                _ => return false,
            }
        }
        true
    }
}

impl PartialEq for GreenToken {
    fn eq(self: GreenToken, other: GreenToken) -> bool {
        self.element().structural_eq(other.element())
    }
}

impl Eq for GreenToken {}

impl Hash for GreenToken {
    fn hash(self: GreenToken) -> u64 {
        self.fingerprint()
    }
}

impl PartialEq for GreenNode {
    fn eq(self: GreenNode, other: GreenNode) -> bool {
        self.element().structural_eq(other.element())
    }
}

impl Eq for GreenNode {}

impl Hash for GreenNode {
    fn hash(self: GreenNode) -> u64 {
        self.fingerprint()
    }
}

impl PartialEq for GreenElement {
    fn eq(self: GreenElement, other: GreenElement) -> bool {
        self.structural_eq(other)
    }
}

impl Eq for GreenElement {}

impl Hash for GreenElement {
    fn hash(self: GreenElement) -> u64 {
        self.fingerprint()
    }
}
