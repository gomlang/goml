package syntax;

use std::text;

pub struct SyntaxNode {
    green_value: GreenNode,
    parent_value: Option[Ref[SyntaxNode]],
    root_identity: Ref[()],
    index_value: isize,
    offset: isize,
}

pub struct SyntaxToken {
    green_value: GreenToken,
    parent_value: Ref[SyntaxNode],
    index_value: isize,
    offset: isize,
}

pub enum SyntaxElement {
    Node(SyntaxNode),
    Token(SyntaxToken),
}

pub enum TokenAtOffset {
    None,
    Single(SyntaxToken),
    Between(SyntaxToken, SyntaxToken),
}

pub trait AstNode {
    fn cast(node: SyntaxNode) -> Option[Self];
    fn syntax(self: Self) -> SyntaxNode;
}

pub fn ast_children[T: AstNode](parent: SyntaxNode) -> Vec[T] {
    let output = Vec::new();
    for child in parent.children() {
        let cast: Option[T] = AstNode::cast(child);
        if let Some(value) = cast {
            output.push(value);
        }
    }
    output
}

impl SyntaxNode {
    pub fn new_root(green: GreenNode) -> SyntaxNode {
        SyntaxNode {
            green_value: green,
            parent_value: Option::None,
            root_identity: Ref::new(()),
            index_value: 0,
            offset: 0,
        }
    }

    pub fn green(self: SyntaxNode) -> GreenNode {
        self.green_value
    }

    pub fn kind(self: SyntaxNode) -> u32 {
        self.green_value.kind()
    }

    pub fn range(self: SyntaxNode) -> TextRange {
        TextRange {
            start_value: self.offset,
            end_value: self.offset + self.green_value.len_bytes(),
        }
    }

    pub fn text(self: SyntaxNode) -> string {
        self.green_value.text()
    }

    pub fn index(self: SyntaxNode) -> isize {
        self.index_value
    }

    pub fn parent(self: SyntaxNode) -> Option[SyntaxNode] {
        self.parent_value.map(|value| value.get())
    }

    pub fn root(self: SyntaxNode) -> SyntaxNode {
        let mut current = self;
        while let Some(parent) = current.parent() {
            current = parent;
        }
        current
    }

    pub fn element(self: SyntaxNode) -> SyntaxElement {
        SyntaxElement::Node(self)
    }

    pub fn child_at(self: SyntaxNode, index: isize) -> Option[SyntaxElement] {
        let child = match self.green_value.child(index) {
            Some(child) => child,
            None => return Option::None,
        };
        let offset = self.offset
            + if index == 0 {
                0
            } else {
                self.green_value.data.get().ends.get(index - 1)
            };
        let parent = Ref::new(self);
        Option::Some(
            match child {
                Node(value) => SyntaxElement::Node(
                    SyntaxNode {
                        green_value: value,
                        parent_value: Option::Some(parent),
                        root_identity: self.root_identity,
                        index_value: index,
                        offset,
                    },
                ),
                Token(value) => SyntaxElement::Token(
                    SyntaxToken {
                        green_value: value,
                        parent_value: parent,
                        index_value: index,
                        offset,
                    },
                ),
            },
        )
    }

    pub fn children_with_tokens(self: SyntaxNode) -> ElementChildren {
        ElementChildren { parent: self, cursor: Ref::new(0) }
    }

    pub fn children(self: SyntaxNode) -> NodeChildren {
        NodeChildren { inner: self.children_with_tokens() }
    }

    pub fn first_child(self: SyntaxNode) -> Option[SyntaxNode] {
        self.children().next()
    }

    pub fn last_child(self: SyntaxNode) -> Option[SyntaxNode] {
        let mut index = self.green_value.child_count();
        while index > 0 {
            index -= 1;
            if let Some(SyntaxElement::Node(node)) = self.child_at(index) {
                return Option::Some(node)
            }
        }
        Option::None
    }

    pub fn descendants(self: SyntaxNode) -> NodeDescendants {
        NodeDescendants { inner: self.descendants_with_tokens() }
    }

    pub fn first_child_or_token(self: SyntaxNode) -> Option[SyntaxElement] {
        self.child_at(0)
    }

    pub fn last_child_or_token(self: SyntaxNode) -> Option[SyntaxElement] {
        self.child_at(self.green_value.child_count() - 1)
    }

    pub fn next_sibling(self: SyntaxNode) -> Option[SyntaxNode] {
        let mut next = self.element().next_sibling_or_token();
        while let Some(value) = next {
            if let Node(node) = value {
                return Option::Some(node)
            }
            next = value.next_sibling_or_token();
        }
        Option::None
    }

    pub fn prev_sibling(self: SyntaxNode) -> Option[SyntaxNode] {
        let mut previous = self.element().prev_sibling_or_token();
        while let Some(value) = previous {
            if let Node(node) = value {
                return Option::Some(node)
            }
            previous = value.prev_sibling_or_token();
        }
        Option::None
    }

    pub fn ancestors(self: SyntaxNode) -> Ancestors {
        Ancestors { current: Ref::new(Option::Some(self)) }
    }

    pub fn first_token(self: SyntaxNode) -> Option[SyntaxToken] {
        edge_token(self.element(), false)
    }

    pub fn last_token(self: SyntaxNode) -> Option[SyntaxToken] {
        edge_token(self.element(), true)
    }

    pub fn walk(self: SyntaxNode) -> Walk {
        Walk {
            boundary: self.element(),
            state: Ref::new(Option::Some(WalkEvent::Enter(self.element()))),
            entered: Ref::new(Option::None),
        }
    }

    pub fn descendants_with_tokens(self: SyntaxNode) -> Descendants {
        Descendants { walk: self.walk() }
    }

    pub fn tokens(self: SyntaxNode) -> Tokens {
        Tokens { inner: self.descendants_with_tokens() }
    }

    fn token_containing_byte(self: SyntaxNode, offset: isize) -> Option[SyntaxToken] {
        let mut current = self;
        loop {
            let index = current.green_value.child_containing_byte(offset - current.offset);
            match current.child_at(index) {
                Some(SyntaxElement::Node(node)) => {
                    current = node;
                },
                Some(SyntaxElement::Token(token)) => return Option::Some(token),
                None => return Option::None,
            }
        }
    }

    pub fn token_at_offset(self: SyntaxNode, offset: isize) -> Result[TokenAtOffset, Error] {
        if !self.range().contains_inclusive(offset) {
            return Result::Err(Error::Bounds)
        }
        let left = if offset > self.offset {
            self.token_containing_byte(offset - 1)
        } else {
            Option::None
        };
        let right = if offset < self.range().end() {
            self.token_containing_byte(offset)
        } else {
            Option::None
        };
        if let Some(token) = right {
            if !token.text().is_char_boundary(offset - token.offset) {
                return Result::Err(Error::Utf8Boundary)
            }
        }
        Result::Ok(
            match (left, right) {
                (Some(a), Some(b)) => if a.same_occurrence(b) {
                    TokenAtOffset::Single(a)
                } else {
                    TokenAtOffset::Between(a, b)
                },
                (Some(value), None) | (None, Some(value)) => TokenAtOffset::Single(value),
                (None, None) => TokenAtOffset::None,
            },
        )
    }

    pub fn text_slice(self: SyntaxNode, range: TextRange) -> Result[string, Error] {
        if !self.range().contains_range(range) {
            return Result::Err(Error::Bounds)
        }
        let _ = self.token_at_offset(range.start())?;
        let _ = self.token_at_offset(range.end())?;
        let output = text::StringBuilder::new();
        for token in self.tokens() {
            if let Some(overlap) = token.range().intersect(range) {
                if !overlap.is_empty() {
                    output.write_string(
                        token.text().byte_slice(
                            overlap.start() - token.offset,
                            overlap.end() - token.offset,
                        ),
                    );
                }
            }
        }
        Result::Ok(output.finish())
    }

    pub fn covering_element(self: SyntaxNode, range: TextRange) -> Result[SyntaxElement, Error] {
        if !self.range().contains_range(range) {
            return Result::Err(Error::Bounds)
        }
        let _ = self.token_at_offset(range.start())?;
        let _ = self.token_at_offset(range.end())?;
        let mut current = self.element();
        loop {
            let node = match current {
                Node(node) => node,
                Token(_) => return Result::Ok(current),
            };
            let mut next = Option::None;
            for child in node.children_with_tokens() {
                if child.range().contains_range(range) {
                    next = Option::Some(child);
                    break
                }
            }
            match next {
                Some(value) => {
                    current = value;
                },
                None => return Result::Ok(current),
            }
        }
    }

    pub fn replace_with(self: SyntaxNode, replacement: GreenNode, limits: Limits) -> Result[
        GreenNode,
        Error,
    ] {
        self.element().replace_with(replacement.element(), limits)
    }

    pub fn same_occurrence(self: SyntaxNode, other: SyntaxNode) -> bool {
        self.element().same_occurrence(other.element())
    }

    pub fn same_tree(self: SyntaxNode, other: SyntaxNode) -> bool {
        ptr_eq(self.root_identity, other.root_identity)
    }
}

impl SyntaxToken {
    pub fn green(self: SyntaxToken) -> GreenToken {
        self.green_value
    }

    pub fn kind(self: SyntaxToken) -> u32 {
        self.green_value.kind()
    }

    pub fn text(self: SyntaxToken) -> string {
        self.green_value.text()
    }

    pub fn range(self: SyntaxToken) -> TextRange {
        TextRange {
            start_value: self.offset,
            end_value: self.offset + self.green_value.len_bytes(),
        }
    }

    pub fn index(self: SyntaxToken) -> isize {
        self.index_value
    }

    pub fn parent(self: SyntaxToken) -> SyntaxNode {
        self.parent_value.get()
    }

    pub fn element(self: SyntaxToken) -> SyntaxElement {
        SyntaxElement::Token(self)
    }

    pub fn next_token(self: SyntaxToken) -> Option[SyntaxToken] {
        adjacent_token(self.element(), false)
    }

    pub fn prev_token(self: SyntaxToken) -> Option[SyntaxToken] {
        adjacent_token(self.element(), true)
    }

    pub fn same_occurrence(self: SyntaxToken, other: SyntaxToken) -> bool {
        self.element().same_occurrence(other.element())
    }

    pub fn replace_with(self: SyntaxToken, replacement: GreenToken, limits: Limits) -> Result[
        GreenNode,
        Error,
    ] {
        self.element().replace_with(replacement.element(), limits)
    }
}

impl SyntaxElement {
    pub fn kind(self: SyntaxElement) -> u32 {
        match self {
            Node(value) => value.kind(),
            Token(value) => value.kind(),
        }
    }

    pub fn range(self: SyntaxElement) -> TextRange {
        match self {
            Node(value) => value.range(),
            Token(value) => value.range(),
        }
    }

    pub fn index(self: SyntaxElement) -> isize {
        match self {
            Node(value) => value.index(),
            Token(value) => value.index(),
        }
    }

    pub fn green(self: SyntaxElement) -> GreenElement {
        match self {
            Node(value) => value.green().element(),
            Token(value) => value.green().element(),
        }
    }

    pub fn text(self: SyntaxElement) -> string {
        self.green().text()
    }

    pub fn as_node(self: SyntaxElement) -> Option[SyntaxNode] {
        match self {
            Node(value) => Option::Some(value),
            _ => Option::None,
        }
    }

    pub fn as_token(self: SyntaxElement) -> Option[SyntaxToken] {
        match self {
            Token(value) => Option::Some(value),
            _ => Option::None,
        }
    }

    pub fn parent(self: SyntaxElement) -> Option[SyntaxNode] {
        match self {
            Node(value) => value.parent(),
            Token(value) => Option::Some(value.parent()),
        }
    }

    pub fn next_sibling_or_token(self: SyntaxElement) -> Option[SyntaxElement] {
        match self.parent() {
            Some(parent) => parent.child_at(self.index() + 1),
            None => Option::None,
        }
    }

    pub fn prev_sibling_or_token(self: SyntaxElement) -> Option[SyntaxElement] {
        match self.parent() {
            Some(parent) => parent.child_at(self.index() - 1),
            None => Option::None,
        }
    }

    pub fn ancestors(self: SyntaxElement) -> Ancestors {
        Ancestors { current: Ref::new(self.parent()) }
    }

    pub fn same_occurrence(self: SyntaxElement, other: SyntaxElement) -> bool {
        let mut left = self;
        let mut right = other;
        loop {
            if !left.green().same_allocation(right.green()) || left.index() != right.index()
                || left.range() != right.range() {
                return false
            }
            match (left.parent(), right.parent()) {
                (Some(a), Some(b)) => {
                    left = a.element();
                    right = b.element();
                },
                (None, None) => return match (left, right) {
                    (Node(a), Node(b)) => ptr_eq(a.root_identity, b.root_identity),
                    _ => false,
                },
                _ => return false,
            }
        }
    }

    pub fn replace_with(self: SyntaxElement, replacement: GreenElement, limits: Limits) -> Result[
        GreenNode,
        Error,
    ] {
        replacement.validate_limits(limits)?;
        let mut current = self;
        let mut output = replacement;
        while let Some(parent) = current.parent() {
            output = parent.green().splice_children(
                current.index(),
                current.index() + 1,
                Vec::from_array([output]),
                limits,
            )?.element();
            current = parent.element();
        }
        match output {
            GreenElement::Node(value) => Result::Ok(value),
            _ => Result::Err(Error::ExpectedNode),
        }
    }

    pub fn replace_in(
        self: SyntaxElement,
        root: SyntaxNode,
        replacement: GreenElement,
        limits: Limits,
    ) -> Result[GreenNode, Error] {
        let actual = match self {
            Node(value) => value.root(),
            Token(value) => value.parent().root(),
        };
        if root.parent().is_some() || !root.same_occurrence(actual) {
            return Result::Err(Error::ForeignTree)
        }
        self.replace_with(replacement, limits)
    }
}

fn edge_token(element: SyntaxElement, reverse: bool) -> Option[SyntaxToken] {
    let pending = Vec::from_array([element]);
    while let Some(value) = pending.pop() {
        match value {
            Token(token) => return Option::Some(token),
            Node(node) => {
                if reverse {
                    for index in 0..node.green().child_count() {
                        if let Some(child) = node.child_at(index) {
                            pending.push(child);
                        }
                    }
                } else {
                    let mut index = node.green().child_count();
                    while index > 0 {
                        index -= 1;
                        if let Some(child) = node.child_at(index) {
                            pending.push(child);
                        }
                    }
                }
            },
        }
    }
    Option::None
}

fn adjacent_token(element: SyntaxElement, reverse: bool) -> Option[SyntaxToken] {
    let mut current = element;
    loop {
        let sibling = if reverse {
            current.prev_sibling_or_token()
        } else {
            current.next_sibling_or_token()
        };
        if let Some(value) = sibling {
            if let Some(token) = edge_token(value, reverse) {
                return Option::Some(token)
            }
            current = value;
        } else {
            match current.parent() {
                Some(parent) => {
                    current = parent.element();
                },
                None => return Option::None,
            }
        }
    }
}

pub struct ElementChildren {
    parent: SyntaxNode,
    cursor: Ref[isize],
}

impl Iterator for ElementChildren {
    type Item = SyntaxElement;

    fn next(self: ElementChildren) -> Option[SyntaxElement] {
        let index = self.cursor.get();
        let output = self.parent.child_at(index);
        if output.is_some() {
            self.cursor.set(index + 1);
        }
        output
    }
}

pub struct NodeChildren {
    inner: ElementChildren,
}

impl Iterator for NodeChildren {
    type Item = SyntaxNode;

    fn next(self: NodeChildren) -> Option[SyntaxNode] {
        while let Some(value) = self.inner.next() {
            if let Node(node) = value {
                return Option::Some(node)
            }
        }
        Option::None
    }
}

pub struct Ancestors {
    current: Ref[Option[SyntaxNode]],
}

impl Iterator for Ancestors {
    type Item = SyntaxNode;

    fn next(self: Ancestors) -> Option[SyntaxNode] {
        let value = self.current.get();
        if let Some(node) = value {
            self.current.set(node.parent());
        }
        value
    }
}

pub enum WalkEvent {
    Enter(SyntaxElement),
    Leave(SyntaxElement),
}

pub struct Walk {
    boundary: SyntaxElement,
    state: Ref[Option[WalkEvent]],
    entered: Ref[Option[SyntaxElement]],
}

impl Iterator for Walk {
    type Item = WalkEvent;

    fn next(self: Walk) -> Option[WalkEvent] {
        let event = match self.state.get() {
            Some(event) => event,
            None => return Option::None,
        };
        let next = match event {
            Enter(element) => {
                let child = match element {
                    Node(node) => node.first_child_or_token(),
                    Token(_) => Option::None,
                };
                match child {
                    Some(value) => Option::Some(WalkEvent::Enter(value)),
                    None => Option::Some(WalkEvent::Leave(element)),
                }
            },
            Leave(element) => {
                if element.same_occurrence(self.boundary) {
                    Option::None
                } else if let Some(sibling) = element.next_sibling_or_token() {
                    Option::Some(WalkEvent::Enter(sibling))
                } else {
                    element.parent().map(|parent| WalkEvent::Leave(parent.element()))
                }
            },
        };
        self.entered.set(
            match event {
                Enter(value) => Option::Some(value),
                Leave(_) => Option::None,
            },
        );
        self.state.set(next);
        Option::Some(event)
    }
}

impl Walk {
    pub fn skip_subtree(self: Walk) -> () {
        if let Some(value) = self.entered.get() {
            self.state.set(Option::Some(WalkEvent::Leave(value)));
            self.entered.set(Option::None);
        }
    }
}

pub struct Descendants {
    walk: Walk,
}

impl Iterator for Descendants {
    type Item = SyntaxElement;

    fn next(self: Descendants) -> Option[SyntaxElement] {
        while let Some(event) = self.walk.next() {
            if let Enter(value) = event {
                return Option::Some(value)
            }
        }
        Option::None
    }
}

pub struct Tokens {
    inner: Descendants,
}

impl Iterator for Tokens {
    type Item = SyntaxToken;

    fn next(self: Tokens) -> Option[SyntaxToken] {
        while let Some(value) = self.inner.next() {
            if let Token(token) = value {
                return Option::Some(token)
            }
        }
        Option::None
    }
}

pub struct NodeDescendants {
    inner: Descendants,
}

impl Iterator for NodeDescendants {
    type Item = SyntaxNode;

    fn next(self: NodeDescendants) -> Option[SyntaxNode] {
        while let Some(value) = self.inner.next() {
            if let Node(node) = value {
                return Option::Some(node)
            }
        }
        Option::None
    }
}
