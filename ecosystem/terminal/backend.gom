package terminal;

use std::io::{Error};
use std::bytes::endian;
use std::io;
use std::os::linux::fd;

fn zeroes(count: isize) -> Vec[byte] {
    let bytes = Vec::with_capacity(count);
    for _ in 0..count {
        bytes.push(0);
    }
    bytes
}

fn termios(descriptor: fd::Fd) -> Result[Vec[byte], Error] {
    let bytes = zeroes(36);
    descriptor.ioctl(0x5401, bytes.as_mut_slice())?;
    Result::Ok(bytes)
}

fn set_termios(descriptor: fd::Fd, bytes: Vec[byte]) -> Result[(), Error] {
    descriptor.ioctl(0x5402, bytes.as_mut_slice()).map(|_| ())
}

fn raw_termios(bytes: Vec[byte]) -> Vec[byte] {
    let result = bytes.as_slice().to_vec();
    let input = endian::read_u32(result.as_slice(), 0, endian::Endian::Little).unwrap_or(0);
    let output = endian::read_u32(result.as_slice(), 4, endian::Endian::Little).unwrap_or(0);
    let control = endian::read_u32(result.as_slice(), 8, endian::Endian::Little).unwrap_or(0);
    let local = endian::read_u32(result.as_slice(), 12, endian::Endian::Little).unwrap_or(0);
    let _ = endian::write_u32(result.as_mut_slice(), 0, input & 0xfffffa14, endian::Endian::Little);
    let _ = endian::write_u32(result.as_mut_slice(), 4, output & 0xfffffffe, endian::Endian::Little);
    let _ = endian::write_u32(
        result.as_mut_slice(),
        8,
        (control & 0xfffffecf) | 0x30,
        endian::Endian::Little,
    );
    let _ = endian::write_u32(result.as_mut_slice(), 12, local & 0xffff7fb4, endian::Endian::Little);
    result[22] = 0;
    result[23] = 1;
    result
}

pub fn terminal_size(descriptor: fd::Fd) -> Result[Size, Error] {
    let bytes = zeroes(8);
    descriptor.ioctl(0x5413, bytes.as_mut_slice())?;
    let rows = endian::read_u16(bytes.as_slice(), 0, endian::Endian::Little).unwrap_or(0).to_isize();
    let columns = endian::read_u16(bytes.as_slice(), 2, endian::Endian::Little).unwrap_or(0).to_isize();
    if rows == 0 || columns == 0 {
        return Result::Err(failure(io::ErrorKind::InvalidData, "terminal reports zero dimensions"))
    }
    Result::Ok(Size { columns, rows })
}

pub fn is_terminal(descriptor: fd::Fd) -> bool {
    termios(descriptor).is_ok()
}

fn mode_sequences(options: Options, enable: bool) -> string {
    let suffix = if enable {
        "h"
    } else {
        "l"
    };
    let mut result = "";
    if options.alternate_screen {
        result += "\u001b[?1049" + suffix;
    }
    if options.hide_cursor {
        result += if enable {
            "\u001b[?25l"
        } else {
            "\u001b[?25h"
        };
    }
    if options.mouse {
        result += "\u001b[?1002" + suffix + "\u001b[?1006" + suffix;
    }
    if options.focus {
        result += "\u001b[?1004" + suffix;
    }
    if options.bracketed_paste {
        result += "\u001b[?2004" + suffix;
    }
    if !enable && result != "" {
        result += "\u001b[0m";
    }
    result
}

pub fn cursor_to(column: isize, row: isize) -> Result[string, Error] {
    if column < 0 || row < 0 || column > 65534 || row > 65534 {
        return Result::Err(invalid("cursor coordinates must be in 0..65535"))
    }
    Result::Ok("\u001b[" + (row + 1).to_string() + ";" + (column + 1).to_string() + "H")
}

pub fn clear_screen() -> string {
    "\u001b[2J\u001b[H"
}

pub fn clear_line() -> string {
    "\u001b[2K\r"
}

pub fn save_cursor() -> string {
    "\u001b7"
}

pub fn restore_cursor() -> string {
    "\u001b8"
}
