package terminal;

use std::io;
pub use std::io::{Error};

#[derive(Debug, PartialEq, Eq)]
pub struct Size {
    pub columns: isize,
    pub rows: isize,
}

#[derive(Debug, PartialEq, Eq)]
pub struct Modifiers {
    pub shift: bool,
    pub alt: bool,
    pub control: bool,
}

impl Modifiers {
    pub fn none() -> Modifiers {
        Modifiers { shift: false, alt: false, control: false }
    }
}

#[derive(Debug, PartialEq, Eq)]
pub enum KeyCode {
    Char(char),
    Enter,
    Escape,
    Backspace,
    Tab,
    BackTab,
    Up,
    Down,
    Left,
    Right,
    Home,
    End,
    PageUp,
    PageDown,
    Insert,
    Delete,
    Function(isize),
}

#[derive(Debug, PartialEq, Eq)]
pub struct KeyEvent {
    pub code: KeyCode,
    pub modifiers: Modifiers,
}

#[derive(Debug, PartialEq, Eq)]
pub enum MouseButton {
    Left,
    Middle,
    Right,
    None,
}

#[derive(Debug, PartialEq, Eq)]
pub enum MouseKind {
    Press,
    Release,
    Move,
    Drag,
    ScrollUp,
    ScrollDown,
    ScrollLeft,
    ScrollRight,
}

#[derive(Debug, PartialEq, Eq)]
pub struct MouseEvent {
    pub kind: MouseKind,
    pub button: MouseButton,
    pub column: isize,
    pub row: isize,
    pub modifiers: Modifiers,
}

#[derive(Debug, PartialEq, Eq)]
pub enum Event {
    Key(KeyEvent),
    Mouse(MouseEvent),
    Paste(string),
    Focus(bool),
    Resize(Size),
    Unknown(string),
    End,
}

fn failure(kind: io::ErrorKind, message: string) -> Error {
    Error::new(kind, "terminal", Option::None, Option::None, message)
}

fn invalid(message: string) -> Error {
    failure(io::ErrorKind::InvalidInput, message)
}

fn malformed(message: string) -> Error {
    failure(io::ErrorKind::InvalidData, message)
}

pub struct DecoderOptions {
    pub max_sequence_bytes: isize,
    pub max_paste_bytes: isize,
}

impl DecoderOptions {
    pub fn defaults() -> DecoderOptions {
        DecoderOptions { max_sequence_bytes: 256, max_paste_bytes: 1048576 }
    }
}

pub struct Options {
    pub raw_mode: bool,
    pub alternate_screen: bool,
    pub hide_cursor: bool,
    pub mouse: bool,
    pub focus: bool,
    pub bracketed_paste: bool,
    pub escape_timeout_ms: i32,
    pub max_sequence_bytes: isize,
    pub max_paste_bytes: isize,
}

impl Options {
    pub fn defaults() -> Options {
        Options {
            raw_mode: false,
            alternate_screen: false,
            hide_cursor: false,
            mouse: false,
            focus: false,
            bracketed_paste: false,
            escape_timeout_ms: 30,
            max_sequence_bytes: 256,
            max_paste_bytes: 1048576,
        }
    }

    pub fn interactive() -> Options {
        Options {
            raw_mode: true,
            alternate_screen: true,
            hide_cursor: true,
            bracketed_paste: true,
            ..Options::defaults(),
        }
    }
}
