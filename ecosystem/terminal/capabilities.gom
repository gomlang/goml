package terminal;

use std::env;
use std::text;

#[derive(Debug, PartialEq, Eq)]
pub enum ColorDepth {
    None,
    Ansi16,
    Ansi256,
    TrueColor,
}

#[derive(Debug, PartialEq, Eq)]
pub enum ColorPolicy {
    Auto,
    Always,
    Never,
}

#[derive(Debug, PartialEq, Eq)]
pub struct Capabilities {
    pub input_tty: bool,
    pub output_tty: bool,
    pub interactive: bool,
    pub color: ColorDepth,
    pub hyperlinks: bool,
}

pub fn detect_capabilities(
    input_tty: bool,
    output_tty: bool,
    terminal_name: string,
    color_term: string,
    no_color: bool,
    policy: ColorPolicy,
) -> Capabilities {
    let interactive = output_tty && terminal_name != "dumb" && terminal_name != "";
    let enabled = match policy {
        ColorPolicy::Auto => interactive && !no_color,
        ColorPolicy::Always => true,
        ColorPolicy::Never => false,
    };
    let color = if !enabled {
        ColorDepth::None
    } else if color_term == "truecolor" || color_term == "24bit"
        || terminal_name.find("direct").is_some() {
        ColorDepth::TrueColor
    } else if terminal_name.find("256color").is_some() {
        ColorDepth::Ansi256
    } else {
        ColorDepth::Ansi16
    };
    Capabilities {
        input_tty,
        output_tty,
        interactive,
        color,
        hyperlinks: interactive
            && (terminal_name.find("xterm").is_some() || terminal_name.find("kitty").is_some()
                || terminal_name.find("wezterm").is_some()),
    }
}

fn environment_capabilities(input_tty: bool, output_tty: bool) -> Capabilities {
    detect_capabilities(
        input_tty,
        output_tty,
        env::var_structured("TERM").unwrap_or(""),
        env::var_structured("COLORTERM").unwrap_or(""),
        env::var_structured("NO_COLOR").map(|value| value != "").unwrap_or(false),
        ColorPolicy::Auto,
    )
}
