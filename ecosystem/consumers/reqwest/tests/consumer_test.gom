package tests;

use ecosystem::reqwest::{Client, Url, Headers};
use std::testing;
use std::bytes::{Bytes};

#[test]
fn dependency_interfaces_support_request_building() -> () {
    let client = testing::expect_ok(Client::new(), "client");
    defer client.close();
    let bytes = Bytes::from_string("original");
    let builder = client.post("https://example.invalid/path").body(bytes);
    bytes.clear();
    let request = testing::expect_ok(builder.build(), "build");
    testing::assert_eq(request.body().len(), 8);
    request.body().clear();
    testing::assert_eq(request.body().len(), 8);
    let headers = testing::expect_ok(Headers::new().append("x-many", "one"), "header");
    let headers = testing::expect_ok(headers.append("X-Many", "two"), "header");
    let request = testing::expect_ok(
        client.get("https://example.invalid").headers(headers).build(),
        "headers",
    );
    testing::assert_eq(request.headers().get_all("x-many").len(), 2);
    let url = testing::expect_ok(Url::parse("http://example.invalid:80/a"), "URL");
    testing::assert_eq(url.origin(), "http://example.invalid:80");
}
