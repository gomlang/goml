package main;

use ecosystem::cache;
use std::context;
use std::env;
use std::io;
use std::json;
use std::testing;

fn integer(value: json::Value, name: string) -> isize {
    json::field(value, name).and_then(|field| json::as_int(field)).unwrap_or(0)
}

fn string_field(value: json::Value, name: string) -> string {
    json::field(value, name).and_then(|field| json::as_string(field)).unwrap_or("")
}

fn array(value: json::Value) -> Vec[json::Value] {
    match value {
        Array(values) => values,
        _ => Vec::new(),
    }
}

fn history(case: json::Value) -> Vec[Option[string]] {
    let clock = cache::ManualClock::new();
    let options = cache::Options {
        max_weight: integer(case, "max_weight").to_i64(),
        expiry: cache::Expiry {
            ttl_ms: integer(case, "ttl_ms").to_i64(),
            tti_ms: integer(case, "tti_ms").to_i64(),
            deadline_ms: Option::None,
        },
        clock: clock.clock(),
        ..cache::Options::new(integer(case, "max_entries")),
    };
    let values: cache::Cache[isize, string] = testing::expect_ok(
        cache::Cache::new(options),
        "cache",
    );
    let output = Vec::new();
    for operation in array(json::field(case, "operations").unwrap_or(json::Value::Null)) {
        let key = integer(operation, "key");
        match string_field(operation, "op") {
            "put" => {
                let _ = testing::expect_ok(
                    values.insert(
                        key,
                        string_field(operation, "value"),
                        integer(operation, "weight").to_i64(),
                    ),
                    "insert",
                );
            },
            "get" => output.push(testing::expect_ok(values.get(key), "get")),
            "peek" => output.push(testing::expect_ok(values.peek(key), "peek")),
            "remove" => output.push(testing::expect_ok(values.remove(key), "remove")),
            "clear" => testing::assert_ok(values.clear()),
            "advance" => testing::assert_ok(clock.advance(integer(operation, "ms").to_i64())),
            _ => testing::fail("unknown operation"),
        }
        let stats = values.stats();
        testing::assert(stats.entries <= options.max_entries && stats.weight <= options.max_weight);
    }
    values.close();
    output
}

pub fn exercise() -> () {
    let values: cache::Cache[string, string] = testing::expect_ok(
        cache::Cache::new(cache::Options::new(2)),
        "cache",
    );
    let loaded = testing::expect_ok(
        values.get_or_try_insert_with(
            context::Context::background(),
            "config",
            |_| Result::Ok(cache::Loaded::new("ready", 1)),
        ),
        "load",
    );
    testing::assert_eq(loaded, "ready");
    testing::assert(testing::expect_ok(values.get("config"), "get") == Option::Some("ready"));
    values.close();
    testing::assert_eq(testing::expect_err(values.get("config"), "closed"), cache::Error::Closed);
}

fn main() -> () {
    let args = env::args();
    if args.len() > 1 && args[1] == "--json" {
        let text = testing::expect_ok(io::read_stdin_to_string(), "stdin");
        let input = testing::expect_ok(json::parse(text), "json");
        let output = Vec::new();
        for case in array(input) {
            output.push(history(case));
        }
        println(testing::expect_ok(json::try_to_string(output), "output"));
    } else {
        exercise();
        println("cache consumer: ok");
    }
}
