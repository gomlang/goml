package tests;

use consumer::csv as example;
use std::bytes;
use std::fs;
use std::io;
use std::testing;

#[test]
fn real_inventory_files_roundtrip_and_cleanup() -> () {
    let result = testing::expect_ok(example::exercise(), "inventory round trip");
    testing::assert_eq(result.summary.value_cents, 6960);
    testing::assert_eq(result.summary.units, 6);
    testing::assert(result.exported.contains("\"Tea, \"\"green\"\"\""));
    testing::assert(result.exported.contains("\"批次一\n冷藏\""));
    testing::assert(!fs::exists(result.temporary_directory));
}

#[test]
fn downstream_serde_and_generic_stream_adapters_preserve_text_and_optional_fields() -> () {
    let input = io::Cursor::new(bytes::Bytes::from_string(example::sample_source()));
    let rows = testing::expect_ok(example::import_inventory(input), "import");
    testing::assert_eq(rows[0].sku, "0042");
    testing::assert(rows[1].note.is_none());
    let output = io::Cursor::new(bytes::Bytes::new());
    testing::assert_ok(example::export_inventory(output, rows));
    testing::assert_ok(output.set_position(0));
    let reloaded = testing::expect_ok(example::import_inventory(output), "reload");
    testing::assert_eq(reloaded[0].on_hand, 4);
    testing::assert_eq(reloaded[1].name, "咖啡");
    testing::assert_eq(testing::expect_ok(example::summarize(reloaded), "summary").active_items, 2);
}

#[test]
fn invalid_rows_and_inventory_arithmetic_fail_without_silent_coercion() -> () {
    let invalid = "sku,name,on_hand,unit_cents,active,note\n0042,item,4294967296,1,true,\n";
    testing::assert(
        example::import_inventory(io::Cursor::new(bytes::Bytes::from_string(invalid))).is_err(),
    );
    let overflowing = example::Inventory {
        sku: "huge",
        name: "large value",
        on_hand: 2,
        unit_cents: 18446744073709551615,
        active: true,
        note: Option::None,
    };
    testing::assert(example::summarize(Vec::from_array([overflowing])).is_err());
    let inactive = example::Inventory { active: false, ..overflowing };
    testing::assert_eq(
        testing::expect_ok(example::summarize(Vec::from_array([inactive])), "inactive row").value_cents,
        0,
    );
}

#[test]
fn empty_inventory_export_retains_its_schema() -> () {
    let output = io::Cursor::new(bytes::Bytes::new());
    testing::assert_ok(example::export_inventory(output, Vec::new()));
    testing::assert(output.bytes().len() > 0);
    testing::assert_ok(output.set_position(0));
    let rows = testing::expect_ok(example::import_inventory(output), "empty inventory");
    testing::assert(rows.is_empty());
    testing::assert_eq(testing::expect_ok(example::summarize(rows), "empty summary").value_cents, 0);
}
