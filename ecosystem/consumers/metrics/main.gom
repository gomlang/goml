package main;

use ecosystem::metrics as metrics;
use std::bytes;
use std::context;
use std::net;
use std::task;
use std::testing;
use std::time;
use std::utf8;

pub fn application_metrics() -> metrics::Registry {
    let registry = testing::expect_ok(
        metrics::Registry::new(metrics::Options::standard()),
        "registry",
    );
    let requests = metrics::Descriptor::counter("app_requests_total", "Completed requests").with_labels(
        Vec::from_array(["method", "route"]),
    );
    let labels = testing::expect_ok(
        metrics::Labels::new(Vec::from_array([("method", "GET"), ("route", "/文档")])),
        "labels",
    );
    let counter = testing::expect_ok(registry.counter(requests, labels), "request counter");
    let active = testing::expect_ok(
        registry.gauge(
            metrics::Descriptor::gauge("app_active_requests", "Requests currently running"),
            metrics::Labels::empty(),
        ),
        "active requests",
    );
    let duration = testing::expect_ok(
        registry.histogram(
            metrics::Descriptor::histogram(
                "app_request_duration_seconds",
                "Request duration",
                testing::expect_ok(metrics::exponential_buckets(0.001, 10.0, 5), "buckets"),
            ).with_unit("seconds"),
            metrics::Labels::empty(),
        ),
        "duration",
    );
    let timer = duration.start_timer();
    testing::assert_ok(active.increment(1.0));
    testing::assert_ok(counter.add(3));
    testing::assert_ok(active.decrement(1.0));
    let _ = testing::expect_ok(timer.stop(), "record elapsed time");
    let _ = testing::expect_ok(
        registry.gauge(
            metrics::Descriptor::gauge("app_pool_idle", "Idle connections"),
            metrics::Labels::empty(),
        ),
        "pool gauge",
    );
    testing::assert_ok(
        registry.collect_gauges(
            context::Context::background(),
            |_| Result::Ok(
                Vec::from_array(
                    [
                        metrics::GaugeReading {
                            name: "app_pool_idle",
                            labels: metrics::Labels::empty(),
                            value: 8.0,
                        },
                    ],
                ),
            ),
        ),
    );
    registry
}

fn buffer() -> bytes::Bytes {
    let value = bytes::Bytes::new();
    for _ in 0..1024 {
        value.push(0);
    }
    value
}

pub fn exercise() -> () {
    let registry = application_metrics();
    context::with_timeout(
        context::Context::background(),
        time::Duration::from_seconds(5),
        |ctx, _| {
            let options = net::WaitOptions::new().with_context(ctx);
            let listener = testing::expect_ok(
                net::TcpListener::bind(
                    testing::expect_ok(net::SocketAddr::parse("127.0.0.1:0"), "address"),
                ),
                "listener",
            );
            defer {
                let _ = listener.close();
            };
            let address = testing::expect_ok(listener.local_addr(), "bound address");
            task::scope(
                |scope| {
                    let server = scope.spawn(
                        |_| {
                            let stream = testing::expect_ok(listener.accept_with(options), "accept").0;
                            defer {
                                let _ = stream.close();
                            };
                            let scratch = buffer();
                            let input = bytes::Bytes::new();
                            loop {
                                let count = testing::expect_ok(
                                    stream.read_with(scratch.as_mut_slice(), options),
                                    "read request",
                                );
                                testing::assert(count > 0);
                                input.extend_from_slice(scratch.slice(0, count));
                                testing::assert(input.len() <= 4096);
                                let request = testing::expect_ok(
                                    utf8::decode(input.to_vec()),
                                    "request text",
                                );
                                if request.contains("\r\n\r\n") {
                                    testing::assert(
                                        request.starts_with_at(0, "GET /metrics HTTP/1.1\r\n"),
                                    );
                                    break
                                }
                            }
                            let body = testing::expect_ok(
                                registry.render_with(ctx),
                                "collect metrics",
                            );
                            let response = "HTTP/1.1 200 OK\r\nContent-Type: "
                                + metrics::content_type()
                                + "\r\nContent-Length: "
                                + body.byte_len().to_string()
                                + "\r\nConnection: close\r\n\r\n"
                                + body;
                            testing::assert_ok(
                                stream.write_all_with(response.to_bytes().as_slice(), options),
                            );
                        },
                    );
                    let stream = testing::expect_ok(
                        net::TcpStream::connect_with(address, options),
                        "connect",
                    );
                    defer {
                        let _ = stream.close();
                    };
                    testing::assert_ok(
                        stream.write_all_with(
                            "GET /metrics HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n".to_bytes().as_slice(),
                            options,
                        ),
                    );
                    let received = bytes::Bytes::new();
                    let scratch = buffer();
                    loop {
                        let count = testing::expect_ok(
                            stream.read_with(scratch.as_mut_slice(), options),
                            "read response",
                        );
                        if count == 0 {
                            break
                        }
                        received.extend_from_slice(scratch.slice(0, count));
                    }
                    let response = testing::expect_ok(
                        utf8::decode(received.to_vec()),
                        "response text",
                    );
                    testing::assert(
                        response.contains(
                            "Content-Type: text/plain; version=0.0.4; charset=utf-8\r\n",
                        ),
                    );
                    testing::assert(
                        response.contains("app_requests_total{method=\"GET\",route=\"/文档\"} 3\n"),
                    );
                    testing::assert(
                        response.contains("app_request_duration_seconds_bucket{le=\"+Inf\"} 1\n"),
                    );
                    testing::assert(response.contains("app_pool_idle 8\n"));
                    server.join();
                },
            );
        },
    );
}

fn main() -> () {
    exercise();
    println("metrics consumer: native counters, collector, timer and HTTP scrape passed");
}
