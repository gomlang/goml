package main;

use std::net;
use std::io;
use std::task;
use std::testing;
use std::json;

fn line(socket: net::TcpStream) -> Result[string, io::Error] {
    let bytes: Vec[byte] = Vec::new();
    let byte = Vec::from_array([0]);
    loop {
        socket.read_exact(byte.as_mut_slice())?;
        if byte[0] == b'\n' {
            let _ = bytes.pop();
            return Result::Ok(string_from_utf8(bytes).1)
        }
        bytes.push(byte[0]);
    }
}

fn serve(socket: net::TcpStream) -> Result[(), io::Error] {
    defer {
        let _ = socket.close();
    };
    let request = line(socket)?.split(" ");
    let headers: HashMap[string, string] = HashMap::new();
    loop {
        let value = line(socket)?;
        if value == "" {
            break
        }
        if let Some((name, value)) = value.split_once(":") {
            headers.insert(name.to_ascii_lowercase(), value.trim());
        }
    }
    let mut count = 0;
    for byte in headers.get("content-length").unwrap_or("0").to_bytes() {
        count = count * 10 + (byte - b'0').to_isize();
    }
    let bytes: Vec[byte] = Vec::new();
    for _ in 0..count {
        bytes.push(0);
    }
    socket.read_exact(bytes.as_mut_slice())?;
    let body = string_from_utf8(bytes).1;
    let (path, query) = request[1].split_once("?").unwrap_or((request[1], ""));
    let mut status = "200 OK";
    let mut extra = "";
    let response = match path {
        "/echo" => testing::expect_ok(
            json::try_to_string(
                json::object(
                    Vec::from_array(
                        [
                            ("method", json::Value::String(request[0])),
                            ("query", json::Value::String(query)),
                            ("body", json::Value::String(body)),
                            (
                                "authorization",
                                json::Value::String(headers.get("authorization").unwrap_or("")),
                            ),
                            ("custom", json::Value::String(headers.get("x-custom").unwrap_or(""))),
                        ],
                    ),
                ),
            ),
            "echo JSON",
        ),
        "/json" => body,
        "/redirect" => {
            status = "302 Found";
            extra = "Location: /headers\r\n";
            ""
        },
        "/headers" => {
            extra = "X-Many: one\r\nX-Many: two\r\n";
            "headers"
        },
        "/large" => "large-response",
        "/chunked" => {
            socket.write_all(
                b"HTTP/1.1 200 OK\r\nConnection: close\r\nTransfer-Encoding: chunked\r\n\r\n9\r\nchunk-one\r\n9\r\nchunk-two\r\n0\r\n\r\n".as_slice(),
            )?;
            return Result::Ok(())
        },
        _ => "ok",
    };
    socket.write_all(
        ("HTTP/1.1 " + status + "\r\nConnection: close\r\n" + extra + "Content-Length: "
            + response.byte_len().to_string()
            + "\r\n\r\n"
            + response).to_bytes().as_slice(),
    )
}

pub fn local_http_interoperability() -> () {
    let listener = testing::expect_ok(
        net::TcpListener::bind(net::SocketAddr::new(net::IpAddr::V4([127, 0, 0, 1]), 0)),
        "listen",
    );
    let address = testing::expect_ok(listener.local_addr(), "address");
    task::scope(
        |scope| {
            defer {
                let _ = listener.close();
            };
            let _ = scope.spawn(
                |_| loop {
                    match listener.accept() {
                        Ok((socket, _)) => {
                            let _ = serve(socket);
                        },
                        Err(_) => break,
                    }
                },
            );
            exercise("http://" + address.to_string());
        },
    );
}
