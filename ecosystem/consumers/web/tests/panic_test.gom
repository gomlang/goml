package tests;

use ecosystem::web::{Router, Response};
use ecosystem::request;
use std::panic;
use std::testing;
use std::time::{Duration};

#[test]
fn consumer_observes_generic_panic_response_truncated_stream_and_healthy_server() -> () {
    let router = Router::new().get("/panic", |_| panic::raise("private consumer panic")).get(
        "/stream",
        |_| Result::Ok(
            Response::stream(
                202,
                "text/plain",
                |writer| {
                    writer.text("partial")?;
                    panic::raise("private consumer stream panic")
                },
            ),
        ),
    ).get("/healthy", |_| Result::Ok(Response::text(200, "still serving")));
    let server = testing::expect_ok(router.serve("127.0.0.1:0"), "server");
    defer {
        testing::assert_ok(server.shutdown(Duration::from_seconds(2)));
    };
    let base = "http://" + testing::expect_ok(server.address(), "address");
    let client = testing::expect_ok(request::Client::new(), "client");
    defer client.close();
    let response = testing::expect_ok(client.get(base + "/panic").send(), "panic response");
    testing::assert_eq(response.status().as_isize(), 500);
    testing::assert_eq(testing::expect_ok(response.text(), "panic body"), "internal server error");
    testing::assert(client.get(base + "/stream").send().is_err());
    let response = testing::expect_ok(client.get(base + "/healthy").send(), "request after panic");
    testing::assert_eq(response.status().as_isize(), 200);
    testing::assert_eq(testing::expect_ok(response.text(), "healthy body"), "still serving");
}
