package tests;

use ecosystem::web::{Router, Headers, Response, Error, Event};
use ecosystem::request;
use std::bytes::{Bytes};
use std::testing;
use std::serde::{Serialize, Deserialize};
use std::io;
use std::time;
use std::task;

#[derive(Serialize, Deserialize)]
struct Payload {
    label: string,
    values: Vec[u16],
}

fn exchange(client: request::Client, base: string, index: isize) -> Result[Payload, request::Error] {
    client.post(base + "/typed").json(
        Payload {
            label: "client " + index.to_string(),
            values: Vec::from_array([index.to_u16(), 41]),
        },
    ).send()?.json()
}

#[test]
fn independent_client_and_server_native_dependencies_compose() -> () {
    let router = Router::new().post(
        "/typed",
        |request| {
            let value: Payload = request.json()?;
            value.values[1] += 1;
            Response::json(201, value)
        },
    ).get(
        "/events",
        |_| Result::Ok(
            Response::sse(
                |writer| {
                    writer.event(Event::new("first"))?;
                    writer.event(Event::new("中😀"))
                },
            ),
        ),
    );
    let server = testing::expect_ok(router.serve("127.0.0.1:0"), "server");
    defer {
        testing::assert_ok(server.shutdown(time::Duration::from_seconds(2)));
    };
    let base = "http://" + testing::expect_ok(server.address(), "address");
    let client = testing::expect_ok(request::Client::new(), "client");
    defer client.close();
    task::scope(
        |scope| {
            let calls = Vec::new();
            for index in 0..16 {
                calls.push(scope.spawn(|_| exchange(client, base, index)));
            }
            for index in 0..calls.len() {
                let value = testing::expect_ok(calls[index].join(), "typed request and response");
                testing::assert_eq(value.label, "client " + index.to_string());
                testing::assert_eq(value.values[0], index.to_u16());
                testing::assert_eq(value.values[1], 42);
            }
        },
    );
    let events = testing::expect_ok(client.get(base + "/events").send(), "streamed events");
    testing::assert_eq(
        testing::expect_ok(events.text(), "event text"),
        "data: first\n\ndata: 中😀\n\n",
    );
}

#[test]
fn versioned_dependency_exposes_typed_routes_and_middleware() -> () {
    let router = Router::new().get(
        "/{name}",
        |request| {
            Response::json(
                200,
                Payload {
                    label: request.params().required("name")?,
                    values: Vec::from_array([3, 4]),
                },
            )
        },
    ).layer(|request, next| Result::Ok(next.run(request)?.header("x-consumer", "yes")));
    let response = testing::expect_ok(
        router.dispatch("GET", "/%E4%B8%AD", Headers::new(), Bytes::new()),
        "dispatch",
    );
    let value: Payload = testing::expect_ok(response.json(), "generic deserialize");
    testing::assert_eq(value.label, "中");
    testing::assert_eq(value.values[1], 4);
    testing::assert(response.headers.get("x-consumer") == Option::Some("yes"));
}

#[test]
fn public_stream_and_serde_form_interfaces_specialize_downstream() -> () {
    let router = Router::new().get(
        "/",
        |request| {
            let value: Payload = request.query_as()?;
            Result::Ok(
                Response::sse(
                    |writer| writer.event(Event::new(value.label + value.values[0].to_string())),
                ),
            )
        },
    );
    let response = testing::expect_ok(
        router.dispatch("GET", "/?label=item&values=42", Headers::new(), Bytes::new()),
        "dispatch",
    );
    testing::assert_eq(testing::expect_ok(response.text(), "text"), "data: item42\n\n");
    let copied = Router::new().post(
        "/",
        |request| Result::Ok(
            Response::stream(
                200,
                "text/plain",
                |writer| {
                    let _ = io::copy(request.body(), writer).map_err(
                        |error| Error::new(ecosystem::web::ErrorKind::Transport, error.to_string()),
                    )?;
                    Result::Ok(())
                },
            ),
        ),
    );
    let response = testing::expect_ok(
        copied.dispatch("POST", "/", Headers::new(), Bytes::from_string("copy")),
        "copy",
    );
    testing::assert_eq(testing::expect_ok(response.text(), "text"), "copy");
}
