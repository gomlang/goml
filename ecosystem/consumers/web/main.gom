package main;

use ecosystem::web::{Router, Headers, Response, Error, ErrorKind, Limits, Event};
use ecosystem::web::testing as web_testing;
use ecosystem::web::proxy;
use ecosystem::request;
use std::serde::{Serialize, Deserialize};
use std::bytes::{Bytes};
use std::env;
use std::io;
use std::time::{Duration};
use std::testing;

#[derive(Serialize, Deserialize)]
struct Message {
    name: string,
    count: isize,
}

#[derive(Serialize, Deserialize)]
struct Form {
    label: string,
    count: isize,
    enabled: bool,
    tag: Vec[string],
}

pub fn app() -> Router {
    let counter: Channel[isize] = Channel::new(1);
    let active: Channel[isize] = Channel::new(1);
    counter.send(0);
    active.send(0);
    let api = Router::new().get(
        "/users/{id}",
        |request| {
            Response::json(200, Message { name: request.params().required("id")?, count: 1 })
        },
    ).post(
        "/json",
        |request| {
            let value: Message = request.json()?;
            Response::json(201, Message { name: value.name, count: value.count + 1 })
        },
    ).get(
        "/query",
        |request| {
            let value: Form = request.query_as()?;
            Response::json(200, value)
        },
    ).post(
        "/form",
        |request| {
            let value: Form = request.form_as()?;
            Response::json(200, value)
        },
    );
    Router::new().nest("/api", api).get("/", |_| Result::Ok(Response::text(200, "web consumer"))).get(
        "/files/{*path}",
        |request| Result::Ok(Response::text(200, request.params().required("path")?)),
    ).get(
        "/counter",
        |_| {
            let count = counter.recv().unwrap_or(0) + 1;
            counter.send(count);
            Response::json(200, Message { name: "counter", count })
        },
    ).get(
        "/active",
        |_| {
            let count = active.recv().unwrap_or(0);
            active.send(count);
            Response::json(200, Message { name: "active", count })
        },
    ).post(
        "/stream",
        |request| {
            Result::Ok(
                Response::stream(
                    200,
                    "application/octet-stream",
                    |writer| {
                        let _ = io::copy(request.body(), writer).map_err(
                            |error| Error::new(ErrorKind::Transport, error.to_string()),
                        )?;
                        Result::Ok(())
                    },
                ),
            )
        },
    ).get(
        "/events",
        |request| Result::Ok(
            Response::sse(
                |writer| {
                    for i in 0..3 {
                        writer.event(
                            Event {
                                id: Option::Some(i.to_string()),
                                ..Event::new("value " + i.to_string()),
                            },
                        )?;
                        request.wait(Duration::from_milliseconds(20))?;
                    }
                    Result::Ok(())
                },
            ),
        ),
    ).get(
        "/forever",
        |request| Result::Ok(
            Response::sse(
                |writer| {
                    active.send(active.recv().unwrap_or(0) + 1);
                    defer active.send(active.recv().unwrap_or(0) - 1);
                    loop {
                        writer.event(Event::new("tick"))?;
                        request.wait(Duration::from_milliseconds(10))?;
                    }
                },
            ),
        ),
    ).get(
        "/slow",
        |request| {
            request.wait(Duration::from_seconds(5))?;
            Result::Ok(Response::new(200))
        },
    ).get(
        "/headers",
        |_| Result::Ok(
            Response::text(200, "headers").append_header("set-cookie", "a=1; Path=/").append_header(
                "set-cookie",
                "b=2; Path=/",
            ),
        ),
    ).get("/redirect", |_| Response::redirect(307, "/headers")).layer(
        |request, next| {
            Result::Ok(next.run(request)?.header("x-web", "goml"))
        },
    ).limits(
        Limits {
            body_bytes: 262144,
            extraction_bytes: 16384,
            request_timeout: Duration::from_seconds(2),
            ..Limits::new(),
        },
    )
}

pub fn proxy_smoke() -> () {
    let backend = testing::expect_ok(
        web_testing::TestServer::start(
            Router::new().get("/base/ping", |_| Result::Ok(Response::text(200, "proxied"))),
        ),
        "backend server",
    );
    defer {
        let _ = backend.shutdown(Duration::from_seconds(2));
    };
    let outbound = testing::expect_ok(request::Client::new(), "proxy client");
    defer outbound.close();
    let handler = testing::expect_ok(
        proxy::Proxy::new(backend.base_url() + "/base", outbound, 1024, 1024),
        "reverse proxy",
    ).handler();
    let frontend = testing::expect_ok(
        web_testing::TestServer::start(Router::new().fallback(handler)),
        "frontend server",
    );
    defer {
        let _ = frontend.shutdown(Duration::from_seconds(2));
    };
    let client = testing::expect_ok(request::Client::new(), "request client");
    defer client.close();
    let reply = testing::expect_ok(client.get(frontend.base_url() + "/ping").send(), "proxy reply");
    testing::assert_eq(testing::expect_ok(reply.text(), "proxy body"), "proxied");
}

fn main() -> () {
    let args = env::args();
    let router = app();
    if args.len() > 1 && args[1] == "--serve" {
        let server = testing::expect_ok(router.serve("127.0.0.1:0"), "serve");
        println(testing::expect_ok(server.address(), "address"));
        let _ = io::read_stdin_to_string();
        testing::expect_ok(server.shutdown(Duration::from_seconds(3)), "shutdown");
    } else {
        let recorder = web_testing::Recorder::new(router);
        let reply = testing::expect_ok(
            recorder.request("GET", "/api/users/external").send(),
            "recorded dispatch",
        );
        let value: Message = testing::expect_ok(reply.json(), "json");
        testing::assert_eq(value.name, "external");
        testing::assert_eq(recorder.exchanges().len(), 1);
        let failure = web_testing::FaultTransport::new(
            router,
            Vec::from_array([web_testing::Fault::Reject(ErrorKind::Transport)]),
        );
        testing::assert_err(failure.dispatch("GET", "/", Headers::new(), Bytes::new()));
        let server = testing::expect_ok(web_testing::TestServer::start(router), "server");
        testing::expect_ok(server.shutdown(Duration::from_seconds(1)), "shutdown");
        proxy_smoke();
        println(
            "web independent consumer: routing, typed JSON, middleware and server lifecycle passed",
        );
    }
}
