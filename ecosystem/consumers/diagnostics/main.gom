package main;

use ecosystem::diagnostics;
use ecosystem::ansi;
use ecosystem::unicode_text;
use std::env;
use std::bytes;
use std::io;
use std::num;
use std::encoding::hex;
use std::utf8;
use utf8::BytesUtf8;
use std::testing;

pub fn sample() -> string {
    let cache = diagnostics::SourceCache::new();
    let file = testing::expect_ok(
        cache.add("src/main.gom", "fn main() {\n\tlet 世界 = old;\n}\n"),
        "source",
    );
    let span = testing::expect_ok(cache.span(file, 26, 29), "span");
    let suggestion = diagnostics::Suggestion::new(
        "use the current value",
        diagnostics::Applicability::MachineApplicable,
    ).with_edit(diagnostics::Edit::new(span, "new"));
    let report = diagnostics::Diagnostic::new(diagnostics::Severity::Error, "unresolved name").with_code(
        "E404",
    ).with_label(diagnostics::Label::primary(span, "not declared in this scope")).with_help(
        "declare the value before using it",
    ).with_suggestion(suggestion);
    testing::expect_ok(
        diagnostics::render(cache, report, diagnostics::RenderOptions::new()),
        "render",
    )
}

fn integer(value: string) -> isize {
    testing::expect_ok(num::parse_int_structured(value), "integer")
}

fn decoded(value: string) -> string {
    testing::expect_ok(testing::expect_ok(hex::decode(value), "hex").to_string_utf8(), "utf8")
}

fn encoded(value: string) -> string {
    hex::encode(bytes::Bytes::from_vec(value.to_bytes()))
}

fn oracle_line(fields: Vec[string]) -> Result[string, diagnostics::Error] {
    let cache = diagnostics::SourceCache::new();
    let file = cache.add("source", decoded(fields[1]))?;
    let source = cache.get(file)?;
    match fields[0] {
        "location" => {
            let location = source.location(
                integer(fields[2]),
                unicode_text::WidthOptions::new(),
                integer(fields[3]),
            )?;
            Result::Ok(f"{location.line},{location.byte_column},{location.display_column}")
        },
        "span" => Result::Ok(
            encoded(cache.text(cache.span(file, integer(fields[2]), integer(fields[3]))?)?),
        ),
        "edit" => {
            let mut suggestion = diagnostics::Suggestion::new(
                "fix",
                diagnostics::Applicability::MachineApplicable,
            );
            for index in 3..fields.len() {
                let pieces = fields[index].split(":");
                suggestion = suggestion.with_edit(
                    diagnostics::Edit::new(
                        cache.span(file, integer(pieces[0]), integer(pieces[1]))?,
                        decoded(pieces[2]),
                    ),
                );
            }
            let limits = diagnostics::EditLimits {
                max_output_bytes: integer(fields[2]),
                ..diagnostics::EditLimits::new(),
            };
            suggestion.validate(cache, limits)?;
            let changed = suggestion.apply(cache, limits)?;
            Result::Ok(
                encoded(
                    if changed.is_empty() {
                        source.text()
                    } else {
                        changed[0].updated
                    },
                ),
            )
        },
        "render" => {
            let report = diagnostics::Diagnostic::new(diagnostics::Severity::Error, "message").with_label(
                diagnostics::Label::primary(
                    cache.span(file, integer(fields[3]), integer(fields[4]))?,
                    "label",
                ),
            );
            let profile = if fields[5] == "ansi" {
                ansi::Profile::TrueColor
            } else {
                ansi::Profile::Plain
            };
            let options = diagnostics::RenderOptions {
                columns: integer(fields[2]),
                context_lines: 0,
                profile,
                ..diagnostics::RenderOptions::new(),
            };
            Result::Ok(encoded(diagnostics::render(cache, report, options)?))
        },
        _ => Result::Ok("unknown"),
    }
}

fn main() -> () {
    if env::args().len() > 1 {
        let input = testing::expect_ok(io::read_stdin_to_string(), "stdin");
        for row in input.split("\n") {
            if row == "" {
                continue;
            }
            match oracle_line(row.split("\t")) {
                Ok(value) => println(value),
                Err(_) => println("error"),
            }
        }
    } else {
        println(sample());
    }
}

pub fn reference_case(line: string) -> string {
    oracle_line(line.split("\t")).unwrap_or("error")
}
