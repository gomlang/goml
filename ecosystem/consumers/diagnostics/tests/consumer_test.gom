package tests;

use consumer::diagnostics as application;
use ecosystem::ansi;
use ecosystem::diagnostics;
use ecosystem::unicode_text;
use std::testing;

#[test]
fn source_reports_render_through_external_public_interfaces() -> () {
    let output = application::sample();
    testing::assert(output.contains("error[E404]: unresolved name"));
    testing::assert(output.contains("世界 = old;"));
    testing::assert(output.contains("^^^ not declared in this scope"));
    testing::assert(output.contains("machine applicable"));
    testing::assert(output.contains("   + new\n"));
}

#[test]
fn reusable_renderer_respects_theme_and_explicit_width_policy() -> () {
    let cache = diagnostics::SourceCache::new();
    let file = testing::expect_ok(cache.add("external", "·😀\tend"), "file");
    let span = testing::expect_ok(cache.span(file, 7, 10), "span");
    let options = diagnostics::RenderOptions {
        profile: ansi::Profile::TrueColor,
        width: unicode_text::WidthOptions { ambiguous_wide: true, emoji_wide: false },
        theme: diagnostics::Theme {
            warning: ansi::Style::new().foreground(ansi::Color::Rgb(80, 90, 100)),
            ..diagnostics::Theme::new(),
        },
        ..diagnostics::RenderOptions::new(),
    };
    let renderer = testing::expect_ok(diagnostics::Renderer::new(options), "renderer");
    let report = diagnostics::Diagnostic::new(diagnostics::Severity::Warning, "custom").with_label(
        diagnostics::Label::primary(span, "label"),
    );
    let output = testing::expect_ok(renderer.render(cache, report), "first");
    testing::assert(output.contains("38;2;80;90;100"));
    testing::assert_eq(testing::expect_ok(renderer.render(cache, report), "second"), output);
    let plain = testing::expect_ok(ansi::parse(output), "ansi").plain_text();
    testing::assert(plain.contains("external:1:5"));
}

#[test]
fn suggestion_updates_are_returned_for_application_owned_publication() -> () {
    let cache = diagnostics::SourceCache::new();
    let first = testing::expect_ok(cache.add("original", "hello"), "source");
    let suggestion = diagnostics::Suggestion::new(
        "append",
        diagnostics::Applicability::MachineApplicable,
    ).with_edit(
        diagnostics::Edit::new(testing::expect_ok(cache.span(first, 5, 5), "span"), " world"),
    );
    let changes = testing::expect_ok(
        suggestion.apply(cache, diagnostics::EditLimits::new()),
        "apply",
    );
    let next = testing::expect_ok(cache.add(changes[0].name, changes[0].updated), "revision");
    testing::assert(first != next);
    testing::assert_eq(testing::expect_ok(cache.get(first), "first").text(), "hello");
    testing::assert_eq(testing::expect_ok(cache.get(next), "next").text(), "hello world");
    testing::assert_eq(suggestion.applicability, diagnostics::Applicability::MachineApplicable);
}
