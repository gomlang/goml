package tests;

use consumer::diagnostics as application;
use std::testing;
use std::fs;
use std::json;
use std::encoding::hex;
use std::utf8;
use ecosystem::ansi;

fn field(value: json::Value, name: string) -> json::Value {
    testing::expect_some(json::field(value, name), "reference field " + name)
}

fn reference_rows() -> Vec[json::Value] {
    let source = testing::expect_ok(
        fs::read_file_structured("tests/data/reference.jsonl"),
        "reference vectors",
    );
    let rows = Vec::new();
    for line in source.split("\n") {
        if line != "" {
            rows.push(testing::expect_ok(json::parse(line), "reference JSON"));
        }
    }
    rows
}

#[test]
fn independent_source_locations_edits_and_render_properties() -> () {
    let rows = reference_rows();
    testing::assert_eq(rows.len(), 6236);
    let mut previous = "";
    for row in rows {
        let input = testing::expect_some(json::as_string(field(row, "input")), "input");
        let actual = application::reference_case(input);
        let expected = field(row, "expected");
        if let Some(text) = json::as_string(expected) {
            testing::assert_eq(actual, text);
            continue;
        }
        let expected = testing::expect_some(json::as_array(expected), "render properties");
        let columns = testing::expect_some(json::as_int(expected[0]), "columns");
        let profile = testing::expect_some(json::as_string(expected[1]), "profile");
        let source = testing::expect_some(json::as_string(expected[2]), "source");
        let start = testing::expect_some(json::as_int(expected[3]), "start");
        let end = testing::expect_some(json::as_int(expected[4]), "end");
        let data = testing::expect_ok(hex::decode(actual), "render hex");
        let decoded = testing::expect_ok(utf8::decode_slice(data.as_slice()), "render UTF-8");
        let plain = testing::expect_ok(ansi::strip(decoded), "strip render");
        for line in plain.split("\n") {
            testing::assert(line.len() <= columns);
        }
        testing::assert(plain.contains("^") && plain.contains("label"));
        if profile == "plain" {
            previous = plain;
        } else {
            testing::assert_eq(plain, previous);
            testing::assert(decoded.contains("\u001b["));
        }
        if columns >= source.len() + 20 && end - start <= 5 && start <= 5 {
            let expected_line = "  |   " + " ".repeat(start)
                + "^".repeat(
                    if end > start {
                        end - start
                    } else {
                        1
                    },
                )
                + " label\n";
            testing::assert(plain.contains(expected_line));
        }
    }
}
