package main;

use ecosystem::prompt;
use prompt::Model;
use ecosystem::terminal;
use ecosystem::tui;
use std::context;
use std::env;
use std::testing;
use std::time;

pub fn exercise() -> () {
    let input = testing::expect_ok(prompt::integer("Port", 1, 65535), "port prompt");
    testing::expect_ok(input.update(terminal::Event::Paste("8080")), "type port");
    testing::assert(
        match testing::expect_ok(input.submit(), "submit port") {
            Submitted(value) => value == 8080,
            _ => false,
        },
    );
    let select = testing::expect_ok(
        prompt::Select::new(
            "Language",
            Vec::from_array([prompt::Choice::new("GoML", "goml"), prompt::Choice::new("Go", "go")]),
        ),
        "language prompt",
    );
    let buffer = testing::expect_ok(tui::Buffer::new(40, 6), "buffer");
    testing::expect_ok(select.render(buffer), "select render");
    testing::assert(buffer.lines().join("\n").contains("GoML"));
    testing::expect_ok(buffer.validate(), "valid frame");
}

struct Broken {}

impl Model for Broken {
    type Output = string;

    fn update(self: Broken, event: terminal::Event) -> Result[
        prompt::Outcome[string],
        prompt::Error,
    ] {
        Result::Ok(prompt::Outcome::Pending)
    }

    fn render(self: Broken, buffer: tui::Buffer) -> Result[(), tui::Error] {
        Result::Err(tui::Error { message: "deliberate render failure" })
    }
}

fn interactive(mode: string) -> Result[string, prompt::Error] {
    let background = context::Context::background();
    if mode == "password" {
        let secret = prompt::interact(prompt::password("Secret")?, background)?;
        return Result::Ok(f"secret-bytes={secret.byte_len()}")
    }
    if mode == "integer" {
        let value = prompt::interact(prompt::integer("Port", 1, 65535)?, background)?;
        return Result::Ok(value.to_string())
    }
    if mode == "select" {
        return prompt::interact(
            prompt::Select::new(
                "Language",
                Vec::from_array(
                    [
                        prompt::Choice::new("GoML", "goml"),
                        prompt::Choice::new("Rust", "rust"),
                        prompt::Choice::new("中文", "zh"),
                    ],
                ),
            )?,
            background,
        )
    }
    if mode == "broken" {
        return prompt::interact(Broken {}, background)
    }
    let input = prompt::text("Name")?;
    if mode == "timeout" {
        context::with_timeout(
            background,
            time::Duration::from_milliseconds(100),
            |context, _| {
                prompt::interact(input, context)
            },
        )
    } else {
        prompt::interact(input, background)
    }
}

fn main() -> () {
    let args = env::args();
    if args.len() <= 1 {
        exercise();
        println("prompt consumer: typed validation, selection and rendering passed");
    } else {
        match interactive(args[1]) {
            Ok(value) => println("RESULT " + value),
            Err(error) => println("ERROR " + error.to_string()),
        }
    }
}
