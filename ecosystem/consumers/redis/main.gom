package main;

use ecosystem::redis;
use ecosystem::redis::{Value, Blob, FromReply, Error, ErrorKind, Request, Connection, ConnectionOptions, Protocol, Credentials, Operation, Pipeline, TransactionOutcome, SubscriptionKind, Event};
use ecosystem::redis::commands as cmd;
use std::env;
use std::io;
use std::json;
use std::net;
use std::process;
use std::testing;
use std::time;

pub struct Revision {
    pub number: i64,
}

impl FromReply for Revision {
    fn from_reply(value: Value) -> Result[Revision, Error] {
        Result::Ok(Revision { number: FromReply::from_reply(value)? })
    }
}

fn run_request[T](connection: Connection, request: Result[Request[T], Error]) -> T {
    let request = testing::expect_ok(request, "create request");
    testing::expect_ok(connection.execute(request, Operation::new()), request.command().name())
}

fn text(blob: Blob) -> string {
    testing::expect_ok(blob.text(), "UTF-8")
}

fn present(value: Option[Blob]) -> string {
    text(testing::expect_some(value, "present blob"))
}

pub fn exercise() -> () {
    let value: Revision = testing::expect_ok(
        FromReply::from_reply(Value::Integer(42)),
        "consumer FromReply",
    );
    testing::assert_eq(value.number, 42);
    let request: Request[Revision] = testing::expect_ok(
        redis::request("INCR", Vec::from_array(["key".to_bytes()])),
        "custom request",
    );
    let pipeline = Pipeline::new();
    let ticket = pipeline.queue(request);
    testing::assert_eq(ticket.index(), 0);
    let encoded = testing::expect_ok(
        redis::encode(Value::Attribute(Vec::new(), Value::Bulk("中文".to_bytes()))),
        "codec",
    );
    let decoded: Blob = testing::expect_ok(
        FromReply::from_reply(testing::expect_ok(redis::decode(encoded.as_slice()), "decode")),
        "reply",
    );
    testing::assert_eq(text(decoded), "中文");
}

fn live(address: string, version: string, password: string) -> () {
    let address = testing::expect_ok(net::SocketAddr::parse(address), "address");
    let options = ConnectionOptions {
        protocol: if version == "2" {
            Protocol::Resp2
        } else {
            Protocol::Resp3
        },
        credentials: if password == "" {
            Option::None
        } else {
            Option::Some(Credentials { username: "default", password: Blob::from_string(password) })
        },
        database: 1,
        client_name: Option::Some("goml-ecosystem"),
        ..ConnectionOptions::standard(),
    };
    let connect = || testing::expect_ok(
        Connection::connect(address, options, Operation::new()),
        "real Redis connect",
    );
    let connection = connect();
    let other = connect();
    let prefix = "goml:" + version + ":";
    let key = prefix + "string";
    let list = prefix + "list";
    let hash = prefix + "hash";
    let set = prefix + "set";
    let sorted = prefix + "sorted";
    let counter = prefix + "counter";
    let missing = prefix + "missing";
    let defaults = cmd::SetOptions::standard();
    testing::assert_eq(run_request(connection, cmd::ping()), "PONG");
    testing::assert(run_request(connection, cmd::client_id()) > 0);
    let binary = Blob { bytes: Vec::from_array([0, 255, 13, 10]) };
    testing::assert(run_request(connection, cmd::echo(binary)) == binary);
    testing::assert(run_request(connection, cmd::set(key, binary, defaults)));
    testing::assert(
        testing::expect_some(run_request(connection, cmd::get(key)), "binary get") == binary,
    );
    testing::assert(run_request(connection, cmd::get(missing)).is_none());
    testing::assert(
        !run_request(
            connection,
            cmd::set(
                key,
                "ignored",
                cmd::SetOptions { condition: cmd::SetCondition::IfAbsent, ..defaults },
            ),
        ),
    );
    testing::assert(
        run_request(
            connection,
            cmd::set(
                key,
                "hello",
                cmd::SetOptions {
                    condition: cmd::SetCondition::IfPresent,
                    expiration: cmd::Expiration::Seconds(100),
                },
            ),
        ),
    );
    testing::assert_eq(run_request(connection, cmd::strlen(key)), 5);
    testing::assert(run_request(connection, cmd::ttl(key)) > 0);
    testing::assert(run_request(connection, cmd::pttl(key)) > 0);
    testing::assert(run_request(connection, cmd::persist(key)));
    testing::assert_eq(run_request(connection, cmd::ttl(key)), -1);
    testing::assert_eq(run_request(connection, cmd::append(key, "!")), 6);
    testing::assert_eq(
        present(run_request(connection, cmd::set_get(key, "next", defaults))),
        "hello!",
    );
    testing::assert_eq(run_request(connection, cmd::exists(Vec::from_array([key, missing]))), 1);
    let many = run_request(connection, cmd::mget(Vec::from_array([key, missing])));
    testing::assert_eq(present(many[0]), "next");
    testing::assert(many[1].is_none());
    run_request(
        connection,
        cmd::mset(Vec::from_array([(prefix + "m1", "1"), (prefix + "m2", "2")])),
    );
    testing::assert_eq(
        run_request(connection, cmd::unlink(Vec::from_array([prefix + "m1", prefix + "m2"]))),
        2,
    );
    testing::assert_eq(
        run_request(connection, cmd::rpush(list, Vec::from_array(["a", "b", "c"]))),
        3,
    );
    testing::assert_eq(run_request(connection, cmd::lpush(list, Vec::from_array(["z"]))), 4);
    testing::assert_eq(run_request(connection, cmd::llen(list)), 4);
    testing::assert_eq(run_request(connection, cmd::lrange(list, 0, -1)).len(), 4);
    testing::assert_eq(present(run_request(connection, cmd::lpop(list))), "z");
    testing::assert_eq(present(run_request(connection, cmd::rpop(list))), "c");
    let popped = testing::expect_some(
        run_request(connection, cmd::blpop(Vec::from_array([list]), 0.0)),
        "blocking pop ready",
    );
    testing::assert_eq(text(popped.1), "a");
    testing::assert_eq(
        run_request(connection, cmd::hset(hash, Vec::from_array([("a", "1"), ("b", "2")]))),
        2,
    );
    testing::assert_eq(run_request(connection, cmd::hlen(hash)), 2);
    testing::assert_eq(present(run_request(connection, cmd::hget(hash, "a"))), "1");
    testing::assert_eq(run_request(connection, cmd::hincrby(hash, "a", 2)), 3);
    testing::assert_eq(run_request(connection, cmd::hgetall(hash)).entries.len(), 2);
    let fields = run_request(connection, cmd::hmget(hash, Vec::from_array(["a", "absent"])));
    testing::assert_eq(present(fields[0]), "3");
    testing::assert(fields[1].is_none());
    testing::assert_eq(
        run_request(connection, cmd::hscan(hash, 0, Option::None, Option::Some(100))).1.entries.len(),
        2,
    );
    testing::assert_eq(run_request(connection, cmd::hdel(hash, Vec::from_array(["b"]))), 1);
    testing::assert_eq(run_request(connection, cmd::sadd(set, Vec::from_array(["a", "b", "a"]))), 2);
    testing::assert_eq(run_request(connection, cmd::scard(set)), 2);
    testing::assert(run_request(connection, cmd::sismember(set, "b")));
    testing::assert_eq(run_request(connection, cmd::smembers(set)).len(), 2);
    testing::assert_eq(
        run_request(connection, cmd::sscan(set, 0, Option::None, Option::Some(100))).1.len(),
        2,
    );
    testing::assert_eq(run_request(connection, cmd::srem(set, Vec::from_array(["b"]))), 1);
    testing::assert_eq(
        run_request(connection, cmd::zadd(sorted, Vec::from_array([(1.25, "a"), (2.5, "b")]))),
        2,
    );
    testing::assert_eq(run_request(connection, cmd::zcard(sorted)), 2);
    testing::assert_eq(
        testing::expect_some(run_request(connection, cmd::zscore(sorted, "a")), "score"),
        1.25,
    );
    testing::assert_eq(run_request(connection, cmd::zincrby(sorted, 0.75, "a")), 2.0);
    let scores = run_request(connection, cmd::zrange(sorted, 0, -1));
    testing::assert_eq(scores.entries.len(), 2);
    testing::assert_eq(scores.entries[0].1, 2.0);
    testing::assert_eq(run_request(connection, cmd::zrem(sorted, Vec::from_array(["b"]))), 1);
    testing::assert_eq(run_request(connection, cmd::key_type(sorted)), "zset");
    let source = "return {ARGV[1], redis.call('GET', KEYS[1])}";
    let script: Request[Vec[Blob]] = testing::expect_ok(
        cmd::eval(source, Vec::from_array([key]), Vec::from_array(["script"])),
        "eval",
    );
    let script_result = run_request(connection, Result::Ok(script));
    testing::assert_eq(text(script_result[0]), "script");
    testing::assert_eq(text(script_result[1]), "next");
    let sha = run_request(connection, cmd::script_load(source));
    let script: Request[Vec[Blob]] = testing::expect_ok(
        cmd::evalsha(sha, Vec::from_array([key]), Vec::from_array(["cached"])),
        "evalsha",
    );
    testing::assert_eq(text(run_request(connection, Result::Ok(script))[0]), "cached");
    let mut cursor = 0;
    let mut found = 0;
    loop {
        let page = run_request(
            connection,
            cmd::scan(cursor, Option::Some(Blob::from_string(prefix + "*")), Option::Some(2)),
        );
        cursor = page.0;
        found += page.1.len();
        if cursor == 0 {
            break;
        }
    }
    testing::assert(found >= 5);
    let pipeline = Pipeline::new();
    let first = pipeline.queue(testing::expect_ok(cmd::incrby(counter, 1), "increment"));
    let wrong = pipeline.queue(testing::expect_ok(cmd::get(hash), "wrong type"));
    let last = pipeline.queue(
        testing::expect_ok(cmd::echo("mapped"), "echo").map(|value| Result::Ok(text(value) + "!")),
    );
    let responses = testing::expect_ok(connection.pipeline(pipeline, Operation::new()), "pipeline");
    testing::assert_eq(testing::expect_ok(responses.get(first), "first"), 1);
    testing::assert_eq(
        testing::expect_err(responses.get(wrong), "middle server error").kind,
        ErrorKind::Server,
    );
    testing::assert_eq(testing::expect_ok(responses.get(last), "last"), "mapped!");
    let custom: Request[Revision] = testing::expect_ok(
        redis::request("INCR", Vec::from_array([counter.to_bytes()])),
        "custom request",
    );
    testing::assert_eq(run_request(connection, Result::Ok(custom)).number, 2);
    let transaction = Pipeline::new();
    let first = transaction.queue(testing::expect_ok(cmd::incrby(counter, 1), "increment"));
    let wrong = transaction.queue(testing::expect_ok(cmd::get(hash), "wrong type"));
    let last = transaction.queue(testing::expect_ok(cmd::incrby(counter, 1), "increment"));
    let TransactionOutcome::Committed(results) = testing::expect_ok(
        connection.transaction(transaction, Operation::new()),
        "transaction",
    ) else {
        testing::fail("commit");
        return
    };
    testing::assert_eq(testing::expect_ok(results.get(first), "first"), 3);
    testing::assert_eq(
        testing::expect_err(results.get(wrong), "execution error").kind,
        ErrorKind::Server,
    );
    testing::assert_eq(testing::expect_ok(results.get(last), "no rollback"), 4);
    let rejected = Pipeline::new();
    let bad: Request[Value] = testing::expect_ok(
        redis::request("DOES_NOT_EXIST", Vec::new()),
        "unknown",
    );
    let _ = rejected.queue(bad);
    let _ = rejected.queue(testing::expect_ok(cmd::incrby(counter, 100), "must discard"));
    let TransactionOutcome::Rejected(errors) = testing::expect_ok(
        connection.transaction(rejected, Operation::new()),
        "rejected transaction",
    ) else {
        testing::fail("reject queue error");
        return
    };
    testing::assert_eq(errors.len(), 1);
    testing::assert_eq(present(run_request(connection, cmd::get(counter))), "4");
    for conflict in Vec::from_array([false, true]) {
        let reads = Pipeline::new();
        let read = reads.queue(testing::expect_ok(cmd::get(counter), "read"));
        let outcome = testing::expect_ok(
            connection.compare_and_set(
                Vec::from_array([Blob::from_string(counter)]),
                reads,
                |responses| {
                    testing::assert(responses.get(read)?.is_some());
                    if conflict {
                        let _ = run_request(other, cmd::incrby(counter, 10));
                    }
                    let plan = Pipeline::new();
                    let _ = plan.queue(cmd::incrby(counter, 1)?);
                    Result::Ok(plan)
                },
                Operation::new(),
            ),
            "WATCH",
        );
        testing::assert(
            match outcome {
                TransactionOutcome::Aborted => conflict,
                TransactionOutcome::Committed(_) => !conflict,
                _ => false,
            },
        );
    }
    testing::assert_eq(present(run_request(connection, cmd::get(counter))), "15");
    let abort: Result[TransactionOutcome, Error] = connection.compare_and_set(
        Vec::from_array([Blob::from_string(counter)]),
        Pipeline::new(),
        |_| Result::Err(Error::new(ErrorKind::Type, "application rejected update")),
        Operation::new(),
    );
    testing::assert_eq(testing::expect_err(abort, "callback rejected").kind, ErrorKind::Type);
    testing::assert_eq(run_request(connection, cmd::ping()), "PONG");
    let invalid_credentials = ConnectionOptions {
        credentials: Option::Some(
            Credentials {
                username: "default",
                password: Blob::from_string("wrong-reference-password"),
            },
        ),
        ..options,
    };
    testing::assert_eq(
        testing::expect_err(
            Connection::connect(address, invalid_credentials, Operation::new()),
            "authentication failure",
        ).kind,
        ErrorKind::Server,
    );
    let subscription_connection = connect();
    let channel = Blob::from_string(prefix + "channel");
    let pattern = Blob::from_string(prefix + "chan*");
    let subscription = testing::expect_ok(
        subscription_connection.subscribe(
            Vec::from_array([channel]),
            SubscriptionKind::Channel,
            Operation::new(),
        ),
        "subscribe",
    );
    testing::assert_ok(
        subscription.change(
            Vec::from_array([pattern]),
            SubscriptionKind::Pattern,
            true,
            Operation::new(),
        ),
    );
    testing::assert_eq(run_request(other, cmd::publish(channel, binary)), 2);
    let mut direct = 0;
    let mut patterns = 0;
    for _ in 0..2 {
        let Event::Message(actual, payload, matched) = testing::expect_ok(
            subscription.next(Operation::new()),
            "message",
        ) else {
            testing::fail("message");
            return
        };
        testing::assert(actual == channel && payload == binary);
        if matched.is_some() {
            patterns += 1;
        } else {
            direct += 1;
        }
    }
    testing::assert(direct == 1 && patterns == 1);
    testing::assert_ok(
        subscription.change(
            Vec::from_array([channel]),
            SubscriptionKind::Channel,
            false,
            Operation::new(),
        ),
    );
    testing::assert_ok(
        subscription.change(
            Vec::from_array([pattern]),
            SubscriptionKind::Pattern,
            false,
            Operation::new(),
        ),
    );
    testing::assert_eq(run_request(subscription_connection, cmd::ping()), "PONG");
    testing::assert_ok(subscription.close());
    let blocked = connect();
    let timeout = testing::expect_err(
        blocked.execute(
            testing::expect_ok(cmd::blpop(Vec::from_array([missing]), 0.0), "blocking"),
            Operation::new().with_timeout(time::Duration::from_milliseconds(40)),
        ),
        "blocking timeout",
    );
    testing::assert(
        timeout.kind == ErrorKind::Timeout && timeout.may_have_executed && blocked.is_closed(),
    );
    testing::assert_eq(run_request(connection, cmd::decrby(counter, 5)), 10);
    testing::assert(run_request(connection, cmd::expire(key, 100)));
    testing::assert(run_request(connection, cmd::pexpire(key, 100000)));
    run_request(connection, cmd::rename(key, prefix + "renamed"));
    testing::assert_eq(present(run_request(connection, cmd::getdel(prefix + "renamed"))), "next");
    testing::assert_eq(
        run_request(connection, cmd::del(Vec::from_array([list, hash, set, sorted, counter]))),
        5,
    );
    testing::assert_ok(connection.quit(Operation::new()));
    testing::assert(connection.is_closed());
    testing::assert_ok(other.close());
    println("redis live RESP" + version + ": ok");
}

fn unhex(source: string) -> Result[Vec[u8], string] {
    if source.byte_len() % 2 != 0 {
        return Result::Err("odd hex")
    }
    let bytes = Vec::new();
    let mut index = 0;
    while index < source.byte_len() {
        let mut byte: u8 = 0;
        for offset in 0..2 {
            let digit = source.byte_get(index + offset);
            let nibble = if digit >= 48 && digit <= 57 {
                digit - 48
            } else if digit >= 97 && digit <= 102 {
                digit - 87
            } else {
                return Result::Err("invalid hex")
            };
            byte = byte * 16 + nibble;
        }
        bytes.push(byte);
        index += 2;
    }
    Result::Ok(bytes)
}

fn hex(bytes: Vec[u8]) -> string {
    let digits = "0123456789abcdef".to_bytes();
    let output = Vec::new();
    for byte in bytes {
        output.push(digits[(byte / 16).to_isize()]);
        output.push(digits[(byte % 16).to_isize()]);
    }
    string_from_utf8(output).1
}

fn handle(request: json::Value) -> Result[json::Value, string] {
    let data = unhex(
        json::field(request, "hex").and_then(|v| json::as_string(v)).ok_or("hex required")?,
    )?;
    let chunk = json::field(request, "chunk").and_then(|v| json::as_int(v)).unwrap_or(0);
    let values = Vec::new();
    if chunk > 0 {
        let decoder = redis::Decoder::new(redis::Limits::standard()).map_err(|e| e.to_string())?;
        let mut start = 0;
        while start < data.len() {
            let end = if chunk > data.len() - start {
                data.len()
            } else {
                start + chunk
            };
            decoder.feed(data.slice(start, end)).map_err(|e| e.to_string())?;
            while let Some(value) = decoder.next().map_err(|e| e.to_string())? {
                values.push(
                    json::Value::String(hex(redis::encode(value).map_err(|e| e.to_string())?)),
                );
            }
            start = end;
        }
        decoder.finish().map_err(|e| e.to_string())?;
    } else {
        let value = redis::decode(data.as_slice()).map_err(|e| e.to_string())?;
        values.push(json::Value::String(hex(redis::encode(value).map_err(|e| e.to_string())?)));
    }
    Result::Ok(json::Value::Array(values))
}

fn run() -> Result[(), string] {
    let args = env::args();
    if args.len() == 1 {
        exercise();
        println("redis consumer: ok");
        return Result::Ok(())
    }
    if args[1] == "--server" {
        if args.len() != 5 {
            return Result::Err("--server address protocol password")
        }
        live(args[2], args[3], args[4]);
        return Result::Ok(())
    }
    let input = io::read_stdin_to_string().map_err(|e| e.to_string())?;
    let requests = json::as_array(json::parse(input)?).ok_or("expected array")?;
    let replies = Vec::new();
    for request in requests {
        replies.push(
            match handle(request) {
                Ok(value) => value,
                Err(message) => json::Value::Object(
                    Vec::from_array([("error", json::Value::String(message))]),
                ),
            },
        );
    }
    println(json::encode(json::Value::Array(replies)));
    Result::Ok(())
}

fn main() -> () {
    if let Err(message) = run() {
        io::eprintln(message);
        process::exit(1);
    }
}
