package tests;

use consumer::bitflags as app;
use std::fs;
use std::json;
use std::testing;

#[test]
fn rust_bitflags_reference_profiles() -> () {
    let data = testing::expect_ok(
        fs::read_file_structured("tests/data/reference.jsonl"),
        "Rust bitflags fixtures",
    );
    let mut count = 0;
    for line in data.split("\n") {
        if line == "" {
            continue;
        }
        let case = testing::expect_ok(json::parse(line), "fixture JSON");
        let request = testing::expect_some(
            json::as_string(testing::expect_some(json::field(case, "request"), "request")),
            "input",
        );
        let expected = testing::expect_some(
            json::as_string(testing::expect_some(json::field(case, "expected"), "expected")),
            "expected text",
        );
        testing::assert_eq(app::oracle_line(request), expected);
        count += 1;
    }
    testing::assert_eq(count, 4601);
}
