package tests;

use consumer::bitflags as application;
use ecosystem::bitflags as flags;
use flags::Flags;
use std::testing;

#[test]
fn exported_newtypes_constants_and_generic_methods() -> () {
    application::exercise();
    let value = application::Access::from_bits_retain(129);
    testing::assert(value.contains(application::READ));
    testing::assert_eq(value.format(), "READ | 0x80");
    let reconstructed: application::Access = flags::collect(value.iter());
    testing::assert(reconstructed == value);
}
