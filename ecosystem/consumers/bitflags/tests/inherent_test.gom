package tests;

use consumer::bitflags as application;
use ecosystem::bitflags as flags;
use std::testing;

#[derive(flags::FlagValues, PartialEq)]
#[flags(ZERO = "0", SIGN = "0x80", ALIAS = "SIGN", ALL = "~0", unnamed = "0x40")]
struct Signed {
    bits: i8,
}

#[test]
fn inherent_flag_values_cross_interfaces_without_trait_imports() -> () {
    testing::assert(application::Access::flag_read() == application::READ);
    testing::assert(application::Access::flag_alias() == application::Access::flag_read());
    testing::assert(Signed::flag_zero() == Signed { bits: 0 });
    testing::assert(Signed::flag_sign() == Signed { bits: -128 });
    testing::assert(Signed::flag_alias() == Signed::flag_sign());
    testing::assert(Signed::flag_all() == Signed { bits: -1 });
    let value = application::Wide::flag_high();
    let encoded = flags::format(value);
    testing::assert_eq(encoded, "HIGH");
}
