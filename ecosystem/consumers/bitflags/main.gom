package main;

use ecosystem::bitflags as flags;
use flags::Flags;
use std::env;
use std::io;
use std::num;
use std::encoding::hex;
use std::utf8;
use utf8::BytesUtf8;
use std::testing;

#[derive(flags::Flags, flags::FlagValues, PartialEq, Eq, Hash)]
#[flags(NONE = "0", READ = "1", WRITE = "2", BOTH = "READ | WRITE", ALIAS = "READ", GROUP = "0xc", unnamed = "0x40")]
pub struct Access {
    raw: u8,
}

pub const READ: Access = Access { raw: 1 };

#[derive(flags::Flags)]
#[flags(A = "1", AB = "3")]
pub struct Overlap {
    raw: u8,
}

#[derive(flags::Flags)]
#[flags()]
pub struct Empty {
    raw: u8,
}

#[derive(flags::Flags)]
#[flags(A = "1", unnamed = "~0")]
pub struct External {
    raw: u64,
}

#[derive(flags::Flags, flags::FlagValues)]
#[flags(LOW = "1", HIGH = "0x8000000000000000", BOTH = "LOW | HIGH")]
pub struct Wide {
    raw: u64,
}

#[derive(flags::Flags)]
#[flags(LOW = "1", HIGH = "0x8000", GROUP = "0x00f0")]
pub struct Medium {
    raw: u16,
}

#[derive(flags::Flags)]
#[flags(LOW = "1", HIGH = "0x80000000", GROUP = "0x00f0")]
pub struct Word {
    raw: u32,
}

pub fn exercise() -> () {
    let write = testing::expect_some(Access::from_name("WRITE"), "named flag");
    let value = READ.union(write);
    testing::assert_eq(value.format(), "READ | WRITE");
    let parsed: Access = testing::expect_ok(flags::parse(value.format()), "consumer parse");
    testing::assert(parsed == value);
    let combined: Access = flags::collect(value.iter());
    testing::assert(combined == value);
    let keys: HashMap[Access, string] = HashMap::new();
    keys.set(value, "permissions");
    testing::assert(keys.get(parsed) == Option::Some("permissions"));
}

fn parsed[F: Flags](_sample: F, text: string, mode: flags::ParseMode) -> string {
    let value: Result[F, flags::ParseError] = flags::parse_with(text, mode);
    match value {
        Ok(value) => value.bits().to_string(),
        Err(_) => "error",
    }
}

fn oracle[F: Flags](a: F, b: F, text: string) -> string {
    let left = a.bits();
    let all: F = Flags::all();
    let named: F = Flags::all_named();
    let checked: Option[F] = Flags::from_bits(left);
    let fields = Vec::from_array(
        [
            a.bits().to_string(),
            all.bits().to_string(),
            named.bits().to_string(),
            a.known_bits().to_string(),
            a.unknown_bits().to_string(),
            a.is_empty().to_string(),
            a.is_all().to_string(),
            checked.is_some().to_string(),
            a.union(b).bits().to_string(),
            a.intersection(b).bits().to_string(),
            a.difference(b).bits().to_string(),
            a.symmetric_difference(b).bits().to_string(),
            a.complement().bits().to_string(),
            a.contains(b).to_string(),
            a.intersects(b).to_string(),
            a.format(),
            flags::format_truncate(a),
            flags::format_strict(a),
        ],
    );
    let mut names = "";
    for entry in a.iter_names() {
        names += entry.0 + ",";
    }
    fields.push(names);
    let mut values = "";
    for value in a.iter() {
        values += value.bits().to_string() + ",";
    }
    fields.push(values);
    let mut equal = "";
    for name in a.iter_equal_names() {
        equal += name + ",";
    }
    fields.push(equal);
    fields.push(parsed(a, text, flags::ParseMode::Retain));
    fields.push(parsed(a, text, flags::ParseMode::Truncate));
    fields.push(parsed(a, text, flags::ParseMode::Strict));
    let mut output = "";
    for index in 0..fields.len() {
        if index > 0 {
            output += "\t";
        }
        output += fields[index];
    }
    output
}

pub fn oracle_line(line: string) -> string {
    let fields = line.split("\t");
    testing::assert_eq(fields.len(), 4);
    let left = testing::expect_ok(num::parse_uint_radix_structured(fields[1], 16), "left").to_u64();
    let right = testing::expect_ok(num::parse_uint_radix_structured(fields[2], 16), "right").to_u64();
    let text = testing::expect_ok(
        testing::expect_ok(hex::decode(fields[3]), "hex input").to_string_utf8(),
        "text input",
    );
    let output = match fields[0] {
        "access" => oracle(Access::from_bits_retain(left), Access::from_bits_retain(right), text),
        "overlap" => oracle(Overlap::from_bits_retain(left), Overlap::from_bits_retain(right), text),
        "empty" => oracle(Empty::from_bits_retain(left), Empty::from_bits_retain(right), text),
        "external" => oracle(
            External::from_bits_retain(left),
            External::from_bits_retain(right),
            text,
        ),
        "wide" => oracle(Wide::from_bits_retain(left), Wide::from_bits_retain(right), text),
        "medium" => oracle(Medium::from_bits_retain(left), Medium::from_bits_retain(right), text),
        "word" => oracle(Word::from_bits_retain(left), Word::from_bits_retain(right), text),
        _ => {
            testing::fail("unknown profile");
            ""
        },
    };
    output
}

fn run_oracle() -> () {
    let input = testing::expect_ok(io::read_stdin_to_string(), "read input");
    for line in input.split("\n") {
        if line != "" {
            println(oracle_line(line));
        }
    }
}

fn main() -> () {
    let arguments = env::args();
    if arguments.len() > 1 && arguments[1] == "--oracle" {
        run_oracle();
    } else {
        exercise();
        println("bitflags consumer: ok");
    }
}
