package main;

use ecosystem::tracing;
use tracing::{Tracer, TraceContext, Options, Sink, MemorySink, Level, Metadata, Fields, Value, Sampling, Filter, Error};
use std::context;
use std::task;
use std::json;
use std::io;
use std::env;
use std::process;
use std::resource;

fn ctx() -> context::Context {
    context::Context::background()
}

fn number(value: json::Value, name: string, fallback: isize) -> isize {
    json::field(value, name).and_then(|value| json::as_int(value)).unwrap_or(fallback)
}

fn flag(value: json::Value, name: string) -> bool {
    json::field(value, name).and_then(|value| json::as_bool(value)).unwrap_or(false)
}

fn level(value: isize) -> Level {
    match value {
        1 => Level::Error,
        2 => Level::Warn,
        4 => Level::Debug,
        5 => Level::Trace,
        _ => Level::Info,
    }
}

pub fn run_requests(request: json::Value) -> Result[json::Value, string] {
    let memory = MemorySink::new();
    let output = task::scope(
        |scope| {
            let maximum = number(request, "maximum", 3);
            let filter = Filter::new(
                if maximum == 0 {
                    Option::None
                } else {
                    Option::Some(level(maximum))
                },
            );
            let period = number(request, "period", 1);
            if period < 0 {
                return Result::Err("period must be nonnegative")
            }
            let tracer = Tracer::new(
                scope,
                memory.sink(),
                Options {
                    capacity: number(request, "capacity", 4),
                    filter,
                    sampling: if period == 0 {
                        Sampling::None
                    } else {
                        Sampling::Every(period.to_u64())
                    },
                    ..Options::standard(),
                },
            ).map_err(|error| error.to_string())?;
            let requests = json::field(request, "requests").and_then(|value| json::as_array(value)).unwrap_or(
                Vec::new(),
            );
            let mut error = Option::None;
            for index in 0..requests.len() {
                if let Err(problem) = handle_request(scope, tracer, requests[index], index) {
                    error = Option::Some(problem.to_string());
                    break
                }
            }
            let closed = tracer.close(ctx()).map_err(|error| error.to_string());
            if let Some(error) = error {
                return Result::Err(error)
            }
            closed?;
            let metrics = tracer.metrics(ctx()).map_err(|error| error.to_string())?;
            let values = Vec::new();
            for record in memory.records() {
                values.push(record.to_json());
            }
            Result::Ok(
                json::Value::Object(
                    Vec::from_array(
                        [
                            ("records", json::Value::Array(values)),
                            ("accepted", json::Value::Number(metrics.accepted.to_string())),
                            ("filtered", json::Value::Number(metrics.filtered.to_string())),
                            ("dropped", json::Value::Number(metrics.dropped.to_string())),
                            ("live_spans", json::Value::Number(metrics.live_spans.to_string())),
                        ],
                    ),
                ),
            )
        },
    );
    output
}

fn handle_request(scope: task::Scope, tracer: Tracer, request: json::Value, index: isize) -> Result[
    (),
    Error,
] {
    let root = tracer.span(
        ctx(),
        Option::None,
        Metadata::new(level(number(request, "level", 3)), "service::http", "request"),
        Fields::new().with("request", Value::Int(index.to_i64())).with("method", Value::Text("GET")).with(
            "path",
            Value::Text("/items/" + index.to_string()),
        ),
    )?;
    let release: Channel[()] = Channel::new(0);
    let jobs = Vec::new();
    let tasks = number(request, "tasks", 3);
    if tasks < 0 || tasks > 100 {
        root.close(ctx())?;
        return Result::Err(
            Error {
                kind: tracing::ErrorKind::InvalidInput,
                message: "tasks must be between 0 and 100",
            },
        )
    }
    for job in 0..tasks {
        let child = tracer.span(
            ctx(),
            Option::Some(root.context()),
            Metadata::new(
                if job % 2 == 0 {
                    Level::Info
                } else {
                    Level::Debug
                },
                "service::worker",
                "lookup",
            ),
            Fields::new().with("request", Value::Int(index.to_i64())).with(
                "job",
                Value::Int(job.to_i64()),
            ),
        )?;
        jobs.push(
            scope.spawn(
                |_| {
                    let _ = release.recv();
                    let result: Result[(), resource::ScopeError[Error, Error]] = child.in_scope(
                        ctx(),
                        |parent: TraceContext| {
                            let fields = Fields::new().with("request", Value::Int(index.to_i64())).with(
                                "job",
                                Value::Int(job.to_i64()),
                            ).with("rows", Value::Uint((job + 1).to_u64())).with(
                                "cached",
                                Value::Bool(job % 2 == 0),
                            ).with("detail", Value::Text("row\n\"雪\""));
                            tracer.event(
                                ctx(),
                                Option::Some(parent),
                                Metadata::new(
                                    if job % 3 == 0 {
                                        Level::Error
                                    } else {
                                        Level::Info
                                    },
                                    "service::db",
                                    "query_complete",
                                ),
                                fields,
                            ).map(|_| ())
                        },
                    );
                    result.map_err(|error| Error::sink(error.to_string()))
                },
            ),
        );
    }
    let _ = root.record(ctx(), Fields::new().with("status", Value::Int(200)))?;
    let early = flag(request, "early_close");
    if early {
        root.close(ctx())?;
    }
    release.close();
    let mut problem = Option::None;
    for job in jobs {
        if let Err(error) = job.join() {
            if problem.is_none() {
                problem = Option::Some(error);
            }
        }
    }
    if !early {
        root.close(ctx())?;
    }
    match problem {
        Some(error) => Result::Err(error),
        None => Result::Ok(()),
    }
}

pub fn exercise() -> Result[(), string] {
    let input = json::parse("{\"requests\":[{\"tasks\":4,\"early_close\":true},{\"tasks\":2}]}")?;
    let output = run_requests(input)?;
    let records = json::field(output, "records").and_then(|value| json::as_array(value)).ok_or(
        "records missing",
    )?;
    if records.len() != 18 || number(output, "live_spans", -1) != 0
        || number(output, "dropped", -1) != 0 {
        return Result::Err("request tracing invariant failed")
    }
    Result::Ok(())
}

fn main() -> () {
    let args = env::args();
    let result = if args.len() > 1 && args[1] == "--json" {
        io::read_stdin_to_string().map_err(|error| error.to_string()).and_then(
            |input| json::parse(input),
        ).and_then(
            |input| {
                let requests = json::as_array(input).ok_or("expected scenario array")?;
                let output = Vec::new();
                for request in requests {
                    output.push(run_requests(request)?);
                }
                io::println(json::encode(json::Value::Array(output)));
                Result::Ok(())
            },
        )
    } else {
        exercise()
    };
    if let Err(error) = result {
        io::eprintln(error);
        process::exit(1);
    }
}
