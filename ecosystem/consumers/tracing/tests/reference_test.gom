package tests;

use consumer::tracing as app;
use ecosystem::verification::reference;
use std::collections::{HashSet};
use std::json;
use std::testing;

fn reference_number(record: json::Value, key: string) -> isize {
    reference::integer(reference::field(record, key))
}

fn reference_text(record: json::Value, key: string) -> string {
    reference::text(reference::field(record, key))
}

fn record_signature(record: json::Value) -> json::Value {
    let fields = Vec::new();
    for key in Vec::from_array(
        ["kind", "trace_id", "span_id", "parent_id", "level", "target", "name", "fields"],
    ) {
        fields.push((key, reference::field(record, key)));
    }
    json::Value::Object(fields)
}

#[test]
fn independent_concurrent_trace_filter_sampling_and_lifecycle_reference() -> () {
    let fixture = reference::load();
    let scenarios = reference::array(reference::field(fixture, "input"));
    let expected = reference::array(reference::field(fixture, "expected"));
    testing::assert_eq(scenarios.len(), 92);
    testing::assert_eq(expected.len(), scenarios.len());
    for index in 0..scenarios.len() {
        let output = testing::expect_ok(app::run_requests(scenarios[index]), "tracing scenario");
        let records = reference::array(reference::field(output, "records"));
        let signatures = Vec::new();
        for record in records {
            signatures.push(record_signature(record));
        }
        reference::multiset(
            signatures,
            reference::array(expected[index]),
            "trace scenario " + index.to_string(),
        );
        testing::assert_eq(reference_number(output, "accepted"), records.len());
        testing::assert_eq(reference_number(output, "dropped"), 0);
        testing::assert_eq(reference_number(output, "live_spans"), 0);
        let starts: HashMap[isize, json::Value] = HashMap::new();
        let ends: HashSet[isize] = HashSet::new();
        let mut last_request = -1;
        for position in 0..records.len() {
            let record = records[position];
            testing::assert_eq(reference_number(record, "sequence"), position + 1);
            testing::assert(reference_number(record, "timestamp_ns") > 0);
            testing::assert(reference_number(record, "elapsed_ns") >= 0);
            let request = reference_number(reference::field(record, "fields"), "request");
            testing::assert(request >= last_request);
            last_request = request;
            let span = reference_number(record, "span_id");
            let kind = reference_text(record, "kind");
            if kind == "span_start" {
                testing::assert_none(starts.get(span));
                let parent = reference_number(record, "parent_id");
                if parent != 0 {
                    testing::assert_some(starts.get(parent));
                }
                starts.set(span, record);
            } else if kind == "span_end" {
                let started = testing::expect_some(starts.get(span), "start before end");
                testing::assert(!ends.contains(span));
                testing::assert(
                    reference_number(record, "elapsed_ns")
                        >= reference_number(started, "elapsed_ns"),
                );
                ends.insert(span);
            } else if kind == "span_update" {
                testing::assert_some(starts.get(span));
                testing::assert(!ends.contains(span));
            } else if span != 0 {
                let started = testing::expect_some(starts.get(span), "event scope exists");
                if reference_text(started, "target") == "service::worker" {
                    testing::assert(!ends.contains(span));
                }
            }
        }
        testing::assert_eq(starts.len(), ends.len());
    }
}
