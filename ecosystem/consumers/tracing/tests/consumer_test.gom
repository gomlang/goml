package tests;

use consumer::tracing as application;
use ecosystem::tracing;
use std::testing;
use std::json;
use std::task;
use std::context;
use std::resource;

#[test]
fn independent_package_request_tasks_use_public_context_and_lifecycle() -> () {
    testing::assert_ok(application::exercise());
}

#[test]
fn consumer_instantiates_generic_scope_callback_with_local_type() -> () {
    task::scope(
        |scope| {
            let memory = tracing::MemorySink::new();
            let tracer = testing::expect_ok(
                tracing::Tracer::new(scope, memory.sink(), tracing::Options::standard()),
                "tracer",
            );
            let ctx = context::Context::background();
            let span = testing::expect_ok(
                tracer.span(
                    ctx,
                    Option::None,
                    tracing::Metadata::new(tracing::Level::Info, "consumer", "scope"),
                    tracing::Fields::new(),
                ),
                "span",
            );
            let result: Result[Local, resource::ScopeError[string, tracing::Error]] = span.in_scope(
                ctx,
                |parent| Result::Ok(Local { value: parent.span_id() }),
            );
            testing::assert_eq(testing::expect_ok(result, "local result").value, 1.to_u64());
            testing::assert_ok(tracer.close(ctx));
            testing::assert_eq(memory.records().len(), 2);
        },
    );
}

struct Local {
    value: u64,
}

#[test]
fn consumer_suppression_and_empty_request_cases() -> () {
    for text in Vec::from_array(
        [
            "{\"requests\":[]}",
            "{\"period\":0,\"requests\":[{\"tasks\":5}]}",
            "{\"maximum\":0,\"requests\":[{\"tasks\":5}]}",
        ],
    ) {
        let output = testing::expect_ok(
            application::run_requests(testing::expect_ok(json::parse(text), "input")),
            "scenario",
        );
        let records = testing::expect_some(
            json::field(output, "records").and_then(|value| json::as_array(value)),
            "records",
        );
        testing::assert(records.is_empty());
    }
}
