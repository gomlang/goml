package main;

use ecosystem::tui;
use ecosystem::ansi;
use ecosystem::terminal;
use std::env;
use std::io;
use std::bytes;
use std::encoding::hex;
use std::utf8;
use utf8::BytesUtf8;
use std::num;
use std::context;
use std::testing;

pub fn exercise() -> () {
    let buffer = testing::expect_ok(tui::Buffer::new(24, 7), "frame");
    let theme = tui::Theme::defaults();
    let inner = testing::expect_ok(tui::block(buffer, buffer.area(), " GoML TUI ", theme), "block");
    let areas = testing::expect_ok(
        tui::layout(
            inner,
            tui::Direction::Vertical,
            Vec::from_array(
                [tui::Constraint::Fixed(1), tui::Constraint::Fill(1), tui::Constraint::Fixed(1)],
            ),
            0,
        ),
        "layout",
    );
    testing::expect_ok(
        tui::tabs(
            buffer,
            areas[0],
            Vec::from_array(["Files", "Preview"]),
            tui::SelectionState::new(),
            theme,
        ),
        "tabs",
    );
    testing::expect_ok(
        tui::list(
            buffer,
            areas[1],
            Vec::from_array(
                [
                    ansi::StyledText::plain("src/"),
                    ansi::StyledText::plain("文档/"),
                    ansi::StyledText::plain("README.md"),
                ],
            ),
            tui::SelectionState::new(),
            theme,
        ),
        "list",
    );
    testing::expect_ok(tui::gauge(buffer, areas[2], 3, 4, "75%", theme), "progress");
    let backend = tui::MemoryBackend::new();
    let renderer = testing::expect_ok(tui::Renderer::new(24, 7, ansi::Profile::Ansi256), "renderer");
    let first = testing::expect_ok(renderer.render(buffer, |text| backend.write(text)), "render");
    testing::assert(first.full_redraw);
    testing::assert_eq(
        testing::expect_ok(renderer.render(buffer, |text| backend.write(text)), "unchanged").changed_cells,
        0,
    );
    testing::expect_ok(buffer.validate(), "valid frame");
}

pub fn edit() -> () {
    let tree = testing::expect_ok(tui::TreeState::new().toggle("root"), "tree expansion").with_selection(
        tui::SelectionState { selected: 2, ..tui::SelectionState::new() },
    );
    testing::assert(tree.is_expanded("root"));
    testing::assert_eq(tree.selection.selected, 2);
    let editor = testing::expect_ok(tui::Editor::new("ab👩‍💻", 100), "editor");
    testing::expect_ok(
        editor.update(
            terminal::Event::Key(
                terminal::KeyEvent {
                    code: terminal::KeyCode::Backspace,
                    modifiers: terminal::Modifiers::none(),
                },
            ),
        ),
        "edit",
    );
    testing::assert_eq(editor.text(), "ab");
    testing::assert(editor.undo());
    testing::assert_eq(editor.text(), "ab👩‍💻");
}

fn number(value: string) -> isize {
    testing::expect_ok(num::parse_int_structured(value), "integer")
}

fn decode(value: string) -> string {
    testing::expect_ok(testing::expect_ok(hex::decode(value), "hex").to_string_utf8(), "UTF8")
}

fn encode(value: string) -> string {
    hex::encode(bytes::Bytes::from_vec(value.to_bytes()))
}

fn oracle() -> () {
    let input = testing::expect_ok(io::read_stdin_to_string(), "input");
    let mut buffer = testing::expect_ok(tui::Buffer::new(16, 5), "buffer");
    let renderer = testing::expect_ok(tui::Renderer::new(16, 5, ansi::Profile::Ansi256), "renderer");
    let output = Ref::new("");
    for line in input.split("\n") {
        if line == "" {
            continue
        }
        let fields = line.split("\t");
        match fields[0] {
            "new" => {
                buffer = testing::expect_ok(
                    tui::Buffer::new(number(fields[1]), number(fields[2])),
                    "new",
                );
                testing::expect_ok(
                    renderer.resize(buffer.area().width, buffer.area().height),
                    "resize",
                );
                renderer.invalidate();
            },
            "put" => {
                testing::expect_ok(
                    buffer.put(
                        number(fields[1]),
                        number(fields[2]),
                        decode(fields[3]),
                        ansi::Style {
                            fg: ansi::Color::Indexed(number(fields[4]).to_u8()),
                            bg: ansi::Color::Default,
                            attributes: number(fields[5]).to_u16(),
                        },
                    ),
                    "put",
                );
            },
            "fill" => {
                testing::expect_ok(
                    buffer.fill(
                        testing::expect_ok(
                            tui::Rect::new(
                                number(fields[1]),
                                number(fields[2]),
                                number(fields[3]),
                                number(fields[4]),
                            ),
                            "rect",
                        ),
                        ansi::Style::new().foreground(
                            ansi::Color::Indexed(number(fields[5]).to_u8()),
                        ),
                    ),
                    "fill",
                );
            },
            "frame" => {
                output.set("");
                let stats = testing::expect_ok(
                    renderer.render(
                        buffer,
                        |value| {
                            output.set(value);
                            Result::Ok(())
                        },
                    ),
                    "render",
                );
                println(encode(output.get()) + "\t" + stats.changed_cells.to_string());
            },
            _ => testing::fail("unknown operation"),
        }
    }
}

fn interactive() -> Result[(), tui::Error] {
    let session = terminal::Session::open(terminal::Options::interactive()).map_err(
        |error| tui::Error { message: error.to_string() },
    )?;
    defer {
        let _ = session.close();
    };
    let terminal = tui::Terminal::new(session)?;
    let editor = tui::Editor::new("", 4096)?;
    loop {
        terminal.draw(
            |buffer| {
                let area = buffer.area();
                buffer.draw_text(
                    tui::Rect { height: 1, ..area },
                    ansi::StyledText::plain(
                        "TUI " + area.width.to_string() + "x" + area.height.to_string(),
                    ),
                )?;
                if area.height > 1 {
                    editor.render(
                        buffer,
                        tui::Rect { x: 0, y: 1, width: area.width, height: area.height - 1 },
                        tui::EditorOptions::defaults(),
                    )?;
                }
                Result::Ok(())
            },
        )?;
        if let Some(event) = terminal.next_event(context::Context::background(), 1000)? {
            if let terminal::Event::Key(key) = event {
                if key.code == terminal::KeyCode::Escape {
                    break
                }
            }
            if event == terminal::Event::End {
                break
            }
            editor.update(event)?;
        }
    }
    terminal.close()
}

fn main() -> () {
    let args = env::args();
    if args.len() > 1 && args[1] == "--oracle" {
        oracle();
    } else if args.len() > 1 && args[1] == "--pty" {
        testing::expect_ok(interactive(), "PTY");
    } else {
        exercise();
        edit();
        println("tui: wide cells, layout, widgets, diff rendering and editor passed");
    }
}
