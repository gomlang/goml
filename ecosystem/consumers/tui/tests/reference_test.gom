package tests;

use ecosystem::verification::reference;
use std::encoding::hex;
use std::testing;

#[test]
fn independent_wide_cell_model_and_ansi_frame_replay() -> () {
    let fixture = reference::load();
    let output = testing::expect_ok(
        reference::run("tui", "--oracle", reference::text(reference::field(fixture, "input"))),
        "TUI reference protocol",
    );
    let rows = output.trim_end().split("\n");
    let expected = reference::array(reference::field(fixture, "expected"));
    testing::assert_eq(rows.len(), expected.len());
    let mut screen = reference::Screen::new(1, 1);
    for index in 0..rows.len() {
        let expectation = reference::array(expected[index]);
        let width = reference::integer(expectation[0]);
        let height = reference::integer(expectation[1]);
        if screen.width() != width || screen.height() != height {
            screen = reference::Screen::new(width, height);
        }
        let fields = rows[index].split("\t");
        testing::assert_eq(fields.len(), 2);
        testing::assert_eq(fields[1] == "0", fields[0] == "");
        testing::assert_ok(
            screen.feed(testing::expect_ok(hex::decode(fields[0]), "frame hex").as_slice()),
        );
        let cells = reference::array(expectation[2]);
        for y in 0..height {
            let row = reference::array(cells[y]);
            for x in 0..width {
                let wanted = reference::array(row[x]);
                let actual = screen.cell(x, y);
                let color = reference::integer(wanted[2]);
                testing::assert_eq(actual.text, reference::text(wanted[0]));
                testing::assert_eq(actual.width, reference::integer(wanted[1]));
                testing::assert_eq(
                    actual.foreground,
                    if color == -1 {
                        "default"
                    } else {
                        "i:" + color.to_string()
                    },
                );
                testing::assert_eq(actual.attributes, reference::integer(wanted[3]));
            }
        }
    }
}
