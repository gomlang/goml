package main;

use ecosystem::fuzzy;
use std::context;
use std::env;
use std::io;
use std::testing;

pub fn exercise() -> () {
    let matcher = testing::expect_ok(fuzzy::Matcher::new(fuzzy::Options::new()), "matcher");
    let files = Vec::from_array(
        ["src/parser.gom", "tests/parser_test.gom", "src/graph.gom", "README.md"],
    );
    let session = testing::expect_ok(fuzzy::Session::new(matcher, files), "index");
    let (session, first) = testing::expect_ok(
        session.update("pa", 10, context::Context::background()),
        "query",
    );
    testing::assert_eq(first.total, 2);
    let (_, report) = testing::expect_ok(
        session.update("parser", 1, context::Context::background()),
        "refine",
    );
    testing::assert_eq(report.total, 2);
    testing::assert_eq(report.hits[0].text, "src/parser.gom");
    testing::assert(
        report.hits[0].matched.ranges == Vec::from_array([fuzzy::Range { start: 4, end: 10 }]),
    );
}

fn main() -> () {
    exercise();
    let args = env::args();
    let query = if args.len() > 1 {
        args[1]
    } else {
        "fm"
    };
    let matcher = testing::expect_ok(fuzzy::Matcher::new(fuzzy::Options::new()), "matcher");
    let files = Vec::from_array(
        ["src/fuzzy/matcher.gom", "src/fuzzy/model.gom", "src/fuzzy/search.gom", "README.md"],
    );
    let report = testing::expect_ok(
        matcher.search_parallel(query, files, 10, 2, context::Context::background()),
        "file search",
    );
    for hit in report.hits {
        io::println(hit.matched.score.to_string() + " " + hit.text);
    }
}
