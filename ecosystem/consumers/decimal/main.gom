package main;

use ecosystem::decimal::{Decimal, Context, Rounding, Error, Outcome};
use std::serde::{Serialize, Deserialize};
use std::json;
use std::io;
use std::env;
use std::testing;

#[derive(Deserialize)]
struct Case {
    op: string,
    a: string,
    b: string,
    precision: isize,
    scale: isize,
    rounding: string,
}

#[derive(Serialize)]
struct Reply {
    ok: bool,
    value: string,
    rounded: bool,
    inexact: bool,
}

fn rounding(name: string) -> Rounding {
    match name {
        "half_even" => Rounding::HalfEven,
        "half_up" => Rounding::HalfUp,
        "half_down" => Rounding::HalfDown,
        "up" => Rounding::Up,
        "down" => Rounding::Down,
        "ceiling" => Rounding::Ceiling,
        _ => Rounding::Floor,
    }
}

fn execute(input: Case) -> Result[Outcome, Error] {
    let a = Decimal::parse(input.a)?;
    let b = Decimal::parse(input.b)?;
    let context = Context::new(input.precision, rounding(input.rounding))?;
    match input.op {
        "add" => context.add_status(a, b),
        "sub" => context.sub_status(a, b),
        "mul" => context.mul_status(a, b),
        "div" => context.div_status(a, b),
        "round" => context.round_status(a),
        "quantize" => context.quantize_status(a, input.scale),
        _ => Result::Err(Error::InvalidEncoding),
    }
}

pub fn exercise() -> () {
    let price = testing::expect_ok(Decimal::parse("19.995"), "price");
    let quantity = Decimal::from_u64(7);
    let exact = testing::expect_ok(price.mul(quantity), "line total");
    let total = testing::expect_ok(exact.rescale(2, Rounding::HalfEven), "settlement");
    testing::assert_eq(exact.to_fixed(), "139.965");
    testing::assert_eq(total.to_fixed(), "139.96");
    let vat = testing::expect_ok(Decimal::parse("0.20"), "VAT rate");
    let tax = testing::expect_ok(exact.mul(vat), "exact VAT");
    testing::assert_eq(
        testing::expect_ok(tax.format_scale(2, Rounding::HalfUp), "rounded VAT"),
        "27.99",
    );
    let record = testing::expect_ok(json::try_to_string(total), "store exact decimal");
    let restored: Decimal = testing::expect_ok(json::from_string(record), "load exact decimal");
    testing::assert(restored.same_representation(total));
    let context = testing::expect_ok(Context::new(12, Rounding::HalfEven), "ratio context");
    let ratio = testing::expect_ok(context.div(Decimal::one(), Decimal::from_u64(7)), "ratio");
    testing::assert_eq(ratio.to_fixed(), "0.142857142857");
}

fn main() -> () {
    let args = env::args();
    if args.len() > 1 && args[1] == "--json" {
        let input = testing::expect_ok(io::read_stdin_to_string(), "oracle stdin");
        let cases: Vec[Case] = testing::expect_ok(json::from_string(input), "oracle cases");
        let replies: Vec[Reply] = Vec::new();
        for input in cases {
            replies.push(
                match execute(input) {
                    Ok(outcome) => Reply {
                        ok: true,
                        value: outcome.value.to_scientific(),
                        rounded: outcome.rounded,
                        inexact: outcome.inexact,
                    },
                    Err(_) => Reply { ok: false, value: "", rounded: false, inexact: false },
                },
            );
        }
        println(testing::expect_ok(json::try_to_string(replies), "oracle replies"));
    } else {
        exercise();
        println("decimal consumer: exact invoice and contextual ratios ok");
    }
}
