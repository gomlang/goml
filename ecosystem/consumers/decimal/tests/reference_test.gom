package tests;

use consumer::decimal as application;
use std::testing;
use std::fs;
use std::json;
use ecosystem::decimal::{Decimal};

fn field(value: json::Value, name: string) -> json::Value {
    testing::expect_some(json::field(value, name), "reference field " + name)
}

fn reference_rows() -> Vec[json::Value] {
    let source = testing::expect_ok(
        fs::read_file_structured("tests/data/reference.jsonl"),
        "reference vectors",
    );
    let rows = Vec::new();
    for line in source.split("\n") {
        if line != "" {
            rows.push(testing::expect_ok(json::parse(line), "reference JSON"));
        }
    }
    rows
}

#[test]
fn independent_decimal_rounding_and_status_vectors() -> () {
    let rows = reference_rows();
    testing::assert_eq(rows.len(), 3072);
    for row in rows {
        let actual = application::reference_case(field(row, "input"));
        let expected = field(row, "expected");
        testing::assert(json::encode(field(actual, "ok")) == json::encode(field(expected, "ok")));
        if testing::expect_some(json::as_bool(field(expected, "ok")), "status") {
            let a = testing::expect_ok(
                Decimal::parse(
                    testing::expect_some(json::as_string(field(actual, "value")), "actual decimal"),
                ),
                "parse actual",
            );
            let b = testing::expect_ok(
                Decimal::parse(
                    testing::expect_some(
                        json::as_string(field(expected, "value")),
                        "reference decimal",
                    ),
                ),
                "parse reference",
            );
            testing::assert(a == b);
            testing::assert(
                json::encode(field(actual, "rounded")) == json::encode(field(expected, "rounded")),
            );
            testing::assert(
                json::encode(field(actual, "inexact")) == json::encode(field(expected, "inexact")),
            );
        }
    }
}
