package main;

use ecosystem::rope;
use std::env;
use std::io;
use std::json;
use std::process;
use std::testing;

fn number(value: isize) -> json::Value {
    json::Value::Number(value.to_string())
}

fn integer(value: json::Value, name: string) -> isize {
    json::field(value, name).and_then(|field| json::as_int(field)).unwrap_or(0)
}

fn string_field(value: json::Value, name: string) -> string {
    json::field(value, name).and_then(|field| json::as_string(field)).unwrap_or("")
}

fn report(value: rope::Rope, detailed: bool) -> Result[json::Value, string] {
    let stats = value.validate().map_err(|error| error.to_string())?;
    let lines: Vec[json::Value] = Vec::new();
    let contents: Vec[json::Value] = Vec::new();
    let starts: Vec[json::Value] = Vec::new();
    for line in value.lines() {
        lines.push(json::Value::String(line.to_string()));
    }
    for line in value.line_contents() {
        contents.push(json::Value::String(line.to_string()));
    }
    for line in 0..value.len_lines() {
        starts.push(number(value.line_to_byte(line).map_err(|error| error.to_string())?));
    }
    let fields = Vec::from_array(
        [
            ("text", json::Value::String(value.to_string())),
            ("bytes", number(value.len_bytes())),
            ("scalars", number(value.len_scalars())),
            ("utf16", number(value.len_utf16())),
            ("lines", json::Value::Array(lines)),
            ("contents", json::Value::Array(contents)),
            ("starts", json::Value::Array(starts)),
            ("height", number(stats.height)),
            ("chunks", number(stats.chunks)),
        ],
    );
    if detailed {
        let positions: Vec[json::Value] = Vec::new();
        let invalid_bytes: Vec[json::Value] = Vec::new();
        let invalid_utf16: Vec[json::Value] = Vec::new();
        for at in 0..=value.len_bytes() {
            if !value.is_char_boundary(at) {
                testing::assert_err(value.byte_to_scalar(at));
                testing::assert_err(value.byte_to_utf16(at));
                invalid_bytes.push(number(at));
                continue;
            }
            let scalar = value.byte_to_scalar(at).map_err(|error| error.to_string())?;
            let units = value.byte_to_utf16(at).map_err(|error| error.to_string())?;
            testing::assert_eq(value.scalar_to_byte(scalar).map_err(|error| error.to_string())?, at);
            testing::assert_eq(value.utf16_to_byte(units).map_err(|error| error.to_string())?, at);
            let line = value.byte_to_line(at).map_err(|error| error.to_string())?;
            let position = match value.byte_to_position(at, rope::Encoding::Utf16) {
                Ok(position) => {
                    testing::assert_eq(
                        value.position_to_byte(position, rope::Encoding::Utf16).map_err(
                            |error| error.to_string(),
                        )?,
                        at,
                    );
                    json::Value::Array(
                        Vec::from_array([number(position.line), number(position.column)]),
                    )
                },
                Err(_) => json::Value::Null,
            };
            positions.push(
                json::Value::Array(
                    Vec::from_array(
                        [number(at), number(scalar), number(units), number(line), position],
                    ),
                ),
            );
        }
        for units in 0..=value.len_utf16() {
            if value.utf16_to_byte(units).is_err() {
                invalid_utf16.push(number(units));
            }
        }
        fields.push(("positions", json::Value::Array(positions)));
        fields.push(("invalid_bytes", json::Value::Array(invalid_bytes)));
        fields.push(("invalid_utf16", json::Value::Array(invalid_utf16)));
    }
    Result::Ok(json::Value::Object(fields))
}

fn operation(value: rope::Rope, op: json::Value) -> Result[rope::Rope, rope::Error] {
    let kind = string_field(op, "kind");
    let start = integer(op, "start");
    let end = integer(op, "end");
    let text = string_field(op, "text");
    match kind {
        "replace" => value.replace_bytes(start, end, rope::Rope::from_string(text)?),
        "insert" => value.insert(start, text),
        "remove" => value.remove(start, end),
        "slice" => value.slice_bytes(start, end),
        "split" => {
            let (left, right) = value.split_at_byte(start)?;
            let _ = left.validate()?;
            let _ = right.validate()?;
            left.concat(right)
        },
        "rotate" => {
            let (left, right) = value.split_at_byte(start)?;
            right.concat(left)
        },
        "concat" => value.concat(rope::Rope::from_string(text)?),
        "compact" => value.compact(),
        "build" => {
            let builder = rope::Builder::new();
            let parts = json::field(op, "parts").and_then(|field| json::as_array(field)).unwrap_or(
                Vec::new(),
            );
            for part in parts {
                builder.append(json::as_string(part).unwrap_or(""))?;
            }
            Result::Ok(builder.finish())
        },
        _ => Result::Err(rope::Error::Invariant("unknown oracle operation")),
    }
}

pub fn evaluate(case: json::Value) -> Result[json::Value, string] {
    let initial = rope::Rope::from_string(string_field(case, "text")).map_err(
        |error| error.to_string(),
    )?;
    let mut value = initial.snapshot();
    let results = Vec::from_array([report(value, false)?]);
    let operations = json::field(case, "operations").and_then(|field| json::as_array(field)).unwrap_or(
        Vec::new(),
    );
    for op in operations {
        let old = value.snapshot();
        let old_text = old.to_string();
        let success = match operation(value, op) {
            Ok(next) => {
                value = next;
                true
            },
            Err(_) => false,
        };
        testing::assert_eq(old.to_string(), old_text);
        results.push(
            json::Value::Object(
                Vec::from_array(
                    [("ok", json::Value::Bool(success)), ("value", report(value, false)?)],
                ),
            ),
        );
    }
    testing::assert_eq(initial.to_string(), string_field(case, "text"));
    Result::Ok(
        json::Value::Object(
            Vec::from_array(
                [("steps", json::Value::Array(results)), ("final", report(value, true)?)],
            ),
        ),
    )
}

pub fn exercise() -> () {
    let original = testing::expect_ok(rope::Rope::from_string("hello 😀\r\n世界"), "document");
    let updated = testing::expect_ok(original.insert(6, "GoML "), "edit");
    testing::assert_eq(original.to_string(), "hello 😀\r\n世界");
    testing::assert_eq(updated.to_string(), "hello GoML 😀\r\n世界");
    let position = testing::expect_ok(
        updated.byte_to_position(11, rope::Encoding::Utf16),
        "position",
    );
    testing::assert_eq(position, rope::Position { line: 0, column: 11 });
    let _ = testing::expect_ok(updated.validate(), "tree invariants");
}

fn run_json() -> Result[(), string] {
    let input = io::read_stdin_to_string().map_err(|error| error.to_string())?;
    let cases = json::as_array(json::parse(input)?).ok_or("expected case array")?;
    let results: Vec[json::Value] = Vec::new();
    for case in cases {
        results.push(evaluate(case)?);
    }
    print(json::encode(json::Value::Array(results)));
    Result::Ok(())
}

fn main() -> () {
    if env::args().len() > 1 {
        if let Err(error) = run_json() {
            io::eprintln(error);
            process::exit(1);
        }
    } else {
        exercise();
        println("rope consumer: ok");
    }
}
