package tests;

use consumer::rope as application;
use ecosystem::rope;
use std::io;
use std::bytes;
use std::testing;

#[test]
fn exported_document_and_generic_stream_api() -> () {
    application::exercise();
    let input = io::Cursor::new(bytes::Bytes::from_string("跨模块😀\r\n"));
    let document = testing::expect_ok(
        rope::Rope::from_reader(input, 100),
        "imported generic reader",
    );
    let output = io::Cursor::new(bytes::Bytes::new());
    testing::expect_ok(document.write_to(output), "imported generic writer");
    testing::assert(output.bytes().to_vec() == "跨模块😀\r\n".to_bytes());
    let saved = document;
    let edited = testing::expect_ok(document.remove(0, 1), "imported edit");
    testing::assert_eq(saved.to_string(), "跨模块😀\r\n");
    testing::assert_eq(edited.to_string(), "模块😀\r\n");
}
