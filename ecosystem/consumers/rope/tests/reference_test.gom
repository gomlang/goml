package tests;

use ecosystem::verification::reference;
use std::json;
use std::testing;

fn report(actual: json::Value, expected: json::Value) -> () {
    match expected {
        Object(fields) => for (key, value) in fields {
            reference::assert_equal(reference::field(actual, key), value, "rope " + key);
        },
        _ => testing::fail("invalid report"),
    }
    let chunks = reference::integer(reference::field(actual, "chunks"));
    let height = reference::integer(reference::field(actual, "height"));
    let mut bits = 0;
    let mut value = chunks + 1;
    while value > 0 {
        bits += 1;
        value /= 2;
    }
    testing::assert(height <= 2 * bits);
    testing::assert((chunks > 0) == (reference::text(reference::field(actual, "text")) != ""));
}

#[test]
fn independent_unicode_flat_string_histories() -> () {
    let fixture = reference::load();
    let actual = reference::array(
        testing::expect_ok(
            reference::run_json("rope", reference::field(fixture, "input")),
            "reference protocol",
        ),
    );
    let expected = reference::array(reference::field(fixture, "expected"));
    testing::assert_eq(actual.len(), expected.len());
    for index in 0..expected.len() {
        let steps = reference::array(reference::field(actual[index], "steps"));
        let wanted = reference::array(reference::field(expected[index], "steps"));
        testing::assert_eq(steps.len(), wanted.len());
        report(steps[0], wanted[0]);
        for step in 1..steps.len() {
            reference::assert_equal(
                reference::field(steps[step], "ok"),
                reference::field(wanted[step], "ok"),
                "rope edit acceptance",
            );
            report(reference::field(steps[step], "value"), reference::field(wanted[step], "value"));
        }
        report(reference::field(actual[index], "final"), reference::field(expected[index], "final"));
    }
}
