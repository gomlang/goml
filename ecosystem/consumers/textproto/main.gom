package main;

use ecosystem::textproto;
use std::bytes;
use std::io;
use std::testing;

pub fn exercise() -> Result[(), textproto::Error] {
    let wire = io::Cursor::new(bytes::Bytes::new());
    let writer = textproto::Writer::new(wire, textproto::Limits::standard())?;
    writer.write_line(bytes::Bytes::from_vec(b"220 ready"))?;
    let headers = textproto::Headers::new();
    headers.append("content-type", bytes::Bytes::from_vec(b"text/plain"))?;
    writer.write_headers(headers)?;
    writer.begin_dot()?;
    let _ = writer.write_dot_chunk(b"hello\r\n.dot\r\n".as_slice())?;
    writer.finish_dot()?;
    let reader = textproto::Reader::new(
        io::Cursor::new(wire.bytes()),
        textproto::Limits::standard(),
    )?;
    testing::assert(testing::expect_some(reader.read_line()?, "status").to_vec() == b"220 ready");
    testing::assert(reader.read_headers(false)?.values("Content-Type")[0].to_vec() == b"text/plain");
    testing::assert(reader.read_dot_bytes()?.to_vec() == b"hello\r\n.dot\r\n");
    Result::Ok(())
}

fn main() -> () {
    testing::assert_ok(exercise());
    println("textproto consumer: bounded headers and dot framing passed");
}
