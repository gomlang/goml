package tests;

use ecosystem::cli;
use cli::Args as Arguments;
use cli::Subcommands as Actions;
use std::testing;

#[derive(Arguments)]
struct Common {
    #[arg(short = "v", count, global)]
    verbose: isize,
    #[arg(default = "8080", env = "PORT", global)]
    port: u16,
}

#[derive(Arguments)]
struct Location {
    #[arg(positional)]
    directory: string,
}

#[derive(Arguments)]
struct Files {
    #[arg(positional)]
    source: string,
    #[arg(flatten)]
    location: Location,
    #[arg(positional)]
    rest: Vec[string],
}

#[derive(Arguments)]
struct Selection[T] {
    #[arg(long = "input")]
    value: T,
}

#[derive(Actions)]
enum Nested {
    #[command(about = "Check configuration")]
    Check,
    #[command(name = "list-files", alias = "ls")]
    List(Files),
}

#[derive(Arguments)]
#[command(about = "Inherited payload help", version = "payload-version", alias = "ignored-payload-alias")]
struct Run[T] {
    #[arg(flatten)]
    selection: Selection[T],
    #[arg(subcommand)]
    nested: Option[Nested],
}

#[derive(Actions)]
enum Commands[T] {
    #[command(name = "execute", alias = "x", about = "Execute a task", version = "2.0")]
    Run(Run[T]),
    Inherited(Run[T]),
    #[command(alias = "st", about = "Show status")]
    Status,
}

#[derive(Arguments)]
#[command(name = "derived-tool", about = "A composed application", version = "1.0")]
struct Application[T] {
    #[arg(flatten)]
    common: Common,
    #[arg(subcommand)]
    action: Commands[T],
}

#[derive(Arguments)]
struct OptionalApplication[T] {
    #[arg(subcommand)]
    action: Option[Commands[T]],
}

#[derive(Arguments)]
struct RequiredOption {
    #[arg(subcommand, required)]
    action: Option[Nested],
}

#[derive(Arguments)]
struct WrappedApplication[T] {
    #[arg(flatten)]
    application: Application[T],
}

#[test]
fn nested_subcommands_decode_aliases_generics_globals_and_environment() -> () {
    let application: Application[isize] = testing::expect_ok(
        cli::parse_with_env(
            Vec::from_array(
                ["-v", "x", "--input=42", "ls", "--port=9000", "-vv", "from", "to", "extra"],
            ),
            |name| if name == "PORT" {
                Option::Some("7000")
            } else {
                Option::None
            },
        ),
        "composed application",
    );
    testing::assert_eq(application.common.verbose, 3);
    testing::assert_eq(application.common.port, 9000);
    match application.action {
        Run(run) => {
            testing::assert_eq(run.selection.value, 42);
            match testing::expect_some(run.nested, "nested command") {
                List(files) => {
                    testing::assert_eq(files.source, "from");
                    testing::assert_eq(files.location.directory, "to");
                    testing::assert(files.rest == Vec::from_array(["extra"]));
                },
                _ => testing::assert(false),
            }
        },
        _ => testing::assert(false),
    }
    let wrapped: WrappedApplication[string] = testing::expect_ok(
        cli::parse(Vec::from_array(["execute", "--input=text"])),
        "wrapped command",
    );
    testing::assert_eq(wrapped.application.common.port, 8080);
    match wrapped.application.action {
        Run(run) => {
            testing::assert_eq(run.selection.value, "text");
            testing::assert(run.nested.is_none());
        },
        _ => testing::assert(false),
    }
}

#[test]
fn flattened_positionals_keep_declaration_order_and_terminators() -> () {
    let files: Files = testing::expect_ok(
        cli::parse(Vec::from_array(["source", "destination", "--", "-last"])),
        "positionals",
    );
    testing::assert_eq(files.source, "source");
    testing::assert_eq(files.location.directory, "destination");
    testing::assert(files.rest == Vec::from_array(["-last"]));
    let missing: Result[Files, cli::Error] = cli::parse(Vec::from_array(["source"]));
    testing::assert_eq(
        testing::expect_err(missing, "missing nested positional").kind,
        cli::ErrorKind::Usage,
    );
}

#[test]
fn required_optional_and_unit_subcommands_have_distinct_semantics() -> () {
    let absent: OptionalApplication[isize] = testing::expect_ok(cli::parse(Vec::new()), "optional");
    testing::assert(absent.action.is_none());
    let required: Result[Application[isize], cli::Error] = cli::parse(Vec::new());
    testing::assert_eq(testing::expect_err(required, "required").kind, cli::ErrorKind::Usage);
    let required_option: Result[RequiredOption, cli::Error] = cli::parse(Vec::new());
    testing::assert_err(required_option);
    let required_option: RequiredOption = testing::expect_ok(
        cli::parse(Vec::from_array(["check"])),
        "required option",
    );
    testing::assert(required_option.action.is_some());
    let selected: OptionalApplication[isize] = testing::expect_ok(
        cli::parse(Vec::from_array(["st"])),
        "unit alias",
    );
    testing::assert(
        match testing::expect_some(selected.action, "selected") {
            Status => true,
            _ => false,
        },
    );
    let unknown: Result[OptionalApplication[isize], cli::Error] = cli::parse(
        Vec::from_array(["unknown"]),
    );
    testing::assert_err(unknown);
    let unit_payload: Result[OptionalApplication[isize], cli::Error] = cli::parse(
        Vec::from_array(["status", "extra"]),
    );
    testing::assert_err(unit_payload);
    let bad_payload: Result[OptionalApplication[isize], cli::Error] = cli::parse(
        Vec::from_array(["x", "--input=bad"]),
    );
    testing::assert_eq(
        testing::expect_err(bad_payload, "typed payload").kind,
        cli::ErrorKind::InvalidValue,
    );
}

#[test]
fn composed_help_versions_and_schema_function_values_cross_dependencies() -> () {
    let factory: () -> cli::Command = cli::schema::[Application[isize]];
    testing::expect_ok(factory().validate(), "valid schema");
    let root = testing::expect_err(factory().parse(Vec::from_array(["--help"])), "root help");
    testing::assert_eq(root.kind, cli::ErrorKind::Help);
    testing::assert(root.message.contains("A composed application"));
    testing::assert(root.message.contains("execute  Execute a task [aliases: x]"));
    testing::assert(root.message.contains("<COMMAND>"));
    let help = testing::expect_err(factory().parse(Vec::from_array(["x", "--help"])), "child help");
    testing::assert(help.message.contains("Usage: execute"));
    testing::assert(help.message.contains("--verbose"));
    testing::assert(help.message.contains("[COMMAND]"));
    let help = testing::expect_err(
        factory().parse(Vec::from_array(["x", "ls", "--help"])),
        "nested help",
    );
    testing::assert(help.message.contains("Usage: list-files"));
    testing::assert(help.message.contains("<source> <directory> [rest]..."));
    let version = testing::expect_err(
        factory().parse(Vec::from_array(["x", "--version"])),
        "child version",
    );
    testing::assert_eq(version.message, "execute 2.0");
    let inherited = testing::expect_err(
        factory().parse(Vec::from_array(["inherited", "--help"])),
        "inherited payload help",
    );
    testing::assert(inherited.message.contains("Inherited payload help"));
    let inherited = testing::expect_err(
        factory().parse(Vec::from_array(["inherited", "--version"])),
        "inherited payload version",
    );
    testing::assert_eq(inherited.message, "inherited payload-version");
    testing::assert_err(factory().parse(Vec::from_array(["ignored-payload-alias"])));
    let typed: cli::TypedCommand[Commands[isize]] = cli::subcommands_for();
    let matches = testing::expect_ok(
        typed.command.parse(Vec::from_array(["status"])),
        "direct schema",
    );
    let value: Commands[isize] = testing::expect_ok(
        cli::decode_subcommand(matches),
        "direct decode",
    );
    testing::assert(
        match value {
            Status => true,
            _ => false,
        },
    );
}

#[derive(Arguments)]
struct DuplicateNames {
    #[arg(flatten)]
    common: Common,
    port: string,
}

#[derive(Arguments)]
struct DuplicateShort {
    #[arg(flatten)]
    common: Common,
    #[arg(short = "v")]
    other: bool,
}

#[derive(Arguments)]
struct InvalidPositions {
    #[arg(positional)]
    first: Option[string],
    #[arg(flatten)]
    location: Location,
}

#[derive(Arguments)]
struct VariadicBeforeFlatten {
    #[arg(positional)]
    first: Vec[string],
    #[arg(flatten)]
    location: Location,
}

#[derive(Arguments)]
struct MixedSelectors {
    #[arg(flatten)]
    nested: RequiredOption,
    #[arg(subcommand)]
    action: Option[Commands[isize]],
}

#[derive(Arguments)]
struct TwoFlattenedSelectors {
    #[arg(flatten)]
    nested: RequiredOption,
    #[arg(flatten)]
    action: OptionalApplication[isize],
}

#[derive(Arguments)]
struct WrappedInvalidSelectors {
    #[arg(flatten)]
    nested: TwoFlattenedSelectors,
}

#[test]
fn multiple_flattened_selectors_fail_schema_validation_before_decoding() -> () {
    let literal = cli::Command {
        name: "literal",
        aliases: Vec::new(),
        description: "",
        version_value: "",
        arguments: Vec::new(),
        commands: Vec::new(),
        subcommand_required: false,
        groups: Vec::new(),
        composition_errors: Vec::new(),
    };
    testing::expect_ok(literal.validate(), "complete public command record");
    for command in Vec::from_array(
        [
            cli::schema::[MixedSelectors](),
            cli::schema::[TwoFlattenedSelectors](),
            cli::schema::[WrappedInvalidSelectors](),
        ],
    ) {
        let error = testing::expect_err(command.validate(), "multiple selectors");
        testing::assert_eq(error.kind, cli::ErrorKind::InvalidSchema);
        testing::assert(error.message.contains("subcommand"));
        let error = testing::expect_err(
            command.parse(Vec::from_array(["check"])),
            "invalid composed parse",
        );
        testing::assert_eq(error.kind, cli::ErrorKind::InvalidSchema);
    }
    let explicit = cli::Command::new("manual").flatten(
        cli::Command::new("first-set").subcommand(cli::Command::new("first")),
    ).flatten(cli::Command::new("second-set").subcommand(cli::Command::new("second")));
    testing::expect_ok(explicit.validate(), "explicit lists can merge");
    testing::expect_ok(explicit.parse(Vec::from_array(["second"])), "second explicit list");
}

#[test]
fn flattened_schema_errors_remain_recoverable() -> () {
    for command in Vec::from_array(
        [
            cli::schema::[DuplicateNames](),
            cli::schema::[DuplicateShort](),
            cli::schema::[InvalidPositions](),
            cli::schema::[VariadicBeforeFlatten](),
        ],
    ) {
        testing::assert_eq(
            testing::expect_err(command.validate(), "invalid composed schema").kind,
            cli::ErrorKind::InvalidSchema,
        );
    }
    let unrelated = testing::expect_ok(
        cli::Command::new("other").parse(Vec::new()),
        "unrelated command",
    );
    let decoded: Result[Nested, cli::Error] = cli::Subcommands::from_subcommand(unrelated);
    testing::assert(testing::expect_err(decoded, "wrong command").message.contains("other"));
}
