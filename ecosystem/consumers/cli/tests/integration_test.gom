package tests;

use ecosystem::cli;
use cli::Args as Arguments;
use std::testing;

#[test]
fn inherited_options_aliases_and_groups_cross_dependency_boundary() -> () {
    let command = cli::Command::new("app").arg(
        cli::Argument::flag("quiet").alias("silent").global(true),
    ).arg(cli::Argument::counter("verbose").short('v').global(true)).group(
        cli::ArgGroup::new("output", Vec::from_array(["quiet", "verbose"])).required(true),
    ).subcommand(cli::Command::new("run").alias("r"));
    let matches = testing::expect_ok(
        command.parse(Vec::from_array(["r", "--silent"])),
        "global alias",
    );
    testing::assert(matches.flag("quiet"));
    testing::assert(testing::expect_some(matches.subcommand(), "child").flag("quiet"));
    testing::assert_err(command.parse(Vec::from_array(["-v", "r", "--silent"])));
}

struct Command {
    value: isize,
}

struct Argument {
    value: isize,
}

#[derive(Arguments)]
struct Options[T] {
    #[arg(long = "input")]
    value: T,
    #[arg(default = "")]
    command: string,
}

#[test]
fn imported_derive_alias_generics_and_name_hygiene() -> () {
    let options: Options[isize] = testing::expect_ok(
        cli::parse(Vec::from_array(["--input=42"])),
        "parse",
    );
    testing::assert_eq(options.value, 42);
    testing::assert_eq(options.command, "");
    let schema: cli::TypedCommand[Options[isize]] = cli::command_for();
    testing::assert(schema.command.help_text().contains("--input"));
}
