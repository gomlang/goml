package tests;

use ecosystem::cli;
use cli::{Args, ArgValue, Subcommands};
use std::testing;

#[derive(ArgValue, PartialEq)]
enum RawMode {
    #[value(name = r"first", alias = r#"1st"#)]
    First,
}

#[derive(Args)]
#[command(name = r"raw-tool", about = r##"Raw "# text: (= 42), /* value */ and \slashes"##)]
struct RawArguments {
    #[arg(long = r#"raw-input"#, default = r#"a\n"#, help = "Quoted \"value\", x = 1")]
    input: string,
    #[arg(default = "line\n\u4E2D")]
    escaped: string,
    #[arg(default = r"1st")]
    mode: RawMode,
    #[arg(long = r"quiet", global)]
    quiet: bool,
    #[arg(default = r"")]
    blank: string,
}

#[derive(Subcommands)]
enum RawCommands {
    #[command(name = r"go", alias = r#"g"#, about = r#"Run (x = 1), "now""#)]
    Go(RawArguments),
}

#[derive(Args)]
struct RawApplication {
    #[arg(subcommand)]
    action: RawCommands,
}

#[test]
fn raw_and_escaped_attribute_strings_preserve_values_across_derives() -> () {
    let arguments: RawArguments = testing::expect_ok(cli::parse(Vec::new()), "raw defaults");
    testing::assert_eq(arguments.input, "a\\n");
    testing::assert_eq(arguments.escaped, "line\n中");
    testing::assert(arguments.mode == RawMode::First);
    testing::assert(!arguments.quiet);
    testing::assert_eq(arguments.blank, "");
    let help = cli::schema::[RawArguments]().help_text();
    testing::assert(help.contains("Raw \"# text: (= 42), /* value */ and \\slashes"));
    testing::assert(help.contains("Quoted \"value\", x = 1"));
    testing::assert(help.contains("--raw-input"));
    let application: RawApplication = testing::expect_ok(
        cli::parse(Vec::from_array(["g", "--raw-input=changed", "--quiet"])),
        "raw subcommands",
    );
    match application.action {
        Go(arguments) => {
            testing::assert_eq(arguments.input, "changed");
            testing::assert(arguments.quiet);
        },
    }
    let help = cli::schema::[RawApplication]().help_text();
    testing::assert(help.contains("go  Run (x = 1), \"now\" [aliases: g]"));
}
