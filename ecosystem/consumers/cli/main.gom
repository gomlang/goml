package main;

use ecosystem::cli;
use cli::{Args, ArgValue};
use std::testing;

#[derive(ArgValue, PartialEq)]
enum Mode {
    Fast,
    Safe,
}

#[derive(Args)]
#[command(name = "consumer")]
struct Options {
    #[arg(default = "safe")]
    mode: Mode,
    #[arg(short = "v", count)]
    verbose: isize,
}

fn main() -> () {
    let options: Options = testing::expect_ok(cli::parse(Vec::from_array(["-vv"])), "options");
    testing::assert(options.mode == Mode::Safe);
    testing::assert_eq(options.verbose, 2);
    println("cli consumer: ok")
}
