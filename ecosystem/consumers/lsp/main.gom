package main;

use ecosystem::lsp;
use std::env;
use std::io;
use std::json;
use std::process;
use std::serde;
use std::time;
use serde::{Deserialize, Serialize};

#[derive(Deserialize)]
struct AddInput {
    left: isize,
    right: isize,
}

#[derive(Serialize)]
struct AddOutput {
    value: isize,
}

pub fn server() -> Result[lsp::Server, lsp::RpcError] {
    let router = lsp::Router::new();
    router.on_request(
        "test/add",
        |context, input: AddInput| {
            context.token.check()?;
            Result::Ok(AddOutput { value: input.left + input.right })
        },
    )?;
    router.on_raw_request("test/echo", |_, params| Result::Ok(params.unwrap_or(json::Value::Null)))?;
    router.on_raw_request(
        "test/document",
        |context, params| {
            let params = params.ok_or(lsp::RpcError::new(-32602, "params required"))?;
            let uri = json::field(params, "uri").and_then(|value| json::as_string(value)).ok_or(
                lsp::RpcError::new(-32602, "uri required"),
            )?;
            let document = context.documents.get(uri).ok_or(
                lsp::RpcError::new(-32602, "document not open"),
            )?;
            Result::Ok(
                json::object(
                    Vec::from_array(
                        [
                            ("text", json::Value::String(document.content())),
                            ("version", json::Value::Number(document.version().to_string())),
                        ],
                    ),
                ),
            )
        },
    )?;
    router.on_raw_request(
        "test/offset",
        |context, params| {
            let position = lsp::DocumentPosition::from_json(
                params.ok_or(lsp::RpcError::new(-32602, "params required"))?,
            )?;
            let document = context.documents.get(position.uri).ok_or(
                lsp::RpcError::new(-32602, "document not open"),
            )?;
            Result::Ok(json::Value::Number(document.offset(position.position)?.to_string()))
        },
    )?;
    router.on_raw_request(
        "textDocument/hover",
        |context, params| {
            let position = lsp::DocumentPosition::from_json(
                params.ok_or(lsp::RpcError::new(-32602, "params required"))?,
            )?;
            let document = context.documents.get(position.uri).ok_or(
                lsp::RpcError::new(-32602, "document not open"),
            )?;
            let offset = document.offset(position.position)?;
            lsp::hover(f"Document **{document.language_id()}**, byte {offset}", Option::None)
        },
    )?;
    lsp::Server::new(
        router,
        lsp::Documents::new(128, 1048576)?,
        128,
        json::object(Vec::from_array([("hoverProvider", json::Value::Bool(true))])),
    )
}

fn completed_notification(completed: lsp::Completed) -> lsp::Message {
    lsp::Message::Notification(
        "test/completed",
        Option::Some(
            lsp::encode_value(lsp::Message::Response(Option::Some(completed.id), completed.result)),
        ),
    )
}

fn outgoing_fixture(server: lsp::Server, message: lsp::Message) -> Result[
    Option[lsp::Message],
    string,
] {
    let lsp::Message::Notification(method, Some(params)) = message else {
        return Result::Ok(Option::None)
    };
    if method != "test/outgoing" {
        return Result::Ok(Option::None)
    }
    let id = lsp::Id::from_json(json::field(params, "id").ok_or("id required")?).map_err(
        |error| error.to_string(),
    )?;
    let timeout = json::field(params, "timeout").and_then(|value| json::as_int(value)).ok_or(
        "timeout required",
    )?;
    let duration = time::Duration::checked_from_milliseconds(timeout.to_i64()).ok_or(
        "invalid timeout",
    )?;
    Result::Ok(
        Option::Some(
            server.session().request_with_timeout(
                id,
                "client/echo",
                Option::Some(json::object(Vec::new())),
                Option::Some(duration),
            ).map_err(|error| error.to_string())?,
        ),
    )
}

fn serve() -> Result[isize, string] {
    let server = server().map_err(|problem| problem.to_string())?;
    let transport = lsp::Stdio::new(lsp::FrameLimits::standard())?;
    while let Some(body) = transport.read_body()? {
        match lsp::decode(body) {
            Ok(message) => {
                if let Some(request) = outgoing_fixture(server, message)? {
                    transport.write(request)?;
                    continue
                } else {
                    match server.handle(message) {
                        Ok(event) => {
                            if let Some(reply) = event.reply {
                                transport.write(reply)?;
                            }
                            if let Some(completed) = event.completed {
                                transport.write(completed_notification(completed))?;
                            }
                            if let Some(code) = event.exit_code {
                                return Result::Ok(code)
                            }
                        },
                        Err(problem) => io::eprintln(problem),
                    }
                }
                for expired in server.poll_outgoing_timeouts().map_err(|error| error.to_string())? {
                    transport.write(expired.cancellation)?;
                    transport.write(completed_notification(expired.completed))?;
                }
            },
            Err(problem) => transport.write(
                lsp::Message::Response(Option::None, Result::Err(problem)),
            )?,
        }
    }
    Result::Ok(
        if server.phase() == lsp::Phase::Shutdown {
            0
        } else {
            1
        },
    )
}

fn main() -> () {
    if env::args().len() == 1 {
        match server() {
            Ok(_) => println("lsp consumer: ok"),
            Err(problem) => {
                io::eprintln(problem);
                process::exit(1);
            },
        }
    } else {
        match serve() {
            Ok(code) => process::exit(code),
            Err(problem) => {
                io::eprintln(problem);
                process::exit(1);
            },
        }
    }
}
