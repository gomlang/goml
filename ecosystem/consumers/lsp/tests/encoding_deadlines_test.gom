package tests;

use consumer::lsp as app;
use ecosystem::lsp;
use std::json;
use std::testing;
use std::time;

#[test]
fn negotiated_documents_and_outgoing_deadlines_cross_package_boundaries() -> () {
    let server = testing::expect_ok(app::server(), "server");
    let _ = process(
        server,
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{\"general\":{\"positionEncodings\":[\"utf-32\",\"utf-8\"]}}}}",
    );
    let _ = process(server, "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\"}");
    testing::assert_eq(server.position_encoding(), lsp::PositionEncoding::Utf32);
    let _ = process(
        server,
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///unicode\",\"languageId\":\"goml\",\"version\":1,\"text\":\"a😀é\\r\\n中\"}}}",
    );
    let document = testing::expect_some(server.documents().get("file:///unicode"), "document");
    testing::assert_eq(document.encoding(), lsp::PositionEncoding::Utf32);
    testing::assert_eq(
        testing::expect_ok(document.offset(lsp::Position { line: 0, character: 2 }), "offset"),
        5,
    );
    let _ = process(
        server,
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"file:///unicode\",\"version\":2},\"contentChanges\":[{\"range\":{\"start\":{\"line\":0,\"character\":1},\"end\":{\"line\":0,\"character\":2}},\"rangeLength\":1,\"text\":\"X\"}]}}",
    );
    testing::assert_eq(
        testing::expect_some(server.documents().get("file:///unicode"), "changed").content(),
        "aXé\r\n中",
    );
    testing::assert_eq(document.content(), "a😀é\r\n中");
    let id = lsp::Id::Text("client/config");
    testing::assert_ok(
        server.session().request_with_timeout(
            id,
            "workspace/configuration",
            Option::Some(json::object(Vec::new())),
            Option::Some(time::Duration::from_milliseconds(0)),
        ),
    );
    testing::assert_some(server.next_timeout());
    let expired = testing::expect_ok(server.poll_outgoing_timeouts(), "expire");
    testing::assert_eq(expired.len(), 1);
    testing::assert_eq(expired[0].completed.id, id);
    testing::assert_eq(testing::expect_err(expired[0].completed.result, "timeout").code, -32803);
    testing::assert_ok(lsp::encode(expired[0].cancellation));
    testing::assert_none(server.next_timeout());
}
