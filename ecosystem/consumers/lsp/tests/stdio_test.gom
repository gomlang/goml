package tests;

use std::bytes;
use std::process;
use std::testing;
use std::time;

fn stdio_exchange(binary: string, input: string) -> process::Output {
    testing::expect_ok(
        process::Command::new(binary).arg("--stdio").input(bytes::Bytes::from_string(input)).output_timeout_structured(
            time::Duration::from_seconds(10),
        ),
        "stdio server",
    )
}

fn stdio_frame(body: string) -> string {
    "Content-Length: " + body.byte_len().to_string() + "\r\n\r\n" + body
}

#[test]
fn actual_stdio_frames_unicode_dispatch_and_failure_exit_codes() -> () {
    let binary = stdio_binary();
    let mut wire = stdio_frame(
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{}}}",
    );
    wire += stdio_frame("{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}");
    for index in 0..100 {
        wire += stdio_frame(
            "{\"jsonrpc\":\"2.0\",\"id\":" + (index + 2).to_string()
                + ",\"method\":\"test/echo\",\"params\":{\"text\":\"中😀\",\"index\":"
                + index.to_string()
                + "}}",
        );
    }
    wire += stdio_frame("{\"jsonrpc\":\"2.0\",\"id\":102,\"method\":\"shutdown\"}");
    wire += stdio_frame("{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}");
    let output = stdio_exchange(binary, wire);
    testing::assert(output.status().success());
    testing::assert_eq(output.stderr().len(), 0);
    let offset = Ref::new(0);
    let data = output.stdout();
    let mut count = 0;
    while offset.get() < data.len() {
        let value = testing::expect_ok(
            decode_stdio_message(
                |amount| {
                    let start = offset.get();
                    if amount < 0 || amount > data.len() - start {
                        return Result::Err("truncated captured frame");
                    }
                    offset.set(start + amount);
                    Result::Ok(bytes::Bytes::from_vec(data.slice(start, start + amount).to_vec()))
                },
                false,
            ),
            "independent frame decoder",
        );
        testing::assert_eq(wire_integer(wire_field(value, "id")), count + 1);
        if count > 0 && count <= 100 {
            let result = wire_field(value, "result");
            testing::assert_eq(wire_string(wire_field(result, "text")), "中😀");
            testing::assert_eq(wire_integer(wire_field(result, "index")), count - 1);
        }
        count += 1;
    }
    testing::assert_eq(count, 102);
    for wire in Vec::from_array(
        [
            "Content-Length: 10\r\n\r\nx",
            "Content-Length: -1\r\n\r\n",
            "",
            stdio_frame("{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}"),
        ],
    ) {
        let output = stdio_exchange(binary, wire);
        testing::assert(output.status().code() == Option::Some(1));
        testing::assert_eq(output.stdout().len(), 0);
    }
}
