package tests;

use ecosystem::lsp;
use std::testing;

#[test]
fn independently_counted_unicode_boundaries_for_every_negotiated_encoding() -> () {
    let alphabet = Vec::from_array(["a", "😀", "é", "中", "é", "👩‍💻", "\t", "𐐀"]);
    let encodings = Vec::from_array(
        [lsp::PositionEncoding::Utf8, lsp::PositionEncoding::Utf16, lsp::PositionEncoding::Utf32],
    );
    for mode in 0..3 {
        for seed in 0..100 {
            let lines = Vec::new();
            let mut source = "";
            for line in 0..3 {
                let mut text = "";
                for index in 0..1 + (seed * 7 + line * 3) % 18 {
                    text += alphabet[(seed * 11 + index * 5 + line) % alphabet.len()];
                }
                lines.push(text);
                source += text
                    + if line % 3 == 0 {
                        "\r\n"
                    } else if line % 3 == 1 {
                        "\r"
                    } else {
                        "\n"
                    };
            }
            let document = testing::expect_ok(
                lsp::Document::new_with_encoding(
                    "file:///oracle",
                    "goml",
                    1,
                    source,
                    encodings[mode],
                ),
                "document",
            );
            let mut base = 0;
            for line in 0..lines.len() {
                let boundaries: HashMap[isize, isize] = HashMap::new();
                let mut units = 0;
                let mut bytes = 0;
                boundaries.set(0, 0);
                for (_, scalar) in lines[line].char_indices() {
                    let length = scalar.to_string().byte_len();
                    bytes += length;
                    units += if mode == 0 {
                        length
                    } else if mode == 1 && scalar.to_u32() > 65535 {
                        2
                    } else {
                        1
                    };
                    boundaries.set(units, bytes);
                }
                for character in 0..units + 1 {
                    let offset = document.offset(lsp::Position { line, character });
                    match boundaries.get(character) {
                        Some(expected) => testing::assert_eq(
                            testing::expect_ok(offset, "valid scalar boundary"),
                            base + expected,
                        ),
                        None => testing::assert_err(offset),
                    }
                }
                testing::assert_eq(
                    testing::expect_ok(
                        document.offset(lsp::Position { line, character: 2147483647 }),
                        "clamped line end",
                    ),
                    base + bytes,
                );
                base += bytes
                    + if line % 3 == 0 {
                        2
                    } else {
                        1
                    };
            }
            testing::assert_eq(
                testing::expect_ok(
                    document.offset(lsp::Position { line: 3, character: 0 }),
                    "trailing empty line",
                ),
                source.byte_len(),
            );
            let changed = testing::expect_ok(
                document.changed(
                    2,
                    Vec::from_array(
                        [
                            lsp::Change {
                                range: Option::Some(
                                    lsp::Range {
                                        start: lsp::Position { line: 0, character: 0 },
                                        end: lsp::Position { line: 3, character: 0 },
                                    },
                                ),
                                range_length: Option::None,
                                text: "replacement 中😀\n",
                            },
                        ],
                    ),
                    65536,
                ),
                "transactional replacement",
            );
            testing::assert_eq(changed.content(), "replacement 中😀\n");
            testing::assert_eq(document.content(), source);
        }
    }
}
