package tests;

use consumer::lsp as app;
use ecosystem::lsp;
use std::json;
use std::testing;
use std::time;

fn process(server: lsp::Server, body: string) -> lsp::Event {
    testing::expect_ok(server.handle(testing::expect_ok(lsp::decode(body), "decode")), "handle")
}

#[test]
fn independent_deferred_typed_dispatch_and_timeout() -> () {
    let server = testing::expect_ok(app::server(), "server");
    let _ = process(
        server,
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{}}}",
    );
    let _ = process(server, "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}");
    let message = testing::expect_ok(
        lsp::decode(
            "{\"jsonrpc\":\"2.0\",\"id\":\"add\",\"method\":\"test/add\",\"params\":{\"left\":20,\"right\":22}}",
        ),
        "decode",
    );
    let dispatch = testing::expect_ok(server.accept(message), "accept");
    testing::assert_none(dispatch.event.reply);
    let pending = testing::expect_some(dispatch.request, "pending");
    testing::assert_some(pending.params());
    let reply = testing::expect_ok(server.execute(pending), "execute");
    let lsp::Message::Response(_, Ok(value)) = reply else {
        testing::fail("expected typed deferred result");
        return
    };
    testing::assert_eq(
        json::as_int(testing::expect_some(json::field(value, "value"), "sum")).unwrap_or(-1),
        42,
    );
    testing::assert_ok(
        server.accept_with_timeout(message, Option::Some(time::Duration::from_milliseconds(0))),
    );
    let expired = testing::expect_ok(server.poll_timeouts(), "poll");
    testing::assert_eq(expired.len(), 1);
    testing::assert_none(server.next_timeout());
}

#[test]
fn independent_typed_callback_and_exported_protocol_types() -> () {
    let server = testing::expect_ok(app::server(), "server");
    let _ = process(
        server,
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{}}}",
    );
    let _ = process(server, "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}");
    let event = process(
        server,
        "{\"jsonrpc\":\"2.0\",\"id\":\"add\",\"method\":\"test/add\",\"params\":{\"left\":20,\"right\":22}}",
    );
    let reply = testing::expect_some(event.reply, "reply");
    let lsp::Message::Response(Some(id), Ok(value)) = reply else {
        testing::fail("expected success");
        return
    };
    testing::assert_eq(id, lsp::Id::Text("add"));
    testing::assert_eq(
        json::as_int(testing::expect_some(json::field(value, "value"), "value")).unwrap_or(-1),
        42,
    );
    let decoder = testing::expect_ok(
        lsp::FrameDecoder::new(lsp::FrameLimits::standard()),
        "decoder",
    );
    testing::assert_ok(decoder.push(testing::expect_ok(lsp::frame(reply), "frame").as_slice()));
    let wire = testing::expect_some(testing::expect_ok(decoder.next(), "next"), "body");
    testing::assert_ok(lsp::decode(wire));
    testing::assert_ok(decoder.finish());
}
