package main;

use ecosystem::websocket as ws;
use std::context;
use std::net;
use std::task;
use std::testing;
use std::time;

pub fn exercise() -> () {
    context::with_timeout(
        context::Context::background(),
        time::Duration::from_seconds(5),
        |ctx, _| {
            let listener = testing::expect_ok(
                net::TcpListener::bind(
                    testing::expect_ok(net::SocketAddr::parse("127.0.0.1:0"), "address"),
                ),
                "listener",
            );
            defer {
                let _ = listener.close();
            };
            let address = testing::expect_ok(listener.local_addr(), "bound address");
            task::scope(
                |scope| {
                    let server = scope.spawn(
                        |_| {
                            let stream = testing::expect_ok(
                                listener.accept_with(net::WaitOptions::new().with_context(ctx)),
                                "accept",
                            ).0;
                            let socket = testing::expect_ok(
                                ws::server(
                                    ws::Transport::tcp(stream),
                                    ws::Limits::standard(),
                                    ctx,
                                    |request| {
                                        testing::assert_eq(request.target, "/echo");
                                        Result::Ok(Option::Some("goml.echo"))
                                    },
                                ),
                                "server upgrade",
                            );
                            defer {
                                let _ = socket.abort();
                            };
                            let message = testing::expect_ok(socket.receive(ctx), "server receive");
                            testing::assert_ok(socket.send(message, ctx));
                            match testing::expect_ok(socket.receive(ctx), "server close") {
                                Close(_) => {},
                                _ => testing::fail("expected close"),
                            }
                            testing::assert(socket.is_closed());
                        },
                    );
                    let stream = testing::expect_ok(
                        net::TcpStream::connect_with(
                            address,
                            net::WaitOptions::new().with_context(ctx),
                        ),
                        "connect",
                    );
                    let request = testing::expect_ok(
                        ws::ClientRequest::new("localhost", "/echo", Vec::from_array(["goml.echo"])),
                        "request",
                    );
                    let (socket, protocol) = testing::expect_ok(
                        ws::client(ws::Transport::tcp(stream), request, ws::Limits::standard(), ctx),
                        "client upgrade",
                    );
                    defer {
                        let _ = socket.abort();
                    };
                    testing::assert_eq(
                        testing::expect_some(protocol, "selected protocol"),
                        "goml.echo",
                    );
                    testing::assert_ok(socket.send(ws::Message::Text("GoML 双向 echo 😀"), ctx));
                    match testing::expect_ok(socket.receive(ctx), "echo") {
                        Text(value) => testing::assert_eq(value, "GoML 双向 echo 😀"),
                        _ => testing::fail("expected text"),
                    }
                    testing::assert_ok(
                        socket.close(
                            Option::Some(ws::CloseFrame { code: 1000, reason: "complete" }),
                            ctx,
                        ),
                    );
                    match testing::expect_ok(socket.receive(ctx), "client close") {
                        Close(_) => {},
                        _ => testing::fail("expected close"),
                    }
                    testing::assert(socket.is_closed());
                    server.join();
                },
            );
        },
    );
}

fn main() -> () {
    exercise();
    println("websocket consumer: handshake, duplex UTF-8 echo and clean close ok");
}
