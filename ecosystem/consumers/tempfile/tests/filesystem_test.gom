package tests;

use consumer::tempfile as app;
use ecosystem::tempfile;
use std::fs;
use std::env;
use std::path;
use std::process;
use std::testing;
use std::time;

#[test]
fn filesystem_roundtrip_ownership_permissions_and_concurrent_persist() -> () {
    for _ in 0..5 {
        let directory = testing::expect_ok(tempfile::tempdir(), "directory");
        defer {
            testing::assert_ok(directory.close());
        };
        let executable = testing::expect_ok(env::current_exe_structured(), "test executable");
        let scoped = testing::expect_ok(
            process::Command::new(executable).arg(
                "consumer::tempfile::tests::public_api_across_registry_boundary",
            ).env("TMPDIR", directory.path()).output_timeout_structured(
                time::Duration::from_seconds(30),
            ),
            "scoped TMPDIR subprocess",
        );
        testing::assert(scoped.status().success());
        testing::assert_eq(
            testing::expect_ok(fs::read_dir_names_structured(directory.path()), "scoped cleanup").len(),
            0,
        );
        testing::assert_ok(app::fs_roundtrip(directory.path()));
        let names = testing::expect_ok(
            fs::read_dir_names_structured(directory.path()),
            "directory entries",
        );
        testing::assert_eq(names.len(), 35);
        let payload = testing::expect_ok(
            fs::read_bytes_structured(path::join(directory.path(), "payload.bin")),
            "binary payload",
        );
        testing::assert_eq(payload.len(), 256);
        for index in 0..256 {
            testing::assert_eq(payload.as_slice()[index], index.to_u8());
        }
        testing::assert_eq(
            testing::expect_ok(
                fs::read_file_structured(path::join(directory.path(), "tree/nested.txt")),
                "retained tree",
            ),
            "retained tree",
        );
        for name in Vec::from_array(["payload.bin", "tree"]) {
            testing::assert_eq(
                testing::expect_ok(fs::metadata(path::join(directory.path(), name)), "permissions").permissions().mode()
                    & 0o077,
                0,
            );
        }
        let mut kept = 0;
        for name in names {
            if name.starts_with("upload-") {
                testing::assert(name.ends_with(".part"));
                testing::assert_eq(
                    testing::expect_ok(
                        fs::read_file_structured(path::join(directory.path(), name)),
                        "kept content",
                    ),
                    "kept",
                );
                kept += 1;
            }
        }
        testing::assert_eq(kept, 1);
        for index in 0..32 {
            testing::assert_eq(
                testing::expect_ok(
                    fs::read_file_structured(
                        path::join(directory.path(), "concurrent-" + index.to_string()),
                    ),
                    "concurrent persist",
                ),
                index.to_string(),
            );
        }
    }
}
