package main;

use ecosystem::tempfile;
use std::bytes;
use std::env;
use std::fs;
use std::io;
use io::{Read, Write};
use std::path;
use std::process;
use std::task;
use std::testing;

pub fn exercise() -> Result[(), string] {
    tempfile::with_tempdir(
        tempfile::Builder::new(),
        |directory| {
            let builder = tempfile::Builder::new().parent(directory.path()).prefix("example-").suffix(
                ".data",
            );
            let destination = path::join(directory.path(), "saved");
            let file = builder.tempfile()?;
            defer {
                let _ = file.close();
            };
            file.write_all(bytes::Bytes::from_string("cross-module").as_slice())?;
            let persisted = file.persist(destination)?;
            defer {
                let _ = persisted.close();
            };
            persisted.rewind()?;
            testing::assert_eq(persisted.read_to_string(12)?, "cross-module");
            testing::assert(file.is_closed());
            let buffer = tempfile::SpooledTempFile::with_builder(4, builder)?;
            defer {
                let _ = buffer.close();
            };
            buffer.write_all(bytes::Bytes::from_string("buffered").as_slice())?;
            testing::assert(buffer.is_rolled());
            buffer.rewind()?;
            testing::assert_eq(buffer.read_to_string(8)?, "buffered");
            Result::Ok(())
        },
    ).map_err(|error| error.to_string())
}

pub fn fs_roundtrip(parent: string) -> Result[(), string] {
    let builder = tempfile::Builder::new().parent(parent).prefix("upload-").suffix(".part");
    let file = builder.tempfile().map_err(|error| error.to_string())?;
    defer {
        let _ = file.close();
    };
    let data = Vec::new();
    for value in 0..256 {
        data.push(value.to_u8());
    }
    file.write_all(data.as_slice()).map_err(|error| error.to_string())?;
    file.sync_all().map_err(|error| error.to_string())?;
    let output = file.persist(path::join(parent, "payload.bin")).map_err(|error| error.to_string())?;
    output.close().map_err(|error| error.to_string())?;
    let directory = builder.tempdir().map_err(|error| error.to_string())?;
    defer {
        let _ = directory.close();
    };
    fs::write_file_structured(path::join(directory.path(), "nested.txt"), "retained tree").map_err(
        |error| error.to_string(),
    )?;
    let _ = directory.persist(path::join(parent, "tree")).map_err(|error| error.to_string())?;
    let kept = builder.tempfile().map_err(|error| error.to_string())?;
    defer {
        let _ = kept.close();
    };
    kept.write_all(bytes::Bytes::from_string("kept").as_slice()).map_err(|error| error.to_string())?;
    let permanent = kept.keep().map_err(|error| error.to_string())?;
    permanent.file.close().map_err(|error| error.to_string())?;
    println(permanent.path);
    tempfile::with_tempfile(
        builder,
        |temporary| {
            temporary.write_all(bytes::Bytes::from_string("scope-cleaned").as_slice())?;
            Result::Ok(())
        },
    ).map_err(|error| error.to_string())?;
    task::scope(
        |scope| {
            let jobs = Vec::new();
            for index in 0..32 {
                jobs.push(
                    scope.spawn(
                        |_| {
                            tempfile::with_tempfile(
                                builder,
                                |temporary| {
                                    temporary.write_all(
                                        bytes::Bytes::from_string(index.to_string()).as_slice(),
                                    )?;
                                    let persisted = temporary.persist(
                                        path::join(parent, "concurrent-" + index.to_string()),
                                    )?;
                                    persisted.close()
                                },
                            )
                        },
                    ),
                );
            }
            for result in task::join_all(jobs) {
                result.map_err(|error| error.to_string())?;
            }
            Result::Ok(())
        },
    )
}

fn main() -> () {
    let args = env::args();
    let result = if args.len() == 3 && args[1] == "fs-roundtrip" {
        fs_roundtrip(args[2])
    } else {
        exercise()
    };
    match result {
        Ok(()) => println("tempfile consumer: ok"),
        Err(error) => {
            println(error);
            process::exit(1);
        },
    }
}
