package tests;

use ecosystem::graph as network;
use std::testing;

struct Task {
    name: string,
    duration: i64,
}

struct Dependency {
    delay: i64,
}

#[test]
fn downstream_labels_callbacks_and_graph_transform() -> () {
    let tasks: network::Graph[Task, Dependency] = network::Graph::new(true);
    let a = tasks.add_node(Task { name: "compile", duration: 4 });
    let b = tasks.add_node(Task { name: "link", duration: 2 });
    let c = tasks.add_node(Task { name: "package", duration: 1 });
    testing::assert_ok(tasks.add_edge(a, b, Dependency { delay: 3 }));
    testing::assert_ok(tasks.add_edge(b, c, Dependency { delay: 2 }));
    testing::assert(
        testing::expect_ok(network::topological_sort(tasks), "schedule")
            == Vec::from_array([a, b, c]),
    );
    let overhead: i64 = 1;
    let paths = testing::expect_ok(
        network::dijkstra(tasks, a, |dependency| dependency.delay + overhead),
        "weighted callback",
    );
    testing::assert_eq(paths.distance_to(c).unwrap_or(-1), 7);
    let labels = testing::expect_ok(
        tasks.map(|task| f"{task.name}:{task.duration}", |dependency| dependency.delay),
        "generic map",
    );
    let first = testing::expect_some(labels.nodes.get(a), "mapped handle");
    testing::assert_eq(testing::expect_ok(labels.graph.node(first), "label"), "compile:4");
    testing::assert_eq(
        testing::expect_err(labels.graph.node(a), "foreign handle").kind,
        network::ErrorKind::WrongGraph,
    );
    let copy = testing::expect_ok(tasks.copy(), "copy");
    testing::assert_ok(tasks.remove_node(b));
    testing::assert_eq(tasks.edge_count(), 0);
    testing::assert_eq(copy.graph.edge_count(), 2);
}

#[test]
fn empty_graphs_and_direction_requirements() -> () {
    let directed: network::Graph[(), ()] = network::Graph::new(true);
    let undirected: network::Graph[(), ()] = network::Graph::new(false);
    testing::assert_eq(
        testing::expect_ok(network::topological_sort(directed), "empty order").len(),
        0,
    );
    testing::assert_eq(
        testing::expect_ok(network::strong_components(directed), "empty components").len(),
        0,
    );
    testing::assert_eq(
        testing::expect_ok(network::minimum_spanning_forest(undirected, |_| 0), "empty forest").components,
        0,
    );
    testing::assert_eq(
        testing::expect_err(network::topological_sort(undirected), "wrong direction").kind,
        network::ErrorKind::RequiresDirected,
    );
    testing::assert_eq(
        testing::expect_err(network::minimum_spanning_forest(directed, |_| 0), "wrong direction").kind,
        network::ErrorKind::RequiresUndirected,
    );
    let node = directed.add_node(());
    testing::assert_ok(directed.add_edge(node, node, ()));
    testing::assert_eq(
        testing::expect_err(network::topological_sort(directed), "self cycle").kind,
        network::ErrorKind::Cycle,
    );
}
