package main;

use ecosystem::graph as routes;
use std::testing;

fn main() -> () {
    let network: routes::Graph[string, i64] = routes::Graph::new(false);
    let east = network.add_node("east");
    let central = network.add_node("central");
    let west = network.add_node("west");
    testing::assert_ok(network.add_edge(east, central, 4));
    testing::assert_ok(network.add_edge(central, west, 3));
    testing::assert_ok(network.add_edge(east, west, 12));
    let paths = testing::expect_ok(routes::dijkstra(network, east, |cost| cost), "routes");
    let route = testing::expect_some(paths.route_to(west), "connected");
    testing::assert_eq(route.cost, 7);
    testing::assert_eq(route.edges.len(), 2);
    println("graph consumer: ok");
}
