package main;

use ecosystem::ansi;
use ecosystem::progress;
use ecosystem::terminal;
use std::context;
use std::env;
use std::io;
use std::json;
use std::serde::{Serialize};
use std::testing;

#[derive(Serialize)]
struct OracleRow {
    position: i64,
    total: i64,
    elapsed: i64,
    rate: Option[f64],
    eta: Option[i64],
    text: string,
}

pub fn exercise() -> () {
    let session = testing::expect_ok(
        terminal::Session::open(terminal::Options::defaults()),
        "session",
    );
    defer {
        let _ = session.close();
    };
    let clock = Channel::new(1);
    clock.send(0);
    let manager = testing::expect_ok(
        progress::Manager::new(
            session,
            progress::Options {
                mode: progress::Mode::Lines,
                width: 100,
                clock: progress::Clock::new(
                    || {
                        let value = clock.recv().unwrap_or(0);
                        clock.send(value);
                        value
                    },
                ),
                ..progress::Options::defaults(),
            },
        ),
        "manager",
    );
    defer {
        let _ = manager.shutdown();
    };
    let scan = testing::expect_ok(manager.add("scan", Option::None), "spinner");
    let copy = testing::expect_ok(manager.add("copy", Option::Some(12)), "bar");
    testing::assert_ok(scan.advance(3));
    testing::assert_ok(copy.advance(4));
    let _ = clock.recv();
    clock.send(2000);
    let snapshot = testing::expect_ok(manager.snapshot(), "snapshot");
    testing::assert_eq(snapshot.jobs[1].eta_ms.unwrap_or(-1), 4000);
    testing::assert_ok(manager.flush(context::Context::background()));
    testing::assert_ok(manager.log(context::Context::background(), "located 12 files"));
    testing::assert_ok(scan.finish("indexed"));
    testing::assert_ok(copy.finish("copied"));
    testing::assert_ok(manager.shutdown());
}

fn oracle() -> () {
    let session = testing::expect_ok(
        terminal::Session::open(terminal::Options::defaults()),
        "session",
    );
    defer {
        let _ = session.close();
    };
    let clock = Channel::new(1);
    clock.send(0);
    let manager = testing::expect_ok(
        progress::Manager::new(
            session,
            progress::Options {
                clock: progress::Clock::new(
                    || {
                        let value = clock.recv().unwrap_or(0);
                        clock.send(value);
                        value
                    },
                ),
                ..progress::Options::defaults(),
            },
        ),
        "manager",
    );
    let job = testing::expect_ok(manager.add("work", Option::Some(1000)), "job");
    let style = progress::Style {
        bar_columns: 10,
        show_rate: false,
        show_eta: false,
        ..progress::Style::defaults(),
    };
    for index in 1..401 {
        let total = ((index * 37) % 1000 + 1).to_i64();
        let position = ((index * 17) % (total.to_isize() + 1)).to_i64();
        testing::assert_ok(job.reset(Option::Some(total)));
        let _ = clock.recv();
        clock.send(index.to_i64() * 10000 + index.to_i64() * 7);
        testing::assert_ok(job.set_position(position));
        let state = testing::expect_ok(manager.snapshot(), "snapshot").jobs[0];
        let text = testing::expect_ok(
            progress::render_job(state, 100, style, ansi::Profile::Plain),
            "render",
        );
        let row = OracleRow {
            position,
            total,
            elapsed: state.elapsed_ms,
            rate: state.per_second,
            eta: state.eta_ms,
            text,
        };
        println(testing::expect_ok(json::try_to_string(row), "json"));
    }
    testing::assert_ok(job.remove(context::Context::background()));
    testing::assert_ok(manager.shutdown());
}

fn interactive() -> Result[(), io::Error] {
    let session = terminal::Session::open(
        terminal::Options { raw_mode: true, hide_cursor: true, ..terminal::Options::defaults() },
    )?;
    defer {
        let _ = session.close();
    };
    let manager = progress::Manager::new(
        session,
        progress::Options { refresh_ms: 0, ..progress::Options::defaults() },
    )?;
    defer {
        let _ = manager.shutdown();
    };
    let bar = manager.add("download", Option::Some(100))?;
    let spinner = manager.add("扫描 中 👩‍💻", Option::None)?;
    let ctx = context::Context::background();
    manager.log(ctx, "READY")?;
    loop {
        if let Some(event) = session.next_event(ctx, 100)? {
            match event {
                terminal::Event::Key(key) => match key.code {
                    terminal::KeyCode::Char('u') => {
                        bar.advance(10)?;
                        manager.log(ctx, "UPDATED")?;
                    },
                    terminal::KeyCode::Char('l') => manager.log(ctx, "LOG coordinated output")?,
                    terminal::KeyCode::Char('q') => {
                        bar.finish("done")?;
                        spinner.cancel("stop")?;
                        break
                    },
                    _ => (),
                },
                terminal::Event::Resize(size) => manager.log(
                    ctx,
                    "RESIZED " + size.columns.to_string(),
                )?,
                _ => (),
            }
        }
        manager.tick(ctx)?;
    }
    manager.shutdown()?;
    session.write("CLOSED\r\n")?;
    session.close()
}

fn main() -> () {
    let args = env::args();
    if args.len() > 1 && args[1] == "oracle" {
        oracle();
    } else if args.len() > 1 && args[1] == "pty" {
        testing::assert_ok(interactive());
    } else {
        exercise();
        println("progress consumer: snapshots, rates, bars, spinners and coordinated logs ready");
    }
}
