package tests;

use ecosystem::ansi;
use ecosystem::progress;
use ecosystem::terminal;
use std::context;
use std::num;
use std::testing;

fn reference_float(value: i64) -> f64 {
    testing::expect_ok(
        num::parse_float64_structured(value.to_string()),
        "reference numeric conversion",
    )
}

#[test]
fn independent_arithmetic_rate_eta_spinner_and_bar_oracle() -> () {
    let session = testing::expect_ok(
        terminal::Session::open(terminal::Options::defaults()),
        "session",
    );
    defer {
        testing::assert_ok(session.close());
    };
    let clock: Channel[i64] = Channel::new(1);
    clock.send(0);
    let manager = testing::expect_ok(
        progress::Manager::new(
            session,
            progress::Options {
                clock: progress::Clock::new(
                    || {
                        let value = clock.recv().unwrap_or(0);
                        clock.send(value);
                        value
                    },
                ),
                ..progress::Options::defaults(),
            },
        ),
        "manager",
    );
    defer {
        testing::assert_ok(manager.shutdown());
    };
    let job = testing::expect_ok(manager.add("work", Option::Some(1000)), "job");
    let style = progress::Style {
        bar_columns: 10,
        show_rate: false,
        show_eta: false,
        ..progress::Style::defaults(),
    };
    for index in 1..401 {
        let total = ((index * 37) % 1000 + 1).to_i64();
        let position = ((index * 17) % (total.to_isize() + 1)).to_i64();
        testing::assert_ok(job.reset(Option::Some(total)));
        let _ = clock.recv();
        clock.send(index.to_i64() * 10007);
        testing::assert_ok(job.set_position(position));
        let state = testing::expect_ok(manager.snapshot(), "snapshot").jobs[0];
        testing::assert_eq(state.position, position);
        testing::assert(state.total == Option::Some(total));
        testing::assert_eq(state.elapsed_ms, 10007);
        if position == 0 {
            testing::assert_none(state.per_second);
            testing::assert_none(state.eta_ms);
        } else {
            let actual = testing::expect_some(state.per_second, "rate");
            let expected = reference_float(position) * 1000.0 / 10007.0;
            let difference = if actual > expected {
                actual - expected
            } else {
                expected - actual
            };
            testing::assert(difference <= expected * 1e-12);
            testing::assert_eq(
                testing::expect_some(state.eta_ms, "ETA"),
                ((total - position) * 10007 + position - 1) / position,
            );
        }
        let filled = (position * 10 / total).to_isize();
        let expected = "| work [" + "=".repeat(filled) + "-".repeat(10 - filled) + "] "
            + position.to_string()
            + "/"
            + total.to_string();
        testing::assert_eq(
            testing::expect_ok(
                progress::render_job(state, 100, style, ansi::Profile::Plain),
                "rendered bar",
            ),
            expected,
        );
    }
    testing::assert_ok(job.remove(context::Context::background()));
}
