package tests;

use ecosystem::diff;
use ecosystem::proptest;
use std::testing;

#[test]
fn randomized_patch_roundtrips() -> () {
    let alphabet = testing::expect_ok(
        proptest::select(Vec::from_array(['a', 'b', '\n', '\r', '你', '😀'])),
        "alphabet",
    );
    let strings = testing::expect_ok(proptest::strings(alphabet, 0, 50), "strings");
    let pairs = strings.zip(strings);
    testing::assert_none(
        testing::expect_ok(
            proptest::check(
                pairs,
                proptest::Config::new(77),
                |pair: (string, string)| {
                    let patch = match diff::patch(pair.0, pair.1, "old", "new", 2) {
                        Ok(value) => value,
                        Err(_) => return false,
                    };
                    if patch.apply(pair.0).unwrap_or("wrong") != pair.1 {
                        return false
                    }
                    if patch.reverse().apply(pair.1).unwrap_or("wrong") != pair.0 {
                        return false
                    }
                    let text = match patch.to_unified() {
                        Ok(value) => value,
                        Err(_) => return false,
                    };
                    match diff::parse_unified(text) {
                        Ok(value) => value.apply(pair.0).unwrap_or("wrong") == pair.1,
                        Err(_) => false,
                    }
                },
            ),
            "patch property",
        ),
    );
}
