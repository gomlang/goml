package tests;

use ecosystem::diff;
use ecosystem::tempfile;
use std::bytes;
use std::fs;
use std::json;
use std::process;
use std::testing;
use std::time;
use std::utf8;
use utf8::BytesUtf8;

fn gnu_command(program: string, arguments: Vec[string]) -> process::Output {
    testing::expect_ok(
        process::Command::new(program).args(arguments).env("LC_ALL", "C").input(bytes::Bytes::new()).output_timeout_structured(
            time::Duration::from_seconds(30),
        ),
        "GNU " + program,
    )
}

#[test]
fn unified_patches_interoperate_with_gnu_diff_and_patch() -> () {
    let source = testing::expect_ok(
        fs::read_file_structured("tests/data/gnu-cases.json"),
        "GNU inputs",
    );
    let cases: Vec[Vec[string]] = testing::expect_ok(json::from_string(source), "GNU input pairs");
    testing::assert_eq(cases.len(), 48);
    let temporary = testing::expect_ok(tempfile::tempdir(), "GNU comparison temporary directory");
    defer testing::assert_ok(temporary.close());
    let old_path = temporary.path() + "/old";
    let new_path = temporary.path() + "/new";
    let patch_path = temporary.path() + "/generated.patch";
    let output_path = temporary.path() + "/applied";
    for pair in cases {
        testing::assert_eq(pair.len(), 2);
        let old = pair[0];
        let new = pair[1];
        testing::assert_ok(fs::write_file_structured(old_path, old));
        testing::assert_ok(fs::write_file_structured(new_path, new));
        for algorithm in Vec::from_array([diff::Algorithm::Myers, diff::Algorithm::Hirschberg]) {
            let patch = testing::expect_ok(
                diff::patch_with(old, new, "old", "new", 3, diff::Options::new(), algorithm),
                "GoML patch",
            );
            let encoded = testing::expect_ok(patch.to_unified(), "encode patch");
            testing::assert_ok(fs::write_file_structured(patch_path, encoded));
            if old != new {
                let result = gnu_command(
                    "patch",
                    Vec::from_array(
                        ["--batch", "--silent", "--output", output_path, old_path, patch_path],
                    ),
                );
                if !result.status().success() {
                    testing::fail(
                        "GNU patch rejected GoML output: "
                            + result.stderr().to_string_utf8().unwrap_or("invalid UTF-8 stderr"),
                    );
                }
                testing::assert_eq(
                    testing::expect_ok(fs::read_file_structured(output_path), "GNU patch output"),
                    new,
                );
            }
        }
        let result = gnu_command(
            "diff",
            Vec::from_array(["-u", "--label", "old", "--label", "new", old_path, new_path]),
        );
        let status = result.status().code();
        testing::assert(status == Option::Some(0) || status == Option::Some(1));
        let unified = testing::expect_ok(result.stdout().to_string_utf8(), "GNU unified patch");
        let patch = testing::expect_ok(diff::parse_unified(unified), "parse GNU patch");
        testing::assert_eq(testing::expect_ok(patch.apply(old), "apply GNU patch"), new);
    }
}
