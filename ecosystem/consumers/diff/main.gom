package main;

use ecosystem::diff;
use std::env;
use std::fs;
use std::process;
use std::testing;

fn execute(args: Vec[string]) -> Result[(), string] {
    if args.len() != 5 {
        return Result::Err("usage: diff produce OLD NEW PATCH | diff apply OLD PATCH NEW")
    }
    let old = fs::read_file_structured(args[2]).map_err(|problem| problem.to_string())?;
    let second = fs::read_file_structured(args[3]).map_err(|problem| problem.to_string())?;
    let output = if args[1] == "produce" {
        diff::patch(old, second, "old", "new", 3)?.to_unified()?
    } else if args[1] == "apply" {
        diff::parse_unified(second)?.apply(old)?
    } else {
        return Result::Err("expected produce or apply")
    };
    fs::write_file_structured(args[4], output).map_err(|problem| problem.to_string())
}

fn main() -> () {
    let args = env::args();
    if args.len() == 1 {
        let patch = testing::expect_ok(diff::patch("a\nb\n", "a\nc\n", "a", "b", 3), "patch");
        testing::assert_eq(testing::expect_ok(patch.apply("a\nb\n"), "apply"), "a\nc\n");
        println("diff consumer: ok");
    } else if let Err(problem) = execute(args) {
        println(problem);
        process::exit(1);
    }
}
