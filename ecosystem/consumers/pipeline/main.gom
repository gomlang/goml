package main;

use ecosystem::pipeline;
use ecosystem::pipeline::{Stream, ParallelOptions, Order, RunOptions, Control, Error};
use std::env;
use std::io;
use std::json;
use std::process;
use std::task;
use std::time;

pub struct Issue {
    pub code: isize,
    pub detail: string,
}

pub struct Job {
    pub id: isize,
    pub weight: isize,
}

pub struct Output {
    pub key: string,
    pub total: isize,
}

pub fn exercise() -> Result[(), string] {
    let jobs = Vec::from_array(
        [Job { id: 1, weight: 2 }, Job { id: 2, weight: 4 }, Job { id: 3, weight: 6 }],
    );
    let source: Stream[Job, Issue] = pipeline::from_values(jobs);
    let multiplier = 7;
    let stream = source.parallel_map(
        ParallelOptions::new(3, 0, Order::Input),
        |_, job| Result::Ok(
            Output { key: "job-" + job.id.to_string(), total: job.weight * multiplier },
        ),
    ).map_err(|error| error.to_string())?;
    let values = stream.collect(RunOptions::standard()).map_err(|error| error.to_string())?;
    if values.len() != 3 || values[0].key != "job-1" || values[2].total != 42 {
        return Result::Err("cross-module generic pipeline failed")
    }
    let again = stream.collect(RunOptions::standard()).map_err(|error| error.to_string())?;
    if again[1].total != 28 {
        return Result::Err("pipeline cannot be reused")
    }
    let failed = source.try_map(
        |_, job| if job.id == 2 {
            Result::Err(Issue { code: 409, detail: "duplicate" })
        } else {
            Result::Ok(job.id)
        },
    ).collect(RunOptions::standard());
    let Err(problem) = failed else {
        return Result::Err("missing typed failure")
    };
    let cause = problem.cause.ok_or("missing typed cause")?;
    if cause.code != 409 || cause.detail != "duplicate" || problem.index != Option::Some(1) {
        return Result::Err("typed cause lost")
    }
    let channel: Channel[Job] = Channel::new(1);
    let actual = task::scope(
        |scope| {
            let producer = scope.spawn(
                |_| {
                    for job in jobs {
                        channel.send(job);
                    }
                    channel.close();
                },
            );
            let stream: Stream[Job, Issue] = pipeline::from_receiver(channel.receiver());
            let result = stream.fold(
                0,
                RunOptions::standard(),
                |_, sum, job| Result::Ok(sum + job.weight),
            );
            producer.join();
            result
        },
    ).map_err(|error| error.to_string())?;
    if actual != 12 {
        return Result::Err("channel fold failed")
    }
    Result::Ok(())
}

fn field(request: json::Value, name: string, fallback: isize) -> isize {
    json::field(request, name).and_then(|value| json::as_int(value)).unwrap_or(fallback)
}

fn numbers(values: Vec[isize]) -> json::Value {
    let encoded = Vec::new();
    for value in values {
        encoded.push(json::Value::Number(value.to_string()));
    }
    json::Value::Array(encoded)
}

fn groups(values: Vec[Vec[isize]]) -> json::Value {
    let encoded = Vec::new();
    for value in values {
        encoded.push(numbers(value));
    }
    json::Value::Array(encoded)
}

fn execute(request: json::Value) -> Result[json::Value, Error[Issue]] {
    let values = Vec::new();
    let inputs = json::field(request, "values").and_then(|value| json::as_array(value)).unwrap_or(
        Vec::new(),
    );
    for value in inputs {
        values.push(json::as_int(value).unwrap_or(0));
    }
    let source: Stream[isize, Issue] = pipeline::from_values(values);
    let mut run = RunOptions::standard();
    if let Some(limit) = json::field(request, "limit").and_then(|value| json::as_int(value)) {
        run = RunOptions { max_items: Option::Some(limit), ..run };
    }
    if field(request, "timeout", -1) >= 0 {
        run = run.with_timeout(
            time::Duration::from_milliseconds(field(request, "timeout", -1).to_i64()),
        );
    }
    let mode = json::field(request, "mode").and_then(|value| json::as_string(value)).unwrap_or(
        "map",
    );
    if mode == "chunks" {
        return Result::Ok(groups(source.chunks(field(request, "size", 3))?.collect(run)?))
    }
    if mode == "windows" {
        return Result::Ok(
            groups(
                source.windows(field(request, "size", 3), field(request, "step", 1))?.collect(run)?,
            ),
        )
    }
    if mode == "scan" {
        return Result::Ok(
            numbers(
                source.scan(
                    || 0,
                    |_, state, value| Result::Ok((state + value, Option::Some(state + value))),
                ).collect(run)?,
            ),
        )
    }
    if mode == "fold" {
        return Result::Ok(
            json::Value::Number(
                source.fold(0, run, |_, state, value| Result::Ok(state + value))?.to_string(),
            ),
        )
    }
    if mode == "zip" {
        let end = field(request, "end", 5);
        let other: Stream[isize, Issue] = pipeline::range(0, end, 1)?;
        let zipped = source.zip(other, field(request, "capacity", 1))?.collect(run)?;
        let output = Vec::new();
        for (a, b) in zipped {
            output.push(numbers(Vec::from_array([a, b])));
        }
        return Result::Ok(json::Value::Array(output))
    }
    if mode == "merge" {
        let other: Stream[isize, Issue] = pipeline::range(100, field(request, "end", 105), 1)?;
        return Result::Ok(
            numbers(
                pipeline::merge(Vec::from_array([source, other]), field(request, "capacity", 1))?.collect(
                    run,
                )?,
            ),
        )
    }
    let options = ParallelOptions {
        max_in_flight: field(request, "window", 6),
        ..ParallelOptions::new(
            field(request, "workers", 3),
            field(request, "capacity", 2),
            if field(request, "ordered", 1) == 1 {
                Order::Input
            } else {
                Order::Completion
            },
        ),
    };
    let factor = field(request, "factor", 1);
    let offset = field(request, "offset", 0);
    let divisor = field(request, "divisor", 2);
    let failure = field(request, "fail", -999);
    let stream = source.parallel_filter_map(
        options,
        |_, value| {
            if mode == "error" && value == failure {
                return Result::Err(Issue { code: 422, detail: "invalid item" })
            }
            let mapped = value * factor + offset;
            Result::Ok(
                if mode == "filter" && mapped % divisor == 0 {
                    Option::None
                } else {
                    Option::Some(mapped)
                },
            )
        },
    )?;
    let stream = if mode == "expand" {
        stream.flat_map(|value| pipeline::from_values(Vec::from_array([value, -value])))
    } else {
        stream
    };
    let stream = stream.skip(field(request, "skip", 0))?;
    let stream = stream.take(field(request, "take", 1000000))?;
    Result::Ok(numbers(stream.collect(run)?))
}

fn run() -> Result[(), string] {
    if env::args().len() == 1 {
        exercise()?;
        println("pipeline consumer: ok");
        return Result::Ok(())
    }
    let input = io::read_stdin_to_string().map_err(|error| error.to_string())?;
    let requests = json::as_array(json::parse(input)?).ok_or("expected requests")?;
    let results = Vec::new();
    for request in requests {
        results.push(
            match execute(request) {
                Ok(value) => value,
                Err(error) => json::Value::Object(
                    Vec::from_array(
                        [
                            ("error", json::Value::String(error.kind.debug())),
                            ("stage", json::Value::String(error.stage)),
                            (
                                "index",
                                error.index.map(|index| json::Value::Number(index.to_string())).unwrap_or(
                                    json::Value::Null,
                                ),
                            ),
                            (
                                "cause",
                                error.cause.map(|cause| json::Value::Number(cause.code.to_string())).unwrap_or(
                                    json::Value::Null,
                                ),
                            ),
                        ],
                    ),
                ),
            },
        );
    }
    println(json::encode(json::Value::Array(results)));
    Result::Ok(())
}

fn main() -> () {
    if let Err(message) = run() {
        io::eprintln(message);
        process::exit(1);
    }
}
