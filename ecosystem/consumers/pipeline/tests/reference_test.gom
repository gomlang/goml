package tests;

use ecosystem::verification::reference;
use std::json;
use std::testing;

#[test]
fn independent_sequence_models() -> () {
    let fixture = reference::load();
    let actual = reference::array(
        testing::expect_ok(
            reference::run_json("pipeline", reference::field(fixture, "input")),
            "reference protocol",
        ),
    );
    let expected = reference::array(reference::field(fixture, "expected"));
    let modes = reference::array(reference::field(fixture, "comparison"));
    testing::assert_eq(actual.len(), expected.len());
    for index in 0..expected.len() {
        let label = "pipeline case " + index.to_string();
        match reference::text(modes[index]) {
            "multiset" => reference::multiset(
                reference::array(actual[index]),
                reference::array(expected[index]),
                label,
            ),
            "error_kind" => reference::assert_equal(
                reference::field(actual[index], "error"),
                json::Value::String("ErrorKind::" + reference::text(expected[index])),
                label,
            ),
            _ => reference::assert_equal(actual[index], expected[index], label),
        }
    }
}
