package main;

use ecosystem::config;
use std::serde::{Deserialize, Serialize};
use std::testing;

#[derive(Serialize, Deserialize)]
struct Http {
    host: string,
    port: isize,
}

#[derive(Serialize, Deserialize)]
struct Settings {
    http: Http,
    workers: isize,
    features: Vec[string],
}

fn require[T](value: Result[T, config::Error]) -> T {
    match value {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            loop {}
        },
    }
}

fn validate(snapshot: config::Snapshot) -> Result[(), config::Error] {
    let settings: Settings = snapshot.decode()?;
    if settings.workers < 1 || settings.workers > 64 {
        return Result::Err(snapshot.invalid("/workers", "workers must be between 1 and 64"))
    }
    if settings.http.port < 1 || settings.http.port > 65535 {
        return Result::Err(snapshot.invalid("/http/port", "invalid HTTP port"))
    }
    Result::Ok(())
}

pub fn exercise() -> () {
    let defaults = require(
        config::Source::defaults(
            Settings {
                http: Http { host: "127.0.0.1", port: 8000 },
                workers: 2,
                features: Vec::from_array(["logging"]),
            },
        ),
    );
    let env = config::Source::environment_values(
        "environment",
        config::EnvOptions::new("SERVICE_"),
        Vec::from_array([("SERVICE_HTTP__HOST", "0.0.0.0"), ("SERVICE_WORKERS", "8")]),
    );
    let cli = config::Source::overrides(
        "command line",
        Vec::from_array(
            [
                require(config::Override::value("/http/port", 9000)),
                require(config::Override::value("/features/-", "metrics")),
            ],
        ),
    );
    let builder = config::Builder::new().with_source(defaults).with_source(
        config::Source::toml("settings.toml", "workers = 4\n[http]\nport = 8080\n"),
    ).with_source(env).with_source(cli).validate_with(validate);
    let live = require(config::Live::new(builder));
    let saved = live.snapshot();
    let settings: Settings = require(saved.decode());
    testing::assert_eq(settings.http.host, "0.0.0.0");
    testing::assert_eq(settings.http.port, 9000);
    testing::assert_eq(settings.workers, 8);
    testing::assert(settings.features == Vec::from_array(["logging", "metrics"]));
    testing::assert_eq(require(saved.origin("/http/port")).source, "command line");
    testing::assert_eq(require(saved.origin("/workers")).detail, "SERVICE_WORKERS");
    let reloaded = require(live.reload());
    testing::assert(!reloaded.changed);
    testing::assert_eq(saved.revision(), 1);
    testing::assert_eq(live.snapshot().revision(), 2);
    let invalid = config::Builder::new().with_source(config::Source::json("bad", "{\"workers\":0}")).validate_with(
        |snapshot| {
            let value: isize = snapshot.decode_at("/workers")?;
            if value == 0 {
                Result::Err(snapshot.invalid("/workers", "nonzero required"))
            } else {
                Result::Ok(())
            }
        },
    ).build();
    testing::assert_eq(testing::expect_err(invalid, "invalid configuration").path, "/workers");
}

fn main() -> () {
    exercise();
    println("config consumer: layered typed configuration, provenance and snapshots ok");
}
