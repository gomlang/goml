package main;

use std::fs;
use ecosystem::walkdir;
use std::io;
use std::iter;
use std::path;
use std::testing;
use std::time;

#[go_ffi("os", "Getpid")]
extern fn getpid() -> isize;

fn ok(value: Result[(), fs::Error]) -> () {
    testing::expect_ok(value, "filesystem setup");
}

fn next_entry(iterator: walkdir::WalkIterator) -> walkdir::DirEntry {
    testing::expect_ok(testing::expect_some(iterator.next(), "next entry"), "walk entry")
}

fn next_error(iterator: walkdir::WalkIterator) -> walkdir::Error {
    testing::expect_err(testing::expect_some(iterator.next(), "next error"), "walk error")
}

fn finished(iterator: walkdir::WalkIterator) -> () {
    testing::assert(iterator.next().is_none());
    testing::assert(iterator.next().is_none());
}

fn listing(builder: walkdir::WalkDir, root: string) -> string {
    let mut result = "";
    for item in builder {
        let entry = testing::expect_ok(item, "walk tree");
        let name = if entry.path() == root {
            "."
        } else {
            entry.path().byte_slice(root.byte_len() + 1, entry.path().byte_len())
        };
        result += name + "@" + entry.depth().to_string() + "\n";
    }
    result
}

fn basic_tree(root: string) -> () {
    ok(fs::create_dir_all(path::join(root, "a/deep")));
    ok(fs::create_dir_all(path::join(root, "c")));
    ok(fs::create_dir_all(path::join(root, "empty")));
    ok(fs::write_file_structured(path::join(root, "b.txt"), "hello"));
    ok(fs::write_file_structured(path::join(root, "a/first"), "first"));
    ok(fs::write_file_structured(path::join(root, "a/deep/leaf"), "leaf"));
    ok(fs::write_file_structured(path::join(root, "c/last"), "last"));
    let builder = walkdir::WalkDir::new(root);
    testing::assert_eq(
        listing(builder, root),
        ".@0\na@1\na/deep@2\na/deep/leaf@3\na/first@2\nb.txt@1\nc@1\nc/last@2\nempty@1\n",
    );
    testing::assert_eq(
        listing(builder.contents_first(true), root),
        "a/deep/leaf@3\na/deep@2\na/first@2\na@1\nb.txt@1\nc/last@2\nc@1\nempty@1\n.@0\n",
    );
    testing::assert_eq(listing(builder.max_depth(0), root), ".@0\n");
    testing::assert_eq(
        listing(builder.min_depth(1).max_depth(1), root),
        "a@1\nb.txt@1\nc@1\nempty@1\n",
    );
    testing::assert_eq(listing(builder.min_depth(3), root), "a/deep/leaf@3\n");
    testing::assert_eq(listing(builder.min_depth(10), root), "");
    testing::assert_eq(
        listing(builder.contents_first(true).min_depth(1).max_depth(2), root),
        "a/deep@2\na/first@2\na@1\nb.txt@1\nc/last@2\nc@1\nempty@1\n",
    );
    let files = iter::filter_map(
        walkdir::walk(root),
        |item| {
            let entry = testing::expect_ok(item, "filter files");
            if entry.file_type().is_file() {
                Option::Some(entry.path())
            } else {
                Option::None
            }
        },
    );
    testing::assert_eq(iter::count(files), 4);
    let file = path::join(root, "b.txt");
    let walker = walkdir::walk(file);
    let entry = next_entry(walker);
    testing::assert_eq(entry.path(), file);
    testing::assert(entry.file_name() == Option::Some("b.txt"));
    testing::assert_eq(entry.depth(), 0);
    testing::assert(entry.file_type().is_file());
    testing::assert(!entry.path_is_symlink());
    testing::assert_eq(entry.metadata().len(), 5);
    finished(walker);
    let names = testing::expect_ok(fs::read_dir_names_structured(root), "directory names");
    testing::assert_eq(names.len(), 4);
    testing::assert_eq(names[0], "a");
    testing::assert_eq(names[3], "empty");
}

fn pruning(root: string) -> () {
    let reject_a = walkdir::WalkDir::new(root).filter_entry(
        |entry| entry.file_name() != Option::Some("a"),
    );
    testing::assert_eq(listing(reject_a, root), ".@0\nb.txt@1\nc@1\nc/last@2\nempty@1\n");
    testing::assert_eq(
        listing(reject_a.contents_first(true), root),
        "b.txt@1\nc/last@2\nc@1\nempty@1\n.@0\n",
    );
    testing::assert_eq(
        listing(reject_a.filter_entry(|entry| entry.file_name() != Option::Some("c")), root),
        ".@0\nb.txt@1\nempty@1\n",
    );
    testing::assert_eq(
        listing(
            walkdir::WalkDir::new(root).min_depth(2).filter_entry(|entry| entry.depth() != 1),
            root,
        ),
        "",
    );
    let visits = Ref::new(0);
    testing::assert_eq(
        listing(
            walkdir::WalkDir::new(root).filter_entry(
                |_| {
                    visits.set(visits.get() + 1);
                    false
                },
            ),
            root,
        ),
        "",
    );
    testing::assert_eq(visits.get(), 1);
    let walker = walkdir::walk(root);
    walker.skip_current_dir();
    testing::assert_eq(next_entry(walker).depth(), 0);
    testing::assert(next_entry(walker).file_name() == Option::Some("a"));
    walker.skip_current_dir();
    walker.skip_current_dir();
    testing::assert(next_entry(walker).file_name() == Option::Some("b.txt"));
    walker.skip_current_dir();
    testing::assert(next_entry(walker).file_name() == Option::Some("c"));
    walker.skip_current_dir();
    testing::assert(next_entry(walker).file_name() == Option::Some("empty"));
    finished(walker);
    let root_only = walkdir::walk(root);
    let _ = next_entry(root_only);
    root_only.skip_current_dir();
    finished(root_only);
    let closed = walkdir::walk(root);
    let shared = closed;
    let _ = next_entry(shared);
    closed.close();
    closed.close();
    finished(shared);
    let independent = walkdir::WalkDir::new(root);
    let first = independent.iter();
    let second = independent.iter();
    let _ = next_entry(first);
    first.close();
    testing::assert_eq(next_entry(second).depth(), 0);
    second.close();
}

fn invalid_and_lazy(base: string) -> () {
    let root = path::join(base, "lazy");
    let lazy = walkdir::walk(root);
    ok(fs::create_dir(root));
    testing::assert_eq(next_entry(lazy).path(), root);
    ok(fs::write_file_structured(path::join(root, "late"), "late"));
    testing::assert(next_entry(lazy).file_name() == Option::Some("late"));
    finished(lazy);
    let missing = path::join(base, "missing");
    let walker = walkdir::WalkDir::new(missing).min_depth(1).iter();
    let error = next_error(walker);
    testing::assert_eq(error.path(), missing);
    testing::assert_eq(error.depth(), 0);
    testing::assert_eq(error.kind(), io::ErrorKind::NotFound);
    testing::assert(error.fs_error().path() == Option::Some(missing));
    testing::assert(error.fs_error().raw_os_code().is_some());
    testing::assert(error.loop_ancestor().is_none());
    testing::assert(error.to_string().contains(missing));
    finished(walker);
    for builder in Vec::from_array(
        [
            walkdir::WalkDir::new(missing).min_depth(-1),
            walkdir::WalkDir::new(missing).max_depth(-1),
            walkdir::WalkDir::new(missing).min_depth(2).max_depth(1),
        ],
    ) {
        let invalid = builder.iter();
        testing::assert_eq(next_error(invalid).kind(), io::ErrorKind::InvalidInput);
        finished(invalid);
    }
    let closed = walkdir::WalkDir::new(missing).min_depth(-1).iter();
    closed.close();
    finished(closed);
    let missing_names = testing::expect_err(
        fs::read_dir_names_structured(missing),
        "missing directory",
    );
    testing::assert_eq(missing_names.kind(), io::ErrorKind::NotFound);
}

fn changing_tree(base: string) -> () {
    let root = path::join(base, "changing");
    ok(fs::create_dir(root));
    for name in Vec::from_array(["a", "b", "c"]) {
        ok(fs::write_file_structured(path::join(root, name), name));
    }
    let walker = walkdir::walk(root);
    let _ = next_entry(walker);
    let _ = next_entry(walker);
    ok(fs::remove_file(path::join(root, "b")));
    let error = next_error(walker);
    testing::assert_eq(error.path(), path::join(root, "b"));
    testing::assert_eq(error.depth(), 1);
    testing::assert_eq(error.kind(), io::ErrorKind::NotFound);
    testing::assert(next_entry(walker).file_name() == Option::Some("c"));
    finished(walker);
    let removed = path::join(base, "removed");
    ok(fs::create_dir(removed));
    let walker = walkdir::walk(removed);
    let _ = next_entry(walker);
    ok(fs::remove_dir_all(removed));
    let error = next_error(walker);
    testing::assert_eq(error.path(), removed);
    testing::assert_eq(error.depth(), 0);
    testing::assert_eq(error.fs_error().operation(), "read directory");
    finished(walker);
    let pruned = walkdir::walk(root);
    let _ = next_entry(pruned);
    ok(fs::remove_dir_all(root));
    pruned.skip_current_dir();
    finished(pruned);
    ok(fs::create_dir_all(path::join(root, "a")));
    ok(fs::write_file_structured(path::join(root, "b"), "b"));
    let postorder = walkdir::WalkDir::new(root).contents_first(true).filter_entry(
        |entry| {
            if entry.file_name() == Option::Some("a") {
                ok(fs::remove_dir_all(entry.path()));
            }
            true
        },
    ).iter();
    let error = next_error(postorder);
    testing::assert_eq(error.path(), path::join(root, "a"));
    testing::assert(next_entry(postorder).file_name() == Option::Some("a"));
    testing::assert(next_entry(postorder).file_name() == Option::Some("b"));
    testing::assert_eq(next_entry(postorder).path(), root);
    finished(postorder);
}

pub fn verify_behavior() -> () {
    let base = "/tmp/goml-walkdir-" + getpid().to_string() + "-"
        + time::SystemTime::now().unix_nanoseconds().to_string();
    ok(fs::create_dir(base));
    defer ok(fs::remove_dir_all(base));
    let root = path::join(base, "tree");
    basic_tree(root);
    pruning(root);
    invalid_and_lazy(base);
    changing_tree(base);
    symbolic_links(base);
    deep_tree(base);
    descriptor_relative_walk(base);
    rejects_replaced_directory(base, false);
    rejects_replaced_directory(base, true);
    println(
        "walkdir: traversal, depths, pruning, links, loops, errors, laziness, and syscall lifecycle passed",
    );
}

fn main() -> () {
    verify_behavior();
}
