package main;

use ecosystem::incremental as inc;
use std::env;
use std::io;
use std::json;
use std::process;
use std::serde;
use std::testing;

#[derive(serde::Deserialize)]
struct Node {
    kind: string,
    a: isize,
    b: isize,
    c: isize,
}

#[derive(serde::Deserialize)]
struct Action {
    kind: string,
    index: isize,
    value: isize,
}

#[derive(serde::Deserialize)]
struct Case {
    inputs: Vec[isize],
    nodes: Vec[Node],
    actions: Vec[Action],
    capacity: isize,
}

fn evaluate_case(value: Case) -> Result[json::Value, string] {
    let db = inc::Database::new();
    let inputs = Vec::new();
    for index in 0..value.inputs.len() {
        inputs.push(db.input("input:" + index.to_string(), value.inputs[index]));
    }
    let installed: Ref[Option[inc::Query[isize, isize]]] = Ref::new(Option::None);
    let nodes = value.nodes;
    let query = db.query(
        "node",
        value.capacity,
        |read: inc::Evaluation, key: isize| {
            if key < 0 || key >= nodes.len() {
                return Result::Err(inc::Error::user("node index"))
            }
            let query = installed.get().ok_or(inc::Error::user("query not installed"))?;
            let node = nodes[key];
            match node.kind {
                "input" => {
                    if node.a < 0 || node.a >= inputs.len() {
                        Result::Err(inc::Error::user("input index"))
                    } else {
                        read.input(inputs[node.a])
                    }
                },
                "constant" => Result::Ok(node.a),
                "add" => Result::Ok(read.query(query, node.a)? + read.query(query, node.b)?),
                "subtract" => Result::Ok(read.query(query, node.a)? - read.query(query, node.b)?),
                "parity" => Result::Ok(
                    if read.query(query, node.a)? % 2 == 0 {
                        0
                    } else {
                        1
                    },
                ),
                "branch" => if read.query(query, node.a)? != 0 {
                    read.query(query, node.b)
                } else {
                    read.query(query, node.c)
                },
                "nonnegative" => {
                    let number = read.query(query, node.a)?;
                    if number < 0 {
                        Result::Err(inc::Error::user("negative"))
                    } else {
                        Result::Ok(number)
                    }
                },
                "fallback" => Result::Ok(read.query(query, node.a).unwrap_or(node.b)),
                _ => Result::Err(inc::Error::user("unknown node kind")),
            }
        },
    ).map_err(|error| error.to_string())?;
    installed.set(Option::Some(query));
    let results = Vec::new();
    for action in value.actions {
        if action.kind == "set" {
            if action.index < 0 || action.index >= inputs.len() {
                return Result::Err("input index")
            }
            let _ = db.set(inputs[action.index], action.value).map_err(|error| error.to_string())?;
        } else if action.kind == "clear" {
            let _ = db.clear(query).map_err(|error| error.to_string())?;
        } else if action.kind == "query" {
            results.push(
                match db.fetch(query, action.index) {
                    Ok(number) => json::Value::Number(number.to_string()),
                    Err(error) => json::Value::String(
                        if error.kind == inc::ErrorKind::Cycle {
                            "cycle"
                        } else {
                            error.message
                        },
                    ),
                },
            );
        } else {
            return Result::Err("unknown action")
        }
    }
    Result::Ok(
        json::Value::Object(
            Vec::from_array(
                [
                    ("values", json::Value::Array(results)),
                    ("revision", json::Value::Number(db.revision().to_string())),
                ],
            ),
        ),
    )
}

pub fn smoke() -> () {
    let db = inc::Database::new();
    let source = db.input("document", "incremental");
    let count = testing::expect_ok(
        db.query(
            "bytes",
            8,
            |read: inc::Evaluation, _: isize| Result::Ok(read.input(source)?.byte_len()),
        ),
        "query",
    );
    let label = testing::expect_ok(
        db.query(
            "label",
            8,
            |read: inc::Evaluation, key: isize| Result::Ok(
                read.query(count, key)?.to_string() + " bytes",
            ),
        ),
        "query",
    );
    testing::assert_eq(testing::expect_ok(db.fetch(label, 0), "label"), "11 bytes");
    testing::assert_ok(db.set(source, "goml"));
    testing::assert_eq(testing::expect_ok(db.fetch(label, 0), "updated label"), "4 bytes");
}

fn run_json() -> Result[(), string] {
    let input = io::read_stdin_to_string().map_err(|error| error.to_string())?;
    let cases: Vec[Case] = json::from_string(input)?;
    let output = Vec::new();
    for value in cases {
        output.push(evaluate_case(value)?);
    }
    print(json::encode(json::Value::Array(output)));
    Result::Ok(())
}

fn main() -> () {
    if env::args().len() > 1 {
        if let Err(error) = run_json() {
            io::eprintln(error);
            process::exit(1);
        }
    } else {
        smoke();
        println("incremental consumer: ok");
    }
}
