package tests;

use consumer::incremental as application;
use ecosystem::incremental as inc;
use std::testing;

#[derive(PartialEq, Eq, Hash)]
struct Document {
    name: string,
}

#[derive(PartialEq)]
struct Summary {
    name: string,
    bytes: isize,
}

#[test]
fn versioned_consumer_composes_distinct_types() -> () {
    application::smoke();
    let db = inc::Database::new();
    let contents = db.input("contents", "hello");
    let query = testing::expect_ok(
        db.query_with(
            "summary",
            8,
            |key: Document| key.name,
            inc::ValuePolicy::immutable(),
            |read: inc::Evaluation, key: Document| {
                Result::Ok(Summary { name: key.name, bytes: read.input(contents)?.byte_len() })
            },
        ),
        "custom types",
    );
    let value = testing::expect_ok(db.fetch(query, Document { name: "readme" }), "summary");
    testing::assert(value == Summary { name: "readme", bytes: 5 });
    testing::assert_ok(db.set(contents, "hello world"));
    testing::assert_eq(
        testing::expect_ok(db.fetch(query, Document { name: "readme" }), "updated").bytes,
        11,
    );
}
