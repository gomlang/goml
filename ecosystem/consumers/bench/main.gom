package main;

use ecosystem::bench;
use std::fs;
use std::testing;

fn input(length: isize) -> Vec[isize] {
    let values = Vec::with_capacity(length);
    for index in 0..length {
        values.push((length - index) * 17 % (length + 3));
    }
    values
}

pub fn insertion_sort(values: Vec[isize]) -> u64 {
    for index in 1..values.len() {
        let value = values[index];
        let mut position = index;
        while position > 0 && values[position - 1] > value {
            values[position] = values[position - 1];
            position -= 1;
        }
        values[position] = value;
    }
    digest(values)
}

pub fn standard_sort(values: Vec[isize]) -> u64 {
    values.sort_by(|left, right| left - right);
    digest(values)
}

fn digest(values: Vec[isize]) -> u64 {
    let mut result: u64 = 0;
    for index in 0..values.len() {
        result ^= values[index].to_u64() << (index % 32).to_u64();
    }
    result
}

pub fn exercise() -> Result[bench::SuiteReport, bench::Error] {
    let cases = Vec::new();
    for length in Vec::from_array([32, 128]) {
        let parameter = length.to_string();
        let insertion = bench::Case::with_setup(
            "insertion sort",
            || input(bench::black_box(length.to_u64()).to_isize()),
            |values| insertion_sort(values),
        ).with_group("sorting").with_parameter(parameter).with_throughput(
            bench::Throughput::Elements(length.to_u64()),
        );
        let standard = bench::Case::with_setup(
            "standard sort",
            || input(bench::black_box(length.to_u64()).to_isize()),
            |values| standard_sort(values),
        ).with_group("sorting").with_parameter(parameter).with_throughput(
            bench::Throughput::Elements(length.to_u64()),
        );
        cases.push(insertion);
        cases.push(standard);
        testing::assert_eq(insertion_sort(input(length)), standard_sort(input(length)));
    }
    let options = bench::Options {
        warmup_ns: 1000000,
        measurement_ns: 5000000,
        samples: 5,
        bootstrap_resamples: 200,
        ..bench::Options::standard(),
    };
    let report = bench::run_suite(cases, options)?;
    testing::assert_eq(report.reports.len(), 4);
    Result::Ok(report)
}

fn main() -> () {
    let report = testing::expect_ok(exercise(), "benchmarks");
    testing::assert_ok(fs::create_dir_all("_artifact"));
    testing::assert_ok(bench::write_json("_artifact/bench-report.json", report));
    testing::assert_ok(bench::write_html("_artifact/bench-report.html", report));
    let persisted = testing::expect_ok(
        bench::read_json("_artifact/bench-report.json"),
        "read report",
    );
    testing::assert_eq(persisted.reports.len(), 4);
    let comparison = testing::expect_ok(
        bench::compare(report.reports[0], persisted.reports[0]),
        "baseline",
    );
    println("bench consumer: 4 sort measurements retained in _artifact/bench-report.json and .html");
    println(comparison.relative_change.estimate);
}
