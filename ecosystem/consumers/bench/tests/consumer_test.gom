package tests;

use consumer::bench as example;
use ecosystem::bench;
use std::testing;
use std::context;

#[test]
fn real_algorithms_and_versioned_statistical_api() -> () {
    let values = Vec::from_array([8, 3, 9, 2, 1, 4]);
    testing::assert_eq(
        example::insertion_sort(values.copy()),
        example::standard_sort(values.copy()),
    );
    let now: Ref[i64] = Ref::new(0);
    let case = bench::Case::with_setup(
        "standard sort",
        || values.copy(),
        |input| {
            now.set(now.get() + 20);
            example::standard_sort(input)
        },
    );
    let options = bench::Options {
        warmup_ns: 0,
        measurement_ns: 100,
        samples: 2,
        bootstrap_resamples: 20,
        ..bench::Options::standard(),
    };
    let report = testing::expect_ok(
        bench::run_with(
            case,
            options,
            bench::Clock::new(|| now.get()),
            context::Context::background(),
        ),
        "run",
    );
    testing::assert_eq(report.statistics.mean.estimate, 20.0);
    let suite = bench::SuiteReport { schema: 1, reports: Vec::from_array([report]) };
    let encoded = testing::expect_ok(bench::to_json(suite), "JSON");
    testing::assert_eq(testing::expect_ok(bench::from_json(encoded), "decode").reports.len(), 1);
}
