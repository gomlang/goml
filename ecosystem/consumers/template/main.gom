package main;

use ecosystem::template;
use ecosystem::template::{Engine, Options, Value};
use std::env;
use std::io;
use std::json;
use std::process;
use std::serde::{Serialize};

#[derive(Serialize)]
struct Product {
    name: string,
    price: isize,
}

#[derive(Serialize)]
struct Catalog {
    title: string,
    products: Vec[Product],
}

pub fn exercise() -> Result[(), string] {
    let engine = Engine::new(Options::standard()).map_err(|error| error.to_string())?;
    engine.add(
        "base",
        "<h1>{% block heading %}{{title}}{% endblock %}</h1>{% block content %}{% endblock %}",
    ).map_err(|error| error.to_string())?;
    engine.add(
        "catalog",
        "{% extends 'base' %}{% block content %}<ul>{% for product in products %}<li>{{product.name}}={{money(product.price)}}</li>{% endfor %}</ul>{% endblock %}",
    ).map_err(|error| error.to_string())?;
    let symbol = "¥";
    engine.register_function(
        "money",
        |arguments| {
            if arguments.len() != 1 {
                return Result::Err("money expects one integer")
            }
            let value = arguments[0].as_int().ok_or("money expects integer")?;
            Result::Ok(Value::Text(symbol + value.to_string()))
        },
    ).map_err(|error| error.to_string())?;
    let data = template::from_serializable(
        Catalog {
            title: "Catalog <2026>",
            products: Vec::from_array(
                [Product { name: "中文 & GoML", price: 42 }, Product { name: "Other", price: 7 }],
            ),
        },
    ).map_err(|error| error.to_string())?;
    let output = engine.render("catalog", data).map_err(|error| error.to_string())?;
    if output != "<h1>Catalog &lt;2026&gt;</h1><ul><li>中文 &amp; GoML=¥42</li><li>Other=¥7</li></ul>" {
        return Result::Err(output)
    }
    Result::Ok(())
}

fn handle(request: json::Value) -> Result[string, string] {
    let templates = json::field(request, "templates").unwrap_or(json::Value::Object(Vec::new()));
    let json::Value::Object(templates) = templates else {
        return Result::Err("templates must be an object")
    };
    let autoescape = json::field(request, "autoescape").and_then(|value| json::as_bool(value)).unwrap_or(
        true,
    );
    let strict = json::field(request, "strict").and_then(|value| json::as_bool(value)).unwrap_or(
        true,
    );
    let engine = Engine::new(
        Options { autoescape, strict_undefined: strict, limits: template::Limits::standard() },
    ).map_err(|error| error.to_string())?;
    for (name, source) in templates {
        engine.add(name, json::as_string(source).ok_or("template must be a string")?).map_err(
            |error| error.to_string(),
        )?;
    }
    let data = Value::from_json(
        json::field(request, "context").unwrap_or(json::Value::Object(Vec::new())),
    ).map_err(|error| error.to_string())?;
    if let Some(name) = json::field(request, "name").and_then(|value| json::as_string(value)) {
        engine.render(name, data).map_err(|error| error.to_string())
    } else {
        engine.render_string(
            json::field(request, "source").and_then(|value| json::as_string(value)).ok_or(
                "missing source",
            )?,
            data,
        ).map_err(|error| error.to_string())
    }
}

fn run() -> Result[(), string] {
    if env::args().len() == 1 {
        exercise()?;
        println("template consumer: ok");
        return Result::Ok(())
    }
    let input = io::read_stdin_to_string().map_err(|error| error.to_string())?;
    let requests = json::as_array(json::parse(input)?).ok_or("expected array")?;
    let results = Vec::new();
    for request in requests {
        results.push(
            match handle(request) {
                Ok(output) => json::Value::Object(
                    Vec::from_array([("output", json::Value::String(output))]),
                ),
                Err(error) => json::Value::Object(
                    Vec::from_array([("error", json::Value::String(error))]),
                ),
            },
        );
    }
    println(json::encode(json::Value::Array(results)));
    Result::Ok(())
}

fn main() -> () {
    if let Err(message) = run() {
        io::eprintln(message);
        process::exit(1);
    }
}
