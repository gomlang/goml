package tests;

use consumer::terminal as app;
use ecosystem::terminal;
use std::testing;

#[test]
fn public_decoder_and_capability_contract() -> () {
    app::verify_decoder();
    testing::assert_eq(
        terminal::detect_capabilities(
            false,
            false,
            "xterm-256color",
            "",
            false,
            terminal::ColorPolicy::Auto,
        ).color,
        terminal::ColorDepth::None,
    );
    testing::assert_eq(
        terminal::detect_capabilities(
            true,
            true,
            "xterm-256color",
            "",
            false,
            terminal::ColorPolicy::Auto,
        ).color,
        terminal::ColorDepth::Ansi256,
    );
}
