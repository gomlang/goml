package main;

use ecosystem::terminal;
use std::context;
use std::env;
use std::io;
use std::testing;
use std::time;

pub fn verify_decoder() -> () {
    let decoder = testing::expect_ok(
        terminal::Decoder::new(terminal::DecoderOptions::defaults()),
        "decoder",
    );
    let events = testing::expect_ok(
        decoder.feed("\u001b[1;5A中\u001b[200~hello\u001b[201~".to_bytes().as_slice()),
        "events",
    );
    testing::assert_eq(events.len(), 3);
    testing::assert(
        events[0]
            == terminal::Event::Key(
                terminal::KeyEvent {
                    code: terminal::KeyCode::Up,
                    modifiers: terminal::Modifiers { control: true, ..terminal::Modifiers::none() },
                },
            ),
    );
    testing::assert(events[2] == terminal::Event::Paste("hello"));
}

fn event_name(event: terminal::Event) -> string {
    match event {
        terminal::Event::Key(key) => "KEY " + key.code.debug() + " " + key.modifiers.debug(),
        terminal::Event::Mouse(mouse) => "MOUSE " + mouse.debug(),
        terminal::Event::Paste(value) => "PASTE " + value,
        terminal::Event::Focus(focused) => "FOCUS " + focused.to_string(),
        terminal::Event::Resize(size) => "RESIZE " + size.columns.to_string() + " "
            + size.rows.to_string(),
        terminal::Event::Unknown(value) => "UNKNOWN " + value,
        terminal::Event::End => "END",
    }
}

fn interactive(mode: string) -> Result[(), terminal::Error] {
    let session = terminal::Session::open(
        terminal::Options { mouse: true, focus: true, ..terminal::Options::interactive() },
    )?;
    defer {
        let _ = session.close();
    };
    let size = session.size()?;
    session.write("READY " + size.columns.to_string() + " " + size.rows.to_string() + "\n")?;
    if mode == "cancel" {
        let result = context::with_timeout(
            context::Context::background(),
            time::Duration::from_milliseconds(60),
            |context, _| session.next_event(context, -1),
        );
        if let Err(error) = result {
            session.write("CANCEL " + error.kind().to_string() + "\n")?;
        } else {
            return Result::Err(
                io::Error::new(
                    io::ErrorKind::Other,
                    "consumer",
                    Option::None,
                    Option::None,
                    "expected cancellation",
                ),
            )
        }
        return session.close()
    }
    if mode == "write" {
        session.write("0123456789abcdef".repeat(262144))?;
        session.write("\nWRITE DONE\n")?;
        return session.close()
    }
    loop {
        match session.next_event(context::Context::background(), -1)? {
            Some(event) => {
                let done = match event {
                    terminal::Event::Key(key) => key.code == terminal::KeyCode::Char('q'),
                    terminal::Event::End => true,
                    _ => false,
                };
                session.write(event_name(event) + "\n")?;
                if done {
                    return session.close()
                }
            },
            None => (),
        }
    }
}

fn main() -> () {
    let args = env::args();
    if args.len() > 1 && args[1] == "redirect" {
        let session = testing::expect_ok(
            terminal::Session::open(terminal::Options::defaults()),
            "redirected session",
        );
        testing::assert_ok(session.write("session"));
        testing::assert_ok(session.close());
        println("DONE");
    } else if args.len() > 1 {
        match interactive(args[1]) {
            Ok(_) => println("CLOSED"),
            Err(error) => println("ERROR " + error.kind().to_string()),
        }
    } else {
        verify_decoder();
        println("terminal consumer: typed fragmented input and capabilities ready");
    }
}
