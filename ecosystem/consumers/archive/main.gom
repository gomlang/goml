package main;

use ecosystem::archive;
use std::bytes;
use std::io;
use std::testing;

pub fn exercise() -> Result[(), archive::Error] {
    let entries = Vec::from_array(
        [
            archive::Entry::directory("project/"),
            archive::Entry::file(
                "project/goml.toml",
                bytes::Bytes::from_string("[module]\npath = \"demo\"\n"),
            ),
            archive::Entry::file(
                "project/main.gom",
                bytes::Bytes::from_string("fn main() -> () { println(\"hello\"); }\n"),
            ),
        ],
    );
    let limits = archive::Limits::standard();
    let sink = io::Cursor::new(bytes::Bytes::new());
    let writer = archive::TarWriter::new(sink, limits)?;
    for entry in entries {
        writer.append(entry)?
    }
    writer.finish()?;
    let stream_source = io::Cursor::new(sink.bytes());
    let stream = archive::TarReader::new(stream_source, limits)?;
    let (directory, size) = testing::expect_some(stream.next_header()?, "directory header");
    testing::assert_eq(directory.path, "project/");
    testing::assert_eq(size, 0);
    let (file, size) = testing::expect_some(stream.next_header()?, "file header");
    testing::assert_eq(file.path, "project/goml.toml");
    testing::assert_eq(size, entries[1].data.len());
    let chunk = bytes::Bytes::from_vec(b"....");
    let copied = bytes::Bytes::new();
    loop {
        let count = stream.read_body_chunk(chunk.as_mut_slice())?;
        if count == 0 {
            break
        }
        copied.extend_from_slice(chunk.slice(0, count));
    }
    testing::assert(copied.to_vec() == entries[1].data.to_vec());
    let unpacked = archive::decode_tar(sink.bytes(), limits)?;
    let zipped = archive::encode_zip(unpacked, archive::Compression::Deflate, limits)?;
    let bundle = archive::ZipArchive::open(zipped, limits)?;
    testing::assert_eq(bundle.len(), 3);
    testing::assert_eq(bundle.records()[1].header.path, "project/goml.toml");
    testing::assert(bundle.entry(2)?.data.to_vec() == entries[2].data.to_vec());
    let zip_output = io::Cursor::new(bytes::Bytes::new());
    bundle.copy_entry(2, zip_output)?;
    testing::assert(zip_output.bytes().to_vec() == entries[2].data.to_vec());
    let zip_source = archive::ZipSource::open(io::Cursor::new(zipped), zipped.len(), limits)?;
    let source_output = io::Cursor::new(bytes::Bytes::new());
    zip_source.copy_entry(2, source_output)?;
    testing::assert(source_output.bytes().to_vec() == entries[2].data.to_vec());
    let compressed = archive::encode_tar_gz(entries, limits)?;
    testing::assert_eq(archive::decode_tar_gz(compressed, limits)?.len(), 3);
    Result::Ok(())
}

fn main() -> () {
    testing::assert_ok(exercise());
    println("archive consumer: streaming TAR, ZIP and tar.gz round trips passed");
}
