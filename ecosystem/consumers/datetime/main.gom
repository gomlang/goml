package main;

use ecosystem::datetime as dt;
use std::env;
use std::io;
use std::num;
use std::testing;
use std::json;

pub fn exercise() -> Result[(), dt::Error] {
    let zone = dt::TimeZone::from_posix("New_York", "EST5EDT,M3.2.0,M11.1.0")?;
    let appointment = dt::LocalDateTime::parse("2024-11-03T01:30:00.123456789")?;
    let candidates = zone.resolve_local(appointment)?;
    let early = candidates.resolve(dt::FoldPolicy::Earlier)?;
    let late = candidates.resolve(dt::FoldPolicy::Later)?;
    testing::assert_eq(late.instant().duration_since(early.instant()).whole_seconds(), 3600);
    testing::assert_eq(early.instant().to_string(), "2024-11-03T05:30:00.123456789Z");
    let encoded = testing::expect_ok(json::try_to_string(late.offset_datetime()), "wire datetime");
    let decoded: dt::OffsetDateTime = testing::expect_ok(json::from_string(encoded), "wire parse");
    testing::assert_eq(decoded.instant(), late.instant());
    let end = dt::Date::new(2024, 1, 31)?.checked_add_months(1, dt::InvalidDay::Clamp)?;
    testing::assert_eq(end.to_string(), "2024-02-29");
    Result::Ok(())
}

fn number(text: string) -> i64 {
    testing::expect_ok(num::parse_int_structured(text), "integer").to_i64()
}

fn date_result(result: Result[dt::Date, dt::Error]) -> string {
    match result {
        Ok(value) => value.to_string(),
        Err(_) => "error",
    }
}

fn zone(name: string, root: string, zones: HashMap[string, dt::TimeZone]) -> Result[
    dt::TimeZone,
    dt::Error,
] {
    if let Some(value) = zones.get(name) {
        return Result::Ok(value);
    }
    let value = dt::TimeZone::load_from(root, name)?;
    zones.set(name, value);
    Result::Ok(value)
}

fn query(fields: Vec[string], root: string, zones: HashMap[string, dt::TimeZone]) -> Result[
    string,
    dt::Error,
] {
    match fields[0] {
        "date" => {
            let date = dt::Date::parse(fields[1])?;
            let iso = date.iso_week();
            let mut output = f"{date.epoch_days()}\t{date.ordinal()}\t{date.weekday()}\t{iso.0}\t{iso.1}\t{iso.2}";
            output += "\t" + date_result(date.checked_add_days(number(fields[2])));
            for policy in Vec::from_array(
                [dt::InvalidDay::Reject, dt::InvalidDay::Clamp, dt::InvalidDay::Carry],
            ) {
                output += "\t" + date_result(date.checked_add_months(number(fields[3]), policy));
            }
            Result::Ok(output)
        },
        "instant" => {
            let instant = dt::UtcInstant::new(number(fields[1]), number(fields[2]).to_isize())?;
            let value = zone(fields[3], root, zones)?.at(instant)?;
            let info = value.info();
            Result::Ok(
                f"{instant.to_string()}\t{value.local().to_string()}\t{info.offset.seconds()}\t{info.abbreviation}\t{info.is_dst}",
            )
        },
        "local" => {
            let local = dt::LocalDateTime::parse(fields[1])?;
            match zone(fields[2], root, zones)?.resolve_local(local)? {
                dt::LocalResult::Nonexistent => Result::Ok("gap"),
                dt::LocalResult::Unique(value) => Result::Ok(
                    f"unique\t{value.instant().unix_seconds()}\t{value.instant().nanosecond()}",
                ),
                dt::LocalResult::Ambiguous(early, late) => Result::Ok(
                    f"fold\t{early.instant().unix_seconds()}\t{late.instant().unix_seconds()}\t{early.instant().nanosecond()}",
                ),
            }
        },
        "rfc" => {
            let value = dt::OffsetDateTime::parse_rfc3339(fields[1])?;
            Result::Ok(
                f"{value.instant().unix_seconds()}\t{value.instant().nanosecond()}\t{value.to_rfc3339()?}",
            )
        },
        "load" => {
            let value = zone(fields[1], root, zones)?;
            Result::Ok(f"{value.name()}\t{value.transition_count()}\t{value.has_future_rules()}")
        },
        _ => Result::Err(dt::Error::Invalid("unknown query")),
    }
}

fn main() -> () {
    let arguments = env::args();
    if arguments.len() > 1 && arguments[1] == "--oracle" {
        let root = if arguments.len() > 2 {
            arguments[2]
        } else {
            "/usr/share/zoneinfo"
        };
        let zones: HashMap[string, dt::TimeZone] = HashMap::new();
        let input = testing::expect_ok(io::read_stdin_to_string(), "stdin");
        for line in input.split("\n") {
            if line == "" {
                continue;
            }
            match query(line.split("\t"), root, zones) {
                Ok(output) => println(output),
                Err(error) => if line.starts_with("load\t") {
                    println(error.to_string());
                } else {
                    println("error");
                },
            }
        }
    } else {
        testing::assert_ok(exercise());
        println("datetime consumer: checked scheduling, DST fold resolution and Serde passed");
    }
}

pub fn reference_cases(lines: Vec[string], root: string) -> Vec[string] {
    let zones: HashMap[string, dt::TimeZone] = HashMap::new();
    let output = Vec::new();
    for line in lines {
        output.push(query(line.split("\t"), root, zones).unwrap_or("error"));
    }
    output
}
