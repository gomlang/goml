package tests;

use consumer::datetime as application;
use std::testing;
use std::fs;
use std::json;
use std::crypto::hash;

fn field(value: json::Value, name: string) -> json::Value {
    testing::expect_some(json::field(value, name), "reference field " + name)
}

fn reference_rows() -> Vec[json::Value] {
    let source = testing::expect_ok(
        fs::read_file_structured("tests/data/reference.jsonl"),
        "reference vectors",
    );
    let rows = Vec::new();
    for line in source.split("\n") {
        if line != "" {
            rows.push(testing::expect_ok(json::parse(line), "reference JSON"));
        }
    }
    rows
}

#[test]
fn independent_calendar_zoneinfo_and_go_time_vectors() -> () {
    let rows = reference_rows();
    testing::assert_eq(rows.len(), 8140);
    let inputs = Vec::new();
    for row in rows {
        inputs.push(testing::expect_some(json::as_string(field(row, "input")), "input"));
    }
    let output = application::reference_cases(inputs, "../../datetime/fixtures");
    testing::assert_eq(output.len(), rows.len());
    for index in 0..rows.len() {
        testing::assert_eq(
            output[index],
            testing::expect_some(json::as_string(field(rows[index], "expected")), "expected"),
        );
    }
}

#[test]
fn timezone_fixtures_match_pinned_checksums() -> () {
    let root = "../../datetime/fixtures/";
    let manifest = testing::expect_ok(
        fs::read_file_structured(root + "SHA256SUMS"),
        "fixture checksums",
    );
    for line in manifest.split("\n") {
        if line == "" {
            continue;
        }
        let fields = line.split("  ");
        testing::assert_eq(
            testing::expect_ok(hash::sha256_file(root + fields[1]), "hash fixture"),
            fields[0],
        );
    }
}
