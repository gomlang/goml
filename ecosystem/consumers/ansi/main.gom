package main;

use ecosystem::ansi;
use ecosystem::color;
use std::env;
use std::bytes;
use std::io;
use std::num;
use std::encoding::hex;
use std::utf8;
use utf8::BytesUtf8;
use std::testing;

struct ChunkWriter {
    bytes: Vec[byte],
}

impl io::Write for ChunkWriter {
    fn write(self: ChunkWriter, input: Slice[byte]) -> Result[isize, io::Error] {
        let length = if input.len() < 3 {
            input.len()
        } else {
            3
        };
        for index in 0..length {
            self.bytes.push(input[index]);
        }
        Result::Ok(length)
    }
}

pub fn exercise() -> () {
    let foreground = ansi::Color::from_srgb(
        testing::expect_ok(color::parse("#c080ff"), "color parser"),
    );
    let style = ansi::Style::new().foreground(foreground).with_attribute(ansi::BOLD, true);
    let text = ansi::StyledText::from_spans(
        Vec::from_array([ansi::Span::new("状态 ", style), ansi::Span::plain("👩‍💻 ready")]),
    );
    testing::assert_eq(text.width(), 13);
    let writer = ChunkWriter { bytes: Vec::new() };
    testing::expect_ok(ansi::write_line(writer, text, ansi::Profile::TrueColor), "partial writer");
    let output = testing::expect_ok(utf8::decode(writer.bytes), "written utf8");
    testing::assert_eq(
        testing::expect_ok(ansi::strip(output), "strip output"),
        text.plain_text() + "\n",
    );
    let clipped = testing::expect_ok(text.clip(1, 5), "wide clipping");
    testing::assert_eq(clipped.width(), 5);
}

fn integer(value: string) -> isize {
    testing::expect_ok(num::parse_int_structured(value), "oracle integer")
}

fn text(value: string) -> string {
    testing::expect_ok(
        testing::expect_ok(hex::decode(value), "oracle hex").to_string_utf8(),
        "oracle utf8",
    )
}

fn color_string(value: ansi::Color) -> string {
    match value {
        Default => "default",
        Indexed(index) => f"i:{index}",
        Rgb(red, green, blue) => f"r:{red}:{green}:{blue}",
    }
}

fn oracle() -> () {
    let input = testing::expect_ok(io::read_stdin_to_string(), "stdin");
    for row in input.split("\n") {
        if row == "" {
            continue
        }
        let fields = row.split("\t");
        match fields[0] {
            "sgr" => match ansi::apply_sgr(ansi::Style::new(), text(fields[1])) {
                Ok(style) => println(
                    f"{style.attributes}\t{color_string(style.fg)}\t{color_string(style.bg)}",
                ),
                Err(_) => println("error"),
            },
            "strip" => match ansi::strip(text(fields[1])) {
                Ok(value) => println(hex::encode(bytes::Bytes::from_vec(value.to_bytes()))),
                Err(_) => println("error"),
            },
            "render" => {
                let profile = match fields[1] {
                    "16" => ansi::Profile::Ansi16,
                    "256" => ansi::Profile::Ansi256,
                    "plain" => ansi::Profile::Plain,
                    _ => ansi::Profile::TrueColor,
                };
                let style = ansi::Style {
                    fg: ansi::Color::Rgb(
                        integer(fields[2]).to_u8(),
                        integer(fields[3]).to_u8(),
                        integer(fields[4]).to_u8(),
                    ),
                    bg: ansi::Color::Default,
                    attributes: integer(fields[5]).to_u16(),
                };
                println(
                    hex::encode(
                        bytes::Bytes::from_vec(style.paint(text(fields[6]), profile).to_bytes()),
                    ),
                );
            },
            _ => testing::fail("unknown oracle command"),
        }
    }
}

fn main() -> () {
    let args = env::args();
    if args.len() > 1 && args[1] == "--oracle" {
        oracle();
    } else {
        exercise();
        println("ansi: styles, color conversion, Unicode layout and partial stream writes passed");
    }
}
