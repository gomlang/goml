package tests;

use consumer::ansi as application;
use std::testing;
use ecosystem::ansi as terminal_style;

#[test]
fn downstream_public_types_and_writer_specialization_work() -> () {
    application::exercise()
}

#[test]
fn malformed_input_returns_a_public_error() -> () {
    let result = terminal_style::parse("\u001b[38;2;300;0;0m");
    match result {
        Err(error) => testing::assert(error.message.contains("channel")),
        Ok(_) => testing::fail("invalid extended color unexpectedly accepted"),
    }
}
