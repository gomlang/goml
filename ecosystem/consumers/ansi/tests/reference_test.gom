package tests;

use ecosystem::verification::reference;
use std::encoding::hex;
use std::testing;

#[test]
fn independent_sgr_palette_and_rendered_screen_oracle() -> () {
    let fixture = reference::load();
    let output = testing::expect_ok(
        reference::run("ansi", "--oracle", reference::text(reference::field(fixture, "input"))),
        "ANSI reference protocol",
    );
    let rows = output.trim_end().split("\n");
    let expected = reference::array(reference::field(fixture, "expected"));
    testing::assert_eq(rows.len(), expected.len());
    for index in 0..rows.len() {
        let expected = reference::array(expected[index]);
        if reference::text(expected[0]) == "equal" {
            testing::assert_eq(rows[index], reference::text(expected[1]));
        } else {
            let specification = reference::array(expected[1]);
            let payload = reference::text(specification[0]);
            let style = reference::array(specification[1]);
            let screen = reference::Screen::new(100, 1);
            testing::assert_ok(
                screen.feed(testing::expect_ok(hex::decode(rows[index]), "rendered hex").as_slice()),
            );
            testing::assert_eq(screen.text().trim_end(), payload);
            let mut x = 0;
            for character in payload.chars() {
                let cell = screen.cell(x, 0);
                testing::assert_eq(cell.text, character.to_string());
                testing::assert_eq(cell.attributes, reference::integer(style[0]));
                testing::assert_eq(cell.foreground, reference::text(style[1]));
                testing::assert_eq(cell.background, reference::text(style[2]));
                x += cell.width;
            }
            testing::assert_eq(screen.attributes(), 0);
            testing::assert_eq(screen.foreground(), "default");
            testing::assert_eq(screen.background(), "default");
        }
    }
}
