package tests;

use consumer::sqlite as app;
use std::fs;
use std::json;
use std::testing;
use std::num;
use std::math;

fn required(value: json::Value, name: string) -> json::Value {
    testing::expect_some(json::field(value, name), name)
}

#[test]
fn independent_reference_fixture_sequences() -> () {
    let source = testing::expect_ok(
        fs::read_file_structured("tests/data/reference.jsonl"),
        "reference fixture",
    );
    let mut count = 0;
    for line in source.split("\n") {
        if line == "" {
            continue;
        }
        let case = testing::expect_ok(json::parse(line), "fixture JSON");
        let expected = required(case, "expected");
        let context = "reference case " + count.to_string();
        let actual = testing::expect_ok(app::run_case(required(case, "request")), context);
        compare_reference(actual, expected, context);
        count += 1;
    }
    testing::assert_eq(count, 243);
}

fn compare_reference(actual: json::Value, expected: json::Value, context: string) -> () {
    match expected {
        json::Value::Object(fields) => {
            if let Some(kind) = json::field(expected, "error") {
                let kind = testing::expect_some(json::as_string(kind), context);
                let got = testing::expect_some(json::as_string(required(actual, "error")), context);
                testing::assert(got == kind || got.ends_with("::" + kind));
                testing::assert_eq(
                    json::encode(required(actual, "code")),
                    json::encode(required(expected, "code")),
                );
            } else if json::field(expected, "type").and_then(|value| json::as_string(value))
                == Option::Some("real") {
                testing::assert_eq(
                    json::encode(required(actual, "type")),
                    json::encode(required(expected, "type")),
                );
                let a = testing::expect_ok(
                    num::parse_float64_structured(
                        testing::expect_some(json::as_string(required(actual, "value")), context),
                    ),
                    context,
                );
                let b = testing::expect_ok(
                    num::parse_float64_structured(
                        testing::expect_some(json::as_string(required(expected, "value")), context),
                    ),
                    context,
                );
                let difference = if a > b {
                    a - b
                } else {
                    b - a
                };
                let magnitude = if b < 0.0 {
                    -b
                } else {
                    b
                };
                testing::assert(
                    a == b || (a != a && b != b)
                        || (math::is_finite(a) && math::is_finite(b)
                            && difference <= 1e-12 + magnitude * 1e-12),
                );
            } else {
                testing::assert_eq(
                    (match actual {
                        json::Value::Object(items) => items.len(),
                        _ => -1,
                    }),
                    fields.len(),
                );
                for pair in fields {
                    compare_reference(required(actual, pair.0), pair.1, context);
                }
            }
        },
        json::Value::Array(values) => {
            let actual = testing::expect_some(json::as_array(actual), context);
            testing::assert_eq(actual.len(), values.len());
            for index in 0..values.len() {
                compare_reference(actual[index], values[index], context);
            }
        },
        _ => testing::assert_eq(json::encode(actual), json::encode(expected)),
    }
}
