package main;

use ecosystem::sqlite::{Database, Executor, Transaction, TransactionMode, Params, Value, Row, FromRow, FromValue, ToValue, DbError, ErrorKind, Statement};
use std::bytes::{Bytes};
use std::json;
use std::num;
use std::math;
use std::env;
use std::io;
use std::process;

pub struct UserId {
    pub value: i64,
}

impl ToValue for UserId {
    fn to_value(self: UserId) -> Value {
        Value::Integer(self.value)
    }
}

impl FromValue for UserId {
    fn from_value(value: Value) -> Result[UserId, DbError] {
        let value: i64 = FromValue::from_value(value)?;
        Result::Ok(UserId { value })
    }
}

pub struct User {
    pub id: UserId,
    pub name: string,
    pub note: Option[string],
}

impl FromRow for User {
    fn from_row(row: Row) -> Result[User, DbError] {
        Result::Ok(
            User {
                id: row.get_named("id")?,
                name: row.get_named("name")?,
                note: row.get_named("note")?,
            },
        )
    }
}

pub fn exercise() -> Result[(), DbError] {
    let database = Database::memory()?;
    defer {
        let _ = database.close();
    };
    database.execute(
        "CREATE TABLE users(id INTEGER PRIMARY KEY, name TEXT UNIQUE, note TEXT)",
        Params::empty(),
    )?;
    let first = UserId { value: 17 };
    database.transaction(
        TransactionMode::Immediate,
        |transaction| {
            let insert = transaction.prepare("INSERT INTO users VALUES(:id,:name,:note)")?;
            defer {
                let _ = insert.close();
            };
            let absent: Option[string] = Option::None;
            insert.execute(
                Params::named(
                    Vec::from_array(
                        [
                            ("id", first.to_value()),
                            ("name", "Ada 中😀".to_value()),
                            ("note", absent.to_value()),
                        ],
                    ),
                ),
            )?;
            transaction.with_savepoint(
                |savepoint| {
                    savepoint.execute(
                        "INSERT INTO users VALUES(18,'Grace','compiler')",
                        Params::empty(),
                    )?;
                    Result::Ok(())
                },
            )?;
            Result::Ok(())
        },
    )?;
    let users: Vec[User] = database.query_all(
        "SELECT * FROM users ORDER BY id",
        Params::empty(),
        10,
    )?;
    if users.len() != 2 || users[0].id.value != 17 || users[0].name != "Ada 中😀"
        || users[0].note.is_some()
        || users[1].note != Option::Some("compiler") {
        return Result::Err(DbError::new(ErrorKind::Conversion, "downstream row mapping failed"))
    }
    let rejected: Result[(), DbError] = database.transaction(
        TransactionMode::Deferred,
        |transaction| {
            transaction.execute("DELETE FROM users", Params::empty())?;
            Result::Err(DbError::new(ErrorKind::Argument, "abort"))
        },
    );
    if rejected.is_ok() {
        return Result::Err(DbError::new(ErrorKind::Argument, "transaction should fail"))
    }
    let row: Row = database.query_one("SELECT count(*) FROM users", Params::empty())?;
    let count: i64 = row.get(0)?;
    if count != 2 || database.resources().transactions != 0 || database.resources().cursors != 0
        || database.resources().statements != 0 {
        return Result::Err(DbError::new(ErrorKind::Argument, "transaction cleanup failed"))
    }
    database.close()?;
    Result::Ok(())
}

fn field(value: json::Value, name: string) -> json::Value {
    json::field(value, name).unwrap_or(json::Value::Null)
}

fn text(value: json::Value, name: string) -> string {
    json::as_string(field(value, name)).unwrap_or("")
}

fn integer(value: json::Value, name: string, fallback: isize) -> isize {
    json::as_int(field(value, name)).unwrap_or(fallback)
}

fn bad(message: string) -> DbError {
    DbError::new(ErrorKind::Argument, message)
}

fn decode(value: json::Value) -> Result[Value, DbError] {
    let raw = field(value, "value");
    match text(value, "type") {
        "null" => Result::Ok(Value::Null),
        "integer" => Result::Ok(
            Value::Integer(
                num::parse_int_structured(json::as_string(raw).ok_or(bad("integer text"))?).map_err(
                    |_| bad("integer range"),
                )?.to_i64(),
            ),
        ),
        "real" => {
            let value = json::as_string(raw).ok_or(bad("real text"))?;
            Result::Ok(
                Value::Real(
                    match value {
                        "nan" => float64_from_bits(0x7ff8000000000000),
                        "inf" => float64_from_bits(0x7ff0000000000000),
                        "-inf" => float64_from_bits(0xfff0000000000000),
                        _ => num::parse_float64_structured(value).map_err(|_| bad("real number"))?,
                    },
                ),
            )
        },
        "text" => Result::Ok(Value::Text(json::as_string(raw).ok_or(bad("text"))?)),
        "blob" | "textbytes" => {
            let bytes: Vec[u8] = Vec::new();
            for value in json::as_array(raw).ok_or(bad("byte array"))? {
                let value = json::as_int(value).ok_or(bad("byte"))?;
                if value < 0 || value > 255 {
                    return Result::Err(bad("byte range"))
                }
                bytes.push(value.to_u8());
            }
            let bytes = Bytes::from_vec(bytes);
            Result::Ok(
                if text(value, "type") == "blob" {
                    Value::Blob(bytes)
                } else {
                    Value::TextBytes(bytes)
                },
            )
        },
        _ => Result::Err(bad("unknown parameter type")),
    }
}

fn params(command: json::Value) -> Result[Params, DbError] {
    let values = Vec::new();
    for value in json::as_array(field(command, "params")).unwrap_or(Vec::new()) {
        values.push(decode(value)?);
    }
    if let Some(names) = json::as_array(field(command, "names")) {
        if names.len() != values.len() {
            return Result::Err(bad("name count"))
        }
        let named = Vec::new();
        for index in 0..names.len() {
            named.push((json::as_string(names[index]).ok_or(bad("name"))?, values[index]));
        }
        Result::Ok(Params::named(named))
    } else {
        Result::Ok(Params::positional(values))
    }
}

fn typed(name: string, value: json::Value) -> json::Value {
    json::Value::Object(Vec::from_array([("type", json::Value::String(name)), ("value", value)]))
}

fn byte_json(bytes: Bytes) -> json::Value {
    let values = Vec::new();
    for value in bytes.to_vec() {
        values.push(json::Value::Number(value.to_string()));
    }
    json::Value::Array(values)
}

fn encode(value: Value) -> json::Value {
    match value {
        Value::Null => typed("null", json::Value::Null),
        Value::Integer(value) => typed("integer", json::Value::String(value.to_string())),
        Value::Real(value) => typed(
            "real",
            json::Value::String(
                if math::is_nan(value) {
                    "nan"
                } else if math::is_infinite(value) {
                    if value < 0.0 {
                        "-inf"
                    } else {
                        "inf"
                    }
                } else {
                    value.to_string()
                },
            ),
        ),
        Value::Text(value) => typed("text", json::Value::String(value)),
        Value::TextBytes(value) => typed("textbytes", byte_json(value)),
        Value::Blob(value) => typed("blob", byte_json(value)),
    }
}

fn rows_json(rows: ecosystem::sqlite::Rows, limit: isize) -> Result[json::Value, DbError] {
    defer {
        let _ = rows.close();
    };
    let columns = Vec::new();
    for column in rows.columns()? {
        columns.push(json::Value::String(column.name));
    }
    let values = Vec::new();
    let records: Vec[Row] = rows.collect(limit)?;
    for row in records {
        let encoded = Vec::new();
        for value in row.values() {
            encoded.push(encode(value));
        }
        values.push(json::Value::Array(encoded));
    }
    Result::Ok(
        json::Value::Object(
            Vec::from_array(
                [("columns", json::Value::Array(columns)), ("rows", json::Value::Array(values))],
            ),
        ),
    )
}

fn execution_json(rows: i64, id: i64) -> json::Value {
    json::Value::Object(
        Vec::from_array(
            [
                ("changes", json::Value::String(rows.to_string())),
                ("last_id", json::Value::String(id.to_string())),
            ],
        ),
    )
}

fn execute[E: Executor](executor: E, command: json::Value, statements: Vec[Statement]) -> Result[
    json::Value,
    DbError,
] {
    match text(command, "op") {
        "exec" => {
            let result = executor.execute(text(command, "sql"), params(command)?)?;
            Result::Ok(execution_json(result.rows_affected, result.last_insert_id))
        },
        "query" => rows_json(
            executor.query(text(command, "sql"), params(command)?)?,
            integer(command, "limit", 10000),
        ),
        "prepare" => {
            let result = executor.prepare(text(command, "sql"))?;
            statements.push(result);
            Result::Ok(json::Value::Number((statements.len() - 1).to_string()))
        },
        _ => Result::Err(bad("unknown executor operation")),
    }
}

fn command(
    database: Database,
    transactions: Vec[Transaction],
    statements: Vec[Statement],
    command: json::Value,
) -> Result[json::Value, DbError] {
    let op = text(command, "op");
    if op == "exec" || op == "query" || op == "prepare" {
        if transactions.is_empty() || json::as_bool(field(command, "root")).unwrap_or(false) {
            return execute(database, command, statements)
        }
        return execute(transactions[transactions.len() - 1], command, statements)
    }
    if op == "stmt_exec" || op == "stmt_query" || op == "stmt_close" {
        let index = integer(command, "id", -1);
        if index < 0 || index >= statements.len() {
            return Result::Err(bad("statement id"))
        }
        let statement = statements[index];
        if op == "stmt_close" {
            statement.close()?;
            return Result::Ok(json::Value::Null)
        }
        if op == "stmt_query" {
            return rows_json(statement.query(params(command)?)?, integer(command, "limit", 10000))
        }
        let result = statement.execute(params(command)?)?;
        return Result::Ok(execution_json(result.rows_affected, result.last_insert_id))
    }
    if op == "begin" {
        let mode = match text(command, "mode") {
            "immediate" => TransactionMode::Immediate,
            "exclusive" => TransactionMode::Exclusive,
            _ => TransactionMode::Deferred,
        };
        transactions.push(database.begin(mode)?);
    } else if op == "savepoint" {
        if transactions.is_empty() {
            return Result::Err(bad("savepoint outside transaction"))
        }
        transactions.push(transactions[transactions.len() - 1].savepoint()?);
    } else if op == "commit" || op == "rollback" {
        if transactions.is_empty() {
            return Result::Err(bad("missing transaction"))
        }
        let transaction = transactions[transactions.len() - 1];
        if op == "commit" {
            transaction.commit()?;
        } else {
            transaction.rollback()?;
        }
        let _ = transactions.remove(transactions.len() - 1);
    } else if op == "close" {
        database.close()?;
    } else if op == "resources" {
        let stats = database.resources();
        return Result::Ok(
            json::Value::Array(
                Vec::from_array(
                    [
                        json::Value::Number(stats.statements.to_string()),
                        json::Value::Number(stats.cursors.to_string()),
                        json::Value::Number(stats.transactions.to_string()),
                    ],
                ),
            ),
        )
    } else {
        return Result::Err(bad("unknown command"))
    }
    Result::Ok(json::Value::Null)
}

pub fn run_case(request: json::Value) -> Result[json::Value, DbError] {
    let dsn = json::as_string(field(request, "dsn")).unwrap_or(":memory:");
    let database = Database::open(dsn)?;
    defer {
        let _ = database.close();
    };
    let transactions = Vec::new();
    let statements = Vec::new();
    let results = Vec::new();
    for input in json::as_array(field(request, "commands")).ok_or(bad("commands"))? {
        results.push(
            match command(database, transactions, statements, input) {
                Ok(value) => value,
                Err(error) => json::Value::Object(
                    Vec::from_array(
                        [
                            ("error", json::Value::String(error.kind.debug())),
                            ("code", json::Value::Number(error.code.to_string())),
                            ("message", json::Value::String(error.to_string())),
                        ],
                    ),
                ),
            },
        );
    }
    Result::Ok(json::Value::Array(results))
}

fn run() -> Result[(), string] {
    if env::args().len() == 1 {
        exercise().map_err(|e| e.to_string())?;
        println("sqlite consumer: ok");
        return Result::Ok(())
    }
    let input = io::read_stdin_to_string().map_err(|error| error.to_string())?;
    let requests = json::as_array(json::parse(input)?).ok_or("expected cases")?;
    let results = Vec::new();
    for request in requests {
        results.push(run_case(request).map_err(|e| e.to_string())?);
    }
    println(json::encode(json::Value::Array(results)));
    Result::Ok(())
}

fn main() -> () {
    if let Err(message) = run() {
        io::eprintln(message);
        process::exit(1);
    }
}
