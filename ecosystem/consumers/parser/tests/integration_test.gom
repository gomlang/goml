package tests;

use ecosystem::parser;
use ecosystem::proptest;
use std::testing;

#[test]
fn integer_and_list_roundtrips_across_modules() -> () {
    let integers = testing::expect_ok(proptest::integers(-100000, 100000), "integers");
    testing::assert_none(
        testing::expect_ok(
            proptest::check(
                integers,
                proptest::Config::new(2026),
                |value: isize| {
                    parser::integer().parse(value.to_string()).unwrap_or(100001) == value
                },
            ),
            "integer roundtrip",
        ),
    );
    let vectors = testing::expect_ok(proptest::vectors(integers, 0, 20), "vectors");
    testing::assert_none(
        testing::expect_ok(
            proptest::check(
                vectors,
                proptest::Config::new(27),
                |values: Vec[isize]| {
                    let text = values.join(",");
                    match parser::integer().separated(parser::literal(","), 0, false).parse(text) {
                        Ok(parsed) => parsed == values,
                        Err(_) => false,
                    }
                },
            ),
            "list roundtrip",
        ),
    );
}
