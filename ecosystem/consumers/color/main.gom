package main;

use ecosystem::color;
use ecosystem::color::{Srgb, Lab, Gamut, MixSpace, HueDirection, Gradient};
use std::serde::{Serialize, Deserialize};
use std::json;
use std::io;
use std::env;
use std::testing;

#[derive(Deserialize)]
struct Case {
    op: string,
    text: string,
    values: Vec[f64],
}

#[derive(Serialize)]
struct Reply {
    ok: bool,
    hex: string,
    values: Vec[f64],
}

fn channels(value: Srgb) -> Vec[f64] {
    Vec::from_array([value.red(), value.green(), value.blue(), value.alpha()])
}

fn execute(input: Case) -> Result[Reply, color::Error] {
    if input.op == "delta" {
        let a = Lab::new(input.values[0], input.values[1], input.values[2], 1.0)?;
        let b = Lab::new(input.values[3], input.values[4], input.values[5], 1.0)?;
        return Result::Ok(
            Reply {
                ok: true,
                hex: "",
                values: Vec::from_array([a.delta_e_2000(b), b.delta_e_2000(a), a.delta_e_76(b)]),
            },
        )
    }
    let value = if input.op == "parse" {
        color::parse(input.text)?
    } else {
        Srgb::new(input.values[0], input.values[1], input.values[2], input.values[3])?
    };
    if input.op == "composite" {
        let background = Srgb::new(
            input.values[4],
            input.values[5],
            input.values[6],
            input.values[7],
        )?;
        let result = value.composite_over(background);
        return Result::Ok(Reply { ok: true, hex: result.to_hex_alpha(), values: channels(result) })
    }
    if input.op == "mix" {
        let other = Srgb::new(input.values[4], input.values[5], input.values[6], input.values[7])?;
        let space = match input.text {
            "srgb" => MixSpace::Srgb,
            "linear" => MixSpace::LinearRgb,
            "hsl" => MixSpace::Hsl(HueDirection::Shorter),
            _ => MixSpace::Oklab,
        };
        let result = color::mix(value, other, input.values[8], space, Gamut::Clip)?;
        return Result::Ok(Reply { ok: true, hex: result.to_hex_alpha(), values: channels(result) })
    }
    let linear = value.to_linear();
    let hsl = value.to_hsl();
    let hsv = value.to_hsv();
    let xyz = value.to_xyz();
    let lab = value.to_lab();
    let ok = value.to_oklab();
    let data = channels(value);
    for channel in Vec::from_array(
        [
            linear.red(),
            linear.green(),
            linear.blue(),
            hsl.hue(),
            hsl.saturation(),
            hsl.lightness(),
            hsv.hue(),
            hsv.saturation(),
            hsv.value(),
            xyz.x(),
            xyz.y(),
            xyz.z(),
            lab.lightness(),
            lab.a(),
            lab.b(),
            ok.lightness(),
            ok.a(),
            ok.b(),
            value.relative_luminance(),
        ],
    ) {
        data.push(channel);
    }
    Result::Ok(Reply { ok: true, hex: value.to_hex_alpha(), values: data })
}

pub fn exercise() -> () {
    let start = testing::expect_ok(color::parse("rebeccapurple"), "start");
    let end = testing::expect_ok(color::parse("hsl(160 80% 60%)"), "end");
    let gradient = testing::expect_ok(
        Gradient::evenly_spaced(
            Vec::from_array([start, end]),
            MixSpace::Oklch(HueDirection::Shorter),
            Gamut::PreserveHue,
        ),
        "gradient",
    );
    let samples = testing::expect_ok(gradient.samples(24), "theme palette");
    testing::assert_eq(samples.len(), 24);
    testing::assert_eq(samples[0].to_hex(), "#663399");
    testing::assert_eq(samples[23].to_hex(), end.to_hex());
    for background in samples {
        let foreground = testing::expect_ok(background.readable_foreground(), "foreground");
        testing::assert(
            testing::expect_ok(background.contrast_ratio(foreground), "contrast") >= 4.5,
        );
        testing::assert(
            testing::expect_ok(color::parse(background.to_hex_alpha()), "roundtrip").to_rgba8()
                == background.to_rgba8(),
        );
    }
}

fn main() -> () {
    let args = env::args();
    if args.len() > 1 && args[1] == "--json" {
        let input = testing::expect_ok(io::read_stdin_to_string(), "stdin");
        let cases: Vec[Case] = testing::expect_ok(json::from_string(input), "cases");
        let replies: Vec[Reply] = Vec::new();
        for input in cases {
            replies.push(
                match execute(input) {
                    Ok(reply) => reply,
                    Err(_) => Reply { ok: false, hex: "", values: Vec::new() },
                },
            );
        }
        println(testing::expect_ok(json::try_to_string(replies), "replies"));
    } else {
        exercise();
        println("color consumer: perceptual theme gradient and readable foregrounds ok");
    }
}
