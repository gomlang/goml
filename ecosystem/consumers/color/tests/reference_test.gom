package tests;

use consumer::color as application;
use std::testing;
use std::fs;
use std::json;
use std::math;

fn field(value: json::Value, name: string) -> json::Value {
    testing::expect_some(json::field(value, name), "reference field " + name)
}

fn reference_rows() -> Vec[json::Value] {
    let source = testing::expect_ok(
        fs::read_file_structured("tests/data/reference.jsonl"),
        "reference vectors",
    );
    let rows = Vec::new();
    for line in source.split("\n") {
        if line != "" {
            rows.push(testing::expect_ok(json::parse(line), "reference JSON"));
        }
    }
    rows
}

fn number(value: json::Value) -> f64 {
    testing::expect_ok(json::from_value(value), "floating reference")
}

#[test]
fn independent_colorsys_and_high_precision_alpha_vectors() -> () {
    let rows = reference_rows();
    testing::assert_eq(rows.len(), 4659);
    for row in rows {
        let result = application::reference_case(field(row, "input"));
        let expected = field(row, "expected");
        let ok = testing::expect_some(json::as_bool(field(result, "ok")), "status");
        if json::encode(expected) == "null" {
            testing::assert(!ok);
            continue;
        }
        testing::assert(ok);
        if let Some(hex) = json::field(expected, "hex") {
            testing::assert(json::encode(field(result, "hex")) == json::encode(hex));
        }
        let actual = testing::expect_some(
            json::as_array(field(result, "values")),
            "actual channels",
        );
        let wanted = testing::expect_some(
            json::as_array(field(expected, "values")),
            "reference channels",
        );
        testing::assert_eq(actual.len(), wanted.len());
        if let Some(alpha) = json::field(expected, "exact_alpha") {
            testing::assert_eq(number(actual[3]), number(alpha));
        }
        let tolerance = json::field(expected, "tolerance").map(|value| number(value)).unwrap_or(
            2e-10,
        );
        for index in 0..actual.len() {
            let value = number(actual[index]);
            testing::assert(math::is_finite(value));
            testing::assert(absolute(value - number(wanted[index])) <= tolerance);
        }
    }
}

fn absolute(value: f64) -> f64 {
    if value < 0.0 {
        -value
    } else {
        value
    }
}
