package tests;

use consumer::color;
use ecosystem::color::{Srgb, LinearRgb, Gamut};
use std::testing;

#[test]
fn builds_accessible_theme_palette_across_package_boundary() -> () {
    color::exercise();
}

#[test]
fn checked_models_and_quantization_work_from_dependency_interface() -> () {
    let input = testing::expect_ok(LinearRgb::new(2.0, -0.1, 0.5, 0.5), "extended color");
    testing::assert(input.to_srgb(Gamut::Clip).to_rgba8() == (255, 0, 188, 128));
    testing::assert_err(Srgb::new(1.0, 1.0, 1.0, -0.1));
}
