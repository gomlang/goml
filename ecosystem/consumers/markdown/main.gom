package main;

use ecosystem::markdown;
use std::env;
use std::io;
use std::json;
use std::process;
use std::testing;

fn run() -> Result[(), string] {
    let input = io::read_stdin_to_string().map_err(|problem| problem.to_string())?;
    let args = env::args();
    if args.len() > 1 && args[1] == "--json" {
        let values = json::as_array(json::parse(input)?).ok_or("expected array")?;
        let results: Vec[json::Value] = Vec::new();
        for value in values {
            let source = json::as_string(value).ok_or("expected string")?;
            let document = markdown::parse(source).map_err(|problem| problem.to_string())?;
            results.push(
                json::Value::String(
                    markdown::render(document, markdown::RenderOptions::commonmark()).map_err(
                        |problem| problem.to_string(),
                    )?,
                ),
            );
        }
        print(json::encode(json::Value::Array(results)));
    } else {
        let document = markdown::parse(input).map_err(|problem| problem.to_string())?;
        print(
            markdown::render(
                document,
                if args.len() > 1 && args[1] == "--commonmark" {
                    markdown::RenderOptions::commonmark()
                } else {
                    markdown::RenderOptions::standard()
                },
            ).map_err(|problem| problem.to_string())?,
        );
    }
    Result::Ok(())
}

fn main() -> () {
    if env::args().len() == 1 {
        testing::assert_eq(
            testing::expect_ok(markdown::to_html("**GoML**"), "render"),
            "<p><strong>GoML</strong></p>\n",
        );
        println("markdown consumer: ok");
    } else if let Err(message) = run() {
        io::eprintln(message);
        process::exit(1);
    }
}
