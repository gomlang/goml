package tests;

use ecosystem::verification::reference;
use std::testing;

#[test]
fn independent_reference_corpus() -> () {
    let fixture = reference::load();
    let actual = testing::expect_ok(
        reference::run_json("markdown", reference::field(fixture, "input")),
        "reference protocol",
    );
    reference::assert_equal(
        actual,
        reference::field(fixture, "expected"),
        "markdown independent reference",
    );
}
