package tests;

use consumer::msgpack as app;
use std::fs;
use std::json;
use std::testing;
use std::num;

fn required(value: json::Value, name: string) -> json::Value {
    testing::expect_some(json::field(value, name), name)
}

#[test]
fn independent_reference_fixture_sequences() -> () {
    let source = testing::expect_ok(
        fs::read_file_structured("tests/data/reference.jsonl"),
        "reference fixture",
    );
    let mut count = 0;
    for line in source.split("\n") {
        if line == "" {
            continue;
        }
        let case = testing::expect_ok(json::parse(line), "fixture JSON");
        let expected = required(case, "expected");
        let context = "reference case " + count.to_string();
        let actual = app::handle(required(case, "request"));
        if let json::Value::Null = expected {
            testing::assert_err(actual);
        } else {
            testing::assert_eq(
                json::encode(testing::expect_ok(actual, context)),
                json::encode(expected),
            );
        }
        count += 1;
    }
    testing::assert_eq(count, 2490);
}
