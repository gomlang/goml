package tests;

use ecosystem::msgpack;
use std::bytes;
use std::io;
use std::serde::{Serialize, Deserialize};
use std::testing;

#[derive(Serialize, Deserialize, PartialEq)]
struct Packet {
    payload: msgpack::Binary,
    extension: msgpack::Extension,
}

#[test]
fn independent_serde_types_compose_with_standard_buffered_streams() -> () {
    let output = io::Cursor::new(bytes::Bytes::new());
    let buffered = testing::expect_ok(io::BufWriter::with_capacity(output, 7), "buffered writer");
    let writer = testing::expect_ok(
        msgpack::StreamWriter::new(buffered, msgpack::Options::standard()),
        "writer",
    );
    let expected = Packet {
        payload: msgpack::Binary { data: Vec::from_array([0, 255, 192]) },
        extension: msgpack::Extension { tag: -7, data: Vec::from_array([1, 2, 3]) },
    };
    testing::assert_ok(writer.serialize(expected));
    testing::assert_ok(writer.serialize("next frame"));
    testing::assert_ok(writer.flush());
    let reader = testing::expect_ok(
        msgpack::StreamReader::new(
            io::BufReader::new(io::Cursor::new(output.bytes())),
            msgpack::Options::standard(),
        ),
        "reader",
    );
    let decoded: Option[Packet] = testing::expect_ok(reader.decode_next(), "packet");
    testing::assert(decoded == Option::Some(expected));
    let tail: Option[string] = testing::expect_ok(reader.decode_next(), "tail");
    testing::assert(tail == Option::Some("next frame"));
    testing::assert(testing::expect_ok(reader.next(), "EOF").is_none());
}
