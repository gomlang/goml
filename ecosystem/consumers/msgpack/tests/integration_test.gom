package tests;

use consumer::msgpack as example;
use ecosystem::msgpack;
use std::testing;

#[test]
fn downstream_derive_and_generic_serializer_monomorphization() -> () {
    testing::assert_ok(example::exercise());
    let bytes = testing::expect_ok(msgpack::to_vec(Vec::from_array([1, 2, 3])), "encode");
    let values: Vec[isize] = testing::expect_ok(msgpack::from_slice(bytes.as_slice()), "decode");
    testing::assert(values == Vec::from_array([1, 2, 3]));
}
