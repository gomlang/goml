package main;

use ecosystem::llvm::{Context, Module, LlvmError, BinaryOp, IntPredicate, CastOp, OptimizationLevel};
use std::env;
use std::io;
use std::process;
use std::fs;

pub fn build(context: Context) -> Result[Module, LlvmError] {
    let module = context.module("goml_llvm_consumer")?;
    let integer = context.int_type(64)?;
    let signature = context.function_type(integer, Vec::from_array([integer]), false)?;
    let builder = context.builder()?;
    defer {
        let _ = builder.close();
    };
    let mix = module.add_function("goml_mix", signature)?;
    builder.position_at_end(mix.append_block("entry")?)?;
    let input = mix.parameter(0)?;
    input.set_name("x")?;
    let slot = builder.alloca(integer, "slot")?;
    builder.store(input, slot)?;
    let loaded = builder.load(integer, slot, "loaded")?;
    let product = builder.binary(BinaryOp::Mul, loaded, integer.const_signed(3)?, "product")?;
    builder.ret(builder.binary(BinaryOp::Add, product, integer.const_signed(7)?, "result")?)?;
    let absolute = module.add_function("goml_absolute_mix", signature)?;
    let entry = absolute.append_block("entry")?;
    let negative = absolute.append_block("negative")?;
    let positive = absolute.append_block("positive")?;
    let merge = absolute.append_block("merge")?;
    builder.position_at_end(entry)?;
    let input = absolute.parameter(0)?;
    builder.conditional_branch(
        builder.int_compare(IntPredicate::SignedLess, input, integer.zero()?, "negative_test")?,
        negative,
        positive,
    )?;
    builder.position_at_end(negative)?;
    let negated = builder.binary(BinaryOp::Sub, integer.zero()?, input, "negated")?;
    builder.branch(merge)?;
    builder.position_at_end(positive)?;
    builder.branch(merge)?;
    builder.position_at_end(merge)?;
    let merged = builder.phi(integer, "absolute")?;
    merged.add_incoming(Vec::from_array([(negated, negative), (input, positive)]))?;
    builder.ret(builder.call(mix, Vec::from_array([merged]), "mixed")?)?;
    let sum = module.add_function("goml_sum", signature)?;
    let entry = sum.append_block("entry")?;
    let condition = sum.append_block("condition")?;
    let body = sum.append_block("body")?;
    let exit = sum.append_block("exit")?;
    builder.position_at_end(entry)?;
    builder.branch(condition)?;
    builder.position_at_end(condition)?;
    let index = builder.phi(integer, "index")?;
    let total = builder.phi(integer, "total")?;
    builder.conditional_branch(
        builder.int_compare(IntPredicate::SignedLess, index, sum.parameter(0)?, "continue")?,
        body,
        exit,
    )?;
    builder.position_at_end(body)?;
    let next_total = builder.binary(BinaryOp::Add, total, index, "next_total")?;
    let next_index = builder.binary(BinaryOp::Add, index, integer.const_signed(1)?, "next_index")?;
    builder.branch(condition)?;
    index.add_incoming(Vec::from_array([(integer.zero()?, entry), (next_index, body)]))?;
    total.add_incoming(Vec::from_array([(integer.zero()?, entry), (next_total, body)]))?;
    builder.position_at_end(exit)?;
    builder.ret(total)?;
    let float_type = context.double_type()?;
    let float_signature = context.function_type(float_type, Vec::from_array([float_type]), false)?;
    let scale = module.add_function("goml_scale", float_signature)?;
    builder.position_at_end(scale.append_block("entry")?)?;
    let product = builder.binary(
        BinaryOp::FloatMul,
        scale.parameter(0)?,
        float_type.const_float(1.5)?,
        "product",
    )?;
    builder.ret(
        builder.binary(BinaryOp::FloatAdd, product, float_type.const_float(0.25)?, "result")?,
    )?;
    let pair = context.struct_type(Vec::from_array([integer, integer]), false)?;
    let pick = module.add_function("goml_struct", signature)?;
    builder.position_at_end(pick.append_block("entry")?)?;
    let slot = builder.alloca(pair, "pair")?;
    let field = builder.gep(
        pair,
        slot,
        Vec::from_array([context.int_type(32)?.zero()?, context.int_type(32)?.const_signed(1)?]),
        true,
        "field",
    )?;
    builder.store(pick.parameter(0)?, field)?;
    builder.ret(builder.load(integer, field, "result")?)?;
    let converted = module.add_function(
        "goml_convert",
        context.function_type(float_type, Vec::from_array([integer]), false)?,
    )?;
    builder.position_at_end(converted.append_block("entry")?)?;
    builder.ret(
        builder.cast(CastOp::SignedToFloat, converted.parameter(0)?, float_type, "converted")?,
    )?;
    module.verify()?;
    Result::Ok(module)
}

pub fn exercise() -> Result[(), LlvmError] {
    let context = Context::new();
    defer {
        let _ = context.close();
    };
    let module = build(context)?;
    let roundtrip = context.parse_ir(module.ir()?)?;
    roundtrip.verify()?;
    let decoded = context.parse_bitcode(module.bitcode()?)?;
    decoded.verify()?;
    let clone = module.clone()?;
    clone.optimize(OptimizationLevel::Default)?;
    clone.verify()?;
    module.verify()?;
    Result::Ok(())
}

fn run() -> Result[(), string] {
    let args = env::args();
    if args.len() == 1 {
        exercise().map_err(|error| error.to_string())?;
        println("llvm consumer: ok (LLVM " + ecosystem::llvm::version() + ")");
        return Result::Ok(())
    }
    let context = Context::new();
    defer {
        let _ = context.close();
    };
    let module = build(context).map_err(|error| error.to_string())?;
    let prefix = args[1];
    fs::write_file_structured(prefix + ".ll", module.ir().map_err(|error| error.to_string())?).map_err(
        |error| error.to_string(),
    )?;
    fs::write_bytes_structured(prefix + ".bc", module.bitcode().map_err(|error| error.to_string())?).map_err(
        |error| error.to_string(),
    )?;
    module.emit_object(prefix + "-unoptimized.o", OptimizationLevel::None).map_err(
        |error| error.to_string(),
    )?;
    module.optimize(OptimizationLevel::Aggressive).map_err(|error| error.to_string())?;
    module.emit_object(prefix + ".o", OptimizationLevel::Aggressive).map_err(
        |error| error.to_string(),
    )?;
    module.emit_assembly(prefix + ".s", OptimizationLevel::Default).map_err(
        |error| error.to_string(),
    )?;
    module.verify().map_err(|error| error.to_string())?;
    Result::Ok(())
}

fn main() -> () {
    if let Err(error) = run() {
        io::eprintln(error);
        process::exit(1);
    }
}
