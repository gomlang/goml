package tests;

use consumer::llvm as app;
use ecosystem::llvm::{Context, TargetOptions, CodeModel, OptimizationLevel};
use std::fs;
use std::testing;

#[test]
fn target_objects_are_recognized_by_independent_llvm_tools() -> () {
    let directory = "_artifact/target-tool-reference";
    testing::assert_ok(fs::create_dir_all(directory));
    let context = Context::new();
    defer {
        testing::assert_ok(context.close());
    };
    let module = testing::expect_ok(app::build(context), "build functions");
    let original = testing::expect_ok(module.ir(), "original IR");
    for (triple, format, machine) in Vec::from_array(
        [
            ("x86_64-unknown-linux-gnu", "elf64-x86-64", "EM_X86_64"),
            ("i386-unknown-linux-gnu", "elf32-i386", "EM_386"),
            ("aarch64-unknown-linux-gnu", "elf64-littleaarch64", "EM_AARCH64"),
            ("aarch64_be-unknown-linux-gnu", "elf64-bigaarch64", "EM_AARCH64"),
        ],
    ) {
        let target = testing::expect_ok(
            context.target_machine(TargetOptions::new(triple)),
            "target",
        );
        let copy = testing::expect_ok(module.clone(), "clone");
        testing::assert_ok(target.optimize(copy, OptimizationLevel::Default));
        let object = testing::expect_ok(target.object_bytes(copy, 1048576), "object bytes");
        let prefix = directory + "/" + triple;
        testing::assert_ok(fs::write_bytes_structured(prefix + ".o", object));
        testing::assert_ok(target.emit_assembly(copy, prefix + ".s"));
        let headers = native_tool(
            "/usr/lib/llvm-18/bin/llvm-readobj",
            Vec::from_array(["--file-headers", "--symbols", prefix + ".o"]),
        );
        testing::assert(headers.contains("Format: " + format));
        testing::assert(headers.contains(machine));
        testing::assert(headers.contains("goml_absolute_mix"));
        let disassembled = native_tool(
            "/usr/lib/llvm-18/bin/llvm-objdump",
            Vec::from_array(["-d", prefix + ".o"]),
        );
        testing::assert(disassembled.contains("goml_mix"));
        let _ = native_tool(
            "/usr/lib/llvm-18/bin/llvm-mc",
            Vec::from_array(
                ["-triple=" + triple, "-filetype=obj", prefix + ".s", "-o", prefix + "-assembled.o"],
            ),
        );
        let roundtrip = native_tool(
            "/usr/lib/llvm-18/bin/llvm-readobj",
            Vec::from_array(["--file-headers", prefix + "-assembled.o"]),
        );
        testing::assert(roundtrip.contains("Format: " + format));
        testing::assert_eq(testing::expect_ok(module.ir(), "preserved original"), original);
        testing::assert_ok(copy.close());
        testing::assert_ok(target.close());
    }
}

#[test]
fn configured_portable_host_object_links_and_executes() -> () {
    let directory = "_artifact/target-native-reference";
    testing::assert_ok(fs::create_dir_all(directory));
    let context = Context::new();
    defer {
        testing::assert_ok(context.close());
    };
    let target = testing::expect_ok(
        context.target_machine(
            TargetOptions {
                cpu: "x86-64",
                features: "-avx",
                code_model: CodeModel::Small,
                ..TargetOptions::new("x86_64-unknown-linux-gnu"),
            },
        ),
        "portable host",
    );
    let module = testing::expect_ok(app::build(context), "build");
    testing::assert_ok(target.optimize(module, OptimizationLevel::Aggressive));
    testing::assert_ok(target.emit_object(module, directory + "/program.o"));
    let _ = native_tool(
        "cc",
        Vec::from_array(
            ["-O2", "tests/data/harness.c", directory + "/program.o", "-o", directory + "/program"],
        ),
    );
    check_native_results(native_tool(directory + "/program", Vec::new()));
}
