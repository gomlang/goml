package tests;

use consumer::llvm as app;
use ecosystem::llvm::{Context, OptimizationLevel};
use std::fs;
use std::process;
use std::testing;
use std::time;
use std::num;
use std::utf8;
use utf8::BytesUtf8;

fn native_tool(program: string, arguments: Vec[string]) -> string {
    let output = testing::expect_ok(
        process::Command::new(program).args(arguments).output_timeout_structured(
            time::Duration::from_seconds(90),
        ),
        program,
    );
    let stderr = testing::expect_ok(output.stderr().to_string_utf8(), "stderr");
    if !output.status().success() {
        testing::fail(program + ": " + stderr);
    }
    testing::expect_ok(output.stdout().to_string_utf8(), "stdout")
}

#[test]
fn llvm_cli_bitcode_ir_assembly_and_native_execution() -> () {
    let directory = "_artifact/native-tool-reference";
    testing::assert_ok(fs::create_dir_all(directory));
    let prefix = directory + "/program";
    let context = Context::new();
    defer {
        testing::assert_ok(context.close());
    };
    let module = testing::expect_ok(app::build(context), "build six native functions");
    testing::assert_ok(
        fs::write_file_structured(prefix + ".ll", testing::expect_ok(module.ir(), "IR")),
    );
    testing::assert_ok(
        fs::write_bytes_structured(prefix + ".bc", testing::expect_ok(module.bitcode(), "bitcode")),
    );
    testing::assert_ok(module.emit_object(prefix + "-unoptimized.o", OptimizationLevel::None));
    testing::assert_ok(module.optimize(OptimizationLevel::Aggressive));
    testing::assert_ok(module.emit_object(prefix + ".o", OptimizationLevel::Aggressive));
    testing::assert_ok(module.emit_assembly(prefix + ".s", OptimizationLevel::Default));
    let tools = "/usr/lib/llvm-18/bin/";
    let _ = native_tool(
        tools + "opt",
        Vec::from_array(["-passes=verify", "-disable-output", prefix + ".bc"]),
    );
    let _ = native_tool(
        tools + "llvm-dis",
        Vec::from_array([prefix + ".bc", "-o", directory + "/decoded.ll"]),
    );
    let _ = native_tool(
        tools + "llvm-as",
        Vec::from_array([prefix + ".ll", "-o", directory + "/assembled.bc"]),
    );
    let _ = native_tool(
        tools + "llc",
        Vec::from_array(
            [
                "-filetype=obj",
                "-relocation-model=pic",
                "-O=2",
                directory + "/assembled.bc",
                "-o",
                directory + "/cli.o",
            ],
        ),
    );
    let objects = Vec::from_array(
        [prefix + "-unoptimized.o", prefix + ".o", prefix + ".s", directory + "/cli.o"],
    );
    for variant in 0..objects.len() {
        let executable = directory + "/variant-" + variant.to_string();
        let _ = native_tool(
            "cc",
            Vec::from_array(["-O2", "tests/data/harness.c", objects[variant], "-o", executable]),
        );
        let output = native_tool(executable, Vec::new());
        let lines = output.trim().split("\n");
        testing::assert_eq(lines.len(), 401);
        for index in 0..lines.len() {
            let x = index - 200;
            let n = if x < 0 {
                -x
            } else {
                x
            };
            let fields = lines[index].split(" ");
            testing::assert_eq(fields.len(), 6);
            let expected = Vec::from_array([3 * x + 7, 3 * n + 7, n * (n - 1) / 2, x]);
            for pair in Vec::from_array([(0, 0), (1, 1), (2, 2), (4, 3)]) {
                testing::assert_eq(
                    testing::expect_ok(num::parse_int_structured(fields[pair.0]), "native integer"),
                    expected[pair.1],
                );
            }
            testing::assert_eq(
                testing::expect_ok(num::parse_float64_structured(fields[3]), "native float"),
                testing::expect_ok(
                    num::parse_float64_structured(x.to_string()),
                    "reference conversion",
                )
                    * 1.5
                    + 0.25,
            );
            testing::assert_eq(
                testing::expect_ok(num::parse_float64_structured(fields[5]), "native conversion"),
                testing::expect_ok(
                    num::parse_float64_structured(x.to_string()),
                    "reference conversion",
                ),
            );
        }
    }
}
