package main;

use ecosystem::compress;
use ecosystem::compress::flate;
use ecosystem::compress::gzip;
use ecosystem::compress::lzw;
use ecosystem::compress::zlib;
use std::bytes;
use std::io;
use io::Read;
use std::testing;

pub fn exercise() -> () {
    let source = io::Cursor::new(bytes::Bytes::from_vec(b"\x01\x03\x00\xfc\xffabcTAIL"));
    let decoder = testing::expect_ok(
        flate::Decoder::new(
            source,
            compress::Limits {
                max_input_bytes: 8,
                max_output_bytes: 3,
                max_blocks: 1,
                max_work: 100,
            },
        ),
        "consumer decoder",
    );
    let output = bytes::Bytes::from_vec(b"...");
    testing::expect_ok(decoder.read_exact(output.as_mut_slice()), "consumer read");
    testing::assert(output.to_vec() == b"abc");
    testing::assert_eq(testing::expect_ok(decoder.read(output.as_mut_slice()), "consumer EOF"), 0);
    testing::assert_eq(source.position(), 8);
    testing::assert(decoder.is_finished());
    let sink = io::Cursor::new(bytes::Bytes::new());
    let encoder = testing::expect_ok(
        flate::Encoder::new(
            sink,
            compress::Limits {
                max_input_bytes: 3,
                max_output_bytes: 32,
                max_blocks: 2,
                max_work: 100,
            },
            6,
        ),
        "consumer encoder",
    );
    testing::assert_eq(testing::expect_ok(encoder.write_chunk(b"abc".as_slice()), "encode"), 3);
    testing::expect_ok(encoder.finish(), "finish encoding");
    testing::assert(
        testing::expect_ok(
            flate::decode(
                sink.bytes(),
                compress::Limits {
                    max_input_bytes: sink.bytes().len(),
                    max_output_bytes: 3,
                    max_blocks: 2,
                    max_work: 100,
                },
            ),
            "consumer roundtrip",
        ).to_vec()
            == b"abc",
    );
    let packed = testing::expect_ok(
        gzip::encode(
            bytes::Bytes::from_vec(b"abc"),
            compress::Limits {
                max_input_bytes: 3,
                max_output_bytes: 64,
                max_blocks: 2,
                max_work: 100,
            },
            6,
        ),
        "consumer gzip encode",
    );
    testing::assert(
        testing::expect_ok(
            gzip::decode(
                packed,
                compress::Limits {
                    max_input_bytes: packed.len(),
                    max_output_bytes: 3,
                    max_blocks: 2,
                    max_work: 200,
                },
            ),
            "consumer gzip decode",
        ).to_vec()
            == b"abc",
    );
    let dictionary = bytes::Bytes::from_vec(b"abcabcabc");
    let packed = testing::expect_ok(
        zlib::encode_with_dictionary(
            bytes::Bytes::from_vec(b"abc"),
            compress::Limits {
                max_input_bytes: 3,
                max_output_bytes: 64,
                max_blocks: 2,
                max_work: 100,
            },
            6,
            dictionary.as_slice(),
        ),
        "consumer zlib encode",
    );
    testing::assert(
        testing::expect_ok(
            zlib::decode_with_dictionary(
                packed,
                compress::Limits {
                    max_input_bytes: packed.len(),
                    max_output_bytes: 3,
                    max_blocks: 2,
                    max_work: 200,
                },
                dictionary.as_slice(),
            ),
            "consumer zlib decode",
        ).to_vec()
            == b"abc",
    );
    let packed = testing::expect_ok(
        lzw::encode(
            bytes::Bytes::from_vec(b"abc"),
            compress::Limits {
                max_input_bytes: 3,
                max_output_bytes: 32,
                max_blocks: 2,
                max_work: 100,
            },
            lzw::BitOrder::Lsb,
            8,
        ),
        "consumer LZW encode",
    );
    testing::assert(
        testing::expect_ok(
            lzw::decode(
                packed,
                compress::Limits {
                    max_input_bytes: packed.len(),
                    max_output_bytes: 3,
                    max_blocks: 2,
                    max_work: 100,
                },
                lzw::BitOrder::Lsb,
                8,
            ),
            "consumer LZW decode",
        ).to_vec()
            == b"abc",
    );
}

fn main() -> () {
    exercise();
    println("compress consumer: bounded DEFLATE/GZIP/ZLIB/LZW and retained trailer passed");
}
