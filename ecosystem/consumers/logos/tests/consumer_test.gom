package tests;

use ecosystem::logos;
use std::testing;

#[test]
fn published_generic_callback_and_iterator_surface() -> () {
    let rules: Vec[logos::Rule[(string, logos::Position), isize, string]] = Vec::from_array(
        [
            logos::Rule::regex(
                "\\p{L}+",
                |ctx| {
                    ctx.set_extras(ctx.extras() + 1);
                    logos::Action::Emit((ctx.slice(), ctx.position()))
                },
            ),
            logos::Rule::skip("\\s+"),
        ],
    );
    let grammar = testing::expect_ok(logos::Grammar::compile(rules), "compile published grammar");
    let lexer = grammar.lexer("hello\n世界", 0);
    let tokens = lexer.spanned();
    let first = testing::expect_some(tokens.next(), "first token");
    let value = testing::expect_ok(first.0, "first value");
    testing::assert_eq(value.0, "hello");
    testing::assert_eq(value.1, logos::Position { line: 1, column: 1 });
    let second = testing::expect_some(tokens.next(), "second token");
    testing::assert_eq(second.1, logos::Span { start: 6, end: 12 });
    testing::assert_eq(
        testing::expect_ok(second.0, "second value").1,
        logos::Position { line: 2, column: 1 },
    );
    testing::assert_none(tokens.next());
    testing::assert_eq(lexer.extras(), 2);
}
