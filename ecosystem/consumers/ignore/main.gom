package main;

use ecosystem::ignore;
use std::env;
use std::io;
use std::json;
use std::testing;

fn field(value: json::Value, name: string) -> json::Value {
    json::field(value, name).unwrap_or(json::Value::Null)
}

fn text(value: json::Value, name: string) -> string {
    json::as_string(field(value, name)).unwrap_or("")
}

fn array(value: json::Value) -> Vec[json::Value] {
    match value {
        Array(values) => values,
        _ => Vec::new(),
    }
}

pub fn exercise() -> () {
    let original = ignore::Gitignore::new();
    let rules = testing::expect_ok(
        original.with_source("", ".gitignore", "target/\n*.tmp\n!keep.tmp\n"),
        "rules",
    );
    testing::assert(
        testing::expect_ok(rules.matched("target/main.gom", false), "directory inheritance").is_ignored(),
    );
    testing::assert(
        testing::expect_ok(rules.matched("src/keep.tmp", false), "negation").is_whitelisted(),
    );
    testing::assert(
        !testing::expect_ok(original.matched("target/main.gom", false), "persistent snapshot").is_ignored(),
    );
    let globs = testing::expect_ok(
        ignore::GlobSet::new(Vec::from_array(["**/*.gom", "**/test?.gom"])),
        "compile globs",
    );
    testing::assert(
        testing::expect_ok(globs.matches("src/test1.gom"), "glob set") == Vec::from_array([0, 1]),
    );
}

fn oracle() -> () {
    let input = testing::expect_ok(io::read_stdin_to_string(), "read requests");
    let cases: json::Value = testing::expect_ok(json::parse(input), "parse requests");
    let output: Vec[json::Value] = Vec::new();
    for value in array(cases) {
        let mut rules = testing::expect_ok(
            ignore::Gitignore::new().with_excludes(".git/info/exclude", text(value, "exclude")),
            "excludes",
        );
        for source in array(field(value, "rules")) {
            rules = testing::expect_ok(
                rules.with_source(
                    text(source, "base"),
                    text(source, "base") + "/.gitignore",
                    text(source, "source"),
                ),
                "ignore file",
            );
        }
        let decisions: Vec[json::Value] = Vec::new();
        for query in array(field(value, "paths")) {
            let directory = match field(query, "directory") {
                Bool(value) => value,
                _ => false,
            };
            let result = testing::expect_ok(
                rules.matched(
                    text(query, "path")
                        + (if directory {
                            "/"
                        } else {
                            ""
                        }),
                    directory,
                ),
                "match path",
            );
            decisions.push(json::Value::Bool(result.is_ignored()));
        }
        output.push(json::Value::Array(decisions));
    }
    println(json::encode(json::Value::Array(output)));
}

fn main() -> () {
    let args = env::args();
    if args.len() > 1 && args[1] == "--json" {
        oracle();
    } else {
        exercise();
        println("ignore consumer: ok");
    }
}
