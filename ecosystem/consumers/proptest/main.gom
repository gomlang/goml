package main;

use ecosystem::proptest;
use std::testing;

fn main() -> () {
    let generator = testing::expect_ok(proptest::integers(0, 10000), "generator");
    let failure = testing::expect_some(
        testing::expect_ok(
            proptest::check(generator, proptest::Config::new(42), |value: isize| value < 10),
            "check",
        ),
        "failure",
    );
    testing::assert_eq(failure.minimal, 10);
    println("proptest consumer: ok")
}
