package tests;

use ecosystem::proptest;
use std::testing;

struct Model {
    count: isize,
}

struct System {
    count: Ref[isize],
}

#[test]
fn downstream_state_machine_campaign_and_custom_formatting() -> () {
    let closed = Ref::new(0);
    let machine = testing::expect_ok(
        proptest::StateMachine::new(
            10,
            || Result::Ok((Model { count: 0 }, System { count: Ref::new(0) })),
            |model: Model, command: isize| Result::Ok(Model { count: model.count + command }),
            |system: System, command: isize| {
                system.count.set(system.count.get() + command);
                Result::Ok(())
            },
            |model: Model, system: System| if model.count == system.count.get() {
                Result::Ok(())
            } else {
                Result::Err("invariant")
            },
            |_| {
                closed.set(closed.get() + 1);
                Result::Ok(())
            },
        ),
        "machine",
    );
    let strategy = testing::expect_ok(
        proptest::stateful(
            || Model { count: 0 },
            |_| testing::expect_ok(proptest::integers(-5, 6), "commands"),
            |model: Model, command: isize| Result::Ok(Model { count: model.count + command }),
            0,
            10,
            10,
        ),
        "strategy",
    );
    let options = proptest::CampaignOptions {
        run: proptest::RunOptions {
            config: proptest::Config { cases: 25, ..proptest::Config::new(11) },
            ..proptest::RunOptions::new(11),
        },
        ..proptest::CampaignOptions::new(11),
    };
    let report = testing::expect_ok(
        proptest::run_campaign(
            strategy,
            options,
            |commands: Vec[isize]| machine.check(commands).collect(
                "length",
                commands.len().to_string(),
            ),
        ),
        "campaign",
    );
    testing::assert_eq(report.summary.status, proptest::RunStatus::Passed);
    testing::assert_eq(closed.get(), 25);
    testing::assert_eq(report.histograms[0].samples, 25);
    testing::assert(report.completed);
    let rendered = testing::expect_ok(
        report.render(|commands: Vec[isize]| f"{commands.len()} commands", 12),
        "custom render",
    );
    testing::assert(rendered.contains("25 accepted"));
    testing::assert(rendered.contains("\"length\" (25 samples)"));
}
