package tests;

use ecosystem::proptest;
use std::testing;

struct Strategy {}

impl proptest::Strategy for Strategy {
    type Item = (string, isize);

    fn generate(self: Strategy, seed: u64, size: isize) -> Result[
        proptest::Sample[(string, isize)],
        string,
    ] {
        Result::Ok(proptest::Sample::leaf((seed.to_string(), size)))
    }
}

#[test]
fn imported_associated_type_and_closure() -> () {
    let expected_size = 64;
    testing::assert_none(
        testing::expect_ok(
            proptest::check(
                Strategy {},
                proptest::Config::new(37),
                |value: (string, isize)| {
                    value.0 != "" && value.1 == expected_size
                },
            ),
            "custom strategy",
        ),
    );
}

#[test]
fn downstream_lazy_shrinks_and_structured_reports() -> () {
    let visits = Ref::new(0);
    let generator = proptest::Generator::new(
        |_, _| {
            Result::Ok(
                proptest::Sample::lazy(
                    10,
                    || {
                        let first = Ref::new(true);
                        proptest::Candidates::from_fn(
                            |budget| {
                                if !first.get() || !budget.consume(2) {
                                    return Option::None
                                }
                                first.set(false);
                                visits.set(visits.get() + 1);
                                Option::Some(proptest::Sample::leaf(1))
                            },
                        )
                    },
                ),
            )
        },
    );
    let report = testing::expect_ok(
        proptest::run(
            generator,
            proptest::RunOptions::new(1),
            |value: isize| {
                proptest::Case::fail(value.to_string()).classify(value > 0, "positive")
            },
        ),
        "structured runner",
    );
    testing::assert_eq(report.status, proptest::RunStatus::Failed);
    testing::assert_eq(testing::expect_some(report.failure, "failure").minimal, 1);
    testing::assert_eq(visits.get(), 1);
    testing::assert(report.labels == Vec::from_array([("positive", 1)]));
    let entry = testing::expect_some(report.replay, "replay");
    let encoded = testing::expect_ok(
        proptest::encode_replays("consumer", Vec::from_array([entry])),
        "encode",
    );
    testing::assert(
        testing::expect_ok(proptest::decode_replays("consumer", encoded), "decode")
            == Vec::from_array([entry]),
    );
}
