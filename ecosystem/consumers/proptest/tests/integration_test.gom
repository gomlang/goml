package tests;

use ecosystem::proptest;
use std::testing;

struct Strategy {}

impl proptest::Strategy for Strategy {
    type Item = (string, isize);

    fn generate(self: Strategy, seed: u64, size: isize) -> Result[
        proptest::Sample[(string, isize)],
        string,
    ] {
        Result::Ok(proptest::Sample::leaf((seed.to_string(), size)))
    }
}

#[test]
fn imported_associated_type_and_closure() -> () {
    let expected_size = 64;
    testing::assert_none(
        testing::expect_ok(
            proptest::check(
                Strategy {},
                proptest::Config::new(37),
                |value: (string, isize)| {
                    value.0 != "" && value.1 == expected_size
                },
            ),
            "custom strategy",
        ),
    );
}
