package main;

use ecosystem::highlight;
use ecosystem::rope;
use ecosystem::ansi;
use std::context;
use std::env;
use std::io;
use std::testing;

pub fn exercise() -> highlight::Document {
    let ctx = context::Context::background();
    let engine = testing::expect_ok(
        highlight::Highlighter::new(highlight::Options::new()),
        "engine",
    );
    let source = "# GoML preview\n```goml\nlet answer = 42;\n```\n";
    let text = testing::expect_ok(rope::Rope::from_string(source), "rope");
    let old = testing::expect_ok(engine.document("markdown", text.to_string(), ctx), "highlight");
    let prefix = "Welcome\n\n";
    let text = testing::expect_ok(text.insert_bytes(0, prefix), "edit rope");
    let update = testing::expect_ok(old.replace(0, 0, prefix, ctx), "edit highlighting");
    testing::assert_eq(update.document.source(), text.to_string());
    testing::assert(update.reused_lines >= old.line_count());
    let rebuilt = testing::expect_ok(
        engine.document("markdown", text.to_string(), ctx),
        "full rebuild",
    );
    testing::assert(update.document.spans() == rebuilt.spans());
    let code = testing::expect_some(update.document.line(4), "embedded GoML");
    testing::assert_eq(code.spans()[0].scope, highlight::Scope::Keyword);
    update.document
}

fn main() -> () {
    let document = exercise();
    let arguments = env::args();
    let html = arguments.len() > 1 && arguments[1] == "--html";
    let output = if html {
        testing::expect_ok(document.to_html(65536), "HTML")
    } else {
        testing::expect_ok(
            document.to_ansi(highlight::Theme::dark(), ansi::Profile::Plain, 65536),
            "preview",
        )
    };
    io::println(output);
}
