package tests;

use consumer::bigint;
use ecosystem::bigint::{BigInt, BigUint};
use std::testing;

#[test]
fn versioned_coefficient_consumer() -> () {
    bigint::exercise();
}

#[test]
fn versioned_dependency_preserves_public_arithmetic_and_errors() -> () {
    let negative = BigInt::from_sign_magnitude(
        true,
        testing::expect_ok(BigUint::pow10(50), "power of ten"),
    );
    let (q, r) = testing::expect_ok(
        negative.div_rem_euclid(BigInt::from_u64(3)),
        "euclidean consumer divide",
    );
    testing::assert_eq(r.to_string(), "2");
    testing::assert(q.mul(BigInt::from_u64(3)).add(r) == negative);
    testing::assert_err(negative.shl(-1));
}
