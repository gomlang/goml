package main;

use ecosystem::bigint::{BigInt, BigUint, Error};
use std::testing;
use std::env;
use std::io;
use std::num;
use std::encoding::hex;
use std::json;
use std::bytes;

fn signed(text: string) -> BigInt {
    testing::expect_ok(BigInt::parse(text), "signed input")
}

fn unsigned(text: string) -> BigUint {
    testing::expect_ok(BigUint::parse(text), "unsigned input")
}

fn index(text: string) -> isize {
    testing::expect_ok(num::parse_int_structured(text), "index input")
}

fn outcome[T: ToString](value: Result[T, Error]) -> string {
    match value {
        Ok(value) => value.to_string(),
        Err(_) => "error",
    }
}

fn signed_pair(value: Result[(BigInt, BigInt), Error]) -> string {
    match value {
        Ok((q, r)) => q.to_string() + "\t" + r.to_string(),
        Err(_) => "error\terror",
    }
}

pub fn exercise() -> () {
    let cents = signed("123456789012345678901234567890");
    let multiplier = BigInt::from_u64(100);
    let expanded = cents.mul(multiplier);
    let (original, remainder) = testing::expect_ok(
        expanded.div_rem(multiplier),
        "recover coefficient",
    );
    testing::assert(original == cents && remainder.is_zero());
    let encoded = testing::expect_ok(json::try_to_string(expanded), "exact JSON integer");
    let decoded: BigInt = testing::expect_ok(json::from_string(encoded), "decode JSON integer");
    testing::assert(decoded == expanded);
    let values: HashMap[BigInt, string] = HashMap::new();
    values.set(cents, "exact coefficient");
    testing::assert(values.get(original) == Option::Some("exact coefficient"));
}

fn arithmetic(fields: Vec[string]) -> string {
    let a = signed(fields[1]);
    let b = signed(fields[2]);
    let shift = index(fields[3]);
    let radix = index(fields[4]);
    let exponent = unsigned(fields[5]);
    let modulus = unsigned(fields[6]);
    let values = Vec::from_array(
        [
            a.add(b).to_string(),
            a.sub(b).to_string(),
            a.mul(b).to_string(),
            signed_pair(a.div_rem(b)),
            signed_pair(a.div_rem_euclid(b)),
            a.bitand(b).to_string(),
            a.bitor(b).to_string(),
            a.bitxor(b).to_string(),
            a.bitnot().to_string(),
            outcome(a.shl(shift)),
            outcome(a.shr(shift)),
            a.gcd(b).to_string(),
            a.lcm(b).to_string(),
            outcome(a.to_radix(radix)),
            hex::encode(bytes::Bytes::from_vec(a.to_signed_bytes_be())),
            hex::encode(bytes::Bytes::from_vec(a.abs().to_bytes_be())),
            outcome(a.modpow(exponent, modulus)),
            match a.cmp(b) {
                Ordering::Less => "-1",
                Ordering::Equal => "0",
                Ordering::Greater => "1",
            },
        ],
    );
    values.join("\t")
}

fn oracle() -> () {
    let input = testing::expect_ok(io::read_stdin_to_string(), "oracle input");
    for line in input.split("\n") {
        if line == "" {
            continue;
        }
        let fields = line.split("\t");
        let output = match fields[0] {
            "arithmetic" => arithmetic(fields),
            "parse" => outcome(BigInt::parse_radix(fields[1], index(fields[2]))),
            "pow" => outcome(signed(fields[1]).pow(index(fields[2]).to_u64())),
            "bytes" => {
                let bytes = testing::expect_ok(hex::decode(fields[1]), "byte input");
                outcome(BigInt::from_signed_bytes_be(bytes.as_slice())) + "\t"
                    + outcome(BigUint::from_bytes_be(bytes.as_slice()))
            },
            _ => "unknown",
        };
        println(output);
    }
}

fn main() -> () {
    let args = env::args();
    if args.len() > 1 && args[1] == "--oracle" {
        oracle();
    } else {
        exercise();
        println("bigint consumer: ok");
    }
}

pub fn reference_case(line: string) -> string {
    let fields = line.split("\t");
    match fields[0] {
        "arithmetic" => arithmetic(fields),
        "parse" => outcome(BigInt::parse_radix(fields[1], index(fields[2]))),
        "pow" => outcome(signed(fields[1]).pow(index(fields[2]).to_u64())),
        "bytes" => {
            let bytes = testing::expect_ok(hex::decode(fields[1]), "byte input");
            outcome(BigInt::from_signed_bytes_be(bytes.as_slice())) + "\t"
                + outcome(BigUint::from_bytes_be(bytes.as_slice()))
        },
        _ => "unknown",
    }
}
