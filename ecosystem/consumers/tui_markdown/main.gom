package main;

use ecosystem::tui_markdown;
use ecosystem::tui;
use ecosystem::ansi;
use ecosystem::terminal;
use std::testing;
use std::io;
use std::env;
use std::context;
use std::num;
use std::bytes;
use std::encoding::hex;
use std::utf8;
use utf8::BytesUtf8;

fn source() -> string {
    "# Markdown Viewer\n\nHello **GoML** and 界👩‍💻.\n\n- first item\n- second item\n\n[Guide](https://example.org/guide)\n\n| Name | Value |\n| --- | ---: |\n| GoML | 界 |\n\n```gom\nlet ready = true;\n```\n\n> Safe terminal text\n\nLast paragraph."
}

pub fn exercise() -> () {
    let viewer = testing::expect_ok(
        tui_markdown::Viewer::new(source(), tui_markdown::Options::defaults(30)),
        "viewer",
    );
    let buffer = testing::expect_ok(tui::Buffer::new(30, 6), "buffer");
    testing::expect_ok(viewer.draw(buffer, buffer.area()), "render");
    testing::assert(buffer.lines()[0].contains("Markdown Viewer"));
    testing::assert_eq(testing::expect_ok(viewer.search("GoML"), "search"), 2);
    testing::expect_ok(viewer.select_link(0), "link");
    testing::assert_eq(
        testing::expect_some(viewer.selected_link(), "selection").url,
        "https://example.org/guide",
    );
    testing::expect_ok(buffer.validate(), "cells");
}

pub fn table() -> () {
    let value = testing::expect_ok(
        tui_markdown::layout(
            "Name | Value\n--- | ---:\na | 界",
            tui_markdown::Options { pipe_tables: true, ..tui_markdown::Options::defaults(21) },
        ),
        "table",
    );
    testing::assert(value.plain_text().contains("┼"));
    let plain = testing::expect_ok(value.render_ansi(ansi::Profile::Plain, true), "plain");
    testing::assert(!plain.contains("\u001b"));
}

fn oracle() -> () {
    for line in testing::expect_ok(io::read_stdin_to_string(), "stdin").split("\n") {
        if line == "" {
            continue
        }
        let fields = line.split("\t");
        let width = testing::expect_ok(num::parse_int_structured(fields[0]), "width");
        let source = testing::expect_ok(
            testing::expect_ok(hex::decode(fields[2]), "hex").to_string_utf8(),
            "UTF8",
        );
        let options = tui_markdown::Options {
            pipe_tables: fields[1] == "table",
            ..tui_markdown::Options::defaults(width),
        };
        let result = testing::expect_ok(tui_markdown::layout(source, options), "layout");
        println(
            hex::encode(bytes::Bytes::from_vec(result.plain_text().to_bytes())) + "\t"
                + result.lines.len().to_string()
                + "\t"
                + result.links.len().to_string(),
        );
    }
}

fn interactive() -> Result[(), tui::Error] {
    let session = terminal::Session::open(terminal::Options::interactive()).map_err(
        |error| tui::Error { message: error.to_string() },
    )?;
    defer {
        let _ = session.close();
    };
    let screen = tui::Terminal::new(session)?;
    let viewer = tui_markdown::Viewer::new(
        source(),
        tui_markdown::Options {
            pipe_tables: true,
            ..tui_markdown::Options::defaults(screen.area().width),
        },
    ).map_err(|error| tui::Error { message: error.to_string() })?;
    loop {
        screen.draw(
            |buffer| viewer.draw(buffer, buffer.area()).map_err(
                |error| tui::Error { message: error.to_string() },
            ),
        )?;
        if let Some(event) = screen.next_event(context::Context::background(), 1000)? {
            if let terminal::Event::Key(key) = event {
                if key.code == terminal::KeyCode::Escape {
                    break
                }
            }
            viewer.update(event).map_err(|error| tui::Error { message: error.to_string() })?;
        }
    }
    screen.close()
}

fn main() -> () {
    let args = env::args();
    if args.len() > 1 && args[1] == "--oracle" {
        oracle();
    } else if args.len() > 1 && args[1] == "--pty" {
        testing::expect_ok(interactive(), "PTY viewer");
    } else {
        exercise();
        table();
        println(
            "tui_markdown: CommonMark layout, Unicode viewport, links, search and pipe tables passed",
        );
    }
}
