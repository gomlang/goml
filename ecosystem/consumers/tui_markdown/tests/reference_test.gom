package tests;

use ecosystem::verification::reference;
use std::encoding::hex;
use std::num;
use std::bytes;
use std::testing;
use std::utf8;
use utf8::BytesUtf8;

#[test]
fn independent_block_table_link_and_wrapping_reference() -> () {
    let fixture = reference::load();
    let output = testing::expect_ok(
        reference::run(
            "tui_markdown",
            "--oracle",
            reference::text(reference::field(fixture, "input")),
        ),
        "Markdown TUI reference protocol",
    );
    let rows = output.trim_end().split("\n");
    let expected = reference::array(reference::field(fixture, "expected"));
    testing::assert_eq(rows.len(), expected.len());
    for index in 0..rows.len() {
        let wanted = reference::array(expected[index]);
        let fields = rows[index].split("\t");
        testing::assert_eq(fields.len(), 3);
        let text = testing::expect_ok(
            testing::expect_ok(hex::decode(fields[0]), "text hex").to_string_utf8(),
            "text UTF-8",
        );
        testing::assert_eq(text, reference::text(wanted[1]));
        testing::assert_eq(
            testing::expect_ok(num::parse_int_structured(fields[1]), "line count"),
            reference::integer(wanted[2]),
        );
        testing::assert_eq(
            testing::expect_ok(num::parse_int_structured(fields[2]), "link count"),
            reference::integer(wanted[3]),
        );
    }
}

fn repeated(value: string, count: isize) -> string {
    let mut block = value;
    let mut count = count;
    let mut result = "";
    while count > 0 {
        if count % 2 == 1 {
            result += block;
        }
        count /= 2;
        if count > 0 {
            block += block;
        }
    }
    result
}

#[test]
fn reference_protocol_rejects_all_eight_resource_boundaries() -> () {
    let many_columns = "| " + repeated("x | ", 32) + "\n";
    let delimiters = "| " + repeated(":--- | ", 32) + "\n";
    let rows = "| a | b |\n| :--- | :--- |\n";
    let requests = Vec::from_array(
        [
            (0, "normal", "x"),
            (-1, "normal", "x"),
            (4097, "normal", "x"),
            (80, "normal", repeated("x", 1048577)),
            (1, "normal", repeated("x", 65537)),
            (10, "table", rows + repeated("| a | b |\n", 257)),
            (65, "table", many_columns + delimiters + repeated(many_columns, 64)),
            (80, "table", rows + "| " + repeated("x", 65537) + " | y |\n"),
        ],
    );
    for (width, mode, source) in requests {
        let request = width.to_string() + "\t" + mode + "\t"
            + hex::encode(bytes::Bytes::from_string(source))
            + "\n";
        let result = testing::expect_ok(
            reference::output("tui_markdown", "--oracle", request),
            "rejected protocol",
        );
        testing::assert(result.status().code() == Option::Some(101));
        testing::assert_eq(testing::expect_ok(result.stdout().to_string_utf8(), "stdout"), "");
        testing::assert_eq(
            testing::expect_ok(result.stderr().to_string_utf8(), "stderr"),
            "layout\n",
        );
    }
}
