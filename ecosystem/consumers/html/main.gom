package main;

use ecosystem::html;
use std::testing;

#[go_ffi("html", "UnescapeString")]
extern fn go_unescape(value: string) -> string;

#[go_ffi("html", "EscapeString")]
extern fn go_escape(value: string) -> string;

fn check_escape(value: string) -> () {
    let expected = go_escape(value);
    let escaped = testing::expect_ok(
        html::escape(value, expected.byte_len()),
        "escape differential",
    );
    testing::assert_eq(escaped, expected);
    testing::assert_eq(
        testing::expect_ok(html::unescape(escaped, value.byte_len()), "escape roundtrip"),
        value,
    );
    if expected.byte_len() > 0 {
        match html::escape(value, expected.byte_len() - 1) {
            Err(html::Error::LimitExceeded(limit)) => testing::assert_eq(
                limit,
                expected.byte_len() - 1,
            ),
            _ => testing::fail("escape must reject insufficient output limit"),
        }
    }
}

fn check_unescape(value: string) -> () {
    let expected = go_unescape(value);
    check_unescape_expected(value, expected);
}

fn check_unescape_expected(value: string, expected: string) -> () {
    testing::assert_eq(
        testing::expect_ok(
            html::unescape(value, expected.byte_len()),
            "unescape boundary differential",
        ),
        expected,
    );
    if expected.byte_len() > 0 {
        match html::unescape(value, expected.byte_len() - 1) {
            Err(html::Error::LimitExceeded(limit)) => testing::assert_eq(
                limit,
                expected.byte_len() - 1,
            ),
            _ => testing::fail("unescape must reject insufficient output limit"),
        }
    }
}

fn check_html_boundaries() -> () {
    let mut ascii = "";
    for code in 0..128 {
        let character = testing::expect_some(char_from_u32(code.to_u32()), "ASCII scalar");
        check_escape(character.to_string());
        ascii += character.to_string();
    }
    check_escape(ascii);
    for value in[
        "",
        "<>&'\"",
        "\u0000",
        "界🙂é",
        "e\u0301",
        "&amp;&lt;&#39;&#x1f642;",
        "&&&&",
        "\r\n\t",
        "x<'界🙂'>&y",
    ] {
        check_escape(value);
    }
    for digits in[
        "10",
        "13",
        "127",
        "128",
        "129",
        "159",
        "160",
        "55295",
        "55296",
        "57343",
        "57344",
        "65534",
        "65535",
        "65536",
        "1114111",
        "1114112",
        "2147483647",
        "x0",
        "X1",
        "x7f",
        "x80",
        "X9F",
        "xa0",
        "xd7ff",
        "xD800",
        "xDFFF",
        "xE000",
        "xFDD0",
        "xFFFE",
        "xFFFF",
        "x10000",
        "x10FFFF",
        "x110000",
        "x7FFFFFFF",
        "x000041",
        "000065",
    ] {
        for suffix in[";", ";tail", "!", "&amp;"] {
            check_unescape("&#" + digits + suffix);
        }
    }
    for value in[
        "&",
        "&&",
        "&#",
        "&#;",
        "&#-1;",
        "&#+1;",
        "&#x-1;",
        "&#xg;",
        "&AMP;",
        "&Amp;",
        "&notin;",
        "&notit;",
        "&amp;lt;",
        "&amp;#65;",
        "&NotEqualTilde;",
        "&CounterClockwiseContourIntegral;",
        "界&amp;🙂&#x41;",
        "&unknown" + "z".repeat(4096) + ";&amp;",
        "&not" + "z".repeat(4096) + ";&lt;",
        "&CounterClockwiseContourIntegral" + "z".repeat(4096) + ";",
    ] {
        check_unescape(value);
    }
    for digit in 0..10 {
        let reference = "&#" + digit.to_string();
        let decoded = if digit == 0 {
            "�"
        } else {
            testing::expect_some(char_from_u32(digit.to_u32()), "numeric control").to_string()
        };
        for suffix in[";", ";tail"] {
            check_unescape(reference + suffix);
        }
        for (suffix, tail) in[("", ""), ("!", "!"), ("&amp;", "&"), ("=x", "=x"), ("界", "界")] {
            check_unescape_expected(reference + suffix, decoded + tail);
        }
    }
    for prefix in["&#x;", "&#X;"] {
        for (suffix, tail) in[("", ""), ("tail", "tail"), ("&amp;", "&")] {
            check_unescape_expected(prefix + suffix, prefix + tail);
        }
    }
    for (value, expected) in[
        ("&#1", "\u0001"),
        ("&#0", "�"),
        ("&#x1", "\u0001"),
        ("&#4294967361;", "�"),
        ("&#x100000041;", "�"),
        ("&#" + "9".repeat(256) + ";", "�"),
        ("&#x" + "f".repeat(256) + ";", "�"),
    ] {
        check_unescape_expected(value, expected);
    }
}

pub fn exercise() -> () {
    check_html_boundaries();
    for code in 0..1024 {
        let input = "&#" + code.to_string() + ";";
        testing::assert_eq(
            testing::expect_ok(html::unescape(input, 100), "numeric differential"),
            go_unescape(input),
        );
    }
    for name in[
        "amp",
        "not",
        "notin",
        "CounterClockwiseContourIntegral",
        "NotEqualTilde",
        "unknown",
    ] {
        for suffix in["", ";", "!", "=", "x", ";&amp;"] {
            let input = "&" + name + suffix;
            testing::assert_eq(
                testing::expect_ok(html::unescape(input, 100), "named differential"),
                go_unescape(input),
            );
        }
    }
    testing::assert_eq(testing::expect_some(html::named_entity("amp"), "entity lookup"), "&");
    testing::assert_eq(
        testing::expect_ok(html::escape("<p>\"尾\"</p>", 100), "HTML escape"),
        "&lt;p&gt;&#34;尾&#34;&lt;/p&gt;",
    );
    testing::assert_eq(html::escape_text("'\""), "'&quot;");
}

fn main() -> () {
    exercise();
    println("html consumer: ok")
}
