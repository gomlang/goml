package main;

use ecosystem::unicode_text as unicode;
use std::env;
use std::io;
use std::json;
use std::process;
use std::testing;

fn numbers(values: Vec[isize]) -> json::Value {
    let result = Vec::new();
    for value in values {
        result.push(json::Value::Number(value.to_string()));
    }
    json::Value::Array(result)
}

fn evaluate(value: json::Value) -> Result[json::Value, string] {
    let input = json::field(value, "text").and_then(|field| json::as_string(field)).ok_or(
        "missing text",
    )?;
    let kind = json::field(value, "kind").and_then(|field| json::as_string(field)).unwrap_or(
        "grapheme",
    );
    if kind == "grapheme" {
        return Result::Ok(numbers(unicode::grapheme_boundaries(input)));
    }
    if kind == "word" {
        return Result::Ok(numbers(unicode::word_boundaries(input)));
    }
    if kind == "line" {
        let boundaries = Vec::new();
        for boundary in unicode::line_breaks(input) {
            boundaries.push(boundary.offset);
        }
        return Result::Ok(numbers(boundaries));
    }
    if kind == "width" {
        let options = unicode::WidthOptions {
            ambiguous_wide: json::field(value, "ambiguous").and_then(|field| json::as_bool(field)).unwrap_or(
                false,
            ),
            emoji_wide: json::field(value, "emoji").and_then(|field| json::as_bool(field)).unwrap_or(
                true,
            ),
        };
        return Result::Ok(json::Value::Number(unicode::width_with(input, options).to_string()));
    }
    Result::Err("unknown operation")
}

pub fn exercise() -> () {
    testing::assert_eq(unicode::UNICODE_VERSION, "16.0.0");
    let value = "GoML 👩🏽‍💻 中 é";
    testing::assert_eq(unicode::width(value), 12);
    testing::assert_eq(unicode::graphemes("é👩🏽‍💻🇨🇳").len(), 3);
    testing::assert_eq(unicode::truncate("界é👩🏽‍💻", 3), "界é");
    testing::assert(unicode::wrap("hello world", 5) == Vec::from_array(["hello", "world"]));
    println("unicode_text consumer: ok");
}

fn main() -> () {
    if env::args().len() > 1 {
        let result = run_json();
        if let Err(message) = result {
            io::eprintln(message);
            process::exit(1);
        }
    } else {
        exercise();
    }
}

fn run_json() -> Result[(), string] {
    let input = io::read_stdin_to_string().map_err(|error| error.to_string())?;
    let cases = json::as_array(json::parse(input)?).ok_or("expected array")?;
    let output = Vec::new();
    for value in cases {
        output.push(evaluate(value)?);
    }
    print(json::encode(json::Value::Array(output)));
    Result::Ok(())
}
