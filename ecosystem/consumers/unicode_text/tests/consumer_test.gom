package tests;

use consumer::unicode_text as application;
use ecosystem::unicode_text as unicode;
use std::testing;

#[test]
fn imported_segmentation_and_terminal_layout() -> () {
    application::exercise();
    let line = testing::expect_ok(
        unicode::pad(
            "GoML 世界",
            14,
            unicode::Alignment::Right,
            unicode::WidthOptions::new(),
            unicode::LayoutLimits::new(),
        ),
        "alignment",
    );
    testing::assert_eq(unicode::width(line), 14);
    let content = unicode::graphemes("x👩🏽‍💻z");
    testing::assert_eq(content[1].start, 1);
    testing::assert_eq(content[1].end, 16);
}

#[test]
fn imported_policies_limits_and_line_breaks() -> () {
    let options = unicode::WidthOptions { ambiguous_wide: true, emoji_wide: false };
    testing::assert_eq(unicode::width_with("·😀", options), 3);
    let limits = unicode::LayoutLimits { max_input_bytes: 10, max_output_bytes: 2, max_lines: 1 };
    testing::assert_err(unicode::pad("界", 2, unicode::Alignment::Left, options, limits));
    let opportunities = unicode::line_breaks("中。文");
    testing::assert_eq(opportunities.len(), 2);
    testing::assert_eq(opportunities[0].offset, 6);
}
