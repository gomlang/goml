package tests;

use ecosystem::unicode_text as unicode;
use std::testing;

#[test]
fn terminal_width_reference_samples() -> () {
    let cases = Vec::from_array(
        [
            ("hello", 5),
            ("中文", 4),
            ("e\u0301", 1),
            ("\u0301", 0),
            ("👩🏽‍💻", 2),
            ("🇨🇳", 2),
            ("1\ufe0f\u20e3", 2),
            ("\u0000\u001b\n\t", 0),
            ("🫩", 2),
            ("\u1100\u1161\u11a8", 2),
            ("𖵩", 1),
        ],
    );
    for (text, expected) in cases {
        testing::assert_eq(unicode::width(text), expected);
    }
}
