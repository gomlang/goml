package main;

use ecosystem::ndarray;
use ecosystem::ndarray::{Array, Scalar, BinaryOp, Execution, Error, ErrorKind, SolveOptions, SliceSpec};
use std::env;
use std::io;
use std::json;
use std::math;
use std::num;
use std::process;

pub struct Complex {
    pub real: f64,
    pub imaginary: f64,
}

impl Scalar for Complex {
    fn zero() -> Complex {
        Complex { real: 0.0, imaginary: 0.0 }
    }

    fn one() -> Complex {
        Complex { real: 1.0, imaginary: 0.0 }
    }

    fn add(self: Complex, other: Complex) -> Result[Complex, Error] {
        Result::Ok(
            Complex { real: self.real + other.real, imaginary: self.imaginary + other.imaginary },
        )
    }

    fn subtract(self: Complex, other: Complex) -> Result[Complex, Error] {
        Result::Ok(
            Complex { real: self.real - other.real, imaginary: self.imaginary - other.imaginary },
        )
    }

    fn multiply(self: Complex, other: Complex) -> Result[Complex, Error] {
        Result::Ok(
            Complex {
                real: self.real * other.real - self.imaginary * other.imaginary,
                imaginary: self.real * other.imaginary + self.imaginary * other.real,
            },
        )
    }

    fn divide(self: Complex, other: Complex) -> Result[Complex, Error] {
        let denominator = other.real * other.real + other.imaginary * other.imaginary;
        if denominator == 0.0 {
            return Result::Err(Error::new(ErrorKind::Arithmetic, "zero complex denominator"))
        }
        Result::Ok(
            Complex {
                real: (self.real * other.real + self.imaginary * other.imaginary) / denominator,
                imaginary: (self.imaginary * other.real - self.real * other.imaginary) / denominator,
            },
        )
    }
}

pub struct Record {
    pub name: string,
    pub amount: isize,
}

pub fn exercise() -> Result[(), string] {
    let a = Array::from_vec(
        Vec::from_array([2]),
        Vec::from_array(
            [Complex { real: 1.0, imaginary: 2.0 }, Complex { real: 3.0, imaginary: -1.0 }],
        ),
    ).map_err(|e| e.to_string())?;
    let total = a.sum().map_err(|e| e.to_string())?;
    let squared = a.matmul(a).map_err(|e| e.to_string())?.get(Vec::new()).map_err(|e| e.to_string())?;
    let ones: Array[Complex] = Array::ones(Vec::from_array([2])).map_err(|e| e.to_string())?;
    let added = a.add(ones).map_err(|e| e.to_string())?.get_flat(1).map_err(|e| e.to_string())?;
    if total.real != 4.0 || total.imaginary != 1.0 || squared.real != 5.0
        || squared.imaginary != -2.0
        || added.real != 4.0 {
        return Result::Err("downstream Scalar default methods failed")
    }
    let records = Array::from_vec(
        Vec::from_array([1, 2]),
        Vec::from_array([Record { name: "first", amount: 3 }, Record { name: "second", amount: 7 }]),
    ).map_err(|e| e.to_string())?;
    let view = records.reversed_axes().map_err(|e| e.to_string())?;
    view.set(Vec::from_array([1, 0]), Record { name: "changed", amount: 11 }).map_err(
        |e| e.to_string(),
    )?;
    let totals = records.map(|record| record.amount.to_i64()).sum().map_err(|e| e.to_string())?;
    if totals != 14 || records.get_flat(1).map_err(|e| e.to_string())?.name != "changed" {
        return Result::Err("downstream generic shared view failed")
    }
    let a = Array::from_vec(Vec::from_array([2, 2]), Vec::from_array([3.0, 1.0, 1.0, 2.0])).map_err(
        |e| e.to_string(),
    )?;
    let b = Array::from_vec(Vec::from_array([2]), Vec::from_array([9.0, 8.0])).map_err(
        |e| e.to_string(),
    )?;
    let solution = a.solve(b, SolveOptions::standard()).map_err(|e| e.to_string())?;
    if !a.matmul(solution).map_err(|e| e.to_string())?.all_close(b, 1e-12, 1e-12, false).map_err(
        |e| e.to_string(),
    )? {
        return Result::Err("downstream solve failed")
    }
    let values = ndarray::linspace(1.0, 10.0, 17, true).map_err(|e| e.to_string())?;
    for op in Vec::from_array(
        [BinaryOp::Add, BinaryOp::Subtract, BinaryOp::Multiply, BinaryOp::Divide],
    ) {
        let native = values.binary_with(values, op, Execution::Simd).map_err(|e| e.to_string())?;
        let scalar = values.binary_with(values, op, Execution::Scalar).map_err(|e| e.to_string())?;
        if !native.all_close(scalar, 0.0, 0.0, false).map_err(|e| e.to_string())? {
            return Result::Err("native arithmetic differs")
        }
        let narrow = values.map(|value| value.to_f32());
        if narrow.binary_with(narrow, op, Execution::Simd).map_err(|e| e.to_string())?.to_vec()
            != narrow.binary_with(narrow, op, Execution::Scalar).map_err(|e| e.to_string())?.to_vec() {
            return Result::Err("native f32 differs")
        }
    }
    let narrow = values.map(|value| value.to_f32());
    let _ = narrow.matmul_with(narrow, Execution::Simd).map_err(|e| e.to_string())?;
    Result::Ok(())
}

fn bad(message: string) -> Error {
    Error::new(ErrorKind::Shape, message)
}

fn field(request: json::Value, name: string) -> json::Value {
    json::field(request, name).unwrap_or(json::Value::Null)
}

fn integer(request: json::Value, name: string, fallback: isize) -> isize {
    json::as_int(field(request, name)).unwrap_or(fallback)
}

fn flag(request: json::Value, name: string) -> bool {
    json::as_bool(field(request, name)).unwrap_or(false)
}

fn text_field(request: json::Value, name: string) -> string {
    json::as_string(field(request, name)).unwrap_or("")
}

fn indices(value: json::Value) -> Result[Vec[isize], Error] {
    let values = json::as_array(value).ok_or(bad("expected index array"))?;
    let result = Vec::new();
    for value in values {
        result.push(json::as_int(value).ok_or(bad("expected integer"))?);
    }
    Result::Ok(result)
}

fn number(value: json::Value) -> Result[f64, Error] {
    match value {
        json::Value::Number(value) => num::parse_float64_structured(value).map_err(
            |_| bad("invalid number"),
        ),
        json::Value::String(value) => match value {
            "nan" => Result::Ok(float64_from_bits(0x7ff8000000000000)),
            "inf" => Result::Ok(float64_from_bits(0x7ff0000000000000)),
            "-inf" => Result::Ok(float64_from_bits(0xfff0000000000000)),
            _ => Result::Err(bad("invalid special number")),
        },
        _ => Result::Err(bad("expected number")),
    }
}

fn decode(value: json::Value) -> Result[Array[f64], Error] {
    let shape = indices(field(value, "shape"))?;
    let values = Vec::new();
    for item in json::as_array(field(value, "data")).ok_or(bad("expected data"))? {
        values.push(number(item)?);
    }
    let result = Array::from_vec(shape, values)?;
    transform(result, field(value, "views"))
}

fn transform(input: Array[f64], views: json::Value) -> Result[Array[f64], Error] {
    let mut result = input;
    for view in json::as_array(views).unwrap_or(Vec::new()) {
        result = match text_field(view, "op") {
            "slice" => result.slice(
                integer(view, "axis", 0),
                SliceSpec {
                    start: json::as_int(field(view, "start")),
                    stop: json::as_int(field(view, "stop")),
                    step: integer(view, "step", 1),
                },
            )?,
            "transpose" => result.transpose(indices(field(view, "axes"))?)?,
            "reshape" => result.reshape(indices(field(view, "shape"))?)?,
            "reshape_view" => result.reshape_view(indices(field(view, "shape"))?)?,
            "broadcast" => result.broadcast_to(indices(field(view, "shape"))?)?,
            "index" => result.index_axis(integer(view, "axis", 0), integer(view, "index", 0))?,
            "insert" => result.insert_axis(integer(view, "axis", 0))?,
            "squeeze" => result.squeeze()?,
            "diagonal" => result.diagonal(
                integer(view, "offset", 0),
                integer(view, "first", 0),
                integer(view, "second", 1),
            )?,
            "take" => result.take(integer(view, "axis", 0), indices(field(view, "indices"))?)?,
            _ => return Result::Err(bad("unknown view")),
        };
    }
    Result::Ok(result)
}

fn encode_number(value: f64) -> json::Value {
    if math::is_nan(value) {
        json::Value::String("nan")
    } else if math::is_infinite(value) {
        json::Value::String(
            if value < 0.0 {
                "-inf"
            } else {
                "inf"
            },
        )
    } else {
        json::Value::Number(value.to_string())
    }
}

fn encode(array: Array[f64]) -> json::Value {
    let shape = Vec::new();
    for dimension in array.shape() {
        shape.push(json::Value::Number(dimension.to_string()));
    }
    let data = Vec::new();
    for value in array.to_vec() {
        data.push(encode_number(value));
    }
    json::Value::Object(
        Vec::from_array([("shape", json::Value::Array(shape)), ("data", json::Value::Array(data))]),
    )
}

fn operation(name: string) -> Result[BinaryOp, Error] {
    match name {
        "add" => Result::Ok(BinaryOp::Add),
        "subtract" => Result::Ok(BinaryOp::Subtract),
        "multiply" => Result::Ok(BinaryOp::Multiply),
        "divide" => Result::Ok(BinaryOp::Divide),
        _ => Result::Err(bad("unknown binary operation")),
    }
}

fn execute(request: json::Value) -> Result[json::Value, Error] {
    let mode = text_field(request, "op");
    if mode == "linspace" {
        return Result::Ok(
            encode(
                ndarray::linspace(
                    number(field(request, "start"))?,
                    number(field(request, "stop"))?,
                    integer(request, "count", 0),
                    flag(request, "endpoint"),
                )?,
            ),
        )
    }
    let a = decode(field(request, "a"))?;
    let execution = if flag(request, "scalar") {
        Execution::Scalar
    } else {
        Execution::Simd
    };
    let options = SolveOptions::standard();
    let result = match mode {
        "view" => a,
        "add" | "subtract" | "multiply" | "divide" => a.binary_with(
            decode(field(request, "b"))?,
            operation(mode)?,
            execution,
        )?,
        "matmul" => a.matmul_with(decode(field(request, "b"))?, execution)?,
        "sum" => a.sum_axes(indices(field(request, "axes"))?, flag(request, "keep"))?,
        "product" => a.product_axes(indices(field(request, "axes"))?, flag(request, "keep"))?,
        "mean" => a.mean_axes(indices(field(request, "axes"))?, flag(request, "keep"))?,
        "variance" => a.variance_axes(
            indices(field(request, "axes"))?,
            flag(request, "keep"),
            integer(request, "ddof", 0),
        )?,
        "min" => a.min_axes(indices(field(request, "axes"))?, flag(request, "keep"))?,
        "max" => a.max_axes(indices(field(request, "axes"))?, flag(request, "keep"))?,
        "solve" => a.solve(decode(field(request, "b"))?, options)?,
        "inverse" => a.inverse(options)?,
        "det" => Array::scalar(a.determinant()?),
        "slogdet" => {
            let pair = a.slogdet()?;
            Array::from_vec(Vec::from_array([2]), Vec::from_array([pair.0, pair.1]))?
        },
        "cholesky" => a.cholesky(options)?.lower(),
        "cholesky_solve" => a.cholesky(options)?.solve(decode(field(request, "b"))?)?,
        "least_squares" => a.least_squares(decode(field(request, "b"))?, options)?,
        "qr" => {
            let qr = a.qr(options)?;
            return Result::Ok(
                json::Value::Object(Vec::from_array([("q", encode(qr.q())), ("r", encode(qr.r()))])),
            )
        },
        "lu" => {
            let lu = a.lu(options)?;
            let permutation = Vec::new();
            for index in lu.permutation() {
                permutation.push(json::Value::Number(index.to_string()));
            }
            return Result::Ok(
                json::Value::Object(
                    Vec::from_array(
                        [
                            ("lower", encode(lu.lower())),
                            ("upper", encode(lu.upper())),
                            ("permutation", json::Value::Array(permutation)),
                        ],
                    ),
                ),
            )
        },
        "norm" => Array::scalar(a.norm()),
        "sqrt" => a.sqrt(),
        "exp" => a.exp(),
        "log" => a.log(),
        "abs" => a.abs(),
        "clip" => a.clip(number(field(request, "lower"))?, number(field(request, "upper"))?)?,
        "concat" => ndarray::concatenate(
            Vec::from_array([a, decode(field(request, "b"))?]),
            integer(request, "axis", 0),
        )?,
        "stack" => ndarray::stack(
            Vec::from_array([a, decode(field(request, "b"))?]),
            integer(request, "axis", 0),
        )?,
        "assign" => {
            let destination = transform(a, field(request, "destination"))?;
            let source = transform(a, field(request, "source"))?;
            destination.assign(source)?;
            a
        },
        _ => return Result::Err(bad("unknown operation")),
    };
    Result::Ok(encode(result))
}

fn run() -> Result[(), string] {
    if env::args().len() == 1 {
        exercise()?;
        println("ndarray consumer: ok");
        return Result::Ok(())
    }
    let input = io::read_stdin_to_string().map_err(|e| e.to_string())?;
    let requests = json::as_array(json::parse(input)?).ok_or("expected request array")?;
    let results = Vec::new();
    for request in requests {
        results.push(
            match execute(request) {
                Ok(value) => value,
                Err(error) => json::Value::Object(
                    Vec::from_array(
                        [
                            ("error", json::Value::String(error.kind.debug())),
                            ("message", json::Value::String(error.message)),
                        ],
                    ),
                ),
            },
        );
    }
    println(json::encode(json::Value::Array(results)));
    Result::Ok(())
}

fn main() -> () {
    if let Err(message) = run() {
        io::eprintln(message);
        process::exit(1);
    }
}
