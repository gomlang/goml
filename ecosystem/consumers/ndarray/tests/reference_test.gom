package tests;

use consumer::ndarray as application;
use std::testing;
use std::fs;
use std::json;
use std::num;
use std::math;
use std::collections::{HashSet};

fn field(value: json::Value, name: string) -> json::Value {
    testing::expect_some(json::field(value, name), "reference field " + name)
}

fn list(value: json::Value) -> Vec[json::Value] {
    testing::expect_some(json::as_array(value), "reference array")
}

fn number(value: json::Value) -> f64 {
    match value {
        json::Value::Number(value) => testing::expect_ok(
            num::parse_float64_structured(value),
            "reference number",
        ),
        json::Value::String(value) => match value {
            "nan" => float64_from_bits(0x7ff8000000000000),
            "inf" => float64_from_bits(0x7ff0000000000000),
            "-inf" => float64_from_bits(0xfff0000000000000),
            _ => {
                testing::assert(false);
                0.0
            },
        },
        _ => {
            testing::assert(false);
            0.0
        },
    }
}

fn close(actual: f64, expected: f64) -> () {
    if math::is_nan(expected) {
        testing::assert(math::is_nan(actual));
    } else if math::is_infinite(expected) {
        testing::assert_eq(actual, expected);
    } else {
        testing::assert(
            math::is_finite(actual)
                && absolute(actual - expected) <= 2e-11 + 2e-10 * absolute(expected),
        );
    }
}

struct Matrix {
    rows: isize,
    columns: isize,
    data: Vec[f64],
}

fn matrix(value: json::Value) -> Matrix {
    let shape = list(field(value, "shape"));
    testing::assert_eq(shape.len(), 2);
    let data = Vec::new();
    for value in list(field(value, "data")) {
        data.push(number(value));
    }
    let rows = testing::expect_some(json::as_int(shape[0]), "rows");
    let columns = testing::expect_some(json::as_int(shape[1]), "columns");
    testing::assert_eq(data.len(), rows * columns);
    Matrix { rows, columns, data }
}

fn dot(left: Matrix, right: Matrix, row: isize, column: isize) -> f64 {
    testing::assert_eq(left.columns, right.rows);
    let mut sum = 0.0;
    for index in 0..left.columns {
        sum += left.data[row * left.columns + index] * right.data[index * right.columns + column];
    }
    sum
}

fn decomposition(result: json::Value, expected: json::Value) -> () {
    let source = matrix(field(expected, "array"));
    let kind = testing::expect_some(json::as_string(field(expected, "kind")), "decomposition kind");
    if kind == "qr" {
        let q = matrix(field(result, "q"));
        let r = matrix(field(result, "r"));
        testing::assert_eq(q.rows, source.rows);
        testing::assert_eq(q.columns, source.columns);
        testing::assert_eq(r.rows, source.columns);
        testing::assert_eq(r.columns, source.columns);
        let mut scale = 0.0;
        for value in source.data {
            if absolute(value) > scale {
                scale = absolute(value);
            }
        }
        for row in 0..source.rows {
            for column in 0..source.columns {
                close(
                    dot(q, r, row, column) / scale,
                    source.data[row * source.columns + column] / scale,
                );
            }
        }
        for row in 0..q.columns {
            for column in 0..q.columns {
                let mut sum = 0.0;
                for index in 0..q.rows {
                    sum += q.data[index * q.columns + row] * q.data[index * q.columns + column];
                }
                close(
                    sum,
                    if row == column {
                        1.0
                    } else {
                        0.0
                    },
                );
                if row > column {
                    close(r.data[row * r.columns + column], 0.0);
                }
            }
        }
    } else {
        let lower = matrix(field(result, "lower"));
        let upper = matrix(field(result, "upper"));
        let permutation = list(field(result, "permutation"));
        testing::assert_eq(lower.rows, source.rows);
        testing::assert_eq(lower.columns, source.columns);
        testing::assert_eq(upper.rows, source.rows);
        testing::assert_eq(upper.columns, source.columns);
        testing::assert_eq(permutation.len(), source.rows);
        let seen: HashSet[isize] = HashSet::new();
        for row in 0..source.rows {
            let permuted = testing::expect_some(json::as_int(permutation[row]), "permutation");
            testing::assert(permuted >= 0 && permuted < source.rows && !seen.contains(permuted));
            seen.insert(permuted);
            close(lower.data[row * lower.columns + row], 1.0);
            for column in 0..source.columns {
                close(
                    dot(lower, upper, row, column),
                    source.data[permuted * source.columns + column],
                );
                if row < column {
                    close(lower.data[row * lower.columns + column], 0.0);
                }
                if row > column {
                    close(upper.data[row * upper.columns + column], 0.0);
                }
            }
        }
    }
}

#[test]
fn independent_numpy_vectors_and_matrix_factorization_invariants() -> () {
    let source = testing::expect_ok(
        fs::read_file_structured("tests/data/reference.jsonl"),
        "NumPy reference vectors",
    );
    let mut count = 0;
    for line in source.split("\n") {
        if line == "" {
            continue;
        }
        let row = testing::expect_ok(json::parse(line), "reference row");
        let expected = field(row, "expected");
        let result = application::reference_case(field(row, "input"));
        if let Some(kind) = json::field(expected, "error") {
            let kind = testing::expect_some(json::as_string(kind), "error kind");
            match result {
                Err(error) => testing::assert(error.kind.debug().ends_with(kind)),
                Ok(_) => testing::assert(false),
            }
        } else {
            let result = testing::expect_ok(result, "ndarray operation");
            if json::field(expected, "kind").is_some() {
                decomposition(result, expected);
            } else {
                testing::assert(
                    json::encode(field(result, "shape")) == json::encode(field(expected, "shape")),
                );
                let actual = list(field(result, "data"));
                let expected = list(field(expected, "data"));
                testing::assert_eq(actual.len(), expected.len());
                for index in 0..actual.len() {
                    close(number(actual[index]), number(expected[index]));
                }
            }
        }
        count += 1;
    }
    testing::assert_eq(count, 2929);
}

fn absolute(value: f64) -> f64 {
    if value < 0.0 {
        -value
    } else {
        value
    }
}
