package tests;

use ecosystem::ndarray;
use ecosystem::ndarray::{Array};
use std::testing;

#[test]
fn specialized_constructor_inference_and_explicit_owner() -> () {
    let inferred = testing::expect_ok(Array::linspace(-1.0, 1.0, 3, true), "inferred");
    testing::assert(inferred.to_vec() == Vec::from_array([-1.0, 0.0, 1.0]));
    let explicit = testing::expect_ok(Array::[f64]::linspace(0.0, 1.0, 4, false), "explicit");
    testing::assert(explicit.to_vec() == Vec::from_array([0.0, 0.25, 0.5, 0.75]));
    testing::assert_eq(
        testing::expect_ok(Array::[f64]::linspace(0.0, 1.0, 0, true), "empty").to_vec().len(),
        0,
    );
    testing::assert(Array::[f64]::linspace(0.0, 1.0, -1, true).is_err());
    testing::assert(
        Array::[f64]::linspace(float64_from_bits(0x7ff0000000000000), 1.0, 1, true).is_err(),
    );
    testing::assert(
        testing::expect_ok(ndarray::linspace(-1.0, 1.0, 3, true), "compatibility").to_vec()
            == inferred.to_vec(),
    );
}
