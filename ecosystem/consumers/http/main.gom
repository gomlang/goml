package main;

use ecosystem::http::{strip_hop_headers, dump_request, dump_response};
use std::bytes::{Bytes};
use std::testing;

pub fn exercise() -> () {
    let headers = testing::expect_ok(
        strip_hop_headers(
            Vec::from_array(
                [("Connection", "x-private"), ("X-Private", "discard"), ("X-End", "keep")],
            ),
        ),
        "hop headers",
    );
    testing::assert(headers == Vec::from_array([("x-end", "keep")]));
    let request = testing::expect_ok(
        dump_request("GET", "/hello", headers, Bytes::new(), 128),
        "request dump",
    );
    testing::assert(request.to_vec_copy() == b"GET /hello HTTP/1.1\r\nx-end: keep\r\n\r\n");
    let response = testing::expect_ok(
        dump_response(200, "OK", Vec::new(), Bytes::from_string("hello"), 128),
        "response dump",
    );
    testing::assert(response.to_vec_copy() == b"HTTP/1.1 200 OK\r\n\r\nhello");
}

fn main() -> () {
    exercise();
    println("http protocol consumer: ok");
}
