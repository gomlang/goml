package tests;

use ecosystem::tui_markdown;
use ecosystem::tui;
use ecosystem::terminal;
use std::testing;

fn key(code: terminal::KeyCode) -> terminal::Event {
    terminal::Event::Key(terminal::KeyEvent { code, modifiers: terminal::Modifiers::none() })
}

#[test]
fn viewer_scroll_resize_search_and_link_selection() -> () {
    let source = "# Heading\n\nalpha beta gamma delta epsilon\n\n[one](https://one.example)\n\nalpha again\n\n[two](https://two.example)\n\nlast";
    let viewer = testing::expect_ok(
        tui_markdown::Viewer::new(source, tui_markdown::Options::defaults(24)),
        "viewer",
    );
    let buffer = testing::expect_ok(tui::Buffer::new(24, 3), "buffer");
    testing::expect_ok(viewer.draw(buffer, buffer.area()), "draw");
    testing::expect_ok(viewer.update(key(terminal::KeyCode::PageDown)), "page");
    testing::assert_eq(viewer.scroll_offset(), 2);
    testing::assert_eq(testing::expect_ok(viewer.search("alpha"), "search"), 2);
    testing::assert(viewer.next_match(false));
    let matches = viewer.search_matches();
    testing::assert_eq(matches.len(), 2);
    testing::assert(viewer.scroll_offset() > 0);
    testing::expect_ok(viewer.select_link(1), "second link");
    testing::assert_eq(
        testing::expect_some(viewer.selected_link(), "selection").url,
        "https://two.example",
    );
    let small = testing::expect_ok(tui::Buffer::new(9, 4), "narrow");
    testing::expect_ok(viewer.draw(small, small.area()), "reflow");
    testing::assert_eq(viewer.snapshot().width, 9);
    testing::expect_ok(small.validate(), "wide cells");
    testing::expect_ok(viewer.update(key(terminal::KeyCode::Home)), "home");
    testing::assert_eq(viewer.scroll_offset(), 0);
    let snapshot = viewer.snapshot();
    snapshot.lines.clear();
    testing::assert(viewer.line_count() > 0);
}

#[test]
fn viewer_failed_replacement_preserves_document_and_highlights_search() -> () {
    let options = tui_markdown::Options {
        max_input_bytes: 64,
        ..tui_markdown::Options::defaults(12),
    };
    let viewer = testing::expect_ok(tui_markdown::Viewer::new("alpha beta", options), "viewer");
    testing::assert(viewer.set_source("x".repeat(65)).is_err());
    testing::assert_eq(viewer.snapshot().plain_text(), "alpha beta");
    testing::assert_eq(testing::expect_ok(viewer.search("beta"), "query"), 1);
    let buffer = testing::expect_ok(tui::Buffer::new(12, 2), "buffer");
    testing::expect_ok(viewer.draw(buffer, buffer.area()), "highlight");
    testing::assert_eq(
        testing::expect_some(buffer.get(6, 0), "search cell").style,
        options.theme.search,
    );
    testing::assert(viewer.search("x\ny").is_err());
    testing::assert_eq(viewer.search_matches().len(), 1);
    testing::expect_ok(viewer.set_source("new document"), "replace");
    testing::assert_eq(viewer.search_matches().len(), 0);
}

#[test]
fn selected_link_remains_visible_after_width_reflow() -> () {
    let source = "long prefix words repeated many times long prefix words repeated many times\n\n[target](https://example.org)";
    let viewer = testing::expect_ok(
        tui_markdown::Viewer::new(source, tui_markdown::Options::defaults(40)),
        "viewer",
    );
    testing::expect_ok(viewer.select_link(0), "link");
    let buffer = testing::expect_ok(tui::Buffer::new(10, 3), "narrow");
    testing::expect_ok(viewer.draw(buffer, buffer.area()), "resize");
    testing::assert(buffer.lines().join("\n").contains("target"));
}
