package tests;

use ecosystem::tui_markdown;
use ecosystem::markdown;
use ecosystem::ansi;
use ecosystem::unicode_text;
use std::testing;

fn rendered(source: string, width: isize) -> tui_markdown::Layout {
    testing::expect_ok(
        tui_markdown::layout(source, tui_markdown::Options::defaults(width)),
        "Markdown layout",
    )
}

#[test]
fn commonmark_blocks_nested_containers_and_code_snapshot() -> () {
    let value = rendered(
        "# Title\n\nHello **bold** and *em*.\n\n> quote\n>\n> - one\n> - two\n\n3. three\n4. four\n\n```gom\n  let x = 1;\n```\n\n---",
        24,
    );
    testing::assert_eq(
        value.plain_text(),
        "# Title\n\nHello bold and em.\n\n│ quote\n\n│ • one\n│ • two\n\n3. three\n4. four\n\n┌ gom\n│   let x = 1;\n└\n\n────────────────────────",
    );
    let encoded = testing::expect_ok(
        value.render_ansi(ansi::Profile::TrueColor, false),
        "ANSI output",
    );
    testing::assert_eq(testing::expect_ok(ansi::strip(encoded), "strip"), value.plain_text());
}

#[test]
fn unicode_word_wrapping_preserves_graphemes_and_style_boundaries() -> () {
    let value = rendered("one two three **界👩‍💻é** final", 9);
    testing::assert_eq(value.lines[0].plain_text(), "one two");
    testing::assert_eq(value.lines[1].plain_text(), "three 界");
    testing::assert(value.plain_text().replace("\n", "").contains("界👩‍💻é"));
    for line in value.lines {
        testing::assert(unicode_text::width(line.plain_text()) <= 9);
    }
    let mut bold = false;
    for line in value.lines {
        for span in line.spans() {
            if span.text == "界" {
                bold = span.style.attributes & ansi::BOLD != 0;
            }
        }
    }
    testing::assert(bold);
}

#[test]
fn links_images_references_numbering_and_safe_osc8() -> () {
    let source = "[GoML](https://example.org \"Docs\") and ![logo](logo.png), [ref].\n\n[ref]: /guide\n\n[blocked](javascript:alert(1))";
    let value = rendered(source, 80);
    testing::assert_eq(value.links.len(), 3);
    testing::assert_eq(value.links[0].title, "Docs");
    testing::assert_eq(value.links[1].url, "logo.png");
    testing::assert_eq(value.links[2].url, "/guide");
    testing::assert(value.plain_text().contains("GoML[1]"));
    testing::assert(value.plain_text().contains("[image: logo[2]]"));
    testing::assert(value.plain_text().contains("blocked"));
    let linked = testing::expect_ok(value.render_ansi(ansi::Profile::TrueColor, true), "hyperlinks");
    testing::assert(linked.contains("\u001b]8;id=1;https://example.org\u001b\\"));
    testing::assert(!linked.contains("javascript:"));
    testing::assert(
        !testing::expect_ok(value.render_ansi(ansi::Profile::Plain, true), "plain").contains(
            "\u001b",
        ),
    );
    for url in[
        "javascript:alert(1)",
        "data:text/html,x",
        "https://example.org/\u001b",
        "https://example.org/\n",
        "",
    ] {
        testing::assert(!tui_markdown::safe_destination(url));
    }
}

#[test]
fn html_and_controls_are_literal_and_never_terminal_commands() -> () {
    let value = rendered("<script>alert('x')</script>\n\n<b>hello</b> \u001b[2J", 80);
    testing::assert(value.plain_text().contains("<script>"));
    testing::assert(value.plain_text().contains("<b>hello</b>"));
    testing::assert(value.plain_text().contains("�[2J"));
    testing::assert(!value.plain_text().contains("\u001b"));
}

#[test]
fn optional_pipe_tables_wrap_align_and_preserve_inline_styles() -> () {
    let source = "| Name | Value |\n| :--- | ---: |\n| **alpha** | 界 |\n| b\\|c | 123 |";
    let options = tui_markdown::Options { pipe_tables: true, ..tui_markdown::Options::defaults(21) };
    let table = testing::expect_ok(tui_markdown::layout(source, options), "table");
    testing::assert_eq(
        table.plain_text(),
        "┼─────────┼─────────┼\n│Name     │    Value│\n┼─────────┼─────────┼\n│alpha    │       界│\n│b|c      │      123│\n┼─────────┼─────────┼",
    );
    for line in table.lines {
        testing::assert_eq(line.width(), 21);
    }
    testing::assert(!rendered(source, 21).plain_text().contains("┼"));
    let narrow = testing::expect_ok(
        tui_markdown::layout(source, tui_markdown::Options { width: 2, ..options }),
        "narrow fallback",
    );
    for line in narrow.lines {
        testing::assert(line.width() <= 2);
    }
}

#[test]
fn resource_limits_and_manually_constructed_ast_fail_recoverably() -> () {
    let options = tui_markdown::Options::defaults(20);
    testing::assert(
        tui_markdown::layout("abc", tui_markdown::Options { width: 0, ..options }).is_err(),
    );
    testing::assert(
        tui_markdown::layout("abc", tui_markdown::Options { max_input_bytes: 2, ..options }).is_err(),
    );
    testing::assert(
        tui_markdown::layout("abc", tui_markdown::Options { max_output_bytes: 2, ..options }).is_err(),
    );
    testing::assert(
        tui_markdown::layout("a\n\nb", tui_markdown::Options { max_lines: 1, ..options }).is_err(),
    );
    testing::assert(
        tui_markdown::layout(
            "[x](https://example.org)",
            tui_markdown::Options { max_links: 0, ..options },
        ).is_err(),
    );
    let blocks = Vec::new();
    blocks.push(
        markdown::Block {
            kind: markdown::BlockKind::Quote(blocks),
            span: markdown::LineSpan { start: 0, end: 0 },
        },
    );
    let cyclic = markdown::Document { blocks, references: HashMap::new() };
    testing::assert(tui_markdown::render(cyclic, options).is_err());
    let invalid = markdown::Document {
        blocks: Vec::from_array(
            [
                markdown::Block {
                    kind: markdown::BlockKind::Heading(8, Vec::new()),
                    span: markdown::LineSpan { start: 0, end: 0 },
                },
            ],
        ),
        references: HashMap::new(),
    };
    testing::assert(tui_markdown::render(invalid, options).is_err());
}

#[test]
fn nested_prefixes_at_narrow_width_remain_bounded() -> () {
    for width in 1..12 {
        let result = rendered(
            "> > > # heading\n> > >\n> > > - nested 界👩‍💻\n> > >\n> > > ```\n> > > a\n> > > ```",
            width,
        );
        for line in result.lines {
            testing::assert(line.width() <= width);
        }
    }
}

#[test]
fn pipe_table_escaping_is_consumed_exactly_once() -> () {
    let options = tui_markdown::Options { pipe_tables: true, ..tui_markdown::Options::defaults(31) };
    let value = testing::expect_ok(
        tui_markdown::layout("a | b\\|\n--- | ---\n\\*hi\\* | \\\\*bold*", options),
        "escaped table",
    );
    testing::assert(value.plain_text().contains("b|"));
    testing::assert(value.plain_text().contains("*hi*"));
    testing::assert(value.plain_text().contains("\\bold"));
    let mut italic = false;
    for line in value.lines {
        for part in line.spans() {
            if part.text == "b" && part.style.attributes & ansi::ITALIC != 0 {
                italic = true;
            }
        }
    }
    testing::assert(italic);
}

#[test]
fn ast_preflight_rejects_wide_cyclic_trees_before_allocating_traversal_stack() -> () {
    let blocks = Vec::new();
    let cycle = markdown::Block {
        kind: markdown::BlockKind::Quote(blocks),
        span: markdown::LineSpan { start: 0, end: 0 },
    };
    for _ in 0..1024 {
        blocks.push(cycle);
    }
    let document = markdown::Document { blocks, references: HashMap::new() };
    testing::assert(
        tui_markdown::render(
            document,
            tui_markdown::Options { max_nodes: 4, ..tui_markdown::Options::defaults(20) },
        ).is_err(),
    );
}

#[test]
fn nested_ast_links_share_a_metadata_byte_budget() -> () {
    let mut inlines = Vec::from_array([markdown::Inline::Text("abcd")]);
    for _ in 0..5 {
        inlines = Vec::from_array([markdown::Inline::Link("x", "", inlines)]);
    }
    let document = markdown::Document {
        blocks: Vec::from_array(
            [
                markdown::Block {
                    kind: markdown::BlockKind::Paragraph(inlines),
                    span: markdown::LineSpan { start: 0, end: 0 },
                },
            ],
        ),
        references: HashMap::new(),
    };
    let error = testing::expect_err(
        tui_markdown::render(
            document,
            tui_markdown::Options { max_output_bytes: 20, ..tui_markdown::Options::defaults(40) },
        ),
        "metadata limit",
    );
    testing::assert(error.message.contains("metadata"));
}
