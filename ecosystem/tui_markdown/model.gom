package tui_markdown;

use ecosystem::ansi;

#[derive(Debug, PartialEq, Eq)]
pub struct Error {
    pub message: string,
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        self.message
    }
}

fn failure(message: string) -> Error {
    Error { message }
}

fn minimum(a: isize, b: isize) -> isize {
    if a < b {
        a
    } else {
        b
    }
}

fn maximum(a: isize, b: isize) -> isize {
    if a > b {
        a
    } else {
        b
    }
}

fn clamp(value: isize, low: isize, high: isize) -> isize {
    maximum(low, minimum(value, high))
}

pub struct Theme {
    pub text: ansi::Style,
    pub heading: ansi::Style,
    pub code: ansi::Style,
    pub quote: ansi::Style,
    pub link: ansi::Style,
    pub selected_link: ansi::Style,
    pub search: ansi::Style,
    pub border: ansi::Style,
    pub muted: ansi::Style,
}

impl Theme {
    pub fn defaults() -> Theme {
        Theme {
            text: ansi::Style::new(),
            heading: ansi::Style::new().foreground(ansi::Color::Indexed(6)).with_attribute(
                ansi::BOLD,
                true,
            ),
            code: ansi::Style::new().foreground(ansi::Color::Indexed(3)),
            quote: ansi::Style::new().with_attribute(ansi::DIM, true),
            link: ansi::Style::new().foreground(ansi::Color::Indexed(4)).with_attribute(
                ansi::UNDERLINE,
                true,
            ),
            selected_link: ansi::Style::new().with_attribute(ansi::REVERSE | ansi::UNDERLINE, true),
            search: ansi::Style::new().background(ansi::Color::Indexed(3)).foreground(
                ansi::Color::Indexed(0),
            ),
            border: ansi::Style::new().foreground(ansi::Color::Indexed(8)),
            muted: ansi::Style::new().with_attribute(ansi::DIM, true),
        }
    }
}

pub struct Options {
    pub width: isize,
    pub theme: Theme,
    pub link_numbers: bool,
    pub link_footnotes: bool,
    pub pipe_tables: bool,
    pub max_input_bytes: isize,
    pub max_output_bytes: isize,
    pub max_lines: isize,
    pub max_depth: isize,
    pub max_nodes: isize,
    pub max_links: isize,
}

impl Options {
    pub fn defaults(width: isize) -> Options {
        Options {
            width,
            theme: Theme::defaults(),
            link_numbers: true,
            link_footnotes: false,
            pipe_tables: false,
            max_input_bytes: 1048576,
            max_output_bytes: 4194304,
            max_lines: 65536,
            max_depth: 64,
            max_nodes: 100000,
            max_links: 4096,
        }
    }

    pub fn validate(self: Options) -> Result[(), Error] {
        if self.width < 1 || self.width > 4096 || self.max_input_bytes < 1
            || self.max_input_bytes > 4194304
            || self.max_output_bytes < 1
            || self.max_output_bytes > 16777216
            || self.max_lines < 1
            || self.max_lines > 262144
            || self.max_depth < 1
            || self.max_depth > 128
            || self.max_nodes < 1
            || self.max_nodes > 250000
            || self.max_links < 0
            || self.max_links > 16384 {
            Result::Err(failure("invalid Markdown layout limits"))
        } else {
            Result::Ok(())
        }
    }
}

#[derive(Debug, PartialEq, Eq)]
pub struct Link {
    pub index: isize,
    pub url: string,
    pub title: string,
    pub label: string,
    pub line: isize,
}

pub struct Layout {
    pub lines: Vec[ansi::StyledText],
    pub links: Vec[Link],
    pub width: isize,
}

impl Layout {
    pub fn plain_text(self: Layout) -> string {
        let values = Vec::new();
        for line in self.lines {
            values.push(line.plain_text());
        }
        values.join("\n")
    }

    pub fn render_ansi(self: Layout, profile: ansi::Profile, hyperlinks: bool) -> Result[
        string,
        Error,
    ] {
        let values = Vec::new();
        let mut bytes = 0;
        for line in self.lines {
            let text = line.render_with_links(profile, hyperlinks);
            bytes += text.byte_len() + 1;
            if bytes > 16777216 {
                return Result::Err(failure("rendered ANSI output limit exceeded"))
            }
            values.push(text);
        }
        Result::Ok(values.join("\n"))
    }
}
