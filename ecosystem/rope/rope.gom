package rope;

use std::io;
use std::text;

#[derive(Debug, PartialEq)]
pub enum Error {
    Bounds {
        index: isize,
        length: isize,
        unit: string,
    },
    Range {
        start: isize,
        end: isize,
        length: isize,
    },
    Boundary {
        index: isize,
        unit: string,
    },
    InvalidUtf8(isize),
    TooLarge,
    Io(io::Error),
    Invariant(string),
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        match self {
            Bounds { index, length, unit } => f"{unit} index {index} is outside 0..{length}",
            Range { start, end, length } => f"invalid byte range {start}..{end} for length {length}",
            Boundary { index, unit } => f"index {index} splits a {unit} boundary",
            InvalidUtf8(index) => f"invalid UTF-8 at byte {index}",
            TooLarge => "rope byte limit exceeded",
            Io(error) => error.to_string(),
            Invariant(message) => "rope invariant: " + message,
        }
    }
}

#[derive(Debug, PartialEq, Eq)]
pub enum Encoding {
    Bytes,
    Scalars,
    Utf16,
}

#[derive(Debug, PartialEq, Eq)]
pub struct Position {
    pub line: isize,
    pub column: isize,
}

#[derive(Debug, PartialEq, Eq)]
pub struct Statistics {
    pub bytes: isize,
    pub scalars: isize,
    pub utf16_units: isize,
    pub lines: isize,
    pub height: isize,
    pub chunks: isize,
}

pub struct Rope {
    root: Ref[Node],
}

fn validate_text(value: string) -> Result[(), Error] {
    let mut at = 0;
    while at < value.byte_len() {
        match value.decode_at(at) {
            Some((_, width)) => {
                at += width;
            },
            None => return Result::Err(Error::InvalidUtf8(at)),
        }
    }
    Result::Ok(())
}

fn bounded(index: isize, length: isize, unit: string) -> Result[(), Error] {
    if index < 0 || index > length {
        Result::Err(Error::Bounds { index, length, unit })
    } else {
        Result::Ok(())
    }
}

impl Rope {
    pub fn new() -> Rope {
        Rope { root: leaf("") }
    }

    pub fn from_string(value: string) -> Result[Rope, Error] {
        validate_text(value)?;
        Result::Ok(Rope { root: node_from_string(value) })
    }

    pub fn snapshot(self: Rope) -> Rope {
        self
    }

    pub fn len_bytes(self: Rope) -> isize {
        summary(self.root).bytes
    }

    pub fn len_scalars(self: Rope) -> isize {
        summary(self.root).scalars
    }

    pub fn len_utf16(self: Rope) -> isize {
        summary(self.root).utf16
    }

    pub fn len_lines(self: Rope) -> isize {
        summary(self.root).breaks + 1
    }

    pub fn is_empty(self: Rope) -> bool {
        self.len_bytes() == 0
    }

    pub fn is_char_boundary(self: Rope, index: isize) -> bool {
        if index < 0 || index > self.len_bytes() {
            false
        } else if index == self.len_bytes() {
            true
        } else {
            let value = node_byte(self.root, index);
            value < 128 || value >= 192
        }
    }

    pub fn byte(self: Rope, index: isize) -> Result[byte, Error] {
        bounded(index, self.len_bytes() - 1, "byte")?;
        Result::Ok(node_byte(self.root, index))
    }

    pub fn scalar(self: Rope, index: isize) -> Result[char, Error] {
        bounded(index, self.len_scalars() - 1, "scalar")?;
        let at = self.scalar_to_byte(index)?;
        let end = self.scalar_to_byte(index + 1)?;
        let value = self.slice_bytes(at, end)?.to_string();
        Result::Ok(value.get(0))
    }

    fn checked_byte(self: Rope, index: isize) -> Result[(), Error] {
        bounded(index, self.len_bytes(), "byte")?;
        if self.is_char_boundary(index) {
            Result::Ok(())
        } else {
            Result::Err(Error::Boundary { index, unit: "UTF-8" })
        }
    }

    fn checked_range(self: Rope, start: isize, end: isize) -> Result[(), Error] {
        if start < 0 || end < start || end > self.len_bytes() {
            return Result::Err(Error::Range { start, end, length: self.len_bytes() })
        }
        self.checked_byte(start)?;
        self.checked_byte(end)
    }

    pub fn byte_to_scalar(self: Rope, index: isize) -> Result[isize, Error] {
        self.checked_byte(index)?;
        Result::Ok(prefix(self.root, index).scalars)
    }

    pub fn byte_to_utf16(self: Rope, index: isize) -> Result[isize, Error] {
        self.checked_byte(index)?;
        Result::Ok(prefix(self.root, index).utf16)
    }

    pub fn scalar_to_byte(self: Rope, index: isize) -> Result[isize, Error] {
        bounded(index, self.len_scalars(), "scalar")?;
        metric_byte(self.root, index, Encoding::Scalars).ok_or(
            Error::Boundary { index, unit: "scalar" },
        )
    }

    pub fn utf16_to_byte(self: Rope, index: isize) -> Result[isize, Error] {
        bounded(index, self.len_utf16(), "UTF-16")?;
        metric_byte(self.root, index, Encoding::Utf16).ok_or(
            Error::Boundary { index, unit: "UTF-16 surrogate pair" },
        )
    }

    pub fn scalar_to_utf16(self: Rope, index: isize) -> Result[isize, Error] {
        self.byte_to_utf16(self.scalar_to_byte(index)?)
    }

    pub fn utf16_to_scalar(self: Rope, index: isize) -> Result[isize, Error] {
        self.byte_to_scalar(self.utf16_to_byte(index)?)
    }

    pub fn byte_to_line(self: Rope, index: isize) -> Result[isize, Error] {
        self.checked_byte(index)?;
        let before = prefix(self.root, index);
        let pending_crlf = before.ends_cr && index < self.len_bytes()
            && node_byte(self.root, index) == b'\n';
        Result::Ok(
            before.breaks
                - if pending_crlf {
                    1
                } else {
                    0
                },
        )
    }

    pub fn line_to_byte(self: Rope, index: isize) -> Result[isize, Error] {
        bounded(index, self.len_lines(), "line")?;
        if index == self.len_lines() {
            Result::Ok(self.len_bytes())
        } else {
            Result::Ok(break_byte(self.root, index, false))
        }
    }

    pub fn line_to_scalar(self: Rope, index: isize) -> Result[isize, Error] {
        self.byte_to_scalar(self.line_to_byte(index)?)
    }

    pub fn line_to_utf16(self: Rope, index: isize) -> Result[isize, Error] {
        self.byte_to_utf16(self.line_to_byte(index)?)
    }

    pub fn line_bounds(self: Rope, index: isize, include_ending: bool) -> Result[
        (isize, isize),
        Error,
    ] {
        bounded(index, self.len_lines() - 1, "line")?;
        let start = self.line_to_byte(index)?;
        let mut end = self.line_to_byte(index + 1)?;
        if !include_ending {
            if end > start && node_byte(self.root, end - 1) == b'\n' {
                end -= 1;
            }
            if end > start && node_byte(self.root, end - 1) == b'\r' {
                end -= 1;
            }
        }
        Result::Ok((start, end))
    }

    pub fn byte_to_position(self: Rope, index: isize, encoding: Encoding) -> Result[Position, Error] {
        let line = self.byte_to_line(index)?;
        let (start, end) = self.line_bounds(line, false)?;
        if index > end {
            return Result::Err(Error::Boundary { index, unit: "line terminator" })
        }
        let column = metric_count(prefix(self.root, index), encoding)
            - metric_count(prefix(self.root, start), encoding);
        Result::Ok(Position { line, column })
    }

    pub fn position_to_byte(self: Rope, position: Position, encoding: Encoding) -> Result[
        isize,
        Error,
    ] {
        let (start, end) = self.line_bounds(position.line, false)?;
        let first = metric_count(prefix(self.root, start), encoding);
        let last = metric_count(prefix(self.root, end), encoding);
        bounded(position.column, last - first, "column")?;
        let index = first + position.column;
        match encoding {
            Bytes => {
                self.checked_byte(index)?;
                Result::Ok(index)
            },
            Scalars => self.scalar_to_byte(index),
            Utf16 => self.utf16_to_byte(index),
        }
    }

    pub fn split_at_byte(self: Rope, index: isize) -> Result[(Rope, Rope), Error] {
        self.checked_byte(index)?;
        let (left, right) = split_node(self.root, index);
        Result::Ok((Rope { root: left }, Rope { root: right }))
    }

    pub fn split_at(self: Rope, index: isize) -> Result[(Rope, Rope), Error] {
        self.split_at_byte(self.scalar_to_byte(index)?)
    }

    pub fn concat(self: Rope, other: Rope) -> Result[Rope, Error] {
        if self.len_bytes() > MAX_BYTES - other.len_bytes() {
            return Result::Err(Error::TooLarge)
        }
        Result::Ok(Rope { root: joined(self.root, other.root) })
    }

    pub fn slice_bytes(self: Rope, start: isize, end: isize) -> Result[Rope, Error] {
        self.checked_range(start, end)?;
        let (before, _) = split_node(self.root, end);
        let (_, selected) = split_node(before, start);
        Result::Ok(Rope { root: selected })
    }

    pub fn slice(self: Rope, start: isize, end: isize) -> Result[Rope, Error] {
        self.slice_bytes(self.scalar_to_byte(start)?, self.scalar_to_byte(end)?)
    }

    pub fn replace_bytes(self: Rope, start: isize, end: isize, replacement: Rope) -> Result[
        Rope,
        Error,
    ] {
        self.checked_range(start, end)?;
        if self.len_bytes() - (end - start) > MAX_BYTES - replacement.len_bytes() {
            return Result::Err(Error::TooLarge)
        }
        let (before, _) = split_node(self.root, start);
        let (_, after) = split_node(self.root, end);
        Result::Ok(Rope { root: joined(joined(before, replacement.root), after) })
    }

    pub fn insert_bytes(self: Rope, index: isize, value: string) -> Result[Rope, Error] {
        self.checked_byte(index)?;
        self.replace_bytes(index, index, Rope::from_string(value)?)
    }

    pub fn insert(self: Rope, index: isize, value: string) -> Result[Rope, Error] {
        self.insert_bytes(self.scalar_to_byte(index)?, value)
    }

    pub fn remove_bytes(self: Rope, start: isize, end: isize) -> Result[Rope, Error] {
        self.replace_bytes(start, end, Rope::new())
    }

    pub fn remove(self: Rope, start: isize, end: isize) -> Result[Rope, Error] {
        self.remove_bytes(self.scalar_to_byte(start)?, self.scalar_to_byte(end)?)
    }

    pub fn line(self: Rope, index: isize) -> Result[Rope, Error] {
        let (start, end) = self.line_bounds(index, true)?;
        self.slice_bytes(start, end)
    }

    pub fn line_content(self: Rope, index: isize) -> Result[Rope, Error] {
        let (start, end) = self.line_bounds(index, false)?;
        self.slice_bytes(start, end)
    }

    pub fn compact(self: Rope) -> Result[Rope, Error] {
        let builder = Builder::new();
        for chunk in self.chunks() {
            builder.append(chunk)?;
        }
        Result::Ok(builder.finish())
    }

    pub fn validate(self: Rope) -> Result[Statistics, Error] {
        let (value, depth, chunks) = validate_node(self.root)?;
        Result::Ok(
            Statistics {
                bytes: value.bytes,
                scalars: value.scalars,
                utf16_units: value.utf16,
                lines: value.breaks + 1,
                height: depth,
                chunks,
            },
        )
    }
}

impl ToString for Rope {
    fn to_string(self: Rope) -> string {
        let output = text::StringBuilder::with_capacity(self.len_bytes());
        for chunk in self.chunks() {
            output.write_string(chunk);
        }
        output.finish()
    }
}

impl Debug for Rope {
    fn debug(self: Rope) -> string {
        f"Rope(bytes={self.len_bytes()}, scalars={self.len_scalars()}, lines={self.len_lines()})"
    }
}

impl PartialEq for Rope {
    fn eq(self: Rope, other: Rope) -> bool {
        if self.root == other.root {
            return true
        }
        if summary(self.root) != summary(other.root) {
            return false
        }
        let left = self.bytes();
        let right = other.bytes();
        loop {
            match (left.next(), right.next()) {
                (None, None) => return true,
                (Some(a), Some(b)) if a == b => (),
                _ => return false,
            }
        }
    }
}

impl Eq for Rope {}
