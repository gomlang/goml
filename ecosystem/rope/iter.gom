package rope;

pub struct Chunks {
    pending: Vec[Ref[Node]],
}

impl Iterator for Chunks {
    type Item = string;

    fn next(self: Chunks) -> Option[string] {
        while let Some(node) = self.pending.pop() {
            match node.get() {
                Empty => (),
                Leaf(value, _) => return Option::Some(value),
                Branch(left, right, _, _) => {
                    self.pending.push(right);
                    self.pending.push(left);
                },
            }
        }
        Option::None
    }
}

pub struct Bytes {
    chunks: Chunks,
    current: Ref[string],
    offset: Ref[isize],
}

impl Iterator for Bytes {
    type Item = byte;

    fn next(self: Bytes) -> Option[byte] {
        while self.offset.get() == self.current.get().byte_len() {
            match self.chunks.next() {
                Some(value) => {
                    self.current.set(value);
                    self.offset.set(0);
                },
                None => return Option::None,
            }
        }
        let result = self.current.get().byte_get(self.offset.get());
        self.offset.set(self.offset.get() + 1);
        Option::Some(result)
    }
}

pub struct Scalars {
    chunks: Chunks,
    current: Ref[string],
    offset: Ref[isize],
}

impl Iterator for Scalars {
    type Item = char;

    fn next(self: Scalars) -> Option[char] {
        while self.offset.get() == self.current.get().byte_len() {
            match self.chunks.next() {
                Some(value) => {
                    self.current.set(value);
                    self.offset.set(0);
                },
                None => return Option::None,
            }
        }
        match self.current.get().decode_at(self.offset.get()) {
            Some((ch, width)) => {
                self.offset.set(self.offset.get() + width);
                Option::Some(ch)
            },
            None => Option::None,
        }
    }
}

pub struct Lines {
    rope: Rope,
    next_line: Ref[isize],
    include_ending: bool,
}

impl Iterator for Lines {
    type Item = Rope;

    fn next(self: Lines) -> Option[Rope] {
        let index = self.next_line.get();
        if index >= self.rope.len_lines() {
            return Option::None
        }
        self.next_line.set(index + 1);
        let result = if self.include_ending {
            self.rope.line(index)
        } else {
            self.rope.line_content(index)
        };
        match result {
            Ok(value) => Option::Some(value),
            Err(_) => Option::None,
        }
    }
}

impl Rope {
    pub fn chunks(self: Rope) -> Chunks {
        Chunks { pending: Vec::from_array([self.root]) }
    }

    pub fn bytes(self: Rope) -> Bytes {
        Bytes { chunks: self.chunks(), current: Ref::new(""), offset: Ref::new(0) }
    }

    pub fn scalars(self: Rope) -> Scalars {
        Scalars { chunks: self.chunks(), current: Ref::new(""), offset: Ref::new(0) }
    }

    pub fn lines(self: Rope) -> Lines {
        Lines { rope: self, next_line: Ref::new(0), include_ending: true }
    }

    pub fn line_contents(self: Rope) -> Lines {
        Lines { rope: self, next_line: Ref::new(0), include_ending: false }
    }

    pub fn chunks_from_byte(self: Rope, index: isize) -> Result[Chunks, Error] {
        let (_, rest) = self.split_at_byte(index)?;
        Result::Ok(rest.chunks())
    }

    pub fn scalars_from(self: Rope, index: isize) -> Result[Scalars, Error] {
        let (_, rest) = self.split_at(index)?;
        Result::Ok(rest.scalars())
    }

    pub fn lines_from(self: Rope, index: isize) -> Result[Lines, Error] {
        bounded(index, self.len_lines(), "line")?;
        Result::Ok(Lines { rope: self, next_line: Ref::new(index), include_ending: true })
    }
}
