package rope;

use std::bytes;
use std::io;
use std::io::{Read, Write};
use std::utf8;

pub struct Builder {
    nodes: Vec[Ref[Node]],
    pending: Ref[string],
    length: Ref[isize],
}

impl Builder {
    pub fn new() -> Builder {
        Builder { nodes: Vec::new(), pending: Ref::new(""), length: Ref::new(0) }
    }

    pub fn len_bytes(self: Builder) -> isize {
        self.length.get()
    }

    pub fn append(self: Builder, value: string) -> Result[(), Error] {
        validate_text(value)?;
        if self.length.get() > MAX_BYTES - value.byte_len() {
            return Result::Err(Error::TooLarge)
        }
        self.length.set(self.length.get() + value.byte_len());
        let mut at = 0;
        while at < value.byte_len() {
            let available = CHUNK_BYTES - self.pending.get().byte_len();
            let mut end = at + available;
            if end > value.byte_len() {
                end = value.byte_len();
            }
            while !value.is_char_boundary(end) {
                end -= 1;
            }
            if end > at {
                self.pending.set(self.pending.get() + value.byte_slice(at, end));
                at = end;
            }
            if at < value.byte_len() || self.pending.get().byte_len() == CHUNK_BYTES {
                self.nodes.push(leaf(self.pending.get()));
                self.pending.set("");
            }
        }
        Result::Ok(())
    }

    pub fn append_rope(self: Builder, rope: Rope) -> Result[(), Error] {
        if self.length.get() > MAX_BYTES - rope.len_bytes() {
            return Result::Err(Error::TooLarge)
        }
        for chunk in rope.chunks() {
            self.append(chunk)?;
        }
        Result::Ok(())
    }

    pub fn finish(self: Builder) -> Rope {
        let root = build_nodes(self.nodes, 0, self.nodes.len());
        Rope { root: joined(root, leaf(self.pending.get())) }
    }

    pub fn clear(self: Builder) -> () {
        self.nodes.clear();
        self.pending.set("");
        self.length.set(0);
    }
}

impl Rope {
    pub fn from_reader[R: Read](reader: R, max_bytes: isize) -> Result[Rope, Error] {
        if max_bytes < 0 {
            return Result::Err(Error::TooLarge)
        }
        let builder = Builder::new();
        let buffer = bytes::Bytes::new();
        for _ in 0..4096 {
            buffer.push(0);
        }
        let mut pending: Vec[byte] = Vec::new();
        let mut total = 0;
        loop {
            let remaining = max_bytes - total;
            let capacity = if remaining < 4096 {
                remaining + 1
            } else {
                4096
            };
            let count = match reader.read(buffer.slice_mut(0, capacity)) {
                Ok(count) => count,
                Err(error) => return Result::Err(Error::Io(error)),
            };
            if count < 0 || count > capacity {
                return Result::Err(
                    Error::Io(
                        io::Error::new(
                            io::ErrorKind::InvalidData,
                            "read rope",
                            Option::None,
                            Option::None,
                            "reader returned invalid byte count",
                        ),
                    ),
                )
            }
            if count == 0 {
                if pending.len() > 0 {
                    return Result::Err(Error::InvalidUtf8(total - pending.len()))
                }
                return Result::Ok(builder.finish())
            }
            if count > remaining {
                return Result::Err(Error::TooLarge)
            }
            total += count;
            for index in 0..count {
                pending.push(buffer.get(index));
            }
            let valid_end = match utf8::validate(pending.as_slice()) {
                Ok(_) => pending.len(),
                Err(error) => {
                    if error.error_length().is_some() {
                        return Result::Err(
                            Error::InvalidUtf8(total - pending.len() + error.valid_up_to()),
                        )
                    }
                    error.valid_up_to()
                },
            };
            let value = utf8::decode_slice(pending.slice(0, valid_end)).map_err(
                |error| Error::InvalidUtf8(total - pending.len() + error.valid_up_to()),
            )?;
            builder.append(value)?;
            pending = pending.slice(valid_end, pending.len()).to_vec();
        }
    }

    pub fn write_to[W: Write](self: Rope, writer: W) -> Result[(), Error] {
        for chunk in self.chunks() {
            writer.write_all(chunk.to_bytes().as_slice()).map_err(|error| Error::Io(error))?;
        }
        Result::Ok(())
    }
}
