package tests;

use ecosystem::rope;
use std::bytes;
use std::io;
use std::io::{Read, Write};
use std::task;
use std::testing;

struct FragmentedReader {
    data: Vec[byte],
    cursor: Ref[isize],
    fragment: isize,
    interrupt: Ref[bool],
    calls: Ref[isize],
    interrupt_on: isize,
}

impl Read for FragmentedReader {
    fn read(self: FragmentedReader, output: MutSlice[byte]) -> Result[isize, io::Error] {
        self.calls.set(self.calls.get() + 1);
        if self.interrupt.get() || self.calls.get() == self.interrupt_on {
            self.interrupt.set(false);
            if self.cursor.get() < self.data.len() && output.len() > 0 {
                output[0] = self.data[self.cursor.get()];
                self.cursor.set(self.cursor.get() + 1);
            }
            return Result::Err(
                io::Error::new(
                    io::ErrorKind::Interrupted,
                    "fragment reader",
                    Option::None,
                    Option::None,
                    "retry",
                ),
            )
        }
        let mut count = 0;
        while count < output.len() && count < self.fragment && self.cursor.get() < self.data.len() {
            output[count] = self.data[self.cursor.get()];
            self.cursor.set(self.cursor.get() + 1);
            count += 1;
        }
        Result::Ok(count)
    }
}

fn reader(data: Vec[byte], fragment: isize) -> FragmentedReader {
    FragmentedReader {
        data,
        cursor: Ref::new(0),
        fragment,
        interrupt: Ref::new(false),
        calls: Ref::new(0),
        interrupt_on: -1,
    }
}

struct PartialWriter {
    output: Vec[byte],
    fragment: isize,
    interrupt: Ref[bool],
    calls: Ref[isize],
}

impl Write for PartialWriter {
    fn write(self: PartialWriter, input: Slice[byte]) -> Result[isize, io::Error] {
        self.calls.set(self.calls.get() + 1);
        if self.interrupt.get() {
            self.interrupt.set(false);
            return Result::Err(
                io::Error::new(
                    io::ErrorKind::Interrupted,
                    "partial writer",
                    Option::None,
                    Option::None,
                    "retry",
                ),
            )
        }
        let count = if self.fragment < input.len() {
            self.fragment
        } else {
            input.len()
        };
        for index in 0..count {
            self.output.push(input[index]);
        }
        Result::Ok(count)
    }
}

struct InvalidReader {}

impl Read for InvalidReader {
    fn read(self: InvalidReader, output: MutSlice[byte]) -> Result[isize, io::Error] {
        Result::Ok(output.len() + 1)
    }
}

#[test]
fn builder_snapshots_and_utf8_chunk_splits() -> () {
    let builder = rope::Builder::new();
    testing::expect_ok(builder.append(repeat("a", 1023)), "prefix");
    let first = builder.finish();
    testing::expect_ok(builder.append("😀\r"), "astral scalar");
    testing::expect_ok(builder.append("\n末尾"), "split CRLF");
    let second = builder.finish();
    testing::expect_ok(builder.append_rope(make("!")), "append rope");
    assert_model(second, repeat("a", 1023) + "😀\r\n末尾");
    assert_model(first, repeat("a", 1023));
    testing::assert_eq(builder.len_bytes(), 1036);
    builder.clear();
    testing::assert(builder.finish().is_empty());
    testing::assert_eq(builder.len_bytes(), 0);
    assert_model(second, repeat("a", 1023) + "😀\r\n末尾");
}

#[test]
fn streaming_utf8_limit_partial_io_and_interruption() -> () {
    let source = repeat("中😀\r\naé\r", 400);
    for fragment in[1, 2, 3, 7, 4096] {
        let value = testing::expect_ok(
            rope::Rope::from_reader(reader(source.to_bytes(), fragment), source.byte_len()),
            "fragmented read",
        );
        assert_model(value, source);
        let output = PartialWriter {
            output: Vec::new(),
            fragment,
            interrupt: Ref::new(false),
            calls: Ref::new(0),
        };
        testing::expect_ok(value.write_to(output), "partial write");
        testing::assert(output.output == source.to_bytes());
    }
    testing::assert_err(
        rope::Rope::from_reader(reader(source.to_bytes(), 3), source.byte_len() - 1),
    );
    testing::assert_err(rope::Rope::from_reader(reader(Vec::new(), 1), -1));
    testing::assert(
        testing::expect_ok(
            rope::Rope::from_reader(reader(Vec::new(), 1), 0),
            "empty bounded stream",
        ).is_empty(),
    );
    testing::assert_err(rope::Rope::from_reader(reader(b"x", 1), 0));
    testing::assert_err(rope::Rope::from_reader(InvalidReader {}, 100));
    let zero = PartialWriter {
        output: Vec::new(),
        fragment: 0,
        interrupt: Ref::new(false),
        calls: Ref::new(0),
    };
    match testing::expect_err(make("x").write_to(zero), "zero progress") {
        Io(error) => testing::assert_eq(error.kind(), io::ErrorKind::WriteZero),
        _ => testing::assert(false),
    }
    let cursor = io::Cursor::new(bytes::Bytes::new());
    testing::expect_ok(make(source).write_to(cursor), "standard cursor writer");
    testing::expect_ok(cursor.set_position(0), "rewind");
    testing::assert_eq(
        testing::expect_ok(
            rope::Rope::from_reader(cursor, source.byte_len()),
            "standard cursor reader",
        ).to_string(),
        source,
    );
}

#[test]
fn interrupted_output_stops_after_one_writer_call() -> () {
    let output = PartialWriter {
        output: Vec::new(),
        fragment: 2,
        interrupt: Ref::new(true),
        calls: Ref::new(0),
    };
    match testing::expect_err(make("中😀").write_to(output), "interrupted output") {
        Io(error) => testing::assert_eq(error.kind(), io::ErrorKind::Interrupted),
        _ => testing::fail("expected Interrupted I/O error"),
    }
    testing::assert_eq(output.calls.get(), 1);
    testing::assert(output.output.is_empty());
}

#[test]
fn interrupted_input_returns_without_replaying_consumed_bytes() -> () {
    for interrupt_on in[1, 2] {
        let source = FragmentedReader { interrupt_on, ..reader("界🙂".to_bytes(), 1) };
        match testing::expect_err(rope::Rope::from_reader(source, 32), "interrupted rope input") {
            Io(error) => {
                testing::assert_eq(error.kind(), io::ErrorKind::Interrupted);
                testing::assert_eq(
                    error.to_string(),
                    io::Error::new(
                        io::ErrorKind::Interrupted,
                        "fragment reader",
                        Option::None,
                        Option::None,
                        "retry",
                    ).to_string(),
                );
            },
            _ => testing::fail("expected interrupted input cause"),
        }
        testing::assert_eq(source.calls.get(), interrupt_on);
        testing::assert_eq(source.cursor.get(), interrupt_on);
    }
}

#[test]
fn malformed_utf8_reports_absolute_offset() -> () {
    for malformed in[
        b"x\xc0\x80",
        b"x\xed\xa0\x80",
        b"x\xf4\x90\x80\x80",
        b"x\xff",
        b"x\xf0\x9f\x98",
    ] {
        for fragment in[1, 2, 7] {
            let error = testing::expect_err(
                rope::Rope::from_reader(reader(malformed, fragment), 100),
                "invalid UTF-8",
            );
            testing::assert_eq(error, rope::Error::InvalidUtf8(1));
        }
    }
    let source = repeat("a", 4095).to_bytes();
    source.push(0xf0);
    source.push(0x9f);
    testing::assert_eq(
        testing::expect_err(
            rope::Rope::from_reader(reader(source, 4096), 5000),
            "truncated scalar across read",
        ),
        rope::Error::InvalidUtf8(4095),
    );
}

#[test]
fn immutable_snapshots_support_parallel_readers_and_edits() -> () {
    let source = repeat("中😀\r\n", 1000);
    let original = make(source);
    task::scope(
        |scope| {
            let jobs: Vec[task::Task[bool]] = Vec::new();
            for worker in 0..8 {
                jobs.push(
                    scope.spawn(
                        |_| {
                            let mut edited = original.snapshot();
                            for index in 0..50 {
                                let at = (worker * 83 + index * 17) % edited.len_scalars();
                                edited = testing::expect_ok(
                                    edited.insert(at, "!"),
                                    "parallel independent edit",
                                );
                                let _ = testing::expect_ok(
                                    edited.validate(),
                                    "parallel edited tree",
                                );
                            }
                            original.to_string() == source
                                && edited.len_bytes() == original.len_bytes() + 50
                        },
                    ),
                );
            }
            for job in jobs {
                testing::assert(job.join());
            }
        },
    );
    assert_model(original, source);
}
