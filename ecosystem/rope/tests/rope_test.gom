package tests;

use ecosystem::rope;
use std::testing;
use std::text;

fn make(value: string) -> rope::Rope {
    testing::expect_ok(rope::Rope::from_string(value), "construct rope")
}

fn repeat(value: string, count: isize) -> string {
    let builder = text::StringBuilder::new();
    for _ in 0..count {
        builder.write_string(value);
    }
    builder.finish()
}

fn assert_model(value: rope::Rope, expected: string) -> () {
    let _ = testing::expect_ok(value.validate(), "AVL structure and summaries");
    testing::assert_eq(value.to_string(), expected);
    testing::assert_eq(value.len_bytes(), expected.byte_len());
    let mut scalar = 0;
    let mut units = 0;
    let mut lines = 0;
    let starts: Vec[isize] = Vec::from_array([0]);
    for at in 0..expected.byte_len() {
        let ch = expected.byte_get(at);
        if ch == b'\n'
            || (ch == b'\r' && (at + 1 == expected.byte_len() || expected.byte_get(at + 1) != b'\n')) {
            lines += 1;
            starts.push(at + 1);
        }
    }
    for (at, ch) in expected.char_indices() {
        testing::assert_eq(testing::expect_ok(value.byte_to_scalar(at), "byte to scalar"), scalar);
        testing::assert_eq(testing::expect_ok(value.scalar_to_byte(scalar), "scalar to byte"), at);
        testing::assert_eq(testing::expect_ok(value.byte_to_utf16(at), "byte to UTF-16"), units);
        testing::assert_eq(testing::expect_ok(value.utf16_to_byte(units), "UTF-16 to byte"), at);
        if ch.to_u32() > 65535 {
            testing::assert_err(value.utf16_to_byte(units + 1));
        }
        scalar += 1;
        units += if ch.to_u32() > 65535 {
            2
        } else {
            1
        };
    }
    testing::assert_eq(value.len_scalars(), scalar);
    testing::assert_eq(value.len_utf16(), units);
    testing::assert_eq(value.len_lines(), lines + 1);
    testing::assert_eq(
        testing::expect_ok(value.scalar_to_byte(scalar), "scalar EOF"),
        expected.byte_len(),
    );
    testing::assert_eq(
        testing::expect_ok(value.utf16_to_byte(units), "UTF-16 EOF"),
        expected.byte_len(),
    );
    testing::assert_eq(
        testing::expect_ok(value.byte_to_scalar(expected.byte_len()), "byte EOF"),
        scalar,
    );
    for line in 0..starts.len() {
        testing::assert_eq(testing::expect_ok(value.line_to_byte(line), "line start"), starts[line]);
        testing::assert_eq(
            testing::expect_ok(value.byte_to_line(starts[line]), "start to line"),
            line,
        );
        let end = if line + 1 == starts.len() {
            expected.byte_len()
        } else {
            starts[line + 1]
        };
        testing::assert_eq(
            testing::expect_ok(value.line(line), "line slice").to_string(),
            expected.byte_slice(starts[line], end),
        );
    }
}

#[test]
fn empty_rope_and_checked_boundaries() -> () {
    let empty = rope::Rope::new();
    assert_model(empty, "");
    testing::assert(empty.is_empty());
    testing::assert_err(empty.byte(0));
    testing::assert_err(empty.scalar(0));
    testing::assert_err(empty.byte_to_scalar(-1));
    testing::assert_err(empty.line(1));
    testing::assert_eq(testing::expect_ok(empty.line_to_byte(1), "line sentinel"), 0);
    let value = make("aé中😀z");
    assert_model(value, "aé中😀z");
    for index in 0..=value.len_bytes() {
        if value.is_char_boundary(index) {
            testing::assert_ok(value.slice_bytes(index, index));
        } else {
            testing::assert_err(value.byte_to_scalar(index));
            testing::assert_err(value.byte_to_utf16(index));
            testing::assert_err(value.byte_to_line(index));
            testing::assert_err(value.insert_bytes(index, "x"));
        }
    }
    testing::assert_err(value.remove_bytes(4, 1));
    testing::assert_err(value.remove_bytes(-1, 0));
    testing::assert_err(value.remove(4, 2));
    testing::assert_err(value.scalar_to_byte(6));
    testing::assert_err(value.utf16_to_byte(-1));
    testing::assert_eq(testing::expect_ok(value.scalar(3), "astral scalar"), '😀');
    testing::assert_eq(testing::expect_ok(value.byte(1), "UTF-8 byte"), 195);
}

#[test]
fn crlf_across_chunks_and_edit_boundaries() -> () {
    let prefix = repeat("x", 1023);
    let original = prefix + "\r\n中\r尾\n";
    let value = make(original);
    assert_model(value, original);
    testing::assert_eq(testing::expect_ok(value.byte_to_line(1024), "inside CRLF"), 0);
    testing::assert_err(value.byte_to_position(1024, rope::Encoding::Utf16));
    testing::assert_eq(
        testing::expect_ok(value.byte_to_position(1023, rope::Encoding::Utf16), "end of line"),
        rope::Position { line: 0, column: 1023 },
    );
    let separated = testing::expect_ok(value.insert_bytes(1024, "😀"), "split CRLF");
    assert_model(separated, prefix + "\r😀\n中\r尾\n");
    let restored = testing::expect_ok(separated.remove_bytes(1024, 1028), "restore CRLF");
    assert_model(restored, original);
    testing::assert(restored == value);
    let (left, right) = testing::expect_ok(
        value.split_at_byte(1024),
        "split CRLF into independent snapshots",
    );
    testing::assert_eq(left.len_lines(), 2);
    testing::assert_eq(right.len_lines(), 4);
    assert_model(testing::expect_ok(left.concat(right), "join CRLF"), original);
    assert_model(value, original);
}

#[test]
fn checked_positions_for_all_encodings() -> () {
    let value = make("a😀é\r\n中\r\n");
    for encoding in[rope::Encoding::Bytes, rope::Encoding::Scalars, rope::Encoding::Utf16] {
        for at in[0, 1, 5, 7, 9, 12, 14] {
            let position = testing::expect_ok(value.byte_to_position(at, encoding), "position");
            testing::assert_eq(
                testing::expect_ok(value.position_to_byte(position, encoding), "position inverse"),
                at,
            );
        }
        testing::assert_err(
            value.position_to_byte(rope::Position { line: -1, column: 0 }, encoding),
        );
        testing::assert_err(value.position_to_byte(rope::Position { line: 3, column: 0 }, encoding));
        testing::assert_err(
            value.position_to_byte(rope::Position { line: 0, column: 99 }, encoding),
        );
        testing::assert_err(
            value.position_to_byte(rope::Position { line: 0, column: -1 }, encoding),
        );
    }
    testing::assert_err(
        value.position_to_byte(rope::Position { line: 0, column: 2 }, rope::Encoding::Utf16),
    );
    testing::assert_err(
        value.position_to_byte(rope::Position { line: 0, column: 2 }, rope::Encoding::Bytes),
    );
    testing::assert_eq(
        testing::expect_ok(value.line_content(0), "without terminator").to_string(),
        "a😀é",
    );
}

#[test]
fn persistent_edits_match_flat_model() -> () {
    let mut value = make(repeat("ab\r\n中😀", 160));
    let initial = value.snapshot();
    let mut expected = value.to_string();
    let saved = expected;
    let snapshots: Vec[(rope::Rope, string)] = Vec::new();
    for step in 0..400 {
        let boundaries: Vec[isize] = Vec::new();
        for (at, _) in expected.char_indices() {
            boundaries.push(at);
        }
        boundaries.push(expected.byte_len());
        let start_index = (step * 97) % boundaries.len();
        let remaining = boundaries.len() - start_index;
        let end_index = start_index + (step % 7) % remaining;
        let start = boundaries[start_index];
        let end = boundaries[end_index];
        let replacement = match step % 6 {
            0 => "😀\r",
            1 => "\n",
            2 => "中文",
            3 => "",
            4 => "\r\n",
            _ => "x",
        };
        value = testing::expect_ok(value.replace_bytes(start, end, make(replacement)), "replace");
        expected = expected.byte_slice(0, start) + replacement
            + expected.byte_slice(end, expected.byte_len());
        let _ = testing::expect_ok(value.validate(), "edited AVL tree");
        testing::assert_eq(value.to_string(), expected);
        if step % 40 == 0 {
            snapshots.push((value.snapshot(), expected));
        }
    }
    assert_model(value, expected);
    assert_model(initial, saved);
    for (snapshot, old) in snapshots {
        assert_model(snapshot, old);
    }
}

#[test]
fn adversarial_avl_joins_splits_and_compaction() -> () {
    let block = repeat("a", 1023) + "\r\n😀";
    let mut value = rope::Rope::new();
    for index in 0..500 {
        value = if index % 2 == 0 {
            testing::expect_ok(value.concat(make(block)), "right join")
        } else {
            testing::expect_ok(make(block).concat(value), "left join")
        };
        let stats = testing::expect_ok(value.validate(), "balanced join");
        testing::assert(stats.height < 20);
    }
    let old = value;
    for index in 0..80 {
        let at = (index * 1327) % value.len_scalars();
        let (left, right) = testing::expect_ok(value.split_at(at), "split");
        let _ = testing::expect_ok(left.validate(), "left AVL tree");
        let _ = testing::expect_ok(right.validate(), "right AVL tree");
        value = testing::expect_ok(left.concat(right), "rejoin");
    }
    testing::assert(value == old);
    let compacted = testing::expect_ok(value.compact(), "compact");
    testing::assert(compacted == old);
    let stats = testing::expect_ok(compacted.validate(), "compacted AVL tree");
    testing::assert(stats.chunks <= compacted.len_bytes() / 1020 + 1);
}

#[test]
fn iterators_are_lazy_fused_and_independent() -> () {
    let value = make("中😀\r\nx\r");
    let scalars = value.scalars();
    for ch in "中😀\r\nx\r".chars() {
        testing::assert(scalars.next() == Option::Some(ch));
    }
    testing::assert(scalars.next().is_none());
    testing::assert(scalars.next().is_none());
    testing::assert(value.scalars().next() == Option::Some('中'));
    let lines = value.lines();
    testing::assert_eq(
        testing::expect_ok(lines.next().ok_or("missing line"), "line item").to_string(),
        "中😀\r\n",
    );
    testing::assert_eq(
        testing::expect_ok(lines.next().ok_or("missing line"), "line item").to_string(),
        "x\r",
    );
    testing::assert_eq(
        testing::expect_ok(lines.next().ok_or("missing line"), "line item").to_string(),
        "",
    );
    testing::assert(lines.next().is_none());
    let chars = testing::expect_ok(value.scalars_from(1), "scalar suffix");
    testing::assert(chars.next() == Option::Some('😀'));
    let chunks = testing::expect_ok(value.chunks_from_byte(3), "chunk suffix");
    testing::assert(chunks.next() == Option::Some("😀\r\nx\r"));
    testing::assert(testing::expect_ok(value.lines_from(3), "past last line").next().is_none());
    let bytes = value.bytes();
    for ch in value.to_string().to_bytes() {
        testing::assert(bytes.next() == Option::Some(ch));
    }
    testing::assert(bytes.next().is_none());
}

#[test]
fn shared_doubling_checks_representable_metadata() -> () {
    let mut value = make("\n");
    for _ in 0..62 {
        value = testing::expect_ok(value.concat(value), "shared doubling");
    }
    testing::assert_eq(value.len_bytes(), 4611686018427387904);
    testing::assert_eq(value.len_lines(), 4611686018427387905);
    testing::assert_err(value.concat(value));
    let almost = testing::expect_ok(value.remove_bytes(0, 1), "remove from shared huge tree");
    let limit = testing::expect_ok(almost.concat(almost), "maximum representable rope");
    testing::assert_eq(limit.len_bytes(), 9223372036854775806);
    testing::assert_eq(limit.len_lines(), 9223372036854775807);
    testing::assert_eq(
        testing::expect_ok(limit.line_to_byte(limit.len_lines() - 1), "huge final line"),
        limit.len_bytes(),
    );
    testing::assert_err(limit.insert_bytes(0, "x"));
    testing::assert_err(limit.concat(make("\n")));
    let builder = rope::Builder::new();
    testing::expect_ok(builder.append("xx"), "small builder");
    testing::assert_err(builder.append_rope(limit));
    testing::assert_eq(builder.finish().to_string(), "xx");
}
