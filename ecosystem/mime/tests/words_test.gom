package tests;

use ecosystem::mime;
use mime::{ErrorKind, Limits, WordEncoding};
use std::testing;

#[test]
fn encoded_words_decode_b_q_and_adjacent_whitespace() -> () {
    testing::assert_eq(
        testing::expect_ok(mime::decode_word("=?UTF-8?B?5Lit5paH?=", Limits::standard()), "B"),
        "中文",
    );
    testing::assert_eq(
        testing::expect_ok(mime::decode_word("=?ISO-8859-1?Q?caf=E9?=", Limits::standard()), "Q"),
        "café",
    );
    testing::assert_eq(
        testing::expect_ok(
            mime::decode_header(
                "Subject: =?UTF-8?B?5Lit?= \t=?UTF-8?B?5paH?= end",
                Limits::standard(),
            ),
            "header",
        ),
        "Subject: 中文 end",
    );
}

#[test]
fn encoded_words_split_on_utf8_scalar_boundaries() -> () {
    let value = "中文😀中文😀中文😀中文😀中文😀中文😀中文😀中文😀";
    for encoding in Vec::from_array([WordEncoding::Base64, WordEncoding::Quoted]) {
        let encoded = testing::expect_ok(
            mime::encode_word(value, encoding, Limits::standard()),
            "encode",
        );
        for word in encoded.split(" ") {
            testing::assert(word.byte_len() <= 75);
            testing::assert_ok(mime::decode_word(word, Limits::standard()));
        }
        let decoded = match mime::decode_header(encoded, Limits::standard()) {
            Ok(decoded) => decoded,
            Err(error) => {
                testing::fail(error.to_string() + " " + encoded);
                loop {}
            },
        };
        testing::assert_eq(decoded, value);
    }
}

#[test]
fn encoded_words_reject_malformed_charset_and_limits() -> () {
    for value in Vec::from_array(
        [
            "=?UTF-8?Q?=ZZ?=",
            "=?UTF-8?B?AA=A?=",
            "=?UTF-8?X?abc?=",
            "=?UTF-8?Q?abc",
            "=?UTF-8?Q?=FF?=",
        ],
    ) {
        testing::assert(mime::decode_word(value, Limits::standard()).is_err());
    }
    testing::assert_eq(
        testing::expect_err(mime::decode_word("=?KOI8-R?Q?abc?=", Limits::standard()), "charset").kind,
        ErrorKind::Charset,
    );
    let limits = Limits { max_output_bytes: 2, ..Limits::standard() };
    testing::assert_eq(
        testing::expect_err(mime::decode_word("=?UTF-8?Q?abc?=", limits), "limit").kind,
        ErrorKind::Limit,
    );
}

#[test]
fn encoded_words_enforce_total_output_budget() -> () {
    let limits = Limits { max_output_bytes: 3, ..Limits::standard() };
    testing::assert_eq(
        testing::expect_err(
            mime::decode_header("=?UTF-8?Q?ab?= =?UTF-8?Q?cd?=", limits),
            "header output",
        ).kind,
        ErrorKind::Limit,
    );
    testing::assert_eq(
        testing::expect_err(mime::encode_word("abcd", WordEncoding::Base64, limits), "word output").kind,
        ErrorKind::Limit,
    );
}
