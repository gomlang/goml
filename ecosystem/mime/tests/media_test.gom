package tests;

use ecosystem::mime;
use mime::{ErrorKind, Limits, MediaType, Parameter};
use std::testing;

#[test]
fn media_type_parses_parameters_and_quoted_values() -> () {
    let media = testing::expect_ok(
        mime::parse_media_type(
            " Application/JSON ; Charset=\"utf-8\"; note=\"a\\\"b\\\\c\" ",
            Limits::standard(),
        ),
        "media type",
    );
    testing::assert_eq(media.essence, "application/json");
    testing::assert_eq(testing::expect_some(media.parameter("CHARSET"), "charset"), "utf-8");
    testing::assert_eq(testing::expect_some(media.parameter("note"), "note"), "a\"b\\c");
}

#[test]
fn media_type_rejects_malformed_and_conflicting_parameters() -> () {
    for value in Vec::from_array(
        [
            "",
            "text",
            "text/",
            "text/plain tail",
            "text/plain; x",
            "text/plain; x=",
            "text/plain; x=\"unterminated",
            "text/plain; x=one; x=two",
            "text/plain; x=\"a\\\n\"",
        ],
    ) {
        testing::assert_eq(
            testing::expect_err(mime::parse_media_type(value, Limits::standard()), "invalid").kind,
            ErrorKind::Invalid,
        );
    }
}

#[test]
fn media_type_bounds_input_values_and_parameter_count() -> () {
    let value = "text/plain; x=one; y=two";
    for limits in Vec::from_array(
        [
            Limits { max_input_bytes: value.byte_len() - 1, ..Limits::standard() },
            Limits { max_parameters: 1, ..Limits::standard() },
            Limits { max_value_bytes: 2, ..Limits::standard() },
        ],
    ) {
        testing::assert_eq(
            testing::expect_err(mime::parse_media_type(value, limits), "limit").kind,
            ErrorKind::Limit,
        );
    }
}

#[test]
fn media_type_formats_utf8_extended_values() -> () {
    let media = MediaType {
        essence: "Text/Plain",
        parameters: Vec::from_array(
            [
                Parameter { name: "charset", value: "utf-8" },
                Parameter { name: "filename", value: "中 文.txt" },
            ],
        ),
    };
    let encoded = testing::expect_ok(mime::format_media_type(media, Limits::standard()), "format");
    testing::assert_eq(
        encoded,
        "text/plain; charset=utf-8; filename*=utf-8''%E4%B8%AD%20%E6%96%87.txt",
    );
    let parsed = testing::expect_ok(mime::parse_media_type(encoded, Limits::standard()), "parse");
    testing::assert_eq(testing::expect_some(parsed.parameter("filename"), "filename"), "中 文.txt");
}

#[test]
fn media_type_rejects_bad_extended_encoding() -> () {
    for value in Vec::from_array(
        [
            "text/plain; filename*=utf-8''%ZZ",
            "text/plain; filename*=utf-8''%F0%28",
            "text/plain; filename*=utf-8''raw space",
        ],
    ) {
        testing::assert(mime::parse_media_type(value, Limits::standard()).is_err());
    }
    testing::assert_eq(
        testing::expect_err(
            mime::parse_media_type("text/plain; filename*=koi8-r''x", Limits::standard()),
            "charset",
        ).kind,
        ErrorKind::Charset,
    );
}

#[test]
fn media_type_assembles_out_of_order_utf8_continuations() -> () {
    let media = testing::expect_ok(
        mime::parse_media_type(
            "application/octet-stream; filename*1*=%AD%E6%96%87.txt; filename*0*=utf-8''%E4%B8",
            Limits::standard(),
        ),
        "continuation",
    );
    testing::assert_eq(testing::expect_some(media.parameter("filename"), "filename"), "中文.txt");
    let media = testing::expect_ok(
        mime::parse_media_type("text/plain; x*0=hello; x*1*=world%20again", Limits::standard()),
        "mixed continuation",
    );
    testing::assert_eq(testing::expect_some(media.parameter("x"), "x"), "helloworld again");
}

#[test]
fn media_type_rejects_continuation_gaps_duplicates_and_decoded_controls() -> () {
    for value in Vec::from_array(
        [
            "text/plain; x*1=second",
            "text/plain; x*0=first; x*2=third",
            "text/plain; x*0=first; x*0*=utf-8''second",
            "text/plain; x*0=first; x*01=second",
            "text/plain; x*0*=utf-8''%0D%0A",
            "text/plain; x*=utf-8''%00",
            "text/plain; x*0*=utf-8''%E4; x*1*=tail",
        ],
    ) {
        testing::assert(mime::parse_media_type(value, Limits::standard()).is_err());
    }
}

#[test]
fn media_type_formatter_rejects_reserved_names_and_bounds_output() -> () {
    let invalid = MediaType {
        essence: "text/plain",
        parameters: Vec::from_array([Parameter { name: "file*0", value: "x" }]),
    };
    testing::assert_eq(
        testing::expect_err(mime::format_media_type(invalid, Limits::standard()), "name").kind,
        ErrorKind::Invalid,
    );
    let media = MediaType {
        essence: "text/plain",
        parameters: Vec::from_array([Parameter { name: "charset", value: "utf-8" }]),
    };
    let limits = Limits {
        max_output_bytes: "text/plain; charset=utf-8".byte_len() - 1,
        ..Limits::standard(),
    };
    testing::assert_eq(
        testing::expect_err(mime::format_media_type(media, limits), "output").kind,
        ErrorKind::Limit,
    );
}
