package tests;

use ecosystem::mime::multipart;
use multipart::{ErrorKind, Limits, Writer};
use ecosystem::textproto;
use std::bytes;
use std::io;
use io::Write;
use std::testing;

#[test]
fn multipart_writer_streams_headers_and_binary_bodies() -> () {
    let sink = io::Cursor::new(bytes::Bytes::new());
    let writer = testing::expect_ok(Writer::new(sink, "boundary", Limits::standard()), "writer");
    let headers = textproto::Headers::new();
    testing::assert_ok(headers.append("content-type", bytes::Bytes::from_vec(b"text/plain")));
    testing::assert_ok(writer.begin_part(headers));
    testing::assert_ok(writer.write_body_chunk(b"hello".as_slice()));
    testing::assert_ok(writer.begin_part(textproto::Headers::new()));
    testing::assert_ok(
        writer.write_body_chunk(Vec::from_array([0.to_u8(), 255.to_u8()]).as_slice()),
    );
    testing::assert_ok(writer.finish());
    let expected = bytes::Bytes::from_vec(
        b"--boundary\r\nContent-Type: text/plain\r\n\r\nhello\r\n--boundary\r\n\r\n",
    );
    expected.extend_from_slice(Vec::from_array([0.to_u8(), 255.to_u8()]).as_slice());
    expected.extend_from_slice(b"\r\n--boundary--\r\n".as_slice());
    testing::assert(sink.bytes().to_vec() == expected.to_vec());
    testing::assert_eq(writer.body_bytes(), 7);
    testing::assert_eq(writer.wire_bytes(), expected.len());
}

#[test]
fn multipart_writer_rejects_delimiter_collision_across_chunks() -> () {
    let sink = io::Cursor::new(bytes::Bytes::new());
    let writer = testing::expect_ok(Writer::new(sink, "x", Limits::standard()), "writer");
    testing::assert_ok(writer.begin_part(textproto::Headers::new()));
    testing::assert_ok(writer.write_body_chunk(b"safe\r\n--".as_slice()));
    testing::assert_eq(
        testing::expect_err(writer.write_body_chunk(b"x\r\n".as_slice()), "collision").kind,
        ErrorKind::Boundary,
    );
    testing::assert_eq(testing::expect_err(writer.finish(), "terminal").kind, ErrorKind::Closed);
    let sink = io::Cursor::new(bytes::Bytes::new());
    let writer = testing::expect_ok(Writer::new(sink, "x", Limits::standard()), "writer");
    testing::assert_ok(writer.begin_part(textproto::Headers::new()));
    testing::assert_ok(writer.write_body_chunk(b"safe\r\n--x".as_slice()));
    testing::assert_eq(
        testing::expect_err(writer.finish(), "tail marker").kind,
        ErrorKind::Boundary,
    );
}

#[test]
fn multipart_writer_checks_boundary_and_body_limits() -> () {
    for boundary in Vec::from_array(["", "x ", "x\r\ny", "x\"y"]) {
        testing::assert_eq(
            testing::expect_err(
                Writer::new(io::Cursor::new(bytes::Bytes::new()), boundary, Limits::standard()),
                "boundary",
            ).kind,
            ErrorKind::Boundary,
        );
    }
    let sink = io::Cursor::new(bytes::Bytes::new());
    let limits = Limits { max_part_bytes: 2, ..Limits::standard() };
    let writer = testing::expect_ok(Writer::new(sink, "x", limits), "writer");
    testing::assert_ok(writer.begin_part(textproto::Headers::new()));
    testing::assert_eq(
        testing::expect_err(writer.write_body_chunk(b"abc".as_slice()), "body limit").kind,
        ErrorKind::Limit,
    );
    testing::assert_eq(writer.body_bytes(), 0);
    testing::assert_ok(writer.write_body_chunk(b"ab".as_slice()));
    testing::assert_ok(writer.finish());
}

struct ShortWriter {
    data: bytes::Bytes,
    calls: Ref[isize],
}

impl Write for ShortWriter {
    fn write(self: ShortWriter, input: Slice[byte]) -> Result[isize, io::Error] {
        self.calls.set(self.calls.get() + 1);
        self.data.push(input[0]);
        Result::Ok(1)
    }
}

struct FailingWriter {
    calls: Ref[isize],
}

impl Write for FailingWriter {
    fn write(self: FailingWriter, input: Slice[byte]) -> Result[isize, io::Error] {
        self.calls.set(self.calls.get() + 1);
        Result::Err(
            io::Error::new(io::ErrorKind::Other, "write", Option::None, Option::None, "failed"),
        )
    }
}

#[test]
fn multipart_writer_tracks_short_writes_and_terminal_provider_failure() -> () {
    let sink = ShortWriter { data: bytes::Bytes::new(), calls: Ref::new(0) };
    let writer = testing::expect_ok(Writer::new(sink, "x", Limits::standard()), "writer");
    testing::assert_ok(writer.begin_part(textproto::Headers::new()));
    testing::assert_ok(writer.write_body_chunk(b"ab".as_slice()));
    testing::assert_ok(writer.finish());
    testing::assert(sink.data.to_vec() == b"--x\r\n\r\nab\r\n--x--\r\n");
    testing::assert_eq(writer.wire_bytes(), sink.data.len());
    testing::assert_eq(sink.calls.get(), sink.data.len());
    let sink = FailingWriter { calls: Ref::new(0) };
    let writer = testing::expect_ok(Writer::new(sink, "x", Limits::standard()), "writer");
    testing::assert_eq(
        testing::expect_err(writer.begin_part(textproto::Headers::new()), "fault").kind,
        ErrorKind::Io,
    );
    testing::assert_eq(testing::expect_err(writer.finish(), "terminal").kind, ErrorKind::Closed);
    testing::assert_eq(sink.calls.get(), 1);
}
