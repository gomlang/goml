package multipart;

use std::io;

#[derive(Debug, PartialEq)]
pub enum ErrorKind {
    Invalid,
    Truncated,
    Limit,
    Io,
    State,
    Closed,
    Boundary,
}

pub struct Error {
    pub kind: ErrorKind,
    pub offset: isize,
    pub message: string,
    pub cause: Option[io::Error],
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        f"multipart at {self.offset}: {self.message}"
    }
}

impl Debug for Error {
    fn debug(self: Error) -> string {
        self.to_string()
    }
}

fn failure(kind: ErrorKind, offset: isize, message: string) -> Error {
    Error { kind, offset, message, cause: Option::None }
}

pub struct Limits {
    pub max_wire_bytes: isize,
    pub max_preamble_bytes: isize,
    pub max_header_bytes: isize,
    pub max_line_bytes: isize,
    pub max_headers: isize,
    pub max_value_bytes: isize,
    pub max_part_bytes: isize,
    pub max_total_bytes: isize,
    pub max_parts: isize,
}

impl Limits {
    pub fn standard() -> Limits {
        Limits {
            max_wire_bytes: 268435456,
            max_preamble_bytes: 65536,
            max_header_bytes: 65536,
            max_line_bytes: 8192,
            max_headers: 128,
            max_value_bytes: 16384,
            max_part_bytes: 67108864,
            max_total_bytes: 268435456,
            max_parts: 128,
        }
    }

    pub fn validate(self: Limits) -> Result[(), Error] {
        if self.max_wire_bytes < 0 || self.max_preamble_bytes < 0
            || self.max_preamble_bytes > 9223372036854775805
            || self.max_header_bytes < 0
            || self.max_line_bytes < 0
            || self.max_line_bytes > 9223372036854775805
            || self.max_headers < 0
            || self.max_value_bytes < 0
            || self.max_part_bytes < 0
            || self.max_total_bytes < 0
            || self.max_parts < 0 {
            return Result::Err(failure(ErrorKind::Limit, 0, "invalid multipart limits"))
        }
        Result::Ok(())
    }
}

fn boundary_byte(value: byte) -> bool {
    value >= b'a' && value <= b'z' || value >= b'A' && value <= b'Z'
        || value >= b'0' && value <= b'9'
        || value == b'\''
        || value == b'('
        || value == b')'
        || value == b'+'
        || value == b'_'
        || value == b','
        || value == b'-'
        || value == b'.'
        || value == b'/'
        || value == b':'
        || value == b'='
        || value == b'?'
        || value == b' '
}

pub fn validate_boundary(boundary: string) -> Result[(), Error] {
    if boundary.byte_len() == 0 || boundary.byte_len() > 70 {
        return Result::Err(failure(ErrorKind::Boundary, 0, "boundary length must be 1..70"))
    }
    if boundary.byte_get(boundary.byte_len() - 1) == b' ' {
        return Result::Err(failure(ErrorKind::Boundary, 0, "boundary ends with space"))
    }
    for byte in boundary.to_bytes() {
        if !boundary_byte(byte) {
            return Result::Err(failure(ErrorKind::Boundary, 0, "invalid boundary byte"))
        }
    }
    Result::Ok(())
}
