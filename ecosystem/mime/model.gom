package mime;

#[derive(Debug, PartialEq)]
pub enum ErrorKind {
    Invalid,
    Limit,
    Charset,
}

pub struct Error {
    pub kind: ErrorKind,
    pub offset: isize,
    pub message: string,
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        f"mime at {self.offset}: {self.message}"
    }
}

impl Debug for Error {
    fn debug(self: Error) -> string {
        self.to_string()
    }
}

fn failure(kind: ErrorKind, offset: isize, message: string) -> Error {
    Error { kind, offset, message }
}

pub struct Limits {
    pub max_input_bytes: isize,
    pub max_parameters: isize,
    pub max_value_bytes: isize,
    pub max_output_bytes: isize,
}

impl Limits {
    pub fn standard() -> Limits {
        Limits {
            max_input_bytes: 65536,
            max_parameters: 128,
            max_value_bytes: 16384,
            max_output_bytes: 65536,
        }
    }

    pub fn validate(self: Limits) -> Result[(), Error] {
        if self.max_input_bytes < 0 || self.max_parameters < 0 || self.max_value_bytes < 0
            || self.max_output_bytes < 0 {
            return Result::Err(failure(ErrorKind::Limit, 0, "invalid MIME limits"))
        }
        Result::Ok(())
    }
}

pub struct Parameter {
    pub name: string,
    pub value: string,
}

pub struct MediaType {
    pub essence: string,
    pub parameters: Vec[Parameter],
}

impl MediaType {
    pub fn parameter(self: MediaType, name: string) -> Option[string] {
        let name = name.to_ascii_lowercase();
        for parameter in self.parameters {
            if parameter.name == name {
                return Option::Some(parameter.value)
            }
        }
        Option::None
    }
}
