package quotedprintable;

use std::io;

#[derive(Debug, PartialEq)]
pub enum ErrorKind {
    Invalid,
    Limit,
    Io,
    State,
    Closed,
}

#[derive(Debug, PartialEq)]
pub enum Mode {
    Text,
    Binary,
}

pub struct Error {
    pub kind: ErrorKind,
    pub offset: isize,
    pub message: string,
    pub cause: Option[io::Error],
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        f"quotedprintable at {self.offset}: {self.message}"
    }
}

impl Debug for Error {
    fn debug(self: Error) -> string {
        self.to_string()
    }
}

fn failure(kind: ErrorKind, offset: isize, message: string) -> Error {
    Error { kind, offset, message, cause: Option::None }
}

pub struct Limits {
    pub max_input_bytes: isize,
    pub max_output_bytes: isize,
    pub max_lines: isize,
}

impl Limits {
    pub fn standard() -> Limits {
        Limits { max_input_bytes: 67108864, max_output_bytes: 67108864, max_lines: 1048576 }
    }

    pub fn validate(self: Limits) -> Result[(), Error] {
        if self.max_input_bytes < 0 || self.max_input_bytes == 9223372036854775807
            || self.max_output_bytes < 0
            || self.max_lines < 0 {
            return Result::Err(failure(ErrorKind::Limit, 0, "invalid quoted-printable limits"))
        }
        Result::Ok(())
    }
}

fn hex_value(value: byte) -> Option[byte] {
    if value >= b'0' && value <= b'9' {
        Option::Some(value - b'0')
    } else if value >= b'A' && value <= b'F' {
        Option::Some(value - b'A' + 10)
    } else if value >= b'a' && value <= b'f' {
        Option::Some(value - b'a' + 10)
    } else {
        Option::None
    }
}

fn hex_digit(value: byte) -> byte {
    if value < 10 {
        b'0' + value
    } else {
        b'A' + value - 10
    }
}
