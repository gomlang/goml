package tests;

use ecosystem::mime::quotedprintable;
use quotedprintable::{Error, ErrorKind, Limits, Mode, Reader, Writer};
use std::bytes;
use std::io;
use io::Read;
use std::testing;

fn collect[R: Read](reader: Reader[R], width: isize) -> Result[bytes::Bytes, Error] {
    let result = bytes::Bytes::new();
    let scratch = bytes::Bytes::new();
    for _ in 0..width {
        scratch.push(0);
    }
    loop {
        let count = reader.read_chunk(scratch.as_mut_slice())?;
        if count == 0 {
            return Result::Ok(result)
        }
        result.extend_from_slice(scratch.slice(0, count));
    }
}

#[test]
fn quoted_printable_known_bytes_and_chunk_splits() -> () {
    let input = bytes::Bytes::from_vec(b"a= b \r\nc\t");
    for width in Vec::from_array([1, 2, 3, input.len()]) {
        let sink = io::Cursor::new(bytes::Bytes::new());
        let writer = testing::expect_ok(Writer::new(sink, Limits::standard()), "writer");
        let mut offset = 0;
        while offset < input.len() {
            let end = if offset + width < input.len() {
                offset + width
            } else {
                input.len()
            };
            testing::assert_ok(writer.write_chunk(input.slice(offset, end)));
            offset = end;
        }
        testing::assert_ok(writer.finish());
        testing::assert(sink.bytes().to_vec() == b"a=3D b=20\r\nc=09");
        for read_width in Vec::from_array([1, 2, 7]) {
            let reader = testing::expect_ok(
                Reader::new(io::Cursor::new(sink.bytes()), Limits::standard()),
                "reader",
            );
            testing::assert(
                testing::expect_ok(collect(reader, read_width), "decode").to_vec() == input.to_vec(),
            );
        }
    }
}

#[test]
fn quoted_printable_folds_at_76_wire_characters() -> () {
    let input = bytes::Bytes::new();
    for _ in 0..100 {
        input.push(b'A');
    }
    let sink = io::Cursor::new(bytes::Bytes::new());
    let writer = testing::expect_ok(Writer::new(sink, Limits::standard()), "writer");
    testing::assert_ok(writer.write_chunk(input.as_slice()));
    testing::assert_ok(writer.finish());
    let expected = bytes::Bytes::new();
    for _ in 0..75 {
        expected.push(b'A');
    }
    expected.extend_from_slice(b"=\r\n".as_slice());
    for _ in 0..25 {
        expected.push(b'A');
    }
    testing::assert(sink.bytes().to_vec() == expected.to_vec());
    let reader = testing::expect_ok(
        Reader::new(io::Cursor::new(sink.bytes()), Limits::standard()),
        "reader",
    );
    testing::assert(testing::expect_ok(collect(reader, 3), "decode").to_vec() == input.to_vec());
}

#[test]
fn quoted_printable_folds_without_raw_trailing_space() -> () {
    let input = bytes::Bytes::new();
    for _ in 0..74 {
        input.push(b'A');
    }
    input.extend_from_slice(b"  B".as_slice());
    let sink = io::Cursor::new(bytes::Bytes::new());
    let writer = testing::expect_ok(Writer::new(sink, Limits::standard()), "writer");
    for byte in input.as_slice() {
        testing::assert_ok(writer.write_chunk(Vec::from_array([byte]).as_slice()));
    }
    testing::assert_ok(writer.finish());
    let reader = testing::expect_ok(
        Reader::new(io::Cursor::new(sink.bytes()), Limits::standard()),
        "reader",
    );
    testing::assert(testing::expect_ok(collect(reader, 1), "decode").to_vec() == input.to_vec());
}

#[test]
fn quoted_printable_rejects_malformed_wire() -> () {
    for wire in Vec::from_array(
        [
            bytes::Bytes::from_vec(b"a=\n"),
            bytes::Bytes::from_vec(b"a=G0"),
            bytes::Bytes::from_vec(b"a="),
            bytes::Bytes::from_vec(b"abc \r\n"),
            bytes::Bytes::from_vec(b"abc\n"),
            bytes::Bytes::from_vec(b"abc\r"),
            bytes::Bytes::from_vec(Vec::from_array([255.to_u8()])),
        ],
    ) {
        let reader = testing::expect_ok(
            Reader::new(io::Cursor::new(wire), Limits::standard()),
            "reader",
        );
        testing::assert_eq(
            testing::expect_err(collect(reader, 4), "invalid").kind,
            ErrorKind::Invalid,
        );
    }
}

#[test]
fn quoted_printable_accepts_space_before_soft_break() -> () {
    let reader = testing::expect_ok(
        Reader::new(io::Cursor::new(bytes::Bytes::from_vec(b"a =\r\nb")), Limits::standard()),
        "reader",
    );
    testing::assert(testing::expect_ok(collect(reader, 1), "decode").to_vec() == b"a b");
}

#[test]
fn quoted_printable_binary_mode_escapes_line_break_bytes() -> () {
    let source = bytes::Bytes::from_vec(b"a\r\nb\nc\r");
    let sink = io::Cursor::new(bytes::Bytes::new());
    let writer = testing::expect_ok(
        Writer::with_mode(sink, Limits::standard(), Mode::Binary),
        "binary writer",
    );
    testing::assert_ok(writer.write_chunk(source.slice(0, 2)));
    testing::assert_ok(writer.write_chunk(source.slice(2, source.len())));
    testing::assert_ok(writer.finish());
    testing::assert(sink.bytes().to_vec() == b"a=0D=0Ab=0Ac=0D");
    let reader = testing::expect_ok(
        Reader::new(io::Cursor::new(sink.bytes()), Limits::standard()),
        "reader",
    );
    testing::assert(testing::expect_ok(collect(reader, 2), "decode").to_vec() == source.to_vec());
}
