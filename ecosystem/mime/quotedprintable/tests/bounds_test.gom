package tests;

use ecosystem::mime::quotedprintable;
use quotedprintable::{ErrorKind, Limits, Reader, Writer};
use std::bytes;
use std::io;
use io::{Read, Write};
use std::testing;

#[test]
fn quoted_printable_quotas_and_line_limit_are_exact() -> () {
    let wire = bytes::Bytes::from_vec(b"=41\r\n");
    let limits = Limits { max_input_bytes: wire.len(), max_output_bytes: 3, max_lines: 1 };
    let reader = testing::expect_ok(Reader::new(io::Cursor::new(wire), limits), "reader");
    let output = bytes::Bytes::from_vec(Vec::from_array([0.to_u8(), 0.to_u8(), 0.to_u8()]));
    testing::assert_eq(testing::expect_ok(reader.read_chunk(output.as_mut_slice()), "read"), 3);
    testing::assert(output.to_vec() == b"A\r\n");
    testing::assert_eq(testing::expect_ok(reader.read_chunk(output.as_mut_slice()), "eof"), 0);
    let reader = testing::expect_ok(
        Reader::new(io::Cursor::new(wire), Limits { max_output_bytes: 2, ..limits }),
        "limited reader",
    );
    testing::assert_eq(
        testing::expect_err(reader.read_chunk(output.as_mut_slice()), "output quota").kind,
        ErrorKind::Limit,
    );
    let reader = testing::expect_ok(
        Reader::new(io::Cursor::new(wire), Limits { max_input_bytes: wire.len() - 1, ..limits }),
        "input limited reader",
    );
    testing::assert_eq(
        testing::expect_err(reader.read_chunk(output.as_mut_slice()), "input quota").kind,
        ErrorKind::Limit,
    );
    let too_long = bytes::Bytes::new();
    for _ in 0..77 {
        too_long.push(b'x');
    }
    let reader = testing::expect_ok(
        Reader::new(io::Cursor::new(too_long), Limits::standard()),
        "long",
    );
    testing::assert_eq(
        testing::expect_err(reader.read_chunk(output.as_mut_slice()), "line quota").kind,
        ErrorKind::Limit,
    );
}

struct FailingReader {
    calls: Ref[isize],
}

impl Read for FailingReader {
    fn read(self: FailingReader, output: MutSlice[byte]) -> Result[isize, io::Error] {
        self.calls.set(self.calls.get() + 1);
        Result::Err(
            io::Error::new(io::ErrorKind::Other, "read", Option::None, Option::None, "failed"),
        )
    }
}

struct ShortWriter {
    data: bytes::Bytes,
    calls: Ref[isize],
}

impl Write for ShortWriter {
    fn write(self: ShortWriter, input: Slice[byte]) -> Result[isize, io::Error] {
        self.calls.set(self.calls.get() + 1);
        self.data.push(input[0]);
        Result::Ok(1)
    }
}

struct FailingWriter {
    calls: Ref[isize],
}

impl Write for FailingWriter {
    fn write(self: FailingWriter, input: Slice[byte]) -> Result[isize, io::Error] {
        self.calls.set(self.calls.get() + 1);
        Result::Err(
            io::Error::new(io::ErrorKind::Other, "write", Option::None, Option::None, "failed"),
        )
    }
}

#[test]
fn quoted_printable_provider_failures_are_terminal() -> () {
    let source = FailingReader { calls: Ref::new(0) };
    let reader = testing::expect_ok(Reader::new(source, Limits::standard()), "reader");
    let output = bytes::Bytes::from_vec(Vec::from_array([0.to_u8()]));
    testing::assert_eq(
        testing::expect_err(reader.read_chunk(output.as_mut_slice()), "read fault").kind,
        ErrorKind::Io,
    );
    testing::assert_eq(
        testing::expect_err(reader.read_chunk(output.as_mut_slice()), "terminal reader").kind,
        ErrorKind::Closed,
    );
    testing::assert_eq(source.calls.get(), 1);
    let sink = FailingWriter { calls: Ref::new(0) };
    let writer = testing::expect_ok(Writer::new(sink, Limits::standard()), "writer");
    testing::assert_ok(writer.write_chunk(b"abc".as_slice()));
    testing::assert_eq(testing::expect_err(writer.finish(), "write fault").kind, ErrorKind::Io);
    testing::assert_eq(
        testing::expect_err(writer.finish(), "terminal writer").kind,
        ErrorKind::Closed,
    );
    testing::assert_eq(sink.calls.get(), 1);
}

#[test]
fn quoted_printable_short_writes_preserve_confirmed_progress() -> () {
    let sink = ShortWriter { data: bytes::Bytes::new(), calls: Ref::new(0) };
    let writer = testing::expect_ok(Writer::new(sink, Limits::standard()), "writer");
    testing::assert_ok(writer.write_chunk(b"a=".as_slice()));
    testing::assert_ok(writer.finish());
    testing::assert(sink.data.to_vec() == b"a=3D");
    testing::assert_eq(writer.produced(), 4);
    testing::assert_eq(sink.calls.get(), 4);
}
