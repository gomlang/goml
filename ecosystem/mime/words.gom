package mime;

use std::bytes;
use std::encoding::base64;
use std::utf8;

#[derive(Debug, PartialEq)]
pub enum WordEncoding {
    Base64,
    Quoted,
}

fn q_decode(value: string, offset: isize) -> Result[bytes::Bytes, Error] {
    let output = bytes::Bytes::new();
    let mut index = 0;
    while index < value.byte_len() {
        let byte = value.byte_get(index);
        if byte == b'_' {
            output.push(b' ');
            index += 1;
        } else if byte == b'=' {
            if index + 2 >= value.byte_len() {
                return Result::Err(failure(ErrorKind::Invalid, offset + index, "short Q escape"))
            }
            let high = hex_value(value.byte_get(index + 1)).ok_or(
                failure(ErrorKind::Invalid, offset + index, "invalid Q escape"),
            )?;
            let low = hex_value(value.byte_get(index + 2)).ok_or(
                failure(ErrorKind::Invalid, offset + index, "invalid Q escape"),
            )?;
            output.push(high * 16 + low);
            index += 3;
        } else if byte >= 33 && byte <= 126 && byte != b'?' {
            output.push(byte);
            index += 1;
        } else {
            return Result::Err(failure(ErrorKind::Invalid, offset + index, "invalid Q byte"))
        }
    }
    Result::Ok(output)
}

fn convert_word(charset: string, data: bytes::Bytes, offset: isize) -> Result[string, Error] {
    let charset = charset.to_ascii_lowercase();
    let decoded = if charset == "utf-8" {
        utf8::decode(data.to_vec()).map_err(
            |error| failure(ErrorKind::Invalid, offset, error.to_string()),
        )?
    } else if charset == "us-ascii" {
        for byte in data.as_slice() {
            if byte >= 128 {
                return Result::Err(failure(ErrorKind::Invalid, offset, "non-ASCII word byte"))
            }
        }
        string_from_utf8(data.to_vec()).1
    } else if charset == "iso-8859-1" {
        let mut output = "";
        for byte in data.as_slice() {
            output += char_from_u32(byte.to_u32()).unwrap_or('�').to_string();
        }
        output
    } else {
        return Result::Err(failure(ErrorKind::Charset, offset, "unsupported word charset"))
    };
    for byte in decoded.to_bytes() {
        if byte < 32 && byte != b'\t' || byte == 127 {
            return Result::Err(failure(ErrorKind::Invalid, offset, "control in encoded word"))
        }
    }
    Result::Ok(decoded)
}

pub fn decode_word(value: string, limits: Limits) -> Result[string, Error] {
    limits.validate()?;
    if value.byte_len() > limits.max_input_bytes || value.byte_len() > 75 {
        return Result::Err(failure(ErrorKind::Limit, 0, "encoded word exceeds limit"))
    }
    if !value.starts_with("=?") || !value.ends_with("?=") {
        return Result::Err(failure(ErrorKind::Invalid, 0, "invalid encoded word framing"))
    }
    let inside = value.byte_slice(2, value.byte_len() - 2);
    let (charset, rest) = inside.split_once("?").ok_or(
        failure(ErrorKind::Invalid, 2, "missing word charset delimiter"),
    )?;
    if !token(charset) || rest.byte_len() < 2 || rest.byte_get(1) != b'?' {
        return Result::Err(failure(ErrorKind::Invalid, 2, "invalid encoded word header"))
    }
    let payload = rest.byte_slice(2, rest.byte_len());
    let data = if rest.byte_get(0) == b'B' || rest.byte_get(0) == b'b' {
        base64::decode(payload).map_err(|error| failure(ErrorKind::Invalid, 0, error.to_string()))?
    } else if rest.byte_get(0) == b'Q' || rest.byte_get(0) == b'q' {
        q_decode(payload, 2 + charset.byte_len() + 3)?
    } else {
        return Result::Err(failure(ErrorKind::Invalid, 0, "unknown encoded word scheme"))
    };
    let result = convert_word(charset, data, 0)?;
    if result.byte_len() > limits.max_output_bytes {
        return Result::Err(failure(ErrorKind::Limit, 0, "decoded word exceeds output limit"))
    }
    Result::Ok(result)
}

fn append_bounded(output: string, value: string, limit: isize) -> Result[string, Error] {
    if output.byte_len() > limit || value.byte_len() > limit - output.byte_len() {
        return Result::Err(failure(ErrorKind::Limit, 0, "decoded header exceeds output limit"))
    }
    Result::Ok(output + value)
}

pub fn decode_header(value: string, limits: Limits) -> Result[string, Error] {
    limits.validate()?;
    if value.byte_len() > limits.max_input_bytes {
        return Result::Err(failure(ErrorKind::Limit, 0, "header exceeds input limit"))
    }
    for byte in value.to_bytes() {
        if byte < 32 && byte != b'\t' || byte == 127 {
            return Result::Err(failure(ErrorKind::Invalid, 0, "invalid header byte"))
        }
    }
    let mut output = "";
    let mut cursor = 0;
    let mut previous_word = false;
    while cursor < value.byte_len() {
        let mut start = cursor;
        while start + 1 < value.byte_len()
            && !(value.byte_get(start) == b'=' && value.byte_get(start + 1) == b'?') {
            start += 1;
        }
        if start + 1 >= value.byte_len() {
            return append_bounded(
                output,
                value.byte_slice(cursor, value.byte_len()),
                limits.max_output_bytes,
            )
        }
        let between = value.byte_slice(cursor, start);
        let mut whitespace = true;
        for byte in between.to_bytes() {
            if !horizontal(byte) {
                whitespace = false;
            }
        }
        if !previous_word || !whitespace {
            output = append_bounded(output, between, limits.max_output_bytes)?;
        }
        let mut delimiter = start + 2;
        while delimiter < value.byte_len() && value.byte_get(delimiter) != b'?' {
            delimiter += 1;
        }
        if delimiter + 2 >= value.byte_len() || value.byte_get(delimiter + 2) != b'?' {
            return Result::Err(failure(ErrorKind::Invalid, start, "invalid encoded word header"))
        }
        let mut end = delimiter + 3;
        while end + 1 < value.byte_len()
            && !(value.byte_get(end) == b'?' && value.byte_get(end + 1) == b'=') {
            end += 1;
        }
        if end + 1 >= value.byte_len() {
            return Result::Err(failure(ErrorKind::Invalid, start, "unterminated encoded word"))
        }
        let word = decode_word(value.byte_slice(start, end + 2), limits)?;
        output = append_bounded(output, word, limits.max_output_bytes)?;
        cursor = end + 2;
        previous_word = true;
    }
    Result::Ok(output)
}

fn q_encode(data: bytes::Bytes) -> string {
    let output: Vec[byte] = Vec::new();
    for byte in data.as_slice() {
        if byte == b' ' {
            output.push(b'_');
        } else if byte >= 33 && byte <= 126 && byte != b'=' && byte != b'?' && byte != b'_' {
            output.push(byte);
        } else {
            output.push(b'=');
            output.push(hex_digit(byte / 16));
            output.push(hex_digit(byte % 16));
        }
    }
    string_from_utf8(output).1
}

fn encoded_chunk(data: bytes::Bytes, encoding: WordEncoding) -> string {
    match encoding {
        WordEncoding::Base64 => "=?UTF-8?B?" + base64::encode(data) + "?=",
        WordEncoding::Quoted => "=?UTF-8?Q?" + q_encode(data) + "?=",
    }
}

fn chunk_width(data: bytes::Bytes, encoding: WordEncoding) -> isize {
    match encoding {
        WordEncoding::Base64 => ((data.len() + 2) / 3) * 4,
        WordEncoding::Quoted => q_encode(data).byte_len(),
    }
}

pub fn encode_word(value: string, encoding: WordEncoding, limits: Limits) -> Result[string, Error] {
    limits.validate()?;
    if value.byte_len() > limits.max_input_bytes {
        return Result::Err(failure(ErrorKind::Limit, 0, "word exceeds input limit"))
    }
    for byte in value.to_bytes() {
        if byte < 32 && byte != b'\t' || byte == 127 {
            return Result::Err(failure(ErrorKind::Invalid, 0, "invalid word byte"))
        }
    }
    let current = bytes::Bytes::new();
    let mut result = "";
    for character in value.chars() {
        let encoded = utf8::encode_char(character);
        let candidate = current.copy();
        candidate.extend_from_slice(encoded.as_slice());
        if chunk_width(candidate, encoding) > 63 && current.len() > 0 {
            let separator = if result == "" {
                ""
            } else {
                " "
            };
            result = append_bounded(
                result,
                separator + encoded_chunk(current, encoding),
                limits.max_output_bytes,
            )?;
            current.clear();
        }
        current.extend_from_slice(encoded.as_slice());
    }
    let separator = if result == "" {
        ""
    } else {
        " "
    };
    append_bounded(result, separator + encoded_chunk(current, encoding), limits.max_output_bytes)
}
