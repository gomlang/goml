package bigint;

fn import_bytes(bytes: Slice[byte], little_endian: bool, limits: Limits) -> Result[BigUint, Error] {
    limits.validate()?;
    if bytes.len() > limits.max_bits / 8 + 1 {
        return Result::Err(Error::LimitExceeded("bytes"))
    }
    let output = zeros(
        bytes.len() / 4
            + if bytes.len() % 4 != 0 {
                1
            } else {
                0
            },
    );
    for index in 0..bytes.len() {
        let source = if little_endian {
            index
        } else {
            bytes.len() - 1 - index
        };
        output[index / 4] = output[index / 4] | (bytes[source].to_u32() << ((index % 4) * 8));
    }
    check_bits(normalized(output), limits)
}

fn import_signed_bytes(bytes: Slice[byte], little_endian: bool, limits: Limits) -> Result[
    BigInt,
    Error,
] {
    limits.validate()?;
    if bytes.len() == 0 {
        return Result::Ok(BigInt::zero())
    }
    if bytes.len() > limits.max_bits / 8 + 1 {
        return Result::Err(Error::LimitExceeded("bytes"))
    }
    let negative = (bytes[if little_endian {
        bytes.len() - 1
    } else {
        0
    }]
        & 128)
        != 0;
    let magnitude: Vec[byte] = Vec::with_capacity(bytes.len());
    let mut carry: u16 = if negative {
        1
    } else {
        0
    };
    for index in 0..bytes.len() {
        let value = bytes[if little_endian {
            index
        } else {
            bytes.len() - 1 - index
        }];
        if negative {
            let inverted = (~value).to_u16() + carry;
            magnitude.push(inverted.to_u8());
            carry = inverted >> 8;
        } else {
            magnitude.push(value);
        }
    }
    Result::Ok(
        BigInt::from_sign_magnitude(negative, import_bytes(magnitude.as_slice(), true, limits)?),
    )
}

impl BigUint {
    pub fn from_bytes_le(bytes: Slice[byte]) -> Result[BigUint, Error] {
        import_bytes(bytes, true, Limits::standard())
    }

    pub fn from_bytes_be(bytes: Slice[byte]) -> Result[BigUint, Error] {
        import_bytes(bytes, false, Limits::standard())
    }

    pub fn from_bytes_le_with_limits(bytes: Slice[byte], limits: Limits) -> Result[BigUint, Error] {
        import_bytes(bytes, true, limits)
    }

    pub fn from_bytes_be_with_limits(bytes: Slice[byte], limits: Limits) -> Result[BigUint, Error] {
        import_bytes(bytes, false, limits)
    }

    pub fn to_bytes_le(self: BigUint) -> Vec[byte] {
        if self.is_zero() {
            return Vec::from_array([0])
        }
        let output = Vec::with_capacity(self.bits() / 8 + 1);
        for limb in self.limbs.iter() {
            for index in 0..4 {
                output.push((limb >> (index * 8)).to_u8());
            }
        }
        while output.len() > 1 && output[output.len() - 1] == 0 {
            output.pop();
        }
        output
    }

    pub fn to_bytes_be(self: BigUint) -> Vec[byte] {
        let output = self.to_bytes_le();
        output.reverse();
        output
    }
}

impl BigInt {
    pub fn from_signed_bytes_le(bytes: Slice[byte]) -> Result[BigInt, Error] {
        import_signed_bytes(bytes, true, Limits::standard())
    }

    pub fn from_signed_bytes_be(bytes: Slice[byte]) -> Result[BigInt, Error] {
        import_signed_bytes(bytes, false, Limits::standard())
    }

    pub fn from_signed_bytes_le_with_limits(bytes: Slice[byte], limits: Limits) -> Result[
        BigInt,
        Error,
    ] {
        import_signed_bytes(bytes, true, limits)
    }

    pub fn from_signed_bytes_be_with_limits(bytes: Slice[byte], limits: Limits) -> Result[
        BigInt,
        Error,
    ] {
        import_signed_bytes(bytes, false, limits)
    }

    pub fn to_signed_bytes_le(self: BigInt) -> Vec[byte] {
        let output = self.magnitude.to_bytes_le();
        if self.negative {
            let mut carry: u16 = 1;
            for index in 0..output.len() {
                let value = (~output[index]).to_u16() + carry;
                output[index] = value.to_u8();
                carry = value >> 8;
            }
            if (output[output.len() - 1] & 128) == 0 {
                output.push(255);
            }
            while output.len() > 1 && output[output.len() - 1] == 255
                && (output[output.len() - 2] & 128) != 0 {
                output.pop();
            }
        } else if (output[output.len() - 1] & 128) != 0 {
            output.push(0);
        }
        output
    }

    pub fn to_signed_bytes_be(self: BigInt) -> Vec[byte] {
        let output = self.to_signed_bytes_le();
        output.reverse();
        output
    }
}
