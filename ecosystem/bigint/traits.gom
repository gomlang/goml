package bigint;

use std::cmp::{Ord, PartialOrd};

impl PartialEq for BigUint {
    fn eq(self: BigUint, other: BigUint) -> bool {
        self.cmp(other) == Ordering::Equal
    }
}

impl Eq for BigUint {}

impl PartialOrd for BigUint {
    fn partial_cmp(self: BigUint, other: BigUint) -> Option[Ordering] {
        Option::Some(self.cmp(other))
    }
}

impl Ord for BigUint {
    fn cmp(self: BigUint, other: BigUint) -> Ordering {
        BigUint::cmp(self, other)
    }
}

impl Hash for BigUint {
    fn hash(self: BigUint) -> u64 {
        let mut hash: u64 = 14695981039346656037;
        for limb in self.limbs.iter() {
            hash = (hash ^ limb.to_u64()) * 1099511628211;
        }
        hash
    }
}

impl Debug for BigUint {
    fn debug(self: BigUint) -> string {
        "BigUint(" + self.to_string() + ")"
    }
}

impl Default for BigUint {
    fn default() -> BigUint {
        BigUint::zero()
    }
}

impl PartialEq for BigInt {
    fn eq(self: BigInt, other: BigInt) -> bool {
        self.negative == other.negative && self.magnitude == other.magnitude
    }
}

impl Eq for BigInt {}

impl PartialOrd for BigInt {
    fn partial_cmp(self: BigInt, other: BigInt) -> Option[Ordering] {
        Option::Some(self.cmp(other))
    }
}

impl Ord for BigInt {
    fn cmp(self: BigInt, other: BigInt) -> Ordering {
        BigInt::cmp(self, other)
    }
}

impl Hash for BigInt {
    fn hash(self: BigInt) -> u64 {
        self.magnitude.hash()
            ^ if self.negative {
                11400714819323198485
            } else {
                0
            }
    }
}

impl Debug for BigInt {
    fn debug(self: BigInt) -> string {
        "BigInt(" + self.to_string() + ")"
    }
}

impl Default for BigInt {
    fn default() -> BigInt {
        BigInt::zero()
    }
}
