package bigint;

impl BigUint {
    pub fn to_u8(self: BigUint) -> Option[u8] {
        let value = self.to_u64()?;
        if value > 255 {
            Option::None
        } else {
            Option::Some(value.to_u8())
        }
    }

    pub fn to_u16(self: BigUint) -> Option[u16] {
        let value = self.to_u64()?;
        if value > 65535 {
            Option::None
        } else {
            Option::Some(value.to_u16())
        }
    }

    pub fn to_i8(self: BigUint) -> Option[i8] {
        let value = self.to_i64()?;
        if value < -128 || value > 127 {
            Option::None
        } else {
            Option::Some(value.to_i8())
        }
    }

    pub fn to_i16(self: BigUint) -> Option[i16] {
        let value = self.to_i64()?;
        if value < -32768 || value > 32767 {
            Option::None
        } else {
            Option::Some(value.to_i16())
        }
    }

    pub fn to_usize(self: BigUint) -> Option[usize] {
        self.to_u64().map(|value| value.to_usize())
    }

    pub fn to_isize(self: BigUint) -> Option[isize] {
        self.to_i64().map(|value| value.to_isize())
    }
}

impl BigInt {
    pub fn to_u8(self: BigInt) -> Option[u8] {
        let value = self.to_u64()?;
        if value > 255 {
            Option::None
        } else {
            Option::Some(value.to_u8())
        }
    }

    pub fn to_u16(self: BigInt) -> Option[u16] {
        let value = self.to_u64()?;
        if value > 65535 {
            Option::None
        } else {
            Option::Some(value.to_u16())
        }
    }

    pub fn to_i8(self: BigInt) -> Option[i8] {
        let value = self.to_i64()?;
        if value < -128 || value > 127 {
            Option::None
        } else {
            Option::Some(value.to_i8())
        }
    }

    pub fn to_i16(self: BigInt) -> Option[i16] {
        let value = self.to_i64()?;
        if value < -32768 || value > 32767 {
            Option::None
        } else {
            Option::Some(value.to_i16())
        }
    }

    pub fn to_usize(self: BigInt) -> Option[usize] {
        self.to_u64().map(|value| value.to_usize())
    }

    pub fn to_isize(self: BigInt) -> Option[isize] {
        self.to_i64().map(|value| value.to_isize())
    }
}
