package bigint;

const BASE: u64 = 4294967296;

fn subtract(left: BigUint, right: BigUint) -> BigUint {
    let output = Vec::with_capacity(left.limbs.len());
    let mut borrow: u64 = 0;
    for index in 0..left.limbs.len() {
        let a = left.limbs.get(index).to_u64();
        let b = if index < right.limbs.len() {
            right.limbs.get(index).to_u64()
        } else {
            0
        };
        if a < b + borrow {
            output.push((a + BASE - b - borrow).to_u32());
            borrow = 1;
        } else {
            output.push((a - b - borrow).to_u32());
            borrow = 0;
        }
    }
    normalized(output)
}

fn div_small(value: BigUint, divisor: u32) -> (BigUint, u32) {
    let output = zeros(value.limbs.len());
    let mut remainder: u64 = 0;
    let mut index = value.limbs.len();
    while index > 0 {
        index -= 1;
        let pair = (remainder << 32) | value.limbs.get(index).to_u64();
        output[index] = (pair / divisor.to_u64()).to_u32();
        remainder = pair % divisor.to_u64();
    }
    return (normalized(output), remainder.to_u32())
}

fn shift_limbs_left(value: BigUint, shift: isize) -> Vec[u32] {
    let output = Vec::with_capacity(value.limbs.len() + 1);
    let mut carry: u64 = 0;
    for limb in value.limbs.iter() {
        let pair = (limb.to_u64() << shift) | carry;
        output.push(pair.to_u32());
        carry = pair >> 32;
    }
    if carry != 0 {
        output.push(carry.to_u32());
    }
    output
}

fn divide_multi(left: BigUint, right: BigUint) -> (BigUint, BigUint) {
    let n = right.limbs.len();
    let m = left.limbs.len() - n;
    let shift = 32 - limb_bits(right.limbs.get(n - 1));
    let divisor = shift_limbs_left(right, shift);
    let dividend = shift_limbs_left(left, shift);
    while dividend.len() < left.limbs.len() + 1 {
        dividend.push(0);
    }
    let quotient = zeros(m + 1);
    let high = divisor[n - 1].to_u64();
    let next = divisor[n - 2].to_u64();
    let mut position = m + 1;
    while position > 0 {
        position -= 1;
        let numerator = (dividend[position + n].to_u64() << 32)
            | dividend[position + n - 1].to_u64();
        let mut estimate = numerator / high;
        let mut remainder = numerator % high;
        if estimate >= BASE {
            estimate = BASE - 1;
            remainder = numerator - estimate * high;
        }
        while remainder < BASE
            && estimate * next > (remainder << 32) + dividend[position + n - 2].to_u64() {
            estimate -= 1;
            remainder += high;
        }
        let mut carry: u64 = 0;
        let mut borrow: u64 = 0;
        for index in 0..n {
            let product = estimate * divisor[index].to_u64() + carry;
            carry = product >> 32;
            let subtrahend = product.to_u32().to_u64() + borrow;
            let current = dividend[position + index].to_u64();
            if current < subtrahend {
                dividend[position + index] = (current + BASE - subtrahend).to_u32();
                borrow = 1;
            } else {
                dividend[position + index] = (current - subtrahend).to_u32();
                borrow = 0;
            }
        }
        let top = dividend[position + n].to_u64();
        let subtrahend = carry + borrow;
        let negative = top < subtrahend;
        dividend[position + n] = if negative {
            (top + BASE - subtrahend).to_u32()
        } else {
            (top - subtrahend).to_u32()
        };
        if negative {
            estimate -= 1;
            let mut carry: u64 = 0;
            for index in 0..n {
                let sum = dividend[position + index].to_u64() + divisor[index].to_u64() + carry;
                dividend[position + index] = sum.to_u32();
                carry = sum >> 32;
            }
            dividend[position + n] = (dividend[position + n].to_u64() + carry).to_u32();
        }
        quotient[position] = estimate.to_u32();
    }
    dividend.truncate(n);
    let remainder = shift_right(normalized(dividend), shift);
    (normalized(quotient), remainder)
}

impl BigUint {
    pub fn add(self: BigUint, other: BigUint) -> BigUint {
        let length = if self.limbs.len() > other.limbs.len() {
            self.limbs.len()
        } else {
            other.limbs.len()
        };
        let output = Vec::with_capacity(length + 1);
        let mut carry: u64 = 0;
        for index in 0..length {
            let a = if index < self.limbs.len() {
                self.limbs.get(index).to_u64()
            } else {
                0
            };
            let b = if index < other.limbs.len() {
                other.limbs.get(index).to_u64()
            } else {
                0
            };
            let sum = a + b + carry;
            output.push(sum.to_u32());
            carry = sum >> 32;
        }
        if carry != 0 {
            output.push(carry.to_u32());
        }
        normalized(output)
    }

    pub fn sub(self: BigUint, other: BigUint) -> Result[BigUint, Error] {
        if self.cmp(other) == Ordering::Less {
            Result::Err(Error::Underflow)
        } else {
            Result::Ok(subtract(self, other))
        }
    }

    pub fn mul(self: BigUint, other: BigUint) -> BigUint {
        if self.is_zero() || other.is_zero() {
            return BigUint::zero()
        }
        let output = zeros(self.limbs.len() + other.limbs.len());
        for left in 0..self.limbs.len() {
            let mut carry: u64 = 0;
            for right in 0..other.limbs.len() {
                let product = self.limbs.get(left).to_u64() * other.limbs.get(right).to_u64()
                    + output[left + right].to_u64()
                    + carry;
                output[left + right] = product.to_u32();
                carry = product >> 32;
            }
            output[left + other.limbs.len()] = carry.to_u32();
        }
        normalized(output)
    }

    pub fn div_rem(self: BigUint, divisor: BigUint) -> Result[(BigUint, BigUint), Error] {
        if divisor.is_zero() {
            return Result::Err(Error::DivisionByZero)
        }
        if self.cmp(divisor) == Ordering::Less {
            return Result::Ok((BigUint::zero(), self))
        }
        if divisor.limbs.len() == 1 {
            let result = div_small(self, divisor.limbs.get(0));
            return Result::Ok((result.0, BigUint::from_u64(result.1.to_u64())))
        }
        Result::Ok(divide_multi(self, divisor))
    }

    pub fn div(self: BigUint, divisor: BigUint) -> Result[BigUint, Error] {
        let (quotient, _) = self.div_rem(divisor)?;
        Result::Ok(quotient)
    }

    pub fn rem(self: BigUint, divisor: BigUint) -> Result[BigUint, Error] {
        let (_, remainder) = self.div_rem(divisor)?;
        Result::Ok(remainder)
    }

    pub fn pow(self: BigUint, exponent: u64) -> Result[BigUint, Error] {
        self.pow_with_limits(exponent, Limits::standard())
    }

    pub fn pow_with_limits(self: BigUint, exponent: u64, limits: Limits) -> Result[BigUint, Error] {
        limits.validate()?;
        if exponent > limits.max_exponent {
            return Result::Err(Error::LimitExceeded("exponent"))
        }
        if exponent == 0 {
            return check_bits(BigUint::one(), limits)
        }
        if self.is_zero() {
            return Result::Ok(self)
        }
        let mut result = BigUint::one();
        let mut power = check_bits(self, limits)?;
        let mut remaining = exponent;
        while remaining != 0 {
            if (remaining & 1) != 0 {
                result = check_bits(result.mul(power), limits)?;
            }
            remaining = remaining >> 1;
            if remaining != 0 {
                power = check_bits(power.mul(power), limits)?;
            }
        }
        Result::Ok(result)
    }

    pub fn pow10(exponent: u64) -> Result[BigUint, Error] {
        BigUint::from_u64(10).pow(exponent)
    }

    pub fn gcd(self: BigUint, other: BigUint) -> BigUint {
        let mut left = self;
        let mut right = other;
        while !right.is_zero() {
            let (_, remainder) = if right.limbs.len() == 1 {
                let result = div_small(left, right.limbs.get(0));
                (result.0, BigUint::from_u64(result.1.to_u64()))
            } else if left.cmp(right) == Ordering::Less {
                (BigUint::zero(), left)
            } else {
                divide_multi(left, right)
            };
            left = right;
            right = remainder;
        }
        left
    }

    pub fn lcm(self: BigUint, other: BigUint) -> BigUint {
        if self.is_zero() || other.is_zero() {
            BigUint::zero()
        } else {
            let gcd = self.gcd(other);
            match self.div(gcd) {
                Ok(quotient) => quotient.mul(other),
                Err(_) => BigUint::zero(),
            }
        }
    }

    pub fn modpow(self: BigUint, exponent: BigUint, modulus: BigUint) -> Result[BigUint, Error] {
        self.modpow_with_limits(exponent, modulus, Limits::standard())
    }

    pub fn modpow_with_limits(self: BigUint, exponent: BigUint, modulus: BigUint, limits: Limits) -> Result[
        BigUint,
        Error,
    ] {
        limits.validate()?;
        if modulus.is_zero() {
            return Result::Err(Error::DivisionByZero)
        }
        check_bits(self, limits)?;
        check_bits(modulus, limits)?;
        if exponent.bits().to_u64() > limits.max_exponent {
            return Result::Err(Error::LimitExceeded("exponent bits"))
        }
        let mut result = BigUint::one().rem(modulus)?;
        let mut power = self.rem(modulus)?;
        for index in 0..exponent.bits() {
            if exponent.bit(index) {
                result = result.mul(power).rem(modulus)?;
            }
            if index + 1 < exponent.bits() {
                power = power.mul(power).rem(modulus)?;
            }
        }
        Result::Ok(result)
    }
}

impl BigInt {
    pub fn add(self: BigInt, other: BigInt) -> BigInt {
        if self.negative == other.negative {
            BigInt::from_sign_magnitude(self.negative, self.magnitude.add(other.magnitude))
        } else if self.magnitude.cmp(other.magnitude) == Ordering::Less {
            BigInt::from_sign_magnitude(other.negative, subtract(other.magnitude, self.magnitude))
        } else {
            BigInt::from_sign_magnitude(self.negative, subtract(self.magnitude, other.magnitude))
        }
    }

    pub fn sub(self: BigInt, other: BigInt) -> BigInt {
        self.add(other.neg())
    }

    pub fn mul(self: BigInt, other: BigInt) -> BigInt {
        BigInt::from_sign_magnitude(
            self.negative != other.negative,
            self.magnitude.mul(other.magnitude),
        )
    }

    pub fn div_rem(self: BigInt, divisor: BigInt) -> Result[(BigInt, BigInt), Error] {
        let (quotient, remainder) = self.magnitude.div_rem(divisor.magnitude)?;
        Result::Ok(
            (
                BigInt::from_sign_magnitude(self.negative != divisor.negative, quotient),
                BigInt::from_sign_magnitude(self.negative, remainder),
            ),
        )
    }

    pub fn div_rem_euclid(self: BigInt, divisor: BigInt) -> Result[(BigInt, BigInt), Error] {
        let (quotient, remainder) = self.div_rem(divisor)?;
        if remainder.negative {
            Result::Ok(
                (
                    if divisor.negative {
                        quotient.add(BigInt::one())
                    } else {
                        quotient.sub(BigInt::one())
                    },
                    BigInt::from_sign_magnitude(
                        false,
                        subtract(divisor.magnitude, remainder.magnitude),
                    ),
                ),
            )
        } else {
            Result::Ok((quotient, remainder))
        }
    }

    pub fn div(self: BigInt, divisor: BigInt) -> Result[BigInt, Error] {
        let (quotient, _) = self.div_rem(divisor)?;
        Result::Ok(quotient)
    }

    pub fn rem(self: BigInt, divisor: BigInt) -> Result[BigInt, Error] {
        let (_, remainder) = self.div_rem(divisor)?;
        Result::Ok(remainder)
    }

    pub fn pow(self: BigInt, exponent: u64) -> Result[BigInt, Error] {
        self.pow_with_limits(exponent, Limits::standard())
    }

    pub fn pow_with_limits(self: BigInt, exponent: u64, limits: Limits) -> Result[BigInt, Error] {
        Result::Ok(
            BigInt::from_sign_magnitude(
                self.negative && (exponent & 1) != 0,
                self.magnitude.pow_with_limits(exponent, limits)?,
            ),
        )
    }

    pub fn pow10(exponent: u64) -> Result[BigInt, Error] {
        Result::Ok(BigInt::from_sign_magnitude(false, BigUint::pow10(exponent)?))
    }

    pub fn gcd(self: BigInt, other: BigInt) -> BigUint {
        self.magnitude.gcd(other.magnitude)
    }

    pub fn lcm(self: BigInt, other: BigInt) -> BigUint {
        self.magnitude.lcm(other.magnitude)
    }

    pub fn modpow(self: BigInt, exponent: BigUint, modulus: BigUint) -> Result[BigUint, Error] {
        self.modpow_with_limits(exponent, modulus, Limits::standard())
    }

    pub fn modpow_with_limits(self: BigInt, exponent: BigUint, modulus: BigUint, limits: Limits) -> Result[
        BigUint,
        Error,
    ] {
        let result = self.magnitude.modpow_with_limits(exponent, modulus, limits)?;
        if self.negative && exponent.is_odd() && !result.is_zero() {
            Result::Ok(subtract(modulus, result))
        } else {
            Result::Ok(result)
        }
    }
}
