package bigint;

#[derive(PartialEq, Eq, Debug)]
pub enum Error {
    InvalidRadix(isize),
    Empty,
    InvalidDigit(isize),
    NegativeUnsigned,
    DivisionByZero,
    Underflow,
    NegativeShift,
    InvalidLimits,
    LimitExceeded(string),
    InvalidEncoding,
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        match self {
            InvalidRadix(radix) => "radix must be between 2 and 36: " + radix.to_string(),
            Empty => "integer has no digits",
            InvalidDigit(index) => "invalid integer digit at byte " + index.to_string(),
            NegativeUnsigned => "unsigned integer cannot be negative",
            DivisionByZero => "integer division by zero",
            Underflow => "unsigned integer subtraction underflow",
            NegativeShift => "shift count cannot be negative",
            InvalidLimits => "integer resource limits cannot be negative",
            LimitExceeded(resource) => "integer resource limit exceeded: " + resource,
            InvalidEncoding => "noncanonical integer encoding",
        }
    }
}

#[derive(PartialEq, Eq, Debug)]
pub struct Limits {
    pub max_bits: isize,
    pub max_digits: isize,
    pub max_exponent: u64,
}

impl Limits {
    pub fn standard() -> Limits {
        Limits { max_bits: 65536, max_digits: 20000, max_exponent: 1000000 }
    }

    pub fn validate(self: Limits) -> Result[(), Error] {
        if self.max_bits < 0 || self.max_digits < 0 {
            Result::Err(Error::InvalidLimits)
        } else {
            Result::Ok(())
        }
    }
}

pub struct BigUint {
    limbs: FrozenVec[u32],
}

pub struct BigInt {
    negative: bool,
    magnitude: BigUint,
}

fn normalized(limbs: Vec[u32]) -> BigUint {
    while !limbs.is_empty() && limbs[limbs.len() - 1] == 0 {
        limbs.pop();
    }
    BigUint { limbs: limbs.freeze() }
}

fn zeros(length: isize) -> Vec[u32] {
    let values = Vec::with_capacity(length);
    for _ in 0..length {
        values.push(0);
    }
    values
}

fn limb_bits(value: u32) -> isize {
    let mut value = value;
    let mut bits = 0;
    while value != 0 {
        value = value >> 1;
        bits += 1;
    }
    bits
}

fn check_bits(value: BigUint, limits: Limits) -> Result[BigUint, Error] {
    if value.bits() > limits.max_bits {
        Result::Err(Error::LimitExceeded("bits"))
    } else {
        Result::Ok(value)
    }
}

impl BigUint {
    pub fn zero() -> BigUint {
        normalized(Vec::new())
    }

    pub fn one() -> BigUint {
        BigUint::from_u64(1)
    }

    pub fn from_u64(value: u64) -> BigUint {
        normalized(Vec::from_array([value.to_u32(), (value >> 32).to_u32()]))
    }

    pub fn from_limbs_le(values: Slice[u32]) -> Result[BigUint, Error] {
        BigUint::from_limbs_le_with_limits(values, Limits::standard())
    }

    pub fn from_limbs_le_with_limits(values: Slice[u32], limits: Limits) -> Result[BigUint, Error] {
        limits.validate()?;
        if values.len() > limits.max_bits / 32 + 1 {
            return Result::Err(Error::LimitExceeded("limbs"))
        }
        check_bits(normalized(values.to_vec()), limits)
    }

    pub fn to_limbs_le(self: BigUint) -> Vec[u32] {
        self.limbs.to_vec()
    }

    pub fn is_zero(self: BigUint) -> bool {
        self.limbs.is_empty()
    }

    pub fn is_one(self: BigUint) -> bool {
        self.limbs.len() == 1 && self.limbs.get(0) == 1
    }

    pub fn is_odd(self: BigUint) -> bool {
        !self.is_zero() && (self.limbs.get(0) & 1) == 1
    }

    pub fn bits(self: BigUint) -> isize {
        if self.is_zero() {
            0
        } else {
            (self.limbs.len() - 1) * 32 + limb_bits(self.limbs.get(self.limbs.len() - 1))
        }
    }

    pub fn bit(self: BigUint, index: isize) -> bool {
        index >= 0 && index / 32 < self.limbs.len()
            && ((self.limbs.get(index / 32) >> (index % 32)) & 1) != 0
    }

    pub fn trailing_zeros(self: BigUint) -> Option[isize] {
        if self.is_zero() {
            return Option::None
        }
        let mut index = 0;
        while self.limbs.get(index) == 0 {
            index += 1;
        }
        let mut limb = self.limbs.get(index);
        let mut count = index * 32;
        while (limb & 1) == 0 {
            count += 1;
            limb = limb >> 1;
        }
        Option::Some(count)
    }

    pub fn count_ones(self: BigUint) -> isize {
        let mut count = 0;
        for limb in self.limbs.iter() {
            let mut value = limb;
            while value != 0 {
                value = value & (value - 1);
                count += 1;
            }
        }
        count
    }

    pub fn cmp(self: BigUint, other: BigUint) -> Ordering {
        if self.limbs.len() < other.limbs.len() {
            return Ordering::Less
        }
        if self.limbs.len() > other.limbs.len() {
            return Ordering::Greater
        }
        let mut index = self.limbs.len();
        while index > 0 {
            index -= 1;
            if self.limbs.get(index) < other.limbs.get(index) {
                return Ordering::Less
            }
            if self.limbs.get(index) > other.limbs.get(index) {
                return Ordering::Greater
            }
        }
        Ordering::Equal
    }

    pub fn to_u64(self: BigUint) -> Option[u64] {
        if self.limbs.len() > 2 {
            return Option::None
        }
        let mut value: u64 = 0;
        for index in 0..self.limbs.len() {
            value = value | (self.limbs.get(index).to_u64() << (index * 32));
        }
        Option::Some(value)
    }

    pub fn to_i64(self: BigUint) -> Option[i64] {
        match self.to_u64() {
            Some(value) => if value <= 9223372036854775807 {
                Option::Some(value.to_i64())
            } else {
                Option::None
            },
            None => Option::None,
        }
    }

    pub fn to_u32(self: BigUint) -> Option[u32] {
        match self.to_u64() {
            Some(value) => if value <= 4294967295 {
                Option::Some(value.to_u32())
            } else {
                Option::None
            },
            None => Option::None,
        }
    }

    pub fn to_i32(self: BigUint) -> Option[i32] {
        match self.to_i64() {
            Some(value) => if value <= 2147483647 {
                Option::Some(value.to_i32())
            } else {
                Option::None
            },
            None => Option::None,
        }
    }
}

impl BigInt {
    pub fn zero() -> BigInt {
        BigInt::from_sign_magnitude(false, BigUint::zero())
    }

    pub fn one() -> BigInt {
        BigInt::from_u64(1)
    }

    pub fn from_u64(value: u64) -> BigInt {
        BigInt::from_sign_magnitude(false, BigUint::from_u64(value))
    }

    pub fn from_i64(value: i64) -> BigInt {
        let magnitude = if value < 0 {
            (-(value + 1)).to_u64() + 1
        } else {
            value.to_u64()
        };
        BigInt::from_sign_magnitude(value < 0, BigUint::from_u64(magnitude))
    }

    pub fn from_sign_magnitude(negative: bool, magnitude: BigUint) -> BigInt {
        BigInt { negative: negative && !magnitude.is_zero(), magnitude }
    }

    pub fn is_zero(self: BigInt) -> bool {
        self.magnitude.is_zero()
    }

    pub fn is_one(self: BigInt) -> bool {
        !self.negative && self.magnitude.is_one()
    }

    pub fn is_negative(self: BigInt) -> bool {
        self.negative
    }

    pub fn is_odd(self: BigInt) -> bool {
        self.magnitude.is_odd()
    }

    pub fn signum(self: BigInt) -> i8 {
        if self.is_zero() {
            0
        } else if self.negative {
            -1
        } else {
            1
        }
    }

    pub fn abs(self: BigInt) -> BigUint {
        self.magnitude
    }

    pub fn neg(self: BigInt) -> BigInt {
        BigInt::from_sign_magnitude(!self.negative, self.magnitude)
    }

    pub fn bits(self: BigInt) -> isize {
        self.magnitude.bits()
    }

    pub fn cmp(self: BigInt, other: BigInt) -> Ordering {
        if self.negative != other.negative {
            if self.negative {
                Ordering::Less
            } else {
                Ordering::Greater
            }
        } else if self.negative {
            self.magnitude.cmp(other.magnitude).reverse()
        } else {
            self.magnitude.cmp(other.magnitude)
        }
    }

    pub fn to_u64(self: BigInt) -> Option[u64] {
        if self.negative {
            Option::None
        } else {
            self.magnitude.to_u64()
        }
    }

    pub fn to_i64(self: BigInt) -> Option[i64] {
        let value = self.magnitude.to_u64()?;
        if self.negative {
            if value > 9223372036854775808 {
                Option::None
            } else if value == 9223372036854775808 {
                Option::Some(-9223372036854775807 - 1)
            } else {
                Option::Some(-value.to_i64())
            }
        } else if value > 9223372036854775807 {
            Option::None
        } else {
            Option::Some(value.to_i64())
        }
    }

    pub fn to_u32(self: BigInt) -> Option[u32] {
        if self.negative {
            Option::None
        } else {
            self.magnitude.to_u32()
        }
    }

    pub fn to_i32(self: BigInt) -> Option[i32] {
        let value = self.to_i64()?;
        if value < -2147483648 || value > 2147483647 {
            Option::None
        } else {
            Option::Some(value.to_i32())
        }
    }
}
