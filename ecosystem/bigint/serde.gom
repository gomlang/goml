package bigint;

use std::serde::{Serialize, Deserialize, Serializer, Deserializer};

impl Serialize for BigUint {
    fn serialize[S: Serializer](self: BigUint, serializer: S) -> Result[(), string] {
        if serializer.is_human_readable() {
            serializer.serialize_string(self.to_string())
        } else {
            serializer.serialize_bytes(self.to_bytes_be().as_slice())
        }
    }
}

impl Deserialize for BigUint {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[BigUint, string] {
        if deserializer.is_human_readable() {
            let text = deserializer.deserialize_string()?;
            let value = BigUint::parse(text).map_err(|error| deserializer.error(error.to_string()))?;
            if text != value.to_string() {
                return Result::Err(deserializer.error(Error::InvalidEncoding.to_string()))
            }
            Result::Ok(value)
        } else {
            let bytes = deserializer.deserialize_bytes()?;
            let value = BigUint::from_bytes_be(bytes.as_slice()).map_err(
                |error| deserializer.error(error.to_string()),
            )?;
            if bytes != value.to_bytes_be() {
                return Result::Err(deserializer.error(Error::InvalidEncoding.to_string()))
            }
            Result::Ok(value)
        }
    }
}

impl Serialize for BigInt {
    fn serialize[S: Serializer](self: BigInt, serializer: S) -> Result[(), string] {
        if serializer.is_human_readable() {
            serializer.serialize_string(self.to_string())
        } else {
            serializer.serialize_bytes(self.to_signed_bytes_be().as_slice())
        }
    }
}

impl Deserialize for BigInt {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[BigInt, string] {
        if deserializer.is_human_readable() {
            let text = deserializer.deserialize_string()?;
            let value = BigInt::parse(text).map_err(|error| deserializer.error(error.to_string()))?;
            if text != value.to_string() {
                return Result::Err(deserializer.error(Error::InvalidEncoding.to_string()))
            }
            Result::Ok(value)
        } else {
            let bytes = deserializer.deserialize_bytes()?;
            let value = BigInt::from_signed_bytes_be(bytes.as_slice()).map_err(
                |error| deserializer.error(error.to_string()),
            )?;
            if bytes != value.to_signed_bytes_be() {
                return Result::Err(deserializer.error(Error::InvalidEncoding.to_string()))
            }
            Result::Ok(value)
        }
    }
}
