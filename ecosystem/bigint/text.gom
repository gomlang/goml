package bigint;

fn digit_value(value: byte) -> isize {
    if value >= 48 && value <= 57 {
        (value - 48).to_isize()
    } else if value >= 65 && value <= 90 {
        (value - 65).to_isize() + 10
    } else if value >= 97 && value <= 122 {
        (value - 97).to_isize() + 10
    } else {
        -1
    }
}

fn multiply_add_small(limbs: Vec[u32], factor: u32, addend: u32) -> () {
    let mut carry = addend.to_u64();
    for index in 0..limbs.len() {
        let product = limbs[index].to_u64() * factor.to_u64() + carry;
        limbs[index] = product.to_u32();
        carry = product >> 32;
    }
    if carry != 0 {
        limbs.push(carry.to_u32());
    }
}

fn parse_magnitude(text: string, start: isize, radix: isize, limits: Limits) -> Result[
    BigUint,
    Error,
] {
    limits.validate()?;
    if radix < 2 || radix > 36 {
        return Result::Err(Error::InvalidRadix(radix))
    }
    if start >= text.byte_len() {
        return Result::Err(Error::Empty)
    }
    if text.byte_len() - start > limits.max_digits {
        return Result::Err(Error::LimitExceeded("digits"))
    }
    let limbs = Vec::new();
    for index in start..text.byte_len() {
        let digit = digit_value(text.byte_get(index));
        if digit < 0 || digit >= radix {
            return Result::Err(Error::InvalidDigit(index))
        }
        multiply_add_small(limbs, radix.to_u32(), digit.to_u32());
        let bits = if limbs.is_empty() {
            0
        } else {
            (limbs.len() - 1) * 32 + limb_bits(limbs[limbs.len() - 1])
        };
        if bits > limits.max_bits {
            return Result::Err(Error::LimitExceeded("bits"))
        }
    }
    Result::Ok(normalized(limbs))
}

fn format_magnitude(value: BigUint, radix: isize) -> string {
    if value.is_zero() {
        return "0"
    }
    let mut radix_power = radix.to_u32();
    let mut group_length = 1;
    while radix_power.to_u64() * radix.to_u64() <= 4294967295 {
        radix_power = (radix_power.to_u64() * radix.to_u64()).to_u32();
        group_length += 1;
    }
    let output: Vec[byte] = Vec::new();
    let mut value = value;
    while !value.is_zero() {
        let (quotient, remainder) = div_small(value, radix_power);
        let mut remainder = remainder;
        let mut count = 0;
        while remainder != 0 || (!quotient.is_zero() && count < group_length) {
            let digit = remainder % radix.to_u32();
            output.push(
                if digit < 10 {
                    (digit + 48).to_u8()
                } else {
                    (digit + 87).to_u8()
                },
            );
            remainder = remainder / radix.to_u32();
            count += 1;
        }
        value = quotient;
    }
    output.reverse();
    string_from_utf8(output).1
}

impl BigUint {
    pub fn parse(text: string) -> Result[BigUint, Error] {
        BigUint::parse_radix(text, 10)
    }

    pub fn parse_radix(text: string, radix: isize) -> Result[BigUint, Error] {
        BigUint::parse_radix_with_limits(text, radix, Limits::standard())
    }

    pub fn parse_radix_with_limits(text: string, radix: isize, limits: Limits) -> Result[
        BigUint,
        Error,
    ] {
        if text.starts_with("-") {
            return Result::Err(Error::NegativeUnsigned)
        }
        parse_magnitude(
            text,
            if text.starts_with("+") {
                1
            } else {
                0
            },
            radix,
            limits,
        )
    }

    pub fn to_radix(self: BigUint, radix: isize) -> Result[string, Error] {
        if radix < 2 || radix > 36 {
            Result::Err(Error::InvalidRadix(radix))
        } else {
            Result::Ok(format_magnitude(self, radix))
        }
    }
}

impl BigInt {
    pub fn parse(text: string) -> Result[BigInt, Error] {
        BigInt::parse_radix(text, 10)
    }

    pub fn parse_radix(text: string, radix: isize) -> Result[BigInt, Error] {
        BigInt::parse_radix_with_limits(text, radix, Limits::standard())
    }

    pub fn parse_radix_with_limits(text: string, radix: isize, limits: Limits) -> Result[
        BigInt,
        Error,
    ] {
        let negative = text.starts_with("-");
        let magnitude = parse_magnitude(
            text,
            if negative || text.starts_with("+") {
                1
            } else {
                0
            },
            radix,
            limits,
        )?;
        Result::Ok(BigInt::from_sign_magnitude(negative, magnitude))
    }

    pub fn to_radix(self: BigInt, radix: isize) -> Result[string, Error] {
        let text = self.magnitude.to_radix(radix)?;
        Result::Ok(
            if self.negative {
                "-" + text
            } else {
                text
            },
        )
    }
}

impl ToString for BigUint {
    fn to_string(self: BigUint) -> string {
        format_magnitude(self, 10)
    }
}

impl ToString for BigInt {
    fn to_string(self: BigInt) -> string {
        let text = self.magnitude.to_string();
        if self.negative {
            "-" + text
        } else {
            text
        }
    }
}
