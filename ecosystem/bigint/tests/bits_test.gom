package tests;

use ecosystem::bigint::{BigInt, BigUint, Limits};
use std::testing;

#[test]
fn signed_bitwise_matches_fixed_width_sign_extension() -> () {
    for a in -35..36 {
        for b in -35..36 {
            let left = BigInt::from_i64(a.to_i64());
            let right = BigInt::from_i64(b.to_i64());
            same(left.bitand(right).to_i64(), Option::Some((a & b).to_i64()));
            same(left.bitor(right).to_i64(), Option::Some((a | b).to_i64()));
            same(left.bitxor(right).to_i64(), Option::Some((a ^ b).to_i64()));
            same(left.bitnot().to_i64(), Option::Some((~a).to_i64()));
        }
    }
    testing::assert(BigInt::from_i64(-1).bit(1000000));
    testing::assert(!BigInt::from_i64(-1).bit(-1));
}

#[test]
fn shifts_cross_limbs_and_round_negative_infinity() -> () {
    for a in -150..151 {
        let value = BigInt::from_i64(a.to_i64());
        for shift in 0..12 {
            same(
                testing::expect_ok(value.shr(shift), "signed right shift").to_i64(),
                Option::Some((a >> shift).to_i64()),
            );
            same(
                testing::expect_ok(value.shl(shift), "signed left shift").to_i64(),
                Option::Some((a << shift).to_i64()),
            );
        }
    }
    let value = testing::expect_ok(BigInt::parse("-18446744073709551617"), "large negative");
    same(testing::expect_ok(value.shr(64), "large shift").to_string(), "-2");
    same(
        testing::expect_ok(value.shr(9223372036854775807), "huge right shift"),
        BigInt::from_i64(-1),
    );
    testing::assert_err(value.shr(-1));
    let power = testing::expect_ok(BigUint::one().shl(128), "bit power");
    same(power.bits(), 129);
    same(power.trailing_zeros(), Option::Some(128));
    same(power.count_ones(), 1);
    same(testing::expect_ok(power.sub(BigUint::one()), "low mask").count_ones(), 128);
    testing::assert_none(BigUint::zero().trailing_zeros());
}

#[test]
fn byte_encodings_are_minimal_and_round_trip_both_endians() -> () {
    let texts = Vec::from_array(
        [
            "0",
            "1",
            "127",
            "128",
            "255",
            "256",
            "32767",
            "32768",
            "-1",
            "-127",
            "-128",
            "-129",
            "-255",
            "-256",
            "-32768",
            "-32769",
            "18446744073709551615",
            "-18446744073709551617",
        ],
    );
    for text in texts {
        let value = testing::expect_ok(BigInt::parse(text), "value");
        let little = value.to_signed_bytes_le();
        let big = value.to_signed_bytes_be();
        same(
            testing::expect_ok(BigInt::from_signed_bytes_le(little.as_slice()), "little decode"),
            value,
        );
        same(testing::expect_ok(BigInt::from_signed_bytes_be(big.as_slice()), "big decode"), value);
        little.reverse();
        same(little, big);
        if big.len() > 1 {
            testing::assert(!(big[0] == 0 && (big[1] & 128) == 0));
            testing::assert(!(big[0] == 255 && (big[1] & 128) != 0));
        }
        let magnitude = value.abs();
        same(
            testing::expect_ok(
                BigUint::from_bytes_le(magnitude.to_bytes_le().as_slice()),
                "unsigned little",
            ),
            magnitude,
        );
        same(
            testing::expect_ok(
                BigUint::from_bytes_be(magnitude.to_bytes_be().as_slice()),
                "unsigned big",
            ),
            magnitude,
        );
    }
    let bytes: Vec[byte] = Vec::from_array([0, 128]);
    same(BigInt::from_u64(128).to_signed_bytes_be(), bytes);
    let bytes: Vec[byte] = Vec::from_array([255, 127]);
    same(BigInt::from_i64(-129).to_signed_bytes_be(), bytes);
    let empty: Vec[byte] = Vec::new();
    same(
        testing::expect_ok(BigInt::from_signed_bytes_be(empty.as_slice()), "empty zero"),
        BigInt::zero(),
    );
}

#[test]
fn byte_and_limb_constructors_copy_mutable_inputs() -> () {
    let input: Vec[u32] = Vec::from_array([4294967295, 1, 0, 0]);
    let value = testing::expect_ok(BigUint::from_limbs_le(input.as_slice()), "limbs");
    input[0] = 0;
    let output = value.to_limbs_le();
    output[1] = 0;
    same(value.to_string(), "8589934591");
    same(value.to_limbs_le().len(), 2);
    let bytes: Vec[byte] = Vec::from_array([1, 255]);
    let value = testing::expect_ok(BigUint::from_bytes_be(bytes.as_slice()), "bytes");
    bytes[0] = 0;
    let output = value.to_bytes_le();
    output[0] = 0;
    same(value.to_string(), "511");
    testing::assert_err(
        BigUint::from_bytes_be_with_limits(
            bytes.as_slice(),
            Limits { max_bits: 1, max_digits: 1, max_exponent: 1 },
        ),
    );
}
