package tests;

use ecosystem::bigint::{BigInt, BigUint};
use std::testing;
use std::json;
use std::bincode;
use std::serde::{Serialize, Deserialize};

#[derive(Serialize, Deserialize, PartialEq)]
struct Record {
    coefficient: BigInt,
    scale: BigUint,
}

#[test]
fn json_uses_exact_decimal_strings_inside_derived_records() -> () {
    let value = Record {
        coefficient: integer("-123456789012345678901234567890"),
        scale: natural("100000000000000000000"),
    };
    let encoded = testing::expect_ok(json::try_to_string(value), "encode JSON");
    testing::assert_eq(
        encoded,
        "{\"coefficient\":\"-123456789012345678901234567890\",\"scale\":\"100000000000000000000\"}",
    );
    let decoded: Record = testing::expect_ok(json::from_string(encoded), "decode JSON");
    same(decoded, value);
}

#[test]
fn text_serde_rejects_noncanonical_numbers() -> () {
    for text in Vec::from_array(["\"-0\"", "\"+1\"", "\"01\"", "\"\"", "123", "null", "\"1e3\""]) {
        let result: Result[BigInt, string] = json::from_string(text);
        testing::assert_err(result);
    }
    let result: Result[BigUint, string] = json::from_string("\"-1\"");
    testing::assert_err(result);
}

#[test]
fn binary_serde_round_trips_signed_and_unsigned_magnitudes() -> () {
    for text in Vec::from_array(
        [
            "0",
            "127",
            "128",
            "-1",
            "-128",
            "-129",
            "18446744073709551616",
            "-340282366920938463463374607431768211456",
        ],
    ) {
        let value = integer(text);
        let encoded = testing::expect_ok(
            bincode::encode_to_vec(value, bincode::legacy()),
            "binary encode",
        );
        let (decoded, consumed): (BigInt, isize) = testing::expect_ok(
            bincode::decode_from_slice(encoded.as_slice(), bincode::legacy()),
            "binary decode",
        );
        same(decoded, value);
        same(consumed, encoded.len());
        let magnitude = value.abs();
        let encoded = testing::expect_ok(
            bincode::encode_to_vec(magnitude, bincode::legacy()),
            "unsigned binary encode",
        );
        let (decoded, consumed): (BigUint, isize) = testing::expect_ok(
            bincode::decode_from_slice(encoded.as_slice(), bincode::legacy()),
            "unsigned binary decode",
        );
        same(decoded, magnitude);
        same(consumed, encoded.len());
    }
    let encoded = testing::expect_ok(
        bincode::encode_to_vec(BigInt::from_i64(-129), bincode::legacy()),
        "binary layout",
    );
    let expected: Vec[byte] = Vec::from_array([2, 0, 0, 0, 0, 0, 0, 0, 255, 127]);
    same(encoded, expected);
}

#[test]
fn binary_serde_rejects_redundant_sign_bytes_and_empty_values() -> () {
    let encodings: Vec[Vec[byte]] = Vec::from_array(
        [
            Vec::from_array([0, 0, 0, 0, 0, 0, 0, 0]),
            Vec::from_array([2, 0, 0, 0, 0, 0, 0, 0, 0, 1]),
            Vec::from_array([2, 0, 0, 0, 0, 0, 0, 0, 255, 255]),
        ],
    );
    for encoded in encodings {
        let result: Result[(BigInt, isize), string] = bincode::decode_from_slice(
            encoded.as_slice(),
            bincode::legacy(),
        );
        testing::assert_err(result);
    }
}
