package tests;

use ecosystem::bigint::{BigInt, BigUint, Error, Limits};
use std::testing;
use std::cmp::{Ord, PartialOrd};

fn same[T: PartialEq](actual: T, expected: T) -> () {
    testing::assert(actual == expected);
}

fn integer(text: string) -> BigInt {
    testing::expect_ok(BigInt::parse(text), "parse signed integer")
}

fn natural(text: string) -> BigUint {
    testing::expect_ok(BigUint::parse(text), "parse unsigned integer")
}

#[test]
fn normalization_and_ordering_are_numeric() -> () {
    same(integer("-0000"), BigInt::zero());
    same(integer("+000123").to_string(), "123");
    same(BigInt::from_sign_magnitude(true, BigUint::zero()).signum(), 0);
    testing::assert(integer("-100").lt(integer("-9")));
    testing::assert(integer("999").gt(integer("100")));
    same(Ord::cmp(natural("4294967296"), natural("4294967295")), Ordering::Greater);
    same(Ord::cmp(integer("-4294967296"), integer("-4294967295")), Ordering::Less);
    let values: HashMap[BigInt, string] = HashMap::new();
    values.set(integer("+000123"), "value");
    same(values.get(integer("123")), Option::Some("value"));
    values.set(integer("-0"), "zero");
    same(values.get(BigInt::zero()), Option::Some("zero"));
}

#[test]
fn full_fixed_width_edges_convert_without_overflow() -> () {
    let minimum: i64 = -9223372036854775807 - 1;
    same(BigInt::from_i64(minimum).to_string(), "-9223372036854775808");
    same(integer("-9223372036854775808").to_i64(), Option::Some(minimum));
    same(integer("9223372036854775807").to_i64(), Option::Some(9223372036854775807));
    testing::assert_none(integer("9223372036854775808").to_i64());
    testing::assert_none(integer("-9223372036854775809").to_i64());
    same(integer("18446744073709551615").to_u64(), Option::Some(18446744073709551615));
    testing::assert_none(integer("18446744073709551616").to_u64());
    testing::assert_none(integer("-1").to_u64());
    same(integer("-2147483648").to_i32(), Option::Some(-2147483648));
    testing::assert_none(integer("2147483648").to_i32());
    testing::assert_none(integer("-2147483649").to_i32());
    same(natural("4294967295").to_u32(), Option::Some(4294967295));
    testing::assert_none(natural("4294967296").to_u32());
}

#[test]
fn arithmetic_preserves_carries_borrows_and_operands() -> () {
    let a = integer("340282366920938463463374607431768211455");
    let one = BigInt::one();
    same(a.add(one).to_string(), "340282366920938463463374607431768211456");
    same(a.add(one).sub(a), one);
    same(a.add(a.neg()), BigInt::zero());
    same(
        a.mul(a).to_string(),
        "115792089237316195423570985008687907852589419931798687112530834793049593217025",
    );
    same(a.to_string(), "340282366920938463463374607431768211455");
    same(a.neg().mul(a), a.mul(a).neg());
    same(BigUint::zero().sub(BigUint::one()), Result::Err(Error::Underflow));
}

#[test]
fn signed_division_distinguishes_truncating_and_euclidean() -> () {
    for a in -25..26 {
        for b in -9..10 {
            if b == 0 {
                continue;
            }
            let left = BigInt::from_i64(a.to_i64());
            let right = BigInt::from_i64(b.to_i64());
            let (q, r) = testing::expect_ok(left.div_rem(right), "truncating divide");
            same(q.to_i64(), Option::Some((a / b).to_i64()));
            same(r.to_i64(), Option::Some((a % b).to_i64()));
            same(q.mul(right).add(r), left);
            let (q, r) = testing::expect_ok(left.div_rem_euclid(right), "Euclidean divide");
            testing::assert(!r.is_negative());
            testing::assert(r.abs().cmp(right.abs()) == Ordering::Less);
            same(q.mul(right).add(r), left);
        }
    }
    same(BigInt::one().div(BigInt::zero()), Result::Err(Error::DivisionByZero));
}

#[test]
fn division_handles_normalization_and_quotient_estimate_correction() -> () {
    let divisors = Vec::from_array(
        [
            "4294967296",
            "4294967297",
            "8589934591",
            "9223372036854775808",
            "18446744073709551615",
            "18446744078004518913",
            "39614081266355540835774234625",
            "340282366920938463463374607431768211455",
        ],
    );
    for text in divisors {
        let divisor = natural(text);
        for shift in 0..95 {
            let q = testing::expect_ok(BigUint::one().shl(shift), "quotient shift").add(
                BigUint::from_u64(4294967295),
            );
            let r = testing::expect_ok(divisor.sub(BigUint::one()), "remainder");
            let dividend = divisor.mul(q).add(r);
            let result = testing::expect_ok(dividend.div_rem(divisor), "multi-limb divide");
            same(result.0, q);
            same(result.1, r);
        }
    }
}

#[test]
fn powers_gcd_lcm_and_modular_exponentiation_are_exact() -> () {
    same(
        testing::expect_ok(BigInt::pow10(40), "power of ten").to_string(),
        "10000000000000000000000000000000000000000",
    );
    same(testing::expect_ok(integer("-3").pow(31), "signed power").to_string(), "-617673396283947");
    same(testing::expect_ok(BigInt::zero().pow(0), "zero exponent"), BigInt::one());
    same(integer("-48").gcd(integer("180")), BigUint::from_u64(12));
    same(integer("-48").lcm(integer("180")), BigUint::from_u64(720));
    same(BigUint::zero().gcd(BigUint::zero()), BigUint::zero());
    same(BigUint::zero().lcm(BigUint::one()), BigUint::zero());
    same(
        testing::expect_ok(
            integer("-4").modpow(BigUint::from_u64(13), BigUint::from_u64(497)),
            "modpow",
        ),
        BigUint::from_u64(52),
    );
    same(
        testing::expect_ok(BigUint::zero().modpow(BigUint::zero(), BigUint::one()), "mod one"),
        BigUint::zero(),
    );
    testing::assert_err(BigUint::one().modpow(BigUint::one(), BigUint::zero()));
}

#[test]
fn parsing_is_strict_and_radices_round_trip() -> () {
    for text in Vec::from_array(["", "+", "-", " 1", "1 ", "1_2", "0x10", "１２", "--1", "+-1"]) {
        testing::assert_err(BigInt::parse(text));
    }
    same(BigUint::parse("-0"), Result::Err(Error::NegativeUnsigned));
    same(BigInt::parse_radix("1", 1), Result::Err(Error::InvalidRadix(1)));
    testing::assert_err(BigInt::one().to_radix(37));
    same(testing::expect_ok(BigUint::parse_radix("Zz", 36), "mixed case"), BigUint::from_u64(1295));
    let value = integer("-123456789012345678901234567890123456789012345678901234567890");
    for radix in 2..37 {
        let encoded = testing::expect_ok(value.to_radix(radix), "format radix");
        same(testing::expect_ok(BigInt::parse_radix(encoded, radix), "parse radix"), value);
    }
}

#[test]
fn resource_limits_fail_before_large_allocations() -> () {
    let limits = Limits { max_bits: 8, max_digits: 4, max_exponent: 10 };
    same(
        testing::expect_ok(BigUint::parse_radix_with_limits("255", 10, limits), "bounded parse"),
        BigUint::from_u64(255),
    );
    testing::assert_err(BigUint::parse_radix_with_limits("256", 10, limits));
    testing::assert_err(BigUint::parse_radix_with_limits("00000", 10, limits));
    testing::assert_err(BigUint::one().shl_with_limits(8, limits));
    testing::assert_ok(BigUint::one().shl_with_limits(7, limits));
    testing::assert_err(BigUint::one().shl(9223372036854775807));
    testing::assert_err(BigUint::one().shl(-1));
    testing::assert_err(BigUint::one().shr(-1));
    testing::assert_err(BigUint::from_u64(2).pow_with_limits(8, limits));
    testing::assert_err(BigUint::one().pow_with_limits(11, limits));
    testing::assert_err(
        BigUint::one().modpow_with_limits(BigUint::from_u64(1024), BigUint::from_u64(3), limits),
    );
    testing::assert_err(
        BigUint::parse_radix_with_limits(
            "1",
            10,
            Limits { max_bits: -1, max_digits: 5, max_exponent: 1 },
        ),
    );
}

#[test]
fn narrow_integer_conversions_reject_truncation() -> () {
    same(integer("127").to_i8(), Option::Some(127));
    same(integer("-128").to_i8(), Option::Some(-128));
    testing::assert_none(integer("128").to_i8());
    testing::assert_none(integer("-129").to_i8());
    same(integer("255").to_u8(), Option::Some(255));
    testing::assert_none(integer("256").to_u8());
    testing::assert_none(integer("-1").to_u8());
    same(integer("32767").to_i16(), Option::Some(32767));
    same(integer("-32768").to_i16(), Option::Some(-32768));
    testing::assert_none(integer("32768").to_i16());
    testing::assert_none(integer("-32769").to_i16());
    same(natural("65535").to_u16(), Option::Some(65535));
    testing::assert_none(natural("65536").to_u16());
    same(integer("-9223372036854775808").to_isize(), Option::Some(-9223372036854775807 - 1));
    same(natural("18446744073709551615").to_usize(), Option::Some(18446744073709551615));
}

#[test]
fn zero_bit_budget_accepts_zero_but_rejects_one() -> () {
    let limits = Limits { max_bits: 0, max_digits: 4, max_exponent: 10 };
    testing::assert_ok(BigUint::parse_radix_with_limits("000", 10, limits));
    testing::assert_ok(BigUint::zero().pow_with_limits(1, limits));
    testing::assert_ok(BigUint::zero().shl_with_limits(1000000000, limits));
    testing::assert_err(BigUint::one().pow_with_limits(1, limits));
    testing::assert_err(BigUint::zero().pow_with_limits(0, limits));
}

#[test]
#[allow(unstructured_go)]
fn concurrent_arithmetic_preserves_shared_values() -> () {
    let value = integer("-1234567890123456789012345678901234567890");
    let divisor = integer("4294967297");
    let done: Channel[bool] = Channel::new(16);
    for _ in 0..16 {
        go || {
            let mut valid = true;
            for _ in 0..100 {
                let result = value.mul(divisor);
                let (quotient, remainder) = testing::expect_ok(
                    result.div_rem(divisor),
                    "concurrent divide",
                );
                valid = valid && quotient == value && remainder.is_zero();
                let bytes = value.to_signed_bytes_be();
                bytes[0] = 0;
                valid = valid && value.to_string() == "-1234567890123456789012345678901234567890";
            }
            done.send(valid);
        };
    }
    for _ in 0..16 {
        testing::assert(testing::expect_some(done.recv(), "worker result"));
    }
}
