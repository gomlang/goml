package bigint;

fn shift_right(value: BigUint, count: isize) -> BigUint {
    if count >= value.bits() {
        return BigUint::zero()
    }
    let words = count / 32;
    let bits = count % 32;
    let output = Vec::with_capacity(value.limbs.len() - words);
    for index in words..value.limbs.len() {
        let low = value.limbs.get(index).to_u64();
        let high = if index + 1 < value.limbs.len() {
            value.limbs.get(index + 1).to_u64()
        } else {
            0
        };
        output.push(((low | (high << 32)) >> bits).to_u32());
    }
    normalized(output)
}

fn unsigned_bitwise(left: BigUint, right: BigUint, operation: isize) -> BigUint {
    let length = if left.limbs.len() > right.limbs.len() {
        left.limbs.len()
    } else {
        right.limbs.len()
    };
    let output = Vec::with_capacity(length);
    for index in 0..length {
        let a = if index < left.limbs.len() {
            left.limbs.get(index)
        } else {
            0
        };
        let b = if index < right.limbs.len() {
            right.limbs.get(index)
        } else {
            0
        };
        output.push(
            match operation {
                0 => a & b,
                1 => a | b,
                _ => a ^ b,
            },
        );
    }
    normalized(output)
}

fn twos_complement(value: BigInt, length: isize) -> Vec[u32] {
    let output = zeros(length);
    let mut carry: u64 = if value.negative {
        1
    } else {
        0
    };
    for index in 0..length {
        let limb = if index < value.magnitude.limbs.len() {
            value.magnitude.limbs.get(index)
        } else {
            0
        };
        if value.negative {
            let sum = (~limb).to_u64() + carry;
            output[index] = sum.to_u32();
            carry = sum >> 32;
        } else {
            output[index] = limb;
        }
    }
    output
}

fn signed_bitwise(left: BigInt, right: BigInt, operation: isize) -> BigInt {
    let length = 1
        + if left.magnitude.limbs.len() > right.magnitude.limbs.len() {
            left.magnitude.limbs.len()
        } else {
            right.magnitude.limbs.len()
        };
    let a = twos_complement(left, length);
    let b = twos_complement(right, length);
    for index in 0..length {
        a[index] = match operation {
            0 => a[index] & b[index],
            1 => a[index] | b[index],
            _ => a[index] ^ b[index],
        };
    }
    let negative = (a[length - 1] >> 31) != 0;
    if negative {
        let mut carry: u64 = 1;
        for index in 0..length {
            let sum = (~a[index]).to_u64() + carry;
            a[index] = sum.to_u32();
            carry = sum >> 32;
        }
    }
    BigInt::from_sign_magnitude(negative, normalized(a))
}

impl BigUint {
    pub fn shl(self: BigUint, count: isize) -> Result[BigUint, Error] {
        self.shl_with_limits(count, Limits::standard())
    }

    pub fn shl_with_limits(self: BigUint, count: isize, limits: Limits) -> Result[BigUint, Error] {
        limits.validate()?;
        if count < 0 {
            return Result::Err(Error::NegativeShift)
        }
        if self.is_zero() {
            return Result::Ok(self)
        }
        if count > limits.max_bits || self.bits() > limits.max_bits - count {
            return Result::Err(Error::LimitExceeded("bits"))
        }
        let output = zeros(count / 32);
        for limb in shift_limbs_left(self, count % 32) {
            output.push(limb);
        }
        Result::Ok(normalized(output))
    }

    pub fn shr(self: BigUint, count: isize) -> Result[BigUint, Error] {
        if count < 0 {
            Result::Err(Error::NegativeShift)
        } else {
            Result::Ok(shift_right(self, count))
        }
    }

    pub fn bitand(self: BigUint, other: BigUint) -> BigUint {
        unsigned_bitwise(self, other, 0)
    }

    pub fn bitor(self: BigUint, other: BigUint) -> BigUint {
        unsigned_bitwise(self, other, 1)
    }

    pub fn bitxor(self: BigUint, other: BigUint) -> BigUint {
        unsigned_bitwise(self, other, 2)
    }
}

impl BigInt {
    pub fn shl(self: BigInt, count: isize) -> Result[BigInt, Error] {
        self.shl_with_limits(count, Limits::standard())
    }

    pub fn shl_with_limits(self: BigInt, count: isize, limits: Limits) -> Result[BigInt, Error] {
        Result::Ok(
            BigInt::from_sign_magnitude(
                self.negative,
                self.magnitude.shl_with_limits(count, limits)?,
            ),
        )
    }

    pub fn shr(self: BigInt, count: isize) -> Result[BigInt, Error] {
        let shifted = self.magnitude.shr(count)?;
        let round = self.negative && self.magnitude.trailing_zeros().unwrap_or(count) < count;
        Result::Ok(
            BigInt::from_sign_magnitude(
                self.negative,
                if round {
                    shifted.add(BigUint::one())
                } else {
                    shifted
                },
            ),
        )
    }

    pub fn bitand(self: BigInt, other: BigInt) -> BigInt {
        signed_bitwise(self, other, 0)
    }

    pub fn bitor(self: BigInt, other: BigInt) -> BigInt {
        signed_bitwise(self, other, 1)
    }

    pub fn bitxor(self: BigInt, other: BigInt) -> BigInt {
        signed_bitwise(self, other, 2)
    }

    pub fn bitnot(self: BigInt) -> BigInt {
        self.neg().sub(BigInt::one())
    }

    pub fn bit(self: BigInt, index: isize) -> bool {
        if index < 0 {
            false
        } else if self.negative {
            !subtract(self.magnitude, BigUint::one()).bit(index)
        } else {
            self.magnitude.bit(index)
        }
    }
}
