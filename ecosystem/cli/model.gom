package cli;

#[derive(Debug, PartialEq)]
pub enum ErrorKind {
    Help,
    Version,
    Usage,
    InvalidValue,
    InvalidSchema,
}

#[derive(Debug, PartialEq)]
pub struct Error {
    pub kind: ErrorKind,
    pub message: string,
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        self.message
    }
}

#[derive(PartialEq)]
pub enum Action {
    Value,
    Flag,
    Count,
}

pub struct Argument {
    pub name: string,
    pub aliases: Vec[string],
    pub global_value: bool,
    pub short_name: Option[char],
    pub description: string,
    pub action: Action,
    pub required_value: bool,
    pub repeated: bool,
    pub position: Option[isize],
    pub defaults: Vec[string],
    pub environment: Option[string],
    pub choices: Vec[string],
    pub conflicts: Vec[string],
    pub dependencies: Vec[string],
}

impl Argument {
    pub fn new(name: string) -> Argument {
        Argument {
            name,
            aliases: Vec::new(),
            global_value: false,
            short_name: Option::None,
            description: "",
            action: Action::Value,
            required_value: false,
            repeated: false,
            position: Option::None,
            defaults: Vec::new(),
            environment: Option::None,
            choices: Vec::new(),
            conflicts: Vec::new(),
            dependencies: Vec::new(),
        }
    }

    pub fn flag(name: string) -> Argument {
        let mut result = Argument::new(name);
        result.action = Action::Flag;
        result
    }

    pub fn counter(name: string) -> Argument {
        let mut result = Argument::new(name);
        result.action = Action::Count;
        result.repeated = true;
        result
    }
}

pub struct Command {
    pub name: string,
    pub aliases: Vec[string],
    pub description: string,
    pub version_value: string,
    pub arguments: Vec[Argument],
    pub commands: Vec[Command],
    pub subcommand_required: bool,
    pub groups: Vec[ArgGroup],
}

impl Command {
    pub fn new(name: string) -> Command {
        Command {
            name,
            aliases: Vec::new(),
            description: "",
            version_value: "",
            arguments: Vec::new(),
            commands: Vec::new(),
            subcommand_required: false,
            groups: Vec::new(),
        }
    }

    pub fn arg(self: Command, argument: Argument) -> Command {
        let mut result = self;
        result.arguments = self.arguments.copy().pushed(argument);
        result
    }

    pub fn subcommand(self: Command, command: Command) -> Command {
        let mut result = self;
        result.commands = self.commands.copy().pushed(command);
        result
    }
}

pub struct Matches {
    pub command: string,
    values_by_name: HashMap[string, Vec[string]],
    explicit_names: HashMap[string, bool],
    children: Vec[Matches],
}

pub struct TypedCommand[T] {
    pub command: Command,
}

pub trait Args {
    fn schema() -> TypedCommand[Self];
    fn from_matches(matches: Matches) -> Result[Self, Error];
}

pub fn command_for[T: Args]() -> TypedCommand[T] {
    Args::schema()
}

pub fn parse[T: Args](arguments: Vec[string]) -> Result[T, Error] {
    let typed: TypedCommand[T] = Args::schema();
    let matches = typed.command.parse(arguments)?;
    Args::from_matches(matches)
}

pub fn parse_env[T: Args]() -> Result[T, Error] {
    let typed: TypedCommand[T] = Args::schema();
    let matches = typed.command.parse_env()?;
    Args::from_matches(matches)
}

pub fn parse_with_env[T: Args](arguments: Vec[string], environment: (string) -> Option[string]) -> Result[
    T,
    Error,
] {
    let typed: TypedCommand[T] = Args::schema();
    let matches = typed.command.parse_with_env(arguments, environment)?;
    Args::from_matches(matches)
}

fn problem(kind: ErrorKind, message: string) -> Error {
    Error { kind, message }
}

pub fn argument(name: string) -> Argument {
    Argument::new(name)
}

pub fn flag(name: string) -> Argument {
    Argument::flag(name)
}

pub fn counter(name: string) -> Argument {
    Argument::counter(name)
}

pub fn command(name: string) -> Command {
    Command::new(name)
}
