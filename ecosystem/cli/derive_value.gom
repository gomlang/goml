package cli;

#[comptime_derive]
fn lower_variant(name: string) -> string {
    let mut result = "";
    for index in 0..name.byte_len() {
        let value = name.byte_get(index);
        if value >= b'A' && value <= b'Z' {
            let offset = (value - b'A').to_isize();
            result = result + "abcdefghijklmnopqrstuvwxyz".byte_slice(offset, offset + 1);
        } else if value == b'_' {
            result = result + "-";
        } else {
            result = result + name.byte_slice(index, index + 1);
        }
    }
    result
}

#[comptime_derive]
fn variant_attribute(input: DeriveInput, variant: isize, key: string, fallback: string) -> string {
    let mut result = fallback;
    for index in 0..derive_variant_attribute_count(input, variant) {
        let attribute = derive_variant_attribute(input, variant, index);
        if meta_attribute_name(attribute) != "value" {
            continue;
        }
        validate_attribute_syntax(attribute);
        let mut cursor = attribute_start(attribute);
        while cursor < meta_attribute_text(attribute).byte_len() {
            let current = attribute_next(attribute, cursor);
            if current.0 == "" {
                break;
            }
            if !current.2 {
                compile_error("value attributes require named strings")
            }
            let name = current.0;
            if name != "name" && name != "alias" {
                compile_error("unknown value attribute: " + name)
            }
            cursor = current.3;
        }
        result = attribute_value(attribute, key, result);
    }
    result
}

#[comptime_derive(ArgValue)]
pub fn derive_arg_value(input: DeriveInput) -> DeriveOutput {
    if derive_item_kind(input) != 1 || derive_variant_count(input) == 0 {
        compile_error("ArgValue derive requires a nonempty enum")
    }
    let output = derive_output_new(input, "ArgValue");
    let arms = meta_arm_list_new();
    let mut choices = "";
    for variant in 0..derive_variant_count(input) {
        if derive_variant_kind(input, variant) != 0 {
            compile_error("ArgValue variants must have no payload")
        }
        let name = variant_attribute(
            input,
            variant,
            "name",
            lower_variant(derive_variant_name(input, variant)),
        );
        let alias = variant_attribute(input, variant, "alias", "");
        if name == "" || name == alias {
            compile_error("invalid enum argument name or alias")
        }
        for previous in 0..variant {
            let prior_name = variant_attribute(
                input,
                previous,
                "name",
                lower_variant(derive_variant_name(input, previous)),
            );
            let prior_alias = variant_attribute(input, previous, "alias", "");
            if name == prior_name || name == prior_alias
                || (alias != "" && (alias == prior_name || alias == prior_alias)) {
                compile_error("duplicate enum argument name or alias")
            }
        }
        if choices != "" {
            choices = choices + ", ";
        }
        choices = choices + name;
        let value = meta_expr_target_constructor(
            input,
            derive_variant_name(input, variant),
            meta_expr_list_new(),
        );
        let body = meta_expr_constructor("Result::Ok", args_one(value));
        meta_arm_list_push(arms, meta_arm(meta_pattern_string(name), body));
        if alias != "" {
            meta_arm_list_push(arms, meta_arm(meta_pattern_string(alias), body));
        }
    }
    meta_arm_list_push(
        arms,
        meta_arm(
            meta_pattern_wild(),
            meta_expr_constructor(
                "Result::Err",
                args_one(meta_expr_string("expected one of " + choices)),
            ),
        ),
    );
    let parameters = meta_param_list_new();
    meta_param_list_push(parameters, "value", meta_type_call_site("string"));
    let types = types_one(derive_target_type(input));
    meta_type_list_push(types, meta_type_call_site("string"));
    derive_output_add_method(
        output,
        meta_method(
            "parse_value",
            parameters,
            meta_type_apply(meta_type_call_site("Result"), types),
            meta_expr_match(meta_expr_var("value"), arms),
        ),
    );
    output
}
