package cli;

pub struct ArgGroup {
    pub name: string,
    pub members: Vec[string],
    pub minimum: isize,
    pub maximum: isize,
}

impl ArgGroup {
    pub fn new(name: string, members: Vec[string]) -> ArgGroup {
        ArgGroup { name, members: members.copy(), minimum: 0, maximum: 1 }
    }

    pub fn required(self: ArgGroup, required: bool) -> ArgGroup {
        ArgGroup {
            minimum: if required {
                1
            } else {
                0
            },
            ..self,
        }
    }

    pub fn bounds(self: ArgGroup, minimum: isize, maximum: isize) -> ArgGroup {
        ArgGroup { minimum, maximum, ..self }
    }
}

fn prepare_command(command: Command, inherited: Vec[Argument], depth: isize) -> Result[
    Command,
    Error,
] {
    if depth > 64 {
        return Result::Err(problem(ErrorKind::InvalidSchema, "subcommand nesting exceeds 64"))
    }
    let arguments = inherited.copy();
    arguments.extend(command.arguments);
    let globals: Vec[Argument] = Vec::new();
    for argument in arguments {
        if argument.global_value {
            globals.push(
                Argument {
                    conflicts: Vec::new(),
                    dependencies: Vec::new(),
                    required_value: false,
                    ..argument,
                },
            );
        }
    }
    let children: Vec[Command] = Vec::new();
    for child in command.commands {
        children.push(prepare_command(child, globals, depth + 1)?);
    }
    Result::Ok(Command { arguments, commands: children, ..command })
}

fn validate_groups(command: Command, names: HashMap[string, bool]) -> Result[(), Error] {
    let seen: HashMap[string, bool] = HashMap::new();
    for group in command.groups {
        if !valid_name(group.name) || seen.contains(group.name) || names.contains(group.name)
            || group.members.is_empty()
            || group.minimum < 0
            || group.maximum < group.minimum
            || group.maximum > group.members.len() {
            return Result::Err(
                problem(ErrorKind::InvalidSchema, f"invalid argument group: {group.name}"),
            )
        }
        seen.set(group.name, true);
        let members: HashMap[string, bool] = HashMap::new();
        for name in group.members {
            if !names.contains(name) || members.contains(name) {
                return Result::Err(
                    problem(ErrorKind::InvalidSchema, f"unknown or duplicate group member: {name}"),
                )
            }
            members.set(name, true);
        }
    }
    Result::Ok(())
}

fn check_groups(command: Command, matches: Matches) -> Result[(), Error] {
    for group in command.groups {
        let mut count = 0;
        for member in group.members {
            if matches.was_provided(member) {
                count += 1;
            }
        }
        if count < group.minimum || count > group.maximum {
            return Result::Err(
                problem(
                    ErrorKind::Usage,
                    f"{group.name}: expected {group.minimum} through {group.maximum} of "
                        + group.members.join(", "),
                ),
            )
        }
    }
    Result::Ok(())
}

fn copy_globals(command: Command, source: Matches, destination: Matches) -> () {
    for argument in command.arguments {
        if argument.global_value {
            if source.contains(argument.name) {
                destination.values_by_name.set(argument.name, source.raw(argument.name));
            }
            if source.was_provided(argument.name) {
                destination.explicit_names.set(argument.name, true);
            }
        }
    }
}

fn empty_matches(name: string) -> Matches {
    Matches {
        command: name,
        values_by_name: HashMap::new(),
        explicit_names: HashMap::new(),
        children: Vec::new(),
    }
}
