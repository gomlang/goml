package cli;

use std::num;

impl ArgValue for i8 {
    fn parse_value(value: string) -> Result[i8, string] {
        let parsed = num::parse_int_structured(value).map_err(|error| error.to_string())?;
        if parsed < -128 || parsed > 127 {
            return Result::Err("integer outside i8 range")
        }
        Result::Ok(parsed.to_i8())
    }
}

impl ArgValue for i16 {
    fn parse_value(value: string) -> Result[i16, string] {
        let parsed = num::parse_int_structured(value).map_err(|error| error.to_string())?;
        if parsed < -32768 || parsed > 32767 {
            return Result::Err("integer outside i16 range")
        }
        Result::Ok(parsed.to_i16())
    }
}

impl ArgValue for i32 {
    fn parse_value(value: string) -> Result[i32, string] {
        let parsed = num::parse_int_structured(value).map_err(|error| error.to_string())?;
        if parsed < -2147483648 || parsed > 2147483647 {
            return Result::Err("integer outside i32 range")
        }
        Result::Ok(parsed.to_i32())
    }
}

impl ArgValue for u8 {
    fn parse_value(value: string) -> Result[u8, string] {
        let parsed = num::parse_int_structured(value).map_err(|error| error.to_string())?;
        if parsed < 0 || parsed > 255 {
            return Result::Err("integer outside u8 range")
        }
        Result::Ok(parsed.to_u8())
    }
}

impl ArgValue for u16 {
    fn parse_value(value: string) -> Result[u16, string] {
        let parsed = num::parse_int_structured(value).map_err(|error| error.to_string())?;
        if parsed < 0 || parsed > 65535 {
            return Result::Err("integer outside u16 range")
        }
        Result::Ok(parsed.to_u16())
    }
}

impl ArgValue for u32 {
    fn parse_value(value: string) -> Result[u32, string] {
        let parsed = num::parse_int_structured(value).map_err(|error| error.to_string())?;
        if parsed < 0 || parsed > 4294967295 {
            return Result::Err("integer outside u32 range")
        }
        Result::Ok(parsed.to_u32())
    }
}
