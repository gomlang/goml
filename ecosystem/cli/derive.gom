package cli;

#[comptime_derive]
fn args_one(value: MetaExpr) -> MetaExprList {
    let result = meta_expr_list_new();
    meta_expr_list_push(result, value);
    result
}

#[comptime_derive]
fn types_one(value: MetaType) -> MetaTypeList {
    let result = meta_type_list_new();
    meta_type_list_push(result, value);
    result
}

#[comptime_derive]
fn attribute_value(attribute: MetaAttribute, key: string, fallback: string) -> string {
    let mut index = attribute_start(attribute);
    let length = meta_attribute_text(attribute).byte_len();
    while index < length {
        let current = attribute_next(attribute, index);
        if current.0 == key && current.2 {
            return current.1
        }
        index = current.3;
    }
    fallback
}

#[comptime_derive]
fn field_attribute(input: DeriveInput, field: isize, key: string, fallback: string) -> string {
    let mut result = fallback;
    for index in 0..derive_field_attribute_count(input, field) {
        let attribute = derive_field_attribute(input, field, index);
        if meta_attribute_name(attribute) == "arg" {
            result = attribute_value(attribute, key, result);
        }
    }
    result
}

#[comptime_derive]
fn field_switch(input: DeriveInput, field: isize, key: string) -> bool {
    for index in 0..derive_field_attribute_count(input, field) {
        let attribute = derive_field_attribute(input, field, index);
        if meta_attribute_name(attribute) == "arg" && attribute_has(attribute, key, false) {
            return true
        }
    }
    false
}

#[comptime_derive]
fn has_field_attribute(input: DeriveInput, field: isize, key: string) -> bool {
    for index in 0..derive_field_attribute_count(input, field) {
        let attribute = derive_field_attribute(input, field, index);
        if meta_attribute_name(attribute) == "arg" && attribute_has(attribute, key, true) {
            return true
        }
    }
    false
}

#[comptime_derive]
fn validate_field_attributes(input: DeriveInput, field: isize) -> () {
    for index in 0..derive_field_attribute_count(input, field) {
        let attribute = derive_field_attribute(input, field, index);
        if meta_attribute_name(attribute) != "arg" {
            continue;
        }
        validate_attribute_syntax(attribute);
        let mut cursor = attribute_start(attribute);
        while cursor < meta_attribute_text(attribute).byte_len() {
            let current = attribute_next(attribute, cursor);
            let name = current.0;
            if name == "" {
                break;
            }
            if !current.2 {
                if name != "positional" && name != "required" && name != "optional"
                    && name != "multiple"
                    && name != "count"
                    && name != "global"
                    && name != "flatten"
                    && name != "subcommand" {
                    compile_error("unknown CLI argument switch: " + name)
                }
            } else if name != "long" && name != "short" && name != "help" && name != "default"
                && name != "env"
                && name != "choices"
                && name != "conflicts"
                && name != "requires"
                && name != "alias" {
                compile_error("unknown CLI argument attribute: " + name)
            }
            cursor = current.3;
        }
    }
}

#[comptime_derive]
fn kebab_case(name: string) -> string {
    let mut result = "";
    for index in 0..name.byte_len() {
        let part = name.byte_slice(index, index + 1);
        result = result
            + if part == "_" {
                "-"
            } else {
                part
            };
    }
    result
}

#[comptime_derive]
fn field_mode(input: DeriveInput, field: isize) -> string {
    let ty = derive_field_type(input, field);
    if field_switch(input, field, "count") {
        if !meta_type_equal(ty, meta_type_call_site("isize")) {
            compile_error("CLI count fields must have type isize")
        }
        return "count"
    }
    if field_switch(input, field, "optional") {
        return "optional"
    }
    if field_switch(input, field, "multiple") {
        return "values"
    }
    if meta_type_kind(ty) == "application" && meta_type_argument_count(ty) == 1 {
        let argument = meta_type_argument(ty, 0);
        if meta_type_equal(ty, meta_type_apply(meta_type_call_site("Option"), types_one(argument))) {
            return "optional"
        }
        if meta_type_equal(ty, meta_type_apply(meta_type_call_site("Vec"), types_one(argument))) {
            return "values"
        }
    }
    if meta_type_equal(ty, meta_type_call_site("bool")) {
        "flag"
    } else {
        "value"
    }
}

#[comptime_derive]
fn argument_schema(input: DeriveInput, field: isize, position: MetaExpr) -> MetaExpr {
    let name = field_attribute(input, field, "long", kebab_case(derive_field_name(input, field)));
    let mode = field_mode(input, field);
    let constructor = if mode == "flag" {
        "flag"
    } else if mode == "count" {
        "counter"
    } else {
        "argument"
    };
    let mut expression = meta_expr_call(input, constructor, args_one(meta_expr_string(name)));
    if field_switch(input, field, "global") {
        expression = meta_expr_method_call(expression, "global", args_one(meta_expr_bool(true)));
    }
    let alias = field_attribute(input, field, "alias", "");
    if alias != "" {
        expression = meta_expr_method_call(expression, "alias", args_one(meta_expr_string(alias)));
    }
    if mode == "values" {
        expression = meta_expr_method_call(expression, "multiple", args_one(meta_expr_bool(true)));
    }
    let fallback = field_attribute(input, field, "default", "");
    let optional = mode == "optional" || mode == "flag" || mode == "count" || mode == "values";
    if field_switch(input, field, "required")
        || (!optional && !has_field_attribute(input, field, "default")) {
        expression = meta_expr_method_call(expression, "required", args_one(meta_expr_bool(true)));
    }
    if field_switch(input, field, "positional") {
        if mode == "flag" || mode == "count" {
            compile_error("CLI boolean flags and counters cannot be positional")
        }
        expression = meta_expr_method_call(expression, "positional", args_one(position));
    }
    let short = field_attribute(input, field, "short", "");
    if short != "" {
        if short.byte_len() != 1 {
            compile_error("CLI short options require one ASCII character")
        }
        expression = meta_expr_method_call(expression, "short", args_one(meta_expr_char(short)));
    }
    let help = field_attribute(input, field, "help", "");
    if help != "" {
        expression = meta_expr_method_call(expression, "help", args_one(meta_expr_string(help)));
    }
    if has_field_attribute(input, field, "default") {
        expression = meta_expr_method_call(
            expression,
            "default_value",
            args_one(meta_expr_string(fallback)),
        );
    }
    let environment = field_attribute(input, field, "env", "");
    if environment != "" {
        expression = meta_expr_method_call(
            expression,
            "env",
            args_one(meta_expr_string(environment)),
        );
    }
    let choices = field_attribute(input, field, "choices", "");
    if choices != "" {
        expression = meta_expr_method_call(
            expression,
            "possible_values",
            args_one(
                meta_expr_method_call(
                    meta_expr_string(choices),
                    "split",
                    args_one(meta_expr_string("|")),
                ),
            ),
        );
    }
    let conflicts = field_attribute(input, field, "conflicts", "");
    if conflicts != "" {
        expression = meta_expr_method_call(
            expression,
            "conflicts_with",
            args_one(
                meta_expr_method_call(
                    meta_expr_string(conflicts),
                    "split",
                    args_one(meta_expr_string("|")),
                ),
            ),
        );
    }
    let dependencies = field_attribute(input, field, "requires", "");
    if dependencies != "" {
        expression = meta_expr_method_call(
            expression,
            "requires",
            args_one(
                meta_expr_method_call(
                    meta_expr_string(dependencies),
                    "split",
                    args_one(meta_expr_string("|")),
                ),
            ),
        );
    }
    expression
}

#[comptime_derive(Args)]
pub fn derive_args(input: DeriveInput) -> DeriveOutput {
    if derive_item_kind(input) != 0 {
        compile_error("Args derive requires a struct; use Subcommands for enums")
    }
    let output = derive_output_new(input, "Args");
    let schema = meta_block_new();
    let command_name = derive_fresh_name(input, "cli_command");
    let mut name = derive_item_name(input);
    let mut description = "";
    let mut version = "";
    let mut alias = "";
    for index in 0..derive_attribute_count(input) {
        let attribute = derive_attribute(input, index);
        if meta_attribute_name(attribute) == "command" {
            validate_attribute_syntax(attribute);
            let mut cursor = attribute_start(attribute);
            while cursor < meta_attribute_text(attribute).byte_len() {
                let current = attribute_next(attribute, cursor);
                if current.0 == "" {
                    break;
                }
                if !current.2 {
                    compile_error("command attributes require named string values")
                }
                let key = current.0;
                if key != "name" && key != "about" && key != "version" && key != "alias" {
                    compile_error("unknown command attribute: " + key)
                }
                cursor = current.3;
            }
            name = attribute_value(attribute, "name", name);
            description = attribute_value(attribute, "about", description);
            version = attribute_value(attribute, "version", version);
            alias = attribute_value(attribute, "alias", alias);
        }
    }
    let command = meta_expr_call(input, "command", args_one(meta_expr_string(name)));
    let command = meta_expr_method_call(command, "about", args_one(meta_expr_string(description)));
    let command = meta_expr_method_call(command, "version", args_one(meta_expr_string(version)));
    let command = if alias == "" {
        command
    } else {
        meta_expr_method_call(command, "alias", args_one(meta_expr_string(alias)))
    };
    meta_block_let_mut(schema, command_name, command);
    let fields = meta_expr_field_list_new();
    let mut subcommand_seen = false;
    for index in 0..derive_field_count(input) {
        validate_field_attributes(input, index);
        let field_type = derive_field_type(input, index);
        if field_switch(input, index, "flatten") || field_switch(input, index, "subcommand") {
            let flatten = field_switch(input, index, "flatten");
            validate_composed_field(input, index, flatten);
            if !flatten && subcommand_seen {
                compile_error("Args permits only one subcommand field at each level")
            }
            if !flatten {
                subcommand_seen = true;
            }
            let optional = !flatten && is_container(field_type, "Option");
            let nested_type = if optional {
                meta_type_argument(field_type, 0)
            } else {
                field_type
            };
            derive_output_add_predicate(
                output,
                nested_type,
                if flatten {
                    "Args"
                } else {
                    "Subcommands"
                },
            );
            let nested = typed_schema_expression(
                input,
                schema,
                nested_type,
                if flatten {
                    "command_for"
                } else {
                    "subcommands_for"
                },
            );
            let nested = if flatten {
                nested
            } else {
                meta_expr_method_call(
                    nested,
                    "require_subcommand",
                    args_one(meta_expr_bool(!optional || field_switch(input, index, "required"))),
                )
            };
            meta_block_assign(
                schema,
                meta_expr_var(command_name),
                meta_expr_method_call(meta_expr_var(command_name), "flatten_args", args_one(nested)),
            );
            let decoder = if flatten {
                "decode_args"
            } else if optional {
                "decode_optional_subcommand"
            } else {
                "decode_subcommand"
            };
            let value = meta_expr_try(
                meta_expr_call(input, decoder, args_one(meta_expr_var("matches"))),
            );
            meta_expr_field_list_push(fields, derive_field_name(input, index), value);
            continue;
        }
        validate_value_modes(input, index);
        let mode = field_mode(input, index);
        if mode != "flag" && mode != "count" {
            let value_type = if (mode == "values" || mode == "optional")
                && meta_type_kind(field_type) == "application" {
                meta_type_argument(field_type, 0)
            } else {
                field_type
            };
            derive_output_add_predicate(output, value_type, "ArgValue");
        }
        let argument = argument_schema(
            input,
            index,
            meta_expr_method_call(
                meta_expr_var(command_name),
                "positional_count",
                meta_expr_list_new(),
            ),
        );
        meta_block_assign(
            schema,
            meta_expr_var(command_name),
            meta_expr_method_call(meta_expr_var(command_name), "arg", args_one(argument)),
        );
        let name = field_attribute(
            input,
            index,
            "long",
            kebab_case(derive_field_name(input, index)),
        );
        let value = meta_expr_method_call(
            meta_expr_var("matches"),
            mode,
            args_one(meta_expr_string(name)),
        );
        let value = if mode == "flag" || mode == "count" {
            value
        } else {
            meta_expr_try(value)
        };
        meta_expr_field_list_push(fields, derive_field_name(input, index), value);
    }
    let typed_fields = meta_expr_field_list_new();
    meta_expr_field_list_push(typed_fields, "command", meta_expr_var(command_name));
    let typed = meta_expr_struct(input, "TypedCommand", typed_fields);
    derive_output_add_method(
        output,
        meta_method(
            "schema",
            meta_param_list_new(),
            meta_type_apply(
                meta_type_named(input, "TypedCommand"),
                types_one(derive_target_type(input)),
            ),
            meta_block_finish(schema, typed),
        ),
    );
    let parameters = meta_param_list_new();
    meta_param_list_push(parameters, "matches", meta_type_named(input, "Matches"));
    let result_types = types_one(derive_target_type(input));
    meta_type_list_push(result_types, meta_type_named(input, "Error"));
    let body = meta_expr_constructor("Result::Ok", args_one(meta_expr_target_struct(input, fields)));
    derive_output_add_method(
        output,
        meta_method(
            "from_matches",
            parameters,
            meta_type_apply(meta_type_call_site("Result"), result_types),
            body,
        ),
    );
    output
}
