package cli;

fn display_argument(argument: Argument) -> string {
    if argument.position.is_some() {
        let suffix = if argument.repeated {
            "..."
        } else {
            ""
        };
        if argument.required_value {
            "<" + argument.name + ">" + suffix
        } else {
            "[" + argument.name + "]" + suffix
        }
    } else {
        let prefix = match argument.short_name {
            Some(value) => f"-{value}, ",
            None => "    ",
        };
        prefix + "--" + argument.name
            + if argument.action == Action::Value {
                " <VALUE>"
            } else {
                ""
            }
    }
}

impl Command {
    pub fn help_text(self: Command) -> string {
        let output: Vec[string] = Vec::new();
        if self.description != "" {
            output.push(self.description + "\n\n");
        }
        let mut usage = "Usage: " + self.name + " [OPTIONS]";
        let positional: Vec[Argument] = Vec::new();
        for argument in self.arguments {
            if argument.position.is_some() {
                positional.push(argument);
            }
        }
        positional.sort_by(|left, right| left.position.unwrap_or(0) - right.position.unwrap_or(0));
        for argument in positional {
            usage += " " + display_argument(argument);
        }
        if !self.commands.is_empty() {
            usage += if self.subcommand_required {
                " <COMMAND>"
            } else {
                " [COMMAND]"
            };
        }
        output.push(usage + "\n\nOptions:\n");
        for argument in self.arguments {
            if argument.position.is_some() {
                continue;
            }
            let mut description = argument.description;
            if !argument.aliases.is_empty() {
                description += " [aliases: --" + argument.aliases.join(", --") + "]";
            }
            if argument.global_value {
                description += " [global]";
            }
            if !argument.defaults.is_empty() {
                description += " [default: " + argument.defaults.join(", ") + "]";
            }
            if let Some(name) = argument.environment {
                description += " [env: " + name + "]";
            }
            if !argument.choices.is_empty() {
                description += " [choices: " + argument.choices.join(", ") + "]";
            }
            if argument.required_value {
                description += " [required]";
            }
            output.push("  " + display_argument(argument) + "  " + description + "\n");
        }
        output.push("  -h, --help  Show help\n");
        if self.version_value != "" {
            output.push("  -V, --version  Show version\n");
        }
        if !positional.is_empty() {
            output.push("\nArguments:\n");
            for argument in positional {
                output.push("  " + display_argument(argument) + "  " + argument.description + "\n");
            }
        }
        if !self.commands.is_empty() {
            output.push("\nCommands:\n");
            for command in self.commands {
                let aliases = if command.aliases.is_empty() {
                    ""
                } else {
                    " [aliases: " + command.aliases.join(", ") + "]"
                };
                output.push("  " + command.name + "  " + command.description + aliases + "\n");
            }
        }
        if !self.groups.is_empty() {
            output.push("\nArgument groups:\n");
            for group in self.groups {
                output.push(
                    f"  {group.name}: choose {group.minimum} through {group.maximum} of "
                        + group.members.join(", ")
                        + "\n",
                );
            }
        }
        output.join("")
    }
}
