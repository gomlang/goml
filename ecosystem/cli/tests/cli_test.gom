package tests;

use ecosystem::cli;
use cli::Args;
use std::testing;

fn command() -> cli::Command {
    cli::Command::new("tool").about("Test tool").version("1.0").arg(
        cli::Argument::counter("verbose").short('v'),
    ).arg(cli::Argument::new("port").short('p').default_value("80").env("PORT")).arg(
        cli::Argument::flag("quiet").short('q').conflicts_with(Vec::from_array(["verbose"])),
    ).arg(cli::Argument::new("mode").possible_values(Vec::from_array(["fast", "safe"]))).arg(
        cli::Argument::new("files").positional(0).multiple(true),
    )
}

#[test]
fn short_clusters_inline_values_and_terminator() -> () {
    let matches = testing::expect_ok(
        command().parse(Vec::from_array(["-vvp9000", "--mode=safe", "--", "-file", "other"])),
        "parse",
    );
    testing::assert_eq(matches.count("verbose"), 2);
    let port: isize = testing::expect_ok(matches.value("port"), "port");
    testing::assert_eq(port, 9000);
    testing::assert(matches.raw("files") == Vec::from_array(["-file", "other"]));
    testing::assert_eq(matches.raw("mode")[0], "safe");
    testing::assert_err(command().parse(Vec::from_array(["-vq"])));
    testing::assert_err(command().parse(Vec::from_array(["--mode=bad"])));
    testing::assert_err(command().parse(Vec::from_array(["--port"])));
    testing::assert_err(command().parse(Vec::from_array(["--port=1", "--port=2"])));
    testing::assert_err(command().parse(Vec::from_array(["--quiet=true"])));
}

#[test]
fn environment_defaults_and_value_errors() -> () {
    let environment = |name: string| if name == "PORT" {
        Option::Some("123")
    } else {
        Option::None
    };
    let matches = testing::expect_ok(
        command().parse_with_env(Vec::new(), environment),
        "environment",
    );
    testing::assert_eq(matches.raw("port")[0], "123");
    testing::assert(matches.was_provided("port"));
    let matches = testing::expect_ok(
        command().parse_with_env(Vec::from_array(["-p45"]), environment),
        "override",
    );
    testing::assert_eq(matches.raw("port")[0], "45");
    let matches = testing::expect_ok(command().parse(Vec::new()), "defaults");
    testing::assert_eq(matches.raw("port")[0], "80");
    testing::assert(!matches.was_provided("port"));
    let matches = testing::expect_ok(command().parse(Vec::from_array(["-pabc"])), "raw value");
    let invalid: Result[isize, cli::Error] = matches.value("port");
    testing::assert_eq(
        testing::expect_err(invalid, "invalid value").kind,
        cli::ErrorKind::InvalidValue,
    );
}

#[test]
fn subcommands_help_and_schema_validation() -> () {
    let root = cli::Command::new("app").require_subcommand(true).subcommand(
        cli::Command::new("serve").arg(cli::Argument::new("port").required(true)),
    );
    testing::assert_err(root.parse(Vec::new()));
    let matches = testing::expect_ok(
        root.parse(Vec::from_array(["serve", "--port", "80"])),
        "subcommand",
    );
    let child = testing::expect_some(matches.subcommand(), "child");
    testing::assert_eq(child.command, "serve");
    testing::assert_eq(child.raw("port")[0], "80");
    let help = testing::expect_err(root.parse(Vec::from_array(["serve", "--help"])), "help");
    testing::assert_eq(help.kind, cli::ErrorKind::Help);
    testing::assert(help.message.contains("Usage: serve"));
    testing::assert_eq(
        testing::expect_err(command().parse(Vec::from_array(["--version"])), "version").message,
        "tool 1.0",
    );
    testing::assert_err(
        cli::Command::new("bad").arg(cli::Argument::flag("x").short('h')).validate(),
    );
    testing::assert_err(
        cli::Command::new("bad").arg(cli::Argument::new("x").positional(1)).validate(),
    );
    testing::assert_err(
        cli::Command::new("bad").arg(cli::Argument::new("x").requires(Vec::from_array(["missing"]))).validate(),
    );
}

#[derive(Args)]
#[command(name = "server", about = "Serve files", version = "2.0")]
struct Settings {
    #[arg(short = "p", default = "8080", help = "Listen port")]
    port: isize,
    #[arg(short = "v", count)]
    verbose: isize,
    quiet: bool,
    host: Option[string],
    #[arg(positional)]
    files: Vec[string],
}

#[test]
fn derive_struct_schema_and_decoding() -> () {
    let parsed: Settings = testing::expect_ok(
        cli::parse(Vec::from_array(["-vv", "--host=localhost", "one", "two"])),
        "derive",
    );
    testing::assert_eq(parsed.port, 8080);
    testing::assert_eq(parsed.verbose, 2);
    testing::assert(!parsed.quiet);
    testing::assert_eq(parsed.host.unwrap_or(""), "localhost");
    testing::assert(parsed.files == Vec::from_array(["one", "two"]));
    let schema = cli::command_for::[Settings]();
    testing::assert(schema.command.help_text().contains("Serve files"));
    let invalid: Result[Settings, cli::Error] = cli::parse(Vec::from_array(["--port=bad"]));
    testing::assert_err(invalid);
}

#[derive(Args)]
struct Generic[T] {
    value: T,
}

enum Mode {
    Fast,
    Safe,
}

impl cli::ArgValue for Mode {
    fn parse_value(value: string) -> Result[Mode, string] {
        match value {
            "fast" => Result::Ok(Mode::Fast),
            "safe" => Result::Ok(Mode::Safe),
            _ => Result::Err("expected fast or safe"),
        }
    }
}

#[test]
fn generic_derive_and_custom_field_conversion() -> () {
    let parsed: Generic[Mode] = testing::expect_ok(
        cli::parse(Vec::from_array(["--value=safe"])),
        "generic",
    );
    testing::assert(
        match parsed.value {
            Safe => true,
            _ => false,
        },
    );
}
