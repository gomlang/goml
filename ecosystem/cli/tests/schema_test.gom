package tests;

use ecosystem::cli;
use cli::Args;
use std::testing;

fn global_command() -> cli::Command {
    cli::Command::new("app").arg(
        cli::Argument::counter("verbose").short('v').alias("verbosity").global(true),
    ).arg(cli::Argument::new("config").global(true).required(true).env("CONFIG")).arg(
        cli::Argument::flag("local").conflicts_with(Vec::from_array(["verbose"])),
    ).subcommand(
        cli::Command::new("remote").alias("r").arg(cli::Argument::flag("force").global(true)).subcommand(
            cli::Command::new("add").alias("a").arg(cli::Argument::new("name").positional(0)),
        ),
    )
}

#[test]
fn global_options_accumulate_across_nested_aliases_and_validate_at_their_owner() -> () {
    let root = global_command();
    let matches = testing::expect_ok(
        root.parse(
            Vec::from_array(
                ["-v", "r", "--force", "a", "--verbosity", "--config=dev", "origin", "-v"],
            ),
        ),
        "nested globals",
    );
    let child = testing::expect_some(matches.subcommand(), "child");
    let leaf = testing::expect_some(child.subcommand(), "leaf");
    testing::assert_eq(child.command, "remote");
    testing::assert_eq(leaf.command, "add");
    for level in Vec::from_array([matches, child, leaf]) {
        testing::assert_eq(level.count("verbose"), 3);
        testing::assert_eq(level.raw("config")[0], "dev");
        testing::assert(level.was_provided("config"));
    }
    testing::assert(!matches.contains("force"));
    testing::assert(child.flag("force"));
    testing::assert(leaf.flag("force"));
    testing::assert_eq(leaf.raw("name")[0], "origin");
    testing::assert_err(root.parse(Vec::from_array(["--config=a", "r", "a", "--config=b"])));
    testing::assert_err(root.parse(Vec::from_array(["--local", "r", "a", "-v", "--config=x"])));
    testing::assert_err(root.parse(Vec::from_array(["r", "--local"])));
    let matches = testing::expect_ok(
        root.parse_with_env(Vec::from_array(["r", "a"]), |_| Option::Some("env")),
        "global environment",
    );
    testing::assert_eq(matches.raw("config")[0], "env");
    let help = testing::expect_err(root.parse(Vec::from_array(["r", "a", "--help"])), "help");
    testing::assert(help.message.contains("--verbose"));
    testing::assert(help.message.contains("[global]"));
    testing::assert(root.help_text().contains("[aliases: r]"));
    testing::assert_err(root.parse(Vec::from_array(["r", "a", "--", "--config=x"])));
}

#[test]
fn groups_count_distinct_provided_members_and_reject_invalid_schemas() -> () {
    let command = cli::Command::new("auth").arg(
        cli::Argument::new("token").alias("key").env("TOKEN"),
    ).arg(cli::Argument::flag("anonymous")).arg(cli::Argument::counter("interactive").short('i')).group(
        cli::ArgGroup::new("identity", Vec::from_array(["token", "anonymous", "interactive"])).required(
            true,
        ),
    );
    testing::assert_err(command.parse(Vec::new()));
    testing::assert_ok(command.parse(Vec::from_array(["-iii"])));
    testing::assert_ok(command.parse(Vec::from_array(["--key=x"])));
    testing::assert_err(command.parse(Vec::from_array(["--key=x", "--anonymous"])));
    testing::assert_ok(command.parse_with_env(Vec::new(), |_| Option::Some("env")));
    testing::assert_err(
        command.parse_with_env(Vec::from_array(["--anonymous"]), |_| Option::Some("env")),
    );
    let defaults = cli::Command::new("default").arg(
        cli::Argument::new("mode").default_value("safe"),
    ).group(cli::ArgGroup::new("selection", Vec::from_array(["mode"])).required(true));
    testing::assert_err(defaults.parse(Vec::new()));
    for invalid in Vec::from_array(
        [
            cli::Command::new("app").arg(cli::Argument::flag("x").alias("help")),
            cli::Command::new("app").arg(cli::Argument::flag("x").alias("y")).arg(
                cli::Argument::flag("y"),
            ),
            cli::Command::new("app").arg(cli::Argument::new("x").positional(0).global(true)),
            cli::Command::new("app").arg(cli::Argument::flag("x").global(true)).subcommand(
                cli::Command::new("child").arg(cli::Argument::flag("x")),
            ),
            cli::Command::new("app").subcommand(cli::Command::new("run").alias("r")).subcommand(
                cli::Command::new("r"),
            ),
            cli::Command::new("app").group(cli::ArgGroup::new("bad", Vec::from_array(["missing"]))),
            cli::Command::new("app").arg(cli::Argument::flag("x")).group(
                cli::ArgGroup::new("bad", Vec::from_array(["x", "x"])),
            ),
            cli::Command::new("app").arg(cli::Argument::flag("x")).group(
                cli::ArgGroup::new("bad", Vec::from_array(["x"])).bounds(2, 1),
            ),
        ],
    ) {
        testing::assert_eq(
            testing::expect_err(invalid.validate(), "schema").kind,
            cli::ErrorKind::InvalidSchema,
        );
    }
}

#[derive(Args)]
struct Aliased {
    #[arg(alias = "configuration", global, default = "dev")]
    config: string,
}

#[test]
fn derived_alias_and_global_schema_preserve_canonical_decoding() -> () {
    let parsed: Aliased = testing::expect_ok(
        cli::parse(Vec::from_array(["--configuration=prod"])),
        "derived alias",
    );
    testing::assert_eq(parsed.config, "prod");
    let command = cli::command_for::[Aliased]().command.subcommand(cli::Command::new("run"));
    let matches = testing::expect_ok(
        command.parse(Vec::from_array(["run", "--configuration=prod"])),
        "derived global",
    );
    let parsed: Aliased = testing::expect_ok(Args::from_matches(matches), "from matches");
    testing::assert_eq(parsed.config, "prod");
}
