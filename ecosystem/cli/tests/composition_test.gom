package tests;

use ecosystem::cli;
use cli::Args;
use std::testing;

struct Choice {
    left: bool,
    right: bool,
}

impl Args for Choice {
    fn schema() -> cli::TypedCommand[Choice] {
        cli::TypedCommand {
            command: cli::Command::new("choice").about("Nested metadata").version("nested").arg(
                cli::Argument::flag("left").conflicts_with(Vec::from_array(["quiet"])),
            ).arg(cli::Argument::flag("right")).group(
                cli::ArgGroup::new("choice", Vec::from_array(["left", "right"])).required(true),
            ),
        }
    }

    fn from_matches(matches: cli::Matches) -> Result[Choice, cli::Error] {
        Result::Ok(Choice { left: matches.flag("left"), right: matches.flag("right") })
    }
}

#[derive(Args)]
#[command(name = "outer", about = "Outer metadata", version = "outer", alias = "o")]
struct Flattened {
    #[arg(flatten)]
    choice: Choice,
    quiet: bool,
}

#[test]
fn flatten_preserves_groups_cross_group_constraints_and_parent_metadata() -> () {
    let parsed: Flattened = testing::expect_ok(cli::parse(Vec::from_array(["--left"])), "choice");
    testing::assert(parsed.choice.left);
    testing::assert(!parsed.choice.right);
    testing::assert(!parsed.quiet);
    for arguments in Vec::from_array(
        [Vec::new(), Vec::from_array(["--left", "--right"]), Vec::from_array(["--left", "--quiet"])],
    ) {
        let parsed: Result[Flattened, cli::Error] = cli::parse(arguments);
        testing::assert_eq(
            testing::expect_err(parsed, "group or conflict").kind,
            cli::ErrorKind::Usage,
        );
    }
    let command = cli::schema::[Flattened]();
    testing::assert_eq(command.name, "outer");
    testing::assert_eq(command.description, "Outer metadata");
    testing::assert_eq(command.version_value, "outer");
    testing::assert(command.aliases == Vec::from_array(["o"]));
    testing::assert(command.help_text().contains("choice: choose 1 through 1 of left, right"));
}

#[test]
fn explicit_composition_copies_inputs_and_preserves_schema_validation() -> () {
    let original = cli::Command::new("nested").arg(cli::Argument::new("nested-file").positional(0));
    let parent = cli::Command::new("parent").arg(cli::Argument::new("first").positional(0));
    let merged = parent.flatten(original);
    testing::assert_eq(merged.positional_count(), 2);
    testing::assert_eq(original.positional_count(), 1);
    testing::assert_eq(parent.positional_count(), 1);
    testing::assert(original.arguments[0].position == Option::Some(0));
    testing::assert(merged.arguments[1].position == Option::Some(1));
    testing::expect_ok(merged.validate(), "composed positions");
    let aliases = original.alias("n").named("renamed");
    testing::assert_eq(aliases.name, "renamed");
    testing::assert(aliases.aliases.is_empty());
    let invalid = parent.flatten(
        cli::Command::new("nested").arg(cli::Argument::new("gap").positional(1)),
    );
    testing::assert_eq(
        testing::expect_err(invalid.validate(), "preserved invalid offset").kind,
        cli::ErrorKind::InvalidSchema,
    );
}
