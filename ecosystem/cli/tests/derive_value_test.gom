package tests;

use ecosystem::cli;
use cli::{Args, ArgValue};
use std::testing;

#[derive(ArgValue, PartialEq)]
enum OutputFormat {
    Json,
    #[value(name = "plain-text", alias = "text")]
    PlainText,
}

#[derive(Args)]
struct OutputOptions {
    #[arg(default = "")]
    prefix: string,
    #[arg(default = "json")]
    format: OutputFormat,
    #[arg(default = "255")]
    width: u8,
}

#[test]
fn enum_aliases_empty_defaults_and_integer_widths() -> () {
    let defaults: OutputOptions = testing::expect_ok(cli::parse(Vec::new()), "defaults");
    testing::assert_eq(defaults.prefix, "");
    testing::assert(defaults.format == OutputFormat::Json);
    testing::assert_eq(defaults.width, 255);
    let selected: OutputOptions = testing::expect_ok(
        cli::parse(Vec::from_array(["--format=text"])),
        "alias",
    );
    testing::assert(selected.format == OutputFormat::PlainText);
    let bad: Result[OutputOptions, cli::Error] = cli::parse(Vec::from_array(["--width=256"]));
    testing::assert_err(bad);
    let bad: Result[OutputOptions, cli::Error] = cli::parse(Vec::from_array(["--format=xml"]));
    testing::assert(testing::expect_err(bad, "enum error").message.contains("plain-text"));
}

#[test]
fn help_output_is_deterministic() -> () {
    let command = cli::Command::new("copy").about("Copy files").arg(
        cli::Argument::flag("force").short('f').help("Overwrite destination"),
    );
    testing::assert_eq(
        command.help_text(),
        "Copy files\n\nUsage: copy [OPTIONS]\n\nOptions:\n  -f, --force  Overwrite destination\n  -h, --help  Show help\n",
    );
}
