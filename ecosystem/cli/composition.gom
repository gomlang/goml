package cli;

pub trait Subcommands {
    fn schema() -> TypedCommand[Self];
    fn from_subcommand(matches: Matches) -> Result[Self, Error];
}

pub fn subcommands_for[T: Subcommands]() -> TypedCommand[T] {
    Subcommands::schema()
}

pub fn decode_args[T: Args](matches: Matches) -> Result[T, Error] {
    Args::from_matches(matches)
}

pub fn decode_subcommand[T: Subcommands](matches: Matches) -> Result[T, Error] {
    let Some(child) = matches.subcommand() else {
        return Result::Err(problem(ErrorKind::Usage, "a subcommand is required"))
    };
    Subcommands::from_subcommand(child)
}

pub fn decode_optional_subcommand[T: Subcommands](matches: Matches) -> Result[Option[T], Error] {
    match matches.subcommand() {
        Some(child) => {
            let value: T = Subcommands::from_subcommand(child)?;
            Result::Ok(Option::Some(value))
        },
        None => Result::Ok(Option::None),
    }
}

impl Matches {
    pub fn unrecognized_subcommand(self: Matches) -> Error {
        problem(ErrorKind::Usage, "unrecognized subcommand: " + self.command)
    }
}

impl Command {
    pub fn named(self: Command, name: string) -> Command {
        Command { name, aliases: Vec::new(), ..self }
    }

    pub fn positional_count(self: Command) -> isize {
        let mut count = 0;
        for argument in self.arguments {
            if argument.position.is_some() {
                count += 1;
            }
        }
        count
    }

    pub fn flatten(self: Command, nested: Command) -> Command {
        let offset = self.positional_count();
        let arguments = self.arguments.copy();
        for argument in nested.arguments {
            arguments.push(
                Argument { position: argument.position.map(|index| index + offset), ..argument },
            );
        }
        let commands = self.commands.copy();
        commands.extend(nested.commands);
        let groups = self.groups.copy();
        groups.extend(nested.groups);
        let composition_errors = self.composition_errors.copy();
        composition_errors.extend(nested.composition_errors);
        Command {
            arguments,
            commands,
            groups,
            composition_errors,
            subcommand_required: self.subcommand_required || nested.subcommand_required,
            ..self,
        }
    }

    pub fn flatten_args(self: Command, nested: Command) -> Command {
        let multiple = !self.commands.is_empty() && !nested.commands.is_empty();
        let result = self.flatten(nested);
        if multiple {
            result.composition_errors.push(
                "multiple subcommand selectors at the same command level",
            );
        }
        result
    }
}
