package cli;

impl Argument {
    pub fn short(self: Argument, value: char) -> Argument {
        let mut result = self;
        result.short_name = Option::Some(value);
        result
    }

    pub fn help(self: Argument, value: string) -> Argument {
        let mut result = self;
        result.description = value;
        result
    }

    pub fn required(self: Argument, value: bool) -> Argument {
        let mut result = self;
        result.required_value = value;
        result
    }

    pub fn multiple(self: Argument, value: bool) -> Argument {
        let mut result = self;
        result.repeated = value;
        result
    }

    pub fn positional(self: Argument, value: isize) -> Argument {
        let mut result = self;
        result.position = Option::Some(value);
        result
    }

    pub fn default_value(self: Argument, value: string) -> Argument {
        let mut result = self;
        result.defaults = Vec::from_array([value]);
        result
    }

    pub fn env(self: Argument, value: string) -> Argument {
        let mut result = self;
        result.environment = Option::Some(value);
        result
    }

    pub fn possible_values(self: Argument, value: Vec[string]) -> Argument {
        let mut result = self;
        result.choices = value.copy();
        result
    }

    pub fn conflicts_with(self: Argument, value: Vec[string]) -> Argument {
        let mut result = self;
        result.conflicts = value.copy();
        result
    }

    pub fn requires(self: Argument, value: Vec[string]) -> Argument {
        let mut result = self;
        result.dependencies = value.copy();
        result
    }
}

impl Command {
    pub fn about(self: Command, value: string) -> Command {
        let mut result = self;
        result.description = value;
        result
    }

    pub fn version(self: Command, value: string) -> Command {
        let mut result = self;
        result.version_value = value;
        result
    }

    pub fn require_subcommand(self: Command, value: bool) -> Command {
        let mut result = self;
        result.subcommand_required = value;
        result
    }
}
