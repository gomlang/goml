package cli;

use std::num;

pub trait ArgValue {
    fn parse_value(value: string) -> Result[Self, string];
}

impl ArgValue for string {
    fn parse_value(value: string) -> Result[string, string] {
        Result::Ok(value)
    }
}

impl ArgValue for bool {
    fn parse_value(value: string) -> Result[bool, string] {
        if value == "true" || value == "1" {
            Result::Ok(true)
        } else if value == "false" || value == "0" {
            Result::Ok(false)
        } else {
            Result::Err("expected true or false")
        }
    }
}

impl ArgValue for isize {
    fn parse_value(value: string) -> Result[isize, string] {
        num::parse_int_structured(value).map_err(|error| error.to_string())
    }
}

impl ArgValue for usize {
    fn parse_value(value: string) -> Result[usize, string] {
        num::parse_uint_structured(value).map_err(|error| error.to_string())
    }
}

impl ArgValue for i64 {
    fn parse_value(value: string) -> Result[i64, string] {
        num::parse_int_structured(value).map(|value| value.to_i64()).map_err(
            |error| error.to_string(),
        )
    }
}

impl ArgValue for u64 {
    fn parse_value(value: string) -> Result[u64, string] {
        num::parse_uint_structured(value).map(|value| value.to_u64()).map_err(
            |error| error.to_string(),
        )
    }
}

impl ArgValue for f64 {
    fn parse_value(value: string) -> Result[f64, string] {
        num::parse_float64_structured(value).map_err(|error| error.to_string())
    }
}

impl ArgValue for f32 {
    fn parse_value(value: string) -> Result[f32, string] {
        num::parse_float32_structured(value).map_err(|error| error.to_string())
    }
}

impl Matches {
    pub fn contains(self: Matches, name: string) -> bool {
        self.values_by_name.contains(name)
    }

    pub fn was_provided(self: Matches, name: string) -> bool {
        self.explicit_names.contains(name)
    }

    pub fn raw(self: Matches, name: string) -> Vec[string] {
        self.values_by_name.get(name).unwrap_or(Vec::new()).copy()
    }

    pub fn value[T: ArgValue](self: Matches, name: string) -> Result[T, Error] {
        let values = self.raw(name);
        if values.len() != 1 {
            return Result::Err(problem(ErrorKind::Usage, f"expected one value for {name}"))
        }
        let parsed: Result[T, string] = ArgValue::parse_value(values[0]);
        parsed.map_err(|message| problem(ErrorKind::InvalidValue, f"{name}: {message}"))
    }

    pub fn optional[T: ArgValue](self: Matches, name: string) -> Result[Option[T], Error] {
        if !self.contains(name) {
            Result::Ok(Option::None)
        } else {
            Result::Ok(Option::Some(self.value(name)?))
        }
    }

    pub fn values[T: ArgValue](self: Matches, name: string) -> Result[Vec[T], Error] {
        let result: Vec[T] = Vec::new();
        for value in self.raw(name) {
            let parsed: Result[T, string] = ArgValue::parse_value(value);
            result.push(
                parsed.map_err(|message| problem(ErrorKind::InvalidValue, f"{name}: {message}"))?,
            );
        }
        Result::Ok(result)
    }

    pub fn flag(self: Matches, name: string) -> bool {
        self.raw(name).last().unwrap_or("false") == "true"
    }

    pub fn count(self: Matches, name: string) -> isize {
        self.raw(name).len()
    }

    pub fn subcommand(self: Matches) -> Option[Matches] {
        self.children.get_checked(0)
    }
}
