package cli;

#[comptime_derive]
fn attribute_space(text: string, start: isize) -> isize {
    let mut index = start;
    while index < text.byte_len() {
        let value = text.byte_get(index);
        if value == b' ' || value == b'\t' || value == b'\r' || value == b'\n' {
            index += 1;
        } else if value == b'/' && index + 1 < text.byte_len() && text.byte_get(index + 1) == b'/' {
            index += 2;
            while index < text.byte_len() && text.byte_get(index) != b'\n' {
                index += 1;
            }
        } else if value == b'/' && index + 1 < text.byte_len() && text.byte_get(index + 1) == b'*' {
            index += 2;
            let mut depth = 1;
            while index < text.byte_len() && depth > 0 {
                if index + 1 < text.byte_len() && text.byte_get(index) == b'/'
                    && text.byte_get(index + 1) == b'*' {
                    depth += 1;
                    index += 2;
                } else if index + 1 < text.byte_len() && text.byte_get(index) == b'*'
                    && text.byte_get(index + 1) == b'/' {
                    depth -= 1;
                    index += 2;
                } else {
                    index += 1;
                }
            }
        } else {
            break;
        }
    }
    index
}

#[comptime_derive]
fn attribute_identifier(value: byte, initial: bool) -> bool {
    (value >= b'a' && value <= b'z') || (value >= b'A' && value <= b'Z') || value == b'_'
        || (!initial && value >= b'0' && value <= b'9')
}

#[comptime_derive]
fn attribute_start(attribute: MetaAttribute) -> isize {
    let text = meta_attribute_text(attribute);
    if !meta_attribute_has_argument_list(attribute) {
        return text.byte_len()
    }
    let mut index = 0;
    while index < text.byte_len() {
        index = attribute_space(text, index);
        if index >= text.byte_len() || text.byte_get(index) == b'(' {
            return index + 1
        }
        index += 1;
    }
    index
}

#[comptime_derive]
fn attribute_string(attribute: MetaAttribute, key: string, start: isize) -> (string, isize) {
    let text = meta_attribute_text(attribute);
    let mut index = start;
    let raw = index < text.byte_len() && text.byte_get(index) == b'r';
    let mut hashes = 0;
    if raw {
        index += 1;
        while index < text.byte_len() && text.byte_get(index) == b'#' {
            hashes += 1;
            index += 1;
        }
    }
    if index >= text.byte_len() || text.byte_get(index) != b'"' {
        compile_error("CLI attributes require identifiers and named string values")
    }
    index += 1;
    let begin = index;
    while index < text.byte_len() {
        if text.byte_get(index) == b'"' {
            let mut matched = 0;
            while matched < hashes && index + 1 + matched < text.byte_len()
                && text.byte_get(index + 1 + matched) == b'#' {
                matched += 1;
            }
            if matched == hashes {
                if raw {
                    return (text.byte_slice(begin, index), index + 1 + hashes)
                }
                for item in 0..meta_attribute_argument_count(attribute) {
                    if meta_attribute_argument_kind(attribute, item) == "named"
                        && meta_attribute_argument_name(attribute, item) == key
                        && meta_attribute_argument_value_kind(attribute, item) == "string" {
                        return (meta_attribute_argument_text(attribute, item), index + 1)
                    }
                }
                compile_error("missing CLI string attribute metadata")
            }
        }
        if !raw && text.byte_get(index) == b'\\' {
            index += 1;
        }
        index += 1;
    }
    compile_error("unterminated CLI string attribute")
}

#[comptime_derive]
fn attribute_next(attribute: MetaAttribute, start: isize) -> (string, string, bool, isize) {
    let text = meta_attribute_text(attribute);
    let mut index = attribute_space(text, start);
    if index >= text.byte_len() || text.byte_get(index) == b')' {
        return ("", "", false, text.byte_len())
    }
    if !attribute_identifier(text.byte_get(index), true) {
        compile_error("CLI attributes require identifiers and named string values")
    }
    let begin = index;
    index += 1;
    while index < text.byte_len() && attribute_identifier(text.byte_get(index), false) {
        index += 1;
    }
    let key = text.byte_slice(begin, index);
    index = attribute_space(text, index);
    let named = index < text.byte_len() && text.byte_get(index) == b'=';
    let mut value = "";
    if named {
        let parsed = attribute_string(attribute, key, attribute_space(text, index + 1));
        value = parsed.0;
        index = attribute_space(text, parsed.1);
    }
    if index >= text.byte_len() || (text.byte_get(index) != b',' && text.byte_get(index) != b')') {
        compile_error("CLI attributes require identifiers and named string values")
    }
    let next = if text.byte_get(index) == b')' {
        text.byte_len()
    } else {
        index + 1
    };
    (key, value, named, next)
}

#[comptime_derive]
fn validate_attribute_syntax(attribute: MetaAttribute) -> () {
    let mut index = attribute_start(attribute);
    let length = meta_attribute_text(attribute).byte_len();
    while index < length {
        let current = attribute_next(attribute, index);
        if current.0 == "" {
            return
        }
        let mut previous = attribute_start(attribute);
        while previous < index {
            let prior = attribute_next(attribute, previous);
            if prior.0 == current.0 {
                compile_error("duplicate CLI attribute: " + current.0)
            }
            previous = prior.3;
        }
        index = current.3;
    }
}

#[comptime_derive]
fn attribute_has(attribute: MetaAttribute, key: string, named: bool) -> bool {
    let mut index = attribute_start(attribute);
    let length = meta_attribute_text(attribute).byte_len();
    while index < length {
        let current = attribute_next(attribute, index);
        if current.0 == key && current.2 == named {
            return true
        }
        index = current.3;
    }
    false
}
