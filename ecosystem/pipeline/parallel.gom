package pipeline;

use std::task;

struct Job[T] {
    index: isize,
    value: T,
}

struct Completed[T] {
    index: isize,
    value: Option[T],
}

impl[T, E] Stream[T, E] {
    fn parallel_run[U](
        self: Stream[T, E],
        parent: task::CancelToken,
        control: RunControl[E],
        emit: (U) -> bool,
        options: ParallelOptions,
        mapper: (task::CancelToken, T) -> Result[Option[U], E],
    ) -> Result[(), Error[E]] {
        let errors: Channel[Error[E]] = Channel::new(1);
        task::scope_with(
            parent,
            |scope| {
                defer scope.cancel();
                let cancel = scope.token();
                let jobs: Channel[Job[T]] = Channel::new(options.capacity);
                let results: Channel[Completed[U]] = Channel::new(options.capacity);
                let credits: Channel[()] = Channel::new(options.max_in_flight);
                for _ in 0..options.max_in_flight {
                    credits.send(());
                }
                let workers: Vec[task::Task[()]] = Vec::new();
                for _ in 0..options.workers {
                    if let Some(worker) = scope.try_spawn(
                        |token| {
                            loop {
                                match receive(token, jobs.receiver()) {
                                    task::WaitResult::Completed(Some(job)) => {
                                        if token.is_cancelled() {
                                            break;
                                        }
                                        match mapper(token, job.value) {
                                            Ok(value) => if !send(
                                                token,
                                                results,
                                                Completed { index: job.index, value },
                                            ) {
                                                break;
                                            },
                                            Err(cause) => {
                                                control.failed(
                                                    scope,
                                                    errors,
                                                    Error::stage(
                                                        cause,
                                                        "parallel map",
                                                        Option::Some(job.index),
                                                    ),
                                                );
                                                break;
                                            },
                                        }
                                    },
                                    task::WaitResult::Completed(None) | task::WaitResult::Cancelled => break,
                                }
                            }
                        },
                    ) {
                        workers.push(worker);
                    }
                }
                let _ = scope.try_spawn(
                    |token| {
                        defer jobs.close();
                        let index = Ref::new(0);
                        let result = (self.produce)(
                            token,
                            control,
                            |value| {
                                if index.get() == 9223372036854775807 {
                                    control.failed(
                                        scope,
                                        errors,
                                        Error::new(
                                            ErrorKind::Limit,
                                            "parallel input index overflow",
                                        ),
                                    );
                                    return false
                                }
                                match receive(token, credits.receiver()) {
                                    task::WaitResult::Completed(Some(())) => (),
                                    _ => return false,
                                }
                                let accepted = send(token, jobs, Job { index: index.get(), value });
                                index.set(index.get() + 1);
                                accepted
                            },
                        );
                        if let Err(problem) = result {
                            control.failed(scope, errors, problem);
                        }
                    },
                );
                let _ = scope.try_spawn(
                    |_| {
                        for worker in workers {
                            worker.join();
                        }
                        results.close();
                    },
                );
                let pending: HashMap[isize, Option[U]] = HashMap::new();
                let mut next = 0;
                let mut stopped = false;
                while !stopped {
                    match receive(cancel, results.receiver()) {
                        task::WaitResult::Completed(Some(completed)) => {
                            if options.order == Order::Completion {
                                if let Some(value) = completed.value {
                                    if !emit(value) {
                                        break;
                                    }
                                }
                                credits.send(());
                            } else {
                                pending.insert(completed.index, completed.value);
                                while let Some(value) = pending.remove_value(next) {
                                    if let Some(value) = value {
                                        if !emit(value) {
                                            stopped = true;
                                            break;
                                        }
                                    }
                                    next += 1;
                                    credits.send(());
                                }
                            }
                        },
                        task::WaitResult::Completed(None) | task::WaitResult::Cancelled => break,
                    }
                }
            },
        );
        outcome(parent, errors)
    }

    pub fn parallel_filter_map[U](
        self: Stream[T, E],
        options: ParallelOptions,
        mapper: (task::CancelToken, T) -> Result[Option[U], E],
    ) -> Result[Stream[U, E], Error[E]] {
        if let Err(message) = options.validate() {
            return Result::Err(Error::new(ErrorKind::InvalidConfig, message))
        }
        Result::Ok(
            Stream {
                produce: |cancel, control, emit| self.parallel_run(
                    cancel,
                    control,
                    emit,
                    options,
                    mapper,
                ),
            },
        )
    }

    pub fn parallel_map[U](
        self: Stream[T, E],
        options: ParallelOptions,
        mapper: (task::CancelToken, T) -> Result[U, E],
    ) -> Result[Stream[U, E], Error[E]] {
        self.parallel_filter_map(
            options,
            |cancel, value| Result::Ok(Option::Some(mapper(cancel, value)?)),
        )
    }

    pub fn parallel_filter(
        self: Stream[T, E],
        options: ParallelOptions,
        predicate: (task::CancelToken, T) -> Result[bool, E],
    ) -> Result[Stream[T, E], Error[E]] {
        self.parallel_filter_map(
            options,
            |cancel, value| Result::Ok(
                if predicate(cancel, value)? {
                    Option::Some(value)
                } else {
                    Option::None
                },
            ),
        )
    }

    pub fn buffer(self: Stream[T, E], capacity: isize) -> Result[Stream[T, E], Error[E]] {
        self.parallel_map(
            ParallelOptions::new(1, capacity, Order::Input),
            |_, value| Result::Ok(value),
        )
    }
}
