package pipeline;

use std::task;

impl[T, E] Stream[T, E] {
    pub fn try_filter_map[U](
        self: Stream[T, E],
        mapper: (task::CancelToken, T) -> Result[Option[U], E],
    ) -> Stream[U, E] {
        Stream {
            produce: |cancel, control, emit| {
                let failure: Ref[Option[Error[E]]] = Ref::new(Option::None);
                let index = Ref::new(0);
                let result = (self.produce)(
                    cancel,
                    control,
                    |value| {
                        if cancel.is_cancelled() {
                            return false
                        }
                        let current = index.get();
                        if current == 9223372036854775807 {
                            failure.set(
                                Option::Some(Error::new(ErrorKind::Limit, "stage index overflow")),
                            );
                            return false
                        }
                        index.set(current + 1);
                        match mapper(cancel, value) {
                            Ok(Some(value)) => emit(value),
                            Ok(None) => true,
                            Err(cause) => {
                                let problem = Error::stage(cause, "map", Option::Some(current));
                                control.record(problem);
                                failure.set(Option::Some(problem));
                                false
                            },
                        }
                    },
                );
                match failure.get() {
                    Some(problem) => Result::Err(problem),
                    None => result,
                }
            },
        }
    }

    pub fn try_map[U](self: Stream[T, E], mapper: (task::CancelToken, T) -> Result[U, E]) -> Stream[
        U,
        E,
    ] {
        self.try_filter_map(|cancel, value| Result::Ok(Option::Some(mapper(cancel, value)?)))
    }

    pub fn map[U](self: Stream[T, E], mapper: (T) -> U) -> Stream[U, E] {
        self.try_map(|_, value| Result::Ok(mapper(value)))
    }

    pub fn filter_map[U](self: Stream[T, E], mapper: (T) -> Option[U]) -> Stream[U, E] {
        self.try_filter_map(|_, value| Result::Ok(mapper(value)))
    }

    pub fn filter(self: Stream[T, E], predicate: (T) -> bool) -> Stream[T, E] {
        self.filter_map(
            |value| if predicate(value) {
                Option::Some(value)
            } else {
                Option::None
            },
        )
    }

    pub fn inspect(self: Stream[T, E], callback: (task::CancelToken, T) -> Result[(), E]) -> Stream[
        T,
        E,
    ] {
        self.try_map(
            |cancel, value| {
                callback(cancel, value)?;
                Result::Ok(value)
            },
        )
    }

    pub fn named(self: Stream[T, E], name: string) -> Stream[T, E] {
        Stream {
            produce: |cancel, control, emit| (self.produce)(cancel, control.with_name(name), emit).map_err(
                |problem| Error {
                    stage: if problem.stage == "" {
                        name
                    } else {
                        name + "/" + problem.stage
                    },
                    ..problem,
                },
            ),
        }
    }

    pub fn enumerate(self: Stream[T, E]) -> Stream[(isize, T), E] {
        Stream {
            produce: |cancel, control, emit| {
                let index = Ref::new(0);
                let overflow = Ref::new(false);
                let result = (self.produce)(
                    cancel,
                    control,
                    |value| {
                        let current = index.get();
                        if current == 9223372036854775807 {
                            overflow.set(true);
                            return false
                        }
                        index.set(current + 1);
                        emit((current, value))
                    },
                );
                if overflow.get() {
                    Result::Err(Error::new(ErrorKind::Limit, "enumeration overflow"))
                } else {
                    result
                }
            },
        }
    }

    pub fn take(self: Stream[T, E], count: isize) -> Result[Stream[T, E], Error[E]] {
        if count < 0 {
            return Result::Err(
                Error::new(ErrorKind::InvalidConfig, "take count must be nonnegative"),
            )
        }
        Result::Ok(
            Stream {
                produce: |cancel, control, emit| {
                    if count == 0 {
                        return Result::Ok(())
                    }
                    let remaining = Ref::new(count);
                    (self.produce)(
                        cancel,
                        control,
                        |value| {
                            if remaining.get() == 0 {
                                return false
                            }
                            remaining.set(remaining.get() - 1);
                            emit(value) && remaining.get() > 0
                        },
                    )
                },
            },
        )
    }

    pub fn skip(self: Stream[T, E], count: isize) -> Result[Stream[T, E], Error[E]] {
        if count < 0 {
            return Result::Err(
                Error::new(ErrorKind::InvalidConfig, "skip count must be nonnegative"),
            )
        }
        Result::Ok(
            Stream {
                produce: |cancel, control, emit| {
                    let remaining = Ref::new(count);
                    (self.produce)(
                        cancel,
                        control,
                        |value| {
                            if remaining.get() > 0 {
                                remaining.set(remaining.get() - 1);
                                true
                            } else {
                                emit(value)
                            }
                        },
                    )
                },
            },
        )
    }

    pub fn take_while(self: Stream[T, E], predicate: (T) -> bool) -> Stream[T, E] {
        Stream {
            produce: |cancel, control, emit| (self.produce)(
                cancel,
                control,
                |value| predicate(value) && emit(value),
            ),
        }
    }

    pub fn skip_while(self: Stream[T, E], predicate: (T) -> bool) -> Stream[T, E] {
        Stream {
            produce: |cancel, control, emit| {
                let skipping = Ref::new(true);
                (self.produce)(
                    cancel,
                    control,
                    |value| {
                        if skipping.get() && predicate(value) {
                            return true
                        }
                        skipping.set(false);
                        emit(value)
                    },
                )
            },
        }
    }

    pub fn concat(self: Stream[T, E], other: Stream[T, E]) -> Stream[T, E] {
        Stream {
            produce: |cancel, control, emit| {
                let stopped = Ref::new(false);
                (self.produce)(
                    cancel,
                    control,
                    |value| {
                        let accepted = emit(value);
                        stopped.set(!accepted);
                        accepted
                    },
                )?;
                if stopped.get() {
                    Result::Ok(())
                } else {
                    (other.produce)(cancel, control, emit)
                }
            },
        }
    }

    pub fn flat_map[U](self: Stream[T, E], mapper: (T) -> Stream[U, E]) -> Stream[U, E] {
        Stream {
            produce: |cancel, control, emit| {
                let failure: Ref[Option[Error[E]]] = Ref::new(Option::None);
                let stopped = Ref::new(false);
                let result = (self.produce)(
                    cancel,
                    control,
                    |value| {
                        if cancel.is_cancelled() {
                            return false
                        }
                        let inner = mapper(value);
                        let result = (inner.produce)(
                            cancel,
                            control,
                            |item| {
                                let accepted = emit(item);
                                stopped.set(!accepted);
                                accepted
                            },
                        );
                        if let Err(problem) = result {
                            failure.set(Option::Some(problem));
                            return false
                        }
                        !stopped.get()
                    },
                );
                match failure.get() {
                    Some(problem) => Result::Err(problem),
                    None => result,
                }
            },
        }
    }

    pub fn scan[S, U](
        self: Stream[T, E],
        seed: () -> S,
        update: (task::CancelToken, S, T) -> Result[(S, Option[U]), E],
    ) -> Stream[U, E] {
        Stream {
            produce: |cancel, control, emit| {
                let state = Ref::new(seed());
                let scanned = self.try_filter_map(
                    |token, value| {
                        let next = update(token, state.get(), value)?;
                        state.set(next.0);
                        Result::Ok(next.1)
                    },
                );
                (scanned.produce)(cancel, control, emit)
            },
        }
    }

    pub fn chunks(self: Stream[T, E], size: isize) -> Result[Stream[Vec[T], E], Error[E]] {
        if size < 1 || size > 1048576 {
            return Result::Err(
                Error::new(ErrorKind::InvalidConfig, "chunk size must be between 1 and 1048576"),
            )
        }
        Result::Ok(
            Stream {
                produce: |cancel, control, emit| {
                    let batch: Ref[Vec[T]] = Ref::new(Vec::new());
                    let stopped = Ref::new(false);
                    (self.produce)(
                        cancel,
                        control,
                        |value| {
                            let current = batch.get();
                            current.push(value);
                            if current.len() < size {
                                return true
                            }
                            batch.set(Vec::new());
                            let accepted = emit(current);
                            stopped.set(!accepted);
                            accepted
                        },
                    )?;
                    if !stopped.get() && !cancel.is_cancelled() && !batch.get().is_empty() {
                        let _ = emit(batch.get());
                    }
                    Result::Ok(())
                },
            },
        )
    }

    pub fn windows(self: Stream[T, E], size: isize, step: isize) -> Result[
        Stream[Vec[T], E],
        Error[E],
    ] {
        if size < 1 || size > 1048576 || step < 1 {
            return Result::Err(
                Error::new(
                    ErrorKind::InvalidConfig,
                    "window size must be 1..1048576 and step positive",
                ),
            )
        }
        Result::Ok(
            Stream {
                produce: |cancel, control, emit| {
                    let window: Ref[Vec[T]] = Ref::new(Vec::new());
                    let gap = Ref::new(0);
                    (self.produce)(
                        cancel,
                        control,
                        |value| {
                            if gap.get() > 0 {
                                gap.set(gap.get() - 1);
                                return true
                            }
                            let values = window.get();
                            values.push(value);
                            if values.len() < size {
                                return true
                            }
                            let accepted = emit(values.copy());
                            if step < size {
                                window.set(values.slice(step, size).to_vec());
                            } else {
                                window.set(Vec::new());
                                gap.set(step - size);
                            }
                            accepted
                        },
                    )
                },
            },
        )
    }
}
