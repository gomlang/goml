package pipeline;

use std::task;

pub fn merge[T, E](streams: Vec[Stream[T, E]], capacity: isize) -> Result[Stream[T, E], Error[E]] {
    if capacity < 0 || capacity > 1048576 || streams.len() > 1024 {
        return Result::Err(
            Error::new(
                ErrorKind::InvalidConfig,
                "merge requires at most 1024 sources and capacity 0..1048576",
            ),
        )
    }
    let streams = streams.copy();
    Result::Ok(
        Stream {
            produce: |parent, control, emit| {
                let errors: Channel[Error[E]] = Channel::new(1);
                task::scope_with(
                    parent,
                    |scope| {
                        defer scope.cancel();
                        let cancel = scope.token();
                        let output: Channel[T] = Channel::new(capacity);
                        let workers: Vec[task::Task[()]] = Vec::new();
                        for stream in streams {
                            if let Some(worker) = scope.try_spawn(
                                |token| {
                                    let result = (stream.produce)(
                                        token,
                                        control,
                                        |value| send(token, output, value),
                                    );
                                    if let Err(problem) = result {
                                        control.failed(scope, errors, problem);
                                    }
                                },
                            ) {
                                workers.push(worker);
                            }
                        }
                        let _ = scope.try_spawn(
                            |_| {
                                for worker in workers {
                                    worker.join();
                                }
                                output.close();
                            },
                        );
                        loop {
                            match receive(cancel, output.receiver()) {
                                task::WaitResult::Completed(Some(value)) => if !emit(value) {
                                    break;
                                },
                                task::WaitResult::Completed(None) | task::WaitResult::Cancelled => break,
                            }
                        }
                    },
                );
                outcome(parent, errors)
            },
        },
    )
}

impl[T, E] Stream[T, E] {
    pub fn zip[U](self: Stream[T, E], other: Stream[U, E], capacity: isize) -> Result[
        Stream[(T, U), E],
        Error[E],
    ] {
        if capacity < 0 || capacity > 1048576 {
            return Result::Err(
                Error::new(ErrorKind::InvalidConfig, "zip capacity must be 0..1048576"),
            )
        }
        Result::Ok(
            Stream {
                produce: |parent, control, emit| {
                    let errors: Channel[Error[E]] = Channel::new(1);
                    task::scope_with(
                        parent,
                        |scope| {
                            defer scope.cancel();
                            let cancel = scope.token();
                            let left: Channel[T] = Channel::new(capacity);
                            let right: Channel[U] = Channel::new(capacity);
                            let _ = scope.try_spawn(
                                |token| {
                                    defer left.close();
                                    let result = (self.produce)(
                                        token,
                                        control,
                                        |value| send(token, left, value),
                                    );
                                    if let Err(problem) = result {
                                        control.failed(scope, errors, problem);
                                    }
                                },
                            );
                            let _ = scope.try_spawn(
                                |token| {
                                    defer right.close();
                                    let result = (other.produce)(
                                        token,
                                        control,
                                        |value| send(token, right, value),
                                    );
                                    if let Err(problem) = result {
                                        control.failed(scope, errors, problem);
                                    }
                                },
                            );
                            let mut first: Option[T] = Option::None;
                            let mut second: Option[U] = Option::None;
                            let mut done = false;
                            while !done && !cancel.is_cancelled() {
                                if let Some(a) = first {
                                    if let Some(b) = second {
                                        if !emit((a, b)) {
                                            break;
                                        }
                                        first = Option::None;
                                        second = Option::None;
                                    } else {
                                        match receive(cancel, right.receiver()) {
                                            task::WaitResult::Completed(Some(value)) => {
                                                second = Option::Some(value);
                                            },
                                            _ => {
                                                done = true;
                                            },
                                        }
                                    }
                                } else if second.is_some() {
                                    match receive(cancel, left.receiver()) {
                                        task::WaitResult::Completed(Some(value)) => {
                                            first = Option::Some(value);
                                        },
                                        _ => {
                                            done = true;
                                        },
                                    }
                                } else {
                                    select {
                                        recv(cancel.done()) as _ => {
                                            done = true;
                                        },
                                        recv(left) as value => match value {
                                            Some(value) => {
                                                first = Option::Some(value);
                                            },
                                            None => {
                                                done = true;
                                            },
                                        },
                                        recv(right) as value => match value {
                                            Some(value) => {
                                                second = Option::Some(value);
                                            },
                                            None => {
                                                done = true;
                                            },
                                        },
                                    }
                                }
                            }
                        },
                    );
                    outcome(parent, errors)
                },
            },
        )
    }
}
