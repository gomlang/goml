package pipeline;

use std::task;

pub fn from_values[T, E](values: Vec[T]) -> Stream[T, E] {
    let values = values.copy();
    Stream {
        produce: |cancel, control, emit| {
            for value in values {
                if cancel.is_cancelled() {
                    return Result::Err(Error::cancelled())
                }
                if !emit(value) {
                    break;
                }
            }
            Result::Ok(())
        },
    }
}

pub fn from_producer[T, E](producer: (task::CancelToken, (T) -> bool) -> Result[(), E]) -> Stream[
    T,
    E,
] {
    Stream {
        produce: |cancel, control, emit| {
            if cancel.is_cancelled() {
                return Result::Err(Error::cancelled())
            }
            let stopped = Ref::new(false);
            producer(
                cancel,
                |value| {
                    if stopped.get() || cancel.is_cancelled() {
                        return false
                    }
                    let accepted = emit(value);
                    stopped.set(!accepted);
                    accepted
                },
            ).map_err(|cause| Error::stage(cause, "source", Option::None))
        },
    }
}

pub fn generate[T, E](factory: () -> (task::CancelToken) -> Result[Option[T], E]) -> Stream[T, E] {
    Stream {
        produce: |cancel, control, emit| {
            if cancel.is_cancelled() {
                return Result::Err(Error::cancelled())
            }
            let next = factory();
            let mut index = 0;
            loop {
                if cancel.is_cancelled() {
                    return Result::Err(Error::cancelled())
                }
                let value = next(cancel).map_err(
                    |cause| Error::stage(cause, "source", Option::Some(index)),
                )?;
                if let Some(value) = value {
                    if !emit(value) {
                        return Result::Ok(())
                    }
                    if index == 9223372036854775807 {
                        return Result::Err(Error::new(ErrorKind::Limit, "source index overflow"))
                    }
                    index += 1;
                } else {
                    return Result::Ok(())
                }
            }
        },
    }
}

pub fn from_receiver[T, E](input: Receiver[T]) -> Stream[T, E] {
    Stream {
        produce: |cancel, control, emit| {
            loop {
                match receive(cancel, input) {
                    task::WaitResult::Completed(Some(value)) => if !emit(value) {
                        return Result::Ok(())
                    },
                    task::WaitResult::Completed(None) => return Result::Ok(()),
                    task::WaitResult::Cancelled => return Result::Err(Error::cancelled()),
                }
            }
        },
    }
}

pub fn range[E](start: isize, end: isize, step: isize) -> Result[Stream[isize, E], Error[E]] {
    if step == 0 {
        return Result::Err(Error::new(ErrorKind::InvalidConfig, "range step cannot be zero"))
    }
    Result::Ok(
        Stream {
            produce: |cancel, control, emit| {
                let mut value = start;
                while if step > 0 {
                    value < end
                } else {
                    value > end
                } {
                    if cancel.is_cancelled() {
                        return Result::Err(Error::cancelled())
                    }
                    if !emit(value) {
                        break;
                    }
                    if step > 0 && value > 9223372036854775807 - step
                        || step < 0 && value < -9223372036854775808 - step {
                        break;
                    }
                    value += step;
                }
                Result::Ok(())
            },
        },
    )
}

pub fn repeat[T, E](value: T) -> Stream[T, E] {
    Stream {
        produce: |cancel, control, emit| {
            loop {
                if cancel.is_cancelled() {
                    return Result::Err(Error::cancelled())
                }
                if !emit(value) {
                    return Result::Ok(())
                }
            }
        },
    }
}
