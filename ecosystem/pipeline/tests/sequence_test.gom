package tests;

use ecosystem::pipeline;
use ecosystem::pipeline::{Stream, RunOptions, Error, ErrorKind, Control, ParallelOptions, Order};
use std::task;
use std::time;
use std::testing;

fn values(items: Vec[isize]) -> Stream[isize, string] {
    pipeline::from_values(items)
}

fn numbers(end: isize) -> Stream[isize, string] {
    testing::expect_ok(pipeline::range(0, end, 1), "range")
}

fn collect[T](stream: Stream[T, string]) -> Vec[T] {
    testing::expect_ok(
        stream.collect(RunOptions::standard().with_timeout(time::Duration::from_seconds(3))),
        "collect",
    )
}

#[test]
fn sequential_composition_is_lazy_reusable_and_snapshots_values() -> () {
    let calls = Ref::new(0);
    let input = Vec::from_array([1, 2, 3, 4, 5, 6]);
    let stream = values(input).map(
        |value| {
            calls.set(calls.get() + 1);
            value * 3
        },
    ).filter(|value| value % 2 == 0).enumerate();
    input[0] = 99;
    testing::assert_eq(calls.get(), 0);
    let expected = Vec::from_array([(0, 6), (1, 12), (2, 18)]);
    testing::assert(collect(stream) == expected);
    testing::assert_eq(calls.get(), 6);
    testing::assert(collect(stream) == expected);
    testing::assert_eq(calls.get(), 12);
    let stream = numbers(20).skip_while(|value| value < 3).take_while(|value| value < 9);
    testing::assert(
        collect(testing::expect_ok(testing::expect_ok(stream.skip(1), "skip").take(3), "take"))
            == Vec::from_array([4, 5, 6]),
    );
}

#[test]
fn generators_reset_and_flat_map_concat_obey_early_stop() -> () {
    let factories = Ref::new(0);
    let pulls = Ref::new(0);
    let stream: Stream[isize, string] = pipeline::generate(
        || {
            factories.set(factories.get() + 1);
            let next = Ref::new(0);
            |_| {
                let value = next.get();
                next.set(value + 1);
                pulls.set(pulls.get() + 1);
                Result::Ok(Option::Some(value))
            }
        },
    );
    testing::assert(
        collect(testing::expect_ok(stream.take(3), "take")) == Vec::from_array([0, 1, 2]),
    );
    testing::assert_eq(pulls.get(), 3);
    testing::assert(collect(testing::expect_ok(stream.take(2), "take")) == Vec::from_array([0, 1]));
    testing::assert_eq(factories.get(), 2);
    let zero = testing::expect_ok(stream.take(0), "zero");
    testing::assert(collect(zero).is_empty());
    testing::assert_eq(factories.get(), 2);
    let entered = Ref::new(0);
    let inner = numbers(10).flat_map(|value| values(Vec::from_array([value, -value])));
    let after = numbers(4).inspect(
        |_, _| {
            entered.set(entered.get() + 1);
            Result::Ok(())
        },
    );
    testing::assert(
        collect(testing::expect_ok(inner.concat(after).take(5), "take"))
            == Vec::from_array([0, 0, 1, -1, 2]),
    );
    testing::assert_eq(entered.get(), 0);
}

#[test]
fn scan_chunks_windows_and_fold_keep_state_per_run() -> () {
    let sums = numbers(5).scan(
        || 0,
        |_, sum, value| Result::Ok((sum + value, Option::Some(sum + value))),
    );
    testing::assert(collect(sums) == Vec::from_array([0, 1, 3, 6, 10]));
    testing::assert(collect(sums) == Vec::from_array([0, 1, 3, 6, 10]));
    let chunks = collect(testing::expect_ok(numbers(7).chunks(3), "chunks"));
    testing::assert(
        chunks
            == Vec::from_array(
                [Vec::from_array([0, 1, 2]), Vec::from_array([3, 4, 5]), Vec::from_array([6])],
            ),
    );
    let windows = collect(testing::expect_ok(numbers(7).windows(3, 2), "windows"));
    testing::assert(
        windows
            == Vec::from_array(
                [Vec::from_array([0, 1, 2]), Vec::from_array([2, 3, 4]), Vec::from_array([4, 5, 6])],
            ),
    );
    let gaps = collect(testing::expect_ok(numbers(10).windows(2, 4), "gapped windows"));
    testing::assert(
        gaps
            == Vec::from_array(
                [Vec::from_array([0, 1]), Vec::from_array([4, 5]), Vec::from_array([8, 9])],
            ),
    );
    testing::assert_eq(
        testing::expect_ok(
            numbers(10).fold(0, RunOptions::standard(), |_, sum, value| Result::Ok(sum + value)),
            "fold",
        ),
        45,
    );
    testing::assert_eq(testing::expect_ok(numbers(10).count(RunOptions::standard()), "count"), 10);
    testing::assert(
        testing::expect_ok(numbers(10).first(RunOptions::standard()), "first") == Option::Some(0),
    );
    testing::assert(
        testing::expect_ok(numbers(0).first(RunOptions::standard()), "empty first").is_none(),
    );
    testing::assert(
        testing::expect_ok(numbers(10).any(RunOptions::standard(), |value| value == 7), "any"),
    );
    testing::assert(
        testing::expect_ok(numbers(10).all(RunOptions::standard(), |value| value < 10), "all"),
    );
}

#[test]
fn source_stage_and_sink_errors_preserve_typed_causes_and_indices() -> () {
    let stream = numbers(10).try_map(
        |_, value| if value == 3 {
            Result::Err("broken")
        } else {
            Result::Ok(value)
        },
    ).named("parse rows");
    let problem = testing::expect_err(stream.collect(RunOptions::standard()), "mapper failure");
    testing::assert_eq(problem.kind, ErrorKind::Stage);
    testing::assert_eq(problem.stage, "parse rows/map");
    testing::assert(problem.index == Option::Some(3));
    testing::assert(problem.cause == Option::Some("broken"));
    let stream: Stream[isize, string] = pipeline::generate(|| |_| Result::Err("source failed"));
    let problem = testing::expect_err(stream.collect(RunOptions::standard()), "source failure");
    testing::assert_eq(problem.stage, "source");
    testing::assert(problem.index == Option::Some(0));
    let problem = testing::expect_err(
        numbers(10).for_each(
            RunOptions::standard(),
            |_, value| if value == 2 {
                Result::Err("sink failed")
            } else {
                Result::Ok(Control::Continue)
            },
        ),
        "sink failure",
    );
    testing::assert_eq(problem.stage, "sink");
    testing::assert(problem.index == Option::Some(2));
    let visited = Ref::new(0);
    let report = testing::expect_ok(
        numbers(10).for_each(
            RunOptions::standard(),
            |_, _| {
                visited.set(visited.get() + 1);
                Result::Ok(Control::Stop)
            },
        ),
        "sink stop",
    );
    testing::assert(report.stopped && report.emitted == 1 && visited.get() == 1);
}

#[test]
fn ranges_handle_signed_boundaries_and_invalid_options() -> () {
    let descending: Stream[isize, string] = testing::expect_ok(
        pipeline::range(5, -3, -2),
        "descending",
    );
    testing::assert(collect(descending) == Vec::from_array([5, 3, 1, -1]));
    let high: Stream[isize, string] = testing::expect_ok(
        pipeline::range(9223372036854775805, 9223372036854775807, 10),
        "high",
    );
    testing::assert(collect(high) == Vec::from_array([9223372036854775805]));
    let low: Stream[isize, string] = testing::expect_ok(
        pipeline::range(-9223372036854775806, -9223372036854775808, -10),
        "low",
    );
    testing::assert(collect(low) == Vec::from_array([-9223372036854775806]));
    let invalid: Result[Stream[isize, string], Error[string]] = pipeline::range(0, 3, 0);
    testing::assert_eq(testing::expect_err(invalid, "zero step").kind, ErrorKind::InvalidConfig);
    testing::assert_err(numbers(3).take(-1));
    testing::assert_err(numbers(3).skip(-1));
    testing::assert_err(numbers(3).chunks(0));
    testing::assert_err(numbers(3).windows(3, 0));
    for options in Vec::from_array(
        [
            ParallelOptions::new(0, 1, Order::Input),
            ParallelOptions::new(2, -1, Order::Input),
            ParallelOptions { max_in_flight: 0, ..ParallelOptions::new(2, 1, Order::Input) },
        ],
    ) {
        testing::assert_err(numbers(3).parallel_map(options, |_, value| Result::Ok(value)));
    }
    let problem = testing::expect_err(
        numbers(3).collect(RunOptions { max_items: Option::Some(2), ..RunOptions::standard() }),
        "terminal bound",
    );
    testing::assert_eq(problem.kind, ErrorKind::Limit);
    testing::assert_eq(collect(numbers(0)).len(), 0);
}

#[test]
fn precancel_and_zero_timeout_do_not_enter_sources() -> () {
    let entered = Ref::new(false);
    let source: Stream[isize, string] = pipeline::from_producer(
        |_, emit| {
            entered.set(true);
            let _ = emit(1);
            Result::Ok(())
        },
    );
    task::scope(
        |scope| {
            scope.cancel();
            let problem = testing::expect_err(
                source.collect(RunOptions::standard().with_cancel(scope.token())),
                "precancel",
            );
            testing::assert_eq(problem.kind, ErrorKind::Cancelled);
        },
    );
    testing::assert(!entered.get());
    let problem = testing::expect_err(
        source.collect(RunOptions::standard().with_timeout(time::Duration::zero())),
        "timeout",
    );
    testing::assert_eq(problem.kind, ErrorKind::Timeout);
    testing::assert(!entered.get());
}
