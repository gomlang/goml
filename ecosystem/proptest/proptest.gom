package proptest;

use std::rand;

pub trait Strategy {
    type Item;
    fn generate(self: Self, seed: u64, size: isize) -> Result[Sample[Self::Item], string];
}

pub struct Generator[T] {
    draw: (u64, isize) -> Result[Sample[T], string],
}

impl[T] Strategy for Generator[T] {
    type Item = T;

    fn generate(self: Generator[T], seed: u64, size: isize) -> Result[Sample[T], string] {
        (self.draw)(seed, size)
    }
}

fn map_sample[T, U](sample: Sample[T], transform: (T) -> U) -> Sample[U] {
    Sample::lazy(
        transform(sample.value),
        || {
            let children = sample.candidates();
            Candidates::from_fn(
                |budget| children.next(budget).map(|child| map_sample(child, transform)),
            )
        },
    )
}

fn filter_sample[T](sample: Sample[T], accept: (T) -> bool) -> Sample[T] {
    Sample::lazy(
        sample.value,
        || {
            let pending: Vec[Candidates[T]] = Vec::from_array([sample.candidates()]);
            let head = Ref::new(0);
            let visited = Ref::new(0);
            Candidates::from_fn(
                |budget| {
                    while head.get() < pending.len() && visited.get() < 1024 && !budget.exhausted() {
                        match pending[head.get()].next(budget) {
                            Some(child) => {
                                visited.set(visited.get() + 1);
                                if accept(child.value) {
                                    return Option::Some(filter_sample(child, accept))
                                }
                                pending.push(child.candidates());
                            },
                            None => head.set(head.get() + 1),
                        }
                    }
                    if visited.get() >= 1024 && head.get() < pending.len() {
                        budget.limited.set(true);
                    }
                    Option::None
                },
            )
        },
    )
}

impl[T] Generator[T] {
    pub fn new(draw: (u64, isize) -> Result[Sample[T], string]) -> Generator[T] {
        Generator { draw }
    }

    pub fn map[U](self: Generator[T], transform: (T) -> U) -> Generator[U] {
        Generator::new(
            |seed: u64, size: isize| Result::Ok(map_sample(self.generate(seed, size)?, transform)),
        )
    }

    pub fn filter(self: Generator[T], accept: (T) -> bool, attempts: isize) -> Generator[T] {
        Generator::new(
            |seed: u64, size: isize| {
                let mut state = seed;
                for _ in 0..attempts {
                    let sample = self.generate(state, size)?;
                    if accept(sample.value) {
                        return Result::Ok(filter_sample(sample, accept))
                    }
                    state = rand::next_u64(state);
                }
                Result::Err("generator exhausted its rejection budget")
            },
        )
    }

    pub fn zip[U](self: Generator[T], other: Generator[U]) -> Generator[(T, U)] {
        Generator::new(
            |seed: u64, size: isize| {
                Result::Ok(
                    pair_sample(
                        self.generate(seed, size)?,
                        other.generate(rand::next_u64(seed), size)?,
                    ),
                )
            },
        )
    }
}

fn pair_sample[T, U](left: Sample[T], right: Sample[U]) -> Sample[(T, U)] {
    Sample::lazy(
        (left.value, right.value),
        || {
            let first = left.candidates();
            let second = right.candidates();
            let left_done = Ref::new(false);
            Candidates::from_fn(
                |budget| {
                    if !left_done.get() {
                        if let Some(child) = first.next(budget) {
                            return Option::Some(pair_sample(child, right))
                        }
                        left_done.set(true);
                    }
                    second.next(budget).map(|child| pair_sample(left, child))
                },
            )
        },
    )
}

fn integer_sample(value: isize, target: isize) -> Sample[isize] {
    Sample::lazy(
        value,
        || {
            let first = Ref::new(value != target);
            let descending = value > target;
            let distance: u64 = if descending {
                value.to_u64() - target.to_u64()
            } else {
                target.to_u64() - value.to_u64()
            };
            let step: Ref[u64] = Ref::new(distance / 2);
            Candidates::from_fn(
                |_| {
                    if first.get() {
                        first.set(false);
                        return Option::Some(integer_sample(target, target))
                    }
                    if step.get() == 0 {
                        return Option::None
                    }
                    let candidate = if descending {
                        (value.to_u64() - step.get()).to_isize()
                    } else {
                        (value.to_u64() + step.get()).to_isize()
                    };
                    step.set(step.get() / 2);
                    Option::Some(integer_sample(candidate, target))
                },
            )
        },
    )
}

pub fn integers(minimum: isize, maximum: isize) -> Result[Generator[isize], string] {
    if minimum >= maximum {
        return Result::Err("integer range must be nonempty")
    }
    let target = if minimum > 0 {
        minimum
    } else if maximum <= 0 {
        maximum - 1
    } else {
        0
    };
    Result::Ok(
        Generator::new(
            |seed, _| {
                let width = maximum.to_u64() - minimum.to_u64();
                let value = (minimum.to_u64() + rand::next_u64(seed) % width).to_isize();
                Result::Ok(integer_sample(value, target))
            },
        ),
    )
}

pub fn just[T](value: T) -> Generator[T] {
    Generator::new(|_, _| Result::Ok(Sample::leaf(value)))
}

fn vector_sample[T](samples: Vec[Sample[T]], minimum: isize) -> Sample[Vec[T]] {
    let values: Vec[T] = Vec::with_capacity(samples.len());
    for sample in samples {
        values.push(sample.value);
    }
    Sample::lazy(
        values,
        || {
            let first = Ref::new(samples.len() > minimum);
            let chunk = Ref::new(samples.len() / 2);
            let offset = Ref::new(0);
            let element = Ref::new(0);
            let children: Ref[Option[Candidates[T]]] = Ref::new(Option::None);
            Candidates::from_fn(
                |budget| {
                    if first.get() {
                        first.set(false);
                        if !budget.consume(minimum) {
                            return Option::None
                        }
                        return Option::Some(
                            vector_sample(samples.slice(0, minimum).to_vec(), minimum),
                        )
                    }
                    while chunk.get() > 0 && samples.len() > minimum {
                        if !budget.consume(1) {
                            return Option::None
                        }
                        if offset.get() >= samples.len() {
                            chunk.set(chunk.get() / 2);
                            offset.set(0);
                            continue
                        }
                        let start = offset.get();
                        let length = if chunk.get() < samples.len() - start {
                            chunk.get()
                        } else {
                            samples.len() - start
                        };
                        offset.set(start + length);
                        if samples.len() - length < minimum {
                            continue
                        }
                        if !budget.consume(samples.len() - length) {
                            return Option::None
                        }
                        let shorter = Vec::with_capacity(samples.len() - length);
                        for index in 0..start {
                            shorter.push(samples[index]);
                        }
                        for index in start + length..samples.len() {
                            shorter.push(samples[index]);
                        }
                        return Option::Some(vector_sample(shorter, minimum))
                    }
                    while element.get() < samples.len() && !budget.exhausted() {
                        let current: Candidates[T] = match children.get() {
                            Some(current) => current,
                            None => {
                                let current = samples[element.get()].candidates();
                                children.set(Option::Some(current));
                                current
                            },
                        };
                        if let Some(child) = current.next(budget) {
                            if !budget.consume(samples.len()) {
                                return Option::None
                            }
                            let changed = samples.copy();
                            changed[element.get()] = child;
                            return Option::Some(vector_sample(changed, minimum))
                        }
                        children.set(Option::None);
                        element.set(element.get() + 1);
                    }
                    Option::None
                },
            )
        },
    )
}

pub fn vectors[T](item: Generator[T], minimum: isize, maximum: isize) -> Result[
    Generator[Vec[T]],
    string,
] {
    if minimum < 0 || minimum > maximum || maximum > 1000000 {
        return Result::Err("vector bounds must satisfy 0 <= minimum <= maximum <= 1000000")
    }
    Result::Ok(
        Generator::new(
            |seed: u64, size: isize| {
                let upper: isize = if size < minimum {
                    minimum
                } else if size > maximum {
                    maximum
                } else {
                    size
                };
                let count = minimum
                    + (rand::next_u64(seed) % (upper - minimum + 1).to_u64()).to_isize();
                let samples: Vec[Sample[T]] = Vec::new();
                let mut state = seed;
                for _ in 0..count {
                    state = rand::next_u64(state);
                    samples.push(item.generate(state, size)?);
                }
                Result::Ok(vector_sample(samples, minimum))
            },
        ),
    )
}

pub struct Config {
    pub seed: u64,
    pub cases: isize,
    pub size: isize,
    pub max_shrinks: isize,
}

pub struct Failure[T] {
    pub seed: u64,
    pub case_index: isize,
    pub initial: T,
    pub minimal: T,
    pub attempts: isize,
}

pub fn check[S: Strategy](strategy: S, config: Config, property: (S::Item) -> bool) -> Result[
    Option[Failure[S::Item]],
    string,
] {
    let result = run(
        strategy,
        RunOptions::from_config(config),
        |value| {
            if property(value) {
                Case::pass()
            } else {
                Case::fail("property returned false")
            }
        },
    )?;
    Result::Ok(result.failure)
}
