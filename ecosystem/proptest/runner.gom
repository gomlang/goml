package proptest;

use std::rand;

#[derive(Debug, PartialEq)]
pub enum Verdict {
    Pass,
    Fail(string),
    Discard(string),
}

pub struct Case {
    pub verdict: Verdict,
    pub labels: Vec[string],
}

impl Case {
    pub fn pass() -> Case {
        Case { verdict: Verdict::Pass, labels: Vec::new() }
    }

    pub fn fail(message: string) -> Case {
        Case { verdict: Verdict::Fail(message), labels: Vec::new() }
    }

    pub fn discard(reason: string) -> Case {
        Case { verdict: Verdict::Discard(reason), labels: Vec::new() }
    }

    pub fn label(self: Case, name: string) -> Case {
        Case { labels: self.labels.copy().pushed(name), ..self }
    }

    pub fn classify(self: Case, condition: bool, name: string) -> Case {
        if condition {
            self.label(name)
        } else {
            self
        }
    }
}

pub struct Coverage {
    pub label: string,
    pub minimum_percent: isize,
}

pub struct RunOptions {
    pub config: Config,
    pub max_discards: isize,
    pub max_shrink_work: isize,
    pub regressions: Vec[Replay],
    pub coverage: Vec[Coverage],
}

impl RunOptions {
    pub fn new(seed: u64) -> RunOptions {
        RunOptions::from_config(Config::new(seed))
    }

    pub fn from_config(config: Config) -> RunOptions {
        RunOptions {
            config,
            max_discards: 1000,
            max_shrink_work: 1000000,
            regressions: Vec::new(),
            coverage: Vec::new(),
        }
    }
}

#[derive(Debug, PartialEq)]
pub enum RunStatus {
    Passed,
    Failed,
    Rejected,
}

pub struct RunReport[T] {
    pub status: RunStatus,
    pub cases: isize,
    pub generated: isize,
    pub regressions: isize,
    pub discarded: isize,
    pub labels: Vec[(string, isize)],
    pub discard_reasons: Vec[(string, isize)],
    pub failure: Option[Failure[T]],
    pub replay: Option[Replay],
    pub message: string,
    pub shrink_work: isize,
    pub shrink_limited: bool,
}

fn increment_count(counts: Vec[(string, isize)], name: string) -> () {
    for index in 0..counts.len() {
        if counts[index].0 == name {
            counts[index] = (name, counts[index].1 + 1);
            return
        }
    }
    counts.push((name, 1));
}

fn label_count(counts: Vec[(string, isize)], name: string) -> isize {
    for entry in counts {
        if entry.0 == name {
            return entry.1
        }
    }
    0
}

struct Shrunk[T] {
    failure: Failure[T],
    work: isize,
    limited: bool,
    message: string,
}

fn shrink_failure[T](
    initial: Sample[T],
    seed: u64,
    index: isize,
    message: string,
    options: RunOptions,
    property: (T) -> Case,
) -> Shrunk[T] {
    let budget = shrink_budget(options.max_shrink_work);
    let mut current = initial;
    let mut reason = message;
    let mut attempts = 0;
    let mut complete = false;
    while attempts < options.config.max_shrinks && !budget.exhausted() {
        if !budget.consume(1) {
            break
        }
        let children = current.candidates();
        let mut changed = false;
        while attempts < options.config.max_shrinks {
            let Some(candidate) = children.next(budget) else {
                break
            };
            attempts += 1;
            if let Fail(message) = property(candidate.value).verdict {
                current = candidate;
                reason = message;
                changed = true;
                break
            }
        }
        if !changed {
            complete = !budget.exhausted() && attempts < options.config.max_shrinks;
            break
        }
    }
    Shrunk {
        failure: Failure {
            seed,
            case_index: index,
            initial: initial.value,
            minimal: current.value,
            attempts,
        },
        work: budget.used(),
        limited: !complete,
        message: reason,
    }
}

pub fn run[S: Strategy](strategy: S, options: RunOptions, property: (S::Item) -> Case) -> Result[
    RunReport[S::Item],
    string,
] {
    let config = options.config;
    if config.cases < 0 || config.size < 0 || config.max_shrinks < 0 || options.max_discards < 0
        || options.max_shrink_work < 0 {
        return Result::Err("test budgets must be nonnegative")
    }
    let regressions = options.regressions.copy();
    let coverage = options.coverage.copy();
    for entry in regressions {
        if entry.size < 0 {
            return Result::Err("regression size must be nonnegative")
        }
    }
    for requirement in coverage {
        if requirement.label == "" || requirement.minimum_percent < 0
            || requirement.minimum_percent > 100 {
            return Result::Err(
                "coverage requires a nonempty label and a percentage between 0 and 100",
            )
        }
    }
    let mut report = RunReport {
        status: RunStatus::Passed,
        cases: 0,
        generated: 0,
        regressions: 0,
        discarded: 0,
        labels: Vec::new(),
        discard_reasons: Vec::new(),
        failure: Option::None,
        replay: Option::None,
        message: "",
        shrink_work: 0,
        shrink_limited: false,
    };
    let mut seed = config.seed;
    let mut accepted = 0;
    while report.regressions < regressions.len() || accepted < config.cases {
        let regression = report.regressions < regressions.len();
        let entry = if regression {
            let entry = regressions[report.regressions];
            report.regressions += 1;
            entry
        } else {
            let entry = Replay { seed, size: config.size };
            seed = rand::next_u64(seed);
            report.generated += 1;
            entry
        };
        let sample = strategy.generate(entry.seed, entry.size)?;
        let result = property(sample.value);
        match result.verdict {
            Discard(reason) => {
                report.discarded += 1;
                increment_count(report.discard_reasons, reason);
                if report.discarded > options.max_discards {
                    report.status = RunStatus::Rejected;
                    report.message = "property exhausted its discard budget";
                    return Result::Ok(report)
                }
            },
            _ => {
                report.cases += 1;
                if !regression {
                    accepted += 1;
                }
                let seen: HashMap[string, bool] = HashMap::new();
                for name in result.labels {
                    if seen.get(name).is_none() {
                        seen.set(name, true);
                        increment_count(report.labels, name);
                    }
                }
                if let Fail(message) = result.verdict {
                    let shrunk = shrink_failure(
                        sample,
                        entry.seed,
                        report.generated + report.regressions - 1,
                        message,
                        options,
                        property,
                    );
                    report.status = RunStatus::Failed;
                    report.failure = Option::Some(shrunk.failure);
                    report.replay = Option::Some(entry);
                    report.message = shrunk.message;
                    report.shrink_work = shrunk.work;
                    report.shrink_limited = shrunk.limited;
                    return Result::Ok(report)
                }
            },
        }
    }
    for requirement in coverage {
        let minimum = report.cases / 100 * requirement.minimum_percent
            + (report.cases % 100 * requirement.minimum_percent + 99) / 100;
        if label_count(report.labels, requirement.label) < minimum
            || report.cases == 0 && requirement.minimum_percent > 0 {
            report.status = RunStatus::Rejected;
            report.message = f"coverage requirement not met: {requirement.label} needs {requirement.minimum_percent}%";
            return Result::Ok(report)
        }
    }
    Result::Ok(report)
}
