package proptest;

use std::fs;
use std::num;
use std::text;

#[derive(Debug, PartialEq)]
pub struct Replay {
    pub seed: u64,
    pub size: isize,
}

pub struct RegressionStore {
    path: string,
    property: string,
}

fn valid_property(name: string) -> Result[(), string] {
    if name == "" || name != name.trim() || name.byte_len() > 1024 || name.contains("\n")
        || name.contains("\r")
        || name.contains("\t")
        || name.contains("\u0000") {
        Result::Err(
            "property name must be nonempty, at most 1024 bytes and contain no tab, newline or NUL",
        )
    } else {
        Result::Ok(())
    }
}

pub fn encode_replays(property: string, entries: Vec[Replay]) -> Result[string, string] {
    valid_property(property)?;
    if entries.len() > 10000 {
        return Result::Err("regression corpus exceeds 10000 entries")
    }
    let output = text::StringBuilder::new();
    output.write_line("goml-proptest-v1\t" + property);
    let seen: HashMap[(u64, isize), bool] = HashMap::new();
    for entry in entries {
        if entry.size < 0 {
            return Result::Err("regression size must be nonnegative")
        }
        let key = (entry.seed, entry.size);
        if seen.get(key).is_none() {
            seen.set(key, true);
            output.write_line(f"{entry.seed}\t{entry.size}");
        }
    }
    Result::Ok(output.finish())
}

pub fn decode_replays(property: string, input: string) -> Result[Vec[Replay], string] {
    valid_property(property)?;
    if input.byte_len() > 1048576 {
        return Result::Err("regression corpus exceeds 1 MiB")
    }
    let lines = input.split("\n");
    if lines[0].trim_end() != "goml-proptest-v1\t" + property {
        return Result::Err("regression corpus version or property name does not match")
    }
    let entries = Vec::new();
    let seen: HashMap[(u64, isize), bool] = HashMap::new();
    let mut records = 0;
    for index in 1..lines.len() {
        let line = lines[index].trim_end();
        if line == "" {
            continue
        }
        records += 1;
        if records > 10000 {
            return Result::Err("regression corpus exceeds 10000 entries")
        }
        let fields = line.split("\t");
        if fields.len() != 2 {
            return Result::Err(f"invalid regression entry at line {index + 1}")
        }
        let seed = num::parse_uint_structured(fields[0]).map_err(
            |_| f"invalid regression seed at line {index + 1}",
        )?.to_u64();
        let size = num::parse_int_structured(fields[1]).map_err(
            |_| f"invalid regression size at line {index + 1}",
        )?;
        if size < 0 {
            return Result::Err(f"negative regression size at line {index + 1}")
        }
        let key = (seed, size);
        if seen.get(key).is_none() {
            seen.set(key, true);
            entries.push(Replay { seed, size });
        }
    }
    Result::Ok(entries)
}

impl RegressionStore {
    pub fn new(path: string, property: string) -> Result[RegressionStore, string] {
        valid_property(property)?;
        if path == "" {
            return Result::Err("regression path must be nonempty")
        }
        Result::Ok(RegressionStore { path, property })
    }

    pub fn load(self: RegressionStore) -> Result[Vec[Replay], string] {
        if !fs::try_exists(self.path).map_err(|error| error.to_string())? {
            return Result::Ok(Vec::new())
        }
        let metadata = fs::metadata(self.path).map_err(|error| error.to_string())?;
        if !metadata.file_type().is_file() || metadata.len() > 1048576 {
            return Result::Err("regression corpus must be a regular file of at most 1 MiB")
        }
        let input = fs::read_file_structured(self.path).map_err(|error| error.to_string())?;
        decode_replays(self.property, input)
    }

    pub fn save(self: RegressionStore, entry: Replay) -> Result[(), string] {
        self.save_all(Vec::from_array([entry]))
    }

    pub fn save_all(self: RegressionStore, additions: Vec[Replay]) -> Result[(), string] {
        if additions.len() > 10000 {
            return Result::Err("regression corpus additions exceed 10000 entries")
        }
        let entries = self.load()?;
        let seen: HashMap[(u64, isize), bool] = HashMap::new();
        for previous in entries {
            seen.set((previous.seed, previous.size), true);
        }
        let mut changed = false;
        for entry in additions {
            let key = (entry.seed, entry.size);
            if seen.get(key).is_none() {
                entries.push(entry);
                seen.set(key, true);
                changed = true;
            }
        }
        if !changed {
            return Result::Ok(())
        }
        let encoded = encode_replays(self.property, entries)?;
        fs::atomic_write(self.path, encoded).map_err(|error| error.to_string())
    }
}

pub fn run_campaign_persisted[S: Strategy](
    strategy: S,
    options: CampaignOptions,
    store: RegressionStore,
    property: (S::Item) -> Observation,
) -> Result[CampaignReport[S::Item], string] {
    let regressions = options.run.regressions.copy();
    regressions.extend(store.load()?);
    let report = run_campaign(
        strategy,
        CampaignOptions { run: RunOptions { regressions, ..options.run }, ..options },
        property,
    )?;
    let entries = Vec::new();
    for failure in report.failures {
        entries.push(failure.replay);
    }
    if !entries.is_empty() {
        store.save_all(entries)?;
    }
    Result::Ok(report)
}

pub fn run_persisted[S: Strategy](
    strategy: S,
    options: RunOptions,
    store: RegressionStore,
    property: (S::Item) -> Case,
) -> Result[RunReport[S::Item], string] {
    let regressions = options.regressions.copy();
    regressions.extend(store.load()?);
    let result = run(strategy, RunOptions { regressions, ..options }, property)?;
    if let Some(replay) = result.replay {
        store.save(replay)?;
    }
    Result::Ok(result)
}
