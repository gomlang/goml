package proptest;

#[derive(Debug, PartialEq)]
pub enum MachineStage {
    Limit,
    Setup,
    InitialInvariant,
    Transition,
    Execute,
    Invariant,
    Cleanup,
}

pub struct MachineReport {
    pub case: Case,
    pub completed: isize,
    pub stage: Option[MachineStage],
    pub step: Option[isize],
    pub cleanup_error: Option[string],
}

pub struct StateMachine[M, S, C] {
    max_commands: isize,
    setup: () -> Result[(M, S), string],
    transition: (M, C) -> Result[M, string],
    execute: (S, C) -> Result[(), string],
    invariant: (M, S) -> Result[(), string],
    cleanup: (S) -> Result[(), string],
}

fn machine_result(case: Case, completed: isize, stage: MachineStage, step: Option[isize]) -> MachineReport {
    MachineReport { case, completed, stage: Option::Some(stage), step, cleanup_error: Option::None }
}

impl[M, S, C] StateMachine[M, S, C] {
    pub fn new(
        max_commands: isize,
        setup: () -> Result[(M, S), string],
        transition: (M, C) -> Result[M, string],
        execute: (S, C) -> Result[(), string],
        invariant: (M, S) -> Result[(), string],
        cleanup: (S) -> Result[(), string],
    ) -> Result[StateMachine[M, S, C], string] {
        if max_commands < 0 || max_commands > 1000000 {
            return Result::Err("state-machine command limit must be between 0 and 1000000")
        }
        Result::Ok(StateMachine { max_commands, setup, transition, execute, invariant, cleanup })
    }

    fn execute_sequence(self: StateMachine[M, S, C], initial: M, system: S, commands: Vec[C]) -> MachineReport {
        let mut model = initial;
        if let Err(error) = (self.invariant)(model, system) {
            return machine_result(
                Case::fail("initial invariant: " + error),
                0,
                MachineStage::InitialInvariant,
                Option::None,
            )
        }
        for index in 0..commands.len() {
            let command = commands[index];
            let next = match (self.transition)(model, command) {
                Ok(next) => next,
                Err(error) => return machine_result(
                    Case::discard(f"command {index} precondition: {error}"),
                    index,
                    MachineStage::Transition,
                    Option::Some(index),
                ),
            };
            if let Err(error) = (self.execute)(system, command) {
                return machine_result(
                    Case::fail(f"command {index} execution: {error}"),
                    index,
                    MachineStage::Execute,
                    Option::Some(index),
                )
            }
            model = next;
            if let Err(error) = (self.invariant)(model, system) {
                return machine_result(
                    Case::fail(f"command {index} invariant: {error}"),
                    index + 1,
                    MachineStage::Invariant,
                    Option::Some(index),
                )
            }
        }
        MachineReport {
            case: Case::pass(),
            completed: commands.len(),
            stage: Option::None,
            step: Option::None,
            cleanup_error: Option::None,
        }
    }

    pub fn run(self: StateMachine[M, S, C], commands: Vec[C]) -> MachineReport {
        if commands.len() > self.max_commands {
            return machine_result(
                Case::discard("state-machine command limit exceeded"),
                0,
                MachineStage::Limit,
                Option::None,
            )
        }
        let commands = commands.copy();
        let (model, system) = match (self.setup)() {
            Ok(value) => value,
            Err(error) => return machine_result(
                Case::fail("setup: " + error),
                0,
                MachineStage::Setup,
                Option::None,
            ),
        };
        let result = self.execute_sequence(model, system, commands);
        match (self.cleanup)(system) {
            Ok(()) => result,
            Err(error) => {
                let message = match result.case.verdict {
                    Fail(message) => message + "; cleanup: " + error,
                    Discard(message) => message + "; cleanup: " + error,
                    Pass => "cleanup: " + error,
                };
                MachineReport {
                    case: Case::fail(message),
                    cleanup_error: Option::Some(error),
                    stage: if result.stage.is_some() {
                        result.stage
                    } else {
                        Option::Some(MachineStage::Cleanup)
                    },
                    ..result,
                }
            },
        }
    }

    pub fn check(self: StateMachine[M, S, C], commands: Vec[C]) -> Case {
        self.run(commands).case
    }
}
