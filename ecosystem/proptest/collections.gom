package proptest;

use std::collections;
use std::rand;

fn collection_bounds(minimum: isize, maximum: isize, attempts: isize) -> Result[(), string] {
    if minimum < 0 || maximum < minimum || maximum > 1000000 || attempts < 0 {
        Result::Err(
            "collection bounds require 0 <= minimum <= maximum <= 1000000 and nonnegative attempts",
        )
    } else {
        Result::Ok(())
    }
}

fn collection_length(seed: u64, size: isize, minimum: isize, maximum: isize) -> isize {
    let upper = if size < minimum {
        minimum
    } else if size > maximum {
        maximum
    } else {
        size
    };
    minimum + (rand::next_u64(seed) % (upper - minimum + 1).to_u64()).to_isize()
}

pub fn unique_vectors_by[T, K: Eq + Hash](
    item: Generator[T],
    key: (T) -> K,
    minimum: isize,
    maximum: isize,
    attempts: isize,
) -> Result[Generator[Vec[T]], string] {
    collection_bounds(minimum, maximum, attempts)?;
    Result::Ok(
        Generator::new(
            |seed, size| {
                let count = collection_length(seed, size, minimum, maximum);
                let samples: Vec[Sample[T]] = Vec::with_capacity(count);
                let seen: HashMap[K, bool] = HashMap::new();
                let mut state = seed;
                let mut tries = 0;
                while samples.len() < count {
                    if tries >= attempts {
                        return Result::Err("unique generator exhausted its attempt budget")
                    }
                    tries += 1;
                    state = rand::next_u64(state);
                    let sample = item.generate(state, size)?;
                    let identity = key(sample.value);
                    if seen.get(identity).is_none() {
                        seen.set(identity, true);
                        samples.push(sample);
                    }
                }
                Result::Ok(
                    filter_sample(
                        vector_sample(samples, minimum),
                        |values| {
                            let identities: HashMap[K, bool] = HashMap::new();
                            for value in values {
                                let identity = key(value);
                                if identities.get(identity).is_some() {
                                    return false
                                }
                                identities.set(identity, true);
                            }
                            true
                        },
                    ),
                )
            },
        ),
    )
}

pub fn sets[T: Eq + Hash](item: Generator[T], minimum: isize, maximum: isize, attempts: isize) -> Result[
    Generator[collections::HashSet[T]],
    string,
] {
    Result::Ok(
        unique_vectors_by(item, |value| value, minimum, maximum, attempts)?.map(
            |values| {
                let result: collections::HashSet[T] = collections::HashSet::new();
                for value in values {
                    let _ = result.insert(value);
                }
                result
            },
        ),
    )
}

pub fn maps[K: Eq + Hash, V](
    keys: Generator[K],
    values: Generator[V],
    minimum: isize,
    maximum: isize,
    attempts: isize,
) -> Result[Generator[HashMap[K, V]], string] {
    Result::Ok(
        unique_vectors_by(keys.zip(values), |pair| pair.0, minimum, maximum, attempts)?.map(
            |entries| {
                let result: HashMap[K, V] = HashMap::new();
                for entry in entries {
                    result.set(entry.0, entry.1);
                }
                result
            },
        ),
    )
}

pub fn stateful[M, C](
    initial: () -> M,
    command: (M) -> Generator[C],
    transition: (M, C) -> Result[M, string],
    minimum: isize,
    maximum: isize,
    attempts: isize,
) -> Result[Generator[Vec[C]], string] {
    collection_bounds(minimum, maximum, attempts)?;
    Result::Ok(
        Generator::new(
            |seed, size| {
                let count = collection_length(seed, size, minimum, maximum);
                let samples: Vec[Sample[C]] = Vec::with_capacity(count);
                let mut model = initial();
                let mut state = seed;
                let mut tries = 0;
                while samples.len() < count {
                    if tries >= attempts {
                        return Result::Err("stateful generator exhausted its attempt budget")
                    }
                    tries += 1;
                    state = rand::next_u64(state);
                    let sample = command(model).generate(state, size)?;
                    if let Ok(next) = transition(model, sample.value) {
                        model = next;
                        samples.push(sample);
                    }
                }
                Result::Ok(
                    filter_sample(
                        vector_sample(samples, minimum),
                        |commands| {
                            let mut model = initial();
                            for value in commands {
                                match transition(model, value) {
                                    Ok(next) => {
                                        model = next;
                                    },
                                    Err(_) => return false,
                                }
                            }
                            true
                        },
                    ),
                )
            },
        ),
    )
}
