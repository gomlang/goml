package proptest;

pub struct ShrinkBudget {
    remaining: Ref[isize],
    initial: isize,
    limited: Ref[bool],
}

impl ShrinkBudget {
    pub fn new(work: isize) -> Result[ShrinkBudget, string] {
        if work < 0 {
            return Result::Err("shrink work budget must be nonnegative")
        }
        Result::Ok(shrink_budget(work))
    }

    pub fn consume(self: ShrinkBudget, work: isize) -> bool {
        if self.limited.get() || work < 0 || work > self.remaining.get() {
            self.limited.set(true);
            return false
        }
        self.remaining.set(self.remaining.get() - work);
        true
    }

    pub fn used(self: ShrinkBudget) -> isize {
        self.initial - self.remaining.get()
    }

    pub fn exhausted(self: ShrinkBudget) -> bool {
        self.limited.get()
    }
}

fn shrink_budget(work: isize) -> ShrinkBudget {
    ShrinkBudget { remaining: Ref::new(work), initial: work, limited: Ref::new(false) }
}

pub struct Candidates[T] {
    advance: (ShrinkBudget) -> Option[Sample[T]],
    done: Ref[bool],
}

impl[T] Candidates[T] {
    pub fn from_fn(advance: (ShrinkBudget) -> Option[Sample[T]]) -> Candidates[T] {
        Candidates { advance, done: Ref::new(false) }
    }

    pub fn empty() -> Candidates[T] {
        Candidates::from_fn(|_| Option::None)
    }

    pub fn next(self: Candidates[T], budget: ShrinkBudget) -> Option[Sample[T]] {
        if self.done.get() || budget.exhausted() || !budget.consume(1) {
            self.done.set(true);
            return Option::None
        }
        let value = (self.advance)(budget);
        if value.is_none() || budget.exhausted() {
            self.done.set(true);
            return Option::None
        }
        value
    }
}

pub struct Sample[T] {
    pub value: T,
    shrink: () -> Candidates[T],
}

impl[T] Sample[T] {
    pub fn lazy(value: T, shrink: () -> Candidates[T]) -> Sample[T] {
        Sample { value, shrink }
    }

    pub fn new(value: T, shrink: () -> Vec[Sample[T]]) -> Sample[T] {
        Sample::lazy(
            value,
            || {
                let values: Ref[Option[Vec[Sample[T]]]] = Ref::new(Option::None);
                let index: Ref[isize] = Ref::new(0);
                Candidates::from_fn(
                    |_| {
                        let children: Vec[Sample[T]] = match values.get() {
                            Some(children) => children,
                            None => {
                                let children = shrink();
                                values.set(Option::Some(children));
                                children
                            },
                        };
                        if index.get() < children.len() {
                            let child = children[index.get()];
                            index.set(index.get() + 1);
                            Option::Some(child)
                        } else {
                            Option::None
                        }
                    },
                )
            },
        )
    }

    pub fn leaf(value: T) -> Sample[T] {
        Sample::lazy(value, || Candidates::empty())
    }

    pub fn candidates(self: Sample[T]) -> Candidates[T] {
        (self.shrink)()
    }

    pub fn children(self: Sample[T]) -> Vec[Sample[T]] {
        let budget = shrink_budget(9223372036854775807);
        let iterator = self.candidates();
        let result = Vec::new();
        while let Some(child) = iterator.next(budget) {
            result.push(child);
        }
        result
    }
}
