package proptest;

use std::json;
use std::text;

fn scaled_count(count: isize, total: isize, scale: isize) -> isize {
    if total == 0 {
        return 0
    }
    let mut result = 0;
    for step in 1..=scale {
        let threshold = total / scale * step + (total % scale * step + scale - 1) / scale;
        if count < threshold {
            break
        }
        result = step;
    }
    result
}

fn render_counts(name: string, counts: Vec[(string, isize)], total: isize, width: isize) -> Result[
    string,
    string,
] {
    if width < 0 || width > 120 || total < 0 {
        return Result::Err(
            "histogram rendering requires nonnegative samples and width between 0 and 120",
        )
    }
    let output = text::StringBuilder::new();
    output.write_line(json::try_to_string(name)? + f" ({total} samples)");
    for entry in counts {
        if entry.1 < 0 || entry.1 > total {
            return Result::Err("histogram bucket count must be between zero and its sample count")
        }
        let filled = scaled_count(entry.1, total, width);
        let bar = text::StringBuilder::new();
        for _ in 0..filled {
            bar.write_string("#");
        }
        for _ in filled..width {
            bar.write_string(" ");
        }
        let percent = scaled_count(entry.1, total, 100);
        output.write_line(
            "  " + json::try_to_string(entry.0)? + f" {entry.1}/{total} ({percent}%) |"
                + bar.finish()
                + "|",
        );
    }
    Result::Ok(output.finish())
}

impl Histogram {
    pub fn render(self: Histogram, width: isize) -> Result[string, string] {
        render_counts(self.name, self.buckets, self.samples, width)
    }
}

impl[T] RunReport[T] {
    pub fn render(self: RunReport[T], format_value: (T) -> string) -> Result[string, string] {
        let output = text::StringBuilder::new();
        output.write_line(
            f"{self.status.debug()}: {self.cases} accepted, {self.generated} generated, {self.regressions} regressions, {self.discarded} discarded",
        );
        if self.message != "" {
            output.write_line("message: " + json::try_to_string(self.message)?);
        }
        if let Some(failure) = self.failure {
            output.write_line(
                f"case {failure.case_index}, seed {failure.seed}, {failure.attempts} shrink attempts",
            );
            if let Some(replay) = self.replay {
                output.write_line(f"replay: seed={replay.seed}, size={replay.size}");
            }
            output.write_line("initial: " + json::try_to_string(format_value(failure.initial))?);
            output.write_line("minimal: " + json::try_to_string(format_value(failure.minimal))?);
            output.write_line(f"shrink work: {self.shrink_work}, limited: {self.shrink_limited}");
        }
        if !self.labels.is_empty() {
            output.write_string(render_counts("classifications", self.labels, self.cases, 24)?);
        }
        if !self.discard_reasons.is_empty() {
            output.write_string(
                render_counts("discard reasons", self.discard_reasons, self.discarded, 24)?,
            );
        }
        Result::Ok(output.finish())
    }
}

impl[T] CampaignReport[T] {
    pub fn render(self: CampaignReport[T], format_value: (T) -> string, width: isize) -> Result[
        string,
        string,
    ] {
        if width < 0 || width > 120 {
            return Result::Err("histogram width must be between 0 and 120")
        }
        let output = text::StringBuilder::new();
        output.write_string(self.summary.render(format_value)?);
        output.write_line(f"campaign: {self.failures.len()} failures, completed: {self.completed}");
        if self.stop_reason != "" {
            output.write_line("stopped: " + json::try_to_string(self.stop_reason)?);
        }
        for index in 0..self.failures.len() {
            let entry = self.failures[index];
            output.write_line(
                f"failure {index + 1}: seed={entry.replay.seed}, size={entry.replay.size}, case={entry.failure.case_index}",
            );
            output.write_line("  message: " + json::try_to_string(entry.message)?);
            output.write_line(
                "  minimal: " + json::try_to_string(format_value(entry.failure.minimal))?,
            );
            output.write_line(
                f"  shrink attempts: {entry.failure.attempts}, work: {entry.shrink_work}, limited: {entry.shrink_limited}",
            );
        }
        for histogram in self.histograms {
            output.write_string(histogram.render(width)?);
        }
        Result::Ok(output.finish())
    }
}
