package proptest;

use std::math;
use std::rand;

fn unsigned_sample(value: u64, target: u64) -> Sample[u64] {
    Sample::lazy(
        value,
        || {
            let first = Ref::new(value != target);
            let step: Ref[u64] = Ref::new((value - target) / 2);
            Candidates::from_fn(
                |_| {
                    if first.get() {
                        first.set(false);
                        return Option::Some(unsigned_sample(target, target))
                    }
                    if step.get() == 0 {
                        return Option::None
                    }
                    let next = value - step.get();
                    step.set(step.get() / 2);
                    Option::Some(unsigned_sample(next, target))
                },
            )
        },
    )
}

pub fn unsigneds(minimum: u64, maximum: u64) -> Result[Generator[u64], string] {
    if minimum >= maximum {
        return Result::Err("unsigned range must be nonempty")
    }
    Result::Ok(
        Generator::new(
            |seed, _| Result::Ok(
                unsigned_sample(minimum + rand::next_u64(seed) % (maximum - minimum), minimum),
            ),
        ),
    )
}

pub fn any_u64() -> Generator[u64] {
    Generator::new(|seed, _| Result::Ok(unsigned_sample(rand::next_u64(seed), 0)))
}

pub fn any_i64() -> Generator[i64] {
    Generator::new(
        |seed, _| Result::Ok(
            map_sample(integer_sample(rand::next_u64(seed).to_isize(), 0), |value| value.to_i64()),
        ),
    )
}

pub fn float64s() -> Generator[f64] {
    let edges: Vec[u64] = Vec::from_array(
        [
            0,
            0x8000000000000000,
            1,
            0x8000000000000001,
            0x0010000000000000,
            0x8010000000000000,
            0x3ff0000000000000,
            0xbff0000000000000,
            0x7fefffffffffffff,
            0xffefffffffffffff,
            0x7ff0000000000000,
            0xfff0000000000000,
            0x7ff8000000000000,
            0xfff8000000000001,
        ],
    );
    Generator::new(
        |seed, _| {
            let random = rand::next_u64(seed);
            let bits = if random % 4 == 0 {
                edges[(random / 4 % edges.len().to_u64()).to_isize()]
            } else {
                random
            };
            let value = float64_from_bits(bits);
            if math::is_finite(value) && bits != 0x8000000000000000 {
                Result::Ok(float_sample(value, 0.0, 64))
            } else {
                Result::Ok(Sample::new(value, || Vec::from_array([Sample::leaf(0.0)])))
            }
        },
    )
}
