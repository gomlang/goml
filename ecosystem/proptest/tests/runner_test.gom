package tests;

use ecosystem::proptest;
use proptest::Strategy;
use std::fs;
use std::testing;

fn one_case(work: isize, shrinks: isize) -> proptest::RunOptions {
    proptest::RunOptions {
        config: proptest::Config { seed: 42, cases: 1, size: 100000, max_shrinks: shrinks },
        max_shrink_work: work,
        ..proptest::RunOptions::new(42),
    }
}

fn numbered(value: isize, advances: Ref[isize], factories: Ref[isize]) -> proptest::Sample[isize] {
    proptest::Sample::lazy(
        value,
        || {
            factories.set(factories.get() + 1);
            let next = Ref::new(0);
            proptest::Candidates::from_fn(
                |_| {
                    advances.set(advances.get() + 1);
                    if next.get() >= value {
                        return Option::None
                    }
                    let child = next.get();
                    next.set(child + 1);
                    Option::Some(numbered(child, advances, factories))
                },
            )
        },
    )
}

#[test]
fn shrink_candidates_are_lazy_through_combinators() -> () {
    let advances = Ref::new(0);
    let factories = Ref::new(0);
    let base = proptest::Generator::new(|_, _| Result::Ok(numbered(100000, advances, factories)));
    let generator = base.map(|value| value + 1).zip(proptest::just(true)).flat_map(
        |pair| proptest::just(pair),
    );
    let result = testing::expect_ok(
        proptest::run(generator, one_case(100, 1), |_| proptest::Case::fail("failed")),
        "run",
    );
    let failure = testing::expect_some(result.failure, "failure");
    testing::assert_eq(failure.minimal.0, 1);
    testing::assert_eq(failure.attempts, 1);
    testing::assert_eq(advances.get(), 1);
    testing::assert_eq(factories.get(), 1);
    testing::assert(result.shrink_limited);
}

#[test]
fn zero_budget_does_not_expand_legacy_or_lazy_samples() -> () {
    let expanded = Ref::new(0);
    let generator = proptest::Generator::new(
        |_, _| Result::Ok(
            proptest::Sample::new(
                7,
                || {
                    expanded.set(expanded.get() + 1);
                    Vec::from_array([proptest::Sample::leaf(0)])
                },
            ),
        ),
    );
    for options in Vec::from_array([one_case(0, 100), one_case(100, 0)]) {
        let result = testing::expect_ok(
            proptest::run(generator, options, |_| proptest::Case::fail("failure")),
            "run",
        );
        testing::assert_eq(testing::expect_some(result.failure, "failure").minimal, 7);
        testing::assert_eq(result.shrink_work, 0);
        testing::assert(result.shrink_limited);
    }
    testing::assert_eq(expanded.get(), 0);
}

#[test]
fn rejected_shrink_candidates_share_the_work_budget() -> () {
    let advances = Ref::new(0);
    let factories = Ref::new(0);
    let generator = proptest::Generator::new(
        |_, _| Result::Ok(numbered(100000, advances, factories)),
    ).filter(|value| value == 100000, 1);
    let result = testing::expect_ok(
        proptest::run(generator, one_case(12, 100), |_| proptest::Case::fail("failure")),
        "run",
    );
    testing::assert(result.shrink_limited);
    testing::assert(result.shrink_work <= 12);
    testing::assert(advances.get() < 12);
    let failure = testing::expect_some(result.failure, "failure");
    testing::assert_eq(failure.minimal, 100000);
    testing::assert_eq(failure.attempts, 0);
}

#[test]
fn large_vectors_do_not_materialize_all_shrinks() -> () {
    let generator = testing::expect_ok(proptest::vectors(proptest::just(7), 0, 100000), "generator");
    let result = testing::expect_ok(
        proptest::run(
            generator,
            one_case(8, 100),
            |values: Vec[isize]| {
                if values.len() == 0 {
                    proptest::Case::pass()
                } else {
                    proptest::Case::fail("nonempty")
                }
            },
        ),
        "run",
    );
    let failure = testing::expect_some(result.failure, "failure");
    testing::assert(failure.initial.len() > 1000);
    testing::assert(failure.minimal == failure.initial);
    testing::assert_eq(failure.attempts, 1);
    testing::assert(result.shrink_limited);
    testing::assert(result.shrink_work <= 8);
    let result = testing::expect_ok(
        proptest::run(generator, one_case(8, 1), |_| proptest::Case::fail("always")),
        "one candidate",
    );
    testing::assert_eq(testing::expect_some(result.failure, "failure").minimal.len(), 0);
}

#[test]
fn candidate_exhaustion_is_permanent_and_budgeted() -> () {
    let calls = Ref::new(0);
    let candidates: proptest::Candidates[isize] = proptest::Candidates::from_fn(
        |_| {
            calls.set(calls.get() + 1);
            Option::None
        },
    );
    let budget = testing::expect_ok(proptest::ShrinkBudget::new(4), "budget");
    testing::assert_none(candidates.next(budget));
    testing::assert_none(candidates.next(budget));
    testing::assert_eq(calls.get(), 1);
    testing::assert_eq(budget.used(), 1);
    testing::assert_err(proptest::ShrinkBudget::new(-1));
    testing::assert(!budget.consume(4));
    testing::assert(budget.exhausted());
    testing::assert(!budget.consume(1));
    let overrun = proptest::Candidates::from_fn(
        |budget| {
            let _ = budget.consume(100);
            Option::Some(proptest::Sample::leaf(1))
        },
    );
    testing::assert_none(
        overrun.next(testing::expect_ok(proptest::ShrinkBudget::new(2), "small budget")),
    );
    testing::assert_none(
        overrun.next(testing::expect_ok(proptest::ShrinkBudget::new(1000), "fresh budget")),
    );
}

#[test]
fn discard_budgets_and_coverage_are_reported() -> () {
    let draws = Ref::new(0);
    let generator = proptest::Generator::new(
        |_, _| {
            draws.set(draws.get() + 1);
            Result::Ok(proptest::Sample::leaf(draws.get()))
        },
    );
    let options = proptest::RunOptions {
        config: proptest::Config { cases: 3, ..proptest::Config::new(42) },
        coverage: Vec::from_array([proptest::Coverage { label: "even", minimum_percent: 100 }]),
        ..proptest::RunOptions::new(42),
    };
    let report = testing::expect_ok(
        proptest::run(
            generator,
            options,
            |value: isize| {
                if value % 2 == 1 {
                    proptest::Case::discard("odd")
                } else {
                    proptest::Case::pass().label("even").label("even")
                }
            },
        ),
        "run",
    );
    testing::assert_eq(report.status, proptest::RunStatus::Passed);
    testing::assert_eq(report.cases, 3);
    testing::assert_eq(report.generated, 6);
    testing::assert_eq(report.discarded, 3);
    testing::assert(report.labels == Vec::from_array([("even", 3)]));
    testing::assert(report.discard_reasons == Vec::from_array([("odd", 3)]));
    let rejected = testing::expect_ok(
        proptest::run(
            proptest::just(0),
            proptest::RunOptions { max_discards: 2, ..options },
            |_| proptest::Case::discard("unusable"),
        ),
        "discard",
    );
    testing::assert_eq(rejected.status, proptest::RunStatus::Rejected);
    testing::assert_eq(rejected.discarded, 3);
    testing::assert_none(rejected.failure);
    let uncovered = testing::expect_ok(
        proptest::run(proptest::just(0), options, |_| proptest::Case::pass()),
        "coverage",
    );
    testing::assert_eq(uncovered.status, proptest::RunStatus::Rejected);
    testing::assert(uncovered.message.contains("even"));
}

#[test]
fn discarded_shrinks_cannot_replace_a_failure() -> () {
    let generator = proptest::Generator::new(
        |_, _| Result::Ok(
            proptest::Sample::new(
                10,
                || Vec::from_array([proptest::Sample::leaf(0), proptest::Sample::leaf(1)]),
            ),
        ),
    );
    let result = testing::expect_ok(
        proptest::run(
            generator,
            one_case(100, 100),
            |value| {
                if value == 0 {
                    proptest::Case::discard("not applicable")
                } else {
                    proptest::Case::fail(value.to_string())
                }
            },
        ),
        "run",
    );
    testing::assert_eq(testing::expect_some(result.failure, "failure").minimal, 1);
    testing::assert_eq(result.message, "1");
    testing::assert_eq(result.discarded, 0);
    testing::assert(!result.shrink_limited);
}

#[test]
fn regression_codec_checks_versions_properties_ranges_and_duplicates() -> () {
    let entries = Vec::from_array(
        [
            proptest::Replay { seed: 0xffffffffffffffff, size: 64 },
            proptest::Replay { seed: 0, size: 0 },
        ],
    );
    let encoded = testing::expect_ok(proptest::encode_replays("unicode / 回归", entries), "encode");
    testing::assert(
        testing::expect_ok(proptest::decode_replays("unicode / 回归", encoded), "decode") == entries,
    );
    testing::assert_err(proptest::decode_replays("different", encoded));
    let duplicates = entries.copy();
    duplicates.push(entries[0]);
    testing::assert_eq(
        testing::expect_ok(proptest::encode_replays("unicode / 回归", duplicates), "deduplicate"),
        encoded,
    );
    for data in Vec::from_array(
        [
            "",
            "goml-proptest-v2\tp\n",
            "goml-proptest-v1\tp\n18446744073709551616\t0\n",
            "goml-proptest-v1\tp\n1\t-1\n",
            "goml-proptest-v1\tp\n1\t9223372036854775808\n",
            "goml-proptest-v1\tp\nwrong\n",
        ],
    ) {
        testing::assert_err(proptest::decode_replays("p", data));
    }
    testing::assert_err(proptest::encode_replays("p\nq", entries));
    testing::assert_err(proptest::encode_replays("p ", entries));
}

#[test]
fn persistent_regressions_run_before_random_cases() -> () {
    let directory = "_artifact/proptest-regression-test";
    testing::expect_ok(fs::create_dir_all(directory), "directory");
    defer {
        let _ = fs::remove_dir_all(directory);
    };
    let path = directory + "/cases.txt";
    if fs::exists(path) {
        testing::expect_ok(fs::remove_file(path), "remove old corpus");
    }
    let store = testing::expect_ok(proptest::RegressionStore::new(path, "test.property"), "store");
    testing::assert_eq(testing::expect_ok(store.load(), "empty").len(), 0);
    let generator = proptest::Generator::new(
        |seed, size| Result::Ok(proptest::Sample::leaf((seed, size))),
    );
    let failed = testing::expect_ok(
        proptest::run_persisted(generator, one_case(0, 0), store, |_| proptest::Case::fail("save")),
        "persist",
    );
    let replay = testing::expect_some(failed.replay, "seed");
    testing::expect_ok(store.save(replay), "deduplicate");
    testing::assert_eq(testing::expect_ok(store.load(), "saved").len(), 1);
    let options = proptest::RunOptions {
        config: proptest::Config { seed: 999, cases: 0, size: 1, max_shrinks: 0 },
        ..proptest::RunOptions::new(999),
    };
    let passed = testing::expect_ok(
        proptest::run_persisted(
            generator,
            options,
            store,
            |value: (u64, isize)| {
                testing::assert_eq(value.0, replay.seed);
                testing::assert_eq(value.1, replay.size);
                proptest::Case::pass()
            },
        ),
        "replay",
    );
    testing::assert_eq(passed.status, proptest::RunStatus::Passed);
    testing::assert_eq(passed.regressions, 1);
    testing::assert_eq(passed.generated, 0);
    testing::expect_ok(fs::write_file_structured(path, "invalid"), "corrupt");
    testing::assert_err(store.save(replay));
    testing::assert_eq(testing::expect_ok(fs::read_file_structured(path), "preserved"), "invalid");
}

#[test]
fn invalid_runner_configuration_is_rejected_before_generation() -> () {
    let calls = Ref::new(0);
    let generator = proptest::Generator::new(
        |_, _| {
            calls.set(calls.get() + 1);
            Result::Ok(proptest::Sample::leaf(0))
        },
    );
    for options in Vec::from_array(
        [
            proptest::RunOptions { max_shrink_work: -1, ..proptest::RunOptions::new(0) },
            proptest::RunOptions { max_discards: -1, ..proptest::RunOptions::new(0) },
            proptest::RunOptions {
                regressions: Vec::from_array([proptest::Replay { seed: 0, size: -1 }]),
                ..proptest::RunOptions::new(0),
            },
            proptest::RunOptions {
                coverage: Vec::from_array(
                    [proptest::Coverage { label: "label", minimum_percent: 101 }],
                ),
                ..proptest::RunOptions::new(0),
            },
        ],
    ) {
        testing::assert_err(proptest::run(generator, options, |_| proptest::Case::pass()));
    }
    testing::assert_eq(calls.get(), 0);
}
