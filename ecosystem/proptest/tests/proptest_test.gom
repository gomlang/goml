package tests;

use ecosystem::proptest;
use proptest::Strategy;
use std::testing;

fn config() -> proptest::Config {
    proptest::Config { seed: 1234, cases: 100, size: 20, max_shrinks: 200 }
}

#[test]
fn deterministic_failure_and_replay() -> () {
    let generator = testing::expect_ok(proptest::integers(1, 1000), "generator");
    let failed = testing::expect_some(
        testing::expect_ok(proptest::check(generator, config(), |x: isize| x == 0), "check"),
        "failure",
    );
    testing::assert_eq(failed.minimal, 1);
    testing::assert_eq(
        testing::expect_ok(generator.generate(failed.seed, 20), "replay").value,
        failed.initial,
    );
    testing::assert_none(
        testing::expect_ok(
            proptest::check(generator, config(), |x: isize| x >= 1 && x < 1000),
            "passing",
        ),
    );
}

#[test]
fn mapped_filtered_and_zipped_samples_shrink() -> () {
    let integers = testing::expect_ok(proptest::integers(1, 100), "generator");
    let pairs = integers.filter(|x| x % 2 == 0, 100).map(|x| x.to_string()).zip(
        proptest::just(true),
    );
    let result = testing::expect_some(
        testing::expect_ok(proptest::check(pairs, config(), |_| false), "check"),
        "failure",
    );
    testing::assert(result.minimal.1);
    testing::assert_eq(result.minimal.0, "2");
    testing::assert_err(proptest::just(1).filter(|_| false, 3).generate(1, 1));
}

#[test]
fn vector_shrinking_and_range_errors() -> () {
    let generator = testing::expect_ok(proptest::vectors(proptest::just(7), 2, 20), "vectors");
    let failed = testing::expect_some(
        testing::expect_ok(proptest::check(generator, config(), |_| false), "check"),
        "failure",
    );
    testing::assert_eq(failed.minimal.len(), 2);
    testing::assert_err(proptest::integers(2, 2));
    testing::assert_err(proptest::vectors(proptest::just(1), 3, 2));
}

struct Custom {}

impl proptest::Strategy for Custom {
    type Item = string;

    fn generate(self: Custom, seed: u64, size: isize) -> Result[proptest::Sample[string], string] {
        Result::Ok(proptest::Sample::leaf(f"{seed}:{size}"))
    }
}

#[test]
fn downstream_associated_type_strategy() -> () {
    testing::assert_none(
        testing::expect_ok(
            proptest::check(Custom {}, config(), |value: string| value.contains(":")),
            "custom strategy",
        ),
    );
}
