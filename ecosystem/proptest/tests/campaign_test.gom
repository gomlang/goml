package tests;

use ecosystem::proptest;
use std::fs;
use std::testing;

fn saved_cases(count: isize) -> proptest::CampaignOptions {
    let regressions = Vec::new();
    for seed in 0..count {
        regressions.push(proptest::Replay { seed: seed.to_u64(), size: 8 });
    }
    proptest::CampaignOptions {
        run: proptest::RunOptions {
            config: proptest::Config { cases: 0, ..proptest::Config::new(0) },
            regressions,
            ..proptest::RunOptions::new(0),
        },
        ..proptest::CampaignOptions::new(0),
    }
}

fn saved_value() -> proptest::Generator[isize] {
    proptest::Generator::new(|seed, _| Result::Ok(proptest::Sample::leaf(seed.to_isize())))
}

#[test]
fn campaign_aggregates_failures_and_accepted_distributions() -> () {
    let report = testing::expect_ok(
        proptest::run_campaign(
            saved_value(),
            saved_cases(8),
            |value: isize| {
                let case = if value == 2 {
                    proptest::Case::discard("skip")
                } else if value % 2 == 1 {
                    proptest::Case::fail("odd")
                } else {
                    proptest::Case::pass()
                };
                case.label("tested").collect("parity", (value % 2).to_string()).collect(
                    "parity",
                    (value % 2).to_string(),
                )
            },
        ),
        "campaign",
    );
    testing::assert_eq(report.summary.status, proptest::RunStatus::Failed);
    testing::assert(report.completed);
    testing::assert_eq(report.summary.cases, 7);
    testing::assert_eq(report.summary.discarded, 1);
    testing::assert_eq(report.summary.regressions, 8);
    testing::assert_eq(report.summary.generated, 0);
    testing::assert_eq(report.failures.len(), 4);
    for index in 0..4 {
        testing::assert_eq(report.failures[index].failure.case_index, index * 2 + 1);
        testing::assert_eq(report.failures[index].failure.minimal, index * 2 + 1);
        testing::assert_eq(report.failures[index].replay.seed, (index * 2 + 1).to_u64());
    }
    testing::assert_eq(report.histograms.len(), 1);
    testing::assert_eq(report.histograms[0].samples, 7);
    testing::assert(report.histograms[0].buckets == Vec::from_array([("0", 3), ("1", 4)]));
    testing::assert(report.summary.labels == Vec::from_array([("tested", 7)]));
    let text = testing::expect_ok(report.render(|value| value.to_string(), 7), "render");
    testing::assert(text.contains("campaign: 4 failures, completed: true"));
    testing::assert(text.contains("4/7 (57%) |####   |"));
    testing::assert(text.contains("failure 4: seed=7, size=8, case=7"));
}

#[test]
fn campaign_failure_limit_and_shared_shrink_budgets_are_exact() -> () {
    let generator = proptest::Generator::new(
        |_, _| Result::Ok(
            proptest::Sample::new(
                10,
                || Vec::from_array([proptest::Sample::leaf(0), proptest::Sample::leaf(1)]),
            ),
        ),
    );
    let options = proptest::CampaignOptions {
        run: proptest::RunOptions {
            config: proptest::Config { max_shrinks: 3, ..saved_cases(5).run.config },
            max_shrink_work: 20,
            ..saved_cases(5).run,
        },
        max_failures: 3,
        ..saved_cases(5),
    };
    let report = testing::expect_ok(
        proptest::run_campaign(
            generator,
            options,
            |value: isize| {
                let case = if value == 0 {
                    proptest::Case::pass()
                } else {
                    proptest::Case::fail("positive")
                };
                case.collect("value", value.to_string())
            },
        ),
        "campaign",
    );
    testing::assert(!report.completed);
    testing::assert(report.stop_reason.contains("failure limit"));
    testing::assert_eq(report.summary.regressions, 3);
    testing::assert_eq(report.failures.len(), 3);
    testing::assert_eq(report.failures[0].failure.minimal, 1);
    testing::assert_eq(report.failures[1].failure.minimal, 10);
    testing::assert_eq(report.failures[2].failure.attempts, 0);
    let mut attempts = 0;
    let mut work = 0;
    for failure in report.failures {
        attempts += failure.failure.attempts;
        work += failure.shrink_work;
    }
    testing::assert_eq(attempts, 3);
    testing::assert_eq(work, report.summary.shrink_work);
    testing::assert(work <= 20);
    testing::assert(report.histograms[0].buckets == Vec::from_array([("10", 3)]));
    let exact = testing::expect_ok(
        proptest::run_campaign(
            saved_value(),
            proptest::CampaignOptions { max_failures: 2, ..saved_cases(2) },
            |_| proptest::Observation::new(proptest::Case::fail("all")),
        ),
        "exact limit",
    );
    testing::assert(exact.completed);
    testing::assert_eq(exact.stop_reason, "");
}

#[test]
fn campaign_discards_cannot_hide_prior_failures_and_coverage_still_applies() -> () {
    let options = proptest::CampaignOptions {
        run: proptest::RunOptions { max_discards: 0, ..saved_cases(3).run },
        ..saved_cases(3),
    };
    let report = testing::expect_ok(
        proptest::run_campaign(
            saved_value(),
            options,
            |value: isize| proptest::Observation::new(
                if value == 0 {
                    proptest::Case::fail("bug")
                } else {
                    proptest::Case::discard("skip")
                },
            ),
        ),
        "discard after failure",
    );
    testing::assert_eq(report.summary.status, proptest::RunStatus::Failed);
    testing::assert_eq(report.summary.message, "bug");
    testing::assert_eq(report.failures.len(), 1);
    testing::assert(!report.completed);
    testing::assert(report.stop_reason.contains("discard budget"));
    let options = proptest::CampaignOptions {
        run: proptest::RunOptions {
            coverage: Vec::from_array([proptest::Coverage { label: "missing", minimum_percent: 1 }]),
            ..saved_cases(0).run,
        },
        ..saved_cases(0),
    };
    let report = testing::expect_ok(
        proptest::run_campaign(
            saved_value(),
            options,
            |_| proptest::Observation::new(proptest::Case::pass()),
        ),
        "coverage",
    );
    testing::assert_eq(report.summary.status, proptest::RunStatus::Rejected);
    testing::assert(report.completed);
}

#[test]
fn campaign_validates_limits_and_observation_cardinality() -> () {
    let calls = Ref::new(0);
    let generator = proptest::Generator::new(
        |_, _| {
            calls.set(calls.get() + 1);
            Result::Ok(proptest::Sample::leaf(1))
        },
    );
    for options in Vec::from_array(
        [
            proptest::CampaignOptions { max_failures: 0, ..saved_cases(1) },
            proptest::CampaignOptions { max_failures: 10001, ..saved_cases(1) },
            proptest::CampaignOptions { max_histogram_buckets: -1, ..saved_cases(1) },
            proptest::CampaignOptions { max_histogram_buckets: 10001, ..saved_cases(1) },
        ],
    ) {
        testing::assert_err(
            proptest::run_campaign(
                generator,
                options,
                |_| proptest::Observation::new(proptest::Case::pass()),
            ),
        );
    }
    testing::assert_eq(calls.get(), 0);
    testing::assert_err(
        proptest::run_campaign(
            generator,
            saved_cases(1),
            |_| proptest::Case::pass().collect("", "value"),
        ),
    );
    testing::assert_err(
        proptest::run_campaign(
            generator,
            saved_cases(1),
            |_| proptest::Case::pass().collect("name", "a").collect("name", "b"),
        ),
    );
    testing::assert_err(
        proptest::run_campaign(
            saved_value(),
            proptest::CampaignOptions { max_histogram_buckets: 1, ..saved_cases(2) },
            |value| proptest::Case::pass().collect("value", value.to_string()),
        ),
    );
    let report = testing::expect_ok(
        proptest::run_campaign(
            saved_value(),
            proptest::CampaignOptions { max_histogram_buckets: 0, ..saved_cases(2) },
            |_| proptest::Observation::new(proptest::Case::pass()),
        ),
        "no observations",
    );
    testing::assert_eq(report.histograms.len(), 0);
}

#[test]
fn histogram_rendering_is_deterministic_and_overflow_safe() -> () {
    let histogram = proptest::Histogram {
        name: "size\nbytes",
        samples: 9223372036854775807,
        buckets: Vec::from_array(
            [("all", 9223372036854775807), ("half", 4611686018427387903), ("none", 0)],
        ),
    };
    let rendered = testing::expect_ok(histogram.render(4), "render");
    testing::assert(rendered.starts_with("\"size\\nbytes\""));
    testing::assert(rendered.contains("(100%) |####|"));
    testing::assert(rendered.contains("(49%) |#   |"));
    testing::assert(rendered.contains("(0%) |    |"));
    testing::assert_err(histogram.render(-1));
    testing::assert_err(histogram.render(121));
    testing::assert(testing::expect_ok(histogram.render(0), "no bar").contains("||"));
    testing::assert_err(proptest::Histogram { samples: 0, ..histogram }.render(4));
}

#[test]
fn campaign_persistence_saves_every_counterexample_atomically() -> () {
    let directory = "_artifact/proptest-campaign-store";
    testing::expect_ok(fs::create_dir_all(directory), "directory");
    defer {
        let _ = fs::remove_dir_all(directory);
    };
    let path = directory + "/replays.txt";
    if fs::exists(path) {
        testing::expect_ok(fs::remove_file(path), "old corpus");
    }
    let store = testing::expect_ok(proptest::RegressionStore::new(path, "campaign"), "store");
    let report = testing::expect_ok(
        proptest::run_campaign_persisted(
            saved_value(),
            saved_cases(6),
            store,
            |value: isize| proptest::Observation::new(
                if value % 2 == 1 {
                    proptest::Case::fail("odd")
                } else {
                    proptest::Case::pass()
                },
            ),
        ),
        "campaign",
    );
    testing::assert_eq(report.failures.len(), 3);
    let saved = testing::expect_ok(store.load(), "all failures");
    testing::assert_eq(saved.len(), 3);
    testing::expect_ok(store.save_all(saved), "deduplicate");
    testing::assert(testing::expect_ok(store.load(), "saved") == saved);
    let replay = testing::expect_ok(
        proptest::run_campaign_persisted(
            saved_value(),
            saved_cases(0),
            store,
            |_| proptest::Observation::new(proptest::Case::pass()),
        ),
        "replay all",
    );
    testing::assert_eq(replay.summary.regressions, 3);
    testing::assert_eq(replay.summary.generated, 0);
    let before = testing::expect_ok(fs::read_file_structured(path), "before");
    testing::assert_err(
        store.save_all(
            Vec::from_array(
                [proptest::Replay { seed: 7, size: 8 }, proptest::Replay { seed: 9, size: -1 }],
            ),
        ),
    );
    testing::assert_eq(testing::expect_ok(fs::read_file_structured(path), "unchanged"), before);
}
