package tests;

use ecosystem::proptest;
use proptest::Strategy;
use std::math;
use std::testing;

#[test]
fn unique_collections_preserve_bounds_during_shrinking() -> () {
    let integers = testing::expect_ok(proptest::integers(0, 100), "integers");
    let generator = testing::expect_ok(
        proptest::unique_vectors_by(integers, |value| value, 3, 12, 100),
        "unique",
    );
    let failure = testing::expect_some(
        testing::expect_ok(
            proptest::check(
                generator,
                proptest::Config::new(42),
                |values: Vec[isize]| {
                    testing::assert(values.len() >= 3 && values.len() <= 12);
                    let seen: HashMap[isize, bool] = HashMap::new();
                    for value in values {
                        testing::assert(seen.get(value).is_none());
                        seen.set(value, true);
                    }
                    false
                },
            ),
            "run",
        ),
        "failure",
    );
    testing::assert_eq(failure.minimal.len(), 3);
    let sets = testing::expect_ok(proptest::sets(integers, 2, 10, 100), "sets");
    let failure = testing::expect_some(
        testing::expect_ok(
            proptest::check(
                sets,
                proptest::Config::new(42),
                |value| {
                    testing::assert(value.len() >= 2);
                    false
                },
            ),
            "set shrink",
        ),
        "failure",
    );
    testing::assert_eq(failure.minimal.len(), 2);
    let maps = testing::expect_ok(
        proptest::maps(integers, proptest::booleans(), 2, 10, 100),
        "maps",
    );
    let failure = testing::expect_some(
        testing::expect_ok(
            proptest::check(
                maps,
                proptest::Config::new(42),
                |value| {
                    testing::assert(value.len() >= 2);
                    false
                },
            ),
            "map shrink",
        ),
        "failure",
    );
    testing::assert_eq(failure.minimal.len(), 2);
    let impossible = testing::expect_ok(
        proptest::unique_vectors_by(proptest::just(0), |value| value, 2, 2, 10),
        "bounded rejection",
    );
    testing::assert_err(impossible.generate(0, 10));
    testing::assert_err(proptest::sets(integers, 3, 2, 10));
    testing::assert_err(proptest::sets(integers, 0, 2, -1));
}

fn transition(balance: isize, operation: isize) -> Result[isize, string] {
    if balance + operation < 0 {
        Result::Err("cannot withdraw from empty model")
    } else {
        Result::Ok(balance + operation)
    }
}

#[test]
fn stateful_generation_and_shrinking_keep_valid_command_prefixes() -> () {
    let generator = testing::expect_ok(
        proptest::stateful(
            || 0,
            |balance| if balance == 0 {
                proptest::just(1)
            } else {
                proptest::booleans().map(
                    |increase| if increase {
                        1
                    } else {
                        -1
                    },
                )
            },
            transition,
            1,
            30,
            100,
        ),
        "stateful",
    );
    let failure = testing::expect_some(
        testing::expect_ok(
            proptest::check(
                generator,
                proptest::Config::new(42),
                |commands: Vec[isize]| {
                    let mut model = 0;
                    for command in commands {
                        model = testing::expect_ok(transition(model, command), "valid prefix");
                    }
                    false
                },
            ),
            "run",
        ),
        "failure",
    );
    testing::assert(failure.minimal == Vec::from_array([1]));
    let impossible = testing::expect_ok(
        proptest::stateful(|| 0, |_| proptest::just(-1), transition, 1, 1, 5),
        "invalid commands",
    );
    testing::assert_err(impossible.generate(42, 10));
}

#[test]
fn full_width_numbers_and_ieee_edge_cases_are_generated() -> () {
    let upper: u64 = 0xffffffffffffffff;
    let unsigned = testing::expect_ok(proptest::unsigneds(upper - 2, upper), "range");
    let mut nan = false;
    let mut infinity = false;
    let mut negative_zero = false;
    let mut subnormal = false;
    let mut high_unsigned = false;
    let mut negative_signed = false;
    for seed in 0..1024 {
        let value = testing::expect_ok(unsigned.generate(seed.to_u64(), 1), "unsigned").value;
        testing::assert(value >= upper - 2 && value < upper);
        let value = testing::expect_ok(
            proptest::any_u64().generate(seed.to_u64(), 1),
            "any unsigned",
        ).value;
        high_unsigned = high_unsigned || value > 0x7fffffffffffffff;
        let value = testing::expect_ok(proptest::any_i64().generate(seed.to_u64(), 1), "any signed").value;
        negative_signed = negative_signed || value < 0;
        let sample = testing::expect_ok(proptest::float64s().generate(seed.to_u64(), 1), "float");
        let bits = sample.value.to_bits();
        nan = nan || math::is_nan(sample.value);
        infinity = infinity || !math::is_finite(sample.value) && !math::is_nan(sample.value);
        negative_zero = negative_zero || bits == 0x8000000000000000;
        subnormal = subnormal || bits & 0x7ff0000000000000 == 0 && bits & 0x000fffffffffffff != 0;
        if bits != 0 {
            let budget = testing::expect_ok(proptest::ShrinkBudget::new(10), "budget");
            let child = testing::expect_some(sample.candidates().next(budget), "zero shrink");
            testing::assert_eq(child.value.to_bits(), 0.to_u64());
        }
    }
    testing::assert(
        nan && infinity && negative_zero && subnormal && high_unsigned && negative_signed,
    );
    testing::assert_err(proptest::unsigneds(1, 1));
}
