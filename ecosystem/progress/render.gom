package progress;

use std::io::{Error};
use ecosystem::ansi;
use ecosystem::unicode_text;
use std::math;
use std::num::{ToFloat, TryToInt};

fn validate_style(style: Style) -> Result[(), Error] {
    if style.frames.is_empty() || style.frames.len() > 64 || style.bar_columns < 0
        || style.bar_columns > 512 {
        return Result::Err(invalid("style frame count or bar width is outside its limit"))
    }
    for frame in style.frames {
        safe_text(frame, 64)?;
        if unicode_text::width(frame) != 1 {
            return Result::Err(invalid("spinner frames must occupy one terminal column"))
        }
    }
    for cell in Vec::from_array([style.fill, style.empty]) {
        safe_text(cell, 64)?;
        if unicode_text::width(cell) != 1 {
            return Result::Err(invalid("bar cells must occupy one terminal column"))
        }
    }
    Result::Ok(())
}

pub fn duration_text(milliseconds: i64) -> string {
    let seconds = if milliseconds < 0 {
        0
    } else {
        milliseconds / 1000
    };
    if seconds < 60 {
        seconds.to_string() + "s"
    } else if seconds < 3600 {
        (seconds / 60).to_string() + "m" + (seconds % 60).to_string() + "s"
    } else {
        (seconds / 3600).to_string() + "h" + (seconds % 3600 / 60).to_string() + "m"
    }
}

fn decimal_rate(value: f64) -> string {
    if !math::is_finite(value) || value < 0.0 {
        return "?"
    }
    if value >= MAX_POSITION.to_f64() {
        return ">=" + MAX_POSITION.to_string()
    }
    let whole = value.try_to_i64().unwrap_or(0);
    let fraction = ((value - whole.to_f64()) * 10.0).try_to_i64().unwrap_or(0);
    whole.to_string() + "." + fraction.to_string()
}

pub fn render_job(job: JobSnapshot, columns: isize, style: Style, profile: ansi::Profile) -> Result[
    string,
    Error,
] {
    validate_style(style)?;
    if columns < 0 || columns > 4096 || job.position < 0 || job.position > MAX_POSITION
        || job.frame < 0 {
        return Result::Err(invalid("invalid render width or job snapshot"))
    }
    valid_total(job.total)?;
    safe_text(job.name, 65536)?;
    safe_text(job.message, 65536)?;
    if let Some(total) = job.total {
        if job.position > total {
            return Result::Err(invalid("snapshot position exceeds total"))
        }
    }
    let (marker, color) = match job.status {
        Status::Running => (
            style.frames[(job.frame % style.frames.len().to_i64()).to_isize()],
            style.running,
        ),
        Status::Finished => ("+", style.finished),
        Status::Failed => ("!", style.failed),
        Status::Cancelled => ("x", style.cancelled),
    };
    let mut text = marker + " " + job.name + " ";
    if let Some(total) = job.total {
        if style.bar_columns > 0 {
            let filled = if total == 0 {
                style.bar_columns
            } else {
                math::floor(job.position.to_f64() / total.to_f64() * style.bar_columns.to_f64()).try_to_isize().unwrap_or(
                    0,
                )
            };
            text += "[" + style.fill.repeat(filled) + style.empty.repeat(style.bar_columns - filled)
                + "] ";
        }
        text += job.position.to_string() + "/" + total.to_string();
    } else {
        text += job.position.to_string();
    }
    if style.show_rate {
        if let Some(rate) = job.per_second {
            text += " " + decimal_rate(rate) + "/s";
        }
    }
    if style.show_eta && job.status == Status::Running {
        if let Some(eta) = job.eta_ms {
            text += " ETA " + duration_text(eta);
        }
    }
    if style.show_elapsed {
        text += " " + duration_text(job.elapsed_ms);
    }
    if job.message != "" {
        text += " " + job.message;
    }
    let clipped = unicode_text::truncate(text, columns);
    Result::Ok(
        ansi::StyledText::from_spans(Vec::from_array([ansi::Span::new(clipped, color)])).render(
            profile,
        ),
    )
}

pub fn render(
    snapshot: Snapshot,
    columns: isize,
    max_visible: isize,
    style: Style,
    profile: ansi::Profile,
) -> Result[Vec[string], Error] {
    if snapshot.jobs.len() > 1000 || max_visible < 1 || max_visible > 100 || columns < 0
        || columns > 4096 {
        return Result::Err(invalid("render dimensions exceed limits"))
    }
    validate_style(style)?;
    let output = Vec::new();
    let shown = if snapshot.jobs.len() > max_visible {
        max_visible - 1
    } else {
        snapshot.jobs.len()
    };
    for index in 0..shown {
        output.push(render_job(snapshot.jobs[index], columns, style, profile)?);
    }
    if shown < snapshot.jobs.len() {
        output.push(
            unicode_text::truncate(
                "... " + (snapshot.jobs.len() - shown).to_string() + " more jobs",
                columns,
            ),
        );
    }
    Result::Ok(output)
}
