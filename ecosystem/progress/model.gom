package progress;

use ecosystem::ansi;
use std::io;
use std::time;
pub use std::io::{Error};

pub const MAX_POSITION: i64 = 9007199254740991;

#[derive(Debug, PartialEq, Eq)]
pub enum Status {
    Running,
    Finished,
    Failed,
    Cancelled,
}

#[derive(Debug, PartialEq, Eq)]
pub enum Mode {
    Auto,
    Interactive,
    Lines,
}

pub struct Clock {
    read: () -> i64,
}

impl Clock {
    pub fn new(read: () -> i64) -> Clock {
        Clock { read }
    }

    pub fn monotonic() -> Clock {
        let start = time::Instant::now();
        Clock::new(|| start.elapsed().as_milliseconds())
    }
}

pub struct Style {
    pub frames: Vec[string],
    pub fill: string,
    pub empty: string,
    pub bar_columns: isize,
    pub show_rate: bool,
    pub show_eta: bool,
    pub show_elapsed: bool,
    pub running: ansi::Style,
    pub finished: ansi::Style,
    pub failed: ansi::Style,
    pub cancelled: ansi::Style,
}

impl Style {
    pub fn defaults() -> Style {
        Style {
            frames: Vec::from_array(["|", "/", "-", "\\"]),
            fill: "=",
            empty: "-",
            bar_columns: 16,
            show_rate: true,
            show_eta: true,
            show_elapsed: false,
            running: ansi::Style::new().foreground(ansi::Color::Indexed(6)),
            finished: ansi::Style::new().foreground(ansi::Color::Indexed(2)),
            failed: ansi::Style::new().foreground(ansi::Color::Indexed(1)),
            cancelled: ansi::Style::new().foreground(ansi::Color::Indexed(3)),
        }
    }
}

pub struct Options {
    pub mode: Mode,
    pub profile: ansi::Profile,
    pub style: Style,
    pub clock: Clock,
    pub max_jobs: isize,
    pub max_message_bytes: isize,
    pub max_visible: isize,
    pub width: isize,
    pub follow_terminal_size: bool,
    pub refresh_ms: i64,
    pub spinner_ms: i64,
}

impl Options {
    pub fn defaults() -> Options {
        Options {
            mode: Mode::Auto,
            profile: ansi::Profile::TrueColor,
            style: Style::defaults(),
            clock: Clock::monotonic(),
            max_jobs: 128,
            max_message_bytes: 4096,
            max_visible: 20,
            width: 80,
            follow_terminal_size: true,
            refresh_ms: 100,
            spinner_ms: 100,
        }
    }
}

pub struct JobSnapshot {
    pub id: i64,
    pub name: string,
    pub message: string,
    pub position: i64,
    pub total: Option[i64],
    pub status: Status,
    pub elapsed_ms: i64,
    pub per_second: Option[f64],
    pub eta_ms: Option[i64],
    pub frame: i64,
}

pub struct Snapshot {
    pub jobs: Vec[JobSnapshot],
    pub now_ms: i64,
    pub closed: bool,
}

pub enum Update {
    Advance(i64),
    Position(i64),
    Total(i64),
    Message(string),
    Reset(Option[i64]),
    Finish(string),
    Fail(string),
    Cancel(string),
}

fn failure(kind: io::ErrorKind, message: string) -> Error {
    Error::new(kind, "progress", Option::None, Option::None, message)
}

fn invalid(message: string) -> Error {
    failure(io::ErrorKind::InvalidInput, message)
}

fn closed() -> Error {
    failure(io::ErrorKind::BrokenPipe, "manager is closed")
}

fn safe_text(value: string, limit: isize) -> Result[(), Error] {
    if value.byte_len() > limit {
        return Result::Err(invalid("text exceeds configured byte limit"))
    }
    for ch in value.chars() {
        let scalar = ch.to_u32();
        if scalar < 32 || scalar >= 127 && scalar <= 159 || scalar == 8232 || scalar == 8233 {
            return Result::Err(invalid("text must be one line without terminal controls"))
        }
    }
    Result::Ok(())
}

fn valid_total(total: Option[i64]) -> Result[(), Error] {
    if let Some(total) = total {
        if total < 0 || total > MAX_POSITION {
            return Result::Err(invalid("total is outside 0..MAX_POSITION"))
        }
    }
    Result::Ok(())
}
