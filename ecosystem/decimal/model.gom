package decimal;

use ecosystem::bigint::{BigInt};

#[derive(PartialEq, Eq, Debug)]
pub enum Error {
    InvalidSyntax(isize),
    LimitExceeded(string),
    InvalidPrecision,
    DivisionByZero,
    NonTerminating,
    Inexact,
    Overflow,
    InvalidEncoding,
    Integer(string),
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        match self {
            InvalidSyntax(index) => "invalid decimal syntax at byte " + index.to_string(),
            LimitExceeded(resource) => "decimal limit exceeded: " + resource,
            InvalidPrecision => "decimal precision must be between 1 and 4096",
            DivisionByZero => "decimal division by zero",
            NonTerminating => "decimal quotient has no finite representation",
            Inexact => "decimal conversion would discard nonzero digits",
            Overflow => "decimal coefficient or conversion overflow",
            InvalidEncoding => "invalid decimal encoding",
            Integer(message) => "decimal integer operation: " + message,
        }
    }
}

#[derive(PartialEq, Eq, Debug)]
pub enum Rounding {
    HalfEven,
    HalfUp,
    HalfDown,
    Up,
    Down,
    Ceiling,
    Floor,
}

pub struct Decimal {
    coefficient: BigInt,
    scale: isize,
}

#[derive(PartialEq, Eq, Debug)]
pub struct Context {
    precision: isize,
    rounding: Rounding,
}

pub struct Outcome {
    pub value: Decimal,
    pub rounded: bool,
    pub inexact: bool,
}

fn check_scale(scale: isize) -> Result[(), Error] {
    if scale < -4096 || scale > 4096 {
        Result::Err(Error::LimitExceeded("scale"))
    } else {
        Result::Ok(())
    }
}

fn digits(value: BigInt) -> isize {
    value.abs().to_string().byte_len()
}

fn power10(exponent: isize) -> Result[BigInt, Error] {
    if exponent < 0 || exponent > 12288 {
        return Result::Err(Error::LimitExceeded("intermediate exponent"))
    }
    BigInt::pow10(exponent.to_u64()).map_err(|error| Error::Integer(error.to_string()))
}

impl Decimal {
    pub fn new(coefficient: BigInt, scale: isize) -> Result[Decimal, Error] {
        check_scale(scale)?;
        if coefficient.bits() > 13607 || digits(coefficient) > 4096 {
            return Result::Err(Error::Overflow)
        }
        Result::Ok(Decimal { coefficient, scale })
    }

    pub fn zero() -> Decimal {
        Decimal { coefficient: BigInt::zero(), scale: 0 }
    }

    pub fn one() -> Decimal {
        Decimal::from_i64(1)
    }

    pub fn from_i64(value: i64) -> Decimal {
        Decimal { coefficient: BigInt::from_i64(value), scale: 0 }
    }

    pub fn from_u64(value: u64) -> Decimal {
        Decimal { coefficient: BigInt::from_u64(value), scale: 0 }
    }

    pub fn coefficient(self: Decimal) -> BigInt {
        self.coefficient
    }

    pub fn scale(self: Decimal) -> isize {
        self.scale
    }

    pub fn precision(self: Decimal) -> isize {
        digits(self.coefficient)
    }

    pub fn adjusted_exponent(self: Decimal) -> isize {
        self.precision() - self.scale - 1
    }

    pub fn is_zero(self: Decimal) -> bool {
        self.coefficient.is_zero()
    }

    pub fn is_negative(self: Decimal) -> bool {
        self.coefficient.is_negative()
    }

    pub fn signum(self: Decimal) -> i8 {
        self.coefficient.signum()
    }

    pub fn neg(self: Decimal) -> Decimal {
        Decimal { coefficient: self.coefficient.neg(), scale: self.scale }
    }

    pub fn abs(self: Decimal) -> Decimal {
        if self.is_negative() {
            self.neg()
        } else {
            self
        }
    }

    pub fn same_quantum(self: Decimal, other: Decimal) -> bool {
        self.scale == other.scale
    }

    pub fn same_representation(self: Decimal, other: Decimal) -> bool {
        self.scale == other.scale && self.coefficient == other.coefficient
    }
}

impl Context {
    pub fn new(precision: isize, rounding: Rounding) -> Result[Context, Error] {
        if precision < 1 || precision > 4096 {
            Result::Err(Error::InvalidPrecision)
        } else {
            Result::Ok(Context { precision, rounding })
        }
    }

    pub fn standard() -> Context {
        Context { precision: 28, rounding: Rounding::HalfEven }
    }

    pub fn precision(self: Context) -> isize {
        self.precision
    }

    pub fn rounding(self: Context) -> Rounding {
        self.rounding
    }
}
