package tests;

use ecosystem::decimal::{Decimal, Context, Rounding, Error};
use ecosystem::bigint::{BigInt};
use std::testing;

fn d(text: string) -> Decimal {
    testing::expect_ok(Decimal::parse(text), "parse decimal")
}

fn c(precision: isize, rounding: Rounding) -> Context {
    testing::expect_ok(Context::new(precision, rounding), "context")
}

fn same(actual: Decimal, expected: string) -> () {
    testing::assert(actual == d(expected));
}

#[test]
fn exact_parse_preserves_scale_sign_and_scientific_exponents() -> () {
    let value = d("-00123.4500e+2");
    testing::assert_eq(value.to_fixed(), "-12345.00");
    testing::assert_eq(value.to_scientific(), "-1.234500e+4");
    testing::assert_eq(value.scale(), 2);
    testing::assert_eq(value.coefficient().to_string(), "-1234500");
    same(d("+.125"), "0.125");
    same(d("12."), "12");
    same(d("12e-3"), ".012");
    let zero = d("-0.000");
    testing::assert(!zero.is_negative());
    testing::assert_eq(zero.scale(), 3);
    testing::assert_eq(zero.to_scientific(), "0e-3");
}

#[test]
fn malformed_and_nonfinite_input_is_recoverable() -> () {
    for text in Vec::from_array(
        [
            "",
            "+",
            "-",
            ".",
            "1..0",
            " 1",
            "1 ",
            "NaN",
            "Infinity",
            "-inf",
            "1e",
            "1e+",
            "1e--2",
            "1_000",
            "١",
            "1.2e3.4",
        ],
    ) {
        testing::assert_err(Decimal::parse(text));
    }
}

#[test]
fn arithmetic_is_exact_and_preserves_preferred_scale() -> () {
    let a = d("123456789012345678901234567890.1200");
    let b = d(".88");
    let sum = testing::expect_ok(a.add(b), "sum");
    testing::assert_eq(sum.to_fixed(), "123456789012345678901234567891.0000");
    let difference = testing::expect_ok(sum.sub(b), "difference");
    testing::assert(difference.same_representation(a));
    let product = testing::expect_ok(d("1.20").mul(d("3.0")), "product");
    testing::assert_eq(product.to_fixed(), "3.600");
    testing::assert_eq(product.scale(), 3);
    same(testing::expect_ok(d("1e4").add(d(".01")), "align"), "10000.01");
}

#[test]
fn all_rounding_modes_handle_signed_ties_and_non_ties() -> () {
    let modes = Vec::from_array(
        [
            Rounding::HalfEven,
            Rounding::HalfUp,
            Rounding::HalfDown,
            Rounding::Up,
            Rounding::Down,
            Rounding::Ceiling,
            Rounding::Floor,
        ],
    );
    let positive = Vec::from_array(["1.2", "1.3", "1.2", "1.3", "1.2", "1.3", "1.2"]);
    let negative = Vec::from_array(["-1.2", "-1.3", "-1.2", "-1.3", "-1.2", "-1.2", "-1.3"]);
    for index in 0..modes.len() {
        same(
            testing::expect_ok(d("1.25").rescale(1, modes[index]), "positive tie"),
            positive[index],
        );
        same(
            testing::expect_ok(d("-1.25").rescale(1, modes[index]), "negative tie"),
            negative[index],
        );
    }
    same(testing::expect_ok(d("1.35").rescale(1, Rounding::HalfEven), "odd tie"), "1.4");
    same(testing::expect_ok(d("1.251").rescale(1, Rounding::HalfDown), "above tie"), "1.3");
    same(testing::expect_ok(d("1.249").rescale(1, Rounding::HalfUp), "below tie"), "1.2");
    same(testing::expect_ok(d("-.0001").floor(), "floor"), "-1");
    same(testing::expect_ok(d("-.9999").ceil(), "ceiling"), "0");
}

#[test]
fn carry_obeys_significant_precision_and_quantize_requires_fixed_scale() -> () {
    let context = c(2, Rounding::HalfEven);
    let rounded = testing::expect_ok(context.round(d("9.95")), "round carry");
    testing::assert_eq(rounded.to_fixed(), "10");
    testing::assert_eq(rounded.precision(), 2);
    testing::assert_err(context.quantize(d("9.95"), 1));
    let exact = testing::expect_ok(d("9.95").rescale(1, Rounding::HalfEven), "unlimited rescale");
    testing::assert_eq(exact.to_fixed(), "10.0");
    testing::assert_eq(exact.precision(), 3);
    let negative = testing::expect_ok(c(1, Rounding::HalfUp).round(d("-9.9")), "negative carry");
    testing::assert_eq(negative.to_fixed(), "-10");
    testing::assert_eq(negative.precision(), 1);
    testing::assert_eq(negative.scale(), -1);
}

#[test]
fn contextual_arithmetic_rounds_once_after_exact_intermediate() -> () {
    let context = c(3, Rounding::HalfEven);
    same(testing::expect_ok(context.add(d("9999"), d("-9998.9")), "cancellation"), ".1");
    same(testing::expect_ok(context.mul(d("1.234"), d("5.678")), "multiply"), "7.01");
    same(testing::expect_ok(context.sub(d("1.234"), d(".0001")), "subtract"), "1.23");
    let exact = testing::expect_ok(d("1.234").add(d(".0001")), "exact sum");
    testing::assert_eq(exact.to_fixed(), "1.2341");
    same(testing::expect_ok(context.add(d("1.234"), d(".0001")), "context sum"), "1.23");
}

#[test]
fn flags_distinguish_discarded_zero_digits_from_inexact_rounding() -> () {
    let exact = testing::expect_ok(
        c(3, Rounding::HalfEven).round_status(d("1.2300")),
        "exact rounding",
    );
    testing::assert(exact.rounded && !exact.inexact);
    let inexact = testing::expect_ok(
        c(3, Rounding::HalfEven).round_status(d("1.2301")),
        "inexact rounding",
    );
    testing::assert(inexact.rounded && inexact.inexact);
    let expanded = testing::expect_ok(d("1.2").rescale_status(4, Rounding::Down), "expand");
    testing::assert(!expanded.rounded && !expanded.inexact);
    testing::assert_eq(expanded.value.to_fixed(), "1.2000");
}

#[test]
fn division_handles_recurring_values_ties_and_widely_different_exponents() -> () {
    let context = c(6, Rounding::HalfEven);
    same(testing::expect_ok(context.div(d("1"), d("3")), "third"), ".333333");
    same(testing::expect_ok(context.div(d("-1"), d("6")), "sixth"), "-.166667");
    same(testing::expect_ok(context.div(d("1e-30"), d("3e20")), "small quotient"), "3.33333e-51");
    same(testing::expect_ok(context.div(d("1e30"), d("3e-20")), "large quotient"), "3.33333e49");
    same(testing::expect_ok(c(1, Rounding::HalfEven).div(d("1"), d("4")), "even quotient"), ".2");
    same(testing::expect_ok(c(1, Rounding::HalfUp).div(d("1"), d("4")), "up quotient"), ".3");
    testing::assert_err(context.div(d("0"), d("0")));
    testing::assert_err(context.div(d("1"), d("0")));
    let status = testing::expect_ok(context.div_status(d("1"), d("3")), "flags");
    testing::assert(status.inexact && status.rounded);
    let status = testing::expect_ok(context.div_status(d("1"), d("8")), "exact flags");
    testing::assert(!status.inexact);
    let status = testing::expect_ok(
        c(1, Rounding::Down).div_status(d("10"), d("1")),
        "discarded exact zero",
    );
    testing::assert(status.rounded && !status.inexact);
    let status = testing::expect_ok(
        c(2, Rounding::HalfEven).div_status(d("1000"), d("1")),
        "division zeros",
    );
    testing::assert(status.rounded && !status.inexact);
    let status = testing::expect_ok(
        c(1, Rounding::HalfEven).div_status(d("1.00"), d("1")),
        "division input scale",
    );
    testing::assert(status.rounded && !status.inexact);
    let status = testing::expect_ok(
        c(1, Rounding::HalfEven).div_status(d("1.00"), d("1000")),
        "division below preferred exponent",
    );
    testing::assert(!status.rounded && !status.inexact);
    let status = testing::expect_ok(
        c(2, Rounding::HalfEven).quantize_status(d("0.000"), 0),
        "zero quantum",
    );
    testing::assert(!status.rounded && !status.inexact);
}

#[test]
fn concurrent_arithmetic_preserves_shared_decimal_values() -> () {
    let value = d("-123456789012345678901234567890.1200");
    let multiplier = d("123.45");
    let context = c(24, Rounding::HalfEven);
    let expected = testing::expect_ok(context.div(value, multiplier), "reference quotient");
    let done: Channel[bool] = Channel::new(12);
    for _ in 0..12 {
        go || {
            let mut valid = true;
            for _ in 0..40 {
                let product = testing::expect_ok(value.mul(multiplier), "concurrent product");
                let recovered = testing::expect_ok(
                    product.div_exact(multiplier),
                    "concurrent quotient",
                );
                let approximate = testing::expect_ok(
                    context.div(value, multiplier),
                    "concurrent context",
                );
                valid = valid && recovered == value && approximate == expected;
                let detached = value.coefficient().to_signed_bytes_be();
                detached[0] = 0;
                valid = valid && value.to_fixed() == "-123456789012345678901234567890.1200";
            }
            done.send(valid);
        };
    }
    for _ in 0..12 {
        testing::assert(testing::expect_some(done.recv(), "decimal worker"));
    }
}

#[test]
fn exact_division_reduces_common_factors_and_rejects_recurring_values() -> () {
    same(testing::expect_ok(d("12.00").div_exact(d("-.32")), "exact quotient"), "-37.5");
    same(testing::expect_ok(d("3").div_exact(d("6")), "cancel common prime"), ".5");
    same(testing::expect_ok(d("-1").div_exact(d("-128")), "power two"), ".0078125");
    same(testing::expect_ok(d("1").div_exact(d("625")), "power five"), ".0016");
    testing::assert_err(d("1").div_exact(d("3")));
    testing::assert_err(d("0").div_exact(d("0")));
}

#[test]
fn checked_conversions_distinguish_fraction_and_overflow() -> () {
    testing::assert_eq(
        testing::expect_ok(d("-9223372036854775808.00").to_i64(), "minimum"),
        -9223372036854775807 - 1,
    );
    testing::assert_eq(
        testing::expect_ok(d("18446744073709551615").to_u64(), "maximum"),
        18446744073709551615,
    );
    testing::assert_err(d("9223372036854775808").to_i64());
    testing::assert_err(d("18446744073709551616").to_u64());
    testing::assert_err(d("-1").to_u64());
    testing::assert_err(d("1.001").to_i64());
    testing::assert_err(d("1.001").rescale_exact(2));
    testing::assert_eq(testing::expect_ok(d("100.00").to_bigint(), "integer").to_string(), "100");
    same(testing::expect_ok(d("-1.999").trunc(), "truncate"), "-1");
}

#[test]
fn equality_hash_order_and_normalization_ignore_redundant_scale() -> () {
    let equivalents = Vec::from_array(["100", "100.00", "1e2", "10e1", "10000e-2"]);
    let map: HashMap[Decimal, string] = HashMap::new();
    map.set(d("1e2"), "hundred");
    for text in equivalents {
        let value = d(text);
        testing::assert(value == d("100"));
        testing::assert_eq(value.hash(), d("100").hash());
        testing::assert(map.get(value) == Option::Some("hundred"));
        testing::assert(value.normalize().same_representation(d("1e2")));
    }
    testing::assert(d("-0.00").hash() == Decimal::zero().hash());
    testing::assert(d("-100").cmp(d("-99.999")) == Ordering::Less);
    testing::assert(d(".00001").cmp(d("0")) == Ordering::Greater);
    testing::assert(d("1.0100").cmp(d("1.01001")) == Ordering::Less);
    testing::assert(!d("1.0").same_quantum(d("1.00")));
    testing::assert(!d("1.0").same_representation(d("1.00")));
}

#[test]
fn arithmetic_preserves_aliases_and_deterministic_invariants() -> () {
    let original = d("123.4500");
    let alias = original;
    let _ = original.normalize();
    let _ = testing::expect_ok(original.rescale(1, Rounding::Up), "rescale");
    testing::assert_eq(alias.to_fixed(), "123.4500");
    for a in -12..13 {
        for b in -8..9 {
            let left = testing::expect_ok(Decimal::new(BigInt::from_i64(a.to_i64()), 2), "left");
            let right = testing::expect_ok(Decimal::new(BigInt::from_i64(b.to_i64()), 1), "right");
            let sum = testing::expect_ok(left.add(right), "sum");
            testing::assert(testing::expect_ok(sum.sub(right), "inverse") == left);
            testing::assert(sum == testing::expect_ok(right.add(left), "commutative"));
            testing::assert(
                testing::expect_ok(left.mul(right), "product")
                    == testing::expect_ok(right.mul(left), "commutative product"),
            );
            testing::assert(left.cmp(right) == right.cmp(left).reverse());
        }
    }
}

#[test]
fn limits_reject_extreme_machine_values_before_allocation() -> () {
    let low: isize = -9223372036854775807 - 1;
    let high: isize = 9223372036854775807;
    for scale in Vec::from_array([low, high, -4097, 4097]) {
        testing::assert_err(Decimal::new(BigInt::one(), scale));
        testing::assert_err(d("1").rescale(scale, Rounding::Down));
        testing::assert_err(Context::standard().quantize(d("1"), scale));
    }
    for precision in Vec::from_array([low, high, -1, 0, 4097]) {
        testing::assert_err(Context::new(precision, Rounding::HalfEven));
    }
    for text in Vec::from_array(
        [
            "1e9223372036854775807",
            "1e-9223372036854775808",
            "1e9999999999999999999999999",
            "1e4097",
            "1e-4097",
        ],
    ) {
        testing::assert_err(Decimal::parse(text));
    }
    testing::assert_eq(d("1e4096").scale(), -4096);
    testing::assert_eq(d("1e-4096").scale(), 4096);
    testing::assert_err(d("1e4096").add(d("1e-4096")));
}

#[test]
fn coefficient_limits_apply_to_exact_results_and_context_can_reduce_them() -> () {
    let zeros: Vec[byte] = Vec::new();
    for _ in 0..4095 {
        zeros.push(57);
    }
    let text = "9" + string_from_utf8(zeros).1;
    let large = d(text);
    testing::assert_eq(large.precision(), 4096);
    testing::assert_err(Decimal::parse(text + "0"));
    testing::assert_err(large.add(Decimal::one()));
    testing::assert_err(large.mul(d("10")));
    let result = testing::expect_ok(
        c(10, Rounding::HalfEven).add(large, Decimal::one()),
        "reduce oversized intermediate",
    );
    testing::assert_eq(result.precision(), 10);
    testing::assert_eq(result.adjusted_exponent(), 4096);
    let result = testing::expect_ok(c(10, Rounding::HalfEven).mul(large, d("10")), "reduce product");
    testing::assert_eq(result.precision(), 10);
}
