package decimal;

use ecosystem::bigint::{BigInt};

fn zeros(count: isize) -> string {
    let bytes: Vec[byte] = Vec::with_capacity(count);
    for _ in 0..count {
        bytes.push(48);
    }
    string_from_utf8(bytes).1
}

impl Decimal {
    pub fn parse(text: string) -> Result[Decimal, Error] {
        if text.byte_len() > 8208 {
            return Result::Err(Error::LimitExceeded("input bytes"))
        }
        let mut index = 0;
        let negative = text.starts_with("-");
        if negative || text.starts_with("+") {
            index += 1;
        }
        let coefficient: Vec[byte] = Vec::new();
        let mut point = false;
        let mut scale = 0;
        while index < text.byte_len() {
            let ch = text.byte_get(index);
            if ch == 101 || ch == 69 {
                break;
            }
            if ch == 46 && !point {
                point = true;
            } else if ch >= 48 && ch <= 57 {
                coefficient.push(ch);
                if point {
                    scale += 1;
                }
            } else {
                return Result::Err(Error::InvalidSyntax(index))
            }
            index += 1;
        }
        if coefficient.is_empty() {
            return Result::Err(Error::InvalidSyntax(index))
        }
        if coefficient.len() > 4096 {
            return Result::Err(Error::LimitExceeded("input digits"))
        }
        if index < text.byte_len() {
            index += 1;
            let mut exponent_negative = false;
            if index < text.byte_len() && (text.byte_get(index) == 43 || text.byte_get(index) == 45) {
                exponent_negative = text.byte_get(index) == 45;
                index += 1;
            }
            let first = index;
            let mut exponent = 0;
            while index < text.byte_len() {
                let ch = text.byte_get(index);
                if ch < 48 || ch > 57 {
                    return Result::Err(Error::InvalidSyntax(index))
                }
                exponent = exponent * 10 + (ch - 48).to_isize();
                if exponent > 8192 {
                    return Result::Err(Error::LimitExceeded("input exponent"))
                }
                index += 1;
            }
            if first == index {
                return Result::Err(Error::InvalidSyntax(index))
            }
            scale = if exponent_negative {
                scale + exponent
            } else {
                scale - exponent
            };
        }
        let coefficient = BigInt::parse(string_from_utf8(coefficient).1).map_err(
            |error| Error::Integer(error.to_string()),
        )?;
        Decimal::new(
            if negative {
                coefficient.neg()
            } else {
                coefficient
            },
            scale,
        )
    }

    pub fn to_fixed(self: Decimal) -> string {
        let magnitude = self.coefficient.abs().to_string();
        let sign = if self.is_negative() {
            "-"
        } else {
            ""
        };
        if self.scale <= 0 {
            sign + magnitude + zeros(-self.scale)
        } else if self.scale >= magnitude.byte_len() {
            sign + "0." + zeros(self.scale - magnitude.byte_len()) + magnitude
        } else {
            let split = magnitude.byte_len() - self.scale;
            sign + magnitude.byte_slice(0, split) + "."
                + magnitude.byte_slice(split, magnitude.byte_len())
        }
    }

    pub fn to_scientific(self: Decimal) -> string {
        let magnitude = self.coefficient.abs().to_string();
        let sign = if self.is_negative() {
            "-"
        } else {
            ""
        };
        let mantissa = if magnitude.byte_len() > 1 {
            magnitude.byte_slice(0, 1) + "." + magnitude.byte_slice(1, magnitude.byte_len())
        } else {
            magnitude
        };
        let exponent = self.adjusted_exponent();
        sign + mantissa + "e"
            + if exponent >= 0 {
                "+"
            } else {
                ""
            }
            + exponent.to_string()
    }

    pub fn format_scale(self: Decimal, scale: isize, rounding: Rounding) -> Result[string, Error] {
        Result::Ok(self.rescale(scale, rounding)?.to_fixed())
    }
}

impl ToString for Decimal {
    fn to_string(self: Decimal) -> string {
        self.to_fixed()
    }
}
