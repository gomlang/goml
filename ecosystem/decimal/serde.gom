package decimal;

use ecosystem::bigint::{BigInt};
use std::serde::{Serialize, Deserialize, Serializer, Deserializer};

impl Serialize for Decimal {
    fn serialize[S: Serializer](self: Decimal, serializer: S) -> Result[(), string] {
        if serializer.is_human_readable() {
            serializer.serialize_string(self.to_scientific())
        } else {
            serializer.begin_tuple(2)?;
            serializer.begin_tuple_element(0)?;
            serializer.serialize_int32(self.scale.to_i32())?;
            serializer.begin_tuple_element(1)?;
            self.coefficient.serialize(serializer)?;
            serializer.end_tuple()
        }
    }
}

impl Deserialize for Decimal {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[Decimal, string] {
        if deserializer.is_human_readable() {
            let text = deserializer.deserialize_string()?;
            Decimal::parse(text).map_err(|error| deserializer.error(error.to_string()))
        } else {
            deserializer.begin_tuple(2)?;
            deserializer.begin_tuple_element(0)?;
            let scale = deserializer.deserialize_int32()?.to_isize();
            check_scale(scale).map_err(|error| deserializer.error(error.to_string()))?;
            deserializer.begin_tuple_element(1)?;
            let coefficient = BigInt::deserialize(deserializer)?;
            deserializer.end_tuple()?;
            Decimal::new(coefficient, scale).map_err(|error| deserializer.error(error.to_string()))
        }
    }
}
