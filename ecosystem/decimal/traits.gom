package decimal;

use std::cmp::{Ord, PartialOrd};

impl Decimal {
    pub fn cmp(self: Decimal, other: Decimal) -> Ordering {
        if self.signum() != other.signum() {
            return if self.signum() < other.signum() {
                Ordering::Less
            } else {
                Ordering::Greater
            }
        }
        if self.is_zero() {
            return Ordering::Equal
        }
        let left = self.coefficient.abs().to_string();
        let right = other.coefficient.abs().to_string();
        let mut order = Ordering::Equal;
        if self.adjusted_exponent() < other.adjusted_exponent() {
            order = Ordering::Less;
        } else if self.adjusted_exponent() > other.adjusted_exponent() {
            order = Ordering::Greater;
        } else {
            let length = if left.byte_len() > right.byte_len() {
                left.byte_len()
            } else {
                right.byte_len()
            };
            for index in 0..length {
                let a = if index < left.byte_len() {
                    left.byte_get(index)
                } else {
                    48
                };
                let b = if index < right.byte_len() {
                    right.byte_get(index)
                } else {
                    48
                };
                if a < b {
                    order = Ordering::Less;
                    break;
                }
                if a > b {
                    order = Ordering::Greater;
                    break;
                }
            }
        }
        if self.is_negative() {
            order.reverse()
        } else {
            order
        }
    }
}

impl PartialEq for Decimal {
    fn eq(self: Decimal, other: Decimal) -> bool {
        self.cmp(other) == Ordering::Equal
    }
}

impl Eq for Decimal {}

impl PartialOrd for Decimal {
    fn partial_cmp(self: Decimal, other: Decimal) -> Option[Ordering] {
        Option::Some(self.cmp(other))
    }
}

impl Ord for Decimal {
    fn cmp(self: Decimal, other: Decimal) -> Ordering {
        Decimal::cmp(self, other)
    }
}

impl Hash for Decimal {
    fn hash(self: Decimal) -> u64 {
        let value = self.normalize();
        value.coefficient.hash() ^ value.scale.to_i64().hash()
    }
}

impl Debug for Decimal {
    fn debug(self: Decimal) -> string {
        "Decimal(" + self.to_scientific() + ")"
    }
}

impl Default for Decimal {
    fn default() -> Decimal {
        Decimal::zero()
    }
}
