#[derive(PartialEq)]
pub enum SetCondition {
    Always,
    IfAbsent,
    IfPresent,
}

pub enum Expiration {
    None,
    Keep,
    Seconds(u64),
    Milliseconds(u64),
    AtSeconds(u64),
    AtMilliseconds(u64),
}

pub struct SetOptions {
    pub condition: SetCondition,
    pub expiration: Expiration,
}

impl SetOptions {
    pub fn standard() -> SetOptions {
        SetOptions { condition: SetCondition::Always, expiration: Expiration::None }
    }
}

fn set_arguments[K: ToArg, V: ToArg](key: K, value: V, options: SetOptions, previous: bool) -> Result[
    Vec[Vec[u8]],
    Error,
] {
    let args = Vec::from_array([key.to_arg(), value.to_arg()]);
    if options.condition == SetCondition::IfAbsent {
        args.push("NX".to_bytes());
    } else if options.condition == SetCondition::IfPresent {
        args.push("XX".to_bytes());
    }
    let expires = match options.expiration {
        Expiration::None => Option::None,
        Expiration::Keep => {
            args.push("KEEPTTL".to_bytes());
            Option::None
        },
        Expiration::Seconds(value) => Option::Some(("EX", value)),
        Expiration::Milliseconds(value) => Option::Some(("PX", value)),
        Expiration::AtSeconds(value) => Option::Some(("EXAT", value)),
        Expiration::AtMilliseconds(value) => Option::Some(("PXAT", value)),
    };
    if let Some((name, value)) = expires {
        if value == 0 || value > 9223372036854775807 {
            return Result::Err(invalid("SET expiration must be a positive signed 64-bit value"))
        }
        args.push(name.to_bytes());
        args.push(value.to_arg());
    }
    if previous {
        args.push("GET".to_bytes());
    }
    Result::Ok(args)
}

pub fn set[K: ToArg, V: ToArg](key: K, value: V, options: SetOptions) -> Result[
    Request[bool],
    Error,
] {
    let command = Command::new("SET", set_arguments(key, value, options, false)?)?;
    Result::Ok(
        Request::new(
            command,
            |value| {
                let value = value.checked()?;
                if value.is_null() {
                    Result::Ok(false)
                } else {
                    let _: () = FromReply::from_reply(value)?;
                    Result::Ok(true)
                }
            },
        ),
    )
}

pub fn set_get[K: ToArg, V: ToArg](key: K, value: V, options: SetOptions) -> Result[
    Request[Option[Blob]],
    Error,
] {
    redis::request("SET", set_arguments(key, value, options, true)?)
}

pub fn mset[K: ToArg, V: ToArg](values: Vec[(K, V)]) -> Result[Request[()], Error] {
    if values.is_empty() {
        return Result::Err(invalid("MSET requires at least one pair"))
    }
    let args = Vec::new();
    for (key, value) in values {
        args.push(key.to_arg());
        args.push(value.to_arg());
    }
    redis::request("MSET", args)
}

pub fn hset[K: ToArg, F: ToArg, V: ToArg](key: K, fields: Vec[(F, V)]) -> Result[
    Request[i64],
    Error,
] {
    if fields.is_empty() {
        return Result::Err(invalid("HSET requires at least one pair"))
    }
    let args = Vec::from_array([key.to_arg()]);
    for (field, value) in fields {
        args.push(field.to_arg());
        args.push(value.to_arg());
    }
    redis::request("HSET", args)
}

pub fn hincrby[K: ToArg, F: ToArg](key: K, field: F, amount: i64) -> Result[Request[i64], Error] {
    redis::request("HINCRBY", Vec::from_array([key.to_arg(), field.to_arg(), amount.to_arg()]))
}

pub fn lrange[K: ToArg](key: K, start: i64, end: i64) -> Result[Request[Vec[Blob]], Error] {
    redis::request("LRANGE", Vec::from_array([key.to_arg(), start.to_arg(), end.to_arg()]))
}

pub fn blpop[K: ToArg](keys: Vec[K], seconds: f64) -> Result[Request[Option[(Blob, Blob)]], Error] {
    if !math::is_finite(seconds) || seconds < 0.0 {
        return Result::Err(invalid("blocking timeout must be finite and nonnegative"))
    }
    let args = arguments(keys)?;
    args.push(seconds.to_arg());
    redis::request("BLPOP", args)
}

pub fn zadd[K: ToArg, V: ToArg](key: K, members: Vec[(f64, V)]) -> Result[Request[i64], Error] {
    if members.is_empty() {
        return Result::Err(invalid("ZADD requires members"))
    }
    let args = Vec::from_array([key.to_arg()]);
    for (score, member) in members {
        if math::is_nan(score) {
            return Result::Err(invalid("sorted-set score cannot be NaN"))
        }
        args.push(score.to_arg());
        args.push(member.to_arg());
    }
    redis::request("ZADD", args)
}

pub fn zrange[K: ToArg](key: K, start: i64, end: i64) -> Result[Request[ScoredMembers], Error] {
    redis::request(
        "ZRANGE",
        Vec::from_array([key.to_arg(), start.to_arg(), end.to_arg(), "WITHSCORES".to_bytes()]),
    )
}

pub fn zincrby[K: ToArg, M: ToArg](key: K, amount: f64, member: M) -> Result[Request[f64], Error] {
    if math::is_nan(amount) {
        return Result::Err(invalid("sorted-set increment cannot be NaN"))
    }
    redis::request("ZINCRBY", Vec::from_array([key.to_arg(), amount.to_arg(), member.to_arg()]))
}

fn scan_arguments(cursor: u64, pattern: Option[Blob], count: Option[isize]) -> Result[
    Vec[Vec[u8]],
    Error,
] {
    let args = Vec::from_array([cursor.to_arg()]);
    if let Some(pattern) = pattern {
        args.push("MATCH".to_bytes());
        args.push(pattern.to_arg());
    }
    if let Some(count) = count {
        if count <= 0 {
            return Result::Err(invalid("SCAN count must be positive"))
        }
        args.push("COUNT".to_bytes());
        args.push(count.to_arg());
    }
    Result::Ok(args)
}

pub fn scan(cursor: u64, pattern: Option[Blob], count: Option[isize]) -> Result[
    Request[(u64, Vec[Blob])],
    Error,
] {
    redis::request("SCAN", scan_arguments(cursor, pattern, count)?)
}

pub fn hscan[K: ToArg](key: K, cursor: u64, pattern: Option[Blob], count: Option[isize]) -> Result[
    Request[(u64, Entries[Blob, Blob])],
    Error,
] {
    let args = Vec::from_array([key.to_arg()]);
    args.extend(scan_arguments(cursor, pattern, count)?);
    redis::request("HSCAN", args)
}

pub fn sscan[K: ToArg](key: K, cursor: u64, pattern: Option[Blob], count: Option[isize]) -> Result[
    Request[(u64, Vec[Blob])],
    Error,
] {
    let args = Vec::from_array([key.to_arg()]);
    args.extend(scan_arguments(cursor, pattern, count)?);
    redis::request("SSCAN", args)
}

pub fn publish[C: ToArg, M: ToArg](channel: C, message: M) -> Result[Request[i64], Error] {
    redis::request("PUBLISH", Vec::from_array([channel.to_arg(), message.to_arg()]))
}

pub fn script_load(source: string) -> Result[Request[string], Error] {
    redis::request("SCRIPT", Vec::from_array(["LOAD".to_bytes(), source.to_bytes()]))
}

pub fn eval[T: FromReply, K: ToArg, A: ToArg](source: string, keys: Vec[K], arguments: Vec[A]) -> Result[
    Request[T],
    Error,
] {
    let args = Vec::from_array([source.to_bytes(), keys.len().to_arg()]);
    for key in keys {
        args.push(key.to_arg());
    }
    for argument in arguments {
        args.push(argument.to_arg());
    }
    redis::request("EVAL", args)
}

pub fn evalsha[T: FromReply, K: ToArg, A: ToArg](sha: string, keys: Vec[K], arguments: Vec[A]) -> Result[
    Request[T],
    Error,
] {
    let args = Vec::from_array([sha.to_bytes(), keys.len().to_arg()]);
    for key in keys {
        args.push(key.to_arg());
    }
    for argument in arguments {
        args.push(argument.to_arg());
    }
    redis::request("EVALSHA", args)
}
