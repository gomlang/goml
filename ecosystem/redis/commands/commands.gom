package commands;

use ecosystem::redis;
use ecosystem::redis::{Blob, Command, Entries, Error, ErrorKind, FromReply, Request, ScoredMembers, ToArg, Value};
use std::math;

fn invalid(message: string) -> Error {
    Error::new(ErrorKind::InvalidCommand, message)
}

fn arguments[T: ToArg](values: Vec[T]) -> Result[Vec[Vec[u8]], Error] {
    if values.is_empty() {
        return Result::Err(invalid("command requires at least one item"))
    }
    let result = Vec::new();
    for value in values {
        result.push(value.to_arg());
    }
    Result::Ok(result)
}

pub fn ping() -> Result[Request[string], Error] {
    redis::request("PING", Vec::new())
}

pub fn echo[A: ToArg](value: A) -> Result[Request[Blob], Error] {
    redis::request("ECHO", Vec::from_array([value.to_arg()]))
}

pub fn client_id() -> Result[Request[i64], Error] {
    redis::request("CLIENT", Vec::from_array(["ID".to_bytes()]))
}

