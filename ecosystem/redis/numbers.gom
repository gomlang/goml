package redis;

use std::math;

impl FromReply for i8 {
    fn from_reply(value: Value) -> Result[i8, Error] {
        let number: i64 = FromReply::from_reply(value)?;
        if number < -128 || number > 127 {
            return Result::Err(type_error("i8 range"))
        }
        Result::Ok(number.to_i8())
    }
}

impl FromReply for i16 {
    fn from_reply(value: Value) -> Result[i16, Error] {
        let number: i64 = FromReply::from_reply(value)?;
        if number < -32768 || number > 32767 {
            return Result::Err(type_error("i16 range"))
        }
        Result::Ok(number.to_i16())
    }
}

impl FromReply for i32 {
    fn from_reply(value: Value) -> Result[i32, Error] {
        let number: i64 = FromReply::from_reply(value)?;
        if number < -2147483648 || number > 2147483647 {
            return Result::Err(type_error("i32 range"))
        }
        Result::Ok(number.to_i32())
    }
}

impl FromReply for u8 {
    fn from_reply(value: Value) -> Result[u8, Error] {
        let number: u64 = FromReply::from_reply(value)?;
        if number > 255 {
            return Result::Err(type_error("u8 range"))
        }
        Result::Ok(number.to_u8())
    }
}

impl FromReply for u16 {
    fn from_reply(value: Value) -> Result[u16, Error] {
        let number: u64 = FromReply::from_reply(value)?;
        if number > 65535 {
            return Result::Err(type_error("u16 range"))
        }
        Result::Ok(number.to_u16())
    }
}

impl FromReply for u32 {
    fn from_reply(value: Value) -> Result[u32, Error] {
        let number: u64 = FromReply::from_reply(value)?;
        if number > 4294967295 {
            return Result::Err(type_error("u32 range"))
        }
        Result::Ok(number.to_u32())
    }
}

impl FromReply for usize {
    fn from_reply(value: Value) -> Result[usize, Error] {
        let number: u64 = FromReply::from_reply(value)?;
        if number > 18446744073709551615 {
            return Result::Err(type_error("usize range"))
        }
        Result::Ok(number.to_usize())
    }
}

impl FromReply for f32 {
    fn from_reply(value: Value) -> Result[f32, Error] {
        let number: f64 = FromReply::from_reply(value)?;
        let narrowed = number.to_f32();
        if math::is_finite(number) && !math::is_finite(narrowed.to_f64()) {
            return Result::Err(type_error("finite f32 range"))
        }
        Result::Ok(narrowed)
    }
}
