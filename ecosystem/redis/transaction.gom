package redis;

impl Connection {
    fn transaction_inner(self: Connection, pipeline: Pipeline, deadline: Deadline) -> Result[
        TransactionOutcome,
        Error,
    ] {
        let commands = pipeline.commands.copy();
        let _ = self.wire(commands, true)?;
        let start = self.one(single("MULTI", Vec::new()), deadline)?.checked()?;
        let accepted: Result[(), Error] = FromReply::from_reply(start);
        if let Err(problem) = accepted {
            return Result::Err(self.fatal(problem, false, Vec::new()))
        }
        let result = self.transaction_queued(pipeline, commands, deadline);
        if result.is_err() && !self.is_closed() {
            let _ = self.close();
        }
        result
    }

    fn transaction_queued(
        self: Connection,
        pipeline: Pipeline,
        commands: Vec[Command],
        deadline: Deadline,
    ) -> Result[TransactionOutcome, Error] {
        let replies = self.exchange(commands, true, deadline)?;
        let rejected = Vec::new();
        for index in 0..replies.len() {
            let reply = replies[index];
            if let Some(problem) = reply.server_error() {
                rejected.push((index, problem));
            } else {
                let queued: string = FromReply::from_reply(reply)?;
                if queued != "QUEUED" {
                    return Result::Err(
                        error(ErrorKind::Protocol, 0, "transaction command did not return QUEUED"),
                    )
                }
            }
        }
        if !rejected.is_empty() {
            let _: () = FromReply::from_reply(self.one(single("DISCARD", Vec::new()), deadline)?)?;
            return Result::Ok(TransactionOutcome::Rejected(rejected))
        }
        let result = self.one(single("EXEC", Vec::new()), deadline)?.checked()?;
        if result.is_null() {
            return Result::Ok(TransactionOutcome::Aborted)
        }
        let Value::Array(values) = result.without_attributes() else {
            return Result::Err(error(ErrorKind::Protocol, 0, "EXEC did not return an array"))
        };
        if values.len() != commands.len() {
            return Result::Err(
                error(ErrorKind::Protocol, 0, "EXEC reply count differs from queued command count"),
            )
        }
        Result::Ok(TransactionOutcome::Committed(Responses { values, owner: pipeline.owner }))
    }

    pub fn transaction(self: Connection, pipeline: Pipeline, operation: Operation) -> Result[
        TransactionOutcome,
        Error,
    ] {
        let deadline = Deadline::new(operation);
        defer deadline.stop();
        let _ = self.wire(pipeline.commands, true)?;
        deadline.acquire(self.gate, self.closed)?;
        defer self.gate.send(());
        self.ordinary()?;
        self.transaction_inner(pipeline, deadline)
    }

    pub fn compare_and_set(
        self: Connection,
        keys: Vec[Blob],
        reads: Pipeline,
        build: (Responses) -> Result[Pipeline, Error],
        operation: Operation,
    ) -> Result[TransactionOutcome, Error] {
        let deadline = Deadline::new(operation);
        defer deadline.stop();
        if keys.is_empty() {
            return Result::Err(
                error(ErrorKind::InvalidCommand, 0, "WATCH requires at least one key"),
            )
        }
        let _ = self.wire(reads.commands, true)?;
        let arguments = Vec::new();
        for key in keys {
            arguments.push(key.bytes.copy());
        }
        let watch = single("WATCH", arguments);
        let _ = watch.encode(self.options.limits)?;
        deadline.acquire(self.gate, self.closed)?;
        defer self.gate.send(());
        self.ordinary()?;
        let _: () = FromReply::from_reply(self.one(watch, deadline)?)?;
        let result = self.watched_plan(reads, build, deadline);
        if !self.is_closed() {
            match self.one(single("UNWATCH", Vec::new()), deadline) {
                Ok(value) => {
                    let cleanup: Result[(), Error] = FromReply::from_reply(value);
                    if let Err(problem) = cleanup {
                        return Result::Err(self.fatal(problem, false, Vec::new()))
                    }
                },
                Err(problem) => {
                    let _ = self.close();
                    return Result::Err(problem)
                },
            }
        }
        result
    }

    fn watched_plan(
        self: Connection,
        reads: Pipeline,
        build: (Responses) -> Result[Pipeline, Error],
        deadline: Deadline,
    ) -> Result[TransactionOutcome, Error] {
        let values = self.exchange(reads.commands, true, deadline)?;
        let plan = build(Responses { values, owner: reads.owner })?;
        self.transaction_inner(plan, deadline)
    }
}
