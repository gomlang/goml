package redis;

use std::io;
use std::net;

pub struct Transport {
    reader: (MutSlice[u8], Operation) -> Result[isize, io::Error],
    writer: (Slice[u8], Operation) -> Result[(), io::Error],
    closer: () -> Result[(), io::Error],
    closed: () -> bool,
}

impl Transport {
    pub fn new(
        read: (MutSlice[u8], Operation) -> Result[isize, io::Error],
        write_all: (Slice[u8], Operation) -> Result[(), io::Error],
        close: () -> Result[(), io::Error],
        is_closed: () -> bool,
    ) -> Transport {
        Transport { reader: read, writer: write_all, closer: close, closed: is_closed }
    }

    pub fn tcp(stream: net::TcpStream) -> Transport {
        Transport::new(
            |buffer, operation| stream.read_with(buffer, operation.wait_options()),
            |buffer, operation| stream.write_all_with(buffer, operation.wait_options()),
            || stream.close(),
            || stream.is_closed(),
        )
    }

    pub fn close(self: Transport) -> Result[(), io::Error] {
        (self.closer)()
    }

    pub fn is_closed(self: Transport) -> bool {
        (self.closed)()
    }

    fn read(self: Transport, buffer: MutSlice[u8], operation: Operation) -> Result[isize, Error] {
        let count = (self.reader)(buffer, operation).map_err(io_error)?;
        if count < 0 || count > buffer.len() {
            return Result::Err(error(ErrorKind::Io, 0, "transport returned an invalid read count"))
        }
        Result::Ok(count)
    }

    fn write_all(self: Transport, buffer: Slice[u8], operation: Operation) -> Result[(), Error] {
        (self.writer)(buffer, operation).map_err(io_error)
    }
}
