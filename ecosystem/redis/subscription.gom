package redis;

#[derive(Debug, PartialEq)]
pub enum SubscriptionKind {
    Channel,
    Pattern,
}

pub enum Event {
    Message(Blob, Blob, Option[Blob]),
    Changed(Option[Blob], SubscriptionKind, i64, bool),
    Pong(Option[Blob]),
    Other(Value),
}

pub fn event(value: Value) -> Result[Event, Error] {
    let value = value.checked()?;
    let items = match value.without_attributes() {
        Value::Array(items) | Value::Push(items) => items,
        _ => return Result::Ok(Event::Other(value)),
    };
    if items.is_empty() {
        return Result::Ok(Event::Other(value))
    }
    let name: string = FromReply::from_reply(items[0])?;
    match name {
        "message" => {
            if items.len() != 3 {
                return Result::Err(error(ErrorKind::Protocol, 0, "invalid message event"))
            }
            Result::Ok(
                Event::Message(
                    FromReply::from_reply(items[1])?,
                    FromReply::from_reply(items[2])?,
                    Option::None,
                ),
            )
        },
        "pmessage" => {
            if items.len() != 4 {
                return Result::Err(error(ErrorKind::Protocol, 0, "invalid pattern message event"))
            }
            Result::Ok(
                Event::Message(
                    FromReply::from_reply(items[2])?,
                    FromReply::from_reply(items[3])?,
                    Option::Some(FromReply::from_reply(items[1])?),
                ),
            )
        },
        "subscribe" | "psubscribe" | "unsubscribe" | "punsubscribe" => {
            if items.len() != 3 {
                return Result::Err(
                    error(ErrorKind::Protocol, 0, "invalid subscription acknowledgement"),
                )
            }
            let count: i64 = FromReply::from_reply(items[2])?;
            if count < 0 {
                return Result::Err(error(ErrorKind::Protocol, 0, "negative subscription count"))
            }
            let kind = if name == "psubscribe" || name == "punsubscribe" {
                SubscriptionKind::Pattern
            } else {
                SubscriptionKind::Channel
            };
            Result::Ok(
                Event::Changed(
                    FromReply::from_reply(items[1])?,
                    kind,
                    count,
                    name == "subscribe" || name == "psubscribe",
                ),
            )
        },
        "pong" => {
            if items.len() != 2 {
                return Result::Err(error(ErrorKind::Protocol, 0, "invalid subscription pong"))
            }
            Result::Ok(Event::Pong(FromReply::from_reply(items[1])?))
        },
        _ => Result::Ok(Event::Other(value)),
    }
}

pub struct Subscription {
    connection: Connection,
}

impl Connection {
    pub fn subscribe(
        self: Connection,
        channels: Vec[Blob],
        kind: SubscriptionKind,
        operation: Operation,
    ) -> Result[Subscription, Error] {
        let subscription = Subscription { connection: self };
        let _ = subscription.change(channels, kind, true, operation)?;
        Result::Ok(subscription)
    }
}

impl Subscription {
    pub fn change(
        self: Subscription,
        channels: Vec[Blob],
        kind: SubscriptionKind,
        subscribe: bool,
        operation: Operation,
    ) -> Result[Vec[Event], Error] {
        let connection = self.connection;
        let deadline = Deadline::new(operation);
        defer deadline.stop();
        if channels.is_empty() || channels.len() > connection.options.limits.max_batch {
            return Result::Err(
                error(
                    ErrorKind::InvalidCommand,
                    0,
                    "subscription change requires a nonempty bounded channel list",
                ),
            )
        }
        let names = Vec::new();
        for channel in channels {
            names.push(channel.bytes.copy());
        }
        let command = match (kind, subscribe) {
            (SubscriptionKind::Channel, true) => "SUBSCRIBE",
            (SubscriptionKind::Channel, false) => "UNSUBSCRIBE",
            (SubscriptionKind::Pattern, true) => "PSUBSCRIBE",
            (SubscriptionKind::Pattern, false) => "PUNSUBSCRIBE",
        };
        let bytes = single(command, names).encode(connection.options.limits)?;
        deadline.acquire(connection.gate, connection.closed)?;
        defer connection.gate.send(());
        connection.open()?;
        connection.write(bytes.as_slice(), deadline)?;
        let result = self.acknowledgements(names, kind, subscribe, deadline);
        match result {
            Ok(events) => Result::Ok(events),
            Err(problem) => Result::Err(connection.fatal(problem, true, Vec::new())),
        }
    }

    fn acknowledgements(
        self: Subscription,
        names: Vec[Vec[u8]],
        kind: SubscriptionKind,
        subscribe: bool,
        deadline: Deadline,
    ) -> Result[Vec[Event], Error] {
        let connection = self.connection;
        let events = Vec::new();
        let mut received = 0;
        while events.len() < names.len() {
            let frame = connection.frame(deadline)?;
            if frame.wire_bytes > connection.options.limits.max_batch_reply_bytes - received {
                return Result::Err(
                    error(ErrorKind::Limit, 0, "subscription reply byte limit exceeded"),
                )
            }
            received += frame.wire_bytes;
            let parsed = event(frame.value)?;
            if let Event::Changed(channel, actual, count, added) = parsed {
                let channel = channel.ok_or(
                    error(ErrorKind::Protocol, 0, "missing subscription channel"),
                )?;
                if actual != kind || added != subscribe || channel.bytes != names[events.len()] {
                    return Result::Err(
                        error(ErrorKind::Protocol, 0, "unexpected subscription acknowledgement"),
                    )
                }
                connection.subscription_count.set(count);
                connection.subscribed.set(count > 0);
                events.push(parsed);
            } else {
                connection.stash(frame)?;
            }
        }
        Result::Ok(events)
    }

    pub fn count(self: Subscription, operation: Operation) -> Result[i64, Error] {
        let deadline = Deadline::new(operation);
        defer deadline.stop();
        deadline.acquire(self.connection.gate, self.connection.closed)?;
        defer self.connection.gate.send(());
        self.connection.open()?;
        Result::Ok(self.connection.subscription_count.get())
    }

    pub fn next(self: Subscription, operation: Operation) -> Result[Event, Error] {
        let connection = self.connection;
        let deadline = Deadline::new(operation);
        defer deadline.stop();
        deadline.acquire(connection.gate, connection.closed)?;
        defer connection.gate.send(());
        connection.open()?;
        if !connection.pushes.is_empty() {
            let frame = connection.pushes.remove(0);
            connection.push_bytes.set(connection.push_bytes.get() - frame.wire_bytes);
            return event(frame.value)
        }
        if !connection.subscribed.get() {
            return Result::Err(
                error(ErrorKind::InvalidCommand, 0, "connection has no subscriptions"),
            )
        }
        let result = connection.frame(deadline).and_then(|frame| event(frame.value));
        match result {
            Ok(value) => Result::Ok(value),
            Err(problem) => if problem.kind == ErrorKind::Timeout
                || problem.kind == ErrorKind::Cancelled {
                Result::Err(problem)
            } else {
                Result::Err(connection.fatal(problem, false, Vec::new()))
            },
        }
    }

    pub fn close(self: Subscription) -> Result[(), Error] {
        self.connection.close()
    }
}
