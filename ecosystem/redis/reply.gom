package redis;

use std::num;

pub trait FromReply {
    fn from_reply(value: Value) -> Result[Self, Error];
}

fn type_error(expected: string) -> Error {
    error(ErrorKind::Type, 0, "expected Redis " + expected + " reply")
}

impl FromReply for Value {
    fn from_reply(value: Value) -> Result[Value, Error] {
        value.checked()
    }
}

impl FromReply for Blob {
    fn from_reply(value: Value) -> Result[Blob, Error] {
        match value.checked()?.without_attributes() {
            Value::Simple(bytes) | Value::Bulk(bytes) | Value::Verbatim(_, bytes) => Result::Ok(
                Blob { bytes },
            ),
            _ => Result::Err(type_error("string")),
        }
    }
}

impl FromReply for string {
    fn from_reply(value: Value) -> Result[string, Error] {
        let blob: Blob = FromReply::from_reply(value)?;
        blob.text()
    }
}

impl FromReply for () {
    fn from_reply(value: Value) -> Result[(), Error] {
        let blob: Blob = FromReply::from_reply(value)?;
        if blob.bytes == "OK".to_bytes() {
            Result::Ok(())
        } else {
            Result::Err(type_error("OK status"))
        }
    }
}

impl FromReply for i64 {
    fn from_reply(value: Value) -> Result[i64, Error] {
        match value.checked()?.without_attributes() {
            Value::Integer(value) => Result::Ok(value),
            _ => Result::Err(type_error("integer")),
        }
    }
}

impl FromReply for isize {
    fn from_reply(value: Value) -> Result[isize, Error] {
        let result: i64 = FromReply::from_reply(value)?;
        Result::Ok(result.to_isize())
    }
}

impl FromReply for u64 {
    fn from_reply(value: Value) -> Result[u64, Error] {
        match value.checked()?.without_attributes() {
            Value::Integer(value) => if value >= 0 {
                Result::Ok(value.to_u64())
            } else {
                Result::Err(type_error("nonnegative integer"))
            },
            Value::Simple(bytes) | Value::Bulk(bytes) => {
                let text = Blob { bytes }.text()?;
                if !decimal(text, false) {
                    return Result::Err(type_error("unsigned decimal"))
                }
                num::parse_uint_structured(text).map(|number| number.to_u64()).map_err(
                    |_| type_error("unsigned 64-bit integer"),
                )
            },
            _ => Result::Err(type_error("unsigned integer")),
        }
    }
}

impl FromReply for f64 {
    fn from_reply(value: Value) -> Result[f64, Error] {
        match value.checked()?.without_attributes() {
            Value::Double(value) => Result::Ok(value),
            Value::Simple(bytes) | Value::Bulk(bytes) => double_line(Blob { bytes }.text()?, 0).map_err(
                |problem| Error { kind: ErrorKind::Type, ..problem },
            ),
            _ => Result::Err(type_error("double")),
        }
    }
}

impl FromReply for bool {
    fn from_reply(value: Value) -> Result[bool, Error] {
        match value.checked()?.without_attributes() {
            Value::Boolean(value) => Result::Ok(value),
            Value::Integer(0) => Result::Ok(false),
            Value::Integer(1) => Result::Ok(true),
            _ => Result::Err(type_error("boolean or 0/1 integer")),
        }
    }
}

impl[T: FromReply] FromReply for Option[T] {
    fn from_reply(value: Value) -> Result[Option[T], Error] {
        let value = value.checked()?;
        if value.is_null() {
            Result::Ok(Option::None)
        } else {
            Result::Ok(Option::Some(FromReply::from_reply(value)?))
        }
    }
}

impl[T: FromReply] FromReply for Vec[T] {
    fn from_reply(value: Value) -> Result[Vec[T], Error] {
        let items = match value.checked()?.without_attributes() {
            Value::Array(items) | Value::Set(items) => items,
            _ => return Result::Err(type_error("array or set")),
        };
        let result: Vec[T] = Vec::with_capacity(items.len());
        for item in items {
            result.push(FromReply::from_reply(item)?);
        }
        Result::Ok(result)
    }
}

impl[A: FromReply, B: FromReply] FromReply for (A, B) {
    fn from_reply(value: Value) -> Result[(A, B), Error] {
        let Value::Array(items) = value.checked()?.without_attributes() else {
            return Result::Err(type_error("two-element array"))
        };
        if items.len() != 2 {
            return Result::Err(type_error("two-element array"))
        }
        Result::Ok((FromReply::from_reply(items[0])?, FromReply::from_reply(items[1])?))
    }
}

pub struct Entries[K, V] {
    pub entries: Vec[(K, V)],
}

impl[K: FromReply, V: FromReply] FromReply for Entries[K, V] {
    fn from_reply(value: Value) -> Result[Entries[K, V], Error] {
        let fields = match value.checked()?.without_attributes() {
            Value::Map(fields) => fields,
            Value::Array(values) => {
                if values.len() % 2 != 0 {
                    return Result::Err(type_error("alternating key/value array"))
                }
                pairs(values, values.len() / 2)
            },
            _ => return Result::Err(type_error("map")),
        };
        let entries: Vec[(K, V)] = Vec::with_capacity(fields.len());
        for (key, value) in fields {
            entries.push((FromReply::from_reply(key)?, FromReply::from_reply(value)?));
        }
        Result::Ok(Entries { entries })
    }
}

pub struct ScoredMembers {
    pub entries: Vec[(Blob, f64)],
}

impl FromReply for ScoredMembers {
    fn from_reply(value: Value) -> Result[ScoredMembers, Error] {
        let Value::Array(values) = value.checked()?.without_attributes() else {
            return Result::Err(type_error("sorted-set array"))
        };
        let entries: Vec[(Blob, f64)] = Vec::new();
        if !values.is_empty() {
            if let Value::Array(_) = values[0].without_attributes() {
                for value in values {
                    entries.push(FromReply::from_reply(value)?);
                }
                return Result::Ok(ScoredMembers { entries })
            }
        }
        if values.len() % 2 != 0 {
            return Result::Err(type_error("member/score pairs"))
        }
        for index in 0..values.len() / 2 {
            entries.push(
                (
                    FromReply::from_reply(values[index * 2])?,
                    FromReply::from_reply(values[index * 2 + 1])?,
                ),
            );
        }
        Result::Ok(ScoredMembers { entries })
    }
}
