package redis;

use std::io;
use std::utf8;

#[derive(Debug, PartialEq)]
pub enum ErrorKind {
    Protocol,
    Limit,
    UnexpectedEof,
    TrailingData,
    InvalidCommand,
    Type,
    Server,
    Io,
    Timeout,
    Cancelled,
    Closed,
    WrongPipeline,
}

pub struct Error {
    pub kind: ErrorKind,
    pub message: string,
    pub offset: isize,
    pub server: Option[ServerError],
    pub io_kind: Option[io::ErrorKind],
    pub may_have_executed: bool,
    pub partial: Vec[Value],
    pub index: Option[isize],
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        if let Some(index) = self.index {
            f"command {index}: {self.message}"
        } else {
            self.message
        }
    }
}

impl Debug for Error {
    fn debug(self: Error) -> string {
        self.to_string()
    }
}

fn error(kind: ErrorKind, offset: isize, message: string) -> Error {
    Error {
        kind,
        message,
        offset,
        server: Option::None,
        io_kind: Option::None,
        may_have_executed: false,
        partial: Vec::new(),
        index: Option::None,
    }
}

pub struct ServerError {
    pub data: Vec[u8],
}

impl ServerError {
    pub fn code(self: ServerError) -> string {
        let mut end = 0;
        while end < self.data.len() && self.data[end] != 32 {
            end += 1;
        }
        utf8::decode_slice(self.data.slice(0, end)).unwrap_or("ERR")
    }

    pub fn text(self: ServerError) -> Result[string, Error] {
        utf8::decode_slice(self.data.as_slice()).map_err(
            |_| error(ErrorKind::Type, 0, "server error contains non-UTF-8 bytes"),
        )
    }

    fn as_error(self: ServerError) -> Error {
        Error {
            server: Option::Some(self),
            ..error(ErrorKind::Server, 0, self.text().unwrap_or("binary server error")),
        }
    }
}

pub enum Value {
    Simple(Vec[u8]),
    SimpleError(Vec[u8]),
    Integer(i64),
    Bulk(Vec[u8]),
    NullBulk,
    Array(Vec[Value]),
    NullArray,
    Null,
    Boolean(bool),
    Double(f64),
    BigNumber(string),
    BlobError(Vec[u8]),
    Verbatim(string, Vec[u8]),
    Map(Vec[(Value, Value)]),
    Attribute(Vec[(Value, Value)], Value),
    Set(Vec[Value]),
    Push(Vec[Value]),
}

impl Value {
    pub fn without_attributes(self: Value) -> Value {
        let mut value = self;
        while let Value::Attribute(_, inner) = value {
            value = inner;
        }
        value
    }

    pub fn is_null(self: Value) -> bool {
        match self.without_attributes() {
            Value::Null | Value::NullBulk | Value::NullArray => true,
            _ => false,
        }
    }

    pub fn is_push(self: Value) -> bool {
        match self.without_attributes() {
            Value::Push(_) => true,
            _ => false,
        }
    }

    pub fn server_error(self: Value) -> Option[ServerError] {
        match self.without_attributes() {
            Value::SimpleError(data) | Value::BlobError(data) => Option::Some(ServerError { data }),
            _ => Option::None,
        }
    }

    pub fn checked(self: Value) -> Result[Value, Error] {
        match self.server_error() {
            Some(value) => Result::Err(value.as_error()),
            None => Result::Ok(self),
        }
    }
}

pub struct Limits {
    pub max_frame_bytes: isize,
    pub max_buffer_bytes: isize,
    pub max_blob_bytes: isize,
    pub max_line_bytes: isize,
    pub max_elements: isize,
    pub max_values: isize,
    pub max_depth: isize,
    pub max_batch: isize,
    pub max_batch_reply_bytes: isize,
    pub max_pushes: isize,
    pub max_push_bytes: isize,
}

impl Limits {
    pub fn standard() -> Limits {
        Limits {
            max_frame_bytes: 16777216,
            max_buffer_bytes: 16777216,
            max_blob_bytes: 16777216,
            max_line_bytes: 65536,
            max_elements: 1000000,
            max_values: 2000000,
            max_depth: 128,
            max_batch: 1024,
            max_batch_reply_bytes: 67108864,
            max_pushes: 128,
            max_push_bytes: 16777216,
        }
    }

    fn validate(self: Limits) -> Result[(), Error] {
        if self.max_elements > 4611686018427387903 || self.max_frame_bytes < 0
            || self.max_buffer_bytes < 0
            || self.max_blob_bytes < 0
            || self.max_line_bytes < 0
            || self.max_elements < 0
            || self.max_values < 0
            || self.max_depth < 0
            || self.max_batch < 0
            || self.max_batch_reply_bytes < 0
            || self.max_pushes < 0
            || self.max_push_bytes < 0 {
            Result::Err(error(ErrorKind::Limit, 0, "limits must be nonnegative"))
        } else {
            Result::Ok(())
        }
    }
}

pub struct Decoded {
    pub value: Value,
    pub wire_bytes: isize,
}

pub struct Blob {
    pub bytes: Vec[u8],
}

impl Blob {
    pub fn new(bytes: Slice[u8]) -> Blob {
        Blob { bytes: bytes.to_vec() }
    }

    pub fn from_string(value: string) -> Blob {
        Blob { bytes: value.to_bytes() }
    }

    pub fn text(self: Blob) -> Result[string, Error] {
        utf8::decode_slice(self.bytes.as_slice()).map_err(
            |_| error(ErrorKind::Type, 0, "reply contains non-UTF-8 bytes"),
        )
    }
}

impl PartialEq for Blob {
    fn eq(self: Blob, other: Blob) -> bool {
        self.bytes == other.bytes
    }
}

impl Error {
    pub fn new(kind: ErrorKind, message: string) -> Error {
        error(kind, 0, message)
    }
}
