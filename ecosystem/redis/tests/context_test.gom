package tests;

use ecosystem::redis;
use std::context;
use std::net::tls;
use std::testing;
use std::time;

#[test]
fn cancelled_and_expired_contexts_prevent_dns_and_tls_setup() -> () {
    context::with_cancel(
        context::Context::background(),
        |ctx, cancel| {
            cancel.cancel();
            let operation = redis::Operation::new().without_timeout().with_context(ctx);
            let plain = redis::Connection::connect_host(
                "unused.invalid",
                6379,
                redis::ConnectionOptions::standard(),
                operation,
            );
            testing::assert_eq(
                testing::expect_err(plain, "cancelled DNS").kind,
                redis::ErrorKind::Cancelled,
            );
            let secure = redis::Connection::connect_tls(
                "unused.invalid",
                6379,
                tls::ClientConfig::new("unused.invalid"),
                redis::ConnectionOptions::standard(),
                operation,
            );
            testing::assert_eq(
                testing::expect_err(secure, "cancelled TLS").kind,
                redis::ErrorKind::Cancelled,
            );
        },
    );
    context::with_timeout(
        context::Context::background(),
        time::Duration::zero(),
        |ctx, _| {
            let result = redis::Connection::connect_host(
                "unused.invalid",
                6379,
                redis::ConnectionOptions::standard(),
                redis::Operation::new().without_timeout().with_context(ctx),
            );
            testing::assert_eq(
                testing::expect_err(result, "expired DNS").kind,
                redis::ErrorKind::Timeout,
            );
        },
    );
}
