package tests;

use ecosystem::redis;
use ecosystem::redis::{Value, Limits, ErrorKind, Decoder, FromReply, Blob, Entries, ScoredMembers, Command};
use ecosystem::redis::commands;
use std::testing;
use std::math;

fn parse(source: string) -> Value {
    testing::expect_ok(redis::decode(source.to_bytes().as_slice()), source)
}

fn wire(value: Value) -> Vec[u8] {
    testing::expect_ok(redis::encode(value), "encode")
}

#[test]
fn resp_types_spec_bytes_all_fragments_and_truncations() -> () {
    let sources = Vec::from_array(
        [
            "+OK\r\n",
            "-ERR failure\r\n",
            ":-9223372036854775808\r\n",
            ":9223372036854775807\r\n",
            "$0\r\n\r\n",
            "$-1\r\n",
            "*-1\r\n",
            "_\r\n",
            "#t\r\n",
            "#f\r\n",
            ",1.25\r\n",
            ",inf\r\n",
            ",-inf\r\n",
            ",nan\r\n",
            "(3492890328409238509324850943850943825024385\r\n",
            "!8\r\nERR\r\nx\ny\r\n",
            "=9\r\ntxt:hello\r\n",
            "*0\r\n",
            "~2\r\n:1\r\n:2\r\n",
            "%2\r\n*0\r\n:1\r\n_\r\n#f\r\n",
            "|1\r\n+ttl\r\n:10\r\n|0\r\n$3\r\nabc\r\n",
            ">2\r\n+invalidate\r\n*1\r\n+k\r\n",
        ],
    );
    let fixtures = Vec::new();
    for source in sources {
        fixtures.push((source, source));
    }
    fixtures.push((":+0042\r\n", ":42\r\n"));
    fixtures.push(("$?\r\n;3\r\nabc\r\n;2\r\nde\r\n;0\r\n", "$5\r\nabcde\r\n"));
    fixtures.push(("*?\r\n:1\r\n~?\r\n+yes\r\n.\r\n.\r\n", "*2\r\n:1\r\n~1\r\n+yes\r\n"));
    fixtures.push(("%?\r\n+k\r\n$?\r\n;0\r\n.\r\n", "%1\r\n+k\r\n$0\r\n\r\n"));
    for (source, canonical) in fixtures {
        let data = source.to_bytes();
        testing::assert(wire(parse(source)) == canonical.to_bytes());
        for chunk in 1..data.len() + 1 {
            let decoder = testing::expect_ok(Decoder::new(Limits::standard()), "decoder");
            let values = Vec::new();
            let mut start = 0;
            while start < data.len() {
                let end = if chunk > data.len() - start {
                    data.len()
                } else {
                    start + chunk
                };
                testing::assert_ok(decoder.feed(data.slice(start, end)));
                while let Some(frame) = testing::expect_ok(decoder.next_frame(), source) {
                    testing::assert_eq(frame.wire_bytes, data.len());
                    values.push(wire(frame.value));
                }
                start = end;
            }
            testing::assert_eq(values.len(), 1);
            testing::assert(values[0] == canonical.to_bytes());
            testing::assert_ok(decoder.finish());
        }
        for end in 0..data.len() {
            testing::assert_err(redis::decode(data.slice(0, end)));
        }
    }
}

#[test]
fn binary_numeric_bits_and_typed_replies() -> () {
    let bytes: Vec[u8] = Vec::from_array([0, 255, 13, 10, 237, 160, 128]);
    let blob: Blob = testing::expect_ok(
        FromReply::from_reply(
            testing::expect_ok(redis::decode(wire(Value::Bulk(bytes)).as_slice()), "binary"),
        ),
        "blob",
    );
    testing::assert(blob.bytes == bytes);
    testing::assert_err(blob.text());
    let Value::Double(zero) = parse(",-0\r\n") else {
        testing::fail("double");
        return
    };
    testing::assert_eq(zero.to_bits(), 9223372036854775808);
    let Value::Double(nan) = parse(",nan\r\n") else {
        testing::fail("double");
        return
    };
    testing::assert(math::is_nan(nan));
    let cursor: u64 = testing::expect_ok(
        FromReply::from_reply(parse("$20\r\n18446744073709551615\r\n")),
        "cursor",
    );
    testing::assert_eq(cursor, 18446744073709551615);
    for source in Vec::from_array(["$-1\r\n", "*-1\r\n", "_\r\n", "|0\r\n_\r\n"]) {
        let value: Option[Blob] = testing::expect_ok(FromReply::from_reply(parse(source)), "null");
        testing::assert(value.is_none());
    }
    let entries: Entries[string, i64] = testing::expect_ok(
        FromReply::from_reply(parse("%2\r\n+a\r\n:1\r\n+a\r\n:2\r\n")),
        "map",
    );
    testing::assert(entries.entries == Vec::from_array([("a", 1), ("a", 2)]));
    for source in Vec::from_array(["*2\r\n+a\r\n$3\r\n1.5\r\n", "*1\r\n*2\r\n+a\r\n,1.5\r\n"]) {
        let scores: ScoredMembers = testing::expect_ok(
            FromReply::from_reply(parse(source)),
            "scores",
        );
        testing::assert_eq(scores.entries[0].1, 1.5);
    }
    let server = testing::expect_err(parse("|0\r\n-WRONGTYPE wrong\r\n").checked(), "server error");
    testing::assert_eq(server.kind, ErrorKind::Server);
    testing::assert_eq(testing::expect_some(server.server, "detail").code(), "WRONGTYPE");
    let wrong: Result[bool, redis::Error] = FromReply::from_reply(Value::Integer(2));
    testing::assert_eq(testing::expect_err(wrong, "strict boolean").kind, ErrorKind::Type);
}

#[test]
fn malformed_lengths_controls_streams_and_trailing_bytes() -> () {
    for source in Vec::from_array(
        [
            "?\r\n",
            "+x\n",
            "+x\rX",
            ":\r\n",
            ":1_0\r\n",
            ":9223372036854775808\r\n",
            ":-9223372036854775809\r\n",
            "$-2\r\n",
            "$+1\r\nx\r\n",
            "$1\r\nx\n\r",
            "*-2\r\n",
            "_x\r\n",
            "#yes\r\n",
            ",1e\r\n",
            ",0x1p2\r\n",
            ",1e9999\r\n",
            "(x\r\n",
            "=3\r\ntxt\r\n",
            "=4\r\ntxtx\r\n",
            ">0\r\n",
            ">1\r\n:1\r\n",
            ";0\r\n",
            ".\r\n",
            "*1\r\n.\r\n",
            "%?\r\n+x\r\n.\r\n",
            "|?\r\n",
            ">?\r\n",
            "$?\r\n+x\r\n",
            "$?\r\n;-1\r\n",
            "$?\r\n;1\r\nx!!",
        ],
    ) {
        testing::assert_err(redis::decode(source.to_bytes().as_slice()));
    }
    testing::assert_eq(
        testing::expect_err(redis::decode("+OK\r\n:1\r\n".to_bytes().as_slice()), "trailing").kind,
        ErrorKind::TrailingData,
    );
    testing::assert_eq(
        testing::expect_ok(
            redis::decode_prefix("+OK\r\n?".to_bytes().as_slice(), Limits::standard()),
            "prefix",
        ).wire_bytes,
        5,
    );
}

#[test]
fn bounded_incremental_payload_poison_reset_and_cycles() -> () {
    let nested = parse("*1\r\n*1\r\n$4\r\ndata\r\n");
    for limits in Vec::from_array(
        [
            Limits { max_frame_bytes: 5, ..Limits::standard() },
            Limits { max_blob_bytes: 3, ..Limits::standard() },
            Limits { max_elements: 0, ..Limits::standard() },
            Limits { max_values: 2, ..Limits::standard() },
            Limits { max_depth: 1, ..Limits::standard() },
        ],
    ) {
        testing::assert_err(redis::encode_with_limits(nested, limits));
        testing::assert_err(redis::decode_with_limits(wire(nested).as_slice(), limits));
    }
    let decoder = testing::expect_ok(
        Decoder::new(Limits { max_buffer_bytes: 4, ..Limits::standard() }),
        "tiny buffer",
    );
    let data = Vec::new();
    for _ in 0..100000 {
        data.push(255);
    }
    let encoded = wire(Value::Bulk(data));
    for index in 0..encoded.len() {
        testing::assert_ok(decoder.feed(encoded.slice(index, index + 1)));
        let value = testing::expect_ok(decoder.next(), "one byte");
        if index == encoded.len() - 1 {
            let Value::Bulk(actual) = testing::expect_some(value, "completed") else {
                testing::fail("bulk");
                return
            };
            testing::assert(actual == data);
        } else {
            testing::assert(value.is_none());
        }
    }
    testing::assert_ok(decoder.finish());
    testing::assert_err(decoder.feed("12345".to_bytes().as_slice()));
    testing::assert_err(decoder.next());
    decoder.reset();
    testing::assert_ok(decoder.feed("?".to_bytes().as_slice()));
    testing::assert_err(decoder.next());
    decoder.reset();
    testing::assert_ok(decoder.feed("_\r\n".to_bytes().as_slice()));
    testing::assert(testing::expect_ok(decoder.next(), "reset").is_some());
    testing::assert_ok(decoder.finish());
    let cycle = Vec::new();
    let value = Value::Array(cycle);
    cycle.push(value);
    testing::assert_err(redis::encode(value));
    testing::assert_err(redis::encode(Value::Simple("a\nb".to_bytes())));
    testing::assert_err(
        Decoder::new(Limits { max_elements: 9223372036854775807, ..Limits::standard() }),
    );
}

#[test]
fn command_arguments_are_snapshots_and_options_checked() -> () {
    let argument = "original".to_bytes();
    let command = testing::expect_ok(Command::new("echo", Vec::from_array([argument])), "command");
    argument[0] = 88;
    let exposed = command.arguments();
    exposed[0].bytes[0] = 89;
    let Value::Array(values) = command.value() else {
        testing::fail("array");
        return
    };
    let Value::Bulk(bytes) = values[1] else {
        testing::fail("argument");
        return
    };
    bytes[0] = 90;
    testing::assert_eq(command.name(), "ECHO");
    testing::assert_eq(testing::expect_ok(command.arguments()[0].text(), "text"), "original");
    testing::assert_err(Command::new("GET key", Vec::new()));
    let empty: Vec[string] = Vec::new();
    testing::assert_err(commands::mget(empty));
    testing::assert_err(
        commands::set(
            "k",
            "v",
            commands::SetOptions {
                condition: commands::SetCondition::Always,
                expiration: commands::Expiration::Seconds(0),
            },
        ),
    );
    testing::assert_err(commands::scan(0, Option::None, Option::Some(0)));
    testing::assert_err(
        commands::zadd("k", Vec::from_array([(float64_from_bits(9221120237041090560), "m")])),
    );
    let payload: Vec[u8] = Vec::from_array([0, 255]);
    let request = testing::expect_ok(
        commands::set(
            "k",
            payload,
            commands::SetOptions {
                condition: commands::SetCondition::IfAbsent,
                expiration: commands::Expiration::Milliseconds(50),
            },
        ),
        "set",
    );
    testing::assert_eq(request.command().arguments().len(), 5);
    testing::assert_eq(testing::expect_ok(request.command().arguments()[2].text(), "NX"), "NX");
}

#[test]
fn numeric_narrowing_is_checked_and_float_text_errors_are_types() -> () {
    let signed: i8 = testing::expect_ok(
        FromReply::from_reply(Value::Integer(-128)),
        "signed minimum",
    );
    testing::assert_eq(signed, -128);
    let overflow: Result[i8, redis::Error] = FromReply::from_reply(Value::Integer(128));
    testing::assert_eq(testing::expect_err(overflow, "signed overflow").kind, ErrorKind::Type);
    let unsigned: u8 = testing::expect_ok(
        FromReply::from_reply(Value::Integer(255)),
        "unsigned maximum",
    );
    testing::assert_eq(unsigned, 255);
    let negative: Result[u8, redis::Error] = FromReply::from_reply(Value::Integer(-1));
    testing::assert_err(negative);
    let bad: Result[f64, redis::Error] = FromReply::from_reply(Value::Bulk("nanx".to_bytes()));
    testing::assert_eq(testing::expect_err(bad, "float text").kind, ErrorKind::Type);
    let overflow: Result[f32, redis::Error] = FromReply::from_reply(Value::Double(1e100));
    testing::assert_eq(testing::expect_err(overflow, "f32 overflow").kind, ErrorKind::Type);
}
