package tests;

use ecosystem::redis;
use ecosystem::redis::{Connection, ConnectionOptions, Operation, Decoder, Limits, Blob, FromReply, Pipeline, ErrorKind, SubscriptionKind, Event, Value};
use ecosystem::redis::commands;
use std::net;
use std::task;
use std::time;
use std::testing;
use std::context;

struct Peer {
    stream: net::TcpStream,
    decoder: Decoder,
}

fn wait_options() -> net::WaitOptions {
    net::WaitOptions::new().with_timeout(time::Duration::from_seconds(3))
}

impl Peer {
    fn request(self: Peer) -> Vec[Blob] {
        let bytes: Vec[u8] = Vec::new();
        for _ in 0..1024 {
            bytes.push(0);
        }
        loop {
            if let Some(value) = testing::expect_ok(self.decoder.next(), "server decode") {
                return testing::expect_ok(FromReply::from_reply(value), "command arguments")
            }
            let count = testing::expect_ok(
                self.stream.read_with(bytes.as_mut_slice(), wait_options()),
                "server read",
            );
            testing::assert(count > 0);
            testing::assert_ok(self.decoder.feed(bytes.slice(0, count)));
        }
    }

    fn send(self: Peer, source: string) -> () {
        testing::assert_ok(self.stream.write_all_with(source.to_bytes().as_slice(), wait_options()));
    }

    fn value(self: Peer, value: Value) -> () {
        testing::assert_ok(self.stream.write_all_with(wire(value).as_slice(), wait_options()));
    }
}

fn with_peer(options: ConnectionOptions, server: (Peer) -> (), client: (Connection) -> ()) -> () {
    let listener = testing::expect_ok(
        net::TcpListener::bind(testing::expect_ok(net::SocketAddr::parse("127.0.0.1:0"), "address")),
        "listen",
    );
    let address = testing::expect_ok(listener.local_addr(), "local address");
    task::scope(
        |scope| {
            let worker = scope.spawn(
                |_| {
                    let stream = testing::expect_ok(listener.accept_with(wait_options()), "accept").0;
                    let peer = Peer {
                        stream,
                        decoder: testing::expect_ok(
                            Decoder::new(Limits::standard()),
                            "server decoder",
                        ),
                    };
                    let hello = peer.request();
                    testing::assert_eq(testing::expect_ok(hello[0].text(), "HELLO"), "HELLO");
                    peer.send("%1\r\n+proto\r\n:3\r\n");
                    server(peer);
                    testing::assert_ok(stream.close());
                },
            );
            let connection = testing::expect_ok(
                Connection::connect(address, options, Operation::new()),
                "connect",
            );
            client(connection);
            testing::assert_ok(connection.close());
            worker.join();
        },
    );
    testing::assert_ok(listener.close());
}

#[test]
fn concurrent_requests_preserve_correlation_and_close_idempotently() -> () {
    let scopes = task::active_scope_count();
    with_peer(
        ConnectionOptions::standard(),
        |peer| {
            for _ in 0..40 {
                let args = peer.request();
                peer.value(Value::Bulk(args[1].bytes));
            }
        },
        |connection| {
            task::scope(
                |scope| {
                    let jobs = Vec::new();
                    for index in 0..40 {
                        jobs.push(
                            scope.spawn(
                                |_| {
                                    let request = testing::expect_ok(commands::echo(index), "echo");
                                    let value = testing::expect_ok(
                                        connection.execute(request, Operation::new()),
                                        "execute",
                                    );
                                    testing::assert_eq(
                                        testing::expect_ok(value.text(), "text"),
                                        index.to_string(),
                                    );
                                },
                            ),
                        );
                    }
                    for job in jobs {
                        job.join();
                    }
                },
            );
            testing::assert_ok(connection.close());
            testing::assert_ok(connection.close());
        },
    );
    testing::assert_eq(task::active_scope_count(), scopes);
}

#[test]
fn pipelines_drain_errors_preserve_attributes_and_check_ticket_owner() -> () {
    with_peer(
        ConnectionOptions::standard(),
        |peer| {
            for _ in 0..3 {
                let _ = peer.request();
            }
            peer.send(
                "|0\r\n:7\r\n>2\r\n+invalidate\r\n*1\r\n+k\r\n-WRONGTYPE wrong\r\n$2\r\nok\r\n",
            );
            let _ = peer.request();
            peer.send("+PONG\r\n");
        },
        |connection| {
            let pipeline = Pipeline::new();
            let number = pipeline.queue(testing::expect_ok(commands::incrby("k", 1), "incr"));
            let bad = pipeline.queue(testing::expect_ok(commands::get("wrong"), "get"));
            let mapped = pipeline.queue(
                testing::expect_ok(commands::echo("ok"), "echo").map(|blob| blob.text()),
            );
            let responses = testing::expect_ok(
                connection.pipeline(pipeline, Operation::new()),
                "pipeline",
            );
            testing::assert_eq(testing::expect_ok(responses.get(number), "integer"), 7);
            let error = testing::expect_err(responses.get(bad), "server error");
            testing::assert_eq(error.kind, ErrorKind::Server);
            testing::assert(error.index == Option::Some(1));
            testing::assert_eq(testing::expect_ok(responses.get(mapped), "mapped"), "ok");
            let alien = Pipeline::new().queue(testing::expect_ok(commands::ping(), "ping"));
            testing::assert_eq(
                testing::expect_err(responses.get(alien), "alien").kind,
                ErrorKind::WrongPipeline,
            );
            testing::assert_eq(
                testing::expect_ok(connection.drain_pushes(Operation::new()), "pushes").len(),
                1,
            );
            testing::assert_eq(
                testing::expect_ok(
                    connection.execute(
                        testing::expect_ok(commands::ping(), "ping"),
                        Operation::new(),
                    ),
                    "next request",
                ),
                "PONG",
            );
        },
    );
}

#[test]
fn queued_timeout_and_precancel_leave_connection_usable() -> () {
    let received: Channel[()] = Channel::new(1);
    let release: Channel[()] = Channel::new(1);
    with_peer(
        ConnectionOptions::standard(),
        |peer| {
            let _ = peer.request();
            received.send(());
            let _ = release.recv();
            peer.send("+PONG\r\n");
            let _ = peer.request();
            peer.send("+PONG\r\n");
        },
        |connection| {
            task::scope(
                |scope| {
                    let job = scope.spawn(
                        |_| connection.execute(
                            testing::expect_ok(commands::ping(), "ping"),
                            Operation::new(),
                        ),
                    );
                    let _ = received.recv();
                    let problem = testing::expect_err(
                        connection.execute(
                            testing::expect_ok(commands::ping(), "queued ping"),
                            Operation::new().with_timeout(time::Duration::from_milliseconds(25)),
                        ),
                        "queued timeout",
                    );
                    testing::assert_eq(problem.kind, ErrorKind::Timeout);
                    testing::assert(!problem.may_have_executed);
                    testing::assert(!connection.is_closed());
                    context::with_timeout(
                        context::Context::background(),
                        time::Duration::from_milliseconds(25),
                        |ctx, _| {
                            let error = testing::expect_err(
                                connection.execute(
                                    testing::expect_ok(commands::ping(), "context ping"),
                                    Operation::new().without_timeout().with_context(ctx),
                                ),
                                "context queue deadline",
                            );
                            testing::assert_eq(error.kind, ErrorKind::Timeout);
                            testing::assert(!error.may_have_executed);
                            testing::assert(!connection.is_closed());
                        },
                    );
                    context::with_cancel(
                        context::Context::background(),
                        |ctx, cancel| {
                            cancel.cancel();
                            let error = testing::expect_err(
                                connection.execute(
                                    testing::expect_ok(commands::ping(), "context ping"),
                                    Operation::new().with_context(ctx),
                                ),
                                "cancelled context",
                            );
                            testing::assert_eq(error.kind, ErrorKind::Cancelled);
                            testing::assert(!error.may_have_executed);
                        },
                    );
                    task::scope(
                        |cancelled| {
                            cancelled.cancel();
                            let problem = testing::expect_err(
                                connection.execute(
                                    testing::expect_ok(commands::ping(), "cancelled ping"),
                                    Operation::new().with_cancel(cancelled.token()),
                                ),
                                "precancel",
                            );
                            testing::assert_eq(problem.kind, ErrorKind::Cancelled);
                            testing::assert(!problem.may_have_executed);
                        },
                    );
                    release.send(());
                    testing::assert_eq(testing::expect_ok(job.join(), "original ping"), "PONG");
                },
            );
            testing::assert_eq(
                testing::expect_ok(
                    connection.execute(
                        testing::expect_ok(commands::ping(), "ping"),
                        Operation::new(),
                    ),
                    "still usable",
                ),
                "PONG",
            );
        },
    );
}

#[test]
fn sent_pipeline_timeout_retains_partial_replies_and_closes() -> () {
    let release: Channel[()] = Channel::new(1);
    with_peer(
        ConnectionOptions::standard(),
        |peer| {
            let _ = peer.request();
            let _ = peer.request();
            peer.send("+PONG\r\n$9\r\npart");
            let _ = release.recv();
        },
        |connection| {
            let pipeline = Pipeline::new();
            let _ = pipeline.queue(testing::expect_ok(commands::ping(), "ping"));
            let _ = pipeline.queue(testing::expect_ok(commands::get("k"), "get"));
            let problem = testing::expect_err(
                connection.pipeline(
                    pipeline,
                    Operation::new().with_timeout(time::Duration::from_milliseconds(80)),
                ),
                "in flight timeout",
            );
            testing::assert_eq(problem.kind, ErrorKind::Timeout);
            testing::assert(problem.may_have_executed);
            testing::assert_eq(problem.partial.len(), 1);
            testing::assert(connection.is_closed());
            testing::assert_eq(
                testing::expect_err(
                    connection.execute(
                        testing::expect_ok(commands::ping(), "ping"),
                        Operation::new(),
                    ),
                    "closed",
                ).kind,
                ErrorKind::Closed,
            );
            release.send(());
        },
    );
}

#[test]
fn cancel_and_close_wake_active_and_queued_requests() -> () {
    for cancel in Vec::from_array([true, false]) {
        let received: Channel[()] = Channel::new(1);
        let release: Channel[()] = Channel::new(1);
        with_peer(
            ConnectionOptions::standard(),
            |peer| {
                let _ = peer.request();
                received.send(());
                let _ = release.recv();
            },
            |connection| {
                task::scope(
                    |scope| {
                        let active = scope.spawn(
                            |token| connection.execute(
                                testing::expect_ok(commands::ping(), "ping"),
                                Operation::new().with_cancel(token),
                            ),
                        );
                        let _ = received.recv();
                        let queued = scope.spawn(
                            |_| connection.execute(
                                testing::expect_ok(commands::ping(), "queued"),
                                Operation::new(),
                            ),
                        );
                        if cancel {
                            scope.cancel();
                        } else {
                            testing::assert_ok(connection.close());
                        }
                        let problem = testing::expect_err(
                            active.join(),
                            "interrupted active request",
                        );
                        testing::assert_eq(
                            problem.kind,
                            if cancel {
                                ErrorKind::Cancelled
                            } else {
                                ErrorKind::Closed
                            },
                        );
                        testing::assert(problem.may_have_executed);
                        testing::assert_eq(
                            testing::expect_err(queued.join(), "closed queue").kind,
                            ErrorKind::Closed,
                        );
                        testing::assert(connection.is_closed());
                    },
                );
                release.send(());
            },
        );
    }
}

#[test]
fn malformed_reply_eof_and_push_overflow_close_connection() -> () {
    for reply in Vec::from_array(["?bad\r\n", "$4\r\nab", ">1\r\n+x\r\n>1\r\n+y\r\n+PONG\r\n"]) {
        with_peer(
            ConnectionOptions {
                limits: Limits { max_pushes: 1, ..Limits::standard() },
                ..ConnectionOptions::standard(),
            },
            |peer| {
                let _ = peer.request();
                peer.send(reply);
            },
            |connection| {
                let problem = testing::expect_err(
                    connection.execute(
                        testing::expect_ok(commands::ping(), "ping"),
                        Operation::new(),
                    ),
                    "fault",
                );
                testing::assert(
                    problem.kind == ErrorKind::Protocol || problem.kind == ErrorKind::UnexpectedEof
                        || problem.kind == ErrorKind::Limit,
                );
                testing::assert(problem.may_have_executed);
                testing::assert(connection.is_closed());
            },
        );
    }
}

#[test]
fn subscription_messages_between_acks_and_read_timeout_resume() -> () {
    let resume: Channel[()] = Channel::new(1);
    with_peer(
        ConnectionOptions::standard(),
        |peer| {
            let _ = peer.request();
            peer.send(
                ">3\r\n+subscribe\r\n+a\r\n:1\r\n>3\r\n+message\r\n+a\r\n+early\r\n>3\r\n+subscribe\r\n+b\r\n:2\r\n",
            );
            peer.send(">3\r\n+message\r\n+a\r\n$4\r\nla");
            let _ = resume.recv();
            peer.send("te\r\n");
            let _ = peer.request();
            peer.send(">3\r\n+unsubscribe\r\n+a\r\n:1\r\n>3\r\n+unsubscribe\r\n+b\r\n:0\r\n");
            let _ = peer.request();
            peer.send("+PONG\r\n");
        },
        |connection| {
            let channels = Vec::from_array([Blob::from_string("a"), Blob::from_string("b")]);
            let subscription = testing::expect_ok(
                connection.subscribe(channels, SubscriptionKind::Channel, Operation::new()),
                "subscribe",
            );
            testing::assert_eq(testing::expect_ok(subscription.count(Operation::new()), "count"), 2);
            testing::assert_eq(
                testing::expect_err(
                    connection.execute(
                        testing::expect_ok(commands::ping(), "ping"),
                        Operation::new(),
                    ),
                    "subscribed mode",
                ).kind,
                ErrorKind::InvalidCommand,
            );
            let Event::Message(_, message, _) = testing::expect_ok(
                subscription.next(Operation::new()),
                "early message",
            ) else {
                testing::fail("message");
                return
            };
            testing::assert_eq(testing::expect_ok(message.text(), "text"), "early");
            testing::assert_eq(
                testing::expect_err(
                    subscription.next(
                        Operation::new().with_timeout(time::Duration::from_milliseconds(25)),
                    ),
                    "read timeout",
                ).kind,
                ErrorKind::Timeout,
            );
            testing::assert(!connection.is_closed());
            resume.send(());
            let Event::Message(_, message, _) = testing::expect_ok(
                subscription.next(Operation::new()),
                "resumed message",
            ) else {
                testing::fail("message");
                return
            };
            testing::assert_eq(testing::expect_ok(message.text(), "text"), "late");
            testing::assert_eq(
                testing::expect_ok(
                    subscription.change(
                        channels,
                        SubscriptionKind::Channel,
                        false,
                        Operation::new(),
                    ),
                    "unsubscribe",
                ).len(),
                2,
            );
            testing::assert_eq(testing::expect_ok(subscription.count(Operation::new()), "count"), 0);
            testing::assert_eq(
                testing::expect_ok(
                    connection.execute(
                        testing::expect_ok(commands::ping(), "ping"),
                        Operation::new(),
                    ),
                    "normal mode",
                ),
                "PONG",
            );
        },
    );
}

#[test]
fn invalid_state_commands_and_batch_limits_do_not_send_bytes() -> () {
    with_peer(
        ConnectionOptions {
            limits: Limits { max_batch: 1, ..Limits::standard() },
            ..ConnectionOptions::standard(),
        },
        |peer| {
            let args = peer.request();
            testing::assert_eq(testing::expect_ok(args[0].text(), "only ping"), "PING");
            peer.send("+PONG\r\n");
        },
        |connection| {
            for name in Vec::from_array(["MULTI", "HELLO", "SUBSCRIBE", "QUIT", "MONITOR", "RESET"]) {
                let request: redis::Request[Value] = testing::expect_ok(
                    redis::request(name, Vec::new()),
                    "raw command",
                );
                testing::assert_eq(
                    testing::expect_err(
                        connection.execute(request, Operation::new()),
                        "state command rejected",
                    ).kind,
                    ErrorKind::InvalidCommand,
                );
            }
            let request: redis::Request[Value] = testing::expect_ok(
                redis::request("CLIENT", Vec::from_array(["REPLY".to_bytes(), "OFF".to_bytes()])),
                "reply suppression",
            );
            testing::assert_eq(
                testing::expect_err(
                    connection.execute(request, Operation::new()),
                    "suppression rejected",
                ).kind,
                ErrorKind::InvalidCommand,
            );
            let batch = Pipeline::new();
            for _ in 0..2 {
                let _ = batch.queue(testing::expect_ok(commands::ping(), "ping"));
            }
            testing::assert_eq(
                testing::expect_err(connection.pipeline(batch, Operation::new()), "batch too large").kind,
                ErrorKind::Limit,
            );
            testing::assert(!connection.is_closed());
            testing::assert_eq(
                testing::expect_ok(
                    connection.execute(
                        testing::expect_ok(commands::ping(), "ping"),
                        Operation::new(),
                    ),
                    "valid request",
                ),
                "PONG",
            );
        },
    );
}

#[test]
fn deadline_covers_whole_pipeline_despite_continued_progress() -> () {
    with_peer(
        ConnectionOptions::standard(),
        |peer| {
            for _ in 0..5 {
                let _ = peer.request();
            }
            peer.send("+PONG\r\n");
            for _ in 0..4 {
                time::sleep(time::Duration::from_milliseconds(50));
                if peer.stream.write_all_with("+PONG\r\n".to_bytes().as_slice(), wait_options()).is_err() {
                    break;
                }
            }
        },
        |connection| {
            let batch = Pipeline::new();
            for _ in 0..5 {
                let _ = batch.queue(testing::expect_ok(commands::ping(), "ping"));
            }
            let started = time::Instant::now();
            let error = testing::expect_err(
                connection.pipeline(
                    batch,
                    Operation::new().with_timeout(time::Duration::from_milliseconds(120)),
                ),
                "total deadline",
            );
            testing::assert_eq(error.kind, ErrorKind::Timeout);
            testing::assert(error.partial.len() >= 1 && error.partial.len() < 5);
            testing::assert(started.elapsed().compare(time::Duration::from_seconds(1)) < 0);
            testing::assert(connection.is_closed());
        },
    );
}
