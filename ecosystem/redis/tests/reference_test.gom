package tests;

use ecosystem::redis;
use std::testing;

fn specification_frame(tag: string, body: Vec[u8]) -> Vec[u8] {
    let output = (tag + body.len().to_string() + "\r\n").to_bytes();
    for byte in body {
        output.push(byte);
    }
    output.push(13);
    output.push(10);
    output
}

fn specification_join(header: string, items: Vec[Vec[u8]], tail: string) -> Vec[u8] {
    let result = header.to_bytes();
    for item in items {
        for byte in item {
            result.push(byte);
        }
    }
    for byte in tail.to_bytes() {
        result.push(byte);
    }
    result
}

fn specification_check(source: Vec[u8], expected: Vec[Vec[u8]], chunk: isize) -> () {
    let decoder = testing::expect_ok(redis::Decoder::new(redis::Limits::standard()), "decoder");
    let actual = Vec::new();
    let mut offset = 0;
    while offset < source.len() {
        let end = if chunk > source.len() - offset {
            source.len()
        } else {
            offset + chunk
        };
        testing::assert_ok(decoder.feed(source.slice(offset, end)));
        while let Some(value) = testing::expect_ok(decoder.next(), "decode independent wire") {
            actual.push(testing::expect_ok(redis::encode(value), "canonical wire"));
        }
        offset = end;
    }
    testing::assert_ok(decoder.finish());
    testing::assert(actual == expected);
}

#[test]
fn generated_resp_specification_scalars_streamed_aggregates_and_binary_chunks() -> () {
    let scalars = Vec::new();
    for scalar in Vec::from_array(
        [
            "+OK\r\n",
            "-WRONGTYPE wrong\r\n",
            "$-1\r\n",
            "*-1\r\n",
            "_\r\n",
            "#t\r\n",
            "#f\r\n",
            ",inf\r\n",
            ",-inf\r\n",
            ",nan\r\n",
            ",1.25\r\n",
            "(1234567890123456789012345678901234567890\r\n",
            ":-9223372036854775808\r\n",
            ":-1\r\n",
            ":0\r\n",
            ":1\r\n",
            ":9223372036854775807\r\n",
        ],
    ) {
        scalars.push(scalar.to_bytes());
    }
    for length in Vec::from_array([0, 1, 2, 31, 255, 256, 4096, 65536]) {
        let payload = Vec::new();
        for index in 0..length {
            payload.push(((index * 73 + 19) % 256).to_u8());
        }
        scalars.push(specification_frame("$", payload));
        let error = "ERR ".to_bytes();
        let verbatim = "txt:".to_bytes();
        for byte in payload {
            error.push(byte);
            verbatim.push(byte);
        }
        scalars.push(specification_frame("!", error));
        scalars.push(specification_frame("=", verbatim));
    }
    for source in scalars {
        for chunk in Vec::from_array([1, 2, 7, 257, source.len()]) {
            specification_check(source, Vec::from_array([source]), chunk);
        }
    }
    for index in 0..400 {
        let values = Vec::new();
        for item in 0..index % 7 {
            values.push(scalars[(index * 19 + item * 7) % 25]);
        }
        let tag = if index % 2 == 0 {
            "*"
        } else {
            "~"
        };
        let canonical = specification_join(tag + values.len().to_string() + "\r\n", values, "");
        specification_check(canonical, Vec::from_array([canonical]), 97);
        specification_check(
            specification_join(tag + "?\r\n", values, ".\r\n"),
            Vec::from_array([canonical]),
            1 + index % 17,
        );
        let pairs = Vec::new();
        for item in 0..index % 5 {
            pairs.push(scalars[(index + item * 3) % 20]);
            pairs.push(scalars[(index * 7 + item) % 20]);
        }
        let canonical = specification_join("%" + (pairs.len() / 2).to_string() + "\r\n", pairs, "");
        specification_check(
            specification_join("%?\r\n", pairs, ".\r\n"),
            Vec::from_array([canonical]),
            1 + index % 97,
        );
        let attributed = specification_join(
            "|" + (pairs.len() / 2).to_string() + "\r\n",
            pairs,
            "+value\r\n",
        );
        specification_check(attributed, Vec::from_array([attributed]), 1 + index % 31);
        let chunks = Vec::new();
        let all = Vec::new();
        for item in 0..index % 8 {
            let bytes = Vec::new();
            for pos in 0..1 + (index * 7 + item) % 49 {
                let byte = ((index + pos * 13) % 256).to_u8();
                bytes.push(byte);
                all.push(byte);
            }
            chunks.push(specification_frame(";", bytes));
        }
        specification_check(
            specification_join("$?\r\n", chunks, ";0\r\n"),
            Vec::from_array([specification_frame("$", all)]),
            1 + index % 31,
        );
    }
    let sequence = Vec::new();
    for index in 0..17 {
        sequence.push(scalars[index]);
    }
    specification_check(specification_join("", sequence, ""), sequence, 3);
}
