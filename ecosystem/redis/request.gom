    }
}

impl ToArg for usize {
    fn to_arg(self: usize) -> Vec[u8] {
        self.to_string().to_bytes()
    }
}

impl ToArg for f32 {
    fn to_arg(self: f32) -> Vec[u8] {
        self.to_string().to_bytes()
    }
}

impl ToArg for bool {
    fn to_arg(self: bool) -> Vec[u8] {
        if self {
            "1".to_bytes()
        } else {
            "0".to_bytes()
        }
    }
}
