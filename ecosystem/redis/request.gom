package redis;

pub trait ToArg {
    fn to_arg(self: Self) -> Vec[u8];
}

impl ToArg for string {
    fn to_arg(self: string) -> Vec[u8] {
        self.to_bytes()
    }
}

impl ToArg for Blob {
    fn to_arg(self: Blob) -> Vec[u8] {
        self.bytes.copy()
    }
}

impl ToArg for Vec[u8] {
    fn to_arg(self: Vec[u8]) -> Vec[u8] {
        self.copy()
    }
}

impl ToArg for Slice[u8] {
    fn to_arg(self: Slice[u8]) -> Vec[u8] {
        self.to_vec()
    }
}

impl ToArg for i64 {
    fn to_arg(self: i64) -> Vec[u8] {
        self.to_string().to_bytes()
    }
}

impl ToArg for isize {
    fn to_arg(self: isize) -> Vec[u8] {
        self.to_string().to_bytes()
    }
}

impl ToArg for u64 {
    fn to_arg(self: u64) -> Vec[u8] {
        self.to_string().to_bytes()
    }
}

impl ToArg for f64 {
    fn to_arg(self: f64) -> Vec[u8] {
        self.to_string().to_bytes()
    }
}

pub struct Command {
    name: string,
    arguments: Vec[Vec[u8]],
}

impl Command {
    pub fn new(name: string, arguments: Vec[Vec[u8]]) -> Result[Command, Error] {
        if name.byte_len() == 0 {
            return Result::Err(error(ErrorKind::InvalidCommand, 0, "command name cannot be empty"))
        }
        for byte in name.to_bytes() {
            if byte < 33 || byte > 126 {
                return Result::Err(
                    error(
                        ErrorKind::InvalidCommand,
                        0,
                        "command name must contain printable ASCII without spaces",
                    ),
                )
            }
        }
        let copied = Vec::with_capacity(arguments.len());
        for argument in arguments {
            copied.push(argument.copy());
        }
        Result::Ok(Command { name: name.to_ascii_uppercase(), arguments: copied })
    }

    pub fn from_strings(parts: Vec[string]) -> Result[Command, Error] {
        if parts.is_empty() {
            return Result::Err(error(ErrorKind::InvalidCommand, 0, "command requires a name"))
        }
        let arguments = Vec::new();
        for index in 1..parts.len() {
            arguments.push(parts[index].to_bytes());
        }
        Command::new(parts[0], arguments)
    }

    pub fn name(self: Command) -> string {
        self.name
    }

    pub fn arguments(self: Command) -> Vec[Blob] {
        let result = Vec::new();
        for argument in self.arguments {
            result.push(Blob::new(argument.as_slice()));
        }
        result
    }

    pub fn value(self: Command) -> Value {
        let result = Vec::from_array([Value::Bulk(self.name.to_bytes())]);
        for argument in self.arguments {
            result.push(Value::Bulk(argument.copy()));
        }
        Value::Array(result)
    }

    pub fn encode(self: Command, limits: Limits) -> Result[Vec[u8], Error] {
        encode_with_limits(self.value(), limits)
    }

    fn validate_regular(self: Command) -> Result[(), Error] {
        match self.name {
            "MULTI" | "EXEC" | "DISCARD" | "WATCH" | "UNWATCH" | "SUBSCRIBE" | "PSUBSCRIBE" | "SSUBSCRIBE" | "UNSUBSCRIBE" | "PUNSUBSCRIBE" | "SUNSUBSCRIBE" | "MONITOR" | "QUIT" | "HELLO" | "RESET" | "SYNC" | "PSYNC" | "REPLCONF" => return Result::Err(
                error(
                    ErrorKind::InvalidCommand,
                    0,
                    "command changes connection protocol state; use the dedicated connection API",
                ),
            ),
            _ => (),
        }
        if self.name == "CLIENT" && !self.arguments.is_empty() {
            let subcommand = string_from_utf8(self.arguments[0]).1.to_ascii_uppercase();
            if subcommand == "REPLY" {
                return Result::Err(
                    error(ErrorKind::InvalidCommand, 0, "CLIENT REPLY would break reply accounting"),
                )
            }
        }
        Result::Ok(())
    }
}

pub struct Request[T] {
    command: Command,
    decode: (Value) -> Result[T, Error],
}

impl[T] Request[T] {
    pub fn new(command: Command, decode: (Value) -> Result[T, Error]) -> Request[T] {
        Request { command, decode }
    }

    pub fn command(self: Request[T]) -> Command {
        self.command
    }

    pub fn map[U](self: Request[T], convert: (T) -> Result[U, Error]) -> Request[U] {
        Request { command: self.command, decode: |value| convert((self.decode)(value)?) }
    }
}

pub fn request[T: FromReply](name: string, arguments: Vec[Vec[u8]]) -> Result[Request[T], Error] {
    Result::Ok(
        Request {
            command: Command::new(name, arguments)?,
            decode: |value| FromReply::from_reply(value),
        },
    )
}

pub fn raw_request(command: Command) -> Request[Value] {
    Request { command, decode: |value| value.checked() }
}

pub struct Pipeline {
    commands: Vec[Command],
    owner: Ref[bool],
}

pub struct Ticket[T] {
    index: isize,
    owner: Ref[bool],
    decode: (Value) -> Result[T, Error],
}

pub struct Responses {
    values: Vec[Value],
    owner: Ref[bool],
}

impl Pipeline {
    pub fn new() -> Pipeline {
        Pipeline { commands: Vec::new(), owner: Ref::new(false) }
    }

    pub fn queue[T](self: Pipeline, request: Request[T]) -> Ticket[T] {
        let index = self.commands.len();
        self.commands.push(request.command);
        Ticket { index, owner: self.owner, decode: request.decode }
    }

    pub fn len(self: Pipeline) -> isize {
        self.commands.len()
    }
}

impl[T] Ticket[T] {
    pub fn index(self: Ticket[T]) -> isize {
        self.index
    }
}

impl Responses {
    pub fn len(self: Responses) -> isize {
        self.values.len()
    }

    pub fn raw(self: Responses, index: isize) -> Option[Value] {
        self.values.get_checked(index)
    }

    pub fn at(self: Responses, index: isize) -> Result[Value, Error] {
        if index < 0 || index >= self.values.len() {
            return Result::Err(error(ErrorKind::Type, 0, "response index out of range"))
        }
        self.values[index].checked().map_err(|error| Error { index: Option::Some(index), ..error })
    }

    pub fn get[T](self: Responses, ticket: Ticket[T]) -> Result[T, Error] {
        if !ptr_eq(self.owner, ticket.owner) {
            return Result::Err(
                error(ErrorKind::WrongPipeline, 0, "ticket belongs to a different pipeline"),
            )
        }
        let value = self.at(ticket.index)?;
        (ticket.decode)(value).map_err(|error| Error { index: Option::Some(ticket.index), ..error })
    }
}

pub enum TransactionOutcome {
    Committed(Responses),
    Aborted,
    Rejected(Vec[(isize, ServerError)]),
}

