package compiler;

use module::artifact::interface_codec;
use module::ast;
use module::checker;
use module::hir;
use module::diagnostic::{diagnostics_have_errors};
use module::parser;
use std::testing;

#[test]
fn public_bounds_retain_private_proofs_without_exposing_methods() -> () {
    let unit = source_interface(
        "package value; trait Hidden { fn secret(self: Self) -> i32; } impl Hidden for i32 { fn secret(self: i32) -> i32 { self } } pub trait Public: Hidden {} impl Public for i32 {} pub fn echo[T: Hidden](value: T) -> i32 { value.secret() }",
    );
    testing::assert_eq(unit.exports.proof_traits.len(), 1);
    testing::assert_eq(unit.exports.proof_trait_impls.len(), 1);
    testing::assert_eq(unit.exports.traits.len(), 1);
    let encoded = testing::expect_ok(interface_codec::encode_binary(unit), "encode interface");
    let decoded = testing::expect_ok(interface_codec::decode_binary(encoded), "decode interface");
    let dependency = testing::expect_ok(
        artifact_dependency_environment_from_exports(decoded.exports),
        "dependency environment",
    );
    testing::assert_eq(dependency.proof_trait_names.len(), 1);
    for body in[
        "pub fn caller() -> i32 { let item: i32 = 7; value::echo(item) }",
        "pub fn forward[T: value::Public](item: T) -> i32 { value::echo(item) }",
    ] {
        let lowered = hir::lower_package(
            ast::lower(parser::parse("package consumer; use audit::value; " + body)),
            "consumer.goml",
            "audit::consumer",
        );
        let checked = checker::check_package_files_for_link_with_environments(
            Vec::from_array([testing::expect_some(lowered.hir, "consumer HIR")]),
            Vec::from_array([dependency]),
        );
        for diagnostic in checked.diagnostics {
            testing::fail(body + ": " + diagnostic.message);
        }
    }
    for body in[
        "pub fn caller() -> i32 { value::echo(true) }",
        "pub fn hidden[T: value::Public](item: T) -> i32 { item.secret() }",
        "pub fn hidden[T: value::Public](item: T) -> i32 { T::secret(item) }",
        "pub fn hidden(item: i32) -> i32 { value::Hidden::secret(item) }",
    ] {
        let lowered = hir::lower_package(
            ast::lower(parser::parse("package consumer; use audit::value; " + body)),
            "consumer.goml",
            "audit::consumer",
        );
        let checked = checker::check_package_files_for_link_with_environments(
            Vec::from_array([testing::expect_some(lowered.hir, "consumer HIR")]),
            Vec::from_array([dependency]),
        );
        if !diagnostics_have_errors(checked.diagnostics) {
            testing::fail("private proof access was accepted: " + body);
        }
    }
}
