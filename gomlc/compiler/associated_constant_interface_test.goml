package compiler;

use module::artifact::interface_codec;
use module::ast;
use module::checker;
use module::hir;
use module::parser;
use std::testing;

#[test]
fn constant_dependency_edges_survive_source_and_binary_interfaces() -> () {
    let unit = source_interface(
        "package value; pub trait Value { const A: i32; } pub struct Wrap[T] { pub value: T } impl[T: Value] Value for Wrap[T] { const A: i32 = T::A; }",
    );
    let encoded = testing::expect_ok(
        interface_codec::encode_binary(unit),
        "encode constant dependencies",
    );
    let decoded = testing::expect_ok(
        interface_codec::decode_binary(encoded),
        "decode constant dependencies",
    );
    for exports in[unit.exports, decoded.exports] {
        let dependency = testing::expect_ok(
            artifact_dependency_environment_from_exports(exports),
            "dependency environment",
        );
        testing::assert(!dependency.associated_constants.is_empty());
        for cyclic in[false, true] {
            let initializer = if cyclic {
                "value::Wrap::[Local]::A"
            } else {
                "17"
            };
            let source = "package consumer; use audit::value; use value::Value; struct Local {} impl Value for Local { const A: i32 = "
                + initializer
                + "; } struct Root {} impl Root { const A: i32 = value::Wrap::[value::Wrap[Local]]::A; } pub fn read() -> i32 { Root::A }";
            let lowered = hir::lower_package(
                ast::lower(parser::parse(source)),
                "consumer.goml",
                "audit::consumer",
            );
            let checked = checker::check_package_files_for_link_with_environments(
                Vec::from_array([testing::expect_some(lowered.hir, "consumer HIR")]),
                Vec::from_array([dependency]),
            );
            let mut found = false;
            for diagnostic in checked.diagnostics {
                if diagnostic.message.contains("cyclic associated constant") {
                    found = true;
                }
                if !cyclic {
                    testing::fail(diagnostic.message)
                }
            }
            testing::assert_eq(found, cyclic);
            if cyclic {
                testing::assert(checked.tast.is_none())
            }
        }
    }
}
