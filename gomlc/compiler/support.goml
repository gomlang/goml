package compiler;

use module::source as source_files;
use std::fs;
use std::io;
use std::process;

pub fn fail(message: string) -> () {
    io::eprintln(message);
    process::exit(1)
}

pub fn read_source(path: string) -> string {
    if !source_files::is_source_file(path) {
        fail("source file must use the .goml extension: " + path);
    }
    match fs::read_file_structured(path) {
        Ok(source) => source,
        Err(_) => {
            fail("error reading goml file: " + path);
            ""
        },
    }
}
