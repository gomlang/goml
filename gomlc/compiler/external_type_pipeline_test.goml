package compiler;

use module::artifact;
use module::artifact::interface_codec;
use module::core;
use module::tast;
use std::testing;
use std::utf8;
use utf8::BytesUtf8;

fn external_type_interface(ty: core::Type) -> artifact::ArtifactInterfaceUnit {
    let exports = interface_codec::empty_exports();
    exports.type_aliases.push(
        tast::TypeAliasInfo {
            name: "external::api::Handle",
            generics: Vec::from_array(["T"]),
            ty: core::type_to_tast(ty),
        },
    );
    interface_codec::new_unit(
        "external::api",
        exports,
        artifact::ArtifactPackageInterface {
            package_name: "external::api",
            name: "api",
            value_exports: Vec::new(),
            enum_variants: Vec::new(),
        },
        Vec::new(),
    )
}

fn exercise_external_type_interface() -> Result[(), string] {
    let ty = core::Type::External {
        import_path: "unique",
        name: "Handle",
        args: Vec::from_array([core::Type::Param { name: "T" }]),
    };
    let unit = external_type_interface(ty);
    let restored = interface_codec::decode_binary(interface_codec::encode_binary(unit)?)?;
    testing::assert_eq(restored.exports.type_aliases.len(), 1);
    testing::assert_eq(restored.exports.type_aliases[0].generics.len(), 1);
    testing::assert_eq(restored.exports.type_aliases[0].generics[0], "T");
    testing::assert_eq(restored.interface_hash, unit.interface_hash);
    testing::assert(core::types_equal(core::lower_type(restored.exports.type_aliases[0].ty), ty));
    let invalid = external_type_interface(
        External { import_path: "", name: "Handle", args: Vec::new() },
    );
    testing::assert(
        interface_codec::decode_binary(interface_codec::encode_binary(invalid)?).is_err(),
    );
    Result::Ok(())
}

#[test]
fn external_type_interfaces_roundtrip_arguments_and_reject_missing_identity() -> () {
    if let Err(error) = exercise_external_type_interface() {
        testing::fail(error)
    }
}

#[test]
fn opaque_external_interface_hash_tracks_go_identity_and_arguments() -> () {
    let argument = core::Type::Param { name: "T" };
    let original = external_type_interface(
        External {
            import_path: "example.com/native",
            name: "Box",
            args: Vec::from_array([argument]),
        },
    );
    for ty in Vec::from_array(
        [
            core::Type::External {
                import_path: "example.com/other",
                name: "Box",
                args: Vec::from_array([argument]),
            },
            core::Type::External {
                import_path: "example.com/native",
                name: "Other",
                args: Vec::from_array([argument]),
            },
            core::Type::External {
                import_path: "example.com/native",
                name: "Box",
                args: Vec::from_array([core::Type::Int64]),
            },
        ],
    ) {
        let unit = external_type_interface(ty);
        testing::assert_ne(unit.interface_hash, original.interface_hash);
        let encoded = testing::expect_ok(interface_codec::encode_binary(unit), "opaque interface");
        let restored = testing::expect_ok(
            interface_codec::decode_binary(encoded),
            "opaque interface",
        );
        testing::assert_eq(restored.interface_hash, unit.interface_hash);
        testing::assert(
            core::types_equal(core::lower_type(restored.exports.type_aliases[0].ty), ty),
        );
    }
}
