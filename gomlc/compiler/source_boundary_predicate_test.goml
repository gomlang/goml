package compiler;

use module::ast;
use module::checker;
use module::core;
use module::hir;
use module::parser;
use std::testing;

#[test]
fn source_dependencies_keep_body_inferred_boundary_requirements() -> () {
    let source = "package api; pub fn create[T]() -> () { let unused: Option[GoFunc[(T) -> T]] = None; } pub struct Factory[T] {} impl[T] Factory[T] { pub fn create(self: Factory[T]) -> () { let unused: Option[GoFunc[(T) -> T]] = None; } } pub trait Make[T] { fn create(self: Self) -> () { let unused: Option[GoFunc[(T) -> T]] = None; } }";
    let lowered = hir::lower_package(ast::lower(parser::parse(source)), "api.goml", "audit::api");
    let file = testing::expect_some(lowered.hir, "provider HIR");
    let checked = checker::check_package_files_for_link_with_dependencies(
        Vec::from_array([file]),
        Vec::new(),
    );
    for diagnostic in checked.diagnostics {
        testing::fail(diagnostic.message);
    }
    let environments = testing::expect_ok(
        checker::dependency_environments(Vec::from_array([file])),
        "source declaration environments",
    );
    testing::expect_ok(
        attach_source_boundary_predicates(
            environments,
            Vec::from_array([core::lower(checked.tast)]),
        ),
        "attach source boundary predicates",
    );
    for entry in[
        ("pub fn caller() -> () { api::create::[i32](); }", true),
        ("pub fn caller() -> () { api::create::[Vec[i32]](); }", false),
        ("pub fn caller(value: api::Factory[Vec[i32]]) -> () { value.create(); }", false),
        ("struct Local {} impl api::Make[Vec[i32]] for Local {}", false),
        (
            "struct Local {} impl api::Make[Vec[i32]] for Local { fn create(self: Self) -> () {} }",
            true,
        ),
    ] {
        let source = "package consumer; use audit::api; " + entry.0;
        let lowered = hir::lower_package(
            ast::lower(parser::parse(source)),
            "consumer.goml",
            "audit::consumer",
        );
        let checked = checker::check_package_files_for_link_with_environments(
            Vec::from_array([testing::expect_some(lowered.hir, "consumer HIR")]),
            environments,
        );
        let mut found = false;
        let mut detail = source;
        for diagnostic in checked.diagnostics {
            detail = detail + "\n" + diagnostic.message;
            if diagnostic.message.contains("Go function signature is not ABI-compatible") {
                found = true;
            }
        }
        if found == entry.1 {
            testing::fail("Unexpected source boundary result: " + detail);
        }
        if entry.1 && !checked.diagnostics.is_empty() {
            testing::fail(detail);
        }
    }
}
