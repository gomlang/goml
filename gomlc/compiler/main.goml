package compiler;

use module::source as source_files;
use module::ast;
use module::anf;
use module::cst;
use module::core;
use module::go_backend;
use module::hir;
use module::lexer;
use module::lift;
use module::mono;
use module::parser;
use module::checker;
use std::collections;
use std::env;
use std::fs;
use std::io;
use std::process;
use std::text;

pub fn fail(message: string) -> () {
    io::eprintln(message);
    process::exit(1)
}

pub fn read_source(path: string) -> string {
    if !source_files::is_source_file(path) {
        fail("source file must use the .goml extension: " + path);
    }
    match fs::read_file_structured(path) {
        Ok(source) => source,
        Err(_) => {
            fail("error reading goml file: " + path);
            ""
        },
    }
}
