package compiler;

use module::artifact::wire as wire;
use std::fs;
use std::path;

pub struct PackageCommandArgs {
    pub package_name: string,
    pub module_name: string,
    pub inputs: Vec[string],
    pub interface_paths: Vec[string],
    pub output: string,
    pub world: Option[string],
}

pub struct LinkCommandArgs {
    pub explain_performance: bool,
    pub inputs: Vec[string],
    pub entry: string,
    pub output: string,
    pub world: Option[string],
}

pub struct TestLinkCommandArgs {
    pub inputs: Vec[string],
    pub packages: Vec[string],
    pub output: string,
    pub manifest: string,
    pub world: Option[string],
}

pub fn sorted_unique_package_inputs(values: Vec[string]) -> Vec[string] {
    let sorted = wire::sort_artifact_names(values);
    let result: Vec[string] = Vec::new();
    for value in sorted {
        if result.is_empty() || result[result.len() - 1] != value {
            result.push(value)
        }
    }
    result
}

pub fn ensure_parent(path_value: string) -> Result[(), string] {
    match path::parent(path_value) {
        Some(parent) => fs::create_dir_all(parent).map_err(|error| error.to_string()),
        None => Ok(()),
    }
}

pub fn interface_output_path(output: string) -> string {
    path::with_extension(output, "interface")
}

pub fn core_output_path(output: string) -> string {
    path::with_extension(output, "core")
}
