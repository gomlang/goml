package compiler;

use module::artifact::interface_codec;
use module::ast;
use module::checker;
use module::hir;
use module::parser;
use std::testing;

#[test]
fn body_raw_function_requirements_survive_dependency_interfaces() -> () {
    for declarations in[
        "pub fn create[T]() -> () { let value: Option[GoFunc[(T) -> T]] = None; }",
        "pub trait Make[T] { fn create(self: Self) -> () { let value: Option[GoFunc[(T) -> T]] = None; } }",
    ] {
        let unit = source_interface("package value; " + declarations);
        let encoded = testing::expect_ok(interface_codec::encode_binary(unit), "encode interface");
        let decoded = testing::expect_ok(
            interface_codec::decode_binary(encoded),
            "decode interface",
        );
        let dependency = testing::expect_ok(
            artifact_dependency_environment_from_exports(decoded.exports),
            "dependency environment",
        );
        for ty in["i32", "Vec[i32]"] {
            let source = "package consumer; use audit::value; "
                + if declarations.contains("trait") {
                    "struct Local {} impl value::Make[" + ty + "] for Local {}"
                } else {
                    "fn main() -> () { value::create::[" + ty + "](); }"
                };
            let lowered = hir::lower_package(
                ast::lower(parser::parse(source)),
                "consumer.goml",
                "audit::consumer",
            );
            let file = testing::expect_some(lowered.hir, "consumer HIR");
            let checked = checker::check_package_files_for_link_with_environments(
                Vec::from_array([file]),
                Vec::from_array([dependency]),
            );
            let mut found = false;
            for diagnostic in checked.diagnostics {
                if diagnostic.message.contains("Go function signature is not ABI-compatible") {
                    found = true;
                }
            }
            if found != (ty == "Vec[i32]") {
                testing::fail("unexpected raw ABI result for " + source);
            }
            if ty == "i32" {
                for diagnostic in checked.diagnostics {
                    testing::fail(source + ": " + diagnostic.message);
                }
            }
        }
    }
}
