package compiler;

use module::artifact::interface_codec;
use module::ast;
use module::checker;
use module::hir;
use module::parser;
use std::testing;

#[test]
fn raw_function_requirements_survive_private_field_interface_round_trips() -> () {
    for declaration in[
        "pub struct Store[T] { callback: GoFunc[(T) -> T] }",
        "pub enum Store[T] { Empty, Callback(GoFunc[(T) -> T]) }",
        "struct Hidden[T] { callback: GoFunc[(T) -> T] } pub struct Store[T] { hidden: Hidden[T] }",
    ] {
        let unit = source_interface("package value; " + declaration);
        let encoded = testing::expect_ok(interface_codec::encode_binary(unit), "encode interface");
        let decoded = testing::expect_ok(
            interface_codec::decode_binary(encoded),
            "decode interface",
        );
        if !decoded.exports.structs.is_empty() {
            testing::assert(decoded.exports.structs[0].fields.is_empty());
            testing::assert(decoded.exports.structs[0].has_hidden_fields);
            testing::assert(!decoded.exports.structs[0].raw_function_requirements.is_empty());
        }
        let dependency = testing::expect_ok(
            artifact_dependency_environment_from_exports(decoded.exports),
            "dependency environment",
        );
        for ty in["i32", "Vec[i32]"] {
            let source = "package consumer; use audit::value; pub fn unused(item: value::Store["
                + ty
                + "]) -> () {}";
            let lowered = hir::lower_package(
                ast::lower(parser::parse(source)),
                "consumer.goml",
                "audit::consumer",
            );
            let file = testing::expect_some(lowered.hir, "consumer HIR");
            let checked = checker::check_package_files_for_link_with_environments(
                Vec::from_array([file]),
                Vec::from_array([dependency]),
            );
            let mut found = false;
            for diagnostic in checked.diagnostics {
                if diagnostic.message.contains("unsupported bridge type") {
                    found = true;
                }
            }
            testing::assert_eq(found, ty == "Vec[i32]");
            if ty == "i32" {
                testing::assert(checked.diagnostics.is_empty());
            }
        }
    }
}
