package compiler;

use module::artifact::interface_codec;
use module::ast;
use module::checker;
use module::hir;
use module::parser;
use std::testing;

#[test]
fn constant_comparison_requirements_survive_interfaces_and_forwarding() -> () {
    let unit = source_interface(
        "package value; pub trait Source: PartialEq { const VALUE: Self; } impl Source for i32 { const VALUE: Self = 7; } struct Holder[T] {} impl[T: Source] Holder[T] { const SAME: bool = T::VALUE == T::VALUE; } pub fn same[T: Source]() -> bool { Holder::[T]::SAME } pub trait Defaults: PartialEq { const VALUE: Self; const SAME: bool = Self::VALUE == Self::VALUE; }",
    );
    let encoded = testing::expect_ok(
        interface_codec::encode_binary(unit),
        "encode constant comparison requirements",
    );
    let decoded = testing::expect_ok(
        interface_codec::decode_binary(encoded),
        "decode constant comparison requirements",
    );
    for exports in[unit.exports, decoded.exports] {
        let dependency = testing::expect_ok(
            artifact_dependency_environment_from_exports(exports),
            "constant comparison dependency",
        );
        for invalid in[false, true] {
            let argument = if invalid {
                "Bad"
            } else {
                "i32"
            };
            let source = "package consumer; use audit::value; struct Bad {} impl PartialEq for Bad { fn eq(self: Self, other: Self) -> bool { false } } impl value::Source for Bad { const VALUE: Self = Bad {}; } fn forward[T: value::Source]() -> bool { value::same::[T]() } pub fn read() -> bool { let same = forward::["
                + argument
                + "]; same() }";
            let lowered = hir::lower_package(
                ast::lower(parser::parse(source)),
                "consumer.goml",
                "audit::consumer",
            );
            let checked = checker::check_package_files_for_link_with_environments(
                Vec::from_array([testing::expect_some(lowered.hir, "consumer HIR")]),
                Vec::from_array([dependency]),
            );
            let mut found = false;
            for diagnostic in checked.diagnostics {
                if diagnostic.message.contains(
                    "associated constant comparison requires builtin equality",
                ) {
                    found = true;
                }
                if !invalid {
                    testing::fail(diagnostic.message)
                }
            }
            testing::assert_eq(found, invalid)
        }
        for overridden in[false, true] {
            let replacement = if overridden {
                "const SAME: bool = true;"
            } else {
                ""
            };
            let source = "package consumer; use audit::value; struct Bad {} impl PartialEq for Bad { fn eq(self: Self, other: Self) -> bool { false } } impl value::Defaults for Bad { const VALUE: Self = Bad {}; "
                + replacement
                + " }";
            let lowered = hir::lower_package(
                ast::lower(parser::parse(source)),
                "defaults.goml",
                "audit::consumer",
            );
            let checked = checker::check_package_files_for_link_with_environments(
                Vec::from_array([testing::expect_some(lowered.hir, "default consumer HIR")]),
                Vec::from_array([dependency]),
            );
            let mut found = false;
            for diagnostic in checked.diagnostics {
                if diagnostic.message.contains(
                    "associated constant comparison requires builtin equality",
                ) {
                    found = true;
                }
                if overridden {
                    testing::fail(diagnostic.message)
                }
            }
            testing::assert_eq(found, !overridden)
        }
    }
}
