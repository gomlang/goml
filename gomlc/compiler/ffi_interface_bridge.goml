package compiler;

use module::artifact;
use module::core;
use module::tast;

fn validate_interface_bridge_exports(exports: artifact::ArtifactPackageExports) -> Result[
    (),
    string,
] {
    for function in exports.functions {
        if let GoInterfaceBridge { binding, methods } = function.body {
            if let Capable = function.comptime {
                return Err("Go interface bridges must be runtime-only")
            }
            tast::validate_go_interface_bridge_callable(methods, function.ty).map_err(
                |error| "ffi-interface: " + binding + ": " + error,
            )?;
        }
    }
    Ok(())
}

pub fn validate_interface_bridge_units(
    interfaces: Vec[artifact::ArtifactInterfaceUnit],
    cores: Vec[artifact::ArtifactCoreUnit],
) -> Result[(), string] {
    for unit in interfaces {
        validate_interface_bridge_exports(unit.exports)?;
    }
    for unit in cores {
        validate_interface_bridge_exports(unit.exports)?;
        for (binding, methods, ty) in core::interface_bridge_uses(unit.core_ir) {
            tast::validate_go_interface_bridge_callable(methods, core::type_to_tast(ty)).map_err(
                |error| "ffi-interface: " + unit.package_name + ": " + binding + ": " + error,
            )?;
        }
    }
    Ok(())
}
