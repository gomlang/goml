package compiler;

use module::artifact::interface_codec;
use module::ast;
use module::checker;
use module::hir;
use module::parser;
use std::testing;

#[test]
fn body_constant_requirements_survive_dependency_interfaces() -> () {
    for declarations in[
        "struct Hidden[const N: usize] { items: [i32; N - 1] } pub fn create[const N: usize]() -> () { let value: Option[Hidden[N]] = None; }",
        "pub trait Make[const N: usize] { fn create(self: Self) -> () { let value: Option[[i32; N - 1]] = None; } }",
    ] {
        let unit = source_interface("package value; " + declarations);
        let encoded = testing::expect_ok(interface_codec::encode_binary(unit), "encode interface");
        let decoded = testing::expect_ok(
            interface_codec::decode_binary(encoded),
            "decode interface",
        );
        let dependency = testing::expect_ok(
            artifact_dependency_environment_from_exports(decoded.exports),
            "dependency environment",
        );
        for number in["0", "1"] {
            let source = "package consumer; use audit::value; "
                + if declarations.contains("trait") {
                    "struct Local {} impl value::Make[" + number + "] for Local {}"
                } else {
                    "fn forward[const N: usize]() -> () { let call = value::create::[N]; } fn main() -> () { forward::["
                        + number
                        + "](); }"
                };
            let lowered = hir::lower_package(
                ast::lower(parser::parse(source)),
                "consumer.goml",
                "audit::consumer",
            );
            let file = testing::expect_some(lowered.hir, "consumer HIR");
            let checked = checker::check_package_files_for_link_with_environments(
                Vec::from_array([file]),
                Vec::from_array([dependency]),
            );
            let mut found = false;
            for diagnostic in checked.diagnostics {
                if diagnostic.message.contains("nonnegative") {
                    found = true;
                }
                if number == "1" {
                    testing::fail(diagnostic.message);
                }
            }
            testing::assert(found == (number == "0"));
        }
    }
}
