package compiler;

use module::artifact::interface_codec;
use module::ast;
use module::checker;
use module::hir;
use module::parser;
use std::testing;

#[test]
fn trait_receiver_kinds_survive_source_and_binary_interfaces() -> () {
    for instance in[false, true] {
        let source = "package value; pub trait Static { fn count(value: i32) -> i32; } impl Static for i32 { fn count(value: i32) -> i32 { value + 1 } } "
            + if instance {
                "pub trait Instance { fn count(self: Self) -> i32; } impl Instance for i32 { fn count(self: Self) -> i32 { self + 2 } }"
            } else {
                ""
            };
        let unit = source_interface(source);
        let encoded = testing::expect_ok(interface_codec::encode_binary(unit), "encode receivers");
        let decoded = testing::expect_ok(
            interface_codec::decode_binary(encoded),
            "decode receivers",
        );
        for exports in[unit.exports, decoded.exports] {
            let dependency = testing::expect_ok(
                artifact_dependency_environment_from_exports(exports),
                "dependency receivers",
            );
            let source = "package consumer; use audit::value; use value::Static; "
                + if instance {
                    "use value::Instance; "
                } else {
                    ""
                }
                + "pub fn read(input: i32) -> i32 { input.count() }";
            let lowered = hir::lower_package(
                ast::lower(parser::parse(source)),
                "consumer.goml",
                "audit::consumer",
            );
            let checked = checker::check_package_files_for_link_with_environments(
                Vec::from_array([testing::expect_some(lowered.hir, "consumer HIR")]),
                Vec::from_array([dependency]),
            );
            if instance {
                for diagnostic in checked.diagnostics {
                    testing::fail(diagnostic.message)
                }
                testing::assert(checked.tast.is_some());
            } else {
                let mut rejected = false;
                for diagnostic in checked.diagnostics {
                    if diagnostic.message.contains("Method count not found") {
                        rejected = true;
                    }
                }
                if !rejected {
                    testing::fail("static trait function was not rejected: " + source);
                }
            }
        }
    }
}

#[test]
fn inherent_receiver_kinds_survive_source_and_binary_interfaces() -> () {
    let unit = source_interface(
        "package value; pub struct Value { pub number: i32 } impl Value { pub fn static_read(value: Self) -> i32 { value.number } pub fn read(self: Self) -> i32 { self.number } }",
    );
    let encoded = testing::expect_ok(
        interface_codec::encode_binary(unit),
        "encode inherent receivers",
    );
    let decoded = testing::expect_ok(
        interface_codec::decode_binary(encoded),
        "decode inherent receivers",
    );
    for exports in[unit.exports, decoded.exports] {
        let dependency = testing::expect_ok(
            artifact_dependency_environment_from_exports(exports),
            "inherent dependency receivers",
        );
        for pair in[
            ("input.static_read()", false),
            ("input.read()", true),
            ("value::Value::static_read(input)", true),
        ] {
            let source = "package consumer; use audit::value; pub fn read(input: value::Value) -> i32 { "
                + pair.0
                + " }";
            let lowered = hir::lower_package(
                ast::lower(parser::parse(source)),
                "consumer.goml",
                "audit::consumer",
            );
            let checked = checker::check_package_files_for_link_with_environments(
                Vec::from_array([testing::expect_some(lowered.hir, "consumer HIR")]),
                Vec::from_array([dependency]),
            );
            if checked.diagnostics.is_empty() != pair.1 {
                for diagnostic in checked.diagnostics {
                    testing::fail(diagnostic.message);
                }
                testing::fail("unexpected inherent receiver acceptance: " + source);
            }
        }
    }
}
