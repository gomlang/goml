package compiler;

use module::tast;
use std::testing;

#[test]
fn constant_validity_artifacts_preserve_trait_projection_context() -> () {
    let value = tast::Type::Projection {
        for_ty: tast::Type::Param { name: "Self" },
        name: "Item",
        trait_ref: Some(tast::TraitRef { name: "Source", args: Vec::new() }),
    };
    let encoded = artifact_trait_definition_predicate(
        tast::TypePredicate::ConstValid {
            ty: value,
            origins: Vec::from_array(["audit::Source::method"]),
        },
        "audit::Source",
        Vec::from_array(["audit::Source"]),
    );
    match encoded {
        ConstValid {
            ty: tast::Type::Projection {
                for_ty: tast::Type::Con { name },
                trait_ref: Some(reference),
                ..,
            },
            origins,
        } => {
            testing::assert_eq(origins.len(), 1);
            testing::assert_eq(origins[0], "audit::Source::method");
            testing::assert_eq(name, "Self");
            testing::assert_eq(reference.name, "audit::Source");
        },
        _ => testing::fail("trait constant requirement did not encode its projection owner"),
    }
    let decoded = artifact_dependency_trait_predicate(encoded);
    match decoded {
        ConstValid {
            ty: tast::Type::Projection {
                for_ty: tast::Type::Param { name },
                trait_ref: Some(reference),
                ..,
            },
            origins,
        } => {
            testing::assert_eq(origins.len(), 1);
            testing::assert_eq(origins[0], "audit::Source::method");
            testing::assert_eq(name, "Self");
            testing::assert_eq(reference.name, "audit::Source");
        },
        _ => testing::fail("trait constant requirement did not restore its projection owner"),
    }
}
