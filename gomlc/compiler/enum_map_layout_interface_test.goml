package compiler;

use module::artifact::interface_codec;
use module::ast;
use module::checker;
use module::diagnostic::{diagnostics_have_errors};
use module::hir;
use module::parser;
use std::testing;

#[test]
fn enum_map_comparability_uses_private_dependency_layouts() -> () {
    let unit = source_interface(
        "package value; struct Hidden[T] { value: T } pub struct Payload[T] { hidden: Hidden[T] } pub fn accept[T]() -> () { let map: Option[GoMap[Option[Payload[T]], i32]] = None; }",
    );
    let encoded = testing::expect_ok(interface_codec::encode_binary(unit), "encode interface");
    let decoded = testing::expect_ok(interface_codec::decode_binary(encoded), "decode interface");
    testing::assert_eq(decoded.exports.structs.len(), 1);
    testing::assert(decoded.exports.structs[0].fields.is_empty());
    testing::assert_eq(decoded.exports.layouts.len(), 2);
    let dependency = testing::expect_ok(
        artifact_dependency_environment_from_exports(decoded.exports),
        "dependency environment",
    );
    for ty in["i32", "Vec[i32]", "[Slice[i32]; 3]", "Slice[i32]", "() -> ()"] {
        let source = "package consumer; use audit::value; pub fn caller() -> () { value::accept::["
            + ty
            + "](); }";
        let lowered = hir::lower_package(
            ast::lower(parser::parse(source)),
            "consumer.goml",
            "audit::consumer",
        );
        let checked = checker::check_package_files_for_link_with_environments(
            Vec::from_array([testing::expect_some(lowered.hir, "consumer HIR")]),
            Vec::from_array([dependency]),
        );
        let invalid = ty == "Slice[i32]" || ty == "() -> ()";
        let mut detail = source;
        for diagnostic in checked.diagnostics {
            detail = detail + "\n" + diagnostic.message;
        }
        if diagnostics_have_errors(checked.diagnostics) != invalid {
            testing::fail("Unexpected map key diagnostics: " + detail);
        }
        if invalid {
            let mut found = false;
            for diagnostic in checked.diagnostics {
                if diagnostic.message.contains("Go map key is not comparable") {
                    found = true;
                }
            }
            if !found {
                testing::fail("Expected non-comparable key diagnostic: " + detail);
            }
        }
    }
}
