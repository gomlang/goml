#[test]
fn preserves_generic_trait_methods_in_artifacts() -> () {
    let expected = "deserialize";
    let world = test_package_world();
    let toml = required_artifact_standard_package(world.standard, resources::STD_TOML_PACKAGE);
    let exports = toml.interface_unit.exports;
    let exported = Ref::new(false);
    for implementation in exports.trait_impls {
        if implementation.trait_ref.name == "std::serde::Deserialize" {
            if let Con { name } = implementation.for_ty {
                if name == "std::toml::Value" {
                    for method in implementation.definition.methods {
                        if method.name == "deserialize" {
                            match method.body {
                                Function(name) => testing::assert_eq(name, expected),
                                _ => testing::fail("expected generic trait method callable"),
                            }
                            exported.set(true)
                        }
                    }
                }
            }
        }
    }
    testing::assert(exported.get());
    let canonical = Ref::new(false);
    for function in toml.core_value.functions {
        if function.name == "trait_impl#std::serde::Deserialize#std::toml::Value#deserialize" {
            match function.predicates[0] {
                Trait { for_ty: _, trait_ref } => {
                    testing::assert_eq(trait_ref.name, "std::serde::Deserializer");
                    canonical.set(true)
                },
                _ => testing::fail("expected deserializer predicate"),
            }
        }
    }
    testing::assert(canonical.get())
}

#[test]
fn artifact_rejects_raw_map_keys_with_uncomparable_shapes() -> () {
    let slice_type = tast::Type::Slice { elem: tast::Type::Int64 };
    for key in Vec::from_array(
        [
            slice_type,
            MutSlice { elem: tast::Type::Int64 },
            GoMap { key: tast::Type::Int64, value: tast::Type::Int64 },
            Array { len: 0, elem: slice_type },
            Tuple { items: Vec::from_array([tast::Type::Int64, slice_type]) },
            GoPointer { elem: slice_type },
            Int64,
        ],
    ) {
        let writer = wire::new_artifact_value_writer();
        tast_codec::artifact_json_type(
            writer,
            tast_codec::artifact_type_context(Vec::new(), Vec::new()),
            GoMap { key, value: tast::Type::Int64 },
        );
        let value = match wire::artifact_value_finish(writer) {
            Ok(value) => value,
            Err(error) => {
                testing::fail(error);
                return
            },
        };
        let decoded = tast_codec::artifact_decode_type(
            tast_codec::new_artifact_decode_context(),
            value,
        );
        match key {
            GoPointer { .. } | Int64 => testing::assert(decoded.is_ok()),
            _ => match decoded {
                Err(error) => testing::assert(error.contains("Go map key is not comparable")),
                Ok(_) => testing::fail("accepted invalid raw map key artifact"),
            },
        }
    }
}

#[test]
fn artifact_raw_function_signatures_are_distinct_and_validated() -> () {
    for signature in Vec::from_array(
        [
            tast::Type::Func {
                params: Vec::from_array([tast::Type::Int64]),
                ret_ty: tast::Type::Bool,
            },
            tast::Type::Func { params: Vec::new(), ret_ty: tast::Type::Unit },
            tast::Type::Int64,
            tast::Type::Func {
                params: Vec::from_array([tast::Type::Unit]),
                ret_ty: tast::Type::Unit,
            },
        ],
    ) {
        let raw = tast::Type::GoFunction { signature };
        testing::assert(!tast::types_equal(raw, signature));
        let writer = wire::new_artifact_value_writer();
        tast_codec::artifact_json_type(
            writer,
            tast_codec::artifact_type_context(Vec::new(), Vec::new()),
            raw,
        );
        let value = match wire::artifact_value_finish(writer) {
            Ok(value) => value,
            Err(error) => {
                testing::fail(error);
                return
            },
        };
        let decoded = tast_codec::artifact_decode_type(
            tast_codec::new_artifact_decode_context(),
            value,
        );
        match signature {
            Func { params, .. } if params.is_empty()
                || tast::types_equal(params[0], tast::Type::Int64) => match decoded {
                Ok(value) => testing::assert(tast::types_equal(value, raw)),
                Err(error) => testing::fail(error),
            },
            _ => testing::assert(decoded.is_err()),
        }
    }
}

#[test]
fn compiler_world_loads_standard_interfaces_and_core_on_demand() -> () {
    let world = test_package_world();
    let Ok(encoded) = encode_package_world(world) else {
        testing::fail("world encode failed");
        return
    };
    let Ok(lazy) = decode_package_world_for_command(encoded, true, false) else {
        testing::fail("lazy world decode failed");
        return
    };
    testing::assert_eq(lazy.standard.len(), 0);
    testing::assert_eq(lazy.builtins.functions.len(), 0);
    testing::assert_eq(lazy.prelude.core_value.functions.len(), 0);
    testing::assert_eq(lazy.builtins.enums.len(), world.builtins.enums.len());
    testing::assert(lazy.builtin_interface.comptime.is_some());
    let name = resources::STD_ASCII_PACKAGE;
    let Ok(()) = world_load_standard_package(lazy, name, false) else {
        testing::fail("interface load failed");
        return
    };
    let Ok(package_value) = world_required_package(lazy.standard, name) else {
        testing::fail("interface missing");
        return
    };
    testing::assert_eq(package_value.core_value.functions.len(), 0);
    testing::assert(lazy.standard.len() < world.standard.len());
    let count = lazy.standard.len();
    let Ok(()) = world_load_standard_package(lazy, name, true) else {
        testing::fail("Core load failed");
        return
    };
    let Ok(package_value) = world_required_package(lazy.standard, name) else {
        testing::fail("Core missing");
        return
    };
    testing::assert(package_value.core_value.functions.len() > 0);
    testing::assert_eq(lazy.standard.len(), count);
    let expected = required_artifact_standard_package(world.standard, name);
    testing::assert_eq(
        package_value.interface_unit.interface_hash,
        expected.interface_unit.interface_hash,
    );
    testing::assert_eq(
        package_value.core_value.functions.len(),
        expected.core_value.functions.len(),
    );
}

#[test]
fn compiler_world_trusted_loading_preserves_structure_and_identity_checks() -> () {
    let world = test_package_world();
    let Ok(encoded) = encode_package_world(world) else {
        testing::fail("world encode failed");
        return
    };
    encoded.set(38, encoded.get(38) ^ 1);
    testing::assert(decode_package_world_for_command(encoded, true, false).is_err());
    testing::assert(decode_package_world_for_command(encoded, false, false).is_ok());
    let container = match wire::decode_verified_artifact_binary_container(encoded) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            return
        },
    };
    let Ok(metadata) = world_decode_metadata(test_world_section(container, 1).data) else {
        testing::fail("metadata decode failed");
        return
    };
    let repaired = test_world_encode_sections(3, container.sections);
    let incompatible = world_with_test_metadata(
        repaired,
        WorldMetadata { compiler_identity: "different", ..metadata },
    );
    testing::assert(decode_package_world_for_command(incompatible, false, false).is_err());
    testing::assert(
        decode_package_world_for_command(
            bytes::Bytes::from_slice_copy(repaired.as_slice().sub(0, repaired.len() - 1)),
            false,
            false,
        ).is_err(),
    );
}

#[test]
fn computes_crlf_diagnostic_positions_without_column_drift() -> () {
    let source = "fn main() {\r\n\t中\r\n}";
    let start = source_position(source, 14);
    testing::assert_eq(start.line, 1);
    testing::assert_eq(start.column, 1);
    testing::assert_eq(start.line_start, 13);
    testing::assert_eq(start.line_end, 17);
    let end = source_position(source, 17);
    testing::assert_eq(end.line, 1);
    testing::assert_eq(end.column, 2)
}
