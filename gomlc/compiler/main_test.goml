#[test]
fn extracts_trait_interface_from_checked_package() -> () {
    let source = "package api; pub trait Parent[T] { fn parent(self: Self) -> T; } pub trait Child[T: ToString]: Parent[T] { fn child(self: Self) -> string; } pub struct Box[T] { value: T, } impl[T] Parent[T] for Box[T] { fn parent(self: Box[T]) -> T { self.value } } impl[T: ToString] Child[T] for Box[T] { fn child(self: Box[T]) -> string { \"child\" } } pub fn boxed[T](value: T) -> Box[T] { Box { value } }";
    let lowered_ast = ast::lower(parser::parse(source));
    let ast_values = Vec::new();
    ast_values.push(lowered_ast);
    let public_names = public_item_names(ast_values, "demo::api");
    let lowered = hir::lower_package(lowered_ast, "api/api.goml", "demo::api");
    let hir_file = match lowered.hir {
        Some(value) => value,
        None => {
            testing::fail("expected trait package HIR");
            hir::File {
                package_name: "demo::api",
                path: "api/api.goml",
                source_path: "api/api.goml",
                imports: Vec::new(),
                import_aliases: Vec::new(),
                use_traits: Vec::new(),
                public_reexports: Vec::new(),
                module_reexports: Vec::new(),
                items: Vec::new(),
                invalid_self_type_spans: Vec::new(),
            }
        },
    };
    let Ok(signatures) = checker::package_signatures(hir_file) else {
        testing::fail("expected package signatures");
        return
    };
    let checked = checker::check_package_files_for_link_with_dependencies(
        Vec::from_array([hir_file]),
        Vec::new(),
    );
    let tast_file = match checked.tast {
        Some(value) => value,
        None => {
            testing::fail("expected checked trait package");
            tast::File {
                items: Vec::new(),
                enums: Vec::new(),
                structs: Vec::new(),
                constants: Vec::new(),
                statics: Vec::new(),
            }
        },
    };
    let exports = required_artifact_package_exports(
        tast_file,
        signatures,
        "demo::api",
        public_names,
        Vec::new(),
        true,
        Vec::new(),
        Vec::new(),
    );
    let package_interface = artifact_package_interface("demo::api", "api", exports);
    let artifact_unit = interface_codec::new_unit(
        "demo::api",
        exports,
        package_interface,
        Vec::from_array(
            [("builtin", "03e930c72ad34b9d78ee4c6c55838bbd390ab7c11161e6edd7c6f616725f7cc8")],
        ),
    );
    testing::assert_eq(
        artifact_unit.interface_hash,
        "e7e3bacc494d0c464805b3f2d4fecb49c5cd744b39f59a18237357b7083b1669",
    );
    let encoded = interface_codec::encode_json(artifact_unit, false);
    let binary = match interface_codec::encode_binary(artifact_unit) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            bytes::Bytes::new()
        },
    };
    match interface_codec::decode_binary(binary) {
        Ok(value) => {
            testing::assert_eq(interface_codec::encode_json(value, false), encoded);
            let dependency = match artifact_dependency_environment_from_exports(value.exports) {
                Ok(value) => value,
                Err(error) => {
                    testing::fail(error.to_string());
                    tast::dependency_environment(
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                    )
                },
            };
            let consumer = hir::lower_package(
                ast::lower(
                    parser::parse(
                        "package consumer; use demo::api; use api::Child; pub fn consume() -> string { api::boxed(1).child() }",
                    ),
                ),
                "consumer/consumer.goml",
                "demo::consumer",
            );
            let consumer_hir = match consumer.hir {
                Some(value) => value,
                None => {
                    testing::fail("expected consumer HIR");
                    hir::File {
                        package_name: "demo::consumer",
                        path: "consumer/consumer.goml",
                        source_path: "consumer/consumer.goml",
                        imports: Vec::new(),
                        import_aliases: Vec::new(),
                        use_traits: Vec::new(),
                        public_reexports: Vec::new(),
                        module_reexports: Vec::new(),
                        items: Vec::new(),
                        invalid_self_type_spans: Vec::new(),
                    }
                },
            };
            let checked = checker::check_package_files_for_link_with_environments(
                Vec::from_array([consumer_hir]),
                Vec::from_array([dependency]),
            );
            testing::assert_eq(checked.diagnostics.len(), 0)
        },
        Err(error) => testing::fail(error.to_string()),
    }
}

#[test]
fn writes_core_unit_from_checked_package() -> () {
    let source = "package value; fn private_value() -> i32 { 41 } pub fn value() -> i32 { private_value() + 1 }";
    let lowered_ast = ast::lower(parser::parse(source));
    let ast_values = Vec::new();
    ast_values.push(lowered_ast);
    let public_names = public_item_names(ast_values, "audit::value");
    let lowered = hir::lower_package(lowered_ast, "value/value.goml", "audit::value");
    let hir_file = match lowered.hir {
        Some(value) => value,
        None => {
            testing::fail("expected core package HIR");
            hir::File {
                package_name: "audit::value",
                path: "value/value.goml",
                source_path: "value/value.goml",
                imports: Vec::new(),
                import_aliases: Vec::new(),
                use_traits: Vec::new(),
                public_reexports: Vec::new(),
                module_reexports: Vec::new(),
                items: Vec::new(),
                invalid_self_type_spans: Vec::new(),
            }
        },
    };
    let Ok(signatures) = checker::package_signatures(hir_file) else {
        testing::fail("expected package signatures");
        return
    };
    let checked = checker::check_package_files_for_link_with_dependencies(
        Vec::from_array([hir_file]),
        Vec::new(),
    );
    let tast_file = match checked.tast {
        Some(value) => value,
        None => {
            testing::fail("expected checked core package");
            tast::File {
                items: Vec::new(),
                enums: Vec::new(),
                structs: Vec::new(),
                constants: Vec::new(),
                statics: Vec::new(),
            }
        },
    };
    let public_exports = required_artifact_package_exports(
        tast_file,
        signatures,
        "audit::value",
        public_names,
        Vec::new(),
        true,
        Vec::new(),
        Vec::new(),
    );
    let full_exports = required_artifact_package_exports(
        tast_file,
        signatures,
        "audit::value",
        public_names,
        Vec::new(),
        false,
        Vec::new(),
        Vec::new(),
    );
    let deps = Vec::from_array(
        [("builtin", "03e930c72ad34b9d78ee4c6c55838bbd390ab7c11161e6edd7c6f616725f7cc8")],
    );
    let interface_unit = interface_codec::new_unit(
        "audit::value",
        public_exports,
        artifact_package_interface("audit::value", "value", public_exports),
        deps,
    );
    let core_ir = core::lower_with_counter_and_types(
        checked.tast,
        Ref::new(0),
        Vec::new(),
        Vec::new(),
    );
    let core_unit = artifact::ArtifactCoreUnit {
        source_origins: Vec::new(),
        package_name: "audit::value",
        declared_name: "value",
        interface_hash: interface_unit.interface_hash,
        exports: full_exports,
        core_ir,
        deps,
        sources: Vec::from_array(["/tmp/gomlc-test-link-audit/value/value.goml"]),
        tests: Vec::new(),
    };
    let encoded = core_codec::encode_json(core_unit, false);
    testing::assert_eq(
        hash::sha256_hex(encoded),
        "b5b995730cecb80ae870ab2930b8a85f391305b5a4bcc6fd4ed2731f9cf362ed",
    );
    let binary = match core_codec::encode_binary(core_unit) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            bytes::Bytes::new()
        },
    };
    match core_codec::decode_binary(binary) {
        Ok(value) => testing::assert_eq(core_codec::encode_json(value, false), encoded),
        Err(error) => testing::fail(error.to_string()),
    }
}

#[test]
fn restores_core_metadata_from_artifact_exports() -> () {
    let exports = interface_codec::empty_exports();
    let function_constraint = tast::TypePredicate::Equality {
        lhs: tast::Type::Param { name: "T" },
        rhs: tast::Type::Int32,
    };
    exports.functions.push(
        artifact::ArtifactFnScheme {
            comptime: tast::ComptimeCapability::RuntimeOnly,
            name: "audit::identity",
            type_params: Vec::from_array(["T"]),
            constraints: Vec::from_array([function_constraint]),
            ty: tast::Type::Func {
                params: Vec::from_array([tast::Type::Param { name: "T" }]),
                ret_ty: tast::Type::Param { name: "T" },
            },
            body: tast::Callable::Function("audit::identity"),
        },
    );
    let empty_body = core::Block { stmts: Vec::new(), tail: Option::None };
    let function = artifact_prepare_core_function_metadata(
        core::Function {
            name: "audit::identity",
            origin: core::FunctionOrigin::Source,
            root: false,
            generics: Vec::from_array(["T"]),
            predicates: Vec::new(),
            trait_impl: Option::None,
            params: Vec::from_array([("value", core::Type::Param { name: "T" })]),
            ret_ty: core::Type::Param { name: "T" },
            body: empty_body,
        },
        exports,
    );
    testing::assert_eq(function.predicates.len(), 1);
    let trait_ref = tast::TraitRef { name: "audit::Source", args: Vec::new() };
    let impl_constraint = tast::TypePredicate::Trait {
        for_ty: tast::Type::Con { name: "audit::Numbers" },
        trait_ref: tast::TraitRef { name: "ToString", args: Vec::new() },
    };
    let method_constraint = tast::TypePredicate::Equality {
        lhs: tast::Type::Int32,
        rhs: tast::Type::Int32,
    };
    exports.trait_impls.push(
        artifact::ArtifactTraitImpl {
            trait_ref,
            for_ty: tast::Type::Con { name: "audit::Numbers" },
            definition: artifact::ArtifactImplDef {
                params: Vec::new(),
                constraints: Vec::from_array([impl_constraint]),
                associated_types: Vec::from_array([("Item", tast::Type::Int32)]),
                methods: Vec::from_array(
                    [
                        artifact::ArtifactFnScheme {
                            comptime: tast::ComptimeCapability::RuntimeOnly,
                            name: "read",
                            type_params: Vec::new(),
                            constraints: Vec::from_array([method_constraint]),
                            ty: tast::Type::Func {
                                params: Vec::from_array(
                                    [tast::Type::Con { name: "audit::Numbers" }],
                                ),
                                ret_ty: tast::Type::Int32,
                            },
                            body: tast::Callable::TraitMethod {
                                trait_ref,
                                method_name: "read",
                                for_ty: tast::Type::Con { name: "audit::Numbers" },
                                has_receiver: true,
                            },
                        },
                    ],
                ),
                valid: true,
            },
        },
    );
    let method = artifact_prepare_core_function_metadata(
        core::Function {
            name: "audit::Numbers#audit::Source#read",
            origin: core::FunctionOrigin::TraitImplementation { method_name: "read" },
            root: false,
            generics: Vec::new(),
            predicates: Vec::new(),
            trait_impl: Option::Some(
                core::TraitImpl {
                    trait_ref: core::lower_trait_ref(trait_ref),
                    for_ty: core::Type::Con { name: "audit::Numbers" },
                    associated_types: Vec::new(),
                    generic_count: 0,
                    predicate_count: 0,
                },
            ),
            params: Vec::from_array([("self", core::Type::Con { name: "audit::Numbers" })]),
            ret_ty: core::Type::Int32,
            body: empty_body,
        },
        exports,
    );
    testing::assert_eq(method.predicates.len(), 2);
    match method.trait_impl {
        Some(metadata) => {
            testing::assert_eq(metadata.associated_types.len(), 1);
            testing::assert_eq(metadata.associated_types[0].0, "Item");
            match metadata.associated_types[0].1 {
                Int32 => (),
                _ => testing::fail("expected restored associated type"),
            }
        },
        None => testing::fail("expected trait implementation metadata"),
    }
}

#[test]
fn parses_artifact_json_values() -> () {
    let parsed = match json::parse(
        " { \"text\": \"quote\\\" slash\\\\ zero\\u0000 face\\uD83D\\uDE00 é\", \"nums\": [-12, 1.5e+2], \"ok\": true, \"none\": null } ",
    ) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            Null
        },
    };
    match parsed {
        Object(fields) => {
            testing::assert_eq(fields.len(), 4);
            testing::assert_eq(fields[0].0, "text");
            match fields[0].1 {
                String(value) => testing::assert_eq(value, "quote\" slash\\ zero\u0000 face😀 é"),
                _ => testing::fail("expected JSON string"),
            }
            match fields[1].1 {
                Array(values) => {
                    match values[0] {
                        Number(value) => testing::assert_eq(value, "-12"),
                        _ => testing::fail("expected integer JSON number"),
                    }
                    match values[1] {
                        Number(value) => testing::assert_eq(value, "1.5e+2"),
                        _ => testing::fail("expected float JSON number"),
                    }
                },
                _ => testing::fail("expected JSON array"),
            }
            match fields[2].1 {
                Bool(value) => testing::assert(value),
                _ => testing::fail("expected JSON boolean"),
            }
            match fields[3].1 {
                Null => (),
                _ => testing::fail("expected JSON null"),
            }
        },
        _ => testing::fail("expected JSON object"),
    }
    if let Ok(_) = json::parse("[01]") {
        testing::fail("expected invalid JSON number")
    }
    if let Ok(_) = json::parse("{} trailing") {
        testing::fail("expected trailing JSON error")
    }
}

#[test]
fn decodes_artifact_type_shapes() -> () {
    let type_json = "{\"TFunc\":{\"params\":[{\"TApp\":{\"ty\":{\"TEnum\":{\"name\":\"Option\"}},\"args\":[\"TInt32\"]}}],\"ret_ty\":{\"TProjection\":{\"trait_ref\":{\"name\":\"Iterator\",\"args\":[]},\"for_ty\":{\"TParam\":{\"name\":\"I\"}},\"name\":\"Item\"}}}}";
    let context = tast_codec::new_artifact_decode_context();
    let type_value = tast::Type::Func {
        params: Vec::from_array(
            [
                App {
                    ty: tast::Type::Con { name: "Option" },
                    args: Vec::from_array([tast::Type::Int32]),
                },
            ],
        ),
        ret_ty: tast::Type::Projection {
            trait_ref: Option::Some(tast::TraitRef { name: "Iterator", args: Vec::new() }),
            for_ty: tast::Type::Param { name: "I" },
            name: "Item",
        },
    };
    let value_writer = wire::new_artifact_value_writer();
    tast_codec::artifact_json_type(
        value_writer,
        tast_codec::artifact_type_context(Vec::from_array(["Option"]), Vec::new()),
        type_value,
    );
    let type_value = match wire::artifact_value_finish(value_writer) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            Null
        },
    };
    let decoded = match tast_codec::artifact_decode_type(context, type_value) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            Error
        },
    };
    let writer = wire::new_artifact_json_writer(false);
    tast_codec::artifact_json_type(
        writer,
        tast_codec::artifact_type_context(context.enum_names, context.struct_names),
        decoded,
    );
    testing::assert_eq(wire::artifact_json_finish(writer), type_json);
    testing::assert_eq(context.enum_names.len(), 1);
    testing::assert_eq(context.enum_names[0], "Option");
    let predicate_json = "{\"Equality\":{\"lhs\":{\"TStruct\":{\"name\":\"Box\"}},\"rhs\":\"TInt32\"}}";
    let predicate_value = tast::TypePredicate::Equality {
        lhs: tast::Type::Con { name: "Box" },
        rhs: tast::Type::Int32,
    };
    let value_writer = wire::new_artifact_value_writer();
    tast_codec::artifact_json_type_predicate(
        value_writer,
        tast_codec::artifact_type_context(Vec::new(), Vec::from_array(["Box"])),
        predicate_value,
    );
    let predicate_value = match wire::artifact_value_finish(value_writer) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            Null
        },
    };
    let predicate = match tast_codec::artifact_decode_predicate(context, predicate_value) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            Equality { lhs: tast::Type::Error, rhs: tast::Type::Error }
        },
    };
    let writer = wire::new_artifact_json_writer(false);
    tast_codec::artifact_json_type_predicate(
        writer,
        tast_codec::artifact_type_context(context.enum_names, context.struct_names),
        predicate,
    );
    testing::assert_eq(wire::artifact_json_finish(writer), predicate_json)
}

fn toolchain_dependency_test_interface(package_name: string, deps: Vec[(string, string)]) -> artifact::ArtifactInterfaceUnit {
    let exports = interface_codec::empty_exports();
    interface_codec::new_unit(
        package_name,
        exports,
        artifact::ArtifactPackageInterface {
            package_name,
            name: package_name,
            value_exports: Vec::new(),
            enum_variants: Vec::new(),
        },
        deps,
    )
}

#[test]
fn diagnoses_builtin_and_prelude_interface_mismatches_separately() -> () {
    let world = test_package_world();
    let builtin_mismatch = toolchain_dependency_test_interface(
        "demo::dependency",
        Vec::from_array([("builtin", "wrong"), ("prelude", artifact_prelude_interface_hash(world))]),
    );
    match artifact_resolve_interface_units(
        world,
        "demo::app",
        Vec::from_array(["demo::dependency"]),
        Vec::from_array([builtin_mismatch]),
    ) {
        Ok(_) => testing::fail("expected builtin interface mismatch"),
        Err(error) => testing::assert(
            main_string_contains(error, "different builtin interface_hash"),
        ),
    }
    let prelude_mismatch = toolchain_dependency_test_interface(
        "demo::dependency",
        Vec::from_array([("builtin", artifact_builtin_interface_hash(world)), ("prelude", "wrong")]),
    );
    match artifact_resolve_interface_units(
        world,
        "demo::app",
        Vec::from_array(["demo::dependency"]),
        Vec::from_array([prelude_mismatch]),
    ) {
        Ok(_) => testing::fail("expected prelude interface mismatch"),
        Err(error) => testing::assert(
            main_string_contains(error, "different prelude interface_hash"),
        ),
    }
}

fn test_world_container(value: bytes::Bytes) -> wire::ArtifactBinaryContainer {
    match wire::decode_artifact_binary_container(value) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            wire::ArtifactBinaryContainer { kind: 3, sections: Vec::new() }
        },
    }
}

fn test_world_section(value: wire::ArtifactBinaryContainer, id: u16) -> wire::ArtifactBinarySection {
    match wire::artifact_binary_find_section(value, id) {
        Some(value) => value,
        None => {
            testing::fail("expected compiler world section");
            wire::ArtifactBinarySection {
                id,
                version: 1,
                flags: wire::required_section_flag(),
                data: bytes::Bytes::new(),
            }
        },
    }
}

fn test_world_encode_sections(kind: u8, sections: Vec[wire::ArtifactBinarySection]) -> bytes::Bytes {
    match wire::encode_artifact_binary_container(kind, sections) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            bytes::Bytes::new()
        },
    }
}

fn world_without_test_section(value: bytes::Bytes, id: u16) -> bytes::Bytes {
    let container = test_world_container(value);
    let sections: Vec[wire::ArtifactBinarySection] = Vec::new();
    for section in container.sections {
        if section.id != id {
            sections.push(section)
        }
    }
    test_world_encode_sections(container.kind, sections)
}

fn world_with_test_section_version(value: bytes::Bytes, id: u16, version: u16) -> bytes::Bytes {
    let container = test_world_container(value);
    let sections: Vec[wire::ArtifactBinarySection] = Vec::new();
    for section in container.sections {
        sections.push(
            if section.id == id {
                wire::ArtifactBinarySection {
                    id: section.id,
                    version,
                    flags: section.flags,
                    data: section.data,
                }
            } else {
                section
            },
        )
    }
    test_world_encode_sections(container.kind, sections)
}

fn world_with_test_metadata(value: bytes::Bytes, metadata: WorldMetadata) -> bytes::Bytes {
    let container = test_world_container(value);
    let sections: Vec[wire::ArtifactBinarySection] = Vec::new();
    for section in container.sections {
        sections.push(
            if section.id == 1.to_u16() {
                wire::ArtifactBinarySection {
                    id: section.id,
                    version: section.version,
                    flags: section.flags,
                    data: world_encode_metadata(metadata),
                }
            } else {
                section
            },
        )
    }
    test_world_encode_sections(container.kind, sections)
}

fn replaced_test_dependency(values: Vec[(string, string)], name: string, hash: string) -> Vec[
    (string, string),
] {
    let result: Vec[(string, string)] = Vec::new();
    for value in values {
        result.push(
            if value.0 == name {
                (name, hash)
            } else {
                value
            },
        )
    }
    result
}

fn world_with_test_package_dependency(
    value: bytes::Bytes,
    section_id: u16,
    dependency_name: string,
    dependency_hash: string,
) -> bytes::Bytes {
    let container = test_world_container(value);
    let interface_section = test_world_section(container, section_id);
    let core_section = test_world_section(container, section_id + 1);
    let interface = match interface_codec::decode_binary(interface_section.data) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            toolchain_dependency_test_interface("invalid", Vec::new())
        },
    };
    let core_unit = match core_codec::decode_binary(core_section.data) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            world_core_unit(
                "invalid",
                "invalid",
                interface,
                interface.exports,
                core::File {
                    functions: Vec::new(),
                    enums: Vec::new(),
                    structs: Vec::new(),
                    type_instances: Vec::new(),
                    constants: Vec::new(),
                    statics: Vec::new(),
                },
            )
        },
    };
    let deps = replaced_test_dependency(interface.deps, dependency_name, dependency_hash);
    let interface = interface_codec::new_unit_with_comptime(
        interface.package_name,
        interface.exports,
        interface.package_interface,
        interface.comptime,
        deps,
    );
    let core_unit = artifact::ArtifactCoreUnit {
        source_origins: Vec::new(),
        package_name: core_unit.package_name,
        declared_name: core_unit.declared_name,
        interface_hash: interface.interface_hash,
        exports: core_unit.exports,
        core_ir: core_unit.core_ir,
        deps,
        sources: core_unit.sources,
        tests: core_unit.tests,
    };
    let interface_data = match interface_codec::encode_binary(interface) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            bytes::Bytes::new()
        },
    };
    let core_data = match core_codec::encode_binary(core_unit) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            bytes::Bytes::new()
        },
    };
    let sections: Vec[wire::ArtifactBinarySection] = Vec::new();
    for section in container.sections {
        sections.push(
            if section.id == section_id {
                wire::ArtifactBinarySection {
                    id: section.id,
                    version: section.version,
                    flags: section.flags,
                    data: interface_data,
                }
            } else if section.id == section_id + 1 {
                wire::ArtifactBinarySection {
                    id: section.id,
                    version: section.version,
                    flags: section.flags,
                    data: core_data,
                }
            } else {
                section
            },
        )
    }
    test_world_encode_sections(container.kind, sections)
}

fn assert_world_decode_error(value: bytes::Bytes, expected: string) -> () {
    match decode_package_world(value) {
        Ok(_) => testing::fail("expected compiler world decode error"),
        Err(error) => testing::assert(main_string_contains(error, expected)),
    }
}

fn world_test_package_section_id(value: bytes::Bytes, package_name: string) -> u16 {
    let container = match wire::decode_artifact_binary_container(value) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            wire::ArtifactBinaryContainer { kind: 3, sections: Vec::new() }
        },
    };
    let mut index = 1;
    while index < container.sections.len() {
        let section = container.sections[index];
        match interface_codec::decode_binary(section.data) {
            Ok(interface) => if interface.package_name == package_name {
                return section.id
            },
            Err(error) => testing::fail(error.to_string()),
        }
        index += 2;
    }
    testing::fail("missing world test package " + package_name);
    0.to_u16()
}

#[test]
fn prelude_source_reexports_match_the_builtin_surface() -> () {
    let prelude = compile_prelude_package(
        lower_builtin_core(Ref::new(0)),
        builtin_artifact_interface_unit(),
    );
    let names = resources::prelude_builtin_export_names();
    testing::assert_eq(prelude.hir_file.public_reexports.len(), names.len());
    for name in names {
        let found = Ref::new(false);
        for reexport in prelude.hir_file.public_reexports {
            if reexport.0 == name && reexport.1 == "builtin::" + name {
                found.set(true)
            }
        }
        if found.get() {} else {
            testing::fail("prelude source does not re-export " + name)
        }
    }
}

fn builtin_artifact_dependency() -> (string, string) {
    ("builtin", builtin_artifact_interface_unit().interface_hash)
}

fn prelude_artifact_dependency() -> (string, string) {
    let builtins = lower_builtin_core(Ref::new(0));
    let builtin_interface = builtin_artifact_interface_unit();
    ("prelude", compile_prelude_package(builtins, builtin_interface).interface_unit.interface_hash)
}

#[test]
fn standard_interface_hashes_are_stable() -> () {
    let world = package_world();
    let builtin = artifact_builtin_interface_hash(world);
    let prelude = artifact_prelude_interface_hash(world);
    testing::assert_eq(builtin, builtin_artifact_dependency().1);
    testing::assert_eq(prelude, prelude_artifact_dependency().1);
    testing::assert_eq(builtin.byte_len(), 64);
    testing::assert_eq(prelude.byte_len(), 64);
    testing::assert(
        artifact_interface_has_dependency(world.prelude.interface_unit, "builtin", builtin),
    );
    testing::assert(
        artifact_interface_has_dependency(
            required_artifact_standard_package(world.standard, resources::STD_ASCII_PACKAGE).interface_unit,
            "builtin",
            builtin,
        ),
    );
    testing::assert(
        artifact_interface_has_dependency(
            required_artifact_standard_package(world.standard, resources::STD_ASCII_PACKAGE).interface_unit,
            "prelude",
            prelude,
        ),
    );
    let first = world.standard;
    let second = package_world().standard;
    testing::assert_eq(first.len(), second.len());
    for package_value in first {
        testing::assert_eq(
            package_value.interface_unit.interface_hash,
            required_artifact_standard_package(second, package_value.interface_unit.package_name).interface_unit.interface_hash,
        )
    }
}

#[test]
fn compiler_world_artifact_round_trips() -> () {
    let world = test_package_world();
    world.source_digest = "source-digest";
    let first = match encode_package_world(world) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            bytes::Bytes::new()
        },
    };
    let second = match encode_package_world(world) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            bytes::Bytes::new()
        },
    };
    testing::assert_eq(wire::artifact_binary_bytes_equal(first, second), true);
    match decode_package_world(first) {
        Ok(decoded) => {
            testing::assert_eq(
                decoded.builtin_interface.interface_hash,
                world.builtin_interface.interface_hash,
            );
            testing::assert_eq(decoded.prelude.interface_unit.package_name, "prelude");
            testing::assert_eq(
                decoded.prelude.interface_unit.interface_hash,
                world.prelude.interface_unit.interface_hash,
            );
            testing::assert_eq(
                decoded.prelude.core_value.functions.len(),
                world.prelude.core_value.functions.len(),
            );
            testing::assert(
                artifact_interface_has_dependency(
                    decoded.prelude.interface_unit,
                    "builtin",
                    decoded.builtin_interface.interface_hash,
                ),
            );
            testing::assert_eq(decoded.standard.len(), world.standard.len());
            for package_value in world.standard {
                let decoded_package = required_artifact_standard_package(
                    decoded.standard,
                    package_value.interface_unit.package_name,
                );
                testing::assert_eq(
                    decoded_package.interface_unit.interface_hash,
                    package_value.interface_unit.interface_hash,
                );
                testing::assert_eq(
                    decoded_package.core_value.functions.len(),
                    package_value.core_value.functions.len(),
                )
            }
            testing::assert_eq(decoded.counter.get(), world.counter.get());
            testing::assert_eq(decoded.source_digest, world.source_digest)
        },
        Err(error) => testing::fail(error.to_string()),
    }
    first.truncate(first.len() - 1);
    if let Ok(_) = decode_package_world(first) {
        testing::fail("expected truncated compiler world to fail")
    }
}

#[test]
fn compiler_world_artifact_validates_metadata_identity() -> () {
    let world = test_package_world();
    let encoded = match encode_package_world(world) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            bytes::Bytes::new()
        },
    };
    let metadata = match world_decode_metadata(
        test_world_section(test_world_container(encoded), 1.to_u16()).data,
    ) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            WorldMetadata {
                counter: 0,
                package_count: 0,
                artifact_format: WORLD_ARTIFACT_FORMAT,
                compiler_abi: WORLD_COMPILER_ABI,
                compiler_identity: version::current(),
                source_digest: "",
                builtin_package: "builtin",
                prelude_package: "prelude",
            }
        },
    };
    assert_world_decode_error(
        world_with_test_metadata(
            encoded,
            WorldMetadata { artifact_format: WORLD_ARTIFACT_FORMAT + 1, ..metadata },
        ),
        "world artifact format does not match compiler",
    );
    assert_world_decode_error(
        world_with_test_metadata(
            encoded,
            WorldMetadata { compiler_abi: WORLD_COMPILER_ABI + 1, ..metadata },
        ),
        "world compiler ABI does not match compiler",
    );
    assert_world_decode_error(
        world_with_test_metadata(
            encoded,
            WorldMetadata { compiler_identity: "different", ..metadata },
        ),
        "world compiler identity does not match compiler",
    );
    assert_world_decode_error(
        world_with_test_metadata(
            encoded,
            WorldMetadata { builtin_package: "different", ..metadata },
        ),
        "world builtin or prelude package identity does not match",
    )
}

#[test]
fn compiler_world_artifact_rejects_duplicate_and_missing_packages() -> () {
    let world = test_package_world();
    let duplicate = world_all_packages(world);
    duplicate.push(duplicate[0]);
    match world_sorted_packages(duplicate) {
        Ok(_) => testing::fail("expected duplicate world package rejection"),
        Err(error) => testing::assert(main_string_contains(error, "duplicate package builtin")),
    }
    let standard: Vec[ToolchainPackage] = Vec::new();
    for package_value in world.standard {
        if package_value.interface_unit.package_name != resources::STD_ASCII_PACKAGE {
            standard.push(package_value)
        }
    }
    let incomplete = PackageWorld {
        builtin_metadata: world.builtin_metadata,
        deferred: Vec::new(),
        counter: Ref::new(world.counter.get()),
        source_digest: world.source_digest,
        builtins: world.builtins,
        builtin_interface: world.builtin_interface,
        prelude: world.prelude,
        standard,
    };
    let encoded = match encode_package_world(incomplete) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            bytes::Bytes::new()
        },
    };
    assert_world_decode_error(encoded, "missing package " + resources::STD_ASCII_PACKAGE)
}

#[test]
fn compiler_world_artifact_validates_prelude_sections_and_hash_chain() -> () {
    let world = test_package_world();
    let encoded = match encode_package_world(world) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            bytes::Bytes::new()
        },
    };
    let prelude_section = world_test_package_section_id(encoded, "prelude");
    let ascii_section = world_test_package_section_id(encoded, resources::STD_ASCII_PACKAGE);
    assert_world_decode_error(
        world_without_test_section(encoded, prelude_section),
        "package section count does not match",
    );
    assert_world_decode_error(
        world_without_test_section(encoded, prelude_section + 1),
        "package section count does not match",
    );
    assert_world_decode_error(
        world_with_test_section_version(encoded, prelude_section, 2.to_u16()),
        "invalid world artifact section",
    );
    assert_world_decode_error(
        world_with_test_package_dependency(encoded, prelude_section, "builtin", "wrong"),
        "prelude builtin dependency does not match",
    );
    assert_world_decode_error(
        world_with_test_package_dependency(encoded, ascii_section, "prelude", "wrong"),
        "standard package prelude dependency does not match",
    )
}

