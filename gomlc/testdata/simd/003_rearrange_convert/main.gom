use std::simd;

fn bytes_reverse(a: simd::u8x16, b: simd::u8x16) -> simd::u8x16 {
    a.reverse().interleave_low(b)
}

fn floats_permute(a: simd::f32x8) -> simd::f32x8 {
    a.swizzle([7, 1, 6, 2, 5, 3, 4, 0])
}

fn words_widen(a: simd::i16x8, b: simd::i32x8) -> simd::i16x8 {
    a.to_i32().add(b).to_i16()
}

fn numbers_convert(a: simd::f32x4) -> simd::f32x4 {
    a.to_i32().to_f32()
}

fn double_convert(a: simd::f32x4, b: simd::f64x4) -> simd::f32x4 {
    a.to_f64().add(b).to_f32()
}

fn double_bits(a: simd::f64x2) -> simd::f64x2 {
    simd::f64x2::from_bits(a.to_bits().bitxor(simd::u64x2::splat(9223372036854775808)))
}

fn main() -> () {
    println(bytes_reverse(simd::u8x16::splat(1), simd::u8x16::splat(2)).to_array()[0]);
    println(floats_permute(simd::f32x8::splat(1.0)).to_array()[0]);
    println(words_widen(simd::i16x8::splat(-32768), simd::i32x8::splat(1)).to_array()[0]);
    println(numbers_convert(simd::f32x4::splat(2.9)).to_array()[0]);
    println(double_convert(simd::f32x4::splat(1.0), simd::f64x4::splat(2.0)).to_array()[0]);
    println(double_bits(simd::f64x2::splat(0.0)).to_array()[0].to_bits());
}
