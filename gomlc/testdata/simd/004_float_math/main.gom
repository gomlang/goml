use std::simd;

fn double_sse(a: simd::f64x2, b: simd::f64x2) -> f64 {
    a.mul(b).sub(a).div(b).reduce_sum()
}

fn double_select(a: simd::f64x4, b: simd::f64x4) -> simd::f64x4 {
    a.simd_le(b).select(a, b).neg().abs().sqrt().min(a).max(b)
}

fn rounding(a: simd::f32x4) -> simd::f32x4 {
    a.floor().add(a.ceil()).sub(a.trunc()).add(a.round()).add(a.round_ties_even())
}

fn fma_sse(a: simd::f32x4, b: simd::f32x4, c: simd::f32x4) -> simd::f32x4 {
    a.mul_add(b, c)
}

fn fma_avx(a: simd::f64x4, b: simd::f64x4, c: simd::f64x4) -> simd::f64x4 {
    a.mul_add(b, c)
}

fn main() -> () {
    println(double_sse(simd::f64x2::splat(1.0), simd::f64x2::splat(2.0)));
    println(double_select(simd::f64x4::splat(1.0), simd::f64x4::splat(2.0)).to_array()[0]);
    println(rounding(simd::f32x4::splat(-2.5)).to_array()[0]);
    println(
        fma_sse(simd::f32x4::splat(1.5), simd::f32x4::splat(1.25), simd::f32x4::splat(-1.0)).to_array()[0],
    );
    println(
        fma_avx(simd::f64x4::splat(1.5), simd::f64x4::splat(1.25), simd::f64x4::splat(-1.0)).to_array()[0],
    );
}
