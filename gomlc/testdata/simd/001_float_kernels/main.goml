use std::simd;

fn sse_kernel(a: simd::f32x4, b: simd::f32x4, scale: f32) -> simd::f32x4 {
    let sum = a.add(b);
    let value = sum.mul(sum).sub(a).div(simd::f32x4::splat(scale));
    a.simd_lt(b).select(value, b)
}

fn avx_kernel(a: simd::f32x8, b: simd::f32x8, scale: f32) -> f32 {
    let sum = a.add(b);
    let value = sum.mul(sum).sub(a).div(simd::f32x8::splat(scale));
    a.simd_lt(b).select(value, b).reduce_sum()
}

fn masks(a: simd::mask32x8, b: simd::mask32x8) -> bool {
    a.bitand(b).bitor(a.bitnot()).bitxor(b).any()
}

fn main() -> () {
    println(sse_kernel(simd::f32x4::splat(1.0), simd::f32x4::splat(2.0), 3.0).to_array()[0]);
    println(avx_kernel(simd::f32x8::splat(1.0), simd::f32x8::splat(2.0), 3.0));
    println(masks(simd::mask32x8::from_bitmask(85), simd::mask32x8::from_bitmask(170)));
}
