use std::simd;

fn bytes_sse(a: simd::u8x16, b: simd::u8x16) -> simd::u8x16 {
    a.simd_gt(b).select(a.mul(b).saturating_add(b).shr(3), a.bitxor(b))
}

fn words_avx(a: simd::i16x16, b: simd::i16x16) -> simd::i16x16 {
    a.saturating_sub(b).mul(b).abs().shl(2)
}

fn dwords_sse(a: simd::i32x4, b: simd::i32x4) -> simd::i32x4 {
    a.mul(b).min(a).bitnot()
}

fn qwords_sse(a: simd::u64x2, b: simd::u64x2) -> simd::u64x2 {
    a.simd_le(b).select(a.mul(b), a.max(b))
}

fn qwords_avx(a: simd::i64x4, b: simd::i64x4) -> i64 {
    a.mul(b).shr(37).reduce_sum()
}

fn main() -> () {
    println(bytes_sse(simd::u8x16::splat(251), simd::u8x16::splat(127)).to_array()[0]);
    println(words_avx(simd::i16x16::splat(-32768), simd::i16x16::splat(127)).to_array()[0]);
    println(dwords_sse(simd::i32x4::splat(-2147483648), simd::i32x4::splat(127)).to_array()[0]);
    println(
        qwords_sse(simd::u64x2::splat(18446744073709551615), simd::u64x2::splat(127)).to_array()[0],
    );
    println(qwords_avx(simd::i64x4::splat(-9223372036854775808), simd::i64x4::splat(127)));
}
