enum MaybeFn {
    Some((i32) -> i32),
    None,
}

fn next(flag: bool) -> MaybeFn {
    if flag {
        MaybeFn::Some(|x| x + 1)
    } else {
        MaybeFn::None
    }
}

fn main() -> () {
    match next(true) {
        MaybeFn::Some(f) => println(f(41).to_string()),
        MaybeFn::None => println("none"),
    }
}
