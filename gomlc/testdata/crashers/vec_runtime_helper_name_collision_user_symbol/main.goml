fn vec_new__Vec_5int32() -> i32 {
    10
}

fn vec_push__Vec_5int32(value: i32) -> i32 {
    value + 20
}

fn vec_get__Vec_5int32(value: i32) -> i32 {
    value + 30
}

fn vec_set__Vec_5int32(value: i32) -> i32 {
    value + 40
}

fn vec_len__Vec_5int32(value: i32) -> i32 {
    value + 50
}

fn main() -> () {
    let values: Vec[i32] = Vec::new();
    values.push(7);
    values.set(0, 8);
    println(values.get(0));
    println(values.len());
    println(vec_new__Vec_5int32());
    println(vec_push__Vec_5int32(1));
    println(vec_get__Vec_5int32(2));
    println(vec_set__Vec_5int32(3));
    println(vec_len__Vec_5int32(4));
}
