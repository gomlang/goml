trait Display {
    fn display(self: Self) -> string;
}

fn dyn__Display() -> i32 {
    1
}

struct Box {
    text: string,
}

impl Display for Box {
    fn display(self: Self) -> string {
        self.text
    }
}

fn main() -> () {
    let d: dyn Display = Box { text: "ok" } as dyn Display;
    println(Display::display(d) + dyn__Display().to_string());
}
