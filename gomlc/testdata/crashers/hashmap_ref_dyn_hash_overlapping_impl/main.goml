impl PartialEq for Ref[dyn Hash] {
    fn eq(self: Ref[dyn Hash], other: Ref[dyn Hash]) -> bool {
        Hash::hash(self.get()) == Hash::hash(other.get())
    }
}

impl Eq for Ref[dyn Hash] {}

impl Hash for Ref[dyn Hash] {
    fn hash(self: Ref[dyn Hash]) -> u64 {
        Hash::hash(self.get())
    }
}

fn main() -> () {
    let h: HashMap[Ref[dyn Hash], string] = HashMap::new();
    let inner: dyn Hash = 1 as dyn Hash;
    let r = Ref::new(inner);
    h.set(r, "one");
    println(h.contains(r));
}
