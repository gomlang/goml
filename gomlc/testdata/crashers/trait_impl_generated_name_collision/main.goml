trait A_B {
    fn foo(self: Self) -> i32;
}

trait A {
    fn foo(self: Self) -> i32;
}

struct C {}

struct B_C {}

impl A_B for C {
    fn foo(self: C) -> i32 {
        10
    }
}

impl A for B_C {
    fn foo(self: B_C) -> i32 {
        20
    }
}

fn main() -> () {
    println(A_B::foo(C {}));
    println(A::foo(B_C {}));
}
