struct Number {
    value: i32,
}

impl Hash for Number {
    fn hash(self: Number) -> u64 {
        Hash::hash(self.value)
    }
}

fn main() -> () {
    let h: HashMap[Ref[dyn Hash], string] = HashMap::new();
    let inner: dyn Hash = Number { value: 1 } as dyn Hash;
    let r = Ref::new(inner);
    h.set(r, "one");
    println(h.contains(r).to_string());
}
