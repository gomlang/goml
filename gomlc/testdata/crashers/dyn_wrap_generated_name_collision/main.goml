trait A {
    fn foo(self: Self) -> i32;
    fn b__foo(self: Self) -> i32;
}

struct C {}

struct C__B {}

impl A for C {
    fn foo(self: C) -> i32 {
        1
    }

    fn b__foo(self: C) -> i32 {
        2
    }
}

impl A for C__B {
    fn foo(self: C__B) -> i32 {
        10
    }

    fn b__foo(self: C__B) -> i32 {
        20
    }
}

fn main() -> () {
    let left: dyn A = C {} as dyn A;
    let right: dyn A = C__B {} as dyn A;
    println(A::b__foo(left));
    println(A::foo(right));
}
