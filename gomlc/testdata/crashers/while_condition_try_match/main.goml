fn step(i: i32) -> Option[bool] {
    match i {
        0 => Option::Some(true),
        1 => Option::Some(true),
        2 => Option::Some(false),
        _ => Option::None,
    }
}

fn main() -> Option[()] {
    let i = Ref::new(0);
    while match step(i.get())? {
        true => {
            i.set(i.get() + 1);
            true
        },
        false => false,
    } {
        ()
    };
    Option::Some(())
}
