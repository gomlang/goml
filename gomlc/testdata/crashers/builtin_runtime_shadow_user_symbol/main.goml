fn hashmap_new() -> i32 {
    7
}

fn ref(x: i32) -> i32 {
    x + 1
}

fn vec_len() -> i32 {
    9
}

fn int32_to_string() -> string {
    "user"
}

fn main() -> () {
    let m: HashMap[i32, i32] = HashMap::new();
    m.set(1, 2);
    println(hashmap_new());
    println(m.len());

    let r = Ref::new(2);
    println(ref(3));
    println(r.get());

    let v: Vec[i32] = Vec::new();
    v.push(1);
    println(vec_len());
    println(v.len());

    println(int32_to_string());
    println(3.to_string());
}
