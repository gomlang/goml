struct Key {
    value: dyn Hash,
}

impl Hash for Key {
    fn hash(self: Key) -> u64 {
        Hash::hash(self.value)
    }
}

impl PartialEq for Key {
    fn eq(self: Key, other: Key) -> bool {
        Hash::hash(self.value) == Hash::hash(other.value)
    }
}

impl Eq for Key {}

fn main() {
    let h: HashMap[Key, string] = HashMap::new();
    let inner = Key { value: 1 as dyn Hash };
    h.set(inner, "one");
    println(h.contains(inner).to_string());
}
