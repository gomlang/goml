trait Callable {
    fn call(self: Self, arg1: i32) -> i32;
}

impl Callable for (i32) -> i32 {
    fn call(self: (i32) -> i32, x: i32) -> i32 {
        self(x)
    }
}

fn build() -> (i32) -> i32 {
    let m: HashMap[i32, dyn Callable] = HashMap::new();
    m.set(1, return |x: i32| x + 1);
    |x: i32| x
}

fn main() -> () {
    let f = build();
    println(f(41).to_string())
}
