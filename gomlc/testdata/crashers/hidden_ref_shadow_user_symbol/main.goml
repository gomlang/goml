fn ref(x: i32) -> Ref[i32] {
    println("user ref " + x.to_string());
    Ref::new(x + 10)
}

fn ref_get(r: Ref[i32]) -> i32 {
    println("user get");
    100
}

fn ref_set(r: Ref[i32], x: i32) -> () {
    println("user set " + x.to_string());
}

fn main() -> () {
    let mut x = 0;
    let inc = || {
        x = x + 1;
        x
    };
    println(inc().to_string());
    println(x.to_string());
}
