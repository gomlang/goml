trait Display: Hash {
    fn show(self: Self) -> string;
}

struct Number {
    value: i32,
}

impl Display for Number {
    fn show(self: Number) -> string {
        self.value.to_string()
    }
}

impl Hash for Number {
    fn hash(self: Number) -> u64 {
        string_hash(Display::show(self))
    }
}

fn main() -> () {
    let inner: dyn Display = Number { value: 1 } as dyn Display;
    let r = Ref::new(inner);
    let alias = r;
    let before = Hash::hash(r);
    let replacement: dyn Display = Number { value: 2 } as dyn Display;
    r.set(replacement);
    println((before == Hash::hash(alias)).to_string());
}
