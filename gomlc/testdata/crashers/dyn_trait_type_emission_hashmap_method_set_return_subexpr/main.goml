trait Display {
    fn show(self: Self) -> string;
}

impl Display for i32 {
    fn show(self: i32) -> string {
        self.to_string()
    }
}

fn build() -> i32 {
    let m: HashMap[i32, dyn Display] = HashMap::new();
    m.set(1, return 7);
    0
}

fn main() -> () {
    println(build().to_string())
}
