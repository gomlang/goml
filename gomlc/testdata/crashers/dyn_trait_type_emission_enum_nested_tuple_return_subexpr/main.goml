trait Display {
    fn show(self: Self) -> string;
}

impl Display for i32 {
    fn show(self: i32) -> string {
        self.to_string()
    }
}

enum Boxed[T] {
    One((T, i32)),
}

fn build() -> i32 {
    let _: Boxed[dyn Display] = Boxed::One((return 7, 0));
    0
}

fn main() -> () {
    println(build().to_string())
}
