package main;
fn tuple_case() -> i32 {
    let _: (i32, i32) = (return 1, 2);
    0
}

fn array_case() -> i32 {
    let _: [i32; 2] = [return 1, 2];
    0
}

fn proj_case() -> i32 {
    let _: i32 = return 1.0;
    0
}

fn index_case() -> i32 {
    let _: i32 = return 1[0];
    0
}

fn field_case() -> i32 {
    let _: i32 = return 1.value;
    0
}

fn main() -> () {}

