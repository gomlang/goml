impl[S] Pick[S::Item] for S where S: Source {
  fn pick(self/0: S) -> S::Item {
      (Source::get : (S) -> S::Item)((self/0 : S))
  }
}

impl Source for Value {
  fn get(self/1: Value) -> i32 {
      (self/1 : Value).value
  }
}

fn copy[S](source/2: S) -> S::Item where S: Source, S: Pick[S::Item] {
    let value/3: S::Item = (Pick[S::Item]::pick : (S) -> S::Item)((source/2 : S));
    let identity/5: (S::Item) -> S::Item = |item/4: S::Item| => (item/4 : S::Item);
    (identity/5 : (S::Item) -> S::Item)((value/3 : S::Item))
}

fn main() -> () {
    let direct/6: i32 = (Pick[Value::Item]::pick : (Value) -> i32)(Value { value: 41 });
    (println : (i32) -> ())((direct/6 : i32));
    (println : (i32) -> ())((copy : (Value) -> i32)(Value { value: 42 }));
}