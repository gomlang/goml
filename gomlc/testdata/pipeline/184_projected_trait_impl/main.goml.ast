package main;
trait Source {
  type Item;
  fn get(self: Self) -> Self::Item;
}

trait Pick[T] {
  fn pick(self: Self) -> T;
}

impl[S: Source] Pick[S::Item] for S {
  fn pick(self: S) -> S::Item {
      Source::get(self)
  }
}

struct Value {
    value: i32,
}

impl Source for Value {
  type Item = i32;
  fn get(self: Value) -> i32 {
      self.value
  }
}

fn copy[S: Source + Pick[S::Item]](source: S) -> S::Item {
    let value: S::Item = Pick::[S::Item]::pick(source);
    let identity = |item: S::Item| item;
    identity(value)
}

fn main() -> () {
    let direct: i32 = Value { value: 41 }.pick();
    println(direct);
    println(copy(Value { value: 42 }));
}

