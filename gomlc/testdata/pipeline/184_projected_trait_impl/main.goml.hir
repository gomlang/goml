package main
file main.goml
  trait Source {
    type Item;
    fn get(Self) -> Self::Item;
  }

  trait Pick[T] {
    fn pick(Self) -> T;
  }

  impl[S: Source] Pick[S::Item] for S {
    fn pick(local/main/0: S) -> S::Item {
        Source::get(self/0)
    }
  }

  struct Value {
      value: i32,
  }

  impl Source for Value {
    type Item = i32;
    fn get(local/main/1: Value) -> i32 {
        self/1.value
    }
  }

  fn copy[S: Source + Pick[S::Item]](local/main/2: S) -> S::Item {
      let local/main/3: S::Item = Pick::[S::Item]::pick(source/2);
      let local/main/5 = |local/main/4: S::Item| item/4;
      identity/5(value/3)
  }

  fn main() -> () {
      let local/main/6: i32 = Value { value: 41 }.pick();
      println(direct/6);
      println(source:4:main:5(Value { value: 42 }));
  }