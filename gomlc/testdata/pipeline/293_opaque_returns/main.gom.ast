package main;
trait Source {
  type Item;
  fn get(self: Self) -> Self::Item;
}

trait Label {
  fn label(self: Self) -> string;
}

struct Box[T] {
    value: T,
}

impl[T] Source for Box[T] {
  type Item = T;
  fn get(self: Box[T]) -> T {
      self.value
  }
}

impl[T] Label for Box[T] {
  fn label(self: Box[T]) -> string {
      "box"
  }
}

fn make[T](value: T) -> impl Source[Item = T] + Label {
    Box { value: value }
}

fn forward() -> impl Source[Item = isize] {
    later(12)
}

fn later[T](value: T) -> impl Source[Item = T] {
    make(value)
}

impl[T] Box[T] {
  fn wrapped(self: Box[T]) -> impl Source[Item = T] {
      self
  }
}

struct Factory {}

impl Factory {
  fn wrapped(self: Factory) -> impl Source[Item = isize] {
      Box { value: 21 }
  }
}

fn choose(flag: bool) -> impl Source[Item = isize] {
    if flag {
        {
            return Box { value: 31 };
        }
    } else {
        ()
    };
    Box { value: 32 }
}

trait Identity {
  fn identity[T](self: Self, value: T) -> T;
}

impl Identity for Factory {
  fn identity[T](self: Factory, value: T) -> T {
      value
  }
}

fn identity_factory() -> impl Identity {
    Factory {}
}

fn numbers() -> impl Iterator[Item = isize] {
    Vec::from_array([1, 2, 3]).into_iter()
}

fn main() -> () {
    let number = make(42);
    let text = make("ok");
    println(number.get());
    println(text.get());
    println(number.label());
    println(forward().get());
    let dynamic = number as dyn Source[Item = isize] + Label;
    println(dynamic.get());
    println(dynamic.label());
    println(Box { value: "method" }.wrapped().get());
    println(Factory {}.wrapped().get());
    println(choose(true).get());
    println(choose(false).get());
    let iterator = numbers();
    println(iterator.next().unwrap_or(0));
    println(iterator.next().unwrap_or(0));
    println(iterator.next().unwrap_or(0));
    println(iterator.next().unwrap_or(0));
    let factory = identity_factory();
    println(factory.identity(17));
    println(factory.identity("generic"))
}

