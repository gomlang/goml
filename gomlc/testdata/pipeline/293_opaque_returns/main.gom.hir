package main
file main.gom
  trait Source {
    type Item;
    fn get(Self) -> Self::Item;
  }

  trait Label {
    fn label(Self) -> string;
  }

  struct Box[T] {
      value: T,
  }

  impl[T] Source for Box[T] {
    type Item = T;
    fn get(local/1/0: Box[T]) -> T {
        self/0.value
    }
  }

  impl[T] Label for Box[T] {
    fn label(local/1/1: Box[T]) -> string {
        "box"
    }
  }

  fn make[T](local/1/2: T) -> $impl_trait[dyn Source[Item = T] + Label] {
      Box { value: value/2 }
  }

  fn forward() -> $impl_trait[dyn Source[Item = isize]] {
      def/1/7(12)
  }

  fn later[T](local/1/3: T) -> $impl_trait[dyn Source[Item = T]] {
      def/1/5(value/3)
  }

  impl[T] Box[T] {
    fn wrapped(local/1/4: Box[T]) -> $impl_trait[dyn Source[Item = T]] {
        self/4
    }
  }

  struct Factory {}

  impl Factory {
    fn wrapped(local/1/5: Factory) -> $impl_trait[dyn Source[Item = isize]] {
        Box { value: 21 }
    }
  }

  fn choose(local/1/6: bool) -> $impl_trait[dyn Source[Item = isize]] {
      if flag/6 {
          return Box { value: 31 };
      } else ();
      Box { value: 32 }
  }

  trait Identity {
    fn identity[T](Self, T) -> T;
  }

  impl Identity for Factory {
    fn identity[T](local/1/7: Factory, local/1/8: T) -> T {
        value/8
    }
  }

  fn identity_factory() -> $impl_trait[dyn Identity] {
      Factory {}
  }

  fn numbers() -> $impl_trait[dyn Iterator[Item = isize]] {
      Vec::from_array([1, 2, 3]).into_iter()
  }

  fn main() -> () {
      let local/1/9 = def/1/5(42);
      let local/1/10 = def/1/5("ok");
      println(number/9.get());
      println(text/10.get());
      println(number/9.label());
      println(def/1/6().get());
      let local/1/11 = number/9 as dyn Source[Item = isize] + Label;
      println(dynamic/11.get());
      println(dynamic/11.label());
      println(Box { value: "method" }.wrapped().get());
      println(Factory {}.wrapped().get());
      println(def/1/11(true).get());
      println(def/1/11(false).get());
      let local/1/12 = def/1/15();
      println(iterator/12.next().unwrap_or(0));
      println(iterator/12.next().unwrap_or(0));
      println(iterator/12.next().unwrap_or(0));
      println(iterator/12.next().unwrap_or(0));
      let local/1/13 = def/1/14();
      println(factory/13.identity(17));
      println(factory/13.identity("generic"))
  }