fn main() -> () {
    if true {
        println("if")
    } else {
        println("else")
    }
    match 1 {
        1 => println("match"),
        _ => (),
    }
    let index = Ref::new(0);
    while index.get() < 2 {
        println(index.get().to_string());
        index.set(index.get() + 1)
    }
    let values: Vec[string] = Vec::new();
    values.push("for");
    for value in values {
        println(value)
    }
    println("done")
}
