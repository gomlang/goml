fn show_int(label/0: string, value/1: i32) -> () {
    let _ : () =
      (println : (string) -> ())(
        (label/0 : string) + (i32::to_string : (i32) -> string)((value/1 : i32))
      );
}

fn show_bool(label/2: string, value/3: bool) -> () {
    let _ : () =
      (println : (string) -> ())(
        (label/2 : string) + (ToString::to_string : (bool) -> string)((value/3 : bool))
      );
}

fn main() -> () {
    let base/4: i32 = 10;
    let sum/5: i32 = (base/4 : i32) + 5;
    let diff/6: i32 = (sum/5 : i32) - 3;
    let prod/7: i32 = (diff/6 : i32) * 2;
    let quot/8: i32 = (prod/7 : i32) / 4;
    let _ : () = (show_int : (string, i32) -> ())("sum=", (sum/5 : i32));
    let _ : () = (show_int : (string, i32) -> ())("diff=", (diff/6 : i32));
    let _ : () = (show_int : (string, i32) -> ())("prod=", (prod/7 : i32));
    let _ : () = (show_int : (string, i32) -> ())("quot=", (quot/8 : i32));
    let and_result/9: bool = true && false;
    let or_result/10: bool = true || false;
    let not_result/11: bool = !false;
    let mixed/12: bool =
      !(and_result/9 : bool) &&
        match (sum/5 : i32) + (prod/7 : i32) * (base/4 : i32) - (prod/7 : i32) / 2 {
            0 => false,
            _ : i32 => true,
        } ||
        !match (diff/6 : i32) - (quot/8 : i32) + (base/4 : i32) - (sum/5 : i32) / 2 {
            0 => false,
            _ : i32 => true,
        };
    let _ : () = (show_bool : (string, bool) -> ())("and=", (and_result/9 : bool));
    let _ : () = (show_bool : (string, bool) -> ())("or=", (or_result/10 : bool));
    let _ : () = (show_bool : (string, bool) -> ())("not=", (not_result/11 : bool));
    let _ : () = (show_bool : (string, bool) -> ())("mixed=", (mixed/12 : bool));
}