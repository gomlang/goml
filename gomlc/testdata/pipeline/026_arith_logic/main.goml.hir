package main
file main.goml
  fn show_int(local/main/0: string, local/main/1: i32) {
      let _ = println(label/0 + value/1.to_string());
  }

  fn show_bool(local/main/2: string, local/main/3: bool) {
      let _ = println(label/2 + value/3.to_string());
  }

  fn main() {
      let local/main/4 = 10;
      let local/main/5 = base/4 + 5;
      let local/main/6 = sum/5 - 3;
      let local/main/7 = diff/6 * 2;
      let local/main/8 = prod/7 / 4;
      let _ = source:4:main:0("sum=", sum/5);
      let _ = source:4:main:0("diff=", diff/6);
      let _ = source:4:main:0("prod=", prod/7);
      let _ = source:4:main:0("quot=", quot/8);
      let local/main/9 = true && false;
      let local/main/10 = true || false;
      let local/main/11 = !false;
      let local/main/12 =
        !and_result/9 &&
          match sum/5 + prod/7 * base/4 - prod/7 / 2 {
              0 => false,
              _ => true,
          } ||
          !match diff/6 - quot/8 + base/4 - sum/5 / 2 {
              0 => false,
              _ => true,
          };
      let _ = source:4:main:1("and=", and_result/9);
      let _ = source:4:main:1("or=", or_result/10);
      let _ = source:4:main:1("not=", not_result/11);
      let _ = source:4:main:1("mixed=", mixed/12);
  }