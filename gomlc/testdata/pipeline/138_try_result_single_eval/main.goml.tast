fn bump(counter/0: Ref[i32], ok/1: bool) -> Result[i32, string] {
    (Ref[i32]::set : (Ref[i32], i32) -> ())(
      (counter/0 : Ref[i32]),
      (Ref[i32]::get : (Ref[i32]) -> i32)((counter/0 : Ref[i32])) + 1
    );
    if (ok/1 : bool) {
        {
            Result::Ok((Ref[i32]::get : (Ref[i32]) -> i32)((counter/0 : Ref[i32])))
        }
    } else {
        {
            Result::Err("bump failed")
        }
    }
}

fn use_try(counter/2: Ref[i32], ok/3: bool) -> Result[i32, string] {
    let value/4: i32 =
      match (bump : (Ref[i32], bool) -> Result[i32, string])(
        (counter/2 : Ref[i32]),
        (ok/3 : bool)
      ) {
          Result::Ok(try_value/23: i32) => (try_value/23 : i32),
          Result::Err(try_residual/23: string) => return Result::Err((try_residual/23 : string)),
      };
    Result::Ok((value/4 : i32) + (Ref[i32]::get : (Ref[i32]) -> i32)((counter/2 : Ref[i32])))
}

fn show(res/5: Result[i32, string]) -> string {
    match (res/5 : Result[i32, string]) {
        Result::Ok(value/6: i32) => "ok " + (i32::to_string : (i32) -> string)((value/6 : i32)),
        Result::Err(err/7: string) => "err " + (err/7 : string),
    }
}

fn run(ok/8: bool) -> string {
    let counter/9: Ref[i32] = (Ref[i32]::new : (i32) -> Ref[i32])(0);
    let result/10: Result[i32, string] =
      (use_try : (Ref[i32], bool) -> Result[i32, string])((counter/9 : Ref[i32]), (ok/8 : bool));
    (show : (Result[i32, string]) -> string)((result/10 : Result[i32, string])) + " count=" +
      (i32::to_string : (i32) -> string)(
        (Ref[i32]::get : (Ref[i32]) -> i32)((counter/9 : Ref[i32]))
      )
}

fn main() -> () {
    (println : (string) -> ())((run : (bool) -> string)(true));
    (println : (string) -> ())((run : (bool) -> string)(false));
}