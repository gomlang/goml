fn find(wanted/0: isize) -> Option[isize] {
    let current/1: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    loop {
        let value/2: isize = (Ref[isize]::get : (Ref[isize]) -> isize)((current/1 : Ref[isize]));
        if (value/2 : isize) >= 5 {
            {
                return Option::None;
            }
        } else {
            if (value/2 : isize) == (wanted/0 : isize) {
                {
                    return Option::Some((value/2 : isize));
                }
            } else {
                {
                    (Ref[isize]::set : (Ref[isize], isize) -> ())(
                      (current/1 : Ref[isize]),
                      (value/2 : isize) + 1
                    );
                }
            }
        };
    };
    Option::None
}

fn any(wanted/3: isize) -> bool {
    match (find : (isize) -> Option[isize])((wanted/3 : isize)) {
        Option::Some(_ : isize) => true,
        Option::None => false,
    }
}

fn main() -> () {
    (println : (bool) -> ())((any : (isize) -> bool)(3));
    (println : (bool) -> ())((any : (isize) -> bool)(8));
}