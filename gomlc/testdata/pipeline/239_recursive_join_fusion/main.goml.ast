package main;
fn find(wanted: isize) -> Option[isize] {
    let current = Ref::new(0);
    loop {
        let value = current.get();
        if value >= 5 {
            {
                return Option::None;
            }
        } else {
            if value == wanted {
                {
                    return Option::Some(value);
                }
            } else {
                {
                    current.set(value + 1);
                }
            }
        };
    };
    Option::None
}

fn any(wanted: isize) -> bool {
    match find(wanted) {
        Some(_) => true,
        None => false,
    }
}

fn main() -> () {
    println(any(3));
    println(any(8));
}

