package main
file main.goml
  trait RenderValue {
    fn render[U](Self, U) -> string where U: ToString;
  }

  struct Prefix {
      value: string,
  }

  impl RenderValue for Prefix {
    fn render[V](local/1/0: Prefix, local/1/1: V) -> string where V: ToString {
        self/0.value + value/1.to_string()
    }
  }

  fn render_generic[T: RenderValue](local/1/2: T) -> string {
      renderer/2.render::[isize](11)
  }

  fn main() {
      let local/1/3 = Prefix { value: "direct:" }.render("ok");
      println(direct/3);
      let local/1/4 = def/1/3(Prefix { value: "generic:" });
      println(generic/4);
      let local/1/5 = RenderValue::render::[isize](Prefix { value: "ufcs:" }, 12);
      println(ufcs/5);
  }