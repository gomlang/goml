package main
file main.goml
  trait Consumer[T] {
    fn consume(Self, T) -> string;
  }

  trait Label {
    fn label(Self) -> string;
  }

  trait Count {
    fn count(Self) -> isize;
  }

  struct Sink {
      prefix: string,
  }

  impl Consumer[string] for Sink {
    fn consume(local/1/0: Sink, local/1/1: string) -> string {
        self/0.prefix + value/1
    }
  }

  impl Consumer[isize] for Sink {
    fn consume(local/1/2: Sink, local/1/3: isize) -> string {
        self/2.prefix + value/3.to_string()
    }
  }

  impl Label for Sink {
    fn label(local/1/4: Sink) -> string {
        self/4.prefix
    }
  }

  impl Count for Sink {
    fn count(local/1/5: Sink) -> isize {
        7
    }
  }

  fn erase[T: Consumer[string] + Label](local/1/6: T) -> dyn Consumer[string] + Label {
      value/6 as dyn Consumer[string] + Label
  }

  trait Root[T] {
    fn root(Self) -> T;
  }

  trait Child[T]: Root[T] {
    fn child(Self) -> string;
  }

  impl Root[string] for Sink {
    fn root(local/1/7: Sink) -> string {
        self/7.prefix
    }
  }

  impl Child[string] for Sink {
    fn child(local/1/8: Sink) -> string {
        "child"
    }
  }

  trait First {
    type Item;
    fn value(Self) -> Self::Item;
  }

  trait Second {
    type Item;
    fn value(Self) -> Self::Item;
  }

  trait Family: First + Second {}

  impl First for Sink {
    type Item = isize;
    fn value(local/1/9: Sink) -> isize {
        42
    }
  }

  impl Second for Sink {
    type Item = string;
    fn value(local/1/10: Sink) -> string {
        self/10.prefix
    }
  }

  impl Family for Sink {}

  trait NamedParent {
    fn name(Self) -> string;
  }

  trait NamedChild: NamedParent {
    fn name(Self) -> string;
  }

  impl NamedParent for Sink {
    fn name(local/1/11: Sink) -> string {
        "parent"
    }
  }

  impl NamedChild for Sink {
    fn name(local/1/12: Sink) -> string {
        "child"
    }
  }

  fn inherit[T: Root[string] + Child[string]](local/1/13: T) -> dyn Child[string] {
      value/13 as dyn Child[string]
  }

  fn reordered(local/1/14: dyn Count + Label) -> dyn Label + Count {
      value/14
  }

  fn inherited_associated(local/1/15: dyn First[Item = isize]) -> isize {
      value/15.value()
  }

  fn main() -> () {
      let local/1/16 = Sink { prefix: "text:" } as dyn Consumer[string];
      let local/1/17 = Sink { prefix: "number:" } as dyn Consumer[isize];
      println(text/16.consume("ok"));
      println(number/17.consume(42));
      let local/1/18 = def/1/8(Sink { prefix: "both:" });
      println(both/18.consume("ok"));
      println(both/18.label());
      let local/1/19 = Sink { prefix: "count:" } as dyn Label + Count;
      println(combined/19.label());
      println(combined/19.count());
      println(def/1/24(combined/19).label());
      let local/1/20 = def/1/23(Sink { prefix: "inherited" });
      println(child/20.root());
      println(child/20.child());
      println(Root[string]::root(child/20));
      println(Consumer[string]::consume(text/16, "ufcs"));
      let local/1/21 =
        Sink { prefix: "associated" } as dyn Family + First[Item = isize] + Second[Item = string];
      println(First::value(family/21));
      println(Second::value(family/21));
      let local/1/22 = Sink { prefix: "" } as dyn NamedChild;
      println(named/22.name());
      println(NamedParent::name(named/22));
      println(def/1/25(Sink { prefix: "" } as dyn First[Item = isize]))
  }