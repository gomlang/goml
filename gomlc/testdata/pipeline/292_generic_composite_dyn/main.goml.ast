package main;
trait Consumer[T] {
  fn consume(self: Self, value: T) -> string;
}

trait Label {
  fn label(self: Self) -> string;
}

trait Count {
  fn count(self: Self) -> isize;
}

struct Sink {
    prefix: string,
}

impl Consumer[string] for Sink {
  fn consume(self: Sink, value: string) -> string {
      self.prefix + value
  }
}

impl Consumer[isize] for Sink {
  fn consume(self: Sink, value: isize) -> string {
      self.prefix + value.to_string()
  }
}

impl Label for Sink {
  fn label(self: Sink) -> string {
      self.prefix
  }
}

impl Count for Sink {
  fn count(self: Sink) -> isize {
      7
  }
}

fn erase[T: Consumer[string] + Label](value: T) -> dyn Consumer[string] + Label {
    value as dyn Consumer[string] + Label
}

trait Root[T] {
  fn root(self: Self) -> T;
}

trait Child[T]: Root[T] {
  fn child(self: Self) -> string;
}

impl Root[string] for Sink {
  fn root(self: Sink) -> string {
      self.prefix
  }
}

impl Child[string] for Sink {
  fn child(self: Sink) -> string {
      "child"
  }
}

trait First {
  type Item;
  fn value(self: Self) -> Self::Item;
}

trait Second {
  type Item;
  fn value(self: Self) -> Self::Item;
}

trait Family: First + Second {}

impl First for Sink {
  type Item = isize;
  fn value(self: Sink) -> isize {
      42
  }
}

impl Second for Sink {
  type Item = string;
  fn value(self: Sink) -> string {
      self.prefix
  }
}

impl Family for Sink {}

trait NamedParent {
  fn name(self: Self) -> string;
}

trait NamedChild: NamedParent {
  fn name(self: Self) -> string;
}

impl NamedParent for Sink {
  fn name(self: Sink) -> string {
      "parent"
  }
}

impl NamedChild for Sink {
  fn name(self: Sink) -> string {
      "child"
  }
}

fn inherit[T: Root[string] + Child[string]](value: T) -> dyn Child[string] {
    value as dyn Child[string]
}

fn reordered(value: dyn Count + Label) -> dyn Label + Count {
    value
}

fn inherited_associated(value: dyn First[Item = isize]) -> isize {
    value.value()
}

fn main() -> () {
    let text = Sink { prefix: "text:" } as dyn Consumer[string];
    let number = Sink { prefix: "number:" } as dyn Consumer[isize];
    println(text.consume("ok"));
    println(number.consume(42));
    let both = erase(Sink { prefix: "both:" });
    println(both.consume("ok"));
    println(both.label());
    let combined = Sink { prefix: "count:" } as dyn Label + Count;
    println(combined.label());
    println(combined.count());
    println(reordered(combined).label());
    let child = inherit(Sink { prefix: "inherited" });
    println(child.root());
    println(child.child());
    println(Root::[string]::root(child));
    println(Consumer::[string]::consume(text, "ufcs"));
    let family =
      Sink { prefix: "associated" } as dyn Family + First[Item = isize] + Second[Item = string];
    println(First::value(family));
    println(Second::value(family));
    let named = Sink { prefix: "" } as dyn NamedChild;
    println(named.name());
    println(NamedParent::name(named));
    println(inherited_associated(Sink { prefix: "" } as dyn First[Item = isize]))
}

