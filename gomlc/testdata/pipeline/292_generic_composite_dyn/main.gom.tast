impl Consumer[string] for Sink {
  fn consume(self/0: Sink, value/1: string) -> string {
      (self/0 : Sink).prefix + (value/1 : string)
  }
}

impl Consumer[isize] for Sink {
  fn consume(self/2: Sink, value/3: isize) -> string {
      (self/2 : Sink).prefix + (isize::to_string : (isize) -> string)((value/3 : isize))
  }
}

impl Label for Sink {
  fn label(self/4: Sink) -> string {
      (self/4 : Sink).prefix
  }
}

impl Count for Sink {
  fn count(self/5: Sink) -> isize {
      7
  }
}

fn erase[T](value/6: T) -> dyn Consumer[string] + Label where T: Consumer[string], T: Label {
    to_dyn[Consumer]{T}((value/6 : T))
}

impl Root[string] for Sink {
  fn root(self/7: Sink) -> string {
      (self/7 : Sink).prefix
  }
}

impl Child[string] for Sink {
  fn child(self/8: Sink) -> string {
      "child"
  }
}

impl First for Sink {
  fn value(self/9: Sink) -> isize {
      42
  }
}

impl Second for Sink {
  fn value(self/10: Sink) -> string {
      (self/10 : Sink).prefix
  }
}

impl Family for Sink {}

impl NamedParent for Sink {
  fn name(self/11: Sink) -> string {
      "parent"
  }
}

impl NamedChild for Sink {
  fn name(self/12: Sink) -> string {
      "child"
  }
}

fn inherit[T](value/13: T) -> dyn Child[string] + Root[string] where
  T: Root[string],
  T: Child[string] {
    to_dyn[Child]{T}((value/13 : T))
}

fn reordered(value/14: dyn Count + Label) -> dyn Count + Label {
    (value/14 : dyn Count + Label)
}

fn inherited_associated(value/15: dyn First[Item = isize]) -> isize {
    (dyn First::value : (dyn First[Item = isize]) -> isize)((value/15 : dyn First[Item = isize]))
}

fn main() -> () {
    let text/16: dyn Consumer[string] = to_dyn[Consumer]{Sink}(Sink { prefix: "text:" });
    let number/17: dyn Consumer[isize] = to_dyn[Consumer]{Sink}(Sink { prefix: "number:" });
    (println : (string) -> ())(
      (dyn Consumer::consume : (dyn Consumer[string], string) -> string)(
        (text/16 : dyn Consumer[string]),
        "ok"
      )
    );
    (println : (string) -> ())(
      (dyn Consumer::consume : (dyn Consumer[isize], isize) -> string)(
        (number/17 : dyn Consumer[isize]),
        42
      )
    );
    let both/18: dyn Consumer[string] + Label =
      (erase : (Sink) -> dyn Consumer[string] + Label)(Sink { prefix: "both:" });
    (println : (string) -> ())(
      (dyn Consumer::consume : (dyn Consumer[string] + Label, string) -> string)(
        (both/18 : dyn Consumer[string] + Label),
        "ok"
      )
    );
    (println : (string) -> ())(
      (dyn Consumer::label : (dyn Consumer[string] + Label) -> string)(
        (both/18 : dyn Consumer[string] + Label)
      )
    );
    let combined/19: dyn Count + Label = to_dyn[Count]{Sink}(Sink { prefix: "count:" });
    (println : (string) -> ())(
      (dyn Count::label : (dyn Count + Label) -> string)((combined/19 : dyn Count + Label))
    );
    (println : (isize) -> ())(
      (dyn Count::count : (dyn Count + Label) -> isize)((combined/19 : dyn Count + Label))
    );
    (println : (string) -> ())(
      (dyn Count::label : (dyn Count + Label) -> string)(
        (reordered : (dyn Count + Label) -> dyn Count + Label)((combined/19 : dyn Count + Label))
      )
    );
    let child/20: dyn Child[string] + Root[string] =
      (inherit : (Sink) -> dyn Child[string] + Root[string])(Sink { prefix: "inherited" });
    (println : (string) -> ())(
      (dyn Child::root : (dyn Child[string] + Root[string]) -> string)(
        (child/20 : dyn Child[string] + Root[string])
      )
    );
    (println : (string) -> ())(
      (dyn Child::child : (dyn Child[string] + Root[string]) -> string)(
        (child/20 : dyn Child[string] + Root[string])
      )
    );
    (println : (string) -> ())(
      (dyn Child::root : (dyn Child[string] + Root[string]) -> string)(
        (child/20 : dyn Child[string] + Root[string])
      )
    );
    (println : (string) -> ())(
      (dyn Consumer::consume : (dyn Consumer[string], string) -> string)(
        (text/16 : dyn Consumer[string]),
        "ufcs"
      )
    );
    let family/21: dyn Family + First[Item = isize] + Second[Item = string] =
      to_dyn[Family]{Sink}(Sink { prefix: "associated" });
    (println : (isize) -> ())(
      (dyn Family::value : (dyn Family + First[Item = isize] + Second[Item = string]) -> isize)(
        (family/21 : dyn Family + First[Item = isize] + Second[Item = string])
      )
    );
    (println : (string) -> ())(
      (dyn Family::value : (dyn Family + First[Item = isize] + Second[Item = string]) -> string)(
        (family/21 : dyn Family + First[Item = isize] + Second[Item = string])
      )
    );
    let named/22: dyn NamedChild + NamedParent = to_dyn[NamedChild]{Sink}(Sink { prefix: "" });
    (println : (string) -> ())(
      (dyn NamedChild::name : (dyn NamedChild + NamedParent) -> string)(
        (named/22 : dyn NamedChild + NamedParent)
      )
    );
    (println : (string) -> ())(
      (dyn NamedChild::name : (dyn NamedChild + NamedParent) -> string)(
        (named/22 : dyn NamedChild + NamedParent)
      )
    );
    (println : (isize) -> ())(
      (inherited_associated : (dyn First[Item = isize]) -> isize)(
        to_dyn[First]{Sink}(Sink { prefix: "" })
      )
    )
}