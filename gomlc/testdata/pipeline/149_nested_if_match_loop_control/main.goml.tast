fn main() -> () {
    let i/0: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    let sum/1: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    while (Ref[isize]::get : (Ref[isize]) -> isize)((i/0 : Ref[isize])) < 7 {
        {
            let cur/2: isize = (Ref[isize]::get : (Ref[isize]) -> isize)((i/0 : Ref[isize]));
            (Ref[isize]::set : (Ref[isize], isize) -> ())((i/0 : Ref[isize]), (cur/2 : isize) + 1);
            let _ : () =
              if (cur/2 : isize) < 5 {
                  {
                      match (cur/2 : isize) {
                          1 => continue,
                          3 => continue,
                          _ : isize => (),
                      }
                  }
              } else {
                  {
                      match (cur/2 : isize) {
                          5 => break,
                          _ : isize => (),
                      }
                  }
              };
            (Ref[isize]::set : (Ref[isize], isize) -> ())(
              (sum/1 : Ref[isize]),
              (Ref[isize]::get : (Ref[isize]) -> isize)((sum/1 : Ref[isize])) + (cur/2 : isize)
            );
        }
    };
    (println : (isize) -> ())((Ref[isize]::get : (Ref[isize]) -> isize)((sum/1 : Ref[isize])));
}