fn main() -> () {
    let i = Ref::new(0);
    let sum = Ref::new(0);
    while i.get() < 7 {
        let cur = i.get();
        i.set(cur + 1);
        let _ = if cur < 5 {
            match cur {
                1 => continue,
                3 => continue,
                _ => (),
            }
        } else {
            match cur {
                5 => break,
                _ => (),
            }
        };
        sum.set(sum.get() + cur);
    }
    println(sum.get());
}
