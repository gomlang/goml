fn main() -> () {
    let i = Ref::new(0);
    let total = Ref::new(0);
    while if i.get() == 0 {
        i.set(1);
        true
    } else if i.get() < 4 {
        true
    } else {
        false
    } {
        total.set(total.get() + i.get());
        if i.get() == 1 {
            i.set(2);
            continue
        } else {};
        i.set(i.get() + 1);
    }
    println(total.get());
    let j = Ref::new(0);
    let total2 = Ref::new(0);
    while match j.get() {
        0 => {
            j.set(1);
            true
        },
        1 => {
            j.set(2);
            true
        },
        2 => true,
        _ => false,
    } {
        total2.set(total2.get() + j.get());
        if j.get() == 2 {
            break;
        } else {};
    }
    println(total2.get());
}
