package main;
enum Message[T] {
    Quit,
    Write(T),
    Move { x: i32, y: i32, label: T }
}

#[derive(ToString, Hash, PartialEq, Eq)]
enum Key {
    Empty,
    Point { x: i32, y: i32 }
}

impl ToString for Key {
  fn to_string(self: Key) -> string {
      match self {
          Key::Empty => "Key::Empty",
          Key::Point { x: #derive0_field, y: #derive1_field } =>
            "Key::Point { " + "x: " + ToString::to_string(#derive0_field) + ", " + "y: " +
              ToString::to_string(#derive1_field) +
              " }",
      }
  }
}

impl Hash for Key {
  fn hash(self: Key) -> u64 {
      match self {
          Key::Empty =>
            {
                let h = 0.to_u64() + 14695981039346656037 + 1;
                h
            },
          Key::Point { x: #derive0_field, y: #derive1_field } =>
            {
                let h = 0.to_u64() + 14695981039346656037 + 2;
                let h = h * 0.to_u64() + 1099511628211 + Hash::hash(#derive0_field);
                let h = h * 0.to_u64() + 1099511628211 + Hash::hash(#derive1_field);
                h
            },
      }
  }
}

impl PartialEq for Key {
  fn eq(self: Key, other: Key) -> bool {
      match (self, other) {
          (Key::Empty, Key::Empty) => true,
          (
            Key::Point { x: #derive0_left, y: #derive2_left },
            Key::Point { x: #derive1_right, y: #derive3_right }
          ) =>
            true && PartialEq::eq(#derive0_left, #derive1_right) &&
              PartialEq::eq(#derive2_left, #derive3_right),
          _ => false,
      }
  }
}

impl Eq for Key where i32: Eq {}

fn score(value: Message[string]) -> i32 {
    match value {
        Message::Quit => 0,
        Message::Write(_) => 1,
        Message::Move { x: x, y: vertical, .. } => x + vertical,
    }
}

fn label(value: Message[string]) -> string {
    match value {
        Message::Move { label: label, x: _, y: _ } => label,
        Message::Write(text) => text,
        Message::Quit => "quit",
    }
}

fn main() -> () {
    let x = 3;
    let direction = "north";
    let first = Message::Move { label: direction, y: 4, x: x };
    let second = Message::Move { x: 3, y: 4, label: "north" };
    println(score(first));
    println(label(second));
    println(Key::Point { x: 1, y: 2 }.to_string());
    println(PartialEq::eq(Key::Point { x: 1, y: 2 }, Key::Point { y: 2, x: 1 }));
}

