                  let local/1/8 = h/7 * 0.to_u64() + 1099511628211 + Hash::hash(#derive0_field/5);
                  let local/1/9 = h/8 * 0.to_u64() + 1099511628211 + Hash::hash(#derive1_field/6);
                  h/9
              },
        }
    }
  }

  impl PartialEq for Key {
    fn eq(local/1/10: Key, local/1/11: Key) -> bool {
        match (self/10, other/11) {
            (ctor(def/1/1::v0), ctor(def/1/1::v0)) => true,
            (
              ctor(def/1/1::v1) { x: local/1/12, y: local/1/13 },
              ctor(def/1/1::v1) { x: local/1/14, y: local/1/15 }
            ) =>
              true && PartialEq::eq(#derive0_left/12, #derive1_right/14) &&
                PartialEq::eq(#derive2_left/13, #derive3_right/15),
            _ => false,
        }
    }
  }

  impl Eq for Key where i32: Eq {}

  fn score(local/1/16: Message[string]) -> i32 {
      match value/16 {
          ctor(def/1/0::v0) => 0,
          ctor(def/1/0::v1)(_) => 1,
          ctor(def/1/0::v2) { x: local/1/17, y: local/1/18, .. } => x/17 + vertical/18,
      }
  }

  fn label(local/1/19: Message[string]) -> string {
      match value/19 {
          ctor(def/1/0::v2) { label: local/1/20, x: _, y: _ } => label/20,
          ctor(def/1/0::v1)(local/1/21) => text/21,
          ctor(def/1/0::v0) => "quit",
      }
  }

  fn main() -> () {
      let local/1/22 = 3;
      let local/1/23 = "north";
      let local/1/24 = Message::Move { label: direction/23, y: 4, x: x/22 };
      let local/1/25 = Message::Move { x: 3, y: 4, label: "north" };
      println(def/1/6(first/24));
