        }
    }
  }

  impl Hash for Key {
    fn hash(local/1/3: Key) -> u64 {
        match self/3 {
            ctor(def/1/1::v0) =>
              {
                  let local/1/4 = 0.to_u64() + 14695981039346656037 + 1;
                  h/4
              },
            ctor(def/1/1::v1) { x: local/1/5, y: local/1/6 } =>
              {
