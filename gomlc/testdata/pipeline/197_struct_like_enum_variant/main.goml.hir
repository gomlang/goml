package main
file main.goml
  enum Message[T] {
      Quit,
      Write(T),
      Move { x: i32, y: i32, label: T }
  }

  #[derive(ToString, Hash, PartialEq, Eq)]
  enum Key {
      Empty,
      Point { x: i32, y: i32 }
  }

  impl ToString for Key {
    fn to_string(local/main/0: Key) -> string {
        match self/0 {
            ctor(source:4:main:1::v0) => "Key::Empty",
            ctor(source:4:main:1::v1) { x: local/main/1, y: local/main/2 } =>
              "Key::Point { " + "x: " + ToString::to_string(#derive0_field/1) + ", " + "y: " +
                ToString::to_string(#derive1_field/2) +
                " }",
        }
    }
  }

  impl Hash for Key {
    fn hash(local/main/3: Key) -> u64 {
        match self/3 {
            ctor(source:4:main:1::v0) =>
              {
                  let local/main/4 = 0.to_u64() + 14695981039346656037 + 1;
                  h/4
              },
            ctor(source:4:main:1::v1) { x: local/main/5, y: local/main/6 } =>
              {
                  let local/main/7 = 0.to_u64() + 14695981039346656037 + 2;
                  let local/main/8 =
                    h/7 * 0.to_u64() + 1099511628211 + Hash::hash(#derive0_field/5);
                  let local/main/9 =
                    h/8 * 0.to_u64() + 1099511628211 + Hash::hash(#derive1_field/6);
                  h/9
              },
        }
    }
  }

  impl PartialEq for Key {
    fn eq(local/main/10: Key, local/main/11: Key) -> bool {
        match (self/10, other/11) {
            (ctor(source:4:main:1::v0), ctor(source:4:main:1::v0)) => true,
            (
              ctor(source:4:main:1::v1) { x: local/main/12, y: local/main/13 },
              ctor(source:4:main:1::v1) { x: local/main/14, y: local/main/15 }
            ) =>
              true && PartialEq::eq(#derive0_left/12, #derive1_right/14) &&
                PartialEq::eq(#derive2_left/13, #derive3_right/15),
            _ => false,
        }
    }
  }

  impl Eq for Key where i32: Eq {}

  fn score(local/main/16: Message[string]) -> i32 {
      match value/16 {
          ctor(source:4:main:0::v0) => 0,
          ctor(source:4:main:0::v1)(_) => 1,
          ctor(source:4:main:0::v2) { x: local/main/17, y: local/main/18, .. } =>
            x/17 + vertical/18,
      }
  }

  fn label(local/main/19: Message[string]) -> string {
      match value/19 {
          ctor(source:4:main:0::v2) { label: local/main/20, x: _, y: _ } => label/20,
          ctor(source:4:main:0::v1)(local/main/21) => text/21,
          ctor(source:4:main:0::v0) => "quit",
      }
  }

  fn main() -> () {
      let local/main/22 = 3;
      let local/main/23 = "north";
      let local/main/24 = Message::Move { label: direction/23, y: 4, x: x/22 };
      let local/main/25 = Message::Move { x: 3, y: 4, label: "north" };
      println(source:4:main:6(first/24));
      println(source:4:main:7(second/25));
      println(Key::Point { x: 1, y: 2 }.to_string());
      println(PartialEq::eq(Key::Point { x: 1, y: 2 }, Key::Point { y: 2, x: 1 }));
  }