package main
file main.goml
  enum Message[T] {
      Quit,
      Write(T),
      Move { x: i32, y: i32, label: T }
  }

  #[derive(ToString, Hash, PartialEq, Eq)]
  enum Key {
      Empty,
      Point { x: i32, y: i32 }
  }

  impl ToString for Key {
    fn to_string(local/1/0: Key) -> string {
        match self/0 {
            ctor(def/1/1::v0) => "Key::Empty",
            ctor(def/1/1::v1) { x: local/1/1, y: local/1/2 } =>
              "Key::Point { " + "x: " + ToString::to_string(#derive0_field/1) + ", " + "y: " +
                ToString::to_string(#derive1_field/2) +
