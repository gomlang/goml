enum Message[T] {
    Quit,
    Write(T),
    Move {
        x: i32,
        y: i32,
        label: T,
    },
}

#[derive(ToString, Hash, PartialEq, Eq)]
enum Key {
    Empty,
    Point {
        x: i32,
        y: i32,
    },
}

fn score(value: Message[string]) -> i32 {
    match value {
        Message::Quit => 0,
        Message::Write(_) => 1,
        Message::Move { x, y: vertical, .. } => x + vertical,
    }
}

fn label(value: Message[string]) -> string {
    match value {
        Message::Move { label, x: _, y: _ } => label,
        Message::Write(text) => text,
        Message::Quit => "quit",
    }
}

fn main() -> () {
    let x = 3;
    let direction = "north";
    let first = Message::Move { label: direction, y: 4, x };
    let second = Message::Move { x: 3, y: 4, label: "north" };
    println(score(first));
    println(label(second));
    println(Key::Point { x: 1, y: 2 }.to_string());
    println(PartialEq::eq(Key::Point { x: 1, y: 2 }, Key::Point { y: 2, x: 1 }));
}
