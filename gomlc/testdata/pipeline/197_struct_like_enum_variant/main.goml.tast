impl ToString for Key {
  fn to_string(self/0: Key) -> string {
      match (self/0 : Key) {
          Key::Empty => "Key::Empty",
          Key::Point(#derive0_field/1: i32, #derive1_field/2: i32) =>
            "Key::Point { " + "x: " +
              (ToString::to_string : (i32) -> string)((#derive0_field/1 : i32)) +
              ", " +
              "y: " +
              (ToString::to_string : (i32) -> string)((#derive1_field/2 : i32)) +
              " }",
      }
  }
}

impl Hash for Key {
  fn hash(self/3: Key) -> u64 {
      match (self/3 : Key) {
          Key::Empty =>
            {
                let h/4: u64 = (isize::to_u64 : (isize) -> u64)(0) + 14695981039346656037 + 1;
                (h/4 : u64)
            },
          Key::Point(#derive0_field/5: i32, #derive1_field/6: i32) =>
            {
                let h/7: u64 = (isize::to_u64 : (isize) -> u64)(0) + 14695981039346656037 + 2;
                let h/8: u64 =
                  (h/7 : u64) * (isize::to_u64 : (isize) -> u64)(0) + 1099511628211 +
                    (Hash::hash : (i32) -> u64)((#derive0_field/5 : i32));
                let h/9: u64 =
                  (h/8 : u64) * (isize::to_u64 : (isize) -> u64)(0) + 1099511628211 +
                    (Hash::hash : (i32) -> u64)((#derive1_field/6 : i32));
                (h/9 : u64)
            },
      }
  }
}

impl PartialEq for Key {
  fn eq(self/10: Key, other/11: Key) -> bool {
      match ((self/10 : Key), (other/11 : Key)) {
          (Key::Empty, Key::Empty) => true,
          (
            Key::Point(#derive0_left/12: i32, #derive2_left/13: i32),
            Key::Point(#derive1_right/14: i32, #derive3_right/15: i32)
          ) =>
            true &&
              (PartialEq::eq : (i32, i32) -> bool)(
                (#derive0_left/12 : i32),
                (#derive1_right/14 : i32)
              ) &&
              (PartialEq::eq : (i32, i32) -> bool)(
                (#derive2_left/13 : i32),
                (#derive3_right/15 : i32)
              ),
          _ : (Key, Key) => false,
      }
  }
}

impl Eq for Key where i32: Eq, i32: PartialEq {}

fn score(value/16: Message[string]) -> i32 {
    match (value/16 : Message[string]) {
        Message::Quit => 0,
        Message::Write(_ : string) => 1,
        Message::Move(x/17: i32, vertical/18: i32, _ : string) =>
          (x/17 : i32) + (vertical/18 : i32),
    }
}

fn label(value/19: Message[string]) -> string {
    match (value/19 : Message[string]) {
        Message::Move(_ : i32, _ : i32, label/20: string) => (label/20 : string),
        Message::Write(text/21: string) => (text/21 : string),
        Message::Quit => "quit",
    }
}

fn main() -> () {
    let x/22: i32 = 3;
    let direction/23: string = "north";
    let first/24: Message[string] = Message::Move((x/22 : i32), 4, (direction/23 : string));
    let second/25: Message[string] = Message::Move(3, 4, "north");
    (println : (i32) -> ())((score : (Message[string]) -> i32)((first/24 : Message[string])));
    (println : (string) -> ())(
      (label : (Message[string]) -> string)((second/25 : Message[string]))
    );
    (println : (string) -> ())((ToString::to_string : (Key) -> string)(Key::Point(1, 2)));
    (println : (bool) -> ())(
      (PartialEq::eq : (Key, Key) -> bool)(Key::Point(1, 2), Key::Point(1, 2))
    );
}