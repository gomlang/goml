package main
file main.goml
  trait Ready {
    fn state(Self) -> string;
  }

  trait Service[T] where T: Ready {
    fn get(Self) -> T;
  }

  struct Worker {
      name: string,
  }

  struct Station {
      worker: Worker,
  }

  impl Ready for Worker {
    fn state(local/main/0: Worker) -> string {
        self/0.name + ":ready"
    }
  }

  impl Service[Worker] for Station {
    fn get(local/main/1: Station) -> Worker {
        self/1.worker
    }
  }

  fn describe[T, S: Service[T]](local/main/2: S) -> string {
      Service::[T]::get(service/2).state()
  }

  fn main() -> () {
      println(source:4:main:6(Station { worker: Worker { name: "build" } }));
  }