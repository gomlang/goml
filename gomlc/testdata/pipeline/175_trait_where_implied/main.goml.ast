package main;
trait Ready {
  fn state(self: Self) -> string;
}

trait Service[T] where T: Ready {
  fn get(self: Self) -> T;
}

struct Worker {
    name: string,
}

struct Station {
    worker: Worker,
}

impl Ready for Worker {
  fn state(self: Worker) -> string {
      self.name + ":ready"
  }
}

impl Service[Worker] for Station {
  fn get(self: Station) -> Worker {
      self.worker
  }
}

fn describe[T, S: Service[T]](service: S) -> string {
    Service::[T]::get(service).state()
}

fn main() -> () {
    println(describe(Station { worker: Worker { name: "build" } }));
}

