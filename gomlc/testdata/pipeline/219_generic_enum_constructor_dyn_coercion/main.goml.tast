impl Show for Boxed[i32] {
  fn show(self/0: Boxed[i32]) -> string {
      match (self/0 : Boxed[i32]) {
          Boxed::One(value/1: i32) => (i32::to_string : (i32) -> string)((value/1 : i32)),
      }
  }
}

fn render(value/2: dyn Show) -> string {
    (dyn Show::show : (dyn Show) -> string)((value/2 : dyn Show))
}

fn main() -> () {
    let value/3: i32 = 42;
    (println : (string) -> ())(
      (render : (dyn Show) -> string)(to_dyn[Show]{Boxed[i32]}(Boxed::One((value/3 : i32))))
    )
}