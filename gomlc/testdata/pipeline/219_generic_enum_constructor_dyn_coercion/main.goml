trait Show {
    fn show(self: Self) -> string;
}

enum Boxed[T] {
    One(T),
}

impl Show for Boxed[i32] {
    fn show(self: Boxed[i32]) -> string {
        match self {
            Boxed::One(value) => value.to_string(),
        }
    }
}

fn render(value: dyn Show) -> string {
    Show::show(value)
}

fn main() -> () {
    let value: i32 = 42;
    println(render(Boxed::One(value) as dyn Show))
}
