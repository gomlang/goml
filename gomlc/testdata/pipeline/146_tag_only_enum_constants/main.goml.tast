fn light_code(light/0: Light) -> i32 {
    match (light/0 : Light) {
        Light::Red => 10,
        Light::Yellow => 20,
        Light::Green => 30,
    }
}

fn paint_code(paint/1: Paint) -> i32 {
    match (paint/1 : Paint) {
        Paint::Red => 1,
        Paint::Blue => 2,
    }
}

fn main() -> () {
    let light/2: Light = Light::Red;
    let paint/3: Paint = Paint::Red;
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)((light_code : (Light) -> i32)((light/2 : Light)))
      );
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)((paint_code : (Paint) -> i32)((paint/3 : Paint)))
      );
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)((light_code : (Light) -> i32)(Light::Green))
      );
    (println : (string) -> ())(
      (i32::to_string : (i32) -> string)((paint_code : (Paint) -> i32)(Paint::Blue))
    )
}