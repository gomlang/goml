package main
file main.goml
  enum Light {
      Red,
      Yellow,
      Green
  }

  enum Paint {
      Red,
      Blue
  }

  fn light_code(local/main/0: Light) -> i32 {
      match light/0 {
          ctor(source:4:main:0::v0) => 10,
          ctor(source:4:main:0::v1) => 20,
          ctor(source:4:main:0::v2) => 30,
      }
  }

  fn paint_code(local/main/1: Paint) -> i32 {
      match paint/1 {
          ctor(source:4:main:1::v0) => 1,
          ctor(source:4:main:1::v1) => 2,
      }
  }

  fn main() {
      let local/main/2 = ctor(source:4:main:0::v0);
      let local/main/3 = ctor(source:4:main:1::v0);
      let _ = println(source:4:main:2(light/2).to_string());
      let _ = println(source:4:main:3(paint/3).to_string());
      let _ = println(source:4:main:2(ctor(source:4:main:0::v2)).to_string());
      println(source:4:main:3(ctor(source:4:main:1::v1)).to_string())
  }