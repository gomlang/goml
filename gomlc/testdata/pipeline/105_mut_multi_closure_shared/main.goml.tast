fn main() -> () {
    let mut x/0: isize = 0;
    let inc/1: () -> isize =
      || =>
        {
            (x/0 : isize) = (x/0 : isize) + 1;
            (x/0 : isize)
        };
    let get/2: () -> isize = || => (x/0 : isize);
    let _ : isize = (inc/1 : () -> isize)();
    (println : (string) -> ())((isize::to_string : (isize) -> string)((get/2 : () -> isize)()));
}