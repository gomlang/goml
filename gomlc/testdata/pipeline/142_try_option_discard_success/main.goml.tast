fn cut_pair(ok/0: bool) -> Option[(string, string)] {
    if (ok/0 : bool) {
        {
            Option::Some(("left", "right"))
        }
    } else {
        {
            Option::None
        }
    }
}

fn check(ok/1: bool) -> Option[string] {
    let _ : (string, string) =
      match (cut_pair : (bool) -> Option[(string, string)])((ok/1 : bool)) {
          Option::Some(try_value/13: (string, string)) => (try_value/13 : (string, string)),
          Option::None => return Option::None,
      };
    Option::Some("ok")
}

fn show(opt/2: Option[string]) -> string {
    match (opt/2 : Option[string]) {
        Option::Some(value/3: string) => "some " + (value/3 : string),
        Option::None => "none",
    }
}

fn main() -> () {
    (println : (string) -> ())(
      (show : (Option[string]) -> string)((check : (bool) -> Option[string])(true))
    );
    (println : (string) -> ())(
      (show : (Option[string]) -> string)((check : (bool) -> Option[string])(false))
    );
}