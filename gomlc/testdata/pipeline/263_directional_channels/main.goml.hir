package main
file main.goml
  fn main() -> () {
      let local/1/0: Channel[isize] = Channel::new(2);
      let (local/1/1, local/1/2) = channel/0.split();
      sender/1.send(7);
      select priority {
          recv(receiver/2) as local/1/3 => println(value/3.unwrap_or(0)),
          default => println(1),
      };
      let local/1/4: Channel[isize] = Channel::new(1);
      let local/1/5: Sender[isize] = channel/4.sender();
      let local/1/6: Receiver[isize] = channel/4.receiver();
      select priority {
          send(sender/5, 9) => println(receiver/6.recv().unwrap_or(0)),
          default => println(2),
      }
  }