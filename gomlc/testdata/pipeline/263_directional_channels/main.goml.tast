fn main() -> () {
    let channel/0: Channel[isize] = (Channel[isize]::new : (isize) -> Channel[isize])(2);
    let (sender/1: Sender[isize], receiver/2: Receiver[isize]) =
      (Channel[isize]::split : (Channel[isize]) -> (Sender[isize], Receiver[isize]))(
        (channel/0 : Channel[isize])
      );
    (Sender[isize]::send : (Sender[isize], isize) -> ())((sender/1 : Sender[isize]), 7);
    select priority {
        recv((receiver/2 : Receiver[isize])) as value/3 =>
          (println : (isize) -> ())(
            (Option[isize]::unwrap_or : (Option[isize], isize) -> isize)(
              (value/3 : Option[isize]),
              0
            )
          ),
        default => (println : (isize) -> ())(1),
    };
    let channel/4: Channel[isize] = (Channel[isize]::new : (isize) -> Channel[isize])(1);
    let sender/5: Sender[isize] =
      (Channel[isize]::sender : (Channel[isize]) -> Sender[isize])((channel/4 : Channel[isize]));
    let receiver/6: Receiver[isize] =
      (Channel[isize]::receiver : (Channel[isize]) -> Receiver[isize])(
        (channel/4 : Channel[isize])
      );
    select priority {
        send((sender/5 : Sender[isize]), 9) =>
          (println : (isize) -> ())(
            (Option[isize]::unwrap_or : (Option[isize], isize) -> isize)(
              (Receiver[isize]::recv : (Receiver[isize]) -> Option[isize])(
                (receiver/6 : Receiver[isize])
              ),
              0
            )
          ),
        default => (println : (isize) -> ())(2),
    }
}