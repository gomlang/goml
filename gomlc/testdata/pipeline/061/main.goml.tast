impl ToString for Color {
  fn to_string(self/0: Color) -> string {
      match (self/0 : Color) {
          Color::Red => "Color::Red",
          Color::Green => "Color::Green",
          Color::Blue => "Color::Blue",
      }
  }
}

impl ToString for Point {
  fn to_string(self/1: Point) -> string {
      {
          let Point {
            x: #derive0_field/2: i32,
            y: #derive1_field/3: i32,
            color: #derive2_field/4: Color
          } =
            (self/1 : Point);
          "Point { " + "x: " + (ToString::to_string : (i32) -> string)((#derive0_field/2 : i32)) +
            ", " +
            "y: " +
            (ToString::to_string : (i32) -> string)((#derive1_field/3 : i32)) +
            ", " +
            "color: " +
            (ToString::to_string : (Color) -> string)((#derive2_field/4 : Color)) +
            " }"
      }
  }
}

impl Point {
  fn new(x/5: i32, y/6: i32, color/7: Color) -> Point {
      Point { x: (x/5 : i32), y: (y/6 : i32), color: (color/7 : Color) }
  }
}

impl ToString for Line {
  fn to_string(self/8: Line) -> string {
      {
          let Line {
            from: #derive0_field/9: Point,
            to: #derive1_field/10: Point,
            color: #derive2_field/11: Color
          } =
            (self/8 : Line);
          "Line { " + "from: " +
            (ToString::to_string : (Point) -> string)((#derive0_field/9 : Point)) +
            ", " +
            "to: " +
            (ToString::to_string : (Point) -> string)((#derive1_field/10 : Point)) +
            ", " +
            "color: " +
            (ToString::to_string : (Color) -> string)((#derive2_field/11 : Color)) +
            " }"
      }
  }
}

impl Line {
  fn new(from/12: Point, to/13: Point, color/14: Color) -> Line {
      Line { from: (from/12 : Point), to: (to/13 : Point), color: (color/14 : Color) }
  }
}

impl ToString for LineList {
  fn to_string(self/15: LineList) -> string {
      match (self/15 : LineList) {
          LineList::Nil => "LineList::Nil",
          LineList::Cons(#derive0_field/16: Line, #derive1_field/17: LineList) =>
            "LineList::Cons(" +
              (ToString::to_string : (Line) -> string)((#derive0_field/16 : Line)) +
              ", " +
              (ToString::to_string : (LineList) -> string)((#derive1_field/17 : LineList)) +
              ")",
      }
  }
}

fn main() -> () {
    let from/18: Point = (Point::new : (i32, i32, Color) -> Point)(10, 20, Color::Red);
    let to/19: Point = (Point::new : (i32, i32, Color) -> Point)(30, 40, Color::Green);
    let line/20: Line =
      (Line::new : (Point, Point, Color) -> Line)((from/18 : Point), (to/19 : Point), Color::Blue);
    let lines/21: LineList = LineList::Cons((line/20 : Line), LineList::Nil);
    (println : (string) -> ())((ToString::to_string : (LineList) -> string)((lines/21 : LineList)));
}