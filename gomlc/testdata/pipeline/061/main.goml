#[derive(ToString)]
enum Color {
    Red,
    Green,
    Blue,
}

#[derive(ToString)]
struct Point {
    x: i32,
    y: i32,
    color: Color,
}

impl Point {
    fn new(x: i32, y: i32, color: Color) -> Point {
        Point { x: x, y: y, color: color }
    }
}

#[derive(ToString)]
struct Line {
    from: Point,
    to: Point,
    color: Color,
}

impl Line {
    fn new(from: Point, to: Point, color: Color) -> Line {
        Line { from: from, to: to, color: color }
    }
}

#[derive(ToString)]
enum LineList {
    Nil,
    Cons(Line, LineList),
}

fn main() {
    let from = Point::new(10, 20, Color::Red);
    let to = Point::new(30, 40, Color::Green);
    let line = Line::new(from, to, Color::Blue);
    let lines = LineList::Cons(line, LineList::Nil);
    println(lines.to_string());
}
