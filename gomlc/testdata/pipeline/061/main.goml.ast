package main;
#[derive(ToString)]
enum Color {
    Red,
    Green,
    Blue
}

impl ToString for Color {
  fn to_string(self: Color) -> string {
      match self {
          Color::Red => "Color::Red",
          Color::Green => "Color::Green",
          Color::Blue => "Color::Blue",
      }
  }
}

#[derive(ToString)]
struct Point {
    x: i32,
    y: i32,
    color: Color,
}

impl ToString for Point {
  fn to_string(self: Point) -> string {
      {
          let Point { x: #derive0_field, y: #derive1_field, color: #derive2_field } = self;
          "Point { " + "x: " + ToString::to_string(#derive0_field) + ", " + "y: " +
            ToString::to_string(#derive1_field) +
            ", " +
            "color: " +
            ToString::to_string(#derive2_field) +
            " }"
      }
  }
}

impl Point {
  fn new(x: i32, y: i32, color: Color) -> Point {
      Point { x: x, y: y, color: color }
  }
}

#[derive(ToString)]
struct Line {
    from: Point,
    to: Point,
    color: Color,
}

impl ToString for Line {
  fn to_string(self: Line) -> string {
      {
          let Line { from: #derive0_field, to: #derive1_field, color: #derive2_field } = self;
          "Line { " + "from: " + ToString::to_string(#derive0_field) + ", " + "to: " +
            ToString::to_string(#derive1_field) +
            ", " +
            "color: " +
            ToString::to_string(#derive2_field) +
            " }"
      }
  }
}

impl Line {
  fn new(from: Point, to: Point, color: Color) -> Line {
      Line { from: from, to: to, color: color }
  }
}

#[derive(ToString)]
enum LineList {
    Nil,
    Cons(Line, LineList)
}

impl ToString for LineList {
  fn to_string(self: LineList) -> string {
      match self {
          LineList::Nil => "LineList::Nil",
          LineList::Cons(#derive0_field, #derive1_field) =>
            "LineList::Cons(" + ToString::to_string(#derive0_field) + ", " +
              ToString::to_string(#derive1_field) +
              ")",
      }
  }
}

fn main() {
    let from = Point::new(10, 20, Color::Red);
    let to = Point::new(30, 40, Color::Green);
    let line = Line::new(from, to, Color::Blue);
    let lines = LineList::Cons(line, LineList::Nil);
    println(lines.to_string());
}

