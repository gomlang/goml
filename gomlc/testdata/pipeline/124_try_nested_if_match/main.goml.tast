fn maybe_num(flag/0: bool) -> Option[i32] {
    if (flag/0 : bool) {
        {
            Option::Some(8)
        }
    } else {
        {
            Option::None
        }
    }
}

fn nested(top/1: bool, mode/2: Mode, inner_flag/3: bool) -> Option[i32] {
    let value/6: i32 =
      if (top/1 : bool) {
          {
              match (mode/2 : Mode) {
                  Mode::Take =>
                    {
                        let inner/4: i32 =
                          match (maybe_num : (bool) -> Option[i32])((inner_flag/3 : bool)) {
                              Option::Some(try_value/13: i32) => (try_value/13 : i32),
                              Option::None => return Option::None,
                          };
                        (inner/4 : i32) + 1
                    },
                  Mode::Skip => 20,
              }
          }
      } else {
          {
              let inner/5: i32 =
                match (maybe_num : (bool) -> Option[i32])((inner_flag/3 : bool)) {
                    Option::Some(try_value/24: i32) => (try_value/24 : i32),
                    Option::None => return Option::None,
                };
              (inner/5 : i32) + 2
          }
      };
    Option::Some((value/6 : i32))
}

fn show(opt/7: Option[i32]) -> string {
    match (opt/7 : Option[i32]) {
        Option::Some(value/8: i32) => "some=" + (i32::to_string : (i32) -> string)((value/8 : i32)),
        Option::None => "none",
    }
}

fn main() -> () {
    (println : (string) -> ())(
      (show : (Option[i32]) -> string)(
        (nested : (bool, Mode, bool) -> Option[i32])(true, Mode::Take, true)
      )
    );
    (println : (string) -> ())(
      (show : (Option[i32]) -> string)(
        (nested : (bool, Mode, bool) -> Option[i32])(true, Mode::Skip, false)
      )
    );
    (println : (string) -> ())(
      (show : (Option[i32]) -> string)(
        (nested : (bool, Mode, bool) -> Option[i32])(false, Mode::Take, false)
      )
    );
}