package main;
struct Point {
    x: isize,
    y: isize,
}

fn record(log: Ref[string], label: string, value: isize) -> isize {
    log.set(log.get() + label);
    value
}

fn record_point(log: Ref[string], label: string, value: Point) -> Point {
    log.set(log.get() + label);
    value
}

fn record_vec(log: Ref[string], label: string, value: Vec[isize]) -> Vec[isize] {
    log.set(log.get() + label);
    value
}

fn main() {
    let mut number = 5;
    number += 3;
    number *= 2;
    number >>= 1;
    println(number.to_string());
    let mut direct = Point { x: 3, y: 4 };
    direct.x += 5;
    println(f"{direct.x},{direct.y}");
    let mut pair = (2, 9);
    pair.0 *= 3;
    println(f"{pair.0},{pair.1}");
    let log = Ref::new("");
    let base = Point { x: 1, y: 2 };
    let updated = Point { x: record(log, "F", 7), ..record_point(log, "B", base) };
    println(log.get());
    println(f"{updated.x},{updated.y}");
    log.set("");
    let values = Vec::from_array([record(log, "A", 10), record(log, "B", 20)]);
    record_vec(log, "R", values)[record(log, "I", 1)] += record(log, "V", 5);
    println(log.get());
    println(f"{values.get(0)},{values.get(1)}");
    log.set("");
    let table =
      HashMap::from_array(
        [
          (f"k{record(log, "K", 1)}", record(log, "V", 11)),
          ("same", record(log, "A", 1)),
          ("same", record(log, "B", 2))
        ]
      );
    println(log.get());
    println(
      match table.get("same") {
          Option::Some(value) => value.to_string(),
          Option::None => "missing",
      }
    );
    let empty_values: Vec[isize] = Vec::new();
    let empty_table: HashMap[string, isize] = HashMap::new();
    println(f"empty={empty_values.len() + empty_table.len()} {{ok}}");
}

