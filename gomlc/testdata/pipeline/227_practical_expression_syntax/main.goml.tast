fn record(log/0: Ref[string], label/1: string, value/2: isize) -> isize {
    (Ref[string]::set : (Ref[string], string) -> ())(
      (log/0 : Ref[string]),
      (Ref[string]::get : (Ref[string]) -> string)((log/0 : Ref[string])) + (label/1 : string)
    );
    (value/2 : isize)
}

fn record_point(log/3: Ref[string], label/4: string, value/5: Point) -> Point {
    (Ref[string]::set : (Ref[string], string) -> ())(
      (log/3 : Ref[string]),
      (Ref[string]::get : (Ref[string]) -> string)((log/3 : Ref[string])) + (label/4 : string)
    );
    (value/5 : Point)
}

fn record_vec(log/6: Ref[string], label/7: string, value/8: Vec[isize]) -> Vec[isize] {
    (Ref[string]::set : (Ref[string], string) -> ())(
      (log/6 : Ref[string]),
      (Ref[string]::get : (Ref[string]) -> string)((log/6 : Ref[string])) + (label/7 : string)
    );
    (value/8 : Vec[isize])
}

fn main() -> () {
    let mut number/9: isize = 5;
    (number/9 : isize) += 3;
    (number/9 : isize) *= 2;
    (number/9 : isize) >>= 1;
    (println : (string) -> ())((isize::to_string : (isize) -> string)((number/9 : isize)));
    let mut direct/10: Point = Point { x: 3, y: 4 };
    (direct/10 : Point).x += 5;
    (println : (string) -> ())(
      "" + (isize::to_string : (isize) -> string)((direct/10 : Point).x) + "," +
        (isize::to_string : (isize) -> string)((direct/10 : Point).y)
    );
    let mut pair/11: (isize, isize) = (2, 9);
    (pair/11 : (isize, isize)).0 *= 3;
    (println : (string) -> ())(
      "" + (isize::to_string : (isize) -> string)((pair/11 : (isize, isize)).0) + "," +
        (isize::to_string : (isize) -> string)((pair/11 : (isize, isize)).1)
    );
    let log/12: Ref[string] = (Ref[string]::new : (string) -> Ref[string])("");
    let base/13: Point = Point { x: 1, y: 2 };
    let updated/14: Point =
      {
          let struct_update_field/789/0: isize =
            (record : (Ref[string], string, isize) -> isize)((log/12 : Ref[string]), "F", 7);
          let struct_update_base/789: Point =
            (record_point : (Ref[string], string, Point) -> Point)(
              (log/12 : Ref[string]),
              "B",
              (base/13 : Point)
            );
          Point { x: (struct_update_field/789/0 : isize), y: (struct_update_base/789 : Point).y }
      };
    (println : (string) -> ())(
      (Ref[string]::get : (Ref[string]) -> string)((log/12 : Ref[string]))
    );
    (println : (string) -> ())(
      "" + (isize::to_string : (isize) -> string)((updated/14 : Point).x) + "," +
        (isize::to_string : (isize) -> string)((updated/14 : Point).y)
    );
    (Ref[string]::set : (Ref[string], string) -> ())((log/12 : Ref[string]), "");
    let values/15: Vec[isize] =
      (@intrinsic(vec.from_array) : ([isize; 2]) -> Vec[isize])(
        [
          (record : (Ref[string], string, isize) -> isize)((log/12 : Ref[string]), "A", 10),
          (record : (Ref[string], string, isize) -> isize)((log/12 : Ref[string]), "B", 20)
        ]
      );
    (record_vec : (Ref[string], string, Vec[isize]) -> Vec[isize])(
      (log/12 : Ref[string]),
      "R",
      (values/15 : Vec[isize])
    )[(record : (Ref[string], string, isize) -> isize)((log/12 : Ref[string]), "I", 1)] +=
      (record : (Ref[string], string, isize) -> isize)((log/12 : Ref[string]), "V", 5);
    (println : (string) -> ())(
      (Ref[string]::get : (Ref[string]) -> string)((log/12 : Ref[string]))
    );
    (println : (string) -> ())(
      "" +
        (isize::to_string : (isize) -> string)(
          (Vec[isize]::get : (Vec[isize], isize) -> isize)((values/15 : Vec[isize]), 0)
        ) +
        "," +
        (isize::to_string : (isize) -> string)(
          (Vec[isize]::get : (Vec[isize], isize) -> isize)((values/15 : Vec[isize]), 1)
        )
    );
    (Ref[string]::set : (Ref[string], string) -> ())((log/12 : Ref[string]), "");
    let table/16: HashMap[string, isize] =
      (@intrinsic(hashmap.from_array) : ([(string, isize); 3]) -> HashMap[string, isize])(
        [
          (
            "" + "k" +
              (isize::to_string : (isize) -> string)(
                (record : (Ref[string], string, isize) -> isize)((log/12 : Ref[string]), "K", 1)
              ),
            (record : (Ref[string], string, isize) -> isize)((log/12 : Ref[string]), "V", 11)
          ),
          (
            "same",
            (record : (Ref[string], string, isize) -> isize)((log/12 : Ref[string]), "A", 1)
          ),
          ("same", (record : (Ref[string], string, isize) -> isize)((log/12 : Ref[string]), "B", 2))
        ]
      );
    (println : (string) -> ())(
      (Ref[string]::get : (Ref[string]) -> string)((log/12 : Ref[string]))
    );
    (println : (string) -> ())(
      match (HashMap[string, isize]::get : (HashMap[string, isize], string) -> Option[isize])(
        (table/16 : HashMap[string, isize]),
        "same"
      ) {
          Option::Some(value/17: isize) =>
            (isize::to_string : (isize) -> string)((value/17 : isize)),
          Option::None => "missing",
      }
    );
    let empty_values/18: Vec[isize] = (Vec[isize]::new : () -> Vec[isize])();
    let empty_table/19: HashMap[string, isize] =
      (HashMap[string, isize]::new : () -> HashMap[string, isize])();
    (println : (string) -> ())(
      "" + "empty=" +
        (isize::to_string : (isize) -> string)(
          (Vec[isize]::len : (Vec[isize]) -> isize)((empty_values/18 : Vec[isize])) +
            (HashMap[string, isize]::len : (HashMap[string, isize]) -> isize)(
              (empty_table/19 : HashMap[string, isize])
            )
        ) +
        " {ok}"
    );
}