fn test_nested_match(x/0: (bool, bool), y/1: (bool, bool)) -> () {
    match (x/0 : (bool, bool)) {
        (true, false) =>
          match (y/1 : (bool, bool)) {
              (false, true) => (println : (string) -> ())("case1"),
              _ : (bool, bool) => (println : (string) -> ())("case2"),
          },
        _ : (bool, bool) =>
          match (y/1 : (bool, bool)) {
              (false, true) => (println : (string) -> ())("case3"),
              _ : (bool, bool) => (println : (string) -> ())("case4"),
          },
    }
}

fn main() -> () {
    let _ : () =
      (test_nested_match : ((bool, bool), (bool, bool)) -> ())((true, false), (false, true));
    let _ : () =
      (test_nested_match : ((bool, bool), (bool, bool)) -> ())((true, false), (true, false));
    let _ : () =
      (test_nested_match : ((bool, bool), (bool, bool)) -> ())((false, true), (false, true));
    let _ : () =
      (test_nested_match : ((bool, bool), (bool, bool)) -> ())((false, true), (true, false));
}