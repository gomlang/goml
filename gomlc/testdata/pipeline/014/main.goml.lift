fn test_nested_match(x/0: (bool, bool), y/0: (bool, bool)) -> () {
  let x0 = x/0.0 in
  let x1 = x/0.1 in
  match x1 {
    true => {
      let x2 = y/0.0 in
      let x3 = y/0.1 in
      match x3 {
        true => {
          match x2 {
            true => {
              println__T_string("case4")
            },
            false => {
              println__T_string("case3")
            },
          }
        },
        false => {
          println__T_string("case4")
        },
      }
    },
    false => {
      match x0 {
        true => {
          let x4 = y/0.0 in
          let x5 = y/0.1 in
          match x5 {
            true => {
              match x4 {
                true => {
                  println__T_string("case2")
                },
                false => {
                  println__T_string("case1")
                },
              }
            },
            false => {
              println__T_string("case2")
            },
          }
        },
        false => {
          let x6 = y/0.0 in
          let x7 = y/0.1 in
          match x7 {
            true => {
              match x6 {
                true => {
                  println__T_string("case4")
                },
                false => {
                  println__T_string("case3")
                },
              }
            },
            false => {
              println__T_string("case4")
            },
          }
        },
      }
    },
  }
}

fn main() -> () {
  let mtmp0 = test_nested_match((true, false), (false, true)) in
  let mtmp1 = test_nested_match((true, false), (true, false)) in
  let mtmp2 = test_nested_match((false, true), (false, true)) in
  let mtmp3 = test_nested_match((false, true), (true, false)) in
  ()
}

fn println__T_string(value/0: string) -> () {
  @runtime(core.string_println)(trait_impl#ToString#string#to_string(value/0))
}

fn trait_impl#ToString#string#to_string(self/0: string) -> string {
  self/0
}