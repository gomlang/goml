    (println : (isize) -> ())((Vec[i32]::len : (Vec[i32]) -> isize)((values/0 : Vec[i32])));
    for value/1: i32 in
      (values/0 : Vec[i32]) {
        (println : (i32) -> ())((value/1 : i32))
    }
}

fn main() -> () {
    let values/2: Vec[i32] = (Vec[i32]::new : () -> Vec[i32])();
    (Vec[i32]::push : (Vec[i32], i32) -> ())((values/2 : Vec[i32]), 1);
