fn print_values(values: Vec[i32]) -> () {
    println(values.len());
    for value in values {
        println(value)
    }
}

fn main() {
    let values: Vec[i32] = Vec::new();
    values.push(1);
    values.push(2);
    values.push(3);
    values.extend(values);
    print_values(values);
    let aliased: Vec[i32] = Vec::new();
    aliased.push(4);
    aliased.push(5);
    let same = aliased;
    aliased.extend(same);
    print_values(aliased);
    let empty: Vec[i32] = Vec::new();
    empty.extend(empty);
    print_values(empty)
}
