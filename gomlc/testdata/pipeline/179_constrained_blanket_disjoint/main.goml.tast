impl Mark for i32 {
  fn mark(self/0: i32) -> string {
      (i32::to_string : (i32) -> string)((self/0 : i32))
  }
}

impl[T] Label for Box[T] where T: Mark {
  fn label(self/1: Box[T]) -> string {
      "blanket:" + (Mark::mark : (T) -> string)((self/1 : Box[T]).value)
  }
}

impl Label for Box[string] {
  fn label(self/2: Box[string]) -> string {
      "string:" + (self/2 : Box[string]).value
  }
}

fn main() -> () {
    (println : (string) -> ())((Label::label : (Box[string]) -> string)(Box { value: "text" }));
    let value/3: Box[i32] = Box { value: 7 };
    (println : (string) -> ())((Label::label : (Box[i32]) -> string)((value/3 : Box[i32])));
}