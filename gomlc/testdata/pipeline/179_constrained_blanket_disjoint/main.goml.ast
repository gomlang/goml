package main;
trait Mark {
  fn mark(self: Self) -> string;
}

trait Label {
  fn label(self: Self) -> string;
}

struct Box[T] {
    value: T,
}

impl Mark for i32 {
  fn mark(self: i32) -> string {
      self.to_string()
  }
}

impl[T: Mark] Label for Box[T] {
  fn label(self: Box[T]) -> string {
      "blanket:" + self.value.mark()
  }
}

impl Label for Box[string] {
  fn label(self: Box[string]) -> string {
      "string:" + self.value
  }
}

fn main() -> () {
    println(Box { value: "text" }.label());
    let value: Box[i32] = Box { value: 7 };
    println(value.label());
}

