package main
file main.goml
  trait Mark {
    fn mark(Self) -> string;
  }

  trait Label {
    fn label(Self) -> string;
  }

  struct Box[T] {
      value: T,
  }

  impl Mark for i32 {
    fn mark(local/1/0: i32) -> string {
        self/0.to_string()
    }
  }

  impl[T: Mark] Label for Box[T] {
    fn label(local/1/1: Box[T]) -> string {
        "blanket:" + self/1.value.mark()
    }
  }

  impl Label for Box[string] {
    fn label(local/1/2: Box[string]) -> string {
        "string:" + self/2.value
    }
  }

  fn main() -> () {
      println(Box { value: "text" }.label());
      let local/1/3: Box[i32] = Box { value: 7 };
      println(value/3.label());
  }