fn main() -> () {
    let poem/0: string =
      "roses are red\nviolets are blue\n\"quotes\" stay quoted\nbackslash \\\\\\\\ stays too";
    let trailing_blank/1: string = "line one\n\nline three";
    (println : (string) -> ())((poem/0 : string));
    (println : (string) -> ())((trailing_blank/1 : string));
}