impl[U, V] Point[U, V] {
  fn new(x/0: U, y/1: V) -> Point[U, V] {
      Point { x: (x/0 : U), y: (y/1 : V) }
  }
  fn swap(self/2: Point[U, V]) -> Point[V, U] {
      Point { x: (self/2 : Point[U, V]).y, y: (self/2 : Point[U, V]).x }
  }
  fn get_x(self/3: Point[U, V]) -> U {
      (self/3 : Point[U, V]).x
  }
}

fn main() -> () {
    let p1/4: Point[i32, string] =
      (Point[i32, string]::new : (i32, string) -> Point[i32, string])(10, "hello");
    let p2/5: Point[string, string] =
      (Point[string, string]::new : (string, string) -> Point[string, string])("goml", "lang");
    let p3/6: Point[string, i32] =
      (Point[i32, string]::swap : (Point[i32, string]) -> Point[string, i32])(
        (p1/4 : Point[i32, string])
      );
    let x/7: i32 = (p3/6 : Point[string, i32]).y;
    (println : (string) -> ())((i32::to_string : (i32) -> string)((x/7 : i32)));
    let x2/8: string =
      (Point[string, string]::get_x : (Point[string, string]) -> string)(
        (p2/5 : Point[string, string])
      );
    (println : (string) -> ())((x2/8 : string))
}