package main;
struct Point[U, V] {
    x: U,
    y: V,
}

impl[U, V] Point[U, V] {
  fn new(x: U, y: V) -> Point[U, V] {
      Point { x: x, y: y }
  }
  fn swap(self: Point[U, V]) -> Point[V, U] {
      Point { x: self.y, y: self.x }
  }
  fn get_x(self: Point[U, V]) -> U {
      self.x
  }
}

fn main() -> () {
    let p1: Point[i32, string] = Point::new(10, "hello");
    let p2: Point[string, string] = Point::new("goml", "lang");
    let p3: Point[string, i32] = p1.swap();
    let x: i32 = p3.y;
    println(x.to_string());
    let x2: string = p2.get_x();
    println(x2)
}

