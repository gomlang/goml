  struct Point[U, V] {
      x: U,
      y: V,
  }

  impl[U, V] Point[U, V] {
    fn new(local/main/0: U, local/main/1: V) -> Point[U, V] {
        Point { x: x/0, y: y/1 }
    }
    fn swap(local/main/2: Point[U, V]) -> Point[V, U] {
        Point { x: self/2.y, y: self/2.x }
    }
    fn get_x(local/main/3: Point[U, V]) -> U {
        self/3.x
    }
  }

