fn countdown(start/0: i32) -> FnIterator[i32] {
    let current/1: Ref[i32] = (Ref[i32]::new : (i32) -> Ref[i32])((start/0 : i32));
    (FnIterator[
      i32
    ]::from_fn : (
      () -> Option[i32]
    ) -> FnIterator[
      i32
    ])(
      || =>
        {
            let value/2: i32 = (Ref[i32]::get : (Ref[i32]) -> i32)((current/1 : Ref[i32]));
            if (value/2 : i32) > 0 {
                {
                    (Ref[i32]::set : (Ref[i32], i32) -> ())(
                      (current/1 : Ref[i32]),
                      (value/2 : i32) - 1
                    );
                    Option::Some((value/2 : i32))
                }
            } else {
                {
                    Option::None
                }
            }
        }
    )
}

fn counted_range(calls/3: Ref[i32]) -> FnIterator[isize] {
    (Ref[i32]::set : (Ref[i32], i32) -> ())(
      (calls/3 : Ref[i32]),
      (Ref[i32]::get : (Ref[i32]) -> i32)((calls/3 : Ref[i32])) + 1
    );
    (range : (isize, isize) -> FnIterator[isize])(1, 5)
}

fn first_even(values/4: FnIterator[isize]) -> isize {
    for value/5: isize in
      (values/4 : FnIterator[isize]) {
        if (value/5 : isize) / 2 * 2 == (value/5 : isize) {
            {
                return (value/5 : isize)
            }
        } else {
            {}
        };
    };
    -1
}

fn main() -> () {
    let values/6: Vec[i32] = (Vec[i32]::new : () -> Vec[i32])();
    (Vec[i32]::push : (Vec[i32], i32) -> ())((values/6 : Vec[i32]), 10);
    (Vec[i32]::push : (Vec[i32], i32) -> ())((values/6 : Vec[i32]), 20);
    (Vec[i32]::push : (Vec[i32], i32) -> ())((values/6 : Vec[i32]), 30);
    let sum/7: Ref[i32] = (Ref[i32]::new : (i32) -> Ref[i32])(0);
    for value/8: i32 in
      (values/6 : Vec[i32]) {
        if (value/8 : i32) == 20 {
            {
                continue
            }
        } else {
            {}
        };
        (Ref[i32]::set : (Ref[i32], i32) -> ())(
          (sum/7 : Ref[i32]),
          (Ref[i32]::get : (Ref[i32]) -> i32)((sum/7 : Ref[i32])) + (value/8 : i32)
        );
    };
    (println : (i32) -> ())((Ref[i32]::get : (Ref[i32]) -> i32)((sum/7 : Ref[i32])));
    let pairs/9: Vec[(i32, string)] = (Vec[(i32, string)]::new : () -> Vec[(i32, string)])();
    (Vec[(i32, string)]::push : (Vec[(i32, string)], (i32, string)) -> ())(
      (pairs/9 : Vec[(i32, string)]),
      (1, "a")
    );
    (Vec[(i32, string)]::push : (Vec[(i32, string)], (i32, string)) -> ())(
      (pairs/9 : Vec[(i32, string)]),
      (2, "b")
    );
    for (number/10: i32, text/11: string) in
      (pairs/9 : Vec[(i32, string)]) {
        (println : (string) -> ())(
          (i32::to_string : (i32) -> string)((number/10 : i32)) + (text/11 : string)
        );
    };
    let calls/12: Ref[i32] = (Ref[i32]::new : (i32) -> Ref[i32])(0);
    let range_sum/13: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    for value/14: isize in
      (counted_range : (Ref[i32]) -> FnIterator[isize])((calls/12 : Ref[i32])) {
        (Ref[isize]::set : (Ref[isize], isize) -> ())(
          (range_sum/13 : Ref[isize]),
          (Ref[isize]::get : (Ref[isize]) -> isize)((range_sum/13 : Ref[isize])) +
            (value/14 : isize)
        );
    };
    (println : (i32) -> ())((Ref[i32]::get : (Ref[i32]) -> i32)((calls/12 : Ref[i32])));
    (println : (isize) -> ())(
      (Ref[isize]::get : (Ref[isize]) -> isize)((range_sum/13 : Ref[isize]))
    );
    let slice_sum/15: Ref[i32] = (Ref[i32]::new : (i32) -> Ref[i32])(0);
    for value/16: i32 in
      (Vec[i32]::slice : (Vec[i32], isize, isize) -> Slice[i32])((values/6 : Vec[i32]), 1, 3) {
        (Ref[i32]::set : (Ref[i32], i32) -> ())(
          (slice_sum/15 : Ref[i32]),
          (Ref[i32]::get : (Ref[i32]) -> i32)((slice_sum/15 : Ref[i32])) + (value/16 : i32)
        );
    };
    (println : (i32) -> ())((Ref[i32]::get : (Ref[i32]) -> i32)((slice_sum/15 : Ref[i32])));
    for value/17: i32 in
      (countdown : (i32) -> FnIterator[i32])(4) {
        if (value/17 : i32) == 2 {
            {
                break
            }
        } else {
            {
                (println : (i32) -> ())((value/17 : i32));
            }
        };
    };
    let empty/18: FnIterator[isize] = (range : (isize, isize) -> FnIterator[isize])(0, 0);
    for _ : isize in (empty/18 : FnIterator[isize]) {};
    (println : (isize) -> ())(
      (first_even : (FnIterator[isize]) -> isize)(
        (range : (isize, isize) -> FnIterator[isize])(3, 8)
      )
    );
    (println : (string) -> ())("done");
}