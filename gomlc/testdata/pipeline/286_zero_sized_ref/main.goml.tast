fn distinct[T](value/0: T) -> () {
    let refs/1: Vec[Ref[T]] = (Vec[Ref[T]]::new : () -> Vec[Ref[T]])();
    let keys/2: HashMap[Ref[T], isize] =
      (HashMap[Ref[T], isize]::new : () -> HashMap[Ref[T], isize])();
    for index/3: isize in
      (__goml_builtin_range : (isize, isize) -> FnIterator[isize])(0, 128) {
        let reference/4: Ref[T] = (Ref[T]::new : (T) -> Ref[T])((value/0 : T));
        (Vec[Ref[T]]::push : (Vec[Ref[T]], Ref[T]) -> ())(
          (refs/1 : Vec[Ref[T]]),
          (reference/4 : Ref[T])
        );
        (HashMap[Ref[T], isize]::set : (HashMap[Ref[T], isize], Ref[T], isize) -> ())(
          (keys/2 : HashMap[Ref[T], isize]),
          (reference/4 : Ref[T]),
          (index/3 : isize)
        )
    };
    (println : (isize) -> ())(
      (HashMap[Ref[T], isize]::len : (HashMap[Ref[T], isize]) -> isize)(
        (keys/2 : HashMap[Ref[T], isize])
      )
    );
    (println : (bool) -> ())(
      (@intrinsic(ref.ptr_eq) : (Ref[T], Ref[T]) -> bool)(
        (refs/1 : Vec[Ref[T]])[0],
        (refs/1 : Vec[Ref[T]])[1]
      )
    );
    (println : (bool) -> ())(
      (@intrinsic(ref.ptr_eq) : (Ref[T], Ref[T]) -> bool)(
        (refs/1 : Vec[Ref[T]])[0],
        (refs/1 : Vec[Ref[T]])[0]
      )
    );
    (println : (isize) -> ())(
      (Option[isize]::unwrap_or : (Option[isize], isize) -> isize)(
        (keys/2 : HashMap[Ref[T], isize])[(refs/1 : Vec[Ref[T]])[127]],
        -1
      )
    );
    (Ref[T]::set : (Ref[T], T) -> ())((refs/1 : Vec[Ref[T]])[0], (value/0 : T));
    (println : (isize) -> ())(
      (Option[isize]::unwrap_or : (Option[isize], isize) -> isize)(
        (keys/2 : HashMap[Ref[T], isize])[(refs/1 : Vec[Ref[T]])[0]],
        -1
      )
    )
}

fn main() -> () {
    (distinct : (()) -> ())(());
    (distinct : (Empty) -> ())(Empty {});
    (distinct : (Nested) -> ())(Nested { value: ((), Empty {}) });
    let empty/5: [(); 0] = [];
    (distinct : ([(); 0]) -> ())((empty/5 : [(); 0]));
    (distinct : ([(); 3]) -> ())([(), (), ()]);
