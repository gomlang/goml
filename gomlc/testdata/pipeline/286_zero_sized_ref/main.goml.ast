package main;
struct Empty {}

struct Nested {
    value: ((), Empty),
}

fn distinct[T](value: T) -> () {
    let refs: Vec[Ref[T]] = Vec::new();
    let keys: HashMap[Ref[T], isize] = HashMap::new();
    for index in
      0..128 {
        let reference = Ref::new(value);
        refs.push(reference);
        keys.set(reference, index)
    };
    println(keys.len());
    println(ptr_eq(refs[0], refs[1]));
    println(ptr_eq(refs[0], refs[0]));
    println(keys[refs[127]].unwrap_or(-1));
    refs[0].set(value);
    println(keys[refs[0]].unwrap_or(-1))
}

fn main() -> () {
    distinct(());
    distinct(Empty {});
    distinct(Nested { value: ((), Empty {}) });
    let empty: [(); 0] = [];
    distinct(empty);
    distinct([(), (), ()]);
    distinct(false)
}

