package main
file main.gom
  struct Empty {}

  struct Nested {
      value: ((), Empty),
  }

  fn distinct[T](local/1/0: T) -> () {
      let local/1/1: Vec[Ref[T]] = Vec::new();
      let local/1/2: HashMap[Ref[T], isize] = HashMap::new();
      for local/1/3 in
        0..128 {
          let local/1/4 = Ref::new(value/0);
          refs/1.push(reference/4);
          keys/2.set(reference/4, index/3)
      };
      println(keys/2.len());
      println(ptr_eq(refs/1[0], refs/1[1]));
      println(ptr_eq(refs/1[0], refs/1[0]));
      println(keys/2[refs/1[127]].unwrap_or(-1));
      refs/1[0].set(value/0);
      println(keys/2[refs/1[0]].unwrap_or(-1))
  }

  fn main() -> () {
      def/1/2(());
      def/1/2(Empty {});
      def/1/2(Nested { value: ((), Empty {}) });
      let local/1/5: [(); 0] = [];
      def/1/2(empty/5);
      def/1/2([(), (), ()]);
      def/1/2(false)
  }