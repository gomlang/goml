package main
file main.goml
  struct Empty {}

  struct Nested {
      value: ((), Empty),
  }

  fn distinct[T](local/main/0: T) -> () {
      let local/main/1: Vec[Ref[T]] = Vec::new();
      let local/main/2: HashMap[Ref[T], isize] = HashMap::new();
      for local/main/3 in
        0..128 {
          let local/main/4 = Ref::new(value/0);
          refs/1.push(reference/4);
          keys/2.set(reference/4, index/3)
      };
      println(keys/2.len());
      println(ptr_eq(refs/1[0], refs/1[1]));
      println(ptr_eq(refs/1[0], refs/1[0]));
      println(keys/2[refs/1[127]].unwrap_or(-1));
      refs/1[0].set(value/0);
      println(keys/2[refs/1[0]].unwrap_or(-1))
  }

  fn main() -> () {
      source:4:main:2(());
