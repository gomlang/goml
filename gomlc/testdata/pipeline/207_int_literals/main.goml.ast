package main;
fn increment(value: u8) -> u8 {
    value + 1
}

fn one_float32() -> f32 {
    1
}

fn two_int16() -> i16 {
    2.0
}

fn read_uint32(value: Ref[u32]) -> u32 {
    value.get()
}

fn main() -> () {
    let default_integer = 40;
    let default_float = 0.5;
    let small: u8 = 41;
    let inferred = [small, 2];
    let branch =
      if true {
          {
              1
          }
      } else {
          {
              small
          }
      };
    let values: [u16; 2] = [10, 20];
    let delayed = Ref::new(0);
    let byte = "A".byte_get(0);
    println(default_integer + 2.to_string());
    println(default_float.to_string());
    println(increment(small).to_string());
    println(inferred[1].to_string());
    println(branch.to_string());
    println(values[1].to_string());
    println(one_float32().to_string());
    println(two_int16().to_string());
    println(read_uint32(delayed).to_string());
    println(byte == 65.to_string());
    println(
      match byte {
          65 => "byte",
          _ => "other",
      }
    );
}

