  }

  fn main() -> () {
      let local/main/2 = 40;
      let local/main/3 = 0.5;
      let local/main/4: u8 = 41;
      let local/main/5 = [small/4, 2];
      let local/main/6 =
        if true {
            1
        } else {
            small/4
        };
      let local/main/7: [u16; 2] = [10, 20];
      let local/main/8 = Ref::new(0);
      let local/main/9 = "A".byte_get(0);
      println(default_integer/2 + 2.to_string());
      println(default_float/3.to_string());
      println(source:4:main:0(small/4).to_string());
      println(inferred/5[1].to_string());
