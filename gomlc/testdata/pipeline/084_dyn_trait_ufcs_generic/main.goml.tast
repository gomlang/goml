impl Display for Point {
  fn show(self/0: Point) -> string {
      (i32::to_string : (i32) -> string)((self/0 : Point).value)
  }
}

fn to_dyn[T](x/1: T) -> dyn Display where T: Display {
    to_dyn[Display]{T}((x/1 : T))
}

fn render(x/2: dyn Display) -> string {
    (dyn Display::show : (dyn Display) -> string)((x/2 : dyn Display))
}

fn main() -> () {
    let d/3: dyn Display = (to_dyn : (Point) -> dyn Display)(Point { value: 7 });
    (println : (string) -> ())((render : (dyn Display) -> string)((d/3 : dyn Display)));
}