package main;
trait Display {
  fn show(self: Self) -> string;
}

struct Point {
    value: i32,
}

impl Display for Point {
  fn show(self: Point) -> string {
      self.value.to_string()
  }
}

fn to_dyn[T: Display](x: T) -> dyn Display {
    x as dyn Display
}

fn render(x: dyn Display) -> string {
    Display::show(x)
}

fn main() {
    let d = to_dyn(Point { value: 7 });
    println(render(d));
}

