package main;
struct Point {
    x: i32,
    y: i32,
}

struct Flag {
    value: bool,
}

trait Display {
  fn show(self: Self) -> string;
}

impl Display for Point {
  fn show(self: Point) -> string {
      "Point(" + self.x.to_string() + "," + self.y.to_string() + ")"
  }
}

impl Display for Flag {
  fn show(self: Flag) -> string {
      if self.value {
          {
              "Flag(true)"
          }
      } else {
          {
              "Flag(false)"
          }
      }
  }
}

fn main() {
    let p = Point { x: 1, y: 2 };
    let t = Flag { value: true };
    let dp: dyn Display = p as dyn Display;
    let dt: dyn Display = t as dyn Display;
    let _ = println(Display::show(dp));
    let _ = println(Display::show(dt));
}

