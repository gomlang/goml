package main
file main.goml
  struct Point {
      x: i32,
      y: i32,
  }

  struct Flag {
      value: bool,
  }

  trait Display {
    fn show(Self) -> string;
  }

  impl Display for Point {
    fn show(local/main/0: Point) -> string {
        "Point(" + self/0.x.to_string() + "," + self/0.y.to_string() + ")"
    }
  }

  impl Display for Flag {
    fn show(local/main/1: Flag) -> string {
        if self/1.value {
            "Flag(true)"
        } else {
            "Flag(false)"
        }
    }
  }

  fn main() {
      let local/main/2 = Point { x: 1, y: 2 };
      let local/main/3 = Flag { value: true };
      let local/main/4: dyn Display = p/2 as dyn Display;
      let local/main/5: dyn Display = t/3 as dyn Display;
      let _ = println(Display::show(dp/4));
      let _ = println(Display::show(dt/5));
  }