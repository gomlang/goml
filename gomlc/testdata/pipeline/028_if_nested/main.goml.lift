fn classify(x/0: i32) -> string {
  if (x/0 < 0) {
      "negative"
  } else {
      if (0 < x/0) {
          "positive"
      } else {
          "zero"
      }
  }
}

fn triangle_type(a/0: i32, b/0: i32, c/0: i32) -> string {
  if (a/0 < b/0) {
      if (b/0 < c/0) {
          "ascending"
      } else {
          "peak"
      }
  } else {
      if (a/0 < c/0) {
          "valley"
      } else {
          "flat"
      }
  }
}

fn main() -> () {
  let first/0 = classify(-42) in
  let second/0 = classify(0) in
  let third/0 = classify(17) in
  let shape1/0 = triangle_type(1, 2, 3) in
  let shape2/0 = triangle_type(3, 2, 1) in
  let shape3/0 = triangle_type(2, 3, 2) in
  let mtmp0 = println__T_string(first/0) in
  let mtmp1 = println__T_string(second/0) in
  let mtmp2 = println__T_string(third/0) in
  let mtmp3 = println__T_string(shape1/0) in
  let mtmp4 = println__T_string(shape2/0) in
  let mtmp5 = println__T_string(shape3/0) in
  ()
}

fn println__T_string(value/0: string) -> () {
  @runtime(core.string_println)(trait_impl#ToString#string#to_string(value/0))
}

fn trait_impl#ToString#string#to_string(self/0: string) -> string {
  self/0
}