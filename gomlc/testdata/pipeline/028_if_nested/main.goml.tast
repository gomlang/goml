fn classify(x/0: i32) -> string {
    if (x/0 : i32) < 0 {
        {
            "negative"
        }
    } else {
        {
            if 0 < (x/0 : i32) {
                {
                    "positive"
                }
            } else {
                {
                    "zero"
                }
            }
        }
    }
}

fn triangle_type(a/1: i32, b/2: i32, c/3: i32) -> string {
    if (a/1 : i32) < (b/2 : i32) {
        {
            if (b/2 : i32) < (c/3 : i32) {
                {
                    "ascending"
                }
            } else {
                {
                    "peak"
                }
            }
        }
    } else {
        {
            if (a/1 : i32) < (c/3 : i32) {
                {
                    "valley"
                }
            } else {
                {
                    "flat"
                }
            }
        }
    }
}

fn main() -> () {
    let first/4: string = (classify : (i32) -> string)(-42);
    let second/5: string = (classify : (i32) -> string)(0);
    let third/6: string = (classify : (i32) -> string)(17);
    let shape1/7: string = (triangle_type : (i32, i32, i32) -> string)(1, 2, 3);
    let shape2/8: string = (triangle_type : (i32, i32, i32) -> string)(3, 2, 1);
    let shape3/9: string = (triangle_type : (i32, i32, i32) -> string)(2, 3, 2);
    let _ : () = (println : (string) -> ())((first/4 : string));
    let _ : () = (println : (string) -> ())((second/5 : string));
    let _ : () = (println : (string) -> ())((third/6 : string));
    let _ : () = (println : (string) -> ())((shape1/7 : string));
    let _ : () = (println : (string) -> ())((shape2/8 : string));
    let _ : () = (println : (string) -> ())((shape3/9 : string));
}