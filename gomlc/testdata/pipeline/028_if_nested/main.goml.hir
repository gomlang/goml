  fn classify(local/1/0: i32) -> string {
      if x/0 < 0 {
          "negative"
      } else {
          if 0 < x/0 {
              "positive"
          } else {
              "zero"
          }
      }
  }

  fn triangle_type(local/1/1: i32, local/1/2: i32, local/1/3: i32) -> string {
      if a/1 < b/2 {
          if b/2 < c/3 {
              "ascending"
          } else {
              "peak"
          }
      } else {
          if a/1 < c/3 {
              "valley"
          } else {
              "flat"
          }
      }
  }

