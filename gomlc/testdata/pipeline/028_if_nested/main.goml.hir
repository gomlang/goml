  fn classify(local/main/0: i32) -> string {
      if x/0 < 0 {
          "negative"
      } else {
          if 0 < x/0 {
              "positive"
          } else {
              "zero"
          }
      }
  }

  fn triangle_type(local/main/1: i32, local/main/2: i32, local/main/3: i32) -> string {
      if a/1 < b/2 {
          if b/2 < c/3 {
              "ascending"
          } else {
              "peak"
          }
      } else {
          if a/1 < c/3 {
              "valley"
          } else {
              "flat"
          }
      }
  }

