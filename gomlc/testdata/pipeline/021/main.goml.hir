package main
file main.goml
  fn match_int(local/1/0: i32) -> i32 {
      match n/0 {
          0 => 10,
          1 => 20,
          _ => 30,
      }
  }

  fn wildcard_first(local/1/1: i32) -> i32 {
      match n/1 {
          _ => 40,
          0 => 50,
      }
  }

  fn wildcard_middle(local/1/2: i32) -> i32 {
      match n/2 {
          2 => 90,
          _ => 100,
          3 => 110,
      }
  }

  fn repeated(local/1/3: i32) -> i32 {
      match n/3 {
          1 => 60,
          1 => 70,
          _ => 80,
      }
  }

  fn main() {
      let _ = println(def/1/0(0).to_string());
      let _ = println(def/1/0(5).to_string());
      let _ = println(def/1/1(0).to_string());
      let _ = println(def/1/1(2).to_string());
      let _ = println(def/1/2(2).to_string());
      let _ = println(def/1/2(3).to_string());
      let _ = println(def/1/3(1).to_string());
      println(def/1/3(3).to_string())
  }