fn match_int(n: i32) -> i32 {
    match n {
        0 => 10,
        1 => 20,
        _ => 30,
    }
}

fn wildcard_first(n: i32) -> i32 {
    match n {
        _ => 40,
        0 => 50,
    }
}

fn wildcard_middle(n: i32) -> i32 {
    match n {
        2 => 90,
        _ => 100,
        3 => 110,
    }
}

fn repeated(n: i32) -> i32 {
    match n {
        1 => 60,
        1 => 70,
        _ => 80,
    }
}

fn main() {
    let _ = println(match_int(0).to_string());
    let _ = println(match_int(5).to_string());
    let _ = println(wildcard_first(0).to_string());
    let _ = println(wildcard_first(2).to_string());
    let _ = println(wildcard_middle(2).to_string());
    let _ = println(wildcard_middle(3).to_string());
    let _ = println(repeated(1).to_string());
    println(repeated(3).to_string())
}
