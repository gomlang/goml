fn match_int(n/0: i32) -> i32 {
    match (n/0 : i32) {
        0 => 10,
        1 => 20,
        _ : i32 => 30,
    }
}

fn wildcard_first(n/1: i32) -> i32 {
    match (n/1 : i32) {
        _ : i32 => 40,
        0 => 50,
    }
}

fn wildcard_middle(n/2: i32) -> i32 {
    match (n/2 : i32) {
        2 => 90,
        _ : i32 => 100,
        3 => 110,
    }
}

fn repeated(n/3: i32) -> i32 {
    match (n/3 : i32) {
        1 => 60,
        1 => 70,
        _ : i32 => 80,
    }
}

fn main() -> () {
    let _ : () =
      (println : (string) -> ())((i32::to_string : (i32) -> string)((match_int : (i32) -> i32)(0)));
    let _ : () =
      (println : (string) -> ())((i32::to_string : (i32) -> string)((match_int : (i32) -> i32)(5)));
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)((wildcard_first : (i32) -> i32)(0))
      );
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)((wildcard_first : (i32) -> i32)(2))
      );
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)((wildcard_middle : (i32) -> i32)(2))
      );
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)((wildcard_middle : (i32) -> i32)(3))
      );
    let _ : () =
      (println : (string) -> ())((i32::to_string : (i32) -> string)((repeated : (i32) -> i32)(1)));
    (println : (string) -> ())((i32::to_string : (i32) -> string)((repeated : (i32) -> i32)(3)))
}