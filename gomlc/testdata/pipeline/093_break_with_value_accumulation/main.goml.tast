fn main() -> () {
    let sum/0: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    let i/1: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    while (Ref[isize]::get : (Ref[isize]) -> isize)((i/1 : Ref[isize])) < 20 {
        {
            (Ref[isize]::set : (Ref[isize], isize) -> ())(
              (i/1 : Ref[isize]),
              (Ref[isize]::get : (Ref[isize]) -> isize)((i/1 : Ref[isize])) + 1
            );
            if (Ref[isize]::get : (Ref[isize]) -> isize)((i/1 : Ref[isize])) > 5 {
                {
                    break
                }
            } else {
                {}
            };
            (Ref[isize]::set : (Ref[isize], isize) -> ())(
              (sum/0 : Ref[isize]),
              (Ref[isize]::get : (Ref[isize]) -> isize)((sum/0 : Ref[isize])) +
                (Ref[isize]::get : (Ref[isize]) -> isize)((i/1 : Ref[isize]))
            );
        }
    };
    let _ : () = (print : (string) -> ())("sum: ");
    let _ : () =
      (println : (isize) -> ())((Ref[isize]::get : (Ref[isize]) -> isize)((sum/0 : Ref[isize])));
    let _ : () = (print : (string) -> ())("i at break: ");
    let _ : () =
      (println : (isize) -> ())((Ref[isize]::get : (Ref[isize]) -> isize)((i/1 : Ref[isize])));
}