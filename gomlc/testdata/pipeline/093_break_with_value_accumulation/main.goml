fn main() {
    let sum = Ref::new(0);
    let i = Ref::new(0);
    while i.get() < 20 {
        i.set(i.get() + 1);
        if i.get() > 5 {
            break
        } else {};
        sum.set(sum.get() + i.get());
    }
    let _ = print("sum: ");
    let _ = println(sum.get());
    let _ = print("i at break: ");
    let _ = println(i.get());
}
