fn choose(flag: bool) -> i32 {
    let value = if flag {
        return 10
    } else {
        20
    };
    value + 1
}

fn continue_branch() -> () {
    let count = Ref::new(0);
    while count.get() < 2 {
        count.set(count.get() + 1);
        let value = if count.get() == 1 {
            continue
        } else {
            7
        };
        println(value)
    }
}

fn break_branch(stop: bool) -> () {
    while true {
        let value = if stop {
            break
        } else {
            9
        };
        println(value);
        break
    }
}

fn main() -> () {
    println(choose(false));
    println(choose(true));
    continue_branch();
    break_branch(false);
    break_branch(true)
}
