package main;
fn main() {
    let a = 10;
    let f1 =
      |x: i32| {
          let b = 20;
          let f2 =
            |y: i32| {
                let c = 30;
                let f3 =
                  |z: i32| {
                      let d = 40;
                      let f4 =
                        |w: i32| {
                            a + b + c + d + x + y + z + w
                        };
                      f4(4)
                  };
                f3(3)
            };
          f2(2)
      };
    let result = f1(1);
    println(result)
}

