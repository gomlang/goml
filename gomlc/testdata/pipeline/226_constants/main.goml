const BASE: isize = 0x10;

const ANSWER: isize = BASE * 2 + 10;

const MASK: byte = b'\xF0';

const GREETING: string = "constant" + " value";

const ENABLED: bool = true;

fn main() -> () {
    println(ANSWER.to_string());
    println(MASK.to_string());
    println(GREETING);
    println(ENABLED.to_string())
}
