use std::cmp;

#[derive(PartialEq, PartialOrd)]
struct FloatKey {
    value: f64,
}

struct CollisionKey {
    value: i32,
}

impl PartialEq for CollisionKey {
    fn eq(self: CollisionKey, other: CollisionKey) -> bool {
        self.value == other.value
    }
}

impl Eq for CollisionKey {}

impl Hash for CollisionKey {
    fn hash(self: CollisionKey) -> u64 {
        1
    }
}

fn print_opt_string(value: Option[string]) -> () {
    match value {
        Option::Some(text) => println(text),
        Option::None => println("none"),
    }
}

fn print_opt_int(value: Option[i32]) -> () {
    match value {
        Option::Some(number) => println(number),
        Option::None => println("none"),
    }
}

fn float_comparison_contracts() -> () {
    let zero32: f32 = 0.0;
    let negative_zero32 = -zero32;
    println((zero32 == negative_zero32).to_string());
    let zero64: f64 = 0.0;
    let negative_zero64 = -zero64;
    println((zero64 == negative_zero64).to_string());
    println((FloatKey { value: zero64 } == FloatKey { value: negative_zero64 }).to_string());
    let nan = zero64 / zero64;
    println((nan == nan).to_string());
    println(cmp::PartialOrd::partial_cmp(nan, nan).is_none().to_string());
}

fn collision_contracts() -> () {
    let values: HashMap[CollisionKey, i32] = HashMap::new();
    values.set(CollisionKey { value: 1 }, 10);
    values.set(CollisionKey { value: 2 }, 20);
    values.set(CollisionKey { value: 3 }, 30);
    values.remove(CollisionKey { value: 2 });
    print_opt_int(values.get(CollisionKey { value: 1 }));
    print_opt_int(values.get(CollisionKey { value: 2 }));
    print_opt_int(values.get(CollisionKey { value: 3 }));
    values.set(CollisionKey { value: 4 }, 40);
    println(values.len());
    print_opt_int(values.get(CollisionKey { value: 4 }));
    values.set(CollisionKey { value: 4 }, 41);
    println(values.len());
    print_opt_int(values.get(CollisionKey { value: 4 }));
    values.remove(CollisionKey { value: 99 });
    values.remove(CollisionKey { value: 99 });
    println(values.len());
    let index = Ref::new(0);
    while index.get() < 2000 {
        let key = CollisionKey { value: 1000 + index.get() };
        values.set(key, index.get());
        values.remove(key);
        index.set(index.get() + 1);
    }
    println(values.len());
}

fn reference_contracts() -> () {
    let values: HashMap[Ref[CollisionKey], string] = HashMap::new();
    let key = Ref::new(CollisionKey { value: 1 });
    let alias = key;
    let equal_value = Ref::new(CollisionKey { value: 1 });
    values.set(key, "identity");
    println(PartialEq::eq(key, alias));
    println(PartialEq::eq(key, equal_value));
    println(Hash::hash(key) == Hash::hash(alias));
    print_opt_string(values.get(alias));
    print_opt_string(values.get(equal_value));
    key.set(CollisionKey { value: 99 });
    print_opt_string(values.get(key));
}

fn main() -> () {
    float_comparison_contracts();
    collision_contracts();
    reference_contracts();
}
