impl PartialEq for FloatKey {
  fn eq(self/0: FloatKey, other/1: FloatKey) -> bool {
      true &&
        (PartialEq::eq : (f64, f64) -> bool)((self/0 : FloatKey).value, (other/1 : FloatKey).value)
  }
}

impl std::cmp::PartialOrd for FloatKey {
  fn partial_cmp(self/2: FloatKey, other/3: FloatKey) -> Option[Ordering] {
      match (std::cmp::PartialOrd::partial_cmp : (f64, f64) -> Option[Ordering])(
        (self/2 : FloatKey).value,
        (other/3 : FloatKey).value
      ) {
          Option::None => Option::None,
          Option::Some(Ordering::Equal) => Option::Some(Ordering::Equal),
          Option::Some(#derive0_ordering/4: Ordering) =>
            Option::Some((#derive0_ordering/4 : Ordering)),
      }
  }
  fn lt(default_arg0: FloatKey, default_arg1: FloatKey) -> bool {
      (std::cmp::trait_default#PartialOrd#lt : (FloatKey, FloatKey) -> bool)(
        (default_arg0 : FloatKey),
        (default_arg1 : FloatKey)
      )
  }
  fn le(default_arg0: FloatKey, default_arg1: FloatKey) -> bool {
      (std::cmp::trait_default#PartialOrd#le : (FloatKey, FloatKey) -> bool)(
        (default_arg0 : FloatKey),
        (default_arg1 : FloatKey)
      )
  }
  fn gt(default_arg0: FloatKey, default_arg1: FloatKey) -> bool {
      (std::cmp::trait_default#PartialOrd#gt : (FloatKey, FloatKey) -> bool)(
        (default_arg0 : FloatKey),
        (default_arg1 : FloatKey)
      )
  }
  fn ge(default_arg0: FloatKey, default_arg1: FloatKey) -> bool {
      (std::cmp::trait_default#PartialOrd#ge : (FloatKey, FloatKey) -> bool)(
        (default_arg0 : FloatKey),
        (default_arg1 : FloatKey)
      )
  }
}

impl PartialEq for CollisionKey {
  fn eq(self/5: CollisionKey, other/6: CollisionKey) -> bool {
      (self/5 : CollisionKey).value == (other/6 : CollisionKey).value
  }
}

impl Eq for CollisionKey {}

impl Hash for CollisionKey {
  fn hash(self/7: CollisionKey) -> u64 {
      1
  }
}

fn print_opt_string(value/8: Option[string]) -> () {
    match (value/8 : Option[string]) {
        Option::Some(text/9: string) => (println : (string) -> ())((text/9 : string)),
        Option::None => (println : (string) -> ())("none"),
    }
}

fn print_opt_int(value/10: Option[i32]) -> () {
    match (value/10 : Option[i32]) {
        Option::Some(number/11: i32) => (println : (i32) -> ())((number/11 : i32)),
        Option::None => (println : (string) -> ())("none"),
    }
}

fn float_comparison_contracts() -> () {
    let zero32/12: f32 = 0;
    let negative_zero32/13: f32 = -(zero32/12 : f32);
    (println : (string) -> ())(
      (ToString::to_string : (bool) -> string)((zero32/12 : f32) == (negative_zero32/13 : f32))
    );
    let zero64/14: f64 = 0;
    let negative_zero64/15: f64 = -(zero64/14 : f64);
    (println : (string) -> ())(
      (ToString::to_string : (bool) -> string)((zero64/14 : f64) == (negative_zero64/15 : f64))
    );
    (println : (string) -> ())(
      (ToString::to_string : (bool) -> string)(
        FloatKey { value: (zero64/14 : f64) } == FloatKey { value: (negative_zero64/15 : f64) }
      )
    );
    let nan/16: f64 = (zero64/14 : f64) / (zero64/14 : f64);
    (println : (string) -> ())(
      (ToString::to_string : (bool) -> string)((nan/16 : f64) == (nan/16 : f64))
    );
    (println : (string) -> ())(
      (ToString::to_string : (bool) -> string)(
        (Option[Ordering]::is_none : (Option[Ordering]) -> bool)(
          (std::cmp::PartialOrd::partial_cmp : (f64, f64) -> Option[Ordering])(
            (nan/16 : f64),
            (nan/16 : f64)
          )
        )
      )
    );
}

fn collision_contracts() -> () {
    let values/17: HashMap[CollisionKey, i32] =
      (HashMap[CollisionKey, i32]::new : () -> HashMap[CollisionKey, i32])();
    (HashMap[CollisionKey, i32]::set : (HashMap[CollisionKey, i32], CollisionKey, i32) -> ())(
      (values/17 : HashMap[CollisionKey, i32]),
      CollisionKey { value: 1 },
      10
    );
    (HashMap[CollisionKey, i32]::set : (HashMap[CollisionKey, i32], CollisionKey, i32) -> ())(
      (values/17 : HashMap[CollisionKey, i32]),
      CollisionKey { value: 2 },
      20
    );
    (HashMap[CollisionKey, i32]::set : (HashMap[CollisionKey, i32], CollisionKey, i32) -> ())(
      (values/17 : HashMap[CollisionKey, i32]),
      CollisionKey { value: 3 },
      30
    );
    (HashMap[CollisionKey, i32]::remove : (HashMap[CollisionKey, i32], CollisionKey) -> ())(
      (values/17 : HashMap[CollisionKey, i32]),
      CollisionKey { value: 2 }
    );
    (print_opt_int : (Option[i32]) -> ())(
      (HashMap[CollisionKey, i32]::get : (HashMap[CollisionKey, i32], CollisionKey) -> Option[i32])(
        (values/17 : HashMap[CollisionKey, i32]),
        CollisionKey { value: 1 }
      )
    );
    (print_opt_int : (Option[i32]) -> ())(
      (HashMap[CollisionKey, i32]::get : (HashMap[CollisionKey, i32], CollisionKey) -> Option[i32])(
        (values/17 : HashMap[CollisionKey, i32]),
        CollisionKey { value: 2 }
      )
    );
    (print_opt_int : (Option[i32]) -> ())(
      (HashMap[CollisionKey, i32]::get : (HashMap[CollisionKey, i32], CollisionKey) -> Option[i32])(
        (values/17 : HashMap[CollisionKey, i32]),
        CollisionKey { value: 3 }
      )
    );
    (HashMap[CollisionKey, i32]::set : (HashMap[CollisionKey, i32], CollisionKey, i32) -> ())(
      (values/17 : HashMap[CollisionKey, i32]),
      CollisionKey { value: 4 },
      40
    );
    (println : (isize) -> ())(
      (HashMap[CollisionKey, i32]::len : (HashMap[CollisionKey, i32]) -> isize)(
        (values/17 : HashMap[CollisionKey, i32])
      )
    );
    (print_opt_int : (Option[i32]) -> ())(
      (HashMap[CollisionKey, i32]::get : (HashMap[CollisionKey, i32], CollisionKey) -> Option[i32])(
        (values/17 : HashMap[CollisionKey, i32]),
        CollisionKey { value: 4 }
      )
    );
    (HashMap[CollisionKey, i32]::set : (HashMap[CollisionKey, i32], CollisionKey, i32) -> ())(
      (values/17 : HashMap[CollisionKey, i32]),
      CollisionKey { value: 4 },
      41
    );
    (println : (isize) -> ())(
      (HashMap[CollisionKey, i32]::len : (HashMap[CollisionKey, i32]) -> isize)(
        (values/17 : HashMap[CollisionKey, i32])
      )
    );
    (print_opt_int : (Option[i32]) -> ())(
      (HashMap[CollisionKey, i32]::get : (HashMap[CollisionKey, i32], CollisionKey) -> Option[i32])(
        (values/17 : HashMap[CollisionKey, i32]),
        CollisionKey { value: 4 }
      )
    );
    (HashMap[CollisionKey, i32]::remove : (HashMap[CollisionKey, i32], CollisionKey) -> ())(
      (values/17 : HashMap[CollisionKey, i32]),
      CollisionKey { value: 99 }
    );
    (HashMap[CollisionKey, i32]::remove : (HashMap[CollisionKey, i32], CollisionKey) -> ())(
      (values/17 : HashMap[CollisionKey, i32]),
      CollisionKey { value: 99 }
    );
    (println : (isize) -> ())(
      (HashMap[CollisionKey, i32]::len : (HashMap[CollisionKey, i32]) -> isize)(
        (values/17 : HashMap[CollisionKey, i32])
      )
    );
    let index/18: Ref[i32] = (Ref[i32]::new : (i32) -> Ref[i32])(0);
    while (Ref[i32]::get : (Ref[i32]) -> i32)((index/18 : Ref[i32])) < 2000 {
        {
            let key/19: CollisionKey =
              CollisionKey {
                value: 1000 + (Ref[i32]::get : (Ref[i32]) -> i32)((index/18 : Ref[i32]))
              };
            (HashMap[CollisionKey, i32]::set : (
              HashMap[CollisionKey, i32],
              CollisionKey,
              i32
            ) -> ())(
              (values/17 : HashMap[CollisionKey, i32]),
              (key/19 : CollisionKey),
              (Ref[i32]::get : (Ref[i32]) -> i32)((index/18 : Ref[i32]))
            );
            (HashMap[CollisionKey, i32]::remove : (HashMap[CollisionKey, i32], CollisionKey) -> ())(
              (values/17 : HashMap[CollisionKey, i32]),
              (key/19 : CollisionKey)
            );
            (Ref[i32]::set : (Ref[i32], i32) -> ())(
              (index/18 : Ref[i32]),
              (Ref[i32]::get : (Ref[i32]) -> i32)((index/18 : Ref[i32])) + 1
            );
        }
    };
    (println : (isize) -> ())(
      (HashMap[CollisionKey, i32]::len : (HashMap[CollisionKey, i32]) -> isize)(
        (values/17 : HashMap[CollisionKey, i32])
      )
    );
}

fn reference_contracts() -> () {
    let values/20: HashMap[Ref[CollisionKey], string] =
      (HashMap[Ref[CollisionKey], string]::new : () -> HashMap[Ref[CollisionKey], string])();
    let key/21: Ref[CollisionKey] =
      (Ref[CollisionKey]::new : (CollisionKey) -> Ref[CollisionKey])(CollisionKey { value: 1 });
    let alias/22: Ref[CollisionKey] = (key/21 : Ref[CollisionKey]);
    let equal_value/23: Ref[CollisionKey] =
      (Ref[CollisionKey]::new : (CollisionKey) -> Ref[CollisionKey])(CollisionKey { value: 1 });
    (HashMap[Ref[CollisionKey], string]::set : (
      HashMap[Ref[CollisionKey], string],
      Ref[CollisionKey],
      string
    ) -> ())(
      (values/20 : HashMap[Ref[CollisionKey], string]),
      (key/21 : Ref[CollisionKey]),
      "identity"
    );
    (println : (bool) -> ())(
      (PartialEq::eq : (Ref[CollisionKey], Ref[CollisionKey]) -> bool)(
        (key/21 : Ref[CollisionKey]),
        (alias/22 : Ref[CollisionKey])
      )
    );
    (println : (bool) -> ())(
      (PartialEq::eq : (Ref[CollisionKey], Ref[CollisionKey]) -> bool)(
        (key/21 : Ref[CollisionKey]),
        (equal_value/23 : Ref[CollisionKey])
      )
    );
    (println : (bool) -> ())(
      (Hash::hash : (Ref[CollisionKey]) -> u64)((key/21 : Ref[CollisionKey])) ==
        (Hash::hash : (Ref[CollisionKey]) -> u64)((alias/22 : Ref[CollisionKey]))
    );
    (print_opt_string : (Option[string]) -> ())(
      (HashMap[Ref[CollisionKey], string]::get : (
        HashMap[Ref[CollisionKey], string],
        Ref[CollisionKey]
      ) -> Option[string])(
        (values/20 : HashMap[Ref[CollisionKey], string]),
        (alias/22 : Ref[CollisionKey])
      )
    );
    (print_opt_string : (Option[string]) -> ())(
      (HashMap[Ref[CollisionKey], string]::get : (
        HashMap[Ref[CollisionKey], string],
        Ref[CollisionKey]
      ) -> Option[string])(
        (values/20 : HashMap[Ref[CollisionKey], string]),
        (equal_value/23 : Ref[CollisionKey])
      )
    );
    (Ref[CollisionKey]::set : (Ref[CollisionKey], CollisionKey) -> ())(
      (key/21 : Ref[CollisionKey]),
      CollisionKey { value: 99 }
    );
    (print_opt_string : (Option[string]) -> ())(
      (HashMap[Ref[CollisionKey], string]::get : (
        HashMap[Ref[CollisionKey], string],
        Ref[CollisionKey]
      ) -> Option[string])(
        (values/20 : HashMap[Ref[CollisionKey], string]),
        (key/21 : Ref[CollisionKey])
      )
    );
}

fn main() -> () {
    (float_comparison_contracts : () -> ())();
    (collision_contracts : () -> ())();
    (reference_contracts : () -> ())();
}