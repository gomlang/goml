#[derive(Hash, PartialEq, Eq)]
struct Point {
    x: i32,
    y: i32,
}

#[derive(Hash, PartialEq, Eq)]
enum Key {
    A,
    B(i32),
    P(Point),
}

fn print_opt_int(x: Option[i32]) -> () {
    match x {
        Option::Some(v) => println(v),
        Option::None => println("none"),
    }
}

fn main() -> () {
    let m1 = HashMap::new();
    m1.set(Key::A, 10);
    m1.set(Key::B(1), 20);
    println(m1.len());
    print_opt_int(m1.get(Key::A));
    println(m1.contains(Key::B(1)));
    m1.remove(Key::B(1));
    println(m1.contains(Key::B(1)));
    println(m1.len());
    let m2 = HashMap::new();
    let p1 = Ref::new(Point { x: 1, y: 2 });
    let p2 = Ref::new(Point { x: 1, y: 2 });
    m2.set(p1, 99);
    print_opt_int(m2.get(p1));
    print_opt_int(m2.get(p2));
    p1.set(Point { x: 9, y: 8 });
    print_opt_int(m2.get(p1));
    println(PartialEq::eq(p1, p2));
    let m3 = HashMap::new();
    let k1 = Ref::new(Key::B(7));
    let k2 = k1;
    m3.set(k1, 123);
    print_opt_int(m3.get(k2));
}
