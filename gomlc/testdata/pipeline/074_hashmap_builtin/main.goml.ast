package main;
#[derive(Hash, PartialEq, Eq)]
struct Point {
    x: i32,
    y: i32,
}

impl Hash for Point {
  fn hash(self: Point) -> u64 {
      {
          let h = 0.to_u64() + 14695981039346656037;
          let h = h * 0.to_u64() + 1099511628211 + Hash::hash(self.x);
          let h = h * 0.to_u64() + 1099511628211 + Hash::hash(self.y);
          h
      }
  }
}

impl PartialEq for Point {
  fn eq(self: Point, other: Point) -> bool {
      true && PartialEq::eq(self.x, other.x) && PartialEq::eq(self.y, other.y)
  }
}

impl Eq for Point where i32: Eq {}

#[derive(Hash, PartialEq, Eq)]
enum Key {
    A,
    B(i32),
    P(Point)
}

impl Hash for Key {
  fn hash(self: Key) -> u64 {
      match self {
          Key::A =>
            {
                let h = 0.to_u64() + 14695981039346656037 + 1;
                h
            },
          Key::B(#derive0_field) =>
            {
                let h = 0.to_u64() + 14695981039346656037 + 2;
                let h = h * 0.to_u64() + 1099511628211 + Hash::hash(#derive0_field);
                h
            },
          Key::P(#derive1_field) =>
            {
                let h = 0.to_u64() + 14695981039346656037 + 3;
                let h = h * 0.to_u64() + 1099511628211 + Hash::hash(#derive1_field);
                h
            },
      }
  }
}

impl PartialEq for Key {
  fn eq(self: Key, other: Key) -> bool {
      match (self, other) {
          (Key::A, Key::A) => true,
          (Key::B(#derive0_left), Key::B(#derive1_right)) =>
            true && PartialEq::eq(#derive0_left, #derive1_right),
          (Key::P(#derive2_left), Key::P(#derive3_right)) =>
            true && PartialEq::eq(#derive2_left, #derive3_right),
          _ => false,
      }
  }
}

impl Eq for Key where i32: Eq, Point: Eq {}

fn print_opt_int(x: Option[i32]) -> () {
    match x {
        Option::Some(v) => println(v),
        Option::None => println("none"),
    }
}

fn main() -> () {
    let m1 = HashMap::new();
    m1.set(Key::A, 10);
    m1.set(Key::B(1), 20);
    println(m1.len());
    print_opt_int(m1.get(Key::A));
    println(m1.contains(Key::B(1)));
    m1.remove(Key::B(1));
    println(m1.contains(Key::B(1)));
    println(m1.len());
    let m2 = HashMap::new();
    let p1 = Ref::new(Point { x: 1, y: 2 });
    let p2 = Ref::new(Point { x: 1, y: 2 });
    m2.set(p1, 99);
    print_opt_int(m2.get(p1));
    print_opt_int(m2.get(p2));
    p1.set(Point { x: 9, y: 8 });
    print_opt_int(m2.get(p1));
    println(PartialEq::eq(p1, p2));
    let m3 = HashMap::new();
    let k1 = Ref::new(Key::B(7));
    let k2 = k1;
    m3.set(k1, 123);
    print_opt_int(m3.get(k2));
}

