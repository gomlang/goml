      )
    );
    (print_opt_int : (Option[i32]) -> ())(
      (HashMap[Ref[Point], i32]::get : (HashMap[Ref[Point], i32], Ref[Point]) -> Option[i32])(
        (m2/23 : HashMap[Ref[Point], i32]),
        (p2/25 : Ref[Point])
      )
    );
    (Ref[Point]::set : (Ref[Point], Point) -> ())((p1/24 : Ref[Point]), Point { x: 9, y: 8 });
    (print_opt_int : (Option[i32]) -> ())(
      (HashMap[Ref[Point], i32]::get : (HashMap[Ref[Point], i32], Ref[Point]) -> Option[i32])(
        (m2/23 : HashMap[Ref[Point], i32]),
        (p1/24 : Ref[Point])
      )
    );
    (println : (bool) -> ())(
      (PartialEq::eq : (Ref[Point], Ref[Point]) -> bool)((p1/24 : Ref[Point]), (p2/25 : Ref[Point]))
    );
    let m3/26: HashMap[Ref[Key], i32] =
      (HashMap[Ref[Key], i32]::new : () -> HashMap[Ref[Key], i32])();
    let k1/27: Ref[Key] = (Ref[Key]::new : (Key) -> Ref[Key])(Key::B(7));
    let k2/28: Ref[Key] = (k1/27 : Ref[Key]);
    (HashMap[Ref[Key], i32]::set : (HashMap[Ref[Key], i32], Ref[Key], i32) -> ())(
      (m3/26 : HashMap[Ref[Key], i32]),
      (k1/27 : Ref[Key]),
      123
    );
    (print_opt_int : (Option[i32]) -> ())(
      (HashMap[Ref[Key], i32]::get : (HashMap[Ref[Key], i32], Ref[Key]) -> Option[i32])(
        (m3/26 : HashMap[Ref[Key], i32]),
        (k2/28 : Ref[Key])
      )
