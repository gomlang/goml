fn parse(flag/0: bool) -> Result[i32, string] {
    if (flag/0 : bool) {
        {
            Result::Ok(5)
        }
    } else {
        {
            Result::Err("bad-branch")
        }
    }
}

fn bump(flag/1: bool, fallback/2: bool) -> Result[i32, string] {
    let value/3: i32 =
      if (flag/1 : bool) {
          {
              match (parse : (bool) -> Result[i32, string])((fallback/2 : bool)) {
                  Result::Ok(try_value/13: i32) => (try_value/13 : i32),
                  Result::Err(try_residual/13: string) =>
                    return Result::Err((try_residual/13 : string)),
              }
          }
      } else {
          {
              10
          }
      };
    Result::Ok((value/3 : i32) + 1)
}

fn show(res/4: Result[i32, string]) -> string {
    match (res/4 : Result[i32, string]) {
        Result::Ok(value/5: i32) => "ok=" + (i32::to_string : (i32) -> string)((value/5 : i32)),
        Result::Err(err/6: string) => "err=" + (err/6 : string),
    }
}

fn main() -> () {
    (println : (string) -> ())(
      (show : (Result[i32, string]) -> string)(
        (bump : (bool, bool) -> Result[i32, string])(true, true)
      )
    );
    (println : (string) -> ())(
      (show : (Result[i32, string]) -> string)(
        (bump : (bool, bool) -> Result[i32, string])(true, false)
      )
    );
    (println : (string) -> ())(
      (show : (Result[i32, string]) -> string)(
        (bump : (bool, bool) -> Result[i32, string])(false, false)
      )
    );
}