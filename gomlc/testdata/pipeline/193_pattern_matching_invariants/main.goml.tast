fn absurd(value/0: Never) -> i32 {
    match (value/0 : Never) {}
}

fn absurd_loop(value/1: Loop) -> i32 {
    match (value/1 : Loop) {}
}

fn maybe_never(value/2: MaybeNever) -> i32 {
    match (value/2 : MaybeNever) {
        MaybeNever::Empty => 0,
    }
}

fn empty_never_vec(value/3: Vec[Never]) -> i32 {
    match (value/3 : Vec[Never]) {
        [] => 0,
    }
}

fn sequence_coverage(value/4: Vec[bool]) -> i32 {
    match (value/4 : Vec[bool]) {
        [] => 0,
        [_ : bool] => 1,
        [true, .., _ : bool] => 2,
        [false, .., _ : bool] => 3,
    }
}

fn unwrap(value/5: Single) -> i32 {
    let Single::Only(inner/6: i32) = (value/5 : Single);
    (inner/6 : i32)
}

fn decide(flag/7: bool) -> i32 {
    match (flag/7 : bool) {
        true => return 1,
        false => return 2,
    }
}

fn signed_zero(value/8: f64) -> string {
    match (value/8 : f64) {
        -0 => "zero",
        _ : f64 => "other",
    }
}

fn main() -> () {
    let (single/9: Single) = (Single::Only(12));
    (println : (i32) -> ())((unwrap : (Single) -> i32)((single/9 : Single)));
    (println : (i32) -> ())((decide : (bool) -> i32)(true));
    (println : (string) -> ())((signed_zero : (f64) -> string)(0));
}