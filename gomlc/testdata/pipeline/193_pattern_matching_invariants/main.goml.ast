package main;
enum Never {}

enum Loop {
    Next(Loop)
}

enum MaybeNever {
    Empty,
    Filled(Never)
}

enum Single {
    Only(i32)
}

fn absurd(value: Never) -> i32 {
    match value {}
}

fn absurd_loop(value: Loop) -> i32 {
    match value {}
}

fn maybe_never(value: MaybeNever) -> i32 {
    match value {
        MaybeNever::Empty => 0,
    }
}

fn empty_never_vec(value: Vec[Never]) -> i32 {
    match value {
        [] => 0,
    }
}

fn sequence_coverage(value: Vec[bool]) -> i32 {
    match value {
        [] => 0,
        [_] => 1,
        [true, .., _] => 2,
        [false, .., _] => 3,
    }
}

fn unwrap(value: Single) -> i32 {
    let Single::Only(inner) = value;
    inner
}

fn decide(flag: bool) -> i32 {
    match flag {
        true => return 1,
        false => return 2,
    }
}

fn signed_zero(value: f64) -> string {
    match value {
        -0.0 => "zero",
        _ => "other",
    }
}

fn main() -> () {
    let (single) = (Single::Only(12));
    println(unwrap(single));
    println(decide(true));
    println(signed_zero(0.0));
}

