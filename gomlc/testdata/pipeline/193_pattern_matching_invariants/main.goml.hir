package main
file main.goml
  enum Never {}

  enum Loop {
      Next(Loop)
  }

  enum MaybeNever {
      Empty,
      Filled(Never)
  }

  enum Single {
      Only(i32)
  }

  fn absurd(local/main/0: Never) -> i32 {
      match value/0 {}
  }

  fn absurd_loop(local/main/1: Loop) -> i32 {
      match value/1 {}
  }

  fn maybe_never(local/main/2: MaybeNever) -> i32 {
      match value/2 {
          ctor(source:4:main:2::v0) => 0,
      }
  }

  fn empty_never_vec(local/main/3: Vec[Never]) -> i32 {
      match value/3 {
          [] => 0,
      }
  }

  fn sequence_coverage(local/main/4: Vec[bool]) -> i32 {
      match value/4 {
          [] => 0,
          [_] => 1,
          [true, .., _] => 2,
          [false, .., _] => 3,
      }
  }

  fn unwrap(local/main/5: Single) -> i32 {
      let ctor(source:4:main:3::v0)(local/main/6) = value/5;
      inner/6
  }

  fn decide(local/main/7: bool) -> i32 {
      match flag/7 {
          true => return 1,
          false => return 2,
      }
  }

  fn signed_zero(local/main/8: f64) -> string {
      match value/8 {
          -0.0 => "zero",
          _ => "other",
      }
  }

  fn main() -> () {
      let (local/main/9) = (ctor(source:4:main:3::v0)(12));
      println(source:4:main:9(single/9));
      println(source:4:main:10(true));
      println(source:4:main:11(0.0));
  }