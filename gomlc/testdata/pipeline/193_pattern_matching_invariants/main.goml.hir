package main
file main.goml
  enum Never {}

  enum Loop {
      Next(Loop)
  }

  enum MaybeNever {
      Empty,
      Filled(Never)
  }

  enum Single {
      Only(i32)
  }

  fn absurd(local/1/0: Never) -> i32 {
      match value/0 {}
  }

  fn absurd_loop(local/1/1: Loop) -> i32 {
      match value/1 {}
  }

  fn maybe_never(local/1/2: MaybeNever) -> i32 {
      match value/2 {
          ctor(def/1/2::v0) => 0,
      }
  }

  fn empty_never_vec(local/1/3: Vec[Never]) -> i32 {
      match value/3 {
          [] => 0,
      }
  }

  fn sequence_coverage(local/1/4: Vec[bool]) -> i32 {
      match value/4 {
          [] => 0,
          [_] => 1,
          [true, .., _] => 2,
          [false, .., _] => 3,
      }
  }

  fn unwrap(local/1/5: Single) -> i32 {
      let ctor(def/1/3::v0)(local/1/6) = value/5;
      inner/6
  }

  fn decide(local/1/7: bool) -> i32 {
      match flag/7 {
          true => return 1,
          false => return 2,
      }
  }

  fn signed_zero(local/1/8: f64) -> string {
      match value/8 {
          -0.0 => "zero",
          _ => "other",
      }
  }

  fn main() -> () {
      let (local/1/9) = (ctor(def/1/3::v0)(12));
      println(def/1/9(single/9));
      println(def/1/10(true));
      println(def/1/11(0.0));
  }