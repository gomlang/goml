fn split_host_port(ok/0: bool) -> Result[(string, string), string] {
    if (ok/0 : bool) {
        {
            Result::Ok(("localhost", "8080"))
        }
    } else {
        {
            Result::Err("missing port")
        }
    }
}

fn pair(ok/1: bool) -> Result[(string, string), string] {
    (split_host_port : (bool) -> Result[(string, string), string])((ok/1 : bool))
}

fn render(ok/2: bool) -> Result[string, string] {
    let (host/3: string, port/4: string) =
      match (pair : (bool) -> Result[(string, string), string])((ok/2 : bool)) {
          Result::Ok(try_value/17: (string, string)) => (try_value/17 : (string, string)),
          Result::Err(try_residual/17: string) => return Result::Err((try_residual/17 : string)),
      };
