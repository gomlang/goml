package main;
enum First[T] {
    Shared(T),
    Idle,
    Data { value: T, label: string }
}

enum Second {
    Shared(isize)
}

enum Boxed[T] {
    Value(T)
}

type FirstInt = First[isize];

fn classify(value: FirstInt) -> string {
    match value {
        Shared(number) => "shared:" + number.to_string(),
        Idle => "idle",
        Data { value: value, label: label } => label + ":" + value.to_string(),
    }
}

fn nested(value: Option[Result[isize, string]]) -> string {
    match value {
        Some(Ok(number)) => "ok:" + number.to_string(),
        Some(Err(message)) => "err:" + message,
        None => "none",
    }
}

fn optional_number(value: Option[isize]) -> isize {
    match value {
        Some(number) =>
          {
              number
          },
        _ =>
          {
              0
          },
    }
}

fn is_non_shared(value: FirstInt) -> bool {
    match value {
        Idle | Data { .. } => true,
        Shared(_) => false,
    }
}

fn take_once(value: Option[isize]) -> isize {
    let current = Ref::new(value);
    let result = Ref::new(0);
    while true {
        match current.get() {
            Some(number) =>
              {
                  result.set(number);
                  current.set(Option::None);
              },
            _ => break,
        }
    };
    result.get()
}

fn unbox(value: Boxed[isize]) -> isize {
    let Value(number) = value;
    number
}

fn sum_boxed(values: Vec[Boxed[isize]]) -> isize {
    let result = Ref::new(0);
    for Value(number) in
      values {
        result.set(result.get() + number);
    };
    result.get()
}

fn main() -> () {
    let boxed: Vec[Boxed[isize]] = Vec::from_array([Boxed::Value(19), Boxed::Value(23)]);
    println(classify(First::Shared(7)));
    println(classify(First::Idle));
    println(classify(First::Data { value: 9, label: "data" }));
    println(nested(Option::Some(Result::Ok(11))));
    println(nested(Option::Some(Result::Err("bad"))));
    println(nested(Option::None));
    println(optional_number(Option::Some(13)));
    println(optional_number(Option::None));
    println(is_non_shared(First::Idle));
    println(is_non_shared(First::Shared(1)));
    println(take_once(Option::Some(15)));
    println(unbox(Boxed::Value(17)));
    println(sum_boxed(boxed))
}

