fn classify(value/0: First[isize]) -> string {
    match (value/0 : First[isize]) {
        First::Shared(number/1: isize) =>
          "shared:" + (isize::to_string : (isize) -> string)((number/1 : isize)),
        First::Idle => "idle",
        First::Data(value/2: isize, label/3: string) =>
          (label/3 : string) + ":" + (isize::to_string : (isize) -> string)((value/2 : isize)),
    }
}

fn nested(value/4: Option[Result[isize, string]]) -> string {
    match (value/4 : Option[Result[isize, string]]) {
        Option::Some(Result::Ok(number/5: isize)) =>
          "ok:" + (isize::to_string : (isize) -> string)((number/5 : isize)),
        Option::Some(Result::Err(message/6: string)) => "err:" + (message/6 : string),
        Option::None => "none",
    }
}

fn optional_number(value/7: Option[isize]) -> isize {
    match (value/7 : Option[isize]) {
        Option::Some(number/8: isize) =>
          {
              (number/8 : isize)
          },
        _ : Option[isize] =>
          {
              0
          },
    }
}

fn is_non_shared(value/9: First[isize]) -> bool {
    match (value/9 : First[isize]) {
        First::Idle | First::Data(_ : isize, _ : string) => true,
        First::Shared(_ : isize) => false,
    }
}

fn take_once(value/10: Option[isize]) -> isize {
    let current/11: Ref[Option[isize]] =
      (Ref[Option[isize]]::new : (Option[isize]) -> Ref[Option[isize]])((value/10 : Option[isize]));
    let result/12: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    while true {
        match (Ref[Option[isize]]::get : (Ref[Option[isize]]) -> Option[isize])(
          (current/11 : Ref[Option[isize]])
        ) {
            Option::Some(number/13: isize) =>
              {
                  (Ref[isize]::set : (Ref[isize], isize) -> ())(
                    (result/12 : Ref[isize]),
                    (number/13 : isize)
                  );
                  (Ref[Option[isize]]::set : (Ref[Option[isize]], Option[isize]) -> ())(
                    (current/11 : Ref[Option[isize]]),
                    Option::None
                  );
              },
            _ : Option[isize] => break,
        }
    };
    (Ref[isize]::get : (Ref[isize]) -> isize)((result/12 : Ref[isize]))
}

fn unbox(value/14: Boxed[isize]) -> isize {
    let Boxed::Value(number/15: isize) = (value/14 : Boxed[isize]);
    (number/15 : isize)
}

fn sum_boxed(values/16: Vec[Boxed[isize]]) -> isize {
    let result/17: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    for Boxed::Value(number/18: isize) in
      (values/16 : Vec[Boxed[isize]]) {
        (Ref[isize]::set : (Ref[isize], isize) -> ())(
          (result/17 : Ref[isize]),
          (Ref[isize]::get : (Ref[isize]) -> isize)((result/17 : Ref[isize])) + (number/18 : isize)
        );
    };
    (Ref[isize]::get : (Ref[isize]) -> isize)((result/17 : Ref[isize]))
}

fn main() -> () {
    let boxed/19: Vec[Boxed[isize]] =
      (@intrinsic(vec.from_array) : ([Boxed[isize]; 2]) -> Vec[Boxed[isize]])(
        [Boxed::Value(19), Boxed::Value(23)]
      );
    (println : (string) -> ())((classify : (First[isize]) -> string)(First::Shared(7)));
    (println : (string) -> ())((classify : (First[isize]) -> string)(First::Idle));
    (println : (string) -> ())((classify : (First[isize]) -> string)(First::Data(9, "data")));
    (println : (string) -> ())(
      (nested : (Option[Result[isize, string]]) -> string)(Option::Some(Result::Ok(11)))
    );
    (println : (string) -> ())(
      (nested : (Option[Result[isize, string]]) -> string)(Option::Some(Result::Err("bad")))
    );
    (println : (string) -> ())((nested : (Option[Result[isize, string]]) -> string)(Option::None));
    (println : (isize) -> ())((optional_number : (Option[isize]) -> isize)(Option::Some(13)));
    (println : (isize) -> ())((optional_number : (Option[isize]) -> isize)(Option::None));
    (println : (bool) -> ())((is_non_shared : (First[isize]) -> bool)(First::Idle));
    (println : (bool) -> ())((is_non_shared : (First[isize]) -> bool)(First::Shared(1)));
    (println : (isize) -> ())((take_once : (Option[isize]) -> isize)(Option::Some(15)));
    (println : (isize) -> ())((unbox : (Boxed[isize]) -> isize)(Boxed::Value(17)));
    (println : (isize) -> ())(
      (sum_boxed : (Vec[Boxed[isize]]) -> isize)((boxed/19 : Vec[Boxed[isize]]))
    )
}