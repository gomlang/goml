package main
file main.goml
  enum First[T] {
      Shared(T),
      Idle,
      Data { value: T, label: string }
  }

  enum Second {
      Shared(isize)
  }

  enum Boxed[T] {
      Value(T)
  }

  type FirstInt = First[isize];

  fn classify(local/main/0: FirstInt) -> string {
      match value/0 {
          Shared(local/main/1) => "shared:" + number/1.to_string(),
          Idle => "idle",
          Data { value: local/main/2, label: local/main/3 } => label/3 + ":" + value/2.to_string(),
      }
  }

  fn nested(local/main/4: Option[Result[isize, string]]) -> string {
      match value/4 {
          Some(Ok(local/main/5)) => "ok:" + number/5.to_string(),
          Some(Err(local/main/6)) => "err:" + message/6,
          None => "none",
      }
  }

  fn optional_number(local/main/7: Option[isize]) -> isize {
      match value/7 {
          Some(local/main/8) =>
            {
                number/8
            },
          _ =>
            {
                0
            },
      }
  }

  fn is_non_shared(local/main/9: FirstInt) -> bool {
      match value/9 {
          Idle | Data { .. } => true,
          Shared(_) => false,
      }
  }

  fn take_once(local/main/10: Option[isize]) -> isize {
      let local/main/11 = Ref::new(value/10);
      let local/main/12 = Ref::new(0);
      while true {
          match <while-condition> current/11.get() {
              Some(local/main/13) =>
                {
                    result/12.set(number/13);
                    current/11.set(Option::None);
                },
              _ => break,
          }
      };
      result/12.get()
  }

  fn unbox(local/main/14: Boxed[isize]) -> isize {
      let Value(local/main/15) = value/14;
      number/15
  }

  fn sum_boxed(local/main/16: Vec[Boxed[isize]]) -> isize {
      let local/main/17 = Ref::new(0);
      for Value(local/main/18) in
        values/16 {
          result/17.set(result/17.get() + number/18);
      };
      result/17.get()
  }

  fn main() -> () {
      let local/main/19: Vec[Boxed[isize]] =
        Vec::from_array([ctor(source:4:main:2::v0)(19), ctor(source:4:main:2::v0)(23)]);
      println(source:4:main:4(ctor(source:4:main:0::v0)(7)));
      println(source:4:main:4(ctor(source:4:main:0::v1)));
      println(source:4:main:4(First::Data { value: 9, label: "data" }));
      println(source:4:main:5(Option::Some(Result::Ok(11))));
      println(source:4:main:5(Option::Some(Result::Err("bad"))));
      println(source:4:main:5(Option::None));
      println(source:4:main:6(Option::Some(13)));
      println(source:4:main:6(Option::None));
      println(source:4:main:7(ctor(source:4:main:0::v1)));
      println(source:4:main:7(ctor(source:4:main:0::v0)(1)));
      println(source:4:main:8(Option::Some(15)));
      println(source:4:main:9(ctor(source:4:main:2::v0)(17)));
      println(source:4:main:10(boxed/19))
  }