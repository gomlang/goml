package main
file main.gom
  enum First[T] {
      Shared(T),
      Idle,
      Data { value: T, label: string }
  }

  enum Second {
      Shared(isize)
  }

  enum Boxed[T] {
      Value(T)
  }

  type FirstInt = First[isize];

  fn classify(local/1/0: FirstInt) -> string {
      match value/0 {
          Shared(local/1/1) => "shared:" + number/1.to_string(),
          Idle => "idle",
          Data { value: local/1/2, label: local/1/3 } => label/3 + ":" + value/2.to_string(),
      }
  }

  fn nested(local/1/4: Option[Result[isize, string]]) -> string {
      match value/4 {
          Some(Ok(local/1/5)) => "ok:" + number/5.to_string(),
          Some(Err(local/1/6)) => "err:" + message/6,
          None => "none",
      }
  }

  fn optional_number(local/1/7: Option[isize]) -> isize {
      match value/7 {
          Some(local/1/8) =>
            {
                number/8
            },
          _ =>
            {
                0
            },
      }
  }

  fn is_non_shared(local/1/9: FirstInt) -> bool {
      match value/9 {
          Idle | Data { .. } => true,
          Shared(_) => false,
      }
  }

  fn take_once(local/1/10: Option[isize]) -> isize {
      let local/1/11 = Ref::new(value/10);
      let local/1/12 = Ref::new(0);
      while true {
          match $while_condition(current/11.get()) {
              Some(local/1/13) =>
                {
                    result/12.set(number/13);
                    current/11.set(Option::None);
                },
              _ => break,
          }
      };
      result/12.get()
  }

  fn unbox(local/1/14: Boxed[isize]) -> isize {
      let Value(local/1/15) = value/14;
      number/15
  }

  fn sum_boxed(local/1/16: Vec[Boxed[isize]]) -> isize {
      let local/1/17 = Ref::new(0);
      for Value(local/1/18) in
        values/16 {
          result/17.set(result/17.get() + number/18);
      };
      result/17.get()
  }

  fn main() -> () {
      let local/1/19: Vec[Boxed[isize]] =
        Vec::from_array([ctor(def/1/2::v0)(19), ctor(def/1/2::v0)(23)]);
      println(def/1/4(ctor(def/1/0::v0)(7)));
      println(def/1/4(ctor(def/1/0::v1)));
      println(def/1/4(First::Data { value: 9, label: "data" }));
      println(def/1/5(Option::Some(Result::Ok(11))));
      println(def/1/5(Option::Some(Result::Err("bad"))));
      println(def/1/5(Option::None));
      println(def/1/6(Option::Some(13)));
      println(def/1/6(Option::None));
      println(def/1/7(ctor(def/1/0::v1)));
      println(def/1/7(ctor(def/1/0::v0)(1)));
      println(def/1/8(Option::Some(15)));
      println(def/1/9(ctor(def/1/2::v0)(17)));
      println(def/1/10(boxed/19))
  }