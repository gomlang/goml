                      let _ : () =
                        (Ref[string]::set : (Ref[string], string) -> ())(
                          (text/21 : Ref[string]),
                          (Ref[string]::get : (Ref[string]) -> string)((text/21 : Ref[string])) +
                            (char::to_string : (char) -> string)((ch/24 : char))
                        );
                      (Ref[isize]::set : (Ref[isize], isize) -> ())(
                        (i/22 : Ref[isize]),
                        (Ref[isize]::get : (Ref[isize]) -> isize)((i/22 : Ref[isize])) + 1
                      )
                  }
              }
          }
      };
    let atom/25: string = (Ref[string]::get : (Ref[string]) -> string)((text/21 : Ref[string]));
    let token/26: Token =
      match (atom/25 : string) {
          "true" => Token::Bool(true),
          "false" => Token::Bool(false),
          _ : string =>
            if (is_int_text : (string) -> bool)((atom/25 : string)) {
                {
                    Token::Int((parse_int32 : (string) -> i32)((atom/25 : string)))
                }
            } else {
