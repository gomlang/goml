          let b/0 = x1 in
          Value::Bool(b/0)
        }
      }
    },
    SExpr::Sym(x2) => {
      {
        let x2 = SExpr::Sym._0(expr/0) in
        {
          let name/0 = x2 in
          lookup(local/0, inherent#Ref#Ref[T]#get__T_Vec[Binding](global/0), name/0)
