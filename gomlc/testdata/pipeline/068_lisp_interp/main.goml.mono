}

fn eval_list_sym(
  name/0: string,
  items/0: Vec[SExpr],
  local/0: Vec[Binding],
  global/0: Ref[Vec[Binding]]
) -> Value {
  match name/0 {
    "begin" => {
      eval_begin(items/0, 1, local/0, global/0)
    },
    "define" => {
      {
        if (inherent#Vec#Vec[T]#len__T_SExpr(items/0) == 3) {
            {
              {
                let mtmp0 = @intrinsic(vec.get)(items/0, 1) in
                match mtmp0 {
                  SExpr::Sym(x0) => {
                    {
                      let x0 = SExpr::Sym._0(mtmp0) in
                      {
                        let var/0 = x0 in
                        {
                          let value/0 = eval(@intrinsic(vec.get)(items/0, 2), local/0, global/0) in
                          let env/0 = inherent#Ref#Ref[T]#get__T_Vec[Binding](global/0) in
                          let updated/0 =
                            inherent#Vec#Vec[T]#pushed__T_Binding(
                              env/0,
                              Binding { name: var/0, value: value/0 }
                            ) in
                          let mtmp1 =
                            inherent#Ref#Ref[T]#set__T_Vec[Binding](global/0, updated/0) in
                          {
                            value/0
                          }
                        }
                      }
                    }
                  },
                  _ => Value::Nil,
                }
              }
            }
        } else {
            {
              Value::Nil
            }
        }
      }
    },
    "if" => {
      {
        if (inherent#Vec#Vec[T]#len__T_SExpr(items/0) == 4) {
            {
              let cond/0 = eval(@intrinsic(vec.get)(items/0, 1), local/0, global/0) in
              if truthy(cond/0) {
                  {
                    eval(@intrinsic(vec.get)(items/0, 2), local/0, global/0)
                  }
              } else {
                  {
                    eval(@intrinsic(vec.get)(items/0, 3), local/0, global/0)
                  }
              }
            }
        } else {
            {
              Value::Nil
            }
        }
      }
    },
    "lambda" => {
      {
        if (inherent#Vec#Vec[T]#len__T_SExpr(items/0) == 3) {
            {
              {
                let mtmp2 = @intrinsic(vec.get)(items/0, 1) in
                match mtmp2 {
                  SExpr::List(x1) => {
                    {
                      let x1 = SExpr::List._0(mtmp2) in
                      {
                        let params_exprs/0 = x1 in
                        {
                          let params/0 = params_from_sexprs(params_exprs/0) in
                          let body/0 = @intrinsic(vec.get)(items/0, 2) in
                          Value::Func(
                            Lambda {
                              params: params/0,
                              body: body/0,
                              env: local/0,
                              global: global/0
                            }
                          )
                        }
                      }
                    }
                  },
                  _ => Value::Nil,
                }
              }
            }
        } else {
            {
              Value::Nil
            }
        }
      }
    },
    "+" => {
      apply_builtin("+", eval_args(items/0, 1, local/0, global/0))
    },
    "-" => {
      apply_builtin("-", eval_args(items/0, 1, local/0, global/0))
    },
    "*" => {
      apply_builtin("*", eval_args(items/0, 1, local/0, global/0))
    },
    "/" => {
      apply_builtin("/", eval_args(items/0, 1, local/0, global/0))
