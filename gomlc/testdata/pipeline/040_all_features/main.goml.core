            {
              let tracker_info/0 = trait_call[Describe::describe](tracker/0) in
              let first_record/0 = snapshot/0() in
              let bumped_record/0 = bump/0(5) in
              let flipped_record/0 = flip/0() in
              let maybe_first/0 = gather(first_record/0) in
              let maybe_second/0 = gather(bumped_record/0) in
              let chosen/0 = choose(true, maybe_second/0, maybe_first/0) in
              let stringified/0 = map_maybe(chosen/0, format_total) in
              let transforms/0 = [increment, triple] in
              let results/0 = run_transforms(4, transforms/0) in
              let first_result/0 = @intrinsic(array.get)(results/0, 0) in
              let second_result/0 = @intrinsic(array.get)(results/0, 1) in
              let order_check/0 =
                if (first_result/0 < second_result/0) {
