                {
                  let mtmp3 = println(bumped_text/0) in
                  {
                    let mtmp4 = println(flipped_text/0) in
                    {
                      let mtmp5 = println(summary/0) in
                      {
                        let mtmp6 = println(pair_text/0) in
                        {
                          let mtmp7 = println(bool_text/0) in
                          {
                            ()
                          }
