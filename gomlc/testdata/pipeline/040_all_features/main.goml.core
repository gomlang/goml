              let first_text/0 = trait_call[Describe::describe](first_record/0) in
              let bumped_text/0 = trait_call[Describe::describe](bumped_record/0) in
              let flipped_text/0 = trait_call[Describe::describe](flipped_record/0) in
              let summary/0 =
                match stringified/0 {
