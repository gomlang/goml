fn build_counter(label/0: string, start/0: i32) -> (
  Tracker,
  () -> Record[i32],
  (i32) -> Record[i32],
  () -> Record[string]
) {
  let count/0 = inherent#Ref#Ref[i32]#new(start/0) in
  let toggled/0 = inherent#Ref#Ref[bool]#new(false) in
  let tracker/0 = Tracker { label: label/0, count: count/0, toggled: toggled/0 } in
  let snapshot/0 =
    || => {
      Record::Value(inherent#Ref#Ref[i32]#get(count/0))
    } in
  let bump/0 =
    |delta/0: i32| => {
      let before/0 = inherent#Ref#Ref[i32]#get(count/0) in
      let mtmp0 = inherent#Ref#Ref[i32]#set(count/0, (before/0 + delta/0)) in
      {
        Record::Pair(before/0, inherent#Ref#Ref[i32]#get(count/0))
      }
    } in
  let flip/0 =
    || => {
      let before/1 = inherent#Ref#Ref[bool]#get(toggled/0) in
      let mtmp1 = inherent#Ref#Ref[bool]#set(toggled/0, (!before/1)) in
      {
        let after/0 = inherent#Ref#Ref[bool]#get(toggled/0) in
        Record::Pair(
          trait_call[ToString::to_string](before/1),
          trait_call[ToString::to_string](after/0)
        )
      }
    } in
  (tracker/0, snapshot/0, bump/0, flip/0)
}

fn main() -> () {
  let mtmp0 = build_counter("goml", 2) in
  {
    let x0 = mtmp0.0 in
    let x1 = mtmp0.1 in
    let x2 = mtmp0.2 in
    let x3 = mtmp0.3 in
    {
      let flip/0 = x3 in
