                } in
              let pair_text/0 =
                pair_join(
                  (
                    inherent#i32#i32#to_string(first_result/0),
                    inherent#i32#i32#to_string(second_result/0)
                  )
                ) in
              let bool_text/0 = trait_call[ToString::to_string](order_check/0) in
              let mtmp1 = println(tracker_info/0) in
              {
