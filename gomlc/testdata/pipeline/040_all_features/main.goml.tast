impl Describe for Tracker {
  fn describe(self/0: Tracker) -> string {
      let Tracker {
        label: label/1: string,
        count: count/2: Ref[i32],
        toggled: toggled/3: Ref[bool]
      } =
        (self/0 : Tracker);
      let current/4: i32 = (Ref[i32]::get : (Ref[i32]) -> i32)((count/2 : Ref[i32]));
      let flag/5: bool = (Ref[bool]::get : (Ref[bool]) -> bool)((toggled/3 : Ref[bool]));
      let with_label/6: string = "Tracker(" + (label/1 : string);
      let with_count_label/7: string = (with_label/6 : string) + ", count: ";
      let with_count/8: string =
        (with_count_label/7 : string) + (i32::to_string : (i32) -> string)((current/4 : i32));
      let with_flag_label/9: string = (with_count/8 : string) + ", toggled: ";
      (with_flag_label/9 : string) + (ToString::to_string : (bool) -> string)((flag/5 : bool)) + ")"
  }
}

impl Describe for Record[i32] {
  fn describe(self/10: Record[i32]) -> string {
      match (self/10 : Record[i32]) {
          Record::Value(value/11: i32) =>
            "Value(" + (i32::to_string : (i32) -> string)((value/11 : i32)) + ")",
          Record::Pair(before/12: i32, after/13: i32) =>
            {
                let prefix/14: string =
                  "Pair(" + (i32::to_string : (i32) -> string)((before/12 : i32));
                (prefix/14 : string) + ", " + (i32::to_string : (i32) -> string)((after/13 : i32)) +
                  ")"
            },
          Record::Empty => "Empty",
      }
  }
}

impl Describe for Record[string] {
  fn describe(self/15: Record[string]) -> string {
      match (self/15 : Record[string]) {
          Record::Value(text/16: string) => "Value(" + (text/16 : string) + ")",
          Record::Pair(before/17: string, after/18: string) =>
            {
                let prefix/19: string = "Pair(" + (before/17 : string);
                (prefix/19 : string) + ", " + (after/18 : string) + ")"
            },
          Record::Empty => "Empty",
      }
  }
}

fn choose[T](flag/20: bool, when_true/21: T, when_false/22: T) -> T {
    if (flag/20 : bool) {
        {
            (when_true/21 : T)
        }
    } else {
        {
            (when_false/22 : T)
        }
    }
}

fn map_maybe[T, U](value/23: Maybe[T], f/24: (T) -> U) -> Maybe[U] {
    match (value/23 : Maybe[T]) {
        Maybe::Some(inner/25: T) => Maybe::Some((f/24 : (T) -> U)((inner/25 : T))),
        Maybe::None => Maybe::None,
    }
}

fn format_total(total/26: i32) -> string {
    "total: " + (i32::to_string : (i32) -> string)((total/26 : i32))
}

fn increment(value/27: i32) -> i32 {
    (value/27 : i32) + 1
}

fn triple(value/28: i32) -> i32 {
    (value/28 : i32) * 3
}

fn pair_join(parts/29: (string, string)) -> string {
    let (left/30: string, right/31: string) = (parts/29 : (string, string));
    (left/30 : string) + " -> " + (right/31 : string)
}

fn run_transforms(value/32: i32, transforms/33: [(i32) -> i32; 2]) -> [i32; 2] {
    let first/34: (i32) -> i32 = (transforms/33 : [(i32) -> i32; 2])[0];
    let second/35: (i32) -> i32 = (transforms/33 : [(i32) -> i32; 2])[1];
    let first_result/36: i32 = (first/34 : (i32) -> i32)((value/32 : i32));
    let second_result/37: i32 = (second/35 : (i32) -> i32)((first_result/36 : i32));
    let mut results/38: [i32; 2] = [(first_result/36 : i32), (value/32 : i32)];
    (results/38 : [i32; 2])[1] = (second_result/37 : i32);
    (results/38 : [i32; 2])
}

fn gather(record/39: Record[i32]) -> Maybe[i32] {
    match (record/39 : Record[i32]) {
        Record::Value(value/40: i32) => Maybe::Some((value/40 : i32)),
        Record::Pair(_ : i32, after/41: i32) => Maybe::Some((after/41 : i32)),
        Record::Empty => Maybe::None,
    }
}

fn build_counter(label/42: string, start/43: i32) -> (
  Tracker,
  () -> Record[i32],
  (i32) -> Record[i32],
  () -> Record[string]
) {
    let count/44: Ref[i32] = (Ref[i32]::new : (i32) -> Ref[i32])((start/43 : i32));
    let toggled/45: Ref[bool] = (Ref[bool]::new : (bool) -> Ref[bool])(false);
    let tracker/46: Tracker =
      Tracker {
        label: (label/42 : string),
        count: (count/44 : Ref[i32]),
        toggled: (toggled/45 : Ref[bool])
      };
    let snapshot/47: () -> Record[i32] =
      || =>
        {
            Record::Value((Ref[i32]::get : (Ref[i32]) -> i32)((count/44 : Ref[i32])))
        };
    let bump/50: (i32) -> Record[i32] =
      |delta/48: i32| =>
        {
            let before/49: i32 = (Ref[i32]::get : (Ref[i32]) -> i32)((count/44 : Ref[i32]));
            let _ : () =
              (Ref[i32]::set : (Ref[i32], i32) -> ())(
                (count/44 : Ref[i32]),
                (before/49 : i32) + (delta/48 : i32)
              );
            Record::Pair(
              (before/49 : i32),
              (Ref[i32]::get : (Ref[i32]) -> i32)((count/44 : Ref[i32]))
            )
        };
    let flip/53: () -> Record[string] =
      || =>
        {
            let before/51: bool = (Ref[bool]::get : (Ref[bool]) -> bool)((toggled/45 : Ref[bool]));
            let _ : () =
              (Ref[bool]::set : (Ref[bool], bool) -> ())(
                (toggled/45 : Ref[bool]),
                !(before/51 : bool)
              );
            let after/52: bool = (Ref[bool]::get : (Ref[bool]) -> bool)((toggled/45 : Ref[bool]));
            Record::Pair(
              (ToString::to_string : (bool) -> string)((before/51 : bool)),
              (ToString::to_string : (bool) -> string)((after/52 : bool))
            )
        };
    (
      (tracker/46 : Tracker),
      (snapshot/47 : () -> Record[i32]),
      (bump/50 : (i32) -> Record[i32]),
      (flip/53 : () -> Record[string])
    )
}

fn main() -> () {
    let (
      tracker/54: Tracker,
      snapshot/55: () -> Record[i32],
      bump/56: (i32) -> Record[i32],
      flip/57: () -> Record[string]
    ) =
      (build_counter : (string, i32) -> (
        Tracker,
        () -> Record[i32],
        (i32) -> Record[i32],
        () -> Record[string]
      ))("goml", 2);
    let tracker_info/58: string =
      (Describe::describe : (Tracker) -> string)((tracker/54 : Tracker));
    let first_record/59: Record[i32] = (snapshot/55 : () -> Record[i32])();
    let bumped_record/60: Record[i32] = (bump/56 : (i32) -> Record[i32])(5);
    let flipped_record/61: Record[string] = (flip/57 : () -> Record[string])();
    let maybe_first/62: Maybe[i32] =
      (gather : (Record[i32]) -> Maybe[i32])((first_record/59 : Record[i32]));
    let maybe_second/63: Maybe[i32] =
      (gather : (Record[i32]) -> Maybe[i32])((bumped_record/60 : Record[i32]));
    let chosen/64: Maybe[i32] =
      (choose : (bool, Maybe[i32], Maybe[i32]) -> Maybe[i32])(
        true,
        (maybe_second/63 : Maybe[i32]),
        (maybe_first/62 : Maybe[i32])
      );
    let stringified/65: Maybe[string] =
      (map_maybe : (Maybe[i32], (i32) -> string) -> Maybe[string])(
        (chosen/64 : Maybe[i32]),
        (format_total : (i32) -> string)
      );
    let transforms/66: [(i32) -> i32; 2] = [(increment : (i32) -> i32), (triple : (i32) -> i32)];
    let results/67: [i32; 2] =
      (run_transforms : (i32, [(i32) -> i32; 2]) -> [i32; 2])(
        4,
        (transforms/66 : [(i32) -> i32; 2])
      );
    let first_result/68: i32 = (results/67 : [i32; 2])[0];
    let second_result/69: i32 = (results/67 : [i32; 2])[1];
    let order_check/70: bool = (first_result/68 : i32) < (second_result/69 : i32) && true;
    let first_text/71: string =
      (Describe::describe : (Record[i32]) -> string)((first_record/59 : Record[i32]));
    let bumped_text/72: string =
      (Describe::describe : (Record[i32]) -> string)((bumped_record/60 : Record[i32]));
    let flipped_text/73: string =
      (Describe::describe : (Record[string]) -> string)((flipped_record/61 : Record[string]));
    let summary/75: string =
      match (stringified/65 : Maybe[string]) {
          Maybe::Some(text/74: string) => "Snapshot: " + (text/74 : string),
          Maybe::None => "Snapshot: none",
      };
    let pair_text/76: string =
      (pair_join : ((string, string)) -> string)(
        (
          (i32::to_string : (i32) -> string)((first_result/68 : i32)),
          (i32::to_string : (i32) -> string)((second_result/69 : i32))
        )
      );
    let bool_text/77: string = (ToString::to_string : (bool) -> string)((order_check/70 : bool));
    let _ : () = (println : (string) -> ())((tracker_info/58 : string));
    let _ : () = (println : (string) -> ())((first_text/71 : string));
    let _ : () = (println : (string) -> ())((bumped_text/72 : string));
    let _ : () = (println : (string) -> ())((flipped_text/73 : string));
    let _ : () = (println : (string) -> ())((summary/75 : string));
    let _ : () = (println : (string) -> ())((pair_text/76 : string));
    let _ : () = (println : (string) -> ())((bool_text/77 : string));
}