fn print_int_list(xs/0: IntList) -> () {
    match (xs/0 : IntList) {
        IntList::Nil => (println : (string) -> ())("Nil"),
        IntList::Cons(x/1: i32, xs/2: IntList) =>
          {
              let _ : () = (println : (string) -> ())("Cons");
              let _ : () = (println : (string) -> ())("(");
              let _ : () =
                (println : (string) -> ())((i32::to_string : (i32) -> string)((x/1 : i32)));
              let _ : () = (println : (string) -> ())(", ");
              let _ : () = (print_int_list : (IntList) -> ())((xs/2 : IntList));
              let _ : () = (println : (string) -> ())(")");
          },
    }
}

fn int_list_rev_aux(xs/3: IntList, acc/4: IntList) -> IntList {
    match (xs/3 : IntList) {
        IntList::Nil => (acc/4 : IntList),
        IntList::Cons(head/5: i32, tail/6: IntList) =>
          (int_list_rev_aux : (IntList, IntList) -> IntList)(
            (tail/6 : IntList),
            IntList::Cons((head/5 : i32), (acc/4 : IntList))
          ),
    }
}

fn int_list_rev(xs/7: IntList) -> IntList {
    (int_list_rev_aux : (IntList, IntList) -> IntList)((xs/7 : IntList), IntList::Nil)
}

fn int_list_length(xs/8: IntList) -> i32 {
    match (xs/8 : IntList) {
        IntList::Nil => 0,
        IntList::Cons(_ : i32, xs/9: IntList) =>
          1 + (int_list_length : (IntList) -> i32)((xs/9 : IntList)),
    }
}

fn print_int_list_length(xs/10: IntList) -> () {
    let _ : () = (println : (string) -> ())("Length: ");
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)((int_list_length : (IntList) -> i32)((xs/10 : IntList)))
      );
}

fn main() -> () {
    let x/11: IntList = IntList::Nil;
    let _ : () = (print_int_list : (IntList) -> ())((x/11 : IntList));
    let _ : () = (println : (string) -> ())("");
    let _ : () = (print_int_list_length : (IntList) -> ())((x/11 : IntList));
    let x/12: IntList = IntList::Cons(1, IntList::Nil);
    let _ : () = (print_int_list : (IntList) -> ())((x/12 : IntList));
    let _ : () = (println : (string) -> ())("");
    let _ : () = (print_int_list_length : (IntList) -> ())((x/12 : IntList));
    let x/13: IntList = IntList::Cons(1, IntList::Cons(2, IntList::Cons(3, IntList::Nil)));
    let _ : () = (print_int_list : (IntList) -> ())((x/13 : IntList));
    let _ : () = (println : (string) -> ())("");
    let _ : () = (print_int_list_length : (IntList) -> ())((x/13 : IntList));
    let y/14: IntList = (int_list_rev : (IntList) -> IntList)((x/13 : IntList));
    let _ : () = (print_int_list : (IntList) -> ())((y/14 : IntList));
    let _ : () = (println : (string) -> ())("");
}