struct Point {
    x: i32,
    y: i32,
}

struct Flag {
    value: bool,
}

struct Counter {
    cell: Ref[i32],
}

trait Display {
    fn show(self: Self) -> string;
    fn show_with(self: Self, arg1: string, arg2: string) -> string;
    fn tick(self: Self) -> ();
    fn bump(self: Self, arg1: i32) -> i32;
}

impl Display for Point {
    fn show(self: Point) -> string {
        "Point(" + self.x.to_string() + "," + self.y.to_string() + ")"
    }

    fn show_with(self: Point, prefix: string, suffix: string) -> string {
        prefix + "Point(" + self.x.to_string() + "," + self.y.to_string() + ")" + suffix
    }

    fn tick(self: Point) -> () {}

    fn bump(self: Point, delta: i32) -> i32 {
        self.x + self.y + delta
    }
}

impl Display for Flag {
    fn show(self: Flag) -> string {
        if self.value {
            "Flag(true)"
        } else {
            "Flag(false)"
        }
    }

    fn show_with(self: Flag, prefix: string, suffix: string) -> string {
        if self.value {
            prefix + "Flag(true)" + suffix
        } else {
            prefix + "Flag(false)" + suffix
        }
    }

    fn tick(self: Flag) -> () {}

    fn bump(self: Flag, delta: i32) -> i32 {
        if self.value {
            delta
        } else {
            -delta
        }
    }
}

impl Display for Counter {
    fn show(self: Counter) -> string {
        "Counter(" + self.cell.get().to_string() + ")"
    }

    fn show_with(self: Counter, prefix: string, suffix: string) -> string {
        prefix + "Counter(" + self.cell.get().to_string() + ")" + suffix
    }

    fn tick(self: Counter) -> () {
        let next = self.cell.get() + 1;
        let _ = self.cell.set(next);
    }

    fn bump(self: Counter, delta: i32) -> i32 {
        let next = self.cell.get() + delta;
        let _ = self.cell.set(next);
        next
    }
}

fn show_dyn(x: dyn Display) -> string {
    Display::show_with(x, "<", ">")
}

fn call_via_closure(x: dyn Display, tag: string) -> string {
    let f: (dyn Display, string) -> string = |v: dyn Display, t: string| Display::show_with(v, t, t);
    f(x, tag)
}

fn make_renderer(tag: string) -> (dyn Display) -> string {
    |x: dyn Display| Display::show_with(x, tag, tag)
}

fn bump_and_show(x: dyn Display, delta: i32) -> string {
    let _ = Display::tick(x);
    Display::show_with(x, "[", "]") + ":" + Display::bump(x, delta).to_string()
}

fn main() -> () {
    let p1 = Point { x: 1, y: 2 };
    let p2 = Point { x: 3, y: 4 };
    let f1 = Flag { value: true };
    let f2 = Flag { value: false };
    let c = Counter { cell: Ref::new(10) };
    let dp1: dyn Display = p1 as dyn Display;
    let dp2: dyn Display = p2 as dyn Display;
    let df1: dyn Display = f1 as dyn Display;
    let df2: dyn Display = f2 as dyn Display;
    let dc: dyn Display = c as dyn Display;
    let render_star = make_renderer("*");
    let render_angle = make_renderer("<");
    let s0 = show_dyn(dp2);
    let s1 = call_via_closure(df2, "*");
    let s2 = render_star(dp1) + "|" + render_angle(df1);
    let v: Vec[dyn Display] = Vec::new();
    v.push(dp1);
    v.push(df1);
    v.push(dc);
    let vlen = v.len();
    let delta = match vlen {
        2 => 3,
        _ => 5,
    };
    let _ = println(s0);
    let _ = println(s1);
    let _ = println(s2);
    let i: Ref[i32] = Ref::new(0);
    let _ = while i.get() < 3 {
        let line = bump_and_show(dc, delta);
        println(line);
        let _ = i.set(i.get() + 1);
    };
    let _ = println("len:" + vlen.to_string());
    let _ = println("delta:" + delta.to_string());
}
