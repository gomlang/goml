impl Display for Point {
  fn show(self/0: Point) -> string {
      "Point(" + (i32::to_string : (i32) -> string)((self/0 : Point).x) + "," +
        (i32::to_string : (i32) -> string)((self/0 : Point).y) +
        ")"
  }
  fn show_with(self/1: Point, prefix/2: string, suffix/3: string) -> string {
      (prefix/2 : string) + "Point(" + (i32::to_string : (i32) -> string)((self/1 : Point).x) +
        "," +
        (i32::to_string : (i32) -> string)((self/1 : Point).y) +
        ")" +
        (suffix/3 : string)
  }
  fn tick(self/4: Point) -> () {}
  fn bump(self/5: Point, delta/6: i32) -> i32 {
      (self/5 : Point).x + (self/5 : Point).y + (delta/6 : i32)
  }
}

impl Display for Flag {
  fn show(self/7: Flag) -> string {
      if (self/7 : Flag).value {
          {
              "Flag(true)"
          }
      } else {
          {
              "Flag(false)"
          }
      }
  }
  fn show_with(self/8: Flag, prefix/9: string, suffix/10: string) -> string {
      if (self/8 : Flag).value {
          {
              (prefix/9 : string) + "Flag(true)" + (suffix/10 : string)
          }
      } else {
          {
              (prefix/9 : string) + "Flag(false)" + (suffix/10 : string)
          }
      }
  }
  fn tick(self/11: Flag) -> () {}
  fn bump(self/12: Flag, delta/13: i32) -> i32 {
      if (self/12 : Flag).value {
          {
              (delta/13 : i32)
          }
      } else {
          {
              -(delta/13 : i32)
          }
      }
  }
}

impl Display for Counter {
  fn show(self/14: Counter) -> string {
      "Counter(" +
        (i32::to_string : (i32) -> string)(
          (Ref[i32]::get : (Ref[i32]) -> i32)((self/14 : Counter).cell)
        ) +
        ")"
  }
  fn show_with(self/15: Counter, prefix/16: string, suffix/17: string) -> string {
      (prefix/16 : string) + "Counter(" +
        (i32::to_string : (i32) -> string)(
          (Ref[i32]::get : (Ref[i32]) -> i32)((self/15 : Counter).cell)
        ) +
        ")" +
        (suffix/17 : string)
  }
  fn tick(self/18: Counter) -> () {
      let next/19: i32 = (Ref[i32]::get : (Ref[i32]) -> i32)((self/18 : Counter).cell) + 1;
      let _ : () =
        (Ref[i32]::set : (Ref[i32], i32) -> ())((self/18 : Counter).cell, (next/19 : i32));
  }
  fn bump(self/20: Counter, delta/21: i32) -> i32 {
      let next/22: i32 =
        (Ref[i32]::get : (Ref[i32]) -> i32)((self/20 : Counter).cell) + (delta/21 : i32);
      let _ : () =
        (Ref[i32]::set : (Ref[i32], i32) -> ())((self/20 : Counter).cell, (next/22 : i32));
      (next/22 : i32)
  }
}

fn show_dyn(x/23: dyn Display) -> string {
    (dyn Display::show_with : (dyn Display, string, string) -> string)(
      (x/23 : dyn Display),
      "<",
      ">"
    )
}

fn call_via_closure(x/24: dyn Display, tag/25: string) -> string {
    let f/28: (dyn Display, string) -> string =
      |v/26: dyn Display, t/27: string| =>
        (dyn Display::show_with : (dyn Display, string, string) -> string)(
          (v/26 : dyn Display),
          (t/27 : string),
          (t/27 : string)
        );
    (f/28 : (dyn Display, string) -> string)((x/24 : dyn Display), (tag/25 : string))
}

fn make_renderer(tag/29: string) -> (dyn Display) -> string {
    |x/30: dyn Display| =>
      (dyn Display::show_with : (dyn Display, string, string) -> string)(
        (x/30 : dyn Display),
        (tag/29 : string),
        (tag/29 : string)
      )
}

fn bump_and_show(x/31: dyn Display, delta/32: i32) -> string {
    let _ : () = (dyn Display::tick : (dyn Display) -> ())((x/31 : dyn Display));
    (dyn Display::show_with : (dyn Display, string, string) -> string)(
      (x/31 : dyn Display),
      "[",
      "]"
    ) +
      ":" +
      (i32::to_string : (i32) -> string)(
        (dyn Display::bump : (dyn Display, i32) -> i32)((x/31 : dyn Display), (delta/32 : i32))
      )
}

fn main() -> () {
    let p1/33: Point = Point { x: 1, y: 2 };
    let p2/34: Point = Point { x: 3, y: 4 };
    let f1/35: Flag = Flag { value: true };
    let f2/36: Flag = Flag { value: false };
    let c/37: Counter = Counter { cell: (Ref[i32]::new : (i32) -> Ref[i32])(10) };
    let dp1/38: dyn Display = to_dyn[Display]{Point}((p1/33 : Point));
    let dp2/39: dyn Display = to_dyn[Display]{Point}((p2/34 : Point));
    let df1/40: dyn Display = to_dyn[Display]{Flag}((f1/35 : Flag));
    let df2/41: dyn Display = to_dyn[Display]{Flag}((f2/36 : Flag));
    let dc/42: dyn Display = to_dyn[Display]{Counter}((c/37 : Counter));
    let render_star/43: (dyn Display) -> string =
      (make_renderer : (string) -> (dyn Display) -> string)("*");
    let render_angle/44: (dyn Display) -> string =
      (make_renderer : (string) -> (dyn Display) -> string)("<");
    let s0/45: string = (show_dyn : (dyn Display) -> string)((dp2/39 : dyn Display));
    let s1/46: string =
      (call_via_closure : (dyn Display, string) -> string)((df2/41 : dyn Display), "*");
    let s2/47: string =
      (render_star/43 : (dyn Display) -> string)((dp1/38 : dyn Display)) + "|" +
        (render_angle/44 : (dyn Display) -> string)((df1/40 : dyn Display));
    let v/48: Vec[dyn Display] = (Vec[dyn Display]::new : () -> Vec[dyn Display])();
    (Vec[dyn Display]::push : (Vec[dyn Display], dyn Display) -> ())(
      (v/48 : Vec[dyn Display]),
      (dp1/38 : dyn Display)
    );
    (Vec[dyn Display]::push : (Vec[dyn Display], dyn Display) -> ())(
      (v/48 : Vec[dyn Display]),
      (df1/40 : dyn Display)
    );
    (Vec[dyn Display]::push : (Vec[dyn Display], dyn Display) -> ())(
      (v/48 : Vec[dyn Display]),
      (dc/42 : dyn Display)
    );
    let vlen/49: isize =
      (Vec[dyn Display]::len : (Vec[dyn Display]) -> isize)((v/48 : Vec[dyn Display]));
    let delta/50: i32 =
      match (vlen/49 : isize) {
          2 => 3,
          _ : isize => 5,
      };
    let _ : () = (println : (string) -> ())((s0/45 : string));
    let _ : () = (println : (string) -> ())((s1/46 : string));
    let _ : () = (println : (string) -> ())((s2/47 : string));
    let i/51: Ref[i32] = (Ref[i32]::new : (i32) -> Ref[i32])(0);
    let _ : () =
      while (Ref[i32]::get : (Ref[i32]) -> i32)((i/51 : Ref[i32])) < 3 {
          {
              let line/52: string =
                (bump_and_show : (dyn Display, i32) -> string)(
                  (dc/42 : dyn Display),
                  (delta/50 : i32)
                );
              (println : (string) -> ())((line/52 : string));
              let _ : () =
                (Ref[i32]::set : (Ref[i32], i32) -> ())(
                  (i/51 : Ref[i32]),
                  (Ref[i32]::get : (Ref[i32]) -> i32)((i/51 : Ref[i32])) + 1
                );
          }
      };
    let _ : () =
      (println : (string) -> ())(
        "len:" + (isize::to_string : (isize) -> string)((vlen/49 : isize))
      );
    let _ : () =
      (println : (string) -> ())("delta:" + (i32::to_string : (i32) -> string)((delta/50 : i32)));
}