package main;
struct LoggedKey {
    id: isize,
    log: Ref[string],
}

#[derive(Hash, PartialEq, Eq)]
struct DerivedKey {
    id: isize,
}

impl Hash for DerivedKey {
  fn hash(self: DerivedKey) -> u64 {
      {
          let h = 0.to_u64() + 14695981039346656037;
          let h = h * 0.to_u64() + 1099511628211 + Hash::hash(self.id);
          h
      }
  }
}

impl PartialEq for DerivedKey {
  fn eq(self: DerivedKey, other: DerivedKey) -> bool {
      true && PartialEq::eq(self.id, other.id)
  }
}

impl Eq for DerivedKey where isize: Eq {}

impl PartialEq for LoggedKey {
  fn eq(self: LoggedKey, other: LoggedKey) -> bool {
      self.log.set(self.log.get() + "E");
      self.id == other.id
  }
}

impl Eq for LoggedKey {}

impl Hash for LoggedKey {
  fn hash(self: LoggedKey) -> u64 {
      self.log.set(self.log.get() + "H");
      self.id.to_u64()
  }
}

fn logged_key(log: Ref[string], label: string, id: isize) -> LoggedKey {
    log.set(log.get() + label);
    LoggedKey { id: id, log: log }
}

fn logged_value(log: Ref[string], label: string, value: isize) -> isize {
    log.set(log.get() + label);
    value
}

fn main() -> () {
    let make_vec: ([isize; 3]) -> Vec[isize] = Vec::from_array;
    let values = make_vec([1, 2, 3]);
    println(f"{values.len()}:{values[0]}:{values[2]}");
    let empty: Vec[isize] = Vec::[isize]::new();
    println(empty.len());
    let inferred_empty: Vec[isize] = Vec::new();
    println(inferred_empty.len());
    let mut source = [Ref::new(1), Ref::new(2)];
    let copied = Vec::from_array(source);
    source[0].set(5);
    source[0] = Ref::new(9);
    println(f"{copied[0].get()}:{source[0].get()}");
    let log = Ref::new("");
    let table =
      HashMap::from_array(
        [
          (logged_key(log, "A", 1), logged_value(log, "a", 10)),
          (logged_key(log, "B", 1), logged_value(log, "b", 20))
        ]
      );
    println(log.get());
    println(
      match table.get(LoggedKey { id: 1, log: log }) {
          Some(value) => value,
          None => 0,
      }
    );
    let make_map: ([(string, isize); 2]) -> HashMap[string, isize] = HashMap::from_array;
    let words = make_map([("a", 1), ("b", 2)]);
    println(words.len());
    let no_words = HashMap::[string, isize]::new();
    println(no_words.len());
    let inferred_no_words: HashMap[string, isize] = HashMap::new();
    println(inferred_no_words.len());
    let mut native_entries = [(1, 10)];
    let native_first = HashMap::from_array(native_entries);
    native_entries[0] = (2, 20);
    let native_second = HashMap::from_array(native_entries);
    println(
      f"{native_first.get(1).unwrap_or(0)}:{native_second.get(1).unwrap_or(0)}:{native_second.get(
        2
      ).unwrap_or(0)}"
    );
    let mut derived_entries = [(DerivedKey { id: 1 }, 30)];
    let derived_first = HashMap::from_array(derived_entries);
    derived_entries[0] = (DerivedKey { id: 2 }, 40);
    let derived_second = HashMap::from_array(derived_entries);
    println(
      f"{derived_first.get(DerivedKey { id: 1 }).unwrap_or(0)}:{derived_second.get(
        DerivedKey { id: 1 }
      ).unwrap_or(0)}:{derived_second.get(DerivedKey { id: 2 }).unwrap_or(0)}"
    );
    let pairs = Vec::from_array([(1, "a"), (2, "b")]);
    let nested = Vec::from_array([Vec::from_array([1, 2]), Vec::from_array([3, 4])]);
    let nested_map = HashMap::from_array([("values", Vec::from_array([5, 6]))]);
    let nested_value =
      match nested_map.get("values") {
          Some(values) => values[0],
          None => 0,
      };
    println(f"{pairs[1].1}:{nested[1][0]}:{nested_value}")
}

