use std::cmp;

#[derive(PartialEq, Eq, Hash)]
struct DerivedKey {
    value: isize,
}

struct CustomKey {
    value: isize,
}

impl PartialEq for CustomKey {
    fn eq(self: CustomKey, other: CustomKey) -> bool {
        self.value % 10 == other.value % 10
    }
}

impl Eq for CustomKey {}

impl Hash for CustomKey {
    fn hash(self: CustomKey) -> u64 {
        (self.value % 10).to_u64()
    }
}

struct Rank {
    value: isize,
}

impl PartialEq for Rank {
    fn eq(self: Rank, other: Rank) -> bool {
        self.value == other.value
    }
}

impl cmp::PartialOrd for Rank {
    fn partial_cmp(self: Rank, other: Rank) -> Option[cmp::Ordering] {
        Option::Some(
            if self.value > other.value {
                cmp::Ordering::Less
            } else if self.value < other.value {
                cmp::Ordering::Greater
            } else {
                cmp::Ordering::Equal
            },
        )
    }
}

fn equal[T: Eq](left: T, right: T) -> bool {
    left == right
}

fn main() -> () {
    let derived = DerivedKey { value: 7 };
    let custom = CustomKey { value: 9 };
    println(equal(derived, DerivedKey { value: 7 }));
    println(PartialEq::eq(derived, DerivedKey { value: 8 }));
    println(equal(custom, CustomKey { value: 19 }));
    println((custom != CustomKey { value: 20 }).to_string());
    let derived_map: HashMap[DerivedKey, string] = HashMap::new();
    derived_map.set(derived, "derived");
    println(derived_map.get(DerivedKey { value: 7 }).unwrap_or("missing"));
    let custom_map: HashMap[CustomKey, string] = HashMap::new();
    custom_map.set(custom, "custom");
    println(custom_map.get(CustomKey { value: 19 }).unwrap_or("missing"));
    let high = Rank { value: 2 };
    let low = Rank { value: 1 };
    println((high < low).to_string());
    println((high <= high).to_string());
    println((low > high).to_string());
    println((low >= low).to_string())
}
