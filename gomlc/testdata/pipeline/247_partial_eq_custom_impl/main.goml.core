}

fn main() -> () {
  let derived/0 = DerivedKey { value: 7 } in
  let custom/0 = CustomKey { value: 9 } in
  let _wild0 = println(equal(derived/0, DerivedKey { value: 7 })) in
  let _wild1 = println(trait_call[PartialEq::eq](derived/0, DerivedKey { value: 8 })) in
  let _wild2 = println(equal(custom/0, CustomKey { value: 19 })) in
  let _wild3 =
    println(
      trait_call[ToString::to_string](
        (!trait_call[PartialEq::eq](custom/0, CustomKey { value: 20 }))
      )
    ) in
  let derived_map/0 = inherent#HashMap#HashMap[DerivedKey,string]#new() in
  let _wild4 =
    inherent#HashMap#HashMap[DerivedKey,string]#set(derived_map/0, derived/0, "derived") in
  let _wild5 =
    println(
      inherent#Option#Option[string]#unwrap_or(
        inherent#HashMap#HashMap[DerivedKey,string]#get(derived_map/0, DerivedKey { value: 7 }),
        "missing"
      )
    ) in
  let custom_map/0 = inherent#HashMap#HashMap[CustomKey,string]#new() in
  let _wild6 = inherent#HashMap#HashMap[CustomKey,string]#set(custom_map/0, custom/0, "custom") in
  let _wild7 =
    println(
      inherent#Option#Option[string]#unwrap_or(
        inherent#HashMap#HashMap[CustomKey,string]#get(custom_map/0, CustomKey { value: 19 }),
        "missing"
      )
    ) in
  let high/0 = Rank { value: 2 } in
  let low/0 = Rank { value: 1 } in
  let _wild8 =
    println(trait_call[ToString::to_string](trait_call[std::cmp::PartialOrd::lt](high/0, low/0))) in
  let _wild9 =
    println(
      trait_call[ToString::to_string](trait_call[std::cmp::PartialOrd::le](high/0, high/0))
    ) in
  let _wild10 =
    println(trait_call[ToString::to_string](trait_call[std::cmp::PartialOrd::gt](low/0, high/0))) in
  println(trait_call[ToString::to_string](trait_call[std::cmp::PartialOrd::ge](low/0, low/0)))
}