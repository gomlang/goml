  #[derive(PartialEq, Eq, Hash)]
  struct DerivedKey {
      value: isize,
  }

  impl PartialEq for DerivedKey {
    fn eq(local/1/0: DerivedKey, local/1/1: DerivedKey) -> bool {
        true && PartialEq::eq(self/0.value, other/1.value)
    }
  }

  impl Eq for DerivedKey where isize: Eq {}

  impl Hash for DerivedKey {
    fn hash(local/1/2: DerivedKey) -> u64 {
        {
            let local/1/3 = 0.to_u64() + 14695981039346656037;
            let local/1/4 = h/3 * 0.to_u64() + 1099511628211 + Hash::hash(self/2.value);
            h/4
        }
    }
  }

  struct CustomKey {
      value: isize,
  }

  impl PartialEq for CustomKey {
    fn eq(local/1/5: CustomKey, local/1/6: CustomKey) -> bool {
        self/5.value % 10 == other/6.value % 10
    }
  }

  impl Eq for CustomKey {}

  impl Hash for CustomKey {
    fn hash(local/1/7: CustomKey) -> u64 {
        self/7.value % 10.to_u64()
    }
  }

  struct Rank {
      value: isize,
  }

  impl PartialEq for Rank {
    fn eq(local/1/8: Rank, local/1/9: Rank) -> bool {
        self/8.value == other/9.value
    }
  }

  impl cmp::PartialOrd for Rank {
    fn partial_cmp(local/1/10: Rank, local/1/11: Rank) -> Option[cmp::Ordering] {
        Option::Some(
          if self/10.value > other/11.value {
              cmp::Ordering::Less
          } else if self/10.value < other/11.value {
              cmp::Ordering::Greater
          } else {
              cmp::Ordering::Equal
          }
        )
    }
  }

  fn equal[T: Eq](local/1/12: T, local/1/13: T) -> bool {
      left/12 == right/13
  }

