impl PartialEq for DerivedKey {
  fn eq(self/0: DerivedKey, other/1: DerivedKey) -> bool {
      true &&
        (PartialEq::eq : (isize, isize) -> bool)(
          (self/0 : DerivedKey).value,
          (other/1 : DerivedKey).value
        )
  }
}

impl Eq for DerivedKey where isize: Eq, isize: PartialEq {}

impl Hash for DerivedKey {
  fn hash(self/2: DerivedKey) -> u64 {
      {
          let h/3: u64 = (isize::to_u64 : (isize) -> u64)(0) + 14695981039346656037;
          let h/4: u64 =
            (h/3 : u64) * (isize::to_u64 : (isize) -> u64)(0) + 1099511628211 +
              (Hash::hash : (isize) -> u64)((self/2 : DerivedKey).value);
          (h/4 : u64)
      }
  }
}

impl PartialEq for CustomKey {
  fn eq(self/5: CustomKey, other/6: CustomKey) -> bool {
      (self/5 : CustomKey).value % 10 == (other/6 : CustomKey).value % 10
  }
}

impl Eq for CustomKey {}

impl Hash for CustomKey {
  fn hash(self/7: CustomKey) -> u64 {
      (isize::to_u64 : (isize) -> u64)((self/7 : CustomKey).value % 10)
  }
}

impl PartialEq for Rank {
  fn eq(self/8: Rank, other/9: Rank) -> bool {
      (self/8 : Rank).value == (other/9 : Rank).value
  }
}

impl std::cmp::PartialOrd for Rank {
  fn partial_cmp(self/10: Rank, other/11: Rank) -> Option[Ordering] {
      Option::Some(
        if (self/10 : Rank).value > (other/11 : Rank).value {
            {
                Ordering::Less
            }
        } else {
            if (self/10 : Rank).value < (other/11 : Rank).value {
                {
                    Ordering::Greater
                }
            } else {
                {
                    Ordering::Equal
                }
            }
        }
      )
  }
  fn lt(default_arg0: Rank, default_arg1: Rank) -> bool {
      (std::cmp::trait_default#PartialOrd#lt : (Rank, Rank) -> bool)(
        (default_arg0 : Rank),
        (default_arg1 : Rank)
      )
  }
  fn le(default_arg0: Rank, default_arg1: Rank) -> bool {
      (std::cmp::trait_default#PartialOrd#le : (Rank, Rank) -> bool)(
        (default_arg0 : Rank),
        (default_arg1 : Rank)
      )
  }
  fn gt(default_arg0: Rank, default_arg1: Rank) -> bool {
      (std::cmp::trait_default#PartialOrd#gt : (Rank, Rank) -> bool)(
        (default_arg0 : Rank),
        (default_arg1 : Rank)
      )
  }
  fn ge(default_arg0: Rank, default_arg1: Rank) -> bool {
      (std::cmp::trait_default#PartialOrd#ge : (Rank, Rank) -> bool)(
        (default_arg0 : Rank),
        (default_arg1 : Rank)
      )
  }
}

fn equal[T](left/12: T, right/13: T) -> bool where T: Eq, T: PartialEq {
    (left/12 : T) == (right/13 : T)
}

fn main() -> () {
    let derived/14: DerivedKey = DerivedKey { value: 7 };
    let custom/15: CustomKey = CustomKey { value: 9 };
    (println : (bool) -> ())(
      (equal : (DerivedKey, DerivedKey) -> bool)((derived/14 : DerivedKey), DerivedKey { value: 7 })
    );
    (println : (bool) -> ())(
      (PartialEq::eq : (DerivedKey, DerivedKey) -> bool)(
        (derived/14 : DerivedKey),
        DerivedKey { value: 8 }
      )
    );
    (println : (bool) -> ())(
      (equal : (CustomKey, CustomKey) -> bool)((custom/15 : CustomKey), CustomKey { value: 19 })
    );
    (println : (string) -> ())(
      (ToString::to_string : (bool) -> string)((custom/15 : CustomKey) != CustomKey { value: 20 })
    );
    let derived_map/16: HashMap[DerivedKey, string] =
      (HashMap[DerivedKey, string]::new : () -> HashMap[DerivedKey, string])();
    (HashMap[DerivedKey, string]::set : (HashMap[DerivedKey, string], DerivedKey, string) -> ())(
      (derived_map/16 : HashMap[DerivedKey, string]),
      (derived/14 : DerivedKey),
      "derived"
    );
    (println : (string) -> ())(
      (Option[string]::unwrap_or : (Option[string], string) -> string)(
        (HashMap[DerivedKey, string]::get : (HashMap[DerivedKey, string], DerivedKey) -> Option[
          string
        ])((derived_map/16 : HashMap[DerivedKey, string]), DerivedKey { value: 7 }),
        "missing"
      )
    );
    let custom_map/17: HashMap[CustomKey, string] =
      (HashMap[CustomKey, string]::new : () -> HashMap[CustomKey, string])();
    (HashMap[CustomKey, string]::set : (HashMap[CustomKey, string], CustomKey, string) -> ())(
      (custom_map/17 : HashMap[CustomKey, string]),
      (custom/15 : CustomKey),
      "custom"
    );
    (println : (string) -> ())(
      (Option[string]::unwrap_or : (Option[string], string) -> string)(
        (HashMap[CustomKey, string]::get : (HashMap[CustomKey, string], CustomKey) -> Option[
          string
        ])((custom_map/17 : HashMap[CustomKey, string]), CustomKey { value: 19 }),
        "missing"
      )
    );
    let high/18: Rank = Rank { value: 2 };
    let low/19: Rank = Rank { value: 1 };
    (println : (string) -> ())(
      (ToString::to_string : (bool) -> string)((high/18 : Rank) < (low/19 : Rank))
    );
    (println : (string) -> ())(
      (ToString::to_string : (bool) -> string)((high/18 : Rank) <= (high/18 : Rank))
    );
    (println : (string) -> ())(
      (ToString::to_string : (bool) -> string)((low/19 : Rank) > (high/18 : Rank))
    );
    (println : (string) -> ())(
      (ToString::to_string : (bool) -> string)((low/19 : Rank) >= (low/19 : Rank))
    )
}