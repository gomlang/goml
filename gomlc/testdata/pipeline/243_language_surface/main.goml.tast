fn read(source/1: dyn Source[Item = isize]) -> isize {
    (dyn Source::get : (dyn Source[Item = isize]) -> isize)((source/1 : dyn Source[Item = isize]))
}

fn labeled_cleanup() -> () {
    loop {
        defer (println : (string) -> ())("outer cleanup");
        loop {
            defer (println : (string) -> ())("inner cleanup");
            break@1;
        }
    }
}

