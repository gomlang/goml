package main;
struct Counter {
    start: u32,
    end: u64,
}

fn is_flag8(value: u8) -> bool {
    match value {
        0 => true,
        200 => true,
        _ => false,
    }
}

fn is_flag16(value: u16) -> bool {
    match value {
        1024 => true,
        65000 => true,
        _ => false,
    }
}

fn is_flag32(value: u32) -> bool {
    match value {
        4000000000 => true,
        1234567890 => true,
        _ => false,
    }
}

fn is_flag64(value: u64) -> bool {
    match value {
        900000000 => true,
        600000000 => true,
        _ => false,
    }
}

fn match_struct(counter: Counter) -> bool {
    match counter {
        Counter { start: 4000000000, end: 900000000 } => true,
        Counter { start: _, end: 600000000 } => true,
        _ => false,
    }
}

fn report(label: string, value: bool) -> string {
    label + value.to_string()
}

fn main() {
    let counter = Counter { start: 4000000000, end: 900000000 };
    let alt_counter = Counter { start: 12, end: 600000000 };
    let message =
      report("u8_hit=", is_flag8(200)) + report(",u8_miss=", is_flag8(15)) +
        report(",u16_hit=", is_flag16(65000)) +
        report(",u16_miss=", is_flag16(42)) +
        report(",u32_hit=", is_flag32(1234567890)) +
        report(",u32_miss=", is_flag32(99)) +
        report(",u64_hit=", is_flag64(900000000)) +
        report(",u64_miss=", is_flag64(700000000)) +
        report(",struct_first=", match_struct(counter)) +
        report(",struct_second=", match_struct(alt_counter));
    let _ = println(message);
}

