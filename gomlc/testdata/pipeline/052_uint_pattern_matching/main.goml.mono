fn report(label/0: string, value/0: bool) -> string {
  (label/0 + trait_impl#ToString#bool#to_string(value/0))
}

fn main() -> () {
  let counter/0 = Counter { start: 4000000000, end: 900000000 } in
  let alt_counter/0 = Counter { start: 12, end: 600000000 } in
  let message/0 =
    (((((((((report("u8_hit=", is_flag0(200)) + report(",u8_miss=", is_flag0(15))) +
      report(",u16_hit=", is_flag1(65000))) +
      report(",u16_miss=", is_flag1(42))) +
      report(",u32_hit=", is_flag2(1234567890))) +
      report(",u32_miss=", is_flag2(99))) +
      report(",u64_hit=", is_flag3(900000000))) +
      report(",u64_miss=", is_flag3(700000000))) +
      report(",struct_first=", match_struct(counter/0))) +
      report(",struct_second=", match_struct(alt_counter/0))) in
  let mtmp0 = println__T_string(message/0) in
  {
    ()
  }
}

