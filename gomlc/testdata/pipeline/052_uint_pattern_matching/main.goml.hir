package main
file main.goml
  struct Counter {
      start: u32,
      end: u64,
  }

  fn is_flag8(local/1/0: u8) -> bool {
      match value/0 {
          0 => true,
          200 => true,
          _ => false,
      }
  }

  fn is_flag16(local/1/1: u16) -> bool {
      match value/1 {
          1024 => true,
          65000 => true,
          _ => false,
      }
  }

  fn is_flag32(local/1/2: u32) -> bool {
      match value/2 {
          4000000000 => true,
          1234567890 => true,
          _ => false,
      }
  }

  fn is_flag64(local/1/3: u64) -> bool {
      match value/3 {
          900000000 => true,
          600000000 => true,
          _ => false,
      }
  }

  fn match_struct(local/1/4: Counter) -> bool {
      match counter/4 {
          Counter { start: 4000000000, end: 900000000 } => true,
          Counter { start: _, end: 600000000 } => true,
          _ => false,
      }
  }

  fn report(local/1/5: string, local/1/6: bool) -> string {
      label/5 + value/6.to_string()
  }

  fn main() {
      let local/1/7 = Counter { start: 4000000000, end: 900000000 };
      let local/1/8 = Counter { start: 12, end: 600000000 };
      let local/1/9 =
        def/1/6("u8_hit=", def/1/1(200)) + def/1/6(",u8_miss=", def/1/1(15)) +
          def/1/6(",u16_hit=", def/1/2(65000)) +
          def/1/6(",u16_miss=", def/1/2(42)) +
          def/1/6(",u32_hit=", def/1/3(1234567890)) +
          def/1/6(",u32_miss=", def/1/3(99)) +
          def/1/6(",u64_hit=", def/1/4(900000000)) +
          def/1/6(",u64_miss=", def/1/4(700000000)) +
          def/1/6(",struct_first=", def/1/5(counter/7)) +
          def/1/6(",struct_second=", def/1/5(alt_counter/8));
      let _ = println(message/9);
  }