package main
file main.goml
  struct Counter {
      start: u32,
      end: u64,
  }

  fn is_flag8(local/main/0: u8) -> bool {
      match value/0 {
          0 => true,
          200 => true,
          _ => false,
      }
  }

  fn is_flag16(local/main/1: u16) -> bool {
      match value/1 {
          1024 => true,
          65000 => true,
          _ => false,
      }
  }

  fn is_flag32(local/main/2: u32) -> bool {
      match value/2 {
          4000000000 => true,
          1234567890 => true,
          _ => false,
      }
  }

  fn is_flag64(local/main/3: u64) -> bool {
      match value/3 {
          900000000 => true,
          600000000 => true,
          _ => false,
      }
  }

  fn match_struct(local/main/4: Counter) -> bool {
      match counter/4 {
          Counter { start: 4000000000, end: 900000000 } => true,
          Counter { start: _, end: 600000000 } => true,
          _ => false,
      }
  }

  fn report(local/main/5: string, local/main/6: bool) -> string {
      label/5 + value/6.to_string()
  }

  fn main() {
      let local/main/7 = Counter { start: 4000000000, end: 900000000 };
      let local/main/8 = Counter { start: 12, end: 600000000 };
      let local/main/9 =
        source:4:main:6("u8_hit=", source:4:main:1(200)) +
          source:4:main:6(",u8_miss=", source:4:main:1(15)) +
          source:4:main:6(",u16_hit=", source:4:main:2(65000)) +
          source:4:main:6(",u16_miss=", source:4:main:2(42)) +
          source:4:main:6(",u32_hit=", source:4:main:3(1234567890)) +
          source:4:main:6(",u32_miss=", source:4:main:3(99)) +
          source:4:main:6(",u64_hit=", source:4:main:4(900000000)) +
          source:4:main:6(",u64_miss=", source:4:main:4(700000000)) +
          source:4:main:6(",struct_first=", source:4:main:5(counter/7)) +
          source:4:main:6(",struct_second=", source:4:main:5(alt_counter/8));
      let _ = println(message/9);
  }