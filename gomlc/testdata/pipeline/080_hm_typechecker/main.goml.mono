            match mtmp0 {
              Tv::Unbound(x1, x2) => {
                {
                  let x1 = Tv::Unbound._0(mtmp0) in
                  {
                    let name/0 = x1 in
                    ("'" + name/0)
                  }
                }
              },
              Tv::Link(x3) => {
                {
                  let x3 = Tv::Link._0(mtmp0) in
                  {
                    let inner/0 = x3 in
                    typ_to_string(inner/0)
