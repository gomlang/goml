      }
    },
    Typ::QVar(x4) => {
      {
        let x4 = Typ::QVar._0(ty/0) in
        {
          let name/1 = x4 in
          ("'" + name/1)
        }
      }
    },
    Typ::TArrow(x5, x6) => {
      {
        let x5 = Typ::TArrow._0(ty/0) in
        let x6 = Typ::TArrow._1(ty/0) in
        {
          let t2/0 = x6 in
          {
            let t1/0 = x5 in
            {
              let s1/0 =
                if typ_is_arrow(t1/0) {
                    {
