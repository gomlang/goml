  #[derive(PartialEq, Default, Debug)]
  struct Settings {
      enabled: bool,
      retries: isize,
      label: string,
  }

  impl PartialEq for Settings {
    fn eq(local/1/0: Settings, local/1/1: Settings) -> bool {
        true && PartialEq::eq(self/0.enabled, other/1.enabled) &&
          PartialEq::eq(self/0.retries, other/1.retries) &&
          PartialEq::eq(self/0.label, other/1.label)
    }
  }

  impl Default for Settings {
    fn default() -> Settings {
        Settings {
          enabled: Default::default(),
          retries: Default::default(),
          label: Default::default()
        }
    }
  }

  impl Debug for Settings {
    fn debug(local/1/2: Settings) -> string {
        {
            let Settings { enabled: local/1/3, retries: local/1/4, label: local/1/5 } = self/2;
            "Settings { " + "enabled: " + Debug::debug(#derive0_field/3) + ", " + "retries: " +
              Debug::debug(#derive1_field/4) +
              ", " +
              "label: " +
              Debug::debug(#derive2_field/5) +
              " }"
        }
    }
  }

  struct NoDefault {
      value: isize,
  }

  #[derive(Default, Debug)]
  struct Empty {}

  impl Default for Empty {
    fn default() -> Empty {
        Empty {}
    }
  }

  impl Debug for Empty {
    fn debug(local/1/6: Empty) -> string {
        "Empty {}"
    }
  }

  #[derive(Default)]
  struct PairDefaults[T] {
      first: T,
      second: T,
      nested: Option[T],
  }

  impl[T] Default for PairDefaults[T] where T: Default, Option[T]: Default {
    fn default() -> PairDefaults[T] {
        PairDefaults {
          first: Default::default(),
          second: Default::default(),
          nested: Default::default()
        }
    }
  }

