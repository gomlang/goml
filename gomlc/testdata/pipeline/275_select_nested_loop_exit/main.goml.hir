package main
file main.goml
  fn default_break_outer_continue() -> isize {
      let local/main/0 = Ref::new(0);
      let local/main/1: Channel[isize] = Channel::new(0);
      'outer: loop {
          if rounds/0.get() == 0 {
              rounds/0.set(1);
              loop {
                  select {
                      recv(channel/1) as local/main/2 => continue,
                      default => break,
                  }
              };
              continue 'outer;
          } else {
              break 'outer 11;
          }
      }
  }

  fn default_break_outer_break() -> isize {
      let local/main/3: Channel[isize] = Channel::new(0);
      'outer: loop {
          loop {
              select {
                  recv(channel/3) as local/main/4 => continue,
                  default => break,
              }
          };
          break 'outer 12;
      }
  }

  fn arm_break_outer_continue() -> isize {
      let local/main/5 = Ref::new(0);
      let local/main/6: Channel[isize] = Channel::new(1);
      channel/6.send(1);
      'outer: loop {
          if rounds/5.get() == 0 {
              rounds/5.set(1);
              loop {
                  select {
                      recv(channel/6) as local/main/7 => break,
                      default => continue,
                  }
              };
              continue 'outer;
          } else {
              break 'outer 13;
          }
      }
  }

  fn arm_break_outer_break() -> isize {
      let local/main/8: Channel[isize] = Channel::new(1);
      channel/8.send(1);
      'outer: loop {
          loop {
              select {
                  recv(channel/8) as local/main/9 => break,
                  default => continue,
              }
          };
          break 'outer 14;
      }
  }

  fn main() -> () {
      println(source:4:main:0());
