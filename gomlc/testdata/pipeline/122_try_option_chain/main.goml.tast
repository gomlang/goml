fn maybe_seed(flag/0: bool) -> Option[i32] {
    if (flag/0 : bool) {
        {
            Option::Some(3)
        }
    } else {
        {
            Option::None
        }
    }
}

fn maybe_double(value/1: i32) -> Option[i32] {
    if (value/1 : i32) > 0 {
        {
            Option::Some((value/1 : i32) * 2)
        }
    } else {
        {
            Option::None
        }
    }
}

fn maybe_total(flag/2: bool) -> Option[i32] {
    let a/3: i32 =
      match (maybe_seed : (bool) -> Option[i32])((flag/2 : bool)) {
          Option::Some(try_value/22: i32) => (try_value/22 : i32),
          Option::None => return Option::None,
      };
    let b/4: i32 =
      match (maybe_double : (i32) -> Option[i32])((a/3 : i32)) {
          Option::Some(try_value/26: i32) => (try_value/26 : i32),
          Option::None => return Option::None,
      };
    Option::Some((a/3 : i32) + (b/4 : i32))
}

fn show(opt/5: Option[i32]) -> string {
    match (opt/5 : Option[i32]) {
        Option::Some(value/6: i32) => "some=" + (i32::to_string : (i32) -> string)((value/6 : i32)),
        Option::None => "none",
    }
}

fn main() -> () {
    (println : (string) -> ())(
      (show : (Option[i32]) -> string)((maybe_total : (bool) -> Option[i32])(true))
    );
    (println : (string) -> ())(
      (show : (Option[i32]) -> string)((maybe_total : (bool) -> Option[i32])(false))
    );
}