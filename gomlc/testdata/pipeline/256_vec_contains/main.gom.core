fn trait_impl#ToString#bool#to_string(self/0: bool) -> string {
  @runtime(core.bool_to_string)(self/0)
}

fn trait_impl#ToString#string#to_string(self/0: string) -> string {
  self/0
}

fn trait_impl#PartialEq#string#eq(self/0: string, other/0: string) -> bool {
  (self/0 == other/0)
}

fn trait_impl#PartialEq#isize#eq(self/0: isize, other/0: isize) -> bool {
  (self/0 == other/0)
}

fn inherent#Vec#Vec[T]#new[T]() -> Vec[T] {
  @intrinsic(vec.new)()
}

fn inherent#Vec#Vec[T]#len[T](self/0: Vec[T]) -> isize {
  @intrinsic(vec.len)(self/0)
}

fn inherent#Vec#Vec[T]#contains[T](self/0: Vec[T], expected/0: T) -> bool {
  let index/0 = 0 in
  let _wild0 =
    while (index/0 < inherent#Vec#Vec[T]#len(self/0)) {
        {
          let _wild1 =
            if trait_call[PartialEq::eq](@intrinsic(vec.get)(self/0, index/0), expected/0) {
                {
                  return true
                }
            } else {
                ()
            } in
          let _wild2 =
            {
              let compound_old0 = index/0 in
              let compound_value0 = 1 in
              index/0 = (compound_old0 + compound_value0)
            } in
        }
    } in
  false
}

fn println[T](value/0: T) -> () {
  @runtime(core.string_println)(trait_call[ToString::to_string](value/0))
}

fn trait_impl#PartialEq#Pair#eq(self/0: Pair, other/0: Pair) -> bool {
  if if true {
      trait_call[PartialEq::eq](Pair.left(self/0), Pair.left(other/0))
  } else {
      false
  } {
      trait_call[PartialEq::eq](Pair.right(self/0), Pair.right(other/0))
  } else {
      false
  }
}

fn contains_any[T](values/0: Vec[T], expected/0: T) -> bool {
  inherent#Vec#Vec[T]#contains(values/0, expected/0)
}

fn main() -> () {
  let values/0 = @intrinsic(vec.from_array)([1, 2, 3]) in
  let _wild0 =
    println(trait_call[ToString::to_string](inherent#Vec#Vec[isize]#contains(values/0, 2))) in
  let _wild1 =
    println(trait_call[ToString::to_string](inherent#Vec#Vec[isize]#contains(values/0, 9))) in
  let names/0 = @intrinsic(vec.from_array)(["alpha", "beta"]) in
  let _wild2 =
    println(trait_call[ToString::to_string](inherent#Vec#Vec[string]#contains(names/0, "beta"))) in
  let pairs/0 = @intrinsic(vec.from_array)([Pair { left: 1, right: 2 }]) in
  let _wild3 =
    println(
      trait_call[ToString::to_string](
        inherent#Vec#Vec[Pair]#contains(pairs/0, Pair { left: 1, right: 2 })
      )
    ) in
  let _wild4 = println(trait_call[ToString::to_string](contains_any(values/0, 3))) in
  let empty/0 = inherent#Vec#Vec[string]#new() in
  println(trait_call[ToString::to_string](inherent#Vec#Vec[string]#contains(empty/0, "x")))
}