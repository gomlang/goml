package main
file main.goml
  #[derive(PartialEq)]
  struct Pair {
      left: isize,
      right: isize,
  }

  impl PartialEq for Pair {
    fn eq(local/main/0: Pair, local/main/1: Pair) -> bool {
        true && PartialEq::eq(self/0.left, other/1.left) &&
          PartialEq::eq(self/0.right, other/1.right)
    }
  }

  fn contains_any[T: PartialEq](local/main/2: Vec[T], local/main/3: T) -> bool {
      values/2.contains(expected/3)
  }

  fn main() -> () {
      let local/main/4 = Vec::from_array([1, 2, 3]);
      println(values/4.contains(2).to_string());
      println(values/4.contains(9).to_string());
      let local/main/5 = Vec::from_array(["alpha", "beta"]);
      println(names/5.contains("beta").to_string());
      let local/main/6 = Vec::from_array([Pair { left: 1, right: 2 }]);
      println(pairs/6.contains(Pair { left: 1, right: 2 }).to_string());
      println(source:4:main:2(values/4, 3).to_string());
      let local/main/7: Vec[string] = Vec::new();
      println(empty/7.contains("x").to_string())
  }