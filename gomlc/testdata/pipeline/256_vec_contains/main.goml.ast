package main;
#[derive(PartialEq)]
struct Pair {
    left: isize,
    right: isize,
}

impl PartialEq for Pair {
  fn eq(self: Pair, other: Pair) -> bool {
      true && PartialEq::eq(self.left, other.left) && PartialEq::eq(self.right, other.right)
  }
}

fn contains_any[T: PartialEq](values: Vec[T], expected: T) -> bool {
    values.contains(expected)
}

fn main() -> () {
    let values = Vec::from_array([1, 2, 3]);
    println(values.contains(2).to_string());
    println(values.contains(9).to_string());
    let names = Vec::from_array(["alpha", "beta"]);
    println(names.contains("beta").to_string());
    let pairs = Vec::from_array([Pair { left: 1, right: 2 }]);
    println(pairs.contains(Pair { left: 1, right: 2 }).to_string());
    println(contains_any(values, 3).to_string());
    let empty: Vec[string] = Vec::new();
    println(empty.contains("x").to_string())
}

