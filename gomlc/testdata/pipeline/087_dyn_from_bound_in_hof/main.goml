trait Display {
    fn show(self: Self) -> string;
}

impl Display for i32 {
    fn show(self: i32) -> string {
        self.to_string()
    }
}

fn mk_renderer[T: Display](x: T) -> () -> string {
    let d: dyn Display = x as dyn Display;
    || Display::show(d)
}

fn main() {
    let value: i32 = 42;
    let f = mk_renderer(value);
    println(f());
}
