impl Display for i32 {
  fn show(self/0: i32) -> string {
      (i32::to_string : (i32) -> string)((self/0 : i32))
  }
}

fn mk_renderer[T](x/1: T) -> () -> string where T: Display {
    let d/2: dyn Display = to_dyn[Display]{T}((x/1 : T));
    || => (dyn Display::show : (dyn Display) -> string)((d/2 : dyn Display))
}

fn main() -> () {
    let value/3: i32 = 42;
    let f/4: () -> string = (mk_renderer : (i32) -> () -> string)((value/3 : i32));
    (println : (string) -> ())((f/4 : () -> string)());
}