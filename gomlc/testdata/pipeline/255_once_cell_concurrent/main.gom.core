static VALUE: OnceCell[isize] = OnceCell::new();

fn trait_impl#ToString#bool#to_string(self/0: bool) -> string {
  @runtime(core.bool_to_string)(self/0)
}

fn trait_impl#ToString#string#to_string(self/0: string) -> string {
  self/0
}

fn inherent#OnceCell#OnceCell[T]#get_or_init[T](self/0: OnceCell[T], init/0: () -> T) -> T {
  @intrinsic(once_cell.get_or_init)(self/0, init/0)
}

fn inherent#Channel#Channel[T]#new[T](capacity/0: isize) -> Channel[T] {
  @intrinsic(channel.new)(capacity/0)
}

fn inherent#Channel#Channel[T]#send[T](self/0: Channel[T], value/0: T) -> () {
  @intrinsic(channel.send)(self/0, value/0)
}

fn inherent#Channel#Channel[T]#recv[T](self/0: Channel[T]) -> Option[T] {
  let mtmp0 = @intrinsic(channel.recv)(self/0) in
  {
    let x0 = mtmp0.0 in
    let x1 = mtmp0.1 in
    {
      let ok/0 = x1 in
      {
        let value/0 = x0 in
        {
          if ok/0 {
              {
                Option::Some(value/0)
              }
          } else {
              {
                Option::None
              }
          }
        }
      }
    }
  }
}

fn inherent#Option#Option[T]#unwrap_or[T](self/0: Option[T], fallback/0: T) -> T {
  match self/0 {
    Option::None => {
      fallback/0
    },
    Option::Some(x0) => {
      {
        let x0 = Option::Some._0(self/0) in
        {
          let value/0 = x0 in
          value/0
        }
      }
    },
  }
}

fn println[T](value/0: T) -> () {
  @runtime(core.string_println)(trait_call[ToString::to_string](value/0))
}

fn main() -> () {
  let results/0 = inherent#Channel#Channel[isize]#new(2) in
  let _wild0 =
    go || => inherent#Channel#Channel[isize]#send(
      results/0,
      inherent#OnceCell#OnceCell[isize]#get_or_init(VALUE, || => 41)
    ) in
  let _wild1 =
    go || => inherent#Channel#Channel[isize]#send(
      results/0,
      inherent#OnceCell#OnceCell[isize]#get_or_init(VALUE, || => 42)
    ) in
  let first/0 =
    inherent#Option#Option[isize]#unwrap_or(inherent#Channel#Channel[isize]#recv(results/0), 0) in
  let second/0 =
    inherent#Option#Option[isize]#unwrap_or(inherent#Channel#Channel[isize]#recv(results/0), 0) in
  println(trait_call[ToString::to_string]((first/0 == second/0)))
}