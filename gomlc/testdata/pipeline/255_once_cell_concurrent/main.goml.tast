static VALUE: OnceCell[isize] = OnceCell::new();

fn main() -> () {
    let results/0: Channel[isize] = (Channel[isize]::new : (isize) -> Channel[isize])(2);
    go || =>
      (Channel[isize]::send : (Channel[isize], isize) -> ())(
        (results/0 : Channel[isize]),
        (OnceCell[isize]::get_or_init : (OnceCell[isize], () -> isize) -> isize)(
          (VALUE : OnceCell[isize]),
          || => 41
        )
      );
    go || =>
      (Channel[isize]::send : (Channel[isize], isize) -> ())(
        (results/0 : Channel[isize]),
        (OnceCell[isize]::get_or_init : (OnceCell[isize], () -> isize) -> isize)(
          (VALUE : OnceCell[isize]),
          || => 42
        )
      );
    let first/1: isize =
      (Option[isize]::unwrap_or : (Option[isize], isize) -> isize)(
        (Channel[isize]::recv : (Channel[isize]) -> Option[isize])((results/0 : Channel[isize])),
        0
      );
    let second/2: isize =
      (Option[isize]::unwrap_or : (Option[isize], isize) -> isize)(
        (Channel[isize]::recv : (Channel[isize]) -> Option[isize])((results/0 : Channel[isize])),
        0
      );
    (println : (string) -> ())(
      (ToString::to_string : (bool) -> string)((first/1 : isize) == (second/2 : isize))
    )
}