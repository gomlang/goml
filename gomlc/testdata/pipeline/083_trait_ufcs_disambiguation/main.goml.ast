package main;
trait A {
  fn pick(self: Self) -> i32;
}

trait B {
  fn pick(self: Self) -> i32;
}

struct S {}

impl A for S {
  fn pick(self: S) -> i32 {
      10
  }
}

impl B for S {
  fn pick(self: S) -> i32 {
      20
  }
}

fn pick_a[T: A + B](x: T) -> i32 {
    A::pick(x)
}

fn pick_b[T: A + B](x: T) -> i32 {
    B::pick(x)
}

fn main() {
    println(pick_a(S {}).to_string());
    println(pick_b(S {}).to_string());
}

