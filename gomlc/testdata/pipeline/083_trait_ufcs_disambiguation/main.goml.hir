package main
file main.goml
  trait A {
    fn pick(Self) -> i32;
  }

  trait B {
    fn pick(Self) -> i32;
  }

  struct S {}

  impl A for S {
    fn pick(local/1/0: S) -> i32 {
        10
    }
  }

  impl B for S {
    fn pick(local/1/1: S) -> i32 {
        20
    }
  }

  fn pick_a[T: A + B](local/1/2: T) -> i32 {
      A::pick(x/2)
  }

  fn pick_b[T: A + B](local/1/3: T) -> i32 {
      B::pick(x/3)
  }

  fn main() {
      println(def/1/5(S {}).to_string());
      println(def/1/6(S {}).to_string());
  }