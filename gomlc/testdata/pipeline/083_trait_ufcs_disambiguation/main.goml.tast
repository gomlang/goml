impl A for S {
  fn pick(self/0: S) -> i32 {
      10
  }
}

impl B for S {
  fn pick(self/1: S) -> i32 {
      20
  }
}

fn pick_a[T](x/2: T) -> i32 where T: A, T: B {
    (A::pick : (T) -> i32)((x/2 : T))
}

fn pick_b[T](x/3: T) -> i32 where T: A, T: B {
    (B::pick : (T) -> i32)((x/3 : T))
}

fn main() -> () {
    (println : (string) -> ())((i32::to_string : (i32) -> string)((pick_a : (S) -> i32)(S {})));
    (println : (string) -> ())((i32::to_string : (i32) -> string)((pick_b : (S) -> i32)(S {})));
}