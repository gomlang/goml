package main
file main.goml
  trait Diamond: Left + Right {
    fn diamond(Self) -> string;
  }

  trait Left: Base {
    fn left(Self) -> string;
  }

  trait Right: Base {
    fn right(Self) -> string;
  }

  trait Base {
    fn base(Self) -> string;
  }

  struct Value {}

  impl Base for Value {
    fn base(local/main/0: Value) -> string {
        "B"
    }
  }

  impl Left for Value {
    fn left(local/main/1: Value) -> string {
        "L"
    }
  }

  impl Right for Value {
    fn right(local/main/2: Value) -> string {
        "R"
    }
  }

  impl Diamond for Value {
    fn diamond(local/main/3: Value) -> string {
        "D"
    }
  }

  fn describe[T: Diamond](local/main/4: T) -> string {
      value/4.base() + value/4.left() + value/4.right() + value/4.diamond()
  }

  fn main() -> () {
      println(source:4:main:9(Value {}));
  }