package main
file main.goml
  enum Maybe[T] {
      None,
      Some(T)
  }

  impl[T] Maybe[T] {
    fn map[U](local/1/0: Maybe[T], local/1/1: (T) -> U) -> Maybe[U] {
        match self/0 {
            ctor(def/1/0::v1)(local/1/2) => ctor(def/1/0::v1)(map_fn/1(value/2)),
            ctor(def/1/0::v0) => ctor(def/1/0::v0),
        }
    }
  }

  fn main() {
      let local/1/3: Maybe[isize] = ctor(def/1/0::v1)(3);
      match value/3.map(|local/1/4: isize| item/4.to_string()) {
          ctor(def/1/0::v1)(local/1/5) => println(text/5),
          ctor(def/1/0::v0) => println("none"),
      }
  }