impl[T] Maybe[T] {
  fn map[U](self/0: Maybe[T], map_fn/1: (T) -> U) -> Maybe[U] {
      match (self/0 : Maybe[T]) {
          Maybe::Some(value/2: T) => Maybe::Some((map_fn/1 : (T) -> U)((value/2 : T))),
          Maybe::None => Maybe::None,
      }
  }
}

fn main() -> () {
    let value/3: Maybe[isize] = Maybe::Some(3);
    match (Maybe[isize]::map : (Maybe[isize], (isize) -> string) -> Maybe[string])(
      (value/3 : Maybe[isize]),
      |item/4: isize| => (isize::to_string : (isize) -> string)((item/4 : isize))
    ) {
        Maybe::Some(text/5: string) => (println : (string) -> ())((text/5 : string)),
        Maybe::None => (println : (string) -> ())("none"),
    }
}