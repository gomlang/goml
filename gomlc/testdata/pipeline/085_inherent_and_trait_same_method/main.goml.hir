package main
file main.goml
  trait Render {
    fn format(Self) -> string;
  }

  struct Boxed {
      value: i32,
  }

  impl Boxed {
    fn format(local/main/0: Self) -> string {
        "inherent"
    }
  }

  impl Render for Boxed {
    fn format(local/main/1: Boxed) -> string {
        self/1.value.to_string()
    }
  }

  fn main() {
      println(Boxed::format(Boxed { value: 9 }));
      println(Render::format(Boxed { value: 9 }));
  }