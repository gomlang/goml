impl Boxed {
  fn format(self/0: Boxed) -> string {
      "inherent"
  }
}

impl Render for Boxed {
  fn format(self/1: Boxed) -> string {
      (i32::to_string : (i32) -> string)((self/1 : Boxed).value)
  }
}

fn main() -> () {
    (println : (string) -> ())((Boxed::format : (Boxed) -> string)(Boxed { value: 9 }));
    (println : (string) -> ())((Render::format : (Boxed) -> string)(Boxed { value: 9 }));
}