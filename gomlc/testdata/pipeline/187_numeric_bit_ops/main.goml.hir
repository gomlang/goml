  fn unsigned_ops() -> () {
      def/1/0(13 % 5);
      def/1/0(12 & 10);
      def/1/0(12 | 3);
      def/1/0(12 ^ 10);
      def/1/0(1 << 7);
      def/1/0(128 >> 7);
      def/1/0(~0);
      def/1/0(1 << 8);
      def/1/1(513 % 256);
      def/1/1(3855 & 255);
      def/1/1(3840 | 15);
      def/1/1(43690 ^ 3855);
      def/1/1(1 << 15);
      def/1/1(32768 >> 15);
      def/1/1(~0);
      def/1/2(1000000001 % 1000);
      def/1/2(4042322160 & 252645135);
      def/1/2(4042322160 | 252645135);
      def/1/2(4042322160 ^ 252645135);
      def/1/2(1 << 31);
      def/1/2(2147483648 >> 31);
      def/1/2(~0);
      def/1/3(1000000000001 % 1000);
      def/1/3(17361641481138401520 & 1085102592571150095);
      def/1/3(17361641481138401520 | 1085102592571150095);
      def/1/3(17361641481138401520 ^ 1085102592571150095);
      def/1/3(1 << 63);
      def/1/3(9223372036854775808 >> 63);
      def/1/3(~0)
  }

  fn signed_ops() -> () {
      def/1/4(-13 % 5);
      def/1/4(-8 >> 2);
      def/1/4(1 << 6);
      def/1/4(~0);
      def/1/4(-1 >> 7);
      def/1/5(-513 % 256);
      def/1/5(-32767 - 1 >> 15);
      def/1/5(1 << 14);
      def/1/5(~255);
      def/1/6(-1000000001 % 1000);
      def/1/6(-2147483647 - 1 >> 31);
      def/1/6(1 << 30);
      def/1/6(~65535);
      def/1/7(-1000000000001 % 1000);
      def/1/7(-9223372036854775807 >> 62);
      def/1/7(1 << 62);
      def/1/7(~4294967295)
  }

  fn precedence() -> () {
      def/1/0(1 | 2 ^ 3 & 1);
      def/1/0(1 << 2 + 1);
      println(1 | 2 == 3.to_string());
      println(8 >> 1 < 5.to_string());
      def/1/0(~1 & 15)
  }

