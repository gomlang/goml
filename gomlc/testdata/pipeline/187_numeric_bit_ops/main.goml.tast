    let negative_one_i32/15: i32 = -1;
    let negative_one_i8/16: i8 = -1;
    let max_u64/17: u64 = 18446744073709551615;
    let sixty_five/18: u8 = 65;
    let max_u32/19: u32 = 4294967295;
