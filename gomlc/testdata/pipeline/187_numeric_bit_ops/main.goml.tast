fn casts() -> () {
    let five_eleven/8: u16 = 511;
    let two_fifty_six/9: u16 = 256;
    let negative_one_i16/10: i16 = -1;
    let two_fifty_five/11: u8 = 255;
    let one_twenty_eight/12: u8 = 128;
    let negative_one_twenty_nine/13: i16 = -129;
