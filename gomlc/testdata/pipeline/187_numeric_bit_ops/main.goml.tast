    (show_u8 : (u8) -> ())((u16::to_u8 : (u16) -> u8)((five_eleven/8 : u16)));
    (show_u8 : (u8) -> ())((u16::to_u8 : (u16) -> u8)((two_fifty_six/9 : u16)));
    (show_u8 : (u8) -> ())((i16::to_u8 : (i16) -> u8)((negative_one_i16/10 : i16)));
    (show_i8 : (i8) -> ())((u8::to_i8 : (u8) -> i8)((two_fifty_five/11 : u8)));
    (show_i8 : (i8) -> ())((u8::to_i8 : (u8) -> i8)((one_twenty_eight/12 : u8)));
    (show_i8 : (i8) -> ())((i16::to_i8 : (i16) -> i8)((negative_one_twenty_nine/13 : i16)));
    (show_i16 : (i16) -> ())((u16::to_i16 : (u16) -> i16)((max_u16/14 : u16)));
    (show_u16 : (u16) -> ())((i32::to_u16 : (i32) -> u16)((negative_one_i32/15 : i32)));
    (show_u64 : (u64) -> ())((i8::to_u64 : (i8) -> u64)((negative_one_i8/16 : i8)));
    (show_i32 : (i32) -> ())((u64::to_i32 : (u64) -> i32)((max_u64/17 : u64)));
    (show_u32 : (u32) -> ())((u8::to_u32 : (u8) -> u32)((sixty_five/18 : u8)));
    (show_i64 : (i64) -> ())((u32::to_i64 : (u32) -> i64)((max_u32/19 : u32)));
    (show_u32 : (u32) -> ())((char::to_u32 : (char) -> u32)('A'));
    match (char_from_u32 : (u32) -> Option[char])(128512) {
        Option::Some(value/21: char) =>
          (println : (string) -> ())((char::to_string : (char) -> string)((value/21 : char))),
        Option::None => (println : (string) -> ())("invalid"),
    };
    (show_u32 : (u32) -> ())(
      (u8::to_u32 : (u8) -> u32)((u16::to_u8 : (u16) -> u8)((three_hundred/20 : u16)))
    )
}

fn contextual(value/22: u8) -> u8 {
    ~(value/22 : u8) & 15 | 1 << 4 % 31
}

