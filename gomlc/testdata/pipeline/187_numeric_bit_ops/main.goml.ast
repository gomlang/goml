package main;
fn show_u8(value: u8) -> () {
    println(value)
}

fn show_u16(value: u16) -> () {
    println(value)
}

fn show_u32(value: u32) -> () {
    println(value)
}

fn show_u64(value: u64) -> () {
    println(value)
}

fn show_i8(value: i8) -> () {
    println(value)
}

fn show_i16(value: i16) -> () {
    println(value)
}

fn show_i32(value: i32) -> () {
    println(value)
}

fn show_i64(value: i64) -> () {
    println(value)
}

fn unsigned_ops() -> () {
    show_u8(13 % 5);
    show_u8(12 & 10);
    show_u8(12 | 3);
    show_u8(12 ^ 10);
    show_u8(1 << 7);
    show_u8(128 >> 7);
    show_u8(~0);
    show_u8(1 << 8);
    show_u16(513 % 256);
    show_u16(3855 & 255);
    show_u16(3840 | 15);
    show_u16(43690 ^ 3855);
    show_u16(1 << 15);
    show_u16(32768 >> 15);
    show_u16(~0);
    show_u32(1000000001 % 1000);
    show_u32(4042322160 & 252645135);
    show_u32(4042322160 | 252645135);
    show_u32(4042322160 ^ 252645135);
    show_u32(1 << 31);
    show_u32(2147483648 >> 31);
    show_u32(~0);
    show_u64(1000000000001 % 1000);
    show_u64(17361641481138401520 & 1085102592571150095);
    show_u64(17361641481138401520 | 1085102592571150095);
    show_u64(17361641481138401520 ^ 1085102592571150095);
    show_u64(1 << 63);
    show_u64(9223372036854775808 >> 63);
    show_u64(~0)
}

fn signed_ops() -> () {
    show_i8(-13 % 5);
    show_i8(-8 >> 2);
    show_i8(1 << 6);
    show_i8(~0);
    show_i8(-1 >> 7);
    show_i16(-513 % 256);
    show_i16(-32767 - 1 >> 15);
    show_i16(1 << 14);
    show_i16(~255);
    show_i32(-1000000001 % 1000);
    show_i32(-2147483647 - 1 >> 31);
    show_i32(1 << 30);
    show_i32(~65535);
    show_i64(-1000000000001 % 1000);
    show_i64(-9223372036854775807 >> 62);
    show_i64(1 << 62);
    show_i64(~4294967295)
}

fn precedence() -> () {
    show_u8(1 | 2 ^ 3 & 1);
    show_u8(1 << 2 + 1);
    println(1 | 2 == 3.to_string());
    println(8 >> 1 < 5.to_string());
    show_u8(~1 & 15)
}

fn casts() -> () {
    let five_eleven: u16 = 511;
    let two_fifty_six: u16 = 256;
    let negative_one_i16: i16 = -1;
    let two_fifty_five: u8 = 255;
    let one_twenty_eight: u8 = 128;
    let negative_one_twenty_nine: i16 = -129;
    let max_u16: u16 = 65535;
    let negative_one_i32: i32 = -1;
    let negative_one_i8: i8 = -1;
    let max_u64: u64 = 18446744073709551615;
    let sixty_five: u8 = 65;
    let max_u32: u32 = 4294967295;
    let three_hundred: u16 = 300;
    show_u8(five_eleven.to_u8());
    show_u8(two_fifty_six.to_u8());
    show_u8(negative_one_i16.to_u8());
    show_i8(two_fifty_five.to_i8());
    show_i8(one_twenty_eight.to_i8());
    show_i8(negative_one_twenty_nine.to_i8());
    show_i16(max_u16.to_i16());
    show_u16(negative_one_i32.to_u16());
    show_u64(negative_one_i8.to_u64());
    show_i32(max_u64.to_i32());
    show_u32(sixty_five.to_u32());
    show_i64(max_u32.to_i64());
    show_u32('A'.to_u32());
    match char_from_u32(128512) {
        Option::Some(value) => println(value.to_string()),
        Option::None => println("invalid"),
    };
    show_u32(three_hundred.to_u8().to_u32())
}

fn contextual(value: u8) -> u8 {
    ~value & 15 | 1 << 4 % 31
}

fn main() -> () {
    unsigned_ops();
    signed_ops();
    precedence();
    casts();
    show_u8(contextual(10))
}

