fn make_some(value/0: i32) -> Maybe[i32] {
    Maybe::Some((value/0 : i32))
}

fn build_point(x/1: i32, y/2: i32) -> Point {
    Point { x: (x/1 : i32), y: (y/2 : i32) }
}

fn magnitude(p/3: Point) -> i32 {
    let Point { x: x/4: i32, y: y/5: i32 } = (p/3 : Point);
    (x/4 : i32) + (y/5 : i32)
}

fn main() -> i32 {
    match (make_some : (i32) -> Maybe[i32])(5) {
        Maybe::Some(result/6: i32) =>
          {
              let pt/7: Point = (build_point : (i32, i32) -> Point)((result/6 : i32), 7);
              match Maybe::Some((pt/7 : Point).x) {
                  Maybe::Some(value/8: i32) =>
                    (value/8 : i32) + (magnitude : (Point) -> i32)((pt/7 : Point)),
                  Maybe::None => 0,
              }
          },
        Maybe::None => 0,
    }
}