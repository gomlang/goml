fn make_some(value/0: i32) -> Maybe__i32 {
  Maybe__i32::Some(value/0)
}

fn build_point(x/0: i32, y/0: i32) -> Point {
  Point { x: x/0, y: y/0 }
}

fn magnitude(p/0: Point) -> i32 {
  let mtmp0 = p/0 in
  {
    let x0 = Point.x(mtmp0) in
    let x1 = Point.y(mtmp0) in
    {
      let y/0 = x1 in
      {
        let x/0 = x0 in
        {
          (x/0 + y/0)
        }
      }
    }
  }
}

fn main() -> i32 {
  {
    let mtmp0 = make_some(5) in
    match mtmp0 {
      Maybe__i32::Some(x0) => {
        {
          let x0 = Maybe__i32::Some._0(mtmp0) in
          {
            let result/0 = x0 in
            {
              let pt/0 = build_point(result/0, 7) in
              {
                let mtmp1 = Maybe__i32::Some(Point.x(pt/0)) in
                match mtmp1 {
                  Maybe__i32::Some(x1) => {
                    {
                      let x1 = Maybe__i32::Some._0(mtmp1) in
                      {
                        let value/0 = x1 in
                        (value/0 + magnitude(pt/0))
                      }
                    }
                  },
                  Maybe__i32::None => {
                    0
                  },
                }
              }
            }
          }
        }
      },
      Maybe__i32::None => {
        0
      },
    }
  }
}