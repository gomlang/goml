enum Maybe[T] {
    Some(T),
    None,
}

struct Point {
    x: i32,
    y: i32,
}

fn make_some(value: i32) -> Maybe[i32] {
    Some(value)
}

fn build_point(x: i32, y: i32) -> Point {
    Point { x: x, y: y }
}

fn magnitude(p: Point) -> i32 {
    let Point { x, y } = p;
    x + y
}

fn main() -> i32 {
    match make_some(5) {
        Some(result) => {
            let pt = build_point(result, 7);
            match Some(pt.x) {
                Some(value) => value + magnitude(pt),
                None => 0,
            }
        },
        None => 0,
    }
}
