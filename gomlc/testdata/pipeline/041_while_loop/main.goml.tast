fn sum_to(limit/0: i32) -> i32 {
    let acc/1: Ref[i32] = (Ref[i32]::new : (i32) -> Ref[i32])(0);
    let i/2: Ref[i32] = (Ref[i32]::new : (i32) -> Ref[i32])(0);
    let _ : () =
      while (Ref[i32]::get : (Ref[i32]) -> i32)((i/2 : Ref[i32])) < (limit/0 : i32) {
          {
              let current/3: i32 = (Ref[i32]::get : (Ref[i32]) -> i32)((i/2 : Ref[i32]));
              let _ : () =
                (Ref[i32]::set : (Ref[i32], i32) -> ())(
                  (acc/1 : Ref[i32]),
                  (Ref[i32]::get : (Ref[i32]) -> i32)((acc/1 : Ref[i32])) + (current/3 : i32)
                );
              let _ : () =
                (Ref[i32]::set : (Ref[i32], i32) -> ())((i/2 : Ref[i32]), (current/3 : i32) + 1);
          }
      };
    (Ref[i32]::get : (Ref[i32]) -> i32)((acc/1 : Ref[i32]))
}

fn sum_even(limit/4: i32) -> i32 {
    let acc/5: Ref[i32] = (Ref[i32]::new : (i32) -> Ref[i32])(0);
    let i/6: Ref[i32] = (Ref[i32]::new : (i32) -> Ref[i32])(0);
    let is_even/7: Ref[bool] = (Ref[bool]::new : (bool) -> Ref[bool])(true);
    let _ : () =
      while (Ref[i32]::get : (Ref[i32]) -> i32)((i/6 : Ref[i32])) < (limit/4 : i32) {
          {
              let current/8: i32 = (Ref[i32]::get : (Ref[i32]) -> i32)((i/6 : Ref[i32]));
              let _ : () =
                (Ref[i32]::set : (Ref[i32], i32) -> ())((i/6 : Ref[i32]), (current/8 : i32) + 1);
              let add_now/9: bool = (Ref[bool]::get : (Ref[bool]) -> bool)((is_even/7 : Ref[bool]));
              let _ : () =
                (Ref[bool]::set : (Ref[bool], bool) -> ())(
                  (is_even/7 : Ref[bool]),
                  !(add_now/9 : bool)
                );
              if (add_now/9 : bool) {
                  {
                      (Ref[i32]::set : (Ref[i32], i32) -> ())(
                        (acc/5 : Ref[i32]),
                        (Ref[i32]::get : (Ref[i32]) -> i32)((acc/5 : Ref[i32])) + (current/8 : i32)
                      )
                  }
              } else {
                  {}
              }
          }
      };
    (Ref[i32]::get : (Ref[i32]) -> i32)((acc/5 : Ref[i32]))
}

fn main() -> () {
    let first/10: i32 = (sum_to : (i32) -> i32)(5);
    let evens/11: i32 = (sum_even : (i32) -> i32)(6);
    let _ : () = (print : (string) -> ())("sum_to(5)=");
    let _ : () = (println : (i32) -> ())((first/10 : i32));
    let _ : () = (print : (string) -> ())("sum_even(6)=");
    let _ : () = (println : (i32) -> ())((evens/11 : i32));
}