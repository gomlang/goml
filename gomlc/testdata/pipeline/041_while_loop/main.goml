fn sum_to(limit: i32) -> i32 {
    let acc = Ref::new(0);
    let i = Ref::new(0);
    let _ = (while i.get() < limit {
        let current = i.get();
        let _ = acc.set(acc.get() + current);
        let _ = i.set(current + 1);
    });
    acc.get()
}

fn sum_even(limit: i32) -> i32 {
    let acc = Ref::new(0);
    let i = Ref::new(0);
    let is_even = Ref::new(true);
    let _ = (while i.get() < limit {
        let current = i.get();
        let _ = i.set(current + 1);
        let add_now = is_even.get();
        let _ = is_even.set(!add_now);
        if add_now {
            acc.set(acc.get() + current)
        } else {}
    });
    acc.get()
}

fn main() {
    let first = sum_to(5);
    let evens = sum_even(6);
    let _ = print("sum_to(5)=");
    let _ = println(first);
    let _ = print("sum_even(6)=");
    let _ = println(evens);
}
