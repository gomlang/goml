package main;
trait Display {
  fn display(self: Self) -> string;
}

trait Source {
  type Item;
  fn get(self: Self) -> Self::Item;
}

struct Number {
    value: isize,
}

impl Display for Number {
  fn display(self: Number) -> string {
      self.value.to_string()
  }
}

impl Source for Number {
  type Item = isize;
  fn get(self: Number) -> isize {
      self.value
  }
}

fn erase[T: Display](value: T) -> dyn Display {
    value as dyn Display
}

fn main() -> () {
    let display = Number { value: 42 } as dyn Display;
    println(display.display());
    let erased = erase(Number { value: 7 });
    println(erased.display());
    let source = Number { value: 11 } as dyn Source[Item = isize];
    println(source.get());
    let same = Number { value: 13 } as dyn Display as dyn Display;
    println(same.display())
}

