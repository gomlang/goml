fn step(ok/0: bool) -> Result[(), string] {
    if (ok/0 : bool) {
        {
            Result::Ok(())
        }
    } else {
        {
            Result::Err("step failed")
        }
    }
}

fn run(ok/1: bool) -> Result[(), string] {
    let _ : () =
      match (step : (bool) -> Result[(), string])((ok/1 : bool)) {
          Result::Ok(try_value/12: ()) => (try_value/12 : ()),
          Result::Err(try_residual/12: string) => return Result::Err((try_residual/12 : string)),
      };
    Result::Ok(())
}

fn show(res/2: Result[(), string]) -> string {
    match (res/2 : Result[(), string]) {
        Result::Ok(()) => "ok ()",
        Result::Err(err/3: string) => "err " + (err/3 : string),
    }
}

fn main() -> () {
    (println : (string) -> ())(
      (show : (Result[(), string]) -> string)((run : (bool) -> Result[(), string])(true))
    );
    (println : (string) -> ())(
      (show : (Result[(), string]) -> string)((run : (bool) -> Result[(), string])(false))
    );
}