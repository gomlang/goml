package main;
fn step(ok: bool) -> Result[(), string] {
    if ok {
        {
            Result::Ok(())
        }
    } else {
        {
            Result::Err("step failed")
        }
    }
}

fn run(ok: bool) -> Result[(), string] {
    let _ = step(ok)?;
    Result::Ok(())
}

fn show(res: Result[(), string]) -> string {
    match res {
        Result::Ok(()) => "ok ()",
        Result::Err(err) => "err " + err,
    }
}

fn main() -> () {
    println(show(run(true)));
    println(show(run(false)));
}

