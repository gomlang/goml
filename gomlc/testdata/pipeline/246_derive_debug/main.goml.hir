package main
file main.goml
  #[derive(Debug)]
  struct Point {
      x: i32,
      label: string,
  }

  impl Debug for Point {
    fn debug(local/main/0: Point) -> string {
        {
            let Point { x: local/main/1, label: local/main/2 } = self/0;
            "Point { " + "x: " + Debug::debug(#derive0_field/1) + ", " + "label: " +
              Debug::debug(#derive1_field/2) +
              " }"
        }
    }
  }

  #[derive(Debug)]
  enum State[T] {
      Idle,
      Value(T),
      Named { value: T }
  }

  impl[T] Debug for State[T] where T: Debug {
    fn debug(local/main/3: State[T]) -> string {
        match self/3 {
            ctor(source:4:main:2::v0) => "State::Idle",
            ctor(source:4:main:2::v1)(local/main/4) =>
              "State::Value(" + Debug::debug(#derive0_field/4) + ")",
            ctor(source:4:main:2::v2) { value: local/main/5 } =>
              "State::Named { " + "value: " + Debug::debug(#derive1_field/5) + " }",
        }
    }
  }

  fn debug_dyn(local/main/6: dyn Debug) -> string {
      value/6.debug()
  }

  fn main() -> () {
      let local/main/7 = Point { x: 3, label: "east" };
      let local/main/8: State[i32] = ctor(source:4:main:2::v0);
      let local/main/9 = ctor(source:4:main:2::v1)(point/7);
      let local/main/10 = State::Named { value: 7 };
      println(point/7.debug());
      println(idle/8.debug());
      println(value/9.debug());
      println(Debug::debug(named/10));
      println(source:4:main:4(9 as dyn Debug))
  }