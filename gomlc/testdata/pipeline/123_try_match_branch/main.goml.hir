package main
file main.goml
  enum Choice {
      Left(bool),
      Right(bool),
      Keep(i32)
  }

  fn read_left(local/main/0: bool) -> Result[i32, string] {
      if ok/0 {
          Result::Ok(10)
      } else {
          Result::Err("left failed")
      }
  }

  fn read_right(local/main/1: bool) -> Result[i32, string] {
      if ok/1 {
          Result::Ok(20)
      } else {
          Result::Err("right failed")
      }
  }

  fn choose(local/main/2: Choice) -> Result[i32, string] {
      let local/main/6 =
        match choice/2 {
            ctor(source:4:main:0::v0)(local/main/3) => source:4:main:1(ok/3)?,
            ctor(source:4:main:0::v1)(local/main/4) => source:4:main:2(ok/4)? + 1,
            ctor(source:4:main:0::v2)(local/main/5) => value/5,
        };
      Result::Ok(value/6)
  }

  fn show(local/main/7: Result[i32, string]) -> string {
      match res/7 {
          Result::Ok(local/main/8) => "ok " + value/8.to_string(),
          Result::Err(local/main/9) => "err " + err/9,
      }
  }

  fn main() -> () {
      println(source:4:main:4(source:4:main:3(ctor(source:4:main:0::v0)(true))));
      println(source:4:main:4(source:4:main:3(ctor(source:4:main:0::v1)(true))));
      println(source:4:main:4(source:4:main:3(ctor(source:4:main:0::v2)(5))));
      println(source:4:main:4(source:4:main:3(ctor(source:4:main:0::v0)(false))));
      println(source:4:main:4(source:4:main:3(ctor(source:4:main:0::v1)(false))));
  }