package main;
enum Choice {
    Left(bool),
    Right(bool),
    Keep(i32)
}

fn read_left(ok: bool) -> Result[i32, string] {
    if ok {
        {
            Result::Ok(10)
        }
    } else {
        {
            Result::Err("left failed")
        }
    }
}

fn read_right(ok: bool) -> Result[i32, string] {
    if ok {
        {
            Result::Ok(20)
        }
    } else {
        {
            Result::Err("right failed")
        }
    }
}

fn choose(choice: Choice) -> Result[i32, string] {
    let value =
      match choice {
          Choice::Left(ok) => read_left(ok)?,
          Choice::Right(ok) => read_right(ok)? + 1,
          Choice::Keep(value) => value,
      };
    Result::Ok(value)
}

fn show(res: Result[i32, string]) -> string {
    match res {
        Result::Ok(value) => "ok " + value.to_string(),
        Result::Err(err) => "err " + err,
    }
}

fn main() -> () {
    println(show(choose(Choice::Left(true))));
    println(show(choose(Choice::Right(true))));
    println(show(choose(Choice::Keep(5))));
    println(show(choose(Choice::Left(false))));
    println(show(choose(Choice::Right(false))));
}

