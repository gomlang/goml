fn read_left(ok/0: bool) -> Result[i32, string] {
    if (ok/0 : bool) {
        {
            Result::Ok(10)
        }
    } else {
        {
            Result::Err("left failed")
        }
    }
}

fn read_right(ok/1: bool) -> Result[i32, string] {
    if (ok/1 : bool) {
        {
            Result::Ok(20)
        }
    } else {
        {
            Result::Err("right failed")
        }
    }
}

fn choose(choice/2: Choice) -> Result[i32, string] {
    let value/6: i32 =
      match (choice/2 : Choice) {
          Choice::Left(ok/3: bool) =>
            match (read_left : (bool) -> Result[i32, string])((ok/3 : bool)) {
                Result::Ok(try_value/21: i32) => (try_value/21 : i32),
                Result::Err(try_residual/21: string) =>
                  return Result::Err((try_residual/21 : string)),
            },
          Choice::Right(ok/4: bool) =>
            match (read_right : (bool) -> Result[i32, string])((ok/4 : bool)) {
                Result::Ok(try_value/25: i32) => (try_value/25 : i32),
                Result::Err(try_residual/25: string) =>
                  return Result::Err((try_residual/25 : string)),
            } +
              1,
          Choice::Keep(value/5: i32) => (value/5 : i32),
      };
    Result::Ok((value/6 : i32))
}

fn show(res/7: Result[i32, string]) -> string {
    match (res/7 : Result[i32, string]) {
        Result::Ok(value/8: i32) => "ok " + (i32::to_string : (i32) -> string)((value/8 : i32)),
        Result::Err(err/9: string) => "err " + (err/9 : string),
    }
}

fn main() -> () {
    (println : (string) -> ())(
      (show : (Result[i32, string]) -> string)(
        (choose : (Choice) -> Result[i32, string])(Choice::Left(true))
      )
    );
    (println : (string) -> ())(
      (show : (Result[i32, string]) -> string)(
        (choose : (Choice) -> Result[i32, string])(Choice::Right(true))
      )
    );
    (println : (string) -> ())(
      (show : (Result[i32, string]) -> string)(
        (choose : (Choice) -> Result[i32, string])(Choice::Keep(5))
      )
    );
    (println : (string) -> ())(
      (show : (Result[i32, string]) -> string)(
        (choose : (Choice) -> Result[i32, string])(Choice::Left(false))
      )
    );
    (println : (string) -> ())(
      (show : (Result[i32, string]) -> string)(
        (choose : (Choice) -> Result[i32, string])(Choice::Right(false))
      )
    );
}