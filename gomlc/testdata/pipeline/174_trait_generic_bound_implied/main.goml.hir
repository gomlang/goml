package main
file main.goml
  trait Mark {
    fn mark(Self) -> string;
  }

  trait Container[T: Mark] {
    fn value(Self) -> T;
  }

  struct NumberBox {
      value: i32,
  }

  impl Mark for i32 {
    fn mark(local/1/0: i32) -> string {
        "marked:" + self/0.to_string()
    }
  }

  impl Container[i32] for NumberBox {
    fn value(local/1/1: NumberBox) -> i32 {
        self/1.value
    }
  }

  fn describe[T, C: Container[T]](local/1/2: C) -> string {
      Container[T]::value(container/2).mark()
  }

  fn main() -> () {
      println(def/1/5(NumberBox { value: 7 }));
  }