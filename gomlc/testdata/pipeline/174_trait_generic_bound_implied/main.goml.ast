package main;
trait Mark {
  fn mark(self: Self) -> string;
}

trait Container[T: Mark] {
  fn value(self: Self) -> T;
}

struct NumberBox {
    value: i32,
}

impl Mark for i32 {
  fn mark(self: i32) -> string {
      "marked:" + self.to_string()
  }
}

impl Container[i32] for NumberBox {
  fn value(self: NumberBox) -> i32 {
      self.value
  }
}

fn describe[T, C: Container[T]](container: C) -> string {
    Container::[T]::value(container).mark()
}

fn main() -> () {
    println(describe(NumberBox { value: 7 }));
}

