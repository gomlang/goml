impl Mark for i32 {
  fn mark(self/0: i32) -> string {
      "marked:" + (i32::to_string : (i32) -> string)((self/0 : i32))
  }
}

impl Container[i32] for NumberBox {
  fn value(self/1: NumberBox) -> i32 {
      (self/1 : NumberBox).value
  }
}

fn describe[T, C](container/2: C) -> string where C: Container[T], T: Mark {
    (Mark::mark : (T) -> string)((Container[T]::value : (C) -> T)((container/2 : C)))
}

fn main() -> () {
    (println : (string) -> ())((describe::[i32] : (NumberBox) -> string)(NumberBox { value: 7 }));
}