package main;
struct Point {
    x: i32,
    y: i32,
}

struct Wrapper[T] {
    value: T,
}

enum Shape[T] {
    Dot(Point),
    Wrapped(Wrapper[T]),
    Origin
}

fn bounce_int(shape: Shape[i32]) -> Shape[i32] {
    match shape {
        Dot(point) => Dot(point),
        Wrapped(inner) => Wrapped(inner),
        Origin => Origin,
    }
}

fn wrap_unit(value: Wrapper[()]) -> Shape[()] {
    Wrapped(value)
}

fn pick(flag: bool, point: Point, wrapper: Wrapper[i32]) -> Shape[i32] {
    match flag {
        true => Dot(point),
        false => Wrapped(wrapper),
    }
}

fn describe[T](shape: Shape[T]) -> i32 {
    match shape {
        Dot(_) => 1,
        Wrapped(_) => 2,
        Origin => 0,
    }
}

fn point32_to_string(point: Point) -> string {
    let Point { x: x, y: y } = point;
    let with_x = "Point { x: " + x.to_string();
    let with_y_label = with_x + ", y: ";
    let with_y = with_y_label + y.to_string();
    with_y + " }"
}

fn wrapper_int32_to_string(wrapper: Wrapper[i32]) -> string {
    let Wrapper { value: value } = wrapper;
    let prefix = "Wrapper[i32] { value: " + value.to_string();
    prefix + " }"
}

fn wrapper_unit_to_string(wrapper: Wrapper[()]) -> string {
    let Wrapper { value: value } = wrapper;
    let prefix = "Wrapper[()] { value: " + value.to_string();
    prefix + " }"
}

fn shape_int32_to_string(shape: Shape[i32]) -> string {
    match shape {
        Dot(point) =>
          {
              let prefix = "Shape::Dot(" + point32_to_string(point);
              prefix + ")"
          },
        Wrapped(wrapper) =>
          {
              let prefix = "Shape::Wrapped(" + wrapper_int32_to_string(wrapper);
              prefix + ")"
          },
        Origin => "Shape::Origin",
    }
}

fn shape_unit_to_string(shape: Shape[()]) -> string {
    match shape {
        Dot(point) =>
          {
              let prefix = "Shape::Dot(" + point32_to_string(point);
              prefix + ")"
          },
        Wrapped(wrapper) =>
          {
              let prefix = "Shape::Wrapped(" + wrapper_unit_to_string(wrapper);
              prefix + ")"
          },
        Origin => "Shape::Origin",
    }
}

fn main() {
    let _ = println(point32_to_string(Point(3, 4)));
    let _ = println(wrapper_int32_to_string(Wrapper(7)));
    let _ = println(wrapper_unit_to_string(Wrapper(())));
    let bounced_origin = bounce_int(Origin);
    let _ = println(shape_int32_to_string(Dot(Point(3, 4))));
    let _ = println(shape_int32_to_string(Wrapped(Wrapper(7))));
    let _ = println(shape_int32_to_string(bounced_origin));
    let _ = println(shape_unit_to_string(Dot(Point(3, 4))));
    let _ = println(shape_unit_to_string(Wrapped(Wrapper(()))));
    let _ = println(shape_unit_to_string(Origin));
    let _ = describe(bounce_int(Origin));
    println("struct enums!")
}

