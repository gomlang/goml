fn decimal_string(value/0: u64) -> string {
  let _wild0 =
    if (value/0 == 0) {
        {
          return "0"
        }
    } else {
        ()
    } in
  let reversed/0 = @intrinsic(vec.with_capacity)(20) in
  let remaining/0 = value/0 in
  let _wild1 =
    while (remaining/0 > 0) {
        {
          let _wild2 = inherent#Vec#Vec[u8]#push(reversed/0, (((remaining/0 % 10) as u8) + 48)) in
          let _wild3 =
            {
              let compound_old0 = remaining/0 in
              let compound_value0 = 10 in
              remaining/0 = (compound_old0 / compound_value0)
            } in
        }
    } in
  let bytes/0 = @intrinsic(vec.with_capacity)(inherent#Vec#Vec[u8]#len(reversed/0)) in
  let offset/0 = 0 in
  let _wild4 =
    while (offset/0 < inherent#Vec#Vec[u8]#len(reversed/0)) {
        {
          let _wild5 =
            inherent#Vec#Vec[u8]#push(
              bytes/0,
              @intrinsic(vec.get)(
                reversed/0,
                ((inherent#Vec#Vec[u8]#len(reversed/0) - offset/0) - 1)
              )
            ) in
          let _wild6 =
            {
              let compound_old1 = offset/0 in
              let compound_value1 = 1 in
              offset/0 = (compound_old1 + compound_value1)
            } in
        }
    } in
  let mtmp0 = @runtime(core.string_from_utf8)(bytes/0) in
  {
    let x0 = mtmp0.1 in
    {
      let result/0 = x0 in
      {
        result/0
      }
    }
  }
}

fn signed_decimal_string(value/0: i64) -> string {
  if (value/0 < 0) {
      {
        ("-" + decimal_string((0 - (value/0 as u64))))
      }
  } else {
      {
        decimal_string((value/0 as u64))
      }
  }
}

fn __goml_builtin_int32_to_string(value/0: i32) -> string {
  signed_decimal_string((value/0 as i64))
}

fn inherent#i32#i32#to_string(self/0: i32) -> string {
  __goml_builtin_int32_to_string(self/0)
}

fn trait_impl#ToString#()#to_string(self/0: ()) -> string {
  @runtime(core.unit_to_string)(self/0)
}

fn trait_impl#ToString#string#to_string(self/0: string) -> string {
  self/0
}

fn inherent#Vec#Vec[T]#push[T](self/0: Vec[T], elem/0: T) -> () {
  @intrinsic(vec.push)(self/0, elem/0)
}

fn inherent#Vec#Vec[T]#len[T](self/0: Vec[T]) -> isize {
  @intrinsic(vec.len)(self/0)
}

fn println[T](value/0: T) -> () {
  @runtime(core.string_println)(trait_call[ToString::to_string](value/0))
}

fn bounce_int(shape/0: Shape[i32]) -> Shape[i32] {
  match shape/0 {
    Shape::Dot(x0) => {
      {
        let x0 = Shape::Dot._0(shape/0) in
        {
          let point/0 = x0 in
          Shape::Dot(point/0)
        }
      }
    },
    Shape::Wrapped(x1) => {
      {
        let x1 = Shape::Wrapped._0(shape/0) in
        {
          let inner/0 = x1 in
          Shape::Wrapped(inner/0)
        }
      }
    },
    Shape::Origin => {
      Shape::Origin
    },
  }
}

fn wrap_unit(value/0: Wrapper[()]) -> Shape[()] {
  Shape::Wrapped(value/0)
}

fn pick(flag/0: bool, point/0: Point, wrapper/0: Wrapper[i32]) -> Shape[i32] {
  match flag/0 {
    true => {
      Shape::Dot(point/0)
    },
    false => {
      Shape::Wrapped(wrapper/0)
    },
  }
}

fn describe[T](shape/0: Shape[T]) -> i32 {
  match shape/0 {
    Shape::Dot(x0) => {
      {
        1
      }
    },
    Shape::Wrapped(x1) => {
      {
        2
      }
    },
    Shape::Origin => {
      0
    },
  }
}

fn point32_to_string(point/0: Point) -> string {
  let mtmp0 = point/0 in
  {
    let x0 = Point.x(mtmp0) in
    let x1 = Point.y(mtmp0) in
    {
      let y/0 = x1 in
      {
        let x/0 = x0 in
        {
          let with_x/0 = ("Point { x: " + inherent#i32#i32#to_string(x/0)) in
          let with_y_label/0 = (with_x/0 + ", y: ") in
          let with_y/0 = (with_y_label/0 + inherent#i32#i32#to_string(y/0)) in
          (with_y/0 + " }")
        }
      }
    }
  }
}

fn wrapper_int32_to_string(wrapper/0: Wrapper[i32]) -> string {
  let mtmp0 = wrapper/0 in
  {
    let x0 = Wrapper.value(mtmp0) in
    {
      let value/0 = x0 in
      {
        let prefix/0 = ("Wrapper[i32] { value: " + inherent#i32#i32#to_string(value/0)) in
        (prefix/0 + " }")
      }
    }
  }
}

fn wrapper_unit_to_string(wrapper/0: Wrapper[()]) -> string {
  let mtmp0 = wrapper/0 in
  {
    let x0 = Wrapper.value(mtmp0) in
    {
      let value/0 = x0 in
      {
        let prefix/0 = ("Wrapper[()] { value: " + trait_call[ToString::to_string](value/0)) in
        (prefix/0 + " }")
      }
    }
  }
}

fn shape_int32_to_string(shape/0: Shape[i32]) -> string {
  match shape/0 {
    Shape::Dot(x0) => {
      {
        let x0 = Shape::Dot._0(shape/0) in
        {
          let point/0 = x0 in
          {
            let prefix/0 = ("Shape::Dot(" + point32_to_string(point/0)) in
            (prefix/0 + ")")
          }
        }
      }
    },
    Shape::Wrapped(x1) => {
      {
        let x1 = Shape::Wrapped._0(shape/0) in
        {
          let wrapper/0 = x1 in
          {
            let prefix/1 = ("Shape::Wrapped(" + wrapper_int32_to_string(wrapper/0)) in
            (prefix/1 + ")")
          }
        }
      }
    },
    Shape::Origin => {
      "Shape::Origin"
    },
  }
}

fn shape_unit_to_string(shape/0: Shape[()]) -> string {
  match shape/0 {
    Shape::Dot(x0) => {
      {
        let x0 = Shape::Dot._0(shape/0) in
        {
          let point/0 = x0 in
          {
            let prefix/0 = ("Shape::Dot(" + point32_to_string(point/0)) in
            (prefix/0 + ")")
          }
        }
      }
    },
    Shape::Wrapped(x1) => {
      {
        let x1 = Shape::Wrapped._0(shape/0) in
        {
          let wrapper/0 = x1 in
          {
            let prefix/1 = ("Shape::Wrapped(" + wrapper_unit_to_string(wrapper/0)) in
            (prefix/1 + ")")
          }
        }
      }
    },
    Shape::Origin => {
      "Shape::Origin"
    },
  }
}

fn main() -> () {
  let mtmp0 = println(point32_to_string(Point { x: 3, y: 4 })) in
  {
    let mtmp1 = println(wrapper_int32_to_string(Wrapper { value: 7 })) in
    {
      let mtmp2 = println(wrapper_unit_to_string(Wrapper { value: () })) in
      {
        let bounced_origin/0 = bounce_int(Shape::Origin) in
        let mtmp3 = println(shape_int32_to_string(Shape::Dot(Point { x: 3, y: 4 }))) in
        {
          let mtmp4 = println(shape_int32_to_string(Shape::Wrapped(Wrapper { value: 7 }))) in
          {
            let mtmp5 = println(shape_int32_to_string(bounced_origin/0)) in
            {
              let mtmp6 = println(shape_unit_to_string(Shape::Dot(Point { x: 3, y: 4 }))) in
              {
                let mtmp7 = println(shape_unit_to_string(Shape::Wrapped(Wrapper { value: () }))) in
                {
                  let mtmp8 = println(shape_unit_to_string(Shape::Origin)) in
                  {
                    let mtmp9 = describe(bounce_int(Shape::Origin)) in
                    {
                      println("struct enums!")
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}