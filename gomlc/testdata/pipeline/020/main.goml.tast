fn bounce_int(shape/0: Shape[i32]) -> Shape[i32] {
    match (shape/0 : Shape[i32]) {
        Shape::Dot(point/1: Point) => Shape::Dot((point/1 : Point)),
        Shape::Wrapped(inner/2: Wrapper[i32]) => Shape::Wrapped((inner/2 : Wrapper[i32])),
        Shape::Origin => Shape::Origin,
    }
}

fn wrap_unit(value/3: Wrapper[()]) -> Shape[()] {
    Shape::Wrapped((value/3 : Wrapper[()]))
}

fn pick(flag/4: bool, point/5: Point, wrapper/6: Wrapper[i32]) -> Shape[i32] {
    match (flag/4 : bool) {
        true => Shape::Dot((point/5 : Point)),
        false => Shape::Wrapped((wrapper/6 : Wrapper[i32])),
    }
}

fn describe[T](shape/7: Shape[T]) -> i32 {
    match (shape/7 : Shape[T]) {
        Shape::Dot(_ : Point) => 1,
        Shape::Wrapped(_ : Wrapper[T]) => 2,
        Shape::Origin => 0,
    }
}

fn point32_to_string(point/8: Point) -> string {
    let Point { x: x/9: i32, y: y/10: i32 } = (point/8 : Point);
    let with_x/11: string = "Point { x: " + (i32::to_string : (i32) -> string)((x/9 : i32));
    let with_y_label/12: string = (with_x/11 : string) + ", y: ";
    let with_y/13: string =
      (with_y_label/12 : string) + (i32::to_string : (i32) -> string)((y/10 : i32));
    (with_y/13 : string) + " }"
}

fn wrapper_int32_to_string(wrapper/14: Wrapper[i32]) -> string {
    let Wrapper { value: value/15: i32 } = (wrapper/14 : Wrapper[i32]);
    let prefix/16: string =
      "Wrapper[i32] { value: " + (i32::to_string : (i32) -> string)((value/15 : i32));
    (prefix/16 : string) + " }"
}

fn wrapper_unit_to_string(wrapper/17: Wrapper[()]) -> string {
    let Wrapper { value: value/18: () } = (wrapper/17 : Wrapper[()]);
    let prefix/19: string =
      "Wrapper[()] { value: " + (ToString::to_string : (()) -> string)((value/18 : ()));
    (prefix/19 : string) + " }"
}

fn shape_int32_to_string(shape/20: Shape[i32]) -> string {
    match (shape/20 : Shape[i32]) {
        Shape::Dot(point/21: Point) =>
          {
              let prefix/22: string =
                "Shape::Dot(" + (point32_to_string : (Point) -> string)((point/21 : Point));
              (prefix/22 : string) + ")"
          },
        Shape::Wrapped(wrapper/23: Wrapper[i32]) =>
          {
              let prefix/24: string =
                "Shape::Wrapped(" +
                  (wrapper_int32_to_string : (Wrapper[i32]) -> string)((wrapper/23 : Wrapper[i32]));
              (prefix/24 : string) + ")"
          },
        Shape::Origin => "Shape::Origin",
    }
}

fn shape_unit_to_string(shape/25: Shape[()]) -> string {
    match (shape/25 : Shape[()]) {
        Shape::Dot(point/26: Point) =>
          {
              let prefix/27: string =
                "Shape::Dot(" + (point32_to_string : (Point) -> string)((point/26 : Point));
              (prefix/27 : string) + ")"
          },
        Shape::Wrapped(wrapper/28: Wrapper[()]) =>
          {
              let prefix/29: string =
                "Shape::Wrapped(" +
                  (wrapper_unit_to_string : (Wrapper[()]) -> string)((wrapper/28 : Wrapper[()]));
              (prefix/29 : string) + ")"
          },
        Shape::Origin => "Shape::Origin",
    }
}

fn main() -> () {
    let _ : () =
      (println : (string) -> ())((point32_to_string : (Point) -> string)(Point { x: 3, y: 4 }));
    let _ : () =
      (println : (string) -> ())(
        (wrapper_int32_to_string : (Wrapper[i32]) -> string)(Wrapper { value: 7 })
      );
    let _ : () =
      (println : (string) -> ())(
        (wrapper_unit_to_string : (Wrapper[()]) -> string)(Wrapper { value: () })
      );
    let bounced_origin/30: Shape[i32] = (bounce_int : (Shape[i32]) -> Shape[i32])(Shape::Origin);
    let _ : () =
      (println : (string) -> ())(
        (shape_int32_to_string : (Shape[i32]) -> string)(Shape::Dot(Point { x: 3, y: 4 }))
      );
    let _ : () =
      (println : (string) -> ())(
        (shape_int32_to_string : (Shape[i32]) -> string)(Shape::Wrapped(Wrapper { value: 7 }))
      );
    let _ : () =
      (println : (string) -> ())(
        (shape_int32_to_string : (Shape[i32]) -> string)((bounced_origin/30 : Shape[i32]))
      );
    let _ : () =
      (println : (string) -> ())(
        (shape_unit_to_string : (Shape[()]) -> string)(Shape::Dot(Point { x: 3, y: 4 }))
      );
    let _ : () =
      (println : (string) -> ())(
        (shape_unit_to_string : (Shape[()]) -> string)(Shape::Wrapped(Wrapper { value: () }))
      );
    let _ : () =
      (println : (string) -> ())((shape_unit_to_string : (Shape[()]) -> string)(Shape::Origin));
    let _ : i32 =
      (describe : (Shape[i32]) -> i32)((bounce_int : (Shape[i32]) -> Shape[i32])(Shape::Origin));
    (println : (string) -> ())("struct enums!")
}