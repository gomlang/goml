package main
file main.goml
  struct Point {
      x: i32,
      y: i32,
  }

  struct Wrapper[T] {
      value: T,
  }

  enum Shape[T] {
      Dot(Point),
      Wrapped(Wrapper[T]),
      Origin
  }

  fn bounce_int(local/1/0: Shape[i32]) -> Shape[i32] {
      match shape/0 {
          Dot(local/1/1) => ctor(def/1/2::v0)(point/1),
          Wrapped(local/1/2) => ctor(def/1/2::v1)(inner/2),
          Origin => ctor(def/1/2::v2),
      }
  }

  fn wrap_unit(local/1/3: Wrapper[()]) -> Shape[()] {
      ctor(def/1/2::v1)(value/3)
  }

  fn pick(local/1/4: bool, local/1/5: Point, local/1/6: Wrapper[i32]) -> Shape[i32] {
      match flag/4 {
          true => ctor(def/1/2::v0)(point/5),
          false => ctor(def/1/2::v1)(wrapper/6),
      }
  }

  fn describe[T](local/1/7: Shape[T]) -> i32 {
      match shape/7 {
          Dot(_) => 1,
          Wrapped(_) => 2,
          Origin => 0,
      }
  }

  fn point32_to_string(local/1/8: Point) -> string {
      let Point { x: local/1/9, y: local/1/10 } = point/8;
      let local/1/11 = "Point { x: " + x/9.to_string();
      let local/1/12 = with_x/11 + ", y: ";
      let local/1/13 = with_y_label/12 + y/10.to_string();
      with_y/13 + " }"
  }

  fn wrapper_int32_to_string(local/1/14: Wrapper[i32]) -> string {
      let Wrapper { value: local/1/15 } = wrapper/14;
      let local/1/16 = "Wrapper[i32] { value: " + value/15.to_string();
      prefix/16 + " }"
  }

  fn wrapper_unit_to_string(local/1/17: Wrapper[()]) -> string {
      let Wrapper { value: local/1/18 } = wrapper/17;
      let local/1/19 = "Wrapper[()] { value: " + value/18.to_string();
      prefix/19 + " }"
  }

  fn shape_int32_to_string(local/1/20: Shape[i32]) -> string {
      match shape/20 {
          Dot(local/1/21) =>
            {
                let local/1/22 = "Shape::Dot(" + def/1/7(point/21);
                prefix/22 + ")"
            },
          Wrapped(local/1/23) =>
            {
                let local/1/24 = "Shape::Wrapped(" + def/1/8(wrapper/23);
                prefix/24 + ")"
            },
          Origin => "Shape::Origin",
      }
  }

  fn shape_unit_to_string(local/1/25: Shape[()]) -> string {
      match shape/25 {
          Dot(local/1/26) =>
            {
                let local/1/27 = "Shape::Dot(" + def/1/7(point/26);
                prefix/27 + ")"
            },
          Wrapped(local/1/28) =>
            {
                let local/1/29 = "Shape::Wrapped(" + def/1/9(wrapper/28);
                prefix/29 + ")"
            },
          Origin => "Shape::Origin",
      }
  }

  fn main() {
      let _ = println(def/1/7(Point(3, 4)));
      let _ = println(def/1/8(Wrapper(7)));
      let _ = println(def/1/9(Wrapper(())));
      let local/1/30 = def/1/3(ctor(def/1/2::v2));
      let _ = println(def/1/10(ctor(def/1/2::v0)(Point(3, 4))));
      let _ = println(def/1/10(ctor(def/1/2::v1)(Wrapper(7))));
      let _ = println(def/1/10(bounced_origin/30));
      let _ = println(def/1/11(ctor(def/1/2::v0)(Point(3, 4))));
      let _ = println(def/1/11(ctor(def/1/2::v1)(Wrapper(()))));
      let _ = println(def/1/11(ctor(def/1/2::v2)));
      let _ = def/1/6(def/1/3(ctor(def/1/2::v2)));
      println("struct enums!")
  }