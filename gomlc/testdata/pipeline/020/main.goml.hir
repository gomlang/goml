package main
file main.goml
  struct Point {
      x: i32,
      y: i32,
  }

  struct Wrapper[T] {
      value: T,
  }

  enum Shape[T] {
      Dot(Point),
      Wrapped(Wrapper[T]),
      Origin
  }

  fn bounce_int(local/main/0: Shape[i32]) -> Shape[i32] {
      match shape/0 {
          Dot(local/main/1) => ctor(source:4:main:2::v0)(point/1),
          Wrapped(local/main/2) => ctor(source:4:main:2::v1)(inner/2),
          Origin => ctor(source:4:main:2::v2),
      }
  }

  fn wrap_unit(local/main/3: Wrapper[()]) -> Shape[()] {
      ctor(source:4:main:2::v1)(value/3)
  }

  fn pick(local/main/4: bool, local/main/5: Point, local/main/6: Wrapper[i32]) -> Shape[i32] {
      match flag/4 {
          true => ctor(source:4:main:2::v0)(point/5),
          false => ctor(source:4:main:2::v1)(wrapper/6),
      }
  }

  fn describe[T](local/main/7: Shape[T]) -> i32 {
      match shape/7 {
          Dot(_) => 1,
          Wrapped(_) => 2,
          Origin => 0,
      }
  }

  fn point32_to_string(local/main/8: Point) -> string {
      let Point { x: local/main/9, y: local/main/10 } = point/8;
      let local/main/11 = "Point { x: " + x/9.to_string();
      let local/main/12 = with_x/11 + ", y: ";
      let local/main/13 = with_y_label/12 + y/10.to_string();
      with_y/13 + " }"
  }

  fn wrapper_int32_to_string(local/main/14: Wrapper[i32]) -> string {
      let Wrapper { value: local/main/15 } = wrapper/14;
      let local/main/16 = "Wrapper[i32] { value: " + value/15.to_string();
      prefix/16 + " }"
  }

  fn wrapper_unit_to_string(local/main/17: Wrapper[()]) -> string {
      let Wrapper { value: local/main/18 } = wrapper/17;
      let local/main/19 = "Wrapper[()] { value: " + value/18.to_string();
      prefix/19 + " }"
  }

  fn shape_int32_to_string(local/main/20: Shape[i32]) -> string {
      match shape/20 {
          Dot(local/main/21) =>
            {
                let local/main/22 = "Shape::Dot(" + source:4:main:7(point/21);
                prefix/22 + ")"
            },
          Wrapped(local/main/23) =>
            {
                let local/main/24 = "Shape::Wrapped(" + source:4:main:8(wrapper/23);
                prefix/24 + ")"
            },
          Origin => "Shape::Origin",
      }
  }

  fn shape_unit_to_string(local/main/25: Shape[()]) -> string {
      match shape/25 {
          Dot(local/main/26) =>
            {
                let local/main/27 = "Shape::Dot(" + source:4:main:7(point/26);
                prefix/27 + ")"
            },
          Wrapped(local/main/28) =>
            {
                let local/main/29 = "Shape::Wrapped(" + source:4:main:9(wrapper/28);
                prefix/29 + ")"
            },
          Origin => "Shape::Origin",
      }
  }

  fn main() {
      let _ = println(source:4:main:7(Point(3, 4)));
      let _ = println(source:4:main:8(Wrapper(7)));
      let _ = println(source:4:main:9(Wrapper(())));
      let local/main/30 = source:4:main:3(ctor(source:4:main:2::v2));
      let _ = println(source:4:main:10(ctor(source:4:main:2::v0)(Point(3, 4))));
      let _ = println(source:4:main:10(ctor(source:4:main:2::v1)(Wrapper(7))));
      let _ = println(source:4:main:10(bounced_origin/30));
      let _ = println(source:4:main:11(ctor(source:4:main:2::v0)(Point(3, 4))));
      let _ = println(source:4:main:11(ctor(source:4:main:2::v1)(Wrapper(()))));
      let _ = println(source:4:main:11(ctor(source:4:main:2::v2)));
      let _ = source:4:main:6(source:4:main:3(ctor(source:4:main:2::v2)));
      println("struct enums!")
  }