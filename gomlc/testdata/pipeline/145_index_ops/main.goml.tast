fn print_opt_int(x/0: Option[i32]) -> () {
    match (x/0 : Option[i32]) {
        Option::Some(v/1: i32) => (println : (i32) -> ())((v/1 : i32)),
        Option::None => (println : (string) -> ())("none"),
    }
}

