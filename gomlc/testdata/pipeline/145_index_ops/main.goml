struct Holder {
    data: [i32; 2],
    vecs: Vec[[i32; 2]],
}

fn print_opt_int(x: Option[i32]) -> () {
    match x {
        Option::Some(v) => println(v),
        Option::None => println("none"),
    }
}

fn main() -> () {
    println([31, 32][1]);
    let arr = [1, 2, 3];
    println(arr[0]);
    let mut arr2 = [4, 5, 6];
    arr2[1] = 50;
    println(arr2[1]);
    let vec = Vec::new().pushed(7).pushed(8).pushed(9);
    println(vec[2]);
    let mut vec2 = Vec::new().pushed(10).pushed(11).pushed(12);
    vec2[0] = 100;
    println(vec2[0]);
    let s: Slice[i32] = vec2.slice(0, 2);
    println(s[1]);
    let map = HashMap::new();
    map["a"] = 13;
    print_opt_int(map["a"]);
    print_opt_int(map["missing"]);
    let mut matrix: [[i32; 2]; 2] = [[1, 2], [3, 4]];
    matrix[1][0] = 30;
    println(matrix[1][0]);
    let mut pair = ([14, 15], 0);
    pair.0[1] = 150;
    println(pair.0[1]);
    let mut holder = Holder { data: [16, 17], vecs: Vec::new().pushed([18, 19]).pushed([20, 21]) };
    holder.data[0] = 160;
    println(holder.data[0]);
    holder.vecs[1][0] = 200;
    println(holder.vecs[1][0]);
    let r: Ref[[i32; 2]] = Ref::new([22, 23]);
    r.get()[1] = 230;
    println(r.get()[1]);
}
