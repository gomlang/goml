package main
file main.goml
  struct Wide {
      a: isize,
      b: isize,
      c: isize,
      d: isize,
      e: isize,
      f: isize,
      g: isize,
      h: isize,
      i: isize,
      j: isize,
  }

  fn read(local/main/0: Wide, local/main/1: () -> (), local/main/2: isize) -> isize {
      if depth/2 == 0 {
          action/1();
          value/0.a
      } else {
          source:4:main:1(value/0, action/1, depth/2 - 1)
      }
  }

  fn modify(local/main/3: Wide, local/main/4: isize) -> Wide {
      value/3.a = 7;
      if depth/4 == 0 {
          value/3
      } else {
          source:4:main:2(value/3, depth/4 - 1)
      }
  }

  fn make_reader(local/main/5: Wide, local/main/6: isize) -> () -> isize {
      if depth/6 == 0 {
          || value/5.a
      } else {
          source:4:main:3(value/5, depth/6 - 1)
      }
  }

  fn main() -> () {
      let mut local/main/7 = Wide { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8, i: 9, j: 10 };
      let local/main/8 =
        || {
            value/7.a = 9;
        };
      println(source:4:main:1(value/7, action/8, 2));
      println(value/7.a);
      let local/main/9 = source:4:main:2(value/7, 2);
      println(result/9.a);
      println(value/7.a);
      println(result/9.j);
      let local/main/10 = source:4:main:3(value/7, 2);
      value/7.a = 12;
      println(reader/10());
      println(value/7.a);
  }