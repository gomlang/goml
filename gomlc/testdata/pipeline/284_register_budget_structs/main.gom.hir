package main
file main.gom
  struct Wide {
      a: isize,
      b: isize,
      c: isize,
      d: isize,
      e: isize,
      f: isize,
      g: isize,
      h: isize,
      i: isize,
      j: isize,
  }

  fn read(local/1/0: Wide, local/1/1: () -> (), local/1/2: isize) -> isize {
      if depth/2 == 0 {
          action/1();
          value/0.a
      } else {
          def/1/1(value/0, action/1, depth/2 - 1)
      }
  }

  fn modify(local/1/3: Wide, local/1/4: isize) -> Wide {
      value/3.a = 7;
      if depth/4 == 0 {
          value/3
      } else {
          def/1/2(value/3, depth/4 - 1)
      }
  }

  fn make_reader(local/1/5: Wide, local/1/6: isize) -> () -> isize {
      if depth/6 == 0 {
          || value/5.a
      } else {
          def/1/3(value/5, depth/6 - 1)
      }
  }

  fn main() -> () {
      let mut local/1/7 = Wide { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8, i: 9, j: 10 };
      let local/1/8 =
        || {
            value/7.a = 9;
        };
      println(def/1/1(value/7, action/8, 2));
      println(value/7.a);
      let local/1/9 = def/1/2(value/7, 2);
      println(result/9.a);
      println(value/7.a);
      println(result/9.j);
      let local/1/10 = def/1/3(value/7, 2);
      value/7.a = 12;
      println(reader/10());
      println(value/7.a);
  }