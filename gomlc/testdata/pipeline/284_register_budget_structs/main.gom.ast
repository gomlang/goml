package main;
struct Wide {
    a: isize,
    b: isize,
    c: isize,
    d: isize,
    e: isize,
    f: isize,
    g: isize,
    h: isize,
    i: isize,
    j: isize,
}

fn read(value: Wide, action: () -> (), depth: isize) -> isize {
    if depth == 0 {
        {
            action();
            value.a
        }
    } else {
        {
            read(value, action, depth - 1)
        }
    }
}

fn modify(value: Wide, depth: isize) -> Wide {
    value.a = 7;
    if depth == 0 {
        {
            value
        }
    } else {
        {
            modify(value, depth - 1)
        }
    }
}

fn make_reader(value: Wide, depth: isize) -> () -> isize {
    if depth == 0 {
        {
            || value.a
        }
    } else {
        {
            make_reader(value, depth - 1)
        }
    }
}

fn main() -> () {
    let mut value = Wide { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8, i: 9, j: 10 };
    let action =
      || {
          value.a = 9;
      };
    println(read(value, action, 2));
    println(value.a);
    let result = modify(value, 2);
    println(result.a);
    println(value.a);
    println(result.j);
    let reader = make_reader(value, 2);
    value.a = 12;
    println(reader());
    println(value.a);
}

