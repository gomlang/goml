fn read(value/0: Wide, action/1: () -> (), depth/2: isize) -> isize {
    if (depth/2 : isize) == 0 {
        {
            (action/1 : () -> ())();
            (value/0 : Wide).a
        }
    } else {
        {
            (read : (Wide, () -> (), isize) -> isize)(
              (value/0 : Wide),
              (action/1 : () -> ()),
              (depth/2 : isize) - 1
            )
        }
    }
}

fn modify(value/3: Wide, depth/4: isize) -> Wide {
    (value/3 : Wide).a = 7;
    if (depth/4 : isize) == 0 {
        {
            (value/3 : Wide)
        }
    } else {
        {
            (modify : (Wide, isize) -> Wide)((value/3 : Wide), (depth/4 : isize) - 1)
        }
    }
}

fn make_reader(value/5: Wide, depth/6: isize) -> () -> isize {
    if (depth/6 : isize) == 0 {
        {
            || => (value/5 : Wide).a
        }
    } else {
        {
            (make_reader : (Wide, isize) -> () -> isize)((value/5 : Wide), (depth/6 : isize) - 1)
        }
    }
}

fn main() -> () {
    let mut value/7: Wide = Wide { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8, i: 9, j: 10 };
    let action/8: () -> () =
      || =>
        {
            (value/7 : Wide).a = 9;
        };
    (println : (isize) -> ())(
      (read : (Wide, () -> (), isize) -> isize)((value/7 : Wide), (action/8 : () -> ()), 2)
    );
    (println : (isize) -> ())((value/7 : Wide).a);
    let result/9: Wide = (modify : (Wide, isize) -> Wide)((value/7 : Wide), 2);
    (println : (isize) -> ())((result/9 : Wide).a);
    (println : (isize) -> ())((value/7 : Wide).a);
    (println : (isize) -> ())((result/9 : Wide).j);
    let reader/10: () -> isize = (make_reader : (Wide, isize) -> () -> isize)((value/7 : Wide), 2);
    (value/7 : Wide).a = 12;
    (println : (isize) -> ())((reader/10 : () -> isize)());
    (println : (isize) -> ())((value/7 : Wide).a);
}