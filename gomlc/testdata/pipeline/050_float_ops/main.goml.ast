package main;
fn show32(label: string, value: f32) {
    let message = label + value.to_string();
    let _ = println(message);
}

fn show64(label: string, value: f64) {
    let message = label + value.to_string();
    let _ = println(message);
}

fn lerp32(a: f32, b: f32, weight: f32) -> f32 {
    let delta = b - a;
    a + delta * weight
}

fn midpoint_energy(x: f64, y: f64) -> f64 {
    let sum = x * x + y * y;
    sum / 2.0
}

fn main() {
    let start32: f32 = 1.25;
    let end32: f32 = 5.75;
    let half: f32 = 0.5;
    let scale: f32 = 2.0;
    let mid32 = lerp32(start32, end32, half);
    let neg_end32 = -end32;
    let ratio32 = end32 / scale;
    let less32 = start32 < end32;
    let dx: f64 = 6.5;
    let dy: f64 = 3.5;
    let quarter: f64 = 0.25;
    let energy: f64 = midpoint_energy(dx, dy);
    let neg_dx = -dx;
    let adjusted: f64 = energy + dy - dx * quarter;
    let threshold: f64 = 4.0;
    let less64 = adjusted < threshold;
    show32("mid32=", mid32);
    show32("neg_end32=", neg_end32);
    show32("ratio32=", ratio32);
    let _ = println("less32=" + less32.to_string());
    show64("energy=", energy);
    show64("neg_dx=", neg_dx);
    show64("adjusted=", adjusted);
    let _ = println("less64=" + less64.to_string());
}

