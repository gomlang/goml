fn show32(label/0: string, value/1: f32) -> () {
    let message/2: string =
      (label/0 : string) + (ToString::to_string : (f32) -> string)((value/1 : f32));
    let _ : () = (println : (string) -> ())((message/2 : string));
}

fn show64(label/3: string, value/4: f64) -> () {
    let message/5: string =
      (label/3 : string) + (ToString::to_string : (f64) -> string)((value/4 : f64));
    let _ : () = (println : (string) -> ())((message/5 : string));
}

fn lerp32(a/6: f32, b/7: f32, weight/8: f32) -> f32 {
    let delta/9: f32 = (b/7 : f32) - (a/6 : f32);
    (a/6 : f32) + (delta/9 : f32) * (weight/8 : f32)
}

fn midpoint_energy(x/10: f64, y/11: f64) -> f64 {
    let sum/12: f64 = (x/10 : f64) * (x/10 : f64) + (y/11 : f64) * (y/11 : f64);
    (sum/12 : f64) / 2
}

fn main() -> () {
    let start32/13: f32 = 1.25;
    let end32/14: f32 = 5.75;
    let half/15: f32 = 0.5;
    let scale/16: f32 = 2;
    let mid32/17: f32 =
      (lerp32 : (f32, f32, f32) -> f32)((start32/13 : f32), (end32/14 : f32), (half/15 : f32));
    let neg_end32/18: f32 = -(end32/14 : f32);
    let ratio32/19: f32 = (end32/14 : f32) / (scale/16 : f32);
    let less32/20: bool = (start32/13 : f32) < (end32/14 : f32);
    let dx/21: f64 = 6.5;
    let dy/22: f64 = 3.5;
    let quarter/23: f64 = 0.25;
    let energy/24: f64 = (midpoint_energy : (f64, f64) -> f64)((dx/21 : f64), (dy/22 : f64));
    let neg_dx/25: f64 = -(dx/21 : f64);
    let adjusted/26: f64 = (energy/24 : f64) + (dy/22 : f64) - (dx/21 : f64) * (quarter/23 : f64);
    let threshold/27: f64 = 4;
    let less64/28: bool = (adjusted/26 : f64) < (threshold/27 : f64);
    (show32 : (string, f32) -> ())("mid32=", (mid32/17 : f32));
    (show32 : (string, f32) -> ())("neg_end32=", (neg_end32/18 : f32));
    (show32 : (string, f32) -> ())("ratio32=", (ratio32/19 : f32));
    let _ : () =
      (println : (string) -> ())(
        "less32=" + (ToString::to_string : (bool) -> string)((less32/20 : bool))
      );
    (show64 : (string, f64) -> ())("energy=", (energy/24 : f64));
    (show64 : (string, f64) -> ())("neg_dx=", (neg_dx/25 : f64));
    (show64 : (string, f64) -> ())("adjusted=", (adjusted/26 : f64));
    let _ : () =
      (println : (string) -> ())(
        "less64=" + (ToString::to_string : (bool) -> string)((less64/28 : bool))
      );
}