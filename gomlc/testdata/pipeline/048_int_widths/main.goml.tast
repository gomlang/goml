fn main() -> () {
    let start16/0: i16 = 300;
    let delta16/1: i16 = 45;
    let sum16/2: i16 = (start16/0 : i16) + (delta16/1 : i16);
    let flipped16/3: i16 = -(start16/0 : i16);
    let base32/4: i32 = 100000;
    let more32/5: i32 = 200000;
    let sum32/6: i32 = (base32/4 : i32) + (more32/5 : i32);
    let diff32/7: i32 = (sum32/6 : i32) - (base32/4 : i32);
    let big64/8: i64 = 5000000000;
    let step64/9: i64 = 2000000000;
    let remain64/10: i64 = (big64/8 : i64) - (step64/9 : i64);
    let neg64/11: i64 = -(step64/9 : i64);
    let message/12: string =
      (ToString::to_string : (i16) -> string)((sum16/2 : i16)) + ", " +
        (ToString::to_string : (i16) -> string)((flipped16/3 : i16)) +
        "; " +
        (i32::to_string : (i32) -> string)((diff32/7 : i32)) +
        "; " +
        (ToString::to_string : (i64) -> string)((remain64/10 : i64)) +
        "; " +
        (ToString::to_string : (i64) -> string)((neg64/11 : i64));
    (println : (string) -> ())((message/12 : string));
}