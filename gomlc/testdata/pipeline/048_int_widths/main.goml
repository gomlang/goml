fn main() {
    let start16: i16 = 300;
    let delta16: i16 = 45;
    let sum16 = start16 + delta16;
    let flipped16 = -start16;
    let base32: i32 = 100000;
    let more32: i32 = 200000;
    let sum32 = base32 + more32;
    let diff32 = sum32 - base32;
    let big64: i64 = 5000000000;
    let step64: i64 = 2000000000;
    let remain64 = big64 - step64;
    let neg64 = -step64;
    let message = sum16.to_string() + ", " + flipped16.to_string() + "; " + diff32.to_string()
        + "; "
        + remain64.to_string()
        + "; "
        + neg64.to_string();
    println(message);
}
