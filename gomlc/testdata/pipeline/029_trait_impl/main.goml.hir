package main
file main.goml
  struct Point {
      x: i32,
      y: i32,
  }

  enum Maybe[T] {
      Just(T),
      Nothing
  }

  trait Display {
    fn show(Self) -> string;
  }

  impl Display for Point {
    fn show(local/main/0: Point) -> string {
        "Point"
    }
  }

  impl Display for Maybe[i32] {
    fn show(local/main/1: Maybe[i32]) -> string {
        match self/1 {
            Just(local/main/2) => "Just(" + value/2.to_string() + ")",
            Nothing => "Nothing",
        }
    }
  }

  fn make_maybe(local/main/3: bool) -> Maybe[i32] {
      if flag/3 {
          ctor(source:4:main:1::v0)(42)
      } else {
          ctor(source:4:main:1::v1)
      }
  }

  fn main() {
      let local/main/4 = Point { x: 1, y: 2 };
      let local/main/5 = source:4:main:5(true);
      let local/main/6 = source:4:main:5(false);
      let _ = println(Display::show(point/4));
      let _ = println(Display::show(some_number/5));
      let _ = println(Display::show(none_number/6));
  }