impl Display for Point {
  fn show(self/0: Point) -> string {
      "Point"
  }
}

impl Display for Maybe[i32] {
  fn show(self/1: Maybe[i32]) -> string {
      match (self/1 : Maybe[i32]) {
          Maybe::Just(value/2: i32) =>
            "Just(" + (i32::to_string : (i32) -> string)((value/2 : i32)) + ")",
          Maybe::Nothing => "Nothing",
      }
  }
}

fn make_maybe(flag/3: bool) -> Maybe[i32] {
    if (flag/3 : bool) {
        {
            Maybe::Just(42)
        }
    } else {
        {
            Maybe::Nothing
        }
    }
}

fn main() -> () {
    let point/4: Point = Point { x: 1, y: 2 };
    let some_number/5: Maybe[i32] = (make_maybe : (bool) -> Maybe[i32])(true);
    let none_number/6: Maybe[i32] = (make_maybe : (bool) -> Maybe[i32])(false);
    let _ : () = (println : (string) -> ())((Display::show : (Point) -> string)((point/4 : Point)));
    let _ : () =
      (println : (string) -> ())(
        (Display::show : (Maybe[i32]) -> string)((some_number/5 : Maybe[i32]))
      );
    let _ : () =
      (println : (string) -> ())(
        (Display::show : (Maybe[i32]) -> string)((none_number/6 : Maybe[i32]))
      );
}