fn identity[T](value: T) -> T {
    value
}

fn classify(value: f32) -> isize {
    match value {
        1.0000000596046447753906250000000000000001 => 1,
        _ => 0,
    }
}

fn main() -> () {
    let below: f32 = 1.0000000596046447753906249999999999999999;
    let midpoint: f32 = 1.000000059604644775390625;
    let above: f32 = 1.0000000596046447753906250000000000000001;
    println(below.to_bits());
    println(midpoint.to_bits());
    println(above.to_bits());
    let generic: f32 = identity(1.0000000596046447753906250000000000000001);
    println(generic.to_bits());
    println(classify(float32_from_bits(1065353217)).to_string());
    let tiny32: f32 = 1e-999999;
    let tiny64: f64 = 1e-999999;
    println(tiny32.to_bits());
    println(tiny64.to_bits());
    let maximum32: f32 = 3.4028235e38;
    let maximum64: f64 = 1.7976931348623157e308;
    println(maximum32.to_bits());
    println(maximum64.to_bits())
}
