    (println : (u32) -> ())((f32::to_bits : (f32) -> u32)((above/4 : f32)));
    let generic/5: f32 = (identity : (f32) -> f32)(1.0000001);
    (println : (u32) -> ())((f32::to_bits : (f32) -> u32)((generic/5 : f32)));
    (println : (string) -> ())(
      (isize::to_string : (isize) -> string)(
        (classify : (f32) -> isize)((float32_from_bits : (u32) -> f32)(1065353217))
      )
    );
    let tiny32/6: f32 = 0;
