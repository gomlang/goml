fn make_counter() -> (() -> i32, () -> ()) {
    let cell/0: Ref[i32] = (Ref[i32]::new : (i32) -> Ref[i32])(0);
    let next/2: () -> i32 =
      || =>
        {
            let next/1: i32 = (Ref[i32]::get : (Ref[i32]) -> i32)((cell/0 : Ref[i32])) + 1;
            let _ : () =
              (Ref[i32]::set : (Ref[i32], i32) -> ())((cell/0 : Ref[i32]), (next/1 : i32));
            (next/1 : i32)
        };
    let reset/3: () -> () =
      || =>
        {
            let _ : () = (Ref[i32]::set : (Ref[i32], i32) -> ())((cell/0 : Ref[i32]), 0);
        };
    ((next/2 : () -> i32), (reset/3 : () -> ()))
}

fn main() -> () {
    let counter/4: (() -> i32, () -> ()) = (make_counter : () -> (() -> i32, () -> ()))();
    let (next/5: () -> i32, reset/6: () -> ()) = (counter/4 : (() -> i32, () -> ()));
    let first/7: i32 = (next/5 : () -> i32)();
    let second/8: i32 = (next/5 : () -> i32)();
    let _ : () = (reset/6 : () -> ())();
    let third/9: i32 = (next/5 : () -> i32)();
    let new_counter/10: (() -> i32, () -> ()) = (make_counter : () -> (() -> i32, () -> ()))();
    let (new_next/11: () -> i32, _ : () -> ()) = (new_counter/10 : (() -> i32, () -> ()));
    let fourth/12: i32 = (new_next/11 : () -> i32)();
    let _ : () = (println : (string) -> ())((i32::to_string : (i32) -> string)((first/7 : i32)));
    let _ : () = (println : (string) -> ())((i32::to_string : (i32) -> string)((second/8 : i32)));
    let _ : () = (println : (string) -> ())((i32::to_string : (i32) -> string)((third/9 : i32)));
    let _ : () = (println : (string) -> ())((i32::to_string : (i32) -> string)((fourth/12 : i32)));
}