package main
file main.goml
  fn main() -> () {
      let local/1/0 = Vec::from_array([1, 2, 3, 4, 5]);
      let local/1/1 = values/0.slice_mut(1, 5);
      view/1[0] = 20;
      println(view/1.set_checked(9, 30));
      println(view/1.set_checked(1, 30));
      println(view/1.copy_within(0, 3, 1));
      println(view/1.copy_from(0, Vec::from_array([7, 8]).as_slice()));
      match view/1.sub_checked(1, 3) {
          Some(local/1/2) => part/2.fill(6),
          None => (),
      };
      for local/1/3 in
        values/0 {
          println(value/3)
      };
      println(values/0.slice_checked(-1, 2).is_none());
      println(view/1.as_slice().get_checked(10).is_none())
  }