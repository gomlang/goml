fn maybe_value(flag/0: bool) -> Option[i32] {
    if (flag/0 : bool) {
        {
            Option::Some(4)
        }
    } else {
        {
            Option::None
        }
    }
}

fn with_base(base/1: i32, flag/2: bool) -> Option[i32] {
    let run/4: () -> Option[i32] =
      || =>
        {
            let value/3: i32 =
              match (maybe_value : (bool) -> Option[i32])((flag/2 : bool)) {
                  Option::Some(try_value/11: i32) => (try_value/11 : i32),
                  Option::None => return Option::None,
              };
            Option::Some((value/3 : i32) + (base/1 : i32))
        };
    (run/4 : () -> Option[i32])()
}

fn show(opt/5: Option[i32]) -> string {
    match (opt/5 : Option[i32]) {
        Option::Some(value/6: i32) => "some=" + (i32::to_string : (i32) -> string)((value/6 : i32)),
        Option::None => "none",
    }
}

fn main() -> () {
    (println : (string) -> ())(
      (show : (Option[i32]) -> string)((with_base : (i32, bool) -> Option[i32])(3, true))
    );
    (println : (string) -> ())(
      (show : (Option[i32]) -> string)((with_base : (i32, bool) -> Option[i32])(3, false))
