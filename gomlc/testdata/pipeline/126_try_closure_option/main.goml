fn maybe_value(flag: bool) -> Option[i32] {
    if flag {
        Option::Some(4)
    } else {
        Option::None
    }
}

fn with_base(base: i32, flag: bool) -> Option[i32] {
    let run = || {
        let value = maybe_value(flag)?;
        Option::Some(value + base)
    };
    run()
}

fn show(opt: Option[i32]) -> string {
    match opt {
        Option::Some(value) => "some=" + value.to_string(),
        Option::None => "none",
    }
}

fn main() -> () {
    println(show(with_base(3, true)));
    println(show(with_base(3, false)));
}
