fn match_string(s/0: string) -> i32 {
    match (s/0 : string) {
        "hello" => 1,
        "world" => 2,
        _ : string => 3,
    }
}

fn wildcard_position(s/1: string) -> i32 {
    match (s/1 : string) {
        _ : string => 4,
        "world" => 5,
    }
}

fn repeated_string(s/2: string) -> i32 {
    match (s/2 : string) {
        "hello" => 6,
        "hello" => 7,
        _ : string => 8,
    }
}

fn main() -> () {
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)((match_string : (string) -> i32)("hello"))
      );
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)((match_string : (string) -> i32)("planet"))
      );
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)((wildcard_position : (string) -> i32)("world"))
      );
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)((wildcard_position : (string) -> i32)("sun"))
      );
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)((repeated_string : (string) -> i32)("hello"))
      );
    (println : (string) -> ())(
      (i32::to_string : (i32) -> string)((repeated_string : (string) -> i32)("mars"))
    )
}