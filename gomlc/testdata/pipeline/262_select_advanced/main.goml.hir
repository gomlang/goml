package main
file main.goml
  fn mark_channel(
    local/main/0: Ref[string],
    local/main/1: string,
    local/main/2: Channel[isize]
  ) -> Channel[isize] {
      log/0.set(log/0.get() + mark/1);
      channel/2
  }

  fn mark_value(local/main/3: Ref[string], local/main/4: string, local/main/5: isize) -> isize {
      log/3.set(log/3.get() + mark/4);
      value/5
  }

  fn mark_guard(local/main/6: Ref[string], local/main/7: string, local/main/8: bool) -> bool {
      log/6.set(log/6.get() + mark/7);
      value/8
  }

  fn main() -> () {
      let local/main/9 = Ref::new("");
