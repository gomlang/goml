package main;
#[derive(Hash, PartialEq, Eq)]
enum Key {
    A,
    B(i32)
}

impl Hash for Key {
  fn hash(self: Key) -> u64 {
      match self {
          Key::A =>
            {
                let h = 0.to_u64() + 14695981039346656037 + 1;
                h
            },
          Key::B(#derive0_field) =>
            {
                let h = 0.to_u64() + 14695981039346656037 + 2;
                let h = h * 0.to_u64() + 1099511628211 + Hash::hash(#derive0_field);
                h
            },
      }
  }
}

impl PartialEq for Key {
  fn eq(self: Key, other: Key) -> bool {
      match (self, other) {
          (Key::A, Key::A) => true,
          (Key::B(#derive0_left), Key::B(#derive1_right)) =>
            true && PartialEq::eq(#derive0_left, #derive1_right),
          _ => false,
      }
  }
}

impl Eq for Key where i32: Eq {}

fn print_opt_int(x: Option[i32]) -> () {
    match x {
        Option::Some(v) => println(v),
        Option::None => println("none"),
    }
}

fn main() -> () {
    let v = Vec::new();
    v.push(10);
    v.push(20);
    v.push(30);
    println(v.get(0));
    println(v.get(1));
    println(v.get(2));
    println(v.len());
    let m = HashMap::new();
    m.set(Key::A, 10);
    m.set(Key::B(1), 20);
    println(m.len());
    print_opt_int(m.get(Key::A));
    println(m.contains(Key::B(1)));
    m.remove(Key::B(1));
    println(m.contains(Key::B(1)));
    println(m.len());
}

