impl Hash for Key {
  fn hash(self/0: Key) -> u64 {
      match (self/0 : Key) {
          Key::A =>
            {
                let h/1: u64 = (isize::to_u64 : (isize) -> u64)(0) + 14695981039346656037 + 1;
                (h/1 : u64)
            },
          Key::B(#derive0_field/2: i32) =>
            {
                let h/3: u64 = (isize::to_u64 : (isize) -> u64)(0) + 14695981039346656037 + 2;
                let h/4: u64 =
                  (h/3 : u64) * (isize::to_u64 : (isize) -> u64)(0) + 1099511628211 +
                    (Hash::hash : (i32) -> u64)((#derive0_field/2 : i32));
                (h/4 : u64)
            },
      }
  }
}

impl PartialEq for Key {
  fn eq(self/5: Key, other/6: Key) -> bool {
      match ((self/5 : Key), (other/6 : Key)) {
          (Key::A, Key::A) => true,
          (Key::B(#derive0_left/7: i32), Key::B(#derive1_right/8: i32)) =>
            true &&
              (PartialEq::eq : (i32, i32) -> bool)(
                (#derive0_left/7 : i32),
                (#derive1_right/8 : i32)
              ),
          _ : (Key, Key) => false,
      }
  }
}

impl Eq for Key where i32: Eq, i32: PartialEq {}

fn print_opt_int(x/9: Option[i32]) -> () {
    match (x/9 : Option[i32]) {
        Option::Some(v/10: i32) => (println : (i32) -> ())((v/10 : i32)),
        Option::None => (println : (string) -> ())("none"),
    }
}

