package main
file main.goml
  struct Marker {}

  enum Shared {
      First(u8),
      Second(u8),
      Wide(u16),
      Empty
  }

  enum ZeroSized {
      MarkerValue(Marker),
      UnitValue(())
  }

  enum MaybeByte {
      None,
      Some(u8)
  }

  enum MaybeSigned {
      None,
      Some(i32)
  }

  enum MaybeVec {
      None,
      Some(Vec[i32])
  }

  enum Outer {
      None,
      Some(Inner)
  }

  enum Inner {
      Left(u8),
      Right(u8)
  }

  enum List {
      Nil,
      Cons(i32, List)
  }

  fn shared_value(local/1/0: Shared) -> isize {
      match value/0 {
          ctor(def/1/1::v0)(local/1/1) => value/1.to_isize(),
          ctor(def/1/1::v1)(local/1/2) => value/2.to_isize() + 10,
          ctor(def/1/1::v2)(local/1/3) => value/3.to_isize() + 20,
          ctor(def/1/1::v3) => 0,
      }
  }

  fn maybe_byte(local/1/4: MaybeByte) -> isize {
      match value/4 {
          ctor(def/1/3::v0) => 0,
          ctor(def/1/3::v1)(local/1/5) => value/5.to_isize(),
      }
  }

  fn maybe_signed(local/1/6: MaybeSigned) -> i32 {
      match value/6 {
          ctor(def/1/4::v0) => 0,
          ctor(def/1/4::v1)(local/1/7) => value/7,
      }
  }

  fn maybe_vec(local/1/8: MaybeVec) -> isize {
      match value/8 {
          ctor(def/1/5::v0) => 0,
          ctor(def/1/5::v1)(local/1/9) => value/9.len(),
      }
  }

  fn outer_value(local/1/10: Outer) -> isize {
      match value/10 {
          ctor(def/1/6::v0) => 0,
          ctor(def/1/6::v1)(ctor(def/1/7::v0)(local/1/11)) => value/11.to_isize(),
          ctor(def/1/6::v1)(ctor(def/1/7::v1)(local/1/12)) => value/12.to_isize() + 1,
      }
  }

  fn list_sum(local/1/13: List) -> i32 {
      match value/13 {
          ctor(def/1/8::v0) => 0,
          ctor(def/1/8::v1)(local/1/14, local/1/15) => head/14 + def/1/14(tail/15),
      }
  }

  fn main() -> () {
      println(def/1/9(ctor(def/1/1::v0)(3)));
      println(def/1/9(ctor(def/1/1::v1)(4)));
      println(def/1/9(ctor(def/1/1::v2)(5)));
      println(def/1/10(ctor(def/1/3::v1)(255)));
      println(def/1/11(ctor(def/1/4::v1)(-7)));
      println(def/1/11(ctor(def/1/4::v1)(-2147483648)));
      let local/1/16: Vec[i32] = Vec::new();
      values/16.push(7);
      println(def/1/12(ctor(def/1/5::v1)(values/16)));
      println(def/1/13(ctor(def/1/6::v1)(ctor(def/1/7::v1)(8))));
      println(def/1/14(ctor(def/1/8::v1)(1, ctor(def/1/8::v1)(2, ctor(def/1/8::v0)))));
      match ctor(def/1/2::v0)(Marker {}) {
          ctor(def/1/2::v0)(_) => println(1),
          ctor(def/1/2::v1)(_) => println(2),
      }
  }