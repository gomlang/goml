package main
file main.goml
  struct Marker {}

  enum Shared {
      First(u8),
      Second(u8),
      Wide(u16),
      Empty
  }

  enum ZeroSized {
      MarkerValue(Marker),
      UnitValue(())
  }

  enum MaybeByte {
      None,
      Some(u8)
  }

  enum MaybeSigned {
      None,
      Some(i32)
  }

  enum MaybeVec {
      None,
      Some(Vec[i32])
  }

  enum Outer {
      None,
      Some(Inner)
  }

  enum Inner {
      Left(u8),
      Right(u8)
  }

  enum List {
      Nil,
      Cons(i32, List)
  }

  fn shared_value(local/main/0: Shared) -> isize {
      match value/0 {
          ctor(source:4:main:1::v0)(local/main/1) => value/1.to_isize(),
          ctor(source:4:main:1::v1)(local/main/2) => value/2.to_isize() + 10,
          ctor(source:4:main:1::v2)(local/main/3) => value/3.to_isize() + 20,
          ctor(source:4:main:1::v3) => 0,
      }
  }

  fn maybe_byte(local/main/4: MaybeByte) -> isize {
      match value/4 {
          ctor(source:4:main:3::v0) => 0,
          ctor(source:4:main:3::v1)(local/main/5) => value/5.to_isize(),
      }
  }

  fn maybe_signed(local/main/6: MaybeSigned) -> i32 {
      match value/6 {
          ctor(source:4:main:4::v0) => 0,
          ctor(source:4:main:4::v1)(local/main/7) => value/7,
      }
  }

  fn maybe_vec(local/main/8: MaybeVec) -> isize {
      match value/8 {
          ctor(source:4:main:5::v0) => 0,
          ctor(source:4:main:5::v1)(local/main/9) => value/9.len(),
      }
  }

  fn outer_value(local/main/10: Outer) -> isize {
      match value/10 {
          ctor(source:4:main:6::v0) => 0,
          ctor(source:4:main:6::v1)(ctor(source:4:main:7::v0)(local/main/11)) =>
            value/11.to_isize(),
          ctor(source:4:main:6::v1)(ctor(source:4:main:7::v1)(local/main/12)) =>
            value/12.to_isize() + 1,
      }
  }

  fn list_sum(local/main/13: List) -> i32 {
      match value/13 {
          ctor(source:4:main:8::v0) => 0,
          ctor(source:4:main:8::v1)(local/main/14, local/main/15) =>
            head/14 + source:4:main:14(tail/15),
      }
  }

  fn main() -> () {
      println(source:4:main:9(ctor(source:4:main:1::v0)(3)));
      println(source:4:main:9(ctor(source:4:main:1::v1)(4)));
      println(source:4:main:9(ctor(source:4:main:1::v2)(5)));
      println(source:4:main:10(ctor(source:4:main:3::v1)(255)));
      println(source:4:main:11(ctor(source:4:main:4::v1)(-7)));
      println(source:4:main:11(ctor(source:4:main:4::v1)(-2147483648)));
      let local/main/16: Vec[i32] = Vec::new();
      values/16.push(7);
      println(source:4:main:12(ctor(source:4:main:5::v1)(values/16)));
      println(source:4:main:13(ctor(source:4:main:6::v1)(ctor(source:4:main:7::v1)(8))));
      println(
        source:4:main:14(
          ctor(source:4:main:8::v1)(1, ctor(source:4:main:8::v1)(2, ctor(source:4:main:8::v0)))
        )
      );
      match ctor(source:4:main:2::v0)(Marker {}) {
          ctor(source:4:main:2::v0)(_) => println(1),
          ctor(source:4:main:2::v1)(_) => println(2),
      }
  }