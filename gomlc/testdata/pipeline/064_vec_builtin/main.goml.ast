package main;
fn main() -> () {
    let v: Vec[i32] = Vec::new();
    v.push(10);
    v.push(20);
    v.push(30);
    let first = v[0];
    let second = v[1];
    let third = v[2];
    let len = v.len();
    let _ = println(first.to_string());
    let _ = println(second.to_string());
    let _ = println(third.to_string());
    let _ = println(len.to_string());
}

