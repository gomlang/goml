  trait Arith {
    fn add(Self, Self) -> i32;
    fn less(Self, Self) -> bool;
  }

  impl Arith for i32 {
    fn add(local/1/0: i32, local/1/1: i32) -> i32 {
        self/0 + other/1
    }
    fn less(local/1/2: i32, local/1/3: i32) -> bool {
        self/2 < other/3
    }
  }

  trait Output {
    fn output(Self) -> ();
  }

  impl Output for i32 {
    fn output(local/1/4: i32) -> () {
        println(ToString::to_string(self/4))
    }
  }

  impl Output for bool {
    fn output(local/1/5: bool) -> () {
        println(ToString::to_string(self/5))
    }
  }

  fn id[T](local/1/6: T) -> T {
      x/6
  }

