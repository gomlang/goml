  trait Arith {
    fn add(Self, Self) -> i32;
    fn less(Self, Self) -> bool;
  }

  impl Arith for i32 {
    fn add(local/main/0: i32, local/main/1: i32) -> i32 {
        self/0 + other/1
    }
    fn less(local/main/2: i32, local/main/3: i32) -> bool {
        self/2 < other/3
    }
  }

  trait Output {
    fn output(Self) -> ();
  }

  impl Output for i32 {
    fn output(local/main/4: i32) -> () {
        println(ToString::to_string(self/4))
    }
  }

  impl Output for bool {
    fn output(local/main/5: bool) -> () {
        println(ToString::to_string(self/5))
    }
  }

  fn id[T](local/main/6: T) -> T {
      x/6
  }

