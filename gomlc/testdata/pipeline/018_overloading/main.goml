trait Arith {
    fn add(self: Self, arg1: Self) -> i32;
    fn less(self: Self, arg1: Self) -> bool;
}

impl Arith for i32 {
    fn add(self: i32, other: i32) -> i32 {
        self + other
    }

    fn less(self: i32, other: i32) -> bool {
        self < other
    }
}

trait Output {
    fn output(self: Self) -> ();
}

impl Output for i32 {
    fn output(self: i32) -> () {
        println(ToString::to_string(self))
    }
}

impl Output for bool {
    fn output(self: bool) -> () {
        println(ToString::to_string(self))
    }
}

fn id[T](x: T) -> T {
    x
}

fn main() {
    let a: i32 = id(1);
    let b: i32 = id(2);
    let c = Arith::add(a, b);
    let _ = Output::output(c);
    let a: i32 = id(3);
    let b: i32 = id(4);
    let c = Arith::less(a, b);
    let _ = Output::output(c);
    let _ = id("abc");
    let _ = id(true);
}
