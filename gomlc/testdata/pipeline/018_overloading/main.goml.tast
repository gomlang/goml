impl Arith for i32 {
  fn add(self/0: i32, other/1: i32) -> i32 {
      (self/0 : i32) + (other/1 : i32)
  }
  fn less(self/2: i32, other/3: i32) -> bool {
      (self/2 : i32) < (other/3 : i32)
  }
}

impl Output for i32 {
  fn output(self/4: i32) -> () {
      (println : (string) -> ())((ToString::to_string : (i32) -> string)((self/4 : i32)))
  }
}

impl Output for bool {
  fn output(self/5: bool) -> () {
      (println : (string) -> ())((ToString::to_string : (bool) -> string)((self/5 : bool)))
  }
}

fn id[T](x/6: T) -> T {
    (x/6 : T)
}

fn main() -> () {
    let a/7: i32 = (id : (i32) -> i32)(1);
    let b/8: i32 = (id : (i32) -> i32)(2);
    let c/9: i32 = (Arith::add : (i32, i32) -> i32)((a/7 : i32), (b/8 : i32));
    let _ : () = (Output::output : (i32) -> ())((c/9 : i32));
    let a/10: i32 = (id : (i32) -> i32)(3);
    let b/11: i32 = (id : (i32) -> i32)(4);
    let c/12: bool = (Arith::less : (i32, i32) -> bool)((a/10 : i32), (b/11 : i32));
    let _ : () = (Output::output : (bool) -> ())((c/12 : bool));
    let _ : string = (id : (string) -> string)("abc");
    let _ : bool = (id : (bool) -> bool)(true);
}