fn early(x: i32) -> i32 {
    if x < 0 {
        return 0
    } else {};
    if x == 0 {
        return 1
    } else {};
    x + 2
}

fn closure_early(x: i32) -> i32 {
    let f = |y: i32| {
        if y > 5 {
            return y
        } else {};
        y + 10
    };
    f(x)
}

fn unit_ret(flag: bool) {
    if flag {
        return
    } else {};
    let _ = println("after");
}

fn main() {
    let _ = print("e-1: ");
    let _ = println(early(-1));
    let _ = print("e0: ");
    let _ = println(early(0));
    let _ = print("e3: ");
    let _ = println(early(3));
    let _ = print("c7: ");
    let _ = println(closure_early(7));
    let _ = print("c2: ");
    let _ = println(closure_early(2));
    unit_ret(true);
    unit_ret(false);
}
