package main
file main.goml
  trait Mark {
    fn mark(Self) -> ();
  }

  trait Extra {
    fn extra(Self) -> i32;
  }

  impl Mark for i32 {
    fn mark(local/main/0: i32) -> () {}
  }

  impl[T: Mark] Extra for T {
    fn extra(local/main/1: T) -> i32 {
        42
    }
  }

  fn apply[T: Extra](local/main/2: T) -> i32 {
      value/2.extra()
  }

  fn main() -> () {
      let local/main/3: i32 = 1;
      let local/main/4: i32 = 2;
      println(source:4:main:4(first/3));
      println(second/4.extra());
  }