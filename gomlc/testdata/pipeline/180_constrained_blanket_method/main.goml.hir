package main
file main.goml
  trait Mark {
    fn mark(Self) -> ();
  }

  trait Extra {
    fn extra(Self) -> i32;
  }

  impl Mark for i32 {
    fn mark(local/1/0: i32) -> () {}
  }

  impl[T: Mark] Extra for T {
    fn extra(local/1/1: T) -> i32 {
        42
    }
  }

  fn apply[T: Extra](local/1/2: T) -> i32 {
      value/2.extra()
  }

  fn main() -> () {
      let local/1/3: i32 = 1;
      let local/1/4: i32 = 2;
      println(def/1/4(first/3));
      println(second/4.extra());
  }