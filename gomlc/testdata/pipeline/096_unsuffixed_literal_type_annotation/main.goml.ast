package main;
fn take_u8(x: u8) -> u8 {
    x
}

fn take_f32(x: f32) -> f32 {
    x
}

fn main() {
    let a: u8 = 1;
    let b: i8 = 2;
    let c: i16 = 3;
    let d: u16 = 4;
    let e: u32 = 5;
    let f: i64 = 6;
    let g: u64 = 7;
    let h: f32 = 1.0;
    println(a.to_string());
    println(b.to_string());
    println(c.to_string());
    println(d.to_string());
    println(e.to_string());
    println(f.to_string());
    println(g.to_string());
    println(h.to_string());
    println(take_u8(10).to_string());
    println(take_f32(2.5).to_string());
}

