impl Display for i32 {
  fn show(self/0: i32) -> string {
      (i32::to_string : (i32) -> string)((self/0 : i32))
  }
}

fn render(value/1: Boxed) -> string {
    match (value/1 : Boxed) {
        Boxed::One(inner/2: dyn Display) =>
          (dyn Display::show : (dyn Display) -> string)((inner/2 : dyn Display)),
        Boxed::Pair(left/3: dyn Display, right/4: dyn Display) =>
          (dyn Display::show : (dyn Display) -> string)((left/3 : dyn Display)) + "-" +
            (dyn Display::show : (dyn Display) -> string)((right/4 : dyn Display)),
    }
}

fn main() -> () {
    let one/5: i32 = 42;
    let left/6: i32 = 7;
    let right/7: i32 = 9;
    (println : (string) -> ())(
      (render : (Boxed) -> string)(Boxed::One(to_dyn[Display]{i32}((one/5 : i32))))
    );
    (println : (string) -> ())(
      (render : (Boxed) -> string)(
        Boxed::Pair(to_dyn[Display]{i32}((left/6 : i32)), to_dyn[Display]{i32}((right/7 : i32)))
      )
    );
}