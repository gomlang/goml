package main
file main.goml
  trait Display {
    fn show(Self) -> string;
  }

  impl Display for i32 {
    fn show(local/main/0: i32) -> string {
        self/0.to_string()
    }
  }

  enum Boxed {
      One(dyn Display),
      Pair(dyn Display, dyn Display)
  }

  fn render(local/main/1: Boxed) -> string {
      match value/1 {
          ctor(source:4:main:2::v0)(local/main/2) => Display::show(inner/2),
          ctor(source:4:main:2::v1)(local/main/3, local/main/4) =>
            Display::show(left/3) + "-" + Display::show(right/4),
      }
  }

  fn main() -> () {
      let local/main/5: i32 = 42;
      let local/main/6: i32 = 7;
      let local/main/7: i32 = 9;
      println(source:4:main:3(ctor(source:4:main:2::v0)(one/5 as dyn Display)));
      println(
        source:4:main:3(ctor(source:4:main:2::v1)(left/6 as dyn Display, right/7 as dyn Display))
      );
  }