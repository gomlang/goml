package main
file main.goml
  trait Display {
    fn show(Self) -> string;
  }

  impl Display for i32 {
    fn show(local/1/0: i32) -> string {
        self/0.to_string()
    }
  }

  enum Boxed {
      One(dyn Display),
      Pair(dyn Display, dyn Display)
  }

  fn render(local/1/1: Boxed) -> string {
      match value/1 {
          ctor(def/1/2::v0)(local/1/2) => Display::show(inner/2),
          ctor(def/1/2::v1)(local/1/3, local/1/4) =>
            Display::show(left/3) + "-" + Display::show(right/4),
      }
  }

  fn main() -> () {
      let local/1/5: i32 = 42;
      let local/1/6: i32 = 7;
      let local/1/7: i32 = 9;
      println(def/1/3(ctor(def/1/2::v0)(one/5 as dyn Display)));
      println(def/1/3(ctor(def/1/2::v1)(left/6 as dyn Display, right/7 as dyn Display)));
  }