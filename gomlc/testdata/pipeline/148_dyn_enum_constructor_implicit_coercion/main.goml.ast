package main;
trait Display {
  fn show(self: Self) -> string;
}

impl Display for i32 {
  fn show(self: i32) -> string {
      self.to_string()
  }
}

enum Boxed {
    One(dyn Display),
    Pair(dyn Display, dyn Display)
}

fn render(value: Boxed) -> string {
    match value {
        Boxed::One(inner) => Display::show(inner),
        Boxed::Pair(left, right) => Display::show(left) + "-" + Display::show(right),
    }
}

fn main() -> () {
    let one: i32 = 42;
    let left: i32 = 7;
    let right: i32 = 9;
    println(render(Boxed::One(one as dyn Display)));
    println(render(Boxed::Pair(left as dyn Display, right as dyn Display)));
}

