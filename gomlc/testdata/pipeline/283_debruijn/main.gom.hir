package main
file main.gom
  enum Named {
      Var(string),
      Lam(string, Named),
      App(Named, Named)
  }

  enum Term {
      Var(isize),
      Lam(Term),
      App(Term, Term)
  }

  impl PartialEq for Term {
    fn eq(local/1/0: Term, local/1/1: Term) -> bool {
        match (self/0, other/1) {
            (ctor(def/1/1::v0)(local/1/2), ctor(def/1/1::v0)(local/1/3)) => left/2 == right/3,
            (ctor(def/1/1::v1)(local/1/4), ctor(def/1/1::v1)(local/1/5)) => left/4 == right/5,
            (ctor(def/1/1::v2)(local/1/6, local/1/7), ctor(def/1/1::v2)(local/1/8, local/1/9)) =>
              left_fn/6 == right_fn/8 && left_arg/7 == right_arg/9,
            _ => false,
        }
    }
  }

  enum Context {
