  }

  fn render(local/1/21: Term) -> string {
      match term/21 {
          ctor(def/1/1::v0)(local/1/22) => index/22.to_string(),
          ctor(def/1/1::v1)(local/1/23) => "(lambda " + def/1/6(body/23) + ")",
          ctor(def/1/1::v2)(local/1/24, local/1/25) =>
