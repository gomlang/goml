  }

  fn well_scoped(local/1/26: Term, local/1/27: isize) -> bool {
      match term/26 {
          ctor(def/1/1::v0)(local/1/28) => index/28 >= 0 && index/28 < size/27,
          ctor(def/1/1::v1)(local/1/29) => def/1/7(body/29, size/27 + 1),
          ctor(def/1/1::v2)(local/1/30, local/1/31) =>
            def/1/7(left/30, size/27) && def/1/7(right/31, size/27),
      }
  }

  fn shift(local/1/32: Term, local/1/33: isize, local/1/34: isize) -> Term {
      match term/32 {
          ctor(def/1/1::v0)(local/1/35) =>
            ctor(def/1/1::v0)(
              if index/35 < cutoff/34 {
                  index/35
              } else {
                  index/35 + amount/33
              }
            ),
          ctor(def/1/1::v1)(local/1/36) =>
            ctor(def/1/1::v1)(def/1/8(body/36, amount/33, cutoff/34 + 1)),
          ctor(def/1/1::v2)(local/1/37, local/1/38) =>
            ctor(def/1/1::v2)(
              def/1/8(left/37, amount/33, cutoff/34),
              def/1/8(right/38, amount/33, cutoff/34)
            ),
      }
  }

  fn instantiate(local/1/39: Term, local/1/40: Term, local/1/41: isize) -> Term {
      match body/39 {
          ctor(def/1/1::v0)(local/1/42) =>
            {
                if index/42 < depth/41 {
                    ctor(def/1/1::v0)(index/42)
                } else if index/42 == depth/41 {
                    def/1/8(argument/40, depth/41, 0)
                } else {
                    ctor(def/1/1::v0)(index/42 - 1)
                }
            },
          ctor(def/1/1::v1)(local/1/43) =>
            ctor(def/1/1::v1)(def/1/9(inner/43, argument/40, depth/41 + 1)),
          ctor(def/1/1::v2)(local/1/44, local/1/45) =>
            ctor(def/1/1::v2)(
              def/1/9(left/44, argument/40, depth/41),
              def/1/9(right/45, argument/40, depth/41)
            ),
