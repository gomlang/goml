      Bind(string, Context)
  }

  fn lookup(local/1/10: string, local/1/11: Context) -> Result[isize, string] {
      match context/11 {
          ctor(def/1/3::v0) => Result::Err("unbound variable: " + name/10),
          ctor(def/1/3::v1)(local/1/12, local/1/13) =>
            {
                if name/10 == bound/12 {
                    Result::Ok(0)
                } else {
                    Result::Ok(def/1/4(name/10, rest/13)? + 1)
                }
            },
      }
  }

  fn translate(local/1/14: Named, local/1/15: Context) -> Result[Term, string] {
      match term/14 {
          ctor(def/1/0::v0)(local/1/16) =>
            Result::Ok(ctor(def/1/1::v0)(def/1/4(name/16, context/15)?)),
          ctor(def/1/0::v1)(local/1/17, local/1/18) =>
            Result::Ok(
              ctor(def/1/1::v1)(def/1/5(body/18, ctor(def/1/3::v1)(name/17, context/15))?)
            ),
          ctor(def/1/0::v2)(local/1/19, local/1/20) =>
            Result::Ok(
              ctor(def/1/1::v2)(def/1/5(left/19, context/15)?, def/1/5(right/20, context/15)?)
