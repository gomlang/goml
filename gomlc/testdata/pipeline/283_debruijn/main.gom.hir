  fn check_beta(
    local/1/62: string,
    local/1/63: Term,
    local/1/64: Term,
    local/1/65: isize,
    local/1/66: Term
  ) -> () {
      let local/1/67 = def/1/9(body/63, argument/64, 0);
      let local/1/68 = def/1/11(body/63, def/1/12(argument/64));
      println(label/62 + ": " + def/1/6(actual/67));
      println(
        "expected=" + actual/67 == expected/66.to_string() + " simultaneous=" +
          actual/67 == simultaneous/68.to_string() +
          " scoped=" +
          def/1/7(body/63, size/65 + 1) && def/1/7(argument/64, size/65) &&
            def/1/7(actual/67, size/65).to_string()
      );
  }

  fn main() -> () {
      let local/1/69 = ctor(def/1/3::v0);
      let local/1/70 = ctor(def/1/0::v0)("x");
      let local/1/71 = ctor(def/1/0::v0)("y");
      let local/1/72 = ctor(def/1/0::v0)("z");
      let local/1/73 = ctor(def/1/1::v0)(0);
      let local/1/74 = ctor(def/1/1::v0)(1);
      let local/1/75 = ctor(def/1/1::v0)(2);
      let local/1/76 = ctor(def/1/1::v1)(zero/73);
      def/1/13("identity x", ctor(def/1/0::v1)("x", x/70), empty/69, identity/76);
      def/1/13("identity y", ctor(def/1/0::v1)("y", y/71), empty/69, identity/76);
      def/1/13(
        "outer",
        ctor(def/1/0::v1)("x", ctor(def/1/0::v1)("y", x/70)),
        empty/69,
        ctor(def/1/1::v1)(ctor(def/1/1::v1)(one/74))
      );
      def/1/13(
        "inner",
        ctor(def/1/0::v1)("x", ctor(def/1/0::v1)("y", y/71)),
        empty/69,
        ctor(def/1/1::v1)(identity/76)
      );
      def/1/13(
        "application",
        ctor(def/1/0::v1)("x", ctor(def/1/0::v1)("y", ctor(def/1/0::v2)(x/70, y/71))),
        empty/69,
        ctor(def/1/1::v1)(ctor(def/1/1::v1)(ctor(def/1/1::v2)(one/74, zero/73)))
      );
      def/1/13(
        "shadowing",
        ctor(def/1/0::v1)("x", ctor(def/1/0::v2)(ctor(def/1/0::v1)("x", x/70), x/70)),
        empty/69,
        ctor(def/1/1::v1)(ctor(def/1/1::v2)(identity/76, zero/73))
      );
      def/1/13(
        "relative address",
        ctor(def/1/0::v1)(
          "x",
          ctor(def/1/0::v2)(x/70, ctor(def/1/0::v1)("y", ctor(def/1/0::v2)(x/70, y/71)))
        ),
        empty/69,
        ctor(def/1/1::v1)(
          ctor(def/1/1::v2)(zero/73, ctor(def/1/1::v1)(ctor(def/1/1::v2)(one/74, zero/73)))
        )
      );
      def/1/13(
        "three binders",
        ctor(def/1/0::v1)(
          "x",
          ctor(def/1/0::v1)(
            "y",
            ctor(def/1/0::v1)(
              "z",
              ctor(def/1/0::v2)(ctor(def/1/0::v2)(x/70, z/72), ctor(def/1/0::v2)(y/71, z/72))
            )
          )
        ),
        empty/69,
        ctor(def/1/1::v1)(
          ctor(def/1/1::v1)(
            ctor(def/1/1::v1)(
              ctor(def/1/1::v2)(
                ctor(def/1/1::v2)(two/75, zero/73),
                ctor(def/1/1::v2)(one/74, zero/73)
              )
            )
          )
        )
      );
      let local/1/77 = ctor(def/1/3::v1)("y", ctor(def/1/3::v1)("z", empty/69));
      def/1/13("free y", y/71, external/77, zero/73);
      def/1/13("free z", z/72, external/77, one/74);
      def/1/13("open y", ctor(def/1/0::v1)("x", y/71), external/77, ctor(def/1/1::v1)(one/74));
      def/1/13("open z", ctor(def/1/0::v1)("x", z/72), external/77, ctor(def/1/1::v1)(two/75));
      def/1/13("external shadowing", ctor(def/1/0::v1)("y", y/71), external/77, identity/76);
      def/1/13("missing", ctor(def/1/0::v2)(ctor(def/1/0::v1)("x", x/70), x/70), empty/69, zero/73);
      println(
        "different binders=" +
          ctor(def/1/1::v1)(ctor(def/1/1::v1)(one/74)) != ctor(def/1/1::v1)(identity/76).to_string()
      );
      let local/1/78 = ctor(def/1/1::v1)(ctor(def/1/1::v2)(one/74, zero/73));
      let local/1/79 = def/1/8(open_function/78, 1, 0);
      println("shift cutoff: " + def/1/6(shifted/79));
      println(
        "shift expected=" +
          shifted/79 == ctor(def/1/1::v1)(ctor(def/1/1::v2)(two/75, zero/73)).to_string()
      );
      println("shift zero=" + def/1/8(open_function/78, 0, 0) == open_function/78.to_string());
      println("shift closed=" + def/1/8(identity/76, 3, 0) == identity/76.to_string());
      println(
        "substitution identity=" +
          def/1/11(open_function/78, |local/1/80| ctor(def/1/1::v0)(index/80)) ==
            open_function/78.to_string()
      );
      println(
        "substitution shift=" +
          def/1/11(open_function/78, |local/1/81| ctor(def/1/1::v0)(index/81 + 1)) ==
            shifted/79.to_string()
      );
      def/1/14("identity beta", zero/73, identity/76, 0, identity/76);
      def/1/14("avoid capture", ctor(def/1/1::v1)(one/74), zero/73, 1, ctor(def/1/1::v1)(one/74));
      def/1/14(
        "all three cases",
        ctor(def/1/1::v1)(ctor(def/1/1::v2)(ctor(def/1/1::v2)(two/75, one/74), zero/73)),
        zero/73,
        1,
        ctor(def/1/1::v1)(ctor(def/1/1::v2)(ctor(def/1/1::v2)(one/74, one/74), zero/73))
      );
      def/1/14(
        "argument local binder",
        ctor(def/1/1::v1)(one/74),
        open_function/78,
        1,
        ctor(def/1/1::v1)(shifted/79)
      );
      def/1/14(
        "two nested binders",
        ctor(def/1/1::v1)(ctor(def/1/1::v1)(ctor(def/1/1::v2)(two/75, zero/73))),
        zero/73,
        1,
        ctor(def/1/1::v1)(ctor(def/1/1::v1)(ctor(def/1/1::v2)(two/75, zero/73)))
      );
      def/1/14("unused argument", ctor(def/1/1::v1)(zero/73), open_function/78, 1, identity/76);
      def/1/14("remove external slot", one/74, identity/76, 1, zero/73);
      def/1/14(
        "duplicate argument",
        ctor(def/1/1::v2)(zero/73, zero/73),
        identity/76,
        0,
        ctor(def/1/1::v2)(identity/76, identity/76)
      );
      println("closed scope=" + def/1/7(identity/76, 0).to_string());
      println("open scope=" + def/1/7(open_function/78, 1).to_string());
      println("missing external scope=" + def/1/7(open_function/78, 0).to_string());
      println("negative index=" + def/1/7(ctor(def/1/1::v0)(-1), 1).to_string());
      println("index at boundary=" + def/1/7(one/74, 1).to_string());
  }