  }

  fn lift_substitution(local/1/46: (isize) -> Term) -> (isize) -> Term {
      |local/1/47| if index/47 == 0 {
          ctor(def/1/1::v0)(0)
      } else {
          def/1/8(sigma/46(index/47 - 1), 1, 0)
      }
  }

  fn substitute(local/1/48: Term, local/1/49: (isize) -> Term) -> Term {
      match term/48 {
          ctor(def/1/1::v0)(local/1/50) => sigma/49(index/50),
          ctor(def/1/1::v1)(local/1/51) => ctor(def/1/1::v1)(def/1/11(body/51, def/1/10(sigma/49))),
          ctor(def/1/1::v2)(local/1/52, local/1/53) =>
            ctor(def/1/1::v2)(def/1/11(left/52, sigma/49), def/1/11(right/53, sigma/49)),
      }
  }

  fn beta_substitution(local/1/54: Term) -> (isize) -> Term {
      |local/1/55| if index/55 == 0 {
          argument/54
      } else {
          ctor(def/1/1::v0)(index/55 - 1)
      }
  }

  fn check_translation(
    local/1/56: string,
    local/1/57: Named,
    local/1/58: Context,
    local/1/59: Term
  ) -> () {
      match def/1/5(term/57, context/58) {
