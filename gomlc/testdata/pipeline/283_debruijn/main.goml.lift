    ) in
  let _wild19 =
    println__T_string(
      ("substitution identity=" +
        trait_impl#ToString#bool#to_string(
          trait_impl#PartialEq#Term#eq(
            substitute(
              open_function/0,
              pack_closure[inherent#closure_env_main_2#closure_env_main_2#apply](
                closure_env_main_2 {}
              )
            ),
            open_function/0
          )
        ))
    ) in
  let _wild20 =
    println__T_string(
      ("substitution shift=" +
        trait_impl#ToString#bool#to_string(
          trait_impl#PartialEq#Term#eq(
            substitute(
              open_function/0,
