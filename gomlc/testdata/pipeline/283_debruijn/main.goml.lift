  let _wild9 = check_translation("free z", z/0, external/0, one/0) in
  let _wild10 = check_translation("open y", Named::Lam("x", y/0), external/0, Term::Lam(one/0)) in
  let _wild11 = check_translation("open z", Named::Lam("x", z/0), external/0, Term::Lam(two/0)) in
  let _wild12 =
