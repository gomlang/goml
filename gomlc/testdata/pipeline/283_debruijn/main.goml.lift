        Named::Lam("y", Named::Lam("z", Named::App(Named::App(x/0, z/0), Named::App(y/0, z/0))))
      ),
      empty/0,
      Term::Lam(Term::Lam(Term::Lam(Term::App(Term::App(two/0, zero/0), Term::App(one/0, zero/0)))))
    ) in
