  let _wild21 = check_beta("identity beta", zero/0, identity/0, 0, identity/0) in
  let _wild22 = check_beta("avoid capture", Term::Lam(one/0), zero/0, 1, Term::Lam(one/0)) in
  let _wild23 =
    check_beta(
      "all three cases",
      Term::Lam(Term::App(Term::App(two/0, one/0), zero/0)),
      zero/0,
      1,
      Term::Lam(Term::App(Term::App(one/0, one/0), zero/0))
