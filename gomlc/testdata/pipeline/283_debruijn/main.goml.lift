  let _wild13 =
    check_translation("missing", Named::App(Named::Lam("x", x/0), x/0), empty/0, zero/0) in
  let _wild14 =
    println__T_string(
      ("different binders=" +
        trait_impl#ToString#bool#to_string(
          (!trait_impl#PartialEq#Term#eq(Term::Lam(Term::Lam(one/0)), Term::Lam(identity/0)))
        ))
    ) in
  let open_function/0 = Term::Lam(Term::App(one/0, zero/0)) in
  let shifted/0 = shift(open_function/0, 1, 0) in
  let _wild15 = println__T_string(("shift cutoff: " + render(shifted/0))) in
  let _wild16 =
    println__T_string(
