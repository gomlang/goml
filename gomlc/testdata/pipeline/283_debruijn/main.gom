enum Named {
    Var(string),
    Lam(string, Named),
    App(Named, Named),
}

enum Term {
    Var(isize),
    Lam(Term),
    App(Term, Term),
}

impl PartialEq for Term {
    fn eq(self: Term, other: Term) -> bool {
        match (self, other) {
            (Term::Var(left), Term::Var(right)) => left == right,
            (Term::Lam(left), Term::Lam(right)) => left == right,
            (Term::App(left_fn, left_arg), Term::App(right_fn, right_arg)) => left_fn == right_fn
                && left_arg == right_arg,
            _ => false,
        }
    }
}

enum Context {
    Empty,
    Bind(string, Context),
}

fn lookup(name: string, context: Context) -> Result[isize, string] {
    match context {
        Context::Empty => Result::Err("unbound variable: " + name),
        Context::Bind(bound, rest) => {
            if name == bound {
                Result::Ok(0)
            } else {
                Result::Ok(lookup(name, rest)? + 1)
            }
        },
    }
}

fn translate(term: Named, context: Context) -> Result[Term, string] {
    match term {
        Named::Var(name) => Result::Ok(Term::Var(lookup(name, context)?)),
        Named::Lam(name, body) => Result::Ok(
            Term::Lam(translate(body, Context::Bind(name, context))?),
        ),
        Named::App(left, right) => Result::Ok(
            Term::App(translate(left, context)?, translate(right, context)?),
        ),
    }
}

fn render(term: Term) -> string {
    match term {
        Term::Var(index) => index.to_string(),
        Term::Lam(body) => "(lambda " + render(body) + ")",
        Term::App(left, right) => "(" + render(left) + " " + render(right) + ")",
    }
}

fn well_scoped(term: Term, size: isize) -> bool {
    match term {
        Term::Var(index) => index >= 0 && index < size,
        Term::Lam(body) => well_scoped(body, size + 1),
        Term::App(left, right) => well_scoped(left, size) && well_scoped(right, size),
    }
}

fn shift(term: Term, amount: isize, cutoff: isize) -> Term {
    match term {
        Term::Var(index) => Term::Var(
            if index < cutoff {
                index
            } else {
                index + amount
            },
        ),
        Term::Lam(body) => Term::Lam(shift(body, amount, cutoff + 1)),
        Term::App(left, right) => Term::App(
            shift(left, amount, cutoff),
            shift(right, amount, cutoff),
        ),
    }
}

fn instantiate(body: Term, argument: Term, depth: isize) -> Term {
    match body {
        Term::Var(index) => {
            if index < depth {
                Term::Var(index)
            } else if index == depth {
                shift(argument, depth, 0)
            } else {
                Term::Var(index - 1)
            }
        },
        Term::Lam(inner) => Term::Lam(instantiate(inner, argument, depth + 1)),
        Term::App(left, right) => Term::App(
            instantiate(left, argument, depth),
            instantiate(right, argument, depth),
        ),
    }
}

fn lift_substitution(sigma: (isize) -> Term) -> (isize) -> Term {
    |index| if index == 0 {
        Term::Var(0)
    } else {
        shift(sigma(index - 1), 1, 0)
    }
}

fn substitute(term: Term, sigma: (isize) -> Term) -> Term {
    match term {
        Term::Var(index) => sigma(index),
        Term::Lam(body) => Term::Lam(substitute(body, lift_substitution(sigma))),
        Term::App(left, right) => Term::App(substitute(left, sigma), substitute(right, sigma)),
    }
}

fn beta_substitution(argument: Term) -> (isize) -> Term {
    |index| if index == 0 {
        argument
    } else {
        Term::Var(index - 1)
    }
}

fn check_translation(label: string, term: Named, context: Context, expected: Term) -> () {
    match translate(term, context) {
        Ok(actual) => println(
            label + ": " + render(actual) + " equal=" + (actual == expected).to_string(),
        ),
        Err(message) => println(label + ": " + message),
    }
}

fn check_beta(label: string, body: Term, argument: Term, size: isize, expected: Term) -> () {
    let actual = instantiate(body, argument, 0);
    let simultaneous = substitute(body, beta_substitution(argument));
    println(label + ": " + render(actual));
    println(
        "expected=" + (actual == expected).to_string() + " simultaneous="
            + (actual == simultaneous).to_string()
            + " scoped="
            + (well_scoped(body, size + 1) && well_scoped(argument, size)
                && well_scoped(actual, size)).to_string(),
    );
}

fn main() -> () {
    let empty = Context::Empty;
    let x = Named::Var("x");
    let y = Named::Var("y");
    let z = Named::Var("z");
    let zero = Term::Var(0);
    let one = Term::Var(1);
    let two = Term::Var(2);
    let identity = Term::Lam(zero);
    check_translation("identity x", Named::Lam("x", x), empty, identity);
    check_translation("identity y", Named::Lam("y", y), empty, identity);
    check_translation(
        "outer",
        Named::Lam("x", Named::Lam("y", x)),
        empty,
        Term::Lam(Term::Lam(one)),
    );
    check_translation("inner", Named::Lam("x", Named::Lam("y", y)), empty, Term::Lam(identity));
    check_translation(
        "application",
        Named::Lam("x", Named::Lam("y", Named::App(x, y))),
        empty,
        Term::Lam(Term::Lam(Term::App(one, zero))),
    );
    check_translation(
        "shadowing",
        Named::Lam("x", Named::App(Named::Lam("x", x), x)),
        empty,
        Term::Lam(Term::App(identity, zero)),
    );
    check_translation(
        "relative address",
        Named::Lam("x", Named::App(x, Named::Lam("y", Named::App(x, y)))),
        empty,
        Term::Lam(Term::App(zero, Term::Lam(Term::App(one, zero)))),
    );
    check_translation(
        "three binders",
        Named::Lam(
            "x",
            Named::Lam("y", Named::Lam("z", Named::App(Named::App(x, z), Named::App(y, z)))),
        ),
        empty,
        Term::Lam(Term::Lam(Term::Lam(Term::App(Term::App(two, zero), Term::App(one, zero))))),
    );
    let external = Context::Bind("y", Context::Bind("z", empty));
    check_translation("free y", y, external, zero);
    check_translation("free z", z, external, one);
    check_translation("open y", Named::Lam("x", y), external, Term::Lam(one));
    check_translation("open z", Named::Lam("x", z), external, Term::Lam(two));
    check_translation("external shadowing", Named::Lam("y", y), external, identity);
    check_translation("missing", Named::App(Named::Lam("x", x), x), empty, zero);
    println("different binders=" + (Term::Lam(Term::Lam(one)) != Term::Lam(identity)).to_string());
    let open_function = Term::Lam(Term::App(one, zero));
    let shifted = shift(open_function, 1, 0);
    println("shift cutoff: " + render(shifted));
    println("shift expected=" + (shifted == Term::Lam(Term::App(two, zero))).to_string());
    println("shift zero=" + (shift(open_function, 0, 0) == open_function).to_string());
    println("shift closed=" + (shift(identity, 3, 0) == identity).to_string());
    println(
        "substitution identity="
            + (substitute(open_function, |index| Term::Var(index)) == open_function).to_string(),
    );
    println(
        "substitution shift="
            + (substitute(open_function, |index| Term::Var(index + 1)) == shifted).to_string(),
    );
    check_beta("identity beta", zero, identity, 0, identity);
    check_beta("avoid capture", Term::Lam(one), zero, 1, Term::Lam(one));
    check_beta(
        "all three cases",
        Term::Lam(Term::App(Term::App(two, one), zero)),
        zero,
        1,
        Term::Lam(Term::App(Term::App(one, one), zero)),
    );
    check_beta("argument local binder", Term::Lam(one), open_function, 1, Term::Lam(shifted));
    check_beta(
        "two nested binders",
        Term::Lam(Term::Lam(Term::App(two, zero))),
        zero,
        1,
        Term::Lam(Term::Lam(Term::App(two, zero))),
    );
    check_beta("unused argument", Term::Lam(zero), open_function, 1, identity);
    check_beta("remove external slot", one, identity, 1, zero);
    check_beta(
        "duplicate argument",
        Term::App(zero, zero),
        identity,
        0,
        Term::App(identity, identity),
    );
    println("closed scope=" + well_scoped(identity, 0).to_string());
    println("open scope=" + well_scoped(open_function, 1).to_string());
    println("missing external scope=" + well_scoped(open_function, 0).to_string());
    println("negative index=" + well_scoped(Term::Var(-1), 1).to_string());
    println("index at boundary=" + well_scoped(one, 1).to_string());
}
