impl PartialEq for Term {
  fn eq(self/0: Term, other/1: Term) -> bool {
      match ((self/0 : Term), (other/1 : Term)) {
          (Term::Var(left/2: isize), Term::Var(right/3: isize)) =>
            (left/2 : isize) == (right/3 : isize),
          (Term::Lam(left/4: Term), Term::Lam(right/5: Term)) =>
            (left/4 : Term) == (right/5 : Term),
          (
            Term::App(left_fn/6: Term, left_arg/7: Term),
            Term::App(right_fn/8: Term, right_arg/9: Term)
          ) =>
            (left_fn/6 : Term) == (right_fn/8 : Term) &&
              (left_arg/7 : Term) == (right_arg/9 : Term),
          _ : (Term, Term) => false,
      }
  }
}

fn lookup(name/10: string, context/11: Context) -> Result[isize, string] {
    match (context/11 : Context) {
        Context::Empty => Result::Err("unbound variable: " + (name/10 : string)),
        Context::Bind(bound/12: string, rest/13: Context) =>
          {
              if (name/10 : string) == (bound/12 : string) {
                  {
                      Result::Ok(0)
                  }
              } else {
                  {
                      Result::Ok(
                        match (lookup : (string, Context) -> Result[isize, string])(
                          (name/10 : string),
                          (rest/13 : Context)
                        ) {
                            Result::Ok(try_value/34: isize) => (try_value/34 : isize),
                            Result::Err(try_residual/34: string) =>
                              return Result::Err((try_residual/34 : string)),
                        } +
                          1
                      )
                  }
              }
          },
    }
}

fn translate(term/14: Named, context/15: Context) -> Result[Term, string] {
    match (term/14 : Named) {
        Named::Var(name/16: string) =>
          Result::Ok(
            Term::Var(
              match (lookup : (string, Context) -> Result[isize, string])(
                (name/16 : string),
                (context/15 : Context)
              ) {
                  Result::Ok(try_value/47: isize) => (try_value/47 : isize),
                  Result::Err(try_residual/47: string) =>
                    return Result::Err((try_residual/47 : string)),
              }
            )
          ),
        Named::Lam(name/17: string, body/18: Named) =>
          Result::Ok(
            Term::Lam(
              match (translate : (Named, Context) -> Result[Term, string])(
                (body/18 : Named),
                Context::Bind((name/17 : string), (context/15 : Context))
              ) {
                  Result::Ok(try_value/56: Term) => (try_value/56 : Term),
                  Result::Err(try_residual/56: string) =>
                    return Result::Err((try_residual/56 : string)),
              }
            )
          ),
        Named::App(left/19: Named, right/20: Named) =>
          Result::Ok(
            Term::App(
              match (translate : (Named, Context) -> Result[Term, string])(
                (left/19 : Named),
                (context/15 : Context)
              ) {
                  Result::Ok(try_value/63: Term) => (try_value/63 : Term),
                  Result::Err(try_residual/63: string) =>
                    return Result::Err((try_residual/63 : string)),
              },
              match (translate : (Named, Context) -> Result[Term, string])(
                (right/20 : Named),
                (context/15 : Context)
              ) {
                  Result::Ok(try_value/68: Term) => (try_value/68 : Term),
                  Result::Err(try_residual/68: string) =>
                    return Result::Err((try_residual/68 : string)),
              }
            )
          ),
    }
}

fn render(term/21: Term) -> string {
    match (term/21 : Term) {
        Term::Var(index/22: isize) => (isize::to_string : (isize) -> string)((index/22 : isize)),
        Term::Lam(body/23: Term) =>
          "(lambda " + (render : (Term) -> string)((body/23 : Term)) + ")",
        Term::App(left/24: Term, right/25: Term) =>
          "(" + (render : (Term) -> string)((left/24 : Term)) + " " +
            (render : (Term) -> string)((right/25 : Term)) +
            ")",
    }
}

fn well_scoped(term/26: Term, size/27: isize) -> bool {
    match (term/26 : Term) {
        Term::Var(index/28: isize) =>
          (index/28 : isize) >= 0 && (index/28 : isize) < (size/27 : isize),
        Term::Lam(body/29: Term) =>
          (well_scoped : (Term, isize) -> bool)((body/29 : Term), (size/27 : isize) + 1),
        Term::App(left/30: Term, right/31: Term) =>
          (well_scoped : (Term, isize) -> bool)((left/30 : Term), (size/27 : isize)) &&
            (well_scoped : (Term, isize) -> bool)((right/31 : Term), (size/27 : isize)),
    }
}

fn shift(term/32: Term, amount/33: isize, cutoff/34: isize) -> Term {
    match (term/32 : Term) {
        Term::Var(index/35: isize) =>
          Term::Var(
            if (index/35 : isize) < (cutoff/34 : isize) {
                {
                    (index/35 : isize)
                }
            } else {
                {
                    (index/35 : isize) + (amount/33 : isize)
                }
            }
          ),
        Term::Lam(body/36: Term) =>
          Term::Lam(
            (shift : (Term, isize, isize) -> Term)(
              (body/36 : Term),
              (amount/33 : isize),
              (cutoff/34 : isize) + 1
            )
          ),
        Term::App(left/37: Term, right/38: Term) =>
          Term::App(
            (shift : (Term, isize, isize) -> Term)(
              (left/37 : Term),
              (amount/33 : isize),
              (cutoff/34 : isize)
            ),
            (shift : (Term, isize, isize) -> Term)(
              (right/38 : Term),
              (amount/33 : isize),
              (cutoff/34 : isize)
            )
          ),
    }
}

fn instantiate(body/39: Term, argument/40: Term, depth/41: isize) -> Term {
    match (body/39 : Term) {
        Term::Var(index/42: isize) =>
          {
              if (index/42 : isize) < (depth/41 : isize) {
                  {
                      Term::Var((index/42 : isize))
                  }
              } else {
                  if (index/42 : isize) == (depth/41 : isize) {
                      {
                          (shift : (Term, isize, isize) -> Term)(
                            (argument/40 : Term),
                            (depth/41 : isize),
                            0
                          )
                      }
                  } else {
                      {
                          Term::Var((index/42 : isize) - 1)
                      }
                  }
              }
          },
        Term::Lam(inner/43: Term) =>
          Term::Lam(
            (instantiate : (Term, Term, isize) -> Term)(
              (inner/43 : Term),
              (argument/40 : Term),
              (depth/41 : isize) + 1
            )
          ),
        Term::App(left/44: Term, right/45: Term) =>
          Term::App(
            (instantiate : (Term, Term, isize) -> Term)(
              (left/44 : Term),
              (argument/40 : Term),
              (depth/41 : isize)
            ),
            (instantiate : (Term, Term, isize) -> Term)(
              (right/45 : Term),
              (argument/40 : Term),
              (depth/41 : isize)
            )
          ),
    }
}

fn lift_substitution(sigma/46: (isize) -> Term) -> (isize) -> Term {
    |index/47: isize| =>
      if (index/47 : isize) == 0 {
          {
              Term::Var(0)
          }
      } else {
          {
              (shift : (Term, isize, isize) -> Term)(
                (sigma/46 : (isize) -> Term)((index/47 : isize) - 1),
                1,
                0
              )
          }
      }
}

fn substitute(term/48: Term, sigma/49: (isize) -> Term) -> Term {
    match (term/48 : Term) {
        Term::Var(index/50: isize) => (sigma/49 : (isize) -> Term)((index/50 : isize)),
        Term::Lam(body/51: Term) =>
          Term::Lam(
            (substitute : (Term, (isize) -> Term) -> Term)(
              (body/51 : Term),
              (lift_substitution : ((isize) -> Term) -> (isize) -> Term)(
                (sigma/49 : (isize) -> Term)
              )
            )
          ),
        Term::App(left/52: Term, right/53: Term) =>
          Term::App(
            (substitute : (Term, (isize) -> Term) -> Term)(
              (left/52 : Term),
              (sigma/49 : (isize) -> Term)
            ),
            (substitute : (Term, (isize) -> Term) -> Term)(
              (right/53 : Term),
              (sigma/49 : (isize) -> Term)
            )
          ),
    }
}

fn beta_substitution(argument/54: Term) -> (isize) -> Term {
    |index/55: isize| =>
      if (index/55 : isize) == 0 {
          {
              (argument/54 : Term)
          }
      } else {
          {
              Term::Var((index/55 : isize) - 1)
          }
      }
}

fn check_translation(
  label/56: string,
  term/57: Named,
  context/58: Context,
  expected/59: Term
) -> () {
    match (translate : (Named, Context) -> Result[Term, string])(
      (term/57 : Named),
      (context/58 : Context)
    ) {
        Result::Ok(actual/60: Term) =>
          (println : (string) -> ())(
            (label/56 : string) + ": " + (render : (Term) -> string)((actual/60 : Term)) +
              " equal=" +
              (ToString::to_string : (bool) -> string)((actual/60 : Term) == (expected/59 : Term))
          ),
        Result::Err(message/61: string) =>
          (println : (string) -> ())((label/56 : string) + ": " + (message/61 : string)),
    }
}

fn check_beta(
  label/62: string,
  body/63: Term,
  argument/64: Term,
  size/65: isize,
  expected/66: Term
) -> () {
    let actual/67: Term =
      (instantiate : (Term, Term, isize) -> Term)((body/63 : Term), (argument/64 : Term), 0);
    let simultaneous/68: Term =
      (substitute : (Term, (isize) -> Term) -> Term)(
        (body/63 : Term),
        (beta_substitution : (Term) -> (isize) -> Term)((argument/64 : Term))
      );
    (println : (string) -> ())(
      (label/62 : string) + ": " + (render : (Term) -> string)((actual/67 : Term))
    );
    (println : (string) -> ())(
      "expected=" +
        (ToString::to_string : (bool) -> string)((actual/67 : Term) == (expected/66 : Term)) +
        " simultaneous=" +
        (ToString::to_string : (bool) -> string)((actual/67 : Term) == (simultaneous/68 : Term)) +
        " scoped=" +
        (ToString::to_string : (bool) -> string)(
          (well_scoped : (Term, isize) -> bool)((body/63 : Term), (size/65 : isize) + 1) &&
            (well_scoped : (Term, isize) -> bool)((argument/64 : Term), (size/65 : isize)) &&
            (well_scoped : (Term, isize) -> bool)((actual/67 : Term), (size/65 : isize))
        )
    );
}

fn main() -> () {
    let empty/69: Context = Context::Empty;
    let x/70: Named = Named::Var("x");
    let y/71: Named = Named::Var("y");
    let z/72: Named = Named::Var("z");
    let zero/73: Term = Term::Var(0);
    let one/74: Term = Term::Var(1);
    let two/75: Term = Term::Var(2);
    let identity/76: Term = Term::Lam((zero/73 : Term));
    (check_translation : (string, Named, Context, Term) -> ())(
      "identity x",
      Named::Lam("x", (x/70 : Named)),
      (empty/69 : Context),
      (identity/76 : Term)
    );
    (check_translation : (string, Named, Context, Term) -> ())(
      "identity y",
      Named::Lam("y", (y/71 : Named)),
      (empty/69 : Context),
      (identity/76 : Term)
    );
    (check_translation : (string, Named, Context, Term) -> ())(
      "outer",
      Named::Lam("x", Named::Lam("y", (x/70 : Named))),
      (empty/69 : Context),
      Term::Lam(Term::Lam((one/74 : Term)))
    );
    (check_translation : (string, Named, Context, Term) -> ())(
      "inner",
      Named::Lam("x", Named::Lam("y", (y/71 : Named))),
      (empty/69 : Context),
      Term::Lam((identity/76 : Term))
    );
    (check_translation : (string, Named, Context, Term) -> ())(
      "application",
      Named::Lam("x", Named::Lam("y", Named::App((x/70 : Named), (y/71 : Named)))),
      (empty/69 : Context),
      Term::Lam(Term::Lam(Term::App((one/74 : Term), (zero/73 : Term))))
    );
    (check_translation : (string, Named, Context, Term) -> ())(
      "shadowing",
      Named::Lam("x", Named::App(Named::Lam("x", (x/70 : Named)), (x/70 : Named))),
      (empty/69 : Context),
      Term::Lam(Term::App((identity/76 : Term), (zero/73 : Term)))
    );
    (check_translation : (string, Named, Context, Term) -> ())(
      "relative address",
      Named::Lam(
        "x",
        Named::App((x/70 : Named), Named::Lam("y", Named::App((x/70 : Named), (y/71 : Named))))
      ),
      (empty/69 : Context),
      Term::Lam(
        Term::App((zero/73 : Term), Term::Lam(Term::App((one/74 : Term), (zero/73 : Term))))
      )
    );
    (check_translation : (string, Named, Context, Term) -> ())(
      "three binders",
      Named::Lam(
        "x",
        Named::Lam(
          "y",
          Named::Lam(
            "z",
            Named::App(
              Named::App((x/70 : Named), (z/72 : Named)),
              Named::App((y/71 : Named), (z/72 : Named))
            )
          )
        )
      ),
      (empty/69 : Context),
      Term::Lam(
        Term::Lam(
          Term::Lam(
            Term::App(
              Term::App((two/75 : Term), (zero/73 : Term)),
              Term::App((one/74 : Term), (zero/73 : Term))
            )
          )
        )
      )
    );
    let external/77: Context = Context::Bind("y", Context::Bind("z", (empty/69 : Context)));
    (check_translation : (string, Named, Context, Term) -> ())(
      "free y",
      (y/71 : Named),
      (external/77 : Context),
      (zero/73 : Term)
    );
    (check_translation : (string, Named, Context, Term) -> ())(
      "free z",
      (z/72 : Named),
      (external/77 : Context),
      (one/74 : Term)
    );
    (check_translation : (string, Named, Context, Term) -> ())(
      "open y",
      Named::Lam("x", (y/71 : Named)),
      (external/77 : Context),
      Term::Lam((one/74 : Term))
    );
    (check_translation : (string, Named, Context, Term) -> ())(
      "open z",
      Named::Lam("x", (z/72 : Named)),
      (external/77 : Context),
      Term::Lam((two/75 : Term))
    );
    (check_translation : (string, Named, Context, Term) -> ())(
      "external shadowing",
      Named::Lam("y", (y/71 : Named)),
      (external/77 : Context),
      (identity/76 : Term)
    );
    (check_translation : (string, Named, Context, Term) -> ())(
      "missing",
      Named::App(Named::Lam("x", (x/70 : Named)), (x/70 : Named)),
      (empty/69 : Context),
      (zero/73 : Term)
    );
    (println : (string) -> ())(
      "different binders=" +
        (ToString::to_string : (bool) -> string)(
          Term::Lam(Term::Lam((one/74 : Term))) != Term::Lam((identity/76 : Term))
        )
    );
    let open_function/78: Term = Term::Lam(Term::App((one/74 : Term), (zero/73 : Term)));
    let shifted/79: Term = (shift : (Term, isize, isize) -> Term)((open_function/78 : Term), 1, 0);
    (println : (string) -> ())("shift cutoff: " + (render : (Term) -> string)((shifted/79 : Term)));
    (println : (string) -> ())(
      "shift expected=" +
        (ToString::to_string : (bool) -> string)(
          (shifted/79 : Term) == Term::Lam(Term::App((two/75 : Term), (zero/73 : Term)))
        )
    );
    (println : (string) -> ())(
      "shift zero=" +
        (ToString::to_string : (bool) -> string)(
          (shift : (Term, isize, isize) -> Term)((open_function/78 : Term), 0, 0) ==
            (open_function/78 : Term)
        )
    );
    (println : (string) -> ())(
      "shift closed=" +
        (ToString::to_string : (bool) -> string)(
          (shift : (Term, isize, isize) -> Term)((identity/76 : Term), 3, 0) == (identity/76 : Term)
        )
    );
    (println : (string) -> ())(
      "substitution identity=" +
        (ToString::to_string : (bool) -> string)(
          (substitute : (Term, (isize) -> Term) -> Term)(
            (open_function/78 : Term),
            |index/80: isize| => Term::Var((index/80 : isize))
          ) ==
            (open_function/78 : Term)
        )
    );
    (println : (string) -> ())(
      "substitution shift=" +
        (ToString::to_string : (bool) -> string)(
          (substitute : (Term, (isize) -> Term) -> Term)(
            (open_function/78 : Term),
            |index/81: isize| => Term::Var((index/81 : isize) + 1)
          ) ==
            (shifted/79 : Term)
        )
    );
    (check_beta : (string, Term, Term, isize, Term) -> ())(
      "identity beta",
      (zero/73 : Term),
      (identity/76 : Term),
      0,
      (identity/76 : Term)
    );
    (check_beta : (string, Term, Term, isize, Term) -> ())(
      "avoid capture",
      Term::Lam((one/74 : Term)),
      (zero/73 : Term),
      1,
      Term::Lam((one/74 : Term))
    );
    (check_beta : (string, Term, Term, isize, Term) -> ())(
      "all three cases",
      Term::Lam(Term::App(Term::App((two/75 : Term), (one/74 : Term)), (zero/73 : Term))),
      (zero/73 : Term),
      1,
      Term::Lam(Term::App(Term::App((one/74 : Term), (one/74 : Term)), (zero/73 : Term)))
    );
    (check_beta : (string, Term, Term, isize, Term) -> ())(
      "argument local binder",
      Term::Lam((one/74 : Term)),
      (open_function/78 : Term),
      1,
      Term::Lam((shifted/79 : Term))
    );
    (check_beta : (string, Term, Term, isize, Term) -> ())(
      "two nested binders",
      Term::Lam(Term::Lam(Term::App((two/75 : Term), (zero/73 : Term)))),
      (zero/73 : Term),
      1,
      Term::Lam(Term::Lam(Term::App((two/75 : Term), (zero/73 : Term))))
    );
    (check_beta : (string, Term, Term, isize, Term) -> ())(
      "unused argument",
      Term::Lam((zero/73 : Term)),
      (open_function/78 : Term),
      1,
      (identity/76 : Term)
    );
    (check_beta : (string, Term, Term, isize, Term) -> ())(
      "remove external slot",
      (one/74 : Term),
      (identity/76 : Term),
      1,
      (zero/73 : Term)
    );
    (check_beta : (string, Term, Term, isize, Term) -> ())(
      "duplicate argument",
      Term::App((zero/73 : Term), (zero/73 : Term)),
      (identity/76 : Term),
      0,
      Term::App((identity/76 : Term), (identity/76 : Term))
    );
    (println : (string) -> ())(
      "closed scope=" +
        (ToString::to_string : (bool) -> string)(
          (well_scoped : (Term, isize) -> bool)((identity/76 : Term), 0)
        )
    );
    (println : (string) -> ())(
      "open scope=" +
        (ToString::to_string : (bool) -> string)(
          (well_scoped : (Term, isize) -> bool)((open_function/78 : Term), 1)
        )
    );
    (println : (string) -> ())(
      "missing external scope=" +
        (ToString::to_string : (bool) -> string)(
          (well_scoped : (Term, isize) -> bool)((open_function/78 : Term), 0)
        )
    );
    (println : (string) -> ())(
      "negative index=" +
        (ToString::to_string : (bool) -> string)(
          (well_scoped : (Term, isize) -> bool)(Term::Var(-1), 1)
        )
    );
    (println : (string) -> ())(
      "index at boundary=" +
        (ToString::to_string : (bool) -> string)(
          (well_scoped : (Term, isize) -> bool)((one/74 : Term), 1)
        )
    );
}