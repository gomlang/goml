#[derive(Debug)]
enum Message[T] {
    Empty,
    Value(T),
    Named { value: T },
}

fn repeated[T, const N: usize](value: T) -> [T; N] {
    [value; N]
}

fn count(counter: Ref[isize]) -> isize {
    counter.set(counter.get() + 1);
    counter.get()
}

fn choose(value: Option[isize]) -> Result[isize, string] {
    let x = 90;
    if let Some(x) = value && x > 2 && let Some(y) = Option::Some(x + 1) {
        Ok(x + y)
    } else {
        Ok(x)
    }
}

const REPEATED: [isize; 4] = [7; 2 * 2];

fn main() -> () {
    println(REPEATED == [7, 7, 7, 7]);
    let computed = comptime {
        let mut calls = 0;
        let array = [{
            calls += 1;
            calls
        }; 3];
        let empty: [isize; 0] = [{
            calls += 1;
            calls
        }; 0];
        (array, calls, empty)
    };
    println(computed.0 == [1, 1, 1]);
    println(computed.1);
    println(computed.2 == []);
    let counter = Ref::new(0);
    let values: [isize; 3] = [count(counter); 3];
    println(values == [1, 1, 1]);
    let empty: [isize; 0] = [count(counter); 0];
    println(empty == []);
    println(counter.get());
    let shared = repeated::[Ref[isize], 2](counter);
    shared[0].set(7);
    println(shared[1].get());
    println(repeated::[isize, 4](5) == [5, 5, 5, 5]);
    println(choose(Some(3)).unwrap_or(-1));
    println(choose(Some(1)).unwrap_or(-1));
    println(choose(None).unwrap_or(-1));
    let nested: Option[Result[isize, string]] = Some(Ok(8));
    println(nested == Option::Some(Result::Ok(8)));
    let constructor: (isize) -> Message[isize] = Value;
    println((constructor(9)).debug());
    let named: Message[string] = Named { value: "named" };
    println((named).debug());
    let empty_message: Message[isize] = Empty;
    println((empty_message).debug());
    let mut index = 0;
    while index < 3 && let Some(value) = Option::Some(index) && value < 2 {
        println(value);
        index += 1;
    }
    println(index);
    if false && let Some(value) = Option::Some(count(counter)) {
        println(value)
    }
    println(counter.get())
}
