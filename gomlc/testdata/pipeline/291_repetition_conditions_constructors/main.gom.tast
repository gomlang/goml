const REPEATED: [isize; 4] = [7, 7, 7, 7];

impl[T] Debug for Message[T] where T: Debug {
  fn debug(self/0: Message[T]) -> string {
      match (self/0 : Message[T]) {
          Message::Empty => "Message::Empty",
          Message::Value(#derive0_field/1: T) =>
            "Message::Value(" + (Debug::debug : (T) -> string)((#derive0_field/1 : T)) + ")",
          Message::Named(#derive1_field/2: T) =>
            "Message::Named { " + "value: " +
              (Debug::debug : (T) -> string)((#derive1_field/2 : T)) +
              " }",
      }
  }
}

fn repeated[T, $const_param:N](value/3: T) -> $array[$const_param:N, T] {
    (@intrinsic(array.repeat) : (T) -> $array[$const_param:N, T])((value/3 : T))
}

fn count(counter/4: Ref[isize]) -> isize {
    (Ref[isize]::set : (Ref[isize], isize) -> ())(
      (counter/4 : Ref[isize]),
      (Ref[isize]::get : (Ref[isize]) -> isize)((counter/4 : Ref[isize])) + 1
    );
    (Ref[isize]::get : (Ref[isize]) -> isize)((counter/4 : Ref[isize]))
}

fn choose(value/5: Option[isize]) -> Result[isize, string] {
    let x/6: isize = 90;
    match (value/5 : Option[isize]) {
        Option::Some(x/7: isize) =>
          if (x/7 : isize) > 2 {
              match Option::Some((x/7 : isize) + 1) {
                  Option::Some(y/8: isize) =>
                    {
                        Result::Ok((x/7 : isize) + (y/8 : isize))
                    },
                  _ : Option[isize] =>
                    {
                        Result::Ok((x/6 : isize))
                    },
              }
          } else {
              {
                  Result::Ok((x/6 : isize))
              }
          },
        _ : Option[isize] =>
          {
              Result::Ok((x/6 : isize))
          },
    }
}

