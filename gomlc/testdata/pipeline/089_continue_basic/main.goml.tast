fn main() -> () {
    let i/0: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    while (Ref[isize]::get : (Ref[isize]) -> isize)((i/0 : Ref[isize])) < 10 {
        {
            (Ref[isize]::set : (Ref[isize], isize) -> ())(
              (i/0 : Ref[isize]),
              (Ref[isize]::get : (Ref[isize]) -> isize)((i/0 : Ref[isize])) + 1
            );
            if (Ref[isize]::get : (Ref[isize]) -> isize)((i/0 : Ref[isize])) == 5 {
                {
                    continue
                }
            } else {
                {}
            };
            let _ : () =
              (println : (isize) -> ())(
                (Ref[isize]::get : (Ref[isize]) -> isize)((i/0 : Ref[isize]))
              );
        }
    };
    let _ : () = (println : (string) -> ())("done");
}