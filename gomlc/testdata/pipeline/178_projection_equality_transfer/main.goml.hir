package main
file main.goml
  trait Mark {
    fn marked(Self) -> string;
  }

  trait Source {
    type Item;
    fn get(Self) -> Self::Item;
  }

  struct LeftSource {
      value: i32,
  }

  struct RightSource {
      value: i32,
  }

  impl Mark for i32 {
    fn marked(local/main/0: i32) -> string {
        "m" + self/0.to_string()
    }
  }

  impl Source for LeftSource {
    type Item = i32;
    fn get(local/main/1: LeftSource) -> i32 {
        self/1.value
    }
  }

  impl Source for RightSource {
    type Item = i32;
    fn get(local/main/2: RightSource) -> i32 {
        self/2.value
    }
  }

  fn combine[A: Source, B: Source](local/main/3: A, local/main/4: B) -> string where
    A::Item = B::Item,
    B::Item: Mark {
      Source::get(left/3).marked() + ":" + Source::get(right/4).marked()
  }

  fn main() -> () {
      println(source:4:main:7(LeftSource { value: 3 }, RightSource { value: 4 }));
  }