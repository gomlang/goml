trait Mark {
    fn marked(self: Self) -> string;
}

trait Source {
    type Item;
    fn get(self: Self) -> Self::Item;
}

struct LeftSource {
    value: i32,
}

struct RightSource {
    value: i32,
}

impl Mark for i32 {
    fn marked(self: i32) -> string {
        "m" + self.to_string()
    }
}

impl Source for LeftSource {
    type Item = i32;

    fn get(self: LeftSource) -> i32 {
        self.value
    }
}

impl Source for RightSource {
    type Item = i32;

    fn get(self: RightSource) -> i32 {
        self.value
    }
}

fn combine[A: Source, B: Source](left: A, right: B) -> string
where
    A::Item = B::Item,
    B::Item: Mark,
{
    Source::get(left).marked() + ":" + Source::get(right).marked()
}

fn main() -> () {
    println(combine(LeftSource { value: 3 }, RightSource { value: 4 }));
}
