impl Mark for i32 {
  fn marked(self/0: i32) -> string {
      "m" + (i32::to_string : (i32) -> string)((self/0 : i32))
  }
}

impl Source for LeftSource {
  fn get(self/1: LeftSource) -> i32 {
      (self/1 : LeftSource).value
  }
}

impl Source for RightSource {
  fn get(self/2: RightSource) -> i32 {
      (self/2 : RightSource).value
  }
}

fn combine[A, B](left/3: A, right/4: B) -> string where
  A: Source,
  B: Source,
  A::Item = B::Item,
  B::Item: Mark {
    (Mark::marked : (B::Item) -> string)((Source::get : (A) -> B::Item)((left/3 : A))) + ":" +
      (Mark::marked : (B::Item) -> string)((Source::get : (B) -> B::Item)((right/4 : B)))
}

fn main() -> () {
    (println : (string) -> ())(
      (combine : (LeftSource, RightSource) -> string)(
        LeftSource { value: 3 },
        RightSource { value: 4 }
      )
    );
}