fn show_unit[E](result/0: Result[(), E]) -> string where E: ToString {
    match (result/0 : Result[(), E]) {
        Result::Ok(_ : ()) => "ok",
        Result::Err(err/1: E) => "err " + (ToString::to_string : (E) -> string)((err/1 : E)),
    }
}

fn show_string[E](result/2: Result[string, E]) -> string where E: ToString {
    match (result/2 : Result[string, E]) {
        Result::Ok(value/3: string) => (value/3 : string),
        Result::Err(err/4: E) => "err " + (ToString::to_string : (E) -> string)((err/4 : E)),
    }
}

fn main() -> () {
    (std::io::println : (string) -> ())(
      (string_byte_slice : (string, isize, isize) -> string)("a你好z", 1, 7)
    );
    (std::io::eprint : (string) -> ())("");
    (std::io::eprintln : (string) -> ())("");
    (std::io::println : (string) -> ())(
      (show_unit : (Result[(), std::fs::Error]) -> string)(
        (std::fs::create_dir_all : (string) -> Result[(), std::fs::Error])("goml-self-host/nested")
      )
    );
    (std::io::println : (string) -> ())(
      (show_unit : (Result[(), std::fs::Error]) -> string)(
        (std::fs::write_file_structured : (string, string) -> Result[(), std::fs::Error])(
          "goml-self-host/nested/output.txt",
          "boot"
        )
      )
    );
    (std::io::println : (string) -> ())(
      (show_string : (Result[string, std::fs::Error]) -> string)(
        (std::fs::read_file_structured : (string) -> Result[string, std::fs::Error])(
          "goml-self-host/nested/output.txt"
        )
      )
    )
}