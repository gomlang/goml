package main
file main.goml
  fn show_unit[E: ToString](local/1/0: Result[(), E]) -> string {
      match result/0 {
          Result::Ok(_) => "ok",
          Result::Err(local/1/1) => "err " + err/1.to_string(),
      }
  }

  fn show_string[E: ToString](local/1/2: Result[string, E]) -> string {
      match result/2 {
          Result::Ok(local/1/3) => value/3,
          Result::Err(local/1/4) => "err " + err/4.to_string(),
      }
  }

  fn main() -> () {
      io::println(string_byte_slice("a你好z", 1, 7));
