fn step(i/0: i32) -> Option[i32] {
    if (i/0 : i32) == 2 {
        {
            Option::None
        }
    } else {
        {
            Option::Some((i/0 : i32) + 10)
        }
    }
}

fn accumulate(limit/1: i32) -> Option[i32] {
    let sum/2: Ref[i32] = (Ref[i32]::new : (i32) -> Ref[i32])(0);
    let i/3: Ref[i32] = (Ref[i32]::new : (i32) -> Ref[i32])(0);
    while (Ref[i32]::get : (Ref[i32]) -> i32)((i/3 : Ref[i32])) < (limit/1 : i32) {
        {
            let cur/4: i32 = (Ref[i32]::get : (Ref[i32]) -> i32)((i/3 : Ref[i32]));
            (Ref[i32]::set : (Ref[i32], i32) -> ())((i/3 : Ref[i32]), (cur/4 : i32) + 1);
            if (cur/4 : i32) == 1 {
                {
                    continue
                }
            } else {
                {}
            };
            let value/5: i32 =
              match (step : (i32) -> Option[i32])((cur/4 : i32)) {
                  Option::Some(try_value/42: i32) => (try_value/42 : i32),
                  Option::None => return Option::None,
              };
            (Ref[i32]::set : (Ref[i32], i32) -> ())(
              (sum/2 : Ref[i32]),
              (Ref[i32]::get : (Ref[i32]) -> i32)((sum/2 : Ref[i32])) + (value/5 : i32)
            );
        }
    };
    Option::Some((Ref[i32]::get : (Ref[i32]) -> i32)((sum/2 : Ref[i32])))
}

fn show(opt/6: Option[i32]) -> string {
    match (opt/6 : Option[i32]) {
        Option::Some(value/7: i32) => "some=" + (i32::to_string : (i32) -> string)((value/7 : i32)),
        Option::None => "none",
    }
}

fn main() -> () {
    (println : (string) -> ())(
      (show : (Option[i32]) -> string)((accumulate : (i32) -> Option[i32])(2))
    );
    (println : (string) -> ())(
      (show : (Option[i32]) -> string)((accumulate : (i32) -> Option[i32])(4))
    );
}