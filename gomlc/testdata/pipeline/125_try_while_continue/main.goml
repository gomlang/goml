fn step(i: i32) -> Option[i32] {
    if i == 2 {
        Option::None
    } else {
        Option::Some(i + 10)
    }
}

fn accumulate(limit: i32) -> Option[i32] {
    let sum = Ref::new(0);
    let i = Ref::new(0);
    while i.get() < limit {
        let cur = i.get();
        i.set(cur + 1);
        if cur == 1 {
            continue
        } else {};
        let value = step(cur)?;
        sum.set(sum.get() + value);
    }
    Option::Some(sum.get())
}

fn show(opt: Option[i32]) -> string {
    match opt {
        Option::Some(value) => "some=" + value.to_string(),
        Option::None => "none",
    }
}

fn main() -> () {
    println(show(accumulate(2)));
    println(show(accumulate(4)));
}
