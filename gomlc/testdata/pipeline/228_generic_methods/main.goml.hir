package main
file main.goml
  struct Box[T] {
      value: T,
  }

  impl[T] Box[T] {
    fn map[U](local/main/0: Box[T], local/main/1: (T) -> U) -> Box[U] {
        Box { value: map_fn/1(self/0.value) }
    }
    fn render[U](local/main/2: Box[T], local/main/3: U) -> string where U: ToString {
        let _ = self/2;
        "value:" + value/3.to_string()
    }
  }

  fn main() {
      let local/main/4 = Box { value: 42 };
      let local/main/6 = first/4.map(|local/main/5: isize| value/5.to_string());
      println(text/6.value);
      let local/main/7 = Box { value: 7 };
      let local/main/9 = second/7.map::[string](|local/main/8: isize| value/8.to_string());
      println(explicit/9.value);
      let local/main/10 = Box { value: 9 };
      let local/main/12 =
        Box::[isize]::map::[string](third/10, |local/main/11: isize| value/11.to_string());
      println(static_call/12.value);
      let local/main/13 = Box { value: "value" }.render(5);
      println(rendered/13);
  }