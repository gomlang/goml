package main;
struct Box[T] {
    value: T,
}

impl[T] Box[T] {
  fn map[U](self: Box[T], map_fn: (T) -> U) -> Box[U] {
      Box { value: map_fn(self.value) }
  }
  fn render[U](self: Box[T], value: U) -> string where U: ToString {
      let _ = self;
      "value:" + value.to_string()
  }
}

fn main() {
    let first = Box { value: 42 };
    let text = first.map(|value: isize| value.to_string());
    println(text.value);
    let second = Box { value: 7 };
    let explicit = second.map::[string](|value: isize| value.to_string());
    println(explicit.value);
    let third = Box { value: 9 };
    let static_call = Box::[isize]::map::[string](third, |value: isize| value.to_string());
    println(static_call.value);
    let rendered = Box { value: "value" }.render(5);
    println(rendered);
}

