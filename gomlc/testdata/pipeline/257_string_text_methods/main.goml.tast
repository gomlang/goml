fn main() -> () {
    let text/0: string = "  Héllo, World!  ";
    (println : (string) -> ())("[" + (string::trim : (string) -> string)((text/0 : string)) + "]");
    (println : (string) -> ())(
      "[" + (string::trim_start : (string) -> string)((text/0 : string)) + "]"
    );
    (println : (string) -> ())(
      "[" + (string::trim_end : (string) -> string)((text/0 : string)) + "]"
    );
    (println : (string) -> ())(
      (Vec[string]::join : (Vec[string], string) -> string)(
        (string::split : (string, string) -> Vec[string])((text/0 : string), ","),
        "|"
      )
    );
    (println : (string) -> ())(
      (Option[(string, string)]::unwrap_or : (Option[(string, string)], (string, string)) -> (
        string,
        string
      ))(
        (string::split_once : (string, string) -> Option[(string, string)])((text/0 : string), ","),
        ("", "")
      ).1
    );
    (println : (string) -> ())(
      (isize::to_string : (isize) -> string)(
        (Vec[string]::len : (Vec[string]) -> isize)(
          (string::lines : (string) -> Vec[string])((text/0 : string))
        )
      )
    );
    (println : (string) -> ())(
      (isize::to_string : (isize) -> string)(
        (Option[isize]::unwrap_or : (Option[isize], isize) -> isize)(
          (string::find : (string, string) -> Option[isize])((text/0 : string), "World"),
          -1
        )
      )
    );
    (println : (string) -> ())(
      (isize::to_string : (isize) -> string)(
        (Option[isize]::unwrap_or : (Option[isize], isize) -> isize)(
          (string::rfind : (string, string) -> Option[isize])((text/0 : string), "l"),
          -1
        )
      )
    );
    (println : (string) -> ())(
      (isize::to_string : (isize) -> string)(
        (Option[isize]::unwrap_or : (Option[isize], isize) -> isize)(
          (string::find_bytes : (string, string) -> Option[isize])((text/0 : string), "lo"),
          -1
        )
      )
    );
    (println : (string) -> ())(
      (ToString::to_string : (bool) -> string)(
        (string::starts_with_at : (string, isize, string) -> bool)((text/0 : string), 2, "Hé")
      )
    );
    (println : (string) -> ())(
      (isize::to_string : (isize) -> string)(
        (string::char_count : (string) -> isize)((text/0 : string))
      )
    );
    (println : (string) -> ())(
      (Option[string]::unwrap_or : (Option[string], string) -> string)(
        (string::slice_chars : (string, isize, isize) -> Option[string])((text/0 : string), 2, 7),
        "none"
      )
    );
    (println : (string) -> ())(
      (string::replace : (string, string, string) -> string)((text/0 : string), "l", "L")
    );
    (println : (string) -> ())((string::repeat : (string, isize) -> string)("ab", 3));
    (println : (string) -> ())(
      (ToString::to_string : (bool) -> string)(
        (string::is_ascii : (string) -> bool)((text/0 : string))
      )
    );
    (println : (string) -> ())(
      (ToString::to_string : (bool) -> string)(
        (string::eq_ignore_ascii_case : (string, string) -> bool)("ABC", "abc")
      )
    );
    (println : (string) -> ())((string::to_ascii_lowercase : (string) -> string)("AbC"));
    (println : (string) -> ())((string::to_ascii_uppercase : (string) -> string)("aBc"))
}