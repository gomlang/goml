package main
file main.goml
  fn main() -> () {
      let local/1/0 = "  Héllo, World!  ";
      println("[" + text/0.trim() + "]");
      println("[" + text/0.trim_start() + "]");
      println("[" + text/0.trim_end() + "]");
      println(text/0.split(",").join("|"));
      println(text/0.split_once(",").unwrap_or(("", "")).1);
      println(text/0.lines().len().to_string());
      println(text/0.find("World").unwrap_or(-1).to_string());
      println(text/0.rfind("l").unwrap_or(-1).to_string());
      println(text/0.find_bytes("lo").unwrap_or(-1).to_string());
      println(text/0.starts_with_at(2, "Hé").to_string());
      println(text/0.char_count().to_string());
      println(text/0.slice_chars(2, 7).unwrap_or("none"));
      println(text/0.replace("l", "L"));
      println("ab".repeat(3));
      println(text/0.is_ascii().to_string());
      println("ABC".eq_ignore_ascii_case("abc").to_string());
      println("AbC".to_ascii_lowercase());
      println("aBc".to_ascii_uppercase())
  }