fn loop_return_unit(flag: bool) -> () {
    while if flag {
        return
    } else {
        return
    } {
        println("unreachable");
    }
}

fn loop_return() -> i32 {
    while match 0 {
        _ => return 5,
    } {
        println("unreachable");
    }
    0
}

fn main() -> () {
    loop_return_unit(true);
    println(loop_return());
}
