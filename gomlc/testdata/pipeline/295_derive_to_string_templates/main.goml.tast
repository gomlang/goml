impl ToString for Status {
  fn to_string(self/0: Status) -> string {
      match (self/0 : Status) {
          Status::Ready =>
            {
                "" + "ready"
            },
          Status::Retry(#derive0_field/1: isize) =>
            {
                let #derive1_formatted/2: string =
                  (ToString::to_string : (isize) -> string)((#derive0_field/1 : isize));
                "" + "retry after " + (#derive1_formatted/2 : string) + "s"
            },
          Status::Failed(_ : isize, #derive3_field/3: string) =>
            {
                let #derive4_formatted/4: string = (#derive3_field/3 : string);
                "" + "错误 " + "{" + (#derive4_formatted/4 : string) + "}"
            },
          Status::Unknown => "Status::Unknown",
          Status::DefaultTuple(#derive5_field/5: isize) =>
            "Status::DefaultTuple(" +
              (ToString::to_string : (isize) -> string)((#derive5_field/5 : isize)) +
              ")",
          Status::DefaultNamed(#derive6_field/6: string) =>
            "Status::DefaultNamed { " + "value: " + (#derive6_field/6 : string) + " }",
          Status::Empty =>
            {
                ""
            },
          Status::Raw =>
            {
                "" + "raw\\path " + "{" + "ok" + "}"
            },
      }
  }
}

impl Debug for Status {
  fn debug(self/7: Status) -> string {
      match (self/7 : Status) {
          Status::Ready => "Status::Ready",
          Status::Retry(#derive0_field/8: isize) =>
            "Status::Retry(" + (Debug::debug : (isize) -> string)((#derive0_field/8 : isize)) + ")",
          Status::Failed(#derive1_field/9: isize, #derive2_field/10: string) =>
            "Status::Failed { " + "code: " +
              (Debug::debug : (isize) -> string)((#derive1_field/9 : isize)) +
              ", " +
              "message: " +
              (Debug::debug : (string) -> string)((#derive2_field/10 : string)) +
              " }",
          Status::Unknown => "Status::Unknown",
          Status::DefaultTuple(#derive3_field/11: isize) =>
            "Status::DefaultTuple(" +
              (Debug::debug : (isize) -> string)((#derive3_field/11 : isize)) +
              ")",
          Status::DefaultNamed(#derive4_field/12: string) =>
            "Status::DefaultNamed { " + "value: " +
              (Debug::debug : (string) -> string)((#derive4_field/12 : string)) +
              " }",
          Status::Empty => "Status::Empty",
          Status::Raw => "Status::Raw",
      }
  }
}

impl[T] ToString for Hidden[T] {
  fn to_string(self/13: Hidden[T]) -> string {
      match (self/13 : Hidden[T]) {
          Hidden::Value(_ : T) =>
            {
                "" + "hidden"
            },
          Hidden::Named(_ : T, #derive2_field/14: string) =>
            {
                let #derive3_formatted/15: string = (#derive2_field/14 : string);
                "" + (#derive3_formatted/15 : string)
            },
      }
  }
}

impl[T] ToString for Mixed[T] where T: ToString {
  fn to_string(self/16: Mixed[T]) -> string {
      match (self/16 : Mixed[T]) {
          Mixed::Hidden(_ : T) =>
            {
                "" + "hidden"
            },
          Mixed::Shown(#derive1_field/17: T) =>
            "Mixed::Shown(" + (ToString::to_string : (T) -> string)((#derive1_field/17 : T)) + ")",
      }
  }
}

impl ToString for Counted {
  fn to_string(self/18: Counted) -> string {
      (Ref[isize]::set : (Ref[isize], isize) -> ())(
        (self/18 : Counted).calls,
        (Ref[isize]::get : (Ref[isize]) -> isize)((self/18 : Counted).calls) + 1
      );
      (self/18 : Counted).text +
        (isize::to_string : (isize) -> string)(
          (Ref[isize]::get : (Ref[isize]) -> isize)((self/18 : Counted).calls)
        )
  }
}

impl ToString for Repeated {
  fn to_string(self/19: Repeated) -> string {
      match (self/19 : Repeated) {
          Repeated::Pair(#derive0_field/20: Counted, #derive2_field/21: Counted) =>
            {
                let #derive1_formatted/22: string =
                  (ToString::to_string : (Counted) -> string)((#derive0_field/20 : Counted));
                let #derive3_formatted/23: string =
                  (ToString::to_string : (Counted) -> string)((#derive2_field/21 : Counted));
                "" + (#derive3_formatted/23 : string) + ":" + (#derive1_formatted/22 : string) +
                  ":" +
                  (#derive3_formatted/23 : string)
            },
          Repeated::Ignored(_ : Counted) =>
            {
                "" + "ignored"
            },
      }
  }
}

fn main() -> () {
    let ready/24: Status = Status::Ready;
    let retry/25: Status = Status::Retry(3);
    let failed/26: Status = Status::Failed(500, "超时");
    (println : (Status) -> ())((ready/24 : Status));
    (println : (Status) -> ())((retry/25 : Status));
    (println : (Status) -> ())((failed/26 : Status));
    (println : (string) -> ())((Debug::debug : (Status) -> string)((ready/24 : Status)));
    let unknown/27: Status = Status::Unknown;
    let tuple/28: Status = Status::DefaultTuple(7);
    let named/29: Status = Status::DefaultNamed("default");
    let empty/30: Status = Status::Empty;
    let raw/31: Status = Status::Raw;
    (println : (Status) -> ())((unknown/27 : Status));
    (println : (Status) -> ())((tuple/28 : Status));
    (println : (Status) -> ())((named/29 : Status));
    (println : (bool) -> ())((ToString::to_string : (Status) -> string)((empty/30 : Status)) == "");
    (println : (Status) -> ())((raw/31 : Status));
    let hidden/32: Hidden[Opaque] = Hidden::Value(Opaque {});
    let selected/33: Hidden[Opaque] = Hidden::Named(Opaque {}, "visible");
    (println : (Hidden[Opaque]) -> ())((hidden/32 : Hidden[Opaque]));
    (println : (Hidden[Opaque]) -> ())((selected/33 : Hidden[Opaque]));
    let mixed/34: Mixed[isize] = Mixed::Shown(9);
    (println : (Mixed[isize]) -> ())((mixed/34 : Mixed[isize]));
    let calls/35: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    let repeated/36: Repeated =
      Repeated::Pair(
        Counted { calls: (calls/35 : Ref[isize]), text: "a" },
        Counted { calls: (calls/35 : Ref[isize]), text: "b" }
      );
    (println : (Repeated) -> ())((repeated/36 : Repeated));
    (println : (isize) -> ())((Ref[isize]::get : (Ref[isize]) -> isize)((calls/35 : Ref[isize])));
    let ignored/37: Repeated =
      Repeated::Ignored(Counted { calls: (calls/35 : Ref[isize]), text: "unused" });
    (println : (Repeated) -> ())((ignored/37 : Repeated));
    (println : (isize) -> ())((Ref[isize]::get : (Ref[isize]) -> isize)((calls/35 : Ref[isize])));
}