#[derive(ToString, Debug)]
enum Status {
    #[to_string("ready")]
    Ready,
    #[to_string("retry after {0}s")]
    Retry(isize),
    #[to_string("错误 {{{message}}}")]
    Failed { code: isize, message: string },
    Unknown,
    DefaultTuple(isize),
    DefaultNamed { value: string },
    #[to_string("")]
    Empty,
    #[to_string(r"raw\path {{ok}}")]
    Raw,
}

struct Opaque {}

#[derive(ToString)]
enum Hidden[T] {
    #[to_string("hidden")]
    Value(T),
    #[to_string("{shown}")]
    Named { hidden: T, shown: string },
}

#[derive(ToString)]
enum Mixed[T] {
    #[to_string("hidden")]
    Hidden(T),
    Shown(T),
}

struct Counted {
    calls: Ref[isize],
    text: string,
}

impl ToString for Counted {
    fn to_string(self) -> string {
        self.calls.set(self.calls.get() + 1);
        self.text + self.calls.get().to_string()
    }
}

#[derive(ToString)]
enum Repeated {
    #[to_string("{1}:{0}:{1}")]
    Pair(Counted, Counted),
    #[to_string("ignored")]
    Ignored(Counted),
}

fn main() -> () {
    let ready: Status = Ready;
    let retry: Status = Retry(3);
    let failed: Status = Failed { code: 500, message: "超时" };
    println(ready);
    println(retry);
    println(failed);
    println(ready.debug());
    let unknown: Status = Unknown;
    let tuple: Status = DefaultTuple(7);
    let named: Status = DefaultNamed { value: "default" };
    let empty: Status = Empty;
    let raw: Status = Raw;
    println(unknown);
    println(tuple);
    println(named);
    println(empty.to_string() == "");
    println(raw);
    let hidden: Hidden[Opaque] = Value(Opaque {});
    let selected: Hidden[Opaque] = Named { hidden: Opaque {}, shown: "visible" };
    println(hidden);
    println(selected);
    let mixed: Mixed[isize] = Shown(9);
    println(mixed);
    let calls = Ref::new(0);
    let repeated: Repeated = Pair(
        Counted { calls, text: "a" },
        Counted { calls, text: "b" },
    );
    println(repeated);
    println(calls.get());
    let ignored: Repeated = Ignored(Counted { calls, text: "unused" });
    println(ignored);
    println(calls.get());
}
