package main;
#[derive(ToString, Debug)]
enum Status {
    #[to_string("ready")]
        Ready,
    #[to_string("retry after {0}s")]
        Retry(isize),
    #[to_string("错误 {{{message}}}")]
        Failed { code: isize, message: string },
    Unknown,
    DefaultTuple(isize),
    DefaultNamed { value: string },
    #[to_string("")]
        Empty,
    #[to_string(r"raw\path {{ok}}")]
        Raw
}

impl ToString for Status {
  fn to_string(self: Status) -> string {
      match self {
          Status::Ready =>
            {
                "" + "ready"
            },
          Status::Retry(#derive0_field) =>
            {
                let #derive1_formatted = ToString::to_string(#derive0_field);
                "" + "retry after " + #derive1_formatted + "s"
            },
          Status::Failed { code: _, message: #derive3_field } =>
            {
                let #derive4_formatted = #derive3_field;
                "" + "错误 " + "{" + #derive4_formatted + "}"
            },
          Status::Unknown => "Status::Unknown",
          Status::DefaultTuple(#derive5_field) =>
            "Status::DefaultTuple(" + ToString::to_string(#derive5_field) + ")",
          Status::DefaultNamed { value: #derive6_field } =>
            "Status::DefaultNamed { " + "value: " + #derive6_field + " }",
          Status::Empty =>
            {
                ""
            },
          Status::Raw =>
            {
                "" + "raw\\path " + "{" + "ok" + "}"
            },
      }
  }
}

impl Debug for Status {
  fn debug(self: Status) -> string {
      match self {
          Status::Ready => "Status::Ready",
          Status::Retry(#derive0_field) => "Status::Retry(" + Debug::debug(#derive0_field) + ")",
          Status::Failed { code: #derive1_field, message: #derive2_field } =>
            "Status::Failed { " + "code: " + Debug::debug(#derive1_field) + ", " + "message: " +
              Debug::debug(#derive2_field) +
              " }",
          Status::Unknown => "Status::Unknown",
          Status::DefaultTuple(#derive3_field) =>
            "Status::DefaultTuple(" + Debug::debug(#derive3_field) + ")",
          Status::DefaultNamed { value: #derive4_field } =>
            "Status::DefaultNamed { " + "value: " + Debug::debug(#derive4_field) + " }",
          Status::Empty => "Status::Empty",
          Status::Raw => "Status::Raw",
      }
  }
}

struct Opaque {}

#[derive(ToString)]
enum Hidden[T] {
    #[to_string("hidden")]
        Value(T),
    #[to_string("{shown}")]
        Named { hidden: T, shown: string }
}

impl[T] ToString for Hidden[T] {
  fn to_string(self: Hidden[T]) -> string {
      match self {
          Hidden::Value(_) =>
            {
                "" + "hidden"
            },
          Hidden::Named { hidden: _, shown: #derive2_field } =>
            {
                let #derive3_formatted = #derive2_field;
                "" + #derive3_formatted
            },
      }
  }
}

#[derive(ToString)]
enum Mixed[T] {
    #[to_string("hidden")]
        Hidden(T),
    Shown(T)
}

impl[T] ToString for Mixed[T] where T: ToString {
  fn to_string(self: Mixed[T]) -> string {
      match self {
          Mixed::Hidden(_) =>
            {
                "" + "hidden"
            },
          Mixed::Shown(#derive1_field) =>
            "Mixed::Shown(" + ToString::to_string(#derive1_field) + ")",
      }
  }
}

struct Counted {
    calls: Ref[isize],
    text: string,
}

impl ToString for Counted {
  fn to_string(self: Counted) -> string {
      self.calls.set(self.calls.get() + 1);
      self.text + self.calls.get().to_string()
  }
}

#[derive(ToString)]
enum Repeated {
    #[to_string("{1}:{0}:{1}")]
        Pair(Counted, Counted),
    #[to_string("ignored")]
        Ignored(Counted)
}

impl ToString for Repeated {
  fn to_string(self: Repeated) -> string {
      match self {
          Repeated::Pair(#derive0_field, #derive2_field) =>
            {
                let #derive1_formatted = ToString::to_string(#derive0_field);
                let #derive3_formatted = ToString::to_string(#derive2_field);
                "" + #derive3_formatted + ":" + #derive1_formatted + ":" + #derive3_formatted
            },
          Repeated::Ignored(_) =>
            {
                "" + "ignored"
            },
      }
  }
}

fn main() -> () {
    let ready: Status = Ready;
    let retry: Status = Retry(3);
    let failed: Status = Failed { code: 500, message: "超时" };
    println(ready);
    println(retry);
    println(failed);
    println(ready.debug());
    let unknown: Status = Unknown;
    let tuple: Status = DefaultTuple(7);
    let named: Status = DefaultNamed { value: "default" };
    let empty: Status = Empty;
    let raw: Status = Raw;
    println(unknown);
    println(tuple);
    println(named);
    println(empty.to_string() == "");
    println(raw);
    let hidden: Hidden[Opaque] = Value(Opaque {});
    let selected: Hidden[Opaque] = Named { hidden: Opaque {}, shown: "visible" };
    println(hidden);
    println(selected);
    let mixed: Mixed[isize] = Shown(9);
    println(mixed);
    let calls = Ref::new(0);
    let repeated: Repeated =
      Pair(Counted { calls: calls, text: "a" }, Counted { calls: calls, text: "b" });
    println(repeated);
    println(calls.get());
    let ignored: Repeated = Ignored(Counted { calls: calls, text: "unused" });
    println(ignored);
    println(calls.get());
}

