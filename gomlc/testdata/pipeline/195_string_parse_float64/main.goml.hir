package main
file main.goml
  fn main() -> () {
      let (local/main/0, local/main/1) = string_parse_float64("3.125");
      println(valid/0.to_string());
      println(value/1.to_string());
      let (local/main/2, local/main/3) = string_parse_float32("3.14");
      println(rounded_valid/2.to_string());
      println(rounded/3.to_string());
      let (local/main/4, local/main/5) = string_parse_float64("not-a-number");
      println(invalid/4.to_string());
      println(fallback/5.to_string())
  }