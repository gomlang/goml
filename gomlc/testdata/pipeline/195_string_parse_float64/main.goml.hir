package main
file main.goml
  fn main() -> () {
      let (local/1/0, local/1/1) = string_parse_float64("3.125");
      println(valid/0.to_string());
      println(value/1.to_string());
      let (local/1/2, local/1/3) = string_parse_float32("3.14");
      println(rounded_valid/2.to_string());
      println(rounded/3.to_string());
      let (local/1/4, local/1/5) = string_parse_float64("not-a-number");
      println(invalid/4.to_string());
      println(fallback/5.to_string())
  }