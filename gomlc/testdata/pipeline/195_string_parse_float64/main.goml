fn main() -> () {
    let (valid, value) = string_parse_float64("3.125");
    println(valid.to_string());
    println(value.to_string());
    let (rounded_valid, rounded) = string_parse_float32("3.14");
    println(rounded_valid.to_string());
    println(rounded.to_string());
    let (invalid, fallback) = string_parse_float64("not-a-number");
    println(invalid.to_string());
    println(fallback.to_string())
}
