fn main() -> () {
    // Test Vec with i32
    let vi: Vec[i32] = Vec::new();
    vi.push(42);
    let val_i = vi[0];
    let len_i = vi.len();

    // Test Vec with string
    let vs: Vec[string] = Vec::new();
    vs.push("hello");
    vs.push("world");
    let val_s = vs[1];
    let len_s = vs.len();

    // Test Vec with bool
    let vb: Vec[bool] = Vec::new();
    vb.push(true);
    vb.push(false);
    let val_b = vb[0];
    let len_b = vb.len();

    // Print results
    let _ = println(val_i.to_string());
    let _ = println(len_i.to_string());
    let _ = println(val_s);
    let _ = println(len_s.to_string());
    let _ = println(val_b.to_string());
    let _ = println(len_b.to_string());
}
