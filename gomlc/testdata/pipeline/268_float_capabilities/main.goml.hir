package main
file main.goml
  fn main() -> () {
      let local/main/0: f32 = 1.5;
      println(single/0.to_bits());
      println(float32_from_bits(1069547520).to_string());
      println(single/0.to_f64().to_bits());
      println(16777217.0.to_f32().to_string());
      println(float64_from_bits(4607182418800017408).to_string());
      let (local/main/1, local/main/2) = string_parse_float64("0x1.8p+1");
      println(hex_valid/1);
      println(hex_value/2);
      let (local/main/3, local/main/4) = string_parse_float64("1.7976931348623157e308");
      println(maximum_valid/3);
      println(maximum_value/4.to_bits());
      let (local/main/5, local/main/6) = string_parse_float64("5e-324");
      println(minimum_valid/5);
      println(minimum_value/6.to_bits());
      let (local/main/7, local/main/8) = string_parse_float32("3.4028235e38");
      println(single_valid/7);
      println(single_value/8.to_f32().to_bits());
      let (local/main/9, local/main/10) = string_parse_float64("1e309");
      println(overflow_valid/9);
      println(overflow_value/10);
      let (local/main/11, local/main/12) = string_parse_float64("1e-400");
      println(underflow_valid/11);
      println(underflow_value/12)
  }