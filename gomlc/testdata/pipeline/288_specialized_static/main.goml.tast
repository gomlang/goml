impl Box[f64] {
  fn from_float(value/0: f64) -> Box[f64] {
      Box { value: (value/0 : f64) }
  }
  fn empty() -> Box[f64] {
      Box { value: 1.5 }
  }
}

impl Box[isize] {
  fn empty() -> Box[isize] {
      Box { value: 12 }
  }
}

impl[T] Box[Vec[T]] {
  fn repeated(value/1: T) -> Box[Vec[T]] {
      Box {
        value: (@intrinsic(vec.from_array) : ([T; 2]) -> Vec[T])([(value/1 : T), (value/1 : T)])
      }
  }
}

fn main() -> () {
    let inferred/2: Box[f64] = (Box[f64]::from_float : (f64) -> Box[f64])(1);
    let explicit/3: Box[f64] = (Box[f64]::from_float : (f64) -> Box[f64])(2);
    (println : (f64) -> ())((inferred/2 : Box[f64]).value + (explicit/3 : Box[f64]).value);
    let first/4: Box[f64] = (Box[f64]::empty : () -> Box[f64])();
    let second/5: Box[isize] = (Box[isize]::empty : () -> Box[isize])();
    (println : (f64) -> ())((first/4 : Box[f64]).value);
    (println : (isize) -> ())((second/5 : Box[isize]).value);
    (println : (isize) -> ())((Box[isize]::empty : () -> Box[isize])().value);
    let nested/6: Box[Vec[string]] =
      (Box[Vec[string]]::repeated : (string) -> Box[Vec[string]])("nested");
    (println : (string) -> ())((nested/6 : Box[Vec[string]]).value[1])
}