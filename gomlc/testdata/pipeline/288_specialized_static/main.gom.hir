package main
file main.gom
  struct Box[T] {
      value: T,
  }

  impl Box[f64] {
    fn from_float(local/1/0: f64) -> Box[f64] {
        Box { value: value/0 }
    }
    fn empty() -> Box[f64] {
        Box { value: 1.5 }
    }
  }

  impl Box[isize] {
    fn empty() -> Box[isize] {
        Box { value: 12 }
    }
  }

  impl[T] Box[Vec[T]] {
    fn repeated(local/1/1: T) -> Box[Vec[T]] {
        Box { value: Vec::from_array([value/1, value/1]) }
    }
  }

  fn main() -> () {
      let local/1/2: Box[f64] = Box::from_float(1.0);
      let local/1/3 = Box[f64]::from_float(2.0);
      println(inferred/2.value + explicit/3.value);
      let local/1/4: Box[f64] = Box::empty();
      let local/1/5: Box[isize] = Box::empty();
      println(first/4.value);
      println(second/5.value);
      println(Box[isize]::empty().value);
      let local/1/6 = Box[Vec[string]]::repeated("nested");
      println(nested/6.value[1])
  }