struct Box[T] {
    value: T,
}

impl Box[f64] {
    fn from_float(value: f64) -> Box[f64] {
        Box { value }
    }

    fn empty() -> Box[f64] {
        Box { value: 1.5 }
    }
}

impl Box[isize] {
    fn empty() -> Box[isize] {
        Box { value: 12 }
    }
}

impl[T] Box[Vec[T]] {
    fn repeated(value: T) -> Box[Vec[T]] {
        Box { value: Vec::from_array([value, value]) }
    }
}

fn main() -> () {
    let inferred: Box[f64] = Box::from_float(1.0);
    let explicit = Box::[f64]::from_float(2.0);
    println(inferred.value + explicit.value);
    let first: Box[f64] = Box::empty();
    let second: Box[isize] = Box::empty();
    println(first.value);
    println(second.value);
    println(Box::[isize]::empty().value);
    let nested = Box::[Vec[string]]::repeated("nested");
    println(nested.value[1])
}
