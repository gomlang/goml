package main
file main.goml
  trait Show {
    fn show(Self) -> string;
  }

  struct Wrap[T] {
      value: T,
  }

  impl Show for Wrap[i32] {
    fn show(local/1/0: Wrap[i32]) -> string {
        self/0.value.to_string()
    }
  }

  fn make_wrap[T](local/1/1: T) -> Wrap[T] {
      Wrap { value: value/1 }
  }

  fn render(local/1/2: dyn Show) -> string {
      Show::show(value/2)
  }

  fn main() -> () {
      let local/1/3: i32 = 42;
      println(def/1/4(def/1/3(value/3) as dyn Show))
  }