package main
file main.goml
  trait Show {
    fn show(Self) -> string;
  }

  struct Wrap[T] {
      value: T,
  }

  impl Show for Wrap[i32] {
    fn show(local/main/0: Wrap[i32]) -> string {
        self/0.value.to_string()
    }
  }

  fn make_wrap[T](local/main/1: T) -> Wrap[T] {
      Wrap { value: value/1 }
  }

  fn render(local/main/2: dyn Show) -> string {
      Show::show(value/2)
  }

