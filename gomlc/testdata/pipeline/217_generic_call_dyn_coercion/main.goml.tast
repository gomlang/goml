impl Show for Wrap[i32] {
  fn show(self/0: Wrap[i32]) -> string {
      (i32::to_string : (i32) -> string)((self/0 : Wrap[i32]).value)
  }
}

fn make_wrap[T](value/1: T) -> Wrap[T] {
    Wrap { value: (value/1 : T) }
}

fn render(value/2: dyn Show) -> string {
    (dyn Show::show : (dyn Show) -> string)((value/2 : dyn Show))
}

fn main() -> () {
    let value/3: i32 = 42;
    (println : (string) -> ())(
      (render : (dyn Show) -> string)(
        to_dyn[Show]{Wrap[i32]}((make_wrap : (i32) -> Wrap[i32])((value/3 : i32)))
      )
    )
}