package main;
trait Show {
  fn show(self: Self) -> string;
}

struct Wrap[T] {
    value: T,
}

impl Show for Wrap[i32] {
  fn show(self: Wrap[i32]) -> string {
      self.value.to_string()
  }
}

fn make_wrap[T](value: T) -> Wrap[T] {
    Wrap { value: value }
}

fn render(value: dyn Show) -> string {
    Show::show(value)
}

fn main() -> () {
    let value: i32 = 42;
    println(render(make_wrap(value) as dyn Show))
}

