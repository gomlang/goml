fn main() -> () {
    let native/0: isize = 7;
    let small/1: i8 = 8;
    let unsigned/2: u8 = 9;
    let text/3: string =
      (int_to_string : (isize) -> string)((native/0 : isize)) +
        (int8_to_string : (i8) -> string)((small/1 : i8)) +
        (uint8_to_string : (u8) -> string)((unsigned/2 : u8)) +
        (string_byte_slice : (string, isize, isize) -> string)("abcd", 1, 3);
    let value/4: Ref[i32] = (@intrinsic(ref.new) : (i32) -> Ref[i32])(1);
    (@intrinsic(ref.set) : (Ref[i32], i32) -> ())((value/4 : Ref[i32]), 2);
    let same/5: bool =
      (@intrinsic(ref.ptr_eq) : (Ref[i32], Ref[i32]) -> bool)(
        (value/4 : Ref[i32]),
        (value/4 : Ref[i32])
      );
    let _ : u64 = (@intrinsic(ref.ptr_hash) : (Ref[i32]) -> u64)((value/4 : Ref[i32]));
    let values/6: Vec[i32] = (@intrinsic(vec.new) : () -> Vec[i32])();
    (@intrinsic(vec.push) : (Vec[i32], i32) -> ())(
      (values/6 : Vec[i32]),
      (@intrinsic(ref.get) : (Ref[i32]) -> i32)((value/4 : Ref[i32]))
    );
    (@intrinsic(vec.push) : (Vec[i32], i32) -> ())((values/6 : Vec[i32]), 3);
    (@intrinsic(vec.set) : (Vec[i32], isize, i32) -> ())((values/6 : Vec[i32]), 1, 4);
    let values_slice/7: Slice[i32] =
