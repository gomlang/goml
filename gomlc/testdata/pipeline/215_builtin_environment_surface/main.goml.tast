      );
    let channel/9: Channel[i32] = (@intrinsic(channel.new) : (isize) -> Channel[i32])(1);
    (@intrinsic(channel.send) : (Channel[i32], i32) -> ())(
      (channel/9 : Channel[i32]),
      (@intrinsic(slice.get) : (Slice[i32], isize) -> i32)((nested/8 : Slice[i32]), 1)
    );
