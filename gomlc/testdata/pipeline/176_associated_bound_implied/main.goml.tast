impl Label for string {
  fn label(self/0: string) -> string {
      "label:" + (self/0 : string)
  }
}

impl Source for TextSource {
  fn get(self/1: TextSource) -> string {
      (self/1 : TextSource).value
  }
}

fn render[S](source/2: S) -> string where S: Source, S::Item: Label {
    (Label::label : (S::Item) -> string)((Source::get : (S) -> S::Item)((source/2 : S)))
}

fn main() -> () {
    (println : (string) -> ())((render : (TextSource) -> string)(TextSource { value: "goml" }));
}