package main
file main.goml
  trait Label {
    fn label(Self) -> string;
  }

  trait Source {
    type Item: Label;
    fn get(Self) -> Self::Item;
  }

  struct TextSource {
      value: string,
  }

  impl Label for string {
    fn label(local/main/0: string) -> string {
        "label:" + self/0
    }
  }

  impl Source for TextSource {
    type Item = string;
    fn get(local/main/1: TextSource) -> string {
        self/1.value
    }
  }

  fn render[S: Source](local/main/2: S) -> string {
      Source::get(source/2).label()
  }

  fn main() -> () {
      println(source:4:main:5(TextSource { value: "goml" }));
  }