fn answer() -> isize {
    return {
        let base = 40;
        base + 2
    };
}

fn loop_answer() -> isize {
    loop {
        break {
            let base = 6;
            base * 7
        };
    }
}

fn main() -> () {
    let plain: Vec[byte] = b"A\n\x42";
    let empty = b"";
    let raw = br#"raw \n bytes"#;
    let quoted = br##"quoted "text" and #"##;
    let fixed: [byte; 3] = b"ABC";
    let nested = {
        let value = answer();
        value + loop_answer()
    };
    println(plain.len().to_string());
    println(empty.len().to_string());
    println((plain.get(0).to_isize()).to_string());
    println((plain.get(1).to_isize()).to_string());
    println((plain.get(2).to_isize()).to_string());
    println(raw.len().to_string());
    println(quoted.len().to_string());
    println((fixed[2].to_isize()).to_string());
    println(nested.to_string());
    if ({
        true
    }) {
        println("block condition")
    }
}
