package main
file main.goml
  fn answer() -> isize {
      return {
          let local/main/0 = 40;
          base/0 + 2
      };
  }

  fn loop_answer() -> isize {
      loop {
          break {
              let local/main/1 = 6;
              base/1 * 7
          };
      }
  }

  fn main() -> () {
      let local/main/2: Vec[byte] = b"\x41\x0a\x42";
      let local/main/3 = b"";
