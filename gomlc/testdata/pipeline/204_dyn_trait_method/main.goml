trait Named {
    fn name(self) -> string;
}

trait Display: Named {
    fn show(self, prefix: string) -> string;
}

struct Point {
    value: i32,
}

impl Named for Point {
    fn name(self) -> string {
        "point"
    }
}

impl Display for Point {
    fn show(self, prefix: string) -> string {
        prefix + self.value.to_string()
    }
}

fn render(value: dyn Display) -> () {
    println(value.show("value="));
    println(value.name());
    println(Display::show(value, "again="));
}

fn main() -> () {
    let value: dyn Display = Point { value: 7 } as dyn Display;
    render(value);
}
