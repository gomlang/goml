package main
file main.goml
  trait Named {
    fn name(Self) -> string;
  }

  trait Display: Named {
    fn show(Self, string) -> string;
  }

  struct Point {
      value: i32,
  }

  impl Named for Point {
    fn name(local/main/0: Point) -> string {
        "point"
    }
  }

  impl Display for Point {
    fn show(local/main/1: Point, local/main/2: string) -> string {
        prefix/2 + self/1.value.to_string()
    }
  }

  fn render(local/main/3: dyn Display) -> () {
      println(value/3.show("value="));
      println(value/3.name());
      println(Display::show(value/3, "again="));
  }

  fn main() -> () {
      let local/main/4: dyn Display = Point { value: 7 } as dyn Display;
      source:4:main:5(value/4);
  }