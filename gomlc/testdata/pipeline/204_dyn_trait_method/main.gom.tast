impl Named for Point {
  fn name(self/0: Point) -> string {
      "point"
  }
}

impl Display for Point {
  fn show(self/1: Point, prefix/2: string) -> string {
      (prefix/2 : string) + (i32::to_string : (i32) -> string)((self/1 : Point).value)
  }
}

fn render(value/3: dyn Display + Named) -> () {
    (println : (string) -> ())(
      (dyn Display::show : (dyn Display + Named, string) -> string)(
        (value/3 : dyn Display + Named),
        "value="
      )
    );
    (println : (string) -> ())(
      (dyn Display::name : (dyn Display + Named) -> string)((value/3 : dyn Display + Named))
    );
    (println : (string) -> ())(
      (dyn Display::show : (dyn Display + Named, string) -> string)(
        (value/3 : dyn Display + Named),
        "again="
      )
    );
}

fn main() -> () {
    let value/4: dyn Display + Named = to_dyn[Display]{Point}(Point { value: 7 });
    (render : (dyn Display + Named) -> ())((value/4 : dyn Display + Named));
}