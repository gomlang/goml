trait Display {
    fn show(self: Self) -> string;
}

impl Display for i32 {
    fn show(self: i32) -> string {
        self.to_string()
    }
}

fn render(x: dyn Display) -> string {
    Display::show(x)
}

fn main() -> () {
    let v: Vec[dyn Display] = Vec::new();
    let first: i32 = 10;
    let second: i32 = 20;
    v.push(first as dyn Display);
    v.push(second as dyn Display);
    let s: Slice[dyn Display] = v.slice(0, 2);
    println(render(s[0]));
    let t = s.sub(1, 2);
    println(render(t[0]));
}
