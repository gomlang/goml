fn fetch(flag/0: bool) -> Option[i32] {
    let m/1: HashMap[string, i32] = (HashMap[string, i32]::new : () -> HashMap[string, i32])();
    if (flag/0 : bool) {
        {
            (HashMap[string, i32]::set : (HashMap[string, i32], string, i32) -> ())(
              (m/1 : HashMap[string, i32]),
              "a",
              7
            );
        }
    } else {
        {}
    };
    let value/2: i32 =
      match (HashMap[string, i32]::get : (HashMap[string, i32], string) -> Option[i32])(
        (m/1 : HashMap[string, i32]),
        "a"
      ) {
          Option::Some(try_value/16: i32) => (try_value/16 : i32),
          Option::None => return Option::None,
      };
    Option::Some((value/2 : i32) + 1)
}

fn show(opt/3: Option[i32]) -> string {
    match (opt/3 : Option[i32]) {
        Option::Some(value/4: i32) => "some=" + (i32::to_string : (i32) -> string)((value/4 : i32)),
        Option::None => "none",
    }
}

fn main() -> () {
    (println : (string) -> ())(
      (show : (Option[i32]) -> string)((fetch : (bool) -> Option[i32])(true))
    );
    (println : (string) -> ())(
      (show : (Option[i32]) -> string)((fetch : (bool) -> Option[i32])(false))
    );
}