package main
file main.goml
  fn early_return() -> isize {
      defer println("return:outer");
      {
          defer println("return:inner");
          return 7;
      };
      0
  }

  fn maybe(local/main/0: Option[isize]) -> Option[isize] {
      defer println("try:cleanup");
      let local/main/1 = value/0?;
      Option::Some(number/1)
  }

  fn loop_cleanup() -> () {
      let local/main/2 = Ref::new(0);
      while index/2.get() < 3 {
          {
              let local/main/3 = index/2.get();
              defer println("loop:" + current/3.to_string());
              index/2.set(current/3 + 1);
              if current/3 == 0 {
                  continue;
              } else if current/3 == 1 {
                  break;
              } else {}
          }
      }
  }

  fn observed_at_exit() -> () {
      let local/main/4 = Ref::new("before");
      defer println("observed:" + value/4.get());
      value/4.set("after")
  }

  fn pattern_cleanup(local/main/5: Option[isize]) -> isize {
      defer println("pattern:cleanup");
      let Option::Some(local/main/6) =
        value/5 else
        {
            return 0;
        };
      let (local/main/7, local/main/8) = (number/6, 2);
      left/7 + right/8
  }

  fn closure_cleanup() -> () {
      defer println("closure:outer");
      let local/main/9 =
        || {
            defer println("closure:inner");
            println("closure:body")
        };
      run/9();
      println("closure:after")
  }

  fn main() -> () {
      defer println("main:first");
      defer println("main:second");
      {
          defer println("block");
          println("body")
      };
      println(source:4:main:0().to_string());
      let _ = source:4:main:1(Option::None);
      source:4:main:2();
      source:4:main:3();
      println(source:4:main:4(Option::Some(3)).to_string());
      println(source:4:main:4(Option::None).to_string());
      source:4:main:5()
  }