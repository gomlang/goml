package main;
fn then_break_outer_continue(flag: bool) -> isize {
    let rounds = Ref::new(0);
    'outer: loop {
        if rounds.get() == 0 {
            {
                rounds.set(1);
                loop {
                    if flag {
                        {
                            if rounds.get() == 1 {
                                {
                                    break
                                }
                            } else {
                                {
                                    continue
                                }
                            }
                        }
                    } else {
                        {
                            continue
                        }
                    }
                };
                continue 'outer
            }
        } else {
            {
                break 'outer 21
            }
        }
    }
}

fn then_break_outer_break(flag: bool) -> isize {
    let state = Ref::new(1);
    'outer: loop {
        loop {
            if flag {
                {
                    if state.get() == 1 {
                        {
                            break
                        }
                    } else {
                        {
                            continue
                        }
                    }
                }
            } else {
                {
                    continue
                }
            }
        };
        break 'outer 22
    }
}

fn else_break_outer_continue(flag: bool) -> isize {
    let rounds = Ref::new(0);
    'outer: loop {
        if rounds.get() == 0 {
            {
                rounds.set(1);
                loop {
                    if flag {
                        {
                            continue
                        }
                    } else {
                        {
                            if rounds.get() == 1 {
                                {
                                    break
                                }
                            } else {
                                {
                                    continue
                                }
                            }
                        }
                    }
                };
                continue 'outer
            }
        } else {
            {
                break 'outer 23
            }
        }
    }
}

fn else_break_outer_break(flag: bool) -> isize {
    let state = Ref::new(1);
    'outer: loop {
        loop {
            if flag {
                {
                    continue
                }
            } else {
                {
                    if state.get() == 1 {
                        {
                            break
                        }
                    } else {
                        {
                            continue
                        }
                    }
                }
            }
        };
        break 'outer 24
    }
}

fn main() -> () {
    println(then_break_outer_continue(true));
    println(then_break_outer_break(true));
    println(else_break_outer_continue(false));
    println(else_break_outer_break(false))
}

