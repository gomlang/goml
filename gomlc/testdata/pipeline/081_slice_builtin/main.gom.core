  let _wild5 = println(inherent#Slice#Slice[i32]#get(s/0, 0)) in
  let _wild6 = println(inherent#Slice#Slice[i32]#get(s/0, 1)) in
  let _wild7 = println(inherent#Slice#Slice[i32]#get(s/0, 2)) in
  let t/0 = inherent#Slice#Slice[i32]#sub(s/0, 1, 3) in
  let _wild8 = println(inherent#Slice#Slice[i32]#len(t/0)) in
  let _wild9 = println(inherent#Slice#Slice[i32]#get(t/0, 0)) in
  let _wild10 = println(inherent#Slice#Slice[i32]#get(t/0, 1)) in
