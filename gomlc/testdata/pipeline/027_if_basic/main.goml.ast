package main;
fn choose(flag: bool, x: i32, y: i32) -> i32 {
    if flag {
        {
            x
        }
    } else {
        {
            y
        }
    }
}

fn main() {
    let yes = choose(true, 10, 99);
    let no = choose(false, 10, 99);
    let _ = println("yes=" + yes.to_string());
    let _ = println("no=" + no.to_string());
}

