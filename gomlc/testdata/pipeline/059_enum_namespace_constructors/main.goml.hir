package main
file main.goml
  enum Color {
      Red,
      Green
  }

  enum Signal {
      Red,
      Yellow
  }

  fn color_is_red(local/main/0: Color) -> bool {
      match color/0 {
          ctor(source:4:main:0::v0) => true,
          ctor(source:4:main:0::v1) => false,
      }
  }

  fn toggle_signal(local/main/1: Signal) -> Signal {
      match signal/1 {
          ctor(source:4:main:1::v0) => ctor(source:4:main:1::v1),
          ctor(source:4:main:1::v1) => ctor(source:4:main:1::v0),
      }
  }

  fn main() -> Signal {
      let local/main/2 = ctor(source:4:main:0::v0);
      let _ = source:4:main:2(current/2);
      source:4:main:3(ctor(source:4:main:1::v0))
  }