fn color_is_red(color/0: Color) -> bool {
  match color/0 {
    Color::Red => {
      true
    },
    Color::Green => {
      false
    },
  }
}

fn toggle_signal(signal/0: Signal) -> Signal {
  match signal/0 {
    Signal::Red => {
      Signal::Yellow
    },
    Signal::Yellow => {
      Signal::Red
    },
  }
}

fn main() -> Signal {
  let current/0 = Color::Red in
  let mtmp0 = color_is_red(current/0) in
  {
    toggle_signal(Signal::Red)
  }
}