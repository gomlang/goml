package main
file main.goml
  struct NoTraits {
      value: isize,
  }

  struct Wrapper[T] {
      value: T,
  }

  impl[T] ToString for Wrapper[T] {
    fn to_string(local/1/0: Wrapper[T]) -> string {
        "wrapped"
    }
  }

  impl[T] PartialEq for Wrapper[T] {
    fn eq(local/1/1: Wrapper[T], local/1/2: Wrapper[T]) -> bool {
        true
    }
  }

  impl[T] Eq for Wrapper[T] {}

  impl[T] Hash for Wrapper[T] {
    fn hash(local/1/3: Wrapper[T]) -> u64 {
        7
    }
  }

  #[derive(ToString, PartialEq, Eq, Hash)]
  struct Generic[T, Marker] {
      first: Wrapper[T],
      second: Wrapper[T],
  }

  impl[T, Marker] ToString for Generic[T, Marker] where Wrapper[T]: ToString {
    fn to_string(local/1/4: Generic[T, Marker]) -> string {
        {
            let Generic { first: local/1/5, second: local/1/6 } = self/4;
            "Generic { " + "first: " + ToString::to_string(#derive0_field/5) + ", " + "second: " +
              ToString::to_string(#derive1_field/6) +
              " }"
        }
    }
  }

  impl[T, Marker] PartialEq for Generic[T, Marker] where Wrapper[T]: PartialEq {
    fn eq(local/1/7: Generic[T, Marker], local/1/8: Generic[T, Marker]) -> bool {
        true && PartialEq::eq(self/7.first, other/8.first) &&
          PartialEq::eq(self/7.second, other/8.second)
    }
  }

  impl[T, Marker] Eq for Generic[T, Marker] where Wrapper[T]: Eq {}

  impl[T, Marker] Hash for Generic[T, Marker] where Wrapper[T]: Hash {
    fn hash(local/1/9: Generic[T, Marker]) -> u64 {
        {
            let local/1/10 = 0.to_u64() + 14695981039346656037;
            let local/1/11 = h/10 * 0.to_u64() + 1099511628211 + Hash::hash(self/9.first);
            let local/1/12 = h/11 * 0.to_u64() + 1099511628211 + Hash::hash(self/9.second);
            h/12
        }
    }
  }

  #[derive(ToString, PartialEq, Eq, Hash)]
  enum GenericChoice[T, Marker] {
      Empty,
      Value(Wrapper[T])
  }

  impl[T, Marker] ToString for GenericChoice[T, Marker] where Wrapper[T]: ToString {
    fn to_string(local/1/13: GenericChoice[T, Marker]) -> string {
        match self/13 {
            ctor(def/1/11::v0) => "GenericChoice::Empty",
            ctor(def/1/11::v1)(local/1/14) =>
              "GenericChoice::Value(" + ToString::to_string(#derive0_field/14) + ")",
        }
    }
  }

  impl[T, Marker] PartialEq for GenericChoice[T, Marker] where Wrapper[T]: PartialEq {
    fn eq(local/1/15: GenericChoice[T, Marker], local/1/16: GenericChoice[T, Marker]) -> bool {
        match (self/15, other/16) {
            (ctor(def/1/11::v0), ctor(def/1/11::v0)) => true,
            (ctor(def/1/11::v1)(local/1/17), ctor(def/1/11::v1)(local/1/18)) =>
              true && PartialEq::eq(#derive0_left/17, #derive1_right/18),
            _ => false,
        }
    }
  }

  impl[T, Marker] Eq for GenericChoice[T, Marker] where Wrapper[T]: Eq {}

  impl[T, Marker] Hash for GenericChoice[T, Marker] where Wrapper[T]: Hash {
    fn hash(local/1/19: GenericChoice[T, Marker]) -> u64 {
        match self/19 {
            ctor(def/1/11::v0) =>
              {
                  let local/1/20 = 0.to_u64() + 14695981039346656037 + 1;
                  h/20
              },
            ctor(def/1/11::v1)(local/1/21) =>
              {
                  let local/1/22 = 0.to_u64() + 14695981039346656037 + 2;
                  let local/1/23 =
                    h/22 * 0.to_u64() + 1099511628211 + Hash::hash(#derive0_field/21);
                  h/23
              },
        }
    }
  }

  fn main() -> () {
      let local/1/24 = Wrapper { value: NoTraits { value: 1 } };
      let local/1/25: Generic[NoTraits, NoTraits] =
        Generic { first: wrapped/24, second: wrapped/24 };
      let local/1/26: Generic[NoTraits, NoTraits] =
        Generic { first: wrapped/24, second: wrapped/24 };
      println(left/25.to_string());
      println(left/25 == right/26);
      println(left/25.hash() == right/26.hash());
      let local/1/27: GenericChoice[NoTraits, NoTraits] = ctor(def/1/11::v0);
      let local/1/28: GenericChoice[NoTraits, NoTraits] = ctor(def/1/11::v1)(wrapped/24);
      println(empty/27.to_string());
      println(value/28.to_string());
      println(empty/27 != value/28);
      println(value/28.hash() == value/28.hash())
  }