impl[T] ToString for Wrapper[T] {
  fn to_string(self/0: Wrapper[T]) -> string {
      "wrapped"
  }
}

impl[T] PartialEq for Wrapper[T] {
  fn eq(self/1: Wrapper[T], other/2: Wrapper[T]) -> bool {
      true
  }
}

impl[T] Eq for Wrapper[T] {}

impl[T] Hash for Wrapper[T] {
  fn hash(self/3: Wrapper[T]) -> u64 {
      7
  }
}

impl[T, Marker] ToString for Generic[T, Marker] where Wrapper[T]: ToString {
  fn to_string(self/4: Generic[T, Marker]) -> string {
      {
          let Generic {
            first: #derive0_field/5: Wrapper[T],
            second: #derive1_field/6: Wrapper[T]
          } =
            (self/4 : Generic[T, Marker]);
          "Generic { " + "first: " +
            (ToString::to_string : (Wrapper[T]) -> string)((#derive0_field/5 : Wrapper[T])) +
            ", " +
            "second: " +
            (ToString::to_string : (Wrapper[T]) -> string)((#derive1_field/6 : Wrapper[T])) +
            " }"
      }
  }
}

impl[T, Marker] PartialEq for Generic[T, Marker] where Wrapper[T]: PartialEq {
  fn eq(self/7: Generic[T, Marker], other/8: Generic[T, Marker]) -> bool {
      true &&
        (PartialEq::eq : (Wrapper[T], Wrapper[T]) -> bool)(
          (self/7 : Generic[T, Marker]).first,
          (other/8 : Generic[T, Marker]).first
        ) &&
        (PartialEq::eq : (Wrapper[T], Wrapper[T]) -> bool)(
          (self/7 : Generic[T, Marker]).second,
          (other/8 : Generic[T, Marker]).second
        )
  }
}

impl[T, Marker] Eq for Generic[T, Marker] where Wrapper[T]: Eq, Wrapper[T]: PartialEq {}

impl[T, Marker] Hash for Generic[T, Marker] where Wrapper[T]: Hash {
  fn hash(self/9: Generic[T, Marker]) -> u64 {
      {
          let h/10: u64 = (isize::to_u64 : (isize) -> u64)(0) + 14695981039346656037;
          let h/11: u64 =
            (h/10 : u64) * (isize::to_u64 : (isize) -> u64)(0) + 1099511628211 +
              (Hash::hash : (Wrapper[T]) -> u64)((self/9 : Generic[T, Marker]).first);
          let h/12: u64 =
            (h/11 : u64) * (isize::to_u64 : (isize) -> u64)(0) + 1099511628211 +
              (Hash::hash : (Wrapper[T]) -> u64)((self/9 : Generic[T, Marker]).second);
          (h/12 : u64)
      }
  }
}

impl[T, Marker] ToString for GenericChoice[T, Marker] where Wrapper[T]: ToString {
  fn to_string(self/13: GenericChoice[T, Marker]) -> string {
      match (self/13 : GenericChoice[T, Marker]) {
          GenericChoice::Empty => "GenericChoice::Empty",
          GenericChoice::Value(#derive0_field/14: Wrapper[T]) =>
            "GenericChoice::Value(" +
              (ToString::to_string : (Wrapper[T]) -> string)((#derive0_field/14 : Wrapper[T])) +
              ")",
      }
  }
}

impl[T, Marker] PartialEq for GenericChoice[T, Marker] where Wrapper[T]: PartialEq {
  fn eq(self/15: GenericChoice[T, Marker], other/16: GenericChoice[T, Marker]) -> bool {
      match ((self/15 : GenericChoice[T, Marker]), (other/16 : GenericChoice[T, Marker])) {
          (GenericChoice::Empty, GenericChoice::Empty) => true,
          (
            GenericChoice::Value(#derive0_left/17: Wrapper[T]),
            GenericChoice::Value(#derive1_right/18: Wrapper[T])
          ) =>
            true &&
              (PartialEq::eq : (Wrapper[T], Wrapper[T]) -> bool)(
                (#derive0_left/17 : Wrapper[T]),
                (#derive1_right/18 : Wrapper[T])
              ),
          _ : (GenericChoice[T, Marker], GenericChoice[T, Marker]) => false,
      }
  }
}

impl[T, Marker] Eq for GenericChoice[T, Marker] where Wrapper[T]: Eq, Wrapper[T]: PartialEq {}

impl[T, Marker] Hash for GenericChoice[T, Marker] where Wrapper[T]: Hash {
  fn hash(self/19: GenericChoice[T, Marker]) -> u64 {
      match (self/19 : GenericChoice[T, Marker]) {
          GenericChoice::Empty =>
            {
                let h/20: u64 = (isize::to_u64 : (isize) -> u64)(0) + 14695981039346656037 + 1;
                (h/20 : u64)
            },
          GenericChoice::Value(#derive0_field/21: Wrapper[T]) =>
            {
                let h/22: u64 = (isize::to_u64 : (isize) -> u64)(0) + 14695981039346656037 + 2;
                let h/23: u64 =
                  (h/22 : u64) * (isize::to_u64 : (isize) -> u64)(0) + 1099511628211 +
                    (Hash::hash : (Wrapper[T]) -> u64)((#derive0_field/21 : Wrapper[T]));
                (h/23 : u64)
            },
      }
  }
}

fn main() -> () {
    let wrapped/24: Wrapper[NoTraits] = Wrapper { value: NoTraits { value: 1 } };
    let left/25: Generic[NoTraits, NoTraits] =
      Generic { first: (wrapped/24 : Wrapper[NoTraits]), second: (wrapped/24 : Wrapper[NoTraits]) };
    let right/26: Generic[NoTraits, NoTraits] =
      Generic { first: (wrapped/24 : Wrapper[NoTraits]), second: (wrapped/24 : Wrapper[NoTraits]) };
    (println : (string) -> ())(
      (ToString::to_string : (Generic[NoTraits, NoTraits]) -> string)(
        (left/25 : Generic[NoTraits, NoTraits])
      )
    );
    (println : (bool) -> ())(
      (left/25 : Generic[NoTraits, NoTraits]) == (right/26 : Generic[NoTraits, NoTraits])
    );
    (println : (bool) -> ())(
      (Hash::hash : (Generic[NoTraits, NoTraits]) -> u64)(
        (left/25 : Generic[NoTraits, NoTraits])
      ) ==
        (Hash::hash : (Generic[NoTraits, NoTraits]) -> u64)(
          (right/26 : Generic[NoTraits, NoTraits])
        )
    );
    let empty/27: GenericChoice[NoTraits, NoTraits] = GenericChoice::Empty;
    let value/28: GenericChoice[NoTraits, NoTraits] =
      GenericChoice::Value((wrapped/24 : Wrapper[NoTraits]));
    (println : (string) -> ())(
      (ToString::to_string : (GenericChoice[NoTraits, NoTraits]) -> string)(
        (empty/27 : GenericChoice[NoTraits, NoTraits])
      )
    );
    (println : (string) -> ())(
      (ToString::to_string : (GenericChoice[NoTraits, NoTraits]) -> string)(
        (value/28 : GenericChoice[NoTraits, NoTraits])
      )
    );
    (println : (bool) -> ())(
      (empty/27 : GenericChoice[NoTraits, NoTraits]) !=
        (value/28 : GenericChoice[NoTraits, NoTraits])
    );
    (println : (bool) -> ())(
      (Hash::hash : (GenericChoice[NoTraits, NoTraits]) -> u64)(
        (value/28 : GenericChoice[NoTraits, NoTraits])
      ) ==
        (Hash::hash : (GenericChoice[NoTraits, NoTraits]) -> u64)(
          (value/28 : GenericChoice[NoTraits, NoTraits])
        )
    )
}