package main
file main.goml
  trait Convert[T] {
    fn convert(Self) -> T;
  }

  struct Token {}

  impl Convert[i32] for Token {
    fn convert(local/main/0: Token) -> i32 {
        7
    }
  }

  impl Convert[string] for Token {
    fn convert(local/main/1: Token) -> string {
        "seven"
    }
  }

  fn convert_to[T, V: Convert[T]](local/main/2: V) -> T {
      value/2.convert()
  }

  trait Marker[T] {
    fn marker(Self) -> string;
  }

  struct Any {}

  impl[T] Marker[T] for Any {
    fn marker(local/main/3: Any) -> string {
        "marked"
    }
  }

  struct Counter {
      current: Ref[i32],
      end: i32,
  }

  impl Counter {
    fn new(local/main/4: i32, local/main/5: i32) -> Self {
        Counter { current: Ref::new(start/4), end: end/5 }
    }
  }

  impl Iterator for Counter {
    type Item = i32;
    fn next(local/main/6: Self) -> Option[i32] {
        let local/main/7 = self/6.current.get();
        if current/7 < self/6.end {
            self/6.current.set(current/7 + 1);
            Option::Some(current/7)
        } else {
            Option::None
        }
    }
  }

  fn main() -> () {
      println(Convert::[i32]::convert(Token {}));
      println(Convert::[string]::convert(Token {}));
      let local/main/8: i32 = source:4:main:4(Token {});
      println(converted/8);
      println(Marker::[i32]::marker(Any {}));
      println(Marker::[string]::marker(Any {}));
      println(Marker::[Vec[i32]]::marker(Any {}));
      let local/main/10 = iter::map(Counter::new(0, 8), |local/main/9: i32| value/9 * 2);
      let local/main/12 = iter::filter(mapped/10, |local/main/11: i32| value/11 > 4);
      let local/main/13 = iter::take(filtered/12, 3);
      for local/main/14 in
        limited/13 {
          println(value/14);
      };
      let local/main/17 =
        iter::fold(
          range(1, 5),
          0,
          |local/main/15: isize, local/main/16: isize| {
              total/15 + value/16
          }
        );
      println(sum/17);
      let local/main/19: Vec[string] =
        iter::collect(iter::map(range(1, 4), |local/main/18: isize| "v" + value/18.to_string()));
      for local/main/20 in
        texts/19 {
          println(text/20);
      }
  }