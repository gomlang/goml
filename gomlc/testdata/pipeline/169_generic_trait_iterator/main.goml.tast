impl Convert[i32] for Token {
  fn convert(self/0: Token) -> i32 {
      7
  }
}

impl Convert[string] for Token {
  fn convert(self/1: Token) -> string {
      "seven"
  }
}

fn convert_to[T, V](value/2: V) -> T where V: Convert[T] {
    (Convert[T]::convert : (V) -> T)((value/2 : V))
}

impl[T] Marker[T] for Any {
  fn marker(self/3: Any) -> string {
      "marked"
  }
}

impl Counter {
  fn new(start/4: i32, end/5: i32) -> Counter {
      Counter { current: (Ref[i32]::new : (i32) -> Ref[i32])((start/4 : i32)), end: (end/5 : i32) }
  }
}

impl Iterator for Counter {
  fn next(self/6: Counter) -> Option[i32] {
      let current/7: i32 = (Ref[i32]::get : (Ref[i32]) -> i32)((self/6 : Counter).current);
      if (current/7 : i32) < (self/6 : Counter).end {
          {
              (Ref[i32]::set : (Ref[i32], i32) -> ())(
                (self/6 : Counter).current,
                (current/7 : i32) + 1
              );
              Option::Some((current/7 : i32))
          }
      } else {
          {
              Option::None
          }
      }
  }
}

fn main() -> () {
    (println : (i32) -> ())((Convert[i32]::convert : (Token) -> i32)(Token {}));
    (println : (string) -> ())((Convert[string]::convert : (Token) -> string)(Token {}));
    let converted/8: i32 = (convert_to : (Token) -> i32)(Token {});
    (println : (i32) -> ())((converted/8 : i32));
    (println : (string) -> ())((Marker[i32]::marker : (Any) -> string)(Any {}));
    (println : (string) -> ())((Marker[string]::marker : (Any) -> string)(Any {}));
    (println : (string) -> ())((Marker[Vec[i32]]::marker : (Any) -> string)(Any {}));
    let mapped/10: FnIterator[i32] =
      (std::iter::map : (Counter, (i32) -> i32) -> FnIterator[i32])(
        (Counter::new : (i32, i32) -> Counter)(0, 8),
        |value/9: i32| => (value/9 : i32) * 2
      );
    let filtered/12: FnIterator[i32] =
      (std::iter::filter : (FnIterator[i32], (i32) -> bool) -> FnIterator[i32])(
        (mapped/10 : FnIterator[i32]),
        |value/11: i32| => (value/11 : i32) > 4
      );
    let limited/13: FnIterator[i32] =
      (std::iter::take : (FnIterator[i32], isize) -> FnIterator[i32])(
        (filtered/12 : FnIterator[i32]),
        3
      );
    for value/14: i32 in
      (limited/13 : FnIterator[i32]) {
        (println : (i32) -> ())((value/14 : i32));
    };
    let sum/17: isize =
      (std::iter::fold : (FnIterator[isize], isize, (isize, isize) -> isize) -> isize)(
        (range : (isize, isize) -> FnIterator[isize])(1, 5),
        0,
        |total/15: isize, value/16: isize| =>
          {
              (total/15 : isize) + (value/16 : isize)
          }
      );
    (println : (isize) -> ())((sum/17 : isize));
    let texts/19: Vec[string] =
      (std::iter::collect : (FnIterator[string]) -> Vec[string])(
        (std::iter::map : (FnIterator[isize], (isize) -> string) -> FnIterator[string])(
          (range : (isize, isize) -> FnIterator[isize])(1, 4),
          |value/18: isize| => "v" + (isize::to_string : (isize) -> string)((value/18 : isize))
        )
      );
    for text/20: string in
      (texts/19 : Vec[string]) {
        (println : (string) -> ())((text/20 : string));
    }
}