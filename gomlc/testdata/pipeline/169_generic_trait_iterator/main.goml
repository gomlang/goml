use std::iter;

trait Convert[T] {
    fn convert(self: Self) -> T;
}

struct Token {}

impl Convert[i32]for Token {
    fn convert(self: Token) -> i32 {
        7
    }
}

impl Convert[string]for Token {
    fn convert(self: Token) -> string {
        "seven"
    }
}

fn convert_to[T, V: Convert[T]](value: V) -> T {
    value.convert()
}

trait Marker[T] {
    fn marker(self: Self) -> string;
}

struct Any {}

impl[T] Marker[T]for Any {
    fn marker(self: Any) -> string {
        "marked"
    }
}

struct Counter {
    current: Ref[i32],
    end: i32,
}

impl Counter {
    fn new(start: i32, end: i32) -> Self {
        Counter { current: Ref::new(start), end }
    }
}

impl Iterator for Counter {
    type Item = i32;

    fn next(self: Self) -> Option[i32] {
        let current = self.current.get();
        if current < self.end {
            self.current.set(current + 1);
            Option::Some(current)
        } else {
            Option::None
        }
    }
}

fn main() -> () {
    println(Convert::[i32]::convert(Token {}));
    println(Convert::[string]::convert(Token {}));
    let converted: i32 = convert_to(Token {});
    println(converted);
    println(Marker::[i32]::marker(Any {}));
    println(Marker::[string]::marker(Any {}));
    println(Marker::[Vec[i32]]::marker(Any {}));
    let mapped = iter::map(Counter::new(0, 8), |value: i32| value * 2);
    let filtered = iter::filter(mapped, |value: i32| value > 4);
    let limited = iter::take(filtered, 3);
    for value in limited {
        println(value);
    }
    let sum = iter::fold(
        range(1, 5),
        0,
        |total: isize, value: isize| {
            total + value
        },
    );
    println(sum);
    let texts: Vec[string] = iter::collect(
        iter::map(range(1, 4), |value: isize| "v" + value.to_string()),
    );
    for text in texts {
        println(text);
    }
}
