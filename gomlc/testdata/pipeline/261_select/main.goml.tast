fn mark_channel(log/0: Ref[string], mark/1: string, channel/2: Channel[isize]) -> Channel[isize] {
    (Ref[string]::set : (Ref[string], string) -> ())(
      (log/0 : Ref[string]),
      (Ref[string]::get : (Ref[string]) -> string)((log/0 : Ref[string])) + (mark/1 : string)
    );
    (channel/2 : Channel[isize])
}

fn mark_value(log/3: Ref[string], mark/4: string, value/5: isize) -> isize {
    (Ref[string]::set : (Ref[string], string) -> ())(
      (log/3 : Ref[string]),
      (Ref[string]::get : (Ref[string]) -> string)((log/3 : Ref[string])) + (mark/4 : string)
    );
    (value/5 : isize)
}

fn main() -> () {
    let received/6: Channel[isize] = (Channel[isize]::new : (isize) -> Channel[isize])(1);
    (Channel[isize]::send : (Channel[isize], isize) -> ())((received/6 : Channel[isize]), 7);
    let first/9: isize =
      select {
          recv((received/6 : Channel[isize])) as value/7 =>
            {
                let read/8: () -> isize =
                  || =>
                    (Option[isize]::unwrap_or : (Option[isize], isize) -> isize)(
                      (value/7 : Option[isize]),
                      -1
                    );
                (read/8 : () -> isize)()
            },
          default => 0,
      };
    (println : (isize) -> ())((first/9 : isize));
    let sent/10: Channel[string] = (Channel[string]::new : (isize) -> Channel[string])(1);
    let branch/11: string =
      select {
          send((sent/10 : Channel[string]), "ready") => "sent",
          default => "blocked",
      };
    (println : (string) -> ())((branch/11 : string));
    (println : (string) -> ())(
      (Option[string]::unwrap_or : (Option[string], string) -> string)(
        (Channel[string]::recv : (Channel[string]) -> Option[string])((sent/10 : Channel[string])),
        "missing"
      )
    );
    let empty/12: Channel[isize] = (Channel[isize]::new : (isize) -> Channel[isize])(0);
    let fallback/14: isize =
      select {
          recv((empty/12 : Channel[isize])) as _/13 => -1,
          default => 42,
      };
    (println : (isize) -> ())((fallback/14 : isize));
    let log/15: Ref[string] = (Ref[string]::new : (string) -> Ref[string])("");
    let left/16: Channel[isize] = (Channel[isize]::new : (isize) -> Channel[isize])(0);
    let right/17: Channel[isize] = (Channel[isize]::new : (isize) -> Channel[isize])(0);
    select {
        send((mark_channel : (Ref[string], string, Channel[isize]) -> Channel[isize])(
          (log/15 : Ref[string]),
          "a",
          (left/16 : Channel[isize])
        ), (mark_value : (Ref[string], string, isize) -> isize)((log/15 : Ref[string]), "1", 1)) =>
          (),
        send((mark_channel : (Ref[string], string, Channel[isize]) -> Channel[isize])(
          (log/15 : Ref[string]),
          "b",
          (right/17 : Channel[isize])
        ), (mark_value : (Ref[string], string, isize) -> isize)((log/15 : Ref[string]), "2", 2)) =>
          (),
        default => (),
    };
    (println : (string) -> ())(
      (Ref[string]::get : (Ref[string]) -> string)((log/15 : Ref[string]))
    );
    (Channel[isize]::close : (Channel[isize]) -> ())((received/6 : Channel[isize]));
    let closed/19: string =
      select {
          recv((received/6 : Channel[isize])) as value/18 =>
            match (value/18 : Option[isize]) {
                Option::Some(_ : isize) => "open",
                Option::None => "closed",
            },
      };
    (println : (string) -> ())((closed/19 : string))
}