package main
file main.goml
  fn mark_channel(local/1/0: Ref[string], local/1/1: string, local/1/2: Channel[isize]) -> Channel[
    isize
  ] {
      log/0.set(log/0.get() + mark/1);
      channel/2
  }

  fn mark_value(local/1/3: Ref[string], local/1/4: string, local/1/5: isize) -> isize {
      log/3.set(log/3.get() + mark/4);
      value/5
  }

  fn main() -> () {
      let local/1/6 = Channel[isize]::new(1);
      received/6.send(7);
      let local/1/9 =
        select {
            recv(received/6) as local/1/7 =>
              {
                  let local/1/8 = || value/7.unwrap_or(-1);
                  read/8()
