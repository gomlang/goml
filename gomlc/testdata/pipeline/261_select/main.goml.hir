      println(fallback/14);
      let local/1/15 = Ref::new("");
      let local/1/16 = Channel[isize]::new(0);
      let local/1/17 = Channel[isize]::new(0);
      select {
          send(def/1/0(log/15, "a", left/16), def/1/1(log/15, "1", 1)) => (),
          send(def/1/0(log/15, "b", right/17), def/1/1(log/15, "2", 2)) => (),
          default => (),
