package main
file main.goml
  fn mark_channel(
    local/main/0: Ref[string],
    local/main/1: string,
    local/main/2: Channel[isize]
  ) -> Channel[isize] {
      log/0.set(log/0.get() + mark/1);
      channel/2
  }

  fn mark_value(local/main/3: Ref[string], local/main/4: string, local/main/5: isize) -> isize {
      log/3.set(log/3.get() + mark/4);
      value/5
  }

  fn main() -> () {
      let local/main/6 = Channel::[isize]::new(1);
      received/6.send(7);
      let local/main/9 =
        select {
            recv(received/6) as local/main/7 =>
              {
                  let local/main/8 = || value/7.unwrap_or(-1);
                  read/8()
              },
            default => 0,
        };
      println(first/9);
      let local/main/10 = Channel::[string]::new(1);
      let local/main/11 =
        select {
            send(sent/10, "ready") => "sent",
            default => "blocked",
        };
      println(branch/11);
      println(sent/10.recv().unwrap_or("missing"));
      let local/main/12 = Channel::[isize]::new(0);
      let local/main/14 =
        select {
            recv(empty/12) as local/main/13 => -1,
            default => 42,
        };
      println(fallback/14);
      let local/main/15 = Ref::new("");
      let local/main/16 = Channel::[isize]::new(0);
      let local/main/17 = Channel::[isize]::new(0);
      select {
          send(source:4:main:0(log/15, "a", left/16), source:4:main:1(log/15, "1", 1)) => (),
          send(source:4:main:0(log/15, "b", right/17), source:4:main:1(log/15, "2", 2)) => (),
          default => (),
      };
      println(log/15.get());
      received/6.close();
      let local/main/19 =
        select {
            recv(received/6) as local/main/18 =>
              match value/18 {
                  Some(_) => "open",
                  None => "closed",
              },
        };
      println(closed/19)
  }