const ANSWER: isize = 120;

fn factorial(value/0: isize) -> isize {
    if (value/0 : isize) < 2 {
        {
            1
        }
    } else {
        {
            (value/0 : isize) * (factorial : (isize) -> isize)((value/0 : isize) - 1)
        }
    }
}

fn accumulate(limit/1: isize) -> isize {
    let mut index/2: isize = 0;
    let mut total/3: isize = 0;
    while (index/2 : isize) < (limit/1 : isize) {
        {
            (total/3 : isize) = (total/3 : isize) + (index/2 : isize);
            (index/2 : isize) = (index/2 : isize) + 1;
        }
    };
    (total/3 : isize)
}

fn make_pair(value/4: isize) -> Pair {
    Pair { left: (value/4 : isize), right: (value/4 : isize) + 1 }
}

fn choose(value/5: isize) -> Choice {
    if (value/5 : isize) > 0 {
        {
            Choice::Value((value/5 : isize))
        }
    } else {
        {
            Choice::Empty
        }
    }
}

fn nonnegative(value/6: isize) -> isize {
    if (value/6 : isize) < 0 {
        {
            (@intrinsic(compile_error) : (string) -> never)("value must be non-negative")
        }
    } else {
        {
            (value/6 : isize)
        }
    }
}

fn shadow(value/7: isize) -> isize {
    let base/8: isize = (value/7 : isize);
    let nested/10: isize =
      {
          let base/9: isize = (base/8 : isize) + 1;
          (base/9 : isize) * 2
      };
    (base/9 : isize) + (nested/10 : isize)
}

fn widen_negative(value/11: i8) -> u64 {
    (i8::to_u64 : (i8) -> u64)((value/11 : i8))
}

fn guarded_match() -> isize {
    let mut value/12: isize = 0;
    match 0 {
        _ : isize if {
            (value/12 : isize) = 1;
            false
        } =>
          99,
        _ : isize => (value/12 : isize),
    }
}

fn main() -> () {
    let values/13: [isize; 3] = [6, 10, 4];
    let pair/14: Pair = Pair { left: 7, right: 8 };
    let choice/15: Choice = Choice::Value(9);
    (println : (isize) -> ())((ANSWER : isize));
    (println : (isize) -> ())((values/13 : [isize; 3])[0]);
    (println : (isize) -> ())((values/13 : [isize; 3])[1]);
    (println : (isize) -> ())((values/13 : [isize; 3])[2]);
    (println : (isize) -> ())((pair/14 : Pair).left + (pair/14 : Pair).right);
    match (choice/15 : Choice) {
        Choice::Value(value/16: isize) => (println : (isize) -> ())((value/16 : isize)),
        Choice::Empty => (println : (isize) -> ())(0),
    };
    (println : (bool) -> ())((factorial : (isize) -> isize)(5) == (ANSWER : isize));
    let shadowed/17: isize = 12;
    (println : (isize) -> ())((shadowed/17 : isize));
    (println : (bool) -> ())((shadow : (isize) -> isize)(3) == (shadowed/17 : isize));
    let widened/18: u64 = 18446744073709551615;
    (println : (bool) -> ())((widened/18 : u64) == (widen_negative : (i8) -> u64)(-1));
    let folded_guard/19: isize = 1;
    (println : (isize) -> ())((guarded_match : () -> isize)());
    (println : (isize) -> ())((folded_guard/19 : isize));
    (println : (isize) -> ())((factorial : (isize) -> isize)(4))
}