package main
file main.goml
  struct Pair {
      left: isize,
      right: isize,
  }

  enum Choice {
      Value(isize),
      Empty
  }

  #[comptime]
  fn factorial(local/main/0: isize) -> isize {
      if value/0 < 2 {
          1
      } else {
          value/0 * source:4:main:2(value/0 - 1)
      }
  }

  #[comptime]
  fn accumulate(local/main/1: isize) -> isize {
      let mut local/main/2 = 0;
      let mut local/main/3 = 0;
      while index/2 < limit/1 {
          {
              total/3 = total/3 + index/2;
              index/2 = index/2 + 1;
          }
      };
      total/3
  }

  #[comptime]
  fn make_pair(local/main/4: isize) -> Pair {
      Pair { left: value/4, right: value/4 + 1 }
  }

  #[comptime]
  fn choose(local/main/5: isize) -> Choice {
      if value/5 > 0 {
          ctor(source:4:main:1::v0)(value/5)
      } else {
          ctor(source:4:main:1::v1)
      }
  }

  #[comptime]
  fn nonnegative(local/main/6: isize) -> isize {
      if value/6 < 0 {
          compile_error("value must be non-negative")
      } else {
          value/6
      }
  }

  #[comptime]
  fn shadow(local/main/7: isize) -> isize {
      let local/main/8 = value/7;
      let local/main/10 =
        {
            let local/main/9 = base/8 + 1;
            base/9 * 2
        };
      base/8 + nested/10
  }

  #[comptime]
  fn widen_negative(local/main/11: i8) -> u64 {
      value/11.to_u64()
  }

  #[comptime]
  fn guarded_match() -> isize {
      let mut local/main/12 = 0;
      match 0 {
          _ if {
              value/12 = 1;
              false
          } =>
            99,
          _ => value/12,
      }
  }

  const ANSWER: isize = source:4:main:2(5);

