      println(values/13[2]);
      println(pair/14.left + pair/14.right);
      match choice/15 {
          ctor(source:4:main:1::v0)(local/main/16) => println(value/16),
          ctor(source:4:main:1::v1) => println(0),
      };
      println(source:4:main:2(5) == source:4:main:10);
      let local/main/17 =
