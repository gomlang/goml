package main;
trait Show {
  fn show(self: Self) -> string;
}

struct Wrap {
    value: string,
}

impl Show for i32 {
  fn show(self: i32) -> string {
      self.to_string()
  }
}

impl Show for Wrap {
  fn show(self: Wrap) -> string {
      self.value
  }
}

fn main() -> () {
    let values: Vec[dyn Show] = Vec::new();
    let value: i32 = 10;
    values.push(value as dyn Show);
    values.push(Wrap { value: "ok" } as dyn Show);
    println(Show::show(values[0]));
    println(Show::show(values[1]))
}

