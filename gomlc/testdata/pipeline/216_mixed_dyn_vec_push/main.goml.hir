package main
file main.goml
  trait Show {
    fn show(Self) -> string;
  }

  struct Wrap {
      value: string,
  }

  impl Show for i32 {
    fn show(local/1/0: i32) -> string {
        self/0.to_string()
    }
  }

  impl Show for Wrap {
    fn show(local/1/1: Wrap) -> string {
        self/1.value
    }
  }

  fn main() -> () {
      let local/1/2: Vec[dyn Show] = Vec::new();
      let local/1/3: i32 = 10;
      values/2.push(value/3 as dyn Show);
      values/2.push(Wrap { value: "ok" } as dyn Show);
      println(Show::show(values/2[0]));
      println(Show::show(values/2[1]))
  }