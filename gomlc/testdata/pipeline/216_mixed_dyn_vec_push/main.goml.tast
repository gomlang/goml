impl Show for i32 {
  fn show(self/0: i32) -> string {
      (i32::to_string : (i32) -> string)((self/0 : i32))
  }
}

impl Show for Wrap {
  fn show(self/1: Wrap) -> string {
      (self/1 : Wrap).value
  }
}

fn main() -> () {
    let values/2: Vec[dyn Show] = (Vec[dyn Show]::new : () -> Vec[dyn Show])();
    let value/3: i32 = 10;
    (Vec[dyn Show]::push : (Vec[dyn Show], dyn Show) -> ())(
      (values/2 : Vec[dyn Show]),
      to_dyn[Show]{i32}((value/3 : i32))
    );
    (Vec[dyn Show]::push : (Vec[dyn Show], dyn Show) -> ())(
      (values/2 : Vec[dyn Show]),
      to_dyn[Show]{Wrap}(Wrap { value: "ok" })
    );
    (println : (string) -> ())(
      (dyn Show::show : (dyn Show) -> string)((values/2 : Vec[dyn Show])[0])
    );
    (println : (string) -> ())(
      (dyn Show::show : (dyn Show) -> string)((values/2 : Vec[dyn Show])[1])
    )
}