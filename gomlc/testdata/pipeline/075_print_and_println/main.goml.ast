package main;
struct S {
    value: i32,
}

impl ToString for S {
  fn to_string(self: S) -> string {
      "S(" + self.value.to_string() + ")"
  }
}

fn main() -> () {
    println(1);
    println(true);
    println("hi");
    println(());
    println(ToString::to_string(2));
    println(2.to_string());
    let s = S { value: 9 };
    println(s);
    let d: dyn ToString = s as dyn ToString;
    println(d);
    let r = Ref::new(5);
    println(r);
    print("no-newline");
    println("!");
}

