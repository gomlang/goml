impl ToString for S {
  fn to_string(self/0: S) -> string {
      "S(" + (i32::to_string : (i32) -> string)((self/0 : S).value) + ")"
  }
}

fn main() -> () {
    (println : (isize) -> ())(1);
    (println : (bool) -> ())(true);
    (println : (string) -> ())("hi");
    (println : (()) -> ())(());
    (println : (string) -> ())((ToString::to_string : (isize) -> string)(2));
    (println : (string) -> ())((isize::to_string : (isize) -> string)(2));
    let s/1: S = S { value: 9 };
    (println : (S) -> ())((s/1 : S));
    let d/2: dyn ToString = to_dyn[ToString]{S}((s/1 : S));
    (println : (dyn ToString) -> ())((d/2 : dyn ToString));
    let r/3: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(5);
    (println : (Ref[isize]) -> ())((r/3 : Ref[isize]));
    (print : (string) -> ())("no-newline");
    (println : (string) -> ())("!");
}