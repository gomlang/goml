package main;
fn main() -> () {
    let to_text: (i32) -> string = int32_to_string;
    println(to_text(7));
    let get: (Vec[i32], isize) -> i32 = vec_get;
    let push: (Vec[i32], i32) -> () = vec_push;
    let values: Vec[i32] = Vec::new();
    push(values, 11);
    push(values, 22);
    println(get(values, 1));
    let make_slice: (Vec[i32], isize, isize) -> Slice[i32] = slice;
    let slice_get_value: (Slice[i32], isize) -> i32 = slice_get;
    let view = make_slice(values, 0, 2);
    println(slice_get_value(view, 0));
    let alias = values;
    alias.push(33);
    println(values.len());
    values.set(0, 44);
    println(alias.get(0));
    let copied = values.pushed(55);
    println(values.len());
    println(copied.len());
}

