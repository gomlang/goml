fn trait_impl#ToString#string#to_string(self/0: string) -> string {
  self/0
}

fn println[T](value/0: T) -> () {
  @runtime(core.string_println)(trait_call[ToString::to_string](value/0))
}

fn flip[T](x/0: Light[T]) -> Light[T] {
  match x/0 {
    Light::Red => {
      Light::Green
    },
    Light::Green => {
      Light::Red
    },
  }
}

fn show_int(x/0: Light[i32]) -> string {
  match x/0 {
    Light::Red => {
      "ri"
    },
    Light::Green => {
      "gi"
    },
  }
}

fn show_string(x/0: Light[string]) -> string {
  match x/0 {
    Light::Red => {
      "rs"
    },
    Light::Green => {
      "gs"
    },
  }
}

fn main() -> () {
  let _wild0 = println(show_int(flip(Light::Red))) in
  let _wild1 = println(show_string(flip(Light::Green))) in
}