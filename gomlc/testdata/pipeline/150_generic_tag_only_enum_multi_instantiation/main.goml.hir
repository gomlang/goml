package main
file main.goml
  enum Light[T] {
      Red,
      Green
  }

  fn flip[T](local/main/0: Light[T]) -> Light[T] {
      match x/0 {
          ctor(source:4:main:0::v0) => ctor(source:4:main:0::v1),
          ctor(source:4:main:0::v1) => ctor(source:4:main:0::v0),
      }
  }

  fn show_int(local/main/1: Light[i32]) -> string {
      match x/1 {
          ctor(source:4:main:0::v0) => "ri",
          ctor(source:4:main:0::v1) => "gi",
      }
  }

  fn show_string(local/main/2: Light[string]) -> string {
      match x/2 {
          ctor(source:4:main:0::v0) => "rs",
          ctor(source:4:main:0::v1) => "gs",
      }
  }

  fn main() -> () {
      println(source:4:main:2(source:4:main:1(ctor(source:4:main:0::v0))));
      println(source:4:main:3(source:4:main:1(ctor(source:4:main:0::v1))));
  }