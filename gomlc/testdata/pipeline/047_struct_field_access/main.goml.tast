fn make_point(base/0: i32) -> Point {
    Point { x: (base/0 : i32), y: (base/0 : i32) + 1 }
}

fn sum_point(p/1: Point) -> i32 {
    (p/1 : Point).x + (p/1 : Point).y
}

fn main() -> i32 {
    let p/2: Point = (make_point : (i32) -> Point)(5);
    let shifted/3: Point = Point { x: (p/2 : Point).x + 1, y: (p/2 : Point).y - 2 };
    (shifted/3 : Point).x + (sum_point : (Point) -> i32)((shifted/3 : Point))
}