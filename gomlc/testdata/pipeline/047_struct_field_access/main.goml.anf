fn make_point(base/0: i32) -> Point {
  let t0 = (base/0 + 1) in
  let t1 = Point { x: base/0, y: t0 } in
  t1
}

fn sum_point(p/0: Point) -> i32 {
  let t0 = Point.x(p/0) in
  let t1 = Point.y(p/0) in
  let t2 = (t0 + t1) in
  t2
}

fn main() -> i32 {
  join inline_cont0(p/0: Point) -> i32 {
    let t0 = Point.x(p/0) in
    let t1 = (t0 + 1) in
    let t2 = Point.y(p/0) in
    let t3 = (t2 - 2) in
    join inline_cont1(t4: i32) -> i32 {
      let t5 = (t1 + t4) in
      t5
    } in
    let inline0 = (t1 + t3) in
    jump inline_cont1(inline0)
  } in
  let inline1 = 5 in
  let inline2 = (inline1 + 1) in
  let inline3 = Point { x: inline1, y: inline2 } in
  jump inline_cont0(inline3)
}