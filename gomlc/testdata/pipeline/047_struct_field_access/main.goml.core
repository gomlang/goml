fn make_point(base/0: i32) -> Point {
  Point { x: base/0, y: (base/0 + 1) }
}

fn sum_point(p/0: Point) -> i32 {
  (Point.x(p/0) + Point.y(p/0))
}

fn main() -> i32 {
  let p/0 = make_point(5) in
  let shifted/0 = Point { x: (Point.x(p/0) + 1), y: (Point.y(p/0) - 2) } in
  (Point.x(shifted/0) + sum_point(shifted/0))
}