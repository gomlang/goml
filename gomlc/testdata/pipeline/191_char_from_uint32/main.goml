fn show_scalar(value: u32) -> () {
    match char_from_u32(value) {
        Option::Some(result) => println(result.to_u32()),
        Option::None => println("none"),
    }
}

fn main() -> () {
    show_scalar(0);
    show_scalar(65);
    show_scalar(55295);
    show_scalar(55296);
    show_scalar(57343);
    show_scalar(57344);
    show_scalar(1114111);
    show_scalar(1114112);
    match char_from_u32(128512) {
        Option::Some(result) => println(result.to_string()),
        Option::None => println("none"),
    }
}
