package main
file main.goml
  fn show_scalar(local/1/0: u32) -> () {
      match char_from_u32(value/0) {
          Option::Some(local/1/1) => println(result/1.to_u32()),
          Option::None => println("none"),
      }
  }

  fn main() -> () {
      def/1/0(0);
      def/1/0(65);
      def/1/0(55295);
      def/1/0(55296);
      def/1/0(57343);
      def/1/0(57344);
      def/1/0(1114111);
      def/1/0(1114112);
      match char_from_u32(128512) {
          Option::Some(local/1/2) => println(result/2.to_string()),
          Option::None => println("none"),
      }
  }