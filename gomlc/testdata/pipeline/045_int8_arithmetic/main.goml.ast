package main;
fn a_value() -> i8 {
    90
}

fn b_value() -> i8 {
    -20
}

fn c_value() -> i8 {
    3
}

fn show_int8(label: string, value: i8) {
    let _ = println(label + value.to_string());
}

fn show_bool(label: string, value: bool) {
    let _ = println(label + value.to_string());
}

fn main() {
    let a = a_value();
    let b = b_value();
    let c = c_value();
    let sum = a + b;
    let diff = a - c;
    let prod = b * c;
    let quot = a / c;
    let neg = -b;
    let less = b < a;
    let _ = show_int8("a=", a);
    let _ = show_int8("b=", b);
    let _ = show_int8("c=", c);
    let _ = show_int8("sum=", sum);
    let _ = show_int8("diff=", diff);
    let _ = show_int8("prod=", prod);
    let _ = show_int8("quot=", quot);
    let _ = show_int8("neg=", neg);
    let _ = show_bool("b<a=", less);
}

