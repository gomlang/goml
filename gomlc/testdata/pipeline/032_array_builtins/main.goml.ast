package main;
fn update_array(arr: [i32; 3]) -> [i32; 3] {
    let mut arr = arr;
    arr[1] = 42;
    arr
}

fn read_array(arr: [i32; 3]) -> i32 {
    arr[1]
}

fn main() {
    let arr = [1, 2, 3];
    let updated = update_array(arr);
    let value = read_array(updated);
    let _ = println(value.to_string());
}

