fn update_array(arr/0: [i32; 3]) -> [i32; 3] {
    let mut arr/1: [i32; 3] = (arr/0 : [i32; 3]);
    (arr/1 : [i32; 3])[1] = 42;
    (arr/1 : [i32; 3])
}

fn read_array(arr/2: [i32; 3]) -> i32 {
    (arr/2 : [i32; 3])[1]
}

fn main() -> () {
    let arr/3: [i32; 3] = [1, 2, 3];
    let updated/4: [i32; 3] = (update_array : ([i32; 3]) -> [i32; 3])((arr/3 : [i32; 3]));
    let value/5: i32 = (read_array : ([i32; 3]) -> i32)((updated/4 : [i32; 3]));
    let _ : () = (println : (string) -> ())((i32::to_string : (i32) -> string)((value/5 : i32)));
}