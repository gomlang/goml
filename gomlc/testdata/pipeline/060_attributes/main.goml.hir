package main
file main.goml
  #[derive(ToString)]
  struct Point {
      x: i32,
      y: i32,
  }

  impl ToString for Point {
    fn to_string(local/main/0: Point) -> string {
        {
            let Point { x: local/main/1, y: local/main/2 } = self/0;
            "Point { " + "x: " + ToString::to_string(#derive0_field/1) + ", " + "y: " +
              ToString::to_string(#derive1_field/2) +
              " }"
        }
    }
  }

  #[derive(ToString)]
  enum Message {
      Quit,
      Move(i32, i32),
      Write(string)
  }

  impl ToString for Message {
    fn to_string(local/main/3: Message) -> string {
        match self/3 {
            ctor(source:4:main:2::v0) => "Message::Quit",
            ctor(source:4:main:2::v1)(local/main/4, local/main/5) =>
              "Message::Move(" + ToString::to_string(#derive0_field/4) + ", " +
                ToString::to_string(#derive1_field/5) +
                ")",
            ctor(source:4:main:2::v2)(local/main/6) => "Message::Write(" + #derive2_field/6 + ")",
        }
    }
  }

  fn main() -> () {
      let local/main/7 = Point { x: 4, y: 7 };
      let local/main/8 = point/7.to_string();
      let local/main/9 = ctor(source:4:main:2::v1)(1, 2).to_string();
      let local/main/10 = ctor(source:4:main:2::v2)("done").to_string();
      let local/main/11 = ctor(source:4:main:2::v0).to_string();
      println(summary/8);
      println(mv/9);
      println(text/10);
      println(exit/11);
  }