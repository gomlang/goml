package main;
#[derive(ToString)]
struct Point {
    x: i32,
    y: i32,
}

impl ToString for Point {
  fn to_string(self: Point) -> string {
      {
          let Point { x: #derive0_field, y: #derive1_field } = self;
          "Point { " + "x: " + ToString::to_string(#derive0_field) + ", " + "y: " +
            ToString::to_string(#derive1_field) +
            " }"
      }
  }
}

#[derive(ToString)]
enum Message {
    Quit,
    Move(i32, i32),
    Write(string)
}

impl ToString for Message {
  fn to_string(self: Message) -> string {
      match self {
          Message::Quit => "Message::Quit",
          Message::Move(#derive0_field, #derive1_field) =>
            "Message::Move(" + ToString::to_string(#derive0_field) + ", " +
              ToString::to_string(#derive1_field) +
              ")",
          Message::Write(#derive2_field) => "Message::Write(" + #derive2_field + ")",
      }
  }
}

fn main() -> () {
    let point = Point { x: 4, y: 7 };
    let summary = point.to_string();
    let mv = Message::Move(1, 2).to_string();
    let text = Message::Write("done").to_string();
    let exit = Message::Quit.to_string();
    println(summary);
    println(mv);
    println(text);
    println(exit);
}

