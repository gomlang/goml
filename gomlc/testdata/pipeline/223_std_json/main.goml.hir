package main
file main.goml
  fn main() -> () {
      let local/main/2 =
        match json::parse("{\"name\":\"goml\",\"version\":1,\"stable\":true}") {
            Result::Ok(local/main/0) => value/0,
            Result::Err(local/main/1) =>
              {
                  println(error/1);
                  return
              },
        };
      match json::field(value/2, "name") {
          Option::Some(local/main/3) =>
            match json::as_string(field/3) {
                Option::Some(local/main/4) => println(name/4),
                Option::None => println("invalid name"),
            },
          Option::None => println("missing name"),
      };
      match json::field(value/2, "version") {
          Option::Some(local/main/5) =>
            match json::as_int(field/5) {
                Option::Some(local/main/6) => println(version/6),
                Option::None => println("invalid version"),
            },
          Option::None => println("missing version"),
      };
      match json::field(value/2, "stable") {
          Option::Some(local/main/7) =>
            match json::as_bool(field/7) {
                Option::Some(local/main/8) => println(stable/8),
                Option::None => println("invalid stable"),
            },
          Option::None => println("missing stable"),
      };
      println(json::encode(value/2))
  }