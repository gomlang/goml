impl Show for Boxed[i32] {
  fn show(self/0: Boxed[i32]) -> string {
      match (self/0 : Boxed[i32]) {
          Boxed::One(value/1: i32) => (i32::to_string : (i32) -> string)((value/1 : i32)),
      }
  }
}

fn make_boxed[T](value/2: T) -> Boxed[T] {
    Boxed::One((value/2 : T))
}

fn render(value/3: dyn Show) -> string {
    (dyn Show::show : (dyn Show) -> string)((value/3 : dyn Show))
}

fn main() -> () {
    let value/4: i32 = 42;
    (println : (string) -> ())(
      (render : (dyn Show) -> string)(
        to_dyn[Show]{Boxed[i32]}((make_boxed : (i32) -> Boxed[i32])((value/4 : i32)))
      )
    )
}