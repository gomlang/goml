package main;
trait Show {
  fn show(self: Self) -> string;
}

enum Boxed[T] {
    One(T)
}

impl Show for Boxed[i32] {
  fn show(self: Boxed[i32]) -> string {
      match self {
          Boxed::One(value) => value.to_string(),
      }
  }
}

fn make_boxed[T](value: T) -> Boxed[T] {
    Boxed::One(value)
}

fn render(value: dyn Show) -> string {
    Show::show(value)
}

fn main() -> () {
    let value: i32 = 42;
    println(render(make_boxed(value) as dyn Show))
}

