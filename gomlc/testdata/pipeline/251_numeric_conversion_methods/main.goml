const NEGATIVE_ONE: i16 = -1;

const WRAPPED: u8 = NEGATIVE_ONE.to_u8();

const LETTER: u32 = 'A'.to_u32();

#[comptime]
fn narrow_at_compile_time(value: i16) -> u8 {
    value.to_u8()
}

fn exercise_int(value: isize) -> () {
    let _: i8 = value.to_i8();
    let _: i16 = value.to_i16();
    let _: i32 = value.to_i32();
    let _: i64 = value.to_i64();
    let _: usize = value.to_usize();
    let _: u8 = value.to_u8();
    let _: u16 = value.to_u16();
    let _: u32 = value.to_u32();
    let _: u64 = value.to_u64();
}

fn exercise_int8(value: i8) -> () {
    let _: isize = value.to_isize();
    let _: i16 = value.to_i16();
    let _: i32 = value.to_i32();
    let _: i64 = value.to_i64();
    let _: usize = value.to_usize();
    let _: u8 = value.to_u8();
    let _: u16 = value.to_u16();
    let _: u32 = value.to_u32();
    let _: u64 = value.to_u64();
}

