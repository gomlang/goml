    let _: usize = value.to_usize();
    let _: u8 = value.to_u8();
    let _: u16 = value.to_u16();
    let _: u32 = value.to_u32();
}

fn main() -> () {
    exercise_int(1);
    exercise_int8(1);
    exercise_int16(1);
    exercise_int32(1);
    exercise_int64(1);
    exercise_uint(1);
    exercise_uint8(1);
    exercise_uint16(1);
    exercise_uint32(1);
    exercise_uint64(1);
    let value: i16 = 511;
    println(value.to_u8());
    println(WRAPPED);
    println(LETTER);
    println(narrow_at_compile_time(-1));
    let octet: byte = b'\xFF';
    println(octet.to_i16())
}
