package main;
trait Display {
  fn show(self: Self) -> string;
}

impl Display for i32 {
  fn show(self: i32) -> string {
      self.to_string()
  }
}

struct Holder[T] {
    value: T,
}

fn render(x: dyn Display) -> string {
    Display::show(x)
}

fn main() -> () {
    let value: i32 = 42;
    let holder: Holder[dyn Display] = Holder { value: value as dyn Display };
    println(render(holder.value));
}

