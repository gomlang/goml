fn combine(left: usize, right: usize) -> usize {
    (left + right) * 2
}

fn classify(value: usize) -> string {
    match value {
        0 => "zero",
        42 => "answer",
        _ => "other",
    }
}

fn main() -> () {
    let left: usize = 19;
    let right = 2.to_usize();
    let result = combine(left, right);
    println(result);
    println(result.to_string());
    println(classify(result));
    println(result > left);
    println((result & 15).to_u64());
    let values: HashMap[usize, string] = HashMap::new();
    values.set(result, "stored");
    match values.get(42) {
        Option::Some(value) => println(value),
        Option::None => println("missing"),
    }
}
