enum Option[T] {
    Some(T),
    None,
}

fn maybe_value(flag: bool) -> Option[i32] {
    if flag {
        Option::Some(41)
    } else {
        Option::None
    }
}

fn compute(flag: bool) -> Option[i32] {
    let value = maybe_value(flag)?;
    Option::Some(value + 1)
}

fn show(value: Option[i32]) -> string {
    match value {
        Option::Some(value) => value.to_string(),
        Option::None => "none",
    }
}

fn main() -> () {
    println(show(compute(true)));
    println(show(compute(false)))
}
