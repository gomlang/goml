package main;
use std::fs;
use std::io;

fn show_read[E: ToString](res: Result[string, E]) -> string {
    match res {
        Result::Ok(value) => value,
        Result::Err(err) => "err " + err.to_string(),
    }
}

fn show_dir[E: ToString](res: Result[Vec[string], E]) -> string {
    match res {
        Result::Ok(names) => names.len() > 0.to_string(),
        Result::Err(err) => "err " + err.to_string(),
    }
}

fn main() -> () {
    let _ = fs::write_file_structured("goml-std-test.txt", "std-ok");
    io::println(show_read(fs::read_file_structured("goml-std-test.txt")));
    io::println(fs::exists("goml-std-test.txt").to_string());
    io::println(show_dir(fs::read_dir(".")));
}

