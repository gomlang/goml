enum E { A, B, C }

fn same(a: E, b: E) -> bool {
    match a {
        A => match b { A => true, _ => false },
        B => match b { B => true, _ => false },
        C => match b { C => true, _ => false },
    }
}

fn same_reversed(a: E, b: E) -> bool {
    match b {
        A => match a { A => true, _ => false },
        B => match a { B => true, _ => false },
        C => match a { C => true, _ => false },
    }
}

fn main() -> () {
    let values = Vec::from_array([E::A, E::B, E::C]);
    let functions = Vec::from_array([same, same_reversed]);
    for a in values {
        for b in values {
            for f in functions {
                println(f(a, b));
            }
        }
    }
}
