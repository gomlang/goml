fn same(a/0: E, b/1: E) -> bool {
    match (a/0 : E) {
        E::A =>
          match (b/1 : E) {
              E::A => true,
              _ : E => false,
          },
        E::B =>
          match (b/1 : E) {
              E::B => true,
              _ : E => false,
          },
        E::C =>
          match (b/1 : E) {
              E::C => true,
              _ : E => false,
          },
    }
}

fn same_reversed(a/2: E, b/3: E) -> bool {
    match (b/3 : E) {
        E::A =>
          match (a/2 : E) {
              E::A => true,
              _ : E => false,
          },
        E::B =>
          match (a/2 : E) {
              E::B => true,
              _ : E => false,
          },
        E::C =>
          match (a/2 : E) {
              E::C => true,
              _ : E => false,
          },
    }
}

fn main() -> () {
    let values/4: Vec[E] = (@intrinsic(vec.from_array) : ([E; 3]) -> Vec[E])([E::A, E::B, E::C]);
    let functions/5: Vec[(E, E) -> bool] =
      (@intrinsic(vec.from_array) : ([(E, E) -> bool; 2]) -> Vec[(E, E) -> bool])(
        [(same : (E, E) -> bool), (same_reversed : (E, E) -> bool)]
      );
    for a/6: E in
      (values/4 : Vec[E]) {
        for b/7: E in
          (values/4 : Vec[E]) {
            for f/8: (E, E) -> bool in
              (functions/5 : Vec[(E, E) -> bool]) {
                (println : (bool) -> ())((f/8 : (E, E) -> bool)((a/6 : E), (b/7 : E)));
            }
        }
    }
}