package main
file main.goml
  fn main() -> () {
      let local/main/0 = time::Timer::new(time::Duration::zero());
      select {
          recv(timer/0.done()) as local/main/1 => println(1),
      };
      let local/main/2 = time::Timer::new(time::Duration::from_seconds(60));
      println(stopped/2.stop());
      select priority {
          recv(stopped/2.done()) as local/main/3 => println(2),
          default => println(3),
      };
      task::scope(
        |local/main/4: task::Scope| {
            let local/main/6 = scope/4.spawn(|local/main/5: task::CancelToken| 42);
            select {
                recv(work/6.done()) as local/main/7 => println(work/6.join()),
            }
        }
      );
      task::scope(
        |local/main/8: task::Scope| {
            let local/main/9 = scope/8.token();
            scope/8.cancel();
            select {
                recv(cancel/9.done()) as local/main/10 => println(4),
            }
        }
      )
  }