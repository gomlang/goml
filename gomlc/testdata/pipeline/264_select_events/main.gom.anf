  t0
}

fn std::internal::host::math_float32_pow(value/0: f32, exponent/0: f32) -> f32 {
  let t0 = @runtime(std.math.float32_pow)(value/0, exponent/0) in
  t0
}

fn std::internal::host::crypto_random_bytes(length/0: isize) -> (bool, Vec[u8], string) {
  let t0 = @runtime(std.crypto.rand.bytes)(length/0) in
  t0
}

