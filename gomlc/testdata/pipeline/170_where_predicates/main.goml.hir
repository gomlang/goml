package main
file main.goml
  trait Render {
    fn render(Self) -> string;
  }

  trait Selected {
    fn selected(Self) -> string;
  }

  struct Wrap[T] {
      value: T,
  }

  impl Render for Vec[i32] {
    fn render(local/1/0: Vec[i32]) -> string {
        "items=" + self/0.len().to_string()
    }
  }

  impl[T] Selected for Wrap[T] where Vec[T]: Render {
    fn selected(local/1/1: Wrap[T]) -> string {
        "selected"
    }
  }

  fn render_all[T](local/1/2: Vec[T]) -> string where Vec[T]: Render {
      values/2.render()
  }

  fn same[T, U](local/1/3: T) -> U where T = U {
      value/3
  }

  fn require[T: Selected](local/1/4: T) -> string {
      value/4.selected()
  }

  fn main() -> () {
      let local/1/5: Vec[i32] = vec_new();
      values/5.push(1);
      values/5.push(2);
      println(def/1/5(values/5));
      let local/1/6: string = def/1/6("equal");
      println(text/6);
      let local/1/7: Wrap[i32] = Wrap { value: 7 };
      println(def/1/7(selected/7));
  }