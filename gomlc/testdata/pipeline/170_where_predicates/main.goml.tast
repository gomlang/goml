impl Render for Vec[i32] {
  fn render(self/0: Vec[i32]) -> string {
      "items=" +
        (isize::to_string : (isize) -> string)(
          (Vec[i32]::len : (Vec[i32]) -> isize)((self/0 : Vec[i32]))
        )
  }
}

impl[T] Selected for Wrap[T] where Vec[T]: Render {
  fn selected(self/1: Wrap[T]) -> string {
      "selected"
  }
}

fn render_all[T](values/2: Vec[T]) -> string where Vec[T]: Render {
    (Render::render : (Vec[T]) -> string)((values/2 : Vec[T]))
}

fn same[T, U](value/3: T) -> U where T = U {
    (value/3 : T)
}

fn require[T](value/4: T) -> string where T: Selected {
    (Selected::selected : (T) -> string)((value/4 : T))
}

fn main() -> () {
    let values/5: Vec[i32] = (@intrinsic(vec.new) : () -> Vec[i32])();
    (Vec[i32]::push : (Vec[i32], i32) -> ())((values/5 : Vec[i32]), 1);
    (Vec[i32]::push : (Vec[i32], i32) -> ())((values/5 : Vec[i32]), 2);
    (println : (string) -> ())((render_all : (Vec[i32]) -> string)((values/5 : Vec[i32])));
    let text/6: string = (same : (string) -> string)("equal");
    (println : (string) -> ())((text/6 : string));
    let selected/7: Wrap[i32] = Wrap { value: 7 };
    (println : (string) -> ())((require : (Wrap[i32]) -> string)((selected/7 : Wrap[i32])));
}