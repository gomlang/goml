package main;
trait Render {
  fn render(self: Self) -> string;
}

trait Selected {
  fn selected(self: Self) -> string;
}

struct Wrap[T] {
    value: T,
}

impl Render for Vec[i32] {
  fn render(self: Vec[i32]) -> string {
      "items=" + self.len().to_string()
  }
}

impl[T] Selected for Wrap[T] where Vec[T]: Render {
  fn selected(self: Wrap[T]) -> string {
      "selected"
  }
}

fn render_all[T](values: Vec[T]) -> string where Vec[T]: Render {
    values.render()
}

fn same[T, U](value: T) -> U where T = U {
    value
}

fn require[T: Selected](value: T) -> string {
    value.selected()
}

fn main() -> () {
    let values: Vec[i32] = vec_new();
    values.push(1);
    values.push(2);
    println(render_all(values));
    let text: string = same("equal");
    println(text);
    let selected: Wrap[i32] = Wrap { value: 7 };
    println(require(selected));
}

