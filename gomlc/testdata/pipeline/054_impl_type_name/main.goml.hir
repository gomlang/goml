package main
file main.goml
  struct Point {
      x: i32,
      y: i32,
  }

  enum Shape {
      Unit,
      Location(Point)
  }

  trait TypeName {
    fn type_name(Self) -> string;
  }

  impl TypeName for Point {
    fn type_name(local/main/0: Self) -> string {
        let Point { x: local/main/1, y: local/main/2 } = self/0;
        let local/main/3 = "Point(" + x/1.to_string();
        prefix/3 + ", " + y/2.to_string() + ")"
    }
  }

  impl TypeName for Shape {
    fn type_name(local/main/4: Self) -> string {
        match self/4 {
            Unit => "Unit",
            Location(local/main/5) => "Shape::" + TypeName::type_name(point/5),
        }
    }
  }

  fn show_point(local/main/6: Point) -> string {
      TypeName::type_name(point/6)
  }

  fn show_shape(local/main/7: Shape) -> string {
      TypeName::type_name(shape/7)
  }

  fn main() -> () {
      let local/main/8 = Point { x: 7, y: 9 };
      let _ = println(source:4:main:5(point/8));
      let local/main/9 = ctor(source:4:main:1::v0);
      let _ = println(source:4:main:6(unit_shape/9));
      let local/main/10 = ctor(source:4:main:1::v1)(Point { x: 1, y: 2 });
      let _ = println(source:4:main:6(location_shape/10));
  }