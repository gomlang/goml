impl TypeName for Point {
  fn type_name(self/0: Point) -> string {
      let Point { x: x/1: i32, y: y/2: i32 } = (self/0 : Point);
      let prefix/3: string = "Point(" + (i32::to_string : (i32) -> string)((x/1 : i32));
      (prefix/3 : string) + ", " + (i32::to_string : (i32) -> string)((y/2 : i32)) + ")"
  }
}

impl TypeName for Shape {
  fn type_name(self/4: Shape) -> string {
      match (self/4 : Shape) {
          Shape::Unit => "Unit",
          Shape::Location(point/5: Point) =>
            "Shape::" + (TypeName::type_name : (Point) -> string)((point/5 : Point)),
      }
  }
}

fn show_point(point/6: Point) -> string {
    (TypeName::type_name : (Point) -> string)((point/6 : Point))
}

fn show_shape(shape/7: Shape) -> string {
    (TypeName::type_name : (Shape) -> string)((shape/7 : Shape))
}

fn main() -> () {
    let point/8: Point = Point { x: 7, y: 9 };
    let _ : () = (println : (string) -> ())((show_point : (Point) -> string)((point/8 : Point)));
    let unit_shape/9: Shape = Shape::Unit;
    let _ : () =
      (println : (string) -> ())((show_shape : (Shape) -> string)((unit_shape/9 : Shape)));
    let location_shape/10: Shape = Shape::Location(Point { x: 1, y: 2 });
    let _ : () =
      (println : (string) -> ())((show_shape : (Shape) -> string)((location_shape/10 : Shape)));
}