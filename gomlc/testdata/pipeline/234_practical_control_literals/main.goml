fn unwrap_or_negative(value: Option[isize]) -> isize {
    let Some(result) = value else {
        return -1;
    };
    result
}

fn count_to(limit: isize) -> isize {
    let counter = Ref::new(0);
    loop {
        let current = counter.get();
        if current >= limit {
            break current;
        };
        counter.set(current + 1);
    }
}

fn loop_option(value: Option[isize]) -> isize {
    loop {
        let Some(item) = value else {
            break -2;
        };
        break item;
    }
}

fn nested_loop_value() -> isize {
    loop {
        loop {
            break;
        }
        break 7;
    }
}

fn never_returns() -> isize {
    loop {}
}

fn matches_raw_path(value: string) -> bool {
    match value {
        r"C:\tmp" => true,
        _ => false,
    }
}

fn main() {
    println(r#"C:\tmp\"quoted\""#);
    println(f"{r#"}"#}");
    println(unwrap_or_negative(Option::Some(11)).to_string());
    println(unwrap_or_negative(Option::None).to_string());
    println(count_to(4).to_string());
    println(loop_option(Option::Some(9)).to_string());
    println(loop_option(Option::None).to_string());
    println(nested_loop_value().to_string());
    println(matches_raw_path(r"C:\tmp").to_string());
}
