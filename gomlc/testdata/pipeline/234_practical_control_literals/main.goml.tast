fn unwrap_or_negative(value/0: Option[isize]) -> isize {
    let Option::Some(result/1: isize) =
      (value/0 : Option[isize]) else
      {
          return -1;
      };
    (result/1 : isize)
}

fn count_to(limit/2: isize) -> isize {
    let counter/3: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    loop {
        let current/4: isize = (Ref[isize]::get : (Ref[isize]) -> isize)((counter/3 : Ref[isize]));
        if (current/4 : isize) >= (limit/2 : isize) {
            {
                break (current/4 : isize);
            }
        } else {
            ()
        };
        (Ref[isize]::set : (Ref[isize], isize) -> ())(
          (counter/3 : Ref[isize]),
          (current/4 : isize) + 1
        );
    }
}

fn loop_option(value/5: Option[isize]) -> isize {
    loop {
        let Option::Some(item/6: isize) =
          (value/5 : Option[isize]) else
          {
              break -2;
          };
        break (item/6 : isize);
    }
}

fn nested_loop_value() -> isize {
    loop {
        loop {
            break;
        };
        break 7;
    }
}

fn never_returns() -> isize {
    loop {}
}

fn matches_raw_path(value/7: string) -> bool {
    match (value/7 : string) {
        "C:\\tmp" => true,
        _ : string => false,
    }
}

fn main() -> () {
    (println : (string) -> ())("C:\\tmp\\\"quoted\\\"");
    (println : (string) -> ())("" + "}");
    (println : (string) -> ())(
      (isize::to_string : (isize) -> string)(
        (unwrap_or_negative : (Option[isize]) -> isize)(Option::Some(11))
      )
    );
    (println : (string) -> ())(
      (isize::to_string : (isize) -> string)(
        (unwrap_or_negative : (Option[isize]) -> isize)(Option::None)
      )
    );
    (println : (string) -> ())(
      (isize::to_string : (isize) -> string)((count_to : (isize) -> isize)(4))
    );
    (println : (string) -> ())(
      (isize::to_string : (isize) -> string)(
        (loop_option : (Option[isize]) -> isize)(Option::Some(9))
      )
    );
    (println : (string) -> ())(
      (isize::to_string : (isize) -> string)((loop_option : (Option[isize]) -> isize)(Option::None))
    );
    (println : (string) -> ())(
      (isize::to_string : (isize) -> string)((nested_loop_value : () -> isize)())
    );
    (println : (string) -> ())(
      (ToString::to_string : (bool) -> string)((matches_raw_path : (string) -> bool)("C:\\tmp"))
    );
}