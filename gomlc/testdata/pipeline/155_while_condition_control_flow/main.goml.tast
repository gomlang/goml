fn main() -> () {
    let i/0: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    while if (Ref[isize]::get : (Ref[isize]) -> isize)((i/0 : Ref[isize])) < 3 {
        {
            true
        }
    } else {
        {
            false
        }
    } {
        {
            (println : (isize) -> ())(
              (Ref[isize]::get : (Ref[isize]) -> isize)((i/0 : Ref[isize]))
            );
            (Ref[isize]::set : (Ref[isize], isize) -> ())(
              (i/0 : Ref[isize]),
              (Ref[isize]::get : (Ref[isize]) -> isize)((i/0 : Ref[isize])) + 1
            );
        }
    };
    let j/1: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    let total/2: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    while if (Ref[isize]::get : (Ref[isize]) -> isize)((j/1 : Ref[isize])) < 4 {
        {
            if (Ref[isize]::get : (Ref[isize]) -> isize)((j/1 : Ref[isize])) == 1 {
                {
                    true
                }
            } else {
                {
                    (Ref[isize]::get : (Ref[isize]) -> isize)((j/1 : Ref[isize])) != 3
                }
            }
        }
    } else {
        {
            false
        }
    } {
        {
            (Ref[isize]::set : (Ref[isize], isize) -> ())(
              (total/2 : Ref[isize]),
              (Ref[isize]::get : (Ref[isize]) -> isize)((total/2 : Ref[isize])) +
                (Ref[isize]::get : (Ref[isize]) -> isize)((j/1 : Ref[isize]))
            );
            (Ref[isize]::set : (Ref[isize], isize) -> ())(
              (j/1 : Ref[isize]),
              (Ref[isize]::get : (Ref[isize]) -> isize)((j/1 : Ref[isize])) + 1
            );
        }
    };
    (println : (isize) -> ())((Ref[isize]::get : (Ref[isize]) -> isize)((total/2 : Ref[isize])));
    let k/3: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    let sum/4: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    while match (Ref[isize]::get : (Ref[isize]) -> isize)((k/3 : Ref[isize])) {
        0 => true,
        1 =>
          if (Ref[isize]::get : (Ref[isize]) -> isize)((sum/4 : Ref[isize])) == 0 {
              {
                  true
              }
          } else {
              {
                  false
              }
          },
        2 => true,
        _ : isize => false,
    } {
        {
            (Ref[isize]::set : (Ref[isize], isize) -> ())(
              (sum/4 : Ref[isize]),
              (Ref[isize]::get : (Ref[isize]) -> isize)((sum/4 : Ref[isize])) +
                (Ref[isize]::get : (Ref[isize]) -> isize)((k/3 : Ref[isize]))
            );
            (Ref[isize]::set : (Ref[isize], isize) -> ())(
              (k/3 : Ref[isize]),
              (Ref[isize]::get : (Ref[isize]) -> isize)((k/3 : Ref[isize])) + 1
            );
        }
    };
    (println : (isize) -> ())((Ref[isize]::get : (Ref[isize]) -> isize)((sum/4 : Ref[isize])));
}