package main;
struct Record {
    a: isize,
    b: isize,
    c: isize,
}

fn update(value: Record) -> Record {
    let mut value = value;
    value.a = value.a + 10;
    value.b = value.a + value.c;
    value
}

fn main() -> () {
    let mut value = Record { a: 1, b: 2, c: 3 };
    let snapshot = value;
    value.a = value.a + 4;
    let copied = update(value);
    println(snapshot.a);
    println(value.a);
    println(copied.a);
    println(copied.b);
    println(copied.c);
    let mut index = 0;
    while index < 3 {
        {
            if index == 1 {
                {
                    value.b = value.b + value.a;
                }
            } else {
                {
                    value.c = value.c + value.b;
                }
            };
            index += 1;
        }
    };
    println(value.a);
    println(value.b);
    println(value.c);
    println(snapshot.b);
    println(snapshot.c);
}

