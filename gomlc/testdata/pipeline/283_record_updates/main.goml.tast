fn update(value/0: Record) -> Record {
    let mut value/1: Record = (value/0 : Record);
    (value/1 : Record).a = (value/1 : Record).a + 10;
    (value/1 : Record).b = (value/1 : Record).a + (value/1 : Record).c;
    (value/1 : Record)
}

fn main() -> () {
    let mut value/2: Record = Record { a: 1, b: 2, c: 3 };
    let snapshot/3: Record = (value/2 : Record);
    (value/2 : Record).a = (value/2 : Record).a + 4;
    let copied/4: Record = (update : (Record) -> Record)((value/2 : Record));
    (println : (isize) -> ())((snapshot/3 : Record).a);
    (println : (isize) -> ())((value/2 : Record).a);
    (println : (isize) -> ())((copied/4 : Record).a);
    (println : (isize) -> ())((copied/4 : Record).b);
    (println : (isize) -> ())((copied/4 : Record).c);
    let mut index/5: isize = 0;
    while (index/5 : isize) < 3 {
        {
            if (index/5 : isize) == 1 {
                {
                    (value/2 : Record).b = (value/2 : Record).b + (value/2 : Record).a;
                }
            } else {
                {
                    (value/2 : Record).c = (value/2 : Record).c + (value/2 : Record).b;
                }
            };
            (index/5 : isize) += 1;
        }
    };
    (println : (isize) -> ())((value/2 : Record).a);
    (println : (isize) -> ())((value/2 : Record).b);
    (println : (isize) -> ())((value/2 : Record).c);
    (println : (isize) -> ())((snapshot/3 : Record).b);
    (println : (isize) -> ())((snapshot/3 : Record).c);
}