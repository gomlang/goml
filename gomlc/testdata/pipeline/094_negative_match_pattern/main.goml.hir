package main
file main.goml
  fn classify(local/main/0: i32) -> string {
      match n/0 {
          -1 => "minus one",
          0 => "zero",
          1 => "one",
          _ => "other",
      }
  }

  fn main() {
      println(source:4:main:0(-1));
      println(source:4:main:0(0));
