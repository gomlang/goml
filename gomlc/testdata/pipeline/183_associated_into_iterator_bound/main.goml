trait Batch {
    type Items: IntoIterator;
    fn items(self: Self) -> Self::Items;
}

struct Numbers {
    values: Vec[i32],
}

impl Batch for Numbers {
    type Items = Vec[i32];

    fn items(self: Numbers) -> Vec[i32] {
        self.values
    }
}

fn count[B: Batch](batch: B) -> i32 {
    let total = Ref::new(0);
    for _ in Batch::items(batch) {
        total.set(total.get() + 1);
    }
    total.get()
}

fn main() -> () {
    let values: Vec[i32] = Vec::new();
    values.push(10);
    values.push(20);
    values.push(30);
    println(count(Numbers { values }));
}
