  trait Batch {
    type Items: IntoIterator;
    fn items(Self) -> Self::Items;
  }

  struct Numbers {
      values: Vec[i32],
  }

  impl Batch for Numbers {
    type Items = Vec[i32];
    fn items(local/main/0: Numbers) -> Vec[i32] {
        self/0.values
    }
  }

  fn count[B: Batch](local/main/1: B) -> i32 {
      let local/main/2 = Ref::new(0);
      for _ in
        Batch::items(batch/1) {
          total/2.set(total/2.get() + 1);
      };
      total/2.get()
  }

  fn main() -> () {
