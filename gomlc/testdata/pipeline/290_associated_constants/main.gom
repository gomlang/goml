trait Measure {
    const WIDTH: usize;
    const DEFAULT: i32 = 17;
}

struct Packet {}

impl Packet {
    pub const HEADER: usize = 2;
}

impl Measure for Packet {
    const WIDTH: usize = 4;
}

struct Buffer[const N: usize] {
    data: [i32; N],
}

impl[const N: usize] Buffer[N] {
    pub const CAPACITY: usize = N;
}

fn width[T: Measure]() -> usize {
    T::WIDTH
}

fn main() -> () {
    println(Packet::HEADER);
    println(Packet::WIDTH);
    println(Packet::DEFAULT);
    println(width::[Packet]());
    println(Buffer::[3]::CAPACITY);
    let header: [i32; Packet::HEADER] = [1, 2];
    println(header[1]);
}
