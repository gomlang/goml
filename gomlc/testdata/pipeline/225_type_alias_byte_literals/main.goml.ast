package main;
type UserId = u64;

type Pair[T] = (T, T);

fn sum_pair(value: Pair[i32]) -> i32 {
    value.0 + value.1
}

fn classify(value: byte) -> string {
    match value {
        b'\x0a' => "newline",
        b'\x41'..=b'\x5a' => "uppercase",
        _ => "other",
    }
}

fn main() -> () {
    let user: UserId = 255;
    let pair: Pair[i32] = (10, 10);
    let marker: byte = b'\x41';
    println(user);
    println(sum_pair(pair));
    println(marker);
    println(classify(marker));
    println(classify(b'\x0a'))
}

