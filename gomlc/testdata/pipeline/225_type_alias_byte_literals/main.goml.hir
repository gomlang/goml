package main
file main.goml
  type UserId = u64;

  type Pair[T] = (T, T);

  fn sum_pair(local/main/0: Pair[i32]) -> i32 {
      value/0.0 + value/0.1
  }

  fn classify(local/main/1: byte) -> string {
      match value/1 {
          b'\x0a' => "newline",
          b'\x41'..=b'\x5a' => "uppercase",
          _ => "other",
      }
  }

  fn main() -> () {
      let local/main/2: UserId = 255;
      let local/main/3: Pair[i32] = (10, 10);
      let local/main/4: byte = b'\x41';
      println(user/2);
      println(source:4:main:2(pair/3));
      println(marker/4);
      println(source:4:main:3(marker/4));
      println(source:4:main:3(b'\x0a'))
  }