fn sum_pair(value/0: (i32, i32)) -> i32 {
    (value/0 : (i32, i32)).0 + (value/0 : (i32, i32)).1
}

fn classify(value/1: u8) -> string {
    match (value/1 : u8) {
        10 => "newline",
        65..=90 => "uppercase",
        _ : u8 => "other",
    }
}

fn main() -> () {
    let user/2: u64 = 255;
    let pair/3: (i32, i32) = (10, 10);
    let marker/4: u8 = 65;
    (println : (u64) -> ())((user/2 : u64));
    (println : (i32) -> ())((sum_pair : ((i32, i32)) -> i32)((pair/3 : (i32, i32))));
    (println : (u8) -> ())((marker/4 : u8));
    (println : (string) -> ())((classify : (u8) -> string)((marker/4 : u8)));
    (println : (string) -> ())((classify : (u8) -> string)(10))
}