fn double(x/0: i32) -> i32 {
    (x/0 : i32) * 2
}

fn increment(x/1: i32) -> i32 {
    (x/1 : i32) + 1
}

fn apply_once(f/2: (i32) -> i32, value/3: i32) -> i32 {
    (f/2 : (i32) -> i32)((value/3 : i32))
}

fn compose(f/4: (i32) -> i32, g/5: (i32) -> i32, value/6: i32) -> i32 {
    (f/4 : (i32) -> i32)((g/5 : (i32) -> i32)((value/6 : i32)))
}

fn main() -> () {
    let local/7: (i32) -> i32 = (double : (i32) -> i32);
    let first/8: i32 = (apply_once : ((i32) -> i32, i32) -> i32)((local/7 : (i32) -> i32), 4);
    let composed/9: i32 =
      (compose : ((i32) -> i32, (i32) -> i32, i32) -> i32)(
        (double : (i32) -> i32),
        (increment : (i32) -> i32),
        (first/8 : i32)
      );
    let closure_apply/11: (i32) -> i32 =
      |value/10: i32| =>
        (apply_once : ((i32) -> i32, i32) -> i32)((increment : (i32) -> i32), (value/10 : i32));
    let closure_result/12: i32 = (closure_apply/11 : (i32) -> i32)((composed/9 : i32));
    let global_invoker/15: ((i32) -> i32, i32) -> i32 =
      |func_to_call/13: (i32) -> i32, value/14: i32| =>
        (apply_once : ((i32) -> i32, i32) -> i32)(
          (func_to_call/13 : (i32) -> i32),
          (value/14 : i32)
        );
    let invoked_with_global/16: i32 =
      (global_invoker/15 : ((i32) -> i32, i32) -> i32)((double : (i32) -> i32), 3);
    let composer_closure/18: (i32) -> i32 =
      |value/17: i32| =>
        (compose : ((i32) -> i32, (i32) -> i32, i32) -> i32)(
          (double : (i32) -> i32),
          (increment : (i32) -> i32),
          (value/17 : i32)
        );
    let composed_by_closure/19: i32 = (composer_closure/18 : (i32) -> i32)(5);
    let printer/20: (string) -> () = (println : (string) -> ());
    let _ : () =
      (printer/20 : (string) -> ())((i32::to_string : (i32) -> string)((composed/9 : i32)));
    let _ : () =
      (printer/20 : (string) -> ())((i32::to_string : (i32) -> string)((closure_result/12 : i32)));
    let _ : () =
      (printer/20 : (string) -> ())(
        (i32::to_string : (i32) -> string)((invoked_with_global/16 : i32))
      );
    let _ : () =
      (printer/20 : (string) -> ())(
        (i32::to_string : (i32) -> string)((composed_by_closure/19 : i32))
      );
}