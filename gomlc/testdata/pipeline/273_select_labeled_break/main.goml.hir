package main
file main.goml
  fn main() -> () {
      let local/main/0 = Ref::new(false);
      let local/main/1: Channel[isize] = Channel::new(0);
      while true {
          {
              if keep/0.get() {
                  continue
              } else {
                  select {
                      recv(channel/1) as local/main/2 => break,
                      default => break,
                  }
              }
          }
      };
      println(42)
  }