package main;
enum Event {
    Open,
    Close,
    Advance,
    Error
}

fn main() -> () {
    let running = Ref::new(true);
    while running.get() {
        {
            let event = Event::Open;
            match event {
                Event::Open =>
                  {
                      let scanning = Ref::new(false);
                      while scanning.get() {
                          {}
                      }
                  },
                Event::Close => (),
                Event::Advance => (),
                Event::Error => (),
            };
            let scanning = Ref::new(false);
            while scanning.get() {
                {}
            };
            running.set(false)
        }
    };
    println("ok")
}

