fn optimized(base/0: isize, count/1: isize) -> isize {
    let mut index/2: isize = 0;
    let mut result/3: isize = 0;
    while (index/2 : isize) < (count/1 : isize) {
        {
            let square/4: isize = (base/0 : isize) * (base/0 : isize);
            let scaled/5: isize = (square/4 : isize) * 17;
            let offset/6: isize = (scaled/5 : isize) + (base/0 : isize);
            (result/3 : isize) = (result/3 : isize) + (offset/6 : isize);
            (index/2 : isize) = (index/2 : isize) + 1;
        }
    };
    (result/3 : isize)
}

fn guarded(divisor/7: isize, count/8: isize) -> isize {
    let mut index/9: isize = 0;
    let mut result/10: isize = 0;
    while (index/9 : isize) < (count/8 : isize) {
        {
            let quotient/11: isize = 100 / (divisor/7 : isize);
            (result/10 : isize) = (result/10 : isize) + (quotient/11 : isize);
            (index/9 : isize) = (index/9 : isize) + 1;
        }
    };
    (result/10 : isize)
}

fn changing(count/12: isize) -> isize {
    let mut index/13: isize = 0;
    let mut value/14: isize = 1;
    let mut result/15: isize = 0;
    while (index/13 : isize) < (count/12 : isize) {
        {
            let derived/16: isize = (value/14 : isize) + 1;
            (result/15 : isize) = (result/15 : isize) + (derived/16 : isize);
            (value/14 : isize) = (value/14 : isize) + 1;
            (index/13 : isize) = (index/13 : isize) + 1;
        }
    };
    (result/15 : isize)
}

fn main() -> () {
    (println : (isize) -> ())((optimized : (isize, isize) -> isize)(3, 4));
    (println : (isize) -> ())((guarded : (isize, isize) -> isize)(0, 0));
    (println : (isize) -> ())((changing : (isize) -> isize)(3));
}