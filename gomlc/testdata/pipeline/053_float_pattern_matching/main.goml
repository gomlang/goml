enum FloatEvent {
    Sample32(string, f32),
    Sample64(string, f64),
}

fn summarize(event: FloatEvent) -> string {
    match event {
        Sample32(label, value) => label + value.to_string(),
        Sample64(label, value) => label + value.to_string(),
    }
}

fn compare(values: (f32, f64)) -> string {
    match values {
        (left, right) => {
            let limit32: f32 = 1.0;
            let limit64: f64 = 5.0;
            let less_left = left < limit32;
            let less_right = right < limit64;
            "left<1?=" + less_left.to_string() + ",right<5?=" + less_right.to_string()
        },
    }
}

fn main() {
    let first_value: f32 = 0.5;
    let second_value: f32 = 2.25;
    let third_value: f64 = 9.5;
    let first = Sample32("f32=", first_value);
    let second = Sample32("f32_b=", second_value);
    let third = Sample64("f64=", third_value);
    let tuple: (f32, f64) = (0.75, 4.0);
    let tuple_other: (f32, f64) = (1.5, 7.25);
    let message = summarize(first) + summarize(second) + summarize(third) + compare(tuple)
        + compare(tuple_other);
    let _ = println(message);
}
