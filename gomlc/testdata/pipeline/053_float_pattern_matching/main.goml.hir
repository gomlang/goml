package main
file main.goml
  enum FloatEvent {
      Sample32(string, f32),
      Sample64(string, f64)
  }

  fn summarize(local/1/0: FloatEvent) -> string {
      match event/0 {
          Sample32(local/1/1, local/1/2) => label/1 + value/2.to_string(),
          Sample64(local/1/3, local/1/4) => label/3 + value/4.to_string(),
      }
  }

  fn compare(local/1/5: (f32, f64)) -> string {
      match values/5 {
          (local/1/6, local/1/7) =>
            {
                let local/1/8: f32 = 1.0;
                let local/1/9: f64 = 5.0;
                let local/1/10 = left/6 < limit32/8;
                let local/1/11 = right/7 < limit64/9;
                "left<1?=" + less_left/10.to_string() + ",right<5?=" + less_right/11.to_string()
            },
      }
  }

  fn main() {
      let local/1/12: f32 = 0.5;
      let local/1/13: f32 = 2.25;
      let local/1/14: f64 = 9.5;
      let local/1/15 = ctor(def/1/0::v0)("f32=", first_value/12);
      let local/1/16 = ctor(def/1/0::v0)("f32_b=", second_value/13);
      let local/1/17 = ctor(def/1/0::v1)("f64=", third_value/14);
      let local/1/18: (f32, f64) = (0.75, 4.0);
      let local/1/19: (f32, f64) = (1.5, 7.25);
      let local/1/20 =
        def/1/1(first/15) + def/1/1(second/16) + def/1/1(third/17) + def/1/2(tuple/18) +
          def/1/2(tuple_other/19);
      let _ = println(message/20);
  }