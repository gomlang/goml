package main
file main.goml
  enum FloatEvent {
      Sample32(string, f32),
      Sample64(string, f64)
  }

  fn summarize(local/main/0: FloatEvent) -> string {
      match event/0 {
          Sample32(local/main/1, local/main/2) => label/1 + value/2.to_string(),
          Sample64(local/main/3, local/main/4) => label/3 + value/4.to_string(),
      }
  }

  fn compare(local/main/5: (f32, f64)) -> string {
      match values/5 {
          (local/main/6, local/main/7) =>
            {
                let local/main/8: f32 = 1.0;
                let local/main/9: f64 = 5.0;
                let local/main/10 = left/6 < limit32/8;
                let local/main/11 = right/7 < limit64/9;
                "left<1?=" + less_left/10.to_string() + ",right<5?=" + less_right/11.to_string()
            },
      }
  }

  fn main() {
      let local/main/12: f32 = 0.5;
      let local/main/13: f32 = 2.25;
      let local/main/14: f64 = 9.5;
      let local/main/15 = ctor(source:4:main:0::v0)("f32=", first_value/12);
      let local/main/16 = ctor(source:4:main:0::v0)("f32_b=", second_value/13);
      let local/main/17 = ctor(source:4:main:0::v1)("f64=", third_value/14);
      let local/main/18: (f32, f64) = (0.75, 4.0);
      let local/main/19: (f32, f64) = (1.5, 7.25);
      let local/main/20 =
        source:4:main:1(first/15) + source:4:main:1(second/16) + source:4:main:1(third/17) +
          source:4:main:2(tuple/18) +
          source:4:main:2(tuple_other/19);
      let _ = println(message/20);
  }