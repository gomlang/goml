fn summarize(event/0: FloatEvent) -> string {
    match (event/0 : FloatEvent) {
        FloatEvent::Sample32(label/1: string, value/2: f32) =>
          (label/1 : string) + (ToString::to_string : (f32) -> string)((value/2 : f32)),
        FloatEvent::Sample64(label/3: string, value/4: f64) =>
          (label/3 : string) + (ToString::to_string : (f64) -> string)((value/4 : f64)),
    }
}

fn compare(values/5: (f32, f64)) -> string {
    match (values/5 : (f32, f64)) {
        (left/6: f32, right/7: f64) =>
          {
              let limit32/8: f32 = 1;
              let limit64/9: f64 = 5;
              let less_left/10: bool = (left/6 : f32) < (limit32/8 : f32);
              let less_right/11: bool = (right/7 : f64) < (limit64/9 : f64);
              "left<1?=" + (ToString::to_string : (bool) -> string)((less_left/10 : bool)) +
                ",right<5?=" +
                (ToString::to_string : (bool) -> string)((less_right/11 : bool))
          },
    }
}

fn main() -> () {
    let first_value/12: f32 = 0.5;
    let second_value/13: f32 = 2.25;
    let third_value/14: f64 = 9.5;
    let first/15: FloatEvent = FloatEvent::Sample32("f32=", (first_value/12 : f32));
    let second/16: FloatEvent = FloatEvent::Sample32("f32_b=", (second_value/13 : f32));
    let third/17: FloatEvent = FloatEvent::Sample64("f64=", (third_value/14 : f64));
    let tuple/18: (f32, f64) = (0.75, 4);
    let tuple_other/19: (f32, f64) = (1.5, 7.25);
    let message/20: string =
      (summarize : (FloatEvent) -> string)((first/15 : FloatEvent)) +
        (summarize : (FloatEvent) -> string)((second/16 : FloatEvent)) +
        (summarize : (FloatEvent) -> string)((third/17 : FloatEvent)) +
        (compare : ((f32, f64)) -> string)((tuple/18 : (f32, f64))) +
        (compare : ((f32, f64)) -> string)((tuple_other/19 : (f32, f64)));
    let _ : () = (println : (string) -> ())((message/20 : string));
}