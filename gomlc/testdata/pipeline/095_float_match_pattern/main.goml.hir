package main
file main.goml
  fn classify(local/main/0: f64) -> string {
      match x/0 {
          0.0 => "zero",
          1.0 => "one",
          -1.0 => "minus one",
          3.14 => "pi",
          _ => "other",
      }
  }

  fn main() {
      println(source:4:main:0(0.0));
      println(source:4:main:0(1.0));
      println(source:4:main:0(-1.0));
      println(source:4:main:0(3.14));
      println(source:4:main:0(42.0));
  }