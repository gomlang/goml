package main
file main.goml
  enum Expr {
      Zero,
      Succ(Expr),
      Add(Expr, Expr),
      Mul(Expr, Expr)
  }

  fn main() {
      let local/main/0 =
        ctor(source:4:main:0::v3)(
          ctor(source:4:main:0::v2)(ctor(source:4:main:0::v0), ctor(source:4:main:0::v0)),
          ctor(source:4:main:0::v0)
        );
      match a/0 {
          Add(Zero, Zero) => print(0),
          Mul(Zero, local/main/1) => print(1),
          Add(Succ(local/main/2), local/main/3) => print(2),
          Mul(local/main/4, Zero) => print(3),
          Mul(Add(local/main/5, local/main/6), local/main/7) => print(4),
          Add(local/main/8, Zero) => print(5),
          local/main/9 => print(6),
      }
  }