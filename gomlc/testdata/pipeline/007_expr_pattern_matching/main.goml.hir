package main
file main.goml
  enum Expr {
      Zero,
      Succ(Expr),
      Add(Expr, Expr),
      Mul(Expr, Expr)
  }

  fn main() {
      let local/1/0 =
        ctor(def/1/0::v3)(
          ctor(def/1/0::v2)(ctor(def/1/0::v0), ctor(def/1/0::v0)),
          ctor(def/1/0::v0)
        );
      match a/0 {
          Add(Zero, Zero) => print(0),
          Mul(Zero, local/1/1) => print(1),
          Add(Succ(local/1/2), local/1/3) => print(2),
          Mul(local/1/4, Zero) => print(3),
          Mul(Add(local/1/5, local/1/6), local/1/7) => print(4),
          Add(local/1/8, Zero) => print(5),
          local/1/9 => print(6),
      }
  }