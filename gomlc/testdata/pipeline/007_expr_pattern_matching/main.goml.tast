fn main() -> () {
    let a/0: Expr = Expr::Mul(Expr::Add(Expr::Zero, Expr::Zero), Expr::Zero);
    match (a/0 : Expr) {
        Expr::Add(Expr::Zero, Expr::Zero) => (print : (isize) -> ())(0),
        Expr::Mul(Expr::Zero, x/1: Expr) => (print : (isize) -> ())(1),
        Expr::Add(Expr::Succ(x/2: Expr), y/3: Expr) => (print : (isize) -> ())(2),
        Expr::Mul(x/4: Expr, Expr::Zero) => (print : (isize) -> ())(3),
        Expr::Mul(Expr::Add(x/5: Expr, y/6: Expr), z/7: Expr) => (print : (isize) -> ())(4),
        Expr::Add(x/8: Expr, Expr::Zero) => (print : (isize) -> ())(5),
        x/9: Expr => (print : (isize) -> ())(6),
    }
}