static VALUES: OnceCell[FrozenVec[isize]] = OnceCell::new();

fn values() -> FrozenVec[isize] {
    (OnceCell[FrozenVec[isize]]::get_or_init : (
      OnceCell[FrozenVec[isize]],
      () -> FrozenVec[isize]
    ) -> FrozenVec[isize])(
      (VALUES : OnceCell[FrozenVec[isize]]),
      || =>
        (Vec[isize]::freeze : (Vec[isize]) -> FrozenVec[isize])(
          (@intrinsic(vec.from_array) : ([isize; 3]) -> Vec[isize])([1, 2, 3])
        )
    )
}

fn main() -> () {
    let frozen/0: FrozenVec[isize] = (values : () -> FrozenVec[isize])();
    let copy/1: Vec[isize] =
      (FrozenVec[isize]::to_vec : (FrozenVec[isize]) -> Vec[isize])((frozen/0 : FrozenVec[isize]));
    (Vec[isize]::set : (Vec[isize], isize, isize) -> ())((copy/1 : Vec[isize]), 0, 9);
    (println : (string) -> ())(
      (isize::to_string : (isize) -> string)(
        (FrozenVec[isize]::get : (FrozenVec[isize], isize) -> isize)(
          (frozen/0 : FrozenVec[isize]),
          0
        )
      )
    );
    (println : (string) -> ())(
      (isize::to_string : (isize) -> string)(
        (Vec[isize]::get : (Vec[isize], isize) -> isize)((copy/1 : Vec[isize]), 0)
      )
    );
    (println : (string) -> ())(
      (isize::to_string : (isize) -> string)(
        (FrozenVec[isize]::get : (FrozenVec[isize], isize) -> isize)(
          (values : () -> FrozenVec[isize])(),
          1
        )
      )
    )
}