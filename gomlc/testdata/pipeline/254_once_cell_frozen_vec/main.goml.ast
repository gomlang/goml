package main;
static VALUES: OnceCell[FrozenVec[isize]] = OnceCell::new();

fn values() -> FrozenVec[isize] {
    VALUES.get_or_init(|| Vec::from_array([1, 2, 3]).freeze())
}

fn main() -> () {
    let frozen = values();
    let copy = frozen.to_vec();
    copy.set(0, 9);
    println(frozen.get(0).to_string());
    println(copy.get(0).to_string());
    println(values().get(1).to_string())
}

