fn values() -> FrozenVec[isize] {
  inherent#OnceCell#OnceCell[FrozenVec[isize]]#get_or_init(
    VALUES,
    || => inherent#Vec#Vec[isize]#freeze(@intrinsic(vec.from_array)([1, 2, 3]))
