fn main() -> () {
  let frozen/0 = values() in
  let copy/0 = inherent#FrozenVec#FrozenVec[isize]#to_vec(frozen/0) in
  let _wild0 = inherent#Vec#Vec[isize]#set(copy/0, 0, 9) in
  let _wild1 =
    println(inherent#isize#isize#to_string(inherent#FrozenVec#FrozenVec[isize]#get(frozen/0, 0))) in
  let _wild2 = println(inherent#isize#isize#to_string(inherent#Vec#Vec[isize]#get(copy/0, 0))) in
  println(inherent#isize#isize#to_string(inherent#FrozenVec#FrozenVec[isize]#get(values(), 1)))
