package main
file main.goml
  fn classify(local/main/0: string) -> isize {
      match value/0 {
          "Aλ" => 1,
          "\n\r\t\u{8}\u{c}/" => 2,
          "\"\\" => 3,
          "\\n" => 4,
          _ => 0,
      }
  }

  fn main() -> () {
      println(source:4:main:0("Aλ").to_string());
      println(source:4:main:0("\n\r\t\u{8}\u{c}/").to_string());
      println(source:4:main:0("\"\\").to_string());
      println(source:4:main:0("\\n").to_string())
  }