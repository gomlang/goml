fn cut_prefix(case_id/0: i32) -> Option[string] {
    if (case_id/0 : i32) == 0 {
        {
            Option::Some("ml")
        }
    } else {
        {
            Option::None
        }
    }
}

fn trim_go(case_id/1: i32) -> Option[string] {
    let suffix/2: string =
      match (cut_prefix : (i32) -> Option[string])((case_id/1 : i32)) {
          Option::Some(try_value/13: string) => (try_value/13 : string),
          Option::None => return Option::None,
      };
    Option::Some((suffix/2 : string) + "!")
}

fn show(opt/3: Option[string]) -> string {
    match (opt/3 : Option[string]) {
        Option::Some(value/4: string) => "some " + (value/4 : string),
        Option::None => "none",
    }
}

fn main() -> () {
    (println : (string) -> ())(
      (show : (Option[string]) -> string)((trim_go : (i32) -> Option[string])(0))
    );
    (println : (string) -> ())(
      (show : (Option[string]) -> string)((trim_go : (i32) -> Option[string])(1))
    );
}