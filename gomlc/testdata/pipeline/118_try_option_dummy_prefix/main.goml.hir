package main
file main.goml
  fn cut_prefix(local/main/0: i32) -> Option[string] {
      if case_id/0 == 0 {
          Option::Some("ml")
      } else {
          Option::None
      }
  }

  fn trim_go(local/main/1: i32) -> Option[string] {
      let local/main/2 = source:4:main:0(case_id/1)?;
      Option::Some(suffix/2 + "!")
  }

  fn show(local/main/3: Option[string]) -> string {
      match opt/3 {
          Option::Some(local/main/4) => "some " + value/4,
          Option::None => "none",
      }
  }

  fn main() -> () {
      println(source:4:main:2(source:4:main:1(0)));
      println(source:4:main:2(source:4:main:1(1)));
  }