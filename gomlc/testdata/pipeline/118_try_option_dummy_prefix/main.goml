fn cut_prefix(case_id: i32) -> Option[string] {
    if case_id == 0 {
        Option::Some("ml")
    } else {
        Option::None
    }
}

fn trim_go(case_id: i32) -> Option[string] {
    let suffix = cut_prefix(case_id)?;
    Option::Some(suffix + "!")
}

fn show(opt: Option[string]) -> string {
    match opt {
        Option::Some(value) => "some " + value,
        Option::None => "none",
    }
}

fn main() -> () {
    println(show(trim_go(0)));
    println(show(trim_go(1)));
}
