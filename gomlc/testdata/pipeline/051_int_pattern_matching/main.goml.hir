          _ => false,
      }
  }

  fn is_special32(local/main/2: i32) -> bool {
      match value/2 {
          4096 => true,
          8192 => true,
          _ => false,
      }
  }

  fn is_special64(local/main/3: i64) -> bool {
      match value/3 {
          16384 => true,
          32768 => true,
          _ => false,
      }
  }

  fn match_tuple(local/main/4: (i8, i16)) -> bool {
      match values/4 {
          (1, 2) => true,
          _ => false,
      }
  }

  fn match_struct(local/main/5: PairData) -> bool {
      match pair/5 {
          PairData { head: 100, tail: 200 } => true,
          PairData { head: _, tail: 300 } => true,
          _ => false,
      }
  }

  fn report(local/main/6: string, local/main/7: bool) -> string {
      label/6 + value/7.to_string()
