package main
file main.goml
  struct PairData {
      head: i32,
      tail: i64,
  }

  fn is_special8(local/1/0: i8) -> bool {
      match value/0 {
          5 => true,
          7 => true,
          _ => false,
      }
  }

  fn is_special16(local/1/1: i16) -> bool {
      match value/1 {
          1024 => true,
          2048 => true,
          _ => false,
      }
  }

  fn is_special32(local/1/2: i32) -> bool {
      match value/2 {
          4096 => true,
          8192 => true,
          _ => false,
      }
  }

  fn is_special64(local/1/3: i64) -> bool {
      match value/3 {
          16384 => true,
          32768 => true,
          _ => false,
      }
  }

  fn match_tuple(local/1/4: (i8, i16)) -> bool {
      match values/4 {
          (1, 2) => true,
          _ => false,
      }
  }

  fn match_struct(local/1/5: PairData) -> bool {
      match pair/5 {
          PairData { head: 100, tail: 200 } => true,
          PairData { head: _, tail: 300 } => true,
          _ => false,
      }
  }

  fn report(local/1/6: string, local/1/7: bool) -> string {
      label/6 + value/7.to_string()
  }

  fn main() {
      let local/1/8: i8 = 1;
      let local/1/9: i16 = 2;
      let local/1/10 = def/1/5((tuple_first/8, tuple_second/9));
      let local/1/11 = def/1/5((3, 4));
      let local/1/12 = def/1/6(PairData { head: 100, tail: 200 });
      let local/1/13 = def/1/6(PairData { head: 10, tail: 300 });
      let local/1/14 = def/1/7("i8=", def/1/1(5));
      let local/1/15 = def/1/7(",i16=", def/1/2(1024));
      let local/1/16 = def/1/7(",i32=", def/1/3(8192));
      let local/1/17 = def/1/7(",int64_a=", def/1/4(16384));
      let local/1/18 = def/1/7(",int64_b=", def/1/4(32768));
      let local/1/19 = def/1/7(",tuple_hit=", tuple_result_hit/10);
      let local/1/20 = def/1/7(",tuple_miss=", tuple_result_miss/11);
      let local/1/21 = def/1/7(",struct_first=", pair_first/12);
      let local/1/22 = def/1/7(",struct_second=", pair_second/13);
      let local/1/23 =
        part1/14 + part2/15 + part3/16 + part4/17 + part5/18 + part6/19 + part7/20 + part8/21 +
          part9/22;
      let _ = println(message/23);
  }