package main;
struct PairData {
    head: i32,
    tail: i64,
}

fn is_special8(value: i8) -> bool {
    match value {
        5 => true,
        7 => true,
        _ => false,
    }
}

fn is_special16(value: i16) -> bool {
    match value {
        1024 => true,
        2048 => true,
        _ => false,
    }
}

fn is_special32(value: i32) -> bool {
    match value {
        4096 => true,
        8192 => true,
        _ => false,
    }
}

fn is_special64(value: i64) -> bool {
    match value {
        16384 => true,
        32768 => true,
        _ => false,
    }
}

fn match_tuple(values: (i8, i16)) -> bool {
    match values {
        (1, 2) => true,
        _ => false,
    }
}

fn match_struct(pair: PairData) -> bool {
    match pair {
        PairData { head: 100, tail: 200 } => true,
        PairData { head: _, tail: 300 } => true,
        _ => false,
    }
}

fn report(label: string, value: bool) -> string {
    label + value.to_string()
}

fn main() {
    let tuple_first: i8 = 1;
    let tuple_second: i16 = 2;
    let tuple_result_hit = match_tuple((tuple_first, tuple_second));
    let tuple_result_miss = match_tuple((3, 4));
    let pair_first = match_struct(PairData { head: 100, tail: 200 });
    let pair_second = match_struct(PairData { head: 10, tail: 300 });
    let part1 = report("i8=", is_special8(5));
    let part2 = report(",i16=", is_special16(1024));
    let part3 = report(",i32=", is_special32(8192));
    let part4 = report(",int64_a=", is_special64(16384));
    let part5 = report(",int64_b=", is_special64(32768));
    let part6 = report(",tuple_hit=", tuple_result_hit);
    let part7 = report(",tuple_miss=", tuple_result_miss);
    let part8 = report(",struct_first=", pair_first);
    let part9 = report(",struct_second=", pair_second);
    let message = part1 + part2 + part3 + part4 + part5 + part6 + part7 + part8 + part9;
    let _ = println(message);
}

