package main;
struct Numbers {
    values: Vec[i32],
    conversions: Ref[i32],
}

impl IntoIterator for Numbers {
  type Item = i32;
  type IntoIter = FnIterator[i32];
  fn into_iter(self: Numbers) -> FnIterator[i32] {
      self.conversions.set(self.conversions.get() + 1);
      self.values.iter()
  }
}

fn make_numbers(builds: Ref[i32], conversions: Ref[i32]) -> Numbers {
    builds.set(builds.get() + 1);
    let values: Vec[i32] = Vec::new();
    values.push(1);
    values.push(2);
    values.push(3);
    Numbers { values: values, conversions: conversions }
}

fn sum[S: IntoIterator](source: S) -> i32 where S::Item = i32 {
    let total = Ref::new(0);
    for value in
      source {
        total.set(total.get() + value);
    };
    total.get()
}

fn main() -> () {
    let builds = Ref::new(0);
    let conversions = Ref::new(0);
    println(sum(make_numbers(builds, conversions)));
    println(builds.get());
    println(conversions.get());
    let values: Vec[i32] = Vec::new();
    values.push(10);
    values.push(20);
    values.push(30);
    println(sum(values));
    println(sum(values.slice(1, 3)));
}

