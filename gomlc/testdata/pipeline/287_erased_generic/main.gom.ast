package main;
struct Token[T] {
    value: isize,
}

trait Creator {
  fn token() -> Token[Self];
}

struct First {}

struct Second {}

impl Creator for First {
  fn token() -> Token[First] {
      Token { value: 42 }
  }
}

impl Creator for Second {
  fn token() -> Token[Second] {
      Token { value: 7 }
  }
}

fn erased[T: Creator]() -> isize {
    let token: Token[T] = Creator::token();
    token.value
}

fn unused[T: Creator]() -> isize {
    erased::[T]()
}

fn forwarded[T: Creator](delta: isize) -> isize {
    erased::[T]() + delta
}

fn mixed[T: Creator, U](value: U) -> (isize, U) {
    (erased::[T](), value)
}

fn main() -> () {
    println(erased::[First]());
    println(erased::[Second]());
    println(forwarded::[First](3));
    let callback: () -> isize = erased::[Second];
    println(callback());
    let (value, suffix) = mixed::[First, string]("done");
    println(value);
    println(suffix)
}

