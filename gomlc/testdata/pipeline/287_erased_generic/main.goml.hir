package main
file main.goml
  struct Token[T] {
      value: isize,
  }

  trait Creator {
    fn token() -> Token[Self];
  }

  struct First {}

  struct Second {}

  impl Creator for First {
    fn token() -> Token[First] {
        Token { value: 42 }
    }
  }

  impl Creator for Second {
    fn token() -> Token[Second] {
        Token { value: 7 }
    }
  }

  fn erased[T: Creator]() -> isize {
      let local/main/0: Token[T] = Creator::token();
      token/0.value
  }

  fn unused[T: Creator]() -> isize {
      erased::[T]()
  }

  fn forwarded[T: Creator](local/main/1: isize) -> isize {
      erased::[T]() + delta/1
  }

  fn mixed[T: Creator, U](local/main/2: U) -> (isize, U) {
      (erased::[T](), value/2)
  }

  fn main() -> () {
      println(erased::[First]());
      println(erased::[Second]());
      println(forwarded::[First](3));
      let local/main/3: () -> isize = erased::[Second];
      println(callback/3());
      let (local/main/4, local/main/5) = mixed::[First, string]("done");
      println(value/4);
      println(suffix/5)
  }