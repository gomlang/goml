impl Creator for First {
  fn token() -> Token[First] {
      Token { value: 42 }
  }
}

impl Creator for Second {
  fn token() -> Token[Second] {
      Token { value: 7 }
  }
}

fn erased[T]() -> isize where T: Creator {
    let token/0: Token[T] = (Creator::token : () -> Token[T])();
    (token/0 : Token[T]).value
}

fn unused[T]() -> isize where T: Creator {
    (erased::[T] : () -> isize)()
}

fn forwarded[T](delta/1: isize) -> isize where T: Creator {
    (erased::[T] : () -> isize)() + (delta/1 : isize)
}

fn mixed[T, U](value/2: U) -> (isize, U) where T: Creator {
    ((erased::[T] : () -> isize)(), (value/2 : U))
}

fn main() -> () {
    (println : (isize) -> ())((erased::[First] : () -> isize)());
    (println : (isize) -> ())((erased::[Second] : () -> isize)());
    (println : (isize) -> ())((forwarded::[First] : (isize) -> isize)(3));
    let callback/3: () -> isize = (erased::[Second] : () -> isize);
    (println : (isize) -> ())((callback/3 : () -> isize)());
    let (value/4: isize, suffix/5: string) = (mixed::[First] : (string) -> (isize, string))("done");
    (println : (isize) -> ())((value/4 : isize));
    (println : (string) -> ())((suffix/5 : string))
}