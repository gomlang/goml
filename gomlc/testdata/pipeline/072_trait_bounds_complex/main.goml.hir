package main
file main.goml
  trait Display {
    fn show(Self) -> string;
  }

  trait Debug {
    fn show(Self) -> string;
  }

  trait MyEq {
    fn eq(Self, Self) -> bool;
  }

  trait MyHash {
    fn hash(Self) -> i32;
  }

  trait Add {
    fn add(Self, Self) -> Self;
  }

  trait Scale {
    fn scale(Self, i32) -> Self;
  }

  trait Inspect {
    fn inspect(Self) -> string;
  }

  struct Boxed {
      value: i32,
  }

  impl Display for i32 {
    fn show(local/1/0: i32) -> string {
        self/0.to_string()
    }
  }

  impl Debug for i32 {
    fn show(local/1/1: i32) -> string {
        "i32(" + self/1.to_string() + ")"
    }
  }

  impl MyEq for i32 {
    fn eq(local/1/2: i32, local/1/3: i32) -> bool {
        self/2 == other/3
    }
  }

  impl MyHash for i32 {
    fn hash(local/1/4: i32) -> i32 {
        self/4 * 16777619 + 216613626
    }
  }

  impl Add for i32 {
    fn add(local/1/5: i32, local/1/6: i32) -> i32 {
        self/5 + other/6
    }
  }

  impl Scale for i32 {
    fn scale(local/1/7: i32, local/1/8: i32) -> i32 {
        self/7 * factor/8
    }
  }

  impl Inspect for i32 {
    fn inspect(local/1/9: i32) -> string {
        "<" + self/9.to_string() + ">"
    }
  }

  impl Display for Boxed {
    fn show(local/1/10: Boxed) -> string {
        "Boxed(" + self/10.value.to_string() + ")"
    }
  }

  impl Debug for Boxed {
    fn show(local/1/11: Boxed) -> string {
        "Boxed{value=" + self/11.value.to_string() + "}"
    }
  }

  impl MyEq for Boxed {
    fn eq(local/1/12: Boxed, local/1/13: Boxed) -> bool {
        self/12.value == other/13.value
    }
  }

  impl MyHash for Boxed {
    fn hash(local/1/14: Boxed) -> i32 {
        self/14.value * 31 + 7 * 1315423911
    }
  }

  impl Add for Boxed {
    fn add(local/1/15: Boxed, local/1/16: Boxed) -> Boxed {
        Boxed { value: self/15.value + other/16.value }
    }
  }

  impl Scale for Boxed {
    fn scale(local/1/17: Boxed, local/1/18: i32) -> Boxed {
        Boxed { value: self/17.value * factor/18 }
    }
  }

  impl Inspect for Boxed {
    fn inspect(local/1/19: Boxed) -> string {
        "[" + self/19.value.to_string() + "]"
    }
  }

  fn bool_text(local/1/20: bool) -> string {
      if x/20 {
          "true"
      } else {
          "false"
      }
  }

  fn show_both[T: Debug + Display](local/1/21: T) -> string {
      Debug::show(x/21) + " / " + Display::show(x/21)
  }

  fn tag_text[Q: Debug + MyHash](local/1/22: Q) -> string {
      Debug::show(tag/22) + "#" + tag/22.hash().to_string()
  }

  fn combine_scaled[T: Add + Scale](local/1/23: T, local/1/24: T, local/1/25: i32) -> T {
      a/23.add(b/24).scale(factor/25)
  }

  fn report_pair[T: Debug + Display + MyEq + MyHash, Q: Debug + MyHash](
    local/1/26: Q,
    local/1/27: T,
    local/1/28: T,
    local/1/29: T
  ) -> string {
      let local/1/30 = MyEq::eq(a/27, b/28);
      let local/1/31 = def/1/24(tag/26);
      let local/1/32 = def/1/23(combined/29);
      let local/1/33 = combined/29.hash();
      header/31 + " " + repr/32 + " | eq=" + def/1/22(same/30) + " | hash=" + h/33.to_string()
  }

  fn full_report[T: Debug + MyHash + Display + MyEq + Add + Scale + Debug, Q: Debug + MyHash](
    local/1/34: Q,
    local/1/35: T,
    local/1/36: T
  ) -> string {
      let local/1/37 = def/1/25(a/35, b/36, 2);
      def/1/26(tag/34, a/35, b/36, combined/37)
  }

  fn sum_and_tag[T: Add + MyHash + Inspect, Q: Debug + MyHash](
    local/1/38: Q,
    local/1/39: T,
    local/1/40: T,
    local/1/41: T
  ) -> string {
      let local/1/42 = x/39.add(y/40).add(z/41);
      let local/1/43 = def/1/24(tag/38);
      let local/1/44 = total/42.hash();
      header/43 + " " + total/42.inspect() + " @" + h/44.to_string()
  }

  fn main() {
      let local/1/45: i32 = 7;
      let local/1/46: i32 = 10;
      let local/1/47: i32 = 32;
      let local/1/48: i32 = 0;
      let local/1/49: i32 = 1;
      let local/1/50: i32 = 2;
      let local/1/51: i32 = 3;
      let _ = println(def/1/27(tag/45, left/46, right/47));
      let _ = println(def/1/27(Boxed { value: 99 }, Boxed { value: 3 }, Boxed { value: 4 }));
      let _ = println(def/1/28(sum_tag/48, first/49, second/50, third/51));
      let _ =
        println(
          def/1/28(Boxed { value: 1 }, Boxed { value: 5 }, Boxed { value: 6 }, Boxed { value: 7 })
        );
  }