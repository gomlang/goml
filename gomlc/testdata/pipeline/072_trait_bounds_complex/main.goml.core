fn bool_text(x/0: bool) -> string {
  if x/0 {
      {
        "true"
      }
  } else {
      {
        "false"
      }
  }
}

fn show_both[T](x/0: T) -> string {
  ((trait_call[Debug::show](x/0) + " / ") + trait_call[Display::show](x/0))
}

fn tag_text[Q](tag/0: Q) -> string {
  ((trait_call[Debug::show](tag/0) + "#") +
    inherent#i32#i32#to_string(trait_call[MyHash::hash](tag/0)))
}

fn combine_scaled[T](a/0: T, b/0: T, factor/0: i32) -> T {
  trait_call[Scale::scale](trait_call[Add::add](a/0, b/0), factor/0)
}

fn report_pair[T, Q](tag/0: Q, a/0: T, b/0: T, combined/0: T) -> string {
  let same/0 = trait_call[MyEq::eq](a/0, b/0) in
  let header/0 = tag_text(tag/0) in
  let repr/0 = show_both(combined/0) in
  let h/0 = trait_call[MyHash::hash](combined/0) in
  (((header/0 + " ") + repr/0) +
    ((" | eq=" + bool_text(same/0)) + (" | hash=" + inherent#i32#i32#to_string(h/0))))
}

fn full_report[T, Q](tag/0: Q, a/0: T, b/0: T) -> string {
  let combined/0 = combine_scaled(a/0, b/0, 2) in
  report_pair(tag/0, a/0, b/0, combined/0)
}

fn sum_and_tag[T, Q](tag/0: Q, x/0: T, y/0: T, z/0: T) -> string {
  let total/0 = trait_call[Add::add](trait_call[Add::add](x/0, y/0), z/0) in
  let header/0 = tag_text(tag/0) in
  let h/0 = trait_call[MyHash::hash](total/0) in
  (((header/0 + " ") + trait_call[Inspect::inspect](total/0)) +
    (" @" + inherent#i32#i32#to_string(h/0)))
}

