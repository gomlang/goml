impl Display for i32 {
  fn show(self/0: i32) -> string {
      (i32::to_string : (i32) -> string)((self/0 : i32))
  }
}

impl Debug for i32 {
  fn show(self/1: i32) -> string {
      "i32(" + (i32::to_string : (i32) -> string)((self/1 : i32)) + ")"
  }
}

impl MyEq for i32 {
  fn eq(self/2: i32, other/3: i32) -> bool {
      (self/2 : i32) == (other/3 : i32)
  }
}

impl MyHash for i32 {
  fn hash(self/4: i32) -> i32 {
      (self/4 : i32) * 16777619 + 216613626
  }
}

impl Add for i32 {
  fn add(self/5: i32, other/6: i32) -> i32 {
      (self/5 : i32) + (other/6 : i32)
  }
}

impl Scale for i32 {
  fn scale(self/7: i32, factor/8: i32) -> i32 {
      (self/7 : i32) * (factor/8 : i32)
  }
}

impl Inspect for i32 {
  fn inspect(self/9: i32) -> string {
      "<" + (i32::to_string : (i32) -> string)((self/9 : i32)) + ">"
  }
}

impl Display for Boxed {
  fn show(self/10: Boxed) -> string {
      "Boxed(" + (i32::to_string : (i32) -> string)((self/10 : Boxed).value) + ")"
  }
}

impl Debug for Boxed {
  fn show(self/11: Boxed) -> string {
      "Boxed{value=" + (i32::to_string : (i32) -> string)((self/11 : Boxed).value) + "}"
  }
}

impl MyEq for Boxed {
  fn eq(self/12: Boxed, other/13: Boxed) -> bool {
      (self/12 : Boxed).value == (other/13 : Boxed).value
  }
}

impl MyHash for Boxed {
  fn hash(self/14: Boxed) -> i32 {
      (self/14 : Boxed).value * 31 + 7 * 1315423911
  }
}

impl Add for Boxed {
  fn add(self/15: Boxed, other/16: Boxed) -> Boxed {
      Boxed { value: (self/15 : Boxed).value + (other/16 : Boxed).value }
  }
}

impl Scale for Boxed {
  fn scale(self/17: Boxed, factor/18: i32) -> Boxed {
      Boxed { value: (self/17 : Boxed).value * (factor/18 : i32) }
  }
}

impl Inspect for Boxed {
  fn inspect(self/19: Boxed) -> string {
      "[" + (i32::to_string : (i32) -> string)((self/19 : Boxed).value) + "]"
  }
}

fn bool_text(x/20: bool) -> string {
    if (x/20 : bool) {
        {
            "true"
        }
    } else {
        {
            "false"
        }
    }
}

fn show_both[T](x/21: T) -> string where T: Debug, T: Display {
    (Debug::show : (T) -> string)((x/21 : T)) + " / " + (Display::show : (T) -> string)((x/21 : T))
}

fn tag_text[Q](tag/22: Q) -> string where Q: Debug, Q: MyHash {
    (Debug::show : (Q) -> string)((tag/22 : Q)) + "#" +
      (i32::to_string : (i32) -> string)((MyHash::hash : (Q) -> i32)((tag/22 : Q)))
}

fn combine_scaled[T](a/23: T, b/24: T, factor/25: i32) -> T where T: Add, T: Scale {
    (Scale::scale : (T, i32) -> T)(
      (Add::add : (T, T) -> T)((a/23 : T), (b/24 : T)),
      (factor/25 : i32)
    )
}

fn report_pair[T, Q](tag/26: Q, a/27: T, b/28: T, combined/29: T) -> string where
  T: Debug,
  T: Display,
  T: MyEq,
  T: MyHash,
  Q: Debug,
  Q: MyHash {
    let same/30: bool = (MyEq::eq : (T, T) -> bool)((a/27 : T), (b/28 : T));
    let header/31: string = (tag_text : (Q) -> string)((tag/26 : Q));
    let repr/32: string = (show_both : (T) -> string)((combined/29 : T));
    let h/33: i32 = (MyHash::hash : (T) -> i32)((combined/29 : T));
    (header/31 : string) + " " + (repr/32 : string) +
      " | eq=" + (bool_text : (bool) -> string)((same/30 : bool)) +
        " | hash=" + (i32::to_string : (i32) -> string)((h/33 : i32))
}

fn full_report[T, Q](tag/34: Q, a/35: T, b/36: T) -> string where
  T: Debug,
  T: MyHash,
  T: Display,
  T: MyEq,
  T: Add,
  T: Scale,
  Q: Debug,
  Q: MyHash {
    let combined/37: T = (combine_scaled : (T, T, i32) -> T)((a/35 : T), (b/36 : T), 2);
    (report_pair : (Q, T, T, T) -> string)((tag/34 : Q), (a/35 : T), (b/36 : T), (combined/37 : T))
}

fn sum_and_tag[T, Q](tag/38: Q, x/39: T, y/40: T, z/41: T) -> string where
  T: Add,
  T: MyHash,
  T: Inspect,
  Q: Debug,
  Q: MyHash {
    let total/42: T =
      (Add::add : (T, T) -> T)((Add::add : (T, T) -> T)((x/39 : T), (y/40 : T)), (z/41 : T));
    let header/43: string = (tag_text : (Q) -> string)((tag/38 : Q));
    let h/44: i32 = (MyHash::hash : (T) -> i32)((total/42 : T));
    (header/43 : string) + " " + (Inspect::inspect : (T) -> string)((total/42 : T)) +
      " @" + (i32::to_string : (i32) -> string)((h/44 : i32))
}

fn main() -> () {
    let tag/45: i32 = 7;
    let left/46: i32 = 10;
    let right/47: i32 = 32;
    let sum_tag/48: i32 = 0;
    let first/49: i32 = 1;
    let second/50: i32 = 2;
    let third/51: i32 = 3;
    let _ : () =
      (println : (string) -> ())(
        (full_report : (i32, i32, i32) -> string)((tag/45 : i32), (left/46 : i32), (right/47 : i32))
      );
    let _ : () =
      (println : (string) -> ())(
        (full_report : (Boxed, Boxed, Boxed) -> string)(
          Boxed { value: 99 },
          Boxed { value: 3 },
          Boxed { value: 4 }
        )
      );
    let _ : () =
      (println : (string) -> ())(
        (sum_and_tag : (i32, i32, i32, i32) -> string)(
          (sum_tag/48 : i32),
          (first/49 : i32),
          (second/50 : i32),
          (third/51 : i32)
        )
      );
    let _ : () =
      (println : (string) -> ())(
        (sum_and_tag : (Boxed, Boxed, Boxed, Boxed) -> string)(
          Boxed { value: 1 },
          Boxed { value: 5 },
          Boxed { value: 6 },
          Boxed { value: 7 }
        )
      );
}