package main;
trait Display {
  fn show(self: Self) -> string;
}

trait Debug {
  fn show(self: Self) -> string;
}

trait MyEq {
  fn eq(self: Self, arg1: Self) -> bool;
}

trait MyHash {
  fn hash(self: Self) -> i32;
}

trait Add {
  fn add(self: Self, arg1: Self) -> Self;
}

trait Scale {
  fn scale(self: Self, arg1: i32) -> Self;
}

trait Inspect {
  fn inspect(self: Self) -> string;
}

struct Boxed {
    value: i32,
}

impl Display for i32 {
  fn show(self: i32) -> string {
      self.to_string()
  }
}

impl Debug for i32 {
  fn show(self: i32) -> string {
      "i32(" + self.to_string() + ")"
  }
}

impl MyEq for i32 {
  fn eq(self: i32, other: i32) -> bool {
      self == other
  }
}

impl MyHash for i32 {
  fn hash(self: i32) -> i32 {
      self * 16777619 + 216613626
  }
}

impl Add for i32 {
  fn add(self: i32, other: i32) -> i32 {
      self + other
  }
}

impl Scale for i32 {
  fn scale(self: i32, factor: i32) -> i32 {
      self * factor
  }
}

impl Inspect for i32 {
  fn inspect(self: i32) -> string {
      "<" + self.to_string() + ">"
  }
}

impl Display for Boxed {
  fn show(self: Boxed) -> string {
      "Boxed(" + self.value.to_string() + ")"
  }
}

impl Debug for Boxed {
  fn show(self: Boxed) -> string {
      "Boxed{value=" + self.value.to_string() + "}"
  }
}

impl MyEq for Boxed {
  fn eq(self: Boxed, other: Boxed) -> bool {
      self.value == other.value
  }
}

impl MyHash for Boxed {
  fn hash(self: Boxed) -> i32 {
      self.value * 31 + 7 * 1315423911
  }
}

impl Add for Boxed {
  fn add(self: Boxed, other: Boxed) -> Boxed {
      Boxed { value: self.value + other.value }
  }
}

impl Scale for Boxed {
  fn scale(self: Boxed, factor: i32) -> Boxed {
      Boxed { value: self.value * factor }
  }
}

impl Inspect for Boxed {
  fn inspect(self: Boxed) -> string {
      "[" + self.value.to_string() + "]"
  }
}

fn bool_text(x: bool) -> string {
    if x {
        {
            "true"
        }
    } else {
        {
            "false"
        }
    }
}

fn show_both[T: Debug + Display](x: T) -> string {
    Debug::show(x) + " / " + Display::show(x)
}

fn tag_text[Q: Debug + MyHash](tag: Q) -> string {
    Debug::show(tag) + "#" + tag.hash().to_string()
}

fn combine_scaled[T: Add + Scale](a: T, b: T, factor: i32) -> T {
    a.add(b).scale(factor)
}

fn report_pair[T: Debug + Display + MyEq + MyHash, Q: Debug + MyHash](
  tag: Q,
  a: T,
  b: T,
  combined: T
) -> string {
    let same = MyEq::eq(a, b);
    let header = tag_text(tag);
    let repr = show_both(combined);
    let h = combined.hash();
    header + " " + repr + " | eq=" + bool_text(same) + " | hash=" + h.to_string()
}

fn full_report[T: Debug + MyHash + Display + MyEq + Add + Scale + Debug, Q: Debug + MyHash](
  tag: Q,
  a: T,
  b: T
) -> string {
    let combined = combine_scaled(a, b, 2);
    report_pair(tag, a, b, combined)
}

fn sum_and_tag[T: Add + MyHash + Inspect, Q: Debug + MyHash](tag: Q, x: T, y: T, z: T) -> string {
    let total = x.add(y).add(z);
    let header = tag_text(tag);
    let h = total.hash();
    header + " " + total.inspect() + " @" + h.to_string()
}

fn main() {
    let tag: i32 = 7;
    let left: i32 = 10;
    let right: i32 = 32;
    let sum_tag: i32 = 0;
    let first: i32 = 1;
    let second: i32 = 2;
    let third: i32 = 3;
    let _ = println(full_report(tag, left, right));
    let _ = println(full_report(Boxed { value: 99 }, Boxed { value: 3 }, Boxed { value: 4 }));
    let _ = println(sum_and_tag(sum_tag, first, second, third));
    let _ =
      println(
        sum_and_tag(Boxed { value: 1 }, Boxed { value: 5 }, Boxed { value: 6 }, Boxed { value: 7 })
      );
}

