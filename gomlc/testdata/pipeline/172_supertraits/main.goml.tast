impl[T] Parent[T] for Box[T] {
  fn parent(self/0: Box[T]) -> T {
      (self/0 : Box[T]).value
  }
}

impl[T] Render for Box[T] {
  fn render(self/1: Box[T]) -> string {
      ":render"
  }
}

impl[T] Child[T] for Box[T] where T: ToString, T: Eq, T: PartialEq {
  fn child(self/2: Box[T]) -> string {
      ":child"
  }
}

fn describe[T, B](value/3: B) -> string where
  B: Child[T],
  T: ToString,
  T: Eq,
  B: Parent[T],
  B: Render,
  T: PartialEq {
    (ToString::to_string : (T) -> string)((Parent[T]::parent : (B) -> T)((value/3 : B))) +
      (Render::render : (B) -> string)((value/3 : B)) +
      (Child[T]::child : (B) -> string)((value/3 : B))
}

fn main() -> () {
    (println : (string) -> ())((describe::[isize] : (Box[isize]) -> string)(Box { value: 5 }));
    let value/4: Box[i32] = Box { value: 6 };
    (println : (string) -> ())(
      (i32::to_string : (i32) -> string)(
        (Parent[i32]::parent : (Box[i32]) -> i32)((value/4 : Box[i32]))
      )
    )
}