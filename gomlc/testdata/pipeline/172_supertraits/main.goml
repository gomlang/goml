trait Render {
    fn render(self: Self) -> string;
}

trait Parent[T] {
    fn parent(self: Self) -> T;
}

trait Child[T: ToString]: Parent[T] + Render where T: Eq {
    fn child(self: Self) -> string;
}

struct Box[T] {
    value: T,
}

impl[T] Parent[T]for Box[T] {
    fn parent(self: Box[T]) -> T {
        self.value
    }
}

impl[T] Render for Box[T] {
    fn render(self: Box[T]) -> string {
        ":render"
    }
}

impl[T: ToString + Eq] Child[T]for Box[T] {
    fn child(self: Box[T]) -> string {
        ":child"
    }
}

fn describe[T, B: Child[T]](value: B) -> string {
    value.parent().to_string() + value.render() + value.child()
}

fn main() -> () {
    println(describe(Box { value: 5 }));
    let value: Box[i32] = Box { value: 6 };
    println(Child::[i32]::parent(value).to_string())
}
