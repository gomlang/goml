package main
file main.goml
  trait Render {
    fn render(Self) -> string;
  }

  trait Parent[T] {
    fn parent(Self) -> T;
  }

  trait Child[T: ToString]: Parent[T] + Render where T: Eq {
    fn child(Self) -> string;
  }

  struct Box[T] {
      value: T,
  }

  impl[T] Parent[T] for Box[T] {
    fn parent(local/1/0: Box[T]) -> T {
        self/0.value
    }
  }

  impl[T] Render for Box[T] {
    fn render(local/1/1: Box[T]) -> string {
        ":render"
    }
  }

  impl[T: ToString + Eq] Child[T] for Box[T] {
    fn child(local/1/2: Box[T]) -> string {
        ":child"
    }
  }

  fn describe[T, B: Child[T]](local/1/3: B) -> string {
      value/3.parent().to_string() + value/3.render() + value/3.child()
  }

  fn main() -> () {
      println(def/1/7(Box { value: 5 }));
      let local/1/4: Box[i32] = Box { value: 6 };
      println(Child[i32]::parent(value/4).to_string())
  }