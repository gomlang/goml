fn check_utf8(bytes: Vec[byte], expected: bool) -> () {
    let expected_length = bytes.len();
    let (valid, value) = string_from_utf8(bytes);
    println(valid == expected);
    if valid {
        println(value.byte_len() == expected_length)
    } else {
        println(value == "")
    }
}

fn check_scalar(bytes: Vec[byte], expected: u32, expected_width: isize) -> () {
    let (valid, value) = string_from_utf8(bytes);
    println(valid);
    match value.decode_at(0) {
        Some(decoded) => {
            let (character, width) = decoded;
            println(character.to_u32() == expected);
            println(width == expected_width)
        },
        None => {
            println(false);
            println(false)
        },
    }
}

fn main() -> () {
    check_utf8(Vec::new(), true);
    check_utf8(Vec::from_array([0]), true);
    check_utf8(Vec::from_array([127]), true);
    check_scalar(Vec::from_array([194, 128]), 128, 2);
    check_scalar(Vec::from_array([223, 191]), 2047, 2);
    check_scalar(Vec::from_array([224, 160, 128]), 2048, 3);
    check_scalar(Vec::from_array([237, 159, 191]), 55295, 3);
    check_scalar(Vec::from_array([238, 128, 128]), 57344, 3);
    check_scalar(Vec::from_array([239, 191, 189]), 65533, 3);
    check_scalar(Vec::from_array([239, 191, 191]), 65535, 3);
    check_scalar(Vec::from_array([240, 144, 128, 128]), 65536, 4);
    check_scalar(Vec::from_array([244, 143, 191, 191]), 1114111, 4);
    check_utf8(Vec::from_array([128]), false);
    check_utf8(Vec::from_array([191]), false);
    check_utf8(Vec::from_array([192, 128]), false);
    check_utf8(Vec::from_array([193, 191]), false);
    check_utf8(Vec::from_array([194]), false);
    check_utf8(Vec::from_array([194, 127]), false);
    check_utf8(Vec::from_array([224, 159, 191]), false);
    check_utf8(Vec::from_array([225, 128]), false);
    check_utf8(Vec::from_array([225, 128, 127]), false);
    check_utf8(Vec::from_array([237, 160, 128]), false);
    check_utf8(Vec::from_array([240, 143, 191, 191]), false);
    check_utf8(Vec::from_array([240, 144, 128]), false);
    check_utf8(Vec::from_array([244, 144, 128, 128]), false);
    check_utf8(Vec::from_array([245, 128, 128, 128]), false)
}
