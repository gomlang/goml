package main;
enum List[T] {
    Nil,
    Cons(T, List[T])
}

fn prepend_with(make: (i32, List[i32]) -> List[i32], value: i32, values: List[i32]) -> List[i32] {
    make(value, values)
}

fn sum(values: List[i32]) -> i32 {
    match values {
        List::Nil => 0,
        List::Cons(value, rest) => value + sum(rest),
    }
}

fn main() -> () {
    let cons: (i32, List[i32]) -> List[i32] = List::Cons;
    let values = prepend_with(cons, 1, prepend_with(cons, 2, List::Nil));
    println(sum(values).to_string())
}

