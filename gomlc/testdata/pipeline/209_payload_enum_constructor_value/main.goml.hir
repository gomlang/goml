package main
file main.goml
  enum List[T] {
      Nil,
      Cons(T, List[T])
  }

  fn prepend_with(
    local/1/0: (i32, List[i32]) -> List[i32],
    local/1/1: i32,
    local/1/2: List[i32]
  ) -> List[i32] {
      make/0(value/1, values/2)
  }

  fn sum(local/1/3: List[i32]) -> i32 {
      match values/3 {
          ctor(def/1/0::v0) => 0,
          ctor(def/1/0::v1)(local/1/4, local/1/5) => value/4 + def/1/2(rest/5),
      }
  }

  fn main() -> () {
      let local/1/6: (i32, List[i32]) -> List[i32] = ctor(def/1/0::v1);
      let local/1/7 = def/1/1(cons/6, 1, def/1/1(cons/6, 2, ctor(def/1/0::v0)));
      println(def/1/2(values/7).to_string())
  }