package main
file main.goml
  enum List[T] {
      Nil,
      Cons(T, List[T])
  }

  fn prepend_with(
    local/main/0: (i32, List[i32]) -> List[i32],
    local/main/1: i32,
    local/main/2: List[i32]
  ) -> List[i32] {
      make/0(value/1, values/2)
  }

  fn sum(local/main/3: List[i32]) -> i32 {
      match values/3 {
          ctor(source:4:main:0::v0) => 0,
          ctor(source:4:main:0::v1)(local/main/4, local/main/5) =>
            value/4 + source:4:main:2(rest/5),
      }
  }

  fn main() -> () {
      let local/main/6: (i32, List[i32]) -> List[i32] = ctor(source:4:main:0::v1);
      let local/main/7 =
        source:4:main:1(cons/6, 1, source:4:main:1(cons/6, 2, ctor(source:4:main:0::v0)));
      println(source:4:main:2(values/7).to_string())
  }