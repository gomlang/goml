fn prepend_with(make/0: (i32, List[i32]) -> List[i32], value/1: i32, values/2: List[i32]) -> List[
  i32
] {
    (make/0 : (i32, List[i32]) -> List[i32])((value/1 : i32), (values/2 : List[i32]))
}

fn sum(values/3: List[i32]) -> i32 {
    match (values/3 : List[i32]) {
        List::Nil => 0,
        List::Cons(value/4: i32, rest/5: List[i32]) =>
          (value/4 : i32) + (sum : (List[i32]) -> i32)((rest/5 : List[i32])),
    }
}

fn main() -> () {
    let cons/6: (i32, List[i32]) -> List[i32] =
      |ctor_arg_0: i32, ctor_arg_1: List[i32]| =>
        List::Cons((ctor_arg_0 : i32), (ctor_arg_1 : List[i32]));
    let values/7: List[i32] =
      (prepend_with : ((i32, List[i32]) -> List[i32], i32, List[i32]) -> List[i32])(
        (cons/6 : (i32, List[i32]) -> List[i32]),
        1,
        (prepend_with : ((i32, List[i32]) -> List[i32], i32, List[i32]) -> List[i32])(
          (cons/6 : (i32, List[i32]) -> List[i32]),
          2,
          List::Nil
        )
      );
    (println : (string) -> ())(
      (i32::to_string : (i32) -> string)((sum : (List[i32]) -> i32)((values/7 : List[i32])))
    )
}