package main;
trait Display {
  fn show(self: Self) -> string;
}

impl Display for i32 {
  fn show(self: i32) -> string {
      self.to_string()
  }
}

enum Boxed {
    One(dyn Display)
}

fn build() -> i32 {
    let _: Boxed = Boxed::One(return 9);
    0
}

fn main() -> () {
    println(build().to_string())
}

