package main
file main.goml
  fn signed_sum(
    local/main/0: i8,
    local/main/1: i16,
    local/main/2: i32,
    local/main/3: i64,
    local/main/4: isize
  ) -> isize {
      first/0.to_isize() + second/1.to_isize() + third/2.to_isize() + fourth/3.to_isize() + fifth/4
  }

  fn unsigned_sum(
    local/main/5: u8,
    local/main/6: u16,
    local/main/7: u32,
    local/main/8: u64,
    local/main/9: usize
  ) -> usize {
      first/5.to_usize() + second/6.to_usize() + third/7.to_usize() + fourth/8.to_usize() + fifth/9
  }

  fn main() -> () {
      let local/main/10: f32 = 1.5;
      let local/main/11: f64 = 2.25;
      let local/main/12: byte = b'\x41';
