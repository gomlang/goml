package main
file main.goml
  fn signed_sum(
    local/1/0: i8,
    local/1/1: i16,
    local/1/2: i32,
    local/1/3: i64,
    local/1/4: isize
  ) -> isize {
      first/0.to_isize() + second/1.to_isize() + third/2.to_isize() + fourth/3.to_isize() + fifth/4
  }

  fn unsigned_sum(
    local/1/5: u8,
    local/1/6: u16,
    local/1/7: u32,
    local/1/8: u64,
    local/1/9: usize
  ) -> usize {
      first/5.to_usize() + second/6.to_usize() + third/7.to_usize() + fourth/8.to_usize() + fifth/9
  }

  fn main() -> () {
      let local/1/10: f32 = 1.5;
