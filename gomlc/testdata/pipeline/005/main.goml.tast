fn main() -> () {
    let a/0: (Color, Color) = (Color::Blue, Color::Red);
    match (a/0 : (Color, Color)) {
        (Color::Red, Color::Green) => (print : (isize) -> ())(0),
        (Color::Red, Color::Red) => (print : (isize) -> ())(1),
        (Color::Blue, Color::Blue) => (print : (isize) -> ())(2),
        _ : (Color, Color) => (print : (isize) -> ())(3),
    }
}