package main
file main.goml
  fn grandparent_continue() -> isize {
      let local/1/0 = Ref::new(0);
      'outer: loop {
          rounds/0.set(rounds/0.get() + 1);
          if rounds/0.get() == 2 {
              break 'outer rounds/0.get()
          } else {
              loop {
                  loop {
                      if rounds/0.get() == 1 {
                          continue 'outer
                      } else {
                          continue
                      }
                  }
              }
          }
      }
  }

  fn mixed_self_local_and_ancestor() -> isize {
      let local/1/1 = Ref::new(0);
      let local/1/2 = Ref::new(0);
      'outer: loop {
          rounds/1.set(rounds/1.get() + 1);
          steps/2.set(0);
          loop {
              steps/2.set(steps/2.get() + 1);
              if rounds/1.get() == 1 && steps/2.get() == 1 {
                  continue
              } else if rounds/1.get() == 1 {
                  continue 'outer
              } else {
                  break
              }
          };
          break 'outer rounds/1.get() * 10 + steps/2.get()
      }
  }

  fn grandparent_while_continue() -> isize {
      let local/1/3 = Ref::new(0);
      'outer: while rounds/3.get() < 3 {
          {
              rounds/3.set(rounds/3.get() + 1);
              loop {
                  loop {
                      continue 'outer
                  }
              }
          }
      };
      rounds/3.get()
  }

  fn main() -> () {
      println(def/1/0());
      println(def/1/1());
      println(def/1/2())
  }