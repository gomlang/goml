fn unwrap_either(value/0: Either) -> i32 {
    match (value/0 : Either) {
        whole/1 @ (Either::Left(shared/2: i32) | Either::Right(shared/2: i32)) =>
          (shared/2 : i32) +
            match (whole/1 : Either) {
                Either::Left(_ : i32) => 0,
                Either::Right(_ : i32) => 1,
            },
    }
}

fn char_group(value/3: char) -> string {
    match (value/3 : char) {
        'a'..='c' => "abc",
        _ : char => "other",
    }
}

fn describe(value/4: Maybe, numbers/5: Vec[i32], view/6: Slice[i32]) -> string {
    let from_if/9: string =
      match (value/4 : Maybe) {
          Maybe::Some(n/7: i32) =>
            {
                match (n/7 : i32) {
                    0 | 1 => "small",
                    2..=4 => "middle",
                    x/8: i32 if (x/8 : i32) > 10 => "large",
                    _ : i32 => "other",
                }
            },
          _ : Maybe =>
            {
                "none"
            },
      };
    let from_vec/12: string =
      match (numbers/5 : Vec[i32]) {
          [] => "empty",
          [first/10: i32, tail/11 @ ..] if (first/10 : i32) ==
            (isize::to_i32 : (isize) -> i32)(
              (Slice[i32]::len : (Slice[i32]) -> isize)((tail/11 : Slice[i32]))
            ) =>
            "balanced",
          [_ : i32, ..] => "nonempty",
      };
    let from_slice/15: string =
      match (view/6 : Slice[i32]) {
          [first/13: i32, .., last/14: i32] if (first/13 : i32) == (last/14 : i32) => "same ends",
          _ : Slice[i32] => "different ends",
      };
    (from_if/9 : string) + "/" + (from_vec/12 : string) + "/" + (from_slice/15 : string)
}

fn main() -> () {
    let pair/16: Pair = Pair { left: 3, right: 9 };
    let Pair { left: left/17: i32, right: _ : i32 } = (pair/16 : Pair);
    let values/18: [isize; 4] = [1, 2, 3, 1];
    let [first/19: isize, middle/20 @ .., last/21: isize] = (values/18 : [isize; 4]);
    (println : (i32) -> ())((left/17 : i32));
    (println : (isize) -> ())(
      (first/19 : isize) +
        (@intrinsic(array.get) : ([isize; 2], isize) -> isize)((middle/20 : [isize; 2]), 0) +
        (last/21 : isize)
    );
    let numbers/22: Vec[i32] = (@intrinsic(vec.new) : () -> Vec[i32])();
    (@intrinsic(vec.push) : (Vec[i32], i32) -> ())((numbers/22 : Vec[i32]), 1);
    (@intrinsic(vec.push) : (Vec[i32], i32) -> ())((numbers/22 : Vec[i32]), 8);
    let view/23: Slice[i32] =
      (@intrinsic(slice.new) : (Vec[i32], isize, isize) -> Slice[i32])(
        (numbers/22 : Vec[i32]),
        0,
        (Vec[i32]::len : (Vec[i32]) -> isize)((numbers/22 : Vec[i32]))
      );
    (println : (string) -> ())(
      (describe : (Maybe, Vec[i32], Slice[i32]) -> string)(
        Maybe::Some(3),
        (numbers/22 : Vec[i32]),
        (view/23 : Slice[i32])
      )
    );
    let empty/24: Vec[i32] = (@intrinsic(vec.new) : () -> Vec[i32])();
    let empty_view/25: Slice[i32] =
      (@intrinsic(slice.new) : (Vec[i32], isize, isize) -> Slice[i32])((empty/24 : Vec[i32]), 0, 0);
    (println : (string) -> ())(
      (describe : (Maybe, Vec[i32], Slice[i32]) -> string)(
        Maybe::None,
        (empty/24 : Vec[i32]),
        (empty_view/25 : Slice[i32])
      )
    );
    let state/26: Ref[Maybe] = (Ref[Maybe]::new : (Maybe) -> Ref[Maybe])(Maybe::Some(7));
    while true {
        match (Ref[Maybe]::get : (Ref[Maybe]) -> Maybe)((state/26 : Ref[Maybe])) {
            Maybe::Some(n/27: i32) =>
              {
                  (println : (i32) -> ())((n/27 : i32));
                  (Ref[Maybe]::set : (Ref[Maybe], Maybe) -> ())(
                    (state/26 : Ref[Maybe]),
                    Maybe::None
                  );
              },
            _ : Maybe => break,
        }
    };
    match Maybe::Some(6) {
        Maybe::Some(n/28: i32) =>
          {
              (println : (i32) -> ())((n/28 : i32));
          },
        _ : Maybe => (),
    };
    let aliased/32: i32 =
      match Maybe::Some(5) {
          whole/29 @ Maybe::Some(value/30: i32) =>
            (value/30 : i32) +
              match (whole/29 : Maybe) {
                  Maybe::Some(inner/31: i32) => (inner/31 : i32),
                  Maybe::None => 0,
              },
          Maybe::None => 0,
      };
    (println : (i32) -> ())((aliased/32 : i32));
    (println : (i32) -> ())((unwrap_either : (Either) -> i32)(Either::Right(11)));
    (println : (string) -> ())((char_group : (char) -> string)('b'));
}