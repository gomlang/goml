impl Measure for Vec[i32] {
  fn measure(self/0: Vec[i32]) -> isize {
      (Vec[i32]::len : (Vec[i32]) -> isize)((self/0 : Vec[i32]))
  }
}

fn read_measure[T](value/1: T) -> isize where T: Measure {
    (Measure::measure : (T) -> isize)((value/1 : T))
}

fn main() -> () {
    let values/2: Vec[i32] = (@intrinsic(vec.new) : () -> Vec[i32])();
    (println : (string) -> ())(
      (isize::to_string : (isize) -> string)(
        (read_measure : (Vec[i32]) -> isize)((values/2 : Vec[i32]))
      )
    )
}