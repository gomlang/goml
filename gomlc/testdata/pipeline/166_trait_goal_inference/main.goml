trait Measure {
    fn measure(self: Self) -> isize;
}

impl Measure for Vec[i32] {
    fn measure(self: Vec[i32]) -> isize {
        self.len()
    }
}

fn read_measure[T: Measure](value: T) -> isize {
    Measure::measure(value)
}

fn main() -> () {
    let values = vec_new();
    println(read_measure(values).to_string())
}
