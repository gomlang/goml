struct AlwaysDifferent {
    value: i32,
}

impl PartialEq for AlwaysDifferent {
    fn eq(self, other: AlwaysDifferent) -> bool {
        false
    }
}

fn main() -> () {
    let first = AlwaysDifferent { value: 7 };
    let second = AlwaysDifferent { value: 7 };
    println(first == second);
    println(first != second);
    let left_tuple = (AlwaysDifferent { value: 1 }, 2);
    let right_tuple = (AlwaysDifferent { value: 1 }, 2);
    println(left_tuple == right_tuple);
    let left_array = [AlwaysDifferent { value: 1 }, AlwaysDifferent { value: 2 }];
    let right_array = [AlwaysDifferent { value: 1 }, AlwaysDifferent { value: 2 }];
    println(left_array == right_array);
}
