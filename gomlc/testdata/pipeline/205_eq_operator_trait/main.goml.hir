package main
file main.goml
  struct AlwaysDifferent {
      value: i32,
  }

  impl PartialEq for AlwaysDifferent {
    fn eq(local/main/0: AlwaysDifferent, local/main/1: AlwaysDifferent) -> bool {
        false
    }
  }

  fn main() -> () {
      let local/main/2 = AlwaysDifferent { value: 7 };
      let local/main/3 = AlwaysDifferent { value: 7 };
      println(first/2 == second/3);
      println(first/2 != second/3);
      let local/main/4 = (AlwaysDifferent { value: 1 }, 2);
      let local/main/5 = (AlwaysDifferent { value: 1 }, 2);
      println(left_tuple/4 == right_tuple/5);
      let local/main/6 = [AlwaysDifferent { value: 1 }, AlwaysDifferent { value: 2 }];
      let local/main/7 = [AlwaysDifferent { value: 1 }, AlwaysDifferent { value: 2 }];
      println(left_array/6 == right_array/7);
  }