package main
file main.goml
  struct AlwaysDifferent {
      value: i32,
  }

  impl PartialEq for AlwaysDifferent {
    fn eq(local/1/0: AlwaysDifferent, local/1/1: AlwaysDifferent) -> bool {
        false
    }
  }

  fn main() -> () {
      let local/1/2 = AlwaysDifferent { value: 7 };
      let local/1/3 = AlwaysDifferent { value: 7 };
      println(first/2 == second/3);
      println(first/2 != second/3);
      let local/1/4 = (AlwaysDifferent { value: 1 }, 2);
      let local/1/5 = (AlwaysDifferent { value: 1 }, 2);
      println(left_tuple/4 == right_tuple/5);
      let local/1/6 = [AlwaysDifferent { value: 1 }, AlwaysDifferent { value: 2 }];
