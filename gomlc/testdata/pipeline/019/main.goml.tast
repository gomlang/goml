fn make_point() -> Point {
    Point { x: 0, y: 0 }
}

fn flip(point/0: Point) -> Point {
    let Point { x: x/1: i32, y: y/2: i32 } = (point/0 : Point);
    Point { x: (y/2 : i32), y: (x/1 : i32) }
}

fn wrap_int(x/3: i32) -> Wrapper[i32] {
    Wrapper { value: (x/3 : i32) }
}

fn x_add_1(p/4: Point) -> Point {
    let Point { x: x/5: i32, y: y/6: i32 } = (p/4 : Point);
    Point { x: (x/5 : i32) + 1, y: (y/6 : i32) }
}

fn get_x(p/7: Point) -> i32 {
    let Point { x: x/8: i32, y: y/9: i32 } = (p/7 : Point);
    (x/8 : i32)
}

fn get_y(p/10: Point) -> i32 {
    let Point { x: x/11: i32, y: y/12: i32 } = (p/10 : Point);
    (y/12 : i32)
}

fn point32_to_string(p/13: Point) -> string {
    let Point { x: x/14: i32, y: y/15: i32 } = (p/13 : Point);
    "Point { x: " + (i32::to_string : (i32) -> string)((x/14 : i32)) + ", y: " +
      (i32::to_string : (i32) -> string)((y/15 : i32)) +
      "}"
}

fn point32_to_string2(p/16: Point) -> string {
    let Point { x: x/17: i32, y: y/18: i32 } = (p/16 : Point);
    "Point { x: " + (i32::to_string : (i32) -> string)((x/17 : i32)) + ", y: " +
      (i32::to_string : (i32) -> string)((y/18 : i32)) +
      "}"
}

fn point32_to_string3(p/19: Point) -> string {
    let Point { x: x/20: i32, y: y/21: i32 } = (p/19 : Point);
    "Point { x: " + (i32::to_string : (i32) -> string)((x/20 : i32)) + ", y: " +
      (i32::to_string : (i32) -> string)((y/21 : i32)) +
      "}"
}

fn point32_to_string4(p/22: Point) -> string {
    let Point { x: x/23: i32, y: y/24: i32 } = (p/22 : Point);
    "Point { x: " + (i32::to_string : (i32) -> string)((x/23 : i32)) + ", y: " +
      (i32::to_string : (i32) -> string)((y/24 : i32)) +
      "}"
}

fn main() -> () {
    let start/25: Point = (make_point : () -> Point)();
    let _ : () =
      (println : (string) -> ())((point32_to_string : (Point) -> string)((start/25 : Point)));
    let swapped/26: Point = (flip : (Point) -> Point)(Point { x: 1, y: 2 });
    let _ : () =
      (println : (string) -> ())((point32_to_string2 : (Point) -> string)((swapped/26 : Point)));
    let boxed/27: Wrapper[i32] = (wrap_int : (i32) -> Wrapper[i32])(3);
    let point_box/28: Wrapper[Point] = Wrapper { value: (swapped/26 : Point) };
    let a/29: Point = (x_add_1 : (Point) -> Point)((start/25 : Point));
    let _ : () =
      (println : (string) -> ())((point32_to_string3 : (Point) -> string)((a/29 : Point)));
    let a/30: Point = (flip : (Point) -> Point)((x_add_1 : (Point) -> Point)((start/25 : Point)));
    let _ : () =
      (println : (string) -> ())((point32_to_string4 : (Point) -> string)((a/30 : Point)));
}