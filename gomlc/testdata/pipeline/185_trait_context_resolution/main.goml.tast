impl Put[i32] for Target {
  fn put(self/0: Target, value/1: i32) -> string {
      "number:" + (i32::to_string : (i32) -> string)((value/1 : i32))
  }
}

impl Put[string] for Target {
  fn put(self/2: Target, value/3: string) -> string {
      "text:" + (value/3 : string)
  }
}

impl Convert[i32] for Convertible {
  fn convert(self/4: Convertible) -> string {
      "converted"
  }
}

impl Convert[string] for Convertible {
  fn convert(self/5: Convertible) -> i32 {
      7
  }
}

impl Source[i32] for Number {
  fn get(self/6: Number) -> i32 {
      (self/6 : Number).value
  }
}

fn read[T, S](source/7: S) -> T where S: Source[T], S::Item = T {
    (Source[T]::get : (S) -> T)((source/7 : S))
}

impl[S, T] Select[T] for S where S: ItemSource, S::Item = T {
  fn select(self/8: S) -> T {
      (ItemSource::item : (S) -> T)((self/8 : S))
  }
}

impl ItemSource for Selected {
  fn item(self/9: Selected) -> i32 {
      (self/9 : Selected).value
  }
}

fn invoke[T, S](source/10: S) -> T where S: Select[T] {
    (Select[T]::select : (S) -> T)((source/10 : S))
}

fn select_item[S](source/11: S) -> S::Item where S: ItemSource {
    (invoke : (S) -> S::Item)((source/11 : S))
}

fn main() -> () {
    (println : (string) -> ())((Put[i32]::put : (Target, i32) -> string)(Target {}, 3));
    (println : (string) -> ())((Put[string]::put : (Target, string) -> string)(Target {}, "goml"));
    let text/12: string = (Convert[i32]::convert : (Convertible) -> string)(Convertible {});
    let number/13: i32 = (Convert[string]::convert : (Convertible) -> i32)(Convertible {});
    (println : (string) -> ())((text/12 : string));
    (println : (i32) -> ())((number/13 : i32));
    (println : (i32) -> ())((read : (Number) -> i32)(Number { value: 8 }));
    (println : (i32) -> ())((select_item : (Selected) -> i32)(Selected { value: 9 }));
}