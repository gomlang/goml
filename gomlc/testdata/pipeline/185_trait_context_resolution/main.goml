trait Put[T] {
    fn put(self: Self, arg1: T) -> string;
}

struct Target {}

impl Put[i32]for Target {
    fn put(self: Target, value: i32) -> string {
        "number:" + value.to_string()
    }
}

impl Put[string]for Target {
    fn put(self: Target, value: string) -> string {
        "text:" + value
    }
}

trait Convert[T] {
    type Output;
    fn convert(self: Self) -> Self::Output;
}

struct Convertible {}

impl Convert[i32]for Convertible {
    type Output = string;

    fn convert(self: Convertible) -> string {
        "converted"
    }
}

impl Convert[string]for Convertible {
    type Output = i32;

    fn convert(self: Convertible) -> i32 {
        7
    }
}

trait Source[T] where Self::Item = T {
    type Item;
    fn get(self: Self) -> Self::Item;
}

struct Number {
    value: i32,
}

impl Source[i32]for Number {
    type Item = i32;

    fn get(self: Number) -> i32 {
        self.value
    }
}

fn read[T, S: Source[T]](source: S) -> T {
    Source::[T]::get(source)
}

trait ItemSource {
    type Item;
    fn item(self: Self) -> Self::Item;
}

trait Select[T] {
    fn select(self: Self) -> T;
}

impl[S: ItemSource, T] Select[T]for S where S::Item = T  {
    fn select(self: S) -> T {
        ItemSource::item(self)
    }
}

struct Selected {
    value: i32,
}

impl ItemSource for Selected {
    type Item = i32;

    fn item(self: Selected) -> i32 {
        self.value
    }
}

fn invoke[T, S: Select[T]](source: S) -> T {
    source.select()
}

fn select_item[S: ItemSource](source: S) -> S::Item {
    invoke(source)
}

fn main() -> () {
    println((Target {}).put(3));
    println((Target {}).put("goml"));
    let text: string = (Convertible {}).convert();
    let number: i32 = (Convertible {}).convert();
    println(text);
    println(number);
    println(read(Number { value: 8 }));
    println(select_item(Selected { value: 9 }));
}
