impl Provider for Number {
  fn get(self/0: Number) -> i32 {
      (self/0 : Number).value
  }
}

impl[T] Provider for Box[T] where T: ToString {
  fn get(self/1: Box[T]) -> T {
      (self/1 : Box[T]).value
  }
}

fn read[P](provider/2: P) -> P::Item where P: Provider, P::Item: ToString {
    (Provider::get : (P) -> P::Item)((provider/2 : P))
}

fn read_as[P, T](provider/3: P) -> T where P: Provider, P::Item = T, P::Item: ToString {
    (Provider::get : (P) -> T)((provider/3 : P))
}

fn main() -> () {
    (println : (string) -> ())(
      (i32::to_string : (i32) -> string)((read : (Number) -> i32)(Number { value: 42 }))
    );
    let value/4: i32 = (read_as : (Number) -> i32)(Number { value: 7 });
    (println : (string) -> ())((i32::to_string : (i32) -> string)((value/4 : i32)));
    (println : (string) -> ())((read : (Box[string]) -> string)(Box { value: "generic" }));
    (println : (string) -> ())(
      (i32::to_string : (i32) -> string)((Provider::get : (Number) -> i32)(Number { value: 11 }))
    )
}