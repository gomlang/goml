trait Provider {
    type Item: ToString;
    fn get(self: Self) -> Self::Item;
}

struct Number {
    value: i32,
}

struct Box[T] {
    value: T,
}

impl Provider for Number {
    type Item = i32;

    fn get(self: Number) -> i32 {
        self.value
    }
}

impl[T: ToString] Provider for Box[T] {
    type Item = T;

    fn get(self: Box[T]) -> T {
        self.value
    }
}

fn read[P: Provider](provider: P) -> P::Item {
    provider.get()
}

fn read_as[P, T](provider: P) -> T where P: Provider, P::Item = T {
    provider.get()
}

fn main() -> () {
    println(read(Number { value: 42 }).to_string());
    let value: i32 = read_as(Number { value: 7 });
    println(value.to_string());
    println(read(Box { value: "generic" }));
    println(Provider::get(Number { value: 11 }).to_string())
}
