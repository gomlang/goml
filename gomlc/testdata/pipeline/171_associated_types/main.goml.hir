package main
file main.goml
  trait Provider {
    type Item: ToString;
    fn get(Self) -> Self::Item;
  }

  struct Number {
      value: i32,
  }

  struct Box[T] {
      value: T,
  }

  impl Provider for Number {
    type Item = i32;
    fn get(local/1/0: Number) -> i32 {
        self/0.value
    }
  }

  impl[T: ToString] Provider for Box[T] {
    type Item = T;
    fn get(local/1/1: Box[T]) -> T {
        self/1.value
    }
  }

  fn read[P: Provider](local/1/2: P) -> P::Item {
      provider/2.get()
  }

  fn read_as[P, T](local/1/3: P) -> T where P: Provider, P::Item = T {
      provider/3.get()
  }

  fn main() -> () {
      println(def/1/5(Number { value: 42 }).to_string());
      let local/1/4: i32 = def/1/6(Number { value: 7 });
      println(value/4.to_string());
      println(def/1/5(Box { value: "generic" }));
      println(Provider::get(Number { value: 11 }).to_string())
  }