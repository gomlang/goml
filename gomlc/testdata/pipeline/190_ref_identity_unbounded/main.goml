struct Node {
    value: i32,
}

fn print_lookup(map: HashMap[Ref[Node], string], key: Ref[Node]) -> () {
    match map.get(key) {
        Option::Some(value) => println(value),
        Option::None => println("missing"),
    }
}

fn main() {
    let first = Ref::new(Node { value: 1 });
    let alias = first;
    let distinct = Ref::new(Node { value: 1 });
    println(PartialEq::eq(first, alias));
    println(PartialEq::eq(first, distinct));
    println(Hash::hash(first) == Hash::hash(alias));
    let map: HashMap[Ref[Node], string] = HashMap::new();
    map.set(first, "first");
    print_lookup(map, alias);
    print_lookup(map, distinct);
    first.set(Node { value: 2 });
    print_lookup(map, first);
    map.set(distinct, "distinct");
    println(map.len());
    print_lookup(map, first);
    print_lookup(map, distinct)
}
