fn print_lookup(map/0: HashMap[Ref[Node], string], key/1: Ref[Node]) -> () {
    match (HashMap[Ref[Node], string]::get : (HashMap[Ref[Node], string], Ref[Node]) -> Option[
      string
    ])((map/0 : HashMap[Ref[Node], string]), (key/1 : Ref[Node])) {
        Option::Some(value/2: string) => (println : (string) -> ())((value/2 : string)),
        Option::None => (println : (string) -> ())("missing"),
    }
}

fn main() -> () {
    let first/3: Ref[Node] = (Ref[Node]::new : (Node) -> Ref[Node])(Node { value: 1 });
    let alias/4: Ref[Node] = (first/3 : Ref[Node]);
    let distinct/5: Ref[Node] = (Ref[Node]::new : (Node) -> Ref[Node])(Node { value: 1 });
    (println : (bool) -> ())(
      (PartialEq::eq : (Ref[Node], Ref[Node]) -> bool)((first/3 : Ref[Node]), (alias/4 : Ref[Node]))
    );
    (println : (bool) -> ())(
      (PartialEq::eq : (Ref[Node], Ref[Node]) -> bool)(
        (first/3 : Ref[Node]),
        (distinct/5 : Ref[Node])
      )
    );
    (println : (bool) -> ())(
      (Hash::hash : (Ref[Node]) -> u64)((first/3 : Ref[Node])) ==
        (Hash::hash : (Ref[Node]) -> u64)((alias/4 : Ref[Node]))
    );
    let map/6: HashMap[Ref[Node], string] =
      (HashMap[Ref[Node], string]::new : () -> HashMap[Ref[Node], string])();
    (HashMap[Ref[Node], string]::set : (HashMap[Ref[Node], string], Ref[Node], string) -> ())(
      (map/6 : HashMap[Ref[Node], string]),
      (first/3 : Ref[Node]),
      "first"
    );
    (print_lookup : (HashMap[Ref[Node], string], Ref[Node]) -> ())(
      (map/6 : HashMap[Ref[Node], string]),
      (alias/4 : Ref[Node])
    );
    (print_lookup : (HashMap[Ref[Node], string], Ref[Node]) -> ())(
      (map/6 : HashMap[Ref[Node], string]),
      (distinct/5 : Ref[Node])
    );
    (Ref[Node]::set : (Ref[Node], Node) -> ())((first/3 : Ref[Node]), Node { value: 2 });
    (print_lookup : (HashMap[Ref[Node], string], Ref[Node]) -> ())(
      (map/6 : HashMap[Ref[Node], string]),
      (first/3 : Ref[Node])
    );
    (HashMap[Ref[Node], string]::set : (HashMap[Ref[Node], string], Ref[Node], string) -> ())(
      (map/6 : HashMap[Ref[Node], string]),
      (distinct/5 : Ref[Node]),
      "distinct"
    );
    (println : (isize) -> ())(
      (HashMap[Ref[Node], string]::len : (HashMap[Ref[Node], string]) -> isize)(
        (map/6 : HashMap[Ref[Node], string])
      )
    );
    (print_lookup : (HashMap[Ref[Node], string], Ref[Node]) -> ())(
      (map/6 : HashMap[Ref[Node], string]),
      (first/3 : Ref[Node])
    );
    (print_lookup : (HashMap[Ref[Node], string], Ref[Node]) -> ())(
      (map/6 : HashMap[Ref[Node], string]),
      (distinct/5 : Ref[Node])
    )
}