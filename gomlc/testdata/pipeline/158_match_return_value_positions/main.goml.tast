fn add_after_match(flag/0: bool) -> i32 {
    let value/1: i32 =
      match (flag/0 : bool) {
          true => return 5,
          false => 7,
      };
    (value/1 : i32) + 1
}

fn receiver_after_match(flag/2: bool) -> string {
    (isize::to_string : (
      isize
    ) -> string)(
      match (flag/2 : bool) {
          true => return "early",
          false => 7,
      }
    )
}

fn closure_after_match(flag/3: bool) -> i32 {
    let f/6: (bool) -> i32 =
      |inner/4: bool| =>
        {
            let value/5: i32 =
              match (inner/4 : bool) {
                  true => return 2,
                  false => 4,
              };
            (value/5 : i32) + 3
        };
    (f/6 : (bool) -> i32)((flag/3 : bool))
}

fn main() -> () {
    (println : (i32) -> ())((add_after_match : (bool) -> i32)(false));
    (println : (i32) -> ())((add_after_match : (bool) -> i32)(true));
    (println : (string) -> ())((receiver_after_match : (bool) -> string)(false));
    (println : (string) -> ())((receiver_after_match : (bool) -> string)(true));
    (println : (i32) -> ())((closure_after_match : (bool) -> i32)(false));
    (println : (i32) -> ())((closure_after_match : (bool) -> i32)(true));
}