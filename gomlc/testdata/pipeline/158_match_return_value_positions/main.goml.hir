package main
file main.goml
  fn add_after_match(local/1/0: bool) -> i32 {
      let local/1/1 =
        match flag/0 {
            true => return 5,
            false => 7,
        };
      value/1 + 1
  }

  fn receiver_after_match(local/1/2: bool) -> string {
      match flag/2 {
          true => return "early",
          false => 7,
      }.to_string()
  }

  fn closure_after_match(local/1/3: bool) -> i32 {
      let local/1/6 =
        |local/1/4: bool| {
            let local/1/5 =
              match inner/4 {
                  true => return 2,
                  false => 4,
              };
            value/5 + 3
        };
      f/6(flag/3)
  }

  fn main() -> () {
      println(def/1/0(false));
      println(def/1/0(true));
      println(def/1/1(false));
      println(def/1/1(true));
      println(def/1/2(false));
      println(def/1/2(true));
  }