package main
file main.goml
  fn add_after_match(local/main/0: bool) -> i32 {
      let local/main/1 =
        match flag/0 {
            true => return 5,
            false => 7,
        };
      value/1 + 1
  }

  fn receiver_after_match(local/main/2: bool) -> string {
      match flag/2 {
          true => return "early",
          false => 7,
      }.to_string()
  }

  fn closure_after_match(local/main/3: bool) -> i32 {
      let local/main/6 =
        |local/main/4: bool| {
            let local/main/5 =
              match inner/4 {
                  true => return 2,
                  false => 4,
              };
            value/5 + 3
        };
      f/6(flag/3)
  }

  fn main() -> () {
      println(source:4:main:0(false));
      println(source:4:main:0(true));
      println(source:4:main:1(false));
      println(source:4:main:1(true));
      println(source:4:main:2(false));
      println(source:4:main:2(true));
  }