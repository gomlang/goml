package main;
const WRAPPED_I8: i8 = 127 + 1;

const WRAPPED_U8: u8 = 0 - 1;

const WRAPPED_PRODUCT: u8 = 128 * 2;

const WRAPPED_DIVISION: i8 = -128 / -1;

const WRAPPED_NEGATION: i8 = --128;

const FORWARD_WRAPPED: i8 = MAX_I8 + 1;

const MAX_I8: i8 = 127;

const NEGATIVE_ONE_I16: i16 = -1;

const PREFIX: string = "fixed";

fn show_i8(value: i8) -> () {
    println(value)
}

fn show_u8(value: u8) -> () {
    println(value)
}

fn show_i64(value: i64) -> () {
    println(value)
}

fn show_u64(value: u64) -> () {
    println(value)
}

fn main() -> () {
    show_i8(127 + 1);
    show_u8(0 - 1);
    show_u8(128 * 2);
    show_i8(-128 / -1);
    show_i8(--128);
    show_i64(9223372036854775807 + 1);
    show_u64(18446744073709551615 + 1);
    show_i8(WRAPPED_I8);
    show_u8(WRAPPED_U8);
    show_u8(WRAPPED_PRODUCT);
    show_i8(WRAPPED_DIVISION);
    show_i8(WRAPPED_NEGATION);
    show_i8(FORWARD_WRAPPED);
    show_i8(MAX_I8 + 1);
    show_i8(WRAPPED_I8 / -1);
    show_i8(-WRAPPED_I8);
    let converted: u8 = NEGATIVE_ONE_I16.to_u8();
    show_u8(converted);
    let runtime_value: i8 = 127;
    show_i8(runtime_value + 1);
    println(PREFIX + " width")
}

