package main
file main.goml
  trait Describe {
    fn name(Self) -> string;
    fn describe(Self) -> string;
  }

  fn trait_default#Describe#describe[Self: Describe](local/1/0: Self) -> string {
      "default:" + self/0.name()
  }

  trait Keep {
    fn keep[T](Self, T) -> T;
  }

  fn trait_default#Keep#keep[Self: Keep, T](local/1/1: Self, local/1/2: T) -> T {
      value/2
  }

  struct DefaultValue {
      name: string,
  }

  impl Describe for DefaultValue {
    fn name(local/1/3: Self) -> string {
        self/3.name
    }
  }

  impl Keep for DefaultValue {}

  struct OverrideValue {}

  impl Describe for OverrideValue {
    fn name(local/1/4: Self) -> string {
        "override-name"
    }
    fn describe(local/1/5: Self) -> string {
        "override"
    }
  }

  fn describe_dyn(local/1/6: dyn Describe) -> string {
      value/6.describe()
  }

  fn main() {
      let local/1/7 = DefaultValue { name: "value" };
      println(default_value/7.describe());
      println(default_value/7.keep("generic"));
      println(OverrideValue {}.describe());
      println(def/1/9(default_value/7 as dyn Describe));
  }