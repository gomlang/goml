fn trait_default#Describe#describe[Self](self/0: Self) -> string where Self: Describe {
    "default:" + (Describe::name : (Self) -> string)((self/0 : Self))
}

fn trait_default#Keep#keep[Self, T](self/1: Self, value/2: T) -> T where Self: Keep {
    (value/2 : T)
}

impl Describe for DefaultValue {
  fn name(self/3: DefaultValue) -> string {
      (self/3 : DefaultValue).name
  }
  fn describe(default_arg0: DefaultValue) -> string {
      (trait_default#Describe#describe : (DefaultValue) -> string)((default_arg0 : DefaultValue))
  }
}

impl Keep for DefaultValue {
  fn keep[T](default_arg0: DefaultValue, default_arg1: T) -> T {
      (trait_default#Keep#keep : (DefaultValue, T) -> T)(
        (default_arg0 : DefaultValue),
        (default_arg1 : T)
      )
  }
}

impl Describe for OverrideValue {
  fn name(self/4: OverrideValue) -> string {
      "override-name"
  }
  fn describe(self/5: OverrideValue) -> string {
      "override"
  }
}

fn describe_dyn(value/6: dyn Describe) -> string {
    (dyn Describe::describe : (dyn Describe) -> string)((value/6 : dyn Describe))
}

fn main() -> () {
    let default_value/7: DefaultValue = DefaultValue { name: "value" };
    (println : (string) -> ())(
      (trait_default#Describe#describe : (DefaultValue) -> string)((default_value/7 : DefaultValue))
    );
    (println : (string) -> ())(
      (trait_default#Keep#keep : (DefaultValue, string) -> string)(
        (default_value/7 : DefaultValue),
        "generic"
      )
    );
    (println : (string) -> ())((Describe::describe : (OverrideValue) -> string)(OverrideValue {}));
    (println : (string) -> ())(
      (describe_dyn : (dyn Describe) -> string)(
        to_dyn[Describe]{DefaultValue}((default_value/7 : DefaultValue))
      )
    );
}