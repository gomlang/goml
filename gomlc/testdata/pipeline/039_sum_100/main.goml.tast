fn my_int_equal(x/0: i32, y/1: i32) -> bool {
    !(x/0 : i32) < (y/1 : i32) && !(y/1 : i32) < (x/0 : i32)
}

fn sum(n/2: i32) -> i32 {
    if (my_int_equal : (i32, i32) -> bool)((n/2 : i32), 1) {
        {
            1
        }
    } else {
        {
            (n/2 : i32) + (sum : (i32) -> i32)((n/2 : i32) - 1)
        }
    }
}

fn main() -> () {
    (println : (i32) -> ())((sum : (i32) -> i32)(100))
}