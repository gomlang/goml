fn step_some(i/0: i32) -> Option[bool] {
    if (i/0 : i32) < 3 {
        {
            Option::Some(true)
        }
    } else {
        {
            Option::Some(false)
        }
    }
}

fn step_none(i/1: i32) -> Option[bool] {
    if (i/1 : i32) < 2 {
        {
            Option::Some(true)
        }
    } else {
        {
            Option::None
        }
    }
}

fn run_some() -> Option[i32] {
    let i/2: Ref[i32] = (Ref[i32]::new : (i32) -> Ref[i32])(0);
    let total/3: Ref[i32] = (Ref[i32]::new : (i32) -> Ref[i32])(0);
    while match (step_some : (i32) -> Option[bool])(
      (Ref[i32]::get : (Ref[i32]) -> i32)((i/2 : Ref[i32]))
    ) {
        Option::Some(try_value/31: bool) => (try_value/31 : bool),
        Option::None => return Option::None,
    } {
        {
            (Ref[i32]::set : (Ref[i32], i32) -> ())(
              (total/3 : Ref[i32]),
              (Ref[i32]::get : (Ref[i32]) -> i32)((total/3 : Ref[i32])) +
                (Ref[i32]::get : (Ref[i32]) -> i32)((i/2 : Ref[i32]))
            );
            (Ref[i32]::set : (Ref[i32], i32) -> ())(
              (i/2 : Ref[i32]),
              (Ref[i32]::get : (Ref[i32]) -> i32)((i/2 : Ref[i32])) + 1
            );
        }
    };
    Option::Some((Ref[i32]::get : (Ref[i32]) -> i32)((total/3 : Ref[i32])))
}

fn run_none() -> Option[i32] {
    let i/4: Ref[i32] = (Ref[i32]::new : (i32) -> Ref[i32])(0);
    let total/5: Ref[i32] = (Ref[i32]::new : (i32) -> Ref[i32])(0);
    while match (step_none : (i32) -> Option[bool])(
      (Ref[i32]::get : (Ref[i32]) -> i32)((i/4 : Ref[i32]))
    ) {
        Option::Some(try_value/67: bool) => (try_value/67 : bool),
        Option::None => return Option::None,
    } {
        {
            (Ref[i32]::set : (Ref[i32], i32) -> ())(
              (total/5 : Ref[i32]),
              (Ref[i32]::get : (Ref[i32]) -> i32)((total/5 : Ref[i32])) +
                (Ref[i32]::get : (Ref[i32]) -> i32)((i/4 : Ref[i32]))
            );
            (Ref[i32]::set : (Ref[i32], i32) -> ())(
              (i/4 : Ref[i32]),
              (Ref[i32]::get : (Ref[i32]) -> i32)((i/4 : Ref[i32])) + 1
            );
        }
    };
    Option::Some((Ref[i32]::get : (Ref[i32]) -> i32)((total/5 : Ref[i32])))
}

fn show(x/6: Option[i32]) -> string {
    match (x/6 : Option[i32]) {
        Option::Some(v/7: i32) => "some=" + (i32::to_string : (i32) -> string)((v/7 : i32)),
        Option::None => "none",
    }
}

fn main() -> () {
    (println : (string) -> ())((show : (Option[i32]) -> string)((run_some : () -> Option[i32])()));
    (println : (string) -> ())((show : (Option[i32]) -> string)((run_none : () -> Option[i32])()));
}