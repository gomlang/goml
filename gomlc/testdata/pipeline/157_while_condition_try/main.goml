fn step_some(i: i32) -> Option[bool] {
    if i < 3 {
        Option::Some(true)
    } else {
        Option::Some(false)
    }
}

fn step_none(i: i32) -> Option[bool] {
    if i < 2 {
        Option::Some(true)
    } else {
        Option::None
    }
}

fn run_some() -> Option[i32] {
    let i = Ref::new(0);
    let total = Ref::new(0);
    while step_some(i.get())? {
        total.set(total.get() + i.get());
        i.set(i.get() + 1);
    }
    Option::Some(total.get())
}

fn run_none() -> Option[i32] {
    let i = Ref::new(0);
    let total = Ref::new(0);
    while step_none(i.get())? {
        total.set(total.get() + i.get());
        i.set(i.get() + 1);
    }
    Option::Some(total.get())
}

fn show(x: Option[i32]) -> string {
    match x {
        Option::Some(v) => "some=" + v.to_string(),
        Option::None => "none",
    }
}

fn main() -> () {
    println(show(run_some()));
    println(show(run_none()));
}
