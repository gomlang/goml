package main
file main.goml
  fn make_string_channel() -> Channel[string] {
      Channel[string]::new(0)
  }

  fn roundtrip[T](local/1/0: Channel[T], local/1/1: T) -> Option[T] {
      go || channel/0.send(value/1);
      channel/0.recv()
  }

  fn main() -> () {
      let local/1/2 = Channel[isize]::new(2);
      buffered/2.send(10);
      buffered/2.send(20);
      buffered/2.close();
      println(
        match buffered/2.recv() {
            Option::Some(local/1/3) => value/3,
            Option::None => -1,
        }
      );
      println(
        match buffered/2.recv() {
            Option::Some(local/1/4) => value/4,
            Option::None => -1,
        }
      );
      println(
        match buffered/2.recv() {
            Option::Some(_) => "open",
            Option::None => "closed",
        }
      );
      let local/1/5 = def/1/0();
      println(
        match def/1/1(unbuffered/5, "ready") {
            Option::Some(local/1/6) => value/6,
            Option::None => "closed",
        }
      );
      unbuffered/5.close();
  }