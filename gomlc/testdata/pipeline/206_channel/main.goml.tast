fn make_string_channel() -> Channel[string] {
    (Channel[string]::new : (isize) -> Channel[string])(0)
}

fn roundtrip[T](channel/0: Channel[T], value/1: T) -> Option[T] {
    go || => (Channel[T]::send : (Channel[T], T) -> ())((channel/0 : Channel[T]), (value/1 : T));
    (Channel[T]::recv : (Channel[T]) -> Option[T])((channel/0 : Channel[T]))
}

fn main() -> () {
    let buffered/2: Channel[isize] = (Channel[isize]::new : (isize) -> Channel[isize])(2);
    (Channel[isize]::send : (Channel[isize], isize) -> ())((buffered/2 : Channel[isize]), 10);
    (Channel[isize]::send : (Channel[isize], isize) -> ())((buffered/2 : Channel[isize]), 20);
    (Channel[isize]::close : (Channel[isize]) -> ())((buffered/2 : Channel[isize]));
    (println : (isize) -> ())(
      match (Channel[isize]::recv : (Channel[isize]) -> Option[isize])(
        (buffered/2 : Channel[isize])
      ) {
          Option::Some(value/3: isize) => (value/3 : isize),
          Option::None => -1,
      }
    );
    (println : (isize) -> ())(
      match (Channel[isize]::recv : (Channel[isize]) -> Option[isize])(
        (buffered/2 : Channel[isize])
      ) {
          Option::Some(value/4: isize) => (value/4 : isize),
          Option::None => -1,
      }
    );
    (println : (string) -> ())(
      match (Channel[isize]::recv : (Channel[isize]) -> Option[isize])(
        (buffered/2 : Channel[isize])
      ) {
          Option::Some(_ : isize) => "open",
          Option::None => "closed",
      }
    );
    let unbuffered/5: Channel[string] = (make_string_channel : () -> Channel[string])();
    (println : (string) -> ())(
      match (roundtrip : (Channel[string], string) -> Option[string])(
        (unbuffered/5 : Channel[string]),
        "ready"
      ) {
          Option::Some(value/6: string) => (value/6 : string),
          Option::None => "closed",
      }
    );
    (Channel[string]::close : (Channel[string]) -> ())((unbuffered/5 : Channel[string]));
}