fn main() -> () {
    let i/0: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    let sum/1: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    while (Ref[isize]::get : (Ref[isize]) -> isize)((i/0 : Ref[isize])) < 5 {
        {
            (Ref[isize]::set : (Ref[isize], isize) -> ())(
              (i/0 : Ref[isize]),
              (Ref[isize]::get : (Ref[isize]) -> isize)((i/0 : Ref[isize])) + 1
            );
            let cur/2: isize =
              if (Ref[isize]::get : (Ref[isize]) -> isize)((i/0 : Ref[isize])) == 3 {
                  {
                      continue
                  }
              } else {
                  {
                      (Ref[isize]::get : (Ref[isize]) -> isize)((i/0 : Ref[isize]))
                  }
              };
            (Ref[isize]::set : (Ref[isize], isize) -> ())(
              (sum/1 : Ref[isize]),
              (Ref[isize]::get : (Ref[isize]) -> isize)((sum/1 : Ref[isize])) + (cur/2 : isize)
            );
        }
    };
    (println : (isize) -> ())((Ref[isize]::get : (Ref[isize]) -> isize)((sum/1 : Ref[isize])));
    let j/3: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    let total/4: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    while true {
        {
            (Ref[isize]::set : (Ref[isize], isize) -> ())(
              (j/3 : Ref[isize]),
              (Ref[isize]::get : (Ref[isize]) -> isize)((j/3 : Ref[isize])) + 1
            );
            let cur/5: isize =
              match (Ref[isize]::get : (Ref[isize]) -> isize)((j/3 : Ref[isize])) {
                  5 => break,
                  _ : isize => (Ref[isize]::get : (Ref[isize]) -> isize)((j/3 : Ref[isize])),
              };
            (Ref[isize]::set : (Ref[isize], isize) -> ())(
              (total/4 : Ref[isize]),
              (Ref[isize]::get : (Ref[isize]) -> isize)((total/4 : Ref[isize])) + (cur/5 : isize)
            );
        }
    };
    (println : (isize) -> ())((Ref[isize]::get : (Ref[isize]) -> isize)((total/4 : Ref[isize])));
}