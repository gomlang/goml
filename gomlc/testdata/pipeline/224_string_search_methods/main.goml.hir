package main
file main.goml
  fn main() -> () {
      let local/1/0 = "a你好z";
      println(value/0.starts_with("a你"));
      println(value/0.starts_with("你"));
      println(value/0.starts_with(""));
      println(value/0.ends_with("好z"));
      println(value/0.ends_with("你好"));
      println(value/0.ends_with(""));
      println(value/0.contains("你好"));
      println(value/0.contains("好z"));
      println(value/0.contains("你z"));
      println(value/0.contains(""));
      println(value/0.contains("a你好z!"))
  }