fn main() -> () {
    let value = "a你好z";
    println(value.starts_with("a你"));
    println(value.starts_with("你"));
    println(value.starts_with(""));
    println(value.ends_with("好z"));
    println(value.ends_with("你好"));
    println(value.ends_with(""));
    println(value.contains("你好"));
    println(value.contains("好z"));
    println(value.contains("你z"));
    println(value.contains(""));
    println(value.contains("a你好z!"))
}
