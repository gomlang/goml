fn main() -> () {
    let value/0: string = "a你好z";
    (println : (bool) -> ())(
      (string::starts_with : (string, string) -> bool)((value/0 : string), "a你")
    );
    (println : (bool) -> ())(
      (string::starts_with : (string, string) -> bool)((value/0 : string), "你")
    );
    (println : (bool) -> ())(
      (string::starts_with : (string, string) -> bool)((value/0 : string), "")
    );
    (println : (bool) -> ())(
      (string::ends_with : (string, string) -> bool)((value/0 : string), "好z")
    );
    (println : (bool) -> ())(
      (string::ends_with : (string, string) -> bool)((value/0 : string), "你好")
    );
    (println : (bool) -> ())(
      (string::ends_with : (string, string) -> bool)((value/0 : string), "")
    );
    (println : (bool) -> ())(
      (string::contains : (string, string) -> bool)((value/0 : string), "你好")
    );
    (println : (bool) -> ())(
      (string::contains : (string, string) -> bool)((value/0 : string), "好z")
    );
    (println : (bool) -> ())(
      (string::contains : (string, string) -> bool)((value/0 : string), "你z")
    );
    (println : (bool) -> ())((string::contains : (string, string) -> bool)((value/0 : string), ""));
    (println : (bool) -> ())(
      (string::contains : (string, string) -> bool)((value/0 : string), "a你好z!")
    )
}