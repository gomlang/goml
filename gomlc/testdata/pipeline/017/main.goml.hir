package main
file main.goml
  trait PairText {
    fn to_string(Self) -> string;
  }

  impl PairText for (isize, isize) {
    fn to_string(local/main/0: (isize, isize)) -> string {
        "(?, ?)"
    }
  }

  fn main() {
      let local/main/1 = 123;
      let _ = println(ToString::to_string(x/1));
      let local/main/2 = true;
      let _ = println(ToString::to_string(x/2));
      let local/main/3 = (3, 4);
      let _ = println(PairText::to_string(x/3));
  }