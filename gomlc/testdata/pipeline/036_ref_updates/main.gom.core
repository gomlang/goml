fn main() -> () {
  let counter/0 = inherent#Ref#Ref[i32]#new(39) in
  let toggler/0 = inherent#Ref#Ref[bool]#new(false) in
  let nested/0 = inherent#Ref#Ref[Ref[i32]]#new(inherent#Ref#Ref[i32]#new(3)) in
  let bumped/0 = bump(counter/0) in
  let flipped/0 = flip(toggler/0) in
  let flipped_again/0 = flip(toggler/0) in
  let inner/0 = inherent#Ref#Ref[Ref[i32]]#get(nested/0) in
  let mtmp0 = inherent#Ref#Ref[i32]#set(inner/0, (inherent#Ref#Ref[i32]#get(inner/0) + bumped/0)) in
  {
    let nested_total_val/0 = nested_total(nested/0) in
    let alias_total/0 = alias_bump(counter/0) in
    let pair_total/0 = pair_sum() in
    let reassigned/0 = reassign_nested(nested/0) in
    let bool_check/0 = (!false) in
    let mtmp1 =
      println(inherent#i32#i32#to_string((bumped/0 + inherent#Ref#Ref[i32]#get(counter/0)))) in
    {
      let mtmp2 =
        println(
          inherent#i32#i32#to_string(((nested_total_val/0 + alias_total/0) + reassigned/0))
        ) in
      {
        let mtmp3 = println(inherent#i32#i32#to_string(pair_total/0)) in
        {
          let mtmp4 =
            println(
              trait_call[ToString::to_string](
                if if flipped/0 {
                    flipped_again/0
                } else {
                    false
                } {
                    bool_check/0
                } else {
                    false
                }
              )
            ) in
          {
