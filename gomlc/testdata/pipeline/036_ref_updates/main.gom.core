fn pair_sum() -> i32 {
  let first/0 = inherent#Ref#Ref[i32]#new(4) in
  let second/0 = inherent#Ref#Ref[i32]#new(6) in
  let mtmp0 =
    inherent#Ref#Ref[i32]#set(
      first/0,
      (inherent#Ref#Ref[i32]#get(first/0) + inherent#Ref#Ref[i32]#get(second/0))
    ) in
  {
    (inherent#Ref#Ref[i32]#get(first/0) + inherent#Ref#Ref[i32]#get(second/0))
