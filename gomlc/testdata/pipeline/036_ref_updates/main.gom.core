fn bump(cell/0: Ref[i32]) -> i32 {
  let mtmp0 = inherent#Ref#Ref[i32]#set(cell/0, (inherent#Ref#Ref[i32]#get(cell/0) + 1)) in
  {
    inherent#Ref#Ref[i32]#get(cell/0)
  }
}

fn flip(flag/0: Ref[bool]) -> bool {
  let current/0 = inherent#Ref#Ref[bool]#get(flag/0) in
  let mtmp0 = inherent#Ref#Ref[bool]#set(flag/0, (!current/0)) in
  {
    inherent#Ref#Ref[bool]#get(flag/0)
  }
