fn nested_total(cell/0: Ref[Ref[i32]]) -> i32 {
  let inner/0 = inherent#Ref#Ref[Ref[i32]]#get(cell/0) in
  let before/0 = inherent#Ref#Ref[i32]#get(inner/0) in
  let mtmp0 = inherent#Ref#Ref[i32]#set(inner/0, (before/0 + 2)) in
  {
    (before/0 + inherent#Ref#Ref[i32]#get(inner/0))
  }
}

fn alias_bump(cell/0: Ref[i32]) -> i32 {
  let alias/0 = cell/0 in
  let mtmp0 = inherent#Ref#Ref[i32]#set(alias/0, (inherent#Ref#Ref[i32]#get(alias/0) + 5)) in
  {
