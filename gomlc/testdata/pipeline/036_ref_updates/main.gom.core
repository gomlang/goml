fn reassign_nested(nested/0: Ref[Ref[i32]]) -> i32 {
  let inner/0 = inherent#Ref#Ref[Ref[i32]]#get(nested/0) in
  let mtmp0 = inherent#Ref#Ref[i32]#set(inner/0, (inherent#Ref#Ref[i32]#get(inner/0) + 7)) in
