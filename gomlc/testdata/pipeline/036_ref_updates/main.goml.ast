package main;
fn bump(cell: Ref[i32]) -> i32 {
    let _ = cell.set(cell.get() + 1);
    cell.get()
}

fn flip(flag: Ref[bool]) -> bool {
    let current = flag.get();
    let _ = flag.set(!current);
    flag.get()
}

fn nested_total(cell: Ref[Ref[i32]]) -> i32 {
    let inner = cell.get();
    let before = inner.get();
    let _ = inner.set(before + 2);
    before + inner.get()
}

fn alias_bump(cell: Ref[i32]) -> i32 {
    let alias = cell;
    let _ = alias.set(alias.get() + 5);
    alias.get()
}

fn pair_sum() -> i32 {
    let first = Ref::new(4);
    let second = Ref::new(6);
    let _ = first.set(first.get() + second.get());
    first.get() + second.get()
}

fn reassign_nested(nested: Ref[Ref[i32]]) -> i32 {
    let inner = nested.get();
    let _ = inner.set(inner.get() + 7);
    inner.get()
}

fn main() {
    let counter = Ref::new(39);
    let toggler = Ref::new(false);
    let nested = Ref::new(Ref::new(3));
    let bumped = bump(counter);
    let flipped = flip(toggler);
    let flipped_again = flip(toggler);
    let inner = nested.get();
    let _ = inner.set(inner.get() + bumped);
    let nested_total_val = nested_total(nested);
    let alias_total = alias_bump(counter);
    let pair_total = pair_sum();
    let reassigned = reassign_nested(nested);
    let bool_check = !false;
    let _ = println(bumped + counter.get().to_string());
    let _ = println(nested_total_val + alias_total + reassigned.to_string());
    let _ = println(pair_total.to_string());
    let _ = println(flipped && flipped_again && bool_check.to_string());
}

