  fn bump(local/main/0: Ref[i32]) -> i32 {
      let _ = cell/0.set(cell/0.get() + 1);
      cell/0.get()
  }

  fn flip(local/main/1: Ref[bool]) -> bool {
      let local/main/2 = flag/1.get();
      let _ = flag/1.set(!current/2);
      flag/1.get()
  }

  fn nested_total(local/main/3: Ref[Ref[i32]]) -> i32 {
      let local/main/4 = cell/3.get();
      let local/main/5 = inner/4.get();
      let _ = inner/4.set(before/5 + 2);
      before/5 + inner/4.get()
  }

