fn main() {
    let arr: [u8; 3] = [10, 20, 30];
    let i = Ref::new(0);
    while i.get() < 3 {
        println(arr[i.get()].to_string());
        i.set(i.get() + 1);
    }
    let floats: [f32; 2] = [1.5, 2.5];
    println(floats[0].to_string());
    println(floats[1].to_string());
    let longs: [i64; 2] = [100, 200];
    println(longs[0].to_string());
    println(longs[1].to_string());
}
