package main;
use std::task;

const SIZE: usize = 2;

const WIDTH: usize = SIZE;

enum Message[T] {
    Empty,
    Value(T)
}

enum Storage[T, const N: usize] {
    Empty,
    Values([T; N])
}

fn first[const SIZE: usize](values: [isize; WIDTH]) -> isize {
    values[0]
}

fn main() -> () {
    let value = 1;
    let inner =
      {
          let value = 2;
          let nested =
            {
                let value = 3;
                value
            };
          value + nested
      };
    println(inner);
    println(value);
    let computed =
      comptime {
          let value = 4;
          value
      };
    println(computed);
    println(value);
    let scoped =
      scope {
          let value = 5;
          let work = spawn |_cancel| value;
          work.join()
      };
    println(scoped);
    println(value);
    let mut count = 6;
    let _ =
      {
          count += 1;
          let count = 8;
          count
      };
    println(count);
    println(first::[3]([9, 10]));
    let direct = Message::[isize]::Value(11);
    let constructor = Message::[string]::Value;
    let indirect = constructor("bound");
    let empty = Message::[bool]::Empty;
    match direct {
        Value(value) => println(value),
        Empty => (),
    };
    match indirect {
        Value(value) => println(value),
        Empty => (),
    };
    println(
      match empty {
          Empty => true,
          Value(value) => value,
      }
    );
    let stored = Storage::[isize, 2]::Values([12, 13]);
    let store = Storage::[isize, 2]::Values;
    let indirect_store = store([14, 15]);
    match stored {
        Values(values) => println(values[1]),
        Empty => (),
    };
    match indirect_store {
        Values(values) => println(values[0]),
        Empty => (),
    };
    let narrow: [u8; 3] = [1; 3];
    println(narrow[2]);
}

