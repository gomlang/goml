fn decimal_string(value/0: u64) -> string {
  let _wild0 =
    if (value/0 == 0) {
        {
          return "0"
        }
    } else {
        ()
    } in
  let reversed/0 = @intrinsic(vec.with_capacity)(20) in
  let remaining/0 = value/0 in
  let _wild1 =
    while (remaining/0 > 0) {
        {
          let _wild2 = inherent#Vec#Vec[u8]#push(reversed/0, (((remaining/0 % 10) as u8) + 48)) in
          let _wild3 =
            {
              let compound_old0 = remaining/0 in
              let compound_value0 = 10 in
              remaining/0 = (compound_old0 / compound_value0)
            } in
        }
    } in
  let bytes/0 = @intrinsic(vec.with_capacity)(inherent#Vec#Vec[u8]#len(reversed/0)) in
  let offset/0 = 0 in
  let _wild4 =
    while (offset/0 < inherent#Vec#Vec[u8]#len(reversed/0)) {
        {
          let _wild5 =
            inherent#Vec#Vec[u8]#push(
              bytes/0,
              @intrinsic(vec.get)(
                reversed/0,
                ((inherent#Vec#Vec[u8]#len(reversed/0) - offset/0) - 1)
              )
            ) in
          let _wild6 =
            {
              let compound_old1 = offset/0 in
              let compound_value1 = 1 in
              offset/0 = (compound_old1 + compound_value1)
            } in
        }
    } in
  let mtmp0 = @runtime(core.string_from_utf8)(bytes/0) in
  {
    let x0 = mtmp0.1 in
    {
      let result/0 = x0 in
      {
        result/0
      }
    }
  }
}

fn signed_decimal_string(value/0: i64) -> string {
  if (value/0 < 0) {
      {
        ("-" + decimal_string((0 - (value/0 as u64))))
      }
  } else {
      {
        decimal_string((value/0 as u64))
      }
  }
}

fn __goml_builtin_int32_to_string(value/0: i32) -> string {
  signed_decimal_string((value/0 as i64))
}

fn inherent#i32#i32#to_string(self/0: i32) -> string {
  __goml_builtin_int32_to_string(self/0)
}

fn trait_impl#ToString#string#to_string(self/0: string) -> string {
  self/0
}

fn inherent#Vec#Vec[T]#push[T](self/0: Vec[T], elem/0: T) -> () {
  @intrinsic(vec.push)(self/0, elem/0)
}

fn inherent#Vec#Vec[T]#len[T](self/0: Vec[T]) -> isize {
  @intrinsic(vec.len)(self/0)
}

fn println[T](value/0: T) -> () {
  @runtime(core.string_println)(trait_call[ToString::to_string](value/0))
}

fn inherent#Point#Point#new(x/0: i32, y/0: i32) -> Point {
  Point { x: x/0, y: y/0 }
}

fn inherent#Point#Point#copy(self/0: Point, other/0: Point) -> Point {
  Point { x: (Point.x(self/0) + Point.x(other/0)), y: (Point.y(self/0) + Point.y(other/0)) }
}

fn inherent#Point#Point#origin() -> Point {
  Point { x: 0, y: 0 }
}

fn wrap[T](value/0: T) -> T {
  let id/0 = |item/0: T| => item/0 in
  id/0(value/0)
}

fn shape_value(value/0: Shape[i32]) -> i32 {
  match value/0 {
    Shape::Dot(x0) => {
      {
        let x0 = Shape::Dot._0(value/0) in
        {
          let point/0 = x0 in
          (Point.x(point/0) + Point.y(point/0))
        }
      }
    },
    Shape::Wrapped(x1) => {
      {
        let x1 = Shape::Wrapped._0(value/0) in
        {
          let wrapper/0 = x1 in
          Wrapper.value(wrapper/0)
        }
      }
    },
    Shape::Origin => {
      0
    },
  }
}

fn list_value(value/0: List) -> i32 {
  match value/0 {
    List::Cons(x0) => {
      {
        let x0 = List::Cons._0(value/0) in
        {
          let node/0 = x0 in
          (Node.value(node/0) + list_value(Node.next(node/0)))
        }
      }
    },
    List::Nil => {
      0
    },
  }
}

fn main() -> () {
  let offset/0 = 1 in
  let add/0 = |value/0: i32| => (value/0 + offset/0) in
  let point/0 = inherent#Point#Point#new(add/0(1), 3) in
  let combined/0 = inherent#Point#Point#copy(point/0, inherent#Point#Point#origin()) in
  let wrapped/0 = Shape::Wrapped(Wrapper { value: wrap(4) }) in
  let list/0 = List::Cons(Node { value: 5, next: List::Nil }) in
  println(
    inherent#i32#i32#to_string(
      (((Point.x(combined/0) + Point.y(combined/0)) + shape_value(wrapped/0)) + list_value(list/0))
    )
  )
}