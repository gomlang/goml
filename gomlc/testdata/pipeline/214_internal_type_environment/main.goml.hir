  fn main() -> () {
      let local/1/12 = 1;
      let local/1/14 = |local/1/13| value/13 + offset/12;
      let local/1/15 = Point::new(add/14(1), 3);
      let local/1/16 = Point::copy(point/15, Point::origin());
      let local/1/17 = ctor(def/1/4::v1)(Wrapper { value: def/1/6(4) });
      let local/1/18 = ctor(def/1/3::v0)(Node { value: 5, next: ctor(def/1/3::v1) });
      println(combined/16.x + combined/16.y + def/1/7(wrapped/17) + def/1/8(list/18).to_string())
  }