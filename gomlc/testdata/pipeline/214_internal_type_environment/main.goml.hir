    }
    fn origin() -> Self {
        Point { x: 0, y: 0 }
    }
  }

  fn wrap[T](local/1/4: T) -> T {
      let local/1/6 = |local/1/5: T| item/5;
      id/6(value/4)
  }

  fn shape_value(local/1/7: Shape[i32]) -> i32 {
      match value/7 {
          ctor(def/1/4::v0)(local/1/8) => point/8.x + point/8.y,
          ctor(def/1/4::v1)(local/1/9) => wrapper/9.value,
