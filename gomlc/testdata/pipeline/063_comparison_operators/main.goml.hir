package main
file main.goml
  fn test_int_comparisons() {
      let local/main/0: i32 = 10;
      let local/main/1: i32 = 20;
      let local/main/2: i32 = 10;
      let local/main/3 = a/0 < b/1;
      let _ = println("10 < 20: " + less/3.to_string());
      let local/main/4 = b/1 > a/0;
      let _ = println("20 > 10: " + greater/4.to_string());
      let local/main/5 = a/0 <= b/1;
      let _ = println("10 <= 20: " + less_eq1/5.to_string());
      let local/main/6 = a/0 <= c/2;
      let _ = println("10 <= 10: " + less_eq2/6.to_string());
      let local/main/7 = b/1 >= a/0;
      let _ = println("20 >= 10: " + greater_eq1/7.to_string());
      let local/main/8 = c/2 >= a/0;
      let _ = println("10 >= 10: " + greater_eq2/8.to_string());
      let local/main/9 = a/0 == c/2;
      let _ = println("10 == 10: " + eq1/9.to_string());
      let local/main/10 = a/0 == b/1;
      let _ = println("10 == 20: " + eq2/10.to_string());
      let local/main/11 = a/0 != b/1;
      let _ = println("10 != 20: " + neq1/11.to_string());
      let local/main/12 = a/0 != c/2;
      let _ = println("10 != 10: " + neq2/12.to_string());
  }

  fn test_float_comparisons() {
      let local/main/13: f64 = 3.14;
      let local/main/14: f64 = 2.71;
      let local/main/15: f64 = 3.14;
      let local/main/16 = y/14 < x/13;
      let _ = println("2.71 < 3.14: " + less/16.to_string());
      let local/main/17 = x/13 > y/14;
      let _ = println("3.14 > 2.71: " + greater/17.to_string());
      let local/main/18 = y/14 <= x/13;
      let _ = println("2.71 <= 3.14: " + less_eq1/18.to_string());
      let local/main/19 = x/13 <= z/15;
      let _ = println("3.14 <= 3.14: " + less_eq2/19.to_string());
      let local/main/20 = x/13 >= y/14;
      let _ = println("3.14 >= 2.71: " + greater_eq1/20.to_string());
      let local/main/21 = z/15 >= x/13;
      let _ = println("3.14 >= 3.14: " + greater_eq2/21.to_string());
      let local/main/22 = x/13 == z/15;
      let _ = println("3.14 == 3.14: " + eq1/22.to_string());
      let local/main/23 = x/13 == y/14;
      let _ = println("3.14 == 2.71: " + eq2/23.to_string());
      let local/main/24 = x/13 != y/14;
      let _ = println("3.14 != 2.71: " + neq1/24.to_string());
      let local/main/25 = x/13 != z/15;
      let _ = println("3.14 != 3.14: " + neq2/25.to_string());
  }

  fn main() {
      let _ = println("=== Integer Comparisons ===");
      let _ = source:4:main:0();
