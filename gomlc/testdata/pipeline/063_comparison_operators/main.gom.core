fn trait_impl#ToString#bool#to_string(self/0: bool) -> string {
  @runtime(core.bool_to_string)(self/0)
}

fn trait_impl#ToString#string#to_string(self/0: string) -> string {
  self/0
}

fn println[T](value/0: T) -> () {
  @runtime(core.string_println)(trait_call[ToString::to_string](value/0))
}

fn test_int_comparisons() -> () {
  let a/0 = 10 in
  let b/0 = 20 in
  let c/0 = 10 in
  let less/0 = (a/0 < b/0) in
  let mtmp0 = println(("10 < 20: " + trait_call[ToString::to_string](less/0))) in
  {
    let greater/0 = (b/0 > a/0) in
    let mtmp1 = println(("20 > 10: " + trait_call[ToString::to_string](greater/0))) in
    {
      let less_eq1/0 = (a/0 <= b/0) in
      let mtmp2 = println(("10 <= 20: " + trait_call[ToString::to_string](less_eq1/0))) in
      {
        let less_eq2/0 = (a/0 <= c/0) in
        let mtmp3 = println(("10 <= 10: " + trait_call[ToString::to_string](less_eq2/0))) in
        {
          let greater_eq1/0 = (b/0 >= a/0) in
          let mtmp4 = println(("20 >= 10: " + trait_call[ToString::to_string](greater_eq1/0))) in
          {
            let greater_eq2/0 = (c/0 >= a/0) in
            let mtmp5 = println(("10 >= 10: " + trait_call[ToString::to_string](greater_eq2/0))) in
            {
              let eq1/0 = (a/0 == c/0) in
              let mtmp6 = println(("10 == 10: " + trait_call[ToString::to_string](eq1/0))) in
              {
                let eq2/0 = (a/0 == b/0) in
                let mtmp7 = println(("10 == 20: " + trait_call[ToString::to_string](eq2/0))) in
                {
                  let neq1/0 = (a/0 != b/0) in
                  let mtmp8 = println(("10 != 20: " + trait_call[ToString::to_string](neq1/0))) in
                  {
                    let neq2/0 = (a/0 != c/0) in
                    let mtmp9 = println(("10 != 10: " + trait_call[ToString::to_string](neq2/0))) in
                    {
                      ()
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn test_float_comparisons() -> () {
  let x/0 = 3.14 in
  let y/0 = 2.71 in
  let z/0 = 3.14 in
  let less/0 = (y/0 < x/0) in
  let mtmp0 = println(("2.71 < 3.14: " + trait_call[ToString::to_string](less/0))) in
  {
    let greater/0 = (x/0 > y/0) in
    let mtmp1 = println(("3.14 > 2.71: " + trait_call[ToString::to_string](greater/0))) in
    {
      let less_eq1/0 = (y/0 <= x/0) in
      let mtmp2 = println(("2.71 <= 3.14: " + trait_call[ToString::to_string](less_eq1/0))) in
      {
        let less_eq2/0 = (x/0 <= z/0) in
        let mtmp3 = println(("3.14 <= 3.14: " + trait_call[ToString::to_string](less_eq2/0))) in
        {
          let greater_eq1/0 = (x/0 >= y/0) in
          let mtmp4 =
            println(("3.14 >= 2.71: " + trait_call[ToString::to_string](greater_eq1/0))) in
          {
            let greater_eq2/0 = (z/0 >= x/0) in
            let mtmp5 =
              println(("3.14 >= 3.14: " + trait_call[ToString::to_string](greater_eq2/0))) in
            {
              let eq1/0 = (x/0 == z/0) in
              let mtmp6 = println(("3.14 == 3.14: " + trait_call[ToString::to_string](eq1/0))) in
              {
                let eq2/0 = (x/0 == y/0) in
                let mtmp7 = println(("3.14 == 2.71: " + trait_call[ToString::to_string](eq2/0))) in
                {
                  let neq1/0 = (x/0 != y/0) in
                  let mtmp8 =
                    println(("3.14 != 2.71: " + trait_call[ToString::to_string](neq1/0))) in
                  {
                    let neq2/0 = (x/0 != z/0) in
                    let mtmp9 =
                      println(("3.14 != 3.14: " + trait_call[ToString::to_string](neq2/0))) in
                    {
                      ()
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn main() -> () {
  let mtmp0 = println("=== Integer Comparisons ===") in
  {
    let mtmp1 = test_int_comparisons() in
    {
      let mtmp2 = println("") in
      {
        let mtmp3 = println("=== Float Comparisons ===") in
        {
          let mtmp4 = test_float_comparisons() in
          {
            ()
          }
        }
      }
    }
  }
}