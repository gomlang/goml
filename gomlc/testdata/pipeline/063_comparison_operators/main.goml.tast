fn test_int_comparisons() -> () {
    let a/0: i32 = 10;
    let b/1: i32 = 20;
    let c/2: i32 = 10;
    let less/3: bool = (a/0 : i32) < (b/1 : i32);
    let _ : () =
      (println : (string) -> ())(
        "10 < 20: " + (ToString::to_string : (bool) -> string)((less/3 : bool))
      );
    let greater/4: bool = (b/1 : i32) > (a/0 : i32);
    let _ : () =
      (println : (string) -> ())(
        "20 > 10: " + (ToString::to_string : (bool) -> string)((greater/4 : bool))
      );
    let less_eq1/5: bool = (a/0 : i32) <= (b/1 : i32);
    let _ : () =
      (println : (string) -> ())(
        "10 <= 20: " + (ToString::to_string : (bool) -> string)((less_eq1/5 : bool))
      );
    let less_eq2/6: bool = (a/0 : i32) <= (c/2 : i32);
    let _ : () =
      (println : (string) -> ())(
        "10 <= 10: " + (ToString::to_string : (bool) -> string)((less_eq2/6 : bool))
      );
    let greater_eq1/7: bool = (b/1 : i32) >= (a/0 : i32);
    let _ : () =
      (println : (string) -> ())(
        "20 >= 10: " + (ToString::to_string : (bool) -> string)((greater_eq1/7 : bool))
      );
    let greater_eq2/8: bool = (c/2 : i32) >= (a/0 : i32);
    let _ : () =
      (println : (string) -> ())(
        "10 >= 10: " + (ToString::to_string : (bool) -> string)((greater_eq2/8 : bool))
      );
    let eq1/9: bool = (a/0 : i32) == (c/2 : i32);
    let _ : () =
      (println : (string) -> ())(
        "10 == 10: " + (ToString::to_string : (bool) -> string)((eq1/9 : bool))
      );
    let eq2/10: bool = (a/0 : i32) == (b/1 : i32);
    let _ : () =
      (println : (string) -> ())(
        "10 == 20: " + (ToString::to_string : (bool) -> string)((eq2/10 : bool))
      );
    let neq1/11: bool = (a/0 : i32) != (b/1 : i32);
    let _ : () =
      (println : (string) -> ())(
        "10 != 20: " + (ToString::to_string : (bool) -> string)((neq1/11 : bool))
      );
    let neq2/12: bool = (a/0 : i32) != (c/2 : i32);
    let _ : () =
      (println : (string) -> ())(
        "10 != 10: " + (ToString::to_string : (bool) -> string)((neq2/12 : bool))
      );
}

fn test_float_comparisons() -> () {
    let x/13: f64 = 3.14;
    let y/14: f64 = 2.71;
    let z/15: f64 = 3.14;
    let less/16: bool = (y/14 : f64) < (x/13 : f64);
    let _ : () =
      (println : (string) -> ())(
        "2.71 < 3.14: " + (ToString::to_string : (bool) -> string)((less/16 : bool))
      );
    let greater/17: bool = (x/13 : f64) > (y/14 : f64);
    let _ : () =
      (println : (string) -> ())(
        "3.14 > 2.71: " + (ToString::to_string : (bool) -> string)((greater/17 : bool))
      );
    let less_eq1/18: bool = (y/14 : f64) <= (x/13 : f64);
    let _ : () =
      (println : (string) -> ())(
        "2.71 <= 3.14: " + (ToString::to_string : (bool) -> string)((less_eq1/18 : bool))
      );
    let less_eq2/19: bool = (x/13 : f64) <= (z/15 : f64);
    let _ : () =
      (println : (string) -> ())(
        "3.14 <= 3.14: " + (ToString::to_string : (bool) -> string)((less_eq2/19 : bool))
      );
    let greater_eq1/20: bool = (x/13 : f64) >= (y/14 : f64);
    let _ : () =
      (println : (string) -> ())(
        "3.14 >= 2.71: " + (ToString::to_string : (bool) -> string)((greater_eq1/20 : bool))
      );
    let greater_eq2/21: bool = (z/15 : f64) >= (x/13 : f64);
    let _ : () =
      (println : (string) -> ())(
        "3.14 >= 3.14: " + (ToString::to_string : (bool) -> string)((greater_eq2/21 : bool))
      );
    let eq1/22: bool = (x/13 : f64) == (z/15 : f64);
    let _ : () =
      (println : (string) -> ())(
        "3.14 == 3.14: " + (ToString::to_string : (bool) -> string)((eq1/22 : bool))
      );
    let eq2/23: bool = (x/13 : f64) == (y/14 : f64);
    let _ : () =
      (println : (string) -> ())(
        "3.14 == 2.71: " + (ToString::to_string : (bool) -> string)((eq2/23 : bool))
      );
    let neq1/24: bool = (x/13 : f64) != (y/14 : f64);
    let _ : () =
      (println : (string) -> ())(
        "3.14 != 2.71: " + (ToString::to_string : (bool) -> string)((neq1/24 : bool))
      );
    let neq2/25: bool = (x/13 : f64) != (z/15 : f64);
    let _ : () =
      (println : (string) -> ())(
        "3.14 != 3.14: " + (ToString::to_string : (bool) -> string)((neq2/25 : bool))
      );
}

fn main() -> () {
    let _ : () = (println : (string) -> ())("=== Integer Comparisons ===");
    let _ : () = (test_int_comparisons : () -> ())();
    let _ : () = (println : (string) -> ())("");
    let _ : () = (println : (string) -> ())("=== Float Comparisons ===");
    let _ : () = (test_float_comparisons : () -> ())();
}