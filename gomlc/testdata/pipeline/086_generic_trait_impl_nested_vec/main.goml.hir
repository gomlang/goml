package main
file main.goml
  trait Size {
    fn size(Self) -> i32;
  }

  struct Wrap[T] {
      value: T,
  }

  impl[T] Size for Wrap[T] {
    fn size(local/1/0: Wrap[T]) -> i32 {
        1
    }
  }

  fn main() {
      let local/1/1 = Wrap { value: 1 };
      let local/1/2 = Wrap { value: "x" };
      println(Size::size(a/1).to_string());
      println(Size::size(b/2).to_string());
  }