package main
file main.goml
  struct Point {
      x: i32,
      y: i32,
  }

  fn point32_to_string(local/main/0: Point) -> string {
      let Point { x: local/main/1, y: local/main/2 } = p/0;
      "Point { x: " + x/1.to_string() + ", y: " + y/2.to_string() + " }"
  }

  enum Color {
      Red,
      Green,
      Blue
  }

  fn color_to_string(local/main/3: Color) -> string {
      match c/3 {
          Red => "Red",
          Green => "Green",
          Blue => "Blue",
      }
  }

  struct Line {
      from: Point,
      to: Point,
      color: Color,
  }

  fn line_to_string(local/main/4: Line) -> string {
      let Line { from: local/main/5, to: local/main/6, color: local/main/7 } = l/4;
      "Line { from: " + source:4:main:1(from/5) + ", to: " + source:4:main:1(to/6) + ", color: " +
        source:4:main:3(color/7) +
        " }"
  }

  fn point_type(local/main/8: Point) -> string {
      match p/8 {
          Point { x: 0, y: 0 } =>
            {
                "origin"
            },
          Point { x: 0, y: 1 } =>
            {
                "up"
            },
          Point { x: 1, y: 0 } =>
            {
                "right"
            },
          Point { x: 0, y: local/main/9 } =>
            {
                match 0 < y/9 {
                    true => "above",
                    false => "below",
                }
            },
          _ => "unknown",
      }
  }

  fn main() {
      let local/main/10 = Point { x: 0, y: 0 };
      let _ = println(source:4:main:6(p0/10));
      let local/main/11 = Point { x: 10, y: 10 };
      let local/main/12 = Line { from: p0/10, to: p1/11, color: ctor(source:4:main:2::v0) };
      println(source:4:main:5(line/12))
  }