fn maybe_primary(flag/0: bool) -> Option[i32] {
    if (flag/0 : bool) {
        {
            Option::Some(4)
        }
    } else {
        {
            Option::None
        }
    }
}

fn maybe_secondary(flag/1: bool) -> Option[i32] {
    if (flag/1 : bool) {
        {
            Option::Some(9)
        }
    } else {
        {
            Option::None
        }
    }
}

fn mixed(primary/2: bool, secondary/3: bool) -> Option[string] {
    let value/4: i32 =
      match (maybe_primary : (bool) -> Option[i32])((primary/2 : bool)) {
          Option::Some(try_value/18: i32) => (try_value/18 : i32),
          Option::None => return Option::None,
      };
    let label/6: string =
      match (maybe_secondary : (bool) -> Option[i32])((secondary/3 : bool)) {
          Option::Some(extra/5: i32) =>
            "extra=" + (i32::to_string : (i32) -> string)((extra/5 : i32)),
          Option::None => "extra=none",
      };
    Option::Some(
      "value=" + (i32::to_string : (i32) -> string)((value/4 : i32)) + "," + (label/6 : string)
    )
}

fn show(opt/7: Option[string]) -> string {
    match (opt/7 : Option[string]) {
        Option::Some(value/8: string) => "some=" + (value/8 : string),
        Option::None => "none",
    }
}

fn main() -> () {
    (println : (string) -> ())(
      (show : (Option[string]) -> string)((mixed : (bool, bool) -> Option[string])(true, true))
    );
    (println : (string) -> ())(
      (show : (Option[string]) -> string)((mixed : (bool, bool) -> Option[string])(true, false))
    );
    (println : (string) -> ())(
      (show : (Option[string]) -> string)((mixed : (bool, bool) -> Option[string])(false, true))
    );
}