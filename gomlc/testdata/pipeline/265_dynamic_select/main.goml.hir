package main
file main.goml
  fn print_selection(local/1/0: channel::Selection[isize]) -> () {
      match value/0 {
          channel::Selection::Received { index: local/1/1, value: local/1/2 } =>
            {
                println(index/1);
                println(value/2.unwrap_or(-1))
            },
          channel::Selection::Sent { index: local/1/3 } => println(index/3),
      }
  }

  fn main() -> () {
      let local/1/4: Channel[isize] = Channel::new(1);
      let local/1/5: Channel[isize] = Channel::new(1);
      first/4.send(10);
      second/5.send(20);
      let local/1/6 =
        Vec::from_array(
          [
            channel::Operation::Receive(first/4.receiver()),
            channel::Operation::Receive(second/5.receiver())
          ]
        );
      match channel::try_select_priority(slice(operations/6, 0, operations/6.len())) {
          Ok(Some(local/1/7)) => def/1/0(value/7),
          _ => println(-1),
      };
      match channel::try_select(slice(operations/6, 0, operations/6.len())) {
          Ok(Some(local/1/8)) => def/1/0(value/8),
          _ => println(-2),
      };
      let local/1/9: Channel[isize] = Channel::new(0);
      let local/1/10: Channel[isize] = Channel::new(1);
      let local/1/11 =
        Vec::from_array(
          [
            channel::Operation::Receive(empty/9.receiver()),
            channel::Operation::Send(target/10.sender(), 30)
          ]
        );
      match channel::select(slice(mixed/11, 0, mixed/11.len())) {
          Ok(local/1/12) => def/1/0(value/12),
          Err(_) => println(-3),
      };
      println(target/10.recv().unwrap_or(-4));
      let local/1/13 = Vec::from_array([channel::Operation::Receive(empty/9.receiver())]);
      println(
        match channel::try_select(slice(none/13, 0, none/13.len())) {
            Ok(None) => 40,
            _ => -5,
        }
      );
      let local/1/14: Vec[channel::Operation[isize]] = Vec::new();
      println(
        match channel::select(slice(no_operations/14, 0, no_operations/14.len())) {
            Err(channel::SelectError::Empty) => 50,
            _ => -6,
        }
      )
  }