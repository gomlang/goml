impl Parent for Count {
  fn get(self/0: Count) -> i32 {
      (self/0 : Count).value
  }
}

impl Child for Count {
  fn child(self/1: Count) -> () {}
}

fn get_from_child[C](value/2: C) -> C::Item where C: Child, C: Parent {
    (Parent::get : (C) -> C::Item)((value/2 : C))
}

fn main() -> () {
    (println : (i32) -> ())((get_from_child : (Count) -> i32)(Count { value: 42 }));
}