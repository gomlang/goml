trait Child: Parent {
    fn child(self: Self) -> ();
}

trait Parent {
    type Item;
    fn get(self: Self) -> Self::Item;
}

struct Count {
    value: i32,
}

impl Parent for Count {
    type Item = i32;

    fn get(self: Count) -> i32 {
        self.value
    }
}

impl Child for Count {
    fn child(self: Count) -> () {}
}

fn get_from_child[C: Child](value: C) -> C::Item {
    Parent::get(value)
}

fn main() -> () {
    println(get_from_child(Count { value: 42 }));
}
