package main
file main.goml
  trait Child: Parent {
    fn child(Self) -> ();
  }

  trait Parent {
    type Item;
    fn get(Self) -> Self::Item;
  }

  struct Count {
      value: i32,
  }

  impl Parent for Count {
    type Item = i32;
    fn get(local/1/0: Count) -> i32 {
        self/0.value
    }
  }

  impl Child for Count {
    fn child(local/1/1: Count) -> () {}
  }

  fn get_from_child[C: Child](local/1/2: C) -> C::Item {
      Parent::get(value/2)
  }

  fn main() -> () {
      println(def/1/5(Count { value: 42 }));
  }