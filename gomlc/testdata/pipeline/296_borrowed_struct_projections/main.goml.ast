package main;
struct Large {
    values: [isize; 16],
    shared: Ref[isize],
}

struct Outer {
    inner: Large,
}

fn make(value: isize) -> Outer {
    Outer { inner: Large { values: [value; 16], shared: Ref::new(value) } }
}

fn read(value: Large) -> isize {
    value.values[0] + value.values[15] + value.shared.get()
}

fn replace(value: Large, next: Large) -> isize {
    let mut local = value;
    local = next;
    read(local)
}

fn returned(value: Outer) -> Large {
    value.inner
}

fn captured(value: Outer) -> () -> isize {
    let field = value.inner;
    || read(field)
}

fn main() -> () {
    let first = make(1);
    let field = first.inner;
    field.shared.set(3);
    println(read(first.inner));
    println(replace(field, make(2).inner));
    println(read(field));
    println(read(returned(first)));
    println(captured(first)());
    let mut current = make(4);
    let snapshot = current.inner;
    current = make(5);
    println(read(snapshot));
    println(read(current.inner));
    let cell = Ref::new(make(6));
    let from_ref = cell.get().inner;
    cell.set(make(7));
    println(read(from_ref));
    println(read(cell.get().inner));
    let values = Vec::from_array([make(8), make(9)]);
    let from_vector = values[0].inner;
    values[0] = make(10);
    println(read(from_vector));
    println(read(values[0].inner));
    let closures: Vec[() -> isize] = Vec::new();
    for index in
      0..3 {
        let current = make(index);
        let value = current.inner;
        closures.push(|| read(value));
    };
    for closure in
      closures {
        println(closure());
    };
    let mut loop_value = make(11);
    for index in
      0..3 {
        let previous = loop_value.inner;
        loop_value = make(index);
        println(read(previous));
    };
    let selected =
      if first.inner.shared.get() == 3 {
          {
              first
          }
      } else {
          {
              make(12)
          }
      };
    println(read(selected.inner));
}

