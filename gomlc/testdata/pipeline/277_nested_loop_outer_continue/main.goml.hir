package main
file main.goml
  fn unique_outer_continue() -> isize {
      let local/main/0 = Ref::new(0);
      'outer: loop {
          rounds/0.set(rounds/0.get() + 1);
          if rounds/0.get() == 2 {
              break 'outer rounds/0.get()
          } else {
              loop {
                  if rounds/0.get() == 1 {
                      continue 'outer
                  } else {
                      continue
                  }
              };
              break 'outer 99
          }
      }
  }

  fn mixed_outer_continue_and_local_exit() -> isize {
      let local/main/1 = Ref::new(0);
      'outer: loop {
          rounds/1.set(rounds/1.get() + 1);
          loop {
              if rounds/1.get() == 1 {
                  continue 'outer
              } else {
                  break
              }
          };
          break 'outer 12
      }
  }

  fn main() -> () {
      println(source:4:main:0());
      println(source:4:main:1())
  }