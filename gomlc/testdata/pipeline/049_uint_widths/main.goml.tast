fn main() -> () {
    let start8/0: u8 = 200;
    let add8/1: u8 = 55;
    let sum8/2: u8 = (start8/0 : u8) + (add8/1 : u8);
    let neg8/3: u8 = -(start8/0 : u8);
    let start16/4: u16 = 50000;
    let add16/5: u16 = 12000;
    let sum16/6: u16 = (start16/4 : u16) + (add16/5 : u16);
    let diff16/7: u16 = (sum16/6 : u16) - (start16/4 : u16);
    let start32/8: u32 = 3000000000;
    let add32/9: u32 = 123456789;
    let sum32/10: u32 = (start32/8 : u32) + (add32/9 : u32);
    let neg32/11: u32 = -(add32/9 : u32);
    let start64/12: u64 = 6000000000;
    let add64/13: u64 = 4000000000;
    let sum64/14: u64 = (start64/12 : u64) + (add64/13 : u64);
    let diff64/15: u64 = (sum64/14 : u64) - (add64/13 : u64);
    let message/16: string =
      (ToString::to_string : (u8) -> string)((sum8/2 : u8)) + ", " +
        (ToString::to_string : (u8) -> string)((neg8/3 : u8)) +
        "; " +
        (ToString::to_string : (u16) -> string)((diff16/7 : u16)) +
        "; " +
        (ToString::to_string : (u32) -> string)((neg32/11 : u32)) +
        "; " +
        (ToString::to_string : (u64) -> string)((diff64/15 : u64));
    (println : (string) -> ())((message/16 : string));
}