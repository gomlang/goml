fn main() {
    let start8: u8 = 200;
    let add8: u8 = 55;
    let sum8 = start8 + add8;
    let neg8 = -start8;
    let start16: u16 = 50000;
    let add16: u16 = 12000;
    let sum16 = start16 + add16;
    let diff16 = sum16 - start16;
    let start32: u32 = 3000000000;
    let add32: u32 = 123456789;
    let sum32 = start32 + add32;
    let neg32 = -add32;
    let start64: u64 = 6000000000;
    let add64: u64 = 4000000000;
    let sum64 = start64 + add64;
    let diff64 = sum64 - add64;
    let message = sum8.to_string() + ", " + neg8.to_string() + "; " + diff16.to_string() + "; "
        + neg32.to_string()
        + "; "
        + diff64.to_string();
    println(message);
}
