const ANSWER: isize = 40 + 2;

const ALTERNATE: isize = 7;

const ENABLED: bool = true;

const GREETING: string = "hello";

const MARKER: byte = b'A';

const RATIO: f64 = 1.5;

const CLASSIFIED_AT_COMPILE_TIME: isize = comptime_classify(42);

const COMPUTED_ANSWER: isize = make_answer();

const COMPUTED_ENABLED: bool = make_enabled();

#[comptime]
fn make_answer() -> isize {
    42
}

#[comptime]
fn make_enabled() -> bool {
    true
}

#[comptime]
fn comptime_classify(value: isize) -> isize {
    match value {
        COMPUTED_ANSWER => 1,
        _ => 0,
    }
}

fn classify(value: isize) -> string {
    match value {
        ANSWER | ALTERNATE => "known",
        _ => "other",
    }
}

fn classify_bool(value: bool) -> string {
    match value {
        ENABLED => "enabled",
        false => "disabled",
    }
}

fn classify_computed_bool(value: bool) -> string {
    match value {
        COMPUTED_ENABLED => "enabled",
        false => "disabled",
    }
}

fn classify_comptime_guard(value: bool) -> string {
    let result = match value {
        true if comptime {
            true
        } => "enabled",
        false => "disabled",
    };
    result
}

fn classify_pair(value: (isize, byte)) -> bool {
    match value {
        (ANSWER, MARKER) => true,
        _ => false,
    }
}

fn classify_string(value: string) -> bool {
    match value {
        GREETING => true,
        _ => false,
    }
}

fn classify_float(value: f64) -> bool {
    match value {
        RATIO => true,
        _ => false,
    }
}

fn shadow_constant() -> isize {
    let answer = 9;
    answer
}

fn explicit_binding(value: isize) -> isize {
    match value {
        answer @ _ => answer,
    }
}

fn matches_if_let(value: isize) -> bool {
    if let ANSWER = value {
        true
    } else {
        false
    }
}

fn matches_let_else(value: isize) -> bool {
    let ANSWER = value else {
        return false
    };
    true
}

fn for_binding() -> isize {
    let total = Ref::new(0);
    for answer in[1, 2] {
        total.set(total.get() + answer)
    }
    total.get()
}

fn main() -> () {
    println(classify(42));
    println(classify(7));
    println(classify(0));
    println(classify_bool(true));
    println(classify_bool(false));
    println(classify_computed_bool(true));
    println(classify_computed_bool(false));
    println(classify_comptime_guard(true));
    println(classify_comptime_guard(false));
    println(classify_pair((42, b'A')));
    println(classify_pair((42, b'B')));
    println(classify_string("hello"));
    println(classify_float(1.5));
    println(shadow_constant());
    println(explicit_binding(11));
    println(matches_if_let(42));
    println(matches_if_let(41));
    println(matches_let_else(42));
    println(matches_let_else(41));
    println(for_binding());
    println(CLASSIFIED_AT_COMPILE_TIME)
}
