package main
file main.goml
  const ANSWER: isize = 40 + 2;

  const ALTERNATE: isize = 7;

  const ENABLED: bool = true;

  const GREETING: string = "hello";

  const MARKER: byte = b'\x41';

  const RATIO: f64 = 1.5;

  const CLASSIFIED_AT_COMPILE_TIME: isize = def/1/11(42);

  const COMPUTED_ANSWER: isize = def/1/9();

  const COMPUTED_ENABLED: bool = def/1/10();

  #[comptime]
  fn make_answer() -> isize {
      42
  }

  #[comptime]
  fn make_enabled() -> bool {
      true
  }

  #[comptime]
  fn comptime_classify(local/1/0: isize) -> isize {
      match value/0 {
          def/1/7 => 1,
          _ => 0,
      }
  }

  fn classify(local/1/1: isize) -> string {
      match value/1 {
          def/1/0 | def/1/1 => "known",
          _ => "other",
      }
  }

  fn classify_bool(local/1/2: bool) -> string {
      match value/2 {
          def/1/2 => "enabled",
          false => "disabled",
      }
  }

  fn classify_computed_bool(local/1/3: bool) -> string {
      match value/3 {
          def/1/8 => "enabled",
          false => "disabled",
      }
  }

  fn classify_comptime_guard(local/1/4: bool) -> string {
      let local/1/5 =
        match value/4 {
            true if comptime {
                true
            } =>
              "enabled",
            false => "disabled",
        };
      result/5
  }

  fn classify_pair(local/1/6: (isize, byte)) -> bool {
      match value/6 {
          (def/1/0, def/1/4) => true,
          _ => false,
      }
  }

  fn classify_string(local/1/7: string) -> bool {
      match value/7 {
          def/1/3 => true,
          _ => false,
      }
  }

  fn classify_float(local/1/8: f64) -> bool {
      match value/8 {
          def/1/5 => true,
          _ => false,
      }
  }

  fn shadow_constant() -> isize {
      let local/1/9 = 9;
      answer/9
  }

  fn explicit_binding(local/1/10: isize) -> isize {
      match value/10 {
          local/1/11 @ _ => answer/11,
      }
  }

  fn matches_if_let(local/1/12: isize) -> bool {
      match value/12 {
          def/1/0 =>
            {
                true
            },
          _ =>
            {
                false
            },
      }
  }

  fn matches_let_else(local/1/13: isize) -> bool {
      let def/1/0 =
        value/13 else
        {
            return false
        };
      true
  }

  fn for_binding() -> isize {
      let local/1/14 = Ref::new(0);
      for local/1/15 in
        [1, 2] {
          total/14.set(total/14.get() + answer/15)
      };
      total/14.get()
  }

  fn main() -> () {
      println(def/1/12(42));
      println(def/1/12(7));
      println(def/1/12(0));
      println(def/1/13(true));
      println(def/1/13(false));
      println(def/1/14(true));
      println(def/1/14(false));
      println(def/1/15(true));
      println(def/1/15(false));
      println(def/1/16((42, b'\x41')));
      println(def/1/16((42, b'\x42')));
      println(def/1/17("hello"));
      println(def/1/18(1.5));
      println(def/1/19());
      println(def/1/20(11));
      println(def/1/21(42));
      println(def/1/21(41));
      println(def/1/22(42));
      println(def/1/22(41));
      println(def/1/23());
      println(def/1/6)
  }