const ANSWER: isize = 42;
const ALTERNATE: isize = 7;
const ENABLED: bool = true;
const GREETING: string = "hello";
const MARKER: u8 = 65;
const RATIO: f64 = 1.5;
const COMPUTED_ANSWER: isize = 42;
const COMPUTED_ENABLED: bool = true;
const CLASSIFIED_AT_COMPILE_TIME: isize = 1;

fn make_answer() -> isize {
    42
}

fn make_enabled() -> bool {
    true
}

fn comptime_classify(value/0: isize) -> isize {
    match (value/0 : isize) {
        COMPUTED_ANSWER => 1,
        _ : isize => 0,
    }
}

fn classify(value/1: isize) -> string {
    match (value/1 : isize) {
        42 | 7 => "known",
        _ : isize => "other",
    }
}

fn classify_bool(value/2: bool) -> string {
    match (value/2 : bool) {
        true => "enabled",
        false => "disabled",
    }
}

fn classify_computed_bool(value/3: bool) -> string {
    match (value/3 : bool) {
        COMPUTED_ENABLED => "enabled",
        false => "disabled",
    }
}

fn classify_comptime_guard(value/4: bool) -> string {
    let result/5: string =
      match (value/4 : bool) {
          true if true => "enabled",
          false => "disabled",
      };
    (result/5 : string)
}

fn classify_pair(value/6: (isize, u8)) -> bool {
    match (value/6 : (isize, u8)) {
        (42, 65) => true,
        _ : (isize, u8) => false,
    }
}

fn classify_string(value/7: string) -> bool {
    match (value/7 : string) {
        "hello" => true,
        _ : string => false,
    }
}

fn classify_float(value/8: f64) -> bool {
    match (value/8 : f64) {
        RATIO => true,
        _ : f64 => false,
    }
}

fn shadow_constant() -> isize {
    let answer/9: isize = 9;
    (answer/9 : isize)
}

fn explicit_binding(value/10: isize) -> isize {
    match (value/10 : isize) {
        answer/11 @ _ : isize => (answer/11 : isize),
    }
}

fn matches_if_let(value/12: isize) -> bool {
    match (value/12 : isize) {
        42 =>
          {
              true
          },
        _ : isize =>
          {
              false
          },
    }
}

fn matches_let_else(value/13: isize) -> bool {
    let 42 =
      (value/13 : isize) else
      {
          return false
      };
    true
}

fn for_binding() -> isize {
    let total/14: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    for answer/15: isize in
      [1, 2] {
        (Ref[isize]::set : (Ref[isize], isize) -> ())(
          (total/14 : Ref[isize]),
          (Ref[isize]::get : (Ref[isize]) -> isize)((total/14 : Ref[isize])) + (answer/15 : isize)
        )
    };
    (Ref[isize]::get : (Ref[isize]) -> isize)((total/14 : Ref[isize]))
}

fn main() -> () {
    (println : (string) -> ())((classify : (isize) -> string)(42));
    (println : (string) -> ())((classify : (isize) -> string)(7));
    (println : (string) -> ())((classify : (isize) -> string)(0));
    (println : (string) -> ())((classify_bool : (bool) -> string)(true));
    (println : (string) -> ())((classify_bool : (bool) -> string)(false));
    (println : (string) -> ())((classify_computed_bool : (bool) -> string)(true));
    (println : (string) -> ())((classify_computed_bool : (bool) -> string)(false));
    (println : (string) -> ())((classify_comptime_guard : (bool) -> string)(true));
    (println : (string) -> ())((classify_comptime_guard : (bool) -> string)(false));
    (println : (bool) -> ())((classify_pair : ((isize, u8)) -> bool)((42, 65)));
    (println : (bool) -> ())((classify_pair : ((isize, u8)) -> bool)((42, 66)));
    (println : (bool) -> ())((classify_string : (string) -> bool)("hello"));
    (println : (bool) -> ())((classify_float : (f64) -> bool)(1.5));
    (println : (isize) -> ())((shadow_constant : () -> isize)());
    (println : (isize) -> ())((explicit_binding : (isize) -> isize)(11));
    (println : (bool) -> ())((matches_if_let : (isize) -> bool)(42));
    (println : (bool) -> ())((matches_if_let : (isize) -> bool)(41));
    (println : (bool) -> ())((matches_let_else : (isize) -> bool)(42));
    (println : (bool) -> ())((matches_let_else : (isize) -> bool)(41));
    (println : (isize) -> ())((for_binding : () -> isize)());
    (println : (isize) -> ())((CLASSIFIED_AT_COMPILE_TIME : isize))
}