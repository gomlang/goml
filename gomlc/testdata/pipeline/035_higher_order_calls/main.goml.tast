fn double(x/0: i32) -> i32 {
    (x/0 : i32) * 2
}

fn increment(x/1: i32) -> i32 {
    (x/1 : i32) + 1
}

fn chooser(flag/2: bool) -> (i32) -> i32 {
    if (flag/2 : bool) {
        {
            (double : (i32) -> i32)
        }
    } else {
        {
            (increment : (i32) -> i32)
        }
    }
}

fn main() -> () {
    let xs/3: [(i32) -> i32; 2] = [(double : (i32) -> i32), (increment : (i32) -> i32)];
    let f/4: (i32) -> i32 = (xs/3 : [(i32) -> i32; 2])[0];
    let g/5: (i32) -> i32 = (xs/3 : [(i32) -> i32; 2])[1];
    let _ : () = (println : (i32) -> ())((g/5 : (i32) -> i32)((f/4 : (i32) -> i32)(10)));
    let chosen/6: (i32) -> i32 = (chooser : (bool) -> (i32) -> i32)(true);
    let applied/7: i32 = (chosen/6 : (i32) -> i32)(5);
    let direct/8: i32 = (chooser : (bool) -> (i32) -> i32)(false)(5);
    let printer/9: (string) -> () = (println : (string) -> ());
    let _ : () =
      (printer/9 : (string) -> ())((i32::to_string : (i32) -> string)((applied/7 : i32)));
    let _ : () = (printer/9 : (string) -> ())((i32::to_string : (i32) -> string)((direct/8 : i32)));
}