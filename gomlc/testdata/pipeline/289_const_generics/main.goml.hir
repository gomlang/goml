  type Bytes[const N: usize] = [u8; N];

  enum Storage[T, const N: usize] {
      Values([T; N]),
      Empty
  }

  trait Limit[const N: usize] {
    fn $associated_const:VALUE() -> usize;
  }

  fn trait_default#Limit#$associated_const:VALUE[const N: usize, Self: Limit[N]]() -> usize {
      N
  }

  struct Token {}

  impl Limit[3] for Token {}

  fn identity[const N: usize](local/main/9: Bytes[N]) -> Bytes[N] {
