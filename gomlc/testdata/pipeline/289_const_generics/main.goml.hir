      N
  }

  fn more[const N: usize](local/main/3: [i32; (N + 1)]) -> i32 {
      values/3[0]
  }

  fn increment[const N: usize](local/main/4: [i32; N]) -> [i32; N] {
      let mut local/main/5 = values/4;
      result/5[0] += 1;
      result/5
  }

  fn total[const N: usize](local/main/6: [i32; N]) -> i32 {
