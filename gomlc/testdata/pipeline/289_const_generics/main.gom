const WIDTH: usize = 1 + 2;

struct Buffer[const N: usize] {
    data: [i32; N],
}

trait Length {
    fn size(self: Self) -> usize;
}

impl[const N: usize] Length for[i32; N] {
    fn size(self: [i32; N]) -> usize {
        N
    }
}

fn first[const N: usize](values: [i32; N]) -> i32 {
    values[0]
}

fn count[const N: usize](values: [i32; N]) -> usize {
    N
}

fn more[const N: usize](values: [i32; N + 1]) -> i32 {
    values[0]
}

fn increment[const N: usize](values: [i32; N]) -> [i32; N] {
    let mut result = values;
    result[0] += 1;
    result
}

fn total[const N: usize](values: [i32; N]) -> i32 {
    let mut result = 0;
    for value in values {
        result += value;
    }
    result
}

type Bytes[const N: usize] = [u8; N];

enum Storage[T, const N: usize] {
    Values([T; N]),
    Empty,
}

trait Limit[const N: usize] {
    const VALUE: usize = N;
}

struct Token {}

impl Limit[3]for Token {}

fn identity[const N: usize](input: Bytes[N]) -> Bytes[N] {
    input
}

fn main() -> () {
    let values: [i32; WIDTH * 2] = [1, 2, 3, 4, 5, 6];
    println(first(values));
    println(count(values));
    let buffer: Buffer[3] = Buffer { data: [7, 8, 9] };
    println(first(buffer.data));
    println(count::[3](buffer.data));
    println(buffer.data.size());
    println(values.size());
    println(more::[2]([9, 8, 7]));
    println(total(increment(buffer.data)));
    let bytes: Bytes[3] = identity(b"abc");
    println(bytes[1]);
    let stored: Storage[i32, 2] = Storage::Values([1, 2]);
    match stored {
        Values(items) => println(items[1]),
        Empty => (),
    }
    println(Token::VALUE);
}
