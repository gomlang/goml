package main;
fn range(start: i32, end: i32) -> i32 {
    start + end
}

fn endpoint(calls: Ref[isize], value: isize) -> isize {
    calls.set(calls.get() + 1);
    value
}

fn main() -> () {
    for value in
      1..4 {
        println(value);
    };
    let calls = Ref::new(0);
    for value in
      endpoint(calls, 4)..=endpoint(calls, 6) {
        println(value);
    };
    for value in
      3..=1 {
        println(value);
    };
    let maximum = 9223372036854775807;
    for value in
      maximum..=maximum {
        println(value);
    };
    let iterator = 8..=8;
    match Iterator::next(iterator) {
        Some(value) => println(value),
        None => println("missing"),
    };
    println(calls.get());
    println(range(10, 20));
}

