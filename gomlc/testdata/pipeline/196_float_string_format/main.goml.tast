fn main() -> () {
    (println : (string) -> ())((ToString::to_string : (f64) -> string)(18318654708.7));
    (println : (string) -> ())((ToString::to_string : (f64) -> string)(0.0000001));
    let zero/0: f64 = 0.0;
    let negative_one/1: f64 = -1.0;
    (println : (string) -> ())(
      (ToString::to_string : (f64) -> string)((negative_one/1 : f64) * (zero/0 : f64))
    );
    (println : (string) -> ())((ToString::to_string : (f64) -> string)(1 / (zero/0 : f64)));
    (println : (string) -> ())((ToString::to_string : (f64) -> string)(-1 / (zero/0 : f64)));
    (println : (string) -> ())(
      (ToString::to_string : (f64) -> string)((zero/0 : f64) / (zero/0 : f64))
    );
    let wide/2: f64 = 12345678.0;
    (println : (string) -> ())((ToString::to_string : (f64) -> string)((wide/2 : f64)))
}