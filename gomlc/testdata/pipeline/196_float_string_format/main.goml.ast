package main;
fn main() -> () {
    println(18318654708.7.to_string());
    println(0.0000001.to_string());
    let zero = 0.0;
    let negative_one = -1.0;
    println(negative_one * zero.to_string());
    println(1.0 / zero.to_string());
    println(-1.0 / zero.to_string());
    println(zero / zero.to_string());
    let wide = 12345678.0;
    println(wide.to_string())
}

