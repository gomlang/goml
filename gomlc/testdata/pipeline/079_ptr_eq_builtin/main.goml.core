fn trait_impl#ToString#bool#to_string(self/0: bool) -> string {
  @runtime(core.bool_to_string)(self/0)
}

fn trait_impl#PartialEq#isize#eq(self/0: isize, other/0: isize) -> bool {
  (self/0 == other/0)
}

fn trait_impl#Hash#isize#hash(self/0: isize) -> u64 {
  @runtime(core.int_hash)(self/0)
}

fn inherent#Ref#Ref[T]#new[T](value/0: T) -> Ref[T] {
  @intrinsic(ref.new)(value/0)
}

fn println[T](value/0: T) -> () {
  @runtime(core.string_println)(trait_call[ToString::to_string](value/0))
}

fn main() -> () {
  let a/0 = inherent#Ref#Ref[isize]#new(1) in
  let b/0 = a/0 in
  let c/0 = inherent#Ref#Ref[isize]#new(1) in
