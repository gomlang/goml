fn main() -> () {
    let a/0: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(1);
    let b/1: Ref[isize] = (a/0 : Ref[isize]);
    let c/2: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(1);
    (println : (bool) -> ())(
      (@intrinsic(ref.ptr_eq) : (Ref[isize], Ref[isize]) -> bool)(
        (a/0 : Ref[isize]),
        (b/1 : Ref[isize])
      )
    );
    (println : (bool) -> ())(
      (@intrinsic(ref.ptr_eq) : (Ref[isize], Ref[isize]) -> bool)(
        (a/0 : Ref[isize]),
        (c/2 : Ref[isize])
      )
    );
}