fn trait_impl#ToString#string#to_string(self/0: string) -> string {
  self/0
}

fn println[T](value/0: T) -> () {
  @runtime(core.string_println)(trait_call[ToString::to_string](value/0))
}

fn trait_impl#A#S#foo(self/0: S) -> string {
  "A"
}

fn trait_impl#B#S#foo(self/0: S) -> string {
  "B"
}

fn trait_impl#C#S#bar(self/0: S) -> string {
  "C"
}

fn pick_a[T](x/0: T) -> string {
  trait_call[A::foo](x/0)
}

fn bar_it[T](x/0: T) -> string {
  trait_call[C::bar](x/0)
}

fn main() -> () {
  let s/0 = S {} in
  let mtmp0 = println(pick_a(s/0)) in
  {
    let mtmp1 = println(bar_it(s/0)) in
    {
      ()
    }
  }
}