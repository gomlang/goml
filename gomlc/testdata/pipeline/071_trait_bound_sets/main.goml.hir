package main
file main.goml
  trait A {
    fn foo(Self) -> string;
  }

  trait B {
    fn foo(Self) -> string;
  }

  trait C {
    fn bar(Self) -> string;
  }

  struct S {}

  impl A for S {
    fn foo(local/main/0: S) -> string {
        "A"
    }
  }

  impl B for S {
    fn foo(local/main/1: S) -> string {
        "B"
    }
  }

  impl C for S {
    fn bar(local/main/2: S) -> string {
        "C"
    }
  }

  fn pick_a[T: B + A + A](local/main/3: T) -> string {
      A::foo(x/3)
  }

  fn bar_it[T: C](local/main/4: T) -> string {
      x/4.bar()
  }

  fn main() {
      let local/main/5 = S {};
      let _ = println(source:4:main:7(s/5));
      let _ = println(source:4:main:8(s/5));
  }