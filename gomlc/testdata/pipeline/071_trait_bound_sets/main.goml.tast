impl A for S {
  fn foo(self/0: S) -> string {
      "A"
  }
}

impl B for S {
  fn foo(self/1: S) -> string {
      "B"
  }
}

impl C for S {
  fn bar(self/2: S) -> string {
      "C"
  }
}

fn pick_a[T](x/3: T) -> string where T: B, T: A {
    (A::foo : (T) -> string)((x/3 : T))
}

fn bar_it[T](x/4: T) -> string where T: C {
    (C::bar : (T) -> string)((x/4 : T))
}

fn main() -> () {
    let s/5: S = S {};
    let _ : () = (println : (string) -> ())((pick_a : (S) -> string)((s/5 : S)));
    let _ : () = (println : (string) -> ())((bar_it : (S) -> string)((s/5 : S)));
}