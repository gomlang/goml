fn pair[First, Second](first/0: First, second/1: Second) -> (First, Second) {
    ((first/0 : First), (second/1 : Second))
}

fn main() -> () {
    let make/2: (i32, string) -> (i32, string) = (pair : (i32, string) -> (i32, string));
    let value/3: (i32, string) = (make/2 : (i32, string) -> (i32, string))(1, "x");
    (println : (string) -> ())(
      (i32::to_string : (i32) -> string)((value/3 : (i32, string)).0) + (value/3 : (i32, string)).1
    )
}