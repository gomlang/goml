package main
file main.goml
  trait Convert[T] {
    type Output;
    fn convert(Self) -> Self::Output;
  }

  struct Value {}

  impl Convert[i32] for Value {
    type Output = string;
    fn convert(local/1/0: Value) -> string {
        "isize"
    }
  }

  impl Convert[string] for Value {
    type Output = i32;
    fn convert(local/1/1: Value) -> i32 {
        7
    }
  }

  fn main() -> () {
      let local/1/2: string = Convert[i32]::convert(Value {});
      let local/1/3: i32 = Convert[string]::convert(Value {});
      println(text/2);
      println(number/3);
  }