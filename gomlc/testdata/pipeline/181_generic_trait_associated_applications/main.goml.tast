impl Convert[i32] for Value {
  fn convert(self/0: Value) -> string {
      "isize"
  }
}

impl Convert[string] for Value {
  fn convert(self/1: Value) -> i32 {
      7
  }
}

fn main() -> () {
    let text/2: string = (Convert[i32]::convert : (Value) -> string)(Value {});
    let number/3: i32 = (Convert[string]::convert : (Value) -> i32)(Value {});
    (println : (string) -> ())((text/2 : string));
    (println : (i32) -> ())((number/3 : i32));
}