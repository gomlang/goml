fn list_length[T](xs/0: List[T]) -> i32 {
  match xs/0 {
    List::Nil => {
      0
    },
    List::Cons(x0, x1) => {
      {
        let x1 = List::Cons._1(xs/0) in
        {
          let tail/0 = x1 in
          (1 + list_length(tail/0))
        }
      }
    },
  }
}

fn int_list_length(xs/0: List[i32]) -> i32 {
  match xs/0 {
    List::Nil => {
      0
