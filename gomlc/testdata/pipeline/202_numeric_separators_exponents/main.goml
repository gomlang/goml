fn accepts_array_length(value: [i32; 1_0]) -> () {
    let _ = value;
}

fn main() -> () {
    let integer: i32 = 1_000;
    let unsigned: u64 = 4_294_967_296;
    let float: f64 = 1.25e2;
    let small: f32 = 2_5.0_0e-1;
    println(integer);
    println(unsigned);
    println(float);
    println(small);
    match integer {
        1_000 => println("matched"),
        _ => println("missed"),
    }
}
