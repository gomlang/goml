package main;
fn accepts_array_length(value: [i32; 10]) -> () {
    let _ = value;
}

fn main() -> () {
    let integer: i32 = 1000;
    let unsigned: u64 = 4294967296;
    let float: f64 = 1.25e2;
    let small: f32 = 25.00e-1;
    println(integer);
    println(unsigned);
    println(float);
    println(small);
    match integer {
        1000 => println("matched"),
        _ => println("missed"),
    }
}

