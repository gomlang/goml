fn accepts_array_length(value/0: [i32; 10]) -> () {
    let _ : [i32; 10] = (value/0 : [i32; 10]);
}

fn main() -> () {
    let integer/1: i32 = 1000;
    let unsigned/2: u64 = 4294967296;
    let float/3: f64 = 125;
    let small/4: f32 = 2.5;
    (println : (i32) -> ())((integer/1 : i32));
    (println : (u64) -> ())((unsigned/2 : u64));
    (println : (f64) -> ())((float/3 : f64));
    (println : (f32) -> ())((small/4 : f32));
    match (integer/1 : i32) {
        1000 => (println : (string) -> ())("matched"),
        _ : i32 => (println : (string) -> ())("missed"),
    }
}