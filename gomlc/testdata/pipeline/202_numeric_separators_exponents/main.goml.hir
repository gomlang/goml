package main
file main.goml
  fn accepts_array_length(local/main/0: [i32; 10]) -> () {
      let _ = value/0;
  }

  fn main() -> () {
      let local/main/1: i32 = 1000;
      let local/main/2: u64 = 4294967296;
      let local/main/3: f64 = 1.25e2;
      let local/main/4: f32 = 25.00e-1;
      println(integer/1);
      println(unsigned/2);
      println(float/3);
      println(small/4);
      match integer/1 {
          1000 => println("matched"),
          _ => println("missed"),
      }
  }