fn match_mixed_pair(pair/0: (i32, string)) -> i32 {
    match (pair/0 : (i32, string)) {
        (0, "zero") => 1,
        (0, _ : string) => 2,
        (1, "one") => 3,
        (_ : i32, "zero") => 4,
        _ : (i32, string) => 5,
    }
}

fn match_mixed_enum(value/1: Mixed) -> i32 {
    match (value/1 : Mixed) {
        Mixed::OnlyInt(0) => 6,
        Mixed::OnlyInt(_ : i32) => 7,
        Mixed::OnlyStr("zero") => 8,
        Mixed::OnlyStr(_ : string) => 9,
        Mixed::Both(0, "zero") => 10,
        Mixed::Both(0, _ : string) => 11,
        Mixed::Both(_ : i32, "zero") => 12,
        Mixed::Both(_ : i32, _ : string) => 13,
    }
}

fn main() -> () {
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)((match_mixed_pair : ((i32, string)) -> i32)((0, "zero")))
      );
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)(
          (match_mixed_pair : ((i32, string)) -> i32)((0, "other"))
        )
      );
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)((match_mixed_pair : ((i32, string)) -> i32)((1, "one")))
      );
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)((match_mixed_pair : ((i32, string)) -> i32)((2, "zero")))
      );
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)((match_mixed_pair : ((i32, string)) -> i32)((2, "two")))
      );
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)((match_mixed_enum : (Mixed) -> i32)(Mixed::OnlyInt(0)))
      );
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)((match_mixed_enum : (Mixed) -> i32)(Mixed::OnlyInt(5)))
      );
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)(
          (match_mixed_enum : (Mixed) -> i32)(Mixed::OnlyStr("zero"))
        )
      );
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)(
          (match_mixed_enum : (Mixed) -> i32)(Mixed::OnlyStr("hello"))
        )
      );
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)(
          (match_mixed_enum : (Mixed) -> i32)(Mixed::Both(0, "zero"))
        )
      );
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)(
          (match_mixed_enum : (Mixed) -> i32)(Mixed::Both(0, "hello"))
        )
      );
    let _ : () =
      (println : (string) -> ())(
        (i32::to_string : (i32) -> string)(
          (match_mixed_enum : (Mixed) -> i32)(Mixed::Both(2, "zero"))
        )
      );
    (println : (string) -> ())(
      (i32::to_string : (i32) -> string)(
        (match_mixed_enum : (Mixed) -> i32)(Mixed::Both(3, "three"))
      )
    )
}