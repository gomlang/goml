package main
file main.goml
  fn match_mixed_pair(local/1/0: (i32, string)) -> i32 {
      match pair/0 {
          (0, "zero") => 1,
          (0, _) => 2,
          (1, "one") => 3,
          (_, "zero") => 4,
          _ => 5,
      }
  }

  enum Mixed {
      OnlyInt(i32),
      OnlyStr(string),
      Both(i32, string)
  }

  fn match_mixed_enum(local/1/1: Mixed) -> i32 {
      match value/1 {
          OnlyInt(0) => 6,
          OnlyInt(_) => 7,
          OnlyStr("zero") => 8,
          OnlyStr(_) => 9,
          Both(0, "zero") => 10,
          Both(0, _) => 11,
          Both(_, "zero") => 12,
          Both(_, _) => 13,
      }
  }

  fn main() {
      let _ = println(def/1/0((0, "zero")).to_string());
      let _ = println(def/1/0((0, "other")).to_string());
      let _ = println(def/1/0((1, "one")).to_string());
      let _ = println(def/1/0((2, "zero")).to_string());
      let _ = println(def/1/0((2, "two")).to_string());
      let _ = println(def/1/2(ctor(def/1/1::v0)(0)).to_string());
      let _ = println(def/1/2(ctor(def/1/1::v0)(5)).to_string());
      let _ = println(def/1/2(ctor(def/1/1::v1)("zero")).to_string());
      let _ = println(def/1/2(ctor(def/1/1::v1)("hello")).to_string());
      let _ = println(def/1/2(ctor(def/1/1::v2)(0, "zero")).to_string());
      let _ = println(def/1/2(ctor(def/1/1::v2)(0, "hello")).to_string());
      let _ = println(def/1/2(ctor(def/1/1::v2)(2, "zero")).to_string());
      println(def/1/2(ctor(def/1/1::v2)(3, "three")).to_string())
  }