fn maybe_value(flag: bool) -> Option[i32] {
    if flag {
        Option::Some(4)
    } else {
        Option::None
    }
}

fn add(a: i32, b: i32) -> i32 {
    a + b
}

fn plus_two(flag: bool) -> Option[i32] {
    Option::Some(add(maybe_value(flag)?, 2))
}

fn show(opt: Option[i32]) -> string {
    match opt {
        Option::Some(value) => "some=" + value.to_string(),
        Option::None => "none",
    }
}

fn main() -> () {
    println(show(plus_two(true)));
    println(show(plus_two(false)));
}
