fn maybe_value(flag/0: bool) -> Option[i32] {
    if (flag/0 : bool) {
        {
            Option::Some(4)
        }
    } else {
        {
            Option::None
        }
    }
}

fn add(a/1: i32, b/2: i32) -> i32 {
    (a/1 : i32) + (b/2 : i32)
}

fn plus_two(flag/3: bool) -> Option[i32] {
    Option::Some(
      (add : (
        i32,
        i32
      ) -> i32)(
        match (maybe_value : (bool) -> Option[i32])((flag/3 : bool)) {
            Option::Some(try_value/15: i32) => (try_value/15 : i32),
            Option::None => return Option::None,
        },
        2
      )
    )
}

fn show(opt/4: Option[i32]) -> string {
    match (opt/4 : Option[i32]) {
        Option::Some(value/5: i32) => "some=" + (i32::to_string : (i32) -> string)((value/5 : i32)),
        Option::None => "none",
    }
}

fn main() -> () {
    (println : (string) -> ())(
      (show : (Option[i32]) -> string)((plus_two : (bool) -> Option[i32])(true))
    );
    (println : (string) -> ())(
      (show : (Option[i32]) -> string)((plus_two : (bool) -> Option[i32])(false))
    );
}