package main;

use module::factory;

fn main() -> () {
    println(factory::forwarded::[factory::First]());
    println(factory::forwarded::[factory::Second]());
    let callback: () -> isize = factory::erased::[factory::First];
    println(callback());
    let inferred: factory::Box[f64] = factory::Box::from_float(1.5);
    let explicit = factory::Box::[f64]::from_float(2.5);
    println(inferred.value + explicit.value);
    println(factory::Box::[Vec[string]]::repeated("nested").first());
}
