package factory;

pub struct Token[T] {
    pub value: isize,
}

pub trait Code {
    fn code() -> Token[Self];
}

pub struct First {}

pub struct Second {}

impl Code for First {
    fn code() -> Token[First] {
        Token { value: 42 }
    }
}

impl Code for Second {
    fn code() -> Token[Second] {
        Token { value: 7 }
    }
}

pub fn erased[T: Code]() -> isize {
    let token: Token[T] = Code::code();
    token.value
}

pub fn forwarded[T: Code]() -> isize {
    erased::[T]()
}

pub fn unused[T: Code]() -> isize {
    erased::[T]()
}

pub struct Box[T] {
    pub value: T,
}

impl Box[f64] {
    pub fn from_float(value: f64) -> Box[f64] {
        Box { value }
    }
}

impl[T] Box[Vec[T]] {
    pub fn first(self: Box[Vec[T]]) -> T {
        self.value[0]
    }

    pub fn repeated(value: T) -> Box[Vec[T]] {
        Box { value: Vec::from_array([value, value]) }
    }
}
