package main;

use std::fs;
use std::fs::notify;
use std::testing;
use std::time;

fn ignored_paths(root: string) -> () {
    ok(fs::create_dir_all(root + "/cache/nested"));
    ok(fs::create_dir_all(root + "/src/nested"));
    let watcher = testing::expect_ok(
        notify::watch_with(
            root,
            notify::Options::new().with_recursive(true).with_ignored_names(
                Vec::from_array(["cache"]),
            ).with_ignore(|name, directory| !directory && name.ends_with(".tmp")),
        ),
        "watch with ignore",
    );
    defer ok(watcher.close());
    ok(fs::write_file_structured(root + "/cache/nested/hidden", "hidden"));
    ok(fs::write_file_structured(root + "/src/hidden.tmp", "hidden"));
    testing::assert_eq(
        testing::expect_ok(watcher.read(time::Duration::from_milliseconds(20)), "ignored events").len(),
        0,
    );
    expect_change(watcher, root + "/src/nested/visible");
    ok(fs::rename(root + "/cache", root + "/returned"));
    let _ = find(read(watcher), root + "/returned", notify::MOVED_TO);
    expect_change(watcher, root + "/returned/nested/visible");
    ok(fs::rename(root + "/returned", root + "/cache"));
    let events = read(watcher);
    let _ = find(events, root + "/returned", notify::MOVED_FROM);
    for event in events {
        testing::assert(event.path != root + "/cache");
    }
    ok(fs::write_file_structured(root + "/cache/nested/hidden-again", "hidden"));
    testing::assert_eq(
        testing::expect_ok(watcher.read(time::Duration::from_milliseconds(20)), "pruned moved tree").len(),
        0,
    );
}
