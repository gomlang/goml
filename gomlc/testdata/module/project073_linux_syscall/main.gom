package main;

use module::kernel;
use std::os::linux::syscall;
use std::os::linux::syscall::{Arg};
use std::testing;
use std::bytes::endian;

#[go_ffi("os", "Getpid")]
extern fn go_getpid() -> isize;

fn main() -> () {
    let pid = kernel::raw(syscall::SYS_GETPID, [0, 0, 0, 0, 0, 0]);
    testing::assert(pid.is_ok());
    testing::assert_eq(pid.r1, go_getpid().to_usize());
    let missing = kernel::raw(0x7fffffff, [0, 0, 0, 0, 0, 0]);
    testing::assert_eq(missing.errno, syscall::ENOSYS);
    testing::assert_eq(missing.r1, (-1).to_usize());
    testing::assert(!missing.is_ok());
    let fds = Vec::from_array([0, 0, 0, 0, 0, 0, 0, 0]);
    let pipe = kernel::invoke(
        syscall::SYS_PIPE2,
        [
            Arg::Buffer(fds.as_mut_slice()),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
    );
    testing::assert(pipe.is_ok());
    let read_fd = testing::expect_ok(
        endian::read_u32(fds.as_slice(), 0, endian::Endian::Little),
        "read fd",
    ).to_usize();
    let write_fd = testing::expect_ok(
        endian::read_u32(fds.as_slice(), 4, endian::Endian::Little),
        "write fd",
    ).to_usize();
    defer kernel::close(read_fd);
    defer kernel::close(write_fd);
    let input = b"!syscall!";
    let written = kernel::invoke(
        syscall::SYS_WRITE,
        [
            Arg::Word(write_fd),
            Arg::Buffer(input.slice_mut(1, 8)),
            Arg::Word(7),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
    );
    testing::assert(written.is_ok());
    testing::assert_eq(written.r1, 7);
    let output = b"?????????";
    let read = kernel::invoke(
        syscall::SYS_READ,
        [
            Arg::Word(read_fd),
            Arg::Buffer(output.slice_mut(1, 8)),
            Arg::Word(7),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
    );
    testing::assert(read.is_ok());
    testing::assert_eq(read.r1, 7);
    testing::assert(output == b"?syscall?");
    let empty: Vec[byte] = Vec::new();
    let zero = kernel::invoke(
        syscall::SYS_WRITE,
        [
            Arg::Word(write_fd),
            Arg::Buffer(empty.as_mut_slice()),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
    );
    testing::assert(zero.is_ok());
    testing::assert_eq(zero.r1, 0);
    let bad = kernel::invoke(
        syscall::SYS_READ,
        [
            Arg::Word((-1).to_usize()),
            Arg::Buffer(empty.as_mut_slice()),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
    );
    testing::assert_eq(bad.errno, syscall::EBADF);
    let device = b"/dev/zero\0";
    let opened = kernel::invoke(
        syscall::SYS_OPENAT,
        [
            Arg::Word((-100).to_usize()),
            Arg::Buffer(device.as_mut_slice()),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
            Arg::Word(0),
        ],
    );
    testing::assert(opened.is_ok());
    defer kernel::close(opened.r1);
    let mapped = kernel::raw(syscall::SYS_MMAP, [0, 4096, 1, 2, opened.r1, 4096]);
    testing::assert(mapped.is_ok());
    let unmapped = kernel::raw(syscall::SYS_MUNMAP, [mapped.r1, 4096, 0, 0, 0, 0]);
    testing::assert(unmapped.is_ok());
    println("linux amd64 syscall: ok")
}
