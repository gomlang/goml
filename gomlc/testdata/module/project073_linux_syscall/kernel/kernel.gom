package kernel;

use std::os::linux::syscall;
use std::testing;

pub fn raw(number: usize, args: [usize; 6]) -> syscall::SyscallResult {
    testing::expect_ok(syscall::syscall6(number, args), "expected linux amd64")
}

pub fn invoke(number: usize, args: [syscall::Arg; 6]) -> syscall::SyscallResult {
    testing::expect_ok(syscall::syscall6_with_buffers(number, args), "expected linux amd64")
}

pub fn close(fd: usize) -> () {
    let _ = syscall::syscall6(syscall::SYS_CLOSE, [fd, 0, 0, 0, 0, 0]);
}
