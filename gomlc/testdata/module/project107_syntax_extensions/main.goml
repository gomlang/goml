package main;

use module::provider;
use provider::{Source, Label};

fn choice(value: isize) -> provider::Choice[isize] {
    if let Some(value) = Option::Some(value) && value > 0 {
        Value(value)
    } else {
        Empty
    }
}

fn main() -> () {
    println(provider::forward(17).get());
    println(provider::forward("opaque").get());
    println(provider::make(18).label());
    let value = provider::dynamic(19);
    println(value.get());
    println(value.label());
    println(provider::repeat::[isize, 3](20)[2]);
    let named: provider::Choice[isize] = Named { value: 21 };
    if let Named { value } = named && value > 0 {
        println(value)
    }
    if let Value(value) = choice(22) && value > 0 {
        println(value)
    }
}
