package provider;

pub trait Source[T] {
    fn get(self) -> T;
}

pub trait Label {
    fn label(self) -> string;
}

pub enum Choice[T] {
    Empty,
    Value(T),
    Named { value: T },
}

pub fn forward[T](value: T) -> impl Source[T] + Label {
    make(value)
}

pub fn dynamic[T](value: T) -> dyn Source[T] + Label {
    make(value) as dyn Source[T] + Label
}

pub fn repeat[T, const N: usize](value: T) -> [T; N] {
    [value; N]
}
