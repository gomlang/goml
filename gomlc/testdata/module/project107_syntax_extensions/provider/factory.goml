package provider;

struct Hidden[T] {
    value: T,
}

impl[T] Source[T]for Hidden[T] {
    fn get(self) -> T {
        self.value
    }
}

impl[T] Label for Hidden[T] {
    fn label(self) -> string {
        "hidden"
    }
}

pub fn make[T](value: T) -> impl Source[T] + Label {
    Hidden { value }
}
