package main;

use std::panic;
use std::testing;

struct Registers {
    values: [isize; 32],
    flag: isize,
}

struct ProjectionState {
    cpu: Registers,
    shared: Ref[isize],
}

fn state(value: isize) -> ProjectionState {
    ProjectionState { cpu: Registers { values: [value; 32], flag: value }, shared: Ref::new(value) }
}

fn flag(value: Ref[ProjectionState]) -> isize {
    value.get().cpu.flag
}

fn register(value: Ref[ProjectionState], index: isize) -> isize {
    value.get().cpu.values[index]
}

fn replace(value: Ref[ProjectionState], next: isize) -> isize {
    value.set(state(next));
    0
}

fn returned(value: Ref[ProjectionState]) -> [isize; 32] {
    value.get().cpu.values
}

fn captured(value: Ref[ProjectionState]) -> () -> isize {
    let snapshot = value.get();
    || snapshot.cpu.values[0] + snapshot.shared.get()
}

fn reads(value: Ref[ProjectionState]) -> () {
    testing::assert_eq(flag(value), 1);
    for index in 0..32 {
        testing::assert_eq(register(value, index), 1);
    }
    let saved = returned(value);
    let callback = captured(value);
    let snapshot = value.get();
    value.get().shared.set(5);
    value.set(state(2));
    testing::assert_eq(saved[0], 1);
    testing::assert_eq(callback(), 6);
    testing::assert_eq(snapshot.cpu.flag, 1);
    testing::assert_eq(snapshot.cpu.values[31], 1);
    testing::assert_eq(flag(value), 2);
    testing::assert_eq(value.get().cpu.values[replace(value, 3)], 2);
    testing::assert_eq(register(value, 0), 3);
    value.get().cpu.values[1] = 9;
    testing::assert_eq(register(value, 1), 9);
    testing::assert_eq(register(value, 0), 3);
    let sibling = value.get().cpu.values;
    value.get().cpu.values[2] = 10;
    testing::assert_eq(sibling[2], 3);
    testing::assert_eq(register(value, 2), 10);
}

fn nested(value: Ref[ProjectionState], count: isize) -> isize {
    let mut result = 0;
    for index in 0..count {
        match index % 3 {
            0 => {
                result += value.get().cpu.flag;
            },
            1 => {
                result += value.get().cpu.values[1];
            },
            _ => {
                let empty = Channel::[isize]::new(0);
                select {
                    recv(empty) as _ => (),
                    default => {
                        result += value.get().cpu.values[2];
                    },
                }
            },
        }
    }
    result
}

fn bounds(value: Ref[ProjectionState]) -> () {
    testing::assert(panic::catch(|| value.get().cpu.values[-1]).is_err());
    testing::assert(panic::catch(|| value.get().cpu.values[32]).is_err());
    let index = Ref::new(32);
    testing::assert(panic::catch(|| register(value, index.get())).is_err());
    index.set(-1);
    testing::assert(panic::catch(|| register(value, index.get())).is_err());
    testing::assert(
        panic::catch(
            || {
                let _ = value.get().cpu.values[index.get()];
            },
        ).is_err(),
    );
    let empty: Ref[[isize; 0]] = Ref::new([]);
    testing::assert(
        panic::catch(
            || {
                let values: [isize; 0] = empty.get();
                values[0]
            },
        ).is_err(),
    );
}

fn main() -> () {
    let value = Ref::new(state(1));
    reads(value);
    testing::assert_eq(nested(value, 6), 44);
    bounds(value);
    println("Ref projections, snapshots, effects and bounds passed");
}
