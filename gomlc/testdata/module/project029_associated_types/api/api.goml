package api;

pub trait Source {
    type Item: ToString;
    fn get(self: Self) -> Self::Item;
}

pub struct Box[T] {
    value: T,
}

impl[T: ToString] Source for Box[T] {
    type Item = T;

    fn get(self: Box[T]) -> T {
        self.value
    }
}

pub fn boxed[T](value: T) -> Box[T] {
    Box { value }
}

pub fn read[S: Source](source: S) -> S::Item {
    source.get()
}
