package main;

use std::json;
use tests::comptime_derive::facade;
use tests::comptime_derive::macros;
use facade::Label as FacadeLabel;
use json::Serialize;
use macros::Label;
use macros::Label as RenamedLabel;

#[derive(Label)]
struct Box[T] {
    #[field_label]
    value: T,
}

#[derive(macros::Label)]
enum State {
    #[variant_label]
    Ready(
        #[payload_label]
        isize,
    ),
}

#[derive(RenamedLabel)]
struct Alias {
    value: isize,
}

#[derive(FacadeLabel)]
struct Facade {
    value: isize,
}

#[derive(Serialize)]
struct Record {
    value: isize,
    label: string,
}

#[derive(Serialize)]
enum Event {
    Ready,
    Tuple(isize, bool),
    Named { value: isize },
}

#[derive(Serialize)]
struct Envelope[T] {
    value: T,
}

fn main() -> () {
    let value = Box { value: 1 };
    println(value.label());
    println(State::Ready(1).label());
    println(Alias { value: 1 }.label());
    println(Facade { value: 1 }.label());
    println(json::try_to_string(Record { value: 1, label: "ok" }).unwrap_or(""));
    println(json::try_to_string(Event::Ready).unwrap_or(""));
    println(json::try_to_string(Event::Tuple(2, true)).unwrap_or(""));
    println(json::try_to_string(Event::Named { value: 3 }).unwrap_or(""));
    println(json::try_to_string(Envelope { value: Vec::from_array([1, 2]) }).unwrap_or(""))
}
