package ids;

type RawId = u64;

type PairStorage[T] = (T, T);

pub type Id = RawId;

pub type Pair[T] = PairStorage[T];

const OFFSET: i32 = 2;

pub const ANSWER: i32 = 40 + OFFSET;

pub const NEWLINE: byte = b'\n';

pub fn make_id(value: Id) -> Id {
    value
}

pub fn add_pair(value: Pair[i32]) -> i32 {
    value.0 + value.1
}
