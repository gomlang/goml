package macros;

pub struct Report {
    pub text: string,
    pub ok: bool,
}

pub trait Inspect {
    fn inspect(self: Self) -> string;
    fn accepted(self: Self) -> bool;
    fn report(self: Self) -> Report;
    fn initial(self: Self) -> char;
    fn patterns(self: Self) -> isize;
    fn maybe(self: Self) -> Option[isize];
    fn large(self: Self) -> u64;
    fn generic[A: Adapter](self: Self, adapter: A) -> Result[A::Output, string];
    fn counted(self: Self) -> isize;
}

pub trait Render {
    fn render(self: Self) -> string;
}

pub trait Adapter {
    type Output;
    fn adapt(self: Self, value: string) -> Result[Self::Output, string];
}

impl Render for string {
    fn render(self: string) -> string {
        self
    }
}

#[comptime_derive]
fn inspect_method(input: DeriveInput) -> MetaMethod {
    let fields = meta_pattern_field_list_new();
    meta_pattern_field_list_push(fields, "name", meta_pattern_bind("name"));
    let pattern = meta_pattern_target_struct(input, fields, true);
    let args = meta_expr_list_new();
    meta_expr_list_push(args, meta_expr_var("name"));
    let rendered = meta_expr_trait_call(input, "Render", "render", args);
    let arms = meta_arm_list_new();
    meta_arm_list_push(arms, meta_arm(pattern, rendered));
    let matched = meta_expr_match(meta_expr_var("self"), arms);
    let block = meta_block_new();
    meta_block_expr(block, meta_expr_return(matched));
    let params = meta_param_list_new();
    meta_param_list_push(params, "self", derive_target_type(input));
    meta_method("inspect", params, meta_type_call_site("string"), meta_block_finish_unit(block))
}

#[comptime_derive]
fn accepted_method(input: DeriveInput) -> MetaMethod {
    let alternatives = meta_pattern_list_new();
    meta_pattern_list_push(
        alternatives,
        meta_pattern_range(meta_pattern_int(1), meta_pattern_int(3), true),
    );
    meta_pattern_list_push(alternatives, meta_pattern_int(5));
    let arms = meta_arm_list_new();
    meta_arm_list_push(
        arms,
        meta_arm_guarded(
            meta_pattern_or(alternatives),
            meta_expr_bool(true),
            meta_expr_unary(1, meta_expr_bool(false)),
        ),
    );
    meta_arm_list_push(arms, meta_arm(meta_pattern_wild(), meta_expr_bool(false)));
    let params = meta_param_list_new();
    meta_param_list_push(params, "self", derive_target_type(input));
    meta_method(
        "accepted",
        params,
        meta_type_call_site("bool"),
        meta_expr_match(meta_expr_int(3), arms),
    )
}

#[comptime_derive]
fn report_method(input: DeriveInput, text: string) -> MetaMethod {
    let block = meta_block_new();
    meta_block_let_mut(block, "ok", meta_expr_bool(false));
    meta_block_assign(block, meta_expr_var("ok"), meta_expr_bool(true));
    let fields = meta_expr_field_list_new();
    meta_expr_field_list_push(fields, "text", meta_expr_string(text));
    meta_expr_field_list_push(fields, "ok", meta_expr_var("ok"));
    let params = meta_param_list_new();
    meta_param_list_push(params, "self", derive_target_type(input));
    meta_method(
        "report",
        params,
        meta_type_named(input, "Report"),
        meta_block_finish(block, meta_expr_struct(input, "Report", fields)),
    )
}

#[comptime_derive]
fn initial_method(input: DeriveInput) -> MetaMethod {
    let params = meta_param_list_new();
    meta_param_list_push(params, "self", derive_target_type(input));
    meta_method("initial", params, meta_type_call_site("char"), meta_expr_char("m"))
}

#[comptime_derive]
fn patterns_method(input: DeriveInput) -> MetaMethod {
    let array_values = meta_expr_list_new();
    meta_expr_list_push(array_values, meta_expr_int(1));
    meta_expr_list_push(array_values, meta_expr_int(2));
    let tuple_values = meta_expr_list_new();
    meta_expr_list_push(tuple_values, meta_expr_bool(true));
    meta_expr_list_push(tuple_values, meta_expr_string("x"));
    meta_expr_list_push(tuple_values, meta_expr_char("m"));
    meta_expr_list_push(tuple_values, meta_expr_array(array_values));
    meta_expr_list_push(tuple_values, meta_expr_unit());
    let array_patterns = meta_pattern_list_new();
    meta_pattern_list_push(array_patterns, meta_pattern_int(1));
    meta_pattern_list_push(array_patterns, meta_pattern_alias("answer", meta_pattern_int(2)));
    let tuple_patterns = meta_pattern_list_new();
    meta_pattern_list_push(tuple_patterns, meta_pattern_bool(true));
    meta_pattern_list_push(tuple_patterns, meta_pattern_string("x"));
    meta_pattern_list_push(tuple_patterns, meta_pattern_char("m"));
    meta_pattern_list_push(tuple_patterns, meta_pattern_array(array_patterns));
    meta_pattern_list_push(tuple_patterns, meta_pattern_unit());
    let arms = meta_arm_list_new();
    meta_arm_list_push(arms, meta_arm(meta_pattern_tuple(tuple_patterns), meta_expr_var("answer")));
    meta_arm_list_push(arms, meta_arm(meta_pattern_wild(), meta_expr_int(0)));
    let params = meta_param_list_new();
    meta_param_list_push(params, "self", derive_target_type(input));
    meta_method(
        "patterns",
        params,
        meta_type_call_site("isize"),
        meta_expr_match(meta_expr_tuple(tuple_values), arms),
    )
}

#[comptime_derive]
fn maybe_method(input: DeriveInput) -> MetaMethod {
    let values = meta_expr_list_new();
    meta_expr_list_push(values, meta_expr_int(7));
    let params = meta_param_list_new();
    meta_param_list_push(params, "self", derive_target_type(input));
    let type_args = meta_type_list_new();
    meta_type_list_push(type_args, meta_type_call_site("isize"));
    meta_method(
        "maybe",
        params,
        meta_type_apply(meta_type_call_site("Option"), type_args),
        meta_expr_constructor("Option::Some", values),
    )
}

#[comptime_derive]
fn large_method(input: DeriveInput) -> MetaMethod {
    let params = meta_param_list_new();
    meta_param_list_push(params, "self", derive_target_type(input));
    meta_method(
        "large",
        params,
        meta_type_call_site("u64"),
        meta_expr_integer("14695981039346656037", meta_type_call_site("u64")),
    )
}

#[comptime_derive]
fn generic_method(input: DeriveInput) -> MetaMethod {
    let generic_type = meta_type_call_site("A");
    let output_type = meta_type_projection(generic_type, "Output");
    let result_args = meta_type_list_new();
    meta_type_list_push(result_args, output_type);
    meta_type_list_push(result_args, meta_type_call_site("string"));
    let result_type = meta_type_apply(meta_type_call_site("Result"), result_args);
    let call_args = meta_expr_list_new();
    meta_expr_list_push(call_args, meta_expr_var("adapter"));
    meta_expr_list_push(call_args, meta_expr_string("value"));
    let block = meta_block_new();
    meta_block_let_typed(
        block,
        "adapted",
        output_type,
        meta_expr_try(meta_expr_trait_call(input, "Adapter", "adapt", call_args)),
    );
    let ok_args = meta_expr_list_new();
    meta_expr_list_push(ok_args, meta_expr_var("adapted"));
    let params = meta_param_list_new();
    meta_param_list_push(params, "self", derive_target_type(input));
    meta_param_list_push(params, "adapter", generic_type);
    let generics = meta_generic_list_new();
    meta_generic_list_push(generics, "A");
    meta_generic_list_add_bound(input, generics, "A", "Adapter");
    meta_method_generic(
        "generic",
        generics,
        params,
        result_type,
        meta_block_finish(block, meta_expr_constructor("Result::Ok", ok_args)),
    )
}

#[comptime_derive]
fn counted_method(input: DeriveInput) -> MetaMethod {
    let block = meta_block_new();
    meta_block_let_mut_typed(block, "count", meta_type_call_site("isize"), meta_expr_int(0));
    let loop_block = meta_block_new();
    meta_block_assign(
        loop_block,
        meta_expr_var("count"),
        meta_expr_binary(0, meta_expr_var("count"), meta_expr_int(1)),
    );
    meta_block_expr(
        block,
        meta_expr_while(
            meta_expr_binary(12, meta_expr_var("count"), meta_expr_int(3)),
            meta_block_finish_unit(loop_block),
        ),
    );
    let params = meta_param_list_new();
    meta_param_list_push(params, "self", derive_target_type(input));
    meta_method(
        "counted",
        params,
        meta_type_call_site("isize"),
        meta_block_finish(block, meta_expr_var("count")),
    )
}

#[comptime_derive(Inspect)]
pub fn derive_inspect(input: DeriveInput) -> DeriveOutput {
    let item_attribute = derive_attribute(input, 0);
    if meta_attribute_name(item_attribute) != "derive" {
        compile_error("structured item attribute metadata is missing")
    } else {};
    let attribute = derive_field_attribute(input, 0, 0);
    let mut text = "";
    for part in["<", meta_attribute_name(attribute), ">"] {
        text = text + part;
    }
    for index in 0..meta_attribute_argument_count(attribute) {
        if index == 1 {
            continue
        } else {};
        text = text + meta_attribute_argument_kind(attribute, index) + ":"
            + meta_attribute_argument_text(attribute, index)
            + ";";
    }
    if !meta_attribute_has_argument_list(attribute) || meta_attribute_text(attribute).len() < 1 {
        compile_error("structured attribute metadata is missing")
    } else {};
    if meta_attribute_argument_kind(attribute, 1) != "path"
        || meta_attribute_argument_text(attribute, 1) != "owner::value" {
        compile_error("structured path attribute argument is missing")
    } else {};
    if meta_attribute_argument_kind(attribute, 3) != "named"
        || meta_attribute_argument_name(attribute, 3) != "rename"
        || meta_attribute_argument_value_kind(attribute, 3) != "string"
        || meta_attribute_argument_text(attribute, 3) != "entry"
        || meta_attribute_argument_kind(attribute, 4) != "named"
        || meta_attribute_argument_name(attribute, 4) != "with"
        || meta_attribute_argument_value_kind(attribute, 4) != "path"
        || meta_attribute_argument_text(attribute, 4) != "owner::codec" {
        compile_error("structured named attribute argument is missing")
    } else {};
    if !text.starts_with("<meta") || !text.contains("string:suffix;")
        || !text.contains("field_name") {
        compile_error("compile-time string search failed")
    } else if text.get(0) != '<' || text.byte_get(0) != 60 || text.byte_slice(0, 1) != "<"
        || !text.is_char_boundary(1) {
        compile_error("compile-time string indexing failed")
    } else {};
    let field_type = derive_field_type(input, 1);
    if meta_type_kind(field_type) != "application" || meta_type_argument_count(field_type) != 1 {
        compile_error("applied type reflection failed")
    } else {};
    let argument = meta_type_argument(field_type, 0);
    if meta_type_kind(argument) != "named" || meta_type_name(argument) != "T"
        || !meta_type_contains_generic(input, field_type)
        || !meta_type_equal(argument, argument) {
        compile_error("generic type reflection failed")
    } else {};
    let tuple_type = derive_field_type(input, 2);
    if meta_type_kind(tuple_type) != "tuple" || meta_type_tuple_count(tuple_type) != 2
        || meta_type_name(meta_type_tuple_item(tuple_type, 0)) != "T" {
        compile_error("tuple type reflection failed")
    } else {};
    let array_type = derive_field_type(input, 3);
    if meta_type_kind(array_type) != "array" || meta_type_array_length(array_type) != 3
        || meta_type_name(meta_type_array_element(array_type)) != "u8" {
        compile_error("array type reflection failed")
    } else {};
    let function_type = derive_field_type(input, 4);
    if meta_type_kind(function_type) != "function"
        || meta_type_function_parameter_count(function_type) != 1
        || meta_type_name(meta_type_function_parameter(function_type, 0)) != "T"
        || meta_type_name(meta_type_function_return(function_type)) != "string" {
        compile_error("function type reflection failed")
    } else {};
    let output = derive_output_new(input, "Inspect");
    derive_output_add_method(output, inspect_method(input));
    derive_output_add_method(output, accepted_method(input));
    derive_output_add_method(output, report_method(input, text));
    derive_output_add_method(output, initial_method(input));
    derive_output_add_method(output, patterns_method(input));
    derive_output_add_method(output, maybe_method(input));
    derive_output_add_method(output, large_method(input));
    derive_output_add_method(output, generic_method(input));
    derive_output_add_method(output, counted_method(input));
    output
}
