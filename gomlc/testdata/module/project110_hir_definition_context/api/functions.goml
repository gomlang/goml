package api;

use module::alternate as sizes;
use module::alternate::{SIZE as IMPORTED_SIZE};

struct T {
    value: isize,
}

pub fn identity[T](value: T) -> T {
    value
}

pub fn first(values: [isize; WIDTH]) -> isize {
    values[0]
}

pub fn second(values: [isize; IMPORTED_WIDTH]) -> isize {
    values[0]
}

pub fn inherited[const SIZE: usize](values: [isize; INHERITED_WIDTH]) -> isize {
    values[0]
}
