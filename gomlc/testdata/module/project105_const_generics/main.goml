package main;

use module::api;
use api::Capacity;

fn main() -> () {
    println(api::Buffer::[i32, api::WIDTH]::LABEL);
    let values: [i32; api::WIDTH] = [4, 5, 6];
    let buffer: api::Buffer[i32, api::WIDTH] = api::Buffer { values };
    println(api::first::[i32, api::WIDTH](buffer.values));
    println(api::Buffer::[i32, api::WIDTH]::CAPACITY);
}
