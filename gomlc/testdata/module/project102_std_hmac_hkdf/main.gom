package main;

use std::bytes;
use std::crypto;
use std::crypto::hash as crypto_hash;
use std::crypto::hkdf;
use std::crypto::hmac;
use std::encoding::hex;
use std::hash as standard_hash;
use standard_hash::Hasher;
use std::testing;

#[go_ffi("example.com/goml-std-hmac-hkdf/native", "Hmac256")]
extern fn go_hmac256(key: Slice[byte], input: Slice[byte]) -> string;

#[go_ffi("example.com/goml-std-hmac-hkdf/native", "Hmac512")]
extern fn go_hmac512(key: Slice[byte], input: Slice[byte]) -> string;

#[go_ffi("example.com/goml-std-hmac-hkdf/native", "Extract256")]
extern fn go_extract256(salt: Slice[byte], input_key: Slice[byte]) -> string;

#[go_ffi("example.com/goml-std-hmac-hkdf/native", "Expand256")]
extern fn go_expand256(prk: Slice[byte], info: Slice[byte], length: isize) -> string;

#[go_ffi("example.com/goml-std-hmac-hkdf/native", "Derive256")]
extern fn go_derive256(salt: Slice[byte], input_key: Slice[byte], info: Slice[byte], length: isize) -> string;

#[go_ffi("example.com/goml-std-hmac-hkdf/native", "Derive512")]
extern fn go_derive512(salt: Slice[byte], input_key: Slice[byte], info: Slice[byte], length: isize) -> string;

fn new_sha256() -> crypto_hash::Sha256Digest {
    crypto_hash::Sha256Digest::new256()
}

fn new_sha512() -> crypto_hash::Sha512Digest {
    crypto_hash::Sha512Digest::new512()
}

fn from_hex(value: string) -> bytes::Bytes {
    testing::expect_ok(hex::decode(value), "decode fixture hex")
}

fn repeated(value: byte, length: isize) -> bytes::Bytes {
    let output = bytes::Bytes::with_capacity(length);
    for _ in 0..length {
        output.push(value)
    }
    output
}

fn pattern(length: isize) -> bytes::Bytes {
    let output = bytes::Bytes::with_capacity(length);
    for index in 0..length {
        output.push(((index * 37 + 11) % 256).to_u8())
    }
    output
}

fn check_rfc_vectors() -> () {
    let hmac_key = repeated(0x0b, 20);
    let hmac_message = bytes::Bytes::from_string("Hi There");
    let hmac_value = testing::expect_ok(
        hmac::sum(new_sha256, hmac_key.as_slice(), hmac_message.as_slice()),
        "RFC 4231 HMAC-SHA-256",
    );
    testing::assert_eq(
        hex::encode(hmac_value),
        "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7",
    );
    let input_key = repeated(0x0b, 22);
    let salt = from_hex("000102030405060708090a0b0c");
    let info = from_hex("f0f1f2f3f4f5f6f7f8f9");
    let prk = testing::expect_ok(
        hkdf::extract(new_sha256, salt.as_slice(), input_key.as_slice()),
        "RFC 5869 extract",
    );
    testing::assert_eq(
        hex::encode(prk),
        "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5",
    );
    let okm = testing::expect_ok(
        hkdf::expand(new_sha256, prk.as_slice(), info.as_slice(), 42),
        "RFC 5869 expand",
    );
    testing::assert_eq(
        hex::encode(okm),
        "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865",
    );
    let derived = testing::expect_ok(
        hkdf::derive(new_sha256, salt.as_slice(), input_key.as_slice(), info.as_slice(), 42),
        "RFC 5869 derive",
    );
    testing::assert_eq(hex::encode(derived), hex::encode(okm));
}

fn check_hmac(key: bytes::Bytes, message: bytes::Bytes) -> () {
    let first = testing::expect_ok(
        hmac::sum(new_sha256, key.as_slice(), message.as_slice()),
        "HMAC-SHA-256 one-shot",
    );
    let second = testing::expect_ok(
        hmac::sum(new_sha512, key.as_slice(), message.as_slice()),
        "HMAC-SHA-512 one-shot",
    );
    testing::assert_eq(hex::encode(first), go_hmac256(key.as_slice(), message.as_slice()));
    testing::assert_eq(hex::encode(second), go_hmac512(key.as_slice(), message.as_slice()));
    testing::assert(crypto::digest_equal(first.as_slice(), first.as_slice()));
    testing::assert(!crypto::digest_equal(first.as_slice(), message.as_slice()));
    testing::assert(!crypto::digest_equal(first.as_slice(), second.as_slice()));
    let raw = crypto_hash::Sha256Digest::new256();
    raw.update(message.as_slice());
    let raw_sum = raw.sum();
    testing::assert(crypto::verify_digest(raw, raw_sum.as_slice()));
    let digest = testing::expect_ok(hmac::Digest::new(new_sha256, key.as_slice()), "new HMAC");
    let midpoint = message.len() / 2;
    digest.update(message.slice(0, midpoint));
    let partial = digest.sum();
    testing::assert_eq(hex::encode(partial), go_hmac256(key.as_slice(), message.slice(0, midpoint)));
    digest.update(message.slice(midpoint, message.len()));
    testing::assert_eq(hex::encode(digest.sum()), hex::encode(first));
    testing::assert_eq(hex::encode(digest.sum()), hex::encode(first));
    testing::assert(digest.verify(first.as_slice()));
    let wrong = bytes::Bytes::from_slice_copy(first.as_slice());
    wrong.set(0, wrong.get(0) ^ 1);
    testing::assert(!digest.verify(wrong.as_slice()));
    testing::assert(!digest.verify(message.as_slice()));
    digest.reset();
    testing::assert_eq(
        hex::encode(digest.sum()),
        go_hmac256(key.as_slice(), bytes::Bytes::new().as_slice()),
    );
    digest.update(message.as_slice());
    testing::assert_eq(hex::encode(digest.sum()), hex::encode(first));
    testing::assert_eq(digest.size(), 32);
    testing::assert_eq(digest.block_size(), 64);
}

fn check_hkdf(salt: bytes::Bytes, input_key: bytes::Bytes, info: bytes::Bytes) -> () {
    let prk = testing::expect_ok(
        hkdf::extract(new_sha256, salt.as_slice(), input_key.as_slice()),
        "HKDF extract",
    );
    testing::assert_eq(hex::encode(prk), go_extract256(salt.as_slice(), input_key.as_slice()));
    for length in Vec::from_array([0, 1, 31, 32, 33, 42, 63, 64, 65, 127, 8160]) {
        let expanded = testing::expect_ok(
            hkdf::expand(new_sha256, prk.as_slice(), info.as_slice(), length),
            "HKDF expand",
        );
        testing::assert_eq(expanded.len(), length);
        testing::assert_eq(
            hex::encode(expanded),
            go_expand256(prk.as_slice(), info.as_slice(), length),
        );
        let derived = testing::expect_ok(
            hkdf::derive(new_sha256, salt.as_slice(), input_key.as_slice(), info.as_slice(), length),
            "HKDF derive",
        );
        testing::assert_eq(hex::encode(derived), hex::encode(expanded));
        testing::assert_eq(
            hex::encode(derived),
            go_derive256(salt.as_slice(), input_key.as_slice(), info.as_slice(), length),
        );
    }
    for length in Vec::from_array([0, 1, 63, 64, 65, 128]) {
        let derived = testing::expect_ok(
            hkdf::derive(new_sha512, salt.as_slice(), input_key.as_slice(), info.as_slice(), length),
            "HKDF-SHA-512 derive",
        );
        testing::assert_eq(
            hex::encode(derived),
            go_derive512(salt.as_slice(), input_key.as_slice(), info.as_slice(), length),
        );
    }
    testing::assert(hkdf::expand(new_sha256, prk.as_slice(), info.as_slice(), -1).is_err());
    testing::assert(hkdf::expand(new_sha256, prk.as_slice(), info.as_slice(), 8161).is_err());
}

pub struct InvalidDigest {}

impl Hasher for InvalidDigest {
    fn update(self: InvalidDigest, input: Slice[byte]) -> () {}

    fn reset(self: InvalidDigest) -> () {}

    fn sum(self: InvalidDigest) -> bytes::Bytes {
        bytes::Bytes::new()
    }

    fn size(self: InvalidDigest) -> isize {
        0
    }

    fn block_size(self: InvalidDigest) -> isize {
        64
    }
}

fn new_invalid() -> InvalidDigest {
    InvalidDigest {}
}

fn check_invalid_digest() -> () {
    let empty = bytes::Bytes::new();
    testing::assert(hmac::Digest::new(new_invalid, empty.as_slice()).is_err());
    testing::assert(hmac::sum(new_invalid, empty.as_slice(), empty.as_slice()).is_err());
    testing::assert(hkdf::extract(new_invalid, empty.as_slice(), empty.as_slice()).is_err());
    testing::assert(hkdf::expand(new_invalid, empty.as_slice(), empty.as_slice(), 1).is_err());
}

fn main() -> () {
    check_rfc_vectors();
    for key_length in Vec::from_array([0, 1, 20, 64, 65, 128, 129]) {
        for message_length in Vec::from_array([0, 1, 3, 55, 56, 64, 65, 129]) {
            check_hmac(pattern(key_length), pattern(message_length))
        }
    }
    check_hkdf(bytes::Bytes::new(), bytes::Bytes::new(), bytes::Bytes::new());
    check_hkdf(pattern(17), pattern(81), pattern(39));
    check_invalid_digest();
    println("HMAC and HKDF ok")
}
