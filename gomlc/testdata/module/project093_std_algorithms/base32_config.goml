package main;

use std::bytes;
use std::encoding::base32;
use std::ffi;
use std::rand;
use std::testing;

#[go_method("WithPadding")]
extern fn go_base32_padding(value: ffi::Ptr[GoBase32], padding: i32) -> ffi::Ptr[GoBase32];

fn check_base32_config() -> () {
    check_base32_limits();
    let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
    for code in 0..128 {
        let padding = code.to_u8();
        let mut in_alphabet = false;
        for index in 0..32 {
            if alphabet.byte_get(index) == padding {
                in_alphabet = true;
            }
        }
        if code != 10 && code != 13 && !in_alphabet {
            let encoding = testing::expect_ok(
                base32::Encoding::new(alphabet, Option::Some(padding)),
                "ASCII padding",
            );
            let data = bytes::Bytes::from_vec(b"\0");
            let expected = go_base32_encode(
                go_base32_padding(go_base32(alphabet), code.to_i32()),
                data.as_slice(),
            );
            assert_equal(encoding.encode(data), expected);
            assert_equal(
                testing::expect_ok(encoding.decode(expected), "ASCII padding decode").to_vec(),
                b"\0",
            );
        }
    }
    for offset in 0..32 {
        let rotated = alphabet.byte_slice(offset, 32) + alphabet.byte_slice(0, offset);
        let standard = testing::expect_ok(
            base32::Encoding::new(rotated, Option::Some(b'=')),
            "custom alphabet",
        );
        assert_equal(standard.alphabet(), rotated);
        for padding in[Option::Some(b'='), Option::Some(b'!'), Option::None] {
            let encoding = testing::expect_ok(standard.with_padding(padding), "custom padding");
            assert_equal(encoding.padding(), padding);
            assert_equal(standard.padding(), Option::Some(b'='));
            let go_padding = match padding {
                Some(value) => value.to_i32(),
                None => -1.to_i32(),
            };
            let reference = go_base32_padding(go_base32(rotated), go_padding);
            for length in 0..41 {
                let data = bytes::Bytes::from_vec(
                    rand::bytes((offset * 41 + length).to_u64(), length),
                );
                let encoded = encoding.encode(data);
                assert_equal(encoded, go_base32_encode(reference, data.as_slice()));
                assert_equal(
                    testing::expect_ok(encoding.decode(encoded), "custom decode").to_vec(),
                    data.to_vec(),
                );
            }
        }
    }
    let symbols = "=BCDEFGHIJKLMNOPQRSTUVWXYZ234567";
    for padding in[Option::Some(b'*'), Option::None] {
        let encoding = testing::expect_ok(base32::Encoding::new(symbols, padding), "equals digit");
        let reference = go_base32_padding(
            go_base32(symbols),
            match padding {
                Some(value) => value.to_i32(),
                None => -1.to_i32(),
            },
        );
        for input in[b"\0", b"\0\0\0\0\0", b"\xff", b"a"] {
            let data = bytes::Bytes::from_vec(input);
            let encoded = encoding.encode(data);
            assert_equal(encoded, go_base32_encode(reference, input.as_slice()));
            assert_equal(
                testing::expect_ok(encoding.decode(encoded), "equals decode").to_vec(),
                input,
            );
        }
    }
    let spaced = testing::expect_ok(
        base32::Encoding::new(" BCDEFGHIJKLMNOPQRSTUVWXYZ234567", Option::Some(b'\t')),
        "space alphabet",
    );
    let encoded = spaced.encode(bytes::Bytes::from_vec(b"\0"));
    assert_equal(encoded, "  \t\t\t\t\t\t");
    assert_equal(
        testing::expect_ok(spaced.decode(encoded), "whitespace symbols are data").to_vec(),
        b"\0",
    );
    for symbols in Vec::from_array(
        [
            "",
            "ABC",
            "ABCDEFGHIJKLMNOPQRSTUVWXYZ23456A",
            "\nBCDEFGHIJKLMNOPQRSTUVWXYZ234567",
            "\rBCDEFGHIJKLMNOPQRSTUVWXYZ234567",
            "你BCDEFGHIJKLMNOPQRSTUVWXYZ2345",
        ],
    ) {
        testing::assert(base32::Encoding::new(symbols, Option::None).is_err());
    }
    for padding in[b'A', b'\n', b'\r', 128.to_u8(), 255.to_u8()] {
        testing::assert(base32::Encoding::new(alphabet, Option::Some(padding)).is_err());
    }
    let custom = testing::expect_ok(
        base32::Encoding::new(alphabet, Option::Some(b'!')),
        "strict custom",
    );
    for input in Vec::from_array(
        ["MZ!!!!!!", "MY!!!!!", "M!Y!!!!!", "MY!!!!!!\n", "MY======", "my!!!!!!"],
    ) {
        testing::assert(custom.decode(input).is_err());
    }
    for variant in[
        base32::Variant::Standard,
        base32::Variant::StandardNoPadding,
        base32::Variant::Hex,
        base32::Variant::HexNoPadding,
    ] {
        let encoding = base32::Encoding::from_variant(variant);
        let data = bytes::Bytes::from_string("foobar");
        let encoded = encoding.encode(data);
        assert_equal(encoded, base32::encode_with(data, variant));
        assert_equal(
            testing::expect_ok(encoding.decode(encoded), "variant decode").to_vec(),
            data.to_vec(),
        );
    }
}

fn check_base32_limits() -> () {
    match base32::decode_checked("@@@@@@@@", 0) {
        Err(base32::OutputError::LimitExceeded(limit)) => assert_equal(limit, 0),
        _ => testing::assert(false),
    }
    match base32::decode_checked("A", 0) {
        Err(base32::OutputError::Decode(error)) => assert_equal(
            error.kind(),
            base32::DecodeErrorKind::InvalidLength,
        ),
        _ => testing::assert(false),
    }
    for variant in[
        base32::Variant::Standard,
        base32::Variant::StandardNoPadding,
        base32::Variant::Hex,
        base32::Variant::HexNoPadding,
    ] {
        let encoding = base32::Encoding::from_variant(variant);
        for length in 0..257 {
            let data = bytes::Bytes::from_vec(rand::bytes(length.to_u64(), length));
            let encoded = encoding.encode(data);
            assert_equal(
                testing::expect_ok(encoding.encoded_len(length), "encoded length"),
                encoded.byte_len(),
            );
            assert_equal(
                testing::expect_ok(
                    encoding.encode_checked(data, encoded.byte_len()),
                    "exact encoded limit",
                ),
                encoded,
            );
            assert_equal(
                testing::expect_ok(encoding.decode_checked(encoded, length), "exact decoded limit").to_vec(),
                data.to_vec(),
            );
            if length > 0 {
                match encoding.encode_checked(data, encoded.byte_len() - 1) {
                    Err(base32::OutputError::LimitExceeded(limit)) => assert_equal(
                        limit,
                        encoded.byte_len() - 1,
                    ),
                    _ => testing::assert(false),
                }
                match encoding.decode_checked(encoded, length - 1) {
                    Err(base32::OutputError::LimitExceeded(limit)) => assert_equal(
                        limit,
                        length - 1,
                    ),
                    _ => testing::assert(false),
                }
            }
        }
        match encoding.encoded_len(-1) {
            Err(base32::OutputError::InvalidLength(length)) => assert_equal(length, -1),
            _ => testing::assert(false),
        }
        match encoding.encoded_len(9223372036854775807) {
            Err(base32::OutputError::LengthOverflow) => (),
            _ => testing::assert(false),
        }
        let largest = if encoding.padding().is_some() {
            5764607523034234875
        } else {
            5764607523034234879
        };
        let expected = if encoding.padding().is_some() {
            9223372036854775800
        } else {
            9223372036854775807
        };
        assert_equal(
            testing::expect_ok(encoding.encoded_len(largest), "maximum representable encoding"),
            expected,
        );
        testing::assert(encoding.encoded_len(largest + 1).is_err());
    }
    let data = bytes::Bytes::from_string("f");
    assert_equal(
        testing::expect_ok(base32::encode_checked(data, 8), "default checked encode"),
        "MY======",
    );
    assert_equal(
        testing::expect_ok(base32::decode_checked("MY======", 1), "default checked decode").to_vec(),
        b"f",
    );
    testing::assert(base32::encode_checked(data, -1).is_err());
    match base32::decode_checked("", -1) {
        Err(base32::OutputError::InvalidLimit(limit)) => assert_equal(limit, -1),
        _ => testing::assert(false),
    }
    for input in Vec::from_array(["A", "MY=====!", "MZ======", "MY======\n", "my======"]) {
        let original = base32::decode(input);
        match (original, base32::decode_checked(input, 1024)) {
            (Err(expected), Err(base32::OutputError::Decode(actual))) => assert_equal(
                actual,
                expected,
            ),
            _ => testing::assert(false),
        }
    }
    let custom = testing::expect_ok(
        base32::Encoding::new("=BCDEFGHIJKLMNOPQRSTUVWXYZ234567", Option::None),
        "bounded custom alphabet",
    );
    assert_equal(
        testing::expect_ok(custom.encode_checked(bytes::Bytes::from_vec(b"\0"), 2), "custom bound"),
        "==",
    );
    assert_equal(
        testing::expect_ok(custom.decode_checked("==", 1), "custom decode bound").to_vec(),
        b"\0",
    );
}
