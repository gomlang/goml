package main;

use std::num;
use std::num::{ToFloat, TryToInt};
use std::testing;

#[go_ffi("example.com/goml-std-algorithms/native", "IntegerFloatBits")]
extern fn go_integer_float_bits(value: u64, signed: bool) -> (u32, u64);

#[go_ffi("example.com/goml-std-algorithms/native", "RoundedInteger")]
extern fn go_rounded_integer(value: f64, mode: isize, width: isize, signed: bool) -> (u64, isize);

fn check_integer_float[T: ToFloat](value: T, bits: u64, signed: bool) -> () {
    let (expected32, expected64) = go_integer_float_bits(bits, signed);
    testing::assert_eq(float32_to_bits(value.to_f32()), expected32);
    testing::assert_eq(float64_to_bits(value.to_f64()), expected64);
}

fn check_integer_floats(bits: u64) -> () {
    check_integer_float(bits, bits, false);
    check_integer_float(bits.to_i64(), bits, true);
    check_integer_float(bits.to_usize(), bits, false);
    check_integer_float(bits.to_isize(), bits, true);
    check_integer_float(bits.to_u32(), bits.to_u32().to_u64(), false);
    check_integer_float(bits.to_i32(), bits.to_i32().to_i64().to_u64(), true);
    check_integer_float(bits.to_u16(), bits.to_u16().to_u64(), false);
    check_integer_float(bits.to_i16(), bits.to_i16().to_i64().to_u64(), true);
    check_integer_float(bits.to_u8(), bits.to_u8().to_u64(), false);
    check_integer_float(bits.to_i8(), bits.to_i8().to_i64().to_u64(), true);
}

fn check_rounded_result(actual: Result[u64, num::FloatConversionError], expected: (u64, isize)) -> () {
    let (bits, status) = expected;
    match actual {
        Ok(value) => {
            testing::assert_eq(status, 0);
            testing::assert_eq(value, bits);
        },
        Err(error) => assert_equal(
            match error {
                NonFinite => 1,
                OutOfRange => 2,
            },
            status,
        ),
    }
}

fn check_float_integer(value: f64) -> () {
    let modes = [
        num::Rounding::TowardZero,
        num::Rounding::Floor,
        num::Rounding::Ceil,
        num::Rounding::NearestAway,
        num::Rounding::NearestEven,
    ];
    for mode in 0..5 {
        check_rounded_result(
            num::float_to_u64(value, modes[mode]),
            go_rounded_integer(value, mode, 64, false),
        );
        check_rounded_result(
            num::float_to_i64(value, modes[mode]).map(|v: i64| v.to_u64()),
            go_rounded_integer(value, mode, 64, true),
        );
    }
    check_float_integer_widths(value, value);
}

fn check_float_integer_widths[T: TryToInt](value: T, reference: f64) -> () {
    let signed = [
        value.try_to_i8().map(|v: i8| v.to_i64()),
        value.try_to_i16().map(|v: i16| v.to_i64()),
        value.try_to_i32().map(|v: i32| v.to_i64()),
        value.try_to_i64(),
        value.try_to_isize().map(|v: isize| v.to_i64()),
    ];
    let unsigned = [
        value.try_to_u8().map(|v: u8| v.to_u64()),
        value.try_to_u16().map(|v: u16| v.to_u64()),
        value.try_to_u32().map(|v: u32| v.to_u64()),
        value.try_to_u64(),
        value.try_to_usize().map(|v: usize| v.to_u64()),
    ];
    let widths = [8, 16, 32, 64, 64];
    for index in 0..5 {
        check_rounded_result(
            signed[index].map(|v: i64| v.to_u64()),
            go_rounded_integer(reference, 0, widths[index], true),
        );
        check_rounded_result(
            unsigned[index],
            go_rounded_integer(reference, 0, widths[index], false),
        );
    }
}

fn check_float_conversions() -> () {
    let sign = 1.to_u64() << 63;
    for exponent in 0..64 {
        let power = 1.to_u64() << exponent;
        for bits in[
            power - 1,
            power,
            power + 1,
            18446744073709551615 - (power - 1),
            18446744073709551615 - power,
        ] {
            check_integer_floats(bits);
        }
    }
    for exponent in 0..2048 {
        for fraction in[0.to_u64(), 1.to_u64(), 0x7ffffffffffff.to_u64(), 0xfffffffffffff.to_u64()] {
            let bits = (exponent.to_u64() << 52) | fraction;
            check_float_integer(float64_from_bits(bits));
            check_float_integer(float64_from_bits(bits | sign));
        }
    }
    for exponent in 0..256 {
        for fraction in[0.to_u32(), 1.to_u32(), 0x3fffff.to_u32(), 0x7fffff.to_u32()] {
            let center = (exponent.to_u32() << 23) | fraction;
            for bits in[center, center | (1.to_u32() << 31)] {
                let value = float32_from_bits(bits);
                check_float_integer_widths(value, float32_to_float64(value));
            }
        }
    }
    for exponent in 54..64 {
        let center = (1.to_u64() << exponent) + (1.to_u64() << (exponent - 24));
        for bits in[center - 1, center, center + 1] {
            check_integer_floats(bits);
        }
    }
    for value in[
        -32768.9,
        -128.9,
        -127.5,
        -2.5,
        -1.5,
        -0.9,
        -0.5,
        0.5,
        1.5,
        2.5,
        127.5,
        128.0,
        255.9,
        256.0,
        32767.9,
        65535.9,
    ] {
        check_float_integer(value);
    }
    let mut state = 0x9e3779b97f4a7c15;
    for _ in 0..512 {
        state = state ^ (state << 13);
        state = state ^ (state >> 7);
        state = state ^ (state << 17);
        check_integer_floats(state);
        check_float_integer(float64_from_bits(state));
    }
}
