package main;

use std::bytes;
use std::io;
use io::{Read, Write};
use std::testing;
use std::testing::io as iotest;

fn testing_io_error() -> io::Error {
    io::Error::new(
        io::ErrorKind::Interrupted,
        "fixture source",
        Option::Some("case"),
        Option::Some(17),
        "injected failure",
    )
}

fn check_testing_io() -> () {
    testing::assert(iotest::FragmentReader::new(bytes::Bytes::new(), 0).is_err());
    testing::assert(iotest::FragmentWriter::new(-1).is_err());
    testing::assert(
        iotest::FragmentReader::with_error(bytes::Bytes::from_vec(b"ab"), 1, 3, testing_io_error()).is_err(),
    );
    testing::assert(iotest::FragmentWriter::with_error(1, -1, testing_io_error()).is_err());
    for length in 0..9 {
        let input = Vec::new();
        for index in 0..length {
            input.push((index + 1).to_u8());
        }
        for chunk in 1..5 {
            let source = testing::expect_ok(
                iotest::FragmentReader::new(bytes::Bytes::from_vec(input.copy()), chunk),
                "fragment reader",
            );
            let alias = source;
            let writer = testing::expect_ok(iotest::FragmentWriter::new(chunk), "fragment writer");
            let output = writer;
            let scratch = b"?????";
            assert_equal(
                testing::expect_ok(
                    io::copy_buffer_progress(source, writer, scratch.as_mut_slice()),
                    "fragment copy",
                ),
                length.to_u64(),
            );
            assert_equal(alias.position(), length);
            assert_equal(output.bytes().to_vec(), input);
            testing::assert(alias.calls() >= 1);
            assert_equal(output.calls(), (length + chunk - 1) / chunk);
            let snapshot = output.bytes();
            snapshot.push(255.to_u8());
            assert_equal(output.bytes().len(), length);
            let reader = testing::expect_ok(
                iotest::FragmentReader::new(bytes::Bytes::from_vec(input.copy()), chunk),
                "exact reader",
            );
            let exact = Vec::new();
            for _ in 0..length {
                exact.push(0.to_u8());
            }
            testing::expect_ok(reader.read_exact(exact.as_mut_slice()), "short exact read");
            assert_equal(exact, input);
            assert_equal(reader.position(), length);
            let writer = testing::expect_ok(iotest::FragmentWriter::new(chunk), "write all fixture");
            testing::expect_ok(writer.write_all(input.as_slice()), "short write all");
            assert_equal(writer.bytes().to_vec(), input);
        }
    }
    let original = bytes::Bytes::from_vec(b"abcdef");
    let reader = testing::expect_ok(iotest::FragmentReader::new(original, 2), "snapshot source");
    original.set(0, b'Z');
    let output = b"?";
    assert_equal(testing::expect_ok(reader.read(output.as_mut_slice()), "copied source"), 1);
    assert_equal(output[0], b'a');
    for fail_after in 0..7 {
        let reader = testing::expect_ok(
            iotest::FragmentReader::with_error(
                bytes::Bytes::from_vec(b"abcdef"),
                2,
                fail_after,
                testing_io_error(),
            ),
            "delayed read fixture",
        );
        let writer = testing::expect_ok(iotest::FragmentWriter::new(3), "copy sink");
        let scratch = b"???";
        let failure = testing::expect_err(
            io::copy_buffer_progress(reader, writer, scratch.as_mut_slice()),
            "delayed read error",
        );
        assert_equal(failure.read_count(), fail_after.to_u64());
        assert_equal(failure.written_count(), fail_after.to_u64());
        assert_equal(failure.error(), testing_io_error());
        assert_equal(reader.position(), fail_after);
        assert_equal(writer.bytes().to_vec(), b"abcdef".as_slice().sub(0, fail_after).to_vec());
        let empty: Vec[byte] = Vec::new();
        assert_equal(testing::expect_ok(reader.read(empty.as_mut_slice()), "empty read"), 0);
        let single = b"?";
        assert_equal(
            testing::expect_err(reader.read(single.as_mut_slice()), "sticky read failure"),
            testing_io_error(),
        );
        assert_equal(reader.position(), fail_after);
        let writer = testing::expect_ok(
            iotest::FragmentWriter::with_error(2, fail_after, testing_io_error()),
            "delayed write fixture",
        );
        let source = testing::expect_ok(
            iotest::FragmentReader::new(bytes::Bytes::from_vec(b"abcdefg"), 3),
            "copy source",
        );
        let scratch = b"???";
        let failure = testing::expect_err(
            io::copy_buffer_progress(source, writer, scratch.as_mut_slice()),
            "delayed write error",
        );
        assert_equal(failure.written_count(), fail_after.to_u64());
        assert_equal(failure.error(), testing_io_error());
        assert_equal(writer.bytes().to_vec(), b"abcdefg".as_slice().sub(0, fail_after).to_vec());
        let empty: Vec[byte] = Vec::new();
        assert_equal(testing::expect_ok(writer.write(empty.as_slice()), "empty write"), 0);
        assert_equal(
            testing::expect_err(writer.write(b"x".as_slice()), "sticky write failure"),
            testing_io_error(),
        );
        assert_equal(writer.bytes().len(), fail_after);
    }
}
