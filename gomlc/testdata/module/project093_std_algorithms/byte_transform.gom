package main;

use std::bytes;
use std::ffi;
use std::testing;

#[go_ffi("bytes", "Count")]
extern fn go_bytes_count(input: Slice[byte], pattern: Slice[byte]) -> isize;

#[go_ffi("bytes", "SplitN")]
extern fn go_bytes_split_n(input: Slice[byte], separator: Slice[byte], count: isize) -> ffi::RawSlice[
    ffi::RawSlice[byte],
];

#[go_ffi("bytes", "SplitAfterN")]
extern fn go_bytes_split_after_n(input: Slice[byte], separator: Slice[byte], count: isize) -> ffi::RawSlice[
    ffi::RawSlice[byte],
];

#[go_ffi("bytes", "Replace")]
extern fn go_bytes_replace(
    input: Slice[byte],
    old: Slice[byte],
    replacement: Slice[byte],
    count: isize,
) -> ffi::RawSlice[byte];

#[go_ffi("bytes", "Repeat")]
extern fn go_bytes_repeat(input: Slice[byte], count: isize) -> ffi::RawSlice[byte];

#[go_ffi("example.com/goml-std-algorithms/native", "ByteLines")]
extern fn go_byte_lines(input: Slice[byte]) -> ffi::RawSlice[ffi::RawSlice[byte]];

fn check_byte_iterator(parts: FnIterator[Slice[byte]], expected: ffi::RawSlice[ffi::RawSlice[byte]]) -> () {
    for index in 0..expected.len() {
        let part = testing::expect_some(parts.next(), "next byte part");
        assert_equal(part.to_vec(), expected[index].as_slice().to_vec());
    }
    testing::assert(parts.next().is_none());
    testing::assert(parts.next().is_none());
}

fn check_byte_parts(actual: Vec[Slice[byte]], expected: ffi::RawSlice[ffi::RawSlice[byte]]) -> () {
    assert_equal(actual.len(), expected.len());
    for index in 0..actual.len() {
        assert_equal(actual[index].to_vec(), expected[index].as_slice().to_vec());
    }
}

fn check_byte_transform_case(input: Slice[byte], separator: Slice[byte], replacement: Slice[byte]) -> () {
    check_byte_iterator(bytes::split_iter(input, separator), go_bytes_split_n(input, separator, -1));
    check_byte_iterator(
        bytes::split_after_iter(input, separator),
        go_bytes_split_after_n(input, separator, -1),
    );
    assert_equal(
        testing::expect_ok(bytes::count(input, separator), "count"),
        go_bytes_count(input, separator),
    );
    for maximum in[-9223372036854775808, -2, -1, 0, 1, 2, 5, 100, 9223372036854775807] {
        let expected = go_bytes_split_n(input, separator, maximum);
        let parts = testing::expect_ok(
            bytes::split_n(input, separator, maximum, expected.len()),
            "split at exact limit",
        );
        check_byte_parts(parts, expected);
        let expected_after = go_bytes_split_after_n(input, separator, maximum);
        let after = testing::expect_ok(
            bytes::split_after_n(input, separator, maximum, expected_after.len()),
            "split after",
        );
        check_byte_parts(after, expected_after);
        if expected.len() > 0 {
            testing::assert(bytes::split_n(input, separator, maximum, expected.len() - 1).is_err());
        }
        if expected_after.len() > 0 {
            testing::assert(
                bytes::split_after_n(input, separator, maximum, expected_after.len() - 1).is_err(),
            );
        }
        let changed = go_bytes_replace(input, separator, replacement, maximum).as_slice();
        let result = testing::expect_ok(
            bytes::replace_n(input, separator, replacement, maximum, changed.len()),
            "replace at exact limit",
        );
        assert_equal(result.to_vec(), changed.to_vec());
        if changed.len() > 0 {
            testing::assert(
                bytes::replace_n(input, separator, replacement, maximum, changed.len() - 1).is_err(),
            );
        }
    }
    let all = testing::expect_ok(bytes::split(input, separator, 100), "split all");
    check_byte_parts(all, go_bytes_split_n(input, separator, -1));
    check_byte_parts(
        testing::expect_ok(bytes::split_after(input, separator, 100), "split after all"),
        go_bytes_split_after_n(input, separator, -1),
    );
    let joined = testing::expect_ok(bytes::join(all, separator, input.len()), "join");
    assert_equal(joined.to_vec(), input.to_vec());
    assert_equal(
        testing::expect_ok(bytes::replace(input, separator, replacement, 1000), "replace all").to_vec(),
        go_bytes_replace(input, separator, replacement, -1).as_slice().to_vec(),
    );
}

fn check_byte_transform() -> () {
    check_byte_construction_aliases();
    for value in["", "\n", "\n\n", "a", "a\n", "a\nb", "a\r\nb\r", "é\n界\n🙂", "\r"] {
        let encoded = value.to_bytes();
        check_byte_iterator(
            bytes::lines_iter(encoded.as_slice()),
            go_byte_lines(encoded.as_slice()),
        );
    }
    let binary_lines = Vec::from_array([255.to_u8(), b'\n', 0.to_u8(), b'\n']);
    check_byte_iterator(
        bytes::lines_iter(binary_lines.as_slice()),
        go_byte_lines(binary_lines.as_slice()),
    );
    let live = bytes::Bytes::from_string("a,b,c");
    let delimiter = bytes::Bytes::from_string(",");
    let lazy = bytes::split_iter(live.as_slice(), delimiter.as_slice());
    let alias = lazy;
    delimiter.set(0, b':');
    let first = testing::expect_some(lazy.next(), "first lazy part");
    live.set(0, b'z');
    assert_equal(first[0], b'z');
    assert_equal(
        testing::expect_some(alias.next(), "shared iterator state").to_vec(),
        "b".to_bytes(),
    );
    live.set(4, b'd');
    assert_equal(testing::expect_some(lazy.next(), "live remaining input").to_vec(), "d".to_bytes());
    testing::assert(alias.next().is_none());
    testing::assert(lazy.next().is_none());
    let changing = bytes::Bytes::from_string("a,b,c");
    let commas = bytes::Bytes::from_string(",");
    let delayed = bytes::split_iter(changing.as_slice(), commas.as_slice());
    let independent = bytes::split_iter(changing.as_slice(), commas.as_slice());
    assert_equal(testing::expect_some(delayed.next(), "lazy first").to_vec(), "a".to_bytes());
    changing.set(3, b':');
    assert_equal(
        testing::expect_some(delayed.next(), "remaining delimiter read lazily").to_vec(),
        "b:c".to_bytes(),
    );
    assert_equal(
        testing::expect_some(independent.next(), "independent iterator").to_vec(),
        "a".to_bytes(),
    );
    testing::assert(delayed.next().is_none());
    let inputs: Vec[Vec[byte]] = Vec::new();
    for length in 0..5 {
        for bits in 0..(1 << length) {
            let input: Vec[byte] = Vec::new();
            for index in 0..length {
                input.push(
                    if bits & (1 << index) == 0 {
                        0
                    } else {
                        255
                    },
                );
            }
            inputs.push(input);
        }
    }
    inputs.push("é界🙂".to_bytes());
    inputs.push("ababa".to_bytes());
    let empty: Vec[byte] = Vec::new();
    let replacement = Vec::from_array([b'x', b'y']);
    for input in inputs {
        for separator in inputs {
            check_byte_transform_case(
                input.as_slice(),
                separator.as_slice(),
                replacement.as_slice(),
            );
            check_byte_transform_case(input.as_slice(), separator.as_slice(), empty.as_slice());
        }
        for count in 0..5 {
            let expected = go_bytes_repeat(input.as_slice(), count);
            let repeated = testing::expect_ok(
                bytes::repeat(input.as_slice(), count, expected.len()),
                "repeat",
            );
            assert_equal(repeated.to_vec(), expected.as_slice().to_vec());
            if expected.len() > 0 {
                testing::assert(bytes::repeat(input.as_slice(), count, expected.len() - 1).is_err());
            }
        }
    }
    for first in 0..256 {
        for second in 0..256 {
            let input = Vec::from_array([first.to_u8(), second.to_u8()]);
            assert_equal(
                testing::expect_ok(bytes::count(input.as_slice(), empty.as_slice()), "empty count"),
                go_bytes_count(input.as_slice(), empty.as_slice()),
            );
            check_byte_parts(
                testing::expect_ok(
                    bytes::split(input.as_slice(), empty.as_slice(), 2),
                    "byte boundaries",
                ),
                go_bytes_split_n(input.as_slice(), empty.as_slice(), -1),
            );
        }
    }
    for sequence in["é", "界", "🙂", "�"] {
        let encoded = sequence.to_bytes();
        for end in 0..encoded.len() + 1 {
            check_byte_transform_case(
                encoded.slice(0, end),
                empty.as_slice(),
                replacement.as_slice(),
            );
        }
        for index in 0..encoded.len() {
            for value in 0..256 {
                let changed = encoded.copy();
                changed[index] = value.to_u8();
                check_byte_transform_case(
                    changed.as_slice(),
                    empty.as_slice(),
                    replacement.as_slice(),
                );
            }
        }
    }
    let source = bytes::Bytes::from_string("a,b");
    let comma = bytes::Bytes::from_string(",");
    let parts = testing::expect_ok(
        bytes::split(source.as_slice(), comma.as_slice(), 2),
        "shared parts",
    );
    let joined = testing::expect_ok(bytes::join(parts, comma.as_slice(), 3), "independent joined");
    let copied = testing::expect_ok(
        bytes::replace_n(source.as_slice(), comma.as_slice(), empty.as_slice(), 0, 3),
        "zero replacement copy",
    );
    source.set(0, b'z');
    assert_equal(parts[0][0], b'z');
    assert_equal(joined.get(0), b'a');
    assert_equal(copied.get(0), b'a');
    testing::assert(bytes::join(parts, comma.as_slice(), 2).is_err());
    testing::assert(bytes::repeat(source.as_slice(), -1, 100).is_err());
    testing::assert(bytes::repeat(source.as_slice(), 9223372036854775807, 100).is_err());
    testing::assert(bytes::repeat(empty.as_slice(), 9223372036854775807, 0).is_ok());
    testing::assert(bytes::split_n(empty.as_slice(), empty.as_slice(), 0, -1).is_err());
    testing::assert(bytes::join(Vec::new(), empty.as_slice(), -1).is_err());
    testing::assert(
        bytes::replace(empty.as_slice(), empty.as_slice(), empty.as_slice(), -1).is_err(),
    );
    testing::assert(bytes::repeat(empty.as_slice(), 0, -1).is_err());
    match bytes::repeat(source.as_slice(), 9223372036854775807, 100) {
        Result::Err(bytes::TransformError::LengthOverflow) => (),
        _ => testing::fail("expected length overflow"),
    }
    match bytes::repeat(empty.as_slice(), -7, 0) {
        Result::Err(bytes::TransformError::InvalidCount(value)) => assert_equal(value, -7),
        _ => testing::fail("expected invalid repetition count"),
    }
    match bytes::split(empty.as_slice(), comma.as_slice(), -3) {
        Result::Err(bytes::TransformError::InvalidLimit(value)) => assert_equal(value, -3),
        _ => testing::fail("expected invalid split limit"),
    }
    match bytes::join(parts, comma.as_slice(), 2) {
        Result::Err(bytes::TransformError::LimitExceeded(value)) => assert_equal(value, 2),
        _ => testing::fail("expected output limit"),
    }
}

fn check_byte_construction_aliases() -> () {
    for start in 0..7 {
        for end in start..7 {
            for separator_start in 0..7 {
                for separator_end in separator_start..7 {
                    let source = b"ababa\xff";
                    let first = source.slice(start, end);
                    let separator = source.slice(separator_start, separator_end);
                    let parts = Vec::from_array([first, source.as_slice(), first]);
                    let expected = first.to_vec();
                    for part in Vec::from_array([separator, source.as_slice(), separator, first]) {
                        for value in part {
                            expected.push(value);
                        }
                    }
                    let joined = testing::expect_ok(
                        bytes::join(parts, separator, expected.len()),
                        "overlapping join",
                    );
                    assert_equal(joined.to_vec(), expected);
                    let oracle = go_bytes_replace(source.as_slice(), first, separator, -1).to_vec();
                    let replaced = testing::expect_ok(
                        bytes::replace(source.as_slice(), first, separator, oracle.len()),
                        "overlapping replacement",
                    );
                    assert_equal(replaced.to_vec(), oracle);
                    let repeated = testing::expect_ok(
                        bytes::repeat(first, 1, first.len()),
                        "single repetition copy",
                    );
                    let original_part = first.to_vec();
                    testing::assert(bytes::join(parts, separator, expected.len() - 1).is_err());
                    assert_equal(source, b"ababa\xff");
                    for index in 0..source.len() {
                        source[index] = b'?';
                    }
                    assert_equal(joined.to_vec(), expected);
                    assert_equal(replaced.to_vec(), oracle);
                    assert_equal(repeated.to_vec(), original_part);
                    joined.set(0, b'!');
                    assert_equal(source, b"??????");
                }
            }
        }
    }
}
