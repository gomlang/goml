package main;

use std::testing::fs as memory;
use std::fs;
use fs::DirectoryEntry;
use std::bytes;
use std::io;
use std::testing;

fn memory_model_limits() -> memory::MemoryLimits {
    memory::MemoryLimits {
        max_nodes: 100,
        max_data_bytes: 10000,
        max_path_bytes: 10000,
        max_depth: 100,
        max_link_hops: 100,
        max_resolve_work: 10000,
    }
}

fn memory_model_failure(
    nodes: Vec[memory::MemoryNode],
    limits: memory::MemoryLimits,
    kind: io::ErrorKind,
) -> fs::Error {
    let error = testing::expect_err(
        memory::MemoryFS::new(nodes, limits),
        "memory constructor rejection",
    );
    assert_equal(error.kind(), kind);
    assert_equal(error.operation(), "build memory filesystem");
    assert_equal(error.raw_os_code(), Option::None);
    error
}

fn memory_model_names(source: memory::MemoryFS, path: string) -> Vec[string] {
    let entries = testing::expect_ok(fs::read_dir_from(source, path, 100), "memory model directory");
    let names = Vec::new();
    for entry in entries {
        names.push(entry.name());
    }
    names
}

pub fn test_fs_memory_model() -> () {
    let base = memory_model_limits();
    let factory = memory::MemoryNode::file("factory", bytes::Bytes::new());
    assert_equal(factory.mode, fs::FileMode::new(fs::NodeKind::File, 0o444, mode_flags(0)));
    assert_equal(factory.modified_unix_nanoseconds, 0);
    let maximum = 9223372036854775807;
    let wide = memory::MemoryLimits {
        max_nodes: maximum,
        max_data_bytes: maximum,
        max_path_bytes: maximum,
        max_depth: maximum,
        max_link_hops: maximum,
        max_resolve_work: maximum,
    };
    assert_equal(
        testing::expect_ok(memory::MemoryFS::new(Vec::new(), wide), "maximum constructor budgets").node_count(),
        1,
    );
    for field in 0..6 {
        for negative in[-1, -9223372036854775807 - 1] {
            let limits = memory::MemoryLimits {
                max_nodes: if field == 0 {
                    negative
                } else {
                    base.max_nodes
                },
                max_data_bytes: if field == 1 {
                    negative
                } else {
                    base.max_data_bytes
                },
                max_path_bytes: if field == 2 {
                    negative
                } else {
                    base.max_path_bytes
                },
                max_depth: if field == 3 {
                    negative
                } else {
                    base.max_depth
                },
                max_link_hops: if field == 4 {
                    negative
                } else {
                    base.max_link_hops
                },
                max_resolve_work: if field == 5 {
                    negative
                } else {
                    base.max_resolve_work
                },
            };
            let error = memory_model_failure(Vec::new(), limits, io::ErrorKind::InvalidInput);
            assert_equal(error.path(), Option::None);
        }
    }
    let minimal = memory::MemoryLimits {
        max_nodes: 1,
        max_data_bytes: 0,
        max_path_bytes: 1,
        max_depth: 0,
        max_link_hops: 0,
        max_resolve_work: 0,
    };
    let empty = testing::expect_ok(
        memory::MemoryFS::new(Vec::new(), minimal),
        "root exact constructor limits",
    );
    assert_equal(empty.node_count(), 1);
    let _ = memory_model_failure(
        Vec::new(),
        memory::MemoryLimits { max_nodes: 0, ..minimal },
        io::ErrorKind::InvalidData,
    );
    let _ = memory_model_failure(
        Vec::new(),
        memory::MemoryLimits { max_path_bytes: 0, ..minimal },
        io::ErrorKind::InvalidData,
    );
    let source = testing::expect_ok(memory::MemoryFS::new(Vec::new(), base), "default root");
    let metadata = testing::expect_ok(fs::stat_from(source, "."), "derived root metadata");
    assert_equal(metadata.mode(), fs::FileMode::new(fs::NodeKind::Directory, 0o555, mode_flags(0)));
    assert_equal(metadata.len(), 0);
    assert_equal(metadata.modified_unix_nanoseconds(), 0);
    assert_equal(memory_model_names(source, ".").len(), 0);
    let exact_nodes = Vec::from_array(
        [
            memory::MemoryNode::file("a/b", bytes::Bytes::from_string("abc")),
            memory::MemoryNode::link("a/link", "b"),
        ],
    );
    let exact = memory::MemoryLimits {
        max_nodes: 4,
        max_data_bytes: 4,
        max_path_bytes: 11,
        max_depth: 2,
        ..base,
    };
    let source = testing::expect_ok(
        memory::MemoryFS::new(exact_nodes, exact),
        "all constructor budgets exact",
    );
    assert_equal(source.node_count(), 4);
    assert_equal(memory_model_names(source, "."), Vec::from_array(["a"]));
    assert_equal(memory_model_names(source, "a"), Vec::from_array(["b", "link"]));
    let link = testing::expect_ok(
        fs::symlink_metadata_from(source, "a/link"),
        "link target byte metadata",
    );
    assert_equal(link.len(), 1);
    assert_equal(link.mode(), fs::FileMode::new(fs::NodeKind::Symlink, 0o777, mode_flags(0)));
    for field in 0..4 {
        let limits = memory::MemoryLimits {
            max_nodes: if field == 0 {
                3
            } else {
                exact.max_nodes
            },
            max_data_bytes: if field == 1 {
                3
            } else {
                exact.max_data_bytes
            },
            max_path_bytes: if field == 2 {
                10
            } else {
                exact.max_path_bytes
            },
            max_depth: if field == 3 {
                1
            } else {
                exact.max_depth
            },
            ..exact,
        };
        let _ = memory_model_failure(exact_nodes, limits, io::ErrorKind::InvalidData);
    }
    let unicode = Vec::from_array([memory::MemoryNode::file("界/é", bytes::Bytes::from_string("🙂"))]);
    let limits = memory::MemoryLimits {
        max_nodes: 3,
        max_path_bytes: 10,
        max_data_bytes: 4,
        max_depth: 2,
        ..base,
    };
    assert_equal(
        testing::expect_ok(memory::MemoryFS::new(unicode, limits), "UTF-8 byte budgets").node_count(),
        3,
    );
    let _ = memory_model_failure(
        unicode,
        memory::MemoryLimits { max_path_bytes: 9, ..limits },
        io::ErrorKind::InvalidData,
    );
    let _ = memory_model_failure(
        unicode,
        memory::MemoryLimits { max_data_bytes: 3, ..limits },
        io::ErrorKind::InvalidData,
    );
    for path in["", "/", "a/", "a//b", "./a", "a/./b", "..", "a/../b"] {
        let error = memory_model_failure(
            Vec::from_array([memory::MemoryNode::directory(path)]),
            base,
            io::ErrorKind::InvalidInput,
        );
        assert_equal(error.path(), Option::Some(path));
    }
    for path in[".", "a", "a/b"] {
        let node = memory::MemoryNode::directory(path);
        let error = memory_model_failure(
            Vec::from_array([node, node]),
            base,
            io::ErrorKind::AlreadyExists,
        );
        assert_equal(error.path(), Option::Some(path));
    }
    let duplicate = memory::MemoryNode::directory(".");
    let _ = memory_model_failure(
        Vec::from_array([duplicate, duplicate]),
        minimal,
        io::ErrorKind::AlreadyExists,
    );
    for reverse in[false, true] {
        let parent = memory::MemoryNode::file("a", bytes::Bytes::new());
        let child = memory::MemoryNode::directory("a/b/c");
        let error = memory_model_failure(
            if reverse {
                Vec::from_array([child, parent])
            } else {
                Vec::from_array([parent, child])
            },
            base,
            io::ErrorKind::InvalidInput,
        );
        assert_equal(error.path(), Option::Some("a"));
    }
    for node in[
        memory::MemoryNode::file(".", bytes::Bytes::new()),
        memory::MemoryNode::link(".", "target"),
    ] {
        let _ = memory_model_failure(Vec::from_array([node]), base, io::ErrorKind::InvalidInput);
    }
    for kind in mode_kinds() {
        for variant in 0..4 {
            let content = match variant {
                0 => memory::MemoryContent::File(bytes::Bytes::from_string("data")),
                1 => memory::MemoryContent::Directory,
                2 => memory::MemoryContent::Link("target"),
                _ => memory::MemoryContent::Special,
            };
            let valid = match variant {
                0 => kind == fs::NodeKind::File,
                1 => kind == fs::NodeKind::Directory,
                2 => kind == fs::NodeKind::Symlink,
                _ => kind != fs::NodeKind::File && kind != fs::NodeKind::Directory
                    && kind != fs::NodeKind::Symlink,
            };
            let mode = fs::FileMode::from_parts(kind, 0o641, Option::None);
            let nodes = Vec::from_array(
                [
                    memory::MemoryNode {
                        path: "node",
                        mode,
                        modified_unix_nanoseconds: -123,
                        content,
                    },
                ],
            );
            if valid {
                let source = testing::expect_ok(
                    memory::MemoryFS::new(nodes, base),
                    "consistent content mode",
                );
                let metadata = testing::expect_ok(
                    fs::symlink_metadata_from(source, "node"),
                    "exact node metadata",
                );
                assert_equal(metadata.mode(), mode);
                assert_equal(metadata.modified_unix_nanoseconds(), -123);
                assert_equal(
                    metadata.len(),
                    match variant {
                        0 => 4,
                        2 => 6,
                        _ => 0,
                    },
                );
            } else {
                let _ = memory_model_failure(nodes, base, io::ErrorKind::InvalidInput);
            }
        }
    }
    let root_mode = fs::FileMode::new(fs::NodeKind::Directory, 0o700, mode_flags(63));
    let parent_mode = fs::FileMode::from_parts(fs::NodeKind::Directory, 0o711, Option::None);
    for reverse in[false, true] {
        let child = memory::MemoryNode::file("a/b/file", bytes::Bytes::new());
        let parent = memory::MemoryNode {
            mode: parent_mode,
            modified_unix_nanoseconds: 17,
            ..memory::MemoryNode::directory("a"),
        };
        let root = memory::MemoryNode {
            mode: root_mode,
            modified_unix_nanoseconds: -19,
            ..memory::MemoryNode::directory("."),
        };
        let nodes = if reverse {
            Vec::from_array([root, parent, child])
        } else {
            Vec::from_array([child, parent, root])
        };
        let source = testing::expect_ok(
            memory::MemoryFS::new(nodes, base),
            "explicit ancestor metadata survives inference",
        );
        assert_equal(source.node_count(), 4);
        let metadata = testing::expect_ok(fs::stat_from(source, "."), "explicit root metadata");
        assert_equal(metadata.mode(), root_mode);
        assert_equal(metadata.modified_unix_nanoseconds(), -19);
        let metadata = testing::expect_ok(fs::stat_from(source, "a"), "explicit parent metadata");
        assert_equal(metadata.mode(), parent_mode);
        assert_equal(metadata.modified_unix_nanoseconds(), 17);
        assert_equal(
            testing::expect_ok(fs::stat_from(source, "a/b"), "inferred intermediate metadata").mode(),
            fs::FileMode::new(fs::NodeKind::Directory, 0o555, mode_flags(0)),
        );
    }
    let data = bytes::Bytes::from_string("original");
    let nodes = Vec::from_array([memory::MemoryNode::file("file", data)]);
    let source = testing::expect_ok(memory::MemoryFS::new(nodes, base), "immutable memory snapshot");
    let alias = source;
    data.set(0, b'X');
    data.clear();
    nodes[0] = memory::MemoryNode::directory("replacement");
    nodes.push(memory::MemoryNode::directory("added"));
    for source in[source, alias] {
        let read = testing::expect_ok(
            fs::read_file_from(source, "file", 8),
            "source mutation isolated",
        );
        assert_equal(read.to_vec(), b"original");
        read.set(0, b'Y');
        assert_equal(
            testing::expect_ok(fs::read_file_from(source, "file", 8), "output mutation isolated").to_vec(),
            b"original",
        );
        assert_equal(source.node_count(), 2);
        assert_equal(memory_model_names(source, "."), Vec::from_array(["file"]));
    }
    let nodes = Vec::new();
    for path in["界", "z", "é", "a", "a\\b", "a:b", "a\u0000b"] {
        nodes.push(memory::MemoryNode::file(path, bytes::Bytes::new()));
    }
    let source = testing::expect_ok(memory::MemoryFS::new(nodes, base), "logical names and sorting");
    assert_equal(
        memory_model_names(source, "."),
        Vec::from_array(["a", "a\u0000b", "a:b", "a\\b", "z", "é", "界"]),
    );
}
