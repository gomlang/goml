package main;

use std::math::bits;
use std::rand;
use std::testing;

#[go_ffi("math/bits", "OnesCount64")]
extern fn go_bits_count(value: u64) -> isize;

#[go_ffi("math/bits", "Len64")]
extern fn go_bits_len(value: u64) -> isize;

#[go_ffi("math/bits", "LeadingZeros64")]
extern fn go_bits_leading(value: u64) -> isize;

#[go_ffi("math/bits", "TrailingZeros64")]
extern fn go_bits_trailing(value: u64) -> isize;

#[go_ffi("math/bits", "RotateLeft64")]
extern fn go_bits_rotate(value: u64, count: isize) -> u64;

#[go_ffi("math/bits", "Reverse64")]
extern fn go_bits_reverse(value: u64) -> u64;

#[go_ffi("math/bits", "ReverseBytes64")]
extern fn go_bits_reverse_bytes(value: u64) -> u64;

#[go_ffi("math/bits", "Add64")]
extern fn go_bits_add(left: u64, right: u64, carry: u64) -> (u64, u64);

#[go_ffi("math/bits", "Sub64")]
extern fn go_bits_sub(left: u64, right: u64, borrow: u64) -> (u64, u64);

#[go_ffi("math/bits", "Mul64")]
extern fn go_bits_mul(left: u64, right: u64) -> (u64, u64);

#[go_ffi("math/bits", "Div64")]
extern fn go_bits_div(high: u64, low: u64, divisor: u64) -> (u64, u64);

#[go_ffi("math/bits", "Rem64")]
extern fn go_bits_rem(high: u64, low: u64, divisor: u64) -> u64;

fn check_bits() -> () {
    check_bit_boundaries();
    for value in Vec::from_array(
        [0.to_u64(), 1, 2, 255, 256, 0x8000000000000000, 0xffffffffffffffff],
    ) {
        for other in Vec::from_array(
            [0.to_u64(), 1, 2, 255, 256, 0x8000000000000000, 0xffffffffffffffff],
        ) {
            check_bit_word(value, other)
        }
    }
    for index in 0..1024 {
        check_bit_word(rand::next_u64(index.to_u64()), rand::next_u64(index.to_u64() + 5000));
    }
    for index in 0..256 {
        let value = index.to_u8();
        assert_equal(bits::ones_count8(value), go_bits_count(value.to_u64()));
        assert_equal(bits::len8(value), go_bits_len(value.to_u64()));
        assert_equal(bits::leading_zeros8(value), go_bits_leading(value.to_u64()) - 56);
        assert_equal(
            bits::trailing_zeros8(value),
            if value == 0 {
                8
            } else {
                go_bits_trailing(value.to_u64())
            },
        );
        assert_equal(bits::reverse8(value), (go_bits_reverse(value.to_u64()) >> 56).to_u8());
        for shift in -9..10 {
            let amount = shift & 7;
            let expected = ((value.to_u64() << amount) | (value.to_u64() >> (8 - amount))).to_u8();
            assert_equal(bits::rotate_left8(value, shift), expected);
        }
    }
    assert_equal(
        testing::expect_err(bits::div64(0, 1, 0), "zero divisor"),
        bits::DivisionError::DivisionByZero,
    );
    assert_equal(
        testing::expect_err(bits::div64(1, 0, 1), "quotient overflow"),
        bits::DivisionError::Overflow,
    );
    testing::assert_err(bits::rem64(0, 1, 0));
    testing::assert_err(bits::div32(0, 1, 0));
    testing::assert_err(bits::div32(1, 0, 1));
    testing::assert_err(bits::rem32(0, 1, 0));
}

fn check_bit_word(left: u64, right: u64) -> () {
    assert_equal(bits::ones_count64(left), go_bits_count(left));
    assert_equal(bits::len64(left), go_bits_len(left));
    assert_equal(bits::leading_zeros64(left), go_bits_leading(left));
    assert_equal(bits::trailing_zeros64(left), go_bits_trailing(left));
    assert_equal(bits::reverse64(left), go_bits_reverse(left));
    assert_equal(bits::reverse_bytes64(left), go_bits_reverse_bytes(left));
    for shift in Vec::from_array([-129, -65, -64, -1, 0, 1, 63, 64, 65, 129]) {
        assert_equal(bits::rotate_left64(left, shift), go_bits_rotate(left, shift));
    }
    for carry in Vec::from_array([false, true]) {
        let digit: u64 = if carry {
            1
        } else {
            0
        };
        let (sum, overflow) = bits::add64(left, right, carry);
        assert_equal(
            (
                sum,
                if overflow {
                    1.to_u64()
                } else {
                    0.to_u64()
                },
            ),
            go_bits_add(left, right, digit),
        );
        let (difference, underflow) = bits::sub64(left, right, carry);
        assert_equal(
            (
                difference,
                if underflow {
                    1.to_u64()
                } else {
                    0.to_u64()
                },
            ),
            go_bits_sub(left, right, digit),
        );
        let low_left = left.to_u32();
        let low_right = right.to_u32();
        let expected_sum = low_left.to_u64() + low_right.to_u64() + digit;
        assert_equal(
            bits::add32(low_left, low_right, carry),
            (expected_sum.to_u32(), expected_sum >> 32 != 0),
        );
        let expected_difference = low_left.to_u64() - low_right.to_u64() - digit;
        assert_equal(
            bits::sub32(low_left, low_right, carry),
            (expected_difference.to_u32(), low_left.to_u64() < low_right.to_u64() + digit),
        );
    }
    assert_equal(bits::mul64(left, right), go_bits_mul(left, right));
    let product = left.to_u32().to_u64() * right.to_u32().to_u64();
    assert_equal(
        bits::mul32(left.to_u32(), right.to_u32()),
        ((product >> 32).to_u32(), product.to_u32()),
    );
    let divisor = right | 1;
    let high = left % divisor;
    assert_equal(
        testing::expect_ok(bits::div64(high, left, divisor), "wide divide"),
        go_bits_div(high, left, divisor),
    );
    assert_equal(
        testing::expect_ok(bits::rem64(left, right, divisor), "wide remainder"),
        go_bits_rem(left, right, divisor),
    );
    let divisor32 = right.to_u32() | 1;
    let high32 = left.to_u32() % divisor32;
    let dividend32 = (high32.to_u64() << 32) | right.to_u32().to_u64();
    assert_equal(
        testing::expect_ok(bits::div32(high32, right.to_u32(), divisor32), "wide divide32"),
        ((dividend32 / divisor32.to_u64()).to_u32(), (dividend32 % divisor32.to_u64()).to_u32()),
    );
    let full32 = (left.to_u32().to_u64() << 32) | right.to_u32().to_u64();
    assert_equal(
        testing::expect_ok(bits::rem32(left.to_u32(), right.to_u32(), divisor32), "wide rem32"),
        (full32 % divisor32.to_u64()).to_u32(),
    );
    let value16 = left.to_u16();
    assert_equal(bits::ones_count16(value16), go_bits_count(value16.to_u64()));
    assert_equal(bits::len16(value16), go_bits_len(value16.to_u64()));
    assert_equal(bits::leading_zeros16(value16), go_bits_leading(value16.to_u64()) - 48);
    assert_equal(
        bits::trailing_zeros16(value16),
        if value16 == 0 {
            16
        } else {
            go_bits_trailing(value16.to_u64())
        },
    );
    assert_equal(bits::reverse16(value16), (go_bits_reverse(value16.to_u64()) >> 48).to_u16());
    assert_equal(
        bits::reverse_bytes16(value16),
        (go_bits_reverse_bytes(value16.to_u64()) >> 48).to_u16(),
    );
    for shift in Vec::from_array([-129, -1, 0, 1, 15, 16, 17]) {
        let amount = shift & 15;
        assert_equal(
            bits::rotate_left16(value16, shift),
            ((value16.to_u64() << amount) | (value16.to_u64() >> (16 - amount))).to_u16(),
        );
    }
    let value32 = left.to_u32();
    assert_equal(bits::ones_count32(value32), go_bits_count(value32.to_u64()));
    assert_equal(bits::len32(value32), go_bits_len(value32.to_u64()));
    assert_equal(bits::leading_zeros32(value32), go_bits_leading(value32.to_u64()) - 32);
    assert_equal(
        bits::trailing_zeros32(value32),
        if value32 == 0 {
            32
        } else {
            go_bits_trailing(value32.to_u64())
        },
    );
    assert_equal(bits::reverse32(value32), (go_bits_reverse(value32.to_u64()) >> 32).to_u32());
    assert_equal(
        bits::reverse_bytes32(value32),
        (go_bits_reverse_bytes(value32.to_u64()) >> 32).to_u32(),
    );
    for shift in Vec::from_array([-129, -1, 0, 1, 31, 32, 33]) {
        let amount = shift & 31;
        assert_equal(
            bits::rotate_left32(value32, shift),
            ((value32.to_u64() << amount) | (value32.to_u64() >> (32 - amount))).to_u32(),
        );
    }
}
