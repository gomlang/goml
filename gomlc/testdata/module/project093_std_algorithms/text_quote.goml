package main;

use std::text;
use std::bytes;
use std::testing;
use std::ffi;

#[go_ffi("example.com/goml-std-algorithms/native", "Unquote")]
extern fn go_unquote(value: string) -> (ffi::RawSlice[byte], bool);

#[go_ffi("unicode/utf8", "Valid")]
extern fn go_unquote_valid(value: Slice[byte]) -> bool;

#[go_ffi("example.com/goml-std-algorithms/native", "QuotedPrefix")]
extern fn go_quoted_prefix(value: string) -> (string, bool);

fn check_quoted_prefix(value: string) -> () {
    let (expected, valid) = go_quoted_prefix(value);
    let actual = text::quoted_prefix(value, value.byte_len());
    assert_equal(actual.is_ok(), valid);
    if valid {
        assert_equal(testing::expect_ok(actual, "quoted prefix"), expected);
        assert_equal(
            testing::expect_ok(
                text::quoted_prefix(value, expected.byte_len()),
                "prefix exact bound",
            ),
            expected,
        );
        for limit in 0..expected.byte_len() {
            testing::assert(text::quoted_prefix(value, limit).is_err());
        }
        for tail in["tail", "\n'", "\"unterminated", "界"] {
            assert_equal(
                testing::expect_ok(
                    text::quoted_prefix(expected + tail, expected.byte_len()),
                    "prefix ignores tail",
                ),
                expected,
            );
        }
    }
}

fn check_unquote_value(value: string) -> () {
    check_quoted_prefix(value);
    let (expected, valid) = go_unquote(value);
    let actual = text::unquote_bytes(value, value.byte_len());
    assert_equal(actual.is_ok(), valid);
    if valid {
        assert_equal(testing::expect_ok(actual, "unquote bytes").to_vec(), expected.to_vec());
        let exact = testing::expect_ok(
            text::unquote_bytes(value, expected.len()),
            "exact unquote limit",
        );
        assert_equal(exact.to_vec(), expected.to_vec());
        if expected.len() > 0 {
            testing::assert(text::unquote_bytes(value, expected.len() - 1).is_err());
        }
        let strict = text::unquote(value, expected.len());
        assert_equal(strict.is_ok(), go_unquote_valid(expected.as_slice()));
        if let Ok(decoded) = strict {
            assert_equal(decoded.to_bytes(), expected.to_vec());
        }
    }
}

fn check_text_unquote() -> () {
    for value in[
        "",
        "x",
        "\"",
        "''",
        "\"\"",
        "``",
        "'ab'",
        "'界'",
        "'\\xff'",
        "\"\\a\\b\\f\\n\\r\\t\\v\\\\\\\"\"",
        "'\\''",
        "\"\\'\"",
        "'\\\"'",
        "\"\\x00\\xff\"",
        "\"\\xc2\\xa2\"",
        "\"\\000\\377\"",
        "\"\\400\"",
        "\"\\uD800\"",
        "\"\\udfff\"",
        "\"\\U00110000\"",
        "\"\\Uffffffff\"",
        "\"\\U0010ffff\"",
        "\"\\uffff\"",
        "\"\\xFf\"",
        "\"\\u754C\"",
        "\"\\0\"",
        "\"\\07\"",
        "\"\\08a\"",
        "\"\\x0\"",
        "\"\\u123\"",
        "\"a\nb\"",
        "\"a\rb\"",
        "`a\r\nb`",
        "`\\u754c`",
        "\"x\"tail",
        "`x`tail",
    ] {
        check_unquote_value(value);
    }
    let atoms = ["", "a", "界", "\\", "x", "0", "u", "\"", "'", "`", "\n", "\r"];
    for delimiter in["\"", "'", "`"] {
        for first in atoms {
            for second in atoms {
                for third in atoms {
                    check_unquote_value(delimiter + first + second + third + delimiter);
                }
            }
        }
    }
    match text::unquote("\"a\\xff\"", 2) {
        Err(text::UnquoteError::InvalidUtf8(offset)) => assert_equal(offset, 1),
        _ => testing::fail("invalid decoded UTF-8 accepted"),
    }
    match text::unquote_bytes("\"a\\q\"", 20) {
        Err(text::UnquoteError::Syntax(offset)) => assert_equal(offset, 2),
        _ => testing::fail("invalid escape accepted"),
    }
    match text::unquote_bytes("\"a\\u754c\"", 3) {
        Err(text::UnquoteError::OutputLimit(offset)) => assert_equal(offset, 2),
        _ => testing::fail("unquote output limit ignored"),
    }
    match text::unquote_bytes("broken", -1) {
        Err(text::UnquoteError::InvalidLimit(value)) => assert_equal(value, -1),
        _ => testing::fail("unquote negative limit precedence"),
    }
}

#[go_ffi("strconv", "Quote")]
extern fn go_quote(value: string) -> string;

#[go_ffi("strconv", "QuoteToASCII")]
extern fn go_quote_ascii(value: string) -> string;

#[go_ffi("strconv", "QuoteRune")]
extern fn go_quote_char(value: char) -> string;

#[go_ffi("strconv", "QuoteRuneToASCII")]
extern fn go_quote_char_ascii(value: char) -> string;

#[go_ffi("strconv", "QuoteToGraphic")]
extern fn go_quote_graphic(value: string) -> string;

#[go_ffi("strconv", "QuoteRuneToGraphic")]
extern fn go_quote_char_graphic(value: char) -> string;

#[go_ffi("strconv", "CanBackquote")]
extern fn go_can_backquote(value: string) -> bool;

fn check_quote_result(actual: Result[string, bytes::TransformError], expected: string) -> () {
    assert_equal(testing::expect_ok(actual, "quoted text"), expected);
}

fn check_quote_value(value: string) -> () {
    let normal = go_quote(value);
    let ascii = go_quote_ascii(value);
    let graphic = go_quote_graphic(value);
    check_quote_result(text::quote_graphic(value, graphic.byte_len()), graphic);
    testing::assert(text::quote_graphic(value, graphic.byte_len() - 1).is_err());
    assert_equal(
        testing::expect_ok(text::unquote(graphic, value.byte_len()), "graphic roundtrip"),
        value,
    );
    assert_equal(text::can_backquote(value), go_can_backquote(value));
    if text::can_backquote(value) {
        assert_equal(
            testing::expect_ok(text::unquote("`" + value + "`", value.byte_len()), "raw roundtrip"),
            value,
        );
    }
    assert_equal(
        testing::expect_ok(text::unquote(normal, value.byte_len()), "normal quote roundtrip"),
        value,
    );
    assert_equal(
        testing::expect_ok(text::unquote(ascii, value.byte_len()), "ASCII quote roundtrip"),
        value,
    );
    check_quote_result(text::quote(value, normal.byte_len()), normal);
    check_quote_result(text::quote_ascii(value, ascii.byte_len()), ascii);
    testing::assert(text::quote(value, normal.byte_len() - 1).is_err());
    testing::assert(text::quote_ascii(value, ascii.byte_len() - 1).is_err());
}

fn check_quote_character(value: char) -> () {
    check_quote_value(value.to_string());
    let normal = go_quote_char(value);
    let ascii = go_quote_char_ascii(value);
    let graphic = go_quote_char_graphic(value);
    check_quote_result(text::quote_char_graphic(value, graphic.byte_len()), graphic);
    testing::assert(text::quote_char_graphic(value, graphic.byte_len() - 1).is_err());
    check_quote_result(text::quote_char(value, normal.byte_len()), normal);
    check_quote_result(text::quote_char_ascii(value, ascii.byte_len()), ascii);
    testing::assert(text::quote_char(value, normal.byte_len() - 1).is_err());
    testing::assert(text::quote_char_ascii(value, ascii.byte_len() - 1).is_err());
}

fn check_text_quote() -> () {
    check_text_unquote();
    check_quote_value("");
    check_quoted_prefix("\"a\"\"b\"");
    check_quoted_prefix("`a\rb\n`tail");
    check_quoted_prefix("'\\xff'tail");
    match text::quoted_prefix("bad", -1) {
        Err(text::UnquoteError::InvalidLimit(limit)) => assert_equal(limit, -1),
        _ => testing::fail("prefix limit precedence"),
    }
    match text::quoted_prefix("\"\\q\"tail", 20) {
        Err(text::UnquoteError::Syntax(offset)) => assert_equal(offset, 1),
        _ => testing::fail("prefix escape offset"),
    }
    match text::quoted_prefix("\"界\"tail", 3) {
        Err(text::UnquoteError::OutputLimit(offset)) => assert_equal(offset, 1),
        _ => testing::fail("prefix scalar limit"),
    }
    check_quote_value("a\"b'c\\d\n界🙂");
    for value in["\t", "\r", "\n", "a`b", "\"'\\", " 　", "﻿", "a﻿b"] {
        check_quote_value(value);
    }
    for code in 8192..8240 {
        check_quote_character(testing::expect_some(char_from_u32(code.to_u32()), "separator"));
    }
    for limit in[-1, 0, 1] {
        testing::assert(text::quote_graphic("", limit).is_err());
        testing::assert(text::quote_char_graphic('a', limit).is_err());
    }
    for code in 0..256 {
        check_quote_character(testing::expect_some(char_from_u32(code.to_u32()), "Latin-1 scalar"));
    }
    let mut code: u32 = 256;
    while code <= 1114111 {
        if let Some(value) = char_from_u32(code) {
            check_quote_character(value);
        }
        code += 97;
    }
    for value in['\'', '"', '\\', '�', '界', '🙂', '　', ' '] {
        check_quote_character(value);
    }
    check_quote_result(text::quote_ascii("界", 8), "\"\\u754c\"");
    check_quote_result(text::quote_char_ascii('🙂', 12), "'\\U0001f642'");
    match text::quote("", -1) {
        Err(bytes::TransformError::InvalidLimit(value)) => assert_equal(value, -1),
        _ => testing::fail("negative quote limit accepted"),
    }
    match text::quote("", 1) {
        Err(bytes::TransformError::LimitExceeded(value)) => assert_equal(value, 1),
        _ => testing::fail("quote delimiters exceed limit"),
    }
}
