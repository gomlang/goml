package main;

use std::fs;
use fs::{File, FileSystem, DirectoryEntry, ReadDirFile};
use std::io;
use io::{Read, Close};
use std::panic;
use std::testing;

struct WalkProbeEntry {
    label: string,
    kind: fs::FileType,
    identity: isize,
    names: Ref[isize],
    types: Ref[isize],
    metadata_calls: Ref[isize],
}

fn walk_probe_entry(label: string, kind: fs::FileType, identity: isize) -> WalkProbeEntry {
    WalkProbeEntry {
        label,
        kind,
        identity,
        names: Ref::new(0),
        types: Ref::new(0),
        metadata_calls: Ref::new(0),
    }
}

fn walk_probe_error(operation: string) -> fs::Error {
    fs::Error::new(
        io::ErrorKind::Interrupted,
        operation,
        Option::Some("provider/original"),
        Option::Some(73),
        "walk original cause",
    )
}

impl DirectoryEntry for WalkProbeEntry {
    fn name(self: WalkProbeEntry) -> string {
        self.names.set(self.names.get() + 1);
        self.label
    }

    fn file_type(self: WalkProbeEntry) -> fs::FileType {
        self.types.set(self.types.get() + 1);
        self.kind
    }

    fn metadata(self: WalkProbeEntry) -> Result[fs::Metadata, fs::Error] {
        self.metadata_calls.set(self.metadata_calls.get() + 1);
        Result::Err(walk_probe_error("entry metadata " + self.identity.to_string()))
    }
}

struct WalkProbeNode {
    path: string,
    kind: fs::FileType,
    entries: Vec[WalkProbeEntry],
    chunk: isize,
    error_on: isize,
    open_error: bool,
    stat_error: bool,
    read_panic: bool,
    close_mode: isize,
}

fn walk_probe_node(path: string, entries: Vec[WalkProbeEntry]) -> WalkProbeNode {
    WalkProbeNode {
        path,
        kind: fs::FileType::Directory,
        entries,
        chunk: 128,
        error_on: -1,
        open_error: false,
        stat_error: false,
        read_panic: false,
        close_mode: 0,
    }
}

struct WalkProbeFs {
    nodes: Vec[WalkProbeNode],
    events: Vec[string],
    active: Ref[isize],
}

struct WalkProbeHandle {
    filesystem: WalkProbeFs,
    node: WalkProbeNode,
    position: Ref[isize],
    calls: Ref[isize],
    closed: Ref[bool],
}

fn walk_probe_fs(nodes: Vec[WalkProbeNode]) -> WalkProbeFs {
    WalkProbeFs { nodes, events: Vec::new(), active: Ref::new(0) }
}

impl FileSystem for WalkProbeFs {
    type Handle = WalkProbeHandle;

    fn open(self: WalkProbeFs, name: string) -> Result[WalkProbeHandle, fs::Error] {
        self.events.push("open:" + name);
        for node in self.nodes {
            if node.path == name {
                if node.open_error {
                    return Result::Err(walk_probe_error("open"))
                }
                self.active.set(self.active.get() + 1);
                return Result::Ok(
                    WalkProbeHandle {
                        filesystem: self,
                        node,
                        position: Ref::new(0),
                        calls: Ref::new(0),
                        closed: Ref::new(false),
                    },
                )
            }
        }
        Result::Err(walk_probe_error("unexpected open"))
    }
}

impl Read for WalkProbeHandle {
    fn read(self: WalkProbeHandle, buffer: MutSlice[byte]) -> Result[isize, io::Error] {
        panic::raise("walk must not read bytes")
    }
}

impl Close for WalkProbeHandle {
    fn close(self: WalkProbeHandle) -> Result[(), io::Error] {
        testing::assert(!self.closed.get());
        self.closed.set(true);
        self.filesystem.active.set(self.filesystem.active.get() - 1);
        self.filesystem.events.push("close:" + self.node.path);
        if self.calls.get() > 0 && self.node.close_mode == 2 {
            panic::raise("walk close panic")
        }
        if self.calls.get() > 0 && self.node.close_mode == 1 {
            Result::Err(
                io::Error::new(
                    io::ErrorKind::BrokenPipe,
                    "provider close",
                    Option::Some("provider"),
                    Option::Some(19),
                    "walk close cause",
                ),
            )
        } else {
            Result::Ok(())
        }
    }
}

impl File for WalkProbeHandle {
    fn stat(self: WalkProbeHandle) -> Result[fs::Metadata, fs::Error] {
        self.filesystem.events.push("stat:" + self.node.path);
        if self.node.stat_error {
            Result::Err(walk_probe_error("stat"))
        } else {
            Result::Ok(fs::Metadata::from_parts(self.node.kind, 7, 0o640, 123))
        }
    }
}

impl ReadDirFile for WalkProbeHandle {
    type Entry = WalkProbeEntry;

    fn read_dir(self: WalkProbeHandle, amount: isize) -> Result[
        Vec[WalkProbeEntry],
        fs::ReadDirError[WalkProbeEntry],
    ] {
        testing::assert(amount > 0 && amount <= 128);
        self.calls.set(self.calls.get() + 1);
        self.filesystem.events.push("read:" + self.node.path + ":" + amount.to_string());
        if self.node.read_panic {
            panic::raise("walk read panic")
        }
        let mut count = self.node.entries.len() - self.position.get();
        if count > amount {
            count = amount;
        }
        if count > self.node.chunk {
            count = self.node.chunk;
        }
        let result = Vec::new();
        for index in 0..count {
            result.push(self.node.entries[self.position.get() + index]);
        }
        self.position.set(self.position.get() + count);
        if self.calls.get() == self.node.error_on {
            if self.position.get() < self.node.entries.len() {
                self.position.set(self.position.get() + 1);
            }
            Result::Err(fs::ReadDirError::new(result, walk_probe_error("read directory")))
        } else {
            Result::Ok(result)
        }
    }
}

fn walk_probe_limits() -> fs::WalkLimits {
    fs::WalkLimits {
        max_depth: 100,
        max_directory_entries: 100,
        max_directories: 100,
        max_work: 10000,
    }
}

fn walk_probe_tree() -> WalkProbeFs {
    walk_probe_fs(
        Vec::from_array(
            [
                walk_probe_node(
                    ".",
                    Vec::from_array(
                        [
                            walk_probe_entry("z", fs::FileType::File, 0),
                            walk_probe_entry("a", fs::FileType::Directory, 1),
                            walk_probe_entry("m", fs::FileType::Symlink, 2),
                        ],
                    ),
                ),
                walk_probe_node(
                    "a",
                    Vec::from_array(
                        [
                            walk_probe_entry("q", fs::FileType::File, 3),
                            walk_probe_entry("b", fs::FileType::File, 4),
                        ],
                    ),
                ),
            ],
        ),
    )
}

fn check_walk_probe_order_and_controls() -> () {
    for mode in 0..5 {
        let source = walk_probe_tree();
        let visited = Vec::new();
        testing::expect_ok(
            fs::walk_from(
                source,
                ".",
                walk_probe_limits(),
                |path, entry, error| {
                    assert_equal(source.active.get(), 0);
                    testing::assert(error.is_none());
                    let item = testing::expect_some(entry, "walk entry");
                    let _ = item.name();
                    let _ = item.name();
                    let _ = item.file_type();
                    let _ = item.file_type();
                    if path == "." {
                        assert_equal(
                            testing::expect_ok(item.metadata(), "cached root metadata").len(),
                            7,
                        );
                        assert_equal(
                            testing::expect_ok(item.metadata(), "repeat cached root metadata").len(),
                            7,
                        );
                    }
                    visited.push(path);
                    Result::Ok(
                        if (mode == 1 && path == "a") || (mode == 2 && path == "a/b")
                            || (mode == 4 && path == ".") {
                            fs::WalkControl::SkipDir
                        } else if mode == 3 && path == "a" {
                            fs::WalkControl::SkipAll
                        } else {
                            fs::WalkControl::Continue
                        },
                    )
                },
            ),
            "walk controls",
        );
        assert_equal(
            visited,
            match mode {
                0 => Vec::from_array([".", "a", "a/b", "a/q", "m", "z"]),
                1 => Vec::from_array([".", "a", "m", "z"]),
                2 => Vec::from_array([".", "a", "a/b", "m", "z"]),
                3 => Vec::from_array([".", "a"]),
                _ => Vec::from_array(["."]),
            },
        );
        for node in source.nodes {
            for entry in node.entries {
                assert_equal(entry.metadata_calls.get(), 0);
                testing::assert(entry.names.get() <= 1);
                testing::assert(entry.types.get() <= 1);
            }
        }
        testing::assert(!source.events.contains("open:m"));
        testing::assert(!source.events.contains("open:z"));
        testing::assert(!source.events.contains("stat:a"));
        if mode == 1 || mode == 3 || mode == 4 {
            testing::assert(!source.events.contains("open:a"));
        }
        assert_equal(source.active.get(), 0);
    }
}

fn check_walk_probe_errors() -> () {
    for mode in 0..4 {
        let tree = walk_probe_tree();
        let source = walk_probe_fs(
            Vec::from_array(
                [
                    WalkProbeNode { chunk: 1, error_on: 2, close_mode: 1, ..tree.nodes[0] },
                    tree.nodes[1],
                ],
            ),
        );
        let visited = Vec::new();
        let failures = Ref::new(0);
        let callback_error = walk_probe_error("callback");
        let result = fs::walk_from(
            source,
            ".",
            walk_probe_limits(),
            |path, entry, error| {
                assert_equal(source.active.get(), 0);
                testing::assert(entry.is_some());
                if let Some(cause) = error {
                    assert_equal(path, ".");
                    assert_equal(cause, walk_probe_error("read directory"));
                    failures.set(failures.get() + 1);
                    visited.push("error");
                    if mode == 3 {
                        Result::Err(callback_error)
                    } else {
                        Result::Ok(
                            match mode {
                                0 => fs::WalkControl::Continue,
                                1 => fs::WalkControl::SkipDir,
                                _ => fs::WalkControl::SkipAll,
                            },
                        )
                    }
                } else {
                    visited.push(path);
                    Result::Ok(fs::WalkControl::Continue)
                }
            },
        );
        if mode == 3 {
            assert_equal(testing::expect_err(result, "callback error retained"), callback_error);
        } else {
            testing::expect_ok(result, "handled partial failure");
        }
        assert_equal(failures.get(), 1);
        assert_equal(
            visited,
            if mode == 0 {
                Vec::from_array([".", "error", "a", "a/b", "a/q", "z"])
            } else {
                Vec::from_array([".", "error"])
            },
        );
        assert_equal(source.active.get(), 0);
    }
    for open_error in[false, true] {
        for control in[
            fs::WalkControl::Continue,
            fs::WalkControl::SkipDir,
            fs::WalkControl::SkipAll,
        ] {
            let source = walk_probe_fs(
                Vec::from_array(
                    [
                        WalkProbeNode {
                            open_error,
                            stat_error: !open_error,
                            ..walk_probe_node(".", Vec::new()),
                        },
                    ],
                ),
            );
            let calls = Ref::new(0);
            testing::expect_ok(
                fs::walk_from(
                    source,
                    ".",
                    walk_probe_limits(),
                    |path, entry, error| {
                        assert_equal(path, ".");
                        testing::assert(entry.is_none());
                        assert_equal(
                            testing::expect_some(error, "root cause"),
                            walk_probe_error(
                                if open_error {
                                    "open"
                                } else {
                                    "stat"
                                },
                            ),
                        );
                        calls.set(calls.get() + 1);
                        Result::Ok(control)
                    },
                ),
                "root error handled",
            );
            assert_equal(calls.get(), 1);
            assert_equal(source.active.get(), 0);
        }
    }
}

fn check_walk_probe_stable_entries() -> () {
    let entries = Vec::from_array(
        [
            walk_probe_entry("z", fs::FileType::File, 0),
            walk_probe_entry("a", fs::FileType::File, 1),
            walk_probe_entry("a", fs::FileType::File, 2),
        ],
    );
    let source = walk_probe_fs(
        Vec::from_array([WalkProbeNode { chunk: 1, ..walk_probe_node(".", entries) }]),
    );
    let identities = Vec::new();
    testing::expect_ok(
        fs::walk_from(
            source,
            ".",
            walk_probe_limits(),
            |path, entry, error| {
                testing::assert(error.is_none());
                if path != "." {
                    let entry = testing::expect_some(entry, "stable child entry");
                    let failure = testing::expect_err(entry.metadata(), "lazy child metadata cause");
                    assert_equal(failure.path(), Option::Some("provider/original"));
                    identities.push(failure.operation());
                }
                Result::Ok(fs::WalkControl::Continue)
            },
        ),
        "stable duplicate entry order",
    );
    assert_equal(
        identities,
        Vec::from_array(["entry metadata 1", "entry metadata 2", "entry metadata 0"]),
    );
    for entry in entries {
        assert_equal(entry.names.get(), 1);
        assert_equal(entry.types.get(), 1);
        assert_equal(entry.metadata_calls.get(), 1);
    }
}

fn check_walk_probe_limits() -> () {
    for field in 0..4 {
        let base = walk_probe_limits();
        let limits = fs::WalkLimits {
            max_depth: if field == 0 {
                -1
            } else {
                base.max_depth
            },
            max_directory_entries: if field == 1 {
                -1
            } else {
                base.max_directory_entries
            },
            max_directories: if field == 2 {
                -1
            } else {
                base.max_directories
            },
            max_work: if field == 3 {
                -1
            } else {
                base.max_work
            },
        };
        let source = walk_probe_tree();
        let error = testing::expect_err(
            fs::walk_from(
                source,
                ".",
                limits,
                |_, _, _| panic::raise("invalid limits invoked callback"),
            ),
            "negative walk limit",
        );
        assert_equal(error.kind(), io::ErrorKind::InvalidInput);
        assert_equal(source.events.len(), 0);
    }
    for budget in 0..3 {
        for mode in 0..3 {
            let source = walk_probe_tree();
            let limits = match budget {
                0 => fs::WalkLimits { max_depth: 0, ..walk_probe_limits() },
                1 => fs::WalkLimits { max_directories: 0, ..walk_probe_limits() },
                _ => fs::WalkLimits { max_work: 1, ..walk_probe_limits() },
            };
            let failures = Ref::new(0);
            let result = fs::walk_from(
                source,
                ".",
                limits,
                |_, _, error| {
                    if error.is_some() {
                        failures.set(failures.get() + 1);
                        Result::Ok(
                            match mode {
                                0 => fs::WalkControl::Continue,
                                1 => fs::WalkControl::SkipDir,
                                _ => fs::WalkControl::SkipAll,
                            },
                        )
                    } else {
                        Result::Ok(fs::WalkControl::Continue)
                    }
                },
            );
            if mode == 2 {
                testing::expect_ok(result, "SkipAll handles limit");
            } else {
                testing::assert(result.is_err());
            }
            assert_equal(failures.get(), 1);
            assert_equal(source.events, Vec::from_array(["open:.", "stat:.", "close:."]));
        }
    }
    let source = walk_probe_tree();
    testing::expect_ok(
        fs::walk_from(
            source,
            ".",
            fs::WalkLimits { max_depth: 0, max_directories: 0, max_work: 1, ..walk_probe_limits() },
            |_, _, error| {
                testing::assert(error.is_none());
                Result::Ok(fs::WalkControl::SkipDir)
            },
        ),
        "skip boundary root without expansion",
    );
    assert_equal(source.events, Vec::from_array(["open:.", "stat:.", "close:."]));
    for max_work in[3, 4] {
        let source = walk_probe_fs(Vec::from_array([walk_probe_node(".", Vec::new())]));
        let failures = Ref::new(0);
        let result = fs::walk_from(
            source,
            ".",
            fs::WalkLimits { max_work, ..walk_probe_limits() },
            |_, _, error| {
                if error.is_some() {
                    failures.set(failures.get() + 1);
                }
                Result::Ok(fs::WalkControl::Continue)
            },
        );
        if max_work == 3 {
            testing::assert(result.is_err());
            assert_equal(failures.get(), 1);
            assert_equal(
                source.events,
                Vec::from_array(["open:.", "stat:.", "close:.", "open:.", "close:."]),
            );
        } else {
            testing::expect_ok(result, "exact empty directory probe work");
            assert_equal(failures.get(), 0);
            assert_equal(
                source.events,
                Vec::from_array(["open:.", "stat:.", "close:.", "open:.", "read:.:1", "close:."]),
            );
        }
        assert_equal(source.active.get(), 0);
    }
}

fn check_walk_probe_cleanup_and_sub() -> () {
    for mode in 0..3 {
        let source = walk_probe_fs(
            Vec::from_array(
                [
                    WalkProbeNode {
                        read_panic: mode != 2,
                        close_mode: if mode == 1 {
                            2
                        } else {
                            0
                        },
                        ..walk_probe_node(".", Vec::new()),
                    },
                ],
            ),
        );
        let caught = testing::expect_err(
            panic::catch(
                || fs::walk_from(
                    source,
                    ".",
                    walk_probe_limits(),
                    |_, _, _| {
                        if mode == 2 {
                            panic::raise("walk callback panic")
                        }
                        Result::Ok(fs::WalkControl::Continue)
                    },
                ),
            ),
            "walk panic cleanup",
        );
        assert_equal(
            caught.message(),
            match mode {
                0 => "walk read panic",
                1 => "walk close panic",
                _ => "walk callback panic",
            },
        );
        assert_equal(source.active.get(), 0);
    }
    let source = walk_probe_fs(
        Vec::from_array(
            [
                walk_probe_node(
                    "outer/inner",
                    Vec::from_array([walk_probe_entry("file", fs::FileType::File, 0)]),
                ),
            ],
        ),
    );
    let outer = testing::expect_ok(fs::SubFs::new(source, "outer"), "walk outer namespace");
    let inner = testing::expect_ok(fs::SubFs::new(outer, "inner"), "walk inner namespace");
    let visited = Vec::new();
    testing::expect_ok(
        fs::walk_from(
            inner,
            ".",
            walk_probe_limits(),
            |path, _, error| {
                testing::assert(error.is_none());
                visited.push(path);
                Result::Ok(fs::WalkControl::Continue)
            },
        ),
        "walk nested namespace",
    );
    assert_equal(visited, Vec::from_array([".", "file"]));
    assert_equal(source.events[0], "open:outer/inner");
    assert_equal(source.events[3], "open:outer/inner");
    assert_equal(source.active.get(), 0);
}

fn check_walk_probe_deep_chain() -> () {
    let depth = 1024;
    let nodes = Vec::new();
    let expected = Vec::new();
    let mut path = ".";
    for index in 0..depth + 1 {
        expected.push(path);
        nodes.push(
            walk_probe_node(
                path,
                if index == depth {
                    Vec::new()
                } else {
                    Vec::from_array([walk_probe_entry("d", fs::FileType::Directory, index)])
                },
            ),
        );
        path = if path == "." {
            "d"
        } else {
            path + "/d"
        };
    }
    let source = walk_probe_fs(nodes);
    let visited = Vec::new();
    let limits = fs::WalkLimits {
        max_depth: depth + 1,
        max_directories: depth + 1,
        max_directory_entries: 1,
        max_work: 10000,
    };
    testing::expect_ok(
        fs::walk_from(
            source,
            ".",
            limits,
            |path, _, error| {
                testing::assert(error.is_none());
                assert_equal(source.active.get(), 0);
                visited.push(path);
                Result::Ok(fs::WalkControl::Continue)
            },
        ),
        "deep walk completes without retaining open directories",
    );
    assert_equal(visited, expected);
    assert_equal(source.active.get(), 0);
}

fn check_walk_probe_roots_and_extremes() -> () {
    for kind in[fs::FileType::File, fs::FileType::Symlink, fs::FileType::Other] {
        for control in[
            fs::WalkControl::Continue,
            fs::WalkControl::SkipDir,
            fs::WalkControl::SkipAll,
        ] {
            let source = walk_probe_fs(
                Vec::from_array(
                    [WalkProbeNode { kind, ..walk_probe_node("folder/root", Vec::new()) }],
                ),
            );
            let calls = Ref::new(0);
            testing::expect_ok(
                fs::walk_from(
                    source,
                    "folder/root",
                    fs::WalkLimits {
                        max_depth: 0,
                        max_directory_entries: 0,
                        max_directories: 0,
                        max_work: 1,
                    },
                    |path, entry, error| {
                        testing::assert(error.is_none());
                        assert_equal(path, "folder/root");
                        let entry = testing::expect_some(entry, "non-directory root");
                        assert_equal(entry.name(), "root");
                        assert_equal(entry.file_type(), kind);
                        calls.set(calls.get() + 1);
                        Result::Ok(control)
                    },
                ),
                "non-directory root requires no directory budget",
            );
            assert_equal(calls.get(), 1);
            assert_equal(
                source.events,
                Vec::from_array(["open:folder/root", "stat:folder/root", "close:folder/root"]),
            );
        }
    }
    for path in["", "/", "/a", "..", "a/", "a//b", "a/../b", "./a"] {
        let source = walk_probe_tree();
        let error = testing::expect_err(
            fs::walk_from(
                source,
                path,
                walk_probe_limits(),
                |_, _, _| panic::raise("invalid root invoked callback"),
            ),
            "invalid walk root",
        );
        assert_equal(error.kind(), io::ErrorKind::InvalidInput);
        assert_equal(error.path(), Option::Some(path));
        assert_equal(source.events.len(), 0);
    }
    let source = walk_probe_tree();
    let minimum = -9223372036854775807 - 1;
    let error = testing::expect_err(
        fs::walk_from(
            source,
            ".",
            fs::WalkLimits { max_work: minimum, ..walk_probe_limits() },
            |_, _, _| panic::raise("minimum work invoked callback"),
        ),
        "minimum work rejected",
    );
    assert_equal(error.kind(), io::ErrorKind::InvalidInput);
    assert_equal(source.events.len(), 0);
    for control in[fs::WalkControl::Continue, fs::WalkControl::SkipDir, fs::WalkControl::SkipAll] {
        let source = walk_probe_tree();
        let calls = Ref::new(0);
        let result = fs::walk_from(
            source,
            ".",
            fs::WalkLimits { max_work: 0, ..walk_probe_limits() },
            |path, entry, error| {
                assert_equal(path, ".");
                testing::assert(entry.is_none());
                testing::assert(error.is_some());
                calls.set(calls.get() + 1);
                Result::Ok(control)
            },
        );
        match control {
            SkipAll => testing::expect_ok(result, "zero work SkipAll"),
            _ => testing::assert(result.is_err()),
        }
        assert_equal(calls.get(), 1);
        assert_equal(source.events.len(), 0);
    }
    let maximum = 9223372036854775807;
    let source = walk_probe_fs(Vec::from_array([walk_probe_node(".", Vec::new())]));
    testing::expect_ok(
        fs::walk_from(
            source,
            ".",
            fs::WalkLimits {
                max_depth: maximum,
                max_directory_entries: maximum,
                max_directories: maximum,
                max_work: maximum,
            },
            |_, _, error| {
                testing::assert(error.is_none());
                Result::Ok(fs::WalkControl::Continue)
            },
        ),
        "maximum limits do not overflow",
    );
    assert_equal(
        source.events,
        Vec::from_array(["open:.", "stat:.", "close:.", "open:.", "read:.:128", "close:."]),
    );
}

fn check_walk_probe_entry_limits() -> () {
    for limit in[0, 1] {
        for count in 0..3 {
            let entries = Vec::new();
            for index in 0..count {
                entries.push(walk_probe_entry(index.to_string(), fs::FileType::File, index));
            }
            let source = walk_probe_fs(Vec::from_array([walk_probe_node(".", entries)]));
            let visited = Vec::new();
            let failures = Ref::new(0);
            let result = fs::walk_from(
                source,
                ".",
                fs::WalkLimits { max_directory_entries: limit, ..walk_probe_limits() },
                |path, _, error| {
                    if let Some(cause) = error {
                        assert_equal(path, ".");
                        assert_equal(cause.kind(), io::ErrorKind::InvalidData);
                        failures.set(failures.get() + 1);
                    } else {
                        visited.push(path);
                    }
                    Result::Ok(fs::WalkControl::Continue)
                },
            );
            if count > limit {
                testing::assert(result.is_err());
                assert_equal(failures.get(), 1);
                assert_equal(visited, Vec::from_array(["."]));
            } else {
                testing::expect_ok(result, "directory entry exact limit");
                assert_equal(failures.get(), 0);
                assert_equal(
                    visited,
                    if count == 0 {
                        Vec::from_array(["."])
                    } else {
                        Vec::from_array([".", "0"])
                    },
                );
            }
            assert_equal(source.active.get(), 0);
        }
    }
}

fn check_walk_probe_child_error_continuation() -> () {
    for mode in 0..3 {
        let tree = walk_probe_tree();
        let child = WalkProbeNode {
            open_error: mode == 0,
            error_on: if mode == 1 {
                1
            } else {
                -1
            },
            close_mode: if mode == 2 {
                1
            } else {
                0
            },
            ..tree.nodes[1],
        };
        let source = walk_probe_fs(Vec::from_array([tree.nodes[0], child]));
        let visited = Vec::new();
        let failures = Ref::new(0);
        testing::expect_ok(
            fs::walk_from(
                source,
                ".",
                walk_probe_limits(),
                |path, entry, error| {
                    assert_equal(source.active.get(), 0);
                    testing::assert(entry.is_some());
                    if let Some(cause) = error {
                        assert_equal(path, "a");
                        failures.set(failures.get() + 1);
                        visited.push("error:a");
                        if mode == 2 {
                            assert_equal(cause.kind(), io::ErrorKind::BrokenPipe);
                            assert_equal(cause.operation(), "close file");
                            assert_equal(cause.path(), Option::Some("a"));
                        } else {
                            assert_equal(
                                cause,
                                walk_probe_error(
                                    if mode == 0 {
                                        "open"
                                    } else {
                                        "read directory"
                                    },
                                ),
                            );
                        }
                    } else {
                        visited.push(path);
                    }
                    Result::Ok(fs::WalkControl::Continue)
                },
            ),
            "child failure continues remaining parent siblings",
        );
        assert_equal(failures.get(), 1);
        assert_equal(
            visited,
            if mode == 0 {
                Vec::from_array([".", "a", "error:a", "m", "z"])
            } else {
                Vec::from_array([".", "a", "error:a", "a/b", "a/q", "m", "z"])
            },
        );
        assert_equal(source.active.get(), 0);
    }
}

fn check_fs_walk() -> () {
    check_walk_probe_order_and_controls();
    check_walk_probe_errors();
    check_walk_probe_stable_entries();
    check_walk_probe_limits();
    check_walk_probe_cleanup_and_sub();
    check_walk_probe_deep_chain();
    check_walk_probe_roots_and_extremes();
    check_walk_probe_entry_limits();
    check_walk_probe_child_error_continuation();
}
