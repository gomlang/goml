package main;

use std::bytes;
use std::io;
use io::{Read, BufRead};
use std::testing;

fn check_io_buffer_composition() -> () {
    for capacity in 1..6 {
        for skipped in 0..9 {
            let source = io::StringReader::new("abcdefgh");
            let reader = testing::expect_ok(
                io::BufReader::with_capacity(source, capacity),
                "composition reader",
            );
            let alias = reader;
            let preview = bytes::Bytes::from_slice_copy(
                testing::expect_ok(reader.peek(capacity), "composition peek"),
            );
            assert_equal(source.position(), capacity);
            assert_equal(testing::expect_ok(alias.discard(skipped), "composition discard"), skipped);
            let destination = io::Cursor::new(bytes::Bytes::new());
            assert_equal(
                testing::expect_ok(io::copy_progress(reader, destination), "composition copy"),
                (8 - skipped).to_u64(),
            );
            assert_equal(
                destination.bytes().to_vec(),
                b"abcdefgh".as_slice().sub(skipped, 8).to_vec(),
            );
            assert_equal(preview.to_vec(), b"abcdefgh".as_slice().sub(0, capacity).to_vec());
            assert_equal(source.position(), 8);
            assert_equal(reader.buffered_len(), 0);
            assert_equal(testing::expect_ok(reader.peek(0), "composition empty peek").len(), 0);
        }
    }
    let reader = testing::expect_ok(
        io::BufReader::with_capacity(io::StringReader::new("a\nb"), 4),
        "line peek reader",
    );
    let error = testing::expect_err(reader.peek(4), "short line peek");
    let snapshot = bytes::Bytes::from_slice_copy(error.available());
    assert_equal(error.error().kind(), io::ErrorKind::UnexpectedEof);
    assert_equal(testing::expect_ok(reader.read_line(3), "line after peek"), Option::Some("a\n"));
    assert_equal(testing::expect_ok(reader.read_to_string(1), "tail after peek"), "b");
    assert_equal(snapshot.to_vec(), b"a\nb");
}
