package main;

use std::io;
use std::io::{Read, Write};
use std::bytes;
use std::testing;

struct MultiProbe {
    result: Ref[Result[isize, io::Error]],
    flush_result: Ref[Result[(), io::Error]],
    events: Vec[isize],
    id: isize,
}

impl Read for MultiProbe {
    fn read(self: MultiProbe, buffer: MutSlice[byte]) -> Result[isize, io::Error] {
        self.events.push(self.id);
        self.result.get()
    }
}

impl Write for MultiProbe {
    fn write(self: MultiProbe, buffer: Slice[byte]) -> Result[isize, io::Error] {
        self.events.push(self.id);
        self.result.get()
    }

    fn flush(self: MultiProbe) -> Result[(), io::Error] {
        self.events.push(-self.id);
        self.flush_result.get()
    }
}

fn multi_probe(events: Vec[isize], id: isize, count: isize) -> MultiProbe {
    MultiProbe {
        result: Ref::new(Result::Ok(count)),
        flush_result: Ref::new(Result::Ok(())),
        events,
        id,
    }
}

fn check_io_multi() -> () {
    for width in 1..8 {
        let readers = Vec::new();
        for input in[b"", b"ab", b"", b"cdef", b""] {
            readers.push(io::Cursor::new(bytes::Bytes::from_vec(input)));
        }
        let reader = io::MultiReader::new(readers.as_slice());
        readers[1] = io::Cursor::new(bytes::Bytes::from_vec(b"wrong"));
        let output = Vec::new();
        let buffer = Vec::new();
        for _ in 0..width {
            buffer.push(0.to_u8());
        }
        loop {
            let count = testing::expect_ok(reader.read(buffer.as_mut_slice()), "multi read");
            if count == 0 {
                break
            }
            for index in 0..count {
                output.push(buffer[index]);
            }
        }
        assert_equal(output, b"abcdef");
        assert_equal(
            testing::expect_ok(reader.read(buffer.as_mut_slice()), "exhausted multi read"),
            0,
        );
    }
    let first = io::Cursor::new(bytes::Bytes::new());
    let second = io::Cursor::new(bytes::Bytes::new());
    let writers = Vec::from_array([first, second]);
    let writer = io::MultiWriter::new(writers.as_slice());
    writers[0] = io::Cursor::new(bytes::Bytes::new());
    testing::expect_ok(writer.write_all(b"abc".as_slice()), "broadcast");
    testing::expect_ok(writer.flush(), "broadcast flush");
    assert_equal(first.bytes().to_vec(), b"abc");
    assert_equal(second.bytes().to_vec(), b"abc");
    let duplicate = io::MultiWriter::new(Vec::from_array([first, first]).as_slice());
    testing::expect_ok(duplicate.write_all(b"!".as_slice()), "duplicate destination");
    assert_equal(first.bytes().to_vec(), b"abc!!");
    let nested = io::MultiWriter::new(Vec::from_array([writer]).as_slice());
    testing::expect_ok(nested.write_all(b"?".as_slice()), "nested broadcast");
    assert_equal(second.bytes().to_vec(), b"abc?");
    let empty_writers: Vec[io::Cursor] = Vec::new();
    assert_equal(
        testing::expect_ok(
            io::MultiWriter::new(empty_writers.as_slice()).write(b"abc".as_slice()),
            "empty broadcast",
        ),
        3,
    );
    let buffer = b"???";
    assert_equal(
        testing::expect_ok(
            io::MultiReader::new(empty_writers.as_slice()).read(buffer.as_mut_slice()),
            "empty reader",
        ),
        0,
    );
    check_multi_failures();
}

fn check_multi_failures() -> () {
    let failure = io::Error::new(
        io::ErrorKind::Interrupted,
        "multi probe",
        Option::None,
        Option::None,
        "stop",
    );
    let output = b"abc";
    let empty: Vec[byte] = Vec::new();
    for count in[-1, 0, 2, 4] {
        let events = Vec::new();
        let first = multi_probe(events, 1, 3);
        let second = multi_probe(events, 2, count);
        let third = multi_probe(events, 3, 3);
        let writer = io::MultiWriter::new(Vec::from_array([first, second, third]).as_slice());
        testing::assert(writer.write_all(output.as_slice()).is_err());
        assert_equal(events, Vec::from_array([1, 2]));
    }
    let events = Vec::new();
    let first = multi_probe(events, 1, 3);
    let second = multi_probe(events, 2, 3);
    let third = multi_probe(events, 3, 3);
    second.result.set(Result::Err(failure));
    let writer = io::MultiWriter::new(Vec::from_array([first, second, third]).as_slice());
    match writer.write_all(output.as_slice()) {
        Err(error) => assert_equal(error, failure),
        Ok(_) => testing::assert(false),
    }
    assert_equal(events, Vec::from_array([1, 2]));
    second.flush_result.set(Result::Err(failure));
    testing::assert(writer.flush().is_err());
    assert_equal(events, Vec::from_array([1, 2, -1, -2]));
    let read_events = Vec::new();
    let r1 = multi_probe(read_events, 1, 0);
    let r2 = multi_probe(read_events, 2, -1);
    let r3 = multi_probe(read_events, 3, 3);
    let reader = io::MultiReader::new(Vec::from_array([r1, r2, r3]).as_slice());
    let alias = reader;
    testing::expect_ok(reader.read(empty.as_mut_slice()), "empty read does not advance");
    assert_equal(read_events.len(), 0);
    testing::assert(reader.read(output.as_mut_slice()).is_err());
    assert_equal(read_events, Vec::from_array([1, 2]));
    r2.result.set(Result::Err(failure));
    testing::assert(alias.read(output.as_mut_slice()).is_err());
    assert_equal(read_events, Vec::from_array([1, 2, 2]));
    r2.result.set(Result::Ok(0));
    assert_equal(testing::expect_ok(reader.read(output.as_mut_slice()), "resume reader"), 3);
    assert_equal(read_events, Vec::from_array([1, 2, 2, 2, 3]));
    r3.result.set(Result::Ok(0));
    testing::expect_ok(reader.read(output.as_mut_slice()), "finish readers");
    let calls = read_events.len();
    testing::expect_ok(alias.read(output.as_mut_slice()), "shared exhaustion");
    assert_equal(read_events.len(), calls);
}
