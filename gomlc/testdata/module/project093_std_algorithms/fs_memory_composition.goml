package main;

use std::bytes;
use std::fs;
use fs::DirectoryEntry;
use std::io;
use std::testing;
use std::testing::fs as memory;

fn memory_composition_fs() -> memory::MemoryFS {
    testing::expect_ok(
        memory::MemoryFS::new(
            Vec::from_array(
                [
                    memory::MemoryNode::file("mount/tree/z.txt", bytes::Bytes::from_string("zeta")),
                    memory::MemoryNode::file(
                        "mount/tree/d/b.txt",
                        bytes::Bytes::from_string("beta"),
                    ),
                    memory::MemoryNode::link("mount/tree/alias", "d"),
                    memory::MemoryNode::link("mount/tree/filelink", "a.txt"),
                    memory::MemoryNode::file("mount/tree/a.txt", bytes::Bytes::from_string("alpha")),
                ],
            ),
            memory::MemoryLimits {
                max_nodes: 100,
                max_data_bytes: 100,
                max_path_bytes: 1000,
                max_depth: 20,
                max_link_hops: 20,
                max_resolve_work: 10000,
            },
        ),
        "memory composition tree",
    )
}

fn memory_composition_walk_limits() -> fs::WalkLimits {
    fs::WalkLimits {
        max_depth: 20,
        max_directory_entries: 100,
        max_directories: 100,
        max_work: 10000,
    }
}

fn memory_composition_glob_limits() -> fs::GlobLimits {
    fs::GlobLimits {
        max_pattern_chars: 100,
        max_components: 20,
        max_directory_entries: 100,
        max_directories: 100,
        max_match_calls: 100,
        max_matches: 100,
        max_work: 10000,
    }
}

fn memory_composition_names[E: fs::DirectoryEntry](entries: Slice[E]) -> Vec[string] {
    let names = Vec::new();
    for entry in entries {
        names.push(entry.name());
    }
    names
}

fn check_memory_composition_directory_and_sub() -> () {
    let source = memory_composition_fs();
    let outer = testing::expect_ok(fs::SubFs::new(source, "mount"), "memory outer subfs");
    let inner = testing::expect_ok(fs::SubFs::new(outer, "tree"), "memory inner subfs");
    let expected = Vec::from_array(["a.txt", "alias", "d", "filelink", "z.txt"]);
    let direct = testing::expect_ok(
        fs::read_dir_from(source, "mount/tree", 5),
        "memory directory helper",
    );
    assert_equal(memory_composition_names(direct.as_slice()), expected);
    let entries = testing::expect_ok(
        fs::read_dir_from(inner, ".", 5),
        "nested memory directory helper",
    );
    assert_equal(memory_composition_names(entries.as_slice()), expected);
    assert_equal(entries[1].file_type(), fs::FileType::Symlink);
    assert_equal(
        testing::expect_ok(entries[1].metadata(), "symlink directory snapshot").file_type(),
        fs::FileType::Symlink,
    );
    assert_equal(
        testing::expect_ok(fs::stat_from(inner, "alias"), "stat follows directory alias").file_type(),
        fs::FileType::Directory,
    );
    assert_equal(
        testing::expect_ok(
            fs::read_file_from(inner, "filelink", 5),
            "read helper follows file link",
        ).to_vec(),
        b"alpha",
    );
    assert_equal(
        testing::expect_ok(
            fs::read_file_from(inner, "alias/b.txt", 4),
            "read helper through directory link",
        ).to_vec(),
        b"beta",
    );
    let error = testing::expect_err(
        fs::read_dir_from(inner, ".", 3),
        "bounded memory directory prefix",
    );
    assert_equal(error.error().kind(), io::ErrorKind::InvalidData);
    assert_equal(error.error().path(), Option::Some("."));
    assert_equal(
        memory_composition_names(error.entries()),
        Vec::from_array(["a.txt", "alias", "d"]),
    );
    assert_equal(
        testing::expect_ok(error.entries()[0].metadata(), "partial snapshot remains usable").len(),
        5,
    );
    assert_equal(
        memory_composition_names(
            testing::expect_ok(
                fs::read_dir_from(inner, ".", 5),
                "fresh helper open after limited listing",
            ).as_slice(),
        ),
        expected,
    );
}

fn check_memory_composition_walk() -> () {
    let source = memory_composition_fs();
    let direct = Vec::new();
    testing::expect_ok(
        fs::walk_from(
            source,
            "mount/tree",
            memory_composition_walk_limits(),
            |path, entry, error| {
                testing::assert(error.is_none());
                testing::assert(entry.is_some());
                direct.push(path);
                Result::Ok(fs::WalkControl::Continue)
            },
        ),
        "walk memory filesystem directly",
    );
    assert_equal(
        direct,
        Vec::from_array(
            [
                "mount/tree",
                "mount/tree/a.txt",
                "mount/tree/alias",
                "mount/tree/d",
                "mount/tree/d/b.txt",
                "mount/tree/filelink",
                "mount/tree/z.txt",
            ],
        ),
    );
    let outer = testing::expect_ok(fs::SubFs::new(source, "mount"), "walk outer subfs");
    let inner = testing::expect_ok(fs::SubFs::new(outer, "tree"), "walk inner subfs");
    let visited = Vec::new();
    testing::expect_ok(
        fs::walk_from(
            inner,
            ".",
            memory_composition_walk_limits(),
            |path, entry, error| {
                testing::assert(error.is_none());
                let entry = testing::expect_some(entry, "memory walk entry");
                if path == "alias" || path == "filelink" {
                    assert_equal(entry.file_type(), fs::FileType::Symlink);
                    assert_equal(
                        testing::expect_ok(entry.metadata(), "walk link snapshot").file_type(),
                        fs::FileType::Symlink,
                    );
                }
                visited.push(path);
                Result::Ok(fs::WalkControl::Continue)
            },
        ),
        "walk nested memory namespace",
    );
    assert_equal(
        visited,
        Vec::from_array([".", "a.txt", "alias", "d", "d/b.txt", "filelink", "z.txt"]),
    );
    let visited = Vec::new();
    let failures = Vec::new();
    let error = testing::expect_err(
        fs::walk_from(
            inner,
            ".",
            fs::WalkLimits { max_directories: 1, ..memory_composition_walk_limits() },
            |path, _, error| {
                if let Some(cause) = error {
                    assert_equal(path, "d");
                    failures.push(cause);
                } else {
                    visited.push(path);
                }
                Result::Ok(fs::WalkControl::Continue)
            },
        ),
        "memory walk global directory limit",
    );
    assert_equal(error.kind(), io::ErrorKind::InvalidData);
    assert_equal(error.operation(), "walk");
    assert_equal(failures.len(), 1);
    assert_equal(error, failures[0]);
    assert_equal(visited, Vec::from_array([".", "a.txt", "alias", "d"]));
    let alias_root = Vec::new();
    testing::expect_ok(
        fs::walk_from(
            inner,
            "alias",
            memory_composition_walk_limits(),
            |path, _, error| {
                testing::assert(error.is_none());
                alias_root.push(path);
                Result::Ok(fs::WalkControl::Continue)
            },
        ),
        "explicit walk root follows provider stat semantics",
    );
    assert_equal(alias_root, Vec::from_array(["alias", "alias/b.txt"]));
}

fn check_memory_composition_glob() -> () {
    let source = memory_composition_fs();
    assert_equal(
        testing::expect_ok(
            fs::glob_from(source, "mount/tree/[ad]*/*.txt", memory_composition_glob_limits()),
            "glob memory directory links",
        ),
        Vec::from_array(["mount/tree/alias/b.txt", "mount/tree/d/b.txt"]),
    );
    let outer = testing::expect_ok(fs::SubFs::new(source, "mount"), "glob outer memory namespace");
    let inner = testing::expect_ok(fs::SubFs::new(outer, "tree"), "glob inner memory namespace");
    assert_equal(
        testing::expect_ok(
            fs::glob_from(inner, "[ad]*/*.txt", memory_composition_glob_limits()),
            "glob follows intermediate memory symlink",
        ),
        Vec::from_array(["alias/b.txt", "d/b.txt"]),
    );
    assert_equal(
        testing::expect_ok(
            fs::glob_from(inner, "*.txt", memory_composition_glob_limits()),
            "glob final memory names",
        ),
        Vec::from_array(["a.txt", "z.txt"]),
    );
    assert_equal(
        testing::expect_ok(
            fs::glob_from(inner, "alias/b.txt", memory_composition_glob_limits()),
            "literal glob follows memory alias",
        ),
        Vec::from_array(["alias/b.txt"]),
    );
    for limited in[
        fs::GlobLimits { max_matches: 1, ..memory_composition_glob_limits() },
        fs::GlobLimits { max_directories: 2, ..memory_composition_glob_limits() },
    ] {
        let error = testing::expect_err(
            fs::glob_from(inner, "[ad]*/*.txt", limited),
            "memory glob preserves matches before limit",
        );
        assert_equal(error.matches().to_vec(), Vec::from_array(["alias/b.txt"]));
        match error.cause() {
            FileSystem(cause) => {
                assert_equal(cause.kind(), io::ErrorKind::InvalidData);
                assert_equal(cause.operation(), "glob");
            },
            _ => testing::fail("expected memory glob hard limit"),
        }
    }
    assert_equal(
        testing::expect_ok(
            fs::glob_from(inner, "[ad]*/*.txt", memory_composition_glob_limits()),
            "memory glob restarts with independent handles",
        ),
        Vec::from_array(["alias/b.txt", "d/b.txt"]),
    );
    let error = testing::expect_err(
        fs::glob_from(inner, "*/*.txt", memory_composition_glob_limits()),
        "glob surfaces directory read failure through file symlink",
    );
    assert_equal(error.matches().to_vec(), Vec::from_array(["alias/b.txt", "d/b.txt"]));
    match error.cause() {
        FileSystem(cause) => {
            assert_equal(cause.kind(), io::ErrorKind::InvalidInput);
            assert_equal(cause.path(), Option::Some("mount/tree/filelink"));
        },
        _ => testing::fail("expected original memory file-link cause"),
    }
}

pub fn test_fs_memory_composition() -> () {
    check_memory_composition_directory_and_sub();
    check_memory_composition_walk();
    check_memory_composition_glob();
}
