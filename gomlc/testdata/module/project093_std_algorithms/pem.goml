package main;

use std::bytes;
use std::encoding::pem;
use std::ffi;
use std::rand;
use std::testing;

#[go_ffi("example.com/goml-std-algorithms/native", "EncodePEM")]
extern fn go_encode_pem(
    label: string,
    keys: Slice[string],
    values: Slice[string],
    data: Slice[byte],
) -> string;

#[go_ffi("example.com/goml-std-algorithms/native", "DecodePEM")]
extern fn go_decode_pem(input: string) -> (string, ffi::RawSlice[byte], isize, bool);

fn pem_block(label: string, headers: Vec[(string, string)], data: Vec[byte]) -> pem::Block {
    testing::expect_ok(pem::Block::new(label, headers, bytes::Bytes::from_vec(data)), "PEM block")
}

fn check_pem() -> () {
    check_pem_header_boundaries();
    let keys = Vec::from_array(["Zeta", "Proc-Type", "Alpha"]);
    let values = Vec::from_array(["z", "4,ENCRYPTED", "a"]);
    let headers = Vec::from_array([("Zeta", "z"), ("Proc-Type", "4,ENCRYPTED"), ("Alpha", "a")]);
    for length in 0..193 {
        let data = rand::bytes(length.to_u64(), length);
        for with_headers in[false, true] {
            let selected = if with_headers {
                headers
            } else {
                Vec::new()
            };
            let block = pem_block("TEST DATA", selected, data);
            let encoded = testing::expect_ok(pem::encode(block, 4096), "PEM encode");
            let expected = if with_headers {
                go_encode_pem("TEST DATA", keys.as_slice(), values.as_slice(), data.as_slice())
            } else {
                let empty: Vec[string] = Vec::new();
                go_encode_pem("TEST DATA", empty.as_slice(), empty.as_slice(), data.as_slice())
            };
            assert_equal(encoded, expected);
            assert_equal(
                testing::expect_ok(pem::encode(block, encoded.byte_len()), "exact encoding limit"),
                encoded,
            );
            testing::assert(pem::encode(block, encoded.byte_len() - 1).is_err());
            for input in Vec::from_array(
                [
                    encoded,
                    "preamble\n" + encoded + "tail",
                    encoded.replace("\n", "\r\n"),
                    encoded.replace("\n", " \t\n"),
                    encoded.byte_slice(0, encoded.byte_len() - 1),
                ],
            ) {
                let (decoded, end) = testing::expect_some(
                    testing::expect_ok(
                        pem::decode(input, input.byte_len(), length, 3),
                        "PEM decode",
                    ),
                    "PEM found",
                );
                let (go_label, go_data, go_end, found) = go_decode_pem(input);
                testing::assert(found);
                assert_equal(decoded.label(), go_label);
                assert_equal(decoded.data().to_vec(), go_data.as_slice().to_vec());
                assert_equal(decoded.data().to_vec(), data);
                assert_equal(end, go_end);
                assert_equal(
                    testing::expect_ok(pem::encode(decoded, 4096), "canonical PEM"),
                    encoded,
                );
            }
            if length > 0 {
                testing::assert(pem::decode(encoded, 4096, length - 1, 3).is_err());
            }
            if with_headers {
                testing::assert(pem::decode(encoded, 4096, length, 2).is_err());
            }
            testing::assert(pem::decode(encoded, encoded.byte_len() - 1, length, 3).is_err());
        }
    }
    for label in Vec::from_array(["", " A", "A ", "A\nB", "你"]) {
        testing::assert(pem::Block::new(label, Vec::new(), bytes::Bytes::new()).is_err());
    }
    for header in Vec::from_array([("", "x"), ("A:B", "x"), ("A B", "x"), ("A", "x\ny")]) {
        testing::assert(
            pem::Block::new("T", Vec::from_array([header]), bytes::Bytes::new()).is_err(),
        );
    }
    testing::assert(
        pem::Block::new("T", Vec::from_array([("A", "1"), ("A", "2")]), bytes::Bytes::new()).is_err(),
    );
    for input in Vec::from_array(
        [
            "-----BEGIN T-----\n",
            "-----BEGIN T-----\n-----END X-----\n",
            "-----BEGIN T-----\n@@@\n-----END T-----\n",
            "-----BEGIN T-----\nZh==\n-----END T-----\n",
            "-----BEGIN T-----\nA: 1\nA: 2\n\n-----END T-----\n",
        ],
    ) {
        testing::assert(pem::decode(input, 4096, 4096, 10).is_err());
    }
    testing::assert(testing::expect_ok(pem::decode("not PEM", 7, 0, 0), "no PEM").is_none());
    testing::assert(pem::decode("", -1, 0, 0).is_err());
    let data = b"abc";
    let source_headers = Vec::from_array([("A", " value ")]);
    let block = pem_block("T", source_headers, data);
    data[0] = b'!';
    source_headers[0] = ("B", "changed");
    let snapshot = block.data();
    snapshot.set(0, b'?');
    assert_equal(block.data().to_vec(), b"abc");
    assert_equal(block.headers(), Vec::from_array([("A", "value")]));
    let header_snapshot = block.headers();
    header_snapshot[0] = ("C", "changed");
    assert_equal(block.headers(), Vec::from_array([("A", "value")]));
    let encoded = testing::expect_ok(pem::encode(block, 4096), "multiple blocks");
    let joined = encoded + encoded;
    let (_, offset) = testing::expect_some(
        testing::expect_ok(pem::decode(joined, 8192, 3, 1), "first block"),
        "first found",
    );
    assert_equal(offset, encoded.byte_len());
    let (next, _) = testing::expect_some(
        testing::expect_ok(
            pem::decode(joined.byte_slice(offset, joined.byte_len()), 4096, 3, 1),
            "second block",
        ),
        "second found",
    );
    assert_equal(next.data().to_vec(), b"abc");
    testing::assert(pem::encode(block, -1).is_err());
}

fn check_pem_header_boundaries() -> () {
    for whitespace in[" ", "　", " "] {
        for header in[
            whitespace + "A: value",
            "A" + whitespace + ": value",
            "A: " + whitespace + "value",
            "A: value" + whitespace,
        ] {
            let input = "-----BEGIN T-----\n" + header + "\n\n-----END T-----\n";
            match pem::decode(input, input.byte_len(), 0, 1) {
                Err(pem::Error::InvalidHeader) => (),
                _ => testing::fail("non-ASCII PEM header accepted"),
            }
        }
    }
    let input = "-----BEGIN T-----\n \tA\t : \t value\t \n\n-----END T-----\n";
    let (block, offset) = testing::expect_some(
        testing::expect_ok(pem::decode(input, input.byte_len(), 0, 1), "ASCII header whitespace"),
        "block",
    );
    assert_equal(offset, input.byte_len());
    assert_equal(block.headers(), Vec::from_array([("A", "value")]));
    for limits in[(-1, 0, 0), (0, -1, 0), (0, 0, -1)] {
        match pem::decode("", limits.0, limits.1, limits.2) {
            Err(pem::Error::InvalidLimit) => (),
            _ => testing::fail("negative PEM limit accepted"),
        }
    }
    for body in["=", "==", "===", "A===", "AAAA=", "AA==AA==", "Zg==!", "Zg", "Zg=", "Zh=="] {
        let input = "-----BEGIN T-----\n" + body + "\n-----END T-----\n";
        testing::assert(pem::decode(input, input.byte_len(), 100, 0).is_err());
    }
    let empty = pem_block("T", Vec::new(), Vec::new());
    let encoded = testing::expect_ok(pem::encode(empty, 34), "empty exact envelope");
    assert_equal(encoded.byte_len(), 34);
    testing::assert(pem::encode(empty, 33).is_err());
    let malformed = "-----BEGIN T-----\n@@@@\n-----END T-----\n";
    let joined = malformed + encoded;
    testing::assert(pem::decode(joined, joined.byte_len(), 100, 0).is_err());
    let (_, _, offset, found) = go_decode_pem(joined);
    testing::assert(found);
    assert_equal(offset, joined.byte_len());
}
