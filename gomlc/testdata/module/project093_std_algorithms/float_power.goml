package main;

use std::num;
use std::testing;

fn check_float_power64(value: f64) -> () {
    let binary = go_format_float(value, b'b', 0, 64);
    testing::assert_eq(
        testing::expect_ok(num::format_float64_binary(value, binary.byte_len()), "binary64"),
        binary,
    );
    testing::assert(num::format_float64_binary(value, binary.byte_len() - 1).is_err());
    for precision in[-1, 0, 1, 6, 12, 13, 16] {
        for uppercase in[false, true] {
            let expected = go_format_float(
                value,
                if uppercase {
                    b'X'
                } else {
                    b'x'
                },
                precision,
                64,
            );
            testing::assert_eq(
                testing::expect_ok(
                    num::format_float64_hex(value, precision, uppercase, expected.byte_len()),
                    "hex64",
                ),
                expected,
            );
            testing::assert(
                num::format_float64_hex(value, precision, uppercase, expected.byte_len() - 1).is_err(),
            );
        }
    }
}

fn check_float_power32(value: f32) -> () {
    let binary = go_format_float(float32_to_float64(value), b'b', 0, 32);
    testing::assert_eq(
        testing::expect_ok(num::format_float32_binary(value, binary.byte_len()), "binary32"),
        binary,
    );
    testing::assert(num::format_float32_binary(value, binary.byte_len() - 1).is_err());
    for precision in[-1, 0, 1, 5, 6, 7, 16] {
        for uppercase in[false, true] {
            let expected = go_format_float(
                float32_to_float64(value),
                if uppercase {
                    b'X'
                } else {
                    b'x'
                },
                precision,
                32,
            );
            testing::assert_eq(
                testing::expect_ok(
                    num::format_float32_hex(value, precision, uppercase, expected.byte_len()),
                    "hex32",
                ),
                expected,
            );
            testing::assert(
                num::format_float32_hex(value, precision, uppercase, expected.byte_len() - 1).is_err(),
            );
        }
    }
}

fn check_float_power() -> () {
    for exponent in 0..2048 {
        for fraction in[
            0.to_u64(),
            1.to_u64(),
            2251799813685248.to_u64(),
            4503599627370495.to_u64(),
        ] {
            for sign in[0.to_u64(), 1.to_u64() << 63] {
                check_float_power64(float64_from_bits((exponent.to_u64() << 52) | fraction | sign));
            }
        }
    }
    for exponent in 0..256 {
        for fraction in[0.to_u32(), 1.to_u32(), 4194304.to_u32(), 8388607.to_u32()] {
            for sign in[0.to_u32(), 1.to_u32() << 31] {
                check_float_power32(float32_from_bits((exponent.to_u32() << 23) | fraction | sign));
            }
        }
    }
    for precision in 0..13 {
        let shift = 52 - precision * 4;
        let half = 1.to_u64() << (shift - 1);
        for retained in[0.to_u64(), 1.to_u64()] {
            for delta in[-1, 0, 1] {
                let fraction = ((retained << shift) | half).to_i64() + delta.to_i64();
                let value = float64_from_bits((1023.to_u64() << 52) + fraction.to_u64());
                let expected = go_format_float(value, b'x', precision, 64);
                testing::assert_eq(
                    testing::expect_ok(
                        num::format_float64_hex(value, precision, false, expected.byte_len()),
                        "hex rounding boundary",
                    ),
                    expected,
                );
            }
        }
    }
    testing::assert(num::format_float64_hex(1.0, -2, false, 32).is_err());
    testing::assert(num::format_float64_hex(1.0, 9223372036854775807, false, 32).is_err());
    testing::assert(num::format_float64_binary(1.0, -1).is_err());
    match num::format_float64_hex(1.0, -2, false, -1) {
        Err(num::FormatFloatError::InvalidLimit(value)) => assert_equal(value, -1),
        _ => testing::fail("hex negative limit precedence"),
    }
}
