package main;

use std::json;
use std::serde;
use serde::Serialize;
use serde::Deserialize;
use std::testing;

#[derive(Serialize, Deserialize)]
struct JsonStreamPerson {
    name: string,
    age: u8,
    tags: Vec[string],
    extra: Option[(bool, i64)],
}

#[derive(Serialize, Deserialize)]
enum JsonStreamEvent {
    Idle,
    Pair(i8, string),
    Named { count: u16 },
}

fn json_encode_limits() -> json::EncodeLimits {
    json::EncodeLimits {
        max_output_bytes: 10000,
        max_depth: 64,
        max_values: 1000,
        max_string_bytes: 1000,
        max_number_bytes: 1000,
        max_container_entries: 1000,
        max_path_bytes: 1000,
        max_serde_frames: 100,
        max_events: 10000,
    }
}

fn json_typed_person(input: string, step: isize) -> JsonStreamPerson {
    testing::expect_ok(
        json::from_reader(json_decode_probe(input.to_bytes(), step, 0, 0), json_decode_limits()),
        "stream typed person",
    )
}

fn json_typed_reject[T: Deserialize](input: string, kind: json::ErrorKind) -> json::Error {
    let result: Result[T, json::Error] = json::from_string_with_limits(input, json_decode_limits());
    let error = testing::expect_err(result, "typed JSON rejection");
    testing::assert_eq(error.kind(), kind);
    error
}

fn test_json_stream_typed() -> () {
    let input = "{\"name\":\"中😀\\n\",\"ignored\":[{\"nested\":[true,null,\"skip\"]}],\"age\":255,\"tags\":[\"a\",\"b\"],\"extra\":[true,-9223372036854775808]}";
    for step in 1..input.byte_len() + 1 {
        let person = json_typed_person(input, step);
        testing::assert_eq(person.name, "中😀\n");
        testing::assert_eq(person.age, 255.to_u8());
        testing::assert_eq(person.tags.len(), 2);
        testing::assert_eq(person.extra.unwrap_or((false, 0)).1, -9223372036854775807.to_i64() - 1);
        let output = testing::expect_ok(
            json::to_string_with_limits(person, json_encode_limits()),
            "typed encode",
        );
        testing::assert_eq(output, testing::expect_ok(json::try_to_string(person), "legacy encode"));
        let again = json_typed_person(output, step);
        testing::assert_eq(again.name, person.name);
    }
    for input in[
        "\"Idle\"",
        "{\"Pair\":[-128,\"ok\"]}",
        "{\"Named\":{\"unknown\":[0],\"count\":65535}}",
    ] {
        let value: JsonStreamEvent = testing::expect_ok(
            json::from_string_with_limits(input, json_decode_limits()),
            "enum decode",
        );
        let output = testing::expect_ok(
            json::to_string_with_limits(value, json_encode_limits()),
            "enum encode",
        );
        testing::assert_eq(output, testing::expect_ok(json::try_to_string(value), "legacy enum"));
    }
    let _ = json_typed_reject::[JsonStreamPerson](
        "{\"name\":\"x\",\"age\":256,\"tags\":[],\"extra\":null}",
        json::ErrorKind::Schema,
    );
    let _ = json_typed_reject::[JsonStreamPerson](
        "{\"name\":\"x\",\"name\":\"y\",\"age\":0,\"tags\":[],\"extra\":null}",
        json::ErrorKind::Schema,
    );
    let _ = json_typed_reject::[JsonStreamPerson]("{}", json::ErrorKind::Schema);
    let _ = json_typed_reject::[JsonStreamEvent]("{\"Pair\":[1]}", json::ErrorKind::Schema);
    let _ = json_typed_reject::[JsonStreamEvent]("{\"Pair\":[1,\"x\",2]}", json::ErrorKind::Schema);
    let _ = json_typed_reject::[JsonStreamEvent](
        "{\"Pair\":[1,\"x\"],\"Idle\":null}",
        json::ErrorKind::Schema,
    );
    let _ = json_typed_reject::[JsonStreamEvent]("\"Unknown\"", json::ErrorKind::Schema);
    let _ = json_typed_reject::[i8]("128", json::ErrorKind::Schema);
    let _ = json_typed_reject::[u64]("-1", json::ErrorKind::Schema);
    let _ = json_typed_reject::[i64]("9223372036854775808", json::ErrorKind::Schema);
    let _ = json_typed_reject::[u64]("18446744073709551616", json::ErrorKind::Schema);
    let _ = json_typed_reject::[isize]("1.0", json::ErrorKind::Schema);
    let _ = json_typed_reject::[f64]("1e9999", json::ErrorKind::Schema);
    let _ = json_typed_reject::[char]("\"xy\"", json::ErrorKind::Schema);
    let _ = json_typed_reject::[bool]("true false", json::ErrorKind::TrailingData);
    let _ = json_typed_reject::[bool]("", json::ErrorKind::UnexpectedEof);
    let maximum: u64 = testing::expect_ok(
        json::from_string_with_limits("18446744073709551615", json_decode_limits()),
        "u64 max",
    );
    testing::assert_eq(maximum, 18446744073709551615);
    let character: char = testing::expect_ok(
        json::from_string_with_limits("\"😀\"", json_decode_limits()),
        "char",
    );
    testing::assert_eq(character, '😀');
    let decoder = json_decode_new(
        json_decode_probe("1 [2] true".to_bytes(), 1, 0, 0),
        json_decode_limits(),
    );
    let first: Option[isize] = testing::expect_ok(decoder.decode(), "typed mixed root");
    testing::assert_eq(first.unwrap_or(0), 1);
    testing::assert_eq(
        json::encode(
            testing::expect_ok(decoder.next_value(), "value mixed root").unwrap_or(
                json::Value::Null,
            ),
        ),
        "[2]",
    );
    assert_equal(
        testing::expect_ok(decoder.next_token(), "token mixed root"),
        Option::Some(json::Token::Bool(true)),
    );
    let end: Option[bool] = testing::expect_ok(decoder.decode(), "typed EOF");
    testing::assert(end.is_none());
    testing::expect_ok(decoder.finish(), "typed finish");
}
