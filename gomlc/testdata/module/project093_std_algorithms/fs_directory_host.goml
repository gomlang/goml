package main;

use std::fs;
use fs::DirectoryEntry;
use std::io;
use std::process;
use std::testing;
use std::utf8;
use utf8::BytesUtf8;

fn directory_host_descriptor[E: DirectoryEntry](entry: E, name: string, kind: fs::FileType) -> () {
    assert_equal(entry.name(), name);
    assert_equal(entry.file_type(), kind);
    let metadata = testing::expect_ok(entry.metadata(), "host directory entry metadata");
    assert_equal(metadata.file_type(), kind);
    testing::assert(metadata.mode().flags().is_none());
    assert_equal(metadata.mode().file_type(), kind);
}

fn directory_host_removed[E: DirectoryEntry](entry: E, name: string, kind: fs::FileType) -> () {
    assert_equal(entry.name(), name);
    assert_equal(entry.file_type(), kind);
    let error = testing::expect_err(entry.metadata(), "removed host directory entry");
    assert_equal(error.kind(), io::ErrorKind::NotFound);
    assert_equal(entry.name(), name);
    assert_equal(entry.file_type(), kind);
}

fn check_fs_directory_host() -> () {
    let prefix = "/tmp/goml-fs-entry.";
    let output = testing::expect_ok(
        process::Command::new("mktemp").arg("-d").arg(prefix + "XXXXXXXX").output_structured(),
        "create exclusive host directory fixture",
    );
    testing::assert(output.status().success());
    let stdout = testing::expect_ok(output.stdout().to_string_utf8(), "temporary directory UTF-8");
    assert_equal(stdout.byte_len(), prefix.byte_len() + 9);
    testing::assert(stdout.starts_with(prefix));
    assert_equal(stdout.byte_get(stdout.byte_len() - 1), b'\n');
    let directory = stdout.byte_slice(0, stdout.byte_len() - 1);
    for index in prefix.byte_len()..directory.byte_len() {
        let value = directory.byte_get(index);
        testing::assert(
            (value >= b'a' && value <= b'z') || (value >= b'A' && value <= b'Z')
                || (value >= b'0' && value <= b'9'),
        );
    }
    defer {
        testing::expect_ok(fs::remove_dir_all(directory), "remove exclusive host directory fixture");
    };
    let file = directory + "/file";
    let directory_metadata = testing::expect_ok(fs::metadata(directory), "host directory mode");
    assert_equal(directory_metadata.mode().kind(), fs::NodeKind::Directory);
    testing::assert(directory_metadata.mode().flags().is_none());
    let link = directory + "/link";
    testing::expect_ok(fs::write_file_structured(file, "contents"), "create host entry file");
    testing::expect_ok(fs::symbolic_link("file", link), "create host entry symlink");
    let entries = testing::expect_ok(
        fs::read_dir_structured(directory),
        "snapshot host directory entries",
    );
    assert_equal(entries.len(), 2);
    let mut files = 0;
    let mut links = 0;
    for entry in entries {
        if entry.name() == "file" {
            directory_host_descriptor(entry, "file", fs::FileType::File);
            files += 1;
        } else {
            directory_host_descriptor(entry, "link", fs::FileType::Symlink);
            links += 1;
        }
    }
    assert_equal(files, 1);
    assert_equal(links, 1);
    testing::expect_ok(fs::remove_file(file), "remove host entry target");
    for entry in entries {
        if entry.name() == "file" {
            directory_host_removed(entry, "file", fs::FileType::File);
        } else {
            directory_host_descriptor(entry, "link", fs::FileType::Symlink);
        }
    }
}
