package main;

use std::num;
use std::testing;

#[go_ffi("example.com/goml-std-algorithms/native", "FormatComplex")]
extern fn go_format_complex(real: f64, imaginary: f64, format: byte, precision: isize, width: isize) -> string;

fn complex_format_modes() -> Vec[(num::ComplexFormat, byte, isize)] {
    Vec::from_array(
        [
            (num::ComplexFormat::Shortest(num::FloatNotation::Fixed), b'f', -1),
            (num::ComplexFormat::Shortest(num::FloatNotation::Scientific), b'e', -1),
            (num::ComplexFormat::Shortest(num::FloatNotation::ScientificUpper), b'E', -1),
            (num::ComplexFormat::Shortest(num::FloatNotation::General), b'g', -1),
            (num::ComplexFormat::Shortest(num::FloatNotation::GeneralUpper), b'G', -1),
            (num::ComplexFormat::Fixed(0), b'f', 0),
            (num::ComplexFormat::Fixed(6), b'f', 6),
            (num::ComplexFormat::Scientific(0, false), b'e', 0),
            (num::ComplexFormat::Scientific(17, true), b'E', 17),
            (num::ComplexFormat::General(0, false), b'g', 0),
            (num::ComplexFormat::General(6, true), b'G', 6),
            (num::ComplexFormat::General(17, false), b'g', 17),
            (num::ComplexFormat::Binary, b'b', -1),
            (num::ComplexFormat::Hex(-1, false), b'x', -1),
            (num::ComplexFormat::Hex(-1, true), b'X', -1),
            (num::ComplexFormat::Hex(0, false), b'x', 0),
            (num::ComplexFormat::Hex(2, true), b'X', 2),
            (num::ComplexFormat::Hex(16, false), b'x', 16),
        ],
    )
}

fn complex_format_at_width(
    real: f64,
    imaginary: f64,
    format: num::ComplexFormat,
    limit: isize,
    width: isize,
) -> Result[string, num::FormatFloatError] {
    if width == 32 {
        num::format_complex_f32(real.to_f32(), imaginary.to_f32(), format, limit)
    } else {
        num::format_complex_f64(real, imaginary, format, limit)
    }
}

fn check_complex_format_pair(real: f64, imaginary: f64) -> () {
    for (format, code, precision) in complex_format_modes() {
        for width in[32, 64] {
            let expected = go_format_complex(real, imaginary, code, precision, width);
            testing::assert_eq(
                testing::expect_ok(
                    complex_format_at_width(real, imaginary, format, expected.byte_len(), width),
                    "exact complex limit",
                ),
                expected,
            );
            match complex_format_at_width(real, imaginary, format, expected.byte_len() - 1, width) {
                Err(num::FormatFloatError::OutputLimit(limit)) => assert_equal(
                    limit,
                    expected.byte_len() - 1,
                ),
                _ => testing::fail("complex framing limit ignored"),
            }
        }
    }
}

fn check_complex_formatting() -> () {
    let values = [
        0.to_u64(),
        1.to_u64(),
        1.to_u64() << 63,
        0x8000000000000001,
        0x0010000000000000,
        0x36a0000000000000,
        0x3810000000000000,
        0x47efffffe0000000,
        0x3ff4000000000000,
        0xc004000000000000,
        0x7fefffffffffffff,
        0x7ff0000000000000,
        0xfff0000000000000,
        0x7ff8000000000001,
        0xfff8000000000001,
    ];
    for real in values {
        for imaginary in values {
            check_complex_format_pair(float64_from_bits(real), float64_from_bits(imaginary));
        }
    }
    let mut state: u64 = 1082269761;
    for _ in 0..32 {
        state = state ^ (state << 13);
        state = state ^ (state >> 7);
        state = state ^ (state << 17);
        check_complex_format_pair(
            float64_from_bits(state),
            float64_from_bits(state ^ 0x7fefffffffffffff),
        );
    }
    for format in[
        num::ComplexFormat::Fixed(-1),
        num::ComplexFormat::Scientific(-1, false),
        num::ComplexFormat::General(-1, true),
        num::ComplexFormat::Hex(-2, false),
    ] {
        for width in[32, 64] {
            match complex_format_at_width(1.0, 2.0, format, -1, width) {
                Err(num::FormatFloatError::InvalidLimit(value)) => assert_equal(value, -1),
                _ => testing::fail("complex negative limit precedence"),
            }
            match complex_format_at_width(
                float64_from_bits(0x7ff8000000000001),
                0.0,
                format,
                100,
                width,
            ) {
                Err(num::FormatFloatError::InvalidPrecision(_)) => (),
                _ => testing::fail("complex invalid precision accepted"),
            }
        }
    }
    for width in[32, 64] {
        testing::assert(
            complex_format_at_width(
                1.0,
                2.0,
                num::ComplexFormat::Fixed(9223372036854775807),
                10,
                width,
            ).is_err(),
        );
        assert_equal(
            testing::expect_ok(
                complex_format_at_width(
                    1.0,
                    2.0,
                    num::ComplexFormat::General(9223372036854775807, false),
                    6,
                    width,
                ),
                "huge general precision",
            ),
            "(1+2i)",
        );
    }
}
