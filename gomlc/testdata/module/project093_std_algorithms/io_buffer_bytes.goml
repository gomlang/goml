package main;

use std::io;
use io::{Read, BufRead};
use std::bytes;
use std::testing;

struct BufferByteSource {
    cursor: io::Cursor,
    fail: Ref[bool],
    calls: Ref[isize],
    requests: Vec[isize],
}

impl Read for BufferByteSource {
    fn read(self: BufferByteSource, output: MutSlice[byte]) -> Result[isize, io::Error] {
        self.calls.set(self.calls.get() + 1);
        self.requests.push(output.len());
        if self.fail.get() {
            Result::Err(
                io::Error::new(
                    io::ErrorKind::Interrupted,
                    "byte source",
                    Option::None,
                    Option::None,
                    "stop",
                ),
            )
        } else {
            self.cursor.read(output)
        }
    }
}

fn check_buffer_byte_unread_error(result: Result[(), io::Error]) -> () {
    match result {
        Err(error) => assert_equal(error.kind(), io::ErrorKind::InvalidInput),
        Ok(_) => testing::fail("unread byte requires a successful read"),
    }
}

fn check_io_buffer_bytes() -> () {
    let all = Vec::new();
    for code in 0..256 {
        all.push(code.to_u8());
    }
    for capacity in 1..6 {
        let source = BufferByteSource {
            cursor: io::Cursor::new(bytes::Bytes::from_vec(all)),
            fail: Ref::new(false),
            calls: Ref::new(0),
            requests: Vec::new(),
        };
        let reader = testing::expect_ok(
            io::BufReader::with_capacity(source, capacity),
            "byte reader",
        );
        let alias = reader;
        check_buffer_byte_unread_error(reader.unread_byte());
        for code in 0..256 {
            assert_equal(
                testing::expect_ok(reader.read_byte(), "read arbitrary byte"),
                Option::Some(code.to_u8()),
            );
            assert_equal(alias.capacity(), capacity);
            testing::assert(alias.buffered_len() >= 0);
            let calls = source.calls.get();
            testing::expect_ok(alias.unread_byte(), "unread arbitrary byte");
            check_buffer_byte_unread_error(reader.unread_byte());
            assert_equal(
                testing::expect_ok(reader.read_byte(), "reread arbitrary byte"),
                Option::Some(code.to_u8()),
            );
            assert_equal(source.calls.get(), calls);
        }
        assert_equal(testing::expect_ok(reader.read_byte(), "byte EOF"), Option::None);
        check_buffer_byte_unread_error(alias.unread_byte());
        for request in source.requests {
            testing::assert(request > 0 && request <= capacity);
        }
        for operation in 0..11 {
            let reader = testing::expect_ok(
                io::BufReader::with_capacity(
                    io::Cursor::new(bytes::Bytes::from_string("abcdef")),
                    capacity,
                ),
                "rollback transition",
            );
            testing::expect_ok(reader.read_byte(), "prime byte rollback");
            match operation {
                0 => {
                    let _ = reader.peek(0);
                },
                1 => {
                    let _ = reader.peek(-1);
                },
                2 => {
                    let _ = reader.peek(capacity + 1);
                },
                3 => {
                    let _ = reader.fill_buf();
                },
                4 => {
                    let _ = reader.consume(0);
                },
                5 => {
                    let _ = reader.consume(-1);
                },
                6 => {
                    let _ = reader.consume(100);
                },
                7 => reader.reset(io::Cursor::new(bytes::Bytes::from_string("z"))),
                8 => {
                    let empty: Vec[byte] = Vec::new();
                    assert_equal(
                        testing::expect_ok(reader.read(empty.as_mut_slice()), "empty read"),
                        0,
                    );
                },
                9 => {
                    let _ = reader.peek(1);
                },
                _ => {
                    let _ = reader.consume(1);
                },
            }
            check_buffer_byte_unread_error(reader.unread_byte());
        }
        let reader = testing::expect_ok(
            io::BufReader::with_capacity(
                io::Cursor::new(bytes::Bytes::from_string("abc\ndef")),
                capacity,
            ),
            "rollback composition",
        );
        let scratch = b"???";
        let count = testing::expect_ok(
            reader.read(scratch.as_mut_slice()),
            "bulk read before unread",
        );
        testing::assert(count > 0);
        let last = scratch[count - 1];
        testing::expect_ok(reader.unread_byte(), "unread last bulk byte");
        assert_equal(
            testing::expect_ok(reader.read_byte(), "last bulk byte again"),
            Option::Some(last),
        );
        testing::expect_ok(reader.unread_byte(), "unread before peek");
        let snapshot = testing::expect_ok(reader.peek(1), "peek rolled back byte").to_vec();
        assert_equal(snapshot, Vec::from_array([last]));
        check_buffer_byte_unread_error(reader.unread_byte());
        assert_equal(testing::expect_ok(reader.discard(1), "discard rollback byte"), 1);
        let tail = testing::expect_ok(reader.read_until(b'\n', 10), "line after rollback discard");
        assert_equal(tail.to_vec(), b"abc\n".as_slice().sub(count, 4).to_vec());
        testing::expect_ok(reader.read_to_end(10), "finish buffered source");
        assert_equal(snapshot, Vec::from_array([last]));
        let reader = testing::expect_ok(
            io::BufReader::with_capacity(io::Cursor::new(bytes::Bytes::from_string("ab")), capacity),
            "no operation rollback",
        );
        testing::expect_ok(reader.read_byte(), "prime no operation");
        assert_equal(testing::expect_ok(reader.discard(0), "zero discard"), 0);
        let empty: Vec[byte] = Vec::new();
        testing::expect_ok(reader.read_exact(empty.as_mut_slice()), "empty exact");
        testing::expect_ok(reader.unread_byte(), "no operation preserved rollback");
        assert_equal(
            testing::expect_ok(reader.read_byte(), "no operation reread"),
            Option::Some(b'a'),
        );
        let reader = testing::expect_ok(
            io::BufReader::with_capacity(io::StringReader::new("éx"), capacity),
            "character byte rollback",
        );
        assert_equal(
            testing::expect_ok(reader.read_char(), "read character before byte rollback"),
            Option::Some(('é', 2)),
        );
        testing::expect_ok(reader.unread_byte(), "unread final encoded byte");
        assert_equal(
            testing::expect_ok(reader.read_byte(), "encoded continuation byte"),
            Option::Some(0xa9.to_u8()),
        );
        assert_equal(testing::expect_ok(reader.read_byte(), "character suffix"), Option::Some(b'x'));
    }
    let source = BufferByteSource {
        cursor: io::Cursor::new(bytes::Bytes::from_string("ab")),
        fail: Ref::new(false),
        calls: Ref::new(0),
        requests: Vec::new(),
    };
    let reader = testing::expect_ok(io::BufReader::with_capacity(source, 1), "failed byte read");
    assert_equal(testing::expect_ok(reader.read_byte(), "byte before failure"), Option::Some(b'a'));
    source.fail.set(true);
    match reader.read_byte() {
        Err(error) => assert_equal(error.kind(), io::ErrorKind::Interrupted),
        Ok(_) => testing::fail("byte read must propagate interruption"),
    }
    assert_equal(source.calls.get(), 2);
    check_buffer_byte_unread_error(reader.unread_byte());
    source.fail.set(false);
    assert_equal(
        testing::expect_ok(reader.read_byte(), "explicit recovery byte"),
        Option::Some(b'b'),
    );
    testing::expect_ok(reader.unread_byte(), "recovery establishes eligibility");
}
