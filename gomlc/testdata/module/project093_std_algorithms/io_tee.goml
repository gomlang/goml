package main;

use std::io;
use std::io::{Read, Write};
use std::bytes;
use std::testing;

struct PartialMirror {
    output: io::Cursor,
    error: io::Error,
}

impl Write for PartialMirror {
    fn write(self: PartialMirror, buffer: Slice[byte]) -> Result[isize, io::Error] {
        let count = if buffer.len() < 2 {
            buffer.len()
        } else {
            2
        };
        self.output.write(buffer.sub(0, count))?;
        Result::Err(self.error)
    }
}

fn check_io_tee() -> () {
    let data = b"abcdef";
    for width in 1..8 {
        let source = CopyReader {
            cursor: io::Cursor::new(bytes::Bytes::from_vec(data)),
            interrupted: Ref::new(false),
        };
        let mirror = CopyWriter {
            cursor: io::Cursor::new(bytes::Bytes::new()),
            interrupted: Ref::new(false),
        };
        let tee = io::TeeReader::new(source, mirror);
        let destination = io::Cursor::new(bytes::Bytes::new());
        let scratch = Vec::new();
        for _ in 0..width {
            scratch.push(0.to_u8());
        }
        assert_equal(
            testing::expect_ok(
                io::copy_buffer(tee, destination, scratch.as_mut_slice()),
                "tee copy",
            ),
            6.to_u64(),
        );
        assert_equal(destination.bytes().to_vec(), data);
        assert_equal(mirror.cursor.bytes().to_vec(), data);
        testing::assert(tee.failure().is_none());
        assert_equal(tee.failed_read_count(), 0);
    }
    let failure = io::Error::new(
        io::ErrorKind::PermissionDenied,
        "mirror",
        Option::None,
        Option::None,
        "stop",
    );
    let source = io::Cursor::new(bytes::Bytes::from_vec(data));
    let mirror = PartialMirror { output: io::Cursor::new(bytes::Bytes::new()), error: failure };
    let tee = io::TeeReader::new(source, mirror);
    let output = b"???";
    match tee.read(output.as_mut_slice()) {
        Err(error) => assert_equal(error, failure),
        Ok(_) => testing::assert(false),
    }
    assert_equal(output, b"abc");
    assert_equal(source.position(), 3);
    assert_equal(mirror.output.bytes().to_vec(), b"ab");
    assert_equal(tee.failed_read_count(), 3);
    assert_equal(testing::expect_some(tee.failure(), "original error"), failure);
    let alias = tee;
    let empty: Vec[byte] = Vec::new();
    testing::assert(alias.read(empty.as_mut_slice()).is_err());
    testing::assert(alias.read(output.as_mut_slice()).is_err());
    assert_equal(source.position(), 3);
    assert_equal(mirror.output.bytes().to_vec(), b"ab");
    let events = Vec::new();
    let probe = multi_probe(events, 1, 0);
    let exhausted = io::TeeReader::new(io::Cursor::new(bytes::Bytes::new()), probe);
    testing::expect_ok(exhausted.read(empty.as_mut_slice()), "empty tee read");
    testing::expect_ok(exhausted.read(output.as_mut_slice()), "tee eof");
    assert_equal(events.len(), 0);
    let interrupted = io::Error::new(
        io::ErrorKind::Interrupted,
        "mirror",
        Option::None,
        Option::None,
        "stop",
    );
    probe.result.set(Result::Err(interrupted));
    let no_retry = io::MultiWriter::new(Vec::from_array([probe]).as_slice());
    let source2 = io::Cursor::new(bytes::Bytes::from_vec(data));
    let terminal = io::TeeReader::new(source2, no_retry);
    match terminal.read_exact(output.as_mut_slice()) {
        Err(error) => assert_equal(error.kind(), io::ErrorKind::Other),
        Ok(_) => testing::assert(false),
    }
    assert_equal(events.len(), 1);
    assert_equal(source2.position(), 3);
    assert_equal(testing::expect_some(terminal.failure(), "interrupted cause"), interrupted);
    testing::assert(terminal.read_exact(output.as_mut_slice()).is_err());
    assert_equal(events.len(), 1);
    for count in[-1, 4] {
        let reader = multi_probe(events, 2, count);
        let writer = io::Cursor::new(bytes::Bytes::new());
        let invalid = io::TeeReader::new(reader, writer);
        testing::assert(invalid.read(output.as_mut_slice()).is_err());
        testing::assert(invalid.failure().is_none());
        assert_equal(writer.position(), 0);
    }
}
