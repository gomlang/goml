package main;

use std::bytes;
use std::encoding::base32;
use std::rand;
use std::testing;

fn check_base32_decoder() -> () {
    check_base32_decoder_transactions();
    let encodings = Vec::new();
    for variant in[
        base32::Variant::Standard,
        base32::Variant::StandardNoPadding,
        base32::Variant::Hex,
        base32::Variant::HexNoPadding,
    ] {
        encodings.push(base32::Encoding::from_variant(variant));
    }
    encodings.push(
        testing::expect_ok(
            base32::Encoding::new("=BCDEFGHIJKLMNOPQRSTUVWXYZ234567", Option::None),
            "raw equals alphabet",
        ),
    );
    encodings.push(
        testing::expect_ok(
            base32::Encoding::new("abcdefghijklmnopqrstuvwxyz234567", Option::Some(0.to_u8())),
            "NUL padding",
        ),
    );
    for encoding in encodings {
        let reference = go_base32_padding(
            go_base32(encoding.alphabet()),
            match encoding.padding() {
                Some(value) => value.to_i32(),
                None => -1.to_i32(),
            },
        );
        for length in 0..65 {
            let data = rand::bytes(length.to_u64(), length);
            let encoded = go_base32_encode(reference, data.as_slice());
            for chunk in 1..12 {
                let decoder = testing::expect_ok(base32::Decoder::new(encoding, length), "decoder");
                let alias = decoder;
                let result = bytes::Bytes::new();
                let mut offset = 0;
                while offset < encoded.byte_len() {
                    let end = if encoded.byte_len() - offset < chunk {
                        encoded.byte_len()
                    } else {
                        offset + chunk
                    };
                    result.extend_from_slice(
                        testing::expect_ok(
                            alias.update(encoded.byte_slice(offset, end)),
                            "decode chunk",
                        ).as_slice(),
                    );
                    assert_equal(decoder.input_len(), end);
                    assert_equal(decoder.output_len(), result.len());
                    offset = end;
                }
                result.extend_from_slice(
                    testing::expect_ok(decoder.finish(), "decode finish").as_slice(),
                );
                assert_equal(result.to_vec(), data);
                assert_equal(decoder.output_len(), length);
                testing::assert(alias.is_finished());
                assert_equal(testing::expect_ok(alias.finish(), "repeat finish").len(), 0);
                testing::assert(alias.update("").is_err());
                alias.reset();
                assert_equal(decoder.input_len(), 0);
                assert_equal(decoder.output_len(), 0);
                testing::assert(!decoder.is_finished());
                let again = testing::expect_ok(decoder.update(encoded), "reset decode");
                again.extend_from_slice(
                    testing::expect_ok(decoder.finish(), "reset finish").as_slice(),
                );
                assert_equal(again.to_vec(), data);
            }
        }
    }
    check_base32_decoder_errors();
}

fn check_base32_decoder_transactions() -> () {
    for variant in[
        base32::Variant::Standard,
        base32::Variant::StandardNoPadding,
        base32::Variant::Hex,
        base32::Variant::HexNoPadding,
    ] {
        let encoding = base32::Encoding::from_variant(variant);
        for length in 0..17 {
            let data = rand::bytes(length.to_u64(), length);
            let encoded = encoding.encode(bytes::Bytes::from_vec(data));
            for split in 0..encoded.byte_len() + 1 {
                let decoder = testing::expect_ok(
                    base32::Decoder::new(encoding, length),
                    "transaction decoder",
                );
                let prefix = testing::expect_ok(
                    decoder.update(encoded.byte_slice(0, split)),
                    "valid prefix",
                );
                let result = bytes::Bytes::from_vec(prefix.to_vec().copy());
                let before_input = decoder.input_len();
                let before_output = decoder.output_len();
                let tail = encoded.byte_slice(split, encoded.byte_len());
                match decoder.update(tail + "!") {
                    Err(base32::StreamError::Output(base32::OutputError::Decode(cause))) => assert_equal(
                        cause.index(),
                        encoded.byte_len(),
                    ),
                    _ => testing::fail("incorrect transactional decode failure"),
                }
                assert_equal(decoder.input_len(), before_input);
                assert_equal(decoder.output_len(), before_output);
                testing::assert(!decoder.is_finished());
                if prefix.len() > 0 {
                    prefix.set(0, 0.to_u8());
                }
                let suffix = testing::expect_ok(
                    decoder.update(tail),
                    "retry after discarded output",
                );
                result.extend_from_slice(suffix.as_slice());
                let ending = testing::expect_ok(decoder.finish(), "finish retry");
                result.extend_from_slice(ending.as_slice());
                assert_equal(result.to_vec(), data);
                assert_equal(decoder.input_len(), encoded.byte_len());
                assert_equal(decoder.output_len(), length);
                decoder.reset();
                if suffix.len() > 0 {
                    suffix.set(0, 0.to_u8());
                }
                let fresh = testing::expect_ok(decoder.update(encoded), "reset independent result");
                fresh.extend_from_slice(
                    testing::expect_ok(decoder.finish(), "reset finish").as_slice(),
                );
                assert_equal(fresh.to_vec(), data);
                assert_equal(result.to_vec(), data);
            }
        }
    }
}

fn check_base32_decoder_errors() -> () {
    let encoding = base32::Encoding::from_variant(base32::Variant::Standard);
    testing::assert(base32::Decoder::new(encoding, -1).is_err());
    let decoder = testing::expect_ok(base32::Decoder::new(encoding, 6), "error decoder");
    assert_equal(testing::expect_ok(decoder.update("MZXW6YTB"), "first quantum").to_vec(), b"fooba");
    match decoder.update("MZ======") {
        Err(base32::StreamError::Output(base32::OutputError::Decode(error))) => {
            assert_equal(error.kind(), base32::DecodeErrorKind::NonCanonical);
            assert_equal(error.index(), 9);
        },
        _ => testing::assert(false),
    }
    assert_equal(decoder.input_len(), 8);
    assert_equal(decoder.output_len(), 5);
    assert_equal(testing::expect_ok(decoder.update("MY======"), "corrected quantum").to_vec(), b"f");
    testing::assert(decoder.update("A").is_err());
    assert_equal(decoder.input_len(), 16);
    assert_equal(testing::expect_ok(decoder.update(""), "empty terminal update").len(), 0);
    testing::expect_ok(decoder.finish(), "terminal finish");
    let partial = testing::expect_ok(base32::Decoder::new(encoding, 1), "partial decoder");
    testing::expect_ok(partial.update("MY"), "partial prefix");
    testing::assert(partial.finish().is_err());
    testing::assert(!partial.is_finished());
    assert_equal(partial.input_len(), 2);
    assert_equal(
        testing::expect_ok(partial.update("======"), "complete after failed finish").to_vec(),
        b"f",
    );
    testing::expect_ok(partial.finish(), "completed finish");
    let bounded = testing::expect_ok(base32::Decoder::new(encoding, 5), "bounded decoder");
    testing::assert(bounded.update("MZXW6YTBMY======").is_err());
    assert_equal(bounded.input_len(), 0);
    assert_equal(bounded.output_len(), 0);
    assert_equal(testing::expect_ok(bounded.update("MZXW6YTB"), "smaller retry").to_vec(), b"fooba");
    testing::expect_ok(bounded.finish(), "bounded finish");
    for input in Vec::from_array(["MZXW6YTB?", "MY======A", "你", "M!======", "========"]) {
        let invalid = testing::expect_ok(base32::Decoder::new(encoding, 100), "invalid decoder");
        testing::assert(invalid.update(input).is_err());
        assert_equal(invalid.input_len(), 0);
        assert_equal(invalid.output_len(), 0);
    }
    let raw = base32::Encoding::from_variant(base32::Variant::StandardNoPadding);
    let too_small = testing::expect_ok(base32::Decoder::new(raw, 0), "pending limit");
    testing::assert(too_small.update("MY").is_err());
    assert_equal(too_small.input_len(), 0);
    testing::expect_ok(too_small.finish(), "empty limited finish");
    for input in Vec::from_array(["A", "AAA", "AAAAAA", "MZ"]) {
        let invalid = testing::expect_ok(base32::Decoder::new(raw, 100), "raw tail");
        testing::expect_ok(invalid.update(input), "buffer raw tail");
        testing::assert(invalid.finish().is_err());
        testing::assert(!invalid.is_finished());
    }
}
