package main;

use std::num;
use std::testing;

#[go_ffi("example.com/goml-std-algorithms/native", "ParseComplex")]
extern fn go_parse_complex(value: string, width: isize) -> (u64, u64, bool, bool);

fn check_complex_bits(value: f64, expected: u64) -> () {
    let actual = float64_to_bits(value);
    if expected & 0x7ff0000000000000 == 0x7ff0000000000000 && expected & 0xfffffffffffff != 0 {
        testing::assert(
            actual & 0x7ff0000000000000 == 0x7ff0000000000000 && actual & 0xfffffffffffff != 0,
        );
    } else {
        testing::assert_eq(actual, expected);
    }
}

fn check_complex_parse(value: string) -> () {
    for width in[32, 64] {
        let (real, imaginary, valid, range) = go_parse_complex(value, width);
        let actual = if width == 32 {
            num::parse_complex_f32(value).map(
                |parts: (f32, f32)| (float32_to_float64(parts.0), float32_to_float64(parts.1)),
            )
        } else {
            num::parse_complex_f64(value)
        };
        if actual.is_ok() != valid {
            testing::fail(f"complex validity mismatch: {value}, width {width}");
        }
        match actual {
            Ok(parts) => {
                check_complex_bits(parts.0, real);
                check_complex_bits(parts.1, imaginary);
            },
            Err(error) => {
                if error.is_range() != range {
                    testing::fail(f"complex error mismatch: {value}, width {width}");
                }
            },
        }
    }
}

fn check_complex_parsing() -> () {
    for value in[
        "",
        "()",
        "(1)",
        "((1))",
        "(1+2i",
        "1+2i)",
        "i",
        "+i",
        "-i",
        "0",
        "-0",
        "-0i",
        "1+2i",
        "1+-2i",
        "1++2i",
        "1-+2i",
        "NaN",
        "+NaN",
        "NaNi",
        "1+NaNi",
        "1-NaNi",
        "Inf",
        "Infinityi",
        "+Inf-Infi",
        "1e999+NaNi",
        "1e999+xi",
        "1e999+2",
        "1+2e999i",
        "0x1.fp+2-0x1p-149i",
        "1_0+2_0i",
        " 1",
        "1 ",
        "1 +2i",
        "1+2I",
        "１+２i",
    ] {
        check_complex_parse(value);
    }
    let parts = ["", "0", "-0", "1", "-2", "NaN", "Inf", "1e-2", "0x1p+2", "1e999", "1e-999"];
    for real in parts {
        for imaginary in parts {
            for separator in["+", "-", "+-", "++"] {
                let value = real + separator + imaginary + "i";
                check_complex_parse(value);
                check_complex_parse("(" + value + ")");
            }
        }
    }
    let mut state: u64 = 1082269761;
    for _ in 0..128 {
        state = state ^ (state << 13);
        state = state ^ (state >> 7);
        state = state ^ (state << 17);
        let real = go_format_float(float64_from_bits(state), b'g', -1, 64);
        let imaginary = go_format_float(float64_from_bits(state ^ 0x7fefffffffffffff), b'x', -1, 64);
        check_complex_parse(real + "+" + imaginary + "i");
    }
    assert_equal(
        testing::expect_err(num::parse_complex_f64("1e999+xi"), "syntax before range"),
        num::ParseComplexError::Syntax,
    );
    assert_equal(
        testing::expect_err(num::parse_complex_f32("1e100+2i"), "component range"),
        num::ParseComplexError::OutOfRange,
    );
}
