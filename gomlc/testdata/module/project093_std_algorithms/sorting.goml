package main;

use std::cmp;
use std::collections;
use std::rand;
use std::testing;

#[go_ffi("sort", "Ints")]
extern fn go_sort_ints(values: MutSlice[isize]) -> ();

#[go_ffi("sort", "IntsAreSorted")]
extern fn go_ints_sorted(values: Slice[isize]) -> bool;

#[go_ffi("sort", "SearchInts")]
extern fn go_search_ints(values: Slice[isize], expected: isize) -> isize;

fn check_sorting() -> () {
    check_sort_contracts();
    let calls = Ref::new(0);
    assert_equal(
        collections::search(
            -1,
            |_: isize| {
                calls.set(calls.get() + 1);
                true
            },
        ),
        Option::None,
    );
    assert_equal(
        collections::search(
            0,
            |_: isize| {
                calls.set(calls.get() + 1);
                true
            },
        ),
        Option::Some(0),
    );
    assert_equal(calls.get(), 0);
    for length in 0..65 {
        for boundary in 0..length + 1 {
            assert_equal(
                collections::search(length, |index: isize| index >= boundary),
                Option::Some(boundary),
            );
        }
    }
    let largest: isize = 9223372036854775807;
    assert_equal(
        collections::search(largest, |index: isize| index >= largest - 1),
        Option::Some(largest - 1),
    );
    assert_equal(collections::search(largest, |_: isize| false), Option::Some(largest));
    let mut seed: u64 = 643;
    for length in 0..257 {
        let values: Vec[isize] = Vec::new();
        for _ in 0..length {
            seed = rand::next_u64(seed);
            values.push((seed % 33).to_isize() - 16)
        }
        assert_equal(collections::is_sorted(values), go_ints_sorted(values.as_slice()));
        let oracle: Vec[isize] = Vec::new();
        let stable: Vec[(isize, isize)] = Vec::new();
        for index in 0..values.len() {
            oracle.push(values[index]);
            stable.push((values[index], index));
        }
        go_sort_ints(oracle.as_mut_slice());
        collections::sort(values);
        assert_equal(values, oracle);
        testing::assert(collections::is_sorted(values));
        collections::stable_sort_by(
            stable,
            |left: (isize, isize), right: (isize, isize)| left.0 - right.0,
        );
        for index in 1..stable.len() {
            testing::assert(stable[index - 1].0 <= stable[index].0);
            if stable[index - 1].0 == stable[index].0 {
                testing::assert(stable[index - 1].1 < stable[index].1)
            }
        }
        for expected in -18..19 {
            let low = go_search_ints(oracle.as_slice(), expected);
            let mut high = low;
            while high < oracle.len() && oracle[high] == expected {
                high += 1;
            }
            assert_equal(collections::lower_bound(values, expected), low);
            assert_equal(collections::upper_bound(values, expected), high);
            assert_equal(collections::equal_range(values, expected), (low, high));
            assert_equal(
                collections::equal_range_by(values, |value: isize| value - expected),
                (low, high),
            );
            assert_equal(
                collections::lower_bound_by_ordering(
                    values,
                    |value: isize| cmp::compare(value, expected),
                ),
                low,
            );
            assert_equal(
                collections::upper_bound_by_ordering(
                    values,
                    |value: isize| cmp::compare(value, expected),
                ),
                high,
            );
            let found = if low < high {
                Option::Some(low)
            } else {
                Option::None
            };
            assert_equal(collections::binary_search(values, expected), found);
        }
        collections::sort_by(values, |left: isize, right: isize| right - left);
        testing::assert(collections::is_sorted_by(values, |left: isize, right: isize| right - left));
        testing::assert(
            collections::is_sorted_by_ordering(
                values,
                |left: isize, right: isize| cmp::compare(right, left),
            ),
        );
        for expected in -18..19 {
            let mut low = 0;
            while low < values.len() && values[low] > expected {
                low += 1;
            }
            let mut high = low;
            while high < values.len() && values[high] == expected {
                high += 1;
            }
            assert_equal(
                collections::equal_range_by(values, |value: isize| expected - value),
                (low, high),
            );
        }
    }
    let strings = Vec::from_array(["世", "a", "a", "b"]);
    collections::stable_sort(strings);
    assert_equal(collections::equal_range(strings, "a"), (0, 2));
    testing::assert(collections::is_sorted(strings));
}
