package main;

use std::fs;
use fs::FileSystem;
use std::io;
use std::testing;

struct WalkRepeatFs {
    source: WalkProbeFs,
    opens: Vec[string],
}

impl FileSystem for WalkRepeatFs {
    type Handle = WalkProbeHandle;

    fn open(self: WalkRepeatFs, name: string) -> Result[WalkProbeHandle, fs::Error] {
        self.opens.push(name);
        testing::assert(self.opens.len() <= 8);
        self.source.open(".")
    }
}

fn check_fs_walk_cycle() -> () {
    for budget in 0..3 {
        for control in 0..3 {
            let source = walk_probe_fs(
                Vec::from_array(
                    [
                        walk_probe_node(
                            ".",
                            Vec::from_array([walk_probe_entry("d", fs::FileType::Directory, 0)]),
                        ),
                    ],
                ),
            );
            let filesystem = WalkRepeatFs { source, opens: Vec::new() };
            let limits = fs::WalkLimits {
                max_depth: if budget == 0 {
                    2
                } else {
                    100
                },
                max_directory_entries: 100,
                max_directories: if budget == 1 {
                    2
                } else {
                    100
                },
                max_work: if budget == 2 {
                    13
                } else {
                    1000
                },
            };
            let visited = Vec::new();
            let failures = Vec::new();
            let result = fs::walk_from(
                filesystem,
                ".",
                limits,
                |path, entry, error| {
                    assert_equal(source.active.get(), 0);
                    testing::assert(entry.is_some());
                    if let Some(cause) = error {
                        assert_equal(path, "d/d");
                        assert_equal(cause.kind(), io::ErrorKind::InvalidData);
                        assert_equal(cause.operation(), "walk");
                        assert_equal(cause.path(), Option::Some("d/d"));
                        failures.push(cause);
                        Result::Ok(
                            match control {
                                0 => fs::WalkControl::Continue,
                                1 => fs::WalkControl::SkipDir,
                                _ => fs::WalkControl::SkipAll,
                            },
                        )
                    } else {
                        visited.push(path);
                        testing::assert(visited.len() <= 8);
                        Result::Ok(fs::WalkControl::Continue)
                    }
                },
            );
            assert_equal(visited, Vec::from_array([".", "d", "d/d"]));
            assert_equal(failures.len(), 1);
            if control == 2 {
                testing::expect_ok(result, "SkipAll stops repeated directory tree");
            } else {
                assert_equal(
                    testing::expect_err(result, "global walk budget cannot be swallowed"),
                    failures[0],
                );
            }
            assert_equal(
                filesystem.opens,
                if budget == 2 {
                    Vec::from_array([".", ".", "d", "d/d"])
                } else {
                    Vec::from_array([".", ".", "d"])
                },
            );
            assert_equal(source.active.get(), 0);
            if budget == 2 {
                assert_equal(
                    source.events,
                    Vec::from_array(
                        [
                            "open:.",
                            "stat:.",
                            "close:.",
                            "open:.",
                            "read:.:10",
                            "read:.:8",
                            "close:.",
                            "open:.",
                            "read:.:6",
                            "read:.:4",
                            "close:.",
                            "open:.",
                            "read:.:2",
                            "close:.",
                        ],
                    ),
                );
            }
        }
    }
}
