package main;

use std::text::format;
use std::io;
use io::{Write, Close};
use std::testing;

struct FormatIoSink {
    bytes: Vec[byte],
    calls: Ref[isize],
    all_calls: Ref[isize],
    flushes: Ref[isize],
    closes: Ref[isize],
    step: isize,
    fail_on: isize,
    mode: isize,
}

fn format_io_sink(step: isize, fail_on: isize, mode: isize) -> FormatIoSink {
    FormatIoSink {
        bytes: Vec::new(),
        calls: Ref::new(0),
        all_calls: Ref::new(0),
        flushes: Ref::new(0),
        closes: Ref::new(0),
        step,
        fail_on,
        mode,
    }
}

fn format_io_error(interrupted: bool) -> io::Error {
    io::Error::new(
        if interrupted {
            io::ErrorKind::Interrupted
        } else {
            io::ErrorKind::PermissionDenied
        },
        "format sink",
        Option::Some("original context"),
        Option::Some(47),
        "unknown side effect",
    )
}

impl Write for FormatIoSink {
    fn write(self: FormatIoSink, input: Slice[byte]) -> Result[isize, io::Error] {
        self.calls.set(self.calls.get() + 1);
        if self.calls.get() == self.fail_on {
            if self.mode == 0 {
                return Result::Ok(0)
            }
            self.bytes.push(input[0]);
            if self.mode == 1 {
                return Result::Ok(-1)
            }
            if self.mode == 2 {
                return Result::Ok(input.len() + 1)
            }
            if self.mode == 5 {
                return Result::Ok(-9223372036854775808)
            }
            if self.mode == 6 {
                return Result::Ok(9223372036854775807)
            }
            return Result::Err(format_io_error(self.mode == 3))
        }
        let count = if input.len() < self.step {
            input.len()
        } else {
            self.step
        };
        for index in 0..count {
            self.bytes.push(input[index]);
        }
        Result::Ok(count)
    }

    fn write_all(self: FormatIoSink, _input: Slice[byte]) -> Result[(), io::Error] {
        self.all_calls.set(self.all_calls.get() + 1);
        Result::Err(format_io_error(false))
    }

    fn flush(self: FormatIoSink) -> Result[(), io::Error] {
        self.flushes.set(self.flushes.get() + 1);
        Result::Ok(())
    }
}

impl Close for FormatIoSink {
    fn close(self: FormatIoSink) -> Result[(), io::Error] {
        self.closes.set(self.closes.get() + 1);
        Result::Ok(())
    }
}

fn format_io_primitive_only(sink: FormatIoSink) -> () {
    testing::assert_eq(sink.all_calls.get(), 0);
    testing::assert_eq(sink.flushes.get(), 0);
    testing::assert_eq(sink.closes.get(), 0);
}

pub fn test_format_io() -> () {
    for value in["", "ascii", "\u0000", "é中😀", "aé\u0000中😀z"] {
        for step in[1, 2, 3, 7, 100] {
            let sink = format_io_sink(step, 0, 0);
            let count = testing::expect_ok(format::write_to(sink, value), "short format write");
            testing::assert_eq(count, value.byte_len().to_usize());
            let expected = value.to_bytes();
            testing::assert_eq(sink.bytes.len(), expected.len());
            for index in 0..expected.len() {
                testing::assert_eq(sink.bytes[index], expected[index]);
            }
            testing::assert_eq(sink.calls.get(), (value.byte_len() + step - 1) / step);
            format_io_primitive_only(sink);
        }
    }
    for mode in[0, 1, 2, 3, 4, 5, 6] {
        let empty = format_io_sink(1, 1, mode);
        testing::assert_eq(
            testing::expect_ok(format::write_to(empty, ""), "empty no I/O"),
            0.to_usize(),
        );
        testing::assert_eq(empty.calls.get(), 0);
        format_io_primitive_only(empty);
        for fail_on in[1, 2, 4] {
            let sink = format_io_sink(1, fail_on, mode);
            let error = testing::expect_err(format::write_to(sink, "é中😀"), "format write failure");
            testing::assert_eq(error.transferred(), (fail_on - 1).to_usize());
            testing::assert_eq(sink.calls.get(), fail_on);
            testing::assert_eq(
                sink.bytes.len(),
                fail_on
                    - if mode == 0 {
                        1
                    } else {
                        0
                    },
            );
            let expected = "é中😀".to_bytes();
            for index in 0..sink.bytes.len() {
                testing::assert_eq(sink.bytes[index], expected[index]);
            }
            if mode == 3 || mode == 4 {
                testing::assert(error.error() == format_io_error(mode == 3));
            } else {
                testing::assert_eq(
                    error.error().kind(),
                    if mode == 0 {
                        io::ErrorKind::WriteZero
                    } else {
                        io::ErrorKind::InvalidData
                    },
                );
            }
            format_io_primitive_only(sink);
        }
    }
}
