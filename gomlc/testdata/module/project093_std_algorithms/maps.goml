package main;

use std::collections;
use std::ffi;
use std::iter;
use std::rand;
use std::testing;

#[go_ffi("maps", "Equal")]
extern fn go_maps_equal(left: ffi::RawMap[isize, isize], right: ffi::RawMap[isize, isize]) -> bool;

#[go_ffi("maps", "Clone")]
extern fn go_maps_clone(value: ffi::RawMap[isize, isize]) -> ffi::RawMap[isize, isize];

#[go_ffi("maps", "Copy")]
extern fn go_maps_copy(destination: ffi::RawMap[isize, isize], source: ffi::RawMap[isize, isize]) -> ();

struct CollisionKey {
    value: isize,
}

struct PairIterator {
    next_value: Ref[isize],
}

impl Iterator for PairIterator {
    type Item = (isize, isize);

    fn next(self: PairIterator) -> Option[(isize, isize)] {
        let value = self.next_value.get();
        if value < 10 {
            self.next_value.set(value + 1);
            Option::Some((value % 3, value))
        } else {
            Option::None
        }
    }
}

impl PartialEq for CollisionKey {
    fn eq(self: CollisionKey, other: CollisionKey) -> bool {
        self.value == other.value
    }
}

impl Eq for CollisionKey {}

impl Hash for CollisionKey {
    fn hash(self: CollisionKey) -> u64 {
        1
    }
}

fn check_map_reference(actual: HashMap[isize, isize], expected: ffi::RawMap[isize, isize]) -> () {
    assert_equal(actual.len(), ffi::map_len(expected));
    for key in -32..33 {
        assert_equal(actual.get(key), ffi::map_get(expected, key))
    }
}

fn check_maps() -> () {
    check_map_callback_contracts();
    let generated = PairIterator { next_value: Ref::new(0) };
    let generated_map = collections::map_collect(generated);
    assert_equal(generated_map.len(), 3);
    assert_equal(generated_map.get(0), Option::Some(9));
    assert_equal(generated_map.get(1), Option::Some(7));
    assert_equal(generated_map.get(2), Option::Some(8));
    assert_equal(generated.next_value.get(), 10);
    assert_equal(generated.next(), Option::None);
    let nan_values = HashMap::from_array([("nan", float64_from_bits(0x7ff8000000000000))]);
    testing::assert(!collections::map_equal(nan_values, nan_values));
    let empty: HashMap[string, isize] = HashMap::new();
    assert_equal(collections::map_clone(empty).len(), 0);
    testing::assert(collections::map_equal(empty, HashMap::new()));
    assert_equal(collections::map_all(empty).next(), Option::None);
    assert_equal(collections::map_keys(empty).next(), Option::None);
    assert_equal(collections::map_values(empty).next(), Option::None);
    assert_equal(collections::map_delete_if(empty, |_: string, _: isize| true), 0);
    let values = HashMap::from_array([("a", 1), ("b", 2)]);
    let copy = collections::map_clone(values);
    testing::assert(collections::map_equal(values, copy));
    copy.set("a", 3);
    testing::assert(!collections::map_equal(values, copy));
    assert_equal(values.get("a"), Option::Some(1));
    copy.remove("a");
    testing::assert(!collections::map_equal(values, copy));
    copy.set("c", 1);
    testing::assert(!collections::map_equal(values, copy));
    let strings = HashMap::from_array([("a", "1"), ("b", "2")]);
    testing::assert(
        collections::map_equal_by(
            values,
            strings,
            |left: isize, right: string| left.to_string() == right,
        ),
    );
    let calls = Ref::new(0);
    let unequal = collections::map_equal_by(
        values,
        empty,
        |_: isize, _: isize| {
            calls.set(calls.get() + 1);
            true
        },
    );
    testing::assert(!unequal);
    assert_equal(calls.get(), 0);
    let shared = Ref::new(7);
    let references = HashMap::from_array([("x", shared)]);
    let reference_copy = collections::map_clone(references);
    testing::expect_some(reference_copy.get("x"), "copied reference").set(9);
    assert_equal(testing::expect_some(references.get("x"), "original reference").get(), 9);
    reference_copy.set("x", Ref::new(11));
    assert_equal(testing::expect_some(references.get("x"), "independent entry").get(), 9);
    let all = collections::map_all(values);
    let keys = collections::map_keys(values);
    let old_values = collections::map_values(values);
    values.set("a", 10);
    values.remove("b");
    values.set("c", 30);
    let snapshot = collections::map_collect(all);
    assert_equal(snapshot.len(), 2);
    assert_equal(snapshot.get("a"), Option::Some(1));
    assert_equal(snapshot.get("b"), Option::Some(2));
    let key_values = iter::collect(keys);
    collections::sort(key_values);
    assert_equal(key_values, Vec::from_array(["a", "b"]));
    let value_values = iter::collect(old_values);
    collections::sort(value_values);
    assert_equal(value_values, Vec::from_array([1, 2]));
    assert_equal(all.next(), Option::None);
    collections::map_copy(values, values);
    assert_equal(values.len(), 2);
    collections::map_insert(values, Vec::from_array([("a", 5), ("a", 6), ("d", 7)]).iter());
    assert_equal(values.get("a"), Option::Some(6));
    assert_equal(values.get("d"), Option::Some(7));
    let collected = collections::map_collect(Vec::from_array([("a", 1), ("a", 2)]).iter());
    assert_equal(collected.len(), 1);
    assert_equal(collected.get("a"), Option::Some(2));
    let seen: HashMap[string, isize] = HashMap::new();
    assert_equal(
        collections::map_delete_if(
            values,
            |key: string, value: isize| {
                seen.set(key, value);
                values.set("inserted", 42);
                key != "a"
            },
        ),
        2,
    );
    assert_equal(seen.len(), 3);
    assert_equal(seen.get("inserted"), Option::None);
    assert_equal(values.get("a"), Option::Some(6));
    assert_equal(values.get("inserted"), Option::Some(42));
    let removed_in_callback = HashMap::from_array([("key", 1)]);
    assert_equal(
        collections::map_delete_if(
            removed_in_callback,
            |key: string, _: isize| {
                removed_in_callback.remove(key);
                true
            },
        ),
        0,
    );
    let replaced_in_callback = HashMap::from_array([("key", 1)]);
    assert_equal(
        collections::map_delete_if(
            replaced_in_callback,
            |key: string, _: isize| {
                replaced_in_callback.set(key, 2);
                true
            },
        ),
        1,
    );
    assert_equal(replaced_in_callback.len(), 0);
    let collisions: HashMap[CollisionKey, isize] = HashMap::new();
    for value in 0..100 {
        collisions.set(CollisionKey { value }, value * 2)
    }
    let collision_copy = collections::map_clone(collisions);
    testing::assert(collections::map_equal(collisions, collision_copy));
    assert_equal(
        collections::map_delete_if(collision_copy, |key: CollisionKey, _: isize| key.value % 2 == 0),
        50,
    );
    assert_equal(collisions.len(), 100);
    for value in 0..100 {
        assert_equal(collision_copy.contains(CollisionKey { value }), value % 2 != 0)
    }
    let actual: HashMap[isize, isize] = HashMap::new();
    let expected = ffi::map_new::[isize, isize]();
    let mut seed: u64 = 9871;
    for step in 0..512 {
        seed = rand::next_u64(seed);
        let key = (seed % 65).to_isize() - 32;
        let value = (seed >> 16).to_isize();
        actual.set(key, value);
        ffi::map_set(expected, key, value);
        let copied = collections::map_clone(actual);
        let reference = go_maps_clone(expected);
        testing::assert(
            collections::map_equal(actual, copied) == go_maps_equal(expected, reference),
        );
        check_map_reference(copied, reference);
        if step % 7 == 0 {
            let incoming = HashMap::from_array([(key, step), (-key, value)]);
            let reference_incoming = ffi::map_new::[isize, isize]();
            ffi::map_set(reference_incoming, key, step);
            ffi::map_set(reference_incoming, -key, value);
            collections::map_copy(actual, incoming);
            go_maps_copy(expected, reference_incoming);
        }
        if step % 11 == 0 {
            let count = collections::map_delete_if(actual, |key: isize, _: isize| key % 3 == 0);
            let before = ffi::map_len(expected);
            for candidate in -32..33 {
                if candidate % 3 == 0 {
                    ffi::map_delete(expected, candidate)
                }
            }
            assert_equal(count, before - ffi::map_len(expected));
        }
        check_map_reference(actual, expected);
    }
}

fn check_map_callback_contracts() -> () {
    let left = HashMap::from_array([(1, 0), (2, 0), (3, 0)]);
    let right = HashMap::from_array([(1, "zero"), (2, "zero"), (3, "zero")]);
    let calls = Ref::new(0);
    testing::assert(
        collections::map_equal_by(
            left,
            right,
            |a: isize, b: string| {
                calls.set(calls.get() + 1);
                a == 0 && b == "zero"
            },
        ),
    );
    assert_equal(calls.get(), 3);
    calls.set(0);
    testing::assert(
        !collections::map_equal_by(
            left,
            right,
            |_: isize, _: string| {
                calls.set(calls.get() + 1);
                false
            },
        ),
    );
    assert_equal(calls.get(), 1);
    calls.set(0);
    let disjoint = HashMap::from_array([(4, "zero"), (5, "zero"), (6, "zero")]);
    testing::assert(
        !collections::map_equal_by(
            left,
            disjoint,
            |_: isize, _: string| {
                calls.set(calls.get() + 1);
                true
            },
        ),
    );
    assert_equal(calls.get(), 0);
    let original = HashMap::from_array([(1, 10), (2, 20), (3, 30)]);
    let alias = original;
    let visited: HashMap[isize, isize] = HashMap::new();
    let deleted = collections::map_delete_if(
        original,
        |key: isize, value: isize| {
            visited.set(key, value);
            alias.remove(1);
            alias.remove(2);
            alias.remove(3);
            alias.set(4, 40);
            true
        },
    );
    assert_equal(deleted, 0);
    testing::assert(
        collections::map_equal(visited, HashMap::from_array([(1, 10), (2, 20), (3, 30)])),
    );
    testing::assert(collections::map_equal(original, HashMap::from_array([(4, 40)])));
    let nested = Vec::from_array([1, 2]);
    let source = HashMap::from_array([("shared", nested)]);
    let snapshot = collections::map_values(source);
    let cloned = collections::map_clone(source);
    source.remove("shared");
    nested.push(3);
    assert_equal(
        testing::expect_some(snapshot.next(), "snapshot shared value"),
        Vec::from_array([1, 2, 3]),
    );
    assert_equal(
        testing::expect_some(cloned.get("shared"), "clone shared value"),
        Vec::from_array([1, 2, 3]),
    );
    testing::assert(snapshot.next().is_none());
    cloned.set("shared", Vec::new());
    assert_equal(nested, Vec::from_array([1, 2, 3]));
    let destination = HashMap::from_array([(0, -1)]);
    let position = Ref::new(0);
    let entries = FnIterator::from_fn(
        || {
            let index = position.get();
            if index == 4 {
                return Option::None
            }
            position.set(index + 1);
            destination.set(index, -10);
            Option::Some((index % 2, index))
        },
    );
    collections::map_insert(destination, entries);
    assert_equal(position.get(), 4);
    testing::assert(entries.next().is_none());
    testing::assert(
        collections::map_equal(
            destination,
            HashMap::from_array([(0, 2), (1, 3), (2, -10), (3, -10)]),
        ),
    );
    let retained = collections::map_all(destination);
    collections::map_insert(destination, collections::map_all(destination));
    testing::assert(collections::map_equal(collections::map_collect(retained), destination));
}
