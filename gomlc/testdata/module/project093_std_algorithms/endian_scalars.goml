package main;

use std::bytes;
use std::bytes::endian;
use std::bytes::endian::stream;
use std::io;
use std::testing;

fn check_scalar_bytes(data: Vec[byte], bits: u64, order: endian::Endian) -> () {
    for index in 0..data.len() {
        let shift = match order {
            endian::Endian::Little => index * 8,
            endian::Endian::Big => (data.len() - index - 1) * 8,
        };
        assert_equal(data[index], (bits >> shift).to_u8());
    }
}

fn check_endian_scalars() -> () {
    let guard = Vec::from_array([165.to_u8()]);
    for offset in[-1, 1, 9223372036854775807] {
        testing::assert(endian::read_bool(guard.as_slice(), offset).is_err());
        testing::assert(endian::write_bool(guard.as_mut_slice(), offset, true).is_err());
        assert_equal(guard[0], 165.to_u8());
    }
    for raw in 0..256 {
        let input = Vec::from_array([raw.to_u8(), 42]);
        assert_equal(
            testing::expect_ok(endian::read_bool(input.as_slice(), 0), "bool byte"),
            raw != 0,
        );
        let cursor = io::Cursor::new(bytes::Bytes::from_vec(input));
        assert_equal(
            testing::expect_ok(stream::read_bool(cursor), "bool stream"),
            Option::Some(raw != 0),
        );
        assert_equal(
            testing::expect_ok(stream::read_u8(cursor), "following byte"),
            Option::Some(42),
        );
    }
    for order in[endian::Endian::Little, endian::Endian::Big] {
        for value in Vec::from_array([false, true]) {
            let expected: u64 = if value {
                1
            } else {
                0
            };
            let builder = endian::Builder::new();
            builder.write_bool(value);
            let data = builder.to_vec();
            check_scalar_bytes(data, expected, order);
            assert_equal(data.len(), 1);
            let reader = endian::Reader::new(data.as_slice());
            let alias = reader;
            let decoded = testing::expect_ok(reader.read_bool(), "scalar reader");
            assert_equal(
                if decoded {
                    1
                } else {
                    0
                },
                expected,
            );
            assert_equal(alias.position(), 1);
            testing::assert(reader.read_bool().is_err());
            assert_equal(reader.position(), 1);
            for length in 0..2 {
                let output: Vec[byte] = Vec::new();
                for _ in 0..3 {
                    output.push(165);
                }
                let writer = endian::Writer::new(output.as_mut_slice().sub(1, length + 1));
                let result = writer.write_bool(value);
                if length < 1 {
                    testing::assert(result.is_err());
                    assert_equal(writer.position(), 0);
                    for byte in output {
                        assert_equal(byte, 165.to_u8());
                    }
                } else {
                    testing::expect_ok(result, "scalar writer");
                    assert_equal(writer.position(), 1);
                    for index in 0..1 {
                        assert_equal(output[index + 1], data[index]);
                    }
                    assert_equal(output[0], 165.to_u8());
                    assert_equal(output[2], 165.to_u8());
                }
                let short_reader = endian::Reader::new(data.as_slice().sub(0, length));
                let result = short_reader.read_bool();
                assert_equal(result.is_ok(), length == 1);
                assert_equal(
                    short_reader.position(),
                    if length == 1 {
                        1
                    } else {
                        0
                    },
                );
            }
        }
        for value in Vec::from_array([-128, -1, 0, 127]) {
            let value = value.to_i8();
            let expected: u64 = value.to_u8().to_u64();
            let builder = endian::Builder::new();
            builder.write_i8(value);
            let data = builder.to_vec();
            check_scalar_bytes(data, expected, order);
            assert_equal(data.len(), 1);
            let reader = endian::Reader::new(data.as_slice());
            let alias = reader;
            let decoded = testing::expect_ok(reader.read_i8(), "scalar reader");
            assert_equal(decoded.to_u8().to_u64(), expected);
            assert_equal(alias.position(), 1);
            testing::assert(reader.read_i8().is_err());
            assert_equal(reader.position(), 1);
            for length in 0..2 {
                let output: Vec[byte] = Vec::new();
                for _ in 0..3 {
                    output.push(165);
                }
                let writer = endian::Writer::new(output.as_mut_slice().sub(1, length + 1));
                let result = writer.write_i8(value);
                if length < 1 {
                    testing::assert(result.is_err());
                    assert_equal(writer.position(), 0);
                    for byte in output {
                        assert_equal(byte, 165.to_u8());
                    }
                } else {
                    testing::expect_ok(result, "scalar writer");
                    assert_equal(writer.position(), 1);
                    for index in 0..1 {
                        assert_equal(output[index + 1], data[index]);
                    }
                    assert_equal(output[0], 165.to_u8());
                    assert_equal(output[2], 165.to_u8());
                }
                let short_reader = endian::Reader::new(data.as_slice().sub(0, length));
                let result = short_reader.read_i8();
                assert_equal(result.is_ok(), length == 1);
                assert_equal(
                    short_reader.position(),
                    if length == 1 {
                        1
                    } else {
                        0
                    },
                );
            }
        }
        for value in Vec::from_array([-32768, -1, 0, 32767]) {
            let value = value.to_i16();
            let expected: u64 = value.to_u16().to_u64();
            let builder = endian::Builder::new();
            builder.write_i16(value, order);
            let data = builder.to_vec();
            check_scalar_bytes(data, expected, order);
            assert_equal(data.len(), 2);
            let reader = endian::Reader::new(data.as_slice());
            let alias = reader;
            let decoded = testing::expect_ok(reader.read_i16(order), "scalar reader");
            assert_equal(decoded.to_u16().to_u64(), expected);
            assert_equal(alias.position(), 2);
            testing::assert(reader.read_i16(order).is_err());
            assert_equal(reader.position(), 2);
            for length in 0..3 {
                let output: Vec[byte] = Vec::new();
                for _ in 0..4 {
                    output.push(165);
                }
                let writer = endian::Writer::new(output.as_mut_slice().sub(1, length + 1));
                let result = writer.write_i16(value, order);
                if length < 2 {
                    testing::assert(result.is_err());
                    assert_equal(writer.position(), 0);
                    for byte in output {
                        assert_equal(byte, 165.to_u8());
                    }
                } else {
                    testing::expect_ok(result, "scalar writer");
                    assert_equal(writer.position(), 2);
                    for index in 0..2 {
                        assert_equal(output[index + 1], data[index]);
                    }
                    assert_equal(output[0], 165.to_u8());
                    assert_equal(output[3], 165.to_u8());
                }
                let short_reader = endian::Reader::new(data.as_slice().sub(0, length));
                let result = short_reader.read_i16(order);
                assert_equal(result.is_ok(), length == 2);
                assert_equal(
                    short_reader.position(),
                    if length == 2 {
                        2
                    } else {
                        0
                    },
                );
            }
        }
        for value in Vec::from_array([-2147483648, -1, 0, 2147483647]) {
            let value = value.to_i32();
            let expected: u64 = value.to_u32().to_u64();
            let builder = endian::Builder::new();
            builder.write_i32(value, order);
            let data = builder.to_vec();
            check_scalar_bytes(data, expected, order);
            assert_equal(data.len(), 4);
            let reader = endian::Reader::new(data.as_slice());
            let alias = reader;
            let decoded = testing::expect_ok(reader.read_i32(order), "scalar reader");
            assert_equal(decoded.to_u32().to_u64(), expected);
            assert_equal(alias.position(), 4);
            testing::assert(reader.read_i32(order).is_err());
            assert_equal(reader.position(), 4);
            for length in 0..5 {
                let output: Vec[byte] = Vec::new();
                for _ in 0..6 {
                    output.push(165);
                }
                let writer = endian::Writer::new(output.as_mut_slice().sub(1, length + 1));
                let result = writer.write_i32(value, order);
                if length < 4 {
                    testing::assert(result.is_err());
                    assert_equal(writer.position(), 0);
                    for byte in output {
                        assert_equal(byte, 165.to_u8());
                    }
                } else {
                    testing::expect_ok(result, "scalar writer");
                    assert_equal(writer.position(), 4);
                    for index in 0..4 {
                        assert_equal(output[index + 1], data[index]);
                    }
                    assert_equal(output[0], 165.to_u8());
                    assert_equal(output[5], 165.to_u8());
                }
                let short_reader = endian::Reader::new(data.as_slice().sub(0, length));
                let result = short_reader.read_i32(order);
                assert_equal(result.is_ok(), length == 4);
                assert_equal(
                    short_reader.position(),
                    if length == 4 {
                        4
                    } else {
                        0
                    },
                );
            }
        }
        for value in Vec::from_array([-9223372036854775807 - 1, -1, 0, 9223372036854775807]) {
            let value = value.to_i64();
            let expected: u64 = value.to_u64();
            let builder = endian::Builder::new();
            builder.write_i64(value, order);
            let data = builder.to_vec();
            check_scalar_bytes(data, expected, order);
            assert_equal(data.len(), 8);
            let reader = endian::Reader::new(data.as_slice());
            let alias = reader;
            let decoded = testing::expect_ok(reader.read_i64(order), "scalar reader");
            assert_equal(decoded.to_u64(), expected);
            assert_equal(alias.position(), 8);
            testing::assert(reader.read_i64(order).is_err());
            assert_equal(reader.position(), 8);
            for length in 0..9 {
                let output: Vec[byte] = Vec::new();
                for _ in 0..10 {
                    output.push(165);
                }
                let writer = endian::Writer::new(output.as_mut_slice().sub(1, length + 1));
                let result = writer.write_i64(value, order);
                if length < 8 {
                    testing::assert(result.is_err());
                    assert_equal(writer.position(), 0);
                    for byte in output {
                        assert_equal(byte, 165.to_u8());
                    }
                } else {
                    testing::expect_ok(result, "scalar writer");
                    assert_equal(writer.position(), 8);
                    for index in 0..8 {
                        assert_equal(output[index + 1], data[index]);
                    }
                    assert_equal(output[0], 165.to_u8());
                    assert_equal(output[9], 165.to_u8());
                }
                let short_reader = endian::Reader::new(data.as_slice().sub(0, length));
                let result = short_reader.read_i64(order);
                assert_equal(result.is_ok(), length == 8);
                assert_equal(
                    short_reader.position(),
                    if length == 8 {
                        8
                    } else {
                        0
                    },
                );
            }
        }
        for value in Vec::from_array(
            [
                float32_from_bits(0),
                float32_from_bits(2147483648),
                float32_from_bits(2139095040),
                float32_from_bits(2143289345),
            ],
        ) {
            let expected: u64 = value.to_bits().to_u64();
            let builder = endian::Builder::new();
            builder.write_f32(value, order);
            let data = builder.to_vec();
            check_scalar_bytes(data, expected, order);
            assert_equal(data.len(), 4);
            let reader = endian::Reader::new(data.as_slice());
            let alias = reader;
            let decoded = testing::expect_ok(reader.read_f32(order), "scalar reader");
            assert_equal(decoded.to_bits().to_u64(), expected);
            assert_equal(alias.position(), 4);
            testing::assert(reader.read_f32(order).is_err());
            assert_equal(reader.position(), 4);
            for length in 0..5 {
                let output: Vec[byte] = Vec::new();
                for _ in 0..6 {
                    output.push(165);
                }
                let writer = endian::Writer::new(output.as_mut_slice().sub(1, length + 1));
                let result = writer.write_f32(value, order);
                if length < 4 {
                    testing::assert(result.is_err());
                    assert_equal(writer.position(), 0);
                    for byte in output {
                        assert_equal(byte, 165.to_u8());
                    }
                } else {
                    testing::expect_ok(result, "scalar writer");
                    assert_equal(writer.position(), 4);
                    for index in 0..4 {
                        assert_equal(output[index + 1], data[index]);
                    }
                    assert_equal(output[0], 165.to_u8());
                    assert_equal(output[5], 165.to_u8());
                }
                let short_reader = endian::Reader::new(data.as_slice().sub(0, length));
                let result = short_reader.read_f32(order);
                assert_equal(result.is_ok(), length == 4);
                assert_equal(
                    short_reader.position(),
                    if length == 4 {
                        4
                    } else {
                        0
                    },
                );
            }
        }
        for value in Vec::from_array(
            [
                float64_from_bits(0),
                float64_from_bits(9223372036854775808),
                float64_from_bits(9218868437227405312),
                float64_from_bits(9221120237041090561),
            ],
        ) {
            let expected: u64 = value.to_bits();
            let builder = endian::Builder::new();
            builder.write_f64(value, order);
            let data = builder.to_vec();
            check_scalar_bytes(data, expected, order);
            assert_equal(data.len(), 8);
            let reader = endian::Reader::new(data.as_slice());
            let alias = reader;
            let decoded = testing::expect_ok(reader.read_f64(order), "scalar reader");
            assert_equal(decoded.to_bits(), expected);
            assert_equal(alias.position(), 8);
            testing::assert(reader.read_f64(order).is_err());
            assert_equal(reader.position(), 8);
            for length in 0..9 {
                let output: Vec[byte] = Vec::new();
                for _ in 0..10 {
                    output.push(165);
                }
                let writer = endian::Writer::new(output.as_mut_slice().sub(1, length + 1));
                let result = writer.write_f64(value, order);
                if length < 8 {
                    testing::assert(result.is_err());
                    assert_equal(writer.position(), 0);
                    for byte in output {
                        assert_equal(byte, 165.to_u8());
                    }
                } else {
                    testing::expect_ok(result, "scalar writer");
                    assert_equal(writer.position(), 8);
                    for index in 0..8 {
                        assert_equal(output[index + 1], data[index]);
                    }
                    assert_equal(output[0], 165.to_u8());
                    assert_equal(output[9], 165.to_u8());
                }
                let short_reader = endian::Reader::new(data.as_slice().sub(0, length));
                let result = short_reader.read_f64(order);
                assert_equal(result.is_ok(), length == 8);
                assert_equal(
                    short_reader.position(),
                    if length == 8 {
                        8
                    } else {
                        0
                    },
                );
            }
        }
    }
    for value in[false, true] {
        check_fixed_value(
            value,
            1,
            endian::Endian::Little,
            |writer: CopyWriter, value: bool| stream::write_bool(writer, value),
            |reader: FixedReader| stream::read_bool(reader),
            |value: bool| if value {
                1
            } else {
                0
            },
        );
    }
}
