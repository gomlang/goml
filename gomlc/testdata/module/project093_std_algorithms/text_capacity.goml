package main;

use std::text;
use std::bytes;
use std::testing;

fn check_text_capacity_failure(
    output: text::StringBuilder,
    additional: isize,
    max_bytes: isize,
    expected: bytes::TransformError,
) -> () {
    let before = output.values.copy();
    let capacity = output.capacity();
    match (output.reserve_checked(additional, max_bytes), expected) {
        (
            Err(bytes::TransformError::InvalidLimit(actual)),
            bytes::TransformError::InvalidLimit(value),
        ) => assert_equal(actual, value),
        (
            Err(bytes::TransformError::InvalidCount(actual)),
            bytes::TransformError::InvalidCount(value),
        ) => assert_equal(actual, value),
        (
            Err(bytes::TransformError::LimitExceeded(actual)),
            bytes::TransformError::LimitExceeded(value),
        ) => assert_equal(actual, value),
        (Err(bytes::TransformError::LengthOverflow), bytes::TransformError::LengthOverflow) => (),
        _ => testing::fail("unexpected reserve result"),
    }
    assert_equal(output.values, before);
    assert_equal(output.len(), before.len());
    assert_equal(output.capacity(), capacity);
}

fn check_text_capacity() -> () {
    let maximum = 9223372036854775807;
    for initial_capacity in[0, 1, 32] {
        for prefix in["", "abc", "界🙂"] {
            let output = text::StringBuilder::with_capacity(initial_capacity);
            testing::assert(output.capacity() >= initial_capacity);
            output.write_string(prefix);
            let alias = output;
            let snapshot = output.finish();
            let existing = output.capacity();
            testing::expect_ok(alias.reserve_checked(0, output.len()), "zero reservation");
            assert_equal(output.capacity(), existing);
            for invalid in[-1, -maximum - 1] {
                check_text_capacity_failure(
                    output,
                    0,
                    invalid,
                    bytes::TransformError::InvalidLimit(invalid),
                );
                check_text_capacity_failure(
                    output,
                    invalid,
                    invalid,
                    bytes::TransformError::InvalidLimit(invalid),
                );
                check_text_capacity_failure(
                    output,
                    invalid,
                    maximum,
                    bytes::TransformError::InvalidCount(invalid),
                );
            }
            check_text_capacity_failure(
                output,
                1,
                output.len(),
                bytes::TransformError::LimitExceeded(output.len()),
            );
            if output.len() > 0 {
                check_text_capacity_failure(
                    output,
                    0,
                    output.len() - 1,
                    bytes::TransformError::LimitExceeded(output.len() - 1),
                );
                check_text_capacity_failure(
                    output,
                    maximum,
                    maximum,
                    bytes::TransformError::LengthOverflow,
                );
                check_text_capacity_failure(
                    output,
                    maximum,
                    0,
                    bytes::TransformError::LengthOverflow,
                );
            }
            let additional = existing + 17;
            let requested = output.len() + additional;
            testing::expect_ok(alias.reserve_checked(additional, requested), "growth reservation");
            testing::assert(output.capacity() >= requested);
            assert_equal(alias.capacity(), output.capacity());
            assert_equal(output.finish(), prefix);
            assert_equal(output.len(), prefix.byte_len());
            let grown = output.capacity();
            testing::expect_ok(
                output.reserve_checked(additional, requested),
                "existing capacity reservation",
            );
            assert_equal(output.capacity(), grown);
            check_text_capacity_failure(
                output,
                additional,
                requested - 1,
                bytes::TransformError::LimitExceeded(requested - 1),
            );
            testing::expect_ok(
                alias.write_string_checked("🙂!", prefix.byte_len() + 5),
                "write after reservation",
            );
            assert_equal(output.finish(), prefix + "🙂!");
            assert_equal(output.capacity(), grown);
            assert_equal(snapshot, prefix);
            alias.clear();
            assert_equal(output.len(), 0);
            assert_equal(output.capacity(), grown);
            testing::expect_ok(
                output.reserve_checked(0, 0),
                "empty reservation with retained capacity",
            );
            assert_equal(output.capacity(), grown);
            assert_equal(snapshot, prefix);
        }
    }
}
