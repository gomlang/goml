package main;

use std::json;
use std::testing;

pub fn test_json_boundary_fixes() -> () {
    for input in["t😀", "n😀", "f😀", "tru😀", "fals😀", "[t😀]", "{\"x\":n😀}"] {
        let _ = testing::expect_err(json::parse(input), "invalid literal must return error");
    }
    let bool_result: Result[bool, string] = json::from_string("t😀");
    let _ = testing::expect_err(bool_result, "typed literal must return error");
    let null_result: Result[(), string] = json::from_string("n😀");
    let _ = testing::expect_err(null_result, "typed null must return error");
    for input in[
        "9223372036854775808",
        "18446744073709551616",
        "-9223372036854775809",
        "-18446744073709551616",
        "999999999999999999999999999999999",
        "",
        "-",
        "+1",
        "1.0",
        "1e0",
    ] {
        assert_equal(json::as_int(json::Value::Number(input)), Option::None);
    }
    for (input, expected) in[
        ("9223372036854775807", 9223372036854775807),
        ("-9223372036854775808", -9223372036854775807 - 1),
        ("0", 0),
        ("-0", 0),
        ("00012", 12),
        ("-00012", -12),
    ] {
        assert_equal(json::as_int(json::Value::Number(input)), Option::Some(expected));
    }
}
