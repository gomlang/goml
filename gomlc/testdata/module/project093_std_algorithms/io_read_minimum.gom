package main;

use std::io;
use io::Read;
use std::testing;

struct MinimumReader {
    data: Vec[byte],
    position: Ref[isize],
    calls: Ref[isize],
    widths: Vec[isize],
    chunk: isize,
    failure_at: isize,
    mode: isize,
}

fn minimum_reader(length: isize, chunk: isize, failure_at: isize, mode: isize) -> MinimumReader {
    let data = Vec::new();
    for index in 0..length {
        data.push((index + 1).to_u8());
    }
    MinimumReader {
        data,
        position: Ref::new(0),
        calls: Ref::new(0),
        widths: Vec::new(),
        chunk,
        failure_at,
        mode,
    }
}

fn minimum_read_error(kind: io::ErrorKind) -> io::Error {
    io::Error::new(
        kind,
        "minimum probe",
        Option::Some("source"),
        Option::Some(77),
        "injected failure",
    )
}

impl Read for MinimumReader {
    fn read(self: MinimumReader, buffer: MutSlice[byte]) -> Result[isize, io::Error] {
        self.calls.set(self.calls.get() + 1);
        self.widths.push(buffer.len());
        if self.position.get() == self.failure_at {
            if self.mode == 4 {
                return Result::Ok(0)
            }
            if buffer.len() > 0 {
                buffer[0] = 200;
                self.position.set(self.position.get() + 1);
            }
            return match self.mode {
                0 => Result::Err(minimum_read_error(io::ErrorKind::BrokenPipe)),
                1 => Result::Err(minimum_read_error(io::ErrorKind::Interrupted)),
                2 => Result::Ok(-1),
                _ => Result::Ok(buffer.len() + 1),
            }
        }
        let available = self.data.len() - self.position.get();
        let mut count = if buffer.len() < available {
            buffer.len()
        } else {
            available
        };
        if count > self.chunk {
            count = self.chunk;
        }
        for index in 0..count {
            buffer[index] = self.data[self.position.get() + index];
        }
        self.position.set(self.position.get() + count);
        Result::Ok(count)
    }
}

fn check_io_read_minimum() -> () {
    for length in 0..9 {
        for capacity in 0..9 {
            for minimum in 0..capacity + 1 {
                for chunk in 1..6 {
                    let reader = minimum_reader(length, chunk, -1, 0);
                    let alias = reader;
                    let output = Vec::new();
                    for _ in 0..capacity + 2 {
                        output.push(255.to_u8());
                    }
                    let mut expected = 0;
                    let mut calls = 0;
                    while expected < minimum {
                        let mut count = length - expected;
                        if count > capacity - expected {
                            count = capacity - expected;
                        }
                        if count > chunk {
                            count = chunk;
                        }
                        calls += 1;
                        if count == 0 {
                            break
                        }
                        expected += count;
                    }
                    match io::read_at_least(
                        reader,
                        output.as_mut_slice().sub(1, capacity + 1),
                        minimum,
                    ) {
                        Ok(count) => {
                            testing::assert(expected >= minimum);
                            assert_equal(count, expected);
                        },
                        Err(error) => {
                            testing::assert(expected < minimum);
                            assert_equal(error.transferred(), expected.to_usize());
                            assert_equal(error.error().kind(), io::ErrorKind::UnexpectedEof);
                        },
                    }
                    assert_equal(alias.position.get(), expected);
                    assert_equal(alias.calls.get(), calls);
                    assert_equal(output[0], 255.to_u8());
                    for index in 0..capacity + 1 {
                        assert_equal(
                            output[index + 1],
                            if index < expected {
                                (index + 1).to_u8()
                            } else {
                                255.to_u8()
                            },
                        );
                    }
                    let mut consumed = 0;
                    for width in reader.widths {
                        assert_equal(width, capacity - consumed);
                        let mut count = length - consumed;
                        if count > width {
                            count = width;
                        }
                        if count > chunk {
                            count = chunk;
                        }
                        consumed += count;
                    }
                }
            }
        }
    }
    for failure_at in 0..6 {
        for mode in 0..5 {
            let reader = minimum_reader(8, 1, failure_at, mode);
            let output = b"????????";
            let error = testing::expect_err(
                io::read_at_least(reader, output.as_mut_slice(), 6),
                "injected minimum failure",
            );
            assert_equal(error.transferred(), failure_at.to_usize());
            assert_equal(reader.calls.get(), failure_at + 1);
            if mode < 2 {
                assert_equal(
                    error.error(),
                    minimum_read_error(
                        if mode == 0 {
                            io::ErrorKind::BrokenPipe
                        } else {
                            io::ErrorKind::Interrupted
                        },
                    ),
                );
            } else {
                assert_equal(
                    error.error().kind(),
                    if mode == 4 {
                        io::ErrorKind::UnexpectedEof
                    } else {
                        io::ErrorKind::InvalidData
                    },
                );
            }
            assert_equal(
                reader.position.get(),
                failure_at
                    + if mode == 4 {
                        0
                    } else {
                        1
                    },
            );
            for index in 0..8 {
                assert_equal(
                    output[index],
                    if index < failure_at {
                        (index + 1).to_u8()
                    } else if index == failure_at && mode != 4 {
                        200.to_u8()
                    } else {
                        b'?'
                    },
                );
            }
        }
    }
    for minimum in[-9223372036854775807 - 1, -1, 4, 9223372036854775807] {
        let reader = minimum_reader(8, 1, 0, 1);
        let output = b"???";
        let error = testing::expect_err(
            io::read_at_least(reader, output.as_mut_slice(), minimum),
            "invalid minimum",
        );
        assert_equal(error.transferred(), 0.to_usize());
        assert_equal(error.error().kind(), io::ErrorKind::InvalidInput);
        assert_equal(reader.calls.get(), 0);
        assert_equal(output, b"???");
    }
    let reader = minimum_reader(8, 1, 0, 1);
    let output = b"???";
    assert_equal(
        testing::expect_ok(io::read_at_least(reader, output.as_mut_slice(), 0), "zero minimum"),
        0,
    );
    assert_equal(reader.calls.get(), 0);
    assert_equal(output, b"???");
}
