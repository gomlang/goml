package main;

use std::json;
use std::serde;
use serde::{Serialize, Deserialize, Serializer, Deserializer};
use std::testing;
use std::io;
use std::bytes;

struct JsonBadSerialize {
    mode: isize,
}

impl Serialize for JsonBadSerialize {
    fn serialize[S: Serializer](self: JsonBadSerialize, serializer: S) -> Result[(), string] {
        match self.mode {
            0 => Result::Ok(()),
            1 => {
                serializer.serialize_int(1)?;
                serializer.serialize_int(2)
            },
            2 => {
                serializer.begin_sequence(1)?;
                serializer.end_sequence()
            },
            3 => {
                serializer.begin_sequence(1)?;
                serializer.serialize_int(1)
            },
            4 => {
                serializer.begin_map(1)?;
                serializer.begin_map_value(0)
            },
            5 => {
                serializer.begin_map(1)?;
                serializer.begin_map_key(0)?;
                serializer.serialize_int(1)
            },
            6 => {
                serializer.begin_optional(true)?;
                serializer.end_optional()
            },
            7 => {
                serializer.begin_tuple(1)?;
                serializer.begin_tuple_element(1)
            },
            8 => {
                let _ = serializer.end_sequence();
                Result::Ok(())
            },
            9 => serializer.serialize_number("01"),
            10 => {
                serializer.begin_struct("X", -1)
            },
            11 => {
                let empty: Vec[byte] = Vec::new();
                let _ = serializer.serialize_extension(0.to_i8(), empty.as_slice());
                serializer.serialize_int(1)
            },
            _ => Result::Err("custom serializer failed"),
        }
    }
}

struct JsonBadDeserialize {}

impl Deserialize for JsonBadDeserialize {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[JsonBadDeserialize, string] {
        let mode = deserializer.deserialize_int()?;
        match mode {
            0 => {
                let _ = deserializer.deserialize_int();
            },
            1 => {
                let _ = deserializer.end_sequence();
            },
            2 => {
                let _ = deserializer.begin_map_value();
            },
            3 => {
                let _ = deserializer.deserialize_extension();
            },
            _ => {
                let _ = deserializer.error("custom deserializer failed");
            },
        }
        Result::Ok(JsonBadDeserialize {})
    }
}

struct JsonIncomplete {}

impl Deserialize for JsonIncomplete {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[JsonIncomplete, string] {
        let _ = deserializer.begin_sequence()?;
        Result::Ok(JsonIncomplete {})
    }
}

struct JsonEscapedDecoder {
    read: () -> Result[isize, string],
}

impl Deserialize for JsonEscapedDecoder {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[JsonEscapedDecoder, string] {
        let _ = deserializer.deserialize_int()?;
        Result::Ok(JsonEscapedDecoder { read: || deserializer.deserialize_int() })
    }
}

struct JsonEscapedEncoder {
    write: Ref[() -> Result[(), string]],
}

impl Serialize for JsonEscapedEncoder {
    fn serialize[S: Serializer](self: JsonEscapedEncoder, serializer: S) -> Result[(), string] {
        self.write.set(|| serializer.serialize_int(2));
        serializer.serialize_int(1)
    }
}

struct JsonStringMap {
    entries: Vec[(string, isize)],
}

impl Serialize for JsonStringMap {
    fn serialize[S: Serializer](self: JsonStringMap, serializer: S) -> Result[(), string] {
        serializer.begin_map(self.entries.len())?;
        for index in 0..self.entries.len() {
            serializer.begin_map_key(index)?;
            serializer.serialize_string(self.entries[index].0)?;
            serializer.begin_map_value(index)?;
            serializer.serialize_int(self.entries[index].1)?;
        }
        serializer.end_map()
    }
}

impl Deserialize for JsonStringMap {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[JsonStringMap, string] {
        let _ = deserializer.begin_map()?;
        let entries = Vec::new();
        while deserializer.next_map_entry()? {
            deserializer.begin_map_key()?;
            let key = deserializer.deserialize_string()?;
            deserializer.begin_map_value()?;
            entries.push((key, deserializer.deserialize_int()?));
        }
        deserializer.end_map()?;
        Result::Ok(JsonStringMap { entries })
    }
}

struct JsonAny {
    value: serde::Value,
}

impl Deserialize for JsonAny {
    fn deserialize[D: Deserializer](deserializer: D) -> Result[JsonAny, string] {
        Result::Ok(JsonAny { value: deserializer.deserialize_any()? })
    }
}

fn test_json_stream_protocol() -> () {
    for mode in 0..13 {
        let output = io::Cursor::new(bytes::Bytes::new());
        let encoder = testing::expect_ok(
            json::Encoder::new(output, json_encode_limits()),
            "protocol encoder",
        );
        let error = testing::expect_err(
            encoder.encode(JsonBadSerialize { mode }),
            "invalid serialize protocol",
        );
        testing::assert_eq(error.kind(), json::ErrorKind::Schema);
        let written = encoder.written();
        testing::assert_eq(
            testing::expect_err(encoder.encode(1), "terminal encoder").kind(),
            error.kind(),
        );
        testing::assert_eq(encoder.written(), written);
    }
    for input in["0", "1", "2", "3", "4"] {
        let _ = json_typed_reject::[JsonBadDeserialize](input, json::ErrorKind::Schema);
    }
    let _ = json_typed_reject::[JsonIncomplete]("[]", json::ErrorKind::Schema);
    let decoder = json_decode_new(
        json_decode_probe("1 2".to_bytes(), 1, 0, 0),
        json_decode_limits(),
    );
    let escaped: Option[JsonEscapedDecoder] = testing::expect_ok(decoder.decode(), "escaped decode");
    let escaped = testing::expect_some(escaped, "escaped value");
    testing::assert_err((escaped.read)());
    let result: Result[Option[isize], json::Error] = decoder.decode();
    testing::assert_eq(
        testing::expect_err(result, "expired decoder lease").kind(),
        json::ErrorKind::State,
    );
    let callback: Ref[() -> Result[(), string]] = Ref::new(|| Result::Ok(()));
    let encoder = testing::expect_ok(
        json::Encoder::new(io::Cursor::new(bytes::Bytes::new()), json_encode_limits()),
        "escaped encoder",
    );
    testing::expect_ok(encoder.encode(JsonEscapedEncoder { write: callback }), "escaped encode");
    testing::assert_err((callback.get())());
    testing::assert_eq(
        testing::expect_err(encoder.encode(3), "expired encoder lease").kind(),
        json::ErrorKind::State,
    );
    let input = "{\"a\":1,\"中\":2,\"a\":3}";
    let map: JsonStringMap = testing::expect_ok(
        json::from_string_with_limits(input, json_decode_limits()),
        "stream map",
    );
    testing::assert_eq(map.entries.len(), 3);
    testing::assert_eq(
        testing::expect_ok(
            json::to_string_with_limits(map, json_encode_limits()),
            "stream map encode",
        ),
        input,
    );
    let any: JsonAny = testing::expect_ok(
        json::from_string_with_limits("{\"x\":[1.00e+2,true,null]}", json_decode_limits()),
        "stream any",
    );
    testing::assert_eq(
        testing::expect_ok(
            json::to_string_with_limits(any.value, json_encode_limits()),
            "stream any encode",
        ),
        "{\"x\":[1.00e+2,true,null]}",
    );
}
