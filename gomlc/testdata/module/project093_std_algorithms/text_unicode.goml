package main;

use std::text;
use std::unicode;
use std::testing;
use std::ffi;

#[go_ffi("strings", "Fields")]
extern fn go_text_fields(value: string) -> ffi::RawSlice[string];

#[go_ffi("example.com/goml-std-algorithms/native", "TextFieldsBy")]
extern fn go_text_fields_by(value: string) -> ffi::RawSlice[string];

#[go_ffi("strings", "TrimSpace")]
extern fn go_text_trim_space(value: string) -> string;

#[go_ffi("example.com/goml-std-algorithms/native", "TextTrimBy")]
extern fn go_text_trim_by(value: string) -> string;

#[go_ffi("example.com/goml-std-algorithms/native", "TextTrimStartBy")]
extern fn go_text_trim_start_by(value: string) -> string;

#[go_ffi("example.com/goml-std-algorithms/native", "TextTrimEndBy")]
extern fn go_text_trim_end_by(value: string) -> string;

#[go_ffi("strings", "Trim")]
extern fn go_text_trim_chars(value: string, characters: string) -> string;

#[go_ffi("strings", "EqualFold")]
extern fn go_text_equal_fold(left: string, right: string) -> bool;

fn check_text_fields_case(value: string) -> () {
    let expected = go_text_fields(value).as_slice().to_vec();
    check_text_iterator(text::fields_iter(value), expected);
    assert_equal(
        testing::expect_ok(text::fields(value, expected.len()), "bounded fields"),
        expected,
    );
    if expected.len() > 0 {
        testing::assert(text::fields(value, expected.len() - 1).is_err());
    }
    assert_equal(text::trim_space(value), go_text_trim_space(value));
    let separator = |character: char| character == ',' || character == '界' || character == '🙂';
    let custom = go_text_fields_by(value).as_slice().to_vec();
    check_text_iterator(text::fields_by_iter(value, separator), custom);
    assert_equal(
        testing::expect_ok(text::fields_by(value, separator, custom.len()), "predicate fields"),
        custom,
    );
    assert_equal(text::trim_by(value, separator), go_text_trim_by(value));
    assert_equal(text::trim_start_by(value, separator), go_text_trim_start_by(value));
    assert_equal(text::trim_end_by(value, separator), go_text_trim_end_by(value));
    for cutset in["", "a", " ,", "🙂界", "éé界", "ab"] {
        assert_equal(text::trim_chars(value, cutset), go_text_trim_chars(value, cutset));
    }
}

fn check_text_unicode() -> () {
    let nul = char_from_u32(0).unwrap_or(' ').to_string();
    let samples = ["", "abc", "a,b", "  a  b  ", "\t\n\r", "界a🙂b界", "🙂🙂", "éaé", "a\nb\r\nc", nul];
    for left in samples {
        for right in samples {
            check_text_fields_case(left + right);
        }
    }
    let spaces = testing::expect_some(unicode::property("White_Space"), "whitespace table");
    for range in spaces.ranges() {
        for code in range.low.to_isize()..range.high.to_isize() + 1 {
            if spaces.contains_codepoint(code.to_u32()) {
                let space = testing::expect_some(char_from_u32(code.to_u32()), "space scalar").to_string();
                check_text_fields_case(space + "a" + space + "界" + space);
                check_text_fields_case(space + space);
            }
        }
    }
    for code in[0x200b, 0xfeff, 0x180e] {
        let nonspace = testing::expect_some(char_from_u32(code.to_u32()), "nonspace scalar").to_string();
        check_text_fields_case(nonspace + "x" + nonspace);
    }
    let folds = [
        "",
        "Straße",
        "STRASSE",
        "ß",
        "ẞ",
        "ſ",
        "s",
        "S",
        "K",
        "k",
        "K",
        "Σ",
        "σ",
        "ς",
        "İ",
        "i",
        "I",
        "ı",
        "ﬀ",
        "ff",
        "é",
        "é",
        nul,
    ];
    for left in folds {
        for right in folds {
            assert_equal(text::equal_fold(left, right), go_text_equal_fold(left, right));
        }
    }
    for code in 0..0x10000 {
        if let Some(character) = char_from_u32(code.to_u32()) {
            let upper = unicode::to_uppercase(character);
            if upper != character {
                let first = character.to_string();
                let second = upper.to_string();
                assert_equal(text::equal_fold(first, second), go_text_equal_fold(first, second));
            }
        }
    }
    let visits = Ref::new(0);
    let predicate = |character: char| {
        visits.set(visits.get() + 1);
        character == ' ' || character == ','
    };
    let iterator = text::fields_by_iter(" a,b ", predicate);
    assert_equal(visits.get(), 0);
    assert_equal(iterator.next(), Option::Some("a"));
    assert_equal(visits.get(), 3);
    assert_equal(iterator.next(), Option::Some("b"));
    assert_equal(visits.get(), 5);
    testing::assert(iterator.next().is_none());
    testing::assert(iterator.next().is_none());
    assert_equal(visits.get(), 5);
    testing::assert(text::fields_by("x", predicate, -1).is_err());
    assert_equal(visits.get(), 5);
    assert_equal(testing::expect_ok(text::fields("  ", 0), "zero fields"), Vec::new());
    testing::assert(text::fields("x", 0).is_err());
    testing::assert(!text::equal_fold("ß", "ss"));
    assert_equal(unicode::case_fold("ß"), "ss");
    let nbsp = testing::expect_some(char_from_u32(0xa0), "nbsp").to_string();
    let padded = nbsp + "x" + nbsp;
    assert_equal(text::trim(padded), padded);
    assert_equal(text::trim_space(padded), "x");
}
