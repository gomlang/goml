package main;

use std::text;
use std::testing;

#[go_ffi("example.com/goml-std-algorithms/native", "UnquoteElement")]
extern fn go_unquote_element(value: string, delimiter: byte) -> (u32, bool, string, bool);

fn check_quote_element(value: string) -> () {
    for (context, delimiter) in[
        (text::QuoteContext::Unquoted, 0.to_u8()),
        (text::QuoteContext::Single, b'\''),
        (text::QuoteContext::Double, b'"'),
    ] {
        let (code, scalar, tail, valid) = go_unquote_element(value, delimiter);
        let actual = text::unquote_element(value, context);
        assert_equal(actual.is_ok(), valid);
        match actual {
            Ok((element, remaining)) => {
                assert_equal(remaining, tail);
                match element {
                    Byte(byte_value) => {
                        testing::assert(!scalar);
                        assert_equal(byte_value.to_u32(), code);
                    },
                    Scalar(character) => {
                        testing::assert(scalar);
                        assert_equal(character.to_u32(), code);
                    },
                }
            },
            Err(text::UnquoteError::Syntax(offset)) => assert_equal(offset, 0),
            _ => testing::fail("unexpected element error"),
        }
    }
}

fn check_quote_elements() -> () {
    for value in[
        "",
        "a",
        "'",
        "\"",
        "`",
        "\n",
        "\r",
        "\\",
        "\\x",
        "\\x0",
        "\\xff",
        "\\u0041",
        "\\u0000",
        "\\uD800",
        "\\uDFFF",
        "\\uffff",
        "\\U0010ffff",
        "\\U00110000",
        "\\Uffffffff",
        "\\u12xz",
        "\\U123",
        "界",
        "🙂",
        "\\'",
        "\\\"",
        "\\\\",
        "\\q",
    ] {
        check_quote_element(value);
        check_quote_element(value + "tail界\\");
    }
    for code in 0..256 {
        let value = testing::expect_some(char_from_u32(code.to_u32()), "Latin-1 element").to_string();
        check_quote_element(value + "tail");
        check_quote_element("\\" + value + "tail");
    }
    for code in 0..512 {
        check_quote_element(f"\\{code / 64}{(code / 8) % 8}{code % 8}tail");
    }
    let mut code: u32 = 256;
    while code <= 1114111 {
        if let Some(character) = char_from_u32(code) {
            check_quote_element(character.to_string() + "tail");
        }
        code += 997;
    }
    let value = "\\xff\\u0041界\\n";
    let mut remaining = value;
    let mut count = 0;
    while remaining.byte_len() != 0 {
        let (_, tail) = testing::expect_ok(
            text::unquote_element(remaining, text::QuoteContext::Unquoted),
            "element sequence",
        );
        testing::assert(tail.byte_len() < remaining.byte_len());
        remaining = tail;
        count += 1;
    }
    assert_equal(count, 4);
}
