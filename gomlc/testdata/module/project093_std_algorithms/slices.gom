package main;

use std::cmp;
use std::collections;
use std::ffi;
use std::rand;
use std::testing;

#[go_ffi("slices", "Equal")]
extern fn go_slice_equal(left: Slice[isize], right: Slice[isize]) -> bool;

#[go_ffi("slices", "Compare")]
extern fn go_slice_compare(left: Slice[isize], right: Slice[isize]) -> isize;

#[go_ffi("slices", "Index")]
extern fn go_slice_index(values: Slice[isize], expected: isize) -> isize;

#[go_ffi("slices", "Repeat")]
extern fn go_slice_repeat(values: Slice[isize], count: isize) -> ffi::RawSlice[isize];

#[go_ffi("slices", "Delete")]
extern fn go_slice_delete(values: MutSlice[isize], start: isize, end: isize) -> ffi::RawSlice[isize];

#[go_ffi("slices", "Replace")]
extern fn go_slice_replace_two(
    values: MutSlice[isize],
    start: isize,
    end: isize,
    first: isize,
    second: isize,
) -> ffi::RawSlice[isize];

#[go_ffi("slices", "Compact")]
extern fn go_slice_compact(values: MutSlice[isize]) -> ffi::RawSlice[isize];

fn check_slices() -> () {
    check_slice_overlap_matrix();
    let empty: Vec[isize] = Vec::new();
    assert_equal(collections::slice_min(empty.as_slice()), Option::None);
    assert_equal(collections::slice_max(empty.as_slice()), Option::None);
    assert_equal(collections::slice_binary_search(empty.as_slice(), 1), (0, false));
    collections::slice_reverse(empty.as_mut_slice());
    collections::slice_sort(empty.as_mut_slice());
    testing::assert(collections::slice_is_sorted(empty.as_slice()));
    assert_equal(collections::slice_collect(empty.iter()), empty);
    let tied = Vec::from_array([(2, "first"), (1, "low"), (2, "second")]);
    assert_equal(
        collections::slice_max_by(
            tied.as_slice(),
            |left: (isize, string), right: (isize, string)| left.0 - right.0,
        ),
        Option::Some((2, "first")),
    );
    assert_equal(
        collections::slice_min_by(
            tied.as_slice(),
            |left: (isize, string), right: (isize, string)| left.0 - right.0,
        ),
        Option::Some((1, "low")),
    );
    collections::slice_sort_by(
        tied.as_mut_slice(),
        |left: (isize, string), right: (isize, string)| left.0 - right.0,
    );
    assert_equal(tied, Vec::from_array([(1, "low"), (2, "first"), (2, "second")]));
    let huge: isize = 9223372036854775807;
    testing::assert(collections::slice_repeat(empty.as_slice(), -1).is_err());
    assert_equal(
        testing::expect_ok(collections::slice_repeat(empty.as_slice(), huge), "empty repeat").len(),
        0,
    );
    let original = Vec::from_array([0, 1, 2, 3, 4]);
    let alias = original;
    testing::expect_ok(
        collections::vec_replace(original, 1, 4, original.slice(0, 2)),
        "overlapping replacement",
    );
    assert_equal(alias, Vec::from_array([0, 0, 1, 4]));
    testing::expect_ok(
        collections::vec_insert_slice(original, 2, original.as_slice()),
        "self insertion",
    );
    assert_equal(alias, Vec::from_array([0, 0, 0, 0, 1, 4, 1, 4]));
    let before = original.copy();
    for (start, end) in Vec::from_array([(-1, 1), (3, 2), (0, 9), (9, 9), (huge, huge)]) {
        testing::assert(
            collections::vec_replace(original, start, end, original.as_slice()).is_err(),
        );
        assert_equal(original, before);
    }
    testing::assert(collections::vec_grow(original, -1).is_err());
    testing::assert(collections::vec_grow(original, huge).is_err());
    assert_equal(original, before);
    testing::expect_ok(collections::vec_grow(original, 32), "grow capacity");
    testing::assert(original.capacity() >= original.len() + 32);
    assert_equal(original, before);
    testing::assert(collections::slice_repeat(original.as_slice(), huge).is_err());
    match collections::slice_repeat(original.as_slice(), huge) {
        Result::Err(collections::SequenceError::LengthOverflow) => (),
        _ => testing::fail("wrong repeat overflow error"),
    }
    match collections::vec_delete_range(original, -1, 0) {
        Result::Err(collections::SequenceError::InvalidRange(start, end, length)) => {
            assert_equal((start, end, length), (-1, 0, original.len()));
        },
        _ => testing::fail("wrong range error"),
    }
    let items = Vec::from_array([5, 4, 3, 2, 1, 0]);
    collections::slice_sort(items.slice_mut(1, 5));
    assert_equal(items, Vec::from_array([5, 1, 2, 3, 4, 0]));
    collections::slice_reverse(items.slice_mut(1, 5));
    assert_equal(items, Vec::from_array([5, 4, 3, 2, 1, 0]));
    testing::assert(
        collections::slice_is_sorted_by(items.as_slice(), |left: isize, right: isize| right - left),
    );
    assert_equal(
        collections::slice_binary_search_by(items.as_slice(), |value: isize| 3 - value),
        (2, true),
    );
    let view = items.slice(1, 5);
    let all = collections::slice_all(view);
    let backward = collections::slice_backward(view);
    items[1] = 40;
    assert_equal(all.next(), Option::Some((0, 40)));
    assert_equal(backward.next(), Option::Some((3, 1)));
    let chunks = testing::expect_ok(collections::slice_chunks(view, 3), "chunks");
    assert_equal(
        testing::expect_some(chunks.next(), "first chunk").to_vec(),
        Vec::from_array([40, 3, 2]),
    );
    assert_equal(testing::expect_some(chunks.next(), "last chunk").to_vec(), Vec::from_array([1]));
    testing::assert(chunks.next().is_none());
    testing::assert(chunks.next().is_none());
    testing::assert(collections::slice_chunks(view, 0).is_err());
    testing::assert(collections::slice_chunks(view, -1).is_err());
    match collections::slice_chunks(view, 0) {
        Result::Err(collections::SequenceError::InvalidCount(count)) => assert_equal(count, 0),
        _ => testing::fail("wrong chunk count error"),
    }
    let big_chunk = testing::expect_ok(collections::slice_chunks(view, huge), "huge chunk size");
    assert_equal(testing::expect_some(big_chunk.next(), "whole view").to_vec(), view.to_vec());
    testing::assert(big_chunk.next().is_none());
    let empty_chunks = testing::expect_ok(
        collections::slice_chunks(empty.as_slice(), 1),
        "empty chunks",
    );
    testing::assert(empty_chunks.next().is_none());
    assert_equal(
        collections::slice_collect(collections::slice_all(view)),
        Vec::from_array([(0, 40), (1, 3), (2, 2), (3, 1)]),
    );
    assert_equal(
        collections::slice_collect(collections::slice_backward(view)),
        Vec::from_array([(3, 1), (2, 2), (1, 3), (0, 40)]),
    );
    let collected = collections::slice_sorted(view.iter());
    assert_equal(collected, Vec::from_array([1, 2, 3, 40]));
    assert_equal(
        collections::slice_sorted_by(view.iter(), |left: isize, right: isize| right - left),
        Vec::from_array([40, 3, 2, 1]),
    );
    collections::vec_append_iter(collected.iter(), collected);
    assert_equal(collected, Vec::from_array([1, 2, 3, 40, 1, 2, 3, 40]));
    let references = Vec::from_array([Ref::new(1)]);
    let repeated = testing::expect_ok(
        collections::slice_repeat(references.as_slice(), 2),
        "shallow repeat",
    );
    repeated[1].set(9);
    assert_equal(references[0].get(), 9);
    repeated[0] = Ref::new(4);
    assert_equal(references[0].get(), 9);
    let numbers = Vec::from_array([1, 2]);
    let words = Vec::from_array(["1", "2"]);
    testing::assert(
        collections::slice_equal_by(
            numbers.as_slice(),
            words.as_slice(),
            |left: isize, right: string| left.to_string() == right,
        ),
    );
    assert_equal(
        collections::slice_compare_by(
            numbers.as_slice(),
            words.as_slice(),
            |left: isize, right: string| cmp::compare(left.to_string(), right),
        ),
        cmp::Ordering::Equal,
    );
    let nan = Vec::from_array([float64_from_bits(0x7ff8000000000000)]);
    testing::assert(!collections::slice_equal(nan.as_slice(), nan.as_slice()));
    let mut seed: u64 = 513;
    for length in 0..65 {
        let values: Vec[isize] = Vec::new();
        for _ in 0..length {
            seed = rand::next_u64(seed);
            values.push((seed % 11).to_isize() - 5)
        }
        for start in 0..length + 1 {
            let view = values.slice(start, length);
            assert_equal(
                collections::slice_equal(values.as_slice(), view),
                go_slice_equal(values.as_slice(), view),
            );
            assert_equal(
                collections::slice_compare(values.as_slice(), view).to_isize(),
                go_slice_compare(values.as_slice(), view),
            );
            for expected in -6..7 {
                let found = go_slice_index(view, expected);
                let index = if found < 0 {
                    Option::None
                } else {
                    Option::Some(found)
                };
                assert_equal(collections::slice_index(view, expected), index);
                assert_equal(
                    collections::slice_index_by(view, |value: isize| value == expected),
                    index,
                );
                assert_equal(collections::slice_contains(view, expected), found >= 0);
                assert_equal(
                    collections::slice_contains_by(view, |value: isize| value == expected),
                    found >= 0,
                );
            }
            for count in 0..4 {
                let actual = testing::expect_ok(collections::slice_repeat(view, count), "repeat");
                assert_equal(actual, go_slice_repeat(view, count).as_slice().to_vec());
            }
            let concatenated = testing::expect_ok(
                collections::slice_concat(Vec::from_array([values.slice(0, start), view])),
                "concat",
            );
            assert_equal(concatenated, values);
            for end in start..length + 1 {
                let actual = values.copy();
                let expected = values.copy();
                let reference = go_slice_delete(expected.as_mut_slice(), start, end).as_slice().to_vec();
                testing::expect_ok(
                    collections::vec_delete_range(actual, start, end),
                    "delete range",
                );
                assert_equal(actual, reference);
                let actual = values.copy();
                let expected = values.copy();
                let reference = go_slice_replace_two(expected.as_mut_slice(), start, end, 17, 18).as_slice().to_vec();
                testing::expect_ok(
                    collections::vec_replace(
                        actual,
                        start,
                        end,
                        Vec::from_array([17, 18]).as_slice(),
                    ),
                    "replace range",
                );
                assert_equal(actual, reference);
            }
        }
        let compacted = values.copy();
        let reference = values.copy();
        compacted.dedup();
        assert_equal(compacted, go_slice_compact(reference.as_mut_slice()).as_slice().to_vec());
        let selected = values.copy();
        let expected: Vec[isize] = Vec::new();
        for value in values {
            if value >= 0 {
                expected.push(value)
            }
        }
        assert_equal(
            collections::vec_delete_if(selected, |value: isize| value < 0),
            values.len() - expected.len(),
        );
        assert_equal(selected, expected);
        let sorted = values.copy();
        collections::slice_sort(sorted.as_mut_slice());
        testing::assert(collections::slice_is_sorted(sorted.as_slice()));
        assert_equal(collections::slice_min(values.as_slice()), sorted.get_checked(0));
        assert_equal(collections::slice_max(values.as_slice()), sorted.last());
        for expected in -6..7 {
            let (index, found) = collections::slice_binary_search(sorted.as_slice(), expected);
            assert_equal(index, go_search_ints(sorted.as_slice(), expected));
            assert_equal(found, index < sorted.len() && sorted[index] == expected);
        }
    }
}

fn check_slice_overlap_matrix() -> () {
    for length in 0..8 {
        let source: Vec[isize] = Vec::new();
        for index in 0..length {
            source.push(index);
        }
        for start in 0..length + 1 {
            for end in start..length + 1 {
                for from in 0..length + 1 {
                    for until in from..length + 1 {
                        let expected: Vec[isize] = Vec::new();
                        for index in 0..start {
                            expected.push(source[index]);
                        }
                        for index in from..until {
                            expected.push(source[index]);
                        }
                        for index in end..length {
                            expected.push(source[index]);
                        }
                        let actual = source.copy();
                        let alias = actual;
                        testing::expect_ok(
                            collections::vec_replace(actual, start, end, actual.slice(from, until)),
                            "self overlap matrix",
                        );
                        assert_equal(actual, expected);
                        assert_equal(alias, expected);
                    }
                }
            }
        }
        for size in 1..length + 3 {
            let values = source.copy();
            let chunks = testing::expect_ok(
                collections::slice_chunks(values.as_slice(), size),
                "chunk partition",
            );
            let mut offset = 0;
            while let Some(chunk) = chunks.next() {
                testing::assert(chunk.len() > 0 && chunk.len() <= size);
                values[offset] = -1;
                assert_equal(chunk[0], -1);
                for index in 1..chunk.len() {
                    assert_equal(chunk[index], offset + index);
                }
                offset += chunk.len();
            }
            assert_equal(offset, length);
            testing::assert(chunks.next().is_none());
        }
    }
    let source = Vec::from_array([1, 2, 3]);
    let first = collections::slice_all(source.as_slice());
    let second = first;
    assert_equal(first.next(), Option::Some((0, 1)));
    source[1] = 20;
    assert_equal(second.next(), Option::Some((1, 20)));
    assert_equal(first.next(), Option::Some((2, 3)));
    testing::assert(second.next().is_none());
    let independent = collections::slice_all(source.as_slice());
    assert_equal(independent.next(), Option::Some((0, 1)));
    let calls = Ref::new(0);
    let short = Vec::from_array([1]);
    testing::assert(
        !collections::slice_equal_by(
            source.as_slice(),
            short.as_slice(),
            |_: isize, _: isize| {
                calls.set(calls.get() + 1);
                true
            },
        ),
    );
    assert_equal(calls.get(), 0);
    testing::assert(
        !collections::slice_equal_by(
            source.as_slice(),
            source.as_slice(),
            |_: isize, _: isize| {
                calls.set(calls.get() + 1);
                false
            },
        ),
    );
    assert_equal(calls.get(), 1);
    let visited: Vec[isize] = Vec::new();
    assert_equal(
        collections::vec_delete_if(
            source,
            |value: isize| {
                visited.push(value);
                value == 20
            },
        ),
        1,
    );
    assert_equal(visited, Vec::from_array([1, 20, 3]));
    assert_equal(source, Vec::from_array([1, 3]));
}
