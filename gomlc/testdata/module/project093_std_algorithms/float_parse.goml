package main;

use std::num;
use std::io;
use std::testing;
use std::text;

#[go_ffi("example.com/goml-std-algorithms/native", "ParseFloat")]
extern fn go_parse_float(value: string, bits: isize) -> (u64, bool, bool);

#[go_ffi("example.com/goml-std-algorithms/native", "ParseExactFloat")]
extern fn go_parse_exact_float(value: string, bits: isize) -> (u64, bool, bool);

fn check_float_parse(value: string) -> () {
    check_float_parse_reference(value, false);
}

fn check_float_parse_reference(value: string, exact: bool) -> () {
    for width in[32, 64] {
        let (expected, valid, range) = if exact {
            go_parse_exact_float(value, width)
        } else {
            go_parse_float(value, width)
        };
        let actual = if width == 32 {
            num::parse_float32_structured(value).map(|parsed: f32| float32_to_float64(parsed))
        } else {
            num::parse_float64_structured(value)
        };
        assert_equal(actual.is_ok(), valid);
        match actual {
            Ok(parsed) => {
                let bits = float64_to_bits(parsed);
                if expected & 0x7ff0000000000000 == 0x7ff0000000000000
                    && expected & 0xfffffffffffff != 0 {
                    testing::assert(
                        bits & 0x7ff0000000000000 == 0x7ff0000000000000
                            && bits & 0xfffffffffffff != 0,
                    );
                } else {
                    if bits != expected {
                        testing::fail(f"float parse mismatch at width {width}, input {value}");
                    }
                    testing::assert_eq(bits, expected);
                }
            },
            Err(error) => {
                assert_equal(error.is_range(), range);
                assert_equal(error.input(), value);
                assert_equal(error.kind(), io::ErrorKind::InvalidInput);
                assert_equal(error.operation(), "parse float");
                assert_equal(
                    error.message(),
                    if range {
                        "value out of range"
                    } else {
                        "invalid syntax"
                    },
                );
            },
        }
    }
}

fn check_float_parsing() -> () {
    check_float_exponent_cancellation();
    for value in[
        "",
        "0",
        "-0",
        "+0",
        ".5",
        "1.",
        "01",
        "1e2",
        "1e+2",
        "1e-2",
        "1_000.25",
        "1.2_5e1_0",
        "NaN",
        "nan",
        "NAN",
        "+NaN",
        "-NaN",
        "Inf",
        "Infinity",
        "+inF",
        "-INFINITY",
        "1e309",
        "-1e309",
        "1e999999",
        "1e-999999",
        "-1e-999999",
        "0e999999",
        "3.4028234663852886e38",
        "3.4028235677973366e38",
        "3.4028235677973367e38",
        "1.7976931348623157e308",
        "1.7976931348623158e308",
        "1.7976931348623159e308",
        "4.9406564584124654e-324",
        "2.4703282292062327e-324",
        "2.4703282292062328e-324",
        "7.006492321624085e-46",
        "7.006492321624086e-46",
        "1.401298464324817e-45",
        "0x1p0",
        "0X_1.Fp+2",
        "0x1p-1074",
        "0x1p-1075",
        "0x1.0000000000001p-1075",
        "0x1.fffffffffffffp1023",
        "0x1.fffffffffffff8p1023",
        "0x1p1024",
        "0x1p-149",
        "0x1p128",
        "0x1",
        "0x.p1",
        "0x1p",
        "0x1p+",
        "0x1p1_0",
        "0x_1p0",
        "0x__1p0",
        "_1",
        "1_",
        "1__2",
        "1._0",
        "1_.0",
        "1e_1",
        "1e1_",
        "1e+-2",
        "1e99999x",
        " true",
        " 1",
        "1 ",
        "１",
        "1\n",
    ] {
        check_float_parse(value);
    }
    let atoms = ["", "0", "1", ".", "e", "p", "_", "+", "-", "x", "f", " "];
    for first in atoms {
        for second in atoms {
            for third in atoms {
                check_float_parse(first + second + third);
                check_float_parse("0x" + first + second + third);
            }
        }
    }
    let mut state: u64 = 1082269761;
    for _ in 0..256 {
        state = state ^ (state << 13);
        state = state ^ (state >> 7);
        state = state ^ (state << 17);
        let value = float64_from_bits(state);
        for format in[b'g', b'x'] {
            let encoded = go_format_float(value, format, -1, 64);
            check_float_parse(encoded);
        }
    }
    let custom = num::ParseFloatError::new("1e999", "value out of range");
    testing::assert(!custom.is_range());
    let actual = testing::expect_err(num::parse_float64_structured("1e999"), "range error");
    testing::assert(actual != custom);
    for exponent in[10000, 1000000, 9999999] {
        for significand in["0", "1", "1.fffffffffffff", "0.0000000000001"] {
            for sign in["", "-"] {
                check_float_parse(f"{sign}0x{significand}p{exponent}");
                check_float_parse(f"{sign}0x{significand}p-{exponent}");
                check_float_parse(f"{sign}0x{significand}p{exponent}x");
            }
        }
    }
    for exponent in[
        -1077,
        -1076,
        -1075,
        -1074,
        -1073,
        -152,
        -151,
        -150,
        -149,
        -148,
        126,
        127,
        128,
        129,
        1022,
        1023,
        1024,
        1025,
    ] {
        for significand in[
            "1",
            "1.0000000000001",
            "1.fffffe",
            "1.ffffff",
            "1.fffffffffffff",
            "1.fffffffffffff8",
        ] {
            check_float_parse(f"0x{significand}p{exponent}");
            check_float_parse(f"-0x{significand}p{exponent}");
        }
    }
    for length in[64, 768, 2048] {
        let zeros = testing::expect_ok(text::repeat_checked("0", length, length), "long zeros");
        let nines = testing::expect_ok(text::repeat_checked("9", length, length), "long nines");
        for value in[
            zeros + "1.25",
            "1." + zeros + "1",
            "1" + zeros + f"e-{length}",
            nines + f"e-{length}",
            "0x1" + zeros + f"p-{length * 4}",
            "0x0." + zeros + "1p0",
        ] {
            check_float_parse_reference(value, true);
            check_float_parse_reference("-" + value, true);
        }
        let one = "1" + zeros + f"e-{length}";
        assert_equal(
            testing::expect_ok(num::parse_float32_structured(one), "long exact f32"),
            1.0.to_f32(),
        );
        assert_equal(testing::expect_ok(num::parse_float64_structured(one), "long exact f64"), 1.0);
        for value in["1e" + nines, "1e-" + nines, "0e" + nines, "1e" + nines + "x"] {
            check_float_parse(value);
            check_float_parse("-" + value);
        }
    }
}

fn check_float_exponent_cancellation() -> () {
    let zeros = testing::expect_ok(text::repeat_checked("0", 250000, 250000), "exponent zeros");
    for sign in["", "-"] {
        let prefix = sign + "0x0." + zeros + "1p";
        for exponent in["10000001", "1_000_000_1", "999999999999999999999999999999"] {
            let value = prefix + exponent;
            for width in[32, 64] {
                let result = if width == 32 {
                    num::parse_float32_structured(value).map(
                        |parsed: f32| float32_to_float64(parsed),
                    )
                } else {
                    num::parse_float64_structured(value)
                };
                let error = testing::expect_err(result, "long exponent overflow");
                testing::assert(error.is_range());
                let invalid = value + "x";
                let error = testing::expect_err(
                    num::parse_float64_structured(invalid),
                    "long exponent syntax",
                );
                testing::assert(!error.is_range());
            }
        }
    }
    for (prefix, length, exponent) in[("0x0.", 2500000, "p10000004"), ("0.", 10000000, "e10000001")] {
        let zeros = testing::expect_ok(
            text::repeat_checked("0", length, length),
            "cancellation zeros",
        );
        let value = prefix + zeros + "1" + exponent;
        assert_equal(
            testing::expect_ok(num::parse_float64_structured(value), "large cancellation f64"),
            1.0,
        );
        assert_equal(
            testing::expect_ok(num::parse_float32_structured(value), "large cancellation f32"),
            1.0.to_f32(),
        );
    }
}
