package main;

use std::bytes;
use std::ffi;
use std::hash::fnv;
use std::hash;
use hash::Hasher;
use std::encoding::hex;
use std::testing;

#[go_type("hash", "Hash32")]
extern type GoHash32;

#[go_ffi("hash/fnv", "New32")]
extern fn go_fnv32() -> GoHash32;

#[go_ffi("hash/fnv", "New32a")]
extern fn go_fnv32a() -> GoHash32;

#[go_method("Write")]
extern fn go_fnv32_write(value: GoHash32, input: Slice[byte]) -> (isize, ffi::Error);

#[go_method("Sum")]
extern fn go_fnv32_sum(value: GoHash32, prefix: Slice[byte]) -> MutSlice[byte];

#[go_type("hash", "Hash64")]
extern type GoHash64;

#[go_ffi("hash/fnv", "New64")]
extern fn go_fnv64() -> GoHash64;

#[go_ffi("hash/fnv", "New64a")]
extern fn go_fnv64a() -> GoHash64;

#[go_method("Write")]
extern fn go_fnv64_write(value: GoHash64, input: Slice[byte]) -> (isize, ffi::Error);

#[go_method("Sum")]
extern fn go_fnv64_sum(value: GoHash64, prefix: Slice[byte]) -> MutSlice[byte];

#[go_type("hash", "Hash")]
extern type GoHash128;

#[go_ffi("hash/fnv", "New128")]
extern fn go_fnv128() -> GoHash128;

#[go_ffi("hash/fnv", "New128a")]
extern fn go_fnv128a() -> GoHash128;

#[go_method("Write")]
extern fn go_fnv128_write(value: GoHash128, input: Slice[byte]) -> (isize, ffi::Error);

#[go_method("Sum")]
extern fn go_fnv128_sum(value: GoHash128, prefix: Slice[byte]) -> MutSlice[byte];

fn check_fnv(input: bytes::Bytes) -> () {
    check_fnv_state(input);
    for (digest, reference) in Vec::from_array(
        [(fnv::Digest::new32(), go_fnv32()), (fnv::Digest::new32a(), go_fnv32a())],
    ) {
        let (count, _) = go_fnv32_write(reference, input.as_slice());
        testing::assert_eq(count, input.len());
        let expected = go_fnv32_sum(reference, bytes::Bytes::new().as_slice());
        check_digest(digest, input, bytes::Bytes::from_vec(ffi::slice_to_vec_copy(expected)));
    }
    for (digest, reference) in Vec::from_array(
        [(fnv::Digest::new64(), go_fnv64()), (fnv::Digest::new64a(), go_fnv64a())],
    ) {
        let (count, _) = go_fnv64_write(reference, input.as_slice());
        testing::assert_eq(count, input.len());
        let expected = go_fnv64_sum(reference, bytes::Bytes::new().as_slice());
        check_digest(digest, input, bytes::Bytes::from_vec(ffi::slice_to_vec_copy(expected)));
    }
    for (digest, reference) in Vec::from_array(
        [(fnv::Digest::new128(), go_fnv128()), (fnv::Digest::new128a(), go_fnv128a())],
    ) {
        let (count, _) = go_fnv128_write(reference, input.as_slice());
        testing::assert_eq(count, input.len());
        let expected = go_fnv128_sum(reference, bytes::Bytes::new().as_slice());
        check_digest(digest, input, bytes::Bytes::from_vec(ffi::slice_to_vec_copy(expected)));
    }
}

fn check_fnv_state(input: bytes::Bytes) -> () {
    for digest in[
        fnv::Digest::new32(),
        fnv::Digest::new32a(),
        fnv::Digest::new64(),
        fnv::Digest::new64a(),
        fnv::Digest::new128(),
        fnv::Digest::new128a(),
    ] {
        let alias = digest;
        let initial = digest.sum().to_vec_copy();
        let middle = input.len() / 2;
        alias.update(input.slice(0, middle));
        let checkpoint = digest.sum().to_vec_copy();
        let independent = digest.copy();
        digest.update(input.slice(middle, input.len()));
        let expected = digest.sum().to_vec_copy();
        assert_equal(independent.sum().to_vec(), checkpoint);
        independent.update(input.slice(middle, input.len()));
        assert_equal(independent.sum().to_vec(), expected);
        alias.reset();
        assert_equal(digest.sum().to_vec(), initial);
        assert_equal(independent.sum().to_vec(), expected);
        independent.reset();
        assert_equal(independent.sum().to_vec(), initial);
        if input.len() <= 31 {
            for split in 0..input.len() + 1 {
                digest.reset();
                digest.update(input.slice(0, split));
                let snapshot = digest.sum();
                let before = snapshot.to_vec_copy();
                digest.update(input.slice(split, input.len()));
                assert_equal(snapshot.to_vec(), before);
                assert_equal(digest.sum().to_vec(), expected);
            }
        }
    }
}

fn check_fnv_known_answers() -> () {
    for (digest, empty, abc) in[
        (fnv::Digest::new32(), "811c9dc5", "439c2f4b"),
        (fnv::Digest::new32a(), "811c9dc5", "1a47e90b"),
        (fnv::Digest::new64(), "cbf29ce484222325", "d8dcca186bafadcb"),
        (fnv::Digest::new64a(), "cbf29ce484222325", "e71fa2190541574b"),
        (
            fnv::Digest::new128(),
            "6c62272e07bb014262b821756295c58d",
            "a68bb2a4348b5822836dbc78c6aee73b",
        ),
        (
            fnv::Digest::new128a(),
            "6c62272e07bb014262b821756295c58d",
            "a68d622cec8b5822836dbc7977af7f3b",
        ),
    ] {
        assert_equal(hex::encode(digest.sum()), empty);
        digest.update(bytes::Bytes::from_string("abc").as_slice());
        assert_equal(hex::encode(digest.sum()), abc);
    }
}
