package main;

use std::text::format;
use std::num;
use std::testing;

fn numeric_test_integer(value: i64, spec: format::IntSpec, expected: string) -> () {
    let output = testing::expect_ok(format::Formatter::new(256), "numeric formatter");
    testing::expect_ok(output.integer(value, spec), "integer field");
    assert_equal(output.finish(), expected);
}

pub fn test_format_numeric() -> () {
    numeric_test_integer(-9223372036854775807 - 1, format::IntSpec::plain(), "-9223372036854775808");
    let output = testing::expect_ok(format::Formatter::new(256), "unsigned formatter");
    testing::expect_ok(
        output.unsigned(18446744073709551615, format::IntSpec::plain()),
        "unsigned maximum",
    );
    assert_equal(output.finish(), "18446744073709551615");
    for radix in[2, 8, 10, 16, 36] {
        numeric_test_integer(
            -123456789,
            format::IntSpec { radix, ..format::IntSpec::plain() },
            testing::expect_ok(num::format_int(-123456789, radix), "reference integer"),
        );
    }
    numeric_test_integer(
        -31,
        format::IntSpec {
            radix: 16,
            alternate: true,
            uppercase: true,
            min_digits: 4,
            ..format::IntSpec::plain(),
        },
        "-0X001F",
    );
    numeric_test_integer(
        5,
        format::IntSpec {
            radix: 2,
            alternate: true,
            sign: format::Sign::Always,
            min_digits: 5,
            ..format::IntSpec::plain(),
        },
        "+0b00101",
    );
    numeric_test_integer(
        0,
        format::IntSpec {
            radix: 8,
            alternate: true,
            sign: format::Sign::Space,
            ..format::IntSpec::plain(),
        },
        " 0o0",
    );
    numeric_test_integer(
        -12,
        format::IntSpec {
            padding: format::Padding { width: 5, alignment: format::Alignment::Right, fill: '0' },
            ..format::IntSpec::plain(),
        },
        "00-12",
    );
    numeric_test_integer(
        35,
        format::IntSpec { radix: 36, uppercase: true, ..format::IntSpec::plain() },
        "Z",
    );
    let output = testing::expect_ok(format::Formatter::new(5), "atomic numeric formatter");
    testing::expect_ok(output.literal("x"), "numeric prefix");
    for spec in[
        format::IntSpec { min_digits: 5, ..format::IntSpec::plain() },
        format::IntSpec {
            padding: format::Padding { width: 5, alignment: format::Alignment::Left, fill: ' ' },
            ..format::IntSpec::plain(),
        },
    ] {
        assert_equal(
            testing::expect_err(output.integer(1, spec), "numeric limit"),
            format::Error::LimitExceeded(5),
        );
        assert_equal(output.finish(), "x");
        assert_equal(output.len(), 1);
    }
    for spec in[
        format::IntSpec { radix: 1, ..format::IntSpec::plain() },
        format::IntSpec { radix: 37, ..format::IntSpec::plain() },
        format::IntSpec { alternate: true, ..format::IntSpec::plain() },
        format::IntSpec { min_digits: -1, ..format::IntSpec::plain() },
    ] {
        match testing::expect_err(output.integer(1, spec), "invalid integer specification") {
            format::Error::InvalidSpec(_) => (),
            _ => testing::fail("wrong integer specification error"),
        }
        assert_equal(output.finish(), "x");
    }
    assert_equal(
        testing::expect_err(
            output.integer(
                -1,
                format::IntSpec { min_digits: 9223372036854775807, ..format::IntSpec::plain() },
            ),
            "integer arithmetic overflow",
        ),
        format::Error::LengthOverflow,
    );
    let alias = output;
    testing::expect_ok(
        alias.integer(1234, format::IntSpec::plain()),
        "exact remaining numeric budget",
    );
    assert_equal(output.finish(), "x1234");
    let styles = [
        format::FloatStyle::Shortest(num::FloatNotation::General),
        format::FloatStyle::Fixed(3),
        format::FloatStyle::Scientific(4, true),
        format::FloatStyle::General(0, false),
        format::FloatStyle::Binary,
        format::FloatStyle::Hex(-1, true),
    ];
    for style in styles {
        let expected = testing::expect_ok(
            match style {
                format::FloatStyle::Shortest(notation) => num::format_float64_shortest(
                    1.25,
                    notation,
                    256,
                ),
                format::FloatStyle::Fixed(precision) => num::format_float64_fixed(
                    1.25,
                    precision,
                    256,
                ),
                format::FloatStyle::Scientific(precision, uppercase) => num::format_float64_scientific(
                    1.25,
                    precision,
                    uppercase,
                    256,
                ),
                format::FloatStyle::General(precision, uppercase) => num::format_float64_general(
                    1.25,
                    precision,
                    uppercase,
                    256,
                ),
                format::FloatStyle::Binary => num::format_float64_binary(1.25, 256),
                format::FloatStyle::Hex(precision, uppercase) => num::format_float64_hex(
                    1.25,
                    precision,
                    uppercase,
                    256,
                ),
            },
            "reference float",
        );
        let output = testing::expect_ok(
            format::Formatter::new(expected.byte_len()),
            "float exact budget",
        );
        testing::expect_ok(
            output.float64(1.25, format::FloatSpec { style, ..format::FloatSpec::plain() }),
            "float field",
        );
        assert_equal(output.finish(), expected);
    }
    let output = testing::expect_ok(format::Formatter::new(3), "float32 shortest budget");
    testing::expect_ok(output.float32(0.1, format::FloatSpec::plain()), "native float32 shortest");
    assert_equal(output.finish(), "0.1");
    for (value, expected) in[
        (float64_from_bits(0x8000000000000000), "-0"),
        (float64_from_bits(0x7ff0000000000000), "+Inf"),
        (float64_from_bits(0xfff0000000000000), "-Inf"),
        (float64_from_bits(0x7ff8000000000000), "+NaN"),
    ] {
        let output = testing::expect_ok(format::Formatter::new(32), "float special budget");
        testing::expect_ok(
            output.float64(
                value,
                format::FloatSpec { sign: format::Sign::Always, ..format::FloatSpec::plain() },
            ),
            "float special sign",
        );
        assert_equal(output.finish(), expected);
    }
    for style in[
        format::FloatStyle::Fixed(-1),
        format::FloatStyle::Scientific(-1, false),
        format::FloatStyle::General(-1, true),
        format::FloatStyle::Hex(-2, false),
    ] {
        let output = testing::expect_ok(format::Formatter::new(0), "invalid float preflight");
        match testing::expect_err(
            output.float64(1.0, format::FloatSpec { style, ..format::FloatSpec::plain() }),
            "invalid float precision",
        ) {
            format::Error::InvalidSpec(_) => (),
            _ => testing::fail("wrong float specification error"),
        }
        assert_equal(output.finish(), "");
    }
    let output = testing::expect_ok(format::Formatter::new(3), "signed float budget");
    assert_equal(
        testing::expect_err(
            output.float32(
                0.1,
                format::FloatSpec { sign: format::Sign::Always, ..format::FloatSpec::plain() },
            ),
            "float sign counts against budget",
        ),
        format::Error::LimitExceeded(3),
    );
    assert_equal(output.finish(), "");
    assert_equal(
        testing::expect_err(
            output.float64(
                1.0,
                format::FloatSpec {
                    style: format::FloatStyle::Fixed(9223372036854775807),
                    ..format::FloatSpec::plain(),
                },
            ),
            "huge precision bounded by num",
        ),
        format::Error::LimitExceeded(3),
    );
    assert_equal(output.finish(), "");
}
