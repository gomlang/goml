package main;

use std::cmp;
use cmp::{Ord, PartialOrd};
use std::collections;
use std::ffi;
use std::rand;
use std::testing;

#[go_ffi("example.com/goml-std-algorithms/native", "StableOrder")]
extern fn go_stable_order(keys: Slice[isize]) -> ffi::RawSlice[isize];

#[go_ffi("example.com/goml-std-algorithms/native", "FindIndex")]
extern fn go_find_index(length: isize, target: isize) -> (isize, bool);

struct SortTag {
    key: isize,
    index: isize,
    comparisons: Ref[isize],
}

impl PartialEq for SortTag {
    fn eq(self: SortTag, other: SortTag) -> bool {
        self.key == other.key
    }
}

impl Eq for SortTag {}

impl PartialOrd for SortTag {
    fn partial_cmp(self: SortTag, other: SortTag) -> Option[cmp::Ordering] {
        Option::Some(self.cmp(other))
    }
}

impl Ord for SortTag {
    fn cmp(self: SortTag, other: SortTag) -> cmp::Ordering {
        self.comparisons.set(self.comparisons.get() + 1);
        cmp::compare(self.key, other.key)
    }
}

fn check_sort_contracts() -> () {
    for length in[0, 1, 2, 3, 7, 8, 9, 31, 32, 33, 127, 128, 129, 1023] {
        let mut levels = 0;
        let mut capacity = 1;
        while capacity < length {
            capacity *= 2;
            levels += 1;
        }
        for pattern in 0..6 {
            let keys: Vec[isize] = Vec::new();
            for index in 0..length {
                keys.push(
                    match pattern {
                        0 => index,
                        1 => length - index,
                        2 => 0,
                        3 => if index % 2 == 0 {
                            -9223372036854775807 - 1
                        } else {
                            9223372036854775807
                        },
                        4 => (rand::next_u64(index.to_u64()) % 17).to_isize(),
                        _ => if index < length / 2 {
                            index
                        } else {
                            length - index
                        },
                    },
                );
            }
            let expected = go_stable_order(keys.as_slice()).as_slice();
            for variant in 0..6 {
                let comparisons = Ref::new(0);
                let values: Vec[SortTag] = Vec::new();
                for index in 0..length {
                    values.push(SortTag { key: keys[index], index, comparisons });
                }
                let alias = values;
                let view = values.as_slice();
                match variant {
                    0 => collections::sort(values),
                    1 => collections::stable_sort(values),
                    2 => collections::sort_by(values, |a: SortTag, b: SortTag| a.cmp(b).to_isize()),
                    3 => collections::stable_sort_by(
                        values,
                        |a: SortTag, b: SortTag| a.cmp(b).to_isize(),
                    ),
                    4 => collections::sort_by_ordering(values, |a: SortTag, b: SortTag| a.cmp(b)),
                    _ => collections::stable_sort_by_ordering(
                        values,
                        |a: SortTag, b: SortTag| a.cmp(b),
                    ),
                }
                testing::assert(comparisons.get() <= length * levels);
                assert_equal(values.len(), length);
                for index in 0..length {
                    assert_equal(values[index].index, expected[index]);
                    assert_equal(alias[index].index, expected[index]);
                    assert_equal(view[index].index, expected[index]);
                }
            }
        }
    }
    let calls = Ref::new(0);
    assert_equal(
        collections::search_by(
            -1,
            |_: isize| {
                calls.set(calls.get() + 1);
                0
            },
        ),
        Option::None,
    );
    assert_equal(
        collections::search_by_ordering(
            -1,
            |_: isize| {
                calls.set(calls.get() + 1);
                cmp::Ordering::Equal
            },
        ),
        Option::None,
    );
    assert_equal(
        collections::search_by(
            0,
            |_: isize| {
                calls.set(calls.get() + 1);
                0
            },
        ),
        Option::Some((0, false)),
    );
    assert_equal(calls.get(), 0);
    for length in[0, 1, 2, 7, 16, 31, 128, 9223372036854775807] {
        for target in[-1, 0, length / 2, length - 1, length] {
            calls.set(0);
            let actual = collections::search_by(
                length,
                |index: isize| {
                    testing::assert(index >= 0 && index < length);
                    calls.set(calls.get() + 1);
                    cmp::compare(index, target).to_isize()
                },
            );
            assert_equal(actual, Option::Some(go_find_index(length, target)));
            testing::assert(calls.get() <= 64);
            assert_equal(
                collections::search_by_ordering(length, |index: isize| cmp::compare(index, target)),
                actual,
            );
        }
    }
    for length in 0..65 {
        let values: Vec[isize] = Vec::new();
        for index in 0..length {
            values.push(index / 3);
        }
        for target in -1..24 {
            let low = go_search_ints(values.as_slice(), target);
            let mut high = low;
            while high < values.len() && values[high] == target {
                high += 1;
            }
            assert_equal(
                collections::equal_range_by_ordering(
                    values,
                    |value: isize| cmp::compare(value, target),
                ),
                (low, high),
            );
            assert_equal(
                collections::search_by(
                    length,
                    |index: isize| cmp::compare(values[index], target).to_isize(),
                ),
                Option::Some((low, low < high)),
            );
        }
    }
}
