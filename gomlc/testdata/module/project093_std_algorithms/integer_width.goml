package main;

use std::num;
use std::testing;

#[go_ffi("example.com/goml-std-algorithms/native", "ParseSignedWidth")]
extern fn go_parse_signed_width(value: string, radix: isize, bits: isize) -> (i64, bool);

#[go_ffi("example.com/goml-std-algorithms/native", "ParseUnsignedWidth")]
extern fn go_parse_unsigned_width(value: string, radix: isize, bits: isize) -> (u64, bool);

fn check_width_value(input: string, radix: isize, bits: isize) -> () {
    let (signed, signed_ok) = if bits == 1 {
        let (value, valid) = go_parse_signed_width(input, radix, 64);
        (value, valid && value >= -1 && value <= 0)
    } else {
        go_parse_signed_width(input, radix, bits)
    };
    match num::parse_int_bits(input, radix, bits) {
        Ok(value) => {
            if !signed_ok {
                testing::fail(f"signed accepted {input}, radix {radix}, bits {bits}");
            }
            assert_equal(value, signed);
        },
        Err(error) => if signed_ok {
            testing::fail(f"signed rejected {input}, radix {radix}, bits {bits}: {error}");
        },
    }
    let (unsigned, unsigned_ok) = go_parse_unsigned_width(input, radix, bits);
    match num::parse_uint_bits(input, radix, bits) {
        Ok(value) => {
            if !unsigned_ok {
                testing::fail(f"unsigned accepted {input}, radix {radix}, bits {bits}");
            }
            assert_equal(value, unsigned);
        },
        Err(error) => if unsigned_ok {
            testing::fail(f"unsigned rejected {input}, radix {radix}, bits {bits}: {error}");
        },
    }
}

fn check_integer_width() -> () {
    for bits in 0..65 {
        for radix in 2..37 {
            let width = if bits == 0 {
                64
            } else {
                bits
            };
            let boundary = 1.to_u64() << (width - 1);
            for value in[
                0.to_u64(),
                1.to_u64(),
                boundary - 1,
                boundary,
                boundary + 1,
                18446744073709551615,
            ] {
                let encoded = testing::expect_ok(num::format_uint(value, radix), "width sample");
                check_width_value(encoded, radix, bits);
                check_width_value("-" + encoded, radix, bits);
            }
        }
        for input in[
            "",
            "+",
            "-",
            "0",
            "-0",
            "+1",
            "0x_ff",
            "0b10",
            "0o77",
            "077",
            "09",
            "1_2",
            "1__2",
            "_1",
            "1_",
            " 1",
            "18446744073709551616",
            "-9223372036854775809",
        ] {
            check_width_value(input, 0, bits);
            check_width_value(input, 10, bits);
        }
    }
    for bits in[-1, 65, 100] {
        testing::assert(num::parse_int_bits("1", 10, bits).is_err());
        testing::assert(num::parse_uint_bits("1", 10, bits).is_err());
    }
    match num::parse_int_bits("1", 10, 1) {
        Err(num::IntWidthError::OutOfRange(bits)) => assert_equal(bits, 1),
        _ => testing::assert(false),
    }
    match num::parse_int_bits("bad", 1, -1) {
        Err(num::IntWidthError::InvalidWidth(bits)) => assert_equal(bits, -1),
        _ => testing::assert(false),
    }
}
