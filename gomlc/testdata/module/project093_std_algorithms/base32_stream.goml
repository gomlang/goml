package main;

use std::bytes;
use std::encoding::base32;
use std::encoding::base32::stream;
use std::io;
use io::{Read, Write, Close};
use std::testing;

fn base32_stream_ok[T, E](value: Result[T, E]) -> T {
    testing::expect_ok(value, "base32 stream operation")
}

fn check_base32_stream() -> () {
    check_base32_stream_failures();
    for encoding in Vec::from_array(
        [
            base32::Encoding::from_variant(base32::Variant::Standard),
            base32::Encoding::from_variant(base32::Variant::StandardNoPadding),
            base32::Encoding::from_variant(base32::Variant::Hex),
            base32::Encoding::from_variant(base32::Variant::HexNoPadding),
            base32_stream_ok(
                base32::Encoding::new("abcdefghijklmnopqrstuvwxyz234567", Option::Some(0.to_u8())),
            ),
            base32_stream_ok(
                base32::Encoding::new("=BCDEFGHIJKLMNOPQRSTUVWXYZ234567", Option::None),
            ),
        ],
    ) {
        let reference = go_base32_padding(
            go_base32(encoding.alphabet()),
            match encoding.padding() {
                Some(value) => value.to_i32(),
                None => -1.to_i32(),
            },
        );
        for length in 0..34 {
            let data: Vec[byte] = Vec::new();
            for index in 0..length {
                data.push((index * 37).to_u8());
            }
            for chunk in 1..10 {
                let target = io::Cursor::new(bytes::Bytes::new());
                let writer = base32_stream_ok(
                    stream::Encoder::new(
                        CopyWriter { cursor: target, interrupted: Ref::new(false) },
                        encoding,
                        100,
                    ),
                );
                let mut offset = 0;
                while offset < length {
                    let end = if offset + chunk < length {
                        offset + chunk
                    } else {
                        length
                    };
                    base32_stream_ok(writer.write_all(data.as_slice().sub(offset, end)));
                    offset = end;
                }
                base32_stream_ok(writer.flush());
                base32_stream_ok(writer.finish());
                base32_stream_ok(writer.close());
                testing::assert(writer.is_finished());
                assert_equal(writer.input_len(), length);
                assert_equal(
                    target.bytes().as_slice().to_vec(),
                    bytes::Bytes::from_string(go_base32_encode(reference, data.as_slice())).as_slice().to_vec(),
                );
                testing::assert(writer.write(data.as_slice()).is_err());
                base32_stream_ok(target.set_position(0));
                let reader = base32_stream_ok(
                    stream::Decoder::new(
                        CopyReader { cursor: target, interrupted: Ref::new(false) },
                        encoding,
                        length,
                    ),
                );
                let decoded = Vec::new();
                let buffer = Vec::new();
                for _ in 0..chunk {
                    buffer.push(0.to_u8());
                }
                loop {
                    let count = base32_stream_ok(reader.read(buffer.as_mut_slice()));
                    if count == 0 {
                        break
                    }
                    for index in 0..count {
                        decoded.push(buffer[index]);
                    }
                }
                assert_equal(decoded, data);
                assert_equal(base32_stream_ok(reader.read(buffer.as_mut_slice())), 0);
                testing::assert(reader.failure().is_none());
            }
        }
    }
    let encoding = base32::Encoding::from_variant(base32::Variant::Standard);
    for invalid in Vec::from_array(["MY", "MZ======", "MY======A", "!!!!!!!!"]) {
        let source = io::Cursor::new(bytes::Bytes::from_string(invalid));
        let reader = base32_stream_ok(stream::Decoder::new(source, encoding, 20));
        let output = b"00000";
        let mut failed = false;
        for _ in 0..10 {
            if reader.read(output.as_mut_slice()).is_err() {
                failed = true;
                break
            }
        }
        testing::assert(failed);
        let original = testing::expect_some(reader.failure(), "sticky error");
        assert_equal(reader.read(output.as_mut_slice()), Result::Err(original));
    }
    let target = io::Cursor::new(bytes::Bytes::new());
    let writer = base32_stream_ok(stream::Encoder::new(target, encoding, 8));
    testing::assert(writer.write(b"foobar".as_slice()).is_err());
    assert_equal(writer.input_len(), 0);
    testing::assert(writer.failure().is_none());
    base32_stream_ok(writer.write_all(b"f".as_slice()));
    base32_stream_ok(writer.flush());
    assert_equal(target.bytes().as_slice().to_vec(), b"M");
    base32_stream_ok(writer.finish());
    assert_equal(target.bytes().as_slice().to_vec(), b"MY======");
}

fn check_base32_stream_failures() -> () {
    let encoding = base32::Encoding::from_variant(base32::Variant::Standard);
    for fail_on in[1, 2, 9] {
        let source = codec_interrupted_reader(b"MZXW6YTBMZXW6YTB", fail_on);
        let reader = base32_stream_ok(stream::Decoder::new(source, encoding, 100));
        let output = b"???";
        let mut delivered = 0;
        loop {
            match reader.read(output.slice_mut(1, 2)) {
                Ok(count) => {
                    assert_equal(count, 1);
                    testing::assert(delivered < 5);
                    assert_equal(output[1], "fooba".byte_get(delivered));
                    delivered += count;
                },
                Err(error) => {
                    assert_equal(error, source.error);
                    break
                },
            }
        }
        assert_equal(
            delivered,
            if fail_on == 9 {
                5
            } else {
                0
            },
        );
        assert_equal(source.calls.get(), fail_on);
        assert_equal(source.cursor.position(), fail_on);
        assert_equal(reader.failure(), Option::Some(source.error));
        assert_equal(reader.read(output.as_mut_slice()), Result::Err(source.error));
        assert_equal(reader.read(output.slice_mut(0, 0)), Result::Err(source.error));
        assert_equal(source.calls.get(), fail_on);
        assert_equal(output[0], b'?');
        assert_equal(output[2], b'?');
    }
    let failure = io::Error::new(
        io::ErrorKind::PermissionDenied,
        "base32 probe",
        Option::None,
        Option::None,
        "stop",
    );
    let destination = io::Cursor::new(bytes::Bytes::new());
    let writer = base32_stream_ok(
        stream::Encoder::new(PartialMirror { output: destination, error: failure }, encoding, 100),
    );
    assert_equal(writer.write_all(b"foobar".as_slice()), Result::Err(failure));
    assert_equal(writer.input_len(), 6);
    assert_equal(destination.bytes().to_vec(), b"MZ");
    assert_equal(writer.failure(), Option::Some(failure));
    assert_equal(writer.write_all(b"abc".as_slice()), Result::Err(failure));
    assert_equal(writer.finish(), Result::Err(failure));
    assert_equal(writer.flush(), Result::Err(failure));
    assert_equal(destination.bytes().to_vec(), b"MZ");
    testing::assert(!writer.is_finished());
    let interrupted = io::Error::new(
        io::ErrorKind::Interrupted,
        "base32 probe",
        Option::None,
        Option::None,
        "already partially written",
    );
    let events = Vec::new();
    let probe = multi_probe(events, 1, 0);
    probe.result.set(Result::Err(interrupted));
    let underlying = io::MultiWriter::new(Vec::from_array([probe]).as_slice());
    let writer = base32_stream_ok(stream::Encoder::new(underlying, encoding, 100));
    for _ in 0..2 {
        match writer.write_all(b"abc".as_slice()) {
            Err(error) => assert_equal(error.kind(), io::ErrorKind::Other),
            Ok(()) => testing::assert(false),
        }
    }
    assert_equal(writer.failure(), Option::Some(interrupted));
    assert_equal(events, Vec::from_array([1]));
    let events = Vec::new();
    let probe = multi_probe(events, 2, 0);
    probe.flush_result.set(Result::Err(failure));
    let writer = base32_stream_ok(stream::Encoder::new(probe, encoding, 100));
    assert_equal(writer.flush(), Result::Err(failure));
    assert_equal(writer.close(), Result::Err(failure));
    assert_equal(events, Vec::from_array([-2]));
    let empty: Vec[byte] = Vec::new();
    let output = b"00000";
    for invalid_count in Vec::from_array([-1, 2]) {
        let events = Vec::new();
        let probe = multi_probe(events, 3, invalid_count);
        let reader = base32_stream_ok(stream::Decoder::new(probe, encoding, 100));
        assert_equal(base32_stream_ok(reader.read(empty.as_mut_slice())), 0);
        testing::assert(events.is_empty());
        testing::assert(reader.read(output.as_mut_slice()).is_err());
        testing::assert(reader.read(output.as_mut_slice()).is_err());
        assert_equal(events, Vec::from_array([3]));
    }
    let events = Vec::new();
    let probe = multi_probe(events, 4, 0);
    probe.result.set(Result::Err(failure));
    let reader = base32_stream_ok(stream::Decoder::new(probe, encoding, 100));
    assert_equal(reader.read(output.as_mut_slice()), Result::Err(failure));
    assert_equal(reader.read(empty.as_mut_slice()), Result::Err(failure));
    assert_equal(events, Vec::from_array([4]));
    let source = io::Cursor::new(bytes::Bytes::from_string("MY======A"));
    let reader = base32_stream_ok(stream::Decoder::new(source, encoding, 100));
    assert_equal(base32_stream_ok(reader.read(output.as_mut_slice())), 1);
    assert_equal(output[0], b'f');
    assert_equal(source.position(), 8);
    testing::assert(reader.read(output.as_mut_slice()).is_err());
    assert_equal(source.position(), 9);
    for data in Vec::from_array([b"\xff", b"MY======"]) {
        let source = io::Cursor::new(bytes::Bytes::from_vec(data));
        let reader = base32_stream_ok(stream::Decoder::new(source, encoding, 0));
        testing::assert(reader.read(output.as_mut_slice()).is_err());
        testing::assert(reader.failure().is_some());
    }
}
