package main;

use std::error;
use std::testing;
use std::io;

enum DomainFailure {
    Io(io::Error),
    Validation(string),
}

impl ToString for DomainFailure {
    fn to_string(self: DomainFailure) -> string {
        match self {
            Io(value) => value.to_string(),
            Validation(value) => value,
        }
    }
}

fn error_protocol_text[E: error::Error](value: E) -> string {
    value.to_string()
}

fn checked_report_input(value: isize) -> Result[isize, error::Report[DomainFailure]] {
    let result: Result[isize, DomainFailure] = if value < 0 {
        Result::Err(DomainFailure::Validation("negative input"))
    } else {
        Result::Ok(value)
    };
    let value = result.map_err(|cause: DomainFailure| error::Report::new(cause).context("validate"))?;
    Result::Ok(value)
}

fn check_error_reports() -> () {
    check_error_interoperability();
    let first = error::Report::new(error::ErrorKind::NotFound).context("load");
    let second = error::Report::new(error::ErrorKind::PermissionDenied).context("save");
    let values = Vec::from_array([first, second]);
    let group = testing::expect_some(error::Report::join(values.as_slice()), "nonempty errors");
    values[0] = second;
    assert_equal(group.to_string(), "load: NotFound\nsave: PermissionDenied");
    assert_equal(
        group.context("batch").to_string(),
        "batch: load: NotFound\nsave: PermissionDenied",
    );
    testing::assert(group.contains(error::ErrorKind::NotFound));
    testing::assert(group.contains(error::ErrorKind::PermissionDenied));
    testing::assert(!group.contains(error::ErrorKind::Other));
    assert_equal(group.find(|_: error::ErrorKind| true), Option::Some(error::ErrorKind::NotFound));
    assert_equal(
        group.find_map(
            |value: error::ErrorKind| if value == error::ErrorKind::PermissionDenied {
                Option::Some(42)
            } else {
                Option::None
            },
        ),
        Option::Some(42),
    );
    assert_equal(first.message(), Option::Some("load"));
    testing::assert(first.value().is_none());
    assert_equal(first.causes()[0].value(), Option::Some(error::ErrorKind::NotFound));
    let causes = group.causes();
    causes[0] = second;
    assert_equal(group.causes()[0].to_string(), "load: NotFound");
    let empty: Vec[error::Report[error::ErrorKind]] = Vec::new();
    testing::assert(error::Report::join(empty.as_slice()).is_none());
    let singleton = testing::expect_some(
        error::Report::join(Vec::from_array([first]).as_slice()),
        "singleton",
    );
    assert_equal(singleton.to_string(), first.to_string());
    let nested = testing::expect_some(
        error::Report::join(Vec::from_array([group, first]).as_slice()),
        "nested",
    );
    assert_equal(nested.to_string(), "load: NotFound\nsave: PermissionDenied\nload: NotFound");
    let mut deep = error::Report::new("leaf");
    for _ in 0..10000 {
        deep = deep.context("x");
    }
    testing::assert(deep.contains("leaf"));
    assert_equal(deep.to_string().byte_len(), 30004);
    let contexts = Vec::from_array([error::Report::new(""), error::Report::new("尾")]);
    assert_equal(
        testing::expect_some(error::Report::join(contexts.as_slice()), "unicode").to_string(),
        "\n尾",
    );
    assert_equal(error::Report::new("value").context("").to_string(), ": value");
}

fn check_error_interoperability() -> () {
    let io_error = io::Error::new(
        io::ErrorKind::NotFound,
        "read",
        Option::Some("config"),
        Option::Some(2),
        "missing",
    );
    let io_report = error::Report::new(DomainFailure::Io(io_error)).context("load");
    let validation = testing::expect_err(checked_report_input(-1), "typed error propagation");
    assert_equal(testing::expect_ok(checked_report_input(7), "success propagation"), 7);
    let report = testing::expect_some(
        error::Report::join(Vec::from_array([validation, io_report]).as_slice()),
        "domain aggregate",
    );
    assert_equal(
        error_protocol_text(report),
        "validate: negative input\nload: read config: missing",
    );
    let found = testing::expect_some(
        report.find_map(
            |value: DomainFailure| match value {
                Io(cause) => Option::Some(cause),
                Validation(_) => Option::None,
            },
        ),
        "typed I/O projection",
    );
    assert_equal(found.kind(), io::ErrorKind::NotFound);
    assert_equal(found.raw_os_code(), Option::Some(2));
    let leaves = Vec::from_array(
        [error::Report::new(1), error::Report::new(2), error::Report::new(3)],
    );
    let inner = testing::expect_some(error::Report::join(leaves.as_slice()), "ordered leaves");
    let outer = testing::expect_some(
        error::Report::join(
            Vec::from_array([inner.context("left"), inner.context("right")]).as_slice(),
        ),
        "shared subtree",
    );
    let visits: Vec[isize] = Vec::new();
    let result: Option[isize] = outer.find_map(
        |value: isize| {
            visits.push(value);
            Option::None
        },
    );
    testing::assert(result.is_none());
    assert_equal(visits, Vec::from_array([1, 2, 3, 1, 2, 3]));
    let stopped: Vec[isize] = Vec::new();
    assert_equal(
        outer.find_map(
            |value: isize| {
                stopped.push(value);
                if value == 2 {
                    Option::Some("second")
                } else {
                    Option::None
                }
            },
        ),
        Option::Some("second"),
    );
    assert_equal(stopped, Vec::from_array([1, 2]));
    let shared = Ref::new(1);
    let shared_report = error::Report::new(shared).context("mutable payload");
    testing::expect_some(shared_report.find(|_: Ref[isize]| true), "shared leaf").set(9);
    assert_equal(shared.get(), 9);
    let child = shared_report.causes();
    child[0] = error::Report::new(Ref::new(4));
    assert_equal(
        testing::expect_some(shared_report.find(|_: Ref[isize]| true), "unchanged tree").get(),
        9,
    );
    let identities = testing::expect_some(
        error::Report::join(
            Vec::from_array([error::Report::new(1), error::Report::new(2)]).as_slice(),
        ),
        "identity values",
    );
    testing::assert(identities.contains(2));
    testing::assert(!identities.contains(3));
}
