package main;

use std::text;
use std::testing;
use std::ffi;

#[go_ffi("strings", "SplitN")]
extern fn go_text_split_n(value: string, separator: string, count: isize) -> ffi::RawSlice[string];

#[go_ffi("strings", "SplitAfterN")]
extern fn go_text_split_after_n(value: string, separator: string, count: isize) -> ffi::RawSlice[
    string,
];

#[go_ffi("strings", "IndexAny")]
extern fn go_text_find_any(value: string, characters: string) -> isize;

#[go_ffi("strings", "LastIndexAny")]
extern fn go_text_rfind_any(value: string, characters: string) -> isize;

#[go_ffi("strings", "IndexRune")]
extern fn go_text_find_char(value: string, character: char) -> isize;

#[go_ffi("strings", "TrimLeft")]
extern fn go_text_trim_start_chars(value: string, characters: string) -> string;

#[go_ffi("strings", "TrimRight")]
extern fn go_text_trim_end_chars(value: string, characters: string) -> string;

#[go_ffi("example.com/goml-std-algorithms/native", "TextIndexBy")]
extern fn go_text_find_by(value: string) -> isize;

#[go_ffi("example.com/goml-std-algorithms/native", "TextLastIndexBy")]
extern fn go_text_rfind_by(value: string) -> isize;

fn check_text_split() -> () {
    let nul = char_from_u32(0).unwrap_or(' ').to_string();
    let values = ["", "a", "aaa", "ababa", "é界🙂", "界,🙂,界", "\n\r", "aé🙂éa", nul + "a" + nul];
    for value in values {
        for separator in values {
            for count in[-9223372036854775807 - 1, -1, 0, 1, 2, 5, 9223372036854775807] {
                let expected = go_text_split_n(value, separator, count).as_slice().to_vec();
                assert_equal(
                    testing::expect_ok(
                        text::split_n_checked(value, separator, count, expected.len()),
                        "bounded text split",
                    ),
                    expected,
                );
                if expected.len() > 0 {
                    testing::assert(
                        text::split_n_checked(value, separator, count, expected.len() - 1).is_err(),
                    );
                }
                let after = go_text_split_after_n(value, separator, count).as_slice().to_vec();
                assert_equal(
                    testing::expect_ok(
                        text::split_after_n_checked(value, separator, count, after.len()),
                        "bounded text split after",
                    ),
                    after,
                );
                if after.len() > 0 {
                    testing::assert(
                        text::split_after_n_checked(value, separator, count, after.len() - 1).is_err(),
                    );
                }
            }
            assert_equal(
                testing::expect_ok(text::split_checked(value, separator, 100), "split all"),
                go_text_split_n(value, separator, -1).as_slice().to_vec(),
            );
            assert_equal(
                testing::expect_ok(
                    text::split_after_checked(value, separator, 100),
                    "split after all",
                ),
                go_text_split_after_n(value, separator, -1).as_slice().to_vec(),
            );
            assert_equal(
                text::find_any(value, separator).unwrap_or(-1),
                go_text_find_any(value, separator),
            );
            assert_equal(
                text::rfind_any(value, separator).unwrap_or(-1),
                go_text_rfind_any(value, separator),
            );
            assert_equal(
                text::contains_any(value, separator),
                go_text_find_any(value, separator) >= 0,
            );
            assert_equal(
                text::trim_start_chars(value, separator),
                go_text_trim_start_chars(value, separator),
            );
            assert_equal(
                text::trim_end_chars(value, separator),
                go_text_trim_end_chars(value, separator),
            );
        }
        for character in "aé界🙂,�".chars() {
            assert_equal(
                text::find_char(value, character).is_some(),
                go_text_find_char(value, character) >= 0,
            );
            assert_equal(
                text::find_char(value, character).unwrap_or(-1),
                go_text_find_char(value, character),
            );
            assert_equal(
                text::rfind_char(value, character).unwrap_or(-1),
                go_text_last_index(value, character.to_string()),
            );
        }
        let predicate = |character: char| character == ',' || character == '界' || character == '🙂';
        assert_equal(text::find_by(value, predicate).is_some(), go_text_find_by(value) >= 0);
        assert_equal(text::find_by(value, predicate).unwrap_or(-1), go_text_find_by(value));
        assert_equal(text::rfind_by(value, predicate).unwrap_or(-1), go_text_rfind_by(value));
    }
    let visited: Vec[char] = Vec::new();
    let predicate = |character: char| {
        visited.push(character);
        character == '界'
    };
    testing::assert(!text::find_by("", predicate).is_some());
    testing::assert(visited.is_empty());
    testing::assert(text::find_by("a界🙂b", predicate).is_some());
    assert_equal(visited, Vec::from_array(['a', '界']));
    visited.clear();
    assert_equal(text::find_by("a界🙂b", predicate), Option::Some(1));
    assert_equal(visited, Vec::from_array(['a', '界']));
    visited.clear();
    assert_equal(text::rfind_by("a界🙂b", predicate), Option::Some(1));
    assert_equal(visited, Vec::from_array(['b', '🙂', '界']));
    testing::assert(text::split_n_checked("", "", 0, -1).is_err());
    testing::assert(text::split_after_checked("x", ",", 0).is_err());
    assert_equal(
        testing::expect_ok(text::split_checked("", "", 0), "empty scalar split"),
        Vec::new(),
    );
    assert_equal(text::split("é界", ""), Vec::from_array(["é界"]));
    assert_equal(
        testing::expect_ok(text::split_checked("é界", "", 2), "scalar split"),
        Vec::from_array(["é", "界"]),
    );
    assert_equal(
        testing::expect_ok(text::split_n_checked("é界🙂", "", 2, 2), "scalar remainder"),
        Vec::from_array(["é", "界🙂"]),
    );
}
