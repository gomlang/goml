package main;

use std::net::url;
use std::bytes;
use std::ffi;
use std::rand;
use std::testing;

#[go_ffi("example.com/goml-std-algorithms/native", "URLEscape")]
extern fn go_url_escape(input: Slice[byte], query: bool) -> string;

#[go_ffi("example.com/goml-std-algorithms/native", "URLUnescape")]
extern fn go_url_unescape(input: string, query: bool) -> (ffi::RawSlice[byte], bool);

#[go_ffi("example.com/goml-std-algorithms/native", "QueryCanonical")]
extern fn go_query_canonical(input: string) -> (string, bool);

fn check_escape_bytes(input: Slice[byte]) -> () {
    for query in[false, true] {
        let mode = if query {
            url::EscapeMode::QueryComponent
        } else {
            url::EscapeMode::PathSegment
        };
        let reference = go_url_escape(input, query);
        let encoded = testing::expect_ok(
            url::escape(input, mode, reference.byte_len()),
            "URL escape",
        );
        assert_equal(encoded, reference);
        if reference.byte_len() > 0 {
            assert_equal(
                testing::expect_err(
                    url::escape(input, mode, reference.byte_len() - 1),
                    "escape byte limit",
                ).kind(),
                url::CodecErrorKind::OutputLimit,
            );
        }
        for escaped in[encoded, encoded.to_ascii_lowercase()] {
            let (expected, valid) = go_url_unescape(escaped, query);
            testing::assert(valid);
            let decoded = testing::expect_ok(
                url::unescape(escaped, mode, input.len()),
                "URL unescape",
            );
            assert_equal(decoded.to_vec(), expected.as_slice().to_vec());
        }
        assert_equal(
            testing::expect_ok(url::unescape(encoded, mode, input.len()), "URL roundtrip").to_vec(),
            input.to_vec(),
        );
        if input.len() > 0 {
            assert_equal(
                testing::expect_err(
                    url::unescape(encoded, mode, input.len() - 1),
                    "unescape byte limit",
                ).kind(),
                url::CodecErrorKind::OutputLimit,
            );
        }
    }
}

fn check_url_codecs() -> () {
    let empty_pairs = testing::expect_ok(url::parse_query("=&=", 2, 0), "empty query pairs");
    let indexed_error = testing::expect_err(
        url::encode_query(empty_pairs.as_slice(), 1),
        "pair index error",
    );
    assert_equal(indexed_error.index(), 1);
    assert_equal(indexed_error.to_string(), "URL codec output exceeds byte limit at index 1");
    for count in 0..65 {
        let fields: Vec[(bytes::Bytes, bytes::Bytes)] = Vec::new();
        let mut raw = "";
        let mut decoded_length = 0;
        for index in 0..count {
            let name = bytes::Bytes::from_vec(rand::bytes((index % 7).to_u64(), index % 7));
            let value = bytes::Bytes::from_vec(
                rand::bytes((count * 100 + index).to_u64(), index % 11),
            );
            decoded_length += name.len() + value.len();
            if index > 0 {
                raw += "&";
            }
            raw += go_url_escape(name.as_slice(), true) + "="
                + go_url_escape(value.as_slice(), true);
            fields.push((name, value));
        }
        let (expected, valid) = go_query_canonical(raw);
        testing::assert(valid);
        let actual = testing::expect_ok(
            url::encode_query(fields.as_slice(), expected.byte_len()),
            "random query encode",
        );
        assert_equal(actual, expected);
        let decoded = testing::expect_ok(
            url::parse_query(raw, count, decoded_length),
            "random query parse",
        );
        assert_equal(decoded.len(), count);
        for index in 0..count {
            assert_equal(decoded[index].0.to_vec(), fields[index].0.to_vec());
            assert_equal(decoded[index].1.to_vec(), fields[index].1.to_vec());
        }
    }
    for value in 0..256 {
        check_escape_bytes(Vec::from_array([value.to_u8()]).as_slice());
    }
    for length in 0..129 {
        check_escape_bytes(rand::bytes(length.to_u64(), length).as_slice());
    }
    for text in["", "a b+c/%", "!$&'()*+,;=:@/?#[]", "你好🙂", "\n\r\t"] {
        assert_equal(
            testing::expect_ok(url::path_escape(text, 1000), "path text"),
            go_url_escape(text.to_bytes().as_slice(), false),
        );
        assert_equal(
            testing::expect_ok(url::query_escape(text, 1000), "query text"),
            go_url_escape(text.to_bytes().as_slice(), true),
        );
    }
    for text in["%", "%0", "%GG", "x%2x", "%%20", "界%G0", "a+b", "%00%FF%C0%AF"] {
        for query in[false, true] {
            let (expected, valid) = go_url_unescape(text, query);
            let actual = if query {
                url::query_unescape(text, 1000)
            } else {
                url::path_unescape(text, 1000)
            };
            assert_equal(actual.is_ok(), valid);
            if valid {
                assert_equal(
                    testing::expect_ok(actual, "valid escape").to_vec(),
                    expected.as_slice().to_vec(),
                );
            } else {
                assert_equal(
                    testing::expect_err(actual, "invalid escape").kind(),
                    url::CodecErrorKind::InvalidEscape,
                );
            }
        }
    }
    assert_equal(testing::expect_err(url::path_unescape("界%", 100), "escape offset").index(), 3);
    assert_equal(
        testing::expect_err(url::path_escape("", -1), "negative limit").kind(),
        url::CodecErrorKind::InvalidLimit,
    );
    assert_equal(
        testing::expect_err(url::query_unescape("", -1), "negative decode limit").kind(),
        url::CodecErrorKind::InvalidLimit,
    );
    for input in[
        "",
        "&&",
        "=",
        "a&b=2&a=3",
        "b=first&a=x&b=second",
        "x=a=b",
        "x=a+b&x=a%2Bb",
        "%FF=%00&%00=%FF",
        "a=%3B",
        "世界=🙂&a=",
        "a=%",
        "a=ok&b=%GG",
        "a=1;b=2",
    ] {
        let (canonical, valid) = go_query_canonical(input);
        let actual = url::parse_query(input, 20, 1000);
        assert_equal(actual.is_ok(), valid);
        if valid {
            let fields = testing::expect_ok(actual, "query parse");
            let mut decoded_length = 0;
            for field in fields {
                decoded_length += field.0.len() + field.1.len();
            }
            testing::expect_ok(
                url::parse_query(input, fields.len(), decoded_length),
                "exact query limits",
            );
            if fields.len() > 0 {
                assert_equal(
                    testing::expect_err(
                        url::parse_query(input, fields.len() - 1, 1000),
                        "query field limit",
                    ).kind(),
                    url::CodecErrorKind::FieldLimit,
                );
            }
            if decoded_length > 0 {
                assert_equal(
                    testing::expect_err(
                        url::parse_query(input, 20, decoded_length - 1),
                        "query decoded limit",
                    ).kind(),
                    url::CodecErrorKind::OutputLimit,
                );
            }
            let encoded = testing::expect_ok(
                url::encode_query(fields.as_slice(), canonical.byte_len()),
                "query encode",
            );
            assert_equal(encoded, canonical);
            if canonical.byte_len() > 0 {
                assert_equal(
                    testing::expect_err(
                        url::encode_query(fields.as_slice(), canonical.byte_len() - 1),
                        "encoded query limit",
                    ).kind(),
                    url::CodecErrorKind::OutputLimit,
                );
            }
            let repeated = testing::expect_ok(
                url::parse_query(encoded, 20, 1000),
                "canonical parse",
            );
            assert_equal(
                testing::expect_ok(url::encode_query(repeated.as_slice(), 1000), "canonical encode"),
                canonical,
            );
        }
    }
    let fields = testing::expect_ok(
        url::parse_query("b=first&a=x&b=last", 3, 14),
        "query ownership",
    );
    assert_equal(fields[0].0.to_vec(), b"b");
    assert_equal(
        testing::expect_ok(url::encode_query(fields.as_slice(), 100), "query ordering"),
        "a=x&b=first&b=last",
    );
    assert_equal(fields[0].0.to_vec(), b"b");
    fields[0].0.set(0, b'z');
    assert_equal(fields[2].0.to_vec(), b"b");
    assert_equal(testing::expect_err(url::parse_query("a&b", 1, 10), "field position").index(), 2);
    assert_equal(
        testing::expect_err(url::parse_query("a=x&b=%", 3, 100), "escape query position").index(),
        6,
    );
    assert_equal(
        testing::expect_err(url::parse_query("a=1;b=2", 3, 100), "semicolon position").index(),
        3,
    );
    assert_equal(
        testing::expect_err(url::parse_query("", -1, 0), "negative field limit").kind(),
        url::CodecErrorKind::InvalidLimit,
    );
    assert_equal(
        testing::expect_err(url::parse_query("", 0, -1), "negative byte limit").kind(),
        url::CodecErrorKind::InvalidLimit,
    );
    let empty: Vec[(bytes::Bytes, bytes::Bytes)] = Vec::new();
    assert_equal(testing::expect_ok(url::encode_query(empty.as_slice(), 0), "empty query"), "");
    assert_equal(
        testing::expect_err(url::encode_query(empty.as_slice(), -1), "negative encode limit").kind(),
        url::CodecErrorKind::InvalidLimit,
    );
}
