package main;

use std::io;
use io::{Read, Write, Seek};
use std::bytes;
use std::testing;

fn seek_position[S: Seek](stream: S, from: io::SeekFrom) -> Result[isize, io::Error] {
    stream.seek(from)
}

fn seek_read_byte[S: Read + Seek](stream: S, from: io::SeekFrom) -> Result[Option[byte], io::Error] {
    stream.seek(from)?;
    let output = b"?";
    let count = stream.read(output.as_mut_slice())?;
    Result::Ok(
        if count == 0 {
            Option::None
        } else {
            Option::Some(output[0])
        },
    )
}

fn check_seek_invalid(result: Result[isize, io::Error]) -> () {
    match result {
        Err(error) => assert_equal(error.kind(), io::ErrorKind::InvalidInput),
        Ok(_) => testing::fail("invalid seek must fail"),
    }
}

fn check_io_seek() -> () {
    let maximum = 9223372036854775807;
    let minimum = -maximum - 1;
    for value in["", "abc", "é界🙂"] {
        let length = value.byte_len();
        for start in 0..length + 1 {
            for target in 0..length + 1 {
                for origin in 0..3 {
                    let cursor = testing::expect_ok(
                        io::Cursor::with_limit(bytes::Bytes::from_string(value), length + 10),
                        "seek cursor",
                    );
                    let alias = cursor;
                    testing::expect_ok(cursor.set_position(start), "initial position");
                    let from = match origin {
                        0 => io::SeekFrom::Start(target),
                        1 => io::SeekFrom::Current(target - start),
                        _ => io::SeekFrom::End(target - length),
                    };
                    assert_equal(
                        testing::expect_ok(seek_position(alias, from), "generic cursor seek"),
                        target,
                    );
                    assert_equal(cursor.position(), target);
                    assert_equal(cursor.bytes().to_vec(), value.to_bytes());
                    let string_reader = io::StringReader::new(value);
                    testing::expect_ok(
                        seek_position(string_reader, io::SeekFrom::Start(start)),
                        "initial string position",
                    );
                    assert_equal(
                        testing::expect_ok(
                            seek_position(string_reader, from),
                            "generic string seek",
                        ),
                        target,
                    );
                    let expected = if target == length {
                        Option::None
                    } else {
                        Option::Some(value.byte_get(target))
                    };
                    assert_equal(
                        testing::expect_ok(
                            seek_read_byte(cursor, io::SeekFrom::Current(0)),
                            "cursor seek read",
                        ),
                        expected,
                    );
                    assert_equal(
                        testing::expect_ok(
                            seek_read_byte(string_reader, io::SeekFrom::Current(0)),
                            "string seek read",
                        ),
                        expected,
                    );
                }
            }
            let cursor = testing::expect_ok(
                io::Cursor::with_limit(bytes::Bytes::from_string(value), length + 10),
                "bounded seek cursor",
            );
            testing::expect_ok(cursor.set_position(start), "invalid cursor starting position");
            for from in[
                io::SeekFrom::Start(-1),
                io::SeekFrom::Start(minimum),
                io::SeekFrom::Start(length + 1),
                io::SeekFrom::Start(maximum),
                io::SeekFrom::Current(-start - 1),
                io::SeekFrom::Current(minimum),
                io::SeekFrom::Current(maximum),
                io::SeekFrom::End(1),
                io::SeekFrom::End(-length - 1),
                io::SeekFrom::End(minimum),
                io::SeekFrom::End(maximum),
            ] {
                check_seek_invalid(seek_position(cursor, from));
                assert_equal(cursor.position(), start);
                assert_equal(cursor.bytes().to_vec(), value.to_bytes());
            }
        }
        let reader = io::StringReader::new(value);
        let alias = reader;
        assert_equal(
            testing::expect_ok(seek_position(alias, io::SeekFrom::End(5)), "string beyond EOF"),
            length + 5,
        );
        assert_equal(reader.position(), length + 5);
        assert_equal(reader.len(), 0);
        assert_equal(
            testing::expect_ok(seek_read_byte(reader, io::SeekFrom::Current(0)), "beyond EOF read"),
            Option::None,
        );
        assert_equal(
            testing::expect_ok(
                seek_position(reader, io::SeekFrom::Start(maximum)),
                "maximum string offset",
            ),
            maximum,
        );
        check_seek_invalid(seek_position(reader, io::SeekFrom::Current(1)));
        assert_equal(alias.position(), maximum);
        check_seek_invalid(seek_position(reader, io::SeekFrom::Current(minimum)));
        assert_equal(alias.position(), maximum);
        assert_equal(
            testing::expect_ok(
                seek_position(reader, io::SeekFrom::Current(-maximum)),
                "return from maximum",
            ),
            0,
        );
        check_seek_invalid(seek_position(reader, io::SeekFrom::Start(minimum)));
        assert_equal(reader.position(), 0);
        if length > 0 {
            check_seek_invalid(seek_position(reader, io::SeekFrom::End(maximum)));
            assert_equal(reader.position(), 0);
        }
    }
    let reader = io::StringReader::new("é界");
    let alias = reader;
    assert_equal(reader.read_char(), Option::Some(('é', 2)));
    check_seek_invalid(seek_position(alias, io::SeekFrom::Current(minimum)));
    assert_equal(reader.position(), 2);
    testing::assert(reader.unread_char().is_err());
    assert_equal(
        testing::expect_ok(seek_position(reader, io::SeekFrom::Start(1)), "inside UTF8"),
        1,
    );
    assert_equal(reader.read_char(), Option::Some(('�', 1)));
    testing::expect_ok(reader.unread_char(), "rollback replacement byte");
    assert_equal(alias.position(), 1);
    let cursor = testing::expect_ok(
        io::Cursor::with_limit(bytes::Bytes::new(), 5),
        "growing cursor",
    );
    assert_equal(
        testing::expect_ok(seek_position(cursor, io::SeekFrom::End(0)), "empty cursor end"),
        0,
    );
    check_seek_invalid(seek_position(cursor, io::SeekFrom::Start(1)));
    testing::expect_ok(cursor.write_all(b"abc".as_slice()), "grow cursor");
    assert_equal(testing::expect_ok(seek_position(cursor, io::SeekFrom::End(-1)), "new end"), 2);
    testing::expect_ok(cursor.write_all(b"XY".as_slice()), "overwrite and grow");
    assert_equal(cursor.bytes().to_vec(), b"abXY");
    assert_equal(testing::expect_ok(seek_position(cursor, io::SeekFrom::End(0)), "updated end"), 4);
    check_seek_invalid(seek_position(cursor, io::SeekFrom::End(1)));
    assert_equal(cursor.position(), 4);
    assert_equal(cursor.bytes().to_vec(), b"abXY");
}
