package main;

use std::num;
use std::testing;

#[go_ffi("example.com/goml-std-algorithms/native", "ParseBool")]
extern fn go_parse_bool(value: string) -> (bool, bool);

fn check_boolean_case(value: string) -> () {
    let (expected, valid) = go_parse_bool(value);
    let actual = num::parse_bool_structured(value);
    assert_equal(actual.is_ok(), valid);
    match actual {
        Ok(parsed) => {
            assert_equal(parsed, expected);
            assert_equal(
                testing::expect_ok(
                    num::parse_bool_structured(parsed.to_string()),
                    "boolean roundtrip",
                ),
                parsed,
            );
        },
        Err(error) => {
            assert_equal(error.input(), value);
            assert_equal(error.to_string(), "invalid boolean syntax");
            assert_equal(error.debug(), "invalid boolean syntax");
        },
    }
}

fn check_boolean_parsing() -> () {
    for word in["true", "false"] {
        for mask in 0..(1 << word.byte_len()) {
            let mut variant = "";
            for index in 0..word.byte_len() {
                let byte_value = word.byte_get(index);
                let cased = if mask & (1 << index) == 0 {
                    byte_value
                } else {
                    byte_value - 32
                };
                variant += char_from_u32(cased.to_u32()).unwrap_or('?').to_string();
            }
            check_boolean_case(variant);
            for extra in[" ", "\n", "\r", "\t", "　", "+", "-", "0", "1", "x"] {
                check_boolean_case(extra + variant);
                check_boolean_case(variant + extra);
            }
        }
    }
    for code in 0..128 {
        let value = char_from_u32(code.to_u32()).unwrap_or('?').to_string();
        check_boolean_case(value);
        check_boolean_case("true" + value);
        check_boolean_case(value + "false");
    }
    for value in["", "01", "00", "yes", "no", "on", "off", "ＴＲＵＥ", "１", "０", "truefalse"] {
        check_boolean_case(value);
    }
    for value in["1", "0", "t", "T", "f", "F"] {
        check_boolean_case(value);
    }
}
