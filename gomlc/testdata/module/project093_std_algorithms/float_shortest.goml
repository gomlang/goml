package main;

use std::num;
use std::testing;

fn shortest_notations() -> Vec[(num::FloatNotation, byte)] {
    Vec::from_array(
        [
            (num::FloatNotation::Fixed, b'f'),
            (num::FloatNotation::Scientific, b'e'),
            (num::FloatNotation::ScientificUpper, b'E'),
            (num::FloatNotation::General, b'g'),
            (num::FloatNotation::GeneralUpper, b'G'),
        ],
    )
}

fn check_shortest64(bits: u64) -> () {
    let value = float64_from_bits(bits);
    for (notation, code) in shortest_notations() {
        let expected = go_format_float(value, code, -1, 64);
        let actual = testing::expect_ok(
            num::format_float64_shortest(value, notation, expected.byte_len()),
            "shortest64",
        );
        testing::assert_eq(actual, expected);
        testing::assert(
            num::format_float64_shortest(value, notation, expected.byte_len() - 1).is_err(),
        );
    }
}

fn check_shortest32(bits: u32) -> () {
    let value = float32_from_bits(bits);
    for (notation, code) in shortest_notations() {
        let expected = go_format_float(float32_to_float64(value), code, -1, 32);
        let actual = testing::expect_ok(
            num::format_float32_shortest(value, notation, expected.byte_len()),
            "shortest32",
        );
        testing::assert_eq(actual, expected);
        testing::assert(
            num::format_float32_shortest(value, notation, expected.byte_len() - 1).is_err(),
        );
    }
}

fn check_float_shortest() -> () {
    let special32: Vec[u32] = Vec::from_array(
        [0, 1, 2, 8388607, 8388608, 2139095039, 2139095040, 2143289344],
    );
    for bits in special32 {
        check_shortest32(bits);
        check_shortest32(bits | (1.to_u32() << 31));
    }
    let special: Vec[u64] = Vec::from_array(
        [
            0,
            1,
            2,
            4503599627370495,
            4503599627370496,
            9218868437227405311,
            9218868437227405312,
            9221120237041090560,
        ],
    );
    for bits in special {
        check_shortest64(bits);
        check_shortest64(bits | (1.to_u64() << 63));
    }
    let mut exponent = 1;
    while exponent < 2047 {
        let center = exponent.to_u64() << 52;
        for bits in[center - 1, center, center + 1] {
            check_shortest64(bits);
            check_shortest64(bits | (1.to_u64() << 63));
        }
        exponent += 61;
    }
    exponent = 0;
    while exponent < 256 {
        for fraction in[0.to_u32(), 1.to_u32(), 8388607.to_u32()] {
            let bits = (exponent.to_u32() << 23) | fraction;
            check_shortest32(bits);
            check_shortest32(bits | (1.to_u32() << 31));
        }
        exponent += 7;
    }
    let mut state: u64 = 1082269761;
    for _ in 0..128 {
        state = state ^ (state << 13);
        state = state ^ (state >> 7);
        state = state ^ (state << 17);
        check_shortest64(state);
        check_shortest32(state.to_u32());
    }
    for value in[
        1.0,
        0.0001,
        0.00001,
        100000.0,
        1000000.0,
        1.0000000000000002,
        0.1,
        1.2345678901234567,
    ] {
        check_shortest64(float64_to_bits(value));
    }
    for (notation, _) in shortest_notations() {
        testing::assert(num::format_float64_shortest(1.0, notation, -1).is_err());
        testing::assert(num::format_float32_shortest(float32_from_bits(0), notation, -1).is_err());
    }
}
