package main;

use std::num;
use std::testing;

#[go_ffi("strconv", "FormatFloat")]
extern fn go_format_float(value: f64, format: byte, precision: isize, bits: isize) -> string;

fn check_fixed64(value: f64, precision: isize) -> () {
    for uppercase in[false, true] {
        let general = go_format_float(
            value,
            if uppercase {
                b'G'
            } else {
                b'g'
            },
            precision,
            64,
        );
        testing::assert_eq(
            testing::expect_ok(
                num::format_float64_general(value, precision, uppercase, general.byte_len()),
                "general64",
            ),
            general,
        );
        testing::assert(
            num::format_float64_general(value, precision, uppercase, general.byte_len() - 1).is_err(),
        );
        let expected = go_format_float(
            value,
            if uppercase {
                b'E'
            } else {
                b'e'
            },
            precision,
            64,
        );
        testing::assert_eq(
            testing::expect_ok(
                num::format_float64_scientific(value, precision, uppercase, expected.byte_len()),
                "scientific64",
            ),
            expected,
        );
        testing::assert(
            num::format_float64_scientific(value, precision, uppercase, expected.byte_len() - 1).is_err(),
        );
    }
    let expected = go_format_float(value, b'f', precision, 64);
    let actual = testing::expect_ok(
        num::format_float64_fixed(value, precision, expected.byte_len()),
        "fixed64",
    );
    assert_equal(actual, expected);
    testing::assert(num::format_float64_fixed(value, precision, expected.byte_len() - 1).is_err());
}

fn check_fixed32(value: f32, precision: isize) -> () {
    for uppercase in[false, true] {
        let general = go_format_float(
            float32_to_float64(value),
            if uppercase {
                b'G'
            } else {
                b'g'
            },
            precision,
            32,
        );
        testing::assert_eq(
            testing::expect_ok(
                num::format_float32_general(value, precision, uppercase, general.byte_len()),
                "general32",
            ),
            general,
        );
        testing::assert(
            num::format_float32_general(value, precision, uppercase, general.byte_len() - 1).is_err(),
        );
        let expected = go_format_float(
            float32_to_float64(value),
            if uppercase {
                b'E'
            } else {
                b'e'
            },
            precision,
            32,
        );
        testing::assert_eq(
            testing::expect_ok(
                num::format_float32_scientific(value, precision, uppercase, expected.byte_len()),
                "scientific32",
            ),
            expected,
        );
        testing::assert(
            num::format_float32_scientific(value, precision, uppercase, expected.byte_len() - 1).is_err(),
        );
    }
    let expected = go_format_float(float32_to_float64(value), b'f', precision, 32);
    let actual = testing::expect_ok(
        num::format_float32_fixed(value, precision, expected.byte_len()),
        "fixed32",
    );
    assert_equal(actual, expected);
    testing::assert(num::format_float32_fixed(value, precision, expected.byte_len() - 1).is_err());
}

fn check_float_fixed() -> () {
    for value in[0.00009999, 0.0001, 0.00001, 999.5, 9999.5, 100000.0, 1.0, 1.25, -0.00009999] {
        for precision in[0, 1, 2, 4, 6, 9] {
            check_fixed64(value, precision);
        }
    }
    testing::assert_eq(
        testing::expect_ok(
            num::format_float64_general(1.25, 9223372036854775807, false, 4),
            "large general precision",
        ),
        "1.25",
    );
    testing::assert(num::format_float64_general(1.0, -1, false, 10).is_err());
    testing::assert(num::format_float64_general(1.0, 1, false, -1).is_err());
    testing::assert_eq(
        testing::expect_ok(num::format_float64_scientific(9.5, 0, false, 5), "carry exponent"),
        "1e+01",
    );
    testing::assert_eq(
        testing::expect_ok(
            num::format_float64_scientific(-0.0, 2, true, 9),
            "signed scientific zero",
        ),
        "-0.00E+00",
    );
    testing::assert(num::format_float64_scientific(1.0, 9223372036854775807, false, 10).is_err());
    testing::assert(num::format_float64_scientific(1.0, -1, false, 10).is_err());
    testing::assert(num::format_float64_scientific(1.0, 0, false, -1).is_err());
    for value in[
        0.0,
        -0.0,
        0.5,
        1.5,
        2.5,
        3.5,
        -0.5,
        -1.5,
        -2.5,
        0.125,
        0.375,
        9.995,
        99.999,
        2.675,
        1.005,
    ] {
        for precision in[0, 1, 2, 3, 6, 17] {
            check_fixed64(value, precision);
        }
    }
    let patterns: Vec[u64] = Vec::from_array(
        [
            0,
            1,
            2,
            4503599627370495,
            4503599627370496,
            9218868437227405311,
            9218868437227405312,
            9221120237041090560,
        ],
    );
    let mut exponent = 0;
    while exponent < 2047 {
        for fraction in[0.to_u64(), 1.to_u64(), 4503599627370495.to_u64()] {
            patterns.push((exponent.to_u64() << 52) | fraction);
        }
        exponent += 127;
    }
    for pattern in patterns {
        for sign in[0.to_u64(), 1.to_u64() << 63] {
            for precision in[0, 2, 17] {
                check_fixed64(float64_from_bits(pattern | sign), precision);
            }
        }
    }
    for precision in[323, 324, 325, 1074] {
        check_fixed64(float64_from_bits(1), precision);
    }
    for pattern in[
        0.to_u32(),
        1.to_u32(),
        8388607.to_u32(),
        8388608.to_u32(),
        2139095039.to_u32(),
        2139095040.to_u32(),
        2143289344.to_u32(),
    ] {
        for sign in[0.to_u32(), 2147483648.to_u32()] {
            for precision in[0, 2, 9, 46] {
                check_fixed32(float32_from_bits(pattern | sign), precision);
            }
        }
    }
    for precision in[0, 1, 2, 3] {
        for bits in[
            4602678819172646911.to_u64(),
            4602678819172646912.to_u64(),
            4602678819172646913.to_u64(),
        ] {
            check_fixed64(float64_from_bits(bits), precision);
        }
    }
    match num::format_float64_fixed(1.0, -1, 10) {
        Err(num::FormatFloatError::InvalidPrecision(value)) => assert_equal(value, -1),
        _ => testing::fail("negative decimal places accepted"),
    }
    match num::format_float64_fixed(1.0, -1, -1) {
        Err(num::FormatFloatError::InvalidLimit(value)) => assert_equal(value, -1),
        _ => testing::fail("negative limit precedence"),
    }
    testing::assert(num::format_float64_fixed(1.0, 9223372036854775807, 10).is_err());
    assert_equal(
        testing::expect_ok(
            num::format_float64_fixed(
                float64_from_bits(9218868437227405312),
                9223372036854775807,
                4,
            ),
            "infinite precision ignored",
        ),
        "+Inf",
    );
}
