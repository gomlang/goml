package main;

use std::text;
use std::testing;

#[go_ffi("example.com/goml-std-algorithms/native", "ReplaceMany")]
extern fn go_replace_many(value: string, old: Slice[string], replacement: Slice[string]) -> string;

#[go_ffi("example.com/goml-std-algorithms/native", "ReplaceScalarMany")]
extern fn go_replace_scalar_many(value: string, old: Slice[string], replacement: Slice[string]) -> string;

fn check_replacer_rules(rules: Vec[(string, string)]) -> () {
    let old: Vec[string] = Vec::new();
    let replacement: Vec[string] = Vec::new();
    let mut bytes = 0;
    let mut empty = false;
    for (key, value) in rules {
        old.push(key);
        replacement.push(value);
        bytes += key.byte_len() + value.byte_len();
        empty = empty || key.byte_len() == 0;
    }
    let compiled = testing::expect_ok(
        text::Replacer::new(rules.as_slice(), rules.len(), bytes),
        "compile replacement",
    );
    if rules.len() > 0 {
        testing::assert(text::Replacer::new(rules.as_slice(), rules.len() - 1, bytes).is_err());
    }
    if bytes > 0 {
        testing::assert(text::Replacer::new(rules.as_slice(), rules.len(), bytes - 1).is_err());
    }
    for value in["", "a", "b", "aa", "ab", "ba", "aba", "aaaa", "界🙂a界", "éaé"] {
        let expected = go_replace_scalar_many(value, old.as_slice(), replacement.as_slice());
        if !empty || text::is_ascii(value) {
            assert_equal(expected, go_replace_many(value, old.as_slice(), replacement.as_slice()));
        }
        let parts = testing::expect_ok(
            compiled.chunks(value, expected.byte_len(), 10000),
            "replacement chunks",
        );
        let collected = text::StringBuilder::new();
        for part in parts {
            let part = testing::expect_ok(part, "replacement chunk");
            testing::assert(part.byte_len() > 0);
            collected.write_string(part);
        }
        assert_equal(collected.finish(), expected);
        testing::assert(parts.next().is_none());
        testing::assert(parts.next().is_none());
        assert_equal(
            testing::expect_ok(
                compiled.replace(value, expected.byte_len(), 10000),
                "replace exact bound",
            ),
            expected,
        );
        if expected.byte_len() > 0 {
            match compiled.replace(value, expected.byte_len() - 1, 10000) {
                Err(text::ReplaceError::OutputLimit(limit)) => assert_equal(
                    limit,
                    expected.byte_len() - 1,
                ),
                _ => testing::fail("replacement output limit ignored"),
            }
        }
        testing::assert(compiled.replace(value, 1000, 0).is_err());
        assert_equal(
            testing::expect_ok(compiled.replace(value, 1000, 10000), "replacement retry"),
            expected,
        );
    }
}

fn check_replacers() -> () {
    let identity = testing::expect_ok(text::Replacer::new(Vec::new().as_slice(), 0, 0), "identity");
    let limited = testing::expect_ok(identity.chunks("a界b", 3, 100), "lazy output limit");
    assert_equal(
        testing::expect_ok(testing::expect_some(limited.next(), "first chunk"), "first result"),
        "a",
    );
    match limited.next() {
        Some(Err(text::ReplaceError::OutputLimit(limit))) => assert_equal(limit, 3),
        _ => testing::fail("chunk output failure missing"),
    }
    testing::assert(limited.next().is_none());
    testing::assert(limited.next().is_none());
    let work = testing::expect_ok(identity.chunks("ab", 2, 2), "lazy work limit");
    assert_equal(
        testing::expect_ok(testing::expect_some(work.next(), "work first"), "work first result"),
        "a",
    );
    match work.next() {
        Some(Err(text::ReplaceError::WorkLimit(limit))) => assert_equal(limit, 2),
        _ => testing::fail("chunk work failure missing"),
    }
    testing::assert(work.next().is_none());
    let shared = testing::expect_ok(identity.chunks("ab", 2, 100), "shared chunks");
    let alias = shared;
    assert_equal(
        testing::expect_ok(testing::expect_some(shared.next(), "shared first"), "shared result"),
        "a",
    );
    assert_equal(
        testing::expect_ok(testing::expect_some(alias.next(), "shared second"), "alias result"),
        "b",
    );
    testing::assert(shared.next().is_none());
    testing::assert(identity.chunks("", -1, 0).is_err());
    testing::assert(identity.chunks("", 0, -1).is_err());
    let pattern = testing::expect_ok(text::repeat_checked("a", 127, 127), "long pattern") + "b";
    let repetitive = testing::expect_ok(text::repeat_checked("a", 1024, 1024), "repetitive input");
    let bounded = testing::expect_ok(
        text::Replacer::new(Vec::from_array([(pattern, "x")]).as_slice(), 1, 129),
        "adversarial replacer",
    );
    match bounded.replace(repetitive, 1024, 32) {
        Err(text::ReplaceError::WorkLimit(limit)) => assert_equal(limit, 32),
        _ => testing::fail("adversarial replacement exceeded work budget"),
    }
    assert_equal(
        testing::expect_ok(bounded.replace(repetitive, 1024, 1000000), "adversarial retry"),
        repetitive,
    );
    for first in["", "a", "aa", "ab", "b"] {
        for second in["", "a", "aa", "ab", "b"] {
            for left in["", "x", "ab"] {
                for right in["", "y", "a"] {
                    check_replacer_rules(Vec::from_array([(first, left), (second, right)]));
                }
            }
        }
    }
    check_replacer_rules(Vec::new());
    check_replacer_rules(Vec::from_array([("界", "🙂"), ("🙂a", "界"), ("", "-")]));
    let rules = Vec::from_array([("a", "x")]);
    let compiled = testing::expect_ok(
        text::Replacer::new(rules.as_slice(), 1, 2),
        "snapshot replacer",
    );
    rules[0] = ("a", "changed");
    rules.push(("", "ignored"));
    assert_equal(testing::expect_ok(compiled.replace("a", 1, 3), "exact matching work"), "x");
    match compiled.replace("a", 1, 2) {
        Err(text::ReplaceError::WorkLimit(limit)) => assert_equal(limit, 2),
        _ => testing::fail("replacement work limit ignored"),
    }
    for limit in[-1, -9223372036854775807 - 1] {
        testing::assert(text::Replacer::new(rules.as_slice(), limit, 100).is_err());
        testing::assert(text::Replacer::new(rules.as_slice(), 10, limit).is_err());
        testing::assert(compiled.replace("a", limit, 100).is_err());
        testing::assert(compiled.replace("a", 100, limit).is_err());
    }
    let scalar = testing::expect_ok(
        text::Replacer::new(Vec::from_array([("", "-")]).as_slice(), 1, 1),
        "empty pattern",
    );
    assert_equal(testing::expect_ok(scalar.replace("界🙂", 10, 100), "scalar boundaries"), "-界-🙂-");
}
