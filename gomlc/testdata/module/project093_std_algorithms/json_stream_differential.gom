package main;

use std::json;
use std::testing;
use std::text;

#[go_ffi("example.com/goml-std-algorithms/native", "JSONTokens")]
extern fn go_json_tokens(input: string) -> (bool, string);

fn json_token_fingerprint(input: string, step: isize) -> Result[string, json::Error] {
    let decoder = json_decode_new(
        json_decode_probe(input.to_bytes(), step, 0, 0),
        json_decode_limits(),
    );
    let output = text::StringBuilder::new();
    loop {
        let Some(token) = decoder.next_token()? else {
            break
        };
        output.write_string(
            match token {
                StartArray => "[",
                EndArray => "]",
                StartObject => "{",
                EndObject => "}",
                Key(value) | String(value) => "s" + value.byte_len().to_string() + ":" + value + ";",
                Number(value) => "n" + value + ";",
                Bool(value) => value.to_string() + ";",
                Null => "null;",
            },
        );
    }
    decoder.finish()?;
    Result::Ok(output.to_string())
}

fn json_compare_go(input: string) -> () {
    let (valid, expected) = go_json_tokens(input);
    for step in[1, 2, 7, 4096] {
        let value = json::parse_with_limits(input, json_decode_limits());
        if value.is_ok() != valid {
            testing::fail("JSON acceptance mismatch: " + input);
        }
        if valid {
            let actual = testing::expect_ok(
                json_token_fingerprint(input, step),
                "JSON token differential",
            );
            testing::assert_eq(actual, expected);
            let value = testing::expect_ok(value, "valid JSON");
            let encoded = testing::expect_ok(
                json::encode_with_limits(value, json_encode_limits()),
                "JSON encode differential",
            );
            let (encoded_valid, encoded_tokens) = go_json_tokens(encoded);
            testing::assert(encoded_valid);
            testing::assert_eq(encoded_tokens, expected);
        }
    }
}

fn test_json_stream_differential() -> () {
    for input in[
        "null",
        "true",
        "false",
        "-0",
        "1.2300e+99",
        "1e-9999",
        "18446744073709551616",
        "[]",
        "{}",
        "{\"x\":1,\"x\":2}",
        "\"中😀\\n\\t\\u0000\"",
        "\"\\ud83d\\ude00\"",
        "[{},[],true,null]",
        "",
        " ",
        "[",
        "{",
        "[1,]",
        "{\"a\":}",
        "01",
        "+1",
        ".1",
        "1.",
        "1e",
        "NaN",
        "true false",
        "{}[]",
        "/*x*/1",
        "[true false]",
        "{\"x\" 1}",
        "[1,,2]",
    ] {
        json_compare_go(input);
    }
    for number in 0..64 {
        let input = "{\"n\":" + number.to_string() + ",\"a\":[-" + number.to_string()
            + ".25e+2,\"é😀\\n\",false]}";
        json_compare_go(input);
        for index in 0..input.byte_len() {
            let byte = input.byte_get(index);
            if byte < 128 {
                json_compare_go(
                    input.byte_slice(0, index) + "#" + input.byte_slice(index + 1, input.byte_len()),
                );
            }
        }
    }
    let builder = text::StringBuilder::new();
    for _ in 0..4095 {
        builder.write_string(" ");
    }
    builder.write_string("\"😀\"");
    let input = builder.to_string();
    testing::assert_eq(
        testing::expect_ok(json_token_fingerprint(input, 4096), "UTF-8 transport boundary"),
        "s4:😀;",
    );
}
