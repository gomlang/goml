package main;

use std::bytes;
use std::text;
use std::unicode;
use std::testing;

#[go_ffi("strings", "Title")]
extern fn go_legacy_word_title(value: string) -> string;

#[go_ffi("strings", "ToTitle")]
extern fn go_scalar_title(value: string) -> string;

fn legacy_title_separator(value: char) -> bool {
    if value.to_u32() <= 0x7f {
        !((value >= '0' && value <= '9') || (value >= 'a' && value <= 'z')
            || (value >= 'A' && value <= 'Z')
            || value == '_')
    } else {
        !unicode::is_letter(value) && !unicode::is_digit(value) && unicode::is_whitespace(value)
    }
}

fn legacy_word_title_checked(value: string, max_bytes: isize) -> Result[
    string,
    bytes::TransformError,
] {
    let previous = Ref::new(' ');
    text::map_chars(
        value,
        |character: char| {
            let boundary = legacy_title_separator(previous.get());
            previous.set(character);
            Option::Some(
                if boundary {
                    unicode::to_titlecase(character)
                } else {
                    character
                },
            )
        },
        max_bytes,
    )
}

fn check_word_title_case(value: string) -> () {
    let expected = go_legacy_word_title(value);
    let limit = expected.byte_len();
    assert_equal(
        testing::expect_ok(legacy_word_title_checked(value, limit), "legacy title exact limit"),
        expected,
    );
    if limit > 0 {
        match legacy_word_title_checked(value, limit - 1) {
            Err(bytes::TransformError::LimitExceeded(actual)) => assert_equal(actual, limit - 1),
            _ => testing::fail("legacy title must reject insufficient output limit"),
        }
    }
    for negative in[-1, -9223372036854775807 - 1] {
        match legacy_word_title_checked(value, negative) {
            Err(bytes::TransformError::InvalidLimit(actual)) => assert_equal(actual, negative),
            _ => testing::fail("legacy title must reject negative limit"),
        }
    }
    assert_equal(
        testing::expect_ok(legacy_word_title_checked(value, limit + 1), "legacy title fresh retry"),
        expected,
    );
    let scalar = go_scalar_title(value);
    assert_equal(
        testing::expect_ok(
            text::case_checked(value, unicode::Case::Title, scalar.byte_len()),
            "scalar title",
        ),
        scalar,
    );
}

fn check_text_word_title() -> () {
    for value in[
        "",
        "hello world",
        "hELLO",
        "foo-bar",
        "foo_bar",
        "123abc",
        "don't",
        "foo—bar",
        "foo’bar",
        "a🙂b",
        "áb",
        "́abc",
        "🙂abc",
        "—abc",
        "ǳabc ǆdef ǉghi ǌjkl",
        "aǳb aǆb aǉb aǌb",
        "ßabc ſdef ȿghi ɀjkl",
        "ıabc İdef ȿ ɀ",
        "界abc",
        "١abc",
        "Ⅷabc",
        "²abc",
        "...hello---world",
        "école déjà",
        "a\r\nb\tc",
        "foo-—bar",
        "foo—-bar",
    ] {
        check_word_title_case(value);
    }
    for code in 0..128 {
        let boundary = testing::expect_some(char_from_u32(code.to_u32()), "ASCII boundary").to_string();
        check_word_title_case("a" + boundary + "b");
        check_word_title_case(boundary + "abc" + boundary + boundary + "def");
    }
    let spaces = testing::expect_some(unicode::property("White_Space"), "title whitespace");
    for range in spaces.ranges() {
        for code in range.low.to_isize()..range.high.to_isize() + 1 {
            if spaces.contains_codepoint(code.to_u32()) {
                let space = testing::expect_some(char_from_u32(code.to_u32()), "space boundary").to_string();
                check_word_title_case("a" + space + "b");
                check_word_title_case(space + "ǳabc" + space + "ȿdef");
            }
        }
    }
    for code in[0x200b, 0xfeff, 0x180e, 0x301, 0x2014, 0x2019, 0x1f642] {
        let boundary = testing::expect_some(char_from_u32(code.to_u32()), "nonspace boundary").to_string();
        check_word_title_case("a" + boundary + "b");
    }
    assert_equal(
        testing::expect_ok(legacy_word_title_checked("hello world", 11), "word title"),
        "Hello World",
    );
    assert_equal(
        testing::expect_ok(
            text::case_checked("hello world", unicode::Case::Title, 11),
            "all scalar title",
        ),
        "HELLO WORLD",
    );
    assert_equal(
        testing::expect_ok(legacy_word_title_checked("hELLO world", 11), "preserve interior"),
        "HELLO World",
    );
    assert_equal(
        testing::expect_ok(legacy_word_title_checked("foo—bar", 9), "legacy punctuation"),
        "Foo—bar",
    );
    assert_equal(
        testing::expect_ok(legacy_word_title_checked("foo-bar", 7), "ASCII punctuation"),
        "Foo-Bar",
    );
    assert_equal(testing::expect_ok(legacy_word_title_checked("ǳǳ", 4), "word title digraph"), "ǲǳ");
    assert_equal(
        testing::expect_ok(
            text::case_checked("ǳǳ", unicode::Case::Title, 4),
            "scalar title digraph",
        ),
        "ǲǲ",
    );
    testing::assert(go_legacy_word_title("ȿ").byte_len() > "ȿ".byte_len());
    testing::assert(legacy_word_title_checked("ȿ", "ȿ".byte_len()).is_err());
    assert_equal(testing::expect_ok(legacy_word_title_checked("", 0), "empty word title"), "");
}
