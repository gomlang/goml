package main;

use std::bytes;
use std::encoding::base32;
use std::rand;
use std::testing;
use std::text;

fn check_base32_encoder() -> () {
    let encodings = Vec::new();
    for variant in[
        base32::Variant::Standard,
        base32::Variant::StandardNoPadding,
        base32::Variant::Hex,
        base32::Variant::HexNoPadding,
    ] {
        encodings.push(base32::Encoding::from_variant(variant));
    }
    encodings.push(
        testing::expect_ok(
            base32::Encoding::new("=BCDEFGHIJKLMNOPQRSTUVWXYZ234567", Option::Some(b'!')),
            "custom stream alphabet",
        ),
    );
    encodings.push(
        testing::expect_ok(
            base32::Encoding::new("abcdefghijklmnopqrstuvwxyz234567", Option::Some(0.to_u8())),
            "NUL stream padding",
        ),
    );
    for encoding in encodings {
        let reference = go_base32_padding(
            go_base32(encoding.alphabet()),
            match encoding.padding() {
                Some(value) => value.to_i32(),
                None => -1.to_i32(),
            },
        );
        for length in 0..81 {
            let data = rand::bytes(length.to_u64(), length);
            let expected = go_base32_encode(reference, data.as_slice());
            for chunk in 1..13 {
                let encoder = testing::expect_ok(
                    base32::Encoder::new(encoding, expected.byte_len()),
                    "encoder",
                );
                let alias = encoder;
                let output = text::StringBuilder::new();
                let mut offset = 0;
                while offset < length {
                    let end = if length - offset < chunk {
                        length
                    } else {
                        offset + chunk
                    };
                    output.write_string(
                        testing::expect_ok(alias.update(data.slice(offset, end)), "encoder update"),
                    );
                    assert_equal(encoder.input_len(), end);
                    assert_equal(encoder.output_len(), output.len());
                    testing::assert(!encoder.is_finished());
                    offset = end;
                }
                output.write_string(testing::expect_ok(encoder.finish(), "encoder finish"));
                assert_equal(output.finish(), expected);
                assert_equal(encoder.output_len(), expected.byte_len());
                testing::assert(alias.is_finished());
                assert_equal(testing::expect_ok(alias.finish(), "idempotent finish"), "");
                testing::assert(encoder.update(data.slice(0, 0)).is_err());
                alias.reset();
                assert_equal(encoder.input_len(), 0);
                assert_equal(encoder.output_len(), 0);
                testing::assert(!encoder.is_finished());
                let single = testing::expect_ok(encoder.update(data.as_slice()), "reset update")
                    + testing::expect_ok(encoder.finish(), "reset finish");
                assert_equal(single, expected);
            }
        }
    }
    let encoding = base32::Encoding::from_variant(base32::Variant::Standard);
    testing::assert(base32::Encoder::new(encoding, -1).is_err());
    let encoder = testing::expect_ok(base32::Encoder::new(encoding, 8), "limited encoder");
    let first = testing::expect_ok(encoder.update(b"f".as_slice()), "first chunk");
    assert_equal(first, "M");
    match encoder.update(b"oobar".as_slice()) {
        Err(base32::StreamError::Output(base32::OutputError::LimitExceeded(limit))) => assert_equal(
            limit,
            8,
        ),
        _ => testing::assert(false),
    }
    assert_equal(encoder.input_len(), 1);
    assert_equal(encoder.output_len(), 1);
    let remainder = testing::expect_ok(encoder.update(b"o".as_slice()), "smaller retry")
        + testing::expect_ok(encoder.finish(), "limited finish");
    assert_equal(first + remainder, encoding.encode(bytes::Bytes::from_string("fo")));
    let too_small = testing::expect_ok(base32::Encoder::new(encoding, 7), "padding budget");
    testing::assert(too_small.update(b"f".as_slice()).is_err());
    assert_equal(too_small.input_len(), 0);
    assert_equal(too_small.output_len(), 0);
    assert_equal(testing::expect_ok(too_small.finish(), "empty finalization"), "");
    let zero = testing::expect_ok(base32::Encoder::new(encoding, 0), "zero limit");
    assert_equal(testing::expect_ok(zero.update(b"".as_slice()), "empty update"), "");
    assert_equal(testing::expect_ok(zero.finish(), "zero finish"), "");
}
