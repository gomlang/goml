package main;

use std::text;
use std::bytes;
use std::testing;

#[go_ffi("example.com/goml-std-algorithms/native", "SharesTextStorage")]
extern fn shares_text_storage(source: string, candidate: string) -> bool;

fn check_text_clone() -> () {
    for value in["", "a", "ascii", "界🙂é", "\u0000\n\r\t", "e\u0301"] {
        for limit in 0..value.byte_len() + 2 {
            let result = text::clone_checked(value, limit);
            if limit < value.byte_len() {
                match result {
                    Err(bytes::TransformError::LimitExceeded(actual)) => assert_equal(actual, limit),
                    _ => testing::fail("expected clone byte limit"),
                }
            } else {
                assert_equal(testing::expect_ok(result, "bounded text clone"), value);
            }
        }
        for limit in[-1, -9223372036854775807 - 1] {
            match text::clone_checked(value, limit) {
                Err(bytes::TransformError::InvalidLimit(actual)) => assert_equal(actual, limit),
                _ => testing::fail("expected negative clone limit"),
            }
        }
        assert_equal(
            testing::expect_ok(text::clone_checked(value, 9223372036854775807), "large clone bound"),
            value,
        );
    }
    let storage = text::StringBuilder::new();
    storage.write_string("padding".repeat(10000));
    let start = storage.len();
    storage.write_string("x界🙂é payload");
    let end = storage.len();
    storage.write_string("suffix".repeat(10000));
    let source = storage.finish();
    for length in[1, 4, 8, end - start] {
        let view = source.byte_slice(start, start + length);
        testing::assert(shares_text_storage(source, view));
        let cloned = testing::expect_ok(text::clone_checked(view, length), "detached substring");
        assert_equal(cloned, view);
        testing::assert(!shares_text_storage(source, cloned));
        storage.values[start] = b'Y';
        assert_equal(cloned.byte_get(0), b'x');
        assert_equal(view.byte_get(0), b'x');
    }
    let complete = testing::expect_ok(
        text::clone_checked(source, source.byte_len()),
        "detached complete string",
    );
    assert_equal(complete, source);
    testing::assert(!shares_text_storage(source, complete));
    assert_equal(testing::expect_ok(text::clone_checked("", 0), "empty clone"), "");
}
