package main;

use std::text;
use std::testing;
use std::ffi;
use std::cmp;
use std::bytes;

#[go_ffi("strings", "Compare")]
extern fn go_text_compare(left: string, right: string) -> isize;

#[go_ffi("strings", "HasPrefix")]
extern fn go_text_has_prefix(value: string, pattern: string) -> bool;

#[go_ffi("strings", "HasSuffix")]
extern fn go_text_has_suffix(value: string, pattern: string) -> bool;

#[go_ffi("strings", "TrimPrefix")]
extern fn go_text_trim_prefix(value: string, pattern: string) -> string;

#[go_ffi("strings", "TrimSuffix")]
extern fn go_text_trim_suffix(value: string, pattern: string) -> string;

#[go_ffi("strings", "Index")]
extern fn go_text_index(value: string, pattern: string) -> isize;

#[go_ffi("strings", "LastIndex")]
extern fn go_text_last_index(value: string, pattern: string) -> isize;

#[go_ffi("strings", "Count")]
extern fn go_text_count(value: string, pattern: string) -> isize;

#[go_ffi("strings", "Cut")]
extern fn go_text_cut(value: string, pattern: string) -> (string, string, bool);

#[go_ffi("strings", "CutPrefix")]
extern fn go_text_cut_prefix(value: string, pattern: string) -> (string, bool);

#[go_ffi("strings", "CutSuffix")]
extern fn go_text_cut_suffix(value: string, pattern: string) -> (string, bool);

#[go_ffi("strings", "Split")]
extern fn go_text_split(value: string, pattern: string) -> ffi::RawSlice[string];

#[go_ffi("strings", "SplitAfter")]
extern fn go_text_split_after(value: string, pattern: string) -> ffi::RawSlice[string];

#[go_ffi("example.com/goml-std-algorithms/native", "TextLines")]
extern fn go_text_lines(value: string) -> ffi::RawSlice[string];

fn check_text_iterator(iterator: FnIterator[string], expected: Vec[string]) -> () {
    for value in expected {
        assert_equal(testing::expect_some(iterator.next(), "text iterator part"), value);
    }
    testing::assert(iterator.next().is_none());
    testing::assert(iterator.next().is_none());
}

fn check_text_pair(value: string, pattern: string) -> () {
    assert_equal(cmp::compare(value, pattern).to_isize(), go_text_compare(value, pattern));
    assert_equal(value.starts_with(pattern), go_text_has_prefix(value, pattern));
    assert_equal(value.ends_with(pattern), go_text_has_suffix(value, pattern));
    assert_equal(
        text::cut_prefix(value, pattern).unwrap_or(value),
        go_text_trim_prefix(value, pattern),
    );
    assert_equal(
        text::cut_suffix(value, pattern).unwrap_or(value),
        go_text_trim_suffix(value, pattern),
    );
    let finder = text::Finder::new(pattern);
    assert_equal(finder.find(value).unwrap_or(-1), go_text_index(value, pattern));
    assert_equal(finder.rfind(value).unwrap_or(-1), go_text_last_index(value, pattern));
    assert_equal(finder.contains(value), go_text_index(value, pattern) >= 0);
    assert_equal(text::find(value, pattern), value.find(pattern));
    assert_equal(text::find_bytes(value, pattern), value.find_bytes(pattern));
    assert_equal(text::rfind(value, pattern), value.rfind(pattern));
    assert_equal(
        testing::expect_ok(text::count(value, pattern), "text count"),
        go_text_count(value, pattern),
    );
    let expected = go_text_cut(value, pattern);
    match text::cut(value, pattern) {
        Option::Some((before, after)) => {
            testing::assert(expected.2);
            assert_equal(before, expected.0);
            assert_equal(after, expected.1);
        },
        Option::None => testing::assert(!expected.2),
    }
    let prefix = go_text_cut_prefix(value, pattern);
    assert_equal(
        text::cut_prefix(value, pattern),
        if prefix.1 {
            Option::Some(prefix.0)
        } else {
            Option::None
        },
    );
    let suffix = go_text_cut_suffix(value, pattern);
    assert_equal(
        text::cut_suffix(value, pattern),
        if suffix.1 {
            Option::Some(suffix.0)
        } else {
            Option::None
        },
    );
    check_text_iterator(text::split_iter(value, pattern), value.split(pattern));
    if pattern == "" {
        check_text_iterator(text::split_after_iter(value, pattern), Vec::from_array([value]));
    } else {
        check_text_iterator(
            text::split_iter(value, pattern),
            go_text_split(value, pattern).as_slice().to_vec(),
        );
        check_text_iterator(
            text::split_after_iter(value, pattern),
            go_text_split_after(value, pattern).as_slice().to_vec(),
        );
    }
}

fn check_text_byte_composition() -> () {
    let ascii = text::StringBuilder::new();
    for code in 0..128 {
        ascii.write_char(testing::expect_some(char_from_u32(code.to_u32()), "ASCII scalar"));
    }
    let maximum = testing::expect_some(char_from_u32(0x10ffff), "maximum scalar").to_string();
    let values = [
        "",
        "a",
        "aaaa",
        "abab",
        "\u0000",
        "\r\n\t",
        "é",
        "界",
        "🙂",
        "é界🙂é",
        "e\u0301",
        ascii.finish(),
        maximum,
    ];
    for value in values {
        let encoded = value.to_bytes();
        for code in 0..256 {
            let needle = code.to_u8();
            assert_equal(
                bytes::find_byte(encoded.as_slice(), needle).unwrap_or(-1),
                go_bytes_index_byte(encoded.as_slice(), needle),
            );
            assert_equal(
                bytes::rfind_byte(encoded.as_slice(), needle).unwrap_or(-1),
                go_bytes_last_index_byte(encoded.as_slice(), needle),
            );
        }
    }
    let value = "éé";
    let encoded = value.to_bytes();
    let first = testing::expect_some(bytes::find_byte(encoded.as_slice(), 0xa9), "interior byte");
    let last = testing::expect_some(
        bytes::rfind_byte(encoded.as_slice(), 0xa9),
        "last interior byte",
    );
    assert_equal(first, 1);
    assert_equal(last, 3);
    testing::assert(!value.is_char_boundary(first));
    testing::assert(!value.is_char_boundary(last));
    testing::assert(text::find_char(value, '©').is_none());
}

fn check_text_search() -> () {
    check_text_byte_composition();
    let nul = char_from_u32(0).unwrap_or(' ').to_string();
    let alphabet = ["a", "é", "🙂"];
    let inputs: Vec[string] = Vec::new();
    inputs.push("");
    for first in alphabet {
        inputs.push(first);
        for second in alphabet {
            inputs.push(first + second);
            for third in alphabet {
                inputs.push(first + second + third);
            }
        }
    }
    inputs.push(nul + "a" + nul);
    inputs.push("界\n\r");
    inputs.push("e\u0301");
    inputs.push("\u0301é");
    for value in inputs {
        for pattern in inputs {
            check_text_pair(value, pattern);
        }
    }
    for value in["", "\n", "\n\n", "\r", "a\r", "a\r\nb\n", "é\n界\r\n🙂", nul + "\n"] {
        check_text_iterator(text::lines_iter(value), value.lines());
        check_text_iterator(
            text::lines_inclusive_iter(value),
            go_text_lines(value).as_slice().to_vec(),
        );
    }
    let iterator = text::split_iter("a,b,c", ",");
    let alias = iterator;
    assert_equal(iterator.next(), Option::Some("a"));
    assert_equal(alias.next(), Option::Some("b"));
    assert_equal(iterator.next(), Option::Some("c"));
    testing::assert(alias.next().is_none());
    testing::assert(iterator.next().is_none());
    let finder = text::Finder::new("aaaaab");
    let repeated = "a".repeat(100000);
    testing::assert(finder.find(repeated).is_none());
    assert_equal(finder.find(repeated + "b"), Option::Some(99995));
    assert_equal(finder.rfind("aaaaabaaaaab"), Option::Some(6));
    assert_equal(text::split_once("abc", ""), Option::None);
    assert_equal(text::cut("abc", ""), Option::Some(("", "abc")));
}
