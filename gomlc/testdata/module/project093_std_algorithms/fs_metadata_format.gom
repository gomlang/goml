package main;

use std::fs;
use std::io;
use std::testing;

fn metadata_format_error(
    error: fs::Error,
    operation: string,
    name: Option[string],
    kind: io::ErrorKind,
) -> () {
    assert_equal(error.operation(), operation);
    assert_equal(error.path(), name);
    assert_equal(error.kind(), kind);
    assert_equal(error.raw_os_code(), Option::None);
}

fn metadata_format_flags(bits: isize) -> string {
    "set_uid:" + (bits & 1).to_string() + ",set_gid:" + ((bits / 2) & 1).to_string() + ",sticky:"
        + ((bits / 4) & 1).to_string()
        + ",append_only:"
        + ((bits / 8) & 1).to_string()
        + ",exclusive:"
        + ((bits / 16) & 1).to_string()
        + ",temporary:"
        + ((bits / 32) & 1).to_string()
}

fn check_fs_metadata_format() -> () {
    let names = Vec::from_array(
        [
            "file",
            "directory",
            "symlink",
            "block_device",
            "character_device",
            "named_pipe",
            "socket",
            "irregular",
            "unknown",
        ],
    );
    let kinds = mode_kinds();
    for index in 0..kinds.len() {
        let metadata = fs::Metadata::from_mode(
            fs::FileMode::from_parts(kinds[index], 0o640, Option::None),
            12,
            -7,
        );
        let suffix = if kinds[index] == fs::NodeKind::Directory {
            "/"
        } else {
            ""
        };
        let expected = "kind=" + names[index]
            + " permissions=rw-r----- flags=unknown size=12 modified_ns=-7 name=界\n\u0000"
            + suffix;
        assert_equal(
            testing::expect_ok(
                fs::format_metadata("界\n\u0000", metadata, expected.byte_len()),
                "exact metadata format budget",
            ),
            expected,
        );
        for limit in 0..expected.byte_len() {
            metadata_format_error(
                testing::expect_err(
                    fs::format_metadata("界\n\u0000", metadata, limit),
                    "short metadata format budget",
                ),
                "format metadata",
                Option::Some("界\n\u0000"),
                io::ErrorKind::InvalidData,
            );
        }
        metadata_format_error(
            testing::expect_err(
                fs::format_metadata("name", metadata, -1),
                "negative metadata format budget",
            ),
            "format metadata",
            Option::Some("name"),
            io::ErrorKind::InvalidInput,
        );
    }
    for pair in[
        (0o000, "---------"),
        (0o400, "r--------"),
        (0o200, "-w-------"),
        (0o100, "--x------"),
        (0o040, "---r-----"),
        (0o020, "----w----"),
        (0o010, "-----x---"),
        (0o004, "------r--"),
        (0o002, "-------w-"),
        (0o001, "--------x"),
        (0o777, "rwxrwxrwx"),
    ] {
        let metadata = fs::Metadata::from_parts(fs::FileType::File, 0, pair.0.to_u32(), 0);
        let expected = "kind=file permissions=" + pair.1
            + " flags=unknown size=0 modified_ns=0 name=";
        assert_equal(
            testing::expect_ok(
                fs::format_metadata("", metadata, expected.byte_len()),
                "permission positions",
            ),
            expected,
        );
    }
    for bits in 0..64 {
        let metadata = fs::Metadata::from_mode(
            fs::FileMode::new(fs::NodeKind::Directory, 0o750, mode_flags(bits)),
            12,
            -7,
        );
        let expected = "kind=directory permissions=rwxr-x--- flags=" + metadata_format_flags(bits)
            + " size=12 modified_ns=-7 name=config/";
        assert_equal(
            testing::expect_ok(
                fs::format_metadata("config", metadata, expected.byte_len()),
                "known mode flags",
            ),
            expected,
        );
    }
    let minimum = (-9223372036854775807 - 1).to_i64();
    let maximum = 9223372036854775807.to_i64();
    let metadata = fs::Metadata::from_parts(fs::FileType::Other, minimum, 0, maximum);
    let expected = "kind=unknown permissions=--------- flags=unknown size=-9223372036854775808 modified_ns=9223372036854775807 name=extreme";
    assert_equal(
        testing::expect_ok(
            fs::format_metadata("extreme", metadata, 9223372036854775807),
            "extreme integer metadata",
        ),
        expected,
    );
    for (kind, label) in[
        (fs::FileType::File, "file"),
        (fs::FileType::Directory, "directory"),
        (fs::FileType::Symlink, "symlink"),
        (fs::FileType::Other, "other"),
    ] {
        for name in["界", "a\n\u0000b", "already/"] {
            let suffix = if kind == fs::FileType::Directory {
                "/"
            } else {
                ""
            };
            let expected = "kind=" + label + " name=" + name + suffix;
            for limit in 0..expected.byte_len() + 1 {
                let entry = walk_probe_entry(name, kind, 0);
                let result = fs::format_directory_entry(entry, limit);
                if limit == expected.byte_len() {
                    assert_equal(testing::expect_ok(result, "exact entry budget"), expected);
                } else {
                    metadata_format_error(
                        testing::expect_err(result, "short entry budget"),
                        "format directory entry",
                        Option::Some(name),
                        io::ErrorKind::InvalidData,
                    );
                }
                assert_equal(entry.names.get(), 1);
                assert_equal(entry.types.get(), 1);
                assert_equal(entry.metadata_calls.get(), 0);
            }
        }
    }
    let entry = walk_probe_entry("unused", fs::FileType::Directory, 0);
    metadata_format_error(
        testing::expect_err(fs::format_directory_entry(entry, -1), "negative entry budget"),
        "format directory entry",
        Option::None,
        io::ErrorKind::InvalidInput,
    );
    assert_equal(entry.names.get(), 0);
    assert_equal(entry.types.get(), 0);
    assert_equal(entry.metadata_calls.get(), 0);
}
