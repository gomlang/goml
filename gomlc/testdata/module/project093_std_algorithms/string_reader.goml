package main;

use std::io;
use std::bytes;
use std::text;
use io::{Read, ReadAt, WriteAt};
use std::testing;

#[go_ffi("example.com/goml-std-algorithms/native", "StringReaderRune")]
extern fn go_string_reader_rune(value: string, offset: isize) -> (char, isize);

fn check_string_readers() -> () {
    check_string_reader_transfers();
    for value in["", "abc", "é界🙂", "a\r\nb", "�界a"] {
        let reader = io::StringReader::new(value);
        assert_equal(reader.size(), value.byte_len());
        for start in 0..value.byte_len() + 3 {
            assert_equal(
                testing::expect_ok(reader.seek(io::SeekFrom::Start(start)), "seek string"),
                start,
            );
            let expected = go_string_reader_rune(value, start);
            let actual = reader.read_char();
            if expected.1 == 0 {
                testing::assert(actual.is_none());
                testing::assert(reader.unread_char().is_err());
            } else {
                assert_equal(testing::expect_some(actual, "read character"), expected);
                testing::expect_ok(reader.unread_char(), "unread character");
                assert_equal(reader.position(), start);
                testing::assert(reader.unread_char().is_err());
            }
            for width in 0..5 {
                testing::expect_ok(reader.seek(io::SeekFrom::Start(start)), "read position");
                let buffer: Vec[byte] = Vec::new();
                for _ in 0..width {
                    buffer.push(0xff);
                }
                let available = if start < value.byte_len() {
                    value.byte_len() - start
                } else {
                    0
                };
                let count = if available < width {
                    available
                } else {
                    width
                };
                assert_equal(
                    testing::expect_ok(reader.read(buffer.as_mut_slice()), "read string bytes"),
                    count,
                );
                assert_equal(reader.position(), start + count);
                for index in 0..width {
                    assert_equal(
                        buffer[index],
                        if index < count {
                            value.byte_get(start + index)
                        } else {
                            0xff
                        },
                    );
                }
                let position = reader.position();
                match reader.read_at(buffer.as_mut_slice(), start) {
                    Ok(actual) => {
                        assert_equal(actual, width);
                        assert_equal(count, width);
                    },
                    Err(error) => {
                        assert_equal(error.transferred(), count.to_usize());
                        assert_equal(error.error().kind(), io::ErrorKind::UnexpectedEof);
                        testing::assert(count < width);
                    },
                }
                assert_equal(reader.position(), position);
            }
        }
    }
    let reader = io::StringReader::new("éa");
    let alias = reader;
    assert_equal(reader.read_char(), Option::Some(('é', 2)));
    let empty: Vec[byte] = Vec::new();
    testing::expect_ok(reader.read_at(empty.as_mut_slice(), 9223372036854775807), "empty far read");
    testing::expect_ok(reader.unread_char(), "positional read preserves unread");
    assert_equal(alias.position(), 0);
    testing::assert(reader.unread_byte().is_err());
    assert_equal(reader.read_byte(), Option::Some(0xc3));
    testing::assert(reader.unread_char().is_err());
    testing::expect_ok(reader.unread_byte(), "unread byte");
    assert_equal(reader.read_char(), Option::Some(('é', 2)));
    testing::expect_ok(reader.read(empty.as_mut_slice()), "empty sequential read");
    testing::assert(reader.unread_char().is_err());
    assert_equal(testing::expect_ok(reader.seek(io::SeekFrom::End(5)), "past end"), 8);
    testing::assert(reader.is_empty());
    testing::assert(reader.read_byte().is_none());
    testing::expect_ok(reader.unread_byte(), "back from past end");
    assert_equal(reader.position(), 7);
    for from in[
        io::SeekFrom::Start(-1),
        io::SeekFrom::Current(-9223372036854775807 - 1),
        io::SeekFrom::Current(9223372036854775807),
    ] {
        testing::assert(reader.seek(from).is_err());
        assert_equal(reader.position(), 7);
    }
    testing::expect_ok(reader.seek(io::SeekFrom::Start(9223372036854775807)), "maximum position");
    testing::assert(reader.seek(io::SeekFrom::Current(1)).is_err());
    assert_equal(reader.position(), 9223372036854775807);
    let output = Vec::from_array([0xff.to_u8()]);
    testing::assert(reader.read_at(output.as_mut_slice(), -1).is_err());
    testing::assert(reader.read_at(output.as_mut_slice(), 9223372036854775807).is_err());
    assert_equal(output[0], 0xff.to_u8());
    alias.reset("界");
    assert_equal(reader.position(), 0);
    assert_equal(reader.len(), 3);
    testing::assert(reader.unread_char().is_err());
    assert_equal(reader.read_char(), Option::Some(('界', 3)));
    assert_equal(testing::expect_ok(reader.seek(io::SeekFrom::End(-3)), "seek from end"), 0);
    assert_equal(testing::expect_ok(reader.seek(io::SeekFrom::Current(1)), "seek forward"), 1);
    assert_equal(reader.read_char(), Option::Some(('�', 1)));
    testing::assert(reader.seek(io::SeekFrom::Start(-1)).is_err());
    assert_equal(reader.position(), 2);
    testing::assert(reader.unread_char().is_err());
    testing::expect_ok(reader.seek(io::SeekFrom::Current(-2)), "seek backward");
    assert_equal(reader.read_char(), Option::Some(('界', 3)));
    testing::assert(reader.read_char().is_none());
    testing::assert(reader.unread_char().is_err());
}

fn check_string_reader_transfers() -> () {
    check_string_reader_interruptions();
    for value in["", "abc", "界🙂é"] {
        for start in 0..value.byte_len() + 2 {
            let remaining = if start < value.byte_len() {
                value.byte_len() - start
            } else {
                0
            };
            for step in[1, 2, 4096] {
                for limit in 0..remaining + 1 {
                    for mode in 0..4 {
                        let reader = io::StringReader::new(value);
                        testing::expect_ok(reader.seek(io::SeekFrom::Start(start)), "transfer seek");
                        let writer = replacement_writer(step, limit, mode);
                        writer.interrupted.set(true);
                        match reader.write_to(writer) {
                            Ok(count) => {
                                assert_equal(limit, remaining);
                                assert_equal(count, remaining);
                            },
                            Err(error) => {
                                testing::assert(limit < remaining);
                                assert_equal(error.transferred(), limit.to_usize());
                                assert_equal(
                                    error.error().kind(),
                                    match mode {
                                        0 => io::ErrorKind::BrokenPipe,
                                        1 => io::ErrorKind::WriteZero,
                                        _ => io::ErrorKind::InvalidData,
                                    },
                                );
                            },
                        }
                        assert_equal(reader.position(), start + limit);
                        assert_equal(writer.data.len(), limit);
                        for index in 0..limit {
                            assert_equal(writer.data[index], value.byte_get(start + index));
                        }
                        let suffix = io::Cursor::new(bytes::Bytes::new());
                        assert_equal(
                            testing::expect_ok(reader.write_to(suffix), "resume transfer"),
                            remaining - limit,
                        );
                        let rest = suffix.bytes();
                        assert_equal(rest.len(), remaining - limit);
                        for index in 0..rest.len() {
                            assert_equal(rest.get(index), value.byte_get(start + limit + index));
                        }
                        if remaining == 0 {
                            assert_equal(writer.calls.get(), 0);
                        }
                    }
                }
            }
        }
    }
    let value = testing::expect_ok(text::repeat_checked("界", 4000, 12000), "long string transfer");
    let reader = io::StringReader::new(value);
    let writer = replacement_writer(13, 5000, 0);
    writer.interrupted.set(true);
    match reader.write_to(writer) {
        Err(error) => assert_equal(error.transferred(), 5000.to_usize()),
        _ => testing::fail("long transfer did not stop"),
    }
    assert_equal(reader.position(), 5000);
    let rest = io::Cursor::new(bytes::Bytes::new());
    assert_equal(testing::expect_ok(reader.write_to(rest), "long transfer resume"), 7000);
    let tail = rest.bytes();
    for index in 0..5000 {
        assert_equal(writer.data[index], value.byte_get(index));
    }
    for index in 0..7000 {
        assert_equal(tail.get(index), value.byte_get(index + 5000));
    }
    let reader = io::StringReader::new("a");
    testing::expect_some(reader.read_char(), "character before empty transfer");
    testing::expect_ok(reader.write_to(io::Discard::new()), "empty transfer");
    testing::assert(reader.unread_char().is_err());
}

struct StringInterruptedAt {
    data: Vec[byte],
    calls: Ref[isize],
    interrupt_on: isize,
}

impl WriteAt for StringInterruptedAt {
    fn write_at(self: StringInterruptedAt, buffer: Slice[byte], offset: isize) -> Result[
        isize,
        io::TransferError,
    ] {
        self.calls.set(self.calls.get() + 1);
        assert_equal(offset, self.data.len());
        let count = if self.calls.get() == self.interrupt_on {
            2
        } else {
            buffer.len()
        };
        for index in 0..count {
            self.data.push(buffer[index]);
        }
        if self.calls.get() == self.interrupt_on {
            Result::Err(
                io::TransferError::new(
                    count.to_usize(),
                    replacement_io_error(io::ErrorKind::Interrupted),
                ),
            )
        } else {
            Result::Ok(count)
        }
    }
}

fn check_string_reader_interruptions() -> () {
    let reader = io::StringReader::new("界🙂");
    let writer = replacement_writer(4096, 100, 0);
    check_transfer_error(reader.write_to(writer), 0.to_usize(), io::ErrorKind::Interrupted);
    assert_equal(writer.calls.get(), 1);
    assert_equal(writer.data.len(), 0);
    assert_equal(reader.position(), 0);
    let reader = io::StringReader::new("界🙂");
    let first = replacement_writer(4096, 100, 0);
    first.interrupted.set(true);
    let second = replacement_writer(4096, 100, 0);
    let destinations = Vec::from_array([first, second]);
    let writer = io::MultiWriter::new(destinations.as_slice());
    check_transfer_error(reader.write_to(writer), 0.to_usize(), io::ErrorKind::Interrupted);
    assert_equal(first.data.len(), 7);
    for index in 0..first.data.len() {
        assert_equal(first.data[index], "界🙂".byte_get(index));
    }
    assert_equal(first.calls.get(), 1);
    assert_equal(second.calls.get(), 1);
    assert_equal(second.data.len(), 0);
    assert_equal(reader.position(), 0);
    let reader = io::StringReader::new("界🙂");
    let destination = StringInterruptedAt { data: Vec::new(), calls: Ref::new(0), interrupt_on: 1 };
    let writer = testing::expect_ok(
        io::OffsetWriter::new(destination, 0),
        "interrupted offset writer",
    );
    check_transfer_error(reader.write_to(writer), 0.to_usize(), io::ErrorKind::Interrupted);
    assert_equal(destination.calls.get(), 1);
    assert_equal(destination.data, Vec::from_array([0xe7.to_u8(), 0x95.to_u8()]));
    assert_equal(writer.position(), 2);
    assert_equal(reader.position(), 0);
    let value = testing::expect_ok(text::repeat_checked("界", 2000, 6000), "interrupted long string");
    let reader = io::StringReader::new(value);
    let destination = StringInterruptedAt { data: Vec::new(), calls: Ref::new(0), interrupt_on: 2 };
    let writer = testing::expect_ok(
        io::OffsetWriter::new(destination, 0),
        "later interrupted offset writer",
    );
    check_transfer_error(reader.write_to(writer), 4096.to_usize(), io::ErrorKind::Interrupted);
    assert_equal(destination.calls.get(), 2);
    assert_equal(destination.data.len(), 4098);
    for index in 0..destination.data.len() {
        assert_equal(destination.data[index], value.byte_get(index));
    }
    assert_equal(writer.position(), 4098);
    assert_equal(reader.position(), 4096);
}
