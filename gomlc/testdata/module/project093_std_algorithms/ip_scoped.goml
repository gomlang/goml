package main;

use std::net;
use std::testing;

#[go_ffi("example.com/goml-std-algorithms/native", "ScopedAddressFacts")]
extern fn go_scoped_address_facts(input: string) -> (bool, string, string, string);

fn check_ip_scoped() -> () {
    for host in["192.0.2.1", "fe80::1", "::", "::1", "ff02::1", "::ffff:192.0.2.1"] {
        let ip = testing::expect_ok(net::IpAddr::parse(host), "host");
        for zone in[
            "",
            "0",
            "003",
            "4294967295",
            "4294967296",
            "eth0",
            "ETH0",
            "a%b",
            "a b",
            "接口",
            "/[]:",
        ] {
            let input = host
                + if zone == "" {
                    ""
                } else {
                    "%" + zone
                };
            let (valid, expected_zone, plain, unmapped) = go_scoped_address_facts(input);
            let parsed = net::ScopedIpAddr::parse(input);
            let built = ip.with_zone(zone);
            assert_equal(parsed.is_ok(), valid);
            assert_equal(built.is_ok(), valid);
            if valid {
                let address = testing::expect_ok(parsed, "scoped parse");
                assert_equal(address, testing::expect_ok(built, "scoped construct"));
                assert_equal(address.zone(), expected_zone);
                assert_equal(address.address(), ip);
                assert_equal(
                    address.without_zone(),
                    testing::expect_ok(net::IpAddr::parse(plain), "plain"),
                );
                assert_equal(
                    address.unmap(),
                    testing::expect_ok(net::ScopedIpAddr::parse(unmapped), "unmapped"),
                );
                assert_equal(address.unmap().unmap(), address.unmap());
                assert_equal(
                    testing::expect_ok(net::ScopedIpAddr::parse(address.to_string()), "roundtrip"),
                    address,
                );
                let cleared = testing::expect_ok(address.with_zone(""), "clear zone");
                assert_equal(cleared.zone(), "");
                assert_equal(cleared.address(), ip);
                assert_equal(address.zone(), zone);
            }
        }
    }
    for input in[
        "",
        "%eth0",
        "fe80::1%",
        "192.0.2.1%eth0",
        "[fe80::1%eth0]",
        "host%eth0",
        "fe80::g%eth0",
    ] {
        let (valid, _, _, _) = go_scoped_address_facts(input);
        testing::assert(!valid);
        testing::assert(net::ScopedIpAddr::parse(input).is_err());
    }
    for (zone, expected) in[("", 0), ("0", 0), ("003", 3), ("4294967295", 4294967295)] {
        let ip = testing::expect_ok(net::IpAddr::parse("fe80::1"), "numeric host");
        let address = testing::expect_ok(ip.with_zone(zone), "numeric zone");
        let socket = testing::expect_ok(address.to_socket_addr(8080), "socket");
        assert_equal(socket.scope_id, expected.to_u32());
        assert_equal(socket.port, (8080).to_u16());
        assert_equal(socket.ip, ip);
        let restored = testing::expect_ok(
            net::ScopedIpAddr::from_socket_addr(socket),
            "from socket",
        );
        assert_equal(restored.address(), ip);
        assert_equal(
            restored.zone(),
            if expected == 0 {
                ""
            } else {
                expected.to_string()
            },
        );
    }
    for zone in["eth0", "-1", "+1", "1.0", "4294967296", " 3", "3%4"] {
        let address = testing::expect_ok(net::ScopedIpAddr::parse("fe80::1%" + zone), "opaque zone");
        testing::assert(address.to_socket_addr(0).is_err());
    }
    let v4 = testing::expect_ok(net::IpAddr::parse("192.0.2.1"), "v4");
    testing::assert(
        net::ScopedIpAddr::from_socket_addr(net::SocketAddr { ip: v4, port: 0, scope_id: 1 }).is_err(),
    );
    let upper = testing::expect_ok(net::ScopedIpAddr::parse("fe80::1%ETH0"), "upper");
    let lower = testing::expect_ok(net::ScopedIpAddr::parse("fe80::1%eth0"), "lower");
    testing::assert(upper != lower);
}
