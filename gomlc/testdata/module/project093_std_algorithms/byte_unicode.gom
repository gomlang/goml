package main;

use std::bytes;
use std::unicode;
use std::testing;
use std::ffi;

#[go_ffi("bytes", "ToValidUTF8")]
extern fn go_byte_valid_utf8(input: Slice[byte], replacement: Slice[byte]) -> ffi::RawSlice[byte];

fn check_byte_valid_utf8_case(input: Slice[byte], replacement: Slice[byte]) -> () {
    let expected = go_byte_valid_utf8(input, replacement).to_vec();
    let actual = testing::expect_ok(
        bytes::replace_invalid_utf8(input, replacement, expected.len()),
        "replace malformed UTF-8 runs",
    );
    assert_equal(actual.to_vec(), expected);
    if expected.len() > 0 {
        testing::assert(
            bytes::replace_invalid_utf8(input, replacement, expected.len() - 1).is_err(),
        );
    }
}

fn check_byte_valid_utf8() -> () {
    let replacements = Vec::from_array([b"", b"?", "�".to_bytes(), b"\xff\x80"]);
    for replacement in replacements {
        check_byte_valid_utf8_case(b"".as_slice(), replacement.as_slice());
        for first in 0..256 {
            let single = Vec::from_array([first.to_u8()]);
            check_byte_valid_utf8_case(single.as_slice(), replacement.as_slice());
            for second in 0..256 {
                let pair = Vec::from_array([first.to_u8(), second.to_u8()]);
                check_byte_valid_utf8_case(pair.as_slice(), replacement.as_slice());
            }
        }
        for input in Vec::from_array(
            [
                b"\xff\x80a\xc0\xaf\xef\xbf\xbd\xed\xa0\x80",
                b"\xf0\x90\x80\x80\xff\xf4\x8f\xbf\xbf\xf4\x90\x80\x80",
                b"\xe0\xa0\x80\xe0\x9f\xbf\xe2\x82",
                b"\x80\xc2\xa2\x80\0\xff",
            ],
        ) {
            check_byte_valid_utf8_case(input.as_slice(), replacement.as_slice());
        }
    }
    let input = b"a\xff\x80b";
    let replacement = b"xy";
    let output = testing::expect_ok(
        bytes::replace_invalid_utf8(input.as_slice(), replacement.as_slice(), 4),
        "independent output",
    );
    input[0] = b'z';
    replacement[0] = b'!';
    assert_equal(output.to_vec(), b"axyb");
    let valid = b"abc";
    let copied = testing::expect_ok(
        bytes::replace_invalid_utf8(valid.as_slice(), valid.as_slice(), 3),
        "valid snapshot",
    );
    valid[0] = b'z';
    assert_equal(copied.to_vec(), b"abc");
    testing::assert(bytes::replace_invalid_utf8(b"".as_slice(), b"".as_slice(), -1).is_err());
}

#[go_ffi("bytes", "Fields")]
extern fn go_byte_fields(input: Slice[byte]) -> ffi::RawSlice[ffi::RawSlice[byte]];

#[go_ffi("bytes", "TrimSpace")]
extern fn go_byte_trim_space(input: Slice[byte]) -> ffi::RawSlice[byte];

#[go_ffi("bytes", "Trim")]
extern fn go_byte_trim_chars(input: Slice[byte], characters: string) -> ffi::RawSlice[byte];

#[go_ffi("bytes", "TrimLeft")]
extern fn go_byte_trim_start_chars(input: Slice[byte], characters: string) -> ffi::RawSlice[byte];

#[go_ffi("bytes", "TrimRight")]
extern fn go_byte_trim_end_chars(input: Slice[byte], characters: string) -> ffi::RawSlice[byte];

#[go_ffi("bytes", "IndexAny")]
extern fn go_byte_find_any(input: Slice[byte], characters: string) -> isize;

#[go_ffi("bytes", "LastIndexAny")]
extern fn go_byte_rfind_any(input: Slice[byte], characters: string) -> isize;

#[go_ffi("bytes", "IndexRune")]
extern fn go_byte_find_char(input: Slice[byte], character: char) -> isize;

#[go_ffi("bytes", "EqualFold")]
extern fn go_byte_equal_fold(left: Slice[byte], right: Slice[byte]) -> bool;

#[go_ffi("example.com/goml-std-algorithms/native", "ByteFieldsBy")]
extern fn go_byte_fields_by(input: Slice[byte]) -> ffi::RawSlice[ffi::RawSlice[byte]];

#[go_ffi("example.com/goml-std-algorithms/native", "ByteTrimBy")]
extern fn go_byte_trim_by(input: Slice[byte]) -> ffi::RawSlice[byte];

#[go_ffi("example.com/goml-std-algorithms/native", "ByteTrimStartBy")]
extern fn go_byte_trim_start_by(input: Slice[byte]) -> ffi::RawSlice[byte];

#[go_ffi("example.com/goml-std-algorithms/native", "ByteTrimEndBy")]
extern fn go_byte_trim_end_by(input: Slice[byte]) -> ffi::RawSlice[byte];

#[go_ffi("example.com/goml-std-algorithms/native", "ByteIndexBy")]
extern fn go_byte_find_by(input: Slice[byte]) -> isize;

#[go_ffi("example.com/goml-std-algorithms/native", "ByteLastIndexBy")]
extern fn go_byte_rfind_by(input: Slice[byte]) -> isize;

#[go_ffi("example.com/goml-std-algorithms/native", "ByteLastRune")]
extern fn go_byte_rfind_char(input: Slice[byte], character: char) -> isize;

#[go_ffi("example.com/goml-std-algorithms/native", "ByteMap")]
extern fn go_byte_map(input: Slice[byte]) -> ffi::RawSlice[byte];

#[go_ffi("example.com/goml-std-algorithms/native", "ByteCase")]
extern fn go_byte_case(input: Slice[byte], kind: isize, special: bool) -> ffi::RawSlice[byte];

fn check_byte_unicode_case(input: Slice[byte]) -> () {
    let expected = go_byte_fields(input);
    check_byte_parts(
        testing::expect_ok(bytes::fields(input, expected.len()), "Unicode fields"),
        expected,
    );
    check_byte_iterator(bytes::fields_iter(input), expected);
    if expected.len() > 0 {
        testing::assert(bytes::fields(input, expected.len() - 1).is_err());
    }
    let predicate = |character: char| character == ',' || character == '界' || character == '�';
    let custom = go_byte_fields_by(input);
    check_byte_parts(
        testing::expect_ok(
            bytes::fields_by(input, predicate, custom.len()),
            "predicate byte fields",
        ),
        custom,
    );
    check_byte_iterator(bytes::fields_by_iter(input, predicate), custom);
    assert_equal(bytes::trim_space(input).to_vec(), go_byte_trim_space(input).as_slice().to_vec());
    assert_equal(
        bytes::trim_by(input, predicate).to_vec(),
        go_byte_trim_by(input).as_slice().to_vec(),
    );
    assert_equal(
        bytes::trim_start_by(input, predicate).to_vec(),
        go_byte_trim_start_by(input).as_slice().to_vec(),
    );
    assert_equal(
        bytes::trim_end_by(input, predicate).to_vec(),
        go_byte_trim_end_by(input).as_slice().to_vec(),
    );
    assert_equal(bytes::find_by(input, predicate).unwrap_or(-1), go_byte_find_by(input));
    assert_equal(bytes::rfind_by(input, predicate).unwrap_or(-1), go_byte_rfind_by(input));
    for characters in["", "aé", "界🙂", "�", " ,\t"] {
        assert_equal(
            bytes::trim_chars(input, characters).to_vec(),
            go_byte_trim_chars(input, characters).as_slice().to_vec(),
        );
        assert_equal(
            bytes::trim_start_chars(input, characters).to_vec(),
            go_byte_trim_start_chars(input, characters).as_slice().to_vec(),
        );
        assert_equal(
            bytes::trim_end_chars(input, characters).to_vec(),
            go_byte_trim_end_chars(input, characters).as_slice().to_vec(),
        );
        assert_equal(
            bytes::find_any(input, characters).unwrap_or(-1),
            go_byte_find_any(input, characters),
        );
        assert_equal(
            bytes::rfind_any(input, characters).unwrap_or(-1),
            go_byte_rfind_any(input, characters),
        );
    }
    for character in['a', '界', '�', '🙂'] {
        assert_equal(
            bytes::find_char(input, character).unwrap_or(-1),
            go_byte_find_char(input, character),
        );
        assert_equal(
            bytes::rfind_char(input, character).unwrap_or(-1),
            go_byte_rfind_char(input, character),
        );
    }
    let mapped = go_byte_map(input);
    assert_equal(
        testing::expect_ok(bytes::map_chars(input, map_test_character, mapped.len()), "byte map").to_vec(),
        mapped.as_slice().to_vec(),
    );
    if mapped.len() > 0 {
        testing::assert(bytes::map_chars(input, map_test_character, mapped.len() - 1).is_err());
    }
    let kinds = [unicode::Case::Upper, unicode::Case::Lower, unicode::Case::Title];
    for index in 0..3 {
        let expected_case = go_byte_case(input, index, false);
        assert_equal(
            testing::expect_ok(
                bytes::to_case(input, kinds[index], expected_case.len()),
                "byte casing",
            ).to_vec(),
            expected_case.as_slice().to_vec(),
        );
        let special = go_byte_case(input, index, true);
        assert_equal(
            testing::expect_ok(
                bytes::case_with(input, unicode::turkish_case(), kinds[index], special.len()),
                "special byte casing",
            ).to_vec(),
            special.as_slice().to_vec(),
        );
    }
}

fn check_byte_unicode() -> () {
    for value in["", " a b ", "界,a,🙂", "Straße Σς", "Iİiı", "\t\r\n", "　é　", "�"] {
        let encoded = value.to_bytes();
        for end in 0..encoded.len() + 1 {
            check_byte_unicode_case(encoded.slice(0, end));
        }
    }
    for first in 0..256 {
        check_byte_unicode_case(Vec::from_array([first.to_u8()]).as_slice());
        for second in 0..256 {
            let input = Vec::from_array([first.to_u8(), second.to_u8()]);
            assert_equal(
                bytes::find_char(input.as_slice(), '�').unwrap_or(-1),
                go_byte_find_char(input.as_slice(), '�'),
            );
            assert_equal(
                bytes::rfind_char(input.as_slice(), '�').unwrap_or(-1),
                go_byte_rfind_char(input.as_slice(), '�'),
            );
            assert_equal(
                bytes::trim_chars(input.as_slice(), "�").to_vec(),
                go_byte_trim_chars(input.as_slice(), "�").as_slice().to_vec(),
            );
            let mapped = go_byte_map(input.as_slice());
            assert_equal(
                testing::expect_ok(
                    bytes::map_chars(input.as_slice(), map_test_character, mapped.len()),
                    "two-byte map",
                ).to_vec(),
                mapped.as_slice().to_vec(),
            );
        }
    }
    for value in["é", "界", "🙂", "�"] {
        let encoded = value.to_bytes();
        for index in 0..encoded.len() {
            for byte_value in 0..256 {
                let changed = encoded.copy();
                changed[index] = byte_value.to_u8();
                check_byte_unicode_case(changed.as_slice());
            }
        }
    }
    let samples = Vec::from_array(
        [
            "K".to_bytes(),
            "K".to_bytes(),
            "ß".to_bytes(),
            "ss".to_bytes(),
            "Σ".to_bytes(),
            "ς".to_bytes(),
            "�".to_bytes(),
            Vec::from_array([255.to_u8()]),
            Vec::from_array([254.to_u8()]),
            Vec::new(),
        ],
    );
    for left in samples {
        for right in samples {
            assert_equal(
                bytes::equal_fold(left.as_slice(), right.as_slice()),
                go_byte_equal_fold(left.as_slice(), right.as_slice()),
            );
        }
    }
    let source = bytes::Bytes::from_string(" a b ");
    let fields = testing::expect_ok(bytes::fields(source.as_slice(), 2), "field aliases");
    let trimmed = bytes::trim_space(source.as_slice());
    let mapped = testing::expect_ok(
        bytes::map_chars(source.as_slice(), |value: char| Option::Some(value), 5),
        "map snapshot",
    );
    source.set(1, b'z');
    assert_equal(fields[0][0], b'z');
    assert_equal(trimmed[0], b'z');
    assert_equal(mapped.get(1), b'a');
    let calls = Ref::new(0);
    let transform = |value: char| {
        calls.set(calls.get() + 1);
        Option::Some(value)
    };
    testing::assert(bytes::map_chars(source.as_slice(), transform, -1).is_err());
    assert_equal(calls.get(), 0);
    testing::assert(bytes::map_chars(source.as_slice(), transform, 0).is_err());
    assert_equal(calls.get(), 1);
    testing::assert(bytes::fields(source.as_slice(), -1).is_err());
}
