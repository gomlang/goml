package main;

use std::io;
use io::{Read, BufRead};
use std::bytes;
use std::utf8;
use std::testing;

struct BufferCharProbe {
    data: Vec[byte],
    position: Ref[isize],
    calls: Ref[isize],
    capacity: isize,
    fail_on: isize,
    invalid_count: Option[isize],
}

fn buffer_char_probe(data: Vec[byte], capacity: isize, fail_on: isize) -> BufferCharProbe {
    BufferCharProbe {
        data,
        position: Ref::new(0),
        calls: Ref::new(0),
        capacity,
        fail_on,
        invalid_count: Option::None,
    }
}

fn buffer_char_failure() -> io::Error {
    io::Error::new(
        io::ErrorKind::Interrupted,
        "buffer char",
        Option::Some("source"),
        Option::Some(4),
        "consumed byte",
    )
}

impl Read for BufferCharProbe {
    fn read(self: BufferCharProbe, output: MutSlice[byte]) -> Result[isize, io::Error] {
        testing::assert(output.len() > 0 && output.len() <= self.capacity);
        self.calls.set(self.calls.get() + 1);
        if self.position.get() == self.data.len() {
            return Result::Ok(0)
        }
        output[0] = self.data[self.position.get()];
        self.position.set(self.position.get() + 1);
        if self.calls.get() == self.fail_on {
            match self.invalid_count {
                Some(count) => Result::Ok(count),
                None => Result::Err(buffer_char_failure()),
            }
        } else {
            Result::Ok(1)
        }
    }
}

fn check_buffer_char_sequence(data: Vec[byte], capacity: isize) -> () {
    let source = buffer_char_probe(data, capacity, -1);
    let reader = testing::expect_ok(
        io::BufReader::with_capacity(source, capacity),
        "character reader",
    );
    let alias = reader;
    let mut offset = 0;
    while offset < data.len() {
        let expected = utf8::decode_rune(data.slice(offset, data.len()));
        assert_equal(
            testing::expect_ok(reader.read_char(), "read character"),
            Option::Some(expected),
        );
        testing::expect_ok(alias.unread_char(), "character rollback");
        testing::assert(reader.unread_char().is_err());
        for index in 0..expected.1 {
            assert_equal(
                testing::expect_ok(reader.read_byte(), "original encoding after rollback"),
                Option::Some(data[offset + index]),
            );
        }
        testing::assert(reader.unread_char().is_err());
        offset += expected.1;
        assert_equal(reader.capacity(), capacity);
        testing::assert(
            reader.buffered_len()
                <= if capacity < 4 {
                    4
                } else {
                    capacity
                },
        );
    }
    assert_equal(testing::expect_ok(reader.read_char(), "character EOF"), Option::None);
    testing::assert(reader.unread_char().is_err());
}

fn check_io_buffer_chars() -> () {
    for invalid_count in[-1, 2] {
        let source = BufferCharProbe {
            invalid_count: Option::Some(invalid_count),
            ..buffer_char_probe(b"\xf0\x9f\x99\x82X", 1, 3),
        };
        let reader = testing::expect_ok(
            io::BufReader::with_capacity(source, 1),
            "invalid scalar read count",
        );
        let error = testing::expect_err(reader.read_char(), "invalid count after confirmed prefix");
        assert_equal(error.kind(), io::ErrorKind::InvalidData);
        assert_equal(reader.buffered_len(), 2);
        assert_equal(source.calls.get(), 3);
        assert_equal(source.position.get(), 3);
        testing::assert(reader.unread_char().is_err());
        assert_equal(
            testing::expect_ok(reader.fill_buf(), "confirmed invalid-count prefix").to_vec(),
            b"\xf0\x9f",
        );
        assert_equal(source.calls.get(), 3);
        let output = b"????";
        assert_equal(
            testing::expect_ok(reader.read(output.as_mut_slice()), "bulk after invalid count"),
            2,
        );
        assert_equal(output, b"\xf0\x9f??");
        assert_equal(source.calls.get(), 3);
        assert_equal(
            testing::expect_ok(reader.read_to_end(8), "suffix after invalid count").to_vec(),
            b"\x82X",
        );
        assert_equal(source.position.get(), 5);
        assert_equal(source.calls.get(), 6);
    }
    let source = buffer_char_probe(b"\xe2\x82A", 1, -1);
    let reader = testing::expect_ok(
        io::BufReader::with_capacity(source, 1),
        "lookahead larger than configured capacity",
    );
    assert_equal(
        testing::expect_ok(reader.read_char(), "invalid final continuation"),
        Option::Some(('�', 1)),
    );
    assert_equal(reader.capacity(), 1);
    assert_equal(reader.buffered_len(), 2);
    assert_equal(source.calls.get(), 3);
    assert_equal(testing::expect_ok(reader.fill_buf(), "lookahead fill view").to_vec(), b"\x82A");
    assert_equal(source.calls.get(), 3);
    let output = b"???";
    assert_equal(testing::expect_ok(reader.read(output.as_mut_slice()), "lookahead bulk read"), 2);
    assert_equal(output, b"\x82A?");
    assert_equal(source.calls.get(), 3);
    assert_equal(reader.buffered_len(), 0);
    for capacity in 1..6 {
        check_buffer_char_sequence("aé界🙂\u0000�z".to_bytes(), capacity);
        for data in[
            b"\x80",
            b"\xbf",
            b"\xc0\x80",
            b"\xc1\xbf",
            b"\xf5\x80\x80\x80",
            b"\xff",
            b"\xfe",
            b"\xe0\x80\x80",
            b"\xed\xa0\x80",
            b"\xf0\x80\x80\x80",
            b"\xf4\x90\x80\x80",
            b"\xc2A",
            b"\xe2\x82A",
            b"\xf0\x9f\x99A",
            b"\xc2",
            b"\xe2",
            b"\xe2\x82",
            b"\xf0",
            b"\xf0\x9f",
            b"\xf0\x9f\x99",
        ] {
            let invalid = testing::expect_ok(
                io::BufReader::with_capacity(buffer_char_probe(data, capacity, -1), capacity),
                "malformed initial scalar",
            );
            assert_equal(
                testing::expect_ok(invalid.read_char(), "replacement consumes one byte"),
                Option::Some(('�', 1)),
            );
            check_buffer_char_sequence(data, capacity);
        }
        let source = buffer_char_probe("🙂x".to_bytes(), capacity, -1);
        let reader = testing::expect_ok(
            io::BufReader::with_capacity(source, capacity),
            "last-byte rollback",
        );
        assert_equal(
            testing::expect_ok(reader.read_char(), "four-byte scalar"),
            Option::Some(('🙂', 4)),
        );
        testing::expect_ok(reader.unread_byte(), "rollback scalar final byte");
        testing::assert(reader.unread_char().is_err());
        assert_equal(
            testing::expect_ok(reader.read_byte(), "last original byte"),
            Option::Some(0x82.to_u8()),
        );
        assert_equal(
            testing::expect_ok(reader.read_char(), "next scalar after byte rollback"),
            Option::Some(('x', 1)),
        );
    }
    let ended = testing::expect_ok(
        io::BufReader::with_capacity(buffer_char_probe(b"a", 1, -1), 1),
        "EOF history",
    );
    assert_equal(testing::expect_ok(ended.read_char(), "last character"), Option::Some(('a', 1)));
    assert_equal(testing::expect_ok(ended.read_char(), "EOF clears history"), Option::None);
    testing::assert(ended.unread_char().is_err());
    for operation in 0..10 {
        let source = buffer_char_probe("éabc".to_bytes(), 1, -1);
        let reader = testing::expect_ok(
            io::BufReader::with_capacity(source, 1),
            "rollback invalidation",
        );
        testing::expect_ok(reader.read_char(), "establish character history");
        let output = b"?";
        match operation {
            0 => {
                let _ = reader.peek(0);
            },
            1 => {
                let _ = reader.peek(-1);
            },
            2 => {
                let _ = reader.fill_buf();
            },
            3 => {
                let _ = reader.consume(0);
            },
            4 => {
                let _ = reader.consume(-1);
            },
            5 => {
                let _ = reader.read(output.slice_mut(0, 0));
            },
            6 => {
                let _ = reader.read(output.as_mut_slice());
            },
            7 => {
                let _ = reader.read_byte();
            },
            8 => {
                let _ = reader.discard(1);
            },
            _ => reader.reset(buffer_char_probe(b"Z", 1, -1)),
        }
        testing::assert(reader.unread_char().is_err());
    }
    for operation in 0..2 {
        let reader = testing::expect_ok(
            io::BufReader::with_capacity(io::Cursor::new(bytes::Bytes::from_string("界")), 1),
            "zero helper history",
        );
        testing::expect_ok(reader.read_char(), "character before zero helper");
        if operation == 0 {
            assert_equal(testing::expect_ok(reader.discard(0), "zero discard"), 0);
        } else {
            let empty: Vec[byte] = Vec::new();
            testing::expect_ok(reader.read_exact(empty.as_mut_slice()), "empty exact read");
        }
        testing::expect_ok(reader.unread_char(), "zero helper preserves character history");
        assert_equal(
            testing::expect_ok(reader.read_char(), "replayed scalar"),
            Option::Some(('界', 3)),
        );
    }
    for operation in 0..4 {
        let source = buffer_char_probe(b"a\xf0\x9f\x99\x82X", 1, 4);
        let reader = testing::expect_ok(
            io::BufReader::with_capacity(source, 1),
            "interrupted scalar",
        );
        assert_equal(
            testing::expect_ok(reader.read_char(), "history before interruption"),
            Option::Some(('a', 1)),
        );
        assert_equal(reader.read_char(), Result::Err(buffer_char_failure()));
        assert_equal(source.calls.get(), 4);
        assert_equal(source.position.get(), 4);
        assert_equal(reader.buffered_len(), 2);
        testing::assert(reader.unread_char().is_err());
        match operation {
            0 => {
                assert_equal(
                    testing::expect_ok(reader.read_byte(), "retained first byte"),
                    Option::Some(0xf0.to_u8()),
                );
                assert_equal(
                    testing::expect_ok(reader.read_byte(), "retained second byte"),
                    Option::Some(0x9f.to_u8()),
                );
            },
            1 => {
                let output = b"????";
                assert_equal(
                    testing::expect_ok(reader.read(output.as_mut_slice()), "retained bulk prefix"),
                    2,
                );
                assert_equal(output, b"\xf0\x9f??");
            },
            2 => {
                assert_equal(testing::expect_ok(reader.peek(1), "retained peek").to_vec(), b"\xf0");
                assert_equal(
                    testing::expect_ok(reader.fill_buf(), "retained fill").to_vec(),
                    b"\xf0\x9f",
                );
                testing::expect_ok(reader.consume(2), "consume retained prefix");
            },
            _ => {
                assert_equal(testing::expect_ok(reader.discard(2), "discard retained prefix"), 2);
            },
        }
        assert_equal(source.calls.get(), 4);
        assert_equal(
            testing::expect_ok(reader.read_to_end(8), "explicit recovery after unknown progress").to_vec(),
            b"\x82X",
        );
        assert_equal(source.position.get(), 6);
    }
}
