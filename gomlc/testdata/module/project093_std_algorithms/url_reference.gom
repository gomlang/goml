package main;

use std::net::url;
use std::testing;

#[go_ffi("example.com/goml-std-algorithms/native", "ResolveURL")]
extern fn go_resolve_url(base: string, reference: string) -> (string, bool);

fn parse_reference(input: string) -> url::Reference {
    testing::expect_ok(url::Reference::parse(input, input.byte_len()), "reference parse")
}

fn check_url_references() -> () {
    check_url_ascii();
    for value in 0..128 {
        if value < 32 || value == 127 {
            let input = string_from_utf8(Vec::from_array([b'a', value.to_u8()])).1;
            let error = testing::expect_err(url::Reference::parse(input, 2), "ASCII control");
            assert_equal(error.kind(), url::ParseErrorKind::ControlCharacter);
            assert_equal(error.index(), 1);
            assert_equal(
                testing::expect_err(url::Reference::parse(input, 1), "input bound before scan").kind(),
                url::ParseErrorKind::InputLimit,
            );
        }
    }
    for input in[
        "",
        "?",
        "#",
        "?#",
        "//",
        "///",
        "http://a",
        "HTTP://u:p@a:80/%2f?a=%#",
        "mailto:user@example.com",
        "urn:a:b:c",
        "file:///tmp/a",
        "../相对/路径?q=值#片段",
        "a/b:c",
        "a%3Ab",
        "/%FF#%FF",
        "a#b?c#d",
        "a?b?c",
        "http://[fe80::1%25eth0]:80/a",
    ] {
        let value = parse_reference(input);
        testing::assert_eq(value.to_string(), input);
        assert_equal(parse_reference(value.to_string()), value);
        if input.byte_len() > 0 {
            let error = testing::expect_err(
                url::Reference::parse(input, input.byte_len() - 1),
                "reference input limit",
            );
            assert_equal(error.kind(), url::ParseErrorKind::InputLimit);
            assert_equal(error.index(), input.byte_len() - 1);
        }
    }
    let value = parse_reference("HTTP://u:p@a:80/a%2Fb?x=%#f+%FF");
    assert_equal(value.scheme(), Option::Some("HTTP"));
    assert_equal(value.raw_authority(), Option::Some("u:p@a:80"));
    assert_equal(value.raw_path(), "/a%2Fb");
    assert_equal(value.raw_query(), Option::Some("x=%"));
    assert_equal(value.raw_fragment(), Option::Some("f+%FF"));
    testing::assert(value.is_absolute());
    assert_equal(testing::expect_ok(value.decoded_path(4), "decoded path").to_vec(), b"/a/b");
    let fragment = testing::expect_some(
        testing::expect_ok(value.decoded_fragment(3), "decoded fragment"),
        "fragment present",
    );
    assert_equal(fragment.to_vec(), Vec::from_array([b'f', b'+', 255.to_u8()]));
    testing::assert(value.decoded_path(3).is_err());
    testing::assert(value.decoded_fragment(2).is_err());
    assert_equal(parse_reference("?").raw_query(), Option::Some(""));
    assert_equal(parse_reference("").raw_query(), Option::None);
    assert_equal(parse_reference("#").raw_fragment(), Option::Some(""));
    assert_equal(parse_reference("//").raw_authority(), Option::Some(""));
    testing::assert(parse_reference("a/b").scheme().is_none());
    testing::assert(!parse_reference("a/b").is_absolute());
    testing::assert(
        testing::expect_ok(parse_reference("").decoded_fragment(0), "absent fragment").is_none(),
    );
    testing::assert(parse_reference("").decoded_fragment(-1).is_err());
    for (input, kind, index) in[
        (":x", url::ParseErrorKind::InvalidScheme, 0),
        ("1:x", url::ParseErrorKind::InvalidScheme, 0),
        ("a_:x", url::ParseErrorKind::InvalidScheme, 1),
        ("a/%", url::ParseErrorKind::InvalidEscape, 2),
        ("a#%G0", url::ParseErrorKind::InvalidEscape, 2),
        ("a\nb", url::ParseErrorKind::ControlCharacter, 1),
        ("界/%", url::ParseErrorKind::InvalidEscape, 4),
    ] {
        let error = testing::expect_err(url::Reference::parse(input, 100), "invalid reference");
        assert_equal(error.kind(), kind);
        assert_equal(error.index(), index);
    }
    assert_equal(
        testing::expect_err(url::Reference::parse("", -1), "negative reference limit").kind(),
        url::ParseErrorKind::InvalidLimit,
    );
    let base = parse_reference("http://a/b/c/d;p?q");
    testing::assert_eq(
        testing::expect_ok(
            base.resolve(parse_reference("//?x#"), 100),
            "empty authority components",
        ).to_string(),
        "http://?x#",
    );
    testing::assert_eq(
        testing::expect_ok(
            parse_reference("http://a/b?x#old").resolve(parse_reference(""), 100),
            "fragment not inherited",
        ).to_string(),
        "http://a/b?x",
    );
    testing::assert_eq(
        testing::expect_ok(
            parse_reference("http://a/b?x#old").resolve(parse_reference("#"), 100),
            "empty fragment retained",
        ).to_string(),
        "http://a/b?x#",
    );
    for (reference, expected) in[
        ("g:h", "g:h"),
        ("g", "http://a/b/c/g"),
        ("./g", "http://a/b/c/g"),
        ("g/", "http://a/b/c/g/"),
        ("/g", "http://a/g"),
        ("//g", "http://g"),
        ("?y", "http://a/b/c/d;p?y"),
        ("g?y", "http://a/b/c/g?y"),
        ("#s", "http://a/b/c/d;p?q#s"),
        ("g#s", "http://a/b/c/g#s"),
        ("g?y#s", "http://a/b/c/g?y#s"),
        (";x", "http://a/b/c/;x"),
        ("g;x", "http://a/b/c/g;x"),
        ("g;x?y#s", "http://a/b/c/g;x?y#s"),
        ("", "http://a/b/c/d;p?q"),
        (".", "http://a/b/c/"),
        ("./", "http://a/b/c/"),
        ("..", "http://a/b/"),
        ("../", "http://a/b/"),
        ("../g", "http://a/b/g"),
        ("../..", "http://a/"),
        ("../../", "http://a/"),
        ("../../g", "http://a/g"),
        ("../../../g", "http://a/g"),
        ("../../../../g", "http://a/g"),
        ("/./g", "http://a/g"),
        ("/../g", "http://a/g"),
        ("g.", "http://a/b/c/g."),
        (".g", "http://a/b/c/.g"),
        ("g..", "http://a/b/c/g.."),
        ("..g", "http://a/b/c/..g"),
        ("./../g", "http://a/b/g"),
        ("./g/.", "http://a/b/c/g/"),
        ("g/./h", "http://a/b/c/g/h"),
        ("g/../h", "http://a/b/c/h"),
        ("g;x=1/./y", "http://a/b/c/g;x=1/y"),
        ("g;x=1/../y", "http://a/b/c/y"),
        ("g?y/./x", "http://a/b/c/g?y/./x"),
        ("g?y/../x", "http://a/b/c/g?y/../x"),
        ("g#s/./x", "http://a/b/c/g#s/./x"),
        ("g#s/../x", "http://a/b/c/g#s/../x"),
        ("http:g", "http:g"),
    ] {
        let reference = parse_reference(reference);
        let result = testing::expect_ok(
            base.resolve(reference, expected.byte_len()),
            "RFC reference resolution",
        );
        testing::assert_eq(result.to_string(), expected);
        assert_equal(parse_reference(result.to_string()), result);
        testing::assert(base.resolve(reference, expected.byte_len() - 1).is_err());
    }
    for root in["http://a/b/c/d;p?q#old", "https://a", "file:///a/b", "http://user:p@a:80/a//b/c"] {
        let base = parse_reference(root);
        for first in["", ".", "..", "x", "%2e", "a%2Fb", "%FF"] {
            for second in["", ".", "..", "y", "%2E%2E"] {
                for ending in["", "/", "?x=/../y", "#f/../z"] {
                    let reference = first + "/" + second + ending;
                    let parsed = parse_reference(reference);
                    if parsed.raw_authority() == Option::Some("") {
                        assert_equal(reference, "//");
                        let resolved = testing::expect_ok(
                            base.resolve(parsed, 1000),
                            "explicit empty authority",
                        );
                        testing::assert_eq(
                            resolved.to_string(),
                            base.scheme().unwrap_or("") + "://",
                        );
                        assert_equal(parse_reference(resolved.to_string()), resolved);
                        continue
                    }
                    let (expected, valid) = go_resolve_url(root, reference);
                    testing::assert(valid);
                    let resolved = testing::expect_ok(
                        base.resolve(parsed, 1000),
                        "Go reference resolution",
                    );
                    if reference == "..//" && root == "https://a" {
                        testing::assert_eq(expected, "https://a/");
                        testing::assert_eq(resolved.to_string(), "https://a//");
                    } else if reference == "..//" && root == "file:///a/b" {
                        testing::assert_eq(expected, "file:///");
                        testing::assert_eq(resolved.to_string(), "file:////");
                    } else {
                        testing::assert_eq(resolved.to_string(), expected);
                    }
                    assert_equal(parse_reference(resolved.to_string()), resolved);
                }
            }
        }
    }
    assert_equal(
        testing::expect_ok(base.resolve(parse_reference("?#"), 100), "empty markers").to_string(),
        "http://a/b/c/d;p?#",
    );
    assert_equal(
        testing::expect_ok(
            parse_reference("a:/x").resolve(parse_reference(".//g"), 100),
            "authority ambiguity",
        ).to_string(),
        "a:/.//g",
    );
    assert_equal(
        testing::expect_err(
            parse_reference("a/b").resolve(parse_reference("c"), 100),
            "relative base",
        ).kind(),
        url::ParseErrorKind::RelativeBase,
    );
    assert_equal(
        testing::expect_ok(
            parse_reference("a/b").resolve(parse_reference("x:y"), 100),
            "absolute replacement",
        ).to_string(),
        "x:y",
    );
    testing::assert(base.resolve(parse_reference(""), -1).is_err());
    assert_equal(
        testing::expect_err(url::parse_query_bounded("&&&&", 3, 0, 0), "raw query limit").kind(),
        url::CodecErrorKind::InputLimit,
    );
    testing::assert(
        testing::expect_ok(url::parse_query_bounded("&&&&", 4, 0, 0), "raw query exact limit").is_empty(),
    );
    for limits in[(-1, 0, 0), (0, -1, 0), (0, 0, -1)] {
        let (raw, fields, decoded) = limits;
        assert_equal(
            testing::expect_err(
                url::parse_query_bounded("", raw, fields, decoded),
                "negative query limits",
            ).kind(),
            url::CodecErrorKind::InvalidLimit,
        );
    }
}

fn check_url_ascii() -> () {
    for (input, expected) in[
        ("", ""),
        ("?#", "?#"),
        ("//", "//"),
        ("HTTP://Example.COM:00080/a%2fb", "HTTP://Example.COM:00080/a%2Fb"),
        (
            "https://é.example/café?q=é +#é #",
            "https://%C3%A9.example/caf%C3%A9?q=%C3%A9%20+#%C3%A9%20%23",
        ),
        ("/a b\\c[0]?x=[a]#f?/[a]", "/a%20b%5Cc%5B0%5D?x=%5Ba%5D#f?/%5Ba%5D"),
        ("/!$&'()*+,;=:@/~?a=!$&'()*+,;=:@/~?#?/~:@", "/!$&'()*+,;=:@/~?a=!$&'()*+,;=:@/~?#?/~:@"),
        (
            "http://u%3a:p%2f@[fe80::1%25eth%30]:80/%ff?x=%ff#%ff",
            "http://u%3A:p%2F@[fe80::1%25eth%30]:80/%FF?x=%FF#%FF",
        ),
        ("urn:a b:c", "urn:a%20b:c"),
        ("../a/./b/../%2e", "../a/./b/../%2E"),
        ("http://[v1.a:b]/", "http://[v1.a:b]/"),
    ] {
        let value = parse_reference(input);
        let wire = testing::expect_ok(value.to_ascii(expected.byte_len()), "ASCII output");
        testing::assert_eq(wire, expected);
        testing::assert_eq(value.to_string(), input);
        testing::assert_eq(
            testing::expect_ok(parse_reference(wire).to_ascii(wire.byte_len()), "idempotent ASCII"),
            wire,
        );
        for byte in wire.to_bytes() {
            testing::assert(byte < 128);
        }
        testing::assert(value.to_ascii(-1).is_err());
        if expected.byte_len() > 0 {
            let error = testing::expect_err(value.to_ascii(expected.byte_len() - 1), "output bound");
            assert_equal(error.kind(), url::ParseErrorKind::OutputLimit);
            assert_equal(error.index(), expected.byte_len() - 1);
        }
        assert_equal(
            testing::expect_ok(value.decoded_path(100), "raw path").to_vec(),
            testing::expect_ok(parse_reference(wire).decoded_path(100), "wire path").to_vec(),
        );
    }
    for input in["/?x=%", "/?x=%0", "/?x=%gg"] {
        let error = testing::expect_err(parse_reference(input).to_ascii(100), "malformed raw query");
        assert_equal(error.kind(), url::ParseErrorKind::InvalidEscape);
        assert_equal(error.index(), 4);
    }
    testing::assert(parse_reference("http://[bad]/").to_ascii(100).is_err());
    for byte in 32..127 {
        if byte == 35 || byte == 37 || byte == 63 {
            continue
        }
        let path = string_from_utf8(Vec::from_array([b'/', b'x', byte.to_u8()])).1;
        let reference = parse_reference(path);
        let wire = testing::expect_ok(reference.to_ascii(10), "ASCII byte output");
        assert_equal(
            testing::expect_ok(parse_reference(wire).decoded_path(10), "ASCII round trip").to_vec(),
            path.to_bytes(),
        );
        for value in wire.to_bytes() {
            testing::assert(value > 32 && value < 127 && value != b'\\');
        }
    }
}
