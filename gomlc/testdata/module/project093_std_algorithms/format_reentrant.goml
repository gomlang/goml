package main;

use std::text::format;
use std::testing;
use std::panic;

struct FormatReentrant {
    output: format::Formatter,
    calls: Ref[isize],
    append: string,
    result: string,
    raises: bool,
}

fn format_reentrant_convert(value: FormatReentrant) -> string {
    value.calls.set(value.calls.get() + 1);
    testing::expect_ok(value.output.literal(value.append), "reentrant conversion append");
    if value.raises {
        panic::raise("reentrant formatting panic")
    }
    value.result
}

impl ToString for FormatReentrant {
    fn to_string(self: FormatReentrant) -> string {
        format_reentrant_convert(self)
    }
}

impl Debug for FormatReentrant {
    fn debug(self: FormatReentrant) -> string {
        format_reentrant_convert(self)
    }
}

pub fn test_format_reentrant() -> () {
    let output = testing::expect_ok(format::Formatter::new(5), "reentrant display formatter");
    testing::expect_ok(output.literal("a"), "initial display prefix");
    let snapshot = output.finish();
    let calls = Ref::new(0);
    let value = FormatReentrant { output, calls, append: "bc", result: "xyz", raises: false };
    let error = testing::expect_err(
        output.display(value, format::Padding::plain()),
        "reentrant display budget",
    );
    testing::assert_eq(error, format::Error::LimitExceeded(5));
    testing::assert_eq(calls.get(), 1);
    testing::assert_eq(output.finish(), "abc");
    testing::assert_eq(output.len(), 3);
    testing::assert_eq(output.remaining(), 2);
    testing::assert_eq(snapshot, "a");
    testing::expect_ok(output.literal("de"), "remaining display capacity");
    testing::assert_eq(output.finish(), "abcde");
    testing::assert_eq(output.remaining(), 0);
    let output = testing::expect_ok(format::Formatter::new(4), "reentrant debug formatter");
    let calls = Ref::new(0);
    let value = FormatReentrant { output, calls, append: "xy", result: "z", raises: false };
    let padding = format::Padding { width: 3, alignment: format::Alignment::Right, fill: ' ' };
    let error = testing::expect_err(output.debug(value, padding), "reentrant padded debug budget");
    testing::assert_eq(error, format::Error::LimitExceeded(4));
    testing::assert_eq(calls.get(), 1);
    testing::assert_eq(output.finish(), "xy");
    testing::assert_eq(output.len(), 2);
    testing::assert_eq(output.remaining(), 2);
    testing::expect_ok(output.literal("ok"), "remaining debug capacity");
    testing::assert_eq(output.finish(), "xyok");
    for use_debug in[false, true] {
        let output = testing::expect_ok(format::Formatter::new(4), "reentrant panic formatter");
        testing::expect_ok(output.literal("a"), "initial panic prefix");
        let snapshot = output.finish();
        let calls = Ref::new(0);
        let value = FormatReentrant { output, calls, append: "b", result: "never", raises: true };
        let result = panic::catch(
            || {
                if use_debug {
                    output.debug(value, format::Padding::plain())
                } else {
                    output.display(value, format::Padding::plain())
                }
            },
        );
        testing::assert(result.is_err());
        testing::assert_eq(calls.get(), 1);
        testing::assert_eq(snapshot, "a");
        testing::assert_eq(output.finish(), "ab");
        testing::assert_eq(output.len(), 2);
        testing::assert_eq(output.remaining(), 2);
        testing::expect_ok(output.literal("cd"), "formatter remains usable after conversion panic");
        testing::assert_eq(output.finish(), "abcd");
        testing::assert_eq(output.remaining(), 0);
    }
}
