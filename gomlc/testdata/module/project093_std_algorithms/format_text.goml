package main;

use std::text::format;
use std::testing;
use std::panic;

struct FormatValue {
    calls: Ref[isize],
    text: string,
    raises: bool,
}

impl ToString for FormatValue {
    fn to_string(self: FormatValue) -> string {
        self.calls.set(self.calls.get() + 1);
        if self.raises {
            panic::raise("format conversion panic")
        }
        self.text
    }
}

impl Debug for FormatValue {
    fn debug(self: FormatValue) -> string {
        self.calls.set(self.calls.get() + 1);
        "debug:" + self.text
    }
}

fn format_output(limit: isize) -> format::Formatter {
    testing::expect_ok(format::Formatter::new(limit), "formatter construction")
}

fn format_text_value(value: string, spec: format::TextSpec) -> string {
    let output = format_output(1024);
    testing::expect_ok(output.text(value, spec), "text field");
    output.finish()
}

pub fn test_format_text() -> () {
    testing::assert(format::Formatter::new(-1).is_err());
    let empty = format_output(0);
    testing::expect_ok(empty.literal(""), "empty literal");
    testing::assert(empty.literal("a").is_err());
    testing::assert_eq(empty.finish(), "");
    let output = format_output(6);
    let alias = output;
    testing::expect_ok(output.literal("é"), "UTF-8 literal");
    let snapshot = output.finish();
    testing::expect_ok(alias.literal("界"), "shared formatter append");
    testing::assert_eq(snapshot, "é");
    testing::assert_eq(output.finish(), "é界");
    testing::assert_eq(output.len(), 5);
    testing::assert_eq(alias.remaining(), 1);
    testing::assert(output.literal("界").is_err());
    testing::assert_eq(alias.finish(), "é界");
    testing::expect_ok(alias.literal("!"), "exact budget");
    testing::assert_eq(output.finish(), "é界!");
    let mut spec = format::TextSpec::plain();
    spec.padding = format::Padding { width: 5, alignment: format::Alignment::Center, fill: '界' };
    testing::assert_eq(format_text_value("é", spec), "界界é界界");
    spec.padding.width = 4;
    testing::assert_eq(format_text_value("é", spec), "界é界界");
    spec.padding.alignment = format::Alignment::Left;
    testing::assert_eq(format_text_value("é", spec), "é界界界");
    spec.padding.alignment = format::Alignment::Right;
    testing::assert_eq(format_text_value("é", spec), "界界界é");
    spec.padding = format::Padding::plain();
    spec.max_chars = Option::Some(2);
    testing::assert_eq(format_text_value("e\u0301🙂", spec), "e\u0301");
    spec.max_chars = Option::Some(1);
    spec.style = format::TextStyle::QuotedAscii;
    testing::assert_eq(format_text_value("é🙂", spec), "\"\\u00e9\"");
    spec.style = format::TextStyle::Quoted;
    testing::assert_eq(format_text_value("é🙂", spec), "\"é\"");
    spec.max_chars = Option::Some(0);
    spec.padding = format::Padding { width: 4, alignment: format::Alignment::Right, fill: '.' };
    testing::assert_eq(format_text_value("unused", spec), "..\"\"");
    let bounded = format_output(4);
    spec = format::TextSpec::plain();
    spec.padding = format::Padding { width: 2, alignment: format::Alignment::Right, fill: '界' };
    testing::expect_ok(bounded.text("a", spec), "multibyte exact padding budget");
    testing::assert_eq(bounded.finish(), "界a");
    let short = format_output(3);
    testing::assert(short.text("a", spec).is_err());
    testing::assert_eq(short.len(), 0);
    spec.padding.width = 9223372036854775807;
    testing::assert(short.text("", spec).is_err());
    testing::assert_eq(short.len(), 0);
    spec = format::TextSpec::plain();
    spec.max_chars = Option::Some(-1);
    testing::assert(short.text("", spec).is_err());
    let calls = Ref::new(0);
    let value = FormatValue { calls, text: "ok", raises: false };
    let output = format_output(20);
    let invalid = format::Padding { width: -1, ..format::Padding::plain() };
    testing::assert(output.display(value, invalid).is_err());
    testing::assert(output.debug(value, invalid).is_err());
    testing::assert_eq(calls.get(), 0);
    testing::expect_ok(output.display(value, format::Padding::plain()), "display conversion");
    testing::expect_ok(output.debug(value, format::Padding::plain()), "debug conversion");
    testing::assert_eq(calls.get(), 2);
    testing::assert_eq(output.finish(), "okdebug:ok");
    let tiny = format_output(1);
    testing::assert(tiny.display(value, format::Padding::plain()).is_err());
    testing::assert_eq(calls.get(), 3);
    testing::assert_eq(tiny.len(), 0);
    let failure = panic::catch(
        || output.display(FormatValue { raises: true, ..value }, format::Padding::plain()),
    );
    testing::assert(failure.is_err());
    testing::assert_eq(calls.get(), 4);
    testing::assert_eq(output.finish(), "okdebug:ok");
}
