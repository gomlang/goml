package main;

use std::num;
use std::testing;

#[go_ffi("strconv", "FormatInt")]
extern fn go_format_int(value: i64, radix: isize) -> string;

#[go_ffi("strconv", "FormatUint")]
extern fn go_format_uint(value: u64, radix: isize) -> string;

fn check_integer_format() -> () {
    let signed: Vec[i64] = Vec::from_array(
        [
            -9223372036854775807 - 1,
            -9223372036854775807,
            -123456789,
            -36,
            -1,
            0,
            1,
            35,
            36,
            9223372036854775807,
        ],
    );
    let unsigned: Vec[u64] = Vec::from_array(
        [0, 1, 35, 36, 4294967295, 4294967296, 9223372036854775808, 18446744073709551615],
    );
    for index in 0..128 {
        let value = (index.to_u64() << 48) | (index.to_u64() * 123456789);
        unsigned.push(value);
        unsigned.push(value ^ 18446744073709551615);
    }
    for radix in 2..37 {
        for value in signed {
            let encoded = testing::expect_ok(num::format_int(value, radix), "signed format");
            assert_equal(encoded, go_format_int(value, radix));
            assert_equal(
                testing::expect_ok(
                    num::parse_int_radix_structured(encoded, radix),
                    "signed roundtrip",
                ).to_i64(),
                value,
            );
            let output = b"??????????????????????????????????????????????????????????????????";
            let count = testing::expect_ok(
                num::write_int(output.as_mut_slice(), value, radix),
                "signed buffer",
            );
            assert_equal(count, encoded.byte_len());
            assert_equal(output.slice(0, count).to_vec(), encoded.to_bytes());
            assert_equal(output[count], b'?');
            let small = output.as_mut_slice().sub(0, count - 1);
            let before = output.copy();
            testing::assert(num::write_int(small, value, radix).is_err());
            assert_equal(output, before);
        }
        for value in unsigned {
            let encoded = testing::expect_ok(num::format_uint(value, radix), "unsigned format");
            assert_equal(encoded, go_format_uint(value, radix));
            assert_equal(
                testing::expect_ok(
                    num::parse_uint_radix_structured(encoded, radix),
                    "unsigned roundtrip",
                ).to_u64(),
                value,
            );
            let output = b"??????????????????????????????????????????????????????????????????";
            let count = testing::expect_ok(
                num::write_uint(output.as_mut_slice(), value, radix),
                "unsigned buffer",
            );
            assert_equal(output.slice(0, count).to_vec(), encoded.to_bytes());
            assert_equal(output[count], b'?');
        }
    }
    for radix in 2..37 {
        for value in[0.to_u64(), 1.to_u64(), 18446744073709551615] {
            let encoded = testing::expect_ok(num::format_uint(value, radix), "unsigned length");
            for capacity in 0..encoded.byte_len() + 2 {
                let output = b"??????????????????????????????????????????????????????????????????";
                let before = output.copy();
                let result = num::write_uint(
                    output.as_mut_slice().sub(1, 1 + capacity),
                    value,
                    radix,
                );
                if capacity < encoded.byte_len() {
                    match result {
                        Err(num::FormatIntError::BufferTooSmall(needed, available)) => {
                            assert_equal(needed, encoded.byte_len());
                            assert_equal(available, capacity);
                        },
                        _ => testing::fail("expected unsigned capacity error"),
                    }
                    assert_equal(output, before);
                } else {
                    let count = testing::expect_ok(result, "unsigned bounded output");
                    assert_equal(count, encoded.byte_len());
                    assert_equal(output.slice(1, 1 + count).to_vec(), encoded.to_bytes());
                    assert_equal(output[0], b'?');
                    assert_equal(
                        output.slice(1 + count, output.len()).to_vec(),
                        before.slice(1 + count, before.len()).to_vec(),
                    );
                }
            }
        }
    }
    for radix in[-1, 0, 1, 37, 100] {
        testing::assert(num::format_uint(1, radix).is_err());
        testing::assert(num::format_int(-1, radix).is_err());
        let output = b"untouched";
        testing::assert(num::write_uint(output.as_mut_slice(), 1, radix).is_err());
        assert_equal(output, b"untouched");
    }
}
