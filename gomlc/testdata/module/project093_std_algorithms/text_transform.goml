package main;

use std::text;
use std::unicode;
use std::testing;
use std::bytes;

#[go_ffi("strings", "Replace")]
extern fn go_text_replace(value: string, old: string, replacement: string, maximum: isize) -> string;

#[go_ffi("strings", "Repeat")]
extern fn go_text_repeat(value: string, count: isize) -> string;

#[go_ffi("example.com/goml-std-algorithms/native", "TextMap")]
extern fn go_text_map(value: string) -> string;

#[go_ffi("example.com/goml-std-algorithms/native", "TextCase")]
extern fn go_text_case(value: string, kind: isize, special: bool) -> string;

fn map_test_character(value: char) -> Option[char] {
    if value == ',' {
        Option::None
    } else if value == 'a' {
        Option::Some('界')
    } else {
        Option::Some(unicode::to_uppercase(value))
    }
}

fn check_text_transform() -> () {
    let values = ["", "a", "aaa", "ababa", "é界🙂", "Straße", "Iİiı", ",a,b,", "\r\n"];
    for value in values {
        for old in values {
            for replacement in["", "x", "🙂"] {
                for maximum in[-2, -1, 0, 1, 2, 100] {
                    let expected = go_text_replace(value, old, replacement, maximum);
                    assert_equal(
                        testing::expect_ok(
                            text::replace_n_checked(
                                value,
                                old,
                                replacement,
                                maximum,
                                expected.byte_len(),
                            ),
                            "checked replace",
                        ),
                        expected,
                    );
                    if expected.byte_len() > 0 {
                        testing::assert(
                            text::replace_n_checked(
                                value,
                                old,
                                replacement,
                                maximum,
                                expected.byte_len() - 1,
                            ).is_err(),
                        );
                    }
                }
                assert_equal(
                    testing::expect_ok(
                        text::replace_checked(value, old, replacement, 1000),
                        "replace all",
                    ),
                    go_text_replace(value, old, replacement, -1),
                );
            }
        }
        for count in 0..5 {
            let expected = go_text_repeat(value, count);
            assert_equal(
                testing::expect_ok(
                    text::repeat_checked(value, count, expected.byte_len()),
                    "checked repeat",
                ),
                expected,
            );
            if expected.byte_len() > 0 {
                testing::assert(
                    text::repeat_checked(value, count, expected.byte_len() - 1).is_err(),
                );
            }
        }
        for second in values {
            let parts = Vec::from_array([value, second]);
            let expected = value + "🙂" + second;
            assert_equal(
                testing::expect_ok(
                    text::join_checked(parts, "🙂", expected.byte_len()),
                    "checked join",
                ),
                expected,
            );
            testing::assert(text::join_checked(parts, "🙂", expected.byte_len() - 1).is_err());
        }
        let mapped = go_text_map(value);
        assert_equal(
            testing::expect_ok(
                text::map_chars(value, map_test_character, mapped.byte_len()),
                "mapped text",
            ),
            mapped,
        );
        if mapped.byte_len() > 0 {
            testing::assert(
                text::map_chars(value, map_test_character, mapped.byte_len() - 1).is_err(),
            );
        }
        let kinds = [unicode::Case::Upper, unicode::Case::Lower, unicode::Case::Title];
        for index in 0..3 {
            let expected = go_text_case(value, index, false);
            assert_equal(
                testing::expect_ok(
                    text::case_checked(value, kinds[index], expected.byte_len()),
                    "simple casing",
                ),
                expected,
            );
            let special = go_text_case(value, index, true);
            assert_equal(
                testing::expect_ok(
                    text::case_with_checked(
                        value,
                        unicode::turkish_case(),
                        kinds[index],
                        special.byte_len(),
                    ),
                    "special casing",
                ),
                special,
            );
        }
    }
    let calls = Ref::new(0);
    let transform = |value: char| {
        calls.set(calls.get() + 1);
        if calls.get() == 1 {
            Option::None
        } else {
            Option::Some(value)
        }
    };
    assert_equal(testing::expect_ok(text::map_chars("é界🙂", transform, 7), "stateful map"), "界🙂");
    assert_equal(calls.get(), 3);
    testing::assert(text::map_chars("x", transform, -1).is_err());
    assert_equal(calls.get(), 3);
    calls.set(0);
    testing::assert(text::map_chars("abc", transform, 0).is_err());
    assert_equal(calls.get(), 2);
    assert_equal(
        testing::expect_ok(text::map_chars("abc", |_: char| Option::None, 0), "remove all"),
        "",
    );
    assert_equal(
        testing::expect_ok(text::repeat_checked("", 9223372036854775807, 0), "repeat empty"),
        "",
    );
    match text::repeat_checked("ab", 9223372036854775807, 100) {
        Result::Err(bytes::TransformError::LengthOverflow) => (),
        _ => testing::fail("repeat overflow"),
    }
    testing::assert(text::repeat_checked("", -1, 0).is_err());
    testing::assert(text::repeat_checked("", 0, -1).is_err());
    testing::assert(text::join_checked(Vec::new(), "", -1).is_err());
    testing::assert(text::replace_checked("", "", "", -1).is_err());
    assert_equal(testing::expect_ok(text::join_checked(Vec::new(), "unused", 0), "empty join"), "");
    assert_equal(text::replace("abc", "", "x"), "abc");
    assert_equal(
        testing::expect_ok(text::replace_checked("abc", "", "x", 7), "boundary insertion"),
        "xaxbxcx",
    );
}
