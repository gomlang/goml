package main;

use std::text;
use std::num;
use std::bytes;
use std::testing;

#[go_ffi("example.com/goml-std-algorithms/native", "AppendConversions")]
extern fn go_append_conversions(
    prefix: string,
    signed: i64,
    unsigned: u64,
    floating: f64,
    flag: bool,
    value: string,
) -> string;

fn check_text_appends() -> () {
    for invalid in[
        Vec::from_array([0xff.to_u8()]),
        Vec::from_array([0xc0.to_u8(), 0x80.to_u8()]),
        Vec::from_array([0xed.to_u8(), 0xa0.to_u8(), 0x80.to_u8()]),
        Vec::from_array([0xf0.to_u8(), 0x9f.to_u8(), 0x99.to_u8()]),
    ] {
        let output = text::StringBuilder::with_capacity(32);
        output.write_string("界:");
        let before = output.values.copy();
        let capacity = output.values.capacity();
        testing::assert(output.write_bytes(bytes::Bytes::from_vec(invalid)).is_err());
        assert_equal(output.values, before);
        assert_equal(output.values.capacity(), capacity);
    }
    for value in["", "ascii", "界🙂"] {
        let input = bytes::Bytes::from_string(value);
        let output = text::StringBuilder::new();
        testing::expect_ok(output.write_bytes(input), "validated byte append");
        let snapshot = output.finish();
        if input.len() > 0 {
            input.set(0, 0xff.to_u8());
        }
        assert_equal(output.finish(), value);
        output.write_string("!");
        assert_equal(snapshot, value);
        assert_equal(output.finish(), value + "!");
    }
    for prefix in["", "prefix:", "界"] {
        for value in["", "ascii", "🙂\n界"] {
            let total = prefix.byte_len() + value.byte_len();
            for limit in 0..total + 2 {
                let output = text::StringBuilder::new();
                output.write_string(prefix);
                let before = output.values.copy();
                let result = output.write_string_checked(value, limit);
                if total > limit {
                    match result {
                        Err(bytes::TransformError::LimitExceeded(actual)) => assert_equal(
                            actual,
                            limit,
                        ),
                        _ => testing::fail("expected append limit error"),
                    }
                    assert_equal(output.values, before);
                } else {
                    testing::expect_ok(result, "checked append");
                    assert_equal(output.finish(), prefix + value);
                }
            }
            let output = text::StringBuilder::new();
            output.write_string(prefix);
            let before = output.finish();
            testing::assert(output.write_line_checked(value, total).is_err());
            assert_equal(output.finish(), before);
            testing::expect_ok(output.write_line_checked(value, total + 1), "checked line");
            assert_equal(output.finish(), prefix + value + "\n");
            assert_equal(before, prefix);
            if prefix.byte_len() > 0 {
                output.values[0] = b'X';
                assert_equal(before, prefix);
            }
        }
    }
    let output = text::StringBuilder::new();
    let alias = output;
    testing::assert(alias.write_char_checked('界', 2).is_err());
    assert_equal(output.len(), 0);
    testing::expect_ok(alias.write_char_checked('界', 3), "checked scalar");
    assert_equal(output.finish(), "界");
    testing::assert(output.write_string_checked("x", 3).is_err());
    for limit in[-1, -9223372036854775807 - 1] {
        match alias.write_string_checked("", limit) {
            Err(bytes::TransformError::InvalidLimit(actual)) => assert_equal(actual, limit),
            _ => testing::fail("negative append limit accepted"),
        }
        testing::assert(alias.write_char_checked('a', limit).is_err());
        testing::assert(alias.write_line_checked("", limit).is_err());
        assert_equal(output.finish(), "界");
    }
    output.clear();
    testing::expect_ok(output.write_string_checked("", 0), "empty zero limit");
    for prefix in["", "prefix:", "界"] {
        for bits in[
            0.to_u64(),
            1.to_u64(),
            1.to_u64() << 63,
            0x3ff4000000000000.to_u64(),
            0x7ff0000000000000.to_u64(),
            18446744073709551615,
        ] {
            let floating = float64_from_bits(bits);
            let value = "a\"\\\n界 ";
            let flag = bits % 2 == 0;
            let expected = go_append_conversions(prefix, bits.to_i64(), bits, floating, flag, value);
            let parts = [
                testing::expect_ok(num::format_int(bits.to_i64(), 16), "signed append"),
                "|",
                testing::expect_ok(num::format_uint(bits, 36), "unsigned append"),
                "|",
                testing::expect_ok(
                    num::format_float64_shortest(floating, num::FloatNotation::General, 128),
                    "floating append",
                ),
                "|",
                flag.to_string(),
                "|",
                testing::expect_ok(text::quote_graphic(value, 128), "quoted append"),
            ];
            for limit in[expected.byte_len() - 1, expected.byte_len(), expected.byte_len() + 1] {
                let output = text::StringBuilder::new();
                output.write_string(prefix);
                let mut failed = false;
                for part in parts {
                    let before = output.values.copy();
                    match output.write_string_checked(part, limit) {
                        Ok(()) => (),
                        Err(_) => {
                            assert_equal(output.values, before);
                            failed = true;
                            break
                        },
                    }
                }
                assert_equal(failed, limit < expected.byte_len());
                if !failed {
                    assert_equal(output.finish(), expected);
                }
            }
        }
    }
}
