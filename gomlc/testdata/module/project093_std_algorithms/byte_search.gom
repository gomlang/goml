package main;

use std::bytes;
use std::testing;

#[go_ffi("bytes", "Index")]
extern fn go_bytes_index(input: Slice[byte], pattern: Slice[byte]) -> isize;

#[go_ffi("bytes", "LastIndex")]
extern fn go_bytes_last_index(input: Slice[byte], pattern: Slice[byte]) -> isize;

#[go_ffi("bytes", "HasPrefix")]
extern fn go_bytes_prefix(input: Slice[byte], pattern: Slice[byte]) -> bool;

#[go_ffi("bytes", "HasSuffix")]
extern fn go_bytes_suffix(input: Slice[byte], pattern: Slice[byte]) -> bool;

#[go_ffi("bytes", "IndexByte")]
extern fn go_bytes_index_byte(input: Slice[byte], value: byte) -> isize;

#[go_ffi("bytes", "LastIndexByte")]
extern fn go_bytes_last_index_byte(input: Slice[byte], value: byte) -> isize;

fn check_byte_search_pair(input: Slice[byte], pattern: Slice[byte]) -> () {
    let finder = bytes::Finder::new(pattern);
    let first = go_bytes_index(input, pattern);
    let last = go_bytes_last_index(input, pattern);
    assert_equal(bytes::find(input, pattern).unwrap_or(-1), first);
    assert_equal(bytes::rfind(input, pattern).unwrap_or(-1), last);
    assert_equal(finder.find(input).unwrap_or(-1), first);
    assert_equal(finder.rfind(input).unwrap_or(-1), last);
    assert_equal(finder.contains(input), first >= 0);
    assert_equal(bytes::contains(input, pattern), first >= 0);
    assert_equal(bytes::starts_with(input, pattern), go_bytes_prefix(input, pattern));
    assert_equal(bytes::ends_with(input, pattern), go_bytes_suffix(input, pattern));
    match bytes::cut(input, pattern) {
        Option::None => assert_equal(first, -1),
        Option::Some((before, after)) => {
            testing::assert(first >= 0);
            assert_equal(before.to_vec(), input.sub(0, first).to_vec());
            assert_equal(after.to_vec(), input.sub(first + pattern.len(), input.len()).to_vec());
        },
    }
    match bytes::cut_prefix(input, pattern) {
        Option::None => testing::assert(!go_bytes_prefix(input, pattern)),
        Option::Some(rest) => {
            testing::assert(go_bytes_prefix(input, pattern));
            assert_equal(rest.to_vec(), input.sub(pattern.len(), input.len()).to_vec());
        },
    }
    match bytes::cut_suffix(input, pattern) {
        Option::None => testing::assert(!go_bytes_suffix(input, pattern)),
        Option::Some(rest) => {
            testing::assert(go_bytes_suffix(input, pattern));
            assert_equal(rest.to_vec(), input.sub(0, input.len() - pattern.len()).to_vec());
        },
    }
}

fn check_byte_search() -> () {
    let inputs: Vec[Vec[byte]] = Vec::new();
    for length in 0..8 {
        for bits in 0..(1 << length) {
            let input: Vec[byte] = Vec::new();
            for index in 0..length {
                input.push(
                    if (bits & (1 << index)) == 0 {
                        0
                    } else {
                        255
                    },
                );
            }
            inputs.push(input);
        }
    }
    for input in inputs {
        for pattern in inputs {
            check_byte_search_pair(input.as_slice(), pattern.as_slice());
        }
        for value in 0..256 {
            let byte_value = value.to_u8();
            assert_equal(
                bytes::find_byte(input.as_slice(), byte_value).unwrap_or(-1),
                go_bytes_index_byte(input.as_slice(), byte_value),
            );
            assert_equal(
                bytes::rfind_byte(input.as_slice(), byte_value).unwrap_or(-1),
                go_bytes_last_index_byte(input.as_slice(), byte_value),
            );
        }
    }
    let pattern = bytes::Bytes::from_string("aba");
    let finder = bytes::Finder::new(pattern.as_slice());
    pattern.set(0, b'x');
    let input = bytes::Bytes::from_string("abababa");
    assert_equal(finder.find(input.as_slice()), Option::Some(0));
    assert_equal(finder.rfind(input.as_slice()), Option::Some(4));
    let (before, after) = testing::expect_some(
        bytes::cut(input.as_slice(), bytes::Bytes::from_string("b").as_slice()),
        "cut",
    );
    input.set(0, b'z');
    input.set(2, b'y');
    assert_equal(before[0], b'z');
    assert_equal(after[0], b'y');
    let repeated = bytes::Bytes::new();
    let needle = bytes::Bytes::new();
    for _ in 0..100000 {
        repeated.push(b'a');
    }
    for _ in 0..1000 {
        needle.push(b'a');
    }
    needle.push(b'b');
    check_byte_search_pair(repeated.as_slice(), needle.as_slice());
    repeated.push(b'b');
    check_byte_search_pair(repeated.as_slice(), needle.as_slice());
}
