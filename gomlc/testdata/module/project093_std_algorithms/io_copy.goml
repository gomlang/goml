package main;

use std::io;
use std::io::{Read, Write};
use std::bytes;
use std::testing;

struct CopyReader {
    cursor: io::Cursor,
    interrupted: Ref[bool],
}

impl Read for CopyReader {
    fn read(self: CopyReader, buffer: MutSlice[byte]) -> Result[isize, io::Error] {
        if self.interrupted.get() {
            self.interrupted.set(false);
            return Result::Err(
                io::Error::new(
                    io::ErrorKind::Interrupted,
                    "copy reader",
                    Option::None,
                    Option::None,
                    "retry",
                ),
            )
        }
        self.cursor.read(buffer)
    }
}

struct CopyWriter {
    cursor: io::Cursor,
    interrupted: Ref[bool],
}

impl Write for CopyWriter {
    fn write(self: CopyWriter, buffer: Slice[byte]) -> Result[isize, io::Error] {
        if self.interrupted.get() {
            self.interrupted.set(false);
            return Result::Err(
                io::Error::new(
                    io::ErrorKind::Interrupted,
                    "copy writer",
                    Option::None,
                    Option::None,
                    "retry",
                ),
            )
        }
        let count = if buffer.len() > 2 {
            2
        } else {
            buffer.len()
        };
        self.cursor.write(buffer.sub(0, count))
    }
}

fn check_io_copy() -> () {
    for length in 0..20 {
        let data = Vec::new();
        for index in 0..length {
            data.push(index.to_u8());
        }
        for capacity in 1..10 {
            let reader = CopyReader {
                cursor: io::Cursor::new(bytes::Bytes::from_vec(data)),
                interrupted: Ref::new(false),
            };
            let writer = CopyWriter {
                cursor: io::Cursor::new(bytes::Bytes::new()),
                interrupted: Ref::new(false),
            };
            let storage = Vec::new();
            for _ in 0..capacity + 2 {
                storage.push(255.to_u8());
            }
            assert_equal(
                testing::expect_ok(
                    io::copy_buffer(reader, writer, storage.as_mut_slice().sub(1, capacity + 1)),
                    "copy buffer",
                ),
                length.to_u64(),
            );
            assert_equal(writer.cursor.bytes().to_vec(), data);
            assert_equal(storage[0], 255.to_u8());
            assert_equal(storage[capacity + 1], 255.to_u8());
        }
        for count in 0..length + 2 {
            let reader = io::Cursor::new(bytes::Bytes::from_vec(data));
            let writer = io::Cursor::new(bytes::Bytes::new());
            let result = io::copy_n(reader, writer, count);
            if count <= length {
                assert_equal(testing::expect_ok(result, "copy n"), count.to_u64());
                assert_equal(reader.position(), count);
                assert_equal(writer.bytes().to_vec(), data.slice(0, count).to_vec());
            } else {
                match result {
                    Err(error) => assert_equal(error.kind(), io::ErrorKind::UnexpectedEof),
                    Ok(_) => testing::assert(false),
                }
                assert_equal(writer.bytes().to_vec(), data);
                assert_equal(reader.position(), length);
            }
        }
        let reader = io::Cursor::new(bytes::Bytes::from_vec(data));
        assert_equal(
            testing::expect_ok(io::copy(reader, io::Discard::new()), "discard copy"),
            length.to_u64(),
        );
    }
    let events = Vec::new();
    let probe = multi_probe(events, 1, 0);
    let empty: Vec[byte] = Vec::new();
    testing::assert(io::copy_buffer(probe, probe, empty.as_mut_slice()).is_err());
    testing::assert(io::copy_n(probe, probe, -1).is_err());
    assert_equal(testing::expect_ok(io::copy_n(probe, probe, 0), "zero copy"), 0.to_u64());
    assert_equal(events.len(), 0);
    let data = b"abc";
    let scratch = b"???";
    for count in[-1, 4] {
        let bad = multi_probe(events, 2, count);
        let writer = io::Cursor::new(bytes::Bytes::new());
        testing::assert(io::copy_buffer(bad, writer, scratch.as_mut_slice()).is_err());
        assert_equal(writer.bytes().len(), 0);
        let reader = io::Cursor::new(bytes::Bytes::from_vec(data));
        testing::assert(io::copy_buffer(reader, bad, scratch.as_mut_slice()).is_err());
    }
    let reader = io::Cursor::new(bytes::Bytes::from_vec(data));
    testing::assert(io::copy_buffer(reader, probe, scratch.as_mut_slice()).is_err());
    assert_equal(reader.position(), 3);
    assert_equal(testing::expect_ok(io::Discard::new().write(empty.as_slice()), "discard empty"), 0);
    testing::expect_ok(io::Discard::new().flush(), "discard flush");
}
