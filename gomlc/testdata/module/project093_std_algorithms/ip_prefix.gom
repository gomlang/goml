package main;

use std::net;
use std::testing;

#[go_ffi("example.com/goml-std-algorithms/native", "PrefixFacts")]
extern fn go_prefix_facts(prefix: string, address: string, other: string) -> (string, bool, bool);

#[go_ffi("example.com/goml-std-algorithms/native", "ValidPrefix")]
extern fn go_valid_prefix(input: string) -> bool;

fn check_ip_prefixes() -> () {
    let addresses = Vec::from_array(
        [
            "0.0.0.0",
            "255.255.255.255",
            "192.0.2.129",
            "192.0.2.1",
            "192.0.3.1",
            "::",
            "::1",
            "2001:db8:abcd:1234:5678:9abc:def0:1234",
            "2001:db8::1",
            "ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff",
            "::ffff:192.0.2.1",
        ],
    );
    for host in addresses {
        let ip = testing::expect_ok(net::IpAddr::parse(host), "IP address");
        let width = if ip.is_ipv4() {
            32
        } else {
            128
        };
        for bits in 0..width + 1 {
            let text = host + "/" + bits.to_string();
            let prefix = testing::expect_ok(net::IpPrefix::parse(text), "prefix");
            assert_equal(prefix.address(), ip);
            assert_equal(prefix.bits(), bits);
            assert_equal(prefix.is_single_ip(), bits == width);
            assert_equal(prefix.masked().masked(), prefix.masked());
            assert_equal(
                testing::expect_ok(net::IpPrefix::parse(prefix.to_string()), "roundtrip"),
                prefix,
            );
            for other in addresses {
                let candidate = testing::expect_ok(net::IpAddr::parse(other), "candidate");
                let other_width = if candidate.is_ipv4() {
                    32
                } else {
                    128
                };
                let other_bits = if bits < other_width {
                    bits
                } else {
                    other_width
                };
                let other_prefix = testing::expect_ok(
                    net::IpPrefix::new(candidate, other_bits),
                    "other prefix",
                );
                let (masked, contains, overlaps) = go_prefix_facts(
                    text,
                    other,
                    other_prefix.to_string(),
                );
                let expected = testing::expect_ok(net::IpPrefix::parse(masked), "Go masked prefix");
                assert_equal(prefix.masked(), expected);
                assert_equal(prefix.contains(candidate), contains);
                assert_equal(prefix.overlaps(other_prefix), overlaps);
                assert_equal(other_prefix.overlaps(prefix), overlaps);
                let wider = testing::expect_ok(
                    net::IpPrefix::new(candidate, other_bits / 2),
                    "wider prefix",
                );
                let (_, _, wide_overlap) = go_prefix_facts(text, other, wider.to_string());
                assert_equal(prefix.overlaps(wider), wide_overlap);
                assert_equal(wider.overlaps(prefix), wide_overlap);
            }
            assert_equal(prefix.address(), ip);
        }
        testing::assert(net::IpPrefix::new(ip, -1).is_err());
        testing::assert(net::IpPrefix::new(ip, width + 1).is_err());
    }
    for value in[
        "",
        "127.0.0.1",
        "127.0.0.1/",
        "127.0.0.1/33",
        "127.0.0.1/01",
        "127.0.0.1/+1",
        "127.0.0.1/-1",
        "::/129",
        "fe80::1%3/64",
        "::/0/0",
        "127.00.0.1/24",
        "::/000",
        "::/0",
        "::ffff:192.0.2.1/120",
    ] {
        assert_equal(net::IpPrefix::parse(value).is_ok(), go_valid_prefix(value));
    }
}
