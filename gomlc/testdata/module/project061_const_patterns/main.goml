package main;

use test::const_patterns::values;
use test::const_patterns::values::{helper};

fn classify(value: isize) -> string {
    match value {
        values::ANSWER | values::ALTERNATE => "known",
        _ => "other",
    }
}

fn classify_bool(value: bool) -> string {
    match value {
        values::ENABLED => "enabled",
        false => "disabled",
    }
}

fn exported_answer() -> isize {
    values::ANSWER
}

fn imported_name_binding(value: isize) -> isize {
    match value {
        helper => helper,
    }
}

fn main() -> () {
    println(classify(42));
    println(classify(7));
    println(classify(0));
    println(classify_bool(true));
    println(classify_bool(false));
    println(exported_answer());
    println(imported_name_binding(5));
    println(helper())
}
