package main;

use project011_complex_dependency_graph::collection_checks;
use project011_complex_dependency_graph::math;
use project011_complex_dependency_graph::pipeline;
use project011_complex_dependency_graph::text_checks;

fn main() {
    if collection_checks::verify() && text_checks::verify() {
        println(pipeline::run(4));
        println(math::square_plus_seed(3).to_string());
    } else {
        println("collection checks failed");
    }
}
