package collection_checks;

use std::collections;

pub struct CollisionKey {
    value: i32,
}

impl PartialEq for CollisionKey {
    fn eq(self: CollisionKey, other: CollisionKey) -> bool {
        self.value == other.value
    }
}

impl Eq for CollisionKey {}

impl Hash for CollisionKey {
    fn hash(self: CollisionKey) -> u64 {
        1
    }
}

fn check(ok: Ref[bool], condition: bool) -> () {
    if condition {} else {
        ok.set(false)
    }
}

fn verify_hash_set() -> bool {
    let ok = Ref::new(true);
    let set: collections::HashSet[CollisionKey] = collections::HashSet::new();
    check(ok, set.is_empty());
    check(ok, set.insert(CollisionKey { value: 7 }));
    check(ok, !set.insert(CollisionKey { value: 7 }));
    check(ok, set.len() == 1);
    let index = Ref::new(0);
    while index.get() < 256 {
        check(ok, set.insert(CollisionKey { value: index.get() + 100 }));
        index.set(index.get() + 1);
    }
    check(ok, set.len() == 257);
    check(ok, set.contains(CollisionKey { value: 7 }));
    check(ok, set.contains(CollisionKey { value: 227 }));
    check(ok, set.remove(CollisionKey { value: 7 }));
    check(ok, !set.remove(CollisionKey { value: 7 }));
    check(ok, !set.contains(CollisionKey { value: 7 }));
    check(ok, set.len() == 256);
    ok.get()
}

fn verify_arena() -> bool {
    let ok = Ref::new(true);
    let arena: collections::Arena[string] = collections::Arena::new();
    check(ok, arena.is_empty());
    let first = arena.alloc("root");
    let index = Ref::new(0);
    while index.get() < 512 {
        arena.alloc("node-" + index.get().to_string());
        index.set(index.get() + 1);
    }
    check(ok, first.index() == 0);
    check(ok, arena.len() == 513);
    check(ok, arena.get(first) == "root");
    arena.set(first, "updated");
    check(ok, arena.get(first) == "updated");
    check(ok, arena.contains_id(first));
    match arena.try_get(first) {
        Option::Some(value) => check(ok, value == "updated"),
        Option::None => check(ok, false),
    };
    let ids: HashMap[collections::ArenaId[string], string] = HashMap::new();
    ids.set(first, "stable");
    match ids.get(first) {
        Option::Some(value) => check(ok, value == "stable"),
        Option::None => check(ok, false),
    };
    ok.get()
}

fn verify_interner() -> bool {
    let ok = Ref::new(true);
    let interner = collections::Interner::new();
    check(ok, interner.is_empty());
    let unicode = "λ变量🙂";
    let first = interner.intern(unicode);
    let duplicate = interner.intern(unicode);
    check(ok, first == duplicate);
    check(ok, first.index() == 0);
    check(ok, interner.len() == 1);
    check(ok, interner.contains(unicode));
    let index = Ref::new(0);
    while index.get() < 512 {
        interner.intern("名字-" + index.get().to_string());
        index.set(index.get() + 1);
    }
    check(ok, interner.len() == 513);
    check(ok, interner.get(first) == unicode);
    check(ok, interner.intern(unicode) == first);
    match interner.resolve(first) {
        Option::Some(value) => check(ok, value == unicode),
        Option::None => check(ok, false),
    };
    let symbols: HashMap[collections::Symbol, string] = HashMap::new();
    symbols.set(first, "unicode");
    match symbols.get(duplicate) {
        Option::Some(value) => check(ok, value == "unicode"),
        Option::None => check(ok, false),
    };
    ok.get()
}

fn verify_deque() -> bool {
    let ok = Ref::new(true);
    let deque: collections::Deque[i32] = collections::Deque::with_capacity(3);
    deque.push_back(1);
    deque.push_back(2);
    deque.push_back(3);
    match deque.pop_front() {
        Option::Some(value) => check(ok, value == 1),
        Option::None => check(ok, false),
    };
    deque.push_back(4);
    deque.push_front(0);
    check(ok, deque.len() == 4);
    check(ok, deque.capacity() >= 4);
    match deque.get(0) {
        Option::Some(value) => check(ok, value == 0),
        Option::None => check(ok, false),
    };
    match deque.get(1) {
        Option::Some(value) => check(ok, value == 2),
        Option::None => check(ok, false),
    };
    match deque.back() {
        Option::Some(value) => check(ok, value == 4),
        Option::None => check(ok, false),
    };
    match deque.pop_back() {
        Option::Some(value) => check(ok, value == 4),
        Option::None => check(ok, false),
    };
    deque.clear();
    check(ok, deque.is_empty());
    match deque.pop_front() {
        Option::Some(_) => check(ok, false),
        Option::None => (),
    };
    ok.get()
}

fn verify_bit_set() -> bool {
    let ok = Ref::new(true);
    let set = collections::BitSet::new();
    check(ok, set.insert(0));
    check(ok, set.insert(63));
    check(ok, set.insert(64));
    check(ok, set.insert(65));
    check(ok, set.insert(130));
    check(ok, !set.insert(64));
    check(ok, set.len() == 5);
    check(ok, set.contains(0));
    check(ok, set.contains(63));
    check(ok, set.contains(64));
    check(ok, set.contains(65));
    check(ok, set.contains(130));
    check(ok, !set.contains(129));
    check(ok, set.remove(64));
    check(ok, !set.remove(64));
    check(ok, !set.contains(64));
    check(ok, set.contains(63));
    check(ok, set.contains(65));
    set.clear();
    check(ok, set.is_empty());
    ok.get()
}

fn verify_index_vec_and_stack() -> bool {
    let ok = Ref::new(true);
    let values: collections::IndexVec[string] = collections::IndexVec::with_capacity(1);
    let root = values.push("root");
    let index = Ref::new(0);
    while index.get() < 512 {
        values.push("item-" + index.get().to_string());
        index.set(index.get() + 1);
    }
    check(ok, root.value() == 0);
    check(ok, values.get(root) == "root");
    values.set(root, "updated");
    check(ok, values.get(root) == "updated");
    let stack: collections::Stack[i32] = collections::Stack::new();
    stack.push(1);
    stack.push(2);
    match stack.peek() {
        Option::Some(value) => check(ok, value == 2),
        Option::None => check(ok, false),
    };
    match stack.pop() {
        Option::Some(value) => check(ok, value == 2),
        Option::None => check(ok, false),
    };
    match stack.pop() {
        Option::Some(value) => check(ok, value == 1),
        Option::None => check(ok, false),
    };
    check(ok, stack.is_empty());
    ok.get()
}

pub fn verify() -> bool {
    verify_hash_set() && verify_arena() && verify_interner() && verify_deque() && verify_bit_set()
        && verify_index_vec_and_stack()
}
