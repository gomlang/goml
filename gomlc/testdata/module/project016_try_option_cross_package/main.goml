package main;

use project016_try_option_cross_package::util;

fn compute(flag: bool) -> Option[i32] {
    let value = util::maybe_num(flag)?;
    Option::Some(value + 1)
}

fn show(opt: Option[i32]) -> string {
    match opt {
        Option::Some(value) => "some=" + value.to_string(),
        Option::None => "none",
    }
}

fn main() -> () {
    println(show(compute(true)));
    println(show(compute(false)));
}
