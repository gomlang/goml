package main;

use std::os::linux::memory;
use std::os::linux::syscall;
use std::task;
use std::testing;

fn check_concurrency() -> () {
    let mapping = testing::expect_ok(
        memory::anonymous(
            memory::PAGE_SIZE,
            memory::PROT_READ | memory::PROT_WRITE,
            memory::MAP_PRIVATE,
        ),
        "concurrent mapping",
    );
    defer testing::expect_ok(mapping.close(), "cleanup concurrent mapping");
    task::scope(
        |scope: task::Scope| {
            let ready: Channel[()] = Channel::new(4);
            let workers: Vec[task::Task[()]] = Vec::new();
            for _ in 0..4 {
                workers.push(
                    scope.spawn(
                        |_| {
                            let output = bytes(16, 1);
                            testing::expect_ok(
                                mapping.write_all_at(output.as_slice(), 0),
                                "initial concurrent write",
                            );
                            ready.send(());
                            loop {
                                match mapping.read_at(output.as_mut_slice(), 0) {
                                    Ok(count) => testing::assert(count == 16),
                                    Err(error) => {
                                        testing::assert(
                                            error.raw_os_code()
                                                == Option::Some(syscall::EBADF.to_isize()),
                                        );
                                        break;
                                    },
                                }
                            }
                        },
                    ),
                );
            }
            for _ in 0..4 {
                let _ = ready.recv();
            }
            let first = scope.spawn(
                |_| testing::expect_ok(mapping.close(), "first concurrent unmap"),
            );
            let second = scope.spawn(
                |_| testing::expect_ok(mapping.close(), "second concurrent unmap"),
            );
            first.join();
            second.join();
            for worker in workers {
                worker.join();
            }
        },
    );
    testing::assert(mapping.is_closed());
}
