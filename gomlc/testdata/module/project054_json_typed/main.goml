package main;

use std::json;
use std::serde;
use std::toml;
use json::{Deserialize, Serialize};

#[derive(Serialize, Deserialize)]
struct User {
    #[serde(rename = "display_name")]
    name: string,
    age: u8,
}

#[derive(Serialize, Deserialize)]
struct Empty {}

#[derive(Serialize, Deserialize)]
enum Event {
    Idle,
    Login(string, u32),
    State { active: bool },
}

struct RawBytes {
    values: Vec[byte],
}

impl Deserialize for RawBytes {
    fn deserialize[D: serde::Deserializer](deserializer: D) -> Result[RawBytes, string] {
        Result::Ok(RawBytes { values: deserializer.deserialize_bytes()? })
    }
}

fn decode_user(input: string) -> Result[User, string] {
    json::from_string(input)
}

fn decode_event(input: string) -> Result[Event, string] {
    json::from_string(input)
}

fn main() -> () {
    let parsed = match json::parse("{\"items\":[1,true,null]}") {
        Ok(value) => value,
        Err(error) => {
            println(error);
            json::Value::Null
        },
    };
    println(json::encode(parsed));
    let encoded = json::try_to_string(User { name: "goml", age: 13 }).unwrap_or("");
    println(encoded);
    let user = match decode_user(encoded) {
        Ok(value) => value,
        Err(error) => {
            println(error);
            User { name: "error", age: 0 }
        },
    };
    println(user.name + user.age.to_string());
    let event_text = json::try_to_string(Event::Login("li", 15)).unwrap_or("");
    println(event_text);
    match decode_event(event_text) {
        Ok(Login(name, id)) => println(name + id.to_string()),
        Ok(_) => println("wrong event"),
        Err(error) => println(error),
    };
    match decode_user(
        "{\"ignored\":{\"nested\":[1,{\"ok\":true}]},\"age\":9,\"display_name\":\"order\"}",
    ) {
        Ok(value) => println(value.name + value.age.to_string()),
        Err(error) => println(error),
    };
    match decode_user("{\"display_name\":\"first\",\"display_name\":\"second\",\"age\":1}") {
        Ok(_) => println("wrong duplicate"),
        Err(error) => println(error),
    };
    match decode_user("{\"display_name\":\"missing\"}") {
        Ok(_) => println("wrong missing"),
        Err(error) => println(error),
    };
    match decode_event("{\"State\":{\"active\":true}}") {
        Ok(State { active }) => println(active),
        Ok(_) => println("wrong state"),
        Err(error) => println(error),
    };
    match decode_event("{\"State\":{\"ignored\":{\"deep\":[1,null]},\"active\":false}}") {
        Ok(State { active }) => println(active),
        Ok(_) => println("wrong unknown state field"),
        Err(error) => println(error),
    };
    match decode_event("{\"State\":{\"active\":true,\"active\":false}}") {
        Ok(_) => println("wrong duplicate state field"),
        Err(error) => println(error),
    };
    match decode_event("{\"State\":{}}") {
        Ok(_) => println("wrong missing state field"),
        Err(error) => println(error),
    };
    match decode_event("\"Idle\"") {
        Ok(Idle) => println("idle"),
        Ok(_) => println("wrong idle"),
        Err(error) => println(error),
    };
    match decode_user("{\"display_name\":\"trail\",\"age\":2} true") {
        Ok(_) => println("wrong trailing"),
        Err(error) => println(error),
    };
    let dynamic: Result[json::Value, string] = json::from_string("{\"value\":[1,null]}");
    match dynamic {
        Ok(value) => println(json::encode(value)),
        Err(error) => println(error),
    };
    println(json::try_to_string(toml::Value::String("world-default")).unwrap_or(""));
    let dynamic_value: Result[toml::Value, string] = json::from_string("\"world-default\"");
    match dynamic_value {
        Ok(toml::Value::String(value)) => println(value),
        Ok(_) => println("wrong dynamic value"),
        Err(error) => println(error),
    };
    let bytes: Result[RawBytes, string] = json::from_string("[1,2,255]");
    match bytes {
        Ok(value) => println(value.values.len().to_string() + ":" + value.values[2].to_string()),
        Err(error) => println(error),
    };
    let empty_text = json::try_to_string(Empty {}).unwrap_or("");
    println(empty_text);
    let empty: Result[Empty, string] = json::from_string(empty_text);
    println(empty.is_ok())
}
