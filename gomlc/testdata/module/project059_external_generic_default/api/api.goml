package api;

pub trait Pick {
    fn number(self: Self) -> isize;
    fn pick[T](self: Self, value: T) -> T {
        value
    }
}

pub trait Source {
    fn read(self: Self) -> isize;
}

pub trait Decode {
    fn decode(value: isize) -> Result[Self, string];
    fn decode_from[S: Source](source: S) -> Result[Self, string] {
        Decode::decode(source.read())
    }
}
