package main;

use std::error;
use std::io;
use std::testing;
use error::ResultExt;
use error::ReportContext;

enum AppError {
    Io(io::Error),
}

fn some[T](value: Option[T]) -> T {
    testing::expect_some(value, "expected value")
}

fn map_preserves_shape_and_order() -> () {
    let single = some(error::Report::join(Vec::from_array([error::Report::new(2)]).as_slice()));
    let shared = some(
        error::Report::join(Vec::from_array([error::Report::new(1).context(""), single]).as_slice()),
    );
    let source = some(
        error::Report::join(
            Vec::from_array([shared.context("left"), shared.context("右")]).as_slice(),
        ),
    ).context("batch");
    let visits: Vec[isize] = Vec::new();
    let mapped = source.map(
        |value: isize| {
            visits.push(value);
            f"error {value}"
        },
    );
    testing::assert(visits == Vec::from_array([1, 2, 1, 2]));
    testing::assert(mapped.message() == Option::Some("batch"));
    let group = mapped.causes()[0];
    testing::assert(group.value().is_none());
    testing::assert(group.message().is_none());
    testing::assert_eq(group.causes().len(), 2);
    let left = group.causes()[0];
    let right = group.causes()[1];
    testing::assert(left.message() == Option::Some("left"));
    testing::assert(right.message() == Option::Some("右"));
    let children = left.causes()[0].causes();
    testing::assert(children[0].message() == Option::Some(""));
    testing::assert(children[0].causes()[0].value() == Option::Some("error 1"));
    testing::assert(children[1].value().is_none());
    testing::assert_eq(children[1].causes().len(), 1);
    testing::assert(children[1].causes()[0].value() == Option::Some("error 2"));
    children[0] = error::Report::new("replacement");
    testing::assert_eq(mapped.to_string(), "batch: left: : error 1\nerror 2\n右: : error 1\nerror 2");
    testing::assert_eq(source.to_string(), "batch: left: : 1\n2\n右: : 1\n2");
    let deep = Ref::new(error::Report::new(7));
    for _ in 0..10000 {
        deep.set(deep.get().context("level"))
    }
    let mut converted = deep.get().map(|value: isize| value.to_string());
    for _ in 0..10000 {
        testing::assert(converted.message() == Option::Some("level"));
        converted = converted.causes()[0];
    }
    testing::assert(converted.value() == Option::Some("7"));
}

fn contexts_are_lazy_and_preserve_report_types() -> () {
    let calls = Ref::new(0);
    let message = || {
        calls.set(calls.get() + 1);
        "load"
    };
    let success: Result[isize, string] = Result::Ok(42);
    let success = success.into_report().with_context(message).context("outer").with_context(message);
    testing::assert_eq(testing::expect_ok(success, "expected success"), 42);
    testing::assert_eq(calls.get(), 0);
    let failure: Result[isize, string] = Result::Err("missing");
    let failure = failure.into_report().with_context(message).context("outer").with_context(message);
    let report: error::Report[string] = testing::expect_err(failure, "expected failure");
    testing::assert_eq(calls.get(), 2);
    testing::assert_eq(report.to_string(), "load: outer: load: missing");
    testing::assert(report.contains("missing"));
    let raw: Result[(), string] = Result::Err("leaf");
    let leaf = testing::expect_err(raw.into_report(), "expected leaf");
    testing::assert(leaf.value() == Option::Some("leaf"));
    testing::assert(leaf.causes().is_empty());
    let existing = some(error::Report::join(Vec::from_array([leaf, leaf]).as_slice()));
    let result: Result[(), error::Report[string]] = Result::Err(existing);
    let report: error::Report[string] = testing::expect_err(
        result.with_context(message),
        "expected aggregate",
    );
    testing::assert_eq(calls.get(), 3);
    testing::assert_eq(report.causes()[0].causes().len(), 2);
    testing::assert_eq(report.to_string(), "load: leaf\nleaf");
}

fn propagate(value: Result[isize, io::Error], calls: Ref[isize]) -> Result[
    isize,
    error::Report[AppError],
] {
    let value = value.into_report().with_context(
        || {
            calls.set(calls.get() + 1);
            "read configuration"
        },
    ).map_err(|report: error::Report[io::Error]| report.map(|cause: io::Error| AppError::Io(cause))).context(
        "application",
    )?;
    Result::Ok(value + 1)
}

fn propagation_preserves_structured_io_errors() -> () {
    let calls = Ref::new(0);
    testing::assert_eq(testing::expect_ok(propagate(Result::Ok(8), calls), "expected success"), 9);
    testing::assert_eq(calls.get(), 0);
    let cause = io::Error::new(
        io::ErrorKind::NotFound,
        "read",
        Option::Some("config"),
        Option::Some(2),
        "missing",
    );
    let report = testing::expect_err(propagate(Result::Err(cause), calls), "expected I/O failure");
    testing::assert_eq(calls.get(), 1);
    let found = some(
        report.find_map(
            |value: AppError| match value {
                Io(cause) => Option::Some(cause),
            },
        ),
    );
    testing::assert(found.kind() == io::ErrorKind::NotFound);
    testing::assert(found.raw_os_code() == Option::Some(2));
    testing::assert_eq(found.operation(), "read");
    testing::assert(found.context() == Option::Some("config"));
    testing::assert(report.message() == Option::Some("application"));
    testing::assert(report.causes()[0].message() == Option::Some("read configuration"));
}

fn main() -> () {
    map_preserves_shape_and_order();
    contexts_are_lazy_and_preserve_report_types();
    propagation_preserves_structured_io_errors();
    println("error report composition ok")
}
