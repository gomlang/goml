package main;

use module::api;
use module::order_ab;
use module::order_ba;
use std::ffi;

fn main() -> () {
    println(order_ab::count());
    println(order_ba::count());
    let opaque = ffi::map_new();
    ffi::map_set(opaque, api::opaque_scalar(), 11);
    println(ffi::map_len(opaque));
    let scalar = ffi::map_new::[Option[api::Payload[i32]], i32]();
    ffi::map_set(scalar, api::empty::[i32](), 7);
    println(ffi::map_len(scalar));
    let wide = ffi::map_new::[Option[api::Payload[[Slice[i32]; 3]]], i32]();
    ffi::map_set(wide, api::empty::[[Slice[i32]; 3]](), 8);
    println(ffi::map_len(wide));
    let user = ffi::map_new::[api::Key[Slice[i32]], i32]();
    ffi::map_set(user, api::Key::Empty, 9);
    println(ffi::map_len(user));
    let recursive = ffi::map_new::[api::Recursive, i32]();
    ffi::map_set(recursive, api::Recursive::Empty, 10);
    println(ffi::map_len(recursive));
}
