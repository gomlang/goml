package order_ab;

use std::ffi;

enum A {
    End,
    More(B, [i64; 7]),
}

enum B {
    End,
    More(A, [i64; 6]),
}

enum C {
    End,
    More(B, ffi::Func[() -> ()]),
}

pub fn count() -> isize {
    let map = ffi::map_new::[C, i32]();
    ffi::map_set(map, C::End, 7);
    ffi::map_len(map)
}
