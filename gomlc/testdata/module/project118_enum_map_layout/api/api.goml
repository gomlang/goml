package api;

struct Hidden[T] {
    value: T,
}

pub struct Payload[T] {
    hidden: Hidden[T],
}

pub enum Key[T] {
    Empty,
    Data(Payload[T]),
}

pub enum Recursive {
    Empty,
    Next(Recursive, Slice[i32]),
}

pub fn empty[T]() -> Option[Payload[T]] {
    None
}

pub trait Marker {}

impl Marker for i32 {}

pub fn opaque_scalar() -> impl Marker {
    let value: i32 = 11;
    value
}
