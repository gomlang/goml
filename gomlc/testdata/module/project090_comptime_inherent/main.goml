package main;

use module::macros;
use module::model;
use std::testing;

const EXTREMES: string = macros::extremes();

fn main() -> () {
    testing::assert_eq(EXTREMES, "-9223372036854775808:18446744073709551615");
    testing::assert_eq(
        comptime {
            (-128.to_i8()).to_string()
        },
        "-128",
    );
    testing::assert_eq(
        comptime {
            255.to_u8().to_string()
        },
        "255",
    );
    testing::assert_eq(
        comptime {
            (-32768.to_i16()).to_string()
        },
        "-32768",
    );
    testing::assert_eq(
        comptime {
            65535.to_u16().to_string()
        },
        "65535",
    );
    testing::assert_eq(
        comptime {
            (-2147483648.to_i32()).to_string()
        },
        "-2147483648",
    );
    testing::assert_eq(
        comptime {
            4294967295.to_u32().to_string()
        },
        "4294967295",
    );
    testing::assert_eq(
        comptime {
            0.to_usize().to_string()
        },
        "0",
    );
    println(model::Record { value: 1 }.describe());
    println(model::Record::[string]::type_name());
    testing::assert_eq(model::Record::[isize]::type_name(), "Record");
    println(EXTREMES);
}
