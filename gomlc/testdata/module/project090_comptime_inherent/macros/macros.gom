package macros;

#[comptime_derive(Descriptor)]
pub fn descriptor(input: DeriveInput) -> DeriveOutput {
    let output = derive_output_inherent(input);
    let params = meta_param_list_new();
    meta_param_list_push(params, "self", derive_target_type(input));
    let method = meta_method(
        "describe",
        params,
        meta_type_call_site("string"),
        meta_expr_string(derive_item_name(input) + ":" + derive_field_count(input).to_string()),
    );
    derive_output_add_public_method(output, method);
    derive_output_add_public_method(
        output,
        meta_method(
            "type_name",
            meta_param_list_new(),
            meta_type_call_site("string"),
            meta_expr_string(derive_item_name(input)),
        ),
    );
    output
}

#[comptime]
pub fn extremes() -> string {
    let minimum: i64 = -9223372036854775808;
    let maximum: u64 = 18446744073709551615;
    minimum.to_string() + ":" + maximum.to_string()
}
