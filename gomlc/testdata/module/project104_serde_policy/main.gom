package main;

use std::serde;
use serde::{Deserialize, Serialize};
use std::json;
use std::toml;
use std::bincode;
use std::testing;

fn fallback_name() -> string {
    "anonymous"
}

fn empty(value: string) -> bool {
    value == ""
}

#[derive(Serialize, Deserialize)]
struct Settings {
    #[serde(rename = "display", default = fallback_name)]
    name: string,
    #[serde(default)]
    count: isize,
    #[serde(default, skip_serializing_if = "empty")]
    note: string,
    #[serde(skip)]
    cache: isize,
    #[serde(default)]
    optional: Option[string],
}

#[derive(Serialize, Deserialize)]
struct Hidden[T] {
    id: isize,
    #[serde(skip)]
    state: T,
}

#[derive(Default)]
struct State {
    count: isize,
}

#[derive(Serialize, Deserialize)]
struct BinaryFields {
    before: i32,
    #[serde(skip)]
    ignored: string,
    after: i32,
}

#[derive(Serialize, Deserialize)]
enum External {
    Named {
        #[serde(default = "fallback_name")]
        name: string,
        #[serde(skip)]
        cache: isize,
        #[serde(default, skip_serializing_if = empty)]
        note: string,
    },
    Tuple(i32, i32),
}

#[derive(Serialize, Deserialize)]
struct Profile {
    user: string,
    #[serde(default)]
    active: bool,
}

#[derive(Serialize, Deserialize)]
struct Extra {
    #[serde(default)]
    count: isize,
}

#[derive(Serialize, Deserialize)]
struct Flat {
    id: isize,
    #[serde(flatten)]
    profile: Profile,
    #[serde(flatten)]
    extra: Extra,
    #[serde(flatten)]
    attributes: HashMap[string, string],
}

#[derive(Serialize, Deserialize)]
enum FlatExternal {
    Named {
        id: isize,
        #[serde(flatten)]
        profile: Profile,
    },
}

#[derive(Serialize, Deserialize)]
#[serde(tag = "kind")]
enum Internal {
    Empty,
    #[serde(rename = "record")]
    Named {
        id: isize,
        #[serde(default = fallback_name)]
        name: string,
        #[serde(skip)]
        cache: isize,
    },
    Profile(Profile),
    Flattened {
        id: isize,
        #[serde(flatten)]
        profile: Profile,
    },
}

#[derive(Serialize, Deserialize)]
#[serde(tag = "type", content = "data")]
enum Adjacent[T] {
    Empty,
    Value(T),
    Pair(isize, string),
    Named {
        #[serde(default)]
        flag: bool,
    },
}

#[derive(Serialize, Deserialize)]
#[serde(untagged)]
enum Untagged {
    Integer(isize),
    Text(string),
    Pair(isize, bool),
    Named { user: string },
    Empty,
}

fn test_field_policies() -> () {
    let settings: Settings = testing::expect_ok(json::from_string("{}"), "defaults");
    testing::assert_eq(settings.name, "anonymous");
    testing::assert_eq(settings.count, 0);
    testing::assert_eq(settings.note, "");
    testing::assert_eq(settings.cache, 0);
    testing::assert(settings.optional.is_none());
    testing::assert_eq(testing::expect_ok(json::try_to_string(settings), "encode defaults"), "{\"display\":\"anonymous\",\"count\":0,\"optional\":null}");
    let supplied: Settings = testing::expect_ok(json::from_string("{\"display\":\"Ada\",\"count\":4,\"note\":\"hi\",\"cache\":\"ignored\",\"optional\":\"yes\"}"), "explicit values");
    testing::assert_eq(supplied.name, "Ada");
    testing::assert_eq(supplied.note, "hi");
    testing::assert_eq(supplied.cache, 0);
    let duplicate: Result[Settings, string] = json::from_string("{\"count\":1,\"count\":2}");
    testing::assert(duplicate.is_err());
    let malformed: Result[Settings, string] = json::from_string("{\"count\":\"bad\"}");
    testing::assert(malformed.is_err());
    let hidden = Hidden { id: 7, state: State { count: 9 } };
    testing::assert_eq(testing::expect_ok(json::try_to_string(hidden), "generic skip serialization"), "{\"id\":7}");
    let hidden_decoded: Hidden[State] = testing::expect_ok(json::from_string("{\"id\":8}"), "generic default bound");
    testing::assert_eq(hidden_decoded.state.count, 0);
    let external: External = testing::expect_ok(json::from_string("{\"Named\":{}}"), "variant defaults");
    testing::assert_eq(testing::expect_ok(json::try_to_string(external), "variant omission"), "{\"Named\":{\"name\":\"anonymous\"}}");
    let dynamic: External = testing::expect_ok(serde::from_value(testing::expect_ok(serde::to_value(external), "variant value")), "variant value defaults");
    testing::assert_eq(testing::expect_ok(json::try_to_string(dynamic), "variant value encode"), "{\"Named\":{\"name\":\"anonymous\"}}");
    let binary = BinaryFields { before: 1, ignored: "cache", after: 2 };
    let encoded = testing::expect_ok(bincode::encode_to_vec(binary, bincode::standard()), "binary skipped field");
    let decoded: (BinaryFields, isize) = testing::expect_ok(bincode::decode_from_slice(encoded.as_slice(), bincode::standard()), "binary contiguous indexes");
    testing::assert_eq(decoded.0.before, 1);
    testing::assert_eq(decoded.0.after, 2);
    testing::assert_eq(decoded.0.ignored, "");
    testing::assert(bincode::encode_to_vec(settings, bincode::standard()).is_err());
}

fn test_flatten() -> () {
    let flat: Flat = testing::expect_ok(json::from_string("{\"id\":3,\"user\":\"Ada\",\"count\":5,\"color\":\"blue\"}"), "flatten decode");
    testing::assert_eq(flat.profile.user, "Ada");
    testing::assert(!flat.profile.active);
    testing::assert_eq(flat.extra.count, 5);
    testing::assert_eq(flat.attributes.len(), 1);
    testing::assert_eq(flat.attributes.get("color").unwrap_or(""), "blue");
    let output = testing::expect_ok(json::try_to_string(flat), "flatten encode");
    testing::assert_eq(output, "{\"id\":3,\"user\":\"Ada\",\"active\":false,\"count\":5,\"color\":\"blue\"}");
    let value = testing::expect_ok(serde::to_value(flat), "flatten value");
    let roundtrip: Flat = testing::expect_ok(serde::from_value(value), "flatten from value");
    testing::assert_eq(roundtrip.attributes.len(), 1);
    let duplicate: Result[Flat, string] = json::from_string("{\"id\":1,\"user\":\"a\",\"user\":\"b\"}");
    testing::assert(duplicate.is_err());
    let _ = flat.attributes.insert("id", "collision");
    testing::assert(json::try_to_string(flat).is_err());
    let variant: FlatExternal = testing::expect_ok(json::from_string("{\"Named\":{\"user\":\"Ada\",\"id\":4}}"), "flatten enum");
    testing::assert_eq(testing::expect_ok(json::try_to_string(variant), "flatten enum encode"), "{\"Named\":{\"id\":4,\"user\":\"Ada\",\"active\":false}}");
    let variant_value = testing::expect_ok(serde::to_value(variant), "flatten variant value");
    let decoded_variant: FlatExternal = testing::expect_ok(serde::from_value(variant_value), "flatten variant from value");
    testing::assert_eq(testing::expect_ok(json::try_to_string(decoded_variant), "flatten variant reencode"), "{\"Named\":{\"id\":4,\"user\":\"Ada\",\"active\":false}}");
    testing::assert(bincode::encode_to_vec(roundtrip, bincode::standard()).is_err());
    let from_toml: Flat = testing::expect_ok(toml::from_string("id = 2\nuser = \"Bob\"\ncolor = \"red\"\n"), "toml flatten");
    testing::assert_eq(from_toml.profile.user, "Bob");
    let toml_encoded = testing::expect_ok(toml::to_string(from_toml), "toml flatten encode");
    let toml_decoded: Flat = testing::expect_ok(toml::from_string(toml_encoded), "toml flatten roundtrip");
    testing::assert_eq(toml_decoded.attributes.get("color").unwrap_or(""), "red");
}

fn test_tags() -> () {
    let internal: Internal = testing::expect_ok(json::from_string("{\"id\":7,\"kind\":\"record\"}"), "internal tag order");
    testing::assert_eq(testing::expect_ok(json::try_to_string(internal), "internal tag encode"), "{\"kind\":\"record\",\"id\":7,\"name\":\"anonymous\"}");
    let profile: Internal = testing::expect_ok(json::from_string("{\"kind\":\"Profile\",\"user\":\"Ada\"}"), "internal newtype");
    testing::assert_eq(testing::expect_ok(json::try_to_string(profile), "internal newtype encode"), "{\"kind\":\"Profile\",\"user\":\"Ada\",\"active\":false}");
    let flattened: Internal = testing::expect_ok(json::from_string("{\"kind\":\"Flattened\",\"id\":5,\"user\":\"Ada\"}"), "internal flattened");
    testing::assert_eq(testing::expect_ok(json::try_to_string(flattened), "internal flattened encode"), "{\"kind\":\"Flattened\",\"id\":5,\"user\":\"Ada\",\"active\":false}");
    let empty: Internal = testing::expect_ok(json::from_string("{\"kind\":\"Empty\"}"), "internal unit");
    testing::assert_eq(testing::expect_ok(json::try_to_string(empty), "internal unit encode"), "{\"kind\":\"Empty\"}");
    for source in["{}", "{\"kind\":4}", "{\"kind\":\"unknown\"}", "{\"kind\":\"Empty\",\"kind\":\"Empty\"}"] {
        let invalid: Result[Internal, string] = json::from_string(source);
        testing::assert(invalid.is_err());
    }
    for source in["{\"type\":\"Empty\"}", "{\"type\":\"Value\",\"data\":8}", "{\"type\":\"Pair\",\"data\":[3,\"ok\"]}", "{\"type\":\"Named\",\"data\":{\"flag\":false}}"] {
        let adjacent: Adjacent[isize] = testing::expect_ok(json::from_string(source), "adjacent decode");
        testing::assert_eq(testing::expect_ok(json::try_to_string(adjacent), "adjacent encode"), source);
    }
    let missing: Result[Adjacent[isize], string] = json::from_string("{\"type\":\"Value\"}");
    testing::assert(missing.is_err());
    let unknown: Result[Adjacent[isize], string] = json::from_string("{\"type\":\"Pair\",\"data\":[1]}");
    testing::assert(unknown.is_err());
    for source in["42", "\"hello\"", "[3,true]", "{\"user\":\"Ada\"}", "null"] {
        let untagged: Untagged = testing::expect_ok(json::from_string(source), "untagged decode");
        testing::assert_eq(testing::expect_ok(json::try_to_string(untagged), "untagged encode"), source);
    }
    let invalid: Result[Untagged, string] = json::from_string("false");
    testing::assert(invalid.is_err());
    let internal_value = testing::expect_ok(serde::to_value(internal), "tagged value");
    let internal_again: Internal = testing::expect_ok(serde::from_value(internal_value), "tagged from value");
    testing::assert_eq(testing::expect_ok(json::try_to_string(internal_again), "tagged value encode"), "{\"kind\":\"record\",\"id\":7,\"name\":\"anonymous\"}");
    testing::assert(bincode::encode_to_vec(internal, bincode::standard()).is_err());
}

fn main() -> () {
    test_field_policies();
    test_flatten();
    test_tags();
    test_policy_edges();
    test_nested_flatten();
    println("serde policies ok");
}
