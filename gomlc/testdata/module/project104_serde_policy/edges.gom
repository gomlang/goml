package main;

use std::serde;
use serde::{Deserialize, Serialize};
use std::json;
use std::testing;

#[derive(Serialize, Deserialize)]
struct PolicyDirections {
    #[serde(skip_serializing, default)]
    input: string,
    #[serde(skip_deserializing, default = fallback_name)]
    output: string,
    #[serde(default, skip_serializing_if = "Option::is_none")]
    optional: Option[isize],
}

#[derive(Serialize, Deserialize)]
struct EmptyWireName {
    #[serde(rename = "")]
    field: isize,
}

#[derive(Serialize, Deserialize)]
#[serde(tag = "kind", content = "data")]
enum GenericDefault[T] {
    Named {
        #[serde(default)]
        value: T,
    },
}

#[derive(Serialize, Deserialize)]
#[serde(tag = "kind")]
enum TagCollision {
    Named {
        #[serde(flatten)]
        fields: HashMap[string, string],
    },
}

fn test_policy_edges() -> () {
    let value: PolicyDirections = testing::expect_ok(json::from_string("{\"input\":\"secret\",\"output\":false}"), "directional policies");
    testing::assert_eq(value.input, "secret");
    testing::assert_eq(value.output, "anonymous");
    testing::assert_eq(testing::expect_ok(json::try_to_string(value), "directional serialization"), "{\"output\":\"anonymous\"}");
    let named: EmptyWireName = testing::expect_ok(json::from_string("{\"\":3}"), "empty rename");
    testing::assert_eq(testing::expect_ok(json::try_to_string(named), "empty rename encode"), "{\"\":3}");
    let generic: GenericDefault[isize] = testing::expect_ok(json::from_string("{\"kind\":\"Named\",\"data\":{}}"), "tagged generic default");
    testing::assert_eq(testing::expect_ok(json::try_to_string(generic), "tagged generic encode"), "{\"kind\":\"Named\",\"data\":{\"value\":0}}");
    let fields = HashMap::new();
    let _ = fields.insert("kind", "collision");
    testing::assert(json::try_to_string(TagCollision::Named { fields }).is_err());
    let map: HashMap[string, isize] = testing::expect_ok(json::from_string("{\"answer\":42}"), "map direct decode");
    testing::assert_eq(testing::expect_ok(json::try_to_string(map), "map direct encode"), "{\"answer\":42}");
    let duplicate: Result[HashMap[string, isize], string] = json::from_string("{\"x\":1,\"x\":2}");
    testing::assert(duplicate.is_err());
}

#[derive(Serialize, Deserialize)]
struct NestedFlatten {
    #[serde(flatten)]
    profile: Profile,
    #[serde(flatten)]
    extra: Extra,
}

#[derive(Serialize, Deserialize)]
struct NestedCatchAll {
    #[serde(flatten)]
    value: NestedFlatten,
    #[serde(flatten)]
    attributes: HashMap[string, string],
}

fn test_nested_flatten() -> () {
    let value: NestedCatchAll = testing::expect_ok(json::from_string("{\"user\":\"Ada\",\"count\":3,\"color\":\"blue\"}"), "nested flatten");
    testing::assert_eq(value.value.profile.user, "Ada");
    testing::assert_eq(value.value.extra.count, 3);
    testing::assert_eq(value.attributes.len(), 1);
    testing::assert_eq(value.attributes.get("color").unwrap_or(""), "blue");
}
