package helpers;

use module::api;
use api::Render;

pub fn show[T: Render](value: T) -> string {
    value.render()
}

pub fn forwarded[T](value: T) -> string where T: Render {
    show(value)
}

pub struct Wrapper[T] {
    pub value: T,
}

impl[T: Render] Wrapper[T] {
    pub fn render(self: Wrapper[T]) -> string {
        show(self.value)
    }
}
