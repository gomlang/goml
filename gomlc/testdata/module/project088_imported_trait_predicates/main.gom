package main;

use module::api;
use api::Render;
use module::helpers;

fn show[T: Render](value: T) -> string {
    value.render()
}

fn main() -> () {
    println(show(api::Value { text: "imported" }));
    println(helpers::forwarded(api::Value { text: "forwarded" }));
    println(helpers::Wrapper { value: api::Value { text: "inherent" } }.render());
    println(renamed());
}
