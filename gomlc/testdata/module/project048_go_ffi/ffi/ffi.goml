package ffi;

#[go_ffi("example.com/gomlffi/goshim", "Decorate")]
pub extern fn decorate(value: string) -> (string, i32);

#[go_ffi("example.com/gomlffi/goshim", "ByteLength")]
pub extern fn byte_length(value: Slice[byte]) -> isize;

#[go_ffi("example.com/gomlffi/goshim", "Swap")]
pub extern fn swap(value: [i32; 2]) -> [i32; 2];

#[go_ffi("example.com/gomlffi/goshim", "Send")]
pub extern fn send(channel: Channel[string], value: string) -> ();
