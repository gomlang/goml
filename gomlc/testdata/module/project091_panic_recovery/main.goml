package main;

use std::panic;
use std::task;
use std::testing;

fn failure() -> isize {
    panic::raise("original panic")
}

fn rethrow(info: panic::Panic) -> () {
    panic::resume(info)
}

fn error_exit(events: Vec[isize]) -> Result[isize, string] {
    defer events.push(2);
    {
        defer events.push(1);
        let result: Result[(), string] = Result::Err("expected error");
        result?;
    };
    Result::Ok(3)
}

fn return_exit(events: Vec[isize]) -> isize {
    let mut value = 4;
    defer {
        value = 9;
        events.push(value);
    };
    return value;
}

fn main() -> () {
    testing::assert_eq(panic::catch(|| 42).unwrap_or(0), 42);
    let normal: Result[isize, string] = Result::Err("ordinary error");
    testing::assert(panic::catch(|| normal).unwrap_or(Result::Ok(0)) == normal);
    for should_fail in Vec::from_array([false, true]) {
        let callback: () -> Result[(), string] = || {
            let result: Result[(), string] = if should_fail {
                Result::Err("early error")
            } else {
                Result::Ok(())
            };
            result?;
            panic::raise("after question mark")
        };
        let outcome = panic::catch(callback);
        if should_fail {
            testing::assert(outcome.unwrap_or(Result::Ok(())) == Result::Err("early error"));
        } else {
            testing::assert(outcome.is_err());
        }
    }
    let info = match panic::catch(failure) {
        Err(info) => info,
        Ok(_) => {
            testing::fail("missing panic");
            loop {}
        },
    };
    testing::assert_eq(info.message(), "original panic");
    testing::assert_eq(info.to_string(), info.message());
    testing::assert(info.stack_trace().byte_len() > 0);
    let resumed = panic::catch(|| rethrow(info));
    match resumed {
        Err(second) => {
            testing::assert_eq(second.message(), info.message());
            testing::assert_eq(second.stack_trace(), info.stack_trace());
        },
        Ok(_) => testing::fail("resume returned"),
    }
    let events: Vec[isize] = Vec::new();
    let caught: Result[(), panic::Panic] = panic::catch(
        || {
            defer events.push(1);
            {
                let mut value = 2;
                defer events.push(value);
                value = 3;
                defer events.push(4);
                let _ = failure();
            }
        },
    );
    testing::assert(caught.is_err());
    testing::assert(events == Vec::from_array([4, 3, 1]));
    events.clear();
    let cleanup_panic: Result[(), panic::Panic] = panic::catch(
        || {
            defer events.push(1);
            defer {
                events.push(2);
                panic::raise("cleanup panic");
            };
            defer events.push(3);
            panic::raise("body panic");
        },
    );
    testing::assert(events == Vec::from_array([3, 2, 1]));
    match cleanup_panic {
        Err(info) => testing::assert_eq(info.message(), "cleanup panic"),
        Ok(_) => testing::fail("missing cleanup panic"),
    }
    events.clear();
    let normal_cleanup: Result[(), panic::Panic] = panic::catch(
        || {
            defer events.push(1);
            defer {
                events.push(2);
                panic::raise("normal cleanup panic");
            };
        },
    );
    testing::assert(normal_cleanup.is_err());
    testing::assert(events == Vec::from_array([2, 1]));
    events.clear();
    let returned = return_exit(events);
    testing::assert_eq(returned, 4);
    testing::assert(events == Vec::from_array([9]));
    events.clear();
    testing::assert(error_exit(events).is_err());
    testing::assert(events == Vec::from_array([1, 2]));
    events.clear();
    for index in 0..10000 {
        defer events.push(index);
        if index % 2 == 0 {
            continue;
        }
    }
    testing::assert_eq(events.len(), 10000);
    testing::assert_eq(events[9999], 9999);
    events.clear();
    let loop_panic: Result[(), panic::Panic] = panic::catch(
        || {
            defer events.push(9);
            for index in 0..3 {
                defer events.push(index);
                if index == 1 {
                    panic::raise("loop panic");
                }
            }
        },
    );
    testing::assert(loop_panic.is_err());
    testing::assert(events == Vec::from_array([0, 1, 9]));
    events.clear();
    let bounds = panic::catch(|| events[5]);
    testing::assert(bounds.is_err());
    let original_scopes = task::active_scope_count();
    let scope_panic: Result[(), panic::Panic] = panic::catch(
        || {
            task::scope(
                |scope| {
                    let _ = scope.spawn(
                        |_| {
                            defer events.push(8);
                            panic::raise("child panic");
                        },
                    );
                },
            );
        },
    );
    testing::assert(scope_panic.is_err());
    testing::assert_eq(task::active_scope_count(), original_scopes);
    testing::assert(events == Vec::from_array([8]));
    println("panic recovery and lexical cleanup passed")
}
