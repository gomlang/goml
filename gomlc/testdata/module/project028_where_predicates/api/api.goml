package api;

pub trait Render {
    fn render(self: Self) -> string;
}

pub trait Selected {
    fn selected(self: Self) -> string;
}

pub struct Wrap[T] {
    value: T,
}

impl Render for Vec[i32] {
    fn render(self: Vec[i32]) -> string {
        "len=" + self.len().to_string()
    }
}

impl[T] Selected for Wrap[T] where Vec[T]: Render  {
    fn selected(self: Wrap[T]) -> string {
        "selected"
    }
}

pub fn render_vec[T](values: Vec[T]) -> string where Vec[T]: Render {
    values.render()
}

pub fn same[T, U](value: T) -> U where T = U {
    value
}

pub fn wrap[T](value: T) -> Wrap[T] {
    Wrap { value }
}

pub fn select[T: Selected](value: T) -> string {
    value.selected()
}
