package builders;

pub trait Feature {
    type Output;
    const CODE: isize;
    fn value(self: Self) -> Self::Output;
}

pub struct Helper {}

impl Helper {
    pub fn number() -> isize {
        42
    }
}

pub struct Generic[T] {}

impl[T] Generic[T] {
    pub fn identity[U](value: U) -> U {
        value
    }
}

#[comptime_derive(Feature)]
pub fn derive_feature(input: DeriveInput) -> DeriveOutput {
    let output = derive_output_new(input, "Feature");
    let integer = meta_type_call_site("isize");
    derive_output_add_associated_type(output, "Output", integer);
    derive_output_add_constant(output, "CODE", integer, meta_expr_int(7));
    let params = meta_param_list_new();
    meta_param_list_push(params, "self", derive_target_type(input));
    derive_output_add_method(
        output,
        meta_method(
            "value",
            params,
            integer,
            meta_expr_call(input, "Helper::number", meta_expr_list_new()),
        ),
    );
    let inherent = derive_output_inherent(input);
    let callback_params = meta_param_list_new();
    meta_param_list_push(callback_params, "value", integer);
    let callback_types = meta_type_list_new();
    meta_type_list_push(callback_types, integer);
    let callback = meta_expr_closure(callback_params, meta_expr_var("value"));
    derive_output_add_public_method(
        inherent,
        meta_method(
            "callback",
            meta_param_list_new(),
            meta_type_function(callback_types, integer),
            callback,
        ),
    );
    let mut index = 0;
    while index < derive_attribute_count(input) {
        let attribute = derive_attribute(input, index);
        if meta_attribute_name(attribute) == "config" {
            if meta_attribute_argument_text(attribute, 2) != "\\w+" {
                return derive_error_at_argument(attribute, 2, "raw string was not decoded")
            }
            if meta_attribute_argument_value_kind(attribute, 3) != "integer" {
                return derive_error_at(attribute, "priority must be an integer")
            }
            derive_set_span(meta_attribute_argument_span(attribute, 0));
            derive_output_add_public_method(
                inherent,
                meta_method(
                    "configured",
                    meta_param_list_new(),
                    integer,
                    meta_attribute_argument_expr(attribute, 0),
                ),
            );
            derive_output_add_type_alias(
                inherent,
                derive_fresh_name(input, "Alias"),
                meta_attribute_argument_type(attribute, 1),
            );
        }
        index += 1;
    }
    let names = Vec::from_array(["helper"]);
    let prefix = Ref::new("generated");
    let make_name = |value: string| prefix.get() + value;
    let helper = derive_fresh_name(input, make_name(names.get(0)));
    derive_output_add_function(
        inherent,
        meta_method(helper, meta_param_list_new(), integer, meta_expr_int(5)),
    );
    derive_output_add_public_method(
        inherent,
        meta_method(
            "helper_value",
            meta_param_list_new(),
            integer,
            meta_expr_call_site(helper, meta_expr_list_new()),
        ),
    );
    derive_output_add_struct(inherent, derive_fresh_name(input, "Storage"), meta_param_list_new());
    let owner_arguments = meta_type_list_new();
    meta_type_list_push(owner_arguments, integer);
    let owner = meta_type_apply(meta_type_named(input, "Generic"), owner_arguments);
    let method_arguments = meta_type_list_new();
    meta_type_list_push(method_arguments, meta_type_call_site("string"));
    let arguments = meta_expr_list_new();
    meta_expr_list_push(arguments, meta_expr_string("generic"));
    let generic_body = meta_expr_type_member(owner, "identity", method_arguments, arguments);
    derive_output_add_public_method(
        inherent,
        meta_method(
            "generic_value",
            meta_param_list_new(),
            meta_type_call_site("string"),
            generic_body,
        ),
    );
    derive_output_merge(output, inherent);
    output
}
