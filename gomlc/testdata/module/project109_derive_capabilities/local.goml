package main;

#[comptime_derive(Local)]
fn derive_local(input: DeriveInput) -> DeriveOutput {
    let result = derive_output_inherent(input);
    derive_output_add_public_method(
        result,
        meta_method("local", meta_param_list_new(), meta_type_call_site("isize"), meta_expr_int(23)),
    );
    result
}
