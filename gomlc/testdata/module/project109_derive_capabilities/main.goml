package main;

use module::builders;
use builders::Feature;

struct Helper {}

struct Generic {}

#[derive(Feature)]
#[config(value = 40 + 2, ty = Option[isize], raw = r"\w+", priority = 10)]
struct Item {}

#[derive(Local)]
struct LocalItem {}

trait Value {
    fn read(self: Self) -> isize;
}

struct Number {
    value: isize,
}

impl Value for Number {
    #[comptime]
    fn read(self: Number) -> isize {
        self.value
    }
}

#[comptime]
fn read(value: dyn Value) -> isize {
    value.read()
}

#[comptime]
fn apply(callback: (isize) -> isize, value: isize) -> isize {
    callback(value)
}

#[comptime]
fn plus(value: isize) -> isize {
    value + 1
}

fn main() -> () {
    println(Item {}.value());
    println(Item::CODE);
    println(Item::configured());
    println((Item::callback())(9));
    println(LocalItem::local());
    println(Item::helper_value());
    println(Item::generic_value());
    let result = comptime {
        let mut total = 1;
        let add = |value: isize| {
            total += value;
            total
        };
        let _ = apply(add, 4);
        let _ = apply(add, 7);
        let values = Vec::from_array([1, 2]);
        values.push(3);
        values.set(0, 4);
        let state = Ref::new(values.get(0));
        state.set(state.get() + values.len());
        apply(plus, total) + state.get() + read(Number { value: 22 } as dyn Value)
    };
    println(result);
}
