package main;

use std::bytes::endian;
use std::os::linux::abi;
use std::os::linux::syscall;
use std::testing;

fn check_records() -> () {
    testing::assert_eq(abi::Timespec::size(), 16);
    testing::assert_eq(abi::Itimerspec::size(), 32);
    testing::assert_eq(abi::PollFd::size(), 8);
    testing::assert_eq(abi::EpollEvent::size(), 12);
    testing::assert_eq(abi::Msghdr::size(), 56);
    testing::assert_eq(abi::OpenHow::size(), 24);
    testing::assert_eq(abi::Stat::size(), 144);
    testing::assert_eq(abi::Statx::size(), 256);
    testing::assert_eq(abi::Rusage::size(), 144);
    let time = abi::Timespec { seconds: -123456789, nanoseconds: 987654321 };
    let data = time.encode();
    testing::assert_eq(data.len(), 16);
    testing::assert_eq(
        testing::expect_ok(
            endian::read_i64(data.as_slice(), 0, endian::Endian::Little),
            "native seconds",
        ),
        time.seconds,
    );
    testing::assert_eq(
        testing::expect_ok(abi::Timespec::decode(data.as_slice()), "decode time").nanoseconds,
        time.nanoseconds,
    );
    for length in 0..16 {
        testing::assert(abi::Timespec::decode(data.slice(0, length)).is_err());
    }
    let timer = abi::Itimerspec {
        interval: time,
        value: abi::Timespec { seconds: 42, nanoseconds: 5 },
    };
    let decoded = testing::expect_ok(
        abi::Itimerspec::decode(timer.encode().as_slice()),
        "decode timer",
    );
    testing::assert_eq(decoded.interval.seconds, time.seconds);
    testing::assert_eq(decoded.value.seconds, 42);
    let event = abi::EpollEvent { events: 0x11223344, data: 0x0102030405060708 };
    testing::assert(
        event.encode() == Vec::from_array([0x44, 0x33, 0x22, 0x11, 8, 7, 6, 5, 4, 3, 2, 1]),
    );
    testing::assert_eq(
        testing::expect_ok(abi::EpollEvent::decode(event.encode().as_slice()), "packed epoll").data,
        event.data,
    );
    let poll = abi::PollFd { fd: -1, events: 1, revents: 0 };
    testing::assert_eq(
        testing::expect_ok(abi::PollFd::decode(poll.encode().as_slice()), "poll fd").fd,
        -1,
    );
    let limit = abi::Rlimit { current: 0xffffffffffffffff, maximum: 0xffffffffffffffff };
    testing::assert_eq(
        testing::expect_ok(abi::Rlimit::decode(limit.encode().as_slice()), "rlimit").maximum,
        limit.maximum,
    );
    let lock = abi::Flock { kind: 2, whence: 1, start: -32, length: 64, pid: 1234 };
    testing::assert_eq(
        testing::expect_ok(abi::Flock::decode(lock.encode().as_slice()), "flock").start,
        -32,
    );
    testing::assert_eq(lock.encode()[4], 0);
    testing::assert_eq(lock.encode()[31], 0);
    let storage = b"abcdefghijkl";
    let vectors = testing::expect_ok(
        abi::Iovecs::new(
            Vec::from_array([storage.slice_mut(0, 6), storage.slice_mut(6, 12)]).as_slice(),
        ),
        "iovecs",
    );
    testing::assert_eq(vectors.len(), 2);
    let empty: Vec[byte] = Vec::new();
    let message = testing::expect_ok(
        abi::Message::new(empty.as_mut_slice(), vectors, empty.as_mut_slice()),
        "message",
    );
    let header = testing::expect_ok(message.header(), "message header");
    testing::assert_eq(header.iov_len, 2);
    testing::assert_eq(header.iov, 0);
    testing::assert_eq(message.pointers().len(), 5);
    let result = testing::expect_ok(
        syscall::syscall6_with_pointers(
            syscall::SYS_GETPID,
            [
                syscall::Arg::Word(0),
                syscall::Arg::Word(0),
                syscall::Arg::Word(0),
                syscall::Arg::Word(0),
                syscall::Arg::Word(0),
                syscall::Arg::Word(0),
            ],
            message.pointers(),
        ),
        "pin generated graph",
    );
    testing::assert(result.is_ok());
    testing::assert_eq(testing::expect_ok(message.header(), "restored message").iov, 0);
    let excessive: Vec[MutSlice[byte]] = Vec::new();
    for _ in 0..1025 {
        excessive.push(empty.as_mut_slice());
    }
    testing::assert(abi::Iovecs::new(excessive.as_slice()).is_err());
    let now = abi::Timespec { seconds: 0, nanoseconds: 0 }.encode();
    let clock = testing::expect_ok(
        syscall::syscall6_with_buffers(
            syscall::SYS_CLOCK_GETTIME,
            [
                syscall::Arg::Word(1),
                syscall::Arg::Buffer(now.as_mut_slice()),
                syscall::Arg::Word(0),
                syscall::Arg::Word(0),
                syscall::Arg::Word(0),
                syscall::Arg::Word(0),
            ],
        ),
        "clock",
    );
    testing::assert(clock.is_ok());
    let time = testing::expect_ok(abi::Timespec::decode(now.as_slice()), "kernel timespec");
    testing::assert(time.seconds >= 0 && time.nanoseconds >= 0 && time.nanoseconds < 1000000000);
}
