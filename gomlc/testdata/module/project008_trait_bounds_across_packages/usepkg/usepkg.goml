package usepkg;

use project008::traitpkg;

pub fn pick_a[T: traitpkg::B + traitpkg::A + traitpkg::A](x: T) -> string {
    traitpkg::A::foo(x)
}

pub fn foo_both[T: traitpkg::A + traitpkg::B](x: T) -> string {
    traitpkg::A::foo(x) + traitpkg::B::foo(x)
}

pub fn bar_it[T: traitpkg::C](x: T) -> string {
    x.bar()
}
