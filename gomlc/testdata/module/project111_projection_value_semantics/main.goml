package main;

use std::panic;
use std::testing;

const TOO_LARGE: isize = 16;

struct Registers {
    values: [isize; 16],
    shared: Ref[isize],
}

struct Device {
    registers: Registers,
    matrix: [[isize; 4]; 4],
}

fn device(value: isize) -> Device {
    Device {
        registers: Registers { values: [value; 16], shared: Ref::new(value) },
        matrix: [[value; 4]; 4],
    }
}

fn returned(value: Device) -> [isize; 16] {
    value.registers.values
}

fn captured(value: Device) -> () -> isize {
    let values = value.registers.values;
    || values[0] + value.registers.shared.get()
}

fn replace_cell(value: Ref[Device]) -> isize {
    value.set(device(30));
    0
}

fn read_at(values: [isize; 16], index: isize) -> isize {
    values[index]
}

struct Cpu {
    registers: [isize; 16],
    pc: Ref[isize],
}

struct Bus {
    memory: Vec[isize],
    registers: [isize; 16],
}

struct Peripheral {
    ticks: Ref[isize],
}

struct Machine {
    cpu: Cpu,
    bus: Bus,
    peripheral: Peripheral,
}

impl Cpu {
    fn step(self: Cpu, bus: Bus, peripheral: Peripheral) -> () {
        let address = self.pc.get();
        bus.memory[address] = self.registers[address] + bus.registers[address];
        self.pc.set(address + 1);
        peripheral.ticks.set(peripheral.ticks.get() + 1);
    }
}

fn run(machine: Machine, count: isize) -> () {
    for _ in 0..count {
        machine.cpu.step(machine.bus, machine.peripheral);
    }
}

fn replace_selected(value: Device, depth: isize) -> isize {
    let previous = value.registers.values[0];
    let snapshot = value.registers;
    let empty = Channel::[isize]::new(0);
    select {
        recv(empty) as _ => (),
        default => {
            value.registers = Registers { values: [depth; 16], shared: Ref::new(depth) };
        },
    }
    testing::assert_eq(snapshot.values[0], previous);
    if depth > 0 {
        replace_selected(value, depth - 1)
    } else {
        value.registers.values[0]
    }
}

fn snapshots() -> () {
    let initial = device(1);
    testing::assert_eq(replace_selected(initial, 2), 0);
    testing::assert_eq(initial.registers.values[0], 1);
    let field = initial.registers;
    let values = field.values;
    field.shared.set(2);
    testing::assert_eq(initial.registers.shared.get(), 2);
    testing::assert_eq(values[0], 1);
    testing::assert_eq(initial.matrix[2][3], 1);
    testing::assert_eq(returned(initial)[15], 1);
    let callback = captured(initial);
    initial.registers.shared.set(3);
    testing::assert_eq(callback(), 4);
    let mut current = device(4);
    let previous = current.registers.values;
    let previous_matrix = current.matrix;
    current.registers.values[0] = 5;
    current.matrix[2][3] = 6;
    testing::assert_eq(previous[0], 4);
    testing::assert_eq(previous_matrix[2][3], 4);
    testing::assert_eq(current.registers.values[0], 5);
    testing::assert_eq(current.matrix[2][3], 6);
    let before_replace = current.registers;
    current = device(7);
    testing::assert_eq(before_replace.values[0], 5);
    testing::assert_eq(current.registers.values[0], 7);
    let cell = Ref::new(device(8));
    let alias = cell;
    let from_cell = cell.get().registers.values;
    alias.set(device(9));
    testing::assert_eq(from_cell[0], 8);
    testing::assert_eq(cell.get().registers.values[0], 9);
    testing::assert_eq(cell.get().registers.values[replace_cell(cell)], 9);
    testing::assert_eq(cell.get().registers.values[0], 30);
    let vector = Vec::from_array([device(10), device(11)]);
    let from_vector = vector[0].registers.values;
    vector[0] = device(12);
    testing::assert_eq(from_vector[0], 10);
    testing::assert_eq(vector[0].registers.values[0], 12);
    let callbacks: Vec[() -> isize] = Vec::new();
    for index in 0..4 {
        let item = device(index);
        let array = item.registers.values;
        callbacks.push(|| array[0]);
    }
    for index in 0..4 {
        let callback = callbacks[index];
        testing::assert_eq(callback(), index);
    }
    for choose_first in[false, true] {
        let selected = if choose_first {
            device(13)
        } else {
            device(14)
        };
        testing::assert_eq(
            selected.registers.values[0],
            if choose_first {
                13
            } else {
                14
            },
        );
    }
}

fn bounds() -> () {
    let values = [1; 16];
    let empty: [isize; 0] = [];
    testing::assert(panic::catch(|| values[-1]).is_err());
    testing::assert(panic::catch(|| values[16]).is_err());
    testing::assert(panic::catch(|| values[TOO_LARGE]).is_err());
    testing::assert(panic::catch(|| empty[0]).is_err());
    let index = Ref::new(16);
    testing::assert(panic::catch(|| read_at(values, index.get())).is_err());
    index.set(-1);
    testing::assert(panic::catch(|| read_at(values, index.get())).is_err());
    testing::assert(
        panic::catch(
            || {
                let _ = values[index.get()];
            },
        ).is_err(),
    );
}

fn main() -> () {
    snapshots();
    bounds();
    let machine = Machine {
        cpu: Cpu { registers: [4; 16], pc: Ref::new(0) },
        bus: Bus { memory: Vec::from_array([0; 16]), registers: [3; 16] },
        peripheral: Peripheral { ticks: Ref::new(0) },
    };
    run(machine, 4);
    testing::assert_eq(machine.cpu.pc.get(), 4);
    testing::assert_eq(machine.peripheral.ticks.get(), 4);
    for index in 0..16 {
        testing::assert_eq(
            machine.bus.memory[index],
            if index < 4 {
                7
            } else {
                0
            },
        );
    }
    println("projection snapshots, bounds and CPU/bus interaction passed");
}
