package kernels;

use std::simd;

fn product(a: simd::f32x8, b: simd::f32x8) -> simd::f32x8 {
    a.add(b).mul(a)
}

pub fn calculate(a: simd::f32x8, b: simd::f32x8) -> simd::f32x8 {
    product(a, b).sub(b).div(b)
}

pub fn choose(a: simd::f32x8, b: simd::f32x8) -> simd::f32x8 {
    a.simd_ge(b).select(a, b)
}

pub fn total(a: simd::f32x8) -> f32 {
    a.reduce_sum()
}

pub fn mixed(mask: simd::mask32x8, value: f32, a: simd::f32x8, other: simd::mask32x8) -> simd::f32x8 {
    mask.bitxor(other).select(a, simd::f32x8::splat(value))
}
