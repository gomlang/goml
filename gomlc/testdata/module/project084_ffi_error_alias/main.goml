package main;

use std::ffi;
use std::io;

fn main() -> () {
    let _ = ffi::string_from_text("FFI");
    let result = io::read_stdin_exact_structured(-1).map_err(|error| error.to_string());
    println(result.is_err());
    let error = io::Error::new(
        io::ErrorKind::InvalidData,
        "decode",
        Option::None,
        Option::None,
        "invalid",
    );
    println(error.to_string())
}
