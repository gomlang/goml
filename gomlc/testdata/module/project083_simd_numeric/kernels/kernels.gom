package kernels;

use std::simd;

pub fn integer_mix(a: simd::i32x4, b: simd::i32x4) -> simd::i32x4 {
    a.simd_lt(b).select(a.mul(b), a.bitxor(b))
}

pub fn widen(a: simd::i16x8) -> simd::f32x8 {
    a.to_i32().to_f32().mul(simd::f32x8::splat(0.5))
}

pub fn to_integer(a: simd::f32x4) -> simd::i32x4 {
    a.to_i32()
}

pub fn fused32(a: simd::f32x4, b: simd::f32x4, c: simd::f32x4) -> simd::f32x4 {
    a.mul_add(b, c)
}

pub fn separate32(a: simd::f32x4, b: simd::f32x4, c: simd::f32x4) -> simd::f32x4 {
    a.mul(b).add(c)
}

pub fn fused64(a: simd::f64x2, b: simd::f64x2, c: simd::f64x2) -> simd::f64x2 {
    a.mul_add(b, c)
}

pub fn separate64(a: simd::f64x2, b: simd::f64x2, c: simd::f64x2) -> simd::f64x2 {
    a.mul(b).add(c)
}

pub fn shuffle(a: simd::u8x16) -> simd::u8x16 {
    a.swizzle([15, 0, 16, 4294967295, 1, 14, 2, 13, 3, 12, 4, 11, 5, 10, 6, 9])
}

pub fn dynamic_shuffle(a: simd::u8x16, indices: [u32; 16]) -> simd::u8x16 {
    a.swizzle(indices)
}

pub fn min_double(a: simd::f64x2, b: simd::f64x2) -> simd::f64x2 {
    a.min(b)
}

pub fn max_double(a: simd::f64x2, b: simd::f64x2) -> simd::f64x2 {
    a.max(b)
}
