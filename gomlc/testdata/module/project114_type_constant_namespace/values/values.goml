package values;

pub struct Item {
    pub value: i32,
}

pub type Size = Item;

pub const Size: usize = 2;

pub const Other: usize = 3;

pub struct Fixed[const N: usize] {
    pub items: [i32; N],
}

pub fn identity[T](value: T) -> T {
    value
}

pub fn count[const N: usize]() -> usize {
    N
}
