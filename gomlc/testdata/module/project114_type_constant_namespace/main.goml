package main;

use module::values;

struct Other {}

fn main() -> () {
    let item: values::Size = values::Item { value: 7 };
    let same: values::Size = values::identity::[values::Size](item);
    let fixed: values::Fixed[values::Size] = values::Fixed { items: [1, 2] };
    let other: values::Fixed[values::Other] = values::Fixed { items: [1, 2, 3] };
    println(same.value);
    println(values::count::[values::Size]());
    println(fixed.items[1]);
    println(other.items[2]);
}
