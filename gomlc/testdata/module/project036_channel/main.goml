package main;

use channel_project::worker;

fn main() -> () {
    let channel = worker::ready(42);
    println(
        match channel.recv() {
            Option::Some(value) => value.to_string(),
            Option::None => "closed",
        },
    );
    println(
        match channel.recv() {
            Option::Some(value) => value.to_string(),
            Option::None => "closed",
        },
    )
}
