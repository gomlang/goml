package main;

use std::net;
use std::task;
use std::testing;
use std::time;

fn options() -> net::WaitOptions {
    net::WaitOptions::new().with_timeout(time::Duration::from_seconds(3))
}

fn main() -> () {
    let address = testing::expect_ok(net::SocketAddr::parse("127.0.0.1:0"), "address");
    let listener = testing::expect_ok(net::TcpListener::bind(address), "bind TCP");
    defer testing::expect_ok(listener.close(), "close listener");
    let local = testing::expect_ok(listener.local_addr(), "listener address");
    testing::assert(local.port != 0);
    task::scope(
        |scope: task::Scope| {
            let server = scope.spawn(
                |_: task::CancelToken| {
                    let (stream, peer) = testing::expect_ok(
                        listener.accept_with(options()),
                        "accept",
                    );
                    defer testing::expect_ok(stream.close(), "close accepted stream");
                    testing::assert_eq(testing::expect_ok(stream.peer_addr(), "peer"), peer);
                    let data = Vec::from_array([0, 0, 0, 0]);
                    testing::expect_ok(
                        stream.read_exact_with(data.as_mut_slice(), options()),
                        "read ping",
                    );
                    testing::assert(data == b"ping");
                    testing::expect_ok(
                        stream.write_all_with(b"pong".as_slice(), options()),
                        "write pong",
                    );
                    testing::expect_ok(stream.shutdown(net::Shutdown::Write), "half close");
                },
            );
            let client = testing::expect_ok(
                net::TcpStream::connect_with(local, options()),
                "connect",
            );
            defer testing::expect_ok(client.close(), "close client");
            testing::expect_ok(client.set_nodelay(true), "nodelay");
            testing::expect_ok(client.write_all_with(b"ping".as_slice(), options()), "write ping");
            let data = Vec::from_array([0, 0, 0, 0]);
            testing::expect_ok(client.read_exact_with(data.as_mut_slice(), options()), "read pong");
            testing::assert(data == b"pong");
            testing::assert_eq(
                testing::expect_ok(client.read_with(data.as_mut_slice(), options()), "EOF"),
                0,
            );
            server.join();
        },
    );
    let left = testing::expect_ok(net::UdpSocket::bind(address), "bind UDP left");
    defer testing::expect_ok(left.close(), "close UDP left");
    let right = testing::expect_ok(net::UdpSocket::bind(address), "bind UDP right");
    defer testing::expect_ok(right.close(), "close UDP right");
    let destination = testing::expect_ok(right.local_addr(), "UDP destination");
    testing::assert_eq(
        testing::expect_ok(left.send_to(b"hello".as_slice(), destination), "send"),
        5,
    );
    let data = Vec::from_array([0, 0, 0]);
    let received = testing::expect_ok(
        right.recv_from_with(data.as_mut_slice(), options()),
        "receive",
    );
    testing::assert(received.truncated && received.len == 3 && received.datagram_len == 5);
    testing::assert_eq(received.source, testing::expect_ok(left.local_addr(), "sender"));
    testing::assert(data == b"hel");
    testing::assert_eq(
        testing::expect_ok(left.send_to(b"".as_slice(), destination), "empty send"),
        0,
    );
    let empty = testing::expect_ok(
        right.recv_from_with(data.as_mut_slice(), options()),
        "empty receive",
    );
    testing::assert(empty.len == 0 && !empty.truncated);
    println("syscall networking: ok");
}
