package main;

use std::fs;
use std::fs::walkdir;
use std::io;
use std::path;
use std::testing;

fn descriptor_relative_walk(base: string) -> () {
    let root = path::join(base, "relative-fd");
    let moved = path::join(base, "relative-fd-moved");
    ok(fs::create_dir_all(path::join(root, "a")));
    ok(fs::write_file_structured(path::join(root, "a/child"), "original"));
    ok(fs::write_file_structured(path::join(root, "z"), "last"));
    let iterator = walkdir::walk(root);
    defer iterator.close();
    let _ = next_entry(iterator);
    testing::assert(next_entry(iterator).file_name() == Option::Some("a"));
    ok(fs::rename(root, moved));
    ok(fs::create_dir_all(path::join(root, "a")));
    ok(fs::write_file_structured(path::join(root, "a/replacement"), "different"));
    let child = next_entry(iterator);
    testing::assert_eq(child.path(), path::join(root, "a/child"));
    testing::assert_eq(child.metadata().len(), 8);
    testing::assert(next_entry(iterator).file_name() == Option::Some("z"));
    finished(iterator);
}

fn rejects_replaced_directory(base: string, follow: bool) -> () {
    let root = path::join(
        base,
        if follow {
            "follow-replacement"
        } else {
            "nofollow-replacement"
        },
    );
    let outside = path::join(
        base,
        if follow {
            "follow-outside"
        } else {
            "nofollow-outside"
        },
    );
    ok(fs::create_dir_all(path::join(root, "a")));
    ok(fs::write_file_structured(path::join(root, "z"), "last"));
    ok(fs::create_dir(outside));
    ok(fs::write_file_structured(path::join(outside, "unexpected"), "outside"));
    let iterator = walkdir::WalkDir::new(root).follow_links(follow).iter();
    defer iterator.close();
    let _ = next_entry(iterator);
    testing::assert(next_entry(iterator).file_name() == Option::Some("a"));
    ok(fs::rename(path::join(root, "a"), path::join(root, "old")));
    ok(fs::symbolic_link(outside, path::join(root, "a")));
    let error = next_error(iterator);
    testing::assert_eq(error.path(), path::join(root, "a"));
    if follow {
        testing::assert_eq(error.kind(), io::ErrorKind::Other);
        testing::assert(error.fs_error().message().contains("changed"));
    } else {
        testing::assert(error.fs_error().raw_os_code().is_some());
    }
    testing::assert(next_entry(iterator).file_name() == Option::Some("z"));
    finished(iterator);
}
