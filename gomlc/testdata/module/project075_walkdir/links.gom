package main;

use std::fs;
use std::fs::walkdir;
use std::io;
use std::path;
use std::testing;

fn symbolic_links(base: string) -> () {
    let root = path::join(base, "links");
    let directory = path::join(root, "a");
    ok(fs::create_dir_all(directory));
    ok(fs::write_file_structured(path::join(directory, "file"), "data"));
    ok(fs::symbolic_link("a", path::join(root, "b")));
    ok(fs::symbolic_link("a", path::join(root, "c")));
    ok(fs::symbolic_link("a/file", path::join(root, "d")));
    let builder = walkdir::WalkDir::new(root);
    testing::assert_eq(listing(builder, root), ".@0\na@1\na/file@2\nb@1\nc@1\nd@1\n");
    testing::assert_eq(
        listing(builder.follow_links(true), root),
        ".@0\na@1\na/file@2\nb@1\nb/file@2\nc@1\nc/file@2\nd@1\n",
    );
    testing::assert_eq(
        listing(builder.follow_links(true).contents_first(true), root),
        "a/file@2\na@1\nb/file@2\nb@1\nc/file@2\nc@1\nd@1\n.@0\n",
    );
    let root_link = path::join(base, "root-link");
    ok(fs::symbolic_link(root, root_link));
    let walker = walkdir::walk(root_link);
    let entry = next_entry(walker);
    testing::assert(entry.path_is_symlink());
    testing::assert(entry.file_type().is_symlink());
    finished(walker);
    testing::assert_eq(
        listing(walkdir::WalkDir::new(root_link).follow_links(true).max_depth(1), root_link),
        ".@0\na@1\nb@1\nc@1\nd@1\n",
    );
    let file_link = walkdir::WalkDir::new(path::join(root, "d")).follow_links(true).iter();
    let entry = next_entry(file_link);
    testing::assert(entry.path_is_symlink());
    testing::assert(entry.file_type().is_file());
    testing::assert_eq(entry.metadata().len(), 4);
    finished(file_link);
    ok(fs::symbolic_link("absent", path::join(root, "broken")));
    let broken = walkdir::walk(path::join(root, "broken"));
    testing::assert(next_entry(broken).file_type().is_symlink());
    finished(broken);
    let following = builder.follow_links(true).iter();
    let mut errors = 0;
    let mut after_error = false;
    for item in following {
        match item {
            Ok(entry) => {
                if entry.file_name() == Option::Some("c") {
                    after_error = errors == 1;
                }
            },
            Err(error) => {
                errors += 1;
                testing::assert_eq(error.kind(), io::ErrorKind::NotFound);
                testing::assert_eq(error.path(), path::join(root, "broken"));
                testing::assert_eq(error.depth(), 1);
            },
        }
    }
    testing::assert_eq(errors, 1);
    testing::assert(after_error);
    ok(fs::remove_file(path::join(root, "broken")));
    ok(fs::symbolic_link("..", path::join(directory, "back")));
    let following = builder.follow_links(true).iter();
    let mut loops = 0;
    let mut entries = 0;
    for item in following {
        match item {
            Ok(_) => {
                entries += 1;
            },
            Err(error) => {
                loops += 1;
                testing::assert_eq(error.kind(), io::ErrorKind::InvalidData);
                testing::assert(error.loop_ancestor() == Option::Some(root));
                testing::assert_eq(error.depth(), 2);
                testing::assert(error.path().ends_with("/back"));
            },
        }
    }
    testing::assert_eq(loops, 3);
    testing::assert_eq(entries, 11);
    finished(following);
    testing::assert_eq(
        listing(builder.follow_links(true).max_depth(1), root),
        ".@0\na@1\nb@1\nc@1\nd@1\n",
    );
    testing::assert_eq(
        listing(
            builder.follow_links(true).filter_entry(
                |entry| entry.file_name() != Option::Some("back"),
            ),
            root,
        ),
        ".@0\na@1\na/file@2\nb@1\nb/file@2\nc@1\nc/file@2\nd@1\n",
    );
    let followed_root = walkdir::WalkDir::new(root_link).follow_links(true).iter();
    let _ = next_entry(followed_root);
    let _ = next_entry(followed_root);
    let _ = next_entry(followed_root);
    testing::assert(next_error(followed_root).loop_ancestor() == Option::Some(root_link));
    followed_root.close();
    finished(followed_root);
    let self_link = path::join(base, "self-link");
    ok(fs::symbolic_link("self-link", self_link));
    let self_cycle = walkdir::WalkDir::new(self_link).follow_links(true).iter();
    testing::assert(next_error(self_cycle).fs_error().raw_os_code().is_some());
    finished(self_cycle);
}

fn deep_tree(base: string) -> () {
    let root = path::join(base, "deep");
    let mut deepest = root;
    for _ in 0..128 {
        deepest = path::join(deepest, "d");
    }
    ok(fs::create_dir_all(deepest));
    let mut count = 0;
    for item in walkdir::walk(root) {
        let entry = testing::expect_ok(item, "deep directory");
        testing::assert_eq(entry.depth(), count);
        count += 1;
    }
    testing::assert_eq(count, 129);
    let mut depth = 128;
    for item in walkdir::WalkDir::new(root).contents_first(true) {
        let entry = testing::expect_ok(item, "postorder deep directory");
        testing::assert_eq(entry.depth(), depth);
        depth -= 1;
    }
    testing::assert_eq(depth, -1);
}
