package convert;

pub trait Convert[T] {
    fn convert(self: Self) -> T;
}

pub struct Token {}

impl Convert[i32]for Token {
    fn convert(self: Token) -> i32 {
        27
    }
}

impl Convert[string]for Token {
    fn convert(self: Token) -> string {
        "twenty-seven"
    }
}

pub fn token() -> Token {
    Token {}
}

pub fn convert_to[T, V: Convert[T]](value: V) -> T {
    value.convert()
}
