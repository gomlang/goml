package main;

use generic_iter::convert;
use convert::Convert;

fn scoped_convert[T, V: convert::Convert[T]](value: V) -> T {
    value.convert()
}

fn main() -> () {
    println(convert::Convert::[i32]::convert(convert::token()));
    println(convert::Convert::[string]::convert(convert::token()));
    let number: i32 = convert::convert_to::[i32, convert::Token](convert::token());
    let text: string = convert::convert_to(convert::token());
    let scoped: i32 = scoped_convert(convert::token());
    println(number);
    println(text);
    println(scoped);
}
