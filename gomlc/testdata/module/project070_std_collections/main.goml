package main;

use std::cmp;
use std::collections;
use std::testing;

fn assert_index_set() -> () {
    let values = collections::IndexSet::new();
    testing::assert(values.insert(3));
    testing::assert(values.insert(1));
    testing::assert(!values.insert(3));
    testing::assert(values.insert(2));
    testing::assert(values.remove(1));
    testing::assert(!values.remove(4));
    testing::assert(values.insert(1));
    testing::assert_eq(values.len(), 3);
    let ordered = values.to_vec();
    testing::assert_eq(ordered[0], 3);
    testing::assert_eq(ordered[1], 2);
    testing::assert_eq(ordered[2], 1);
    values.clear();
    testing::assert(values.is_empty())
}

fn assert_binary_heap() -> () {
    let heap = collections::BinaryHeap::from_vec(Vec::from_array([4, 1, 7, 3, 9, 2]));
    testing::assert_eq(heap.peek().unwrap_or(0), 9);
    let expected = Vec::from_array([9, 7, 4, 3, 2, 1]);
    for value in expected {
        testing::assert_eq(heap.pop().unwrap_or(0), value)
    }
    testing::assert(heap.pop().is_none());
    let minimum: collections::BinaryHeap[cmp::Reverse[isize]] = collections::BinaryHeap::new();
    minimum.push(cmp::Reverse::new(8));
    minimum.push(cmp::Reverse::new(2));
    minimum.push(cmp::Reverse::new(5));
    testing::assert_eq(minimum.pop().unwrap_or(cmp::Reverse::new(0)).into_inner(), 2);
    testing::assert_eq(minimum.pop().unwrap_or(cmp::Reverse::new(0)).into_inner(), 5);
    testing::assert_eq(minimum.pop().unwrap_or(cmp::Reverse::new(0)).into_inner(), 8)
}

fn assert_btree_map() -> () {
    let values: collections::BTreeMap[isize, isize] = collections::BTreeMap::new();
    let mut index = 0;
    while index < 512 {
        let key = index * 73 % 512;
        testing::assert(values.insert(key, key * 10).is_none());
        index += 1;
    }
    testing::assert_eq(values.len(), 512);
    testing::assert_eq(values.insert(32, 999).unwrap_or(0), 320);
    testing::assert_eq(values.len(), 512);
    testing::assert_eq(values.get(32).unwrap_or(0), 999);
    testing::assert(values.get(700).is_none());
    testing::assert(values.remove(-1).is_none());
    testing::assert(values.remove(700).is_none());
    testing::assert_eq(values.len(), 512);
    match values.first() {
        Some((key, value)) => {
            testing::assert_eq(key, 0);
            testing::assert_eq(value, 0)
        },
        None => testing::fail("missing first entry"),
    };
    match values.last() {
        Some((key, value)) => {
            testing::assert_eq(key, 511);
            testing::assert_eq(value, 5110)
        },
        None => testing::fail("missing last entry"),
    };
    index = 0;
    for (key, value) in values {
        testing::assert_eq(key, index);
        testing::assert_eq(
            value,
            if key == 32 {
                999
            } else {
                key * 10
            },
        );
        index += 1;
    }
    testing::assert_eq(index, 512);
    index = 0;
    while index < 512 {
        testing::assert_eq(
            values.remove(index).unwrap_or(-1),
            if index == 32 {
                999
            } else {
                index * 10
            },
        );
        index += 2;
    }
    testing::assert_eq(values.len(), 256);
    index = 1;
    for (key, value) in values {
        testing::assert_eq(key, index);
        testing::assert_eq(value, key * 10);
        index += 2;
    }
    index = 511;
    while index >= 1 {
        testing::assert_eq(values.remove(index).unwrap_or(-1), index * 10);
        index -= 2;
    }
    testing::assert(values.is_empty());
    testing::assert(values.first().is_none());
    testing::assert(values.last().is_none())
}

fn assert_btree_set() -> () {
    let values = collections::BTreeSet::from_vec(Vec::from_array([5, 1, 3, 1, 4, 2]));
    testing::assert_eq(values.len(), 5);
    testing::assert_eq(values.first().unwrap_or(0), 1);
    testing::assert_eq(values.last().unwrap_or(0), 5);
    testing::assert(values.contains(3));
    testing::assert(values.remove(3));
    testing::assert(!values.contains(3));
    let ordered = values.to_vec();
    testing::assert_eq(ordered.len(), 4);
    testing::assert_eq(ordered[0], 1);
    testing::assert_eq(ordered[1], 2);
    testing::assert_eq(ordered[2], 4);
    testing::assert_eq(ordered[3], 5)
}

fn main() -> () {
    assert_index_set();
    assert_binary_heap();
    assert_btree_map();
    assert_btree_set();
    println("standard collections ok")
}
