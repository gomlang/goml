package iterables;

pub struct Numbers {
    values: Vec[i32],
}

impl IntoIterator for Numbers {
    type Item = i32;

    type IntoIter = FnIterator[i32];

    fn into_iter(self: Numbers) -> FnIterator[i32] {
        self.values.iter()
    }
}

pub fn numbers() -> Numbers {
    let values: Vec[i32] = Vec::new();
    values.push(1);
    values.push(2);
    values.push(3);
    Numbers { values }
}
