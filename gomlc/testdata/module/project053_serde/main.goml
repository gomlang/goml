package main;

use std::serde;
use serde::{Deserialize, Serialize};

#[derive(Serialize, Deserialize)]
struct Item[T] {
    #[serde(rename = "item_name")]
    name: string,
    value: T,
}

#[derive(Serialize, Deserialize)]
enum Choice {
    None,
    Pair(i32, string),
    Named { enabled: bool },
}

fn decode_item(value: serde::Value) -> Result[Item[i32], string] {
    serde::from_value(value)
}

fn decode_choice(value: serde::Value) -> Result[Choice, string] {
    serde::from_value(value)
}

fn main() -> () {
    let item = Item { name: "one", value: 13.to_i32() };
    let decoded = match serde::to_value(item) {
        Ok(value) => match decode_item(value) {
            Ok(value) => value,
            Err(error) => {
                println(error);
                Item { name: "error", value: 0 }
            },
        },
        Err(error) => {
            println(error);
            Item { name: "error", value: 0 }
        },
    };
    println(decoded.name + decoded.value.to_string());
    let choice = match serde::to_value(Choice::Pair(7, "seven")) {
        Ok(value) => decode_choice(value).unwrap_or(Choice::None),
        Err(error) => {
            println(error);
            Choice::None
        },
    };
    match choice {
        Pair(number, name) => println(number.to_string() + name),
        _ => println("wrong"),
    };
    let schema = serde::structure_schema(
        Vec::from_array(
            [
                ("item_name", serde::Schema::String),
                ("value", serde::Schema::Integer { signed: true, width: 32 }),
            ],
        ),
    );
    match schema {
        serde::Schema::Struct(fields) => println(fields[0].0 + fields[1].0),
        _ => println("wrong schema"),
    };
    match serde::to_value((1.to_i16(), true)) {
        Ok(serde::Value::Tuple(values)) => println(values.len().to_string()),
        _ => println("wrong tuple"),
    };
    match serde::to_value(Option::Some(3.to_u8())) {
        Ok(serde::Value::Optional(values)) => println(values.len().to_string()),
        _ => println("wrong optional"),
    }
}
