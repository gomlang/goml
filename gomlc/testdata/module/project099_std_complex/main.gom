package main;

use std::math;
use std::math::complex;
use std::testing;

fn near(actual: f64, expected: f64, tolerance: f64) -> bool {
    let difference = if actual < expected {
        expected - actual
    } else {
        actual - expected
    };
    difference <= tolerance
}

fn near_complex(actual: complex::Complex, expected: complex::Complex, tolerance: f64) -> bool {
    near(actual.real, expected.real, tolerance)
        && near(actual.imaginary, expected.imaginary, tolerance)
}

fn get(value: Result[complex::Complex, complex::DivisionError]) -> complex::Complex {
    testing::expect_ok(value, "complex result")
}

fn check_arithmetic() -> () {
    let left = complex::Complex::new(3.0, 4.0);
    let right = complex::Complex::new(1.0, -2.0);
    testing::assert(left.add(right) == complex::Complex::new(4.0, 2.0));
    testing::assert(left.sub(right) == complex::Complex::new(2.0, 6.0));
    testing::assert(left.mul(right) == complex::Complex::new(11.0, -2.0));
    testing::assert(left.conjugate() == complex::Complex::new(3.0, -4.0));
    testing::assert(left.abs() == 5.0);
    testing::assert(near_complex(get(left.try_div(right)), complex::Complex::new(-1.0, 2.0), 1e-14));
    testing::assert(get(left.powi(2)) == complex::Complex::new(-7.0, 24.0));
    testing::assert(
        get(left.powi(-1)) == get(left.try_div(complex::Complex::from_real(25.0))).conjugate(),
    );
    testing::assert(complex::Complex::new(0.0, 0.0).try_div(right).is_ok());
    testing::assert(
        complex::Complex::from_real(1.0).try_div(complex::Complex::from_real(0.0)).is_err(),
    );
    testing::assert(complex::Complex::from_real(0.0).powi(-1).is_err());
}

fn check_functions() -> () {
    let z = complex::Complex::new(1.25, -0.75);
    testing::assert(near_complex(z.exp().log(), z, 1e-13));
    testing::assert(near_complex(z.sqrt().mul(z.sqrt()), z, 1e-13));
    testing::assert(
        near_complex(
            z.sin().mul(z.sin()).add(z.cos().mul(z.cos())),
            complex::Complex::from_real(1.0),
            1e-13,
        ),
    );
    testing::assert(
        near_complex(
            z.sinh().mul(z.sinh()).sub(z.cosh().mul(z.cosh())),
            complex::Complex::from_real(-1.0),
            1e-13,
        ),
    );
    testing::assert(near_complex(get(z.tan()), get(z.sin().try_div(z.cos())), 1e-14));
    testing::assert(near_complex(get(z.tanh()), get(z.sinh().try_div(z.cosh())), 1e-14));
    testing::assert(near_complex(z.asin().sin(), z, 1e-13));
    testing::assert(near_complex(z.acos().cos(), z, 1e-13));
    testing::assert(near_complex(get(z.atan().tan()), z, 1e-13));
    testing::assert(near_complex(z.asinh().sinh(), z, 1e-13));
    testing::assert(near_complex(z.acosh().cosh(), z, 1e-13));
    testing::assert(near_complex(get(z.atanh().tanh()), z, 1e-13));
    testing::assert(near_complex(z.pow(complex::Complex::from_real(2.0)), z.mul(z), 1e-13));
    testing::assert(
        near_complex(z.log10().mul(complex::Complex::from_real(math::LN_10)), z.log(), 1e-13),
    );
}

fn check_edges() -> () {
    let tiny = complex::Complex::new(1e-300, 1e-300);
    testing::assert(tiny.abs() > 1e-300);
    testing::assert(near(complex::Complex::new(0.0, 1e-20).sin().imaginary, 1e-20, 1e-32));
    testing::assert(near(complex::Complex::new(1e-20, 0.0).sinh().real, 1e-20, 1e-32));
    let huge = complex::Complex::new(1e300, 1e300);
    testing::assert(math::is_finite(huge.abs()));
    testing::assert(near_complex(get(huge.try_div(huge)), complex::Complex::from_real(1.0), 1e-14));
    testing::assert(near_complex(get(tiny.try_div(tiny)), complex::Complex::from_real(1.0), 1e-14));
    let subnormal = float64_from_bits(1);
    let subnormal_value = complex::Complex::new(subnormal, subnormal);
    testing::assert(
        get(subnormal_value.try_div(subnormal_value)) == complex::Complex::from_real(1.0),
    );
    let infinity = float64_from_bits(0x7ff0000000000000);
    let infinite_divisor = get(
        complex::Complex::new(3.0, 4.0).try_div(complex::Complex::new(2.0, infinity)),
    );
    testing::assert(infinite_divisor.real == 0.0);
    testing::assert(infinite_divisor.imaginary.to_bits() == 0x8000000000000000);
    let infinite_numerator = get(
        complex::Complex::new(infinity, 1.0).try_div(complex::Complex::new(2.0, 3.0)),
    );
    testing::assert(math::is_infinite(infinite_numerator.real));
    testing::assert(math::is_infinite(infinite_numerator.imaginary));
    testing::assert(infinite_numerator.imaginary < 0.0);
    testing::assert(near(complex::atan2(1.0, 1.0), math::PI / 4.0, 1e-15));
    testing::assert(near(complex::atan2(1.0, -1.0), 3.0 * math::PI / 4.0, 1e-15));
    testing::assert(near(complex::atan2(-1.0, -1.0), -3.0 * math::PI / 4.0, 1e-15));
    testing::assert(complex::atan2(-0.0, -0.0) == -math::PI);
    testing::assert(complex::atan2(0.0, -0.0) == math::PI);
    let origin = complex::Complex::from_real(0.0);
    testing::assert(origin.sqrt() == origin);
    testing::assert(math::is_infinite(origin.log().real));
    testing::assert(origin.log().real < 0.0);
    testing::assert(
        near_complex(
            complex::Complex::new(-4.0, 0.0).sqrt(),
            complex::Complex::new(0.0, 2.0),
            1e-15,
        ),
    );
    testing::assert(
        near_complex(
            complex::Complex::new(-4.0, -0.0).sqrt(),
            complex::Complex::new(0.0, -2.0),
            1e-15,
        ),
    );
    let asin_edge = complex::Complex::from_real(2.0).asin();
    testing::assert(
        near_complex(asin_edge, complex::Complex::new(math::PI / 2.0, 1.3169578969248164), 1e-13),
    );
    testing::assert(
        near_complex(
            complex::Complex::from_real(-2.0).acosh(),
            complex::Complex::new(1.3169578969248164, math::PI),
            1e-13,
        ),
    );
    testing::assert(
        near_complex(
            complex::Complex::from_real(2.0).atanh(),
            complex::Complex::new(0.5493061443340549, math::PI / 2.0),
            1e-13,
        ),
    );
    testing::assert(
        near_complex(
            complex::Complex::new(2.0, -0.0).atanh(),
            complex::Complex::new(0.5493061443340549, -math::PI / 2.0),
            1e-13,
        ),
    );
    testing::assert(
        complex::Complex::from_real(0.0).pow(complex::Complex::from_real(0.0))
            == complex::Complex::from_real(1.0),
    );
    testing::assert(
        complex::Complex::from_real(0.0).pow(complex::Complex::from_real(2.0))
            == complex::Complex::from_real(0.0),
    );
    let polar = complex::Complex::from_polar(2.0, math::PI / 3.0);
    testing::assert(near(polar.abs(), 2.0, 1e-14));
    testing::assert(near(polar.phase(), math::PI / 3.0, 1e-14));
}

fn check_go_references() -> () {
    let z = complex::Complex::new(1.25, -0.75);
    let tolerance = 2e-13;
    testing::assert(
        near_complex(
            z.exp(),
            complex::Complex::new(2.5538450905269614, -2.379153045580467),
            tolerance,
        ),
    );
    testing::assert(
        near_complex(
            z.log(),
            complex::Complex::new(0.37688590118819, -0.5404195002705842),
            tolerance,
        ),
    );
    testing::assert(
        near_complex(
            z.log10(),
            complex::Complex::new(0.16367946719316512, -0.23470120688042762),
            tolerance,
        ),
    );
    testing::assert(
        near_complex(
            z.sqrt(),
            complex::Complex::new(1.1635587595199748, -0.32228711866232346),
            tolerance,
        ),
    );
    testing::assert(
        near_complex(
            z.sin(),
            complex::Complex::new(1.2286345240950955, -0.2592948545511628),
            tolerance,
        ),
    );
    testing::assert(
        near_complex(
            z.cos(),
            complex::Complex::new(0.40824259187796885, 0.7803659308458533),
            tolerance,
        ),
    );
    testing::assert(
        near_complex(
            get(z.tan()),
            complex::Complex::new(0.38579595260975053, -1.372607570533783),
            tolerance,
        ),
    );
    testing::assert(
        near_complex(
            z.sinh(),
            complex::Complex::new(1.1721063598927026, -1.287222910026492),
            tolerance,
        ),
    );
    testing::assert(
        near_complex(
            z.cosh(),
            complex::Complex::new(1.381738730634259, -1.0919301355539748),
            tolerance,
        ),
    );
    testing::assert(
        near_complex(
            get(z.tanh()),
            complex::Complex::new(0.9753632850312357, -0.16080778591620642),
            tolerance,
        ),
    );
    testing::assert(
        near_complex(
            z.asin(),
            complex::Complex::new(0.9117382909684876, -1.0317185344477802),
            tolerance,
        ),
    );
    testing::assert(
        near_complex(
            z.acos(),
            complex::Complex::new(0.659058035826409, 1.0317185344477802),
            tolerance,
        ),
    );
    testing::assert(
        near_complex(
            z.atan(),
            complex::Complex::new(0.9968251264639186, -0.2614921387956719),
            tolerance,
        ),
    );
    testing::assert(
        near_complex(
            z.asinh(),
            complex::Complex::new(1.1323936316053085, -0.4532761776387939),
            tolerance,
        ),
    );
    testing::assert(
        near_complex(
            z.acosh(),
            complex::Complex::new(1.0317185344477802, -0.659058035826409),
            tolerance,
        ),
    );
    testing::assert(
        near_complex(
            z.atanh(),
            complex::Complex::new(0.5493061443340549, -1.1071487177940904),
            tolerance,
        ),
    );
    testing::assert(
        near_complex(
            z.pow(complex::Complex::new(0.5, 1.25)),
            complex::Complex::new(2.324837573035308, 0.473440889325845),
            tolerance,
        ),
    );
}

fn main() -> () {
    check_arithmetic();
    check_functions();
    check_edges();
    check_go_references();
    println("complex math ok")
}
