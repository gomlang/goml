package api;

pub trait Parent[T] {
    fn parent(self: Self) -> T;
}

pub trait Child[T: ToString]: Parent[T] {
    fn child(self: Self) -> string;
}

pub struct Box[T] {
    value: T,
}

impl[T] Parent[T]for Box[T] {
    fn parent(self: Box[T]) -> T {
        self.value
    }
}

impl[T: ToString] Child[T]for Box[T] {
    fn child(self: Box[T]) -> string {
        "child"
    }
}

pub fn boxed[T](value: T) -> Box[T] {
    Box { value }
}
