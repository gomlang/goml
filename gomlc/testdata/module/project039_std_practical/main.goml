package main;

use std::ascii;
use std::cmp;
use std::collections;
use std::iter;
use std::num;
use std::testing;
use std::text;
use std::time;

fn compare_int(left: isize, right: isize) -> isize {
    if left < right {
        -1
    } else if left > right {
        1
    } else {
        0
    }
}

fn unwrap_int[E: ToString](value: Result[isize, E]) -> isize {
    match value {
        Result::Ok(value) => value,
        Result::Err(error) => {
            testing::fail(error.to_string());
            0
        },
    }
}

fn unwrap_uint[E: ToString](value: Result[usize, E]) -> usize {
    match value {
        Result::Ok(value) => value,
        Result::Err(error) => {
            testing::fail(error.to_string());
            0
        },
    }
}

fn unwrap_float32[E: ToString](value: Result[f32, E]) -> f32 {
    match value {
        Result::Ok(value) => value,
        Result::Err(error) => {
            testing::fail(error.to_string());
            0.0
        },
    }
}

fn unwrap_float64[E: ToString](value: Result[f64, E]) -> f64 {
    match value {
        Result::Ok(value) => value,
        Result::Err(error) => {
            testing::fail(error.to_string());
            0.0
        },
    }
}

fn assert_text() -> () {
    testing::assert_eq(text::trim(" \tvalue\r\n"), "value");
    testing::assert_eq(text::trim_start("  left"), "left");
    testing::assert_eq(text::trim_end("right  "), "right");
    let parts = text::split("a::b::", "::");
    testing::assert_eq(parts.len(), 3);
    testing::assert_eq(parts.get(0), "a");
    testing::assert_eq(parts.get(1), "b");
    testing::assert_eq(parts.get(2), "");
    match text::split_once("key=value=tail", "=") {
        Option::Some((left, right)) => {
            testing::assert_eq(left, "key");
            testing::assert_eq(right, "value=tail")
        },
        Option::None => testing::fail("split_once failed"),
    };
    let lines = text::lines("first\r\nsecond\n");
    testing::assert_eq(lines.len(), 2);
    testing::assert_eq(lines.get(0), "first");
    testing::assert_eq(lines.get(1), "second");
    testing::assert_eq(text::find("éclair", "c").unwrap_or(-1), 2);
    testing::assert(text::starts_with_at("éclair", 2, "c"));
    testing::assert(!text::starts_with_at("éclair", 1, "c"));
    testing::assert_eq(text::rfind("a::语言::z", "::").unwrap_or(-1), 9);
    testing::assert_eq(text::rfind("语言", "").unwrap_or(-1), 6);
    testing::assert(text::rfind("语言", "rust").is_none());
    testing::assert_eq(text::replace("a-b-a", "a", "xy"), "xy-b-xy");
    testing::assert_eq(text::join(Vec::from_array(["a", "b", "c"]), ","), "a,b,c");
    testing::assert_eq(text::repeat("ab", 3), "ababab");
    testing::assert(text::is_ascii("ascii"));
    testing::assert(text::is_ascii("é") == false);
    testing::assert_eq(text::to_ascii_lowercase("A-É-Z"), "a-É-z");
    testing::assert_eq(text::to_ascii_uppercase("a-é-z"), "A-é-Z");
    testing::assert(text::eq_ignore_ascii_case("Content-Length", "content-length"));
    testing::assert(!text::eq_ignore_ascii_case("É", "é"));
    testing::assert(!text::eq_ignore_ascii_case("short", "longer"))
}

fn assert_ascii() -> () {
    testing::assert(ascii::is_ascii(127));
    testing::assert(!ascii::is_ascii(128));
    testing::assert(ascii::is_alphabetic(b'A'));
    testing::assert(ascii::is_alphabetic(b'z'));
    testing::assert(ascii::is_uppercase(b'Z'));
    testing::assert(ascii::is_lowercase(b'a'));
    testing::assert(ascii::is_alphanumeric(b'7'));
    testing::assert(ascii::is_digit(b'0'));
    testing::assert(!ascii::is_digit(b'a'));
    testing::assert(ascii::is_hexdigit(b'F'));
    testing::assert(ascii::is_hexdigit(b'f'));
    testing::assert(!ascii::is_hexdigit(b'g'));
    testing::assert(ascii::is_whitespace(b'\x0B'));
    testing::assert(ascii::is_control(0));
    testing::assert(ascii::is_control(127));
    testing::assert(!ascii::is_control(b' '));
    testing::assert(ascii::is_graphic(b'!'));
    testing::assert(!ascii::is_graphic(b' '));
    testing::assert(ascii::is_punctuation(b'!'));
    testing::assert(!ascii::is_punctuation(b'A'));
    testing::assert_eq(ascii::to_lowercase(b'A'), b'a');
    testing::assert_eq(ascii::to_uppercase(b'z'), b'Z');
    testing::assert_eq(ascii::to_lowercase(b'\xFF'), b'\xFF');
    testing::assert(ascii::eq_ignore_case(b'A', b'a'));
    testing::assert(!ascii::eq_ignore_case(b'A', b'b'));
    testing::assert_eq(ascii::escape_default(b'A'), "A");
    testing::assert_eq(ascii::escape_default(b'\t'), "\\t");
    testing::assert_eq(ascii::escape_default(39), "\\'");
    testing::assert_eq(ascii::escape_default(34), "\\\"");
    testing::assert_eq(ascii::escape_default(92), "\\\\");
    testing::assert_eq(ascii::escape_default(0), "\\x00");
    testing::assert_eq(ascii::escape_default(255), "\\xff")
}

fn assert_num() -> () {
    testing::assert_eq(unwrap_int(num::parse_int_structured("-42")), -42);
    testing::assert_eq(unwrap_int(num::parse_int_radix_structured("ff", 16)), 255);
    testing::assert_eq(unwrap_int(num::parse_int_radix_structured("0xff", 0)), 255);
    testing::assert_eq(unwrap_int(num::parse_int_structured("-9223372036854775808")), -9223372036854775807 - 1);
    testing::assert_eq(unwrap_uint(num::parse_uint_structured("42")), 42);
    testing::assert_eq(unwrap_uint(num::parse_uint_radix_structured("101", 2)), 5);
    testing::assert_eq(unwrap_uint(num::parse_uint_structured("18446744073709551615")), 18446744073709551615);
    testing::assert_eq(unwrap_float32(num::parse_float32_structured("1.5")), 1.5);
    testing::assert_eq(unwrap_float64(num::parse_float64_structured("-2.25e2")), -225.0);
    testing::assert_eq(unwrap_float64(num::parse_float64_structured("0x1.8p+1")), 3.0);
    testing::assert(num::parse_int_structured("bad").is_err());
    testing::assert(num::parse_int_radix_structured("10", 1).is_err());
    testing::assert(num::parse_int_structured("9223372036854775808").is_err());
    testing::assert(num::parse_uint_structured("18446744073709551616").is_err());
    testing::assert(num::parse_float64_structured("1e309").is_err());
    testing::assert_eq(unwrap_float64(num::parse_float64_structured("1e-400")), 0.0)
}

fn assert_option_result() -> () {
    let some: Option[isize] = Option::Some(3);
    let none: Option[isize] = Option::None;
    testing::assert(some.is_some());
    testing::assert(none.is_none());
    testing::assert_eq(some.unwrap_or(0), 3);
    testing::assert_eq(none.unwrap_or_else(|| 7), 7);
    testing::assert_eq(some.map(|value: isize| value + 1).unwrap_or(0), 4);
    testing::assert_eq(some.and_then(|value: isize| Option::Some(value * 2)).unwrap_or(0), 6);
    let converted: Result[isize, string] = none.ok_or("missing");
    testing::assert(converted.is_err());
    let ok: Result[isize, string] = Result::Ok(5);
    testing::assert(ok.is_ok());
    testing::assert_eq(ok.unwrap_or(0), 5);
    testing::assert_eq(ok.map(|value: isize| value + 2).unwrap_or(0), 7);
    let failed: Result[isize, string] = Result::Err("bad");
    testing::assert_eq(
        failed.map_err(|error: string| error + "!").unwrap_or_else(
            |error: string| if error == "bad!" {
                9
            } else {
                0
            },
        ),
        9,
    );
    testing::assert_eq(ok.and_then(|value: isize| Result::Ok(value * 3)).unwrap_or(0), 15)
}

fn assert_iterators() -> () {
    let values = Vec::from_array([10, 20, 30, 40]);
    let empty_values: FnIterator[isize] = iter::empty();
    testing::assert(Iterator::next(empty_values).is_none());
    let once_value = iter::once(7);
    testing::assert_eq(Iterator::next(once_value).unwrap_or(0), 7);
    testing::assert(Iterator::next(once_value).is_none());
    let generated_index = Ref::new(0);
    let generated = iter::from_fn(
        || {
            let index = generated_index.get();
            if index < 2 {
                generated_index.set(index + 1);
                Option::Some(index + 5)
            } else {
                Option::None
            }
        },
    );
    testing::assert_eq(iter::collect(generated).get(1), 6);
    let mapped = iter::map(values.iter(), |value: isize| value + 1);
    let filtered = iter::filter(mapped, |value: isize| value > 20);
    let limited = iter::take(filtered, 2);
    let collected: Vec[isize] = iter::collect(limited);
    testing::assert_eq(collected.len(), 2);
    testing::assert_eq(collected.get(0), 21);
    testing::assert_eq(collected.get(1), 31);
    let filtered_mapped = iter::filter_map(
        values.iter(),
        |value: isize| if value >= 30 {
            Option::Some(value / 10)
        } else {
            Option::None
        },
    );
    testing::assert_eq(iter::collect(filtered_mapped).get(0), 3);
    let taken: Vec[isize] = iter::collect(
        iter::take_while(values.iter(), |value: isize| value < 30),
    );
    testing::assert_eq(taken.len(), 2);
    let skipped: Vec[isize] = iter::collect(
        iter::skip_while(values.iter(), |value: isize| value < 30),
    );
    testing::assert_eq(skipped.get(0), 30);
    testing::assert_eq(Iterator::next(iter::skip(values.iter(), 2)).unwrap_or(0), 30);
    let enumerated = iter::enumerate(values.iter());
    match Iterator::next(enumerated) {
        Option::Some((index, value)) => {
            testing::assert_eq(index, 0);
            testing::assert_eq(value, 10)
        },
        Option::None => testing::fail("enumerate failed"),
    };
    let zipped = iter::zip(Vec::from_array([1, 2]).iter(), Vec::from_array([3, 4]).iter());
    match Iterator::next(zipped) {
        Option::Some((left, right)) => {
            testing::assert_eq(left, 1);
            testing::assert_eq(right, 3)
        },
        Option::None => testing::fail("zip failed"),
    };
    let chained: Vec[isize] = iter::collect(
        iter::chain(Vec::from_array([1, 2]).iter(), Vec::from_array([3, 4]).iter()),
    );
    testing::assert_eq(chained.len(), 4);
    testing::assert_eq(chained.get(3), 4);
    testing::assert_eq(iter::find(values.iter(), |value: isize| value > 20).unwrap_or(0), 30);
    testing::assert_eq(
        iter::find_map(
            values.iter(),
            |value: isize| if value == 20 {
                Option::Some("found")
            } else {
                Option::None
            },
        ).unwrap_or(""),
        "found",
    );
    testing::assert(iter::any(values.iter(), |value: isize| value == 20));
    testing::assert(iter::all(values.iter(), |value: isize| value >= 10));
    testing::assert_eq(iter::count(values.iter()), 4);
    testing::assert_eq(iter::fold(values.iter(), 0, |sum: isize, value: isize| sum + value), 100);
    testing::assert_eq(iter::position(values.iter(), |value: isize| value == 30).unwrap_or(-1), 2);
    testing::assert_eq(iter::nth(values.iter(), 2).unwrap_or(0), 30);
    testing::assert(iter::nth(values.iter(), -1).is_none());
    testing::assert_eq(iter::last(values.iter()).unwrap_or(0), 40);
    testing::assert_eq(
        iter::reduce(values.iter(), |left: isize, right: isize| left + right).unwrap_or(0),
        100,
    );
    let inspected_sum = Ref::new(0);
    let inspected = iter::inspect(
        values.iter(),
        |value: isize| inspected_sum.set(inspected_sum.get() + value),
    );
    testing::assert_eq(iter::count(inspected), 4);
    testing::assert_eq(inspected_sum.get(), 100);
    let each_sum = Ref::new(0);
    iter::for_each(values.iter(), |value: isize| each_sum.set(each_sum.get() + value));
    testing::assert_eq(each_sum.get(), 100);
    let while_mapped: Vec[isize] = iter::collect(
        iter::map_while(
            values.iter(),
            |value: isize| if value < 30 {
                Option::Some(value / 10)
            } else {
                Option::None
            },
        ),
    );
    testing::assert_eq(while_mapped.len(), 2);
    testing::assert_eq(while_mapped.get(1), 2)
}

fn assert_collections() -> () {
    let values = Vec::from_array([4, 1, 3, 2, 2]);
    collections::stable_sort_by(values, compare_int);
    testing::assert_eq(values.get(0), 1);
    testing::assert_eq(values.get(4), 4);
    match collections::binary_search_by(values, |value: isize| compare_int(value, 3)) {
        Option::Some(index) => testing::assert_eq(values.get(index), 3),
        Option::None => testing::fail("binary search failed"),
    };
    testing::assert(values.contains(4));
    testing::assert_eq(collections::position_by(values, |value: isize| value == 2).unwrap_or(-1), 1);
    testing::assert_eq(collections::min_by(values, compare_int).unwrap_or(0), 1);
    testing::assert_eq(collections::max_by(values, compare_int).unwrap_or(0), 4);
    collections::dedup(values);
    testing::assert_eq(values.len(), 4);
    testing::assert_eq(values.get(0), 1);
    testing::assert_eq(values.get(3), 4)
}

fn assert_comparison() -> () {
    testing::assert(cmp::compare(1, 2).is_lt());
    testing::assert(cmp::compare("same", "same").is_eq());
    testing::assert(cmp::compare(true, false).is_gt());
    testing::assert_eq(cmp::Ordering::from_int(-9).to_isize(), -1);
    testing::assert(cmp::Ordering::Less.reverse().is_gt());
    testing::assert(cmp::Ordering::Equal.then(cmp::Ordering::Greater).is_gt());
    testing::assert(cmp::Ordering::Equal.then_with(|| cmp::Ordering::Less).is_lt());
    testing::assert_eq(cmp::min(4, 2), 2);
    testing::assert_eq(cmp::max(4, 2), 4);
    testing::assert_eq(cmp::min_by_key("long", "x", |value: string| value.byte_len()), "x");
    testing::assert_eq(cmp::max_by_key("long", "x", |value: string| value.byte_len()), "long");
    testing::assert_eq(cmp::clamp(9, 1, 5).unwrap_or(0), 5);
    testing::assert(cmp::clamp(3, 5, 1).is_err());
    let reversed = cmp::Reverse::new(3);
    testing::assert(cmp::compare(reversed, cmp::Reverse::new(2)).is_lt());
    testing::assert_eq(reversed.into_inner(), 3);
    let values = Vec::from_array([4, 1, 3, 2, 2]);
    collections::stable_sort(values);
    testing::assert_eq(values[0], 1);
    testing::assert_eq(values[4], 4);
    testing::assert_eq(collections::binary_search(values, 3).unwrap_or(-1), 3);
    testing::assert_eq(collections::min(values).unwrap_or(0), 1);
    testing::assert_eq(collections::max(values).unwrap_or(0), 4);
    collections::sort_by_ordering(values, |left: isize, right: isize| cmp::compare(right, left));
    testing::assert_eq(values[0], 4);
    testing::assert_eq(values[4], 1)
}

fn assert_time() -> () {
    let one_millisecond = time::Duration::from_milliseconds(1);
    testing::assert_eq(one_millisecond.as_microseconds(), 1000);
    testing::assert_eq(one_millisecond.add(one_millisecond).as_milliseconds(), 2);
    testing::assert_eq(
        one_millisecond.subtract(time::Duration::from_seconds(1)).as_nanoseconds(),
        0,
    );
    let started = time::Instant::now();
    time::sleep(one_millisecond);
    testing::assert(started.elapsed().as_nanoseconds() >= 0);
    testing::assert(time::SystemTime::now().unix_seconds() > 0)
}

fn main() -> () {
    assert_text();
    assert_ascii();
    assert_num();
    assert_option_result();
    assert_iterators();
    assert_collections();
    assert_comparison();
    assert_time();
    println("stdlib practical ok")
}
