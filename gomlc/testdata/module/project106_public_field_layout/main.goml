package main;

use module::model;

fn read[T](entry: model::Entry[T]) -> T {
    entry.value
}

fn main() -> () {
    let entry = model::entry(42);
    println(entry.name);
    println(read(entry));
    let model::Entry { name, value, .. } = entry;
    println(name);
    println(value);
    let captured = || entry.value;
    println(captured());
}
