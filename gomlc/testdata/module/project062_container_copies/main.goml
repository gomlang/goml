package main;

use std::collections;

fn main() -> () {
    let values = Vec::from_array([1, 2, 3]);
    let copied = values.copy();
    copied.set(0, 9);
    println(values[0]);
    println(copied[0]);
    let slice_copy = values.slice(1, 3).to_vec();
    slice_copy.set(0, 8);
    println(values[1]);
    println(slice_copy[0]);
    let seen: collections::HashSet[string] = collections::HashSet::new();
    seen.insert("beta");
    seen.insert("alpha");
    let keys = seen.to_vec();
    collections::sort(keys);
    for key in keys {
        println(key)
    }
}
