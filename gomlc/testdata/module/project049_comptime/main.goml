package main;

use project049_comptime::calc;

const ANSWER: isize = calc::calculate(10);

fn main() -> () {
    println(ANSWER);
    let pair = comptime {
        calc::make_pair(3)
    };
    println(pair.left);
    println(pair.right);
    let choice = comptime {
        calc::make_choice(9)
    };
    match choice {
        calc::Choice::Value(value) => println(value),
        calc::Choice::Empty => println(0),
    };
    println(
        comptime {
            calc::PUBLISHED
        },
    );
    println(calc::calculate(2))
}
