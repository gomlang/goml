package api;

pub const ANSWER: isize = 42;

pub type Label = string;

pub struct Box {
    pub value: isize,
}

pub enum Choice {
    Yes,
    No,
}

pub trait Describe {
    fn describe(self) -> string;
}

impl Describe for Box {
    fn describe(self: Box) -> string {
        self.value.to_string()
    }
}

pub fn make(value: isize) -> Box {
    Box { value }
}
