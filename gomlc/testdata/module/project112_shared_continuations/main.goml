package main;

use std::panic;
use std::testing;

fn check(failure: isize, stage: isize, log: Vec[isize]) -> Result[(), string] {
    log.push(stage);
    if failure == stage {
        Err(stage.to_string())
    } else {
        Ok(())
    }
}

fn work(mask: isize, failure: isize, log: Vec[isize]) -> Result[isize, string] {
    defer log.push(999);
    if mask & 1 != 0 {
        check(failure, 0, log)?;
    }
    if mask & 2 != 0 {
        check(failure, 1, log)?;
    }
    if mask & 4 != 0 {
        check(failure, 2, log)?;
    }
    if mask & 8 != 0 {
        check(failure, 3, log)?;
    }
    defer log.push(900);
    for index in 0..3 {
        defer log.push(100 + index);
        if index == 1 {
            continue;
        }
        log.push(10 + index);
    }
    check(failure, 4, log)?;
    Ok(7)
}

fn small(active: bool, fail: bool, log: Vec[isize]) -> isize {
    match active {
        true => {
            if fail {
                return 3
            }
        },
        false => (),
    }
    match active {
        true => {
            if fail {
                return 5
            }
        },
        false => (),
    }
    log.push(7);
    11
}

fn nested(active: bool, log: Vec[isize]) -> isize {
    let mut result = 0;
    'outer: for outer in 0..3 {
        defer log.push(outer + 100);
        for inner in 0..3 {
            defer log.push(inner + 200);
            if active {
                if inner == 1 {
                    continue 'outer;
                }
            }
            if !active {
                if outer == 1 {
                    break 'outer;
                }
            }
            result += small(active, false, log);
        }
    };
    result
}

fn panicking(active: bool, log: Vec[isize]) -> () {
    defer log.push(1);
    if active {
        if small(true, false, log) == 0 {
            return
        }
    }
    if active {
        if small(false, false, log) == 0 {
            return
        }
    }
    defer {
        log.push(2);
        panic::raise("cleanup");
    };
    defer log.push(3);
    panic::raise("body")
}

fn independent_returns(first: bool, second: bool, log: Vec[isize]) -> isize {
    if first {
        return 3
    }
    if second {
        return 5
    }
    log.push(7);
    11
}

struct PairState {
    left: isize,
    right: isize,
}

fn nested_values(first: bool, second: bool, early: bool) -> ((isize, isize), PairState) {
    let pair = if first {
        if early {
            return ((-1, -2), PairState { left: -3, right: -4 })
        };
        (2, 3)
    } else {
        (5, 7)
    };
    let state = if second {
        let nested = if first {
            (11, 13)
        } else {
            if early {
                return ((-5, -6), PairState { left: -7, right: -8 })
            };
            (17, 19)
        };
        PairState { left: pair.0 + nested.0, right: pair.1 + nested.1 }
    } else {
        PairState { left: pair.0 * 2, right: pair.1 * 3 }
    };
    (pair, state)
}

fn loop_assignments(mode: isize, log: Vec[isize]) -> (isize, isize) {
    let mut total = 0;
    let mut assigned = 0;
    'outer: for outer in 0..3 {
        for inner in 0..3 {
            let value = if inner == 1 {
                if mode == 0 {
                    assigned = outer * 10 + inner;
                    total += 100;
                    log.push(assigned);
                    continue;
                };
                (outer * 10 + inner, 2)
            } else {
                (outer * 10 + inner, 3)
            };
            let state = if outer == 1 {
                if mode == 1 {
                    assigned = value.0 + 1000;
                    total += 200;
                    log.push(assigned);
                    continue 'outer;
                }
                PairState { left: value.0, right: value.1 }
            } else {
                PairState { left: value.0, right: value.1 * 2 }
            };
            if outer == 2 {
                if mode == 2 {
                    assigned = state.left + 2000;
                    total += 300;
                    log.push(assigned);
                    break 'outer;
                }
            }
            assigned = state.left;
            total += state.left + state.right;
            log.push(assigned);
        }
    };
    (total, assigned)
}

fn assert_pair(actual: (isize, isize), expected: (isize, isize)) -> () {
    testing::assert_eq(actual.0, expected.0);
    testing::assert_eq(actual.1, expected.1);
}

fn additional_paths() -> () {
    for first in[false, true] {
        for second in[false, true] {
            let log: Vec[isize] = Vec::new();
            testing::assert_eq(
                independent_returns(first, second, log),
                if first {
                    3
                } else if second {
                    5
                } else {
                    11
                },
            );
            testing::assert_eq(
                log.len(),
                if first || second {
                    0
                } else {
                    1
                },
            );
            for early in[false, true] {
                let (pair, state) = nested_values(first, second, early);
                if first && early {
                    assert_pair(pair, (-1, -2));
                    assert_pair((state.left, state.right), (-3, -4));
                } else if !first && second && early {
                    assert_pair(pair, (-5, -6));
                    assert_pair((state.left, state.right), (-7, -8));
                } else {
                    let expected = if first {
                        (2, 3)
                    } else {
                        (5, 7)
                    };
                    assert_pair(pair, expected);
                    let extra = if first {
                        (11, 13)
                    } else {
                        (17, 19)
                    };
                    assert_pair(
                        (state.left, state.right),
                        if second {
                            (expected.0 + extra.0, expected.1 + extra.1)
                        } else {
                            (expected.0 * 2, expected.1 * 3)
                        },
                    );
                }
            }
        }
    }
    let log: Vec[isize] = Vec::new();
    assert_pair(loop_assignments(0, log), (396, 22));
    testing::assert(log == Vec::from_array([0, 1, 2, 10, 11, 12, 20, 21, 22]));
    log.clear();
    assert_pair(loop_assignments(1, log), (298, 22));
    testing::assert(log == Vec::from_array([0, 1, 2, 1010, 20, 21, 22]));
    log.clear();
    assert_pair(loop_assignments(2, log), (360, 2020));
    testing::assert(log == Vec::from_array([0, 1, 2, 10, 11, 12, 2020]));
}

fn main() -> () {
    additional_paths();
    for mask in 0..16 {
        for failure in -1..5 {
            let log: Vec[isize] = Vec::new();
            let outcome = work(mask, failure, log);
            let expected: Vec[isize] = Vec::new();
            let mut error: Option[isize] = None;
            for stage in 0..4 {
                if mask & (1 << stage) != 0 && error.is_none() {
                    expected.push(stage);
                    if failure == stage {
                        error = Some(stage);
                    }
                }
            }
            if error.is_none() {
                for item in[10, 100, 101, 12, 102, 4, 900] {
                    expected.push(item);
                }
                if failure == 4 {
                    error = Some(4);
                }
            }
            expected.push(999);
            testing::assert(log == expected);
            match error {
                Some(stage) => testing::assert(outcome == Result::Err(stage.to_string())),
                None => testing::assert(outcome == Result::Ok(7)),
            }
        }
    }
    for active in[false, true] {
        let log: Vec[isize] = Vec::new();
        testing::assert_eq(
            small(active, true, log),
            if active {
                3
            } else {
                11
            },
        );
        testing::assert_eq(
            log.len(),
            if active {
                0
            } else {
                1
            },
        );
        log.clear();
        testing::assert_eq(nested(active, log), 33);
        testing::assert(
            log
                == if active {
                    Vec::from_array([7, 200, 201, 100, 7, 200, 201, 101, 7, 200, 201, 102])
                } else {
                    Vec::from_array([7, 200, 7, 201, 7, 202, 100, 200, 101])
                },
        );
    }
    let log: Vec[isize] = Vec::new();
    let caught = panic::catch(|| panicking(true, log));
    testing::assert_eq(testing::expect_err(caught, "panic expected").message(), "cleanup");
    testing::assert(log == Vec::from_array([7, 7, 3, 2, 1]));
    println("shared continuations preserve exits and cleanup");
}
