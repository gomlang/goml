package main;

use std::bytes;
use std::crypto::hash as crypto_hash;
use std::encoding::hex;
use std::fs;
use std::hash as standard_hash;
use standard_hash::Hasher;
use std::testing;

#[go_ffi("example.com/goml-std-sha2/native", "Sum224")]
extern fn go_sum224(value: Slice[byte]) -> string;

#[go_ffi("example.com/goml-std-sha2/native", "Sum256")]
extern fn go_sum256(value: Slice[byte]) -> string;

#[go_ffi("example.com/goml-std-sha2/native", "Sum384")]
extern fn go_sum384(value: Slice[byte]) -> string;

#[go_ffi("example.com/goml-std-sha2/native", "Sum512")]
extern fn go_sum512(value: Slice[byte]) -> string;

#[go_ffi("example.com/goml-std-sha2/native", "Sum512_224")]
extern fn go_sum512_224(value: Slice[byte]) -> string;

#[go_ffi("example.com/goml-std-sha2/native", "Sum512_256")]
extern fn go_sum512_256(value: Slice[byte]) -> string;

fn check_one_shot(value: bytes::Bytes) -> () {
    let input = value.as_slice();
    testing::assert_eq(crypto_hash::sha224(value), go_sum224(input));
    testing::assert_eq(crypto_hash::sha256(value), go_sum256(input));
    testing::assert_eq(crypto_hash::sha384(value), go_sum384(input));
    testing::assert_eq(crypto_hash::sha512(value), go_sum512(input));
    testing::assert_eq(crypto_hash::sha512_224(value), go_sum512_224(input));
    testing::assert_eq(crypto_hash::sha512_256(value), go_sum512_256(input));
}

fn check_vectors() -> () {
    let empty = bytes::Bytes::new();
    testing::assert_eq(
        crypto_hash::sha256(empty),
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
    );
    testing::assert_eq(
        crypto_hash::sha512_224(empty),
        "6ed0dd02806fa89e25de060c19d3ac86cabb87d6a0ddd05c333b84f4",
    );
    let abc = bytes::Bytes::from_string("abc");
    testing::assert_eq(
        crypto_hash::sha224(abc),
        "23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7",
    );
    testing::assert_eq(
        crypto_hash::sha256(abc),
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
    );
    testing::assert_eq(
        crypto_hash::sha384(abc),
        "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7",
    );
    testing::assert_eq(
        crypto_hash::sha512(abc),
        "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f",
    );
    testing::assert_eq(
        crypto_hash::sha512_224(abc),
        "4634270f707b6a54daae7530460842e20e37ed265ceee9a43e8924aa",
    );
    testing::assert_eq(
        crypto_hash::sha512_256(abc),
        "53048e2681941ef99b2e29b76b4c7dabe4c2d0c634fc6d46e0e2f13107e7af23",
    );
}

fn check_incremental(value: bytes::Bytes) -> () {
    let midpoint = value.len() / 2;
    let first = value.slice(0, midpoint);
    let second = value.slice(midpoint, value.len());
    let sha224 = crypto_hash::Sha256Digest::new224();
    let sha256 = crypto_hash::Sha256Digest::new256();
    let sha384 = crypto_hash::Sha512Digest::new384();
    let sha512 = crypto_hash::Sha512Digest::new512();
    let sha512_224 = crypto_hash::Sha512Digest::new512_224();
    let sha512_256 = crypto_hash::Sha512Digest::new512_256();
    sha224.update(first);
    sha256.update(first);
    sha384.update(first);
    sha512.update(first);
    sha512_224.update(first);
    sha512_256.update(first);
    testing::assert_eq(hex::encode(sha256.sum()), go_sum256(first));
    testing::assert_eq(sha256.sum().len(), 32);
    let independent = sha256.copy();
    independent.update(bytes::Bytes::from_string("!").as_slice());
    sha224.update(second);
    sha256.update(second);
    sha384.update(second);
    sha512.update(second);
    sha512_224.update(second);
    sha512_256.update(second);
    testing::assert_eq(crypto_hash::sha224(value), go_sum224(value.as_slice()));
    testing::assert_eq(hex::encode(sha224.sum()), go_sum224(value.as_slice()));
    testing::assert_eq(sha256.sum().len(), sha256.size());
    testing::assert_eq(sha224.size(), 28);
    testing::assert_eq(sha256.block_size(), 64);
    testing::assert_eq(sha384.size(), 48);
    testing::assert_eq(sha512.size(), 64);
    testing::assert_eq(sha512.block_size(), 128);
    testing::assert_eq(sha512_224.size(), 28);
    testing::assert_eq(sha512_256.size(), 32);
    testing::assert(hex::encode(independent.sum()) != hex::encode(sha256.sum()));
    let digest_values = Vec::from_array(
        [
            (sha224.sum(), go_sum224(value.as_slice())),
            (sha256.sum(), go_sum256(value.as_slice())),
            (sha384.sum(), go_sum384(value.as_slice())),
            (sha512.sum(), go_sum512(value.as_slice())),
            (sha512_224.sum(), go_sum512_224(value.as_slice())),
            (sha512_256.sum(), go_sum512_256(value.as_slice())),
        ],
    );
    for (actual, expected) in digest_values {
        testing::assert_eq(hex::encode(actual), expected)
    }
    sha256.reset();
    testing::assert_eq(hex::encode(sha256.sum()), go_sum256(bytes::Bytes::new().as_slice()));
    sha512.reset();
    testing::assert_eq(hex::encode(sha512.sum()), go_sum512(bytes::Bytes::new().as_slice()));
}

fn check_file() -> () {
    let path = "_artifact/sha2-file.bin";
    let content = bytes::Bytes::from_vec(Vec::from_array([0, 1, 2, 255]));
    testing::expect_ok(fs::write_bytes_structured(path, content), "write SHA-2 fixture");
    testing::assert_eq(
        testing::expect_ok(crypto_hash::sha256_file(path), "hash file"),
        crypto_hash::sha256(content),
    );
    testing::assert(crypto_hash::sha256_file("missing-sha2-file").is_err());
}

fn main() -> () {
    check_vectors();
    let sizes = Vec::from_array(
        [0, 1, 3, 55, 56, 63, 64, 65, 111, 112, 127, 128, 129, 255, 256, 513],
    );
    for length in sizes {
        let data = bytes::Bytes::with_capacity(length);
        for index in 0..length {
            data.push(((index * 37 + 11) % 256).to_u8())
        }
        check_one_shot(data);
        check_incremental(data);
    }
    check_file();
    println("pure SHA-2 ok")
}
