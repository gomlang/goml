enum Shape {
    Circle(f64),
    Rect(f64, f64),
    Triangle(f64, f64, f64),
}

fn area(s: Shape) -> f64 {
    match s {
        Shape::Circle(r) => 3.14159 * r * r,
        Shape::Rect(w, h) => w * h,
        Shape::Triangle(a, b, _c, _d) => 0.5 * a * b,
    }
}

fn main() {
    let s = Shape::Triangle(6.0, 8.0, 10.0);
    println(area(s).to_string());
}
