trait Callable {
    fn call(self: Self, arg1: i32) -> i32;
}

impl Callable for (i32) -> i32 {
    fn call(self: (i32) -> i32, x: i32) -> i32 {
        self(x)
    }
}

fn apply_callable(c: dyn Callable, n: i32) -> i32 {
    Callable::call(c, n)
}

fn main() {
    let f: (i32) -> i32 = |x| x + 1;
    let _ = println(apply_callable(f as dyn Callable, 10));
    let g = |x: i32| x * 3;
    let _ = println(apply_callable(g as dyn Callable, 10));
}
