trait Printable {
    fn to_str(self: Self) -> string;
}

impl Printable for i32 {
    fn to_str(self: i32) -> string {
        self.to_string()
    }
}

impl Printable for string {
    fn to_str(self: string) -> string {
        self
    }
}

impl Printable for bool {
    fn to_str(self: bool) -> string {
        if self {
            "true"
        } else {
            "false"
        }
    }
}

fn join_all(items: Vec[dyn Printable], sep: string) -> string {
    let result = Ref::new("");
    let i = Ref::new(0);
    while i.get() < items.len() {
        if i.get() > 0 {
            result.set(result.get() + sep);
        } else {};
        result.set(result.get() + Printable::to_str(items[i.get()]));
        i.set(i.get() + 1);
    }
    result.get()
}

fn main() {
    let v: Vec[dyn Printable] = Vec::new();
    v.push(42 as dyn Printable);
    v.push("hello" as dyn Printable);
    v.push(true as dyn Printable);
    let _ = println(join_all(v, ", "));
}
