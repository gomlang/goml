struct EventHandler {
    on_start: () -> (),
    on_data: (i32) -> (),
    on_end: () -> (),
}

fn run_pipeline(handler: EventHandler, data: [i32; 3]) {
    handler.on_start();
    let i = Ref::new(0);
    while i.get() < 3 {
        handler.on_data(data[i.get()]);
        i.set(i.get() + 1);
    };
    handler.on_end();
}

fn make_handler() -> EventHandler {
    let sum = Ref::new(0);
    EventHandler {
        on_start: || println("Starting"),
        on_data: |x| {
            sum.set(sum.get() + x);
            println("Got: " + x.to_string());
        },
        on_end: || println("Sum: " + sum.get().to_string()),
    }
}

fn main() {
    let h = make_handler();
    run_pipeline(h, [10, 20, 30]);
}
