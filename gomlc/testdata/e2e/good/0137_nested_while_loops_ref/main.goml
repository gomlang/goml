fn main() {
    let x = Ref::new(0);
    let y = Ref::new(0);
    while x.get() < 5 {
        y.set(0);
        while y.get() < 3 {
            println((x.get() * 3 + y.get()).to_string());
            println(" ");
            y.set(y.get() + 1);
        };
        println("");
        x.set(x.get() + 1);
    };
}
