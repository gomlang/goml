fn main() {
    let a: i8 = 42;
    let b: i16 = 1000;
    let c: i32 = 100000;
    let d: i64 = 10000000;
    let e: u8 = 200;
    let f: u16 = 50000;
    let g: u32 = 3000000;
    let h: u64 = 9000000000;
    println(a.to_string());
    println(b.to_string());
    println(c.to_string());
    println(d.to_string());
    println(e.to_string());
    println(f.to_string());
    println(g.to_string());
    println(h.to_string());
}
