struct Counter {
    count: Ref[i32],
}

fn new_counter() -> Counter {
    Counter { count: Ref::new(0) }
}

fn increment(c: Counter) -> i32 {
    let v = c.count.get() + 1;
    c.count.set(v);
    v
}

fn main() {
    let c = new_counter();
    println(increment(c).to_string());
    println(increment(c).to_string());
    println(increment(c).to_string());
}
