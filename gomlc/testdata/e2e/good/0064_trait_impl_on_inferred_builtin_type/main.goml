trait Container {
    fn size(self: Self) -> isize;
    fn is_empty(self: Self) -> bool;
}

impl Container for Vec[isize] {
    fn size(self: Vec[isize]) -> isize { self.len() }
    fn is_empty(self: Vec[isize]) -> bool { self.len() == 0 }
}

fn main() {
    let v = Vec::new();
    v.push(1);
    v.push(2);
    let _ = println(v.is_empty());
    let _ = println(v.size());
    let _ = println(Container::size(v));
}
