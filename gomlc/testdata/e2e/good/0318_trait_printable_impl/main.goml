trait Printable {
    fn print_it(self: Self) -> ();
}

struct Pair[A, B] {
    first: A,
    second: B,
}

impl Printable for Pair[isize, string] {
    fn print_it(self: Pair[isize, string]) -> () {
        println(self.first.to_string() + ": " + self.second);
    }
}

fn main() {
    let p = Pair { first: 42, second: "answer" };
    Printable::print_it(p);
}
