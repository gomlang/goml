fn main() {
    let mut total = 0;
    let add = |x: i32| {
        total = total + x;
        total
    };

    let mut i = 0;
    while i < 5 {
        if i < 3 {
            let _ = add(i);
        } else {
            let _ = add(i + 1);
        };
        i = i + 1;
    };

    println(total.to_string());
    println(add(3).to_string());
}
