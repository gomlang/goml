fn main() {
    let x: u8 = 10;
    let y: u8 = 20;
    let z: u8 = x + y;
    println(z.to_string());
    
    let a: i64 = 1000000;
    let b: i64 = 2000000;
    let c: i64 = a + b;
    println(c.to_string());
    
    let d: f32 = 1.5;
    let e: f32 = 2.5;
    let f: f32 = d + e;
    println(f.to_string());
}
