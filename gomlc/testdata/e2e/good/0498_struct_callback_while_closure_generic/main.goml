struct Callback {
    handler: (string) -> string,
}

fn make_callbacks() -> Vec[Callback] {
    let v = Vec::new();
    v.push(Callback { handler: |s| s + " world" });
    v.push(Callback { handler: |s| s + "!" });
    v
}

fn chain(cbs: Vec[Callback], input: string) -> string {
    let result = Ref::new(input);
    let i = Ref::new(0);
    while i.get() < cbs.len() {
        let cb = cbs[i.get()];
        result.set(cb.handler(result.get()));
        i.set(i.get() + 1);
    };
    result.get()
}

fn main() {
    let cbs = make_callbacks();
    let result = chain(cbs, "hello");
    println(result);
}
