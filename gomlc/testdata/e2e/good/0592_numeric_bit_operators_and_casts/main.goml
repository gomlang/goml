fn main() -> () {
    let byte: u8 = 240;
    println(byte & 15);
    println(byte | 15);
    println(byte ^ 255);
    println(1 << 7);
    println(byte >> 4);
    println(~byte);
    println(-13 % 5);
    println(511.to_u8());
    println(-1.to_u8());
    println(('A'.to_u32()).to_string());
    match char_from_u32(128512) {
        Option::Some(value) => println(value.to_string()),
        Option::None => println("invalid"),
    }
}
