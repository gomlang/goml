trait Reducer {
    fn reduce(self: Self, arg1: i32, arg2: i32) -> i32;
}

struct SumReducer {}

struct MaxReducer {}

impl Reducer for SumReducer {
    fn reduce(self: SumReducer, acc: i32, x: i32) -> i32 {
        acc + x
    }
}

impl Reducer for MaxReducer {
    fn reduce(self: MaxReducer, acc: i32, x: i32) -> i32 {
        if x > acc {
            x
        } else {
            acc
        }
    }
}

fn fold_array(r: dyn Reducer, items: [i32; 5], init: i32) -> i32 {
    let acc = Ref::new(init);
    let i = Ref::new(0);
    while i.get() < 5 {
        acc.set(Reducer::reduce(r, acc.get(), items[i.get()]));
        i.set(i.get() + 1);
    }
    acc.get()
}

fn main() {
    let data = [3, 1, 4, 1, 5];
    let sum_r: dyn Reducer = SumReducer {} as dyn Reducer;
    println(fold_array(sum_r, data, 0).to_string());
    let max_r: dyn Reducer = MaxReducer {} as dyn Reducer;
    println(fold_array(max_r, data, 0).to_string());
}
