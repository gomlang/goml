fn first_gt_two(limit: i32) -> i32 {
    let i = Ref::new(0);
    while i.get() < limit {
        if i.get() > 2 {
            return i.get()
        } else {
            ()
        };
        i.set(i.get() + 1);
    };
    -1
}

fn main() {
    println(first_gt_two(10).to_string());
    println(first_gt_two(2).to_string());
}
