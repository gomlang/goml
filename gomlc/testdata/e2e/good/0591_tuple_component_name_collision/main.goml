struct A_B {
    value: i32,
}

struct C {
    value: i32,
}

struct A {
    value: i32,
}

struct B_C {
    value: i32,
}

fn main() -> () {
    let one: (A_B, C) = (A_B { value: 1 }, C { value: 2 });
    let two: (A, B_C) = (A { value: 3 }, B_C { value: 4 });
    println(one.0.value);
    println(two.0.value);
}
