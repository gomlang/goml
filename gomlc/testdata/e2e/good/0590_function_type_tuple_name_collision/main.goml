struct A_B {
    value: i32,
}

struct C {
    value: i32,
}

struct A {
    value: i32,
}

struct B_C {
    value: i32,
}

fn f1(x: A_B, y: C) -> i32 {
    x.value + y.value
}

fn f2(x: A, y: B_C) -> i32 {
    x.value + y.value
}

fn main() -> () {
    let one: ((A_B, C) -> i32, i32) = (f1, 1);
    let two: ((A, B_C) -> i32, i32) = (f2, 2);
    println(one.1);
    println(two.1);
}
