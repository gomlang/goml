trait Area {
    fn area(self: Self) -> f64;
}

struct Circle {
    r: f64,
}

struct Rect {
    w: f64,
    h: f64,
}

struct Triangle {
    base: f64,
    height: f64,
}

impl Area for Circle {
    fn area(self: Circle) -> f64 {
        3.14159 * self.r * self.r
    }
}

impl Area for Rect {
    fn area(self: Rect) -> f64 {
        self.w * self.h
    }
}

impl Area for Triangle {
    fn area(self: Triangle) -> f64 {
        self.base * self.height / 2.0
    }
}

fn format_area(name: string, a: dyn Area) -> string {
    name + ": " + Area::area(a).to_string()
}

fn main() {
    println(format_area("circle", Circle { r: 5.0 } as dyn Area));
    println(format_area("rect", Rect { w: 3.0, h: 4.0 } as dyn Area));
    println(format_area("triangle", Triangle { base: 6.0, height: 8.0 } as dyn Area));
}
