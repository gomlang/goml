enum List[T] {
    Cons(T, List[T]),
    Nil,
}

fn length[T](list: List[T]) -> i32 {
    match list {
        List::Cons(_, rest) => 1 + length(rest),
        List::Nil => 0,
    }
}

fn reverse[T](list: List[T]) -> List[T] {
    let acc = Ref::new(List::Nil);
    let current = Ref::new(list);
    while true {
        match current.get() {
            List::Cons(x, rest) => {
                acc.set(List::Cons(x, acc.get()));
                current.set(rest);
            },
            List::Nil => {
                current.set(List::Nil);
            },
        };
        let done = match current.get() {
            List::Cons(_, _) => false,
            List::Nil => true,
        };
        if done { current.set(List::Nil) } else { () };
        if done { acc.set(acc.get()) } else { () };
    };
    acc.get()
}

fn main() {
    let list = List::Cons(1, List::Cons(2, List::Cons(3, List::Nil)));
    println(length(list).to_string());
}
