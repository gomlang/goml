enum Action {
    SetValue(i32),
    Transform((i32) -> i32),
    Reset,
}

fn apply_action(action: Action, current: i32) -> i32 {
    match action {
        Action::SetValue(v) => v,
        Action::Transform(f) => f(current),
        Action::Reset => 0,
    }
}

fn main() {
    let val = Ref::new(10);
    
    let actions = [
        Action::Transform(|x| x * 2),
        Action::SetValue(100),
        Action::Transform(|x| x + 5),
        Action::Reset,
    ];
    
    let i = Ref::new(0);
    while i.get() < 4 {
        val.set(apply_action(actions[i.get()], val.get()));
        println(val.get().to_string());
        i.set(i.get() + 1);
    };
}
