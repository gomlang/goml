trait Shape {
    fn area(self: Self) -> f64;
}

struct Circle {
    radius: f64,
}

struct Rectangle {
    width: f64,
    height: f64,
}

impl Shape for Circle {
    fn area(self: Circle) -> f64 {
        self.radius * self.radius * 3.14159
    }
}

impl Shape for Rectangle {
    fn area(self: Rectangle) -> f64 {
        self.width * self.height
    }
}

fn print_area(s: dyn Shape) {
    println(Shape::area(s).to_string());
}

fn main() {
    print_area(Circle { radius: 5.0 } as dyn Shape);
    print_area(Rectangle { width: 3.0, height: 4.0 } as dyn Shape);
    let shapes: [dyn Shape; 2] = [
        Circle { radius: 1.0 } as dyn Shape,
        Rectangle { width: 2.0, height: 3.0 } as dyn Shape,
    ];
    let i = Ref::new(0);
    while i.get() < 2 {
        print_area(shapes[i.get()]);
        i.set(i.get() + 1);
    }
}
