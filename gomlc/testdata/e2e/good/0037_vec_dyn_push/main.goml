trait Speak {
    fn speak(self: Self) -> string;
}

struct Dog {}

impl Speak for Dog {
    fn speak(self: Dog) -> string {
        "woof"
    }
}

struct Cat {}

impl Speak for Cat {
    fn speak(self: Cat) -> string {
        "meow"
    }
}

fn main() {
    let v: Vec[dyn Speak] = Vec::new();
    v.push(Dog {} as dyn Speak);
    v.push(Cat {} as dyn Speak);
    let a = v[0];
    println(Speak::speak(a));
}
