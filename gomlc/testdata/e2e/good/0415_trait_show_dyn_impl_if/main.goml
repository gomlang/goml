trait Show {
    fn show(self: Self) -> string;
}

struct A {}

struct B {}

impl Show for A {
    fn show(self: A) -> string {
        "A"
    }
}

impl Show for B {
    fn show(self: B) -> string {
        "B"
    }
}

fn display(x: dyn Show) {
    println(Show::show(x));
}

fn main() {
    let flag = true;
    display(
        if flag {
            A {} as dyn Show
        } else {
            A {} as dyn Show
        },
    );
}
