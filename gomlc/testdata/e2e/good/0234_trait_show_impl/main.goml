trait Show {
    fn show(self: Self) -> string;
}

impl Show for i32 {
    fn show(self: i32) -> string {
        self.to_string()
    }
}

impl Show for string {
    fn show(self: string) -> string {
        self
    }
}

fn print_it[T: Show](x: T) {
    println(Show::show(x));
}

fn main() {
    print_it(42);
    print_it("hello");
}
