fn zip_with[A, B, C](a: A, b: B, f: (A, B) -> C) -> C {
    f(a, b)
}

fn main() {
    let result = zip_with(3, "hello", |n, s| {
        let repeated = Ref::new(s);
        let i = Ref::new(1);
        while i.get() < n {
            repeated.set(repeated.get() + " " + s);
            i.set(i.get() + 1);
        };
        repeated.get()
    });
    println(result);
}
