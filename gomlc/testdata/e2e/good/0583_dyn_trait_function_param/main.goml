trait Mapper {
    fn map(self: Self, arg1: (i32) -> i32) -> i32;
}

struct Boxed {
    value: i32,
}

impl Mapper for Boxed {
    fn map(self: Boxed, f: (i32) -> i32) -> i32 {
        f(self.value)
    }
}

fn main() -> () {
    let x: dyn Mapper = Boxed { value: 1 } as dyn Mapper;
    println(Mapper::map(x, |n| n + 1));
}
