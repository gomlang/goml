trait TryConvert {
    fn try_to_int(self: Self) -> Option[i32];
}

struct IntValue {
    n: i32,
}

impl TryConvert for IntValue {
    fn try_to_int(self: IntValue) -> Option[i32] {
        Option::Some(self.n)
    }
}

struct StringValue {
    s: string,
}

impl TryConvert for StringValue {
    fn try_to_int(self: StringValue) -> Option[i32] {
        let _ = self;
        Option::None
    }
}

fn sum_convertible(items: Vec[dyn TryConvert]) -> i32 {
    let sum = Ref::new(0);
    let i = Ref::new(0);
    while i.get() < items.len() {
        match TryConvert::try_to_int(items[i.get()]) {
            Option::Some(n) => sum.set(sum.get() + n),
            Option::None => (),
        };
        i.set(i.get() + 1);
    }
    sum.get()
}

fn main() {
    let items: Vec[dyn TryConvert] = Vec::new();
    items.push(IntValue { n: 10 } as dyn TryConvert);
    items.push(StringValue { s: "hello" } as dyn TryConvert);
    items.push(IntValue { n: 20 } as dyn TryConvert);
    println(sum_convertible(items).to_string());
}
