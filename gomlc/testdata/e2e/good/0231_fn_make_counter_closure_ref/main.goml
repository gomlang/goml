fn make_counter() -> () -> i32 {
    let count = Ref::new(0);
    || {
        let c = count.get();
        count.set(c + 1);
        c
    }
}

fn main() {
    let counter = make_counter();
    println(counter().to_string());
    println(counter().to_string());
    println(counter().to_string());
}
