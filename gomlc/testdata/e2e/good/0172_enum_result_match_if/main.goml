enum Result[T, E] {
    Ok(T),
    Err(E),
}

fn div(a: i32, b: i32) -> Result[i32, string] {
    if b == 0 {
        Result::Err("division by zero")
    } else {
        Result::Ok(a / b)
    }
}

fn show_result(r: Result[i32, string]) -> string {
    match r {
        Result::Ok(v) => "Ok(" + v.to_string() + ")",
        Result::Err(e) => "Err(" + e + ")",
    }
}

fn main() {
    println(show_result(div(10, 3)));
    println(show_result(div(10, 0)));
    println(show_result(div(100, 5)));
}
