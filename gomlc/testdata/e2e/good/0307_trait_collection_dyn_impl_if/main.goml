trait Collection {
    fn is_empty(self: Self) -> bool;
    fn count(self: Self) -> i32;
    fn describe(self: Self) -> string;
}

struct Bag {
    items: i32,
}

impl Collection for Bag {
    fn is_empty(self: Bag) -> bool {
        self.items == 0
    }

    fn count(self: Bag) -> i32 {
        self.items
    }

    fn describe(self: Bag) -> string {
        "bag(" + self.items.to_string() + ")"
    }
}

fn print_collection(c: dyn Collection) {
    println(Collection::describe(c));
    if Collection::is_empty(c) {
        println("  empty");
    } else {
        println("  count: " + Collection::count(c).to_string());
    };
}

fn main() {
    print_collection(Bag { items: 0 } as dyn Collection);
    print_collection(Bag { items: 5 } as dyn Collection);
}
