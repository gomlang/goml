fn present(value: i32) -> i32 {
    value + 1
}

enum Option[T] {
    Empty,
    Present(T),
}

fn main() -> () {
    let map: HashMap[i32, i32] = HashMap::new();
    map.set(1, 2);
    match map.get(1) {
        Option::Present(value) => println(value),
        Option::Empty => println(0),
    }
}
