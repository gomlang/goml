trait Describable {
    fn describe(self: Self) -> string;
}

struct Named {
    name: string,
}

struct Numbered {
    id: i32,
}

impl Describable for Named {
    fn describe(self: Named) -> string {
        "name: " + self.name
    }
}

impl Describable for Numbered {
    fn describe(self: Numbered) -> string {
        "id: " + self.id.to_string()
    }
}

fn describe_all(items: [dyn Describable; 3]) -> string {
    let result = Ref::new("");
    let i = Ref::new(0);
    while i.get() < 3 {
        let item = items[i.get()];
        let sep = if i.get() > 0 {
            ", "
        } else {
            ""
        };
        result.set(result.get() + sep + Describable::describe(item));
        i.set(i.get() + 1);
    }
    result.get()
}

fn main() {
    let items: [dyn Describable; 3] = [
        Named { name: "Alice" } as dyn Describable,
        Numbered { id: 42 } as dyn Describable,
        Named { name: "Bob" } as dyn Describable,
    ];
    println(describe_all(items));
}
