trait Speak {
    fn speak(self: Self) -> string;
}

struct Robot {}

impl Speak for Robot {
    fn speak(self: Robot) -> string {
        "beep boop"
    }
}

struct Cat {
    name: string,
}

impl Speak for Cat {
    fn speak(self: Cat) -> string {
        self.name
    }
}

fn main() {
    let r: dyn Speak = Robot {} as dyn Speak;
    let msg = Speak::speak(r);
    println(msg);
    let c: dyn Speak = Cat { name: "meow" } as dyn Speak;
    let msg2 = Speak::speak(c);
    println(msg2);
}
