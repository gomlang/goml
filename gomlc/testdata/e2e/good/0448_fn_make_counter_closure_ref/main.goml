fn make_counter() -> () -> i32 {
    let count = Ref::new(0);
    || {
        count.set(count.get() + 1);
        count.get()
    }
}

fn main() {
    let c1 = make_counter();
    let c2 = make_counter();
    println(c1().to_string());
    println(c1().to_string());
    println(c2().to_string());
    println(c1().to_string());
}
