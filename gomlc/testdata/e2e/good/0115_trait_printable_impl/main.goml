trait Printable {
    fn print(self: Self);
}

impl Printable for i32 {
    fn print(self: i32) {
        println(self.to_string());
    }
}

impl Printable for string {
    fn print(self: string) {
        println(self);
    }
}

fn print_twice[T: Printable](x: T) {
    Printable::print(x);
    Printable::print(x);
}

fn main() {
    print_twice(42);
    print_twice("hello");
}
