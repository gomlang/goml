fn main() {
    let mut local = 1;
    let cell = Ref::new(10);

    let step = || {
        local = local + 2;
        cell.set(cell.get() + 3);
        local + cell.get()
    };

    println(step().to_string());
    println(step().to_string());
    println(local.to_string());
    println(cell.get().to_string());
}
