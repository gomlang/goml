#[derive(ToString)]
struct Point {
    x: i32,
    y: i32,
}

#[derive(ToString)]
enum Color {
    Red,
    Green,
    Blue,
    Custom(i32, i32, i32),
}

fn main() {
    let p = Point { x: 1, y: 2 };
    println(p.to_string());
    println(Color::Red.to_string());
    println(Color::Custom(255, 128, 0).to_string());
}
