trait Container {
    fn size(self: Self) -> i32;
    fn is_empty(self: Self) -> bool;
}

struct MyList {
    len: i32,
}

impl Container for MyList {
    fn size(self: MyList) -> i32 {
        self.len
    }

    fn is_empty(self: MyList) -> bool {
        self.len == 0
    }
}

fn print_info(c: dyn Container) {
    println(Container::size(c).to_string());
    if Container::is_empty(c) {
        println("empty")
    } else {
        println("not empty")
    };
}

fn main() {
    print_info(MyList { len: 5 } as dyn Container);
    print_info(MyList { len: 0 } as dyn Container);
}
