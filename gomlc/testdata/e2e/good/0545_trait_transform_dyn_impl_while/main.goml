trait Transform {
    fn apply(self: Self, arg1: i32) -> i32;
}

struct Adder {
    amount: i32,
}

struct Multiplier {
    factor: i32,
}

impl Transform for Adder {
    fn apply(self: Adder, x: i32) -> i32 {
        x + self.amount
    }
}

impl Transform for Multiplier {
    fn apply(self: Multiplier, x: i32) -> i32 {
        x * self.factor
    }
}

fn apply_all(transforms: Vec[dyn Transform], x: i32) -> i32 {
    let result = Ref::new(x);
    let i = Ref::new(0);
    while i.get() < transforms.len() {
        let t = transforms[i.get()];
        result.set(Transform::apply(t, result.get()));
        i.set(i.get() + 1);
    }
    result.get()
}

fn main() {
    let transforms: Vec[dyn Transform] = Vec::new();
    transforms.push(Adder { amount: 5 } as dyn Transform);
    transforms.push(Multiplier { factor: 3 } as dyn Transform);
    transforms.push(Adder { amount: -2 } as dyn Transform);
    let result = apply_all(transforms, 10);
    println(result.to_string());
}
