trait Logger {
    fn log(self: Self, arg1: string) -> ();
}

struct ConsoleLogger {}

struct PrefixLogger {
    prefix: string,
}

impl Logger for ConsoleLogger {
    fn log(self: ConsoleLogger, msg: string) -> () {
        println(msg);
    }
}

impl Logger for PrefixLogger {
    fn log(self: PrefixLogger, msg: string) -> () {
        println(self.prefix + msg);
    }
}

struct App {
    logger: dyn Logger,
    name: string,
}

fn run(app: App) -> () {
    Logger::log(app.logger, "Starting " + app.name);
}

fn main() {
    let app1 = App { logger: ConsoleLogger {} as dyn Logger, name: "App1" };
    run(app1);
    let app2 = App { logger: PrefixLogger { prefix: "[INFO] " } as dyn Logger, name: "App2" };
    run(app2);
}
