enum List[T] {
    Nil,
    Cons(T, Ref[List[T]]),
}

fn sum(list: List[u8]) -> u8 {
    match list {
        List::Nil => 0,
        List::Cons(head, tail) => head + sum(tail.get()),
    }
}

fn main() {
    let list: List[u8] = List::Cons(10, Ref::new(List::Cons(20, Ref::new(List::Cons(30, Ref::new(List::Nil))))));
    println(sum(list).to_string());
}
