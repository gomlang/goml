trait Printable {
  fn to_str(self: Self) -> string;
}

impl Printable for i32 {
  fn to_str(self: i32) -> string { self.to_string() }
}

fn identity[T](x: T) -> T {
  x
}

fn show[T: Printable](x: T) -> string {
  let y = identity(x);
  Printable::to_str(y)
}

fn main() -> () {
  println(show(42))
}
