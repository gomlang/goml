trait ToStr {
    fn to_str(self: Self) -> string;
}

struct Point { x: i32, y: i32 }
struct Color { r: i32, g: i32, b: i32 }

impl ToStr for Point {
    fn to_str(self: Point) -> string {
        "P(" + self.x.to_string() + "," + self.y.to_string() + ")"
    }
}

impl ToStr for Color {
    fn to_str(self: Color) -> string {
        "C(" + self.r.to_string() + "," + self.g.to_string() + "," + self.b.to_string() + ")"
    }
}

fn print_all[T: ToStr](items: [T; 3]) {
    println(ToStr::to_str(items[0]));
    println(ToStr::to_str(items[1]));
    println(ToStr::to_str(items[2]));
}

fn main() {
    let points: [Point; 3] = [Point {x:1,y:2}, Point {x:3,y:4}, Point {x:5,y:6}];
    print_all(points);
    let colors: [Color; 3] = [Color {r:255,g:0,b:0}, Color {r:0,g:255,b:0}, Color {r:0,g:0,b:255}];
    print_all(colors);
}
