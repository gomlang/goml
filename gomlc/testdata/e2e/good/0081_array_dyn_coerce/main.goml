trait Describable {
    fn describe(self: Self) -> string;
}

struct Circle {
    radius: f64,
}

struct Square {
    side: f64,
}

impl Describable for Circle {
    fn describe(self: Circle) -> string {
        "Circle"
    }
}

impl Describable for Square {
    fn describe(self: Square) -> string {
        "Square"
    }
}

fn main() {
    let items: [dyn Describable; 2] = [
        Circle { radius: 1.0 } as dyn Describable,
        Square { side: 2.0 } as dyn Describable,
    ];
    let x = items[0];
    println(Describable::describe(x));
}
