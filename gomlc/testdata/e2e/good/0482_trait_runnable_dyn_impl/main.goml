trait Runnable {
    fn run(self: Self) -> ();
}

struct Task {
    name: string,
}

impl Runnable for Task {
    fn run(self: Task) -> () {
        println("Running: " + self.name);
    }
}

fn execute(r: dyn Runnable) {
    Runnable::run(r);
}

fn main() {
    let t1 = Task { name: "first" };
    let t2 = Task { name: "second" };
    execute(t1 as dyn Runnable);
    execute(t2 as dyn Runnable);
}
