fn print_uint8(x: u8) {
    println(x.to_string());
}

fn print_int8(x: i8) {
    println(x.to_string());
}

fn print_int16(x: i16) {
    println(x.to_string());
}

fn print_uint16(x: u16) {
    println(x.to_string());
}

fn print_uint32(x: u32) {
    println(x.to_string());
}

fn print_int64(x: i64) {
    println(x.to_string());
}

fn print_uint64(x: u64) {
    println(x.to_string());
}

fn print_float32(x: f32) {
    println(x.to_string());
}

fn main() {
    let a: u8 = 255;
    print_uint8(a);

    let b: i8 = -1;
    print_int8(b);

    let c: i16 = 1000;
    print_int16(c);

    let d: u16 = 50000;
    print_uint16(d);

    let e: u32 = 100000;
    print_uint32(e);

    let f: i64 = 9999999;
    print_int64(f);

    let g: u64 = 42;
    print_uint64(g);

    let h: f32 = 3.14;
    print_float32(h);

    print_uint8(10);
    print_int64(99);
    print_float32(2.5);
}
