fn apply_twice(f: (i32) -> i32, x: i32) -> i32 {
    f(f(x))
}

fn main() {
    let f = |n: i32| {
        if n > 3 {
            return n
        } else {
            ()
        };
        n + 10
    };

    println(f(2).to_string());
    println(f(5).to_string());
    println(apply_twice(f, 2).to_string());
}
