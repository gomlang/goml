trait Handler {
    fn handle(self: Self, arg1: string) -> string;
}

struct EchoHandler {}

struct UpperHandler {}

impl Handler for EchoHandler {
    fn handle(self: EchoHandler, msg: string) -> string {
        let _ = self;
        msg
    }
}

impl Handler for UpperHandler {
    fn handle(self: UpperHandler, msg: string) -> string {
        let _ = self;
        msg + " (upper)"
    }
}

fn main() {
    let routes: HashMap[string, dyn Handler] = HashMap::new();
    routes.set("/echo", EchoHandler {} as dyn Handler);
    routes.set("/upper", UpperHandler {} as dyn Handler);
    match routes.get("/echo") {
        Option::Some(h) => println(Handler::handle(h, "hello")),
        Option::None => println("not found"),
    };
}
