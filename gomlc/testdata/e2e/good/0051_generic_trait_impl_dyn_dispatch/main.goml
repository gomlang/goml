struct Box[T] {
    value: T,
}

trait Printable {
    fn print_me(self: Self) -> string;
}

impl Printable for i32 {
    fn print_me(self: i32) -> string {
        self.to_string()
    }
}

impl[T: Printable] Printable for Box[T] {
    fn print_me(self: Box[T]) -> string {
        "Box(" + Printable::print_me(self.value) + ")"
    }
}

fn show(x: dyn Printable) -> string {
    Printable::print_me(x)
}

fn main() {
    let b: Box[i32] = Box { value: 42 };
    println(show(b as dyn Printable));
}
