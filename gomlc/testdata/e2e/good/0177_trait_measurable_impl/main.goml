trait Measurable {
    fn measure(self: Self) -> i32;
}

struct Rect {
    w: i32,
    h: i32,
}

impl Rect {
    fn area(self: Rect) -> i32 {
        self.w * self.h
    }
    fn perimeter(self: Rect) -> i32 {
        2 * (self.w + self.h)
    }
}

impl Measurable for Rect {
    fn measure(self: Rect) -> i32 {
        Rect::area(self)
    }
}

fn main() {
    let r = Rect { w: 3, h: 4 };
    println(Rect::area(r).to_string());
    println(Rect::perimeter(r).to_string());
    println(Measurable::measure(r).to_string());
}
