trait Transform {
    fn apply(self: Self, arg1: i32) -> i32;
}

struct Doubler {}

struct Adder {
    amount: i32,
}

impl Transform for Doubler {
    fn apply(self: Doubler, x: i32) -> i32 {
        x * 2
    }
}

impl Transform for Adder {
    fn apply(self: Adder, x: i32) -> i32 {
        x + self.amount
    }
}

fn apply_chain(transforms: [dyn Transform; 3], input: i32) -> i32 {
    let result = Ref::new(input);
    let i = Ref::new(0);
    while i.get() < 3 {
        let t = transforms[i.get()];
        result.set(Transform::apply(t, result.get()));
        i.set(i.get() + 1);
    }
    result.get()
}

fn main() {
    let transforms: [dyn Transform; 3] = [
        Doubler {} as dyn Transform,
        Adder { amount: 5 } as dyn Transform,
        Doubler {} as dyn Transform,
    ];
    let result = apply_chain(transforms, 3);
    println(result.to_string());
}
