fn main() {
    let v = Vec::new();
    v.push(Option::Some(1));
    v.push(Option::None);
    v.push(Option::Some(3));
    v.push(Option::None);
    v.push(Option::Some(5));

    let sum = Ref::new(0);
    let i = Ref::new(0);
    while i.get() < v.len() {
        let item = v[i.get()];
        match item {
            Option::Some(n) => sum.set(sum.get() + n),
            Option::None => (),
        };
        i.set(i.get() + 1);
    };
    println(sum.get().to_string());
}
