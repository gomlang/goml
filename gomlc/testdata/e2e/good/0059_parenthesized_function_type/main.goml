fn make_counter() -> (() -> i32) {
    let count = Ref::new(0);
    || {
        count.set(count.get() + 1);
        count.get()
    }
}

fn identity(f: (() -> i32)) -> (() -> i32) {
    f
}

fn main() {
    let counter = make_counter();
    println(counter().to_string());
    println(counter().to_string());
    let f = identity(|| 99);
    println(f().to_string());
}
