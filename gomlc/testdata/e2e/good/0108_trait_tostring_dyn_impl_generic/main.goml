trait ToString {
    fn to_string(self: Self) -> string;
}

struct Wrapper[T] {
    inner: T,
}

impl ToString for Wrapper[i32] {
    fn to_string(self: Wrapper[i32]) -> string {
        "Wrapper(" + self.inner.to_string() + ")"
    }
}

impl ToString for Wrapper[string] {
    fn to_string(self: Wrapper[string]) -> string {
        "Wrapper(" + self.inner + ")"
    }
}

fn print_it(x: dyn ToString) {
    println(ToString::to_string(x));
}

fn main() {
    let a: Wrapper[i32] = Wrapper { inner: 42 };
    let b = Wrapper { inner: "hello" };
    print_it(a as dyn ToString);
    print_it(b as dyn ToString);
}
