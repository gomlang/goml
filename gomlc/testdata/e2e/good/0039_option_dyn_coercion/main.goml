trait Show {
    fn show(self: Self) -> string;
}

struct Num {
    val: i32,
}

impl Show for Num {
    fn show(self: Num) -> string {
        self.val.to_string()
    }
}

fn main() {
    let opt: Option[dyn Show] = Option::Some(Num { val: 42 } as dyn Show);
    match opt {
        Option::Some(x) => println(Show::show(x)),
        Option::None => println("none"),
    };
}
