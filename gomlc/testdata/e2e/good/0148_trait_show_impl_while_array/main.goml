trait Show {
    fn show(self: Self) -> string;
}

struct Point {
    x: i32,
    y: i32,
}

impl Show for Point {
    fn show(self: Point) -> string {
        "(" + self.x.to_string() + ", " + self.y.to_string() + ")"
    }
}

fn show_all[T: Show](items: [T; 3]) {
    let i = Ref::new(0);
    while i.get() < 3 {
        println(Show::show(items[i.get()]));
        i.set(i.get() + 1);
    };
}

fn main() {
    let points = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }, Point { x: 5, y: 6 }];
    show_all(points);
}
