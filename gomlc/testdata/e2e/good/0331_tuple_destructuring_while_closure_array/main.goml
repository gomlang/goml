fn main() {
    let ops: [(string, (i32) -> i32); 3] = [
        ("add1", |x| x + 1),
        ("mul2", |x| x * 2),
        ("neg",  |x| 0 - x),
    ];
    let i = Ref::new(0);
    while i.get() < 3 {
        let (name, f) = ops[i.get()];
        println(name + ": " + f(10).to_string());
        i.set(i.get() + 1);
    };
}
