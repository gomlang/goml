enum List[T] {
    Cons(T, Ref[List[T]]),
    Nil,
}

fn sum(list: List[i32]) -> i32 {
    match list {
        List::Cons(head, tail) => head + sum(tail.get()),
        List::Nil => 0,
    }
}

fn main() {
    let list = List::Cons(1, Ref::new(List::Cons(2, Ref::new(List::Cons(3, Ref::new(List::Nil))))));
    println(sum(list).to_string());
}
