fn main() {
    let counter = Ref::new(0);
    let inc = || {
        counter.set(counter.get() + 1);
        counter.get()
    };
    println(inc().to_string());
    println(inc().to_string());
    println(inc().to_string());
    
    let make_adder = |n: i32| {
        |x: i32| x + n
    };
    let add5 = make_adder(5);
    println(add5(10).to_string());
}
