trait Reducer {
    fn reduce(self: Self, arg1: i32) -> i32;
}

struct Summer {}

struct Multiplier {
    factor: i32,
}

impl Reducer for Summer {
    fn reduce(self: Summer, acc: i32) -> i32 {
        acc + 1
    }
}

impl Reducer for Multiplier {
    fn reduce(self: Multiplier, acc: i32) -> i32 {
        acc * self.factor
    }
}

fn apply_reducer(r: dyn Reducer, init: i32, n: i32) -> i32 {
    let acc = Ref::new(init);
    let i = Ref::new(0);
    while i.get() < n {
        acc.set(Reducer::reduce(r, acc.get()));
        i.set(i.get() + 1);
    }
    acc.get()
}

fn main() {
    let s: dyn Reducer = Summer {} as dyn Reducer;
    let m: dyn Reducer = Multiplier { factor: 2 } as dyn Reducer;
    println(apply_reducer(s, 0, 5).to_string());
    println(apply_reducer(m, 1, 4).to_string());
}
