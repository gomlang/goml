trait Functor {
    fn fmap(self: Self, arg1: (i32) -> i32) -> Self;
}

struct Box {
    value: i32,
}

impl Functor for Box {
    fn fmap(self: Box, f: (i32) -> i32) -> Box {
        Box { value: f(self.value) }
    }
}

fn apply_twice[T: Functor](x: T, f: (i32) -> i32) -> T {
    let y = Functor::fmap(x, f);
    Functor::fmap(y, f)
}

fn main() {
    let b = Box { value: 5 };
    let result = apply_twice(b, |x| x + 3);
    println(result.value.to_string());
}
