trait Area {
    fn area(self: Self) -> i32;
}

enum Shape {
    Circle(i32),
    Rect(i32, i32),
}

impl Area for Shape {
    fn area(self: Shape) -> i32 {
        match self {
            Shape::Circle(r) => 3 * r * r,
            Shape::Rect(w, h) => w * h,
        }
    }
}

fn print_area(a: dyn Area) {
    println("area=" + Area::area(a).to_string());
}

fn main() {
    print_area(Shape::Circle(5) as dyn Area);
    print_area(Shape::Rect(3, 4) as dyn Area);
}
