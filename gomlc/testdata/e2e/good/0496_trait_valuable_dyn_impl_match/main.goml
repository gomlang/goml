trait Valuable {
    fn value(self: Self) -> i32;
}

struct A {
    x: i32,
}

struct B {
    x: i32,
    y: i32,
}

impl Valuable for A {
    fn value(self: A) -> i32 {
        self.x
    }
}

impl Valuable for B {
    fn value(self: B) -> i32 {
        self.x + self.y
    }
}

fn make(flag: i32) -> dyn Valuable {
    match flag {
        0 => A { x: 10 } as dyn Valuable,
        1 => B { x: 20, y: 30 } as dyn Valuable,
        _ => A { x: -1 } as dyn Valuable,
    }
}

fn main() {
    let v0 = make(0);
    let v1 = make(1);
    let v2 = make(2);
    println(Valuable::value(v0).to_string());
    println(Valuable::value(v1).to_string());
    println(Valuable::value(v2).to_string());
}
