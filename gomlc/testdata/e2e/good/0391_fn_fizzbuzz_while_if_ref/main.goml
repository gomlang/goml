fn fizzbuzz(n: i32) -> string {
    let i = Ref::new(1);
    let result = Ref::new("");
    while i.get() <= n {
        let x = i.get();
        let s = if x == 15 { "FizzBuzz" }
                else if x == 3 { "Fizz" }
                else if x == 5 { "Buzz" }
                else if x == 6 { "Fizz" }
                else if x == 9 { "Fizz" }
                else if x == 10 { "Buzz" }
                else if x == 12 { "Fizz" }
                else { x.to_string() };
        result.set(result.get() + s + " ");
        i.set(x + 1);
    };
    result.get()
}

fn main() {
    println(fizzbuzz(15));
}
