fn apply_n(f: (i32) -> i32, n: i32, x: i32) -> i32 {
    let result = Ref::new(x);
    let i = Ref::new(0);
    while i.get() < n {
        result.set(f(result.get()));
        i.set(i.get() + 1);
    };
    result.get()
}

fn main() {
    let double = |x: i32| x * 2;
    println(apply_n(double, 5, 1).to_string());
    
    let captured = 3;
    let add_captured = |x: i32| x + captured;
    println(apply_n(add_captured, 4, 0).to_string());
}
