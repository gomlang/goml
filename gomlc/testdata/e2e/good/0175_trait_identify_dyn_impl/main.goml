trait Identify {
    fn identify(self: Self) -> string;
}

struct Robot {
    id: i32,
}

impl Identify for Robot {
    fn identify(self: Robot) -> string {
        "Robot-" + self.id.to_string()
    }
}

fn main() {
    let a: dyn Identify = Robot { id: 42 } as dyn Identify;
    println(Identify::identify(a));
}
