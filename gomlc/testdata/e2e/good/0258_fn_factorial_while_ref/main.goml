fn factorial(n: i64) -> i64 {
    let result = Ref::new(1);
    let i = Ref::new(1);
    while i.get() <= n {
        result.set(result.get() * i.get());
        i.set(i.get() + 1);
    };
    result.get()
}

fn main() {
    println(factorial(10).to_string());
    println(factorial(20).to_string());
}
