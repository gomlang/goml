enum Maybe[T] {
    None,
    Some(T),
}

#[derive(Hash, PartialEq, Eq)]
struct Node {
    value: i32,
    next: Ref[Maybe[Node]],
}

impl PartialEq for Maybe[Node] {
    fn eq(self: Maybe[Node], other: Maybe[Node]) -> bool {
        match (self, other) {
            (Maybe::None, Maybe::None) => true,
            (Maybe::Some(a), Maybe::Some(b)) => PartialEq::eq(a, b),
            _ => false,
        }
    }
}

impl Eq for Maybe[Node] {}

impl Hash for Maybe[Node] {
    fn hash(self: Maybe[Node]) -> u64 {
        match self {
            Maybe::None => 0,
            Maybe::Some(node) => Hash::hash(node),
        }
    }
}

fn main() -> () {
    let n = Node { value: 1, next: Ref::new(Maybe::None) };
    let m: HashMap[Node, string] = HashMap::new();
    m.set(n, "ok");
    println(m.len().to_string())
}
