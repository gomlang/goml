fn main() {
    let i = Ref::new(0);
    while i.get() < 10 {
        i.set(i.get() + 1);
        if i.get() == 3 {
            continue;
        } else { () };
        if i.get() == 7 {
            break;
        } else { () };
        println(i.get().to_string());
    };
    println("done: " + i.get().to_string());
}
