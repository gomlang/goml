enum Dir { Up, Down, Left, Right }

fn opposite(d: Dir) -> Dir {
    match d {
        Dir::Up => Dir::Down,
        Dir::Down => Dir::Up,
        Dir::Left => Dir::Right,
        Dir::Right => Dir::Left,
    }
}

fn main() {
    let dirs: [Dir; 4] = [Dir::Up, Dir::Down, Dir::Left, Dir::Right];
    let i = Ref::new(0);
    while i.get() < 4 {
        let d = dirs[i.get()];
        let o = opposite(d);
        let name = match o {
            Dir::Up => "up",
            Dir::Down => "down",
            Dir::Left => "left",
            Dir::Right => "right",
        };
        println(name);
        i.set(i.get() + 1);
    };
}
