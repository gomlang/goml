trait Printable {
    fn print(self: Self) -> string;
}

struct Wrapped[T] {
    inner: T,
}

impl Printable for Wrapped[isize] {
    fn print(self: Wrapped[isize]) -> string {
        "isize:" + self.inner.to_string()
    }
}

impl Printable for Wrapped[string] {
    fn print(self: Wrapped[string]) -> string {
        "str:" + self.inner
    }
}

fn wrap[T](x: T) -> Wrapped[T] {
    Wrapped { inner: x }
}

fn main() {
    let items: Vec[dyn Printable] = Vec::new();
    items.push(wrap(42) as dyn Printable);
    items.push(wrap("hello") as dyn Printable);
    let i = Ref::new(0);
    while i.get() < items.len() {
        println(Printable::print(items[i.get()]));
        i.set(i.get() + 1);
    }
}
