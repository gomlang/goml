enum Msg {
    Text(string),
    Number(i32),
    Pair(string, i32),
}

fn format_msg(msg: Msg) -> string {
    match msg {
        Msg::Text(s) => "text: " + s,
        Msg::Number(n) => "number: " + n.to_string(),
        Msg::Pair(s, n) => s + "=" + n.to_string(),
    }
}

fn main() {
    let msgs: [Msg; 3] = [
        Msg::Text("hello"),
        Msg::Number(42),
        Msg::Pair("answer", 42),
    ];
    let i = Ref::new(0);
    while i.get() < 3 {
        println(format_msg(msgs[i.get()]));
        i.set(i.get() + 1);
    };
}
