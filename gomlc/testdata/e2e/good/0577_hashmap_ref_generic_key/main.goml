struct Wrap[T] {
    value: T,
}

impl[T: PartialEq] PartialEq for Wrap[T] {
    fn eq(self: Wrap[T], other: Wrap[T]) -> bool {
        PartialEq::eq(self.value, other.value)
    }
}

impl[T: Eq] Eq for Wrap[T] {}

impl[T: Hash] Hash for Wrap[T] {
    fn hash(self: Wrap[T]) -> u64 {
        Hash::hash(self.value)
    }
}

fn main() -> () {
    let map: HashMap[Ref[Wrap[i32]], string] = HashMap::new();
    let key = Ref::new(Wrap { value: 42 });
    let alias = key;
    map.set(key, "ok");
    match map.get(alias) {
        Option::Some(value) => println(value),
        Option::None => println("missing"),
    };
    match map.get(Ref::new(Wrap { value: 42 })) {
        Option::Some(value) => println(value),
        Option::None => println("missing"),
    };
    key.set(Wrap { value: 7 });
    match map.get(key) {
        Option::Some(value) => println(value),
        Option::None => println("missing"),
    }
}
