trait Processor {
    fn process(self: Self, arg1: i32) -> i32;
}

struct Doubler {}

struct Adder {
    amount: i32,
}

impl Processor for Doubler {
    fn process(self: Doubler, x: i32) -> i32 {
        x * 2
    }
}

impl Processor for Adder {
    fn process(self: Adder, x: i32) -> i32 {
        x + self.amount
    }
}

struct Pipeline {
    steps: [dyn Processor; 3],
}

fn run_pipeline(p: Pipeline, input: i32) -> i32 {
    let val = Ref::new(input);
    let i = Ref::new(0);
    while i.get() < 3 {
        let step = p.steps[i.get()];
        val.set(Processor::process(step, val.get()));
        i.set(i.get() + 1);
    }
    val.get()
}

fn main() {
    let p = Pipeline {
        steps: [
            Doubler {} as dyn Processor,
            Adder { amount: 5 } as dyn Processor,
            Doubler {} as dyn Processor,
        ],
    };
    let result = run_pipeline(p, 3);
    println(result.to_string());
}
