trait Strategy {
    fn execute(self: Self, arg1: i32) -> i32;
}

struct Aggressive {}

struct Defensive {}

impl Strategy for Aggressive {
    fn execute(self: Aggressive, x: i32) -> i32 {
        x * 2
    }
}

impl Strategy for Defensive {
    fn execute(self: Defensive, x: i32) -> i32 {
        x + 1
    }
}

struct Player {
    name: string,
    strategy: dyn Strategy,
    health: i32,
}

fn player_turn(p: Player) -> string {
    let damage = Strategy::execute(p.strategy, p.health);
    p.name + " deals " + damage.to_string()
}

fn main() {
    let p1 = Player { name: "Warrior", strategy: Aggressive {} as dyn Strategy, health: 10 };
    let p2 = Player { name: "Healer", strategy: Defensive {} as dyn Strategy, health: 10 };
    println(player_turn(p1));
    println(player_turn(p2));
}
