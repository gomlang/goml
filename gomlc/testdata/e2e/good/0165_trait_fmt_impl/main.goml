trait Fmt {
    fn fmt(self: Self) -> string;
}

impl Fmt for i32 {
    fn fmt(self: i32) -> string { self.to_string() }
}

impl Fmt for string {
    fn fmt(self: string) -> string { "\"" + self + "\"" }
}

fn pair_fmt[A: Fmt, B: Fmt](a: A, b: B) -> string {
    "(" + Fmt::fmt(a) + ", " + Fmt::fmt(b) + ")"
}

fn main() {
    println(pair_fmt(1, 2));
    println(pair_fmt("hello", "world"));
    println(pair_fmt(42, "answer"));
}
