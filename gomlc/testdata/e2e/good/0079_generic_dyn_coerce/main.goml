trait Codec {
    fn encode(self: Self) -> string;
}

struct Wrapper[T] {
    value: T,
}

impl[T: ToString] Codec for Wrapper[T] {
    fn encode(self: Wrapper[T]) -> string {
        self.value.to_string()
    }
}

fn wrap[T: ToString](value: T) -> dyn Codec {
    Wrapper { value: value } as dyn Codec
}

fn main() {
    let a = wrap(42);
    println(Codec::encode(a));
    let b = wrap("hello");
    println(Codec::encode(b));
}
