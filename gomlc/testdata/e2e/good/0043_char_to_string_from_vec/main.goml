fn main() {
    let chars = Vec::new();
    chars.push('H');
    chars.push('i');
    let ch = chars[0];
    println(ch.to_string());
    let i = Ref::new(0);
    while i.get() < chars.len() {
        let c = chars[i.get()];
        println(c.to_string());
        i.set(i.get() + 1);
    };
    println("");
}
