trait A {
    fn foo(self: Self) -> string;
}

trait B {
    fn foo(self: Self) -> string;
}

struct X {}

impl A for X {
    fn foo(self: X) -> string {
        "from A"
    }
}

impl B for X {
    fn foo(self: X) -> string {
        "from B"
    }
}

fn main() {
    let x = X {};
    println(A::foo(x));
    println(B::foo(x));
}
