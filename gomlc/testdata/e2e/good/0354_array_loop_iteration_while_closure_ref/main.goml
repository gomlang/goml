fn main() {
    let a = 10;
    let b = 20;
    let c = 30;
    let fns: [(i32) -> i32; 3] = [
        |x| x + a,
        |x| x + b,
        |x| x + c,
    ];
    let i = Ref::new(0);
    while i.get() < 3 {
        let f = fns[i.get()];
        println(f(100).to_string());
        i.set(i.get() + 1);
    };
}
