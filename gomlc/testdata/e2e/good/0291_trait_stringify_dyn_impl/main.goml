trait Stringify {
    fn to_str(self: Self) -> string;
}

impl Stringify for i32 {
    fn to_str(self: i32) -> string {
        self.to_string()
    }
}

impl Stringify for bool {
    fn to_str(self: bool) -> string {
        if self {
            "true"
        } else {
            "false"
        }
    }
}

fn print_it(x: dyn Stringify) {
    println(Stringify::to_str(x));
}

fn main() {
    print_it(42 as dyn Stringify);
    print_it(true as dyn Stringify);
    print_it(false as dyn Stringify);
}
