enum Expr {
    Num(i32),
    Add(i32, i32),
    Pair((i32, i32)),
}

fn eval(e: Expr) -> i32 {
    match e {
        Expr::Num(n) => n,
        Expr::Add(a, b) => a + b,
        Expr::Pair(p) => {
            let (x, y) = p;
            x * y
        },
    }
}

fn main() {
    println(eval(Expr::Num(7)).to_string());
    println(eval(Expr::Add(3, 4)).to_string());
    println(eval(Expr::Pair((5, 6))).to_string());
}
