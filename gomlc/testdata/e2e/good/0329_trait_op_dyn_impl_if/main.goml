struct Adder {
    n: i32,
}

struct Multiplier {
    n: i32,
}

trait Op {
    fn apply(self: Self, arg1: i32) -> i32;
}

impl Op for Adder {
    fn apply(self: Adder, x: i32) -> i32 {
        x + self.n
    }
}

impl Op for Multiplier {
    fn apply(self: Multiplier, x: i32) -> i32 {
        x * self.n
    }
}

fn make_op(kind: i32) -> dyn Op {
    if kind == 1 {
        Adder { n: 5 } as dyn Op
    } else {
        Multiplier { n: 3 } as dyn Op
    }
}

fn main() {
    let op = make_op(1);
    println(Op::apply(op, 10).to_string());
    let op2 = make_op(2);
    println(Op::apply(op2, 10).to_string());
}
