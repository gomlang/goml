fn make_state() -> ((i32) -> (), () -> i32, () -> ()) {
    let val = Ref::new(0);
    let set = |x| val.set(x);
    let get = || val.get();
    let inc = || val.set(val.get() + 1);
    (set, get, inc)
}

fn main() {
    let (set, get, inc) = make_state();
    set(10);
    println(get().to_string());
    inc();
    inc();
    println(get().to_string());
}
