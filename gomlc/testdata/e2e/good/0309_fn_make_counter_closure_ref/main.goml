fn make_counter() -> (() -> i32) {
    let count = Ref::new(0);
    || {
        let v = count.get() + 1;
        count.set(v);
        v
    }
}

fn main() {
    let counter = make_counter();
    println(counter().to_string());
    println(counter().to_string());
    println(counter().to_string());
}
