trait Op {
    fn run(self: Self, arg1: i32) -> i32;
}

struct Add {
    n: i32,
}

struct Mul {
    n: i32,
}

impl Op for Add {
    fn run(self: Add, x: i32) -> i32 {
        x + self.n
    }
}

impl Op for Mul {
    fn run(self: Mul, x: i32) -> i32 {
        x * self.n
    }
}

fn pipeline(ops: [dyn Op; 3], x: i32) -> i32 {
    let result = Ref::new(x);
    let i = Ref::new(0);
    while i.get() < 3 {
        result.set(Op::run(ops[i.get()], result.get()));
        i.set(i.get() + 1);
    }
    result.get()
}

fn main() {
    let ops: [dyn Op; 3] = [Add { n: 5 } as dyn Op, Mul { n: 2 } as dyn Op, Add { n: -3 } as dyn Op];
    println(pipeline(ops, 10).to_string());
}
