trait Describable {
    fn describe(self: Self) -> string;
}

struct Dog {
    name: string,
}

struct Car {
    brand: string,
}

impl Describable for Dog {
    fn describe(self: Dog) -> string {
        "Dog: " + self.name
    }
}

impl Describable for Car {
    fn describe(self: Car) -> string {
        "Car: " + self.brand
    }
}

fn print_desc(d: dyn Describable) {
    println(Describable::describe(d));
}

fn main() {
    let items: [dyn Describable; 2] = [
        Dog { name: "Rex" } as dyn Describable,
        Car { brand: "Toyota" } as dyn Describable,
    ];
    print_desc(items[0]);
    print_desc(items[1]);
}
