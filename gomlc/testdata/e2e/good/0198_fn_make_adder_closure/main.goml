fn make_adder(x: i32) -> (i32) -> i32 {
    |y| x + y
}

fn compose[A, B, C](f: (B) -> C, g: (A) -> B) -> (A) -> C {
    |x| f(g(x))
}

fn main() {
    let add5 = make_adder(5);
    println(add5(10).to_string());
    
    let add10 = compose(make_adder(3), make_adder(7));
    println(add10(0).to_string());
}
