trait Handler {
    fn handle(self: Self, arg1: string) -> string;
}

struct Upper {}

struct Lower {}

impl Handler for Upper {
    fn handle(self: Upper, s: string) -> string {
        "UPPER:" + s
    }
}

impl Handler for Lower {
    fn handle(self: Lower, s: string) -> string {
        "lower:" + s
    }
}

struct Pipeline {
    handler: dyn Handler,
}

fn run(p: Pipeline, input: string) -> string {
    Handler::handle(p.handler, input)
}

fn main() {
    let p1 = Pipeline { handler: Upper {} as dyn Handler };
    let p2 = Pipeline { handler: Lower {} as dyn Handler };
    println(run(p1, "test"));
    println(run(p2, "test"));
}
