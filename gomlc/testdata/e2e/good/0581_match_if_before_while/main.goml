enum E {
    A,
    B,
}

fn f(e: E, b: bool) -> i32 {
    match e {
        E::A => if b { () } else { () },
        E::B => (),
    };
    let i = Ref::new(0);
    while i.get() < 2 {
        i.set(i.get() + 1);
    };
    1
}

fn main() -> () {
    println(f(E::A, true));
    println(f(E::B, false));
}
