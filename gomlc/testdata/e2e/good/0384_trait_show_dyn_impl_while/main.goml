trait Show {
    fn show(self: Self) -> string;
}

struct Num {
    n: i32,
}

impl Show for Num {
    fn show(self: Num) -> string {
        self.n.to_string()
    }
}

struct Str {
    s: string,
}

impl Show for Str {
    fn show(self: Str) -> string {
        self.s
    }
}

fn main() {
    let display = |items: [dyn Show; 3]| {
        let i = Ref::new(0);
        while i.get() < 3 {
            println(Show::show(items[i.get()]));
            i.set(i.get() + 1);
        }
    };
    display([Num { n: 42 } as dyn Show, Str { s: "hello" } as dyn Show, Num { n: 99 } as dyn Show]);
}
