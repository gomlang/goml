trait Showable {
    fn display(self: Self) -> string;
}

struct Wrapped { label: string }

impl Showable for Wrapped {
    fn display(self: Wrapped) -> string { self.label }
}

fn wrap(x: i32) -> Wrapped {
    Wrapped { label: x.to_string() }
}

fn main() {
    println(Showable::display(wrap(42)));
}
