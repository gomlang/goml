trait Eval {
    fn eval(self: Self) -> i32;
}

struct Lit {
    val: i32,
}

struct Neg {
    val: i32,
}

impl Eval for Lit {
    fn eval(self: Lit) -> i32 {
        self.val
    }
}

impl Eval for Neg {
    fn eval(self: Neg) -> i32 {
        0 - self.val
    }
}

fn make_expr(positive: bool, n: i32) -> dyn Eval {
    if positive {
        Lit { val: n } as dyn Eval
    } else {
        Neg { val: n } as dyn Eval
    }
}

fn main() {
    let e1 = make_expr(true, 42);
    let e2 = make_expr(false, 10);
    println(Eval::eval(e1).to_string());
    println(Eval::eval(e2).to_string());
}
