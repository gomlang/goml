trait Formatter {
    fn format(self: Self, arg1: i32) -> string;
}

struct DecFormatter {}

struct HexFormatter {}

impl Formatter for DecFormatter {
    fn format(self: DecFormatter, n: i32) -> string {
        n.to_string()
    }
}

impl Formatter for HexFormatter {
    fn format(self: HexFormatter, n: i32) -> string {
        "0x" + n.to_string()
    }
}

struct Printer {
    fmt: dyn Formatter,
}

fn print_num(p: Printer, n: i32) -> () {
    println(Formatter::format(p.fmt, n));
}

fn main() {
    let p1 = Printer { fmt: DecFormatter {} as dyn Formatter };
    let p2 = Printer { fmt: HexFormatter {} as dyn Formatter };
    print_num(p1, 42);
    print_num(p2, 42);
}
