trait Container {
    fn size(self: Self) -> i32;
}

struct Bag {
    items: i32,
}

impl Container for Bag {
    fn size(self: Bag) -> i32 {
        self.items
    }
}

struct Box_ {
    items: i32,
}

impl Container for Box_ {
    fn size(self: Box_) -> i32 {
        self.items * 2
    }
}

fn total_size(a: dyn Container, b: dyn Container) -> i32 {
    Container::size(a) + Container::size(b)
}

fn main() {
    let bag = Bag { items: 5 };
    let box_ = Box_ { items: 3 };
    println(total_size(bag as dyn Container, box_ as dyn Container).to_string());
}
