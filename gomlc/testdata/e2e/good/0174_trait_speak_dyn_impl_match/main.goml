trait Speak {
    fn speak(self: Self) -> string;
}

struct Dog {}

struct Cat {}

impl Speak for Dog {
    fn speak(self: Dog) -> string {
        "woof"
    }
}

impl Speak for Cat {
    fn speak(self: Cat) -> string {
        "meow"
    }
}

fn choose(is_dog: bool) -> dyn Speak {
    match is_dog {
        true => Dog {} as dyn Speak,
        false => Cat {} as dyn Speak,
    }
}

fn main() {
    println(Speak::speak(choose(true)));
    println(Speak::speak(choose(false)));
}
