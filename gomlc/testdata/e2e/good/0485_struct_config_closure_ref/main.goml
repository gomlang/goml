struct Config {
    getter: () -> i32,
    setter: (i32) -> (),
}

fn make_config() -> Config {
    let state = Ref::new(0);
    Config {
        getter: || state.get(),
        setter: |v| state.set(v),
    }
}

fn main() {
    let c = make_config();
    c.setter(42);
    println(c.getter().to_string());
    c.setter(100);
    println(c.getter().to_string());
}
