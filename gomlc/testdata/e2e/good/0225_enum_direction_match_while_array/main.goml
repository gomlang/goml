enum Direction {
    Up,
    Down,
    Left,
    Right,
}

fn dir_to_string(d: Direction) -> string {
    match d {
        Direction::Up => "up",
        Direction::Down => "down",
        Direction::Left => "left",
        Direction::Right => "right",
    }
}

fn main() {
    let dirs: [Direction; 4] = [Direction::Up, Direction::Down, Direction::Left, Direction::Right];
    let i = Ref::new(0);
    while i.get() < 4 {
        println(dir_to_string(dirs[i.get()]));
        i.set(i.get() + 1);
    };
}
