trait Describable {
    fn describe(self: Self) -> string;
}

struct Pair[A, B] {
    first: A,
    second: B,
}

impl Describable for Pair[i32, string] {
    fn describe(self: Pair[i32, string]) -> string {
        "pair(" + self.first.to_string() + ", " + self.second + ")"
    }
}

fn main() {
    let p: Pair[i32, string] = Pair { first: 42, second: "hello" };
    println(Describable::describe(p));
}
