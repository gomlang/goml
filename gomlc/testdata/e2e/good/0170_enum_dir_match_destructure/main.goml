enum Dir { North, South, East, West }

fn move_pos(pos: (i32, i32), dir: Dir) -> (i32, i32) {
    let (x, y) = pos;
    match dir {
        Dir::North => (x, y + 1),
        Dir::South => (x, y - 1),
        Dir::East => (x + 1, y),
        Dir::West => (x - 1, y),
    }
}

fn main() {
    let pos = (0, 0);
    let pos = move_pos(pos, Dir::North);
    let pos = move_pos(pos, Dir::East);
    let pos = move_pos(pos, Dir::East);
    let pos = move_pos(pos, Dir::South);
    let (x, y) = pos;
    println(x.to_string());
    println(y.to_string());
}
