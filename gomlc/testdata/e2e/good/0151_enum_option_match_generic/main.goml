enum Option[T] {
    Some(T),
    None,
}

enum Result[T, E] {
    Ok(T),
    Err(E),
}

fn main() {
    let x: Option[u8] = Option::Some(42);
    match x {
        Option::Some(v) => println(v.to_string()),
        Option::None => println("none"),
    };
    
    let y: Option[f32] = Option::Some(3.14);
    match y {
        Option::Some(v) => println(v.to_string()),
        Option::None => println("none"),
    };
    
    let z: Result[i64, string] = Result::Ok(12345);
    match z {
        Result::Ok(v) => println(v.to_string()),
        Result::Err(e) => println(e),
    };
    
    let w: Option[i64] = Option::None;
    match w {
        Option::Some(v) => println(v.to_string()),
        Option::None => println("none"),
    };
}
