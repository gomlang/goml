struct Pair[A, B] {
    first: A,
    second: B,
}

trait Container {
    fn contents(self: Self) -> string;
}

impl Container for Pair[i32, string] {
    fn contents(self: Pair[i32, string]) -> string {
        self.second
    }
}

fn show_container(c: dyn Container) -> string {
    Container::contents(c)
}

fn main() {
    let p: Pair[i32, string] = Pair { first: 1, second: "hello" };
    println(show_container(p as dyn Container));
}
