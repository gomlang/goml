trait Speak {
    fn speak(self: Self) -> string;
}

struct Robot {}

struct Cat {}

impl Speak for Robot {
    fn speak(self: Robot) -> string {
        "beep boop"
    }
}

impl Speak for Cat {
    fn speak(self: Cat) -> string {
        "meow"
    }
}

fn make_speaker(kind: i32) -> dyn Speak {
    if kind == 0 {
        Robot {} as dyn Speak
    } else {
        Cat {} as dyn Speak
    }
}

fn main() {
    let s1 = make_speaker(0);
    let s2 = make_speaker(1);
    println(Speak::speak(s1));
    println(Speak::speak(s2));
}
