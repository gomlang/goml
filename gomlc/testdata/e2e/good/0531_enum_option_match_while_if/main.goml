enum Option[T] {
    Some(T),
    None,
}

fn find_first(items: [i32; 5], pred: (i32) -> bool) -> Option[i32] {
    let i = Ref::new(0);
    let result: Ref[Option[i32]] = Ref::new(Option::None);
    while i.get() < 5 {
        let item = items[i.get()];
        match result.get() {
            Option::None => {
                if pred(item) {
                    result.set(Option::Some(item));
                } else {
                    ()
                };
            },
            Option::Some(_) => (),
        };
        i.set(i.get() + 1);
    };
    result.get()
}

fn main() {
    let items = [1, 3, 5, 4, 2];
    match find_first(items, |x| x > 3) {
        Option::Some(v) => println(v.to_string()),
        Option::None => println("not found"),
    };
    match find_first(items, |x| x > 10) {
        Option::Some(v) => println(v.to_string()),
        Option::None => println("not found"),
    };
}
