struct Mapper {
    transform: (i32) -> i32,
}

fn use_mapper(m: Mapper, x: i32) -> i32 {
    let f = m.transform;
    f(x)
}

fn double(x: i32) -> i32 { x * 2 }

fn main() {
    let m1 = Mapper { transform: double };
    println(use_mapper(m1, 21).to_string());
    let m2 = Mapper { transform: |x| x + 1 };
    println(use_mapper(m2, 41).to_string());
}
