package fd;

use std::bytes::endian;
use std::internal::linux as kernel;
use std::io;
use std::testing;

fn record(name: Slice[byte]) -> Vec[byte] {
    let size = (20 + name.len() + 7) / 8 * 8;
    let data = kernel::zeroes(size);
    testing::expect_ok(endian::write_u64(data.as_mut_slice(), 0, 42, endian::Endian::Little), "inode");
    testing::expect_ok(endian::write_i64(data.as_mut_slice(), 8, -1, endian::Endian::Little), "offset");
    testing::expect_ok(endian::write_u16(data.as_mut_slice(), 16, size.to_u16(), endian::Endian::Little), "size");
    data[18] = 255;
    testing::assert(data.as_mut_slice().copy_from(19, name));
    data
}

#[test]
fn decodes_byte_names_and_preserves_kernel_metadata() -> () {
    let name = Vec::from_array([255.to_u8(), 254.to_u8()]);
    let data = record(name.as_slice());
    data[23] = 99;
    data.extend(record(b".".as_slice()));
    let entries = testing::expect_ok(decode_dirents(data.as_slice()), "decode");
    testing::assert_eq(entries.len(), 2);
    testing::assert(entries[0].name == name);
    testing::assert_eq(entries[0].inode, 42);
    testing::assert_eq(entries[0].next_offset, -1);
    testing::assert_eq(entries[0].kind, 255);
    testing::assert(entries[1].name == b".");
    testing::assert(testing::expect_ok(decode_dirents(b"".as_slice()), "empty").is_empty());
}

#[test]
fn rejects_truncated_and_malformed_kernel_records() -> () {
    let good = record(b"abc".as_slice());
    for length in 1..good.len() {
        testing::assert(decode_dirents(good.slice(0, length)).is_err());
    }
    for length in Vec::from_array([0, 1, 19, 20, 23, 25, 32, 65535]) {
        let data = record(b"abc".as_slice());
        testing::expect_ok(endian::write_u16(data.as_mut_slice(), 16, length.to_u16(), endian::Endian::Little), "invalid size");
        testing::assert(decode_dirents(data.as_slice()).is_err());
    }
    let missing_nul = record(b"abc".as_slice());
    for index in 19..missing_nul.len() { missing_nul[index] = 65; }
    testing::assert(decode_dirents(missing_nul.as_slice()).is_err());
    testing::assert(decode_dirents(record(b"".as_slice()).as_slice()).is_err());
    testing::assert(decode_dirents(record(b"a/b".as_slice()).as_slice()).is_err());
    let data = record(b"abc".as_slice());
    data.push(0);
    testing::assert(decode_dirents(data.as_slice()).is_err());
    testing::assert_eq(testing::expect_err(decode_dirents(data.as_slice()), "malformed").kind(), io::ErrorKind::InvalidData);
}
