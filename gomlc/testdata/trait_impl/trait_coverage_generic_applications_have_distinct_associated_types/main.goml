trait Convert[T] {
    type Output;
    fn convert(self: Self) -> Self::Output;
}

struct Value {}

impl Convert[i32] for Value {
    type Output = string;
    fn convert(self: Value) -> string { "isize" }
}

impl Convert[string] for Value {
    type Output = i32;
    fn convert(self: Value) -> i32 { 7 }
}

fn main() -> () {
    let text: string = Convert::[i32]::convert(Value {});
    let number: i32 = Convert::[string]::convert(Value {});
    let _ = (text, number);
}
