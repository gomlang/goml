trait Mark {
    fn mark(self: Self) -> ();
}

trait Source {
    type Item;
    fn get(self: Self) -> Self::Item;
}

fn require_mark[T: Mark](value: T) -> () { () }

fn consume[A: Source, B: Source](left: A, right: B) -> ()
where
    A::Item = B::Item,
    B::Item: Mark,
{
    let _ = right;
    require_mark(Source::get(left))
}

fn main() -> () { () }
