trait Convert[T] {
    fn convert(self: Self) -> T;
}

struct Token {}

impl Convert[i32] for Token {
    fn convert(self: Token) -> i32 { 7 }
}

impl Convert[string] for Token {
    fn convert(self: Token) -> string { "seven" }
}

fn main() -> () {
    let number: i32 = (Token {}).convert();
    let text: string = (Token {}).convert();
    ()
}
