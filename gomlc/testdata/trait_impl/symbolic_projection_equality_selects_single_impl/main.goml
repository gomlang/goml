trait Source {
    type Item;
    fn get(self: Self) -> Self::Item;
}

trait Pick[T] {
    fn pick(self: Self) -> T;
}

impl[S: Source, T] Pick[T] for S where S::Item = T {
    fn pick(self: S) -> T { Source::get(self) }
}

fn invoke[T, S: Pick[T]](source: S) -> T {
    source.pick()
}

fn generic_pick[S: Source](source: S) -> S::Item {
    invoke(source)
}

fn main() -> () { () }
