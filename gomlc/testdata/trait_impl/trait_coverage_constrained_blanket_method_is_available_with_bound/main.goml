trait Mark {
    fn mark(self: Self) -> ();
}

trait Extra {
    fn extra(self: Self) -> i32;
}

impl Mark for i32 {
    fn mark(self: i32) -> () { () }
}

impl[T: Mark] Extra for T {
    fn extra(self: T) -> i32 { 1 }
}

fn main() -> () {
    let source: i32 = 1;
    let value: i32 = source.extra();
    let _ = value;
}
