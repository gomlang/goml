trait First {
    fn first(self: Self) -> ();
}

trait Second {
    fn second(self: Self) -> ();
}

impl First for i32 {
    fn first(self: i32) -> () { () }
}

impl First for string {
    fn first(self: string) -> () { () }
}

impl Second for string {
    fn second(self: string) -> () { () }
}

fn require_first[T: First](value: T) -> () {
    ()
}

fn require_second[T: Second](value: T) -> () {
    ()
}

fn main() -> () {
    let consume = |value| {
        require_first(value);
        require_second(value)
    };
    ()
}
