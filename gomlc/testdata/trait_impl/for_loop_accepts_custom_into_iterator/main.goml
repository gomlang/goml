struct Values {
    values: Vec[i32],
}

impl IntoIterator for Values {
    type Item = i32;
    type IntoIter = FnIterator[i32];

    fn into_iter(self: Values) -> FnIterator[i32] {
        self.values.iter()
    }
}

fn consume_int(value: i32) -> () { () }

fn main() -> () {
    for value in (Values { values: Vec::new() }) {
        consume_int(value);
    };
}
