trait Child: Left + Right {
    fn child(self: Self) -> ();
}

trait Left: Base {
    fn left(self: Self) -> ();
}

trait Right: Base {
    fn right(self: Self) -> ();
}

trait Base {
    fn base(self: Self) -> string;
}

fn inherited[T: Child](value: T) -> string {
    value.base()
}

fn main() -> () { () }
