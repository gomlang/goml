trait Source {
    type Item;
    fn get(self: Self) -> Self::Item;
}

trait Pick[T] {
    fn pick(self: Self) -> T;
}

impl[S: Source] Pick[S::Item] for S {
    fn pick(self: S) -> S::Item { Source::get(self) }
}

struct Value { value: i32 }

impl Source for Value {
    type Item = i32;
    fn get(self: Value) -> i32 { self.value }
}

fn main() -> () {
    let value: i32 = (Value { value: 1 }).pick();
    let _ = value;
}
