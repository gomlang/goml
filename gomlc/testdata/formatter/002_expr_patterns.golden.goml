struct Pair {
    left: i32,
    right: i32,
}

enum Maybe {
    None,
    Some(i32),
}

fn classify(value: Maybe, numbers: Vec[i32]) -> string {
    let selected = if true {
        1
    } else {
        2
    };
    while selected < 0 {
        break
    }
    for number in numbers {
        let _ = number;
    }
    match value {
        whole @ Maybe::Some(inner) if inner > 10 => "large",
        Maybe::Some(0 | 1) => "small",
        Maybe::Some(2..=9) => "middle",
        Maybe::None => "none",
    }
}

fn arrays(values: [i32; 4]) -> i32 {
    let [first, middle @ .., last] = values;
    let tuple = (first, last);
    let vector = Vec::from_array([first, last]);
    let table = HashMap::from_array([("first", first), ("last", last)]);
    let closure = |value: i32| value + table.get("first").unwrap_or(0);
    closure(tuple.0) + vector[1] + array_get(middle, 0)
}
