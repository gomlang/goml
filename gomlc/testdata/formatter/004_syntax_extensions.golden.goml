package syntax;

trait Consumer[T] {
    type Output;
    fn consume(self, value: T) -> Self::Output;
}

trait Label {
    fn label(self) -> string;
}

fn repeat[T, const N: usize](value: T) -> [T; N] {
    [value; N + 0]
}

fn opaque[T: Consumer[string] + Label](value: T) -> impl Consumer[string, Output = isize] + Label
where
    T::Output = isize,
{
    value
}

fn erase[T: Consumer[string] + Label](value: T) -> dyn Consumer[string, Output = isize] + Label
where
    T::Output = isize,
{
    value as dyn Consumer[string, Output = isize] + Label
}

fn choose(left: Option[isize], right: Option[isize]) -> Option[isize] {
    if let Some(a) = left && a > 0 && let Some(b) = right && (b == a || b > a) {
        Some(a + b)
    } else {
        None
    }
}

fn drain(next: () -> Option[isize]) -> () {
    while let Some(value) = next() && value > 0 {
        println(value);
    }
}

fn constructors() -> () {
    let make: (isize) -> Option[isize] = Some;
    let nested: Option[Result[isize, string]] = Some(Ok(make(42).unwrap_or(0)));
}
