package macros;

pub trait Label {
    fn label() -> string;
}

#[comptime_derive(Generated)]
pub fn generated(input: DeriveInput) -> DeriveOutput {
    let output = derive_output_inherent(input);
    derive_output_add_method(
        output,
        meta_method(
            "secret",
            meta_param_list_new(),
            meta_type_call_site("string"),
            meta_expr_string("secret"),
        ),
    );
    output
}
