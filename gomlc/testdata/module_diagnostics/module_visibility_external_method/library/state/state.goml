package state;

pub struct Value[T] { pub value: T }

impl Value[isize] {
    fn private_read(self: Value[isize]) -> isize { self.value }
    pub fn read(self: Value[isize]) -> isize { self.private_read() }
}

impl Value[string] {
    pub(module) fn read(self: Value[string]) -> string { self.value }
}
