package anf;

use module::repr;
use std::testing;

#[test]
fn simplification_converges_after_removing_an_unreachable_assignment() -> () {
    let body = Block {
        binds: Vec::from_array([scope_let("source"), simplify_test_alias("alias", "source")]),
        term: Term::If {
            cond: Imm::Prim { value: repr::Primitive::Bool { value: true }, ty: repr::Type::Bool },
            then_: scope_return(scope_var("alias")),
            else_: Block {
                binds: Vec::from_array(
                    [
                        Bind::Let(
                            LetBind {
                                name: "write",
                                value: Value::Assign {
                                    name: "source",
                                    value: scope_int(),
                                    target_ty: repr::Type::Int32,
                                    ty: repr::Type::Unit,
                                },
                                ty: repr::Type::Unit,
                            },
                        ),
                    ],
                ),
                term: Term::Return(scope_var("source")),
            },
            ret_ty: repr::Type::Int32,
        },
    };
    let changed = Ref::new(false);
    let first = simplify_known_block(body, changed);
    testing::assert(changed.get());
    assert_simplified_return(first, "alias");
    let result = simplify(verifier_file(body, repr::Type::Int32));
    assert_simplified_return(result.functions[0].body, "source");
    if let Err(message) = verify(result) {
        testing::fail(message)
    }
}

#[test]
fn simplification_reports_stable_values_and_join_removal() -> () {
    let stable = Block {
        binds: Vec::from_array([scope_let("value")]),
        term: Term::Return(scope_var("value")),
    };
    let changed = Ref::new(false);
    let stable = simplify_join_block(simplify_known_block(stable, changed), changed);
    testing::assert(!changed.get());
    assert_simplified_return(stable, "value");
    let unused = Block {
        binds: Vec::from_array(
            [Bind::Join(scope_join("unused", Vec::new(), scope_return(scope_int())))],
        ),
        term: Term::Return(scope_int()),
    };
    let result = simplify_join_block(unused, changed);
    testing::assert(changed.get());
    testing::assert(result.binds.is_empty());
    changed.set(false);
    let _ = simplify_join_block(result, changed);
    testing::assert(!changed.get())
}

#[test]
fn simplification_records_projection_and_alias_changes() -> () {
    let known = Vec::from_array(
        [
            KnownBinding { name: "alias", value: KnownValue::Alias(scope_var("source")) },
            KnownBinding {
                name: "pair",
                value: KnownValue::Tuple {
                    items: Vec::from_array([scope_var("source")]),
                    ty: repr::Type::Tuple { items: Vec::from_array([repr::Type::Int32]) },
                },
            },
        ],
    );
    for value in Vec::from_array(
        [
            Value::Imm(scope_var("alias")),
            Value::Proj {
                tuple: Imm::Var {
                    name: "pair",
                    ty: repr::Type::Tuple { items: Vec::from_array([repr::Type::Int32]) },
                },
                index: 0,
                ty: repr::Type::Int32,
            },
        ],
    ) {
        let changed = Ref::new(false);
        match simplify_known_value(value, known, changed) {
            Imm(Var { name, .. }) => testing::assert_eq(name, "source"),
            _ => testing::fail("expected propagated value"),
        }
        testing::assert(changed.get())
    }
}
