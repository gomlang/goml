package anf;

use module::repr;
use std::collections;
use std::testing;

fn simplify_test_alias(name: string, source: string) -> Bind {
    Bind::Let(LetBind { name, value: Value::Imm(scope_var(source)), ty: repr::Type::Int32 })
}

fn assert_simplified_return(value: Block, expected: string) -> () {
    match value.term {
        Return(Var { name, .. }) => testing::assert_eq(name, expected),
        _ => testing::fail("expected variable return"),
    }
}

#[test]
fn known_bindings_restore_parent_and_isolate_sibling_branches() -> () {
    let known = Vec::from_array(
        [KnownBinding { name: "outer", value: KnownValue::Alias(scope_var("source")) }],
    );
    let branch = Block {
        binds: Vec::from_array([simplify_test_alias("outer", "left")]),
        term: Term::Return(scope_var("outer")),
    };
    let body = Block {
        binds: Vec::from_array([simplify_test_alias("local", "outer")]),
        term: Term::If {
            cond: Imm::Var { name: "flag", ty: repr::Type::Bool },
            then_: branch,
            else_: scope_return(scope_var("outer")),
            ret_ty: repr::Type::Int32,
        },
    };
    let result = simplify_known_block_with(body, known, collections::HashSet::new());
    match result.term {
        If { then_, else_, .. } => {
            assert_simplified_return(then_, "left");
            assert_simplified_return(else_, "source")
        },
        _ => testing::fail("expected conditional branches"),
    }
    testing::assert_eq(known.len(), 1);
    testing::assert(find_known_binding(known, "local").is_none());
    assert_simplified_return(
        simplify_known_block_with(branch, known, collections::HashSet::new()),
        "left",
    );
    testing::assert_eq(known.len(), 1);
    assert_simplified_return(
        simplify_known_block_with(
            scope_return(scope_var("outer")),
            known,
            collections::HashSet::new(),
        ),
        "source",
    )
}

#[test]
fn simplify_join_lists_preserve_order_and_forwarded_arguments() -> () {
    let binds: Vec[Bind] = Vec::new();
    binds.push(
        Bind::Join(
            scope_join(
                "done",
                Vec::from_array([("result", repr::Type::Int32)]),
                scope_return(scope_var("result")),
            ),
        ),
    );
    for index in 0..1024 {
        binds.push(scope_let("value" + index.to_string()))
    }
    binds.push(
        Bind::Join(
            scope_join(
                "forward",
                Vec::from_array([("argument", repr::Type::Int32)]),
                Block {
                    binds: Vec::new(),
                    term: Term::Jump {
                        target: "done",
                        args: Vec::from_array([scope_var("argument")]),
                        ret_ty: repr::Type::Int32,
                    },
                },
            ),
        ),
    );
    let original = Block {
        binds,
        term: Term::Jump {
            target: "forward",
            args: Vec::from_array([scope_var("value0")]),
            ret_ty: repr::Type::Int32,
        },
    };
    let result = simplify_join_block(original);
    testing::assert_eq(original.binds.len(), 1026);
    testing::assert_eq(result.binds.len(), 1024);
    for index in 0..result.binds.len() {
        match result.binds[index] {
            Let(value) => testing::assert_eq(value.name, "value" + index.to_string()),
            _ => testing::fail("expected ordered let bindings"),
        }
    }
    assert_simplified_return(result, "value0");
    if let Err(message) = verify(verifier_file(result, repr::Type::Int32)) {
        testing::fail(message)
    }
}
