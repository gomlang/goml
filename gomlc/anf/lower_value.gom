package anf;

use module::lift;
use module::repr;

fn try_imm(value: lift::Expr) -> Option[Imm] {
    match value {
        Var { name, ty } => Option::Some(Imm::Var { name, ty }),
        Callable { callable, ty } => {
            Option::Some(Imm::Callable { callable, ty })
        },
        Prim { value, ty } => Option::Some(Imm::Prim { value, ty }),
        Constr { constructor, args, ty } => if args.is_empty() {
            constructor.tag.map(|tag| Imm::Tag { index: tag, ty })
        } else {
            Option::None
        },
        _ => Option::None,
    }
}

fn match_imm(value: lift::Expr) -> Imm {
    match value {
        Constr { constructor, args: _, ty } => match constructor.tag {
            Some(tag) => Imm::Tag { index: tag, ty },
            None => unit_imm(),
        },
        other => try_imm(other).unwrap_or_else(|| unit_imm()),
    }
}

fn bind_value(state: State, value: Value, k: (Imm) -> Block) -> Block {
    let ty = value_type(value);
    let name = fresh(state, "t");
    let block = match repr::resolve_type(ty) {
        Never => unreachable_block(state),
        _ => k(Imm::Var { name, ty }),
    };
    prepend_bind(Bind::Let(LetBind { name, value, ty }), block)
}

fn lower_imm(state: State, value: lift::Expr, k: (Imm) -> Block) -> Block {
    match try_imm(value) {
        Some(value) => k(value),
        None => lower_value(
            state,
            value,
            |value| {
                bind_value(state, value, k)
            },
        ),
    }
}

fn lower_list_from(
    state: State,
    values: Vec[lift::Expr],
    index: isize,
    result: Vec[Imm],
    k: (Vec[Imm]) -> Block,
) -> Block {
    if index >= values.len() {
        k(result)
    } else {
        lower_expr(
            state,
            values[index],
            |value| {
                result.push(value);
                lower_list_from(state, values, index + 1, result, k)
            },
        )
    }
}

fn lower_list(state: State, values: Vec[lift::Expr], k: (Vec[Imm]) -> Block) -> Block {
    if all_immediate(values) {} else {
        let start = state.counter.get();
        if probe_linear_list(state, values) {
            state.counter.set(start)
        }
    }
    let result: Vec[Imm] = Vec::new();
    lower_list_from(state, values, 0, result, k)
}

fn lower_value(state: State, value: lift::Expr, k: (Value) -> Block) -> Block {
    let ty = lift::expr_type(value);
    match try_imm(value) {
        Some(value) => k(Value::Imm(value)),
        None => match value {
            Constr { constructor, args, ty: _ } => {
                lower_list(
                    state,
                    args,
                    |args| {
                        k(Value::Constr { constructor, args, ty })
                    },
                )
            },
            Tuple { items, ty: _ } => lower_list(
                state,
                items,
                |items| {
                    k(Value::Tuple { items, ty })
                },
            ),
            Array { items, ty: _ } => lower_list(
                state,
                items,
                |items| {
                    k(Value::Array { items, ty })
                },
            ),
            ConstrGet { expr, constructor, field_index: index, ty: _ } => {
                lower_expr(
                    state,
                    expr,
                    |expr| {
                        k(Value::ConstrGet { expr, constructor, field_index: index, ty })
                    },
                )
            },
            Unary { op, expr, ty: _ } => lower_expr(
                state,
                expr,
                |expr| {
                    k(Value::Unary { op, expr, ty })
                },
            ),
            Cast { expr, ty: _ } => lower_expr(
                state,
                expr,
                |expr| {
                    k(Value::Cast { expr, ty })
                },
            ),
            Binary { op, lhs, rhs, ty: _ } => lower_expr(
                state,
                lhs,
                |lhs| {
                    lower_expr(
                        state,
                        rhs,
                        |rhs| {
                            k(Value::Binary { op, lhs, rhs, ty })
                        },
                    )
                },
            ),
            Assign { name, value: expr, target_ty, ty: _ } => {
                lower_expr(
                    state,
                    expr,
                    |expr| {
                        k(Value::Assign { name, value: expr, target_ty, ty })
                    },
                )
            },
            Call { func, args, ty: _ } => lower_expr(
                state,
                func,
                |func| {
                    lower_list(
                        state,
                        args,
                        |args| {
                            k(Value::Call { func, args, ty })
                        },
                    )
                },
            ),
            ToDyn { trait_name, for_ty, expr, ty: _ } => {
                lower_expr(
                    state,
                    expr,
                    |expr| {
                        k(Value::ToDyn { trait_name, for_ty, expr, ty })
                    },
                )
            },
            DynCall { trait_name, method_name, receiver, args, ty: _ } => {
                lower_expr(
                    state,
                    receiver,
                    |receiver| {
                        lower_list(
                            state,
                            args,
                            |args| {
                                k(Value::DynCall { trait_name, method_name, receiver, args, ty })
                            },
                        )
                    },
                )
            },
            Go { expr, ty: _ } => lower_expr(
                state,
                expr,
                |expr| {
                    k(Value::Go { closure: expr, ty })
                },
            ),
            PackClosure { environment, apply, ty: _ } => lower_expr(
                state,
                environment,
                |environment| {
                    k(Value::PackClosure { environment, apply, ty })
                },
            ),
            Proj { tuple: expr, index, ty: _ } => lower_expr(
                state,
                expr,
                |expr| {
                    k(Value::Proj { tuple: expr, index, ty })
                },
            ),
            other => lower_expr(state, other, |value| k(Value::Imm(value))),
        },
    }
}
