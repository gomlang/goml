package anf;

use module::ast;
use module::repr;
use std::collections;
use std::text;

struct JoinSignature {
    name: string,
    params: Vec[(string, repr::Type)],
    ret_ty: repr::Type,
}

struct VerifyState {
    join_names: collections::HashSet[string],
    scope: VerifyScope,
    closures: HashMap[string, repr::ClosureDef],
    structs: HashMap[string, repr::StructDef],
    enums: HashMap[string, repr::EnumDef],
}

fn copy_join_signatures(values: Vec[JoinSignature]) -> Vec[JoinSignature] {
    let result: Vec[JoinSignature] = Vec::with_capacity(values.len());
    for value in values {
        result.push(value)
    }
    result
}

fn find_join_signature(values: Vec[JoinSignature], name: string) -> Option[JoinSignature] {
    let mut index = values.len() - 1;
    while index >= 0 {
        let value = values[index];
        if value.name == name {
            return Option::Some(value)
        } else {
            index -= 1;
        }
    }
    Option::None
}

fn verify_type(actual: repr::Type, expected: repr::Type, message: string) -> Result[(), string] {
    repr::validate_type(actual)?;
    repr::validate_type(expected)?;
    let actual_resolved = repr::resolve_type(actual);
    let expected_resolved = repr::resolve_type(expected);
    let compatible = match actual_resolved {
        Never => true,
        _ => repr::types_equal(actual_resolved, expected_resolved),
    };
    if compatible {
        Result::Ok(())
    } else {
        Result::Err(
            message + ": expected " + repr::diagnostic_type_text(expected) + ", found "
                + repr::diagnostic_type_text(actual),
        )
    }
}

fn verify_imm(state: VerifyState, value: Imm) -> Result[(), string] {
    repr::validate_type(imm_type(value))?;
    match value {
        Var { name, ty } => verify_variable(state.scope, name, ty),
        Callable { callable: InterfaceBridge(value), ty } => repr::validate_go_interface_bridge(
            value,
            ty,
        ),
        Callable { callable: CallbackAdapter(value), ty } => repr::validate_callback_adapter(
            value,
            ty,
        ),
        Callable { .. } | Prim { .. } | Tag { .. } => Result::Ok(()),
    }
}

fn verify_imms(state: VerifyState, values: Vec[Imm]) -> Result[(), string] {
    for value in values {
        verify_imm(state, value)?
    }
    Result::Ok(())
}

fn nominal_type_name(value: repr::Type) -> Option[string] {
    match value {
        Named { name } | ClosureEnvironment { name } => Option::Some(name),
        _ => Option::None,
    }
}

fn constructor_variant_name(value: string) -> string {
    match text::rfind(value, "::") {
        Some(index) => value.byte_slice(index + 2, value.byte_len()),
        None => value,
    }
}

fn enum_variant_types(value: repr::EnumVariantFields) -> Vec[repr::Type] {
    match value {
        Unit => Vec::new(),
        Tuple(values) => values,
        Struct(fields) => {
            let result: Vec[repr::Type] = Vec::with_capacity(fields.len());
            for field in fields {
                result.push(field.1)
            }
            result
        },
    }
}

fn find_struct_field(value: repr::StructDef, name: string) -> Option[repr::Type] {
    for field in value.fields {
        if field.0 == name {
            return Option::Some(field.1)
        }
    }
    Option::None
}

fn verify_constructor(
    state: VerifyState,
    constructor: repr::Constructor,
    args: Vec[Imm],
    ty: repr::Type,
) -> Result[(), string] {
    let owner = nominal_type_name(ty).ok_or("constructor result has a non-nominal type")?;
    let expected: Vec[repr::Type] = if constructor.is_struct {
        let definition = state.structs[owner].ok_or(
            "constructor references unknown struct " + owner,
        )?;
        if constructor.fields.is_empty() {
            let fields: Vec[repr::Type] = Vec::with_capacity(definition.fields.len());
            for field in definition.fields {
                fields.push(field.1)
            }
            fields
        } else {
            let fields: Vec[repr::Type] = Vec::with_capacity(constructor.fields.len());
            for field in constructor.fields {
                match find_struct_field(definition, field) {
                    Some(value) => fields.push(value),
                    None => return Result::Err(
                        "constructor references unknown field " + owner + "." + field,
                    ),
                }
            }
            fields
        }
    } else {
        let definition = state.enums[owner].ok_or("constructor references unknown enum " + owner)?;
        let name = constructor_variant_name(constructor.name);
        let mut found: Option[Vec[repr::Type]] = Option::None;
        for variant in definition.variants {
            if variant.name == name {
                found = Option::Some(enum_variant_types(variant.fields));
            }
        }
        match found {
            Some(value) => value,
            None => return Result::Err(
                "constructor references unknown variant " + owner + "::" + name,
            ),
        }
    };
    if args.len() != expected.len() {
        return Result::Err("constructor argument count does not match " + constructor.name)
    }
    for index in 0..args.len() {
        verify_type(
            imm_type(args[index]),
            expected[index],
            "constructor argument type does not match " + constructor.name,
        )?
    }
    Result::Ok(())
}

fn verify_join_name(state: VerifyState, name: string) -> Result[(), string] {
    if state.join_names.insert(name) {
        Result::Ok(())
    } else {
        Result::Err("duplicate join " + name)
    }
}

fn join_signature(value: JoinBind) -> JoinSignature {
    JoinSignature { name: value.name, params: value.params, ret_ty: value.ret_ty }
}

fn verify_join_signature(value: JoinBind) -> Result[(), string] {
    for param in value.params {
        repr::validate_type(param.1)?
    }
    repr::validate_type(value.ret_ty)
}

fn verify_jump(
    state: VerifyState,
    target: string,
    args: Vec[Imm],
    ret_ty: repr::Type,
    expected_ty: repr::Type,
    joins: Vec[JoinSignature],
) -> Result[(), string] {
    let signature = find_join_signature(joins, target).ok_or("jump to out-of-scope join " + target)?;
    if args.len() != signature.params.len() {
        return Result::Err("jump argument count does not match join " + target)
    }
    for index in 0..args.len() {
        verify_type(
            imm_type(args[index]),
            signature.params[index].1,
            "jump argument type does not match join " + target,
        )?;
        verify_imm(state, args[index])?
    }
    verify_type(ret_ty, signature.ret_ty, "jump result type does not match join " + target)?;
    verify_type(ret_ty, expected_ty, "jump result type does not match its block")
}

fn verify_match_arm_type(scrutinee: Imm, arm: Arm) -> Result[(), string] {
    verify_type(
        imm_type(arm.lhs),
        imm_type(scrutinee),
        "match arm type does not match its scrutinee",
    )
}

fn verify_term(state: VerifyState, value: Term, expected_ty: repr::Type, joins: Vec[JoinSignature]) -> Result[
    (),
    string,
] {
    match value {
        Return(value) => {
            verify_imm(state, value)?;
            verify_type(imm_type(value), expected_ty, "return type does not match its block")
        },
        Jump { target, args, ret_ty } => verify_jump(
            state,
            target,
            args,
            ret_ty,
            expected_ty,
            joins,
        ),
        If { cond, then_, else_, ret_ty } => {
            verify_imm(state, cond)?;
            verify_type(imm_type(cond), repr::Type::Bool, "if condition is not bool")?;
            verify_type(ret_ty, expected_ty, "if result type does not match its block")?;
            verify_block(state, then_, ret_ty, copy_join_signatures(joins))?;
            verify_block(state, else_, ret_ty, copy_join_signatures(joins))
        },
        Match { scrutinee, arms, default, ret_ty } => {
            verify_imm(state, scrutinee)?;
            verify_type(ret_ty, expected_ty, "match result type does not match its block")?;
            for arm in arms {
                verify_imm(state, arm.lhs)?;
                verify_match_arm_type(scrutinee, arm)?;
                verify_block(state, arm.body, ret_ty, copy_join_signatures(joins))?
            }
            match default {
                Some(body) => verify_block(state, body, ret_ty, copy_join_signatures(joins)),
                None => Result::Ok(()),
            }
        },
        Select { arms, default, ret_ty, .. } => {
            verify_type(ret_ty, expected_ty, "select result type does not match its block")?;
            for arm in arms {
                match arm {
                    Receive { channel, guard, binding, binding_ty, body } => {
                        verify_imm(state, channel)?;
                        repr::validate_type(binding_ty)?;
                        match repr::resolve_type(imm_type(channel)) {
                            Channel { elem: _, direction: ast::ChannelDirection::Both } | Channel {
                                elem: _,
                                direction: ast::ChannelDirection::Receive,
                            } => (),
                            Channel { elem: _, direction: ast::ChannelDirection::Send } => {
                                return Result::Err("select receive operand is send-only")
                            },
                            _ => return Result::Err("select receive operand is not a channel"),
                        }
                        if let Some(value) = guard {
                            verify_imm(state, value)?;
                            verify_type(
                                imm_type(value),
                                repr::Type::Bool,
                                "select guard is not bool",
                            )?
                        }
                        let branch = verify_child_state(state);
                        verify_bind_variable(branch.scope, binding, binding_ty)?;
                        verify_block(branch, body, ret_ty, copy_join_signatures(joins))?
                    },
                    Send { channel, value, guard, body } => {
                        verify_imm(state, channel)?;
                        verify_imm(state, value)?;
                        match repr::resolve_type(imm_type(channel)) {
                            Channel { elem, direction: ast::ChannelDirection::Both } | Channel {
                                elem,
                                direction: ast::ChannelDirection::Send,
                            } => verify_type(
                                imm_type(value),
                                elem,
                                "select send value type does not match its channel",
                            )?,
                            Channel { elem: _, direction: ast::ChannelDirection::Receive } => {
                                return Result::Err("select send operand is receive-only")
                            },
                            _ => return Result::Err("select send operand is not a channel"),
                        }
                        if let Some(value) = guard {
                            verify_imm(state, value)?;
                            verify_type(
                                imm_type(value),
                                repr::Type::Bool,
                                "select guard is not bool",
                            )?
                        }
                        verify_block(state, body, ret_ty, copy_join_signatures(joins))?
                    },
                }
            }
            match default {
                Some(body) => verify_block(state, body, ret_ty, copy_join_signatures(joins)),
                None => Result::Ok(()),
            }
        },
        Unreachable { ty } => verify_type(
            ty,
            expected_ty,
            "unreachable type does not match its block",
        ),
    }
}

fn verify_nonrecursive_join(state: VerifyState, value: JoinBind, joins: Vec[JoinSignature]) -> Result[
    (),
    string,
] {
    verify_join_name(state, value.name)?;
    verify_join_signature(value)?;
    verify_join_body(state, value, joins)
}

fn verify_recursive_joins(state: VerifyState, values: Vec[JoinBind], joins: Vec[JoinSignature]) -> Result[
    Vec[JoinSignature],
    string,
] {
    if values.is_empty() {
        return Result::Err("recursive join group is empty")
    }
    let recursive = copy_join_signatures(joins);
    for value in values {
        verify_join_name(state, value.name)?;
        verify_join_signature(value)?;
        recursive.push(join_signature(value))
    }
    for value in values {
        verify_join_body(state, value, recursive)?
    }
    Result::Ok(recursive)
}

fn verify_value(state: VerifyState, value: Value) -> Result[(), string] {
    match value {
        Imm(value) => verify_imm(state, value),
        Constr { constructor, args, ty } => {
            verify_imms(state, args)?;
            verify_constructor(state, constructor, args, ty)
        },
        Tuple { items, ty } => {
            verify_imms(state, items)?;
            match ty {
                Tuple { items: expected } => {
                    if items.len() != expected.len() {
                        return Result::Err("tuple value has the wrong number of items")
                    }
                    for index in 0..items.len() {
                        verify_type(
                            imm_type(items[index]),
                            expected[index],
                            "tuple item type does not match",
                        )?
                    }
                    Result::Ok(())
                },
                _ => Result::Err("tuple value has a non-tuple type"),
            }
        },
        Array { items, ty } => {
            verify_imms(state, items)?;
            match ty {
                Array { len, elem } => {
                    if len != items.len() {
                        return Result::Err("array value has the wrong number of items")
                    }
                    for item in items {
                        verify_type(imm_type(item), elem, "array item type does not match")?
                    }
                    Result::Ok(())
                },
                _ => Result::Err("array value has a non-array type"),
            }
        },
        ConstrGet { expr, constructor, field_index, ty } => {
            verify_imm(state, expr)?;
            let owner = nominal_type_name(imm_type(expr)).ok_or(
                "constructor projection has a non-nominal source",
            )?;
            let fields: Vec[repr::Type] = if constructor.is_struct {
                let definition = state.structs[owner].ok_or(
                    "constructor projection references unknown struct " + owner,
                )?;
                let result: Vec[repr::Type] = Vec::with_capacity(definition.fields.len());
                for field in definition.fields {
                    result.push(field.1)
                }
                result
            } else {
                let definition = state.enums[owner].ok_or(
                    "constructor projection references unknown enum " + owner,
                )?;
                let name = constructor_variant_name(constructor.name);
                let mut found: Option[Vec[repr::Type]] = Option::None;
                for variant in definition.variants {
                    if variant.name == name {
                        found = Option::Some(enum_variant_types(variant.fields));
                    }
                }
                found.ok_or(
                    "constructor projection references unknown variant " + owner + "::" + name,
                )?
            };
            if field_index < 0 || field_index >= fields.len() {
                Result::Err("constructor projection field index is out of bounds")
            } else {
                verify_type(ty, fields[field_index], "constructor projection type does not match")
            }
        },
        Unary { op: _, expr, ty: _ } | Cast { expr, ty: _ } => verify_imm(state, expr),
        Binary { op: _, lhs, rhs, ty: _ } => {
            verify_imm(state, lhs)?;
            verify_imm(state, rhs)
        },
        Assign { name, value, target_ty, ty: _ } => {
            verify_variable(state.scope, name, target_ty)?;
            verify_imm(state, value)?;
            verify_type(imm_type(value), target_ty, "assignment value type does not match")
        },
        Call { func, args, ty } => {
            verify_imm(state, func)?;
            verify_imms(state, args)?;
            match imm_type(func) {
                Func { params, ret_ty } => {
                    if args.len() != params.len() {
                        return Result::Err("call argument count does not match its function")
                    }
                    for index in 0..args.len() {
                        verify_type(
                            imm_type(args[index]),
                            params[index],
                            "call argument type does not match",
                        )?
                    }
                    verify_type(ty, ret_ty, "call return type does not match")
                },
                _ => Result::Err("call target has a non-function type"),
            }
        },
        ToDyn { trait_name: _, for_ty, expr, ty: _ } => {
            verify_imm(state, expr)?;
            verify_type(imm_type(expr), for_ty, "dynamic conversion source type does not match")
        },
        DynCall { trait_name: _, method_name: _, receiver, args, ty: _ } => {
            verify_imm(state, receiver)?;
            verify_imms(state, args)
        },
        Go { closure, ty: _ } => verify_imm(state, closure),
        PackClosure { environment, apply, ty } => {
            verify_imm(state, environment)?;
            match ty {
                Func { params: _, ret_ty: _ } => (),
                _ => return Result::Err("closure pack has a non-function type"),
            }
            let definition = state.closures[apply].ok_or(
                "closure pack references unknown apply function " + apply,
            )?;
            verify_type(ty, definition.signature, "closure pack signature does not match " + apply)?;
            match imm_type(environment) {
                ClosureEnvironment { name } if name == definition.environment => Result::Ok(()),
                _ => Result::Err("closure pack environment does not match " + apply),
            }
        },
        Proj { tuple, index, ty } => {
            verify_imm(state, tuple)?;
            match imm_type(tuple) {
                Tuple { items } => if index < 0 || index >= items.len() {
                    Result::Err("tuple projection index is out of bounds")
                } else {
                    verify_type(ty, items[index], "tuple projection type does not match")
                },
                _ => Result::Err("tuple projection has a non-tuple source"),
            }
        },
    }
}

fn verify_block(
    state: VerifyState,
    value: Block,
    expected_ty: repr::Type,
    parent_joins: Vec[JoinSignature],
) -> Result[(), string] {
    let joins = copy_join_signatures(parent_joins);
    let state = verify_child_state(state);
    for bind in value.binds {
        match bind {
            Let(value) => {
                verify_value(state, value.value)?;
                verify_type(
                    value_type(value.value),
                    value.ty,
                    "let binding type does not match " + value.name,
                )?;
                verify_bind_variable(state.scope, value.name, value.ty)?
            },
            Join(value) => {
                verify_nonrecursive_join(state, value, joins)?;
                joins.push(join_signature(value))
            },
            JoinRec(values) => {
                let recursive = verify_recursive_joins(state, values, joins)?;
                for index in joins.len()..recursive.len() {
                    joins.push(recursive[index])
                }
            },
        }
    }
    verify_term(state, value.term, expected_ty, joins)
}

fn verify_const_expr(value: repr::ConstExpr) -> Result[repr::Type, string] {
    match value {
        Prim { value: _, ty } | Ref { name: _, ty } => {
            repr::validate_type(ty)?;
            Result::Ok(ty)
        },
        Unary { op: _, expr, ty } => {
            verify_const_expr(expr)?;
            repr::validate_type(ty)?;
            Result::Ok(ty)
        },
        Cast { expr, ty } => {
            verify_const_expr(expr)?;
            repr::validate_type(ty)?;
            Result::Ok(ty)
        },
        Binary { op: _, lhs, rhs, ty } => {
            verify_const_expr(lhs)?;
            verify_const_expr(rhs)?;
            repr::validate_type(ty)?;
            Result::Ok(ty)
        },
        Tuple { items, ty } | Array { items, ty } | Constr { constructor: _, args: items, ty } => {
            for item in items {
                verify_const_expr(item)?;
            }
            repr::validate_type(ty)?;
            Result::Ok(ty)
        },
    }
}

fn verify_closure_definition(
    definition: repr::ClosureDef,
    structs: HashMap[string, repr::StructDef],
    functions: HashMap[string, Function],
) -> Result[(), string] {
    if structs.contains(definition.environment) {} else {
        return Result::Err("closure apply function has no environment " + definition.environment)
    }
    let function = functions[definition.apply].ok_or(
        "closure environment has no apply function " + definition.environment,
    )?;
    match function.origin {
        Inherent { owner: ClosureEnvironment { name }, method_name } if name
            == definition.environment
            && method_name == "apply" => (),
        _ => return Result::Err("closure apply function has invalid origin " + definition.apply),
    }
    match definition.signature {
        Func { params, ret_ty } => {
            if function.params.len() != params.len() + 1 {
                return Result::Err(
                    "closure apply function has invalid parameters " + definition.apply,
                )
            }
            match function.params[0].1 {
                ClosureEnvironment { name } if name == definition.environment => (),
                _ => return Result::Err(
                    "closure apply function has invalid environment " + definition.apply,
                ),
            }
            for index in 0..params.len() {
                verify_type(
                    function.params[index + 1].1,
                    params[index],
                    "closure apply function has invalid parameters " + definition.apply,
                )?
            }
            verify_type(
                function.ret_ty,
                ret_ty,
                "closure apply function has invalid return type " + definition.apply,
            )
        },
        _ => Result::Err("closure definition has non-function signature " + definition.apply),
    }
}

fn verify_function(
    value: Function,
    closures: HashMap[string, repr::ClosureDef],
    structs: HashMap[string, repr::StructDef],
    enums: HashMap[string, repr::EnumDef],
    globals: VerifyScope,
) -> Result[(), string] {
    for param in value.params {
        repr::validate_type(param.1)?
    }
    repr::validate_type(value.ret_ty)?;
    match value.origin {
        Inherent { owner, method_name: _ } => repr::validate_type(owner)?,
        Source | TraitImplementation { method_name: _ } => (),
    }
    if let Some(implementation) = value.trait_impl {
        repr::validate_trait_ref(implementation.trait_ref)?;
        repr::validate_type(implementation.for_ty)?;
        for associated in implementation.associated_types {
            repr::validate_type(associated.1)?
        }
    }
    let state = VerifyState {
        join_names: collections::HashSet::new(),
        scope: VerifyScope {
            bindings: HashMap::new(),
            parent: Option::Some(globals),
            external_functions: Vec::new(),
        },
        closures,
        structs,
        enums,
    };
    for param in value.params {
        verify_bind_variable(state.scope, param.0, param.1)?
    }
    verify_block(state, value.body, value.ret_ty, Vec::new()).map(|_| ()).map_err(
        |message| "in function " + value.name + ": " + message,
    )
}

pub fn verify_with_external_functions(value: File, external_functions: Vec[string]) -> Result[
    (),
    string,
] {
    let structs: HashMap[string, repr::StructDef] = HashMap::new();
    let enums: HashMap[string, repr::EnumDef] = HashMap::new();
    let type_names: collections::HashSet[string] = collections::HashSet::new();
    for definition in value.structs {
        if !type_names.insert(definition.name) {
            return Result::Err("duplicate representation type " + definition.name)
        } else {
            structs[definition.name] = definition;
        }
        for field in definition.fields {
            repr::validate_type(field.1)?
        }
    }
    for definition in value.enums {
        if !type_names.insert(definition.name) {
            return Result::Err("duplicate representation type " + definition.name)
        } else {
            enums[definition.name] = definition;
        }
        for variant in definition.variants {
            for field in enum_variant_types(variant.fields) {
                repr::validate_type(field)?
            }
        }
    }
    for instance in value.type_instances {
        for arg in instance.args {
            repr::validate_type(arg)?
        }
    }
    for constant in value.constants {
        repr::validate_type(constant.ty)?;
        let value_ty = verify_const_expr(constant.value)?;
        verify_type(value_ty, constant.ty, "constant type does not match " + constant.name)?
    }
    let functions: HashMap[string, Function] = HashMap::new();
    for function in value.functions {
        if functions.contains(function.name) {
            return Result::Err("duplicate ANF function " + function.name)
        } else {
            functions[function.name] = function;
        }
    }
    let closures: HashMap[string, repr::ClosureDef] = HashMap::new();
    let environments: collections::HashSet[string] = collections::HashSet::new();
    for definition in value.closure_defs {
        if !environments.insert(definition.environment) {
            return Result::Err("duplicate closure environment " + definition.environment)
        } else if closures.contains(definition.apply) {
            return Result::Err("duplicate closure apply function " + definition.apply)
        } else {
            closures[definition.apply] = definition;
        }
    }
    let globals = verify_global_scope(value, external_functions)?;
    for function in value.functions {
        verify_function(function, closures, structs, enums, globals)?
    }
    for definition in value.closure_defs {
        repr::validate_type(definition.signature)?;
        verify_closure_definition(definition, structs, functions)?
    }
    Result::Ok(())
}

pub fn verify(value: File) -> Result[(), string] {
    verify_with_external_functions(value, Vec::new())
}
