package anf;

use module::ast;
use module::checker;
use module::core;
use module::hir;
use module::lift;
use module::mono;
use module::parser;
use std::testing;

#[test]
fn performance_decisions_preserve_lowered_code_and_explain_recursion() -> () {
    let source = "fn small(value: i32) -> i32 { value + 1 } fn recurse(value: i32) -> i32 { if value == 0 { 0 } else { recurse(value - 1) } } fn main() -> () { println(small(recurse(3))); }";
    let lifted = lift::lower(
        mono::lower(
            core::lower(
                checker::check(hir::lower(ast::lower(parser::parse(source)), "cost.goml")).tast,
            ),
        ),
    );
    let decisions = Vec::new();
    let ordinary = lower_with_counter(lifted, Ref::new(0));
    let explained = lower_with_report(lifted, Ref::new(0), Some(decisions));
    testing::assert_eq(encode(ordinary), encode(explained));
    let mut allowed = false;
    let mut recursive = false;
    for decision in decisions {
        if decision.callee == "small" {
            testing::assert(decision.allowed);
            testing::assert_eq(decision.reason, "within-budget");
            allowed = true;
        }
        if decision.callee == "recurse" {
            testing::assert(!decision.allowed);
            testing::assert_eq(decision.reason, "recursive-call");
            recursive = true;
        }
    }
    testing::assert(allowed && recursive);
}
