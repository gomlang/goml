package anf;

use module::ast;
use module::repr;
use std::testing;

fn scope_int() -> Imm {
    Imm::Prim { value: repr::Primitive::Int32 { value: "1" }, ty: repr::Type::Int32 }
}

fn scope_var(name: string) -> Imm {
    Imm::Var { name, ty: repr::Type::Int32 }
}

fn scope_let(name: string) -> Bind {
    Bind::Let(LetBind { name, value: Value::Imm(scope_int()), ty: repr::Type::Int32 })
}

fn scope_return(value: Imm) -> Block {
    Block { binds: Vec::new(), term: Term::Return(value) }
}

fn scope_join(name: string, params: Vec[(string, repr::Type)], body: Block) -> JoinBind {
    JoinBind { name, role: JoinRole::Continuation, params, ret_ty: repr::Type::Int32, body }
}

#[test]
fn rejects_undefined_return_variables() -> () {
    verifier_error_contains(
        verify(verifier_file(scope_return(scope_var("missing")), repr::Type::Int32)),
        "reference to out-of-scope variable missing",
    )
}

#[test]
fn rejects_variable_reference_type_mismatches() -> () {
    verifier_error_contains(
        verify(
            verifier_file(
                Block {
                    binds: Vec::from_array([scope_let("value")]),
                    term: Term::Return(Imm::Var { name: "value", ty: repr::Type::Bool }),
                },
                repr::Type::Bool,
            ),
        ),
        "variable type does not match definition value",
    )
}

#[test]
fn rejects_forward_variable_references() -> () {
    verifier_error_contains(
        verify(
            verifier_file(
                Block {
                    binds: Vec::from_array(
                        [
                            Bind::Let(
                                LetBind {
                                    name: "first",
                                    value: Value::Imm(scope_var("later")),
                                    ty: repr::Type::Int32,
                                },
                            ),
                            scope_let("later"),
                        ],
                    ),
                    term: Term::Return(scope_var("first")),
                },
                repr::Type::Int32,
            ),
        ),
        "reference to out-of-scope variable later",
    )
}

#[test]
fn rejects_variables_from_sibling_branches() -> () {
    verifier_error_contains(
        verify(
            verifier_file(
                Block {
                    binds: Vec::new(),
                    term: Term::If {
                        cond: Imm::Prim {
                            value: repr::Primitive::Bool { value: true },
                            ty: repr::Type::Bool,
                        },
                        then_: Block {
                            binds: Vec::from_array([scope_let("branch")]),
                            term: Term::Return(scope_var("branch")),
                        },
                        else_: scope_return(scope_var("branch")),
                        ret_ty: repr::Type::Int32,
                    },
                },
                repr::Type::Int32,
            ),
        ),
        "reference to out-of-scope variable branch",
    )
}

#[test]
fn accepts_join_parameters_and_lexical_captures() -> () {
    let join = scope_join(
        "done",
        Vec::from_array([("argument", repr::Type::Int32)]),
        Block {
            binds: Vec::from_array(
                [
                    Bind::Let(
                        LetBind {
                            name: "sum",
                            value: Value::Binary {
                                op: ast::BinaryOp::Add,
                                lhs: scope_var("outer"),
                                rhs: scope_var("argument"),
                                ty: repr::Type::Int32,
                            },
                            ty: repr::Type::Int32,
                        },
                    ),
                ],
            ),
            term: Term::Return(scope_var("sum")),
        },
    );
    if let Err(message) = verify(
        verifier_file(
            Block {
                binds: Vec::from_array([scope_let("outer"), Bind::Join(join)]),
                term: Term::Jump {
                    target: "done",
                    args: Vec::from_array([scope_int()]),
                    ret_ty: repr::Type::Int32,
                },
            },
            repr::Type::Int32,
        ),
    ) {
        testing::fail(message)
    }
}

#[test]
fn rejects_join_parameters_outside_their_bodies() -> () {
    let join = scope_join(
        "done",
        Vec::from_array([("argument", repr::Type::Int32)]),
        scope_return(scope_var("argument")),
    );
    verifier_error_contains(
        verify(
            verifier_file(
                Block {
                    binds: Vec::from_array([Bind::Join(join)]),
                    term: Term::Jump {
                        target: "done",
                        args: Vec::from_array([scope_var("argument")]),
                        ret_ty: repr::Type::Int32,
                    },
                },
                repr::Type::Int32,
            ),
        ),
        "reference to out-of-scope variable argument",
    )
}

#[test]
fn rejects_join_captures_declared_after_the_join() -> () {
    let join = scope_join("done", Vec::new(), scope_return(scope_var("later")));
    verifier_error_contains(
        verify(
            verifier_file(
                Block {
                    binds: Vec::from_array([Bind::Join(join), scope_let("later")]),
                    term: Term::Jump { target: "done", args: Vec::new(), ret_ty: repr::Type::Int32 },
                },
                repr::Type::Int32,
            ),
        ),
        "reference to out-of-scope variable later",
    )
}

#[test]
fn isolates_recursive_join_parameters() -> () {
    let first = scope_join(
        "first",
        Vec::from_array([("argument", repr::Type::Int32)]),
        scope_return(scope_var("argument")),
    );
    let second = scope_join("second", Vec::new(), scope_return(scope_var("argument")));
    verifier_error_contains(
        verify(
            verifier_file(
                Block {
                    binds: Vec::from_array([Bind::JoinRec(Vec::from_array([first, second]))]),
                    term: Term::Jump {
                        target: "second",
                        args: Vec::new(),
                        ret_ty: repr::Type::Int32,
                    },
                },
                repr::Type::Int32,
            ),
        ),
        "reference to out-of-scope variable argument",
    )
}

#[test]
fn rejects_assignments_to_undefined_variables() -> () {
    verifier_error_contains(
        verify(
            verifier_file(
                Block {
                    binds: Vec::from_array(
                        [
                            Bind::Let(
                                LetBind {
                                    name: "_",
                                    value: Value::Assign {
                                        name: "missing",
                                        value: scope_int(),
                                        target_ty: repr::Type::Int32,
                                        ty: repr::Type::Unit,
                                    },
                                    ty: repr::Type::Unit,
                                },
                            ),
                        ],
                    ),
                    term: Term::Return(scope_int()),
                },
                repr::Type::Int32,
            ),
        ),
        "reference to out-of-scope variable missing",
    )
}

#[test]
fn accepts_global_values_and_function_parameters() -> () {
    let file = lower_source(
        \\const answer: i32 = 42;
        \\static count: OnceCell[i32] = OnceCell::new();
        \\fn add(value: i32) -> i32 { answer + count.get_or_init(|| 1) + value }
        \\fn main() -> i32 { add(2) }
        ,
    );
    testing::assert(!file.functions.is_empty());
    if let Err(message) = verify(file) {
        testing::fail(message)
    }
}

fn scope_select_file(default: Option[Block]) -> File {
    let channel_ty = repr::Type::Channel {
        elem: repr::Type::Int32,
        direction: ast::ChannelDirection::Both,
    };
    let file = verifier_file(
        Block {
            binds: Vec::new(),
            term: Term::Select {
                mode: ast::SelectMode::Normal,
                arms: Vec::from_array(
                    [
                        SelectArm::Receive {
                            channel: Imm::Var { name: "channel", ty: channel_ty },
                            guard: Option::None,
                            binding: "received",
                            binding_ty: repr::Type::Int32,
                            body: scope_return(scope_var("received")),
                        },
                    ],
                ),
                default,
                ret_ty: repr::Type::Int32,
            },
        },
        repr::Type::Int32,
    );
    let function = file.functions[0];
    file.functions[0] = Function {
        name: function.name,
        origin: function.origin,
        root: function.root,
        trait_impl: function.trait_impl,
        params: Vec::from_array([("channel", channel_ty)]),
        ret_ty: function.ret_ty,
        body: function.body,
    };
    file
}

#[test]
fn accepts_select_receive_bindings_in_their_bodies() -> () {
    if let Err(message) = verify(scope_select_file(Option::None)) {
        testing::fail(message)
    }
}

#[test]
fn rejects_select_receive_bindings_in_other_branches() -> () {
    verifier_error_contains(
        verify(scope_select_file(Option::Some(scope_return(scope_var("received"))))),
        "reference to out-of-scope variable received",
    )
}

#[test]
fn requires_explicit_external_function_declarations() -> () {
    let ty = repr::Type::Func { params: Vec::new(), ret_ty: repr::Type::Int32 };
    let file = verifier_file(scope_return(Imm::Var { name: "external", ty }), ty);
    verifier_error_contains(verify(file), "reference to out-of-scope variable external");
    if let Err(message) = verify_with_external_functions(file, Vec::from_array(["external"])) {
        testing::fail(message)
    }
    verifier_error_contains(
        verify_with_external_functions(
            verifier_file(scope_return(scope_var("external")), repr::Type::Int32),
            Vec::from_array(["external"]),
        ),
        "reference to out-of-scope variable external",
    )
}
