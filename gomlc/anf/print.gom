package anf;

use module::ast;
use module::pretty;
use std::text;
use module::repr;

fn docs_with_separator(separator: pretty::Doc, values: Vec[pretty::Doc]) -> pretty::Doc {
    pretty::join(separator, values)
}

fn arguments(values: Vec[pretty::Doc]) -> pretty::Doc {
    pretty::delimited("(", ",", ")", values)
}

fn dyn_method_name(value: string) -> string {
    match text::rfind(value, "#") {
        Some(index) => value.byte_slice(index + 1, value.byte_len()),
        None => value,
    }
}

fn callable_doc(value: repr::Callable) -> pretty::Doc {
    match value {
        Function(name) => pretty::text(name),
        LangItem { item: _, function_name } => pretty::text(function_name),
        Runtime(name) => pretty::concat(
            Vec::from_array([pretty::text("@runtime("), pretty::text(name), pretty::text(")")]),
        ),
        CallbackAdapter(value) => pretty::text(
            if value.to_go {
                "@callback(to_go)"
            } else {
                "@callback(to_closure)"
            },
        ),
        Intrinsic(name) => pretty::concat(
            Vec::from_array([pretty::text("@intrinsic("), pretty::text(name), pretty::text(")")]),
        ),
        InterfaceBridge(value) => pretty::text(
            "@go_interface_bridge(" + repr::diagnostic_type_text(value.target) + ")",
        ),
        GoMethod { symbol, binding } => pretty::text("@go_method(" + symbol + ")"),
        GoForeign { import_path, symbol, binding } => pretty::concat(
            Vec::from_array(
                [
                    pretty::text("@go_ffi("),
                    pretty::text(import_path),
                    pretty::text(", "),
                    pretty::text(symbol),
                    pretty::text(")"),
                ],
            ),
        ),
        TraitMethod { trait_ref: reference, method_name: name, .. } => pretty::concat(
            Vec::from_array(
                [repr::trait_ref_doc(reference), pretty::text("::"), pretty::text(name)],
            ),
        ),
        DynTraitMethod { trait_name: owner, dispatch_name: dispatch, method_name: name } => {
            pretty::concat(
                Vec::from_array(
                    [
                        pretty::text("dyn "),
                        pretty::text(owner),
                        pretty::text(" via "),
                        pretty::text(dispatch),
                        pretty::text("::"),
                        pretty::text(name),
                    ],
                ),
            )
        },
        InherentMethod { receiver_ty: owner, method_name: name } => {
            pretty::text(repr::inherent_method_name(owner, name))
        },
    }
}

fn imm_doc(value: Imm) -> pretty::Doc {
    match value {
        Var { name, ty: _ } => pretty::text(name),
        Callable { callable, ty: _ } => callable_doc(callable),
        Prim { value, ty: _ } => repr::primitive_doc(value),
        Tag { index, ty: _ } => pretty::text(f"Tag_{index}"),
    }
}

fn imms_doc(values: Vec[Imm]) -> Vec[pretty::Doc] {
    let result: Vec[pretty::Doc] = Vec::with_capacity(values.len());
    for value in values {
        result.push(imm_doc(value))
    }
    result
}

fn record_doc(name: string, values: Vec[pretty::Doc]) -> pretty::Doc {
    if values.is_empty() {
        pretty::text(name + " {}")
    } else {
        pretty::group(
            pretty::concat(
                Vec::from_array(
                    [
                        pretty::text(name + " {"),
                        pretty::nest(
                            2,
                            pretty::append(
                                pretty::line(),
                                docs_with_separator(
                                    pretty::append(pretty::text(","), pretty::line()),
                                    values,
                                ),
                            ),
                        ),
                        pretty::line(),
                        pretty::text("}"),
                    ],
                ),
            ),
        )
    }
}

fn constructor_doc(constructor: repr::Constructor, args: Vec[Imm]) -> pretty::Doc {
    if constructor.is_struct {
        if constructor.fields.is_empty() && args.is_empty() {
            pretty::text(constructor.name + " {}")
        } else if constructor.fields.len() == args.len() {
            let fields: Vec[pretty::Doc] = Vec::with_capacity(args.len());
            for index in 0..args.len() {
                fields.push(
                    pretty::concat(
                        Vec::from_array(
                            [pretty::text(constructor.fields[index] + ": "), imm_doc(args[index])],
                        ),
                    ),
                )
            }
            record_doc(constructor.name, fields)
        } else if !args.is_empty() {
            pretty::append(pretty::text(constructor.name), arguments(imms_doc(args)))
        } else {
            pretty::text(constructor.name)
        }
    } else if !args.is_empty() {
        pretty::append(pretty::text(constructor.name), arguments(imms_doc(args)))
    } else {
        pretty::text(constructor.name)
    }
}

fn value_doc(value: Value) -> pretty::Doc {
    match value {
        Imm(value) => imm_doc(value),
        Constr { constructor, args, ty: _ } => constructor_doc(constructor, args),
        Tuple { items, ty: _ } => arguments(imms_doc(items)),
        Array { items, ty: _ } => pretty::delimited("[", ",", "]", imms_doc(items)),
        ConstrGet { expr, constructor, field_index: index, ty: _ } => {
            let field = if constructor.is_struct && index < constructor.fields.len() {
                constructor.fields[index]
            } else {
                f"_{index}"
            };
            pretty::concat(
                Vec::from_array(
                    [
                        pretty::text(constructor.name + "." + field),
                        arguments(Vec::from_array([imm_doc(expr)])),
                    ],
                ),
            )
        },
        Unary { op, expr, ty: _ } => pretty::concat(
            Vec::from_array(
                [pretty::text("(" + repr::unary_symbol(op)), imm_doc(expr), pretty::text(")")],
            ),
        ),
        Cast { expr, ty } => pretty::concat(
            Vec::from_array(
                [
                    pretty::text("("),
                    imm_doc(expr),
                    pretty::text(" as "),
                    repr::type_doc(ty),
                    pretty::text(")"),
                ],
            ),
        ),
        Binary { op, lhs, rhs, ty: _ } => pretty::group(
            pretty::concat(
                Vec::from_array(
                    [
                        pretty::text("("),
                        imm_doc(lhs),
                        pretty::text(" " + repr::binary_symbol(op)),
                        pretty::nest(2, pretty::append(pretty::line(), imm_doc(rhs))),
                        pretty::text(")"),
                    ],
                ),
            ),
        ),
        Assign { name, value, target_ty: _, ty: _ } => pretty::concat(
            Vec::from_array([pretty::text(name + " = "), imm_doc(value)]),
        ),
        Call { func, args, ty: _ } => pretty::append(imm_doc(func), arguments(imms_doc(args))),
        ToDyn { trait_name, for_ty, expr, ty: _ } => pretty::concat(
            Vec::from_array(
                [
                    pretty::text("to_dyn[" + trait_name + "]{"),
                    repr::type_doc(for_ty),
                    pretty::text("}"),
                    arguments(Vec::from_array([imm_doc(expr)])),
                ],
            ),
        ),
        DynCall { trait_name, method_name, receiver, args, ty: _ } => {
            let values: Vec[pretty::Doc] = Vec::with_capacity(args.len() + 1);
            values.push(imm_doc(receiver));
            for arg in args {
                values.push(imm_doc(arg))
            }
            pretty::concat(
                Vec::from_array(
                    [
                        pretty::text(
                            "dyn_call[" + trait_name + "::" + dyn_method_name(method_name) + "]",
                        ),
                        arguments(values),
                    ],
                ),
            )
        },
        Go { closure, ty: _ } => pretty::append(pretty::text("go "), imm_doc(closure)),
        PackClosure { environment, apply, ty: _ } => pretty::concat(
            Vec::from_array(
                [
                    pretty::text("pack_closure[" + apply + "]"),
                    arguments(Vec::from_array([imm_doc(environment)])),
                ],
            ),
        ),
        Proj { tuple, index, ty: _ } => {
            pretty::append(imm_doc(tuple), pretty::text(f".{index}"))
        },
    }
}

fn params_doc(values: Vec[(string, repr::Type)]) -> pretty::Doc {
    let result: Vec[pretty::Doc] = Vec::with_capacity(values.len());
    for value in values {
        result.push(
            pretty::concat(Vec::from_array([pretty::text(value.0 + ": "), repr::type_doc(value.1)])),
        )
    }
    arguments(result)
}

fn block_docs(value: Block) -> Vec[pretty::Doc] {
    let result: Vec[pretty::Doc] = Vec::with_capacity(value.binds.len() + 1);
    for value in value.binds {
        result.push(bind_doc(value))
    }
    result.push(term_doc(value.term));
    result
}

fn join_doc(value: JoinBind) -> pretty::Doc {
    let header = pretty::concat(
        Vec::from_array(
            [
                pretty::text("join " + value.name),
                params_doc(value.params),
                pretty::text(" -> "),
                repr::type_doc(value.ret_ty),
            ],
        ),
    );
    pretty::append(pretty::block(header, block_docs(value.body)), pretty::text(" in"))
}

fn bind_doc(value: Bind) -> pretty::Doc {
    match value {
        Let(value) => pretty::group(
            pretty::concat(
                Vec::from_array(
                    [
                        pretty::text("let " + value.name + " ="),
                        pretty::nest(2, pretty::append(pretty::line(), value_doc(value.value))),
                        pretty::text(" in"),
                    ],
                ),
            ),
        ),
        Join(value) => join_doc(value),
        JoinRec(values) => {
            let joins: Vec[pretty::Doc] = Vec::with_capacity(values.len());
            for value in values {
                joins.push(join_doc(value))
            }
            pretty::append(pretty::block(pretty::text("joinrec"), joins), pretty::text(" in"))
        },
    }
}

fn arm_doc(value: Arm) -> pretty::Doc {
    pretty::append(
        pretty::block(
            pretty::append(imm_doc(value.lhs), pretty::text(" =>")),
            block_docs(value.body),
        ),
        pretty::text(","),
    )
}

fn select_arm_doc(value: SelectArm) -> pretty::Doc {
    match value {
        Receive { channel, guard, binding, binding_ty: _, body } => pretty::append(
            pretty::block(
                pretty::concat(
                    Vec::from_array(
                        [
                            pretty::text("recv("),
                            imm_doc(channel),
                            match guard {
                                Some(value) => pretty::concat(
                                    Vec::from_array(
                                        [
                                            pretty::text(") when "),
                                            imm_doc(value),
                                            pretty::text(" as " + binding + " =>"),
                                        ],
                                    ),
                                ),
                                None => pretty::text(") as " + binding + " =>"),
                            },
                        ],
                    ),
                ),
                block_docs(body),
            ),
            pretty::text(","),
        ),
        Send { channel, value, guard, body } => pretty::append(
            pretty::block(
                pretty::concat(
                    Vec::from_array(
                        [
                            pretty::text("send("),
                            imm_doc(channel),
                            pretty::text(", "),
                            imm_doc(value),
                            match guard {
                                Some(value) => pretty::concat(
                                    Vec::from_array(
                                        [
                                            pretty::text(") when "),
                                            imm_doc(value),
                                            pretty::text(" =>"),
                                        ],
                                    ),
                                ),
                                None => pretty::text(") =>"),
                            },
                        ],
                    ),
                ),
                block_docs(body),
            ),
            pretty::text(","),
        ),
    }
}

fn term_doc(value: Term) -> pretty::Doc {
    match value {
        Return(value) => imm_doc(value),
        Jump { target, args, ret_ty: _ } => pretty::concat(
            Vec::from_array([pretty::text("jump " + target), arguments(imms_doc(args))]),
        ),
        If { cond, then_, else_, ret_ty: _ } => pretty::concat(
            Vec::from_array(
                [
                    pretty::block(
                        pretty::append(pretty::text("if "), imm_doc(cond)),
                        block_docs(then_),
                    ),
                    pretty::text(" "),
                    pretty::block(pretty::text("else"), block_docs(else_)),
                ],
            ),
        ),
        Match { scrutinee, arms, default, ret_ty: _ } => {
            let values: Vec[pretty::Doc] = Vec::with_capacity(
                arms.len()
                    + if default.is_some() {
                        1
                    } else {
                        0
                    },
            );
            for arm in arms {
                values.push(arm_doc(arm))
            }
            if let Some(value) = default {
                values.push(
                    pretty::append(
                        pretty::block(pretty::text("_ =>"), block_docs(value)),
                        pretty::text(","),
                    ),
                )
            }
            pretty::block(pretty::append(pretty::text("match "), imm_doc(scrutinee)), values)
        },
        Select { mode, arms, default, ret_ty: _ } => {
            let values: Vec[pretty::Doc] = Vec::with_capacity(
                arms.len()
                    + if default.is_some() {
                        1
                    } else {
                        0
                    },
            );
            for arm in arms {
                values.push(select_arm_doc(arm))
            }
            if let Some(value) = default {
                values.push(
                    pretty::append(
                        pretty::block(pretty::text("default =>"), block_docs(value)),
                        pretty::text(","),
                    ),
                )
            }
            pretty::block(
                pretty::text(
                    match mode {
                        ast::SelectMode::Normal => "select",
                        ast::SelectMode::Priority => "select priority",
                    },
                ),
                values,
            )
        },
        Unreachable { ty: _ } => pretty::text("unreachable"),
    }
}

fn function_doc(value: Function) -> pretty::Doc {
    pretty::block(
        pretty::concat(
            Vec::from_array(
                [
                    pretty::text("fn " + value.name),
                    params_doc(value.params),
                    pretty::text(" -> "),
                    repr::type_doc(value.ret_ty),
                ],
            ),
        ),
        block_docs(value.body),
    )
}

fn file_doc(value: File) -> pretty::Doc {
    let values: Vec[pretty::Doc] = Vec::with_capacity(value.constants.len() + value.functions.len());
    for value in value.constants {
        values.push(repr::constant_doc(value))
    }
    for value in value.statics {
        values.push(repr::static_doc(value))
    }
    for value in value.functions {
        values.push(function_doc(value))
    }
    pretty::join(pretty::concat(Vec::from_array([pretty::hardline(), pretty::hardline()])), values)
}

pub fn encode(value: File) -> string {
    pretty::pretty(100, file_doc(value))
}
