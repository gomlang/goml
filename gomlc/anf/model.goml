package anf;

use module::ast;
use module::repr;

pub struct File {
    pub functions: Vec[Function],
    pub enums: Vec[repr::EnumDef],
    pub structs: Vec[repr::StructDef],
    pub type_instances: Vec[repr::TypeInstance],
    pub constants: Vec[repr::Constant],
    pub statics: Vec[repr::Static],
    pub closure_defs: Vec[repr::ClosureDef],
}

pub struct Function {
    pub name: string,
    pub origin: FunctionOrigin,
    pub root: bool,
    pub trait_impl: Option[TraitImpl],
    pub params: Vec[(string, repr::Type)],
    pub ret_ty: repr::Type,
    pub body: Block,
}

pub enum FunctionOrigin {
    Source,
    Inherent {
        owner: repr::Type,
        method_name: string,
    },
    TraitImplementation {
        method_name: string,
    },
}

pub struct TraitImpl {
    pub trait_ref: repr::TraitRef,
    pub for_ty: repr::Type,
    pub associated_types: Vec[(string, repr::Type)],
}

pub struct Block {
    pub binds: Vec[Bind],
    pub term: Term,
}

pub enum Imm {
    Var {
        name: string,
        ty: repr::Type,
    },
    Callable {
        callable: repr::Callable,
        ty: repr::Type,
    },
    Prim {
        value: repr::Primitive,
        ty: repr::Type,
    },
    Tag {
        index: isize,
        ty: repr::Type,
    },
}

pub struct LetBind {
    pub name: string,
    pub value: Value,
    pub ty: repr::Type,
}

pub struct JoinBind {
    pub name: string,
    pub role: JoinRole,
    pub params: Vec[(string, repr::Type)],
    pub ret_ty: repr::Type,
    pub body: Block,
}

pub enum JoinRole {
    Continuation,
    Return,
    LoopExit,
}

pub enum Bind {
    Let(LetBind),
    Join(JoinBind),
    JoinRec(Vec[JoinBind]),
}

pub enum Value {
    Imm(Imm),
    Constr {
        constructor: repr::Constructor,
        args: Vec[Imm],
        ty: repr::Type,
    },
    Tuple {
        items: Vec[Imm],
        ty: repr::Type,
    },
    Array {
        items: Vec[Imm],
        ty: repr::Type,
    },
    ConstrGet {
        expr: Imm,
        constructor: repr::Constructor,
        field_index: isize,
        ty: repr::Type,
    },
    Unary {
        op: ast::UnaryOp,
        expr: Imm,
        ty: repr::Type,
    },
    Cast {
        expr: Imm,
        ty: repr::Type,
    },
    Binary {
        op: ast::BinaryOp,
        lhs: Imm,
        rhs: Imm,
        ty: repr::Type,
    },
    Assign {
        name: string,
        value: Imm,
        target_ty: repr::Type,
        ty: repr::Type,
    },
    Call {
        func: Imm,
        args: Vec[Imm],
        ty: repr::Type,
    },
    ToDyn {
        trait_name: string,
        for_ty: repr::Type,
        expr: Imm,
        ty: repr::Type,
    },
    DynCall {
        trait_name: string,
        method_name: string,
        receiver: Imm,
        args: Vec[Imm],
        ty: repr::Type,
    },
    Go {
        closure: Imm,
        ty: repr::Type,
    },
    PackClosure {
        environment: Imm,
        apply: string,
        ty: repr::Type,
    },
    Proj {
        tuple: Imm,
        index: isize,
        ty: repr::Type,
    },
}

pub struct Arm {
    pub lhs: Imm,
    pub body: Block,
}

pub enum SelectArm {
    Receive {
        channel: Imm,
        guard: Option[Imm],
        binding: string,
        binding_ty: repr::Type,
        body: Block,
    },
    Send {
        channel: Imm,
        value: Imm,
        guard: Option[Imm],
        body: Block,
    },
}

pub enum Term {
    Return(Imm),
    Jump {
        target: string,
        args: Vec[Imm],
        ret_ty: repr::Type,
    },
    If {
        cond: Imm,
        then_: Block,
        else_: Block,
        ret_ty: repr::Type,
    },
    Match {
        scrutinee: Imm,
        arms: Vec[Arm],
        default: Option[Block],
        ret_ty: repr::Type,
    },
    Select {
        mode: ast::SelectMode,
        arms: Vec[SelectArm],
        default: Option[Block],
        ret_ty: repr::Type,
    },
    Unreachable {
        ty: repr::Type,
    },
}

pub fn imm_type(value: Imm) -> repr::Type {
    match value {
        Var { ty, .. } | Callable { ty, .. } | Prim { ty, .. } | Tag { ty, .. } => ty,
    }
}

pub fn value_type(value: Value) -> repr::Type {
    match value {
        Imm(value) => imm_type(value),
        Constr { ty, .. } | Tuple { ty, .. } | Array { ty, .. } | ConstrGet { ty, .. } | Unary {
            ty,
            ..,
        } | Cast { ty, .. } | Binary { ty, .. } | Assign { ty, .. } | Call { ty, .. } | ToDyn {
            ty,
            ..,
        } | DynCall { ty, .. } | Go { ty, .. } | PackClosure { ty, .. } | Proj { ty, .. } => ty,
    }
}

pub fn term_type(value: Term) -> repr::Type {
    match value {
        Return(value) => imm_type(value),
        Jump { ret_ty, .. } | If { ret_ty, .. } | Match { ret_ty, .. } | Select { ret_ty, .. } => ret_ty,
        Unreachable { ty } => ty,
    }
}

pub fn block_type(value: Block) -> repr::Type {
    term_type(value.term)
}
