package anf;

use module::repr;
use module::snapshot_names;
use std::collections;

struct SnapshotNames {
    locals: snapshot_names::Names,
    joins: snapshot_names::Names,
    declared_locals: collections::HashSet[string],
    canonicalize_all_locals: bool,
}

fn collect_local(values: collections::HashSet[string], name: string) -> () {
    let _ = values.insert(name);
}

fn collect_term_locals(values: collections::HashSet[string], value: Term) -> () {
    match value {
        If { cond: _, then_, else_, ret_ty: _ } => {
            collect_block_locals(values, then_);
            collect_block_locals(values, else_)
        },
        Match { scrutinee: _, arms, default, ret_ty: _ } => {
            for arm in arms {
                collect_block_locals(values, arm.body)
            }
            if let Some(body) = default {
                collect_block_locals(values, body)
            }
        },
        Select { arms, default, .. } => {
            for arm in arms {
                match arm {
                    Receive { binding, body, .. } => {
                        collect_local(values, binding);
                        collect_block_locals(values, body)
                    },
                    Send { body, .. } => collect_block_locals(values, body),
                }
            }
            if let Some(body) = default {
                collect_block_locals(values, body)
            }
        },
        Return(_) | Jump { .. } | Unreachable { .. } => (),
    }
}

fn collect_block_locals(values: collections::HashSet[string], value: Block) -> () {
    for binding in value.binds {
        match binding {
            Let(value) => collect_local(values, value.name),
            Join(value) => {
                for param in value.params {
                    collect_local(values, param.0)
                }
                collect_block_locals(values, value.body)
            },
            JoinRec(joins) => for value in joins {
                for param in value.params {
                    collect_local(values, param.0)
                }
                collect_block_locals(values, value.body)
            },
        }
    }
    collect_term_locals(values, value.term)
}

fn snapshot_names_new(
    value: Function,
    canonicalize_all_locals: bool,
    reserved: collections::HashSet[string],
) -> SnapshotNames {
    let declared_locals: collections::HashSet[string] = collections::HashSet::new();
    for param in value.params {
        collect_local(declared_locals, param.0)
    }
    collect_block_locals(declared_locals, value.body);
    let locals = snapshot_names::names_with_reserved(reserved);
    SnapshotNames {
        locals,
        joins: snapshot_names::names(),
        declared_locals,
        canonicalize_all_locals,
    }
}

fn snapshot_local(names: SnapshotNames, value: string) -> string {
    if names.canonicalize_all_locals || names.declared_locals.contains(value) {
        snapshot_names::canonical(names.locals, value)
    } else {
        value
    }
}

fn snapshot_imm(names: SnapshotNames, value: Imm) -> Imm {
    match value {
        Var { name, ty } => Imm::Var { name: snapshot_local(names, name), ty },
        Callable { callable, ty } => Imm::Callable { callable, ty },
        Prim { value, ty } => Imm::Prim { value, ty },
        Tag { index, ty } => Imm::Tag { index, ty },
    }
}

fn snapshot_imms(names: SnapshotNames, values: Vec[Imm]) -> Vec[Imm] {
    let result: Vec[Imm] = Vec::with_capacity(values.len());
    for value in values {
        result.push(snapshot_imm(names, value))
    }
    result
}

fn snapshot_optional_imm(names: SnapshotNames, value: Option[Imm]) -> Option[Imm] {
    value.map(|value| snapshot_imm(names, value))
}

fn snapshot_value(names: SnapshotNames, value: Value) -> Value {
    match value {
        Imm(value) => Value::Imm(snapshot_imm(names, value)),
        Constr { constructor, args, ty } => {
            Value::Constr { constructor, args: snapshot_imms(names, args), ty }
        },
        Tuple { items, ty } => Value::Tuple { items: snapshot_imms(names, items), ty },
        Array { items, ty } => Value::Array { items: snapshot_imms(names, items), ty },
        ConstrGet { expr, constructor, field_index, ty } => Value::ConstrGet {
            expr: snapshot_imm(names, expr),
            constructor,
            field_index,
            ty,
        },
        Unary { op, expr, ty } => Value::Unary { op, expr: snapshot_imm(names, expr), ty },
        Cast { expr, ty } => Value::Cast { expr: snapshot_imm(names, expr), ty },
        Binary { op, lhs, rhs, ty } => Value::Binary {
            op,
            lhs: snapshot_imm(names, lhs),
            rhs: snapshot_imm(names, rhs),
            ty,
        },
        Assign { name, value, target_ty, ty } => Value::Assign {
            name: snapshot_local(names, name),
            value: snapshot_imm(names, value),
            target_ty,
            ty,
        },
        Call { func, args, ty } => Value::Call {
            func: snapshot_imm(names, func),
            args: snapshot_imms(names, args),
            ty,
        },
        ToDyn { trait_name, for_ty, expr, ty } => Value::ToDyn {
            trait_name,
            for_ty,
            expr: snapshot_imm(names, expr),
            ty,
        },
        DynCall { trait_name, method_name, receiver, args, ty } => Value::DynCall {
            trait_name,
            method_name,
            receiver: snapshot_imm(names, receiver),
            args: snapshot_imms(names, args),
            ty,
        },
        Go { closure, ty } => Value::Go { closure: snapshot_imm(names, closure), ty },
        PackClosure { environment, apply, ty } => Value::PackClosure {
            environment: snapshot_imm(names, environment),
            apply,
            ty,
        },
        Proj { tuple, index, ty } => {
            Value::Proj { tuple: snapshot_imm(names, tuple), index, ty }
        },
    }
}

fn snapshot_join(names: SnapshotNames, value: JoinBind) -> JoinBind {
    let params: Vec[(string, repr::Type)] = Vec::with_capacity(value.params.len());
    for param in value.params {
        params.push((snapshot_local(names, param.0), param.1))
    }
    JoinBind {
        name: snapshot_names::canonical(names.joins, value.name),
        role: value.role,
        params,
        ret_ty: value.ret_ty,
        body: snapshot_block(names, value.body),
    }
}

fn observe_block_joins(names: SnapshotNames, value: Block) -> () {
    for binding in value.binds {
        match binding {
            Join(value) => {
                let _ = snapshot_names::canonical(names.joins, value.name);
            },
            JoinRec(values) => for value in values {
                let _ = snapshot_names::canonical(names.joins, value.name);
            },
            Let(_) => (),
        }
    }
}

fn snapshot_block(names: SnapshotNames, value: Block) -> Block {
    observe_block_joins(names, value);
    let binds: Vec[Bind] = Vec::with_capacity(value.binds.len());
    for binding in value.binds {
        match binding {
            Let(value) => {
                let name = snapshot_local(names, value.name);
                binds.push(
                    Bind::Let(
                        LetBind { name, value: snapshot_value(names, value.value), ty: value.ty },
                    ),
                )
            },
            Join(value) => binds.push(Bind::Join(snapshot_join(names, value))),
            JoinRec(values) => {
                let renamed: Vec[JoinBind] = Vec::with_capacity(values.len());
                for value in values {
                    renamed.push(snapshot_join(names, value))
                }
                binds.push(Bind::JoinRec(renamed))
            },
        }
    }
    Block { binds, term: snapshot_term(names, value.term) }
}

fn snapshot_arm(names: SnapshotNames, value: Arm) -> Arm {
    Arm { lhs: snapshot_imm(names, value.lhs), body: snapshot_block(names, value.body) }
}

fn snapshot_select_arm(names: SnapshotNames, value: SelectArm) -> SelectArm {
    match value {
        Receive { channel, guard, binding, binding_ty, body } => SelectArm::Receive {
            channel: snapshot_imm(names, channel),
            guard: snapshot_optional_imm(names, guard),
            binding: snapshot_local(names, binding),
            binding_ty,
            body: snapshot_block(names, body),
        },
        Send { channel, value, guard, body } => SelectArm::Send {
            channel: snapshot_imm(names, channel),
            value: snapshot_imm(names, value),
            guard: snapshot_optional_imm(names, guard),
            body: snapshot_block(names, body),
        },
    }
}

fn snapshot_term(names: SnapshotNames, value: Term) -> Term {
    match value {
        Return(value) => Term::Return(snapshot_imm(names, value)),
        Jump { target, args, ret_ty } => Term::Jump {
            target: snapshot_names::canonical(names.joins, target),
            args: snapshot_imms(names, args),
            ret_ty,
        },
        If { cond, then_, else_, ret_ty } => Term::If {
            cond: snapshot_imm(names, cond),
            then_: snapshot_block(names, then_),
            else_: snapshot_block(names, else_),
            ret_ty,
        },
        Match { scrutinee, arms, default, ret_ty } => {
            let renamed: Vec[Arm] = Vec::with_capacity(arms.len());
            for arm in arms {
                renamed.push(snapshot_arm(names, arm))
            }
            Term::Match {
                scrutinee: snapshot_imm(names, scrutinee),
                arms: renamed,
                default: default.map(|body| snapshot_block(names, body)),
                ret_ty,
            }
        },
        Select { mode, arms, default, ret_ty } => {
            let renamed: Vec[SelectArm] = Vec::with_capacity(arms.len());
            for arm in arms {
                renamed.push(snapshot_select_arm(names, arm))
            }
            Term::Select {
                mode,
                arms: renamed,
                default: default.map(|body| snapshot_block(names, body)),
                ret_ty,
            }
        },
        Unreachable { ty } => Term::Unreachable { ty },
    }
}

fn snapshot_function(
    value: Function,
    canonicalize_all_locals: bool,
    reserved: collections::HashSet[string],
) -> Function {
    let names = snapshot_names_new(value, canonicalize_all_locals, reserved);
    let params: Vec[(string, repr::Type)] = Vec::with_capacity(value.params.len());
    for param in value.params {
        params.push((snapshot_local(names, param.0), param.1))
    }
    Function {
        name: value.name,
        origin: value.origin,
        root: value.root,
        trait_impl: value.trait_impl,
        params,
        ret_ty: value.ret_ty,
        body: snapshot_block(names, value.body),
    }
}

fn canonicalize_file(value: File, canonicalize_all_locals: bool) -> File {
    let reserved: collections::HashSet[string] = collections::HashSet::new();
    for function in value.functions {
        let _ = reserved.insert(function.name);
    }
    for constant in value.constants {
        let _ = reserved.insert(constant.name);
    }
    for static_value in value.statics {
        let _ = reserved.insert(static_value.name);
    }
    let functions: Vec[Function] = Vec::with_capacity(value.functions.len());
    for function in value.functions {
        functions.push(snapshot_function(function, canonicalize_all_locals, reserved))
    }
    File {
        functions,
        enums: value.enums,
        structs: value.structs,
        type_instances: value.type_instances,
        constants: value.constants,
        statics: value.statics,
        closure_defs: value.closure_defs,
    }
}

pub fn canonicalize_names(value: File) -> File {
    canonicalize_file(value, false)
}

pub fn encode_snapshot(value: File) -> string {
    encode(canonicalize_file(value, true))
}
