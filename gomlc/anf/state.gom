package anf;

use module::ast;
use module::lift;
use module::repr;

struct LoopCtx {
    loop_id: string,
    exit_id: string,
    exit_ret_ty: repr::Type,
    exit_takes_arg: bool,
}

struct ReturnCtx {
    join_id: string,
    ret_ty: repr::Type,
    takes_arg: bool,
}

struct State {
    counter: Ref[isize],
    loop_ctxs: Vec[LoopCtx],
    return_ctx: Ref[Option[ReturnCtx]],
}

fn fresh(state: State, prefix: string) -> string {
    let index = state.counter.get();
    state.counter.set(index + 1);
    f"{prefix}{index}"
}

fn unit_imm() -> Imm {
    Imm::Prim { value: repr::Primitive::Unit, ty: repr::Type::Unit }
}

fn type_is_unit(value: repr::Type) -> bool {
    match repr::resolve_type(value) {
        Unit => true,
        _ => false,
    }
}

fn type_is_unit_or_never(value: repr::Type) -> bool {
    match repr::resolve_type(value) {
        Unit | Never => true,
        _ => false,
    }
}

fn no_imms() -> Vec[Imm] {
    Vec::new()
}

fn one_imm(value: Imm) -> Vec[Imm] {
    let result: Vec[Imm] = Vec::new();
    result.push(value);
    result
}

fn no_binds() -> Vec[Bind] {
    Vec::new()
}

fn unreachable_block(state: State) -> Block {
    let ty = match state.return_ctx.get() {
        Some(context) => context.ret_ty,
        None => repr::Type::Never,
    };
    Block { binds: no_binds(), term: Term::Unreachable { ty } }
}

fn one_bind(value: Bind) -> Vec[Bind] {
    let result: Vec[Bind] = Vec::new();
    result.push(value);
    result
}

fn prepend_bind(value: Bind, block: Block) -> Block {
    let binds: Vec[Bind] = Vec::new();
    binds.push(value);
    for bind in block.binds {
        binds.push(bind)
    }
    Block { binds, term: block.term }
}

fn jump_block(target: string, value: Imm, takes_arg: bool, ret_ty: repr::Type) -> Block {
    Block {
        binds: no_binds(),
        term: Term::Jump {
            target,
            args: if takes_arg {
                one_imm(value)
            } else {
                no_imms()
            },
            ret_ty,
        },
    }
}

fn expr_is_control(value: lift::Expr) -> bool {
    match value {
        Block { block: _, ty: _ } | If { cond: _, then_branch: _, else_branch: _, ty: _ } | Match {
            expr: _,
            arms: _,
            default: _,
            ty: _,
        } | Select { .. } | While { cond: _, body: _, ty: _ } | Loop { body: _, ty: _ } | Break {
            ty: _,
            ..,
        } | Continue { ty: _, .. } | Return { expr: _, ty: _ } => true,
        _ => false,
    }
}

fn match_has_catch_all(arms: Vec[lift::Arm], default: Option[lift::Expr]) -> bool {
    if let Some(_) = default {
        return true
    }
    for arm in arms {
        if let Var { name: _, ty: _ } = arm.lhs {
            return true
        }
    }
    false
}

fn expr_always_exits(value: lift::Expr) -> bool {
    if let Never = repr::resolve_type(lift::expr_type(value)) {
        return true
    }
    match value {
        Break { ty: _, .. } | Continue { ty: _, .. } | Return { expr: _, ty: _ } => true,
        Constr { constructor: _, args, ty: _ } => exprs_always_exit(args),
        Tuple { items, ty: _ } | Array { items, ty: _ } => {
            exprs_always_exit(items)
        },
        Block { block, ty: _ } => block_always_exits(block),
        If { cond: _, then_branch: then_, else_branch: else_, ty: _ } => {
            expr_always_exits(then_) && expr_always_exits(else_)
        },
        Match { expr: _, arms, default, ty: _ } => {
            if !match_has_catch_all(arms, default) {
                return false
            }
            for arm in arms {
                if expr_always_exits(arm.body) {} else {
                    return false
                }
            }
            if let Some(value) = default {
                if expr_always_exits(value) {} else {
                    return false
                }
            }
            true
        },
        Select { arms, default, .. } => {
            for arm in arms {
                let body = match arm {
                    Receive { body, .. } => body,
                    Send { body, .. } => body,
                };
                if expr_always_exits(body) {} else {
                    return false
                }
            }
            match default {
                Some(value) => expr_always_exits(value),
                None => true,
            }
        },
        While { cond, body: _, ty: _ } => expr_always_exits(cond),
        Loop { body: _, ty } => match repr::resolve_type(ty) {
            Never => true,
            _ => false,
        },
        Go { expr, ty: _ } | PackClosure { environment: expr, apply: _, ty: _ } | ConstrGet {
            expr,
            constructor: _,
            field_index: _,
            ty: _,
        } | Unary { op: _, expr, ty: _ } | Cast { expr, ty: _ } | ToDyn {
            trait_name: _,
            for_ty: _,
            expr,
            ty: _,
        } | Proj { tuple: expr, index: _, ty: _ } => expr_always_exits(expr),
        Binary { op, lhs, rhs, ty: _ } => {
            expr_always_exits(lhs)
                || match op {
                    And | Or => false,
                    _ => expr_always_exits(rhs),
                }
        },
        Assign { name: _, value: expr, target_ty: _, ty: _ } => expr_always_exits(expr),
        Call { func, args, ty: _ } => {
            expr_always_exits(func) || exprs_always_exit(args)
        },
        DynCall { trait_name: _, method_name: _, receiver, args, ty: _ } => {
            expr_always_exits(receiver) || exprs_always_exit(args)
        },
        Var { name: _, ty: _ } | Callable { callable: _, ty: _ } | Prim { value: _, ty: _ } => false,
    }
}

fn exprs_always_exit(values: Vec[lift::Expr]) -> bool {
    for value in values {
        if expr_always_exits(value) {
            return true
        }
    }
    false
}

fn block_always_exits(value: lift::Block) -> bool {
    for stmt in value.stmts {
        if expr_always_exits(stmt.value) {
            return true
        }
    }
    match value.tail {
        Some(value) => expr_always_exits(value),
        None => false,
    }
}
