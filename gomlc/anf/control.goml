package anf;

use module::ast;
use module::lift;
use module::repr;

fn reify_k_with_name(
    state: State,
    name: string,
    role: JoinRole,
    value_ty: repr::Type,
    k: (Imm) -> Block,
) -> (JoinBind, repr::Type) {
    if type_is_unit(value_ty) {
        let body = k(unit_imm());
        let ret_ty = block_type(body);
        (JoinBind { name, role, params: Vec::new(), ret_ty, body }, ret_ty)
    } else {
        let param = fresh(state, "jp");
        let body = k(Imm::Var { name: param, ty: value_ty });
        let ret_ty = block_type(body);
        let params: Vec[(string, repr::Type)] = Vec::new();
        params.push((param, value_ty));
        (JoinBind { name, role, params, ret_ty, body }, ret_ty)
    }
}

fn reify_k(state: State, value_ty: repr::Type, k: (Imm) -> Block) -> (JoinBind, repr::Type) {
    reify_k_with_name(state, fresh(state, "k"), JoinRole::Continuation, value_ty, k)
}

fn reify_k_for_expr(state: State, value: lift::Expr, k: (Imm) -> Block) -> (JoinBind, repr::Type) {
    let value_ty = lift::expr_type(value);
    if type_is_unit_or_never(value_ty) && expr_always_exits(value) {
        let name = fresh(state, "k");
        let ret_ty = block_type(k(unit_imm()));
        (
            JoinBind {
                name,
                role: JoinRole::Continuation,
                params: Vec::new(),
                ret_ty,
                body: Block { binds: no_binds(), term: Term::Unreachable { ty: ret_ty } },
            },
            ret_ty,
        )
    } else {
        reify_k(state, value_ty, k)
    }
}

fn lower_core_stmts(
    state: State,
    stmts: Vec[lift::LetStmt],
    index: isize,
    tail: Option[lift::Expr],
    k: (Imm) -> Block,
) -> Block {
    if index >= stmts.len() {
        match tail {
            Some(value) => lower_expr(state, value, k),
            None => k(unit_imm()),
        }
    } else {
        let stmt = stmts[index];
        let value_ty = lift::expr_type(stmt.value);
        if expr_is_control(stmt.value) {
            lower_expr(
                state,
                stmt.value,
                |value| {
                    let block = lower_core_stmts(state, stmts, index + 1, tail, k);
                    prepend_bind(
                        Bind::Let(
                            LetBind { name: stmt.name, value: Value::Imm(value), ty: value_ty },
                        ),
                        block,
                    )
                },
            )
        } else {
            lower_value(
                state,
                stmt.value,
                |value| {
                    let ty = value_type(value);
                    let block = match repr::resolve_type(ty) {
                        Never => unreachable_block(state),
                        _ => lower_core_stmts(state, stmts, index + 1, tail, k),
                    };
                    prepend_bind(Bind::Let(LetBind { name: stmt.name, value, ty }), block)
                },
            )
        }
    }
}

fn lower_core_block(state: State, value: lift::Block, k: (Imm) -> Block) -> Block {
    lower_core_stmts(state, value.stmts, 0, value.tail, k)
}

fn lower_branch(
    state: State,
    value: lift::Expr,
    join_id: string,
    join_ret_ty: repr::Type,
    join_takes_arg: bool,
) -> Block {
    lower_expr(
        state,
        value,
        |value| {
            jump_block(join_id, value, join_takes_arg, join_ret_ty)
        },
    )
}

fn lower_if(
    state: State,
    cond: lift::Expr,
    then_: lift::Expr,
    else_: lift::Expr,
    ty: repr::Type,
    k: (Imm) -> Block,
) -> Block {
    let expr = lift::Expr::If { cond, then_branch: then_, else_branch: else_, ty };
    let reified = reify_k_for_expr(state, expr, k);
    let join = reified.0;
    let ret_ty = reified.1;
    let join_id = join.name;
    let takes_arg = !join.params.is_empty();
    lower_expr(
        state,
        cond,
        |cond| {
            let then_block = lower_branch(state, then_, join_id, ret_ty, takes_arg);
            let else_block = lower_branch(state, else_, join_id, ret_ty, takes_arg);
            Block {
                binds: one_bind(Bind::Join(join)),
                term: Term::If { cond, then_: then_block, else_: else_block, ret_ty },
            }
        },
    )
}

fn lower_arms(
    state: State,
    values: Vec[lift::Arm],
    join_id: string,
    join_ret_ty: repr::Type,
    join_takes_arg: bool,
) -> Vec[Arm] {
    let result: Vec[Arm] = Vec::new();
    for value in values {
        result.push(
            Arm {
                lhs: match_imm(value.lhs),
                body: lower_branch(state, value.body, join_id, join_ret_ty, join_takes_arg),
            },
        )
    }
    result
}

fn lower_match(
    state: State,
    scrutinee: lift::Expr,
    arms: Vec[lift::Arm],
    default: Option[lift::Expr],
    ty: repr::Type,
    k: (Imm) -> Block,
) -> Block {
    let expr = lift::Expr::Match { expr: scrutinee, arms, default, ty };
    let reified = reify_k_for_expr(state, expr, k);
    let join = reified.0;
    let ret_ty = reified.1;
    let join_id = join.name;
    let takes_arg = !join.params.is_empty();
    lower_expr(
        state,
        scrutinee,
        |scrutinee| {
            let lowered_arms = lower_arms(state, arms, join_id, ret_ty, takes_arg);
            let lowered_default = default.map(
                |value| lower_branch(state, value, join_id, ret_ty, takes_arg),
            );
            Block {
                binds: one_bind(Bind::Join(join)),
                term: Term::Match {
                    scrutinee,
                    arms: lowered_arms,
                    default: lowered_default,
                    ret_ty,
                },
            }
        },
    )
}

fn lower_select_arms_from(
    state: State,
    mode: ast::SelectMode,
    values: Vec[lift::SelectArm],
    index: isize,
    result: Vec[SelectArm],
    default: Option[lift::Expr],
    join: JoinBind,
    join_ret_ty: repr::Type,
    join_takes_arg: bool,
) -> Block {
    if index >= values.len() {
        let lowered_default = default.map(
            |value| lower_branch(state, value, join.name, join_ret_ty, join_takes_arg),
        );
        Block {
            binds: one_bind(Bind::Join(join)),
            term: Term::Select { mode, arms: result, default: lowered_default, ret_ty: join_ret_ty },
        }
    } else {
        match values[index] {
            Receive { channel, guard, binding, binding_ty, body } => lower_expr(
                state,
                channel,
                |channel| {
                    let finish = |guard| {
                        result.push(
                            SelectArm::Receive {
                                channel,
                                guard,
                                binding,
                                binding_ty,
                                body: lower_branch(
                                    state,
                                    body,
                                    join.name,
                                    join_ret_ty,
                                    join_takes_arg,
                                ),
                            },
                        );
                        lower_select_arms_from(
                            state,
                            mode,
                            values,
                            index + 1,
                            result,
                            default,
                            join,
                            join_ret_ty,
                            join_takes_arg,
                        )
                    };
                    match guard {
                        Some(value) => lower_expr(state, value, |value| finish(Option::Some(value))),
                        None => finish(Option::None),
                    }
                },
            ),
            Send { channel, value, guard, body } => lower_expr(
                state,
                channel,
                |channel| {
                    lower_expr(
                        state,
                        value,
                        |value| {
                            let finish = |guard| {
                                result.push(
                                    SelectArm::Send {
                                        channel,
                                        value,
                                        guard,
                                        body: lower_branch(
                                            state,
                                            body,
                                            join.name,
                                            join_ret_ty,
                                            join_takes_arg,
                                        ),
                                    },
                                );
                                lower_select_arms_from(
                                    state,
                                    mode,
                                    values,
                                    index + 1,
                                    result,
                                    default,
                                    join,
                                    join_ret_ty,
                                    join_takes_arg,
                                )
                            };
                            match guard {
                                Some(value) => lower_expr(
                                    state,
                                    value,
                                    |value| finish(Option::Some(value)),
                                ),
                                None => finish(Option::None),
                            }
                        },
                    )
                },
            ),
        }
    }
}

fn lower_select(
    state: State,
    mode: ast::SelectMode,
    arms: Vec[lift::SelectArm],
    default: Option[lift::Expr],
    ty: repr::Type,
    k: (Imm) -> Block,
) -> Block {
    let expr = lift::Expr::Select { mode, arms, default, ty };
    let reified = reify_k_for_expr(state, expr, k);
    let join = reified.0;
    let ret_ty = reified.1;
    let join_takes_arg = !join.params.is_empty();
    lower_select_arms_from(
        state,
        mode,
        arms,
        0,
        Vec::with_capacity(arms.len()),
        default,
        join,
        ret_ty,
        join_takes_arg,
    )
}

fn lower_while(state: State, cond: lift::Expr, body: lift::Expr, k: (Imm) -> Block) -> Block {
    let exit_id = fresh(state, "exit");
    let exit_body = k(unit_imm());
    let exit_ret_ty = block_type(exit_body);
    let exit = JoinBind {
        name: exit_id,
        role: JoinRole::LoopExit,
        params: Vec::new(),
        ret_ty: exit_ret_ty,
        body: exit_body,
    };
    let loop_id = fresh(state, "loop");
    state.loop_ctxs.push(LoopCtx { loop_id, exit_id, exit_ret_ty, exit_takes_arg: false });
    let loop_body = lower_expr(
        state,
        cond,
        |cond| {
            let then_block = lower_expr(
                state,
                body,
                |_| {
                    Block {
                        binds: no_binds(),
                        term: Term::Jump { target: loop_id, args: no_imms(), ret_ty: exit_ret_ty },
                    }
                },
            );
            let else_block = Block {
                binds: no_binds(),
                term: Term::Jump { target: exit_id, args: no_imms(), ret_ty: exit_ret_ty },
            };
            Block {
                binds: no_binds(),
                term: Term::If { cond, then_: then_block, else_: else_block, ret_ty: exit_ret_ty },
            }
        },
    );
    let _ = state.loop_ctxs.pop();
    let recursive: Vec[JoinBind] = Vec::new();
    recursive.push(
        JoinBind {
            name: loop_id,
            role: JoinRole::Continuation,
            params: Vec::new(),
            ret_ty: exit_ret_ty,
            body: loop_body,
        },
    );
    let binds: Vec[Bind] = Vec::new();
    binds.push(Bind::Join(exit));
    binds.push(Bind::JoinRec(recursive));
    Block { binds, term: Term::Jump { target: loop_id, args: no_imms(), ret_ty: exit_ret_ty } }
}

fn lower_loop(state: State, body: lift::Expr, ty: repr::Type, k: (Imm) -> Block) -> Block {
    let exit_result = reify_k_with_name(state, fresh(state, "exit"), JoinRole::LoopExit, ty, k);
    let exit = exit_result.0;
    let exit_ret_ty = exit_result.1;
    let exit_id = exit.name;
    let exit_takes_arg = !exit.params.is_empty();
    let loop_id = fresh(state, "loop_expr");
    state.loop_ctxs.push(LoopCtx { loop_id, exit_id, exit_ret_ty, exit_takes_arg });
    let loop_body = lower_expr(
        state,
        body,
        |_| {
            Block {
                binds: no_binds(),
                term: Term::Jump { target: loop_id, args: no_imms(), ret_ty: exit_ret_ty },
            }
        },
    );
    let _ = state.loop_ctxs.pop();
    let recursive: Vec[JoinBind] = Vec::new();
    recursive.push(
        JoinBind {
            name: loop_id,
            role: JoinRole::Continuation,
            params: Vec::new(),
            ret_ty: exit_ret_ty,
            body: loop_body,
        },
    );
    let binds: Vec[Bind] = Vec::new();
    binds.push(Bind::Join(exit));
    binds.push(Bind::JoinRec(recursive));
    Block { binds, term: Term::Jump { target: loop_id, args: no_imms(), ret_ty: exit_ret_ty } }
}

fn lower_return(state: State, value: Option[lift::Expr]) -> Block {
    match state.return_ctx.get() {
        Some(ctx) => match value {
            Some(value) => lower_expr(
                state,
                value,
                |value| {
                    jump_block(ctx.join_id, value, ctx.takes_arg, ctx.ret_ty)
                },
            ),
            None => Block {
                binds: no_binds(),
                term: Term::Jump { target: ctx.join_id, args: no_imms(), ret_ty: ctx.ret_ty },
            },
        },
        None => Block { binds: no_binds(), term: Term::Unreachable { ty: repr::Type::Never } },
    }
}

fn loop_context(state: State, target: isize) -> Option[LoopCtx] {
    if target < 0 || target >= state.loop_ctxs.len() {
        Option::None
    } else {
        Option::Some(state.loop_ctxs[state.loop_ctxs.len() - 1 - target])
    }
}

fn lower_expr(state: State, value: lift::Expr, k: (Imm) -> Block) -> Block {
    match try_imm(value) {
        Some(value) => k(value),
        None => match value {
            Block { block, ty: _ } => lower_core_block(state, block, k),
            If { cond, then_branch: then_, else_branch: else_, ty } => {
                lower_if(state, cond, then_, else_, ty, k)
            },
            Match { expr: scrutinee, arms, default, ty } => {
                lower_match(state, scrutinee, arms, default, ty, k)
            },
            Select { mode, arms, default, ty } => lower_select(state, mode, arms, default, ty, k),
            While { cond, body, ty: _ } => lower_while(state, cond, body, k),
            Loop { body, ty } => lower_loop(state, body, ty, k),
            Break { target, value, ty: _ } => match loop_context(state, target) {
                Some(ctx) => match value {
                    Some(expr) => lower_expr(
                        state,
                        expr,
                        |value| {
                            jump_block(ctx.exit_id, value, ctx.exit_takes_arg, ctx.exit_ret_ty)
                        },
                    ),
                    None => jump_block(ctx.exit_id, unit_imm(), ctx.exit_takes_arg, ctx.exit_ret_ty),
                },
                None => Block {
                    binds: no_binds(),
                    term: Term::Unreachable { ty: repr::Type::Never },
                },
            },
            Continue { target, ty: _ } => match loop_context(state, target) {
                Some(ctx) => Block {
                    binds: no_binds(),
                    term: Term::Jump {
                        target: ctx.loop_id,
                        args: no_imms(),
                        ret_ty: ctx.exit_ret_ty,
                    },
                },
                None => Block {
                    binds: no_binds(),
                    term: Term::Unreachable { ty: repr::Type::Never },
                },
            },
            Return { expr: value, ty: _ } => lower_return(state, value),
            other => lower_imm(state, other, k),
        },
    }
}
