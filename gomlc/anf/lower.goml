package anf;

use module::lift;
use module::repr;

fn lower_function_origin(value: lift::FunctionOrigin) -> FunctionOrigin {
    match value {
        Source => FunctionOrigin::Source,
        Inherent { owner, method_name } => FunctionOrigin::Inherent { owner, method_name },
        TraitImplementation { method_name } => FunctionOrigin::TraitImplementation { method_name },
    }
}

fn lower_trait_impl(value: Option[lift::TraitImpl]) -> Option[TraitImpl] {
    value.map(
        |value| TraitImpl {
            trait_ref: value.trait_ref,
            for_ty: value.for_ty,
            associated_types: value.associated_types,
        },
    )
}

fn lower_function(state: State, value: lift::Function) -> Function {
    let ret_id = fresh(state, "ret");
    let takes_arg = !type_is_unit(value.ret_ty);
    let ret_join = if takes_arg {
        let ret_value = fresh(state, "retv");
        let params: Vec[(string, repr::Type)] = Vec::new();
        params.push((ret_value, value.ret_ty));
        JoinBind {
            name: ret_id,
            role: JoinRole::Return,
            params,
            ret_ty: value.ret_ty,
            body: Block {
                binds: no_binds(),
                term: Term::Return(Imm::Var { name: ret_value, ty: value.ret_ty }),
            },
        }
    } else {
        JoinBind {
            name: ret_id,
            role: JoinRole::Return,
            params: Vec::new(),
            ret_ty: value.ret_ty,
            body: Block { binds: no_binds(), term: Term::Return(unit_imm()) },
        }
    };
    let previous = state.return_ctx.get();
    state.return_ctx.set(
        Option::Some(ReturnCtx { join_id: ret_id, ret_ty: value.ret_ty, takes_arg }),
    );
    let lowered = lower_core_block(
        state,
        value.body,
        |result| {
            jump_block(ret_id, result, takes_arg, value.ret_ty)
        },
    );
    state.return_ctx.set(previous);
    let binds: Vec[Bind] = Vec::new();
    binds.push(Bind::Join(ret_join));
    for bind in lowered.binds {
        binds.push(bind)
    }
    Function {
        name: value.name,
        origin: lower_function_origin(value.origin),
        root: value.root,
        trait_impl: lower_trait_impl(value.trait_impl),
        params: value.params,
        ret_ty: value.ret_ty,
        body: Block { binds, term: lowered.term },
    }
}

pub fn lower_with_counter(value: lift::File, counter: Ref[isize]) -> File {
    let enums = value.enums;
    let structs = value.structs;
    let type_instances = value.type_instances;
    let constants = value.constants;
    let statics = value.statics;
    let closure_defs = value.closure_defs;
    let state = State { counter, loop_ctxs: Vec::new(), return_ctx: Ref::new(Option::None) };
    let functions: Vec[Function] = Vec::new();
    for function in value.functions {
        functions.push(lower_function(state, function))
    }
    let lowered = simplify(
        File { functions, enums, structs, type_instances, constants, statics, closure_defs },
    );
    let inlined = simplify(inline(lowered, counter));
    simplify(licm(simplify(commute(inlined, counter))))
}

pub fn lower(value: lift::File) -> File {
    let counter = Ref::new(initial_counter(value));
    lower_with_counter(value, counter)
}
