package main;

use module::go_backend;
use std::testing;

fn assert_simd_helper_inlined(source: string, names: Vec[string]) -> () {
    let generated = go_backend::encode(compile_source("simd-inline-negative.goml", source).go_value);
    for name in names {
        if generated.contains(name + "(") {
            testing::fail("SIMD inline protection retained ineligible helper " + name)
        }
    }
}

#[test]
fn simd_inline_protection_excludes_scalars_and_local_type_names() -> () {
    let source = "struct f64x4 { value: f64 }\n"
        + "fn scalar_helper(a: f64, b: f64) -> f64 { a * b + a }\n"
        + "fn local_helper(a: f64x4) -> f64x4 { f64x4 { value: a.value + 1.0 } }\n"
        + "fn main() -> () { println(scalar_helper(2.0, 3.0)); println(local_helper(f64x4 { value: 4.0 }).value) }";
    assert_simd_helper_inlined(source, Vec::from_array(["scalar_helper", "local_helper"]))
}

#[test]
fn simd_inline_protection_excludes_bool_parameters() -> () {
    let source = "use std::simd;\n"
        + "fn bool_helper(a: simd::f64x4, b: simd::f64x4, flag: bool) -> simd::f64x4 { if flag { a } else { b } }\n"
        + "fn main() -> () { let a = simd::f64x4::splat(2.0); let b = simd::f64x4::splat(3.0); for index in 0..2 { println(bool_helper(a, b, index == 0).to_array()[0]) } }";
    assert_simd_helper_inlined(source, Vec::from_array(["bool_helper"]))
}

#[test]
fn simd_inline_protection_excludes_container_parameters() -> () {
    let source = "use std::simd;\n"
        + "fn array_helper(a: simd::f64x4, values: [f64; 1]) -> f64 { values[0] }\n"
        + "fn slice_helper(a: simd::f64x4, values: Slice[f64]) -> f64 { values[0] }\n"
        + "fn main() -> () { let a = simd::f64x4::splat(2.0); let values: Vec[f64] = Vec::from_array([3.0]); println(array_helper(a, [4.0])); println(slice_helper(a, values.as_slice())) }";
    assert_simd_helper_inlined(source, Vec::from_array(["array_helper", "slice_helper"]))
}

#[test]
fn simd_inline_protection_excludes_more_than_eight_parameters() -> () {
    let source = "use std::simd;\n"
        + "fn oversized_helper(a: simd::f64x4, b: simd::f64x4, c: simd::f64x4, d: simd::f64x4, e: simd::f64x4, f: simd::f64x4, g: simd::f64x4, h: simd::f64x4, i: simd::f64x4) -> simd::f64x4 { a }\n"
        + "fn main() -> () { let a = simd::f64x4::splat(2.0); println(oversized_helper(a, a, a, a, a, a, a, a, a).to_array()[0]) }";
    assert_simd_helper_inlined(source, Vec::from_array(["oversized_helper"]))
}
