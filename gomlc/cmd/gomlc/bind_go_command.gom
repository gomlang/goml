package main;

use module::bind_go;
use module::ffi;
use module::query;
use std::env;
use std::fs;
use std::io;
use std::json;
use std::path;
use std::process;
use std::time;
use std::utf8;
use utf8::BytesUtf8;

struct BindingCommand {
    config: bind_go::Config,
    outputs: bind_go::Outputs,
    context: ffi::GoBuildContext,
    module_path: string,
}

fn bind_go_help() -> string {
    "Usage: gomlc bind-go <CONFIG> [--dry-run]\n\nGenerate explicitly allowlisted Go bindings.\n\nOptions:\n      --dry-run  validate paths and print outputs without writing\n  -h, --help"
}

fn binding_go_root(directory: string) -> Result[string, string] {
    let mut current = directory;
    loop {
        match fs::symlink_metadata(path::join(current, "go.mod")) {
            Ok(metadata) => {
                if !metadata.file_type().is_file() {
                    return Result::Err("bind-go: go.mod must be a regular file")
                }
                return Result::Ok(current)
            },
            Err(error) => if error.kind() != io::ErrorKind::NotFound {
                return Result::Err(error.to_string())
            },
        }
        let parent = path::parent(current).ok_or("bind-go: expected an existing Go module")?;
        if parent == current {
            return Result::Err("bind-go: expected an existing Go module")
        }
        current = parent;
    }
}

fn binding_go_module_path(context: ffi::GoBuildContext) -> Result[string, string] {
    let output = process::Command::new(context.go_executable).args(
        Vec::from_array(["mod", "edit", "-json"]),
    ).current_dir(context.module_dir).env("GOWORK", "off").env("GOFLAGS", "").env("GOENV", "off").env(
        "GO111MODULE",
        "on",
    ).env("GOTOOLCHAIN", "local").env("GOPROXY", "off").env("GOSUMDB", "off").output_timeout_structured(
        time::Duration::from_milliseconds(30000),
    ).map_err(|error| error.to_string())?;
    if !output.status().success() {
        return Result::Err("bind-go: could not read Go module declaration")
    }
    if output.stdout().len() > 1048576 {
        return Result::Err("bind-go: Go module response exceeds limit")
    }
    let value = ffi::parse_bounded_json(
        output.stdout().to_string_utf8().map_err(|error| error.to_string())?,
    )?;
    let module = json::field(value, "Module").ok_or("bind-go: missing Go module declaration")?;
    json::field(module, "Path").and_then(|value| json::as_string(value)).ok_or(
        "bind-go: missing Go module path",
    )
}

fn binding_import_path(root: string, module_path: string, directory: string) -> Result[
    string,
    string,
] {
    if directory == root {
        return Result::Ok(module_path)
    }
    if !directory.starts_with(root + "/") {
        return Result::Err("bind-go: native output is outside Go module")
    }
    Result::Ok(module_path + "/" + directory.byte_slice(root.byte_len() + 1, directory.byte_len()))
}

fn prepare_binding_command(config_file: string) -> Result[BindingCommand, string] {
    let config_file = path::absolute_structured(config_file).map_err(|error| error.to_string())?;
    let metadata = fs::symlink_metadata(config_file).map_err(|error| error.to_string())?;
    if !metadata.file_type().is_file() || metadata.len() > 1048576 {
        return Result::Err("bind-go: configuration must be a regular file of at most 1 MiB")
    }
    let config = bind_go::parse_config(
        fs::read_file_structured(config_file).map_err(|error| error.to_string())?,
    )?;
    let root = query::module_root_for_source(config_file)?;
    let outputs = bind_go::resolve_outputs(root, config_file, config)?;
    let go_root = binding_go_root(outputs.root)?;
    let context = resolve_foreign_build_context("go", go_root)?;
    let module_path = binding_go_module_path(context)?;
    let expected = binding_import_path(
        context.module_dir,
        module_path,
        path::parent(outputs.go_file).ok_or("bind-go: missing native output directory")?,
    )?;
    if expected != config.go_import_path {
        return Result::Err("bind-go: go_import_path must match output directory: " + expected)
    }
    Result::Ok(BindingCommand { config, outputs, context, module_path })
}

fn query_binding_output(command: BindingCommand, helper: string) -> Result[
    bind_go::Generated,
    string,
] {
    let parent = path::parent(command.outputs.go_file).ok_or(
        "bind-go: missing native output directory",
    )?;
    fs::create_dir_all(parent).map_err(|error| error.to_string())?;
    let directory = path::join(parent, ".goml-bind-go-query");
    fs::create_dir(directory).map_err(
        |error| if error.kind() == io::ErrorKind::AlreadyExists {
            "bind-go: query directory already exists; preserving its contents: " + directory
        } else {
            error.to_string()
        },
    )?;
    let caller = ffi::CallerContext {
        generated_source: Option::None,
        load_mode: "package",
        import_path: command.config.go_import_path + "/.goml-bind-go-query",
        directory,
        package_name: "bindings_query",
    };
    let result = generate_go_bindings_with_overlay(
        command.config,
        helper,
        command.context,
        caller,
        Option::Some(
            ffi::SourceOverlay {
                path: command.outputs.go_file,
                source: "package " + command.config.go_package + "\n",
            },
        ),
    );
    let cleanup = fs::remove_dir_all(directory).map_err(
        |error| "bind-go: query cleanup failed: " + error.to_string(),
    );
    match result {
        Ok(generated) => {
            cleanup?;
            Result::Ok(generated)
        },
        Err(error) => match cleanup {
            Ok(()) => Result::Err(error),
            Err(cleanup) => Result::Err(error + "; " + cleanup),
        },
    }
}

fn execute_binding_command(config_file: string, dry_run: bool) -> Result[(), string] {
    let command = prepare_binding_command(config_file)?;
    let outputs = command.outputs;
    if dry_run {
        io::println("GoML output: " + outputs.goml);
        io::println("Go output: " + outputs.go_file);
        io::println("Ownership manifest: " + outputs.manifest);
        return Result::Ok(())
    }
    let executable = env::current_exe_structured().map_err(|error| error.to_string())?;
    let helper = path::join(
        path::parent(executable).ok_or("bind-go: missing compiler directory")?,
        "goml-go-meta",
    );
    bind_go::publish(outputs, || query_binding_output(command, helper))
}

fn run_bind_go_command(args: Vec[string]) -> () {
    let mut config: Option[string] = Option::None;
    let mut dry_run = false;
    let mut positional = false;
    for index in 2..args.len() {
        let argument = args[index];
        if !positional && (argument == "--help" || argument == "-h") {
            io::println(bind_go_help());
            return
        }
        if !positional && argument == "--" {
            positional = true;
        } else if !positional && argument == "--dry-run" {
            if dry_run {
                fail("bind-go: repeated --dry-run");
                return
            }
            dry_run = true;
        } else if !positional && argument.starts_with("-") {
            fail("bind-go: unknown option " + argument);
            return
        } else {
            if config.is_some() {
                fail("bind-go: expected one configuration file");
                return
            }
            config = Option::Some(argument);
        }
    }
    let Some(config) = config else {
        fail(bind_go_help());
        return
    };
    if let Err(error) = execute_binding_command(config, dry_run) {
        fail(error);
    }
}
