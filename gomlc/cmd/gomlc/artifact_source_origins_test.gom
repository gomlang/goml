package main;

use module::artifact;
use module::artifact::core_codec;
use module::ast;
use module::parser;
use std::fs;
use std::path;
use std::testing;

fn exercise_source_origin_metadata(directory: string) -> Result[(), string] {
    fs::create_dir_all(directory).map_err(|error| error.to_string())?;
    let file = path::join(directory, "origin.gom");
    let source = "package value;\r\nfn local() -> () {}\r\n#[go_ffi(\"math\", \"Abs\")] extern fn absolute(value: f64) -> f64;";
    fs::write_file_structured(file, source).map_err(|error| error.to_string())?;
    let origins = artifact_source_origins(
        "audit::value",
        Vec::from_array([file]),
        Vec::from_array([ast::lower(parser::parse(source))]),
        Vec::from_array([source]),
    );
    testing::assert_eq(origins.len(), 2);
    testing::assert_eq(origins[0].symbol, "audit::value::absolute");
    testing::assert_eq(origins[0].source_file, "origin.gom");
    testing::assert_eq(origins[0].line, 3);
    testing::assert_eq(origins[1].symbol, "audit::value::local");
    testing::assert_eq(origins[1].line, 2);
    testing::assert_eq(origins[1].column, 4);
    let unit = binary_core_fixture();
    for origin in origins {
        unit.source_origins.push(origin)
    }
    let encoded = core_codec::encode_binary(unit)?;
    fs::remove_file(file).map_err(|error| error.to_string())?;
    let restored = core_codec::decode_binary(encoded)?;
    testing::assert_eq(restored.source_origins.len(), 2);
    testing::assert_eq(restored.source_origins[0].start, origins[0].start);
    testing::assert_eq(restored.source_origins[0].end, origins[0].end);
    testing::assert_eq(
        core_codec::encode_json(restored, false),
        core_codec::encode_json(unit, false),
    );
    for source_file in Vec::from_array(
        ["", "/tmp/origin.gom", "../origin.gom", "..", "a\\origin.gom"],
    ) {
        let invalid = binary_core_fixture();
        invalid.source_origins.push(
            artifact::ArtifactSourceOrigin {
                symbol: "audit::value::local",
                source_file,
                start: 0,
                end: 5,
                line: 1,
                column: 1,
            },
        );
        testing::assert(core_codec::decode_binary(core_codec::encode_binary(invalid)?).is_err());
    }
    for symbol in Vec::from_array(
        [
            "other::package::local",
            "inherent#audit::value::Missing#audit::value::Missing#make",
            "trait_impl#other::Trait#audit::value::Missing#make",
        ],
    ) {
        let invalid = binary_core_fixture();
        invalid.source_origins.push(
            artifact::ArtifactSourceOrigin {
                symbol,
                source_file: "origin.gom",
                start: 0,
                end: 4,
                line: 1,
                column: 1,
            },
        );
        testing::assert(core_codec::decode_binary(core_codec::encode_binary(invalid)?).is_err());
    }
    let duplicate = binary_core_fixture();
    duplicate.source_origins.push(origins[0]);
    duplicate.source_origins.push(origins[0]);
    testing::assert(core_codec::decode_binary(core_codec::encode_binary(duplicate)?).is_err());
    for position in Vec::from_array([(4, 3, 1, 1), (0, 1, 0, 1), (0, 1, 1, 0)]) {
        let invalid = binary_core_fixture();
        invalid.source_origins.push(
            artifact::ArtifactSourceOrigin {
                symbol: "audit::value::local",
                source_file: "origin.gom",
                start: position.0,
                end: position.1,
                line: position.2,
                column: position.3,
            },
        );
        testing::assert(core_codec::decode_binary(core_codec::encode_binary(invalid)?).is_err());
    }
    let baseline = compile_go_export_fixture(directory, "Add", "")?;
    let compiled = compile_go_export_fixture(directory, "Add", "\n")?;
    testing::assert_eq(
        baseline.interface_unit.interface_hash,
        compiled.interface_unit.interface_hash,
    );
    testing::assert_eq(
        compiled.core_unit.source_origins[0].start,
        baseline.core_unit.source_origins[0].start + 1,
    );
    testing::assert_eq(compiled.core_unit.source_origins.len(), 2);
    testing::assert_eq(compiled.core_unit.source_origins[0].symbol, "demo::calc::add");
    testing::assert_eq(compiled.core_unit.source_origins[0].line, 2);
    testing::assert_eq(
        compiled.core_unit.source_origins[0].start,
        compiled.interface_unit.exports.go_exports[0].start,
    );
    Result::Ok(())
}

#[test]
fn source_origin_metadata_survives_missing_sources_and_validates_positions() -> () {
    let temporary = temp_go_path("source-origin.gom", "metadata");
    let result = exercise_source_origin_metadata(path::parent(temporary).unwrap_or(""));
    cleanup_temp_directory(temporary);
    match result {
        Ok(()) => (),
        Err(error) => testing::fail(error),
    }
}
