package main;

use module::artifact;
use module::ast;
use module::tast;
use module::core;
use std::collections;
use std::path;

fn artifact_source_origin(
    package_name: string,
    file: string,
    source: string,
    name: string,
    span: ast::Span,
) -> artifact::ArtifactSourceOrigin {
    let position = source_position(source, span.start);
    artifact::ArtifactSourceOrigin {
        symbol: package_name + "::" + name,
        source_file: path::file_name(file).unwrap_or(""),
        start: span.start,
        end: span.end,
        line: position.line + 1,
        column: position.column + 1,
    }
}

fn artifact_source_origins(
    package_name: string,
    paths: Vec[string],
    values: Vec[ast::LowerResult],
    sources: Vec[string],
) -> Vec[artifact::ArtifactSourceOrigin] {
    let result: Vec[artifact::ArtifactSourceOrigin] = Vec::new();
    for index in 0..values.len() {
        let Some(file) = values[index].ast else {
            continue
        };
        let source = sources[index];
        for item in file.items {
            match item {
                Function(value) => result.push(
                    artifact_source_origin(
                        package_name,
                        paths[index],
                        source,
                        value.name,
                        value.name_span,
                    ),
                ),
                ExternFunction(value) => result.push(
                    artifact_source_origin(
                        package_name,
                        paths[index],
                        source,
                        value.name,
                        value.name_span,
                    ),
                ),
                _ => (),
            }
        }
    }
    collections::sort_by(
        result,
        |a, b| if a.symbol < b.symbol {
            -1
        } else if a.symbol == b.symbol {
            0
        } else {
            1
        },
    );
    result
}

fn artifact_package_source_origins(
    package_name: string,
    paths: Vec[string],
    values: Vec[ast::LowerResult],
    sources: Vec[string],
    typed: tast::File,
    lowered: core::File,
) -> Result[Vec[artifact::ArtifactSourceOrigin], string] {
    let result = artifact_source_origins(package_name, paths, values, sources);
    let builtin = tast::builtin_contract()?;
    let names: collections::HashSet[string] = collections::HashSet::new();
    for function in lowered.functions {
        let _ = names.insert(function.name);
    }
    for item in typed.items {
        if let ImplBlock(block) = item {
            for method in block.methods {
                let symbol = core::impl_method_name(builtin, block, method.name);
                if !names.contains(symbol) || method.name_span.end <= method.name_span.start {
                    continue
                }
                for index in 0..paths.len() {
                    if paths[index] == method.source_path {
                        let position = source_position(sources[index], method.name_span.start);
                        result.push(
                            artifact::ArtifactSourceOrigin {
                                symbol,
                                source_file: path::file_name(paths[index]).unwrap_or(""),
                                start: method.name_span.start,
                                end: method.name_span.end,
                                line: position.line + 1,
                                column: position.column + 1,
                            },
                        )
                    }
                }
            }
        }
    }
    collections::sort_by(
        result,
        |a, b| if a.symbol < b.symbol {
            -1
        } else if a.symbol == b.symbol {
            0
        } else {
            1
        },
    );
    Result::Ok(result)
}
