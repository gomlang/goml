package main;

use module::artifact::core_codec as core_codec;
use module::artifact::interface_codec as interface_codec;
use module::artifact::wire as wire;
use std::bytes;
use std::testing;

#[test]
fn artifact_readers_accept_only_gaf() -> () {
    let interface = binary_interface_fixture();
    let interface_data = match interface_codec::encode_binary(interface) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            wire::artifact_binary_magic()
        },
    };
    match decode_artifact_interface_bytes(interface_data) {
        Ok(value) => testing::assert_eq(value.interface_hash, interface.interface_hash),
        Err(error) => testing::fail(error.to_string()),
    }
    if let Ok(_) = decode_artifact_interface_bytes(bytes::Bytes::from_string("{}")) {
        testing::fail("expected JSON interface rejection")
    }
    let core = binary_core_fixture();
    let core_data = match core_codec::encode_binary(core) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            wire::artifact_binary_magic()
        },
    };
    match decode_artifact_core_bytes(core_data) {
        Ok(value) => testing::assert_eq(value.interface_hash, core.interface_hash),
        Err(error) => testing::fail(error.to_string()),
    }
    if let Ok(_) = decode_artifact_core_bytes(bytes::Bytes::from_string("{}")) {
        testing::fail("expected JSON Core rejection")
    }
}
