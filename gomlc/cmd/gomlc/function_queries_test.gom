package main;

use module::ffi;
use std::env;
use std::path;
use std::testing;

fn exercise_function_queries(directory: string) -> Result[(), string] {
    ffi_driver_fixture(directory)?;
    let context = resolve_foreign_build_context("go", directory)?;
    let compiler = path::absolute_structured(
        env::var_structured("GOML_TEST_GOMLC").unwrap_or("../stage2/bin/gomlc"),
    ).map_err(|error| error.to_string())?;
    let helper = path::join(path::parent(compiler).unwrap_or(""), "goml-go-meta");
    let caller = ffi::CallerContext {
        generated_source: Option::None,
        load_mode: "package",
        import_path: "example.com/host/gen",
        directory: path::join(directory, "gen"),
        package_name: "gen",
    };
    let queries = Vec::from_array(
        [
            ffi::FunctionQuery {
                id: "count",
                import_path: "strings",
                name: "Count",
                arguments: Vec::new(),
            },
            ffi::FunctionQuery {
                id: "numeric",
                import_path: "example.com/host/shim",
                name: "MakeNumeric",
                arguments: Vec::from_array([ffi::BridgeType::Scalar("int64")]),
            },
        ],
    );
    let result = run_foreign_function_queries(helper, context, caller, queries)?;
    testing::assert_eq(result.functions.len(), 2);
    testing::assert(result.metadata.go_world_identity != "");
    let ffi::GoTypeIdentity::Function { parameters, results } = result.functions[1].signature else {
        return Result::Err("expected concrete function signature")
    };
    testing::assert_eq(parameters.len(), 1);
    testing::assert_eq(
        ffi::go_type_identity_key(results[0]),
        ffi::go_type_identity_key(
            ffi::GoTypeIdentity::Named {
                import_path: "example.com/host/shim",
                name: "Numeric",
                arguments: Vec::from_array([ffi::GoTypeIdentity::Basic("int64")]),
            },
        ),
    );
    let invalid = Vec::from_array(
        [
            ffi::FunctionQuery {
                id: "invalid",
                import_path: "example.com/host/shim",
                name: "MakeNumeric",
                arguments: Vec::from_array([ffi::BridgeType::Scalar("string")]),
            },
        ],
    );
    testing::assert(run_foreign_function_queries(helper, context, caller, invalid).is_err());
    queries.push(queries[0]);
    testing::assert(ffi::encode_function_queries(context, caller, queries).is_err());
    Result::Ok(())
}

#[test]
fn function_queries_decode_real_helper_signatures_and_constraints() -> () {
    let temporary = temp_go_path("queries.gom", "function-query");
    let result = exercise_function_queries(path::parent(temporary).unwrap_or(""));
    cleanup_temp_directory(temporary);
    if let Err(error) = result {
        testing::fail(error);
    }
}
