package main;

use module::ast;
use module::consts;
use module::tast;

fn export_integer_operation(op: ast::BinaryOp) -> Option[string] {
    match op {
        Add => Some("+"),
        Sub => Some("-"),
        Mul => Some("*"),
        Div => Some("/"),
        Rem => Some("%"),
        BitAnd => Some("&"),
        BitOr => Some("|"),
        BitXor => Some("^"),
        Shl => Some("<<"),
        Shr => Some(">>"),
        _ => None,
    }
}

fn pending_integer_constant(values: Vec[tast::PendingConstant], name: string, active: Vec[string]) -> Option[
    isize,
] {
    if active.contains(name) || active.len() > 128 {
        return None
    }
    for value in values {
        if value.name == name {
            active.push(name);
            let result = export_integer_expression(values, value.value, active);
            let _ = active.pop();
            return result
        }
    }
    None
}

fn export_integer_expression(
    values: Vec[tast::PendingConstant],
    expr: tast::Expr,
    active: Vec[string],
) -> Option[isize] {
    match expr {
        Prim { value, ty: _ } => tast::integer_constant_value(value),
        Var { name, ty: _ } => pending_integer_constant(values, name, active),
        Unary { op, expr, ty: _ } => {
            let value = export_integer_expression(values, expr, active)?;
            match op {
                Neg => match consts::binary("-", 0, value) {
                    Ok(value) => Some(value),
                    Err(_) => None,
                },
                BitNot => Some(~value),
                _ => None,
            }
        },
        Binary { op, lhs, rhs, .. } => {
            let op = export_integer_operation(op)?;
            let left = export_integer_expression(values, lhs, active)?;
            let right = export_integer_expression(values, rhs, active)?;
            match consts::binary(op, left, right) {
                Ok(value) => Some(value),
                Err(_) => None,
            }
        },
        _ => None,
    }
}

fn attach_exported_integer_constants(
    constants: Vec[tast::ConstantScheme],
    pending: Vec[tast::PendingConstant],
) -> () {
    for index in 0..constants.len() {
        let value = constants[index];
        if let Some(integer) = pending_integer_constant(pending, value.name, Vec::new()) {
            constants[index] = tast::ConstantScheme {
                def_id: value.def_id,
                name: value.name,
                ty: value.ty,
                value: Option::Some(tast::Primitive::Int { value: integer.to_string() }),
            };
        }
    }
}
