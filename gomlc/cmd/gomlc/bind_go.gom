package main;

use module::bind_go;
use module::ffi;
use std::path;

fn generate_go_bindings_with_overlay(
    config: bind_go::Config,
    helper: string,
    context: ffi::GoBuildContext,
    caller: ffi::CallerContext,
    overlay: Option[ffi::SourceOverlay],
) -> Result[bind_go::Generated, string] {
    let functions = run_foreign_function_queries_with_overlay(
        helper,
        context,
        caller,
        bind_go::function_queries(config),
        overlay,
    )?;
    let queries = bind_go::type_queries(config);
    let types = if queries.is_empty() {
        ffi::TypeInstances {
            declarations: ffi::TypeDeclarations {
                go_world_identity: "",
                declarations: Vec::new(),
                nodes: HashMap::new(),
            },
            instances: Vec::new(),
        }
    } else {
        run_foreign_type_instances_with_overlay(helper, context, caller, queries, overlay)?
    };
    let generated = bind_go::generate(config, functions, types)?;
    if let Some(overlay) = overlay {
        if functions.functions.is_empty() {
            let mut validation_caller = ffi::CallerContext {
                generated_source: Option::None,
                load_mode: "package",
                import_path: config.go_import_path,
                directory: path::parent(overlay.path).ok_or("bind-go: missing output directory")?,
                package_name: config.go_package,
            };
            for binding in config.types {
                if binding.import_path == config.go_import_path {
                    validation_caller = caller;
                }
            }
            let _ = run_foreign_type_instances_with_overlay(
                helper,
                context,
                validation_caller,
                bind_go::type_queries(config),
                Option::Some(ffi::SourceOverlay { path: overlay.path, source: generated.go_source }),
            )?;
        }
        let queries = Vec::new();
        for function in functions.functions {
            queries.push(
                ffi::FunctionQuery {
                    id: function.query.id,
                    import_path: config.go_import_path,
                    name: "GomlBind_" + function.query.id,
                    arguments: Vec::new(),
                },
            );
        }
        let checked = run_foreign_function_queries_with_overlay(
            helper,
            context,
            caller,
            queries,
            Option::Some(ffi::SourceOverlay { path: overlay.path, source: generated.go_source }),
        )?;
        for index in 0..functions.functions.len() {
            if checked.functions[index].variadic
                || ffi::go_type_identity_key(checked.functions[index].signature)
                    != ffi::go_type_identity_key(functions.functions[index].signature) {
                return Result::Err("bind-go: generated function signature differs from native API")
            }
        }
    }
    Result::Ok(generated)
}

fn generate_go_bindings(
    config: bind_go::Config,
    helper: string,
    context: ffi::GoBuildContext,
    caller: ffi::CallerContext,
) -> Result[bind_go::Generated, string] {
    generate_go_bindings_with_overlay(config, helper, context, caller, Option::None)
}
