package main;

use module::artifact;
use module::core;
use module::ffi;
use module::tast;

fn validate_interface_bridge_metadata(
    methods: Vec[string],
    ty: tast::Type,
    metadata: Vec[ffi::TypeDeclarations],
) -> Result[(), string] {
    tast::validate_go_interface_bridge_callable(methods, ty)?;
    let tast::Type::Func { ret_ty, .. } = tast::resolve_type(ty) else {
        return Result::Err("Go interface bridge constructor type missing")
    };
    let target = tast::foreign_bridge_type(ret_ty, Vec::new(), false)?;
    let mut found = false;
    for declarations in metadata {
        for declaration in declarations.declarations {
            let template = ffi::resolve_go_type_template(declarations, declaration.type_id)?;
            let Ok(identity) = ffi::go_identity_bridge_type(template.identity) else {
                continue
            };
            if ffi::bridge_types_equal(identity, target) {
                found = true;
                tast::validate_go_interface_bridge_shape(
                    methods,
                    ty,
                    ffi::resolve_go_interface_shape(declarations, declaration.type_id)?,
                )?;
            }
        }
    }
    if !found {
        return Result::Err("Go interface bridge requires verified native interface metadata")
    }
    Result::Ok(())
}

fn validate_interface_bridge_exports(
    exports: artifact::ArtifactPackageExports,
    metadata: Vec[ffi::TypeDeclarations],
) -> Result[(), string] {
    for function in exports.functions {
        if let tast::Callable::GoInterfaceBridge { binding, methods } = function.body {
            if let tast::ComptimeCapability::Capable = function.comptime {
                return Result::Err("Go interface bridges must be runtime-only")
            }
            validate_interface_bridge_metadata(methods, function.ty, metadata).map_err(
                |error| "ffi-interface: " + binding + ": " + error,
            )?;
        }
    }
    Result::Ok(())
}

fn validate_interface_bridge_units(
    interfaces: Vec[artifact::ArtifactInterfaceUnit],
    cores: Vec[artifact::ArtifactCoreUnit],
    metadata: Vec[ffi::TypeDeclarations],
) -> Result[(), string] {
    for unit in interfaces {
        validate_interface_bridge_exports(unit.exports, metadata)?;
    }
    for unit in cores {
        validate_interface_bridge_exports(unit.exports, metadata)?;
        for (binding, methods, ty) in core::interface_bridge_uses(unit.core_ir) {
            validate_interface_bridge_metadata(methods, core::type_to_tast(ty), metadata).map_err(
                |error| "ffi-interface: " + unit.package_name + ": " + binding + ": " + error,
            )?;
        }
    }
    Result::Ok(())
}
