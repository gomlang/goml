package main;

use module::test_support;
use std::fs;
use std::path;
use std::testing;
use std::utf8;
use utf8::BytesUtf8;

fn external_struct_link_arguments(directory: string) -> Vec[string] {
    go_library_cli_args(
        path::join(directory, "build.core"),
        path::join(directory, "gen/goml_generated.go"),
        "gen",
    )
}

fn exercise_external_struct_source(directory: string) -> Result[(), string] {
    ffi_driver_fixture(directory)?;
    fs::write_file_structured(
        path::join(directory, "shim/fields.go"),
        "package shim\ntype Detail struct { Value int64; hidden int64; Unsupported chan int }\nfunc DetailAddress() *Detail { return &Detail{Value: 5} }\nfunc NewDetail(value int64) Detail { return Detail{Value: value} }\nfunc DetailValue(value Detail) int64 { return value.Value }\nfunc DetailPointerValue(value *Detail) int64 { return value.Value }\nfunc ReadBox(value Box[int64]) int64 { return value.Value }\nfunc BoxNext(value Box[int64]) *Box[int64] { return value.Next }\nfunc NumericValue(value Numeric[int64]) int64 { return value.Value }\n",
    ).map_err(|error| error.to_string())?;
    let context = resolve_foreign_build_context("go", directory)?;
    let source =
        \\package calc;
        \\use std::ffi;
        \\#[go_type("example.com/host/shim", "Box")] pub extern type Box[T];
        \\#[go_type("example.com/host/shim", "Numeric")] extern type Numeric[T];
        \\#[go_type("example.com/host/shim", "Detail")] extern type Detail;
        \\type DetailPointer = ffi::Ptr[Detail];
        \\#[go_ffi("example.com/host/shim", "DetailAddress")] extern fn detail_pointer() -> DetailPointer;
        \\#[go_ffi("example.com/host/shim", "NewDetail")] extern fn new_detail(value: i64) -> Detail;
        \\#[go_ffi("example.com/host/shim", "DetailValue")] extern fn detail_value(value: Detail) -> i64;
        \\#[go_ffi("example.com/host/shim", "DetailPointerValue")] extern fn pointer_value(value: DetailPointer) -> i64;
        \\#[go_ffi("example.com/host/shim", "MakeBox")] extern fn make_box(value: i64) -> Box[i64];
        \\#[go_ffi("example.com/host/shim", "ReadBox")] extern fn read_box(value: Box[i64]) -> i64;
        \\#[go_ffi("example.com/host/shim", "BoxNext")] extern fn box_next(value: Box[i64]) -> ffi::Ptr[Box[i64]];
        \\#[go_ffi("example.com/host/shim", "MakeNumeric")] extern fn make_numeric(value: i64) -> Numeric[i64];
        \\#[go_ffi("example.com/host/shim", "NumericValue")] extern fn numeric_value(value: Numeric[i64]) -> i64;
        \\pub type Wrapped[T] = Box[T];
        \\fn read(value: Wrapped[i64]) -> i64 { read_box(value) }
        \\#[go_export("Value")] pub fn value() -> i64 {
        \\    let box: Box[i64] = make_box(41);
        \\    let detail = new_detail(3);
        \\    if !ffi::is_nil(box_next(box)) { return 0 }
        \\    read(box) + numeric_value(make_numeric(1)) + detail_value(detail) + pointer_value(detail_pointer()) - 8
        \\}
    ;
    fs::write_file_structured(path::join(directory, "calc.goml"), source).map_err(
        |error| error.to_string(),
    )?;
    let output = foreign_package_cli_output(directory, "build")?;
    if !output.status().success() {
        return Result::Err(
            output.stderr().to_string_utf8().unwrap_or("external accessor build failed"),
        )
    }
    let output = test_support::compiler_command(external_struct_link_arguments(directory))?.output_structured().map_err(
        |error| error.to_string(),
    )?;
    if !output.status().success() {
        return Result::Err(
            output.stderr().to_string_utf8().unwrap_or("external accessor link failed"),
        )
    }
    fs::write_file_structured(
        path::join(directory, "gen/generated_test.go"),
        "package gen\nimport \"testing\"\nfunc TestExternalSource(t *testing.T) { if Value() != 42 { t.Fatal(Value()) } }\n",
    ).map_err(|error| error.to_string())?;
    let output = foreign_go_process(context, Vec::from_array(["test", "./gen"])).output_structured().map_err(
        |error| error.to_string(),
    )?;
    if !output.status().success() {
        return Result::Err(
            output.stderr().to_string_utf8().unwrap_or("external accessor execution failed"),
        )
    }
    for unsupported in Vec::from_array(
        [
            source.replace("{ read_box(value) }", "{ value.Value }"),
            source.replace(
                "let box: Box[i64] = make_box(41);",
                "let box: Box[i64] = Box { Value: 41 };",
            ),
        ],
    ) {
        fs::write_file_structured(path::join(directory, "calc.goml"), unsupported).map_err(
            |error| error.to_string(),
        )?;
        let output = foreign_package_cli_output(directory, "build")?;
        testing::assert(!output.status().success());
        let diagnostic = output.stderr().to_string_utf8().unwrap_or("");
        testing::assert(diagnostic.contains("opaque"));
        testing::assert(diagnostic.contains("Go"));
    }
    let invalid = source.replace(
        "let box: Box[i64] = make_box(41);",
        "let _ = invalid_numeric(false); let box: Box[i64] = make_box(41);",
    )
        + "\n#[go_ffi(\"example.com/host/shim\", \"MakeNumeric\")] extern fn invalid_numeric(value: bool) -> Numeric[bool];\n";
    fs::write_file_structured(path::join(directory, "calc.goml"), invalid).map_err(
        |error| error.to_string(),
    )?;
    let output = foreign_package_cli_output(directory, "build")?;
    if !output.status().success() {
        return Result::Err(
            output.stderr().to_string_utf8().unwrap_or("unverified source build failed"),
        )
    }
    let output = test_support::compiler_command(external_struct_link_arguments(directory))?.output_structured().map_err(
        |error| error.to_string(),
    )?;
    if !output.status().success() {
        return Result::Err(
            output.stderr().to_string_utf8().unwrap_or("unverified source link failed"),
        )
    }
    let output = foreign_go_process(context, Vec::from_array(["test", "./gen"])).output_structured().map_err(
        |error| error.to_string(),
    )?;
    testing::assert(!output.status().success());
    let diagnostic = output.stderr().to_string_utf8().unwrap_or("");
    testing::assert(diagnostic.contains("bool"));
    testing::assert(diagnostic.contains("constraint") || diagnostic.contains("satisfy"));
    Result::Ok(())
}

#[test]
fn external_struct_source_uses_explicit_accessors_and_defers_go_constraints() -> () {
    let temporary = temp_go_path("external-struct.goml", "source");
    let result = exercise_external_struct_source(path::parent(temporary).unwrap_or(""));
    cleanup_temp_directory(temporary);
    if let Err(error) = result {
        testing::fail(error)
    }
}

fn external_alias_package_arguments(directory: string, name: string) -> Vec[string] {
    Vec::from_array(
        [
            "build",
            "--package",
            "demo::" + name,
            "--module",
            "demo",
            "--input",
            path::join(directory, name + ".goml"),
            "--output",
            path::join(directory, name),
        ],
    )
}

fn exercise_external_alias_source(directory: string) -> Result[(), string] {
    ffi_driver_fixture(directory)?;
    let context = resolve_foreign_build_context("go", directory)?;
    fs::write_file_structured(
        path::join(directory, "shim/accessors.go"),
        "package shim\nfunc ReadBox(value Box[int64]) int64 { return value.Value }\n",
    ).map_err(|error| error.to_string())?;
    fs::write_file_structured(
        path::join(directory, "helpers.goml"),
        "package helpers; pub type Visible[T] = i64; #[go_type(\"example.com/host/shim\", \"Box\")] extern type PrivateBox[T]; pub type VisibleBox[T] = PrivateBox[T]; #[go_ffi(\"example.com/host/shim\", \"MakeBox\")] pub extern fn make(value: i64) -> VisibleBox[i64]; #[go_ffi(\"example.com/host/shim\", \"ReadBox\")] pub extern fn read(value: VisibleBox[i64]) -> i64;",
    ).map_err(|error| error.to_string())?;
    let output = test_support::compiler_command(
        external_alias_package_arguments(directory, "helpers"),
    )?.current_dir(directory).output_structured().map_err(|error| error.to_string())?;
    if !output.status().success() {
        return Result::Err(
            output.stderr().to_string_utf8().unwrap_or("alias provider build failed"),
        )
    }
    fs::remove_file(path::join(directory, "helpers.goml")).map_err(|error| error.to_string())?;
    let prefix = "package calc; use demo::helpers; fn preserve[T](value: T) -> T { let witness: helpers::Visible[T] = 0; let _ = witness; value } #[go_export(\"Value\")] pub fn value() -> i64 { ";
    for generic_integer in Vec::from_array([true, false]) {
        fs::write_file_structured(
            path::join(directory, "calc.goml"),
            prefix
                + if generic_integer {
                    "let box: helpers::VisibleBox[i64] = helpers::make(42); preserve(helpers::read(box)) }"
                } else {
                    "if preserve(false) { 1 } else { 0 } }"
                },
        ).map_err(|error| error.to_string())?;
        let arguments = external_alias_package_arguments(directory, "calc");
        arguments.push("--interface-path");
        arguments.push(path::join(directory, "helpers.interface"));
        let output = test_support::compiler_command(arguments)?.current_dir(directory).output_structured().map_err(
            |error| error.to_string(),
        )?;
        if !output.status().success() {
            return Result::Err(
                output.stderr().to_string_utf8().unwrap_or("alias consumer build failed"),
            )
        }
        let output = test_support::compiler_command(
            specialized_library_args(directory, path::join(directory, "calc.core")),
        )?.current_dir(directory).output_structured().map_err(|error| error.to_string())?;
        if !output.status().success() {
            return Result::Err(
                output.stderr().to_string_utf8().unwrap_or("alias consumer link failed"),
            )
        }
        let expected = if generic_integer {
            "42"
        } else {
            "0"
        };
        fs::write_file_structured(
            path::join(directory, "gen/generated_test.go"),
            "package gen\nimport \"testing\"\nfunc TestAlias(t *testing.T) { if Value() != "
                + expected
                + " { t.Fatal(Value()) } }\n",
        ).map_err(|error| error.to_string())?;
        let output = foreign_go_process(context, Vec::from_array(["test", "./gen"])).output_structured().map_err(
            |error| error.to_string(),
        )?;
        if !output.status().success() {
            return Result::Err(
                output.stderr().to_string_utf8().unwrap_or("alias consumer execution failed"),
            )
        }
    }
    Result::Ok(())
}

#[test]
fn exported_explicit_aliases_and_accessors_work_without_provider_sources() -> () {
    let temporary = temp_go_path("external-alias.goml", "source");
    let result = exercise_external_alias_source(path::parent(temporary).unwrap_or(""));
    cleanup_temp_directory(temporary);
    if let Err(error) = result {
        testing::fail(error)
    }
}
