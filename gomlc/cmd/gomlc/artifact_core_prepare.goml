package main;

use module::artifact;
use module::core;
use module::tast;

fn artifact_core_types_equal(left: core::Type, right: tast::Type) -> bool {
    core::types_equal(left, core::lower_type(right))
}

fn artifact_core_trait_refs_equal(left: core::TraitRef, right: tast::TraitRef) -> bool {
    core::trait_refs_equal(left, core::lower_trait_ref(right))
}

fn artifact_core_function_matches_scheme(value: core::Function, scheme: artifact::ArtifactFnScheme) -> bool {
    match artifact_function_type_parts(scheme.ty) {
        Ok(function_type) => if value.params.len() != function_type.params.len()
            || !artifact_core_types_equal(value.ret_ty, function_type.ret_ty) {
            false
        } else {
            for index in 0..value.params.len() {
                if !artifact_core_types_equal(value.params[index].1, function_type.params[index]) {
                    return false
                }
            }
            true
        },
        Err(_) => false,
    }
}

fn artifact_core_method_name(value: core::Function) -> Option[string] {
    match value.origin {
        core::FunctionOrigin::Inherent { owner: _, method_name } | core::FunctionOrigin::TraitImplementation {
            method_name,
        } => Option::Some(method_name),
        core::FunctionOrigin::Source => Option::None,
    }
}

fn artifact_core_predicates(inherited: Vec[tast::TypePredicate], own: Vec[tast::TypePredicate]) -> Vec[
    core::TypePredicate,
] {
    let result: Vec[core::TypePredicate] = Vec::new();
    for predicate in inherited {
        result.push(core::lower_predicate(predicate))
    }
    for predicate in own {
        result.push(core::lower_predicate(predicate))
    }
    result
}

fn artifact_core_associated_types(values: Vec[(string, tast::Type)]) -> Vec[(string, core::Type)] {
    let result: Vec[(string, core::Type)] = Vec::with_capacity(values.len());
    for value in values {
        result.push((value.0, core::lower_type(value.1)))
    }
    result
}

fn artifact_prepare_core_function_metadata(
    value: core::Function,
    exports: artifact::ArtifactPackageExports,
) -> core::Function {
    let mut predicates = value.predicates;
    for function in exports.functions {
        if function.name == value.name && artifact_core_function_matches_scheme(value, function) {
            predicates = core::lower_predicates(function.constraints);
        }
    }
    let trait_impl = match value.trait_impl {
        Some(metadata) => {
            let mut associated_types = metadata.associated_types;
            let mut generic_count = metadata.generic_count;
            let mut predicate_count = metadata.predicate_count;
            let method_name = artifact_core_method_name(value);
            for implementation in exports.trait_impls {
                if implementation.definition.valid
                    && artifact_core_trait_refs_equal(metadata.trait_ref, implementation.trait_ref)
                    && artifact_core_types_equal(metadata.for_ty, implementation.for_ty) {
                    associated_types = artifact_core_associated_types(
                        implementation.definition.associated_types,
                    );
                    generic_count = implementation.definition.params.len();
                    predicate_count = implementation.definition.constraints.len();
                    if let Some(method_name) = method_name {
                        for method in implementation.definition.methods {
                            if method.name == method_name
                                && artifact_core_function_matches_scheme(value, method) {
                                predicates = artifact_core_predicates(
                                    implementation.definition.constraints,
                                    method.constraints,
                                );
                            }
                        }
                    }
                }
            }
            Option::Some(
                core::TraitImpl {
                    trait_ref: metadata.trait_ref,
                    for_ty: metadata.for_ty,
                    associated_types,
                    generic_count,
                    predicate_count,
                },
            )
        },
        None => {
            let method_name = artifact_core_method_name(value);
            if let Some(method_name) = method_name {
                for implementation in exports.inherent_impls {
                    if implementation.definition.valid {
                        for method in implementation.definition.methods {
                            if method.name == method_name
                                && artifact_core_function_matches_scheme(value, method) {
                                predicates = artifact_core_predicates(
                                    implementation.definition.constraints,
                                    method.constraints,
                                );
                            }
                        }
                    }
                }
            }
            Option::None
        },
    };
    core::Function {
        name: value.name,
        origin: value.origin,
        root: value.root,
        generics: value.generics,
        predicates,
        trait_impl,
        params: value.params,
        ret_ty: value.ret_ty,
        body: value.body,
    }
}

fn artifact_fill_constructor_fields(value: core::Constructor, definitions: Vec[core::StructDef]) -> () {
    if value.is_struct && value.fields.is_empty() {
        for definition in definitions {
            if definition.name == value.name {
                for field in definition.fields {
                    value.fields.push(field.0)
                }
            }
        }
    }
}

fn artifact_prepare_core_exprs(values: Vec[core::Expr], definitions: Vec[core::StructDef]) -> () {
    for value in values {
        artifact_prepare_core_expr(value, definitions)
    }
}

fn artifact_prepare_optional_core_expr(value: Option[core::Expr], definitions: Vec[core::StructDef]) -> () {
    if let Some(value) = value {
        artifact_prepare_core_expr(value, definitions)
    }
}

fn artifact_prepare_core_block(value: core::Block, definitions: Vec[core::StructDef]) -> () {
    for statement in value.stmts {
        artifact_prepare_core_expr(statement.value, definitions)
    }
    artifact_prepare_optional_core_expr(value.tail, definitions)
}

fn artifact_prepare_core_expr(value: core::Expr, definitions: Vec[core::StructDef]) -> () {
    match value {
        Constr { constructor, args, ty: _ } => {
            artifact_fill_constructor_fields(constructor, definitions);
            artifact_prepare_core_exprs(args, definitions)
        },
        Tuple { items, ty: _ } | Array { items, ty: _ } => {
            artifact_prepare_core_exprs(items, definitions)
        },
        Closure { params: _, body, ty: _ } => artifact_prepare_core_expr(body, definitions),
        Block { block, ty: _ } => artifact_prepare_core_block(block, definitions),
        Match { expr, arms, default, ty: _ } => {
            artifact_prepare_core_expr(expr, definitions);
            for arm in arms {
                artifact_prepare_core_expr(arm.lhs, definitions);
                artifact_prepare_core_expr(arm.body, definitions)
            }
            artifact_prepare_optional_core_expr(default, definitions)
        },
        Select { arms, default, .. } => {
            for arm in arms {
                match arm {
                    Receive { channel, guard, binding: _, binding_ty: _, body } => {
                        artifact_prepare_core_expr(channel, definitions);
                        artifact_prepare_optional_core_expr(guard, definitions);
                        artifact_prepare_core_expr(body, definitions)
                    },
                    Send { channel, value, guard, body } => {
                        artifact_prepare_core_expr(channel, definitions);
                        artifact_prepare_core_expr(value, definitions);
                        artifact_prepare_optional_core_expr(guard, definitions);
                        artifact_prepare_core_expr(body, definitions)
                    },
                }
            }
            artifact_prepare_optional_core_expr(default, definitions)
        },
        If { cond, then_branch, else_branch, ty: _ } => {
            artifact_prepare_core_expr(cond, definitions);
            artifact_prepare_core_expr(then_branch, definitions);
            artifact_prepare_core_expr(else_branch, definitions)
        },
        While { cond, body, ty: _ } => {
            artifact_prepare_core_expr(cond, definitions);
            artifact_prepare_core_expr(body, definitions)
        },
        Return { expr, ty: _ } => {
            artifact_prepare_optional_core_expr(expr, definitions)
        },
        Go { expr, ty: _ } | Unary { op: _, expr, ty: _ } | Cast { expr, ty: _ } | Proj {
            tuple: expr,
            index: _,
            ty: _,
        } => artifact_prepare_core_expr(expr, definitions),
        ConstrGet { expr, constructor, field_index: _, ty: _ } => {
            artifact_prepare_core_expr(expr, definitions);
            artifact_fill_constructor_fields(constructor, definitions)
        },
        Binary { op: _, lhs, rhs, ty: _ } => {
            artifact_prepare_core_expr(lhs, definitions);
            artifact_prepare_core_expr(rhs, definitions)
        },
        Loop { body, ty: _ } => artifact_prepare_core_expr(body, definitions),
        Assign { name: _, value: expr, target_ty: _, ty: _ } => {
            artifact_prepare_core_expr(expr, definitions)
        },
        Call { func, args, ty: _ } => {
            artifact_prepare_core_expr(func, definitions);
            artifact_prepare_core_exprs(args, definitions)
        },
        ToDyn { trait_name: _, for_ty: _, expr, ty: _ } => {
            artifact_prepare_core_expr(expr, definitions)
        },
        DynCall { trait_name: _, method_name: _, receiver, args, ty: _ } => {
            artifact_prepare_core_expr(receiver, definitions);
            artifact_prepare_core_exprs(args, definitions)
        },
        TraitCall { receiver, args, .. } => {
            artifact_prepare_optional_core_expr(receiver, definitions);
            artifact_prepare_core_exprs(args, definitions)
        },
        Break { value, ty: _, .. } => if let Some(expr) = value {
            artifact_prepare_core_expr(expr, definitions)
        },
        Var { name: _, ty: _ } | Callable { callable: _, ty: _ } | Prim { value: _, ty: _ } | Continue {
            ty: _,
            ..,
        } => (),
    }
}

fn artifact_link_struct_definitions(world: PackageWorld, values: Vec[artifact::ArtifactCoreUnit]) -> Vec[
    core::StructDef,
] {
    let result: Vec[core::StructDef] = Vec::new();
    for definition in world.builtins.structs {
        result.push(definition)
    }
    for definition in world.prelude.core_value.structs {
        result.push(definition)
    }
    for standard in selected_link_standard_core(
        world.standard,
        artifact_core_standard_needs(values),
    ) {
        for definition in standard.structs {
            result.push(definition)
        }
    }
    for value in values {
        for definition in value.core_ir.structs {
            result.push(definition)
        }
    }
    result
}

fn artifact_prepare_core_units(world: PackageWorld, values: Vec[artifact::ArtifactCoreUnit]) -> () {
    let definitions = artifact_link_struct_definitions(world, values);
    for value in values {
        for index in 0..value.core_ir.functions.len() {
            let function = artifact_prepare_core_function_metadata(
                value.core_ir.functions[index],
                value.exports,
            );
            value.core_ir.functions[index] = function;
            artifact_prepare_core_block(function.body, definitions)
        }
    }
}

fn artifact_world_struct_definitions(world: PackageWorld) -> Vec[core::StructDef] {
    let result: Vec[core::StructDef] = Vec::new();
    for definition in world.builtins.structs {
        result.push(definition)
    }
    for definition in world.prelude.environment_exports.structs {
        result.push(core::lower_struct_def(definition))
    }
    for package_value in world.standard {
        for definition in package_value.environment_exports.structs {
            result.push(core::lower_struct_def(definition))
        }
    }
    result
}

fn artifact_prepare_world_core(
    value: core::File,
    exports: artifact::ArtifactPackageExports,
    definitions: Vec[core::StructDef],
) -> () {
    for index in 0..value.functions.len() {
        let function = artifact_prepare_core_function_metadata(value.functions[index], exports);
        value.functions[index] = function;
        artifact_prepare_core_block(function.body, definitions)
    }
}

fn artifact_prepare_world(world: PackageWorld) -> () {
    let definitions = artifact_world_struct_definitions(world);
    artifact_prepare_world_core(world.builtins, world.builtin_interface.exports, definitions);
    artifact_prepare_world_core(
        world.prelude.core_value,
        world.prelude.environment_exports,
        definitions,
    );
    for package_value in world.standard {
        artifact_prepare_world_core(
            package_value.core_value,
            package_value.environment_exports,
            definitions,
        )
    }
}
