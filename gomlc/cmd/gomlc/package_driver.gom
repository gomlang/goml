fn source_standard_needs(value: ast::LowerResult) -> StandardNeeds {
    let package_names: Vec[string] = Vec::new();
    for spec in resources::standard_package_specs() {
        if imports_package(value, spec.name) {
            package_names.push(spec.name)
        }
    }
    standard_needs_from_package_names(package_names)
}

fn merge_standard_needs(left: StandardNeeds, right: StandardNeeds) -> StandardNeeds {
    StandardNeeds {
        panic: left.panic || right.panic,
        root: left.root || right.root,
        ascii: left.ascii || right.ascii,
        bincode: left.bincode || right.bincode,
        bytes: left.bytes || right.bytes,
        bytes_endian: left.bytes_endian || right.bytes_endian,
        bytes_endian_stream: left.bytes_endian_stream || right.bytes_endian_stream,
        cmp: left.cmp || right.cmp,
        collections: left.collections || right.collections,
        encoding: left.encoding || right.encoding,
        encoding_base64: left.encoding_base64 || right.encoding_base64,
        encoding_base32: left.encoding_base32 || right.encoding_base32,
        encoding_base32_stream: left.encoding_base32_stream || right.encoding_base32_stream,
        encoding_pem: left.encoding_pem || right.encoding_pem,
        encoding_hex: left.encoding_hex || right.encoding_hex,
        error: left.error || right.error,
        env: left.env || right.env,
        ffi: left.ffi || right.ffi,
        c: left.c || right.c,
        fs: left.fs || right.fs,
        hash: left.hash || right.hash,
        hash_adler32: left.hash_adler32 || right.hash_adler32,
        hash_crc32: left.hash_crc32 || right.hash_crc32,
        hash_crc64: left.hash_crc64 || right.hash_crc64,
        hash_fnv: left.hash_fnv || right.hash_fnv,
        hash_stream: left.hash_stream || right.hash_stream,
        net: left.net || right.net,
        net_url: left.net_url || right.net_url,
        net_tls: left.net_tls || right.net_tls,
        context: left.context || right.context,
        io: left.io || right.io,
        internal_host: left.internal_host || right.internal_host,
        internal_syscall: left.internal_syscall || right.internal_syscall,
        os: left.os || right.os,
        os_linux: left.os_linux || right.os_linux,
        internal_linux: left.internal_linux || right.internal_linux,
        os_linux_abi: left.os_linux_abi || right.os_linux_abi,
        os_linux_process: left.os_linux_process || right.os_linux_process,
        os_linux_ipc: left.os_linux_ipc || right.os_linux_ipc,
        os_linux_fd: left.os_linux_fd || right.os_linux_fd,
        os_linux_memory: left.os_linux_memory || right.os_linux_memory,
        os_linux_syscall: left.os_linux_syscall || right.os_linux_syscall,
        internal_task: left.internal_task || right.internal_task,
        iter: left.iter || right.iter,
        json: left.json || right.json,
        num: left.num || right.num,
        path: left.path || right.path,
        path_slash: left.path_slash || right.path_slash,
        process: left.process || right.process,
        serde: left.serde || right.serde,
        task: left.task || right.task,
        testing: left.testing || right.testing,
        testing_fs: left.testing_fs || right.testing_fs,
        text: left.text || right.text,
        text_format: left.text_format || right.text_format,
        text_stream: left.text_stream || right.text_stream,
        toml: left.toml || right.toml,
        time: left.time || right.time,
        utf8: left.utf8 || right.utf8,
        utf16: left.utf16 || right.utf16,
        unicode: left.unicode || right.unicode,
        math: left.math || right.math,
        math_bits: left.math_bits || right.math_bits,
        simd: left.simd || right.simd,
        resource: left.resource || right.resource,
        rand: left.rand || right.rand,
        crypto: left.crypto || right.crypto,
