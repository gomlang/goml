        internal_task: closure.contains(resources::STD_INTERNAL_TASK_PACKAGE),
        iter: closure.contains(resources::STD_ITER_PACKAGE),
        json: closure.contains(resources::STD_JSON_PACKAGE),
        num: closure.contains(resources::STD_NUM_PACKAGE),
        path: closure.contains(resources::STD_PATH_PACKAGE),
        path_slash: closure.contains(resources::STD_PATH_SLASH_PACKAGE),
        process: closure.contains(resources::STD_PROCESS_PACKAGE),
