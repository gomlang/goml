fn standard_needs_from_package_names(package_names: Vec[string]) -> StandardNeeds {
    let closure = resources::standard_package_closure(package_names);
    StandardNeeds {
        panic: closure.contains(resources::STD_PANIC_PACKAGE),
        root: closure.contains(resources::STD_ROOT_PACKAGE),
        ascii: closure.contains(resources::STD_ASCII_PACKAGE),
        bincode: closure.contains(resources::STD_BINCODE_PACKAGE),
        bytes: closure.contains(resources::STD_BYTES_PACKAGE),
        bytes_endian: closure.contains(resources::STD_BYTES_ENDIAN_PACKAGE),
        bytes_endian_stream: closure.contains(resources::STD_BYTES_ENDIAN_STREAM_PACKAGE),
        cmp: closure.contains(resources::STD_CMP_PACKAGE),
        collections: closure.contains(resources::STD_COLLECTIONS_PACKAGE),
        encoding: closure.contains(resources::STD_ENCODING_PACKAGE),
        encoding_base64: closure.contains(resources::STD_ENCODING_BASE64_PACKAGE),
        encoding_base32: closure.contains(resources::STD_ENCODING_BASE32_PACKAGE),
        encoding_base32_stream: closure.contains(resources::STD_ENCODING_BASE32_STREAM_PACKAGE),
        encoding_pem: closure.contains(resources::STD_ENCODING_PEM_PACKAGE),
        encoding_hex: closure.contains(resources::STD_ENCODING_HEX_PACKAGE),
        error: closure.contains(resources::STD_ERROR_PACKAGE),
        env: closure.contains(resources::STD_ENV_PACKAGE),
        ffi: closure.contains(resources::STD_FFI_PACKAGE),
        c: closure.contains(resources::STD_C_PACKAGE),
        fs: closure.contains(resources::STD_FS_PACKAGE),
        hash: closure.contains(resources::STD_HASH_PACKAGE),
        hash_adler32: closure.contains(resources::STD_HASH_ADLER32_PACKAGE),
        hash_crc32: closure.contains(resources::STD_HASH_CRC32_PACKAGE),
        hash_crc64: closure.contains(resources::STD_HASH_CRC64_PACKAGE),
        hash_fnv: closure.contains(resources::STD_HASH_FNV_PACKAGE),
        hash_stream: closure.contains(resources::STD_HASH_STREAM_PACKAGE),
        net: closure.contains(resources::STD_NET_PACKAGE),
        net_url: closure.contains(resources::STD_NET_URL_PACKAGE),
        net_tls: closure.contains(resources::STD_NET_TLS_PACKAGE),
        context: closure.contains(resources::STD_CONTEXT_PACKAGE),
        io: closure.contains(resources::STD_IO_PACKAGE),
        internal_host: closure.contains(resources::STD_INTERNAL_HOST_PACKAGE),
        internal_syscall: closure.contains(resources::STD_INTERNAL_SYSCALL_PACKAGE),
        os: closure.contains(resources::STD_OS_PACKAGE),
