package main;

use std::cmp;
use std::collections;
use std::io;
use std::process;
use std::text;

const CHECK_COMMAND: string = "check";

const TEST_CHECK_COMMAND: string = "test-check";

const BUILD_COMMAND: string = "build";

const TEST_BUILD_COMMAND: string = "test-build";

const LINK_COMMAND: string = "link";

const TEST_LINK_COMMAND: string = "test-link";

const PACKAGE_INFO_COMMAND: string = "package-info";

const RUN_SINGLE_COMMAND: string = "run-single";

const VERSION_COMMAND: string = "version";

const HELP_COMMAND: string = "help";

const LEX_STAGE: string = "lex";

const CST_STAGE: string = "cst";

const AST_STAGE: string = "ast";

const HIR_STAGE: string = "hir";

const TAST_STAGE: string = "tast";

const CORE_STAGE: string = "core";

const MONO_STAGE: string = "mono";

const LIFT_STAGE: string = "lift";

const ANF_STAGE: string = "anf";

const GO_STAGE: string = "go";

fn package_command(command: string) -> bool {
    match command {
        CHECK_COMMAND | TEST_CHECK_COMMAND | BUILD_COMMAND | TEST_BUILD_COMMAND => true,
        _ => false,
    }
}

fn top_level_help() -> string {
    \\Usage: gomlc <COMMAND>
    \\
    \\Commands:
    \\  check          
    \\  test-check     
    \\  build          
    \\  test-build     
    \\  link           
    \\  test-link      
    \\  bind-go
    \\  bind-c
    \\  package-info   
    \\  run-single     
    \\  version        
    \\  help           Print this message or the help of the given subcommand(s)
    \\
    \\Options:
    \\  -h, --help  Print help
}

fn package_command_help(command: string) -> string {
    "Usage: gomlc " + command +
        \\ [OPTIONS] --package <PACKAGE> --input <INPUT>... --output <OUTPUT>
        \\
        \\Options:
        \\      --package <PACKAGE>                
        \\      --module <MODULE>                  
        \\      --input <INPUT>...                 
        \\      --interface-path <INTERFACE_FILE>  
        \\      --output <OUTPUT>                  
        \\  -h, --help                             Print help
}

fn command_help(command: string) -> Option[string] {
    match command {
        "bind-go" => Option::Some(bind_go_help()),
        "bind-c" => Option::Some(bind_c_help()),
        CHECK_COMMAND | TEST_CHECK_COMMAND | BUILD_COMMAND | TEST_BUILD_COMMAND => Option::Some(
            package_command_help(command),
        ),
        LINK_COMMAND => Option::Some(
            \\Usage: gomlc link --input <INPUT>... --entry <ENTRY> --output <OUTPUT>
            \\
            \\Options:
            \\      --input <INPUT>...  
            \\      --entry <ENTRY>     
            \\      --output <OUTPUT>   
            \\  -h, --help              Print help
            ,
        ),
        TEST_LINK_COMMAND => Option::Some(
            \\Usage: gomlc test-link --input <INPUT>... --package <PACKAGE> --output <OUTPUT> --manifest <MANIFEST>
            \\
            \\Options:
            \\      --input <INPUT>...     
            \\      --package <PACKAGE>    
            \\      --output <OUTPUT>      
            \\      --manifest <MANIFEST>  
            \\  -h, --help                 Print help
            ,
        ),
        PACKAGE_INFO_COMMAND => Option::Some(
            \\Usage: gomlc package-info [OPTIONS] --input <INPUT>...
            \\
            \\Options:
            \\      --input <INPUT>...  
            \\      --format <FORMAT>   [default: json] [possible values: json]
            \\  -h, --help              Print help
            ,
        ),
        RUN_SINGLE_COMMAND => Option::Some(
            \\Usage: gomlc run-single [OPTIONS] <FILE>
            \\
            \\Arguments:
            \\  <FILE>  
            \\
            \\Options:
            \\      --dump-ast           
            \\      --dump-expanded-ast  
            \\      --dump-hir           
            \\      --dump-tast          
            \\      --dump-ctir          
            \\      --dump-core          
            \\      --dump-mono          
            \\      --dump-lift          
            \\      --dump-anf           
            \\      --dump-go            
            \\  -h, --help               Print help
            ,
        ),
        VERSION_COMMAND => Option::Some(
            \\Usage: gomlc version [OPTIONS]
            \\
            \\Options:
            \\      --format <FORMAT>  [default: text] [possible values: text, json]
            \\  -h, --help             Print help
            ,
        ),
        HELP_COMMAND => Option::Some(
            \\Print this message or the help of the given subcommand(s)
            \\
            \\Usage: gomlc help [COMMAND]...
            \\
            \\Arguments:
            \\  [COMMAND]...  Print help for the subcommand(s)
            ,
        ),
        _ => Option::None,
    }
}

fn command_usage(command: string) -> string {
    match command {
        CHECK_COMMAND | TEST_CHECK_COMMAND | BUILD_COMMAND | TEST_BUILD_COMMAND => "gomlc "
            + command
            + " [OPTIONS] --package <PACKAGE> --input <INPUT>... --output <OUTPUT>",
        LINK_COMMAND => "gomlc link --input <INPUT>... --entry <ENTRY> --output <OUTPUT>",
        TEST_LINK_COMMAND => "gomlc test-link --input <INPUT>... --package <PACKAGE> --output <OUTPUT> --manifest <MANIFEST>",
        PACKAGE_INFO_COMMAND => "gomlc package-info [OPTIONS] --input <INPUT>...",
        RUN_SINGLE_COMMAND => "gomlc run-single [OPTIONS] <FILE>",
        VERSION_COMMAND => "gomlc version [OPTIONS]",
        _ => "gomlc <COMMAND>",
    }
}

fn required_command_usage(command: string) -> string {
    match command {
        CHECK_COMMAND | TEST_CHECK_COMMAND | BUILD_COMMAND | TEST_BUILD_COMMAND => "gomlc "
            + command
            + " --package <PACKAGE> --input <INPUT>... --output <OUTPUT>",
        RUN_SINGLE_COMMAND => "gomlc run-single <FILE>",
        PACKAGE_INFO_COMMAND => "gomlc package-info --input <INPUT>...",
        _ => command_usage(command),
    }
}

fn cli_help_signal() -> string {
    "__gomlc_help_requested__"
}

fn is_cli_help_signal(value: string) -> bool {
    value == cli_help_signal()
}

fn cli_error_footer() -> string {
    "For more information, try '--help'."
}

fn cli_error(message: string) -> string {
    "error: " + message + "\n\n" + cli_error_footer()
}

fn cli_error_with_usage(message: string, usage: string) -> string {
    "error: " + message + "\n\nUsage: " + usage + "\n\n" + cli_error_footer()
}

fn cli_argument_name(argument: string) -> string {
    if !argument.starts_with("--") {
        return argument
    }
    let mut end = argument.byte_len();
    for index in 0..argument.byte_len() {
        if end == argument.byte_len() && argument.byte_get(index) == b'=' {
            end = index;
        }
    }
    argument.byte_slice(0, end)
}

fn cli_help_argument(argument: string) -> bool {
    argument == "--help" || argument.starts_with("-h")
}

fn cli_minimum(left: isize, middle: isize, right: isize) -> isize {
    let first = if left < middle {
        left
    } else {
        middle
    };
    if first < right {
        first
    } else {
        right
    }
}

fn cli_maximum(left: isize, right: isize) -> isize {
    if left > right {
        left
    } else {
        right
    }
}

fn cli_edit_distance(left: string, right: string) -> isize {
    let initial: Vec[isize] = Vec::new();
    for index in 0..right.byte_len() + 1 {
        initial.push(index)
    }
    let mut previous = initial;
    for left_index in 0..left.byte_len() {
        let current: Vec[isize] = Vec::new();
        current.push(left_index + 1);
        for right_index in 0..right.byte_len() {
            let substitution = if left.byte_get(left_index) == right.byte_get(right_index) {
                previous[right_index]
            } else {
                previous[right_index] + 1
            };
            current.push(
                cli_minimum(current[right_index] + 1, previous[right_index + 1] + 1, substitution),
            )
        }
        previous = current;
    }
    previous[right.byte_len()]
}

fn similar_cli_argument(command: string, argument: string) -> Option[string] {
    let candidates: Vec[string] = Vec::new();
    match command {
        CHECK_COMMAND | TEST_CHECK_COMMAND | BUILD_COMMAND | TEST_BUILD_COMMAND => {
            candidates.push("--package");
            candidates.push("--input");
            candidates.push("--interface-path");
            candidates.push("--output");
            candidates.push("--help")
        },
        LINK_COMMAND => {
            candidates.push("--input");
            candidates.push("--entry");
            candidates.push("--output");
            candidates.push("--help")
        },
        TEST_LINK_COMMAND => {
            candidates.push("--input");
            candidates.push("--package");
            candidates.push("--output");
            candidates.push("--manifest");
            candidates.push("--help")
        },
        PACKAGE_INFO_COMMAND => {
            candidates.push("--input");
            candidates.push("--format");
            candidates.push("--help")
        },
        RUN_SINGLE_COMMAND => {
            candidates.push(DUMP_AST_OPTION);
            candidates.push(DUMP_EXPANDED_AST_OPTION);
            candidates.push(DUMP_HIR_OPTION);
            candidates.push(DUMP_TAST_OPTION);
            candidates.push(DUMP_CORE_OPTION);
            candidates.push(DUMP_MONO_OPTION);
            candidates.push(DUMP_LIFT_OPTION);
            candidates.push(DUMP_ANF_OPTION);
            candidates.push(DUMP_GO_OPTION);
            candidates.push(DUMP_CTIR_OPTION);
            candidates.push("--help")
        },
        VERSION_COMMAND => {
            candidates.push("--format");
            candidates.push("--help")
        },
        _ => candidates.push("--help"),
    }
    let name = cli_argument_name(argument);
    let mut best: Option[string] = Option::None;
    let mut distance = 2147483647;
    for candidate in candidates {
        let candidate_distance = cli_edit_distance(name, candidate);
        if candidate_distance < distance {
            distance = candidate_distance;
            best = Option::Some(candidate);
        }
    }
    if distance <= 3 {
        best
    } else {
        Option::None
    }
}

fn similar_cli_argument_usage(command: string, argument: string) -> string {
    if command == "" && argument == "--help" {
        "gomlc --help <COMMAND>"
    } else if command == VERSION_COMMAND && argument == "--format" {
        "gomlc version --format <FORMAT>"
    } else if command == VERSION_COMMAND && argument == "--help" {
        "gomlc version --help"
    } else if command == PACKAGE_INFO_COMMAND && argument == "--format" {
        "gomlc package-info --format <FORMAT> --input <INPUT>..."
    } else if command == PACKAGE_INFO_COMMAND && argument == "--help" {
        "gomlc package-info --help --input <INPUT>..."
    } else if package_command(command) {
        if argument == "--interface-path" {
            required_command_usage(command) + " --interface-path <INTERFACE_FILE>"
        } else if argument == "--help" {
            required_command_usage(command) + " --help"
        } else {
            required_command_usage(command)
        }
    } else {
        command_usage(command)
    }
}

fn cli_value_option(command: string, argument: string) -> bool {
    match command {
        CHECK_COMMAND | TEST_CHECK_COMMAND | BUILD_COMMAND | TEST_BUILD_COMMAND => argument
            == "--package"
            || argument == "--module"
            || argument == "--input"
            || argument == "--interface-path"
            || argument == "--output",
        LINK_COMMAND => argument == "--input" || argument == "--entry" || argument == "--output",
        TEST_LINK_COMMAND => argument == "--input" || argument == "--package"
            || argument == "--output"
            || argument == "--manifest",
        PACKAGE_INFO_COMMAND => argument == "--input" || argument == "--format",
        VERSION_COMMAND => argument == "--format",
        _ => false,
    }
}

fn known_cli_option(command: string, argument: string) -> bool {
    if argument == "--" || cli_help_argument(argument)
        || option_string_present(inline_cli_value(argument, "--help"))
        || cli_value_option(command, argument) {
        true
    } else {
        match command {
            CHECK_COMMAND | TEST_CHECK_COMMAND | BUILD_COMMAND | TEST_BUILD_COMMAND => option_string_present(
                inline_cli_value(argument, "--package"),
            )
                || option_string_present(inline_cli_value(argument, "--module"))
                || option_string_present(inline_cli_value(argument, "--input"))
                || option_string_present(inline_cli_value(argument, "--interface-path"))
                || option_string_present(inline_cli_value(argument, "--output")),
            LINK_COMMAND => option_string_present(inline_cli_value(argument, "--input"))
                || option_string_present(inline_cli_value(argument, "--entry"))
                || option_string_present(inline_cli_value(argument, "--output")),
            TEST_LINK_COMMAND => option_string_present(inline_cli_value(argument, "--input"))
                || option_string_present(inline_cli_value(argument, "--package"))
                || option_string_present(inline_cli_value(argument, "--output"))
                || option_string_present(inline_cli_value(argument, "--manifest")),
            PACKAGE_INFO_COMMAND => option_string_present(inline_cli_value(argument, "--input"))
                || option_string_present(inline_cli_value(argument, "--format")),
            VERSION_COMMAND => option_string_present(inline_cli_value(argument, "--format")),
            _ => false,
        }
    }
}

fn unexpected_cli_option_error_with_usage(command: string, argument: string, usage: string) -> string {
    match similar_cli_argument(command, argument) {
        Some(similar) => unexpected_similar_argument_error(
            argument,
            similar,
            similar_cli_argument_usage(command, similar),
        ),
        None => unexpected_argument_error_with_usage(argument, false, usage),
    }
}

fn missing_required_arguments_error_with_usage(arguments: Vec[string], usage: string) -> string {
    let builder = text::StringBuilder::new();
    builder.write_string("error: the following required arguments were not provided:");
    for argument in arguments {
        builder.write_string("\n  ");
        builder.write_string(argument)
    }
    builder.write_string("\n\nUsage: ");
    builder.write_string(usage);
    builder.write_string("\n\n");
    builder.write_string(cli_error_footer());
    builder.finish()
}

fn missing_required_arguments_error(command: string, arguments: Vec[string]) -> string {
    missing_required_arguments_error_with_usage(arguments, required_command_usage(command))
}

fn value_required_error(argument: string, possible_values: Option[string]) -> string {
    let values = match possible_values {
        Some(values) => "\n  [possible values: " + values + "]",
        None => "",
    };
    "error: a value is required for '" + argument + "' but none was supplied" + values + "\n\n"
        + cli_error_footer()
}

fn unexpected_argument_error_with_usage(argument: string, value_tip: bool, usage: string) -> string {
    let name = cli_argument_name(argument);
    let displayed = if name.byte_len() > 2 && name.starts_with("-") && !name.starts_with("--") {
        name.byte_slice(0, 2)
    } else {
        name
    };
    let tip = if value_tip {
        "\n\n  tip: to pass '" + displayed + "' as a value, use '-- " + displayed + "'"
    } else {
        ""
    };
    cli_error_with_usage("unexpected argument '" + displayed + "' found" + tip, usage)
}

fn unexpected_argument_error(command: string, argument: string, value_tip: bool) -> string {
    unexpected_argument_error_with_usage(argument, value_tip, command_usage(command))
}

fn unexpected_similar_argument_error(argument: string, similar: string, usage: string) -> string {
    cli_error_with_usage(
        "unexpected argument '" + cli_argument_name(argument)
            + "' found\n\n  tip: a similar argument exists: '"
            + similar
            + "'",
        usage,
    )
}

fn repeated_argument_error(command: string, argument: string) -> string {
    cli_error_with_usage(
        "the argument '" + argument + "' cannot be used multiple times",
        command_usage(command),
    )
}

fn invalid_value_error(value: string, argument: string, possible_values: string) -> string {
    cli_error(
        "invalid value '" + value + "' for '" + argument + "'\n  [possible values: "
            + possible_values
            + "]",
    )
}

fn unexpected_value_error(command: string, value: string, argument: string, usage: string) -> string {
    cli_error_with_usage(
        "unexpected value '" + value + "' for '" + argument + "' found; no more were expected",
        "gomlc " + command + " " + usage,
    )
}

fn unexpected_value_error_with_usage(value: string, argument: string, usage: string) -> string {
    cli_error_with_usage(
        "unexpected value '" + value + "' for '" + argument + "' found; no more were expected",
        usage,
    )
}

fn is_debug_stage(command: string) -> bool {
    match command {
        LEX_STAGE | CST_STAGE | AST_STAGE | HIR_STAGE | TAST_STAGE | CORE_STAGE | MONO_STAGE | LIFT_STAGE | ANF_STAGE | GO_STAGE => true,
        _ => false,
    }
}

fn print_cli_help(message: string) -> () {
    io::println(message)
}

struct CliSimilarity {
    value: string,
    numerator: isize,
    denominator: isize,
}

fn cli_similarity_compare(left: CliSimilarity, right: CliSimilarity) -> cmp::Ordering {
    cmp::compare(left.numerator * right.denominator, right.numerator * left.denominator)
}

fn cli_jaro_similarity(left: string, right: string) -> Option[CliSimilarity] {
    if left == right {
        return Option::Some(CliSimilarity { value: right, numerator: 1, denominator: 1 })
    } else if left.byte_len() == 0 || right.byte_len() == 0 {
        return Option::None
    }
    let window = cli_maximum(cli_maximum(left.byte_len(), right.byte_len()) / 2 - 1, 0);
    let left_matches: Vec[bool] = Vec::new();
    let right_matches: Vec[bool] = Vec::new();
    for _ in 0..left.byte_len() {
        left_matches.push(false)
    }
    for _ in 0..right.byte_len() {
        right_matches.push(false)
    }
    let mut matches = 0;
    for left_index in 0..left.byte_len() {
        let start = cli_maximum(left_index - window, 0);
        let end = cli_minimum(left_index + window + 1, right.byte_len(), right.byte_len());
        let mut right_index = start;
        while right_index < end {
            let index = right_index;
            if !(right_matches[index]) && left.byte_get(left_index) == right.byte_get(index) {
                left_matches[left_index] = true;
                right_matches[index] = true;
                matches += 1;
                break
            } else {
                right_index = index + 1;
            }
        }
    }
    if matches == 0 {
        return Option::None
    }
    let mut right_index = 0;
    let mut mismatches = 0;
    for left_index in 0..left.byte_len() {
        if left_matches[left_index] {
            while !(right_matches[right_index]) {
                right_index += 1;
            }
            if left.byte_get(left_index) != right.byte_get(right_index) {
                mismatches += 1;
            }
            right_index += 1;
        }
    }
    let matched = matches;
    let transpositions = mismatches / 2;
    let numerator = matched * matched * right.byte_len() + matched * matched * left.byte_len()
        + (matched - transpositions) * left.byte_len() * right.byte_len();
    let denominator = 3 * left.byte_len() * right.byte_len() * matched;
    Option::Some(CliSimilarity { value: right, numerator, denominator })
}

fn similar_cli_subcommands(command: string) -> Vec[string] {
    let candidates: Vec[string] = Vec::new();
    candidates.push(CHECK_COMMAND);
    candidates.push(TEST_CHECK_COMMAND);
    candidates.push(BUILD_COMMAND);
    candidates.push(TEST_BUILD_COMMAND);
    candidates.push(LINK_COMMAND);
    candidates.push(TEST_LINK_COMMAND);
    candidates.push(PACKAGE_INFO_COMMAND);
    candidates.push(RUN_SINGLE_COMMAND);
    candidates.push(VERSION_COMMAND);
    candidates.push(HELP_COMMAND);
    let similar: Vec[CliSimilarity] = Vec::new();
    for candidate in candidates {
        if let Some(value) = cli_jaro_similarity(command, candidate) {
            if value.numerator * 10 >= value.denominator * 7 {
                similar.push(value)
            }
        }
    }
    collections::sort_by_ordering(similar, cli_similarity_compare);
    let result: Vec[string] = Vec::new();
    for value in similar {
        result.push(value.value)
    }
    result
}

fn similar_subcommand_tip(values: Vec[string]) -> string {
    if values.is_empty() {
        ""
    } else {
        let builder = text::StringBuilder::new();
        builder.write_string(
            if values.len() == 1 {
                "\n\n  tip: a similar subcommand exists: "
            } else {
                "\n\n  tip: some similar subcommands exist: "
            },
        );
        for index in 0..values.len() {
            if index > 0 {
                builder.write_string(", ")
            }
            builder.write_char('\'');
            builder.write_string(values[index]);
            builder.write_char('\'')
        }
        builder.finish()
    }
}

fn unknown_subcommand_error(command: string) -> string {
    let tip = similar_subcommand_tip(similar_cli_subcommands(command));
    "error: unrecognized subcommand '" + command + "'" + tip +
        \\
        \\
        \\Usage: gomlc <COMMAND>
        \\
        \\For more information, try '--help'.
}

fn fail_cli(message: string) -> () {
    io::eprintln(message);
    process::exit(2)
}

fn fail_unknown_subcommand(command: string) -> () {
    fail_cli(unknown_subcommand_error(command))
}

fn handle_cli_parse_error(command: string, error: string) -> () {
    if is_cli_help_signal(error) {
        if let Some(help) = command_help(command) {
            print_cli_help(help)
        }
        process::exit(0)
    } else {
        fail_cli(error)
    }
}

fn run_help_command(args: Vec[string]) -> () {
    if args.len() == 2 {
        print_cli_help(top_level_help())
    } else if args.len() == 3 {
        match command_help(args[2]) {
            Some(help) => print_cli_help(help),
            None => fail_unknown_subcommand(args[2]),
        }
    } else {
        let command = args[2];
        match command_help(command) {
            Some(_) => {
                let usage = if command == HELP_COMMAND {
                    "gomlc help [COMMAND]..."
                } else {
                    command_usage(command)
                };
                let footer = if command == HELP_COMMAND {
                    ""
                } else {
                    "\n\n" + cli_error_footer()
                };
                fail_cli(
                    "error: unrecognized subcommand '" + args[3] + "'\n\nUsage: " + usage + footer,
                )
            },
            None => fail_unknown_subcommand(command),
        }
    }
}
