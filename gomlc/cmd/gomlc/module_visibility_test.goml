package main;

use std::testing;

#[test]
fn package_information_includes_module_visible_reexports() -> () {
    let source = "package facade; pub(module) use module::state::{State}; use std::text; fn main() -> () {}";
    let value = testing::expect_ok(
        parse_package_info_file("facade.goml", source),
        "module-visible import metadata",
    );
    testing::assert_eq(value.uses.len(), 2);
    testing::assert_eq(value.uses[0].path, "module::state");
    testing::assert(value.uses[0].reexport);
    testing::assert(!value.uses[1].reexport);
}
