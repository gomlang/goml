package main;

use module::ffi;
use std::fs;
use std::json;

fn write_foreign_context_command(args: Vec[string]) -> Result[(), string] {
    let values: HashMap[string, string] = HashMap::new();
    let mut index = 2;
    while index < args.len() {
        let key = args[index];
        if key != "--go" && key != "--module-directory" && key != "--output" {
            return Err("ffi-protocol: unknown build-context option " + key)
        }
        if values[key].is_some() {
            return Err("ffi-protocol: repeated option " + key)
        }
        if index + 1 >= args.len() || args[index + 1] == "" || args[index + 1].starts_with("--") {
            return Err("ffi-protocol: missing value for " + key)
        }
        values[key] = args[index + 1];
        index += 2;
    }
    let program = values["--go"].ok_or("ffi-protocol: --go is required")?;
    let directory = values["--module-directory"].ok_or(
        "ffi-protocol: --module-directory is required",
    )?;
    let output = values["--output"].ok_or("ffi-protocol: --output is required")?;
    let context = ffi::resolve_foreign_build_context(program, directory)?;
    fs::atomic_write(output, json::encode(ffi::build_context_json(context))).map_err(
        |error| error.to_string(),
    )
}

fn run_foreign_context_command(args: Vec[string]) -> () {
    match write_foreign_context_command(args) {
        Ok(()) => (),
        Err(message) => fail(message),
    }
}
