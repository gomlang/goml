package main;

use module::artifact::core_codec;
use module::artifact::interface_codec;
use module::mono;
use module::tast;
use std::fs;
use std::path;
use std::testing;

fn exercise_inherited_associated_predicate_artifacts(directory: string) -> Result[(), string] {
    fs::create_dir_all(directory).map_err(|error| error.to_string())?;
    let api = compile_go_library_piece(
        directory,
        "associated_api",
        "package associated_api; pub trait File { fn size(self: Self) -> i32; } pub trait FileSystem { type Handle: File; fn open(self: Self) -> Self::Handle; } pub trait LinkFileSystem: FileSystem { fn link(self: Self) -> i32; } pub trait ReadDirFile: File { fn count(self: Self) -> i32; } pub fn inspect[F: LinkFileSystem](source: F) -> i32 where F::Handle: ReadDirFile { source.open().count() + source.link() }",
        Vec::new(),
    )?;
    let interface = interface_codec::decode_binary(
        interface_codec::encode_binary(api.interface_unit)?,
    )?;
    let mut found_function = false;
    for function in interface.exports.functions {
        if function.name == "demo::associated_api::inspect" {
            found_function = true;
            let mut found_projection = false;
            let mut found_parent = false;
            for predicate in function.constraints {
                if let tast::TypePredicate::Trait { for_ty, trait_ref } = predicate {
                    if trait_ref.name == "demo::associated_api::ReadDirFile" {
                        if let tast::Type::Projection { name, trait_ref: owner, .. } = for_ty {
                            testing::assert_eq(name, "Handle");
                            let owner = owner.ok_or("exported Handle projection lost its owner")?;
                            testing::assert_eq(owner.name, "demo::associated_api::FileSystem");
                            found_projection = true;
                        }
                    }
                    if trait_ref.name == "demo::associated_api::FileSystem" {
                        found_parent = true;
                    }
                }
            }
            testing::assert(found_projection);
            testing::assert(found_parent);
        }
    }
    testing::assert(found_function);
    let interface_path = path::join(directory, "associated_api.interface");
    write_artifact_interface(interface_path, interface)?;
    let consumer = compile_go_library_piece(
        directory,
        "associated_consumer",
        "package associated_consumer; use demo::associated_api; use associated_api::{File, FileSystem, LinkFileSystem, ReadDirFile}; struct Handle {} impl File for Handle { fn size(self: Handle) -> i32 { 4 } } impl ReadDirFile for Handle { fn count(self: Handle) -> i32 { 3 } } struct Provider {} impl FileSystem for Provider { type Handle = Handle; fn open(self: Provider) -> Handle { Handle {} } } impl LinkFileSystem for Provider { fn link(self: Provider) -> i32 { 2 } } #[go_export(\"Inspect\")] pub fn inspect() -> i32 { associated_api::inspect(Provider {}) }",
        Vec::from_array([interface_path]),
    )?;
    let units = Vec::from_array(
        [
            core_codec::decode_binary(core_codec::encode_binary(api.core_unit)?)?,
            core_codec::decode_binary(core_codec::encode_binary(consumer.core_unit)?)?,
        ],
    );
    let linked = link_go_library_core(test_package_world(), units, "demo::associated_consumer")?;
    let lowered = mono::lower_checked(eliminate_core_dead_code(linked.core_value));
    if let Some(message) = lowered.error {
        return Result::Err(message)
    }
    mono::validate(mono::dce(lowered.file))?;
    Result::Ok(())
}

#[test]
fn inherited_associated_predicates_survive_interface_and_core_restoration() -> () {
    let temporary = temp_go_path("associated-predicates.gom", "roundtrip");
    let result = exercise_inherited_associated_predicate_artifacts(
        path::parent(temporary).unwrap_or(""),
    );
    cleanup_temp_directory(temporary);
    if let Err(message) = result {
        testing::fail(message)
    }
}
