package main;

use std::env;
use std::path;
use std::process;

fn bind_c_help() -> string {
    "Usage: gomlc bind-c <CONFIG> [--dry-run | --check]\n\nGenerate allowlisted C bindings using Clang and cgo."
}

fn execute_c_binding_command(args: Vec[string]) -> Result[(), string] {
    let executable = env::current_exe_structured().map_err(|error| error.to_string())?;
    let helper = path::join(
        path::parent(executable).ok_or("bind-c: missing compiler directory")?,
        "goml-c-bind",
    );
    let forwarded: Vec[string] = Vec::new();
    for index in 2..args.len() {
        forwarded.push(args[index]);
    }
    let status = process::Command::new(helper).args(forwarded).status_structured().map_err(
        |error| "bind-c: " + error.to_string(),
    )?;
    if !status.success() {
        return Result::Err("bind-c: generation or verification failed")
    }
    Result::Ok(())
}

fn run_bind_c_command(args: Vec[string]) -> () {
    if let Err(error) = execute_c_binding_command(args) {
        fail(error);
    }
}
