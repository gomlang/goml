package main;

use module::artifact::core_codec as core_codec;
use module::artifact::interface_codec as interface_codec;
use module::artifact::wire as wire;
use module::artifact;
use module::ast;
use module::ctir;
use module::tast;
use std::path;

fn artifact_function_type(params: Vec[(string, tast::Type)], ret_ty: tast::Type) -> tast::Type {
    let types: Vec[tast::Type] = Vec::new();
    for param in params {
        types.push(param.1)
    }
    tast::Type::Func { params: types, ret_ty }
}

fn artifact_fn_scheme(value: tast::FunctionScheme) -> artifact::ArtifactFnScheme {
    artifact::ArtifactFnScheme {
        name: value.name,
        comptime: value.comptime,
        type_params: value.generics,
        constraints: value.predicates,
        ty: tast::Type::Func { params: value.params, ret_ty: value.ret_ty },
        body: value.callable,
    }
}

fn artifact_package_fn_scheme(
    builtin: tast::BuiltinContract,
    package_name: string,
    value: tast::FunctionScheme,
) -> artifact::ArtifactFnScheme {
    let scheme = artifact_fn_scheme(value);
    if package_name == "prelude" && builtin.range.public_name == Option::Some(scheme.name) {
        artifact::ArtifactFnScheme {
            name: scheme.name,
            comptime: scheme.comptime,
            type_params: scheme.type_params,
            constraints: scheme.constraints,
            ty: scheme.ty,
            body: tast::Callable::LangItem { item: builtin.range.item, function_name: scheme.name },
        }
    } else {
        scheme
    }
}

fn artifact_local_trait_name(owner: string, name: string, trait_names: Vec[string]) -> string {
    if name.contains("::") {
        name
    } else {
        let separator = core_codec::artifact_constructor_separator(owner);
        let candidate = if separator < 0 {
            name
        } else {
            owner.byte_slice(0, separator + 2) + name
        };
        if trait_names.contains(candidate) {
            candidate
        } else {
            name
        }
    }
}

fn artifact_trait_definition_ref(value: tast::TraitRef, owner: string, trait_names: Vec[string]) -> tast::TraitRef {
    let args: Vec[tast::Type] = Vec::new();
    for arg in value.args {
        args.push(artifact_trait_definition_type(arg, owner, trait_names))
    }
    tast::TraitRef { name: artifact_local_trait_name(owner, value.name, trait_names), args }
}

fn artifact_trait_definition_type(value: tast::Type, owner: string, trait_names: Vec[string]) -> tast::Type {
    match tast::resolve_type(value) {
        Param { name } => if name == "Self" {
            tast::Type::Con { name }
        } else {
            tast::Type::Param { name }
        },
        External { import_path, name, args } => {
            let result: Vec[tast::Type] = Vec::new();
            for arg in args {
                result.push(artifact_trait_definition_type(arg, owner, trait_names))
            }
            tast::Type::External { import_path, name, args: result }
        },
        Tuple { items: values } => {
            let result: Vec[tast::Type] = Vec::new();
            for value in values {
                result.push(artifact_trait_definition_type(value, owner, trait_names))
            }
            tast::Type::Tuple { items: result }
        },
        Projection { for_ty, name, trait_ref } => tast::Type::Projection {
            for_ty: artifact_trait_definition_type(for_ty, owner, trait_names),
            name,
            trait_ref: trait_ref.map(
                |value| artifact_trait_definition_ref(value, owner, trait_names),
            ),
        },
        App { ty: base, args } => {
            let result: Vec[tast::Type] = Vec::new();
            for arg in args {
                result.push(artifact_trait_definition_type(arg, owner, trait_names))
            }
            tast::Type::App {
                ty: artifact_trait_definition_type(base, owner, trait_names),
                args: result,
            }
        },
        Array { len: length, elem: element } => tast::Type::Array {
            len: length,
            elem: artifact_trait_definition_type(element, owner, trait_names),
        },
        Slice { elem: element } => tast::Type::Slice {
            elem: artifact_trait_definition_type(element, owner, trait_names),
        },
        MutSlice { elem: element } => tast::Type::MutSlice {
            elem: artifact_trait_definition_type(element, owner, trait_names),
        },
        VecType { elem: element } => tast::Type::VecType {
            elem: artifact_trait_definition_type(element, owner, trait_names),
        },
        GoPointer { elem: element } => tast::Type::GoPointer {
            elem: artifact_trait_definition_type(element, owner, trait_names),
        },
        GoFunction { signature: element } => tast::Type::GoFunction {
            signature: artifact_trait_definition_type(element, owner, trait_names),
        },
        RefType { elem: element } => tast::Type::RefType {
            elem: artifact_trait_definition_type(element, owner, trait_names),
        },
        Channel { elem: element, direction } => tast::Type::Channel {
            elem: artifact_trait_definition_type(element, owner, trait_names),
            direction,
        },
        HashMap { key, value: item } => tast::Type::HashMap {
            key: artifact_trait_definition_type(key, owner, trait_names),
            value: artifact_trait_definition_type(item, owner, trait_names),
        },
        GoMap { key, value: item } => tast::Type::GoMap {
            key: artifact_trait_definition_type(key, owner, trait_names),
            value: artifact_trait_definition_type(item, owner, trait_names),
        },
        Func { params, ret_ty } => {
            let result: Vec[tast::Type] = Vec::new();
            for param in params {
                result.push(artifact_trait_definition_type(param, owner, trait_names))
            }
            tast::Type::Func {
                params: result,
                ret_ty: artifact_trait_definition_type(ret_ty, owner, trait_names),
            }
        },
        other => other,
    }
}

fn artifact_trait_definition_predicate(
    value: tast::TypePredicate,
    owner: string,
    trait_names: Vec[string],
) -> tast::TypePredicate {
    match value {
        GoComparable(ty) => tast::TypePredicate::GoComparable(
            artifact_trait_definition_type(ty, owner, trait_names),
        ),
        Trait { for_ty, trait_ref } => tast::TypePredicate::Trait {
            for_ty: artifact_trait_definition_type(for_ty, owner, trait_names),
            trait_ref: artifact_trait_definition_ref(trait_ref, owner, trait_names),
        },
        Equality { lhs: left, rhs: right } => tast::TypePredicate::Equality {
            lhs: artifact_trait_definition_type(left, owner, trait_names),
            rhs: artifact_trait_definition_type(right, owner, trait_names),
        },
    }
}

fn artifact_trait_def(value: tast::TraitInfo, trait_names: Vec[string]) -> artifact::ArtifactTraitDef {
    let default_map_requirements = Vec::new();
    for method in value.methods {
        if !method.default_map_requirements.is_empty() {
            let keys = Vec::new();
            for key in method.default_map_requirements {
                keys.push(artifact_trait_definition_type(key, value.name, trait_names))
            }
            default_map_requirements.push((method.name, keys));
        }
    }
    let associated_types: Vec[artifact::ArtifactAssociatedTypeDef] = Vec::new();
    for associated in value.associated_types {
        let bounds: Vec[tast::TraitRef] = Vec::new();
        for bound in associated.bounds {
            bounds.push(artifact_trait_definition_ref(bound, value.name, trait_names))
        }
        associated_types.push(artifact::ArtifactAssociatedTypeDef { name: associated.name, bounds })
    }
    let methods: Vec[artifact::ArtifactFnScheme] = Vec::new();
    for method in value.methods {
        let constraints: Vec[tast::TypePredicate] = Vec::new();
        for predicate in method.predicates {
            constraints.push(
                artifact_trait_definition_predicate(predicate, value.name, trait_names),
            )
        }
        methods.push(
            artifact::ArtifactFnScheme {
                name: method.name,
                comptime: tast::ComptimeCapability::RuntimeOnly,
                type_params: method.generics,
                constraints,
                ty: artifact_trait_definition_type(
                    tast::Type::Func { params: method.params, ret_ty: method.ret_ty },
                    value.name,
                    trait_names,
                ),
                body: tast::Callable::Function(method.default_name.unwrap_or(method.name)),
            },
        )
    }
    let predicates: Vec[tast::TypePredicate] = Vec::new();
    for predicate in value.predicates {
        predicates.push(artifact_trait_definition_predicate(predicate, value.name, trait_names))
    }
    let supertraits: Vec[tast::TraitRef] = Vec::new();
    for supertrait in value.supertraits {
        supertraits.push(artifact_trait_definition_ref(supertrait, value.name, trait_names))
    }
    artifact::ArtifactTraitDef {
        default_map_requirements,
        name: value.name,
        params: value.generics,
        predicates,
        supertraits,
        associated_types,
        methods,
    }
}

fn artifact_method_constraints(value: tast::Function, start: isize) -> Vec[tast::TypePredicate] {
    let result: Vec[tast::TypePredicate] = Vec::new();
    for index in start..value.predicates.len() {
        result.push(value.predicates[index])
    }
    result
}

fn artifact_default_method_name(value: tast::Function) -> Option[string] {
    if !value.body.stmts.is_empty() {
        Option::None
    } else {
        match value.body.tail {
            Some(tast::Expr::Call {
                func: tast::Expr::Callable { callable: tast::Callable::Function(name), ty: _ },
                args: _,
                ty: _,
            }) => if name.contains("trait_default#") {
                Option::Some(name)
            } else {
                Option::None
            },
            _ => Option::None,
        }
    }
}

fn artifact_method_scheme(
    value: tast::Function,
    owner_generic_count: isize,
    constraint_start: isize,
) -> artifact::ArtifactFnScheme {
    let type_params: Vec[string] = Vec::new();
    for index in owner_generic_count..value.generics.len() {
        type_params.push(value.generics[index])
    }
    artifact::ArtifactFnScheme {
        name: value.name,
        comptime: value.comptime,
        type_params,
        constraints: artifact_method_constraints(value, constraint_start),
        ty: artifact_function_type(value.params, value.ret_ty),
        body: tast::Callable::Function(artifact_default_method_name(value).unwrap_or(value.name)),
    }
}

fn artifact_method_is_public(value: tast::Function) -> bool {
    match value.visibility {
        Public => true,
        Private => false,
    }
}

fn artifact_impl_methods(
    value: tast::ImplBlock,
    owner_generic_count: isize,
    constraint_start: isize,
    public_only: bool,
) -> Vec[artifact::ArtifactFnScheme] {
    let result: Vec[artifact::ArtifactFnScheme] = Vec::new();
    for method in value.methods {
        if !public_only || artifact_method_is_public(method) {
            result.push(artifact_method_scheme(method, owner_generic_count, constraint_start))
        }
    }
    result
}

fn artifact_trait_impl(value: tast::ImplBlock) -> artifact::ArtifactTraitImpl {
    let trait_ref = match value.trait_ref {
        Some(value) => value,
        None => {
            fail("error[compile]: missing trait in compiler artifact");
            tast::TraitRef { name: "<error>", args: Vec::new() }
        },
    };
    artifact::ArtifactTraitImpl {
        trait_ref,
        for_ty: value.for_type,
        definition: artifact::ArtifactImplDef {
            params: value.generics,
            constraints: value.predicates,
            associated_types: value.associated_types,
            methods: artifact_impl_methods(
                value,
                value.generics.len(),
                value.predicates.len(),
                false,
            ),
            valid: true,
        },
    }
}

fn artifact_inherent_impl(value: tast::ImplBlock, public_only: bool) -> artifact::ArtifactInherentImpl {
    artifact::ArtifactInherentImpl {
        key: artifact::ArtifactInherentImplKey::Exact(value.for_type),
        definition: artifact::ArtifactImplDef {
            params: value.generics,
            constraints: value.predicates,
            associated_types: Vec::new(),
            methods: artifact_impl_methods(
                value,
                value.generics.len(),
                value.predicates.len(),
                public_only,
            ),
            valid: true,
        },
    }
}

fn artifact_struct_def(value: tast::StructDef, public_only: bool) -> tast::StructDef {
    if !public_only {
        value
    } else {
        let fields: Vec[(string, tast::Type)] = Vec::new();
        let public_fields: Vec[string] = Vec::new();
        for field in value.fields {
            if value.public_fields.contains(field.0) {
                fields.push(field);
                public_fields.push(field.0)
            }
        }
        tast::StructDef {
            map_requirements: value.map_requirements,
            name: value.name,
            generics: value.generics,
            fields,
            public_fields,
            has_hidden_fields: value.has_hidden_fields || fields.len() != value.fields.len(),
            go_comparable: value.go_comparable,
        }
    }
}

fn artifact_type_has_public_names(
    value: tast::Type,
    package_name: string,
    public_names: Vec[string],
) -> bool {
    match tast::resolve_type(value) {
        External { import_path: _, name: _, args } => {
            for arg in args {
                if !artifact_type_has_public_names(arg, package_name, public_names) {
                    return false
                }
            }
            true
        },
        Con { name } => local_item_is_public(package_name, public_names, name),
        Dyn { trait_name: name, .. } => local_item_is_public(package_name, public_names, name),
        Tuple { items: values } => {
            for value in values {
                if !artifact_type_has_public_names(value, package_name, public_names) {
                    return false
                }
            }
            true
        },
        Projection { for_ty, name: _, trait_ref } => {
            if !artifact_type_has_public_names(for_ty, package_name, public_names) {
                false
            } else {
                match trait_ref {
                    Some(value) => artifact_trait_ref_has_public_names(
                        value,
                        package_name,
                        public_names,
                    ),
                    None => true,
                }
            }
        },
        App { ty: base, args } => {
            if !artifact_type_has_public_names(base, package_name, public_names) {
                false
            } else {
                for arg in args {
                    if !artifact_type_has_public_names(arg, package_name, public_names) {
                        return false
                    }
                }
                true
            }
        },
        Array { len: _, elem: element } | Slice { elem: element } | MutSlice { elem: element } | VecType {
            elem: element,
        } | GoPointer { elem: element } | GoFunction { signature: element } | RefType {
            elem: element,
        } | Channel { elem: element, direction: _ } => artifact_type_has_public_names(
            element,
            package_name,
            public_names,
        ),
        HashMap { key, value } => artifact_type_has_public_names(key, package_name, public_names)
            && artifact_type_has_public_names(value, package_name, public_names),
        GoMap { key, value } => artifact_type_has_public_names(key, package_name, public_names)
            && artifact_type_has_public_names(value, package_name, public_names),
        Func { params, ret_ty } => {
            for param in params {
                if !artifact_type_has_public_names(param, package_name, public_names) {
                    return false
                }
            }
            artifact_type_has_public_names(ret_ty, package_name, public_names)
        },
        Var(_) | Unit | Never | Bool | Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | Float32 | Float64 | String | Char | Param {
            name: _,
        } | Error => true,
    }
}

fn artifact_trait_ref_has_public_names(
    value: tast::TraitRef,
    package_name: string,
    public_names: Vec[string],
) -> bool {
    if !local_item_is_public(package_name, public_names, value.name) {
        false
    } else {
        for arg in value.args {
            if !artifact_type_has_public_names(arg, package_name, public_names) {
                return false
            }
        }
        true
    }
}

fn artifact_trait_impl_is_public(
    value: tast::ImplBlock,
    package_name: string,
    public_names: Vec[string],
) -> bool {
    match value.trait_ref {
        Some(trait_ref) => artifact_trait_ref_has_public_names(
            trait_ref,
            package_name,
            public_names,
        )
            && artifact_type_has_public_names(value.for_type, package_name, public_names),
        None => true,
    }
}

fn artifact_add_type_name(values: Vec[string], name: string) -> () {
    if values.contains(name) {} else {
        values.push(name)
    }
}

fn artifact_package_exports_with_contract(
    builtin: tast::BuiltinContract,
    file: tast::File,
    signatures: tast::PackageSignatures,
    package_name: string,
    public_names: Vec[string],
    public_reexports: Vec[(string, string)],
    public_only: bool,
    enum_type_names: Vec[string],
    struct_type_names: Vec[string],
) -> artifact::ArtifactPackageExports {
    tast::attach_inferred_function_predicates(signatures, file);
    let result = interface_codec::empty_exports();
    for reexport in public_reexports {
        result.reexports.push((package_item_name(package_name, reexport.0), reexport.1))
    }
    for name in enum_type_names {
        artifact_add_type_name(result.enum_type_names, name)
    }
    for name in struct_type_names {
        artifact_add_type_name(result.struct_type_names, name)
    }
    for definition in file.enums {
        artifact_add_type_name(result.enum_type_names, definition.name);
        if !public_only || public_names.contains(definition.name) {
            result.enums.push(definition)
        }
    }
    for definition in file.structs {
        artifact_add_type_name(result.struct_type_names, definition.name);
        if !public_only || public_names.contains(definition.name) {
            result.structs.push(artifact_struct_def(definition, public_only))
        }
    }
    for alias in signatures.type_aliases {
        if !public_only || public_names.contains(alias.name) {
            result.type_aliases.push(alias)
        }
    }
    let trait_names: Vec[string] = Vec::new();
    for definition in signatures.traits {
        trait_names.push(definition.name)
    }
    for definition in signatures.traits {
        if !public_only || public_names.contains(definition.name) {
            result.traits.push(artifact_trait_def(definition, trait_names))
        }
    }
    for function in signatures.functions {
        match function.comptime {
            tast::ComptimeCapability::Derive => (),
            _ => if !public_only || public_names.contains(function.name) {
                result.functions.push(artifact_package_fn_scheme(builtin, package_name, function))
            },
        }
    }
    for value in signatures.constants {
        if !public_only || public_names.contains(value.name) {
            result.constants.push(
                tast::ConstantScheme {
                    def_id: Option::None,
                    name: value.name,
                    ty: value.ty,
                    value: Option::None,
                },
            )
        }
    }
    for item in file.items {
        match item {
            ImplBlock(value) => match value.trait_ref {
                Some(_) => if !public_only
                    || artifact_trait_impl_is_public(value, package_name, public_names) {
                    result.trait_impls.push(artifact_trait_impl(value))
                },
                None => {
                    let implementation = artifact_inherent_impl(value, public_only);
                    if !public_only || !implementation.definition.methods.is_empty() {
                        result.inherent_impls.push(implementation)
                    }
                },
            },
            Function(_) => (),
        }
    }
    result
}

fn artifact_package_exports(
    file: tast::File,
    signatures: tast::PackageSignatures,
    package_name: string,
    public_names: Vec[string],
    public_reexports: Vec[(string, string)],
    public_only: bool,
    enum_type_names: Vec[string],
    struct_type_names: Vec[string],
) -> Result[artifact::ArtifactPackageExports, string] {
    Result::Ok(
        artifact_package_exports_with_contract(
            tast::builtin_contract()?,
            file,
            signatures,
            package_name,
            public_names,
            public_reexports,
            public_only,
            enum_type_names,
            struct_type_names,
        ),
    )
}

fn required_artifact_package_exports(
    file: tast::File,
    signatures: tast::PackageSignatures,
    package_name: string,
    public_names: Vec[string],
    public_reexports: Vec[(string, string)],
    public_only: bool,
    enum_type_names: Vec[string],
    struct_type_names: Vec[string],
) -> artifact::ArtifactPackageExports {
    match artifact_package_exports(
        file,
        signatures,
        package_name,
        public_names,
        public_reexports,
        public_only,
        enum_type_names,
        struct_type_names,
    ) {
        Ok(value) => value,
        Err(error) => {
            fail("error[compile]: " + error);
            interface_codec::empty_exports()
        },
    }
}

fn artifact_comptime_unit(value: ctir::CtModule, exports: artifact::ArtifactPackageExports) -> Option[
    artifact::ArtifactComptimeUnit,
] {
    let entries: Vec[string] = Vec::new();
    let constants: Vec[string] = Vec::new();
    for function in exports.functions {
        match function.comptime {
            tast::ComptimeCapability::Capable => entries.push(function.name),
            tast::ComptimeCapability::RuntimeOnly | tast::ComptimeCapability::Derive => (),
        }
    }
    for constant in exports.constants {
        constants.push(constant.name)
    }
    let module = ctir::public_module(value, entries, constants);
    for index in 0..module.origins.len() {
        let origin = module.origins[index];
        module.origins.set(
            index,
            ctir::CtOrigin {
                source_path: path::file_name(origin.source_path).unwrap_or(origin.source_path),
                start: origin.start,
                end: origin.end,
            },
        )
    }
    if module.entries.is_empty() && module.derive_entries.is_empty() && module.constants.is_empty() {
        Option::None
    } else {
        Option::Some(interface_codec::new_comptime_unit(module))
    }
}

fn artifact_relative_export_name(package_name: string, name: string) -> string {
    if package_name == "main" || package_name == "builtin" || package_name == "prelude" {
        name
    } else {
        let prefix = package_name + "::";
        if name.starts_with(prefix) {
            name.byte_slice(prefix.byte_len(), name.byte_len())
        } else {
            name
        }
    }
}

fn artifact_package_interface(
    package_name: string,
    declared_name: string,
    exports: artifact::ArtifactPackageExports,
) -> artifact::ArtifactPackageInterface {
    let function_names: Vec[string] = Vec::new();
    for function in exports.functions {
        function_names.push(function.name)
    }
    let function_names = wire::sort_artifact_names(function_names);
    let value_exports: Vec[(string, isize)] = Vec::new();
    for index in 0..function_names.len() {
        value_exports.push((function_names[index], index))
    }
    let enum_names: Vec[string] = Vec::new();
    for definition in exports.enums {
        enum_names.push(artifact_relative_export_name(package_name, definition.name))
    }
    let enum_names = wire::sort_artifact_names(enum_names);
    let enum_variants: Vec[(string, Vec[string])] = Vec::new();
    for name in enum_names {
        let variants: Vec[string] = Vec::new();
        for definition in exports.enums {
            if artifact_relative_export_name(package_name, definition.name) == name {
                for variant in definition.variants {
                    variants.push(variant.name)
                }
            }
        }
        enum_variants.push((name, wire::sort_artifact_names(variants)))
    }
    artifact::ArtifactPackageInterface {
        package_name,
        name: declared_name,
        value_exports,
        enum_variants,
    }
}
