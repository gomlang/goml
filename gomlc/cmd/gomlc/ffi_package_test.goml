package main;

use module::artifact;
use module::test_support;
use std::bytes;
use std::fs;
use std::path;
use std::process;
use std::testing;
use std::utf8;
use utf8::BytesUtf8;

fn compile_private_foreign_interface(world: PackageWorld, directory: string, symbol: string) -> Result[
    artifact::ArtifactInterfaceUnit,
    string,
] {
    let source_path = path::join(directory, "calc.goml");
    fs::write_file_structured(
        source_path,
        "package calc; #[go_ffi(\"math\", \"" + symbol
            + "\")] extern fn unused_private(value: f64) -> f64; pub fn visible() -> bool { true }",
    ).map_err(|error| error.to_string())?;
    let command = PackageCommandArgs {
        package_name: "demo::calc",
        module_name: "demo::calc",
        inputs: Vec::from_array([source_path]),
        interface_paths: Vec::new(),
        output: path::join(directory, "calc"),
        world: Option::None,
    };
    let compiled = compile_artifact_package(world, command, false, false)?;
    Result::Ok(compiled.interface_unit)
}

fn foreign_package_cli_output(directory: string, subcommand: string) -> Result[
    process::Output,
    string,
] {
    test_support::compiler_command(
        Vec::from_array(
            [
                subcommand,
                "--package",
                "demo::calc",
                "--module",
                "demo::calc",
                "--input",
                path::join(directory, "calc.goml"),
                "--output",
                path::join(directory, subcommand),
            ],
        ),
    )?.current_dir(directory).output_structured().map_err(|error| error.to_string())
}

fn exercise_foreign_package_publication(directory: string, subcommand: string) -> Result[(), string] {
    ffi_driver_fixture(directory)?;
    let world = test_package_world();
    let _ = compile_private_foreign_interface(world, directory, "MissingFunction")?;
    let output_base = path::join(directory, subcommand);
    let interface_path = interface_output_path(output_base);
    let core_path = core_output_path(output_base);
    let output = foreign_package_cli_output(directory, subcommand)?;
    if !output.status().success() {
        return Result::Err(output.stderr().to_string_utf8().unwrap_or("package publication failed"))
    }
    let before = fs::read_bytes_structured(interface_path).map_err(|error| error.to_string())?;
    let has_core = subcommand == "build" || subcommand == "test-build";
    testing::assert_eq(fs::is_file(core_path), has_core);
    let core_before = if has_core {
        fs::read_bytes_structured(core_path).map_err(|error| error.to_string())?
    } else {
        bytes::Bytes::from_string("")
    };
    fs::write_file_structured(
        path::join(directory, "calc.goml"),
        "package calc; fn broken() -> i64 { true }",
    ).map_err(|error| error.to_string())?;
    let output = foreign_package_cli_output(directory, subcommand)?;
    testing::assert(!output.status().success());
    assert_foreign_artifact_bytes(interface_path, before)?;
    if has_core {
        assert_foreign_artifact_bytes(core_path, core_before)?
    }
    let _ = compile_private_foreign_interface(world, directory, "MissingFunction")?;
    let output = foreign_package_cli_output(directory, subcommand)?;
    if !output.status().success() {
        return Result::Err(output.stderr().to_string_utf8().unwrap_or("package publication failed"))
    }
    testing::assert(fs::is_file(interface_path));
    testing::assert_eq(fs::is_file(core_path), has_core);
    Result::Ok(())
}

fn assert_foreign_package_publication(subcommand: string) -> () {
    let temporary = temp_go_path("ffi-package.goml", "publication-" + subcommand);
    let result = exercise_foreign_package_publication(
        path::parent(temporary).unwrap_or(""),
        subcommand,
    );
    cleanup_temp_directory(temporary);
    match result {
        Ok(()) => (),
        Err(message) => testing::fail(message),
    }
}

#[test]
fn foreign_package_publication_preserves_goml_errors_without_native_validation_check() -> () {
    assert_foreign_package_publication("check")
}

#[test]
fn foreign_package_publication_preserves_goml_errors_without_native_validation_build() -> () {
    assert_foreign_package_publication("build")
}

#[test]
fn foreign_package_publication_preserves_goml_errors_without_native_validation_test_check() -> () {
    assert_foreign_package_publication("test-check")
}

#[test]
fn foreign_package_publication_preserves_goml_errors_without_native_validation_test_build() -> () {
    assert_foreign_package_publication("test-build")
}

fn assert_foreign_artifact_bytes(file: string, before: bytes::Bytes) -> Result[(), string] {
    let after = fs::read_bytes_structured(file).map_err(|error| error.to_string())?;
    testing::assert_eq(after.len(), before.len());
    for index in 0..before.len() {
        testing::assert_eq(after.get(index), before.get(index))
    }
    Result::Ok(())
}
