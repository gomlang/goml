package main;

use module::artifact;
use module::hir;
use module::tast;
use std::path;

fn artifact_go_exports(source: hir::File, typed: tast::File, package_name: string) -> Result[
    Vec[artifact::ArtifactGoExport],
    string,
] {
    let exports: Vec[artifact::ArtifactGoExport] = Vec::new();
    for item in source.items {
        if let Function(declaration) = item {
            let Some(go_name) = tast::go_export_name(declaration.attrs) else {
                continue
            };
            let mut found = false;
            for typed_item in typed.items {
                if let tast::Item::Function(function) = typed_item {
                    if function.name == declaration.name {
                        exports.push(
                            artifact::ArtifactGoExport {
                                package_name,
                                symbol: function.name,
                                go_name,
                                ty: artifact_function_type(function.params, function.ret_ty),
                                source_file: path::file_name(function.source_path).unwrap_or(""),
                                start: declaration.name_span.start,
                                end: declaration.name_span.end,
                            },
                        );
                        found = true;
                    }
                }
            }
            if !found {
                return Result::Err("missing checked Go export function " + declaration.name)
            }
        }
    }
    Result::Ok(exports)
}

fn artifact_attach_go_exports(
    exports: artifact::ArtifactPackageExports,
    values: Vec[artifact::ArtifactGoExport],
) -> Result[(), string] {
    for value in values {
        let mut found = false;
        for index in 0..exports.functions.len() {
            let function = exports.functions[index];
            if function.name == value.symbol {
                exports.functions.set(
                    index,
                    artifact::ArtifactFnScheme {
                        name: function.name,
                        comptime: function.comptime,
                        type_params: function.type_params,
                        constraints: function.constraints,
                        ty: value.ty,
                        body: function.body,
                    },
                );
                found = true;
            }
        }
        if !found {
            return Result::Err("Go export is absent from package function API: " + value.symbol)
        }
        exports.go_exports.push(value)
    }
    Result::Ok(())
}
