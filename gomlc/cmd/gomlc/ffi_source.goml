package main;

use module::ast;
use module::ffi;
use module::parser;
use std::fs;
use std::text;

fn foreign_source_locations(
    package_name: string,
    paths: Vec[string],
    bindings: Vec[ffi::ForeignBinding],
) -> HashMap[string, string] {
    let locations: HashMap[string, string] = HashMap::new();
    if package_name == "" || bindings.is_empty() {
        return locations
    }
    let expected: HashMap[string, ffi::ForeignBinding] = HashMap::new();
    for binding in bindings {
        expected[binding.binding_id] = binding;
    }
    for path in paths {
        let Ok(source) = fs::read_file_structured(path) else {
            continue
        };
        let lowered = ast::lower(parser::parse(source));
        if !lowered.diagnostics.is_empty() {
            continue
        }
        let Some(file) = lowered.ast else {
            continue
        };
        for item in file.items {
            if let ExternFunction(declaration) = item {
                let id = package_name + ":" + package_name + "::" + declaration.name;
                let Some(binding) = expected[id] else {
                    continue
                };
                let label = text::StringBuilder::new();
                if binding.call_mode == ffi::ForeignCallMode::Method {
                    label.write_string("Go receiver method: " + binding.symbol)
                } else {
                    label.write_string("Go target: " + binding.import_path + "." + binding.symbol)
                }
                for index in 0..declaration.params.len() {
                    label.write_string(
                        "; arg" + index.to_string() + " = " + declaration.params[index].0,
                    )
                }
                for index in 0..binding.results.len() {
                    label.write_string(
                        "; result" + index.to_string() + " = GoML return " + (index + 1).to_string(),
                    )
                }
                let rendered = text::StringBuilder::new();
                render_diagnostic_label(
                    rendered,
                    "primary",
                    path,
                    declaration.name_span,
                    Option::Some(label.finish()),
                    path,
                    source,
                );
                locations[id] = rendered.finish();
            }
        }
    }
    locations
}
