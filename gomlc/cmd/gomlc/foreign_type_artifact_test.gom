package main;

use module::artifact;
use module::artifact::interface_codec as interface_codec;
use module::artifact::core_codec as core_codec;
use module::ffi;
use module::core;
use std::testing;

fn exercise_foreign_type_artifacts(metadata: ffi::ForeignTypeMetadata) -> Result[(), string] {
    let base = binary_interface_fixture();
    let interface = interface_codec::with_foreign_types(base, metadata)?;
    testing::assert(interface.interface_hash != base.interface_hash);
    let restored = interface_codec::decode_binary(interface_codec::encode_binary(interface)?)?;
    let restored_metadata = restored.foreign_types.ok_or("interface lost external type metadata")?;
    testing::assert_eq(
        ffi::encode_foreign_type_metadata(restored_metadata)?,
        ffi::encode_foreign_type_metadata(metadata)?,
    );
    let core_base = binary_core_fixture();
    core_base.core_ir.functions[0].generics.push("T");
    let mut declaration: Option[ffi::TypeDeclarationQuery] = Option::None;
    for query in metadata.queries {
        if ffi::resolve_go_type_template(metadata.declarations, query.type_id)?.parameter_constraints.len()
            == 1 {
            declaration = Option::Some(query);
        }
    }
    let declaration = declaration.ok_or("artifact fixture requires a generic Go declaration")?;
    let application = core::ExternalTypeApplication {
        function_name: core_base.core_ir.functions[0].name,
        declaration,
        arguments: Vec::from_array([core::Type::Param { name: "T" }]),
    };
    let core_unit = artifact::ArtifactCoreUnit {
        source_origins: Vec::new(),
        external_applications: Vec::from_array([application]),
        foreign_types: Option::Some(metadata),
        package_name: core_base.package_name,
        declared_name: core_base.declared_name,
        interface_hash: interface.interface_hash,
        exports: core_base.exports,
        core_ir: core_base.core_ir,
        deps: core_base.deps,
        sources: Vec::new(),
        tests: core_base.tests,
    };
    let restored_core = core_codec::decode_binary(core_codec::encode_binary(core_unit)?)?;
    testing::assert_eq(restored_core.external_applications.len(), 1);
    let restored_application = restored_core.external_applications[0];
    testing::assert_eq(restored_application.function_name, application.function_name);
    testing::assert_eq(restored_application.declaration.type_id, declaration.type_id);
    testing::assert(
        core::types_equal(restored_application.arguments[0], core::Type::Param { name: "T" }),
    );
    for invalid_application in Vec::from_array(
        [
            core::ExternalTypeApplication {
                function_name: "missing",
                declaration: application.declaration,
                arguments: application.arguments,
            },
            core::ExternalTypeApplication {
                function_name: application.function_name,
                declaration: application.declaration,
                arguments: Vec::from_array([core::Type::Param { name: "Unknown" }]),
            },
            core::ExternalTypeApplication {
                function_name: application.function_name,
                declaration: application.declaration,
                arguments: Vec::new(),
            },
            core::ExternalTypeApplication {
                function_name: application.function_name,
                declaration: ffi::TypeDeclarationQuery {
                    type_id: declaration.type_id,
                    import_path: "example.com/other",
                    name: declaration.name,
                },
                arguments: application.arguments,
            },
            core::ExternalTypeApplication {
                function_name: application.function_name,
                declaration: ffi::TypeDeclarationQuery {
                    type_id: "unknown",
                    import_path: "example.com/host/shim",
                    name: declaration.name,
                },
                arguments: application.arguments,
            },
        ],
    ) {
        core_unit.external_applications.set(0, invalid_application);
        testing::assert(core_codec::decode_binary(core_codec::encode_binary(core_unit)?).is_err())
    }
    core_unit.external_applications.set(0, application);
    let core_metadata = restored_core.foreign_types.ok_or("Core lost external type metadata")?;
    testing::assert_eq(
        ffi::encode_foreign_type_metadata(core_metadata)?,
        ffi::encode_foreign_type_metadata(metadata)?,
    );
    let invalid = ffi::ForeignTypeMetadata {
        instances: Vec::new(),
        queries: metadata.queries,
        declarations: ffi::TypeDeclarations {
            go_world_identity: metadata.declarations.go_world_identity,
            declarations: metadata.declarations.declarations,
            nodes: HashMap::new(),
        },
    };
    testing::assert(interface_codec::with_foreign_types(base, invalid).is_err());
    let invalid_core = artifact::ArtifactCoreUnit {
        source_origins: Vec::new(),
        external_applications: Vec::new(),
        foreign_types: Option::Some(invalid),
        package_name: core_base.package_name,
        declared_name: core_base.declared_name,
        interface_hash: interface.interface_hash,
        exports: core_base.exports,
        core_ir: core_base.core_ir,
        deps: core_base.deps,
        sources: Vec::new(),
        tests: core_base.tests,
    };
    testing::assert(core_codec::decode_binary(core_codec::encode_binary(invalid_core)?).is_err());
    Result::Ok(())
}
