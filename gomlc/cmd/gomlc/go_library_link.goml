package main;

use module::artifact;
use module::core;

struct LinkedGoLibrary {
    core_value: core::File,
    exports: Vec[artifact::ArtifactGoExport],
}

fn link_go_library_core(
    world: PackageWorld,
    inputs: Vec[artifact::ArtifactCoreUnit],
    selected: string,
) -> Result[LinkedGoLibrary, string] {
    let units = artifact_reachable_core_units(Vec::from_array([selected]), inputs)?;
    artifact_validate_link_core_units(world, units)?;
    let selected_unit = artifact_find_core_unit(units, selected).ok_or(
        "missing Go library package " + selected,
    )?;
    if selected_unit.declared_name == "main" || selected_unit.declared_name == "" {
        return Result::Err("Go library source package must not be main")
    }
    if selected_unit.exports.go_exports.is_empty() {
        return Result::Err("Go library package has no go_export declarations")
    }
    let roots: Vec[string] = Vec::new();
    for exported in selected_unit.exports.go_exports {
        if exported.package_name != selected {
            return Result::Err("Go export belongs to a different package")
        }
        let mut found = false;
        for function in selected_unit.core_ir.functions {
            if function.name == exported.symbol {
                let ty = artifact_function_type_parts(exported.ty)?;
                if !function.generics.is_empty() || function.params.len() != ty.params.len()
                    || !artifact_core_types_equal(function.ret_ty, ty.ret_ty) {
                    return Result::Err("Go export Core signature mismatch: " + exported.symbol)
                }
                for index in 0..ty.params.len() {
                    if !artifact_core_types_equal(function.params[index].1, ty.params[index]) {
                        return Result::Err("Go export Core parameter mismatch: " + exported.symbol)
                    }
                }
                found = true;
            }
        }
        if !found {
            return Result::Err("Go export Core function is missing: " + exported.symbol)
        }
        roots.push(exported.symbol)
    }
    artifact_prepare_core_units(world, units);
    let needs = artifact_core_standard_needs(units);
    let dependencies = Vec::from_array([world.prelude.core_value]);
    append_core_files(dependencies, selected_link_standard_core(world.standard, needs));
    for compilation in artifact_core_compilations(units)? {
        dependencies.push(compilation.core_value)
    }
    let linked = core::link_with_dependencies(world.builtins, dependencies, empty_core_file());
    let rooted = core::with_function_roots(linked, roots)?;
    Result::Ok(LinkedGoLibrary { core_value: rooted, exports: selected_unit.exports.go_exports })
}
