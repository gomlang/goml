package main;

use module::bind_go;
use module::ffi;
use std::env;
use std::fs;
use std::path;
use std::process;
use std::testing;
use std::utf8;
use utf8::BytesUtf8;

fn exercise_bind_go_generation(directory: string) -> Result[(), string] {
    ffi_driver_fixture(directory)?;
    let config = bind_go::parse_config(
        "{\"version\":1,\"package\":\"bindings\",\"output\":\"bindings/generated.gom\",\"go_package\":\"gen\",\"go_output\":\"gen/generated.go\",\"go_import_path\":\"example.com/host/gen\",\"functions\":[{\"name\":\"count\",\"import_path\":\"strings\",\"symbol\":\"Count\"},{\"name\":\"numeric\",\"import_path\":\"example.com/host/shim\",\"symbol\":\"MakeNumeric\",\"type_arguments\":[{\"tag\":\"int64\"}]}],\"types\":[{\"name\":\"Number\",\"import_path\":\"example.com/host/shim\",\"symbol\":\"Numeric\",\"type_arguments\":[{\"tag\":\"int64\"}]}]}",
    )?;
    let context = resolve_foreign_build_context("go", directory)?;
    let compiler = path::absolute_structured(
        env::var_structured("GOML_TEST_GOMLC").unwrap_or("../stage2/bin/gomlc"),
    ).map_err(|error| error.to_string())?;
    let driver = path::absolute_structured(
        env::var_structured("GOML_TEST_GOML").unwrap_or("../stage2/bin/goml"),
    ).map_err(|error| error.to_string())?;
    let helper = path::join(path::parent(compiler).unwrap_or(""), "goml-go-meta");
    let caller = ffi::CallerContext {
        generated_source: Option::None,
        load_mode: "package",
        import_path: "example.com/host/gen",
        directory: path::join(directory, "gen"),
        package_name: "gen",
    };
    let generated = generate_go_bindings(config, helper, context, caller, Option::None)?;
    let repeated = generate_go_bindings(config, helper, context, caller, Option::None)?;
    testing::assert_eq(generated.goml_source, repeated.goml_source);
    testing::assert_eq(generated.go_source, repeated.go_source);
    fs::create_dir_all(path::join(directory, "bindings")).map_err(|error| error.to_string())?;
    fs::write_file_structured(path::join(directory, config.output), generated.goml_source).map_err(
        |error| error.to_string(),
    )?;
    fs::write_file_structured(path::join(directory, config.go_output), generated.go_source).map_err(
        |error| error.to_string(),
    )?;
    fs::write_file_structured(
        path::join(directory, "goml.toml"),
        "[module]\npath = \"bind_fixture\"\n",
    ).map_err(|error| error.to_string())?;
    fs::write_file_structured(
        path::join(directory, "main.gom"),
        "package main; use module::bindings; fn main() -> () { let _ = bindings::numeric(42); }",
    ).map_err(|error| error.to_string())?;
    fs::write_file_structured(
        path::join(directory, "gen/generated_test.go"),
        "package gen\nimport \"testing\"\nfunc TestBindings(t *testing.T) { if GomlBind_count(\"banana\", \"a\") != 3 || GomlBind_numeric(42).Value != 42 { t.Fatal(\"generated forwarding failed\") } }\n",
    ).map_err(|error| error.to_string())?;
    let native = process::Command::new("go").args(Vec::from_array(["test", "./gen"])).current_dir(
        directory,
    ).env("GOWORK", "off").env("GOTOOLCHAIN", "local").env("GOPROXY", "off").output_structured().map_err(
        |error| error.to_string(),
    )?;
    if !native.status().success() {
        return Result::Err(native.stderr().to_string_utf8().unwrap_or("native test failed"))
    }
    let checked = process::Command::new(driver).args(
        Vec::from_array(["check", "--compiler", compiler, "--jobs", "1"]),
    ).current_dir(directory).output_structured().map_err(|error| error.to_string())?;
    if !checked.status().success() {
        return Result::Err(
            checked.stderr().to_string_utf8().unwrap_or("generated GoML check failed"),
        )
    }
    Result::Ok(())
}

#[test]
fn bind_go_generated_sources_pass_native_tests_and_goml_check() -> () {
    let temporary = temp_go_path("bindings.gom", "binding-generation");
    let result = exercise_bind_go_generation(path::parent(temporary).unwrap_or(""));
    cleanup_temp_directory(temporary);
    if let Err(error) = result {
        testing::fail(error);
    }
}
