package main;

use module::ast;
use module::parser;
use std::testing;

fn parsed_source_declares_go_foreign(source: string) -> bool {
    if !source.contains("go_ffi") && !source.contains("go_type") {
        return false
    }
    if let Some(file) = ast::lower(parser::parse(source)).ast {
        for item in file.items {
            match item {
                ExternType(_) => return true,
                ExternFunction(value) => for attribute in value.attrs {
                    if attribute.name == "go_ffi" {
                        return true
                    }
                },
                _ => (),
            }
        }
    }
    false
}

#[test]
fn package_information_keyword_scan_preserves_parser_results() -> () {
    let declaration = "#[go_ffi(\"math\", \"Abs\")] pub extern fn abs(x: f64) -> f64;";
    let sources = Vec::from_array(
        [
            "",
            "// go_ffi extern fn ignored();\n",
            "fn value() -> string { \"go_type extern\" }",
            "fn value() -> string { r#\"go_type extern \"quoted\"\"# }",
            "fn value() -> string { f\"go_type {\"extern\"}\" }",
            "fn value() -> string {\n    \\\\go_ffi extern fn ignored();\n}",
            "fn value() -> Bytes { br#\"go_ffi extern\"# }",
            "fn value() -> Bytes { b\"go_type extern\" }",
            "fn go_type_external() -> () {}",
            "#[go_type(\"time\", \"Duration\")] extern type Duration;",
            "extern type MissingAttribute;",
            "#[go_ffi(\"math\", \"Abs\")] fn abs(x: f64) -> f64 { x }",
            "#[go_ffi(\"math\", \"Abs\")] extern fn broken(",
            "/* go_ffi extern fn invalid_comment(); */",
            "fn broken() -> string { \"go_ffi",
        ],
    );
    for source in sources {
        testing::assert_eq(
            source_declares_go_foreign(source),
            parsed_source_declares_go_foreign(source),
        );
        let combined = source + "\n" + declaration;
        testing::assert_eq(
            source_declares_go_foreign(combined),
            parsed_source_declares_go_foreign(combined),
        )
    }
    testing::assert(source_declares_go_foreign(declaration))
}
