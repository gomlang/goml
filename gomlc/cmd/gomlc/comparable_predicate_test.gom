package main;

use module::artifact::interface_codec;
use module::artifact::tast_codec;
use module::artifact::wire;
use module::artifact::core_codec;
use module::core;
use module::tast;
use std::testing;

#[test]
fn go_comparable_predicates_round_trip_interface_and_core_artifacts() -> () {
    let unit = source_interface("package value; pub fn accept[T](value: T) -> () {}");
    unit.exports.functions[0].constraints.push(
        tast::TypePredicate::GoComparable(tast::Type::Param { name: "T" }),
    );
    let unit = interface_codec::new_unit(
        unit.package_name,
        unit.exports,
        unit.package_interface,
        unit.deps,
    );
    let encoded = interface_codec::encode_binary(unit);
    match encoded {
        Ok(encoded) => match interface_codec::decode_binary(encoded) {
            Ok(decoded) => testing::assert_eq(
                interface_codec::encode_json(decoded, false),
                interface_codec::encode_json(unit, false),
            ),
            Err(error) => testing::fail(error),
        },
        Err(error) => testing::fail(error),
    }
    let core_unit = binary_core_fixture();
    core_unit.core_ir.functions[0].generics.push("T");
    core_unit.core_ir.functions[0].predicates.push(
        core::TypePredicate::GoComparable(core::Type::Param { name: "T" }),
    );
    match core_codec::encode_binary(core_unit) {
        Ok(encoded) => match core_codec::decode_binary(encoded) {
            Ok(decoded) => testing::assert_eq(
                core_codec::encode_json(decoded, false),
                core_codec::encode_json(core_unit, false),
            ),
            Err(error) => testing::fail(error),
        },
        Err(error) => testing::fail(error),
    }
}

#[test]
fn go_comparable_predicates_reject_malformed_artifact_payloads() -> () {
    for payload in Vec::from_array(
        [
            wire::ArtifactValue::Null,
            wire::ArtifactValue::Number("0"),
            wire::ArtifactValue::Object(Vec::new()),
        ],
    ) {
        let value = wire::ArtifactValue::Object(Vec::from_array([("GoComparable", payload)]));
        testing::assert(
            tast_codec::artifact_decode_predicate(tast_codec::new_artifact_decode_context(), value).is_err(),
        );
    }
}
