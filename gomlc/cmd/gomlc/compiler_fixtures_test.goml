package main;

use module::compiler::{PackageWorld, read_package_world, package_world, empty_core_file};
use module::artifact;
use module::artifact::interface_codec as interface_codec;
use module::core;
use std::env;
use std::testing;

fn test_package_world() -> PackageWorld {
    match env::var_structured("GOML_TEST_COMPILER_WORLD") {
        Ok(path) => match read_package_world(path) {
            Ok(value) => value,
            Err(error) => {
                testing::fail(error.to_string());
                package_world()
            },
        },
        Err(_) => package_world(),
    }
}

fn binary_core_fixture() -> artifact::ArtifactCoreUnit {
    let core_ir = empty_core_file();
    core_ir.functions.push(
        core::Function {
            name: "audit::value::choose",
            origin: core::FunctionOrigin::Source,
            root: true,
            generics: Vec::new(),
            predicates: Vec::new(),
            trait_impl: Option::None,
            params: Vec::new(),
            ret_ty: core::Type::Int,
            body: core::Block {
                stmts: Vec::new(),
                tail: Option::Some(
                    Loop {
                        body: core::Expr::Break {
                            target: 0,
                            value: Option::Some(
                                Prim {
                                    value: core::Primitive::Int { value: "7" },
                                    ty: core::Type::Int,
                                },
                            ),
                            ty: core::Type::Never,
                        },
                        ty: core::Type::Int,
                    },
                ),
            },
        },
    );
    artifact::ArtifactCoreUnit {
        source_origins: Vec::new(),
        package_name: "audit::value",
        declared_name: "value",
        interface_hash: "0123456789abcdef",
        exports: interface_codec::empty_exports(),
        core_ir,
        deps: Vec::from_array([("builtin", "fedcba9876543210")]),
        sources: Vec::from_array(["value.goml"]),
        tests: Vec::new(),
    }
}
