package main;

use module::ffi;
use module::artifact;
use module::artifact::interface_codec as interface_codec;
use module::artifact::core_codec as core_codec;
use module::tast;
use std::fs;
use std::path;
use std::testing;

fn ffi_driver_fixture(directory: string) -> Result[(), string] {
    fs::create_dir_all(path::join(directory, "gen")).map_err(|error| error.to_string())?;
    fs::create_dir_all(path::join(directory, "shim")).map_err(|error| error.to_string())?;
    fs::write_file_structured(
        path::join(directory, "go.mod"),
        "module example.com/host\n\ngo 1.26.0\n",
    ).map_err(|error| error.to_string())?;
    fs::write_file_structured(
        path::join(directory, "shim/shim.go"),
        "package shim\nimport \"time\"\nfunc Value(x int64) int64 { return x }\ntype Delay = time.Duration\ntype Box[T any] struct { Value T; Next *Box[T] }\ntype Pair[A, B any] struct { First A; Second B }\ntype Reverse[A, B any] = Pair[B, *A]\nfunc Duration() time.Duration { return 1 }\nfunc EchoDuration(v time.Duration) time.Duration { return v }\nfunc MakeBox[T any](v T) Box[T] { return Box[T]{Value: v} }\nfunc EchoBox[T any](v Box[T]) Box[T] { return v }\ntype Numeric[T ~int64] struct { Value T }\nfunc MakeNumeric[T ~int64](v T) Numeric[T] { return Numeric[T]{Value: v} }\n",
    ).map_err(|error| error.to_string())
}

fn ffi_driver_bindings() -> Result[Vec[ffi::ForeignBinding], string] {
    let exports = interface_codec::empty_exports();
    exports.functions.push(
        artifact::ArtifactFnScheme {
            name: "demo::calc::private_unused",
            comptime: tast::ComptimeCapability::RuntimeOnly,
            type_params: Vec::new(),
            constraints: Vec::new(),
            ty: tast::Type::Func {
                params: Vec::from_array([tast::Type::Int64]),
                ret_ty: tast::Type::Int64,
            },
            body: tast::Callable::GoForeign {
                binding: "",
                import_path: "example.com/host/shim",
                symbol: "Value",
            },
        },
    );
    let unit = artifact::ArtifactCoreUnit {
        source_origins: Vec::new(),
        external_applications: Vec::new(),
        foreign_types: Option::None,
        package_name: "demo::calc",
        declared_name: "calc",
        interface_hash: "test",
        exports,
        core_ir: empty_core_file(),
        deps: Vec::new(),
        sources: Vec::from_array(["calc.goml"]),
        tests: Vec::new(),
    };
    let restored = core_codec::decode_binary(core_codec::encode_binary(unit)?)?;
    let before = foreign_artifact_bindings("demo::calc", exports, Vec::new())?;
    let after = foreign_artifact_bindings(restored.package_name, restored.exports, Vec::new())?;
    testing::assert_eq(before.len(), 1);
    testing::assert_eq(after.len(), 1);
    testing::assert_eq(before[0].binding_id, after[0].binding_id);
    testing::assert_eq(before[0].import_path, after[0].import_path);
    testing::assert_eq(before[0].symbol, after[0].symbol);
    Result::Ok(after)
}

#[test]
fn foreign_driver_preserves_private_artifact_bindings() -> () {
    if let Err(error) = ffi_driver_bindings() {
        testing::fail(error)
    }
}

#[test]
fn foreign_options_accept_compatibility_modes_without_native_context() -> () {
    for mode in Vec::from_array(["required", "off"]) {
        let values: HashMap[string, string] = HashMap::new();
        values["--ffi-check"] = mode;
        values["--context"] = "/missing/goml-test-context.json";
        values["--caller-directory"] = "/missing/goml-test-caller";
        let command = foreign_validation_command(values);
        match command {
            Ok(command) => {
                testing::assert_eq(command.context_path, "/missing/goml-test-context.json");
                testing::assert_eq(command.caller.directory, "/missing/goml-test-caller");
                match command.mode {
                    Required => testing::assert_eq(mode, "required"),
                    Off => testing::assert_eq(mode, "off"),
                }
            },
            Err(error) => testing::fail(error),
        }
    }
}
