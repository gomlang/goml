package main;

use module::artifact;
use module::ffi;
use module::tast;
use std::json;

fn go_library_api_type(ty: tast::Type) -> Result[json::Value, string] {
    Result::Ok(ffi::bridge_type_json(tast::foreign_bridge_type(ty, Vec::new(), true)?))
}

fn go_library_api(exports: Vec[artifact::ArtifactGoExport]) -> Result[json::Value, string] {
    let names: Vec[string] = Vec::new();
    for exported in exports {
        names.push(exported.go_name)
    }
    let entries: Vec[json::Value] = Vec::new();
    for name in sorted_unique_package_inputs(names) {
        for exported in exports {
            if exported.go_name != name {
                continue
            }
            let ty = artifact_function_type_parts(exported.ty)?;
            let parameters: Vec[json::Value] = Vec::new();
            let results: Vec[json::Value] = Vec::new();
            for param in ty.params {
                parameters.push(go_library_api_type(param)?)
            }
            match ty.ret_ty {
                tast::Type::Unit => (),
                tast::Type::Tuple { items } => {
                    for item in items {
                        results.push(go_library_api_type(item)?)
                    }
                },
                _ => results.push(go_library_api_type(ty.ret_ty)?),
            }
            entries.push(
                json::object(
                    Vec::from_array(
                        [
                            ("name", json::Value::String(exported.go_name)),
                            ("symbol", json::Value::String(exported.symbol)),
                            ("parameters", json::Value::Array(parameters)),
                            ("results", json::Value::Array(results)),
                        ],
                    ),
                ),
            )
        }
    }
    Result::Ok(
        json::object(
            Vec::from_array(
                [("protocol", json::Value::Number("1")), ("exports", json::Value::Array(entries))],
            ),
        ),
    )
}
