package main;

use module::artifact::tast_codec as tast_codec;
use module::artifact::wire as wire;
use module::artifact;
use module::ast;
use module::hir;
use module::tast;

struct ArtifactFunctionType {
    params: Vec[tast::Type],
    ret_ty: tast::Type,
}

fn artifact_function_type_parts(value: tast::Type) -> Result[ArtifactFunctionType, string] {
    match tast::resolve_type(value) {
        Func { params, ret_ty } => Result::Ok(ArtifactFunctionType { params, ret_ty }),
        _ => Result::Err(wire::artifact_decode_error("function type in package exports")),
    }
}

fn artifact_dependency_trait_ref(value: tast::TraitRef) -> tast::TraitRef {
    let args: Vec[tast::Type] = Vec::new();
    for arg in value.args {
        args.push(artifact_dependency_trait_type(arg))
    }
    tast::TraitRef { name: value.name, args }
}

fn artifact_dependency_optional_trait_ref(value: Option[tast::TraitRef]) -> Option[tast::TraitRef] {
    value.map(|value| artifact_dependency_trait_ref(value))
}

fn artifact_dependency_trait_type(value: tast::Type) -> tast::Type {
    match tast::resolve_type(value) {
        Con { name } => if name == "Self" {
            tast::Type::Param { name }
        } else {
            tast::Type::Con { name }
        },
        External { import_path, name, args } => {
            let result: Vec[tast::Type] = Vec::new();
            for arg in args {
                result.push(artifact_dependency_trait_type(arg))
            }
            tast::Type::External { import_path, name, args: result }
        },
        Tuple { items: values } => {
            let result: Vec[tast::Type] = Vec::new();
            for value in values {
                result.push(artifact_dependency_trait_type(value))
            }
            tast::Type::Tuple { items: result }
        },
        Projection { for_ty, name, trait_ref } => tast::Type::Projection {
            for_ty: artifact_dependency_trait_type(for_ty),
            name,
            trait_ref: artifact_dependency_optional_trait_ref(trait_ref),
        },
        App { ty: base, args } => {
            let result: Vec[tast::Type] = Vec::new();
            for arg in args {
                result.push(artifact_dependency_trait_type(arg))
            }
            tast::Type::App { ty: artifact_dependency_trait_type(base), args: result }
        },
        Array { len: length, elem: element } => tast::Type::Array {
            len: length,
            elem: artifact_dependency_trait_type(element),
        },
        Slice { elem: element } => tast::Type::Slice {
            elem: artifact_dependency_trait_type(element),
        },
        MutSlice { elem: element } => tast::Type::MutSlice {
            elem: artifact_dependency_trait_type(element),
        },
        VecType { elem: element } => tast::Type::VecType {
            elem: artifact_dependency_trait_type(element),
        },
        GoPointer { elem: element } => tast::Type::GoPointer {
            elem: artifact_dependency_trait_type(element),
        },
        GoFunction { signature: element } => tast::Type::GoFunction {
            signature: artifact_dependency_trait_type(element),
        },
        RefType { elem: element } => tast::Type::RefType {
            elem: artifact_dependency_trait_type(element),
        },
        Channel { elem: element, direction } => tast::Type::Channel {
            elem: artifact_dependency_trait_type(element),
            direction,
        },
        HashMap { key, value } => tast::Type::HashMap {
            key: artifact_dependency_trait_type(key),
            value: artifact_dependency_trait_type(value),
        },
        GoMap { key, value } => tast::Type::GoMap {
            key: artifact_dependency_trait_type(key),
            value: artifact_dependency_trait_type(value),
        },
        Func { params, ret_ty } => {
            let result: Vec[tast::Type] = Vec::new();
            for param in params {
                result.push(artifact_dependency_trait_type(param))
            }
            tast::Type::Func { params: result, ret_ty: artifact_dependency_trait_type(ret_ty) }
        },
        other => other,
    }
}

fn artifact_dependency_trait_predicate(value: tast::TypePredicate) -> tast::TypePredicate {
    match value {
        GoComparable(ty) => tast::TypePredicate::GoComparable(artifact_dependency_trait_type(ty)),
        Trait { for_ty, trait_ref } => tast::TypePredicate::Trait {
            for_ty: artifact_dependency_trait_type(for_ty),
            trait_ref: artifact_dependency_trait_ref(trait_ref),
        },
        Equality { lhs: left, rhs: right } => tast::TypePredicate::Equality {
            lhs: artifact_dependency_trait_type(left),
            rhs: artifact_dependency_trait_type(right),
        },
    }
}

fn artifact_dependency_trait_predicates(values: Vec[tast::TypePredicate]) -> Vec[
    tast::TypePredicate,
] {
    let result: Vec[tast::TypePredicate] = Vec::new();
    for value in values {
        result.push(artifact_dependency_trait_predicate(value))
    }
    result
}

fn artifact_dependency_function_scheme(
    value: artifact::ArtifactFnScheme,
    inherited_type_params: Vec[string],
    inherited: Vec[tast::TypePredicate],
    callable: tast::Callable,
) -> Result[tast::FunctionScheme, string] {
    let function_type = artifact_function_type_parts(value.ty)?;
    let predicates: Vec[tast::TypePredicate] = Vec::new();
    for predicate in inherited {
        predicates.push(predicate)
    }
    for predicate in value.constraints {
        predicates.push(predicate)
    }
    let generics: Vec[string] = Vec::new();
    for type_param in inherited_type_params {
        generics.push(type_param)
    }
    for type_param in value.type_params {
        generics.push(type_param)
    }
    Result::Ok(
        tast::FunctionScheme {
            def_id: Option::None,
            name: value.name,
            comptime: value.comptime,
            generics,
            predicates,
            params: function_type.params,
            ret_ty: function_type.ret_ty,
            callable,
        },
    )
}

fn artifact_dependency_trait(value: artifact::ArtifactTraitDef) -> Result[tast::TraitInfo, string] {
    let associated_types: Vec[tast::AssociatedTypeInfo] = Vec::new();
    for associated in value.associated_types {
        let bounds: Vec[tast::TraitRef] = Vec::new();
        for bound in associated.bounds {
            bounds.push(artifact_dependency_trait_ref(bound))
        }
        associated_types.push(tast::AssociatedTypeInfo { name: associated.name, bounds })
    }
    let methods: Vec[tast::TraitMethodInfo] = Vec::new();
    for method in value.methods {
        let default_map_requirements = Vec::new();
        for entry in value.default_map_requirements {
            if entry.0 == method.name {
                for key in entry.1 {
                    default_map_requirements.push(artifact_dependency_trait_type(key))
                }
            }
        }
        let function_type = artifact_function_type_parts(artifact_dependency_trait_type(method.ty))?;
        methods.push(
            tast::TraitMethodInfo {
                default_map_requirements,
                name: method.name,
                has_receiver: !function_type.params.is_empty()
                    && match tast::resolve_type(function_type.params[0]) {
                        tast::Type::Param { name } => name == "Self",
                        _ => false,
                    },
                generics: method.type_params,
                predicates: artifact_dependency_trait_predicates(method.constraints),
                params: function_type.params,
                ret_ty: function_type.ret_ty,
                default_name: match method.body {
                    tast::Callable::Function(name) => if name == method.name {
                        Option::None
                    } else {
                        Option::Some(name)
                    },
                    _ => Option::None,
                },
            },
        )
    }
    let supertraits: Vec[tast::TraitRef] = Vec::new();
    for supertrait in value.supertraits {
        supertraits.push(artifact_dependency_trait_ref(supertrait))
    }
    Result::Ok(
        tast::TraitInfo {
            name: value.name,
            generics: value.params,
            predicates: artifact_dependency_trait_predicates(value.predicates),
            supertraits,
            associated_types,
            methods,
        },
    )
}

fn artifact_dependency_enum(value: tast::EnumDef) -> tast::EnumInfo {
    let variants: Vec[tast::EnumVariantInfo] = Vec::new();
    for variant in value.variants {
        variants.push(tast::EnumVariantInfo { name: variant.name, fields: variant.fields })
    }
    tast::EnumInfo {
        map_requirements: value.map_requirements,
        def_id: hir::DefId { pkg: -1, index: -1 },
        name: value.name,
        generics: value.generics,
        variants,
    }
}

fn artifact_dependency_struct(value: tast::StructDef) -> tast::StructInfo {
    tast::StructInfo {
        map_requirements: value.map_requirements,
        def_id: hir::DefId { pkg: -1, index: -1 },
        name: value.name,
        generics: value.generics,
        fields: value.fields,
        public_fields: value.public_fields,
        has_hidden_fields: value.has_hidden_fields,
        go_comparable: value.go_comparable,
    }
}

fn artifact_dependency_inherent_for_type(
    builtin: tast::BuiltinContract,
    value: artifact::ArtifactInherentImpl,
) -> tast::Type {
    match value.key {
        Exact(value) => value,
        Constr(name) => {
            let generics: Vec[tast::Type] = Vec::new();
            for generic in value.definition.params {
                generics.push(tast::Type::Param { name: generic })
            }
            tast::nominal_type(builtin, name, generics)
        },
    }
}

fn artifact_dependency_environment_from_exports(value: artifact::ArtifactPackageExports) -> Result[
    tast::DependencyEnvironment,
    string,
] {
    let builtin = tast::builtin_contract()?;
    let enums: Vec[tast::EnumInfo] = Vec::new();
    for definition in value.enums {
        enums.push(artifact_dependency_enum(definition))
    }
    let structs: Vec[tast::StructInfo] = Vec::new();
    for definition in value.structs {
        structs.push(artifact_dependency_struct(definition))
    }
    let traits: Vec[tast::TraitInfo] = Vec::new();
    for definition in value.traits {
        traits.push(artifact_dependency_trait(definition)?)
    }
    let functions: Vec[tast::FunctionScheme] = Vec::new();
    for function in value.functions {
        let callable = function.body;
        functions.push(
            artifact_dependency_function_scheme(function, Vec::new(), Vec::new(), callable)?,
        )
    }
    let constants: Vec[tast::ConstantScheme] = Vec::new();
    for value in value.constants {
        constants.push(
            tast::ConstantScheme {
                def_id: Option::None,
                name: value.name,
                ty: value.ty,
                value: Option::None,
            },
        )
    }
    let methods: Vec[tast::MethodInfo] = Vec::new();
    let impls: Vec[tast::ImplInfo] = Vec::new();
    for implementation in value.trait_impls {
        if implementation.definition.valid {
            impls.push(
                tast::ImplInfo {
                    generics: implementation.definition.params,
                    predicates: implementation.definition.constraints,
                    trait_ref: implementation.trait_ref,
                    for_type: implementation.for_ty,
                    associated_types: implementation.definition.associated_types,
                    origin: "",
                    span: ast::span(0, 0),
                },
            );
            for method in implementation.definition.methods {
                let method_type = artifact_function_type_parts(
                    artifact_dependency_trait_type(method.ty),
                )?;
                let callable = match method.body {
                    tast::Callable::Function(name) => if name == method.name {
                        tast::Callable::TraitMethod {
                            trait_ref: implementation.trait_ref,
                            method_name: method.name,
                            for_ty: implementation.for_ty,
                            has_receiver: !method_type.params.is_empty()
                                && tast::types_equal(method_type.params[0], implementation.for_ty),
                        }
                    } else {
                        tast::Callable::Function(name)
                    },
                    other => other,
                };
                let function = artifact_dependency_function_scheme(
                    method,
                    implementation.definition.params,
                    implementation.definition.constraints,
                    callable,
                )?;
                methods.push(
                    tast::MethodInfo {
                        owner_generics: implementation.definition.params,
                        method_generics: method.type_params,
                        owner_predicate_count: implementation.definition.constraints.len(),
                        trait_ref: Option::Some(implementation.trait_ref),
                        for_type: implementation.for_ty,
                        function,
                    },
                )
            }
        }
    }
    for implementation in value.inherent_impls {
        if implementation.definition.valid {
            let for_type = artifact_dependency_inherent_for_type(builtin, implementation);
            for method in implementation.definition.methods {
                let callable = tast::Callable::InherentMethod {
                    receiver_ty: for_type,
                    method_name: method.name,
                };
                let function = artifact_dependency_function_scheme(
                    method,
                    implementation.definition.params,
                    implementation.definition.constraints,
                    callable,
                )?;
                methods.push(
                    tast::MethodInfo {
                        owner_generics: implementation.definition.params,
                        method_generics: method.type_params,
                        owner_predicate_count: implementation.definition.constraints.len(),
                        trait_ref: Option::None,
                        for_type,
                        function,
                    },
                )
            }
        }
    }
    Result::Ok(
        tast::dependency_environment(
            value.reexports,
            enums,
            structs,
            value.type_aliases,
            constants,
            traits,
            functions,
            methods,
            impls,
        ),
    )
}
