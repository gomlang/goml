package main;

use module::artifact::core_codec as core_codec;
use module::artifact::interface_codec as interface_codec;
use module::artifact::wire as wire;
use module::artifact;
use module::core;
use module::resources;
use module::version;
use std::bytes;
use std::fs;

const WORLD_ARTIFACT_FORMAT: isize = 20;

const WORLD_COMPILER_ABI: isize = 5;

struct WorldMetadata {
    counter: isize,
    package_count: isize,
    artifact_format: isize,
    compiler_abi: isize,
    compiler_identity: string,
    source_digest: string,
    builtin_package: string,
    prelude_package: string,
}

fn world_encode_metadata_v2(value: WorldMetadata) -> bytes::Bytes {
    let writer = wire::new_artifact_binary_writer();
    wire::artifact_binary_write_u64(writer, value.counter.to_u64());
    wire::artifact_binary_write_u64(writer, value.package_count.to_u64());
    wire::artifact_binary_write_u64(writer, value.artifact_format.to_u64());
    wire::artifact_binary_write_u64(writer, value.compiler_abi.to_u64());
    wire::artifact_binary_write_string(writer, value.compiler_identity);
    wire::artifact_binary_write_string(writer, value.source_digest);
    wire::artifact_binary_write_string(writer, value.builtin_package);
    wire::artifact_binary_write_string(writer, value.prelude_package);
    wire::artifact_binary_writer_finish(writer)
}

fn world_metadata_v2(value: PackageWorld, package_count: isize) -> bytes::Bytes {
    world_encode_metadata_v2(
        WorldMetadata {
            counter: value.counter.get(),
            package_count,
            artifact_format: WORLD_ARTIFACT_FORMAT,
            compiler_abi: WORLD_COMPILER_ABI,
            compiler_identity: version::current(),
            source_digest: value.source_digest,
            builtin_package: "builtin",
            prelude_package: "prelude",
        },
    )
}

fn world_decode_supported_int(value: u64, name: string) -> Result[isize, string] {
    if value > 2147483647 {
        Result::Err("world artifact " + name + " exceeds supported size")
    } else {
        Result::Ok(value.to_isize())
    }
}

fn world_decode_metadata_v2(data: bytes::Bytes) -> Result[WorldMetadata, string] {
    let reader = wire::new_artifact_binary_reader(data);
    let counter = world_decode_supported_int(wire::artifact_binary_read_u64(reader)?, "counter")?;
    let package_count = world_decode_supported_int(
        wire::artifact_binary_read_u64(reader)?,
        "package count",
    )?;
    let artifact_format = world_decode_supported_int(
        wire::artifact_binary_read_u64(reader)?,
        "artifact format",
    )?;
    let compiler_abi = world_decode_supported_int(
        wire::artifact_binary_read_u64(reader)?,
        "compiler ABI",
    )?;
    let compiler_identity = wire::artifact_binary_read_string(reader)?;
    let source_digest = wire::artifact_binary_read_string(reader)?;
    let builtin_package = wire::artifact_binary_read_string(reader)?;
    let prelude_package = wire::artifact_binary_read_string(reader)?;
    if package_count < 2 {
        Result::Err("world artifact must contain builtin and prelude packages")
    } else if package_count > 511 {
        Result::Err("world artifact contains too many packages")
    } else if wire::artifact_binary_reader_remaining(reader) != 0 {
        Result::Err("world artifact metadata has trailing data")
    } else {
        Result::Ok(
            WorldMetadata {
                counter,
                package_count,
                artifact_format,
                compiler_abi,
                compiler_identity,
                source_digest,
                builtin_package,
                prelude_package,
            },
        )
    }
}

fn world_core_unit(
    package_name: string,
    declared_name: string,
    interface: artifact::ArtifactInterfaceUnit,
    exports: artifact::ArtifactPackageExports,
    value: core::File,
) -> artifact::ArtifactCoreUnit {
    artifact::ArtifactCoreUnit {
        source_origins: Vec::new(),
        external_applications: Vec::new(),
        foreign_types: interface.foreign_types,
        package_name,
        declared_name,
        interface_hash: interface.interface_hash,
        exports,
        core_ir: value,
        deps: interface.deps,
        sources: Vec::new(),
        tests: Vec::new(),
    }
}

fn world_add_package_sections(
    sections: Vec[wire::ArtifactBinarySection],
    section_id: u16,
    value: ToolchainPackage,
) -> Result[(), string] {
    let interface = interface_codec::encode_binary(value.interface_unit)?;
    let core = core_codec::encode_binary(
        world_core_unit(
            value.interface_unit.package_name,
            value.interface_unit.package_interface.name,
            value.interface_unit,
            value.environment_exports,
            value.core_value,
        ),
    )?;
    sections.push(
        wire::ArtifactBinarySection {
            id: section_id,
            version: 1,
            flags: wire::required_section_flag(),
            data: interface,
        },
    );
    sections.push(
        wire::ArtifactBinarySection {
            id: section_id + 1,
            version: 1,
            flags: wire::required_section_flag(),
            data: core,
        },
    );
    Result::Ok(())
}

fn world_builtin_package(value: PackageWorld) -> ToolchainPackage {
    ToolchainPackage {
        core_value: value.builtins,
        interface_unit: value.builtin_interface,
        environment_exports: value.builtin_interface.exports,
    }
}

fn world_all_packages(value: PackageWorld) -> Vec[ToolchainPackage] {
    let result = Vec::from_array([world_builtin_package(value), value.prelude]);
    for package_value in value.standard {
        result.push(package_value)
    }
    result
}

fn world_find_package(values: Vec[ToolchainPackage], package_name: string) -> Option[
    ToolchainPackage,
] {
    for value in values {
        if value.interface_unit.package_name == package_name {
            return Option::Some(value)
        }
    }
    Option::None
}

fn world_required_package(values: Vec[ToolchainPackage], package_name: string) -> Result[
    ToolchainPackage,
    string,
] {
    world_find_package(values, package_name).ok_or(
        "world artifact is missing package " + package_name,
    )
}

fn world_sorted_packages(values: Vec[ToolchainPackage]) -> Result[Vec[ToolchainPackage], string] {
    let names: Vec[string] = Vec::new();
    for value in values {
        names.push(value.interface_unit.package_name)
    }
    let names = wire::sort_artifact_names(names);
    let result: Vec[ToolchainPackage] = Vec::new();
    let mut previous: Option[string] = Option::None;
    for name in names {
        if let Some(value) = previous {
            if value == name {
                return Result::Err("world artifact contains duplicate package " + name)
            }
        }
        result.push(world_required_package(values, name)?);
        previous = Option::Some(name);
    }
    Result::Ok(result)
}

fn encode_package_world(value: PackageWorld) -> Result[bytes::Bytes, string] {
    let packages = world_sorted_packages(world_all_packages(value))?;
    let sections: Vec[wire::ArtifactBinarySection] = Vec::from_array(
        [
            wire::ArtifactBinarySection {
                id: 1,
                version: 2,
                flags: wire::required_section_flag(),
                data: world_metadata_v2(value, packages.len()),
            },
        ],
    );
    for index in 0..packages.len() {
        world_add_package_sections(sections, (2 + index * 2).to_u16(), packages[index])?
    }
    wire::encode_artifact_binary_container(3, sections)
}

fn world_required_section_version(value: wire::ArtifactBinaryContainer, id: u16, version: u16) -> Result[
    wire::ArtifactBinarySection,
    string,
] {
    match wire::artifact_binary_find_section(value, id) {
        Some(section) => if section.version != version
            || section.flags != wire::required_section_flag() {
            Result::Err("invalid world artifact section")
        } else {
            Result::Ok(section)
        },
        None => Result::Err("world artifact is missing a required section"),
    }
}

fn world_required_section(value: wire::ArtifactBinaryContainer, id: u16) -> Result[
    wire::ArtifactBinarySection,
    string,
] {
    world_required_section_version(value, id, 1.to_u16())
}

fn world_dependencies_equal(left: Vec[(string, string)], right: Vec[(string, string)]) -> bool {
    if left.len() != right.len() {
        false
    } else {
        for index in 0..left.len() {
            if left[index] != right[index] {
                return false
            }
        }
        true
    }
}

fn world_decode_package_any(value: wire::ArtifactBinaryContainer, section_id: u16) -> Result[
    ToolchainPackage,
    string,
] {
    let interface_section = world_required_section(value, section_id)?;
    let core_section = world_required_section(value, section_id + 1)?;
    let interface = interface_codec::decode_binary(interface_section.data)?;
    let core = core_codec::decode_binary(core_section.data)?;
    if core.package_name != interface.package_name
        || core.interface_hash != interface.interface_hash
        || !world_dependencies_equal(core.deps, interface.deps) {
        Result::Err("world artifact package identity does not match")
    } else {
        Result::Ok(
            ToolchainPackage {
                core_value: core.core_ir,
                interface_unit: interface,
                environment_exports: core.exports,
            },
        )
    }
}

fn world_validate_standard_dependencies(
    value: Vec[ToolchainPackage],
    builtin_hash: string,
    prelude_hash: string,
) -> Result[(), string] {
    for package_value in value {
        if !artifact_interface_has_dependency(package_value.interface_unit, "builtin", builtin_hash) {
            return Result::Err("world artifact standard package builtin dependency does not match")
        } else if !artifact_interface_has_dependency(
            package_value.interface_unit,
            "prelude",
            prelude_hash,
        ) {
            return Result::Err("world artifact standard package prelude dependency does not match")
        }
    }
    Result::Ok(())
}

fn world_validate_standard_packages(value: Vec[ToolchainPackage]) -> Result[(), string] {
    for spec in resources::standard_package_specs() {
        world_required_package(value, spec.name)?;
    }
    if value.len() != resources::standard_package_specs().len() {
        Result::Err("world artifact standard package set does not match")
    } else {
        Result::Ok(())
    }
}

fn world_from_packages(metadata: WorldMetadata, packages: Vec[ToolchainPackage]) -> Result[
    PackageWorld,
    string,
] {
    if metadata.artifact_format != WORLD_ARTIFACT_FORMAT {
        return Result::Err("world artifact format does not match compiler")
    } else if metadata.compiler_abi != WORLD_COMPILER_ABI {
        return Result::Err("world compiler ABI does not match compiler")
    } else if metadata.compiler_identity != version::current() {
        return Result::Err("world compiler identity does not match compiler")
    } else if metadata.builtin_package != "builtin" || metadata.prelude_package != "prelude" {
        return Result::Err("world builtin or prelude package identity does not match")
    }
    let builtin = world_required_package(packages, metadata.builtin_package)?;
    let prelude = world_required_package(packages, metadata.prelude_package)?;
    if !artifact_interface_has_dependency(
        prelude.interface_unit,
        "builtin",
        builtin.interface_unit.interface_hash,
    ) {
        return Result::Err("world artifact prelude builtin dependency does not match")
    }
    let standard: Vec[ToolchainPackage] = Vec::new();
    for package_value in packages {
        if package_value.interface_unit.package_name != "builtin"
            && package_value.interface_unit.package_name != "prelude" {
            standard.push(package_value)
        }
    }
    world_validate_standard_packages(standard)?;
    world_validate_standard_dependencies(
        standard,
        builtin.interface_unit.interface_hash,
        prelude.interface_unit.interface_hash,
    )?;
    let world = PackageWorld {
        counter: Ref::new(metadata.counter),
        source_digest: metadata.source_digest,
        builtins: builtin.core_value,
        builtin_interface: builtin.interface_unit,
        prelude,
        standard,
    };
    artifact_prepare_world(world);
    Result::Ok(world)
}

fn decode_package_world_v2(
    container: wire::ArtifactBinaryContainer,
    metadata_section: wire::ArtifactBinarySection,
) -> Result[PackageWorld, string] {
    let metadata = world_decode_metadata_v2(metadata_section.data)?;
    if container.sections.len() != 1 + metadata.package_count * 2 {
        return Result::Err("world artifact package section count does not match")
    }
    let packages: Vec[ToolchainPackage] = Vec::new();
    let names: Vec[string] = Vec::new();
    for index in 0..metadata.package_count {
        let package_value = world_decode_package_any(container, (2 + index * 2).to_u16())?;
        names.push(package_value.interface_unit.package_name);
        packages.push(package_value)
    }
    let sorted_names: Vec[string] = Vec::new();
    for name in names {
        sorted_names.push(name)
    }
    let sorted_names = wire::sort_artifact_names(sorted_names);
    for index in 0..names.len() {
        if names[index] != sorted_names[index] {
            return Result::Err("world artifact packages are not sorted")
        } else if index > 0 && names[index] == names[index - 1] {
            return Result::Err("world artifact contains duplicate package " + names[index])
        }
    }
    world_from_packages(metadata, packages)
}

fn decode_package_world(data: bytes::Bytes) -> Result[PackageWorld, string] {
    let container = wire::decode_artifact_binary_container(data)?;
    if container.kind != 3 {
        return Result::Err("binary artifact is not a compiler world")
    }
    let metadata_section = wire::artifact_binary_find_section(container, 1).ok_or(
        "world artifact is missing a required section",
    )?;
    if metadata_section.flags != wire::required_section_flag() {
        return Result::Err("invalid world artifact section")
    }
    if metadata_section.version == 2 {
        decode_package_world_v2(container, metadata_section)
    } else {
        Result::Err("unsupported world artifact version")
    }
}

fn read_package_world(path: string) -> Result[PackageWorld, string] {
    let data = fs::read_bytes_structured(path).map_err(
        |error| f"failed to read compiler world {path}: {error}",
    )?;
    decode_package_world(data).map_err(
        |error| "failed to parse compiler world " + path + ": " + error,
    )
}

fn write_package_world(path: string, value: PackageWorld) -> Result[(), string] {
    let data = encode_package_world(value)?;
    match ensure_parent(path) {
        Ok(()) => atomic_write_data(path, data),
        Err(error) => Result::Err(error),
    }
}
