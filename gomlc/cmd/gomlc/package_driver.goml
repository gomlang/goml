package main;

use module::artifact::interface_codec as interface_codec;
use module::artifact::wire as wire;
use module::artifact;
use module::ast;
use module::anf;
use module::core;
use module::go_backend;
use module::hir;
use module::lift;
use module::resources;
use module::checker;
use module::tast;
use std::fs;
use std::text;

type StandardNeeds = Vec[string];

struct ArtifactCompilation {
    package_name: string,
    dependency_names: Vec[string],
    core_value: core::File,
}

struct ArtifactCompiledPackage {
    interface_unit: artifact::ArtifactInterfaceUnit,
    core_unit: artifact::ArtifactCoreUnit,
}

struct DeferredWorldPackage {
    name: string,
    interface_data: Slice[byte],
    core_data: Slice[byte],
    core_loaded: Ref[bool],
}

struct PackageWorld {
    builtin_metadata: tast::BuiltinMetadata,
    deferred: Vec[DeferredWorldPackage],
    counter: Ref[isize],
    source_digest: string,
    builtins: core::File,
    builtin_interface: artifact::ArtifactInterfaceUnit,
    prelude: ToolchainPackage,
    standard: Vec[ToolchainPackage],
}

fn no_standard_needs() -> StandardNeeds {
    Vec::new()
}

fn standard_needs_from_package_names(package_names: Vec[string]) -> StandardNeeds {
    resources::standard_package_closure(package_names)
}

fn source_standard_needs(value: ast::LowerResult) -> StandardNeeds {
    let package_names: Vec[string] = Vec::new();
    for spec in resources::standard_package_specs() {
        if imports_package(value, spec.name) {
            package_names.push(spec.name)
        }
    }
    standard_needs_from_package_names(package_names)
}

fn merge_standard_needs(left: StandardNeeds, right: StandardNeeds) -> StandardNeeds {
    let names = Vec::new();
    for name in left {
        names.push(name)
    }
    for name in right {
        names.push(name)
    }
    standard_needs_from_package_names(names)
}

fn package_world() -> PackageWorld {
    let counter = Ref::new(0);
    let builtin_files = builtin_hir_files();
    let checked = checker::check_builtin_package_files(builtin_files);
    let builtins = lower_checked_builtin_core(checked, counter);
    let builtin_interface = builtin_artifact_interface_unit_from_checked(builtin_files, checked);
    let prelude_compilation = compile_prelude_package_with_builtin_files(
        builtins,
        builtin_interface,
        builtin_files,
    );
    let prelude = artifact_standard_package_from_compilation(prelude_compilation);
    let standard = artifact_standard_packages(
        compile_standard_library_with_builtin_files(
            builtins,
            prelude_compilation,
            builtin_interface,
            builtin_files,
            all_standard_package_names(),
        ),
    );
    PackageWorld {
        builtin_metadata: required_builtin_metadata(),
        deferred: Vec::new(),
        counter,
        source_digest: "",
        builtins,
        builtin_interface,
        prelude,
        standard,
    }
}

fn append_core_files(target: Vec[core::File], values: Vec[core::File]) -> () {
    for value in values {
        target.push(value)
    }
}

fn merge_hir_files(values: Vec[hir::File], package_name: string) -> hir::File {
    let path = if !values.is_empty() {
        values[0].path
    } else {
        UNKNOWN_SOURCE_PATH
    };
    let source_path = if !values.is_empty() {
        values[0].source_path
    } else {
        UNKNOWN_SOURCE_PATH
    };
    let items: Vec[hir::Item] = Vec::new();
    let public_reexports: Vec[(string, string)] = Vec::new();
    let invalid_self_type_spans: Vec[ast::Span] = Vec::new();
    for value in values {
        for item in value.items {
            items.push(item)
        }
        for reexport in value.public_reexports {
            public_reexports.push(reexport)
        }
        for span in value.invalid_self_type_spans {
            invalid_self_type_spans.push(span)
        }
    }
    hir::File {
        package_name,
        path,
        source_path,
        imports: Vec::new(),
        import_aliases: Vec::new(),
        use_traits: Vec::new(),
        public_reexports,
        items,
        invalid_self_type_spans,
    }
}

fn package_item_name(package_name: string, name: string) -> string {
    if package_name == "main" || package_name == "builtin" || package_name == "prelude" {
        name
    } else {
        package_name + "::" + name
    }
}

fn artifact_short_name(value: string) -> string {
    let mut result = value;
    let mut index = 0;
    while index + 1 < value.byte_len() {
        if value.byte_get(index) == b':' && value.byte_get(index + 1) == b':' {
            result = value.byte_slice(index + 2, value.byte_len());
            index += 2;
        } else {
            index += 1;
        }
    }
    result
}

fn public_ast_item_name(package_name: string, value: ast::Item) -> Option[string] {
    match value {
        EnumDef(value) => match value.visibility {
            Public => Some(package_item_name(package_name, value.name)),
            Private => None,
        },
        StructDef(value) => match value.visibility {
            Public => Some(package_item_name(package_name, value.name)),
            Private => None,
        },
        TraitDef(value) => match value.visibility {
            Public => Some(package_item_name(package_name, value.name)),
            Private => None,
        },
        Function(value) => match value.visibility {
            Public => Some(package_item_name(package_name, value.name)),
            Private => None,
        },
        ExternFunction(value) => match value.visibility {
            Public => Some(package_item_name(package_name, value.name)),
            Private => None,
        },
        ExternType(value) => match value.visibility {
            Public => Some(package_item_name(package_name, value.name)),
            Private => None,
        },
        TypeAlias(value) => match value.visibility {
            Public => Some(package_item_name(package_name, value.name)),
            Private => None,
        },
        Constant(value) => match value.visibility {
            Public => Some(package_item_name(package_name, value.name)),
            Private => None,
        },
        Static(value) => match value.visibility {
            Public => Some(package_item_name(package_name, value.name)),
            Private => None,
        },
        ImplBlock(_) => None,
    }
}

fn public_item_names(values: Vec[ast::LowerResult], package_name: string) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    for value in values {
        if let Some(file) = value.ast {
            for item in file.items {
                if let Some(name) = public_ast_item_name(package_name, item) {
                    result.push(name)
                }
            }
        }
    }
    result
}

fn local_item_is_public(package_name: string, public_names: Vec[string], name: string) -> bool {
    let prefix = package_name + "::";
    if !name.starts_with(prefix) {
        true
    } else {
        let relative = name.byte_slice(prefix.byte_len(), name.byte_len());
        relative.contains("::") || public_names.contains(name)
    }
}

fn add_private_local_name(
    result: Vec[string],
    package_name: string,
    public_names: Vec[string],
    name: string,
) -> () {
    if !local_item_is_public(package_name, public_names, name) && !result.contains(name) {
        result.push(name)
    }
}

fn collect_private_const_names(
    result: Vec[string],
    package_name: string,
    public_names: Vec[string],
    value: hir::ConstExpr,
) -> () {
    match value.kind {
        Reference(name) => add_private_local_name(result, package_name, public_names, name),
        Unary { value, .. } => collect_private_const_names(
            result,
            package_name,
            public_names,
            value,
        ),
        Binary { left, right, .. } => {
            collect_private_const_names(result, package_name, public_names, left);
            collect_private_const_names(result, package_name, public_names, right)
        },
        Value(_) | Param(_) | Error => (),
    }
}

fn collect_private_generic_arg_names(
    result: Vec[string],
    package_name: string,
    public_names: Vec[string],
    value: hir::GenericArg,
) -> () {
    match value {
        Type(value) => collect_private_type_names(result, package_name, public_names, value),
        Const(value) => collect_private_const_names(result, package_name, public_names, value),
        Unresolved { name, .. } => add_private_local_name(result, package_name, public_names, name),
    }
}

fn collect_private_type_names(
    result: Vec[string],
    package_name: string,
    public_names: Vec[string],
    value: hir::TypeExpr,
) -> () {
    match value.kind {
        Named { reference } => add_private_local_name(
            result,
            package_name,
            public_names,
            hir::type_reference_name(reference),
        ),
        Dyn { bounds } => for bound in bounds {
            add_private_local_name(
                result,
                package_name,
                public_names,
                hir::type_reference_name(bound.reference),
            );
            for arg in bound.args {
                collect_private_generic_arg_names(result, package_name, public_names, arg)
            }
            for binding in bound.associated_types {
                collect_private_type_names(result, package_name, public_names, binding.1)
            }
        },
        Tuple { items: values } => for value in values {
            collect_private_type_names(result, package_name, public_names, value)
        },
        Projection { base, associated: _ } => collect_private_type_names(
            result,
            package_name,
            public_names,
            base,
        ),
        App { ty: base, args } => {
            collect_private_type_names(result, package_name, public_names, base);
            for arg in args {
                collect_private_generic_arg_names(result, package_name, public_names, arg)
            }
        },
        Array { len, elem } => {
            collect_private_const_names(result, package_name, public_names, len);
            collect_private_type_names(result, package_name, public_names, elem)
        },
        Func { params, ret_ty } => {
            for param in params {
                collect_private_type_names(result, package_name, public_names, param)
            }
            collect_private_type_names(result, package_name, public_names, ret_ty)
        },
        Unit | Bool | Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | Float32 | Float64 | String | Char | Param {
            ..,
        } | SelfType | Error => (),
    }
}

fn collect_private_trait_ref_names(
    result: Vec[string],
    package_name: string,
    public_names: Vec[string],
    value: hir::TraitRef,
) -> () {
    add_private_local_name(
        result,
        package_name,
        public_names,
        hir::type_reference_name(value.reference),
    );
    for arg in value.args {
        collect_private_generic_arg_names(result, package_name, public_names, arg)
    }
}

fn collect_private_predicate_names(
    result: Vec[string],
    package_name: string,
    public_names: Vec[string],
    value: hir::Predicate,
) -> () {
    match value {
        Trait { ty: for_ty, trait_ref } => {
            collect_private_type_names(result, package_name, public_names, for_ty);
            collect_private_trait_ref_names(result, package_name, public_names, trait_ref)
        },
        Equality { lhs: left, rhs: right } => {
            collect_private_type_names(result, package_name, public_names, left);
            collect_private_type_names(result, package_name, public_names, right)
        },
    }
}

fn collect_private_bounds_names(
    result: Vec[string],
    package_name: string,
    public_names: Vec[string],
    values: Vec[(string, Vec[hir::TraitRef])],
) -> () {
    for value in values {
        for trait_ref in value.1 {
            collect_private_trait_ref_names(result, package_name, public_names, trait_ref)
        }
    }
}

fn trait_impl_header_is_public(
    value: hir::ImplBlock,
    package_name: string,
    public_names: Vec[string],
) -> bool {
    match value.trait_ref {
        Some(trait_ref) => {
            let private_names: Vec[string] = Vec::new();
            collect_private_type_names(private_names, package_name, public_names, value.for_type);
            local_item_is_public(
                package_name,
                public_names,
                hir::type_reference_name(trait_ref.reference),
            )
                && private_names.is_empty()
        },
        None => true,
    }
}

fn trait_impl_exposed_private_names(
    value: hir::ImplBlock,
    package_name: string,
    public_names: Vec[string],
) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    if let Some(trait_ref) = value.trait_ref {
        for arg in trait_ref.args {
            collect_private_generic_arg_names(result, package_name, public_names, arg)
        }
    }
    collect_private_bounds_names(result, package_name, public_names, value.generic_bounds);
    for predicate in value.predicates {
        collect_private_predicate_names(result, package_name, public_names, predicate)
    }
    for associated in value.associated_types {
        collect_private_type_names(result, package_name, public_names, associated.1)
    }
    for method in value.methods {
        collect_private_bounds_names(result, package_name, public_names, method.generic_bounds);
        for predicate in method.predicates {
            collect_private_predicate_names(result, package_name, public_names, predicate)
        }
        for param in method.params {
            collect_private_type_names(result, package_name, public_names, param.1)
        }
        if let Some(ret_ty) = method.ret_ty {
            collect_private_type_names(result, package_name, public_names, ret_ty)
        }
    }
    result
}

fn join_artifact_names(values: Vec[string]) -> string {
    let builder = text::StringBuilder::new();
    for index in 0..values.len() {
        if index > 0 {
            builder.write_string(", ")
        }
        builder.write_string(values[index])
    }
    builder.finish()
}

fn validate_public_trait_impls(value: hir::File, package_name: string, public_names: Vec[string]) -> Result[
    (),
    string,
] {
    for item in value.items {
        if let ImplBlock(value) = item {
            if let Some(trait_ref) = value.trait_ref {
                if trait_impl_header_is_public(value, package_name, public_names) {
                    let private_names = wire::sort_artifact_names(
                        trait_impl_exposed_private_names(value, package_name, public_names),
                    );
                    if !private_names.is_empty() {
                        return Err(
                            "Public trait implementation "
                                + hir::type_reference_name(trait_ref.reference)
                                + " exposes private type "
                                + join_artifact_names(private_names),
                        )
                    }
                }
            }
        }
    }
    Ok(())
}

fn function_exposed_private_names(
    value: hir::Function,
    package_name: string,
    public_names: Vec[string],
) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    collect_private_bounds_names(result, package_name, public_names, value.generic_bounds);
    for predicate in value.predicates {
        collect_private_predicate_names(result, package_name, public_names, predicate)
    }
    for param in value.params {
        collect_private_type_names(result, package_name, public_names, param.1)
    }
    if let Some(ret_ty) = value.ret_ty {
        collect_private_type_names(result, package_name, public_names, ret_ty)
    }
    wire::sort_artifact_names(result)
}

fn validate_public_fields_and_inherent_methods(
    value: hir::File,
    package_name: string,
    public_names: Vec[string],
) -> Result[(), string] {
    for item in value.items {
        match item {
            StructDef(value) => if public_names.contains(value.name) {
                for field in value.fields {
                    if value.public_fields.contains(field.0) {
                        let private_names: Vec[string] = Vec::new();
                        collect_private_type_names(
                            private_names,
                            package_name,
                            public_names,
                            field.1,
                        );
                        if !private_names.is_empty() {
                            return Err(
                                "Public field " + value.name + "." + field.0
                                    + " exposes private type "
                                    + join_artifact_names(wire::sort_artifact_names(private_names)),
                            )
                        }
                    }
                }
            },
            ImplBlock(value) => match value.trait_ref {
                Some(_) => (),
                None => {
                    let target_private_names: Vec[string] = Vec::new();
                    collect_private_type_names(
                        target_private_names,
                        package_name,
                        public_names,
                        value.for_type,
                    );
                    if target_private_names.is_empty() {
                        for method in value.methods {
                            match method.visibility {
                                Public => {
                                    let private_names = function_exposed_private_names(
                                        method,
                                        package_name,
                                        public_names,
                                    );
                                    if !private_names.is_empty() {
                                        return Err(
                                            "Public inherent method "
                                                + artifact_short_name(method.name)
                                                + " exposes private type "
                                                + join_artifact_names(private_names),
                                        )
                                    }
                                },
                                Private => (),
                            }
                        }
                    }
                },
            },
            _ => (),
        }
    }
    Ok(())
}

fn selected_standard_package_names(needs: StandardNeeds) -> Vec[string] {
    let names = Vec::new();
    for spec in resources::standard_package_specs() {
        if needs.contains(spec.name) {
            names.push(spec.name)
        }
    }
    resources::standard_package_closure(names)
}

fn required_artifact_standard_package(standard: Vec[ToolchainPackage], package_name: string) -> ToolchainPackage {
    match artifact_standard_package(standard, package_name) {
        Some(value) => value,
        None => {
            fail("error[compile]: compiler world is missing standard package " + package_name);
            standard[0]
        },
    }
}

fn selected_standard_packages_for_needs(standard: Vec[ToolchainPackage], needs: StandardNeeds) -> Vec[
    ToolchainPackage,
] {
    let result: Vec[ToolchainPackage] = Vec::new();
    for package_name in selected_standard_package_names(needs) {
        result.push(required_artifact_standard_package(standard, package_name))
    }
    result
}

fn checked_hir_file(value: hir::LowerResult, package_name: string) -> hir::File {
    if !value.diagnostics.is_empty() {
        fail(
            render_typer_diagnostics(
                hir_diagnostics(value.diagnostics, value.source_path),
                value.source_path,
                read_source(value.source_path),
            ),
        )
    }
    match value.hir {
        Some(file) => file,
        None => {
            fail("error[typer]: failed to lower package " + package_name);
            hir::File {
                package_name,
                path: UNKNOWN_SOURCE_PATH,
                source_path: UNKNOWN_SOURCE_PATH,
                imports: Vec::new(),
                import_aliases: Vec::new(),
                use_traits: Vec::new(),
                public_reexports: Vec::new(),
                items: Vec::new(),
                invalid_self_type_spans: Vec::new(),
            }
        },
    }
}

fn core_function_ret_type(functions: Vec[core::Function], name: string) -> Option[core::Type] {
    for offset in 0..functions.len() {
        let function = functions[functions.len() - 1 - offset];
        if function.name == name {
            return Some(function.ret_ty)
        }
    }
    None
}

fn add_entry_wrapper(value: core::File, package_name: string) -> core::File {
    let expected = if package_name == "main" {
        "main"
    } else {
        package_name + "::main"
    };
    let functions: Vec[core::Function] = Vec::new();
    for function in value.functions {
        functions.push(function)
    }
    match core_function_ret_type(functions, expected) {
        Some(ret_ty) => if expected != "main" {
            functions.push(
                core::Function {
                    name: "main",
                    origin: core::FunctionOrigin::Source,
                    root: true,
                    generics: Vec::new(),
                    predicates: Vec::new(),
                    trait_impl: Option::None,
                    params: Vec::new(),
                    ret_ty,
                    body: core::Block {
                        stmts: Vec::new(),
                        tail: Option::Some(
                            Call {
                                func: core::Expr::Var {
                                    name: expected,
                                    ty: core::Type::Func { params: Vec::new(), ret_ty },
                                },
                                args: Vec::new(),
                                ty: ret_ty,
                            },
                        ),
                    },
                },
            )
        },
        None => fail("error[compile]: entry package has no main function"),
    }
    core::File {
        functions,
        enums: value.enums,
        structs: value.structs,
        type_instances: value.type_instances,
        constants: value.constants,
        statics: value.statics,
    }
}

fn entry_core(value: core::File, package_name: string) -> core::File {
    if package_name == "main" {
        match core_function_ret_type(value.functions, "main") {
            Some(_) => value,
            None => {
                fail("error[compile]: entry package has no main function");
                value
            },
        }
    } else {
        add_entry_wrapper(value, package_name)
    }
}

fn selected_link_standard_core(standard: Vec[ToolchainPackage], needs: StandardNeeds) -> Vec[
    core::File,
] {
    let result: Vec[core::File] = Vec::new();
    for package_value in selected_standard_packages_for_needs(standard, needs) {
        result.push(core::without_roots(package_value.core_value))
    }
    result
}

fn run_package_command(args: Vec[string], build: bool, emit_tests: bool) -> () {
    let command = match parse_package_command_args(args) {
        Ok(value) => value,
        Err(error) => {
            handle_cli_parse_error(args[1], error);
            PackageCommandArgs {
                package_name: "main",
                module_name: "main",
                inputs: Vec::new(),
                interface_paths: Vec::new(),
                output: "package",
                world: Option::None,
            }
        },
    };
    let world = match command.world {
        Some(path) => match read_package_world_lazy(path, false) {
            Ok(value) => value,
            Err(error) => {
                fail(COMPILE_ERROR_PREFIX + error);
                package_world()
            },
        },
        None => package_world(),
    };
    let artifact = match compile_artifact_package(world, command, build, emit_tests) {
        Ok(value) => value,
        Err(error) => {
            if error.starts_with("error[") {
                fail(error)
            } else {
                fail(COMPILE_ERROR_PREFIX + error)
            }
            let interface_unit = interface_codec::new_unit(
                command.package_name,
                interface_codec::empty_exports(),
                artifact::ArtifactPackageInterface {
                    package_name: command.package_name,
                    name: "main",
                    value_exports: Vec::new(),
                    enum_variants: Vec::new(),
                },
                Vec::from_array(
                    [
                        ("builtin", artifact_builtin_interface_hash(world)),
                        ("prelude", artifact_prelude_interface_hash(world)),
                    ],
                ),
            );
            ArtifactCompiledPackage {
                interface_unit,
                core_unit: artifact::ArtifactCoreUnit {
                    source_origins: Vec::new(),
                    package_name: command.package_name,
                    declared_name: "main",
                    interface_hash: interface_unit.interface_hash,
                    exports: interface_codec::empty_exports(),
                    core_ir: empty_core_file(),
                    deps: Vec::from_array(
                        [
                            ("builtin", artifact_builtin_interface_hash(world)),
                            ("prelude", artifact_prelude_interface_hash(world)),
                        ],
                    ),
                    sources: Vec::new(),
                    tests: Vec::new(),
                },
            }
        },
    };
    if let Err(error) = output_transaction(
        command.output,
        || {
            ensure_parent(interface_output_path(command.output))?;
            write_artifact_interface(interface_output_path(command.output), artifact.interface_unit)?;
            if build {
                ensure_parent(core_output_path(command.output))?;
                write_artifact_core(core_output_path(command.output), artifact.core_unit)?
            }
            Ok(())
        },
    ) {
        fail(error)
    }
}

fn run_link_command(args: Vec[string]) -> () {
    let command = match parse_link_command_args(args) {
        Ok(value) => value,
        Err(error) => {
            handle_cli_parse_error(LINK_COMMAND, error);
            LinkCommandArgs {
                explain_performance: false,
                inputs: Vec::new(),
                entry: "main",
                output: "main.go",
                world: Option::None,
            }
        },
    };
    let report_path = command.output + ".performance.json";
    if fs::is_file(report_path) {
        if let Err(error) = fs::remove_file(report_path) {
            fail(error.to_string())
        }
    }
    let world = match command.world {
        Some(path) => match read_package_world_lazy(path, true) {
            Ok(value) => value,
            Err(error) => {
                fail(COMPILE_ERROR_PREFIX + error);
                package_world()
            },
        },
        None => package_world(),
    };
    let core_units = match artifact_read_core_units(command.inputs) {
        Ok(value) => value,
        Err(error) => {
            fail(COMPILE_ERROR_PREFIX + error);
            Vec::new()
        },
    };
    let roots = Vec::from_array([command.entry]);
    let core_units = match artifact_reachable_core_units(roots, core_units) {
        Ok(value) => value,
        Err(error) => {
            fail(COMPILE_ERROR_PREFIX + error);
            Vec::new()
        },
    };
    if let Err(error) = artifact_validate_link_core_units(world, core_units) {
        fail(COMPILE_ERROR_PREFIX + error)
    }
    artifact_prepare_core_units(world, core_units);
    match artifact_find_core_unit(core_units, command.entry) {
        Some(value) => if value.declared_name == "" || value.declared_name == "main" {} else {
            fail(
                "error[compile]: entry package " + command.entry + " declares package "
                    + value.declared_name
                    + ", expected main",
            )
        },
        None => fail("error[compile]: missing entry package " + command.entry),
    }
    let dependencies: Vec[core::File] = Vec::new();
    let entries: Vec[ArtifactCompilation] = Vec::new();
    let needs = artifact_core_standard_needs(core_units);
    let compilations = match artifact_core_compilations(core_units) {
        Ok(values) => values,
        Err(error) => {
            fail(COMPILE_ERROR_PREFIX + error);
            Vec::new()
        },
    };
    for compilation in compilations {
        if compilation.package_name == command.entry {
            entries.push(compilation)
        } else {
            dependencies.push(compilation.core_value)
        }
    }
    if entries.is_empty() {
        fail("error[compile]: missing entry package " + command.entry)
    }
    let entry = entries[entries.len() - 1];
    let linked_dependencies = Vec::from_array([world.prelude.core_value]);
    append_core_files(linked_dependencies, selected_link_standard_core(world.standard, needs));
    append_core_files(linked_dependencies, dependencies);
    let linked = core::link_with_dependencies(
        world.builtins,
        linked_dependencies,
        entry_core(entry.core_value, command.entry),
    );
    let source_names: Vec[(string, string)] = Vec::new();
    let mono_value = match lower_linked_with_source_names(linked, source_names) {
        Ok(value) => value,
        Err(error) => {
            fail(COMPILE_ERROR_PREFIX + error);
            return
        },
    };
    let lifted_sources: Vec[(string, string)] = Vec::new();
    let lift_value = match lift::lower_checked_with_source_names(
        mono_value,
        world.counter,
        lifted_sources,
    ) {
        Ok(value) => lift::dce(value),
        Err(message) => {
            fail(COMPILE_ERROR_PREFIX + message);
            return
        },
    };
    let decisions: Vec[anf::InlineDecision] = Vec::new();
    let anf_value = if command.explain_performance {
        let value = anf::scalar_replace(
            anf::lower_with_report(lift_value, world.counter, Some(decisions)),
        );
        if let Err(message) = anf::verify(value) {
            fail(COMPILE_ERROR_PREFIX + "invalid ANF IR: " + message)
        }
        value
    } else {
        lower_anf_stage(lift_value, world.counter)
    };
    let generated = match go_backend::lower_with_source_names(anf_value) {
        Ok(value) => value,
        Err(message) => {
            fail(COMPILE_ERROR_PREFIX + message);
            return
        },
    };
    let metadata = linked_source_origins(
        core_units,
        source_names,
        lifted_sources,
        generated.source_names,
    );
    let go_source = go_backend::encode(go_backend::embed_source_origins(generated.file, metadata));
    match ensure_parent(command.output) {
        Ok(()) => match atomic_write_text(command.output, go_source) {
            Ok(()) => if command.explain_performance {
                let report = linked_performance_report(
                    core_units,
                    source_names,
                    lifted_sources,
                    generated,
                    anf_value,
                    decisions,
                    go_source,
                    command.entry,
                );
                if let Err(error) = atomic_write_text(report_path, report) {
                    fail(error)
                }
            },
            Err(error) => fail(error),
        },
        Err(error) => fail(error),
    }
}

fn empty_core_file() -> core::File {
    core::File {
        functions: Vec::new(),
        enums: Vec::new(),
        structs: Vec::new(),
        type_instances: Vec::new(),
        constants: Vec::new(),
        statics: Vec::new(),
    }
}

fn run_test_link_command(args: Vec[string]) -> () {
    let command = match parse_test_link_command_args(args) {
        Ok(value) => value,
        Err(error) => {
            handle_cli_parse_error(TEST_LINK_COMMAND, error);
            TestLinkCommandArgs {
                inputs: Vec::new(),
                packages: Vec::new(),
                output: "main.go",
                manifest: "tests.json",
                world: Option::None,
            }
        },
    };
    let world = match command.world {
        Some(path) => match read_package_world_lazy(path, true) {
            Ok(value) => value,
            Err(error) => {
                fail(COMPILE_ERROR_PREFIX + error);
                package_world()
            },
        },
        None => package_world(),
    };
    let core_units = match artifact_read_core_units(command.inputs) {
        Ok(value) => value,
        Err(error) => {
            fail(COMPILE_ERROR_PREFIX + error);
            Vec::new()
        },
    };
    let core_units = match artifact_reachable_core_units(command.packages, core_units) {
        Ok(value) => value,
        Err(error) => {
            fail(COMPILE_ERROR_PREFIX + error);
            Vec::new()
        },
    };
    if let Err(error) = artifact_validate_link_core_units(world, core_units) {
        fail(COMPILE_ERROR_PREFIX + error)
    }
    artifact_prepare_core_units(world, core_units);
    let package_cores: Vec[core::File] = Vec::new();
    let needs = artifact_core_standard_needs(core_units);
    let compilations = match artifact_core_compilations(core_units) {
        Ok(values) => values,
        Err(error) => {
            fail(COMPILE_ERROR_PREFIX + error);
            Vec::new()
        },
    };
    for compilation in compilations {
        package_cores.push(compilation.core_value)
    }
    let tests: Vec[artifact::ArtifactTestDescriptor] = Vec::new();
    for package_name in command.packages {
        match artifact_find_core_unit(core_units, package_name) {
            Some(core_unit) => for test in core_unit.tests {
                tests.push(test)
            },
            None => fail("error[compile]: missing test package " + package_name),
        }
    }
    let linked_dependencies = Vec::from_array([world.prelude.core_value]);
    append_core_files(linked_dependencies, selected_link_standard_core(world.standard, needs));
    append_core_files(linked_dependencies, package_cores);
    let linked = core::link_with_dependencies(
        world.builtins,
        linked_dependencies,
        empty_core_file(),
    );
    let source_names: Vec[(string, string)] = Vec::new();
    let mono_value = match lower_linked_with_source_names(linked, source_names) {
        Ok(value) => value,
        Err(error) => {
            fail(COMPILE_ERROR_PREFIX + error);
            return
        },
    };
    let lifted_sources: Vec[(string, string)] = Vec::new();
    let lift_value = match lift::lower_checked_with_source_names(
        mono_value,
        world.counter,
        lifted_sources,
    ) {
        Ok(value) => lift::dce(value),
        Err(message) => {
            fail(COMPILE_ERROR_PREFIX + message);
            return
        },
    };
    let anf_value = lower_anf_stage(lift_value, world.counter);
    let generated = match go_backend::lower_tests_with_source_names(
        anf_value,
        test_link_cases(tests),
    ) {
        Ok(value) => value,
        Err(message) => {
            fail(COMPILE_ERROR_PREFIX + message);
            return
        },
    };
    let metadata = linked_source_origins(
        core_units,
        source_names,
        lifted_sources,
        generated.source_names,
    );
    let go_source = go_backend::encode(go_backend::embed_source_origins(generated.file, metadata));
    if let Err(error) = output_transaction(
        command.output,
        || {
            ensure_parent(command.output)?;
            ensure_parent(command.manifest)?;
            atomic_write_text(command.output, go_source)?;
            atomic_write_text(command.manifest, encode_test_manifest(tests))
        },
    ) {
        fail(error)
    }
}
