package main;

use std::env;
use std::bytes;
use std::fs;
use std::json;
use std::path;
use std::process;
use std::testing;
use std::utf8;
use utf8::BytesUtf8;
use module::ffi;

fn foreign_package_cli_output(
    compiler: string,
    directory: string,
    subcommand: string,
    mode: string,
    context_path: string,
) -> Result[process::Output, string] {
    process::Command::new(compiler).args(
        Vec::from_array(
            [
                subcommand,
                "--package",
                "demo::calc",
                "--module",
                "demo::calc",
                "--input",
                path::join(directory, "calc.gom"),
                "--output",
                path::join(directory, subcommand),
                "--context",
                context_path,
                "--caller-directory",
                path::join(directory, "gen"),
                "--caller-import-path",
                "command-line-arguments",
                "--caller-mode",
                "files",
                "--caller-package",
                "main",
                "--ffi-check",
                mode,
            ],
        ),
    ).current_dir(directory).output_structured().map_err(|error| error.to_string())
}

fn exercise_foreign_package_publication(directory: string, subcommand: string) -> Result[(), string] {
    ffi_driver_fixture(directory)?;
    let context = resolve_foreign_build_context("go", directory)?;
    let context_path = path::join(directory, "context.json");
    fs::write_file_structured(context_path, json::encode(ffi::build_context_json(context))).map_err(
        |error| error.to_string(),
    )?;
    let compiler = env::var_structured("GOML_TEST_GOMLC").unwrap_or("../stage2/bin/gomlc");
    let compiler = path::absolute_structured(compiler).map_err(|error| error.to_string())?;
    let _ = compile_private_foreign_interface(directory, "MissingFunction")?;
    let output_base = path::join(directory, subcommand);
    let interface_path = interface_output_path(output_base);
    let core_path = core_output_path(output_base);
    let output = foreign_package_cli_output(
        compiler,
        directory,
        subcommand,
        "required",
        context_path,
    )?;
    testing::assert(!output.status().success());
    testing::assert(output.stderr().to_string_utf8().unwrap_or("").contains("ffi-symbol-not-found"));
    testing::assert(!fs::is_file(interface_path));
    testing::assert(!fs::is_file(core_path));
    let _ = compile_private_foreign_interface(directory, "Abs")?;
    let output = foreign_package_cli_output(
        compiler,
        directory,
        subcommand,
        "required",
        context_path,
    )?;
    if !output.status().success() {
        return Result::Err(output.stderr().to_string_utf8().unwrap_or("invalid package output"))
    }
    let before = fs::read_bytes_structured(interface_path).map_err(|error| error.to_string())?;
    let has_core = subcommand == "build" || subcommand == "test-build";
    testing::assert_eq(fs::is_file(core_path), has_core);
    let core_before = if has_core {
        fs::read_bytes_structured(core_path).map_err(|error| error.to_string())?
    } else {
        bytes::Bytes::from_string("")
    };
    let _ = compile_private_foreign_interface(directory, "MissingFunction")?;
    let output = foreign_package_cli_output(
        compiler,
        directory,
        subcommand,
        "required",
        context_path,
    )?;
    testing::assert(!output.status().success());
    assert_foreign_artifact_bytes(interface_path, before)?;
    if has_core {
        assert_foreign_artifact_bytes(core_path, core_before)?
    }
    let output = foreign_package_cli_output(
        compiler,
        directory,
        subcommand,
        "off",
        path::join(directory, "missing-context"),
    )?;
    testing::assert(output.status().success());
    testing::assert(output.stderr().to_string_utf8().unwrap_or("").contains("ffi-unverified"));
    Result::Ok(())
}

fn assert_foreign_package_publication(subcommand: string) -> () {
    let temporary = temp_go_path("ffi-package.gom", "publication-" + subcommand);
    let result = exercise_foreign_package_publication(
        path::parent(temporary).unwrap_or(""),
        subcommand,
    );
    cleanup_temp_directory(temporary);
    match result {
        Ok(()) => (),
        Err(message) => testing::fail(message),
    }
}

#[test]
fn foreign_package_validation_precedes_artifact_publication_check() -> () {
    assert_foreign_package_publication("check")
}

#[test]
fn foreign_package_validation_precedes_artifact_publication_build() -> () {
    assert_foreign_package_publication("build")
}

#[test]
fn foreign_package_validation_precedes_artifact_publication_test_check() -> () {
    assert_foreign_package_publication("test-check")
}

#[test]
fn foreign_package_validation_precedes_artifact_publication_test_build() -> () {
    assert_foreign_package_publication("test-build")
}

#[test]
fn foreign_package_options_reject_partial_and_repeated_context() -> () {
    let base = Vec::from_array(
        ["gomlc", "check", "--package", "demo", "--input", "main.gom", "--output", "main"],
    );
    testing::assert(parse_package_command_args(base).is_ok());
    base.push("--ffi-check");
    base.push("required");
    testing::assert(parse_package_command_args(base).is_err());
    base.push("--ffi-check");
    base.push("off");
    testing::assert(parse_package_command_args(base).is_err());
}

fn assert_foreign_artifact_bytes(file: string, before: bytes::Bytes) -> Result[(), string] {
    let after = fs::read_bytes_structured(file).map_err(|error| error.to_string())?;
    testing::assert_eq(after.len(), before.len());
    for index in 0..before.len() {
        testing::assert_eq(after.get(index), before.get(index))
    }
    Result::Ok(())
}
