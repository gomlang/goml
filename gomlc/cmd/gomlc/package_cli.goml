package main;

use module::artifact::wire as wire;
use std::fs;
use std::path;

struct PackageCommandArgs {
    package_name: string,
    module_name: string,
    inputs: Vec[string],
    interface_paths: Vec[string],
    output: string,
    world: Option[string],
}

struct LinkCommandArgs {
    inputs: Vec[string],
    entry: string,
    output: string,
    world: Option[string],
}

struct TestLinkCommandArgs {
    inputs: Vec[string],
    packages: Vec[string],
    output: string,
    manifest: string,
    world: Option[string],
}

struct ExtractedWorldArgs {
    args: Vec[string],
    world: Option[string],
}

fn extract_world_args(args: Vec[string]) -> Result[ExtractedWorldArgs, string] {
    let result: Vec[string] = Vec::new();
    let mut world: Option[string] = Option::None;
    let mut index = 0;
    let mut positional = false;
    while index < args.len() {
        let argument = args[index];
        if index >= 2 && !positional && argument == "--" {
            positional = true;
            result.push(argument);
            index += 1;
        } else if index >= 2 && !positional && argument == "--world" {
            if world.is_some() {
                return Result::Err(repeated_argument_error(args[1], "--world <WORLD>"))
            } else if index + 1 >= args.len() || cli_option(args[index + 1]) {
                return Result::Err(value_required_error("--world <WORLD>", Option::None))
            } else {
                world = Option::Some(args[index + 1]);
                index += 2;
            }
        } else if index >= 2 && !positional && inline_cli_value(argument, "--world").is_some() {
            if world.is_some() {
                return Result::Err(repeated_argument_error(args[1], "--world <WORLD>"))
            } else if option_string_empty(inline_cli_value(argument, "--world")) {
                return Result::Err(value_required_error("--world <WORLD>", Option::None))
            } else {
                world = inline_cli_value(argument, "--world");
                index += 1;
            }
        } else {
            result.push(argument);
            index += 1;
        }
    }
    Result::Ok(ExtractedWorldArgs { args: result, world: world })
}

fn cli_option(value: string) -> bool {
    value.starts_with("-")
}

fn inline_cli_value(argument: string, name: string) -> Option[string] {
    let prefix = name + "=";
    if argument.starts_with(prefix) {
        Option::Some(argument.byte_slice(prefix.byte_len(), argument.byte_len()))
    } else {
        Option::None
    }
}

fn option_string_empty(value: Option[string]) -> bool {
    match value {
        Some(value) => value == "",
        None => false,
    }
}

fn selected_package_usage(command: string, interface_paths: Vec[string]) -> string {
    if !interface_paths.is_empty() {
        required_command_usage(command) + " --interface-path <INTERFACE_FILE>"
    } else {
        required_command_usage(command)
    }
}

fn sorted_unique_package_inputs(values: Vec[string]) -> Vec[string] {
    let sorted = wire::sort_artifact_names(values);
    let result: Vec[string] = Vec::new();
    for value in sorted {
        if result.is_empty() || result[result.len() - 1] != value {
            result.push(value)
        }
    }
    result
}

fn parse_package_command_args(args: Vec[string]) -> Result[PackageCommandArgs, string] {
    let extracted = extract_world_args(args)?;
    let args = extracted.args;
    let mut package_name: Option[string] = Option::None;
    let mut module_name: Option[string] = Option::None;
    let mut output: Option[string] = Option::None;
    let inputs: Vec[string] = Vec::new();
    let interface_paths: Vec[string] = Vec::new();
    let mut index = 2;
    let mut positional = false;
    let command = args[1];
    while index < args.len() {
        let argument = args[index];
        if !positional && argument == "--" {
            positional = true;
            index += 1;
        } else if !positional && cli_help_argument(argument) {
            return Result::Err(cli_help_signal())
        } else if !positional && inline_cli_value(argument, "--help").is_some() {
            let value = inline_cli_value(argument, "--help").unwrap_or("");
            return Result::Err(
                unexpected_value_error_with_usage(
                    value,
                    "--help",
                    selected_package_usage(command, interface_paths) + " --help",
                ),
            )
        } else if !positional && cli_value_option(command, argument) && index + 1 < args.len()
            && cli_option(args[index + 1])
            && !known_cli_option(command, args[index + 1]) {
            let usage = if package_name.is_some() || output.is_some() || !inputs.is_empty()
                || !interface_paths.is_empty() {
                selected_package_usage(command, interface_paths)
            } else {
                command_usage(command)
            };
            return Result::Err(
                unexpected_cli_option_error_with_usage(command, args[index + 1], usage),
            )
        } else if positional {
            return Result::Err(unexpected_argument_error(command, argument, false))
        } else if argument == "--package" {
            if index + 1 >= args.len() || cli_option(args[index + 1]) {
                return Result::Err(value_required_error("--package <PACKAGE>", Option::None))
            } else if package_name.is_some() {
                return Result::Err(repeated_argument_error(command, "--package <PACKAGE>"))
            } else {
                package_name = Option::Some(args[index + 1]);
                index += 2;
            }
        } else if inline_cli_value(argument, "--package").is_some() {
            if package_name.is_some() {
                return Result::Err(repeated_argument_error(command, "--package <PACKAGE>"))
            } else {
                package_name = inline_cli_value(argument, "--package");
                index += 1;
            }
        } else if argument == "--module" {
            if index + 1 >= args.len() || cli_option(args[index + 1]) {
                return Result::Err(value_required_error("--module <MODULE>", Option::None))
            } else if module_name.is_some() {
                return Result::Err(repeated_argument_error(command, "--module <MODULE>"))
            } else {
                module_name = Option::Some(args[index + 1]);
                index += 2;
            }
        } else if inline_cli_value(argument, "--module").is_some() {
            if module_name.is_some() {
                return Result::Err(repeated_argument_error(command, "--module <MODULE>"))
            } else if option_string_empty(inline_cli_value(argument, "--module")) {
                return Result::Err(value_required_error("--module <MODULE>", Option::None))
            } else {
                module_name = inline_cli_value(argument, "--module");
                index += 1;
            }
        } else if argument == "--input" {
            index += 1;
            let previous_len = inputs.len();
            while index < args.len() && !cli_option(args[index]) {
                inputs.push(args[index]);
                index += 1;
            }
            if inputs.len() == previous_len {
                return Result::Err(value_required_error("--input <INPUT>...", Option::None))
            }
        } else if inline_cli_value(argument, "--input").is_some() {
            let value = inline_cli_value(argument, "--input").unwrap_or("");
            if value == "" {
                return Result::Err(value_required_error("--input <INPUT>...", Option::None))
            } else {
                inputs.push(value);
                index += 1;
                while index < args.len() && !cli_option(args[index]) {
                    inputs.push(args[index]);
                    index += 1;
                }
            }
        } else if argument == "--interface-path" {
            if index + 1 >= args.len() || cli_option(args[index + 1]) {
                return Result::Err(
                    value_required_error("--interface-path <INTERFACE_FILE>", Option::None),
                )
            } else {
                interface_paths.push(args[index + 1]);
                index += 2;
            }
        } else if inline_cli_value(argument, "--interface-path").is_some() {
            if option_string_empty(inline_cli_value(argument, "--interface-path")) {
                return Result::Err(
                    value_required_error("--interface-path <INTERFACE_FILE>", Option::None),
                )
            } else {
                if let Some(value) = inline_cli_value(argument, "--interface-path") {
                    interface_paths.push(value)
                }
                index += 1;
            }
        } else if argument == "--output" {
            if index + 1 >= args.len() || cli_option(args[index + 1]) {
                return Result::Err(value_required_error("--output <OUTPUT>", Option::None))
            } else if output.is_some() {
                return Result::Err(repeated_argument_error(command, "--output <OUTPUT>"))
            } else {
                output = Option::Some(args[index + 1]);
                index += 2;
            }
        } else if inline_cli_value(argument, "--output").is_some() {
            if option_string_empty(inline_cli_value(argument, "--output")) {
                return Result::Err(value_required_error("--output <OUTPUT>", Option::None))
            } else if output.is_some() {
                return Result::Err(repeated_argument_error(command, "--output <OUTPUT>"))
            } else {
                output = inline_cli_value(argument, "--output");
                index += 1;
            }
        } else {
            if let Some(similar) = similar_cli_argument(command, argument) {
                let usage = if similar == "--interface-path" && interface_paths.is_empty() {
                    required_command_usage(command) + " --interface-path <INTERFACE_FILE>"
                } else if similar == "--help" {
                    selected_package_usage(command, interface_paths) + " --help"
                } else {
                    selected_package_usage(command, interface_paths)
                };
                return Result::Err(unexpected_similar_argument_error(argument, similar, usage))
            }
            let usage = if cli_option(argument)
                && (package_name.is_some() || output.is_some() || !inputs.is_empty()
                    || !interface_paths.is_empty()) {
                selected_package_usage(command, interface_paths)
            } else {
                command_usage(command)
            };
            return Result::Err(unexpected_argument_error_with_usage(argument, false, usage))
        }
    }
    let missing: Vec[string] = Vec::new();
    if package_name.is_none() {
        missing.push("--package <PACKAGE>")
    }
    if inputs.is_empty() {
        missing.push("--input <INPUT>...")
    }
    if output.is_none() {
        missing.push("--output <OUTPUT>")
    }
    if !missing.is_empty() {
        Result::Err(
            missing_required_arguments_error_with_usage(
                missing,
                selected_package_usage(command, interface_paths),
            ),
        )
    } else {
        Result::Ok(
            PackageCommandArgs {
                package_name: package_name.unwrap_or(""),
                module_name: module_name.unwrap_or_else(|| package_name.unwrap_or("")),
                inputs: sorted_unique_package_inputs(inputs),
                interface_paths,
                output: output.unwrap_or(""),
                world: extracted.world,
            },
        )
    }
}

fn parse_link_command_args(args: Vec[string]) -> Result[LinkCommandArgs, string] {
    let extracted = extract_world_args(args)?;
    let args = extracted.args;
    let mut entry: Option[string] = Option::None;
    let mut output: Option[string] = Option::None;
    let inputs: Vec[string] = Vec::new();
    let mut index = 2;
    let mut positional = false;
    let command = args[1];
    while index < args.len() {
        let argument = args[index];
        if !positional && argument == "--" {
            positional = true;
            index += 1;
        } else if !positional && cli_help_argument(argument) {
            return Result::Err(cli_help_signal())
        } else if !positional && inline_cli_value(argument, "--help").is_some() {
            let value = inline_cli_value(argument, "--help").unwrap_or("");
            return Result::Err(
                unexpected_value_error_with_usage(
                    value,
                    "--help",
                    command_usage(command) + " --help",
                ),
            )
        } else if !positional && cli_value_option(command, argument) && index + 1 < args.len()
            && cli_option(args[index + 1])
            && !known_cli_option(command, args[index + 1]) {
            return Result::Err(
                unexpected_cli_option_error_with_usage(
                    command,
                    args[index + 1],
                    command_usage(command),
                ),
            )
        } else if positional {
            return Result::Err(unexpected_argument_error(command, argument, false))
        } else if argument == "--input" {
            index += 1;
            let previous_len = inputs.len();
            while index < args.len() && !cli_option(args[index]) {
                inputs.push(args[index]);
                index += 1;
            }
            if inputs.len() == previous_len {
                return Result::Err(value_required_error("--input <INPUT>...", Option::None))
            }
        } else if inline_cli_value(argument, "--input").is_some() {
            let value = inline_cli_value(argument, "--input").unwrap_or("");
            if value == "" {
                return Result::Err(value_required_error("--input <INPUT>...", Option::None))
            } else {
                inputs.push(value);
                index += 1;
                while index < args.len() && !cli_option(args[index]) {
                    inputs.push(args[index]);
                    index += 1;
                }
            }
        } else if argument == "--entry" {
            if index + 1 >= args.len() || cli_option(args[index + 1]) {
                return Result::Err(value_required_error("--entry <ENTRY>", Option::None))
            } else if entry.is_some() {
                return Result::Err(repeated_argument_error(command, "--entry <ENTRY>"))
            } else {
                entry = Option::Some(args[index + 1]);
                index += 2;
            }
        } else if inline_cli_value(argument, "--entry").is_some() {
            if entry.is_some() {
                return Result::Err(repeated_argument_error(command, "--entry <ENTRY>"))
            } else {
                entry = inline_cli_value(argument, "--entry");
                index += 1;
            }
        } else if argument == "--output" {
            if index + 1 >= args.len() || cli_option(args[index + 1]) {
                return Result::Err(value_required_error("--output <OUTPUT>", Option::None))
            } else if output.is_some() {
                return Result::Err(repeated_argument_error(command, "--output <OUTPUT>"))
            } else {
                output = Option::Some(args[index + 1]);
                index += 2;
            }
        } else if inline_cli_value(argument, "--output").is_some() {
            if option_string_empty(inline_cli_value(argument, "--output")) {
                return Result::Err(value_required_error("--output <OUTPUT>", Option::None))
            } else if output.is_some() {
                return Result::Err(repeated_argument_error(command, "--output <OUTPUT>"))
            } else {
                output = inline_cli_value(argument, "--output");
                index += 1;
            }
        } else {
            match similar_cli_argument(command, argument) {
                Some(similar) => return Result::Err(
                    unexpected_similar_argument_error(argument, similar, command_usage(command)),
                ),
                None => return Result::Err(unexpected_argument_error(command, argument, false)),
            }
        }
    }
    let missing: Vec[string] = Vec::new();
    if inputs.is_empty() {
        missing.push("--input <INPUT>...")
    }
    if entry.is_none() {
        missing.push("--entry <ENTRY>")
    }
    if output.is_none() {
        missing.push("--output <OUTPUT>")
    }
    if !missing.is_empty() {
        Result::Err(missing_required_arguments_error(command, missing))
    } else {
        Result::Ok(
            LinkCommandArgs {
                inputs,
                entry: entry.unwrap_or(""),
                output: output.unwrap_or(""),
                world: extracted.world,
            },
        )
    }
}

fn parse_test_link_command_args(args: Vec[string]) -> Result[TestLinkCommandArgs, string] {
    let extracted = extract_world_args(args)?;
    let args = extracted.args;
    let mut output: Option[string] = Option::None;
    let mut manifest: Option[string] = Option::None;
    let inputs: Vec[string] = Vec::new();
    let packages: Vec[string] = Vec::new();
    let mut index = 2;
    let mut positional = false;
    let command = args[1];
    while index < args.len() {
        let argument = args[index];
        if !positional && argument == "--" {
            positional = true;
            index += 1;
        } else if !positional && cli_help_argument(argument) {
            return Result::Err(cli_help_signal())
        } else if !positional && inline_cli_value(argument, "--help").is_some() {
            let value = inline_cli_value(argument, "--help").unwrap_or("");
            return Result::Err(
                unexpected_value_error_with_usage(
                    value,
                    "--help",
                    command_usage(command) + " --help",
                ),
            )
        } else if !positional && cli_value_option(command, argument) && index + 1 < args.len()
            && cli_option(args[index + 1])
            && !known_cli_option(command, args[index + 1]) {
            return Result::Err(
                unexpected_cli_option_error_with_usage(
                    command,
                    args[index + 1],
                    command_usage(command),
                ),
            )
        } else if positional {
            return Result::Err(unexpected_argument_error(command, argument, false))
        } else if argument == "--input" {
            index += 1;
            let previous_len = inputs.len();
            while index < args.len() && !cli_option(args[index]) {
                inputs.push(args[index]);
                index += 1;
            }
            if inputs.len() == previous_len {
                return Result::Err(value_required_error("--input <INPUT>...", Option::None))
            }
        } else if inline_cli_value(argument, "--input").is_some() {
            let value = inline_cli_value(argument, "--input").unwrap_or("");
            if value == "" {
                return Result::Err(value_required_error("--input <INPUT>...", Option::None))
            } else {
                inputs.push(value);
                index += 1;
                while index < args.len() && !cli_option(args[index]) {
                    inputs.push(args[index]);
                    index += 1;
                }
            }
        } else if argument == "--package" {
            if index + 1 >= args.len() || cli_option(args[index + 1]) {
                return Result::Err(value_required_error("--package <PACKAGE>", Option::None))
            } else {
                packages.push(args[index + 1]);
                index += 2;
            }
        } else if inline_cli_value(argument, "--package").is_some() {
            if let Some(value) = inline_cli_value(argument, "--package") {
                packages.push(value)
            }
            index += 1;
        } else if argument == "--output" {
            if index + 1 >= args.len() || cli_option(args[index + 1]) {
                return Result::Err(value_required_error("--output <OUTPUT>", Option::None))
            } else if output.is_some() {
                return Result::Err(repeated_argument_error(command, "--output <OUTPUT>"))
            } else {
                output = Option::Some(args[index + 1]);
                index += 2;
            }
        } else if inline_cli_value(argument, "--output").is_some() {
            if option_string_empty(inline_cli_value(argument, "--output")) {
                return Result::Err(value_required_error("--output <OUTPUT>", Option::None))
            } else if output.is_some() {
                return Result::Err(repeated_argument_error(command, "--output <OUTPUT>"))
            } else {
                output = inline_cli_value(argument, "--output");
                index += 1;
            }
        } else if argument == "--manifest" {
            if index + 1 >= args.len() || cli_option(args[index + 1]) {
                return Result::Err(value_required_error("--manifest <MANIFEST>", Option::None))
            } else if manifest.is_some() {
                return Result::Err(repeated_argument_error(command, "--manifest <MANIFEST>"))
            } else {
                manifest = Option::Some(args[index + 1]);
                index += 2;
            }
        } else if inline_cli_value(argument, "--manifest").is_some() {
            if option_string_empty(inline_cli_value(argument, "--manifest")) {
                return Result::Err(value_required_error("--manifest <MANIFEST>", Option::None))
            } else if manifest.is_some() {
                return Result::Err(repeated_argument_error(command, "--manifest <MANIFEST>"))
            } else {
                manifest = inline_cli_value(argument, "--manifest");
                index += 1;
            }
        } else {
            match similar_cli_argument(command, argument) {
                Some(similar) => return Result::Err(
                    unexpected_similar_argument_error(argument, similar, command_usage(command)),
                ),
                None => return Result::Err(unexpected_argument_error(command, argument, false)),
            }
        }
    }
    let missing: Vec[string] = Vec::new();
    if inputs.is_empty() {
        missing.push("--input <INPUT>...")
    }
    if packages.is_empty() {
        missing.push("--package <PACKAGE>")
    }
    if output.is_none() {
        missing.push("--output <OUTPUT>")
    }
    if manifest.is_none() {
        missing.push("--manifest <MANIFEST>")
    }
    if !missing.is_empty() {
        Result::Err(missing_required_arguments_error(command, missing))
    } else {
        Result::Ok(
            TestLinkCommandArgs {
                inputs,
                packages,
                output: output.unwrap_or(""),
                manifest: manifest.unwrap_or(""),
                world: extracted.world,
            },
        )
    }
}

fn ensure_parent(path_value: string) -> Result[(), string] {
    match path::parent(path_value) {
        Some(parent) => fs::create_dir_all(parent).map_err(|error| error.to_string()),
        None => Result::Ok(()),
    }
}

fn interface_output_path(output: string) -> string {
    path::with_extension(output, "interface")
}

fn core_output_path(output: string) -> string {
    path::with_extension(output, "core")
}
