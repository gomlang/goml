package main;

use module::core;
use module::artifact;
use std::env;
use std::fs;
use std::path;
use std::process;
use std::testing;
use std::utf8;
use utf8::BytesUtf8;

fn foreign_type_artifact_output(compiler: string, directory: string, mode: string, core: bool) -> Result[
    process::Output,
    string,
] {
    process::Command::new(compiler).args(
        Vec::from_array(
            [
                "__ffi-check-artifacts",
                if core {
                    "--core-path"
                } else {
                    "--interface-path"
                },
                path::join(
                    directory,
                    if core {
                        "calc.core"
                    } else {
                        "calc.interface"
                    },
                ),
                "--context",
                path::join(directory, "context.json"),
                "--caller-directory",
                path::join(directory, "gen"),
                "--caller-import-path",
                "example.com/host/gen",
                "--caller-mode",
                "package",
                "--caller-package",
                "gen",
                "--ffi-check",
                mode,
            ],
        ),
    ).current_dir(directory).output_structured().map_err(|error| error.to_string())
}

fn exercise_foreign_type_artifact_revalidation(directory: string) -> Result[(), string] {
    ffi_driver_fixture(directory)?;
    let compiler = path::absolute_structured(
        env::var_structured("GOML_TEST_GOMLC").unwrap_or("../stage2/bin/gomlc"),
    ).map_err(|error| error.to_string())?;
    let interface = external_type_interface(
        core::Type::External {
            import_path: "example.com/host/shim",
            name: "Numeric",
            args: Vec::from_array([core::Type::Bool]),
        },
    );
    write_artifact_interface(path::join(directory, "calc.interface"), interface)?;
    let core = artifact::ArtifactCoreUnit {
        source_origins: Vec::new(),
        external_applications: Vec::new(),
        foreign_types: Option::None,
        package_name: interface.package_name,
        declared_name: "api",
        interface_hash: interface.interface_hash,
        exports: interface.exports,
        core_ir: empty_core_file(),
        deps: Vec::new(),
        sources: Vec::new(),
        tests: Vec::new(),
    };
    write_artifact_core(path::join(directory, "calc.core"), core)?;
    for native_source in Vec::from_array(["package shim\n", "invalid Go source"]) {
        fs::write_file_structured(path::join(directory, "shim/shim.go"), native_source).map_err(
            |error| error.to_string(),
        )?;
        for core in Vec::from_array([false, true]) {
            for mode in Vec::from_array(["required", "off"]) {
                let output = foreign_type_artifact_output(compiler, directory, mode, core)?;
                if !output.status().success() {
                    return Result::Err(
                        output.stderr().to_string_utf8().unwrap_or(
                            "type artifact compatibility check failed",
                        ),
                    )
                }
            }
        }
    }
    fs::write_file_structured(path::join(directory, "calc.interface"), "invalid artifact").map_err(
        |error| error.to_string(),
    )?;
    for mode in Vec::from_array(["required", "off"]) {
        let output = foreign_type_artifact_output(compiler, directory, mode, false)?;
        testing::assert(!output.status().success());
    }
    Result::Ok(())
}

#[test]
fn foreign_type_artifacts_check_structure_without_native_revalidation() -> () {
    let temporary = temp_go_path("ffi-types.goml", "type-revalidation");
    let result = exercise_foreign_type_artifact_revalidation(path::parent(temporary).unwrap_or(""));
    cleanup_temp_directory(temporary);
    if let Err(error) = result {
        testing::fail(error)
    }
}
