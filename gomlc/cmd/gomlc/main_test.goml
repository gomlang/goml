#[test]
fn text_format_package_selection_preserves_transitive_dependencies() -> () {
    for source in[
        "use std::text::format; fn main() -> () {}",
        "use std::text; use std::text::format; fn main() -> () {}",
        "use std::text::format; use std::text; fn main() -> () {}",
    ] {
        let direct = source_standard_needs(ast::lower(parser::parse(source)));
        testing::assert(direct.text_format);
        testing::assert(direct.text);
        testing::assert(direct.num);
        testing::assert(direct.bytes);
        testing::assert(direct.io);
        for needs in[
            direct,
            merge_standard_needs(no_standard_needs(), direct),
            merge_standard_needs(direct, no_standard_needs()),
        ] {
            let selected = selected_standard_package_names(needs);
            for dependency in resources::standard_package_closure(
                Vec::from_array([resources::STD_TEXT_FORMAT_PACKAGE]),
            ) {
                testing::assert(selected.contains(dependency));
            }
            let mut count = 0;
            for name in selected {
                if name == resources::STD_TEXT_FORMAT_PACKAGE {
                    count += 1;
                }
            }
            testing::assert_eq(count, 1);
        }
    }
    testing::assert(!no_standard_needs().text_format);
    let parent = source_standard_needs(
        ast::lower(parser::parse("use std::text; fn main() -> () {}")),
    );
    testing::assert(!parent.text_format);
    testing::assert(
        !selected_standard_package_names(parent).contains(resources::STD_TEXT_FORMAT_PACKAGE),
    );
}

#[test]
fn immutable_collection_package_selection_preserves_transitive_dependencies() -> () {
    for source in[
        "use std::collections::imm; fn main() -> () {}",
        "use std::collections::imm as persistent; fn main() -> () {}",
        "use std::collections; use std::collections::imm; fn main() -> () {}",
        "use std::collections::imm; use std::collections; fn main() -> () {}",
    ] {
        let direct = source_standard_needs(ast::lower(parser::parse(source)));
        testing::assert(direct.collections_imm);
        testing::assert(direct.cmp);
        for needs in[
            direct,
            merge_standard_needs(no_standard_needs(), direct),
            merge_standard_needs(direct, no_standard_needs()),
            artifact_standard_needs_for_package(resources::STD_COLLECTIONS_IMM_PACKAGE),
        ] {
            let selected = selected_standard_package_names(needs);
            for dependency in resources::standard_package_closure(
                Vec::from_array([resources::STD_COLLECTIONS_IMM_PACKAGE]),
            ) {
                testing::assert(selected.contains(dependency));
            }
            let mut count = 0;
            for name in selected {
                if name == resources::STD_COLLECTIONS_IMM_PACKAGE {
                    count += 1;
                }
            }
            testing::assert_eq(count, 1);
        }
    }
    testing::assert(!no_standard_needs().collections_imm);
    let parent = source_standard_needs(
        ast::lower(parser::parse("use std::collections; fn main() -> () {}")),
    );
    testing::assert(!parent.collections_imm);
    testing::assert(
        !selected_standard_package_names(parent).contains(resources::STD_COLLECTIONS_IMM_PACKAGE),
    );
}

#[test]
fn structured_diagnostic_cli_renders_try_code_and_guidance() -> () {
    let source = "fn run(value: Result[i32, string]) -> Result[i32, i32] { Ok(value?) }";
    let checked = checker::check(hir::lower(ast::lower(parser::parse(source)), "main.goml"));
    testing::assert_eq(checked.diagnostics.len(), 1);
    let output = render_typer_diagnostics(checked.diagnostics, "main.goml", source);
    testing::assert(output.starts_with("error[typer/try_error_mismatch]:"));
    testing::assert(output.contains("secondary: main.goml:"));
    testing::assert(output.contains("note: `?` requires the same error type"));
    testing::assert(output.contains("help: Use `map_err`"));
}

#[test]
fn structured_diagnostic_cli_renders_reviewable_result_fix() -> () {
    let source = "fn run(value: Result[(), string]) -> () { value; }";
    let checked = checker::check(hir::lower(ast::lower(parser::parse(source)), "main.goml"));
    testing::assert_eq(checked.diagnostics.len(), 1);
    let output = render_typer_diagnostics(checked.diagnostics, "main.goml", source);
    testing::assert(output.starts_with("warning[typer/unused_result]:"));
    testing::assert(output.contains("suggestion[requires-review]: Explicitly ignore this Result"));
    testing::assert(output.contains("edit: main.goml:"));
    testing::assert(output.contains("replace with \"let _ = \""));
}
