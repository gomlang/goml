#[test]
fn stage_lowering_preserves_hidden_fresh_names() -> () {
    let source = "enum E { A(i32), B(i32), C(i32) } fn main() -> () { let value = E::B(1); match value { E::B(item) => (), _ => () } }";
    let stage = lower_core_stage("main.goml", source);
    testing::assert_eq(stage.counter.get(), 3)
}

#[test]
fn isolates_temporary_go_paths_for_identical_sources() -> () {
    let first = temp_go_path("main.goml", "package main");
    let second = temp_go_path("main.goml", "package main");
    let Some(first_directory) = path::parent(first) else {
        testing::fail("expected first temporary directory");
        return
    };
    let Some(second_directory) = path::parent(second) else {
        testing::fail("expected second temporary directory");
        return
    };
    testing::assert(first != second);
    testing::assert(first_directory != second_directory);
    testing::assert(fs::is_dir(first_directory));
    testing::assert(fs::is_dir(second_directory));
    cleanup_temp_directory(first);
    cleanup_temp_directory(second);
    testing::assert(!fs::is_dir(first_directory));
    testing::assert(!fs::is_dir(second_directory))
}

#[test]
fn publishes_stable_output_transaction_snapshots() -> () {
    let temporary = temp_go_path("output-transaction.goml", "stable");
    let Some(directory) = path::parent(temporary) else {
        testing::fail("expected output transaction directory");
        return
    };
    let anchor = path::join(directory, "package");
    let interface_path = path::join(directory, "package.interface");
    let core_path = path::join(directory, "package.core");
    if let Err(error) = output_transaction(
        anchor,
        || {
            atomic_write_text(interface_path, "interface")?;
            atomic_write_text(core_path, "core")
        },
    ) {
        testing::fail(error.to_string())
    }
    testing::assert(!fs::exists(output_lock_path(anchor)));
    let first_epoch = match fs::read_file_structured(output_epoch_path(anchor)) {
        Ok(value) => {
            testing::assert(value.starts_with("complete:"));
            value
        },
        Err(error) => {
            testing::fail(error.to_string());
            ""
        },
    };
    match output_snapshot(
        anchor,
        || Result::Ok(
            fs::read_file_structured(interface_path).map_err(|error| error.to_string())? + ":"
                + fs::read_file_structured(core_path).map_err(|error| error.to_string())?,
        ),
    ) {
        Ok(value) => testing::assert_eq(value, "interface:core"),
        Err(error) => testing::fail(error.to_string()),
    }
    if let Err(error) = output_transaction(anchor, || atomic_write_text(interface_path, "updated")) {
        testing::fail(error.to_string())
    }
    match fs::read_file_structured(output_epoch_path(anchor)) {
        Ok(value) => {
            testing::assert(value.starts_with("complete:"));
            testing::assert(value != first_epoch)
        },
        Err(error) => testing::fail(error.to_string()),
    }
    cleanup_temp_directory(temporary)
}

#[test]
fn rejects_and_repairs_incomplete_output_transactions() -> () {
    let temporary = temp_go_path("incomplete-output.goml", "incomplete");
    let Some(directory) = path::parent(temporary) else {
        testing::fail("expected incomplete output directory");
        return
    };
    let anchor = path::join(directory, "package");
    let output = path::join(directory, "package.interface");
    let failed: Result[(), string] = output_transaction(
        anchor,
        || {
            atomic_write_text(output, "partial")?;
            Result::Err("publication stopped")
        },
    );
    match failed {
        Ok(()) => testing::fail("incomplete transaction succeeded"),
        Err(error) => testing::assert_eq(error, "publication stopped"),
    }
    testing::assert(!fs::exists(output_lock_path(anchor)));
    match output_snapshot(
        anchor,
        || fs::read_file_structured(output).map_err(|error| error.to_string()),
    ) {
        Ok(_) => testing::fail("incomplete transaction was readable"),
        Err(error) => testing::assert(error.contains("incomplete output transaction")),
    }
    if let Err(error) = output_transaction(anchor, || atomic_write_text(output, "complete")) {
        testing::fail(error.to_string())
    }
    match output_snapshot(
        anchor,
        || fs::read_file_structured(output).map_err(|error| error.to_string()),
    ) {
        Ok(value) => testing::assert_eq(value, "complete"),
        Err(error) => testing::fail(error.to_string()),
    }
    cleanup_temp_directory(temporary)
}

fn args_with(values: Vec[string]) -> Vec[string] {
    let args = Vec::new();
    args.push("gomlc");
    args.push("run-single");
    for value in values {
        args.push(value)
    }
    args
}

fn version_args_with(values: Vec[string]) -> Vec[string] {
    let args = Vec::new();
    args.push("gomlc");
    args.push("version");
    for value in values {
        args.push(value)
    }
    args
}

fn command_args_with(command: string, values: Vec[string]) -> Vec[string] {
    let args = Vec::new();
    args.push("gomlc");
    args.push(command);
    for value in values {
        args.push(value)
    }
    args
}

fn parse_ok(values: Vec[string]) -> RunArgs {
    match parse_run_args(args_with(values)) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            parse_ok(Vec::new())
        },
    }
}

fn assert_parse_error(values: Vec[string], expected: string) -> () {
    match parse_run_args(args_with(values)) {
        Ok(_) => testing::fail("expected argument error"),
        Err(error) => testing::assert_eq(error, expected),
    }
}

fn core_function_index(value: core::File, expected: string) -> isize {
    let result = Ref::new(-1);
    for index in 0..value.functions.len() {
        if value.functions[index].name == expected {
            result.set(index)
        }
    }
    result.get()
}

#[test]
fn detects_single_file_entrypoint() -> () {
    let present = checker::check_for_link(
        hir::lower(ast::lower(parser::parse("fn main() -> () {}")), "main.goml"),
    );
    let missing = checker::check_for_link(
        hir::lower(ast::lower(parser::parse("fn helper() -> () {}")), "main.goml"),
    );
    testing::assert(has_single_file_entrypoint(present));
    testing::assert(!has_single_file_entrypoint(missing))
}

#[test]
fn links_reachable_functions_from_imported_standard_packages() -> () {
    let source = "use std::fs; use std::io; fn main() -> () { let _ = fs::write_file_structured(\"out.txt\", \"ok\"); io::println(\"done\") }";
    let compilation = compile_source("main.goml", source);
    let bytes = core_function_index(
        compilation.core_value,
        "inherent#std::bytes::Bytes#std::bytes::Bytes#from_string",
    );
    let fs = core_function_index(compilation.core_value, "std::fs::write_file_structured");
    let io = core_function_index(compilation.core_value, "std::io::println");
    let main = core_function_index(compilation.core_value, "main");
    testing::assert(bytes >= 0);
    testing::assert(fs >= 0);
    testing::assert(io >= 0);
    testing::assert(bytes < main);
    testing::assert(fs < main);
    testing::assert(io < main);
    testing::assert_eq(
        core_function_index(compilation.core_value, "std::fs::read_file_structured"),
        -1,
    );
    testing::assert_eq(core_function_index(compilation.core_value, "std::env::args"), -1)
}

#[test]
fn tracks_host_api_package_link_needs() -> () {
    let source = "package main; use std::path; use std::process; use std::testing; fn main() -> () {}";
    let needs = source_standard_needs(ast::lower(parser::parse(source)));
    testing::assert(needs.contains(resources::STD_BYTES_PACKAGE));
    testing::assert(needs.contains(resources::STD_PATH_PACKAGE));
    testing::assert(needs.contains(resources::STD_PROCESS_PACKAGE));
    testing::assert(needs.contains(resources::STD_TESTING_PACKAGE));
    testing::assert(!needs.contains(resources::STD_ROOT_PACKAGE));
    testing::assert(needs.contains(resources::STD_ASCII_PACKAGE));
    testing::assert(!needs.contains(resources::STD_CMP_PACKAGE));
    testing::assert(!needs.contains(resources::STD_COLLECTIONS_PACKAGE));
    testing::assert(needs.contains(resources::STD_ENV_PACKAGE));
    testing::assert(!needs.contains(resources::STD_FS_PACKAGE));
    testing::assert(needs.contains(resources::STD_IO_PACKAGE));
    testing::assert(!needs.contains(resources::STD_ITER_PACKAGE));
    testing::assert(!needs.contains(resources::STD_JSON_PACKAGE));
    testing::assert(needs.contains(resources::STD_NUM_PACKAGE));
    testing::assert(needs.contains(resources::STD_INTERNAL_TASK_PACKAGE));
    testing::assert(needs.contains(resources::STD_TASK_PACKAGE));
    testing::assert(needs.contains(resources::STD_TEXT_PACKAGE));
    testing::assert(needs.contains(resources::STD_TIME_PACKAGE))
}

#[test]
fn prunes_unreferenced_standard_core_functions_and_constants() -> () {
    let compilation = compile_source(
        "main.goml",
        "use std::env; fn main() -> () { println(env::args().len()); }",
    );
    testing::assert(core_function_index(compilation.core_value, "std::env::args") >= 0);
    testing::assert(
        core_function_index(compilation.core_value, "__goml_builtin_int_to_string") >= 0,
    );
    testing::assert_eq(
        core_function_index(compilation.core_value, "__goml_builtin_float64_to_string"),
        -1,
    );
    for constant in compilation.core_value.constants {
        testing::assert(!constant.name.starts_with("std::unicode::"))
    }
}

#[test]
fn tracks_json_package_link_needs() -> () {
    let source = "package main; use std::json; fn main() -> () { let _ = json::parse(\"null\"); () }";
    let needs = source_standard_needs(ast::lower(parser::parse(source)));
    testing::assert(needs.contains(resources::STD_ASCII_PACKAGE));
    testing::assert(needs.contains(resources::STD_BYTES_PACKAGE));
    testing::assert(needs.contains(resources::STD_JSON_PACKAGE));
    testing::assert(needs.contains(resources::STD_TEXT_PACKAGE));
    testing::assert(!needs.contains(resources::STD_ROOT_PACKAGE))
}

#[test]
