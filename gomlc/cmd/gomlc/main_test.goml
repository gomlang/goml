#[test]
fn tracks_ascii_and_iter_package_needs() -> () {
    let needs = source_standard_needs(
        ast::lower(parser::parse("package main; use std::ascii; use std::iter; fn main() -> () {}")),
    );
    testing::assert(needs.contains(resources::STD_ASCII_PACKAGE));
    testing::assert(needs.contains(resources::STD_ITER_PACKAGE));
    testing::assert(!needs.contains(resources::STD_ROOT_PACKAGE));
    testing::assert(!needs.contains(resources::STD_BYTES_PACKAGE));
    testing::assert(!needs.contains(resources::STD_CMP_PACKAGE));
    testing::assert(!needs.contains(resources::STD_TEXT_PACKAGE))
}

#[test]
fn tracks_cmp_and_collections_package_needs() -> () {
    let direct = source_standard_needs(
        ast::lower(parser::parse("package main; use std::cmp; fn main() -> () {}")),
    );
    testing::assert(direct.cmp);
    testing::assert(!direct.collections);
    let collections = source_standard_needs(
        ast::lower(parser::parse("package main; use std::collections; fn main() -> () {}")),
    );
    testing::assert(collections.cmp);
    testing::assert(collections.collections)
}

#[test]
fn parses_run_single_dump_flags() -> () {
    let values = Vec::new();
    values.push("--dump-go");
    values.push("main.goml");
    values.push("--dump-ast");
    values.push("--dump-expanded-ast");
    values.push("--dump-tast");
    values.push("--dump-ctir");
    values.push("--dump-core");
    values.push("--dump-mono");
    values.push("--dump-lift");
    values.push("--dump-anf");
    values.push("--dump-hir");
    let args = parse_ok(values);
    testing::assert_eq(args.file, "main.goml");
    testing::assert(args.dump_ast);
    testing::assert(args.dump_expanded_ast);
    testing::assert(args.dump_hir);
    testing::assert(args.dump_tast);
    testing::assert(args.dump_ctir);
    testing::assert(args.dump_core);
    testing::assert(args.dump_mono);
    testing::assert(args.dump_lift);
    testing::assert(args.dump_anf);
    testing::assert(args.dump_go)
}

#[test]
fn parses_run_single_without_dumps() -> () {
    let values = Vec::new();
    values.push("main.goml");
    let args = parse_ok(values);
    testing::assert_eq(args.file, "main.goml");
    testing::assert(!args.dump_ast);
    testing::assert(!args.dump_expanded_ast);
    testing::assert(!args.dump_hir);
    testing::assert(!args.dump_tast);
    testing::assert(!args.dump_ctir);
    testing::assert(!args.dump_core);
    testing::assert(!args.dump_mono);
    testing::assert(!args.dump_lift);
    testing::assert(!args.dump_anf);
    testing::assert(!args.dump_go)
}

#[test]
fn preserves_source_and_expanded_ast_views() -> () {
    let compilation = compile_source(
        "main.goml",
        "#[derive(PartialEq, Eq)] struct Key { value: isize } fn main() -> () { () }",
    );
    let source = ast::pretty(compilation.source_ast_value);
    let expanded = ast::pretty(compilation.ast_value);
    testing::assert(!source.contains("impl Eq for Key"));
    testing::assert(expanded.contains("impl PartialEq for Key"));
    testing::assert(expanded.contains("impl Eq for Key"))
}

#[test]
fn parses_version_formats() -> () {
    match parse_version_args(version_args_with(Vec::new())) {
        Ok(Text) => (),
        _ => testing::fail("expected default text version format"),
    }
    let json_args = Vec::new();
    json_args.push("--format");
    json_args.push("json");
    match parse_version_args(version_args_with(json_args)) {
        Ok(Json) => (),
        _ => testing::fail("expected json version format"),
    }
    let inline_args = Vec::new();
    inline_args.push("--format=text");
    match parse_version_args(version_args_with(inline_args)) {
        Ok(Text) => (),
        _ => testing::fail("expected inline text version format"),
    }
}

#[test]
fn parses_package_information_without_lowering_file_bodies() -> () {
    let source =
        \\// header
        \\package sample;
        \\use alpha::beta;
        \\use gamma::delta as other;
        \\use theta::api::{Thing, make as create,};
        \\fn main() -> () { let _ = "use hidden::path;"; }
    ;
    match parse_package_info_file("main.goml", source) {
        Ok(value) => {
            testing::assert_eq(value.package_name, "sample");
            testing::assert(value.package_explicit);
            testing::assert_eq(value.uses.len(), 3);
            testing::assert_eq(value.uses[0].path, "alpha::beta");
            match value.uses[0].alias {
                Some(alias) => testing::assert_eq(alias, "beta"),
                None => testing::fail("expected inferred use alias"),
            }
            testing::assert_eq(value.uses[1].path, "gamma::delta");
            match value.uses[1].alias {
                Some(alias) => testing::assert_eq(alias, "other"),
                None => testing::fail("expected use alias"),
            }
            testing::assert_eq(value.uses[2].path, "theta::api");
            testing::assert(value.uses[2].alias.is_none())
        },
        Err(error) => testing::fail(error.to_string()),
    }
    match parse_package_info_file("main.goml", "use alpha::;") {
        Err(error) => testing::assert_eq(
            error,
            "error[parser]: main.goml: expected a path segment after '::'",
        ),
        Ok(_) => testing::fail("expected package information error"),
    }
    match parse_package_info_file("main.goml", "use vendor::module as module; use module::local;") {
        Ok(value) => testing::assert_eq(value.uses[1].path, "module::local"),
        Err(error) => testing::fail(error.to_string()),
    }
}

#[test]
fn package_information_scanner_stops_at_the_first_body_token() -> () {
    let source =
        \\// header
        \\package main;
        \\use alpha::beta as value;
        \\fn main() -> () {}
    ;
    let scanner = new_package_info_scanner(source);
    package_info_skip_trivia(scanner);
    testing::assert(package_info_consume_keyword(scanner, "package"));
    match package_info_read_ident(scanner) {
        Some(value) => testing::assert_eq(value, "main"),
        None => testing::fail("expected package name"),
    }
    testing::assert(package_info_consume_text(scanner, ";"));
    testing::assert(package_info_consume_keyword(scanner, "use"));
    match package_info_parse_use(scanner, "main.goml") {
        Ok(value) => {
            testing::assert_eq(value.path, "alpha::beta");
            match value.alias {
                Some(alias) => testing::assert_eq(alias, "value"),
                None => testing::fail("expected use alias"),
            }
        },
        Err(error) => testing::fail(error.to_string()),
    }
    package_info_skip_trivia(scanner);
    testing::assert(package_info_at_keyword(scanner, "fn"));
    testing::assert(scanner.index.get() < source.byte_len())
}

#[test]
fn package_information_scanner_respects_keyword_boundaries() -> () {
    let scanner = new_package_info_scanner("package_name");
    testing::assert_eq(package_info_consume_keyword(scanner, "package"), false);
    let use_scanner = new_package_info_scanner("useful");
    testing::assert_eq(package_info_consume_keyword(use_scanner, "use"), false)
}

#[test]
fn reports_driver_protocol_version() -> () {
    testing::assert_eq(
        version_output_with(VersionFormat::Text, Option::None, Option::None),
        "gomlc " + version::current(),
    );
    testing::assert_eq(
        version_output_with(VersionFormat::Json, Option::None, Option::None),
        "{\"artifact_format\":18,\"compiler_abi\":" + wire::artifact_compiler_abi().to_string()
            + ",\"driver_protocol\":2,\"installed_world\":1,\"git_date\":null,\"git_hash\":null,\"tool\":\"gomlc\",\"version\":\""
            + version::current()
            + "\"}",
    );
    match parse_version_format("yaml") {
        Err(error) => testing::assert_eq(
            error,
            \\error: invalid value 'yaml' for '--format <FORMAT>'
            \\  [possible values: text, json]
            \\
            \\For more information, try '--help'.
            ,
        ),
        Ok(_) => testing::fail("expected invalid version format"),
    }
}

#[test]
fn suggests_similar_subcommands() -> () {
    testing::assert_eq(
        unknown_subcommand_error("chec"),
        \\error: unrecognized subcommand 'chec'
        \\
        \\  tip: a similar subcommand exists: 'check'
        \\
        \\Usage: gomlc <COMMAND>
        \\
        \\For more information, try '--help'.
        ,
    );
    testing::assert_eq(
        unknown_subcommand_error("unknown"),
        \\error: unrecognized subcommand 'unknown'
        \\
        \\Usage: gomlc <COMMAND>
        \\
        \\For more information, try '--help'.
        ,
    );
    testing::assert_eq(
        unknown_subcommand_error("xcheck"),
        \\error: unrecognized subcommand 'xcheck'
        \\
        \\  tip: some similar subcommands exist: 'test-check', 'check'
        \\
        \\Usage: gomlc <COMMAND>
        \\
        \\For more information, try '--help'.
        ,
    )
}

#[test]
fn parses_package_command_arguments() -> () {
    let values = Vec::new();
    values.push("--package");
    values.push("alice::app");
    values.push("--module");
    values.push("alice::workspace");
    values.push("--input");
    values.push("main.goml");
    values.push("extra.goml");
    values.push("main.goml");
    values.push("--interface-path");
    values.push("lib.interface");
    values.push("--output");
    values.push("artifact/package");
    values.push("--world");
    values.push("artifact/world.gaf");
    match parse_package_command_args(command_args_with("build", values)) {
        Ok(args) => {
            testing::assert_eq(args.package_name, "alice::app");
            testing::assert_eq(args.module_name, "alice::workspace");
            testing::assert_eq(args.inputs.len(), 2);
            testing::assert_eq(args.inputs[0], "extra.goml");
            testing::assert_eq(args.inputs[1], "main.goml");
            testing::assert_eq(args.interface_paths.len(), 1);
            testing::assert_eq(args.interface_paths[0], "lib.interface");
            testing::assert_eq(args.output, "artifact/package");
            match args.world {
                Some(value) => testing::assert_eq(value, "artifact/world.gaf"),
                None => testing::fail("expected compiler world"),
            }
        },
        Err(error) => testing::fail(error.to_string()),
    }
}

#[test]
fn parses_toolchain_package_capabilities() -> () {
    match parse_toolchain_build_args(
        Vec::from_array(
            [
                "gomlc",
                "__toolchain-build",
                "--builtin-contract",
                "--counter-output",
                "counter",
                "--package",
                "builtin",
                "--input",
                "contract.goml",
                "--output",
                "builtin",
            ],
        ),
    ) {
        Ok(value) => {
            testing::assert(value.builtin_contract);
            testing::assert_eq(value.command.package_name, "builtin");
            testing::assert_eq(value.command.module_name, "builtin")
        },
        Err(error) => testing::fail(error.to_string()),
    }
    match parse_toolchain_build_args(
        Vec::from_array(
            [
                "gomlc",
                "__toolchain-build",
                "--package",
                "builtin",
                "--input",
                "contract.goml",
                "--output",
                "builtin",
            ],
        ),
    ) {
        Ok(_) => testing::fail("builtin package compiled without capability"),
        Err(error) => testing::assert_eq(
            error,
            "package builtin requires builtin contract capability",
        ),
    }
}

#[test]
fn parses_link_command_arguments() -> () {
    let values = Vec::new();
    values.push("--input");
    values.push("lib.core");
    values.push("main.core");
    values.push("--output");
    values.push("artifact/main.go");
    values.push("--entry");
    values.push("alice::app");
    match parse_link_command_args(command_args_with("link", values)) {
        Ok(args) => {
            testing::assert_eq(args.inputs.len(), 2);
            testing::assert_eq(args.inputs[0], "lib.core");
            testing::assert_eq(args.inputs[1], "main.core");
            testing::assert_eq(args.entry, "alice::app");
            testing::assert_eq(args.output, "artifact/main.go")
        },
        Err(error) => testing::fail(error.to_string()),
    }
}

#[test]
fn parses_test_link_command_arguments() -> () {
    let values = Vec::new();
    values.push("--input");
    values.push("lib.core");
    values.push("first.core");
    values.push("second.core");
    values.push("--output");
    values.push("artifact/tests.go");
    values.push("--manifest");
    values.push("artifact/tests.json");
    values.push("--package");
    values.push("alice::first");
    values.push("--package");
    values.push("alice::second");
    match parse_test_link_command_args(command_args_with("test-link", values)) {
        Ok(args) => {
            testing::assert_eq(args.inputs.len(), 3);
            testing::assert_eq(args.packages.len(), 2);
            testing::assert_eq(args.packages[0], "alice::first");
            testing::assert_eq(args.packages[1], "alice::second");
            testing::assert_eq(args.output, "artifact/tests.go");
            testing::assert_eq(args.manifest, "artifact/tests.json")
        },
        Err(error) => testing::fail(error.to_string()),
    }
}

#[test]
fn adds_canonical_entry_wrapper() -> () {
    let functions = Vec::new();
    functions.push(
        core::Function {
            name: "alice::app::main",
            origin: core::FunctionOrigin::Source,
            root: true,
            generics: Vec::new(),
            predicates: Vec::new(),
            trait_impl: Option::None,
            params: Vec::new(),
            ret_ty: core::Type::Unit,
            body: core::Block {
                stmts: Vec::new(),
                tail: Option::Some(Prim { value: core::Primitive::Unit, ty: core::Type::Unit }),
            },
        },
    );
    let wrapped = add_entry_wrapper(
        core::File {
            functions,
            enums: Vec::new(),
            structs: Vec::new(),
            type_instances: Vec::new(),
            constants: Vec::new(),
            statics: Vec::new(),
        },
        "alice::app",
    );
    testing::assert_eq(wrapped.functions.len(), 2);
    testing::assert_eq(wrapped.functions[0].name, "alice::app::main");
    testing::assert_eq(wrapped.functions[1].name, "main");
    match wrapped.functions[1].body.tail {
        Some(Call { func: Var { name, ty: Func { params, ret_ty: Unit } }, args, ty: Unit }) => {
            testing::assert_eq(name, "alice::app::main");
            testing::assert_eq(params.len(), 0);
            testing::assert_eq(args.len(), 0)
        },
        _ => testing::fail("expected canonical entry call"),
    }
}

#[test]
fn rejects_invalid_run_single_arguments() -> () {
    assert_parse_error(
        Vec::new(),
        \\error: the following required arguments were not provided:
        \\  <FILE>
        \\
        \\Usage: gomlc run-single <FILE>
        \\
        \\For more information, try '--help'.
        ,
    );
    let unknown = Vec::new();
    unknown.push("--unknown");
    assert_parse_error(
        unknown,
        \\error: unexpected argument '--unknown' found
        \\
        \\  tip: to pass '--unknown' as a value, use '-- --unknown'
        \\
        \\Usage: gomlc run-single [OPTIONS] <FILE>
        \\
        \\For more information, try '--help'.
        ,
    );
    let multiple = Vec::new();
    multiple.push("one.goml");
    multiple.push("two.goml");
    assert_parse_error(
        multiple,
        \\error: unexpected argument 'two.goml' found
        \\
        \\Usage: gomlc run-single [OPTIONS] <FILE>
        \\
        \\For more information, try '--help'.
        ,
    )
}

#[test]
fn matches_cli_help_and_empty_value_semantics() -> () {
    let dump = Vec::new();
    dump.push("--dump-go");
    assert_parse_error(
        dump,
        \\error: the following required arguments were not provided:
        \\  <FILE>
        \\
        \\Usage: gomlc run-single --dump-go <FILE>
        \\
        \\For more information, try '--help'.
        ,
    );
    let version_help = Vec::new();
    version_help.push("--help");
    match parse_version_args(version_args_with(version_help)) {
        Err(error) => testing::assert(is_cli_help_signal(error)),
        Ok(_) => testing::fail("expected version help"),
    }
    let missing_format = Vec::new();
    missing_format.push("--format");
    missing_format.push("--help");
    match parse_version_args(version_args_with(missing_format)) {
        Err(error) => testing::assert_eq(
            error,
            \\error: a value is required for '--format <FORMAT>' but none was supplied
            \\  [possible values: text, json]
            \\
            \\For more information, try '--help'.
            ,
        ),
        Ok(_) => testing::fail("expected missing version format"),
    }
    let empty_package = Vec::new();
    empty_package.push("--package=");
    match parse_package_command_args(command_args_with("check", empty_package)) {
        Err(error) => testing::assert_eq(
            error,
            \\error: the following required arguments were not provided:
            \\  --input <INPUT>...
            \\  --output <OUTPUT>
            \\
            \\Usage: gomlc check --package <PACKAGE> --input <INPUT>... --output <OUTPUT>
            \\
            \\For more information, try '--help'.
            ,
        ),
        Ok(_) => testing::fail("expected missing package arguments"),
    }
    let empty_interface = Vec::new();
    empty_interface.push("--interface-path=");
    match parse_package_command_args(command_args_with("check", empty_interface)) {
        Err(error) => testing::assert_eq(
            error,
            \\error: a value is required for '--interface-path <INTERFACE_FILE>' but none was supplied
            \\
            \\For more information, try '--help'.
            ,
        ),
        Ok(_) => testing::fail("expected missing interface path"),
    }
    let short_help = Vec::new();
    short_help.push("-help");
    match parse_run_args(args_with(short_help)) {
        Err(error) => testing::assert(is_cli_help_signal(error)),
        Ok(_) => testing::fail("expected run help"),
    }
    let delimiter = Vec::new();
    delimiter.push("--");
    match parse_version_args(version_args_with(delimiter)) {
        Ok(Text) => (),
        _ => testing::fail("expected version delimiter"),
    }
    let unknown_format = Vec::new();
    unknown_format.push("--format");
    unknown_format.push("--wat");
    match parse_version_args(version_args_with(unknown_format)) {
        Err(error) => testing::assert_eq(
            error,
            \\error: unexpected argument '--wat' found
            \\
            \\Usage: gomlc version [OPTIONS]
            \\
            \\For more information, try '--help'.
            ,
        ),
        Ok(_) => testing::fail("expected unknown version argument"),
    }
    testing::assert_eq(cli_argument_name("--packagex=value"), "--packagex");
    match similar_cli_argument("check", "--outpu") {
        Some(argument) => testing::assert_eq(argument, "--output"),
        None => testing::fail("expected similar output argument"),
    }
}

#[test]
fn rejects_project_imports_in_single_file_mode() -> () {
    let source = "use std::io; use packages_basic::Lib; fn main() -> () {}";
    match single_file_project_import(ast::lower(parser::parse(source))) {
        Some(value) => testing::assert_eq(value, "packages_basic::Lib"),
        None => testing::fail("expected project import"),
    }
    if let Some(_) = single_file_project_import(
        ast::lower(parser::parse("use std::fs; use std::io; fn main() -> () {}")),
    ) {
        testing::fail("expected standard imports to be accepted")
    }
}

#[test]
fn requires_explicit_package_declarations_for_artifacts() -> () {
    let values = Vec::from_array([ast::lower(parser::parse("fn main() -> () {}"))]);
    match artifact_declared_package_name(values, Vec::from_array(["/tmp/main.goml"])) {
        Err(error) => testing::assert_eq(error, "/tmp/main.goml must declare `package <name>;`"),
        Ok(_) => testing::fail("expected package declaration error"),
    }
}

fn artifact_validate_entrypoint(
    package_name: string,
    declared_name: string,
    exports: artifact::ArtifactPackageExports,
) -> Result[(), string] {
    let diagnostics = artifact_entrypoint_diagnostics(package_name, declared_name, exports);
    if diagnostics.is_empty() {
        Result::Ok(())
    } else {
        Result::Err(diagnostics[0])
    }
}

#[test]
fn validates_artifact_main_entrypoints() -> () {
    let exports = interface_codec::empty_exports();
    match artifact_validate_entrypoint("example::app", "main", exports) {
        Err(error) => testing::assert_eq(error, "main function is required"),
        Ok(()) => testing::fail("expected missing main error"),
    }
    exports.functions.push(
        artifact::ArtifactFnScheme {
            comptime: tast::ComptimeCapability::RuntimeOnly,
            name: "example::app::main",
            type_params: Vec::from_array(["T"]),
            constraints: Vec::new(),
            ty: tast::Type::Func { params: Vec::new(), ret_ty: tast::Type::Unit },
            body: tast::Callable::Function("example::app::main"),
        },
    );
    match artifact_validate_entrypoint("example::app", "main", exports) {
        Err(error) => testing::assert_eq(error, "main function must not have type parameters"),
        Ok(()) => testing::fail("expected generic main error"),
    }
    let exports = interface_codec::empty_exports();
    exports.functions.push(
        artifact::ArtifactFnScheme {
            comptime: tast::ComptimeCapability::RuntimeOnly,
            name: "example::app::main",
            type_params: Vec::new(),
            constraints: Vec::new(),
            ty: tast::Type::Func {
                params: Vec::from_array([tast::Type::Int32]),
                ret_ty: tast::Type::Unit,
            },
            body: tast::Callable::Function("example::app::main"),
        },
    );
    match artifact_validate_entrypoint("example::app", "main", exports) {
        Err(error) => testing::assert_eq(error, "main function must not have parameters"),
        Ok(()) => testing::fail("expected parameterized main error"),
    }
    if let Err(error) = artifact_validate_entrypoint("example::lib", "lib", exports) {
        testing::fail(error.to_string())
    }
}

#[test]
fn collects_all_artifact_main_entrypoint_diagnostics() -> () {
    let exports = interface_codec::empty_exports();
    exports.functions.push(
        artifact::ArtifactFnScheme {
            comptime: tast::ComptimeCapability::RuntimeOnly,
            name: "example::app::main",
            type_params: Vec::from_array(["T"]),
            constraints: Vec::new(),
            ty: tast::Type::Func {
                params: Vec::from_array([tast::Type::Int32]),
                ret_ty: tast::Type::Unit,
            },
            body: tast::Callable::Function("example::app::main"),
        },
    );
    let diagnostics = artifact_entrypoint_diagnostics("example::app", "main", exports);
    testing::assert_eq(diagnostics.len(), 2);
    testing::assert_eq(diagnostics[0], "main function must not have type parameters");
    testing::assert_eq(diagnostics[1], "main function must not have parameters")
}

#[test]
fn rejects_explicit_builtin_and_prelude_imports() -> () {
    let values = Vec::from_array(
        [ast::lower(parser::parse("package main; use builtin; use prelude; fn main() -> () {}"))],
    );
    let diagnostics = standard_internal_import_diagnostics(
        values,
        Vec::from_array(["main.goml"]),
        "demo",
    );
    testing::assert_eq(diagnostics.len(), 2);
    testing::assert_eq(diagnostics[0].message, "package builtin is internal to the toolchain");
    testing::assert_eq(diagnostics[1].message, "package prelude is internal to the toolchain")
}

#[test]
fn renders_all_parser_diagnostics_with_spans() -> () {
    let source =
        \\fn main() {
        \\    let x 42;
        \\}
        \\
    ;
    let diagnostics = ast::lower(parser::parse(source)).diagnostics;
    testing::assert_eq(
        render_typer_diagnostics(
            ast_diagnostics(diagnostics, "parser", "main.goml"),
            "main.goml",
            source,
        ),
        \\error[parser]: expect "=", actual "int_lit"
        \\primary: main.goml:2:10
        \\2 |     let x 42;
        \\  |          ^
        ,
    )
}

#[test]
fn computes_crlf_diagnostic_positions_without_column_drift() -> () {
    let source = "fn main() {\r\n\t中\r\n}";
    let start = source_position(source, 14);
    testing::assert_eq(start.line, 1);
    testing::assert_eq(start.column, 1);
    testing::assert_eq(start.line_start, 13);
    testing::assert_eq(start.line_end, 17);
    let end = source_position(source, 17);
    testing::assert_eq(end.line, 1);
    testing::assert_eq(end.column, 2)
}

#[test]
fn package_information_identifies_foreign_declarations_without_literal_false_positives() -> () {
    testing::assert(
        source_declares_go_foreign(
            "package api; #[go_type(\"time\", \"Duration\")] extern type Duration;",
        ),
    );
    testing::assert(!source_declares_go_foreign("package api; fn text() -> string { \"go_type\" }"));
    testing::assert(
        source_declares_go_foreign(
            "package api; #[go_ffi(\"math\", \"Abs\")] extern fn abs(x: f64) -> f64;",
        ),
    );
    testing::assert(
        !source_declares_go_foreign(
            "package api; fn text() -> string { \"#[go_ffi(\\\"math\\\", \\\"Abs\\\")]\" }",
        ),
    );
    testing::assert(
        !source_declares_go_foreign(
            "package api; /* #[go_ffi(\"math\", \"Abs\")] extern fn fake() {} */ fn plain() -> () {}",
        ),
    )
}

#[test]
fn tracks_c_package_link_needs() -> () {
    let needs = source_standard_needs(ast::lower(parser::parse("use std::c; fn main() -> () {}")));
    testing::assert(needs.contains(resources::STD_C_PACKAGE));
    testing::assert(needs.contains(resources::STD_FFI_PACKAGE));
    testing::assert(needs.contains(resources::STD_BYTES_PACKAGE));
    testing::assert(needs.contains(resources::STD_UTF8_PACKAGE));
    testing::assert(selected_standard_package_names(needs).contains(resources::STD_C_PACKAGE));
}

#[test]
fn tracks_ffi_package_link_needs() -> () {
    let source = "package main; use std::ffi; fn main() -> () {}";
    let needs = source_standard_needs(ast::lower(parser::parse(source)));
    testing::assert(needs.contains(resources::STD_FFI_PACKAGE));
    testing::assert(!needs.contains(resources::STD_ROOT_PACKAGE));
    testing::assert(!needs.contains(resources::STD_INTERNAL_HOST_PACKAGE));
    let names = selected_standard_package_names(needs);
    testing::assert(names.contains(resources::STD_FFI_PACKAGE));
    testing::assert(needs.contains(resources::STD_BYTES_PACKAGE));
    testing::assert(needs.contains(resources::STD_UTF8_PACKAGE))
}

