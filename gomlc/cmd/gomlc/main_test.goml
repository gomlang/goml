#[test]
fn memory_filesystem_package_selection_preserves_transitive_dependencies() -> () {
    for source in[
        "package main; use std::testing::fs as memory; fn main() -> () {}",
        "package main; use std::fs; use std::testing::fs as memory; fn main() -> () {}",
        "package main; use std::testing::fs as memory; use std::fs; fn main() -> () {}",
    ] {
        let direct = source_standard_needs(ast::lower(parser::parse(source)));
        testing::assert(direct.testing_fs);
        for needs in[
            direct,
            merge_standard_needs(no_standard_needs(), direct),
            merge_standard_needs(direct, no_standard_needs()),
        ] {
            let selected = selected_standard_package_names(needs);
            for dependency in resources::standard_package_closure(
                Vec::from_array([resources::STD_TESTING_FS_PACKAGE]),
            ) {
                testing::assert(selected.contains(dependency));
            }
            let mut count = 0;
            for package_name in selected {
                if package_name == resources::STD_TESTING_FS_PACKAGE {
                    count += 1;
                }
            }
            testing::assert_eq(count, 1);
        }
    }
    testing::assert(!no_standard_needs().testing_fs);
    let ordinary = source_standard_needs(
        ast::lower(parser::parse("use std::fs; use std::testing; fn main() -> () {}")),
    );
    testing::assert(!ordinary.testing_fs);
    testing::assert(
        !selected_standard_package_names(ordinary).contains(resources::STD_TESTING_FS_PACKAGE),
    );
}

