package main;

use module::test_support;
use std::fs;
use std::path;
use std::process;
use std::testing;
use std::utf8;
use utf8::BytesUtf8;

fn private_proof_check(directory: string, consumer: bool) -> Result[process::Output, string] {
    let name = if consumer {
        "consumer"
    } else {
        "api"
    };
    let args = Vec::from_array(
        [
            "check",
            "--package",
            "proof::" + name,
            "--module",
            "proof",
            "--input",
            path::join(directory, name + ".goml"),
            "--output",
            path::join(directory, name),
        ],
    );
    if consumer {
        args.push("--interface-path");
        args.push(path::join(directory, "api.interface"));
    }
    test_support::compiler_command(args)?.current_dir(directory).output_structured().map_err(
        |error| error.to_string(),
    )
}

fn exercise_private_proof_visibility(directory: string) -> Result[(), string] {
    fs::create_dir_all(directory).map_err(|error| error.to_string())?;
    fs::write_file_structured(
        path::join(directory, "api.goml"),
        "package api; trait Hidden { fn secret(self: Self) -> i32; } impl Hidden for i32 { fn secret(self: i32) -> i32 { self } } pub trait Public: Hidden {} impl Public for i32 {} pub fn echo[T: Hidden](value: T) -> i32 { value.secret() } pub fn opaque() -> impl Hidden { let value: i32 = 7; value }",
    ).map_err(|error| error.to_string())?;
    let output = private_proof_check(directory, false)?;
    if !output.status().success() {
        return Err(output.stderr().to_string_utf8().unwrap_or("provider failed"))
    }
    for body in[
        "fn ok() -> i32 { let value: i32 = 7; api::echo(value) }",
        "fn ok[T: api::Public](value: T) -> i32 { api::echo(value) }",
        "fn ok() -> i32 { api::echo(api::opaque()) }",
        "fn bad() -> i32 { api::echo(true) }",
        "fn bad[T: api::Hidden](value: T) -> () {}",
        "fn bad[T](value: T) -> () where T: api::Hidden {}",
        "type Bad = dyn api::Hidden; fn bad() -> () {}",
        "fn bad[T: api::Public](value: T) -> i32 { value.secret() }",
        "fn bad[T: api::Public](value: T) -> i32 { T::secret(value) }",
        "fn bad(value: i32) -> i32 { api::Hidden::secret(value) }",
        "fn bad() -> i32 { api::opaque().secret() }",
    ] {
        fs::write_file_structured(
            path::join(directory, "consumer.goml"),
            "package consumer; use proof::api; " + body,
        ).map_err(|error| error.to_string())?;
        let output = private_proof_check(directory, true)?;
        if output.status().success() != body.starts_with("fn ok") {
            return Err(
                body + ": " + output.stderr().to_string_utf8().unwrap_or("unexpected check result"),
            )
        }
    }
    Ok(())
}

#[test]
fn private_trait_proofs_do_not_publish_private_methods_or_names() -> () {
    let temporary = temp_go_path("private-proof.goml", "visibility");
    let result = exercise_private_proof_visibility(path::parent(temporary).unwrap_or(""));
    cleanup_temp_directory(temporary);
    if let Err(message) = result {
        testing::fail(message);
    }
}
