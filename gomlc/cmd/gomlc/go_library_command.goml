package main;

use module::compiler::{COMPILE_ERROR_PREFIX, artifact_reachable_core_units, artifact_read_core_units, fail, go_library_api, link_go_library_core, linked_source_origins, lower_anf_stage, lower_linked_with_source_names, package_world, read_package_world_lazy, validate_interface_bridge_units};
use module::go_backend;
use module::lift;
use std::fs;
use std::path;
use std::json;

struct GoLibraryCommand {
    inputs: Vec[string],
    package_name: string,
    go_package: string,
    output: string,
    api_output: Option[string],
    world: Option[string],
}

fn parse_go_library_command(args: Vec[string]) -> Result[GoLibraryCommand, string] {
    let values: HashMap[string, string] = HashMap::new();
    let inputs: Vec[string] = Vec::new();
    let mut index = 2;
    while index < args.len() {
        let option = args[index];
        if option != "--input" && option != "--package" && option != "--go-package"
            && option != "--output"
            && option != "--world"
            && option != "--api-output" {
            return Err("Go library: unknown option " + option)
        }
        if index + 1 >= args.len() || args[index + 1] == "" || args[index + 1].starts_with("--") {
            return Err("Go library: missing value for " + option)
        }
        let value = args[index + 1];
        if option == "--input" {
            if inputs.contains(value) {
                return Err("Go library: duplicate input " + value)
            }
            inputs.push(value)
        } else {
            if values[option].is_some() {
                return Err("Go library: repeated option " + option)
            }
            values[option] = value;
        }
        index += 2;
    }
    if inputs.is_empty() {
        return Err("Go library: --input is required")
    }
    let go_package = values["--go-package"].ok_or("Go library: --go-package is required")?;
    if !go_backend::library_package_name_is_valid(go_package) {
        return Err("Go library: invalid Go package name " + go_package)
    }
    if let Some(api_output) = values["--api-output"] {
        if let Some(output) = values["--output"] {
            if path::absolute_structured(api_output).map_err(|error| error.to_string())?
                == path::absolute_structured(output).map_err(|error| error.to_string())? {
                return Err("Go library: API output must differ from Go output")
            }
        }
    }
    Ok(
        GoLibraryCommand {
            inputs,
            package_name: values["--package"].ok_or("Go library: --package is required")?,
            go_package,
            output: values["--output"].ok_or("Go library: --output is required")?,
            world: values["--world"],
            api_output: values["--api-output"],
        },
    )
}

fn emit_go_library_command(command: GoLibraryCommand) -> Result[(), string] {
    let world = match command.world {
        Some(path) => read_package_world_lazy(path, true)?,
        None => package_world(),
    };
    let units = artifact_reachable_core_units(
        Vec::from_array([command.package_name]),
        artifact_read_core_units(command.inputs)?,
    )?;
    validate_interface_bridge_units(Vec::new(), units)?;
    let linked = link_go_library_core(world, units, command.package_name)?;
    let source_names = Vec::new();
    let mono_value = lower_linked_with_source_names(linked.core_value, source_names)?;
    let lifted_sources = Vec::new();
    let lifted = lift::lower_checked_with_source_names(mono_value, world.counter, lifted_sources)?;
    let anf_value = lower_anf_stage(lift::dce(lifted), world.counter);
    let declarations: Vec[(string, string)] = Vec::new();
    for exported in linked.exports {
        declarations.push((exported.symbol, exported.go_name))
    }
    let generated = go_backend::lower_library_with_source_names(anf_value, declarations)?;
    let metadata = linked_source_origins(
        units,
        source_names,
        lifted_sources,
        generated.source_names,
    );
    let output = go_backend::encode_package(
        go_backend::embed_source_origins(generated.file, metadata),
        command.go_package,
    );
    let api = go_library_api(linked.exports)?;
    fs::write_file_structured(command.output, output).map_err(|error| error.to_string())?;
    if let Some(api_output) = command.api_output {
        fs::write_file_structured(api_output, json::encode(api) + "\n").map_err(
            |error| error.to_string(),
        )?
    }
    Ok(())
}

fn run_go_library_command(args: Vec[string]) -> () {
    match parse_go_library_command(args).and_then(|command| emit_go_library_command(command)) {
        Ok(()) => (),
        Err(message) => fail(COMPILE_ERROR_PREFIX + message),
    }
}
