package main;

use module::artifact;
use module::artifact::interface_codec;
use module::core;
use module::tast;
use std::fs;
use std::path;
use std::testing;

fn imported_bridge_constructor() -> tast::Type {
    Func {
        params: Vec::from_array(
            [
                Func {
                    params: Vec::from_array([tast::Type::MutSlice { elem: tast::Type::Uint8 }]),
                    ret_ty: tast::Type::Tuple {
                        items: Vec::from_array(
                            [Int, External { import_path: "", name: "error", args: Vec::new() }],
                        ),
                    },
                },
            ],
        ),
        ret_ty: tast::Type::External { import_path: "io", name: "Reader", args: Vec::new() },
    }
}

fn write_imported_bridge_units(directory: string, method: string, valid_signature: bool) -> Result[
    (),
    string,
] {
    let ty = if valid_signature {
        imported_bridge_constructor()
    } else {
        Func {
            params: Vec::new(),
            ret_ty: tast::Type::External { import_path: "io", name: "Reader", args: Vec::new() },
        }
    };
    let binding = "audit::value::bridge";
    let callable = tast::Callable::GoInterfaceBridge { binding, methods: Vec::from_array([method]) };
    let exports = interface_codec::empty_exports();
    exports.functions.push(
        artifact::ArtifactFnScheme {
            name: binding,
            comptime: tast::ComptimeCapability::RuntimeOnly,
            type_params: Vec::new(),
            constraints: Vec::new(),
            ty,
            body: callable,
        },
    );
    let interface = interface_codec::new_unit(
        "audit::value",
        exports,
        artifact::ArtifactPackageInterface {
            package_name: "audit::value",
            name: "value",
            value_exports: Vec::new(),
            enum_variants: Vec::new(),
        },
        Vec::new(),
    );
    write_artifact_interface(path::join(directory, "calc.interface"), interface)?;
    let core_ty = core::lower_type(ty);
    let file = empty_core_file();
    file.functions.push(
        core::Function {
            name: "audit::value::hidden",
            origin: core::FunctionOrigin::Source,
            root: false,
            generics: Vec::new(),
            predicates: Vec::new(),
            trait_impl: Option::None,
            params: Vec::new(),
            ret_ty: core_ty,
            body: core::Block {
                stmts: Vec::new(),
                tail: Option::Some(
                    Block {
                        ty: core_ty,
                        block: core::Block {
                            stmts: Vec::new(),
                            tail: Option::Some(
                                Callable { callable: core::lower_callable(callable), ty: core_ty },
                            ),
                        },
                    },
                ),
            },
        },
    );
    write_artifact_core(
        path::join(directory, "calc.core"),
        artifact::ArtifactCoreUnit {
            source_origins: Vec::new(),
            package_name: "audit::value",
            declared_name: "value",
            interface_hash: interface.interface_hash,
            exports: interface_codec::empty_exports(),
            core_ir: file,
            deps: Vec::new(),
            sources: Vec::new(),
            tests: Vec::new(),
        },
    )
}

fn exercise_imported_bridge_validation(directory: string) -> Result[(), string] {
    let directory = path::absolute_structured(directory).map_err(|error| error.to_string())?;
    fs::create_dir_all(path::join(directory, "gen")).map_err(|error| error.to_string())?;
    for variant in 0..3 {
        write_imported_bridge_units(
            directory,
            if variant == 1 {
                "Write"
            } else {
                "Read"
            },
            variant != 2,
        )?;
        let interface_result = artifact_read_interface_unit(path::join(directory, "calc.interface")).and_then(
            |unit| validate_interface_bridge_units(Vec::from_array([unit]), Vec::new()),
        );
        let core_result = artifact_read_core_unit(path::join(directory, "calc.core")).and_then(
            |unit| validate_interface_bridge_units(Vec::new(), Vec::from_array([unit])),
        );
        for result in Vec::from_array([interface_result, core_result]) {
            if variant != 2 {
                result?;
            } else {
                match result {
                    Ok(()) => return Result::Err("malformed imported bridge unexpectedly passed"),
                    Err(error) => testing::assert(error.contains("bridge")),
                }
            }
        }
    }
    Result::Ok(())
}

#[test]
fn go_interface_bridge_imports_preserve_explicit_signatures_without_metadata() -> () {
    let temporary = temp_go_path("interface-import.goml", "bridge-validation");
    let result = exercise_imported_bridge_validation(path::parent(temporary).unwrap_or(""));
    cleanup_temp_directory(temporary);
    if let Err(error) = result {
        testing::fail(error)
    }
}
