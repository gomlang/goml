package main;

use module::ffi;
use std::bytes;
use std::process;
use std::time;
use std::utf8;
use utf8::BytesUtf8;

fn run_foreign_function_queries_with_overlay(
    helper: string,
    context: ffi::GoBuildContext,
    caller: ffi::CallerContext,
    queries: Vec[ffi::FunctionQuery],
    overlay: Option[ffi::SourceOverlay],
) -> Result[ffi::FunctionQueries, string] {
    if queries.is_empty() {
        return Result::Ok(
            ffi::FunctionQueries {
                metadata: ffi::TypeDeclarations {
                    go_world_identity: "",
                    declarations: Vec::new(),
                    nodes: HashMap::new(),
                },
                functions: Vec::new(),
            },
        )
    }
    let input = ffi::with_source_overlay(
        ffi::encode_function_queries(context, caller, queries)?,
        overlay,
    )?;
    let output = process::Command::new(helper).arg("--timeout=2m").current_dir(context.module_dir).input(
        bytes::Bytes::from_string(input),
    ).output_timeout_structured(time::Duration::from_milliseconds(125000)).map_err(
        |error| "ffi-tool-unavailable: " + error.to_string(),
    )?;
    if output.stdout().len() > 8388608 || output.stderr().len() > 8388608 {
        return Result::Err("ffi-protocol: helper function output exceeds limit")
    }
    let response = output.stdout().to_string_utf8().map_err(
        |_| "ffi-protocol: invalid UTF-8 function response",
    )?;
    if response == "" {
        return Result::Err("ffi-tool-unavailable: helper returned no function response")
    }
    let result = ffi::decode_function_queries(response, queries)?;
    if !output.status().success() {
        return Result::Err("ffi-protocol: function success with failing helper status")
    }
    Result::Ok(result)
}

fn run_foreign_function_queries(
    helper: string,
    context: ffi::GoBuildContext,
    caller: ffi::CallerContext,
    queries: Vec[ffi::FunctionQuery],
) -> Result[ffi::FunctionQueries, string] {
    run_foreign_function_queries_with_overlay(helper, context, caller, queries, Option::None)
}
