package main;

use module::ffi;
use std::fs;
use std::path;
use std::testing;

fn exercise_foreign_source_locations(directory: string) -> Result[(), string] {
    let file = path::join(directory, "declaration.gom");
    fs::create_dir_all(directory).map_err(|error| error.to_string())?;
    fs::write_file_structured(
        file,
        "package calc;\n\n#[go_ffi(\"math\", \"Abs\")]\nextern fn local_name(value: f64) -> f64;\n",
    ).map_err(|error| error.to_string())?;
    let binding = ffi::ForeignBinding {
        call_mode: ffi::ForeignCallMode::Ordinary,
        binding_id: "demo::calc:demo::calc::local_name",
        import_path: "math",
        symbol: "Abs",
        parameters: Vec::from_array([ffi::BridgeType::Scalar("float64")]),
        results: Vec::from_array([ffi::BridgeType::Scalar("float64")]),
    };
    let bindings = Vec::from_array([binding]);
    let locations = foreign_source_locations("demo::calc", Vec::from_array([file]), bindings);
    let location = locations[binding.binding_id].ok_or("missing foreign source location")?;
    testing::assert(location.contains(file + ":4:11-4:21"));
    testing::assert(location.contains("arg0 = value"));
    testing::assert(location.contains("result0 = GoML return 1"));
    testing::assert(location.contains("Go target: math.Abs"));
    testing::assert(
        foreign_source_locations("another::calc", Vec::from_array([file]), bindings)[binding.binding_id].is_none(),
    );
    fs::remove_file(file).map_err(|error| error.to_string())?;
    testing::assert(
        foreign_source_locations("demo::calc", Vec::from_array([file]), bindings)[binding.binding_id].is_none(),
    );
    Result::Ok(())
}

#[test]
fn foreign_diagnostics_map_names_and_spans_by_package_identity() -> () {
    let temporary = temp_go_path("ffi-source.gom", "locations");
    let result = exercise_foreign_source_locations(path::parent(temporary).unwrap_or(""));
    cleanup_temp_directory(temporary);
    match result {
        Ok(()) => (),
        Err(message) => testing::fail(message),
    }
}
