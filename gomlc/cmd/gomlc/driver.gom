const COMPILE_ERROR_PREFIX: string = "error[compile]: ";

const TYPER_STAGE: string = "typer";

const INFERENCE_FAILURE_MESSAGE: string = "Could not infer type";

const UNKNOWN_SOURCE_PATH: string = "<unknown>";

pub struct Compilation {
    pub source_ast_value: ast::LowerResult,
    pub ast_value: ast::LowerResult,
    pub hir_value: hir::LowerResult,
    pub tast_value: tast::CheckResult,
    pub core_value: core::File,
    pub mono_value: mono::File,
    pub lift_value: lift::File,
    pub anf_value: anf::File,
    pub go_value: go_backend::File,
}

pub enum SourceCompilation {
    Compiled(Compilation),
    Diagnostics(string),
}

struct PackageCompilation {
    hir_file: hir::File,
    core_value: core::File,
    interface_unit: artifact::ArtifactInterfaceUnit,
    exports: artifact::ArtifactPackageExports,
}

struct DiagnosticPosition {
    line: isize,
    column: isize,
    line_start: isize,
    line_end: isize,
}

struct StandardLibrary {
    packages: Vec[PackageCompilation],
}

pub struct SourceCompiler {
    counter_start: isize,
    builtin_files: Vec[hir::File],
    builtins: core::File,
    builtin_interface: artifact::ArtifactInterfaceUnit,
    prelude: PackageCompilation,
    standard: Option[StandardLibrary],
}

struct ToolchainPackage {
    core_value: core::File,
    interface_unit: artifact::ArtifactInterfaceUnit,
    environment_exports: artifact::ArtifactPackageExports,
}

fn lower_builtin_core(counter: Ref[isize]) -> core::File {
    let checked = tast::check_builtin_package_files(builtin_hir_files());
    lower_checked_builtin_core(checked, counter)
}

fn lower_checked_builtin_core(checked: tast::CheckResult, counter: Ref[isize]) -> core::File {
    if checked.tast.is_some() {
        core::lower_with_counter(checked, counter)
    } else {
        fail(COMPILE_ERROR_PREFIX + "failed to typecheck builtin package");
        core::File {
            functions: Vec::new(),
            enums: Vec::new(),
            structs: Vec::new(),
            type_instances: Vec::new(),
            constants: Vec::new(),
            statics: Vec::new(),
        }
    }
}

fn lower_go_or_fail(value: Result[go_backend::File, string]) -> go_backend::File {
    match value {
        Ok(file) => file,
        Err(error) => {
            fail(COMPILE_ERROR_PREFIX + error);
            go_backend::File { items: Vec::new() }
        },
    }
}

fn artifact_standard_package_from_compilation(value: PackageCompilation) -> ToolchainPackage {
    ToolchainPackage {
        core_value: value.core_value,
        interface_unit: value.interface_unit,
        environment_exports: value.exports,
    }
}

fn artifact_standard_packages(value: StandardLibrary) -> Vec[ToolchainPackage] {
    let result = Vec::new();
    for compilation in value.packages {
        result.push(artifact_standard_package_from_compilation(compilation))
    }
    result
}

fn import_path_text(value: ast::Path) -> string {
    let builder = text::StringBuilder::new();
    let mut index = 0;
    for segment in value.segments {
        if index > 0 {
            builder.write_string("::")
        }
        builder.write_string(segment.ident);
        index += 1;
    }
    builder.finish()
}

fn std_import(value: string) -> bool {
    value == resources::STD_ROOT_PACKAGE || value.starts_with(resources::STD_PACKAGE_PREFIX)
}

fn single_file_project_import(value: ast::LowerResult) -> Option[string] {
    match value.ast {
        Some(file) => {
            for use_decl in file.uses {
                let package_path = import_path_text(use_decl.path);
                if !std_import(package_path) {
                    return Option::Some(package_path)
                }
            }
            Option::None
        },
        None => Option::None,
    }
}

fn imports_package(value: ast::LowerResult, expected: string) -> bool {
    match value.ast {
        Some(file) => {
            for use_decl in file.uses {
                if import_path_text(use_decl.path) == expected {
                    return true
                }
            }
            false
        },
        None => false,
    }
}

fn dependency_enums(builtins: core::File, dependencies: Vec[core::File]) -> Vec[tast::EnumDef] {
    let result: Vec[tast::EnumDef] = Vec::new();
    for value in builtins.enums {
        result.push(core::enum_def_to_tast(value))
    }
    for dependency in dependencies {
        for value in dependency.enums {
            result.push(core::enum_def_to_tast(value))
        }
    }
    result
}

fn dependency_structs(builtins: core::File, dependencies: Vec[core::File]) -> Vec[tast::StructDef] {
    let result: Vec[tast::StructDef] = Vec::new();
    for value in builtins.structs {
        result.push(core::struct_def_to_tast(value))
    }
    for dependency in dependencies {
        for value in dependency.structs {
            result.push(core::struct_def_to_tast(value))
        }
    }
    result
}

fn toolchain_dependency_environments(hir_dependencies: Vec[hir::File]) -> Vec[
    tast::DependencyEnvironment,
] {
    let result: Vec[tast::DependencyEnvironment] = Vec::new();
    let builtin_files: Vec[hir::File] = Vec::new();
    for dependency in hir_dependencies {
        if dependency.package_name == "builtin" {
            builtin_files.push(dependency)
        } else {
            match tast::dependency_environments(Vec::from_array([dependency])) {
                Ok(environments) => for environment in environments {
                    result.push(environment)
                },
                Err(error) => fail("error[compile]: " + error),
            }
        }
    }
    if !builtin_files.is_empty() {
        match tast::builtin_dependency_environment(builtin_files) {
            Ok(environment) => result.push(environment),
            Err(error) => fail("error[compile]: " + error),
        }
    }
    result
}

fn compile_toolchain_package(
    sources: Vec[resources::Source],
    module_name: string,
    package_name: string,
    declared_name: string,
    hir_dependencies: Vec[hir::File],
    core_dependencies: Vec[core::File],
    builtins: core::File,
    deps: Vec[(string, string)],
) -> PackageCompilation {
    let ast_values: Vec[ast::LowerResult] = Vec::new();
    let inputs: Vec[(ast::LowerResult, string)] = Vec::new();
    for source in sources {
        let ast_value = ast::resolve_module_paths(
            ast::lower(parser::parse(source.source)),
            module_name,
        );
        ast_values.push(ast_value);
        inputs.push((ast_value, source.path))
    }
    let public_names = public_item_names(ast_values, package_name);
    let hir_files: Vec[hir::File] = Vec::new();
    for lowered in hir::lower_package_files(inputs, package_name) {
        if !lowered.diagnostics.is_empty() {
            fail(
                "error[compile]: failed to lower " + package_name + " source " + lowered.source_path,
            )
        }
        match lowered.hir {
            Some(file) => hir_files.push(file),
            None => fail(
                "error[compile]: missing " + package_name + " source " + lowered.source_path,
            ),
        }
    }
    let hir_file = merge_hir_files(hir_files, package_name);
    let public_reexports = if package_name == "prelude" {
        let values: Vec[(string, string)] = Vec::new();
        for name in resources::prelude_builtin_export_names() {
            values.push((name, name))
        }
        values
    } else {
        hir_file.public_reexports
    };
    let tast_value = tast::check_package_files_for_link_with_environments(
        hir_files,
        toolchain_dependency_environments(hir_dependencies),
    );
    fail_on_typer_diagnostics(tast_value.diagnostics, hir_file.source_path, "");
    let signatures = match tast::package_signatures(hir_file) {
        Ok(value) => value,
        Err(error) => {
            fail("error[compile]: " + error);
            tast::PackageSignatures {
                traits: Vec::new(),
                functions: Vec::new(),
                type_aliases: Vec::new(),
                constants: Vec::new(),
            }
        },
    };
    let comptime_module = tast_value.comptime;
    let tast_file = match tast_value.tast {
        Some(value) => value,
        None => {
            fail("error[compile]: missing typed package " + package_name);
            tast::File {
                items: Vec::new(),
                enums: Vec::new(),
                structs: Vec::new(),
                constants: Vec::new(),
                statics: Vec::new(),
            }
        },
    };
    let enum_names: Vec[string] = Vec::new();
    for definition in dependency_enums(builtins, core_dependencies) {
        enum_names.push(definition.name)
    }
    let struct_names: Vec[string] = Vec::new();
    for definition in dependency_structs(builtins, core_dependencies) {
        struct_names.push(definition.name)
    }
    let public_exports = required_artifact_package_exports(
        tast_file,
        signatures,
        package_name,
        public_names,
        public_reexports,
        true,
        enum_names,
        struct_names,
    );
    let exports = required_artifact_package_exports(
        tast_file,
        signatures,
        package_name,
        public_names,
        public_reexports,
        false,
        enum_names,
        struct_names,
    );
    let interface_unit = interface_codec::new_unit_with_comptime(
        package_name,
        public_exports,
        artifact_package_interface(package_name, declared_name, public_exports),
        artifact_comptime_unit(comptime_module, public_exports),
        deps,
    );
    let core_value = core::eliminate_dead_locals(
        core::lower_with_counter_types_and_options(
            tast_value,
            Ref::new(0),
            dependency_enums(builtins, core_dependencies),
            dependency_structs(builtins, core_dependencies),
            true,
        ),
    );
    PackageCompilation { hir_file, core_value, interface_unit, exports }
}

fn compile_standard_package(
    sources: Vec[resources::Source],
    package_name: string,
    declared_name: string,
    hir_dependencies: Vec[hir::File],
    core_dependencies: Vec[core::File],
    builtins: core::File,
    deps: Vec[(string, string)],
) -> PackageCompilation {
    compile_toolchain_package(
        sources,
        "std",
        package_name,
        declared_name,
        hir_dependencies,
        core_dependencies,
        builtins,
        deps,
    )
}

fn required_standard_sources(package_name: string) -> Vec[resources::Source] {
    match resources::standard_sources(package_name) {
        Ok(Some(value)) => value,
        Ok(None) => {
            fail("error[compile]: unknown standard package " + package_name);
            Vec::new()
        },
        Err(error) => {
            fail(COMPILE_ERROR_PREFIX + error);
            Vec::new()
        },
    }
}

fn builtin_hir_files() -> Vec[hir::File] {
    let sources = match resources::builtin_layer_sources() {
        Ok(value) => value,
        Err(error) => {
            fail(COMPILE_ERROR_PREFIX + error);
            Vec::new()
        },
    };
    let inputs: Vec[(ast::LowerResult, string)] = Vec::new();
    for source in sources {
        inputs.push((ast::lower(parser::parse(source.source)), source.path))
    }
    let files: Vec[hir::File] = Vec::new();
    for lowered in hir::lower_package_files(inputs, "builtin") {
        match lowered.hir {
            Some(file) => files.push(file),
            None => fail("error[compile]: failed to lower builtin source " + lowered.source_path),
        }
    }
    files
}

fn builtin_contract_function_names() -> Vec[string] {
    Vec::from_array(["array_get", "array_set"])
}

fn builtin_artifact_interface_unit_from_checked(
    builtin_files: Vec[hir::File],
    checked: tast::CheckResult,
) -> artifact::ArtifactInterfaceUnit {
    let signatures = match tast::package_signatures(merge_hir_files(builtin_files, "builtin")) {
        Ok(value) => value,
        Err(error) => {
            fail("error[compile]: " + error);
            tast::PackageSignatures {
                traits: Vec::new(),
                functions: Vec::new(),
                type_aliases: Vec::new(),
                constants: Vec::new(),
            }
        },
    };
    let contract_functions = builtin_contract_function_names();
    let functions: Vec[tast::FunctionScheme] = Vec::new();
    for name in contract_functions {
        match tast::builtin_function_scheme(name) {
            Some(value) => functions.push(value),
            None => fail("error[compile]: missing builtin function " + name),
        }
    }
    for value in signatures.functions {
        functions.push(value)
    }
    let signatures = tast::PackageSignatures {
        traits: signatures.traits,
        functions,
        type_aliases: signatures.type_aliases,
        constants: signatures.constants,
    };
    for index in 0..signatures.functions.len() {
        for other in index + 1..signatures.functions.len() {
            if signatures.functions[index].name == signatures.functions[other].name {
                fail(
                    "error[compile]: duplicate builtin function " + signatures.functions[index].name,
                )
            }
        }
    }
    let file = match checked.tast {
        Some(file) => file,
        None => {
            fail("error[compile]: failed to typecheck builtin package");
            tast::File {
                items: Vec::new(),
                enums: Vec::new(),
                structs: Vec::new(),
                constants: Vec::new(),
                statics: Vec::new(),
            }
        },
    };
    let exports = required_artifact_package_exports(
        file,
        signatures,
        "builtin",
        Vec::new(),
        Vec::new(),
        false,
        Vec::new(),
        Vec::new(),
    );
    interface_codec::new_unit_with_comptime(
        "builtin",
        exports,
        artifact_package_interface("builtin", "builtin", exports),
        artifact_comptime_unit(checked.comptime, exports),
        Vec::new(),
    )
}

fn builtin_artifact_interface_unit_from_files(builtin_files: Vec[hir::File]) -> artifact::ArtifactInterfaceUnit {
    let checked = tast::check_builtin_package_files(builtin_files);
    builtin_artifact_interface_unit_from_checked(builtin_files, checked)
}

fn builtin_artifact_interface_unit() -> artifact::ArtifactInterfaceUnit {
    builtin_artifact_interface_unit_from_files(builtin_hir_files())
}

fn compile_prelude_package_with_builtin_files(
    builtins: core::File,
    builtin_interface: artifact::ArtifactInterfaceUnit,
    builtin_files: Vec[hir::File],
) -> PackageCompilation {
    let sources = match resources::prelude_sources() {
        Ok(value) => value,
        Err(error) => {
            fail(COMPILE_ERROR_PREFIX + error);
            Vec::new()
        },
    };
    let compilation = compile_toolchain_package(
        sources,
        "prelude",
        "prelude",
        "prelude",
        builtin_files,
        Vec::new(),
        builtins,
        Vec::from_array([("builtin", builtin_interface.interface_hash)]),
    );
    PackageCompilation {
        hir_file: compilation.hir_file,
        core_value: core::without_roots(compilation.core_value),
        interface_unit: compilation.interface_unit,
        exports: compilation.exports,
    }
}

fn compile_prelude_package(builtins: core::File, builtin_interface: artifact::ArtifactInterfaceUnit) -> PackageCompilation {
    compile_prelude_package_with_builtin_files(builtins, builtin_interface, builtin_hir_files())
}

fn expand_builtin_derives_with_compiler(compiler: SourceCompiler, value: ast::LowerResult) -> ast::LowerResult {
    let builtin_module = compiler.builtin_interface.comptime.map(|value| value.module);
    hir::expand_derives_with_environment(
        value,
        hir::DeriveEnvironment {
            builtin: builtin_module,
            dependencies: Vec::new(),
            reexports: Vec::new(),
        },
    )
}

fn all_standard_package_names() -> Vec[string] {
    let result = Vec::new();
    for spec in resources::standard_package_specs() {
        result.push(spec.name)
    }
    result
}

fn create_source_compiler(standard_package_names: Vec[string]) -> SourceCompiler {
    let counter = Ref::new(0);
    let builtin_files = builtin_hir_files();
    let checked = tast::check_builtin_package_files(builtin_files);
    let builtins = lower_checked_builtin_core(checked, counter);
    let counter_start = counter.get();
    let builtin_interface = builtin_artifact_interface_unit_from_checked(builtin_files, checked);
    let prelude = compile_prelude_package_with_builtin_files(
        builtins,
        builtin_interface,
        builtin_files,
    );
    let standard = if !standard_package_names.is_empty() {
        Option::Some(
            compile_standard_library_with_builtin_files(
                builtins,
                prelude,
                builtin_interface.interface_hash,
                builtin_files,
                standard_package_names,
            ),
        )
    } else {
        Option::None
    };
    SourceCompiler { counter_start, builtin_files, builtins, builtin_interface, prelude, standard }
}

pub fn source_compiler() -> SourceCompiler {
    create_source_compiler(all_standard_package_names())
}

pub fn source_compiler_without_standard() -> SourceCompiler {
    create_source_compiler(Vec::new())
}

pub fn source_compiler_for_sources(sources: Vec[string]) -> SourceCompiler {
    let package_names: Vec[string] = Vec::new();
    for source in sources {
        for package_name in direct_imported_standard_package_names(
            ast::lower(parser::parse(source)),
        ) {
            let mut known = false;
            for known_name in package_names {
                if known_name == package_name {
                    known = true;
                }
            }
            if known {} else {
                package_names.push(package_name)
            }
        }
    }
    create_source_compiler(package_names)
}

fn source_compiler_for_ast(value: ast::LowerResult) -> SourceCompiler {
    create_source_compiler(direct_imported_standard_package_names(value))
}

fn select_source_compiler(compiler: Option[SourceCompiler], value: ast::LowerResult) -> SourceCompiler {
    compiler.unwrap_or_else(|| source_compiler_for_ast(value))
}

fn builtin_artifact_json() -> string {
    let writer = wire::new_artifact_json_writer(false);
    interface_codec::artifact_json_interface_unit(writer, builtin_artifact_interface_unit());
    wire::artifact_json_finish(writer)
}

fn prelude_artifact_json() -> string {
    let builtins = lower_builtin_core(Ref::new(0));
    let builtin_interface = builtin_artifact_interface_unit();
    let prelude = compile_prelude_package(builtins, builtin_interface);
    let writer = wire::new_artifact_json_writer(false);
    interface_codec::artifact_json_interface_unit(writer, prelude.interface_unit);
    wire::artifact_json_finish(writer)
}

fn standard_artifact_deps(
    builtin_hash: string,
    prelude_hash: string,
    dependencies: Vec[PackageCompilation],
) -> Vec[(string, string)] {
    let result: Vec[(string, string)] = Vec::new();
    result.push(("builtin", builtin_hash));
    result.push(("prelude", prelude_hash));
    for dependency in dependencies {
        result.push(
            (dependency.interface_unit.package_name, dependency.interface_unit.interface_hash),
        )
    }
    result
}

fn required_standard_compilation(values: Vec[PackageCompilation], package_name: string) -> PackageCompilation {
    for value in values {
        if value.interface_unit.package_name == package_name {
            return value
        }
    }
    fail("error[compile]: standard package dependency was not compiled: " + package_name);
    values[0]
}

fn compile_standard_library_with_builtin_files(
    builtins: core::File,
    prelude: PackageCompilation,
    builtin_hash: string,
    builtin_files: Vec[hir::File],
    package_names: Vec[string],
) -> StandardLibrary {
    let compiled: Vec[PackageCompilation] = Vec::new();
    for package_name in resources::standard_package_closure(package_names) {
        let spec = match resources::standard_package_spec(package_name) {
            Some(value) => value,
            None => {
                fail("error[compile]: unknown standard package " + package_name);
                resources::standard_package_specs()[0]
            },
        };
        let dependencies: Vec[PackageCompilation] = Vec::new();
        let hir_dependencies: Vec[hir::File] = Vec::new();
        for builtin_file in builtin_files {
            hir_dependencies.push(builtin_file)
        }
        hir_dependencies.push(prelude.hir_file);
        let core_dependencies: Vec[core::File] = Vec::new();
        for dependency_name in spec.dependencies {
            let dependency = required_standard_compilation(compiled, dependency_name);
            dependencies.push(dependency);
            hir_dependencies.push(dependency.hir_file)
        }
        for dependency_name in spec.link_dependencies {
            core_dependencies.push(
                required_standard_compilation(compiled, dependency_name).core_value,
            )
        }
        compiled.push(
            compile_standard_package(
                required_standard_sources(spec.name),
                spec.name,
                spec.declared_name,
                hir_dependencies,
                core_dependencies,
                builtins,
                standard_artifact_deps(
                    builtin_hash,
                    prelude.interface_unit.interface_hash,
                    dependencies,
                ),
            ),
        )
    }
    StandardLibrary { packages: compiled }
}

fn standard_library_package(value: StandardLibrary, package_name: string) -> PackageCompilation {
    for compilation in value.packages {
        if compilation.interface_unit.package_name == package_name {
            return compilation
        }
    }
    fail("error[compile]: unavailable standard package " + package_name);
    value.packages[0]
}

fn direct_imported_standard_package_names(ast_value: ast::LowerResult) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    for spec in resources::standard_package_specs() {
        if imports_package(ast_value, spec.name) {
            result.push(spec.name)
        }
    }
    result
}

fn selected_standard_hir(ast_value: ast::LowerResult, standard: StandardLibrary) -> Vec[hir::File] {
    let result: Vec[hir::File] = Vec::new();
    for package_name in resources::standard_package_closure(
        direct_imported_standard_package_names(ast_value),
    ) {
        result.push(standard_library_package(standard, package_name).hir_file)
    }
    result
}

fn selected_standard_core(ast_value: ast::LowerResult, standard: StandardLibrary) -> Vec[core::File] {
    let result: Vec[core::File] = Vec::new();
    for package_name in resources::standard_package_link_closure(
        direct_imported_standard_package_names(ast_value),
    ) {
        result.push(standard_library_package(standard, package_name).core_value)
    }
    result
}

fn source_hir_dependencies(compiler: SourceCompiler, ast_value: ast::LowerResult) -> Vec[hir::File] {
    let result = Vec::from_array([compiler.prelude.hir_file]);
    if let Some(value) = compiler.standard {
        for dependency in selected_standard_hir(ast_value, value) {
            result.push(dependency)
        }
    }
    result
}

fn source_dependency_environments(compiler: SourceCompiler, ast_value: ast::LowerResult) -> Result[
    Vec[tast::DependencyEnvironment],
    string,
] {
    let result: Vec[tast::DependencyEnvironment] = Vec::new();
    result.push(tast::builtin_dependency_environment(compiler.builtin_files)?);
    for environment in tast::dependency_environments(source_hir_dependencies(compiler, ast_value))? {
        result.push(environment)
    }
    Result::Ok(result)
}

fn source_core_dependencies(compiler: SourceCompiler, ast_value: ast::LowerResult) -> Vec[
    core::File,
] {
    let result = Vec::from_array([compiler.prelude.core_value]);
    if let Some(value) = compiler.standard {
        for dependency in selected_standard_core(ast_value, value) {
            result.push(dependency)
        }
    }
    result
}

fn hir_diagnostics(diagnostics: Vec[hir::Diagnostic], source_path: string) -> Vec[tast::Diagnostic] {
    let result: Vec[tast::Diagnostic] = Vec::new();
    for diagnostic in diagnostics {
        result.push(
            tast::Diagnostic {
                severity: tast::DiagnosticSeverity::Error,
                stage: TYPER_STAGE,
                message: diagnostic.message,
                source_path,
                span: diagnostic.span,
                primary_label: Option::None,
                secondary_labels: Vec::new(),
                sort_order: 0,
            },
        )
    }
    result
}

fn diagnostic_span_start(value: tast::Diagnostic) -> isize {
    match value.span {
        Some(span) => span.start,
        None => if value.source_path == "" {
            2147483647
        } else {
            0
        },
    }
}

fn diagnostic_span_end(value: tast::Diagnostic) -> isize {
    match value.span {
        Some(span) => span.end,
        None => if value.source_path == "" {
            2147483647
        } else {
            0
        },
    }
}

fn diagnostic_precedes(left: tast::Diagnostic, right: tast::Diagnostic) -> bool {
    let left_inference = left.message == INFERENCE_FAILURE_MESSAGE;
    let right_inference = right.message == INFERENCE_FAILURE_MESSAGE;
    if left_inference != right_inference {
        left_inference
    } else if left_inference {
        false
    } else if left.source_path != right.source_path {
        left.source_path < right.source_path
    } else if diagnostic_span_start(left) != diagnostic_span_start(right) {
        diagnostic_span_start(left) < diagnostic_span_start(right)
    } else if diagnostic_span_end(left) != diagnostic_span_end(right) {
        diagnostic_span_end(left) < diagnostic_span_end(right)
    } else if left.stage != right.stage {
        left.stage < right.stage
    } else {
        left.message < right.message
    }
}

fn diagnostic_compare(left: tast::Diagnostic, right: tast::Diagnostic) -> cmp::Ordering {
    if diagnostic_precedes(left, right) {
        cmp::Ordering::Less
    } else if diagnostic_precedes(right, left) {
        cmp::Ordering::Greater
    } else {
        cmp::Ordering::Equal
    }
}

fn sorted_typer_diagnostics(values: Vec[tast::Diagnostic]) -> Vec[tast::Diagnostic] {
    let result: Vec[tast::Diagnostic] = Vec::new();
    for value in values {
        result.push(value)
    }
    collections::sort_by_ordering(result, diagnostic_compare);
    result
}

fn diagnostic_source(source_path: string, fallback_path: string, fallback_source: string) -> string {
    if source_path == fallback_path {
        fallback_source
    } else {
        fs::read_file_structured(source_path).unwrap_or("")
    }
}

fn source_position(source: string, offset: isize) -> DiagnosticPosition {
    let limit = if offset < 0 {
        0
    } else if offset > source.byte_len() {
        source.byte_len()
    } else {
        offset
    };
    let mut line = 0;
    let mut column = 0;
    let mut line_start = 0;
    let mut index = 0;
    while index < limit {
        let byte = source.byte_get(index);
        if byte == b'\r' && index + 1 < source.byte_len() && source.byte_get(index + 1) == b'\n' {
            if index + 1 < limit {
                line += 1;
                column = 0;
                index += 2;
                line_start = index;
            } else {
                index = limit;
            }
        } else if byte == b'\n' || byte == b'\r' {
            line += 1;
            column = 0;
            index += 1;
            line_start = index;
        } else if byte < 128 || byte >= 192 {
            column += 1;
            index += 1;
        } else {
            index += 1;
        }
    }
    let mut line_end = line_start;
    while line_end < source.byte_len() {
        let byte = source.byte_get(line_end);
        if byte == b'\n' || byte == b'\r' {
            break
        } else {
            line_end += 1;
        }
    }
    DiagnosticPosition { line, column, line_start, line_end }
}

fn repeat_char(value: char, count: isize) -> string {
    let builder = text::StringBuilder::new();
    for _ in 0..count {
        builder.write_char(value)
    }
    builder.finish()
}

fn diagnostic_visual_width(value: string) -> isize {
    let mut width = 0;
    for character in value.chars() {
        if character == '\t' {
            width = width + 4 - width % 4;
        } else {
            width += 1;
        }
    }
    width
}

fn expand_diagnostic_tabs(value: string) -> string {
    let builder = text::StringBuilder::new();
    let mut width = 0;
    for character in value.chars() {
        if character == '\t' {
            let spaces = 4 - width % 4;
            builder.write_string(repeat_char(' ', spaces));
            width += spaces;
        } else {
            builder.write_char(character);
            width += 1;
        }
    }
    builder.finish()
}

fn render_diagnostic_label(
    builder: text::StringBuilder,
    kind: string,
    source_path: string,
    span: ast::Span,
    message: Option[string],
    fallback_path: string,
    fallback_source: string,
) -> () {
    let source = diagnostic_source(source_path, fallback_path, fallback_source);
    builder.write_char('\n');
    builder.write_string(kind);
    builder.write_string(": ");
    builder.write_string(source_path);
    builder.write_char(':');
    if source.byte_len() == 0 {
        builder.write_string(span.start.to_string());
        builder.write_string("..");
        builder.write_string(span.end.to_string());
        if let Some(value) = message {
            builder.write_string(": ");
            builder.write_string(value)
        }
    } else {
        let start = source_position(source, span.start);
        let end = source_position(source, span.end);
        builder.write_string((start.line + 1).to_string());
        builder.write_char(':');
        builder.write_string((start.column + 1).to_string());
        if span.start != span.end {
            builder.write_char('-');
            builder.write_string((end.line + 1).to_string());
            builder.write_char(':');
            builder.write_string((end.column + 1).to_string())
        }
        if let Some(value) = message {
            builder.write_string(": ");
            builder.write_string(value)
        }
        let line_number = (start.line + 1).to_string();
        let gutter = line_number.len();
        let line_text = source.byte_slice(start.line_start, start.line_end);
        let highlight_start = if span.start < start.line_start {
            start.line_start
        } else if span.start > start.line_end {
            start.line_end
        } else {
            span.start
        };
        let highlight_end = if span.end < highlight_start {
            highlight_start
        } else if span.end > start.line_end {
            start.line_end
        } else {
            span.end
        };
        let indentation = diagnostic_visual_width(
            source.byte_slice(start.line_start, highlight_start),
        );
        let measured = diagnostic_visual_width(source.byte_slice(highlight_start, highlight_end));
        let marker_width = if measured > 0 {
            measured
        } else {
            1
        };
        builder.write_char('\n');
        builder.write_string(line_number);
        builder.write_string(" | ");
        builder.write_string(expand_diagnostic_tabs(line_text));
        builder.write_char('\n');
        builder.write_string(repeat_char(' ', gutter));
        builder.write_string(" | ");
        builder.write_string(repeat_char(' ', indentation));
        builder.write_string(repeat_char('^', marker_width))
    }
}

fn render_typer_diagnostic(value: tast::Diagnostic, fallback_path: string, fallback_source: string) -> string {
    let builder = text::StringBuilder::new();
    builder.write_string(
        match value.severity {
            Error => "error[",
            Warning => "warning[",
        },
    );
    builder.write_string(value.stage);
    builder.write_string("]: ");
    builder.write_string(value.message);
    match value.span {
        Some(span) => render_diagnostic_label(
            builder,
            "primary",
            value.source_path,
            span,
            value.primary_label,
            fallback_path,
            fallback_source,
        ),
        None => if value.source_path != "" {
            builder.write_string("\nat: ");
            builder.write_string(value.source_path)
        },
    }
    for label in value.secondary_labels {
        render_diagnostic_label(
            builder,
            "secondary",
            label.source_path,
            label.span,
            Option::Some(label.message),
            fallback_path,
            fallback_source,
        )
    }
    builder.finish()
}

fn render_typer_diagnostics(
    values: Vec[tast::Diagnostic],
    fallback_path: string,
    fallback_source: string,
) -> string {
    let builder = text::StringBuilder::new();
    let mut index = 0;
    for value in sorted_typer_diagnostics(values) {
        if index > 0 {
            builder.write_string("\n\n")
        }
        builder.write_string(render_typer_diagnostic(value, fallback_path, fallback_source));
        index += 1;
    }
    builder.finish()
}

fn fail_on_typer_diagnostics(
    diagnostics: Vec[tast::Diagnostic],
    fallback_path: string,
    fallback_source: string,
) -> () {
    if typer_diagnostics_have_errors(diagnostics) {
        fail(render_typer_diagnostics(diagnostics, fallback_path, fallback_source))
    } else {
        emit_typer_warnings(diagnostics, fallback_path, fallback_source)
    }
}

fn emit_typer_warnings(
    diagnostics: Vec[tast::Diagnostic],
    fallback_path: string,
    fallback_source: string,
) -> () {
    let warnings: Vec[tast::Diagnostic] = Vec::new();
    for diagnostic in diagnostics {
        match diagnostic.severity {
            Error => (),
            Warning => warnings.push(diagnostic),
        }
    }
    if warnings.is_empty() {} else {
        io::eprintln(render_typer_diagnostics(warnings, fallback_path, fallback_source))
    }
}

fn ast_diagnostics(diagnostics: Vec[cst::Diagnostic], stage: string, source_path: string) -> Vec[
    tast::Diagnostic,
] {
    let result: Vec[tast::Diagnostic] = Vec::new();
    for diagnostic in diagnostics {
        result.push(
            tast::Diagnostic {
                severity: tast::DiagnosticSeverity::Error,
                stage,
                message: diagnostic.message,
                source_path,
                span: Option::Some(ast::Span { start: diagnostic.start, end: diagnostic.end }),
                primary_label: Option::None,
                secondary_labels: Vec::new(),
                sort_order: 0,
            },
        )
    }
    result
}

fn fail_on_ast_diagnostics(
    diagnostics: Vec[cst::Diagnostic],
    stage: string,
    source_path: string,
    source: string,
) -> () {
    if !diagnostics.is_empty() {
        fail(
            render_typer_diagnostics(
                ast_diagnostics(diagnostics, stage, source_path),
                source_path,
                source,
            ),
        )
    }
}

fn compact_diagnostic_line(
    builder: text::StringBuilder,
    message: string,
    span: Option[ast::Span],
    source: string,
) -> () {
    if let Some(value) = span {
        let position = source_position(source, value.start);
        builder.write_string((position.line + 1).to_string());
        builder.write_char(':');
        builder.write_string((position.column + 1).to_string());
        builder.write_string(": ")
    }
    builder.write_string(message);
    builder.write_char('\n')
}

fn compact_ast_diagnostics(diagnostics: Vec[cst::Diagnostic], source: string, with_locations: bool) -> string {
    let builder = text::StringBuilder::new();
    for diagnostic in diagnostics {
        compact_diagnostic_line(
            builder,
            diagnostic.message,
            if with_locations {
                Option::Some(ast::Span { start: diagnostic.start, end: diagnostic.end })
            } else {
                Option::None
            },
            source,
        )
    }
    builder.finish()
}

fn compact_hir_diagnostics(diagnostics: Vec[hir::Diagnostic], source: string) -> string {
    let builder = text::StringBuilder::new();
    for diagnostic in diagnostics {
        compact_diagnostic_line(builder, diagnostic.message, diagnostic.span, source)
    }
    builder.finish()
}

fn diagnostic_message_starts_with(value: string, prefix: string) -> bool {
    value.starts_with(prefix)
}

fn compact_diagnostic_phase(value: tast::Diagnostic) -> isize {
    if value.message == INFERENCE_FAILURE_MESSAGE {
        4
    } else if diagnostic_message_starts_with(value.message, "Could not infer the ") {
        if diagnostic_message_starts_with(
            value.message,
            "Could not infer the type required to prove",
        ) {
            2
        } else {
            3
        }
    } else if diagnostic_message_starts_with(value.message, "No instance found for trait ") {
        2
    } else if diagnostic_message_starts_with(value.message, "Struct ")
        && value.message.contains(" type arguments, but got ") {
        1
    } else {
        0
    }
}

fn specialized_inference_priority(value: string) -> isize {
    if diagnostic_message_starts_with(value, "Could not infer the base type") {
        0
    } else if diagnostic_message_starts_with(value, "Could not infer the operand type") {
        1
    } else {
        2
    }
}

fn compact_diagnostic_precedes(left: tast::Diagnostic, right: tast::Diagnostic) -> bool {
    let left_phase = compact_diagnostic_phase(left);
    let right_phase = compact_diagnostic_phase(right);
    if left_phase != right_phase {
        left_phase < right_phase
    } else if diagnostic_message_starts_with(left.message, "extern ")
        && diagnostic_message_starts_with(right.message, "Internal error: ") {
        true
    } else if left_phase == 0
        && diagnostic_message_starts_with(left.message, "Unknown type constructor ")
        && diagnostic_message_starts_with(right.message, "Unknown type constructor ") {
        diagnostic_span_start(left) < diagnostic_span_start(right)
    } else if left_phase == 2
        && diagnostic_message_starts_with(left.message, "No instance found for trait ")
        && diagnostic_message_starts_with(right.message, "No instance found for trait ")
        && diagnostic_span_start(left) == diagnostic_span_start(right) {
        left.message > right.message
    } else if left_phase == 3 {
        specialized_inference_priority(left.message) < specialized_inference_priority(right.message)
    } else if left_phase == 4 && left.sort_order != right.sort_order
        && (left.sort_order > 0 || right.sort_order > 0) {
        left.sort_order < right.sort_order
    } else if left_phase == 4 {
        diagnostic_span_start(left) < diagnostic_span_start(right)
    } else {
        false
    }
}

fn compact_diagnostic_compare(left: tast::Diagnostic, right: tast::Diagnostic) -> cmp::Ordering {
    if compact_diagnostic_precedes(left, right) {
        cmp::Ordering::Less
    } else if compact_diagnostic_precedes(right, left) {
        cmp::Ordering::Greater
    } else {
        cmp::Ordering::Equal
    }
}

fn compact_sorted_diagnostics(values: Vec[tast::Diagnostic]) -> Vec[tast::Diagnostic] {
    let result: Vec[tast::Diagnostic] = Vec::new();
    for value in values {
        result.push(value)
    }
    collections::sort_by_ordering(result, compact_diagnostic_compare);
    result
}

fn typer_diagnostics_have_errors(diagnostics: Vec[tast::Diagnostic]) -> bool {
    tast::diagnostics_have_errors(diagnostics)
}

fn compact_typer_diagnostics(
    diagnostics: Vec[tast::Diagnostic],
    source_path: string,
    source: string,
) -> string {
    let builder = text::StringBuilder::new();
    for diagnostic in compact_sorted_diagnostics(diagnostics) {
        compact_diagnostic_line(
            builder,
            diagnostic.message,
            diagnostic.span,
            diagnostic_source(diagnostic.source_path, source_path, source),
        )
    }
    builder.finish()
}

fn diagnostic_output_optional(
    compiler_value: Option[SourceCompiler],
    source_path: string,
    source: string,
) -> string {
    let parsed = parser::parse(source);
    if !parsed.diagnostics.is_empty() {
        return compact_ast_diagnostics(parsed.diagnostics, source, true)
    }
    let ast_value = ast::lower(parsed);
    if !ast_value.diagnostics.is_empty() {
        return compact_ast_diagnostics(ast_value.diagnostics, source, false)
    }
    if let Some(package_path) = single_file_project_import(ast_value) {
        return "single-file compilation cannot use project package " + package_path + "\n"
    }
    let compiler = select_source_compiler(compiler_value, ast_value);
    let ast_value = expand_builtin_derives_with_compiler(compiler, ast_value);
    if !ast_value.diagnostics.is_empty() {
        return compact_ast_diagnostics(ast_value.diagnostics, source, false)
    }
    let hir_value = hir::lower_expanded(ast_value, source_path);
    if !hir_value.diagnostics.is_empty() {
        return compact_hir_diagnostics(hir_value.diagnostics, source)
    }
    let counter = Ref::new(compiler.counter_start);
    let environments = match source_dependency_environments(compiler, ast_value) {
        Ok(value) => value,
        Err(error) => return "error[builtin]: " + error + "\n",
    };
    let core_dependencies = source_core_dependencies(compiler, ast_value);
    let tast_value = tast::check_for_link_with_environments(hir_value, environments);
    if !tast_value.diagnostics.is_empty() {
        return compact_typer_diagnostics(tast_value.diagnostics, source_path, source)
    }
    if !has_single_file_entrypoint(tast_value) {
        return "main function is required\n"
    }
    let core_value = core::link_with_dependencies(
        compiler.builtins,
        core_dependencies,
        core::lower_with_counter_types_and_options(
            tast_value,
            counter,
            dependency_enums(compiler.builtins, core_dependencies),
            dependency_structs(compiler.builtins, core_dependencies),
            true,
        ),
    );
    let mono_result = mono::lower_checked(eliminate_core_dead_code(core_value));
    match mono_result.error {
        Some(error) => error + "\n",
        None => "",
    }
}

pub fn diagnostic_output_with(compiler: SourceCompiler, source_path: string, source: string) -> string {
    diagnostic_output_optional(Option::Some(compiler), source_path, source)
}

pub fn diagnostic_output(source_path: string, source: string) -> string {
    diagnostic_output_optional(Option::None, source_path, source)
}

fn run_test_diagnostics(args: Vec[string]) -> () {
    if args.len() != 3 {
        fail("usage: gomlc __test-diagnostics <FILE>")
    } else {
        let source_path = args[2];
        io::print(diagnostic_output(source_path, read_source(source_path)))
    }
}

fn eliminate_core_dead_code(value: core::File) -> core::File {
    core::eliminate_unreachable_functions(core::eliminate_dead_locals(value))
}

fn lower_mono_or_fail(value: core::File) -> mono::File {
    let result = mono::lower_checked(eliminate_core_dead_code(value));
    if let Some(error) = result.error {
        fail(COMPILE_ERROR_PREFIX + error)
    }
    let lowered = mono::dce(result.file);
    if let Err(message) = mono::validate(lowered) {
        fail(COMPILE_ERROR_PREFIX + "invalid Mono IR: " + message)
    }
    lowered
}

fn lower_lift_stage(value: mono::File, counter: Ref[isize]) -> lift::File {
    let lowered = match lift::lower_checked_with_counter(value, counter) {
        Ok(value) => value,
        Err(message) => {
            fail(COMPILE_ERROR_PREFIX + message);
            lift::File {
                functions: Vec::new(),
                enums: Vec::new(),
                structs: Vec::new(),
                type_instances: Vec::new(),
                constants: Vec::new(),
                statics: Vec::new(),
                closure_defs: Vec::new(),
            }
        },
    };
    let result = lift::dce(lowered);
    if let Err(message) = lift::validate(result) {
        fail(COMPILE_ERROR_PREFIX + "invalid Lift IR: " + message)
    }
    result
}

fn lower_anf_stage(value: lift::File, counter: Ref[isize]) -> anf::File {
    let result = anf::scalar_replace(anf::lower_with_counter(value, counter));
    if let Err(message) = anf::verify(result) {
        fail(COMPILE_ERROR_PREFIX + "invalid ANF IR: " + message)
    }
    result
}

fn has_single_file_entrypoint(value: tast::CheckResult) -> bool {
    match value.tast {
        Some(file) => {
            for item in file.items {
                if let Function(function) = item {
                    if function.name == "main" {
                        return true
                    }
                }
            }
            false
        },
        None => false,
    }
}

fn fail_on_missing_single_file_entrypoint(value: tast::CheckResult) -> () {
    if has_single_file_entrypoint(value) {} else {
        fail("error[typer]: main function is required")
    }
}

fn compile_source_optional(
    compiler_value: Option[SourceCompiler],
    source_path: string,
    source: string,
) -> Compilation {
    let parsed = parser::parse(source);
    fail_on_ast_diagnostics(parsed.diagnostics, "parser", source_path, source);
    let source_ast_value = ast::lower(parsed);
    fail_on_ast_diagnostics(source_ast_value.diagnostics, "lower", source_path, source);
    if let Some(package_path) = single_file_project_import(source_ast_value) {
        fail("error[compile]: single-file compilation cannot use project package " + package_path)
    }
    let compiler = select_source_compiler(compiler_value, source_ast_value);
    let ast_value = expand_builtin_derives_with_compiler(compiler, source_ast_value);
    fail_on_ast_diagnostics(ast_value.diagnostics, "derive", source_path, source);
    let hir_value = hir::lower_expanded(ast_value, source_path);
    let counter = Ref::new(compiler.counter_start);
    let environments = match source_dependency_environments(compiler, ast_value) {
        Ok(value) => value,
        Err(error) => {
            fail("error[builtin]: " + error);
            Vec::new()
        },
    };
    let core_dependencies = source_core_dependencies(compiler, ast_value);
    let tast_value = tast::check_for_link_with_environments(hir_value, environments);
    fail_on_typer_diagnostics(tast_value.diagnostics, source_path, source);
    fail_on_missing_single_file_entrypoint(tast_value);
    let core_value = eliminate_core_dead_code(
        core::link_with_dependencies(
            compiler.builtins,
            core_dependencies,
            core::lower_with_counter_types_and_options(
                tast_value,
                counter,
                dependency_enums(compiler.builtins, core_dependencies),
                dependency_structs(compiler.builtins, core_dependencies),
                true,
            ),
        ),
    );
    let mono_value = lower_mono_or_fail(core_value);
    let lift_value = lower_lift_stage(mono_value, counter);
    let anf_value = lower_anf_stage(lift_value, counter);
    let go_value = lower_go_or_fail(go_backend::lower(anf_value));
    Compilation {
        source_ast_value,
        ast_value,
        hir_value,
        tast_value,
        core_value,
        mono_value,
        lift_value,
        anf_value,
        go_value,
    }
}

pub fn compile_source_with(compiler: SourceCompiler, source_path: string, source: string) -> Compilation {
    compile_source_optional(Option::Some(compiler), source_path, source)
}

pub fn compile_source(source_path: string, source: string) -> Compilation {
    compile_source_optional(Option::None, source_path, source)
}

fn compile_source_or_diagnostics_optional(
    compiler_value: Option[SourceCompiler],
    source_path: string,
    source: string,
) -> SourceCompilation {
    let parsed = parser::parse(source);
    if !parsed.diagnostics.is_empty() {
        return SourceCompilation::Diagnostics(
            compact_ast_diagnostics(parsed.diagnostics, source, true),
        )
    }
    let source_ast_value = ast::lower(parsed);
    if !source_ast_value.diagnostics.is_empty() {
        return SourceCompilation::Diagnostics(
            compact_ast_diagnostics(source_ast_value.diagnostics, source, false),
        )
    }
    if let Some(package_path) = single_file_project_import(source_ast_value) {
        return SourceCompilation::Diagnostics(
            "single-file compilation cannot use project package " + package_path + "\n",
        )
    }
    let compiler = select_source_compiler(compiler_value, source_ast_value);
    let ast_value = expand_builtin_derives_with_compiler(compiler, source_ast_value);
    if !ast_value.diagnostics.is_empty() {
        return SourceCompilation::Diagnostics(
            compact_ast_diagnostics(ast_value.diagnostics, source, false),
        )
    }
    let hir_value = hir::lower_expanded(ast_value, source_path);
    if !hir_value.diagnostics.is_empty() {
        return SourceCompilation::Diagnostics(
            compact_hir_diagnostics(hir_value.diagnostics, source),
        )
    }
    let counter = Ref::new(compiler.counter_start);
    let environments = match source_dependency_environments(compiler, ast_value) {
        Ok(value) => value,
        Err(error) => return SourceCompilation::Diagnostics("error[builtin]: " + error + "\n"),
    };
    let core_dependencies = source_core_dependencies(compiler, ast_value);
    let tast_value = tast::check_for_link_with_environments(hir_value, environments);
    if typer_diagnostics_have_errors(tast_value.diagnostics) {
        return SourceCompilation::Diagnostics(
            compact_typer_diagnostics(tast_value.diagnostics, source_path, source),
        )
    } else if !has_single_file_entrypoint(tast_value) {
        return SourceCompilation::Diagnostics("main function is required\n")
    }
    let core_value = eliminate_core_dead_code(
        core::link_with_dependencies(
            compiler.builtins,
            core_dependencies,
            core::lower_with_counter_types_and_options(
                tast_value,
                counter,
                dependency_enums(compiler.builtins, core_dependencies),
                dependency_structs(compiler.builtins, core_dependencies),
                true,
            ),
        ),
    );
    let mono_result = mono::lower_checked(core_value);
    match mono_result.error {
        Some(error) => SourceCompilation::Diagnostics(error + "\n"),
        None => {
            let mono_value = mono::dce(mono_result.file);
            let lift_value = lower_lift_stage(mono_value, counter);
            let anf_value = lower_anf_stage(lift_value, counter);
            let go_value = lower_go_or_fail(go_backend::lower(anf_value));
            SourceCompilation::Compiled(
                Compilation {
                    source_ast_value,
                    ast_value,
                    hir_value,
                    tast_value,
                    core_value,
                    mono_value,
                    lift_value,
                    anf_value,
                    go_value,
                },
            )
        },
    }
}

pub fn compile_source_or_diagnostics_with(
    compiler: SourceCompiler,
    source_path: string,
    source: string,
) -> SourceCompilation {
    compile_source_or_diagnostics_optional(Option::Some(compiler), source_path, source)
}

pub fn compile_source_or_diagnostics(source_path: string, source: string) -> SourceCompilation {
    compile_source_or_diagnostics_optional(Option::None, source_path, source)
}

fn pipeline_stage_output(stage: string, source_path: string, source: string) -> string {
    match stage {
        CST_STAGE => cst::debug_tree(parser::parse(source)),
        _ => {
            let compilation = compile_source(source_path, source);
            match stage {
                AST_STAGE => ast::pretty(compilation.ast_value),
                HIR_STAGE => hir::encode(compilation.hir_value),
                TAST_STAGE => tast::encode(compilation.tast_value),
                CORE_STAGE => core::encode(compilation.core_value),
                MONO_STAGE => mono::encode(compilation.mono_value),
                LIFT_STAGE => lift::encode(compilation.lift_value),
                ANF_STAGE => anf::encode(compilation.anf_value),
                GO_STAGE => go_backend::encode(compilation.go_value),
                _ => {
                    fail("unknown pipeline stage: " + stage);
                    ""
                },
            }
        },
    }
}

fn print_dump(printed: Ref[bool], label: string, content: string) -> () {
    if printed.get() {
        io::println("")
    }
    io::println("== " + label + " ==");
    io::println(content);
    printed.set(true)
}

fn encode_comptime_module(value: tast::CheckResult) -> string {
    let writer = wire::new_artifact_json_writer(true);
    interface_codec::artifact_json_comptime_unit(
        writer,
        interface_codec::new_comptime_unit(value.comptime),
        false,
    );
    wire::artifact_json_finish(writer)
}

fn print_dumps(compilation: Compilation, args: RunArgs, go_source: string) -> () {
    let printed = Ref::new(false);
    if args.dump_ast {
        print_dump(printed, "AST", ast::pretty(compilation.source_ast_value))
    }
    if args.dump_expanded_ast {
        print_dump(printed, "Expanded AST", ast::pretty(compilation.ast_value))
    }
    if args.dump_hir {
        print_dump(printed, "HIR", hir::encode(compilation.hir_value))
    }
    if args.dump_tast {
        print_dump(printed, "Typed AST", tast::encode(compilation.tast_value))
    }
    if args.dump_ctir {
        print_dump(printed, "CTIR", encode_comptime_module(compilation.tast_value))
    }
    if args.dump_core {
        print_dump(printed, "Core", core::encode(compilation.core_value))
    }
    if args.dump_mono {
        print_dump(printed, "Mono", mono::encode(compilation.mono_value))
    }
    if args.dump_lift {
        print_dump(printed, "Lifted", lift::encode(compilation.lift_value))
    }
    if args.dump_anf {
        print_dump(printed, "ANF", anf::encode(compilation.anf_value))
    }
    if args.dump_go {
        print_dump(printed, "Go", go_source)
    }
}

fn write_stdout(data: bytes::Bytes) -> () {
    if let Err(error) = io::write_stdout_structured(data) {
        fail(error.to_string())
    }
}

fn bytes_to_string(data: bytes::Bytes) -> string {
    data.to_string_utf8().unwrap_or_else(|error| fail_string(error.to_string()))
}

fn fail_string(message: string) -> string {
    fail(message);
    ""
}

fn trim_ascii(value: string) -> string {
    let mut start = 0;
    let mut end = value.byte_len();
    while start < end && ascii::is_whitespace(value.byte_get(start)) {
        start += 1;
    }
    while end > start && ascii::is_whitespace(value.byte_get(end - 1)) {
        end -= 1;
    }
    value.byte_slice(start, end)
}

fn temp_root() -> string {
    match env::var_structured("TMPDIR") {
        Ok(value) => if value == "" {
            "/tmp"
        } else {
            value
        },
        Err(_) => "/tmp",
    }
}

fn temp_go_path(source_path: string, source: string) -> string {
    let root = path::join(temp_root(), "gomlc-selfhost");
    if let Err(error) = fs::create_dir_all(root) {
        fail(error.to_string())
    }
    let prefix = Hash::hash(source_path + "\n" + source).to_string();
    let mut suffix = 0;
    loop {
        let directory = path::join(root, f"{prefix}-{suffix}");
        match fs::create_dir(directory) {
            Ok(()) => break path::join(directory, "main.go"),
            Err(error) => if error.kind() == io::ErrorKind::AlreadyExists {
                suffix += 1;
            } else {
                fail(error.to_string())
            },
        };
    }
}

fn command_succeeded(output: process::Output) -> bool {
    process::ExitStatus::success(process::Output::status(output))
}

fn cleanup_temp_directory(go_file: string) -> () {
    if let Some(directory) = path::parent(go_file) {
        let _ = fs::remove_dir_all(directory);
    }
}

fn execute_with_go_run(directory: string, go_file: string) -> Result[process::Output, string] {
    let source = fs::read_file_structured(go_file).map_err(|error| error.to_string())?;
    if source.contains(simd::NATIVE_MARKER) {
        let output = path::join(directory, "simd_program");
        let context = resolve_foreign_build_context("go", directory)?;
        build_go_with_simd(context, Vec::from_array(["build", "-o", output]), go_file)?;
        return process::Command::new(output).current_dir(directory).env("TZ", "UTC").output_structured().map_err(
            |error| error.to_string(),
        )
    }
    process::Command::new("go").arg("run").arg(go_file).current_dir(directory).env("TZ", "UTC").env(
        "GOWORK",
        "off",
    ).env("GO111MODULE", "off").output_structured().map_err(
        |error| f"failed to execute go run: {error}",
    )
}

fn execute_go_source(source_path: string, source: string) -> () {
    let go_file = temp_go_path(source_path, source);
    let directory = path::parent(go_file).unwrap_or_else(|| temp_root());
    let result = match fs::write_file_structured(go_file, source) {
        Ok(()) => execute_with_go_run(directory, go_file),
        Err(error) => Result::Err(error.to_string()),
    };
    cleanup_temp_directory(go_file);
    match result {
        Ok(output) => if command_succeeded(output) {
            write_stdout(process::Output::stdout(output))
        } else {
            fail("go run failed: " + trim_ascii(bytes_to_string(process::Output::stderr(output))))
        },
        Err(error) => fail(error),
    }
}

fn run_single(args: RunArgs) -> () {
    let source = read_source(args.file);
    let compilation = compile_source(args.file, source);
    let go_source = go_backend::encode(compilation.go_value);
    print_dumps(compilation, args, go_source);
    execute_go_source(args.file, go_source)
}
