package main;

use module::core;
use module::mono;

fn lower_linked_with_source_names(value: core::File, source_names: Vec[(string, string)]) -> Result[
    mono::File,
    string,
] {
    let pruned = eliminate_core_dead_code(value);
    let lowered = mono::lower_checked_with_source_names(pruned, source_names);
    if let Some(error) = lowered.error {
        return Result::Err(error)
    }
    let result = mono::dce(lowered.file);
    mono::validate(result)?;
    Result::Ok(result)
}
