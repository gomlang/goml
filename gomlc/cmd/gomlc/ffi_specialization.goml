package main;

use module::artifact;
use module::core;
use module::mono;

fn lower_linked_with_source_names(
    value: core::File,
    units: Vec[artifact::ArtifactCoreUnit],
    source_names: Vec[(string, string)],
) -> Result[mono::File, string] {
    let applications = Vec::new();
    for unit in units {
        for application in unit.external_applications {
            applications.push(application)
        }
    }
    core::validate_external_applications(value, applications)?;
    let pruned = eliminate_core_dead_code(value);
    let reachable = Vec::new();
    for application in applications {
        for function in pruned.functions {
            if function.name == application.function_name {
                reachable.push(application)
            }
        }
    }
    let lowered = mono::lower_with_external_applications(pruned, reachable)?;
    for source in lowered.source_names {
        source_names.push(source)
    }
    let result = mono::dce(lowered.file);
    mono::validate_with_external_keys(result, Option::None)?;
    Result::Ok(result)
}

fn core_units_have_external_applications(units: Vec[artifact::ArtifactCoreUnit]) -> bool {
    for unit in units {
        if unit.external_applications.len() != 0 {
            return true
        }
    }
    false
}
