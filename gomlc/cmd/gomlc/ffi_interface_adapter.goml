package main;

use module::ast;
use std::fs;
use std::text;

fn interface_adapter_diagnostic(message: string, source_path: string, span: ast::Span) -> string {
    let output = text::StringBuilder::new();
    output.write_string("ffi-interface: " + message + "\n");
    render_diagnostic_label(
        output,
        "primary",
        source_path,
        span,
        Option::Some("Go interface adapter declaration"),
        source_path,
        fs::read_file_structured(source_path).unwrap_or(""),
    );
    output.finish()
}

fn interface_item_name(item: ast::Item) -> Option[string] {
    match item {
        Function(value) => Option::Some(value.name),
        ExternFunction(value) => Option::Some(value.name),
        ExternType(value) => Option::Some(value.name),
        StructDef(value) => Option::Some(value.name),
        EnumDef(value) => Option::Some(value.name),
        TraitDef(value) => Option::Some(value.name),
        TypeAlias(value) => Option::Some(value.name),
        Constant(value) => Option::Some(value.name),
        Static(value) => Option::Some(value.name),
        ImplBlock(_) => Option::None,
    }
}

fn validate_package_interface_names(files: Vec[ast::LowerResult], paths: Vec[string]) -> Result[
    (),
    string,
] {
    let names: Vec[string] = Vec::new();
    for value in files {
        if let Some(file) = value.ast {
            for item in file.items {
                if let Some(name) = interface_item_name(item) {
                    names.push(name);
                }
            }
        }
    }
    for index in 0..files.len() {
        if let Some(file) = files[index].ast {
            for item in file.items {
                if let ast::Item::TraitDef(definition) = item {
                    if let Ok(Some(specification)) = ast::go_interface_spec(definition.attrs) {
                        let generated = Vec::from_array([specification.wrapper_name]);
                        generated.push(
                            "__goml_interface_" + specification.wrapper_name + "_from_trait",
                        );
                        for mapping in specification.methods {
                            generated.push(
                                "__goml_interface_" + specification.wrapper_name + "_" + mapping.0,
                            );
                        }
                        for name in generated {
                            if names.contains(name) {
                                return Result::Err(
                                    interface_adapter_diagnostic(
                                        "go_interface generated declaration collides with " + name,
                                        paths[index],
                                        specification.span,
                                    ),
                                )
                            }
                            names.push(name);
                        }
                    }
                }
            }
        }
    }
    Result::Ok(())
}
