package main;

use std::path;
use std::testing;

#[test]
fn simd_inlining_preserves_mixed_kernel_signatures() -> () {
    let source =
        \\use std::simd;
        \\fn scaled(a: simd::f64x4, scale: f64) -> simd::f64x4 {
        \\    a.add(simd::f64x4::splat(scale)).mul(a)
        \\}
        \\fn total(a: simd::i16x8) -> i16 {
        \\    a.add(a).reduce_sum()
        \\}
        \\fn compare(a: simd::u8x32, b: simd::u8x32) -> simd::mask8x32 {
        \\    a.simd_lt(b)
        \\}
        \\fn choose(mask: simd::mask32x8, a: simd::f32x8, bias: f32) -> simd::f32x8 {
        \\    mask.select(a, simd::f32x8::splat(bias)).add(a)
        \\}
        \\fn mask_any(mask: simd::mask64x2) -> bool {
        \\    mask.bitnot().any()
        \\}
        \\fn bits(mask: simd::mask8x16) -> u16 {
        \\    mask.bitnot().to_bitmask()
        \\}
        \\fn constant() -> simd::f64x2 {
        \\    simd::f64x2::splat(3.0)
        \\}
        \\fn broadcast(value: i32) -> simd::i32x4 {
        \\    simd::i32x4::splat(value)
        \\}
        \\fn helper(a: simd::i32x4, b: simd::i32x4) -> simd::i32x4 {
        \\    a.add(b)
        \\}
        \\fn nested(a: simd::i32x4, b: simd::i32x4) -> simd::i32x4 {
        \\    helper(a, b).mul(b)
        \\}
        \\fn eight(a: simd::f64x2, b: simd::f64x2, c: simd::f64x2, d: simd::f64x2, e: simd::f64x2, f: simd::f64x2, g: simd::f64x2, h: simd::f64x2) -> simd::f64x2 {
        \\    a.add(b).add(c).add(d).add(e).add(f).add(g).add(h)
        \\}
        \\fn main() -> () {
        \\    println(scaled(simd::f64x4::splat(2.0), 3.0).to_array()[0]);
        \\    println(total(simd::i16x8::splat(3)));
        \\    println(compare(simd::u8x32::splat(2), simd::u8x32::splat(3)).to_bitmask());
        \\    println(choose(simd::mask32x8::from_bitmask(170), simd::f32x8::splat(2.0), 3.0).to_array()[0]);
        \\    println(mask_any(simd::mask64x2::from_bitmask(1)));
        \\    println(bits(simd::mask8x16::from_bitmask(170)));
        \\    println(constant().to_array()[0]);
        \\    println(broadcast(-7).to_array()[0]);
        \\    println(nested(simd::i32x4::splat(2), simd::i32x4::splat(3)).to_array()[0]);
        \\    let a = simd::f64x2::splat(1.0);
        \\    println(eight(a, a, a, a, a, a, a, a).to_array()[0]);
        \\}
    ;
    let temporary = temp_go_path("simd-inline.goml", "simd-inline");
    let result = exercise_simd_numeric_source(
        path::parent(temporary).unwrap_or(""),
        source,
        Vec::from_array(
            [
                "scaled",
                "total",
                "compare",
                "choose",
                "mask_any",
                "bits",
                "constant",
                "broadcast",
                "helper",
                "nested",
                "eight",
            ],
        ),
        "",
    );
    cleanup_temp_directory(temporary);
    if let Err(error) = result {
        testing::fail(error);
    }
}
