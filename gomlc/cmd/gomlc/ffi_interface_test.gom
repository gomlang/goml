package main;

use module::artifact::interface_codec as interface_codec;
use module::artifact;
use module::artifact::core_codec;
use module::ffi;
use module::tast;
use std::fs;
use std::path;
use std::testing;

fn compile_private_foreign_interface(directory: string, symbol: string) -> Result[
    artifact::ArtifactInterfaceUnit,
    string,
] {
    let source_path = path::join(directory, "calc.gom");
    fs::write_file_structured(
        source_path,
        "package calc; #[go_ffi(\"math\", \"" + symbol
            + "\")] extern fn unused_private(value: f64) -> f64; pub fn visible() -> bool { true }",
    ).map_err(|error| error.to_string())?;
    let command = PackageCommandArgs {
        foreign_validation: Option::None,
        package_name: "demo::calc",
        module_name: "demo::calc",
        inputs: Vec::from_array([source_path]),
        interface_paths: Vec::new(),
        output: path::join(directory, "calc"),
        world: Option::None,
    };
    let compiled = compile_artifact_package(test_package_world(), command, false, false)?;
    Result::Ok(compiled.interface_unit)
}

fn exercise_private_foreign_interface(directory: string) -> Result[(), string] {
    let unit = compile_private_foreign_interface(directory, "Abs")?;
    testing::assert_eq(unit.foreign_bindings.len(), 1);
    testing::assert(unit.foreign_bindings[0].binding_id.contains("unused_private"));
    testing::assert_eq(unit.foreign_bindings[0].symbol, "Abs");
    for function in unit.exports.functions {
        testing::assert(!function.name.contains("unused_private"))
    }
    for export in unit.package_interface.value_exports {
        testing::assert(!export.0.contains("unused_private"))
    }
    let decoded = interface_codec::decode_binary(interface_codec::encode_binary(unit)?)?;
    testing::assert_eq(decoded.foreign_bindings.len(), 1);
    testing::assert_eq(decoded.foreign_bindings[0].binding_id, unit.foreign_bindings[0].binding_id);
    testing::assert_eq(decoded.interface_hash, unit.interface_hash);
    let changed = compile_private_foreign_interface(directory, "Floor")?;
    testing::assert_ne(changed.interface_hash, unit.interface_hash);
    Result::Ok(())
}

#[test]
fn foreign_interface_keeps_unused_private_bindings_outside_public_api() -> () {
    let temporary = temp_go_path("ffi-interface.gom", "private-interface");
    let result = exercise_private_foreign_interface(path::parent(temporary).unwrap_or(""));
    cleanup_temp_directory(temporary);
    match result {
        Ok(()) => (),
        Err(message) => testing::fail(message),
    }
}

#[test]
fn foreign_interface_rejects_unknown_bridge_shapes() -> () {
    let base = binary_interface_fixture();
    let binding = ffi::ForeignBinding {
        call_mode: ffi::ForeignCallMode::Ordinary,
        binding_id: "audit::value:invalid",
        import_path: "math",
        symbol: "Abs",
        parameters: Vec::from_array([ffi::BridgeType::Scalar("unknown")]),
        results: Vec::new(),
    };
    let unit = interface_codec::new_unit_with_foreign_bindings(
        base.package_name,
        base.exports,
        base.package_interface,
        base.comptime,
        base.deps,
        Vec::from_array([binding]),
    );
    match interface_codec::encode_binary(unit) {
        Ok(bytes) => testing::assert(interface_codec::decode_binary(bytes).is_err()),
        Err(message) => testing::fail(message),
    }
}

#[test]
fn foreign_interface_checks_public_callables_against_metadata() -> () {
    let base = binary_interface_fixture();
    base.exports.functions.push(
        artifact::ArtifactFnScheme {
            name: "audit::value::abs",
            comptime: tast::ComptimeCapability::RuntimeOnly,
            type_params: Vec::new(),
            constraints: Vec::new(),
            ty: tast::Type::Func {
                params: Vec::from_array([tast::Type::Float64]),
                ret_ty: tast::Type::Float64,
            },
            body: tast::Callable::GoForeign { binding: "", import_path: "math", symbol: "Abs" },
        },
    );
    let public = match foreign_interface_bindings(base, Vec::new()) {
        Ok(bindings) => bindings,
        Err(message) => {
            testing::fail(message);
            Vec::new()
        },
    };
    testing::assert_eq(public.len(), 1);
    let binding = public[0];
    base.foreign_bindings.push(
        ffi::ForeignBinding {
            call_mode: ffi::ForeignCallMode::Ordinary,
            binding_id: binding.binding_id,
            import_path: binding.import_path,
            symbol: "Floor",
            parameters: binding.parameters,
            results: binding.results,
        },
    );
    testing::assert(foreign_interface_bindings(base, Vec::new()).is_err())
}

#[test]
fn foreign_callable_artifacts_cannot_be_comptime() -> () {
    let base = binary_interface_fixture();
    base.exports.functions.push(
        artifact::ArtifactFnScheme {
            name: "audit::value::abs",
            comptime: tast::ComptimeCapability::Capable,
            type_params: Vec::new(),
            constraints: Vec::new(),
