package main;

use module::artifact::wire as wire;
use module::ast;
use module::parser;
use std::io;
use std::text;

struct PackageInfoArgs {
    inputs: Vec[string],
}

fn parse_package_info_args(args: Vec[string]) -> Result[PackageInfoArgs, string] {
    let inputs: Vec[string] = Vec::new();
    let mut format: Option[string] = Option::None;
    let mut index = 2;
    let mut positional = false;
    while index < args.len() {
        let argument = args[index];
        if !positional && argument == "--" {
            positional = true;
            index += 1;
        } else if !positional && cli_help_argument(argument) {
            return Result::Err(cli_help_signal())
        } else if !positional && option_string_present(inline_cli_value(argument, "--help")) {
            let value = inline_cli_value(argument, "--help").unwrap_or("");
            return Result::Err(
                unexpected_value_error_with_usage(
                    value,
                    "--help",
                    "gomlc package-info --help --input <INPUT>...",
                ),
            )
        } else if positional {
            return Result::Err(unexpected_argument_error(PACKAGE_INFO_COMMAND, argument, false))
        } else if argument == "--input" {
            index += 1;
            let previous_len = inputs.len();
            while index < args.len() && !cli_option(args[index]) {
                inputs.push(args[index]);
                index += 1;
            }
            if inputs.len() == previous_len {
                return Result::Err(value_required_error("--input <INPUT>...", Option::None))
            }
        } else if option_string_present(inline_cli_value(argument, "--input")) {
            let value = inline_cli_value(argument, "--input").unwrap_or("");
            if value == "" {
                return Result::Err(value_required_error("--input <INPUT>...", Option::None))
            } else {
                inputs.push(value);
                index += 1;
                while index < args.len() && !cli_option(args[index]) {
                    inputs.push(args[index]);
                    index += 1;
                }
            }
        } else if argument == "--format" {
            if index + 1 >= args.len() || cli_option(args[index + 1]) {
                return Result::Err(value_required_error("--format <FORMAT>", Option::None))
            } else if option_string_present(format) {
                return Result::Err(
                    repeated_argument_error(PACKAGE_INFO_COMMAND, "--format <FORMAT>"),
                )
            } else {
                format = Option::Some(args[index + 1]);
                index += 2;
            }
        } else if option_string_present(inline_cli_value(argument, "--format")) {
            if option_string_empty(inline_cli_value(argument, "--format")) {
                return Result::Err(value_required_error("--format <FORMAT>", Option::None))
            } else if option_string_present(format) {
                return Result::Err(
                    repeated_argument_error(PACKAGE_INFO_COMMAND, "--format <FORMAT>"),
                )
            } else {
                format = inline_cli_value(argument, "--format");
                index += 1;
            }
        } else {
            return Result::Err(
                unexpected_cli_option_error_with_usage(
                    PACKAGE_INFO_COMMAND,
                    argument,
                    command_usage(PACKAGE_INFO_COMMAND),
                ),
            )
        }
    }
    let selected_format = format.unwrap_or("json");
    if selected_format != "json" {
        Result::Err(
            "error: invalid value '" + selected_format
                + "' for '--format <FORMAT>'\n  [possible values: json]\n\n"
                + cli_error_footer(),
        )
    } else if inputs.is_empty() {
        Result::Err(
            missing_required_arguments_error_with_usage(
                Vec::from_array(["--input <INPUT>..."]),
                required_command_usage(PACKAGE_INFO_COMMAND),
            ),
        )
    } else {
        Result::Ok(PackageInfoArgs { inputs: sorted_unique_package_inputs(inputs) })
    }
}

struct PackageInfoUse {
    alias: Option[string],
    path: string,
}

struct PackageInfoFile {
    go_foreign: bool,
    package_name: string,
    package_explicit: bool,
    uses: Vec[PackageInfoUse],
}

struct PackageInfoScanner {
    source: string,
    index: Ref[isize],
}

fn new_package_info_scanner(source: string) -> PackageInfoScanner {
    PackageInfoScanner { source, index: Ref::new(0) }
}

fn package_info_ident_continue(value: u8) -> bool {
    (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || (value >= 48 && value <= 57)
        || value == 95
}

fn package_info_skip_trivia(scanner: PackageInfoScanner) -> () {
    while scanner.index.get() < scanner.source.byte_len() {
        let index = scanner.index.get();
        let value = scanner.source.byte_get(index);
        if value == 32 || value == 9 || value == 10 || value == 13 {
            scanner.index.set(index + 1)
        } else if index + 1 < scanner.source.byte_len() && value == 47
            && scanner.source.byte_get(index + 1) == b'/' {
            scanner.index.set(index + 2);
            while scanner.index.get() < scanner.source.byte_len()
                && scanner.source.byte_get(scanner.index.get()) != b'\n' {
                scanner.index.set(scanner.index.get() + 1)
            }
        } else {
            break
        }
    }
}

fn package_info_at_text(scanner: PackageInfoScanner, expected: string) -> bool {
    let start = scanner.index.get();
    let end = start + expected.byte_len();
    end <= scanner.source.byte_len() && text::starts_with_at(scanner.source, start, expected)
}

fn package_info_at_keyword(scanner: PackageInfoScanner, expected: string) -> bool {
    let end = scanner.index.get() + expected.byte_len();
    package_info_at_text(scanner, expected)
        && (end >= scanner.source.byte_len()
            || !package_info_ident_continue(scanner.source.byte_get(end)))
}

fn package_info_consume_text(scanner: PackageInfoScanner, expected: string) -> bool {
    package_info_skip_trivia(scanner);
    if package_info_at_text(scanner, expected) {
        scanner.index.set(scanner.index.get() + expected.byte_len());
        true
    } else {
        false
    }
}

fn package_info_consume_keyword(scanner: PackageInfoScanner, expected: string) -> bool {
    package_info_skip_trivia(scanner);
    if package_info_at_keyword(scanner, expected) {
        scanner.index.set(scanner.index.get() + expected.byte_len());
        true
    } else {
        false
    }
}

fn package_info_read_ident(scanner: PackageInfoScanner) -> Option[string] {
    package_info_skip_trivia(scanner);
    if scanner.index.get() >= scanner.source.byte_len() {
        Option::None
    } else {
        let start = scanner.index.get();
        let first = scanner.source.byte_get(start);
        if !((first >= b'A' && first <= b'Z') || (first >= b'a' && first <= b'z') || first == b'_') {
            Option::None
        } else {
            scanner.index.set(start + 1);
            while scanner.index.get() < scanner.source.byte_len()
                && package_info_ident_continue(scanner.source.byte_get(scanner.index.get())) {
                scanner.index.set(scanner.index.get() + 1)
            }
            Option::Some(scanner.source.byte_slice(start, scanner.index.get()))
        }
    }
}

fn package_info_lower_ident(value: string) -> bool {
    if value.byte_len() == 0 {
        false
    } else {
        let first = value.byte_get(0);
        (first >= b'a' && first <= b'z') || first == b'_'
    }
}

fn package_info_error(source_path: string, message: string) -> string {
    "error[parser]: " + source_path + ": " + message
}

fn package_info_expect_text(
    scanner: PackageInfoScanner,
    expected: string,
    source_path: string,
    message: string,
) -> Result[(), string] {
    if package_info_consume_text(scanner, expected) {
        Result::Ok(())
    } else {
        Result::Err(package_info_error(source_path, message))
    }
}

fn package_info_parse_use(scanner: PackageInfoScanner, source_path: string) -> Result[
    PackageInfoUse,
    string,
] {
    let first = match package_info_read_ident(scanner) {
        Some(value) => value,
        None => {
            return Result::Err(package_info_error(source_path, "expected a path after `use`"))
        },
    };
    let path = text::StringBuilder::new();
    path.write_string(first);
    package_info_skip_trivia(scanner);
    let mut braced = false;
    while package_info_consume_text(scanner, "::") {
        if package_info_consume_text(scanner, "{") {
            braced = true;
            if package_info_consume_text(scanner, "}") {
                return Result::Err(package_info_error(source_path, "use item list cannot be empty"))
            }
            let mut done = false;
            while !done {
                if let None = package_info_read_ident(scanner) {
                    return Result::Err(package_info_error(source_path, "expected an imported item"))
                }
                if package_info_consume_keyword(scanner, "as") {
                    if let None = package_info_read_ident(scanner) {
                        return Result::Err(
                            package_info_error(source_path, "expected use item alias"),
                        )
                    }
                }
                if package_info_consume_text(scanner, ",") {
                    if package_info_consume_text(scanner, "}") {
                        done = true;
                    }
                } else if package_info_consume_text(scanner, "}") {
                    done = true;
                } else {
                    return Result::Err(
                        package_info_error(source_path, "expected ',' or '}' in use item list"),
                    )
                }
            }
            break
        } else {
            match package_info_read_ident(scanner) {
                Some(value) => {
                    path.write_string("::");
                    path.write_string(value);
                    package_info_skip_trivia(scanner)
                },
                None => return Result::Err(
                    package_info_error(source_path, "expected a path segment after '::'"),
                ),
            }
        }
    }
    let alias: Ref[Option[string]] = Ref::new(Option::None);
    if !braced && package_info_consume_keyword(scanner, "as") {
        match package_info_read_ident(scanner) {
            Some(value) => alias.set(Option::Some(value)),
            None => {
                return Result::Err(package_info_error(source_path, "expected use alias"))
            },
        }
    }
    let path = path.finish();
    let alias = match alias.get() {
        Some(value) => Option::Some(value),
        None => if braced {
            Option::None
        } else {
            let segments = text::split(path, "::");
            Option::Some(segments[segments.len() - 1])
        },
    };
    package_info_expect_text(scanner, ";", source_path, "expected ';'").map(
        |_| PackageInfoUse { alias, path },
    )
}

fn parse_package_info_file(source_path: string, source: string) -> Result[PackageInfoFile, string] {
    let scanner = new_package_info_scanner(source);
    package_info_skip_trivia(scanner);
    let declared_package = if package_info_consume_keyword(scanner, "package") {
        let package_name = match package_info_read_ident(scanner) {
            Some(value) => if !package_info_lower_ident(value) {
                return Result::Err(
                    package_info_error(
                        source_path,
                        "package name must start with a lowercase letter or `_`",
                    ),
                )
            } else {
                value
            },
            None => {
                return Result::Err(package_info_error(source_path, "expected package name"))
            },
        };
        package_info_expect_text(scanner, ";", source_path, "expected ';'")?;
        (package_name, true)
    } else {
        ("main", false)
    };
    let uses: Vec[PackageInfoUse] = Vec::new();
    package_info_skip_trivia(scanner);
    let mut parsing_uses = true;
    while parsing_uses {
        let start = scanner.index.get();
        let is_use = package_info_consume_keyword(scanner, "use");
        let is_public_use = if !is_use && package_info_consume_keyword(scanner, "pub") {
            if package_info_consume_keyword(scanner, "use") {
                true
            } else {
                scanner.index.set(start);
                false
            }
        } else {
            false
        };
        if is_use || is_public_use {
            let value = package_info_parse_use(scanner, source_path)?;
            uses.push(value);
            package_info_skip_trivia(scanner)
        } else {
            parsing_uses = false;
        };
    }
    let resolved_uses: Vec[PackageInfoUse] = Vec::new();
    for index in 0..uses.len() {
        let current = uses[index];
        let mut path = current.path;
        let mut remaining = uses.len() + 1;
        while remaining > 0 && !path.starts_with("module::") {
            let mut changed = false;
            for candidate in uses {
                if let Some(alias) = candidate.alias {
                    if (path == alias || path.starts_with(alias + "::")) && path != candidate.path {
                        path = candidate.path;
                        changed = true;
                        break
                    }
                }
            }
            if changed {
                remaining -= 1;
            } else {
                remaining = 0;
            }
        }
        resolved_uses.push(PackageInfoUse { alias: current.alias, path })
    }
    Result::Ok(
        PackageInfoFile {
            go_foreign: source_declares_go_foreign(source),
            package_name: declared_package.0,
            package_explicit: declared_package.1,
            uses: resolved_uses,
        },
    )
}

fn package_info_json(args: PackageInfoArgs) -> string {
    let writer = wire::new_artifact_json_writer(false);
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "files");
    wire::artifact_json_begin_array(writer);
    for source_path in args.inputs {
        let source = read_source(source_path);
        let file = match parse_package_info_file(source_path, source) {
            Ok(value) => value,
            Err(error) => {
                fail(error);
                PackageInfoFile {
                    go_foreign: false,
                    package_name: "",
                    package_explicit: false,
                    uses: Vec::new(),
                }
            },
        };
        wire::artifact_json_begin_object(writer);
        wire::artifact_json_name(writer, "package");
        wire::artifact_json_string(writer, file.package_name);
        wire::artifact_json_name(writer, "go_foreign");
        wire::artifact_json_bool(writer, file.go_foreign);
        wire::artifact_json_name(writer, "package_explicit");
        wire::artifact_json_bool(writer, file.package_explicit);
        wire::artifact_json_name(writer, "path");
        wire::artifact_json_string(writer, source_path);
        wire::artifact_json_name(writer, "uses");
        wire::artifact_json_begin_array(writer);
        for use_decl in file.uses {
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "alias");
            match use_decl.alias {
                Some(value) => wire::artifact_json_string(writer, value),
                None => wire::artifact_json_null(writer),
            }
            wire::artifact_json_name(writer, "path");
            wire::artifact_json_string(writer, use_decl.path);
            wire::artifact_json_end_object(writer)
        }
        wire::artifact_json_end_array(writer);
        wire::artifact_json_end_object(writer)
    }
    wire::artifact_json_end_array(writer);
    wire::artifact_json_name(writer, "protocol_version");
    wire::artifact_json_number(writer, "1");
    wire::artifact_json_end_object(writer);
    wire::artifact_json_finish(writer)
}

fn run_package_info(args: Vec[string]) -> () {
    match parse_package_info_args(args) {
        Ok(value) => io::println(package_info_json(value)),
        Err(error) => handle_cli_parse_error(PACKAGE_INFO_COMMAND, error),
    }
}

fn source_declares_go_foreign(source: string) -> bool {
    if !source.contains("go_ffi") && !source.contains("go_type") {
        return false
    }
    let lowered = ast::lower(parser::parse(source));
    if let Some(file) = lowered.ast {
        for item in file.items {
            if let ExternType(_) = item {
                return true
            }
            if let ExternFunction(function) = item {
                for attribute in function.attrs {
                    if attribute.name == "go_ffi" {
                        return true
                    }
                }
            }
        }
    }
    false
}
