package main;

use module::api;
use module::artifact;
use module::compiler;
use std::fs;
use std::io;
use std::process;

fn api_snapshot_command(args: Vec[string]) -> Result[(), string] {
    let mut module_name = "";
    let units: Vec[artifact::ArtifactInterfaceUnit] = Vec::new();
    let dependencies: Vec[artifact::ArtifactInterfaceUnit] = Vec::new();
    let mut index = 2;
    while index < args.len() {
        let argument = args[index];
        if argument != "--module" && argument != "--input" && argument != "--dependency" {
            return Err("usage: gomlc api-snapshot --module NAME --input INTERFACE ...")
        }
        index += 1;
        if index >= args.len() {
            return Err(argument + " requires a value")
        }
        if argument == "--module" {
            if module_name != "" {
                return Err("--module cannot be repeated")
            }
            module_name = args[index];
        } else if argument == "--dependency" {
            dependencies.push(compiler::artifact_read_interface_unit(args[index])?)
        } else {
            units.push(compiler::artifact_read_interface_unit(args[index])?)
        }
        index += 1;
    }
    if module_name == "" || units.is_empty() {
        return Err("API snapshot requires a module and at least one interface")
    }
    io::print(api::snapshot_with_dependencies(module_name, units, dependencies)?);
    Ok(())
}

fn run_api_snapshot_command(args: Vec[string]) -> () {
    if let Err(error) = api_snapshot_command(args) {
        io::eprintln("error: " + error);
        process::exit(1)
    }
}

fn run_api_diff_command(args: Vec[string]) -> () {
    if args.len() != 4 {
        io::eprintln("usage: gomlc api-diff BASELINE CURRENT");
        process::exit(2)
    }
    let result = fs::read_file_structured(args[2]).map_err(|error| error.to_string()).and_then(
        |baseline| fs::read_file_structured(args[3]).map_err(|error| error.to_string()).and_then(
            |current| api::diff(baseline, current),
        ),
    );
    match result {
        Ok(value) => {
            io::print(value.output);
            if value.requires_review {
                process::exit(1)
            }
        },
        Err(error) => {
            io::eprintln("error: " + error);
            process::exit(2)
        },
    }
}
