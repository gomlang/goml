package main;

use module::artifact::tast_codec;
use module::artifact::wire;
use module::tast;
use std::testing;

#[test]
fn foreign_callable_origins_accept_legacy_bodies_and_reject_invalid_ids() -> () {
    for method in Vec::from_array([false, true]) {
        for with_id in Vec::from_array([false, true]) {
            let fields = Vec::from_array(
                [
                    (
                        "kind",
                        wire::ArtifactValue::String(
                            if method {
                                "go_method"
                            } else {
                                "go"
                            },
                        ),
                    ),
                    ("symbol", wire::ArtifactValue::String("Value")),
                ],
            );
            if !method {
                fields.push(("import_path", wire::ArtifactValue::String("example.com/host")))
            }
            if with_id {
                fields.push(("id", wire::ArtifactValue::String("audit::value::read")))
            }
            let restored = tast_codec::artifact_decode_callable_body(
                "read",
                wire::ArtifactValue::Object(fields),
            );
            match restored {
                Ok(callable) => {
                    let binding = match callable {
                        GoForeign { binding, .. } | GoMethod { binding, .. } => binding,
                        _ => "wrong callable",
                    };
                    testing::assert_eq(
                        binding,
                        if with_id {
                            "audit::value::read"
                        } else {
                            ""
                        },
                    );
                    let encoded = tast_codec::artifact_callable(callable);
                    match encoded.id {
                        Some(value) => {
                            testing::assert(with_id);
                            testing::assert_eq(value, "audit::value::read")
                        },
                        None => testing::assert(!with_id),
                    }
                },
                Err(error) => testing::fail(error),
            }
        }
        for id in Vec::from_array([wire::ArtifactValue::Number("1"), wire::ArtifactValue::Null]) {
            let fields = Vec::from_array(
                [
                    (
                        "kind",
                        wire::ArtifactValue::String(
                            if method {
                                "go_method"
                            } else {
                                "go"
                            },
                        ),
                    ),
                    ("symbol", wire::ArtifactValue::String("Value")),
                    ("id", id),
                ],
            );
            if !method {
                fields.push(("import_path", wire::ArtifactValue::String("example.com/host")))
            }
            testing::assert(
                tast_codec::artifact_decode_callable_body(
                    "read",
                    wire::ArtifactValue::Object(fields),
                ).is_err(),
            );
        }
    }
}
