package main;

use module::test_support;
use std::fs;
use std::path;
use std::process;
use std::testing;
use std::utf8;
use utf8::BytesUtf8;

#[test]
fn callable_capabilities_fail_before_runtime_and_preserve_valid_ctfe() -> () {
    let temporary = temp_go_path("callable-capability.goml", "comptime");
    let source_path = path::join(path::parent(temporary).unwrap_or(""), "main.goml");
    let cases = Vec::from_array(
        [
            (
                "fn main() -> () { let error = compile_error; error(\"runtime\"); }",
                "compile_error is only available in comptime",
            ),
            (
                "#[comptime_derive] fn hidden(value: i32) -> i32 { value + 1 } fn main() -> () { let f = hidden; println(f(5)); }",
                "#[comptime_derive] function is only callable from another derive handler",
            ),
            (
                "#[comptime] fn increment(value: i32) -> i32 { value + 1 } fn main() -> () { let f = increment; println(f(4)); println(comptime { let g = increment; g(6) }); }",
                "",
            ),
        ],
    );
    for test_case in cases {
        testing::expect_ok(
            fs::write_file_structured(source_path, test_case.0),
            "write capability fixture",
        );
        let compiler = testing::expect_ok(test_support::compiler_path(), "capability compiler path");
        let command = process::Command::new(compiler).args(
            Vec::from_array(["run-single", source_path]),
        );
        let output = testing::expect_ok(command.output_structured(), "run capability fixture");
        let stderr = output.stderr().to_string_utf8().unwrap_or("");
        let stdout = output.stdout().to_string_utf8().unwrap_or("");
        let valid = if test_case.1 == "" {
            output.status().success() && stdout == "5\n7\n"
        } else {
            !output.status().success() && stderr.contains(test_case.1)
                && !stderr.contains("invalid ANF")
                && !stderr.contains("panic:")
        };
        if !valid {
            cleanup_temp_directory(temporary);
            testing::fail(
                "capability fixture: " + test_case.0 + "\nexpected: " + test_case.1 + "\nstdout: "
                    + stdout
                    + "\nstderr: "
                    + stderr,
            );
        }
    }
    cleanup_temp_directory(temporary);
}
