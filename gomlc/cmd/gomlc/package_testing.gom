package main;

use module::artifact;
use module::ast;
use module::hash;
use module::tast;
use std::cmp;
use std::collections;
use std::text;

struct TestCandidate {
    name: string,
    source_path: string,
    start: isize,
    end: isize,
    label_end: isize,
    ignored: bool,
    ignore_reason: Option[string],
    arguments: Vec[(string, string)],
}

struct TestCandidateCollection {
    candidates: Vec[TestCandidate],
    diagnostics: Vec[tast::Diagnostic],
}

struct TestValidation {
    tests: Vec[artifact::ArtifactTestDescriptor],
    diagnostics: Vec[tast::Diagnostic],
}

fn named_test_attributes(values: Vec[ast::Attribute], expected: string) -> Vec[ast::Attribute] {
    let result: Vec[ast::Attribute] = Vec::new();
    for value in values {
        if value.name == expected {
            result.push(value)
        }
    }
    result
}

fn test_symbol(package_name: string, name: string) -> string {
    if package_name == "main" || package_name == "builtin" {
        name
    } else {
        package_name + "::" + name
    }
}

fn package_test_diagnostic(stage: string, message: string, source_path: string, span: ast::Span) -> tast::Diagnostic {
    tast::Diagnostic {
        severity: tast::DiagnosticSeverity::Error,
        stage,
        message,
        source_path,
        span: Option::Some(span),
        primary_label: Option::None,
        secondary_labels: Vec::new(),
        sort_order: 0,
    }
}

fn duplicate_test_id_diagnostic(id: string, candidate: TestCandidate, first: TestCandidate) -> tast::Diagnostic {
    let secondary_labels: Vec[tast::DiagnosticLabel] = Vec::new();
    secondary_labels.push(
        tast::DiagnosticLabel {
            message: "first test declared here",
            source_path: first.source_path,
            span: ast::Span { start: first.start, end: first.label_end },
        },
    );
    tast::Diagnostic {
        severity: tast::DiagnosticSeverity::Error,
        stage: TYPER_STAGE,
        message: "duplicate test id `" + id + "`",
        source_path: candidate.source_path,
        span: Option::Some(ast::Span { start: candidate.start, end: candidate.label_end }),
        primary_label: Option::Some("duplicate test declared here"),
        secondary_labels,
        sort_order: 0,
    }
}

fn test_ignore_reason(
    attributes: Vec[ast::Attribute],
    source_path: string,
    diagnostics: Vec[tast::Diagnostic],
) -> Option[string] {
    if attributes.is_empty() {
        return Option::None
    }
    let attribute = attributes[0];
    if !attribute.has_argument_list {
        Option::None
    } else if attribute.args.len() == 1 {
        match attribute.args[0] {
            String(reason) => Option::Some(reason),
            Ident(_) | Path(_) | Named { .. } => {
                diagnostics.push(
                    package_test_diagnostic(
                        "attribute",
                        "`#[ignore]` accepts either no arguments or one string reason",
                        source_path,
                        attribute.span,
                    ),
                );
                Option::None
            },
        }
    } else {
        diagnostics.push(
            package_test_diagnostic(
                "attribute",
                "`#[ignore]` accepts either no arguments or one string reason",
                source_path,
                attribute.span,
            ),
        );
        Option::None
    }
}

fn collect_function_test(
    source_path: string,
    function: ast::Function,
    candidates: Vec[TestCandidate],
    diagnostics: Vec[tast::Diagnostic],
) -> () {
    let test_attrs = named_test_attributes(function.attrs, "test");
    let case_attrs = named_test_attributes(function.attrs, "test_case");
    let ignore_attrs = named_test_attributes(function.attrs, "ignore");
    if test_attrs.len() > 1 {
        for index in 1..test_attrs.len() {
            let attribute = test_attrs[index];
            diagnostics.push(
                package_test_diagnostic(
                    "attribute",
                    "duplicate `#[test]` attribute",
                    source_path,
                    attribute.span,
                ),
            )
        }
    }
    if ignore_attrs.len() > 1 {
        for index in 1..ignore_attrs.len() {
            let attribute = ignore_attrs[index];
            diagnostics.push(
                package_test_diagnostic(
                    "attribute",
                    "duplicate `#[ignore]` attribute",
                    source_path,
                    attribute.span,
                ),
            )
        }
    }
    if test_attrs.is_empty() && case_attrs.is_empty() {
        for attribute in ignore_attrs {
            diagnostics.push(
                package_test_diagnostic(
                    "attribute",
                    "`#[ignore]` requires `#[test]`",
                    source_path,
                    attribute.span,
                ),
            )
        }
        return
    }
    if !test_attrs.is_empty() && !case_attrs.is_empty() {
        diagnostics.push(
            package_test_diagnostic(
                "attribute",
                "`#[test]` and `#[test_case(...)]` cannot be combined",
                source_path,
                case_attrs[0].span,
            ),
        );
        return
    }
    if !case_attrs.is_empty() {
        let ignore_reason = test_ignore_reason(ignore_attrs, source_path, diagnostics);
        for case_attr in case_attrs {
            let arguments: Vec[(string, string)] = Vec::new();
            let mut valid = case_attr.has_argument_list && !case_attr.args.is_empty();
            if !valid {
                diagnostics.push(
                    package_test_diagnostic(
                        "attribute",
                        "`#[test_case(...)]` requires at least one string or boolean argument",
                        source_path,
                        case_attr.span,
                    ),
                )
            }
            for argument in case_attr.args {
                match argument {
                    String(value) => arguments.push(("string", value)),
                    Ident(value) => if value == "true" || value == "false" {
                        arguments.push(("bool", value))
                    } else {
                        valid = false;
                        diagnostics.push(
                            package_test_diagnostic(
                                "attribute",
                                "test case arguments must be string or boolean literals",
                                source_path,
                                case_attr.span,
                            ),
                        )
                    },
                    Path(_) | Named { .. } => {
                        valid = false;
                        diagnostics.push(
                            package_test_diagnostic(
                                "attribute",
                                "test case arguments must be string or boolean literals",
                                source_path,
                                case_attr.span,
                            ),
                        )
                    },
                }
            }
            if valid {
                candidates.push(
                    TestCandidate {
                        name: function.name,
                        source_path,
                        start: case_attr.span.start,
                        end: case_attr.span.end,
                        label_end: case_attr.span.end,
                        ignored: !ignore_attrs.is_empty(),
                        ignore_reason,
                        arguments,
                    },
                )
            }
        }
        return
    }
    let test_attr = test_attrs[0];
    if test_attr.has_argument_list {
        diagnostics.push(
            package_test_diagnostic(
                "attribute",
                "`#[test]` does not accept arguments",
                source_path,
                test_attr.span,
            ),
        );
        return
    }
    let ignore_reason = test_ignore_reason(ignore_attrs, source_path, diagnostics);
    candidates.push(
        TestCandidate {
            name: function.name,
            source_path,
            start: test_attr.span.start,
            end: test_attr.span.end,
            label_end: test_attr.span.end,
            ignored: !ignore_attrs.is_empty(),
            ignore_reason,
            arguments: Vec::new(),
        },
    )
}

fn reject_item_test_attributes(
    values: Vec[ast::Attribute],
    target: string,
    source_path: string,
    diagnostics: Vec[tast::Diagnostic],
) -> () {
    for value in values {
        if value.name == "test" || value.name == "test_case" {
            diagnostics.push(
                package_test_diagnostic(
                    "attribute",
                    "test attributes can only be applied to top-level functions, not " + target,
                    source_path,
                    value.span,
                ),
            )
        } else if value.name == "ignore" {
            diagnostics.push(
                package_test_diagnostic(
                    "attribute",
                    "`#[ignore]` requires a top-level `#[test]` function",
                    source_path,
                    value.span,
                ),
            )
        }
    }
}

fn sort_test_descriptors(values: Vec[artifact::ArtifactTestDescriptor]) -> Vec[
    artifact::ArtifactTestDescriptor,
] {
    collections::sort_by_ordering(
        values,
        |left: artifact::ArtifactTestDescriptor, right: artifact::ArtifactTestDescriptor| cmp::compare(
            left.id,
            right.id,
        ),
    );
    values
}

fn collect_package_test_candidates(files: Vec[ast::LowerResult], source_paths: Vec[string]) -> TestCandidateCollection {
    let candidates: Vec[TestCandidate] = Vec::new();
    let diagnostics: Vec[tast::Diagnostic] = Vec::new();
    for file_index in 0..files.len() {
        let source_path = if file_index < source_paths.len() {
            source_paths[file_index]
        } else {
            UNKNOWN_SOURCE_PATH
        };
        if let Some(file) = files[file_index].ast {
            for item in file.items {
                match item {
                    Function(function) => collect_function_test(
                        source_path,
                        function,
                        candidates,
                        diagnostics,
                    ),
                    ImplBlock(block) => {
                        reject_item_test_attributes(
                            block.attrs,
                            "impl block",
                            source_path,
                            diagnostics,
                        );
                        for method in block.methods {
                            reject_item_test_attributes(
                                method.attrs,
                                "impl method",
                                source_path,
                                diagnostics,
                            )
                        }
                    },
                    ExternFunction(function) => reject_item_test_attributes(
                        function.attrs,
                        "extern function",
                        source_path,
                        diagnostics,
                    ),
                    EnumDef(definition) => reject_item_test_attributes(
                        definition.attrs,
                        "enum",
                        source_path,
                        diagnostics,
                    ),
                    StructDef(definition) => reject_item_test_attributes(
                        definition.attrs,
                        "struct",
                        source_path,
                        diagnostics,
                    ),
                    TraitDef(definition) => reject_item_test_attributes(
                        definition.attrs,
                        "trait",
                        source_path,
                        diagnostics,
                    ),
                    ExternType(definition) => reject_item_test_attributes(
                        definition.attrs,
                        "external type",
                        source_path,
                        diagnostics,
                    ),
                    TypeAlias(definition) => reject_item_test_attributes(
                        definition.attrs,
                        "type alias",
                        source_path,
                        diagnostics,
                    ),
                    Constant(definition) => reject_item_test_attributes(
                        definition.attrs,
                        "constant",
                        source_path,
                        diagnostics,
                    ),
                    Static(definition) => reject_item_test_attributes(
                        definition.attrs,
                        "static",
                        source_path,
                        diagnostics,
                    ),
                }
            }
        }
    }
    TestCandidateCollection { candidates, diagnostics }
}

fn find_test_scheme(exports: artifact::ArtifactPackageExports, symbol: string) -> Option[
    artifact::ArtifactFnScheme,
] {
    for function in exports.functions {
        if function.name == symbol {
            return Option::Some(function)
        }
    }
    Option::None
}

fn test_arguments_key(arguments: Vec[(string, string)]) -> string {
    let result = text::StringBuilder::new();
    for argument in arguments {
        result.write_string(argument.0.byte_len().to_string());
        result.write_char(':');
        result.write_string(argument.0);
        result.write_string(argument.1.byte_len().to_string());
        result.write_char(':');
        result.write_string(argument.1)
    }
    result.finish()
}

fn test_candidate_id(package_name: string, candidate: TestCandidate) -> string {
    let symbol = test_symbol(package_name, candidate.name);
    if candidate.arguments.is_empty() {
        symbol
    } else {
        symbol + "::case_"
            + hash::sha256_prefix(symbol + "\n" + test_arguments_key(candidate.arguments))
    }
}

fn test_candidate_display(package_name: string, candidate: TestCandidate) -> string {
    let symbol = test_symbol(package_name, candidate.name);
    if candidate.arguments.is_empty() {
        symbol
    } else {
        let values: Vec[string] = Vec::new();
        for argument in candidate.arguments {
            values.push(
                if argument.0 == "string" {
                    "\"" + argument.1 + "\""
                } else {
                    argument.1
                },
            )
        }
        symbol + "(" + text::join(values, ", ") + ")"
    }
}

fn find_valid_test_candidate(package_name: string, values: Vec[TestCandidate], id: string) -> Option[
    TestCandidate,
] {
    for value in values {
        if test_candidate_id(package_name, value) == id {
            return Option::Some(value)
        }
    }
    Option::None
}

fn validate_package_tests(
    package_name: string,
    candidates: Vec[TestCandidate],
    exports: artifact::ArtifactPackageExports,
) -> TestValidation {
    let tests: Vec[artifact::ArtifactTestDescriptor] = Vec::new();
    let valid_candidates: Vec[TestCandidate] = Vec::new();
    let diagnostics: Vec[tast::Diagnostic] = Vec::new();
    for candidate in candidates {
        let span = ast::Span { start: candidate.start, end: candidate.end };
        let symbol = test_symbol(package_name, candidate.name);
        let id = test_candidate_id(package_name, candidate);
        let scheme = match find_test_scheme(exports, symbol) {
            Some(value) => value,
            None => {
                diagnostics.push(
                    package_test_diagnostic(
                        TYPER_STAGE,
                        "test function `" + candidate.name + "` was not resolved",
                        candidate.source_path,
                        span,
                    ),
                );
                continue
            },
        };
        let diagnostic_count = diagnostics.len();
        if candidate.name == "main" {
            diagnostics.push(
                package_test_diagnostic(
                    TYPER_STAGE,
                    "the main function cannot be a test",
                    candidate.source_path,
                    span,
                ),
            )
        }
        if !scheme.type_params.is_empty() {
            diagnostics.push(
                package_test_diagnostic(
                    TYPER_STAGE,
                    "test function `" + candidate.name + "` must not have type parameters",
                    candidate.source_path,
                    span,
                ),
            )
        }
        match tast::resolve_type(scheme.ty) {
            Func { params, ret_ty } => {
                if params.len() != candidate.arguments.len() {
                    diagnostics.push(
                        package_test_diagnostic(
                            TYPER_STAGE,
                            if candidate.arguments.is_empty() {
                                "test function `" + candidate.name + "` must not have parameters"
                            } else {
                                f"test function `{candidate.name}` expects {params.len()} parameters but the case provides {candidate.arguments.len()}"
                            },
                            candidate.source_path,
                            span,
                        ),
                    )
                }
                if params.len() == candidate.arguments.len() {
                    for index in 0..params.len() {
                        let valid = match tast::resolve_type(params[index]) {
                            String => candidate.arguments[index].0 == "string",
                            Bool => candidate.arguments[index].0 == "bool",
                            _ => false,
                        };
                        if !valid {
                            diagnostics.push(
                                package_test_diagnostic(
                                    TYPER_STAGE,
                                    f"test case argument {index}"
                                        + " does not match parameter type "
                                        + tast::diagnostic_type_text(params[index]),
                                    candidate.source_path,
                                    span,
                                ),
                            )
                        }
                    }
                }
                match tast::resolve_type(ret_ty) {
                    Unit => (),
                    actual => {
                        diagnostics.push(
                            package_test_diagnostic(
                                TYPER_STAGE,
                                "test function `" + candidate.name + "` must return (), found "
                                    + tast::diagnostic_type_text(actual),
                                candidate.source_path,
                                span,
                            ),
                        )
                    },
                }
            },
            other => {
                diagnostics.push(
                    package_test_diagnostic(
                        TYPER_STAGE,
                        "test item `" + candidate.name + "` must be a function, found "
                            + tast::diagnostic_type_text(other),
                        candidate.source_path,
                        span,
                    ),
                )
            },
        }
        if diagnostics.len() == diagnostic_count {
            match find_valid_test_candidate(package_name, valid_candidates, id) {
                Some(first) => diagnostics.push(
                    duplicate_test_id_diagnostic(symbol, candidate, first),
                ),
                None => {
                    tests.push(
                        artifact::ArtifactTestDescriptor {
                            id,
                            package_name,
                            symbol,
                            display_name: test_candidate_display(package_name, candidate),
                            source_path: candidate.source_path,
                            start: candidate.start,
                            end: candidate.end,
                            ignored: candidate.ignored,
                            ignore_reason: candidate.ignore_reason,
                            arguments: candidate.arguments,
                        },
                    );
                    valid_candidates.push(candidate)
                },
            }
        }
    }
    TestValidation { tests: sort_test_descriptors(tests), diagnostics }
}

fn write_test_json_hex(builder: text::StringBuilder, value: u8) -> () {
    let digits = "0123456789abcdef";
    builder.write_char(digits.get((value / 16).to_isize()));
    builder.write_char(digits.get((value % 16).to_isize()))
}

fn write_test_json_string(builder: text::StringBuilder, value: string) -> () {
    builder.write_char('"');
    let mut index = 0;
    while index < value.byte_len() {
        let byte = value.byte_get(index);
        if byte == b'"' {
            builder.write_string("\\\"");
            index += 1;
        } else if byte == b'\\' {
            builder.write_string("\\\\");
            index += 1;
        } else if byte == b'\b' {
            builder.write_string("\\b");
            index += 1;
        } else if byte == b'\f' {
            builder.write_string("\\f");
            index += 1;
        } else if byte == b'\n' {
            builder.write_string("\\n");
            index += 1;
        } else if byte == b'\r' {
            builder.write_string("\\r");
            index += 1;
        } else if byte == b'\t' {
            builder.write_string("\\t");
            index += 1;
        } else if byte < b' ' {
            builder.write_string("\\u00");
            write_test_json_hex(builder, byte);
            index += 1;
        } else {
            let width = if byte < 128 {
                1
            } else if byte < 224 {
                2
            } else if byte < 240 {
                3
            } else {
                4
            };
            builder.write_string(value.byte_slice(index, index + width));
            index += width;
        }
    }
    builder.write_char('"')
}

fn encode_test_manifest(values: Vec[artifact::ArtifactTestDescriptor]) -> string {
    let builder = text::StringBuilder::new();
    builder.write_char('[');
    for index in 0..values.len() {
        let value = values[index];
        if index > 0 {
            builder.write_char(',')
        }
        builder.write_string(
            \\
            \\  {
            \\    "id": 
            ,
        );
        write_test_json_string(builder, value.id);
        builder.write_string(
            \\,
            \\    "package": 
            ,
        );
        write_test_json_string(builder, value.package_name);
        builder.write_string(
            \\,
            \\    "symbol": 
            ,
        );
        write_test_json_string(builder, value.symbol);
        builder.write_string(
            \\,
            \\    "display_name": 
            ,
        );
        write_test_json_string(builder, value.display_name);
        builder.write_string(
            \\,
            \\    "source_path": 
            ,
        );
        write_test_json_string(builder, value.source_path);
        builder.write_string(
            \\,
            \\    "start": 
            ,
        );
        builder.write_string(value.start.to_string());
        builder.write_string(
            \\,
            \\    "end": 
            ,
        );
        builder.write_string(value.end.to_string());
        builder.write_string(
            \\,
            \\    "ignored": 
            ,
        );
        builder.write_string(
            if value.ignored {
                "true"
            } else {
                "false"
            },
        );
        builder.write_string(
            \\,
            \\    "ignore_reason": 
            ,
        );
        match value.ignore_reason {
            Some(reason) => write_test_json_string(builder, reason),
            None => builder.write_string("null"),
        }
        builder.write_string(
            \\,
            \\    "arguments": [
            ,
        );
        for argument_index in 0..value.arguments.len() {
            if argument_index > 0 {
                builder.write_char(',')
            }
            builder.write_string("{\"kind\":");
            write_test_json_string(builder, value.arguments[argument_index].0);
            builder.write_string(",\"value\":");
            write_test_json_string(builder, value.arguments[argument_index].1);
            builder.write_char('}')
        }
        builder.write_char(']');
        builder.write_string("\n  }")
    }
    if !values.is_empty() {
        builder.write_char('\n')
    }
    builder.write_char(']');
    builder.finish()
}

fn test_link_cases(values: Vec[artifact::ArtifactTestDescriptor]) -> Vec[
    (string, string, Vec[(string, string)]),
] {
    let result: Vec[(string, string, Vec[(string, string)])] = Vec::new();
    for value in values {
        result.push((value.id, value.symbol, value.arguments))
    }
    result
}
