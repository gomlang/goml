package main;

use module::compiler::{Compilation, compile_source, diagnostic_output, fail, read_source};
use module::diagnostic;
use module::artifact::interface_codec as interface_codec;
use module::artifact::wire as wire;
use module::artifact;
use module::anf;
use module::ast;
use module::core;
use module::cst;
use module::go_backend;
use module::hir;
use module::expand;
use module::ffi;
use module::lift;
use module::mono;
use module::parser;
use module::resources;
