package main;

use module::artifact::tast_codec;
use module::artifact::wire;
use module::core;
use module::tast;
use std::testing;

#[test]
fn go_interface_bridge_callable_round_trips_method_order_and_binding() -> () {
    let callable = tast::Callable::GoInterfaceBridge {
        binding: "app::reader::__bridge",
        methods: Vec::from_array(["Read", "Close"]),
    };
    let lowered = core::lower_callable(callable);
    let writer = wire::new_artifact_value_writer();
    tast_codec::artifact_json_callable_body(
        writer,
        tast_codec::artifact_callable(core::callable_to_tast(lowered)),
    );
    let Ok(value) = wire::artifact_value_finish(writer) else {
        testing::fail("bridge callable encoding failed");
        return
    };
    match tast_codec::artifact_decode_callable_body("ignored", value) {
        Ok(GoInterfaceBridge { binding, methods }) => {
            testing::assert_eq(binding, "app::reader::__bridge");
            testing::assert_eq(methods.len(), 2);
            testing::assert_eq(methods[0], "Read");
            testing::assert_eq(methods[1], "Close");
        },
        _ => testing::fail("bridge callable decoding failed"),
    }
    for methods in Vec::from_array(
        [
            wire::ArtifactValue::Null,
            wire::ArtifactValue::Array(Vec::from_array([wire::ArtifactValue::String("read")])),
            wire::ArtifactValue::Array(
                Vec::from_array(
                    [wire::ArtifactValue::String("Read"), wire::ArtifactValue::String("Read")],
                ),
            ),
            wire::ArtifactValue::Array(Vec::from_array([wire::ArtifactValue::Number("1")])),
        ],
    ) {
        let body = wire::ArtifactValue::Object(
            Vec::from_array(
                [
                    ("kind", wire::ArtifactValue::String("go_interface_bridge")),
                    ("id", wire::ArtifactValue::String("app::reader::__bridge")),
                    ("methods", methods),
                ],
            ),
        );
        testing::assert(tast_codec::artifact_decode_callable_body("ignored", body).is_err());
    }
}

#[test]
fn go_interface_bridge_callable_requires_native_factory_signature() -> () {
    let raw = tast::Type::External { import_path: "io", name: "Reader", args: Vec::new() };
    let signature = tast::Type::Func {
        params: Vec::from_array([tast::Type::MutSlice { elem: tast::Type::Uint8 }]),
        ret_ty: tast::Type::Tuple {
            items: Vec::from_array(
                [
                    tast::Type::Int,
                    tast::Type::External { import_path: "", name: "error", args: Vec::new() },
                ],
            ),
        },
    };
    let ty = tast::Type::Func { params: Vec::from_array([signature]), ret_ty: raw };
    testing::assert(
        tast::validate_go_interface_bridge_callable(Vec::from_array(["Read"]), ty).is_ok(),
    );
    testing::assert(tast::validate_go_interface_bridge_callable(Vec::new(), ty).is_err());
    testing::assert(
        tast::validate_go_interface_bridge_callable(Vec::from_array(["read"]), ty).is_err(),
    );
    testing::assert(
        tast::validate_go_interface_bridge_callable(Vec::from_array(["Read"]), signature).is_err(),
    );
    let invalid = tast::Type::Func {
        params: Vec::from_array(
            [
                tast::Type::Func {
                    params: Vec::from_array([tast::Type::String]),
                    ret_ty: tast::Type::Unit,
                },
            ],
        ),
        ret_ty: raw,
    };
    testing::assert(
        tast::validate_go_interface_bridge_callable(Vec::from_array(["Read"]), invalid).is_err(),
    );
}

#[test]
fn go_interface_bridge_metadata_rejects_unverified_target() -> () {
    let signature = tast::Type::Func {
        params: Vec::from_array([tast::Type::MutSlice { elem: tast::Type::Uint8 }]),
        ret_ty: tast::Type::Tuple {
            items: Vec::from_array(
                [
                    tast::Type::Int,
                    tast::Type::External { import_path: "", name: "error", args: Vec::new() },
                ],
            ),
        },
    };
    let constructor = tast::Type::Func {
        params: Vec::from_array([signature]),
        ret_ty: tast::Type::External { import_path: "io", name: "Reader", args: Vec::new() },
    };
    testing::assert(
        tast::validate_go_interface_bridge_callable(Vec::from_array(["Read"]), constructor).is_ok(),
    );
    testing::assert(
        validate_interface_bridge_metadata(Vec::from_array(["Read"]), constructor, Vec::new()).is_err(),
    );
}
