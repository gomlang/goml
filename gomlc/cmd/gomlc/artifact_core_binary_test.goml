package main;

use module::artifact::core_codec as core_codec;
use module::artifact::interface_codec as interface_codec;
use module::artifact::wire as wire;
use module::artifact;
use module::core;
use std::bytes;
use std::testing;

fn binary_core_fixture() -> artifact::ArtifactCoreUnit {
    let core_ir = empty_core_file();
    core_ir.functions.push(
        core::Function {
            name: "audit::value::choose",
            origin: core::FunctionOrigin::Source,
            root: true,
            generics: Vec::new(),
            predicates: Vec::new(),
            trait_impl: Option::None,
            params: Vec::new(),
            ret_ty: core::Type::Int,
            body: core::Block {
                stmts: Vec::new(),
                tail: Option::Some(
                    Loop {
                        body: core::Expr::Break {
                            target: 0,
                            value: Option::Some(
                                Prim {
                                    value: core::Primitive::Int { value: "7" },
                                    ty: core::Type::Int,
                                },
                            ),
                            ty: core::Type::Never,
                        },
                        ty: core::Type::Int,
                    },
                ),
            },
        },
    );
    artifact::ArtifactCoreUnit {
        source_origins: Vec::new(),
        package_name: "audit::value",
        declared_name: "value",
        interface_hash: "0123456789abcdef",
        exports: interface_codec::empty_exports(),
        core_ir,
        deps: Vec::from_array([("builtin", "fedcba9876543210")]),
        sources: Vec::from_array(["value.goml"]),
        tests: Vec::new(),
    }
}

#[test]
fn binary_core_artifact_is_deterministic_and_independent() -> () {
    let first = match core_codec::encode_binary(binary_core_fixture()) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            bytes::Bytes::new()
        },
    };
    let second = match core_codec::encode_binary(binary_core_fixture()) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            bytes::Bytes::new()
        },
    };
    testing::assert_eq(wire::artifact_binary_bytes_equal(first, second), true);
    match core_codec::decode_binary(first) {
        Ok(value) => {
            testing::assert_eq(value.interface_hash, "0123456789abcdef");
            testing::assert_eq(value.declared_name, "value");
            testing::assert_eq(
                core_codec::encode_json(value, false),
                core_codec::encode_json(binary_core_fixture(), false),
            )
        },
        Err(error) => testing::fail(error.to_string()),
    }
}

#[test]
fn binary_artifacts_reject_previous_index_format() -> () {
    let encoded = Vec::from_array(
        [
            interface_codec::encode_binary(binary_interface_fixture()),
            core_codec::encode_binary(binary_core_fixture()),
        ],
    );
    for result in encoded {
        let Ok(data) = result else {
            testing::fail("artifact encode failed");
            return
        };
        let Ok(container) = wire::decode_artifact_binary_container(data) else {
            testing::fail("container decode failed");
            return
        };
        let sections: Vec[wire::ArtifactBinarySection] = Vec::new();
        for section in container.sections {
            sections.push(
                if section.id == wire::value_section_id() {
                    wire::ArtifactBinarySection { version: section.version - 1, ..section }
                } else {
                    section
                },
            )
        }
        let Ok(data) = wire::encode_artifact_binary_container(container.kind, sections) else {
            testing::fail("container encode failed");
            return
        };
        let result = if container.kind == 1 {
            interface_codec::decode_binary(data).map(|_| ())
        } else {
            core_codec::decode_binary(data).map(|_| ())
        };
        let expected = if container.kind == 1 {
            "unsupported binary interface artifact section version"
        } else {
            "unsupported binary Core artifact section version"
        };
        testing::assert(result == Result::Err(expected));
    }
}
