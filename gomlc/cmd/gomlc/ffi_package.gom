package main;

struct ExtractedPackageForeignArgs {
    args: Vec[string],
    validation: Option[ForeignValidationCommand],
}

fn extract_package_foreign_args(args: Vec[string]) -> Result[ExtractedPackageForeignArgs, string] {
    let remaining: Vec[string] = Vec::new();
    let values: HashMap[string, string] = HashMap::new();
    let mut found = false;
    let mut positional = false;
    let mut index = 0;
    while index < args.len() {
        let option = args[index];
        if option == "--" {
            positional = true;
        }
        if index >= 2 && !positional && foreign_validation_option(option) {
            if index + 1 >= args.len() {
                return Result::Err("ffi-protocol: missing value for " + option)
            }
            let value = args[index + 1];
            if value == "" || value.starts_with("--") {
                return Result::Err("ffi-protocol: missing value for " + option)
            }
            if values[option].is_some() {
                return Result::Err("ffi-protocol: repeated option " + option)
            }
            values[option] = value;
            found = true;
            index += 2;
        } else {
            remaining.push(option);
            index += 1;
        }
    }
    let validation = if found {
        Option::Some(foreign_validation_command(values)?)
    } else {
        Option::None
    };
    Result::Ok(ExtractedPackageForeignArgs { args: remaining, validation })
}
