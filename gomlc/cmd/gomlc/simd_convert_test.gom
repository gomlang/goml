package main;

use module::simd;
use std::path;
use std::testing;

fn simd_conversion_source() -> (string, Vec[string]) {
    let mut source = "use std::simd; ";
    let mut main = "fn main() -> () { let bits: Vec[u64] = Vec::from_array([0, 1, 127, 128, 255, 256, 32767, 32768, 65535, 65536, 1065353216, 1065353217, 1325400063, 1325400064, 1333788672, 2139095040, 2143289345, 2147483647, 2147483648, 4286578688, 4294967295, 4294967296, 4607182418800017408, 4607182418800017409, 4746794007248502784, 4890909195324358656, 9218868437227405312, 9221120237041090561, 9223372036854775807, 9223372036854775808, 18442240474082181120, 18446744073709551615]); let mut state: u64 = 37; for _ in 0..32 { state = state * 6364136223846793005 + 1442695040888963407; bits.push(state); } ";
    let kernels: Vec[string] = Vec::new();
    for ty in simd::vector_types() {
        let name = simd::vector_name(ty);
        let bits = simd::element_bits(ty.element);
        let print_value = if simd::is_float(ty.element) {
            let exponent = if bits == 32 {
                "2139095040"
            } else {
                "9218868437227405312"
            };
            let mantissa = if bits == 32 {
                "8388607"
            } else {
                "4503599627370495"
            };
            f"let raw = values[lane].to_bits(); if raw & {exponent} == {exponent} && raw & {mantissa} != 0 {{ println(0) }} else {{ println(raw) }}"
        } else if ty.element == simd::Element::U64 {
            "println(values[lane])"
        } else {
            "println(values[lane].to_u64())"
        };
        source = source
            + f"fn show_{name}(a: simd::{name}) -> () {{ let values = a.to_array(); for lane in 0..{ty.lanes} {{ {print_value} }} }} ";
    }
    for from in simd::vector_types() {
        let name = simd::vector_name(from);
        let element = simd::element_name(from.element);
        let mut values = "";
        for lane in 0..from.lanes {
            if lane > 0 {
                values = values + ", ";
            }
            let item = f"bits[(index + {lane * 3}) % bits.len()]";
            values = values
                + if from.element == simd::Element::F32 {
                    "float32_from_bits(" + item + ".to_u32())"
                } else if from.element == simd::Element::F64 {
                    "float64_from_bits(" + item + ")"
                } else if from.element == simd::Element::U64 {
                    item
                } else {
                    item + ".to_" + element + "()"
                };
        }
        main = main
            + f"for index in 0..bits.len() {{ let a = simd::{name}::from_array([{values}]); ";
        for to in simd::vector_types() {
            if to.lanes != from.lanes || to.element == from.element {
                continue
            }
            let target = simd::vector_name(to);
            let kernel = f"convert_{name}_{target}";
            source = source
                + f"fn {kernel}(a: simd::{name}) -> simd::{target} {{ a.to_{simd::element_name(to.element)}() }} ";
            main = main + f"show_{target}({kernel}(a)); ";
            if (!simd::is_float(from.element) && !simd::is_float(to.element))
                || (from.element == simd::Element::I32 && simd::is_float(to.element))
                || (from.element == simd::Element::F32
                    && (to.element == simd::Element::I32 || to.element == simd::Element::F64))
                || (from.element == simd::Element::F64 && to.element == simd::Element::F32) {
                kernels.push(kernel);
            }
        }
        if simd::is_float(from.element) {
            let target = simd::vector_name(simd::mask_type(from));
            let kernel = f"bitcast_{name}";
            source = source
                + f"fn {kernel}(a: simd::{name}) -> simd::{target} {{ simd::{name}::from_bits(a.to_bits()).to_bits() }} ";
            main = main + f"show_{target}({kernel}(a)); ";
            kernels.push(kernel);
        }
        main = main + "} ";
    };
    (source + main + "}", kernels)
}

#[test]
fn simd_numeric_conversions_match_scalar() -> () {
    let temporary = temp_go_path("simd-conversions.gom", "simd-conversions");
    let (source, kernels) = simd_conversion_source();
    let result = exercise_simd_numeric_source(
        path::parent(temporary).unwrap_or(""),
        source,
        kernels,
        "",
    );
    cleanup_temp_directory(temporary);
    if let Err(error) = result {
        testing::fail(error);
    }
}
