package main;

use module::ffi;
use std::env;
use std::fs;
use std::path;
use std::process;
use std::testing;
use std::utf8;
use utf8::BytesUtf8;

fn exercise_foreign_context_cli(directory: string) -> Result[(), string] {
    ffi_driver_fixture(directory)?;
    let compiler = env::var_structured("GOML_TEST_GOMLC").unwrap_or("../stage2/bin/gomlc");
    let compiler = path::absolute_structured(compiler).map_err(|error| error.to_string())?;
    let config = path::join(directory, "go-env");
    fs::write_file_structured(config, "GOFLAGS=-tags=ffi_saved\n").map_err(
        |error| error.to_string(),
    )?;
    let destination = path::join(directory, "build-context.json");
    let output = process::Command::new(compiler).args(
        Vec::from_array(
            [
                "__ffi-build-context",
                "--go",
                "go",
                "--module-directory",
                directory,
                "--output",
                destination,
            ],
        ),
    ).env("GOENV", config).env("GOFLAGS", "").output_structured().map_err(|error| error.to_string())?;
    if !output.status().success() {
        return Result::Err(output.stderr().to_string_utf8().unwrap_or("context command failed"))
    }
    let source = fs::read_file_structured(destination).map_err(|error| error.to_string())?;
    let context = ffi::decode_build_context(source)?;
    testing::assert_eq(context.goflags, "-tags=ffi_saved");
    testing::assert_eq(context.module_dir, directory);
    testing::assert_eq(context.go111module, "on");
    testing::assert_eq(context.gowork, "off");
    testing::assert(!fs::is_file(path::join(directory, "go.sum")));
    Result::Ok(())
}

#[test]
fn foreign_context_cli_preserves_saved_go_flags_and_module_mode() -> () {
    let temporary = temp_go_path("ffi-context.goml", "context-command");
    let result = exercise_foreign_context_cli(path::parent(temporary).unwrap_or(""));
    cleanup_temp_directory(temporary);
    match result {
        Ok(()) => (),
        Err(message) => testing::fail(message),
    }
}
