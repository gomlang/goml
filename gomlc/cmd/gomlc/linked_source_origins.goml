package main;

use module::artifact;
use std::collections;
use std::json;

fn linked_source_origins(
    units: Vec[artifact::ArtifactCoreUnit],
    specialized: Vec[(string, string)],
    lifted: Vec[(string, string)],
    generated: Vec[(string, string)],
) -> string {
    let packages: HashMap[string, string] = HashMap::new();
    let origins: HashMap[string, artifact::ArtifactSourceOrigin] = HashMap::new();
    for unit in units {
        for origin in unit.source_origins {
            origins[origin.symbol] = origin;
            packages[origin.symbol] = unit.package_name;
        }
    }
    let specialized_names: HashMap[string, string] = HashMap::new();
    for entry in specialized {
        specialized_names[entry.0] = entry.1;
    }
    let lifted_names: HashMap[string, string] = HashMap::new();
    for entry in lifted {
        lifted_names[entry.0] = entry.1;
    }
    let records: HashMap[string, json::Value] = HashMap::new();
    let keys: Vec[string] = Vec::new();
    for entry in generated {
        let owner = lifted_names[entry.1].unwrap_or(entry.1);
        let source = specialized_names[owner].unwrap_or(owner);
        let Some(origin) = origins[source] else {
            continue
        };
        let key = entry.0 + "\u0000" + origin.symbol;
        if records[key].is_none() {
            keys.push(key)
        }
        records[key] = json::object(
            Vec::from_array(
                [
                    ("generated_symbol", json::Value::String(entry.0)),
                    ("source_symbol", json::Value::String(origin.symbol)),
                    ("source_package", json::Value::String(packages[origin.symbol].unwrap_or(""))),
                    ("source_file", json::Value::String(origin.source_file)),
                    ("start", json::Value::Number(origin.start.to_string())),
                    ("end", json::Value::Number(origin.end.to_string())),
                    ("line", json::Value::Number(origin.line.to_string())),
                    ("column", json::Value::Number(origin.column.to_string())),
                ],
            ),
        );
    }
    collections::sort_by(
        keys,
        |a, b| if a < b {
            -1
        } else if a == b {
            0
        } else {
            1
        },
    );
    let entries = Vec::new();
    for key in keys {
        if let Some(value) = records[key] {
            entries.push(value)
        }
    }
    json::encode(
        json::object(
            Vec::from_array(
                [
                    ("version", json::Value::Number("1")),
                    ("scope", json::Value::String("enclosing-declaration")),
                    ("entries", json::Value::Array(entries)),
                ],
            ),
        ),
    )
}
