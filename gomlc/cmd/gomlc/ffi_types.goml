package main;

use module::ffi;
use module::artifact;
use module::hir;
use module::tast;
use std::env;
use std::fs;
use std::path;
use std::text;

fn run_foreign_type_declarations(
    helper: string,
    context: ffi::GoBuildContext,
    caller: ffi::CallerContext,
    queries: Vec[ffi::TypeDeclarationQuery],
) -> Result[ffi::TypeDeclarations, string] {
    ffi::run_foreign_type_declarations(helper, context, caller, queries)
}

fn resolve_package_foreign_types(
    files: Vec[hir::File],
    validation: Option[ForeignValidationCommand],
) -> Result[tast::ExternalTypeEnvironment, string] {
    let requests = tast::external_type_requests(files)?;
    let queries: Vec[ffi::TypeDeclarationQuery] = Vec::new();
    for request in requests {
        queries.push(request.query)
    }
    if queries.is_empty() {
        return tast::resolve_external_type_environment(
            requests,
            ffi::TypeDeclarations {
                go_world_identity: "",
                declarations: Vec::new(),
                nodes: HashMap::new(),
            },
        )
    }
    let command = validation.ok_or(
        "ffi-type: external type declarations require a Go build context",
    )?;
    let context = match command.mode {
        Required => ffi::decode_build_context(
            fs::read_file_structured(command.context_path).map_err(
                |error| "ffi-protocol: " + error.to_string(),
            )?,
        )?,
        Off => resolve_foreign_build_context(
            "go",
            foreign_type_context_directory(command.caller.directory),
        )?,
    };
    let executable = env::current_exe_structured().map_err(
        |error| "ffi-tool-unavailable: " + error.to_string(),
    )?;
    let helper = path::join(
        path::parent(executable).ok_or("ffi-tool-unavailable: compiler has no executable directory")?,
        "goml-go-meta",
    );
    let metadata = run_foreign_type_declarations(helper, context, command.caller, queries).map_err(
        |error| external_type_query_diagnostic(error, requests),
    )?;
    let resolved = tast::resolve_external_type_environment(requests, metadata)?;
    for directory in command.additional_directories {
        let caller = ffi::CallerContext {
            generated_source: Option::None,
            load_mode: command.caller.load_mode,
            import_path: command.caller.import_path,
            directory,
            package_name: command.caller.package_name,
        };
        let additional = run_foreign_type_declarations(helper, context, caller, queries).map_err(
            |error| external_type_query_diagnostic(error, requests),
        )?;
        let _ = tast::resolve_external_type_environment(requests, additional)?;
    }
    Result::Ok(resolved)
}

fn external_type_query_diagnostic(error: string, requests: Vec[tast::ExternalTypeRequest]) -> string {
    let result = text::StringBuilder::new();
    result.write_string(error + "\n");
    for request in requests {
        if error.starts_with(request.query.type_id + ":") || requests.len() == 1 {
            render_diagnostic_label(
                result,
                "primary",
                request.source_path,
                request.declaration.name_span,
                Option::Some("Go type: " + request.query.import_path + "." + request.query.name),
                request.source_path,
                fs::read_file_structured(request.source_path).unwrap_or(""),
            );
        }
    }
    result.finish()
}

fn foreign_type_context_directory(directory: string) -> string {
    ffi::foreign_type_context_directory(directory)
}

fn check_artifact_foreign_types(
    command: ForeignValidationCommand,
    package_name: string,
    metadata: ffi::ForeignTypeMetadata,
) -> Result[(), string] {
    if metadata.queries.is_empty() {
        return Result::Ok(())
    }
    let context = match command.mode {
        Required => ffi::decode_build_context(
            fs::read_file_structured(command.context_path).map_err(|error| error.to_string())?,
        )?,
        Off => resolve_foreign_build_context(
            "go",
            foreign_type_context_directory(command.caller.directory),
        )?,
    };
    let executable = env::current_exe_structured().map_err(|error| error.to_string())?;
    let helper = path::join(
        path::parent(executable).ok_or("ffi-tool-unavailable: compiler has no executable directory")?,
        "goml-go-meta",
    );
    let callers = Vec::from_array([command.caller]);
    for directory in command.additional_directories {
        callers.push(
            ffi::CallerContext {
                generated_source: Option::None,
                load_mode: command.caller.load_mode,
                import_path: command.caller.import_path,
                directory,
                package_name: command.caller.package_name,
            },
        )
    }
    for caller in callers {
        let current = run_foreign_type_declarations(helper, context, caller, metadata.queries).map_err(
            |error| package_name + ": " + error,
        )?;
        ffi::validate_foreign_type_metadata(metadata, current).map_err(
            |error| package_name + ": " + error,
        )?;
        if !metadata.instances.is_empty() {
            let _ = run_foreign_type_instances(
                helper,
                context,
                caller,
                metadata.instances,
                Option::None,
            ).map_err(|error| package_name + ": " + error)?;
        }
    }
    Result::Ok(())
}

fn check_foreign_type_units(
    validation: Option[ForeignValidationCommand],
    interfaces: Vec[artifact::ArtifactInterfaceUnit],
    cores: Vec[artifact::ArtifactCoreUnit],
) -> Result[(), string] {
    let values = Vec::new();
    for unit in interfaces {
        if let Some(metadata) = unit.foreign_types {
            values.push((unit.package_name, metadata))
        }
    }
    for unit in cores {
        if let Some(metadata) = unit.foreign_types {
            values.push((unit.package_name, metadata))
        }
    }
    let verified: Vec[ffi::TypeDeclarations] = Vec::new();
    for (package_name, metadata) in values {
        if !metadata.queries.is_empty() {
            let command = validation.ok_or(
                "ffi-type: " + package_name + " requires a Go caller context for external types",
            )?;
            check_artifact_foreign_types(command, package_name, metadata)?;
            verified.push(metadata.declarations);
        }
    }
    validate_interface_bridge_units(interfaces, cores, verified)
}

fn run_foreign_type_instances(
    helper: string,
    context: ffi::GoBuildContext,
    caller: ffi::CallerContext,
    queries: Vec[ffi::TypeInstanceQuery],
    overlay: Option[ffi::SourceOverlay],
) -> Result[ffi::TypeInstances, string] {
    ffi::run_foreign_type_instances(helper, context, caller, queries, overlay)
}
