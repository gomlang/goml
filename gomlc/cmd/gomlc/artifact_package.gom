package main;

use module::artifact::interface_codec as interface_codec;
use module::artifact::wire as wire;
use module::artifact;
use module::ast;
use module::core;
use module::ctfe;
use module::ctir;
use module::cst;
use module::hir;
use module::parser;
use module::resources;
use module::tast;
use std::collections;
use std::fs;
use std::path;
use std::task;

struct ArtifactDependencyRequest {
    package_name: string,
    parent: string,
    expected_hash: Option[string],
}

fn artifact_builtin_interface_hash(world: PackageWorld) -> string {
    world.builtin_interface.interface_hash
}

fn artifact_prelude_interface_hash(world: PackageWorld) -> string {
    world.prelude.interface_unit.interface_hash
}

fn artifact_find_interface_unit(values: Vec[artifact::ArtifactInterfaceUnit], package_name: string) -> Option[
    artifact::ArtifactInterfaceUnit,
] {
    for offset in 0..values.len() {
        let value = values[values.len() - 1 - offset];
        if value.package_name == package_name {
            return Option::Some(value)
        }
    }
    Option::None
}

fn artifact_read_interface_unit(path_value: string) -> Result[
    artifact::ArtifactInterfaceUnit,
    string,
] {
    output_snapshot(
        path::with_extension(path_value, ""),
        || {
            let source = fs::read_bytes_structured(path_value).map_err(
                |error| f"failed to read interface {path_value}: {error}",
            )?;
            decode_artifact_interface_bytes(source).map_err(
                |error| "failed to parse interface " + path_value + ": " + error,
            )
        },
    )
}

fn artifact_read_interface_units(paths: Vec[string]) -> Result[
    Vec[artifact::ArtifactInterfaceUnit],
    string,
] {
    let decoded = task::scope(
        |scope: task::Scope| {
            let tasks: Vec[task::Task[Result[artifact::ArtifactInterfaceUnit, string]]] = Vec::with_capacity(
                paths.len(),
            );
            for path_value in paths {
                tasks.push(
                    scope.spawn(|_: task::CancelToken| artifact_read_interface_unit(path_value)),
                )
            }
            task::join_all_results(tasks)
        },
    );
    let result = decoded.map_err(|errors| errors[0])?;
    let names: collections::HashSet[string] = collections::HashSet::new();
    for interface in result {
        if !names.insert(interface.package_name) {
            return Result::Err(
                "multiple interface files provided for package " + interface.package_name,
            )
        }
    }
    Result::Ok(result)
}

fn artifact_standard_package(standard: Vec[ToolchainPackage], package_name: string) -> Option[
    ToolchainPackage,
] {
    for value in standard {
        if value.interface_unit.package_name == package_name {
            return Option::Some(value)
        }
    }
    Option::None
}

fn artifact_interface_has_dependency(
    value: artifact::ArtifactInterfaceUnit,
    package_name: string,
    interface_hash: string,
) -> bool {
    for dependency in value.deps {
        if dependency.0 == package_name && dependency.1 == interface_hash {
            return true
        }
    }
    false
}

fn artifact_interface_toolchain_error(world: PackageWorld, value: artifact::ArtifactInterfaceUnit) -> Option[
    string,
] {
    if value.package_name == "builtin" {
        Option::None
    } else if !artifact_interface_has_dependency(
        value,
        "builtin",
        artifact_builtin_interface_hash(world),
    ) {
        Option::Some(
            "interface " + value.package_name + " expects a different builtin interface_hash",
        )
    } else if value.package_name == "prelude" {
        Option::None
    } else if !artifact_interface_has_dependency(
        value,
        "prelude",
        artifact_prelude_interface_hash(world),
    ) {
        Option::Some(
            "interface " + value.package_name + " expects a different prelude interface_hash",
        )
    } else {
        Option::None
    }
}

fn artifact_dependency_hash_matches(expected: Option[string], actual: string) -> bool {
    match expected {
        Some(value) => value == actual,
        None => true,
    }
}

fn artifact_resolve_interface_units(
    world: PackageWorld,
    current_package: string,
    direct_dependencies: Vec[string],
    provided: Vec[artifact::ArtifactInterfaceUnit],
) -> Result[Vec[artifact::ArtifactInterfaceUnit], string] {
    let pending: collections::Stack[ArtifactDependencyRequest] = collections::Stack::new();
    for package_name in direct_dependencies {
        pending.push(
            ArtifactDependencyRequest {
                package_name,
                parent: current_package,
                expected_hash: Option::None,
            },
        )
    }
    let resolved_names: collections::HashSet[string] = collections::HashSet::new();
    let resolved: Vec[artifact::ArtifactInterfaceUnit] = Vec::new();
    while !pending.is_empty() {
        let Some(request) = pending.pop() else {
            break;
        };
        if request.package_name == "builtin" {
            if artifact_dependency_hash_matches(
                request.expected_hash,
                artifact_builtin_interface_hash(world),
            ) {} else {
                return Result::Err(
                    "interface " + request.parent + " expects a different builtin interface_hash",
                )
            }
        } else if request.package_name == "prelude" {
            if artifact_dependency_hash_matches(
                request.expected_hash,
                artifact_prelude_interface_hash(world),
            ) {} else {
                return Result::Err(
                    "interface " + request.parent + " expects a different prelude interface_hash",
                )
            }
        } else if request.package_name == current_package {
            return Result::Err("package " + current_package + " cannot use itself")
        } else if resolved_names.contains(request.package_name) {
            let actual = match artifact_standard_package(world.standard, request.package_name) {
                Some(value) => value.interface_unit.interface_hash,
                None => match artifact_find_interface_unit(resolved, request.package_name) {
                    Some(value) => value.interface_hash,
                    None => "",
                },
            };
            if artifact_dependency_hash_matches(request.expected_hash, actual) {} else {
                return Result::Err(
                    "interface " + request.parent + " expects a different interface_hash for "
                        + request.package_name,
                )
            }
        } else {
            let interface = match artifact_standard_package(world.standard, request.package_name) {
                Some(value) => value.interface_unit,
                None => match artifact_find_interface_unit(provided, request.package_name) {
                    Some(value) => value,
                    None => return Result::Err(
                        "missing interface file for package " + request.package_name,
                    ),
                },
            };
            if let Some(error) = artifact_interface_toolchain_error(world, interface) {
                return Result::Err(error)
            }
            if !artifact_dependency_hash_matches(request.expected_hash, interface.interface_hash) {
                return Result::Err(
                    "interface " + request.parent + " expects a different interface_hash for "
                        + request.package_name,
                )
            }
            let _ = resolved_names.insert(interface.package_name);
            if let None = artifact_standard_package(world.standard, interface.package_name) {
                resolved.push(interface)
            }
            for dependency in interface.deps {
                pending.push(
                    ArtifactDependencyRequest {
                        package_name: dependency.0,
                        parent: interface.package_name,
                        expected_hash: Option::Some(dependency.1),
                    },
                )
            }
        }
    }
    Result::Ok(resolved)
}

fn artifact_standard_needs_for_package(package_name: string) -> StandardNeeds {
    standard_needs_from_package_names(Vec::from_array([package_name]))
}

fn artifact_standard_needs_from_units(
    direct_dependencies: Vec[string],
    units: Vec[artifact::ArtifactInterfaceUnit],
) -> StandardNeeds {
    let mut needs = no_standard_needs();
    for package_name in direct_dependencies {
        needs = merge_standard_needs(needs, artifact_standard_needs_for_package(package_name));
    }
    for interface in units {
        for dependency in interface.deps {
            needs = merge_standard_needs(needs, artifact_standard_needs_for_package(dependency.0));
        }
    }
    needs
}

fn artifact_verify_comptime_modules(comptime_modules: Vec[ctir::CtModule]) -> Result[(), string] {
    for module in comptime_modules {
        let dependencies: Vec[ctir::CtModule] = Vec::new();
        for candidate in comptime_modules {
            if candidate.package_name != module.package_name {
                dependencies.push(candidate)
            }
        }
        if let Err(message) = ctfe::verify_module(module, dependencies) {
            return Result::Err(
                "invalid comptime interface for " + module.package_name + ": " + message,
            )
        }
    }
    Result::Ok(())
}

fn artifact_dependency_environments(
    builtin: artifact::ArtifactPackageExports,
    prelude: artifact::ArtifactPackageExports,
    standard: Vec[ToolchainPackage],
    needs: StandardNeeds,
    units: Vec[artifact::ArtifactInterfaceUnit],
) -> Result[Vec[tast::DependencyEnvironment], string] {
    let comptime_modules: Vec[ctir::CtModule] = Vec::new();
    for package_value in selected_standard_packages_for_needs(standard, needs) {
        if let Some(value) = package_value.interface_unit.comptime {
            comptime_modules.push(value.module)
        }
    }
    for interface in units {
        if let Some(value) = interface.comptime {
            comptime_modules.push(value.module)
        }
    }
    artifact_verify_comptime_modules(comptime_modules)?;
    let result: Vec[tast::DependencyEnvironment] = Vec::new();
    let value = artifact_dependency_environment_from_exports(builtin)?;
    let functions: Vec[tast::FunctionScheme] = Vec::new();
    let prelude_names = resources::prelude_builtin_export_names();
    for function in value.functions {
        if prelude_names.contains(function.name) {
            functions.push(function)
        }
    }
    tast::append_builtin_collection_methods(value.methods)?;
    let impls: Vec[tast::ImplInfo] = Vec::new();
    result.push(
        tast::dependency_environment(
            Vec::new(),
            value.enums,
            value.structs,
            value.type_aliases,
            value.constants,
            Vec::new(),
            functions,
            value.methods,
            impls,
        ),
    );
    result.push(artifact_dependency_environment_from_exports(prelude)?);
    for package_value in selected_standard_packages_for_needs(standard, needs) {
        result.push(
            tast::dependency_environment_with_comptime(
                artifact_dependency_environment_from_exports(package_value.interface_unit.exports)?,
                package_value.interface_unit.comptime.map(|value| value.module),
            ),
        )
    }
    for interface in units {
        result.push(
            tast::dependency_environment_with_comptime(
                artifact_dependency_environment_from_exports(interface.exports)?,
                interface.comptime.map(|value| value.module),
            ),
        )
    }
    Result::Ok(result)
}

fn artifact_dependency_core_types(units: Vec[artifact::ArtifactInterfaceUnit]) -> Vec[core::File] {
    let result: Vec[core::File] = Vec::new();
    for interface in units {
        result.push(
            core::File {
                functions: Vec::new(),
                enums: core::lower_enum_defs(interface.exports.enums),
                structs: core::lower_struct_defs(interface.exports.structs),
                type_instances: Vec::new(),
                constants: Vec::new(),
                statics: Vec::new(),
            },
        )
    }
    result
}

fn artifact_direct_dependency_hashes(
    world: PackageWorld,
    names: Vec[string],
    units: Vec[artifact::ArtifactInterfaceUnit],
) -> Result[Vec[(string, string)], string] {
    let result: Vec[(string, string)] = Vec::new();
    result.push(("builtin", artifact_builtin_interface_hash(world)));
    result.push(("prelude", artifact_prelude_interface_hash(world)));
    let names = wire::sort_artifact_names(names);
    for name in names {
        if name == "builtin" || name == "prelude" {} else {
            match artifact_standard_package(world.standard, name) {
                Some(value) => result.push((name, value.interface_unit.interface_hash)),
                None => match artifact_find_interface_unit(units, name) {
                    Some(value) => result.push((name, value.interface_hash)),
                    None => return Result::Err("missing interface file for package " + name),
                },
            }
        }
    }
    Result::Ok(result)
}

fn artifact_declared_package_name(values: Vec[ast::LowerResult], paths: Vec[string]) -> Result[
    string,
    string,
] {
    let mut name: Option[string] = Option::None;
    for index in 0..values.len() {
        let value = values[index];
        if let Some(file) = value.ast {
            if !file.package_explicit {
                return Result::Err(paths[index] + " must declare `package <name>;`")
            } else {
                match name {
                    Some(expected) => if expected != file.package_name {
                        return Result::Err(
                            "package mismatch in " + paths[index] + ": expected " + expected
                                + ", found "
                                + file.package_name,
                        )
                    },
                    None => {
                        name = Option::Some(file.package_name);
                    },
                }
            }
        }
    }
    name.ok_or("package has no valid source files")
}

fn artifact_find_function(functions: Vec[artifact::ArtifactFnScheme], name: string) -> Option[
    artifact::ArtifactFnScheme,
] {
    for offset in 0..functions.len() {
        let function = functions[functions.len() - 1 - offset];
        if function.name == name {
            return Option::Some(function)
        }
    }
    Option::None
}

fn artifact_entrypoint_diagnostics(
    package_name: string,
    declared_name: string,
    exports: artifact::ArtifactPackageExports,
) -> Vec[string] {
    let diagnostics: Vec[string] = Vec::new();
    if declared_name != "main" {
        return diagnostics
    }
    let expected = package_item_name(package_name, "main");
    let found = artifact_find_function(exports.functions, expected);
    match found {
        Some(function) => {
            if !function.type_params.is_empty() {
                diagnostics.push("main function must not have type parameters")
            }
            if let Func { params, ret_ty: _ } = tast::resolve_type(function.ty) {
                if !params.is_empty() {
                    diagnostics.push("main function must not have parameters")
                }
            }
        },
        None => diagnostics.push("main function is required"),
    }
    diagnostics
}

fn artifact_dependency_type_names(builtins: core::File, dependencies: Vec[core::File], enums: bool) -> Vec[
    string,
] {
    let result: Vec[string] = Vec::new();
    if enums {
        for definition in dependency_enums(builtins, dependencies) {
            result.push(definition.name)
        }
    } else {
        for definition in dependency_structs(builtins, dependencies) {
            result.push(definition.name)
        }
    }
    result
}

fn artifact_use_has_explicit_alias(value: ast::LowerResult, package_name: string) -> bool {
    match value.ast {
        Some(file) => {
            for use_decl in file.uses {
                if import_path_text(use_decl.path) == package_name {
                    if !use_decl.items.is_empty() {
                        return true
                    } else {
                        if let Some(_) = use_decl.alias {
                            return true
                        }
                    }
                }
            }
            false
        },
        None => false,
    }
}

fn artifact_declared_package_alias(
    units: Vec[artifact::ArtifactInterfaceUnit],
    package_name: string,
) -> Option[string] {
    for offset in 0..units.len() {
        let interface_unit = units[units.len() - 1 - offset];
        if interface_unit.package_name == package_name
            && interface_unit.package_interface.name != "" {
            return Option::Some(interface_unit.package_interface.name)
        }
    }
    Option::None
}

fn artifact_apply_declared_package_aliases(
    files: Vec[hir::File],
    sources: Vec[ast::LowerResult],
    units: Vec[artifact::ArtifactInterfaceUnit],
) -> () {
    for file_index in 0..files.len() {
        let file = files[file_index];
        for alias_index in 0..file.import_aliases.len() {
            let alias = file.import_aliases[alias_index];
            if artifact_use_has_explicit_alias(sources[file_index], alias.package_name) {} else {
                if let Some(name) = artifact_declared_package_alias(units, alias.package_name) {
                    file.import_aliases.set(
                        alias_index,
                        hir::ImportAlias { alias: name, package_name: alias.package_name },
                    )
                }
            }
        }
    }
}

fn standard_internal_import_allowed(package_name: string) -> bool {
    package_name == resources::STD_ROOT_PACKAGE
        || package_name.starts_with(resources::STD_PACKAGE_PREFIX)
}

fn disallowed_standard_internal_import(package_name: string, import_name: string) -> bool {
    import_name.starts_with("std::internal::") && !standard_internal_import_allowed(package_name)
}

fn disallowed_toolchain_import(import_name: string) -> bool {
    import_name == "builtin" || import_name.starts_with("builtin::") || import_name == "prelude"
        || import_name.starts_with("prelude::")
}

fn standard_internal_import_diagnostics(
    values: Vec[ast::LowerResult],
    paths: Vec[string],
    package_name: string,
) -> Vec[tast::Diagnostic] {
    let diagnostics: Vec[tast::Diagnostic] = Vec::new();
    for index in 0..values.len() {
        if let Some(file) = values[index].ast {
            for use_decl in file.uses {
                let import_name = import_path_text(use_decl.path);
                if disallowed_standard_internal_import(package_name, import_name) {
                    diagnostics.push(
                        tast::Diagnostic {
                            severity: tast::DiagnosticSeverity::Error,
                            stage: TYPER_STAGE,
                            message: "package " + import_name + " is internal to std",
                            source_path: paths[index],
                            span: Option::None,
                            primary_label: Option::None,
                            secondary_labels: Vec::new(),
                            sort_order: 0,
                        },
                    )
                } else if disallowed_toolchain_import(import_name) {
                    diagnostics.push(
                        tast::Diagnostic {
                            severity: tast::DiagnosticSeverity::Error,
                            stage: TYPER_STAGE,
                            message: "package " + import_name + " is internal to the toolchain",
                            source_path: paths[index],
                            span: Option::None,
                            primary_label: Option::None,
                            secondary_labels: Vec::new(),
                            sort_order: 0,
                        },
                    )
                }
            }
        }
    }
    diagnostics
}

fn without_disallowed_standard_internal_imports(value: ast::LowerResult, package_name: string) -> ast::LowerResult {
    ast::LowerResult {
        ast: match value.ast {
            Some(file) => {
                let uses: Vec[ast::UseDecl] = Vec::new();
                for use_decl in file.uses {
                    if disallowed_standard_internal_import(
                        package_name,
                        import_path_text(use_decl.path),
                    )
                        || disallowed_toolchain_import(import_path_text(use_decl.path)) {} else {
                        uses.push(use_decl)
                    }
                }
                Option::Some(
                    ast::File {
                        package_name: file.package_name,
                        package_explicit: file.package_explicit,
                        uses,
                        items: file.items,
                        invalid_self_type_spans: file.invalid_self_type_spans,
                    },
                )
            },
            None => Option::None,
        },
        diagnostics: value.diagnostics,
    }
}

fn compile_artifact_package(
    world: PackageWorld,
    command: PackageCommandArgs,
    build: bool,
    emit_tests: bool,
) -> Result[ArtifactCompiledPackage, string] {
    if disallowed_toolchain_import(command.package_name) {
        return Result::Err("package " + command.package_name + " is internal to the toolchain")
    }
    let source_texts: Vec[string] = Vec::new();
    let parsed: Vec[cst::ParseResult] = Vec::new();
    let parser_diagnostics: Vec[tast::Diagnostic] = Vec::new();
    for source_path in command.inputs {
        let source = read_source(source_path);
        source_texts.push(source);
        let value = parser::parse(source);
        for diagnostic in ast_diagnostics(value.diagnostics, "parser", source_path) {
            parser_diagnostics.push(diagnostic)
        }
        parsed.push(value)
    }
    fail_on_typer_diagnostics(parser_diagnostics, "", "");
    let ast_values = ast::lower_package(parsed);
    validate_package_interface_names(ast_values, command.inputs)?;
    for index in 0..ast_values.len() {
        ast_values.set(
            index,
            ast::resolve_module_paths(
                hir::expand_go_interfaces(ast_values[index]),
                command.module_name,
            ),
        )
    }
    let lower_diagnostics: Vec[tast::Diagnostic] = Vec::new();
    for index in 0..ast_values.len() {
        for diagnostic in ast_diagnostics(
            ast_values[index].diagnostics,
            "lower",
            command.inputs[index],
        ) {
            lower_diagnostics.push(diagnostic)
        }
    }
    fail_on_typer_diagnostics(lower_diagnostics, "", "");
    let internal_import_diagnostics = standard_internal_import_diagnostics(
        ast_values,
        command.inputs,
        command.package_name,
    );
    let declared_name = artifact_declared_package_name(ast_values, command.inputs)?;
    let public_names = public_item_names(ast_values, command.package_name);
    let test_candidates = collect_package_test_candidates(ast_values, command.inputs);
    fail_on_typer_diagnostics(test_candidates.diagnostics, "", "");
    let provided = artifact_read_interface_units(command.interface_paths)?;
    let mut source_needs = no_standard_needs();
    for ast_value in ast_values {
        source_needs = merge_standard_needs(source_needs, source_standard_needs(ast_value));
    }
    let derive_modules: Vec[ctir::CtModule] = Vec::new();
    let derive_reexports: Vec[(string, string)] = Vec::new();
    for package_value in selected_standard_packages_for_needs(world.standard, source_needs) {
        if let Some(value) = package_value.interface_unit.comptime {
            derive_modules.push(value.module)
        }
        for value in package_value.interface_unit.exports.reexports {
            derive_reexports.push(value)
        }
    }
    for interface_unit_value in provided {
        if let Some(value) = interface_unit_value.comptime {
            derive_modules.push(value.module)
        }
        for value in interface_unit_value.exports.reexports {
            derive_reexports.push(value)
        }
    }
    let builtin_derive_module = world.builtin_interface.comptime.map(|value| value.module);
    let verified_derive_modules = derive_modules;
    if let Some(value) = builtin_derive_module {
        verified_derive_modules.push(value)
    }
    artifact_verify_comptime_modules(verified_derive_modules)?;
    let hir_inputs: Vec[(ast::LowerResult, string)] = Vec::new();
    let derive_diagnostics: Vec[tast::Diagnostic] = Vec::new();
    for index in 0..ast_values.len() {
        let ast_value = ast_values[index];
        let expanded = hir::expand_derives_with_environment(
            without_disallowed_standard_internal_imports(ast_value, command.package_name),
            hir::DeriveEnvironment {
                builtin: builtin_derive_module,
                dependencies: derive_modules,
                reexports: derive_reexports,
            },
        );
        for diagnostic in ast_diagnostics(expanded.diagnostics, "derive", command.inputs[index]) {
            derive_diagnostics.push(diagnostic)
        }
        hir_inputs.push((expanded, command.inputs[index]))
    }
    fail_on_typer_diagnostics(derive_diagnostics, "", "");
    let hir_files: Vec[hir::File] = Vec::new();
    for lowered in hir::lower_expanded_package_files(hir_inputs, command.package_name) {
        hir_files.push(checked_hir_file(lowered, command.package_name))
    }
    let dependency_names = direct_hir_dependencies(hir_files);
    let production_interface = if emit_tests {
        artifact_find_interface_unit(provided, command.package_name)
    } else {
        Option::None
    };
    let dependency_units = artifact_resolve_interface_units(
        world,
        command.package_name,
        dependency_names,
        provided,
    )?;
    artifact_apply_declared_package_aliases(hir_files, ast_values, dependency_units);
    let needs = merge_standard_needs(
        source_needs,
        artifact_standard_needs_from_units(dependency_names, dependency_units),
    );
    let imported_external = attach_imported_external_collectors(dependency_units)?;
    let environments = artifact_dependency_environments(
        world.builtin_interface.exports,
        world.prelude.interface_unit.exports,
        world.standard,
        needs,
        dependency_units,
    )?;
    check_foreign_type_units(command.foreign_validation, dependency_units, Vec::new())?;
    let external = resolve_package_foreign_types(hir_files, command.foreign_validation)?;
    let checked = tast::check_package_files_for_link_with_external_types(
        hir_files,
        environments,
        external,
    )?;
    for diagnostic in internal_import_diagnostics {
        checked.diagnostics.push(diagnostic)
    }
    let hir_file = merge_hir_files(hir_files, command.package_name);
    let signatures = tast::package_signatures_with_external_types_and_dependencies(
        hir_file,
        external,
        environments,
    )?;
    let comptime_module = checked.comptime;
    let Some(tast_file) = checked.tast else {
        return Result::Err("failed to typecheck package " + command.package_name)
    };
    let dependency_core = Vec::from_array([world.prelude.core_value]);
    append_core_files(dependency_core, selected_link_standard_core(world.standard, needs));
    append_core_files(dependency_core, artifact_dependency_core_types(dependency_units));
    let enum_names = artifact_dependency_type_names(world.builtins, dependency_core, true);
    let struct_names = artifact_dependency_type_names(world.builtins, dependency_core, false);
    let public_exports = artifact_package_exports(
        tast_file,
        signatures,
        command.package_name,
        public_names,
        hir_file.public_reexports,
        true,
        enum_names,
        struct_names,
    )?;
    let exports = artifact_package_exports(
        tast_file,
        signatures,
        command.package_name,
        public_names,
        hir_file.public_reexports,
        false,
        enum_names,
        struct_names,
    )?;
    let go_exports = artifact_go_exports(hir_file, tast_file, command.package_name)?;
    artifact_attach_go_exports(public_exports, go_exports)?;
    artifact_attach_go_exports(exports, go_exports)?;
    let test_validation = validate_package_tests(
        command.package_name,
        test_candidates.candidates,
        exports,
    );
    for diagnostic in test_validation.diagnostics {
        checked.diagnostics.push(diagnostic)
    }
    if !emit_tests {
        for message in artifact_entrypoint_diagnostics(command.package_name, declared_name, exports) {
            checked.diagnostics.push(
                tast::Diagnostic {
                    severity: tast::DiagnosticSeverity::Error,
                    stage: TYPER_STAGE,
                    message,
                    source_path: "",
                    span: Option::None,
                    primary_label: Option::None,
                    secondary_labels: Vec::new(),
                    sort_order: 0,
                },
            )
        }
    }
    fail_on_typer_diagnostics(checked.diagnostics, "", "");
    validate_package_interface_adapters(
        hir_files,
        signatures,
        tast_file,
        external,
        dependency_units,
    )?;
    let bridge_metadata = Vec::from_array([external.metadata]);
    for dependency in dependency_units {
        if let Some(metadata) = dependency.foreign_types {
            bridge_metadata.push(metadata.declarations);
        }
    }
    validate_interface_bridge_exports(exports, bridge_metadata)?;
    if let Err(error) = validate_public_trait_impls(hir_file, command.package_name, public_names) {
        return Result::Err("error[typer]: " + error)
    }
    if let Err(error) = validate_public_fields_and_inherent_methods(
        hir_file,
        command.package_name,
        public_names,
    ) {
        return Result::Err("error[typer]: " + error)
    }
    let deps = artifact_direct_dependency_hashes(world, dependency_names, dependency_units)?;
    let foreign_traits: Vec[tast::TraitInfo] = Vec::new();
    for environment in environments {
        for trait_info in environment.traits {
            foreign_traits.push(trait_info)
        }
    }
    let generated_interface = interface_codec::new_unit_with_foreign_bindings(
        command.package_name,
        public_exports,
        artifact_package_interface(command.package_name, declared_name, public_exports),
        artifact_comptime_unit(comptime_module, public_exports),
        deps,
        foreign_artifact_bindings(command.package_name, exports, foreign_traits)?,
    );
    let generated_interface = match resolve_external_application_metadata(
        command.foreign_validation,
        hir_files,
        external,
        imported_external,
    )? {
        Some(metadata) => interface_codec::with_foreign_types(generated_interface, metadata)?,
        None => generated_interface,
    };
    let interface_unit = production_interface.unwrap_or(generated_interface);
    let core_ir = if build {
        core::eliminate_dead_locals(
            core::lower_with_counter_types_and_options(
                checked,
                Ref::new(0),
                dependency_enums(world.builtins, dependency_core),
                dependency_structs(world.builtins, dependency_core),
                true,
            ),
        )
    } else {
        empty_core_file()
    };
    Result::Ok(
        ArtifactCompiledPackage {
            interface_unit,
            core_unit: artifact::ArtifactCoreUnit {
                source_origins: artifact_package_source_origins(
                    command.package_name,
                    command.inputs,
                    ast_values,
                    source_texts,
                    tast_file,
                    core_ir,
                )?,
                external_applications: Vec::new(),
                foreign_types: generated_interface.foreign_types,
                package_name: command.package_name,
                declared_name,
                interface_hash: interface_unit.interface_hash,
                exports,
                core_ir,
                deps,
                sources: command.inputs,
                tests: if emit_tests {
                    test_validation.tests
                } else {
                    Vec::new()
                },
            },
        },
    )
}

fn artifact_read_core_unit(path_value: string) -> Result[artifact::ArtifactCoreUnit, string] {
    output_snapshot(
        path::with_extension(path_value, ""),
        || {
            let source = fs::read_bytes_structured(path_value).map_err(
                |error| f"failed to read core {path_value}: {error}",
            )?;
            decode_artifact_core_bytes(source).map_err(
                |error| "failed to parse core " + path_value + ": " + error,
            )
        },
    )
}

fn artifact_read_core_units(paths: Vec[string]) -> Result[Vec[artifact::ArtifactCoreUnit], string] {
    let decoded = task::scope(
        |scope: task::Scope| {
            let tasks: Vec[task::Task[Result[artifact::ArtifactCoreUnit, string]]] = Vec::with_capacity(
                paths.len(),
            );
            for path_value in paths {
                tasks.push(scope.spawn(|_: task::CancelToken| artifact_read_core_unit(path_value)))
            }
            task::join_all_results(tasks)
        },
    );
    let result = decoded.map_err(|errors| errors[0])?;
    let names: collections::HashSet[string] = collections::HashSet::new();
    for core_unit in result {
        if !names.insert(core_unit.package_name) {
            return Result::Err("duplicate core provided for package " + core_unit.package_name)
        }
    }
    Result::Ok(result)
}

fn artifact_find_core_unit(values: Vec[artifact::ArtifactCoreUnit], package_name: string) -> Option[
    artifact::ArtifactCoreUnit,
] {
    for offset in 0..values.len() {
        let value = values[values.len() - 1 - offset];
        if value.package_name == package_name {
            return Option::Some(value)
        }
    }
    Option::None
}

fn artifact_link_dependency_name(package_name: string) -> bool {
    package_name != "builtin" && package_name != "prelude"
        && package_name != resources::STD_ROOT_PACKAGE
        && !package_name.starts_with(resources::STD_PACKAGE_PREFIX)
}

fn artifact_reachable_core_units(roots: Vec[string], values: Vec[artifact::ArtifactCoreUnit]) -> Result[
    Vec[artifact::ArtifactCoreUnit],
    string,
] {
    let pending: collections::Stack[string] = collections::Stack::new();
    for root in roots {
        pending.push(root)
    }
    let names: collections::HashSet[string] = collections::HashSet::new();
    while !pending.is_empty() {
        let Some(package_name) = pending.pop() else {
            break;
        };
        if !names.insert(package_name) {} else {
            let Some(core_unit) = artifact_find_core_unit(values, package_name) else {
                return Result::Err("missing core for package " + package_name)
            };
            for dependency in core_unit.deps {
                if artifact_link_dependency_name(dependency.0) {
                    pending.push(dependency.0)
                }
            }
        }
    }
    let result: Vec[artifact::ArtifactCoreUnit] = Vec::new();
    for value in values {
        if names.contains(value.package_name) {
            result.push(value)
        }
    }
    Result::Ok(result)
}

fn artifact_validate_link_core_units(world: PackageWorld, values: Vec[artifact::ArtifactCoreUnit]) -> Result[
    (),
    string,
] {
    for value in values {
        for dependency in value.deps {
            if dependency.0 == "builtin" {
                if dependency.1 != artifact_builtin_interface_hash(world) {
                    return Result::Err(
                        "package " + value.package_name
                            + " expects a different builtin interface_hash",
                    )
                }
            } else if dependency.0 == "prelude" {
                if dependency.1 != artifact_prelude_interface_hash(world) {
                    return Result::Err(
                        "package " + value.package_name
                            + " expects a different prelude interface_hash",
                    )
                }
            } else {
                match artifact_standard_package(world.standard, dependency.0) {
                    Some(standard) => if dependency.1 != standard.interface_unit.interface_hash {
                        return Result::Err(
                            "package " + value.package_name
                                + " expects a different interface_hash for "
                                + dependency.0,
                        )
                    },
                    None => match artifact_find_core_unit(values, dependency.0) {
                        Some(actual) => if dependency.1 != actual.interface_hash {
                            return Result::Err(
                                "package " + value.package_name
                                    + " expects a different interface_hash for "
                                    + dependency.0,
                            )
                        },
                        None => return Result::Err(
                            "package " + value.package_name + " depends on missing package "
                                + dependency.0,
                        ),
                    },
                }
            }
        }
    }
    Result::Ok(())
}

fn artifact_core_standard_needs(values: Vec[artifact::ArtifactCoreUnit]) -> StandardNeeds {
    let mut needs = no_standard_needs();
    for value in values {
        for dependency in value.deps {
            needs = merge_standard_needs(needs, artifact_standard_needs_for_package(dependency.0));
        }
    }
    needs
}

fn artifact_core_compilation(value: artifact::ArtifactCoreUnit) -> ArtifactCompilation {
    let dependency_names: Vec[string] = Vec::new();
    for dependency in value.deps {
        if artifact_link_dependency_name(dependency.0) {
            dependency_names.push(dependency.0)
        }
    }
    ArtifactCompilation {
        package_name: value.package_name,
        dependency_names,
        core_value: value.core_ir,
    }
}

fn artifact_core_compilations(values: Vec[artifact::ArtifactCoreUnit]) -> Result[
    Vec[ArtifactCompilation],
    string,
] {
    let result: Vec[ArtifactCompilation] = Vec::new();
    for value in values {
        result.push(artifact_core_compilation(value))
    }
    order_artifact_compilations(result)
}
