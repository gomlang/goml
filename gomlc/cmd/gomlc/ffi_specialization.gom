package main;

use module::artifact;
use module::core;
use module::ffi;
use module::mono;
use module::tast;

fn specialized_external_queries(applications: Vec[core::ExternalTypeApplication]) -> Result[
    Vec[ffi::TypeInstanceQuery],
    string,
] {
    let result = Vec::new();
    for application in applications {
        let arguments = Vec::new();
        for argument in application.arguments {
            arguments.push(core::type_to_tast(argument))
        }
        for query in tast::external_application_queries(
            application.declaration,
            Vec::from_array(
                [
                    tast::ExternalTypeApplication {
                        function_name: Option::Some(application.function_name),
                        source_path: application.function_name,
                        span: Option::None,
                        arguments,
                    },
                ],
            ),
        )? {
            append_external_instance(result, query)?;
        }
    }
    Result::Ok(result)
}

fn check_specialized_external_applications(
    validation: Option[ForeignValidationCommand],
    units: Vec[artifact::ArtifactCoreUnit],
    applications: Vec[core::ExternalTypeApplication],
) -> Result[(), string] {
    if applications.len() == 0 {
        return Result::Ok(())
    }
    let command = validation.ok_or(
        "ffi-type: specialized external applications require a Go caller context",
    )?;
    let matched: HashMap[string, bool] = HashMap::new();
    for unit in units {
        if let Some(metadata) = unit.foreign_types {
            let selected = Vec::new();
            for application in applications {
                for query in metadata.queries {
                    if query.type_id == application.declaration.type_id {
                        if query.name != application.declaration.name
                            || query.import_path != application.declaration.import_path {
                            return Result::Err(
                                "ffi-type: conflicting specialized declaration " + query.type_id,
                            )
                        }
                        selected.push(application);
                        matched[query.type_id] = true;
                    }
                }
            }
            if selected.len() != 0 {
                check_artifact_foreign_types(
                    command,
                    unit.package_name,
                    ffi::ForeignTypeMetadata {
                        instances: specialized_external_queries(selected)?,
                        queries: metadata.queries,
                        declarations: metadata.declarations,
                    },
                )?;
            }
        }
    }
    for application in applications {
        if matched[application.declaration.type_id].is_none() {
            return Result::Err(
                "ffi-type: specialized application is missing declaration metadata "
                    + application.declaration.type_id,
            )
        }
    }
    Result::Ok(())
}

fn lower_linked_with_source_names(
    value: core::File,
    units: Vec[artifact::ArtifactCoreUnit],
    validation: Option[ForeignValidationCommand],
    source_names: Vec[(string, string)],
) -> Result[mono::File, string] {
    let applications = Vec::new();
    for unit in units {
        for application in unit.external_applications {
            applications.push(application)
        }
    }
    core::validate_external_applications(value, applications)?;
    let pruned = eliminate_core_dead_code(value);
    let reachable = Vec::new();
    for application in applications {
        for function in pruned.functions {
            if function.name == application.function_name {
                reachable.push(application)
            }
        }
    }
    let lowered = mono::lower_with_external_applications(pruned, reachable)?;
    for source in lowered.source_names {
        source_names.push(source)
    }
    check_specialized_external_applications(validation, units, lowered.applications)?;
    let result = mono::dce(lowered.file);
    let key_rules = Vec::new();
    for unit in units {
        if let Some(metadata) = unit.foreign_types {
            for query in metadata.queries {
                key_rules.push(
                    mono::ExternalKeyRule {
                        template: ffi::resolve_go_type_template(
                            metadata.declarations,
                            query.type_id,
                        )?.identity,
                        rule: ffi::go_type_comparability_rule(metadata.declarations, query.type_id)?,
                    },
                );
            }
        }
    }
    mono::validate_with_external_keys(result, Option::Some(key_rules))?;
    Result::Ok(result)
}

fn core_units_have_external_applications(units: Vec[artifact::ArtifactCoreUnit]) -> bool {
    for unit in units {
        if unit.external_applications.len() != 0 {
            return true
        }
    }
    false
}
