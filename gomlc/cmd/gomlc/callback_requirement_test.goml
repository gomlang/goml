package main;

use module::test_support;
use std::fs;
use std::path;
use std::process;
use std::testing;
use std::utf8;
use utf8::BytesUtf8;

fn callback_requirement_output(directory: string, consumer: bool) -> Result[process::Output, string] {
    let name = if consumer {
        "consumer"
    } else {
        "api"
    };
    let args = Vec::from_array(
        [
            "check",
            "--package",
            "callback::" + name,
            "--module",
            "callback",
            "--input",
            path::join(directory, name + ".goml"),
            "--output",
            path::join(directory, name),
        ],
    );
    if consumer {
        args.push("--interface-path");
        args.push(path::join(directory, "api.interface"));
    }
    test_support::compiler_command(args)?.current_dir(directory).output_structured().map_err(
        |error| error.to_string(),
    )
}

fn exercise_callback_requirements(directory: string) -> Result[(), string] {
    fs::create_dir_all(directory).map_err(|error| error.to_string())?;
    let source_path = path::join(directory, "main.goml");
    for body in[
        "let raw = ffi::func_from_closure(|value: string| value);",
        "let raw = convert(|value: string| value);",
        "let raw = ffi::func_from_closure(|value: char| value);",
        "let raw = ffi::func_from_closure(|value: [string; 2]| value);",
        "let raw = ffi::func_from_closure(|| (1, \"text\"));",
        "let raw: ffi::Func[(string) -> string] = ffi::func_nil(); let converted = ffi::func_to_closure(raw);",
        "let convert = ffi::func_from_closure::[(string) -> string]; let raw = convert(|value| value);",
    ] {
        let source = "use std::ffi; fn convert[T](value: (T) -> T) -> ffi::Func[(T) -> T] { ffi::func_from_closure(value) } fn main() -> () { "
            + body
            + " }";
        fs::write_file_structured(source_path, source).map_err(|error| error.to_string())?;
        let output = process::Command::new(test_support::compiler_path()?).args(
            Vec::from_array(["run-single", source_path]),
        ).output_structured().map_err(|error| error.to_string())?;
        let stderr = output.stderr().to_string_utf8().unwrap_or("");
        if output.status().success() || !stderr.contains("error[typer]")
            || !stderr.contains("Go callback")
            || stderr.contains("invalid Lift IR") {
            return Err(source + "\n" + stderr)
        }
    }
    let positive = "use std::ffi; fn convert[F](value: F) -> ffi::Func[F] { ffi::func_from_closure(value) } fn main() -> () { let raw: ffi::Func[(string) -> string] = ffi::func_nil(); println(ffi::func_is_nil(raw)); let raw = convert(|value: ffi::String| value); let Some(call) = ffi::func_to_closure(raw) else { return }; let Ok(text) = ffi::string_text(call(ffi::string_from_text(\"ok\"))) else { return }; println(text); let raw = convert(|value: i32| (value + 1, value + 2)); let Some(call) = ffi::func_to_closure(raw) else { return }; let (left, right) = call(4); println(left); println(right); let ptr = convert(|value: ffi::Ptr[string]| value); println(ffi::func_is_nil(ptr)); let nested = convert(|value: ffi::Func[(string) -> string]| value); println(ffi::func_is_nil(nested)); }";
    fs::write_file_structured(source_path, positive).map_err(|error| error.to_string())?;
    let output = process::Command::new(test_support::compiler_path()?).args(
        Vec::from_array(["run-single", source_path]),
    ).output_structured().map_err(|error| error.to_string())?;
    if !output.status().success() {
        return Err(output.stderr().to_string_utf8().unwrap_or("positive callback failed"))
    }
    if output.stdout().to_string_utf8().unwrap_or("") != "true\nok\n5\n6\nfalse\nfalse\n" {
        return Err("unexpected positive callback output")
    }
    fs::write_file_structured(
        path::join(directory, "api.goml"),
        "package api; use std::ffi; pub fn convert[F](value: F) -> ffi::Func[F] { ffi::func_from_closure(value) } pub fn forward[T](value: (T) -> T) -> ffi::Func[(T) -> T] { convert(value) } pub trait Make[T] { fn make(self: Self, value: (T) -> T) -> () { let raw = ffi::func_from_closure(value); } }",
    ).map_err(|error| error.to_string())?;
    let provider = callback_requirement_output(directory, false)?;
    if !provider.status().success() {
        return Err(provider.stderr().to_string_utf8().unwrap_or("provider failed"))
    }
    for entry in[
        ("pub fn use_it(value: (i32) -> i32) -> () { let raw = api::forward(value); }", true),
        ("pub fn use_it(value: (string) -> string) -> () { let raw = api::forward(value); }", false),
        (
            "pub fn use_it(value: (string) -> string) -> () { let convert = api::convert::[(string) -> string]; let raw = convert(value); }",
            false,
        ),
        ("struct Local {} impl api::Make[i32] for Local {}", true),
        ("struct Local {} impl api::Make[string] for Local {}", false),
        (
            "struct Local {} impl api::Make[string] for Local { fn make(self: Self, value: (string) -> string) -> () {} }",
            true,
        ),
    ] {
        let source = "package consumer; use callback::api; " + entry.0;
        fs::write_file_structured(path::join(directory, "consumer.goml"), source).map_err(
            |error| error.to_string(),
        )?;
        let output = callback_requirement_output(directory, true)?;
        let stderr = output.stderr().to_string_utf8().unwrap_or("");
        if output.status().success() != entry.1 || (!entry.1 && !stderr.contains("Go callback")) {
            return Err(source + "\n" + stderr)
        }
    }
    Ok(())
}

#[test]
fn callback_conversion_boundaries_propagate_through_values_defaults_and_interfaces() -> () {
    let temporary = temp_go_path("callback-requirements.goml", "ffi");
    let result = exercise_callback_requirements(path::parent(temporary).unwrap_or(""));
    cleanup_temp_directory(temporary);
    if let Err(message) = result {
        testing::fail(message);
    }
}
