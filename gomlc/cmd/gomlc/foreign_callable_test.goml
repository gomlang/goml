package main;

use module::artifact::interface_codec as interface_codec;
use module::artifact;
use module::tast;
use std::testing;

#[test]
fn foreign_callable_artifacts_cannot_be_comptime() -> () {
    let base = binary_interface_fixture();
    base.exports.functions.push(
        artifact::ArtifactFnScheme {
            name: "audit::value::abs",
            comptime: tast::ComptimeCapability::Capable,
            type_params: Vec::new(),
            constraints: Vec::new(),
            ty: tast::Type::Func {
                params: Vec::from_array([tast::Type::Float64]),
                ret_ty: tast::Type::Float64,
            },
            body: tast::Callable::GoForeign { binding: "", import_path: "math", symbol: "Abs" },
        },
    );
    let unit = interface_codec::new_unit(
        base.package_name,
        base.exports,
        base.package_interface,
        base.deps,
    );
    match interface_codec::encode_binary(unit) {
        Ok(bytes) => testing::assert(interface_codec::decode_binary(bytes).is_err()),
        Err(message) => testing::fail(message),
    }
}

#[test]
fn foreign_method_callable_artifacts_reject_invalid_symbols_receivers_and_comptime() -> () {
    for invalid in Vec::from_array(
        [
            ("Read;panic", true, tast::ComptimeCapability::RuntimeOnly),
            ("Read", false, tast::ComptimeCapability::RuntimeOnly),
            ("Read", true, tast::ComptimeCapability::Capable),
        ],
    ) {
        let base = binary_interface_fixture();
        let params: Vec[tast::Type] = Vec::new();
        if invalid.1 {
            params.push(tast::Type::Float64)
        }
        base.exports.functions.push(
            artifact::ArtifactFnScheme {
                name: "audit::value::read",
                comptime: invalid.2,
                type_params: Vec::new(),
                constraints: Vec::new(),
                ty: tast::Type::Func { params, ret_ty: tast::Type::Float64 },
                body: tast::Callable::GoMethod { binding: "", symbol: invalid.0 },
            },
        );
        let unit = interface_codec::new_unit(
            base.package_name,
            base.exports,
            base.package_interface,
            base.deps,
        );
        match interface_codec::encode_binary(unit) {
            Ok(bytes) => testing::assert(interface_codec::decode_binary(bytes).is_err()),
            Err(error) => testing::fail(error),
        }
    }
}
