package main;

use module::ffi;
use std::testing;

fn host_instance_query(id: string, name: string, arguments: Vec[ffi::BridgeType]) -> ffi::TypeInstanceQuery {
    ffi::TypeInstanceQuery {
        declaration: ffi::TypeDeclarationQuery {
            type_id: id,
            import_path: "example.com/host/shim",
            name,
        },
        arguments,
    }
}

fn exercise_foreign_type_instances(
    helper: string,
    context: ffi::GoBuildContext,
    caller: ffi::CallerContext,
) -> Result[(), string] {
    let duration = ffi::BridgeType::Named {
        import_path: "time",
        name: "Duration",
        arguments: Vec::new(),
    };
    let queries = Vec::from_array(
        [
            host_instance_query("box", "Box", Vec::from_array([duration])),
            host_instance_query(
                "reverse",
                "Reverse",
                Vec::from_array([duration, ffi::BridgeType::Scalar("bool")]),
            ),
            host_instance_query(
                "numeric",
                "Numeric",
                Vec::from_array([ffi::BridgeType::Scalar("int64")]),
            ),
            host_instance_query(
                "pointer_box",
                "Box",
                Vec::from_array([ffi::BridgeType::Pointer { element: duration }]),
            ),
        ],
    );
    let result = run_foreign_type_instances(helper, context, caller, queries, Option::None)?;
    testing::assert_eq(result.instances.len(), 4);
    testing::assert(ffi::go_type_identity_key(result.instances[0].identity).contains("Duration"));
    testing::assert(ffi::go_type_identity_key(result.instances[1].identity).contains("Pair"));
    testing::assert(ffi::go_type_identity_key(result.instances[3].identity).contains("pointer"));
    let invalid = Vec::from_array(
        [
            host_instance_query(
                "invalid",
                "Numeric",
                Vec::from_array([ffi::BridgeType::Scalar("bool")]),
            ),
        ],
    );
    match run_foreign_type_instances(helper, context, caller, invalid, Option::None) {
        Err(error) => {
            testing::assert(error.contains("invalid"));
            testing::assert(error.contains("constraint") || error.contains("satisfy"));
        },
        Ok(_) => testing::fail("expected Go generic constraint rejection"),
    }
    Result::Ok(())
}
