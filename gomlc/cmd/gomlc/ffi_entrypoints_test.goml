package main;

use module::compiler::{diagnostic_output_with, source_compiler_without_standard};
use std::testing;

#[test]
fn single_file_interfaces_expand_and_use_shared_boundary_validation() -> () {
    let compiler = source_compiler_without_standard();
    let raw = "#[go_type(\"io\", \"Reader\")] extern type Raw; ";
    let valid = raw
        + "#[go_interface(Raw, Wrapped, read = \"Read\")] trait Reader { fn read(self: Self) -> i64; } pub fn wrap(value: Raw) -> Wrapped { Wrapped::from_go(value) } fn main() -> () {}";
    testing::assert_eq(diagnostic_output_with(compiler, "interface.goml", valid), "");
    for source in Vec::from_array(
        [
            raw
                + "#[go_interface(Raw, Wrapped, read = \"Read\")] trait Reader { fn read(self: Self, value: string) -> (); } fn main() -> () {}",
            raw
                + "#[go_interface(Raw, Wrapped, read = \"Read\")] trait Reader { fn read(self: Self, value: Slice[u8]) -> (); } fn main() -> () {}",
        ],
    ) {
        testing::assert(
            diagnostic_output_with(compiler, "interface.goml", source).contains("go_interface"),
        );
    }
    testing::assert(
        diagnostic_output_with(
            compiler,
            "interface.goml",
            "type Raw = i64; #[go_interface(Raw, Wrapped, read = \"Read\")] trait Reader { fn read(self: Self) -> i64; } fn main() -> () {}",
        ).contains("Go interface bridge requires a native interface target"),
    );
    testing::assert(
        diagnostic_output_with(
            compiler,
            "interface.goml",
            valid + " impl Wrapped { fn into_go(self: Wrapped) -> Raw { self.raw } }",
        ).contains("go_interface generated member collides"),
    );
}
