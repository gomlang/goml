package main;

use module::artifact;
use module::ffi;
use module::tast;
use std::json;

struct ForeignArtifactCommand {
    source_package: string,
    source_paths: Vec[string],
    interfaces: Vec[string],
    cores: Vec[string],
    validation: ForeignValidationCommand,
}

struct ForeignValidationCommand {
    additional_directories: Vec[string],
    context_path: string,
    caller: ffi::CallerContext,
    mode: ffi::CheckMode,
}

fn foreign_validation_option(option: string) -> bool {
    match option {
        "--additional-callers" | "--caller-mode" | "--context" | "--caller-directory" | "--caller-import-path" | "--caller-package" | "--ffi-check" => true,
        _ => false,
    }
}

fn foreign_validation_command(values: HashMap[string, string]) -> Result[
    ForeignValidationCommand,
    string,
] {
    let load_mode = values["--caller-mode"].unwrap_or("files");
    if load_mode != "package" && load_mode != "files" {
        return Result::Err("ffi-protocol: --caller-mode must be package or files")
    }
    let import_path = values["--caller-import-path"].unwrap_or("command-line-arguments");
    if load_mode == "files" && import_path != "command-line-arguments" {
        return Result::Err("ffi-protocol: files mode requires command-line-arguments")
    }
    let additional_directories: Vec[string] = Vec::new();
    if let Some(encoded) = values["--additional-callers"] {
        let entries = json::as_array(json::parse(encoded)?).ok_or(
            "ffi-protocol: additional callers must be an array",
        )?;
        for entry in entries {
            let directory = json::as_string(entry).ok_or(
                "ffi-protocol: caller directory must be a string",
            )?;
            if directory == "" || load_mode != "files" {
                return Result::Err(
                    "ffi-protocol: additional callers require files mode and nonempty directories",
                )
            }
            additional_directories.push(directory)
        }
    }
    Result::Ok(
        ForeignValidationCommand {
            additional_directories,
            context_path: values["--context"].unwrap_or(""),
            caller: ffi::CallerContext {
                generated_source: Option::None,
                load_mode,
                import_path,
                directory: values["--caller-directory"].unwrap_or("."),
                package_name: values["--caller-package"].unwrap_or("main"),
            },
            mode: ffi::parse_check_mode(values["--ffi-check"].unwrap_or("required"))?,
        },
    )
}

fn parse_foreign_artifact_command(args: Vec[string]) -> Result[ForeignArtifactCommand, string] {
    let interfaces: Vec[string] = Vec::new();
    let cores: Vec[string] = Vec::new();
    let source_paths: Vec[string] = Vec::new();
    let values: HashMap[string, string] = HashMap::new();
    let mut index = 2;
    while index < args.len() {
        let option = args[index];
        if index + 1 >= args.len() {
            return Result::Err("ffi-protocol: missing value for " + option)
        }
        let value = args[index + 1];
        if value == "" || value.starts_with("--") {
            return Result::Err("ffi-protocol: missing value for " + option)
        }
        match option {
            "--interface-path" => interfaces.push(value),
            "--core-path" => cores.push(value),
            "--source-path" => source_paths.push(value),
            "--source-package" => {
                if values[option].is_some() {
                    return Result::Err("ffi-protocol: repeated option " + option)
                }
                values[option] = value;
            },
            "--additional-callers" | "--caller-mode" | "--context" | "--caller-directory" | "--caller-import-path" | "--caller-package" | "--ffi-check" => {
                if values[option].is_some() {
                    return Result::Err("ffi-protocol: repeated option " + option)
                }
                values[option] = value;
            },
            _ => return Result::Err("ffi-protocol: unknown artifact-check option " + option),
        }
        index += 2;
    }
    if interfaces.is_empty() && cores.is_empty() {
        return Result::Err("ffi-protocol: at least one artifact is required")
    }
    Result::Ok(
        ForeignArtifactCommand {
            source_package: values["--source-package"].unwrap_or(""),
            source_paths,
            interfaces,
            cores,
            validation: foreign_validation_command(values)?,
        },
    )
}

fn foreign_unit_bindings(
    interfaces: Vec[artifact::ArtifactInterfaceUnit],
    cores: Vec[artifact::ArtifactCoreUnit],
) -> Result[Vec[ffi::ForeignBinding], string] {
    let traits: Vec[tast::TraitInfo] = Vec::new();
    let exports: Vec[artifact::ArtifactPackageExports] = Vec::new();
    for unit in interfaces {
        exports.push(unit.exports)
    }
    for unit in cores {
        exports.push(unit.exports)
    }
    for package_exports in exports {
        for definition in package_exports.traits {
            traits.push(artifact_dependency_trait(definition)?)
        }
    }
    let mut bindings: Vec[ffi::ForeignBinding] = Vec::new();
    for unit in interfaces {
        bindings = ffi::merge_bindings(bindings, foreign_interface_bindings(unit, traits)?)?;
    }
    for unit in cores {
        bindings = ffi::merge_bindings(
            bindings,
            foreign_artifact_bindings(unit.package_name, unit.exports, traits)?,
        )?;
    }
    Result::Ok(bindings)
}

fn check_foreign_artifacts(command: ForeignArtifactCommand) -> Result[(), string] {
    let interfaces = read_foreign_interfaces(command.interfaces)?;
    let cores = artifact_read_core_units(command.cores)?;
    validate_interface_bridge_units(interfaces, cores)?;
    let _ = foreign_unit_bindings(interfaces, cores)?;
    Result::Ok(())
}

fn read_foreign_interfaces(paths: Vec[string]) -> Result[
    Vec[artifact::ArtifactInterfaceUnit],
    string,
] {
    let result = Vec::new();
    for path_value in paths {
        result.push(artifact_read_interface_unit(path_value)?)
    }
    Result::Ok(result)
}

fn run_foreign_artifact_command(args: Vec[string]) -> () {
    match parse_foreign_artifact_command(args).and_then(|command| check_foreign_artifacts(command)) {
        Ok(()) => (),
        Err(message) => fail(message),
    }
}
