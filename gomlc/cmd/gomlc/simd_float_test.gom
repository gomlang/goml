package main;

use std::path;
use std::testing;

fn simd_float_source() -> (string, Vec[string]) {
    let mut source = "use std::simd; ";
    let mut main = "fn main() -> () { ";
    let kernels: Vec[string] = Vec::new();
    for bits in Vec::from_array([32, 64]) {
        let element = f"f{bits}";
        let integer = f"u{bits}";
        let exponent = if bits == 32 {
            "2139095040"
        } else {
            "9218868437227405312"
        };
        let mantissa = if bits == 32 {
            "8388607"
        } else {
            "4503599627370495"
        };
        let nan = if bits == 32 {
            "2143289344"
        } else {
            "9221120237041090560"
        };
        let patterns = if bits == 32 {
            "0, 2147483648, 1, 8388607, 8388608, 1056964607, 1056964608, 3204448256, 1069547520, 1065353217, 3212836865, 1325400063, 1325400064, 1333788672, 2139095039, 2139095040, 4286578688, 2143289345, 2139095041, 4290772993"
        } else {
            "0, 9223372036854775808, 1, 4503599627370495, 4503599627370496, 4602678819172646911, 4602678819172646912, 13826050856027422720, 4609434218613702656, 4607182418800017409, 13830554455654793217, 4746794007248502783, 4746794007248502784, 4751297606875873280, 9218868437227405311, 9218868437227405312, 18442240474082181120, 9221120237041090561, 9218868437227405313, 18444492273895866369"
        };
        source = source
            + f"fn show_scalar_{bits}(value: {element}) -> () {{ let raw = value.to_bits(); if raw & {exponent} == {exponent} && raw & {mantissa} != 0 {{ println({nan}) }} else {{ println(raw) }} }} ";
        main = main + f"{{ let bits: Vec[{integer}] = Vec::from_array([{patterns}]); ";
        for width in Vec::from_array([128, 256]) {
            let lanes = width / bits;
            let name = f"{element}x{lanes}";
            let ty = "simd::" + name;
            let mask = f"simd::mask{bits}x{lanes}";
            source = source
                + f"fn show_{name}(value: {ty}) -> () {{ let a = value.to_array(); for lane in 0..{lanes} {{ show_scalar_{bits}(a[lane]); }} }} ";
            let mut left = "";
            let mut right = "";
            let mut addend = "";
            for lane in 0..lanes {
                if lane > 0 {
                    left = left + ", ";
                    right = right + ", ";
                    addend = addend + ", ";
                }
                left = left + f"float{bits}_from_bits(bits[(index + {lane}) % bits.len()])";
                right = right + f"float{bits}_from_bits(bits[(other + {lane * 3}) % bits.len()])";
                addend = addend
                    + f"float{bits}_from_bits(bits[(index + other + {lane * 5}) % bits.len()])";
            }
            main = main
                + f"for index in 0..bits.len() {{ for other in 0..bits.len() {{ let a = {ty}::from_array([{left}]); let b = {ty}::from_array([{right}]); let c = {ty}::from_array([{addend}]); ";
            for operation in Vec::from_array(
                [
                    "add",
                    "sub",
                    "mul",
                    "div",
                    "min",
                    "max",
                    "interleave_low",
                    "interleave_high",
                    "deinterleave_even",
                    "deinterleave_odd",
                ],
            ) {
                let kernel = f"kernel_{name}_{operation}";
                source = source + f"fn {kernel}(a: {ty}, b: {ty}) -> {ty} {{ a.{operation}(b) }} ";
                main = main + f"show_{name}({kernel}(a, b)); ";
                kernels.push(kernel);
            }
            for operation in Vec::from_array(
                [
                    "neg",
                    "abs",
                    "sqrt",
                    "floor",
                    "ceil",
                    "trunc",
                    "round",
                    "round_ties_even",
                    "reverse",
                ],
            ) {
                let kernel = f"kernel_{name}_{operation}";
                source = source + f"fn {kernel}(a: {ty}) -> {ty} {{ a.{operation}() }} ";
                main = main + f"show_{name}({kernel}(a)); ";
                kernels.push(kernel);
            }
            for operation in Vec::from_array(["eq", "ne", "lt", "le", "gt", "ge"]) {
                let kernel = f"kernel_{name}_{operation}";
                source = source
                    + f"fn {kernel}(a: {ty}, b: {ty}) -> {mask} {{ a.simd_{operation}(b) }} ";
                main = main + f"println({kernel}(a, b).to_bitmask()); ";
                kernels.push(kernel);
            }
            for operation in Vec::from_array(["sum", "product", "min", "max"]) {
                let kernel = f"kernel_{name}_reduce_{operation}";
                source = source + f"fn {kernel}(a: {ty}) -> {element} {{ a.reduce_{operation}() }} ";
                main = main + f"show_scalar_{bits}({kernel}(a)); ";
                kernels.push(kernel);
            }
            for operation in Vec::from_array(["is_nan", "is_finite", "is_infinite"]) {
                let kernel = f"kernel_{name}_{operation}";
                source = source + f"fn {kernel}(a: {ty}) -> {mask} {{ a.{operation}() }} ";
                main = main + f"println({kernel}(a).to_bitmask()); ";
                kernels.push(kernel);
            }
            let kernel = f"kernel_{name}_mul_add";
            source = source
                + f"fn {kernel}(a: {ty}, b: {ty}, c: {ty}) -> {ty} {{ a.mul_add(b, c) }} ";
            main = main + f"show_{name}({kernel}(a, b, c)); ";
            kernels.push(kernel);
            let kernel = f"kernel_{name}_choose";
            source = source
                + f"fn {kernel}(mask: {mask}, a: {ty}, b: {ty}) -> {ty} {{ mask.select(a, b) }} ";
            main = main
                + f"show_{name}({kernel}({mask}::from_bitmask((index * 13 + other).to_u8()), a, b)); }} }} ";
            kernels.push(kernel);
        }
        main = main + "}; ";
    };
    (source + main + "}", kernels)
}

fn simd_fma32_oracle() -> string {
    "\nfunc init() {\n" + "check := func(a, b, c uint32) {\n"
        + "if a & 0x7f800000 == 0x7f800000 || b & 0x7f800000 == 0x7f800000 || c & 0x7f800000 == 0x7f800000 { return }\n"
        + "x := new(_simd_big.Float).SetPrec(1024).SetFloat64(float64(_goml_math.Float32frombits(a)))\n"
        + "y := new(_simd_big.Float).SetPrec(1024).SetFloat64(float64(_goml_math.Float32frombits(b)))\n"
        + "z := new(_simd_big.Float).SetPrec(1024).SetFloat64(float64(_goml_math.Float32frombits(c)))\n"
        + "exact := new(_simd_big.Float).SetPrec(1024).Mul(x, y)\nexact.Add(exact, z)\nwant, _ := exact.Float32()\n"
        + "got := _goml_math.Float32bits(_goml_simd_f32x4_mul_add_lane(_goml_math.Float32frombits(a), _goml_math.Float32frombits(b), _goml_math.Float32frombits(c)))\nif got != _goml_math.Float32bits(want) && !(want == 0 && got & 0x7fffffff == 0) { panic(\"f32 FMA differs from exact rounding\") }\n}\n"
        + "check(0x3fc00000, 0x3f800001, 0x8d800000)\ncheck(0x3fc00000, 0x3f800001, 0x0d800000)\n"
        + "state := uint32(42)\nfor i := 0; i < 4096; i++ { state = state * 1664525 + 1013904223; a := state; state = state * 1664525 + 1013904223; b := state; state = state * 1664525 + 1013904223; check(a, b, state) }\n}\n"
}

#[test]
fn simd_float_math_and_fma_match_scalar_and_exact_rounding() -> () {
    let temporary = temp_go_path("simd-float-math.gom", "simd-float-math");
    let (source, kernels) = simd_float_source();
    let result = exercise_simd_numeric_source(
        path::parent(temporary).unwrap_or(""),
        source,
        kernels,
        simd_fma32_oracle(),
    );
    cleanup_temp_directory(temporary);
    if let Err(error) = result {
        testing::fail(error);
    }
}
