package main;

use module::ffi;
use std::fs;

fn foreign_go_build_command(args: Vec[string]) -> Result[(), string] {
    let values: HashMap[string, string] = HashMap::new();
    let mut index = 2;
    while index < args.len() {
        let key = args[index];
        if key != "--context" && key != "--input" && key != "--output" {
            return Result::Err("ffi-protocol: unknown Go build option " + key)
        }
        if values[key].is_some() {
            return Result::Err("ffi-protocol: repeated option " + key)
        }
        if index + 1 >= args.len() || args[index + 1] == "" || args[index + 1].starts_with("--") {
            return Result::Err("ffi-protocol: missing value for " + key)
        }
        values[key] = args[index + 1];
        index += 2;
    }
    let context = ffi::decode_build_context(
        fs::read_file_structured(values["--context"].ok_or("ffi-protocol: --context is required")?).map_err(
            |error| error.to_string(),
        )?,
    )?;
    let input = values["--input"].ok_or("ffi-protocol: --input is required")?;
    let output = values["--output"].ok_or("ffi-protocol: --output is required")?;
    let arguments = Vec::from_array(["build"]);
    if context.go111module == "on" {
        arguments.push("-mod=readonly")
    }
    if !context.build_tags.is_empty() {
        let mut tags = "";
        for tag in context.build_tags {
            if tags != "" {
                tags = tags + ",";
            }
            tags = tags + tag;
        }
        arguments.push("-tags=" + tags)
    }
    arguments.push("-o");
    arguments.push(output);
    arguments.push(input);
    let status = foreign_go_process(context, arguments).status_structured().map_err(
        |error| error.to_string(),
    )?;
    if status.success() {
        Result::Ok(())
    } else {
        Result::Err("Go build failed")
    }
}

fn run_foreign_go_build_command(args: Vec[string]) -> () {
    match foreign_go_build_command(args) {
        Ok(()) => (),
        Err(message) => fail(message),
    }
}
