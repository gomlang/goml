package main;

use module::artifact;
use module::artifact::interface_codec;
use module::artifact::core_codec;
use module::tast;
use std::fs;
use std::path;
use std::testing;

fn compile_go_export_fixture(directory: string, name: string, prefix: string) -> Result[
    ArtifactCompiledPackage,
    string,
] {
    fs::create_dir_all(directory).map_err(|error| error.to_string())?;
    let source = path::join(directory, "calc.gom");
    fs::write_file_structured(
        source,
        prefix + "package calc; type Word = i64; #[go_export(\"" + name
            + "\")] pub fn add(x: Word, y: Word) -> Word { x + y } pub fn ordinary() -> bool { true }",
    ).map_err(|error| error.to_string())?;
    compile_artifact_package(
        test_package_world(),
        PackageCommandArgs {
            foreign_validation: Option::None,
            package_name: "demo::calc",
            module_name: "demo::calc",
            inputs: Vec::from_array([source]),
            interface_paths: Vec::new(),
            output: path::join(directory, "calc"),
            world: Option::None,
        },
        true,
        false,
    )
}

fn exercise_go_export_artifacts(directory: string) -> Result[(), string] {
    let first = compile_go_export_fixture(directory, "Add", "")?;
    testing::assert_eq(first.interface_unit.exports.go_exports.len(), 1);
    let descriptor = first.interface_unit.exports.go_exports[0];
    testing::assert_eq(descriptor.symbol, "demo::calc::add");
    testing::assert_eq(descriptor.go_name, "Add");
    testing::assert_eq(descriptor.source_file, "calc.gom");
    testing::assert(
        tast::types_equal(
            descriptor.ty,
            tast::Type::Func {
                params: Vec::from_array([tast::Type::Int64, tast::Type::Int64]),
                ret_ty: tast::Type::Int64,
            },
        ),
    );
    let decoded_interface = interface_codec::decode_binary(
        interface_codec::encode_binary(first.interface_unit)?,
    )?;
    let decoded_core = core_codec::decode_binary(core_codec::encode_binary(first.core_unit)?)?;
    testing::assert_eq(decoded_interface.exports.go_exports[0].go_name, "Add");
    testing::assert_eq(decoded_core.exports.go_exports[0].go_name, "Add");
    testing::assert(
        tast::types_equal(
            decoded_interface.exports.go_exports[0].ty,
            decoded_core.exports.go_exports[0].ty,
        ),
    );
    testing::assert_eq(decoded_interface.interface_hash, first.interface_unit.interface_hash);
    let moved = compile_go_export_fixture(directory, "Add", "\n\n")?;
    testing::assert_ne(moved.interface_unit.exports.go_exports[0].start, descriptor.start);
    testing::assert_eq(moved.interface_unit.interface_hash, first.interface_unit.interface_hash);
    let renamed = compile_go_export_fixture(directory, "Sum", "")?;
    testing::assert_ne(renamed.interface_unit.interface_hash, first.interface_unit.interface_hash);
    first.core_unit.exports.go_exports.push(descriptor);
    testing::assert(core_codec::decode_binary(core_codec::encode_binary(first.core_unit)?).is_err());
    let forged = artifact::ArtifactGoExport {
        package_name: descriptor.package_name,
        symbol: descriptor.symbol,
        go_name: descriptor.go_name,
        ty: tast::Type::Func { params: Vec::new(), ret_ty: tast::Type::Bool },
        source_file: descriptor.source_file,
        start: descriptor.start,
        end: descriptor.end,
    };
    renamed.core_unit.exports.go_exports.set(0, forged);
    testing::assert(
        core_codec::decode_binary(core_codec::encode_binary(renamed.core_unit)?).is_err(),
    );
    renamed.core_unit.exports.go_exports.set(0, descriptor);
    renamed.core_unit.tests.push(
        artifact::ArtifactTestDescriptor {
            id: "demo::calc::add",
            package_name: "demo::calc",
            symbol: descriptor.symbol,
            display_name: "add",
            source_path: "calc.gom",
            start: 0,
            end: 1,
            ignored: false,
            ignore_reason: Option::None,
            arguments: Vec::new(),
        },
    );
    testing::assert(
        core_codec::decode_binary(core_codec::encode_binary(renamed.core_unit)?).is_err(),
    );
    Result::Ok(())
}

#[test]
fn go_export_artifacts_preserve_api_and_exclude_debug_positions_from_hash() -> () {
    let temporary = temp_go_path("go-export.gom", "metadata");
    let result = exercise_go_export_artifacts(path::parent(temporary).unwrap_or(""));
    cleanup_temp_directory(temporary);
    match result {
        Ok(()) => (),
        Err(message) => testing::fail(message),
    }
}
