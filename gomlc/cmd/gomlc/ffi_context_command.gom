package main;

use module::ffi;
use std::fs;
use std::json;

fn write_foreign_context_command(args: Vec[string]) -> Result[(), string] {
    let values: HashMap[string, string] = HashMap::new();
    let mut index = 2;
    while index < args.len() {
        let key = args[index];
        if key != "--go" && key != "--module-directory" && key != "--output" {
            return Result::Err("ffi-protocol: unknown build-context option " + key)
        }
        if values[key].is_some() {
            return Result::Err("ffi-protocol: repeated option " + key)
        }
        if index + 1 >= args.len() || args[index + 1] == "" || args[index + 1].starts_with("--") {
            return Result::Err("ffi-protocol: missing value for " + key)
        }
        values[key] = args[index + 1];
        index += 2;
    }
    let program = values["--go"].ok_or("ffi-protocol: --go is required")?;
    let directory = values["--module-directory"].ok_or(
        "ffi-protocol: --module-directory is required",
    )?;
    let output = values["--output"].ok_or("ffi-protocol: --output is required")?;
    let context = resolve_foreign_build_context(program, directory)?;
    let import_path = foreign_module_import_path(context)?;
    let value = ffi::build_context_json(context);
    match value {
        Object(fields) => {
            fields.push(("module_import_path", json::Value::String(import_path)));
            fs::atomic_write(output, json::encode(json::Value::Object(fields))).map_err(
                |error| error.to_string(),
            )
        },
        _ => Result::Err("ffi-protocol: invalid serialized context"),
    }
}

fn run_foreign_context_command(args: Vec[string]) -> () {
    match write_foreign_context_command(args) {
        Ok(()) => (),
        Err(message) => fail(message),
    }
}
