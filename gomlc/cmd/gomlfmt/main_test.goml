package main;

use std::fs;
use std::path;
use std::testing;

fn args(values: Vec[string]) -> Vec[string] {
    let result = Vec::from_array(["gomlfmt"]);
    for value in values {
        result.push(value)
    }
    result
}

#[test]
fn parses_formatter_modes() -> () {
    match parse_options(args(Vec::from_array(["-w", "-l", "first.goml", "second.goml"]))) {
        Ok(options) => {
            testing::assert(options.write);
            testing::assert(options.list);
            testing::assert(!options.check);
            testing::assert_eq(options.paths.len(), 2)
        },
        Err(error) => testing::fail(error.to_string()),
    }
}

#[test]
fn defaults_to_stdin() -> () {
    match parse_options(args(Vec::new())) {
        Ok(options) => {
            testing::assert_eq(options.paths.len(), 1);
            testing::assert_eq(options.paths[0], "-")
        },
        Err(error) => testing::fail(error.to_string()),
    }
}

#[test]
fn rejects_ambiguous_multiple_file_output() -> () {
    match parse_options(args(Vec::from_array(["first.goml", "second.goml"]))) {
        Ok(_) => testing::fail("multiple stdout files accepted"),
        Err(error) => testing::assert_eq(error, "multiple files require -w, -l, or --check"),
    }
}

#[test]
fn rejects_writing_stdin() -> () {
    match parse_options(args(Vec::from_array(["-w", "-"]))) {
        Ok(_) => testing::fail("stdin write accepted"),
        Err(error) => testing::assert_eq(error, "-w cannot be used with stdin"),
    }
}

fn test_file(name: string) -> string {
    let root = "../_artifact/test-work/gomlfmt";
    if let Err(error) = fs::create_dir_all(root) {
        testing::fail(error.to_string())
    }
    path::join(root, name)
}

fn write_test_file(path_value: string, content: string) -> () {
    if let Err(error) = fs::write_file_structured(path_value, content) {
        testing::fail(error.to_string())
    }
}

fn read_test_file(path_value: string) -> string {
    match fs::read_file_structured(path_value) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            ""
        },
    }
}

#[test]
fn writes_only_after_all_files_format_successfully() -> () {
    let valid = test_file("atomic-valid.goml");
    let invalid = test_file("atomic-invalid.goml");
    let original =
        \\package main;
        \\fn main( )->(){()}
        \\
    ;
    write_test_file(valid, original);
    write_test_file(
        invalid,
        \\package main;
        \\fn broken( {
        ,
    );
    let code = run(
        Options { write: true, list: false, check: false, paths: Vec::from_array([valid, invalid]) },
    );
    testing::assert_eq(code, 2);
    testing::assert_eq(read_test_file(valid), original)
}

#[test]
fn writes_and_checks_formatted_files() -> () {
    let file = test_file("write-check.goml");
    write_test_file(
        file,
        \\package main;
        \\fn main( )->(){()}
        \\
        ,
    );
    testing::assert_eq(
        run(Options { write: false, list: false, check: true, paths: Vec::from_array([file]) }),
        1,
    );
    testing::assert_eq(
        run(Options { write: true, list: false, check: false, paths: Vec::from_array([file]) }),
        0,
    );
    testing::assert_eq(
        run(Options { write: false, list: false, check: true, paths: Vec::from_array([file]) }),
        0,
    )
}

#[test]
fn list_mode_does_not_modify_files() -> () {
    let file = test_file("list.goml");
    let original =
        \\package main;
        \\fn main( )->(){()}
        \\
    ;
    write_test_file(file, original);
    testing::assert_eq(
        run(Options { write: false, list: true, check: false, paths: Vec::from_array([file]) }),
        0,
    );
    testing::assert_eq(read_test_file(file), original)
}
