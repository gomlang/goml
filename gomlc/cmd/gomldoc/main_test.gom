package main;

use std::fs;
use std::json;
use std::path;
use std::testing;

fn doc_ok[T, E: ToString](value: Result[T, E]) -> T {
    match value {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            loop {}
        },
    }
}

#[test]
fn documentation_cli_rejects_invalid_options() -> () {
    for arguments in Vec::from_array(
        [
            Vec::from_array(["gomldoc", "--format", "xml"]),
            Vec::from_array(["gomldoc", "--output"]),
            Vec::from_array(["gomldoc", "--format", "json", "--format", "html"]),
            Vec::from_array(["gomldoc", "--document-private-items", "--document-private-items"]),
            Vec::from_array(["gomldoc", "first", "second"]),
        ],
    ) {
        testing::assert_err(parse_options(arguments))
    }
}

#[test]
fn documentation_cli_writes_deterministic_output_and_preserves_previous_success() -> () {
    let root = doc_ok(path::absolute_structured("_artifact/documentation-tests/cli"));
    if fs::exists(root) {
        doc_ok(fs::remove_dir_all(root));
    }
    doc_ok(fs::create_dir_all(root));
    doc_ok(
        fs::write_file_structured(path::join(root, "goml.toml"), "[module]\npath = \"cli_docs\"\n"),
    );
    let input = path::join(root, "main.gom");
    doc_ok(
        fs::write_file_structured(
            input,
            "//! Module docs.\npackage sample;\n/// Add one.\npub fn add(value: isize) -> isize { value + 1 }\n",
        ),
    );
    let options = Options {
        directory: root,
        format: "json",
        output: Option::None,
        target_dir: Option::None,
        private_items: false,
    };
    doc_ok(run(options));
    let output = path::join(root, "_artifact/doc/module.json");
    let original = doc_ok(fs::read_file_structured(output));
    let parsed = doc_ok(json::parse(original));
    testing::assert(json::field(parsed, "schema_version").and_then(json::as_int) == Option::Some(1));
    doc_ok(run(options));
    testing::assert_eq(doc_ok(fs::read_file_structured(output)), original);
    doc_ok(
        fs::write_file_structured(input, "package sample;\npub fn broken() -> isize { false }\n"),
    );
    testing::assert_err(run(options));
    testing::assert_eq(doc_ok(fs::read_file_structured(output)), original);
    testing::assert_err(run(Options { output: Option::Some(root), ..options }));
    doc_ok(
        fs::write_file_structured(
            input,
            "package sample;\npub struct Value { pub amount: isize }\n",
        ),
    );
    doc_ok(run(Options { format: "html", ..options }));
    testing::assert(fs::is_file(path::join(root, "_artifact/doc/index.html")));
    testing::assert(!fs::exists(output));
}
