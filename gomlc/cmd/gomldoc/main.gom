package main;

use module::doc;
use module::query;
use module::version;
use std::env;
use std::io;
use std::path;
use std::process;

struct Options {
    directory: string,
    format: string,
    output: Option[string],
    target_dir: Option[string],
    private_items: bool,
}

fn help() -> string {
    \\Usage: gomldoc [OPTIONS] [MODULE_DIR]
    \\
    \\Options:
    \\  --format html|json        output format (default: html)
    \\  --output DIR              output directory (default: <target-dir>/doc)
    \\  --target-dir DIR          build target directory
    \\  --document-private-items  include private API
    \\  -h, --help                print help
    \\  --version                 print version
}

fn parse_options(args: Vec[string]) -> Result[Options, string] {
    let mut directory: Option[string] = Option::None;
    let mut format: Option[string] = Option::None;
    let mut output: Option[string] = Option::None;
    let mut target_dir: Option[string] = Option::None;
    let mut private_items = false;
    let mut positional = false;
    let mut index = 1;
    while index < args.len() {
        let argument = args[index];
        if !positional && argument == "--" {
            positional = true;
        } else if !positional && (argument == "--help" || argument == "-h") {
            return Result::Err("help")
        } else if !positional && argument == "--version" {
            return Result::Err("version")
        } else if !positional && argument == "--document-private-items" {
            if private_items {
                return Result::Err("--document-private-items cannot be repeated")
            }
            private_items = true;
        } else if !positional
            && (argument == "--format" || argument == "--output" || argument == "--target-dir") {
            index += 1;
            if index >= args.len() || args[index] == "" || args[index].starts_with("--") {
                return Result::Err(argument + " requires a value")
            }
            if argument == "--format" {
                if format.is_some() {
                    return Result::Err("--format cannot be repeated")
                }
                format = Option::Some(args[index]);
            } else if argument == "--target-dir" {
                if target_dir.is_some() {
                    return Result::Err("--target-dir cannot be repeated")
                }
                target_dir = Option::Some(args[index]);
            } else {
                if output.is_some() {
                    return Result::Err("--output cannot be repeated")
                }
                output = Option::Some(args[index]);
            }
        } else if !positional && argument.starts_with("-") {
            return Result::Err("unknown option " + argument)
        } else {
            if directory.is_some() {
                return Result::Err("expected at most one module directory")
            }
            directory = Option::Some(argument);
        }
        index += 1;
    }
    let format = format.unwrap_or("html");
    if format != "html" && format != "json" {
        return Result::Err("--format must be html or json")
    }
    Result::Ok(
        Options { directory: directory.unwrap_or("."), format, output, target_dir, private_items },
    )
}

fn run(options: Options) -> Result[(), string] {
    let discovered = query::documentation_project(options.directory)?;
    let project = if let Some(target) = options.target_dir {
        query::DocProject {
            target_dir: if path::is_absolute(target) {
                path::clean(target)
            } else {
                path::clean(path::join(discovered.root, target))
            },
            ..discovered,
        }
    } else {
        discovered
    };
    let output = doc::output_path(project, options.output)?;
    let module_doc = query::document_module(project, options.private_items, output)?;
    for warning in module_doc.warnings {
        io::eprintln("warning: " + warning)
    }
    let pages = if options.format == "html" {
        doc::render_html(module_doc)
    } else {
        Vec::from_array([doc::Page { name: "module.json", content: doc::render_json(module_doc) }])
    };
    doc::write_output(output, pages)?;
    io::println("Documented " + module_doc.name + " in " + output);
    Result::Ok(())
}

fn main() -> () {
    match parse_options(env::args()) {
        Ok(options) => if let Err(error) = run(options) {
            io::eprintln("error: " + error);
            process::exit(1)
        },
        Err(error) => if error == "help" {
            io::println(help())
        } else if error == "version" {
            io::println("gomldoc " + version::current())
        } else {
            io::eprintln("error: " + error);
            process::exit(2)
        },
    }
}
