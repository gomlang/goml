package repr;

fn callback_text_value(value: Type) -> bool {
    match resolve_type(value) {
        String | Char => true,
        Array { elem, .. } | Slice { elem } | MutSlice { elem } | Channel { elem, .. } => callback_text_value(
            elem,
        ),
        Tuple { items } => {
            for value in items {
                if callback_text_value(value) {
                    return true
                }
            }
            false
        },
        GoMap { key, value } => callback_text_value(key) || callback_text_value(value),
        _ => false,
    }
}

pub fn validate_callback_signature(signature: Type) -> Result[(), string] {
    match resolve_type(signature) {
        Func { params, ret_ty } => {
            for value in params {
                if callback_text_value(value) {
                    return Result::Err(
                        "Go callback conversions require ffi::String and ffi::Rune for text values",
                    )
                }
            }
            if callback_text_value(ret_ty) {
                return Result::Err(
                    "Go callback conversions require ffi::String and ffi::Rune for text values",
                )
            }
            validate_type_in(Type::GoFunction { signature }, "callback signature")
        },
        _ => Result::Err("callback adapter requires a function signature"),
    }
}

pub fn validate_callback_adapter(value: CallbackAdapter, ty: Type) -> Result[(), string] {
    validate_callback_signature(value.signature)?;
    let raw = Type::GoFunction { signature: value.signature };
    let source = if value.to_go {
        value.signature
    } else {
        raw
    };
    let target = if value.to_go {
        raw
    } else {
        value.signature
    };
    match resolve_type(ty) {
        Func { params, ret_ty } if params.len() == 1 && types_equal(params[0], source)
            && types_equal(ret_ty, target) => Result::Ok(()),
        _ => Result::Err("callback adapter callable type does not match its conversion signature"),
    }
}
