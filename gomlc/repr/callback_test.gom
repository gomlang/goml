package repr;

use module::ast;
use std::testing;

#[test]
fn callback_adapter_metadata_requires_matching_direction_and_signature() -> () {
    let signature = Type::Func { params: Vec::from_array([Type::Int64]), ret_ty: Type::Bool };
    let raw = Type::GoFunction { signature };
    let forward = Type::Func { params: Vec::from_array([signature]), ret_ty: raw };
    let reverse = Type::Func { params: Vec::from_array([raw]), ret_ty: signature };
    testing::assert(
        validate_callback_adapter(CallbackAdapter { signature, to_go: true }, forward).is_ok(),
    );
    testing::assert(
        validate_callback_adapter(CallbackAdapter { signature, to_go: false }, reverse).is_ok(),
    );
    testing::assert(
        validate_callback_adapter(CallbackAdapter { signature, to_go: true }, reverse).is_err(),
    );
    testing::assert(
        validate_callback_adapter(CallbackAdapter { signature, to_go: false }, forward).is_err(),
    );
    testing::assert(validate_callback_signature(Type::Int64).is_err());
    for value in Vec::from_array(
        [
            Type::String,
            Type::Char,
            Type::Array { len: 2, elem: Type::Char },
            Type::MutSlice { elem: Type::String },
            Type::Channel { elem: Type::String, direction: ast::ChannelDirection::Both },
            Type::GoMap { key: Type::String, value: Type::Int64 },
        ],
    ) {
        testing::assert(
            validate_callback_signature(
                Type::Func { params: Vec::from_array([value]), ret_ty: Type::Unit },
            ).is_err(),
        );
        testing::assert(
            validate_callback_signature(
                Type::Func {
                    params: Vec::new(),
                    ret_ty: Type::Tuple { items: Vec::from_array([Type::Int64, value]) },
                },
            ).is_err(),
        );
    }
    testing::assert(
        validate_callback_signature(
            Type::Func {
                params: Vec::from_array(
                    [Type::External { import_path: "", name: "string", args: Vec::new() }],
                ),
                ret_ty: Type::Int32,
            },
        ).is_ok(),
    );
}
