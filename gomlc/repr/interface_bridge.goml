package repr;

pub struct GoInterfaceBridgeMethod {
    pub name: string,
    pub signature: Type,
}

pub struct GoInterfaceBridge {
    pub target: Type,
    pub methods: Vec[GoInterfaceBridgeMethod],
}

fn interface_bridge_method_name(name: string) -> bool {
    if name.byte_len() == 0 || name.byte_get(0) < b'A' || name.byte_get(0) > b'Z' {
        return false
    }
    for index in 1..name.byte_len() {
        let value = name.byte_get(index);
        if !(value >= b'A' && value <= b'Z') && !(value >= b'a' && value <= b'z')
            && !(value >= b'0' && value <= b'9')
            && value != b'_' {
            return false
        }
    }
    true
}

fn interface_bridge_value(value: Type, depth: isize) -> Result[(), string] {
    if depth > 128 {
        return Result::Err("Go interface bridge type depth exceeded")
    }
    match resolve_type(value) {
        Bool | Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | Float32 | Float64 => Result::Ok(
            (),
        ),
        External { args, .. } => {
            for arg in args {
                interface_bridge_value(arg, depth + 1)?;
            }
            validate_type(value)
        },
        Array { elem, .. } | MutSlice { elem } | GoPointer { elem } | Channel { elem, .. } => {
            interface_bridge_value(elem, depth + 1)?;
            validate_type(value)
        },
        GoMap { key, value } => {
            interface_bridge_value(key, depth + 1)?;
            interface_bridge_value(value, depth + 1)?;
            validate_type(Type::GoMap { key, value })
        },
        GoFunction { signature } => interface_bridge_signature(signature, depth + 1),
        _ => Result::Err("Go interface bridge requires explicit native boundary types"),
    }
}

fn interface_bridge_signature(signature: Type, depth: isize) -> Result[(), string] {
    if depth > 128 {
        return Result::Err("Go interface bridge type depth exceeded")
    }
    let Func { params, ret_ty } = resolve_type(signature) else {
        return Result::Err("Go interface bridge method requires a function signature")
    };
    for param in params {
        interface_bridge_value(param, depth + 1)?;
    }
    match resolve_type(ret_ty) {
        Unit => Result::Ok(()),
        Tuple { items } => {
            for item in items {
                interface_bridge_value(item, depth + 1)?;
            }
            Result::Ok(())
        },
        _ => interface_bridge_value(ret_ty, depth + 1),
    }
}

pub fn go_interface_bridge_type(value: GoInterfaceBridge) -> Type {
    let params = Vec::new();
    for method in value.methods {
        params.push(method.signature);
    }
    Type::Func { params, ret_ty: value.target }
}

pub fn validate_go_interface_bridge(value: GoInterfaceBridge, callable_type: Type) -> Result[
    (),
    string,
] {
    let External { import_path, name, .. } = resolve_type(value.target) else {
        return Result::Err("Go interface bridge target requires a native named type")
    };
    if import_path == "" && name != "error" {
        return Result::Err("Go interface bridge target is not a native interface identity")
    }
    interface_bridge_value(value.target, 0)?;
    let names: Vec[string] = Vec::new();
    for method in value.methods {
        if !interface_bridge_method_name(method.name) {
            return Result::Err("Go interface bridge requires exported ASCII method names")
        }
        if names.contains(method.name) {
            return Result::Err("Go interface bridge has duplicate method names")
        }
        names.push(method.name);
        interface_bridge_signature(method.signature, 0)?;
    }
    if !types_equal(callable_type, go_interface_bridge_type(value)) {
        return Result::Err("Go interface bridge callable does not match its construction plan")
    }
    Result::Ok(())
}
