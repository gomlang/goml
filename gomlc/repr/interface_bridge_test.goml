package repr;

use std::testing;

fn reader_bridge(signature: Type) -> GoInterfaceBridge {
    GoInterfaceBridge {
        target: Type::External { import_path: "io", name: "Reader", args: Vec::new() },
        methods: Vec::from_array([GoInterfaceBridgeMethod { name: "Read", signature }]),
    }
}

#[test]
fn go_interface_bridge_validates_native_results_and_factory_signature() -> () {
    let error = Type::External { import_path: "", name: "error", args: Vec::new() };
    let signature = Type::Func {
        params: Vec::from_array([Type::MutSlice { elem: Type::Uint8 }]),
        ret_ty: Type::Tuple { items: Vec::from_array([Type::Int, error]) },
    };
    let bridge = reader_bridge(signature);
    testing::assert(validate_go_interface_bridge(bridge, go_interface_bridge_type(bridge)).is_ok());
    testing::assert(
        validate_go_interface_bridge(
            bridge,
            Type::Func { params: Vec::new(), ret_ty: bridge.target },
        ).is_err(),
    );
    testing::assert(
        validate_go_interface_bridge(
            bridge,
            Type::Func { params: Vec::from_array([signature]), ret_ty: Type::Int },
        ).is_err(),
    );
    let empty = GoInterfaceBridge { target: bridge.target, methods: Vec::new() };
    testing::assert(validate_go_interface_bridge(empty, go_interface_bridge_type(empty)).is_ok());
}

#[test]
fn go_interface_bridge_rejects_implicit_boundaries_and_invalid_method_sets() -> () {
    for value in Vec::from_array(
        [
            Type::String,
            Type::Char,
            Type::Slice { elem: Type::Uint8 },
            Type::GoPointer { elem: Type::String },
            Type::VecType { elem: Type::Uint8 },
            Type::Named { name: "UserStruct" },
            Type::Func { params: Vec::new(), ret_ty: Type::Unit },
            Type::Unit,
        ],
    ) {
        for signature in Vec::from_array(
            [
                Type::Func { params: Vec::from_array([value]), ret_ty: Type::Unit },
                Type::Func {
                    params: Vec::new(),
                    ret_ty: Type::Tuple { items: Vec::from_array([Type::Int, value]) },
                },
            ],
        ) {
            let bridge = reader_bridge(signature);
            testing::assert(
                validate_go_interface_bridge(bridge, go_interface_bridge_type(bridge)).is_err(),
            );
        }
    }
    let signature = Type::Func { params: Vec::new(), ret_ty: Type::Unit };
    let target = reader_bridge(signature).target;
    for name in Vec::from_array(["", "read", "Read.Bad", "Read){}"]) {
        let bridge = GoInterfaceBridge {
            target,
            methods: Vec::from_array([GoInterfaceBridgeMethod { name, signature }]),
        };
        testing::assert(
            validate_go_interface_bridge(bridge, go_interface_bridge_type(bridge)).is_err(),
        );
    }
    let method = GoInterfaceBridgeMethod { name: "Read", signature };
    let duplicate = GoInterfaceBridge { target, methods: Vec::from_array([method, method]) };
    testing::assert(
        validate_go_interface_bridge(duplicate, go_interface_bridge_type(duplicate)).is_err(),
    );
    for target in Vec::from_array(
        [Type::Int, Type::External { import_path: "", name: "string", args: Vec::new() }],
    ) {
        let bridge = GoInterfaceBridge { target, methods: Vec::new() };
        testing::assert(
            validate_go_interface_bridge(bridge, go_interface_bridge_type(bridge)).is_err(),
        );
    }
}
