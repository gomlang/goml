package repr;

use std::testing;

fn dynamic_type(associated_types: Vec[(string, Type)], additional_bounds: Vec[DynTraitBound]) -> Type {
    Type::Dyn { trait_name: "Iterator", args: Vec::new(), associated_types, additional_bounds }
}

#[test]
fn dynamic_representation_requires_unique_associated_bindings() -> () {
    let duplicate = Vec::from_array([("Item", Type::Int), ("Item", Type::Bool)]);
    testing::assert(validate_type(dynamic_type(duplicate, Vec::new())).is_err());
    testing::assert(
        validate_type(
            dynamic_type(
                Vec::new(),
                Vec::from_array(
                    [
                        DynTraitBound {
                            trait_name: "Other",
                            args: Vec::new(),
                            associated_types: duplicate,
                        },
                    ],
                ),
            ),
        ).is_err(),
    );
    testing::assert(
        validate_type(
            dynamic_type(Vec::from_array([("Item", Type::Int), ("Other", Type::Bool)]), Vec::new()),
        ).is_ok(),
    );
}
