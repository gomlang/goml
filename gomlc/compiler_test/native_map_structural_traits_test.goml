package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn native_maps_use_structural_native_comparison_without_goml_traits() -> () {
    let source = "use std::ffi; struct Point { x: i32 } #[derive(PartialEq, Eq, Hash)] struct Derived { x: i32 } fn main() -> () { let unused_array: Option[HashMap[[Point; 1], i32]] = None; println(unused_array.is_none()); let unused_tuple: Option[HashMap[(Point, i32), i32]] = None; println(unused_tuple.is_none()); let arrays: ffi::RawMap[[Point; 1], i32] = ffi::map_new(); ffi::map_set(arrays, [Point { x: 1 }], 7); println(ffi::map_get(arrays, [Point { x: 1 }]).unwrap_or(0)); println(ffi::map_get(arrays, [Point { x: 2 }]).unwrap_or(0)); let tuples: ffi::RawMap[(Point, i32), i32] = ffi::map_new(); ffi::map_set(tuples, (Point { x: 3 }, 0), 9); println(ffi::map_get(tuples, (Point { x: 3 }, 0)).unwrap_or(0)); println(ffi::map_get(tuples, (Point { x: 4 }, 0)).unwrap_or(0)); let hashed_arrays: HashMap[[i32; 1], i32] = HashMap::new(); hashed_arrays.insert([5], 11); println(hashed_arrays.get([5]).unwrap_or(0)); let hashed_tuples: HashMap[(i32, i32), i32] = HashMap::new(); hashed_tuples.insert((6, 0), 13); println(hashed_tuples.get((6, 0)).unwrap_or(0)); let derived: HashMap[Derived, i32] = HashMap::new(); derived.insert(Derived { x: 7 }, 17); println(derived.get(Derived { x: 7 }).unwrap_or(0)); }";
    let compilation = compiler_driver::compile_source("native_map_structural_traits.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "true\ntrue\n7\n0\n9\n0\n11\n13\n17\n";
    testing::assert_eq(
        execute_go(generated, expected, "native_map_structural_traits", 0, 0),
        expected,
    );
}
