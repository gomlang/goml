package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn impl_projection_predicates_and_values_retain_their_declaring_traits() -> () {
    let source = "trait Input { type Item; } trait Other { type Item; } impl Input for bool { type Item = i32; } impl Other for bool { type Item = bool; } trait Output { type Value; } impl[T: Input] Output for Vec[T] where T::Item = i32 { type Value = T::Item; } fn convert[T: Output](value: T::Value) -> i32 where T = Vec[bool] { value } trait SelfOutput { type Item; type Value; } impl[T: Input] SelfOutput for T { type Item = bool; type Value = Self::Item; } fn convert_self[T: SelfOutput](value: T::Value) -> bool where T = bool { value } fn main() -> () { println(convert::[Vec[bool]](7)); println(convert_self::[bool](true)); }";
    let compilation = compiler_driver::compile_source("impl_projection_metadata.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\ntrue\n";
    testing::assert_eq(execute_go(generated, expected, "impl_projection_metadata", 0, 0), expected);
}
