package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn structural_trait_receivers_execute_dot_ufcs_and_alias_calls() -> () {
    let source =
        \\trait Read { fn read(self: Self) -> i32; }
        \\impl Read for () -> i32 { fn read(self: () -> i32) -> i32 { self() } }
        \\impl Read for (i32, bool) { fn read(self: (i32, bool)) -> i32 { self.0 } }
        \\impl Read for () { fn read(self: ()) -> i32 { 3 } }
        \\impl Read for [i32; 2] { fn read(self: [i32; 2]) -> i32 { self[0] } }
        \\type Action = () -> i32;
        \\type Pair = (i32, bool);
        \\fn generic[T: Read](value: T) -> i32 { value.read() }
        \\fn main() -> () {
        \\    let captured: i32 = 7;
        \\    let action: Action = || captured;
        \\    println(action.read());
        \\    println(Read::read(action));
        \\    println(generic(action));
        \\    println(Action::read(action));
        \\    let action_read = Action::read;
        \\    println(action_read(action));
        \\    let pair: Pair = (9, true);
        \\    println(pair.read());
        \\    println(Read::read(pair));
        \\    println(generic(pair));
        \\    let pair_read = Pair::read;
        \\    println(pair_read(pair));
        \\    println(().read());
        \\    let array: [i32; 2] = [11, 12];
        \\    println(array.read());
        \\}
    ;
    let compilation = compiler_driver::compile_source("structural_receiver.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n7\n7\n7\n7\n9\n9\n9\n9\n3\n11\n";
    testing::assert_eq(execute_go(generated, expected, "structural_receiver", 0, 0), expected);
}
