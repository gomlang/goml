package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn inferred_for_iterators_use_each_protocol_and_convert_once() -> () {
    let source = "trait Source { type Items; fn items(self: Self) -> Self::Items; } struct Owner {} impl Source for Owner { type Items = Vec[i32]; fn items(self: Owner) -> Vec[i32] { Vec::from_array([7, 8]) } } fn get[T: Source](value: T) -> T::Items { value.items() } struct Numbers { values: Vec[i32], count: Ref[i32] } impl IntoIterator for Numbers { type Item = i32; type IntoIter = FnIterator[i32]; fn into_iter(self: Numbers) -> FnIterator[i32] { self.count.set(self.count.get() + 1); self.values.iter() } } fn main() -> () { let array = |xs| { for value in xs { let value: i32 = value; println(value); } }; array([1, 2]); let vector = |xs| { for value in xs { let value: i32 = value; println(value); } }; vector(Vec::from_array([3, 4])); let custom = |xs| { for value in xs { let value: i32 = value; println(value); } }; let count = Ref::new(0); custom(Numbers { values: Vec::from_array([5, 6]), count }); println(count.get()); let projected = |owner| { for value in get(owner) { let value: i32 = value; println(value); } }; projected(Owner {}); }";
    let compilation = compiler_driver::compile_source("for_iterator_inference.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "1\n2\n3\n4\n5\n6\n1\n7\n8\n";
    testing::assert_eq(execute_go(generated, expected, "for_iterator_inference", 0, 0), expected);
}
