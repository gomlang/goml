package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn method_overloads_preserve_never_coercions_and_container_invariance() -> () {
    let source =
        \\trait First { fn make(self: Self) -> never; fn values(self: Self) -> Vec[never]; }
        \\trait Second { fn make(self: Self) -> string; fn values(self: Self) -> Vec[i32]; }
        \\impl First for bool {
        \\    fn make(self: bool) -> never { loop {} }
        \\    fn values(self: bool) -> Vec[never] { Vec::new() }
        \\}
        \\impl Second for bool {
        \\    fn make(self: bool) -> string { "" }
        \\    fn values(self: bool) -> Vec[i32] { Vec::from_array([5]) }
        \\}
        \\fn choose(value: bool) -> i32 { if value { value.make() } else { 7 } }
        \\fn empty(value: bool) -> Vec[never] { value.values() }
        \\fn integers(value: bool) -> Vec[i32] { value.values() }
        \\fn main() -> () { let call = |value| value.make(); if false { let result: i32 = call(true); } println(choose(false)); println(empty(false).len()); println(integers(false)[0]); }
    ;
    let compilation = compiler_driver::compile_source("never_return_overload.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n0\n5\n";
    testing::assert_eq(execute_go(generated, expected, "never_return_overload", 0, 0), expected);
}
