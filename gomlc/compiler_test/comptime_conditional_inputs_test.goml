package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn comptime_aggregate_fields_and_arguments_propagate_conditional_loop_and_function_exits() -> () {
    let source =
        \\#[comptime]
        \\fn test_return(flag: bool) -> i32 {
        \\    let mut n: i32 = 0;
        \\    let x = ({n = 7; n}, if flag { return n; } else { n + 1 });
        \\    x.1
        \\}
        \\#[comptime]
        \\fn keep(a: i32, b: i32) -> i32 { a + b }
        \\#[comptime]
        \\fn test_loop() -> i32 {
        \\    let mut n: i32 = 0;
        \\    let mut sum: i32 = 0;
        \\    loop {
        \\        n += 1;
        \\        let x = keep(if n == 1 { continue; } else { n }, if n == 3 { break sum; } else { 3 });
        \\        sum += x;
        \\    }
        \\}
        \\fn main() -> () {
        \\    println(comptime { test_return(true) });
        \\    println(comptime { test_return(false) });
        \\    println(comptime { test_loop() });
        \\}
    ;
    let compilation = compiler_driver::compile_source("comptime_conditional_inputs.goml", source);
    let expected = "7\n8\n5\n";
    testing::assert_eq(
        execute_go(
            go_backend::encode(compilation.go_value),
            expected,
            "comptime_conditional_inputs",
            0,
            0,
        ),
        expected,
    );
}
