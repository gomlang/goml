package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn diverging_index_operands_exit_before_indexing() -> () {
    let source = "fn first() -> i32 { let values = [1]; values[return 7]; } fn second() -> i32 { (return 8)[0]; } fn main() -> () { println(first()); println(second()); }";
    let compilation = compiler_driver::compile_source("diverging_index.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n8\n";
    testing::assert_eq(execute_go(generated, expected, "diverging_index", 0, 0), expected);
}
