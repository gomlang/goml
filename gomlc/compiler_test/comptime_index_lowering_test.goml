package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn comptime_vector_and_array_indexing_execute() -> () {
    let source =
        \\#[comptime]
        \\fn ordered_index() -> i32 {
        \\    let state: Ref[i32] = Ref::new(0);
        \\    let values: Vec[i32] = Vec::from_array([7, 8]);
        \\    let base = || { state.set(state.get() * 10 + 1); values };
        \\    let offset = || { state.set(state.get() * 10 + 2); 1 };
        \\    let result = base()[offset()];
        \\    result * 100 + state.get()
        \\}
        \\fn main() -> () {
        \\    println(comptime { let values = Vec::from_array([7, 8]); values[0] });
        \\    println(comptime { let values = Vec::from_array([7, 8]); let alias = values; alias.set(0, 9); values[0] });
        \\    println(ordered_index());
        \\    println(comptime { ordered_index() });
        \\    println(comptime { let values: [i32; 2] = [10, 11]; values[1] });
        \\}
    ;
    let compilation = compiler_driver::compile_source("comptime_index_lowering.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n9\n812\n812\n11\n";
    testing::assert_eq(execute_go(generated, expected, "comptime_index_lowering", 0, 0), expected);
}
