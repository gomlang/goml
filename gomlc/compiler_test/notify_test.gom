package compiler_test;

use module::resources;
use std::fs;
use std::path;
use std::process;
use std::testing;
use std::time;

#[test]
fn filesystem_notification_state_machine_and_decoder() -> () {
    let project = path::join(repository_root(), "_artifact/notify-internal-tests");
    testing::expect_ok(fs::create_dir_all(project), "create notify test project");
    testing::expect_ok(
        fs::write_file_structured(
            path::join(project, "goml.toml"),
            "[module]\npath = \"notify_internal\"\n",
        ),
        "write manifest",
    );
    let sources = testing::expect_some(
        testing::expect_ok(
            resources::standard_sources(resources::STD_FS_NOTIFY_PACKAGE),
            "load notify",
        ),
        "notify package",
    );
    for source in sources {
        let name = testing::expect_some(path::file_name(source.path), "source name");
        testing::expect_ok(
            fs::write_file_structured(
                path::join(project, name),
                source.source.replace("use module::", "use std::"),
            ),
            "copy notify source",
        );
    }
    testing::expect_ok(
        fs::write_file_structured(
            path::join(project, "notify_test.gom"),
            read_file(path::join(compiler_tests_root(), "library/fs_notify/notify_test.gom")),
        ),
        "copy tests",
    );
    let output = testing::expect_ok(
        process::Command::new(bootstrap_goml_binary()).args(
            Vec::from_array(
                ["test", "--compiler", bootstrap_gomlc_binary(), "--jobs", "1", "--timeout", "30s"],
            ),
        ).current_dir(project).env("GOFLAGS", "-race").output_timeout_structured(
            time::Duration::from_seconds(90),
        ),
        "run notify tests",
    );
    assert_command_success(output, "notify internal tests with race detector");
}
