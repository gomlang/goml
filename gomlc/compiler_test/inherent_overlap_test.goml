package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn duplicate_inherent_members_are_rejected_before_specialization() -> () {
    let diagnostics = compiler_driver::diagnostic_output(
        "inherent_overlap.goml",
        "struct Value {} impl Value { fn read() -> i32 { 1 } } impl Value { fn read() -> bool { true } } fn main() -> () { let number: i32 = Value::read(); println(number); }",
    );
    testing::assert(diagnostics.contains("Inherent member read has overlapping implementations"));
}

#[test]
fn disjoint_inherent_specializations_keep_their_runtime_methods() -> () {
    let source = "struct Value[T] { value: T } impl Value[i32] { fn read() -> i32 { 1 } } impl Value[bool] { fn read() -> i32 { 2 } } fn main() -> () { println(Value::[i32]::read()); println(Value::[bool]::read()); }";
    let compilation = compiler_driver::compile_source(
        "disjoint_inherent_specializations.goml",
        source,
    );
    let generated = go_backend::encode(compilation.go_value);
    testing::assert_eq(
        execute_go(generated, "1\n2\n", "disjoint_inherent_specializations", 0, 0),
        "1\n2\n",
    );
}
