package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn chained_impl_projections_preserve_owner_and_method_generic_scopes() -> () {
    let source =
        \\trait Other[T] { type Output; }
        \\trait Main[A] { type Item: Other[A]; fn get[U](self, value: U) -> Self::Item::Output; }
        \\impl Other[i32] for bool { type Output = i32; }
        \\impl Other[string] for bool { type Output = string; }
        \\impl Main[i32] for i32 { type Item = bool; fn get[A](self, value: A) -> Self::Item::Output { 42 } }
        \\fn main() -> () { let value: i32 = 1; println(value.get("other scope")); }
    ;
    let compilation = compiler_driver::compile_source(
        "impl_chained_generic_projection.goml",
        source,
    );
    let generated = go_backend::encode(compilation.go_value);
    let expected = "42\n";
    testing::assert_eq(
        execute_go(generated, expected, "impl_chained_generic_projection", 0, 0),
        expected,
    );
}
