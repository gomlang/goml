package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn comptime_concrete_nominal_fields_substitute_nested_type_parameters_execute() -> () {
    let source =
        \\struct Box[T] { value: Ref[T] }
        \\struct Many[T] { values: Vec[T] }
        \\struct Callback[T] { value: (T) -> T }
        \\enum Choice[T] { Hold(Ref[Vec[T]]) }
        \\struct Nested[T] { value: (Ref[Vec[T]], (T) -> T) }
        \\struct Fixed[const N: usize] { value: [i32; N] }
        \\trait Read[T] { fn read(self: Self) -> T; }
        \\impl Read[i32] for bool { #[comptime] fn read(self: Self) -> i32 { 17 } }
        \\struct DynamicHolder[T] { value: dyn Read[T] }
        \\fn main() -> () {
        \\    println(comptime { let holder = Box { value: Ref::new(7) }; holder.value.get() });
        \\    println(comptime { let holder = Many { values: Vec::from_array([8, 9]) }; holder.values[0] });
        \\    println(comptime { let holder: Callback[i32] = Callback { value: |value| value + 1 }; (holder.value)(9) });
        \\    println(comptime {
        \\        let holder = Choice::Hold(Ref::new(Vec::from_array([11])));
        \\        match holder { Choice::Hold(value) => value.get()[0] }
        \\    });
        \\    println(comptime {
        \\        let holder: Nested[i32] = Nested { value: (Ref::new(Vec::from_array([12])), |value| value + 1) };
        \\        (holder.value.1)(holder.value.0.get()[0])
        \\    });
        \\    println(comptime { let holder: Fixed[2] = Fixed { value: [14, 15] }; holder.value[0] });
        \\    println(comptime { let holder: DynamicHolder[i32] = DynamicHolder { value: true as dyn Read[i32] }; holder.value.read() });
        \\}
    ;
    let compilation = compiler_driver::compile_source("comptime_nested_substitution.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n8\n10\n11\n13\n14\n17\n";
    testing::assert_eq(
        execute_go(generated, expected, "comptime_nested_substitution", 0, 0),
        expected,
    );
}
