package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn const_disjoint_impls_select_the_valid_implementation() -> () {
    let source =
        \\trait Fixed[const N: usize] {}
        \\impl[const N: usize] Fixed[N] for bool {}
        \\trait Pick { fn pick(self: Self) -> i32; }
        \\impl[const N: usize] Pick for [i32; N] where bool: Fixed[{N - 1}] { fn pick(self: [i32; N]) -> i32 { 1 } }
        \\impl Pick for [i32; 0] { fn pick(self: [i32; 0]) -> i32 { 2 } }
        \\fn choose[T: Pick](value: T) -> i32 { value.pick() }
        \\fn main() -> () { let empty: [i32; 0] = []; let full: [i32; 1] = [7]; println(empty.pick()); println(full.pick()); println(choose(empty)); println(choose(full)); }
    ;
    let compilation = compiler_driver::compile_source("overlap_const_validation.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "2\n1\n2\n1\n";
    testing::assert_eq(execute_go(generated, expected, "overlap_const_validation", 0, 0), expected);
}
