package compiler_test;

use module::compiler as compiler_driver;
use std::testing;

#[test]
fn duplicate_trait_compilation_reports_declaration_errors() -> () {
    for source in[
        "trait Same { fn value(self) -> bool; } trait Same {} impl Same for bool {} fn main() -> () {}",
        "trait Same { type Item; } trait Same {} impl Same for bool {} fn main() -> () {}",
    ] {
        let diagnostics = compiler_driver::diagnostic_output("duplicate_trait.goml", source);
        testing::assert(diagnostics.contains("trait Same is defined multiple times"));
    }
}
