package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn self_dependent_supertraits_execute_through_generic_opaque_and_dyn_values() -> () {
    let source =
        \\trait Parent[T] { fn take(self: Self, other: T) -> i32; }
        \\trait Child: Parent[Self] {}
        \\impl Parent[bool] for bool { fn take(self: bool, other: bool) -> i32 { 7 } }
        \\impl Child for bool {}
        \\fn choose[T: Child](value: T) -> i32 { value.take(value) }
        \\fn make() -> impl Child { true }
        \\trait Source { type Item; }
        \\trait Reader[T] { fn read(self: Self, value: T) -> i32; }
        \\trait Projected: Source + Reader[Self::Item] {}
        \\impl Source for bool { type Item = i32; }
        \\impl Reader[i32] for bool { fn read(self: bool, value: i32) -> i32 { value } }
        \\impl Projected for bool {}
        \\fn projected[T: Projected](value: T, item: T::Item) -> i32 { value.read(item) }
        \\fn main() -> () {
        \\    println(choose(true));
        \\    println(Child::take(true, true));
        \\    let opaque = make();
        \\    println(opaque.take(opaque));
        \\    println(projected(true, 11));
        \\    let dynamic = true as dyn Projected[Item = i32];
        \\    println(dynamic.read(13));
        \\}
    ;
    let compilation = compiler_driver::compile_source("supertrait_self_receiver.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n7\n7\n11\n13\n";
    testing::assert_eq(execute_go(generated, expected, "supertrait_self_receiver", 0, 0), expected);
}
