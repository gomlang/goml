package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn inferred_arithmetic_keeps_numeric_and_string_operations() -> () {
    let source =
        \\struct Item { value: u8 }
        \\fn main() -> () {
        \\    let read = |xs| { let [x, y] = xs; x + y };
        \\    println(read([1, 2]));
        \\    let add = |x, y| x + y;
        \\    println(add("a", "b"));
        \\    let mul = |x, y| x * y;
        \\    println(mul(1.5, 2.0));
        \\    let sub = |x, y| x - y;
        \\    let seven: u8 = 7;
        \\    println(sub(seven, 2));
        \\    let change = |x| { x.value -= 2; x.value };
        \\    println(change(Item { value: 7 }));
        \\}
    ;
    let compilation = compiler_driver::compile_source("arithmetic_operand_inference.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "3\nab\n3\n5\n5\n";
    testing::assert_eq(
        execute_go(generated, expected, "arithmetic_operand_inference", 0, 0),
        expected,
    );
}
