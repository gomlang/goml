package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn comptime_dynamic_dispatch_matches_runtime_trait_selection() -> () {
    let source =
        \\trait First { fn value(self: Self) -> i32; }
        \\trait Second { fn value(self: Self) -> i32; fn second(self: Self) -> i32; }
        \\impl First for bool { #[comptime] fn value(self: Self) -> i32 { 7 } }
        \\impl Second for bool {
        \\    #[comptime] fn value(self: Self) -> i32 { 8 }
        \\    #[comptime] fn second(self: Self) -> i32 { 9 }
        \\}
        \\trait Parent { fn value(self: Self) -> i32; fn parent(self: Self) -> i32; }
        \\trait Child: Parent { fn value(self: Self) -> i32; }
        \\impl Parent for bool {
        \\    #[comptime] fn value(self: Self) -> i32 { 11 }
        \\    #[comptime] fn parent(self: Self) -> i32 { 13 }
        \\}
        \\impl Child for bool { #[comptime] fn value(self: Self) -> i32 { 12 } }
        \\trait Empty {}
        \\impl Empty for bool {}
        \\trait Read[T] { fn read(self: Self) -> T; }
        \\impl Read[i32] for bool { #[comptime] fn read(self: Self) -> i32 { 14 } }
        \\impl Read[bool] for bool { #[comptime] fn read(self: Self) -> bool { true } }
        \\fn main() -> () {
        \\    let value = true as dyn First + Second;
        \\    println(First::value(value));
        \\    println(Second::value(value));
        \\    println(comptime { let value = true as dyn First + Second; First::value(value) });
        \\    println(comptime { let value = true as dyn First + Second; Second::value(value) });
        \\    println(comptime { let value = true as dyn Second + First; value.second() });
        \\    println(comptime { let value = true as dyn Child; value.value() });
        \\    println(comptime { let value = true as dyn Child; Parent::value(value) });
        \\    println(comptime { let value = true as dyn Child; value.parent() });
        \\    println(comptime { let value = true as dyn Empty + Read[i32]; value.read() });
        \\    println(comptime { let value = true as dyn Read[bool]; value.read() });
        \\    println(comptime { let _ = true as dyn Empty; 15 });
        \\}
    ;
    let compilation = compiler_driver::compile_source("comptime_dyn_dispatch.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n8\n7\n8\n9\n12\n11\n13\n14\ntrue\n15\n";
    testing::assert_eq(execute_go(generated, expected, "comptime_dyn_dispatch", 0, 0), expected);
}
