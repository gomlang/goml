package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn constrained_dyn_cast_sources_execute_without_reboxing() -> () {
    let source =
        \\trait Read { fn read(self: Self) -> i32; }
        \\trait Tag {}
        \\impl Read for i32 { fn read(self: i32) -> i32 { self } }
        \\impl Tag for i32 {}
        \\trait Source { type Item; }
        \\impl Source for bool { type Item = dyn Read; }
        \\fn wrap[T](value: T) -> dyn Read where T = dyn Read { value as dyn Read }
        \\fn concrete[T](value: T) -> dyn Read where T = i32 { value as dyn Read }
        \\fn projected[I: Source](witness: I, value: I::Item) -> dyn Read where I::Item = dyn Read { value as dyn Read }
        \\fn composite[T](value: T) -> dyn Tag + Read where T = dyn Read + Tag { value as dyn Tag + Read }
        \\fn main() -> () {
        \\    let n: i32 = 42;
        \\    let value = n as dyn Read;
        \\    println(wrap(value).read());
        \\    println(projected(false, value).read());
        \\    println(concrete(n).read());
        \\    println(composite(n as dyn Read + Tag).read());
        \\}
    ;
    let compilation = compiler_driver::compile_source("dyn_source_cast.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "42\n42\n42\n42\n";
    testing::assert_eq(execute_go(generated, expected, "dyn_source_cast", 0, 0), expected);
}
