package compiler_test;

use module::cmd::gomlc as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn unicode_byte_order_marks_survive_compilation_and_execution() -> () {
    let source =
        \\fn main() -> () {
        \\    let text = "\uFEFF中\uFEFF😀\uFEFF";
        \\    for byte in text.to_bytes() {
        \\        println(byte.to_string());
        \\    }
        \\    println('\uFEFF'.to_string().byte_len().to_string());
        \\}
    ;
    let compilation = compiler_driver::compile_source("byte_order_marks.gom", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "239\n187\n191\n228\n184\n173\n239\n187\n191\n240\n159\n152\n128\n239\n187\n191\n3\n";
    testing::assert_eq(execute_go(generated, expected, "byte_order_marks", 0, 0), expected);
}
