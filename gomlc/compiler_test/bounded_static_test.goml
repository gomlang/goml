package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn bounded_static_trait_methods_execute_across_dispatch_paths() -> () {
    let source = "struct Thing {}\ntrait StaticCount { fn count[const N: usize]() -> usize; }\nimpl StaticCount for Thing { fn count[const M: usize]() -> usize { M } }\ntrait DefaultCount { fn default_count[const N: usize]() -> usize { N } }\nimpl DefaultCount for Thing {}\ntrait Child: StaticCount {}\nimpl Child for Thing {}\ntrait Read { fn read(self: Self) -> usize; }\nimpl Read for Thing { fn read(self: Thing) -> usize { 24 } }\nfn bounded[T: StaticCount]() -> usize { T::count::[20]() }\nfn bounded_default[T: DefaultCount]() -> usize { T::default_count::[21]() }\nfn bounded_value[T: StaticCount]() -> usize { let f = T::count::[22]; f() }\nfn inherited[T: Child]() -> usize { T::count::[23]() }\nfn receiver_ufcs[T: Read](value: T) -> usize { T::read(value) }\nfn main() -> () {\n    println(Thing::count::[19]());\n    println(bounded::[Thing]());\n    println(bounded_default::[Thing]());\n    println(bounded_value::[Thing]());\n    println(inherited::[Thing]());\n    println(receiver_ufcs(Thing {}));\n}\n";
    let compilation = compiler_driver::compile_source("bounded_static.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "19\n20\n21\n22\n23\n24\n";
    testing::assert_eq(execute_go(generated, expected, "bounded_static", 0, 0), expected);
}
