package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn expected_dyn_arguments_select_the_matching_method() -> () {
    let source =
        \\trait Read[T] { fn read(self: Self) -> T; }
        \\impl Read[i32] for i32 { fn read(self: i32) -> i32 { self }
        \\} impl Read[bool] for bool { fn read(self: bool) -> bool { self }
        \\} trait First { fn make(self: Self) -> dyn Read[i32]; }
        \\trait Second { fn make(self: Self) -> dyn Read[bool]; }
        \\impl First for string { fn make(self: string) -> dyn Read[i32] { 7 as dyn Read[i32] }
        \\} impl Second for string { fn make(self: string) -> dyn Read[bool] { true as dyn Read[bool] }
        \\} fn main() -> () { let value: dyn Read[i32] = "".make(); println(value.read()); let other: dyn Read[bool] = "".make(); println(other.read()); }
    ;
    let compilation = compiler_driver::compile_source("dyn_return_overload.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\ntrue\n";
    testing::assert_eq(execute_go(generated, expected, "dyn_return_overload", 0, 0), expected);
}
