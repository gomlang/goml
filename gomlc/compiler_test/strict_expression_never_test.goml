package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn strict_expression_inputs_exit_in_order_without_evaluating_later_inputs() -> () {
    let source = "struct S { a: i32, b: i32, c: i32 } fn mark(value: i32) -> i32 { println(value); value } fn take(a: i32, b: i32, c: i32) -> () { println(999); } fn tuple() -> i32 { (mark(1), return 7, mark(999)) } fn array() -> i32 { [mark(2), return 8, mark(999)]; } fn repeat() -> i32 { [return 9; 0]; } fn call() -> i32 { take(mark(3), return 10, mark(999)) } fn structure() -> i32 { S { a: mark(4), b: return 11, c: mark(999) }; } fn spawn() -> i32 { go (return 12); } fn main() -> () { println(tuple()); println(array()); println(repeat()); println(call()); println(structure()); println(spawn()); }";
    let compilation = compiler_driver::compile_source("strict_expression_never.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "1\n7\n2\n8\n9\n3\n10\n4\n11\n12\n";
    testing::assert_eq(execute_go(generated, expected, "strict_expression_never", 0, 0), expected);
}
