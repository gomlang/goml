package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn divergent_control_inputs_preserve_evaluation_order() -> () {
    let source =
        \\fn stop(out: Channel[i32], number: i32) -> never {
        \\    out.send(number);
        \\    let wait = Channel::[()]::new(0);
        \\    loop { let _ = wait.recv(); }
        \\}
        \\fn condition(out: Channel[i32]) -> never {
        \\    if stop(out, 1) { () } else { () }
        \\}
        \\fn scrutinee(out: Channel[i32]) -> never {
        \\    match stop(out, 2) { _ => () }
        \\}
        \\fn send_value(out: Channel[i32]) -> never {
        \\    let data = Channel::[i32]::new(1);
        \\    select { send(data, stop(out, 3)) => (), default => (), }
        \\}
        \\fn guard(out: Channel[i32]) -> never {
        \\    let data = Channel::[i32]::new(1);
        \\    select { recv(data) when stop(out, 4) as _ => (), default => (), }
        \\}
        \\fn channel(out: Channel[i32]) -> never {
        \\    select { recv(stop(out, 5)) as _ => (), default => (), }
        \\}
        \\fn while_condition(out: Channel[i32]) -> never {
        \\    while stop(out, 6) {}
        \\}
        \\fn before(out: Channel[i32]) -> Channel[i32] {
        \\    out.send(7);
        \\    Channel::[i32]::new(1)
        \\}
        \\fn later_input(out: Channel[i32]) -> never {
        \\    let data = Channel::[i32]::new(1);
        \\    select priority { recv(before(out)) as _ => (), send(data, stop(out, 8)) => (), default => (), }
        \\}
        \\#[allow(unstructured_go)]
        \\fn launch(work: () -> ()) -> () { go work; }
        \\fn main() -> () {
        \\    let out = Channel::[i32]::new(0);
        \\    launch(|| condition(out));
        \\    println(out.recv().unwrap_or(0));
        \\    launch(|| scrutinee(out));
        \\    println(out.recv().unwrap_or(0));
        \\    launch(|| send_value(out));
        \\    println(out.recv().unwrap_or(0));
        \\    launch(|| guard(out));
        \\    println(out.recv().unwrap_or(0));
        \\    launch(|| channel(out));
        \\    println(out.recv().unwrap_or(0));
        \\    launch(|| while_condition(out));
        \\    println(out.recv().unwrap_or(0));
        \\    launch(|| later_input(out));
        \\    println(out.recv().unwrap_or(0));
        \\    println(out.recv().unwrap_or(0));
        \\}
    ;
    let compilation = compiler_driver::compile_source("control_input_never.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "1\n2\n3\n4\n5\n6\n7\n8\n";
    testing::assert_eq(execute_go(generated, expected, "control_input_never", 0, 0), expected);
}
