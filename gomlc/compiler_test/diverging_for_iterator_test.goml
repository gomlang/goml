package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn diverging_for_iterators_execute_once_before_exiting() -> () {
    let source = "fn first() -> i32 { for _ in ({ println(1); return 7; }) { println(999); } } fn second() -> i32 { 'outer: loop { for _ in ({ println(2); break 'outer 8; }) { println(999); } } } fn main() -> () { println(first()); println(second()); }";
    let compilation = compiler_driver::compile_source("diverging_for_iterator.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "1\n7\n2\n8\n";
    testing::assert_eq(execute_go(generated, expected, "diverging_for_iterator", 0, 0), expected);
}
