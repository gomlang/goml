package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn finite_recursive_trait_requirements_execute_after_budgeted_proof() -> () {
    let source =
        \\trait Mark {}
        \\struct Wrap[T] { value: T }
        \\impl Mark for i32 {}
        \\impl[T: Mark] Mark for Wrap[T] {}
        \\fn accept[T: Mark](value: T) -> i32 { 7 }
        \\fn forward[T: Mark](value: T) -> i32 { accept(value) }
        \\fn main() -> () {
        \\    let value: Wrap[Wrap[i32]] = Wrap { value: Wrap { value: 1 } };
        \\    println(accept(value));
        \\    println(forward(value));
        \\}
    ;
    let compilation = compiler_driver::compile_source("trait_search_budget.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n7\n";
    testing::assert_eq(execute_go(generated, expected, "trait_search_budget", 0, 0), expected);
}
