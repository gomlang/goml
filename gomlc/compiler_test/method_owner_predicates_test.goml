package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn shared_owner_and_method_predicates_execute_with_default_methods() -> () {
    let source =
        \\trait Parent {}
        \\trait Child: Parent {}
        \\impl Parent for i32 {}
        \\impl Child for i32 {}
        \\trait Main[T] { fn run(self) -> i32 where T: Parent; }
        \\struct Box[T] { value: T }
        \\impl[T: Child] Main[T] for Box[T] { fn run(self) -> i32 where T: Parent { 7 } }
        \\trait DefaultMain { fn default_run[T: Child](self) -> i32 { 19 } }
        \\impl DefaultMain for bool {}
        \\fn main() -> () { let value: Box[i32] = Box { value: 1 }; println(value.run()); println(true.default_run::[i32]()); }
    ;
    let compilation = compiler_driver::compile_source("method_owner_predicates.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n19\n";
    testing::assert_eq(execute_go(generated, expected, "method_owner_predicates", 0, 0), expected);
}
