package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn blanket_mutable_or_bindings_remain_assignable() -> () {
    let source = "fn from_option(input: Option[i32]) -> i32 { let mut (Some(mut value) | Some(value)) = input else { return 0; }; value += 1; value } fn main() -> () { let mut (mut value | value) = 1; value = 7; println(value); let mut ((mut left | left), (right | mut right)) = (1, 2); left += right; right = 4; println(left + right); let mut (whole @ _ | mut whole) = 2; whole += 6; println(whole); println(from_option(Some(8))); println(from_option(None)); }";
    let compilation = compiler_driver::compile_source("blanket_pattern_mutability.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n7\n8\n9\n0\n";
    testing::assert_eq(
        execute_go(generated, expected, "blanket_pattern_mutability", 0, 0),
        expected,
    );
}
