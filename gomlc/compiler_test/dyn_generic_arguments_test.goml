package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn dyn_signature_arguments_drive_generic_specialization() -> () {
    let source =
        \\trait Read[T] { fn read(self: Self) -> T; }
        \\trait Item { type Value; fn item(self: Self) -> Self::Value; }
        \\trait Mark { fn mark(self: Self) -> bool; }
        \\impl Read[i32] for bool { fn read(self: bool) -> i32 { 7 } }
        \\impl Item for bool { type Value = i32; fn item(self: bool) -> i32 { 8 } }
        \\impl Mark for bool { fn mark(self: bool) -> bool { self } }
        \\fn identity[T](value: dyn Read[T]) -> dyn Read[T] { value }
        \\fn associated[T](value: dyn Item[Value = T]) -> dyn Item[Value = T] { value }
        \\fn composite[T](value: dyn Mark + Read[T]) -> dyn Read[T] + Mark { value }
        \\fn main() -> () {
        \\    let value: dyn Read[i32] = true as dyn Read[i32];
        \\    println(identity::[i32](value).read());
        \\    println(identity(value).read());
        \\    let callback = identity::[i32];
        \\    println(callback(value).read());
        \\    let item: dyn Item[Value = i32] = true as dyn Item[Value = i32];
        \\    println(associated(item).item());
        \\    let both: dyn Read[i32] + Mark = true as dyn Read[i32] + Mark;
        \\    println(composite(both).read());
        \\    println(composite(both).mark());
        \\}
    ;
    let compilation = compiler_driver::compile_source("dyn_generic_arguments.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n7\n7\n8\n7\ntrue\n";
    testing::assert_eq(execute_go(generated, expected, "dyn_generic_arguments", 0, 0), expected);
}
