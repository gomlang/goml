package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn impl_method_associated_predicates_execute_through_generic_dispatch() -> () {
    let source =
        \\trait Main { type Item; fn run(self) -> i32 where Self::Item = i32; }
        \\impl Main for bool { type Item = i32; fn run(self) -> i32 where Self::Item = i32 { 17 } }
        \\impl Main for string { type Item = i32; fn run(self) -> i32 where i32 = i32 { 23 } }
        \\fn run[T: Main](value: T) -> i32 where T::Item = i32 { value.run() }
        \\trait Parent {}
        \\trait Child: Parent {}
        \\impl Parent for i32 {}
        \\impl Child for i32 {}
        \\trait ExtraMain { fn extra[T: Child](self) -> i32; }
        \\impl ExtraMain for bool { fn extra[T: Child](self) -> i32 { 31 } }
        \\fn main() -> () { println(run(true)); println(run("value")); println(true.extra::[i32]()); }
    ;
    let compilation = compiler_driver::compile_source("impl_method_predicates.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "17\n23\n31\n";
    testing::assert_eq(execute_go(generated, expected, "impl_method_predicates", 0, 0), expected);
}
