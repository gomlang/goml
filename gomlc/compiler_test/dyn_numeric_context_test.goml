package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn dyn_numeric_dispatch_uses_later_type_context() -> () {
    let source = "trait Read { fn read(self) -> i32; } impl Read for i32 { fn read(self) -> i32 { 7 } } impl Read for isize { fn read(self) -> i32 { 9 } } fn need(value: i32) {} fn main() { let value = 1; let object = value as dyn Read; need(value); println(object.read()); let defaulted = 1 as dyn Read; println(defaulted.read()); }";
    let compilation = compiler_driver::compile_source("dyn_numeric_context.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n9\n";
    testing::assert_eq(execute_go(generated, expected, "dyn_numeric_context", 0, 0), expected);
}
