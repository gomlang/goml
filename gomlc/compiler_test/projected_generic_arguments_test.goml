package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn projected_generic_arguments_survive_callable_specialization() -> () {
    let source =
        \\trait Value { type Item; }
        \\impl Value for bool { type Item = i32; }
        \\fn identity[T: Value](value: T::Item) -> T::Item { value }
        \\struct Reader {}
        \\impl Reader { fn read[T: Value](self: Reader, value: T::Item) -> T::Item { value } }
        \\trait Read { fn read[T: Value](self: Self, value: T::Item) -> T::Item; }
        \\impl Read for bool { fn read[T: Value](self: bool, value: T::Item) -> T::Item { value } }
        \\fn main() -> () {
        \\    println(identity::[bool](1));
        \\    let function = identity::[bool];
        \\    println(function(2));
        \\    println(Reader {}.read::[bool](3));
        \\    let method = Reader::read::[bool];
        \\    println(method(Reader {}, 4));
        \\    println(true.read::[bool](5));
        \\    let trait_method = Read::read::[bool];
        \\    println(trait_method(true, 6));
        \\}
    ;
    let compilation = compiler_driver::compile_source("projected_generic_arguments.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "1\n2\n3\n4\n5\n6\n";
    testing::assert_eq(
        execute_go(generated, expected, "projected_generic_arguments", 0, 0),
        expected,
    );
}
