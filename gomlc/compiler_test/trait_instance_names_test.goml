package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn trait_method_instance_references_follow_lowered_nominal_names() -> () {
    let source =
        \\trait Count { fn count[const N: usize](self: Self) -> usize; }
        \\trait Label[A] { fn count[const N: usize](self: Self) -> usize; }
        \\struct Wrap[T] { value: T }
        \\impl[T] Count for Wrap[T] { fn count[const N: usize](self: Wrap[T]) -> usize { N } }
        \\impl Label[Wrap[i32]] for bool { fn count[const N: usize](self: bool) -> usize { N } }
        \\fn main() -> () {
        \\    let value: Wrap[i32] = Wrap { value: 1 };
        \\    println(value.count::[7]());
        \\    println(Count::count::[8](value));
        \\    let count = Count::count::[9];
        \\    println(count(value));
        \\    let label = Label::[Wrap[i32]]::count::[10];
        \\    println(label(true));
        \\}
    ;
    let compilation = compiler_driver::compile_source("trait_instance_names.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n8\n9\n10\n";
    testing::assert_eq(execute_go(generated, expected, "trait_instance_names", 0, 0), expected);
}
