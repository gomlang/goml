package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn nested_dyn_returns_use_bound_associated_types() -> () {
    let source =
        \\trait Other[T] { fn tag(self: Self) -> i32; }
        \\impl Other[i32] for bool { fn tag(self: bool) -> i32 { 7 } }
        \\trait Outer { type Item; fn make(self: Self) -> dyn Other[Self::Item]; }
        \\impl Outer for bool {
        \\    type Item = i32;
        \\    fn make(self: bool) -> dyn Other[i32] { self as dyn Other[i32] }
        \\}
        \\fn main() -> () {
        \\    let value = true as dyn Outer[Item = i32];
        \\    println(value.make().tag());
        \\}
    ;
    let compilation = compiler_driver::compile_source("nested_dyn_safety.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n";
    testing::assert_eq(execute_go(generated, expected, "nested_dyn_safety", 0, 0), expected);
}
