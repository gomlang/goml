package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn closures_execute_inferred_explicit_returns() -> () {
    let source =
        \\fn stop() -> never { loop {} }
        \\fn main() -> () {
        \\    let integer = || { return 7; };
        \\    let integer_result: i32 = integer();
        \\    println(integer_result);
        \\    let floating = || { return 1.5; };
        \\    let floating_result: f64 = floating();
        \\    println(floating_result);
        \\    let identity = |value| { return value; };
        \\    println(identity("hello"));
        \\    let choose = |flag, value| { if flag { return value; } else { return 9; } };
        \\    println(choose(false, 7));
        \\    let outer = |value| { let inner = |item| { return item; }; return inner(value); };
        \\    println(outer(11));
        \\    let divergent = || { let inner = || { return 7; }; stop() };
        \\    let _: () -> () = divergent;
        \\    let divergent_return = || { return stop(); };
        \\    let _: () -> () = divergent_return;
        \\}
    ;
    let compilation = compiler_driver::compile_source("closure_return_inference.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n1.5\nhello\n9\n11\n";
    testing::assert_eq(execute_go(generated, expected, "closure_return_inference", 0, 0), expected);
}
