package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn comptime_trait_instances_execute_the_selected_implementation() -> () {
    let source =
        \\trait Label[T] { fn value(self: Self) -> i32; }
        \\impl Label[i32] for bool { #[comptime] fn value(self: Self) -> i32 { 7 } }
        \\impl Label[bool] for bool { #[comptime] fn value(self: Self) -> i32 { 8 } }
        \\trait Count[const N: usize] { fn count(self: Self) -> i32; }
        \\impl Count[1] for bool { #[comptime] fn count(self: Self) -> i32 { 11 } }
        \\impl Count[2] for bool { #[comptime] fn count(self: Self) -> i32 { 12 } }
        \\fn main() -> () {
        \\    println(Label::[i32]::value(true));
        \\    println(Label::[bool]::value(true));
        \\    println(comptime { Label::[i32]::value(true) });
        \\    println(comptime { Label::[bool]::value(true) });
        \\    println(comptime { Count::[1]::count(true) });
        \\    println(comptime { Count::[2]::count(true) });
        \\}
    ;
    let compilation = compiler_driver::compile_source("comptime_trait_identity.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n8\n7\n8\n11\n12\n";
    testing::assert_eq(execute_go(generated, expected, "comptime_trait_identity", 0, 0), expected);
}
