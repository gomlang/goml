package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn inherent_owner_requirements_select_distinct_runtime_bodies() -> () {
    let source =
        \\trait NumberTag {}
        \\trait BoolTag {}
        \\impl NumberTag for i32 {}
        \\impl BoolTag for bool {}
        \\struct Value[T] { value: T }
        \\impl[T: NumberTag] Value[T] {
        \\    fn read(self: Value[T]) -> i32 { 1 }
        \\    fn create() -> i32 { 3 }
        \\}
        \\impl[T: BoolTag] Value[T] {
        \\    fn read(self: Value[T]) -> i32 { 2 }
        \\    fn create() -> i32 { 4 }
        \\}
        \\fn read_generic[T: NumberTag](value: Value[T]) -> i32 { value.read() }
        \\fn main() -> () {
        \\    let number: i32 = 7;
        \\    println(Value { value: number }.read());
        \\    println(Value { value: true }.read());
        \\    println(Value::[i32]::create());
        \\    let make = Value::[bool]::create;
        \\    println(make());
        \\    println(read_generic(Value { value: number }));
        \\}
    ;
    let compilation = compiler_driver::compile_source(
        "inherent_owner_predicate_selection.goml",
        source,
    );
    let generated = go_backend::encode(compilation.go_value);
    let expected = "1\n2\n3\n4\n1\n";
    testing::assert_eq(
        execute_go(generated, expected, "inherent_owner_predicate_selection", 0, 0),
        expected,
    );
}
