package compiler_test;

use std::testing;

#[test]
fn changed_go_source_invalidates_cached_executable() -> () {
    let old_source =
        \\package main
        \\
        \\import "fmt"
        \\
        \\func main() {
        \\Loop:
        \\    select {
        \\    default:
        \\        fmt.Println("old")
        \\        break Loop
        \\    }
        \\}
        \\
    ;
    let new_source =
        \\package main
        \\
        \\import "fmt"
        \\
        \\func main() {
        \\    fmt.Println("new")
        \\}
        \\
    ;
    testing::assert(execute_go(old_source, "old\n", "cache_invalidation", 0, 0) == "old\n");
    testing::assert(execute_go(new_source, "new\n", "cache_invalidation", 0, 0) == "new\n");
    testing::assert(execute_go(new_source, "new\n", "cache_invalidation", 0, 0) == "new\n")
}

#[test]
fn e2e_fixture_counts_are_stable() -> () {
    assert_e2e_counts()
}

