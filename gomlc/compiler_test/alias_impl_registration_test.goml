package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn alias_impl_targets_execute_using_underlying_receiver_types() -> () {
    let source =
        \\trait Read { fn read(self: Self) -> i32; }
        \\type Flag = bool;
        \\impl Read for Flag { fn read(self: Flag) -> i32 { 7 } }
        \\struct Original { value: i32 }
        \\type Alias = Original;
        \\impl Read for Alias { fn read(self: Alias) -> i32 { self.value } }
        \\impl Alias { fn get(self: Alias) -> i32 { self.value } }
        \\struct Box[T] { value: T }
        \\type Generic[T] = Box[T];
        \\impl[T] Read for Generic[T] { fn read(self: Generic[T]) -> i32 { 11 } }
        \\type Fixed[const N: usize] = [i32; N];
        \\impl[const N: usize] Read for Fixed[N] { fn read(self: Fixed[N]) -> i32 { self[0] } }
        \\#[go_type("time", "Duration")]
        \\extern type Duration;
        \\#[go_ffi("time", "Duration")]
        \\extern fn duration(value: i64) -> Duration;
        \\impl Read for Duration { fn read(self: Duration) -> i32 { 17 } }
        \\fn main() -> () {
        \\    println(Read::read(true));
        \\    let value = Original { value: 9 };
        \\    println(Read::read(value));
        \\    println(value.get());
        \\    println(Read::read(Box { value: "text" }));
        \\    let array: [i32; 2] = [13, 14];
        \\    println(Read::read(array));
        \\    println(Read::read(duration(1)));
        \\}
    ;
    let compilation = compiler_driver::compile_source("alias_impl_registration.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n9\n9\n11\n13\n17\n";
    testing::assert_eq(execute_go(generated, expected, "alias_impl_registration", 0, 0), expected);
}
