package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn associated_projection_impl_arguments_resolve_after_owner_inference() -> () {
    let source = "trait Source { type Item; } impl Source for bool { type Item = i32; } trait Target[A] { type Output; } impl[T: Source] Target[T::Item] for Vec[T] { type Output = string; } fn convert[T: Target[i32]](value: T::Output) -> string where T = Vec[bool] { value } fn main() -> () { println(convert::[Vec[bool]](\"ok\")); }";
    let compilation = compiler_driver::compile_source("projected_impl_arguments.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "ok\n";
    testing::assert_eq(execute_go(generated, expected, "projected_impl_arguments", 0, 0), expected);
}
