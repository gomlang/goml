package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn inferred_index_writes_keep_container_assignment_semantics() -> () {
    let source =
        \\fn main() -> () {
        \\    let set = |xs| { xs[0] = 7; };
        \\    let values = Vec::from_array([1]);
        \\    set(values);
        \\    println(values[0]);
        \\    let add = |xs| { xs[0] += 2; };
        \\    add(values.as_mut_slice());
        \\    println(values[0]);
        \\    let map: HashMap[string, i32] = HashMap::new();
        \\    let put = |xs, key, value| { xs[key] = value; };
        \\    put(map, "key", 10);
        \\    println(map["key"].unwrap_or(0));
        \\    let array = |xs| { let mut copy = xs; copy[0] += 3; copy[0] };
        \\    println(array([8]));
        \\}
    ;
    let compilation = compiler_driver::compile_source("index_write_inference.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n9\n10\n11\n";
    testing::assert_eq(execute_go(generated, expected, "index_write_inference", 0, 0), expected);
}
