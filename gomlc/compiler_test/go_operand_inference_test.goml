package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn inferred_go_callbacks_execute_and_signal_completion() -> () {
    let source = "fn stop[T]() -> T { loop {} } fn main() -> () { go stop; let channel = Channel::[i32]::new(1); let launch = |task| { go task; }; launch(|| channel.send(7)); println(channel.recv().unwrap_or(0)); }";
    let compilation = compiler_driver::compile_source("go_operand_inference.goml", source);
    let expected = "7\n";
    testing::assert_eq(
        execute_go(go_backend::encode(compilation.go_value), expected, "go_operand_inference", 0, 0),
        expected,
    );
}
