package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn boolean_or_patterns_execute_bodies_and_bindings_in_source_order() -> () {
    let source = "const YES: bool = true; const NO: bool = false; fn literal(value: bool) -> i32 { match value { true | false => 7 } } fn wildcard(value: bool) -> i32 { match value { true | _ => 8 } } fn binding(value: bool) -> i32 { match value { x | x => if x { 3 } else { 4 } } } fn ordered(value: bool) -> i32 { match value { true => 1, true | false => 2 } } fn guard() -> bool { println(9); false } fn guarded(value: bool) -> i32 { match value { true | false if guard() => 5, _ => 6 } } fn constant(value: bool) -> i32 { match value { YES | NO => 10 } } fn main() -> () { println(literal(true)); println(literal(false)); println(wildcard(false)); println(binding(true)); println(binding(false)); println(ordered(true)); println(ordered(false)); println(guarded(true)); println(constant(false)); }";
    let compilation = compiler_driver::compile_source("bool_or_patterns.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n7\n8\n3\n4\n1\n2\n9\n6\n10\n";
    testing::assert_eq(execute_go(generated, expected, "bool_or_patterns", 0, 0), expected);
}
