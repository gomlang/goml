package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn inferred_directional_select_channels_execute() -> () {
    let source = "fn main() -> () { let channel = Channel::[i32]::new(1); let send = |input| select { send(input, 7) => true, default => false }; let receive = |input| select { recv(input) as value => value.unwrap_or(0), default => 0 }; println(send(channel.sender())); println(receive(channel.receiver())); println(receive(channel.receiver())); }";
    let compilation = compiler_driver::compile_source("channel_inference.goml", source);
    let expected = "true\n7\n0\n";
    testing::assert_eq(
        execute_go(go_backend::encode(compilation.go_value), expected, "channel_inference", 0, 0),
        expected,
    );
}
