package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn static_trait_members_do_not_compete_with_receiver_calls() -> () {
    let source =
        \\type Int = i32;
        \\trait Static { fn count(value: i32) -> i32; }
        \\trait Instance { fn count(self: Self) -> i32; }
        \\impl Static for i32 { fn count(value: i32) -> i32 { value + 1 } }
        \\impl Instance for i32 { fn count(self: Self) -> i32 { self + 2 } }
        \\fn bounded[T: Static + Instance](value: T) -> i32 { value.count() }
        \\fn make() -> impl Static + Instance { let value: i32 = 7; value }
        \\fn static_count[T: Static](value: i32) -> i32 { T::count(value) }
        \\struct Value { number: i32 }
        \\impl Value { fn read(value: Self) -> i32 { value.number + 1 } }
        \\trait Read { fn read(self: Self) -> i32; }
        \\impl Read for Value { fn read(self: Self) -> i32 { self.number + 2 } }
        \\fn main() -> () {
        \\    println(7.count());
        \\    let run = |value| value.count(); println(run(8));
        \\    println(bounded::[i32](9)); println(make().count());
        \\    let value = 10 as dyn Instance; println(value.count());
        \\    println(static_count::[i32](11));
        \\    println(Value { number: 11 }.read());
        \\    let static_read = Value::read; println(static_read(Value { number: 12 }));
        \\}
    ;
    let compilation = compiler_driver::compile_source("method_receiver_kind.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "9\n10\n11\n9\n12\n12\n13\n13\n";
    testing::assert_eq(execute_go(generated, expected, "method_receiver_kind", 0, 0), expected);
}
