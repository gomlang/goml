package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn pure_generic_associated_constant_comparisons_execute() -> () {
    let source =
        \\trait Source: PartialEq { const VALUE: Self; }
        \\impl Source for i32 { const VALUE: Self = 7; }
        \\struct Holder[T] {}
        \\impl[T: Source] Holder[T] { const SAME: bool = T::VALUE == T::VALUE; }
        \\fn forwarded[T: Source]() -> bool { Holder::[T]::SAME }
        \\trait DefaultSource: PartialEq { const VALUE: Self; const SAME: bool = Self::VALUE == Self::VALUE; }
        \\impl DefaultSource for bool { const VALUE: Self = true; }
        \\struct Concrete {}
        \\impl Concrete { const ARRAY: bool = [1, 2] == [1, 2]; const TUPLE: bool = (1, true) == (1, true); }
        \\fn main() -> () {
        \\    println(Holder::[i32]::SAME);
        \\    let read = forwarded::[i32]; println(read());
        \\    println(Concrete::ARRAY); println(Concrete::TUPLE);
        \\}
    ;
    let compilation = compiler_driver::compile_source("constant_initializer.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "true\ntrue\ntrue\ntrue\n";
    testing::assert_eq(execute_go(generated, expected, "constant_initializer", 0, 0), expected);
}
