package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn opaque_blanket_methods_preserve_static_dispatch() -> () {
    let source = "trait Read { fn read(self) -> i32; } impl Read for bool { fn read(self) -> i32 { 7 } } trait Extra { fn extra(self) -> i32; } impl[T: Read] Extra for T { fn extra(self) -> i32 { self.read() } } fn make() -> impl Read { true } fn main() -> () { let value = make(); println(value.extra()); let dynamic = value as dyn Extra; println(dynamic.extra()); let read = true as dyn Read; println(read.extra()); }";
    let compilation = compiler_driver::compile_source("opaque_blanket_methods.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n7\n7\n";
    testing::assert_eq(execute_go(generated, expected, "opaque_blanket_methods", 0, 0), expected);
}
