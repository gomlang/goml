package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn self_constructors_execute_with_generic_payloads() -> () {
    let source =
        \\enum Value[T] { Item { value: T } }
        \\impl[T] Value[T] {
        \\    fn new(value: T) -> Self { Self::Item { value } }
        \\    fn get(self: Self) -> T { match self { Self::Item { value } => value } }
        \\}
        \\struct Holder[T] { value: T }
        \\impl[T] Holder[T] {
        \\    fn new(value: T) -> Self { Self { value } }
        \\    fn get(self: Self) -> T { let Self { value } = self; value }
        \\}
        \\fn main() -> () {
        \\    println(Value::new(42).get());
        \\    println(Holder::new(true).get());
        \\}
    ;
    let compilation = compiler_driver::compile_source("self_constructors.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "42\ntrue\n";
    testing::assert_eq(execute_go(generated, expected, "self_constructors", 0, 0), expected);
}
