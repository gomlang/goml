package compiler_test;

#[test]
fn parser_diagnostic_snapshots_match() -> () {
    assert_diagnostic_suite("diagnostics", 4)
}

#[test]
fn typer_diagnostic_snapshots_match() -> () {
    assert_diagnostic_suite("typer", 106)
}

#[test]
fn covers_at_least_one_hundred_distinct_type_errors() -> () {
    assert_distinct_type_diagnostic_count(100)
}
