package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn projected_assignments_preserve_writes_and_single_evaluation() -> () {
    let source =
        \\struct Point { x: i32 }
        \\fn main() -> () {
        \\    let point = Point { x: 1 };
        \\    point.x += 1;
        \\    println(point.x);
        \\    let mut array = [(3, 4)];
        \\    array[0].0 += 2;
        \\    println(array[0].0);
        \\    let shared = Ref::new([(6, 0)]);
        \\    shared.get()[0].0 += 1;
        \\    println(shared.get()[0].0);
        \\    let values = Vec::from_array([Point { x: 8 }]);
        \\    let set = |values| { values[0].x += 1; };
        \\    set(values.as_mut_slice());
        \\    println(values[0].x);
        \\    let roots = Vec::from_array([Ref::new(Point { x: 10 })]);
        \\    roots.as_slice()[0].get().x += 1;
        \\    println(roots[0].get().x);
        \\    let counts = Ref::new(0);
        \\    let locate = || { counts.set(counts.get() + 1); values };
        \\    locate()[0].x += 4;
        \\    println(values[0].x);
        \\    println(counts.get());
        \\}
    ;
    let compilation = compiler_driver::compile_source("projected_assignment_location.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "2\n5\n7\n9\n11\n13\n1\n";
    testing::assert_eq(
        execute_go(generated, expected, "projected_assignment_location", 0, 0),
        expected,
    );
}
