package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn inferred_integer_and_unary_operators_execute_with_call_site_types() -> () {
    let source = "fn main() -> () { let shift = |left, right| left << right; let value: u8 = 3; let count: usize = 2; println(shift(value, count)); let mask = |left, right| left & right; println(mask(7, 3)); let complement = |value| ~value; let input: i32 = 7; println(complement(input)); let negate = |value| -value; println(negate(1.5)); let remainder = |left, right| left % right; println(remainder(7, 3)); }";
    let compilation = compiler_driver::compile_source("operator_operand_inference.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "12\n3\n-8\n-1.5\n1\n";
    testing::assert_eq(
        execute_go(generated, expected, "operator_operand_inference", 0, 0),
        expected,
    );
}
