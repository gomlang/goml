package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn inferred_comparison_operands_select_builtin_and_trait_dispatch() -> () {
    let source =
        \\use std::cmp::{PartialOrd};
        \\struct Key { value: i32 }
        \\impl PartialEq for Key {
        \\    fn eq(self: Key, other: Key) -> bool { self.value == other.value }
        \\}
        \\impl PartialOrd for Key {
        \\    fn partial_cmp(self: Key, other: Key) -> Option[Ordering] {
        \\        Some(if self.value < other.value { Less } else if self.value > other.value { Greater } else { Equal })
        \\    }
        \\}
        \\fn main() -> () {
        \\    let equal = |left, right| left == right;
        \\    println(equal(true, false));
        \\    let less = |left, right| left < right;
        \\    println(less(1, 2));
        \\    let text = |left, right| left >= right;
        \\    println(text("b", "a"));
        \\    let keys_equal = |left, right| left == right;
        \\    println(keys_equal(Key { value: 3 }, Key { value: 3 }));
        \\    let keys_less = |left, right| left < right;
        \\    println(keys_less(Key { value: 2 }, Key { value: 1 }));
        \\    let keys_greater = |left, right| left > right;
        \\    println(keys_greater(Key { value: 2 }, Key { value: 1 }));
        \\}
    ;
    let compilation = compiler_driver::compile_source("comparison_operand_inference.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "false\ntrue\ntrue\ntrue\nfalse\ntrue\n";
    testing::assert_eq(
        execute_go(generated, expected, "comparison_operand_inference", 0, 0),
        expected,
    );
}
