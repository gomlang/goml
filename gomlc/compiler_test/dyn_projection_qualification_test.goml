package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn nested_dyn_projections_keep_the_declaring_trait_bound() -> () {
    let source =
        \\trait Marker {}
        \\impl Marker for bool {}
        \\trait Read[T] { fn read(self: Self) -> T; }
        \\impl Read[i32] for bool { fn read(self: bool) -> i32 { 7 } }
        \\trait Source { type Value; fn get(self: Self) -> Self::Value; }
        \\impl Source for bool { type Value = i32; fn get(self: bool) -> i32 { 11 } }
        \\trait Parent { type Item; }
        \\trait Child: Parent {
        \\    type Item: ToString;
        \\    fn argument(self: Self) -> dyn Read[Self::Item];
        \\    fn binding(self: Self) -> dyn Source[Value = Self::Item];
        \\    fn additional(self: Self) -> dyn Marker + Read[Self::Item];
        \\}
        \\impl Parent for bool { type Item = () -> i32; }
        \\impl Child for bool {
        \\    type Item = i32;
        \\    fn argument(self: bool) -> dyn Read[i32] { true as dyn Read[i32] }
        \\    fn binding(self: bool) -> dyn Source[Value = i32] { true as dyn Source[Value = i32] }
        \\    fn additional(self: bool) -> dyn Marker + Read[i32] { true as dyn Marker + Read[i32] }
        \\}
        \\fn display[T: Child](value: T) -> () {
        \\    println(value.argument().read().to_string());
        \\    println(value.binding().get().to_string());
        \\    println(value.additional().read().to_string());
        \\}
        \\fn main() -> () { display(true); }
    ;
    let compilation = compiler_driver::compile_source("dyn_projection_qualification.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n11\n7\n";
    testing::assert_eq(
        execute_go(generated, expected, "dyn_projection_qualification", 0, 0),
        expected,
    );
}
