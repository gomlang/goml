package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn normalized_trait_method_candidates_execute_once() -> () {
    let source =
        \\trait Read { fn read(self: Self) -> isize; }
        \\impl Read for isize { fn read(self: isize) -> isize { self } }
        \\trait Echo[A] { fn echo(self: Self, value: A) -> A; }
        \\impl Echo[isize] for bool { fn echo(self: bool, value: isize) -> isize { value } }
        \\fn owner_equal[T: Read, U: Read](left: T, right: U) -> isize where T = U { left.read() }
        \\fn owner_value[T: Read, U: Read](left: T, right: U) -> isize where T = U { let f = T::read; f(left) }
        \\fn arguments_equal[A, B, T: Echo[A] + Echo[B]](owner: T, value: A) -> A where A = B { owner.echo(value) }
        \\fn main() -> () {
        \\    println(owner_equal(7, 0));
        \\    println(owner_value(8, 0));
        \\    println(arguments_equal(true, 9));
        \\}
    ;
    let compilation = compiler_driver::compile_source("normalized_method_candidates.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n8\n9\n";
    testing::assert_eq(
        execute_go(generated, expected, "normalized_method_candidates", 0, 0),
        expected,
    );
}
