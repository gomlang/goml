package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn inferred_try_operands_execute_with_enclosing_error_types() -> () {
    let source = "fn result() -> Result[isize, string] { let value = Ok(7)?; Ok(value) } fn option() -> Option[isize] { let value = Some(9)?; Some(value) } fn failure() -> Result[isize, string] { let value: isize = Err(\"failed\")?; Ok(value) } fn main() -> () { match result() { Ok(value) => println(value), Err(error) => println(error) } match option() { Some(value) => println(value), None => println(0) } match failure() { Ok(value) => println(value), Err(error) => println(error) } }";
    let compilation = compiler_driver::compile_source("try_context_inference.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n9\nfailed\n";
    testing::assert_eq(execute_go(generated, expected, "try_context_inference", 0, 0), expected);
}
