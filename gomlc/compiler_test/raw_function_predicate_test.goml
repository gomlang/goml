package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn compatible_generic_body_raw_functions_execute() -> () {
    let source = "fn create[T]() -> bool { let callback: Option[GoFunc[(T) -> T]] = None; callback.is_none() } fn returns[T]() -> bool { let callback: Option[GoFunc[() -> T]] = None; callback.is_none() } fn forward[T]() -> bool { create::[T]() } fn main() -> () { let call = forward::[i32]; println(call()); println(returns::[()]()); println(returns::[(i32, bool)]()); }";
    let compilation = compiler_driver::compile_source("raw_function_predicate.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "true\ntrue\ntrue\n";
    testing::assert_eq(execute_go(generated, expected, "raw_function_predicate", 0, 0), expected);
}
