package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn blanket_associated_types_specialize_through_generic_receivers() -> () {
    let source = "trait Marker {} impl Marker for bool {} trait Source[A] { type Item; } impl[T: Marker, A] Source[A] for T { type Item = A; } fn convert[T: Source[A] + Marker, A](value: T::Item) -> A { value } fn main() -> () { println(convert::[bool, i32](7)); println(convert::[bool, string](\"ok\")); }";
    let compilation = compiler_driver::compile_source(
        "blanket_projection_normalization.goml",
        source,
    );
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\nok\n";
    testing::assert_eq(
        execute_go(generated, expected, "blanket_projection_normalization", 0, 0),
        expected,
    );
}
