package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn inferred_empty_matches_lower_in_function_values() -> () {
    let source =
        \\enum Empty {}
        \\struct Container { value: Empty }
        \\fn impossible(value: Empty) -> i32 { let result = match value {}; }
        \\fn impossible_tuple(value: (Empty, i32)) -> i32 { let result = match value {}; }
        \\fn impossible_struct(value: Container) -> i32 { let result = match value {}; }
        \\fn keep_empty(callback: (Empty) -> i32) -> i32 { 7 }
        \\fn keep_tuple(callback: ((Empty, i32)) -> i32) -> i32 { 8 }
        \\fn keep_struct(callback: (Container) -> i32) -> i32 { 9 }
        \\fn main() -> () {
        \\    println(keep_empty(impossible));
        \\    println(keep_tuple(impossible_tuple));
        \\    println(keep_struct(impossible_struct));
        \\}
    ;
    let compilation = compiler_driver::compile_source("empty_match_never.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n8\n9\n";
    testing::assert_eq(execute_go(generated, expected, "empty_match_never", 0, 0), expected);
}
