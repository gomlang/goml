package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn symbolic_array_patterns_execute_empty_and_nonempty_instances() -> () {
    let source =
        \\fn identity[T, const N: usize](values: [T; N]) -> [T; N] {
        \\    let [rest @ ..] = values;
        \\    rest
        \\}
        \\fn sum[const N: usize](values: [i32; N]) -> i32 {
        \\    match values {
        \\        [first, middle @ .., last] => {
        \\            let mut result = first + last;
        \\            for item in middle { result += item; }
        \\            result
        \\        },
        \\        [only] => only,
        \\        [] => 0,
        \\    }
        \\}
        \\fn last[const N: usize](values: [i32; N]) -> i32 {
        \\    match values { [.., value] => value, [] => -1 }
        \\}
        \\fn main() -> () {
        \\    let empty: [i32; 0] = [];
        \\    println(sum(identity(empty)));
        \\    println(sum(identity([7])));
        \\    println(sum(identity([10, 20])));
        \\    println(sum(identity([10, 20, 30, 40])));
        \\    println(last(empty));
        \\    println(last([3, 5, 8]));
        \\}
    ;
    let compilation = compiler_driver::compile_source("symbolic_array_patterns.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "0\n7\n30\n100\n-1\n8\n";
    testing::assert_eq(execute_go(generated, expected, "symbolic_array_patterns", 0, 0), expected);
}
