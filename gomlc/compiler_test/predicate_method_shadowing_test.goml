package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn constrained_child_method_dispatch_preserves_explicit_parent_calls() -> () {
    let source =
        \\trait Parent { fn read(self) -> i32; }
        \\trait Child: Parent { fn read(self) -> i32; }
        \\impl Parent for bool { fn read(self) -> i32 { 11 } }
        \\impl Child for bool { fn read(self) -> i32 { 29 } }
        \\fn direct[T: Child](value: T) -> i32 { value.read() }
        \\fn method_value[T: Child](value: T) -> i32 { let read = T::read; read(value) }
        \\fn parent[T: Child](value: T) -> i32 { Parent::read(value) }
        \\trait Left: Parent { fn read(self) -> i32; }
        \\trait Right: Parent {}
        \\trait Top: Left + Right {}
        \\impl Left for bool { fn read(self) -> i32 { 37 } }
        \\impl Right for bool {}
        \\impl Top for bool {}
        \\fn diamond[T: Top](value: T) -> i32 { value.read() }
        \\fn inherited[T: Top](value: T) -> i32 { Top::read(value) }
        \\fn main() -> () {
        \\    println(direct(true));
        \\    println(method_value(true));
        \\    println(parent(true));
        \\    println(diamond(true));
        \\    println(inherited(true));
        \\}
    ;
    let compilation = compiler_driver::compile_source("predicate_method_shadowing.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "29\n29\n11\n37\n37\n";
    testing::assert_eq(
        execute_go(generated, expected, "predicate_method_shadowing", 0, 0),
        expected,
    );
}
