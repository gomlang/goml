package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn unit_constants_execute_inside_composite_values() -> () {
    let source = "const UNIT: () = (); const PAIR: ((), i32) = (UNIT, 42); const VALUES: [(); 2] = [UNIT, ()]; struct Wrap { value: () } const WRAPPED: Wrap = Wrap { value: UNIT }; fn main() -> () { let _: () = UNIT; let _: () = VALUES[0]; let _: () = WRAPPED.value; println(PAIR.1); }";
    let compilation = compiler_driver::compile_source("unit_constant.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "42\n";
    testing::assert_eq(execute_go(generated, expected, "unit_constant", 0, 0), expected);
}
