package compiler_test;

#[test]
fn crasher_fixture_counts_are_stable() -> () {
    assert_crasher_counts()
}

#[test]
fn crasher_diagnostics_shard_0() -> () {
    assert_crasher_diagnostic_shard(0, 2)
}

#[test]
fn crasher_diagnostics_shard_1() -> () {
    assert_crasher_diagnostic_shard(1, 2)
}

#[test]
fn crasher_runtime_shard_0() -> () {
    assert_crasher_runtime_shard(0, 8)
}

#[test]
fn crasher_runtime_shard_1() -> () {
    assert_crasher_runtime_shard(1, 8)
}

#[test]
fn crasher_runtime_shard_2() -> () {
    assert_crasher_runtime_shard(2, 8)
}

#[test]
fn crasher_runtime_shard_3() -> () {
    assert_crasher_runtime_shard(3, 8)
}

#[test]
fn crasher_runtime_shard_4() -> () {
    assert_crasher_runtime_shard(4, 8)
}

#[test]
fn crasher_runtime_shard_5() -> () {
    assert_crasher_runtime_shard(5, 8)
}

#[test]
fn crasher_runtime_shard_6() -> () {
    assert_crasher_runtime_shard(6, 8)
}

#[test]
fn crasher_runtime_shard_7() -> () {
    assert_crasher_runtime_shard(7, 8)
}

#[test]
fn package_crasher_rejects_local_host_extern() -> () {
    assert_package_crasher()
}
