package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn comptime_finite_nested_nominal_types_execute() -> () {
    let source =
        \\struct Wrap[T] { value: T }
        \\struct Pair[T] { left: Wrap[T], right: Wrap[T] }
        \\enum RuntimeList { End, Link(Ref[RuntimeList]) }
        \\fn main() -> () {
        \\    println(comptime { let value: Wrap[Wrap[i32]] = Wrap { value: Wrap { value: 7 } }; value.value.value });
        \\    println(comptime { let value: Pair[i32] = Pair { left: Wrap { value: 3 }, right: Wrap { value: 5 } }; value.left.value + value.right.value });
        \\    let value = RuntimeList::End;
        \\    println(match value { End => 9, Link(_) => 10 });
        \\}
    ;
    let compilation = compiler_driver::compile_source("comptime_type_expansion.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n8\n9\n";
    testing::assert_eq(execute_go(generated, expected, "comptime_type_expansion", 0, 0), expected);
}
