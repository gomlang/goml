package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn valid_instantiated_trait_constant_constraints_execute() -> () {
    let source =
        \\trait Fixed[const N: usize] {}
        \\trait Outer[const N: usize] {}
        \\impl[const N: usize] Fixed[N] for bool {}
        \\impl[const N: usize] Outer[N] for bool where bool: Fixed[{N - 1}] {}
        \\fn value[const N: usize]() -> i32 where bool: Fixed[{N - 1}] { 7 }
        \\fn nested[const N: usize]() -> i32 where bool: Outer[N] { 11 }
        \\struct Reader {}
        \\impl Reader { fn value[const N: usize](self: Reader) -> i32 where bool: Fixed[{N - 1}] { 9 } }
        \\fn main() -> () { println(value::[2]()); let callback = value::[2]; println(callback()); println(Reader {}.value::[2]()); println(nested::[2]()); }
    ;
    let compilation = compiler_driver::compile_source("predicate_const_validation.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n7\n9\n11\n";
    testing::assert_eq(
        execute_go(generated, expected, "predicate_const_validation", 0, 0),
        expected,
    );
}
