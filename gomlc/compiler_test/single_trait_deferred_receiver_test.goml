package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn single_trait_candidates_preserve_inherent_and_field_dispatch() -> () {
    let source =
        \\trait Read { fn read(self: Self) -> i32; }
        \\struct A {}
        \\impl Read for A { fn read(self: A) -> i32 { 1 } }
        \\struct B {}
        \\impl B { fn read(self: B) -> bool { true } }
        \\struct C { read: () -> string }
        \\fn main() -> () {
        \\    let first = |x| x.read(); println(first(A {}));
        \\    let second = |x| x.read(); println(second(B {}));
        \\    let third = |x| x.read(); println(third(C { read: || "ok" }));
        \\}
    ;
    let compilation = compiler_driver::compile_source("single_trait_deferred_receiver.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "1\ntrue\nok\n";
    testing::assert_eq(
        execute_go(generated, expected, "single_trait_deferred_receiver", 0, 0),
        expected,
    );
}
