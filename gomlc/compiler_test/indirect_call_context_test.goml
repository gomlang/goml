package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn indirect_calls_use_return_context_for_enum_arguments() -> () {
    let source =
        \\fn identity[T](value: T) -> T { value }
        \\fn maker[T]() -> (T) -> T { identity }
        \\struct Factory {}
        \\impl Factory { fn identity[T](value: T) -> T { value } }
        \\enum Wrapped[T] { Item(T) }
        \\struct Handler[T] { call: (T) -> T }
        \\struct Service {}
        \\impl Service { fn identity[T](self: Service, value: T) -> T { value } }
        \\trait Number { fn choose(self: Self, value: Option[i32]) -> i32; }
        \\trait Flag { fn choose(self: Self, value: Option[bool]) -> bool; }
        \\impl Number for Service { fn choose(self: Service, value: Option[i32]) -> i32 { value.unwrap_or(0) } }
        \\impl Flag for Service { fn choose(self: Service, value: Option[bool]) -> bool { value.unwrap_or(false) } }
        \\fn main() -> () {
        \\    let first: Option[i32] = maker()(Some(7)); println(first.unwrap_or(0));
        \\    let function = Factory::identity;
        \\    let second: Option[i32] = function(Some(8)); println(second.unwrap_or(0));
        \\    let wrap = Wrapped::Item;
        \\    let third: Wrapped[Option[i32]] = wrap(Some(9));
        \\    match third { Wrapped::Item(value) => println(value.unwrap_or(0)) }
        \\    let handler = Handler { call: identity };
        \\    let fourth: Option[i32] = handler.call(Some(10)); println(fourth.unwrap_or(0));
        \\    let fifth: Option[i32] = Service {}.identity(Some(11)); println(fifth.unwrap_or(0));
        \\    let sixth: i32 = Service {}.choose(Some(12)); println(sixth);
        \\    let seventh: bool = Service {}.choose(Some(true)); println(seventh);
        \\}
    ;
    let compilation = compiler_driver::compile_source("indirect_call_context.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n8\n9\n10\n11\n12\ntrue\n";
    testing::assert_eq(execute_go(generated, expected, "indirect_call_context", 0, 0), expected);
}
