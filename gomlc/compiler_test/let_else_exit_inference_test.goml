package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn inferred_let_else_callbacks_preserve_success_bindings_and_evaluation() -> () {
    let source = "fn stop() -> never { loop {} } struct Stop {} impl Stop { fn stop(self: Stop) -> never { loop {} } } fn main() -> () { let count = Ref::new(0); let run = |stop| { let Some(value) = { count.set(count.get() + 1); Option::Some(7) } else { stop(); }; println(value); }; run(stop); let method = |receiver| { let Some(value) = Option::Some(8) else { receiver.stop() }; println(value); }; method(Stop {}); println(count.get()); }";
    let compilation = compiler_driver::compile_source("let_else_exit_inference.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n8\n1\n";
    testing::assert_eq(execute_go(generated, expected, "let_else_exit_inference", 0, 0), expected);
}
