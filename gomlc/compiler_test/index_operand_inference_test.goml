package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn inferred_indexing_uses_selected_container_semantics() -> () {
    let source =
        \\struct Item { value: i32 }
        \\fn main() -> () {
        \\    let first = |xs| xs[0];
        \\    println(first(Vec::from_array([7])));
        \\    let array = |xs| xs[0];
        \\    println(array([8]));
        \\    let field = |xs| xs[0].value;
        \\    println(field(Vec::from_array([Item { value: 9 }])));
        \\    let at = |xs, key| xs[key];
        \\    let values: HashMap[string, i32] = HashMap::new();
        \\    values.set("key", 10);
        \\    println(at(values, "key").unwrap_or(0));
        \\}
    ;
    let compilation = compiler_driver::compile_source("index_operand_inference.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n8\n9\n10\n";
    testing::assert_eq(execute_go(generated, expected, "index_operand_inference", 0, 0), expected);
}
