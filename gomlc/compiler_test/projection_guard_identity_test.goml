package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn nested_qualified_associated_projections_keep_separate_recursion_guards() -> () {
    let source = "trait Source[A] { type Item; } impl Source[i32] for bool { type Item = i32; } impl[T: Source[i32]] Source[string] for T where T::Item = i32 { type Item = bool; } impl[T: Source[string]] Source[bool] for T where T::Item = bool { type Item = string; } fn convert[T: Source[bool]](value: T::Item) -> string where T = bool { value } fn main() -> () { println(convert::[bool](\"ok\")); }";
    let compilation = compiler_driver::compile_source("projection_guard_identity.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "ok\n";
    testing::assert_eq(execute_go(generated, expected, "projection_guard_identity", 0, 0), expected);
}
