package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn recursive_associated_bounds_execute_deep_projected_methods() -> () {
    let source = "trait Node { type Next: Node; fn read(self: Self) -> isize; } impl Node for isize { type Next = isize; fn read(self: isize) -> isize { self } } fn read[T: Node](value: T::Next::Next::Next) -> isize { value.read() } fn require[T: Node](value: T) -> isize { value.read() } fn forward[T: Node](value: T::Next::Next::Next) -> isize { require(value) } fn main() -> () { println(read::[isize](7)); println(forward::[isize](8)); }";
    let compilation = compiler_driver::compile_source("recursive_associated_bounds.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n8\n";
    testing::assert_eq(
        execute_go(generated, expected, "recursive_associated_bounds", 0, 0),
        expected,
    );
}
