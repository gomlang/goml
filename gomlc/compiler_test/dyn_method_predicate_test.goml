package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn dyn_dispatch_executes_satisfied_method_predicates() -> () {
    let source = "trait Extra { fn extra(self) -> i32; } trait Main { fn run(self) -> i32 where Self: Extra; } impl Extra for bool { fn extra(self) -> i32 { 7 } } impl Main for bool { fn run(self) -> i32 where Self: Extra { self.extra() } } fn convert[T: Main + Extra](value: T) -> dyn Main + Extra { value as dyn Main + Extra } fn main() -> () { let value = convert(true); println(value.run()); println(value.extra()); }";
    let compilation = compiler_driver::compile_source("dyn_method_predicates.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n7\n";
    testing::assert_eq(execute_go(generated, expected, "dyn_method_predicates", 0, 0), expected);
}
