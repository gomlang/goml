package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn equivalent_float_patterns_execute_without_duplicate_switch_cases() -> () {
    let source =
        \\fn positive_first(value: f64) -> i32 { match value { 0.0 => 1, -0.0 => 2, _ => 3 } }
        \\fn negative_first(value: f32) -> i32 { match value { -0.0 => 4, 0.0 => 5, _ => 6 } }
        \\fn alternatives(value: f64) -> i32 { match value { -0.0 | 0.0 => 7, _ => 8 } }
        \\fn guarded(value: f64, flag: bool) -> i32 { match value { 0.0 if flag => 9, -0.0 => 10, _ => 11 } }
        \\fn rounded(value: f32) -> i32 { match value { 16777217 => 12, 16777216.0 => 13, _ => 14 } }
        \\fn main() -> () {
        \\    println(positive_first(0.0));
        \\    println(positive_first(-0.0));
        \\    println(negative_first(0.0));
        \\    println(negative_first(-0.0));
        \\    println(alternatives(0.0));
        \\    println(guarded(0.0, true));
        \\    println(guarded(0.0, false));
        \\    println(rounded(16777216.0));
        \\    let deferred = |value| match value { -0.0 => 15, 0.0 => 16, _ => 17 };
        \\    let value: f32 = 0.0;
        \\    println(deferred(value));
        \\}
    ;
    let compilation = compiler_driver::compile_source("float_pattern_identity.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "1\n1\n4\n4\n7\n9\n10\n12\n15\n";
    testing::assert_eq(execute_go(generated, expected, "float_pattern_identity", 0, 0), expected);
}
