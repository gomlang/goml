package compiler_test;

use module::cmd::gomlc as compiler_driver;
use module::go_backend;
use module::simd;
use std::fs;
use std::path;
use std::testing;

fn simd_fixture_kernels(source: string) -> Vec[string] {
    let directory = path::file_name(path::parent(source).unwrap_or("")).unwrap_or("");
    match directory {
        "001_float_kernels" => Vec::from_array(["sse_kernel", "avx_kernel", "masks"]),
        "002_integer_kernels" => Vec::from_array(
            ["bytes_sse", "words_avx", "dwords_sse", "qwords_sse", "qwords_avx"],
        ),
        "003_rearrange_convert" => Vec::from_array(
            [
                "bytes_reverse",
                "floats_permute",
                "words_widen",
                "numbers_convert",
                "double_convert",
                "double_bits",
            ],
        ),
        "004_float_math" => Vec::from_array(
            ["double_sse", "double_select", "rounding", "fma_sse", "fma_avx"],
        ),
        _ => Vec::new(),
    }
}

#[test]
fn simd_assembly_snapshots_match() -> () {
    let directory = path::join(compiler_tests_root(), "simd");
    let sources: Vec[string] = Vec::new();
    for name in read_directory(directory) {
        let source = path::join(path::join(directory, name), "main.goml");
        if fs::is_file(source) {
            sources.push(source)
        }
    }
    testing::assert(!sources.is_empty());
    let contents: Vec[string] = Vec::new();
    for source in sources {
        contents.push(read_file(source))
    }
    let compiler = compiler_driver::source_compiler_for_sources(contents);
    for index in 0..sources.len() {
        let source = sources[index];
        let compilation = compiler_driver::compile_source_with(compiler, source, contents[index]);
        let native = testing::expect_some(
            testing::expect_ok(
                simd::native_source(go_backend::encode(compilation.go_value)),
                "valid native SIMD metadata",
            ),
            "fixture produces native assembly",
        );
        testing::assert(native.assembly != "");
        let kernels = simd_fixture_kernels(source);
        testing::assert(!kernels.is_empty());
        for kernel in kernels {
            let mut found = false;
            for prefix in["", "_goml_simd_avx2_", "_goml_simd_fma_", "_goml_simd_avx2_fma_"] {
                found = found || native.assembly.contains(f"TEXT ·{prefix}{kernel}(SB),");
            }
            if !found {
                testing::fail("missing SIMD kernel " + kernel + " in " + source);
            }
        }
        assert_text(native.assembly, source + ".s", source)
    }
}
