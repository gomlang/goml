package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn references_to_arrays_and_tuples_do_not_synthesize_pointee_traits() -> () {
    let source = "struct Point { x: i32 } fn main() -> () { let first = Ref::new([Point { x: 1 }]); let same = first; let other = Ref::new([Point { x: 1 }]); println(first == same); println(first == other); let tuple = Ref::new((Point { x: 2 },)); println(tuple == tuple); let values: HashMap[Ref[[Point; 1]], i32] = HashMap::new(); values.insert(first, 7); println(values.get(first).unwrap_or(0)); println(values.get(other).unwrap_or(0)); }";
    let compilation = compiler_driver::compile_source("ref_structural_identity.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "true\nfalse\ntrue\n7\n0\n";
    testing::assert_eq(execute_go(generated, expected, "ref_structural_identity", 0, 0), expected);
}
