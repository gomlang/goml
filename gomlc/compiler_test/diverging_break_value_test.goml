package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn diverging_break_values_preserve_returns_and_loop_targets() -> () {
    let source = "fn first() -> i32 { loop { break return 7; }; } fn second() -> i32 { 'outer: loop { loop { break 'outer return 8; } }; } fn third() -> i32 { loop { break { break 9; }; } } fn main() -> () { println(first()); println(second()); println(third()); }";
    let compilation = compiler_driver::compile_source("diverging_break_value.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n8\n9\n";
    testing::assert_eq(execute_go(generated, expected, "diverging_break_value", 0, 0), expected);
}
