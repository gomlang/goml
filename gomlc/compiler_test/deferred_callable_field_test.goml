package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn inferred_callable_fields_preserve_receiver_and_method_precedence() -> () {
    let source =
        \\struct Handler { run: (i32) -> i32 }
        \\struct Preferred { run: (i32) -> i32 }
        \\impl Preferred { fn run(self: Preferred, value: i32) -> i32 { value + 1 } }
        \\fn main() -> () {
        \\    let apply = |handler| handler.run(7);
        \\    println(apply(Handler { run: |x| x }));
        \\    let prefer = |handler| handler.run(7);
        \\    println(prefer(Preferred { run: |x| x }));
        \\    let count = Ref::new(0);
        \\    let nested = |handler| { let receiver = || { count.set(count.get() + 1); handler }; receiver().run(9) };
        \\    println(nested(Handler { run: |x| x }));
        \\    println(count.get());
        \\}
    ;
    let compilation = compiler_driver::compile_source("deferred_callable_field.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n8\n9\n1\n";
    testing::assert_eq(execute_go(generated, expected, "deferred_callable_field", 0, 0), expected);
}
