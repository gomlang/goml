package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn interpolation_preserves_trait_dispatch_and_evaluation_order() -> () {
    let source =
        \\struct Item {}
        \\impl Item { fn to_string(self: Item) -> i32 { 99 } }
        \\impl ToString for Item { fn to_string(self: Item) -> string { "trait" } }
        \\fn exits() -> i32 { let _ = f"before={return 7}after"; 0 }
        \\fn main() -> () {
        \\    let format = |value| f"value={value}";
        \\    println(format(true));
        \\    let text = |value| f"[{value}]"; println(text("text"));
        \\    let number = |value| f"number={value + 0.0}";
        \\    let single: f32 = 1.5; println(number(single));
        \\    println(f"{Item {}}");
        \\    let object = Item {} as dyn ToString;
        \\    let dynamic = |value| f"{value}"; println(dynamic(object));
        \\    let count = Ref::new(0);
        \\    let next = || { count.set(count.get() + 1); count.get() };
        \\    println(f"{next()},{next()}"); println(count.get());
        \\    println(exits());
        \\}
    ;
    let compilation = compiler_driver::compile_source("interpolation_inference.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "value=true\n[text]\nnumber=1.5\ntrait\ntrait\n1,2\n2\n7\n";
    testing::assert_eq(execute_go(generated, expected, "interpolation_inference", 0, 0), expected);
}
