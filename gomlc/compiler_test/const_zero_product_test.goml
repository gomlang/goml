package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn zero_product_array_lengths_remain_zero_through_specialization() -> () {
    let source = "fn empty[const N: usize](value: [i32; N * 0]) -> [i32; 0] { value } fn main() -> () { let value: [i32; 0] = empty::[3]([]); match value { [] => println(7) }; }";
    let compilation = compiler_driver::compile_source("const_zero_product.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n";
    testing::assert_eq(execute_go(generated, expected, "const_zero_product", 0, 0), expected);
}
