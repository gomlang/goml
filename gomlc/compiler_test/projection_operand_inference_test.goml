package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn inferred_projection_selects_tuple_and_struct_representation() -> () {
    let source =
        \\struct Pair(i32);
        \\fn main() -> () {
        \\    let first = |pair| pair.0;
        \\    println(first((7, true)));
        \\    let wrapped = |pair| pair.0;
        \\    println(wrapped(Pair(8)));
        \\    let nested = |pair| (pair.0).1;
        \\    println(nested(((true, 9), false)));
        \\    let optional = |pair| pair.0.unwrap_or(0);
        \\    println(optional((Option::Some(10), true)));
        \\    let write = |pair| { pair.0 = 11; pair.0 };
        \\    println(write(Pair(0)));
        \\}
    ;
    let compilation = compiler_driver::compile_source("projection_operand_inference.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n8\n9\n10\n11\n";
    testing::assert_eq(
        execute_go(generated, expected, "projection_operand_inference", 0, 0),
        expected,
    );
}
