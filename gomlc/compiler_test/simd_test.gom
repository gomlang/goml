package compiler_test;

use module::cmd::gomlc as compiler_driver;
use module::go_backend;
use module::simd;
use std::fs;
use std::path;
use std::testing;

#[test]
fn simd_assembly_snapshots_match() -> () {
    let directory = path::join(compiler_tests_root(), "simd");
    let sources: Vec[string] = Vec::new();
    for name in read_directory(directory) {
        let source = path::join(path::join(directory, name), "main.gom");
        if fs::is_file(source) {
            sources.push(source)
        }
    }
    testing::assert(!sources.is_empty());
    let contents: Vec[string] = Vec::new();
    for source in sources {
        contents.push(read_file(source))
    }
    let compiler = compiler_driver::source_compiler_for_sources(contents);
    for source in sources {
        let compilation = compiler_driver::compile_source_with(compiler, source, read_file(source));
        let native = testing::expect_some(
            testing::expect_ok(
                simd::native_source(go_backend::encode(compilation.go_value)),
                "valid native SIMD metadata",
            ),
            "fixture produces native assembly",
        );
        testing::assert(native.assembly != "");
        assert_text(native.assembly, source + ".s", source)
    }
}
