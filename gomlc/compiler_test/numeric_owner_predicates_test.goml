package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn numeric_owner_obligations_preserve_context_through_method_results() -> () {
    let source =
        \\struct Box[T] { value: T }
        \\struct Maker[T] { value: T }
        \\trait Make[T] { fn make(self: Self) -> T; }
        \\impl[T: ToString] Make[Box[T]] for Maker[T] { fn make(self: Maker[T]) -> Box[T] { Box { value: self.value } } }
        \\struct Source[T] { value: T }
        \\trait Read { type Item; fn read(self: Self) -> Self::Item; }
        \\impl[T: ToString] Read for Source[T] { type Item = Box[T]; fn read(self: Source[T]) -> Box[T] { Box { value: self.value } } }
        \\fn main() -> () {
        \\    let first: i32 = Maker { value: 7 }.make().value;
        \\    let second: i32 = Make::[Box[i32]]::make(Maker { value: 8 }).value;
        \\    let third: i32 = Maker::make(Maker { value: 9 }).value;
        \\    let fourth: i32 = (Maker::make)(Maker { value: 10 }).value;
        \\    let fifth: i32 = Source { value: 11 }.read().value;
        \\    let sixth: i32 = Read::read(Source { value: 12 }).value;
        \\    let seventh: f32 = Source { value: 13.0 }.read().value;
        \\    println(first); println(second); println(third); println(fourth); println(fifth); println(sixth); println(seventh);
        \\}
    ;
    let compilation = compiler_driver::compile_source("numeric_owner_predicates.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n8\n9\n10\n11\n12\n13\n";
    testing::assert_eq(execute_go(generated, expected, "numeric_owner_predicates", 0, 0), expected);
}
