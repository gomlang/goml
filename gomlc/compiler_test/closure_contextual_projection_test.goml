package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn closures_infer_projected_parameter_shapes_before_owner_arguments() -> () {
    let source = "trait CallableSource { type Item; } impl CallableSource for bool { type Item = () -> i32; } fn call[T: CallableSource](callback: (T::Item) -> i32, owner: T, item: T::Item) -> i32 { callback(item) } trait TupleSource { type Item; } impl TupleSource for bool { type Item = (i32, i32); } fn tuple[T: TupleSource](callback: (T::Item) -> i32, owner: T, item: T::Item) -> i32 { callback(item) } trait ArraySource { type Item; } impl ArraySource for bool { type Item = [i32; 2]; } fn index[T: ArraySource](callback: (T::Item) -> i32, owner: T, item: T::Item) -> i32 { callback(item) } trait NumericSource { type Item; } impl NumericSource for bool { type Item = i32; } fn numeric[T: NumericSource](callback: (T::Item) -> T::Item, owner: T, item: T::Item) -> T::Item { callback(item) } fn main() -> () { println(call(|value| value(), true, || 7)); println(tuple(|value| value.0, true, (8, 9))); println(index(|value| value[0], true, [9, 10])); let later = |owner| numeric(|value| value + 1, owner, 10); println(later(true)); }";
    let compilation = compiler_driver::compile_source("closure_contextual_projection.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n8\n9\n11\n";
    testing::assert_eq(
        execute_go(generated, expected, "closure_contextual_projection", 0, 0),
        expected,
    );
}
