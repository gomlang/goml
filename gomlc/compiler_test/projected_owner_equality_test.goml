package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn projected_owner_equalities_execute_after_concrete_specialization() -> () {
    let source = "trait Source { type Item; } impl Source for Vec[i32] { type Item = i32; } impl Source for Option[i32] { type Item = i32; } impl Source for (i32, i32) { type Item = i32; } fn vector[T: Source](value: T) -> Vec[T::Item] where T = Vec[T::Item] { value } fn optional[T: Source](value: T) -> Option[T::Item] where T = Option[T::Item] { value } fn pair[T: Source](value: T) -> (T::Item, T::Item) where T = (T::Item, T::Item) { value } fn from_vector[T: Source](value: Vec[T::Item]) -> T where T = Vec[T::Item] { value } fn main() -> () { let values: Vec[i32] = Vec::from_array([1]); let roundtrip: Vec[i32] = from_vector::[Vec[i32]](vector(values)); println(roundtrip[0]); let value: Option[i32] = Some(2); match optional(value) { Some(number) => println(number), None => println(0), }; let values: (i32, i32) = (3, 4); let result = pair(values); println(result.0 + result.1); }";
    let compilation = compiler_driver::compile_source("projected_owner_equality.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "1\n2\n7\n";
    testing::assert_eq(execute_go(generated, expected, "projected_owner_equality", 0, 0), expected);
}
