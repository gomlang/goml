package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn static_method_candidates_dispatch_using_owner_predicates() -> () {
    let source =
        \\trait Left {}
        \\trait Right {}
        \\impl Left for i32 {}
        \\impl Right for bool {}
        \\trait First { fn score(self: Self) -> i32; }
        \\trait Second { fn score(self: Self) -> i32; }
        \\struct Wrap[T] { value: T }
        \\impl[T: Left] First for Wrap[T] { fn score(self: Wrap[T]) -> i32 { 1 } }
        \\impl[T: Right] Second for Wrap[T] { fn score(self: Wrap[T]) -> i32 { 2 } }
        \\fn forward[T: Left](value: Wrap[T]) -> i32 { Wrap::[T]::score(value) }
        \\fn main() -> () {
        \\    let value = Wrap { value: (7).to_i32() };
        \\    println(value.score());
        \\    println(Wrap::[i32]::score(value));
        \\    let f = Wrap::[i32]::score;
        \\    println(f(value));
        \\    println(Wrap::[bool]::score(Wrap { value: true }));
        \\    println(forward(value));
        \\}
    ;
    let compilation = compiler_driver::compile_source("static_method_owner_predicates.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "1\n1\n1\n2\n1\n";
    testing::assert_eq(
        execute_go(generated, expected, "static_method_owner_predicates", 0, 0),
        expected,
    );
}
