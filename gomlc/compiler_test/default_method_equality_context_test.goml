package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn default_method_equalities_and_impl_self_projection_identity_execute() -> () {
    let source =
        \\trait Main { type Item; fn get[T](self, value: T) -> Self::Item where Self::Item = T { value } }
        \\impl Main for bool { type Item = i32; }
        \\trait Parent { type Item; }
        \\trait Child: Parent { type Item; fn child(self, value: Self::Item) -> Self::Item; }
        \\impl Parent for bool { type Item = string; }
        \\impl Child for bool { type Item = i32; fn child(self, value: Self::Item) -> Self::Item { value } }
        \\fn main() -> () { println(true.get(7)); println(true.child(23)); }
    ;
    let compilation = compiler_driver::compile_source(
        "default_method_equality_context.goml",
        source,
    );
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n23\n";
    testing::assert_eq(
        execute_go(generated, expected, "default_method_equality_context", 0, 0),
        expected,
    );
}
