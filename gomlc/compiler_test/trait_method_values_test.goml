package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn trait_method_values_execute_with_static_and_dynamic_receivers() -> () {
    let source =
        \\trait Count { fn count(self: Self) -> usize; }
        \\trait Child: Count { fn child(self: Self) -> usize; }
        \\trait Label { fn label(self: Self) -> usize; }
        \\trait Read[A] { fn read(self: Self) -> A; }
        \\struct Thing {}
        \\impl Count for Thing { fn count(self: Thing) -> usize { 7 } }
        \\impl Child for Thing { fn child(self: Thing) -> usize { 8 } }
        \\impl Label for Thing { fn label(self: Thing) -> usize { 9 } }
        \\impl Read[i32] for Thing { fn read(self: Thing) -> i32 { 10 } }
        \\fn forward[T: Count](value: T) -> usize { let f = Count::count; f(value) }
        \\fn main() -> () {
        \\    let concrete: (Thing) -> usize = Count::count;
        \\    println(concrete(Thing {}));
        \\    let value: dyn Count = Thing {} as dyn Count;
        \\    let dynamic: (dyn Count) -> usize = Count::count;
        \\    println(dynamic(value));
        \\    let inferred = Count::count;
        \\    println(inferred(value));
        \\    let child: dyn Child = Thing {} as dyn Child;
        \\    let inherited: (dyn Child) -> usize = Count::count;
        \\    println(inherited(child));
        \\    let combined: dyn Count + Label = Thing {} as dyn Count + Label;
        \\    let combined_count: (dyn Count + Label) -> usize = Count::count;
        \\    let combined_label: (dyn Count + Label) -> usize = Label::label;
        \\    println(combined_count(combined));
        \\    println(combined_label(combined));
        \\    let reader: dyn Read[i32] = Thing {} as dyn Read[i32];
        \\    let read: (dyn Read[i32]) -> i32 = Read::[i32]::read;
        \\    println(read(reader));
        \\    println(forward(Thing {}));
        \\    println(forward(value));
        \\    println(forward(child));
        \\    println(forward(combined));
        \\    let zero: () -> i32 = Default::default;
        \\    println(zero());
        \\    let render: (i32) -> string = ToString::to_string;
        \\    println(render(42));
        \\}
    ;
    let compilation = compiler_driver::compile_source("trait_method_values.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n7\n7\n7\n7\n9\n10\n7\n7\n7\n7\n0\n42\n";
    testing::assert_eq(execute_go(generated, expected, "trait_method_values", 0, 0), expected);
}
