package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn deferred_pattern_literals_execute_after_numeric_inference() -> () {
    let source =
        \\#[comptime]
        \\fn nonzero_const(value: u8) -> bool {
        \\    let test = |x| match x { 0.0 => false, 1..=255 => true };
        \\    test(value)
        \\}
        \\const NONZERO: bool = {
        \\    let test = |x| match x { 0.0 => false, 1..=255 => true };
        \\    let n: u8 = 1;
        \\    test(n)
        \\};
        \\fn main() -> () {
        \\    println(NONZERO);
        \\    let nonzero = |value| match value { 0.0 => false, 1..=255 => true };
        \\    let n: u8 = 1;
        \\    println(nonzero(n));
        \\    let minimum = |value| match value { -128 => true, _ => false };
        \\    let low: i8 = -128;
        \\    println(minimum(low));
        \\    let rounded = |value| match value { 16777217.0 => 1, 16777216.0 => 2, _ => 3 };
        \\    let near: f32 = 16777216.0;
        \\    println(rounded(near));
        \\    let result = comptime { nonzero_const(1) };
        \\    println(result);
        \\    let nested = |value| match value { Option::Some((0.0, _)) | Option::Some((1.0, _)) => true, _ => false };
        \\    println(nested(Some((n, true))));
        \\}
    ;
    let compilation = compiler_driver::compile_source("deferred_pattern_literals.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "true\ntrue\ntrue\n1\ntrue\ntrue\n";
    testing::assert_eq(execute_go(generated, expected, "deferred_pattern_literals", 0, 0), expected);
}
