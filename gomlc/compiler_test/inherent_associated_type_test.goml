package compiler_test;

use module::compiler as compiler_driver;
use std::testing;

#[test]
fn unused_inherent_associated_types_report_a_declaration_error() -> () {
    let diagnostics = compiler_driver::diagnostic_output(
        "inherent_associated_type.goml",
        "struct Value {} impl Value { type Item = bool; } fn main() -> () {}",
    );
    testing::assert(
        diagnostics.contains("Associated type Item is only allowed in a trait implementation"),
    );
}
