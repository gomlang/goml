package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn numeric_method_dispatch_uses_later_receiver_and_return_types() -> () {
    let source =
        \\trait Echo { fn echo(self: Self) -> Self; }
        \\impl Echo for f32 { fn echo(self: f32) -> f32 { self + 1.0 } }
        \\impl Echo for f64 { fn echo(self: f64) -> f64 { self + 2.0 } }
        \\trait OnlySingle { fn read(self: Self) -> f32; }
        \\impl OnlySingle for f32 { fn read(self: f32) -> f32 { self } }
        \\fn main() -> () {
        \\    let text = |x| (x + 0.0).to_string(); let single: f32 = 1.5; println(text(single));
        \\    let byte_text = |x| (x + 0).to_string(); let byte: u8 = 7; println(byte_text(byte));
        \\    let make = || 1.0.echo(); let echoed: f32 = make(); println(echoed);
        \\    println(1.0.to_string());
        \\    let value = 2.5;
        \\    let rendered = value.to_string();
        \\    let erased = value as dyn OnlySingle;
        \\    println(rendered);
        \\    println(erased.read());
        \\    let mut quote = 0.to_u8();
        \\    if quote == 0 { quote = b'x'; }
        \\    println(quote.to_string());
        \\}
    ;
    let compilation = compiler_driver::compile_source("numeric_method_inference.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "1.5\n7\n2\n1\n2.5\n2.5\n120\n";
    testing::assert_eq(execute_go(generated, expected, "numeric_method_inference", 0, 0), expected);
}
