package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn comptime_method_values_share_direct_call_resolution_execute() -> () {
    let source =
        \\trait Answer { fn answer(self: Self) -> i32; }
        \\impl Answer for bool { #[comptime] fn answer(self: Self) -> i32 { 7 } }
        \\trait Label[T] { fn label(self: Self) -> i32; }
        \\impl Label[i32] for bool { #[comptime] fn label(self: Self) -> i32 { 11 } }
        \\impl Label[bool] for bool { #[comptime] fn label(self: Self) -> i32 { 12 } }
        \\type Flag = bool;
        \\trait Static { fn number() -> i32; }
        \\impl Static for bool { #[comptime] fn number() -> i32 { 19 } }
        \\trait Second { fn answer(self: Self) -> i32; }
        \\impl Second for bool { #[comptime] fn answer(self: Self) -> i32 { 8 } }
        \\fn main() -> () {
        \\    println(comptime { Answer::answer(true) });
        \\    println(comptime { let callback: (bool) -> i32 = Answer::answer; callback(true) });
        \\    println(comptime { let callback: () -> i32 = Flag::number; callback() });
        \\    println(comptime { let callback: (bool) -> i32 = Label::[i32]::label; callback(true) });
        \\    println(comptime { let callback: (bool) -> i32 = Label::[bool]::label; callback(true) });
        \\    println(comptime {
        \\        let value = true as dyn Answer + Second;
        \\        let callback: (dyn Answer + Second) -> i32 = Second::answer;
        \\        callback(value)
        \\    });
        \\    println(comptime { let callback: (i32) -> string = ToString::to_string; callback(23) });
        \\}
    ;
    let compilation = compiler_driver::compile_source("comptime_method_value.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n7\n19\n11\n12\n8\n23\n";
    testing::assert_eq(execute_go(generated, expected, "comptime_method_value", 0, 0), expected);
}
