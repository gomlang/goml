package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn function_values_specialize_dyn_associated_return_types() -> () {
    let compiler = compiler_driver::source_compiler_without_standard();
    let mut index = 0;
    for (source, expected) in[
        (
            "trait Source { type Item; fn get(self) -> Self::Item; }\nimpl Source for bool { type Item = i32; fn get(self) -> i32 { 7 } }\nfn get[T: Source](value:T) -> T::Item { value.get() }\nfn main() { let value=true as dyn Source[Item=i32]; let call=get; println(call(value)); }\n",
            "7\n",
        ),
        (
            "trait Source { type Item; fn get(self) -> Self::Item; }\nimpl Source for bool { type Item = i32; fn get(self) -> i32 { 7 } }\nfn get[T: Source](value:T) -> T::Item { value.get() }\nfn main() { let value=true as dyn Source[Item=i32]; println(get(value)); }\n",
            "7\n",
        ),
        (
            "trait Source { type Item; fn get(self) -> Self::Item; }\nimpl Source for bool { type Item = i32; fn get(self) -> i32 { 7 } }\nfn get[T: Source](value:T) -> T::Item { value.get() }\nfn main() { let value=true; let call=get; println(call(value)); }\n",
            "7\n",
        ),
        (
            "trait A[X] { type Item; fn first(self) -> Self::Item; }\ntrait B { type Item; fn second(self) -> Self::Item; }\ntrait Child: A[bool] {}\nimpl A[bool] for bool { type Item = i32; fn first(self) -> i32 { 7 } }\nimpl B for bool { type Item = string; fn second(self) -> string { \"nine\" } }\nimpl Child for bool {}\nfn first[T: A[bool]](value:T) -> T::Item { value.first() }\nfn second[T: B](value:T) -> T::Item { value.second() }\nfn main() { let value=true as dyn Child + A[bool, Item=i32] + B[Item=string]; let a=first; let b=second; println(a(value)); println(b(value)); }\n",
            "7\nnine\n",
        ),
    ] {
        let compilation = compiler_driver::compile_source_with(
            compiler,
            "dyn_projection_values.goml",
            source,
        );
        let generated = go_backend::encode(compilation.go_value);
        testing::assert_eq(
            execute_go(generated, expected, "dyn_projection_values", 0, index),
            expected,
        );
        index += 1;
    }
}
