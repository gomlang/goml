package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn inferred_sequence_patterns_preserve_container_and_rest_types() -> () {
    let source =
        \\fn main() -> () {
        \\    let first = |values| match values { [head, ..] => head };
        \\    println(first([7, 8]));
        \\    let rest = |values| { let [_, tail @ ..] = values; tail };
        \\    let tail: [i32; 2] = rest([1, 9, 10]);
        \\    println(tail[1]);
        \\    let vector = |values| match values { [head, ..] => head, [] => 0 };
        \\    println(vector(Vec::from_array([11, 12])));
        \\    let slice = |values| match values { [_, tail @ ..] => tail, [tail @ ..] => tail };
        \\    let values = Vec::from_array([13, 14]);
        \\    println(slice(values.as_slice())[0]);
        \\}
    ;
    let compilation = compiler_driver::compile_source("array_pattern_inference.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n10\n11\n14\n";
    testing::assert_eq(execute_go(generated, expected, "array_pattern_inference", 0, 0), expected);
}
