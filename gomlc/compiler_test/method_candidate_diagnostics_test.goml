package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn method_selection_ignores_generic_errors_from_rejected_candidates() -> () {
    let source =
        \\trait Left {}
        \\trait Right {}
        \\impl Left for i32 {}
        \\impl Right for bool {}
        \\trait First { fn score[const N: usize](self: Self) -> usize; }
        \\trait Second { fn score(self: Self) -> usize; }
        \\struct Wrap[T] { value: T }
        \\impl[T: Left] First for Wrap[T] { fn score[const N: usize](self: Wrap[T]) -> usize { N } }
        \\impl[T: Right] Second for Wrap[T] { fn score(self: Wrap[T]) -> usize { 2 } }
        \\fn main() -> () {
        \\    let value: Wrap[i32] = Wrap { value: 7 };
        \\    println(value.score::[7]());
        \\    println(Wrap::[i32]::score::[8](value));
        \\    let f = Wrap::[i32]::score::[9];
        \\    println(f(value));
        \\    println(Wrap { value: true }.score());
        \\}
    ;
    let compilation = compiler_driver::compile_source("method_candidate_diagnostics.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n8\n9\n2\n";
    testing::assert_eq(
        execute_go(generated, expected, "method_candidate_diagnostics", 0, 0),
        expected,
    );
}
