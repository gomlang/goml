package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn projected_argument_coercions_resolve_without_argument_order_dependence() -> () {
    let source = "trait Source { type Item; } impl Source for bool { type Item = i32; } impl Source for string { type Item = bool; } fn choose[T: Source](item: T::Item, owner: T) -> T::Item { item } fn pair[T: Source](items: (T::Item, T)) -> T::Item { items.0 } fn array[T: Source](items: [T::Item; 2], owner: T) -> T::Item { items[0] } fn chain[A: Source, B: Source](item: A::Item, first: A, second: B::Item, owner: B) -> A::Item { item } fn callback[T: Source](call: () -> T::Item, owner: T) -> T::Item { call() } trait FloatSource { type Item; } impl FloatSource for bool { type Item = f32; } fn decimal[T: FloatSource](item: T::Item, owner: T) -> T::Item { item } fn main() -> () { println(choose(7, true)); println(pair((8, true))); println(array([9, 10], true)); let call = |value| chain(11, value, value, \"owner\"); println(call(true)); println(callback(|| 12, true)); println(choose(false, \"owner\")); println(decimal(1.25, true)); }";
    let compilation = compiler_driver::compile_source("projected_coercion.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n8\n9\n11\n12\nfalse\n1.25\n";
    testing::assert_eq(execute_go(generated, expected, "projected_coercion", 0, 0), expected);
}
