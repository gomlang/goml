package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn default_method_generics_execute_in_distinct_scopes() -> () {
    let source =
        \\trait Identity { fn identity[T](self: Self, value: T) -> T { value } }
        \\struct Holder[T] { value: T }
        \\impl[T] Identity for Holder[T] {}
        \\struct Renamed[T] { value: T }
        \\impl[U] Identity for Renamed[U] {}
        \\trait ArrayIdentity { fn array_identity[const N: usize](self: Self, value: [i32; N]) -> [i32; N] { value } }
        \\struct ArrayHolder[const N: usize] { value: [i32; N] }
        \\impl[const N: usize] ArrayIdentity for ArrayHolder[N] {}
        \\fn main() -> () {
        \\    let holder = Holder { value: 42 };
        \\    println(holder.identity(true));
        \\    println(Identity::identity(holder, "trait"));
        \\    println(Renamed { value: 42 }.identity("renamed"));
        \\    let array = ArrayHolder { value: [1, 2] }.array_identity::[3]([3, 4, 5]);
        \\    println(array[2]);
        \\}
    ;
    let compilation = compiler_driver::compile_source("default_generic_scope.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "true\ntrait\nrenamed\n5\n";
    testing::assert_eq(execute_go(generated, expected, "default_generic_scope", 0, 0), expected);
}
