package compiler_test;

use std::path;
use std::process;
use std::testing;
use std::time;

fn linux_system_fixture_under_race_detector(project_name: string) -> () {
    let fixture = path::join(compiler_tests_root(), "module/" + project_name);
    let target = path::join(repository_root(), "_artifact/linux-system-race/" + project_name);
    let output = testing::expect_ok(
        process::Command::new(bootstrap_goml_binary()).args(
            Vec::from_array(["run", "--compiler", bootstrap_gomlc_binary(), "--target-dir", target]),
        ).current_dir(fixture).env("GOFLAGS", "-race").output_timeout_structured(
            time::Duration::from_seconds(120),
        ),
        "run Linux lifecycle fixture with race detector",
    );
    assert_command_success(output, "Linux lifecycle race test " + project_name);
}

#[test]
fn linux_process_lifecycle_under_race_detector() -> () {
    linux_system_fixture_under_race_detector("project078_linux_process")
}

#[test]
fn linux_memory_lifecycle_under_race_detector() -> () {
    linux_system_fixture_under_race_detector("project079_linux_memory")
}
