package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn divergent_select_results_execute_without_unresolved_types() -> () {
    let source =
        \\fn receive(channel: Channel[i32]) -> i32 {
        \\    let value = select { recv(channel) as value => return value.unwrap_or(0), };
        \\}
        \\fn send(channel: Channel[i32]) -> i32 {
        \\    let value = select { send(channel, 8) => return 8, };
        \\}
        \\fn fallback(channel: Channel[i32]) -> i32 {
        \\    let value = select priority { recv(channel) when false as _ => return 0, default => return 9, };
        \\}
        \\fn main() -> () {
        \\    let channel = Channel::[i32]::new(1);
        \\    channel.send(7);
        \\    println(receive(channel));
        \\    println(send(channel));
        \\    println(fallback(channel));
        \\}
    ;
    let compilation = compiler_driver::compile_source("select_never.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n8\n9\n";
    testing::assert_eq(execute_go(generated, expected, "select_never", 0, 0), expected);
}
