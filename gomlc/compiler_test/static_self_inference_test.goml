package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn associated_function_closures_dispatch_using_later_self_context() -> () {
    let source =
        \\trait Make { fn make() -> Self; }
        \\struct A { value: i32 }
        \\struct B { value: bool }
        \\impl Make for A { fn make() -> A { A { value: 7 } } }
        \\impl Make for B { fn make() -> B { B { value: true } } }
        \\fn make_generic[T: Make]() -> T { let make = || Make::make(); make() }
        \\fn main() -> () {
        \\    let first = || Make::make(); let a: A = first(); println(a.value);
        \\    let second = || Make::make(); let b: B = second(); println(b.value);
        \\    let c: A = make_generic(); println(c.value);
        \\}
    ;
    let compilation = compiler_driver::compile_source("static_self_inference.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\ntrue\n7\n";
    testing::assert_eq(execute_go(generated, expected, "static_self_inference", 0, 0), expected);
}
