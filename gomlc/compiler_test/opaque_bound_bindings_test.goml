package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn opaque_associated_bounds_keep_static_generic_dispatch() -> () {
    let source =
        \\trait A { type Item; fn get(self: Self) -> Self::Item; }
        \\trait B { type Item; fn other(self: Self) -> Self::Item; }
        \\trait C: A + B { fn identity[T](self: Self, value: T) -> T; }
        \\impl A for bool { type Item = i32; fn get(self: Self) -> i32 { 7 } }
        \\impl B for bool { type Item = string; fn other(self: Self) -> string { "second" } }
        \\impl C for bool { fn identity[T](self: Self, value: T) -> T { value } }
        \\fn make() -> impl C + A[Item = i32] + B[Item = string] { true }
        \\fn main() -> () { let value = make(); println(A::get(value)); println(B::other(value)); println(value.identity(9)); }
    ;
    let compilation = compiler_driver::compile_source("opaque_bound_bindings.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\nsecond\n9\n";
    testing::assert_eq(execute_go(generated, expected, "opaque_bound_bindings", 0, 0), expected);
}
