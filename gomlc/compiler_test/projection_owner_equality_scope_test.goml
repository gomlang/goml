package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn projection_owner_equalities_execute_through_function_and_trait_signatures() -> () {
    let source =
        \\trait Bound { type Item; }
        \\impl Bound for bool { type Item = i32; }
        \\fn read[T: Bound, U](value: U::Item) -> U::Item where T = U { value }
        \\trait Main { fn get[T: Bound, U](self, value: U::Item) -> U::Item where T = U; }
        \\impl Main for bool { fn get[T: Bound, U](self, value: U::Item) -> U::Item where T = U { value } }
        \\fn main() -> () { println(read::[bool, bool](17)); println(true.get::[bool, bool](29)); }
    ;
    let compilation = compiler_driver::compile_source(
        "projection_owner_equality_scope.goml",
        source,
    );
    let generated = go_backend::encode(compilation.go_value);
    let expected = "17\n29\n";
    testing::assert_eq(
        execute_go(generated, expected, "projection_owner_equality_scope", 0, 0),
        expected,
    );
}
