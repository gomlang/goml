package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn never_structural_patterns_do_not_evaluate_unreachable_components() -> () {
    let source = "fn first() -> i32 { match (return 7) { (a, [b, rest @ ..]) => { let _ = (a, b, rest); 0 } } } fn second() -> i32 { for (a, b) in return 8 { let _ = (a, b); } } fn main() -> () { println(first()); println(second()); }";
    let compilation = compiler_driver::compile_source("never_structural_patterns.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n8\n";
    testing::assert_eq(execute_go(generated, expected, "never_structural_patterns", 0, 0), expected);
}
