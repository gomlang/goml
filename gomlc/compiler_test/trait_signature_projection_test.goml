package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn trait_and_impl_method_projection_metadata_selects_the_declared_bound() -> () {
    let source =
        \\trait First { type Item; }
        \\trait Second { type Item; }
        \\impl First for bool { type Item = i32; }
        \\impl Second for bool { type Item = string; }
        \\trait Main { fn run[T: First](self, value: T::Item) -> i32; }
        \\impl Main for i32 { fn run[T: First](self, value: T::Item) -> i32 { 7 } }
        \\fn generic[U: Main](receiver: U) -> i32 { receiver.run::[bool](2) }
        \\fn main() -> () { let value: i32 = 1; println(value.run::[bool](2)); println(generic(value)); }
    ;
    let compilation = compiler_driver::compile_source("trait_signature_projection.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n7\n";
    testing::assert_eq(
        execute_go(generated, expected, "trait_signature_projection", 0, 0),
        expected,
    );
}
