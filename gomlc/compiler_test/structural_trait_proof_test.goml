package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn derived_and_manual_structural_hash_keys_execute() -> () {
    let declarations = "#[derive(PartialEq, Eq, Hash)] struct Derived { value: i32 } struct Manual { value: i32 } impl PartialEq for Manual { fn eq(self: Self, other: Self) -> bool { self.value == other.value } } impl Eq for Manual {} impl Hash for Manual { fn hash(self: Self) -> u64 { 7 } } ";
    for item in[("Derived", "Derived { value: 3 }"), ("Manual", "Manual { value: 3 }")] {
        let source = declarations + "fn main() -> () { let array: HashMap[[" + item.0
            + "; 1], i32] = HashMap::new(); array.set(["
            + item.1
            + "], 7); let tuple: HashMap[("
            + item.0
            + ", i32), i32] = HashMap::new(); tuple.set(("
            + item.1
            + ", 1), 8); let nested: HashMap[(["
            + item.0
            + "; 1], i32), i32] = HashMap::new(); nested.set((["
            + item.1
            + "], 1), 9); println(array.get(["
            + item.1
            + "]).unwrap_or(0)); println(tuple.get(("
            + item.1
            + ", 1)).unwrap_or(0)); println(nested.get((["
            + item.1
            + "], 1)).unwrap_or(0)); }";
        let compilation = compiler_driver::compile_source("structural_trait_proof.goml", source);
        let generated = go_backend::encode(compilation.go_value);
        let expected = "7\n8\n9\n";
        testing::assert_eq(
            execute_go(generated, expected, "structural_trait_proof", 0, 0),
            expected,
        );
    }
}
