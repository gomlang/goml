package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn comptime_scalar_inputs_propagate_conditional_loop_and_function_exits() -> () {
    let source =
        \\#[comptime] fn field(flag: bool) -> i32 {
        \\    (if flag {return 7} else {(1, 2)}).0
        \\}
        \\#[comptime] fn index(flag: bool) -> i32 {
        \\    let values = [3, 4];
        \\    values[if flag {return 8} else {1}]
        \\}
        \\#[comptime] fn conditional(flag: bool) -> i32 {
        \\    if (if flag {return 9} else {true}) {5} else {6}
        \\}
        \\#[comptime] fn guard(flag: bool) -> i32 {
        \\    match 1 { n if (if flag {return 10} else {n == 1}) => 6, _ => 0 }
        \\}
        \\#[comptime] fn loops() -> i32 {
        \\    let mut i: i32 = 0;
        \\    loop {
        \\        i += 1;
        \\        let z = (if i == 1 { continue } else if i == 3 { break i } else { (1, 2) }).0;
        \\        let _ = z;
        \\    }
        \\}
        \\fn main() -> () {
        \\    println(comptime {field(true)}); println(comptime {field(false)});
        \\    println(comptime {index(true)}); println(comptime {index(false)});
        \\    println(comptime {conditional(true)}); println(comptime {conditional(false)});
        \\    println(comptime {guard(true)}); println(comptime {guard(false)});
        \\    println(comptime {loops()});
        \\}
    ;
    let compilation = compiler_driver::compile_source("comptime_scalar_inputs.goml", source);
    let expected = "7\n1\n8\n4\n9\n5\n10\n6\n3\n";
    testing::assert_eq(
        execute_go(
            go_backend::encode(compilation.go_value),
            expected,
            "comptime_scalar_inputs",
            0,
            0,
        ),
        expected,
    );
}
