package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn named_array_lengths_agree_with_constant_values() -> () {
    let source = "const ZERO: u8 = 255 + 1; const SIZE: usize = 2.to_usize(); fn main() -> () { let empty: [i32; ZERO] = []; let values: [i32; SIZE] = [1, 2]; println(ZERO); println(values[1]); }";
    let compilation = compiler_driver::compile_source("named_constant_lengths.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "0\n2\n";
    testing::assert_eq(execute_go(generated, expected, "named_constant_lengths", 0, 0), expected);
}
