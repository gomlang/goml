package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn local_condition_loops_preserve_targets_and_outer_returns() -> () {
    let source = "fn returns() -> i32 { while (loop { return 7; }) {} } fn labeled() -> i32 { 'outer: loop { loop { break 'outer 8; } } } fn main() -> () { let mut n = 0; while ('inner: loop { n += 1; if n < 2 { continue 'inner; } break 'inner false; }) {} println(n); println(returns()); println(labeled()); }";
    let compilation = compiler_driver::compile_source("while_condition_targets.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "2\n7\n8\n";
    testing::assert_eq(execute_go(generated, expected, "while_condition_targets", 0, 0), expected);
}
