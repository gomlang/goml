package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn function_return_types_determine_projected_argument_specialization() -> () {
    let source = "trait Make { type Item; fn make(value: Self::Item) -> Self; } impl Make for bool { type Item = i32; fn make(value: i32) -> bool { value > 0 } } fn create[T: Make](value: T::Item) -> T { T::make(value) } fn main() -> () { let explicit: bool = create::[bool](7); println(explicit); let inferred: bool = create(-1); println(inferred); let callback: (i32) -> bool = create::[bool]; println(callback(2)); }";
    let compilation = compiler_driver::compile_source("projection_return_inference.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "true\nfalse\ntrue\n";
    testing::assert_eq(
        execute_go(generated, expected, "projection_return_inference", 0, 0),
        expected,
    );
}
