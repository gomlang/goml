package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn associated_constants_preserve_specialized_owners_and_default_overrides() -> () {
    let source =
        \\struct V[T] { value: T }
        \\impl V[i32] { const A: i32 = V::[bool]::A; }
        \\impl V[bool] { const A: i32 = 7; }
        \\trait Values { const A: i32 = Self::B; const B: i32 = Self::A; }
        \\struct Item {}
        \\impl Values for Item { const B: i32 = 11; }
        \\trait DefaultItem { const VALUE: Self; }
        \\struct Number { value: i32 }
        \\impl DefaultItem for Number { const VALUE: Self = Number { value: 13 }; }
        \\fn main() -> () {
        \\    println(V::[i32]::A);
        \\    println(Item::A);
        \\    let value: Number = DefaultItem::VALUE;
        \\    println(value.value);
        \\}
    ;
    let compilation = compiler_driver::compile_source("associated_constant_validation.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n11\n13\n";
    testing::assert_eq(
        execute_go(generated, expected, "associated_constant_validation", 0, 0),
        expected,
    );
}

#[test]
fn finite_associated_constant_chain_compiles_and_runs() -> () {
    let mut source = "struct Value {} impl Value { const C0: i32 = 17;";
    for index in 1..140 {
        source += "const C" + index.to_string() + ": i32 = Self::C" + (index - 1).to_string() + ";";
    }
    source += "} fn main() -> () { println(Value::C139); }";
    let compilation = compiler_driver::compile_source("finite_constant_chain.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "17\n";
    testing::assert_eq(execute_go(generated, expected, "finite_constant_chain", 0, 0), expected);
}
