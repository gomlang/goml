package compiler_test;

use module::resources;
use std::fs;
use std::path;
use std::process;
use std::testing;
use std::time;

#[test]
fn linux_descriptor_records_and_lifecycle() -> () {
    let project = path::join(repository_root(), "_artifact/linux-fd-internal-tests");
    testing::expect_ok(fs::create_dir_all(project), "create fd test project");
    testing::expect_ok(
        fs::write_file_structured(
            path::join(project, "goml.toml"),
            "[module]\npath = \"linux_fd_internal\"\n",
        ),
        "write manifest",
    );
    let sources = testing::expect_some(
        testing::expect_ok(
            resources::standard_sources(resources::STD_OS_LINUX_FD_PACKAGE),
            "load fd",
        ),
        "fd package",
    );
    for source in sources {
        let name = testing::expect_some(path::file_name(source.path), "source name");
        testing::expect_ok(
            fs::write_file_structured(
                path::join(project, name),
                source.source.replace("use module::", "use std::").replace(
                    "use std::internal::linux as kernel;",
                    "use module::kernel;",
                ),
            ),
            "copy fd source",
        );
    }
    let kernel_dir = path::join(project, "kernel");
    testing::expect_ok(fs::create_dir_all(kernel_dir), "create local kernel package");
    let helpers = testing::expect_some(
        testing::expect_ok(
            resources::standard_sources(resources::STD_INTERNAL_LINUX_PACKAGE),
            "load kernel helpers",
        ),
        "kernel helpers",
    );
    for source in helpers {
        if !source.path.ends_with("/linux.gom") {
            continue;
        }
        let name = testing::expect_some(path::file_name(source.path), "helper source name");
        testing::expect_ok(
            fs::write_file_structured(
                path::join(kernel_dir, name),
                source.source.replace("package linux;", "package kernel;").replace(
                    "use module::",
                    "use std::",
                ),
            ),
            "copy kernel helpers",
        );
    }
    testing::expect_ok(
        fs::write_file_structured(
            path::join(project, "fd_test.gom"),
            read_file(path::join(compiler_tests_root(), "library/linux_fd/fd_test.gom")).replace(
                "use std::internal::linux as kernel;",
                "use module::kernel;",
            ),
        ),
        "copy tests",
    );
    let output = testing::expect_ok(
        process::Command::new(bootstrap_goml_binary()).args(
            Vec::from_array(
                ["test", "--compiler", bootstrap_gomlc_binary(), "--jobs", "1", "--timeout", "30s"],
            ),
        ).current_dir(project).env("GOFLAGS", "-race").output_timeout_structured(
            time::Duration::from_seconds(90),
        ),
        "run fd tests",
    );
    assert_command_success(output, "fd internal tests with race detector");
    let fixture = path::join(compiler_tests_root(), "module/project077_linux_fd");
    let output = testing::expect_ok(
        process::Command::new(bootstrap_goml_binary()).args(
            Vec::from_array(
                [
                    "run",
                    "--compiler",
                    bootstrap_gomlc_binary(),
                    "--target-dir",
                    path::join(project, "fixture"),
                ],
            ),
        ).current_dir(fixture).env("GOFLAGS", "-race").output_timeout_structured(
            time::Duration::from_seconds(90),
        ),
        "run descriptor lifecycle fixture",
    );
    assert_command_success(output, "descriptor lifecycle with race detector");
}
