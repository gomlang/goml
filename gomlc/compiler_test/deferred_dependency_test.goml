package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn deferred_method_and_field_dependencies_execute_in_both_directions() -> () {
    let source =
        \\struct Box[T] { value: T }
        \\struct Maker[T] { value: T }
        \\struct Number { value: i32 }
        \\struct Text { value: string }
        \\struct First {}
        \\struct Second {}
        \\struct Wrapper { source: First }
        \\struct Flag { value: bool }
        \\trait Make[T] { fn make(self: Self) -> T; }
        \\impl[T] Make[Box[T]] for Maker[T] { fn make(self: Maker[T]) -> Box[T] { Box { value: self.value } } }
        \\impl Make[Number] for First { fn make(self: First) -> Number { Number { value: 7 } } }
        \\impl Make[Text] for Second { fn make(self: Second) -> Text { Text { value: "hello" } } }
        \\trait Read[T] { fn read(self: Self) -> T; }
        \\impl Read[u8] for First { fn read(self: First) -> u8 { 7 } }
        \\impl Read[string] for Second { fn read(self: Second) -> string { "hello" } }
        \\trait Next[T] { fn next(self: Self) -> T; }
        \\impl Next[Number] for Number { fn next(self: Number) -> Number { self } }
        \\impl Next[Text] for Text { fn next(self: Text) -> Text { self } }
        \\trait Choose[T] { fn choose(self: Self, value: T) -> i32; }
        \\impl Choose[i32] for First { fn choose(self: First, value: i32) -> i32 { 1 } }
        \\impl Choose[bool] for First { fn choose(self: First, value: bool) -> i32 { 2 } }
        \\fn main() -> () {
        \\    let read = |source| source.make().value;
        \\    println(read(First {}));
        \\    let wrapped = |wrapper| wrapper.source.make().value;
        \\    println(wrapped(Wrapper { source: First {} }));
        \\    let reverse = |wrapper| wrapper.source.read();
        \\    println(reverse(Wrapper { source: First {} }));
        \\    let chained = |source| source.make().next().value;
        \\    println(chained(First {}));
        \\    let choose = |source, flag| source.choose(flag.value);
        \\    println(choose(First {}, Flag { value: true }));
        \\    let numeric = |source| source.read() + 1;
        \\    println(numeric(First {}));
        \\    let text = |source| source.make().value;
        \\    println(text(Second {}));
        \\    let generic = |source| source.make().value;
        \\    let inferred: i32 = generic(Maker { value: 17 });
        \\    println(inferred);
        \\}
    ;
    let compilation = compiler_driver::compile_source("deferred_dependency.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n7\n7\n7\n2\n8\nhello\n17\n";
    testing::assert_eq(execute_go(generated, expected, "deferred_dependency", 0, 0), expected);
}
