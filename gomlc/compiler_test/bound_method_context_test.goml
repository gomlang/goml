package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn bound_method_overloads_execute_selected_implementations() -> () {
    let source =
        \\trait First { fn make(self: Self) -> i32; fn convert(self: Self, value: i32) -> i32; fn label() -> i32; }
        \\trait Second { fn make(self: Self) -> string; fn convert(self: Self, value: bool) -> i32; fn label() -> string; }
        \\impl First for bool {
        \\    fn make(self: bool) -> i32 { 7 }
        \\    fn convert(self: bool, value: i32) -> i32 { value + 1 }
        \\    fn label() -> i32 { 9 }
        \\}
        \\impl Second for bool {
        \\    fn make(self: bool) -> string { "second" }
        \\    fn convert(self: bool, value: bool) -> i32 { 8 }
        \\    fn label() -> string { "label" }
        \\}
        \\fn number[T: First + Second](value: T) -> i32 { value.make() }
        \\fn text[T: First + Second](value: T) -> string { value.make() }
        \\fn integer_arg[T: First + Second](value: T) -> i32 { value.convert(5) }
        \\fn boolean_arg[T: First + Second](value: T) -> i32 { value.convert(true) }
        \\fn label[T: First + Second]() -> i32 { T::label() }
        \\fn main() -> () { println(number(true)); println(text(true)); println(integer_arg(true)); println(boolean_arg(true)); println(label::[bool]()); }
    ;
    let compilation = compiler_driver::compile_source("bound_method_context.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\nsecond\n6\n8\n9\n";
    testing::assert_eq(execute_go(generated, expected, "bound_method_context", 0, 0), expected);
}
