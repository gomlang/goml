package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn never_operator_operands_preserve_evaluation_order() -> () {
    let source =
        \\#[comptime]
        \\fn right() -> i32 { 1 + (return 2) }
        \\fn left() -> i32 { (return 3) + 1 }
        \\#[comptime]
        \\fn negated() -> i32 { -(return 4) }
        \\fn complement() -> i32 { ~(return 5) }
        \\fn equal() -> bool { (return true) == true }
        \\fn shifted() -> i32 { (return 6) << 1 }
        \\fn side() -> i32 { println("side"); 1 }
        \\fn ordered() -> i32 { side() + (return 7) }
        \\fn skipped() -> i32 { (return 8) + side() }
        \\fn short() -> bool { false && (return true) }
        \\fn both() -> i32 { (return 9) + (return 10) }
        \\fn main() -> () {
        \\    println(right());
        \\    println(left());
        \\    println(negated());
        \\    println(complement());
        \\    println(equal());
        \\    println(shifted());
        \\    println(ordered());
        \\    println(skipped());
        \\    println(short());
        \\    println(both());
        \\    println(comptime { right() });
        \\    println(comptime { negated() });
        \\}
    ;
    let compilation = compiler_driver::compile_source("never_operator_operands.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "2\n3\n4\n5\ntrue\n6\nside\n7\n8\nfalse\n9\n2\n4\n";
    testing::assert_eq(execute_go(generated, expected, "never_operator_operands", 0, 0), expected);
}
