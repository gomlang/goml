package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn divergent_conversions_preserve_evaluation_order() -> () {
    let source =
        \\trait Read { fn read(self: Self) -> i32; }
        \\fn prefix() -> i32 { println("prefix"); 1 }
        \\fn suffix() -> i32 { println("unexpected"); 2 }
        \\fn interpolate() -> i32 { f"{prefix()}{(return 7)}{suffix()}" }
        \\fn dynamic() -> i32 { (return 8) as dyn Read }
        \\#[comptime]
        \\fn literal() -> i32 { f"{(return 9)}" }
        \\const VALUE: i32 = literal();
        \\fn main() -> () { println(interpolate()); println(dynamic()); println(VALUE); }
    ;
    let compilation = compiler_driver::compile_source("never_conversion.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "prefix\n7\n8\n9\n";
    testing::assert_eq(execute_go(generated, expected, "never_conversion", 0, 0), expected);
}
