package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn dyn_dispatch_preserves_captured_method_evidence() -> () {
    let source = "trait Extra { fn extra(self) -> i32; } trait Main { fn run(self) -> i32 where Self: Extra; } trait Child: Main {} impl Extra for bool { fn extra(self) -> i32 { 7 } } impl Main for bool { fn run(self) -> i32 where Self: Extra { self.extra() } } impl Child for bool {} trait Fixed { fn fixed(self) -> i32 where Self = bool; } impl Fixed for bool { fn fixed(self) -> i32 where Self = bool { 9 } } fn main() { let value = true as dyn Main; println(value.run()); println(Main::run(value)); let run = Main::run; println(run(value)); let child = true as dyn Child; println(child.run()); let fixed = true as dyn Fixed; println(fixed.fixed()); println(Fixed::fixed(fixed)); let method = Fixed::fixed; println(method(fixed)); }";
    let compilation = compiler_driver::compile_source("dyn_method_evidence.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "7\n7\n7\n7\n9\n9\n9\n";
    testing::assert_eq(execute_go(generated, expected, "dyn_method_evidence", 0, 0), expected);
}
