package compiler_test;

use module::compiler as compiler_driver;
use module::go_backend;
use std::testing;

#[test]
fn body_constant_requirements_preserve_valid_specializations() -> () {
    let source = "struct Hidden[const N: usize] { data: [i32; N - 1] } fn create[const N: usize]() -> () { let value: Option[Hidden[N]] = None; println(N); } fn forward[const N: usize]() -> () { let call = create::[N]; call(); } fn main() -> () { forward::[1](); let call = forward::[2]; call(); }";
    let compilation = compiler_driver::compile_source("const_valid_predicate.goml", source);
    let generated = go_backend::encode(compilation.go_value);
    let expected = "1\n2\n";
    testing::assert_eq(execute_go(generated, expected, "const_valid_predicate", 0, 0), expected);
}
