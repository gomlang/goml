package checker;

use module::tast::{AssociatedTypeInfo, TraitInfo, TraitMethodInfo, TraitRef, Type, TypePredicate};

fn trait_signature_projection_scope(info: TraitInfo) -> Vec[TypePredicate] {
    let args: Vec[Type] = Vec::new();
    for generic in info.generics {
        args.push(Type::Param { name: generic })
    }
    append_predicates(
        info.predicates,
        Vec::from_array(
            [
                TypePredicate::Trait {
                    for_ty: Type::Param { name: "Self" },
                    trait_ref: TraitRef { name: info.name, args },
                },
            ],
        ),
    )
}

fn resolve_trait_signature_projections(ctx: Checker, info: TraitInfo, report: bool) -> TraitInfo {
    let scope = trait_signature_projection_scope(info);
    let ctx = projection_resolution_context(ctx, scope);
    let candidates = projection_candidates_from_predicates(
        ctx,
        expand_implied_predicates(ctx, scope),
    );
    let predicates = resolve_projection_predicates(ctx, info.predicates, candidates, report);
    let supertraits: Vec[TraitRef] = Vec::new();
    for reference in info.supertraits {
        supertraits.push(resolve_projection_trait_ref(ctx, reference, candidates, report))
    }
    let associated_types: Vec[AssociatedTypeInfo] = Vec::new();
    for associated in info.associated_types {
        let bounds: Vec[TraitRef] = Vec::new();
        for reference in associated.bounds {
            bounds.push(resolve_projection_trait_ref(ctx, reference, candidates, report))
        }
        associated_types.push(AssociatedTypeInfo { name: associated.name, bounds })
    }
    let methods: Vec[TraitMethodInfo] = Vec::new();
    for method in info.methods {
        let ctx = projection_resolution_context(ctx, method.predicates);
        let candidates = projection_candidates_from_predicates(
            ctx,
            expand_implied_predicates(ctx, append_predicates(scope, method.predicates)),
        );
        methods.push(
            TraitMethodInfo {
                predicates: resolve_projection_predicates(
                    ctx,
                    method.predicates,
                    candidates,
                    report,
                ),
                params: resolve_projection_types(ctx, method.params, candidates, report),
                ret_ty: resolve_projection_type(ctx, method.ret_ty, candidates, report),
                ..method,
            },
        )
    }
    TraitInfo { predicates, supertraits, associated_types, methods, ..info }
}
