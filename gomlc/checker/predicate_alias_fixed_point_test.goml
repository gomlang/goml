package checker;

use std::testing;

#[test]
fn parameter_and_projection_equalities_reach_a_joint_fixed_point() -> () {
    for predicates in[
        "T = Vec[A::Item], T = Vec[i32]",
        "T = Vec[i32], T = Vec[A::Item]",
        "Vec[A::Item] = T, Vec[i32] = T",
        "T = U, U = Vec[A::Item], T = Vec[i32]",
        "T = Vec[A::Item], T = Vec[U], U = i32",
        "U = i32, T = Vec[A::Item], T = Vec[U]",
        "T = (A::Item, bool), T = (i32, bool)",
        "T = (bool) -> A::Item, T = (bool) -> i32",
        "T = Option[Vec[A::Item]], T = Option[Vec[i32]]",
        "A::Item = T, T = i32",
        "T = i32, A::Item = T",
    ] {
        let _ = checked_file(
            "trait Source { type Item; } fn convert[T, U, A: Source](value: A::Item) -> i32 where "
                + predicates
                + " { value }",
        );
    }
}

#[test]
fn joint_equality_aliases_preserve_unrelated_types_and_conflicts() -> () {
    for predicates in["T = Vec[A::Item], U = Vec[i32]", "T = Vec[A::Item], T = Option[i32]"] {
        testing::assert(
            !checked_diagnostics(
                "trait Source { type Item; } fn convert[T, U, A: Source](value: A::Item) -> i32 where "
                    + predicates
                    + " { value }",
            ).is_empty(),
        );
    }
}
