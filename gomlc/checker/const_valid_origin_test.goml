package checker;

use module::ast;
use module::hir;
use module::parser;
use module::tast;
use std::testing;

fn checked_const_origins(source_path: string) -> Vec[string] {
    let source = "package value; pub fn create[const N: usize]() -> () { let value: Option[[i32; N - 1]] = None; }";
    let checked = check(
        hir::lower_package(ast::lower(parser::parse(source)), source_path, "audit::value"),
    );
    testing::assert(checked.diagnostics.is_empty());
    let file = testing::expect_some(checked.tast, "typed file");
    let origins: Vec[string] = Vec::new();
    for item in file.items {
        if let tast::Item::Function(function) = item {
            for predicate in function.predicates {
                if let tast::TypePredicate::ConstValid { origins: values, .. } = predicate {
                    for origin in values {
                        origins.push(origin);
                    }
                }
            }
        }
    }
    origins
}

#[test]
fn constant_obligation_origins_are_stable_when_sources_are_relocated() -> () {
    let first = checked_const_origins("/tmp/checkout-one/pkg/value.goml");
    let relocated = checked_const_origins("/other/worktree/pkg/value.goml");
    let renamed = checked_const_origins("/tmp/checkout-one/pkg/other.goml");
    testing::assert(!first.is_empty());
    testing::assert_eq(first.len(), relocated.len());
    for index in 0..first.len() {
        testing::assert_eq(first[index], relocated[index]);
        testing::assert(!first[index].contains("/"));
    }
    testing::assert(!renamed.is_empty());
    testing::assert(first[0] != renamed[0]);
}
