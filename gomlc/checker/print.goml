package checker;

use module::pretty;
use module::tast::{encode_file};

pub fn encode(value: CheckResult) -> string {
    match value.tast {
        Some(file) => encode_file(file),
        None => {
            let values: Vec[pretty::Doc] = Vec::with_capacity(value.diagnostics.len());
            for diagnostic in value.diagnostics {
                values.push(pretty::append(pretty::text(diagnostic.message), pretty::hardline()))
            }
            pretty::layout(pretty::concat(values))
        },
    }
}
