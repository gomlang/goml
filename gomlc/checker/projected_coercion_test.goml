package checker;

use std::testing;

#[test]
fn projected_arguments_wait_for_later_owner_inference() -> () {
    for pair in[("i32", "7"), ("string", "\"ok\""), ("bool", "false"), ("f32", "1.25")] {
        let _ = checked_file(
            "trait Source { type Item; } impl Source for bool { type Item = " + pair.0
                + "; } fn choose[T: Source](item: T::Item, owner: T) -> T::Item { item } fn main() -> () { let result: "
                + pair.0
                + " = choose("
                + pair.1
                + ", true); }",
        );
    }
}

#[test]
fn projected_coercions_infer_compound_siblings_and_chains() -> () {
    for source in[
        "trait Source { type Item; } impl Source for bool { type Item = i32; } fn choose[T: Source](items: (T::Item, T)) -> T::Item { items.0 } fn main() -> () { let result: i32 = choose((7, true)); }",
        "trait Source { type Item; } impl Source for bool { type Item = i32; } fn choose[T: Source](items: [T::Item; 2], owner: T) -> T::Item { items[0] } fn main() -> () { let result: i32 = choose([7, 8], true); }",
        "trait Source { type Item; } impl Source for bool { type Item = i32; } fn choose[T: Source](item: T::Item, owner: T) -> T::Item { item } fn main() -> () { let call = |owner| choose(7, owner); let result: i32 = call(true); }",
        "trait Source { type Item; } impl Source for bool { type Item = i32; } impl Source for string { type Item = bool; } fn choose[A: Source, B: Source](item: A::Item, first: A, second: B::Item, owner: B) -> A::Item { item } fn main() -> () { let call = |value| choose(7, value, value, \"owner\"); let result: i32 = call(true); }",
        "trait Source { type Item; } impl Source for bool { type Item = i32; } fn choose[T: Source](call: () -> T::Item, owner: T) -> T::Item { call() } fn main() -> () { let result: i32 = choose(|| 7, true); }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn projected_coercions_preserve_concrete_and_numeric_errors() -> () {
    for source in[
        "trait Source { type Item; } impl Source for bool { type Item = i32; } fn choose[T: Source](item: T::Item, owner: T) -> T::Item { item } fn main() -> () { choose(\"wrong\", true); }",
        "trait Source { type Item; } impl Source for bool { type Item = u8; } fn choose[T: Source](item: T::Item, owner: T) -> T::Item { item } fn main() -> () { choose(256, true); }",
        "trait Source { type Item; } impl Source for bool { type Item = u8; } fn choose[T: Source](item: T::Item, owner: T) -> T::Item { item } fn main() -> () { choose(-1, true); }",
        "trait Source { type Item; } impl Source for bool { type Item = i32; } fn choose[T: Source](item: T::Item, owner: T) -> T::Item { item } fn main() -> () { choose(1.5, true); }",
        "trait Source { type Item; } impl Source for bool { type Item = i32; } fn choose[T: Source](items: (T::Item, T)) -> T::Item { items.0 } fn main() -> () { choose((\"wrong\", true)); }",
        "trait Source { type Item; } impl Source for bool { type Item = i32; } impl Source for string { type Item = i32; } fn choose[T: Source](item: T::Item, owner: T) -> T::Item { item } fn main() -> () { let call = |owner| choose(7, owner); }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}
