package checker;

use module::ast;
use module::hir;
use module::parser;
use module::resources;
use module::tast;

fn lower_toolchain_hir_files(sources: Vec[resources::Source], package_name: string) -> Result[
    Vec[hir::File],
    string,
] {
    let inputs: Vec[(ast::LowerResult, string)] = Vec::new();
    for source in sources {
        inputs.push((ast::lower(parser::parse(source.source)), source.path))
    }
    let files: Vec[hir::File] = Vec::new();
    for lowered in hir::lower_package_files(inputs, package_name) {
        match lowered.hir {
            Some(file) => files.push(file),
            None => return Err("failed to lower " + package_name + " source " + lowered.source_path),
        }
    }
    Ok(files)
}

pub fn check_builtin_sources() -> Result[tast::File, string] {
    let files = lower_toolchain_hir_files(resources::builtin_layer_sources()?, "builtin")?;
    let checked = check_builtin_package_files(files);
    if diagnostics_have_errors(checked.diagnostics) {
        return Err("failed to typecheck builtin package")
    }
    checked.tast.ok_or("failed to typecheck builtin package")
}

pub fn check_prelude_sources() -> Result[tast::File, string] {
    let builtins = lower_toolchain_hir_files(resources::builtin_layer_sources()?, "builtin")?;
    let prelude = lower_toolchain_hir_files(resources::prelude_sources()?, "prelude")?;
    let checked = check_package_files_for_link_with_dependencies(prelude, builtins);
    if diagnostics_have_errors(checked.diagnostics) {
        return Err("failed to typecheck prelude package")
    }
    checked.tast.ok_or("failed to typecheck prelude package")
}
