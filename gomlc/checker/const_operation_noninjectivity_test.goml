package checker;

use std::testing;

#[test]
fn constant_operation_equalities_do_not_equate_their_operands() -> () {
    for expression in["N * 0", "N % 2", "N & 0", "N | 3", "N >> 1"] {
        let other = expression.replace("N", "M");
        let source = "fn convert[const N: usize, const M: usize](value: [i32; N]) -> [i32; M] where [i32; "
            + expression
            + "] = [i32; "
            + other
            + "] { value }";
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}

#[test]
fn constant_operation_equalities_preserve_array_element_information() -> () {
    let _ = checked_file(
        "fn convert[T, const N: usize, const M: usize](value: T) -> i32 where [T; N * 0] = [i32; M * 0] { value } fn main() -> () { println(convert::[i32, 1, 2](7)); }",
    );
    let _ = checked_file(
        "trait Source { type Item; } fn convert[T: Source, const N: usize, const M: usize](value: T::Item) -> i32 where [T::Item; N * 0] = [i32; M * 0] { value }",
    );
    let _ = checked_file(
        "fn copy[const N: usize](value: [i32; N + 1]) -> [i32; N + 1] { value } fn main() -> () { let value: [i32; 2] = copy::[1]([1, 2]); }",
    );
}

#[test]
fn constant_operations_do_not_constrain_impl_parameters() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "trait Number {} struct Wrap[const N: usize] {} impl[const N: usize] Number for Wrap[{N * 0}] {}",
            ),
            "is not constrained",
        ),
    );
    let _ = checked_file(
        "trait Number {} struct Wrap[const N: usize] {} impl[const N: usize] Number for Wrap[N] {}",
    );
}

#[test]
fn constant_operation_equalities_apply_to_the_complete_expression() -> () {
    let _ = checked_file(
        "fn convert[const N: usize, const M: usize](value: [i32; N * 0]) -> [i32; M * 0] where [i32; N * 0] = [i32; M * 0] { value } fn main() -> () { let result: [i32; 0] = convert::[1, 2]([]); }",
    );
}

#[test]
fn nested_constant_operation_equalities_do_not_form_recursive_types() -> () {
    for equality in["[i32; N + 1] = [i32; {(N + 1) + 0}]", "[i32; {(N + 1) + 0}] = [i32; N + 1]"] {
        let _ = checked_file(
            "fn identity[const N: usize](value: [i32; N + 1]) -> [i32; {(N + 1) + 0}] where "
                + equality
                + " { value } fn main() -> () { let value: [i32; 2] = identity::[1]([7, 8]); }",
        );
    }
    for equality in["[i32; N + 1] = [i32; {(N + 1) + 1}]", "[i32; {(N + 1) + 1}] = [i32; N + 1]"] {
        testing::assert(
            !checked_diagnostics(
                "fn impossible[const N: usize](value: [i32; N + 1]) -> [i32; {(N + 1) + 1}] where "
                    + equality
                    + " { value } fn main() -> () { let value: [i32; 3] = impossible::[1]([7, 8]); }",
            ).is_empty(),
        );
    }
}
