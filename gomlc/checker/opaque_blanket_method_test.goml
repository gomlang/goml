package checker;

use std::testing;

#[test]
fn opaque_methods_use_blanket_implementations_from_exposed_bounds() -> () {
    opaque_return_accepts(
        "trait Read { fn read(self) -> i32; } impl Read for bool { fn read(self) -> i32 { 7 } } trait Extra { fn extra(self) -> i32; } impl[T: Read] Extra for T { fn extra(self) -> i32 { self.read() } } fn make() -> impl Read { true } fn result() -> i32 { make().extra() }",
    );
    opaque_return_accepts(
        "trait Source { type Item; fn get(self) -> Self::Item; } impl Source for bool { type Item = i32; fn get(self) -> i32 { 7 } } trait Extra { fn extra(self) -> i32; } impl[T: Source] Extra for T where T::Item = i32 { fn extra(self) -> i32 { self.get() } } fn make() -> impl Source[Item = i32] { true } fn result() -> i32 { make().extra() }",
    );
}

#[test]
fn opaque_blanket_methods_do_not_expose_hidden_implementations() -> () {
    let prefix = "trait Read { fn read(self) -> i32; } impl Read for bool { fn read(self) -> i32 { 7 } } trait Secret {} impl Secret for bool {} trait Extra { fn extra(self) -> i32; } fn make() -> impl Read { true } ";
    for implementation in[
        "impl Extra for bool { fn extra(self) -> i32 { 9 } }",
        "impl[T: Secret] Extra for T { fn extra(self) -> i32 { 9 } }",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(
                    prefix + implementation + " fn result() -> i32 { make().extra() }",
                ),
                "Method extra not found",
            ),
        );
    }
}

#[test]
fn dyn_methods_use_blanket_implementations_from_exposed_bounds() -> () {
    opaque_return_accepts(
        "trait Read { fn read(self) -> i32; } impl Read for bool { fn read(self) -> i32 { 7 } } trait Extra { fn extra(self) -> i32; } impl[T: Read] Extra for T { fn extra(self) -> i32 { self.read() } } fn result(value: dyn Read) -> i32 { value.extra() }",
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "trait Read {} trait Secret {} trait Extra { fn extra(self) -> i32; } impl[T: Secret] Extra for T { fn extra(self) -> i32 { 7 } } fn result(value: dyn Read) -> i32 { value.extra() }",
            ),
            "Method extra not found",
        ),
    );
}
