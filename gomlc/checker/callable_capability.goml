package checker;

use module::derive;
use module::tast::{Callable, ComptimeCapability, FunctionScheme};

fn validate_callable_capability(ctx: Checker, value: FunctionScheme) -> () {
    if let Derive = value.comptime {
        match ctx.comptime_capability {
            Derive => (),
            _ => push_diagnostic(
                ctx,
                "#[comptime_derive] function is only callable from another derive handler",
            ),
        }
    }
    match value.callable {
        Intrinsic("compile_error") => if ctx.comptime_depth.get() == 0 {
            push_diagnostic(ctx, "compile_error is only available in comptime");
        },
        Intrinsic(name) => if derive::is_intrinsic(name) {
            match ctx.comptime_capability {
                Derive => (),
                _ => push_diagnostic(
                    ctx,
                    "derive intrinsic `" + name + "` is only available in #[comptime_derive]",
                ),
            }
        },
        _ => (),
    }
}
