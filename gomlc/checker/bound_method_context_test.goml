package checker;

use std::testing;

#[test]
fn bound_methods_use_argument_and_result_context() -> () {
    for source in[
        "trait First { fn make(self: Self) -> i32; } trait Second { fn make(self: Self) -> string; } fn choose[T: First + Second](value: T) -> i32 { value.make() }",
        "trait First { fn make(self: Self, input: i32) -> i32; } trait Second { fn make(self: Self, input: bool) -> i32; } fn choose[T: First + Second](value: T) -> i32 { value.make(7) }",
        "trait First { fn make() -> i32; } trait Second { fn make() -> string; } fn choose[T: First + Second]() -> i32 { T::make() }",
        "trait First { fn make[U](self: Self, input: U) -> i32; } trait Second { fn make(self: Self, input: bool) -> string; } fn choose[T: First + Second](value: T) -> i32 { value.make::[i32](7) }",
        "trait First { fn make(self: Self) -> never; } trait Second { fn make(self: Self) -> string; } fn choose[T: First + Second](value: T) -> i32 { value.make() }",
        "trait First { fn make[U](self: Self) -> U where U = i32; } trait Second { fn make[U](self: Self) -> U where U = string; } fn choose[T: First + Second](value: T) -> i32 { value.make() }",
    ] {
        let diagnostics = checked_diagnostics(source);
        if !diagnostics.is_empty() {
            testing::fail(source)
        }
    }
}

#[test]
fn bound_method_filtering_preserves_ambiguity_and_selected_diagnostics() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "trait First { fn make(self: Self) -> i32; } trait Second { fn make(self: Self) -> i32; } fn choose[T: First + Second](value: T) -> i32 { value.make() }",
            ),
            "Ambiguous method",
        ),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "trait First { fn make[U](self: Self, input: U) -> i32; } trait Second { fn make(self: Self, input: bool) -> string; } fn choose[T: First + Second](value: T) -> string { value.make::[i32](true) }",
            ),
            "expects 0 method type arguments",
        ),
    );
}
