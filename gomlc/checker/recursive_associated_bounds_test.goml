package checker;

use std::testing;

#[test]
fn recursive_associated_bounds_support_finite_projection_queries() -> () {
    for source in[
        "trait Node { type Next: Node; } impl Node for isize { type Next = isize; } fn identity[T: Node](value: T) -> T { value } fn main() -> () { let _ = identity(7); }",
        "trait Node { type Next: Node; fn read(self: Self) -> isize; } fn read[T: Node](value: T::Next::Next::Next) -> isize { value.read() }",
        "trait Node[A] { type Next: Node[A]; fn read(self: Self) -> A; } fn read[A, T: Node[A]](value: T::Next::Next::Next) -> A { value.read() }",
        "trait Left { type Next: Right; } trait Right { type Next: Left; fn read(self: Self) -> isize; } fn read[T: Left](value: T::Next::Next::Next) -> isize { value.read() }",
        "trait Node { type Next: Node; } fn require[T: Node](value: T) -> () {} fn forward[T: Node](value: T::Next::Next::Next) -> () { require(value) }",
    ] {
        let _ = checked_file(source);
    }
    let mut projection = "T";
    for _ in 0..20 {
        projection += "::Next";
    }
    let _ = checked_file(
        "trait Node { type Next: Node; fn read(self: Self) -> isize; } fn read[T: Node](value: "
            + projection
            + ") -> isize { value.read() }",
    );
}

#[test]
fn recursive_associated_bounds_do_not_invent_constraints() -> () {
    for source in[
        "trait Node { type Next: Node; } fn invalid[T: Node](value: T::Next::Next::Missing) -> () {}",
        "trait Node { type Next: Node; } trait Other {} fn require[T: Other](value: T) -> () {} fn invalid[T: Node](value: T::Next::Next::Next) -> () { require(value) }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}
