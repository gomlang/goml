package checker;

use module::tast::{Type};
use std::testing;

#[test]
fn expanding_enum_map_requirements_stop_before_substitution_growth() -> () {
    for source in[
        "enum Key[T] { Empty, Data(T) } struct Node[T] { next: Ref[Node[(T, T)]], values: GoMap[Key[T], i32] } fn main() -> () {}",
        "enum Key[T] { Empty, Data(T) } enum Node[T] { Empty, Next(Ref[Node[(T, T)]], GoMap[Key[T], i32]) } fn main() -> () {}",
    ] {
        let diagnostics = checked_diagnostics(source);
        if !has_diagnostic_containing(
            diagnostics,
            "Go map type requirement exceeds the 4096-node or 128-level expression limit",
        ) {
            let mut detail = source;
            for diagnostic in diagnostics {
                detail = detail + "\n" + diagnostic.message;
            }
            testing::fail("Expected bounded map requirement diagnostic: " + detail);
        }
    }
}

#[test]
fn bounded_map_requirements_keep_finite_and_stable_recursive_layouts() -> () {
    for source in[
        "enum Key[T] { Empty, Data(T) } struct Node[T] { next: Option[Ref[Node[T]]], values: GoMap[Key[T], i32] } fn main() -> () {}",
        "struct Wrap[T] { value: T } enum Key[T] { Empty, Data(T) } pub fn accept(value: GoMap[Key[Wrap[Wrap[i32]]], i32]) -> () {}",
        "struct Wrap[T] { value: T } enum Key[T] { Empty, Data(T) } pub fn accept(value: GoMap[Key[Wrap[Wrap[Slice[i32]]]], i32]) -> () {}",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn requirement_budget_measures_substitution_without_materializing_it() -> () {
    let parameter = Type::Param { name: "T" };
    let parameters = Vec::from_array(["T"]);
    let mut repeated = parameter;
    for _ in 0..10 {
        repeated = Type::Tuple { items: Vec::from_array([repeated, repeated]) };
    }
    testing::assert(
        type_requirement_substitution_allowed(repeated, parameters, Vec::from_array([Type::Int32])),
    );
    let pair = Type::Tuple { items: Vec::from_array([Type::Int32, Type::Int32]) };
    testing::assert(
        type_requirement_substitution_allowed(repeated, parameters, Vec::from_array([pair])),
    );
    let triple = Type::Tuple { items: Vec::from_array([Type::Int32, Type::Int32, Type::Int32]) };
    testing::assert(
        !type_requirement_substitution_allowed(repeated, parameters, Vec::from_array([triple])),
    );
}
