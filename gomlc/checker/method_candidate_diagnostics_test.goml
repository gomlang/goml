package checker;

use std::testing;

#[test]
fn rejected_method_candidates_do_not_leak_generic_argument_diagnostics() -> () {
    for source in[
        "trait Left {} trait Right {} impl Left for i32 {} impl Right for bool {} trait First { fn score[const N: usize](self: Self) -> usize; } trait Second { fn score(self: Self) -> usize; } struct Wrap[T] { value: T } impl[T: Left] First for Wrap[T] { fn score[const N: usize](self: Wrap[T]) -> usize { N } } impl[T: Right] Second for Wrap[T] { fn score(self: Wrap[T]) -> usize { 2 } } fn main() -> () { let value: Wrap[i32] = Wrap { value: 7 }; let _: usize = value.score::[7](); let _: usize = Wrap::[i32]::score::[8](value); let f = Wrap::[i32]::score::[9]; let _: usize = f(value); }",
        "trait Left {} trait Right {} impl Left for i32 {} impl Right for bool {} trait First { fn score[const N: usize](self: Self) -> usize; } trait Second { fn score(self: Self) -> usize; } struct Wrap[T] { value: T } impl[T: Right] Second for Wrap[T] { fn score(self: Wrap[T]) -> usize { 2 } } impl[T: Left] First for Wrap[T] { fn score[const N: usize](self: Wrap[T]) -> usize { N } } fn main() -> () { let value: Wrap[i32] = Wrap { value: 7 }; let _: usize = value.score::[7](); let _: usize = Wrap::[i32]::score::[8](value); let f = Wrap::[i32]::score::[9]; let _: usize = f(value); }",
        "trait Left {} trait Right {} impl Left for i32 {} impl Right for bool {} trait First { fn score[const N: usize](self: Self) -> usize; } trait Second { fn score[U](self: Self) -> usize; } struct Wrap[T] { value: T } impl[T: Right] Second for Wrap[T] { fn score[U](self: Wrap[T]) -> usize { 2 } } impl[T: Left] First for Wrap[T] { fn score[const N: usize](self: Wrap[T]) -> usize { N } } fn main() -> () { let value: Wrap[i32] = Wrap { value: 7 }; let _: usize = value.score::[7](); let _: usize = Wrap::[i32]::score::[8](value); let f = Wrap::[i32]::score::[9]; let _: usize = f(value); }",
    ] {
        let _ = checked_file(source);
    }
    for source in[
        "trait Left {} trait Right {} impl Left for i32 {} impl Right for bool {} trait First { fn score[const N: usize](self: Self) -> usize; } trait Second { fn score(self: Self) -> usize; } struct Wrap[T] { value: T } impl[T: Left] First for Wrap[T] { fn score[const N: usize](self: Wrap[T]) -> usize { N } } impl[T: Right] Second for Wrap[T] { fn score(self: Wrap[T]) -> usize { 2 } } fn main() -> () { let value: Wrap[i32] = Wrap { value: 7 }; let _ = value.score::[7, 8](); }",
        "trait Left {} trait Right {} impl Left for i32 {} impl Right for bool {} trait First { fn score[const N: usize](self: Self) -> usize; } trait Second { fn score(self: Self) -> usize; } struct Wrap[T] { value: T } impl[T: Left] First for Wrap[T] { fn score[const N: usize](self: Wrap[T]) -> usize { N } } impl[T: Right] Second for Wrap[T] { fn score(self: Wrap[T]) -> usize { 2 } } fn main() -> () { let value: Wrap[i32] = Wrap { value: 7 }; let _ = value.score::[bool](); }",
        "trait Left {} trait Right {} impl Left for i32 {} impl Right for bool {} trait First { fn score[const N: usize](self: Self) -> usize; } trait Second { fn score(self: Self) -> usize; } struct Wrap[T] { value: T } impl[T: Left] First for Wrap[T] { fn score[const N: usize](self: Wrap[T]) -> usize { N } } impl[T: Right] Second for Wrap[T] { fn score(self: Wrap[T]) -> usize { 2 } } fn main() -> () { let value = Wrap { value: true }; let _ = value.score::[7](); }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}
