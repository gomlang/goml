package checker;

use std::testing;

#[test]
fn growing_supertrait_cycles_report_diagnostics_without_expanding_forever() -> () {
    for source in[
        "trait Loop[T]: Loop[Vec[T]] {} fn require[U: Loop[i32]](value: U) -> () {}",
        "trait First[T]: Second[Vec[T]] {} trait Second[T]: First[Option[T]] {} fn require[U: First[i32]](value: U) -> () {}",
        "trait Loop[const N: usize]: Loop[{N + 1}] {} fn require[U: Loop[0]](value: U) -> () {}",
        "trait Loop[T]: Loop[(T, T)] {} fn require(value: dyn Loop[i32]) -> () {}",
    ] {
        testing::assert(
            has_diagnostic_containing(checked_diagnostics(source), "Supertrait cycle detected"),
        );
    }
}

#[test]
fn acyclic_supertrait_diamonds_preserve_distinct_generic_applications() -> () {
    let _ = checked_file(
        "trait Root[T] {} trait Left: Root[i32] {} trait Right: Root[string] {} trait Both: Left + Right {} fn accept_number[T: Root[i32]](value: T) -> () {} fn accept_text[T: Root[string]](value: T) -> () {} fn require[T: Both](value: T) -> () { accept_number(value); accept_text(value); }",
    );
    let _ = checked_file(
        "trait Root[T] {} trait Parent[T]: Root[Vec[T]] {} trait Child[T]: Parent[Option[T]] {} fn accept[T: Root[Vec[Option[i32]]]](value: T) -> () {} fn require[T: Child[i32]](value: T) -> () { accept(value); }",
    );
}
