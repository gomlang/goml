package checker;

use module::consts;
use module::hir;
use module::tast::{Callable, Expr, Type, TypeSubst, const_type_value, prune};

fn const_argument(value: Type) -> bool {
    match prune(value) {
        Con { name } => consts::value_number(name).is_some() || name.starts_with("$const_name:"),
        Param { name } => consts::parameter_name(name).is_some(),
        App { ty, args: _ } => match ty {
            Con { name } => name.starts_with("$const_op:"),
            _ => false,
        },
        Var(_) | Error => true,
        _ => false,
    }
}

fn const_operation_error(value: Type) -> Option[string] {
    if let App { ty: Con { name }, args } = prune(value) {
        if name.starts_with("$const_op:") && args.len() == 2 {
            for argument in args {
                if let Some(error) = const_operation_error(argument) {
                    return Some(error)
                }
            }
            if let (Some(left), Some(right)) = (
                const_type_value(args[0]),
                const_type_value(args[1]),
            ) {
                if let Err(message) = consts::binary(
                    name.byte_slice(10, name.byte_len()),
                    left,
                    right,
                ) {
                    return Some(message)
                }
            }
        }
    }
    None
}

fn validate_const_argument(ctx: Checker, value: Type) -> () {
    if let Some(error) = const_operation_error(value) {
        push_diagnostic(ctx, error)
    }
    if !const_argument(value) {
        push_diagnostic(ctx, "const generic argument must be an integer constant")
    }
    if let Some(number) = const_type_value(value) {
        if number < 0 {
            push_diagnostic(ctx, "const usize argument must be nonnegative")
        }
    }
}

fn validate_generic_arguments(ctx: Checker, params: Vec[string], args: Vec[Type]) -> () {
    for index in 0..args.len() {
        if index < params.len() && consts::parameter_name(params[index]).is_some() {
            validate_const_argument(ctx, args[index])
        } else {
            validate_signature_type(ctx, args[index])
        }
    }
}

fn nominal_parameters(ctx: Checker, name: string) -> Vec[string] {
    if let Some(info) = find_struct_by_name(ctx, name) {
        return info.generics
    }
    if let Some(info) = find_enum_by_name(ctx, name) {
        return info.generics
    }
    if let Some(info) = find_type_alias(ctx, name) {
        return info.generics
    }
    if let Some(info) = find_trait(ctx, name) {
        return info.generics
    }
    Vec::new()
}

fn associated_constant_value(
    ctx: Checker,
    owner: string,
    member: string,
    owner_args: Vec[hir::GenericArg],
) -> Option[Expr] {
    if member.byte_len() == 0 {
        return None
    }
    let name = "$associated_const:" + member;
    let callable = resolve_static_member(ctx, owner, name, owner_args, Vec::new(), Option::None)?;
    require_predicates(ctx, callable.predicates);
    let ret_ty = match prune(callable.ty) {
        Func { ret_ty, .. } => ret_ty,
        _ => Type::Error,
    };
    Some(
        Call {
            func: Expr::Callable { callable: callable.callable, ty: callable.ty },
            args: Vec::new(),
            ty: ret_ty,
        },
    )
}

fn associated_constant_default_callable(method: string, name: string, substitutions: Vec[TypeSubst]) -> Callable {
    if !method.starts_with("$associated_const:") {
        return Callable::Function(name)
    }
    let bindings: Vec[(string, Type)] = Vec::new();
    for value in substitutions {
        bindings.push((value.name, value.ty))
    }
    FunctionInstance { name, bindings }
}
