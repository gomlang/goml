package checker;

use std::testing;

#[test]
fn diverging_break_values_do_not_make_loops_return() -> () {
    for source in[
        "fn stop() -> never { loop {} } fn f() -> i32 { loop { break stop(); }; }",
        "fn f() -> i32 { loop { break return 7; }; }",
        "fn f() -> i32 { loop { break continue; }; }",
        "fn f[T](exit: T) -> i32 where T = never { loop { break exit; }; }",
        "fn f() -> i32 { 'outer: loop { loop { break 'outer return 7; } }; }",
        "fn f() -> i32 { loop { break { let _ = return 7; }; }; }",
        "fn f(flag: bool) -> i32 { loop { if flag { break return 7; } else { break 8; } } }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn unreachable_breaks_do_not_make_enclosing_loops_return() -> () {
    for source in[
        "fn f() -> i32 { loop { return 42; break; }; }",
        "fn f() -> i32 { loop { return 42; break; } }",
        "fn f() -> i32 { 'outer: loop { loop { return 42; break 'outer; } } }",
        "fn f() -> never { loop { continue; break; } }",
        "fn f() -> i32 { 'outer: loop { loop { return 42; break 'outer; } }; }",
        "fn f() -> i32 { loop { return 42; break }; }",
    ] {
        assert_single_unreachable_code_warning("unreachable break", checked_diagnostics(source));
    }
}

#[test]
fn reachable_break_values_still_determine_loop_results() -> () {
    for source in[
        "fn f() -> i32 { loop { break 7; }; }",
        "fn f(flag: bool) -> i32 { loop { if flag { break return 7; } else { break; } }; }",
        "fn f(flag: bool) -> i32 { loop { if flag { break return 7; } else { break false; } } }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}

#[test]
fn unreachable_bare_breaks_must_agree_with_valued_breaks() -> () {
    for source in[
        "fn f(x: bool) -> i32 { loop { if x { return 42; break; } break 1; } }",
        "fn f(x: bool) -> i32 { loop { if x { break 1; } return 42; break; } }",
        "fn f() -> i32 { loop { return 42; break; break 1; } }",
        "fn f() -> i32 { loop { return 42; break (1 + false); break; } }",
    ] {
        let diagnostics = checked_diagnostics(source);
        testing::assert(
            has_diagnostic_containing(diagnostics, "Type mismatch")
                || has_diagnostic_containing(diagnostics, "Numeric literal"),
        );
    }
}

#[test]
fn unreachable_break_values_are_independent_of_diverging_loop_results() -> () {
    for source in[
        "fn f() -> i32 { 'outer: loop { loop { return 42; break 'outer false; } } }",
        "fn f() -> i32 { loop { return 42; break false; } }",
        "fn f() -> i32 { loop { return 42; break { false }; } }",
        "fn f(x: bool) -> i32 { loop { return 42; break if x { false } else { true }; } }",
        "fn f() -> never { loop { continue; break 1; } }",
        "fn f(a: (i32) -> i32) -> (i32) -> i32 { loop { return a; break |v| v; } }",
        "fn f(a: () -> i32) -> () -> i32 { loop { return a; break || true; } }",
        "fn f() -> u64 { loop { return 1; break 18446744073709551615; } }",
        "struct A { field: bool } fn f(a: (A) -> i32) -> (A) -> i32 { loop { return a; break |v| v.field; } }",
        "fn f() -> [u8; 1] { loop { return [1]; break b\"xx\"; } }",
        "fn f() -> i8 { loop { return 1; break 255; } }",
        "fn f() -> f32 { loop { return 1.0; break (1 & 2); } }",
        "enum E { Empty } enum F { Empty } fn f(x: E) -> E { loop { return x; break Empty; } }",
        "enum E { Empty } enum F { Empty } fn f(x: (E, bool)) -> (E, bool) { loop { return x; break (Empty, true); } }",
        "enum E { Empty } enum F { Empty } fn f(x: () -> E) -> () -> E { loop { return x; break || Empty; } }",
    ] {
        assert_single_unreachable_code_warning(source, checked_diagnostics(source));
    }
}

#[test]
fn unreachable_breaks_keep_value_and_target_type_checks() -> () {
    for source in[
        "fn f(x: bool) -> i32 { loop { return 42; break if x { false } else { 1 }; } }",
        "fn f() -> i32 { loop { return 42; break true; break \"bad\"; } }",
        "fn f(flag: bool) -> i32 { loop { if flag { return 42; break false; } break 4; } }",
        "fn f() -> i32 { loop { return 42; break (1 + false); } }",
    ] {
        let diagnostics = checked_diagnostics(source);
        testing::assert(
            has_diagnostic_containing(diagnostics, "Type mismatch")
                || has_diagnostic_containing(diagnostics, "Numeric literal"),
        );
    }
}
