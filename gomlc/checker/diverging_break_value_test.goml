package checker;

use std::testing;

#[test]
fn diverging_break_values_do_not_make_loops_return() -> () {
    for source in[
        "fn stop() -> never { loop {} } fn f() -> i32 { loop { break stop(); }; }",
        "fn f() -> i32 { loop { break return 7; }; }",
        "fn f() -> i32 { loop { break continue; }; }",
        "fn f[T](exit: T) -> i32 where T = never { loop { break exit; }; }",
        "fn f() -> i32 { 'outer: loop { loop { break 'outer return 7; } }; }",
        "fn f() -> i32 { loop { break { let _ = return 7; }; }; }",
        "fn f(flag: bool) -> i32 { loop { if flag { break return 7; } else { break 8; } } }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn reachable_break_values_still_determine_loop_results() -> () {
    for source in[
        "fn f() -> i32 { loop { break 7; }; }",
        "fn f(flag: bool) -> i32 { loop { if flag { break return 7; } else { break; } }; }",
        "fn f(flag: bool) -> i32 { loop { if flag { break return 7; } else { break false; } } }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}
