package checker;

use std::testing;

#[test]
fn opaque_bounds_validate_associated_binding_names() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "trait Mark {}\nimpl Mark for bool {}\nfn make() -> impl Mark[Typo = i32] { true }\nfn main() -> () { let _ = make(); }\n",
            ),
            "has no associated type Typo",
        ),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "trait Mark { type Item; }\nimpl Mark for bool { type Item = i32; }\nfn make() -> impl Mark[Item = i32, Item = i32] { true }\nfn main() -> () { let _ = make(); }\n",
            ),
            "Duplicate opaque associated type binding Item",
        ),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "trait A { type Item; }\ntrait B { type Item; }\ntrait C: A + B {}\nimpl A for bool { type Item = i32; }\nimpl B for bool { type Item = i32; }\nimpl C for bool {}\nfn make() -> impl C[Item = i32] { true }\nfn main() -> () { let _ = make(); }\n",
            ),
            "Ambiguous opaque associated type binding Item",
        ),
    );
}

#[test]
fn opaque_bounds_preserve_declaring_traits_and_generic_methods() -> () {
    opaque_return_accepts(
        "trait A { type Item; fn get(self: Self) -> Self::Item; }\ntrait B { type Item; fn other(self: Self) -> Self::Item; }\ntrait C: A + B { fn identity[T](self: Self, value: T) -> T; }\nimpl A for bool { type Item = i32; fn get(self: Self) -> i32 { 7 } }\nimpl B for bool { type Item = string; fn other(self: Self) -> string { \"second\" } }\nimpl C for bool { fn identity[T](self: Self, value: T) -> T { value } }\nfn make() -> impl C + A[Item = i32] + B[Item = string] { true }\nfn main() -> () { let value = make(); println(A::get(value)); println(B::other(value)); println(value.identity(9)); }\n",
    );
    opaque_return_accepts(
        "trait Parent { type Item; } trait Child: Parent {} impl Parent for bool { type Item = i32; } impl Child for bool {} fn make() -> impl Child[Item = i32] { true }",
    );
}

#[test]
fn opaque_inherent_return_bounds_validate_before_normalization() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "trait Mark {} impl Mark for bool {} struct Holder[T] { value: T } impl[T] Holder[T] { fn make(self: Self) -> impl Mark[Typo = T] { true } }",
            ),
            "has no associated type Typo",
        ),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "trait Mark { type Item; } impl Mark for bool { type Item = i32; } struct Holder {} impl Holder { fn make(self: Self) -> impl Mark[Item = i32, Item = i32] { true } }",
            ),
            "Duplicate opaque associated type binding Item",
        ),
    );
}
