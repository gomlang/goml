package checker;

use std::testing;

#[test]
fn comptime_indexing_preserves_container_types_aliasing_and_evaluation_order() -> () {
    let _ = checked_file(
        "#[comptime]\nfn ordered_index() -> i32 {\n    let state: Ref[i32] = Ref::new(0);\n    let values: Vec[i32] = Vec::from_array([7, 8]);\n    let base = || { state.set(state.get() * 10 + 1); values };\n    let offset = || { state.set(state.get() * 10 + 2); 1 };\n    let result = base()[offset()];\n    result * 100 + state.get()\n}\nfn main() -> () {\n    println(comptime { let values = Vec::from_array([7, 8]); values[0] });\n    println(comptime { let values = Vec::from_array([7, 8]); let alias = values; alias.set(0, 9); values[0] });\n    println(ordered_index());\n    println(comptime { ordered_index() });\n    println(comptime { let values: [i32; 2] = [10, 11]; values[1] });\n}\n",
    );
}

#[test]
fn comptime_indexing_reports_container_bounds() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "fn main() -> () { let _ = comptime { let values = Vec::from_array([7]); values[1] }; }",
            ),
            "comptime buffer index out of bounds",
        ),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "fn main() -> () { let _ = comptime { let values = Vec::from_array([7]); values[-1] }; }",
            ),
            "comptime buffer index out of bounds",
        ),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "fn main() -> () { let _ = comptime { let values = [7]; values[1] }; }",
            ),
            "index out of bounds during comptime evaluation",
        ),
    );
}
