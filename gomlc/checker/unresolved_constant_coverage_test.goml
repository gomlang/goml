package checker;

use std::testing;

#[test]
fn unresolved_constant_patterns_do_not_disable_exhaustiveness() -> () {
    for source in[
        "const ZERO: f64 = 0.0; fn f(value: f64) -> bool { match value { ZERO => true } }",
        "const ZERO: f32 = 0.0; fn f(value: f32) -> bool { match value { ZERO => true, 1.0 => false } }",
        "const FLAG: bool = 0.0 == 0.0; fn f(value: bool) -> bool { match value { FLAG => true } }",
        "const ZERO: f64 = 0.0; fn f(value: (f64, bool)) -> bool { match value { (ZERO, _) => true } }",
        "const ZERO: f64 = 0.0; fn f(value: (f64, bool)) -> bool { match value { (_, true) => true, (ZERO, false) => false } }",
        "const NUMBER: i32 = 7; fn f(value: i32) -> bool { match value { NUMBER => true } }",
    ] {
        testing::assert(
            has_diagnostic_containing(checked_diagnostics(source), "non-exhaustive match"),
        );
    }
}

#[test]
fn unresolved_constants_preserve_wildcard_and_known_scalar_coverage() -> () {
    for source in[
        "const ZERO: f64 = 0.0; fn f(value: f64) -> bool { match value { ZERO => true, _ => false } }",
        "const ZERO: f64 = 0.0; fn f(value: f64) -> bool { match value { ZERO | _ => true } }",
        "const FLAG: bool = 0.0 == 0.0; fn f(value: bool) -> bool { match value { FLAG => true, _ => false } }",
        "const FLAG: bool = 0.0 == 0.0; fn f(value: bool) -> bool { match value { FLAG | true | false => true } }",
        "const ZERO: f64 = 0.0; fn f(value: (f64, bool)) -> bool { match value { (ZERO, _) => true, (_, true) => true, (_, false) => false } }",
        "const YES: bool = true; const NO: bool = false; fn f(value: bool) -> bool { match value { YES => true, NO => false } }",
    ] {
        let diagnostics = checked_diagnostics(source);
        testing::assert(!has_diagnostic_containing(diagnostics, "Unreachable match arm"));
        testing::assert(!has_diagnostic_containing(diagnostics, "non-exhaustive match"));
        let _ = checked_file(source);
    }
}
