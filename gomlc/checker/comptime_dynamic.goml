package checker;

use module::ctir;
use module::tast::{Callable, Expr, ImplBlock, TraitRef, Type, diagnostic_type_text, trait_ref_text, types_equal};

fn ct_method_name(block: ImplBlock, name: string) -> string {
    let owner = match block.trait_ref {
        Some(value) => trait_ref_text(value),
        None => "inherent",
    };
    "$comptime_method$" + owner + "$" + diagnostic_type_text(block.for_type) + "$" + name
}

fn ct_method_target(
    ctx: CtLowerContext,
    for_ty: Type,
    trait_reference: Option[TraitRef],
    method_name: string,
) -> Option[ctir::CtCallTarget] {
    for item in ctx.file.items {
        if let ImplBlock(block) = item {
            if !block.generics.is_empty() || !types_equal(block.for_type, for_ty) {
                continue
            }
            let matches_trait = match (block.trait_ref, trait_reference) {
                (Some(actual), Some(expected)) => trait_ref_equal(actual, expected),
                (None, None) => true,
                _ => false,
            };
            if !matches_trait {
                continue
            }
            for method in block.methods {
                if method.name == method_name {
                    if let Capable = method.comptime {
                        return function_call_target(ctx, ct_method_name(block, method.name))
                    }
                }
            }
        }
    }
    None
}

fn lower_ct_dynamic(ctx: CtLowerContext, trait_name: string, for_ty: Type, expr: Expr) -> Result[
    ctir::CtExprKind,
    string,
] {
    let methods = Vec::new();
    for item in ctx.file.items {
        if let ImplBlock(block) = item {
            let Some(trait_ref) = block.trait_ref else {
                continue
            };
            if trait_ref.name != trait_name || !types_equal(block.for_type, for_ty) {
                continue
            }
            if !block.generics.is_empty() {
                return Err("comptime dynamic conversion requires a concrete implementation")
            }
            for method in block.methods {
                if let Capable = method.comptime {} else {
                    return Err(
                        "comptime dynamic conversion requires #[comptime] on method `" + method.name
                            + "`",
                    )
                }
                let params = Vec::new();
                for param in method.params {
                    params.push(param.1)
                }
                let ty = Type::Func { params, ret_ty: method.ret_ty };
                methods.push(
                    (
                        method.name,
                        ctir::CtExpr {
                            kind: lower_ct_function_value(
                                ctx,
                                Callable::Function(ct_method_name(block, method.name)),
                                ty,
                            )?,
                            ty: lower_ct_type(ctx, ty)?,
                            origin: ctx.origin,
                        },
                    ),
                );
            }
        }
    }
    if methods.is_empty() {
        return Err("comptime dynamic conversion requires a local #[comptime] implementation")
    }
    Ok(ctir::CtExprKind::Dynamic { value: lower_ct_expr(ctx, expr)?, methods })
}
