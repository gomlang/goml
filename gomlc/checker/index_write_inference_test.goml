package checker;

use std::testing;

#[test]
fn index_writes_infer_receiver_and_value_types() -> () {
    for source in[
        "fn f() -> () { let set = |xs| { xs[0] = 7; }; set(Vec::from_array([1])); }",
        "fn f() -> () { let set = |xs| { xs[0] += 7; }; set(Vec::from_array([1])); }",
        "fn f(xs: MutSlice[i32]) -> () { let set = |xs| { xs[0] = 7; }; set(xs); }",
        "fn f(xs: HashMap[string, i32]) -> () { let set = |xs, key, value| { xs[key] = value; }; set(xs, \"key\", 7); }",
        "fn f() -> i32 { let set = |xs| { let mut copy = xs; copy[0] = 7; copy[0] }; set([1]) }",
        "fn f() -> i32 { let set = |xs| { let mut copy = xs; copy[0] += 7; copy[0] }; set([1]) }",
        "struct Holder { values: Vec[i32] } fn f() -> () { let set = |holder| { holder.values[0] = 7; }; set(Holder { values: Vec::from_array([1]) }); }",
        "fn f() -> () { let set = |xs| { let shared = Ref::new(xs); shared.get()[0] = 7; }; set([1]); }",
    ] {
        if !checked_diagnostics(source).is_empty() {
            testing::fail(source)
        }
    }
}

#[test]
fn index_writes_validate_final_receiver_and_writable_root() -> () {
    for source in[
        "fn f() -> () { let set = |xs| { xs[0] = 7; }; set(true); }",
        "fn f() -> () { let set = |xs| { xs[0] = 'a'; }; set(\"text\"); }",
        "fn f() -> () { let set = |xs| { xs[true] = 7; }; set(Vec::from_array([1])); }",
        "fn f(xs: HashMap[string, bool]) -> () { let set = |xs| { xs[\"key\"] = 7; }; set(xs); }",
        "fn f() -> () { let set = |xs| { xs[0] = 7; }; }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics("fn f() -> () { let set = |xs| { xs[0] = 7; }; set([1]); }"),
            "immutable binding",
        ),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "fn f(xs: Slice[i32]) -> () { let set = |xs| { xs[0] = 7; }; set(xs); }",
            ),
            "Slice is read-only",
        ),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "fn f(xs: HashMap[string, i32]) -> () { let set = |xs| { xs[\"key\"] += 7; }; set(xs); }",
            ),
            "compound assignment is not supported for HashMap",
        ),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "fn f(xs: Slice[[i32; 1]]) -> () { let set = |xs| { let mut view = xs; view[0][0] = 7; }; set(xs); }",
            ),
            "Slice is read-only",
        ),
    );
}
