package checker;

use std::testing;

#[test]
fn unique_trait_arguments_follow_available_bounds() -> () {
    let prefix = "trait Tag[A] {} fn need[A, T: Tag[A]](value: T) -> () {} ";
    for source in[
        "fn bridge[T: Tag[i32]](value: T) -> () { need(value) }",
        "trait Child: Tag[i32] {} fn bridge[T: Child](value: T) -> () { need(value) }",
        "trait Source { type Item: Tag[i32]; } fn bridge[T: Source](value: T::Item) -> () { need(value) }",
        "fn bridge(value: dyn Tag[i32]) -> () { need(value) }",
        "impl[T] Tag[i32] for T {} fn bridge[T: Tag[i32]](value: T) -> () { need(value) }",
        "trait Other {} impl[T: Other] Tag[bool] for T {} fn bridge[T: Tag[i32]](value: T) -> () { need(value) }",
    ] {
        let _ = checked_file(prefix + source);
    }
}

#[test]
fn conflicting_bound_arguments_still_require_context() -> () {
    let prefix = "trait Tag[A] {} fn need[A, T: Tag[A]](value: T) -> () {} ";
    for source in[
        "fn bridge[T: Tag[i32] + Tag[bool]](value: T) -> () { need(value) }",
        "impl[T] Tag[bool] for T {} fn bridge[T: Tag[i32]](value: T) -> () { need(value) }",
    ] {
        testing::assert(
            has_diagnostic_containing(checked_diagnostics(prefix + source), "Could not infer"),
        );
    }
}
