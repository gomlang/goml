package checker;

use std::testing;

#[test]
fn dyn_conversions_require_method_specific_predicates() -> () {
    for source in[
        "trait Extra { fn extra(self) -> i32; } trait Main { fn run(self) -> i32 where Self: Extra; } impl Main for bool { fn run(self) -> i32 where Self: Extra { self.extra() } } fn make() -> dyn Main { true as dyn Main }",
        "trait Extra {} trait Main[T] { fn run(self) -> i32 where T: Extra; } impl Main[bool] for i32 { fn run(self) -> i32 where bool: Extra { 1 } } fn make() -> dyn Main[bool] { let value: i32 = 1; value as dyn Main[bool] }",
        "trait Extra {} trait Main { fn run(self) -> i32 where Self: Extra; } trait Child: Main {} impl Main for bool { fn run(self) -> i32 where Self: Extra { 1 } } impl Child for bool {} fn make() -> dyn Child { true as dyn Child }",
        "trait Main[T] { fn run(self) -> i32 where T = i32; } impl Main[bool] for bool { fn run(self) -> i32 where bool = i32 { 1 } } fn make() -> dyn Main[bool] { true as dyn Main[bool] }",
    ] {
        let diagnostics = checked_diagnostics(source);
        if !has_diagnostic_containing(diagnostics, "does not satisfy its bounds") {
            for diagnostic in diagnostics {
                println(diagnostic.message)
            }
            testing::fail(source)
        }
    }
}

#[test]
fn dyn_conversions_accept_satisfied_method_predicates() -> () {
    for source in[
        "trait Extra {} trait Main { fn run(self) -> i32 where Self: Extra; } impl Main for isize { fn run(self) -> i32 where Self: Extra { 1 } } impl Main for i32 { fn run(self) -> i32 where Self: Extra { 2 } } impl Extra for i32 {} fn make() -> dyn Main { 7 as dyn Main }",
        "trait Main { fn run(self) -> i32; } struct Value {} impl Main for Value { fn run(self) -> i32 { 7 } } impl Value { fn unused[T]() -> () where T = i32 {} } fn make() -> dyn Main { Value {} as dyn Main }",
        "trait Extra { fn extra(self) -> i32; } trait Main { fn run(self) -> i32 where Self: Extra; } impl Extra for bool { fn extra(self) -> i32 { 7 } } impl Main for bool { fn run(self) -> i32 where Self: Extra { self.extra() } } fn make() -> dyn Main { true as dyn Main }",
        "trait Extra {} trait Main { fn run(self) -> i32 where Self: Extra; } fn make[T: Main + Extra](value: T) -> dyn Main + Extra { value as dyn Main + Extra }",
        "trait Extra {} impl Extra for bool {} trait Main[T] { fn run(self) -> i32 where T: Extra; } impl Main[bool] for i32 { fn run(self) -> i32 where bool: Extra { 1 } } fn make() -> dyn Main[bool] { let value: i32 = 1; value as dyn Main[bool] }",
        "trait Main[T] { fn run(self) -> i32 where T = i32; } impl Main[i32] for bool { fn run(self) -> i32 where i32 = i32 { 1 } } fn make() -> dyn Main[i32] { true as dyn Main[i32] }",
    ] {
        let _ = checked_file(source);
    }
}
