package checker;

use module::tast::{FunctionScheme, TraitInfo, TraitMethodInfo, Type, TypePredicate, TypeSubst, substitute_type};

fn attach_default_map_requirements(traits: Vec[TraitInfo], functions: Vec[FunctionScheme]) -> () {
    for info in traits {
        for method in info.methods {
            if let Some(name) = method.default_name {
                for function in functions {
                    if function.name == name {
                        for predicate in function.predicates {
                            if let ConstValid { ty, .. } = predicate {
                                let _ = push_map_type_requirement(
                                    method.default_const_requirements,
                                    ty,
                                );
                            }
                            if let GoFunction(signature) = predicate {
                                let _ = push_map_type_requirement(
                                    method.default_raw_function_requirements,
                                    signature,
                                );
                            }
                            if let ConstComparison { ty, ordering } = predicate {
                                let mut found = false;
                                for requirement in method.default_const_comparison_requirements {
                                    if requirement.1 == ordering
                                        && projection_search_types_equal(requirement.0, ty) {
                                        found = true;
                                    }
                                }
                                if !found {
                                    method.default_const_comparison_requirements.push(
                                        (ty, ordering),
                                    );
                                }
                            }
                            if let GoCallback(signature) = predicate {
                                let _ = push_map_type_requirement(
                                    method.default_callback_requirements,
                                    signature,
                                );
                            }
                            if let GoComparable(key) = predicate {
                                let _ = push_map_type_requirement(
                                    method.default_map_requirements,
                                    key,
                                );
                            }
                        }
                    }
                }
            }
        }
    }
}

fn validate_default_map_requirements(
    ctx: Checker,
    expected: TraitMethodInfo,
    substitutions: Vec[TypeSubst],
    generics: Vec[string],
    predicates: Vec[TypePredicate],
) -> () {
    let validation = function_context(
        ctx,
        Type::Unit,
        None,
        generics,
        predicates,
        false,
        false,
        false,
        RuntimeOnly,
    );
    for requirement in expected.default_const_requirements {
        let ty = resolve_impl_alias_type(ctx, substitute_type(requirement, substitutions));
        if let Some(error) = const_valid_predicate_error(validation, ty) {
            push_diagnostic(ctx, error);
        }
    }
    for requirement in expected.default_raw_function_requirements {
        let signature = resolve_impl_alias_type(ctx, substitute_type(requirement, substitutions));
        let predicate = TypePredicate::GoFunction(signature);
        if !predicates_satisfied_at(validation, Vec::from_array([predicate]), Vec::new()) {
            push_diagnostic(
                ctx,
                predicate_requirement_message(validation, predicate, "type predicate not satisfied"),
            );
        }
    }
    for requirement in expected.default_callback_requirements {
        let signature = resolve_impl_alias_type(ctx, substitute_type(requirement, substitutions));
        let predicate = TypePredicate::GoCallback(signature);
        if !predicates_satisfied_at(validation, Vec::from_array([predicate]), Vec::new()) {
            push_diagnostic(
                ctx,
                predicate_requirement_message(validation, predicate, "type predicate not satisfied"),
            );
        }
    }
    for requirement in expected.default_const_comparison_requirements {
        let ty = resolve_impl_alias_type(ctx, substitute_type(requirement.0, substitutions));
        let predicate = TypePredicate::ConstComparison { ty, ordering: requirement.1 };
        if !predicates_satisfied_at(validation, Vec::from_array([predicate]), Vec::new()) {
            push_diagnostic(ctx, constant_comparison_message(ty, requirement.1));
        }
    }
    for requirement in expected.default_map_requirements {
        let key = resolve_impl_alias_type(ctx, substitute_type(requirement, substitutions));
        let predicate = TypePredicate::GoComparable(key);
        if !predicates_satisfied_at(validation, Vec::from_array([predicate]), Vec::new()) {
            push_diagnostic(
                ctx,
                predicate_requirement_message(validation, predicate, "type predicate not satisfied"),
            )
        }
    }
}
