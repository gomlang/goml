package checker;

use std::testing;

#[test]
fn contextual_projected_closure_parameters_keep_shape_inference() -> () {
    for pair in[
        ("() -> i32", "apply(|value| value(), true, || 7)"),
        ("(i32, i32)", "apply(|value| value.0, true, (7, 8))"),
        ("[i32; 2]", "apply(|value| value[0], true, [7, 8])"),
        ("i32", "apply(|value| value + 1, true, 7)"),
    ] {
        let _ = checked_file(
            "trait Source { type Item; } impl Source for bool { type Item = " + pair.0
                + "; } fn apply[T: Source](callback: (T::Item) -> i32, owner: T, item: T::Item) -> i32 { callback(item) } fn main() -> () { let result: i32 = "
                + pair.1
                + "; }",
        );
    }
}

#[test]
fn contextual_projected_closures_share_owner_and_result_constraints() -> () {
    for source in[
        "trait Source { type Item; } impl Source for bool { type Item = i32; } fn apply[T: Source](callback: (T::Item, T) -> T::Item, item: T::Item, owner: T) -> T::Item { callback(item, owner) } fn main() -> () { let result: i32 = apply(|value, owner: bool| value + 1, 7, true); }",
        "trait Source { type Item; } impl Source for bool { type Item = i32; } fn apply[T: Source](callback: ((T::Item, T)) -> (T::Item, T::Item), owner: T, item: T::Item) -> (T::Item, T::Item) { callback((item, owner)) } fn main() -> () { let result: (i32, i32) = apply(|pair| (pair.0 + 1, pair.0), true, 7); }",
        "trait Source { type Item; } impl Source for bool { type Item = i32; } fn apply[T: Source](callback: (T::Item) -> T::Item, owner: T, item: T::Item) -> T::Item { callback(item) } fn main() -> () { let later = |owner| apply(|value| value + 1, owner, 7); let result: i32 = later(true); }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn contextual_projected_closures_preserve_mismatches_and_rigid_parameters() -> () {
    for source in[
        "trait Source { type Item; } impl Source for bool { type Item = i32; } fn apply[T: Source](callback: (T::Item) -> i32, owner: T, item: T::Item) -> i32 { callback(item) } fn main() -> () { apply(|value: string| 7, true, 8); }",
        "trait Source { type Item; } impl Source for bool { type Item = bool; } fn apply[T: Source](callback: (T::Item) -> i32, owner: T, item: T::Item) -> i32 { callback(item) } fn main() -> () { apply(|value| value[0], true, false); }",
        "trait Source { type Item; } impl Source for bool { type Item = () -> i32; } fn apply[T: Source](callback: (T::Item) -> i32, owner: T, item: T::Item) -> i32 { callback(item) } fn main() -> () { apply(|value| value(1), true, || 7); }",
        "trait Source { type Item; } fn invalid[T: Source](owner: T, item: T::Item) -> i32 { let callback: (T::Item) -> i32 = |value| value[0]; callback(item) }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}
