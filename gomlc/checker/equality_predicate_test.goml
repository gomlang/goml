package checker;

use std::testing;
use module::tast::{Type, TypePredicate};

#[test]
fn equality_predicates_are_symmetric_and_deduplicated() -> () {
    let left = Type::Param { name: "T" };
    let right = Type::Int32;
    let forward = TypePredicate::Equality { lhs: left, rhs: right };
    let reverse = TypePredicate::Equality { lhs: right, rhs: left };
    testing::assert(predicate_equal(forward, reverse));
    testing::assert(predicate_equal(reverse, forward));
    testing::assert(
        !predicate_equal(forward, TypePredicate::Equality { lhs: left, rhs: Type::Bool }),
    );
    let predicates = Vec::new();
    push_predicate(predicates, forward);
    push_predicate(predicates, reverse);
    testing::assert_eq(predicates.len(), 1);
}

#[test]
fn trait_method_equality_bounds_accept_reversed_sides() -> () {
    for source in[
        "trait Convert { fn convert[T, U](self: Self, value: T) -> U where T = U; } impl Convert for i32 { fn convert[A, B](self: i32, value: A) -> B where B = A { value } }",
        "trait Convert { fn convert[T](self: Self, value: T) -> i32 where T = i32; } impl Convert for i32 { fn convert[A](self: i32, value: A) -> i32 where i32 = A { value } }",
    ] {
        testing::assert_eq(checked_diagnostics(source).len(), 0);
    }
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "trait Convert { fn convert[T](self: Self) -> () where T = i32; } impl Convert for i32 { fn convert[A](self: i32) -> () where bool = A {} }",
            ),
            "method bounds do not match",
        ),
    );
}
