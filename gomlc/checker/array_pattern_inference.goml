package checker;

use module::tast::{Type, prune};

fn constrain_array_pattern(ctx: Checker, constraint: ArrayPatternConstraint) -> () {
    let receiver = normalize_type(ctx, constraint.receiver);
    if let Array { len: length, elem } = prune(receiver) {
        if (constraint.has_rest && constraint.fixed_count > length)
            || (!constraint.has_rest && constraint.fixed_count != length) {
            expect_type_at(
                ctx,
                receiver,
                Type::Array { len: constraint.fixed_count, elem },
                constraint.span,
            )
        }
    }
    let previous = ctx.current_span.get();
    ctx.current_span.set(constraint.span);
    let (element, rest_ty) = array_pattern_types(ctx, receiver, constraint.fixed_count);
    expect_type(ctx, element, constraint.element);
    expect_type(ctx, rest_ty, constraint.rest_ty);
    ctx.current_span.set(previous)
}

fn infer_deferred_array_pattern(ctx: Checker, constraint: ArrayPatternConstraint) -> bool {
    if let Var(_) = prune(normalize_type(ctx, constraint.receiver)) {
        return false
    }
    let snapshot = deferred_dependency_snapshot(
        ctx,
        Vec::from_array([constraint.receiver, constraint.element, constraint.rest_ty]),
    );
    let diagnostic_start = ctx.diagnostics.len();
    constrain_array_pattern(ctx, constraint);
    if ctx.diagnostics.len() != diagnostic_start {
        snapshot.restore();
        ctx.diagnostics.truncate(diagnostic_start);
        false
    } else {
        snapshot.changed()
    }
}

fn resolve_array_pattern_constraints(ctx: Checker) -> () {
    for constraint in ctx.inference.array_pattern_constraints {
        if !type_contains_error(constraint.receiver) {
            constrain_array_pattern(ctx, constraint)
        }
    }
}
