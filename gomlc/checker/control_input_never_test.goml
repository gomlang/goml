package checker;

use module::diagnostic::{DiagnosticSeverity};
use std::testing;

#[test]
fn control_inputs_propagate_never_before_branch_contexts() -> () {
    let prefix = "fn stop() -> never { loop {} } ";
    for source in[
        "fn run() -> never { if stop() { () } else { () } }",
        "fn run() -> never { match stop() { _ => () } }",
        "fn run() -> never { match stop() { true => (), false => () } }",
        "fn run() -> never { while stop() {} }",
        "fn run[T](value: T) -> never where T = never { if value { () } else { () } }",
        "fn run[T](value: T) -> never where T = never { while value {} }",
        "fn run[T](value: T, channel: Channel[i32]) -> never where T = never { select { send(channel, value) => (), default => (), } }",
        "fn run[T](value: T, channel: Channel[i32]) -> never where T = never { select { recv(channel) when value as _ => (), default => (), } }",
        "fn run[T](value: T) -> never where T = never { select { recv(value) as _ => (), default => (), } }",
        "fn run(channel: Channel[i32]) -> never { select { send(channel, stop()) => (), default => (), } }",
        "fn run(channel: Channel[i32]) -> never { select { recv(channel) when stop() as _ => (), default => (), } }",
        "fn run() -> never { select { recv(stop()) as _ => (), default => (), } }",
        "fn run() -> never { select { send(stop(), 1) => (), default => (), } }",
        "fn run(channel: Channel[i32]) -> never { select priority { recv(channel) when false as _ => (), send(channel, stop()) => (), default => (), } }",
        "fn run() -> () -> never { || if stop() { () } else { () } }",
        "fn run() -> Option[i32] { if stop() { None } else { None } }",
        "fn run() -> Option[i32] { match stop() { _ => None } }",
        "fn run(channel: Channel[i32]) -> Option[i32] { select { send(channel, stop()) => None, default => None, } }",
        "enum Choice { Empty } fn run() -> Choice { if stop() { Empty } else { Empty } }",
        "fn run() -> (i32) -> i32 { if stop() { |value| value } else { |value| value } }",
    ] {
        for diagnostic in checked_diagnostics(prefix + source) {
            if let DiagnosticSeverity::Error = diagnostic.severity {
                testing::fail(source + "\n" + diagnostic.message)
            }
        }
    }
}

#[test]
fn control_input_divergence_preserves_conditional_guards_and_body_errors() -> () {
    let prefix = "fn stop() -> never { loop {} } ";
    for source in[
        "fn run(flag: bool) -> never { if flag { stop() } else { () } }",
        "fn run(flag: bool) -> never { match flag { true if stop() => (), _ => (), } }",
        "fn run(flag: bool) -> never { while flag { stop(); } }",
        "fn run() -> never { if stop() { let value: i32 = true; () } else { () } }",
        "fn run() -> never { if stop() { true } else { \"bad\" } }",
        "fn run() -> never { match stop() { _ => { let value: i32 = true; () } } }",
        "fn run(channel: Channel[i32]) -> never { select { send(channel, stop()) => { let value: i32 = true; () }, default => (), } }",
        "fn run(channel: Channel[i32]) -> never { select { send(channel, stop()) => true, default => \"bad\", } }",
        "fn run() -> never { while stop() { let value: i32 = true; } }",
    ] {
        testing::assert(
            has_diagnostic_containing(checked_diagnostics(prefix + source), "Type mismatch"),
        );
    }
}
