package checker;

use std::testing;
use module::diagnostic::{DiagnosticSeverity};

#[test]
fn closure_explicit_returns_preserve_result_inference() -> () {
    for source in[
        "fn f() -> i32 { let get = || { return 7; }; get() }",
        "fn f() -> f64 { let get = || { return 1.5; }; get() }",
        "fn f() -> i32 { let identity = |value| { return value; }; identity(7) }",
        "fn f() -> i32 { let choose = |flag, value| { if flag { return value; } else { return 9; } }; choose(true, 7) }",
        "fn f() -> i32 { let get = || { return { return 7; }; }; get() }",
        "fn f() -> i32 { let outer = |value| { let inner = |item| { return item; }; return inner(value); }; outer(7) }",
    ] {
        let diagnostics = checked_diagnostics(source);
        for diagnostic in diagnostics {
            if let DiagnosticSeverity::Error = diagnostic.severity {
                testing::fail(source + ": " + diagnostic.message)
            }
        }
    }
}

#[test]
fn closure_divergence_keeps_unit_fallback_in_its_own_scope() -> () {
    for source in[
        "fn f[T](value: T) -> () where T = never { let closure = || { return value; }; let _: () -> () = closure; }",
        "fn stop() -> never { loop {} } fn f() -> () { let closure = || stop(); let _: () -> () = closure; }",
        "fn stop() -> never { loop {} } fn f() -> () { let closure = || { return stop(); }; let _: () -> () = closure; }",
        "fn stop() -> never { loop {} } fn f() -> () { let closure = || { let inner = || { return 7; }; stop() }; let _: () -> () = closure; }",
        "fn stop() -> never { loop {} } fn f() -> () { let closure = || { return { let inner = || { return 7; }; stop() }; }; let _: () -> () = closure; }",
    ] {
        let diagnostics = checked_diagnostics(source);
        for diagnostic in diagnostics {
            if let DiagnosticSeverity::Error = diagnostic.severity {
                testing::fail(source + ": " + diagnostic.message)
            }
        }
    }
    testing::assert(
        !checked_diagnostics(
            "fn f() -> i32 { let identity = |value| { return value; }; identity(true) }",
        ).is_empty(),
    );
}
