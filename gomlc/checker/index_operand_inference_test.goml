package checker;

use std::testing;

#[test]
fn indexing_closures_infer_receivers_and_keys_from_calls() -> () {
    for source in[
        "fn f() -> i32 { let first = |xs| xs[0]; first(Vec::from_array([7])) }",
        "fn f() -> i32 { let first = |xs| xs[0]; first([7]) }",
        "fn f() -> char { let first = |xs| xs[0]; first(\"hi\") }",
        "fn f(xs: Slice[i32]) -> i32 { let first = |xs| xs[0]; first(xs) }",
        "fn f(xs: MutSlice[i32]) -> i32 { let first = |xs| xs[0]; first(xs) }",
        "fn f(xs: HashMap[string, i32]) -> Option[i32] { let at = |xs, key| xs[key]; at(xs, \"key\") }",
        "struct Item { value: i32 } fn f(xs: Vec[Item]) -> i32 { let read = |xs| xs[0].value; read(xs) }",
        "struct Items { values: Vec[i32] } fn f(xs: Items) -> i32 { let read = |xs| xs.values[0]; read(xs) }",
        "fn f(xs: Vec[Option[i32]]) -> i32 { let read = |xs| xs[0].unwrap_or(0); read(xs) }",
        "fn f(xs: HashMap[string, i32]) -> i32 { let read = |xs, key| xs[key]; read(xs, \"key\").unwrap_or(0) }",
        "fn f(xs: Vec[Vec[i32]]) -> i32 { let read = |xs| xs[0][0]; read(xs) }",
    ] {
        let diagnostics = checked_diagnostics(source);
        if !diagnostics.is_empty() {
            testing::fail(source)
        }
    }
}

#[test]
fn inferred_indexing_preserves_receiver_key_and_write_restrictions() -> () {
    for source in[
        "fn f() -> () { let first = |xs| xs[0]; let _ = first(true); }",
        "fn f() -> () { let first = |xs| xs[true]; let _ = first([1]); }",
        "fn f(xs: HashMap[string, i32]) -> () { let at = |xs| xs[0]; let _ = at(xs); }",
        "fn f() -> () { let first = |xs| xs[0]; }",
        "fn f(xs: Slice[i32]) -> () { let write = |xs| { xs[0] = 2; }; write(xs); }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
    let source = "struct Item { value: i32 } fn f(xs: Slice[Item]) -> () { let write = |xs| { xs[0].value = 2; }; write(xs); }";
    testing::assert(has_diagnostic_containing(checked_diagnostics(source), "Slice is read-only"));
}
