package checker;

use std::testing;

#[test]
fn trait_constants_and_methods_share_member_names() -> () {
    for source in[
        "trait Values { const item: i32; fn item() -> i32; }",
        "trait Values { fn item() -> i32; const item: i32; }",
        "trait Values { const item: i32 = 7; fn item() -> i32 { 9 } }",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "method item is defined multiple times in trait Values",
            ),
        )
    }
}

#[test]
fn trait_constant_names_keep_type_and_value_namespaces_separate() -> () {
    testing::assert(
        checked_diagnostics(
            "trait Values { type Item; const Item: i32; fn item() -> i32; } struct V {} impl Values for V { type Item = bool; const Item: i32 = 7; fn item() -> i32 { 9 } } fn read() -> i32 { V::Item + V::item() }",
        ).is_empty(),
    )
}
