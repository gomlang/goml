package checker;

use std::testing;

#[test]
fn comptime_concrete_nominal_fields_substitute_nested_type_parameters() -> () {
    let _ = checked_file(
        "struct Box[T] { value: Ref[T] }\nstruct Many[T] { values: Vec[T] }\nstruct Callback[T] { value: (T) -> T }\nenum Choice[T] { Hold(Ref[Vec[T]]) }\nstruct Nested[T] { value: (Ref[Vec[T]], (T) -> T) }\nstruct Fixed[const N: usize] { value: [i32; N] }\ntrait Read[T] { fn read(self: Self) -> T; }\nimpl Read[i32] for bool { #[comptime] fn read(self: Self) -> i32 { 17 } }\nstruct DynamicHolder[T] { value: dyn Read[T] }\nfn main() -> () {\n    println(comptime { let holder = Box { value: Ref::new(7) }; holder.value.get() });\n    println(comptime { let holder = Many { values: Vec::from_array([8, 9]) }; holder.values[0] });\n    println(comptime { let holder: Callback[i32] = Callback { value: |value| value + 1 }; (holder.value)(9) });\n    println(comptime {\n        let holder = Choice::Hold(Ref::new(Vec::from_array([11])));\n        match holder { Choice::Hold(value) => value.get()[0] }\n    });\n    println(comptime {\n        let holder: Nested[i32] = Nested { value: (Ref::new(Vec::from_array([12])), |value| value + 1) };\n        (holder.value.1)(holder.value.0.get()[0])\n    });\n    println(comptime { let holder: Fixed[2] = Fixed { value: [14, 15] }; holder.value[0] });\n    println(comptime { let holder: DynamicHolder[i32] = DynamicHolder { value: true as dyn Read[i32] }; holder.value.read() });\n}\n",
    );
}

#[test]
fn comptime_nested_fields_keep_concrete_type_constraints() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "struct Holder[T] { value: Ref[T] } fn main() -> () { let _ = comptime { let holder: Holder[i32] = Holder { value: Ref::new(true) }; holder.value.get() }; }",
            ),
            "Type mismatch",
        ),
    );
}
