package checker;

use std::testing;

#[test]
fn static_method_candidates_respect_implementation_owner_predicates() -> () {
    let prefix = "trait Left {} trait Right {} impl Left for i32 {} impl Right for bool {} trait First { fn score(self: Self) -> i32; } trait Second { fn score(self: Self) -> i32; } struct Wrap[T] { value: T } impl[T: Left] First for Wrap[T] { fn score(self: Wrap[T]) -> i32 { 1 } } impl[T: Right] Second for Wrap[T] { fn score(self: Wrap[T]) -> i32 { 2 } } ";
    for source in[
        "fn main() -> () { let value = Wrap { value: (7).to_i32() }; let _: i32 = Wrap::[i32]::score(value); }",
        "fn main() -> () { let f = Wrap::[bool]::score; let _: i32 = f(Wrap { value: true }); }",
        "fn call[T: Left](value: Wrap[T]) -> i32 { Wrap::[T]::score(value) } fn main() -> () { let _: i32 = call(Wrap { value: (7).to_i32() }); }",
    ] {
        let _ = checked_file(prefix + source);
    }
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                prefix
                    + "impl Right for i32 {} fn main() -> () { let _ = Wrap::[i32]::score(Wrap { value: (7).to_i32() }); }",
            ),
            "ambiguous method",
        ),
    );
    testing::assert(
        !checked_diagnostics(
            prefix + "fn main() -> () { let _ = Wrap::[string]::score(Wrap { value: \"none\" }); }",
        ).is_empty(),
    );
}

#[test]
fn unresolved_static_owner_obligations_remain_available_for_argument_inference() -> () {
    let _ = checked_file(
        "trait Mark {} impl Mark for i32 {} impl Mark for bool {} trait Score { fn score(self: Self) -> i32; } struct Wrap[T] { value: T } impl[T: Mark] Score for Wrap[T] { fn score(self: Wrap[T]) -> i32 { 7 } } fn main() -> () { let value = Wrap { value: true }; let _: i32 = Wrap::score(value); let f = Wrap::score; let _: i32 = f(value); }",
    );
}
