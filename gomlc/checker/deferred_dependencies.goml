package checker;

use module::tast::{Type, prune};

fn deferred_dependency_snapshot(ctx: Checker, values: Vec[Type]) -> InferenceSnapshot {
    let snapshot = inference_snapshot(values);
    snapshot.include_predicates(ctx.predicates);
    snapshot
}

fn infer_deferred_field(ctx: Checker, constraint: FieldConstraint) -> bool {
    let snapshot = deferred_dependency_snapshot(
        ctx,
        Vec::from_array([constraint.receiver, constraint.field_ty]),
    );
    let diagnostic_start = ctx.diagnostics.len();
    if let Some(ty) = resolve_field_type(ctx, constraint.receiver, constraint.name) {
        expect_type_at(ctx, ty, constraint.field_ty, constraint.span)
    }
    if ctx.diagnostics.len() != diagnostic_start {
        snapshot.restore();
        ctx.diagnostics.truncate(diagnostic_start);
        false
    } else {
        snapshot.changed()
    }
}

fn infer_deferred_coercion(ctx: Checker, constraint: CoercionConstraint) -> bool {
    let snapshot = deferred_dependency_snapshot(
        ctx,
        Vec::from_array([constraint.actual, constraint.expected]),
    );
    let diagnostic_start = ctx.diagnostics.len();
    expect_type_at(ctx, constraint.actual, constraint.expected, constraint.span);
    if ctx.diagnostics.len() != diagnostic_start {
        snapshot.restore();
        ctx.diagnostics.truncate(diagnostic_start);
        false
    } else {
        snapshot.changed()
    }
}

fn infer_deferred_method(ctx: Checker, pending: DeferredMethod) -> bool {
    if pending.resolved.get().is_some() {
        return false
    }
    let Func { params, .. } = prune(pending.ty) else {
        return false
    };
    if params.is_empty() {
        return false
    }
    match prune(params[0]) {
        Var(_) | Error => return false,
        _ => (),
    }
    let snapshot = deferred_dependency_snapshot(ctx, Vec::from_array([pending.ty]));
    snapshot.include_types(pending.explicit);
    let diagnostic_start = ctx.diagnostics.len();
    let required_start = ctx.inference.required_predicates.len();
    let argument_start = ctx.inference.generic_arguments.len();
    let previous_span = ctx.current_span.get();
    ctx.current_span.set(pending.span);
    let result = resolve_deferred_signature(ctx, pending);
    ctx.current_span.set(previous_span);
    if let Some(value) = result {
        if ctx.diagnostics.len() == diagnostic_start && !type_contains_error(value.ty) {
            pending.resolved.set(Some(value));
            update_deferred_facts(ctx.typeck_results, pending.id, value);
            return true
        }
    }
    snapshot.restore();
    ctx.diagnostics.truncate(diagnostic_start);
    ctx.inference.required_predicates.truncate(required_start);
    ctx.inference.generic_arguments.truncate(argument_start);
    false
}

fn infer_deferred_dependencies(ctx: Checker) -> () {
    if ctx.inference.deferred_methods.is_empty() {
        return
    }
    loop {
        let mut changed = false;
        for constraint in ctx.inference.field_constraints {
            if infer_deferred_field(ctx, constraint) {
                changed = true;
            }
        }
        for constraint in ctx.inference.coercion_constraints {
            if infer_deferred_coercion(ctx, constraint) {
                changed = true;
            }
        }
        for pending in ctx.inference.deferred_methods {
            if infer_deferred_method(ctx, pending) {
                changed = true;
            }
        }
        if !changed {
            break
        }
    }
}
