package checker;

use std::testing;

#[test]
fn bounded_static_trait_methods_resolve_with_receiver_access_rules() -> () {
    let _ = checked_file(
        "struct Thing {}\ntrait StaticCount { fn count[const N: usize]() -> usize; }\nimpl StaticCount for Thing { fn count[const M: usize]() -> usize { M } }\ntrait DefaultCount { fn default_count[const N: usize]() -> usize { N } }\nimpl DefaultCount for Thing {}\ntrait Child: StaticCount {}\nimpl Child for Thing {}\ntrait Read { fn read(self: Self) -> usize; }\nimpl Read for Thing { fn read(self: Thing) -> usize { 24 } }\nfn bounded[T: StaticCount]() -> usize { T::count::[20]() }\nfn bounded_default[T: DefaultCount]() -> usize { T::default_count::[21]() }\nfn bounded_value[T: StaticCount]() -> usize { let f = T::count::[22]; f() }\nfn inherited[T: Child]() -> usize { T::count::[23]() }\nfn receiver_ufcs[T: Read](value: T) -> usize { T::read(value) }\nfn main() -> () {\n    println(Thing::count::[19]());\n    println(bounded::[Thing]());\n    println(bounded_default::[Thing]());\n    println(bounded_value::[Thing]());\n    println(inherited::[Thing]());\n    println(receiver_ufcs(Thing {}));\n}\n",
    );
    for source in[
        "trait Count { fn count() -> usize; } fn bad[T: Count](value: T) -> usize { value.count() }",
        "trait One { fn count() -> usize; } trait Two { fn count() -> usize; } fn bad[T: One + Two]() -> usize { T::count() }",
        "trait Count { fn count() -> usize; } fn bad[T]() -> usize { T::count() }",
        "trait Count { fn count[const N: usize]() -> usize; } fn bad[T: Count]() -> usize { T::count() }",
        "trait Count { fn count[const N: usize]() -> usize; } fn bad[T: Count]() -> usize { T::count::[1, 2]() }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}
