package checker;

use std::testing;
use std::text;

fn scalar_coverage_source(skip: isize) -> string {
    let source = text::StringBuilder::new();
    source.write_string("fn choose(value: u8) -> i32 { match value {");
    for value in 0..256 {
        if value != skip {
            source.write_string(f"{value} => 0,")
        }
    }
    source.write_string("} }");
    source.finish()
}

#[test]
fn scalar_coverage_preserves_dense_domains_and_tuple_correlations() -> () {
    testing::assert(checked_diagnostics(scalar_coverage_source(-1)).is_empty());
    let missing = checked_diagnostics(scalar_coverage_source(127));
    testing::assert_eq(missing.len(), 1);
    testing::assert_eq(missing[0].message, "non-exhaustive match: missing pattern 127");
    let source = "fn choose(value: (bool, u8)) -> i32 { match value { (true, 0..=200) => 0, (true, 128..=255) => 1, (false, 0..=126) => 2, (false, 128..=255) => 3, ";
    let missing = checked_diagnostics(source + "} }");
    testing::assert_eq(missing.len(), 1);
    testing::assert_eq(missing[0].message, "non-exhaustive match: missing pattern (false, 127)");
    testing::assert(checked_diagnostics(source + "(false, 127) => 4, } }").is_empty());
}

#[test]
fn scalar_coverage_preserves_extreme_and_disjoint_domain_witnesses() -> () {
    for (source, expected) in[
        (
            "fn choose(value: u64) -> i32 { match value { 0..=18446744073709551614 => 0, } }",
            "non-exhaustive match: missing pattern 18446744073709551615",
        ),
        (
            "fn choose(value: u64) -> i32 { match value { 0..=100 => 0, 50..=200 => 0, 202..=18446744073709551615 => 0, } }",
            "non-exhaustive match: missing pattern 201",
        ),
        (
            "fn choose(value: i64) -> i32 { match value { -9223372036854775808..=-2 => 0, 0..=9223372036854775807 => 1, } }",
            "non-exhaustive match: missing pattern -1",
        ),
        (
            "fn choose(value: char) -> i32 { match value { '\\u0000'..='\\uD7FE' => 0, '\\uE001'..='􏿿' => 1, } }",
            "non-exhaustive match: missing patterns '퟿', ''",
        ),
    ] {
        let diagnostics = checked_diagnostics(source);
        testing::assert_eq(diagnostics.len(), 1);
        testing::assert_eq(diagnostics[0].message, expected);
    }
    testing::assert(
        checked_diagnostics(
            "fn choose(value: u8) -> i32 { match value { 100..=200 => 0, 0..=99 => 1, 201..=255 => 2, } }",
        ).is_empty(),
    );
}
