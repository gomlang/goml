package checker;

use std::testing;
use module::tast::{TraitRef, Type, TypePredicate, builtin_contract};

#[test]
fn growing_trait_requirements_report_recoverable_complexity_diagnostics() -> () {
    for target in["Wrap[Vec[T]]", "Wrap[(T, T)]"] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(
                    "trait Mark {} struct Wrap[T] { value: T } impl[T] Mark for Wrap[T] where "
                        + target
                        + ": Mark {} fn accept[T: Mark](value: T) -> () {} fn main() -> () { accept(Wrap { value: 7 }); }",
                ),
                "Trait predicate search exceeded its complexity limit",
            ),
        );
    }
    for source in[
        "trait Mark[T] {} impl[T] Mark[T] for bool where bool: Mark[(T, T)] {} fn accept[T](value: T) -> () where bool: Mark[T] {} fn main() -> () { accept(7); }",
        "trait Mark {} struct First[T] { value: T } struct Second[T] { value: T } impl[T] Mark for First[T] where Second[Vec[T]]: Mark {} impl[T] Mark for Second[T] where First[Vec[T]]: Mark {} fn accept[T: Mark](value: T) -> () {} fn main() -> () { accept(First { value: 7 }); }",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "Trait predicate search exceeded its complexity limit",
            ),
        );
    }
}

#[test]
fn trait_search_recovers_after_exhaustion_and_keeps_finite_witnesses() -> () {
    let builtin = testing::expect_ok(builtin_contract(), "builtin contract");
    let ctx = collect_environment(
        dependency_hir(
            "package api; trait Mark {} struct Wrap[T] {} impl[T] Mark for Wrap[T] where Wrap[(T, T)]: Mark {} impl Mark for Wrap[i32] {}",
            "audit::api",
        ),
        false,
        builtin,
    );
    let reference = TraitRef { name: "audit::api::Mark", args: Vec::new() };
    let owner = Type::App {
        ty: Type::Con { name: "audit::api::Wrap" },
        args: Vec::from_array([Type::Int32]),
    };
    testing::assert(trait_bound_satisfied_at(ctx, owner, reference, Vec::new()));
    testing::assert(!ctx.inference.trait_search_exhausted.get());
    testing::assert_eq(ctx.inference.trait_search_depth.get(), 0);
    let owner = Type::App {
        ty: Type::Con { name: "audit::api::Wrap" },
        args: Vec::from_array([Type::Bool]),
    };
    testing::assert(!trait_bound_satisfied_at(ctx, owner, reference, Vec::new()));
    testing::assert(ctx.inference.trait_search_exhausted.get());
    testing::assert_eq(ctx.inference.trait_search_depth.get(), 0);
    testing::assert(!trait_bound_satisfied_at(ctx, Type::Bool, reference, Vec::new()));
    testing::assert(!ctx.inference.trait_search_exhausted.get());
    let _ = checked_file(
        "trait Mark {} struct Wrap[T] { value: T } impl Mark for i32 {} impl[T: Mark] Mark for Wrap[T] {} fn accept[T: Mark](value: T) -> i32 { 7 } fn main() -> () { let value: Wrap[Wrap[i32]] = Wrap { value: Wrap { value: 1 } }; println(accept(value)); }",
    );
    testing::assert(
        !checked_diagnostics(
            "trait Mark {} struct Wrap[T] { value: T } impl[T] Mark for Wrap[T] where Wrap[T]: Mark {} fn accept[T: Mark](value: T) -> () {} fn main() -> () { accept(Wrap { value: 7 }); }",
        ).is_empty(),
    );
}

#[test]
fn exhausted_speculative_trait_proofs_do_not_eliminate_candidates() -> () {
    let builtin = testing::expect_ok(builtin_contract(), "builtin contract");
    let ctx = collect_environment(
        dependency_hir(
            "package api; trait Grow {} struct Wrap[T] {} impl[T] Grow for Wrap[T] where Wrap[(T, T)]: Grow {} trait Read { type Item; } impl[T] Read for Wrap[T] where Wrap[T]: Grow { type Item = T; } impl Read for Wrap[i32] { type Item = bool; }",
            "audit::api",
        ),
        false,
        builtin,
    );
    let owner = Type::App {
        ty: Type::Con { name: "audit::api::Wrap" },
        args: Vec::from_array([Type::Int32]),
    };
    let reference = TraitRef { name: "audit::api::Grow", args: Vec::new() };
    let predicate = TypePredicate::Trait { for_ty: owner, trait_ref: reference };
    testing::assert(static_method_owner_predicates_possible(ctx, Vec::from_array([predicate])));
    testing::assert(ctx.diagnostics.is_empty());
    testing::assert(ctx.inference.required_predicates.is_empty());
    testing::assert(
        impl_projection(
            ctx,
            owner,
            "Item",
            Some(TraitRef { name: "audit::api::Read", args: Vec::new() }),
        ).is_none(),
    );
    testing::assert(ctx.inference.trait_search_exhausted.get());
    testing::assert(!predicates_satisfied_at(ctx, Vec::from_array([predicate]), Vec::new()));
    testing::assert(
        predicate_requirement_message(ctx, predicate, "type predicate not satisfied").contains(
            "complexity limit",
        ),
    );
    testing::assert(ctx.diagnostics.is_empty());
}
