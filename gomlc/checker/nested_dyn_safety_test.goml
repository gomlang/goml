package checker;

use std::testing;

#[test]
fn dyn_safety_checks_self_inside_nested_trait_objects() -> () {
    for nested in[
        "dyn Other[Self]",
        "dyn Item[Value = Self]",
        "dyn Mark + Other[Self]",
        "Vec[dyn Other[Self]]",
    ] {
        let declarations = "trait Other[T] {} trait Item { type Value; } trait Mark {} ";
        let returned = declarations + "trait Outer { fn make(self: Self) -> " + nested
            + "; } fn accept(value: dyn Outer) -> () {}";
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(returned),
                "Self is not allowed in return type",
            ),
        );
        let parameter = declarations + "trait Outer { fn accept(self: Self, value: " + nested
            + ") -> (); } fn accept(value: dyn Outer) -> () {}";
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(parameter),
                "Self is not allowed in non-receiver parameters",
            ),
        );
    }
}

#[test]
fn nested_trait_objects_allow_bound_associated_projections() -> () {
    let _ = checked_file(
        "trait Other[T] {} trait Item { type Value; } trait Mark {} trait Outer { type Value; fn make(self: Self) -> dyn Other[Self::Value]; fn accept(self: Self, value: dyn Mark + Item[Value = Self::Value]) -> (); } fn accept(value: dyn Outer[Value = i32]) -> () {}",
    );
}
