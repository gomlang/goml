package checker;

use std::testing;

#[test]
fn comptime_method_values_share_direct_call_resolution() -> () {
    let _ = checked_file(
        "trait Answer { fn answer(self: Self) -> i32; }\nimpl Answer for bool { #[comptime] fn answer(self: Self) -> i32 { 7 } }\ntrait Label[T] { fn label(self: Self) -> i32; }\nimpl Label[i32] for bool { #[comptime] fn label(self: Self) -> i32 { 11 } }\nimpl Label[bool] for bool { #[comptime] fn label(self: Self) -> i32 { 12 } }\ntype Flag = bool;\ntrait Static { fn number() -> i32; }\nimpl Static for bool { #[comptime] fn number() -> i32 { 19 } }\ntrait Second { fn answer(self: Self) -> i32; }\nimpl Second for bool { #[comptime] fn answer(self: Self) -> i32 { 8 } }\nfn main() -> () {\n    println(comptime { Answer::answer(true) });\n    println(comptime { let callback: (bool) -> i32 = Answer::answer; callback(true) });\n    println(comptime { let callback: () -> i32 = Flag::number; callback() });\n    println(comptime { let callback: (bool) -> i32 = Label::[i32]::label; callback(true) });\n    println(comptime { let callback: (bool) -> i32 = Label::[bool]::label; callback(true) });\n    println(comptime {\n        let value = true as dyn Answer + Second;\n        let callback: (dyn Answer + Second) -> i32 = Second::answer;\n        callback(value)\n    });\n    println(comptime { let callback: (i32) -> string = ToString::to_string; callback(23) });\n}\n",
    );
}

#[test]
fn comptime_method_values_reject_runtime_only_implementations() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "trait Answer { fn answer(self: Self) -> i32; } impl Answer for bool { fn answer(self: Self) -> i32 { 7 } } fn main() -> () { let _ = comptime { let callback: (bool) -> i32 = Answer::answer; callback(true) }; }",
            ),
            "comptime trait call requires a concrete #[comptime] method",
        ),
    );
}
