package checker;

use std::testing;
use module::tast::{TraitRef, Type, VarKind};

#[test]
fn overlap_search_backtracks_ambiguous_trait_witnesses() -> () {
    let prefix = "trait First {} trait Second {} trait Pick {} struct A {} struct B {} impl First for A {} impl First for B {} impl Second for B {} ";
    for implementations in[
        "impl[T: First] Pick for T {} impl[T: Second] Pick for T {}",
        "impl[T: Second] Pick for T {} impl[T: First] Pick for T {}",
    ] {
        testing::assert(
            has_diagnostic_containing(checked_diagnostics(prefix + implementations), "overlaps"),
        );
    }
}

#[test]
fn overlap_search_combines_nested_prerequisites_with_remaining_bounds() -> () {
    for source in[
        "trait First {} trait Second {} trait Third {} trait Pick {} struct A {} struct B {} impl First for A {} impl First for B {} impl Second for B {} impl[T: First] Third for T {} impl[T: Third] Pick for T {} impl[T: Second] Pick for T {}",
        "trait First[T] {} trait Second[T] {} trait Pick {} struct A {} struct B {} struct Key {} impl First[A] for Key {} impl First[B] for Key {} impl Second[B] for Key {} impl[T] Pick for T where Key: First[T] {} impl[T] Pick for T where Key: Second[T] {}",
        "trait First {} trait Pick {} impl First for (i32, i32) {} impl[T: Eq] Pick for T {} impl[T: First] Pick for T {}",
        "trait Pick {} impl[T: Eq] Pick for T {} impl[T: Hash] Pick for T {}",
        "trait Pick {} impl[T: Hash] Pick for T {} impl[T: Eq] Pick for T {}",
        "trait Source { type Item; } trait Pick {} struct A {} struct B {} impl Source for A { type Item = bool; } impl Source for B { type Item = i32; } impl[T: Source] Pick for T where T::Item = i32 {} impl Pick for B {}",
    ] {
        testing::assert(has_diagnostic_containing(checked_diagnostics(source), "overlaps"));
    }
}

#[test]
fn overlap_search_keeps_disjoint_implementations_valid() -> () {
    for source in[
        "trait First {} trait Second {} trait Pick {} struct A {} struct B {} struct C {} impl First for A {} impl First for B {} impl Second for C {} impl[T: First] Pick for T {} impl[T: Second] Pick for T {}",
        "trait First {} trait Pick {} impl First for i32 {} impl[T] Pick for T where T = i32 {} impl[T] Pick for T where T = bool {}",
        "trait First {} trait Second {} trait Pick {} impl[T: First] Second for T {} impl[T: Second] First for T {} impl[T: First] Pick for T {} impl[T: Second] Pick for T {}",
        "trait Ready {} trait Walk {} impl[T: Ready] Walk for T {} struct Map[K] { key: K } impl[K: Eq + Hash] Walk for Map[K] {}",
        "trait Ready {} trait Walk {} struct Map[K] { key: K } impl[K: Eq + Hash] Walk for Map[K] {} impl[T: Ready] Walk for T {}",
        "trait One {} trait Two {} trait Three {} trait Four {} trait Five {} trait Six {} trait Pick {} struct A {} struct B {} impl One for A {} impl Two for A {} impl Three for A {} impl Four for B {} impl Five for B {} impl Six for B {} impl[T: One + Two + Three] Pick for T {} impl[T: Four + Five + Six] Pick for T {}",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn overlap_goal_cycles_ignore_variable_ids_but_preserve_sharing() -> () {
    let counter = Ref::new(0);
    let first = fresh_type(counter, VarKind::Any);
    let second = fresh_type(counter, VarKind::Any);
    let third = fresh_type(counter, VarKind::Any);
    let reference = TraitRef { name: "Marker", args: Vec::new() };
    testing::assert_eq(overlap_goal_key(first, reference), overlap_goal_key(second, reference));
    testing::assert_eq(
        overlap_goal_key(Type::Tuple { items: Vec::from_array([first, second]) }, reference),
        overlap_goal_key(Type::Tuple { items: Vec::from_array([second, third]) }, reference),
    );
    testing::assert(
        overlap_goal_key(Type::Tuple { items: Vec::from_array([first, first]) }, reference)
            != overlap_goal_key(Type::Tuple { items: Vec::from_array([second, third]) }, reference),
    );
}
