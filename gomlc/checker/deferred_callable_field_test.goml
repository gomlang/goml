package checker;

use std::testing;

#[test]
fn inferred_receivers_resolve_callable_fields_after_calls() -> () {
    for source in[
        "struct Handler { run: (i32) -> i32 } fn f() -> i32 { let apply = |x| x.run(7); apply(Handler { run: |x| x }) }",
        "struct Handler { run: () -> i32 } fn f() -> i32 { let apply = |x| x.run(); apply(Handler { run: || 7 }) }",
        "struct Handler { run: (i32) -> i32 } struct Wrap { inner: Handler } fn f() -> i32 { let apply = |x| x.inner.run(7); apply(Wrap { inner: Handler { run: |x| x } }) }",
        "struct Handler { run: (i32) -> i32 } impl Handler { fn run(self: Handler, x: i32) -> i32 { x + 1 } } fn f() -> i32 { let apply = |x| x.run(7); apply(Handler { run: |x| x }) }",
    ] {
        if !checked_diagnostics(source).is_empty() {
            testing::fail(source)
        }
    }
}

#[test]
fn inferred_callable_fields_validate_arguments_and_type_arguments() -> () {
    for source in[
        "struct Handler { run: (i32) -> i32 } fn f() -> () { let apply = |x| x.run(true); let _ = apply(Handler { run: |x| x }); }",
        "struct Handler { run: (i32) -> i32 } fn f() -> () { let apply = |x| x.run(); let _ = apply(Handler { run: |x| x }); }",
        "struct Handler { run: i32 } fn f() -> () { let apply = |x| x.run(7); let _ = apply(Handler { run: 1 }); }",
        "struct Handler {} fn f() -> () { let apply = |x| x.run(7); let _ = apply(Handler {}); }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "struct Handler { run: (i32) -> i32 } fn f() -> () { let apply = |x| x.run::[bool](7); let _ = apply(Handler { run: |x| x }); }",
            ),
            "Function-valued fields do not accept generic arguments",
        ),
    );
}
