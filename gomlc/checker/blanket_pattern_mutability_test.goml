package checker;

use std::testing;

#[test]
fn let_mut_normalizes_or_pattern_binding_mutability() -> () {
    for source in[
        "fn f() -> i32 { let mut (mut value | value) = 1; value = 7; value }",
        "fn f() -> i32 { let mut (value | mut value) = 1; value = 7; value }",
        "fn f() -> i32 { let mut ((mut left | left), (right | mut right)) = (1, 2); left += right; right = 4; left + right }",
        "fn f() -> i32 { let mut (value @ _ | mut value) = 1; value = 7; value }",
        "fn f() -> i32 { let mut ([mut value, ..] | [value, ..]) = [1, 2]; value = 7; value }",
        "fn f(input: Option[i32]) -> i32 { let mut (Some(mut value) | Some(value)) = input else { return 0; }; value = 7; value }",
    ] {
        if !checked_diagnostics(source).is_empty() {
            testing::fail(source)
        }
    }
}

#[test]
fn blanket_pattern_mutability_preserves_other_binding_checks() -> () {
    for case in[
        ("fn f() -> i32 { let (mut value | value) = 1; value }", "inconsistent mutability"),
        ("fn f() -> i32 { match 1 { value @ _ | mut value => value } }", "inconsistent mutability"),
        (
            "fn f() -> i32 { let mut (mut first | first) = 1; first = 2; let (mut value | value) = first; value }",
            "inconsistent mutability",
        ),
        (
            "fn f() -> () { let mut ((mut value, _) | (_, value)) = (1, true); }",
            "inconsistent types",
        ),
        (
            "fn f() -> () { let mut (mut left | right) = 1; }",
            "Or-pattern alternatives must bind the same variables",
        ),
    ] {
        if !has_diagnostic_containing(checked_diagnostics(case.0), case.1) {
            testing::fail(case.0 + " expected diagnostic: " + case.1)
        }
    }
}
