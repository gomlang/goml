package checker;

use std::testing;
use module::tast::{Type, TraitRef, builtin_contract, types_equal};

#[test]
fn projection_recursion_guards_distinguish_trait_arguments_and_names() -> () {
    for source in[
        "trait Source[A] { type Item; } impl Source[i32] for bool { type Item = i32; } impl[T: Source[i32]] Source[string] for T where T::Item = i32 { type Item = bool; } fn convert[T: Source[string]](value: T::Item) -> bool where T = bool { value }",
        "trait Source[A] { type Item; } impl Source[i32] for bool { type Item = i32; } impl[T: Source[i32]] Source[string] for T where T::Item = i32 { type Item = bool; } impl[T: Source[string]] Source[bool] for T where T::Item = bool { type Item = string; } fn convert[T: Source[bool]](value: T::Item) -> string where T = bool { value }",
        "trait Input { type Item; } trait Output { type Item; } impl Input for bool { type Item = i32; } impl[T: Input] Output for T where T::Item = i32 { type Item = bool; } fn convert[T: Output](value: T::Item) -> bool where T = bool { value }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn projection_recursion_guards_reject_real_cycles_and_unsatisfied_equalities() -> () {
    for source in[
        "trait Source[A] { type Item; } impl[T: Source[i32]] Source[i32] for T where T::Item = i32 { type Item = i32; } fn convert[T: Source[i32]](value: T::Item) -> i32 where T = bool { value }",
        "trait Source[A] { type Item; } impl Source[i32] for bool { type Item = i32; } impl[T: Source[i32]] Source[string] for T where T::Item = bool { type Item = bool; } fn convert[T: Source[string]](value: T::Item) -> bool where T = bool { value }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}

#[test]
fn active_projection_searches_require_exact_qualified_identity() -> () {
    let ctx = collect_environment(
        dependency_hir(
            "package api; trait Source[A] { type Item; } impl Source[i32] for bool { type Item = i32; }",
            "audit::api",
        ),
        false,
        testing::expect_ok(builtin_contract(), "builtin contract"),
    );
    let reference = TraitRef { name: "audit::api::Source", args: Vec::from_array([Type::Int32]) };
    let projection = Type::Projection {
        for_ty: Type::Bool,
        name: "Item",
        trait_ref: Some(reference),
    };
    let unqualified = Type::Projection { for_ty: Type::Bool, name: "Item", trait_ref: None };
    for active in[
        unqualified,
        Type::Projection {
            for_ty: Type::Bool,
            name: "Item",
            trait_ref: Some(
                TraitRef { name: reference.name, args: Vec::from_array([Type::String]) },
            ),
        },
    ] {
        ctx.inference.active_projections.push(active);
        testing::assert(types_equal(normalize_type(ctx, projection), Type::Int32));
        let _ = ctx.inference.active_projections.pop();
    }
    ctx.inference.active_projections.push(projection);
    testing::assert(types_equal(normalize_type(ctx, projection), projection));
    let _ = ctx.inference.active_projections.pop();
    for pair in[
        (
            Type::Projection { for_ty: projection, name: "Nested", trait_ref: None },
            Type::Projection { for_ty: unqualified, name: "Nested", trait_ref: None },
        ),
        (
            Type::Projection {
                for_ty: Type::Bool,
                name: "Nested",
                trait_ref: Some(TraitRef { name: "Nested", args: Vec::from_array([projection]) }),
            },
            Type::Projection {
                for_ty: Type::Bool,
                name: "Nested",
                trait_ref: Some(TraitRef { name: "Nested", args: Vec::from_array([unqualified]) }),
            },
        ),
    ] {
        testing::assert(!projection_search_types_equal(pair.0, pair.1));
    }
}
