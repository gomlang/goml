package checker;

use std::testing;

#[test]
fn let_else_accepts_divergence_proven_by_type_equalities() -> () {
    for source in[
        "fn f[T](value: Option[i32], exit: T) -> i32 where T = never { let Some(x) = value else { exit }; x }",
        "fn f[T, U](value: Option[i32], exit: T) -> i32 where T = U, U = never { let Some(x) = value else { exit }; x }",
        "trait Exit { type Value; } fn f[T: Exit](value: Option[i32], exit: T::Value) -> i32 where T::Value = never { let Some(x) = value else { exit }; x }",
        "fn stop() -> never { loop {} } fn f(value: Option[i32]) -> i32 { let Some(x) = value else { stop() }; x }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn let_else_rejects_branches_without_a_never_equality() -> () {
    for source in[
        "fn f[T](value: Option[i32], exit: T) -> i32 { let Some(x) = value else { exit }; x }",
        "fn f[T](value: Option[i32], exit: T) -> i32 where T = bool { let Some(x) = value else { exit }; x }",
        "trait Exit { type Value; } fn f[T: Exit](value: Option[i32], exit: T::Value) -> i32 { let Some(x) = value else { exit }; x }",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "`let else` branch must exit the surrounding control flow",
            ),
        );
    }
}

#[test]
fn statement_flow_uses_never_equalities() -> () {
    for source in[
        "fn f[T](exit: T) -> i32 where T = never { exit; }",
        "fn f[T](exit: T) -> i32 where T = never { let _ = exit; }",
        "fn f[T](exit: T) -> i32 where T = never { let mut value = 1; value = exit; }",
        "trait Exit { type Value; } fn f[T: Exit](exit: T::Value) -> i32 where T::Value = never { exit; }",
        "fn f[T](exit: T) -> never where T = never { exit && true }",
        "fn f[T](exit: T) -> never where T = never { !exit }",
    ] {
        let _ = checked_file(source);
    }
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics("fn f[T](value: T) -> i32 where T = bool { value; }"),
            "Type mismatch",
        ),
    );
}
