package checker;

use module::ast;
use module::tast::{TraitRef, Type, TypePredicate, short_name};

struct StaticSelfConstraint {
    owner: Type,
    reference: TraitRef,
    member_kind: string,
    member_name: string,
    span: Option[ast::Span],
}

fn require_static_self(
    ctx: Checker,
    owner: Type,
    reference: TraitRef,
    member_kind: string,
    member_name: string,
) -> () {
    if contains_unbound_any_variable(normalize_type(ctx, owner)) {
        ctx.inference.static_self_constraints.push(
            StaticSelfConstraint {
                owner,
                reference,
                member_kind,
                member_name,
                span: ctx.current_span.get(),
            },
        );
    } else {
        require_predicate(
            ctx,
            TypePredicate::Trait { for_ty: owner, trait_ref: reference },
            "type predicate not satisfied",
        );
    }
}

fn resolve_static_self_constraints(ctx: Checker) -> () {
    for constraint in ctx.inference.static_self_constraints {
        let owner = normalize_type(ctx, constraint.owner);
        if contains_unbound_any_variable(owner) {
            push_diagnostic_at(
                ctx,
                "Could not infer the Self type for " + constraint.member_kind + " "
                    + short_name(constraint.reference.name)
                    + "::"
                    + constraint.member_name,
                constraint.span,
            );
        } else {
            let previous = ctx.current_span.get();
            ctx.current_span.set(constraint.span);
            require_predicate(
                ctx,
                TypePredicate::Trait { for_ty: owner, trait_ref: constraint.reference },
                "type predicate not satisfied",
            );
            ctx.current_span.set(previous);
        }
    }
}
