package checker;

use std::testing;

#[test]
fn named_lengths_use_typed_constant_values() -> () {
    for declaration in[
        "const SIZE: u8 = 255 + 1;",
        "const SIZE: i8 = 127 + 1; const LENGTH: usize = (SIZE + 128.to_i8()).to_usize();",
    ] {
        let name = if declaration.contains("LENGTH") {
            "LENGTH"
        } else {
            "SIZE"
        };
        let _ = checked_file(
            declaration + " fn main() -> () { let values: [i32; " + name + "] = []; }",
        );
    }
}

#[test]
fn named_converted_constants_work_in_signatures_and_arguments() -> () {
    let _ = checked_file(
        "const SIZE: usize = BASE.to_usize(); const BASE: i32 = 2; struct Buffer[const N: usize] { data: [i32; N] } fn accept(value: [i32; SIZE]) -> () {} fn count[const N: usize]() -> usize { N } fn main() -> () { let value: Buffer[SIZE] = Buffer { data: [1, 2] }; accept(value.data); let count = count::[SIZE](); }",
    );
}

#[test]
fn typed_named_lengths_reject_wrong_sizes_and_negative_results() -> () {
    testing::assert(
        !checked_diagnostics(
            "const SIZE: u8 = 255 + 1; fn main() -> () { let values: [i32; SIZE] = [1]; }",
        ).is_empty(),
    );
    testing::assert(
        !checked_diagnostics(
            "const SIZE: i8 = 127 + 1; fn main() -> () { let values: [i32; SIZE] = []; }",
        ).is_empty(),
    );
}

#[test]
fn inherent_named_lengths_use_typed_constant_values() -> () {
    let _ = checked_file(
        "struct Sizes {} impl Sizes { const ZERO: u8 = 255 + 1; const TWO: usize = Sizes::ONE + 1; const ONE: usize = 1; } fn accept(value: [i32; Sizes::TWO]) -> () {} fn main() -> () { let empty: [i32; Sizes::ZERO] = []; accept([1, 2]); }",
    );
    testing::assert(
        !checked_diagnostics(
            "struct Sizes {} impl Sizes { const NEGATIVE: i8 = 127 + 1; } fn main() -> () { let empty: [i32; Sizes::NEGATIVE] = []; }",
        ).is_empty(),
    );
}
