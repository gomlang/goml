package checker;

use std::testing;

#[test]
fn method_signature_bounds_expand_implied_predicates_on_both_sides() -> () {
    for source in[
        "trait Parent {} trait Child: Parent {} trait Main { fn run[T: Child](self) -> i32; } impl Main for bool { fn run[T: Child](self) -> i32 { 1 } }",
        "trait Parent[T] {} trait Child[T]: Parent[Vec[T]] {} trait Main { fn run[T: Child[i32]](self) -> i32; } impl Main for bool { fn run[T: Child[i32]](self) -> i32 { 1 } }",
        "trait Extra {} trait Child { type Item: Extra; } trait Main { fn run[T: Child](self) -> i32; } impl Main for bool { fn run[T: Child](self) -> i32 { 1 } }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn method_signature_bounds_cannot_replace_child_with_parent() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "trait Parent {} trait Child: Parent {} trait Main { fn run[T: Child](self) -> i32; } impl Main for bool { fn run[T: Parent](self) -> i32 { 1 } }",
            ),
            "method bounds do not match",
        ),
    );
}
