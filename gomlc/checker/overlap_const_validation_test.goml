package checker;

use std::testing;

#[test]
fn invalid_const_obligations_cannot_witness_impl_overlap() -> () {
    for constraint in["Fixed[{N - 1}]", "Outer[N]"] {
        let source = "trait Fixed[const N: usize] {} trait Outer[const N: usize] {} impl[const N: usize] Fixed[N] for bool {} impl[const N: usize] Outer[N] for bool where bool: Fixed[{N - 1}] {} trait Pick {} impl[const N: usize] Pick for [i32; N] where bool: "
            + constraint
            + " {} impl Pick for [i32; 0] {}";
        let _ = checked_file(source);
    }
}

#[test]
fn overlap_search_backtracks_after_invalid_const_witnesses() -> () {
    for implementations in[
        "impl Gate[0] for bool {} impl Gate[1] for bool {}",
        "impl Gate[1] for bool {} impl Gate[0] for bool {}",
    ] {
        let source = "trait Fixed[const N: usize] {} trait Gate[const N: usize] {} impl[const N: usize] Fixed[N] for bool {} "
            + implementations
            + " trait Pick {} impl[const N: usize] Pick for [i32; N] where bool: Fixed[{N - 1}] + Gate[N] {} impl[const N: usize] Pick for [i32; N] {}";
        testing::assert(
            has_diagnostic_containing(checked_diagnostics(source), "overlaps with implementation"),
        );
    }
}
