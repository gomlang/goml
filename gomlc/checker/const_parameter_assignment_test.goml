package checker;

use std::testing;

#[test]
fn rejects_assignment_to_const_generic_parameters() -> () {
    for assignment in["N = 3", "N += 1", "N -= 1", "N *= 2", "N <<= 1"] {
        let source = "fn unused[const N: usize]() -> usize { " + assignment + "; N }";
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "cannot assign to const parameter `N`",
            ),
        );
    }
}

#[test]
fn rejects_const_parameter_assignment_in_impls_and_nested_closures() -> () {
    for source in[
        "struct Wrap[const N: usize] {} impl[const N: usize] Wrap[N] { fn change(self: Wrap[N]) -> () { N = 3; } }",
        "struct Wrap {} impl Wrap { fn change[const N: usize](self: Wrap) -> () { N += 1; } }",
        "fn unused[const N: usize]() -> () { let change = || { N = 3; }; change(); }",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "cannot assign to const parameter `N`",
            ),
        );
    }
}

#[test]
fn permits_const_parameter_reads_and_mutable_locals() -> () {
    for source in[
        "fn read[const N: usize]() -> usize { N }",
        "fn copy[const N: usize]() -> usize { let mut count = N; count += 1; count }",
        "fn ordinary() -> usize { let mut count: usize = 3; count = 4; count }",
    ] {
        let _ = checked_file(source);
    }
}
