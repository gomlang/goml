package checker;

use module::tast::{Arm, Block, Expr, Stmt, map_block_exprs, map_child_exprs};

fn normalize_inferred_pattern_expr(value: Expr) -> Expr {
    if let Expr::Block { block, ty } = value {
        return Expr::Block { block: normalize_inferred_pattern_block(block), ty }
    }
    let value = map_child_exprs(value, normalize_inferred_pattern_expr);
    match value {
        Match { expr, arms, coverage, ty } => {
            let normalized: Vec[Arm] = Vec::new();
            for arm in arms {
                normalized.push(
                    Arm {
                        pat: resolve_finalized_pattern(arm.pat, None, Vec::new()),
                        guard: arm.guard,
                        body: arm.body,
                    },
                )
            }
            Match { expr, arms: normalized, coverage, ty }
        },
        For { pat, iterator, into_iter_trait_ref, iterator_trait_ref, iterator_ty, body, ty } => For {
            pat: resolve_finalized_pattern(pat, None, Vec::new()),
            iterator,
            into_iter_trait_ref,
            iterator_trait_ref,
            iterator_ty,
            body,
            ty,
        },
        other => other,
    }
}

fn normalize_inferred_pattern_block(value: Block) -> Block {
    let value = map_block_exprs(value, normalize_inferred_pattern_expr);
    let stmts: Vec[Stmt] = Vec::new();
    for stmt in value.stmts {
        stmts.push(
            match stmt {
                Let { is_mut, pat, value } => Let {
                    is_mut,
                    pat: resolve_finalized_pattern(pat, None, Vec::new()),
                    value,
                },
                LetElse { is_mut, pat, value, else_branch } => LetElse {
                    is_mut,
                    pat: resolve_finalized_pattern(pat, None, Vec::new()),
                    value,
                    else_branch,
                },
                other => other,
            },
        )
    }
    Block { stmts, tail: value.tail }
}
