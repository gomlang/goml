package checker;

use module::tast::{Item, Stmt, Type, expr_type, types_equal};
use std::testing;

#[test]
fn empty_exhaustive_matches_infer_never_without_expected_types() -> () {
    for source in[
        "enum Empty {} fn run(value: Empty) -> () { let result = match value {}; }",
        "enum Empty {} fn run(value: (Empty, i32)) -> () { let result = match value {}; }",
        "enum Empty {} struct Container { value: Empty } fn run(value: Container) -> () { let result = match value {}; }",
        "enum Empty {} fn run(value: [Empty; 1]) -> () { let result = match value {}; }",
        "enum Empty {} enum Box[T] { Value(T) } fn run(value: Box[Empty]) -> () { let result = match value {}; }",
    ] {
        let file = checked_file(source);
        match file.items[0] {
            Item::Function(value) => match value.body.stmts[0] {
                Stmt::Let { value, .. } => testing::assert(
                    types_equal(expr_type(value), Type::Never),
                ),
                _ => testing::fail("expected local binding"),
            },
            _ => testing::fail("expected function"),
        }
    }
}

#[test]
fn empty_matches_still_require_uninhabited_scrutinees() -> () {
    for source in[
        "fn run(value: bool) -> never { match value {} }",
        "enum Empty {} fn run(value: Option[Empty]) -> never { match value {} }",
        "enum Empty {} fn run(value: [Empty; 0]) -> never { match value {} }",
    ] {
        testing::assert(
            has_diagnostic_containing(checked_diagnostics(source), "non-exhaustive match"),
        );
    }
}
