package checker;

use module::tast::{Type, VarKind, map_child_types};

fn closure_contextual_type(ctx: Checker, value: Type) -> Type {
    let value = normalize_type(ctx, value);
    if let Projection { .. } = value {
        if has_unresolved_projection(value) {
            let inferred = fresh_type(ctx.inference.counter, VarKind::Any);
            defer_coercion(ctx, inferred, value);
            return inferred
        }
    }
    map_child_types(value, |child| closure_contextual_type(ctx, child))
}
