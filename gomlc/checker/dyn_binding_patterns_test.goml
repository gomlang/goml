package checker;

use std::testing;

#[test]
fn dyn_values_allow_alias_and_or_binding_patterns() -> () {
    let header = "trait Read { fn read(self: Self) -> bool; } ";
    for source in[
        "fn f(value: dyn Read) -> bool { let copy @ _ = value; copy.read() }",
        "fn f(value: dyn Read) -> bool { match value { copy @ _ => copy.read() } }",
        "fn f(value: dyn Read) -> bool { match value { copy @ _ | copy @ _ => copy.read() } }",
        "fn f(value: dyn Read) -> bool { match value { _ | _ => true } }",
        "fn f(value: dyn Read) -> bool { let outer @ inner @ _ = value; outer.read() && inner.read() }",
    ] {
        let _ = checked_file(header + source);
    }
}

#[test]
fn dyn_binding_wrappers_do_not_allow_destructuring() -> () {
    let header = "trait Read { fn read(self: Self) -> bool; } ";
    for source in[
        "fn f(value: dyn Read) -> bool { match value { copy @ true => true, _ => false } }",
        "fn f(value: dyn Read) -> bool { match value { true | false => true, _ => false } }",
        "fn f(value: dyn Read) -> bool { match value { copy @ (_, _) => true, _ => false } }",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(header + source),
                "Pattern matching on dyn Read is not supported",
            ),
        );
    }
}
