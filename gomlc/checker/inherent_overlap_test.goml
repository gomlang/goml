package checker;

use module::ast;
use module::hir;
use module::parser;
use std::testing;

#[test]
fn inherent_members_require_disjoint_owner_implementations() -> () {
    for source in[
        "struct Value {} impl Value { fn read() -> i32 { 1 } } impl Value { fn read() -> i32 { 2 } }",
        "struct Value {} impl Value { fn read() -> i32 { 1 } } impl Value { fn read() -> bool { true } }",
        "struct Value[T] { value: T } impl[T] Value[T] { fn read() -> i32 { 1 } } impl Value[i32] { fn read() -> i32 { 2 } }",
        "struct Value[const N: usize] {} impl[const N: usize] Value[N] { fn read() -> i32 { 1 } } impl Value[2] { fn read() -> i32 { 2 } }",
        "struct Value {} type Alias = Value; impl Value { fn read() -> i32 { 1 } } impl Alias { fn read() -> i32 { 2 } }",
        "struct Value {} impl Value { const read: i32 = 1; } impl Value { const read: i32 = 2; }",
        "struct Value {} impl Value { const read: i32 = 1; } impl Value { fn read() -> i32 { 2 } }",
    ] {
        if !has_diagnostic_containing(
            checked_diagnostics(source),
            "Inherent member read has overlapping implementations",
        ) {
            testing::fail(source)
        }
    }
}

#[test]
fn inherent_member_overlap_search_checks_owner_predicate_intersections() -> () {
    for implementations in[
        "impl[T: First] Value[T] { fn read() -> i32 { 1 } } impl[T: Second] Value[T] { fn read() -> i32 { 2 } }",
        "impl[T: Second] Value[T] { fn read() -> i32 { 2 } } impl[T: First] Value[T] { fn read() -> i32 { 1 } }",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(
                    "trait First {} trait Second {} impl First for i32 {} impl First for bool {} impl Second for bool {} struct Value[T] { value: T } "
                        + implementations,
                ),
                "Inherent member read has overlapping implementations",
            ),
        );
    }
}

#[test]
fn disjoint_inherent_specializations_and_distinct_members_remain_valid() -> () {
    for source in[
        "struct Value[T] { value: T } impl Value[i32] { fn read() -> i32 { 1 } } impl Value[bool] { fn read() -> i32 { 2 } }",
        "struct Value[const N: usize] {} impl Value[1] { fn read() -> i32 { 1 } } impl Value[2] { fn read() -> i32 { 2 } }",
        "struct Value[T] { value: T } impl[T] Value[T] where T = i32 { fn read() -> i32 { 1 } } impl[T] Value[T] where T = bool { fn read() -> i32 { 2 } }",
        "trait First {} trait Second {} impl First for i32 {} impl Second for bool {} struct Value[T] { value: T } impl[T: First] Value[T] { fn read() -> i32 { 1 } } impl[T: Second] Value[T] { fn read() -> i32 { 2 } }",
        "struct Value {} impl Value { fn first() -> i32 { 1 } } impl Value { fn second() -> i32 { 2 } }",
        "trait Read { fn read(self) -> i32; } struct Value {} impl Read for Value { fn read(self) -> i32 { 1 } } impl Value { fn read(self) -> i32 { 2 } }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn inherent_constant_and_method_names_share_the_member_namespace() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "struct Value {} impl Value { const read: i32 = 1; fn read() -> i32 { 2 } }",
            ),
            "implemented multiple times in impl for Value",
        ),
    );
}

#[test]
fn inherent_member_overlap_is_checked_across_package_files() -> () {
    let parsed = Vec::from_array(
        [
            parser::parse("package values; struct Value {} impl Value { fn read() -> i32 { 1 } }"),
            parser::parse("package values; impl Value { fn read() -> i32 { 2 } }"),
        ],
    );
    let ast_files = ast::lower_package(parsed);
    let inputs: Vec[(ast::LowerResult, string)] = Vec::from_array(
        [(ast_files[0], "first.goml"), (ast_files[1], "second.goml")],
    );
    let files: Vec[hir::File] = Vec::new();
    for lowered in hir::lower_package_files(inputs, "example::values") {
        match lowered.hir {
            Some(file) => files.push(file),
            None => testing::fail("expected inherent implementation HIR"),
        }
    }
    let checked = check_package_files_for_link_with_dependencies(files, Vec::new());
    testing::assert(
        has_diagnostic_containing(
            checked.diagnostics,
            "Inherent member read has overlapping implementations",
        ),
    );
}
