package checker;

#[test]
fn unit_constants_are_recursively_immutable() -> () {
    let _ = checked_file(
        "const UNIT: () = (); const PAIR: ((), i32) = (UNIT, 42); const VALUES: [(); 2] = [UNIT, ()]; struct Wrap { value: () } const WRAPPED: Wrap = Wrap { value: UNIT }; fn main() -> () { let _: () = UNIT; let _: () = VALUES[0]; let _: () = WRAPPED.value; println(PAIR.1); }",
    );
}
