package checker;

use module::tast::{Type, prune};

fn projection_operand_type(ctx: Checker, receiver: Type, index: isize) -> Option[Type] {
    match prune(normalize_type(ctx, receiver)) {
        Tuple { items } => if index >= 0 && index < items.len() {
            Some(items[index])
        } else {
            None
        },
        other => resolve_field_type(ctx, other, f"_{index}"),
    }
}

fn infer_deferred_projection(ctx: Checker, constraint: ProjectionConstraint) -> bool {
    let snapshot = deferred_dependency_snapshot(
        ctx,
        Vec::from_array([constraint.receiver, constraint.result_ty]),
    );
    let diagnostic_start = ctx.diagnostics.len();
    if let Some(ty) = projection_operand_type(ctx, constraint.receiver, constraint.index) {
        expect_type_at(ctx, ty, constraint.result_ty, constraint.span);
    }
    if ctx.diagnostics.len() != diagnostic_start {
        snapshot.restore();
        ctx.diagnostics.truncate(diagnostic_start);
        false
    } else {
        snapshot.changed()
    }
}

fn resolve_projection_constraints(ctx: Checker) -> () {
    for constraint in ctx.inference.projection_constraints {
        match projection_operand_type(ctx, constraint.receiver, constraint.index) {
            Some(ty) => expect_type_at(ctx, ty, constraint.result_ty, constraint.span),
            None => if !type_contains_error(constraint.receiver) {
                let message = match prune(normalize_type(ctx, constraint.receiver)) {
                    Tuple { .. } => f"Tuple index {constraint.index} out of bounds",
                    _ => if contains_unbound_type_variable(constraint.receiver) {
                        "Could not infer the base type for tuple projection"
                    } else {
                        "tuple or tuple struct required"
                    },
                };
                push_diagnostic_at(ctx, message, constraint.span)
            },
        }
    }
}
