package checker;

use module::diagnostic::{DiagnosticSeverity};
use std::testing;

#[test]
fn go_operands_infer_zero_argument_unit_functions() -> () {
    for source in[
        "fn main() -> () { let launch = |task| { go task; }; launch(|| ()); }",
        "fn main() -> () { let launch = |task| { go task; }; let callback: () -> () = || (); launch(callback); }",
        "fn main() -> () { let launch = |task| { go task; }; launch(|| loop {}); }",
        "fn run[T](task: T) -> () where T = () -> () { go task; }",
        "fn stop[T]() -> T { loop {} } fn main() -> () { go stop; }",
        "trait Ready {} impl Ready for () {} fn stop[T: Ready]() -> T { loop {} } fn main() -> () { go stop; }",
    ] {
        for diagnostic in checked_diagnostics(source) {
            if let DiagnosticSeverity::Error = diagnostic.severity {
                testing::fail(source + "\n" + diagnostic.message);
            }
        }
    }
}

#[test]
fn inferred_go_operands_preserve_callback_arity_and_result_types() -> () {
    for source in[
        "fn main() -> () { let launch = |task| { go task; }; launch(7); }",
        "fn main() -> () { let launch = |task| { go task; }; launch(|x: i32| ()); }",
        "fn main() -> () { let launch = |task| { go task; }; launch(|| 7); }",
        "fn run[T](task: T) -> () { go task; }",
        "fn stop() -> never { loop {} } fn main() -> () { go stop; }",
        "trait Ready {} fn stop[T: Ready]() -> T { loop {} } fn main() -> () { go stop; }",
    ] {
        let mut found = false;
        for diagnostic in checked_diagnostics(source) {
            if let DiagnosticSeverity::Error = diagnostic.severity {
                found = true;
            }
        }
        if !found {
            testing::fail(source);
        }
    }
}
