package checker;

use std::testing;

#[test]
fn concrete_trait_associated_functions_reject_method_syntax() -> () {
    let prefix = "trait Static { fn count(value: i32) -> i32; } impl Static for i32 { fn count(value: i32) -> i32 { value + 1 } } ";
    for body in[
        "fn f() -> i32 { 7.count() }",
        "fn f(value: i32) -> i32 { value.count() }",
        "fn f() -> i32 { let run = |value| value.count(); run(7) }",
        "fn f[T: Static](value: T) -> i32 { value.count() }",
        "fn f(value: i32) -> () { let method = value.count; }",
    ] {
        testing::assert(!checked_diagnostics(prefix + body).is_empty());
    }
    testing::assert(
        !checked_diagnostics(
            "type Identity[T] = T; trait Static { fn count(value: Identity[Self]) -> i32; } struct Value {} impl Static for Value { fn count(value: Identity[Self]) -> i32 { 7 } } fn f() -> i32 { Value {}.count() }",
        ).is_empty(),
    );
}

#[test]
fn static_trait_members_do_not_shadow_real_receiver_candidates() -> () {
    let prefix = "type Int = i32; trait Static { fn count(value: i32) -> i32; } trait Instance { fn count(self: Self) -> i32; } impl Static for i32 { fn count(value: i32) -> i32 { value + 1 } } impl Instance for i32 { fn count(self: Self) -> i32 { self + 2 } } ";
    for body in[
        "fn f() -> i32 { 7.count() }",
        "fn f(value: i32) -> i32 { value.count() }",
        "fn f() -> i32 { let run = |value| value.count(); run(7) }",
        "fn f[T: Static + Instance](value: T) -> i32 { value.count() }",
        "fn f[T: Static](value: i32) -> i32 { let count = T::count; count(value) }",
        "fn make() -> impl Static + Instance { let value: i32 = 7; value } fn f() -> i32 { make().count() }",
        "fn f() -> i32 { let value = 7 as dyn Instance; value.count() }",
    ] {
        if !checked_diagnostics(prefix + body).is_empty() {
            testing::fail(body)
        }
    }
    let _ = checked_file(
        "type Int = i32; trait Static { fn count(value: i32) -> i32; } impl Static for i32 { fn count(value: i32) -> i32 { value + 1 } } fn f() -> i32 { let count = Int::count; count(7) }",
    );
}

#[test]
fn static_trait_implementations_preserve_declared_receiver_kinds() -> () {
    for source in[
        "trait Static { fn count(value: i32) -> i32; } impl Static for i32 { fn count(self: Self) -> i32 { self } }",
        "trait Instance { fn count(self: Self) -> i32; } impl Instance for i32 { fn count(value: i32) -> i32 { value } }",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "impl must preserve the trait method receiver",
            ),
        );
    }
}

#[test]
fn inherent_associated_functions_require_explicit_self_for_dot_calls() -> () {
    let prefix = "struct Value { number: i32 } impl Value { fn static_read(value: Self) -> i32 { value.number } fn read(self: Self) -> i32 { self.number } } ";
    for body in[
        "fn f(value: Value) -> i32 { value.static_read() }",
        "fn f() -> i32 { let run = |value| value.static_read(); run(Value { number: 7 }) }",
        "fn f(value: Value) -> () { let read = value.static_read; }",
    ] {
        testing::assert(!checked_diagnostics(prefix + body).is_empty());
    }
    let _ = checked_file(
        prefix
            + "fn f(value: Value) -> i32 { let static_read = Value::static_read; static_read(value) + value.read() }",
    );
    let _ = checked_file(
        "struct Value { number: i32 } impl Value { fn read(value: Self) -> i32 { value.number + 1 } } trait Read { fn read(self: Self) -> i32; } impl Read for Value { fn read(self: Self) -> i32 { self.number + 2 } } fn f(value: Value) -> i32 { value.read() }",
    );
    let _ = checked_file(
        "trait Defaults { fn static_read(value: i32) -> i32 { value + 1 } fn read(self: Self) -> i32 { 7 } } impl Defaults for i32 {} fn f(value: i32) -> i32 { value.read() }",
    );
    testing::assert(
        !checked_diagnostics(
            "trait Defaults { fn static_read(value: i32) -> i32 { value + 1 } } impl Defaults for i32 {} fn f(value: i32) -> i32 { value.static_read() }",
        ).is_empty(),
    );
}
