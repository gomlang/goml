package checker;

use module::ast;
use module::hir;

fn validate_source_trait_name(ctx: Checker, name: string, span: Option[ast::Span]) -> () {
    let name = canonical_imported_name(ctx, name);
    if ctx.proof_trait_names.contains(name) {
        push_diagnostic_at(ctx, "Trait " + name + " is private to its defining package", span);
    }
}

fn attach_predicate_diagnostic_spans(ctx: TypeDiagnosticSpans, values: Vec[hir::Predicate]) -> () {
    for value in values {
        match value {
            Trait { ty, trait_ref } => {
                attach_type_diagnostic_span(ctx, ty);
                attach_trait_ref_diagnostic_spans(ctx, trait_ref);
            },
            Equality { lhs, rhs } => {
                attach_type_diagnostic_span(ctx, lhs);
                attach_type_diagnostic_span(ctx, rhs);
            },
        }
    }
}
