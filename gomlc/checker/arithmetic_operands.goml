package checker;

use module::ast;
use module::tast::{Type, binary_symbol, resolve_type};

fn require_arithmetic_operand(ctx: Checker, ty: Type, op: ast::BinaryOp, span: ast::Span) -> () {
    let ty = normalize_type(ctx, ty);
    if is_unbound_any_type(ty) {
        ctx.inference.arithmetic_operand_constraints.push(
            ArithmeticOperandConstraint { ty, op, span },
        );
    } else if !arithmetic_operand_allowed(ctx, op, ty) {
        push_operator_not_defined(ctx, op, ty, span)
    }
}

fn resolve_arithmetic_operand_constraints(ctx: Checker) -> () {
    for constraint in ctx.inference.arithmetic_operand_constraints {
        let ty = normalize_type(ctx, constraint.ty);
        if is_unbound_any_type(ty) {
            push_diagnostic_at(
                ctx,
                "Could not infer the operand type for operator " + binary_symbol(constraint.op),
                Some(constraint.span),
            );
        } else if !arithmetic_operand_allowed(ctx, constraint.op, resolve_type(ty)) {
            push_operator_not_defined(ctx, constraint.op, resolve_type(ty), constraint.span)
        }
    }
}
