package checker;

use std::testing;

#[test]
fn default_method_signatures_merge_associated_definitions_with_generic_equalities() -> () {
    for source in[
        "trait Main { type Item; fn get[T](self, value: T) -> Self::Item where Self::Item = T { value } } impl Main for bool { type Item = i32; }",
        "trait Main { type Item; fn get[T](self, value: Self::Item) -> T where Self::Item = T { value } } impl Main for bool { type Item = i32; }",
        "trait Main { type Item; fn get[T](self, value: Vec[T]) -> Self::Item where Self::Item = Vec[T] { value } } impl Main for bool { type Item = Vec[i32]; }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn default_method_associated_equalities_still_constrain_calls_and_overrides() -> () {
    for source in[
        "trait Main { type Item; fn get[T](self, value: T) -> Self::Item where Self::Item = T { value } } impl Main for bool { type Item = i32; } fn main() -> () { let _ = true.get(false); }",
        "trait Main { type Item; fn get[T](self, value: T) -> Self::Item where Self::Item = T; } impl Main for bool { type Item = i32; fn get[T](self, value: T) -> string where Self::Item = T { \"wrong\" } }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}
