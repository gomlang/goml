package checker;

use module::ast;
use module::diagnostic::{diagnostics_have_errors};
use module::hir;
use module::parser;
use std::testing;

fn checked_implementation_ownership(sources: Vec[string]) -> CheckResult {
    let dependency = checked_dependency_environment(
        "package api; pub trait Read {} pub struct Value {} pub struct Wrapper[T] { pub value: T } pub enum Choice { One, Two }",
        "ownership::api",
    );
    let parsed = Vec::new();
    for source in sources {
        parsed.push(parser::parse(source))
    }
    let lowered = ast::lower_package(parsed);
    let inputs: Vec[(ast::LowerResult, string)] = Vec::new();
    for index in 0..lowered.len() {
        inputs.push((lowered[index], f"ownership_{index}.goml"))
    }
    let files: Vec[hir::File] = Vec::new();
    for result in hir::lower_package_files(inputs, "ownership::consumer") {
        testing::assert(result.diagnostics.is_empty());
        files.push(testing::expect_some(result.hir, "expected ownership package HIR"))
    }
    check_package_files_for_link_with_environments(files, Vec::from_array([dependency]))
}

#[test]
fn trait_impls_require_a_local_trait_or_nominal_target() -> () {
    for body in[
        "impl api::Read for api::Value {}",
        "impl api::Read for api::Choice {}",
        "type Alias = api::Value; impl api::Read for Alias {}",
        "struct Local {} impl api::Read for api::Wrapper[Local] {}",
        "impl api::Read for i32 {}",
        "impl[T] api::Read for T {}",
        "trait Read {} impl api::Read for api::Value {}",
        "#[go_type(\"time\", \"Time\")] extern type Stamp; impl api::Read for Stamp {}",
    ] {
        let result = checked_implementation_ownership(
            Vec::from_array(["package consumer; use ownership::api; " + body]),
        );
        testing::assert(has_diagnostic_containing(result.diagnostics, "Orphan implementation:"));
    }
}

#[test]
fn inherent_impls_cannot_extend_foreign_targets_through_aliases() -> () {
    for body in[
        "impl api::Value {}",
        "type Alias = api::Value; impl Alias {}",
        "struct Local {} impl api::Wrapper[Local] {}",
        "impl i32 {}",
        "#[go_type(\"time\", \"Time\")] extern type Stamp; impl Stamp {}",
    ] {
        let result = checked_implementation_ownership(
            Vec::from_array(["package consumer; use ownership::api; " + body]),
        );
        testing::assert(
            has_diagnostic_containing(
                result.diagnostics,
                "must be a nominal type defined in the current package",
            ),
        );
    }
}

#[test]
fn local_traits_nominal_types_and_aliases_preserve_valid_impls() -> () {
    for body in[
        "trait Local {} impl Local for api::Value {}",
        "trait Local {} impl Local for i32 {}",
        "trait Local {} impl[T] Local for T {}",
        "struct Local {} impl api::Read for Local {} impl Local {}",
        "enum Local { One, Two } impl api::Read for Local {} impl Local {}",
        "struct Local[T] { value: T } impl api::Read for Local[api::Value] {} impl[T] Local[T] {}",
        "struct Local {} type Alias = Local; impl api::Read for Alias {} impl Alias {}",
        "trait Local {} #[go_type(\"time\", \"Time\")] extern type Stamp; impl Local for Stamp {}",
    ] {
        let result = checked_implementation_ownership(
            Vec::from_array(["package consumer; use ownership::api; " + body]),
        );
        if diagnostics_have_errors(result.diagnostics) {
            for diagnostic in result.diagnostics {
                testing::fail(diagnostic.message)
            }
        }
    }
    let _ = checked_file(
        "trait Local {} impl Local for bool {} struct Value {} impl Value { fn read(self: Value) -> i32 { 7 } }",
    );
}

#[test]
fn implementation_ownership_spans_every_file_of_the_current_package() -> () {
    let result = checked_implementation_ownership(
        Vec::from_array(
            [
                "package consumer; trait LocalRead {} struct LocalValue {}",
                "package consumer; use ownership::api; impl LocalRead for api::Value {} impl api::Read for LocalValue {} impl LocalValue {}",
            ],
        ),
    );
    if diagnostics_have_errors(result.diagnostics) {
        for diagnostic in result.diagnostics {
            testing::fail(diagnostic.message)
        }
    }
}
