package checker;

use std::testing;

#[test]
fn integer_literals_validate_floating_point_ranges() -> () {
    for literal in[
        "340282400000000000000000000000000000000",
        "-340282400000000000000000000000000000000",
    ] {
        for source in[
            "fn main() -> () { let value: f32 = " + literal + "; let _ = value; }",
            "fn main() -> () { let value = " + literal
                + "; let final_value: f32 = value; let _ = final_value; }",
        ] {
            testing::assert(
                has_diagnostic_containing(checked_diagnostics(source), "does not fit in f32"),
            );
        }
    }
    let huge = "";
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics("fn main() -> () { let value: f64 = " + huge + "; let _ = value; }"),
            "does not fit in f64",
        ),
    );
    for source in[
        "fn main() -> () { let value: f32 = 340282300000000000000000000000000000000; let _ = value; }",
        "fn main() -> () { let value = 340282300000000000000000000000000000000; let final_value: f32 = value; let _ = final_value; }",
        "fn main() -> () { let value: f64 = 340282400000000000000000000000000000000; let _ = value; }",
    ] {
        let _ = checked_file(source);
    }
}
