package checker;

use module::tast::{TraitRef, Type, any_child_type, any_type, prune};

fn reset_trait_search_if_idle(ctx: Checker) -> () {
    if ctx.inference.trait_search_depth.get() == 0 {
        ctx.inference.trait_search_remaining.set(8192);
        ctx.inference.trait_search_steps.set(8192);
        ctx.inference.trait_search_exhausted.set(false);
    }
}

fn trait_search_type_exceeds(ctx: Checker, value: Type, depth: isize) -> bool {
    if depth >= 256 || ctx.inference.trait_search_remaining.get() <= 0 {
        return true
    }
    ctx.inference.trait_search_remaining.set(ctx.inference.trait_search_remaining.get() - 1);
    any_child_type(prune(value), |child| trait_search_type_exceeds(ctx, child, depth + 1))
}

fn trait_bound_satisfied_at(ctx: Checker, bound_ty: Type, reference: TraitRef, goals: Vec[string]) -> bool {
    reset_trait_search_if_idle(ctx);
    let remaining = ctx.inference.trait_search_remaining.get();
    let steps = ctx.inference.trait_search_steps.get();
    if steps > 0 {
        ctx.inference.trait_search_steps.set(steps - 1)
    }
    if steps <= 0 || ctx.inference.trait_search_depth.get() >= 256
        || trait_search_type_exceeds(ctx, bound_ty, 0)
        || any_type(reference.args, |arg| trait_search_type_exceeds(ctx, arg, 0)) {
        ctx.inference.trait_search_remaining.set(remaining);
        ctx.inference.trait_search_exhausted.set(true);
        return false
    }
    let previous_exhausted = ctx.inference.trait_search_exhausted.get();
    ctx.inference.trait_search_exhausted.set(false);
    let snapshot = inference_snapshot(Vec::from_array([bound_ty]));
    snapshot.include_types(reference.args);
    snapshot.include_predicates(ctx.predicates);
    ctx.inference.trait_search_depth.set(ctx.inference.trait_search_depth.get() + 1);
    let satisfied = trait_bound_satisfied_inner_at(ctx, bound_ty, reference, goals);
    ctx.inference.trait_search_depth.set(ctx.inference.trait_search_depth.get() - 1);
    ctx.inference.trait_search_remaining.set(remaining);
    ctx.inference.trait_search_exhausted.set(
        previous_exhausted || (!satisfied && ctx.inference.trait_search_exhausted.get()),
    );
    if !satisfied {
        snapshot.restore()
    }
    satisfied
}
