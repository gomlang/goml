package checker;

use std::testing;

#[test]
fn comptime_recursive_type_layouts_report_recoverable_diagnostics() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "enum List { End, Link(Ref[List]) } fn main() -> () { let _ = comptime { let value = List::End; match value { End => 7, Link(_) => 8 } }; }",
            ),
            "recursive types are not available in comptime",
        ),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "struct First { next: Ref[Second] } struct Second { next: Ref[First] } #[comptime] fn inspect(value: First) -> i32 { 7 }",
            ),
            "recursive types are not available in comptime",
        ),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "enum Tree { Leaf, Branch(Vec[Tree]) } #[comptime] fn inspect(value: Tree) -> i32 { 7 }",
            ),
            "recursive types are not available in comptime",
        ),
    );
}

#[test]
fn comptime_growing_generic_type_layouts_stop_at_structural_limits() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "struct Grow[T] { next: Ref[Grow[(T, T)]] } #[comptime] fn inspect(value: Grow[i32]) -> i32 { 7 }",
            ),
            "comptime type expansion node limit exceeded",
        ),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "struct Grow[T] { next: Ref[Grow[Ref[T]]] } #[comptime] fn inspect(value: Grow[i32]) -> i32 { 7 }",
            ),
            "comptime type expansion depth limit exceeded",
        ),
    );
}
