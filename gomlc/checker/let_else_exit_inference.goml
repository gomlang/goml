package checker;

use module::tast::{Expr, Stmt, expr_type, strict_expr_inputs};

fn let_else_expr_exits(ctx: Checker, value: Expr) -> bool {
    if tast_expr_never(ctx, value) {
        return true
    }
    for input in strict_expr_inputs(value) {
        if let_else_expr_exits(ctx, input) {
            return true
        }
    }
    match value {
        Block { block, .. } => {
            for stmt in block.stmts {
                let exits = match stmt {
                    Stmt::Let { value, .. } | Stmt::LetElse { value, .. } => let_else_expr_exits(
                        ctx,
                        value,
                    ),
                    Stmt::Assign { target, value, .. } => let_else_expr_exits(ctx, target)
                        || let_else_expr_exits(ctx, value),
                    Stmt::Expr { expr } => let_else_expr_exits(ctx, expr),
                    Stmt::Defer { .. } => false,
                };
                if exits {
                    return true
                }
            }
            block.tail.map(|tail| let_else_expr_exits(ctx, tail)).unwrap_or(false)
        },
        If { then_branch, else_branch, .. } => let_else_expr_exits(ctx, then_branch)
            && let_else_expr_exits(ctx, else_branch),
        Match { expr, arms, .. } => {
            for arm in arms {
                if !let_else_expr_exits(ctx, arm.body)
                    && !arm.guard.map(|guard| let_else_expr_exits(ctx, guard)).unwrap_or(false) {
                    return false
                }
            }
            match_is_exhaustive(coverage_context(ctx), expr_type(expr), arms)
        },
        _ => false,
    }
}

fn resolve_let_else_exit_constraints(ctx: Checker) -> () {
    for constraint in ctx.inference.let_else_exit_constraints {
        let value = resolve_deferred_expr(ctx, constraint.value);
        if !let_else_expr_exits(ctx, value) {
            push_diagnostic_at(
                ctx,
                "`let else` branch must exit the surrounding control flow",
                Some(constraint.span),
            )
        }
    }
}
