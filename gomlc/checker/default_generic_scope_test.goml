package checker;

use std::testing;

#[test]
fn default_method_generics_do_not_capture_impl_parameters() -> () {
    for source in[
        "trait Identity { fn identity[T](self: Self, value: T) -> T { value } } struct Holder[T] { value: T } impl[T] Identity for Holder[T] {} fn main() -> () { let value = Holder { value: 42 }; let _: bool = value.identity(true); }",
        "trait Identity { fn identity[T](self: Self, value: T) -> T { value } } struct Holder[T] { value: T } impl[U] Identity for Holder[U] {} fn main() -> () { let value = Holder { value: 42 }; let _: bool = value.identity(true); }",
        "trait Identity { fn identity[const N: usize](self: Self, value: [i32; N]) -> [i32; N] { value } } struct Holder[const N: usize] { value: [i32; N] } impl[const N: usize] Identity for Holder[N] {} fn main() -> () { let value = Holder { value: [1, 2] }; let _: [i32; 3] = value.identity([3, 4, 5]); }",
        "trait Marker {} impl Marker for bool {} trait Identity { fn identity[T: Marker](self: Self, value: T) -> T { value } } struct Holder[T] { value: T } impl[T] Identity for Holder[T] {} fn main() -> () { let value = Holder { value: 42 }; let _: bool = value.identity(true); }",
    ] {
        let _ = checked_file(source);
    }
    testing::assert(
        !checked_diagnostics(
            "trait Marker {} impl Marker for i32 {} trait Identity { fn identity[T: Marker](self: Self, value: T) -> T { value } } struct Holder[T] { value: T } impl[T] Identity for Holder[T] {} fn main() -> () { let value: Holder[i32] = Holder { value: 42 }; let _: bool = value.identity(true); }",
        ).is_empty(),
    );
}
