package checker;

use std::testing;
use module::tast::{Type, TypePredicate, builtin_contract};

#[test]
fn ordinary_function_map_keys_are_rejected_through_value_containers() -> () {
    let ctx = collect_environment(
        dependency_hir(
            "package api; struct Key { callback: () -> () } struct Wrap[T] { value: T }",
            "audit::api",
        ),
        false,
        testing::expect_ok(builtin_contract(), "builtin contract"),
    );
    let callback = Type::Func { params: Vec::new(), ret_ty: Type::Unit };
    for key in[
        callback,
        Type::Array { len: 0, elem: callback },
        Type::Array { len: 2, elem: callback },
        Type::Tuple { items: Vec::from_array([Type::Int32, callback]) },
        Type::Con { name: "audit::api::Key" },
        Type::App { ty: Type::Con { name: "audit::api::Wrap" }, args: Vec::from_array([callback]) },
    ] {
        testing::assert(go_map_key_uncomparable(ctx, key, Vec::new()));
        testing::assert(!go_comparable_satisfied(ctx, key));
        testing::assert(invalid_go_map_key(ctx, Type::GoMap { key, value: Type::Bool }).is_some());
    }
    for key in[
        Type::GoPointer { elem: callback },
        Type::RefType { elem: callback },
        Type::VecType { elem: callback },
    ] {
        testing::assert(!go_map_key_uncomparable(ctx, key, Vec::new()));
        testing::assert(go_comparable_satisfied(ctx, key));
    }
}

#[test]
fn generic_map_key_predicates_reject_ordinary_function_instantiations() -> () {
    let ctx = collect_environment(
        dependency_hir("package api; fn accept[T](value: T) -> () {}", "audit::api"),
        false,
        testing::expect_ok(builtin_contract(), "builtin contract"),
    );
    let function = ctx.functions[0];
    function.predicates.push(TypePredicate::GoComparable(Type::Param { name: "T" }));
    let callback = Type::Func { params: Vec::from_array([Type::Int32]), ret_ty: Type::Bool };
    let candidate = instantiate_scheme_candidate(ctx, function, Vec::from_array([callback]));
    testing::assert(!predicates_satisfied_at(ctx, candidate.predicates, Vec::new()));
    let inferred = instantiate_scheme_candidate(ctx, function, Vec::new());
    if let Func { params, .. } = inferred.ty {
        testing::assert(unify(params[0], callback));
    }
    testing::assert(!predicates_satisfied_at(ctx, inferred.predicates, Vec::new()));
}
