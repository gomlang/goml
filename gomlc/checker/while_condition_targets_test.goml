package checker;

use std::testing;

#[test]
fn while_conditions_reject_exits_to_targets_outside_the_condition() -> () {
    for case in[
        (
            "fn f() -> i32 { 'outer: loop { while (loop { break 'outer 7; }) {} } }",
            "`break` is not allowed in a while condition",
        ),
        (
            "fn f(flag: bool) -> () { 'outer: while flag { while (loop { continue 'outer; }) {} } }",
            "`continue` is not allowed in a while condition",
        ),
        (
            "fn f() -> i32 { 'outer: loop { while let Option::Some(_) = (loop { break 'outer 7; }) {} } }",
            "`break` is not allowed in a while condition",
        ),
        (
            "fn f(flag: bool) -> () { 'outer: while flag { while let Option::Some(_) = (loop { continue 'outer; }) {} } }",
            "`continue` is not allowed in a while condition",
        ),
        (
            "fn f() -> i32 { 'outer: loop { while let Option::Some(_) = Option::Some(1) && (loop { break 'outer 7; }) {} } }",
            "`break` is not allowed in a while condition",
        ),
        (
            "fn f(flag: bool) -> () { 'outer: while flag { while let Option::Some(_) = Option::Some(1) && (loop { continue 'outer; }) {} } }",
            "`continue` is not allowed in a while condition",
        ),
    ] {
        if !has_diagnostic_containing(checked_diagnostics(case.0), case.1) {
            testing::fail(case.0 + " expected diagnostic: " + case.1)
        }
    }
}

#[test]
fn while_conditions_preserve_local_loop_exits_and_return() -> () {
    for source in[
        "fn f() -> () { while (loop { break false; }) {} }",
        "fn f() -> () { while ('inner: loop { break 'inner false; }) {} }",
        "fn f() -> () { let mut n = 0; while ('inner: loop { n += 1; if n < 2 { continue 'inner; } break false; }) {} }",
        "fn f() -> i32 { 'outer: loop { loop { break 'outer 7; } } }",
        "fn f() -> i32 { while (loop { return 7; }) {} }",
    ] {
        if !checked_diagnostics(source).is_empty() {
            testing::fail(source)
        }
    }
}
