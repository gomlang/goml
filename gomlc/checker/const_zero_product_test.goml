package checker;

use std::testing;

#[test]
fn zero_products_of_total_constant_operands_have_zero_length() -> () {
    for expression in["N * 0", "0 * N", "(N & 7) * 0", "0 * (N | 7)", "(N ^ 7) * 0"] {
        let _ = checked_file(
            "fn empty[const N: usize](value: [i32; " + expression
                + "]) -> [i32; 0] { value } fn main() -> () { let value: [i32; 0] = empty::[3]([]); }",
        );
    }
}

#[test]
fn zero_products_preserve_invalid_constant_arithmetic() -> () {
    for item in[
        ("(N / 0) * 0", "division by zero"),
        ("0 * (N / 0)", "division by zero"),
        ("((N / 0) & 7) * 0", "division by zero"),
        ("(N + 1) * 0", "integer overflow"),
        ("0 * (N << 64)", "invalid shift"),
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(
                    "struct Wrap[const N: usize] { data: [i32; " + item.0
                        + "] } fn invalid(value: Wrap[9223372036854775807]) -> () {}",
                ),
                item.1,
            ),
        );
    }
    testing::assert(
        !checked_diagnostics(
            "fn empty[const N: usize](value: [i32; N * 0]) -> () {} fn main() -> () { empty::[{-1}]([]); }",
        ).is_empty(),
    );
}
