package checker;

use std::testing;

#[test]
fn runtime_function_values_preserve_comptime_restrictions() -> () {
    for body in[
        "let error = compile_error; error(\"runtime\");",
        "let error = || compile_error; let _ = error();",
        "let values = (compile_error,); let _ = values;",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics("fn main() -> () { " + body + " }"),
                "compile_error is only available in comptime",
            ),
        );
    }
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "trait Failure { fn failure() -> () { let error = compile_error; error(\"runtime\"); } } struct Value {} impl Failure for Value {} fn main() -> () {}",
            ),
            "compile_error is only available in comptime",
        ),
    );
    for body in[
        "let f = hidden; println(f(5));",
        "let f = || hidden; let _ = f();",
        "let _ = comptime { let f = hidden; f(5) };",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(
                    "#[comptime_derive] fn hidden(value: i32) -> i32 { value + 1 } fn main() -> () { "
                        + body
                        + " }",
                ),
                "#[comptime_derive] function is only callable from another derive handler",
            ),
        );
    }
}

#[test]
fn comptime_contexts_allow_first_class_capable_functions() -> () {
    let _ = checked_file(
        "#[comptime] fn increment(value: i32) -> i32 { value + 1 } #[comptime] fn checked(value: i32) -> i32 { if value < 0 { compile_error(\"negative\") } else { value } } const ANSWER: i32 = checked(7); fn main() -> () { let f = increment; println(f(ANSWER)); println(comptime { let f = increment; f(8) }); }",
    );
    let _ = checked_file(
        "#[comptime_derive] fn helper(value: i32) -> i32 { value + 1 } #[comptime_derive] fn caller(value: i32) -> i32 { let f = helper; f(value) } fn main() -> () {}",
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "#[comptime] fn helper(value: i32) -> i32 { value } fn main() -> () { let error = comptime { helper }; let _ = error; }",
            ),
            "cannot escape",
        ),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "fn main() -> () { let error = comptime { || compile_error(\"bad\") }; let _ = error; }",
            ),
            "cannot escape",
        ),
    );
}
