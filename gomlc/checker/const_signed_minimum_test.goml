package checker;

use std::testing;

#[test]
fn signed_minimum_literals_can_contribute_to_valid_array_lengths() -> () {
    for source in[
        "fn empty() -> [i32; -9223372036854775808 + 9223372036854775807 + 1] { [] }",
        "fn empty() -> [i32; -0x8000000000000000 + 0x7fffffffffffffff + 1] { [] }",
        "fn empty() -> [i32; -(9223372036854775808) + 9223372036854775807 + 1] { [] }",
    ] {
        testing::assert_eq(checked_diagnostics(source).len(), 0);
    }
    testing::assert(
        !checked_diagnostics("fn invalid() -> [i32; -9223372036854775808] { [] }").is_empty(),
    );
}
