package checker;

use std::testing;

#[test]
fn projection_equality_chains_are_independent_of_predicate_order() -> () {
    for predicates in[
        "A::Item = B::Item, B::Item = C::Item",
        "B::Item = C::Item, A::Item = B::Item",
        "A::Item = B::Item, C::Item = B::Item",
        "B::Item = A::Item, B::Item = C::Item",
        "B::Item = C::Item, B::Item = A::Item",
        "C::Item = B::Item, B::Item = A::Item",
        "C::Item = B::Item, A::Item = B::Item",
        "B::Item = A::Item, C::Item = B::Item",
    ] {
        let _ = checked_file(
            "trait Source { type Item; } fn convert[A: Source, B: Source, C: Source](value: A::Item) -> C::Item where "
                + predicates
                + " { value }",
        );
    }
}

#[test]
fn projection_equalities_merge_existing_components_and_cycles() -> () {
    for predicates in[
        "A::Item = B::Item, C::Item = D::Item, A::Item = C::Item",
        "B::Item = A::Item, D::Item = C::Item, B::Item = D::Item",
        "A::Item = B::Item, B::Item = C::Item, C::Item = A::Item, D::Item = C::Item",
        "A::Item = A::Item, D::Item = C::Item, C::Item = B::Item, B::Item = A::Item",
    ] {
        let _ = checked_file(
            "trait Source { type Item; } fn convert[A: Source, B: Source, C: Source, D: Source](value: A::Item) -> D::Item where "
                + predicates
                + " { value }",
        );
    }
    testing::assert(
        !checked_diagnostics(
            "trait Source { type Item; } fn convert[A: Source, B: Source, C: Source, D: Source](value: A::Item) -> D::Item where A::Item = B::Item, C::Item = D::Item { value }",
        ).is_empty(),
    );
}
