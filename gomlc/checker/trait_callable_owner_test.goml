package checker;

use std::testing;

#[test]
fn trait_callable_values_and_instances_require_owner_implementations() -> () {
    for source in[
        "trait Count { fn count(self: Self) -> usize; } struct Thing {} impl Count for Thing { fn count(self: Thing) -> usize { 7 } } fn main() -> () { let f = Count::count; let _: usize = f(Thing {}); }",
        "trait Count { fn count(self: Self) -> usize; } fn call[T: Count](x: T) -> usize { let f = Count::count; f(x) }",
        "trait Count { fn count[const N: usize](self: Self) -> usize; } struct Thing {} impl Count for Thing { fn count[const M: usize](self: Thing) -> usize { M } } fn main() -> () { let f = Count::count::[7]; let _: usize = f(Thing {}); let _: usize = Count::count::[8](Thing {}); }",
    ] {
        let _ = checked_file(source);
    }
    for source in[
        "trait Count { fn count(self: Self) -> usize; }\nstruct Thing {}\nimpl Count for Thing { fn count(self: Thing) -> usize { 7 } }\nfn main() -> () {\n    let f: (bool) -> usize = Count::count;\n    println(f(true));\n}\n",
        "trait Count { fn count[const N: usize]() -> usize; }\nstruct Thing {}\nimpl Count for Thing { fn count[const M: usize]() -> usize { M } }\nfn main() -> () { println(Count::count::[7]()); }\n",
        "trait Count { fn count[const N: usize](self: Self) -> usize; }\nstruct Thing {}\nimpl Count for Thing { fn count[const M: usize](self: Thing) -> usize { M } }\nfn main() -> () { println(Count::count::[7](true)); }\n",
        "trait Count { fn count[const N: usize](self: Self) -> usize; } fn main() -> () { let f: (bool) -> usize = Count::count::[7]; let _ = f(true); }",
        "trait Get[A] { fn get(self: Self) -> A; } struct Thing {} impl Get[i32] for Thing { fn get(self: Thing) -> i32 { 7 } } fn main() -> () { let f: (Thing) -> bool = Get::[bool]::get; let _ = f(Thing {}); }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}
