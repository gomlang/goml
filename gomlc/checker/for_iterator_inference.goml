package checker;

use module::ast;
use module::tast::{Type, TraitRef, prune, symbolic_array, types_equal, type_text};

fn for_iterator_needs_inference(ctx: Checker, value: Type) -> bool {
    let value = normalize_type(ctx, value);
    match prune(value) {
        Var(_) => true,
        _ => has_unresolved_projection(value),
    }
}

fn for_iterator_types(ctx: Checker, source_ty: Type, span: ast::Span) -> (Type, Type) {
    let source_ty = normalize_type(ctx, source_ty);
    if let Never = source_ty {
        return (Type::Never, Type::Never)
    }
    let iterator_trait = ctx.builtin.iterator.name;
    let into_iterator_trait = ctx.builtin.into_iterator.name;
    let fixed_array = symbolic_array(source_ty).is_some()
        || match prune(source_ty) {
            Array { .. } => true,
            _ => false,
        };
    if !fixed_array
        && !trait_bound_satisfied_at(
            ctx,
            source_ty,
            TraitRef { name: into_iterator_trait, args: Vec::new() },
            Vec::new(),
        ) {
        push_diagnostic_at(
            ctx,
            "for loop expects a type implementing IntoIterator, got " + type_text(source_ty),
            Some(span),
        )
    }
    let item = into_iterator_item_type(ctx, source_ty);
    let projected_iterator_ty = trait_projection(
        source_ty,
        ctx.builtin.into_iterator.into_iter_type,
        into_iterator_trait,
    );
    let normalized_iterator_ty = normalize_type(ctx, projected_iterator_ty);
    let iterator_ty = if types_equal(normalized_iterator_ty, projected_iterator_ty)
        && trait_bound_satisfied_at(
            ctx,
            source_ty,
            TraitRef { name: iterator_trait, args: Vec::new() },
            Vec::new(),
        ) {
        source_ty
    } else {
        normalized_iterator_ty
    };
    (item, iterator_ty)
}

fn constrain_for_iterator(ctx: Checker, constraint: ForIteratorConstraint) -> () {
    let (item_ty, iterator_ty) = for_iterator_types(ctx, constraint.receiver, constraint.span);
    expect_type_at(ctx, item_ty, constraint.item_ty, Some(constraint.span));
    expect_type_at(ctx, iterator_ty, constraint.iterator_ty, Some(constraint.span));
}

fn infer_deferred_for_iterator(ctx: Checker, constraint: ForIteratorConstraint) -> bool {
    if for_iterator_needs_inference(ctx, constraint.receiver) {
        return false
    }
    let snapshot = deferred_dependency_snapshot(
        ctx,
        Vec::from_array([constraint.receiver, constraint.item_ty, constraint.iterator_ty]),
    );
    let diagnostic_start = ctx.diagnostics.len();
    constrain_for_iterator(ctx, constraint);
    if ctx.diagnostics.len() != diagnostic_start {
        snapshot.restore();
        ctx.diagnostics.truncate(diagnostic_start);
        false
    } else {
        snapshot.changed()
    }
}

fn resolve_for_iterator_constraints(ctx: Checker) -> () {
    for constraint in ctx.inference.for_iterator_constraints {
        let receiver = normalize_type(ctx, constraint.receiver);
        if let Var(_) = prune(receiver) {
            let _ = default_numeric_type(receiver);
        }
        if for_iterator_needs_inference(ctx, constraint.receiver) {
            push_diagnostic_at(
                ctx,
                "Could not infer the iterator type for for loop",
                Some(constraint.span),
            )
        } else if !type_contains_error(constraint.receiver) {
            constrain_for_iterator(ctx, constraint)
        }
    }
}
