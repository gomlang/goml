package checker;

use std::testing;

#[test]
fn trait_signatures_reject_projections_without_declaring_bounds() -> () {
    for source in[
        "trait Main { fn run[T](self, value: T::Missing) -> i32; }",
        "trait Main { fn run[T](self) -> T::Missing; }",
        "trait Main { fn run[T](self) -> () where T::Missing = i32; }",
        "trait Other[T] {} trait Main[T]: Other[T::Missing] {}",
        "trait Other[T] {} trait Main[T] { type Item: Other[T::Missing]; }",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "is not provided by a trait bound",
            ),
        );
    }
}

#[test]
fn trait_signatures_resolve_owner_method_and_associated_bounds() -> () {
    for source in[
        "trait Bound { type Item; } trait Main[T: Bound] { fn run(self, value: T::Item) -> T::Item; }",
        "trait Bound { type Item; } trait Main { fn run[T: Bound](self, value: T::Item) -> T::Item; }",
        "trait Bound { type Item; } trait Main { type Inner: Bound; fn run(self, value: Self::Inner::Item) -> Self::Inner::Item; }",
        "trait Bound { type Item; } trait Other[T] {} trait Main[T: Bound]: Other[T::Item] {}",
        "trait Bound { type Item; } trait Other[T] {} trait Main[T: Bound] { type Inner: Other[T::Item]; }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn method_projection_metadata_keeps_its_declaring_trait_after_substitution() -> () {
    let _ = checked_file(
        "trait First { type Item; } trait Second { type Item; } impl First for bool { type Item = i32; } impl Second for bool { type Item = string; } trait Main { fn run[T: First](self, value: T::Item) -> i32; } impl Main for i32 { fn run[T: First](self, value: T::Item) -> i32 { 7 } } fn main() -> () { let value: i32 = 1; let _ = value.run::[bool](2); }",
    );
    testing::assert(
        !checked_diagnostics(
            "trait First { type Item; } trait Second { type Item; } impl First for bool { type Item = i32; } impl Second for bool { type Item = string; } trait Main { fn run[T: First](self, value: T::Item) -> i32; } impl Main for i32 { fn run[T: First](self, value: T::Item) -> i32 { 7 } } fn main() -> () { let value: i32 = 1; let _ = value.run::[bool](\"wrong trait\"); }",
        ).is_empty(),
    );
}
