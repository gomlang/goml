package checker;

use std::testing;

#[test]
fn numeric_method_receivers_wait_for_later_constraints() -> () {
    for source in[
        "fn f(value: f32) -> string { let text = |x| (x + 0.0).to_string(); text(value) }",
        "fn f(value: u8) -> string { let text = |x| (x + 0).to_string(); text(value) }",
        "fn f() -> string { let text = |x| (x + 0.0).to_string(); text(1.0) }",
        "fn f() -> string { 1.0.to_string() }",
        "trait Echo { fn echo(self: Self) -> Self; } impl Echo for f32 { fn echo(self: f32) -> f32 { self } } impl Echo for f64 { fn echo(self: f64) -> f64 { self } } fn f() -> f32 { let make = || 1.0.echo(); make() }",
    ] {
        if !checked_diagnostics(source).is_empty() {
            testing::fail(source)
        }
    }
}

#[test]
fn numeric_method_receivers_keep_operator_and_call_restrictions() -> () {
    for source in[
        "fn f() -> () { let text = |x| (x + 0.0).to_string(); let _ = text(true); }",
        "fn f(value: f32) -> () { let text = |x| (x + 0.0).missing(); let _ = text(value); }",
        "fn f(first: f32, second: f64) -> () { let text = |x| (x + 0.0).to_string(); let _ = text(first); let _ = text(second); }",
        "fn f(value: u8) -> () { let text = |x| (x + 256).to_string(); let _ = text(value); }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}

#[test]
fn numeric_method_receivers_preserve_later_dyn_choices() -> () {
    let prefix = "trait OnlySingle { fn read(self: Self) -> f32; } impl OnlySingle for f32 { fn read(self: f32) -> f32 { self } } ";
    for source in[
        "fn f() -> string { let x = 1.0; let text = x.to_string(); let value = x as dyn OnlySingle; text }",
        "fn f() -> f32 { let text = |x| (x + 0.0).to_string(); let value = 1.0; let _ = text(value); let erased = value as dyn OnlySingle; erased.read() }",
    ] {
        if !checked_diagnostics(prefix + source).is_empty() {
            testing::fail(source)
        }
    }
    testing::assert(
        !checked_diagnostics(
            prefix
                + "fn f() -> () { let x: f64 = 1.0; let _ = x.to_string(); let _ = x as dyn OnlySingle; }",
        ).is_empty(),
    );
}

#[test]
fn deferred_numeric_methods_propagate_common_signatures_before_later_uses() -> () {
    for source in[
        "fn f() -> u8 { let mut quote = 0.to_u8(); quote = b'x'; quote }",
        "fn f() -> bool { let mut quote = 0.to_u8(); if quote == 0 { quote = b'x'; } quote == b'x' }",
        "fn f() -> string { let quote = 0.to_u8(); quote.to_string() }",
        "fn f(value: u16) -> u8 { let convert = |x| (x + 0).to_u8(); convert(value) }",
    ] {
        if !checked_diagnostics(source).is_empty() {
            testing::fail(source)
        }
    }
}
