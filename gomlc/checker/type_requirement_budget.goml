package checker;

use module::tast::{Type, any_child_type, prune};

fn type_requirement_size_allowed(
    value: Type,
    parameters: Vec[string],
    arguments: Vec[Type],
    remaining: Ref[isize],
    depth: isize,
) -> bool {
    if depth >= 128 || remaining.get() <= 0 {
        return false
    }
    let value = prune(value);
    if let Param { name } = value {
        for index in 0..parameters.len() {
            if parameters[index] == name && index < arguments.len() {
                return type_requirement_size_allowed(
                    arguments[index],
                    Vec::new(),
                    Vec::new(),
                    remaining,
                    depth,
                )
            }
        }
    }
    remaining.set(remaining.get() - 1);
    !any_child_type(
        value,
        |child| !type_requirement_size_allowed(child, parameters, arguments, remaining, depth + 1),
    )
}

fn type_requirement_substitution_allowed(value: Type, parameters: Vec[string], arguments: Vec[Type]) -> bool {
    type_requirement_size_allowed(value, parameters, arguments, Ref::new(4096), 0)
}
