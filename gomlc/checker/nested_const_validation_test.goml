package checker;

use std::testing;

#[test]
fn diagnoses_nested_constant_operations_after_substitution() -> () {
    for expression in["(N / 0) + 1", "(N % 0) + 1"] {
        let source = "type Buffer[const N: usize] = [i32; " + expression
            + "]; fn invalid(value: Buffer[1]) -> () {}";
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "division by zero in constant expression",
            ),
        );
    }
    for expression in["(9223372036854775807 + N) + 1", "1 + (9223372036854775807 * N)"] {
        let source = "type Buffer[const N: usize] = [i32; " + expression
            + "]; fn invalid(value: Buffer[2]) -> () {}";
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "integer overflow in constant expression",
            ),
        );
    }
}

#[test]
fn permits_valid_symbolic_and_nested_constant_operations() -> () {
    for source in[
        "type Buffer[const N: usize] = [i32; (N / 2) + 1]; fn symbolic[const N: usize](value: Buffer[N]) -> () {} fn concrete(value: Buffer[4]) -> () {}",
        "type Buffer[const N: usize] = [i32; (N % 3) + 1]; fn symbolic[const N: usize](value: Buffer[N]) -> () {} fn concrete(value: Buffer[4]) -> () {}",
        "type Buffer[const N: usize] = [i32; (N - 3) + 4]; fn concrete(value: Buffer[1]) -> () {}",
        "type Buffer[const N: usize] = [i32; N + (-9223372036854775808 % -1)]; fn concrete(value: Buffer[1]) -> () {}",
    ] {
        let _ = checked_file(source);
    }
}
