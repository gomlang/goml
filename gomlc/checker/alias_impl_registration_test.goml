package checker;

use std::testing;

#[test]
fn alias_impl_targets_are_collected_in_standalone_and_package_sources() -> () {
    for source in[
        "type Alias = bool; trait Read { fn read(self: Self) -> i32; } impl Read for Alias { fn read(self: Alias) -> i32 { 7 } } fn f(value: bool) -> i32 { Read::read(value) }",
        "struct Original { value: i32 } type Alias = Original; trait Read { fn read(self: Self) -> i32; } impl Read for Alias { fn read(self: Alias) -> i32 { self.value } } fn f(value: Original) -> i32 { Read::read(value) }",
        "struct Box[T] { value: T } type Alias[T] = Box[T]; trait Read { type Item; fn read(self: Self) -> Self::Item; } impl[T] Read for Alias[T] { type Item = T; fn read(self: Alias[T]) -> T { self.value } } fn f(value: Box[i32]) -> i32 { Read::read(value) }",
        "struct Original { value: i32 } type Alias = Original; impl Alias { fn read(self: Alias) -> i32 { self.value } } fn f(value: Original) -> i32 { value.read() }",
        "type Item = i32; trait Read { fn read(self: Self) -> i32; } impl Read for [Item; 2] { fn read(self: [Item; 2]) -> i32 { self[0] } } fn f(value: [i32; 2]) -> i32 { Read::read(value) }",
        "type Fixed[const N: usize] = [i32; N]; trait Read { fn read(self: Self) -> i32; } impl[const N: usize] Read for Fixed[N] { fn read(self: Fixed[N]) -> i32 { self[0] } } fn f(value: [i32; 2]) -> i32 { Read::read(value) }",
        "#[go_type(\"time\", \"Duration\")] extern type Duration; trait Read { fn read(self: Self) -> i32; } impl Read for Duration { fn read(self: Duration) -> i32 { 17 } } fn f(value: Duration) -> i32 { Read::read(value) }",
    ] {
        let _ = checked_file(source);
        let _ = checked_package_file_with_dependencies(source, Vec::new());
    }
}

#[test]
fn alias_impl_targets_keep_argument_checks_and_underlying_identity() -> () {
    for source in[
        "struct Box[T] { value: T } type Alias[T] = Box[T]; trait Read {} impl Read for Alias {}",
        "struct Box[T] { value: T } type Alias[T] = Box[T]; trait Read {} impl Read for Alias[i32, bool] {}",
        "type Alias[T] = bool; trait Read {} impl Read for Alias[2] {}",
        "type Fixed[const N: usize] = [i32; N]; trait Read {} impl Read for Fixed[bool] {}",
        "type Fixed[const N: usize] = [i32; N]; trait Read {} impl Read for Fixed[{-1}] {}",
        "type Alias = bool; trait Read {} impl Read for Alias {} impl Read for bool {}",
        "type Alias = Missing; trait Read {} impl Read for Alias {}",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty())
    }
}
