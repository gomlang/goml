package checker;

use module::tast::{Callable, Type, TypePredicate, prune, type_is_concrete, types_equal, validate_go_callback_signature};

fn callback_conversion_requirement(callable: Callable, params: Vec[Type], ret_ty: Type) -> Option[
    TypePredicate,
] {
    match callable {
        Intrinsic(key) if key == "go_func.from_closure" && params.len() == 1 => Some(
            TypePredicate::GoCallback(params[0]),
        ),
        Intrinsic(key) if key == "go_func.to_closure" => Some(TypePredicate::GoCallback(ret_ty)),
        _ => None,
    }
}

fn callback_signature_has_known_error(signature: Type) -> bool {
    match prune(signature) {
        Func { .. } => validate_go_callback_signature(signature).is_err(),
        _ => type_is_concrete(signature) && validate_go_callback_signature(signature).is_err(),
    }
}

fn callback_predicate_satisfied(ctx: Checker, signature: Type) -> bool {
    let signature = prune(normalize_type(ctx, signature));
    if callback_signature_has_known_error(signature) {
        return false
    }
    if type_is_concrete(signature) {
        return true
    }
    for predicate in ctx.predicates {
        if let TypePredicate::GoCallback(bound) = predicate {
            if types_equal(normalize_type(ctx, bound), signature) {
                return true
            }
        }
    }
    false
}

fn infer_callback_predicate(ctx: Checker, signature: Type, predicates: Vec[TypePredicate]) -> () {
    let signature = prune(normalize_type(ctx, signature));
    if !callback_signature_has_known_error(signature)
        && type_contains_any_parameter(signature, ctx.type_params)
        && !contains_unbound_type_variable(signature) {
        let predicate = TypePredicate::GoCallback(signature);
        push_predicate(ctx.predicates, predicate);
        push_predicate(predicates, predicate);
    }
}
