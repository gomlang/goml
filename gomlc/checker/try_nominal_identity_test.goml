package checker;

use std::testing;

#[test]
fn propagation_requires_the_same_option_or_result_declaration() -> () {
    let dependency = dependency_hir(
        "package foreign; pub enum Option[T] { None, Some(T) } pub enum Result[T, E] { Err(E), Ok(T) } pub fn read() -> Result[i32, string] { Err(\"bad\") }",
        "example::foreign",
    );
    let sources = testing::expect_ok(implicit_prelude_hir_files(), "prelude");
    sources.push(dependency);
    let dependencies = testing::expect_ok(dependency_environments(sources), "dependencies");
    dependencies.push(testing::expect_ok(implicit_builtin_dependency_environment(), "builtin"));
    for body in[
        "fn step(x: foreign::Option[i32]) -> Option[i32] { let _ = x?; loop {} }",
        "fn step(x: Option[i32]) -> foreign::Option[i32] { let _ = x?; loop {} }",
        "fn step(x: foreign::Result[i32, string]) -> Result[i32, bool] { let _ = x?; loop {} }",
        "fn step() -> Result[i32, string] { let _ = foreign::read()?; loop {} }",
    ] {
        let source = "package main; use example::foreign; pub " + body;
        let result = check_package_files_for_link_with_environments(
            Vec::from_array([dependency_hir(source, "example")]),
            dependencies,
        );
        for value in result.diagnostics {
            if value.code != Option::Some("try_invalid_return") {
                testing::fail(body + ": " + value.message)
            }
        }
        testing::assert_eq(result.diagnostics.len(), 1);
    }
    let same = dependency_hir(
        "package main; use example::foreign; type Alias = foreign::Result[i32, string]; pub fn step() -> Alias { let _ = foreign::read()?; loop {} }",
        "example",
    );
    let result = check_package_files_for_link_with_environments(
        Vec::from_array([same]),
        dependencies,
    );
    testing::assert_eq(result.diagnostics.len(), 0);
}
