package checker;

use module::ast;
use module::tast::{Type, prune};

struct ChannelConstraint {
    receiver: Type,
    elem: Type,
    send: bool,
    span: ast::Span,
}

fn constrain_channel(ctx: Checker, constraint: ChannelConstraint) -> () {
    let receiver = prune(normalize_type(ctx, constraint.receiver));
    match receiver {
        Channel { elem, direction } => {
            let invalid = match direction {
                Receive => constraint.send,
                Send => !constraint.send,
                Both => false,
            };
            if invalid {
                push_diagnostic_at(
                    ctx,
                    if constraint.send {
                        "Cannot send to Receiver"
                    } else {
                        "Cannot receive from Sender"
                    },
                    Some(constraint.span),
                );
            }
            expect_type_at(ctx, elem, constraint.elem, Some(constraint.span));
        },
        _ => expect_type_at(
            ctx,
            receiver,
            Channel { elem: constraint.elem, direction: ast::ChannelDirection::Both },
            Some(constraint.span),
        ),
    }
}

fn infer_deferred_channel(ctx: Checker, constraint: ChannelConstraint) -> bool {
    if is_unbound_any_type(normalize_type(ctx, constraint.receiver)) {
        return false
    }
    let snapshot = deferred_dependency_snapshot(
        ctx,
        Vec::from_array([constraint.receiver, constraint.elem]),
    );
    let diagnostic_start = ctx.diagnostics.len();
    constrain_channel(ctx, constraint);
    if ctx.diagnostics.len() != diagnostic_start {
        snapshot.restore();
        ctx.diagnostics.truncate(diagnostic_start);
        false
    } else {
        snapshot.changed()
    }
}

fn resolve_channel_constraints(ctx: Checker) -> () {
    for constraint in ctx.inference.channel_constraints {
        if !type_contains_error(constraint.receiver) {
            constrain_channel(ctx, constraint);
        }
    }
    if !ctx.inference.channel_constraints.is_empty() {
        infer_deferred_dependencies(ctx);
    }
}
