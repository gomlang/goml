package checker;

use std::testing;

fn static_self_inference_declarations() -> string {
    "trait Make { fn make() -> Self; } struct A { value: i32 } struct B { value: bool } impl Make for A { fn make() -> A { A { value: 7 } } } impl Make for B { fn make() -> B { B { value: true } } } "
}

#[test]
fn associated_function_self_waits_for_closure_call_context() -> () {
    for source in[
        "fn f() -> A { let make = || Make::make(); make() }",
        "fn f() -> bool { let make = || Make::make(); let value: B = make(); value.value }",
        "fn f() -> A { let make = || Make::make(); let callable: () -> A = make; callable() }",
        "fn f[T: Make]() -> T { let make = || Make::make(); make() }",
    ] {
        if !checked_diagnostics(static_self_inference_declarations() + source).is_empty() {
            testing::fail(source)
        }
    }
}

#[test]
fn associated_function_self_retains_obligations_and_monomorphic_closures() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                static_self_inference_declarations()
                    + "fn f() -> () { let make = || Make::make(); }",
            ),
            "Could not infer the Self type for associated function Make::make",
        ),
    );
    testing::assert(
        !checked_diagnostics(
            static_self_inference_declarations()
                + "struct Missing {} fn f() -> Missing { let make = || Make::make(); make() }",
        ).is_empty(),
    );
    testing::assert(
        !checked_diagnostics(
            static_self_inference_declarations()
                + "fn f() -> () { let make = || Make::make(); let _: A = make(); let _: B = make(); }",
        ).is_empty(),
    );
}
