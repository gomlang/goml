package checker;

use std::testing;

fn assert_map_layout_diagnostics(source: string, invalid: bool) -> () {
    let diagnostics = checked_diagnostics(source);
    let mut detail = source;
    for diagnostic in diagnostics {
        detail = detail + "\n" + diagnostic.message;
    }
    if invalid {
        if !has_diagnostic_containing(diagnostics, "Go map key is not comparable") {
            testing::fail("Expected non-comparable key diagnostic: " + detail);
        }
    } else if !diagnostics.is_empty() {
        testing::fail("Expected valid map key: " + detail);
    }
}

#[test]
fn enum_map_keys_follow_the_planned_go_representation() -> () {
    for key in["Option[Slice[i32]]", "Option[() -> ()]", "Key"] {
        let source = "enum Key { Empty, Callback(() -> ()) } pub fn accept(value: GoMap[" + key
            + ", i32]) -> () {}";
        assert_map_layout_diagnostics(source, true);
    }
    for source in[
        "enum Key { Empty, Data(Slice[i32]) } pub fn accept(value: GoMap[Key, i32]) -> () {}",
        "enum Key { Empty, Next(Key, Slice[i32]) } pub fn accept(value: GoMap[Key, i32]) -> () {}",
        "pub fn accept(value: GoMap[Option[i32], i32]) -> () {}",
        "pub fn accept(value: GoMap[Option[Vec[i32]], i32]) -> () {}",
        "pub fn accept(value: GoMap[Option[[Slice[i32]; 3]], i32]) -> () {}",
    ] {
        assert_map_layout_diagnostics(source, false);
    }
}

#[test]
fn symbolic_enum_map_requirements_remain_whole_until_specialization() -> () {
    let declarations = "enum Key[T] { Empty, Data(T) } fn accept[T](key: Key[T]) -> () { let map: Option[GoMap[Key[T], i32]] = None; } ";
    assert_map_layout_diagnostics(
        declarations + "fn main() -> () { accept::[Slice[i32]](Key::Empty); }",
        false,
    );
    assert_map_layout_diagnostics(
        declarations + "fn main() -> () { accept::[() -> ()](Key::Empty); }",
        true,
    );
    let declarations = "fn accept[T]() -> () { let map: Option[GoMap[Option[T], i32]] = None; } ";
    assert_map_layout_diagnostics(
        declarations + "fn main() -> () { accept::[Slice[i32]](); }",
        true,
    );
    assert_map_layout_diagnostics(
        declarations + "fn main() -> () { accept::[[Slice[i32]; 3]](); }",
        false,
    );
}
