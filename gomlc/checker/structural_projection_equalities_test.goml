package checker;

use std::testing;

#[test]
fn structural_equalities_propagate_associated_type_bindings() -> () {
    for equality in[
        "(A::Item, bool) = (i32, bool)",
        "Vec[A::Item] = Vec[i32]",
        "Option[A::Item] = Option[i32]",
        "[A::Item; 2] = [i32; 2]",
        "(A::Item) -> bool = (i32) -> bool",
        "(bool) -> A::Item = (bool) -> i32",
        "Ref[A::Item] = Ref[i32]",
        "((A::Item, bool), string) = ((i32, bool), string)",
        "Vec[Option[(bool, A::Item)]] = Vec[Option[(bool, i32)]]",
    ] {
        let _ = checked_file(
            "trait Source { type Item; } fn convert[A: Source](value: A::Item) -> i32 where "
                + equality
                + " { value }",
        );
    }
}

#[test]
fn structural_equalities_connect_nested_projection_chains() -> () {
    let _ = checked_file(
        "trait Source { type Item; } fn convert[A: Source, B: Source, C: Source](value: A::Item) -> C::Item where Vec[B::Item] = Vec[C::Item], Option[A::Item] = Option[B::Item] { value }",
    );
    for equality in[
        "Vec[A::Item] = Option[i32]",
        "[A::Item; 2] = [i32; 3]",
        "(A::Item, bool) = (i32, bool, string)",
    ] {
        testing::assert(
            !checked_diagnostics(
                "trait Source { type Item; } fn convert[A: Source](value: A::Item) -> i32 where "
                    + equality
                    + " { value }",
            ).is_empty(),
        );
    }
}
