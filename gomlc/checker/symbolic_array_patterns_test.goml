package checker;

use std::testing;

#[test]
fn symbolic_array_patterns_preserve_elements_and_remainders() -> () {
    for source in[
        "fn identity[T, const N: usize](value: [T; N]) -> [T; N] { let [rest @ ..] = value; rest }",
        "fn count[const N: usize](value: [i32; N]) -> usize { match value { [..] => N } }",
        "fn sum[const N: usize](value: [i32; N]) -> i32 { match value { [first, middle @ .., last] => { let mut total = first + last; for item in middle { total += item; } total }, _ => 0 } }",
        "fn first[const N: usize](value: [i32; N]) -> i32 { match value { [] => 0, [first, ..] => first } }",
    ] {
        let _ = checked_file(source);
    }
    for source in[
        "fn invalid[const N: usize](value: [i32; N]) -> i32 { let [first, ..] = value; first }",
        "fn invalid[const N: usize](value: [i32; N]) -> () { let [] = value; }",
        "fn invalid[const N: usize](value: [i32; N]) -> i32 { match value { [first, ..] => first } }",
        "fn invalid[const N: usize](value: [i32; N]) -> bool { match value { [first, ..] => first, _ => false } }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}
