package checker;

use module::ast;
use module::hir;
use module::parser;
use module::tast;
use module::tast::{Type};
use std::testing;

#[test]
fn builtin_nominal_types_preserve_qualified_package_identity() -> () {
    let builtin = testing::expect_ok(tast::builtin_contract(), "expected builtin contract");
    let one = Vec::from_array([Type::Int]);
    let two = Vec::from_array([Type::Int, Type::String]);
    let cases = Vec::from_array(
        [
            (builtin.go_error.name, Vec::new()),
            (builtin.go_string.name, Vec::new()),
            (builtin.vec.name, one),
            (builtin.slice.name, one),
            (builtin.mut_slice.name, one),
            (builtin.ref_type.name, one),
            (builtin.go_pointer.name, one),
            (builtin.go_function.name, one),
            (builtin.go_map.name, two),
            (builtin.hashmap.name, two),
            (builtin.channel.name, one),
            (builtin.sender.name, one),
            (builtin.receiver.name, one),
        ],
    );
    for (name, args) in cases {
        let intrinsic = tast::nominal_type(builtin, name, args);
        testing::assert(
            tast::types_equal(intrinsic, tast::nominal_type(builtin, "builtin::" + name, args)),
        );
        let qualified = "example::collections::" + name;
        let expected = if args.is_empty() {
            Type::Con { name: qualified }
        } else {
            Type::App { ty: Type::Con { name: qualified }, args }
        };
        let actual = tast::nominal_type(builtin, qualified, args);
        testing::assert(tast::types_equal(actual, expected));
        testing::assert(!tast::types_equal(actual, intrinsic));
    }
}

#[test]
fn builtin_nominal_identity_uses_contract_names() -> () {
    let mut builtin = testing::expect_ok(tast::builtin_contract(), "expected builtin contract");
    builtin.hashmap.name = "RuntimeTable";
    builtin.vec.name = "RuntimeArray";
    let args = Vec::from_array([Type::Int, Type::String]);
    let expected = Type::HashMap { key: Type::Int, value: Type::String };
    testing::assert(tast::types_equal(tast::nominal_type(builtin, "RuntimeTable", args), expected));
    testing::assert(
        tast::types_equal(tast::nominal_type(builtin, "builtin::RuntimeTable", args), expected),
    );
    testing::assert(
        !tast::types_equal(tast::nominal_type(builtin, "example::RuntimeTable", args), expected),
    );
    testing::assert(!tast::types_equal(tast::nominal_type(builtin, "HashMap", args), expected));
    let args = Vec::from_array([Type::Int]);
    let expected = Type::VecType { elem: Type::Int };
    testing::assert(tast::types_equal(tast::nominal_type(builtin, "RuntimeArray", args), expected));
    testing::assert(
        tast::types_equal(tast::nominal_type(builtin, "builtin::RuntimeArray", args), expected),
    );
    testing::assert(
        !tast::types_equal(tast::nominal_type(builtin, "example::RuntimeArray", args), expected),
    );
}

#[test]
fn qualified_hash_map_methods_coexist_with_builtin_methods() -> () {
    let source = "package values; pub struct HashMap[K, V] { entry: Option[(K, V)] } impl[K: Eq + Hash, V] HashMap[K, V] { pub fn new() -> HashMap[K, V] { HashMap { entry: Option::None } } pub fn len(self: HashMap[K, V]) -> isize { if self.entry.is_some() { 1 } else { 0 } } pub fn get(self: HashMap[K, V], key: K) -> Option[V] { match self.entry { Some((stored, value)) => if stored == key { Option::Some(value) } else { Option::None }, None => Option::None } } } pub fn local() -> isize { let map: HashMap[isize, string] = HashMap::new(); let _value = map.get(1); map.len() } pub fn builtin() -> isize { let map = hashmap_new::[isize, string](); map.set(1, \"value\"); let _value = map.get(1); map.len() }";
    let environment = checked_dependency_environment(source, "example::values");
    let dependencies = Vec::from_array(
        [
            testing::expect_ok(
                implicit_builtin_dependency_environment(),
                "expected builtin environment",
            ),
            environment,
        ],
    );
    let prelude = testing::expect_ok(implicit_prelude_hir_files(), "expected prelude HIR");
    for value in testing::expect_ok(
        dependency_environments(prelude),
        "expected prelude environments",
    ) {
        dependencies.push(value);
    }
    let checked = check_for_link_with_environments(
        hir::lower_package(
            ast::lower(
                parser::parse(
                    "package main; use example::values; fn main() -> () { let local: values::HashMap[isize, string] = values::HashMap::new(); let builtin: HashMap[isize, string] = HashMap::new(); let _local_value = local.get(1); let _builtin_value = builtin.get(1); println(local.len() + builtin.len() + values::local() + values::builtin()); }",
                ),
            ),
            "main.goml",
            "main",
        ),
        dependencies,
    );
    for diagnostic in checked.diagnostics {
        testing::fail(diagnostic.message);
    }
    testing::assert(checked.tast.is_some());
}
