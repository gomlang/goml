package checker;

use std::testing;

#[test]
fn comptime_dynamic_objects_keep_every_bound_and_declaring_trait() -> () {
    let _ = checked_file(
        "trait First { fn value(self: Self) -> i32; }\ntrait Second { fn value(self: Self) -> i32; fn second(self: Self) -> i32; }\nimpl First for bool { #[comptime] fn value(self: Self) -> i32 { 7 } }\nimpl Second for bool {\n    #[comptime] fn value(self: Self) -> i32 { 8 }\n    #[comptime] fn second(self: Self) -> i32 { 9 }\n}\ntrait Parent { fn value(self: Self) -> i32; fn parent(self: Self) -> i32; }\ntrait Child: Parent { fn value(self: Self) -> i32; }\nimpl Parent for bool {\n    #[comptime] fn value(self: Self) -> i32 { 11 }\n    #[comptime] fn parent(self: Self) -> i32 { 13 }\n}\nimpl Child for bool { #[comptime] fn value(self: Self) -> i32 { 12 } }\ntrait Empty {}\nimpl Empty for bool {}\ntrait Read[T] { fn read(self: Self) -> T; }\nimpl Read[i32] for bool { #[comptime] fn read(self: Self) -> i32 { 14 } }\nimpl Read[bool] for bool { #[comptime] fn read(self: Self) -> bool { true } }\nfn main() -> () {\n    let value = true as dyn First + Second;\n    println(First::value(value));\n    println(Second::value(value));\n    println(comptime { let value = true as dyn First + Second; First::value(value) });\n    println(comptime { let value = true as dyn First + Second; Second::value(value) });\n    println(comptime { let value = true as dyn Second + First; value.second() });\n    println(comptime { let value = true as dyn Child; value.value() });\n    println(comptime { let value = true as dyn Child; Parent::value(value) });\n    println(comptime { let value = true as dyn Child; value.parent() });\n    println(comptime { let value = true as dyn Empty + Read[i32]; value.read() });\n    println(comptime { let value = true as dyn Read[bool]; value.read() });\n    println(comptime { let _ = true as dyn Empty; 15 });\n}\n",
    );
}

#[test]
fn comptime_dynamic_objects_require_capable_additional_methods() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "trait First { fn first(self: Self) -> i32; } trait Second { fn second(self: Self) -> i32; } impl First for bool { #[comptime] fn first(self: Self) -> i32 { 7 } } impl Second for bool { fn second(self: Self) -> i32 { 8 } } fn main() -> () { let _ = comptime { let value = true as dyn First + Second; value.first() }; }",
            ),
            "comptime dynamic conversion requires #[comptime] on method `second`",
        ),
    );
}
