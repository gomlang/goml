package checker;

use module::consts;
use module::tast::{Type, TypePredicate, const_application, const_type_value, prune};

fn const_valid_predicate_error(ctx: Checker, ty: Type) -> Option[string] {
    let validation = Checker { diagnostics: Vec::new(), ..ctx };
    instantiated_const_type_error(validation, ty)
}

fn require_const_argument_validity(ctx: Checker, value: Type) -> () {
    if const_type_value(value).is_some() {
        return
    }
    if let Param { name } = prune(value) {
        if consts::parameter_name(name).is_some() {
            return
        }
    }
    let ty = const_application(Type::Con { name: "$array" }, Vec::from_array([value, Type::Unit]));
    require_predicate(
        ctx,
        TypePredicate::ConstValid { ty, origins: Vec::new() },
        "type predicate not satisfied",
    );
}

fn collect_function_const_types(ctx: Checker, ty: Type) -> () {
    let requirements = Vec::new();
    if !collect_type_const_requirements(ctx, ty, requirements) {
        push_diagnostic(ctx, NOMINAL_CONST_COMPLEXITY_ERROR);
        return
    }
    for requirement in requirements {
        require_const_argument_validity(ctx, requirement);
    }
}

fn infer_const_valid_predicate(
    ctx: Checker,
    ty: Type,
    origins: Vec[string],
    predicates: Vec[TypePredicate],
) -> () {
    if type_contains_any_parameter(ty, ctx.type_params) && !contains_unbound_type_variable(ty) {
        let next = copied_names(origins);
        if let Some(origin) = ctx.const_requirement_origin.get() {
            let mut visits = 0;
            for previous in origins {
                if previous == origin {
                    visits += 1;
                }
            }
            if visits >= 2 {
                return
            }
            next.push(origin);
        }
        let predicate = TypePredicate::ConstValid { ty, origins: next };
        push_predicate(ctx.predicates, predicate);
        push_predicate(predicates, predicate);
    }
}
