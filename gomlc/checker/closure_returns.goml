package checker;

use module::tast::{Expr, Type, expr_type, map_child_exprs, types_equal};

fn closure_has_value_return(ctx: Checker, value: Expr) -> bool {
    match value {
        Closure { .. } => false,
        Return { expr: None, .. } => true,
        Return { expr: Some(inner), .. } => {
            !types_equal(normalize_type(ctx, expr_type(inner)), Type::Never)
                || closure_has_value_return(ctx, inner)
        },
        _ => {
            let found = Ref::new(false);
            let _ = map_child_exprs(
                value,
                |child| {
                    if !found.get() && closure_has_value_return(ctx, child) {
                        found.set(true)
                    }
                    child
                },
            );
            found.get()
        },
    }
}
