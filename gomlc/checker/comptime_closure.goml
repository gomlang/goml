package checker;

use module::ctir;
use module::tast::{Callable, ClosureParam, Expr, Type, resolve_type};

fn lower_ct_closure(ctx: CtLowerContext, params: Vec[ClosureParam], body: Expr) -> Result[
    ctir::CtExprKind,
    string,
] {
    let local_start = ctx.next_slot.get();
    let locals = Vec::new();
    for local in ctx.locals {
        locals.push(local)
    }
    let inner = CtLowerContext { locals, loop_targets: Vec::new(), ..ctx };
    let parameters = Vec::new();
    let base = inner.locals.len();
    for param in params {
        parameters.push(bind_pattern_slot(inner, param.name, param.ty, base)?)
    }
    Ok(ctir::CtExprKind::Closure { parameters, local_start, body: lower_ct_expr(inner, body)? })
}

fn lower_ct_method_value(ctx: CtLowerContext, callable: Callable, ty: Type) -> Result[
    ctir::CtExprKind,
    string,
] {
    match callable {
        TraitMethod { .. } | DynTraitMethod { .. } | InherentMethod { .. } => (),
        _ => return Err("only comptime functions can be used as compile-time function values"),
    }
    let Func { params, ret_ty } = resolve_type(ty) else {
        return Err("comptime callable requires a function type")
    };
    let callable = match callable {
        TraitMethod { trait_ref, method_name, for_ty, has_receiver } if has_receiver => match resolve_type(
            for_ty,
        ) {
            Dyn { trait_name, .. } => Callable::DynTraitMethod {
                trait_name,
                dispatch_name: trait_ref.name,
                method_name,
            },
            _ => callable,
        },
        _ => callable,
    };
    let parameters: Vec[ClosureParam] = Vec::new();
    let arguments: Vec[Expr] = Vec::new();
    let prefix = "$comptime_method_value_" + ctx.next_slot.get().to_string() + "_";
    for index in 0..params.len() {
        let name = prefix + index.to_string();
        parameters.push(ClosureParam { name, ty: params[index] });
        arguments.push(Expr::Var { name, ty: params[index] });
    }
    lower_ct_closure(
        CtLowerContext { origin_spans: Vec::new(), origin_cursor: Ref::new(0), ..ctx },
        parameters,
        Expr::Call { func: Expr::Callable { callable, ty }, args: arguments, ty: ret_ty },
    )
}

fn lower_ct_function_value(ctx: CtLowerContext, callable: Callable, ty: Type) -> Result[
    ctir::CtExprKind,
    string,
] {
    let Callable::Function(name) = callable else {
        return lower_ct_method_value(ctx, callable, ty)
    };
    let Some(target) = function_call_target(ctx, name) else {
        return Err("comptime function value refers to runtime-only function `" + name + "`")
    };
    let Func { params, ret_ty } = resolve_type(ty) else {
        return Err("comptime callable requires a function type")
    };
    let local_start = ctx.next_slot.get();
    let parameters = Vec::new();
    let args = Vec::new();
    for param in params {
        let slot = ctx.next_slot.get();
        ctx.next_slot.set(slot + 1);
        let ty = lower_ct_type(ctx, param)?;
        ctx.local_types.push(ty);
        parameters.push(slot);
        args.push(ctir::CtExpr { kind: ctir::CtExprKind::Local(slot), ty, origin: ctx.origin });
    }
    Ok(
        ctir::CtExprKind::Closure {
            parameters,
            local_start,
            body: ctir::CtExpr {
                kind: ctir::CtExprKind::Call { target, args },
                ty: lower_ct_type(ctx, ret_ty)?,
                origin: ctx.origin,
            },
        },
    )
}
