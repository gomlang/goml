package checker;

use std::testing;

#[test]
fn rejects_associated_type_definitions_in_inherent_impls() -> () {
    for source in[
        "struct Value {} impl Value { type Item = bool; }",
        "struct Value[T] { value: T } impl[T] Value[T] { type Item = T; }",
        "struct Value {} impl Value { type Item = bool; type Item = i32; }",
        "struct Value {} type Alias = Value; impl Alias { type Item = bool; }",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "Associated type Item is only allowed in a trait implementation",
            ),
        );
    }
}

#[test]
fn trait_associated_types_and_inherent_constants_remain_valid() -> () {
    for source in[
        "trait Source { type Item; } struct Value {} impl Source for Value { type Item = bool; }",
        "struct Value {} impl Value { const COUNT: i32 = 3; fn count() -> i32 { Self::COUNT } }",
        "trait Source { type Item; } struct Value[T] { value: T } impl[T] Source for Value[T] { type Item = T; }",
    ] {
        let _ = checked_file(source);
    }
}
