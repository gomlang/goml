package checker;

use module::hir;
use module::tast::{FunctionScheme, MethodInfo, TraitRef, Type, VarKind, dyn_bounds, opaque_bounds, opaque_parts};

fn opaque_return_type(name: string, generics: Vec[string], raw: Type, definition: hir::DefId) -> Type {
    if let App { ty: Con { name: marker }, args } = raw {
        if marker == "$impl_trait" && args.len() == 1 {
            let variable_index = match definition {
                Source { index, .. } => index,
                hir::DefId::External { .. } => 0,
            };
            let parameters: Vec[Type] = Vec::new();
            for generic in generics {
                parameters.push(Type::Param { name: generic })
            }
            let values = Vec::from_array(
                [
                    Type::Func {
                        params: parameters,
                        ret_ty: Type::Var(
                            Ref::new(Unbound { id: -variable_index - 1, kind: VarKind::Any }),
                        ),
                    },
                    args[0],
                ],
            );
            for parameter in parameters {
                values.push(parameter)
            }
            return App {
                ty: Type::Con { name: "$opaque:" + name + "#" + hir::definition_key(definition) },
                args: values,
            }
        }
    }
    raw
}

fn opaque_definition_matches(value: Option[hir::DefId], definition: hir::DefId) -> bool {
    match value {
        Some(value) => same_def(value, definition),
        None => false,
    }
}

fn opaque_function_return(ctx: Checker, definition: hir::DefId) -> Option[Type] {
    for function in ctx.functions {
        if opaque_definition_matches(function.def_id, definition)
            && opaque_parts(function.ret_ty).is_some() {
            return Some(function.ret_ty)
        }
    }
    for method in ctx.methods {
        if opaque_definition_matches(method.function.def_id, definition)
            && opaque_parts(method.function.ret_ty).is_some() {
            return Some(method.function.ret_ty)
        }
    }
    None
}

fn share_opaque_type(value: Type, templates: HashMap[string, Type]) -> Type {
    let Some((name, args)) = opaque_parts(value) else {
        return value
    };
    let shared = match templates.get(name) {
        Some(template) => template,
        None => {
            templates.set(name, args[0]);
            args[0]
        },
    };
    let values: Vec[Type] = Vec::new();
    values.push(shared);
    for index in 1..args.len() {
        values.push(args[index])
    }
    App { ty: Type::Con { name }, args: values }
}

fn share_opaque_signatures(ctx: Checker, templates: HashMap[string, Type]) -> () {
    for index in 0..ctx.functions.len() {
        let function = ctx.functions[index];
        ctx.functions[index] = FunctionScheme {
            ret_ty: share_opaque_type(function.ret_ty, templates),
            ..function,
        };
    }
    for index in 0..ctx.methods.len() {
        let method = ctx.methods[index];
        let function = method.function;
        ctx.methods[index] = MethodInfo {
            function: FunctionScheme {
                ret_ty: share_opaque_type(function.ret_ty, templates),
                ..function,
            },
            ..method,
        };
    }
}

fn validate_opaque_type(ctx: Checker, value: Type) -> () {
    for bound in dyn_bounds(opaque_bounds(value)) {
        validate_trait_reference(ctx, TraitRef { name: bound.trait_name, args: bound.args });
        validate_bound_associated_types(ctx, bound, "opaque");
        for associated in bound.associated_types {
            validate_signature_type(ctx, associated.1)
        }
    }
}

fn resolve_opaque_method(ctx: Checker, receiver: Type, name: string, explicit: Vec[Type]) -> Option[
    ResolvedCallable,
] {
    let results: Vec[ResolvedCallable] = Vec::new();
    for reference in dyn_applications(ctx, opaque_bounds(receiver)) {
        if let Some(result) = resolve_trait_reference_method(
            ctx,
            reference,
            name,
            Some(receiver),
            explicit,
            true,
        ) {
            results.push(result)
        }
    }
    if results.len() == 1 {
        Some(results[0])
    } else {
        if results.len() > 1 {
            push_diagnostic(ctx, "Ambiguous method " + name + " on opaque return type; use UFCS")
        }
        None
    }
}
