package checker;

use std::testing;

#[test]
fn associated_projection_candidates_normalize_inferred_trait_arguments() -> () {
    for argument in["T::Item", "Vec[T::Item]", "(T::Item, T::Item)"] {
        let concrete = if argument == "T::Item" {
            "i32"
        } else if argument == "Vec[T::Item]" {
            "Vec[i32]"
        } else {
            "(i32, i32)"
        };
        let _ = checked_file(
            "trait Source { type Item; } impl Source for bool { type Item = i32; } trait Target[A] { type Output; } impl[T: Source] Target["
                + argument
                + "] for Vec[T] { type Output = string; } fn convert[T: Target["
                + concrete
                + "]](value: T::Output) -> string where T = Vec[bool] { value }",
        );
    }
}

#[test]
fn normalized_projection_candidates_preserve_arguments_and_predicates() -> () {
    for source in[
        "trait Source { type Item; } impl Source for bool { type Item = i32; } trait Target[A] { type Output; } impl[T: Source] Target[T::Item] for Vec[T] { type Output = string; } fn convert[T: Target[bool]](value: T::Output) -> string where T = Vec[bool] { value }",
        "trait Source { type Item; } impl Source for bool { type Item = i32; } trait Marker {} trait Target[A] { type Output; } impl[T: Source + Marker] Target[T::Item] for Vec[T] { type Output = string; } fn convert[T: Target[i32]](value: T::Output) -> string where T = Vec[bool] { value }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}
