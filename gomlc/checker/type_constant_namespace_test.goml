package checker;

use std::testing;

#[test]
fn type_annotations_preserve_separate_constant_namespace() -> () {
    for declaration in["struct Size { value: i32 }", "struct Item { value: i32 } type Size = Item;"] {
        let _ = checked_file(
            declaration
                + " const Size: usize = 2; fn accept(value: Size) -> i32 { value.value } fn main() -> () { let value: Size = Size { value: 7 }; println(accept(value)); }",
        );
    }
}

#[test]
fn generic_argument_names_follow_parameter_kind() -> () {
    for declaration in["struct Size { value: i32 }", "struct Item { value: i32 } type Size = Item;"] {
        let _ = checked_file(
            declaration
                + " const Size: usize = 2; struct Typed[T] { value: T } struct Fixed[const N: usize] { items: [i32; N] } type FixedAlias[const N: usize] = Fixed[N]; fn identity[T](value: T) -> T { value } fn count[const N: usize]() -> usize { N } fn main() -> () { let value: Typed[Size] = Typed { value: Size { value: 7 } }; let values: Vec[Size] = Vec::new(); let fixed: Fixed[Size] = Fixed { items: [1, 2] }; let alias: FixedAlias[Size] = fixed; let same: Size = identity::[Size](value.value); let length: usize = count::[Size](); }",
        );
    }
}

#[test]
fn generic_method_argument_names_follow_parameter_kind() -> () {
    let _ = checked_file(
        "struct Item { value: i32 } type Size = Item; const Size: usize = 2; struct Methods {} impl Methods { fn identity[T](value: T) -> T { value } fn count[const N: usize]() -> usize { N } } fn main() -> () { let value: Size = Methods::identity::[Size](Item { value: 7 }); let length: usize = Methods::count::[Size](); }",
    );
}

#[test]
fn trait_argument_names_follow_parameter_kind() -> () {
    let _ = checked_file(
        "struct Item {} type Size = Item; const Size: usize = 2; trait Typed[T] {} trait Sized[const N: usize] {} struct Owner {} impl Typed[Size] for Owner {} impl Sized[Size] for Owner {} fn accept[T: Typed[Size] + Sized[Size]](value: T) -> () {} fn main() -> () { accept(Owner {}); }",
    );
}

#[test]
fn type_names_do_not_supply_missing_constant_arguments() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "struct Size {} struct Fixed[const N: usize] {} fn main() -> () { let value: Fixed[Size] = Fixed {}; }",
            ),
            "const generic argument must be an integer constant",
        ),
    );
}

#[test]
fn instance_generic_argument_names_follow_parameter_kind() -> () {
    let _ = checked_file(
        "struct Item { value: i32 } type Size = Item; const Size: usize = 2; struct Methods {} impl Methods { fn identity[T](self: Self, value: T) -> T { value } fn count[const N: usize](self: Self) -> usize { N } } fn main() -> () { let methods = Methods {}; let value: Size = methods.identity::[Size](Item { value: 7 }); let length: usize = methods.count::[Size](); }",
    );
}
