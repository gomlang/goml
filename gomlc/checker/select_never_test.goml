package checker;

use std::testing;

#[test]
fn select_divergence_preserves_inferred_never_types() -> () {
    for source in[
        "fn run(channel: Channel[i32]) -> () { let value = select { recv(channel) as _ => return, default => return, }; }",
        "fn run(channel: Channel[i32]) -> i32 { let value = select { send(channel, 1) => return 2, default => return 3, }; }",
        "fn run(channel: Channel[i32]) -> () { let callback = || select { recv(channel) as _ => loop {}, }; let typed: () -> () = callback; }",
        "fn run(channel: Channel[i32]) -> () { let callback: () -> never = || select { recv(channel) as _ => loop {}, }; }",
        "fn run(channel: Channel[i32]) -> i32 { loop { let value = select { recv(channel) as _ => break 1, default => break 2, }; } }",
    ] {
        let _ = checked_file(source);
    }
    testing::assert(
        !checked_diagnostics(
            "fn run(channel: Channel[i32]) -> never { select { recv(channel) as _ => loop {}, default => 1, } }",
        ).is_empty(),
    );
}
