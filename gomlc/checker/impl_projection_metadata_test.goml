package checker;

use std::testing;

#[test]
fn impl_metadata_preserves_declared_projection_qualifiers() -> () {
    let prefix = "trait Input { type Item; } trait Other { type Item; } impl Input for bool { type Item = i32; } impl Other for bool { type Item = bool; } ";
    for source in[
        "trait Output { type Value; } impl[T: Input] Output for Vec[T] where T::Item = i32 { type Value = string; } fn convert[T: Output](value: T::Value) -> string where T = Vec[bool] { value }",
        "trait Output { type Value; } impl[T: Input] Output for Vec[T] { type Value = T::Item; } fn convert[T: Output](value: T::Value) -> i32 where T = Vec[bool] { value }",
        "trait Output[A] { type Value; } impl[T: Input] Output[T::Item] for Vec[T] { type Value = string; } fn convert[T: Output[i32]](value: T::Value) -> string where T = Vec[bool] { value }",
    ] {
        let _ = checked_file(prefix + source);
    }
}

#[test]
fn impl_metadata_does_not_select_unrelated_associated_types() -> () {
    let prefix = "trait Input { type Item; } trait Other { type Item; } impl Input for bool { type Item = i32; } impl Other for bool { type Item = bool; } ";
    for source in[
        "trait Output { type Value; } impl[T: Input] Output for Vec[T] where T::Item = bool { type Value = string; } fn convert[T: Output](value: T::Value) -> string where T = Vec[bool] { value } fn main() -> () { convert::[Vec[bool]](\"wrong\"); }",
        "trait Output { type Value; } impl[T: Input] Output for Vec[T] { type Value = T::Item; } fn convert[T: Output](value: T::Value) -> bool where T = Vec[bool] { value }",
    ] {
        testing::assert(!checked_diagnostics(prefix + source).is_empty());
    }
}

#[test]
fn impl_metadata_preserves_self_projection_origin_before_owner_substitution() -> () {
    let _ = checked_file(
        "trait Input { type Item; } trait Output { type Item; type Value; } impl Input for bool { type Item = i32; } impl[T: Input] Output for T { type Item = bool; type Value = Self::Item; } fn convert[T: Output](value: T::Value) -> bool where T = bool { value } fn main() -> () { let value: bool = convert::[bool](true); }",
    );
    let _ = checked_file(
        "trait Input[A] { type Item; } trait Output[A] { type Item; type Value; } impl Input[i32] for bool { type Item = string; } impl[T: Input[A], A] Output[A] for T { type Item = A; type Value = (Self::Item, T::Item); } fn convert[T: Output[i32]](value: T::Value) -> (i32, string) where T = bool { value }",
    );
    let _ = checked_file(
        "trait Parent[A] { type Item; } trait Output[A]: Parent[A] { type Value; } impl Parent[i32] for bool { type Item = i32; } impl[T: Parent[A], A] Output[A] for T { type Value = Self::Item; } fn convert[T: Output[i32]](value: T::Value) -> i32 where T = bool { value }",
    );
    testing::assert(
        !checked_diagnostics(
            "trait Input { type Item; } trait Output { type Item; type Value; } impl Input for bool { type Item = i32; } impl[T: Input] Output for T { type Item = bool; type Value = Self::Item; } fn convert[T: Output](value: T::Value) -> i32 where T = bool { value }",
        ).is_empty(),
    );
}
