package checker;

use module::tast;

fn call_dyn_bindings_compatible(left: Vec[(string, tast::Type)], right: Vec[(string, tast::Type)]) -> bool {
    if left.len() != right.len() {
        return false
    }
    for binding in left {
        let mut found = false;
        for candidate in right {
            if binding.0 == candidate.0 {
                if !call_types_compatible(binding.1, candidate.1) {
                    return false
                }
                found = true;
                break
            }
        }
        if !found {
            return false
        }
    }
    true
}

fn call_dyn_types_compatible(left: tast::Type, right: tast::Type) -> bool {
    let left_bounds = tast::dyn_bounds(left);
    let right_bounds = tast::dyn_bounds(right);
    if left_bounds.len() != right_bounds.len() {
        return false
    }
    for bound in left_bounds {
        let mut found = false;
        for candidate in right_bounds {
            if tast::names_match(bound.trait_name, candidate.trait_name) {
                if !call_type_lists_compatible(bound.args, candidate.args)
                    || !call_dyn_bindings_compatible(
                        bound.associated_types,
                        candidate.associated_types,
                    ) {
                    return false
                }
                found = true;
                break
            }
        }
        if !found {
            return false
        }
    }
    true
}
