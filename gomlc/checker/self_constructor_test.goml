package checker;

use std::testing;

#[test]
fn self_constructors_preserve_specialized_owner_types() -> () {
    for source in[
        "enum Value[T] { Empty, Item(T) } impl[T] Value[T] { fn empty() -> Self { Self::Empty } fn is_empty(self: Self) -> bool { match self { Self::Empty => true, Self::Item(_) => false } } }",
        "struct Value { value: i32 } fn get[T](input: T) -> i32 where T = Value { let T { value } = input; value }",
        "struct Value[T](T); impl[T] Value[T] { fn new(value: T) -> Self { Self(value) } fn get(self: Self) -> T { let Self(value) = self; value } }",
        "enum Value[T] { Item(T) } impl[T] Value[T] { fn new(value: T) -> Self { Self::Item(value) } fn get(self: Self) -> T { match self { Self::Item(value) => value } } }",
        "enum Value[T] { Item { value: T } } impl[T] Value[T] { fn new(value: T) -> Self { Self::Item { value } } fn get(self: Self) -> T { match self { Self::Item { value } => value } } }",
        "struct Value[T] { value: T } impl[T] Value[T] { fn new(value: T) -> Self { Self { value } } fn get(self: Self) -> T { let Self { value } = self; value } }",
        "enum Value[T] { Item(T) } impl[T] Value[T] { fn new(value: T) -> Self { let make = Self::Item; make(value) } }",
        "enum Value[T] { Item(T) } fn make[T]() -> T where T = Value[i32] { T::Item(42) }",
        "struct Value[T] { value: T } fn make[T]() -> T where T = Value[i32] { T { value: 42 } }",
    ] {
        testing::assert_eq(checked_diagnostics(source).len(), 0);
    }
    for source in[
        "enum Value[T] { Item(T) } impl[T] Value[T] { fn invalid() -> Self { Self::Item(true) } }",
        "enum Value[T] { Item(T) } impl[T] Value[T] { fn invalid(value: T) -> Self { Self::[i32]::Item(value) } }",
        "enum Value[T] { Item(T) } fn invalid[T]() -> T where T = Value[i32] { T::Item(true) }",
        "enum T { Item } fn invalid[T]() -> T { T::Item }",
        "struct T { value: i32 } fn invalid[T]() -> T { T { value: 42 } }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}
