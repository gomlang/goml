package checker;

use std::testing;

#[test]
fn trait_impl_signatures_respect_owner_and_method_equalities() -> () {
    for source in[
        "trait Read { fn read(self: Self) -> i32; } struct Box[T] { value: T } impl[T] Read for Box[T] where T = i32 { fn read(self: Box[T]) -> T { self.value } }",
        "trait Convert { fn convert[T](self: Self, value: T) -> T where T = i32; } impl Convert for bool { fn convert[U](self: bool, value: i32) -> i32 where U = i32 { value } }",
        "trait Convert { fn convert[T](self: Self, value: i32) -> i32 where T = i32; } impl Convert for bool { fn convert[U](self: bool, value: U) -> U where U = i32 { value } }",
        "trait Read { type Item; fn read(self: Self) -> Self::Item; } struct Box[T] { value: T } impl[T] Read for Box[T] where T = i32 { type Item = T; fn read(self: Box[T]) -> i32 { self.value } }",
        "trait Source { type Item; } trait Convert { fn convert[I: Source](self: Self, value: I::Item) -> I::Item where I::Item = i32; } impl Convert for bool { fn convert[J: Source](self: bool, value: i32) -> i32 where J::Item = i32 { value } }",
    ] {
        let _ = checked_file(source);
    }
    for source in[
        "trait Read { fn read(self: Self) -> i32; } struct Box[T] { value: T } impl[T] Read for Box[T] where T = bool { fn read(self: Box[T]) -> T { self.value } }",
        "trait Convert { fn convert[T](self: Self, value: T) -> T where T = i32; } impl Convert for bool { fn convert[U](self: bool, value: bool) -> bool where U = i32 { value } }",
        "trait Convert { fn convert[T](self: Self, value: T) -> T; } impl Convert for bool { fn convert[U](self: bool, value: i32) -> i32 where U = i32 { value } }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}
