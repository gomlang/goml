package checker;

use std::testing;

#[test]
fn constrained_static_method_owners_resolve_concrete_implementations() -> () {
    let prefix = "struct Box[T] { value: T } impl[T] Box[T] { fn new(value: T) -> Box[T] { Box { value } } } ";
    for body in[
        "fn make[T]() -> T where T = Box[i32] { T::new(42) }",
        "fn make[T]() -> T where T = Box[i32] { let build = T::new; build(42) }",
        "fn make[T, U](value: U) -> T where T = Box[U] { T::new(value) }",
    ] {
        testing::assert_eq(checked_diagnostics(prefix + body).len(), 0);
    }
    for body in[
        "fn make[T]() -> T where T = Box[i32] { T::new(true) }",
        "fn make[T]() -> T where T = Box[i32] { T::[i32]::new(42) }",
        "fn make[T]() -> T where T = Box[i32] { T::missing(42) }",
    ] {
        testing::assert(!checked_diagnostics(prefix + body).is_empty());
    }
}

#[test]
fn constrained_static_owners_resolve_associated_constants() -> () {
    testing::assert_eq(
        checked_diagnostics(
            "struct Counter {} impl Counter { const DEFAULT: i32 = 42; } fn value[T]() -> i32 where T = Counter { T::DEFAULT }",
        ).len(),
        0,
    );
}
