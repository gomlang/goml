package checker;

use std::testing;

#[test]
fn native_map_structural_keys_do_not_require_goml_equality_or_hash() -> () {
    for key in["[Point; 1]", "(Point, i32)"] {
        let _ = checked_file(
            "struct Point { x: i32 } fn accept(value: GoMap[" + key + ", i32]) -> () {}",
        );
    }
}

#[test]
fn hashmap_structural_keys_still_require_goml_equality_and_hash() -> () {
    for key in["[Point; 1]", "(Point, i32)"] {
        testing::assert(
            !checked_diagnostics(
                "struct Point { x: i32 } fn main() -> () { let value: HashMap[" + key
                    + ", i32] = HashMap::new(); }",
            ).is_empty(),
        );
    }
}

#[test]
fn unused_hashmap_types_do_not_require_constructible_dictionaries() -> () {
    for key in["[Point; 1]", "(Point, i32)"] {
        let _ = checked_file(
            "struct Point { x: i32 } fn main() -> () { let value: Option[HashMap[" + key
                + ", i32]] = None; let _: bool = value.is_none(); }",
        );
    }
}
