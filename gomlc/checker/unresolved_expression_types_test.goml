package checker;

use std::testing;

#[test]
fn unresolved_expression_types_report_inference_failures() -> () {
    for source in[
        "fn main() -> () { let values = Vec::new(); }",
        "fn main() -> () { let _ = Vec::new(); }",
        "fn main() -> () { Vec::new(); }",
        "fn main() -> () { let values = []; }",
        "fn main() -> () { let value = Option::None; }",
        "trait Read[T] {} fn identity[T](value: dyn Read[T]) -> dyn Read[T] { value } fn main() -> () { let callback = identity; }",
        "trait Item { type Value; } fn identity[T](value: dyn Item[Value = T]) -> dyn Item[Value = T] { value } fn main() -> () { let callback = identity; }",
        "trait Mark {} trait Read[T] {} fn identity[T](value: dyn Mark + Read[T]) -> dyn Mark + Read[T] { value } fn main() -> () { let callback = identity; }",
        "fn identity[T](value: T) -> T { value } fn main() -> () { let value = identity(return); }",
    ] {
        let diagnostics = checked_diagnostics(source);
        let mut found = false;
        for diagnostic in diagnostics {
            if diagnostic.message == "Could not infer type" {
                testing::assert(diagnostic.span.is_some());
                found = true;
            }
        }
        if !found {
            testing::fail(source)
        }
    }
}

#[test]
fn expression_types_can_be_inferred_from_later_constraints() -> () {
    for source in[
        "fn main() -> () { let values = Vec::new(); values.push(1); }",
        "fn main() -> () { let values = []; let typed: [i32; 0] = values; }",
        "fn main() -> () { let values: Vec[i32] = Vec::new(); }",
        "fn main() -> () { let value = Option::None; let typed: Option[i32] = value; }",
        "fn empty[T]() -> Vec[T] { Vec::new() }",
        "fn main() -> () { let value = 1; let floating = 1.5; }",
    ] {
        let _ = checked_file(source);
    }
}
