package checker;

use module::tast::{Type, prune, types_equal};

fn is_unbound_numeric_receiver(ty: Type) -> bool {
    match prune(ty) {
        Var(_) => is_numeric_type(ty),
        _ => false,
    }
}

fn default_deferred_numeric_receivers(ctx: Checker) -> bool {
    let mut changed = false;
    for pending in ctx.inference.deferred_methods {
        if pending.resolved.get().is_none() {
            if let Func { params, .. } = prune(pending.ty) {
                if !params.is_empty() {
                    let receiver = normalize_type(ctx, params[0]);
                    if is_unbound_numeric_receiver(receiver)
                        && !numeric_receiver_has_dyn_choice(ctx, receiver) {
                        let _ = unify(receiver, default_numeric_type(receiver));
                        changed = true;
                    }
                }
            }
        }
    }
    changed
}

fn infer_deferred_numeric_receiver(ctx: Checker, pending: DeferredMethod) -> bool {
    let Func { params, ret_ty } = prune(pending.ty) else {
        return false
    };
    if params.is_empty() || !is_unbound_numeric_receiver(params[0]) {
        return false
    }
    let args = Vec::new();
    for index in 1..params.len() {
        args.push(params[index]);
    }
    let inherent: Vec[InferenceSnapshot] = Vec::new();
    let traits: Vec[InferenceSnapshot] = Vec::new();
    for method in ctx.methods {
        if method.function.name == pending.name && method_trait_in_scope(ctx, method) {
            let snapshot = deferred_dependency_snapshot(ctx, Vec::from_array([pending.ty]));
            snapshot.include_types(pending.explicit);
            let diagnostic_start = ctx.diagnostics.len();
            let candidate = instantiate_method_candidate(ctx, method, Vec::new(), pending.explicit);
            if is_numeric_type(candidate.owner) && !is_unbound_numeric_receiver(candidate.owner)
                && unify(candidate.owner, params[0])
                && method_matches_call(ctx, candidate.callable, params[0], args, Some(ret_ty))
                && static_method_owner_predicates_possible(ctx, candidate.owner_predicates)
                && ctx.diagnostics.len() == diagnostic_start {
                if method.trait_ref.is_some() {
                    traits.push(snapshot.capture());
                } else {
                    inherent.push(snapshot.capture());
                }
            }
            snapshot.restore();
            ctx.diagnostics.truncate(diagnostic_start);
        }
    }
    let candidates = if inherent.is_empty() {
        traits
    } else {
        inherent
    };
    if candidates.len() == 1 {
        candidates[0].restore();
        true
    } else {
        false
    }
}

fn numeric_receiver_has_dyn_choice(ctx: Checker, receiver: Type) -> bool {
    for constraint in ctx.inference.dyn_numeric_constraints {
        let actual = normalize_type(ctx, constraint.actual);
        if is_unbound_numeric_receiver(actual) && types_equal(prune(actual), prune(receiver)) {
            return true
        }
    }
    false
}

fn infer_deferred_dyn_numeric(ctx: Checker, constraint: DynNumericConstraint) -> bool {
    let snapshot = deferred_dependency_snapshot(
        ctx,
        Vec::from_array([constraint.actual, constraint.target]),
    );
    let diagnostic_start = ctx.diagnostics.len();
    infer_dyn_numeric_type(ctx, constraint.actual, constraint.target);
    if ctx.diagnostics.len() != diagnostic_start {
        snapshot.restore();
        ctx.diagnostics.truncate(diagnostic_start);
        false
    } else {
        snapshot.changed()
    }
}

fn numeric_deferred_method_candidates(
    ctx: Checker,
    receiver: Type,
    name: string,
    args: Vec[Type],
    expected: Option[Type],
    explicit: Vec[Type],
) -> Vec[Type] {
    let inherent: Vec[Type] = Vec::new();
    let traits: Vec[Type] = Vec::new();
    for method in ctx.methods {
        if method.function.name == name && method_trait_in_scope(ctx, method) {
            let snapshot = method_inference_snapshot(receiver, args, expected, explicit);
            let diagnostic_start = ctx.diagnostics.len();
            let candidate = instantiate_method_candidate(ctx, method, Vec::new(), explicit);
            if is_numeric_type(candidate.owner) && !is_unbound_numeric_receiver(candidate.owner)
                && unify(candidate.owner, receiver)
                && method_matches_call(ctx, candidate.callable, receiver, args, expected)
                && static_method_owner_predicates_possible(ctx, candidate.owner_predicates)
                && ctx.diagnostics.len() == diagnostic_start {
                if method.trait_ref.is_some() {
                    traits.push(resolved_inference_type(candidate.callable.ty));
                } else {
                    inherent.push(resolved_inference_type(candidate.callable.ty));
                }
            }
            snapshot.restore();
            ctx.diagnostics.truncate(diagnostic_start);
        }
    }
    if inherent.is_empty() {
        traits
    } else {
        inherent
    }
}
