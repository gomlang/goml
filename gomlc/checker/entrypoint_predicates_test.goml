package checker;

use std::testing;

#[test]
fn entrypoints_discharge_declared_predicates_without_assuming_them() -> () {
    for source in[
        "trait Read { fn read(self) -> i32; } fn main() -> () where bool: Read { println(true.read()); }",
        "trait Read {} fn main() -> () where bool: Read {}",
        "fn main() -> () where bool = i32 {}",
        "fn main() -> () where Vec[bool] = Vec[i32] {}",
    ] {
        testing::assert(has_diagnostic_containing(checked_diagnostics(source), "entrypoint bounds"));
    }
}

#[test]
fn entrypoints_accept_proven_predicates_and_ordinary_functions_keep_assumptions() -> () {
    for source in[
        "trait Read { fn read(self) -> i32; } impl Read for bool { fn read(self) -> i32 { 7 } } fn main() -> () where bool: Read { println(true.read()); }",
        "fn main() -> () where bool = bool {}",
        "trait Read {} fn unused() -> () where bool: Read {} fn main() -> () {}",
        "struct Value {} trait Read {} impl[T] Read for Vec[T] {} fn main() -> () where Vec[Value]: Read {}",
    ] {
        let _ = checked_file(source);
    }
}
