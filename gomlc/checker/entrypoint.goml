package checker;

use module::diagnostic::{Diagnostic};
use module::hir;
use module::tast::{DependencyEnvironment, builtin_contract};

fn require_entrypoint_predicates(ctx: Checker, name: string) -> () {
    if let Some(function) = find_function_by_name(ctx, name) {
        if function.generics.is_empty() {
            for predicate in function.predicates {
                if !predicates_satisfied_at(ctx, Vec::from_array([predicate]), Vec::new()) {
                    push_diagnostic(ctx, "main function does not satisfy its entrypoint bounds")
                }
            }
        }
    }
}

pub fn entrypoint_predicate_diagnostics(
    file: hir::File,
    dependencies: Vec[DependencyEnvironment],
    external: ExternalTypeEnvironment,
    name: string,
) -> Result[Vec[Diagnostic], string] {
    let ctx = collect_environment_with_external_aliases(
        file,
        true,
        builtin_contract()?,
        external_environment_aliases(external)?,
    );
    for dependency in dependencies {
        append_dependency_environment(ctx, dependency)
    }
    append_builtin_source_impls(ctx);
    for index in 0..ctx.traits.len() {
        ctx.traits.set(index, resolve_trait_info_signature(ctx, ctx.traits[index]))
    }
    for index in 0..ctx.impls.len() {
        ctx.impls.set(index, resolve_impl_info_signature(ctx, ctx.impls[index]))
    }
    for index in 0..ctx.functions.len() {
        ctx.functions.set(index, resolve_function_scheme_signature(ctx, ctx.functions[index]))
    }
    let initial = ctx.diagnostics.len();
    require_entrypoint_predicates(ctx, name);
    let diagnostics = Vec::new();
    for index in initial..ctx.diagnostics.len() {
        diagnostics.push(ctx.diagnostics[index])
    }
    Ok(diagnostics)
}
