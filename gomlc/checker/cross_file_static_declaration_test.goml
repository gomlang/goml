package checker;

use module::ast;
use module::hir;
use module::parser;
use std::testing;

#[test]
fn static_names_cannot_collide_across_package_files() -> () {
    for declaration in[
        "static cell: OnceCell[bool] = OnceCell::new();",
        "const cell: i32 = 1;",
        "fn cell() -> i32 { 1 }",
    ] {
        let parsed = Vec::from_array(
            [
                parser::parse("package values; static cell: OnceCell[i32] = OnceCell::new();"),
                parser::parse("package values; " + declaration),
            ],
        );
        let ast_files = ast::lower_package(parsed);
        let inputs: Vec[(ast::LowerResult, string)] = Vec::from_array(
            [(ast_files[0], "first.goml"), (ast_files[1], "second.goml")],
        );
        let files: Vec[hir::File] = Vec::new();
        for lowered in hir::lower_package_files(inputs, "example::values") {
            match lowered.hir {
                Some(file) => files.push(file),
                None => {
                    let messages: Vec[string] = Vec::new();
                    for diagnostic in lowered.diagnostics {
                        messages.push(diagnostic.message)
                    }
                    testing::fail(declaration + ": " + messages.join("; "))
                },
            }
        }
        let checked = check_package_files_for_link_with_dependencies(files, Vec::new());
        testing::assert(
            has_diagnostic_containing(checked.diagnostics, "example::values::cell is defined"),
        );
    }
}
