package checker;

use module::tast;
use module::ast;
use module::hir;
use module::parser;
use std::testing;

#[test]
fn method_compatibility_distinguishes_never_values_and_nested_types() -> () {
    testing::assert(call_value_types_compatible(tast::Type::Never, tast::Type::Int32));
    testing::assert(!call_value_types_compatible(tast::Type::Int32, tast::Type::Never));
    let never_vec = tast::Type::VecType { elem: tast::Type::Never };
    let int_vec = tast::Type::VecType { elem: tast::Type::Int32 };
    testing::assert(call_types_compatible(never_vec, never_vec));
    testing::assert(!call_value_types_compatible(never_vec, int_vec));
    testing::assert(!call_value_types_compatible(int_vec, never_vec));
}

#[test]
fn diverging_method_results_remain_candidates_for_expected_values() -> () {
    let _ = checked_file(
        "trait First { fn make(self: Self) -> never; } trait Second { fn make(self: Self) -> string; } impl First for bool { fn make(self: bool) -> never { loop {} } } impl Second for bool { fn make(self: bool) -> string { \"\" } } fn choose(value: bool) -> i32 { value.make() }",
    );
}

#[test]
fn deferred_method_results_keep_the_selected_never_signature() -> () {
    let source = "trait First { fn make(self: Self) -> never; } trait Second { fn make(self: Self) -> string; } impl First for bool { fn make(self: bool) -> never { loop {} } } impl Second for bool { fn make(self: bool) -> string { \"\" } } fn main() -> () { let call = |value| value.make(); if false { let result: i32 = call(true); } }";
    let checked = check(hir::lower(ast::lower(parser::parse(source)), "main.goml"));
    testing::assert_eq(checked.diagnostics.len(), 0);
    let mut found = false;
    for call in checked.typeck_results.calls {
        if let Callable(TraitMethod { method_name, .. }) = call.target {
            if method_name == "make" {
                testing::assert(tast::types_equal(call.result_ty, tast::Type::Never));
                for expr in checked.typeck_results.exprs {
                    if expr.span.start == call.span.start && expr.span.end == call.span.end {
                        testing::assert(tast::types_equal(expr.ty, tast::Type::Never));
                        found = true;
                    }
                }
            }
        }
    }
    testing::assert(found);
}
