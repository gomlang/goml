package checker;

use std::testing;

#[test]
fn boolean_or_patterns_preserve_coverage_and_binding_types() -> () {
    for source in[
        "fn f(value: bool) -> i32 { match value { true | false => 7 } }",
        "fn f(value: bool) -> i32 { match value { true | _ => 7 } }",
        "fn f(value: bool) -> bool { match value { x | x => x } }",
        "fn f(value: bool) -> i32 { match value { true => 1, true | false => 2 } }",
        "fn f(value: bool, guard: bool) -> i32 { match value { true | false if guard => 1, _ => 2 } }",
        "const YES: bool = true; const NO: bool = false; fn f(value: bool) -> i32 { match value { YES | NO => 7 } }",
    ] {
        if !checked_diagnostics(source).is_empty() {
            testing::fail(source)
        }
    }
}

#[test]
fn boolean_or_patterns_reject_missing_cases_and_inconsistent_bindings() -> () {
    for case in[
        ("fn f(value: bool) -> i32 { match value { true | true => 7 } }", "non-exhaustive match"),
        (
            "fn f(value: bool, guard: bool) -> i32 { match value { true | false if guard => 1 } }",
            "non-exhaustive match",
        ),
        ("fn f(value: bool) -> bool { match value { x | true => x } }", "Or-pattern alternatives"),
    ] {
        if !has_diagnostic_containing(checked_diagnostics(case.0), case.1) {
            testing::fail(case.0 + " expected diagnostic: " + case.1)
        }
    }
}
