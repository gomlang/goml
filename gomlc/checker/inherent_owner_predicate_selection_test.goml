package checker;

use std::testing;

fn disjoint_inherent_owner_declarations() -> string {
    "trait NumberTag {} trait BoolTag {} impl NumberTag for i32 {} impl BoolTag for bool {} struct Value[T] { value: T } impl[T: NumberTag] Value[T] { fn read(self: Value[T]) -> i32 { 1 } fn create() -> i32 { 3 } } impl[T: BoolTag] Value[T] { fn read(self: Value[T]) -> i32 { 2 } fn create() -> i32 { 4 } } "
}

#[test]
fn inherent_candidates_filter_their_instantiated_owner_requirements() -> () {
    for source in[
        "fn f() -> i32 { Value::[i32]::create() + Value::[bool]::create() }",
        "fn f() -> i32 { { let number: i32 = 1; Value { value: number }.read() } + Value { value: true }.read() }",
        "fn f[T: NumberTag](value: Value[T]) -> i32 { value.read() }",
        "fn f() -> i32 { let make = Value::[bool]::create; make() }",
    ] {
        if !checked_diagnostics(disjoint_inherent_owner_declarations() + source).is_empty() {
            testing::fail(source)
        }
    }
    testing::assert(
        !checked_diagnostics(
            disjoint_inherent_owner_declarations() + "fn f() -> i32 { Value::[string]::create() }",
        ).is_empty(),
    );
}
