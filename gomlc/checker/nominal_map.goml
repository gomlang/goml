package checker;

use module::tast::{Type, enum_variant_field_types, for_each_child_type, prune, substitute_params, types_equal};

fn push_map_type_requirement(values: Vec[Type], value: Type) -> bool {
    for existing in values {
        if types_equal(existing, value) {
            return false
        }
    }
    values.push(value);
    true
}

fn collect_reduced_map_requirement(ctx: Checker, key: Type, result: Vec[Type]) -> () {
    let leaves = Vec::new();
    if collect_go_comparable_requirements(ctx, key, leaves, Vec::new()) {
        for leaf in leaves {
            let _ = push_map_type_requirement(result, leaf);
        }
    } else {
        let _ = push_map_type_requirement(result, Type::MutSlice { elem: Type::Unit });
    }
}

fn collect_applied_map_requirements(
    ctx: Checker,
    parameters: Vec[string],
    args: Vec[Type],
    requirements: Vec[Type],
    result: Vec[Type],
) -> () {
    for requirement in requirements {
        collect_reduced_map_requirement(
            ctx,
            substitute_params(requirement, parameters, args),
            result,
        )
    }
}

fn collect_type_map_requirements(ctx: Checker, value: Type, result: Vec[Type]) -> () {
    let pending = Vec::from_array([value]);
    while let Some(value) = pending.pop() {
        let value = prune(normalize_type(ctx, value));
        if let GoMap { key, .. } = value {
            collect_reduced_map_requirement(ctx, key, result);
        }
        if let Some(parts) = struct_application_parts(value) {
            if let Some(info) = find_struct_by_name(ctx, parts.0) {
                collect_applied_map_requirements(
                    ctx,
                    info.generics,
                    parts.1,
                    info.map_requirements,
                    result,
                )
            } else if let Some(info) = find_enum_by_name(ctx, parts.0) {
                collect_applied_map_requirements(
                    ctx,
                    info.generics,
                    parts.1,
                    info.map_requirements,
                    result,
                )
            }
        }
        let mut start = pending.len();
        match value {
            App { args, .. } => for arg in args {
                pending.push(arg)
            },
            Func { params, ret_ty } => {
                for param in params {
                    pending.push(param)
                }
                pending.push(ret_ty)
            },
            _ => for_each_child_type(value, |child| pending.push(child)),
        }
        let mut end = pending.len() - 1;
        while start < end {
            let first = pending[start];
            pending[start] = pending[end];
            pending[end] = first;
            start += 1;
            end -= 1;
        }
    }
}

fn infer_nominal_map_requirements(ctx: Checker) -> () {
    let diagnostic_count = ctx.diagnostics.len();
    for attempt in 0..256 {
        let mut changed = false;
        for info in ctx.structs {
            let found = Vec::new();
            for field in info.fields {
                collect_type_map_requirements(ctx, field.1, found)
            }
            for requirement in found {
                if push_map_type_requirement(info.map_requirements, requirement) {
                    changed = true;
                }
            }
        }
        for info in ctx.enums {
            let found = Vec::new();
            for variant in info.variants {
                for field in enum_variant_field_types(variant.fields) {
                    collect_type_map_requirements(ctx, field, found)
                }
            }
            for requirement in found {
                if push_map_type_requirement(info.map_requirements, requirement) {
                    changed = true;
                }
            }
        }
        ctx.diagnostics.truncate(diagnostic_count);
        if !changed {
            return
        }
    }
    push_diagnostic(ctx, "Go map type requirements exceed the 256-pass inference limit")
}

fn validate_nominal_map_arguments(ctx: Checker, name: string, args: Vec[Type]) -> () {
    let required = Vec::new();
    if let Some(info) = find_struct_by_name(ctx, name) {
        collect_applied_map_requirements(ctx, info.generics, args, info.map_requirements, required)
    } else if let Some(info) = find_enum_by_name(ctx, name) {
        collect_applied_map_requirements(ctx, info.generics, args, info.map_requirements, required)
    }
    for key in required {
        validate_go_map_key(ctx, key)
    }
}
