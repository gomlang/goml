package checker;

use module::ast;
use module::hir;
use module::parser;
use std::testing;

#[test]
fn source_dependencies_keep_private_proofs_separate_from_method_access() -> () {
    let dependency = checked_dependency_environment(
        "package api; trait Hidden { fn secret(self: Self) -> i32; } impl Hidden for i32 { fn secret(self: i32) -> i32 { self } } pub trait Public: Hidden {} impl Public for i32 {} pub fn echo[T: Hidden](value: T) -> i32 { value.secret() }",
        "proof::api",
    );
    testing::assert_eq(dependency.proof_trait_names.len(), 1);
    for body in[
        "fn ok[T: api::Public](value: T) -> i32 { api::echo(value) }",
        "fn bad[T: api::Hidden](value: T) -> () {}",
        "fn bad[T: api::Public](value: T) -> i32 { value.secret() }",
        "fn bad[T: api::Public](value: T) -> i32 { T::secret(value) }",
        "fn bad(value: i32) -> i32 { api::Hidden::secret(value) }",
    ] {
        let result = check_for_link_with_environments(
            hir::lower_package(
                ast::lower(parser::parse("package consumer; use proof::api; " + body)),
                "consumer.goml",
                "proof::consumer",
            ),
            Vec::from_array([dependency]),
        );
        if result.diagnostics.is_empty() != body.starts_with("fn ok") {
            testing::fail(body);
        }
    }
}
