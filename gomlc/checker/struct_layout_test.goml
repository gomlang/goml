package checker;

use std::testing;

#[test]
fn finite_nested_generic_struct_layouts() -> () {
    for source in Vec::from_array(
        [
            "struct Wrap[T] { value: T } struct Holder { value: Wrap[Wrap[i32]] } fn main() -> () { let x = Holder { value: Wrap { value: Wrap { value: 42 } } }; let _: i32 = x.value.value.value; }",
            "struct Wrap[T] { value: T } struct Pair[T] { value: Wrap[T] } struct Holder { value: Wrap[Pair[i32]] } fn main() -> () {}",
            "struct Wrap[T] { value: T } struct Pair[T] { value: Wrap[(T, T)] } struct Holder { value: Wrap[Pair[i32]] } fn main() -> () {}",
            "struct Wrap[T] { value: T } struct Pair[T] { first: T, second: T } struct Holder { value: Wrap[Pair[Wrap[bool]]] } fn main() -> () {}",
            "struct Wrap[T] { value: T } struct Holder { value: Wrap[(Wrap[i32], [Wrap[bool]; 2])] } fn main() -> () {}",
        ],
    ) {
        let _ = checked_file(source);
    }
}

#[test]
fn infinite_generic_struct_layouts_remain_rejected() -> () {
    for source in Vec::from_array(
        [
            "struct Wrap[T] { value: T } struct Loop { value: Wrap[Wrap[Loop]] } fn main() -> () {}",
            "struct Loop[T] { value: Loop[Vec[T]] } fn main() -> () {}",
            "struct First[T] { value: Second[Vec[T]] } struct Second[T] { value: First[T] } fn main() -> () {}",
        ],
    ) {
        testing::assert(has_diagnostic_containing(checked_diagnostics(source), "infinite size"));
    }
}

#[test]
fn symbolic_arrays_preserve_recursive_layout_checks() -> () {
    for source in Vec::from_array(
        [
            "struct Loop[const N: usize] { value: [Loop[N]; N] } fn main() -> () {}",
            "struct Wrap[T, const N: usize] { value: [T; N] } struct Loop { value: Wrap[Loop, 2] } fn main() -> () {}",
            "struct First[const N: usize] { value: [Second[N]; N] } struct Second[const N: usize] { value: First[N] } fn main() -> () {}",
        ],
    ) {
        testing::assert(has_diagnostic_containing(checked_diagnostics(source), "infinite size"));
    }
    for source in Vec::from_array(
        [
            "struct Wrap[T, const N: usize] { value: [T; N] } struct Holder { value: Wrap[Wrap[i32, 2], 3] } fn main() -> () {}",
            "struct Node[const N: usize] { children: [Ref[Node[N]]; N] } fn main() -> () {}",
        ],
    ) {
        let _ = checked_file(source);
    }
}

#[test]
fn map_metadata_stops_expanding_recursive_generic_struct_arguments() -> () {
    for source in Vec::from_array(
        [
            "struct Weird[T] { next: Weird[(T, T)] } fn main() -> () {}",
            "struct Weird[T] { next: Weird[(T, T)] } fn consume(value: GoMap[Weird[i32], i32]) -> () {} fn main() -> () {}",
            "struct First[T] { next: Second[(T, T)] } struct Second[T] { next: First[(T, T)] } fn main() -> () {}",
        ],
    ) {
        testing::assert(has_diagnostic_containing(checked_diagnostics(source), "infinite size"));
    }
    let _ = checked_file(
        "struct Wrap[T] { value: T } fn consume(value: GoMap[Wrap[Wrap[(i32, bool)]], i32]) -> () {} fn main() -> () {}",
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "struct Wrap[T] { value: T } fn consume(value: GoMap[Wrap[Wrap[Slice[i32]]], i32]) -> () {} fn main() -> () {}",
            ),
            "Go map key is not comparable",
        ),
    );
}
