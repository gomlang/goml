package checker;

use std::testing;

fn deferred_dependency_declarations() -> string {
    "struct Box[T] { value: T } struct Maker[T] { value: T } struct Number { value: i32 } struct Text { value: string } struct First {} struct Second {} struct Wrapper { source: First } struct Flag { value: bool } trait Make[T] { fn make(self: Self) -> T; } impl[T] Make[Box[T]] for Maker[T] { fn make(self: Maker[T]) -> Box[T] { Box { value: self.value } } } impl Make[Number] for First { fn make(self: First) -> Number { Number { value: 7 } } } impl Make[Text] for Second { fn make(self: Second) -> Text { Text { value: \"hello\" } } } trait Read[T] { fn read(self: Self) -> T; } impl Read[u8] for First { fn read(self: First) -> u8 { 7 } } impl Read[string] for Second { fn read(self: Second) -> string { \"hello\" } } trait Next[T] { fn next(self: Self) -> T; } impl Next[Number] for Number { fn next(self: Number) -> Number { self } } impl Next[Text] for Text { fn next(self: Text) -> Text { self } } trait Choose[T] { fn choose(self: Self, value: T) -> i32; } impl Choose[i32] for First { fn choose(self: First, value: i32) -> i32 { 1 } } impl Choose[bool] for First { fn choose(self: First, value: bool) -> i32 { 2 } } "
}

#[test]
fn deferred_method_results_propagate_before_field_and_numeric_checks() -> () {
    let declarations = deferred_dependency_declarations();
    for source in[
        "fn f() -> i32 { let read = |source| source.make().value; read(Maker { value: 17 }) }",
        "fn f() -> i32 { let read = |source| source.make().value; read(First {}) }",
        "fn f() -> i32 { let read = |wrapper| wrapper.source.make().value; read(Wrapper { source: First {} }) }",
        "fn f() -> u8 { let read = |wrapper| wrapper.source.read(); read(Wrapper { source: First {} }) }",
        "fn f() -> i32 { let read = |source| source.make().next().value; read(First {}) }",
        "fn f() -> i32 { let choose = |source, flag| source.choose(flag.value); choose(First {}, Flag { value: true }) }",
        "fn f() -> () { let read = |source| source.read() + 1; println(read(First {})); }",
    ] {
        let diagnostics = checked_diagnostics(declarations + source);
        if !diagnostics.is_empty() {
            testing::fail(source)
        }
    }
}

#[test]
fn deferred_dependency_failures_remain_diagnostic_and_do_not_repeat() -> () {
    let declarations = deferred_dependency_declarations();
    let diagnostics = checked_diagnostics(
        declarations + "fn f() -> i32 { let read = |source| source.make().missing; read(First {}) }",
    );
    let mut missing_count = 0;
    for diagnostic in diagnostics {
        if diagnostic.message == "field not found: missing" {
            missing_count += 1;
        }
    }
    testing::assert_eq(missing_count, 1);
    let diagnostics = checked_diagnostics(
        declarations
            + "fn f() -> i32 { let read = |source| source.make::[i32]().value; read(First {}) }",
    );
    let mut generic_count = 0;
    for diagnostic in diagnostics {
        if diagnostic.message.contains("expects 0 method type arguments") {
            generic_count += 1;
        }
    }
    testing::assert_eq(generic_count, 1);
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                declarations
                    + "fn f() -> () { let read = |source| source.read() + 256; println(read(First {})); }",
            ),
            "u8",
        ),
    );
    testing::assert(
        !checked_diagnostics(
            declarations + "fn f() -> () { let read = |source| source.make().value; }",
        ).is_empty(),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                declarations
                    + "impl Make[Text] for First { fn make(self: First) -> Text { Text { value: \"other\" } } } fn f() -> i32 { let read = |source| source.make().value; read(First {}) }",
            ),
            "ambiguous method",
        ),
    );
}
