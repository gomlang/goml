package checker;

use std::testing;

#[test]
fn opaque_methods_normalize_chained_associated_supertrait_arguments() -> () {
    let prefix = "trait Nested { type Output; } impl Nested for bool { type Output = i32; } trait Source { type Item: Nested; } trait Parent[T] { fn take(self, value: T) -> i32; } trait Child: Source + Parent[Self::Item::Output] {} impl Source for i32 { type Item = bool; } impl Parent[i32] for i32 { fn take(self, value: i32) -> i32 { value } } impl Child for i32 {} ";
    for bounds in[
        "Child[Item = bool]",
        "Child + Source[Item = bool]",
        "Source[Item = bool] + Child",
    ] {
        opaque_return_accepts(
            prefix + "fn make() -> impl " + bounds
                + " { let value: i32 = 1; value } fn call() -> i32 { make().take(7) }",
        );
    }
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                prefix
                    + "fn make() -> impl Child[Item = bool] { let value: i32 = 1; value } fn call() -> i32 { make().take(true) }",
            ),
            "Type mismatch",
        ),
    );
}

#[test]
fn opaque_method_shadowing_compares_normalized_supertraits() -> () {
    opaque_return_accepts(
        "trait Nested { type Output; } impl Nested for bool { type Output = i32; } trait Source { type Item: Nested; } trait Parent[T] { fn take(self, value: T) -> i32; } trait Child: Source + Parent[Self::Item::Output] { fn take(self, value: bool) -> bool; } impl Source for i32 { type Item = bool; } impl Parent[i32] for i32 { fn take(self, value: i32) -> i32 { value } } impl Child for i32 { fn take(self, value: bool) -> bool { value } } fn make() -> impl Child[Item = bool] { let value: i32 = 1; value } fn call() -> bool { make().take(true) }",
    );
}
