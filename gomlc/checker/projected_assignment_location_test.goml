package checker;

use std::testing;

#[test]
fn projected_assignments_require_a_writable_root() -> () {
    for source in[
        "struct Point { x: i32 } fn make() -> Point { Point { x: 1 } } fn f() -> () { make().x = 2; }",
        "struct Point { x: i32 } fn f() -> () { Point { x: 1 }.x += 2; }",
        "fn make() -> (i32, i32) { (1, 2) } fn f() -> () { make().0 = 3; }",
        "fn f() -> () { (1, 2).0 += 3; }",
        "fn f() -> () { let pair = (1, 2); ({ pair }).0 = 3; }",
        "struct Point { x: i32 } fn f() -> () { let write = |make| { make().x = 2; }; write(|| Point { x: 1 }); }",
        "fn f() -> () { let write = |make| { make().0 += 3; }; write(|| (1, 2)); }",
    ] {
        if !has_diagnostic_containing(checked_diagnostics(source), "assignable location required") {
            testing::fail(source)
        }
    }
}

#[test]
fn projected_array_assignments_preserve_root_mutability() -> () {
    for source in[
        "struct Point { x: i32 } fn f() -> () { let values = [Point { x: 1 }]; values[0].x = 2; }",
        "fn f() -> () { let values = [(1, 2)]; values[0].0 += 3; }",
        "struct Point { x: i32 } fn f() -> () { let write = |values| { values[0].x = 2; }; write([Point { x: 1 }]); }",
        "fn f() -> () { let write = |values| { values[0].0 += 3; }; write([(1, 2)]); }",
        "struct Point { x: i32 } fn f() -> () { let values = [[Point { x: 1 }]]; values[0][0].x = 2; }",
    ] {
        if !has_diagnostic_containing(checked_diagnostics(source), "immutable binding") {
            testing::fail(source)
        }
    }
}

#[test]
fn projected_assignments_keep_interior_mutable_boundaries() -> () {
    for source in[
        "struct Point { x: i32 } fn f() -> () { let point = Point { x: 1 }; point.x = 2; let pair = (1, 2); pair.0 += 3; }",
        "struct Point { x: i32 } fn f() -> () { let mut values = [Point { x: 1 }]; values[0].x = 2; }",
        "struct Point { x: i32 } fn f() -> () { let value = Ref::new([Point { x: 1 }]); value.get()[0].x = 2; }",
        "struct Point { x: i32 } fn make() -> Vec[Point] { Vec::from_array([Point { x: 1 }]) } fn f() -> () { make()[0].x = 2; }",
        "struct Point { x: i32 } fn f() -> () { let values = Vec::from_array([Point { x: 1 }]); values.as_mut_slice()[0].x = 2; }",
        "struct Point { x: i32 } fn f() -> () { let write = |values| { values[0].x = 2; }; write(Vec::from_array([Point { x: 1 }])); }",
        "fn f() -> () { let write = |values| { values[0].0 += 3; }; write(Vec::from_array([(1, 2)]).as_mut_slice()); }",
        "struct Point { x: i32 } fn f() -> () { let values = Vec::from_array([Ref::new(Point { x: 1 })]); values.as_slice()[0].get().x = 2; }",
        "fn f() -> () { let values: HashMap[string, Vec[(i32, i32)]] = HashMap::new(); values[\"a\"] = Vec::from_array([(1, 2)]); values[\"a\"].unwrap_or(Vec::new())[0].0 = 3; }",
    ] {
        if !checked_diagnostics(source).is_empty() {
            testing::fail(source)
        }
    }
}

#[test]
fn projected_assignments_preserve_readonly_container_boundaries() -> () {
    for source in[
        "struct Point { x: i32 } fn f() -> () { let view = Vec::from_array([Point { x: 1 }]).as_slice(); view[0].x = 2; }",
        "struct Point { x: i32 } fn f() -> () { let write = |view| { view[0].x = 2; }; write(Vec::from_array([Point { x: 1 }]).as_slice()); }",
        "fn f() -> () { let write = |view| { view[0].0 = 2; }; write(Vec::from_array([(1, 2)]).as_slice()); }",
    ] {
        if !has_diagnostic_containing(checked_diagnostics(source), "Slice is read-only") {
            testing::fail(source)
        }
    }
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "struct Point { x: i32 } fn f() -> () { let view = Vec::from_array([Point { x: 1 }]).freeze(); view.get(0).x = 2; }",
            ),
            "assignable location required",
        ),
    );
    for source in[
        "struct Point { x: i32 } fn f() -> () { let view = Vec::from_array([Ref::new(Point { x: 1 })]).freeze(); view.get(0).get().x = 2; }",
        "fn f() -> () { let view = Vec::from_array([Vec::from_array([(1, 2)])]).freeze(); view.get(0)[0].0 = 3; }",
    ] {
        if !checked_diagnostics(source).is_empty() {
            testing::fail(source)
        }
    }
}
