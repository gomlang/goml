package checker;

use std::testing;

#[test]
fn generic_body_constant_requirements_reach_calls_and_function_values() -> () {
    let declarations = "struct Bad[const N: usize] { items: [i32; N - 1] } fn create[const N: usize]() -> () { let unused: Option[Bad[N]] = None; } fn forward[const N: usize]() -> () { create::[N](); } ";
    for invocation in[
        "create::[0]();",
        "forward::[0]();",
        "let call = create::[0]; call();",
        "let call = forward::[0];",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(declarations + "fn main() -> () { " + invocation + " }"),
                "const usize argument must be nonnegative",
            ),
        );
    }
    let _ = checked_file(
        declarations + "fn main() -> () { create::[1](); let call = forward::[2]; call(); }",
    );
}

#[test]
fn forwarded_constant_arguments_keep_arithmetic_obligations() -> () {
    for item in[
        ("N - 1", "0", "nonnegative"),
        ("N / 0", "1", "division by zero"),
        ("N + 1", "9223372036854775807", "integer overflow"),
        ("N << 64", "1", "invalid shift"),
    ] {
        let declarations = "fn inner[const M: usize]() -> () {} fn outer[const N: usize]() -> () { let unused = inner::[{"
            + item.0
            + "}]; } ";
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(declarations + "fn main() -> () { outer::[" + item.1 + "](); }"),
                item.2,
            ),
        );
    }
    let _ = checked_file(
        "fn inner[const M: usize]() -> () {} fn outer[const N: usize]() -> () { let unused = inner::[{N - 1}]; } fn main() -> () { outer::[1](); }",
    );
}

#[test]
fn unused_generic_callable_signatures_keep_constant_requirements() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "fn inner[const N: usize]() -> [i32; N - 1] { [1; N - 1] } fn outer[const N: usize]() -> () { let unused = inner::[N]; } fn main() -> () { outer::[0](); }",
            ),
            "nonnegative",
        ),
    );
}

#[test]
fn method_bodies_preserve_constant_requirements() -> () {
    let declarations = "struct Holder {} impl Holder { fn create[const N: usize](self: Self) -> () { let unused: Option[[i32; N - 1]] = None; } } ";
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(declarations + "fn main() -> () { Holder {}.create::[0](); }"),
            "nonnegative",
        ),
    );
    let _ = checked_file(declarations + "fn main() -> () { Holder {}.create::[1](); }");
}

#[test]
fn default_bodies_preserve_constant_requirements_without_affecting_overrides() -> () {
    let declarations = "trait Make[const N: usize] { fn create(self: Self) -> () { let unused: Option[[i32; N - 1]] = None; } } ";
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(declarations + "impl Make[0] for i32 {}"),
            "nonnegative",
        ),
    );
    let _ = checked_file(declarations + "impl Make[1] for i32 {}");
    let _ = checked_file(declarations + "impl Make[0] for i32 { fn create(self: i32) -> () {} }");
}

#[test]
fn recursive_constant_requirements_stop_at_cycle_boundaries() -> () {
    for source in[
        "fn cycle[const N: usize]() -> () { cycle::[{(N + 1) % 3}](); } fn main() -> () { cycle::[0](); }",
        "fn unused[const N: usize]() -> () { unused::[{N + 1}](); } fn main() -> () {}",
    ] {
        let _ = checked_file(source);
    }
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "struct Bad[const N: usize] { data: [i32; N - 1] } fn recur[const N: usize]() -> () { let unused: Option[Bad[N]] = None; let callback = recur::[{N - 1}]; } fn main() -> () { recur::[1](); }",
            ),
            "nonnegative",
        ),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "struct Bad[const N: usize] { data: [i32; N - 1] } fn first[const N: usize]() -> () { let callback = second::[N]; } fn second[const N: usize]() -> () { let unused: Option[Bad[N]] = None; let callback = first::[{N - 1}]; } fn main() -> () { first::[1](); }",
            ),
            "nonnegative",
        ),
    );
}
