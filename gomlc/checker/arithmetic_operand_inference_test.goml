package checker;

use std::testing;

#[test]
fn arithmetic_operands_wait_for_later_type_constraints() -> () {
    for source in[
        "fn f() -> i32 { let read = |xs| { let [x, y] = xs; x + y }; read([1, 2]) }",
        "fn f() -> i32 { let read = |xs| xs.0 + xs.1; read((1, 2)) }",
        "fn f() -> string { let add = |x, y| x + y; add(\"a\", \"b\") }",
        "fn f() -> f64 { let mul = |x, y| x * y; mul(1.5, 2.0) }",
        "fn f() -> u8 { let sub = |x, y| x - y; sub(7, 2) }",
        "fn f() -> f64 { let div = |x, y| x / y; div(3.0, 2.0) }",
        "struct Item { value: u8 } fn f() -> u8 { let sub = |x| { x.value -= 2; x.value }; sub(Item { value: 7 }) }",
        "struct Item { value: string } fn f() -> string { let add = |x, y| { x.value += y; x.value }; add(Item { value: \"a\" }, \"b\") }",
    ] {
        if !checked_diagnostics(source).is_empty() {
            testing::fail(source)
        }
    }
}

#[test]
fn inferred_arithmetic_preserves_operator_restrictions() -> () {
    for source in[
        "fn f() -> () { let add = |x, y| x + y; let _ = add(true, false); }",
        "fn f() -> () { let sub = |x, y| x - y; let _ = sub(\"a\", \"b\"); }",
        "fn f() -> () { let mul = |x, y| x * y; let _ = mul(\"a\", \"b\"); }",
        "fn f() -> () { let div = |x, y| x / y; let _ = div(true, false); }",
        "fn f() -> () { let add = |x, y| x + y; let _ = add(1, true); }",
        "fn f() -> () { let add = |x, y| x + y; }",
        "struct Item { value: bool } fn f() -> () { let add = |x, y| { x.value += y; }; add(Item { value: true }, false); }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}
