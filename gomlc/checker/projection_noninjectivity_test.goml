package checker;

use std::testing;

#[test]
fn associated_type_equalities_do_not_imply_equal_implementors() -> () {
    for equality in[
        "A::Item = B::Item",
        "Vec[A::Item] = Vec[B::Item]",
        "(A::Item, bool) = (B::Item, bool)",
        "Option[A::Item] = Option[B::Item]",
        "(A::Item) -> bool = (B::Item) -> bool",
        "(bool) -> A::Item = (bool) -> B::Item",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(
                    "trait Source { type Item; } fn convert[A: Source, B: Source](value: A) -> B where "
                        + equality
                        + " { value }",
                ),
                "Type mismatch",
            ),
        );
    }
}

#[test]
fn equal_associated_types_can_have_distinct_implementors() -> () {
    let _ = checked_file(
        "trait Source { type Item; } impl Source for i32 { type Item = bool; } impl Source for string { type Item = bool; } fn keep[A: Source, B: Source](left: A, right: B) -> (A, B) where Vec[A::Item] = Vec[B::Item] { (left, right) } fn main() -> () { let pair: (i32, string) = keep(7, \"value\"); }",
    );
}
