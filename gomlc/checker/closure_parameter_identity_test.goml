package checker;

use std::testing;

#[test]
fn duplicate_closure_parameters_are_diagnosed_at_the_parameter() -> () {
    for source in[
        "fn f() -> () { let pick = |value: i32, value: bool| value; let _ = pick(1, true); }",
        "fn f() -> () { let pick = |value, value| value; let _ = pick(1, true); }",
    ] {
        let diagnostics = checked_diagnostics(source);
        testing::assert(
            has_diagnostic_containing(diagnostics, "parameter value is defined multiple times"),
        );
    }
    let _ = checked_file(
        "fn f() -> () { let value = 1; let pick = |value: bool| value; let _ = pick(true); let ignore = |_: i32, _: bool| (); ignore(value, true); }",
    );
}
