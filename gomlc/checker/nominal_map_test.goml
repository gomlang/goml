package checker;

use std::testing;
use module::tast::{DynTraitBound, TraitRef, Type, builtin_contract, types_equal};

#[test]
fn map_requirements_visit_dynamic_bindings_and_qualified_projections() -> () {
    let Ok(builtin) = builtin_contract() else {
        testing::fail("missing builtin contract");
        return
    };
    let ctx = collect_environment(
        dependency_hir(
            "package api; pub trait WithItem { type Item; } pub trait Marker {} pub trait Other { type Item; } pub trait Qualified[T] { type Item; }",
            "audit::api",
        ),
        false,
        builtin,
    );
    let key = Type::Param { name: "T" };
    let map = Type::GoMap { key, value: Type::Int };
    for value in Vec::from_array(
        [
            Type::Dyn {
                trait_name: "audit::api::WithItem",
                args: Vec::new(),
                associated_types: Vec::from_array([("Item", map)]),
                additional_bounds: Vec::new(),
            },
            Type::Dyn {
                trait_name: "audit::api::Marker",
                args: Vec::new(),
                associated_types: Vec::new(),
                additional_bounds: Vec::from_array(
                    [
                        DynTraitBound {
                            trait_name: "audit::api::Other",
                            args: Vec::new(),
                            associated_types: Vec::from_array([("Item", map)]),
                        },
                    ],
                ),
            },
            Type::Projection {
                for_ty: key,
                name: "Item",
                trait_ref: Option::Some(
                    TraitRef { name: "audit::api::Qualified", args: Vec::from_array([map]) },
                ),
            },
        ],
    ) {
        let required = Vec::new();
        collect_type_map_requirements(ctx, value, required);
        testing::assert_eq(required.len(), 1);
        testing::assert(types_equal(required[0], key));
    }
}

#[test]
fn map_requirements_do_not_revisit_unapplied_nominal_bases() -> () {
    let Ok(builtin) = builtin_contract() else {
        testing::fail("missing builtin contract");
        return
    };
    let ctx = collect_environment(
        dependency_hir("package api; pub struct Store[T] { value: T }", "audit::api"),
        false,
        builtin,
    );
    let info = ctx.structs[0];
    info.map_requirements.push(Type::Param { name: "T" });
    let required = Vec::new();
    collect_type_map_requirements(
        ctx,
        App { ty: Type::Con { name: info.name }, args: Vec::from_array([Type::Int]) },
        required,
    );
    testing::assert(required.is_empty());
}

#[test]
fn map_requirements_preserve_nested_argument_order_and_deduplicate_keys() -> () {
    let builtin = testing::expect_ok(builtin_contract(), "builtin contract");
    let ctx = collect_environment(dependency_hir("package api;", "audit::api"), false, builtin);
    let first = Type::Param { name: "T" };
    let second = Type::Param { name: "U" };
    let first_map = Type::GoMap { key: first, value: Type::Int };
    let second_map = Type::GoMap { key: second, value: Type::Int };
    let value = Type::Func {
        params: Vec::from_array(
            [
                Type::Tuple {
                    items: Vec::from_array([first_map, Type::VecType { elem: second_map }]),
                },
            ],
        ),
        ret_ty: first_map,
    };
    let required = Vec::new();
    collect_type_map_requirements(ctx, value, required);
    testing::assert_eq(required.len(), 2);
    testing::assert(types_equal(required[0], first));
    testing::assert(types_equal(required[1], second));
}
