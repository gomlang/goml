package checker;

use module::ast;
use module::tast::{BinaryResolution, TraitRef, Type, TypePredicate, binary_symbol};

fn validate_comparison_operand(ctx: Checker, ty: Type, op: ast::BinaryOp, span: ast::Span) -> () {
    if contains_unbound_any_variable(ty) {
        push_diagnostic_at(
            ctx,
            "Could not infer the operand type for operator " + binary_symbol(op),
            Some(span),
        )
    } else if is_equality_op(op)
        && !trait_bound_satisfied_at(
            ctx,
            ty,
            TraitRef { name: ctx.builtin.partial_eq.name, args: Vec::new() },
            Vec::new(),
        ) {
        push_diagnostic_at(
            ctx,
            predicate_requirement_message(
                ctx,
                TypePredicate::Trait {
                    for_ty: ty,
                    trait_ref: TraitRef { name: ctx.builtin.partial_eq.name, args: Vec::new() },
                },
                "type predicate not satisfied",
            ),
            Some(span),
        )
    } else if is_order_op(op) && !order_comparable_type(ctx, ty) {
        if let None = partial_order_trait(ctx, ty) {
            push_operator_not_defined(ctx, op, ty, span)
        }
    }
}

fn require_comparison_operand(ctx: Checker, ty: Type, op: ast::BinaryOp, span: ast::Span) -> () {
    let ty = normalize_type(ctx, ty);
    if contains_unbound_any_variable(ty) {
        ctx.inference.comparison_operand_constraints.push(
            ComparisonOperandConstraint { ty, op, span },
        )
    } else {
        validate_comparison_operand(ctx, ty, op, span)
    }
}

fn resolve_comparison_operand_constraints(ctx: Checker) -> () {
    for constraint in ctx.inference.comparison_operand_constraints {
        let ty = normalize_type(ctx, constraint.ty);
        validate_comparison_operand(ctx, ty, constraint.op, constraint.span)
    }
}

fn comparison_operand_resolution(ctx: Checker, ty: Type, op: ast::BinaryOp) -> BinaryResolution {
    let ty = normalize_type(ctx, ty);
    if contains_unbound_any_variable(ty) {
        return Builtin
    }
    if is_equality_op(op) {
        if builtin_equality_type(ty) {
            Builtin
        } else {
            Overloaded { trait_name: ctx.builtin.partial_eq.name }
        }
    } else if is_order_op(op) && !order_comparable_type(ctx, ty) {
        match partial_order_trait(ctx, ty) {
            Some(trait_name) => Overloaded { trait_name },
            None => Builtin,
        }
    } else {
        Builtin
    }
}
