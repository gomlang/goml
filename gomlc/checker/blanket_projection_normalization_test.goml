package checker;

use std::testing;

#[test]
fn blanket_associated_types_normalize_rigid_generic_receivers() -> () {
    for source in[
        "trait Source { type Item; } impl[T] Source for T { type Item = i32; } fn convert[T: Source](value: T::Item) -> i32 { value }",
        "trait Marker {} trait Source { type Item; } impl[T: Marker] Source for T { type Item = i32; } fn convert[T: Source + Marker](value: T::Item) -> i32 { value }",
        "trait Source[A] { type Item; } impl[T, A] Source[A] for T { type Item = A; } fn convert[T: Source[A], A](value: T::Item) -> A { value }",
        "trait Source { type Item; } impl[T] Source for T { type Item = i32; } fn convert[T: Source](value: T::Item) -> T::Item { let value: i32 = value; value }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn blanket_projection_normalization_requires_all_impl_constraints() -> () {
    for source in[
        "trait Marker {} trait Source { type Item; } impl[T: Marker] Source for T { type Item = i32; } fn convert[T: Source](value: T::Item) -> i32 { value }",
        "trait Source { type Item; } impl Source for bool { type Item = i32; } fn convert[T: Source](value: T::Item) -> i32 { value }",
        "trait Source { type Item; } impl[T] Source for Vec[T] { type Item = i32; } fn convert[T: Source](value: T::Item) -> i32 { value }",
        "trait Source { type Item; } impl[T] Source for T { type Item = i32; } fn convert[T: Source](value: T::Item) -> bool { value }",
    ] {
        testing::assert(has_diagnostic_containing(checked_diagnostics(source), "Type mismatch"));
    }
}
