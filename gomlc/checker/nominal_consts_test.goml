package checker;

use std::testing;
use module::tast::{StructInfo, builtin_contract, const_type};

#[test]
fn rejects_invalid_lengths_in_concrete_nominal_signatures() -> () {
    for source in[
        "struct Inner[const N: usize] { values: [i32; N - 1] } struct Outer { inner: Inner[0] }",
        "struct Wrap[const N: usize] { values: [i32; N - 1] } fn unused(value: Wrap[0]) -> () {}",
        "struct Inner[const N: usize] { values: [i32; N - 1] } struct Outer[const N: usize] { inner: Inner[N] } fn unused(value: Outer[0]) -> () {}",
        "enum Inner[const N: usize] { Empty, Data([i32; N - 1]) } struct Outer[const N: usize] { inner: Inner[N] } fn unused(value: Outer[0]) -> () {}",
        "struct Inner[const N: usize] { values: [i32; N - 1] } enum Outer[const N: usize] { Empty, Data(Inner[N]) } fn unused(value: Outer[0]) -> () {}",
        "struct Inner[const N: usize] { values: [i32; N - 1] } struct Outer { inner: Inner[0] } fn unused(value: Outer) -> () {}",
        "enum Sized[const N: usize] { Empty, Data([i32; N - 1]) } fn main() -> () { let _ = Sized::[0]::Empty; }",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "const usize argument must be nonnegative",
            ),
        );
    }
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "struct Wrap[const N: usize] { values: [i32; (N / 0) + 1] } fn unused(value: Wrap[1]) -> () {}",
            ),
            "division by zero in constant expression",
        ),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "enum Wrap[const N: usize] { Empty, Data([i32; N + 1]) } fn unused(value: Wrap[9223372036854775807]) -> () {}",
            ),
            "integer overflow in constant expression",
        ),
    );
}

#[test]
fn nominal_const_requirements_accept_symbolic_and_recursive_declarations() -> () {
    for source in[
        "struct Wrap[const N: usize] { values: [i32; N - 1] } fn symbolic[const N: usize](value: Wrap[N]) -> () {} fn valid(value: Wrap[1]) -> () {}",
        "struct Inner[const N: usize] { values: [i32; (N - 3) + 4] } struct Outer[const N: usize] { inner: Inner[N] } fn valid(value: Outer[1]) -> () {}",
        "struct Node[const N: usize] { next: Ref[Node[N]], values: [i32; N] } fn valid(value: Node[0]) -> () {}",
        "enum Chain[const N: usize] { End, Next(Chain[N]), Values([i32; N]) } fn valid(value: Chain[0]) -> () {}",
        "enum Left[const N: usize] { End, Next(Right[N]) } enum Right[const N: usize] { End, Next(Left[N]), Values([i32; N]) } fn valid(value: Left[0]) -> () {}",
    ] {
        let _ = checked_file(source);
    }
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "struct Recursive[const N: usize] { next: Recursive[N], values: [i32; N] }",
            ),
            "recursive",
        ),
    );
}

#[test]
fn nominal_const_requirements_survive_hidden_field_removal() -> () {
    let builtin = testing::expect_ok(builtin_contract(), "builtin contract");
    let ctx = collect_environment(
        dependency_hir(
            "package api; pub struct Store[const N: usize] { values: [i32; N - 1] }",
            "audit::api",
        ),
        false,
        builtin,
    );
    infer_nominal_const_requirements(ctx);
    let info = ctx.structs[0];
    testing::assert(!info.const_requirements.is_empty());
    ctx.structs.set(0, StructInfo { fields: Vec::new(), has_hidden_fields: true, ..info });
    testing::assert(
        nominal_const_argument_error(ctx, info.name, Vec::from_array([const_type(0)])).is_some(),
    );
    testing::assert(
        nominal_const_argument_error(ctx, info.name, Vec::from_array([const_type(1)])).is_none(),
    );
}
