package checker;

use std::testing;

#[test]
fn integer_float_patterns_use_the_inferred_numeric_representation() -> () {
    for ty in["f32", "f64"] {
        for patterns in[
            "1 => true, 1.0 => false",
            "1.0 => true, 1 => false",
            "0 => true, -0.0 => false",
        ] {
            testing::assert(
                has_diagnostic_containing(
                    checked_diagnostics(
                        "fn f(value: " + ty + ") -> bool { match value { " + patterns
                            + ", _ => true } }",
                    ),
                    "Unreachable match arm",
                ),
            );
        }
    }
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "fn f(value: f32) -> bool { match value { 16777217 => true, 16777216.0 => false, _ => true } }",
            ),
            "Unreachable match arm",
        ),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "fn main() -> () { let f = |value| match value { 1 => true, 1.0 => false, _ => true }; let value: f32 = 1.0; let _ = f(value); }",
            ),
            "Unreachable match arm",
        ),
    );
}

#[test]
fn integer_float_patterns_preserve_distinct_values_and_guards() -> () {
    for source in[
        "fn f(value: f64) -> bool { match value { 16777217 => true, 16777216.0 => false, _ => true } }",
        "fn f(value: f32, flag: bool) -> bool { match value { 1 if flag => true, 1.0 => false, _ => true } }",
        "fn f(value: i32) -> bool { match value { 1 => true, 2 => false, _ => true } }",
    ] {
        testing::assert(
            !has_diagnostic_containing(checked_diagnostics(source), "Unreachable match arm"),
        );
        let _ = checked_file(source);
    }
}
