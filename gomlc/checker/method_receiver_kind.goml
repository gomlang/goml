package checker;

use module::tast::{MethodInfo, TraitRef};

fn trait_method_has_receiver(ctx: Checker, reference: TraitRef, name: string) -> bool {
    match find_trait(ctx, reference.name) {
        Some(info) => match find_trait_method(info, name) {
            Some(method) => method.has_receiver,
            None => false,
        },
        None => false,
    }
}

fn method_has_dot_receiver(ctx: Checker, value: MethodInfo) -> bool {
    match value.trait_ref {
        Some(reference) => trait_method_has_receiver(ctx, reference, value.function.name),
        None => value.has_receiver,
    }
}
