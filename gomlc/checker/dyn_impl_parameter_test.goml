package checker;

use std::testing;

#[test]
fn dyn_impl_targets_constrain_parameters_in_all_bounds() -> () {
    for target in[
        "dyn Read[T]",
        "dyn Source[Item = T]",
        "dyn Marker + Read[T]",
        "dyn Marker + Source[Item = T]",
        "Vec[dyn Read[T]]",
        "(dyn Source[Item = T], bool)",
    ] {
        let _ = checked_file(
            "trait Tag {} trait Read[T] {} trait Source { type Item; } trait Marker {} impl[T] Tag for "
                + target
                + " {}",
        );
    }
    let _ = checked_file("trait Tag[T] {} trait Read[T] {} impl[T] Tag[dyn Read[T]] for bool {}");
    let _ = checked_file(
        "trait Tag {} trait Read[T] {} impl[T] Tag for dyn Read[T] {} fn accept[T: Tag](value: T) -> () {} fn use_value(value: dyn Read[i32]) -> () { accept(value); }",
    );
}

#[test]
fn dyn_impl_targets_do_not_infer_projection_implementors() -> () {
    for target in[
        "dyn Read[T::Item]",
        "dyn Source[Item = T::Item]",
        "dyn Marker + Read[T::Item]",
        "dyn Marker + Source[Item = T::Item]",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(
                    "trait Tag {} trait Read[T] {} trait Source { type Item; } trait Marker {} impl[T: Source] Tag for "
                        + target
                        + " {}",
                ),
                "Implementation type parameter T is not constrained",
            ),
        );
    }
}
