package checker;

use std::testing;

#[test]
fn diverging_for_iterators_do_not_require_iteration_protocols() -> () {
    for source in[
        "fn f() -> i32 { for _ in return 7 {} }",
        "fn stop() -> never { loop {} } fn f() -> never { for _ in stop() {} }",
        "fn stop() -> never { loop {} } fn f() -> never { for value in stop() { match value {} } }",
        "fn f[T](value: T) -> never where T = never { for _ in value {} }",
        "fn f() -> i32 { 'outer: loop { for _ in break 'outer 8 {} } }",
        "fn f() -> never { loop { for _ in continue {} } }",
        "fn f() -> () { for value in [1, 2] { let _: i32 = value; } }",
    ] {
        if !checked_diagnostics(source).is_empty() {
            testing::fail(source)
        }
    }
}

#[test]
fn diverging_for_iterators_preserve_body_and_reachable_iterator_checks() -> () {
    for case in[
        ("fn f() -> () { for _ in true {} }", "for loop expects a type implementing IntoIterator"),
        ("fn f() -> never { for _ in [1, 2] {} }", "Type mismatch"),
        (
            "fn stop() -> never { loop {} } fn f() -> never { for _ in stop() { let value: i32 = true; } }",
            "Type mismatch",
        ),
        (
            "fn f() -> i32 { for _ in return 7 { break 3; } }",
            "`break` with a value is only allowed in `loop`",
        ),
    ] {
        if !has_diagnostic_containing(checked_diagnostics(case.0), case.1) {
            testing::fail(case.0 + " expected diagnostic: " + case.1)
        }
    }
}
