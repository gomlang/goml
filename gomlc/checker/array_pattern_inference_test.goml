package checker;

use std::testing;

#[test]
fn array_patterns_infer_sequence_types_from_later_calls() -> () {
    for source in[
        "fn f() -> i32 { let read = |xs| match xs { [x, ..] => x }; read([1, 2]) }",
        "fn f() -> i32 { let read = |xs| match xs { [x, ..] => x, _ => 0 }; read(Vec::from_array([1, 2])) }",
        "fn f(xs: Slice[i32]) -> i32 { let read = |xs| match xs { [x, ..] => x, _ => 0 }; read(xs) }",
        "fn f(xs: MutSlice[i32]) -> i32 { let read = |xs| match xs { [x, ..] => x, _ => 0 }; read(xs) }",
        "fn f() -> [i32; 2] { let rest = |xs| { let [_, tail @ ..] = xs; tail }; rest([1, 2, 3]) }",
        "fn f(xs: Vec[i32]) -> Slice[i32] { let rest = |xs| match xs { [_, tail @ ..] => tail, [tail @ ..] => tail }; rest(xs) }",
        "fn f() -> i32 { let read = |xs| { let [x, _] = xs; x }; read([1, 2]) }",
        "fn f(xs: Vec[i32]) -> i32 { let read = |xs| match xs { [x] => x, _ => 0 }; read(xs) }",
        "fn f() -> bool { let empty = |xs| match xs { [] => true, [_, ..] => false }; empty(Vec::from_array([1, 2])) }",
    ] {
        if !checked_diagnostics(source).is_empty() {
            testing::fail(source)
        }
    }
}

#[test]
fn inferred_array_patterns_validate_shapes_and_coverage() -> () {
    for case in[
        (
            "fn f() -> i32 { let read = |xs| match xs { [x, _] => x }; read([1]) }",
            "Array length mismatch",
        ),
        (
            "fn f() -> i32 { let read = |xs| match xs { [x, ..] => x }; read([]) }",
            "Array length mismatch",
        ),
        ("fn f() -> i32 { let read = |xs| match xs { [x, ..] => x }; read(true) }", "Type mismatch"),
        (
            "fn f(xs: Vec[i32]) -> i32 { let read = |xs| match xs { [x, ..] => x }; read(xs) }",
            "non-exhaustive",
        ),
        (
            "fn f(xs: Vec[i32]) -> i32 { let read = |xs| { let [x] = xs; x }; read(xs) }",
            "Refutable pattern",
        ),
    ] {
        if !has_diagnostic_containing(checked_diagnostics(case.0), case.1) {
            testing::fail(case.0 + " expected diagnostic: " + case.1)
        }
    }
}
