package checker;

use module::ast;
use module::tast::{Block, Callable, Expr, Type, expr_type, map_block_exprs, map_child_exprs, prune, type_is_concrete, types_equal};

struct DeferredMethod {
    id: isize,
    name: string,
    explicit: Vec[Type],
    span: Option[ast::Span],
    ty: Type,
    resolved: Ref[Option[ResolvedCallable]],
}

fn common_deferred_method_type(candidates: Vec[Type], parameter: Option[isize]) -> Option[Type] {
    let mut common: Option[Type] = None;
    for candidate in candidates {
        let Func { params, ret_ty } = candidate else {
            return None
        };
        let ty = match parameter {
            Some(index) => params[index],
            None => ret_ty,
        };
        if !type_is_concrete(ty) {
            return None
        }
        if let Some(previous) = common {
            if !types_equal(previous, ty) {
                return None
            }
        }
        common = Some(ty);
    }
    common
}

fn deferred_error() -> ResolvedCallable {
    ResolvedCallable {
        callable: Callable::Function("<error>"),
        ty: Type::Error,
        predicates: Vec::new(),
    }
}

fn resolve_deferred_signature(ctx: Checker, pending: DeferredMethod) -> Option[ResolvedCallable] {
    let Func { params, ret_ty } = prune(pending.ty) else {
        return None
    };
    if params.is_empty() {
        return None
    }
    let args = Vec::new();
    for index in 1..params.len() {
        args.push(params[index])
    }
    let resolved = resolve_method(
        ctx,
        params[0],
        pending.name,
        args,
        Some(ret_ty),
        pending.explicit,
    )?;
    match prune(resolved.ty) {
        Func { params: actual_params, ret_ty: actual_ret } if actual_params.len() == params.len() => {
            for index in 0..params.len() {
                expect_type(ctx, params[index], actual_params[index])
            }
            if is_unbound_any_type(ret_ty) {
                expect_type(ctx, ret_ty, actual_ret)
            } else {
                expect_type(ctx, actual_ret, ret_ty)
            }
        },
        _ => expect_type(ctx, resolved.ty, pending.ty),
    }
    require_predicates(ctx, resolved.predicates);
    Some(resolved)
}

fn resolve_deferred_method(ctx: Checker, id: isize) -> ResolvedCallable {
    for pending in ctx.inference.deferred_methods {
        if pending.id != id {
            continue
        }
        if let Some(result) = pending.resolved.get() {
            return result
        }
        let previous = ctx.current_span.get();
        ctx.current_span.set(pending.span);
        let diagnostic_start = ctx.diagnostics.len();
        let result = resolve_deferred_signature(ctx, pending).unwrap_or_else(|| deferred_error());
        if types_equal(result.ty, Type::Error) && ctx.diagnostics.len() == diagnostic_start {
            push_diagnostic(ctx, "Could not resolve deferred method " + pending.name)
        }
        pending.resolved.set(Some(result));
        ctx.current_span.set(previous);
        update_deferred_facts(ctx.typeck_results, id, result);
        return result
    }
    push_diagnostic(ctx, "invalid deferred method reference");
    deferred_error()
}

fn is_deferred_target(value: ReferenceTarget, id: isize) -> bool {
    match value {
        Callable(DeferredMethod(actual)) => actual == id,
        _ => false,
    }
}

fn update_deferred_facts(results: TypeckResults, id: isize, value: ResolvedCallable) -> () {
    for index in 0..results.references.len() {
        let fact = results.references[index];
        if is_deferred_target(fact.target, id) {
            results.references[index] = ReferenceFact {
                target: ReferenceTarget::Callable(value.callable),
                ty: value.ty,
                ..fact,
            };
        }
    }
    for index in 0..results.calls.len() {
        let fact = results.calls[index];
        if is_deferred_target(fact.target, id) {
            let result_ty = match prune(value.ty) {
                Func { ret_ty, .. } if types_equal(prune(ret_ty), Type::Never) => Type::Never,
                _ => fact.result_ty,
            };
            results.calls[index] = CallFact {
                target: ReferenceTarget::Callable(value.callable),
                callee_ty: value.ty,
                result_ty,
                ..fact,
            };
            if types_equal(result_ty, Type::Never) {
                for expr_index in 0..results.exprs.len() {
                    let expr = results.exprs[expr_index];
                    if expr.source_path == fact.source_path && expr.span.start == fact.span.start
                        && expr.span.end == fact.span.end {
                        results.exprs[expr_index] = ExprFact { ty: Type::Never, ..expr };
                    }
                }
            }
        }
    }
}

fn resolve_deferred_expr(ctx: Checker, value: Expr) -> Expr {
    if ctx.inference.deferred_methods.is_empty() {
        return value
    }
    let value = map_child_exprs(value, |child| resolve_deferred_expr(ctx, child));
    match value {
        Callable { callable: DeferredMethod(id), .. } => {
            let resolved = resolve_deferred_method(ctx, id);
            Expr::Callable { callable: resolved.callable, ty: resolved.ty }
        },
        Call { func, args, ty } => {
            let result_ty = match prune(normalize_type(ctx, expr_type(func))) {
                Func { ret_ty, .. } if types_equal(ret_ty, Type::Never) => Type::Never,
                _ => ty,
            };
            Call { func, args, ty: result_ty }
        },
        other => other,
    }
}

fn resolve_deferred_block(ctx: Checker, value: Block) -> Block {
    if ctx.inference.deferred_methods.is_empty() {
        return value
    }
    map_block_exprs(value, |expr| resolve_deferred_expr(ctx, expr))
}

fn callable_has_unbound_arguments(value: Callable) -> bool {
    match value {
        MethodInstance { callable, args } => {
            for arg in args {
                if contains_unbound_any_variable(arg) {
                    return true
                }
            }
            callable_has_unbound_arguments(callable)
        },
        FunctionInstance { name: _, bindings } => {
            for binding in bindings {
                if contains_unbound_any_variable(binding.1) {
                    return true
                }
            }
            false
        },
        _ => false,
    }
}

fn report_callable_arguments(ctx: Checker, value: Expr) -> Expr {
    if let Callable { callable, ty: _ } = value {
        if callable_has_unbound_arguments(callable) {
            push_spanless_inference_diagnostic(ctx)
        }
    }
    map_child_exprs(value, |child| report_callable_arguments(ctx, child))
}

fn report_block_callable_arguments(ctx: Checker, value: Block) -> () {
    let _ = map_block_exprs(value, |expr| report_callable_arguments(ctx, expr));
}
