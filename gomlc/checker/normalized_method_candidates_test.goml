package checker;

use std::testing;

#[test]
fn normalized_trait_bounds_do_not_duplicate_method_candidates() -> () {
    for source in[
        "trait Read { fn read(self: Self) -> isize; }\nimpl Read for isize { fn read(self: isize) -> isize { self } }\nfn read[T: Read, U: Read](left: T, right: U) -> isize where T = U { left.read() }\nfn main() -> () { println(read(7, 8)); }\n",
        "trait Read[A] { fn read(self: Self, value: A) -> A; }\nimpl Read[isize] for bool { fn read(self: bool, value: isize) -> isize { value } }\nfn read[A, B, T: Read[A] + Read[B]](owner: T, value: A) -> A where A = B { owner.read(value) }\nfn main() -> () { println(read(true, 7)); }\n",
        "trait Read { fn read(self: Self) -> isize; } fn call[T:Read,U:Read](left:T,right:U)->isize where T=U { let f=T::read; f(left) }",
    ] {
        let _ = checked_file(source);
    }
    for source in[
        "trait Read[A] { fn read(self:Self)->isize; } fn call[T:Read[bool]+Read[i32]](value:T)->isize {value.read()}",
        "trait Read { fn read(self:Self)->isize; } trait Other { fn read(self:Self)->isize; } fn call[T:Read,U:Other](left:T,right:U)->isize where T=U {left.read()}",
    ] {
        testing::assert(has_diagnostic_containing(checked_diagnostics(source), "Ambiguous method"));
    }
}
