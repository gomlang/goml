package checker;

use module::ast;
use module::tast::{Callable, Expr, TraitRef, Type, TypePredicate, expr_type, prune, resolve_type, type_text};

struct InterpolationConversion {
    name: string,
    span: ast::Span,
}

fn defer_interpolated_conversion(ctx: Checker, value: Expr, span: ast::Span) -> Expr {
    let id = ctx.inference.counter.get();
    ctx.inference.counter.set(id + 1);
    let name = f"$interpolation/{id}";
    ctx.inference.interpolation_conversions.push(InterpolationConversion { name, span });
    Expr::Call {
        func: Expr::Callable {
            callable: Callable::Intrinsic(name),
            ty: Type::Func { params: one_type(expr_type(value)), ret_ty: Type::String },
        },
        args: one_expr(value),
        ty: Type::String,
    }
}

fn resolve_interpolated_conversion(ctx: Checker, expression: Expr) -> Option[Expr] {
    let Call { func: Callable { callable: Intrinsic(name), .. }, args, .. } = expression else {
        return None
    };
    for conversion in ctx.inference.interpolation_conversions {
        if conversion.name == name && args.len() == 1 {
            let value = args[0];
            let ty = resolve_type(normalize_type(ctx, expr_type(value)));
            if tast_expr_never(ctx, value) {
                return Some(with_expr_type(value, Type::Never))
            }
            if let String = prune(ty) {
                return Some(value)
            }
            let previous = ctx.current_span.get();
            ctx.current_span.set(Some(conversion.span));
            let reference = TraitRef { name: ctx.builtin.to_string.name, args: Vec::new() };
            require_predicate(
                ctx,
                TypePredicate::Trait { for_ty: ty, trait_ref: reference },
                "interpolated expression of type " + type_text(ty) + " does not implement ToString",
            );
            let result = match resolve_trait_reference_method(
                ctx,
                reference,
                ctx.builtin.to_string.method,
                Some(ty),
                Vec::new(),
                true,
            ) {
                Some(resolved) => {
                    require_callable_predicates(ctx, resolved);
                    let parts = callable_parts(ctx, resolved.ty, 1);
                    let callable = match prune(ty) {
                        Dyn { trait_name, .. } => Callable::DynTraitMethod {
                            trait_name,
                            dispatch_name: reference.name,
                            method_name: ctx.builtin.to_string.method,
                        },
                        _ => resolved.callable,
                    };
                    let call = apply_typed_call(
                        ctx,
                        Expr::Callable { callable, ty: resolved.ty },
                        one_expr(value),
                        parts.0,
                        parts.1,
                        1,
                        false,
                    );
                    coerce_expr(ctx, call, Some(Type::String))
                },
                None => {
                    push_diagnostic(
                        ctx,
                        "ToString conversion is unavailable for interpolated expression",
                    );
                    Expr::Prim { value: String { value: "" }, ty: Type::Error }
                },
            };
            ctx.current_span.set(previous);
            return Some(result)
        }
    }
    None
}
