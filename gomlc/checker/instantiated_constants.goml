package checker;

use module::consts;
use module::tast::{ImplInfo, TraitRef, Type, TypeSubst, const_type_value, for_each_child_type, prune, substitute_type, symbolic_array};

fn instantiated_const_argument_error(value: Type) -> Option[string] {
    if let Some(error) = const_operation_error(value) {
        return Some(error)
    }
    if let Some(number) = const_type_value(value) {
        if number < 0 {
            return Some("const usize argument must be nonnegative")
        }
    }
    None
}

fn instantiated_const_arguments_error(parameters: Vec[string], arguments: Vec[Type]) -> Option[
    string,
] {
    for index in 0..arguments.len() {
        if index < parameters.len() && consts::parameter_name(parameters[index]).is_some() {
            if let Some(error) = instantiated_const_argument_error(arguments[index]) {
                return Some(error)
            }
        }
    }
    None
}

fn instantiated_const_type_error(ctx: Checker, value: Type) -> Option[string] {
    instantiated_const_type_error_at(ctx, value, Vec::new())
}

fn instantiated_const_type_error_at(ctx: Checker, value: Type, visited: Vec[Type]) -> Option[string] {
    let value = prune(normalize_type(ctx, value));
    if type_list_contains(visited, value) {
        return None
    }
    visited.push(value);
    if let Some(parts) = symbolic_array(value) {
        if let Some(error) = instantiated_const_argument_error(parts.0) {
            return Some(error)
        }
        return instantiated_const_type_error_at(ctx, parts.1, visited)
    }
    match value {
        Array { len, .. } if len < 0 => return Some("const usize argument must be nonnegative"),
        App { ty: Con { name }, args } => {
            if let Some(error) = nominal_const_argument_error(ctx, name, args) {
                return Some(error)
            }
            if let Some(error) = instantiated_const_arguments_error(
                nominal_parameters(ctx, name),
                args,
            ) {
                return Some(error)
            }
        },
        Con { name } => {
            if let Some(error) = nominal_const_argument_error(ctx, name, Vec::new()) {
                return Some(error)
            }
        },
        Dyn { trait_name, args, .. } => {
            if let Some(error) = instantiated_const_arguments_error(
                nominal_parameters(ctx, trait_name),
                args,
            ) {
                return Some(error)
            }
        },
        _ => (),
    }
    let children = Vec::new();
    for_each_child_type(value, |child| children.push(child));
    for child in children {
        if let Some(error) = instantiated_const_type_error_at(ctx, child, visited) {
            return Some(error)
        }
    }
    None
}

fn instantiated_trait_const_error(ctx: Checker, for_ty: Type, reference: TraitRef) -> Option[string] {
    let reference = normalize_trait_ref(ctx, reference);
    if let Some(error) = instantiated_const_arguments_error(
        nominal_parameters(ctx, reference.name),
        reference.args,
    ) {
        return Some(error)
    }
    if let Some(error) = instantiated_const_type_error(ctx, for_ty) {
        return Some(error)
    }
    for argument in reference.args {
        if let Some(error) = instantiated_const_type_error(ctx, argument) {
            return Some(error)
        }
    }
    None
}

fn instantiated_impl_associated_const_types_valid(
    ctx: Checker,
    value: ImplInfo,
    substitutions: Vec[TypeSubst],
) -> bool {
    let validation = Checker { diagnostics: Vec::new(), ..ctx };
    for associated in value.associated_types {
        if instantiated_const_type_error(validation, substitute_type(associated.1, substitutions)).is_some() {
            return false
        }
    }
    validation.diagnostics.is_empty()
}

fn instantiated_equality_const_error(ctx: Checker, left: Type, right: Type) -> Option[string] {
    let validation = Checker { diagnostics: Vec::new(), ..ctx };
    if let Some(error) = instantiated_const_type_error(validation, left) {
        return Some(error)
    }
    instantiated_const_type_error(validation, right)
}
