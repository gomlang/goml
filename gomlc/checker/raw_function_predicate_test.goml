package checker;

use std::testing;

#[test]
fn generic_body_raw_function_constraints_reach_calls_and_function_values() -> () {
    for invocation in[
        "create::[Vec[i32]]();",
        "let call = create::[Vec[i32]]; call();",
        "forward::[Vec[i32]]();",
    ] {
        let source = "fn create[T]() -> () { let value: Option[GoFunc[(T) -> T]] = None; } fn forward[T]() -> () { create::[T](); } fn main() -> () { "
            + invocation
            + " }";
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "Go function signature is not ABI-compatible",
            ),
        );
    }
    let _ = checked_file(
        "fn create[T]() -> () { let value: Option[GoFunc[(T) -> T]] = None; } fn forward[T]() -> () { create::[T](); } fn main() -> () { create::[i32](); let call = forward::[i32]; call(); }",
    );
}

#[test]
fn body_raw_function_constraints_preserve_return_abi_rules() -> () {
    for ty in["()", "(i32, bool)", "i32"] {
        let _ = checked_file(
            "fn create[T]() -> () { let value: Option[GoFunc[() -> T]] = None; } fn main() -> () { create::["
                + ty
                + "](); }",
        );
    }
    for ty in["()", "(i32, bool)", "Vec[i32]"] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(
                    "fn create[T]() -> () { let value: Option[GoFunc[(T) -> ()]] = None; } fn main() -> () { create::["
                        + ty
                        + "](); }",
                ),
                "Go function signature is not ABI-compatible",
            ),
        );
    }
}

#[test]
fn trait_default_bodies_retain_raw_function_requirements() -> () {
    for ty in["i32", "Vec[i32]"] {
        let source = "trait Make[T] { fn create(self: Self) -> () { let callback: Option[GoFunc[(T) -> T]] = None; } } impl Make["
            + ty
            + "] for i32 {}";
        let diagnostics = checked_diagnostics(source);
        if ty == "i32" {
            testing::assert(diagnostics.is_empty());
        } else {
            testing::assert(
                has_diagnostic_containing(
                    diagnostics,
                    "Go function signature is not ABI-compatible",
                ),
            );
        }
    }
}

#[test]
fn overriding_default_body_does_not_inherit_raw_function_requirements() -> () {
    let _ = checked_file(
        "trait Make[T] { fn create(self: Self) -> () { let callback: Option[GoFunc[(T) -> T]] = None; } } impl Make[Vec[i32]] for i32 { fn create(self: i32) -> () {} }",
    );
}
