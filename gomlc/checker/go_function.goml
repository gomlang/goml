package checker;

use module::tast::{Type, for_each_child_type, foreign_function_bridge, prune, type_is_concrete};

fn invalid_go_function_signature(ctx: Checker, value: Type) -> Option[string] {
    invalid_go_function_signature_at(ctx, value, Vec::new())
}

fn invalid_go_function_signature_at(ctx: Checker, value: Type, visited: Vec[Type]) -> Option[string] {
    let children: Vec[Type] = Vec::new();
    let value = prune(normalize_type(ctx, value));
    if type_list_contains(visited, value) {
        return None
    }
    visited.push(value);
    if let GoFunction { signature } = value {
        if type_is_concrete(signature) {
            if let Err(error) = foreign_function_bridge(signature, ctx.traits) {
                return Some(error)
            }
        }
    }
    if let Some(parts) = struct_application_parts(value) {
        if let Some(error) = nominal_raw_function_argument_error(ctx, parts.0, parts.1) {
            return Some(error)
        }
    }
    for_each_child_type(value, |child| children.push(child));
    for child in children {
        if let Some(key) = invalid_go_function_signature_at(ctx, child, visited) {
            return Some(key)
        }
    }
    None
}
