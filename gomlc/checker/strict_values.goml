package checker;

use module::tast::{Type};

fn hint_expression_type(ctx: Checker, actual: Type, expected: Type) -> () {
    let snapshot = deferred_dependency_snapshot(ctx, Vec::from_array([actual, expected]));
    let diagnostic_start = ctx.diagnostics.len();
    expect_type(ctx, actual, expected);
    if ctx.diagnostics.len() != diagnostic_start {
        snapshot.restore();
        ctx.diagnostics.truncate(diagnostic_start);
    }
}
