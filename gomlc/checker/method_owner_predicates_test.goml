package checker;

use std::testing;

#[test]
fn method_predicates_may_repeat_implementation_owner_bounds() -> () {
    for source in[
        "trait Extra {} trait Main[T] { fn run(self) -> i32 where T: Extra; } struct Box[T] { value: T } impl[T: Extra] Main[T] for Box[T] { fn run(self) -> i32 where T: Extra { 7 } }",
        "trait Extra {} trait Main[T] { fn run(self) -> i32 where T: Extra; } struct Box[T] { value: T } impl[T: Extra] Main[T] for Box[T] { fn run(self) -> i32 { 7 } }",
        "trait Parent {} trait Child: Parent {} trait Main[T] { fn run(self) -> i32 where T: Parent; } struct Box[T] { value: T } impl[T: Child] Main[T] for Box[T] { fn run(self) -> i32 where T: Parent { 7 } }",
        "trait Main[T] { fn run(self) -> i32 where T = i32; } struct Box[T] { value: T } impl[T] Main[T] for Box[T] where T = i32 { fn run(self) -> i32 where T = i32 { 7 } }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn implementation_owner_bounds_do_not_hide_stronger_method_requirements() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "trait Extra {} trait Stronger {} trait Main[T] { fn run(self) -> i32 where T: Extra; } struct Box[T] { value: T } impl[T: Extra] Main[T] for Box[T] { fn run(self) -> i32 where T: Stronger { 7 } }",
            ),
            "method bounds do not match",
        ),
    );
}

#[test]
fn default_methods_expand_their_actual_implied_bounds() -> () {
    let _ = checked_file(
        "trait Parent {} trait Child: Parent {} trait Main { fn run[T: Child](self) -> i32 { 7 } } impl Main for bool {}",
    );
}
