package checker;

use module::ast;
use module::hir;
use module::tast::{Expr, expr_type, prune, symbolic_array};

fn projected_assignment_location(
    ctx: Checker,
    value: Expr,
    local_root: Option[hir::LocalId],
    span: ast::Span,
) -> bool {
    if type_contains_error(expr_type(value)) || tast_expr_never(ctx, value) {
        return true
    }
    match value {
        Var { .. } => true,
        Field { expr: base, .. } | Proj { tuple: base, .. } => projected_assignment_location(
            ctx,
            base,
            local_root,
            span,
        ),
        Index { base, .. } => {
            let receiver = prune(normalize_type(ctx, expr_type(base)));
            match receiver {
                Array { .. } => {
                    validate_array_assignment_root(ctx, local_root, base, span);
                    projected_assignment_location(ctx, base, local_root, span)
                },
                other if symbolic_array(other).is_some() => {
                    validate_array_assignment_root(ctx, local_root, base, span);
                    projected_assignment_location(ctx, base, local_root, span)
                },
                _ => true,
            }
        },
        _ => typed_array_assignment_root_is_ref(value),
    }
}

fn resolve_assignment_location_constraints(ctx: Checker) -> () {
    for constraint in ctx.inference.assignment_location_constraints {
        let value = resolve_deferred_expr(ctx, constraint.value);
        if !projected_assignment_location(ctx, value, constraint.local_root, constraint.span) {
            push_diagnostic_at(ctx, "assignable location required", Some(constraint.span));
        }
    }
}
