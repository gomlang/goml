package checker;

use module::ctir;
use module::hir;
use module::tast::{Constant, ConstantScheme, DependencyEnvironment, File, MethodInfo, Type, prune, type_from_hir, type_constructor_name};

fn prepare_named_constant_values(
    base: Checker,
    files: Vec[hir::File],
    dependencies: Vec[DependencyEnvironment],
) -> () {
    let constants: Vec[Constant] = Vec::new();
    let pending: Vec[PendingConstant] = Vec::new();
    let seen: Vec[string] = Vec::new();
    for file in files {
        let sources: Vec[hir::Constant] = Vec::new();
        for item in file.items {
            match item {
                hir::Item::Constant(value) => sources.push(value),
                hir::Item::ImplBlock(value) if value.generics.is_empty()
                    && value.trait_ref.is_none() => {
                    if let Some(owner) = type_constructor_name(
                        base.builtin,
                        type_from_hir(base.builtin, value.for_type, Vec::new(), None),
                    ) {
                        for method in value.methods {
                            if method.name.starts_with("$associated_const:") {
                                if let (Some(ty), Some(expression)) = (
                                    method.ret_ty,
                                    method.body.tail,
                                ) {
                                    let name = owner + "::"
                                        + method.name.byte_slice(18, method.name.byte_len());
                                    sources.push(
                                        hir::Constant {
                                            def_id: method.def_id,
                                            attrs: method.attrs,
                                            visibility: method.visibility,
                                            name,
                                            ty,
                                            value: expression,
                                        },
                                    );
                                }
                            }
                        }
                    }
                },
                _ => (),
            }
        }
        if sources.is_empty() {
            continue
        }
        let methods: Vec[MethodInfo] = Vec::with_capacity(base.methods.len());
        for method in base.methods {
            if !method.function.name.contains("$associated_const:") {
                methods.push(method);
            }
        }
        let ctx = Checker {
            methods,
            diagnostics: Vec::new(),
            typeck_results: empty_typeck_results(),
            inference: inference_context(Ref::new(0)),
            current_span: Ref::new(None),
            source_path: file.source_path,
            package_aliases: file.import_aliases,
            imported_items: file.imports,
            ..base,
        };
        for value in sources {
            if find_constant_by_name(base, value.name).is_none() {
                base.constants.push(
                    ConstantScheme {
                        def_id: None,
                        name: value.name,
                        ty: type_from_hir(ctx.builtin, value.ty, Vec::new(), None),
                        value: None,
                    },
                );
            }
        }
        for value in sources {
            let ty = expand_type_aliases(
                ctx,
                type_from_hir(ctx.builtin, value.ty, Vec::new(), None),
                false,
            );
            let scalar = is_numeric_type(ty)
                || match prune(ty) {
                    Bool | Char | String => true,
                    _ => false,
                };
            if scalar && !seen.contains(value.name) {
                seen.push(value.name);
                let checked = check_constant(ctx, value);
                if let Some(value) = checked.0 {
                    constants.push(value);
                }
                if let Some(value) = checked.1 {
                    pending.push(value);
                }
            }
        }
    }
    let modules: Vec[ctir::CtModule] = Vec::new();
    for dependency in dependencies {
        if let Some(module) = dependency.comptime {
            modules.push(module);
        }
    }
    let file = File {
        items: Vec::new(),
        enums: Vec::new(),
        structs: Vec::new(),
        constants,
        statics: Vec::new(),
    };
    let module = ctir::empty_module(base.package_name);
    let names = comptime_constant_names(file, pending);
    let _ = evaluate_constants(base.builtin, file, pending, module, modules, names, Vec::new());
    for index in 0..base.constants.len() {
        let scheme = base.constants[index];
        if let Some(value) = module_constant_primitive(module, scheme.name, scheme.ty) {
            base.constants.set(index, ConstantScheme { value: Some(value), ..scheme });
        }
    }
}
