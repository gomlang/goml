package checker;

use std::testing;

#[test]
fn projections_preserve_receiver_divergence() -> () {
    for projection in[".value", ".0"] {
        for source in[
            "fn stop() -> never { loop {} } fn f() -> never { stop()" + projection + " }",
            "fn f[T](exit: T) -> never where T = never { exit" + projection + " }",
            "fn take(f: (never) -> i32) -> () {} fn run() -> () { let f = |x| x" + projection
                + "; take(f) }",
        ] {
            let _ = checked_file(source);
        }
        testing::assert(
            !checked_diagnostics("fn f(x: bool) -> i32 { x" + projection + " }").is_empty(),
        );
    }
}
