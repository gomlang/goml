package checker;

use std::testing;

#[test]
fn immutable_bindings_cannot_be_reassigned() -> () {
    for source in[
        "fn main() -> () { let value = 1; value = 2; }",
        "fn main() -> () { let value = 1; value += 2; }",
        "fn main() -> () { let (left, mut right) = (1, 2); left = 3; right = 4; }",
        "fn change(value: i32) -> () { value = 2; }",
        "fn main() -> () { let change = |value: i32| { value += 1; }; change(1); }",
        "fn main() -> () { let value = 1; let change = || { value = 2; }; change(); }",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "cannot reassign immutable binding",
            ),
        );
    }
}

#[test]
fn constant_projection_roots_cannot_be_assigned() -> () {
    for source in[
        "struct Point { x: i32 } const VALUE: Point = Point { x: 1 }; fn main() -> () { VALUE.x = 2; }",
        "struct Point { x: i32 } const VALUE: Point = Point { x: 1 }; fn main() -> () { VALUE.x += 2; }",
        "const VALUE: (i32, i32) = (1, 2); fn main() -> () { VALUE.0 = 3; }",
        "struct Point { x: i32 } const VALUE: [Point; 1] = [Point { x: 1 }]; fn main() -> () { VALUE[0].x = 2; }",
        "struct Point { x: i32 } const VALUE: (Point, i32) = (Point { x: 1 }, 2); fn main() -> () { VALUE.0.x = 3; }",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "cannot assign through constant `VALUE`",
            ),
        );
    }
}

#[test]
fn assignment_preserves_mutable_bindings_and_interior_mutation() -> () {
    for source in[
        "fn main() -> () { let mut value = 1; value = 2; value += 3; }",
        "fn change(value: i32) -> i32 { let mut copy = value; copy += 1; copy }",
        "fn main() -> () { let mut value = 1; let change = || { value += 1; }; change(); }",
        "struct Point { x: i32 } fn main() -> () { let point = Point { x: 1 }; point.x = 2; }",
        "fn main() -> () { let pair = (1, 2); pair.0 = 3; }",
        "struct Point { x: i32 } fn main() -> () { let shared = Ref::new(Point { x: 1 }); shared.get().x = 2; }",
        "fn main() -> () { let values = Vec::from_array([1]); values[0] = 2; let shared = Ref::new([1]); shared.get()[0] = 2; let map: HashMap[i32, i32] = HashMap::new(); map[1] = 2; }",
    ] {
        let _ = checked_file(source);
    }
}
