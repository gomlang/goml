package checker;

use std::testing;
use module::tast::{TraitRef, Type, TypePredicate, TypeVar, VarKind, builtin_contract, map_child_types, types_equal};

#[test]
fn numeric_owner_obligations_wait_for_result_field_context() -> () {
    let prefix = "struct Box[T] { value: T } struct Maker[T] { value: T } trait Make[T] { fn make(self: Self) -> T; } impl[T: ToString] Make[Box[T]] for Maker[T] { fn make(self: Maker[T]) -> Box[T] { Box { value: self.value } } } ";
    for body in[
        "let value: i32 = Maker { value: 7 }.make().value;",
        "let value: i32 = Make::[Box[i32]]::make(Maker { value: 7 }).value;",
        "let value: i32 = Maker::make(Maker { value: 7 }).value;",
        "let value: i32 = (Maker::make)(Maker { value: 7 }).value;",
        "let value: f32 = Maker { value: 7.0 }.make().value;",
        "let value: u8 = Make::[Box[u8]]::make(Maker { value: 7 }).value;",
    ] {
        let _ = checked_file(prefix + "fn main() -> () { " + body + " println(value); }");
    }
    let prefix = "struct Box[T] { value: T } struct Maker[T] { value: T } trait Read { type Item; fn read(self: Self) -> Self::Item; } impl[T: ToString] Read for Maker[T] { type Item = Box[T]; fn read(self: Maker[T]) -> Box[T] { Box { value: self.value } } } ";
    for body in[
        "let value: i32 = Maker { value: 7 }.read().value;",
        "let value: i32 = Read::read(Maker { value: 7 }).value;",
        "let value: f32 = Read::read(Maker { value: 7.0 }).value;",
    ] {
        let _ = checked_file(prefix + "fn main() -> () { " + body + " println(value); }");
    }
}

#[test]
fn numeric_owner_obligations_reject_the_final_incompatible_type() -> () {
    let prefix = "struct Box[T] { value: T } struct Maker[T] { value: T } trait Mark {} impl Mark for isize {} impl Mark for u8 {} trait Make[T] { fn make(self: Self) -> T; } impl[T: Mark] Make[Box[T]] for Maker[T] { fn make(self: Maker[T]) -> Box[T] { Box { value: self.value } } } ";
    for body in[
        "let value: i32 = Maker { value: 7 }.make().value;",
        "let value: i32 = Make::[Box[i32]]::make(Maker { value: 7 }).value;",
        "let value: i32 = Maker::make(Maker { value: 7 }).value;",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(prefix + "fn main() -> () { " + body + " println(value); }"),
                "No instance found for trait",
            ),
        );
    }
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "struct Box[T] { value: T } struct Maker[T] { value: T } trait Mark {} impl Mark for isize {} impl Mark for u8 {} trait Read { type Item; fn read(self: Self) -> Self::Item; } impl[T: Mark] Read for Maker[T] { type Item = Box[T]; fn read(self: Maker[T]) -> Box[T] { Box { value: self.value } } } fn main() -> () { let value: i32 = Read::read(Maker { value: 7 }).value; println(value); }",
            ),
            "No instance found for trait",
        ),
    );
    let _ = checked_file(
        "struct Box[T] { value: T } struct Maker[T] { value: T } trait Integer {} trait Boolean {} impl Integer for i32 {} impl Boolean for bool {} trait First { fn make(self: Self) -> Box[i32]; } trait Second { fn make(self: Self) -> Box[bool]; } impl[T: Integer] First for Maker[T] { fn make(self: Maker[T]) -> Box[i32] { Box { value: 7 } } } impl[T: Boolean] Second for Maker[T] { fn make(self: Maker[T]) -> Box[bool] { Box { value: true } } } fn main() -> () { let value: i32 = Maker { value: 7 }.make().value; println(value); }",
    );
}

#[test]
fn unique_trait_inference_stops_growing_obligations_without_proving_them() -> () {
    let builtin = testing::expect_ok(builtin_contract(), "builtin contract");
    for target in["Wrap[Vec[T]]", "Wrap[(T, T)]"] {
        let file = dependency_hir(
            "package api; struct Wrap[T] {} trait Mark {} impl[T] Mark for Wrap[T] where " + target
                + ": Mark {}",
            "audit::api",
        );
        let ctx = collect_environment(file, false, builtin);
        let number = Type::Var(Ref::new(TypeVar::Unbound { id: 100000, kind: VarKind::Integer }));
        let owner = Type::App {
            ty: Type::Con { name: "audit::api::Wrap" },
            args: Vec::from_array([number]),
        };
        let reference = TraitRef { name: "audit::api::Mark", args: Vec::new() };
        infer_unique_trait_application(ctx, owner, reference, Vec::new());
        testing::assert(contains_unbound_type_variable(number));
        testing::assert(ctx.inference.required_predicates.is_empty());
        testing::assert(!trait_bound_satisfied_at(ctx, Type::Bool, reference, Vec::new()));
    }
}

#[test]
fn unique_trait_inference_preserves_context_and_dynamic_evidence() -> () {
    let builtin = testing::expect_ok(builtin_contract(), "builtin contract");
    let file = dependency_hir(
        "package api; struct Wrap[T] {} trait Mark {} impl Mark for Wrap[i32] {}",
        "audit::api",
    );
    let ctx = collect_environment(file, false, builtin);
    let number = Type::Var(Ref::new(TypeVar::Unbound { id: 100000, kind: VarKind::Integer }));
    let owner = Type::App {
        ty: Type::Con { name: "audit::api::Wrap" },
        args: Vec::from_array([number]),
    };
    let reference = TraitRef { name: "audit::api::Mark", args: Vec::new() };
    ctx.predicates.push(TypePredicate::Trait { for_ty: owner, trait_ref: reference });
    infer_unique_trait_application(ctx, owner, reference, Vec::new());
    testing::assert(contains_unbound_type_variable(number));
    testing::assert(trait_bound_satisfied_at(ctx, owner, reference, Vec::new()));
    let file = dependency_hir(
        "package api; trait Mark[T] {} impl Mark[i32] for dyn Mark[i32] {}",
        "audit::api",
    );
    let ctx = collect_environment(file, false, builtin);
    let number = Type::Var(Ref::new(TypeVar::Unbound { id: 100000, kind: VarKind::Integer }));
    let owner = map_child_types(
        ctx.impls[0].for_type,
        |child| if types_equal(child, Type::Int32) {
            number
        } else {
            child
        },
    );
    let reference = TraitRef { name: "audit::api::Mark", args: Vec::from_array([number]) };
    infer_unique_trait_application(ctx, owner, reference, Vec::new());
    testing::assert(contains_unbound_type_variable(number));
    testing::assert(trait_bound_satisfied_at(ctx, owner, reference, Vec::new()));
}
