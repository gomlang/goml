package checker;

use std::testing;

#[test]
fn rejects_associated_type_cycles_through_dyn_bounds() -> () {
    for definition in[
        "dyn Holder[Item = Self::Item]",
        "dyn Consume[Self::Item]",
        "dyn Marker + Holder[Item = Self::Item]",
        "dyn Marker + Consume[Self::Item]",
    ] {
        let diagnostics = checked_diagnostics(
            "trait Holder { type Item; } trait Consume[T] {} trait Marker {} trait Values { type Item; } struct Value {} impl Values for Value { type Item = "
                + definition
                + "; }",
        );
        if !has_diagnostic_containing(
            diagnostics,
            "Associated type Item has a cyclic definition in impl of trait Values",
        ) {
            let messages = Vec::new();
            for diagnostic in diagnostics {
                messages.push(diagnostic.message);
            }
            testing::fail(definition + ": " + messages.join("; "));
        }
    }
}

#[test]
fn accepts_finite_associated_types_with_dyn_bounds() -> () {
    for definition in[
        "dyn Holder[Item = i32]",
        "dyn Consume[i32]",
        "dyn Marker + Holder[Item = i32]",
        "dyn Marker + Consume[i32]",
    ] {
        let _ = checked_file(
            "trait Holder { type Item; } trait Consume[T] {} trait Marker {} trait Values { type Item; } struct Value {} impl Values for Value { type Item = "
                + definition
                + "; }",
        );
    }
}

#[test]
fn reports_associated_cycles_before_checking_their_bounds() -> () {
    for definition in["Self::Item", "Vec[Self::Item]", "dyn Holder[Item = Self::Item]"] {
        let diagnostics = checked_diagnostics(
            "trait Marker {} trait Holder { type Item; } trait Values { type Item: Marker; } struct Value {} impl Values for Value { type Item = "
                + definition
                + "; }",
        );
        testing::assert(
            has_diagnostic_containing(
                diagnostics,
                "Associated type Item has a cyclic definition in impl of trait Values",
            ),
        );
    }
}

#[test]
fn resolves_finite_dyn_associated_type_forwarding() -> () {
    for definition in[
        "dyn Holder[Item = Self::Other]",
        "dyn Consume[Self::Other]",
        "dyn Marker + Holder[Item = Self::Other]",
        "dyn Marker + Consume[Self::Other]",
    ] {
        let _ = checked_file(
            "trait Holder { type Item; } trait Consume[T] {} trait Marker {} trait Values { type Item; type Other; } struct Value {} impl Values for Value { type Other = i32; type Item = "
                + definition
                + "; }",
        );
    }
}

#[test]
fn normalizes_finite_dyn_associated_types_in_method_signatures() -> () {
    let _ = checked_file(
        "trait Holder { type Item; } trait Values { type Item; type Other; fn pass(value: Self::Item) -> Self::Item; } struct Value {} impl Values for Value { type Other = i32; type Item = dyn Holder[Item = Self::Other]; fn pass(value: dyn Holder[Item = i32]) -> dyn Holder[Item = i32] { value } }",
    );
}
