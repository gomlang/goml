package checker;

use std::testing;

#[test]
fn nominal_raw_function_signatures_are_checked_after_specialization() -> () {
    for source in[
        "struct Wrap[T] { callback: GoFunc[(T) -> T] } fn unused(value: Wrap[Vec[i32]]) -> () {}",
        "enum Wrap[T] { Empty, Callback(GoFunc[(T) -> T]) } fn unused(value: Wrap[Vec[i32]]) -> () {}",
        "struct Inner[T] { callback: GoFunc[(T) -> T] } struct Wrap[T] { value: Inner[T] } fn unused(value: Wrap[Vec[i32]]) -> () {}",
        "struct Inner[T] { callback: GoFunc[(T) -> T] } enum Wrap[T] { Empty, Value(Inner[T]) } fn unused(value: Wrap[Vec[i32]]) -> () {}",
        "enum Wrap[T] { Empty, Callback(GoFunc[(T) -> T]) } fn main() -> () { let _ = Wrap::[Vec[i32]]::Empty; }",
        "struct Wrap[F] { callback: GoFunc[F] } fn unused(value: Wrap[bool]) -> () {}",
        "struct Wrap[T] { callback: GoFunc[(T) -> T] } type Invalid = Wrap[Vec[i32]];",
    ] {
        let diagnostics = checked_diagnostics(source);
        testing::assert(
            has_diagnostic_containing(diagnostics, "unsupported bridge type")
                || has_diagnostic_containing(
                    diagnostics,
                    "Go function requires a concrete function signature",
                ),
        );
    }
}

#[test]
fn raw_function_requirements_preserve_parameter_and_result_rules() -> () {
    for source in[
        "struct Wrap[T] { callback: GoFunc[(T) -> T] } fn unused(value: Wrap[i32]) -> () {}",
        "struct Wrap[T] { callback: GoFunc[() -> T] } fn unused(value: Wrap[()]) -> () {}",
        "struct Wrap[T] { callback: GoFunc[() -> T] } fn unused(value: Wrap[(i32, bool)]) -> () {}",
        "struct Wrap[F] { callback: GoFunc[F] } fn unused(value: Wrap[(i32) -> bool]) -> () {}",
        "enum Chain[T] { End, Next(Vec[Chain[Slice[T]]]), Callback(GoFunc[(T) -> T]) } fn unused(value: Chain[i32]) -> () {}",
    ] {
        let _ = checked_file(source);
    }
    for ty in["()", "(i32, bool)"] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(
                    "struct Wrap[T] { callback: GoFunc[(T) -> ()] } fn unused(value: Wrap[" + ty
                        + "]) -> () {}",
                ),
                "unsupported bridge type",
            ),
        );
    }
}
