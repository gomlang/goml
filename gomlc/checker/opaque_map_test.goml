package checker;

use std::testing;

#[test]
fn opaque_map_keys_validate_hidden_types_and_forward_obligations() -> () {
    let common = "trait Marker {} impl Marker for i32 {} impl Marker for Slice[i32] {} fn accept[K](key: K) -> () { let map: Option[GoMap[K, i32]] = None; } ";
    let key = "fn key[T: Marker](value: T) -> impl Marker { value } ";
    for forward in[false, true] {
        for invalid in[false, true] {
            let call = "fn main() -> () { "
                + if invalid {
                    "let values: Vec[i32] = Vec::from_array([1]); accept(key(values.as_slice()));"
                } else {
                    "let value: i32 = 7; accept(key(value));"
                }
                + " } ";
            let source = common
                + if forward {
                    call + key
                } else {
                    key + call
                };
            let diagnostics = checked_diagnostics(source);
            if invalid {
                testing::assert(
                    has_diagnostic_containing(diagnostics, "Go map key is not comparable"),
                );
            } else {
                for diagnostic in diagnostics {
                    testing::fail(diagnostic.message);
                }
            }
        }
    }
}

#[test]
fn generic_opaque_key_proofs_survive_forwarding() -> () {
    let common = "trait Marker {} impl Marker for i32 {} impl Marker for Slice[i32] {} fn accept[K](key: K) -> () { let map: Option[GoMap[K, i32]] = None; } fn forward[T: Marker](value: T) -> () { accept(key(value)); } fn key[T: Marker](value: T) -> impl Marker { value } ";
    let _ = checked_file(common + "fn main() -> () { let value: i32 = 7; forward(value); }");
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                common
                    + "fn main() -> () { let values: Vec[i32] = Vec::from_array([1]); forward(values.as_slice()); }",
            ),
            "Go map key is not comparable",
        ),
    );
}
