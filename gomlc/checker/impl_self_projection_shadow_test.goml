package checker;

use std::testing;

#[test]
fn impl_self_projections_prefer_the_implemented_traits_own_associated_type() -> () {
    for source in[
        "trait Parent { type Item; } trait Child: Parent { type Item; fn get(self) -> Self::Item; } impl Parent for bool { type Item = string; } impl Child for bool { type Item = i32; fn get(self) -> Self::Item { 7 } }",
        "trait Parent { type Item; } trait Child: Parent { type Item; fn get(self, value: Self::Item) -> Self::Item; } impl Parent for bool { type Item = string; } impl Child for bool { type Item = i32; fn get(self, value: Self::Item) -> Self::Item { value } }",
        "trait Parent { type Item; } trait Child: Parent { type Item; fn get(self) -> i32 where Self::Item = i32; } impl Parent for bool { type Item = string; } impl Child for bool { type Item = i32; fn get(self) -> i32 where Self::Item = i32 { 7 } }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn impl_self_projection_shadowing_does_not_accept_the_parent_associated_type() -> () {
    testing::assert(
        !checked_diagnostics(
            "trait Parent { type Item; } trait Child: Parent { type Item; fn get(self) -> Self::Item; } impl Parent for bool { type Item = string; } impl Child for bool { type Item = i32; fn get(self) -> Self::Item { \"wrong\" } }",
        ).is_empty(),
    );
}
