package checker;

use std::testing;

#[test]
fn for_iterators_infer_protocols_from_later_closure_calls() -> () {
    for source in[
        "fn f() -> () { let visit = |xs| { for value in xs { let _: i32 = value; } }; visit([1, 2]); }",
        "fn f() -> () { let visit = |xs| { for value in xs { let _: i32 = value; } }; visit(Vec::from_array([1, 2])); }",
        "fn f(xs: Slice[i32]) -> () { let visit = |xs| { for value in xs { let _: i32 = value; } }; visit(xs); }",
        "fn f(xs: MutSlice[i32]) -> () { let visit = |xs| { for value in xs { let _: i32 = value; } }; visit(xs); }",
        "fn f() -> () { let visit = |xs| { for (number, flag) in xs { let _: i32 = number; let _: bool = flag; } }; visit([(1, true)]); }",
        "fn f() -> () { let visit = |xs| { for [first, rest @ ..] in xs { let _: i32 = first; let _: [i32; 1] = rest; } }; visit([[1, 2]]); }",
        "struct Numbers { values: Vec[i32] } impl IntoIterator for Numbers { type Item = i32; type IntoIter = FnIterator[i32]; fn into_iter(self: Numbers) -> FnIterator[i32] { self.values.iter() } } fn f(xs: Numbers) -> () { let visit = |xs| { for value in xs { let _: i32 = value; } }; visit(xs); }",
        "trait Source { type Items; fn items(self: Self) -> Self::Items; } struct Owner {} impl Source for Owner { type Items = Vec[i32]; fn items(self: Owner) -> Vec[i32] { Vec::from_array([1, 2]) } } fn get[T: Source](value: T) -> T::Items { value.items() } fn f() -> () { let visit = |owner| { for value in get(owner) { let _: i32 = value; } }; visit(Owner {}); }",
        "trait Batch { type Items: IntoIterator; fn items(self: Self) -> Self::Items; } fn iterate[B: Batch](batch: B) -> () { for _ in Batch::items(batch) {} }",
        "fn f() -> i32 { for _ in return 7 {} }",
    ] {
        if !checked_diagnostics(source).is_empty() {
            testing::fail(source)
        }
    }
}

#[test]
fn inferred_for_iterators_reject_unknown_protocols_and_invalid_items() -> () {
    for case in[
        (
            "fn f() -> () { for _ in 1 {} }",
            "for loop expects a type implementing IntoIterator, got isize",
        ),
        (
            "fn f() -> () { for _ in 1.0 {} }",
            "for loop expects a type implementing IntoIterator, got f64",
        ),
        (
            "fn f() -> () { let visit = |xs| { for _ in xs {} }; visit(1); }",
            "for loop expects a type implementing IntoIterator, got isize",
        ),
        (
            "fn f() -> () { let visit = |xs| { for _ in xs {} }; }",
            "Could not infer the iterator type",
        ),
        (
            "fn f() -> () { let visit = |xs| { for _ in xs {} }; visit(true); }",
            "for loop expects a type implementing IntoIterator",
        ),
        (
            "fn f(xs: [i32; 2]) -> () { let visit = |xs| { for value in xs { let _: bool = value; } }; visit(xs); }",
            "Type mismatch",
        ),
        (
            "fn f(xs: Vec[Option[i32]]) -> () { let visit = |xs| { for Option::Some(value) in xs { let _: i32 = value; } }; visit(xs); }",
            "Refutable pattern is not allowed in for loop",
        ),
        (
            "fn f() -> () { let visit = |xs| { for _ in xs { true } }; visit([1, 2]); }",
            "Type mismatch",
        ),
    ] {
        if !has_diagnostic_containing(checked_diagnostics(case.0), case.1) {
            testing::fail(case.0 + " expected diagnostic: " + case.1)
        }
    }
}
