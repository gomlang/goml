package checker;

use std::testing;

#[test]
fn tuple_projection_infers_later_receiver_shape() -> () {
    for source in[
        "fn f() -> i32 { let first = |pair| pair.0; first((7, true)) }",
        "struct Pair(i32); fn f() -> i32 { let first = |pair| pair.0; first(Pair(7)) }",
        "fn f() -> i32 { let first = |pair| (pair.0).1; first(((true, 7), false)) }",
        "struct Item { pair: (i32, bool) } fn f() -> i32 { let first = |item| item.pair.0; first(Item { pair: (7, true) }) }",
        "struct Item { value: i32 } fn f() -> i32 { let first = |pair| pair.0.value; first((Item { value: 7 }, true)) }",
        "fn f() -> i32 { let first = |pair| pair.0.unwrap_or(0); first((Option::Some(7), true)) }",
        "fn f() -> i32 { let first = |pair| pair.0[0]; first(([7], true)) }",
        "fn f() -> i32 { let first = |pair| { pair.0 = 8; pair.0 }; first((7, true)) }",
    ] {
        if !checked_diagnostics(source).is_empty() {
            testing::fail(source)
        }
    }
}

#[test]
fn tuple_projection_validates_final_receiver_and_result() -> () {
    for source in[
        "fn f() -> () { let first = |pair| pair.0; let _ = first(true); }",
        "fn f() -> () { let first = |pair| pair.2; let _ = first((1, true)); }",
        "struct Pair(i32); fn f() -> () { let first = |pair| pair.1; let _ = first(Pair(7)); }",
        "fn f() -> bool { let first = |pair| pair.0; first((7, true)) }",
        "fn f() -> () { let first = |pair| pair.0; }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "fn f(xs: Slice[((i32, i32), bool)]) -> () { let write = |xs| { (xs[0].0).0 = 2; }; write(xs); }",
            ),
            "Slice is read-only",
        ),
    );
}
