package checker;

use std::testing;

#[test]
fn inferred_pattern_refutability_accepts_final_inhabitation() -> () {
    let _ = checked_file(
        "fn main() -> () { let f = |value| { let Option::None = value; true }; let n:Option[never]=Option::None; let _ = f(n); }",
    );
    let _ = checked_file(
        "fn main() -> () { let f = |value| { for Option::None in [value] {} }; let n:Option[never]=Option::None; f(n); }",
    );
    let _ = checked_file(
        "fn f(value:Option[never]) -> () { for Option::None in [value] {} } fn main() -> () { f(Option::None); }",
    );
    let _ = checked_file(
        "fn main() -> () { let f = |value| { let 0..=255 = value; true }; let n:u8=2; let _ = f(n); }",
    );
    let _ = checked_file(
        "fn main() -> () { let f = |value| { let Option::None = value else { return false; }; true }; let n:Option[bool]=Option::None; let _ = f(n); }",
    );
    let _ = checked_file(
        "fn main() -> () { let f = |value| { let 0..=255 = value else { return false; }; true }; let n:u16=2; let _ = f(n); }",
    );
}

#[test]
fn inferred_pattern_refutability_rejects_invalid_bindings() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "fn main() -> () { let f = |value| { let Option::None = value else { return false; }; true }; let n:Option[never]=Option::None; println(f(n)); }",
            ),
            "`let else` requires a refutable pattern",
        ),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "fn main() -> () { let f = |value| { let 0..=255 = value else { return false; }; true }; let n:u8=2; let _ = f(n); }",
            ),
            "`let else` requires a refutable pattern",
        ),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "fn main() -> () { let f = |value| { let Option::None = value; true }; let n:Option[bool]=Option::None; let _ = f(n); }",
            ),
            "Refutable pattern is not allowed in let binding",
        ),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "fn main() -> () { let f = |value| { for Option::None in [value] {} }; let n:Option[bool]=Option::None; f(n); }",
            ),
            "Refutable pattern is not allowed in for loop",
        ),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "fn main() -> () { let f = |value| { let 0..=255 = value; true }; let n:u16=2; let _ = f(n); }",
            ),
            "Refutable pattern is not allowed in let binding",
        ),
    );
}
