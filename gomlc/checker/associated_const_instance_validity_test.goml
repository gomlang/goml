package checker;

use std::testing;

#[test]
fn trait_instances_validate_associated_type_constant_lengths() -> () {
    for item in["[i32; N - 1]", "[i32; N / 0]", "Vec[[i32; N - 1]]", "Option[[i32; N - 1]]"] {
        let source = "trait Source { type Item; } struct Wrap[const N: usize] {} impl[const N: usize] Source for Wrap[N] { type Item = "
            + item
            + "; } fn accept[T: Source](value: T) -> () {} fn main() -> () { let value: Wrap[0] = Wrap {}; accept(value); }";
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "No instance found for trait Source",
            ),
        );
    }
}

#[test]
fn trait_instances_validate_associated_nominal_constant_requirements() -> () {
    for call in["accept(value)", "let callback = accept::[Wrap[0]]; callback(value)"] {
        let source = "trait Source { type Item; } struct Buffer[const N: usize] { items: [i32; N - 1] } struct Wrap[const N: usize] {} impl[const N: usize] Source for Wrap[N] { type Item = Buffer[N]; } fn accept[T: Source](value: T) -> () {} fn main() -> () { let value: Wrap[0] = Wrap {}; "
            + call
            + "; }";
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "No instance found for trait Source",
            ),
        );
    }
}

#[test]
fn valid_and_symbolic_associated_const_instances_remain_available() -> () {
    for tail in[
        "fn main() -> () { let value: Wrap[2] = Wrap {}; accept(value); }",
        "fn main() -> () { let value: Wrap[1] = Wrap {}; let callback = accept::[Wrap[1]]; callback(value); }",
        "fn generic[const N: usize](value: Wrap[N]) -> () { accept(value); }",
    ] {
        let _ = checked_file(
            "trait Source { type Item; } struct Wrap[const N: usize] {} impl[const N: usize] Source for Wrap[N] { type Item = [i32; N - 1]; } fn accept[T: Source](value: T) -> () {} "
                + tail,
        );
    }
}
