package checker;

use std::testing;

#[test]
fn expected_dyn_results_filter_method_candidates() -> () {
    for types in[
        ("dyn Read[i32]", "dyn Read[bool]"),
        ("dyn Item[Value = i32]", "dyn Item[Value = bool]"),
        ("dyn Mark + Read[i32]", "dyn Mark + Read[bool]"),
        ("dyn Read[i32] + Mark", "dyn Read[i32]"),
        ("dyn Mark + Item[Value = i32]", "dyn Mark + Item[Value = bool]"),
    ] {
        let source = "trait Read[T] {} trait Item { type Value; } trait Mark {} trait First { fn make(self: Self) -> "
            + types.0
            + "; } trait Second { fn make(self: Self) -> "
            + types.1
            + "; } impl First for bool { fn make(self: bool) -> "
            + types.0
            + " { loop {} } } impl Second for bool { fn make(self: bool) -> "
            + types.1
            + " { loop {} } } fn choose(value: bool) -> "
            + types.0
            + " { value.make() }";
        let diagnostics = checked_diagnostics(source);
        if !diagnostics.is_empty() {
            testing::fail(source)
        }
    }
}

#[test]
fn dyn_result_candidates_stay_ambiguous_without_context() -> () {
    let source = "trait Read[T] {} trait First { fn make(self: Self) -> dyn Read[i32]; } trait Second { fn make(self: Self) -> dyn Read[bool]; } impl First for bool { fn make(self: bool) -> dyn Read[i32] { loop {} } } impl Second for bool { fn make(self: bool) -> dyn Read[bool] { loop {} } } fn run() -> () { let value = true.make(); }";
    testing::assert(has_diagnostic_containing(checked_diagnostics(source), "ambiguous method"));
}
