package checker;

use module::tast::{Type, TypePredicate};

fn projection_resolution_context(ctx: Checker, predicates: Vec[TypePredicate]) -> Checker {
    let assumptions: Vec[TypePredicate] = Vec::new();
    for predicate in ctx.predicates {
        assumptions.push(predicate)
    }
    for predicate in predicates {
        assumptions.push(predicate)
    }
    for alias in ctx.param_aliases {
        assumptions.push(
            TypePredicate::Equality { lhs: Type::Param { name: alias.name }, rhs: alias.ty },
        )
    }
    for alias in ctx.projection_aliases {
        assumptions.push(TypePredicate::Equality { lhs: alias.projection, rhs: alias.ty })
    }
    let aliases = predicate_equality_aliases(assumptions);
    Checker {
        predicates: assumptions,
        param_aliases: aliases.0,
        projection_aliases: aliases.1,
        normalizing_types: Vec::new(),
        ..ctx,
    }
}
