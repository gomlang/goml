package checker;

use module::ast;
use module::hir;
use module::parser;
use std::testing;

#[test]
fn duplicate_traits_cannot_replace_required_members() -> () {
    for source in[
        "trait Same {} trait Same {}",
        "trait Same { fn value(self) -> bool; } trait Same {} impl Same for bool {}",
        "trait Same {} trait Same { fn value(self) -> bool; } impl Same for bool {}",
        "trait Same { type Item; } trait Same {} impl Same for bool {}",
        "trait Same[T] {} trait Same {}",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "trait Same is defined multiple times",
            ),
        );
    }
}

#[test]
fn duplicate_traits_across_package_files_are_rejected() -> () {
    let parsed = Vec::from_array(
        [
            parser::parse("package values; trait Same { fn value(self) -> bool; }"),
            parser::parse("package values; trait Same {} impl Same for bool {}"),
        ],
    );
    let ast_files = ast::lower_package(parsed);
    let inputs: Vec[(ast::LowerResult, string)] = Vec::from_array(
        [(ast_files[0], "first.goml"), (ast_files[1], "second.goml")],
    );
    let files: Vec[hir::File] = Vec::new();
    for lowered in hir::lower_package_files(inputs, "example::values") {
        match lowered.hir {
            Some(file) => files.push(file),
            None => testing::fail("expected duplicate trait HIR"),
        }
    }
    let checked = check_package_files_for_link_with_dependencies(files, Vec::new());
    testing::assert(
        has_diagnostic_containing(
            checked.diagnostics,
            "trait example::values::Same is defined multiple times",
        ),
    );
}

#[test]
fn unique_traits_keep_distinct_declaration_namespaces() -> () {
    for source in[
        "trait First {} trait Second {} impl First for bool {} impl Second for bool {}",
        "trait Same {} struct Same {} impl Same for Same {}",
        "trait Same {} const Same: bool = true; impl Same for bool {}",
    ] {
        let _ = checked_file(source);
    }
}
