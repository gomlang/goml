package checker;

use std::testing;

#[test]
fn chained_impl_self_projections_instantiate_declaring_trait_arguments() -> () {
    for source in[
        "trait Other[T] { type Output; } trait Main[T] { type Item: Other[T]; fn get(self) -> Self::Item::Output; } impl Other[i32] for bool { type Output = string; } impl Main[i32] for i32 { type Item = bool; fn get(self) -> Self::Item::Output { \"ok\" } }",
        "trait Other[T] { type Output; } trait Main[T] { type Item: Other[T]; fn get(self) -> i32 where Self::Item::Output = i32; } impl Other[i32] for bool { type Output = i32; } impl Main[i32] for i32 { type Item = bool; fn get(self) -> i32 where Self::Item::Output = i32 { 7 } }",
        "trait Other[T] { type Output; } trait Main[A] { type Item: Other[A]; fn get[U](self, value: U) -> Self::Item::Output; } impl Other[i32] for bool { type Output = i32; } impl Other[string] for bool { type Output = string; } impl Main[i32] for i32 { type Item = bool; fn get[A](self, value: A) -> Self::Item::Output { 42 } }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn chained_impl_self_projections_do_not_capture_method_generic_arguments() -> () {
    testing::assert(
        !checked_diagnostics(
            "trait Other[T] { type Output; } trait Main[A] { type Item: Other[A]; fn get[U](self, value: U) -> Self::Item::Output; } impl Other[i32] for bool { type Output = i32; } impl Other[string] for bool { type Output = string; } impl Main[i32] for i32 { type Item = bool; fn get[A](self, value: A) -> Self::Item::Output { \"wrong\" } }",
        ).is_empty(),
    );
}
