package checker;

use std::testing;

#[test]
fn pointer_aliases_do_not_expose_struct_constructors() -> () {
    for body in[
        "fn main() -> () { let _: Pointer[i32] = Pointer {}; }",
        "type Concrete = Pointer[i32]; fn main() -> () { let _ = Concrete {}; }",
        "fn make[T]() -> T where T = Pointer[i32] { T {} }",
        "fn inspect(value: Pointer[i32]) -> () { let Pointer {} = value; }",
    ] {
        testing::assert(!checked_diagnostics("type Pointer[T] = GoPtr[T]; " + body).is_empty());
    }
    let _ = checked_file(
        "type Pointer[T] = GoPtr[T]; fn identity(value: Pointer[i32]) -> Pointer[i32] { value }",
    );
    let _ = checked_file(
        "struct Cell {} type Alias = Cell; fn main() -> () { let _: Cell = Alias {}; }",
    );
}
