package checker;

use std::testing;

#[test]
fn comptime_methods_distinguish_concrete_trait_applications() -> () {
    let _ = checked_file(
        "trait Label[T] { fn value(self: Self) -> i32; }\nimpl Label[i32] for bool { #[comptime] fn value(self: Self) -> i32 { 7 } }\nimpl Label[bool] for bool { #[comptime] fn value(self: Self) -> i32 { 8 } }\nfn main() -> () {\n    println(Label::[i32]::value(true));\n    println(Label::[bool]::value(true));\n    println(comptime { Label::[i32]::value(true) });\n    println(comptime { Label::[bool]::value(true) });\n}\n",
    );
    let _ = checked_file(
        "trait Label[const N: usize] { fn value(self: Self) -> i32; }\nimpl Label[1] for bool { #[comptime] fn value(self: Self) -> i32 { 7 } }\nimpl Label[2] for bool { #[comptime] fn value(self: Self) -> i32 { 8 } }\nfn main() -> () {\n    println(comptime { Label::[1]::value(true) });\n    println(comptime { Label::[2]::value(true) });\n}\n",
    );
}

#[test]
fn comptime_capability_is_checked_on_the_selected_trait_application() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "trait Label[T] { fn value(self: Self) -> i32; }\nimpl Label[i32] for bool { #[comptime] fn value(self: Self) -> i32 { 7 } }\nimpl Label[bool] for bool { fn value(self: Self) -> i32 { 8 } }\nfn main() -> () { println(comptime { Label::[bool]::value(true) }); }\n",
            ),
            "comptime trait call requires a concrete #[comptime] method",
        ),
    );
}
