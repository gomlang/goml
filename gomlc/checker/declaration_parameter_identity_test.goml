package checker;

use std::testing;

#[test]
fn rejects_duplicate_trait_and_external_signature_parameters() -> () {
    for source in[
        "trait Duplicate { fn choose(self, value: i32, value: bool) -> bool; }",
        "trait Duplicate[T] { fn choose(self, value: T, value: bool) -> bool; }",
        "trait Duplicate { fn choose(value: i32, value: bool) -> bool; }",
        "#[go_ffi(\"example.com/host\", \"Choose\")] extern fn choose(value: i32, value: bool) -> bool;",
    ] {
        if !has_diagnostic_containing(checked_diagnostics(source), "is defined multiple times") {
            testing::fail(source);
        }
    }
}

#[test]
fn accepts_distinct_signature_parameter_names() -> () {
    for source in[
        "trait Accept { fn choose(self, number: i32, flag: bool) -> bool; }",
        "trait Accept { fn choose(_number: i32, _flag: bool) -> bool; }",
        "#[go_ffi(\"example.com/host\", \"Choose\")] extern fn choose(number: i32, flag: bool) -> bool;",
        "#[go_ffi(\"example.com/host\", \"Choose\")] extern fn choose(_number: i32, _flag: bool) -> bool;",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn rejects_same_named_type_and_const_generic_parameters() -> () {
    for source in[
        "struct Box[N, const N: usize] { value: N }",
        "struct Box[const N: usize, N] { value: N }",
        "enum Box[N, const N: usize] { Value(N) }",
        "type Pair[N, const N: usize] = (N, bool);",
        "trait Mixed[N, const N: usize] {}",
        "fn mixed[N, const N: usize]() -> () {}",
        "trait Mixed[N] { fn method[const N: usize]() -> (); }",
        "struct Box[N] { value: N } impl[N] Box[N] { fn method[const N: usize]() -> () {} }",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "type parameter N is defined multiple times",
            ),
        );
    }
}

#[test]
fn accepts_distinct_type_and_const_generic_parameter_names() -> () {
    for source in[
        "struct Box[T, const N: usize] { value: T }",
        "trait Mixed[T, const N: usize] {}",
        "fn mixed[T, const N: usize]() -> () {}",
        "trait Mixed[T] { fn method[const N: usize]() -> (); }",
    ] {
        let _ = checked_file(source);
    }
}
