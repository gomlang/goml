package checker;

use module::diagnostic::{DiagnosticSeverity};
use std::testing;

#[test]
fn never_structural_patterns_give_unreachable_components_bottom_types() -> () {
    for source in[
        "fn f() -> i32 { match (return 7) { (a, b) => { let _ = (a, b); 0 } } }",
        "fn f() -> i32 { match (return 7) { [a, b] => { let _ = (a, b); 0 } } }",
        "fn f() -> i32 { match (return 7) { (a, [b, rest @ ..]) => { let _ = (a, b, rest); 0 } } }",
        "fn f() -> i32 { match (return 7) { (a, _) | (_, a) => { let _ = a; 0 } } }",
        "fn f() -> i32 { for (a, b) in return 7 { let _ = (a, b); } }",
        "fn f() -> i32 { for [a, rest @ ..] in return 7 { let _ = (a, rest); } }",
        "fn f() -> i32 { for (a, b) in return 7 { let _: i32 = a; let _: bool = b; } }",
        "fn f[T](value: T) -> i32 where T = never { match value { (a, b) => { let _ = (a, b); 0 } } }",
        "fn f(value: (i32, bool)) -> i32 { let (a, _) = value; a }",
    ] {
        for diagnostic in checked_diagnostics(source) {
            if let DiagnosticSeverity::Error = diagnostic.severity {
                testing::fail(source + "\n" + diagnostic.message)
            }
        }
    }
}

#[test]
fn never_structural_patterns_preserve_explicit_pattern_and_body_checks() -> () {
    for case in[
        ("fn f(value: (never, bool)) -> (i32, bool) { value }", "Type mismatch"),
        (
            "fn f() -> i32 { match (return 7) { (a, b) => { let value: i32 = true; 0 } } }",
            "Type mismatch",
        ),
        ("fn f() -> i32 { for [a, b] in return 7 { let value: i32 = true; } }", "Type mismatch"),
        ("fn f() -> i32 { match (return 7) { (2..1, _) => 0 } }", "Range pattern lower bound"),
        (
            "enum E { Value(i32) } fn f() -> i32 { match (return 7) { E::Value(value) => { let _: bool = value; 0 } } }",
            "Type mismatch",
        ),
        ("fn f(value: (i32, bool)) -> bool { let (a, _) = value; a }", "Type mismatch"),
    ] {
        if !has_diagnostic_containing(checked_diagnostics(case.0), case.1) {
            testing::fail(case.0 + " expected diagnostic: " + case.1)
        }
    }
}
