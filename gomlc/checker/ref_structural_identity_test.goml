package checker;

use std::testing;

#[test]
fn references_to_structural_values_require_only_identity_traits() -> () {
    for value in["[Point { x: 1 }]", "(Point { x: 1 },)"] {
        let _ = checked_file(
            "struct Point { x: i32 } fn main() -> () { let first = Ref::new(" + value
                + "); let same = first; let other = Ref::new("
                + value
                + "); let _: bool = first == same; let _: bool = first == other; }",
        );
    }
}

#[test]
fn reference_identity_traits_do_not_implement_structural_value_equality() -> () {
    for value in["[Point { x: 1 }]", "(Point { x: 1 },)"] {
        testing::assert(
            !checked_diagnostics(
                "struct Point { x: i32 } fn main() -> () { let first = " + value + "; let second = "
                    + value
                    + "; let _: bool = first == second; }",
            ).is_empty(),
        );
    }
}
