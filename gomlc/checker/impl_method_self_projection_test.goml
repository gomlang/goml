package checker;

use std::testing;

#[test]
fn impl_method_predicates_resolve_self_associated_types() -> () {
    for source in[
        "trait Main { type Item; fn run(self) -> i32 where Self::Item = i32; } impl Main for bool { type Item = i32; fn run(self) -> i32 where Self::Item = i32 { 1 } }",
        "trait Extra {} impl Extra for i32 {} trait Main { type Item; fn run(self) -> i32 where Self::Item: Extra; } impl Main for bool { type Item = i32; fn run(self) -> i32 where Self::Item: Extra { 1 } }",
        "trait Main { type Item; fn run(self, value: Self::Item) -> Self::Item; } impl Main for bool { type Item = i32; fn run(self, value: Self::Item) -> Self::Item { value } }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn impl_method_self_projection_requires_declared_associated_type() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "trait Main { fn run(self) -> i32; } impl Main for bool { fn run(self) -> i32 where Self::Missing = i32 { 1 } }",
            ),
            "is not provided by a trait bound",
        ),
    );
}
