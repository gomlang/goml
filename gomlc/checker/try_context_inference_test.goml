package checker;

use std::testing;

#[test]
fn try_infers_operand_context_without_an_expected_success_type() -> () {
    for source in[
        "fn f() -> Result[isize, string] { let x = Result::Ok(1)?; Ok(x) }",
        "fn f() -> Result[isize, string] { let x = Ok(1)?; Ok(x) }",
        "fn f() -> Option[isize] { let x = Some(1)?; Some(x) }",
        "fn f() -> Option[isize] { let x = Option::Some(1)?; Some(x) }",
        "fn f[E]() -> Result[isize, E] { let x = Result::Ok(1)?; Ok(x) }",
        "type Answer = Result[isize, string]; fn f() -> Answer { let x = Ok(1)?; Ok(x) }",
        "fn f() -> Result[isize, string] { let x = Ok((1, true))?; Ok(x.0) }",
        "fn f() -> Result[isize, string] { let _ = Ok(1)?; Ok(2) }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn try_context_keeps_explicit_operand_and_error_types() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "fn f(value: Result[isize, bool]) -> Result[isize, string] { let x = value?; Ok(x) }",
            ),
            "cannot propagate error type bool as string",
        ),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics("fn f() -> Result[isize, string] { let x: bool = Ok(1)?; Ok(2) }"),
            "Numeric literal cannot be used as bool",
        ),
    );
}
