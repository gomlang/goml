package checker;

use std::testing;

#[test]
fn never_operands_use_surviving_operator_types() -> () {
    for source in[
        "fn value() -> i32 { 1 + (return 2) }",
        "fn value() -> i32 { (return 2) + 1 }",
        "fn value() -> i32 { -(return 2) }",
        "fn value() -> i32 { ~(return 2) }",
        "fn value() -> bool { (return true) == true }",
        "fn value() -> i32 { (return 2) << 1 }",
        "fn value() -> i32 { 1 << (return 2) }",
        "fn value() -> i32 { (return 2) + (return 3) }",
        "fn stop() -> never { loop {} } fn value() -> never { !stop() }",
        "fn stop() -> never { loop {} } fn value() -> never { stop() && true }",
    ] {
        let _ = checked_file(source);
    }
    for source in[
        "fn value() -> bool { false + (return true) }",
        "fn value() -> i32 { (return 2) << 1.5 }",
        "fn value() -> never { false && loop {} }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}
