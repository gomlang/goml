package checker;

use module::tast;

pub fn builtin_metadata() -> Result[tast::BuiltinMetadata, string] {
    tast::builtin_contract()?;
    Ok(
        tast::BuiltinMetadata {
            lang_items: tast::builtin_lang_items()?,
            traits: builtin_source_traits.get_or_init(|| load_builtin_source_traits()).to_vec(),
            enums: builtin_source_enums.get_or_init(|| load_builtin_source_enums()).to_vec(),
            structs: builtin_source_structs.get_or_init(|| load_builtin_source_structs()).to_vec(),
            functions: builtin_source_functions.get_or_init(|| load_builtin_source_functions()).to_vec(),
            arities: builtin_source_arities.get_or_init(|| load_builtin_source_arities()).to_vec(),
            impls: builtin_source_impls.get_or_init(|| load_builtin_source_impls()).to_vec(),
            inherent_methods: tast::builtin_inherent_methods(),
        },
    )
}

pub fn install_builtin_metadata(value: tast::BuiltinMetadata) -> Result[(), string] {
    tast::install_builtin_metadata(value)?;
    let _ = builtin_source_traits.get_or_init(|| value.traits.freeze());
    let _ = builtin_source_enums.get_or_init(|| value.enums.freeze());
    let _ = builtin_source_structs.get_or_init(|| value.structs.freeze());
    let _ = builtin_source_functions.get_or_init(|| value.functions.freeze());
    let _ = builtin_source_arities.get_or_init(|| value.arities.freeze());
    let _ = builtin_source_impls.get_or_init(|| value.impls.freeze());
    Ok(())
}
