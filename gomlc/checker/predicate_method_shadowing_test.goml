package checker;

use std::testing;

#[test]
fn constrained_methods_prefer_redeclaring_child_traits() -> () {
    for bounds in["Child", "Child + Parent", "Parent + Child"] {
        let _ = checked_file(
            "trait Parent { fn read(self) -> i32; } trait Child: Parent { fn read(self) -> i32; } fn read[T: "
                + bounds
                + "](value: T) -> i32 { value.read() }",
        );
    }
    for source in[
        "trait Parent { fn read(self) -> i32; } trait Child: Parent { fn read(self) -> i32; } fn read[T: Child](value: T) -> i32 { let read = T::read; read(value) }",
        "trait Parent[T] { fn read(self, value: T) -> bool; } trait Child: Parent[Self] { fn read(self, value: Self) -> bool; } fn read[T: Child](value: T) -> bool { value.read(value) }",
        "trait Parent { fn read(self) -> i32; } trait Left: Parent { fn read(self) -> i32; } trait Right: Parent {} trait Top: Left + Right {} fn read[T: Top](value: T) -> i32 { value.read() }",
        "trait Parent { fn read(self) -> i32; } trait Child: Parent { fn read(self) -> bool; } fn read[T: Child](value: T) -> i32 { Parent::read(value) }",
        "trait Parent { fn read(self) -> i32; } trait Left: Parent { fn read(self) -> i32; } trait Right: Parent {} trait Top: Left + Right {} fn read[T: Top](value: T) -> i32 { Top::read(value) }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn constrained_shadowing_does_not_fall_back_to_matching_parent_signatures() -> () {
    for source in[
        "trait Parent { fn read(self) -> i32; } trait Child: Parent { fn read(self) -> bool; } fn read[T: Child](value: T) -> i32 { value.read() }",
        "trait Parent { fn read(self, value: i32) -> i32; } trait Child: Parent { fn read(self) -> i32; } fn read[T: Child](value: T) -> i32 { value.read(1) }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "trait Left { fn read(self) -> i32; } trait Right { fn read(self) -> i32; } fn read[T: Left + Right](value: T) -> i32 { value.read() }",
            ),
            "Ambiguous method read",
        ),
    );
}
