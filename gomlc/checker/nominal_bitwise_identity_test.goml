package checker;

use std::testing;

#[test]
fn nominal_const_requirements_canonicalize_bitwise_identity_recursion() -> () {
    for expression in["N | 0", "0 | N", "N ^ 0", "0 ^ N", "N & -1", "-1 & N", "N << 0", "N >> 0"] {
        let _ = checked_file(
            "enum Chain[const N: usize] { End, Next(Chain[{" + expression
                + "}]), Values([i32; N]) } fn valid(value: Chain[1]) -> () {}",
        );
    }
}

#[test]
fn nominal_const_bitwise_identities_preserve_invalid_operands() -> () {
    for expression in[
        "(N / 0) | 0",
        "0 | (N / 0)",
        "(N / 0) ^ 0",
        "0 ^ (N / 0)",
        "(N / 0) & -1",
        "-1 & (N / 0)",
        "(N / 0) << 0",
        "(N / 0) >> 0",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(
                    "struct Wrap[const N: usize] { values: [i32; " + expression
                        + "] } fn invalid(value: Wrap[1]) -> () {}",
                ),
                "division by zero in constant expression",
            ),
        );
    }
}
