package checker;

use std::testing;

#[test]
fn instantiated_equalities_require_valid_constant_types() -> () {
    for item in[
        ("N - 1", "0", "const usize argument must be nonnegative"),
        ("N / 0", "1", "division by zero"),
        ("N + 1", "9223372036854775807", "integer overflow"),
        ("N << 64", "1", "invalid shift"),
    ] {
        for invocation in["bad::[" + item.1 + "]();", "let value = bad::[" + item.1 + "]; value();"] {
            testing::assert(
                has_diagnostic_containing(
                    checked_diagnostics(
                        "fn bad[const N: usize]() -> () where [i32; " + item.0 + "] = [i32; "
                            + item.0
                            + "] {} fn main() -> () { "
                            + invocation
                            + " }",
                    ),
                    item.2,
                ),
            );
        }
    }
    let _ = checked_file(
        "fn valid[const N: usize]() -> () where [i32; N - 1] = [i32; N - 1] {} fn main() -> () { valid::[1](); }",
    );
}

#[test]
fn instantiated_equalities_validate_nested_nominal_constant_requirements() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "struct Bad[const N: usize] { data: [i32; N - 1] } fn bad[const N: usize]() -> () where Option[Bad[N]] = Option[Bad[N]] {} fn main() -> () { bad::[0](); }",
            ),
            "const usize argument must be nonnegative",
        ),
    );
}

#[test]
fn invalid_constant_equalities_do_not_prove_trait_implementations() -> () {
    let prefix = "trait Marker {} struct Tag[const N: usize] {} impl[const N: usize] Marker for Tag[N] where [i32; N - 1] = [i32; N - 1] {} fn accept[T: Marker](value: T) -> () {} ";
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                prefix + "fn main() -> () { let value: Tag[0] = Tag {}; accept(value); }",
            ),
            "No instance found for trait Marker",
        ),
    );
    let _ = checked_file(prefix + "fn main() -> () { let value: Tag[1] = Tag {}; accept(value); }");
}
