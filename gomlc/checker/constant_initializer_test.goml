package checker;

use std::testing;

#[test]
fn associated_constants_reject_runtime_comparison_implementations() -> () {
    let implementation = "struct Value {} impl PartialEq for Value { fn eq(self: Self, other: Self) -> bool { println(\"runtime effect\"); true } } ";
    for definition in[
        "struct Constants {} impl Constants { const SAME: bool = Value {} == Value {}; }",
        "trait Constants { const SAME: bool = Value {} == Value {}; }",
        "trait Constants { const SAME: bool; } struct Holder {} impl Constants for Holder { const SAME: bool = Value {} == Value {}; }",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(implementation + definition),
                "associated constant comparison requires builtin equality",
            ),
        )
    }
}

#[test]
fn associated_constants_resolve_only_constant_value_paths() -> () {
    for source in[
        "static CELL: OnceCell[i32] = OnceCell::new(); struct Holder {} impl Holder { const VALUE: OnceCell[i32] = CELL; }",
        "type Cell = OnceCell[i32]; static CELL: Cell = OnceCell::new(); struct Holder {} impl Holder { const VALUE: Cell = CELL; }",
        "fn read() -> i32 { 7 } struct Holder {} impl Holder { const VALUE: () -> i32 = read; }",
        "enum Value { Item(i32) } struct Holder {} impl Holder { const VALUE: (i32) -> Value = Value::Item; }",
    ] {
        let diagnostics = checked_diagnostics(source);
        if !has_diagnostic_containing(diagnostics, "associated constant initializer") {
            let messages = Vec::from_array([source]);
            for diagnostic in diagnostics {
                messages.push(diagnostic.message)
            }
            testing::fail(messages.join("\n"))
        }
    }
}

#[test]
fn associated_constants_keep_builtin_comparisons_and_composite_construction() -> () {
    for source in[
        "struct Holder {} impl Holder { const SAME: bool = 3 == 3; const LESS: bool = 2.0 < 3.0; const WORD: bool = \"a\" < \"b\"; const ARRAY: bool = [1, 2] == [1, 2]; const TUPLE: bool = (1, true) == (1, true); }",
        "struct Pair { first: i32, second: i32 } const BASE: Pair = Pair { first: 1, second: 2 }; struct Holder {} impl Holder { const VALUE: Pair = Pair { first: 3, ..BASE }; const ITEMS: [i32; 2] = [7; 2]; }",
        "struct Holder[const N: usize] {} impl[const N: usize] Holder[N] { const SAME: bool = N == 2; const ITEMS: [usize; N] = [N; N]; }",
    ] {
        for diagnostic in checked_diagnostics(source) {
            testing::fail(diagnostic.message)
        }
    }
}

fn generic_constant_comparison_source() -> string {
    "trait Source: PartialEq { const VALUE: Self; } impl Source for i32 { const VALUE: Self = 7; } struct Bad {} impl PartialEq for Bad { fn eq(self: Self, other: Self) -> bool { println(\"runtime effect\"); true } } impl Source for Bad { const VALUE: Self = Bad {}; } struct Holder[T] {} impl[T: Source] Holder[T] { const SAME: bool = T::VALUE == T::VALUE; } fn forwarded[T: Source]() -> bool { Holder::[T]::SAME } "
}

#[test]
fn generic_constant_comparisons_validate_actual_operator_types() -> () {
    for access in["Holder::[Bad]::SAME", "forwarded::[Bad]()", "{ let f = forwarded::[Bad]; f() }"] {
        let source = generic_constant_comparison_source() + "fn main() -> () { let _value = "
            + access
            + "; }";
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "associated constant comparison requires builtin equality",
            ),
        )
    }
    for access in["Holder::[i32]::SAME", "forwarded::[i32]()", "{ let f = forwarded::[i32]; f() }"] {
        let source = generic_constant_comparison_source() + "fn main() -> () { let _value = "
            + access
            + "; }";
        for diagnostic in checked_diagnostics(source) {
            testing::fail(diagnostic.message)
        }
    }
}

#[test]
fn constant_comparison_default_requirements_apply_only_when_used() -> () {
    let source = "trait Source: PartialEq { const VALUE: Self; const SAME: bool = Self::VALUE == Self::VALUE; } struct Bad {} impl PartialEq for Bad { fn eq(self: Self, other: Self) -> bool { println(\"runtime effect\"); true } } ";
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(source + "impl Source for Bad { const VALUE: Self = Bad {}; }"),
            "associated constant comparison requires builtin equality",
        ),
    );
    for tail in[
        "impl Source for i32 { const VALUE: Self = 7; }",
        "impl Source for Bad { const VALUE: Self = Bad {}; const SAME: bool = true; }",
    ] {
        for diagnostic in checked_diagnostics(source + tail) {
            testing::fail(diagnostic.message)
        }
    }
}

#[test]
fn recursive_generic_constant_comparisons_keep_finite_requirements() -> () {
    let source = "trait Source: PartialEq { const VALUE: Self; } impl[A: Source, B: Source] Source for (A, B) { const VALUE: Self = (A::VALUE, B::VALUE); } struct Holder[T] {} impl[T: Source] Holder[T] { const SAME: bool = T::VALUE == T::VALUE; } fn grow[T: Source]() -> () { let _value = Holder::[T]::SAME; grow::[(T, T)](); }";
    for diagnostic in checked_diagnostics(source) {
        testing::fail(diagnostic.message)
    }
}
