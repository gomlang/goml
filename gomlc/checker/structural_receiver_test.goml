package checker;

use std::testing;

#[test]
fn structural_receivers_resolve_trait_methods_and_alias_values() -> () {
    for source in[
        "trait Read { fn read(self: Self) -> i32; } impl Read for () -> i32 { fn read(self: () -> i32) -> i32 { self() } } fn f(value: () -> i32) -> i32 { value.read() }",
        "trait Read { type Item; fn read(self: Self) -> Self::Item; } impl[T] Read for () -> T { type Item = T; fn read(self: () -> T) -> T { self() } } fn f(value: () -> i32) -> i32 { value.read() }",
        "trait Read { type Item; fn read(self: Self) -> Self::Item; } impl[T] Read for (T, bool) { type Item = T; fn read(self: (T, bool)) -> T { self.0 } } fn f(value: (i32, bool)) -> i32 { value.read() }",
        "trait Read { fn read(self: Self) -> i32; } impl Read for (i32, bool) { fn read(self: (i32, bool)) -> i32 { self.0 } } type Pair = (i32, bool); fn f(value: Pair) -> i32 { let read = Pair::read; read(value) + Pair::read(value) }",
        "trait Read { fn read(self: Self) -> i32; } impl Read for () -> i32 { fn read(self: () -> i32) -> i32 { self() } } type Action = () -> i32; fn f(value: Action) -> i32 { let read = Action::read; read(value) + Action::read(value) }",
        "trait Read { fn read(self: Self) -> i32; } impl Read for () { fn read(self: ()) -> i32 { 1 } } impl Read for [i32; 2] { fn read(self: [i32; 2]) -> i32 { self[0] } } fn f(value: [i32; 2]) -> i32 { ().read() + value.read() }",
        "trait First { fn read(self: Self) -> i32; } trait Second { fn read(self: Self) -> string; } impl First for (i32, bool) { fn read(self: (i32, bool)) -> i32 { self.0 } } impl Second for (i32, bool) { fn read(self: (i32, bool)) -> string { \"second\" } } fn f(value: (i32, bool)) -> i32 { value.read() }",
    ] {
        let diagnostics = checked_diagnostics(source);
        if !diagnostics.is_empty() {
            testing::fail(source)
        }
    }
}

#[test]
fn structural_receiver_filtering_preserves_signature_checks_and_ambiguity() -> () {
    for source in[
        "trait Read { fn read(self: Self) -> i32; } impl Read for () -> i32 { fn read(self: () -> i32) -> i32 { self() } } fn f(value: () -> bool) -> i32 { value.read() }",
        "trait Read { fn read(self: Self) -> i32; } impl Read for () -> i32 { fn read(self: () -> i32) -> i32 { self() } } fn f(value: () -> never) -> i32 { value.read() }",
        "trait Read { fn read(self: Self) -> i32; } impl Read for (i32, bool) { fn read(self: (i32, bool)) -> i32 { self.0 } } fn f(value: (bool, bool)) -> i32 { value.read() }",
        "trait Read { fn read(self: Self) -> i32; } impl Read for (i32, bool) { fn read(self: (i32, bool)) -> i32 { self.0 } } fn f(value: (i32, bool, bool)) -> i32 { value.read() }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty())
    }
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "trait First { fn read(self: Self) -> i32; } trait Second { fn read(self: Self) -> i32; } impl First for (i32, bool) { fn read(self: (i32, bool)) -> i32 { self.0 } } impl Second for (i32, bool) { fn read(self: (i32, bool)) -> i32 { 9 } } fn f(value: (i32, bool)) -> i32 { value.read() }",
            ),
            "ambiguous method",
        ),
    );
}
