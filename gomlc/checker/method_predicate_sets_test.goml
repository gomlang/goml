package checker;

use std::testing;

#[test]
fn method_predicates_compare_as_sets_after_trait_substitution() -> () {
    for source in[
        "trait Convert[A, B] { fn convert[T](self: Self, value: T) -> T where T = A, T = B; } struct Thing {} impl Convert[i32, i32] for Thing { fn convert[U](self: Thing, value: U) -> U where U = i32 { value } } fn main() -> () { let _: i32 = Thing {}.convert(7); }",
        "trait Mark[A] {} impl Mark[bool] for i32 {} trait Convert[A, B] { fn convert[T: Mark[A] + Mark[B]](self: Self, value: T) -> T; } struct Thing {} impl Convert[bool, bool] for Thing { fn convert[U: Mark[bool]](self: Thing, value: U) -> U { value } } fn main() -> () { let _: i32 = Thing {}.convert(7); }",
    ] {
        let _ = checked_file(source);
    }
    for source in[
        "trait Mark[A] {} trait Other {} trait Convert[A, B] { fn convert[T: Mark[A] + Mark[B]](self: Self, value: T) -> T; } struct Thing {} impl Convert[bool, bool] for Thing { fn convert[U: Mark[bool] + Other](self: Thing, value: U) -> U { value } }",
        "trait Mark[A] {} trait Convert[A, B] { fn convert[T: Mark[A] + Mark[B]](self: Self, value: T) -> T; } struct Thing {} impl Convert[bool, i32] for Thing { fn convert[U: Mark[bool]](self: Thing, value: U) -> U { value } }",
        "trait Mark[A] {} trait Convert[A, B] { fn convert[T: Mark[A] + Mark[B]](self: Self, value: T) -> T; } struct Thing {} impl Convert[bool, bool] for Thing { fn convert[U: Mark[i32]](self: Thing, value: U) -> U { value } }",
    ] {
        testing::assert(
            has_diagnostic(
                checked_diagnostics(source),
                "Trait Convert::convert method bounds do not match the trait declaration",
            ),
        );
    }
}
