package checker;

use std::testing;

#[test]
fn indexing_preserves_divergence_of_evaluated_operands() -> () {
    for source in[
        "fn stop() -> never { loop {} } fn f(values: Vec[i32]) -> i32 { values[stop()]; }",
        "fn stop() -> never { loop {} } fn f(values: Vec[i32]) -> never { values[stop()] }",
        "fn stop() -> never { loop {} } fn f() -> never { stop()[0] }",
        "fn stop() -> never { loop {} } fn f() -> never { stop()[false] }",
        "fn f[T](values: [bool; 2], exit: T) -> never where T = never { values[exit] }",
        "fn f[T](exit: T) -> never where T = never { exit[0] }",
        "fn f(values: Vec[i32]) -> i32 { values[return 7]; }",
        "fn f() -> i32 { (return 8)[0]; }",
        "fn stop() -> never { loop {} } fn f(value: string) -> never { value[stop()] }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn returning_indexes_keep_element_and_index_constraints() -> () {
    for source in[
        "fn f(values: Vec[i32]) -> never { values[0] }",
        "fn f(values: Vec[i32]) -> i32 { values[false] }",
        "fn f() -> i32 { false[0] }",
        "fn stop() -> never { loop {} } fn f() -> never { stop()[missing] }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}
