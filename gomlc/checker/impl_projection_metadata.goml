package checker;

use module::tast::{TraitRef, Type, TypePredicate, TypeSubst, substitute_type};

fn resolve_impl_associated_type(
    ctx: Checker,
    value: Type,
    owner: Type,
    reference: Option[TraitRef],
    predicates: Vec[TypePredicate],
    report: bool,
) -> Type {
    let self_ty = Type::Param { name: "Self" };
    let scope = match reference {
        Some(trait_ref) => append_predicates(
            predicates,
            Vec::from_array([TypePredicate::Trait { for_ty: self_ty, trait_ref }]),
        ),
        None => predicates,
    };
    let qualified = qualify_impl_signature_type(ctx, value, Some(self_ty), reference);
    let resolved = resolve_signature_type(ctx, qualified, scope, report);
    substitute_type(resolved, Vec::from_array([TypeSubst { name: "Self", ty: owner }]))
}
