package checker;

use std::testing;

#[test]
fn dyn_numeric_inference_waits_for_later_type_context() -> () {
    for source in[
        "trait Tag {} impl Tag for i32 {} impl Tag for isize {} fn need(value: i32) {} fn f() { let value = 1; let object = value as dyn Tag; need(value); }",
        "trait Tag {} impl Tag for f32 {} impl Tag for f64 {} fn need(value: f32) {} fn f() { let value = 1.0; let object = value as dyn Tag; need(value); }",
        "trait Tag {} impl Tag for i32 {} impl Tag for i64 {} fn need(value: i32) {} fn f() { let value = 1; let object = value as dyn Tag; need(value); }",
        "trait Tag {} impl Tag for i32 {} impl Tag for isize {} fn f() -> i32 { let value = 1; let object = value as dyn Tag; value }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn dyn_numeric_inference_checks_final_type_and_literal_range() -> () {
    testing::assert(
        !checked_diagnostics(
            "trait Tag {} impl Tag for isize {} fn need(value: i32) {} fn f() { let value = 1; let object = value as dyn Tag; need(value); }",
        ).is_empty(),
    );
    testing::assert(
        !checked_diagnostics(
            "trait Tag {} impl Tag for u8 {} impl Tag for isize {} fn need(value: u8) {} fn f() { let value = 256; let object = value as dyn Tag; need(value); }",
        ).is_empty(),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "trait Tag {} impl Tag for i32 {} impl Tag for i64 {} fn f() { let value = 1; let object = value as dyn Tag; }",
            ),
            "Ambiguous numeric type for dyn conversion",
        ),
    );
}
