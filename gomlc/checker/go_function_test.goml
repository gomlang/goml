package checker;

use std::testing;
use module::tast::{Type, VarKind, builtin_contract};

#[test]
fn raw_function_signatures_are_checked_inside_all_dyn_bounds() -> () {
    let ctx = collect_environment(
        dependency_hir(
            "package audit; trait Consumer[A, B] {} trait Source { type First; type Item; } trait Display {} fn main() -> () {}",
            "audit",
        ),
        false,
        testing::expect_ok(builtin_contract(), "expected builtin contract"),
    );
    let variable = fresh_type(ctx.inference.counter, VarKind::Any);
    let callback = Type::GoFunction {
        signature: Type::Func { params: Vec::from_array([variable]), ret_ty: Type::Unit },
    };
    let wrappers = occurs_test_dyn_types(callback);
    for wrapper in wrappers {
        testing::assert(invalid_go_function_signature(ctx, wrapper).is_none());
    }
    testing::assert(unify(variable, Type::VecType { elem: Type::Int32 }));
    for wrapper in wrappers {
        testing::assert(invalid_go_function_signature(ctx, wrapper).is_some());
    }
    let valid = Type::GoFunction {
        signature: Type::Func { params: Vec::from_array([Type::Int32]), ret_ty: Type::Unit },
    };
    for wrapper in occurs_test_dyn_types(valid) {
        testing::assert(invalid_go_function_signature(ctx, wrapper).is_none());
    }
}
