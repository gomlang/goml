package checker;

use std::testing;

#[test]
fn indirect_calls_propagate_expected_returns_before_checking_arguments() -> () {
    let prefix = "fn identity[T](value: T) -> T { value } fn maker[T]() -> (T) -> T { identity } struct Factory {} impl Factory { fn identity[T](value: T) -> T { value } } enum Wrapped[T] { Item(T) } struct Handler[T] { call: (T) -> T } ";
    for body in[
        "let value: Option[i32] = maker()(Some(7));",
        "let function = identity; let value: Option[i32] = function(Some(7));",
        "let function = Factory::identity; let value: Option[i32] = function(Some(7));",
        "let function = Wrapped::Item; let value: Wrapped[Option[i32]] = function(Some(7));",
        "let handler = Handler { call: identity }; let value: Option[i32] = handler.call(Some(7));",
        "let value: Option[i32] = (if true { identity } else { identity })(Some(7));",
        "let value: Option[i32] = ({ identity })(Some(7));",
        "let function = |value| value; let value: Option[i32] = function(Some(7));",
    ] {
        if !checked_diagnostics(prefix + "fn f() -> () { " + body + " }").is_empty() {
            testing::fail(body)
        }
    }
}

#[test]
fn indirect_call_context_preserves_argument_checks_and_monomorphism() -> () {
    let prefix = "fn identity[T](value: T) -> T { value } fn maker[T]() -> (T) -> T { identity } ";
    for body in[
        "let value: Option[bool] = maker()(Some(7));",
        "let function = identity; let value: Option[i32] = function(true);",
        "let function = identity; let value: Option[i32] = function(Some(7), true);",
        "let function = |value| value; let _: Option[i32] = function(Some(7)); let _: Option[bool] = function(Some(true));",
    ] {
        testing::assert(!checked_diagnostics(prefix + "fn f() -> () { " + body + " }").is_empty());
    }
}

#[test]
fn resolved_method_calls_propagate_expected_return_context() -> () {
    let prefix = "struct Service {} impl Service { fn identity[T](self: Service, value: T) -> T { value } } ";
    let _ = checked_file(prefix + "fn f() -> Option[i32] { Service {}.identity(Some(7)) }");
    testing::assert(
        !checked_diagnostics(prefix + "fn f() -> Option[bool] { Service {}.identity(Some(7)) }").is_empty(),
    );
    let overloads = "struct Service {} trait Number { fn choose(self: Self, value: Option[i32]) -> i32; } trait Flag { fn choose(self: Self, value: Option[bool]) -> bool; } impl Number for Service { fn choose(self: Service, value: Option[i32]) -> i32 { value.unwrap_or(0) } } impl Flag for Service { fn choose(self: Service, value: Option[bool]) -> bool { value.unwrap_or(false) } } ";
    let _ = checked_file(overloads + "fn f() -> i32 { Service {}.choose(Some(7)) }");
    let _ = checked_file(overloads + "fn f() -> i32 { Number::choose(Service {}, Some(7)) }");
    let _ = checked_file(overloads + "fn f() -> bool { Service {}.choose(Some(true)) }");
    testing::assert(
        !checked_diagnostics(overloads + "fn f() -> bool { Service {}.choose(Some(7)) }").is_empty(),
    );
}
