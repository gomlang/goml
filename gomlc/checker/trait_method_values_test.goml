package checker;

#[test]
fn trait_method_values_accept_dynamic_and_bound_receiver_types() -> () {
    for source in[
        "trait Count { fn count(self: Self) -> usize; } struct Thing {} impl Count for Thing { fn count(self: Thing) -> usize { 7 } } fn main() -> () { let value: dyn Count = Thing {} as dyn Count; let f: (dyn Count) -> usize = Count::count; let _ = f(value); }",
        "trait Count { fn count(self: Self) -> usize; } trait Child: Count {} struct Thing {} impl Count for Thing { fn count(self: Thing) -> usize { 7 } } impl Child for Thing {} fn main() -> () { let value: dyn Child = Thing {} as dyn Child; let f = Count::count; let _ = f(value); }",
        "trait Count { fn count(self: Self) -> usize; } fn apply[T: Count](value: T) -> usize { let f: (T) -> usize = Count::count; f(value) }",
    ] {
        let _ = checked_file(source);
    }
}
