package checker;

use std::testing;

#[test]
fn trait_and_impl_generics_cannot_shadow_implicit_self() -> () {
    for source in[
        "trait Main[Self] {}",
        "trait Main[const Self: usize] {}",
        "trait Main { fn run[Self](self) -> (); }",
        "trait Main { fn run[const Self: usize](self) -> (); }",
        "struct Box[T] { value: T } impl[Self] Box[Self] {}",
        "impl bool { fn run[Self](self) -> () {} }",
        "impl bool { fn run[const Self: usize](self) -> () {} }",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "type parameter Self is defined multiple times",
            ),
        );
    }
}

#[test]
fn ordinary_generics_and_compiler_generated_default_self_remain_valid() -> () {
    let _ = checked_file(
        "trait Main[T] { fn run[U](self, value: U) -> U { value } } impl Main[i32] for bool {} fn main() -> () { let result: i32 = true.run(7); let _ = result; }",
    );
    let _ = checked_file(
        "trait Main[const N: usize] { fn run[const M: usize](self, value: [i32; M]) -> [i32; M] { value } } impl Main[1] for bool {}",
    );
}
