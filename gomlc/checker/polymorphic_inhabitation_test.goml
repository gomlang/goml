package checker;

use std::testing;
use module::tast::{Type, builtin_contract, types_equal};

#[test]
fn growing_recursive_type_arguments_preserve_uninhabitedness() -> () {
    for source in[
        "enum Endless[T] { Next(Endless[Vec[T]]) } fn absurd[Unused](value: Endless[i32]) -> bool { match value {} }",
        "enum Endless[T] { Next(Endless[(T, T)]) } fn absurd[Unused](value: Endless[bool]) -> bool { match value {} }",
        "enum Maybe[T] { Done(T), Next(Maybe[(T, T)]) } fn absurd[Unused](value: Maybe[never]) -> bool { match value {} }",
        "enum Endless[T] { Next(Endless[Vec[T]]) } struct Wrapper[T] { value: Endless[T] } fn absurd[Unused](value: Wrapper[i32]) -> bool { match value {} }",
        "enum Left[T] { Next(Right[Vec[T]]) } enum Right[T] { Next(Left[(T, T)]) } fn absurd[Unused](value: Left[i32]) -> bool { match value {} }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn recursive_argument_abstraction_preserves_productive_constructors() -> () {
    for source in[
        "enum Maybe[T] { Done(T), Next(Maybe[(T, T)]) } fn invalid(value: Maybe[bool]) -> bool { match value {} }",
        "enum Maybe[T] { Done(T), Next(Maybe[Vec[T]]) } fn invalid(value: Maybe[never]) -> bool { match value {} }",
        "enum Maybe[T] { Next(Maybe[Vec[T]]), Done(T) } fn invalid(value: Maybe[never]) -> bool { match value {} }",
        "enum Maybe[T] { Done([T; 0]), Next(Maybe[(T, T)]) } fn invalid(value: Maybe[never]) -> bool { match value {} }",
        "enum Fixed[T, const N: usize] { Done([T; N]) } fn invalid(value: Fixed[never, 0]) -> bool { match value {} }",
    ] {
        testing::assert(
            has_diagnostic_containing(checked_diagnostics(source), "non-exhaustive match"),
        );
    }
    let _ = checked_file(
        "enum Fixed[T, const N: usize] { Done([T; N]) } fn absurd[Unused](value: Fixed[never, 1]) -> bool { match value {} }",
    );
}

#[test]
fn malformed_projection_fields_keep_conservative_inhabitation_keys() -> () {
    for definitions in[
        "trait Source { type Item; } enum E[T] { Done(T::Item), Next(E[Vec[T]]) }",
        "trait Source { type Item; } struct Item[T] { item: T::Item } enum E[T] { Done(Item[T]), Next(E[Vec[T]]) }",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(definitions),
                "is not provided by a trait bound",
            ),
        );
        let ctx = collect_environment(
            dependency_hir("package api; " + definitions, "audit::api"),
            false,
            testing::expect_ok(builtin_contract(), "builtin contract"),
        );
        let actual = Type::App {
            ty: Type::Con { name: "audit::api::E" },
            args: Vec::from_array([Type::Int32]),
        };
        testing::assert(
            types_equal(
                coverage_inhabitation_type(coverage_context(ctx), actual, Vec::new(), 0),
                actual,
            ),
        );
    }
}

#[test]
fn uninhabited_recursive_signatures_typecheck_before_monomorphization() -> () {
    for source in[
        "enum Endless[T] { Next(Endless[Vec[T]]) } fn absurd(value: Endless[i32]) -> bool { match value {} }",
        "enum Endless[T] { Next(Endless[(T, T)]) } fn absurd(value: Endless[bool]) -> bool { match value {} }",
        "enum Maybe[T] { Done(T), Next(Maybe[(T, T)]) } fn absurd(value: Maybe[never]) -> bool { match value {} }",
    ] {
        let _ = checked_file(source);
    }
}
