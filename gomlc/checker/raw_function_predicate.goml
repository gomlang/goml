package checker;

use module::tast::{Type, TypePredicate, foreign_function_bridge, prune, type_is_concrete, types_equal};

fn raw_function_predicate_satisfied(ctx: Checker, signature: Type) -> bool {
    let requirements = Vec::new();
    collect_raw_signature_requirements(ctx, signature, requirements);
    for requirement in requirements {
        let GoFunction { signature } = requirement else {
            return false
        };
        let signature = prune(normalize_type(ctx, signature));
        if type_is_concrete(signature) {
            if foreign_function_bridge(signature, ctx.traits).is_err() {
                return false
            }
        } else {
            let mut found = false;
            for predicate in ctx.predicates {
                if let TypePredicate::GoFunction(bound) = predicate {
                    if types_equal(normalize_type(ctx, bound), signature) {
                        found = true;
                    }
                }
            }
            if !found {
                return false
            }
        }
    }
    true
}

fn collect_function_raw_types(ctx: Checker, value: Type) -> () {
    let requirements = Vec::new();
    collect_type_raw_function_requirements(ctx, value, requirements);
    for requirement in requirements {
        if let GoFunction { signature } = requirement {
            require_predicate(
                ctx,
                TypePredicate::GoFunction(signature),
                "type predicate not satisfied",
            );
        }
    }
}

fn infer_raw_function_predicate(ctx: Checker, signature: Type, predicates: Vec[TypePredicate]) -> () {
    let requirements = Vec::new();
    collect_raw_signature_requirements(ctx, signature, requirements);
    for requirement in requirements {
        if let GoFunction { signature } = requirement {
            if type_contains_any_parameter(signature, ctx.type_params)
                && !contains_unbound_type_variable(signature) {
                let predicate = TypePredicate::GoFunction(signature);
                push_predicate(ctx.predicates, predicate);
                push_predicate(predicates, predicate);
            }
        }
    }
}

fn inferred_boundary_predicate(value: TypePredicate) -> bool {
    match value {
        GoComparable(_) | GoFunction(_) | ConstValid { .. } => true,
        _ => false,
    }
}
