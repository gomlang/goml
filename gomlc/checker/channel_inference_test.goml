package checker;

use module::diagnostic::{DiagnosticSeverity};
use std::testing;

#[test]
fn select_receivers_infer_channel_direction_from_later_calls() -> () {
    for source in[
        "fn f(channel: Receiver[i32]) -> i32 { let poll = |input| select { recv(input) as value => value.unwrap_or(0), default => 0 }; poll(channel) }",
        "fn f(channel: Sender[i32]) -> bool { let poll = |input| select { send(input, 7) => true, default => false }; poll(channel) }",
        "fn f(channel: Channel[i32]) -> bool { let poll = |input| select { send(input, 7) => true, default => false }; poll(channel) }",
        "fn f(channel: Channel[i32]) -> i32 { let poll = |input| select { recv(input) as value => value.unwrap_or(0), default => 0 }; poll(channel) }",
        "fn f(channel: Receiver[string]) -> string { let poll = |input| select { recv(input) as value => value.unwrap_or(\"empty\"), default => \"none\" }; poll(channel) }",
        "fn f(channel: Receiver[i32]) -> bool { let poll = |input| select { recv(input) as _ => true, default => false }; poll(channel) }",
    ] {
        for diagnostic in checked_diagnostics(source) {
            if let DiagnosticSeverity::Error = diagnostic.severity {
                testing::fail(source + "\n" + diagnostic.message);
            }
        }
    }
}

#[test]
fn inferred_select_channels_preserve_direction_and_element_checks() -> () {
    for case in[
        (
            "fn f(channel: Sender[i32]) -> i32 { let poll = |input| select { recv(input) as value => value.unwrap_or(0), default => 0 }; poll(channel) }",
            "Cannot receive from Sender",
        ),
        (
            "fn f(channel: Receiver[i32]) -> bool { let poll = |input| select { send(input, 7) => true, default => false }; poll(channel) }",
            "Cannot send to Receiver",
        ),
        (
            "fn f(channel: Sender[bool]) -> bool { let poll = |input| select { send(input, 7) => true, default => false }; poll(channel) }",
            "Numeric literal cannot be used as bool",
        ),
        (
            "fn f() -> bool { let poll = |input| select { send(input, 7) => true, default => false }; poll(true) }",
            "Type mismatch",
        ),
    ] {
        if !has_diagnostic_containing(checked_diagnostics(case.0), case.1) {
            testing::fail(case.0 + " expected " + case.1);
        }
    }
}
