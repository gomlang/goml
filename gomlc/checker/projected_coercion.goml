package checker;

use module::tast::{Type, for_each_child_type, map_child_types, opaque_parts, types_equal};

fn projected_coercion_children(value: Type) -> Option[Vec[Type]] {
    if opaque_parts(value).is_some() || const_operation_type(value) {
        return None
    }
    if let Projection { .. } = value {
        return None
    }
    let result = Vec::new();
    for_each_child_type(value, |child| result.push(child));
    Some(result)
}

fn infer_projected_coercion(ctx: Checker, actual: Type, expected: Type) -> bool {
    let snapshot = deferred_dependency_snapshot(ctx, Vec::from_array([actual, expected]));
    let actual = normalize_type(ctx, actual);
    let expected = normalize_type(ctx, expected);
    if has_unresolved_projection(actual) || has_unresolved_projection(expected) {
        if types_equal(
            map_child_types(actual, |_| Type::Unit),
            map_child_types(expected, |_| Type::Unit),
        ) {
            if let (Some(actuals), Some(expecteds)) = (
                projected_coercion_children(actual),
                projected_coercion_children(expected),
            ) {
                if actuals.len() == expecteds.len() {
                    for index in 0..actuals.len() {
                        let _ = infer_projected_coercion(ctx, actuals[index], expecteds[index]);
                    }
                }
            }
        }
        snapshot.changed()
    } else if unify(actual, expected) {
        snapshot.changed()
    } else {
        snapshot.restore();
        false
    }
}
