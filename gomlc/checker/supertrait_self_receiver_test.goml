package checker;

use std::testing;

#[test]
fn supertrait_self_arguments_follow_the_bound_receiver() -> () {
    for source in[
        "trait Parent[T] { fn take(self: Self, other: T) -> i32; } trait Child: Parent[Self] {} fn choose[T: Child](value: T) -> i32 { value.take(value) }",
        "trait Parent[T] {} trait Child: Parent[Self] {} fn need[T: Parent[T]](value: T) -> i32 { 7 } fn choose[T: Child](value: T) -> i32 { need(value) }",
        "trait Parent[T] { fn take(self: Self, other: T) -> i32; } trait Middle[T]: Parent[(Self, T)] {} trait Child: Middle[i32] {} fn choose[T: Child](value: T) -> i32 { value.take((value, 7)) }",
        "trait Source { type Item; } trait Parent[T] { fn take(self: Self, value: T) -> i32; } trait Child: Source + Parent[Self::Item] {} fn choose[T: Child](value: T, item: T::Item) -> i32 { value.take(item) }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn dyn_supertrait_arguments_resolve_bound_projections_and_reject_self() -> () {
    let _ = checked_file(
        "trait Source { type Item; } trait Parent[T] { fn take(self: Self, value: T) -> i32; } trait Child: Source + Parent[Self::Item] {} fn choose(value: dyn Child[Item = i32]) -> i32 { value.take(7) }",
    );
    for argument in["Self", "Vec[Self]"] {
        let source = "trait Parent[T] { fn take(self: Self, value: T) -> i32; } trait Child: Parent["
            + argument
            + "] {} fn choose(value: dyn Child) -> () {}";
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "is not dyn-safe: Self is not allowed in supertrait arguments",
            ),
        );
    }
}
