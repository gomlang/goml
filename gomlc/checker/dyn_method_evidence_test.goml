package checker;

use std::testing;

#[test]
fn dyn_calls_use_method_predicates_validated_by_conversion() -> () {
    let prefix = "trait Extra { fn extra(self) -> i32; } trait Main { fn run(self) -> i32 where Self: Extra; } impl Extra for bool { fn extra(self) -> i32 { 7 } } impl Main for bool { fn run(self) -> i32 where Self: Extra { self.extra() } } ";
    for call in["value.run()", "Main::run(value)", "{ let run = Main::run; run(value) }"] {
        let _ = checked_file(
            prefix + " fn call(value: dyn Main) -> i32 { " + call
                + " } fn main() { println(call(true as dyn Main)); }",
        );
    }
    let _ = checked_file(
        "trait Main { fn run(self) -> i32 where Self = bool; } impl Main for bool { fn run(self) -> i32 where Self = bool { 7 } } fn main() { let value = true as dyn Main; println(value.run()); println(Main::run(value)); let run = Main::run; println(run(value)); }",
    );
    let _ = checked_file(
        prefix
            + " trait Child: Main {} impl Child for bool {} fn call(value: dyn Child) -> i32 { value.run() } fn main() { println(call(true as dyn Child)); }",
    );
}

#[test]
fn dyn_method_evidence_does_not_grant_unexposed_traits() -> () {
    let prefix = "trait Extra { fn extra(self) -> i32; } trait Main { fn run(self) -> i32 where Self: Extra; } ";
    for source in[
        "fn call(value: dyn Main) -> i32 { value.extra() }",
        "fn call(value: dyn Main) -> i32 { Extra::extra(value) }",
        "fn need[T: Extra](value: T) {} fn call(value: dyn Main) { value.run(); need(value); }",
        "fn call[T: Main](value: T) -> i32 { value.run() }",
        "impl Main for bool { fn run(self) -> i32 where Self: Extra { self.extra() } } fn main() { let value = true as dyn Main; value.run(); }",
    ] {
        testing::assert(!checked_diagnostics(prefix + source).is_empty());
    }
}
