package checker;

use std::testing;
use std::text;

#[test]
fn comptime_strict_inputs_validate_unreachable_runtime_calls() -> () {
    for expr in["runtime(return 7)", "((return 7), runtime(1))", "(return 7)(runtime(1))"] {
        let source = "fn runtime(x: i32) -> i32 { x } #[comptime] fn f() -> i32 { let _ = " + expr
            + "; 99 } fn main() -> () { println(comptime { f() }) }";
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "comptime function calls runtime-only function",
            ),
        );
    }
}

#[test]
fn comptime_keeps_origins_after_diverging_inputs() -> () {
    let source = "#[comptime] fn f(flag: bool) -> i32 { if flag { let _ = (return 7, 99); } compile_error(\"after branch\") } fn main() -> () { println(comptime { f(false) }) }";
    let expected = text::find(source, "compile_error").unwrap_or(-1);
    for diagnostic in checked_diagnostics(source) {
        if diagnostic.message.contains("after branch") {
            let Some(span) = diagnostic.span else {
                testing::fail("expected diagnostic span");
                return
            };
            testing::assert_eq(span.start, expected);
            return
        }
    }
    testing::fail("expected compile_error after untaken branch")
}

#[test]
fn comptime_rejects_unsupported_buffer_operations_with_diverging_arguments() -> () {
    let source = "#[comptime] fn f() -> i32 { let v: Vec[i32] = Vec::new(); v.swap_remove(return 7) } fn main() -> () { println(comptime { f() }) }";
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(source),
            "unsupported comptime buffer operation",
        ),
    );
}
