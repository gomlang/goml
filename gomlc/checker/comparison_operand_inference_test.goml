package checker;

use std::testing;

#[test]
fn comparison_closures_infer_operands_from_later_calls() -> () {
    for source in[
        "fn f() -> bool { let compare = |left, right| left == right; compare(true, false) }",
        "fn f() -> bool { let compare = |left, right| left != right; compare(\"a\", \"b\") }",
        "fn f() -> bool { let compare = |left, right| left < right; compare(1, 2) }",
        "fn f() -> bool { let compare = |left, right| left <= right; compare(1.5, 2.5) }",
        "fn f() -> bool { let compare = |left, right| left > right; compare(\"b\", \"a\") }",
        "fn f() -> bool { let compare = |left, right| left >= right; compare('b', 'a') }",
        "fn f() -> bool { let compare = |left, right| { let inner = |a, b| a == b; inner(left, right) }; compare(true, false) }",
        "fn f() -> bool { let compare = |left, right| left == right; let typed: (i32, i32) -> bool = compare; typed(1, 2) }",
        "fn f() -> bool { let compare = |left, right| (left, true) == (right, false); compare(1, 2) }",
        "fn f() -> bool { let compare = |left, right| Option::Some(left) == Option::Some(right); compare(true, false) }",
        "fn f() -> bool { let compare = |left, right| Vec::from_array([left]) == Vec::from_array([right]); compare(1, 2) }",
    ] {
        let _ = checked_file(source);
    }
    let _ = checked_file(
        "struct Key { value: i32 } impl PartialEq for Key { fn eq(self: Key, other: Key) -> bool { self.value == other.value } } fn f() -> bool { let compare = |left, right| left == right; compare(Key { value: 1 }, Key { value: 2 }) }",
    );
}

#[test]
fn comparison_closures_validate_resolved_trait_obligations() -> () {
    for source in[
        "struct Key {} fn f() -> bool { let compare = |left, right| left == right; compare(Key {}, Key {}) }",
        "struct Key {} fn f() -> bool { let compare = |left, right| left < right; compare(Key {}, Key {}) }",
        "fn f() -> bool { let compare = |left, right| left == right; compare(1, true) }",
        "fn f() -> bool { let compare = |left, right| left == right; compare(|| (), || ()) }",
        "fn f() -> () { let compare = |left, right| left == right; }",
        "fn f() -> () { let compare = |left, right| left < right; }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}
