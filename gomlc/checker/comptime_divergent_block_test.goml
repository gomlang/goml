package checker;

use std::testing;

#[test]
fn comptime_blocks_keep_statement_divergence_types() -> () {
    let _ = checked_file(
        "#[allow(unreachable_code)]\n#[comptime]\nfn return_in_let() -> i32 {\n    let result: i32 = { return 7; };\n    result\n}\n#[allow(unreachable_code)]\n#[comptime]\nfn return_in_pattern() -> i32 {\n    let (number, flag): (i32, bool) = { return 8; };\n    if flag { number } else { 0 }\n}\n#[comptime]\nfn return_in_branch(flag: bool) -> i32 {\n    if flag { { return 9; } } else { 10 }\n}\n#[allow(unreachable_code)]\n#[comptime]\nfn return_in_assignment() -> i32 {\n    let mut result: i32 = 0;\n    result = { return 11; };\n    result\n}\n#[allow(unreachable_code)]\n#[comptime]\nfn return_before_tail() -> i32 {\n    let result: i32 = { return 12; 99 };\n    result\n}\n#[allow(unreachable_code)]\n#[comptime]\nfn break_in_let() -> i32 {\n    loop {\n        let result: i32 = { break 13; };\n        return result;\n    }\n}\n#[allow(unreachable_code)]\n#[comptime]\nfn continue_in_let() -> i32 {\n    let mut result: i32 = 0;\n    for value in 0..2 {\n        if value == 0 {\n            let ignored: i32 = { continue; };\n            result += ignored;\n        }\n        result += 14;\n    }\n    result\n}\nfn main() -> () {\n    println(return_in_let());\n    println(comptime { return_in_let() });\n    println(comptime { return_in_pattern() });\n    println(comptime { return_in_branch(true) });\n    println(comptime { return_in_branch(false) });\n    println(comptime { return_in_assignment() });\n    println(comptime { return_before_tail() });\n    println(comptime { break_in_let() });\n    println(comptime { continue_in_let() });\n}\n",
    );
}

#[test]
fn comptime_diverging_blocks_still_validate_unreachable_operations() -> () {
    let source = "fn runtime() -> () {} #[allow(unreachable_code)] #[comptime] fn answer() -> i32 { let value: i32 = { return 7; runtime(); 9 }; value } fn main() -> () { println(comptime { answer() }); }";
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(source),
            "comptime function calls runtime-only function",
        ),
    );
}
