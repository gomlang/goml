package checker;

use module::ast;
use module::hir;
use module::parser;
use std::testing;

#[test]
fn aliases_resolve_associated_methods_with_owner_inference() -> () {
    let prefix = "struct Box[T] { value: T } impl[T] Box[T] { fn make(value: T) -> Box[T] { Box { value } } } type Alias[T] = Box[T]; type Fixed = Alias[bool]; ";
    for body in Vec::from_array(
        [
            "let _: Box[bool] = Alias::[bool]::make(true);",
            "let _: Box[bool] = Alias::make(true);",
            "let f = Alias::[bool]::make; let _: Box[bool] = f(true);",
            "let f = Alias::make; let _: Box[bool] = f(true);",
            "let _: Box[bool] = Fixed::make(true);",
        ],
    ) {
        let _ = checked_file(prefix + "fn main() -> () { " + body + " }");
    }
    testing::assert(
        has_diagnostic(
            checked_diagnostics(
                prefix + "fn main() -> () { let _ = Alias::[bool, i32]::make(true); }",
            ),
            "Type Alias expects 1 owner type arguments, but got 2",
        ),
    );
    testing::assert(
        has_diagnostic(
            checked_diagnostics(prefix + "fn main() -> () { let _ = Fixed::[bool]::make(true); }"),
            "Type Fixed expects 0 owner type arguments, but got 1",
        ),
    );
}

#[test]
fn erased_alias_parameters_still_validate_argument_types() -> () {
    let prefix = "type Erased[T] = i32; type Fixed[const N: usize] = i32; fn identity[T](value: T) -> T { value } ";
    for body in Vec::from_array(
        [
            "let _: Erased[3] = 1;",
            "let _ = identity::[Erased[3]](1);",
            "let _: Fixed[bool] = 1;",
            "let _ = identity::[Fixed[bool]](1);",
            "let _: Erased[Vec[3]] = 1;",
            "let _: Erased[Missing] = 1;",
        ],
    ) {
        testing::assert(
            !checked_diagnostics(prefix + "fn main() -> () { " + body + " }").is_empty(),
        );
    }
    let _ = checked_file(
        prefix
            + "fn main() -> () { let _: Erased[bool] = 1; let _: Fixed[3] = 1; let _ = identity::[Erased[bool]](1); let _ = identity::[Fixed[3]](1); }",
    );
}

#[test]
fn self_and_package_owners_reject_generic_arguments() -> () {
    let message = "Only type and trait constructors accept owner type arguments";
    for body in Vec::from_array(["Self::[bool]::value()", "{ let f = Self::[bool]::value; f() }"]) {
        testing::assert(
            has_diagnostic(
                checked_diagnostics(
                    "struct Token {} impl Token { fn value() -> i32 { 7 } fn indirect() -> i32 { "
                        + body
                        + " } }",
                ),
                message,
            ),
        );
    }
    let dependency = dependency_hir(
        "package api; pub fn identity[T](value: T) -> T { value }",
        "vendor::api",
    );
    for body in Vec::from_array(
        [
            "let _ = service::[bool]::identity::[i32](1);",
            "let f = service::[bool]::identity::[i32]; let _ = f(1);",
        ],
    ) {
        let checked = check_for_link_with_dependencies(
            hir::lower(
                ast::lower(
                    parser::parse("use vendor::api as service; fn main() -> () { " + body + " }"),
                ),
                "main.goml",
            ),
            Vec::from_array([dependency]),
        );
        testing::assert(has_diagnostic(checked.diagnostics, message));
    }
    let _ = checked_file(
        "struct Token {} impl Token { fn value[T](value: T) -> T { value } fn indirect() -> i32 { Self::value::[i32](7) } }",
    );
    let _ = checked_file_with_dependencies(
        "use vendor::api as service; fn main() -> () { let _ = service::identity::[i32](1); }",
        Vec::from_array([dependency]),
    );
}

#[test]
fn static_owner_arguments_validate_parameter_kinds() -> () {
    let prefix = "struct Token[T] {} impl[T] Token[T] { fn value() -> i32 { 7 } } struct Fixed[const N: usize] {} impl[const N: usize] Fixed[N] { fn value() -> i32 { 7 } } ";
    for body in Vec::from_array(
        ["let _ = Token::[3]::value();", "let f = Token::[3]::value; let _ = f();"],
    ) {
        testing::assert(
            has_diagnostic(
                checked_diagnostics(prefix + "fn main() -> () { " + body + " }"),
                "integer constant cannot be used as a value type",
            ),
        );
    }
    for body in Vec::from_array(
        ["let _ = Fixed::[bool]::value();", "let f = Fixed::[bool]::value; let _ = f();"],
    ) {
        testing::assert(
            has_diagnostic(
                checked_diagnostics(prefix + "fn main() -> () { " + body + " }"),
                "const generic argument must be an integer constant",
            ),
        );
    }
    let _ = checked_file(
        prefix
            + "fn main() -> () { let _ = Token::[bool]::value(); let _ = Fixed::[3]::value(); let f = Token::[bool]::value; let _ = f(); }",
    );
}

#[test]
fn free_function_generic_arguments_validate_arity() -> () {
    let prefix = "fn identity[T](value: T) -> T { value } fn pair[T, U](left: T, right: U) -> T { left } fn plain(value: i32) -> i32 { value } fn count[const N: usize]() -> usize { N } ";
    for (body, message) in Vec::from_array(
        [
            (
                "let _ = identity::[i32, bool](1);",
                "Function identity expects 1 type arguments, but got 2",
            ),
            (
                "let f = identity::[i32, bool]; let _ = f(1);",
                "Function identity expects 1 type arguments, but got 2",
            ),
            ("let _ = pair::[i32](1, true);", "Function pair expects 2 type arguments, but got 1"),
            ("let _ = plain::[bool](1);", "Function plain expects 0 type arguments, but got 1"),
            ("let _ = count::[2, 3]();", "Function count expects 1 type arguments, but got 2"),
        ],
    ) {
        testing::assert(
            has_diagnostic(
                checked_diagnostics(prefix + "fn main() -> () { " + body + " }"),
                message,
            ),
        );
    }
    let _ = checked_file(
        prefix
            + "fn main() -> () { let _ = pair(1, true); let _ = pair::[i32, bool](1, true); let f = identity::[i32]; let _ = f(1); let _ = count::[2](); let _ = plain(1); }",
    );
}

#[test]
fn enum_constructor_owner_arguments_specialize_calls_and_values() -> () {
    let declarations = "enum Value[T] { Item(T), Empty } ";
    for source in Vec::from_array(
        [
            "fn main() -> () { let _ = Value::[bool]::Item(true); }",
            "fn main() -> () { let make = Value::[bool]::Item; let _ = make(true); }",
            "fn main() -> () { let _ = Value::[bool]::Empty; }",
            "fn main() -> () { let _ = Option::[bool]::Some(true); let _ = Option::[bool]::None; }",
            "fn main() -> () { let make = Result::[bool, string]::Ok; let _ = make(true); }",
        ],
    ) {
        let _ = checked_file(declarations + source);
    }
    for (source, message) in Vec::from_array(
        [
            (
                "fn main() -> () { let _ = Value::[bool]::Item(42); }",
                "Numeric literal cannot be used as bool",
            ),
            (
                "fn main() -> () { let make = Value::[bool]::Item; let _ = make(42); }",
                "Numeric literal cannot be used as bool",
            ),
            (
                "fn main() -> () { let _value: Value[isize] = Value::[bool]::Empty; }",
                "Type mismatch: expected isize, found bool",
            ),
            (
                "fn main() -> () { let _make: (isize) -> Value[isize] = Value::[bool]::Item; }",
                "Type mismatch: expected isize, found bool",
            ),
            (
                "fn main() -> () { let _ = Option::[bool]::Some(42); }",
                "Numeric literal cannot be used as bool",
            ),
            (
                "fn main() -> () { let make = Result::[bool, string]::Ok; let _ = make(42); }",
                "Numeric literal cannot be used as bool",
            ),
        ],
    ) {
        testing::assert(has_diagnostic(checked_diagnostics(declarations + source), message));
    }
}

#[test]
fn enum_constructor_arguments_validate_arity_and_parameter_kinds() -> () {
    let declarations = "enum Value[T] { Item(T), Empty } enum Fixed[const N: usize] { Item([isize; N]), Empty } ";
    for source in Vec::from_array(
        [
            "fn main() -> () { let _ = Fixed::[2]::Item([1, 2]); }",
            "fn main() -> () { let make = Fixed::[2]::Item; let _ = make([1, 2]); }",
            "fn main() -> () { let _ = Fixed::[2]::Empty; }",
        ],
    ) {
        let _ = checked_file(declarations + source);
    }
    for (source, message) in Vec::from_array(
        [
            (
                "fn main() -> () { let _ = Value::[bool, string]::Item(true); }",
                "Type Value expects 1 owner type arguments, but got 2",
            ),
            (
                "fn main() -> () { let _make = Value::[bool, string]::Item; }",
                "Type Value expects 1 owner type arguments, but got 2",
            ),
            (
                "fn main() -> () { let _ = Option::[bool, string]::Some(true); }",
                "Type Option expects 1 owner type arguments, but got 2",
            ),
            (
                "fn main() -> () { let _make = Result::[bool]::Ok; }",
                "Type Result expects 2 owner type arguments, but got 1",
            ),
        ],
    ) {
        testing::assert(has_diagnostic(checked_diagnostics(declarations + source), message));
    }
    for source in Vec::from_array(
        [
            "fn main() -> () { let _ = Value::Item::[bool](true); }",
            "fn main() -> () { let _make = Value::[bool]::Item::[string]; }",
            "fn main() -> () { let _ = Option::Some::[bool](true); }",
        ],
    ) {
        testing::assert(
            has_diagnostic(
                checked_diagnostics(declarations + source),
                "enum variants do not accept member type arguments",
            ),
        );
    }
    for source in Vec::from_array(
        [
            "fn main() -> () { let _ = Fixed::[bool]::Item([1, 2]); }",
            "fn main() -> () { let _make = Fixed::[bool]::Item; }",
            "fn main() -> () { let _ = Fixed::[bool]::Empty; }",
        ],
    ) {
        testing::assert(
            has_diagnostic(
                checked_diagnostics(declarations + source),
                "const generic argument must be an integer constant",
            ),
        );
    }
    testing::assert(
        has_diagnostic(
            checked_diagnostics(declarations + "fn main() -> () { let _ = Value::[2]::Empty; }"),
            "integer constant cannot be used as a value type",
        ),
    );
    testing::assert(
        has_diagnostic(
            checked_diagnostics(
                declarations + "fn main() -> () { let _ = Value::[Missing]::Empty; }",
            ),
            "Unknown type constructor Missing",
        ),
    );
    testing::assert(
        has_diagnostic(
            checked_diagnostics(
                declarations + "fn main() -> () { let _ = Fixed::[3]::Item([1, 2]); }",
            ),
            "Array length mismatch: expected [isize; 3], found [isize; 2]",
        ),
    );
}

#[test]
fn imported_enum_constructor_owner_arguments_are_preserved() -> () {
    let dependency = dependency_hir(
        "package values; pub enum Value[T] { Item(T), Empty }",
        "example::values",
    );
    let imports = "package main; use example::values; ";
    let _ = checked_package_file_with_dependencies(
        imports
            + "fn main() -> () { let _ = values::Value::[bool]::Item(true); let make = values::Value::[bool]::Item; let _ = make(false); let _ = values::Value::[bool]::Empty; }",
        Vec::from_array([dependency]),
    );
    for (source, message) in Vec::from_array(
        [
            (
                "fn main() -> () { let _ = values::Value::[bool]::Item(42); }",
                "Numeric literal cannot be used as bool",
            ),
            (
                "fn main() -> () { let make = values::Value::[bool]::Item; let _ = make(42); }",
                "Numeric literal cannot be used as bool",
            ),
            (
                "fn main() -> () { let _value: values::Value[isize] = values::Value::[bool]::Empty; }",
                "Type mismatch: expected isize, found bool",
            ),
        ],
    ) {
        let result = check_for_link_with_dependencies(
            hir::lower_package(ast::lower(parser::parse(imports + source)), "main.goml", "main"),
            Vec::from_array([dependency]),
        );
        testing::assert(has_diagnostic(result.diagnostics, message));
    }
}
