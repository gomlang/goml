package checker;

use std::testing;

#[test]
fn inferred_range_patterns_reject_float_scrutinees() -> () {
    for source in[
        "fn main() -> () { let f = |value| match value { 0..=1 => true, _ => false }; let _ = f(0.5); }",
        "fn main() -> () { let f = |value| { let 0..=1 = value else { return false; }; true }; let _ = f(0.5); }",
        "fn main() -> () { let f = |value| match value { Option::Some((0..=1, _)) => true, _ => false }; let _ = f(Option::Some((0.5, true))); }",
        "const VALUE: bool = { let f = |value| match value { 0..=1 => true, _ => false }; f(0.5) }; fn main() -> () {}",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "Range pattern endpoints must be integer or character literals",
            ),
        );
    }
}

#[test]
fn inferred_range_patterns_accept_exact_float_bounds_for_integer_scrutinees() -> () {
    for source in[
        "fn main() -> () { let f = |value| match value { 0.0..=1.0 => true, _ => false }; let n: i32 = 0; let _ = f(n); }",
        "fn main() -> () { let f = |value| { let 0.0..=1.0 = value else { return false; }; true }; let n: i32 = 0; let _ = f(n); }",
        "fn main() -> () { let f = |value| match value { 0..=1 => true, _ => false }; let n: i32 = 0; let _ = f(n); }",
        "fn main() -> () { let f = |value| match value { 'a'..='z' => true, _ => false }; let _ = f('b'); }",
        "const VALUE: bool = { let f = |value| match value { 0.0..=1.0 => true, _ => false }; let n: i32 = 0; f(n) }; fn main() -> () {}",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn inferred_range_patterns_validate_order_after_integer_conversion() -> () {
    for source in[
        "fn main() -> () { let f = |value| match value { 1.0..=0.0 => true, _ => false }; let n: i32 = 0; let _ = f(n); }",
        "fn main() -> () { let f = |value| match value { 1.0..1.0 => true, _ => false }; let n: i32 = 0; let _ = f(n); }",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "Range pattern lower bound must be less than its upper bound",
            ),
        );
    }
}
