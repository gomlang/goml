package checker;

use module::ast;
use module::hir;
use module::tast::{ImplBlock, Item, Type, short_name, types_equal, validate_go_interface_bridge_callable};

fn validate_go_interface_bridges(ctx: Checker, file: hir::File) -> () {
    for item in file.items {
        let ExternFunction(definition) = item else {
            continue
        };
        let Some(function) = find_function_by_name(ctx, definition.name) else {
            continue
        };
        let GoInterfaceBridge { methods, .. } = function.callable else {
            continue
        };
        let ty = Type::Func { params: function.params, ret_ty: function.ret_ty };
        if let Err(message) = validate_go_interface_bridge_callable(methods, ty) {
            let mut span = Option::None;
            for attribute in definition.attrs {
                if attribute.name == "go_interface_bridge" {
                    span = Option::Some(attribute.span);
                }
            }
            ctx.diagnostics.push(new_diagnostic(TYPER_STAGE, message, file.source_path, span));
        }
    }
}

fn validate_go_interface_members(
    ctx: Checker,
    file: hir::File,
    package_files: Vec[hir::File],
    items: Vec[Item],
) -> () {
    let declarations = Vec::from_array([file]);
    for candidate in package_files {
        if candidate.source_path != file.source_path {
            declarations.push(candidate);
        }
    }
    for owner in declarations {
        for item in owner.items {
            let TraitDef(definition) = item else {
                continue
            };
            let Ok(Some(specification)) = ast::go_interface_spec(definition.attrs) else {
                continue
            };
            let prefix = definition.name.byte_slice(
                0,
                definition.name.byte_len() - short_name(definition.name).byte_len(),
            );
            let wrapper = prefix + specification.wrapper_name;
            for item in items {
                let ImplBlock(block) = item else {
                    continue
                };
                if !types_equal(block.for_type, Type::Con { name: wrapper }) {
                    continue
                }
                for method in block.methods {
                    let mut reserved = method.name == "from_go" || method.name == "into_go"
                        || method.name == "from_trait";
                    for mapping in specification.methods {
                        if mapping.0 == method.name {
                            reserved = true;
                        }
                    }
                    if reserved
                        && (method.source_path != owner.source_path
                            || method.name_span.start != specification.span.start
                            || method.name_span.end != specification.span.end) {
                        ctx.diagnostics.push(
                            new_diagnostic(
                                TYPER_STAGE,
                                "go_interface generated member collides with " + wrapper + "::"
                                    + method.name,
                                method.source_path,
                                Some(method.name_span),
                            ),
                        );
                    }
                }
            }
        }
    }
}
