package checker;

use std::testing;

#[test]
fn rejects_assignment_to_values_without_locations() -> () {
    for source in[
        "fn main() -> () { 1 = 2; }",
        "fn main() -> () { 1 += 2; }",
        "fn value() -> i32 { 1 } fn main() -> () { value() = 2; }",
        "fn main() -> () { (1 + 2) = 3; }",
        "fn main() -> () { (1, 2) = (3, 4); }",
        "fn main() -> () { [1, 2] = [3, 4]; }",
        "fn first() -> i32 { 1 } fn second() -> i32 { 2 } fn main() -> () { first = second; }",
        "struct Point { x: i32 } fn main() -> () { Point { x: 1 } = Point { x: 2 }; }",
        "struct Point { x: i32 } impl Point { fn read(self: Point) -> i32 { self.x } } fn main() -> () { Point::read = Point::read; }",
    ] {
        if !has_diagnostic_containing(checked_diagnostics(source), "assignable location required") {
            testing::fail(source)
        }
    }
}

#[test]
fn writable_function_locations_remain_assignable() -> () {
    let _ = checked_file(
        "fn first() -> i32 { 1 } fn second() -> i32 { 2 } struct Holder { callback: () -> i32 } fn main() -> () { let mut callback = first; callback = second; let holder = Holder { callback: first }; holder.callback = second; let pair = (first, 1); pair.0 = second; }",
    );
}
