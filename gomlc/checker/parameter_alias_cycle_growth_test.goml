package checker;

use std::testing;
use module::tast::{Type, TypeSubst, types_equal};

#[test]
fn cyclic_parameter_alias_expansion_ignores_unrelated_alias_count() -> () {
    let parameter = Type::Param { name: "T" };
    let recursive = Type::Tuple { items: Vec::from_array([parameter, parameter]) };
    let aliases = Vec::from_array([TypeSubst { name: "T", ty: recursive }]);
    for index in 0..16 {
        aliases.push(TypeSubst { name: "Unused" + index.to_string(), ty: Type::Bool });
    }
    testing::assert(types_equal(resolve_parameter_alias(parameter, aliases), recursive));
}

#[test]
fn cyclic_parameter_equalities_report_errors_without_exponential_expansion() -> () {
    let parameters = Vec::from_array(["T"]);
    let equalities = Vec::from_array(["T = (T, T)"]);
    for index in 0..12 {
        let name = "Unused" + index.to_string();
        parameters.push(name);
        equalities.push(name + " = bool");
    }
    let source = "fn invalid[" + parameters.join(", ") + "](value: T) -> T where "
        + equalities.join(", ")
        + " { value }";
    testing::assert(has_diagnostic_containing(checked_diagnostics(source), "cyclic type equality"));
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "fn invalid[T, U, V](value: T) -> T where T = (U, U), U = Vec[V], V = T { value }",
            ),
            "cyclic type equality",
        ),
    );
}

#[test]
fn finite_parameter_alias_chains_resolve_every_branch() -> () {
    let aliases = Vec::new();
    for index in 0..20 {
        aliases.push(
            TypeSubst {
                name: "T" + index.to_string(),
                ty: Type::Param { name: "T" + (index + 1).to_string() },
            },
        );
    }
    aliases.push(TypeSubst { name: "T20", ty: Type::Int32 });
    let input = Type::Tuple {
        items: Vec::from_array([Type::Param { name: "T0" }, Type::Param { name: "T0" }]),
    };
    let expected = Type::Tuple { items: Vec::from_array([Type::Int32, Type::Int32]) };
    testing::assert(types_equal(resolve_parameter_alias(input, aliases), expected));
    let _ = checked_file(
        "fn valid[T, U, V](value: T) -> (Vec[i32], Vec[i32]) where T = (U, U), U = Vec[V], V = i32 { value }",
    );
}
