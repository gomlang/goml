package checker;

use std::testing;

#[test]
fn minimum_remainder_is_valid_in_array_lengths() -> () {
    for source in[
        "fn empty() -> [i32; (-9223372036854775807 - 1) % -1] { [] }",
        "fn empty() -> [i32; 0] { [42; (-9223372036854775807 - 1) % -1] }",
    ] {
        testing::assert_eq(checked_diagnostics(source).len(), 0);
    }
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics("fn invalid() -> [i32; (-9223372036854775807 - 1) / -1] { [] }"),
            "overflow",
        ),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics("fn invalid() -> [i32; (-9223372036854775807 - 1) % 0] { [] }"),
            "division by zero",
        ),
    );
}
