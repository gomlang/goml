package checker;

use std::testing;

#[test]
fn float_patterns_treat_signed_zero_as_the_same_value() -> () {
    for ty in["f32", "f64"] {
        for patterns in[
            "0.0 => true, -0.0 => false",
            "-0.0 => true, 0.0 => false",
            "0.0 => true, -0e10 => false",
        ] {
            testing::assert(
                has_diagnostic_containing(
                    checked_diagnostics(
                        "fn f(value: " + ty + ") -> bool { match value { " + patterns
                            + ", _ => true } }",
                    ),
                    "Unreachable match arm",
                ),
            );
        }
    }
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "fn main() -> () { let f = |value| match value { 0.0 => true, -0.0 => false, _ => true }; let value: f32 = 0.0; let _ = f(value); }",
            ),
            "Unreachable match arm",
        ),
    );
}

#[test]
fn signed_zero_coverage_preserves_guards_and_nonzero_values() -> () {
    for source in[
        "fn f(value: f64, flag: bool) -> bool { match value { 0.0 if flag => true, -0.0 => false, _ => true } }",
        "fn f(value: f64) -> bool { match value { 0.0 => true, -1.0 => false, _ => true } }",
        "fn f(value: f64) -> bool { match value { 0.0 => true, -1e-100 => false, _ => true } }",
    ] {
        testing::assert(
            !has_diagnostic_containing(checked_diagnostics(source), "Unreachable match arm"),
        );
        let _ = checked_file(source);
    }
}
