package checker;

use std::testing;

#[test]
fn declared_owner_equalities_expose_projection_bounds() -> () {
    for source in[
        "trait Bound { type Item; } fn read[T: Bound, U](value: U::Item) -> U::Item where T = U { value }",
        "trait Bound { type Item; } fn read[T: Bound, U](value: U::Item) -> U::Item where U = T { value }",
        "trait Bound { type Item; } trait Main { fn read[T: Bound, U](self, value: U::Item) -> U::Item where T = U; }",
        "trait Bound { type Item; } type Identity[X] = X; fn read[T: Bound, U](value: Identity[U::Item]) -> Identity[U::Item] where T = U { value }",
        "trait Bound { type Item; } trait Other[T] {} trait Main[T: Bound, U] where T = U { type Inner: Other[U::Item]; }",
        "trait Bound[T] { type Item; } fn read[T: Bound[A] + Bound[B], A, B](value: T::Item) -> T::Item where A = B { value }",
    ] {
        let diagnostics = checked_diagnostics(source);
        if !diagnostics.is_empty() {
            for diagnostic in diagnostics {
                testing::fail(source + "\n" + diagnostic.message)
            }
        }
    }
}

#[test]
fn projection_equalities_do_not_equate_unrelated_owners_or_traits() -> () {
    for source in[
        "trait Bound { type Item; } fn read[T: Bound, U](value: U::Item) -> U::Item where T::Item = i32 { value }",
        "trait First { type Item; } trait Second { type Item; } fn read[T: First, U: Second](value: U::Item) -> U::Item where T = U { value }",
        "trait Bound { type Item; } fn read[T: Bound, U: Bound](value: T) -> U where T::Item = U::Item { value }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}
