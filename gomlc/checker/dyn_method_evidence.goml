package checker;

use module::tast::{TraitRef, Type, callable_base, names_match, prune};

struct DynMethodEvidence {
    receiver: Type,
    trait_ref: TraitRef,
    method_name: string,
}

fn callable_dyn_method_evidence(ctx: Checker, value: ResolvedCallable) -> Option[DynMethodEvidence] {
    match callable_base(value.callable) {
        TraitMethod { trait_ref, method_name, for_ty, has_receiver } if has_receiver => Some(
            DynMethodEvidence { receiver: for_ty, trait_ref, method_name },
        ),
        DynTraitMethod { dispatch_name, method_name, .. } => {
            let Func { params, .. } = prune(value.ty) else {
                return None
            };
            if params.is_empty() {
                return None
            }
            for reference in dyn_applications(ctx, params[0]) {
                if names_match(reference.name, dispatch_name) {
                    return Some(
                        DynMethodEvidence { receiver: params[0], trait_ref: reference, method_name },
                    )
                }
            }
            None
        },
        _ => None,
    }
}

fn require_callable_predicates(ctx: Checker, value: ResolvedCallable) -> () {
    let dyn_method = callable_dyn_method_evidence(ctx, value);
    for predicate in value.predicates {
        ctx.inference.required_predicates.push(
            PredicateRequirement {
                predicate,
                message: "type predicate not satisfied",
                span: ctx.current_span.get(),
                dyn_method,
            },
        )
    }
}

fn predicate_has_dyn_method_evidence(ctx: Checker, requirement: PredicateRequirement) -> bool {
    let Some(evidence) = requirement.dyn_method else {
        return false
    };
    let receiver = prune(normalize_type(ctx, evidence.receiver));
    let Dyn { .. } = receiver else {
        return false
    };
    if !contains_trait_ref(dyn_applications(ctx, receiver), evidence.trait_ref) {
        return false
    }
    let Some(info) = find_trait(ctx, evidence.trait_ref.name) else {
        return false
    };
    let Some(method) = find_trait_method(info, evidence.method_name) else {
        return false
    };
    if !method.has_receiver || !method.generics.is_empty() {
        return false
    }
    let substitutions = trait_substitutions(ctx, info, evidence.trait_ref, Some(receiver));
    for predicate in expand_implied_predicates(
        ctx,
        substitute_predicates(method.predicates, substitutions),
    ) {
        if predicate_equal(predicate, requirement.predicate) {
            return true
        }
    }
    false
}
