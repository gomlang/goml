package checker;

use std::testing;
use module::diagnostic::{diagnostics_have_errors};

fn contextual_constructor_dependency_check(source: string) -> CheckResult {
    let dependency = dependency_hir(
        "package hidden; pub struct Clash { pub target: i32 } pub type Alias = Clash;",
        "scope::hidden",
    );
    let environments = testing::expect_ok(
        dependency_environments(Vec::from_array([dependency])),
        "dependency environment",
    );
    check_package_files_for_link_with_environments(
        Vec::from_array([dependency_hir(source, "scope::client")]),
        environments,
    )
}

#[test]
fn unloaded_struct_short_names_do_not_shadow_contextual_variants() -> () {
    for source in[
        "package client; enum Event { Clash { value: i32 } } fn make() -> Event { Clash { value: 7 } }",
        "package client; enum Event { Clash(i32) } fn make() -> Event { Clash(7) }",
        "package client; enum Event { Clash } fn make() -> Event { Clash }",
        "package client; enum Event { Alias { value: i32 } } fn make() -> Event { Alias { value: 7 } }",
    ] {
        let checked = contextual_constructor_dependency_check(source);
        if diagnostics_have_errors(checked.diagnostics) {
            let mut message = source;
            for diagnostic in checked.diagnostics {
                message = message + "\n" + diagnostic.message;
            }
            testing::fail(message)
        }
    }
}

#[test]
fn constructor_scope_preserves_local_and_imported_struct_precedence() -> () {
    for source in[
        "package client; use scope::hidden; fn make() -> hidden::Clash { hidden::Clash { target: 7 } }",
        "package client; use scope::hidden::{Clash}; fn make() -> Clash { Clash { target: 7 } }",
        "package client; struct Clash { value: i32 } fn make() -> Clash { Clash { value: 7 } }",
    ] {
        let checked = contextual_constructor_dependency_check(source);
        if diagnostics_have_errors(checked.diagnostics) {
            let mut message = source;
            for diagnostic in checked.diagnostics {
                message = message + "\n" + diagnostic.message;
            }
            testing::fail(message)
        }
    }
    for source in[
        "package client; fn make() -> () { let _ = Clash { target: 7 }; }",
        "package client; use scope::hidden::{Clash}; enum Event { Clash { value: i32 } } fn make() -> Event { Clash { target: 7 } }",
        "package client; struct Clash { value: i32 } enum Event { Clash { value: i32 } } fn make() -> Event { Clash { value: 7 } }",
    ] {
        if !diagnostics_have_errors(contextual_constructor_dependency_check(source).diagnostics) {
            testing::fail("expected a constructor scope diagnostic: " + source)
        }
    }
}
