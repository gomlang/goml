package checker;

use std::testing;

#[test]
fn interpolation_uses_later_types_and_the_to_string_trait() -> () {
    for source in[
        "fn f() -> string { let format = |value| f\"value={value}\"; format(true) }",
        "fn f() -> string { let format = |value| f\"value={value}\"; format(\"text\") }",
        "fn f(value: f32) -> string { let format = |value| f\"value={value + 0.0}\"; format(value) }",
        "struct Item {} impl Item { fn to_string(self: Item) -> i32 { 7 } } impl ToString for Item { fn to_string(self: Item) -> string { \"trait\" } } fn f() -> string { f\"{Item {}}\" }",
        "fn f(value: dyn ToString) -> string { let format = |value| f\"{value}\"; format(value) }",
        "fn f[T: ToString](value: T) -> string { f\"{value}\" }",
        "fn stop() -> never { loop {} } fn f() -> () { let format = |callback| f\"{callback()}\"; let _ = format(stop); }",
    ] {
        if !checked_diagnostics(source).is_empty() {
            testing::fail(source)
        }
    }
}

#[test]
fn interpolation_rejects_inherent_only_conversions_and_missing_impl_bounds() -> () {
    for source in[
        "struct Item {} impl Item { fn to_string(self: Item) -> i32 { 7 } } fn f() -> string { f\"{Item {}}\" }",
        "struct Item {} impl Item { fn to_string(self: Item) -> string { \"inherent\" } } fn f() -> string { f\"{Item {}}\" }",
        "trait Mark {} struct Item[T] { value: T } impl[T: Mark] ToString for Item[T] { fn to_string(self: Item[T]) -> string { \"value\" } } fn f() -> string { f\"{Item { value: true }}\" }",
        "fn f() -> string { let format = |value| f\"{value}\"; format(|| ()) }",
        "fn f() -> () { let format = |value| f\"{value}\"; let _ = format(true); let _ = format(7); }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}
