package checker;

use std::testing;

#[test]
fn nested_dyn_projections_do_not_borrow_same_named_parent_bounds() -> () {
    for source in[
        "trait Read[T] { fn read(self: Self) -> T; } impl Read[() -> i32] for bool { fn read(self: bool) -> () -> i32 { || 7 } } trait Parent { type Item: ToString; } trait Child: Parent { type Item; fn make(self: Self) -> dyn Read[Self::Item]; } impl Parent for bool { type Item = string; } impl Child for bool { type Item = () -> i32; fn make(self: bool) -> dyn Read[() -> i32] { true as dyn Read[() -> i32] } } fn use_it[T: Child](value: T) -> string { value.make().read().to_string() } fn main() -> () { println(use_it(true)); }",
        "trait Read { type Value; fn read(self: Self) -> Self::Value; } impl Read for bool { type Value = () -> i32; fn read(self: bool) -> () -> i32 { || 7 } } trait Parent { type Item: ToString; } trait Child: Parent { type Item; fn make(self: Self) -> dyn Read[Value = Self::Item]; } impl Parent for bool { type Item = string; } impl Child for bool { type Item = () -> i32; fn make(self: bool) -> dyn Read[Value = () -> i32] { true as dyn Read[Value = () -> i32] } } fn use_it[T: Child](value: T) -> string { value.make().read().to_string() } fn main() -> () { println(use_it(true)); }",
        "trait Marker {} impl Marker for bool {} trait Read[T] { fn read(self: Self) -> T; } impl Read[() -> i32] for bool { fn read(self: bool) -> () -> i32 { || 7 } } trait Parent { type Item: ToString; } trait Child: Parent { type Item; fn make(self: Self) -> dyn Marker + Read[Self::Item]; } impl Parent for bool { type Item = string; } impl Child for bool { type Item = () -> i32; fn make(self: bool) -> dyn Marker + Read[() -> i32] { true as dyn Marker + Read[() -> i32] } } fn use_it[T: Child](value: T) -> string { value.make().read().to_string() } fn main() -> () { println(use_it(true)); }",
    ] {
        testing::assert(
            has_diagnostic_containing(checked_diagnostics(source), "Method to_string not found"),
        );
    }
}
