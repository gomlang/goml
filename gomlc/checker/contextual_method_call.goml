package checker;

use module::tast::{Type, VarKind};

fn resolve_contextual_method(
    ctx: Checker,
    receiver: Type,
    name: string,
    arity: isize,
    expected: Option[Type],
    explicit: Vec[Type],
) -> Option[ResolvedCallable] {
    let Some(expected_ty) = expected else {
        return None
    };
    if contains_unbound_type_variable(expected_ty) {
        return None
    }
    let args = Vec::new();
    for _ in 0..arity {
        args.push(fresh_type(ctx.inference.counter, VarKind::Any));
    }
    let snapshot = method_inference_snapshot(receiver, args, expected, explicit);
    let diagnostic_start = ctx.diagnostics.len();
    let required_start = ctx.inference.required_predicates.len();
    let argument_start = ctx.inference.generic_arguments.len();
    let resolved = resolve_method(ctx, receiver, name, args, expected, explicit);
    if let Some(value) = resolved {
        if ctx.diagnostics.len() == diagnostic_start && !type_contains_error(value.ty) {
            return Some(value)
        }
    }
    snapshot.restore();
    ctx.diagnostics.truncate(diagnostic_start);
    ctx.inference.required_predicates.truncate(required_start);
    ctx.inference.generic_arguments.truncate(argument_start);
    None
}
