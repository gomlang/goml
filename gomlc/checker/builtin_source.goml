package checker;

use module::builtin_source::{implicit_builtin_hir_files};
use module::ast;
use module::hir;
use module::parser;
use module::resources;
use module::tast::{EnumDef, EnumInfo, FunctionScheme, ImplInfo, StructDef, StructInfo, TraitInfo, builtin_contract, short_name};

static builtin_source_traits: OnceCell[FrozenVec[TraitInfo]] = OnceCell::new();

static builtin_source_enums: OnceCell[FrozenVec[EnumInfo]] = OnceCell::new();

static builtin_source_structs: OnceCell[FrozenVec[StructInfo]] = OnceCell::new();

static builtin_source_functions: OnceCell[FrozenVec[FunctionScheme]] = OnceCell::new();

static builtin_source_arities: OnceCell[FrozenVec[(string, isize)]] = OnceCell::new();

static builtin_source_impls: OnceCell[FrozenVec[ImplInfo]] = OnceCell::new();

fn load_builtin_source_traits() -> FrozenVec[TraitInfo] {
    let result: Vec[TraitInfo] = Vec::new();
    let Ok(builtin) = builtin_contract() else {
        return result.freeze();
    };
    let Ok(source) = resources::builtin_contract_source() else {
        return result.freeze();
    };
    let inputs = Vec::from_array([(ast::lower(parser::parse(source.source)), source.path)]);
    for lowered in hir::lower_package_files(inputs, "builtin") {
        if let Some(file) = lowered.hir {
            for item in file.items {
                if let TraitDef(value) = item {
                    result.push(collect_trait(builtin, value))
                }
            }
        }
    }
    result.freeze()
}

fn builtin_source_trait_info(name: string) -> Option[TraitInfo] {
    let values = builtin_source_traits.get_or_init(|| load_builtin_source_traits());
    let mut index = 0;
    while index < values.len() {
        let value = values.get(index);
        if value.name == name {
            return Some(value)
        }
        index += 1;
    }
    None
}

fn load_builtin_source_enums() -> FrozenVec[EnumInfo] {
    let result: Vec[EnumInfo] = Vec::new();
    let Ok(builtin) = builtin_contract() else {
        return result.freeze();
    };
    let Ok(sources) = resources::builtin_enum_sources() else {
        return result.freeze();
    };
    let inputs: Vec[(ast::LowerResult, string)] = Vec::new();
    for source in sources {
        inputs.push((ast::lower(parser::parse(source.source)), source.path))
    }
    for lowered in hir::lower_package_files(inputs, "builtin") {
        if let Some(file) = lowered.hir {
            for item in file.items {
                if let EnumDef(value) = item {
                    result.push(collect_enum(builtin, value))
                }
            }
        }
    }
    result.freeze()
}

fn builtin_source_enum_infos() -> Vec[EnumInfo] {
    builtin_source_enums.get_or_init(|| load_builtin_source_enums()).to_vec()
}

fn builtin_source_enum_info(name: string) -> Option[EnumInfo] {
    let expected = short_name(name);
    let values = builtin_source_enums.get_or_init(|| load_builtin_source_enums());
    let mut index = 0;
    while index < values.len() {
        let value = values.get(index);
        if value.name == expected {
            return Some(value)
        }
        index += 1;
    }
    None
}

fn load_builtin_source_structs() -> FrozenVec[StructInfo] {
    let result: Vec[StructInfo] = Vec::new();
    let Ok(builtin) = builtin_contract() else {
        return result.freeze();
    };
    let Ok(source) = resources::builtin_contract_source() else {
        return result.freeze();
    };
    let inputs = Vec::from_array([(ast::lower(parser::parse(source.source)), source.path)]);
    for lowered in hir::lower_package_files(inputs, "builtin") {
        if let Some(file) = lowered.hir {
            for item in file.items {
                if let StructDef(value) = item {
                    result.push(collect_struct(builtin, value))
                }
            }
        }
    }
    result.freeze()
}

fn builtin_source_struct_info(name: string) -> Option[StructInfo] {
    let expected = short_name(name);
    let values = builtin_source_structs.get_or_init(|| load_builtin_source_structs());
    let mut index = 0;
    while index < values.len() {
        let value = values.get(index);
        if value.name == expected {
            return Some(value)
        }
        index += 1;
    }
    None
}

fn load_builtin_source_functions() -> FrozenVec[FunctionScheme] {
    let result: Vec[FunctionScheme] = Vec::new();
    let Ok(builtin) = builtin_contract() else {
        return result.freeze();
    };
    let Ok(files) = implicit_builtin_hir_files() else {
        return result.freeze();
    };
    for file in files {
        for value in dependency_environment_from_hir_with_contract(file, builtin).functions {
            result.push(value)
        }
    }
    result.freeze()
}

fn builtin_source_function_scheme(name: string) -> Option[FunctionScheme] {
    let values = builtin_source_functions.get_or_init(|| load_builtin_source_functions());
    let mut index = 0;
    while index < values.len() {
        let value = values.get(index);
        if value.name == name {
            return Some(value)
        }
        index += 1;
    }
    None
}

fn append_builtin_source_arity(values: Vec[(string, isize)], name: string, arity: isize) -> () {
    for value in values {
        if value.0 == name {
            return
        }
    }
    values.push((name, arity))
}

fn append_builtin_source_type_arity(values: Vec[(string, isize)], value: hir::TypeExpr) -> () {
    match value.kind {
        Named { reference } => {
            append_builtin_source_arity(values, hir::type_reference_name(reference), 0)
        },
        hir::TypeKind::App { ty, args } => {
            if let Named { reference } = ty.kind {
                append_builtin_source_arity(values, hir::type_reference_name(reference), args.len())
            }
        },
        _ => (),
    }
}

fn load_builtin_source_arities() -> FrozenVec[(string, isize)] {
    let result: Vec[(string, isize)] = Vec::new();
    let Ok(files) = implicit_builtin_hir_files() else {
        return result.freeze();
    };
    for file in files {
        for item in file.items {
            match item {
                EnumDef(value) => {
                    append_builtin_source_arity(result, value.name, value.generics.len())
                },
                StructDef(value) => {
                    append_builtin_source_arity(result, value.name, value.generics.len())
                },
                hir::Item::TypeAlias(value) => {
                    append_builtin_source_arity(result, value.name, value.generics.len())
                },
                hir::Item::ImplBlock(value) => {
                    append_builtin_source_type_arity(result, value.for_type)
                },
                _ => (),
            }
        }
    }
    result.freeze()
}

fn builtin_source_nominal_arity(name: string) -> Option[isize] {
    let expected = short_name(name);
    let values = builtin_source_arities.get_or_init(|| load_builtin_source_arities());
    let mut index = 0;
    while index < values.len() {
        let value = values.get(index);
        if value.0 == expected {
            return Some(value.1)
        }
        index += 1;
    }
    None
}

fn load_builtin_source_impls() -> FrozenVec[ImplInfo] {
    let result: Vec[ImplInfo] = Vec::new();
    let Ok(builtin) = builtin_contract() else {
        return result.freeze();
    };
    let Ok(files) = implicit_builtin_hir_files() else {
        return result.freeze();
    };
    for file in files {
        for value in dependency_environment_from_hir_with_contract(file, builtin).impls {
            result.push(
                ImplInfo {
                    generics: value.generics,
                    predicates: value.predicates,
                    trait_ref: value.trait_ref,
                    for_type: value.for_type,
                    associated_types: value.associated_types,
                    origin: f"builtin#source#{result.len()}",
                    span: value.span,
                },
            )
        }
    }
    result.freeze()
}

fn builtin_source_impl_infos() -> FrozenVec[ImplInfo] {
    builtin_source_impls.get_or_init(|| load_builtin_source_impls())
}

fn append_builtin_source_impls(ctx: Checker) -> () {
    if ctx.package_name == "builtin" {} else {
        let values = builtin_source_impl_infos();
        let mut index = 0;
        while index < values.len() {
            push_impl_info(ctx, values.get(index));
            index += 1;
        }
    }
}
