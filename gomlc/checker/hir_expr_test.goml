package checker;

use module::ast;
use module::hir;
use module::parser;
use std::testing;
use module::tast::{DependencyEnvironment, dependency_environment_with_comptime};

fn checked_dependency_environment(source: string, package_name: string) -> DependencyEnvironment {
    let dependency = hir::lower_package(
        ast::lower(parser::parse(source)),
        "dependency.goml",
        package_name,
    );
    let file = testing::expect_some(dependency.hir, "expected dependency HIR");
    let checked_dependency = check_for_link(dependency);
    for diagnostic in checked_dependency.diagnostics {
        testing::fail(diagnostic.message)
    }
    let environments = testing::expect_ok(
        dependency_environments(Vec::from_array([file])),
        "expected dependency environment",
    );
    dependency_environment_with_comptime(environments[0], Option::Some(checked_dependency.comptime))
}

#[test]
fn array_repeat_resolves_imported_lengths_and_expected_element_types() -> () {
    let environment = checked_dependency_environment(
        "package sizes; pub const LENGTH: usize = 3;",
        "example::sizes",
    );
    let result = check_for_link_with_environments(
        hir::lower_package(
            ast::lower(
                parser::parse(
                    "package main; use example::sizes; fn main() -> () { let repeated: [u8; sizes::LENGTH] = [1; sizes::LENGTH]; let _ = repeated[2]; }",
                ),
            ),
            "main.goml",
            "main",
        ),
        Vec::from_array([environment]),
    );
    for diagnostic in result.diagnostics {
        testing::fail(diagnostic.message)
    }
    testing::assert(result.tast.is_some());
    testing::assert(
        has_diagnostic(
            checked_diagnostics("fn main() -> () { let _ = [1; MISSING]; }"),
            "unknown integer constant MISSING",
        ),
    );
}
