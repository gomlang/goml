package checker;

use module::hir;
use module::diagnostic::{Diagnostic};
use module::tast::{builtin_contract, DependencyEnvironment, Item, Type, opaque_hidden, prune, type_text};

fn opaque_map_key_pending(ctx: Checker, value: Type) -> bool {
    match opaque_hidden(prune(normalize_type(ctx, value))) {
        Some(hidden) => contains_unbound_type_variable(hidden),
        None => false,
    }
}

fn validate_finished_opaque_map_predicates(ctx: Checker, items: Vec[Item]) -> () {
    for item in items {
        let functions = Vec::new();
        match item {
            Function(value) => functions.push(value),
            ImplBlock(value) => for method in value.methods {
                functions.push(method);
            },
        }
        for function in functions {
            for predicate in function.predicates {
                if let GoComparable(key) = predicate {
                    if opaque_hidden(prune(normalize_type(ctx, key))).is_some()
                        && go_map_key_uncomparable(ctx, key, Vec::new()) {
                        ctx.diagnostics.push(
                            new_diagnostic(
                                TYPER_STAGE,
                                "Go map key is not comparable: " + type_text(key),
                                function.source_path,
                                Some(function.name_span),
                            ),
                        );
                    }
                }
            }
        }
    }
}

fn validate_package_opaque_map_predicates(
    values: Vec[hir::File],
    dependencies: Vec[DependencyEnvironment],
    items: Vec[Item],
    diagnostics: Vec[Diagnostic],
) -> () {
    if values.is_empty() {
        return
    }
    let Ok(builtin) = builtin_contract() else {
        return
    };
    let ctx = collect_environment_with_external_aliases(values[0], true, builtin, Vec::new());
    for dependency in dependencies {
        append_dependency_environment(ctx, dependency);
    }
    for index in 1..values.len() {
        append_package_environment(
            ctx,
            package_environment_with_external_aliases(values[index], true, builtin, Vec::new()),
        );
    }
    let start = ctx.diagnostics.len();
    validate_finished_opaque_map_predicates(ctx, items);
    for index in start..ctx.diagnostics.len() {
        diagnostics.push(ctx.diagnostics[index]);
    }
}
