package checker;

use std::testing;

#[test]
fn rejects_readonly_slice_assignment_through_value_projections() -> () {
    for source in[
        "struct Point { x: i32 } fn main() -> () { let values = Vec::from_array([Point { x: 1 }]); let view = values.as_slice(); view[0].x = 2; }",
        "fn main() -> () { let values = Vec::from_array([(1, 2)]); let view = values.as_slice(); view[0].0 += 2; }",
        "struct Point { values: [i32; 1] } fn main() -> () { let values = Vec::from_array([Point { values: [1] }]); let mut view = values.as_slice(); view[0].values[0] = 2; }",
    ] {
        testing::assert(
            has_diagnostic_containing(checked_diagnostics(source), "Slice is read-only"),
        );
    }
}

#[test]
fn readonly_slice_elements_preserve_internal_mutability() -> () {
    for source in[
        "struct Point { x: i32 } fn main() -> () { let values = Vec::from_array([Ref::new(Point { x: 1 })]); let view = values.as_slice(); view[0].get().x = 2; }",
        "struct Point { x: i32 } fn main() -> () { let values = Vec::from_array([Vec::from_array([Point { x: 1 }])]); let view = values.as_slice(); view[0][0].x = 2; }",
    ] {
        let _ = checked_file(source);
    }
}
