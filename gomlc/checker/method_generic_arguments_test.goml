package checker;

use std::testing;

#[test]
fn method_body_only_generic_arguments_are_retained_and_checked() -> () {
    for source in[
        "struct Thing {} impl Thing { fn count[const N: usize](self: Thing) -> usize { N } } fn main() -> () { let _: usize = Thing {}.count::[7](); }",
        "struct Thing {} impl Thing { fn count[const N: usize]() -> usize { N } } fn main() -> () { let f = Thing::count::[7]; let _: usize = f(); }",
        "trait Count { fn count[const N: usize](self: Self) -> usize; } struct Thing {} impl Count for Thing { fn count[const M: usize](self: Thing) -> usize { M } } fn call[T: Count](value: T) -> usize { value.count::[7]() } fn main() -> () { let _: usize = call(Thing {}); }",
        "trait Count { fn count[const N: usize](self: Self) -> usize { N } } struct Thing {} impl Count for Thing {} fn main() -> () { let f = Count::count::[7]; let _: usize = f(Thing {}); }",
        "struct Thing {} impl Thing { fn empty[T](self: Thing) -> isize { let values: Vec[T] = Vec::new(); values.len() } } fn main() -> () { let f = Thing::empty::[bool]; let _: isize = f(Thing {}); }",
    ] {
        let _ = checked_file(source);
    }
    for source in[
        "struct Thing {} impl Thing { fn count[const N: usize](self: Thing) -> usize { N } } fn main() -> () { let _ = Thing {}.count(); }",
        "trait Count { fn count[const N: usize](self: Self) -> usize { N } } struct Thing {} impl Count for Thing {} fn main() -> () { let _ = Thing {}.count(); }",
        "struct Thing {} impl Thing { fn empty[T](self: Thing) -> () {} } fn main() -> () { Thing {}.empty(); }",
        "trait Mark {} trait Check { fn check[T: Mark](self: Self) -> () {} } struct Thing {} impl Check for Thing {} fn main() -> () { Thing {}.check::[bool](); }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}

#[test]
fn retained_callable_arguments_do_not_duplicate_existing_inference_errors() -> () {
    let diagnostics = checked_diagnostics(
        "trait Mark { fn mark(self: Self) -> (); } fn require_unused[T: Mark]() -> () {} fn main() -> () { require_unused() }",
    );
    testing::assert_eq(diagnostics.len(), 2);
    for value in diagnostics {
        testing::assert(value.span.is_some());
    }
    let missing_method_argument = "struct Thing {} impl Thing { fn count[const N: usize](self: Thing) -> usize { N } } fn main() -> () { let _ = Thing {}.count(); }";
    testing::assert_eq(checked_diagnostics(missing_method_argument).len(), 1);
    let unrelated_error = "fn invalid() -> bool { 1 } ";
    let previous = checked_diagnostics(unrelated_error + "fn main() -> () {}").len();
    testing::assert(previous > 0);
    testing::assert_eq(
        checked_diagnostics(unrelated_error + missing_method_argument).len(),
        previous + 1,
    );
}

#[test]
fn warnings_do_not_suppress_missing_method_generic_arguments() -> () {
    let diagnostics = checked_diagnostics(
        "struct Thing {} impl Thing { fn count[const N: usize](self: Thing) -> usize { N } } fn main() -> () { go || {}; let _ = Thing {}.count(); }",
    );
    let mut errors = 0;
    let mut warnings = 0;
    for value in diagnostics {
        match value.severity {
            Error => {
                errors += 1;
            },
            Warning => {
                warnings += 1;
            },
        }
    }
    testing::assert_eq(errors, 1);
    testing::assert_eq(warnings, 1);
}
