package checker;

use module::tast::{Type, for_each_child_type, prune, types_equal};

fn projection_search_types_equal(left: Type, right: Type) -> bool {
    let left = prune(left);
    let right = prune(right);
    if !types_equal(left, right) {
        return false
    }
    if let (Projection { trait_ref: first, .. }, Projection { trait_ref: second, .. }) = (
        left,
        right,
    ) {
        match (first, second) {
            (Some(first), Some(second)) => if first.name != second.name {
                return false
            },
            (None, None) => (),
            _ => return false,
        }
    }
    let left_children = Vec::new();
    let right_children = Vec::new();
    for_each_child_type(left, |child| left_children.push(child));
    for_each_child_type(right, |child| right_children.push(child));
    if left_children.len() != right_children.len() {
        return false
    }
    for index in 0..left_children.len() {
        if !projection_search_types_equal(left_children[index], right_children[index]) {
            return false
        }
    }
    true
}
