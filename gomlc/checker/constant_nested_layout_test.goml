package checker;

use std::testing;

#[test]
fn accepts_finite_nested_immutable_constant_types() -> () {
    for source in[
        "struct Wrap[T] { value: T } const VALUE: Wrap[Wrap[i32]] = Wrap { value: Wrap { value: 42 } };",
        "enum Choice[T] { None, Some(T) } const VALUE: Choice[Choice[i32]] = Choice::Some(Choice::Some(42));",
        "struct Wrap[T] { value: T } enum Choice[T] { None, Some(T) } const VALUE: Wrap[Choice[Wrap[i32]]] = Wrap { value: Choice::Some(Wrap { value: 42 }) };",
        "struct Buffer[T, const N: usize] { values: [T; N] } const VALUE: Buffer[Buffer[i32, 1], 1] = Buffer { values: [Buffer { values: [42] }] };",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn rejects_mutable_payloads_hidden_by_nested_constant_types() -> () {
    for source in[
        "enum Choice[T] { None, Some(T) } const VALUE: Choice[Choice[Ref[i32]]] = Choice::None;",
        "enum Choice[T] { None, Some(T) } const VALUE: Choice[Choice[Vec[i32]]] = Choice::None;",
        "struct Wrap[T] { value: T } enum Choice[T] { None, Some(T) } const VALUE: Choice[Wrap[Choice[Ref[i32]]]] = Choice::None;",
        "enum Choice[T] { None, Some { value: T } } const VALUE: Choice[Choice[Vec[i32]]] = Choice::None;",
        "enum Recursive { None, Next(Recursive) } const VALUE: Recursive = Recursive::None;",
        "enum Recursive[T] { None, Next(Recursive[(T, T)]) } const VALUE: Recursive[i32] = Recursive::None;",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "constant type must be recursively immutable",
            ),
        );
    }
}
