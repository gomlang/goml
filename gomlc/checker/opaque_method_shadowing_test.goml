package checker;

use std::testing;

#[test]
fn opaque_methods_prefer_redeclaring_child_traits() -> () {
    let prefix = "trait Parent { fn value(self) -> i32; } trait Child: Parent { fn value(self) -> bool; } impl Parent for bool { fn value(self) -> i32 { 7 } } impl Child for bool { fn value(self) -> bool { self } } ";
    for bounds in["Child", "Child + Parent", "Parent + Child"] {
        opaque_return_accepts(
            prefix + "fn make() -> impl " + bounds
                + " { true } fn child() -> bool { make().value() } fn parent() -> i32 { Parent::value(make()) }",
        );
    }
}

#[test]
fn opaque_method_shadowing_preserves_supertrait_substitutions() -> () {
    opaque_return_accepts(
        "trait Parent[T] { fn value(self) -> T; } trait Child: Parent[Self] { fn value(self) -> bool; } impl Parent[bool] for bool { fn value(self) -> bool { self } } impl Child for bool { fn value(self) -> bool { self } } fn make() -> impl Child { true } fn child() -> bool { make().value() }",
    );
    opaque_return_accepts(
        "trait Base { fn value(self) -> i32; } trait Left: Base { fn value(self) -> bool; } trait Right: Base {} trait Top: Left + Right {} impl Base for bool { fn value(self) -> i32 { 7 } } impl Left for bool { fn value(self) -> bool { self } } impl Right for bool {} impl Top for bool {} fn make() -> impl Top { true } fn child() -> bool { make().value() }",
    );
}

#[test]
fn opaque_methods_preserve_unrelated_trait_ambiguity() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "trait Left { fn value(self) -> bool; } trait Right { fn value(self) -> bool; } impl Left for bool { fn value(self) -> bool { self } } impl Right for bool { fn value(self) -> bool { self } } fn make() -> impl Left + Right { true } fn child() -> bool { make().value() }",
            ),
            "Ambiguous method value on opaque return type",
        ),
    );
}
