package checker;

use std::testing;

#[test]
fn implementation_method_bounds_normalize_associated_types() -> () {
    for source in[
        "trait Main { type Item; fn run(self) -> i32 where Self::Item = i32; } impl Main for bool { type Item = i32; fn run(self) -> i32 where i32 = i32 { 1 } }",
        "trait Extra {} impl Extra for i32 {} trait Main { type Item; fn run(self) -> i32 where Self::Item: Extra; } impl Main for bool { type Item = i32; fn run(self) -> i32 where i32: Extra { 1 } }",
        "trait Extra[T] {} impl Extra[i32] for bool {} trait Main { type Item; fn run(self) -> i32 where bool: Extra[Self::Item]; } impl Main for bool { type Item = i32; fn run(self) -> i32 where bool: Extra[i32] { 1 } }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn implementation_method_bounds_preserve_distinct_requirements() -> () {
    for source in[
        "trait Main { type Item; fn run(self) -> i32 where Self::Item = i32; } impl Main for bool { type Item = i32; fn run(self) -> i32 where i32 = bool { 1 } }",
        "trait Main { fn run[T](self) -> i32 where T = i32; } impl Main for bool { fn run[T](self) -> i32 where T = bool { 1 } }",
        "trait Main { fn run[T](self) -> i32 where T = i32; } impl Main for bool { fn run[T](self) -> i32 where T = i32, T = bool { 1 } }",
    ] {
        testing::assert(
            has_diagnostic_containing(checked_diagnostics(source), "method bounds do not match"),
        );
    }
}
