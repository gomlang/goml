package checker;

use module::ffi;
use std::testing;
use module::tast::{TraitInfo, TraitMethodInfo, Type, foreign_bridge_type, foreign_function_bridge};

#[test]
fn foreign_bridge_preserves_tuple_and_char_representation() -> () {
    let signature = Type::Func {
        params: Vec::from_array([Type::Char]),
        ret_ty: Type::Tuple { items: Vec::from_array([Type::Int64, Type::Bool]) },
    };
    let expected = ffi::BridgeType::Function {
        parameters: Vec::from_array([ffi::BridgeType::Scalar("int32")]),
        results: Vec::from_array(
            [ffi::BridgeType::Scalar("int64"), ffi::BridgeType::Scalar("bool")],
        ),
    };
    match foreign_function_bridge(signature, Vec::new()) {
        Ok(actual) => testing::assert(ffi::bridge_types_equal(actual, expected)),
        Err(error) => testing::fail(error),
    }
    let unit_signature = Type::Func { params: Vec::new(), ret_ty: Type::Unit };
    let expected_unit = ffi::BridgeType::Function { parameters: Vec::new(), results: Vec::new() };
    match foreign_function_bridge(unit_signature, Vec::new()) {
        Ok(actual) => testing::assert(ffi::bridge_types_equal(actual, expected_unit)),
        Err(error) => testing::fail(error),
    }
}

#[test]
fn foreign_bridge_rejects_unsupported_nested_values() -> () {
    let values = Vec::from_array(
        [
            Type::Unit,
            Type::Tuple { items: Vec::from_array([Type::Bool, Type::Bool]) },
            VecType { elem: Type::Int },
            RefType { elem: Type::Int },
            Con { name: "Unknown" },
        ],
    );
    for value in values {
        testing::assert(foreign_bridge_type(value, Vec::new(), true).is_err())
    }
    let nested = Type::Tuple {
        items: Vec::from_array(
            [Type::Int, Type::Tuple { items: Vec::from_array([Type::Bool, Type::Int]) }],
        ),
    };
    testing::assert(
        foreign_function_bridge(Type::Func { params: Vec::new(), ret_ty: nested }, Vec::new()).is_err(),
    )
}

#[test]
fn foreign_marker_requires_complete_empty_trait_contract() -> () {
    let marker = TraitInfo {
        name: "Marker",
        generics: Vec::new(),
        predicates: Vec::new(),
        supertraits: Vec::new(),
        associated_types: Vec::new(),
        methods: Vec::new(),
    };
    let ty = Type::Dyn {
        trait_name: "Marker",
        args: Vec::new(),
        associated_types: Vec::new(),
        additional_bounds: Vec::new(),
    };
    testing::assert(foreign_bridge_type(ty, Vec::new(), true).is_err());
    let traits = Vec::from_array([marker]);
    testing::assert(foreign_bridge_type(ty, traits, true).is_ok());
    testing::assert(foreign_bridge_type(ty, traits, false).is_err());
    testing::assert(foreign_bridge_type(Type::Slice { elem: ty }, traits, true).is_err());
    let qualified = TraitInfo {
        name: "demo::calc::Marker",
        generics: Vec::new(),
        predicates: Vec::new(),
        supertraits: Vec::new(),
        associated_types: Vec::new(),
        methods: Vec::new(),
    };
    testing::assert(
        foreign_bridge_type(
            Dyn {
                trait_name: "demo::calc::Marker",
                args: Vec::new(),
                associated_types: Vec::new(),
                additional_bounds: Vec::new(),
            },
            Vec::from_array([qualified]),
            true,
        ).is_ok(),
    );
    testing::assert(foreign_bridge_type(ty, Vec::from_array([qualified]), true).is_err());
    marker.methods.push(
        TraitMethodInfo {
            default_map_requirements: Vec::new(),
            name: "run",
            has_receiver: true,
            generics: Vec::new(),
            predicates: Vec::new(),
            params: Vec::new(),
            ret_ty: Type::Unit,
            default_name: Option::None,
        },
    );
    testing::assert(foreign_bridge_type(ty, traits, true).is_err())
}

#[test]
fn foreign_declarations_remain_runtime_only_and_monomorphic() -> () {
    for attribute in Vec::from_array(
        ["#[go_ffi(\"example.com/host\", \"Value\")]", "#[go_method(\"Value\")]"],
    ) {
        let declaration = attribute + " extern fn value(receiver: i64) -> bool; ";
        testing::assert(checked_diagnostics(declaration).is_empty());
        let runtime_call = checked_diagnostics(
            declaration + "#[comptime] fn execute() -> bool { value(1) }",
        );
        testing::assert(
            has_diagnostic_containing(
                runtime_call,
                "comptime only supports direct #[comptime] function calls",
            ),
        );
        let invalid_attribute = checked_diagnostics("#[comptime] " + declaration);
        testing::assert(
            has_diagnostic_containing(
                invalid_attribute,
                "#[comptime] is only valid on free function declarations",
            ),
        );
        let generic = checked_diagnostics(attribute + " extern fn value[T](receiver: i64) -> bool;");
        testing::assert(has_diagnostic_containing(generic, "generic"));
        let constrained = checked_diagnostics(
            "trait Bound {} " + attribute
                + " extern fn value(receiver: i64) -> bool where i64: Bound;",
        );
        testing::assert(has_diagnostic_containing(constrained, "generic"));
    }
    let missing_receiver = checked_diagnostics("#[go_method(\"Value\")] extern fn value() -> bool;");
    testing::assert(has_diagnostic_containing(missing_receiver, "requires a receiver"));
}

#[test]
fn foreign_source_signatures_check_marker_and_tuple_boundaries_for_functions_and_methods() -> () {
    for attribute in Vec::from_array(
        ["#[go_ffi(\"example.com/host\", \"Value\")]", "#[go_method(\"Value\")]"],
    ) {
        let declarations = "trait Marker {} " + attribute;
        for signature in Vec::from_array(
            [
                " extern fn value(receiver: dyn Marker) -> dyn Marker;",
                " extern fn value(receiver: char) -> (i64, bool);",
                " extern fn value(receiver: char) -> ();",
            ],
        ) {
            let diagnostics = checked_diagnostics(declarations + signature);
            for diagnostic in diagnostics {
                testing::fail(diagnostic.message)
            }
        }
        for signature in Vec::from_array(
            [
                " extern fn value(receiver: i64) -> (i64, (bool, i64));",
                " extern fn value(receiver: (i64, bool)) -> ();",
                " extern fn value(receiver: i64) -> (dyn Marker, bool);",
                " extern fn value(receiver: Slice[dyn Marker]) -> ();",
            ],
        ) {
            testing::assert(
                has_diagnostic_containing(
                    checked_diagnostics(declarations + signature),
                    "unsupported",
                ),
            );
        }
    }
    let checked = check_external_source(
        Vec::from_array(
            [
                "package api; trait Marker {} #[go_ffi(\"example.com/host\", \"Value\")] extern fn value(receiver: dyn Marker) -> dyn Marker;",
            ],
        ),
    );
    match checked {
        Ok(result) => testing::assert(result.diagnostics.is_empty()),
        Err(error) => testing::fail(error),
    }
}

#[test]
fn foreign_named_bridge_retains_nested_type_arguments() -> () {
    let duration = Type::External { import_path: "time", name: "Duration", args: Vec::new() };
    let container = Type::External {
        import_path: "host",
        name: "Box",
        args: Vec::from_array([duration]),
    };
    let expected_duration = ffi::BridgeType::Named {
        import_path: "time",
        name: "Duration",
        arguments: Vec::new(),
    };
    let expected = ffi::BridgeType::Named {
        import_path: "host",
        name: "Box",
        arguments: Vec::from_array([expected_duration]),
    };
    match foreign_bridge_type(container, Vec::new(), true) {
        Ok(actual) => testing::assert(ffi::bridge_types_equal(actual, expected)),
        Err(error) => testing::fail(error),
    }
    for arg in Vec::from_array(
        [Type::Param { name: "T" }, Type::Unit, Type::RefType { elem: Type::Int64 }],
    ) {
        testing::assert(
            foreign_bridge_type(
                External { import_path: "host", name: "Box", args: Vec::from_array([arg]) },
                Vec::new(),
                true,
            ).is_err(),
        )
    }
    testing::assert(
        foreign_bridge_type(
            External { import_path: "host", name: "private", args: Vec::new() },
            Vec::new(),
            true,
        ).is_err(),
    );
}
