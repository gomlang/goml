package checker;

use std::testing;

#[test]
fn associated_type_definitions_cannot_prove_their_own_bounds() -> () {
    for source in[
        "trait Mark {} trait Source { type Item: Mark; } struct Value {} struct Item {} impl Source for Value { type Item = Item; }",
        "trait Mark {} trait Source { type Item: Mark; } struct Value[T] { value: T } impl[T] Source for Value[T] { type Item = T; }",
    ] {
        testing::assert(
            has_diagnostic_containing(checked_diagnostics(source), "does not satisfy bound Mark"),
        );
    }
    let _ = checked_file(
        "trait Mark {} trait Source { type Item: Mark; } struct Value[T] { value: T } impl[T: Mark] Source for Value[T] { type Item = T; }",
    );
}
