package checker;

use module::ast;
use module::hir;
use module::tast::{TraitRef, Type, TypePredicate, prune, type_text};

fn implementation_definition_is_local(ctx: Checker, definition: hir::DefId) -> bool {
    match definition {
        Source { package_name, .. } => package_name == ctx.package_name,
        External { .. } => false,
    }
}

fn implementation_target_ownership(ctx: Checker, target: Type) -> Option[bool] {
    match prune(normalize_type(ctx, target)) {
        Con { name } | App { ty: Con { name }, .. } => {
            if let Some(info) = find_struct_by_name(ctx, name) {
                return Some(implementation_definition_is_local(ctx, info.def_id))
            }
            if let Some(info) = find_enum_by_name(ctx, name) {
                return Some(implementation_definition_is_local(ctx, info.def_id))
            }
            if builtin_nominal_arity(name).is_some() {
                Some(ctx.owns_intrinsic_types)
            } else {
                None
            }
        },
        Error => None,
        Unit | Bool | Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | Float32 | Float64 | String | Char | Array {
            ..,
        } | Slice { .. } | MutSlice { .. } | VecType { .. } | GoPointer { .. } | GoFunction { .. } | RefType {
            ..,
        } | HashMap { .. } | GoMap { .. } | Channel { .. } => Some(ctx.owns_intrinsic_types),
        _ => Some(false),
    }
}

fn validate_impl_ownership(
    ctx: Checker,
    reference: Option[TraitRef],
    target: Type,
    generics: Vec[string],
    predicates: Vec[TypePredicate],
    span: Option[ast::Span],
) -> bool {
    if let Some(reference) = reference {
        match find_trait(ctx, reference.name) {
            Some(info) => if ctx.local_trait_names.contains(info.name) {
                return true
            },
            None => return true,
        }
    }
    let owner_ctx = function_context(
        ctx,
        Type::Unit,
        Some(target),
        generics,
        predicates,
        false,
        false,
        false,
        RuntimeOnly,
    );
    match implementation_target_ownership(owner_ctx, target) {
        Some(false) => {
            let message = match reference {
                Some(reference) => "Orphan implementation: trait " + reference.name
                    + " and target type "
                    + type_text(target)
                    + " are both defined outside the current package",
                None => "Inherent implementation target " + type_text(target)
                    + " must be a nominal type defined in the current package",
            };
            push_diagnostic_at(ctx, message, span);
            false
        },
        _ => true,
    }
}
