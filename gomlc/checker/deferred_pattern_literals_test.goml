package checker;

use std::testing;

#[test]
fn deferred_pattern_literals_validate_final_numeric_types() -> () {
    for source in[
        "fn main() -> () { let test = |value| match value { 300 => true, _ => false }; let n: u8 = 1; let _ = test(n); }",
        "fn main() -> () { let test = |value| match value { -129 => true, _ => false }; let n: i8 = 1; let _ = test(n); }",
        "fn main() -> () { let test = |value| match value { -1 => true, _ => false }; let n: u8 = 1; let _ = test(n); }",
        "fn main() -> () { let test = |value| match value { 0..=300 => true, _ => false }; let n: u8 = 1; let _ = test(n); }",
        "fn main() -> () { let test = |value| match value { Option::Some((300, _)) => true, _ => false }; let n: u8 = 1; let _ = test(Some((n, true))); }",
    ] {
        testing::assert(has_diagnostic_containing(checked_diagnostics(source), "does not fit"));
    }
    for source in[
        "fn main() -> () { let test = |value| match value { 1.5 => true, _ => false }; let n: i32 = 1; let _ = test(n); }",
        "fn main() -> () { let test = |value| match value { 3.5e38 => true, _ => false }; let n: f32 = 1.0; let _ = test(n); }",
    ] {
        testing::assert(
            has_diagnostic_containing(checked_diagnostics(source), "cannot be represented"),
        );
    }
    for source in[
        "fn main() -> () { let test = |value| match value { 255 => true, _ => false }; let n: u8 = 255; let _ = test(n); }",
        "fn main() -> () { let test = |value| match value { -128 => true, _ => false }; let n: i8 = -128; let _ = test(n); }",
        "fn main() -> () { let test = |value| match value { 0.0 => false, 1..=255 => true }; let n: u8 = 1; let _ = test(n); }",
        "#[comptime] fn nonzero(value: u8) -> bool { let test = |x| match x { 0.0 => false, 1..=255 => true }; test(value) }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn deferred_float_patterns_use_final_rounding_for_coverage() -> () {
    let diagnostics = checked_diagnostics(
        "fn main() -> () { let test = |value| match value { 16777217.0 => 1, 16777216.0 => 2, _ => 3 }; let n: f32 = 16777216.0; let _ = test(n); }",
    );
    testing::assert(has_diagnostic_containing(diagnostics, "Unreachable match arm"));
}

#[test]
fn deferred_numeric_patterns_in_constant_initializers() -> () {
    let _ = checked_file(
        "const VALUE: bool = { let test = |x| match x { 0.0 => false, 1..=255 => true }; let n: u8 = 1; test(n) }; fn main() -> () {}",
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "const VALUE: bool = { let test = |x| match x { 300 => true, _ => false }; let n: u8 = 1; test(n) }; fn main() -> () {}",
            ),
            "does not fit",
        ),
    );
}
