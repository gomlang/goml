package checker;

use std::testing;
use module::tast::{Type};

#[test]
fn nominal_const_requirements_canonicalize_identity_recursion() -> () {
    for expression in["N + 0", "0 + N", "N - 0", "N * 1", "1 * N", "N / 1"] {
        let source = "enum Chain[const N: usize] { End, Next(Chain[{" + expression
            + "}]), Values([i32; N]) } fn valid(value: Chain[1]) -> () {}";
        let _ = checked_file(source);
    }
}

#[test]
fn nominal_const_requirements_preserve_invalid_identity_operands() -> () {
    for expression in[
        "(N / 0) + 0",
        "0 + (N / 0)",
        "(N / 0) - 0",
        "(N / 0) * 1",
        "1 * (N / 0)",
        "(N / 0) / 1",
    ] {
        let source = "struct Wrap[const N: usize] { values: [i32; " + expression
            + "] } fn invalid(value: Wrap[1]) -> () {}";
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "division by zero in constant expression",
            ),
        );
    }
}

#[test]
fn expanding_nominal_const_requirements_stop_before_exponential_substitution() -> () {
    let diagnostics = checked_diagnostics(
        "enum Expanding[const N: usize] { End, Next(Expanding[{N + N}]), Values([i32; N]) }",
    );
    testing::assert(has_diagnostic_containing(diagnostics, NOMINAL_CONST_COMPLEXITY_ERROR));
}

#[test]
fn nominal_const_substitution_budget_counts_replaced_subtrees() -> () {
    let parameter = Type::Param { name: "$const_param:N" };
    let mut growing = parameter;
    for _ in 0..20 {
        growing = Type::App {
            ty: Type::Con { name: "$const_op:+" },
            args: Vec::from_array([growing, growing]),
        };
    }
    testing::assert(
        !const_requirement_substitution_allowed(
            parameter,
            Vec::from_array(["$const_param:N"]),
            Vec::from_array([growing]),
        ),
    );
    testing::assert(!const_requirement_substitution_allowed(growing, Vec::new(), Vec::new()));
    testing::assert(
        const_requirement_substitution_allowed(
            parameter,
            Vec::from_array(["$const_param:N"]),
            Vec::from_array([parameter]),
        ),
    );
}
