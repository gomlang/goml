package checker;

use std::testing;

#[test]
fn integer_operator_operands_infer_from_later_closure_calls() -> () {
    for operator in["<<", ">>", "&", "|", "^", "%"] {
        let _ = checked_file(
            "fn f() -> i32 { let apply = |value| value " + operator + " 1; apply(7) }",
        );
        let _ = checked_file(
            "fn f() -> i32 { let apply = |left, right| left " + operator + " right; apply(7, 1) }",
        );
    }
    for source in[
        "fn f() -> i32 { let apply = |value| ~value; apply(7) }",
        "fn f() -> i32 { let apply = |value| -value; apply(7) }",
        "fn f() -> f64 { let apply = |value| -value; apply(1.5) }",
        "fn f(value: u8, count: usize) -> u8 { let apply = |left, right| left << right; apply(value, count) }",
        "fn f(value: i64, count: u8) -> i64 { let apply = |left, right| left >> right; apply(value, count) }",
        "fn f() -> i32 { let apply = |value| { let nested = |inner| ~inner; nested(value) }; apply(7) }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn inferred_operator_operands_keep_final_numeric_restrictions() -> () {
    for source in[
        "fn f() -> () { let apply = |value| value << 1; let _ = apply(true); }",
        "fn f() -> () { let apply = |value| value << 1; let _ = apply(1.5); }",
        "fn f() -> () { let apply = |count| 1 >> count; let _ = apply(1.5); }",
        "fn f() -> () { let apply = |left, right| left & right; let _ = apply(true, false); }",
        "fn f() -> () { let apply = |value| value % 2; let _ = apply(1.5); }",
        "fn f() -> () { let apply = |value| ~value; let _ = apply(1.5); }",
        "fn f(value: u32) -> () { let apply = |item| -item; let _ = apply(value); }",
        "fn f() -> () { let apply = |value| -value; let _ = apply(\"bad\"); }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}
