package checker;

use std::testing;

#[test]
fn dyn_supertraits_normalize_chained_associated_arguments() -> () {
    let prefix = "trait Nested { type Output; } impl Nested for bool { type Output = i32; } trait Source { type Item: Nested; } trait Parent[T] { fn take(self, value: T) -> i32; } ";
    for argument in["Self::Item::Output", "Vec[Self::Item::Output]", "(Self::Item::Output, bool)"] {
        let concrete = match argument {
            "Self::Item::Output" => "i32",
            "Vec[Self::Item::Output]" => "Vec[i32]",
            _ => "(i32, bool)",
        };
        let _ = checked_file(
            prefix + "trait Child: Source + Parent[" + argument
                + "] {} fn choose(value: dyn Child[Item = bool], input: "
                + concrete
                + ") -> i32 { value.take(input) }",
        );
    }
}

#[test]
fn dyn_chained_supertraits_preserve_argument_type_errors() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "trait Nested { type Output; } impl Nested for bool { type Output = i32; } trait Source { type Item: Nested; } trait Parent[T] { fn take(self, value: T) -> i32; } trait Child: Source + Parent[Self::Item::Output] {} fn choose(value: dyn Child[Item = bool]) -> i32 { value.take(false) }",
            ),
            "Type mismatch",
        ),
    );
}
