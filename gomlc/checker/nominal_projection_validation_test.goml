package checker;

use std::testing;

#[test]
fn nominal_fields_reject_unconstrained_associated_type_projections() -> () {
    for definition in[
        "enum Holder[T] { Value(T::Missing) }",
        "enum Holder[T] { Value { item: T::Missing } }",
        "struct Holder[T] { item: T::Missing }",
        "struct Holder[T](T::Missing);",
        "struct Holder[T] { item: Vec[T::Missing] }",
        "struct Holder[T] { item: (bool, T::Missing) }",
        "struct Holder[T] { item: (T::Missing) -> bool }",
        "struct Holder[T] { item: [T::Missing; 0] }",
        "trait Read { type Item; } struct Holder[T] { item: dyn Read[Item = T::Missing] }",
        "trait Source { type Item; } struct Holder[T] { item: T::Item }",
        "trait Source { type Item; } impl[T] Source for Vec[T] { type Item = (); } enum Holder[T] { Value(T::Item) }",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(definition),
                "is not provided by a trait bound",
            ),
        );
    }
}

#[test]
fn nominal_payload_parameters_accept_projections_at_constrained_use_sites() -> () {
    for body in[
        "struct Holder[T] { item: T } fn make[T: Source](item: T::Item) -> Holder[T::Item] { Holder { item } }",
        "enum Holder[T] { Value(T) } fn make[T: Source](item: T::Item) -> Holder[T::Item] { Holder::Value(item) }",
        "struct Holder[T](T); fn make[T: Source](item: T::Item) -> Holder[T::Item] { Holder(item) }",
        "struct Holder[T] { item: dyn Read[Item = T] } fn make[T: Source](item: dyn Read[Item = T::Item]) -> Holder[T::Item] { Holder { item } }",
    ] {
        let _ = checked_file("trait Source { type Item; } trait Read { type Item; } " + body);
    }
}
