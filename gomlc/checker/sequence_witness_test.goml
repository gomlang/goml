package checker;

use std::testing;

#[test]
fn nested_sequence_witnesses_preserve_sibling_fields() -> () {
    for source in[
        "fn f(value: (Vec[bool], bool)) -> bool { match value { ([], true) => true } }",
        "fn f(value: (bool, Vec[bool], bool)) -> bool { match value { (true, [], true) => true } }",
        "enum Pair { Both(Vec[bool], bool) } fn f(value: Pair) -> bool { match value { Both([], true) => true } }",
        "fn f[const N: usize](value: ([bool; N], bool)) -> bool { match value { ([..], true) => true } }",
        "fn f(value: (Vec[bool], (Vec[bool], bool))) -> bool { match value { ([], ([], true)) => true } }",
    ] {
        testing::assert(
            has_diagnostic_containing(checked_diagnostics(source), "non-exhaustive match"),
        );
    }
}

#[test]
fn nested_sequence_witnesses_retain_the_missing_sibling_value() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "fn f(value: (Vec[bool], bool)) -> bool { match value { ([..], true) => true } }",
            ),
            "(_, false)",
        ),
    );
    let _ = checked_file(
        "fn f(value: (Vec[bool], bool)) -> bool { match value { ([..], true) => true, ([..], false) => false } }",
    );
}
