package checker;

use std::testing;
use module::tast::{Type, TypeSubst, TraitRef, builtin_contract};

#[test]
fn projected_owner_equalities_do_not_imply_infinite_types() -> () {
    for source in[
        "trait Source { type Item; } fn identity[T: Source](value: T) -> Vec[T::Item] where T = Vec[T::Item] { value }",
        "trait Source { type Item; } fn identity[T: Source](value: Vec[T::Item]) -> T where T = Vec[T::Item] { value }",
        "trait Source { type Item; } fn identity[T: Source](value: T) -> (T::Item, T::Item) where T = (T::Item, T::Item) { value }",
        "trait Source { type Item; } fn identity[T: Source](value: T) -> Option[T::Item] where T = Option[T::Item] { value }",
        "trait Source { type Item; } fn identity[T: Source](value: T) -> Vec[T::Item] where Vec[T::Item] = T { value }",
        "trait Source { type Item; } fn identity[T: Source, U: Source](value: T) -> Vec[T::Item] where T = U, U = Vec[T::Item] { value }",
        "trait Source { type Item; } fn identity[T: Source, U: Source](value: T) -> Vec[U::Item] where U = T, T = Vec[U::Item] { value }",
        "trait Source[A] { type Item; } fn identity[T: Source[i32]](value: T) -> Vec[T::Item] where T = Vec[T::Item] { value }",
        "trait Source { type Item; } impl Source for Vec[i32] { type Item = i32; } fn identity[T: Source](value: T) -> Vec[T::Item] where T = Vec[T::Item] { value } fn main() -> () { let values: Vec[i32] = Vec::from_array([1]); let result: Vec[i32] = identity(values); }",
    ] {
        let _ = checked_file(source);
    }
}

#[test]
fn projected_owner_equalities_preserve_payload_mismatches_and_structural_cycles() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "trait Source { type Item; } fn invalid[T: Source](value: T) -> bool where T = Vec[T::Item] { value }",
            ),
            "Type mismatch",
        ),
    );
    for source in[
        "trait Source { type Item; } fn invalid[T: Source](value: T) -> T where T = (T, T::Item) { value }",
        "trait Source { type Item; } fn invalid[T: Source](value: T::Item) -> () where T::Item = Vec[T::Item] {}",
        "trait Source { type Item; } fn invalid[T: Source, U](value: U) -> U where T::Item = U, U = Vec[T::Item] { value }",
    ] {
        testing::assert(
            has_diagnostic_containing(checked_diagnostics(source), "cyclic type equality"),
        );
    }
}

#[test]
fn projected_owner_requirement_walks_visit_finite_siblings() -> () {
    let ctx = collect_environment(
        dependency_hir("package api; trait Source { type Item; }", "audit::api"),
        false,
        testing::expect_ok(builtin_contract(), "builtin contract"),
    );
    let owner = Type::Param { name: "T" };
    let item = Type::Projection {
        for_ty: owner,
        name: "Item",
        trait_ref: Some(TraitRef { name: "audit::api::Source", args: Vec::new() }),
    };
    ctx.param_aliases.push(TypeSubst { name: "T", ty: Type::VecType { elem: item } });
    let map = Type::GoMap { key: Type::Slice { elem: Type::Int32 }, value: Type::Bool };
    let map_types = Type::Tuple { items: Vec::from_array([owner, owner, map]) };
    let maps = Vec::new();
    collect_type_map_requirements(ctx, map_types, maps);
    testing::assert_eq(maps.len(), 1);
    let raw = Type::GoFunction {
        signature: Type::Func {
            params: Vec::from_array([Type::VecType { elem: Type::Int32 }]),
            ret_ty: Type::Unit,
        },
    };
    let raw_types = Type::Tuple { items: Vec::from_array([owner, owner, raw]) };
    let functions = Vec::new();
    collect_type_raw_function_requirements(ctx, raw_types, functions);
    testing::assert_eq(functions.len(), 1);
    testing::assert(invalid_go_function_signature(ctx, raw_types).is_some());
    let array = Type::Array { len: -1, elem: Type::Int32 };
    let array_types = Type::Tuple { items: Vec::from_array([owner, owner, array]) };
    let lengths = Vec::new();
    testing::assert(collect_type_const_requirements(ctx, array_types, lengths));
    testing::assert_eq(lengths.len(), 1);
    testing::assert(instantiated_const_type_error(ctx, array_types).is_some());
}
