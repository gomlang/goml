package checker;

use std::testing;

#[test]
fn rejects_invalid_constant_lengths_in_instantiated_function_values() -> () {
    for expression in["N / 0", "N % 0", "(N / 0) + 1"] {
        let source = "fn invalid[const N: usize](value: [i32; " + expression
            + "]) -> () {} fn main() -> () { let _ = invalid::[1]; }";
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(source),
                "division by zero in constant expression",
            ),
        );
    }
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "fn invalid[const N: usize](value: [i32; N - 2]) -> () {} fn main() -> () { let _ = invalid::[1]; }",
            ),
            "const usize argument must be nonnegative",
        ),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "fn invalid[const N: usize](value: [i32; N + 1]) -> () {} fn main() -> () { let _ = invalid::[9223372036854775807]; }",
            ),
            "integer overflow in constant expression",
        ),
    );
}

#[test]
fn rejects_invalid_constant_lengths_after_call_inference() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "fn shorter[const N: usize](value: [i32; N]) -> [i32; N - 2] { [0; N - 2] } fn main() -> () { let _ = shorter([0]); }",
            ),
            "const usize argument must be nonnegative",
        ),
    );
}

#[test]
fn rejects_invalid_constant_lengths_in_instantiated_method_values() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "struct Reader {} impl Reader { fn invalid[const N: usize](self: Reader, value: [i32; N / 0]) -> () {} } fn main() -> () { let _ = Reader::invalid::[1]; }",
            ),
            "division by zero in constant expression",
        ),
    );
}

#[test]
fn reports_one_instantiated_constant_error_per_function() -> () {
    let diagnostics = checked_diagnostics(
        "fn invalid[const N: usize](value: [i32; N / 0]) -> () {} fn main() -> () { let callback = invalid::[1]; let _ = callback; }",
    );
    let mut count = 0;
    for diagnostic in diagnostics {
        if diagnostic.message.contains("division by zero in constant expression") {
            count += 1;
        }
    }
    testing::assert_eq(count, 1);
}

#[test]
fn accepts_valid_instantiated_and_symbolic_constant_signatures() -> () {
    for source in[
        "fn valid[const N: usize](value: [i32; N + 1]) -> () {} fn main() -> () { let _ = valid::[1]; }",
        "fn valid[const N: usize](value: [i32; (N - 3) + 4]) -> () {} fn main() -> () { let _ = valid::[1]; }",
        "fn shorter[const N: usize](value: [i32; N]) -> [i32; N - 2] { [0; N - 2] } fn main() -> () { let _ = shorter([0, 1, 2]); }",
        "fn valid[const N: usize](value: [i32; N + 1]) -> () {} fn symbolic[const N: usize]() -> () { let _ = valid::[N]; }",
    ] {
        let _ = checked_file(source);
    }
}
