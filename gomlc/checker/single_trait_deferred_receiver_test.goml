package checker;

use std::testing;

fn single_trait_receiver_declarations() -> string {
    "trait Read { fn read(self: Self) -> i32; } struct A {} impl Read for A { fn read(self: A) -> i32 { 1 } } struct B {} impl B { fn read(self: B) -> bool { true } } struct C { read: () -> string } "
}

#[test]
fn unrelated_single_trait_candidates_do_not_block_later_receivers() -> () {
    for body in[
        "fn f() -> bool { let read = |x| x.read(); read(B {}) }",
        "fn f() -> i32 { let read = |x| x.read(); read(A {}) }",
        "fn f() -> string { let read = |x| x.read(); read(C { read: || \"ok\" }) }",
    ] {
        if !checked_diagnostics(single_trait_receiver_declarations() + body).is_empty() {
            testing::fail(body)
        }
    }
    testing::assert(
        !checked_diagnostics(
            single_trait_receiver_declarations()
                + "fn f() -> i32 { let read = |x| x.read(); read(B {}) }",
        ).is_empty(),
    );
    testing::assert(
        !checked_diagnostics(
            single_trait_receiver_declarations()
                + "fn f() -> () { let read = |x| x.read(); let _ = read(true); }",
        ).is_empty(),
    );
}
