package checker;

use module::diagnostic::{DiagnosticSeverity};
use std::testing;

#[test]
fn strict_expression_inputs_propagate_divergence() -> () {
    let prefix = "fn stop() -> never { loop {} } struct S { value: i32 } enum E { Value(i32) } fn take(value: i32) -> () {} ";
    for source in[
        "fn f() -> never { (stop(), true); }",
        "fn f() -> never { [stop()]; }",
        "fn f() -> never { [stop(); 0]; }",
        "fn f() -> never { S { value: stop() }; }",
        "fn f() -> never { E::Value(stop()); }",
        "fn f() -> never { take(stop()); }",
        "fn f() -> never { go take(stop()); }",
        "fn f() -> never { (stop(), true) }",
        "fn f() -> never { [stop()] }",
        "fn f() -> never { [stop(); 0] }",
        "fn f() -> never { S { value: stop() } }",
        "fn f() -> never { E::Value(stop()) }",
        "fn f() -> never { take(stop()) }",
        "fn f() -> i32 { [return 7]; }",
        "fn f() -> i32 { (return 7, true) }",
        "fn f() -> i32 { take(return 7) }",
        "fn id[T](value: T) -> T { value } fn f() -> never { id(stop()); }",
        "fn f() -> () { let _ = false && stop(); let _ = true || stop(); }",
    ] {
        for diagnostic in checked_diagnostics(prefix + source) {
            if let DiagnosticSeverity::Error = diagnostic.severity {
                testing::fail(source + "\n" + diagnostic.message)
            }
        }
    }
}

#[test]
fn strict_divergence_preserves_lazy_evaluation_and_other_type_errors() -> () {
    let prefix = "fn stop() -> never { loop {} } fn take(first: i32, second: bool) -> () {} ";
    for source in[
        "fn f() -> never { false && stop(); }",
        "fn f() -> never { true || stop(); }",
        "fn f() -> never { let callback = || stop(); }",
        "fn f() -> never { let callback: () -> () = || stop(); go callback; }",
        "fn f() -> i32 { (true, false) }",
        "fn f() -> i32 { [true] }",
        "fn f() -> i32 { take(1, true) }",
    ] {
        if !has_diagnostic_containing(checked_diagnostics(prefix + source), "Type mismatch") {
            testing::fail(source)
        }
    }
    let invalid_argument = "fn f() -> never { take(stop(), 1); }";
    if !has_diagnostic_containing(
        checked_diagnostics(prefix + invalid_argument),
        "Numeric literal cannot be used as bool",
    ) {
        testing::fail(invalid_argument)
    }
}
