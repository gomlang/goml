package checker;

use std::testing;

#[test]
fn dyn_numeric_inference_rejects_multiple_nondefault_candidates() -> () {
    let header = "trait Tag { fn tag(self) -> string; } ";
    for implementations in[
        "impl Tag for i32 { fn tag(self) -> string { \"i32\" } } impl Tag for i64 { fn tag(self) -> string { \"i64\" } }",
        "impl Tag for i64 { fn tag(self) -> string { \"i64\" } } impl Tag for i32 { fn tag(self) -> string { \"i32\" } }",
        "impl Tag for u32 { fn tag(self) -> string { \"u32\" } } impl Tag for i32 { fn tag(self) -> string { \"i32\" } }",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(
                    header + implementations + " fn make() -> dyn Tag { 7 as dyn Tag }",
                ),
                "Ambiguous numeric type for dyn conversion",
            ),
        );
    }
}

#[test]
fn dyn_numeric_inference_preserves_defaults_annotations_and_unique_candidates() -> () {
    for source in[
        "trait Tag {} impl Tag for i32 {} impl Tag for i64 {} fn make() -> dyn Tag { let value: i32 = 7; value as dyn Tag }",
        "trait Tag {} impl Tag for i32 {} impl Tag for isize {} fn make() -> dyn Tag { 7 as dyn Tag }",
        "trait Tag {} impl Tag for f32 {} impl Tag for f64 {} fn make() -> dyn Tag { 7.0 as dyn Tag }",
        "trait First {} trait Second {} impl First for i32 {} impl Second for i32 {} fn make() -> dyn First + Second { 7 as dyn First + Second }",
        "trait Tag[T] {} impl Tag[bool] for i32 {} impl Tag[string] for i64 {} fn make() -> dyn Tag[bool] { 7 as dyn Tag[bool] }",
        "trait Tag { type Item; } impl Tag for i32 { type Item = bool; } impl Tag for i64 { type Item = string; } fn make() -> dyn Tag[Item = bool] { 7 as dyn Tag[Item = bool] }",
    ] {
        let _ = checked_file(source);
    }
}
