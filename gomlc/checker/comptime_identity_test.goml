package checker;

use module::ctir;
use std::testing;
use module::tast::{ConstExpr, Constant, File, Primitive, Type, builtin_contract, integer_constant_value};

#[test]
fn comptime_constant_references_preserve_canonical_package_names() -> () {
    let Ok(builtin) = builtin_contract() else {
        testing::fail("missing builtin contract");
        return
    };
    let dependency = ctir::empty_module("example::widths");
    dependency.constants.push(
        ctir::CtConstant {
            name: "example::widths::SIZE",
            value: ctir::CtValue::Integer { signed: true, width: 64, bits: 2 },
        },
    );
    for package_name in Vec::from_array(["example::api", "main"]) {
        let local_name = if package_name == "main" {
            "SIZE"
        } else {
            "example::api::SIZE"
        };
        let alias_name = if package_name == "main" {
            "WIDTH"
        } else {
            "example::api::WIDTH"
        };
        let file = File {
            items: Vec::new(),
            enums: Vec::new(),
            structs: Vec::new(),
            statics: Vec::new(),
            constants: Vec::from_array(
                [
                    Constant {
                        name: local_name,
                        ty: Type::Int,
                        value: ConstExpr::Prim {
                            value: Primitive::Int { value: "3" },
                            ty: Type::Int,
                        },
                    },
                    Constant {
                        name: alias_name,
                        ty: Type::Int,
                        value: ConstExpr::Ref { name: "example::widths::SIZE", ty: Type::Int },
                    },
                ],
            ),
        };
        let result = finalize_comptime(
            builtin,
            file,
            Vec::new(),
            package_name,
            Vec::from_array([dependency]),
            Vec::new(),
            Vec::new(),
        );
        testing::assert_eq(result.diagnostics.len(), 0);
        let value = testing::expect_some(
            module_constant_primitive(result.module, alias_name, Type::Int),
            "expected evaluated imported constant",
        );
        testing::assert_eq(
            testing::expect_some(integer_constant_value(value), "expected an integer constant"),
            2,
        );
    }
}
