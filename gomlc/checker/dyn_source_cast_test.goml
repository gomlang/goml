package checker;

use module::tast::{Expr, Item, Type};
use std::testing;

#[test]
fn constrained_dyn_cast_sources_preserve_existing_objects() -> () {
    for source in[
        "trait Read { fn read(self: Self) -> i32; } fn wrap[T](value: T) -> dyn Read where T = dyn Read { value as dyn Read }",
        "trait Read { fn read(self: Self) -> i32; } trait Source { type Item; } fn wrap[I: Source](value: I::Item) -> dyn Read where I::Item = dyn Read { value as dyn Read }",
        "trait Read { fn read(self: Self) -> i32; } trait Tag {} fn wrap[T](value: T) -> dyn Tag + Read where T = dyn Read + Tag { value as dyn Tag + Read }",
    ] {
        let file = checked_file(source);
        let Item::Function(function) = file.items[0] else {
            testing::fail("expected cast function");
            continue
        };
        match function.body.tail {
            Some(Expr::Var { ty: Type::Dyn { .. }, .. }) => (),
            _ => testing::fail("identity dyn cast must preserve its existing object"),
        }
    }
    for source in[
        "trait Read { fn read(self: Self) -> i32; } trait Tag {} fn wrap[T](value: T) -> dyn Read where T = dyn Read + Tag { value as dyn Read }",
        "trait Read { fn read(self: Self) -> i32; } trait Child: Read {} fn wrap[T](value: T) -> dyn Read where T = dyn Child { value as dyn Read }",
        "trait Source { type Item; fn get(self: Self) -> Self::Item; } fn wrap[T](value: T) -> dyn Source[Item = bool] where T = dyn Source[Item = i32] { value as dyn Source[Item = bool] }",
    ] {
        testing::assert(
            has_diagnostic_containing(checked_diagnostics(source), "dyn trait mismatch"),
        );
    }
}
