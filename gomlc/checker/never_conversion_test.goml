package checker;

use std::testing;

#[test]
fn divergent_values_do_not_require_conversion_traits() -> () {
    for source in[
        "trait Read { fn read(self: Self) -> i32; } fn run() -> () { let value = (return) as dyn Read; }",
        "trait Read { fn read(self: Self) -> i32; } fn run() -> i32 { (return 7) as dyn Read }",
        "fn run() -> i32 { f\"before{(return 7)}after\" }",
        "fn run[T](value: T) -> i32 where T = never { f\"{value}\" }",
        "fn run() -> () { let value = f\"before{(return)}after\"; }",
        "trait Read { fn read(self: Self) -> i32; } fn run[T](value: T) -> dyn Read where T = never { value as dyn Read }",
    ] {
        let _ = checked_file(source);
    }
    for source in[
        "trait Read { fn read(self: Self) -> i32; } fn run() -> dyn Read { 1 as dyn Read }",
        "struct Item {} fn run() -> string { f\"{Item {}}\" }",
        "fn run() -> i32 { f\"ordinary\" }",
    ] {
        testing::assert(!checked_diagnostics(source).is_empty());
    }
}
