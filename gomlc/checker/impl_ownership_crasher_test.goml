package checker;

use std::testing;

#[test]
fn dynamic_builtin_trait_impls_require_local_nominal_owners() -> () {
    for source in[
        "impl PartialEq for dyn Hash {\n    fn eq(self: dyn Hash, other: dyn Hash) -> bool {\n        Hash::hash(self) == Hash::hash(other)\n    }\n}\n\nimpl Eq for dyn Hash {}\n\nfn main() {\n    let h: HashMap[dyn Hash, string] = HashMap::new();\n    let inner: dyn Hash = 1 as dyn Hash;\n    h.set(inner, \"one\");\n    println(h.contains(inner).to_string());\n}\n",
        "impl PartialEq for dyn Hash {\n    fn eq(self: dyn Hash, other: dyn Hash) -> bool {\n        Hash::hash(self) == Hash::hash(other)\n    }\n}\n\nimpl Eq for dyn Hash {}\n\nfn main() -> () {\n    let h: HashMap[Ref[dyn Hash], string] = HashMap::new();\n    let inner: dyn Hash = 1 as dyn Hash;\n    let r = Ref::new(inner);\n    h.set(r, \"one\");\n    println(h.contains(r).to_string());\n}\n",
        "trait Display {\n    fn show(self: Self) -> string;\n}\n\nimpl Display for i32 {\n    fn show(self: i32) -> string {\n        self.to_string()\n    }\n}\n\nimpl Hash for dyn Display {\n    fn hash(self: dyn Display) -> u64 {\n        string_hash(Display::show(self))\n    }\n}\n\nfn main() -> () {\n    let first: i32 = 1;\n    let inner: dyn Display = first as dyn Display;\n    let r = Ref::new(inner);\n    let alias = r;\n    let before = Hash::hash(r);\n    let second: i32 = 2;\n    let replacement: dyn Display = second as dyn Display;\n    r.set(replacement);\n    println((before == Hash::hash(alias)).to_string());\n}\n",
    ] {
        testing::assert(
            has_diagnostic_containing(checked_diagnostics(source), "Orphan implementation:"),
        );
    }
}
