package checker;

use std::testing;

#[test]
fn let_else_exits_use_final_callback_and_method_types() -> () {
    for source in[
        "fn stop() -> never { loop {} } fn f() -> () { let run = |stop| { let Some(value) = Option::Some(7) else { stop() }; let _: i32 = value; }; run(stop); }",
        "fn stop() -> never { loop {} } fn f() -> () { let run = |stop| { let Some(value) = Option::Some(7) else { stop(); }; let _: i32 = value; }; run(stop); }",
        "fn stop() -> never { loop {} } fn f(flag: bool) -> () { let run = |stop| { let Some(value) = Option::Some(7) else { if flag { stop(); } else { stop(); } }; let _: i32 = value; }; run(stop); }",
        "fn stop() -> never { loop {} } fn f(flag: bool) -> () { let run = |stop| { let Some(value) = Option::Some(7) else { match flag { true => { stop(); }, false => { stop(); } } }; let _: i32 = value; }; run(stop); }",
        "struct Stop {} impl Stop { fn stop(self: Stop) -> never { loop {} } } fn f() -> () { let run = |receiver| { let Some(value) = Option::Some(7) else { receiver.stop(); }; let _: i32 = value; }; run(Stop {}); }",
    ] {
        if !checked_diagnostics(source).is_empty() {
            testing::fail(source)
        }
    }
}

#[test]
fn let_else_exits_reject_callbacks_that_can_return() -> () {
    for source in[
        "fn stop() -> () {} fn f() -> () { let run = |stop| { let Some(value) = Option::Some(7) else { stop() }; let _: i32 = value; }; run(stop); }",
        "fn stop() -> i32 { 1 } fn f() -> () { let run = |stop| { let Some(value) = Option::Some(7) else { stop(); }; let _: i32 = value; }; run(stop); }",
        "fn stop() -> never { loop {} } fn f(flag: bool) -> () { let run = |stop| { let Some(value) = Option::Some(7) else { if flag { stop(); } }; let _: i32 = value; }; run(stop); }",
        "fn stop() -> never { loop {} } fn f(flag: bool) -> () { let run = |stop| { let Some(value) = Option::Some(7) else { match flag { true => { stop(); }, false => () } }; let _: i32 = value; }; run(stop); }",
        "fn stop() -> never { loop {} } fn f() -> () { let run = |stop| { let Some(value) = Option::Some(7) else { let task = || { stop(); }; }; let _: i32 = value; }; run(stop); }",
        "fn f() -> () { let Some(value) = Option::Some(7) else {}; let _: i32 = value; }",
    ] {
        if !has_diagnostic_containing(
            checked_diagnostics(source),
            "`let else` branch must exit the surrounding control flow",
        ) {
            testing::fail(source)
        }
    }
}
