package checker;

use std::testing;

#[test]
fn instantiated_trait_constraints_validate_constant_arguments() -> () {
    let prefix = "trait Fixed[const N: usize] {} impl[const N: usize] Fixed[N] for bool {} ";
    for tail in[
        "fn value[const N: usize]() -> i32 where bool: Fixed[{N - 1}] { 7 } fn main() -> () { let _ = value::[0](); }",
        "fn value[const N: usize]() -> i32 where bool: Fixed[{N - 1}] { 7 } fn main() -> () { let _ = value::[0]; }",
        "struct Reader {} impl Reader { fn value[const N: usize](self: Reader) -> i32 where bool: Fixed[{N - 1}] { 7 } } fn main() -> () { let reader = Reader {}; let _ = reader.value::[0](); }",
        "struct Reader {} impl Reader { fn value[const N: usize](self: Reader) -> i32 where bool: Fixed[{N - 1}] { 7 } } fn main() -> () { let _ = Reader::value::[0]; }",
    ] {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(prefix + tail),
                "const usize argument must be nonnegative",
            ),
        );
    }
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                prefix
                    + "fn value[const N: usize]() -> i32 where bool: Fixed[{N / 0}] { 7 } fn main() -> () { let _ = value::[1](); }",
            ),
            "division by zero in constant expression",
        ),
    );
}

#[test]
fn recursive_impl_constraints_reject_invalid_constant_instances() -> () {
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "trait Fixed[const N: usize] {} trait Outer[const N: usize] {} impl[const N: usize] Fixed[N] for bool {} impl[const N: usize] Outer[N] for bool where bool: Fixed[{N - 1}] {} fn value[const N: usize]() -> i32 where bool: Outer[N] { 7 } fn main() -> () { let _ = value::[0](); }",
            ),
            "No instance found for trait Outer",
        ),
    );
}

#[test]
fn valid_and_symbolic_trait_constant_constraints_remain_available() -> () {
    let prefix = "trait Fixed[const N: usize] {} impl[const N: usize] Fixed[N] for bool {} fn value[const N: usize]() -> i32 where bool: Fixed[{N - 1}] { 7 } ";
    for tail in[
        "fn main() -> () { let _ = value::[2](); }",
        "fn main() -> () { let callback = value::[2]; let _ = callback(); }",
        "fn symbolic[const N: usize]() -> i32 where bool: Fixed[{N - 1}] { value::[N]() }",
    ] {
        let _ = checked_file(prefix + tail);
    }
}
