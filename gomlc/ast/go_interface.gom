package ast;

pub struct GoInterfaceSpec {
    pub span: Span,
    pub raw_type: string,
    pub wrapper_name: string,
    pub methods: Vec[(string, string)],
}

fn interface_go_method_name(value: string) -> bool {
    if value.byte_len() == 0 || value.byte_get(0) < 65 || value.byte_get(0) > 90 {
        return false
    }
    for index in 1..value.byte_len() {
        let byte = value.byte_get(index);
        if !(byte >= 65 && byte <= 90) && !(byte >= 97 && byte <= 122)
            && !(byte >= 48 && byte <= 57)
            && byte != 95 {
            return false
        }
    }
    true
}

pub fn go_interface_spec(attributes: Vec[Attribute]) -> Result[Option[GoInterfaceSpec], string] {
    let mut result: Option[GoInterfaceSpec] = Option::None;
    for attribute in attributes {
        if attribute.name != "go_interface" {
            continue
        }
        if result.is_some() {
            return Result::Err("duplicate go_interface attribute")
        }
        if !attribute.has_argument_list || attribute.args.len() < 2 {
            return Result::Err(
                "go_interface expects a raw type path, wrapper name, and method mappings",
            )
        }
        let raw_type = match attribute.args[0] {
            Ident(name) | Path(name) if name != "" => name,
            _ => return Result::Err("go_interface raw type must be a type path"),
        };
        let wrapper_name = match attribute.args[1] {
            Ident(name) if name != "" => name,
            _ => return Result::Err("go_interface wrapper must be an unqualified type name"),
        };
        if wrapper_name == raw_type {
            return Result::Err("go_interface raw type and wrapper must have different names")
        }
        let methods: Vec[(string, string)] = Vec::new();
        for index in 2..attribute.args.len() {
            let (name, target) = match attribute.args[index] {
                Named { name, value_kind, value } if value_kind == "string" => (name, value),
                _ => return Result::Err(
                    "go_interface method mappings must use method = \"GoMethod\"",
                ),
            };
            if name == "from_go" || name == "into_go" || name == "from_trait" {
                return Result::Err(
                    "go_interface reserves from_go, into_go and from_trait for conversion",
                )
            }
            if !interface_go_method_name(target) {
                return Result::Err("go_interface requires an exported ASCII Go method name")
            }
            for previous in methods {
                if previous.0 == name || previous.1 == target {
                    return Result::Err("duplicate go_interface method mapping")
                }
            }
            methods.push((name, target));
        }
        result = Option::Some(
            GoInterfaceSpec { span: attribute.span, raw_type, wrapper_name, methods },
        );
    }
    Result::Ok(result)
}
