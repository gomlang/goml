package ast;

use module::parser;
use std::testing;

#[test]
fn module_visibility_preserves_declaration_names_and_fields() -> () {
    let source = "pub(module) use module::service::State as Shared; pub(module) struct State { pub(module) value: isize, pub id: isize, hidden: bool } pub(module) struct Handle(pub(module) isize); pub(module) fn read() -> isize { 1 } impl State { pub(module) fn read(self: State) -> isize { self.value } }";
    let file = lowered_file(source);
    testing::assert(matches_module_visibility(file.uses[0].visibility));
    match file.items[0] {
        StructDef(value) => {
            testing::assert_eq(value.name, "State");
            testing::assert(matches_module_visibility(value.visibility));
            testing::assert_eq(value.module_fields.len(), 1);
            testing::assert_eq(value.module_fields[0], "value");
            testing::assert_eq(value.public_fields.len(), 1);
            testing::assert_eq(value.public_fields[0], "id");
        },
        _ => testing::fail("expected module-visible struct"),
    }
    match file.items[1] {
        StructDef(value) => {
            testing::assert_eq(value.name, "Handle");
            testing::assert(value.module_fields.contains("_0"));
        },
        _ => testing::fail("expected module-visible newtype field"),
    }
    match file.items[2] {
        Function(value) => {
            testing::assert_eq(value.name, "read");
            testing::assert(matches_module_visibility(value.visibility));
        },
        _ => testing::fail("expected module-visible function"),
    }
    match file.items[3] {
        ImplBlock(value) => testing::assert(matches_module_visibility(value.methods[0].visibility)),
        _ => testing::fail("expected module-visible inherent method"),
    }
    let rendered = pretty(lower(parser::parse(source)));
    let roundtrip = pretty(lower(parser::parse(rendered)));
    testing::assert_eq(rendered, roundtrip);
}

fn matches_module_visibility(value: Visibility) -> bool {
    match value {
        Module => true,
        Private | Public => false,
    }
}

#[test]
fn module_visibility_rejects_unknown_scope_and_trait_impl_annotations() -> () {
    let invalid = lower(parser::parse("pub(package) fn f() -> () {}"));
    testing::assert(!invalid.diagnostics.is_empty());
    let invalid = lower(
        parser::parse(
            "struct Value {} trait Read { fn read(self: Self) -> isize; } impl Read for Value { pub(module) fn read(self: Value) -> isize { 1 } }",
        ),
    );
    testing::assert(
        has_diagnostic(invalid.diagnostics, "Trait implementation method read must not use `pub`"),
    );
    let invalid = lower(parser::parse("enum Value { Item { pub(module) value: isize } }"));
    testing::assert(
        has_diagnostic(
            invalid.diagnostics,
            "Enum variant fields inherit the enum visibility and must not use `pub`",
        ),
    );
}
