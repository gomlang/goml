package ast;

use module::cst;
use module::lexer;

fn is_binary_operator(kind: lexer::TokenKind) -> bool {
    match kind {
        Plus | Minus | Star | Slash | Percent | AndAnd | Amp | OrOr | Pipe | Caret | Less | LessLess | Greater | GreaterGreater | LessEq | GreaterEq | EqEq | NotEq | Dot => true,
        _ => false,
    }
}

fn binary_operator_token(node: LocatedNode) -> Option[LocatedToken] {
    for token in direct_tokens(node) {
        if is_binary_operator(token.token.kind) {
            return Option::Some(token)
        }
    }
    Option::None
}

fn binary_operator(kind: lexer::TokenKind) -> Option[BinaryOp] {
    match kind {
        Plus => Option::Some(BinaryOp::Add),
        Minus => Option::Some(BinaryOp::Sub),
        Star => Option::Some(BinaryOp::Mul),
        Slash => Option::Some(BinaryOp::Div),
        Percent => Option::Some(BinaryOp::Rem),
        Amp => Option::Some(BinaryOp::BitAnd),
        Pipe => Option::Some(BinaryOp::BitOr),
        Caret => Option::Some(BinaryOp::BitXor),
        LessLess => Option::Some(BinaryOp::Shl),
        GreaterGreater => Option::Some(BinaryOp::Shr),
        AndAnd => Option::Some(BinaryOp::And),
        OrOr => Option::Some(BinaryOp::Or),
        Less => Option::Some(BinaryOp::Less),
        Greater => Option::Some(BinaryOp::Greater),
        LessEq => Option::Some(BinaryOp::LessEq),
        GreaterEq => Option::Some(BinaryOp::GreaterEq),
        EqEq => Option::Some(BinaryOp::Eq),
        NotEq => Option::Some(BinaryOp::NotEq),
        _ => Option::None,
    }
}

fn compound_assignment_operator(kind: lexer::TokenKind) -> Option[BinaryOp] {
    match kind {
        PlusEq => Option::Some(BinaryOp::Add),
        MinusEq => Option::Some(BinaryOp::Sub),
        StarEq => Option::Some(BinaryOp::Mul),
        SlashEq => Option::Some(BinaryOp::Div),
        PercentEq => Option::Some(BinaryOp::Rem),
        AmpEq => Option::Some(BinaryOp::BitAnd),
        PipeEq => Option::Some(BinaryOp::BitOr),
        CaretEq => Option::Some(BinaryOp::BitXor),
        LessLessEq => Option::Some(BinaryOp::Shl),
        GreaterGreaterEq => Option::Some(BinaryOp::Shr),
        _ => Option::None,
    }
}

fn parse_decimal_int32(value: string) -> Option[isize] {
    let mut result = 0;
    let mut index = 0;
    let mut valid = value.byte_len() > 0;
    while index < value.byte_len() && valid {
        let byte = value.byte_get(index);
        if byte < b'0' || byte > b'9' {
            valid = false;
        } else {
            let digit = match byte {
                48 => 0,
                49 => 1,
                50 => 2,
                51 => 3,
                52 => 4,
                53 => 5,
                54 => 6,
                55 => 7,
                56 => 8,
                _ => 9,
            };
            if result > 214748364 || (result == 214748364 && digit > 7) {
                valid = false;
            } else {
                result = result * 10 + digit;
            }
        }
        index += 1;
    }
    if valid {
        Option::Some(result)
    } else {
        Option::None
    }
}

fn apply_trailing_args(ctx: LowerCtx, expression: Expr, trailing_args: Vec[Expr], value_span: Span) -> Option[
    Expr,
] {
    if trailing_args.is_empty() {
        Option::Some(expression)
    } else {
        match expression {
            Path { path, owner_type_args, member_type_args, span: expr_span } => Option::Some(
                Expr::Call {
                    func: Expr::Path { path, owner_type_args, member_type_args, span: expr_span },
                    args: trailing_args,
                    span: expr_span,
                },
            ),
            Call { func, args, span: expr_span } => {
                let mut result = Expr::Call { func, args, span: expr_span };
                for arg in trailing_args {
                    result = Expr::Call { func: result, args: Vec::new(), span: expr_span };
                    if let Call { func: next_func, args: next_args, span: next_span } = result {
                        next_args.push(arg);
                        result = Expr::Call { func: next_func, args: next_args, span: next_span };
                    }
                }
                Option::Some(result)
            },
            ConstructorValue { constructor: path, span: expr_span } => {
                Option::Some(
                    Expr::Constr { constructor: path, args: trailing_args, span: expr_span },
                )
            },
            Constr { constructor: path, args, span: expr_span } => {
                for arg in trailing_args {
                    args.push(arg)
                }
                Option::Some(Expr::Constr { constructor: path, args, span: expr_span })
            },
            Field { expr: base, field_name: field, method_type_args, span: expr_span } => Option::Some(
                Expr::Call {
                    func: Expr::Field {
                        expr: base,
                        field_name: field,
                        method_type_args,
                        span: expr_span,
                    },
                    args: trailing_args,
                    span: expr_span,
                },
            ),
            Index { base, index, span: expr_span } => apply_trailing_args(
                ctx,
                index,
                trailing_args,
                value_span,
            ).map(|next_index| Expr::Index { base, index: next_index, span: expr_span }),
            Binary { op, lhs, rhs, span: expr_span } => apply_trailing_args(
                ctx,
                rhs,
                trailing_args,
                value_span,
            ).map(|next_rhs| Expr::Binary { op, lhs, rhs: next_rhs, span: expr_span }),
            Unary { op, expr: inner, span: expr_span } => apply_trailing_args(
                ctx,
                inner,
                trailing_args,
                value_span,
            ).map(|next_inner| Expr::Unary { op, expr: next_inner, span: expr_span }),
            _ => {
                push_error(ctx, value_span, "Cannot apply arguments to expression");
                Option::None
            },
        }
    }
}

fn lower_arg_list(ctx: LowerCtx, node: LocatedNode) -> Vec[Expr] {
    let args: Vec[Expr] = Vec::new();
    if let Some(list) = first_child(node, cst::NodeKind::ARG_LIST) {
        for arg in children_of_kind(list, cst::NodeKind::ARG) {
            let values = expr_children(arg);
            if !values.is_empty() {
                if let Some(value) = lower_expr(ctx, values[0]) {
                    args.push(value)
                }
            } else {
                push_error(ctx, node_span(arg), "Arg has no expr")
            }
        }
    }
    args
}

fn is_direct_call_callee(kind: cst::NodeKind) -> bool {
    match kind {
        EXPR_CALL | EXPR_CLOSURE | EXPR_PAREN => true,
        _ => false,
    }
}

fn is_dot_binary(node: LocatedNode) -> bool {
    match binary_operator_token(node) {
        Some(token) => lexer::token_kind_equal(token.token.kind, lexer::TokenKind::Dot),
        None => false,
    }
}

fn lower_call_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    let args = lower_arg_list(ctx, node);
    let callees = expr_children(node);
    if callees.is_empty() {
        push_error(ctx, node_span(node), "CallExpr has no function name");
        Option::None
    } else {
        let callee = callees[0];
        if cst::node_kind_equal(node_kind(callee), cst::NodeKind::EXPR_IDENT) {
            match lower_ident_parts(ctx, callee) {
                Some(parts) => match path_last(parts.path) {
                    Some(last) => {
                        let call = if parts.owner_type_args.is_empty()
                            && parts.member_type_args.is_empty()
                            && ident_starts_upper(last) {
                            Expr::Constr { constructor: parts.path, args, span: node_span(node) }
                        } else {
                            Expr::Call {
                                func: Expr::Path {
                                    path: parts.path,
                                    owner_type_args: parts.owner_type_args,
                                    member_type_args: parts.member_type_args,
                                    span: node_span(callee),
                                },
                                args,
                                span: node_span(node),
                            }
                        };
                        apply_trailing_args(ctx, call, trailing_args, node_span(node))
                    },
                    None => {
                        push_error(ctx, node_span(node), "Path expression is missing a name");
                        Option::None
                    },
                },
                None => Option::None,
            }
        } else if is_direct_call_callee(node_kind(callee)) || is_dot_binary(callee) {
            match lower_expr(ctx, callee) {
                Some(func) => apply_trailing_args(
                    ctx,
                    Expr::Call { func, args, span: node_span(node) },
                    trailing_args,
                    node_span(node),
                ),
                None => Option::None,
            }
        } else {
            for arg in trailing_args {
                args.push(arg)
            }
            lower_expr_with_args(ctx, callee, args)
        }
    }
}

fn lower_prefix_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    let values = expr_children(node);
    if values.is_empty() {
        push_error(ctx, node_span(node), "Prefix expression missing operand");
        Option::None
    } else {
        match lower_expr_with_args(ctx, values[0], Vec::new()) {
            Some(inner) => {
                let op = if has_token(node, lexer::TokenKind::Minus) {
                    Option::Some(UnaryOp::Neg)
                } else if has_token(node, lexer::TokenKind::Bang) {
                    Option::Some(UnaryOp::Not)
                } else if has_token(node, lexer::TokenKind::Tilde) {
                    Option::Some(UnaryOp::BitNot)
                } else {
                    Option::None
                };
                match op {
                    Some(value) => apply_trailing_args(
                        ctx,
                        Expr::Unary { op: value, expr: inner, span: node_span(node) },
                        trailing_args,
                        node_span(node),
                    ),
                    None => {
                        push_error(ctx, node_span(node), "Prefix expression missing operator");
                        Option::None
                    },
                }
            },
            None => Option::None,
        }
    }
}

fn lower_cast_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    let values = expr_children(node);
    let types = type_children(node);
    if values.is_empty() || types.is_empty() {
        Option::None
    } else {
        match lower_expr_with_args(ctx, values[0], Vec::new()) {
            Some(value) => match lower_ty(ctx, types[0]) {
                Some(ty) => apply_trailing_args(
                    ctx,
                    Expr::Cast { expr: value, ty, span: node_span(node) },
                    trailing_args,
                    node_span(node),
                ),
                None => Option::None,
            },
            None => Option::None,
        }
    }
}

fn lower_index_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    let values = expr_children(node);
    if values.is_empty() {
        push_error(ctx, node_span(node), "Index expression missing base");
        Option::None
    } else if values.len() < 2 {
        push_error(ctx, node_span(node), "Index expression missing index");
        Option::None
    } else {
        match lower_expr_with_args(ctx, values[0], Vec::new()) {
            Some(base) => match lower_expr(ctx, values[1]) {
                Some(index) => apply_trailing_args(
                    ctx,
                    Expr::Index { base, index, span: node_span(node) },
                    trailing_args,
                    node_span(node),
                ),
                None => Option::None,
            },
            None => Option::None,
        }
    }
}

fn lower_try_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    let values = expr_children(node);
    if values.is_empty() {
        push_error(ctx, node_span(node), "Try expression missing operand");
        Option::None
    } else {
        match lower_expr_with_args(ctx, values[0], Vec::new()) {
            Some(value) => apply_trailing_args(
                ctx,
                Expr::Try { expr: value, span: node_span(node) },
                trailing_args,
                node_span(node),
            ),
            None => Option::None,
        }
    }
}

fn lower_range_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    let values = expr_children(node);
    if values.len() < 1 {
        push_error(ctx, node_span(node), "Range expression missing start");
        Option::None
    } else if values.len() < 2 {
        push_error(ctx, node_span(node), "Range expression missing end");
        Option::None
    } else {
        match lower_expr(ctx, values[0]) {
            Some(start) => match lower_expr(ctx, values[1]) {
                Some(end) => apply_trailing_args(
                    ctx,
                    Expr::Range {
                        start,
                        end,
                        inclusive: has_token(node, lexer::TokenKind::DotDotEq),
                        span: node_span(node),
                    },
                    trailing_args,
                    node_span(node),
                ),
                None => Option::None,
            },
            None => Option::None,
        }
    }
}

fn lower_binary_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    let values = expr_children(node);
    if values.len() < 1 {
        push_error(ctx, node_span(node), "Binary expression missing lhs");
        Option::None
    } else if values.len() < 2 {
        push_error(ctx, node_span(node), "Binary expression missing rhs");
        Option::None
    } else {
        match lower_expr_with_args(ctx, values[0], Vec::new()) {
            Some(lhs) => match binary_operator_token(node) {
                Some(operator) => if lexer::token_kind_equal(
                    operator.token.kind,
                    lexer::TokenKind::Dot,
                ) {
                    lower_dot_expr(ctx, node, lhs, values[1], trailing_args)
                } else {
                    match binary_operator(operator.token.kind) {
                        Some(op) => lower_expr_with_args(ctx, values[1], trailing_args).map(
                            |rhs| Expr::Binary { op, lhs, rhs, span: node_span(node) },
                        ),
                        None => {
                            push_error(ctx, token_span(operator), "Unsupported binary operator");
                            Option::None
                        },
                    }
                },
                None => {
                    push_error(ctx, node_span(node), "Binary expression missing operator");
                    Option::None
                },
            },
            None => Option::None,
        }
    }
}

fn lower_dot_expr(
    ctx: LowerCtx,
    node: LocatedNode,
    lhs: Expr,
    rhs: LocatedNode,
    trailing_args: Vec[Expr],
) -> Option[Expr] {
    if cst::node_kind_equal(node_kind(rhs), cst::NodeKind::EXPR_INT) {
        match first_token(rhs, lexer::TokenKind::IntLit) {
            Some(token) => match parse_decimal_int32(strip_suffix(token.token.text, "")) {
                Some(index) => Option::Some(Expr::Proj { tuple: lhs, index, span: node_span(node) }),
                None => {
                    push_error(ctx, token_span(token), "Invalid tuple index: " + token.token.text);
                    Option::None
                },
            },
            None => {
                push_error(ctx, node_span(rhs), "Tuple projection missing index");
                Option::None
            },
        }
    } else if cst::node_kind_equal(node_kind(rhs), cst::NodeKind::EXPR_IDENT) {
        match lower_ident_parts(ctx, rhs) {
            Some(parts) => {
                if parts.path.segments.is_empty() {
                    push_error(ctx, node_span(rhs), "Field access missing name");
                    Option::None
                } else {
                    let field = Expr::Field {
                        expr: lhs,
                        field_name: parts.path.segments[parts.path.segments.len() - 1].ident,
                        method_type_args: parts.member_type_args,
                        span: node_span(node),
                    };
                    if trailing_args.is_empty() {
                        Option::Some(field)
                    } else {
                        Option::Some(
                            Expr::Call { func: field, args: trailing_args, span: node_span(node) },
                        )
                    }
                }
            },
            None => {
                push_error(ctx, node_span(rhs), "Field access missing name");
                Option::None
            },
        }
    } else {
        push_error(ctx, node_span(rhs), "Unsupported field access expression");
        Option::None
    }
}
