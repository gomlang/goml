package ast;

use module::parser;
use std::testing;

#[test]
fn named_field_literals_reject_explicit_generic_arguments() -> () {
    for expression in Vec::from_array(
        [
            "Box::[bool] { value: 42 }",
            "Value::[bool]::Named { value: 42 }",
            "Value::Named::[bool] { value: 42 }",
            "Box::[bool] { ..previous }",
        ],
    ) {
        let parsed = parser::parse("fn main() -> () { let _ = " + expression + "; }");
        testing::assert_eq(parsed.diagnostics.len(), 0);
        let lowered = lower(parsed);
        testing::assert(
            has_diagnostic(
                lowered.diagnostics,
                "named-field literals do not accept explicit generic arguments; use a type annotation",
            ),
        );
        testing::assert(lowered.ast.is_none());
    }
    let _ = lowered_file(
        "struct Box[T] { value: T } enum Value[T] { Named { value: T } } fn main() -> () { let _box: Box[bool] = Box { value: true }; let _value: Value[bool] = Value::Named { value: true }; }",
    );
}
