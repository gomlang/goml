package ast;

use std::text;

fn encode_exprs(builder: text::StringBuilder, values: Vec[Expr]) -> () {
    encode_list(builder, values.len());
    for value in values {
        encode_expr(builder, value)
    }
}

fn encode_pats(builder: text::StringBuilder, values: Vec[Pat]) -> () {
    encode_list(builder, values.len());
    for value in values {
        encode_pat(builder, value)
    }
}

fn unary_name(value: UnaryOp) -> string {
    match value {
        Neg => "Neg",
        Not => "Not",
        BitNot => "BitNot",
    }
}

fn binary_name(value: BinaryOp) -> string {
    match value {
        Add => "Add",
        Sub => "Sub",
        Mul => "Mul",
        Div => "Div",
        Rem => "Rem",
        BitAnd => "BitAnd",
        BitOr => "BitOr",
        BitXor => "BitXor",
        Shl => "Shl",
        Shr => "Shr",
        And => "And",
        Or => "Or",
        Less => "Less",
        Greater => "Greater",
        LessEq => "LessEq",
        GreaterEq => "GreaterEq",
        Eq => "Eq",
        NotEq => "NotEq",
    }
}

fn encode_arm(builder: text::StringBuilder, value: Arm) -> () {
    encode_open(builder, "Arm");
    encode_pat(builder, value.pat);
    match value.guard {
        Some(guard) => {
            encode_some(builder);
            encode_expr(builder, guard)
        },
        None => encode_none(builder),
    }
    encode_expr(builder, value.body);
    encode_close(builder)
}

fn encode_select_arm(builder: text::StringBuilder, value: SelectArm) -> () {
    match value {
        Receive { channel, guard, binding, body, span: value_span } => {
            encode_open(builder, "SelectArm.Receive");
            encode_span(builder, value_span);
            encode_expr(builder, channel);
            match guard {
                Some(value) => {
                    encode_some(builder);
                    encode_expr(builder, value)
                },
                None => encode_none(builder),
            }
            encode_string_value(builder, binding);
            encode_expr(builder, body)
        },
        Send { channel, value, guard, body, span: value_span } => {
            encode_open(builder, "SelectArm.Send");
            encode_span(builder, value_span);
            encode_expr(builder, channel);
            encode_expr(builder, value);
            match guard {
                Some(value) => {
                    encode_some(builder);
                    encode_expr(builder, value)
                },
                None => encode_none(builder),
            }
            encode_expr(builder, body)
        },
        Default { body, span: value_span } => {
            encode_open(builder, "SelectArm.Default");
            encode_span(builder, value_span);
            encode_expr(builder, body)
        },
    }
    encode_close(builder)
}

fn encode_expr(builder: text::StringBuilder, value: Expr) -> () {
    match value {
        Path { path, owner_type_args, member_type_args, span: value_span } => {
            encode_open(builder, "Expr.Path");
            encode_span(builder, value_span);
            encode_path(builder, path);
            encode_list(builder, owner_type_args.len());
            for ty in owner_type_args {
                encode_type(builder, ty)
            }
            encode_list(builder, member_type_args.len());
            for ty in member_type_args {
                encode_type(builder, ty)
            }
        },
        Unit { span: value_span } => {
            encode_open(builder, "Expr.Unit");
            encode_span(builder, value_span)
        },
        Bool { value, span: value_span } => {
            encode_open(builder, "Expr.Bool");
            encode_span(builder, value_span);
            encode_bool_value(builder, value)
        },
        Int { value, span: value_span } => encode_literal_expr(builder, "Int", value, value_span),
        Float { value, span: value_span } => encode_literal_expr(
            builder,
            "Float",
            value,
            value_span,
        ),
        String { value, span: value_span } => encode_literal_expr(
            builder,
            "String",
            value,
            value_span,
        ),
        InterpolatedString { parts, span: value_span } => {
            encode_open(builder, "Expr.InterpolatedString");
            encode_span(builder, value_span);
            encode_list(builder, parts.len());
            for part in parts {
                match part {
                    Text(value) => {
                        encode_open(builder, "InterpolatedStringPart.Text");
                        encode_string_value(builder, value);
                        encode_close(builder)
                    },
                    Expr(value) => {
                        encode_open(builder, "InterpolatedStringPart.Expr");
                        encode_expr(builder, value);
                        encode_close(builder)
                    },
                }
            }
        },
        Char { value, span: value_span } => encode_literal_expr(builder, "Char", value, value_span),
        Byte { value, span: value_span } => encode_literal_expr(builder, "Byte", value, value_span),
        ByteString { values, span: value_span } => {
            encode_open(builder, "Expr.ByteString");
            encode_span(builder, value_span);
            encode_list(builder, values.len());
            for value in values {
                encode_string_value(builder, value)
            }
        },
        ConstructorValue { constructor: path, span: value_span } => {
            encode_open(builder, "Expr.Constr");
            encode_span(builder, value_span);
            encode_path(builder, path);
            encode_exprs(builder, Vec::new())
        },
        Constr { constructor: path, args, span: value_span } => {
            encode_open(builder, "Expr.Constr");
            encode_span(builder, value_span);
            encode_path(builder, path);
            encode_exprs(builder, args)
        },
        StructLiteral { name: path, fields, base, span: value_span } => {
            encode_open(builder, "Expr.StructLiteral");
            encode_span(builder, value_span);
            encode_path(builder, path);
            encode_list(builder, fields.len());
            for field in fields {
                let (name, expr) = field;
                encode_open(builder, "ExprField");
                encode_string_value(builder, name);
                encode_expr(builder, expr);
                encode_close(builder)
            }
            match base {
                Some(value) => {
                    encode_some(builder);
                    encode_expr(builder, value)
                },
                None => encode_none(builder),
            }
        },
        Tuple { items, span: value_span } => {
            encode_open(builder, "Expr.Tuple");
            encode_span(builder, value_span);
            encode_exprs(builder, items)
        },
        ArrayRepeat { value, len, span: value_span } => {
            encode_open(builder, "Expr.ArrayRepeat");
            encode_span(builder, value_span);
            encode_expr(builder, value);
            encode_string_value(builder, len)
        },
        Array { items, span: value_span } => {
            encode_open(builder, "Expr.Array");
            encode_span(builder, value_span);
            encode_exprs(builder, items)
        },
        Closure { params, body, span: value_span } => {
            encode_open(builder, "Expr.Closure");
            encode_span(builder, value_span);
            encode_list(builder, params.len());
            for param in params {
                encode_open(builder, "ClosureParam");
                encode_span(builder, param.span);
                encode_string_value(builder, param.name);
                encode_optional_type(builder, param.ty);
                encode_close(builder)
            }
            encode_expr(builder, body)
        },
        Match { expr, arms, span: value_span } => {
            encode_open(builder, "Expr.Match");
            encode_span(builder, value_span);
            encode_expr(builder, expr);
            encode_list(builder, arms.len());
            for arm in arms {
                encode_arm(builder, arm)
            }
        },
        Select { mode, arms, span: value_span } => {
            encode_open(builder, "Expr.Select");
            encode_span(builder, value_span);
            encode_string_value(
                builder,
                match mode {
                    SelectMode::Normal => "Normal",
                    SelectMode::Priority => "Priority",
                },
            );
            encode_list(builder, arms.len());
            for arm in arms {
                encode_select_arm(builder, arm)
            }
        },
        IfChain { conditions, then_branch, else_branch, span: value_span } => {
            encode_open(builder, "Expr.IfChain");
            encode_span(builder, value_span);
            for condition in conditions {
                match condition.0 {
                    Some(pat) => encode_pat(builder, pat),
                    None => encode_open(builder, "Condition.Bool"),
                }
                encode_expr(builder, condition.1)
            }
            encode_expr(builder, then_branch);
            encode_expr(builder, else_branch)
        },
        If { cond, then_branch, else_branch, span: value_span } => {
            encode_open(builder, "Expr.If");
            encode_span(builder, value_span);
            encode_expr(builder, cond);
            encode_expr(builder, then_branch);
            encode_expr(builder, else_branch)
        },
        While { label, cond, body, span: value_span } => {
            encode_open(builder, "Expr.While");
            encode_span(builder, value_span);
            encode_optional_string(builder, label);
            encode_expr(builder, cond);
            encode_expr(builder, body)
        },
        Loop { label, body, span: value_span } => {
            encode_open(builder, "Expr.Loop");
            encode_span(builder, value_span);
            encode_optional_string(builder, label);
            encode_expr(builder, body)
        },
        For { label, pat, iterator, body, span: value_span } => {
            encode_open(builder, "Expr.For");
            encode_span(builder, value_span);
            encode_optional_string(builder, label);
            encode_pat(builder, pat);
            encode_expr(builder, iterator);
            encode_expr(builder, body)
        },
        Break { label, value, span: value_span } => {
            encode_open(builder, "Expr.Break");
            encode_span(builder, value_span);
            encode_optional_string(builder, label);
            match value {
                Some(expr) => {
                    encode_some(builder);
                    encode_expr(builder, expr)
                },
                None => encode_none(builder),
            }
        },
        Continue { label, span: value_span } => {
            encode_open(builder, "Expr.Continue");
            encode_span(builder, value_span);
            encode_optional_string(builder, label)
        },
        Return { expr, span: value_span } => {
            encode_open(builder, "Expr.Return");
            encode_span(builder, value_span);
            match expr {
                Some(inner) => {
                    encode_some(builder);
                    encode_expr(builder, inner)
                },
                None => encode_none(builder),
            }
        },
        Go { expr, span: value_span } => {
            encode_open(builder, "Expr.Go");
            encode_span(builder, value_span);
            encode_expr(builder, expr)
        },
        Scope { body, span: value_span } => {
            encode_open(builder, "Expr.Scope");
            encode_span(builder, value_span);
            encode_expr(builder, body)
        },
        Comptime { block, span: value_span } => {
            encode_open(builder, "Expr.Comptime");
            encode_span(builder, value_span);
            encode_block(builder, block)
        },
        Spawn { body, span: value_span } => {
            encode_open(builder, "Expr.Spawn");
            encode_span(builder, value_span);
            encode_expr(builder, body)
        },
        Call { func, args, span: value_span } => {
            encode_open(builder, "Expr.Call");
            encode_span(builder, value_span);
            encode_expr(builder, func);
            encode_exprs(builder, args)
        },
        Unary { op, expr, span: value_span } => {
            encode_open(builder, "Expr.Unary");
            encode_span(builder, value_span);
            encode_string_value(builder, unary_name(op));
            encode_expr(builder, expr)
        },
        Cast { expr, ty, span: value_span } => {
            encode_open(builder, "Expr.Cast");
            encode_span(builder, value_span);
            encode_expr(builder, expr);
            encode_type(builder, ty)
        },
        Try { expr, span: value_span } => {
            encode_open(builder, "Expr.Try");
            encode_span(builder, value_span);
            encode_expr(builder, expr)
        },
        Range { start, end, inclusive, span: value_span } => {
            encode_open(builder, "Expr.Range");
            encode_span(builder, value_span);
            encode_expr(builder, start);
            encode_expr(builder, end);
            encode_bool_value(builder, inclusive)
        },
        Binary { op, lhs, rhs, span: value_span } => {
            encode_open(builder, "Expr.Binary");
            encode_span(builder, value_span);
            encode_string_value(builder, binary_name(op));
            encode_expr(builder, lhs);
            encode_expr(builder, rhs)
        },
        Proj { tuple: expr, index, span: value_span } => {
            encode_open(builder, "Expr.Proj");
            encode_span(builder, value_span);
            encode_expr(builder, expr);
            encode_int_value(builder, index)
        },
        Field { expr, field_name: field, method_type_args, span: value_span } => {
            encode_open(builder, "Expr.Field");
            encode_span(builder, value_span);
            encode_expr(builder, expr);
            encode_string_value(builder, field);
            encode_list(builder, method_type_args.len());
            for ty in method_type_args {
                encode_type(builder, ty)
            }
        },
        Index { base, index, span: value_span } => {
            encode_open(builder, "Expr.Index");
            encode_span(builder, value_span);
            encode_expr(builder, base);
            encode_expr(builder, index)
        },
        Block { block, span: value_span } => {
            encode_open(builder, "Expr.Block");
            encode_span(builder, value_span);
            encode_block(builder, block)
        },
    }
    encode_close(builder)
}

fn encode_literal_expr(builder: text::StringBuilder, tag: string, value: string, value_span: Span) -> () {
    encode_open(builder, "Expr." + tag);
    encode_span(builder, value_span);
    encode_string_value(builder, value)
}

fn encode_pat(builder: text::StringBuilder, value: Pat) -> () {
    match value {
        Var { name, is_mut, span: value_span } => {
            encode_open(builder, "Pat.Var");
            encode_span(builder, value_span);
            encode_bool_value(builder, is_mut);
            encode_string_value(builder, name)
        },
        Unit { span: value_span } => {
            encode_open(builder, "Pat.Unit");
            encode_span(builder, value_span)
        },
        Bool { value, span: value_span } => {
            encode_open(builder, "Pat.Bool");
            encode_span(builder, value_span);
            encode_bool_value(builder, value)
        },
        Int { value, span: value_span } => encode_literal_pat(builder, "Int", value, value_span),
        Float { value, span: value_span } => encode_literal_pat(builder, "Float", value, value_span),
        String { value, span: value_span } => encode_literal_pat(
            builder,
            "String",
            value,
            value_span,
        ),
        Char { value, span: value_span } => encode_literal_pat(builder, "Char", value, value_span),
        Byte { value, span: value_span } => encode_literal_pat(builder, "Byte", value, value_span),
        Constr { constructor: path, args, span: value_span } => {
            encode_open(builder, "Pat.Constr");
            encode_span(builder, value_span);
            encode_path(builder, path);
            encode_pats(builder, args)
        },
        Struct { name: path, fields, has_rest, span: value_span } => {
            encode_open(builder, "Pat.Struct");
            encode_span(builder, value_span);
            encode_path(builder, path);
            encode_list(builder, fields.len());
            for field in fields {
                let (name, pat) = field;
                encode_open(builder, "PatField");
                encode_string_value(builder, name);
                encode_pat(builder, pat);
                encode_close(builder)
            }
            encode_bool_value(builder, has_rest)
        },
        Tuple { items: pats, span: value_span } => {
            encode_open(builder, "Pat.Tuple");
            encode_span(builder, value_span);
            encode_pats(builder, pats)
        },
        Array { prefix, rest, suffix, span: value_span } => {
            encode_open(builder, "Pat.Array");
            encode_span(builder, value_span);
            encode_pats(builder, prefix);
            match rest {
                Some(rest_value) => {
                    encode_some(builder);
                    encode_open(builder, "PatRest");
                    encode_span(builder, rest_value.span);
                    match rest_value.binding {
                        Some(binding) => {
                            encode_some(builder);
                            encode_string_value(builder, binding)
                        },
                        None => encode_none(builder),
                    }
                    encode_close(builder)
                },
                None => encode_none(builder),
            }
            encode_pats(builder, suffix)
        },
        Alias { name, pat, span: value_span } => {
            encode_open(builder, "Pat.Alias");
            encode_span(builder, value_span);
            encode_string_value(builder, name);
            encode_pat(builder, pat)
        },
        Or { pats, span: value_span } => {
            encode_open(builder, "Pat.Or");
            encode_span(builder, value_span);
            encode_pats(builder, pats)
        },
        Range { start, end, inclusive, span: value_span } => {
            encode_open(builder, "Pat.Range");
            encode_span(builder, value_span);
            encode_pat(builder, start);
            encode_pat(builder, end);
            encode_bool_value(builder, inclusive)
        },
        Wild { span: value_span } => {
            encode_open(builder, "Pat.Wild");
            encode_span(builder, value_span)
        },
    }
    encode_close(builder)
}

fn encode_literal_pat(builder: text::StringBuilder, tag: string, value: string, value_span: Span) -> () {
    encode_open(builder, "Pat." + tag);
    encode_span(builder, value_span);
    encode_string_value(builder, value)
}
