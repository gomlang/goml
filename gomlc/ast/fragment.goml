package ast;

use module::cst;

fn fragment_context(result: cst::ParseResult) -> LowerCtx {
    LowerCtx {
        diagnostics: result.diagnostics,
        invalid_self_type_spans: Vec::new(),
        expr_depth: Ref::new(0),
        pattern_depth: Ref::new(0),
        type_depth: Ref::new(0),
    }
}

pub fn lower_expression_fragment(result: cst::ParseResult, offset: isize) -> Result[Expr, string] {
    if !result.diagnostics.is_empty() {
        return Result::Err(result.diagnostics[0].message)
    }
    let ctx = fragment_context(result);
    let values = expr_children(LocatedNode { node: result.root, start: offset });
    if values.len() != 1 {
        return Result::Err("expected one expression")
    }
    let value = lower_expr(ctx, values[0]);
    if !ctx.diagnostics.is_empty() {
        return Result::Err(ctx.diagnostics[0].message)
    }
    value.ok_or("invalid expression")
}

pub fn lower_type_fragment(result: cst::ParseResult, offset: isize) -> Result[TypeExpr, string] {
    if !result.diagnostics.is_empty() {
        return Result::Err(result.diagnostics[0].message)
    }
    let ctx = fragment_context(result);
    let values = type_children(LocatedNode { node: result.root, start: offset });
    if values.len() != 1 {
        return Result::Err("expected one type")
    }
    let value = lower_ty(ctx, values[0]);
    if !ctx.diagnostics.is_empty() {
        return Result::Err(ctx.diagnostics[0].message)
    }
    value.ok_or("invalid type")
}
