package ast;

use module::parser;
use std::testing;

#[test]
fn go_export_rejects_non_function_and_nested_attachments() -> () {
    for source in Vec::from_array(
        [
            "#[go_export(\"Value\")] const value: i64 = 1;",
            "#[go_export(\"Value\")] struct Value { value: i64 }",
            "struct Value { #[go_export(\"Value\")] value: i64 }",
            "#[go_export(\"Value\")] #[go_ffi(\"math\", \"Abs\")] extern fn value(x: f64) -> f64;",
        ],
    ) {
        let result = lower(parser::parse(source));
        if !has_diagnostic(
            result.diagnostics,
            "go_export is only valid on a top-level ordinary function",
        ) {
            let mut message = source;
            for diagnostic in result.diagnostics {
                message = message + "\n" + diagnostic.message;
            }
            testing::fail(message)
        }
    }
    testing::assert(
        !lower(
            parser::parse(
                "struct Value {} impl Value { #[go_export(\"Value\")] pub fn value(self: Value) -> i64 { 1 } }",
            ),
        ).diagnostics.is_empty(),
    );
}
