package ast;

use module::cst;
use module::parser;
use std::testing;

fn lowered_file(source: string) -> File {
    let result = lower(parser::parse(source));
    testing::assert_eq(result.diagnostics.len(), 0);
    match result.ast {
        Some(file) => file,
        None => {
            testing::fail("expected AST");
            File {
                package_name: "",
                package_explicit: false,
                uses: Vec::new(),
                items: Vec::new(),
                invalid_self_type_spans: Vec::new(),
            }
        },
    }
}

fn has_diagnostic(values: Vec[cst::Diagnostic], expected: string) -> bool {
    let found = Ref::new(false);
    for value in values {
        if value.message == expected {
            found.set(true)
        }
    }
    found.get()
}

#[test]
fn rejects_deeply_nested_patterns_without_overflowing() -> () {
    let pattern = Ref::new("_");
    for _ in 0..150 {
        pattern.set("(" + pattern.get() + ", _)")
    }
    let result = lower(parser::parse("fn main() -> () { let " + pattern.get() + " = (); }"));
    testing::assert(has_diagnostic(result.diagnostics, "pattern is too deeply nested"))
}

#[test]
fn rejects_deeply_nested_expressions_without_overflowing() -> () {
    let expression = Ref::new("1");
    for _ in 0..600 {
        expression.set("(" + expression.get() + ")")
    }
    let result = lower(
        parser::parse("fn main() -> () { let value = " + expression.get() + "; println(value); }"),
    );
    testing::assert(has_diagnostic(result.diagnostics, "expression is too deeply nested"))
}

#[test]
fn lowers_items_types_and_float_values() -> () {
    let source = "package sample; pub enum Choice[T] { None, Some(T) } struct Pair { left: i32, right: f64 } fn value() -> f64 { 3.1_40 }";
    let file = lowered_file(source);
    testing::assert_eq(file.package_name, "sample");
    testing::assert(file.package_explicit);
    testing::assert_eq(file.items.len(), 3);
    match file.items.get(0) {
        EnumDef(value) => {
            testing::assert_eq(value.name, "Choice");
            testing::assert_eq(value.generics.len(), 1);
            testing::assert_eq(value.variants.len(), 2)
        },
        _ => testing::fail("expected enum"),
    }
    match file.items.get(2) {
        Function(value) => match value.body.tail {
            Some(Float { value: number, span: _ }) => testing::assert_eq(number, "3.140"),
            _ => testing::fail("expected float tail"),
        },
        _ => testing::fail("expected function"),
    }
}

#[test]
fn lowers_newtype_structs_as_nominal_single_field_types() -> () {
    let file = lowered_file("pub struct Wrapper[T](pub T);");
    match file.items.get(0) {
        StructDef(value) => {
            testing::assert(value.newtype);
            testing::assert_eq(value.name, "Wrapper");
            testing::assert_eq(value.generics.get(0), "T");
            testing::assert_eq(value.fields.get(0).0, "_0");
            testing::assert(value.public_fields.contains("_0"))
        },
        _ => testing::fail("expected newtype struct"),
    }
}

#[test]
fn lowers_attribute_names_and_arguments_structurally() -> () {
    let file = lowered_file("#[vendor::intrinsic(\"runtime\")] extern fn probe() -> ();");
    match file.items.get(0) {
        ExternFunction(value) => {
            let attribute = value.attrs.get(0);
            testing::assert_eq(attribute.name, "intrinsic");
            testing::assert_eq(attribute.args.len(), 1);
            match attribute.args.get(0) {
                AttributeArg::String(value) => testing::assert_eq(value, "runtime"),
                _ => testing::fail("expected string attribute argument"),
            }
        },
        _ => testing::fail("expected extern function"),
    }
}

#[test]
fn lowers_named_attribute_arguments_structurally() -> () {
    let file = lowered_file(
        "#[serde(rename = \"entry\", with = codec::value, skip)] struct Entry { value: isize }",
    );
    match file.items[0] {
        StructDef(value) => {
            let attribute = value.attrs[0];
            testing::assert_eq(attribute.args.len(), 3);
            match attribute.args[0] {
                AttributeArg::Named { name, value_kind, value } => {
                    testing::assert_eq(name, "rename");
                    testing::assert_eq(value_kind, "string");
                    testing::assert_eq(value, "entry")
                },
                _ => testing::fail("expected named string attribute argument"),
            }
            match attribute.args[1] {
                AttributeArg::Named { name, value_kind, value } => {
                    testing::assert_eq(name, "with");
                    testing::assert_eq(value_kind, "path");
                    testing::assert_eq(value, "codec::value")
                },
                _ => testing::fail("expected named path attribute argument"),
            }
            match attribute.args[2] {
                AttributeArg::Ident(value) => testing::assert_eq(value, "skip"),
                _ => testing::fail("expected flag attribute argument"),
            }
        },
        _ => testing::fail("expected struct"),
    }
}

#[test]
fn lowers_derive_paths_and_nested_item_attributes() -> () {
    let file = lowered_file(
        "#[derive(macros::handler)] struct Box { #[field_tag] value: isize } enum Choice { #[variant_tag] Data(#[payload_tag] isize) }",
    );
    match file.items[0] {
        StructDef(value) => {
            match value.attrs[0].args[0] {
                AttributeArg::Path(value) => testing::assert_eq(value, "macros::handler"),
                _ => testing::fail("expected derive path"),
            }
            testing::assert_eq(value.field_attrs[0][0].name, "field_tag")
        },
        _ => testing::fail("expected struct"),
    }
    match file.items[1] {
        EnumDef(value) => {
            testing::assert_eq(value.variants[0].attrs[0].name, "variant_tag");
            testing::assert_eq(value.variants[0].field_attrs[0][0].name, "payload_tag")
        },
        _ => testing::fail("expected enum"),
    }
}

#[test]
fn lowers_unicode_strings_and_constructor_patterns() -> () {
    let source = "enum Choice { Empty, Text(string) } fn read(value: Choice) -> string { let prefix = \"λ\\u0041🙂\"; match value { Choice::Text(text) => prefix + text, Choice::Empty => prefix } }";
    let file = lowered_file(source);
    match file.items.get(1) {
        Function(value) => {
            match value.body.stmts.get(0) {
                Let {
                    is_mut: _,
                    pat: _,
                    annotation: _,
                    value: String { value: text_value, span: _ },
                    else_branch: _,
                    span: _,
                } => testing::assert_eq(text_value, "λA🙂"),
                _ => testing::fail("expected string binding"),
            }
            match value.body.tail {
                Some(Match { expr: _, arms, span: _ }) => {
                    testing::assert_eq(arms.len(), 2);
                    match arms.get(0).pat {
                        Constr { constructor: path, args, span: _ } => {
                            testing::assert_eq(path.segments.len(), 2);
                            testing::assert_eq(args.len(), 1)
                        },
                        _ => testing::fail("expected constructor pattern"),
                    }
                },
                _ => testing::fail("expected match tail"),
            }
        },
        _ => testing::fail("expected function"),
    }
}

#[test]
fn lowers_cross_file_constructor_patterns() -> () {
    let parsed = Vec::new();
    parsed.push(parser::parse("package main; enum Status { Idle, Busy(i32) }"));
    parsed.push(
        parser::parse(
            "package main; fn label(status: Status) -> string { match status { Idle => \"idle\", Busy(value) => value.to_string() } }",
        ),
    );
    let lowered = lower_package(parsed);
    testing::assert_eq(lowered.len(), 2);
    match lowered.get(1).ast {
        Some(file) => match file.items.get(0) {
            Function(function) => match function.body.tail {
                Some(Match { expr: _, arms, span: _ }) => match arms.get(0).pat {
                    Constr { constructor: path, args, span: _ } => {
                        testing::assert_eq(path.segments.get(0).ident, "Idle");
                        testing::assert_eq(args.len(), 0)
                    },
                    _ => testing::fail("expected cross-file constructor pattern"),
                },
                _ => testing::fail("expected match expression"),
            },
            _ => testing::fail("expected label function"),
        },
        None => testing::fail("expected cross-file AST"),
    }
}

#[test]
fn parser_diagnostics_prevent_ast_creation() -> () {
    let result = lower(parser::parse("fn broken( {"));
    testing::assert(!result.diagnostics.is_empty());
    if let Some(_) = result.ast {
        testing::fail("unexpected AST")
    }
}

#[test]
fn reports_invalid_parameter_types() -> () {
    let result = lower(parser::parse("fn take(value: [i32; 18446744073709551615]) -> () { () }"));
    testing::assert_eq(result.diagnostics.len(), 2);
    testing::assert_eq(
        result.diagnostics.get(0).message,
        "Invalid array length: 18446744073709551615",
    );
    testing::assert_eq(result.diagnostics.get(1).message, "Param value has no type")
}

#[test]
fn rejects_removed_unit_type_keyword() -> () {
    let result = lower(parser::parse("fn main() -> unit {}"));
    testing::assert_eq(result.diagnostics.len(), 1);
    testing::assert_eq(
        result.diagnostics.get(0).message,
        "type, trait, and generic names must start with an uppercase letter",
    )
}

#[test]
fn accepts_never_return_and_callback_annotations() -> () {
    let result = lower(
        parser::parse(
            "fn stop() -> never { loop {} } fn invoke(body: () -> never) -> never { body() }",
        ),
    );
    testing::assert(result.diagnostics.is_empty())
}

#[test]
fn reports_trait_impl_method_visibility_on_the_impl() -> () {
    let source = "trait Render { fn render(self: Self) -> string; } struct Value {} impl Render for Value { pub fn render(self: Value) -> string { \"value\" } }";
    let result = lower(parser::parse(source));
    testing::assert_eq(result.diagnostics.len(), 1);
    testing::assert_eq(result.diagnostics.get(0).start, 66);
    testing::assert_eq(result.diagnostics.get(0).end, 140)
}

#[test]
fn preserves_inconsistent_and_duplicate_pattern_bindings() -> () {
    let inconsistent = lower(
        parser::parse(
            "enum Flag { On, Off } fn main() -> () { let value = Flag::On; let _ = match value { whole @ Flag::On | Flag::Off => () }; }",
        ),
    );
    testing::assert_eq(inconsistent.diagnostics.len(), 0);
    if let None = inconsistent.ast {
        testing::fail("expected inconsistent pattern AST")
    }
    let duplicate = lower(parser::parse("fn main() -> () { let (value, value) = (1, 2); }"));
    testing::assert_eq(duplicate.diagnostics.len(), 0);
    if let None = duplicate.ast {
        testing::fail("expected duplicate pattern AST")
    }
}

#[test]
fn pretty_prints_run_single_ast_dump() -> () {
    let source = "fn main() { let _ = (); let a = (true, false, (true, false)); let b = match a { (x, y, (z, w)) => w }; let _ = print(b); () }";
    let expected = "package main;\n" + "fn main() {\n" + "    let _ = ();\n"
        + "    let a = (true, false, (true, false));\n"
        + "    let b =\n"
        + "      match a {\n"
        + "          (x, y, (z, w)) => w,\n"
        + "      };\n"
        + "    let _ = print(b);\n"
        + "    ()\n"
        + "}\n\n";
    testing::assert_eq(pretty(lower(parser::parse(source))), expected)
}

#[test]
fn lowers_external_type_identity_visibility_and_generics() -> () {
    let rendered = pretty(
        lower(parser::parse("#[go_type(\"host\", \"Box\")] pub extern type Box[T];")),
    );
    testing::assert(rendered.contains("pub extern type Box[T];"));
    testing::assert(lower(parser::parse(rendered)).ast.is_some());
    let file = lowered_file("#[go_type(\"host\", \"Box\")] pub extern type Box[T];");
    match file.items[0] {
        ExternType(value) => {
            testing::assert_eq(value.name, "Box");
            testing::assert_eq(value.generics.len(), 1);
            testing::assert_eq(value.generics[0], "T");
            testing::assert_eq(value.attrs[0].name, "go_type");
            testing::assert(value.name_span.end > value.name_span.start);
            testing::assert(
                match value.visibility {
                    Public => true,
                    Private => false,
                },
            )
        },
        _ => testing::fail("missing external type declaration"),
    }
}

#[test]
fn rejects_invalid_external_type_attributes() -> () {
    for source in Vec::from_array(
        [
            "extern type Value;",
            "#[go_type(\"time\", \"Duration\")] #[go_type(\"time\", \"Duration\")] extern type Value;",
            "#[go_type(\"time\")] extern type Value;",
            "#[go_type(time, Duration)] extern type Value;",
            "#[go_type(\"time\", \"duration\")] extern type Value;",
            "#[go_type(\"time\", \"Duration\")] struct Value {}",
        ],
    ) {
        let result = lower(parser::parse(source));
        testing::assert(result.ast.is_none());
        testing::assert(!result.diagnostics.is_empty())
    }
}
