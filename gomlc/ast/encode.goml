package ast;

use module::lexer;
use std::text;

fn encode_open(builder: text::StringBuilder, tag: string) -> () {
    builder.write_string("O\t");
    builder.write_string(tag);
    builder.write_string("\n")
}

fn encode_close(builder: text::StringBuilder) -> () {
    builder.write_string("C\n")
}

fn encode_string_value(builder: text::StringBuilder, value: string) -> () {
    builder.write_string("S\t");
    builder.write_string(lexer::encode_text_hex(value));
    builder.write_string("\n")
}

fn encode_bool_value(builder: text::StringBuilder, value: bool) -> () {
    builder.write_string(
        if value {
            "B\t1\n"
        } else {
            "B\t0\n"
        },
    )
}

fn encode_int_value(builder: text::StringBuilder, value: isize) -> () {
    builder.write_string("I\t");
    builder.write_string(value.to_string());
    builder.write_string("\n")
}

fn encode_list(builder: text::StringBuilder, length: isize) -> () {
    builder.write_string("L\t");
    builder.write_string(length.to_string());
    builder.write_string("\n")
}

fn encode_none(builder: text::StringBuilder) -> () {
    builder.write_string("N\n")
}

fn encode_some(builder: text::StringBuilder) -> () {
    builder.write_string("Y\n")
}

fn encode_span(builder: text::StringBuilder, value: Span) -> () {
    builder.write_string("R\t");
    builder.write_string(value.start.to_string());
    builder.write_string("\t");
    builder.write_string(value.end.to_string());
    builder.write_string("\n")
}

fn encode_path(builder: text::StringBuilder, value: Path) -> () {
    encode_open(builder, "Path");
    encode_list(builder, value.segments.len());
    for segment in value.segments {
        encode_open(builder, "Segment");
        encode_string_value(builder, segment.ident);
        encode_span(builder, segment.span);
        encode_close(builder)
    }
    encode_close(builder)
}

fn encode_type(builder: text::StringBuilder, value: TypeExpr) -> () {
    match value {
        Unit => encode_open(builder, "Type.Unit"),
        Bool => encode_open(builder, "Type.Bool"),
        Int => encode_open(builder, "Type.Int"),
        Int8 => encode_open(builder, "Type.Int8"),
        Int16 => encode_open(builder, "Type.Int16"),
        Int32 => encode_open(builder, "Type.Int32"),
        Int64 => encode_open(builder, "Type.Int64"),
        Uint => encode_open(builder, "Type.Uint"),
        Uint8 => encode_open(builder, "Type.Uint8"),
        Uint16 => encode_open(builder, "Type.Uint16"),
        Uint32 => encode_open(builder, "Type.Uint32"),
        Uint64 => encode_open(builder, "Type.Uint64"),
        Float32 => encode_open(builder, "Type.Float32"),
        Float64 => encode_open(builder, "Type.Float64"),
        String => encode_open(builder, "Type.String"),
        Char => encode_open(builder, "Type.Char"),
        Tuple { items: types } => {
            encode_open(builder, "Type.Tuple");
            encode_list(builder, types.len());
            for ty in types {
                encode_type(builder, ty)
            }
        },
        Con { path } => {
            encode_open(builder, "Type.Con");
            encode_path(builder, path)
        },
        Dyn { bounds } => {
            encode_open(builder, "Type.Dyn");
            encode_list(builder, bounds.len());
            for bound in bounds {
                encode_open(builder, "DynBound");
                encode_path(builder, bound.trait_path);
                encode_list(builder, bound.args.len());
                for arg in bound.args {
                    encode_type(builder, arg)
                }
                encode_list(builder, bound.associated_types.len());
                for binding in bound.associated_types {
                    encode_string_value(builder, binding.0);
                    encode_type(builder, binding.1)
                }
                encode_close(builder)
            }
        },
        App { ty, args } => {
            encode_open(builder, "Type.App");
            encode_type(builder, ty);
            encode_list(builder, args.len());
            for arg in args {
                encode_type(builder, arg)
            }
        },
        Array { len: length, elem: element } => {
            encode_open(builder, "Type.Array");
            encode_string_value(builder, length);
            encode_type(builder, element)
        },
        Func { params, ret_ty } => {
            encode_open(builder, "Type.Func");
            encode_list(builder, params.len());
            for param in params {
                encode_type(builder, param)
            }
            encode_type(builder, ret_ty)
        },
    }
    encode_close(builder)
}

fn encode_attribute(builder: text::StringBuilder, value: Attribute) -> () {
    encode_open(builder, "Attribute");
    encode_span(builder, value.span);
    encode_string_value(builder, value.text);
    encode_close(builder)
}

fn encode_attributes(builder: text::StringBuilder, values: Vec[Attribute]) -> () {
    encode_list(builder, values.len());
    for value in values {
        encode_attribute(builder, value)
    }
}

fn encode_visibility(builder: text::StringBuilder, value: Visibility) -> () {
    encode_string_value(
        builder,
        match value {
            Private => "Private",
            Public => "Public",
        },
    )
}

fn encode_trait_ref(builder: text::StringBuilder, value: TraitRef) -> () {
    encode_open(builder, "TraitRef");
    encode_path(builder, value.path);
    encode_list(builder, value.args.len());
    for arg in value.args {
        encode_type(builder, arg)
    }
    encode_close(builder)
}

fn encode_trait_refs(builder: text::StringBuilder, values: Vec[TraitRef]) -> () {
    encode_list(builder, values.len());
    for value in values {
        encode_trait_ref(builder, value)
    }
}

fn encode_generics(builder: text::StringBuilder, values: Vec[string]) -> () {
    encode_list(builder, values.len());
    for value in values {
        encode_string_value(builder, value)
    }
}

fn encode_generic_bounds(builder: text::StringBuilder, values: Vec[(string, Vec[TraitRef])]) -> () {
    encode_list(builder, values.len());
    for value in values {
        let (name, bounds) = value;
        encode_open(builder, "GenericBound");
        encode_string_value(builder, name);
        encode_trait_refs(builder, bounds);
        encode_close(builder)
    }
}

fn encode_predicates(builder: text::StringBuilder, values: Vec[Predicate]) -> () {
    encode_list(builder, values.len());
    for value in values {
        match value {
            Trait { ty, trait_ref } => {
                encode_open(builder, "Predicate.Trait");
                encode_type(builder, ty);
                encode_trait_ref(builder, trait_ref)
            },
            Equality { lhs, rhs } => {
                encode_open(builder, "Predicate.Equality");
                encode_type(builder, lhs);
                encode_type(builder, rhs)
            },
        }
        encode_close(builder)
    }
}

fn encode_params(builder: text::StringBuilder, values: Vec[(string, TypeExpr)]) -> () {
    encode_list(builder, values.len());
    for value in values {
        let (name, ty) = value;
        encode_open(builder, "Param");
        encode_string_value(builder, name);
        encode_type(builder, ty);
        encode_close(builder)
    }
}

fn encode_optional_type(builder: text::StringBuilder, value: Option[TypeExpr]) -> () {
    match value {
        Some(ty) => {
            encode_some(builder);
            encode_type(builder, ty)
        },
        None => encode_none(builder),
    }
}

fn encode_optional_string(builder: text::StringBuilder, value: Option[string]) -> () {
    match value {
        Some(text) => {
            encode_some(builder);
            encode_string_value(builder, text)
        },
        None => encode_none(builder),
    }
}

fn encode_function(builder: text::StringBuilder, value: Function) -> () {
    encode_open(builder, "Function");
    encode_attributes(builder, value.attrs);
    encode_visibility(builder, value.visibility);
    encode_string_value(builder, value.name);
    encode_generics(builder, value.generics);
    encode_generic_bounds(builder, value.generic_bounds);
    encode_predicates(builder, value.predicates);
    encode_params(builder, value.params);
    encode_optional_type(builder, value.ret_ty);
    encode_block(builder, value.body);
    encode_close(builder)
}

fn encode_extern_function(builder: text::StringBuilder, value: ExternFunction) -> () {
    encode_open(builder, "ExternFunction");
    encode_attributes(builder, value.attrs);
    encode_visibility(builder, value.visibility);
    encode_string_value(builder, value.name);
    encode_generics(builder, value.generics);
    encode_generic_bounds(builder, value.generic_bounds);
    encode_predicates(builder, value.predicates);
    encode_params(builder, value.params);
    encode_optional_type(builder, value.ret_ty);
    encode_close(builder)
}

fn encode_enum(builder: text::StringBuilder, value: EnumDef) -> () {
    encode_open(builder, "Enum");
    encode_attributes(builder, value.attrs);
    encode_visibility(builder, value.visibility);
    encode_string_value(builder, value.name);
    encode_generics(builder, value.generics);
    encode_list(builder, value.variants.len());
    for variant in value.variants {
        encode_open(builder, "Variant");
        if !variant.attrs.is_empty() {
            encode_attributes(builder, variant.attrs)
        }
        encode_string_value(builder, variant.name);
        match variant.fields {
            Unit => {
                encode_open(builder, "Unit");
                encode_close(builder)
            },
            Tuple(types) => {
                encode_open(builder, "Tuple");
                encode_list(builder, types.len());
                for index in 0..types.len() {
                    if index < variant.field_attrs.len() && !variant.field_attrs[index].is_empty() {
                        encode_attributes(builder, variant.field_attrs[index])
                    }
                    let ty = types[index];
                    encode_type(builder, ty)
                }
                encode_close(builder)
            },
            Struct(fields) => {
                encode_open(builder, "Struct");
                encode_list(builder, fields.len());
                for index in 0..fields.len() {
                    let field = fields[index];
                    encode_open(builder, "Field");
                    if index < variant.field_attrs.len() && !variant.field_attrs[index].is_empty() {
                        encode_attributes(builder, variant.field_attrs[index])
                    }
                    encode_string_value(builder, field.0);
                    encode_type(builder, field.1);
                    encode_close(builder)
                }
                encode_close(builder)
            },
        }
        encode_close(builder)
    }
    encode_close(builder)
}

fn encode_struct(builder: text::StringBuilder, value: StructDef) -> () {
    encode_open(
        builder,
        if value.newtype {
            "Newtype"
        } else {
            "Struct"
        },
    );
    encode_attributes(builder, value.attrs);
    encode_visibility(builder, value.visibility);
    encode_string_value(builder, value.name);
    encode_generics(builder, value.generics);
    encode_list(builder, value.fields.len());
    for index in 0..value.fields.len() {
        let field = value.fields[index];
        let (name, ty) = field;
        encode_open(builder, "Field");
        if index < value.field_attrs.len() && !value.field_attrs[index].is_empty() {
            encode_attributes(builder, value.field_attrs[index])
        }
        encode_string_value(builder, name);
        encode_type(builder, ty);
        encode_close(builder)
    }
    encode_list(builder, value.public_fields.len());
    for field in value.public_fields {
        encode_string_value(builder, field)
    }
    encode_close(builder)
}

fn encode_trait(builder: text::StringBuilder, value: TraitDef) -> () {
    encode_open(builder, "Trait");
    encode_attributes(builder, value.attrs);
    encode_visibility(builder, value.visibility);
    encode_string_value(builder, value.name);
    encode_generics(builder, value.generics);
    encode_generic_bounds(builder, value.generic_bounds);
    encode_predicates(builder, value.predicates);
    encode_trait_refs(builder, value.supertraits);
    encode_list(builder, value.associated_types.len());
    for associated in value.associated_types {
        encode_open(builder, "AssociatedType");
        encode_string_value(builder, associated.name);
        encode_trait_refs(builder, associated.bounds);
        encode_close(builder)
    }
    encode_list(builder, value.method_sigs.len());
    for method in value.method_sigs {
        encode_open(builder, "TraitMethod");
        encode_string_value(builder, method.name);
        encode_generics(builder, method.generics);
        encode_generic_bounds(builder, method.generic_bounds);
        encode_predicates(builder, method.predicates);
        encode_list(builder, method.params.len());
        for param in method.params {
            encode_string_value(builder, param.0);
            encode_type(builder, param.1)
        }
        encode_type(builder, method.ret_ty);
        match method.body {
            Some(body) => {
                encode_some(builder);
                encode_block(builder, body)
            },
            None => encode_none(builder),
        }
        encode_close(builder)
    }
    encode_close(builder)
}

fn encode_impl(builder: text::StringBuilder, value: ImplBlock) -> () {
    encode_open(builder, "Impl");
    encode_attributes(builder, value.attrs);
    encode_generics(builder, value.generics);
    encode_generic_bounds(builder, value.generic_bounds);
    encode_predicates(builder, value.predicates);
    encode_list(builder, value.associated_types.len());
    for associated in value.associated_types {
        let (name, ty) = associated;
        encode_open(builder, "ImplAssociatedType");
        encode_string_value(builder, name);
        encode_type(builder, ty);
        encode_close(builder)
    }
    match value.trait_ref {
        Some(trait_ref) => {
            encode_some(builder);
            encode_trait_ref(builder, trait_ref)
        },
        None => encode_none(builder),
    }
    encode_type(builder, value.for_type);
    encode_list(builder, value.methods.len());
    for method in value.methods {
        encode_function(builder, method)
    }
    encode_close(builder)
}

fn encode_type_alias(builder: text::StringBuilder, value: TypeAlias) -> () {
    encode_open(builder, "TypeAlias");
    encode_attributes(builder, value.attrs);
    encode_visibility(builder, value.visibility);
    encode_string_value(builder, value.name);
    encode_generics(builder, value.generics);
    encode_type(builder, value.ty);
    encode_close(builder)
}

fn encode_constant(builder: text::StringBuilder, value: Constant) -> () {
    encode_open(builder, "Constant");
    encode_attributes(builder, value.attrs);
    encode_visibility(builder, value.visibility);
    encode_string_value(builder, value.name);
    encode_type(builder, value.ty);
    encode_expr(builder, value.value);
    encode_close(builder)
}

fn encode_static(builder: text::StringBuilder, value: Static) -> () {
    encode_open(builder, "Static");
    encode_attributes(builder, value.attrs);
    encode_visibility(builder, value.visibility);
    encode_string_value(builder, value.name);
    encode_type(builder, value.ty);
    encode_expr(builder, value.value);
    encode_close(builder)
}

fn encode_item(builder: text::StringBuilder, value: Item) -> () {
    match value {
        EnumDef(item) => encode_enum(builder, item),
        StructDef(item) => encode_struct(builder, item),
        TraitDef(item) => encode_trait(builder, item),
        ImplBlock(item) => encode_impl(builder, item),
        Function(item) => encode_function(builder, item),
        ExternFunction(item) => encode_extern_function(builder, item),
        ExternType(item) => {
            encode_open(builder, "ExternType");
            encode_attributes(builder, item.attrs);
            encode_visibility(builder, item.visibility);
            encode_string_value(builder, item.name);
            encode_generics(builder, item.generics);
            encode_close(builder)
        },
        TypeAlias(item) => encode_type_alias(builder, item),
        Constant(item) => encode_constant(builder, item),
        Static(item) => encode_static(builder, item),
    }
}

fn encode_block(builder: text::StringBuilder, value: Block) -> () {
    encode_open(builder, "Block");
    encode_span(builder, value.span);
    encode_list(builder, value.stmts.len());
    for stmt in value.stmts {
        encode_stmt(builder, stmt)
    }
    match value.tail {
        Some(expr) => {
            encode_some(builder);
            encode_expr(builder, expr)
        },
        None => encode_none(builder),
    }
    encode_close(builder)
}

fn encode_stmt(builder: text::StringBuilder, value: Stmt) -> () {
    match value {
        Defer { expr, span: value_span } => {
            encode_open(builder, "Stmt.Defer");
            encode_span(builder, value_span);
            encode_expr(builder, expr)
        },
        Let { is_mut, pat, annotation, value: expr, else_branch, span: value_span } => {
            encode_open(builder, "Stmt.Let");
            encode_span(builder, value_span);
            encode_bool_value(builder, is_mut);
            encode_pat(builder, pat);
            encode_optional_type(builder, annotation);
            encode_expr(builder, expr);
            match else_branch {
                Some(value) => {
                    encode_some(builder);
                    encode_expr(builder, value)
                },
                None => encode_none(builder),
            }
        },
        Assign { target, op, value: expr, span: value_span } => {
            encode_open(builder, "Stmt.Assign");
            encode_span(builder, value_span);
            match op {
                Compound(value) => {
                    encode_some(builder);
                    encode_string_value(builder, binary_name(value))
                },
                Plain => encode_none(builder),
            }
            encode_expr(builder, target);
            encode_expr(builder, expr)
        },
        Expr { expr, span: value_span } => {
            encode_open(builder, "Stmt.Expr");
            encode_span(builder, value_span);
            encode_expr(builder, expr)
        },
    }
    encode_close(builder)
}

fn encode_file(builder: text::StringBuilder, value: File) -> () {
    encode_open(builder, "File");
    encode_string_value(builder, value.package_name);
    encode_bool_value(builder, value.package_explicit);
    encode_list(builder, value.uses.len());
    for use_decl in value.uses {
        encode_open(builder, "Use");
        encode_visibility(builder, use_decl.visibility);
        encode_path(builder, use_decl.path);
        match use_decl.alias {
            Some(alias) => {
                encode_some(builder);
                encode_string_value(builder, alias)
            },
            None => encode_none(builder),
        }
        encode_list(builder, use_decl.items.len());
        for item in use_decl.items {
            encode_open(builder, "UseItem");
            encode_string_value(builder, item.name);
            match item.alias {
                Some(alias) => {
                    encode_some(builder);
                    encode_string_value(builder, alias)
                },
                None => encode_none(builder),
            }
            encode_span(builder, item.span);
            encode_close(builder)
        }
        encode_close(builder)
    }
    encode_list(builder, value.items.len());
    for item in value.items {
        encode_item(builder, item)
    }
    encode_close(builder)
}

pub fn encode(value: LowerResult) -> string {
    let builder = text::StringBuilder::new();
    match value.ast {
        Some(file) => {
            encode_some(builder);
            encode_file(builder, file)
        },
        None => encode_none(builder),
    }
    encode_list(builder, value.diagnostics.len());
    for diagnostic in value.diagnostics {
        encode_open(builder, "Diagnostic");
        encode_span(builder, span(diagnostic.start, diagnostic.end));
        encode_string_value(builder, diagnostic.message);
        encode_close(builder)
    }
    builder.finish()
}
