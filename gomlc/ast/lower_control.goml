package ast;

use module::cst;
use module::lexer;

fn lower_loop_label(node: LocatedNode) -> Option[string] {
    first_token(node, lexer::TokenKind::Label).map(
        |token| token.token.text.byte_slice(1, token.token.text.byte_len()),
    )
}

fn lower_wrapped_branch(ctx: LowerCtx, node: LocatedNode, missing_message: string) -> Option[Expr] {
    match first_child(node, cst::NodeKind::BLOCK) {
        Some(block_node) => lower_block(ctx, block_node).map(
            |block| Expr::Block { block, span: node_span(block_node) },
        ),
        None => {
            let values = expr_children(node);
            if !values.is_empty() {
                lower_expr(ctx, values[0])
            } else {
                push_error(ctx, node_span(node), missing_message);
                None
            }
        },
    }
}

fn lower_match_arm(ctx: LowerCtx, node: LocatedNode) -> Option[Arm] {
    let patterns = pattern_children(node);
    if patterns.is_empty() {
        None
    } else {
        match lower_pat(ctx, patterns[0]) {
            Some(pat) => {
                let guard = match first_child(node, cst::NodeKind::MATCH_ARM_GUARD) {
                    Some(guard_node) => {
                        let values = expr_children(guard_node);
                        if !values.is_empty() {
                            lower_expr(ctx, values[0])
                        } else {
                            None
                        }
                    },
                    None => None,
                };
                let values = expr_children(node);
                let body = if !values.is_empty() {
                    lower_expr(ctx, values[0])
                } else {
                    match first_child(node, cst::NodeKind::BLOCK) {
                        Some(block_node) => lower_block(ctx, block_node).map(
                            |block| Expr::Block { block, span: node_span(block_node) },
                        ),
                        None => {
                            push_error(ctx, node_span(node), "Match arm has no body");
                            None
                        },
                    }
                };
                body.map(|value| Arm { pat, guard, body: value })
            },
            None => None,
        }
    }
}

fn lower_match_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to match expression") {
        None
    } else {
        let values = expr_children(node);
        if values.is_empty() {
            push_error(ctx, node_span(node), "MatchExpr has no expr");
            None
        } else {
            match lower_expr(ctx, values[0]) {
                Some(scrutinee) => match first_child(node, cst::NodeKind::MATCH_ARM_LIST) {
                    Some(list) => {
                        let arms: Vec[Arm] = Vec::new();
                        for arm in children_of_kind(list, cst::NodeKind::MATCH_ARM) {
                            if let Some(value) = lower_match_arm(ctx, arm) {
                                arms.push(value)
                            }
                        }
                        Some(Expr::Match { expr: scrutinee, arms, span: node_span(node) })
                    },
                    None => {
                        push_error(ctx, node_span(node), "MatchExpr has no arms");
                        None
                    },
                },
                None => None,
            }
        }
    }
}

fn lower_select_arm_body(ctx: LowerCtx, node: LocatedNode, expression_index: isize) -> Option[Expr] {
    let values = expr_children(node);
    if expression_index < values.len() {
        lower_expr(ctx, values[expression_index])
    } else {
        match first_child(node, cst::NodeKind::BLOCK) {
            Some(block_node) => lower_block(ctx, block_node).map(
                |block| Expr::Block { block, span: node_span(block_node) },
            ),
            None => {
                push_error(ctx, node_span(node), "Select arm has no body");
                None
            },
        }
    }
}

fn lower_select_recv_arm(ctx: LowerCtx, node: LocatedNode) -> Option[SelectArm] {
    let values = expr_children(node);
    if values.is_empty() {
        push_error(ctx, node_span(node), "Receive select arm has no channel");
        None
    } else {
        let binding_node = first_child(node, cst::NodeKind::SELECT_RECV_BINDING);
        let match_list = first_child(node, cst::NodeKind::MATCH_ARM_LIST);
        let binding = match binding_node {
            Some(binding_node) => match first_token(binding_node, lexer::TokenKind::Ident) {
                Some(token) => token.token.text,
                None => "_",
            },
            None => match match_list {
                Some(_) => f"$select_recv_{node_span(node).start}",
                None => "_",
            },
        };
        let guard = match first_child(node, cst::NodeKind::SELECT_ARM_GUARD) {
            Some(guard_node) => {
                let guard_values = expr_children(guard_node);
                if guard_values.is_empty() {
                    Option::None
                } else {
                    lower_expr(ctx, guard_values[0])
                }
            },
            None => Option::None,
        };
        let body = match match_list {
            Some(list) => {
                let arms: Vec[Arm] = Vec::new();
                for arm in children_of_kind(list, cst::NodeKind::MATCH_ARM) {
                    if let Some(value) = lower_match_arm(ctx, arm) {
                        arms.push(value)
                    }
                }
                let temporary_span = node_span(node);
                Option::Some(
                    Expr::Match {
                        expr: Expr::Path {
                            path: path_from_single_ident(binding),
                            owner_type_args: Vec::new(),
                            member_type_args: Vec::new(),
                            span: temporary_span,
                        },
                        arms,
                        span: temporary_span,
                    },
                )
            },
            None => lower_select_arm_body(ctx, node, 1),
        };
        match (lower_expr(ctx, values[0]), body) {
            (Some(channel), Some(body)) => Some(
                SelectArm::Receive { channel, guard, binding, body, span: node_span(node) },
            ),
            _ => None,
        }
    }
}

fn lower_select_send_arm(ctx: LowerCtx, node: LocatedNode) -> Option[SelectArm] {
    let values = expr_children(node);
    if values.len() < 2 {
        push_error(ctx, node_span(node), "Send select arm requires a channel and value");
        None
    } else {
        match (
            lower_expr(ctx, values[0]),
            lower_expr(ctx, values[1]),
            match first_child(node, cst::NodeKind::SELECT_ARM_GUARD) {
                Some(guard_node) => {
                    let guard_values = expr_children(guard_node);
                    if guard_values.is_empty() {
                        Option::None
                    } else {
                        lower_expr(ctx, guard_values[0])
                    }
                },
                None => Option::None,
            },
            lower_select_arm_body(ctx, node, 2),
        ) {
            (Some(channel), Some(value), guard, Some(body)) => Some(
                SelectArm::Send { channel, value, guard, body, span: node_span(node) },
            ),
            _ => None,
        }
    }
}

fn lower_select_default_arm(ctx: LowerCtx, node: LocatedNode) -> Option[SelectArm] {
    lower_select_arm_body(ctx, node, 0).map(
        |body| SelectArm::Default { body, span: node_span(node) },
    )
}

fn lower_select_mode(node: LocatedNode) -> SelectMode {
    for token in direct_tokens(node) {
        if lexer::token_kind_equal(token.token.kind, lexer::TokenKind::Ident)
            && token.token.text == "priority" {
            return SelectMode::Priority
        }
    }
    SelectMode::Normal
}

fn lower_select_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to select expression") {
        None
    } else {
        match first_child(node, cst::NodeKind::SELECT_ARM_LIST) {
            Some(list) => {
                let arms: Vec[SelectArm] = Vec::new();
                for arm in direct_nodes(list) {
                    let lowered = match node_kind(arm) {
                        SELECT_RECV_ARM => lower_select_recv_arm(ctx, arm),
                        SELECT_SEND_ARM => lower_select_send_arm(ctx, arm),
                        SELECT_DEFAULT_ARM => lower_select_default_arm(ctx, arm),
                        _ => None,
                    };
                    if let Some(value) = lowered {
                        arms.push(value)
                    }
                }
                Some(Expr::Select { mode: lower_select_mode(node), arms, span: node_span(node) })
            },
            None => {
                push_error(ctx, node_span(node), "SelectExpr has no arms");
                None
            },
        }
    }
}

fn lower_condition_chain(ctx: LowerCtx, node: LocatedNode, condition: LocatedNode, is_while: bool) -> Option[
    Expr,
] {
    let conditions: Vec[(Option[Pat], Expr)] = Vec::new();
    for term in children_of_kind(condition, cst::NodeKind::CONDITION_TERM) {
        let patterns = pattern_children(term);
        let pat = if patterns.is_empty() {
            Option::None
        } else {
            lower_pat(ctx, patterns[0])
        };
        let values = expr_children(term);
        if values.is_empty() {
            return None
        }
        conditions.push((pat, lower_expr(ctx, values[0])?))
    }
    let body_kind = if is_while {
        cst::NodeKind::EXPR_WHILE_BODY
    } else {
        cst::NodeKind::EXPR_IF_THEN
    };
    let then_branch = lower_wrapped_branch(
        ctx,
        first_child(node, body_kind)?,
        "condition chain requires a body",
    )?;
    let span = node_span(node);
    let else_branch = if is_while {
        Expr::Break { label: Option::None, value: Option::None, span }
    } else {
        match first_child(node, cst::NodeKind::EXPR_IF_ELSE) {
            Some(branch) => lower_wrapped_branch(
                ctx,
                branch,
                "condition chain requires an else body",
            )?,
            None => Expr::Unit { span },
        }
    };
    let body = Expr::IfChain { conditions, then_branch, else_branch, span };
    Some(
        if is_while {
            Expr::While {
                label: lower_loop_label(node),
                cond: Expr::Bool { value: true, span },
                body,
                span,
            }
        } else {
            body
        },
    )
}

fn lower_if_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to if expression") {
        None
    } else {
        match first_child(node, cst::NodeKind::EXPR_IF_COND) {
            Some(condition_node) => {
                if first_child(condition_node, cst::NodeKind::CONDITION_TERM).is_some() {
                    return lower_condition_chain(ctx, node, condition_node, false)
                }
                let patterns = pattern_children(condition_node);
                let let_pat = if !patterns.is_empty() {
                    lower_pat(ctx, patterns[0])
                } else {
                    None
                };
                let values = expr_children(condition_node);
                if values.is_empty() {
                    push_error(ctx, node_span(node), "If expression missing condition");
                    None
                } else {
                    match lower_expr(ctx, values[0]) {
                        Some(cond) => match first_child(node, cst::NodeKind::EXPR_IF_THEN) {
                            Some(then_node) => match lower_wrapped_branch(
                                ctx,
                                then_node,
                                "If expression then-branch missing body",
                            ) {
                                Some(then_branch) => {
                                    let else_branch = match first_child(
                                        node,
                                        cst::NodeKind::EXPR_IF_ELSE,
                                    ) {
                                        Some(else_node) => lower_wrapped_branch(
                                            ctx,
                                            else_node,
                                            "If expression else-branch missing body",
                                        ),
                                        None => Some(Expr::Unit { span: node_span(node) }),
                                    };
                                    match else_branch {
                                        Some(else_value) => match let_pat {
                                            Some(pat) => {
                                                let arms: Vec[Arm] = Vec::new();
                                                arms.push(
                                                    Arm {
                                                        pat,
                                                        guard: Option::None,
                                                        body: then_branch,
                                                    },
                                                );
                                                arms.push(
                                                    Arm {
                                                        pat: Pat::Wild { span: node_span(node) },
                                                        guard: Option::None,
                                                        body: else_value,
                                                    },
                                                );
                                                Some(
                                                    Expr::Match {
                                                        expr: cond,
                                                        arms,
                                                        span: node_span(node),
                                                    },
                                                )
                                            },
                                            None => Some(
                                                Expr::If {
                                                    cond,
                                                    then_branch,
                                                    else_branch: else_value,
                                                    span: node_span(node),
                                                },
                                            ),
                                        },
                                        None => None,
                                    }
                                },
                                None => None,
                            },
                            None => {
                                push_error(
                                    ctx,
                                    node_span(node),
                                    "If expression missing then branch",
                                );
                                None
                            },
                        },
                        None => None,
                    }
                }
            },
            None => {
                push_error(ctx, node_span(node), "If expression missing condition");
                None
            },
        }
    }
}

fn lower_while_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to while expression") {
        None
    } else {
        match first_child(node, cst::NodeKind::EXPR_WHILE_COND) {
            Some(condition_node) => {
                if first_child(condition_node, cst::NodeKind::CONDITION_TERM).is_some() {
                    return lower_condition_chain(ctx, node, condition_node, true)
                }
                let patterns = pattern_children(condition_node);
                let let_pat = if !patterns.is_empty() {
                    lower_pat(ctx, patterns[0])
                } else {
                    None
                };
                let values = expr_children(condition_node);
                if values.is_empty() {
                    push_error(ctx, node_span(node), "While expression missing condition");
                    None
                } else {
                    match lower_expr(ctx, values[0]) {
                        Some(cond) => match first_child(node, cst::NodeKind::EXPR_WHILE_BODY) {
                            Some(body_node) => match lower_wrapped_branch(
                                ctx,
                                body_node,
                                "While expression body missing expression",
                            ) {
                                Some(body) => match let_pat {
                                    Some(pat) => {
                                        let arms: Vec[Arm] = Vec::new();
                                        arms.push(Arm { pat, guard: Option::None, body });
                                        arms.push(
                                            Arm {
                                                pat: Pat::Wild { span: node_span(node) },
                                                guard: Option::None,
                                                body: Expr::Break {
                                                    label: Option::None,
                                                    value: Option::None,
                                                    span: node_span(node),
                                                },
                                            },
                                        );
                                        Some(
                                            Expr::While {
                                                label: lower_loop_label(node),
                                                cond: Expr::Bool {
                                                    value: true,
                                                    span: node_span(node),
                                                },
                                                body: Expr::Match {
                                                    expr: cond,
                                                    arms,
                                                    span: node_span(node),
                                                },
                                                span: node_span(node),
                                            },
                                        )
                                    },
                                    None => Some(
                                        Expr::While {
                                            label: lower_loop_label(node),
                                            cond,
                                            body,
                                            span: node_span(node),
                                        },
                                    ),
                                },
                                None => None,
                            },
                            None => {
                                push_error(ctx, node_span(node), "While expression missing body");
                                None
                            },
                        },
                        None => None,
                    }
                }
            },
            None => {
                push_error(ctx, node_span(node), "While expression missing condition");
                None
            },
        }
    }
}

fn lower_loop_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to loop expression") {
        None
    } else {
        match first_child(node, cst::NodeKind::BLOCK) {
            Some(body_node) => lower_block(ctx, body_node).map(
                |body| Expr::Loop {
                    label: lower_loop_label(node),
                    body: Expr::Block { block: body, span: node_span(body_node) },
                    span: node_span(node),
                },
            ),
            None => {
                push_error(ctx, node_span(node), "Loop expression missing body");
                None
            },
        }
    }
}

fn lower_for_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to for expression") {
        None
    } else {
        let patterns = pattern_children(node);
        let values = expr_children(node);
        if patterns.is_empty() {
            push_error(ctx, node_span(node), "For expression missing pattern");
            None
        } else if values.is_empty() {
            push_error(ctx, node_span(node), "For expression missing iterator");
            None
        } else {
            match lower_pat(ctx, patterns[0]) {
                Some(pat) => match lower_expr(ctx, values[0]) {
                    Some(iterator) => match first_child(node, cst::NodeKind::BLOCK) {
                        Some(block_node) => lower_block(ctx, block_node).map(
                            |block| Expr::For {
                                label: lower_loop_label(node),
                                pat,
                                iterator,
                                body: Expr::Block { block, span: node_span(block_node) },
                                span: node_span(node),
                            },
                        ),
                        None => {
                            push_error(ctx, node_span(node), "For expression missing body");
                            None
                        },
                    },
                    None => None,
                },
                None => None,
            }
        }
    }
}

fn lower_return_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to return expression") {
        None
    } else {
        let values = expr_children(node);
        let value = if !values.is_empty() {
            lower_expr(ctx, values[0])
        } else {
            None
        };
        Some(Expr::Return { expr: value, span: node_span(node) })
    }
}

fn lower_go_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to go expression") {
        None
    } else {
        let values = expr_children(node);
        if values.is_empty() {
            push_error(ctx, node_span(node), "go statement missing expression");
            None
        } else {
            lower_expr(ctx, values[0]).map(|value| Expr::Go { expr: value, span: node_span(node) })
        }
    }
}

fn lower_scope_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to scope expression") {
        None
    } else {
        match first_child(node, cst::NodeKind::BLOCK) {
            Some(block_node) => lower_block(ctx, block_node).map(
                |block| Expr::Scope {
                    body: Expr::Block { block, span: node_span(block_node) },
                    span: node_span(node),
                },
            ),
            None => {
                push_error(ctx, node_span(node), "scope expression missing body");
                None
            },
        }
    }
}

fn lower_spawn_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to spawn expression") {
        None
    } else {
        let values = expr_children(node);
        if values.is_empty() {
            push_error(ctx, node_span(node), "spawn expression missing closure");
            None
        } else {
            lower_expr(ctx, values[0]).map(|body| Expr::Spawn { body, span: node_span(node) })
        }
    }
}
