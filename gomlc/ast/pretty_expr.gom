package ast;

use module::pretty as doc;
use std::text;

fn pretty_decimal_byte(value: string) -> u8 {
    let mut result = 0;
    for index in 0..value.byte_len() {
        result = result * 10 + (value.byte_get(index) - 48).to_isize();
    }
    result.to_u8()
}

fn pretty_write_byte_literal(builder: text::StringBuilder, value: string) -> () {
    let byte = pretty_decimal_byte(value);
    builder.write_string("b'\\x");
    builder.write_char(pretty_hex_digit(byte / 16));
    builder.write_char(pretty_hex_digit(byte % 16));
    builder.write_char('\'')
}

fn pretty_write_byte_string(builder: text::StringBuilder, values: Vec[string]) -> () {
    builder.write_string("b\"");
    for value in values {
        let byte = pretty_decimal_byte(value);
        builder.write_string("\\x");
        builder.write_char(pretty_hex_digit(byte / 16));
        builder.write_char(pretty_hex_digit(byte % 16))
    }
    builder.write_char('"')
}

fn pretty_byte_literal_doc(value: string) -> doc::Doc {
    let builder = text::StringBuilder::new();
    pretty_write_byte_literal(builder, value);
    doc::text(builder.finish())
}

fn pretty_byte_string_doc(values: Vec[string]) -> doc::Doc {
    let builder = text::StringBuilder::new();
    pretty_write_byte_string(builder, values);
    doc::text(builder.finish())
}

fn pretty_interpolated_text_doc(value: string) -> doc::Doc {
    let builder = text::StringBuilder::new();
    let mut index = 0;
    while index < value.byte_len() {
        let byte = value.byte_get(index);
        if byte == b'"' {
            builder.write_string("\\\"")
        } else if byte == b'\\' {
            builder.write_string("\\\\")
        } else if byte == b'\n' {
            builder.write_string("\\n")
        } else if byte == b'\r' {
            builder.write_string("\\r")
        } else if byte == b'\t' {
            builder.write_string("\\t")
        } else if byte == b'{' {
            builder.write_string("{{")
        } else if byte == b'}' {
            builder.write_string("}}")
        } else {
            let width = pretty_utf8_width(byte);
            builder.write_string(value.byte_slice(index, index + width))
        }
        index = index + pretty_utf8_width(byte);
    }
    doc::text(builder.finish())
}

fn pretty_expr_docs(values: Vec[Expr]) -> Vec[doc::Doc] {
    let result: Vec[doc::Doc] = Vec::with_capacity(values.len());
    for value in values {
        result.push(pretty_expr_doc(value))
    }
    result
}

fn pretty_loop_keyword(keyword: string, label: Option[string]) -> string {
    match label {
        Some(value) => "'" + value + ": " + keyword,
        None => keyword,
    }
}

fn pretty_control_keyword(keyword: string, label: Option[string]) -> string {
    match label {
        Some(value) => keyword + " '" + value,
        None => keyword,
    }
}

fn pretty_pat_docs(values: Vec[Pat]) -> Vec[doc::Doc] {
    let result: Vec[doc::Doc] = Vec::with_capacity(values.len());
    for value in values {
        result.push(pretty_pat_doc(value))
    }
    result
}

fn pretty_record_doc(header: doc::Doc, values: Vec[doc::Doc]) -> doc::Doc {
    if values.is_empty() {
        doc::append(header, doc::text(" {}"))
    } else {
        doc::group(
            doc::concat(
                Vec::from_array(
                    [
                        header,
                        doc::text(" {"),
                        doc::nest(
                            2,
                            doc::append(
                                doc::line(),
                                doc::join(doc::append(doc::text(","), doc::line()), values),
                            ),
                        ),
                        doc::line(),
                        doc::text("}"),
                    ],
                ),
            ),
        )
    }
}

fn pretty_braced_docs(values: Vec[doc::Doc], indentation: isize) -> doc::Doc {
    if values.is_empty() {
        doc::text("{}")
    } else {
        doc::concat(
            Vec::from_array(
                [
                    doc::text("{"),
                    doc::nest(indentation, doc::append(doc::hardline(), doc::stack(values))),
                    doc::hardline(),
                    doc::text("}"),
                ],
            ),
        )
    }
}

fn pretty_block_doc(value: Block) -> doc::Doc {
    let values: Vec[doc::Doc] = Vec::with_capacity(
        value.stmts.len()
            + if value.tail.is_some() {
                1
            } else {
                0
            },
    );
    for statement in value.stmts {
        values.push(doc::append(pretty_stmt_doc(statement), doc::text(";")))
    }
    if let Some(tail) = value.tail {
        values.push(pretty_expr_doc(tail))
    }
    pretty_braced_docs(values, 4)
}

fn pretty_stmt_doc(value: Stmt) -> doc::Doc {
    match value {
        Defer { expr, span: _ } => doc::group(
            doc::concat(
                Vec::from_array(
                    [
                        doc::text("defer"),
                        doc::nest(2, doc::append(doc::line(), pretty_expr_doc(expr))),
                    ],
                ),
            ),
        ),
        Let { is_mut, pat, annotation, value: expr, else_branch, span: _ } => {
            let annotation_doc = match annotation {
                Some(ty) => doc::append(doc::text(": "), pretty_type_doc(ty)),
                None => doc::nil(),
            };
            let else_doc = match else_branch {
                Some(value) => doc::concat(
                    Vec::from_array(
                        [
                            doc::text(" else"),
                            doc::nest(2, doc::append(doc::line(), pretty_expr_doc(value))),
                        ],
                    ),
                ),
                None => doc::nil(),
            };
            doc::group(
                doc::concat(
                    Vec::from_array(
                        [
                            doc::text(
                                if is_mut {
                                    "let mut "
                                } else {
                                    "let "
                                },
                            ),
                            pretty_pat_doc(pat),
                            annotation_doc,
                            doc::text(" ="),
                            doc::nest(2, doc::append(doc::line(), pretty_expr_doc(expr))),
                            else_doc,
                        ],
                    ),
                ),
            )
        },
        Assign { target, op, value: expr, span: _ } => doc::group(
            doc::concat(
                Vec::from_array(
                    [
                        pretty_expr_doc(target),
                        doc::text(
                            match op {
                                Compound(value) => " " + pretty_binary_symbol(value) + "=",
                                Plain => " =",
                            },
                        ),
                        doc::nest(2, doc::append(doc::line(), pretty_expr_doc(expr))),
                    ],
                ),
            ),
        ),
        Expr { expr, span: _ } => pretty_expr_doc(expr),
    }
}

fn pretty_path_expr_doc(path: Path, owner_type_args: Vec[TypeExpr], member_type_args: Vec[TypeExpr]) -> doc::Doc {
    let owner = if owner_type_args.is_empty() {
        pretty_path_doc(path)
    } else {
        let last = path.segments.len() - 1;
        let prefixes: Vec[doc::Doc] = Vec::with_capacity(last);
        for index in 0..last {
            prefixes.push(doc::text(path.segments[index].ident))
        }
        doc::concat(
            Vec::from_array(
                [
                    doc::join(doc::text("::"), prefixes),
                    doc::text("::"),
                    doc::delimited("[", ",", "]", pretty_type_docs(owner_type_args)),
                    if last > 0 {
                        doc::text("::" + path.segments[last].ident)
                    } else {
                        doc::nil()
                    },
                ],
            ),
        )
    };
    if member_type_args.is_empty() {
        owner
    } else {
        doc::concat(
            Vec::from_array(
                [
                    owner,
                    doc::text("::"),
                    doc::delimited("[", ",", "]", pretty_type_docs(member_type_args)),
                ],
            ),
        )
    }
}

fn pretty_arm_doc(value: Arm) -> doc::Doc {
    let guard = match value.guard {
        Some(guard) => doc::append(doc::text(" if "), pretty_expr_doc(guard)),
        None => doc::nil(),
    };
    doc::group(
        doc::concat(
            Vec::from_array(
                [
                    pretty_pat_doc(value.pat),
                    guard,
                    doc::text(" =>"),
                    doc::nest(2, doc::append(doc::line(), pretty_expr_doc(value.body))),
                    doc::text(","),
                ],
            ),
        ),
    )
}

fn pretty_select_arm_doc(value: SelectArm) -> doc::Doc {
    let parts: Vec[doc::Doc] = match value {
        Receive { channel, guard, binding, body, span: _ } => Vec::from_array(
            [
                doc::text("recv("),
                pretty_expr_doc(channel),
                match guard {
                    Some(value) => doc::concat(
                        Vec::from_array(
                            [
                                doc::text(") when "),
                                pretty_expr_doc(value),
                                doc::text(" as " + binding + " =>"),
                            ],
                        ),
                    ),
                    None => doc::text(") as " + binding + " =>"),
                },
                doc::nest(2, doc::append(doc::line(), pretty_expr_doc(body))),
                doc::text(","),
            ],
        ),
        Send { channel, value, guard, body, span: _ } => Vec::from_array(
            [
                doc::text("send("),
                pretty_expr_doc(channel),
                doc::text(", "),
                pretty_expr_doc(value),
                match guard {
                    Some(value) => doc::concat(
                        Vec::from_array(
                            [doc::text(") when "), pretty_expr_doc(value), doc::text(" =>")],
                        ),
                    ),
                    None => doc::text(") =>"),
                },
                doc::nest(2, doc::append(doc::line(), pretty_expr_doc(body))),
                doc::text(","),
            ],
        ),
        Default { body, span: _ } => Vec::from_array(
            [
                doc::text("default =>"),
                doc::nest(2, doc::append(doc::line(), pretty_expr_doc(body))),
                doc::text(","),
            ],
        ),
    };
    doc::group(doc::concat(parts))
}

fn pretty_expr_doc(value: Expr) -> doc::Doc {
    match value {
        Path { path, owner_type_args, member_type_args, span: _ } => {
            pretty_path_expr_doc(path, owner_type_args, member_type_args)
        },
        Unit { span: _ } => doc::text("()"),
        Bool { value, span: _ } => doc::text(
            if value {
                "true"
            } else {
                "false"
            },
        ),
        Int { value, span: _ } => doc::text(value),
        Float { value, span: _ } => doc::text(value),
        String { value, span: _ } => pretty_quoted_string_doc(value),
        InterpolatedString { parts, span: _ } => {
            let values: Vec[doc::Doc] = Vec::with_capacity(parts.len() + 2);
            values.push(doc::text("f\""));
            for part in parts {
                match part {
                    Text(value) => values.push(pretty_interpolated_text_doc(value)),
                    Expr(value) => values.push(
                        doc::concat(
                            Vec::from_array(
                                [doc::text("{"), pretty_expr_doc(value), doc::text("}")],
                            ),
                        ),
                    ),
                }
            }
            values.push(doc::text("\""));
            doc::concat(values)
        },
        Char { value, span: _ } => doc::text("'" + value + "'"),
        Byte { value, span: _ } => pretty_byte_literal_doc(value),
        ByteString { values, span: _ } => pretty_byte_string_doc(values),
        ConstructorValue { constructor: path, span: _ } => pretty_path_doc(path),
        Constr { constructor: path, args, span: _ } => {
            if args.is_empty() {
                pretty_path_doc(path)
            } else {
                doc::append(
                    pretty_path_doc(path),
                    doc::delimited("(", ",", ")", pretty_expr_docs(args)),
                )
            }
        },
        StructLiteral { name: path, fields, base, span: _ } => {
            let values: Vec[doc::Doc] = Vec::with_capacity(
                fields.len()
                    + if base.is_some() {
                        1
                    } else {
                        0
                    },
            );
            for field in fields {
                values.push(
                    doc::concat(
                        Vec::from_array([doc::text(field.0 + ": "), pretty_expr_doc(field.1)]),
                    ),
                )
            }
            if let Some(value) = base {
                values.push(doc::append(doc::text(".."), pretty_expr_doc(value)))
            }
            pretty_record_doc(pretty_path_doc(path), values)
        },
        Tuple { items: values, span: _ } => {
            doc::delimited("(", ",", ")", pretty_expr_docs(values))
        },
        ArrayRepeat { value, len, span: _ } => doc::concat(
            Vec::from_array([doc::text("["), pretty_expr_doc(value), doc::text("; " + len + "]")]),
        ),
        Array { items: values, span: _ } => {
            doc::delimited("[", ",", "]", pretty_expr_docs(values))
        },
        Closure { params, body, span: _ } => {
            let values: Vec[doc::Doc] = Vec::with_capacity(params.len());
            for param in params {
                let ty = match param.ty {
                    Some(ty) => doc::append(doc::text(": "), pretty_type_doc(ty)),
                    None => doc::nil(),
                };
                values.push(doc::append(doc::text(param.name), ty))
            }
            let parameters = if values.is_empty() {
                doc::text("||")
            } else {
                doc::delimited("|", ",", "|", values)
            };
            doc::concat(Vec::from_array([parameters, doc::text(" "), pretty_expr_doc(body)]))
        },
        Match { expr, arms, span: _ } => {
            let values: Vec[doc::Doc] = Vec::with_capacity(arms.len());
            for arm in arms {
                values.push(pretty_arm_doc(arm))
            }
            doc::concat(
                Vec::from_array(
                    [
                        doc::text("match "),
                        pretty_expr_doc(expr),
                        doc::text(" "),
                        pretty_braced_docs(values, 4),
                    ],
                ),
            )
        },
        Select { mode, arms, span: _ } => {
            let values: Vec[doc::Doc] = Vec::with_capacity(arms.len());
            for arm in arms {
                values.push(pretty_select_arm_doc(arm))
            }
            doc::concat(
                Vec::from_array(
                    [
                        doc::text(
                            match mode {
                                SelectMode::Normal => "select ",
                                SelectMode::Priority => "select priority ",
                            },
                        ),
                        pretty_braced_docs(values, 4),
                    ],
                ),
            )
        },
        IfChain { conditions, then_branch, else_branch, span: _ } => {
            let terms: Vec[doc::Doc] = Vec::new();
            for condition in conditions {
                let prefix = match condition.0 {
                    Some(pat) => doc::concat(
                        Vec::from_array([doc::text("let "), pretty_pat_doc(pat), doc::text(" = ")]),
                    ),
                    None => doc::nil(),
                };
                terms.push(doc::append(prefix, pretty_expr_doc(condition.1)))
            }
            doc::concat(
                Vec::from_array(
                    [
                        doc::text("if "),
                        doc::join(doc::text(" && "), terms),
                        doc::text(" "),
                        pretty_expr_doc(then_branch),
                        doc::text(" else "),
                        pretty_expr_doc(else_branch),
                    ],
                ),
            )
        },
        If { cond, then_branch, else_branch, span: _ } => doc::concat(
            Vec::from_array(
                [
                    doc::text("if "),
                    pretty_expr_doc(cond),
                    doc::text(" "),
                    pretty_braced_docs(Vec::from_array([pretty_expr_doc(then_branch)]), 4),
                    doc::text(" else "),
                    pretty_braced_docs(Vec::from_array([pretty_expr_doc(else_branch)]), 4),
                ],
            ),
        ),
        While { label, cond, body, span: _ } => doc::concat(
            Vec::from_array(
                [
                    doc::text(pretty_loop_keyword("while", label) + " "),
                    pretty_expr_doc(cond),
                    doc::text(" "),
                    pretty_braced_docs(Vec::from_array([pretty_expr_doc(body)]), 4),
                ],
            ),
        ),
        Loop { label, body, span: _ } => doc::append(
            doc::text(pretty_loop_keyword("loop", label) + " "),
            pretty_expr_doc(body),
        ),
        For { label, pat, iterator, body, span: _ } => doc::group(
            doc::concat(
                Vec::from_array(
                    [
                        doc::text(pretty_loop_keyword("for", label) + " "),
                        pretty_pat_doc(pat),
                        doc::text(" in"),
                        doc::nest(2, doc::append(doc::line(), pretty_expr_doc(iterator))),
                        doc::text(" "),
                        pretty_expr_doc(body),
                    ],
                ),
            ),
        ),
        Break { label, value, span: _ } => match value {
            Some(expr) => doc::append(
                doc::text(pretty_control_keyword("break", label) + " "),
                pretty_expr_doc(expr),
            ),
            None => doc::text(pretty_control_keyword("break", label)),
        },
        Continue { label, span: _ } => doc::text(pretty_control_keyword("continue", label)),
        Return { expr, span: _ } => match expr {
            Some(value) => doc::append(doc::text("return "), pretty_expr_doc(value)),
            None => doc::text("return"),
        },
        Go { expr, span: _ } => doc::append(doc::text("go "), pretty_expr_doc(expr)),
        Scope { body, span: _ } => doc::append(doc::text("scope "), pretty_expr_doc(body)),
        Comptime { block, span: _ } => {
            doc::append(doc::text("comptime "), pretty_block_doc(block))
        },
        Spawn { body, span: _ } => doc::append(doc::text("spawn "), pretty_expr_doc(body)),
        Call { func, args, span: _ } => doc::append(
            pretty_expr_doc(func),
            doc::delimited("(", ",", ")", pretty_expr_docs(args)),
        ),
        Unary { op, expr, span: _ } => {
            doc::append(doc::text(pretty_unary_symbol(op)), pretty_expr_doc(expr))
        },
        Cast { expr, ty, span: _ } => doc::group(
            doc::concat(
                Vec::from_array(
                    [
                        pretty_expr_doc(expr),
                        doc::text(" as"),
                        doc::nest(2, doc::append(doc::line(), pretty_type_doc(ty))),
                    ],
                ),
            ),
        ),
        Try { expr, span: _ } => doc::append(pretty_expr_doc(expr), doc::text("?")),
        Range { start, end, inclusive, span: _ } => doc::concat(
            Vec::from_array(
                [
                    pretty_expr_doc(start),
                    doc::text(
                        if inclusive {
                            "..="
                        } else {
                            ".."
                        },
                    ),
                    pretty_expr_doc(end),
                ],
            ),
        ),
        Binary { op, lhs, rhs, span: _ } => doc::group(
            doc::concat(
                Vec::from_array(
                    [
                        pretty_expr_doc(lhs),
                        doc::text(" " + pretty_binary_symbol(op)),
                        doc::nest(2, doc::append(doc::line(), pretty_expr_doc(rhs))),
                    ],
                ),
            ),
        ),
        Proj { tuple: expr, index, span: _ } => {
            doc::append(pretty_expr_doc(expr), doc::text(f".{index}"))
        },
        Field { expr, field_name: field, method_type_args, span: _ } => {
            let base = doc::append(pretty_expr_doc(expr), doc::text("." + field));
            if method_type_args.is_empty() {
                base
            } else {
                doc::concat(
                    Vec::from_array(
                        [
                            base,
                            doc::text("::"),
                            doc::delimited("[", ",", "]", pretty_type_docs(method_type_args)),
                        ],
                    ),
                )
            }
        },
        Index { base, index, span: _ } => doc::concat(
            Vec::from_array(
                [pretty_expr_doc(base), doc::text("["), pretty_expr_doc(index), doc::text("]")],
            ),
        ),
        Block { block, span: _ } => pretty_block_doc(block),
    }
}

fn pretty_pat_is_or(value: Pat) -> bool {
    match value {
        Or { pats: _, span: _ } => true,
        _ => false,
    }
}

fn pretty_pat_doc(value: Pat) -> doc::Doc {
    match value {
        Var { name, is_mut, span: _ } => {
            doc::text(
                if is_mut {
                    "mut " + name
                } else {
                    name
                },
            )
        },
        Unit { span: _ } => doc::text("()"),
        Bool { value, span: _ } => doc::text(
            if value {
                "true"
            } else {
                "false"
            },
        ),
        Int { value, span: _ } => doc::text(value),
        Float { value, span: _ } => doc::text(value),
        String { value, span: _ } => pretty_quoted_string_doc(value),
        Char { value, span: _ } => doc::text("'" + value + "'"),
        Byte { value, span: _ } => pretty_byte_literal_doc(value),
        Constr { constructor: path, args, span: _ } => {
            if args.is_empty() {
                pretty_path_doc(path)
            } else {
                doc::append(
                    pretty_path_doc(path),
                    doc::delimited("(", ",", ")", pretty_pat_docs(args)),
                )
            }
        },
        Struct { name: path, fields, has_rest, span: _ } => {
            let values: Vec[doc::Doc] = Vec::with_capacity(
                fields.len()
                    + if has_rest {
                        1
                    } else {
                        0
                    },
            );
            for field in fields {
                values.push(
                    doc::concat(
                        Vec::from_array([doc::text(field.0 + ": "), pretty_pat_doc(field.1)]),
                    ),
                )
            }
            if has_rest {
                values.push(doc::text(".."))
            }
            pretty_record_doc(pretty_path_doc(path), values)
        },
        Tuple { items: values, span: _ } => {
            doc::delimited("(", ",", ")", pretty_pat_docs(values))
        },
        Array { prefix, rest, suffix, span: _ } => {
            let values: Vec[doc::Doc] = Vec::with_capacity(
                prefix.len() + suffix.len()
                    + if rest.is_some() {
                        1
                    } else {
                        0
                    },
            );
            for value in prefix {
                values.push(pretty_pat_doc(value))
            }
            if let Some(value) = rest {
                values.push(
                    match value.binding {
                        Some(name) => doc::text(name + " @ .."),
                        None => doc::text(".."),
                    },
                )
            }
            for value in suffix {
                values.push(pretty_pat_doc(value))
            }
            doc::delimited("[", ",", "]", values)
        },
        Alias { name, pat, span: _ } => doc::concat(
            Vec::from_array(
                [
                    doc::text(name + " @ "),
                    if pretty_pat_is_or(pat) {
                        doc::delimited("(", ",", ")", Vec::from_array([pretty_pat_doc(pat)]))
                    } else {
                        pretty_pat_doc(pat)
                    },
                ],
            ),
        ),
        Or { pats: values, span: _ } => doc::group(
            doc::join(doc::append(doc::text(" |"), doc::line()), pretty_pat_docs(values)),
        ),
        Range { start, end, inclusive, span: _ } => doc::concat(
            Vec::from_array(
                [
                    pretty_pat_doc(start),
                    doc::text(
                        if inclusive {
                            "..="
                        } else {
                            ".."
                        },
                    ),
                    pretty_pat_doc(end),
                ],
            ),
        ),
        Wild { span: _ } => doc::text("_"),
    }
}
