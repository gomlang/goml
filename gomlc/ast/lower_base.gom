package ast;

use module::cst;
use module::lexer;

struct LowerCtx {
    diagnostics: Vec[cst::Diagnostic],
    invalid_self_type_spans: Vec[Span],
    expr_depth: Ref[isize],
    pattern_depth: Ref[isize],
    type_depth: Ref[isize],
}

fn push_error(ctx: LowerCtx, value_span: Span, message: string) -> () {
    ctx.diagnostics.push(cst::diagnostic(message, value_span.start, value_span.end))
}

fn ident_starts_upper(value: string) -> bool {
    value.byte_len() > 0 && value.byte_get(0) >= b'A' && value.byte_get(0) <= b'Z'
}

fn lower_path(ctx: LowerCtx, node: LocatedNode) -> Option[Path] {
    let segments: Vec[PathSegment] = Vec::new();
    for token in tokens_of_kind(node, lexer::TokenKind::Ident) {
        segments.push(PathSegment { ident: token.token.text, span: token_span(token) })
    }
    if segments.is_empty() {
        push_error(ctx, node_span(node), "Paths must contain at least one identifier");
        Option::None
    } else {
        Option::Some(Path { segments })
    }
}

fn path_last(path: Path) -> Option[string] {
    if path.segments.is_empty() {
        Option::None
    } else {
        Option::Some(path.segments[path.segments.len() - 1].ident)
    }
}

fn take_attribute_path(segments: Vec[string]) -> Option[AttributeArg] {
    let result = if segments.is_empty() {
        Option::None
    } else if segments.len() == 1 {
        Option::Some(AttributeArg::Ident(segments[0]))
    } else {
        let mut value = segments[0];
        for index in 1..segments.len() {
            value = value + "::" + segments[index];
        }
        Option::Some(AttributeArg::Path(value))
    };
    segments.clear();
    result
}

fn attribute_arg_kind(value: AttributeArg) -> string {
    match value {
        Ident(_) => "ident",
        Path(_) => "path",
        String(_) => "string",
        Named { .. } => "named",
    }
}

fn attribute_arg_text(value: AttributeArg) -> string {
    match value {
        Ident(value) | Path(value) | String(value) => value,
        Named { name: _, value_kind: _, value } => value,
    }
}

fn push_attribute_arg(args: Vec[AttributeArg], value: Option[AttributeArg], named: Option[string]) -> Option[
    string,
] {
    match value {
        Some(value) => {
            match named {
                Some(name) => args.push(
                    AttributeArg::Named {
                        name,
                        value_kind: attribute_arg_kind(value),
                        value: attribute_arg_text(value),
                    },
                ),
                None => args.push(value),
            }
            Option::None
        },
        None => named,
    }
}

fn lower_attributes(node: LocatedNode) -> Vec[Attribute] {
    let attrs: Vec[Attribute] = Vec::new();
    if let Some(list) = first_child(node, cst::NodeKind::ATTRIBUTE_LIST) {
        for attr in children_of_kind(list, cst::NodeKind::ATTRIBUTE) {
            let mut name = "";
            let args: Vec[AttributeArg] = Vec::new();
            let path_segments: Vec[string] = Vec::new();
            let mut in_args = false;
            let mut has_argument_list = false;
            let mut named_arg: Option[string] = Option::None;
            for token in direct_tokens(attr) {
                match token.token.kind {
                    lexer::TokenKind::LParen => {
                        in_args = true;
                        has_argument_list = true;
                    },
                    lexer::TokenKind::RParen => {
                        named_arg = push_attribute_arg(
                            args,
                            take_attribute_path(path_segments),
                            named_arg,
                        );
                        in_args = false;
                    },
                    lexer::TokenKind::Ident => if in_args {
                        path_segments.push(token.token.text)
                    } else {
                        name = token.token.text;
                    },
                    lexer::TokenKind::TrueKeyword | lexer::TokenKind::FalseKeyword => if in_args {
                        named_arg = push_attribute_arg(
                            args,
                            take_attribute_path(path_segments),
                            named_arg,
                        );
                        named_arg = push_attribute_arg(
                            args,
                            Option::Some(AttributeArg::Ident(token.token.text)),
                            named_arg,
                        );
                    },
                    lexer::TokenKind::Str => if in_args {
                        named_arg = push_attribute_arg(
                            args,
                            take_attribute_path(path_segments),
                            named_arg,
                        );
                        if let Some(value) = strip_delimiters(token.token.text) {
                            named_arg = push_attribute_arg(
                                args,
                                Option::Some(AttributeArg::String(unescape_string(value))),
                                named_arg,
                            );
                        }
                    },
                    lexer::TokenKind::Comma => if in_args {
                        named_arg = push_attribute_arg(
                            args,
                            take_attribute_path(path_segments),
                            named_arg,
                        );
                    },
                    lexer::TokenKind::Eq => if in_args {
                        if let Some(value) = take_attribute_path(path_segments) {
                            named_arg = Option::Some(attribute_arg_text(value));
                        }
                    },
                    _ => (),
                }
            }
            attrs.push(
                Attribute {
                    span: node_span(attr),
                    text: node_text(attr),
                    name,
                    has_argument_list,
                    args,
                },
            )
        }
    }
    attrs
}

fn lower_visibility(node: LocatedNode) -> Visibility {
    if has_token(node, lexer::TokenKind::PubKeyword) {
        Visibility::Public
    } else {
        Visibility::Private
    }
}

fn attribute_matches(value: Attribute, expected: string) -> bool {
    value.name == expected
}

fn find_attribute(attrs: Vec[Attribute], expected: string) -> Option[Attribute] {
    for attr in attrs {
        if attribute_matches(attr, expected) {
            return Option::Some(attr)
        }
    }
    Option::None
}

fn lower_type_list(ctx: LowerCtx, node: LocatedNode) -> Vec[TypeExpr] {
    let result: Vec[TypeExpr] = Vec::new();
    for child in type_children(node) {
        if let Some(value) = lower_ty(ctx, child) {
            result.push(value)
        }
    }
    result
}

fn normalized_array_length(value: string) -> Option[string] {
    let mut index = 0;
    while index + 1 < value.byte_len() && value.byte_get(index) == b'0' {
        index += 1;
    }
    let normalized = value.byte_slice(index, value.byte_len());
    let maximum = "9223372036854775807";
    if normalized.byte_len() < maximum.byte_len() {
        Option::Some(normalized)
    } else if normalized.byte_len() > maximum.byte_len() {
        Option::None
    } else {
        for cursor in 0..normalized.byte_len() {
            let left = normalized.byte_get(cursor);
            let right = maximum.byte_get(cursor);
            if left < right {
                return Option::Some(normalized)
            } else if left > right {
                return Option::None
            }
        }
        Option::Some(normalized)
    }
}

fn lower_ty(ctx: LowerCtx, node: LocatedNode) -> Option[TypeExpr] {
    if ctx.type_depth.get() >= 256 {
        push_error(ctx, node_span(node), "type is too deeply nested");
        Option::None
    } else {
        ctx.type_depth.set(ctx.type_depth.get() + 1);
        let result = match node_kind(node) {
            TYPE_BOOL => Option::Some(TypeExpr::Bool),
            TYPE_INT => Option::Some(TypeExpr::Int),
            TYPE_INT8 => Option::Some(TypeExpr::Int8),
            TYPE_INT16 => Option::Some(TypeExpr::Int16),
            TYPE_INT32 => Option::Some(TypeExpr::Int32),
            TYPE_INT64 => Option::Some(TypeExpr::Int64),
            TYPE_UINT => Option::Some(TypeExpr::Uint),
            TYPE_UINT8 => Option::Some(TypeExpr::Uint8),
            TYPE_UINT16 => Option::Some(TypeExpr::Uint16),
            TYPE_UINT32 => Option::Some(TypeExpr::Uint32),
            TYPE_UINT64 => Option::Some(TypeExpr::Uint64),
            TYPE_FLOAT32 => Option::Some(TypeExpr::Float32),
            TYPE_FLOAT64 => Option::Some(TypeExpr::Float64),
            TYPE_STRING => Option::Some(TypeExpr::String),
            TYPE_CHAR => Option::Some(TypeExpr::Char),
            TYPE_TUPLE => match first_child(node, cst::NodeKind::TYPE_LIST) {
                Some(list) => {
                    let types = lower_type_list(ctx, list);
                    if types.is_empty() {
                        Option::Some(TypeExpr::Unit)
                    } else if types.len() == 1 {
                        Option::Some(types[0])
                    } else {
                        Option::Some(TypeExpr::Tuple { items: types })
                    }
                },
                None => Option::None,
            },
            TYPE_TAPP => match first_child(node, cst::NodeKind::PATH) {
                Some(path_node) => match lower_path(ctx, path_node) {
                    Some(path) => {
                        if let Some(name) = path_last(path) {
                            if !ident_starts_upper(name) && name != "byte"
                                && !lexer::is_simd_type_name(name) {
                                push_error(
                                    ctx,
                                    node_span(node),
                                    "type, trait, and generic names must start with an uppercase letter",
                                )
                            }
                        }
                        let args = match first_child(node, cst::NodeKind::TYPE_PARAM_LIST) {
                            Some(list) => lower_type_list(ctx, list),
                            None => Vec::new(),
                        };
                        let base = TypeExpr::Con { path };
                        if args.is_empty() {
                            Option::Some(base)
                        } else {
                            Option::Some(TypeExpr::App { ty: base, args })
                        }
                    },
                    None => Option::None,
                },
                None => Option::None,
            },
            TYPE_DYN => {
                let bounds: Vec[DynTraitBound] = Vec::new();
                for bound in children_of_kind(node, cst::NodeKind::DYN_BOUND) {
                    if let Some(path_node) = first_child(bound, cst::NodeKind::PATH) {
                        if let Some(trait_path) = lower_path(ctx, path_node) {
                            let args: Vec[TypeExpr] = Vec::new();
                            let associated_types: Vec[(string, TypeExpr)] = Vec::new();
                            if let Some(list) = first_child(bound, cst::NodeKind::DYN_ARG_LIST) {
                                for ty_node in type_children(list) {
                                    if let Some(ty) = lower_ty(ctx, ty_node) {
                                        args.push(ty)
                                    }
                                }
                                for binding in children_of_kind(
                                    list,
                                    cst::NodeKind::DYN_ASSOC_BINDING,
                                ) {
                                    if let Some(name) = first_token(
                                        binding,
                                        lexer::TokenKind::Ident,
                                    ) {
                                        let types = type_children(binding);
                                        if !types.is_empty() {
                                            if let Some(ty) = lower_ty(ctx, types[0]) {
                                                associated_types.push((name.token.text, ty))
                                            }
                                        }
                                    }
                                }
                            }
                            bounds.push(DynTraitBound { trait_path, args, associated_types })
                        }
                    }
                }
                Option::Some(TypeExpr::Dyn { bounds })
            },
            TYPE_ARRAY => {
                let types = type_children(node);
                match first_token(node, lexer::TokenKind::IntLit) {
                    Some(length_token) => match normalized_array_length(
                        strip_suffix(length_token.token.text, ""),
                    ) {
                        Some(length) => if !types.is_empty() {
                            lower_ty(ctx, types[0]).map(
                                |element| TypeExpr::Array { len: length, elem: element },
                            )
                        } else {
                            push_error(ctx, node_span(node), "Array type missing element type");
                            Option::None
                        },
                        None => {
                            push_error(
                                ctx,
                                token_span(length_token),
                                "Invalid array length: " + length_token.token.text,
                            );
                            Option::None
                        },
                    },
                    None => {
                        push_error(ctx, node_span(node), "Array type missing length");
                        Option::None
                    },
                }
            },
            TYPE_FUNC => {
                let types = type_children(node);
                if types.len() < 2 {
                    push_error(ctx, node_span(node), "Function type missing return type");
                    Option::None
                } else {
                    match lower_ty(ctx, types[1]) {
                        Some(ret_ty) => {
                            let param_node = types[0];
                            let params = if cst::node_kind_equal(
                                node_kind(param_node),
                                cst::NodeKind::TYPE_TUPLE,
                            ) {
                                match first_child(param_node, cst::NodeKind::TYPE_LIST) {
                                    Some(list) => lower_type_list(ctx, list),
                                    None => Vec::new(),
                                }
                            } else {
                                let values: Vec[TypeExpr] = Vec::new();
                                if let Some(value) = lower_ty(ctx, param_node) {
                                    values.push(value)
                                }
                                values
                            };
                            Option::Some(TypeExpr::Func { params, ret_ty })
                        },
                        None => Option::None,
                    }
                }
            },
            _ => Option::None,
        };
        ctx.type_depth.set(ctx.type_depth.get() - 1);
        result
    }
}

fn lower_trait_ref(ctx: LowerCtx, node: LocatedNode) -> Option[TraitRef] {
    if !cst::node_kind_equal(node_kind(node), cst::NodeKind::TYPE_TAPP) {
        push_error(ctx, node_span(node), "Expected a trait name with optional type arguments");
        Option::None
    } else {
        match first_child(node, cst::NodeKind::PATH) {
            Some(path_node) => match lower_path(ctx, path_node) {
                Some(path) => {
                    let args = match first_child(node, cst::NodeKind::TYPE_PARAM_LIST) {
                        Some(list) => lower_type_list(ctx, list),
                        None => Vec::new(),
                    };
                    Option::Some(TraitRef { path, args })
                },
                None => Option::None,
            },
            None => Option::None,
        }
    }
}

fn lower_trait_set(ctx: LowerCtx, node: LocatedNode) -> Vec[TraitRef] {
    let result: Vec[TraitRef] = Vec::new();
    for child in type_children(node) {
        if let Some(value) = lower_trait_ref(ctx, child) {
            result.push(value)
        }
    }
    result
}

fn lower_generics(ctx: LowerCtx, node: LocatedNode) -> (Vec[string], Vec[(string, Vec[TraitRef])]) {
    let generics: Vec[string] = Vec::new();
    let bounds: Vec[(string, Vec[TraitRef])] = Vec::new();
    if let Some(list) = first_child(node, cst::NodeKind::GENERIC_LIST) {
        for generic in children_of_kind(list, cst::NodeKind::GENERIC) {
            if let Some(token) = first_token(generic, lexer::TokenKind::Ident) {
                let name = token.token.text;
                generics.push(name);
                if let Some(set) = first_child(generic, cst::NodeKind::TRAIT_SET) {
                    bounds.push((name, lower_trait_set(ctx, set)))
                }
            }
        }
    };
    (generics, bounds)
}

fn lower_where_clause(ctx: LowerCtx, node: LocatedNode) -> Vec[Predicate] {
    let result: Vec[Predicate] = Vec::new();
    if let Some(clause) = first_child(node, cst::NodeKind::WHERE_CLAUSE) {
        for predicate in children_of_kind(clause, cst::NodeKind::WHERE_PREDICATE) {
            let types = type_children(predicate);
            if types.is_empty() {
                push_error(ctx, node_span(predicate), "Where predicate is missing a type")
            } else {
                if let Some(lhs) = lower_ty(ctx, types[0]) {
                    match first_child(predicate, cst::NodeKind::TRAIT_SET) {
                        Some(set) => for trait_ref in lower_trait_set(ctx, set) {
                            result.push(Predicate::Trait { ty: lhs, trait_ref })
                        },
                        None => if types.len() > 1 {
                            if let Some(rhs) = lower_ty(ctx, types[1]) {
                                result.push(Predicate::Equality { lhs, rhs })
                            }
                        } else {
                            push_error(
                                ctx,
                                node_span(predicate),
                                "Equality predicate is missing its right-hand type",
                            )
                        },
                    }
                }
            }
        }
    }
    result
}

fn lower_use(ctx: LowerCtx, node: LocatedNode) -> Option[UseDecl] {
    match first_child(node, cst::NodeKind::PATH) {
        Some(path_node) => match lower_path(ctx, path_node) {
            Some(path) => {
                let alias = if has_token(node, lexer::TokenKind::AsKeyword) {
                    first_token(node, lexer::TokenKind::Ident).map(|token| token.token.text)
                } else {
                    Option::None
                };
                let items: Vec[UseItem] = Vec::new();
                if let Some(list) = first_child(node, cst::NodeKind::USE_ITEM_LIST) {
                    for item in children_of_kind(list, cst::NodeKind::USE_ITEM) {
                        let names = tokens_of_kind(item, lexer::TokenKind::Ident);
                        if !names.is_empty() {
                            items.push(
                                UseItem {
                                    name: names[0].token.text,
                                    alias: if names.len() > 1 {
                                        Option::Some(names[1].token.text)
                                    } else {
                                        Option::None
                                    },
                                    span: token_span(names[0]),
                                },
                            )
                        }
                    }
                }
                Option::Some(UseDecl { visibility: lower_visibility(node), path, alias, items })
            },
            None => Option::None,
        },
        None => {
            push_error(ctx, node_span(node), "use declaration missing path");
            Option::None
        },
    }
}

fn lower_result(result: cst::ParseResult) -> LowerResult {
    let diagnostics = result.diagnostics;
    if !diagnostics.is_empty() {
        LowerResult { ast: Option::None, diagnostics }
    } else {
        let root = root_node(result);
        let ctx = LowerCtx {
            diagnostics,
            invalid_self_type_spans: Vec::new(),
            expr_depth: Ref::new(0),
            pattern_depth: Ref::new(0),
            type_depth: Ref::new(0),
        };
        validate_go_export_placement(ctx, root);
        let package_node = first_child(root, cst::NodeKind::PACKAGE);
        let package_explicit = !option_node_is_none(package_node);
        let package_name = match package_node {
            Some(node) => match first_token(node, lexer::TokenKind::Ident) {
                Some(token) => token.token.text,
                None => "main",
            },
            None => "main",
        };
        let uses: Vec[UseDecl] = Vec::new();
        for use_node in children_of_kind(root, cst::NodeKind::USE) {
            if let Some(value) = lower_use(ctx, use_node) {
                uses.push(value)
            }
        }
        let items: Vec[Item] = Vec::new();
        for item_node in item_children(root) {
            if let Some(value) = lower_item(ctx, item_node) {
                items.push(value)
            }
        }
        let ast = if ctx.diagnostics.is_empty() {
            Option::Some(
                File {
                    package_name,
                    package_explicit,
                    uses,
                    items,
                    invalid_self_type_spans: ctx.invalid_self_type_spans,
                },
            )
        } else {
            Option::None
        };
        LowerResult { ast, diagnostics: ctx.diagnostics }
    }
}

pub fn lower(result: cst::ParseResult) -> LowerResult {
    lower_result(result)
}

pub fn lower_package(results: Vec[cst::ParseResult]) -> Vec[LowerResult] {
    let lowered: Vec[LowerResult] = Vec::new();
    for result in results {
        lowered.push(lower_result(result))
    }
    lowered
}
