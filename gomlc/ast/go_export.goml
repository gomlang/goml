package ast;

use module::cst;

fn validate_go_export_placement(ctx: LowerCtx, root: LocatedNode) -> () {
    let pending: Vec[(LocatedNode, bool)] = Vec::new();
    for node in direct_nodes(root) {
        pending.push((node, true))
    }
    let mut index = 0;
    while index < pending.len() {
        let (node, top_level) = pending[index];
        index += 1;
        for attribute in lower_attributes(node) {
            if attribute.name == "go_interface_bridge" {
                push_error(
                    ctx,
                    attribute.span,
                    "go_interface_bridge is compiler-generated and cannot be declared in source",
                );
            }
        }
        if !top_level || !cst::node_kind_equal(node_kind(node), cst::NodeKind::FN) {
            for attribute in lower_attributes(node) {
                if attribute.name == "go_export" {
                    push_error(
                        ctx,
                        attribute.span,
                        "go_export is only valid on a top-level ordinary function",
                    )
                }
            }
        }
        if !top_level || !cst::node_kind_equal(node_kind(node), cst::NodeKind::EXTERN_TYPE) {
            for attribute in lower_attributes(node) {
                if attribute.name == "go_type" {
                    push_error(
                        ctx,
                        attribute.span,
                        "go_type is only valid on a top-level external type",
                    )
                }
            }
        }
        if !top_level || !cst::node_kind_equal(node_kind(node), cst::NodeKind::TRAIT) {
            for attribute in lower_attributes(node) {
                if attribute.name == "go_interface" {
                    push_error(
                        ctx,
                        attribute.span,
                        "go_interface is only valid on a top-level trait",
                    )
                }
            }
        }
        for child in direct_nodes(node) {
            pending.push((child, false))
        }
    }
}
