package ast;

use module::cst;
use module::lexer;
use std::text;

struct LocatedNode {
    node: cst::CstNode,
    start: isize,
}

struct LocatedToken {
    token: lexer::Token,
    start: isize,
}

fn root_node(result: cst::ParseResult) -> LocatedNode {
    LocatedNode { node: result.root, start: 0 }
}

fn node_kind(value: LocatedNode) -> cst::NodeKind {
    cst::node_kind(value.node)
}

fn node_span(value: LocatedNode) -> Span {
    span(value.start, value.start + cst::node_byte_len(value.node))
}

fn trimmed_node_end(value: LocatedNode) -> isize {
    let mut cursor = value.start;
    let mut end = value.start;
    for element in cst::node_children(value.node) {
        match element {
            Node(child) => {
                let child_end = trimmed_node_end(LocatedNode { node: child, start: cursor });
                if child_end > end {
                    end = child_end;
                }
            },
            Token(token) => if lexer::token_is_trivia(token.kind) {} else {
                end = cursor + token.text.byte_len();
            },
        }
        cursor = cursor + cst::element_byte_len(element);
    }
    end
}

fn trimmed_node_span(value: LocatedNode) -> Span {
    span(value.start, trimmed_node_end(value))
}

fn first_significant_token_span(value: LocatedNode) -> Option[Span] {
    let mut cursor = value.start;
    for element in cst::node_children(value.node) {
        match element {
            Node(child) => {
                if let Some(value) = first_significant_token_span(
                    LocatedNode { node: child, start: cursor },
                ) {
                    return Option::Some(value)
                }
            },
            Token(token) => if lexer::token_is_trivia(token.kind) {} else {
                return Option::Some(span(cursor, cursor + token.text.byte_len()))
            },
        }
        cursor = cursor + cst::element_byte_len(element);
    }
    Option::None
}

fn type_head_span(value: LocatedNode) -> Span {
    first_significant_token_span(value).unwrap_or_else(|| trimmed_node_span(value))
}

fn direct_nodes(value: LocatedNode) -> Vec[LocatedNode] {
    let result: Vec[LocatedNode] = Vec::new();
    let mut cursor = value.start;
    for element in cst::node_children(value.node) {
        match element {
            Node(child) => result.push(LocatedNode { node: child, start: cursor }),
            Token(_) => (),
        }
        cursor = cursor + cst::element_byte_len(element);
    }
    result
}

fn direct_tokens(value: LocatedNode) -> Vec[LocatedToken] {
    let result: Vec[LocatedToken] = Vec::new();
    let mut cursor = value.start;
    for element in cst::node_children(value.node) {
        match element {
            Node(_) => (),
            Token(token) => result.push(LocatedToken { token, start: cursor }),
        }
        cursor = cursor + cst::element_byte_len(element);
    }
    result
}

fn children_of_kind(value: LocatedNode, kind: cst::NodeKind) -> Vec[LocatedNode] {
    let result: Vec[LocatedNode] = Vec::new();
    let mut cursor = value.start;
    for element in cst::node_children(value.node) {
        match element {
            Node(child) => if cst::node_kind_equal(cst::node_kind(child), kind) {
                result.push(LocatedNode { node: child, start: cursor })
            },
            Token(_) => (),
        }
        cursor = cursor + cst::element_byte_len(element);
    }
    result
}

fn first_child(value: LocatedNode, kind: cst::NodeKind) -> Option[LocatedNode] {
    let mut cursor = value.start;
    for element in cst::node_children(value.node) {
        match element {
            Node(child) => if cst::node_kind_equal(cst::node_kind(child), kind) {
                return Option::Some(LocatedNode { node: child, start: cursor })
            },
            Token(_) => (),
        }
        cursor = cursor + cst::element_byte_len(element);
    }
    Option::None
}

fn tokens_of_kind(value: LocatedNode, kind: lexer::TokenKind) -> Vec[LocatedToken] {
    let result: Vec[LocatedToken] = Vec::new();
    let mut cursor = value.start;
    for element in cst::node_children(value.node) {
        match element {
            Node(_) => (),
            Token(token) => if lexer::token_kind_equal(token.kind, kind) {
                result.push(LocatedToken { token, start: cursor })
            },
        }
        cursor = cursor + cst::element_byte_len(element);
    }
    result
}

fn first_token(value: LocatedNode, kind: lexer::TokenKind) -> Option[LocatedToken] {
    let mut cursor = value.start;
    for element in cst::node_children(value.node) {
        match element {
            Node(_) => (),
            Token(token) => if lexer::token_kind_equal(token.kind, kind) {
                return Option::Some(LocatedToken { token, start: cursor })
            },
        }
        cursor = cursor + cst::element_byte_len(element);
    }
    Option::None
}

fn has_token(value: LocatedNode, kind: lexer::TokenKind) -> bool {
    first_token(value, kind).is_some()
}

fn token_span(value: LocatedToken) -> Span {
    span(value.start, value.start + value.token.text.byte_len())
}

fn write_node_text(value: LocatedNode, builder: text::StringBuilder) -> () {
    let mut cursor = value.start;
    for element in cst::node_children(value.node) {
        match element {
            Node(child) => write_node_text(LocatedNode { node: child, start: cursor }, builder),
            Token(token) => builder.write_string(token.text),
        }
        cursor = cursor + cst::element_byte_len(element);
    }
}

fn node_text(value: LocatedNode) -> string {
    let builder = text::StringBuilder::with_capacity(cst::node_byte_len(value.node));
    write_node_text(value, builder);
    builder.finish()
}

fn is_item_kind(kind: cst::NodeKind) -> bool {
    match kind {
        ENUM | STRUCT | TRAIT | IMPL | FN | EXTERN | EXTERN_TYPE | TYPE_ALIAS | CONST | STATIC => true,
        _ => false,
    }
}

fn is_stmt_kind(kind: cst::NodeKind) -> bool {
    match kind {
        STMT_LET | STMT_ASSIGN | STMT_EXPR | STMT_DEFER => true,
        _ => false,
    }
}

fn is_expr_kind(kind: cst::NodeKind) -> bool {
    match kind {
        EXPR_IDENT | EXPR_PAREN | EXPR_BINARY | EXPR_RANGE | EXPR_PREFIX | EXPR_CAST | EXPR_IF | EXPR_WHILE | EXPR_LOOP | EXPR_FOR | EXPR_BREAK | EXPR_CONTINUE | EXPR_MATCH | EXPR_SELECT | EXPR_GO | EXPR_SCOPE | EXPR_COMPTIME | EXPR_SPAWN | EXPR_RETURN | EXPR_UNIT | EXPR_BOOL | EXPR_INT | EXPR_FLOAT | EXPR_CHAR | EXPR_BYTE | EXPR_BYTE_STRING | EXPR_STR | EXPR_RAW_STR | EXPR_MULTILINE_STR | EXPR_INTERPOLATED_STRING | EXPR_ARRAY_LITERAL | EXPR_TUPLE | EXPR_CALL | EXPR_INDEX | EXPR_TRY | EXPR_STRUCT_LITERAL | EXPR_BLOCK | EXPR_CLOSURE => true,
        _ => false,
    }
}

fn is_pattern_kind(kind: cst::NodeKind) -> bool {
    match kind {
        PATTERN_UNIT | PATTERN_BOOL | PATTERN_STRING | PATTERN_INT | PATTERN_FLOAT | PATTERN_CHAR | PATTERN_BYTE | PATTERN_TUPLE | PATTERN_ARRAY | PATTERN_CONSTR | PATTERN_VARIABLE | PATTERN_WILDCARD | PATTERN_ALIAS | PATTERN_OR | PATTERN_RANGE | PATTERN_REST => true,
        _ => false,
    }
}

fn is_type_kind(kind: cst::NodeKind) -> bool {
    match kind {
        TYPE_BOOL | TYPE_INT | TYPE_INT8 | TYPE_INT16 | TYPE_INT32 | TYPE_INT64 | TYPE_UINT | TYPE_UINT8 | TYPE_UINT16 | TYPE_UINT32 | TYPE_UINT64 | TYPE_FLOAT32 | TYPE_FLOAT64 | TYPE_STRING | TYPE_CHAR | TYPE_TUPLE | TYPE_TAPP | TYPE_DYN | TYPE_ARRAY | TYPE_FUNC => true,
        _ => false,
    }
}

fn filtered_children(value: LocatedNode, selector: (cst::NodeKind) -> bool) -> Vec[LocatedNode] {
    let result: Vec[LocatedNode] = Vec::new();
    let mut cursor = value.start;
    for element in cst::node_children(value.node) {
        match element {
            Node(child) => if selector(cst::node_kind(child)) {
                result.push(LocatedNode { node: child, start: cursor })
            },
            Token(_) => (),
        }
        cursor = cursor + cst::element_byte_len(element);
    }
    result
}

fn expr_children(value: LocatedNode) -> Vec[LocatedNode] {
    filtered_children(value, is_expr_kind)
}

fn pattern_children(value: LocatedNode) -> Vec[LocatedNode] {
    filtered_children(value, is_pattern_kind)
}

fn type_children(value: LocatedNode) -> Vec[LocatedNode] {
    filtered_children(value, is_type_kind)
}

fn item_children(value: LocatedNode) -> Vec[LocatedNode] {
    filtered_children(value, is_item_kind)
}

fn stmt_children(value: LocatedNode) -> Vec[LocatedNode] {
    filtered_children(value, is_stmt_kind)
}

fn option_node_is_none(value: Option[LocatedNode]) -> bool {
    value.is_none()
}
