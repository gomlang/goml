package ast;

use module::parser;
use std::testing;

#[test]
fn go_interface_bridge_rejects_user_authored_helpers() -> () {
    let value = lower(
        parser::parse("#[go_interface_bridge(\"Read\")] extern fn bridge(method: () -> ()) -> ();"),
    );
    testing::assert(
        has_diagnostic(
            value.diagnostics,
            "go_interface_bridge is compiler-generated and cannot be declared in source",
        ),
    );
}

#[test]
fn go_interface_rejects_non_trait_and_nested_attachments() -> () {
    for source in Vec::from_array(
        [
            "#[go_interface(Raw, Wrapped)] fn value() -> () {}",
            "#[go_interface(Raw, Wrapped)] struct Value {}",
            "#[go_interface(Raw, Wrapped)] extern type Raw;",
            "struct Value { #[go_interface(Raw, Wrapped)] value: i64 }",
        ],
    ) {
        testing::assert(
            has_diagnostic(
                lower(parser::parse(source)).diagnostics,
                "go_interface is only valid on a top-level trait",
            ),
        );
    }
    for source in Vec::from_array(
        [
            "trait Value { #[go_interface(Raw, Wrapped)] fn value(self: Self) -> (); }",
            "struct Value {} impl Value { #[go_interface(Raw, Wrapped)] fn value(self: Value) -> () {} }",
        ],
    ) {
        testing::assert(!parser::parse(source).diagnostics.is_empty());
    }
}

fn parsed_interface_spec(source: string) -> Result[Option[GoInterfaceSpec], string] {
    let lowered = lower(parser::parse(source));
    if !lowered.diagnostics.is_empty() {
        return Result::Err("invalid fixture syntax")
    }
    let Some(file) = lowered.ast else {
        return Result::Err("missing fixture AST")
    };
    for item in file.items {
        if let TraitDef(definition) = item {
            return go_interface_spec(definition.attrs)
        }
    }
    Result::Err("missing fixture trait")
}

#[test]
fn go_interface_spec_preserves_explicit_names_and_mappings() -> () {
    let Ok(Some(spec)) = parsed_interface_spec(
        "#[go_interface(raw::Reader, ReaderAdapter, read = \"Read\")] pub trait Reader { fn read(self: Self) -> (); }",
    ) else {
        testing::fail("expected interface adapter specification");
        return
    };
    testing::assert_eq(spec.raw_type, "raw::Reader");
    testing::assert_eq(spec.wrapper_name, "ReaderAdapter");
    testing::assert_eq(spec.methods.len(), 1);
    testing::assert_eq(spec.methods[0].0, "read");
    testing::assert_eq(spec.methods[0].1, "Read");
    testing::assert(spec.span.end > spec.span.start);
    testing::assert(
        parsed_interface_spec("trait Reader {}").unwrap_or(Option::Some(spec)).is_none(),
    );
}

#[test]
fn go_interface_spec_rejects_duplicate_ambiguous_and_invalid_mappings() -> () {
    for attributes in Vec::from_array(
        [
            "#[go_interface]",
            "#[go_interface(Raw)]",
            "#[go_interface(\"Raw\", Wrapped)]",
            "#[go_interface(Raw, module::Wrapped)]",
            "#[go_interface(Raw, Raw)]",
            "#[go_interface(Raw, Wrapped, read = Read)]",
            "#[go_interface(Raw, Wrapped, read = \"read\")]",
            "#[go_interface(Raw, Wrapped, read = \"Read\", read = \"Write\")]",
            "#[go_interface(Raw, Wrapped, read = \"Read\", write = \"Read\")]",
            "#[go_interface(Raw, Wrapped, into_go = \"Read\")]",
            "#[go_interface(Raw, Wrapped)] #[go_interface(Raw, Other)]",
        ],
    ) {
        testing::assert(parsed_interface_spec(attributes + " trait Reader {}").is_err());
    }
}
