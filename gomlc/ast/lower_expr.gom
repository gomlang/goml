package ast;

use module::cst;
use module::lexer;
use module::numeric;
use std::text;

fn lower_block(ctx: LowerCtx, node: LocatedNode) -> Option[Block] {
    let stmts: Vec[Stmt] = Vec::new();
    for stmt in stmt_children(node) {
        if let Some(value) = lower_stmt(ctx, stmt) {
            stmts.push(value)
        }
    }
    let tails = expr_children(node);
    let tail = if !tails.is_empty() {
        lower_expr(ctx, tails[0])
    } else {
        Option::None
    };
    Option::Some(Block { stmts, tail, span: node_span(node) })
}

fn lower_stmt(ctx: LowerCtx, node: LocatedNode) -> Option[Stmt] {
    match node_kind(node) {
        STMT_LET => {
            let patterns = pattern_children(node);
            let values = expr_children(node);
            if patterns.is_empty() {
                push_error(ctx, node_span(node), "Let statement missing pattern");
                Option::None
            } else if values.is_empty() {
                push_error(ctx, node_span(node), "Let statement missing value");
                Option::None
            } else {
                match lower_pat(ctx, patterns[0]) {
                    Some(pat) => match lower_expr(ctx, values[0]) {
                        Some(value) => {
                            let types = type_children(node);
                            let annotation = if !types.is_empty() {
                                lower_ty(ctx, types[0])
                            } else {
                                Option::None
                            };
                            let else_branch = match first_child(node, cst::NodeKind::BLOCK) {
                                Some(block_node) => lower_block(ctx, block_node).map(
                                    |block| Expr::Block { block, span: node_span(block_node) },
                                ),
                                None => Option::None,
                            };
                            Option::Some(
                                Stmt::Let {
                                    is_mut: has_token(node, lexer::TokenKind::MutKeyword),
                                    pat,
                                    annotation,
                                    value,
                                    else_branch,
                                    span: node_span(node),
                                },
                            )
                        },
                        None => Option::None,
                    },
                    None => Option::None,
                }
            }
        },
        STMT_ASSIGN => {
            let values = expr_children(node);
            if values.len() < 1 {
                push_error(ctx, node_span(node), "Assignment statement missing target");
                Option::None
            } else if values.len() < 2 {
                push_error(ctx, node_span(node), "Assignment statement missing value");
                Option::None
            } else {
                match lower_expr(ctx, values[0]) {
                    Some(target) => match lower_expr(ctx, values[1]) {
                        Some(value) => {
                            let mut op = AssignmentOp::Plain;
                            for token in direct_tokens(node) {
                                if let Some(value) = compound_assignment_operator(token.token.kind) {
                                    op = AssignmentOp::Compound(value);
                                }
                            }
                            Option::Some(Stmt::Assign { target, op, value, span: node_span(node) })
                        },
                        None => Option::None,
                    },
                    None => Option::None,
                }
            }
        },
        STMT_EXPR => {
            let values = expr_children(node);
            if values.is_empty() {
                push_error(ctx, node_span(node), "Expression statement missing expression");
                Option::None
            } else {
                lower_expr(ctx, values[0]).map(
                    |value| Stmt::Expr { expr: value, span: node_span(node) },
                )
            }
        },
        STMT_DEFER => {
            let values = expr_children(node);
            if values.is_empty() {
                push_error(ctx, node_span(node), "Defer statement missing expression");
                Option::None
            } else {
                lower_expr(ctx, values[0]).map(
                    |value| Stmt::Defer { expr: value, span: node_span(node) },
                )
            }
        },
        _ => Option::None,
    }
}

fn hex_value(value: u8) -> Option[u32] {
    if value >= 48 && value <= 57 {
        Option::Some(decimal_hex_value(value))
    } else {
        match value {
            65 | 97 => Option::Some(10),
            66 | 98 => Option::Some(11),
            67 | 99 => Option::Some(12),
            68 | 100 => Option::Some(13),
            69 | 101 => Option::Some(14),
            70 | 102 => Option::Some(15),
            _ => Option::None,
        }
    }
}

fn decimal_hex_value(value: u8) -> u32 {
    match value {
        48 => 0,
        49 => 1,
        50 => 2,
        51 => 3,
        52 => 4,
        53 => 5,
        54 => 6,
        55 => 7,
        56 => 8,
        _ => 9,
    }
}

fn unicode_escape_character(value: string, start: isize) -> Option[char] {
    if start + 4 > value.byte_len() {
        return Option::None
    }
    let mut code = 0;
    for cursor in start..start + 4 {
        code = code * 16 + hex_value(value.byte_get(cursor))?;
    }
    char_from_u32(code)
}

fn unescape_string(value: string) -> string {
    let builder = text::StringBuilder::with_capacity(value.byte_len());
    let mut index = 0;
    while index < value.byte_len() {
        let byte = value.byte_get(index);
        if byte != b'\\' {
            let width = if byte < 0x80 {
                1
            } else if byte < 0xe0 {
                2
            } else if byte < 0xf0 {
                3
            } else {
                4
            };
            builder.write_string(value.byte_slice(index, index + width));
            index += width;
        } else if index + 1 >= value.byte_len() {
            builder.write_string("\\");
            index += 1;
        } else {
            let escaped = value.byte_get(index + 1);
            match escaped {
                34 => builder.write_string("\""),
                92 => builder.write_string("\\"),
                110 => builder.write_string("\n"),
                114 => builder.write_string("\r"),
                116 => builder.write_string("\t"),
                98 => builder.write_string("\b"),
                102 => builder.write_string("\f"),
                47 => builder.write_string("/"),
                117 => {
                    if let Some(character) = unicode_escape_character(value, index + 2) {
                        builder.write_string(character.to_string())
                    }
                    index += 4;
                },
                _ => {
                    builder.write_string("\\");
                    builder.write_string(value.byte_slice(index + 1, index + 2))
                },
            }
            index += 2;
        }
    }
    builder.finish()
}

fn collapse_interpolated_braces(value: string) -> string {
    let builder = text::StringBuilder::with_capacity(value.byte_len());
    let mut index = 0;
    while index < value.byte_len() {
        let byte = value.byte_get(index);
        if (byte == b'{' || byte == b'}') && index + 1 < value.byte_len()
            && value.byte_get(index + 1) == byte {
            builder.write_string(value.byte_slice(index, index + 1));
            index += 2;
        } else {
            let width = if byte < 0x80 {
                1
            } else if byte < 0xe0 {
                2
            } else if byte < 0xf0 {
                3
            } else {
                4
            };
            builder.write_string(value.byte_slice(index, index + width));
            index += width;
        }
    }
    builder.finish()
}

fn lower_interpolated_string(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[
    Expr,
] {
    if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to interpolated string") {
        Option::None
    } else {
        let parts: Vec[InterpolatedStringPart] = Vec::new();
        let mut cursor = node.start;
        for element in cst::node_children(node.node) {
            match element {
                Token(token) => {
                    if lexer::token_kind_equal(token.kind, lexer::TokenKind::FStringText) {
                        parts.push(
                            InterpolatedStringPart::Text(
                                unescape_string(collapse_interpolated_braces(token.text)),
                            ),
                        )
                    }
                },
                Node(child) => {
                    let located = LocatedNode { node: child, start: cursor };
                    if cst::node_kind_equal(
                        node_kind(located),
                        cst::NodeKind::INTERPOLATED_STRING_EXPR,
                    ) {
                        let values = expr_children(located);
                        if !values.is_empty() {
                            if let Some(value) = lower_expr(ctx, values[0]) {
                                parts.push(InterpolatedStringPart::Expr(value))
                            }
                        } else {
                            push_error(
                                ctx,
                                node_span(located),
                                "Interpolated string part missing expression",
                            )
                        }
                    }
                },
            }
            cursor = cursor + cst::element_byte_len(element);
        }
        Option::Some(Expr::InterpolatedString { parts, span: node_span(node) })
    }
}

fn lower_multiline_string(ctx: LowerCtx, node: LocatedNode) -> Option[string] {
    match first_token(node, lexer::TokenKind::MultilineStr) {
        Some(token) => {
            let value = token.token.text;
            let builder = text::StringBuilder::with_capacity(value.byte_len());
            let mut line_start = 0;
            while line_start <= value.byte_len() {
                let mut line_end = line_start;
                while line_end < value.byte_len() && value.byte_get(line_end) != b'\n' {
                    line_end += 1;
                }
                let mut marker = line_start;
                while marker < line_end
                    && (value.byte_get(marker) == b' ' || value.byte_get(marker) == b'\t') {
                    marker += 1;
                }
                if marker + 2 > line_end || value.byte_slice(marker, marker + 2) != "\\\\" {
                    push_error(ctx, token_span(token), "Invalid multiline string content");
                    return Option::None
                } else {
                    if line_start > 0 {
                        builder.write_string("\n")
                    }
                    builder.write_string(value.byte_slice(marker + 2, line_end));
                    if line_end >= value.byte_len() {
                        line_start = value.byte_len() + 1;
                    } else {
                        line_start = line_end + 1;
                    }
                }
            }
            Option::Some(builder.finish())
        },
        None => {
            push_error(ctx, node_span(node), "MultilineStrExpr has no value");
            Option::None
        },
    }
}

fn reject_trailing(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr], message: string) -> bool {
    if trailing_args.is_empty() {
        false
    } else {
        push_error(ctx, node_span(node), message);
        true
    }
}

struct LowerIdentParts {
    path: Path,
    owner_type_args: Vec[TypeExpr],
    member_type_args: Vec[TypeExpr],
}

fn lower_type_application_args(ctx: LowerCtx, node: LocatedNode) -> Vec[TypeExpr] {
    match first_child(node, cst::NodeKind::TYPE_PARAM_LIST) {
        Some(list) => lower_type_list(ctx, list),
        None => Vec::new(),
    }
}

fn append_path_segments(base: Path, suffix: Path) -> Path {
    let segments = base.segments;
    for segment in suffix.segments {
        segments.push(segment)
    }
    Path { segments }
}

fn lower_type_application_path(ctx: LowerCtx, node: LocatedNode) -> Option[Path] {
    first_child(node, cst::NodeKind::PATH).and_then(|path_node| lower_path(ctx, path_node))
}

fn lower_ident_parts(ctx: LowerCtx, node: LocatedNode) -> Option[LowerIdentParts] {
    let applications = children_of_kind(node, cst::NodeKind::TYPE_TAPP);
    if applications.is_empty() {
        match first_child(node, cst::NodeKind::PATH) {
            Some(path_node) => lower_path(ctx, path_node).map(
                |path| LowerIdentParts {
                    path,
                    owner_type_args: Vec::new(),
                    member_type_args: Vec::new(),
                },
            ),
            None => {
                push_error(ctx, node_span(node), "Missing identifier in expression");
                Option::None
            },
        }
    } else {
        match lower_type_application_path(ctx, applications[0]) {
            Some(first_path) => {
                let first_args = lower_type_application_args(ctx, applications[0]);
                if applications.len() > 1 {
                    lower_type_application_path(ctx, applications[1]).map(
                        |member_path| LowerIdentParts {
                            path: append_path_segments(first_path, member_path),
                            owner_type_args: first_args,
                            member_type_args: lower_type_application_args(ctx, applications[1]),
                        },
                    )
                } else {
                    let paths = children_of_kind(node, cst::NodeKind::PATH);
                    if !paths.is_empty() {
                        lower_path(ctx, paths[0]).map(
                            |member_path| LowerIdentParts {
                                path: append_path_segments(first_path, member_path),
                                owner_type_args: first_args,
                                member_type_args: Vec::new(),
                            },
                        )
                    } else {
                        Option::Some(
                            LowerIdentParts {
                                path: first_path,
                                owner_type_args: Vec::new(),
                                member_type_args: first_args,
                            },
                        )
                    }
                }
            },
            None => Option::None,
        }
    }
}

fn lower_closure_param(ctx: LowerCtx, node: LocatedNode) -> Option[ClosureParam] {
    let ident = match first_token(node, lexer::TokenKind::Ident) {
        Some(value) => Option::Some(value),
        None => first_token(node, lexer::TokenKind::WildcardKeyword),
    };
    match ident {
        Some(name_token) => {
            let types = type_children(node);
            let ty = if !types.is_empty() {
                lower_ty(ctx, types[0])
            } else {
                Option::None
            };
            Option::Some(ClosureParam { name: name_token.token.text, ty, span: node_span(node) })
        },
        None => {
            push_error(ctx, node_span(node), "Closure parameter missing name");
            Option::None
        },
    }
}

fn lower_closure(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to closure expression") {
        Option::None
    } else {
        let params: Vec[ClosureParam] = Vec::new();
        match first_child(node, cst::NodeKind::CLOSURE_PARAM_LIST) {
            Some(list) => for param in children_of_kind(list, cst::NodeKind::CLOSURE_PARAM) {
                if let Some(value) = lower_closure_param(ctx, param) {
                    params.push(value)
                }
            },
            None => push_error(ctx, node_span(node), "Closure missing parameter list"),
        }
        match first_child(node, cst::NodeKind::EXPR_CLOSURE_BODY) {
            Some(body_node) => match first_child(body_node, cst::NodeKind::BLOCK) {
                Some(block_node) => lower_block(ctx, block_node).map(
                    |block| Expr::Closure {
                        params,
                        body: Expr::Block { block, span: node_span(block_node) },
                        span: node_span(node),
                    },
                ),
                None => {
                    let values = expr_children(body_node);
                    if !values.is_empty() {
                        lower_expr(ctx, values[0]).map(
                            |body| Expr::Closure { params, body, span: node_span(node) },
                        )
                    } else {
                        push_error(ctx, node_span(body_node), "Closure body missing expr");
                        Option::None
                    }
                },
            },
            None => {
                push_error(ctx, node_span(node), "Closure missing body");
                Option::None
            },
        }
    }
}

fn lower_struct_literal(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to struct literal") {
        Option::None
    } else {
        match first_child(node, cst::NodeKind::PATH) {
            Some(path_node) => match lower_path(ctx, path_node) {
                Some(path) => {
                    let fields: Vec[(string, Expr)] = Vec::new();
                    if let Some(list) = first_child(node, cst::NodeKind::STRUCT_LITERAL_FIELD_LIST) {
                        for field in children_of_kind(list, cst::NodeKind::STRUCT_LITERAL_FIELD) {
                            if let Some(name_token) = first_token(field, lexer::TokenKind::Ident) {
                                let values = expr_children(field);
                                if !values.is_empty() {
                                    if let Some(value) = lower_expr(ctx, values[0]) {
                                        fields.push((name_token.token.text, value))
                                    }
                                } else {
                                    fields.push(
                                        (
                                            name_token.token.text,
                                            Expr::Path {
                                                path: path_from_single_ident(name_token.token.text),
                                                owner_type_args: Vec::new(),
                                                member_type_args: Vec::new(),
                                                span: node_span(field),
                                            },
                                        ),
                                    )
                                }
                            }
                        }
                    }
                    let base = match first_child(node, cst::NodeKind::STRUCT_LITERAL_FIELD_LIST) {
                        Some(list) => match first_child(list, cst::NodeKind::STRUCT_LITERAL_UPDATE) {
                            Some(update) => {
                                let values = expr_children(update);
                                if !values.is_empty() {
                                    lower_expr(ctx, values[0])
                                } else {
                                    Option::None
                                }
                            },
                            None => Option::None,
                        },
                        None => Option::None,
                    };
                    Option::Some(
                        Expr::StructLiteral { name: path, fields, base, span: node_span(node) },
                    )
                },
                None => Option::None,
            },
            None => Option::None,
        }
    }
}

fn lower_expr(ctx: LowerCtx, node: LocatedNode) -> Option[Expr] {
    lower_expr_with_args(ctx, node, Vec::new())
}

fn lower_expr_with_args(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    if ctx.expr_depth.get() >= 256 {
        push_error(ctx, node_span(node), "expression is too deeply nested");
        Option::None
    } else {
        ctx.expr_depth.set(ctx.expr_depth.get() + 1);
        let value_span = node_span(node);
        let result = match node_kind(node) {
            EXPR_UNIT => if reject_trailing(
                ctx,
                node,
                trailing_args,
                "Cannot apply arguments to () expression",
            ) {
                Option::None
            } else {
                Option::Some(Expr::Unit { span: value_span })
            },
            EXPR_BOOL => if reject_trailing(
                ctx,
                node,
                trailing_args,
                "Cannot apply arguments to bool literal",
            ) {
                Option::None
            } else if has_token(node, lexer::TokenKind::TrueKeyword) {
                Option::Some(Expr::Bool { value: true, span: value_span })
            } else if has_token(node, lexer::TokenKind::FalseKeyword) {
                Option::Some(Expr::Bool { value: false, span: value_span })
            } else {
                push_error(ctx, value_span, "BoolExpr has no value");
                Option::None
            },
            EXPR_INT => lower_number_expr(ctx, node, trailing_args, lexer::TokenKind::IntLit, false),
            EXPR_FLOAT => lower_number_expr(ctx, node, trailing_args, lexer::TokenKind::Float, true),
            EXPR_CHAR => lower_char_expr(ctx, node, trailing_args),
            EXPR_BYTE => lower_byte_expr(ctx, node, trailing_args),
            EXPR_BYTE_STRING => lower_byte_string_expr(ctx, node, trailing_args),
            EXPR_STR => lower_string_expr(ctx, node, trailing_args),
            EXPR_RAW_STR => lower_raw_string_expr(ctx, node, trailing_args),
            EXPR_MULTILINE_STR => if reject_trailing(
                ctx,
                node,
                trailing_args,
                "Cannot apply arguments to string literal",
            ) {
                Option::None
            } else {
                lower_multiline_string(ctx, node).map(
                    |value| Expr::String { value, span: value_span },
                )
            },
            EXPR_INTERPOLATED_STRING => {
                lower_interpolated_string(ctx, node, trailing_args)
            },
            EXPR_IDENT => lower_ident_expr(ctx, node, trailing_args),
            EXPR_STRUCT_LITERAL => lower_struct_literal(ctx, node, trailing_args),
            EXPR_BLOCK => if reject_trailing(
                ctx,
                node,
                trailing_args,
                "Cannot apply type arguments to block expression",
            ) {
                Option::None
            } else {
                match first_child(node, cst::NodeKind::BLOCK) {
                    Some(block_node) => match lower_block(ctx, block_node) {
                        Some(block) => {
                            Option::Some(Expr::Block { block, span: value_span })
                        },
                        None => Option::None,
                    },
                    None => {
                        push_error(ctx, value_span, "Block expression has no block");
                        Option::None
                    },
                }
            },
            EXPR_ARRAY_LITERAL => lower_expr_sequence(ctx, node, trailing_args, false),
            EXPR_TUPLE => lower_expr_sequence(ctx, node, trailing_args, true),
            EXPR_PAREN => {
                let values = expr_children(node);
                if !values.is_empty() {
                    lower_expr_with_args(ctx, values[0], trailing_args)
                } else {
                    Option::None
                }
            },
            EXPR_CALL => lower_call_expr(ctx, node, trailing_args),
            EXPR_BINARY => lower_binary_expr(ctx, node, trailing_args),
            EXPR_PREFIX => lower_prefix_expr(ctx, node, trailing_args),
            EXPR_CAST => lower_cast_expr(ctx, node, trailing_args),
            EXPR_INDEX => lower_index_expr(ctx, node, trailing_args),
            EXPR_TRY => lower_try_expr(ctx, node, trailing_args),
            EXPR_RANGE => lower_range_expr(ctx, node, trailing_args),
            EXPR_CLOSURE => lower_closure(ctx, node, trailing_args),
            EXPR_MATCH => lower_match_expr(ctx, node, trailing_args),
            EXPR_SELECT => lower_select_expr(ctx, node, trailing_args),
            EXPR_IF => lower_if_expr(ctx, node, trailing_args),
            EXPR_WHILE => lower_while_expr(ctx, node, trailing_args),
            EXPR_LOOP => lower_loop_expr(ctx, node, trailing_args),
            EXPR_FOR => lower_for_expr(ctx, node, trailing_args),
            EXPR_BREAK => if reject_trailing(
                ctx,
                node,
                trailing_args,
                "Cannot apply arguments to break expression",
            ) {
                Option::None
            } else {
                let values = expr_children(node);
                let value = if !values.is_empty() {
                    lower_expr(ctx, values[0])
                } else {
                    Option::None
                };
                Option::Some(
                    Expr::Break {
                        label: first_token(node, lexer::TokenKind::Label).map(
                            |token| token.token.text.byte_slice(1, token.token.text.byte_len()),
                        ),
                        value,
                        span: value_span,
                    },
                )
            },
            EXPR_CONTINUE => if reject_trailing(
                ctx,
                node,
                trailing_args,
                "Cannot apply arguments to continue expression",
            ) {
                Option::None
            } else {
                Option::Some(
                    Expr::Continue {
                        label: first_token(node, lexer::TokenKind::Label).map(
                            |token| token.token.text.byte_slice(1, token.token.text.byte_len()),
                        ),
                        span: value_span,
                    },
                )
            },
            EXPR_RETURN => lower_return_expr(ctx, node, trailing_args),
            EXPR_GO => lower_go_expr(ctx, node, trailing_args),
            EXPR_SCOPE => lower_scope_expr(ctx, node, trailing_args),
            EXPR_COMPTIME => if reject_trailing(
                ctx,
                node,
                trailing_args,
                "Cannot apply arguments to comptime expression",
            ) {
                Option::None
            } else {
                match first_child(node, cst::NodeKind::BLOCK) {
                    Some(block_node) => lower_block(ctx, block_node).map(
                        |block| Expr::Comptime { block, span: value_span },
                    ),
                    None => {
                        push_error(ctx, value_span, "Comptime expression has no block");
                        Option::None
                    },
                }
            },
            EXPR_SPAWN => lower_spawn_expr(ctx, node, trailing_args),
            _ => Option::None,
        };
        ctx.expr_depth.set(ctx.expr_depth.get() - 1);
        result
    }
}

fn lower_number_expr(
    ctx: LowerCtx,
    node: LocatedNode,
    trailing_args: Vec[Expr],
    token_kind: lexer::TokenKind,
    is_float: bool,
) -> Option[Expr] {
    if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to numeric literal") {
        Option::None
    } else {
        match first_token(node, token_kind) {
            Some(token) => {
                let value_span = node_span(node);
                if is_float {
                    Option::Some(
                        Expr::Float {
                            value: normalized_number_text(token.token.text),
                            span: value_span,
                        },
                    )
                } else {
                    match numeric::normalize_integer(token.token.text) {
                        Some(text) => {
                            Option::Some(Expr::Int { value: text, span: value_span })
                        },
                        None => {
                            push_error(ctx, token_span(token), "Invalid integer literal");
                            Option::None
                        },
                    }
                }
            },
            None => Option::None,
        }
    }
}

fn normalized_number_text(value: string) -> string {
    let builder = text::StringBuilder::with_capacity(value.byte_len());
    for character in value.chars() {
        if character == '_' {} else {
            builder.write_char(character)
        }
    }
    builder.finish()
}

fn lower_char_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to char literal") {
        Option::None
    } else {
        match first_token(node, lexer::TokenKind::CharLit) {
            Some(token) => match strip_delimiters(token.token.text) {
                Some(value) => Option::Some(Expr::Char { value, span: node_span(node) }),
                None => {
                    push_error(ctx, token_span(token), "CharExpr has no value");
                    Option::None
                },
            },
            None => {
                push_error(ctx, node_span(node), "CharExpr has no value");
                Option::None
            },
        }
    }
}

fn byte_escape_value(value: u8) -> Option[isize] {
    match value {
        b'\'' => Option::Some(39),
        b'"' => Option::Some(34),
        b'0' => Option::Some(0),
        b'\\' => Option::Some(92),
        b'/' => Option::Some(47),
        b'b' => Option::Some(8),
        b'f' => Option::Some(12),
        b'n' => Option::Some(10),
        b'r' => Option::Some(13),
        b't' => Option::Some(9),
        _ => Option::None,
    }
}

fn byte_string_values(value: string) -> Option[Vec[string]] {
    if value.byte_len() < 3 || value.byte_get(0) != b'b' || value.byte_get(1) != b'"'
        || value.byte_get(value.byte_len() - 1) != b'"' {
        return Option::None
    }
    let result: Vec[string] = Vec::new();
    let mut index = 2;
    while index + 1 < value.byte_len() {
        let byte = value.byte_get(index);
        if byte == b'\\' {
            if index + 1 >= value.byte_len() - 1 {
                return Option::None
            } else if value.byte_get(index + 1) == b'x' {
                if index + 3 >= value.byte_len() - 1 {
                    return Option::None
                } else {
                    let high = hex_value(value.byte_get(index + 2))?;
                    let low = hex_value(value.byte_get(index + 3))?;
                    result.push((high * 16 + low).to_string());
                    index += 4;
                }
            } else {
                let decoded = byte_escape_value(value.byte_get(index + 1))?;
                result.push(decoded.to_string());
                index += 2;
            }
        } else if byte > 0x7f {
            return Option::None
        } else {
            result.push((byte.to_isize()).to_string());
            index += 1;
        }
    }
    Option::Some(result)
}

fn raw_byte_string_values(value: string) -> Option[Vec[string]] {
    if value.byte_len() < 4 || value.byte_get(0) != b'b' || value.byte_get(1) != b'r' {
        return Option::None
    }
    let mut hash_count = 0;
    while 2 + hash_count < value.byte_len() && value.byte_get(2 + hash_count) == b'#' {
        hash_count += 1;
    }
    let start = hash_count + 3;
    let end = value.byte_len() - hash_count - 1;
    if start > end || value.byte_get(start - 1) != b'"' || value.byte_get(end) != b'"' {
        return Option::None
    }
    let result: Vec[string] = Vec::new();
    for index in start..end {
        let byte = value.byte_get(index);
        if byte > 0x7f {
            return Option::None
        } else {
            result.push((byte.to_isize()).to_string())
        }
    }
    Option::Some(result)
}

fn byte_literal_value(value: string) -> Option[string] {
    if value.byte_len() == 4 && value.byte_get(0) == b'b' && value.byte_get(1) == b'\''
        && value.byte_get(3) == b'\'' {
        Option::Some((value.byte_get(2).to_isize()).to_string())
    } else if value.byte_len() == 5 && value.byte_get(0) == b'b' && value.byte_get(1) == b'\''
        && value.byte_get(2) == b'\\'
        && value.byte_get(4) == b'\'' {
        byte_escape_value(value.byte_get(3)).map(|byte| byte.to_string())
    } else if value.byte_len() == 7 && value.byte_get(0) == b'b' && value.byte_get(1) == b'\''
        && value.byte_get(2) == b'\\'
        && value.byte_get(3) == b'x'
        && value.byte_get(6) == b'\'' {
        match (hex_value(value.byte_get(4)), hex_value(value.byte_get(5))) {
            (Some(high), Some(low)) => {
                Option::Some((high * 16 + low).to_string())
            },
            _ => Option::None,
        }
    } else {
        Option::None
    }
}

fn lower_byte_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to byte literal") {
        Option::None
    } else {
        match first_token(node, lexer::TokenKind::ByteCharLit) {
            Some(token) => match byte_literal_value(token.token.text) {
                Some(value) => Option::Some(Expr::Byte { value, span: node_span(node) }),
                None => {
                    push_error(ctx, token_span(token), "Invalid byte literal");
                    Option::None
                },
            },
            None => {
                push_error(ctx, node_span(node), "ByteExpr has no value");
                Option::None
            },
        }
    }
}

fn lower_byte_string_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[
    Expr,
] {
    if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to byte string literal") {
        Option::None
    } else {
        let values = match first_token(node, lexer::TokenKind::ByteStr) {
            Some(token) => byte_string_values(token.token.text),
            None => first_token(node, lexer::TokenKind::RawByteStr).and_then(
                |token| raw_byte_string_values(token.token.text),
            ),
        };
        match values {
            Some(values) => {
                Option::Some(Expr::ByteString { values, span: node_span(node) })
            },
            None => {
                push_error(ctx, node_span(node), "Invalid byte string literal");
                Option::None
            },
        }
    }
}

fn lower_string_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to string literal") {
        Option::None
    } else {
        match first_token(node, lexer::TokenKind::Str) {
            Some(token) => match strip_delimiters(token.token.text) {
                Some(value) => Option::Some(
                    Expr::String { value: unescape_string(value), span: node_span(node) },
                ),
                None => {
                    push_error(ctx, token_span(token), "StrExpr has no value");
                    Option::None
                },
            },
            None => {
                push_error(ctx, node_span(node), "StrExpr has no value");
                Option::None
            },
        }
    }
}

fn lower_raw_string_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to string literal") {
        Option::None
    } else {
        match first_token(node, lexer::TokenKind::RawStr) {
            Some(token) => {
                let source = token.token.text;
                let mut hash_count = 0;
                while 1 + hash_count < source.byte_len() && source.byte_get(1 + hash_count) == b'#' {
                    hash_count += 1;
                }
                let start = hash_count + 2;
                let end = source.byte_len() - hash_count - 1;
                Option::Some(
                    Expr::String { value: source.byte_slice(start, end), span: node_span(node) },
                )
            },
            None => {
                push_error(ctx, node_span(node), "Raw string expression has no value");
                Option::None
            },
        }
    }
}

fn lower_ident_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    match lower_ident_parts(ctx, node) {
        Some(parts) => match path_last(parts.path) {
            Some(last) => {
                let base = if parts.owner_type_args.is_empty() && parts.member_type_args.is_empty()
                    && ident_starts_upper(last) {
                    Expr::ConstructorValue { constructor: parts.path, span: node_span(node) }
                } else {
                    Expr::Path {
                        path: parts.path,
                        owner_type_args: parts.owner_type_args,
                        member_type_args: parts.member_type_args,
                        span: node_span(node),
                    }
                };
                apply_trailing_args(ctx, base, trailing_args, node_span(node))
            },
            None => {
                push_error(ctx, node_span(node), "Path expression is missing a name");
                Option::None
            },
        },
        None => Option::None,
    }
}

fn lower_expr_sequence(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr], tuple: bool) -> Option[
    Expr,
] {
    if reject_trailing(
        ctx,
        node,
        trailing_args,
        if tuple {
            "Cannot apply arguments to tuple literal"
        } else {
            "Cannot apply arguments to array literal"
        },
    ) {
        Option::None
    } else {
        let items: Vec[Expr] = Vec::new();
        for child in expr_children(node) {
            if let Some(value) = lower_expr(ctx, child) {
                items.push(value)
            }
        }
        if tuple {
            Option::Some(Expr::Tuple { items, span: node_span(node) })
        } else {
            Option::Some(Expr::Array { items, span: node_span(node) })
        }
    }
}
