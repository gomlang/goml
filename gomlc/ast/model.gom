package ast;

use module::cst;

pub struct Span {
    pub start: isize,
    pub end: isize,
}

pub struct PathSegment {
    pub ident: string,
    pub span: Span,
}

pub struct Path {
    pub segments: Vec[PathSegment],
}

pub enum TypeExpr {
    Unit,
    Bool,
    Int,
    Int8,
    Int16,
    Int32,
    Int64,
    Uint,
    Uint8,
    Uint16,
    Uint32,
    Uint64,
    Float32,
    Float64,
    String,
    Char,
    Tuple {
        items: Vec[TypeExpr],
    },
    Con {
        path: Path,
    },
    Dyn {
        bounds: Vec[DynTraitBound],
    },
    App {
        ty: TypeExpr,
        args: Vec[TypeExpr],
    },
    Array {
        len: string,
        elem: TypeExpr,
    },
    Func {
        params: Vec[TypeExpr],
        ret_ty: TypeExpr,
    },
}

pub struct DynTraitBound {
    pub trait_path: Path,
    pub args: Vec[TypeExpr],
    pub associated_types: Vec[(string, TypeExpr)],
}

pub struct ClosureParam {
    pub name: string,
    pub ty: Option[TypeExpr],
    pub span: Span,
}

pub struct Attribute {
    pub span: Span,
    pub text: string,
    pub name: string,
    pub has_argument_list: bool,
    pub args: Vec[AttributeArg],
}

pub enum AttributeArg {
    Ident(string),
    Path(string),
    String(string),
    Named {
        name: string,
        value_kind: string,
        value: string,
    },
}

pub struct File {
    pub package_name: string,
    pub package_explicit: bool,
    pub uses: Vec[UseDecl],
    pub items: Vec[Item],
    pub invalid_self_type_spans: Vec[Span],
}

pub struct UseDecl {
    pub visibility: Visibility,
    pub path: Path,
    pub alias: Option[string],
    pub items: Vec[UseItem],
}

pub struct UseItem {
    pub name: string,
    pub alias: Option[string],
    pub span: Span,
}

pub enum Visibility {
    Private,
    Public,
}

pub struct ExternType {
    pub attrs: Vec[Attribute],
    pub visibility: Visibility,
    pub name: string,
    pub name_span: Span,
    pub generics: Vec[string],
}

pub enum Item {
    EnumDef(EnumDef),
    StructDef(StructDef),
    TraitDef(TraitDef),
    ImplBlock(ImplBlock),
    Function(Function),
    ExternFunction(ExternFunction),
    ExternType(ExternType),
    TypeAlias(TypeAlias),
    Constant(Constant),
    Static(Static),
}

pub struct TypeAlias {
    pub attrs: Vec[Attribute],
    pub visibility: Visibility,
    pub name: string,
    pub generics: Vec[string],
    pub ty: TypeExpr,
    pub ty_span: Span,
}

pub struct Constant {
    pub attrs: Vec[Attribute],
    pub visibility: Visibility,
    pub name: string,
    pub ty: TypeExpr,
    pub ty_span: Span,
    pub value: Expr,
}

pub struct Static {
    pub attrs: Vec[Attribute],
    pub visibility: Visibility,
    pub name: string,
    pub ty: TypeExpr,
    pub ty_span: Span,
    pub value: Expr,
}

pub struct Function {
    pub attrs: Vec[Attribute],
    pub visibility: Visibility,
    pub name: string,
    pub name_span: Span,
    pub generics: Vec[string],
    pub generic_bounds: Vec[(string, Vec[TraitRef])],
    pub predicates: Vec[Predicate],
    pub params: Vec[(string, TypeExpr)],
    pub param_type_spans: Vec[Span],
    pub ret_ty: Option[TypeExpr],
    pub ret_ty_span: Option[Span],
    pub body: Block,
}

pub struct ExternFunction {
    pub name_span: Span,
    pub attrs: Vec[Attribute],
    pub visibility: Visibility,
    pub name: string,
    pub generics: Vec[string],
    pub generic_bounds: Vec[(string, Vec[TraitRef])],
    pub predicates: Vec[Predicate],
    pub params: Vec[(string, TypeExpr)],
    pub ret_ty: Option[TypeExpr],
}

pub struct EnumDef {
    pub attrs: Vec[Attribute],
    pub visibility: Visibility,
    pub name: string,
    pub generics: Vec[string],
    pub variants: Vec[EnumVariant],
}

pub struct EnumVariant {
    pub attrs: Vec[Attribute],
    pub name: string,
    pub fields: EnumVariantFields,
    pub field_type_spans: Vec[Span],
    pub field_attrs: Vec[Vec[Attribute]],
}

pub enum EnumVariantFields {
    Unit,
    Tuple(Vec[TypeExpr]),
    Struct(Vec[(string, TypeExpr)]),
}

pub struct StructDef {
    pub attrs: Vec[Attribute],
    pub visibility: Visibility,
    pub name: string,
    pub generics: Vec[string],
    pub newtype: bool,
    pub fields: Vec[(string, TypeExpr)],
    pub field_type_spans: Vec[Span],
    pub field_attrs: Vec[Vec[Attribute]],
    pub public_fields: Vec[string],
}

pub struct TraitDef {
    pub attrs: Vec[Attribute],
    pub visibility: Visibility,
    pub name: string,
    pub generics: Vec[string],
    pub generic_bounds: Vec[(string, Vec[TraitRef])],
    pub predicates: Vec[Predicate],
    pub supertraits: Vec[TraitRef],
    pub associated_types: Vec[AssociatedType],
    pub method_sigs: Vec[TraitMethodSignature],
}

pub struct AssociatedType {
    pub name: string,
    pub bounds: Vec[TraitRef],
}

pub struct TraitRef {
    pub path: Path,
    pub args: Vec[TypeExpr],
}

pub enum Predicate {
    Trait {
        ty: TypeExpr,
        trait_ref: TraitRef,
    },
    Equality {
        lhs: TypeExpr,
        rhs: TypeExpr,
    },
}

pub struct TraitMethodSignature {
    pub name: string,
    pub has_receiver: bool,
    pub generics: Vec[string],
    pub generic_bounds: Vec[(string, Vec[TraitRef])],
    pub predicates: Vec[Predicate],
    pub params: Vec[(string, TypeExpr)],
    pub ret_ty: TypeExpr,
    pub body: Option[Block],
}

pub struct ImplBlock {
    pub attrs: Vec[Attribute],
    pub generics: Vec[string],
    pub generic_bounds: Vec[(string, Vec[TraitRef])],
    pub predicates: Vec[Predicate],
    pub associated_types: Vec[(string, TypeExpr)],
    pub trait_ref: Option[TraitRef],
    pub for_type: TypeExpr,
    pub for_type_span: Span,
    pub methods: Vec[Function],
}

pub struct Block {
    pub stmts: Vec[Stmt],
    pub tail: Option[Expr],
    pub span: Span,
}

pub enum Stmt {
    Defer {
        expr: Expr,
        span: Span,
    },
    Let {
        is_mut: bool,
        pat: Pat,
        annotation: Option[TypeExpr],
        value: Expr,
        else_branch: Option[Expr],
        span: Span,
    },
    Assign {
        target: Expr,
        op: AssignmentOp,
        value: Expr,
        span: Span,
    },
    Expr {
        expr: Expr,
        span: Span,
    },
}

pub enum UnaryOp {
    Neg,
    Not,
    BitNot,
}

pub enum BinaryOp {
    Add,
    Sub,
    Mul,
    Div,
    Rem,
    BitAnd,
    BitOr,
    BitXor,
    Shl,
    Shr,
    And,
    Or,
    Less,
    Greater,
    LessEq,
    GreaterEq,
    Eq,
    NotEq,
}

pub enum AssignmentOp {
    Plain,
    Compound(BinaryOp),
}

pub enum InterpolatedStringPart {
    Text(string),
    Expr(Expr),
}

pub enum SelectArm {
    Receive {
        channel: Expr,
        guard: Option[Expr],
        binding: string,
        body: Expr,
        span: Span,
    },
    Send {
        channel: Expr,
        value: Expr,
        guard: Option[Expr],
        body: Expr,
        span: Span,
    },
    Default {
        body: Expr,
        span: Span,
    },
}

pub enum SelectMode {
    Normal,
    Priority,
}

pub enum ChannelDirection {
    Both,
    Send,
    Receive,
}

pub fn channel_directions_equal(left: ChannelDirection, right: ChannelDirection) -> bool {
    match (left, right) {
        (Both, Both) | (Send, Send) | (Receive, Receive) => true,
        _ => false,
    }
}

pub enum Expr {
    Path {
        path: Path,
        owner_type_args: Vec[TypeExpr],
        member_type_args: Vec[TypeExpr],
        span: Span,
    },
    Unit {
        span: Span,
    },
    Bool {
        value: bool,
        span: Span,
    },
    Int {
        value: string,
        span: Span,
    },
    Float {
        value: string,
        span: Span,
    },
    String {
        value: string,
        span: Span,
    },
    InterpolatedString {
        parts: Vec[InterpolatedStringPart],
        span: Span,
    },
    Char {
        value: string,
        span: Span,
    },
    Byte {
        value: string,
        span: Span,
    },
    ByteString {
        values: Vec[string],
        span: Span,
    },
    ConstructorValue {
        constructor: Path,
        span: Span,
    },
    Constr {
        constructor: Path,
        args: Vec[Expr],
        span: Span,
    },
    StructLiteral {
        name: Path,
        fields: Vec[(string, Expr)],
        base: Option[Expr],
        span: Span,
    },
    Tuple {
        items: Vec[Expr],
        span: Span,
    },
    Array {
        items: Vec[Expr],
        span: Span,
    },
    Closure {
        params: Vec[ClosureParam],
        body: Expr,
        span: Span,
    },
    Match {
        expr: Expr,
        arms: Vec[Arm],
        span: Span,
    },
    Select {
        mode: SelectMode,
        arms: Vec[SelectArm],
        span: Span,
    },
    If {
        cond: Expr,
        then_branch: Expr,
        else_branch: Expr,
        span: Span,
    },
    While {
        label: Option[string],
        cond: Expr,
        body: Expr,
        span: Span,
    },
    Loop {
        label: Option[string],
        body: Expr,
        span: Span,
    },
    For {
        label: Option[string],
        pat: Pat,
        iterator: Expr,
        body: Expr,
        span: Span,
    },
    Break {
        label: Option[string],
        value: Option[Expr],
        span: Span,
    },
    Continue {
        label: Option[string],
        span: Span,
    },
    Return {
        expr: Option[Expr],
        span: Span,
    },
    Go {
        expr: Expr,
        span: Span,
    },
    Scope {
        body: Expr,
        span: Span,
    },
    Comptime {
        block: Block,
        span: Span,
    },
    Spawn {
        body: Expr,
        span: Span,
    },
    Call {
        func: Expr,
        args: Vec[Expr],
        span: Span,
    },
    Unary {
        op: UnaryOp,
        expr: Expr,
        span: Span,
    },
    Cast {
        expr: Expr,
        ty: TypeExpr,
        span: Span,
    },
    Try {
        expr: Expr,
        span: Span,
    },
    Range {
        start: Expr,
        end: Expr,
        inclusive: bool,
        span: Span,
    },
    Binary {
        op: BinaryOp,
        lhs: Expr,
        rhs: Expr,
        span: Span,
    },
    Proj {
        tuple: Expr,
        index: isize,
        span: Span,
    },
    Field {
        expr: Expr,
        field_name: string,
        method_type_args: Vec[TypeExpr],
        span: Span,
    },
    Index {
        base: Expr,
        index: Expr,
        span: Span,
    },
    Block {
        block: Block,
        span: Span,
    },
}

pub struct Arm {
    pub pat: Pat,
    pub guard: Option[Expr],
    pub body: Expr,
}

pub struct ArrayPatRest {
    pub binding: Option[string],
    pub span: Span,
}

pub enum Pat {
    Var {
        name: string,
        is_mut: bool,
        span: Span,
    },
    Unit {
        span: Span,
    },
    Bool {
        value: bool,
        span: Span,
    },
    Int {
        value: string,
        span: Span,
    },
    Float {
        value: string,
        span: Span,
    },
    String {
        value: string,
        span: Span,
    },
    Char {
        value: string,
        span: Span,
    },
    Byte {
        value: string,
        span: Span,
    },
    Constr {
        constructor: Path,
        args: Vec[Pat],
        span: Span,
    },
    Struct {
        name: Path,
        fields: Vec[(string, Pat)],
        has_rest: bool,
        span: Span,
    },
    Tuple {
        items: Vec[Pat],
        span: Span,
    },
    Array {
        prefix: Vec[Pat],
        rest: Option[ArrayPatRest],
        suffix: Vec[Pat],
        span: Span,
    },
    Alias {
        name: string,
        pat: Pat,
        span: Span,
    },
    Or {
        pats: Vec[Pat],
        span: Span,
    },
    Range {
        start: Pat,
        end: Pat,
        inclusive: bool,
        span: Span,
    },
    Wild {
        span: Span,
    },
}

pub struct LowerResult {
    pub ast: Option[File],
    pub diagnostics: Vec[cst::Diagnostic],
}

pub fn span(start: isize, end: isize) -> Span {
    Span { start, end }
}

pub fn expr_span(value: Expr) -> Span {
    match value {
        Path { span, .. } | Unit { span } | Bool { span, .. } | Int { span, .. } | Float {
            span,
            ..,
        } | String { span, .. } | InterpolatedString { span, .. } | Char { span, .. } | Byte {
            span,
            ..,
        } | ByteString { span, .. } | ConstructorValue { span, .. } | Constr { span, .. } | StructLiteral {
            span,
            ..,
        } | Tuple { span, .. } | Array { span, .. } | Closure { span, .. } | Match { span, .. } | Select {
            span,
            ..,
        } | If { span, .. } | While { span, .. } | Loop { span, .. } | For { span, .. } | Break {
            span,
            ..,
        } | Continue { span, .. } | Return { span, .. } | Go { span, .. } | Scope { span, .. } | Comptime {
            span,
            ..,
        } | Spawn { span, .. } | Call { span, .. } | Unary { span, .. } | Cast { span, .. } | Try {
            span,
            ..,
        } | Range { span, .. } | Binary { span, .. } | Proj { span, .. } | Field { span, .. } | Index {
            span,
            ..,
        } | Block { span, .. } => span,
    }
}

pub fn pat_span(value: Pat) -> Span {
    match value {
        Var { span, .. } | Unit { span } | Bool { span, .. } | Int { span, .. } | Float { span, .. } | String {
            span,
            ..,
        } | Char { span, .. } | Byte { span, .. } | Constr { span, .. } | Struct { span, .. } | Tuple {
            span,
            ..,
        } | Array { span, .. } | Alias { span, .. } | Or { span, .. } | Range { span, .. } | Wild {
            span,
        } => span,
    }
}
