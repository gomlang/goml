package lift;

use module::ast;
use module::core;
use module::hir;
use module::mono;
use module::parser;
use module::repr;
use module::tast;
use std::testing;

fn lower_source(source: string) -> File {
    match lower_checked(
        mono::lower(
            core::lower(tast::check(hir::lower(ast::lower(parser::parse(source)), "main.goml"))),
        ),
    ) {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            File {
                functions: Vec::new(),
                enums: Vec::new(),
                structs: Vec::new(),
                type_instances: Vec::new(),
                constants: Vec::new(),
                statics: Vec::new(),
                closure_defs: Vec::new(),
            }
        },
    }
}

#[test]
fn snapshot_names_restart_for_each_function() -> () {
    let output = encode_snapshot(
        lower_source("fn first(value: i32) -> i32 { value } fn second(value: i32) -> i32 { value }"),
    );
    testing::assert(output.contains("fn first(value/0: i32)"));
    testing::assert(output.contains("fn second(value/0: i32)"))
}

#[test]
fn consumes_shared_names_for_lifted_parameters() -> () {
    let value = mono::lower(
        core::lower(
            tast::check(
                hir::lower(
                    ast::lower(
                        parser::parse(
                            "fn main() { let result = (|x| x + 1)(41); println(result); }",
                        ),
                    ),
                    "main.goml",
                ),
            ),
        ),
    );
    let counter = Ref::new(61);
    let file = lower_with_counter(value, counter);
    testing::assert_eq(counter.get(), 62);
    testing::assert_eq(file.functions.get(1).params.get(0).0, "env61")
}

#[test]
fn flattens_monomorphic_blocks() -> () {
    let source = "fn main() { let _ = (); let a = (true, false, (true, false)); let b = match a { (x, y, (z, w)) => w }; let _ = print(b); () }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\fn main() -> () {
        \\  let mtmp0 = () in
        \\  let a/0 = (true, false, (true, false)) in
        \\  let b/5 =
        \\    let x1 = a/0.0 in
        \\    let x2 = a/0.1 in
        \\    let x3 = a/0.2 in
        \\    let x4 = x3.0 in
        \\    let x5 = x3.1 in
        \\    let w/4 = x5 in
        \\    let z/3 = x4 in
        \\    let y/2 = x2 in
        \\    let x/1 = x1 in
        \\    w/4 in
        \\  let mtmp6 = print(b/5) in
        \\  ()
        \\}
        ,
    )
}

#[test]
fn fills_empty_block_tails() -> () {
    testing::assert_eq(
        encode(lower_source("fn main() -> () { let value = 1; }")),
        \\fn main() -> () {
        \\  let value/0 = 1 in
        \\  ()
        \\}
        ,
    )
}

#[test]
fn lifts_closures_in_enum_payloads() -> () {
    let source = "enum MaybeFn { Some((i32) -> i32), None } fn next(flag: bool) -> MaybeFn { if flag { MaybeFn::Some(|x| x + 1) } else { MaybeFn::None } } fn main() -> () { match next(true) { MaybeFn::Some(f) => println(f(41).to_string()), MaybeFn::None => println(\"none\"), } }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\fn next(flag/0: bool) -> MaybeFn {
        \\  if flag/0 {
        \\      MaybeFn::Some(
        \\        pack_closure[inherent#closure_env_next_0#closure_env_next_0#apply](closure_env_next_0 {})
        \\      )
        \\  } else {
        \\      MaybeFn::None
        \\  }
        \\}
        \\
        \\fn main() -> () {
        \\  let mtmp0 = next(true) in
        \\  match mtmp0 {
        \\    MaybeFn::Some(x1) => {
        \\      let x1 = MaybeFn::Some._0(mtmp0) in
        \\      let f/2 = x1 in
        \\      println(inherent#i32#i32#to_string(f/2(41)))
        \\    },
        \\    MaybeFn::None => {
        \\      println("none")
        \\    },
        \\  }
        \\}
        \\
        \\fn inherent#closure_env_next_0#closure_env_next_0#apply(env2: closure_env_next_0, x/1: i32) -> i32 {
        \\  (x/1 + 1)
        \\}
        ,
    )
}

#[test]
fn ignores_digits_in_monomorphic_function_names() -> () {
    let source = "fn grow[T](x: T, flag: bool) -> () { if flag { grow(|n: i32| n + 1, false) } else { println(\"done\") } } fn main() -> () { grow(1, true) }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\fn main() -> () {
        \\  grow__T_isize(1, true)
        \\}
        \\
        \\fn grow__T_isize(x/0: isize, flag/1: bool) -> () {
        \\  if flag/1 {
        \\      grow__T_(i32)->i32(
        \\        pack_closure[inherent#closure_env_grow_T_isize_0#closure_env_grow_T_isize_0#apply](
        \\          closure_env_grow_T_isize_0 {}
        \\        ),
        \\        false
        \\      )
        \\  } else {
        \\      println("done")
        \\  }
        \\}
        \\
        \\fn grow__T_(i32)->i32(x/0: (i32) -> i32, flag/1: bool) -> () {
        \\  if flag/1 {
        \\      grow__T_(i32)->i32(
        \\        pack_closure[inherent#closure_env_grow_T_i32_i32_1#closure_env_grow_T_i32_i32_1#apply](
        \\          closure_env_grow_T_i32_i32_1 {}
        \\        ),
        \\        false
        \\      )
        \\  } else {
        \\      println("done")
        \\  }
        \\}
        \\
        \\fn inherent#closure_env_grow_T_isize_0#closure_env_grow_T_isize_0#apply(
        \\  env0: closure_env_grow_T_isize_0,
        \\  n/2: i32
        \\) -> i32 {
        \\  (n/2 + 1)
        \\}
        \\
        \\fn inherent#closure_env_grow_T_i32_i32_1#closure_env_grow_T_i32_i32_1#apply(
        \\  env1: closure_env_grow_T_i32_i32_1,
        \\  n/2: i32
        \\) -> i32 {
        \\  (n/2 + 1)
        \\}
        ,
    )
}

#[test]
fn preserves_immediate_closure_calls() -> () {
    let source = "fn main() { let result = (|x| x + 1)(41); println(result.to_string()); }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\fn main() -> () {
        \\  let result/1 = inherent#closure_env_main_0#closure_env_main_0#apply(closure_env_main_0 {}, 41) in
        \\  let _wild0 = println(inherent#isize#isize#to_string(result/1)) in
        \\  ()
        \\}
        \\
        \\fn inherent#closure_env_main_0#closure_env_main_0#apply(
        \\  env1: closure_env_main_0,
        \\  x/0: isize
        \\) -> isize {
        \\  (x/0 + 1)
        \\}
        ,
    )
}

#[test]
fn avoids_existing_closure_environment_names() -> () {
    let source = "struct ClosureEnvF0 { value: i32 } fn main() -> () { let _ = ClosureEnvF0 { value: 1 }; let f = |x: i32| x + 1; println(f(2).to_string()); }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\fn main() -> () {
        \\  let mtmp0 = ClosureEnvF0 { value: 1 } in
        \\  let f/1 = pack_closure[inherent#closure_env_f_0#closure_env_f_0#apply](closure_env_f_0 {}) in
        \\  let _wild1 = println(inherent#i32#i32#to_string(f/1(2))) in
        \\  ()
        \\}
        \\
        \\fn inherent#closure_env_f_0#closure_env_f_0#apply(env2: closure_env_f_0, x/0: i32) -> i32 {
        \\  (x/0 + 1)
        \\}
        ,
    )
}

#[test]
fn eliminates_dead_lifted_locals() -> () {
    let value = lower_source(
        "fn effect() -> i32 { 1 } fn main() -> () { let dead = (1, 2); let kept = effect(); () }",
    );
    let output = encode(dce(value));
    testing::assert(!output.contains("dead/"));
    testing::assert(output.contains("let kept/"))
}

#[test]
fn validates_generated_closure_environments() -> () {
    let file = lower_source(
        "fn main() -> () { let add = |value: i32| value + 1; println(add(41)); }",
    );
    if let Err(message) = validate(file) {
        testing::fail(message)
    }
}

#[test]
fn represents_stored_closures_with_explicit_packs() -> () {
    let file = lower_source(
        "fn use_pair(value: ((i32) -> i32, (i32) -> i32)) -> i32 { value.0(1) + value.1(2) } fn main() -> () { println(use_pair((|x: i32| x + 1, |x: i32| x + 2))) }",
    );
    let output = encode(file);
    testing::assert_eq(file.closure_defs.len(), 2);
    testing::assert(output.contains("pack_closure["));
    if let Err(message) = validate(file) {
        testing::fail(message)
    }
}

#[test]
fn rejects_mismatched_closure_metadata() -> () {
    let file = lower_source(
        "fn consume(value: (i32) -> i32) -> i32 { value(1) } fn main() -> () { println(consume(|x: i32| x + 1)) }",
    );
    let definition = file.closure_defs[0];
    let invalid = File {
        functions: file.functions,
        enums: file.enums,
        structs: file.structs,
        type_instances: file.type_instances,
        constants: file.constants,
        statics: file.statics,
        closure_defs: Vec::from_array(
            [
                repr::ClosureDef {
                    environment: definition.environment,
                    apply: definition.apply,
                    signature: repr::Type::Unit,
                },
            ],
        ),
    };
    match validate(invalid) {
        Ok(_) => testing::fail("expected closure metadata rejection"),
        Err(message) => testing::assert(message.contains("closure signature does not match")),
    }
}

#[test]
fn rejects_closures_with_non_function_types() -> () {
    let source = mono::lower(
        core::lower(
            tast::check(
                hir::lower(ast::lower(parser::parse("fn main() -> () { () }")), "main.goml"),
            ),
        ),
    );
    let function = source.functions[0];
    let functions = Vec::from_array(
        [
            mono::Function {
                name: function.name,
                origin: function.origin,
                root: function.root,
                trait_impl: function.trait_impl,
                params: function.params,
                ret_ty: function.ret_ty,
                body: mono::Block {
                    stmts: Vec::new(),
                    tail: Option::Some(
                        mono::Expr::Closure {
                            params: Vec::new(),
                            body: mono::Expr::Prim {
                                value: mono::Primitive::Unit,
                                ty: mono::Type::Unit,
                            },
                            ty: mono::Type::Int,
                        },
                    ),
                },
            },
        ],
    );
    match lower_checked(
        mono::File {
            functions,
            enums: source.enums,
            structs: source.structs,
            type_instances: source.type_instances,
            constants: source.constants,
            statics: source.statics,
        },
    ) {
        Ok(_) => testing::fail("expected invalid closure type"),
        Err(message) => testing::assert(message.contains("non-function type")),
    }
}
