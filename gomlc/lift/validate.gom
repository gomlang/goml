package lift;

use module::repr;
use std::collections;

struct ValidateContext {
    closures_by_apply: HashMap[string, repr::ClosureDef],
    environments: collections::HashSet[string],
}

fn validate_type(ctx: ValidateContext, value: repr::Type, context: string) -> Result[(), string] {
    match value {
        External { import_path: _, name: _, args } => validate_types(ctx, args, context),
        Tuple { items } => validate_types(ctx, items, context),
        ClosureEnvironment { name } => if ctx.environments.contains(name) {
            Result::Ok(())
        } else {
            Result::Err(context + " references unknown closure environment " + name)
        },
        Dyn { trait_name: _, args, associated_types, additional_bounds } => {
            validate_types(ctx, args, context)?;
            validate_named_types(ctx, associated_types, context)?;
            for bound in additional_bounds {
                validate_types(ctx, bound.args, context)?;
                validate_named_types(ctx, bound.associated_types, context)?
            }
            Result::Ok(())
        },
        Array { len: _, elem } | Slice { elem } | MutSlice { elem } | VecType { elem } | GoPointer {
            elem,
        } | GoFunction { signature: elem } | RefType { elem } | Channel { elem, direction: _ } => validate_type(
            ctx,
            elem,
            context,
        ),
        HashMap { key, value } => {
            validate_type(ctx, key, context)?;
            validate_type(ctx, value, context)
        },
        GoMap { key, value } => {
            validate_type(ctx, key, context)?;
            validate_type(ctx, value, context)
        },
        Func { params, ret_ty } => {
            validate_types(ctx, params, context)?;
            validate_type(ctx, ret_ty, context)
        },
        Unit | Never | Bool | Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | Float32 | Float64 | String | Char | Named {
            name: _,
        } => Result::Ok(()),
    }
}

fn validate_types(ctx: ValidateContext, values: Vec[repr::Type], context: string) -> Result[
    (),
    string,
] {
    for value in values {
        validate_type(ctx, value, context)?
    }
    Result::Ok(())
}

fn validate_named_types(ctx: ValidateContext, values: Vec[(string, repr::Type)], context: string) -> Result[
    (),
    string,
] {
    for value in values {
        validate_type(ctx, value.1, context + " " + value.0)?
    }
    Result::Ok(())
}

fn validate_exprs(ctx: ValidateContext, values: Vec[Expr], context: string) -> Result[(), string] {
    for value in values {
        validate_expr(ctx, value, context)?
    }
    Result::Ok(())
}

fn validate_optional_expr(ctx: ValidateContext, value: Option[Expr], context: string) -> Result[
    (),
    string,
] {
    match value {
        Some(value) => validate_expr(ctx, value, context),
        None => Result::Ok(()),
    }
}

fn validate_arm(ctx: ValidateContext, value: Arm, context: string) -> Result[(), string] {
    validate_expr(ctx, value.lhs, context + " pattern")?;
    validate_expr(ctx, value.body, context + " body")
}

fn validate_select_arm(ctx: ValidateContext, value: SelectArm, context: string) -> Result[
    (),
    string,
] {
    match value {
        Receive { channel, guard, binding: _, binding_ty, body } => {
            validate_expr(ctx, channel, context + " channel")?;
            validate_optional_expr(ctx, guard, context + " guard")?;
            validate_type(ctx, binding_ty, context + " binding")?;
            validate_expr(ctx, body, context + " body")
        },
        Send { channel, value, guard, body } => {
            validate_expr(ctx, channel, context + " channel")?;
            validate_expr(ctx, value, context + " value")?;
            validate_optional_expr(ctx, guard, context + " guard")?;
            validate_expr(ctx, body, context + " body")
        },
    }
}

fn validate_block(ctx: ValidateContext, value: Block, context: string) -> Result[(), string] {
    for statement in value.stmts {
        validate_type(ctx, statement.ty, context + " let " + statement.name)?;
        validate_expr(ctx, statement.value, context + " let " + statement.name)?
    }
    validate_optional_expr(ctx, value.tail, context + " tail")
}

fn validate_pack_closure(
    ctx: ValidateContext,
    environment: Expr,
    apply: string,
    ty: repr::Type,
    context: string,
) -> Result[(), string] {
    let definition = ctx.closures_by_apply[apply].ok_or(
        context + " references unknown closure apply function " + apply,
    )?;
    if repr::types_equal(ty, definition.signature) {} else {
        return Result::Err(context + " closure signature does not match " + apply)
    }
    match expr_type(environment) {
        ClosureEnvironment { name } if name == definition.environment => (),
        _ => return Result::Err(context + " closure environment does not match " + apply),
    }
    validate_expr(ctx, environment, context + " closure environment")
}

fn validate_expr(ctx: ValidateContext, value: Expr, context: string) -> Result[(), string] {
    validate_type(ctx, expr_type(value), context)?;
    match value {
        Callable { callable: InterfaceBridge(value), ty } => repr::validate_go_interface_bridge(
            value,
            ty,
        ),
        Callable { callable: CallbackAdapter(value), ty } => repr::validate_callback_adapter(
            value,
            ty,
        ),
        Var { name: _, ty: _ } | Callable { callable: _, ty: _ } | Prim { value: _, ty: _ } | Continue {
            target: _,
            ty: _,
        } => Result::Ok(()),
        Constr { constructor: _, args, ty: _ } => validate_exprs(ctx, args, context),
        Tuple { items, ty: _ } | Array { items, ty: _ } => validate_exprs(ctx, items, context),
        Block { block, ty: _ } => validate_block(ctx, block, context),
        Match { expr, arms, default, ty: _ } => {
            validate_expr(ctx, expr, context + " match scrutinee")?;
            for arm in arms {
                validate_arm(ctx, arm, context + " match arm")?
            }
            validate_optional_expr(ctx, default, context + " match default")
        },
        Select { arms, default, .. } => {
            for arm in arms {
                validate_select_arm(ctx, arm, context + " select arm")?
            }
            validate_optional_expr(ctx, default, context + " select default")
        },
        If { cond, then_branch, else_branch, ty: _ } => {
            validate_expr(ctx, cond, context + " if condition")?;
            validate_expr(ctx, then_branch, context + " if branch")?;
            validate_expr(ctx, else_branch, context + " else branch")
        },
        While { cond, body, ty: _ } => {
            validate_expr(ctx, cond, context + " while condition")?;
            validate_expr(ctx, body, context + " while body")
        },
        Loop { body, ty: _ } => validate_expr(ctx, body, context + " loop body"),
        Break { target: _, value, ty: _ } => validate_optional_expr(ctx, value, context + " break"),
        Return { expr, ty: _ } => validate_optional_expr(ctx, expr, context + " return"),
        Go { expr, ty: _ } => validate_expr(ctx, expr, context + " go"),
        ConstrGet { expr, constructor: _, field_index: _, ty: _ } | Unary { op: _, expr, ty: _ } | Cast {
            expr,
            ty: _,
        } | Proj { tuple: expr, index: _, ty: _ } => validate_expr(ctx, expr, context),
        Binary { op: _, lhs, rhs, ty: _ } => {
            validate_expr(ctx, lhs, context)?;
            validate_expr(ctx, rhs, context)
        },
        Assign { name: _, value, target_ty, ty: _ } => {
            validate_type(ctx, target_ty, context + " assignment target")?;
            validate_expr(ctx, value, context + " assignment value")
        },
        Call { func, args, ty: _ } => {
            validate_expr(ctx, func, context + " call target")?;
            validate_exprs(ctx, args, context + " call argument")
        },
        ToDyn { trait_name: _, for_ty, expr, ty: _ } => {
            validate_type(ctx, for_ty, context + " dynamic conversion")?;
            validate_expr(ctx, expr, context + " dynamic conversion")
        },
        DynCall { trait_name: _, method_name: _, receiver, args, ty: _ } => {
            validate_expr(ctx, receiver, context + " dynamic receiver")?;
            validate_exprs(ctx, args, context + " dynamic argument")
        },
        PackClosure { environment, apply, ty } => {
            validate_pack_closure(ctx, environment, apply, ty, context)
        },
    }
}

fn validate_origin(ctx: ValidateContext, value: FunctionOrigin, context: string) -> Result[
    (),
    string,
] {
    match value {
        Source | TraitImplementation { method_name: _ } => Result::Ok(()),
        Inherent { owner, method_name: _ } => validate_type(ctx, owner, context + " owner"),
    }
}

fn validate_trait_impl(ctx: ValidateContext, value: Option[TraitImpl], context: string) -> Result[
    (),
    string,
] {
    match value {
        Some(value) => {
            validate_types(ctx, value.trait_ref.args, context + " trait arguments")?;
            validate_type(ctx, value.for_ty, context + " implementation type")?;
            validate_named_types(ctx, value.associated_types, context + " associated type")
        },
        None => Result::Ok(()),
    }
}

fn validate_function(ctx: ValidateContext, value: Function) -> Result[(), string] {
    let context = "function " + value.name;
    validate_origin(ctx, value.origin, context)?;
    validate_trait_impl(ctx, value.trait_impl, context)?;
    validate_named_types(ctx, value.params, context + " parameter")?;
    validate_type(ctx, value.ret_ty, context + " return")?;
    validate_block(ctx, value.body, context)
}

fn validate_closure_definition(
    definition: repr::ClosureDef,
    structs: collections::HashSet[string],
    functions: HashMap[string, Function],
) -> Result[(), string] {
    if structs.contains(definition.environment) {} else {
        return Result::Err("closure apply function has no environment " + definition.environment)
    }
    let function = functions[definition.apply].ok_or(
        "closure environment has no apply function " + definition.environment,
    )?;
    match function.origin {
        Inherent { owner: ClosureEnvironment { name }, method_name } if name
            == definition.environment
            && method_name == "apply" => (),
        _ => return Result::Err("closure apply function has invalid origin " + definition.apply),
    }
    match definition.signature {
        Func { params, ret_ty } => {
            if function.params.len() != params.len() + 1 {
                return Result::Err(
                    "closure apply function has invalid parameters " + definition.apply,
                )
            }
            match function.params[0].1 {
                ClosureEnvironment { name } if name == definition.environment => (),
                _ => return Result::Err(
                    "closure apply function has invalid environment " + definition.apply,
                ),
            }
            for index in 0..params.len() {
                if repr::types_equal(function.params[index + 1].1, params[index]) {} else {
                    return Result::Err(
                        "closure apply function has invalid parameters " + definition.apply,
                    )
                }
            }
            if repr::types_equal(function.ret_ty, ret_ty) {
                Result::Ok(())
            } else {
                Result::Err("closure apply function has invalid return type " + definition.apply)
            }
        },
        _ => Result::Err("closure definition has non-function signature " + definition.apply),
    }
}

pub fn validate(value: File) -> Result[(), string] {
    let structs: collections::HashSet[string] = collections::HashSet::new();
    for definition in value.structs {
        let _ = structs.insert(definition.name);
    }
    let functions: HashMap[string, Function] = HashMap::new();
    for function in value.functions {
        if functions.contains(function.name) {
            return Result::Err("duplicate Lift function " + function.name)
        } else {
            functions[function.name] = function;
        }
    }
    let environments: collections::HashSet[string] = collections::HashSet::new();
    let closures_by_apply: HashMap[string, repr::ClosureDef] = HashMap::new();
    for definition in value.closure_defs {
        if !environments.insert(definition.environment) {
            return Result::Err("duplicate closure environment " + definition.environment)
        } else if closures_by_apply.contains(definition.apply) {
            return Result::Err("duplicate closure apply function " + definition.apply)
        } else {
            closures_by_apply[definition.apply] = definition;
        }
    }
    let ctx = ValidateContext { closures_by_apply, environments };
    for instance in value.type_instances {
        validate_types(ctx, instance.args, "type instance " + instance.name)?
    }
    for function in value.functions {
        validate_function(ctx, function)?
    }
    for definition in value.closure_defs {
        validate_type(ctx, definition.signature, "closure " + definition.apply)?;
        validate_closure_definition(definition, structs, functions)?
    }
    Result::Ok(())
}
